{
  "name": "goraw-vscode",
  "displayName": "Goraw Language Support",
  "description": "Syntax highlighting and language support for the Goraw programming language (.gw)",
  "version": "0.3.0",
  "publisher": "goraw",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:goraw"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Goraw",
      "properties": {
        "goraw.lspPath": {
          "type": "string",
          "default": "",
          "description": "Путь к исполняемому файлу goraw (goraw.exe)"
        }
      }
    },
    "languages": [
      {
        "id": "goraw",
        "aliases": [
          "Goraw",
          "goraw"
        ],
        "extensions": [
          ".gw"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "goraw",
        "scopeName": "source.goraw",
        "path": "./syntaxes/goraw.tmLanguage.json",
        "embeddedLanguages": {
          "source.c": "c",
          "source.cpp": "cpp",
          "source.asm": "asm"
        }
      }
    ]
  }
}
