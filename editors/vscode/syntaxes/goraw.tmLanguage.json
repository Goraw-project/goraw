{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Goraw",
  "scopeName": "source.goraw",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#embedded_c"
    },
    {
      "include": "#embedded_cpp"
    },
    {
      "include": "#embedded_asm"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.goraw",
          "match": "//.*$"
        },
        {
          "name": "comment.block.goraw",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "embedded_c": {
      "begin": "\\b(c)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.c.goraw"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "source.c"
        }
      ]
    },
    "embedded_cpp": {
      "begin": "\\b(cpp)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.cpp.goraw"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "source.cpp"
        }
      ]
    },
    "embedded_asm": {
      "begin": "\\b(asm)\\s*(?:\\((?:masm|nasm)\\))?\\s*(?:\\([^)]*\\))?\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.asm.goraw"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "source.asm"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.goraw",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.goraw",
              "match": "\\\\(?:[nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.goraw",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.goraw",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.goraw",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.goraw",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.goraw",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.goraw",
          "match": "\\b(if|else|while|for|in|match|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.goraw",
          "match": "\\b(fn|struct|enum|let|mut|const|static|extern|import|test|shadow|jit)\\b"
        },
        {
          "name": "keyword.other.unsafe.goraw",
          "match": "\\b(unsafe)\\b"
        },
        {
          "name": "keyword.operator.cast.goraw",
          "match": "\\b(as)\\b"
        },
        {
          "name": "constant.language.boolean.goraw",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.goraw",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.goraw",
          "match": "\\b(sizeof|zeroed|alloc|free|realloc|mem_copy|mem_set|make_slice|panic|print|println|obf|obf_str|sqrt|sin|cos|exp|exp2|log|log2|log10|floor|ceil|round|trunc|fabs|pow|fma|min|max|abs|clamp|f32_bits|f64_bits|f32_from_bits|f64_from_bits|str_from_cstr)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.goraw",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|void|str)\\b"
        },
        {
          "name": "support.type.std.goraw",
          "match": "\\b(Vec|HashMap|Result|Option|Box|File)\\b"
        },
        {
          "name": "storage.type.custom.goraw",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.try.goraw",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.colon-eq.goraw",
          "match": ":="
        },
        {
          "name": "keyword.operator.arrow.goraw",
          "match": "->"
        },
        {
          "name": "keyword.operator.fat-arrow.goraw",
          "match": "=>"
        },
        {
          "name": "keyword.operator.scope.goraw",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.goraw",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.goraw",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.goraw",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.goraw",
          "match": "&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.goraw",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.goraw",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:::[a-zA-Z_][a-zA-Z0-9_]*)?)",
          "captures": {
            "1": {
              "name": "entity.name.function.goraw"
            }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.call.goraw"
            }
          }
        }
      ]
    }
  }
}
