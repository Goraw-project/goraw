{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Goraw",
  "scopeName": "source.goraw",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#embedded_c"
    },
    {
      "include": "#embedded_cpp"
    },
    {
      "include": "#embedded_asm"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#pipeline_calls"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.goraw",
          "match": "//.*$"
        },
        {
          "name": "comment.block.goraw",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "embedded_c": {
      "begin": "\\b(c)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.c.goraw"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "source.c"
        }
      ]
    },
    "embedded_cpp": {
      "begin": "\\b(cpp)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.cpp.goraw"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "source.cpp"
        }
      ]
    },
    "embedded_asm": {
      "begin": "\\b(asm)\\s*(?:\\((?:masm|nasm)\\))?\\s*(?:\\([^)]*\\))?\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.asm.goraw"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "source.asm"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.goraw",
          "match": "'(?:\\\\[nrt\\\\\"'0]|\\\\x[0-9a-fA-F]{2}|[^'\\\\\r\n])*'"
        },
        {
          "name": "invalid.illegal.quote.goraw",
          "match": "'''"
        },
        {
          "name": "string.quoted.single.goraw",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.goraw",
              "match": "\\\\(?:[nrt\\\\\"'0]|x[0-9a-fA-F]{2})"
            }
          ]
        },
        {
          "name": "string.quoted.double.goraw",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.goraw",
              "match": "\\\\(?:[nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            },
            {
              "name": "constant.other.placeholder.goraw",
              "match": "%[-+#0 ]*[0-9]*(?:\\.[0-9]+)?(?:hh|h|ll|l|j|z|t)?[diuoxXfFeEgGaAcspn%]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.goraw",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.goraw",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.goraw",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.goraw",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.goraw",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(?=<[^>]*>\\s*::)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.goraw"
            },
            "2": {
              "name": "storage.type.custom.goraw"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(::)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.goraw"
            },
            "2": {
              "name": "storage.type.custom.goraw"
            },
            "3": {
              "name": "punctuation.separator.namespace.goraw"
            },
            "4": {
              "name": "entity.name.function.definition.goraw"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.goraw"
            },
            "2": {
              "name": "entity.name.function.definition.goraw"
            }
          }
        },
        {
          "match": "(::)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.separator.namespace.goraw"
            },
            "2": {
              "name": "entity.name.function.definition.goraw"
            }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*(?:::[a-zA-Z_][a-zA-Z0-9_]*)?)\\s*(?=<[^>]*>\\s*\\()|\\b([a-zA-Z_][a-zA-Z0-9_]*(?:::[a-zA-Z_][a-zA-Z0-9_]*)?)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.goraw"
            },
            "2": {
              "name": "entity.name.function.call.goraw"
            }
          }
        }
      ]
    },
    "pipeline_calls": {
      "patterns": [
        {
          "match": "(\\|>)\\s*([a-zA-Z_][a-zA-Z0-9_]*(?:::[a-zA-Z_][a-zA-Z0-9_]*)?)",
          "captures": {
            "1": {
              "name": "punctuation.separator.pipe-arrow.goraw keyword.operator.pipeline.goraw"
            },
            "2": {
              "name": "entity.name.function.pipeline.goraw"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.goraw",
          "match": "\\b(if|else|while|for|in|match|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.goraw",
          "match": "\\b(fn|struct|enum|let|mut|const|static|extern|import|test|shadow|jit)\\b"
        },
        {
          "name": "keyword.other.unsafe.goraw",
          "match": "\\b(unsafe)\\b"
        },
        {
          "name": "keyword.operator.cast.goraw",
          "match": "\\b(as)\\b"
        },
        {
          "name": "constant.language.boolean.goraw",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.goraw",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.goraw entity.name.function.builtin.goraw",
          "match": "\\b(sizeof|zeroed|alloc|free|realloc|mem_copy|mem_set|make_slice|panic|print|println|obf|obf_str|sqrt|sin|cos|exp|exp2|log|log2|log10|floor|ceil|round|trunc|fabs|pow|fma|min|max|abs|clamp|f32_bits|f64_bits|f32_from_bits|f64_from_bits|str_from_cstr)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.goraw",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|void|str|char)\\b"
        },
        {
          "name": "support.type.std.goraw",
          "match": "\\b(Vec|HashMap|Result|Option|Box|File)\\b"
        },
        {
          "name": "storage.type.custom.goraw",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.separator.pipe-arrow.goraw keyword.operator.pipeline.goraw",
          "match": "\\|>"
        },
        {
          "name": "punctuation.separator.arrow.goraw",
          "match": "->"
        },
        {
          "name": "punctuation.separator.fat-arrow.goraw",
          "match": "=>"
        },
        {
          "name": "punctuation.separator.ellipsis.goraw",
          "match": "\\.\\.\\."
        },
        {
          "name": "storage.modifier.pointer.goraw",
          "match": "\\*mut\\b|\\*(?=[a-zA-Z_0-9\\[\\(])"
        },
        {
          "name": "storage.modifier.reference.goraw",
          "match": "&mut\\b|&(?=[a-zA-Z_0-9\\[\\(])"
        },
        {
          "name": "keyword.operator.try.goraw",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.colon-eq.goraw",
          "match": ":="
        },
        {
          "name": "punctuation.separator.namespace.goraw",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.goraw",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.goraw",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.goraw",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.goraw",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.increment-decrement.goraw",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.bitwise.goraw",
          "match": "&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.goraw",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.goraw",
          "match": "="
        },
        {
          "name": "punctuation.separator.colon.goraw",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.goraw",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.goraw",
          "match": ","
        }
      ]
    }
  }
}
