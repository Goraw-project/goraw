import "std/json.gw";

extern fn puts(s: *u8) -> i32;

fn main() -> i32 {
    let raw = "{\"name\":\"Goraw\",\"version\":1,\"fast\":true,\"tags\":[\"llvm\",\"systems\"]}";
    let res = JsonDoc::parse(raw);
    if res.is_err() {
        puts("FAIL: json parse failed");
        return 1;
    }
    let doc = res.unwrap();
    let root = doc.root_node();
    if doc.kind(root) != JSON_OBJECT {
        puts("FAIL: root is not object");
        return 2;
    }

    let name = doc.get_str(root, "name");
    if name != "Goraw" {
        puts("FAIL: name mismatch");
        return 3;
    }

    let ver = doc.get_i64(root, "version");
    if ver != 1 {
        puts("FAIL: version mismatch");
        return 4;
    }

    let fast = doc.get_bool(root, "fast");
    if !fast {
        puts("FAIL: fast mismatch");
        return 5;
    }

    let tags = doc.get(root, "tags");
    if doc.kind(tags) != JSON_ARRAY || doc.count(tags) != 2 {
        puts("FAIL: tags array mismatch");
        return 6;
    }

    let t0 = doc.at(tags, 0);
    if doc.raw(t0) != "llvm" {
        puts("FAIL: tags[0] mismatch");
        return 7;
    }

    // Test writer
    let mut w = JsonWriter::new();
    w.begin_object();
    w.key("status");
    w.str("ok");
    w.key("code");
    w.i64(200);
    w.end_object();
    let out_json = w.finish();
    if out_json != "{\"status\":\"ok\",\"code\":200}" {
        puts("FAIL: json writer output mismatch");
        return 8;
    }

    puts("SUCCESS: std/json parse and write tests passed!");
    return 0;
}
