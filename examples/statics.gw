// Глобальные static-переменные: изменяемое состояние уровня модуля
// с константной инициализацией.
extern fn printf(fmt: *u8, ...) -> i32;

static NEXT_ID: i64 = 1;

fn alloc_id() -> i64 {
    let id = NEXT_ID;
    NEXT_ID += 1;
    return id;
}

fn main() -> i32 {
    printf("ids: %lld %lld %lld\n", alloc_id(), alloc_id(), alloc_id());
    return 0;
}
