// Срезы []T поверх кучи: безопасная индексация и .len, из raw-указателя.
extern fn printf(fmt: *u8, ...) -> i32;

// Заполняет срез i64 квадратами и возвращает сумму (индексация без unsafe).
fn fill_and_sum(xs: []i64) -> i64 {
    let mut total: i64 = 0;
    for i := 0; i < xs.len; i++ {
        xs[i] = i * i;      // запись в срез — безопасно
        total = total + xs[i];
    }
    return total;
}

fn main() -> i32 {
    let n: i64 = 8;
    let raw: *mut i64 = alloc(n * 8) as *mut i64;   // 8 байт на i64
    let xs: []i64 = make_slice(raw, n);

    let s = fill_and_sum(xs);
    printf("len=%lld  sum(i*i, i<8)=%lld  (ждём 140)\n", xs.len, s);

    printf("xs =");
    for i := 0; i < xs.len; i++ {
        printf(" %lld", xs[i]);
    }
    printf("\n");

    unsafe { free(xs.ptr as *mut u8); }
    return 0;
}

// for-in по срезу (добавлено позже)
fn sum_slice(xs: []i64) -> i64 {
    let mut s: i64 = 0;
    for x in xs { s += x; }
    return s;
}
