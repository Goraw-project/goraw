// Тест инлайн C/C++ вставок прямо в код Goraw + Generics + RAII

extern fn printf(fmt: *u8, ...) -> i32;

// 1. Верхнеуровневый C-блок
c {
    #include <stdio.h>

    int c_multiply(int a, int b) {
        return a * b;
    }
}

// 2. Верхнеуровневый C++ блок с STL
cpp {
    #include <vector>
    #include <numeric>

    extern "C" int cpp_sum_vector(int count, int val) {
        std::vector<int> v(count, val);
        return std::accumulate(v.begin(), v.end(), 0);
    }
}

// 3. Структура с RAII-деструктором
struct AutoResource {
    id: i64,
}

fn AutoResource::drop(self) {
    printf("[RAII] AutoResource #%lld автоматически уничтожен (drop)!\n", self.id);
}

fn test_raii_scope() {
    let r1 = AutoResource { id: 777 };
    printf("[RAII] Внутри блока test_raii_scope, id=%lld\n", r1.id);
    // При выходе из блока деструктор вызывается автоматически!
}

fn main() -> i32 {
    printf("=== ДЕМОНСТРАЦИЯ ИНЛАЙН C/C++ И RAII В GORAW ===\n\n");

    // 1. Вызов функции из инлайн C-блока
    let c_res = c_multiply(6, 7);
    printf("[C block] 6 * 7 = %d\n", c_res);

    // 2. Вызов функции из инлайн C++ блока с std::vector
    let cpp_res = cpp_sum_vector(5, 20);
    printf("[C++ STL] std::vector sum(5 x 20) = %d\n", cpp_res);

    // 3. Инлайн C вставка прямо внутри функции с передачей переменных
    let mut stmt_res: i64 = 0;
    let x: i64 = 15;
    let y: i64 = 25;
    c(inputs: [x, y], outputs: [stmt_res]) {
        *stmt_res = x + y + 100;
    }
    printf("[C inline stmt] 15 + 25 + 100 = %lld\n", stmt_res);

    // 4. Тест RAII
    test_raii_scope();

    printf("\nВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!\n");
    return 0;
}
