// Verification test for std library (vec, map, result, fs) and ? operator.

import "std/result.gw";
import "std/vec.gw";
import "std/map.gw";
import "std/fs.gw";

fn compute_val(x: i64) -> Result<i64, i64> {
    if x < 0 {
        return Result<i64, i64>::err(-1);
    }
    return Result<i64, i64>::ok(x * 2);
}

fn try_chain(x: i64) -> Result<i64, i64> {
    let a = compute_val(x)?;
    let b = compute_val(a)?;
    return Result<i64, i64>::ok(b + 1);
}

fn main() -> i32 {
    // 1. Test ? operator
    let res1 = try_chain(5);
    if !res1.is_ok() || res1.unwrap() != 21 {
        println("try_chain(5) failed");
        return 1;
    }

    let res2 = try_chain(-3);
    if res2.is_ok() {
        println("try_chain(-3) should have failed");
        return 2;
    }

    // 2. Test Vec<i64>
    let mut v = Vec<i64>::new();
    v.push(10);
    v.push(20);
    v.push(30);
    if v.len() != 3 || v.get(0) != 10 || v.get(1) != 20 || v.get(2) != 30 {
        println("Vec test failed");
        return 3;
    }
    let p = v.pop();
    if p != 30 || v.len() != 2 {
        println("Vec pop failed");
        return 4;
    }

    // 3. Test HashMap<i64, i64>
    let mut map = HashMap<i64, i64>::new();
    map.insert(100, 555);
    map.insert(200, 777);
    if !map.contains_key(100) || !map.contains_key(200) {
        println("HashMap contains_key failed");
        return 5;
    }
    let opt_v = map.get(100);
    if !opt_v.is_some() || opt_v.unwrap() != 555 {
        println("HashMap get failed");
        return 6;
    }

    // 4. Test fs path helpers
    let path = "test_dir/output.txt" as *u8;
    let fname = path_file_name(path);
    let ext = path_extension(path);
    if fname == null || ext == null {
        println("fs path helpers failed");
        return 7;
    }

    // 5. Test fs file write and read
    let test_file = "test_std_output.tmp" as *u8;
    let content: []u8 = "Hello Goraw Std!" as []u8;
    let write_res = write_file(test_file, content);
    if !write_res.is_ok() || write_res.unwrap() != 16 {
        println("write_file failed");
        return 8;
    }

    if !file_exists(test_file) || file_size(test_file) != 16 {
        println("file_exists or file_size failed");
        return 9;
    }

    let read_res = read_to_string(test_file);
    if !read_res.is_ok() {
        println("read_to_string failed");
        return 10;
    }
    let read_slice = read_res.unwrap();
    if read_slice.len != content.len {
        println("read length mismatch");
        return 11;
    }
    remove_file(test_file);

    println("ALL STD AND TRY TESTS PASSED!");
    return 0;
}
