import "std/sync.gw";

extern fn printf(fmt: *u8, ...) -> i32;

struct JobContext {
    chan_ptr: *mut Channel<i64>,
}

fn worker_fn(arg: *mut u8) -> i64 {
    let ctx = arg as *mut JobContext;
    unsafe {
        let ch = ctx.chan_ptr;
        let mut i: i64 = 1;
        while i <= 5 {
            thread_sleep_ms(10);
            ch.send(i * 10);
            i = i + 1;
        }
        ch.close();
    }
    return 0;
}

fn main() -> i32 {
    let mut counter = AtomicI64::new(100);
    counter.fetch_add(50);
    if counter.load() != 150 {
        printf("FAIL: atomic counter\n");
        return 1;
    }

    let mut ch: Channel<i64> = Channel<i64>::new(2);
    let mut ctx = JobContext {
        chan_ptr: &mut ch,
    };

    let t = Thread::spawn(worker_fn, &mut ctx as *mut u8);

    let mut sum: i64 = 0;
    for {
        let res = ch.recv();
        if res.is_err() {
            break;
        }
        let val = res.unwrap();
        sum = sum + val;
    }

    t.join();

    // 10 + 20 + 30 + 40 + 50 = 150
    if sum != 150 {
        printf("FAIL: channel sum %lld != 150\n", sum);
        return 2;
    }

    printf("SUCCESS: Multi-threaded Producer-Consumer Channel test passed! Sum=%lld\n", sum);
    return 0;
}
