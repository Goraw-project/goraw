// Инлайн-ассемблер: unsafe + Intel/MASM синтаксис -> LLVM inteldialect.
extern fn printf(fmt: *u8, ...) -> i32;

// value + 100 через ассемблерную вставку (порядок Intel: куда, откуда).
unsafe fn add100(value: u32) -> u32 {
    let mut output: u32 = 0;
    asm("masm", inputs: [value], outputs: [output]) {
        mov eax, value      ; загрузить value в eax
        add eax, 100        ; +100
        mov output, eax     ; вернуть результат в output
    };
    return output;
}

fn main() -> i32 {
    unsafe {
        printf("add100(23) = %u\n", add100(23));
        printf("add100(900) = %u\n", add100(900));
    }
    return 0;
}
