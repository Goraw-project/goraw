// Тип str == []u8: строковые литералы, .len/.ptr, индексация, for-in.
extern fn printf(fmt: *u8, ...) -> i32;

fn main() -> i32 {
    let s: str = "goraw";
    printf("%.*s has %lld bytes\n", s.len as i32, s.ptr, s.len);
    let mut sum: i64 = 0;
    for b in s { sum += b as i64; }
    printf("byte sum = %lld\n", sum);
    return 0;
}
