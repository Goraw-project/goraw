test "grid_4x4" {
    let n: i64 = 16;
    let x: *mut i64 = alloc(n * sizeof(i64)) as *mut i64;
    let y: *mut i64 = alloc(n * sizeof(i64)) as *mut i64;
    unsafe {
        let mut idx: i64 = 0;
        for r := 0; r < 4; r++ {
            for c := 0; c < 4; c++ {
                x[idx] = c * 10;
                y[idx] = r * 10;
                idx++;
            }
        }
    }
    let mst = solve_manhattan_mst(x, y, n);
    let bf = solve_manhattan_mst_bruteforce(x, y, n);
    free(x as *mut u8);
    free(y as *mut u8);
    assert mst == 150;
    assert bf == 150;
}

test "stress_collinear_random" {
    let count: i64 = 80;
    let x: *mut i64 = alloc(count * sizeof(i64)) as *mut i64;
    let y: *mut i64 = alloc(count * sizeof(i64)) as *mut i64;
    let mut rng: i64 = 99991;

    unsafe {
        for i := 0; i < count; i++ {
            rng = (rng * 1103515245 + 12345) & 2147483647;
            let coord = rng % 500;
            // Many points share x or y (grid lines)
            if i % 3 == 0 {
                x[i] = coord;
                y[i] = 100;
            } else if i % 3 == 1 {
                x[i] = 200;
                y[i] = coord;
            } else {
                x[i] = coord;
                y[i] = -coord;
            }
        }
    }

    let mst = solve_manhattan_mst(x, y, count);
    let bf = solve_manhattan_mst_bruteforce(x, y, count);

    free(x as *mut u8);
    free(y as *mut u8);

    assert mst == bf;
}

test "introsort_adversarial_patterns" {
    let n: i64 = 10000;
    let buf = BufferGuard::new(n * sizeof(i64));
    let arr = buf.ptr as *mut i64;

    // 1. Strictly sorted
    unsafe {
        for i := 0; i < n; i++ {
            arr[i] = i;
        }
    }
    sort_i64(arr, 0, n - 1);
    unsafe {
        for i := 0; i < n - 1; i++ {
            assert arr[i] <= arr[i + 1];
        }
        assert arr[0] == 0;
        assert arr[n - 1] == n - 1;
    }

    // 2. Reverse sorted
    unsafe {
        for i := 0; i < n; i++ {
            arr[i] = n - i;
        }
    }
    sort_i64(arr, 0, n - 1);
    unsafe {
        for i := 0; i < n - 1; i++ {
            assert arr[i] <= arr[i + 1];
        }
        assert arr[0] == 1;
        assert arr[n - 1] == n;
    }

    // 3. Organ pipe (1, 2, ..., N/2, ..., 2, 1)
    let half = n / 2;
    unsafe {
        for i := 0; i < half; i++ {
            arr[i] = i;
            arr[n - 1 - i] = i;
        }
    }
    sort_i64(arr, 0, n - 1);
    unsafe {
        for i := 0; i < n - 1; i++ {
            assert arr[i] <= arr[i + 1];
        }
        assert arr[0] == 0;
        assert arr[1] == 0;
        assert arr[n - 1] == half - 1;
    }

    // 4. All identical elements
    unsafe {
        for i := 0; i < n; i++ {
            arr[i] = 42;
        }
    }
    sort_i64(arr, 0, n - 1);
    unsafe {
        for i := 0; i < n; i++ {
            assert arr[i] == 42;
        }
    }
}

test "heapsort_points_direct_verification" {
    let n: i64 = 200;
    let buf = BufferGuard::new(n * sizeof(Point));
    let pts = buf.ptr as *mut Point;
    let mut rng: i64 = 54321;

    unsafe {
        for i := 0; i < n; i++ {
            rng = (rng * 1103515245 + 12345) & 2147483647;
            let rx = rng % 1000;
            rng = (rng * 1103515245 + 12345) & 2147483647;
            let ry = rng % 1000;
            pts[i] = Point { x: rx, y: ry, id: i };
        }
    }

    // Direct heapsort call
    heapsort_points(pts, 0, n - 1);

    // Verify descending order: each element must be >= next element
    unsafe {
        for i := 0; i < n - 1; i++ {
            // It is descending, so pts[i] must NOT be strictly smaller than pts[i + 1]
            // That means point_greater(pts[i + 1].x, pts[i + 1].y, pts[i].x, pts[i].y) must be FALSE!
            let next_is_greater = point_greater(pts[i + 1].x, pts[i + 1].y, pts[i].x, pts[i].y);
            assert !next_is_greater;
        }
    }

    // Also test heapsort on a sub-range [20, 150]
    heapsort_points(pts, 20, 150);
    unsafe {
        for i := 20; i < 150; i++ {
            let next_is_greater = point_greater(pts[i + 1].x, pts[i + 1].y, pts[i].x, pts[i].y);
            assert !next_is_greater;
        }
    }
}

test "forced_pure_heapsort_mst" {
    let count: i64 = 150;
    let x_buf = BufferGuard::new(count * sizeof(i64));
    let y_buf = BufferGuard::new(count * sizeof(i64));
    let x = x_buf.ptr as *mut i64;
    let y = y_buf.ptr as *mut i64;
    let mut rng: i64 = 13579;

    unsafe {
        for i := 0; i < count; i++ {
            rng = (rng * 1103515245 + 12345) & 2147483647;
            x[i] = rng % 5000;
            rng = (rng * 1103515245 + 12345) & 2147483647;
            y[i] = rng % 5000;
        }
    }

    let intro_mst = solve_manhattan_mst(x, y, count);
    let heap_mst = solve_manhattan_mst_pure_heapsort(x, y, count);
    let bf_mst = solve_manhattan_mst_bruteforce(x, y, count);

    assert heap_mst == bf_mst;
    assert intro_mst == heap_mst;
}

fn benchmark_100k() {
    let n: i64 = 100000;
    let x: *mut i64 = alloc(n * sizeof(i64)) as *mut i64;
    let y: *mut i64 = alloc(n * sizeof(i64)) as *mut i64;
    let mut rng: i64 = 987654321;

    unsafe {
        for i := 0; i < n; i++ {
            rng = (rng * 1103515245 + 12345) & 2147483647;
            x[i] = rng % 100000000;
            rng = (rng * 1103515245 + 12345) & 2147483647;
            y[i] = rng % 100000000;
        }
    }

    printf("Running benchmark on N = %lld points (Hard constraint)...\n", n);
    let t0 = clock();
    let mst = solve_manhattan_mst(x, y, n);
    let t1 = clock();
    let elapsed_ms = t1 - t0;
    printf("100,000 points MST computed successfully: Total weight = %lld in %lld ms\n", mst, elapsed_ms);

    free(x as *mut u8);
    free(y as *mut u8);
}

fn main() -> i32 {
    printf("============================================================\n");
    printf("  Manhattan MST - O(N log N) Algorithm in Goraw   \n");
    printf("============================================================\n\n");

    let n3: i64 = 3;
    let x3: *mut i64 = alloc(n3 * sizeof(i64)) as *mut i64;
    let y3: *mut i64 = alloc(n3 * sizeof(i64)) as *mut i64;
    unsafe {
        x3[0] = 0; y3[0] = 0;
        x3[1] = 1; y3[1] = 2;
        x3[2] = 2; y3[2] = 1;
    }
    let mst3 = solve_manhattan_mst(x3, y3, n3);
    printf("Sample 3 points: MST = %lld (Expected 5)\n", mst3);
    free(x3 as *mut u8);
    free(y3 as *mut u8);

    let n4: i64 = 4;
    let x4: *mut i64 = alloc(n4 * sizeof(i64)) as *mut i64;
    let y4: *mut i64 = alloc(n4 * sizeof(i64)) as *mut i64;
    unsafe {
        x4[0] = 0; y4[0] = 0;
        x4[1] = 0; y4[1] = 10;
        x4[2] = 10; y4[2] = 0;
        x4[3] = 10; y4[3] = 10;
    }
    let mst4 = solve_manhattan_mst(x4, y4, n4);
    printf("Sample square 4 points: MST = %lld (Expected 30)\n", mst4);
    free(x4 as *mut u8);
    free(y4 as *mut u8);

    benchmark_100k();
    printf("\nDone! Manhattan MST completed successfully.\n");
    return 0;
}
