// Manhattan MST solver in Goraw
// Complexity: O(N log N) time, O(N) space

extern fn printf(fmt: *u8, ...) -> i32;
extern fn clock() -> i64;

struct Point {
    x: i64,
    y: i64,
    id: i64,
}

struct Edge {
    u: i64,
    v: i64,
    w: i64,
}

// RAII Buffer Guard for deterministic leak-free memory management
struct BufferGuard {
    ptr: *mut u8,
}

fn BufferGuard::new(sz: i64) -> BufferGuard {
    let p = alloc(sz) as *mut u8;
    return BufferGuard { ptr: p };
}

fn BufferGuard::drop(self) {
    if self.ptr != null {
        free(self.ptr);
        self.ptr = null;
    }
}

const COORD_MAX: i64 = 1000000000;          // +10^9 safe coordinate boundary
const COORD_MIN: i64 = -1000000000;         // -10^9 safe coordinate boundary
const INF_DIST: i64 = 4000000000000000000;  // 4 * 10^18 sentinel (exceeds any possible Manhattan distance sum, safe in i64)

fn abs_i64(x: i64) -> i64 {
    if x >= 0 {
        return x;
    }
    // Prevent 2's complement overflow on INT64_MIN (-9223372036854775808):
    if x == -9223372036854775807 - 1 {
        return 9223372036854775807;
    }
    return -x;
}

shadow abs_i64 {
    assert abs_i64(10) == 10;
    assert abs_i64(-42) == 42;
    assert abs_i64(0) == 0;
    assert abs_i64(-9223372036854775807 - 1) == 9223372036854775807;
}

fn validate_coordinates(orig_x: *mut i64, orig_y: *mut i64, n: i64) -> bool {
    unsafe {
        for i := 0; i < n; i++ {
            if orig_x[i] < COORD_MIN || orig_x[i] > COORD_MAX {
                return false;
            }
            if orig_y[i] < COORD_MIN || orig_y[i] > COORD_MAX {
                return false;
            }
        }
    }
    return true;
}

shadow validate_coordinates {
    let n: i64 = 2;
    let x_buf = BufferGuard::new(n * sizeof(i64));
    let y_buf = BufferGuard::new(n * sizeof(i64));
    let x = x_buf.ptr as *mut i64;
    let y = y_buf.ptr as *mut i64;
    unsafe {
        x[0] = 500; y[0] = -500;
        x[1] = COORD_MAX; y[1] = COORD_MIN;
    }
    assert validate_coordinates(x, y, n) == true;
    unsafe {
        x[1] = COORD_MAX + 1;
    }
    assert validate_coordinates(x, y, n) == false;
}

fn point_greater(p1_x: i64, p1_y: i64, p2_x: i64, p2_y: i64) -> bool {
    if p1_x != p2_x {
        return p1_x > p2_x;
    }
    return p1_y > p2_y;
}

shadow point_greater {
    assert point_greater(5, 2, 3, 10) == true;
    assert point_greater(3, 10, 5, 2) == false;
    assert point_greater(4, 7, 4, 3) == true;
    assert point_greater(4, 3, 4, 7) == false;
    assert point_greater(4, 3, 4, 3) == false;
}

fn calc_max_depth(n: i64) -> i64 {
    let mut d: i64 = 0;
    let mut v = n;
    for v > 0 {
        d++;
        v = v / 2;
    }
    return d * 2;
}

// -------------------------------------------------------------
// IntroSort for Point (Descending by X, then descending by Y)
// -------------------------------------------------------------

fn insertion_sort_points(pts: *mut Point, left: i64, right: i64) {
    unsafe {
        for i := left + 1; i <= right; i++ {
            let key = pts[i];
            let mut j = i - 1;
            for j >= left && point_greater(key.x, key.y, pts[j].x, pts[j].y) {
                pts[j + 1] = pts[j];
                j--;
            }
            pts[j + 1] = key;
        }
    }
}

fn heap_sift_down_points(pts: *mut Point, left: i64, root: i64, n: i64) {
    let mut curr = root;
    unsafe {
        for {
            let mut smallest = curr;
            let left_child = 2 * curr + 1;
            let right_child = 2 * curr + 2;
            if left_child < n && point_greater(pts[left + smallest].x, pts[left + smallest].y, pts[left + left_child].x, pts[left + left_child].y) {
                smallest = left_child;
            }
            if right_child < n && point_greater(pts[left + smallest].x, pts[left + smallest].y, pts[left + right_child].x, pts[left + right_child].y) {
                smallest = right_child;
            }
            if smallest == curr {
                break;
            }
            let tmp = pts[left + curr];
            pts[left + curr] = pts[left + smallest];
            pts[left + smallest] = tmp;
            curr = smallest;
        }
    }
}

fn heapsort_points(pts: *mut Point, left: i64, right: i64) {
    let n = right - left + 1;
    if n <= 1 {
        return;
    }
    let mut i = n / 2 - 1;
    for i >= 0 {
        heap_sift_down_points(pts, left, i, n);
        i--;
    }
    let mut j = n - 1;
    unsafe {
        for j > 0 {
            let tmp = pts[left];
            pts[left] = pts[left + j];
            pts[left + j] = tmp;
            heap_sift_down_points(pts, left, 0, j);
            j--;
        }
    }
}

fn introsort_points(pts: *mut Point, left: i64, right: i64, max_depth: i64) {
    let mut l = left;
    let mut r = right;
    let mut depth = max_depth;

    for r - l > 16 {
        if depth == 0 {
            heapsort_points(pts, l, r);
            return;
        }
        depth--;

        // Median-of-three pivot
        let mid = l + (r - l) / 2;
        unsafe {
            if point_greater(pts[mid].x, pts[mid].y, pts[l].x, pts[l].y) {
                let tmp = pts[l]; pts[l] = pts[mid]; pts[mid] = tmp;
            }
            if point_greater(pts[r].x, pts[r].y, pts[l].x, pts[l].y) {
                let tmp = pts[l]; pts[l] = pts[r]; pts[r] = tmp;
            }
            if point_greater(pts[r].x, pts[r].y, pts[mid].x, pts[mid].y) {
                let tmp = pts[mid]; pts[mid] = pts[r]; pts[r] = tmp;
            }
            let piv_x = pts[mid].x;
            let piv_y = pts[mid].y;

            let mut i = l;
            let mut j = r;
            for i <= j {
                for point_greater(pts[i].x, pts[i].y, piv_x, piv_y) {
                    i++;
                }
                for point_greater(piv_x, piv_y, pts[j].x, pts[j].y) {
                    j--;
                }
                if i <= j {
                    let tmp = pts[i];
                    pts[i] = pts[j];
                    pts[j] = tmp;
                    i++;
                    j--;
                }
            }

            // Tail call elimination: recurse on smaller, loop on larger
            if j - l < r - i {
                if l < j {
                    introsort_points(pts, l, j, depth);
                }
                l = i;
            } else {
                if i < r {
                    introsort_points(pts, i, r, depth);
                }
                r = j;
            }
        }
    }
    insertion_sort_points(pts, l, r);
}

fn sort_points(pts: *mut Point, left: i64, right: i64) {
    if left >= right {
        return;
    }
    let depth = calc_max_depth(right - left + 1);
    introsort_points(pts, left, right, depth);
}

// -------------------------------------------------------------
// IntroSort for i64 (Ascending)
// -------------------------------------------------------------

fn insertion_sort_i64(arr: *mut i64, left: i64, right: i64) {
    unsafe {
        for i := left + 1; i <= right; i++ {
            let key = arr[i];
            let mut j = i - 1;
            for j >= left && arr[j] > key {
                arr[j + 1] = arr[j];
                j--;
            }
            arr[j + 1] = key;
        }
    }
}

fn heap_sift_down_i64(arr: *mut i64, left: i64, root: i64, n: i64) {
    let mut curr = root;
    unsafe {
        for {
            let mut largest = curr;
            let left_child = 2 * curr + 1;
            let right_child = 2 * curr + 2;
            if left_child < n && arr[left + left_child] > arr[left + largest] {
                largest = left_child;
            }
            if right_child < n && arr[left + right_child] > arr[left + largest] {
                largest = right_child;
            }
            if largest == curr {
                break;
            }
            let tmp = arr[left + curr];
            arr[left + curr] = arr[left + largest];
            arr[left + largest] = tmp;
            curr = largest;
        }
    }
}

fn heapsort_i64(arr: *mut i64, left: i64, right: i64) {
    let n = right - left + 1;
    if n <= 1 {
        return;
    }
    let mut i = n / 2 - 1;
    for i >= 0 {
        heap_sift_down_i64(arr, left, i, n);
        i--;
    }
    let mut j = n - 1;
    unsafe {
        for j > 0 {
            let tmp = arr[left];
            arr[left] = arr[left + j];
            arr[left + j] = tmp;
            heap_sift_down_i64(arr, left, 0, j);
            j--;
        }
    }
}

fn introsort_i64(arr: *mut i64, left: i64, right: i64, max_depth: i64) {
    let mut l = left;
    let mut r = right;
    let mut depth = max_depth;

    for r - l > 16 {
        if depth == 0 {
            heapsort_i64(arr, l, r);
            return;
        }
        depth--;

        // Median-of-three pivot
        let mid = l + (r - l) / 2;
        unsafe {
            if arr[l] > arr[mid] {
                let tmp = arr[l]; arr[l] = arr[mid]; arr[mid] = tmp;
            }
            if arr[l] > arr[r] {
                let tmp = arr[l]; arr[l] = arr[r]; arr[r] = tmp;
            }
            if arr[mid] > arr[r] {
                let tmp = arr[mid]; arr[mid] = arr[r]; arr[r] = tmp;
            }
            let pivot = arr[mid];

            let mut i = l;
            let mut j = r;
            for i <= j {
                for arr[i] < pivot {
                    i++;
                }
                for arr[j] > pivot {
                    j--;
                }
                if i <= j {
                    let tmp = arr[i];
                    arr[i] = arr[j];
                    arr[j] = tmp;
                    i++;
                    j--;
                }
            }

            if j - l < r - i {
                if l < j {
                    introsort_i64(arr, l, j, depth);
                }
                l = i;
            } else {
                if i < r {
                    introsort_i64(arr, i, r, depth);
                }
                r = j;
            }
        }
    }
    insertion_sort_i64(arr, l, r);
}

fn sort_i64(arr: *mut i64, left: i64, right: i64) {
    if left >= right {
        return;
    }
    let depth = calc_max_depth(right - left + 1);
    introsort_i64(arr, left, right, depth);
}

// -------------------------------------------------------------
// IntroSort for Edge (Ascending by weight w)
// -------------------------------------------------------------

fn insertion_sort_edges(edges: *mut Edge, left: i64, right: i64) {
    unsafe {
        for i := left + 1; i <= right; i++ {
            let key = edges[i];
            let mut j = i - 1;
            for j >= left && edges[j].w > key.w {
                edges[j + 1] = edges[j];
                j--;
            }
            edges[j + 1] = key;
        }
    }
}

fn heap_sift_down_edges(edges: *mut Edge, left: i64, root: i64, n: i64) {
    let mut curr = root;
    unsafe {
        for {
            let mut largest = curr;
            let left_child = 2 * curr + 1;
            let right_child = 2 * curr + 2;
            if left_child < n && edges[left + left_child].w > edges[left + largest].w {
                largest = left_child;
            }
            if right_child < n && edges[left + right_child].w > edges[left + largest].w {
                largest = right_child;
            }
            if largest == curr {
                break;
            }
            let tmp = edges[left + curr];
            edges[left + curr] = edges[left + largest];
            edges[left + largest] = tmp;
            curr = largest;
        }
    }
}

fn heapsort_edges(edges: *mut Edge, left: i64, right: i64) {
    let n = right - left + 1;
    if n <= 1 {
        return;
    }
    let mut i = n / 2 - 1;
    for i >= 0 {
        heap_sift_down_edges(edges, left, i, n);
        i--;
    }
    let mut j = n - 1;
    unsafe {
        for j > 0 {
            let tmp = edges[left];
            edges[left] = edges[left + j];
            edges[left + j] = tmp;
            heap_sift_down_edges(edges, left, 0, j);
            j--;
        }
    }
}

fn introsort_edges(edges: *mut Edge, left: i64, right: i64, max_depth: i64) {
    let mut l = left;
    let mut r = right;
    let mut depth = max_depth;

    for r - l > 16 {
        if depth == 0 {
            heapsort_edges(edges, l, r);
            return;
        }
        depth--;

        // Median-of-three pivot
        let mid = l + (r - l) / 2;
        unsafe {
            if edges[l].w > edges[mid].w {
                let tmp = edges[l]; edges[l] = edges[mid]; edges[mid] = tmp;
            }
            if edges[l].w > edges[r].w {
                let tmp = edges[l]; edges[l] = edges[r]; edges[r] = tmp;
            }
            if edges[mid].w > edges[r].w {
                let tmp = edges[mid]; edges[mid] = edges[r]; edges[r] = tmp;
            }
            let piv_w = edges[mid].w;

            let mut i = l;
            let mut j = r;
            for i <= j {
                for edges[i].w < piv_w {
                    i++;
                }
                for edges[j].w > piv_w {
                    j--;
                }
                if i <= j {
                    let tmp = edges[i];
                    edges[i] = edges[j];
                    edges[j] = tmp;
                    i++;
                    j--;
                }
            }

            if j - l < r - i {
                if l < j {
                    introsort_edges(edges, l, j, depth);
                }
                l = i;
            } else {
                if i < r {
                    introsort_edges(edges, i, r, depth);
                }
                r = j;
            }
        }
    }
    insertion_sort_edges(edges, l, r);
}

fn sort_edges(edges: *mut Edge, left: i64, right: i64) {
    if left >= right {
        return;
    }
    let depth = calc_max_depth(right - left + 1);
    introsort_edges(edges, left, right, depth);
}

fn lower_bound(arr: *mut i64, len: i64, val: i64) -> i64 {
    let mut low: i64 = 0;
    let mut high: i64 = len - 1;
    let mut ans: i64 = 0;
    unsafe {
        for low <= high {
            let mid = low + (high - low) / 2;
            if arr[mid] >= val {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }
    }
    return ans;
}

fn dsu_find(parent: *mut i64, x: i64) -> i64 {
    unsafe {
        let mut root = x;
        for parent[root] != root {
            root = parent[root];
        }
        let mut curr = x;
        for curr != root {
            let nxt = parent[curr];
            parent[curr] = root;
            curr = nxt;
        }
        return root;
    }
}

fn dsu_union(parent: *mut i64, rank: *mut i64, x: i64, y: i64) -> bool {
    let rx = dsu_find(parent, x);
    let ry = dsu_find(parent, y);
    if rx == ry {
        return false;
    }
    unsafe {
        if rank[rx] < rank[ry] {
            parent[rx] = ry;
        } else if rank[rx] > rank[ry] {
            parent[ry] = rx;
        } else {
            parent[ry] = rx;
            rank[rx] += 1;
        }
    }
    return true;
}

// Core Manhattan MST solver: parameterizable sorting engine (false: IntroSort, true: Pure HeapSort)
fn solve_manhattan_mst_core(orig_x: *mut i64, orig_y: *mut i64, n: i64, use_pure_heap: bool) -> i64 {
    if n <= 1 {
        return 0;
    }

    // 1. Strict validation of coordinate bounds to prevent i64 arithmetic overflow
    if !validate_coordinates(orig_x, orig_y, n) {
        printf("[ERROR] Coordinates out of supported range [%lld, %lld]\n", COORD_MIN, COORD_MAX);
        return -1;
    }

    let pts_buf = BufferGuard::new(n * sizeof(Point));
    let pts: *mut Point = pts_buf.ptr as *mut Point;

    let z_buf = BufferGuard::new(n * sizeof(i64));
    let z_vals: *mut i64 = z_buf.ptr as *mut i64;

    let bit_val_buf = BufferGuard::new((n + 4) * sizeof(i64));
    let bit_val: *mut i64 = bit_val_buf.ptr as *mut i64;

    let bit_id_buf = BufferGuard::new((n + 4) * sizeof(i64));
    let bit_id: *mut i64 = bit_id_buf.ptr as *mut i64;

    let max_edges: i64 = 4 * n + 10;
    let edges_buf = BufferGuard::new(max_edges * sizeof(Edge));
    let edges: *mut Edge = edges_buf.ptr as *mut Edge;
    let mut edge_count: i64 = 0;

    unsafe {
        for i := 0; i < n; i++ {
            pts[i] = Point {
                x: orig_x[i],
                y: orig_y[i],
                id: i,
            };
        }

        let inf: i64 = INF_DIST;

        for dir := 0; dir < 4; dir++ {
            if dir == 1 || dir == 3 {
                for i := 0; i < n; i++ {
                    let tmp = pts[i].x;
                    pts[i].x = pts[i].y;
                    pts[i].y = tmp;
                }
            } else if dir == 2 {
                for i := 0; i < n; i++ {
                    pts[i].x = -pts[i].x;
                }
            }

            // 1. Sort points descending by X, then descending by Y
            if use_pure_heap {
                heapsort_points(pts, 0, n - 1);
            } else {
                sort_points(pts, 0, n - 1);
            }

            // 2. Coordinate compression of (Y - X)
            for i := 0; i < n; i++ {
                z_vals[i] = pts[i].y - pts[i].x;
            }
            if use_pure_heap {
                heapsort_i64(z_vals, 0, n - 1);
            } else {
                sort_i64(z_vals, 0, n - 1);
            }

            let mut m: i64 = 0;
            if n > 0 {
                m = 1;
                for i := 1; i < n; i++ {
                    if z_vals[i] != z_vals[m - 1] {
                        z_vals[m] = z_vals[i];
                        m++;
                    }
                }
            }

            // 3. Initialize Fenwick tree
            for p := 0; p <= m + 2; p++ {
                bit_val[p] = inf;
                bit_id[p] = -1;
            }

            // 4. Sweep line
            for i := 0; i < n; i++ {
                let z = pts[i].y - pts[i].x;
                let rank = lower_bound(z_vals, m, z);
                let pos = m - rank; // 1-based index in [1, m]

                // Query prefix [1, pos]
                let mut best_id: i64 = -1;
                let mut min_val: i64 = inf;
                let mut p = pos;
                for p > 0 {
                    if bit_val[p] < min_val {
                        min_val = bit_val[p];
                        best_id = bit_id[p];
                    }
                    let lowbit = p & -p;
                    p -= lowbit;
                }

                if best_id != -1 {
                    let u = pts[i].id;
                    let v = best_id;
                    let dist = abs_i64(orig_x[u] - orig_x[v]) + abs_i64(orig_y[u] - orig_y[v]);
                    edges[edge_count] = Edge { u: u, v: v, w: dist };
                    edge_count++;
                }

                // Update Fenwick tree with pts[i]
                let val = pts[i].x + pts[i].y;
                let id = pts[i].id;
                let mut up = pos;
                for up <= m {
                    if val < bit_val[up] {
                        bit_val[up] = val;
                        bit_id[up] = id;
                    }
                    let lowbit = up & -up;
                    up += lowbit;
                }
            }
        }
    }

    // 5. Kruskal's algorithm on candidate edges
    if edge_count > 0 {
        if use_pure_heap {
            heapsort_edges(edges, 0, edge_count - 1);
        } else {
            sort_edges(edges, 0, edge_count - 1);
        }
    }

    let parent_buf = BufferGuard::new(n * sizeof(i64));
    let parent: *mut i64 = parent_buf.ptr as *mut i64;

    let rank_buf = BufferGuard::new(n * sizeof(i64));
    let rank: *mut i64 = rank_buf.ptr as *mut i64;

    unsafe {
        for i := 0; i < n; i++ {
            parent[i] = i;
            rank[i] = 0;
        }
    }

    let mut total_mst_weight: i64 = 0;
    let mut edges_added: i64 = 0;
    unsafe {
        for i := 0; i < edge_count; i++ {
            let e = edges[i];
            if dsu_union(parent, rank, e.u, e.v) {
                total_mst_weight += e.w;
                edges_added++;
                if edges_added == n - 1 {
                    break;
                }
            }
        }
    }

    return total_mst_weight;
}

// Public API
fn solve_manhattan_mst(orig_x: *mut i64, orig_y: *mut i64, n: i64) -> i64 {
    return solve_manhattan_mst_core(orig_x, orig_y, n, false);
}

fn solve_manhattan_mst_pure_heapsort(orig_x: *mut i64, orig_y: *mut i64, n: i64) -> i64 {
    return solve_manhattan_mst_core(orig_x, orig_y, n, true);
}

// O(N^2) Prim's algorithm for reference verification on small N
fn solve_manhattan_mst_bruteforce(orig_x: *mut i64, orig_y: *mut i64, n: i64) -> i64 {
    if n <= 1 {
        return 0;
    }
    let min_dist_buf = BufferGuard::new(n * sizeof(i64));
    let min_dist: *mut i64 = min_dist_buf.ptr as *mut i64;

    let visited_buf = BufferGuard::new(n * sizeof(bool));
    let visited: *mut bool = visited_buf.ptr as *mut bool;
    let inf: i64 = INF_DIST;

    unsafe {
        for i := 0; i < n; i++ {
            min_dist[i] = inf;
            visited[i] = false;
        }
        min_dist[0] = 0;

        let mut total_weight: i64 = 0;

        for step := 0; step < n; step++ {
            let mut u: i64 = -1;
            let mut best_d: i64 = inf;
            for i := 0; i < n; i++ {
                if !visited[i] && min_dist[i] < best_d {
                    best_d = min_dist[i];
                    u = i;
                }
            }

            visited[u] = true;
            total_weight += best_d;

            for v := 0; v < n; v++ {
                if !visited[v] {
                    let d = abs_i64(orig_x[u] - orig_x[v]) + abs_i64(orig_y[u] - orig_y[v]);
                    if d < min_dist[v] {
                        min_dist[v] = d;
                    }
                }
            }
        }

        return total_weight;
    }
}

test "sample_3_points" {
    let n: i64 = 3;
    let x: *mut i64 = alloc(n * sizeof(i64)) as *mut i64;
    let y: *mut i64 = alloc(n * sizeof(i64)) as *mut i64;
    unsafe {
        x[0] = 0; y[0] = 0;
        x[1] = 1; y[1] = 2;
        x[2] = 2; y[2] = 1;
    }
    let mst = solve_manhattan_mst(x, y, n);
    let bf = solve_manhattan_mst_bruteforce(x, y, n);
    free(x as *mut u8);
    free(y as *mut u8);
    assert mst == 5;
    assert bf == 5;
}

