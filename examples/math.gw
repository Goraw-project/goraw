extern fn printf(fmt: *u8, ...) -> i32;

// Гипотенуза через конвейер: сумму квадратов пропускаем в sqrt.
fn hypot(a: f64, b: f64) -> f64 {
    return a*a + b*b |> sqrt;
}

fn main() -> i32 {
    let h = hypot(3.0, 4.0);
    printf("hypot(3,4)      = %f\n", h);

    // Конвейер из нескольких шагов: |x| -> sqrt -> округление вверх
    let r = -15.9 |> abs |> sqrt |> ceil;
    printf("ceil(sqrt|-15.9|)= %f\n", r);

    printf("pow(2, 10)      = %f\n", pow(2.0, 10.0));
    printf("clamp(42,0,10)  = %lld\n", clamp(42, 0, 10));
    printf("max(7, 3)       = %lld\n", max(7, 3));
    return 0;
}
