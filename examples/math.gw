// Внешние системные функции libc
extern fn pow(x: f64, y: f64) -> f64;
extern fn printf(fmt: *u8, ...) -> i32;
extern fn sqrt(x: f64) -> f64;

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: gw_add]
// template <typename A, typename B>
// fn gw_add(...);
// ========================================================

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: gw_eq]
// template <typename A, typename B>
// fn gw_eq(...);
// ========================================================

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: gw_ne]
// template <typename A, typename B>
// fn gw_ne(...);
// ========================================================

fn hypot(a: f64, b: f64) -> f64 {
    return sqrt(((a * a) + (b * b)));
}

fn main() -> i32 {
    let mut h: f64 = hypot(3.0, 4.0);
    printf("hypot(3,4)      = %f\n", h);
    let mut r: f64 = ceil(sqrt(if (-15.9) < 0 { -(-15.9) } else { (-15.9) }));
    printf("ceil(sqrt|-15.9|)= %f\n", r);
    printf("pow(2, 10)      = %f\n", pow(2.0, 10.0));
    printf("clamp(42,0,10)  = %lld\n", clamp(42, 0, 10));
    printf("max(7, 3)       = %lld\n", if 7 > 3 { 7 } else { 3 });
    return 0;
}
