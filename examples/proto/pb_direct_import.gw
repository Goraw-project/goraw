import "pb2_all.proto";

extern fn puts(s: *u8) -> i32;

fn main() -> i32 {
    unsafe {
        let mut b: GpbBuf = gpb_buf_new();
        let mut item: SubItem = zeroed();
        item.id = 777;
        item.has_id = true;
        let title = gpb_str("Direct proto import works!");
        item.title_ptr = title.data;
        item.title_len = title.len;
        item.has_title = true;

        encode_SubItem(&item, &mut b);

        let dec: SubItem = decode_SubItem(b.data as *u8, b.len);
        if dec.id != 777 {
            puts("FAIL: id mismatch");
            return 1;
        }

        puts("SUCCESS: Direct import of .proto file in Goraw works flawlessly!");
        return 0;
    }
}
