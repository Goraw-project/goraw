extern fn printf(fmt: *u8, ...) -> i32;

fn main() -> i32 {
    let mut inr = Inner { v: 7, has_v: true };

    let raw: *mut i32 = alloc(8) as *mut i32;
    unsafe { raw[0] = 1; raw[1] = 300; }
    let nums = make_slice(raw, 2);

    let mut r = Rich {
        id: 1, has_id: true,
        delta: -1, has_delta: true,
        flag: true, has_flag: true,
        nums: nums,
        inner: &mut inr,
        code: 0x01020304, has_code: true,
    };

    let mut b = gpb_buf_new();
    encode_Rich(&mut r, &mut b);
    unsafe {
        printf("Rich -> (%lld):", b.len);
        for i := 0; i < b.len; i++ { printf(" %02X", b.data[i] as i32); }
        printf("\n");
        free(b.data);
        free(raw as *mut u8);
    }
    return 0;
}
