import "service_demo.proto";

extern fn puts(s: *u8) -> i32;

fn main() -> i32 {
    unsafe {
        // --- 1. Клиент формирует RPC-запрос ---
        let mut req: UserRequest = zeroed();
        req.user_id = 12345;
        req.has_user_id = true;

        let mut req_wire: GpbBuf = gpb_buf_new();
        rpc_UserService_GetUser_encode_request(&req, &mut req_wire);

        // --- 2. Серверный диспетчер принимает wire-пакет ---
        let method = "/UserService/GetUser";
        let method_id = rpc_UserService_method_id(method);
        if method_id != 1 {
            puts("FAIL: unknown RPC method");
            return 1;
        }

        let srv_req = rpc_UserService_GetUser_decode_request(req_wire.data as *u8, req_wire.len);
        if srv_req.user_id != 12345 {
            puts("FAIL: server received wrong user_id");
            return 2;
        }

        // Сервер готовит ответ
        let mut resp: UserResponse = zeroed();
        resp.user_id = srv_req.user_id;
        resp.has_user_id = true;

        let uname = gpb_str("alex");
        resp.username_ptr = uname.data;
        resp.username_len = uname.len;
        resp.has_username = true;

        let uemail = gpb_str("alex@goraw.dev");
        resp.email_ptr = uemail.data;
        resp.email_len = uemail.len;
        resp.has_email = true;

        let mut resp_wire: GpbBuf = gpb_buf_new();
        rpc_UserService_GetUser_encode_response(&resp, &mut resp_wire);

        // --- 3. Клиент принимает wire-ответ сервера ---
        let client_resp = rpc_UserService_GetUser_decode_response(resp_wire.data as *u8, resp_wire.len);
        if client_resp.user_id != 12345 {
            puts("FAIL: client received wrong user_id");
            return 3;
        }
        if !client_resp.has_username || client_resp.username_len != 4 {
            puts("FAIL: client received wrong username");
            return 4;
        }
        if !client_resp.has_email || client_resp.email_len != 14 {
            puts("FAIL: client received wrong email");
            return 5;
        }

        puts("SUCCESS: Goraw native Protobuf RPC microservice demo completed!");
        return 0;
    }
}
