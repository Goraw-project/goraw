extern fn printf(fmt: *u8, ...) -> i32;

fn dump(b: *mut GpbBuf, name: *u8) {
    unsafe {
        printf("%s (%lld):", name, b.len);
        for i := 0; i < b.len; i++ { printf(" %02X", b.data[i] as i32); }
        printf("\n");
    }
}

fn main() -> i32 {
    let mut inr = Inner { v: 7, has_v: true };
    let raw: *mut i32 = alloc(8) as *mut i32;
    unsafe { raw[0] = 1; raw[1] = 300; }
    let nums = make_slice(raw, 2);
    let mut r = Rich {
        id: 1, has_id: true,
        delta: -1, has_delta: true,
        flag: true, has_flag: true,
        nums: nums,
        inner: &mut inr,
        code: 0x01020304, has_code: true,
    };

    let mut b = gpb_buf_new();
    encode_Rich(&mut r, &mut b);
    dump(&mut b, "encoded  ");

    let mut r2 = decode_Rich(b.data as *u8, b.len);
    let mut b2 = gpb_buf_new();
    encode_Rich(&mut r2, &mut b2);
    dump(&mut b2, "roundtrip");

    unsafe {
        printf("decoded: id=%lld delta=%d flag=%d code=%08X nums.len=%lld inner.v=%d\n",
               r2.id, r2.delta, r2.flag as i32, r2.code, r2.nums.len, (*r2.inner).v);
    }
    return 0;
}
