import "pb2_all.gw";

extern fn puts(s: *u8) -> i32;

fn main() -> i32 {
    unsafe {
        let mut b: GpbBuf = gpb_buf_new();

        // 1. Создаём исходное сообщение
        let mut orig: ComplexMessage = zeroed();
        orig.message_id = 42;
        orig.has_message_id = true;

        // Tags (repeated string)
        let mut tag_arr: [3]GpbString = [
            gpb_str("compiler"),
            gpb_str("backend"),
            gpb_str("llvm")
        ];
        orig.tags = make_slice(&mut tag_arr[0], 3);

        // Items (repeated message)
        let mut it1: SubItem = zeroed();
        it1.id = 101;
        it1.has_id = true;
        let s1: GpbString = gpb_str("item_alpha");
        it1.title_ptr = s1.data;
        it1.title_len = s1.len;
        it1.has_title = true;

        let mut it2: SubItem = zeroed();
        it2.id = 202;
        it2.has_id = true;
        let s2: GpbString = gpb_str("item_beta");
        it2.title_ptr = s2.data;
        it2.title_len = s2.len;
        it2.has_title = true;

        let mut item_ptrs: [2]*SubItem = [&it1, &it2];
        orig.items = make_slice(&mut item_ptrs[0], 2);

        // Scores (map<string, int32>)
        let mut sc1: ComplexMessage_Scores_Entry = zeroed();
        sc1.key = gpb_str("alice");
        sc1.value = 99;

        let mut sc2: ComplexMessage_Scores_Entry = zeroed();
        sc2.key = gpb_str("bob");
        sc2.value = 85;

        let mut score_entries: [2]ComplexMessage_Scores_Entry = [sc1, sc2];
        orig.scores = make_slice(&mut score_entries[0], 2);

        // Oneof payload (code_data = 1337)
        orig.which_payload = COMPLEXMESSAGE_PAYLOAD_CODE_DATA;
        orig.code_data = 1337;

        // 2. Кодируем в wire format
        encode_ComplexMessage(&orig, &mut b);

        // 3. Декодируем из wire format
        let dec: ComplexMessage = decode_ComplexMessage(b.data as *u8, b.len);

        // 4. Проверяем все поля
        if dec.message_id != 42 {
            puts("FAIL: message_id");
            return 1;
        }

        if dec.tags.len != 3 {
            puts("FAIL: tags.len");
            return 2;
        }

        if dec.items.len != 2 {
            puts("FAIL: items.len");
            return 3;
        }

        if dec.items[0].id != 101 {
            puts("FAIL: items[0].id");
            return 4;
        }

        if dec.items[1].id != 202 {
            puts("FAIL: items[1].id");
            return 5;
        }

        if dec.scores.len != 2 {
            puts("FAIL: scores.len");
            return 6;
        }

        if dec.scores[0].value != 99 {
            puts("FAIL: scores[0].value");
            return 7;
        }

        if dec.scores[1].value != 85 {
            puts("FAIL: scores[1].value");
            return 8;
        }

        if dec.which_payload != COMPLEXMESSAGE_PAYLOAD_CODE_DATA {
            puts("FAIL: which_payload");
            return 9;
        }

        if dec.code_data != 1337 {
            puts("FAIL: code_data");
            return 10;
        }

        puts("SUCCESS: PB2 Protobuf (map, oneof, repeated string/msg) encode+decode passed!");
        return 0;
    }
}
