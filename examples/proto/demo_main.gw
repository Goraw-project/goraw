// Драйвер (пока нет модулей — склеиваем с сгенерированным).
extern fn printf(fmt: *u8, ...) -> i32;

fn main() -> i32 {
    let mut p = Point {
        x: 150, has_x: true,
        y: 0, has_y: false,
        label_ptr: "hi", label_len: 2, has_label: true,
    };
    let mut b = gpb_buf_new();
    encode_Point(&mut p, &mut b);
    unsafe {
        printf("Point{x=150, label=hi} -> (%lld):", b.len);
        for i := 0; i < b.len; i++ {
            printf(" %02X", b.data[i] as i32);
        }
        printf("\n");
        free(b.data);
    }
    return 0;
}
