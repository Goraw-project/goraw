// Обзорный пример Goraw: extern-C, структуры, циклы, рекурсия, unsafe.

extern fn printf(fmt: *u8, ...) -> i32;

struct Vec2 {
    x: f64,
    y: f64,
}

// Рекурсия + вывод типов для литералов.
fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

// Go-style цикл и суммирование. Литералы `0`/`1` подстраиваются под i64,
// поэтому `i := 0` тоже i64 — типы сходятся без приведений.
fn calculate_sum(limit: i64) -> i64 {
    let mut sum: i64 = 0;
    for i := 0; i < limit; i++ {
        sum = sum + i;
    }
    return sum;
}

// Структуры по значению + доступ к полям.
fn dot(a: Vec2, b: Vec2) -> f64 {
    return a.x * b.x + a.y * b.y;
}

fn main() -> i32 {
    printf("fib(20)      = %lld\n", fib(20));
    printf("sum(0..100)  = %lld\n", calculate_sum(100));

    let v = Vec2 { x: 1.5, y: 2.0 };
    let w = Vec2 { x: 3.0, y: 4.0 };
    printf("dot(v, w)    = %f\n", dot(v, w));

    // safe-адресация + unsafe-разыменование
    let mut cell: i64 = 41;
    let p: *mut i64 = &mut cell;
    unsafe {
        *p = *p + 1;
    }
    printf("cell         = %lld\n", cell);

    return 0;
}
