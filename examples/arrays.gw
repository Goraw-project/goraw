// Массивы фиксированного размера [N]T: литералы, .len, индексация
// с проверкой границ, семантика значения (копируются при передаче).
extern fn printf(fmt: *u8, ...) -> i32;

fn dot3(a: [3]i64, b: [3]i64) -> i64 {
    let mut s: i64 = 0;
    for i := 0; i < a.len; i++ { s += a[i] * b[i]; }
    return s;
}

fn main() -> i32 {
    let u: [3]i64 = [1, 2, 3];
    let v: [3]i64 = [4, 5, 6];
    printf("dot = %lld (ждём 32)\n", dot3(u, v));
    return 0;
}
