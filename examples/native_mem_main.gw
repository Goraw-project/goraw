extern fn printf(fmt: *u8, ...) -> i32;

extern fn gsum3(arr: *i64) -> i64;
extern fn gstore(arr: *i64, val: i64);
extern fn gelem(arr: *i64, idx: i64) -> *i64;

fn main() -> i32 {
    let mut data: [3]i64 = [10, 20, 30];
    let ptr: *i64 = &mut data[0];

    let sum = gsum3(ptr);
    printf("initial gsum3(&data) = %lld (expected 60)\n", sum);

    gstore(ptr, 99);
    printf("after gstore(ptr, 99): data[0] = %lld (expected 99)\n", data[0]);

    let p2: *i64 = gelem(ptr, 2);
    let mut val_at_p2: i64 = 0;
    unsafe {
        val_at_p2 = *p2;
    }
    printf("gelem(ptr, 2) value = %lld (expected 30)\n", val_at_p2);

    let sum2 = gsum3(ptr);
    printf("final gsum3(&data) = %lld (expected 149)\n", sum2);

    if sum == 60 && data[0] == 99 && val_at_p2 == 30 && sum2 == 149 {
        printf("SUCCESS: native memory operands work end-to-end!\n");
        return 0;
    }
    return 1;
}
