// Mandatory Shadow Tests: test-блоки прогоняются через `gorawc --test` и
// вырезаются из обычной (релизной) сборки. assert допустим только в них.
extern fn printf(fmt: *u8, ...) -> i32;

fn add(a: i64, b: i64) -> i64 { return a + b; }
fn factorial(n: i64) -> i64 {
    let mut r: i64 = 1;
    for i := 1; i <= n; i++ { r *= i; }
    return r;
}

test "сложение" {
    assert add(2, 3) == 5;
    assert add(-4, 4) == 0;
}

test "факториал" {
    assert factorial(0) == 1;
    assert factorial(5) == 120;
}

// Обычный main — в релизе (без --test) он и остаётся, тесты вырезаются.
fn main() -> i32 {
    printf("factorial(6) = %lld\n", factorial(6));
    return 0;
}
