// Методы структур: fn Type::method(self, ...). self — безопасная ссылка
// (*mut Type), доступ к полям без unsafe; мутация работает.
extern fn printf(fmt: *u8, ...) -> i32;

struct Stack { data: [8]i64, top: i64 }

fn Stack::push(self, x: i64) { self.data[self.top] = x; self.top += 1; }
fn Stack::pop(self) -> i64 { self.top -= 1; return self.data[self.top]; }
fn Stack::size(self) -> i64 { return self.top; }

fn main() -> i32 {
    let mut s = Stack { data: zeroed(), top: 0 };
    s.push(10); s.push(20); s.push(30);
    printf("size=%lld pop=%lld pop=%lld size=%lld\n", s.size(), s.pop(), s.pop(), s.size());
    return 0;
}
