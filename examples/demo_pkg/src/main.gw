import "supercalc";

extern fn printf(fmt: *u8, ...) -> i32;

fn main() -> i32 {
    let s = calc_sum(40, 2);
    let m = calc_mul(6, 7);
    printf("Calculated: sum=%lld, mul=%lld\n", s, m);
    return 0;
}

test "supercalc addition" {
    assert(calc_sum(10, 20) == 30);
}

test "supercalc multiplication" {
    assert(calc_mul(5, 5) == 25);
}
