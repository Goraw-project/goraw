// Динамическая память в Goraw: растущий байтовый буфер поверх кучи +
// protobuf base-128 varint. Доказывает, что язык дорос до Vec/Bytes.
extern fn printf(fmt: *u8, ...) -> i32;

struct Buf {
    data: *mut u8,
    len: i64,
    cap: i64,
}

fn buf_new() -> Buf {
    let cap: i64 = 8;
    return Buf { data: alloc(cap), len: 0, cap: cap };
}

fn buf_push(b: *mut Buf, x: u8) {
    unsafe {
        if b.len == b.cap {
            let nc: i64 = b.cap * 2;
            b.data = realloc(b.data, nc);
            b.cap = nc;
        }
        b.data[b.len] = x;
        b.len = b.len + 1;
    }
}

// protobuf варинт: младшие 7 бит на байт, старший бит — «есть продолжение».
fn write_varint(b: *mut Buf, v: u64) {
    let mut x: u64 = v;
    while x >= 128 {
        let byte: u8 = ((x & 127) | 128) as u8;
        buf_push(b, byte);
        x = x >> 7;
    }
    buf_push(b, x as u8);
}

fn main() -> i32 {
    let mut b = buf_new();
    write_varint(&mut b, 300);    // ждём AC 02
    write_varint(&mut b, 1);      // 01
    write_varint(&mut b, 16384);  // 80 80 01

    unsafe {
        printf("varint bytes (%lld):", b.len);
        for i := 0; i < b.len; i++ {
            printf(" %02X", b.data[i] as i32);
        }
        printf("\n");
        free(b.data);
    }
    return 0;
}
