extern fn printf(fmt: *u8, ...) -> i32;

fn main() -> i32 {
    // Захват вкомпилируется как константа в машинный код на лету.
    let base_multiplier: i32 = 10;

    let scale = jit(captures: [base_multiplier]) {
        fn execute(a: i32, b: i32) -> i32 {
            return (a + b) * base_multiplier;
        }
    };

    printf("scale(5, 3) = %d  (ждём 80)\n", scale(5, 3));

    // Специализация под РАЗНЫЕ захваты прямо в цикле: каждая итерация
    // JIT-компилирует свою версию функции с вкомпилированным множителем.
    for k := 1; k <= 3; k++ {
        let m: i32 = k as i32 * 100;
        let f = jit(captures: [m]) {
            fn execute(x: i32) -> i32 {
                return x + m;
            }
        };
        printf("f_%d(7) = %d\n", k, f(7));
    }

    return 0;
}
