extern fn printf(fmt: *u8, ...) -> i32;

unsafe fn divmod(a: u32, b: u32) -> i32 {
    let mut q: u32 = 0;
    let mut r: u32 = 0;
    asm("masm", inputs: [a, b], outputs: [q, r]) {
        mov eax, a
        xor edx, edx
        div b
        mov q, eax
        mov r, edx
    };
    printf("%u / %u = %u, rem = %u\n", a, b, q, r);
    return 0;
}

fn main() -> i32 {
    unsafe {
        divmod(100, 7);
    }
    return 0;
}
