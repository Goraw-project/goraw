// Демонстрация новейших стандартов C++23 и C23 в инлайн-вставках Goraw

extern fn printf(fmt: *u8, ...) -> i32;

// 1. Верхнеуровневый C++23 блок с новыми фичами стандарта
cpp {
    #include <vector>
    #include <numeric>
    #include <ranges>
    #include <expected>

    // C++23: Многомерный оператор индексации operator[](r, c)
    struct Grid23 {
        int cells[3][3]{};

        int& operator[](int r, int c) {
            return cells[r][c];
        }
    };

    // C++23: Функция с std::expected и C++20/23 ranges views
    extern "C" int cpp23_calc_grid(int base) {
        Grid23 g;
        g[1, 2] = base * 10;

        // C++20/23 ranges view pipeline
        std::vector<int> nums = {1, 2, 3, 4};
        auto square = [](int x) { return x * x; };
        int sum_sq = 0;
        for (int v : nums | std::views::transform(square)) {
            sum_sq += v;
        }

        return sum_sq + g[1, 2];
    }
}

// 2. Верхнеуровневый C23 блок
c {
    #include <stdio.h>

    int c23_demo(int val) {
        // C23: constexpr переменные на уровне функций и nullptr
        constexpr int factor = 5;
        void* ptr = nullptr;
        if (ptr == nullptr) {
            return val * factor;
        }
        return 0;
    }
}

fn main() -> i32 {
    printf("=== ТЕСТ НОВЕЙШИХ СТАНДАРТОВ C++23 И C23 В GORAW ===\n\n");

    // 1. Вызов C++23 функции с многомерным operator[], ranges и std::expected
    // sum_sq = 1^2 + 2^2 + 3^2 + 4^2 = 1 + 4 + 9 + 16 = 30
    // g[1, 2] = 7 * 10 = 70
    // Итого = 100
    let cpp23_res = cpp23_calc_grid(7);
    printf("[C++23] Grid23[1,2] + ranges transform sum = %d (ожидалось 100)\n", cpp23_res);

    // 2. Вызов C23 функции с constexpr и nullptr
    let c23_res = c23_demo(20);
    printf("[C23] constexpr factor * 20 = %d (ожидалось 100)\n", c23_res);

    // 3. Инлайн C++23 вставка внутри функции
    let mut stmt_out: i64 = 0;
    let in_val: i64 = 42;
    cpp(inputs: [in_val], outputs: [stmt_out]) {
        // C++23 лямбда и auto
        auto f = [](long long x) { return x * 2; };
        *stmt_out = f(in_val);
    }
    printf("[C++23 inline stmt] lambda(42) = %lld (ожидалось 84)\n", stmt_out);

    printf("\nТЕСТЫ СТАНДАРТОВ C++23 И C23 ПРОЙДЕНЫ УСПЕШНО!\n");
    return 0;
}
