extern fn c_multiply(a: i32, b: i32) -> i32;

fn main() -> i32 {
    println("--- Testing LLVM Bitcode Interop (.bc) ---");
    let res = c_multiply(6, 7);
    println("c_multiply(6, 7) = ", res);
    if res != 42 {
        panic("c_multiply failed");
    }
    println("SUCCESS: LLVM Bitcode linked and executed perfectly!");
    return 0;
}
