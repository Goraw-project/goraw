// Глобальные константы: свёртка в компайл-тайме (литералы, арифметика,
// enum, cast, ссылки на другие константы).
extern fn printf(fmt: *u8, ...) -> i32;

const KB: i64 = 1024;
const MB: i64 = KB * KB;
const PI: f64 = 3.141592653589793;
const TWO_PI: f64 = PI * 2.0;

fn main() -> i32 {
    printf("MB=%lld  2pi=%f\n", MB, TWO_PI);
    return 0;
}
