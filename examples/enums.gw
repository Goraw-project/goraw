// Перечисления (C-style, представляются i32).
extern fn printf(fmt: *u8, ...) -> i32;

enum Color { Red, Green, Blue }
enum Status { Ok = 0, NotFound = 404, Teapot = 418 }

fn name_of(c: Color) -> *u8 {
    if c == Color::Red { return "red"; }
    if c == Color::Green { return "green"; }
    return "blue";
}

fn main() -> i32 {
    let c: Color = Color::Green;
    printf("Green=%d name=%s NotFound=%d Teapot=%d\n",
        c, name_of(c), Status::NotFound, Status::Teapot);
    return 0;
}
