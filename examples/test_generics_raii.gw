// Тест Дженериков (Generics / Monomorphization) и RAII деструкторов в Goraw

import "../std/vec.gw";
import "../std/box.gw";

extern fn printf(fmt: *u8, ...) -> i32;

struct Guard<T> {
    tag: i64,
    item: T,
}

fn Guard<T>::drop(self) {
    printf("[RAII Drop] Guard<T> #%lld автоматически очищен через drop()!\n", self.tag);
}

fn test_generic_vec() {
    let mut v = Vec<i64>::new();
    v.push(10);
    v.push(20);
    v.push(30);

    printf("[Vec<i64>] len=%lld, cap=%lld\n", v.len(), v.cap());
    printf("[Vec<i64>] v[0]=%lld, v[1]=%lld, v[2]=%lld\n", v.get(0), v.get(1), v.get(2));

    let last = v.pop();
    printf("[Vec<i64>] popped=%lld, new len=%lld\n", last, v.len());
    // При выходе из функции test_generic_vec вызывается v.drop() и память освобождается!
}

fn test_generic_box() {
    let mut b = Box<i64>::new(42);
    printf("[Box<i64>] value=%lld\n", b.get());
    b.set(999);
    printf("[Box<i64>] updated value=%lld\n", b.get());
    // При выходе из функции test_generic_box вызывается b.drop() и куча освобождается!
}

fn test_generic_raii_guard() {
    let g = Guard<i64> { tag: 888, item: 12345 };
    printf("[Guard<i64>] создан guard tag=%lld item=%lld\n", g.tag, g.item);
    // При выходе из области видимости сработает Guard__i64__drop(&g)!
}

fn main() -> i32 {
    printf("=== ТЕСТ ДЖЕНЕРИКОВ (GENERICS) И RAII В GORAW ===\n\n");

    test_generic_vec();
    test_generic_box();
    test_generic_raii_guard();

    printf("\nВсе тесты дженериков и RAII завершены успешно!\n");
    return 0;
}
