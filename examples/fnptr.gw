extern fn printf(fmt: *u8, ...) -> i32;

fn double(x: i64) -> i64 { return x * 2; }
fn inc(x: i64) -> i64 { return x + 1; }
fn square(x: i64) -> i64 { return x * x; }

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }

fn main() -> i32 {
    let f: fn(i64) -> i64 = double;
    printf("f(21)=%lld apply(inc,41)=%lld\n", f(21), apply(inc, 41));

    // таблица диспетчеризации: массив указателей на функции
    let ops: [3]fn(i64) -> i64 = [double, inc, square];
    for i := 0; i < ops.len; i++ {
        printf("ops[%lld](5)=%lld\n", i, ops[i](5));
    }
    return 0;
}
