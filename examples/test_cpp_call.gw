extern fn cpp_sum_array(data: *i32, count: i32) -> i32;

fn main() -> i32 {
    println("--- Testing Calling C++ (std::vector & std::accumulate) from Goraw ---");
    let arr: [5]i32 = [10, 20, 30, 40, 50];
    let sum = cpp_sum_array(&arr[0], 5);
    println("Sum from C++: ", sum);
    if sum != 150 {
        panic("sum != 150");
    }
    println("SUCCESS: Goraw called C++20 standard library seamlessly!");
    return 0;
}
