// Тест встроенной обфускации строк Goraw (ROT+XOR).

fn check(cond: bool, msg: str) {
    if !cond {
        println("FAILURE: ", msg);
        panic("assertion failed");
    }
}

fn main() -> i32 {
    println("--- Goraw String Obfuscation Demo ---");

    // 1. Явный маркер obf(...)
    let secret = obf("TOP_SECRET_ENCRYPTED_KEY_998877");
    println("Marker obf(): ", secret);
    check(secret.len == 31, "secret.len == 31");
    check(secret == "TOP_SECRET_ENCRYPTED_KEY_998877", "secret matches expected value");
    check(secret.starts_with("TOP_SECRET"), "secret.starts_with");

    // 2. Обычный литерал (при флаге --obfuscate-strings он также будет зашифрован)
    let auto_secret = "AUTOMATICALLY_OBFUSCATED_CONFIDENTIAL_DATA";
    println("Auto literal: ", auto_secret);
    check(auto_secret.len == 42, "auto_secret.len == 42");
    check(auto_secret.ends_with("DATA"), "auto_secret.ends_with");

    // 3. Маркер obf_str(...)
    let alias_secret = obf_str("ANOTHER_SECURE_TOKEN_5544");
    println("Alias obf_str(): ", alias_secret);
    check(alias_secret == "ANOTHER_SECURE_TOKEN_5544", "alias_secret matches");

    println("All obfuscation checks PASSED successfully!");
    return 0;
}
