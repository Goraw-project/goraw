// Декомпилировано из LLVM IR транслятором Goraw (llvm_to_goraw)
// Восстановление структурированного CFG, ZST-элиминация, единая область видимости

extern fn printf(arg0: *u8, ...) -> i32;

fn hypot(a: f64, b: f64) -> f64 {
    let mut t5: f64 = 0.0;
    let mut t7: f64 = 0.0;
    let mut t1: f64 = 0.0;
    let mut t2: f64 = 0.0;
    let mut t6: f64 = 0.0;
    let mut b_1: f64 = 0.0;
    let mut t8: f64 = 0.0;
    let mut a_1: f64 = 0.0;
    let mut t3: f64 = 0.0;
    let mut t4: f64 = 0.0;
    t3 = a * a;
    t6 = b * b;
    t7 = t3 + t6;
    t8 = sqrt(t7);
    return t8;
}

fn main(argc: i32, argv: *u8) -> i32 {
    let mut t5: f64 = 0.0;
    let mut r: f64 = 0.0;
    let mut t13: i64 = 0;
    let mut t10: f64 = 0.0;
    let mut t11: i32 = 0;
    let mut h: f64 = 0.0;
    let mut t12: i64 = 0;
    let mut t1: f64 = 0.0;
    let mut t7: f64 = 0.0;
    let mut t14: i32 = 0;
    let mut t9: i32 = 0;
    let mut t15: i64 = 0;
    let mut t8: f64 = 0.0;
    let mut t6: f64 = 0.0;
    let mut t3: i32 = 0;
    let mut t16: i32 = 0;
    let mut t4: f64 = 0.0;
    let mut t2: f64 = 0.0;
    t1 = hypot(3.0, 4.0);
    h = t1;
    t3 = printf("hypot(3,4)      = %f\n", h);
    t4 = -15.9;
    t5 = abs(t4);
    t6 = sqrt(t5);
    t7 = ceil(t6);
    r = t7;
    t9 = printf("ceil(sqrt|-15.9|)= %f\n", r);
    t10 = pow(2.0, 10.0);
    t11 = printf("pow(2, 10)      = %f\n", t10);
    t12 = max(42, 0);
    t13 = min(t12, 10);
    t14 = printf("clamp(42,0,10)  = %lld\n", t13);
    t15 = max(7, 3);
    t16 = printf("max(7, 3)       = %lld\n", t15);
    return 0;
}

