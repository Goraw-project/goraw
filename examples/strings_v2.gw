fn assert_true(cond: bool, msg: str) {
    if !cond {
        println("ASSERTION FAILED: ", msg);
        panic("test failed");
    }
}

fn main() -> i32 {
    println("--- Testing Goraw First-Class str & Slices ---");

    // 1. Литералы и печать разных типов
    let s1 = "Hello";
    let s2 = " World!";
    println("s1 = ", s1);
    println("s2 = ", s2);
    println("Mixed print: int=", 12345, ", bool=", true, ", str=", s1);

    // 2. Конкатенация '+'
    let full = s1 + s2;
    println("full = ", full);
    assert_true(full.len == 12, "full.len == 12");

    // 3. Сравнение '==' и '!='
    assert_true(full == "Hello World!", "full == Hello World!");
    assert_true(full != "Hello", "full != Hello");
    assert_true("abc" == "abc", "abc == abc");
    assert_true("abc" != "xyz", "abc != xyz");
    assert_true("short" != "longer string", "different lengths not equal");

    // 4. Срезы строк [start..end], [start..], [..end], [..]
    let sub1 = full[0..5];
    println("sub1 [0..5] = ", sub1);
    assert_true(sub1 == "Hello", "full[0..5] == Hello");

    let sub2 = full[6..12];
    println("sub2 [6..12] = ", sub2);
    assert_true(sub2 == "World!", "full[6..12] == World!");

    let sub3 = full[6..];
    println("sub3 [6..] = ", sub3);
    assert_true(sub3 == "World!", "full[6..] == World!");

    let sub4 = full[..5];
    println("sub4 [..5] = ", sub4);
    assert_true(sub4 == "Hello", "full[..5] == Hello");

    let sub5 = full[..];
    assert_true(sub5 == full, "full[..] == full");

    // 5. Индексация байтов в str
    let first_byte = full[0];
    assert_true(first_byte == 72 as u8, "full[0] == 'H' (72)");

    // 6. Методы str
    assert_true(full.starts_with("Hello"), "starts_with Hello");
    assert_true(!full.starts_with("World"), "!starts_with World");
    assert_true(full.ends_with("World!"), "ends_with World!");
    assert_true(!full.ends_with("Hello"), "!ends_with Hello");
    assert_true(!full.is_empty(), "!full.is_empty()");
    assert_true("".is_empty(), "\"\".is_empty()");

    let cloned = full.clone();
    assert_true(cloned == full, "cloned == full");
    assert_true(cloned.ptr != full.ptr, "cloned buffer is distinct");

    // 7. Срезы обычных массивов
    let arr = [100, 200, 300, 400, 500];
    let arr_slice = arr[1..4];
    assert_true(arr_slice.len == 3, "arr_slice.len == 3");
    assert_true(arr_slice[0] == 200, "arr_slice[0] == 200");
    assert_true(arr_slice[1] == 300, "arr_slice[1] == 300");
    assert_true(arr_slice[2] == 400, "arr_slice[2] == 400");

    // 8. str_from_cstr
    let cstr: *u8 = "C-string from pointer";
    let from_c = str_from_cstr(cstr);
    assert_true(from_c == "C-string from pointer", "str_from_cstr works");

    println("SUCCESS: All str and slice tests passed!");
    return 0;
}
