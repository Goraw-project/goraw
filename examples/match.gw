// match: switch по целым/enum (LLVM switch). Ветви — блоки; `_` — иначе.
extern fn printf(fmt: *u8, ...) -> i32;
enum Op { Add, Sub, Mul, Div }

fn apply(op: Op, a: i64, b: i64) -> i64 {
    match op {
        Op::Add => { return a + b; }
        Op::Sub => { return a - b; }
        Op::Mul => { return a * b; }
        Op::Div => { return a / b; }
        _ => { return 0; }
    }
}

fn main() -> i32 {
    printf("%lld %lld %lld %lld\n",
        apply(Op::Add, 12, 4), apply(Op::Sub, 12, 4),
        apply(Op::Mul, 12, 4), apply(Op::Div, 12, 4));
    return 0;
}
