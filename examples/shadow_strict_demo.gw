fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn factorial(n: i64) -> i64 {
    let mut r: i64 = 1;
    for i := 1; i <= n; i++ {
        r *= i;
    }
    return r;
}

shadow add {
    assert add(2, 3) == 5;
    assert add(-4, 4) == 0;
}

shadow factorial {
    assert factorial(0) == 1;
    assert factorial(5) == 120;
}

fn main() -> i32 {
    return 0;
}
