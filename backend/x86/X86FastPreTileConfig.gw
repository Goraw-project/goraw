    return false;
}

fn X86FastPreTileConfigLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FastPreTileConfigLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86FastPreTileConfigLegacy::getResolver(self: *X86FastPreTileConfigLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

