static mut NumStores: Statistic = Statistic { "x86-fast-pre-tile-config", "NumStores", "Number of stores added" };

static mut NumLoads: Statistic = Statistic { "x86-fast-pre-tile-config", "NumLoads", "Number of loads added" };

struct X86FastPreTileConfigImpl {
    MF: *mut MachineFunction,
    ST: *X86Subtarget,
    TII: *TargetInstrInfo,
    MRI: *mut MachineRegisterInfo,
    X86FI: *mut X86MachineFunctionInfo,
    MFI: *mut MachineFrameInfo,
    TRI: *TargetRegisterInfo,
    MBB: *mut MachineBasicBlock,
    CfgSS: i32,
    VisitedPHIs: i32,
    StackSlotForVirtReg: IndexedMap<int, VirtReg2IndexFunctor>,
    MayLiveAcrossBlocks: BitVector,
}

