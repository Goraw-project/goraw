const BundleAlign: Align = Constant();

struct X86LFIRewriteLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86LFIRewriteLegacy::getPassName(self: *X86LFIRewriteLegacy) -> str {
    return "X86 LFI rewrites";
}

fn X86LFIRewriteLegacy::getPassKind(self: *X86LFIRewriteLegacy) -> PassKind {
    return self.Kind;
}

fn X86LFIRewriteLegacy::getPassID(self: *X86LFIRewriteLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86LFIRewriteLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LFIRewriteLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LFIRewriteLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86LFIRewriteLegacy::getResolver(self: *X86LFIRewriteLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86LFIRewriteLegacy::getRequiredProperties(self: *X86LFIRewriteLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86LFIRewriteLegacy::getSetProperties(self: *X86LFIRewriteLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86LFIRewriteLegacy::getClearedProperties(self: *X86LFIRewriteLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn alignToBundle(MBB: *mut MachineBasicBlock) {
    MBB.setAlignment(if MBB.getAlignment() > BundleAlign { MBB.getAlignment() } else { BundleAlign }, 0);
}

fn isIndirectlyReachable(MBB: *MachineBasicBlock) -> bool {
    return MBB.hasAddressTaken() || MBB.isEHPad();
}

fn alignIndirectBranchTargets(MF: *mut MachineFunction) {
    MF.ensureAlignment(BundleAlign);
    if MF.getJumpTableInfo() {
        JTI;
    } else {
        for JTE in JTI.getJumpTables() {
            for MBB in JTE.MBBs {
                alignToBundle(*MBB);
            }
        }
    }
    for MBB in MF {
        if isIndirectlyReachable(MBB) {
            alignToBundle(MBB);
        }
    }
}

fn X86LFIRewriteLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    alignIndirectBranchTargets(MF);
    return true;
}

fn X86LFIRewritePass::run(self, MF: *mut MachineFunction, arg: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    alignIndirectBranchTargets(MF);
    return all();
}

fn createX86LFIRewritePass() -> *mut FunctionPass {
    return X86LFIRewriteLegacy {};
}
