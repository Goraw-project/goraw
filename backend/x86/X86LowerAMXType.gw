fn X86LowerAMXType::transformBitcast(self, Bitcast: *mut BitCastInst) -> bool {
    let mut Builder: i32 = Bitcast;
    let mut AllocaAddr: *mut AllocaInst = null;
    let mut I8Ptr: *mut Value = null;
    let mut Stride: *mut Value = null;
    let mut Src: *mut Value = Bitcast.getOperand(0);
    let mut Prepare: Closure_1 = Closure_1 { AllocaAddr: &mut AllocaAddr, Bitcast: &mut Bitcast, I8Ptr: &mut I8Ptr, Stride: &mut Stride };
    if Bitcast.getType().isX86_AMXTy() {
        let mut U: *mut Use = operator((Bitcast.use_begin()));
        let mut OpNo: u32 = U.getOperandNo();
        let mut II: *mut auto = dyn_cast(U.getUser());
        if operator!() {
            return false;
        }
        Prepare.call(Bitcast.getOperand(0).getType());
        Builder()(Src, AllocaAddr);
        let mut Row: *mut Value = null;
        let mut Col: *mut Value = null;
        let mut Args: array<Value *, 4> = zeroed();
        let mut NewInst: *mut Value = ;
        Bitcast.replaceAllUsesWith(NewInst);
