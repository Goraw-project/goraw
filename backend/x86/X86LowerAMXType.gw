fn getAllocaPos(BB: *mut BasicBlock) -> *mut Value {
    let mut F: *mut Function = BB.getParent();
    let mut Builder: i32 = &mut F.getEntryBlock().front();
    let mut DL: *DataLayout = F.getDataLayout();
    let mut AllocaAS: u32 = DL.getAllocaAddrSpace();
    let mut V256I32Ty: *mut Type = get(256, false);
    let mut AllocaRes: *mut AllocaInst = AllocaInst { V256I32Ty, AllocaAS, "", InsertPosition { InsertAt: F.getEntryBlock().begin() } };
    let mut Iter: iterator = AllocaRes.getIterator();
    operator(Iter);
    Builder()(&mut operator(Iter));
    let mut I8Ptr: *mut Value = (AllocaRes);
    return I8Ptr;
}

fn createTileStore(TileDef: *mut Instruction, Ptr: *mut Value) -> *mut Instruction {
    assert!(TileDef.getType().isX86_AMXTy(), "Not define tile!");
    let mut II: *mut auto = cast(TileDef);
    (((operator!(operator!((II() && "Not tile intrinsic!")))) || (_wassert(L"II && \"Not tile intrinsic!\"", L"llvm\\lib\\Target\\X86\\X86LowerAMXType.cpp", (497) as u32) , 0)) as void);
    let mut Row: *mut Value = (0);
    let mut Col: *mut Value = (1);
    let mut BB: *mut BasicBlock = TileDef.getParent();
    let mut Iter: iterator = TileDef.getIterator();
    let mut Builder: i32 = BB;
    let mut Stride: *mut Value = (64);
    let mut Args: array<Value *, 5> = zeroed();
    let mut TileStore: *mut Instruction = ;
    return TileStore;
}

fn replaceWithTileLoad(U: *mut Use, Ptr: *mut Value, IsPHI: bool) {
    let mut V: *mut Value = U.get();
    assert!(V.getType().isX86_AMXTy(), "Not define tile!");
    let mut II: *mut IntrinsicInst = null;
    if IsPHI {
        let mut PhiOp: *mut Value = cast(V)(0);
        II = cast(PhiOp);
    } else {
        II = cast(V);
    }
    let mut Row: *mut Value = II.getOperand(0);
    let mut Col: *mut Value = II.getOperand(1);
    let mut UserI: *mut Instruction = cast(U.getUser());
    let mut Builder: i32 = UserI;
    let mut Stride: *mut Value = (64);
    let mut Args: array<Value *, 4> = zeroed();
    let mut TileLoad: *mut Value = ;
    UserI.replaceUsesOfWith(V, TileLoad);
}

fn isIncomingOfPHI(I: *mut Instruction) -> bool {
    for U in I.uses() {
        let mut V: *mut User = U.getUser();
        if isa(V) {
            return true;
        }
    }
    return false;
}

struct X86VolatileTileData {
    F: *mut Function,
}

fn X86VolatileTileData::updatePhiIncomings(self, BB: *mut BasicBlock, Incomings: *mut SmallVector<Instruction *, 2>) -> *mut Value {
    let mut I8Ptr: *mut Value = getAllocaPos(BB);
    for I in Incomings {
        let mut Store: *mut User = createTileStore(I, I8Ptr);
        for U in I.uses() {
            let mut V: *mut User = U.getUser();
            if isa(V) || V == Store {
                continue;
            }
            replaceWithTileLoad(U, I8Ptr, false);
        }
    }
    return I8Ptr;
}

fn X86VolatileTileData::replacePhiDefWithLoad(self, PHI: *mut Instruction, StorePtr: *mut Value) {
    for U in PHI.uses() {
        replaceWithTileLoad(U, StorePtr, true);
    }
    PHI.eraseFromParent();
}

fn X86VolatileTileData::volatileTilePHI(self, PHI: *mut PHINode) {
    let mut BB: *mut BasicBlock = PHI.getParent();
    let mut Incomings: SmallVector<Instruction *, 2> = SmallVector<Instruction *, 2> {};
    for let mut I: u32 = 0;
let mut E: u32 = PHI.getNumIncomingValues(); I != E; I += 1 {
        let mut Op: *mut Value = PHI.getIncomingValue(I);
        let mut Inst: *mut Instruction = dyn_cast(Op);
        assert!(Inst, "We shouldn't fold AMX instrution!");
        Incomings.push(Inst);
    }
    let mut StorePtr: *mut Value = self.updatePhiIncomings(BB, Incomings);
    self.replacePhiDefWithLoad(PHI, StorePtr);
}

fn X86VolatileTileData::volatileTileNonPHI(self, I: *mut Instruction) {
    let mut BB: *mut BasicBlock = I.getParent();
    let mut I8Ptr: *mut Value = getAllocaPos(BB);
    let mut Store: *mut User = createTileStore(I, I8Ptr);
    for U in I.uses() {
        let mut V: *mut User = U.getUser();
        assert!(!isa(V), "PHI Nodes should be excluded!");
        if V != Store {
            replaceWithTileLoad(U, I8Ptr, false);
        }
    }
}

fn X86VolatileTileData::volatileTileData(self) -> bool {
    let mut Changed: bool = false;
    for BB in self.F {
        let mut PHIInsts: SmallVector<Instruction *, 2> = SmallVector<Instruction *, 2> {};
        let mut AMXDefInsts: SmallVector<Instruction *, 8> = zeroed();
        for I in BB {
            if !I.getType().isX86_AMXTy() {
                continue;
            }
            if isa(&mut I) {
                PHIInsts.push(&mut I);
            } else {
                AMXDefInsts()(&mut I);
            }
        }
        for I in PHIInsts {
            self.volatileTilePHI(dyn_cast(I));
            Changed = true;
        }
    }
    return Changed;
}

struct X86LowerAMXCast {
    Func: *mut Function,
    DT: i32,
}

fn DCEInstruction(I: *mut Instruction, WorkList: *mut SmallSetVector<Instruction *, 16>, TLI: *TargetLibraryInfo) -> bool {
    if isInstructionTriviallyDead(I, TLI) {
        salvageDebugInfo(*I);
        salvageKnowledge(I, null, null);
        for let mut i: u32 = 0;
let mut e: u32 = I.getNumOperands(); i != e; i += 1 {
            let mut OpV: *mut Value = I.getOperand(i);
            I.setOperand(i, null);
            if !OpV.use_empty() || I == OpV {
                continue;
            }
            if dyn_cast(OpV) {
                OpI;
            } else {
                if isInstructionTriviallyDead(OpI, TLI) {
                    WorkList()(OpI);
                }
            }
        }
        I.eraseFromParent();
        return true;
    }
    return false;
}

fn X86LowerAMXCast::optimizeAMXCastFromPhi(self, CI: *mut IntrinsicInst, PN: *mut PHINode, DeadInst: *mut SmallSetVector<Instruction *, 16>) -> bool {
    let mut Builder: i32 = CI;
    let mut Src: *mut Value = CI.getOperand(0);
    let mut SrcTy: *mut Type = Src.getType();
    let mut DestTy: *mut Type = CI.getType();
    let mut PhiWorklist: SmallVector<PHINode *, 4> = zeroed();
    let mut OldPhiNodes: SmallSetVector<PHINode *, 4> = zeroed();
    PhiWorklist()(PN);
    OldPhiNodes()(PN);
    while operator!() {
        let mut OldPN: *mut auto = ();
        for let mut I: u32 = 0; I < OldPN()(); I += 1 {
            let mut IncValue: *mut Value = (I);
            if isa(IncValue) {
                let mut IncConst: *mut auto = dyn_cast(IncValue);
                if !isa(IncValue) && operator!() {
                    return false;
                }
                let mut Row: *mut Value = null;
                let mut Col: *mut Value = null;
                if !Row || !Col || !isa(Row) || !isa(Col) {
                    return false;
                }
                let mut Block: *mut auto = (I);
                let mut Iter: iterator = ()();
                let mut NewInst: *mut Instruction = ;
                NewInst.moveBefore(iterator { Iter });
                NewInst = ;
                NewInst.moveBefore(iterator { Iter });
                OldPN()(I, NewInst);
                IncValue = NewInst;
            }
            if  {
                if OldPhiNodes()() {
                    PhiWorklist()();
                }
                continue;
            }
            let mut ACI: *mut Instruction = dyn_cast(IncValue);
            if ACI && isAMXCast(ACI) {
                let mut TyA: *mut Type = ACI.getOperand(0).getType();
                let mut TyB: *mut Type = ACI.getType();
                if TyA != DestTy || TyB != SrcTy {
                    return false;
                }
                continue;
            }
            return false;
        }
    }
    let mut NewPNodes: i32 = 0;
    return true;
}

fn X86LowerAMXCast::combineCastStore(self, Cast: *mut IntrinsicInst, ST: *mut StoreInst) -> bool {
    let mut Tile: *mut Value = Cast.getOperand(0);
    assert!(Tile.getType().isX86_AMXTy(), "Not Tile Operand!");
    if !Tile.hasOneUse() {
        return false;
