fn X86LowerAMXCast::combineLdSt(self, Casts: *mut SmallVectorImpl<Instruction *>) -> bool {
    let mut Change: bool = false;
    for Cast in Casts {
        let mut II: *mut auto = cast(Cast);
        if  {
            let mut DeadStores: SmallVector<Instruction *, 2> = SmallVector<Instruction *, 2> {};
            for U in Cast.users() {
                let mut Store: *mut StoreInst = dyn_cast(U);
                if !Store {
                    continue;
                }
                if self.combineCastStore(cast(Cast), Store) {
                    DeadStores.push(Store);
                    Change = true;
                }
            }
            for Store in DeadStores {
                Store.eraseFromParent();
            }
        } else {
            if isa(Cast.getOperand(0)) {
                operator|=(Change, self.combineTilezero(cast(Cast)));
                continue;
            }
            let mut Load: *mut auto = dyn_cast(Cast.getOperand(0));
            if operator!() || operator!() {
                continue;
            }
            if self.combineLoadCast(cast(Cast)) {
                Cast.setOperand(0, null);
                Load()();
                Change = true;
            }
        }
    }
    return Change;
}

fn X86LowerAMXCast::combineAMXcast(self, TLI: *mut TargetLibraryInfo) -> bool {
    let mut Change: bool = false;
    let mut Vec2TileInsts: SmallVector<Instruction *, 8> = zeroed();
    let mut Tile2VecInsts: SmallVector<Instruction *, 8> = zeroed();
    let mut PhiCastWorkList: SmallVector<Instruction *, 8> = zeroed();
    let mut DeadInst: SmallSetVector<Instruction *, 16> = zeroed();
    for BB in self.Func {
        for I in BB {
            let mut Vec: *mut Value = null;
            if match(&mut I) {
                Vec2TileInsts()(&mut I);
            } else if match(&mut I) {
                Tile2VecInsts()(&mut I);
            }
        }
    }
    let mut Convert: Closure_2 = Closure_2 { Change: &mut Change };
    Convert();
    Convert();
    let mut LiveCasts: SmallVector<Instruction *, 8> = zeroed();
    let mut EraseInst: Closure_3 = Closure_3 { Change: &mut Change };
    EraseInst();
    EraseInst();
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lower-amx-type", 1) {
            dbgs() << "[LowerAMXTYpe][combineAMXcast] IR dump after combine Vec2Tile and Tile2Vec:\n";
            self.Func.dump();
        }
    }
        if !(false) { break; }
    }
    operator|=(Change, self.combineLdSt());
    EraseInst();
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lower-amx-type", 1) {
            dbgs() << "[LowerAMXTYpe][combineAMXcast] IR dump after combine AMXCast and load/store:\n";
            self.Func.dump();
        }
    }
        if !(false) { break; }
    }
    for BB in self.Func {
        for I in BB {
            if isAMXCast(&mut I) {
                if isa(I.getOperand(0)) {
                    PhiCastWorkList()(&mut I);
                }
            }
        }
    }
    while operator!() {
        let mut I: *mut Instruction = ();
        operator|=(Change, DCEInstruction(I, TLI));
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lower-amx-type", 1) {
            dbgs() << "[LowerAMXTYpe][combineAMXcast] IR dump after optimizeAMXCastFromPhi:\n";
            self.Func.dump();
        }
    }
        if !(false) { break; }
    }
    return Change;
}

fn X86LowerAMXCast::transformAMXCast(self, AMXCast: *mut IntrinsicInst) -> bool {
    let mut Builder: i32 = AMXCast;
    let mut AllocaAddr: *mut AllocaInst = null;
    let mut I8Ptr: *mut Value = null;
    let mut Stride: *mut Value = null;
    let mut Src: *mut Value = AMXCast.getOperand(0);
    let mut Prepare: Closure_4 = Closure_4 { AllocaAddr: &mut AllocaAddr, AMXCast: &mut AMXCast, I8Ptr: &mut I8Ptr, Stride: &mut Stride };
    if AMXCast.getType().isX86_AMXTy() {
        if AMXCast.use_empty() {
            AMXCast.eraseFromParent();
            return true;
        }
        let mut U: *mut Use = operator((AMXCast.use_begin()));
        let mut OpNo: u32 = U.getOperandNo();
        let mut II: *mut auto = dyn_cast(U.getUser());
        if operator!() {
            return false;
        }
        Prepare.call(AMXCast.getOperand(0).getType());
        Builder()(Src, AllocaAddr);
        let mut Row: *mut Value = null;
        let mut Col: *mut Value = null;
        let mut Args: array<Value *, 4> = zeroed();
        let mut NewInst: *mut Value = ;
        AMXCast.replaceAllUsesWith(NewInst);
        AMXCast.eraseFromParent();
    } else {
        let mut II: *mut auto = dyn_cast(Src);
        if operator!() {
            return false;
        }
        Prepare.call(AMXCast.getType());
        let mut Row: *mut Value = (0);
        let mut Col: *mut Value = (1);
        let mut Args: array<Value *, 5> = zeroed();
        Builder();
        let mut NewInst: *mut Value = (AMXCast.getType(), AllocaAddr);
        AMXCast.replaceAllUsesWith(NewInst);
        AMXCast.eraseFromParent();
    }
    return true;
}

fn X86LowerAMXCast::transformAllAMXCast(self) -> bool {
    let mut Change: bool = false;
    let mut WorkLists: SmallVector<Instruction *, 8> = zeroed();
    for BB in self.Func {
        for I in BB {
            if isAMXCast(&mut I) {
                WorkLists()(&mut I);
            }
        }
    }
    return Change;
}

fn lowerAmxType(F: *mut Function, TM: *TargetMachine, TLI: *mut TargetLibraryInfo) -> bool {
    if !containsAMXCode(F) {
        return false;
    }
    let mut C: bool = false;
    let mut LAC: X86LowerAMXCast = X86LowerAMXCast { F };
    C |= LAC.combineAMXcast(TLI);
    C |= LAC.transformAllAMXCast();
    let mut LAT: X86LowerAMXType = X86LowerAMXType { F };
    C |= LAT.visit();
    if TM.getOptLevel() == None {
        if !F.hasFnAttribute(OptimizeNone) {
            let mut VTD: X86VolatileTileData = X86VolatileTileData { F: F };
            C = VTD.volatileTileData() || C;
        }
    }
    return C;
}

fn X86LowerAMXTypePass::run(self, F: *mut Function, FAM: *mut FunctionAnalysisManager) -> PreservedAnalyses {
    let mut TLI: *mut TargetLibraryInfo = FAM;
    let mut Changed: bool = lowerAmxType(F, self.TM, &mut TLI);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = none();
    PA;
    return PA;
}

struct X86LowerAMXTypeLegacyPass {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
}

fn X86LowerAMXTypeLegacyPass::runOnFunction(self, F: *mut Function) -> bool {
    let mut TM: *mut TargetMachine = operator&();
    let mut TLI: *mut TargetLibraryInfo = operator&((F));
    return lowerAmxType(F, TM, TLI);
}

fn X86LowerAMXTypeLegacyPass::getAnalysisUsage(self: *X86LowerAMXTypeLegacyPass, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU;
    AU;
}

fn X86LowerAMXTypeLegacyPass::getPassKind(self: *X86LowerAMXTypeLegacyPass) -> PassKind {
    return self.Kind;
}

fn X86LowerAMXTypeLegacyPass::getPassID(self: *X86LowerAMXTypeLegacyPass) -> AnalysisID {
    return self.PassID;
}

fn X86LowerAMXTypeLegacyPass::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LowerAMXTypeLegacyPass::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LowerAMXTypeLegacyPass::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86LowerAMXTypeLegacyPass::getResolver(self: *X86LowerAMXTypeLegacyPass) -> *mut AnalysisResolver {
    return self.Resolver;
}

const PassName: [30]i8 = "Lower AMX type for load/store";

static mut ID: i8 = 0;

fn createX86LowerAMXTypeLegacyPass() -> *mut FunctionPass {
    return X86LowerAMXTypeLegacyPass {};
}

struct Closure_1 {
    AllocaAddr: *mut *mut AllocaInst,
    Bitcast: *mut *mut BitCastInst,
    I8Ptr: *mut *mut Value,
    Stride: *mut *mut Value,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MemTy: *mut Type) {
        (*self.I8Ptr) = (*self.AllocaAddr);
        (*self.Stride) = (64);
    }

struct Closure_2 {
    Change: *mut bool,
}

unsafe fn Closure_2::call(self: *mut Closure_2, Insts: *mut SmallVectorImpl<Instruction *>, IID: ID) {
        for Inst in Insts {
            for U in Inst.users() {
                let mut II: *mut IntrinsicInst = dyn_cast(U);
                if !II || II.getIntrinsicID() != IID {
                    continue;
                }
                II.replaceAllUsesWith(Inst.getOperand(0));
                (*self.Change) = true;
            }
        }
    }

struct Closure_3 {
    Change: *mut bool,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Insts: *mut SmallVectorImpl<Instruction *>) {
        for Inst in Insts {
            if Inst.use_empty() {
                Inst.eraseFromParent();
                (*self.Change) = true;
            } else {
                LiveCasts()(Inst);
            }
        }
    }

struct Closure_4 {
    AllocaAddr: *mut *mut AllocaInst,
    AMXCast: *mut *mut IntrinsicInst,
    I8Ptr: *mut *mut Value,
    Stride: *mut *mut Value,
}

unsafe fn Closure_4::call(self: *mut Closure_4, MemTy: *mut Type) {
        (*self.I8Ptr) = ((*self.AllocaAddr));
        (*self.Stride) = (64);
    }
