fn isAMXCast(II: *mut Instruction) -> bool {
    return match(II) || match(II);
}

fn isAMXIntrinsic(I: *mut Value) -> bool {
    let mut II: *mut auto = dyn_cast(I);
    if operator!() {
        return false;
    }
    if isAMXCast() {
        return false;
    }
    if II()()() {
        return true;
    }
    return false;
}

fn containsAMXCode(F: *mut Function) -> bool {
    for BB in F {
        for I in BB {
            if I.getType().isX86_AMXTy() {
                return true;
            }
        }
    }
    return false;
}

fn createAllocaInstAtEntry(Builder: *mut i32, BB: *mut BasicBlock, Ty: *mut Type) -> *mut AllocaInst {
    let mut F: *mut Function = *BB.getParent();
    let mut DL: *DataLayout = F.getDataLayout();
    let mut Ctx: *mut LLVMContext = ();
    let mut AllocaAlignment: auto = DL.getPrefTypeAlign(getX86_AMXTy(Ctx));
    let mut AllocaAS: u32 = DL.getAllocaAddrSpace();
    let mut AllocaRes: *mut AllocaInst = AllocaInst { Ty, AllocaAS, "", InsertPosition { InsertAt: F.getEntryBlock().begin() } };
    AllocaRes.setAlignment();
    return AllocaRes;
}

fn getFirstNonAllocaInTheEntryBlock(F: *mut Function) -> *mut Instruction {
    for I in F.getEntryBlock() {
        if !isa(&mut I) {
            return &mut I;
        }
    }
    llvm_unreachable_internal("No terminator in the entry block!", "llvm\\lib\\Target\\X86\\X86LowerAMXType.cpp", 121);
}

fn getRowFromCol(II: *mut Instruction, V: *mut Value, Granularity: u32) -> *mut Value {
    let mut Builder: i32 = II;
    let mut RealRow: *mut Value = null;
    if isa(V) {
        RealRow = ((cast(V)()) / Granularity);
    } else if isa(V) {
        Builder()(cast(V));
        RealRow = (V, (4));
        cast(RealRow)(cast(V));
    } else {
        let mut NewBuilder: i32 = getFirstNonAllocaInTheEntryBlock(*II.getFunction());
        RealRow = (V, (Granularity));
    }
    return RealRow;
}

fn getShape(II: *mut IntrinsicInst, OpNo: u32) -> pair<Value *, Value *> {
    let mut Builder: i32 = II;
    let mut Row: *mut Value = null;
    let mut Col: *mut Value = null;
    match II.getIntrinsicID() {
        _ => {
            llvm_unreachable_internal("Expect amx intrinsics", "llvm\\lib\\Target\\X86\\X86LowerAMXType.cpp", 162);
        },
    }
    return make_pair(Row, Col);
}

fn getShape(Phi: *mut PHINode) -> pair<Value *, Value *> {
    let mut U: *mut Use = operator((Phi.use_begin()));
    let mut OpNo: u32 = U.getOperandNo();
    let mut V: *mut User = U.getUser();
    while V {
        if isAMXCast(dyn_cast(V)) {
            if V.use_empty() {
                break;
            }
            let mut U: *mut Use = operator((V.use_begin()));
            OpNo = U.getOperandNo();
            V = U.getUser();
        } else if isAMXIntrinsic(V) {} else if isa(V) {
            if V.use_empty() {
                break;
            }
            let mut U: *mut Use = operator((V.use_begin()));
            V = U.getUser();
        } else {
            break;
        }
    }
    return make_pair(null, null);
}

