        let mut AllocaAddr: *mut auto = null;
        Builder()(operator&(operator*(next(LD.getIterator()))));
        Builder()(LD);
        Builder()(Cast);
        I8Ptr = ();
        EraseLoad = false;
    } else {
        I8Ptr = (LD.getOperand(0));
    }
    let mut Stride: *mut Value = (Col);
    let mut Args: array<Value *, 4> = zeroed();
    let mut NewInst: *mut Value = ;
    Cast.replaceAllUsesWith(NewInst);
    return EraseLoad;
}

fn X86LowerAMXCast::combineTilezero(self, Cast: *mut IntrinsicInst) -> bool {
    let mut Row: *mut Value = null;
    let mut Col: *mut Value = null;
    let mut U: *mut Use = operator((Cast.use_begin()));
    let mut OpNo: u32 = U.getOperandNo();
    let mut II: *mut auto = cast(U.getUser());
    if operator!(isAMXIntrinsic()) {
        return false;
    }
    let mut Builder: i32 = Cast;
    let mut NewInst: *mut Value = ;
    Cast.replaceAllUsesWith(NewInst);
    return true;
