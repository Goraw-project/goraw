        let mut Row: *mut Value = (0);
        let mut Col: *mut Value = (1);
        let mut Args: array<Value *, 5> = zeroed();
        Builder();
        let mut NewInst: *mut Value = (Bitcast.getType(), AllocaAddr);
        Bitcast.replaceAllUsesWith(NewInst);
    }
    return true;
}

