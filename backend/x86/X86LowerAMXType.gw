    let mut II: *mut auto = cast(Tile);
    let mut Row: *mut Value = (0);
    let mut Col: *mut Value = (1);
    let mut Builder: i32 = ST;
    let mut Stride: *mut Value = (Col);
    let mut I8Ptr: *mut Value = (ST.getOperand(1));
    let mut Args: array<Value *, 5> = zeroed();
    Builder();
    return true;
}

fn X86LowerAMXCast::combineLoadCast(self, Cast: *mut IntrinsicInst, LD: *mut LoadInst) -> bool {
    let mut EraseLoad: bool = true;
    let mut Row: *mut Value = null;
    let mut Col: *mut Value = null;
    let mut U: *mut Use = operator((Cast.use_begin()));
