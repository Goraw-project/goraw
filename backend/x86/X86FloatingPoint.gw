    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86FPStackifierLegacy::getAnalysisUsage(self: *X86FPStackifierLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU.addRequired();
    AU.addPreservedID(MachineLoopInfoID);
    AU.addPreservedID(MachineDominatorsID);
    self.getAnalysisUsage(AU);
}

fn X86FPStackifierLegacy::getRequiredProperties(self: *X86FPStackifierLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

