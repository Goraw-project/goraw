static mut NumFXCH: Statistic = Statistic { "x86-fp-stackifier", "NumFXCH", "Number of fxch instructions inserted" };

static mut NumFP: Statistic = Statistic { "x86-fp-stackifier", "NumFP", "Number of floating point instructions" };

const ScratchFPReg: u32 = 7;

struct FPS {
    TII: *TargetInstrInfo,
    LiveBundles: SmallVector<LiveBundle, 8>,
    Bundles: *mut EdgeBundles,
    MBB: *mut MachineBasicBlock,
    Stack: [8]u32,
    StackTop: u32,
    RegMap: [8]u32,
}

fn FPS::calcLiveInMask(self, MBB: *mut MachineBasicBlock, RemoveFPs: bool) -> u32 {
    let mut Mask: u32 = 0;
    for let mut I: livein_iterator = MBB.livein_begin(); !I == MBB.livein_end();  {
        let mut Reg: MCPhysReg = operator(I).PhysReg.operator unsigned int();
        if Reg >= FP0 && Reg <= FP6 {
            Mask |= 1 << (Reg - FP0);
            if RemoveFPs {
                I = MBB.removeLiveIn(I);
                continue;
            }
        }
        operator(I);
    }
    return Mask;
}

fn FPS::dumpStack(self: *FPS) {
    dbgs() << "Stack contents:";
    for let mut i: u32 = 0; i != self.StackTop; i += 1 {
        dbgs() << " FP" << self.Stack[i];
        assert!(self.RegMap[self.Stack[i]] == i, "Stack[] doesn't match RegMap[]!");
    }
}

fn FPS::getSlot(self: *FPS, RegNo: u32) -> u32 {
    assert!(RegNo < NumFPRegs, "Regno out of range!");
    return self.RegMap[RegNo];
}

fn FPS::isLive(self: *FPS, RegNo: u32) -> bool {
    let mut Slot: u32 = self.getSlot(RegNo);
    return Slot < self.StackTop && self.Stack[Slot] == RegNo;
}

fn FPS::getStackEntry(self: *FPS, STi: u32) -> u32 {
    if STi >= self.StackTop {
        report_fatal_error("Access past stack top!", true);
    }
    return self.Stack[self.StackTop - 1 - STi];
}

fn FPS::getSTReg(self: *FPS, RegNo: u32) -> u32 {
    return self.StackTop - 1 - self.getSlot(RegNo) + ST0;
}

fn FPS::pushReg(self, Reg: u32) {
    assert!(Reg < NumFPRegs, "Register number out of range!");
    if self.StackTop >= 8 {
        report_fatal_error("Stack overflow!", true);
    }
    self.Stack[self.StackTop] = Reg;
    self.RegMap[Reg] = self.StackTop += 1;
}

fn FPS::popReg(self) {
    if self.StackTop == 0 {
        report_fatal_error("Cannot pop empty stack!", true);
    }
    self.RegMap[self.Stack[self.StackTop -= 1]] = ~0;
}

fn FPS::isAtTop(self: *FPS, RegNo: u32) -> bool {
    return self.getSlot(RegNo) == self.StackTop - 1;
}

fn FPS::moveToTop(self, RegNo: u32, I: iterator) {
    let mut dl: DebugLoc = if I == self.MBB.end() { DebugLoc { Loc: null } } else { operator(I).getDebugLoc() };
    if self.isAtTop(RegNo) {
        return;
    }
    let mut STReg: u32 = self.getSTReg(RegNo);
    let mut RegOnTop: u32 = self.getStackEntry(0);
    swap(self.RegMap[RegNo], self.RegMap[RegOnTop]);
    if self.RegMap[RegOnTop] >= self.StackTop {
        report_fatal_error("Access past stack top!", true);
    }
    swap(self.Stack[self.RegMap[RegOnTop]], self.Stack[self.StackTop - 1]);
    BuildMI(*self.MBB, I, MIMetadata { DL: dl, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(XCH_F)).addReg(STReg, RegState {}, 0);
    operator(NumFXCH);
}

fn FPS::duplicateToTop(self, RegNo: u32, AsReg: u32, I: iterator) {
    let mut dl: DebugLoc = if I == self.MBB.end() { DebugLoc { Loc: null } } else { operator(I).getDebugLoc() };
    let mut STReg: u32 = self.getSTReg(RegNo);
    self.pushReg(AsReg);
    BuildMI(*self.MBB, I, MIMetadata { DL: dl, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LD_Frr)).addReg(STReg, RegState {}, 0);
}

fn FPS::isFPCopy(self, MI: *mut MachineInstr) -> bool {
    let mut DstReg: Register = MI.getOperand(0).getReg();
    let mut SrcReg: Register = MI.getOperand(1).getReg();
    return RFP80RegClass.contains(DstReg.operator MCRegister()) || RFP80RegClass.contains(SrcReg.operator MCRegister());
}

