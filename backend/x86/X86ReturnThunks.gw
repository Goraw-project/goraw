const X86ReturnThunksPassName: str = "X86 Return Thunks";

struct X86ReturnThunksLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86ReturnThunksLegacy::getPassName(self: *X86ReturnThunksLegacy) -> str {
    return X86ReturnThunksPassName;
}

fn X86ReturnThunksLegacy::getPassKind(self: *X86ReturnThunksLegacy) -> PassKind {
    return self.Kind;
}

fn X86ReturnThunksLegacy::getPassID(self: *X86ReturnThunksLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86ReturnThunksLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86ReturnThunksLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86ReturnThunksLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86ReturnThunksLegacy::getResolver(self: *X86ReturnThunksLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86ReturnThunksLegacy::getRequiredProperties(self: *X86ReturnThunksLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86ReturnThunksLegacy::getSetProperties(self: *X86ReturnThunksLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86ReturnThunksLegacy::getClearedProperties(self: *X86ReturnThunksLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn runX86ReturnThunks(MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-return-thunks", 1) {
            dbgs() << X86ReturnThunksPassName << "\n";
        }
    }
        if !(false) { break; }
    }
    let mut Modified: bool = false;
    if !MF.getFunction().hasFnAttribute(FnRetThunkExtern) {
        return Modified;
    }
    let mut ThunkName: str = "__x86_return_thunk";
    if MF.getFunction().getName() == ThunkName {
        return Modified;
    }
    let mut ST: *auto = MF;
    let mut Is64Bit: bool = ()();
    let mut RetOpc: u32 = 0;
    let mut Rets: SmallVector<MachineInstr *, 16> = zeroed();
    for MBB in MF {
        for Term in MBB.terminators() {
            if Term.getOpcode() == RetOpc {
                Rets()(&mut Term);
            }
        }
    }
    let mut IndCS: bool = MF.getFunction().getParent().getModuleFlag("indirect_branch_cs_prefix");
    let mut CS: *MCInstrDesc = ();
    let mut JMP: *MCInstrDesc = ();
    return Modified;
}

fn X86ReturnThunksLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return runX86ReturnThunks(MF);
}

fn X86ReturnThunksPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if runX86ReturnThunks(MF) { getMachineFunctionPassPreservedAnalyses() } else { all() };
}

fn createX86ReturnThunksLegacyPass() -> *mut FunctionPass {
    return X86ReturnThunksLegacy {};
}
