}

fn X86SpeculativeLoadHardeningLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut Impl: X86SpeculativeLoadHardeningImpl = X86SpeculativeLoadHardeningImpl {};
    let mut Changed: bool = Impl.run(MF);
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-slh", 1) {
            dbgs() << "Final speculative load hardened function:\n";
            MF.dump();
            dbgs() << "\n";
            MF.verify(self, null, null, true);
        }
    }
        if !(false) { break; }
    }
    return Changed;
}

