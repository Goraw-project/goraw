static mut NumCondBranchesTraced: Statistic = Statistic { "x86-slh", "NumCondBranchesTraced", "Number of conditional branches traced" };

static mut NumBranchesUntraced: Statistic = Statistic { "x86-slh", "NumBranchesUntraced", "Number of branches unable to trace" };

static mut NumAddrRegsHardened: Statistic = Statistic { "x86-slh", "NumAddrRegsHardened", "Number of address mode used registers hardened" };

static mut NumPostLoadRegsHardened: Statistic = Statistic { "x86-slh", "NumPostLoadRegsHardened", "Number of post-load register values hardened" };

static mut NumCallsOrJumpsHardened: Statistic = Statistic { "x86-slh", "NumCallsOrJumpsHardened", "Number of calls or jumps requiring extra hardening" };

static mut NumInstsInserted: Statistic = Statistic { "x86-slh", "NumInstsInserted", "Number of instructions inserted" };

static mut NumLFENCEsInserted: Statistic = Statistic { "x86-slh", "NumLFENCEsInserted", "Number of lfence instructions inserted" };

static mut EnableSpeculativeLoadHardening: opt<bool> = opt<bool> { "x86-speculative-load-hardening", "Force enable speculative load hardening", init(false), Hidden };

static mut HardenEdgesWithLFENCE: opt<bool> = opt<bool> { "x86-slh-lfence", "Use LFENCE along each conditional edge to harden against speculative loads rather than conditional movs and poisoned pointers.", init(false), Hidden };

static mut EnablePostLoadHardening: opt<bool> = opt<bool> { "x86-slh-post-load", "Harden the value loaded *after* it is loaded by flushing the loaded bits to 1. This is hard to do in general but can be done easily for GPRs.", init(true), Hidden };

static mut FenceCallAndRet: opt<bool> = opt<bool> { "x86-slh-fence-call-and-ret", "Use a full speculation fence to harden both call and ret edges rather than a lighter weight mitigation.", init(false), Hidden };

static mut HardenInterprocedurally: opt<bool> = opt<bool> { "x86-slh-ip", "Harden interprocedurally by passing our state in and out of functions in the high bits of the stack pointer.", init(true), Hidden };

static mut HardenLoads: opt<bool> = opt<bool> { "x86-slh-loads", "Sanitize loads from memory. When disable, no significant security is provided.", init(true), Hidden };

static mut HardenIndirectCallsAndJumps: opt<bool> = opt<bool> { "x86-slh-indirect", "Harden indirect calls and jumps against using speculatively stored attacker controlled addresses. This is designed to mitigate Spectre v1.2 style attacks.", init(true), Hidden };

const X86SLHPassName: str = "X86 speculative load hardening";

struct X86SpeculativeLoadHardeningLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86SpeculativeLoadHardeningLegacy::getPassName(self: *X86SpeculativeLoadHardeningLegacy) -> str {
    return X86SLHPassName;
}

fn X86SpeculativeLoadHardeningLegacy::getPassKind(self: *X86SpeculativeLoadHardeningLegacy) -> PassKind {
    return self.Kind;
}

fn X86SpeculativeLoadHardeningLegacy::getPassID(self: *X86SpeculativeLoadHardeningLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86SpeculativeLoadHardeningLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86SpeculativeLoadHardeningLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86SpeculativeLoadHardeningLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86SpeculativeLoadHardeningLegacy::getResolver(self: *X86SpeculativeLoadHardeningLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86SpeculativeLoadHardeningLegacy::getRequiredProperties(self: *X86SpeculativeLoadHardeningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86SpeculativeLoadHardeningLegacy::getSetProperties(self: *X86SpeculativeLoadHardeningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86SpeculativeLoadHardeningLegacy::getClearedProperties(self: *X86SpeculativeLoadHardeningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

struct X86SpeculativeLoadHardeningImpl {
    Subtarget: *X86Subtarget,
    MRI: *mut MachineRegisterInfo,
    TII: *X86InstrInfo,
    TRI: *TargetRegisterInfo,
    PS: optional<PredState>,
}

fn X86SpeculativeLoadHardeningLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut Impl: X86SpeculativeLoadHardeningImpl = X86SpeculativeLoadHardeningImpl {};
    let mut Changed: bool = Impl.run(MF);
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-slh", 1) {
            dbgs() << "Final speculative load hardened function:\n";
            MF.dump();
            dbgs() << "\n";
            MF.verify(self, null, null, true);
        }
    }
        if !(false) { break; }
    }
    return Changed;
}

static mut ID: i8 = 0;

fn X86SpeculativeLoadHardeningLegacy::getAnalysisUsage(self: *X86SpeculativeLoadHardeningLegacy, AU: *mut AnalysisUsage) {
    AU.addPreserved();
    self.getAnalysisUsage(AU);
}

fn splitEdge(MBB: *mut MachineBasicBlock, Succ: *mut MachineBasicBlock, SuccCount: i32, Br: *mut MachineInstr, UncondBr: *mut *mut MachineInstr, TII: *X86InstrInfo) -> *mut MachineBasicBlock {
    assert!(!Succ.isEHPad(), "Shouldn't get edges to EH pads!");
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut NewMBB: *mut MachineBasicBlock = *MF.CreateMachineBasicBlock(null, nullopt);
    MF.insert(next(&mut MBB, 1), &mut NewMBB);
    if Br {
        assert!(Br.getOperand(0).getMBB() == &mut Succ, "Didn't start with the right target!");
        Br.getOperand(0).setMBB(&mut NewMBB);
        if !UncondBr {
            let mut OldLayoutSucc: *mut MachineBasicBlock = operator(next(&mut NewMBB, 1));
            assert!(MBB.isSuccessor(&mut OldLayoutSucc), "Without an unconditional branch, the old layout successor should be an actual successor!");
            let mut BrBuilder: MachineInstrBuilder = BuildMI(&mut MBB, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(JMP_1)).addMBB(&mut OldLayoutSucc, 0);
            UncondBr = &mut *BrBuilder.operator llvm::MachineInstr *();
        }
        if !NewMBB.isLayoutSuccessor(&mut Succ) {
            let mut Cond: SmallVector<MachineOperand, 4> = SmallVector<MachineOperand, 4> {};
            TII.insertBranch(NewMBB, &mut Succ, null, Cond, Br.getDebugLoc(), null);
        }
    } else {
        assert!(!UncondBr, "Cannot have a branchless successor and an unconditional branch!");
        assert!(NewMBB.isLayoutSuccessor(&mut Succ), "A non-branch successor must have been a layout successor before and now is a layout successor of the new block.");
    }
    if SuccCount == 1 {
        MBB.replaceSuccessor(&mut Succ, &mut NewMBB);
    } else {
        MBB.splitSuccessor(&mut Succ, &mut NewMBB, false);
    }
    NewMBB.addSuccessor(&mut Succ, getUnknown());
    for MI in Succ {
        if !MI.isPHI() {
            break;
        }
        for let mut OpIdx: i32 = 1;
let mut NumOps: i32 = MI.getNumOperands(); OpIdx < NumOps; OpIdx += 2 {
            let mut OpV: *mut MachineOperand = MI.getOperand(OpIdx);
            let mut OpMBB: *mut MachineOperand = MI.getOperand(OpIdx + 1);
            assert!(OpMBB.isMBB(), "Block operand to a PHI is not a block!");
            if OpMBB.getMBB() != &mut MBB {
                continue;
            }
            if SuccCount == 1 {
                OpMBB.setMBB(&mut NewMBB);
                break;
            }
            MI.addOperand(MF, OpV);
            MI.addOperand(MF, CreateMBB(&mut NewMBB, 0));
            break;
        }
    }
    for LI in Succ.liveins() {
        NewMBB.addLiveIn(LI);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-slh", 1) {
            dbgs() << "  Split edge from '" << MBB.getName() << "' to '" << Succ.getName() << "'.\n";
        }
    }
        if !(false) { break; }
    }
    return NewMBB;
}

fn canonicalizePHIOperands(MF: *mut MachineFunction) {
    let mut Preds: SmallPtrSet<MachineBasicBlock *, 4> = SmallPtrSet<MachineBasicBlock *, 4> {};
    let mut DupIndices: SmallVector<int, 4> = SmallVector<int, 4> {};
    for MBB in MF {
        for MI in MBB {
            if !MI.isPHI() {
                break;
            }
            for let mut OpIdx: i32 = 1;
let mut NumOps: i32 = MI.getNumOperands(); OpIdx < NumOps; OpIdx += 2 {
                if !Preds.insert(MI.getOperand(OpIdx + 1).getMBB()).second {
                    DupIndices.push(OpIdx);
                }
            }
            while !DupIndices.is_empty() {
                let mut OpIdx: i32 = DupIndices.pop_back_val();
                MI.removeOperand(OpIdx + 1);
                MI.removeOperand(OpIdx);
            }
            Preds.clear();
        }
    }
}

fn hasVulnerableLoad(MF: *mut MachineFunction) -> bool {
    for MBB in MF {
        for MI in MBB {
            if MI.getOpcode() == LFENCE {
                break;
            }
            if !MI.mayLoad(AnyInBundle) {
                continue;
            }
            if MI.getOpcode() == MFENCE {
                continue;
            }
            return true;
        }
    }
    return false;
}

fn X86SpeculativeLoadHardeningImpl::run(self, MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-slh", 1) {
            dbgs() << "********** " << X86SLHPassName << " : " << MF.getName() << " **********\n";
        }
    }
        if !(false) { break; }
    }
    if !EnableSpeculativeLoadHardening && !MF.getFunction().hasFnAttribute(SpeculativeLoadHardening) {
        return false;
    }
    self.Subtarget = &mut MF.getSubtarget();
    self.MRI = &mut MF.getRegInfo();
    self.TII = self.Subtarget.getInstrInfo();
    self.TRI = self.Subtarget.getRegisterInfo();
    self.PS.emplace(MF, &mut GR64_NOSPRegClass);
    if MF.begin() == MF.end() {
        return false;
    }
    if HardenEdgesWithLFENCE {
        self.hardenEdgesWithLFENCE(MF);
        return true;
    }
    let mut Loc: DebugLoc = null;
    let mut Entry: *mut MachineBasicBlock = operator(MF.begin());
    let mut EntryInsertPt: iterator = Entry.SkipPHIsLabelsAndDebug(Entry.begin(), Register { Reg: 0 }, true);
    let mut HasVulnerableLoad: bool = hasVulnerableLoad(MF);
    let mut Infos: SmallVector<BlockCondInfo, 16> = self.collectBlockCondInfo(MF);
    if !HasVulnerableLoad && Infos.is_empty() {
        return true;
    }
    let mut PoisonVal: i32 = -1;
    operator(self.PS).PoisonReg = self.MRI.createVirtualRegister(operator(self.PS).RC, "");
    BuildMI(Entry, EntryInsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MOV64ri32), operator(self.PS).PoisonReg).addImm(PoisonVal);
    operator(NumInstsInserted);
    if HasVulnerableLoad && FenceCallAndRet {
        BuildMI(Entry, EntryInsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LFENCE));
        operator(NumInstsInserted);
        operator(NumLFENCEsInserted);
    }
    if FenceCallAndRet && Infos.is_empty() {
        return true;
    }
    if HardenInterprocedurally && !FenceCallAndRet {
        operator(self.PS).InitialReg = self.extractPredStateFromSP(Entry, EntryInsertPt, Loc);
    } else {
        operator(self.PS).InitialReg = self.MRI.createVirtualRegister(operator(self.PS).RC, "");
        let mut PredStateSubReg: Register = self.MRI.createVirtualRegister(&mut GR32RegClass, "");
        let mut ZeroI: MachineInstrBuilder = BuildMI(Entry, EntryInsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MOV32r0), PredStateSubReg);
        operator(NumInstsInserted);
        let mut ZeroEFLAGSDefOp: *mut MachineOperand = operator(ZeroI).findRegisterDefOperand(EFLAGS, null, false, false);
        assert!(ZeroEFLAGSDefOp && ZeroEFLAGSDefOp.isImplicit(), "Must have an implicit def of EFLAGS!");
        ZeroEFLAGSDefOp.setIsDead(true);
        BuildMI(Entry, EntryInsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SUBREG_TO_REG), operator(self.PS).InitialReg).addReg(PredStateSubReg, RegState {}, 0).addImm(sub_32bit);
    }
    canonicalizePHIOperands(MF);
    operator(self.PS).SSA.Initialize(operator(self.PS).InitialReg);
    operator(self.PS).SSA.AddAvailableValue(&mut Entry, operator(self.PS).InitialReg);
    let mut CMovs: SmallVector<MachineInstr *, 16> = self.tracePredStateThroughCFG(MF, Infos);
    if HardenInterprocedurally {
        for MBB in MF {
            assert!(!MBB.isEHScopeEntry(), "Only Itanium ABI EH supported!");
            assert!(!MBB.isEHFuncletEntry(), "Only Itanium ABI EH supported!");
            assert!(!MBB.isCleanupFuncletEntry(), "Only Itanium ABI EH supported!");
            if !MBB.isEHPad() {
                continue;
            }
            operator(self.PS).SSA.AddAvailableValue(&mut MBB, self.extractPredStateFromSP(MBB, MBB.SkipPHIsAndLabels(MBB.begin()), Loc));
        }
    }
    if HardenIndirectCallsAndJumps {
        self.unfoldCallAndJumpLoads(MF);
        let mut IndirectBrCMovs: SmallVector<MachineInstr *, 16> = self.tracePredStateThroughIndirectBranches(MF);
        CMovs.append(IndirectBrCMovs.begin(), IndirectBrCMovs.end());
    }
    self.tracePredStateThroughBlocksAndHarden(MF);
    for CMovI in CMovs {
        for Op in CMovI.operands() {
            if !Op.isReg() || Op.getReg() != operator(self.PS).InitialReg {
                continue;
            }
            operator(self.PS).SSA.RewriteUse(Op);
        }
    }
    return true;
}

fn X86SpeculativeLoadHardeningImpl::hardenEdgesWithLFENCE(self, MF: *mut MachineFunction) {
    let mut Blocks: SmallSetVector<MachineBasicBlock *, 8> = SmallSetVector<MachineBasicBlock *, 8> {};
    for MBB in MF {
        if MBB.succ_size() <= 1 {
            continue;
        }
        let mut TermIt: iterator = MBB.getFirstTerminator();
        if TermIt == MBB.end() || !operator(TermIt).isBranch(AnyInBundle) {
            continue;
        }
        for SuccMBB in MBB.successors() {
            if !SuccMBB.isEHPad() {
                Blocks.insert(SuccMBB);
            }
        }
    }
    for MBB in Blocks {
        let mut InsertPt: iterator = MBB.SkipPHIsAndLabels(MBB.begin());
        BuildMI(*MBB, InsertPt, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LFENCE));
        operator(NumInstsInserted);
        operator(NumLFENCEsInserted);
    }
}

fn X86SpeculativeLoadHardeningImpl::collectBlockCondInfo(self, MF: *mut MachineFunction) -> BlockCondInfo, 16> {
    let mut Infos: SmallVector<BlockCondInfo, 16> = SmallVector<BlockCondInfo, 16> {};
    for MBB in MF {
        if MBB.succ_size() <= 1 {
            continue;
        }
        let mut Info: BlockCondInfo = BlockCondInfo { &mut MBB, SmallVector<MachineInstr *, 2> {}, null };
        for MI in reverse(MBB) {
            if !MI.isTerminator(AnyInBundle) {
                break;
            }
            if !MI.isBranch(AnyInBundle) {
                Info.CondBrs.clear();
                break;
            }
            if MI.getOpcode() == JMP_1 {
                Info.CondBrs.clear();
                Info.UncondBr = &mut MI;
                continue;
            }
            if getCondFromBranch(MI) == COND_INVALID {
                Info.CondBrs.clear();
                Info.UncondBr = &mut MI;
                continue;
            }
            Info.CondBrs.push(&mut MI);
        }
        if Info.CondBrs.is_empty() {
            operator(NumBranchesUntraced);
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    dbgs() << "WARNING: unable to secure successors of block:\n";
                    MBB.dump();
                }
            }
                if !(false) { break; }
            }
            continue;
        }
        Infos.push(Info);
    }
    return Infos;
}

fn X86SpeculativeLoadHardeningImpl::tracePredStateThroughCFG(self, MF: *mut MachineFunction, Infos: ArrayRef<BlockCondInfo>) -> SmallVector<MachineInstr *, 16> {
    let mut CMovs: SmallVector<MachineInstr *, 16> = SmallVector<MachineInstr *, 16> {};
    for Info in Infos {
        let mut MBB: *mut MachineBasicBlock = *Info.MBB;
        let mut CondBrs: *SmallVectorImpl<MachineInstr *> = Info.CondBrs;
        let mut UncondBr: *mut MachineInstr = Info.UncondBr;
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                dbgs() << "Tracing predicate through block: " << MBB.getName() << "\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumCondBranchesTraced);
        let mut UncondSucc: *mut MachineBasicBlock = if UncondBr { (if UncondBr.getOpcode() == JMP_1 { UncondBr.getOperand(0).getMBB() } else { null }) } else { &mut operator(next(&mut MBB, 1)) };
        let mut SuccCounts: SmallDenseMap<MachineBasicBlock *, int> = SmallDenseMap<MachineBasicBlock *, int> {};
        if UncondSucc {
            SuccCounts[UncondSucc] += 1;
        }
        for CondBr in CondBrs {
            SuccCounts[CondBr.getOperand(0).getMBB()] += 1;
        }
        let mut BuildCheckingBlockForSuccAndConds: Closure_1 = Closure_1 { cap_0: self, CMovs: &mut CMovs };
        let mut UncondCodeSeq: []CondCode = []CondCode {};
        for CondBr in CondBrs {
            let mut Succ: *mut MachineBasicBlock = *CondBr.getOperand(0).getMBB();
            let mut SuccCount: *mut i32 = SuccCounts[&mut Succ];
            let mut Cond: CondCode = getCondFromBranch(*CondBr);
            let mut InvCond: CondCode = GetOppositeBranchCondition(Cond);
            UncondCodeSeq.push(Cond);
            BuildCheckingBlockForSuccAndConds.call(MBB, Succ, SuccCount, CondBr, UncondBr, [InvCond]);
            SuccCount -= 1;
        }
        MBB.normalizeSuccProbs();
        if !UncondSucc {
            continue;
        }
        assert!(SuccCounts[UncondSucc] == 1, "We should never have more than one edge to the unconditional successor at this point because every other edge must have been split above!");
        sort(UncondCodeSeq);
        UncondCodeSeq.erase(unique(UncondCodeSeq), UncondCodeSeq.end());
        BuildCheckingBlockForSuccAndConds.call(MBB, *UncondSucc, 1, UncondBr, UncondBr, UncondCodeSeq);
    }
    return CMovs;
}

fn getRegClassForUnfoldedLoad(TII: *X86InstrInfo, Opcode: u32) -> *TargetRegisterClass {
    let mut Index: u32 = 0;
    let mut UnfoldedOpc: u32 = TII.getOpcodeAfterMemoryUnfold(Opcode, true, false, &mut Index);
    let mut MCID: *MCInstrDesc = TII.get(UnfoldedOpc);
    return TII.getRegClass(MCID, Index);
}

fn X86SpeculativeLoadHardeningImpl::unfoldCallAndJumpLoads(self, MF: *mut MachineFunction) {
    for MBB in MF {
        for MI in make_early_inc_range(MBB.instrs()) {
            if !MI.isCall(AnyInBundle) && !MI.isBranch(AnyInBundle) {
                continue;
            }
            if !MI.mayLoad(AnyInBundle) {
                continue;
            }
            match MI.getOpcode() {
                _ => {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                            dbgs() << "ERROR: Found an unexpected loading branch or call instruction:\n";
                            MI.dump();
                            dbgs() << "\n";
                        }
                    }
                        if !(false) { break; }
                    }
                    report_fatal_error("Unexpected loading branch or call!", true);
                },
                FARCALL16m => {
                    FARCALL32m;
                },
                CALL16m => {
                    CALL16m_NT;
                },
            }
            llvm_unreachable_internal("Escaped switch with default!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86SpeculativeLoadHardening.cpp", 948);
        }
    }
}

fn X86SpeculativeLoadHardeningImpl::tracePredStateThroughIndirectBranches(self, MF: *mut MachineFunction) -> SmallVector<MachineInstr *, 16> {
    let mut TargetAddrSSA: MachineSSAUpdater = MachineSSAUpdater { MF, null };
    TargetAddrSSA.Initialize(self.MRI.createVirtualRegister(&mut GR64RegClass, ""));
    let mut IndirectTerminatedMBBs: SmallPtrSet<MachineBasicBlock *, 4> = SmallPtrSet<MachineBasicBlock *, 4> {};
    let mut IndirectTargetMBBs: SmallPtrSet<MachineBasicBlock *, 4> = SmallPtrSet<MachineBasicBlock *, 4> {};
    for MBB in MF {
        let mut MII: reverse_instr_iterator = MBB.instr_rbegin();
        while MII != MBB.instr_rend() && operator(MII).isDebugInstr() {
            operator(MII);
        }
        if MII == MBB.instr_rend() {
            continue;
        }
        let mut TI: *mut MachineInstr = operator(MII);
        if !TI.isTerminator(AnyInBundle) || !TI.isBranch(AnyInBundle) {
            continue;
        }
        let mut TargetReg: Register = 0;
        match TI.getOpcode() {
            _ => {
                continue;
            },
            FARJMP16m => {
                FARJMP32m;
            },
            JMP16m => {
                JMP16m_NT;
            },
            JMP16r => {
                report_fatal_error("Support for 16-bit indirect branches is not implemented.", true);
            },
            JMP32r => {
                report_fatal_error("Support for 32-bit indirect branches is not implemented.", true);
            },
            JMP64r => {
                TargetReg = TI.getOperand(0).getReg();
            },
        }
        if any_of(MBB.terminators(), Closure_2 { TI: &mut TI }) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    {
                        dbgs() << "ERROR: Found other terminators in a block with an indirect branch! This is not yet supported! Terminator sequence:\n";
                        for MI in MBB.terminators() {
                            MI.dump();
                            dbgs() << 10;
                        }
                    }
                }
            }
                if !(false) { break; }
            }
            report_fatal_error("Unimplemented terminator sequence!", true);
        }
        TargetAddrSSA.AddAvailableValue(&mut MBB, TargetReg);
        IndirectTerminatedMBBs.insert(&mut MBB);
        IndirectTargetMBBs.insert_range(MBB.successors());
    }
    let mut CMovs: SmallVector<MachineInstr *, 16> = SmallVector<MachineInstr *, 16> {};
    if IndirectTargetMBBs.is_empty() {
        return CMovs;
    }
    for MBB in MF {
        if !IndirectTargetMBBs.count(&mut MBB) {
            continue;
        }
        assert!(!MBB.isEHPad(), "Unexpected EH pad as target of an indirect branch!");
        assert!(!MBB.isLiveIn(EFLAGS, getAll()), "Cannot check within a block that already has live-in EFLAGS!");
        for Pred in MBB.predecessors() {
            if IndirectTerminatedMBBs.count(Pred) {
                continue;
            }
            if !all_of(Pred.successors(), Closure_3 { MBB: &mut MBB }) {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                        {
                            dbgs() << "ERROR: Found conditional entry to target of indirect branch!\n";
                            Pred.dump();
                            MBB.dump();
                        }
                    }
                }
                    if !(false) { break; }
                }
                report_fatal_error("Cannot harden a conditional entry to a target of an indirect branch!", true);
            }
            let mut InsertPt: iterator = Pred.getFirstTerminator();
            let mut TargetReg: Register = self.MRI.createVirtualRegister(&mut GR64RegClass, "");
            if MF.getTarget().getCodeModel() == Small && !self.Subtarget.isPositionIndependent() {
                let mut AddrI: MachineInstrBuilder = BuildMI(*Pred, InsertPt, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MOV64ri32), TargetReg).addMBB(&mut MBB, 0);
                operator(NumInstsInserted);
                AddrI as void;
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                        dbgs() << "  Inserting mov: ";
                        operator(AddrI).dump();
                        dbgs() << "\n";
                    }
                }
                    if !(false) { break; }
                }
            } else {
                let mut AddrI: MachineInstrBuilder = BuildMI(*Pred, InsertPt, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LEA64r), TargetReg).addReg(RIP, RegState {}, 0).addImm(1).addReg(0, RegState {}, 0).addMBB(&mut MBB, 0).addReg(0, RegState {}, 0);
                operator(NumInstsInserted);
                AddrI as void;
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                        dbgs() << "  Inserting lea: ";
                        operator(AddrI).dump();
                        dbgs() << "\n";
                    }
                }
                    if !(false) { break; }
                }
            }
            TargetAddrSSA.AddAvailableValue(Pred, TargetReg);
        }
        let mut TargetReg: Register = TargetAddrSSA.GetValueInMiddleOfBlock(&mut MBB, false);
        MBB.setMachineBlockAddressTaken();
        let mut InsertPt: iterator = MBB.SkipPHIsLabelsAndDebug(MBB.begin(), Register { Reg: 0 }, true);
        if MF.getTarget().getCodeModel() == Small && !self.Subtarget.isPositionIndependent() {
            let mut CheckI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CMP64ri32)).addReg(TargetReg, Kill, 0).addMBB(&mut MBB, 0);
            operator(NumInstsInserted);
            CheckI as void;
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    dbgs() << "  Inserting cmp: ";
                    operator(CheckI).dump();
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
        } else {
            let mut AddrReg: Register = self.MRI.createVirtualRegister(&mut GR64RegClass, "");
            let mut AddrI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LEA64r), AddrReg).addReg(RIP, RegState {}, 0).addImm(1).addReg(0, RegState {}, 0).addMBB(&mut MBB, 0).addReg(0, RegState {}, 0);
            operator(NumInstsInserted);
            AddrI as void;
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    dbgs() << "  Inserting lea: ";
                    operator(AddrI).dump();
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
            let mut CheckI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CMP64rr)).addReg(TargetReg, Kill, 0).addReg(AddrReg, Kill, 0);
            operator(NumInstsInserted);
            CheckI as void;
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    dbgs() << "  Inserting cmp: ";
                    operator(CheckI).dump();
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
        }
        let mut PredStateSizeInBytes: i32 = self.TRI.getRegSizeInBits(*operator(self.PS).RC).operator unsigned long long() / 8;
        let mut CMovOp: u32 = getCMovOpcode(PredStateSizeInBytes, false, false);
        let mut UpdatedStateReg: Register = self.MRI.createVirtualRegister(operator(self.PS).RC, "");
        let mut CMovI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CMovOp), UpdatedStateReg).addReg(operator(self.PS).InitialReg, RegState {}, 0).addReg(operator(self.PS).PoisonReg, RegState {}, 0).addImm(COND_NE);
        operator(CMovI).findRegisterUseOperand(EFLAGS, null, false).setIsKill(true);
        operator(NumInstsInserted);
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                dbgs() << "  Inserting cmov: ";
                operator(CMovI).dump();
                dbgs() << "\n";
            }
        }
            if !(false) { break; }
        }
        CMovs.push(&mut *CMovI.operator llvm::MachineInstr *());
        operator(self.PS).SSA.AddAvailableValue(&mut MBB, UpdatedStateReg);
    }
    return CMovs;
}

fn isEFLAGSDefLive(MI: *MachineInstr) -> bool {
    if MI.findRegisterDefOperand(EFLAGS, null, false, false) {
        DefOp;
    } else {
        return !DefOp.isDead();
    }
    return false;
}

fn isEFLAGSLive(MBB: *mut MachineBasicBlock, I: iterator, TRI: *TargetRegisterInfo) -> bool {
    for MI in reverse(make_range(MBB.begin(), I)) {
        if MI.findRegisterDefOperand(EFLAGS, null, false, false) {
            DefOp;
        } else {
            if DefOp.isDead() {
                return false;
            }
            return true;
        }
        if MI.killsRegister(EFLAGS, &mut TRI) {
            return false;
        }
    }
    return MBB.isLiveIn(EFLAGS, getAll());
}

fn X86SpeculativeLoadHardeningImpl::tracePredStateThroughBlocksAndHarden(self, MF: *mut MachineFunction) {
    let mut HardenPostLoad: SmallPtrSet<MachineInstr *, 16> = SmallPtrSet<MachineInstr *, 16> {};
    let mut HardenLoadAddr: SmallPtrSet<MachineInstr *, 16> = SmallPtrSet<MachineInstr *, 16> {};
    let mut HardenedAddrRegs: SmallSet<Register, 16> = SmallSet<Register, 16> {};
    let mut AddrRegToHardenedReg: SmallDenseMap<Register, Register, 32> = SmallDenseMap<Register, Register, 32> {};
    let mut LoadDepRegs: SparseBitVector<> = SparseBitVector<> {};
    for MBB in MF {
        if HardenLoads {
            for MI in MBB {
                if any_of(MI.uses(), Closure_4 { LoadDepRegs: &mut LoadDepRegs }) {
                    for Def in MI.defs() {
                        if Def.isReg() {
                            LoadDepRegs.set(Def.getReg().id());
                        }
                    }
                }
                if MI.getOpcode() == LFENCE {
                    break;
                }
                if !MI.mayLoad(AnyInBundle) {
                    continue;
                }
                if MI.getOpcode() == MFENCE {
                    continue;
                }
                let mut MemRefBeginIdx: i32 = getFirstAddrOperandIdx(MI);
                if MemRefBeginIdx < 0 {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                            dbgs() << "WARNING: unable to harden loading instruction: ";
                            MI.dump();
                        }
                    }
                        if !(false) { break; }
                    }
                    continue;
                }
                let mut BaseMO: *mut MachineOperand = MI.getOperand(MemRefBeginIdx + AddrBaseReg);
                let mut IndexMO: *mut MachineOperand = MI.getOperand(MemRefBeginIdx + AddrIndexReg);
                let mut BaseReg: Register = 0;
                let mut IndexReg: Register = 0;
                if !BaseMO.isFI() && BaseMO.getReg() != RIP && BaseMO.getReg().isValid() {
                    BaseReg = BaseMO.getReg();
                }
                if IndexMO.getReg().isValid() {
                    IndexReg = IndexMO.getReg();
                }
                if !BaseReg.operator unsigned int() && !IndexReg.operator unsigned int() {
                    continue;
                }
                if (BaseReg.operator unsigned int() && LoadDepRegs.test(BaseReg.id())) || (IndexReg.operator unsigned int() && LoadDepRegs.test(IndexReg.id())) {
                    continue;
                }
                if EnablePostLoadHardening && isDataInvariantLoad(MI) && !isEFLAGSDefLive(MI) && MI.getDesc().getNumDefs() == 1 && MI.getOperand(0).isReg() && self.canHardenRegister(MI.getOperand(0).getReg()) && !HardenedAddrRegs.count(BaseReg) && !HardenedAddrRegs.count(IndexReg) {
                    HardenPostLoad.insert(&mut MI);
                    HardenedAddrRegs.insert(MI.getOperand(0).getReg());
                    continue;
                }
                HardenLoadAddr.insert(&mut MI);
                if BaseReg.operator unsigned int() {
                    HardenedAddrRegs.insert(BaseReg);
                }
                if IndexReg.operator unsigned int() {
                    HardenedAddrRegs.insert(IndexReg);
                }
                for Def in MI.defs() {
                    if Def.isReg() {
                        LoadDepRegs.set(Def.getReg().id());
                    }
                }
            }
        }
        for MI in MBB {
            if HardenLoads {
                assert!(!(HardenLoadAddr.count(&mut MI) && HardenPostLoad.count(&mut MI)), "Requested to harden both the address and def of a load!");
                if HardenLoadAddr.erase(&mut MI) {
                    let mut MemRefBeginIdx: i32 = getFirstAddrOperandIdx(MI);
                    assert!(MemRefBeginIdx >= 0, "Cannot have an invalid index here!");
                    let mut BaseMO: *mut MachineOperand = MI.getOperand(MemRefBeginIdx + AddrBaseReg);
                    let mut IndexMO: *mut MachineOperand = MI.getOperand(MemRefBeginIdx + AddrIndexReg);
                    self.hardenLoadAddr(MI, BaseMO, IndexMO, AddrRegToHardenedReg);
                    continue;
                }
                if HardenPostLoad.erase(&mut MI) {
                    assert!(!MI.isCall(AnyInBundle), "Must not try to post-load harden a call!");
                    if isDataInvariantLoad(MI) && !isEFLAGSDefLive(MI) {
                        let mut SunkMI: *mut MachineInstr = self.sinkPostLoadHardenedInst(MI, HardenPostLoad);
                        if SunkMI != &mut MI {
                            if !SunkMI {
                                continue;
                            }
                            HardenPostLoad.insert(SunkMI);
                            continue;
                        }
                    }
                    let mut HardenedReg: Register = self.hardenPostLoad(MI);
                    AddrRegToHardenedReg[HardenedReg] = HardenedReg;
                    continue;
                }
                if (MI.isCall(AnyInBundle) || MI.isBranch(AnyInBundle)) && HardenIndirectCallsAndJumps {
                    self.hardenIndirectCallOrJumpInstr(MI, AddrRegToHardenedReg);
                }
            }
            if !HardenInterprocedurally {
                continue;
            }
            if !MI.isCall(AnyInBundle) && !MI.isReturn(AnyInBundle) {
                continue;
            }
            if MI.isReturn(AnyInBundle) && !MI.isCall(AnyInBundle) {
                self.hardenReturnInstr(MI);
                continue;
            }
            assert!(MI.isCall(AnyInBundle), "Should only reach here for calls!");
            self.tracePredStateThroughCall(MI);
        }
        HardenPostLoad.clear();
        HardenLoadAddr.clear();
        HardenedAddrRegs.clear();
        AddrRegToHardenedReg.clear();
        LoadDepRegs.clear();
    }
}

fn X86SpeculativeLoadHardeningImpl::saveEFLAGS(self, MBB: *mut MachineBasicBlock, InsertPt: iterator, Loc: *DebugLoc) -> Register {
    let mut Reg: Register = self.MRI.createVirtualRegister(&mut GR32RegClass, "");
    BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(COPY), Reg).addReg(EFLAGS, RegState {}, 0);
    operator(NumInstsInserted);
    return Reg;
}

fn X86SpeculativeLoadHardeningImpl::restoreEFLAGS(self, MBB: *mut MachineBasicBlock, InsertPt: iterator, Loc: *DebugLoc, Reg: Register) {
    BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(COPY), EFLAGS).addReg(Reg, RegState {}, 0);
    operator(NumInstsInserted);
}

fn X86SpeculativeLoadHardeningImpl::mergePredStateIntoSP(self, MBB: *mut MachineBasicBlock, InsertPt: iterator, Loc: *DebugLoc, PredStateReg: Register) {
    let mut TmpReg: Register = self.MRI.createVirtualRegister(operator(self.PS).RC, "");
    let mut ShiftI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SHL64ri), TmpReg).addReg(PredStateReg, Kill, 0).addImm(47);
    operator(ShiftI).addRegisterDead(EFLAGS, self.TRI, false);
    operator(NumInstsInserted);
    let mut OrI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(OR64rr), RSP).addReg(RSP, RegState {}, 0).addReg(TmpReg, Kill, 0);
    operator(OrI).addRegisterDead(EFLAGS, self.TRI, false);
    operator(NumInstsInserted);
}

fn X86SpeculativeLoadHardeningImpl::extractPredStateFromSP(self, MBB: *mut MachineBasicBlock, InsertPt: iterator, Loc: *DebugLoc) -> Register {
    let mut PredStateReg: Register = self.MRI.createVirtualRegister(operator(self.PS).RC, "");
    let mut TmpReg: Register = self.MRI.createVirtualRegister(operator(self.PS).RC, "");
    BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(COPY), TmpReg).addReg(RSP, RegState {}, 0);
    let mut ShiftI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SAR64ri), PredStateReg).addReg(TmpReg, Kill, 0).addImm(self.TRI.getRegSizeInBits(*operator(self.PS).RC).operator unsigned long long() - 1);
    operator(ShiftI).addRegisterDead(EFLAGS, self.TRI, false);
    operator(NumInstsInserted);
    return PredStateReg;
}

fn X86SpeculativeLoadHardeningImpl::hardenLoadAddr(self, MI: *mut MachineInstr, BaseMO: *mut MachineOperand, IndexMO: *mut MachineOperand, AddrRegToHardenedReg: *mut SmallDenseMap<Register, Register, 32>) {
    let mut MBB: *mut MachineBasicBlock = *MI.getParent();
    let mut Loc: *DebugLoc = MI.getDebugLoc();
    let mut EFLAGSLive: bool = isEFLAGSLive(MBB, MI.getIterator(), *self.TRI);
    let mut HardenOpRegs: SmallVector<MachineOperand *, 2> = SmallVector<MachineOperand *, 2> {};
    if BaseMO.isFI() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                dbgs() << "  Skipping hardening base of explicit stack frame load: ";
                MI.dump();
                dbgs() << "\n";
            }
        }
            if !(false) { break; }
        }
    } else if BaseMO.getReg() == RSP {
        assert!(IndexMO.getReg() == NoRegister, "Explicit RSP access with dynamic index!");
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                dbgs() << "  Cannot harden base of explicit RSP offset in a load!";
            }
        }
            if !(false) { break; }
        }
    } else if BaseMO.getReg() == RIP || BaseMO.getReg() == NoRegister {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                dbgs() << "  Cannot harden base of " << (if BaseMO.getReg() == RIP { "RIP-relative" } else { "no-base" }) << " address in a load!";
            }
        }
            if !(false) { break; }
        }
    } else {
        assert!(BaseMO.isReg(), "Only allowed to have a frame index or register base.");
        HardenOpRegs.push(&mut BaseMO);
    }
    if IndexMO.getReg() != NoRegister && (HardenOpRegs.is_empty() || HardenOpRegs.front().getReg() != IndexMO.getReg()) {
        HardenOpRegs.push(&mut IndexMO);
    }
    assert!((HardenOpRegs.len == 1 || HardenOpRegs.len == 2), "Should have exactly one or two registers to harden!");
    assert!((HardenOpRegs.len == 1 || HardenOpRegs[0].getReg() != HardenOpRegs[1].getReg()), "Should not have two of the same registers!");
    erase_if(HardenOpRegs, Closure_5 { AddrRegToHardenedReg: &mut AddrRegToHardenedReg });
    if HardenOpRegs.is_empty() {
        return;
    }
    let mut StateReg: Register = operator(self.PS).SSA.GetValueAtEndOfBlock(&mut MBB);
    let mut InsertPt: self_iterator = MI.getIterator();
    let mut FlagsReg: Register = 0;
    if EFLAGSLive && !self.Subtarget.hasBMI2() {
        EFLAGSLive = false;
        FlagsReg = self.saveEFLAGS(MBB, InsertPt, Loc);
    }
    for Op in HardenOpRegs {
        let mut OpReg: Register = Op.getReg();
        let mut OpRC: *TargetRegisterClass = self.MRI.getRegClass(OpReg);
        let mut TmpReg: Register = self.MRI.createVirtualRegister(OpRC, "");
        if !self.Subtarget.hasVLX() && (OpRC.hasSuperClassEq(&mut VR128RegClass) || OpRC.hasSuperClassEq(&mut VR256RegClass)) {
            assert!(self.Subtarget.hasAVX2(), "AVX2-specific register classes!");
            let mut Is128Bit: bool = OpRC.hasSuperClassEq(&mut VR128RegClass);
            let mut VStateReg: Register = self.MRI.createVirtualRegister(&mut VR128RegClass, "");
            let mut MovI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(VMOV64toPQIrr), VStateReg).addReg(StateReg, RegState {}, 0);
            MovI as void;
            operator(NumInstsInserted);
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    dbgs() << "  Inserting mov: ";
                    operator(MovI).dump();
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
            let mut VBStateReg: Register = self.MRI.createVirtualRegister(OpRC, "");
            let mut BroadcastI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if Is128Bit { VPBROADCASTQrr } else { VPBROADCASTQYrr }), VBStateReg).addReg(VStateReg, RegState {}, 0);
            BroadcastI as void;
            operator(NumInstsInserted);
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    dbgs() << "  Inserting broadcast: ";
                    operator(BroadcastI).dump();
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
            let mut OrI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if Is128Bit { VPORrr } else { VPORYrr }), TmpReg).addReg(VBStateReg, RegState {}, 0).addReg(OpReg, RegState {}, 0);
            OrI as void;
            operator(NumInstsInserted);
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    dbgs() << "  Inserting or: ";
                    operator(OrI).dump();
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
        } else if OpRC.hasSuperClassEq(&mut VR128XRegClass) || OpRC.hasSuperClassEq(&mut VR256XRegClass) || OpRC.hasSuperClassEq(&mut VR512RegClass) {
            assert!(self.Subtarget.hasAVX512(), "AVX512-specific register classes!");
            let mut Is128Bit: bool = OpRC.hasSuperClassEq(&mut VR128XRegClass);
            let mut Is256Bit: bool = OpRC.hasSuperClassEq(&mut VR256XRegClass);
            if Is128Bit || Is256Bit {
                assert!(self.Subtarget.hasVLX(), "AVX512VL-specific register classes!");
            }
            let mut VStateReg: Register = self.MRI.createVirtualRegister(OpRC, "");
            let mut BroadcastOp: u32 = if Is128Bit { VPBROADCASTQrZ128rr } else { if Is256Bit { VPBROADCASTQrZ256rr } else { VPBROADCASTQrZrr } };
            let mut BroadcastI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(BroadcastOp), VStateReg).addReg(StateReg, RegState {}, 0);
            BroadcastI as void;
            operator(NumInstsInserted);
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    dbgs() << "  Inserting broadcast: ";
                    operator(BroadcastI).dump();
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
            let mut OrOp: u32 = if Is128Bit { VPORQZ128rr } else { if Is256Bit { VPORQZ256rr } else { VPORQZrr } };
            let mut OrI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(OrOp), TmpReg).addReg(VStateReg, RegState {}, 0).addReg(OpReg, RegState {}, 0);
            OrI as void;
            operator(NumInstsInserted);
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                    dbgs() << "  Inserting or: ";
                    operator(OrI).dump();
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
        } else {
            assert!(OpRC.hasSuperClassEq(&mut GR64RegClass), "Not a supported register class for address hardening!");
            if !EFLAGSLive {
                let mut OrI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(OR64rr), TmpReg).addReg(StateReg, RegState {}, 0).addReg(OpReg, RegState {}, 0);
                operator(OrI).addRegisterDead(EFLAGS, self.TRI, false);
                operator(NumInstsInserted);
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                        dbgs() << "  Inserting or: ";
                        operator(OrI).dump();
                        dbgs() << "\n";
                    }
                }
                    if !(false) { break; }
                }
            } else {
                let mut ShiftI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SHRX64rr), TmpReg).addReg(OpReg, RegState {}, 0).addReg(StateReg, RegState {}, 0);
                ShiftI as void;
                operator(NumInstsInserted);
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                        dbgs() << "  Inserting shrx: ";
                        operator(ShiftI).dump();
                        dbgs() << "\n";
                    }
                }
                    if !(false) { break; }
                }
            }
        }
        assert!(!AddrRegToHardenedReg.count(Op.getReg()), "Should not have checked this register yet!");
        AddrRegToHardenedReg[Op.getReg()] = TmpReg;
        Op.setReg(TmpReg);
        operator(NumAddrRegsHardened);
    }
    if FlagsReg.operator unsigned int() {
        self.restoreEFLAGS(MBB, InsertPt, Loc, FlagsReg);
    }
}

fn X86SpeculativeLoadHardeningImpl::sinkPostLoadHardenedInst(self, InitialMI: *mut MachineInstr, HardenedInstrs: *mut SmallPtrSetImpl<MachineInstr *>) -> *mut MachineInstr {
    assert!(isDataInvariantLoad(InitialMI), "Cannot get here with a non-invariant load!");
    assert!(!isEFLAGSDefLive(InitialMI), "Cannot get here with a data invariant load that interferes with EFLAGS!");
    let mut SinkCheckToSingleUse: Closure_6 = Closure_6 { cap_0: self, HardenedInstrs: &mut HardenedInstrs };
    let mut MI: *mut MachineInstr = &mut InitialMI;
    while SinkCheckToSingleUse.call(*MI) {
        SingleUse;
    }
    return MI;
}

fn X86SpeculativeLoadHardeningImpl::canHardenRegister(self, Reg: Register) -> bool {
    if !Reg.isVirtual() {
        return false;
    }
    let mut RC: *TargetRegisterClass = self.MRI.getRegClass(Reg);
    let mut RegBytes: i32 = self.TRI.getRegSizeInBits(*RC).operator unsigned long long() / 8;
    if RegBytes > 8 {
        return false;
    }
    let mut RegIdx: u32 = Log2_32(RegBytes);
    assert!(RegIdx < 4, "Unsupported register size");
    let mut NOREXRegClasses: [4]*mut TargetRegisterClass = [&mut GR8_NOREXRegClass, &mut GR16_NOREXRegClass, &mut GR32_NOREXRegClass, &mut GR64_NOREXRegClass];
    if RC == NOREXRegClasses[RegIdx] {
        return false;
    }
    let mut GPRRegClasses: [4]*mut TargetRegisterClass = [&mut GR8RegClass, &mut GR16RegClass, &mut GR32RegClass, &mut GR64RegClass];
    return RC.hasSuperClassEq(GPRRegClasses[RegIdx]);
}

fn X86SpeculativeLoadHardeningImpl::hardenValueInRegister(self, Reg: Register, MBB: *mut MachineBasicBlock, InsertPt: iterator, Loc: *DebugLoc) -> Register {
    assert!(self.canHardenRegister(Reg), "Cannot harden this register!");
    let mut RC: *TargetRegisterClass = self.MRI.getRegClass(Reg);
    let mut Bytes: i32 = self.TRI.getRegSizeInBits(*RC).operator unsigned long long() / 8;
    let mut StateReg: Register = operator(self.PS).SSA.GetValueAtEndOfBlock(&mut MBB);
    assert!((Bytes == 1 || Bytes == 2 || Bytes == 4 || Bytes == 8), "Unknown register size");
    if Bytes != 8 {
        let mut SubRegImms: [3]u32 = [sub_8bit, sub_16bit, sub_32bit];
        let mut SubRegImm: u32 = SubRegImms[Log2_32(Bytes)];
        let mut NarrowStateReg: Register = self.MRI.createVirtualRegister(RC, "");
        BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(COPY), NarrowStateReg).addReg(StateReg, RegState {}, SubRegImm);
        StateReg = NarrowStateReg;
    }
    let mut FlagsReg: Register = 0;
    if isEFLAGSLive(MBB, InsertPt, *self.TRI) {
        FlagsReg = self.saveEFLAGS(MBB, InsertPt, Loc);
    }
    let mut NewReg: Register = self.MRI.createVirtualRegister(RC, "");
    let mut OrOpCodes: [4]u32 = [OR8rr, OR16rr, OR32rr, OR64rr];
    let mut OrOpCode: u32 = OrOpCodes[Log2_32(Bytes)];
    let mut OrI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(OrOpCode), NewReg).addReg(StateReg, RegState {}, 0).addReg(Reg, RegState {}, 0);
    operator(OrI).addRegisterDead(EFLAGS, self.TRI, false);
    operator(NumInstsInserted);
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-slh", 1) {
            dbgs() << "  Inserting or: ";
            operator(OrI).dump();
            dbgs() << "\n";
        }
    }
        if !(false) { break; }
    }
    if FlagsReg.operator unsigned int() {
        self.restoreEFLAGS(MBB, InsertPt, Loc, FlagsReg);
    }
    return NewReg;
}

fn X86SpeculativeLoadHardeningImpl::hardenPostLoad(self, MI: *mut MachineInstr) -> Register {
    let mut MBB: *mut MachineBasicBlock = *MI.getParent();
    let mut Loc: *DebugLoc = MI.getDebugLoc();
    let mut DefOp: *mut MachineOperand = MI.getOperand(0);
    let mut OldDefReg: Register = DefOp.getReg();
    let mut DefRC: *TargetRegisterClass = self.MRI.getRegClass(OldDefReg);
    let mut UnhardenedReg: Register = self.MRI.createVirtualRegister(DefRC, "");
    DefOp.setReg(UnhardenedReg);
    let mut HardenedReg: Register = self.hardenValueInRegister(UnhardenedReg, MBB, next(MI.getIterator(), 1), Loc);
    self.MRI.replaceRegWith(OldDefReg, HardenedReg);
    operator(NumPostLoadRegsHardened);
    return HardenedReg;
}

fn X86SpeculativeLoadHardeningImpl::hardenReturnInstr(self, MI: *mut MachineInstr) {
    let mut MBB: *mut MachineBasicBlock = *MI.getParent();
    let mut Loc: *DebugLoc = MI.getDebugLoc();
    let mut InsertPt: self_iterator = MI.getIterator();
    if FenceCallAndRet {
        return;
    }
    self.mergePredStateIntoSP(MBB, InsertPt, Loc, operator(self.PS).SSA.GetValueAtEndOfBlock(&mut MBB));
}

fn X86SpeculativeLoadHardeningImpl::tracePredStateThroughCall(self, MI: *mut MachineInstr) {
    let mut MBB: *mut MachineBasicBlock = *MI.getParent();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut InsertPt: self_iterator = MI.getIterator();
    let mut Loc: *DebugLoc = MI.getDebugLoc();
    if FenceCallAndRet {
        if MI.isReturn(AnyInBundle) {
            return;
        }
        BuildMI(MBB, next(InsertPt, 1), MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LFENCE));
        operator(NumInstsInserted);
        operator(NumLFENCEsInserted);
        return;
    }
    let mut StateReg: Register = operator(self.PS).SSA.GetValueAtEndOfBlock(&mut MBB);
    self.mergePredStateIntoSP(MBB, InsertPt, Loc, StateReg);
    if MI.isReturn(AnyInBundle) || (next(InsertPt, 1) == MBB.end() && MBB.succ_empty()) {
        return;
    }
    let mut RetSymbol: *mut MCSymbol = MF.getContext().createTempSymbol("slh_ret_addr", true);
    MI.setPostInstrSymbol(MF, RetSymbol);
    let mut AddrRC: *TargetRegisterClass = &mut GR64RegClass;
    let mut ExpectedRetAddrReg: Register = 0;
    if !self.Subtarget.getFrameLowering().has128ByteRedZone(MF) || MF.exposesReturnsTwice() {
        ExpectedRetAddrReg = self.MRI.createVirtualRegister(AddrRC, "");
        if MF.getTarget().getCodeModel() == Small && !self.Subtarget.isPositionIndependent() {
            BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MOV64ri32), ExpectedRetAddrReg).addSym(RetSymbol, 0);
        } else {
            BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LEA64r), ExpectedRetAddrReg).addReg(RIP, RegState {}, 0).addImm(1).addReg(0, RegState {}, 0).addSym(RetSymbol, 0).addReg(0, RegState {}, 0);
        }
    }
    operator(InsertPt);
    if !ExpectedRetAddrReg.operator unsigned int() {
        ExpectedRetAddrReg = self.MRI.createVirtualRegister(AddrRC, "");
        BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MOV64rm), ExpectedRetAddrReg).addReg(RSP, RegState {}, 0).addImm(1).addReg(0, RegState {}, 0).addImm(-8).addReg(0, RegState {}, 0);
    }
    let mut NewStateReg: Register = self.extractPredStateFromSP(MBB, InsertPt, Loc);
    if MF.getTarget().getCodeModel() == Small && !self.Subtarget.isPositionIndependent() {
        BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CMP64ri32)).addReg(ExpectedRetAddrReg, Kill, 0).addSym(RetSymbol, 0);
    } else {
        let mut ActualRetAddrReg: Register = self.MRI.createVirtualRegister(AddrRC, "");
        BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LEA64r), ActualRetAddrReg).addReg(RIP, RegState {}, 0).addImm(1).addReg(0, RegState {}, 0).addSym(RetSymbol, 0).addReg(0, RegState {}, 0);
        BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CMP64rr)).addReg(ExpectedRetAddrReg, Kill, 0).addReg(ActualRetAddrReg, Kill, 0);
    }
    let mut PredStateSizeInBytes: i32 = self.TRI.getRegSizeInBits(*operator(self.PS).RC).operator unsigned long long() / 8;
    let mut CMovOp: u32 = getCMovOpcode(PredStateSizeInBytes, false, false);
    let mut UpdatedStateReg: Register = self.MRI.createVirtualRegister(operator(self.PS).RC, "");
    let mut CMovI: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: Loc, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CMovOp), UpdatedStateReg).addReg(NewStateReg, Kill, 0).addReg(operator(self.PS).PoisonReg, RegState {}, 0).addImm(COND_NE);
    operator(CMovI).findRegisterUseOperand(EFLAGS, null, false).setIsKill(true);
    operator(NumInstsInserted);
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-slh", 1) {
            dbgs() << "  Inserting cmov: ";
            operator(CMovI).dump();
            dbgs() << "\n";
        }
    }
        if !(false) { break; }
    }
    operator(self.PS).SSA.AddAvailableValue(&mut MBB, UpdatedStateReg);
}

fn X86SpeculativeLoadHardeningImpl::hardenIndirectCallOrJumpInstr(self, MI: *mut MachineInstr, AddrRegToHardenedReg: *mut SmallDenseMap<Register, Register, 32>) {
    match MI.getOpcode() {
        FARCALL16m => {
            FARCALL32m;
        },
        _ => {
            break;
        },
    }
    assert!(!MI.mayLoad(AnyInBundle), "Found a lingering loading instruction!");
    if !MI.getOperand(0).isReg() {
        return;
    }
    let mut TargetOp: *mut MachineOperand = MI.getOperand(0);
    let mut OldTargetReg: Register = TargetOp.getReg();
    let mut HardenedTargetReg: *mut Register = AddrRegToHardenedReg[OldTargetReg];
    if !HardenedTargetReg.operator unsigned int() {
        HardenedTargetReg = self.hardenValueInRegister(OldTargetReg, *MI.getParent(), MI.getIterator(), MI.getDebugLoc());
    }
    TargetOp.setReg(HardenedTargetReg);
    operator(NumCallsOrJumpsHardened);
}

fn X86SpeculativeLoadHardeningPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86SpeculativeLoadHardeningImpl = X86SpeculativeLoadHardeningImpl {};
    let mut Changed: bool = Impl.run(MF);
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-slh", 1) {
            dbgs() << "Final speculative load hardened function:\n";
            MF.dump();
            dbgs() << "\n";
            MF.verify(MFAM, null, null, true);
        }
    }
        if !(false) { break; }
    }
    return if Changed { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}

fn createX86SpeculativeLoadHardeningLegacyPass() -> *mut FunctionPass {
    return X86SpeculativeLoadHardeningLegacy {};
}

struct Closure_1 {
    cap_0: *mut X86SpeculativeLoadHardeningImpl,
    CMovs: *mut SmallVector<MachineInstr *, 16>,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MBB: *mut MachineBasicBlock, Succ: *mut MachineBasicBlock, SuccCount: i32, Br: *mut MachineInstr, UncondBr: *mut *mut MachineInstr, Conds: CondCode>) {
            let mut CheckingMBB: *mut MachineBasicBlock = if (SuccCount == 1 && Succ.pred_size() == 1) { Succ } else { splitEdge(MBB, Succ, SuccCount, Br, UncondBr, *self.TII) };
            let mut LiveEFLAGS: bool = Succ.isLiveIn(EFLAGS, getAll());
            if !LiveEFLAGS {
                CheckingMBB.addLiveIn(EFLAGS, getAll());
            }
            let mut InsertPt: iterator = CheckingMBB.begin();
            assert!((InsertPt == CheckingMBB.end() || !operator(InsertPt).isPHI()), "Should never have a PHI in the initial checking block as it always has a single predecessor!");
            let mut CurStateReg: Register = operator(self.PS).InitialReg;
            for Cond in Conds {
                let mut PredStateSizeInBytes: i32 = self.TRI.getRegSizeInBits(*operator(self.PS).RC).operator unsigned long long() / 8;
                let mut CMovOp: u32 = getCMovOpcode(PredStateSizeInBytes, false, false);
                let mut UpdatedStateReg: Register = self.MRI.createVirtualRegister(operator(self.PS).RC, "");
                let mut CMovI: MachineInstrBuilder = BuildMI(CheckingMBB, InsertPt, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CMovOp), UpdatedStateReg).addReg(CurStateReg, RegState {}, 0).addReg(operator(self.PS).PoisonReg, RegState {}, 0).addImm(Cond);
                if !LiveEFLAGS && Cond == Conds.back() {
                    operator(CMovI).findRegisterUseOperand(EFLAGS, null, false).setIsKill(true);
                }
                operator(NumInstsInserted);
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-slh", 1) {
                        dbgs() << "  Inserting cmov: ";
                        operator(CMovI).dump();
                        dbgs() << "\n";
                    }
                }
                    if !(false) { break; }
                }
                if CurStateReg == operator(self.PS).InitialReg {
                    (*self.CMovs).push(&mut *CMovI.operator llvm::MachineInstr *());
                }
                CurStateReg = UpdatedStateReg;
            }
            operator(self.PS).SSA.AddAvailableValue(&mut CheckingMBB, CurStateReg);
        }

struct Closure_2 {
    TI: *mut MachineInstr,
}

unsafe fn Closure_2::call(self: *mut Closure_2, OtherTI: *mut MachineInstr) -> bool {
            return !OtherTI.isDebugInstr() && &mut OtherTI != &mut (*self.TI);
        }

struct Closure_3 {
    MBB: *mut MachineBasicBlock,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Succ: *mut MachineBasicBlock) -> bool {
                return Succ.isEHPad() || Succ == &mut (*self.MBB);
            }

struct Closure_4 {
    LoadDepRegs: *mut SparseBitVector<>,
}

unsafe fn Closure_4::call(self: *mut Closure_4, Op: *mut MachineOperand) -> bool {
                    return Op.isReg() && (*self.LoadDepRegs).test(Op.getReg().id());
                }

struct Closure_5 {
    AddrRegToHardenedReg: *mut SmallDenseMap<Register, Register, 32>,
}

unsafe fn Closure_5::call(self: *mut Closure_5, Op: *mut MachineOperand) -> bool {
        let mut It: iterator = (*self.AddrRegToHardenedReg).find(Op.getReg());
        if It == (*self.AddrRegToHardenedReg).end() {
            return false;
        }
        Op.setReg(operator(It).second);
        return true;
    }

struct Closure_6 {
    cap_0: *mut X86SpeculativeLoadHardeningImpl,
    HardenedInstrs: *mut SmallPtrSetImpl<MachineInstr *>,
}

unsafe fn Closure_6::call(self: *mut Closure_6, MI: *mut MachineInstr) -> auto {
        let mut DefReg: Register = MI.getOperand(0).getReg();
        let mut SingleUseMI: *mut MachineInstr = null;
        for UseMI in self.MRI.use_instructions(DefReg) {
            if (*self.HardenedInstrs).count(&mut UseMI) {
                if !isDataInvariantLoad(UseMI) || isEFLAGSDefLive(UseMI) {
                    assert!(isDataInvariant(UseMI), "Data variant instruction being hardened!");
                    continue;
                }
                let mut MemRefBeginIdx: i32 = getFirstAddrOperandIdx(UseMI);
                assert!(MemRefBeginIdx >= 0, "Should always have mem references here!");
                let mut BaseMO: *mut MachineOperand = UseMI.getOperand(MemRefBeginIdx + AddrBaseReg);
                let mut IndexMO: *mut MachineOperand = UseMI.getOperand(MemRefBeginIdx + AddrIndexReg);
                if (BaseMO.isReg() && BaseMO.getReg() == DefReg) || (IndexMO.isReg() && IndexMO.getReg() == DefReg) {
                    return optional<MachineInstr *> {};
                }
                continue;
            }
            if SingleUseMI {
                return optional<MachineInstr *> {};
            }
            if !isDataInvariant(UseMI) || UseMI.getParent() != MI.getParent() || isEFLAGSDefLive(UseMI) {
                return optional<MachineInstr *> {};
            }
            if UseMI.getDesc().getNumDefs() > 1 {
                return optional<MachineInstr *> {};
            }
            let mut UseDefReg: Register = UseMI.getOperand(0).getReg();
            if !self.canHardenRegister(UseDefReg) {
                return optional<MachineInstr *> {};
            }
            SingleUseMI = &mut UseMI;
        }
        return SingleUseMI;
    }
