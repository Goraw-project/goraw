static mut UseVZeroUpper: opt<bool> = opt<bool> { "x86-use-vzeroupper", Hidden, "Minimize AVX to SSE transition penalty", init(true) };

static mut NumVZU: Statistic = Statistic { "x86-insert-vzeroupper", "NumVZU", "Number of vzeroupper instructions inserted" };

struct X86InsertVZeroUpperLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86InsertVZeroUpperLegacy::getPassName(self: *X86InsertVZeroUpperLegacy) -> str {
    return "X86 vzeroupper inserter";
}

fn X86InsertVZeroUpperLegacy::getRequiredProperties(self: *X86InsertVZeroUpperLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn X86InsertVZeroUpperLegacy::getPassKind(self: *X86InsertVZeroUpperLegacy) -> PassKind {
    return self.Kind;
}

fn X86InsertVZeroUpperLegacy::getPassID(self: *X86InsertVZeroUpperLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86InsertVZeroUpperLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86InsertVZeroUpperLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86InsertVZeroUpperLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86InsertVZeroUpperLegacy::getResolver(self: *X86InsertVZeroUpperLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86InsertVZeroUpperLegacy::getSetProperties(self: *X86InsertVZeroUpperLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86InsertVZeroUpperLegacy::getClearedProperties(self: *X86InsertVZeroUpperLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

enum BlockExitState {
    PASS_THROUGH = 0,
    EXITS_CLEAN = 1,
    EXITS_DIRTY = 2,
}

struct BlockState {
    ExitState: BlockExitState,
    AddedToDirtySuccessors: bool,
    FirstUnguardedCall: iterator,
}

static mut ID: i8 = 0;

fn createX86InsertVZeroUpperLegacyPass() -> *mut FunctionPass {
    return X86InsertVZeroUpperLegacy {};
}

fn getBlockExitStateName(ST: BlockExitState) -> *u8 {
    match ST {
        PASS_THROUGH => {
            return "Pass-through";
        },
        EXITS_DIRTY => {
            return "Exits-dirty";
        },
        EXITS_CLEAN => {
            return "Exits-clean";
        },
    }
    llvm_unreachable_internal("Invalid block exit state.", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InsertVZeroUpper.cpp", 116);
}

fn isYmmOrZmmReg(Reg: MCRegister) -> bool {
    return (Reg.operator unsigned int() >= YMM0 && Reg.operator unsigned int() <= YMM15) || (Reg.operator unsigned int() >= ZMM0 && Reg.operator unsigned int() <= ZMM15);
}

fn checkFnHasLiveInYmmOrZmm(MRI: *mut MachineRegisterInfo) -> bool {
    for LI in MRI.liveins() {
        if isYmmOrZmmReg(LI.first) {
            return true;
        }
    }
    return false;
}

fn clobbersAllYmmAndZmmRegs(MO: *MachineOperand) -> bool {
    for let mut reg: u32 = YMM0; reg <= YMM15; reg += 1 {
        if !MO.clobbersPhysReg(reg) {
            return false;
        }
    }
    for let mut reg: u32 = ZMM0; reg <= ZMM15; reg += 1 {
        if !MO.clobbersPhysReg(reg) {
            return false;
        }
    }
    return true;
}

fn hasYmmOrZmmReg(MI: *mut MachineInstr) -> bool {
    for MO in MI.operands() {
        if MI.isCall(AnyInBundle) && MO.isRegMask() && !clobbersAllYmmAndZmmRegs(MO) {
            return true;
        }
        if !MO.isReg() {
            continue;
        }
        if MO.isDebug() {
            continue;
        }
        if isYmmOrZmmReg(MO.getReg().asMCReg()) {
            return true;
        }
    }
    return false;
}

fn callHasRegMask(MI: *mut MachineInstr) -> bool {
    assert!(MI.isCall(AnyInBundle), "Can only be called on call instructions.");
    for MO in MI.operands() {
        if MO.isRegMask() {
            return true;
        }
    }
    return false;
}

fn insertVZeroUpper(I: iterator, MBB: *mut MachineBasicBlock, TII: *TargetInstrInfo) -> bool {
    BuildMI(MBB, I, MIMetadata { DL: operator(I).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(VZEROUPPER));
    operator(NumVZU);
    return true;
}

fn addDirtySuccessor(MBB: *mut MachineBasicBlock, BlockStates: *mut BlockStateMap, DirtySuccessors: *mut DirtySuccessorsWorkList) {
    if !BlockStates[MBB.getNumber()].AddedToDirtySuccessors {
        DirtySuccessors.push(&mut MBB);
        BlockStates[MBB.getNumber()].AddedToDirtySuccessors = true;
    }
}

fn processBasicBlock(MBB: *mut MachineBasicBlock, BlockStates: *mut BlockStateMap, DirtySuccessors: *mut DirtySuccessorsWorkList, IsX86INTR: bool, TII: *TargetInstrInfo) -> bool {
    let mut CurState: BlockExitState = PASS_THROUGH;
    BlockStates[MBB.getNumber()].FirstUnguardedCall = MBB.end();
    let mut MadeChange: bool = false;
    for MI in MBB {
        let mut IsCall: bool = MI.isCall(AnyInBundle);
        let mut IsReturn: bool = MI.isReturn(AnyInBundle);
        let mut IsControlFlow: bool = IsCall || IsReturn;
        if IsX86INTR && IsReturn {
            continue;
        }
        if MI.getOpcode() == VZEROALL || MI.getOpcode() == VZEROUPPER {
            CurState = EXITS_CLEAN;
            continue;
        }
        if !IsControlFlow && CurState == EXITS_DIRTY {
            continue;
        }
        if hasYmmOrZmmReg(MI) {
            CurState = EXITS_DIRTY;
            continue;
        }
        if !IsControlFlow {
            continue;
        }
        if IsCall && !callHasRegMask(MI) {
            continue;
        }
        if CurState == EXITS_DIRTY {
            MadeChange |= insertVZeroUpper(MI, MBB, TII);
            CurState = EXITS_CLEAN;
        } else if CurState == PASS_THROUGH {
            BlockStates[MBB.getNumber()].FirstUnguardedCall = MI;
            CurState = EXITS_CLEAN;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-insert-vzeroupper", 1) {
            dbgs() << "MBB #" << MBB.getNumber() << " exit state: " << getBlockExitStateName(CurState) << 10;
        }
    }
        if !(false) { break; }
    }
    if CurState == EXITS_DIRTY {
        for Succ in MBB.successors() {
            addDirtySuccessor(*Succ, BlockStates, DirtySuccessors);
        }
    }
    BlockStates[MBB.getNumber()].ExitState = CurState;
    return MadeChange;
}

fn insertVZeroUpper(MF: *mut MachineFunction) -> bool {
    if !UseVZeroUpper {
        return false;
    }
    let mut ST: *X86Subtarget = MF.getSubtarget();
    if !ST.hasAVX() || !ST.insertVZEROUPPER() {
        return false;
    }
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut FnHasLiveInYmmOrZmm: bool = checkFnHasLiveInYmmOrZmm(MRI);
    let mut YmmOrZmmUsed: bool = FnHasLiveInYmmOrZmm;
    for RC in [&mut VR256RegClass, &mut VR512_0_15RegClass] {
        if !YmmOrZmmUsed {
            for R in *RC {
                if !MRI.reg_nodbg_empty(R) {
                    YmmOrZmmUsed = true;
                    break;
                }
            }
        }
    }
    if !YmmOrZmmUsed {
        return false;
    }
    let mut TII: *TargetInstrInfo = ST.getInstrInfo();
    let mut IsX86INTR: bool = MF.getFunction().getCallingConv() == X86_INTR;
    let mut EverMadeChange: bool = false;
    let mut BlockStates: BlockStateMap = MF.getNumBlockIDs();
    let mut DirtySuccessors: DirtySuccessorsWorkList = DirtySuccessorsWorkList {};
    assert!(BlockStates.len == MF.getNumBlockIDs() && DirtySuccessors.is_empty(), "X86VZeroUpper state should be clear");
    for MBB in MF {
        EverMadeChange |= processBasicBlock(MBB, BlockStates, DirtySuccessors, IsX86INTR, TII);
    }
    if FnHasLiveInYmmOrZmm {
        addDirtySuccessor(MF.front(), BlockStates, DirtySuccessors);
    }
    while !DirtySuccessors.is_empty() {
        let mut MBB: *mut MachineBasicBlock = *DirtySuccessors.back();
        DirtySuccessors.pop();
        let mut BBState: *mut BlockState = BlockStates[MBB.getNumber()];
        if BBState.FirstUnguardedCall != MBB.end() {
            EverMadeChange |= insertVZeroUpper(BBState.FirstUnguardedCall, MBB, TII);
        }
        if BBState.ExitState == PASS_THROUGH {
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-insert-vzeroupper", 1) {
                    dbgs() << "MBB #" << MBB.getNumber() << " was Pass-through, is now Dirty-out.\n";
                }
            }
                if !(false) { break; }
            }
            for Succ in MBB.successors() {
                addDirtySuccessor(*Succ, BlockStates, DirtySuccessors);
            }
        }
    }
    return EverMadeChange;
}

fn X86InsertVZeroUpperLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return insertVZeroUpper(MF);
}

fn X86InsertVZeroUpperPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if insertVZeroUpper(MF) { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}
