fn X86FrameLowering::emitStackProbeInlineWindowsCoreCLR64(self: *X86FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, MBBI: iterator, DL: *DebugLoc, InProlog: bool) {
    let mut STI: *X86Subtarget = MF;
    (((operator!(operator!((STI()() && "different expansion needed for 32 bit")))) || (_wassert(L"STI.is64Bit() && \"different expansion needed for 32 bit\"", L"llvm\\lib\\Target\\X86\\X86FrameLowering.cpp", (1038) as u32) , 0)) as void);
    assert!(STI.isTargetWindowsCoreCLR(), "custom expansion expects CoreCLR");
    let mut TII: *TargetInstrInfo = *STI.getInstrInfo();
    let mut LLVM_BB: *BasicBlock = MBB.getBasicBlock();
    (((operator!(operator!((MBB.computeRegisterLiveness != LQR_Live && "Inline stack probe loop will clobber live EFLAGS.")))) || (_wassert(L"MBB.computeRegisterLiveness(TRI, X86::EFLAGS, MBBI) != MachineBasicBlock::LQR_Live && \"Inline stack probe loop will clobber live EFLAGS.\"", L"llvm\\lib\\Target\\X86\\X86FrameLowering.cpp", (1045) as u32) , 0)) as void);
    let mut RoundMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, optional<UniqueBBID> { nullopt });
    let mut LoopMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, optional<UniqueBBID> { nullopt });
    let mut ContinueMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, optional<UniqueBBID> { nullopt });
    let mut MBBIter: iterator = next(MBB.getIterator());
    MF.insert(iterator { MBBIter }, RoundMBB);
    MF.insert(iterator { MBBIter }, LoopMBB);
    MF.insert(iterator { MBBIter }, ContinueMBB);
    let mut BeforeMBBI: iterator = prev(MBBI);
    ContinueMBB.splice(ContinueMBB.begin(), &mut MBB, iterator { MBBI }, MBB.end());
    ContinueMBB.transferSuccessorsAndUpdatePHIs(&mut MBB);
    let mut ThreadEnvironmentStackLimit: i64 = 16;
    let mut PageSize: i64 = 4096;
    let mut PageMask: i64 = ~(PageSize - 1);
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut RegClass: *TargetRegisterClass = null;
    let mut SizeReg: Register = zeroed();
    let mut ZeroReg: Register = zeroed();
    let mut CopyReg: Register = zeroed();
    let mut TestReg: Register = zeroed();
    let mut FinalReg: Register = zeroed();
    let mut RoundedReg: Register = zeroed();
    let mut LimitReg: Register = zeroed();
    let mut JoinReg: Register = zeroed();
    let mut ProbeReg: Register = zeroed();
    let mut RCXShadowSlot: i64 = 0;
    let mut RDXShadowSlot: i64 = 0;
    if InProlog {
        let mut X86FI: *mut X86MachineFunctionInfo = MF;
        let mut CalleeSaveSize: i64 = X86FI.getCalleeSavedFrameSize();
        let mut HasFP: bool = self.hasFP(MF);
        let mut IsRCXLiveIn: bool = MBB.isLiveIn;
        let mut IsRDXLiveIn: bool = MBB.isLiveIn;
        let mut InitSlot: i64 = 8 + CalleeSaveSize + (if HasFP { 8 } else { 0 });
        if IsRCXLiveIn {
            RCXShadowSlot = InitSlot;
        }
        if IsRDXLiveIn {
            RDXShadowSlot = InitSlot;
        }
        if IsRDXLiveIn && IsRCXLiveIn {
            RDXShadowSlot += 8;
        }
        if IsRCXLiveIn {
            addRegOffset(BuildMI(&mut MBB, DL, TII.get), false, RCXShadowSlot);
        }
        if IsRDXLiveIn {
            addRegOffset(BuildMI(&mut MBB, DL, TII.get), false, RDXShadowSlot);
        }
    } else {
        BuildMI(&mut MBB, DL, TII.get, SizeReg);
    }
    BuildMI(&mut MBB, DL, TII.get, ZeroReg)(ZeroReg, Undef)(ZeroReg, Undef);
    BuildMI(&mut MBB, DL, TII.get, CopyReg);
    BuildMI(&mut MBB, DL, TII.get, TestReg)(CopyReg)(SizeReg);
    BuildMI(&mut MBB, DL, TII.get, FinalReg)(TestReg)(ZeroReg)(COND_B);
    BuildMI(&mut MBB, DL, TII.get, LimitReg)(0)(1)(0)(ThreadEnvironmentStackLimit);
    BuildMI(&mut MBB, DL, TII.get)(FinalReg)(LimitReg);
    BuildMI(&mut MBB, DL, TII.get)(ContinueMBB)(COND_AE);
    if InProlog {
        RoundMBB.addLiveIn(FinalReg.operator MCRegister(), getAll());
    }
    BuildMI(RoundMBB, DL, TII.get, RoundedReg)(FinalReg)(PageMask);
    BuildMI(RoundMBB, DL, TII.get)(LoopMBB);
    if !InProlog {
        BuildMI(LoopMBB, DL, TII.get, JoinReg)(LimitReg)(RoundMBB)(ProbeReg)(LoopMBB);
    }
    if InProlog {
        LoopMBB.addLiveIn(JoinReg.operator MCRegister(), getAll());
    }
    addRegOffset(BuildMI(LoopMBB, DL, TII.get, ProbeReg), JoinReg, false, -PageSize);
    BuildMI(LoopMBB, DL, TII.get)(ProbeReg)(1)(0)(0)(0)(0);
    if InProlog {
        LoopMBB.addLiveIn(RoundedReg.operator MCRegister(), getAll());
    }
    BuildMI(LoopMBB, DL, TII.get)(RoundedReg)(ProbeReg);
    BuildMI(LoopMBB, DL, TII.get)(LoopMBB)(COND_NE);
    let mut ContinueMBBI: iterator = ContinueMBB.getFirstNonPHI();
    if InProlog {
        if RCXShadowSlot {
            addRegOffset(BuildMI(*ContinueMBB, ContinueMBBI, DL, TII.get), false, RCXShadowSlot);
        }
        if RDXShadowSlot {
            addRegOffset(BuildMI(*ContinueMBB, ContinueMBBI, DL, TII.get), false, RDXShadowSlot);
        }
    }
    BuildMI(*ContinueMBB, ContinueMBBI, DL, TII.get)(SizeReg);
    MBB.addSuccessor(ContinueMBB, getUnknown());
    MBB.addSuccessor(RoundMBB, getUnknown());
    RoundMBB.addSuccessor(LoopMBB, getUnknown());
    LoopMBB.addSuccessor(ContinueMBB, getUnknown());
    LoopMBB.addSuccessor(LoopMBB, getUnknown());
    if InProlog {
        let mut LiveRegs: LivePhysRegs = LivePhysRegs {};
        computeAndAddLiveIns(LiveRegs, *ContinueMBB);
    }
    if InProlog {
        for operator(BeforeMBBI); BeforeMBBI != MBB.end(); operator(BeforeMBBI) {
            operator(BeforeMBBI).setFlag(FrameSetup);
        }
        for MI in *RoundMBB {
            MI.setFlag(FrameSetup);
        }
        for MI in *LoopMBB {
            MI.setFlag(FrameSetup);
        }
    }
}

fn X86FrameLowering::emitStackProbeCall(self: *X86FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, MBBI: iterator, DL: *DebugLoc, InProlog: bool, InstrNum: DebugInstrOperandPair>) {
    let mut IsLargeCodeModel: bool = MF.getTarget().getCodeModel() == Large;
    if self.Is64Bit && IsLargeCodeModel && self.STI.useIndirectThunkCalls() {
        report_fatal_error("Emitting stack probe calls on 64-bit with the large code model and indirect thunks not yet implemented.", true);
    }
    (((operator!(operator!((MBB.computeRegisterLiveness != LQR_Live && "Stack probe calls will clobber live EFLAGS.")))) || (_wassert(L"MBB.computeRegisterLiveness(TRI, X86::EFLAGS, MBBI) != MachineBasicBlock::LQR_Live && \"Stack probe calls will clobber live EFLAGS.\"", L"llvm\\lib\\Target\\X86\\X86FrameLowering.cpp", (1288) as u32) , 0)) as void);
    let mut CallOp: u32 = 0;
    let mut Symbol: str = self.STI.getTargetLowering().getStackProbeSymbolName(MF);
    let mut CI: MachineInstrBuilder = MachineInstrBuilder {};
    let mut ExpansionMBBI: iterator = prev(MBBI);
    if self.Is64Bit && MF.getTarget().getCodeModel() == Large {
        BuildMI(MBB, MBBI, DL, self.TII)(MF.createExternalSymbolName(Symbol));
        CI = BuildMI(MBB, MBBI, DL, self.TII(CallOp));
    } else {
        CI = BuildMI(MBB, MBBI, DL, self.TII(CallOp))(MF.createExternalSymbolName(Symbol));
    }
    let mut AX: u32 = 0;
    let mut SP: u32 = 0;
    CI.addReg(Register { Reg: AX }, Implicit, 0).addReg(Register { Reg: SP }, Implicit, 0).addReg(AX, Define(Implicit))(SP, Define(Implicit));
    let mut ModInst: *mut MachineInstr = CI.operator llvm::MachineInstr *();
    if self.STI.isTargetWin64() || !self.STI.isOSWindows() {
        ModInst = BuildMI(MBB, MBBI, DL, self.TII(getSUBrrOpcode(self.Uses64BitFramePtr)), SP)(SP)(AX);
    }
    if InstrNum {
        if self.STI.isTargetWin64() || !self.STI.isOSWindows() {
            MF.makeDebugValueSubstitution;
        } else {
            let mut SPDefOperand: u32 = ModInst.getNumOperands() - 2;
            MF.makeDebugValueSubstitution;
        }
    }
    if InProlog {
        for operator(ExpansionMBBI); ExpansionMBBI != MBBI; operator(ExpansionMBBI) {
            operator(ExpansionMBBI).setFlag(FrameSetup);
        }
    }
}

fn calculateSetFPREG(SPAdjust: u64) -> u32 {
    let mut Win64MaxSEHOffset: u64 = 128;
    let mut SEHFrameOffset: u64 = min(SPAdjust, Win64MaxSEHOffset);
    return SEHFrameOffset & -16;
}

fn X86FrameLowering::calculateMaxStackAlign(self: *X86FrameLowering, MF: *MachineFunction) -> u64 {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut MaxAlign: Align = MFI.getMaxAlign();
    let mut StackAlign: Align = self.getStackAlign();
    let mut HasRealign: bool = MF.getFunction().hasFnAttribute("stackrealign");
    if HasRealign {
        if MFI.hasCalls() {
            MaxAlign = if (StackAlign > MaxAlign) { StackAlign } else { MaxAlign };
        } else if MaxAlign < self.SlotSize {
            MaxAlign = Align { ShiftValue: self.SlotSize };
        }
    }
    if !self.Is64Bit && MF.getFunction().getCallingConv() == X86_INTR {
        if HasRealign {
            MaxAlign = if (MaxAlign > 16) { MaxAlign } else { Align { ShiftValue: 16 } };
        } else {
            MaxAlign = Align { ShiftValue: 16 };
        }
    }
    return MaxAlign.value();
}

fn X86FrameLowering::BuildStackAlignAND(self: *X86FrameLowering, MBB: *mut MachineBasicBlock, MBBI: iterator, DL: *DebugLoc, Reg: Register, MaxAlign: u64) {
    let mut Val: u64 = -MaxAlign;
    let mut AndOp: u32 = getANDriOpcode(self.Uses64BitFramePtr, Val);
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut STI: *X86Subtarget = MF;
    let mut TLI: *X86TargetLowering = *STI.getTargetLowering();
    let mut StackProbeSize: u64 = TLI.getStackProbeSize(MF);
    let mut EmitInlineStackProbe: bool = TLI.hasInlineStackProbe(MF);
    if Reg == self.StackPtr && EmitInlineStackProbe && MaxAlign >= StackProbeSize {
        {
            operator(NumFrameLoopProbe, 0);
            let mut entryMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), optional<UniqueBBID> { nullopt });
            let mut headMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), optional<UniqueBBID> { nullopt });
            let mut bodyMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), optional<UniqueBBID> { nullopt });
            let mut footMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), optional<UniqueBBID> { nullopt });
            let mut MBBIter: iterator = MBB.getIterator();
            MF.insert(iterator { MBBIter }, entryMBB);
            MF.insert(iterator { MBBIter }, headMBB);
            MF.insert(iterator { MBBIter }, bodyMBB);
            MF.insert(iterator { MBBIter }, footMBB);
            let mut MovMIOpc: u32 = 0;
            let mut FinalStackProbed: Register = zeroed();
            {
                entryMBB.splice(entryMBB.end(), &mut MBB, MBB.begin(), iterator { MBBI });
                BuildMI(entryMBB, DL, self.TII(COPY), FinalStackProbed)(self.StackPtr)(FrameSetup);
                let mut MI: *mut MachineInstr = BuildMI(entryMBB, DL, self.TII(AndOp), FinalStackProbed)(FinalStackProbed)(Val)(FrameSetup);
                MI.getOperand(3).setIsDead(true);
                BuildMI(entryMBB, DL, self.TII)(FinalStackProbed)(self.StackPtr)(FrameSetup);
                BuildMI(entryMBB, DL, self.TII)(&mut MBB)(COND_E)(FrameSetup);
                entryMBB.addSuccessor(headMBB, getUnknown());
                entryMBB.addSuccessor(&mut MBB, getUnknown());
            }
            {
                let mut SUBOpc: u32 = getSUBriOpcode(self.Uses64BitFramePtr);
                BuildMI(headMBB, DL, self.TII(SUBOpc), self.StackPtr)(self.StackPtr)(StackProbeSize)(FrameSetup);
                BuildMI(headMBB, DL, self.TII)(self.StackPtr)(FinalStackProbed)(FrameSetup);
                BuildMI(headMBB, DL, self.TII)(footMBB)(COND_B)(FrameSetup);
                headMBB.addSuccessor(bodyMBB, getUnknown());
                headMBB.addSuccessor(footMBB, getUnknown());
            }
            {
                addRegOffset(BuildMI(bodyMBB, DL, self.TII(MovMIOpc))(FrameSetup), self.StackPtr, false, 0)(0)(FrameSetup);
                let mut SUBOpc: u32 = getSUBriOpcode(self.Uses64BitFramePtr);
                BuildMI(bodyMBB, DL, self.TII(SUBOpc), self.StackPtr)(self.StackPtr)(StackProbeSize)(FrameSetup);
                BuildMI(bodyMBB, DL, self.TII)(FinalStackProbed)(self.StackPtr)(FrameSetup);
                BuildMI(bodyMBB, DL, self.TII)(bodyMBB)(COND_B)(FrameSetup);
                bodyMBB.addSuccessor(bodyMBB, getUnknown());
                bodyMBB.addSuccessor(footMBB, getUnknown());
            }
            {
                BuildMI(footMBB, DL, self.TII(COPY), self.StackPtr)(FinalStackProbed)(FrameSetup);
                addRegOffset(BuildMI(footMBB, DL, self.TII(MovMIOpc))(FrameSetup), self.StackPtr, false, 0)(0)(FrameSetup);
                footMBB.addSuccessor(&mut MBB, getUnknown());
