struct Closure_2 {
    cap_0: *X86FrameLowering,
}

fn Closure_2::call(self: *mut Closure_2, Reg: MCRegister) -> auto {
        if !VR128RegClass.contains(Reg) && !VR128XRegClass.contains(Reg) && !VR256RegClass.contains(Reg) && !VR256XRegClass.contains(Reg) && !VR512RegClass.contains(Reg) {
            return MCRegister { Reg: 0 };
        }
        let mut Xmm: MCRegister = self.TRI.getSubReg(Reg, sub_xmm);
        if !Xmm.operator unsigned int() {
            Xmm = Reg;
        }
        if VR128RegClass.contains(Xmm) {
            return Xmm;
        }
        let mut Zmm: MCRegister = self.TRI.getMatchingSuperReg(Xmm, sub_xmm, &mut VR512RegClass);
        assert!(Zmm.operator unsigned int(), "XMM16-31 must have an enclosing ZMM to clear through");
        return Zmm;
    }

