unsafe fn Closure_15::call(self: *mut Closure_15, Reg: Register) -> bool {
        let mut MRI: *MachineRegisterInfo = (*self.MF).getRegInfo();
        if MRI.isLiveIn(Reg) {
            return false;
        }
        (*self.MBB).addLiveIn(Reg.operator MCRegister(), getAll());
        for let mut AReg: MCRegAliasIterator = Reg((*self.TRI), false); AReg.isValid(); operator(AReg) {
            if MRI.isLiveIn(Register { Reg: operator(AReg) }) {
                return false;
            }
        }
        return true;
    }

