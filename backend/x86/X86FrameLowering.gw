    while CurrentOffset + StackProbeSize < Offset {
        self.BuildStackAdjustment(MBB, iterator { MBBI }, DL, -StackProbeSize, false).setMIFlag(FrameSetup);
        if !HasFP && NeedsDwarfCFI {
            self.BuildCFI(MBB, iterator { MBBI }, DL, createAdjustCfaOffset(null, StackProbeSize, SMLoc {}), NoFlags);
        }
        addRegOffset(BuildMI(MBB, MBBI, DL, self.TII(MovMIOpc))(FrameSetup), self.StackPtr, false, 0)(0)(FrameSetup);
        operator(NumFrameExtraProbe, 0);
        CurrentOffset += StackProbeSize;
    }
    let mut ChunkSize: u64 = Offset - CurrentOffset;
    if ChunkSize == self.SlotSize {
        let mut Reg: u32 = 0;
        let mut Opc: u32 = 0;
        BuildMI(MBB, MBBI, DL, self.TII(Opc))(Reg, Undef)(FrameSetup);
    } else {
        self.BuildStackAdjustment(MBB, iterator { MBBI }, DL, -ChunkSize, false).setMIFlag(FrameSetup);
    }
}

fn X86FrameLowering::emitStackProbeInlineGenericLoop(self: *X86FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, MBBI: iterator, DL: *DebugLoc, Offset: u64, AlignOffset: u64) {
