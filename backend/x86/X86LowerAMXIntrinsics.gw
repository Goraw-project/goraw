static mut ProfcheckDisableMetadataFixes: i32 = 0;

fn isV256I32Ty(Ty: *mut Type) -> bool {
    if  {
        return () == 256 && ()(32);
    }
    return false;
}

static mut X86ScalarizeAMX: i32 = "enable-x86-scalar-amx";

struct X86LowerAMXIntrinsics {
    Func: *mut Function,
    DTU: *mut DomTreeUpdater,
    LI: *mut LoopInfo,
}

fn X86LowerAMXIntrinsics::createLoop(self, Preheader: *mut BasicBlock, Exit: *mut BasicBlock, Bound: *mut Value, Step: *mut ConstantInt, Name: str, B: *mut IRBuilderBase, L: *mut Loop) -> *mut BasicBlock {
    let mut Ctx: *mut LLVMContext = Preheader.getContext();
    let mut Header: *mut BasicBlock = Create(Ctx, Name + ".header", Preheader.getParent(), Exit);
    let mut Body: *mut BasicBlock = Create(Ctx, Name + ".body", Header.getParent(), Exit);
    let mut Latch: *mut BasicBlock = Create(Ctx, Name + ".latch", Header.getParent(), Exit);
    let mut I16Ty: *mut Type = getInt16Ty(Ctx);
    Create(Body, InsertPosition { InsertAt: Header });
    Create(Latch, InsertPosition { InsertAt: Body });
    let mut IV: *mut PHINode = Create(I16Ty, 2, Name + ".iv", InsertPosition { InsertAt: Header.getTerminator().getIterator() });
    IV.addIncoming(get(I16Ty, 0, false, false), Preheader);
    B.SetInsertPoint(Latch);
    let mut Inc: *mut Value = B.CreateAdd(IV, Step, Name + ".step", false, false);
    let mut Cond: *mut Value = B.CreateICmpNE(Inc, Bound, Name + ".cond");
    let mut BR: *mut CondBrInst = Create(Cond, Header, Exit, InsertPosition { InsertAt: Latch });
    if !ProfcheckDisableMetadataFixes {
        if  {
            assert!(Step.getZExtValue() != 0, "Expected a non-zero step size. This is chosen by the pass and should always be non-zero to imply a finite loop.");
            let mut MDB: MDBuilder = MDBuilder { Context: Preheader.getContext() };
            setFittedBranchWeights(*BR, void { () / Step.getZExtValue(), 1 }, false);
        } else {
            setExplicitlyUnknownBranchWeightsIfProfiled(*BR, "x86-lower-amx-intrinsics", null);
        }
    }
    IV.addIncoming(Inc, Latch);
    let mut PreheaderBr: *mut UncondBrInst = cast(Preheader.getTerminator());
    let mut Tmp: *mut BasicBlock = PreheaderBr.getSuccessor(0);
    PreheaderBr.setSuccessor(Header);
    self.DTU.applyUpdatesPermissive(ArrayRef<UpdateT> { [Update<BasicBlock *> { Delete, Preheader, Tmp }, Update<BasicBlock *> { Insert, Header, Body }, Update<BasicBlock *> { Insert, Body, Latch }, Update<BasicBlock *> { Insert, Latch, Header }, Update<BasicBlock *> { Insert, Latch, Exit }, Update<BasicBlock *> { Insert, Preheader, Header }] });
    if self.LI {
        L.addBasicBlockToLoop(Header, *self.LI);
        L.addBasicBlockToLoop(Body, *self.LI);
        L.addBasicBlockToLoop(Latch, *self.LI);
    }
    return Body;
}

fn X86LowerAMXIntrinsics::lowerTileZero(self, TileZero: *mut Instruction) -> bool {
    let mut Builder: i32 = TileZero;
    let mut V256I32Ty: *mut FixedVectorType = get(256);
    let mut VecZero: *mut Value = getNullValue(V256I32Ty);
    TileZero.eraseFromParent();
    return true;
}

fn X86LowerAMXIntrinsics::visit(self) -> bool {
    let mut C: bool = false;
    let mut WorkList: SmallVector<IntrinsicInst *, 8> = zeroed();
    return C;
}

fn shouldRunLowerAMXIntrinsics(F: *Function, TM: *TargetMachine) -> bool {
    return  && (F.hasFnAttribute(OptimizeNone) || TM.getOptLevel() == None);
}

fn runLowerAMXIntrinsics(F: *mut Function, DT: *mut DominatorTree, LI: *mut LoopInfo) -> bool {
    let mut DTU: DomTreeUpdater = zeroed();
    let mut LAT: X86LowerAMXIntrinsics = X86LowerAMXIntrinsics { Func: F, DTU: DTU, LI: LI };
    return LAT.visit();
}

fn X86LowerAMXIntrinsicsPass::run(self, F: *mut Function, FAM: *mut FunctionAnalysisManager) -> PreservedAnalyses {
    if !shouldRunLowerAMXIntrinsics(F, self.TM) {
        return all();
    }
    let mut DT: *mut DominatorTree = FAM;
    let mut LI: *mut LoopInfo = FAM;
    let mut Changed: bool = runLowerAMXIntrinsics(F, &mut DT, &mut LI);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = none();
    PA;
    PA;
    return PA;
}

struct X86LowerAMXIntrinsicsLegacyPass {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
}

fn X86LowerAMXIntrinsicsLegacyPass::runOnFunction(self, F: *mut Function) -> bool {
    let mut TM: *mut TargetMachine = operator&();
    if !shouldRunLowerAMXIntrinsics(F, TM) {
        return false;
    }
    let mut DTWP: *mut auto = ;
    let mut DT: *mut auto = if  { operator&() } else { null };
    let mut LIWP: *mut auto = ;
    let mut LI: *mut auto = if  { operator&() } else { null };
    return runLowerAMXIntrinsics(F);
}

fn X86LowerAMXIntrinsicsLegacyPass::getPassName(self: *X86LowerAMXIntrinsicsLegacyPass) -> str {
    return "Lower AMX intrinsics";
}

fn X86LowerAMXIntrinsicsLegacyPass::getAnalysisUsage(self: *X86LowerAMXIntrinsicsLegacyPass, AU: *mut AnalysisUsage) {
    AU;
    AU;
    AU;
}

fn X86LowerAMXIntrinsicsLegacyPass::getPassKind(self: *X86LowerAMXIntrinsicsLegacyPass) -> PassKind {
    return self.Kind;
}

fn X86LowerAMXIntrinsicsLegacyPass::getPassID(self: *X86LowerAMXIntrinsicsLegacyPass) -> AnalysisID {
    return self.PassID;
}

fn X86LowerAMXIntrinsicsLegacyPass::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LowerAMXIntrinsicsLegacyPass::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LowerAMXIntrinsicsLegacyPass::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86LowerAMXIntrinsicsLegacyPass::getResolver(self: *X86LowerAMXIntrinsicsLegacyPass) -> *mut AnalysisResolver {
    return self.Resolver;
}

const PassName: [21]i8 = "Lower AMX intrinsics";

static mut ID: i8 = 0;

fn createX86LowerAMXIntrinsicsLegacyPass() -> *mut FunctionPass {
    return X86LowerAMXIntrinsicsLegacyPass {};
}
