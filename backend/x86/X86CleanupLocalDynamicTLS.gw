struct X86CleanupLocalDynamicTLSLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86CleanupLocalDynamicTLSLegacy::getPassName(self: *X86CleanupLocalDynamicTLSLegacy) -> str {
    return "Local Dynamic TLS Access Clean-up";
}

fn X86CleanupLocalDynamicTLSLegacy::getAnalysisUsage(self: *X86CleanupLocalDynamicTLSLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU.addRequired();
    self.getAnalysisUsage(AU);
}

fn X86CleanupLocalDynamicTLSLegacy::getPassKind(self: *X86CleanupLocalDynamicTLSLegacy) -> PassKind {
    return self.Kind;
}

fn X86CleanupLocalDynamicTLSLegacy::getPassID(self: *X86CleanupLocalDynamicTLSLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86CleanupLocalDynamicTLSLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86CleanupLocalDynamicTLSLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86CleanupLocalDynamicTLSLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86CleanupLocalDynamicTLSLegacy::getResolver(self: *X86CleanupLocalDynamicTLSLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86CleanupLocalDynamicTLSLegacy::getRequiredProperties(self: *X86CleanupLocalDynamicTLSLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86CleanupLocalDynamicTLSLegacy::getSetProperties(self: *X86CleanupLocalDynamicTLSLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86CleanupLocalDynamicTLSLegacy::getClearedProperties(self: *X86CleanupLocalDynamicTLSLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createCleanupLocalDynamicTLSLegacyPass() -> *mut FunctionPass {
    return X86CleanupLocalDynamicTLSLegacy {};
}

fn ReplaceTLSBaseAddrCall(I: *mut MachineInstr, TLSBaseAddrReg: Register) -> *mut MachineInstr {
    let mut MF: *mut MachineFunction = I.getParent().getParent();
    let mut STI: *X86Subtarget = MF.getSubtarget();
    let mut is64Bit: bool = STI.is64Bit();
    let mut TII: *X86InstrInfo = STI.getInstrInfo();
    let mut Copy: *mut MachineInstr = BuildMI(*I.getParent(), I, MIMetadata { DL: I.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(COPY), if is64Bit { RAX } else { EAX }).addReg(TLSBaseAddrReg, RegState {}, 0).operator llvm::MachineInstr *();
    I.eraseFromParent();
    return Copy;
}

fn SetRegister(I: *mut MachineInstr, TLSBaseAddrReg: *mut Register) -> *mut MachineInstr {
    let mut MF: *mut MachineFunction = I.getParent().getParent();
    let mut STI: *X86Subtarget = MF.getSubtarget();
    let mut is64Bit: bool = STI.is64Bit();
    let mut TII: *X86InstrInfo = STI.getInstrInfo();
    let mut RegInfo: *mut MachineRegisterInfo = MF.getRegInfo();
    *TLSBaseAddrReg = RegInfo.createVirtualRegister(if is64Bit { &mut GR64RegClass } else { &mut GR32RegClass }, "");
    let mut Next: *mut MachineInstr = I.getNextNode();
    let mut Copy: *mut MachineInstr = BuildMI(*I.getParent(), Next, MIMetadata { DL: I.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(COPY), *TLSBaseAddrReg).addReg(if is64Bit { RAX } else { EAX }, RegState {}, 0).operator llvm::MachineInstr *();
    return Copy;
}

fn VisitNode(Node: *mut MachineDomTreeNode, TLSBaseAddrReg: Register) -> bool {
    let mut BB: *mut MachineBasicBlock = Node.getBlock();
    let mut Changed: bool = false;
    for let mut I: iterator = BB.begin();
let mut E: iterator = BB.end(); I != E; operator(I) {
        match operator(I).getOpcode() {
            TLS_base_addr32 => {
                TLS_base_addr64;
            },
            _ => {
                break;
            },
        }
    }
    for I in Node.children() {
        Changed |= VisitNode(I, TLSBaseAddrReg);
    }
    return Changed;
}

fn cleanupLocalDynamicTLS(DT: *mut MachineDominatorTree) -> bool {
    return VisitNode(DT.getRootNode(), Register { Reg: 0 });
}

fn shouldSkipLocalDynamicTLS(MF: *mut MachineFunction) -> bool {
    let mut MFI: *mut X86MachineFunctionInfo = MF.getInfo();
    if MFI.getNumLocalDynamicTLSAccesses() < 2 {
        return true;
    }
    return false;
}

fn X86CleanupLocalDynamicTLSLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) || shouldSkipLocalDynamicTLS(MF) {
        return false;
    }
    let mut DT: *mut MachineDominatorTree = self.getAnalysis().getDomTree();
    return cleanupLocalDynamicTLS(DT);
}

fn X86CleanupLocalDynamicTLSPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    if shouldSkipLocalDynamicTLS(MF) {
        return all();
    }
    let mut DT: *mut MachineDominatorTree = MFAM.getResult(MF);
    return if cleanupLocalDynamicTLS(DT) { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}
