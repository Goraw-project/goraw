const BroadcastSizeTable2: [48]X86FoldTableEntry = [VANDNPDZ128rr, VANDNPSZ128rmb, TB_BCAST_SS, VANDNPDZ256rr, VANDNPSZ256rmb, TB_BCAST_SS, VANDNPDZrr, VANDNPSZrmb, TB_BCAST_SS, VANDNPSZ128rr, VANDNPDZ128rmb, TB_BCAST_SD, VANDNPSZ256rr, VANDNPDZ256rmb, TB_BCAST_SD, VANDNPSZrr, VANDNPDZrmb, TB_BCAST_SD, VANDPDZ128rr, VANDPSZ128rmb, TB_BCAST_SS, VANDPDZ256rr, VANDPSZ256rmb, TB_BCAST_SS, VANDPDZrr, VANDPSZrmb, TB_BCAST_SS, VANDPSZ128rr, VANDPDZ128rmb, TB_BCAST_SD, VANDPSZ256rr, VANDPDZ256rmb, TB_BCAST_SD, VANDPSZrr, VANDPDZrmb, TB_BCAST_SD, VORPDZ128rr, VORPSZ128rmb, TB_BCAST_SS, VORPDZ256rr, VORPSZ256rmb, TB_BCAST_SS, VORPDZrr, VORPSZrmb, TB_BCAST_SS, VORPSZ128rr, VORPDZ128rmb, TB_BCAST_SD, VORPSZ256rr, VORPDZ256rmb, TB_BCAST_SD, VORPSZrr, VORPDZrmb, TB_BCAST_SD, VPANDDZ128rr, VPANDQZ128rmb, TB_BCAST_Q, VPANDDZ256rr, VPANDQZ256rmb, TB_BCAST_Q, VPANDDZrr, VPANDQZrmb, TB_BCAST_Q, VPANDNDZ128rr, VPANDNQZ128rmb, TB_BCAST_Q, VPANDNDZ256rr, VPANDNQZ256rmb, TB_BCAST_Q, VPANDNDZrr, VPANDNQZrmb, TB_BCAST_Q, VPANDNQZ128rr, VPANDNDZ128rmb, TB_BCAST_D, VPANDNQZ256rr, VPANDNDZ256rmb, TB_BCAST_D, VPANDNQZrr, VPANDNDZrmb, TB_BCAST_D, VPANDQZ128rr, VPANDDZ128rmb, TB_BCAST_D, VPANDQZ256rr, VPANDDZ256rmb, TB_BCAST_D, VPANDQZrr, VPANDDZrmb, TB_BCAST_D, VPORDZ128rr, VPORQZ128rmb, TB_BCAST_Q, VPORDZ256rr, VPORQZ256rmb, TB_BCAST_Q, VPORDZrr, VPORQZrmb, TB_BCAST_Q, VPORQZ128rr, VPORDZ128rmb, TB_BCAST_D, VPORQZ256rr, VPORDZ256rmb, TB_BCAST_D, VPORQZrr, VPORDZrmb, TB_BCAST_D, VPXORDZ128rr, VPXORQZ128rmb, TB_BCAST_Q, VPXORDZ256rr, VPXORQZ256rmb, TB_BCAST_Q, VPXORDZrr, VPXORQZrmb, TB_BCAST_Q, VPXORQZ128rr, VPXORDZ128rmb, TB_BCAST_D, VPXORQZ256rr, VPXORDZ256rmb, TB_BCAST_D, VPXORQZrr, VPXORDZrmb, TB_BCAST_D, VXORPDZ128rr, VXORPSZ128rmb, TB_BCAST_SS, VXORPDZ256rr, VXORPSZ256rmb, TB_BCAST_SS, VXORPDZrr, VXORPSZrmb, TB_BCAST_SS, VXORPSZ128rr, VXORPDZ128rmb, TB_BCAST_SD, VXORPSZ256rr, VXORPDZ256rmb, TB_BCAST_SD, VXORPSZrr, VXORPDZrmb, TB_BCAST_SD];

const BroadcastSizeTable3: [6]X86FoldTableEntry = [VPTERNLOGDZ128rri, VPTERNLOGQZ128rmbi, TB_BCAST_Q, VPTERNLOGDZ256rri, VPTERNLOGQZ256rmbi, TB_BCAST_Q, VPTERNLOGDZrri, VPTERNLOGQZrmbi, TB_BCAST_Q, VPTERNLOGQZ128rri, VPTERNLOGDZ128rmbi, TB_BCAST_D, VPTERNLOGQZ256rri, VPTERNLOGDZ256rmbi, TB_BCAST_D, VPTERNLOGQZrri, VPTERNLOGDZrmbi, TB_BCAST_D];

fn lookupFoldTableImpl(Table: ArrayRef<X86FoldTableEntry>, RegOp: u32) -> *X86FoldTableEntry {
    let mut FoldTablesChecked: atomic<bool> = false;
    if !FoldTablesChecked.load(memory_order_relaxed) {
        assert!(is_sorted(Table2Addr), "Table2Addr is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "Table2Addr is not unique");
        assert!(is_sorted(Table0), "Table0 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "Table0 is not unique");
        assert!(is_sorted(Table1), "Table1 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "Table1 is not unique");
        assert!(is_sorted(Table2), "Table2 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "Table2 is not unique");
        assert!(is_sorted(Table3), "Table3 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "Table3 is not unique");
        assert!(is_sorted(Table4), "Table4 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "Table4 is not unique");
        assert!(is_sorted(BroadcastTable1), "BroadcastTable1 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "BroadcastTable1 is not unique");
        assert!(is_sorted(BroadcastTable2), "BroadcastTable2 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "BroadcastTable2 is not unique");
        assert!(is_sorted(BroadcastTable3), "BroadcastTable3 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "BroadcastTable3 is not unique");
        assert!(is_sorted(BroadcastTable4), "BroadcastTable4 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "BroadcastTable4 is not unique");
        assert!(is_sorted(BroadcastSizeTable2), "BroadcastSizeTable2 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "BroadcastSizeTable2 is not unique");
        assert!(is_sorted(BroadcastSizeTable3), "BroadcastSizeTable3 is not sorted");
        assert!(adjacent_find(begin(Table), end(Table)) == end(Table), "BroadcastSizeTable3 is not unique");
        FoldTablesChecked.store(true, memory_order_relaxed);
    }
    let mut Data: *X86FoldTableEntry = lower_bound(Table, RegOp);
    if Data != Table.end() && Data.KeyOp == RegOp && !(Data.Flags & TB_NO_FORWARD) {
        return Data;
    }
    return null;
}

fn lookupTwoAddrFoldTable(RegOp: u32) -> *X86FoldTableEntry {
    return lookupFoldTableImpl(Table2Addr, RegOp);
}

fn lookupFoldTable(RegOp: u32, OpNum: u32) -> *X86FoldTableEntry {
    let mut FoldTable: ArrayRef<X86FoldTableEntry> = ArrayRef<X86FoldTableEntry> {};
    if OpNum == 0 {
        FoldTable = Table0;
    } else if OpNum == 1 {
        FoldTable = Table1;
    } else if OpNum == 2 {
        FoldTable = Table2;
    } else if OpNum == 3 {
        FoldTable = Table3;
    } else if OpNum == 4 {
        FoldTable = Table4;
    } else {
        return null;
    }
    return lookupFoldTableImpl(FoldTable, RegOp);
}

fn isNonFoldableWithSameMask(RegOp: u32) -> bool {
    let mut Table: ArrayRef<unsigned int> = NonFoldableWithSameMaskTable;
    let mut I: *u32 = lower_bound(Table, RegOp);
    return I != Table.end() && *I == RegOp;
}

fn lookupBroadcastFoldTable(RegOp: u32, OpNum: u32) -> *X86FoldTableEntry {
    let mut FoldTable: ArrayRef<X86FoldTableEntry> = ArrayRef<X86FoldTableEntry> {};
    if OpNum == 1 {
        FoldTable = BroadcastTable1;
    } else if OpNum == 2 {
        FoldTable = BroadcastTable2;
    } else if OpNum == 3 {
        FoldTable = BroadcastTable3;
    } else if OpNum == 4 {
        FoldTable = BroadcastTable4;
    } else {
        return null;
    }
    return lookupFoldTableImpl(FoldTable, RegOp);
}

struct X86MemUnfoldTable {
    Table: []X86FoldTableEntry,
}

fn X86MemUnfoldTable::X86MemUnfoldTable(self) {
    for Entry in Table2Addr[..] {
        self.addTableEntry(Entry, TB_INDEX_0 | TB_FOLDED_LOAD | TB_FOLDED_STORE);
    }
    for Entry in Table0[..] {
        self.addTableEntry(Entry, TB_INDEX_0);
    }
    for Entry in Table1[..] {
        self.addTableEntry(Entry, TB_INDEX_1 | TB_FOLDED_LOAD);
    }
    for Entry in Table2[..] {
        self.addTableEntry(Entry, TB_INDEX_2 | TB_FOLDED_LOAD);
    }
    for Entry in Table3[..] {
        self.addTableEntry(Entry, TB_INDEX_3 | TB_FOLDED_LOAD);
    }
    for Entry in Table4[..] {
        self.addTableEntry(Entry, TB_INDEX_4 | TB_FOLDED_LOAD);
    }
    for Entry in BroadcastTable1[..] {
        self.addTableEntry(Entry, TB_INDEX_1 | TB_FOLDED_LOAD);
    }
    for Entry in BroadcastTable2[..] {
        self.addTableEntry(Entry, TB_INDEX_2 | TB_FOLDED_LOAD);
    }
    for Entry in BroadcastTable3[..] {
        self.addTableEntry(Entry, TB_INDEX_3 | TB_FOLDED_LOAD);
    }
    for Entry in BroadcastTable4[..] {
        self.addTableEntry(Entry, TB_INDEX_4 | TB_FOLDED_LOAD);
    }
    array_pod_sort(self.Table.begin(), self.Table.end());
    assert!(adjacent_find(self.Table.begin(), self.Table.end()) == self.Table.end(), "Memory unfolding table is not unique!");
}

fn X86MemUnfoldTable::addTableEntry(self, Entry: *X86FoldTableEntry, ExtraFlags: u16) {
    if (Entry.Flags & TB_NO_REVERSE) == 0 {
        self.Table.push(X86FoldTableEntry { KeyOp: Entry.DstOp, DstOp: Entry.KeyOp, Flags: Entry.Flags | ExtraFlags as u16 });
    }
}

fn lookupUnfoldTable(MemOp: u32) -> *X86FoldTableEntry {
    let mut MemUnfoldTable: X86MemUnfoldTable = X86MemUnfoldTable {};
    let mut Table: *mut []X86FoldTableEntry = MemUnfoldTable.Table;
    let mut I: X86FoldTableEntry>>> = lower_bound(Table, MemOp);
    if !I == Table.end() && operator(I).KeyOp == MemOp {
        return &mut operator(I);
    }
    return null;
}

struct X86BroadcastFoldTable {
    Table: []X86FoldTableEntry,
}

fn X86BroadcastFoldTable::X86BroadcastFoldTable(self) {
    for Reg2Bcst in BroadcastTable2[..] {
        let mut RegOp: u32 = Reg2Bcst.KeyOp;
        let mut BcstOp: u32 = Reg2Bcst.DstOp;
        if lookupFoldTable(RegOp, 2) {
            Reg2Mem;
        } else {
            let mut MemOp: u32 = Reg2Mem.DstOp;
            let mut Flags: u16 = Reg2Mem.Flags | Reg2Bcst.Flags | TB_INDEX_2 | TB_FOLDED_LOAD;
            self.Table.push(X86FoldTableEntry { KeyOp: MemOp, DstOp: BcstOp, Flags: Flags });
        }
    }
    for Reg2Bcst in BroadcastSizeTable2[..] {
        let mut RegOp: u32 = Reg2Bcst.KeyOp;
        let mut BcstOp: u32 = Reg2Bcst.DstOp;
        if lookupFoldTable(RegOp, 2) {
            Reg2Mem;
        } else {
            let mut MemOp: u32 = Reg2Mem.DstOp;
            let mut Flags: u16 = Reg2Mem.Flags | Reg2Bcst.Flags | TB_INDEX_2 | TB_FOLDED_LOAD;
            self.Table.push(X86FoldTableEntry { KeyOp: MemOp, DstOp: BcstOp, Flags: Flags });
        }
    }
    for Reg2Bcst in BroadcastTable3[..] {
        let mut RegOp: u32 = Reg2Bcst.KeyOp;
        let mut BcstOp: u32 = Reg2Bcst.DstOp;
        if lookupFoldTable(RegOp, 3) {
            Reg2Mem;
        } else {
            let mut MemOp: u32 = Reg2Mem.DstOp;
            let mut Flags: u16 = Reg2Mem.Flags | Reg2Bcst.Flags | TB_INDEX_3 | TB_FOLDED_LOAD;
            self.Table.push(X86FoldTableEntry { KeyOp: MemOp, DstOp: BcstOp, Flags: Flags });
        }
    }
    for Reg2Bcst in BroadcastSizeTable3[..] {
        let mut RegOp: u32 = Reg2Bcst.KeyOp;
        let mut BcstOp: u32 = Reg2Bcst.DstOp;
        if lookupFoldTable(RegOp, 3) {
            Reg2Mem;
        } else {
            let mut MemOp: u32 = Reg2Mem.DstOp;
            let mut Flags: u16 = Reg2Mem.Flags | Reg2Bcst.Flags | TB_INDEX_3 | TB_FOLDED_LOAD;
            self.Table.push(X86FoldTableEntry { KeyOp: MemOp, DstOp: BcstOp, Flags: Flags });
        }
    }
    for Reg2Bcst in BroadcastTable4[..] {
        let mut RegOp: u32 = Reg2Bcst.KeyOp;
        let mut BcstOp: u32 = Reg2Bcst.DstOp;
        if lookupFoldTable(RegOp, 4) {
            Reg2Mem;
        } else {
            let mut MemOp: u32 = Reg2Mem.DstOp;
            let mut Flags: u16 = Reg2Mem.Flags | Reg2Bcst.Flags | TB_INDEX_4 | TB_FOLDED_LOAD;
            self.Table.push(X86FoldTableEntry { KeyOp: MemOp, DstOp: BcstOp, Flags: Flags });
        }
    }
    array_pod_sort(self.Table.begin(), self.Table.end());
}

fn matchBroadcastSize(Entry: *X86FoldTableEntry, BroadcastBits: u32) -> bool {
    match Entry.Flags & TB_BCAST_MASK {
        TB_BCAST_W => {
            TB_BCAST_SH;
        },
        TB_BCAST_D => {
            TB_BCAST_SS;
        },
        TB_BCAST_Q => {
            TB_BCAST_SD;
        },
    }
    return false;
}

fn lookupBroadcastFoldTableBySize(MemOp: u32, BroadcastBits: u32) -> *X86FoldTableEntry {
    let mut BroadcastFoldTable: X86BroadcastFoldTable = X86BroadcastFoldTable {};
    let mut Table: *mut []X86FoldTableEntry = BroadcastFoldTable.Table;
    for let mut I: X86FoldTableEntry>>> = lower_bound(Table, MemOp); !I == Table.end() && operator(I).KeyOp == MemOp; operator(I) {
        if matchBroadcastSize(operator(I), BroadcastBits) {
            return &mut operator(I);
        }
    }
    return null;
}
