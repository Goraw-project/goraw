struct X86MemUnfoldTable {
    Table: i32,
}

fn X86MemUnfoldTable::X86MemUnfoldTable(self) {
    array_pod_sort();
}

fn X86MemUnfoldTable::addTableEntry(self, Entry: *X86FoldTableEntry, ExtraFlags: u16) {}

fn lookupUnfoldTable(MemOp: u32) -> *X86FoldTableEntry {
    let mut MemUnfoldTable: X86MemUnfoldTable = X86MemUnfoldTable {};
    let mut Table: *mut auto = MemUnfoldTable();
    let mut I: auto = lower_bound(MemOp);
    if I() != () &&  == MemOp {
        return operator&(operator*());
    }
    return null;
}

struct X86BroadcastFoldTable {
    Table: i32,
}

fn X86BroadcastFoldTable::X86BroadcastFoldTable(self) {
    array_pod_sort();
}

fn matchBroadcastSize(Entry: *X86FoldTableEntry, BroadcastBits: u32) -> bool {
    match Entry.Flags & TB_BCAST_MASK {
        TB_BCAST_W => {
            TB_BCAST_SH;
        },
        TB_BCAST_D => {
            TB_BCAST_SS;
        },
        TB_BCAST_Q => {
            TB_BCAST_SD;
        },
    }
    return false;
}

fn lookupBroadcastFoldTableBySize(MemOp: u32, BroadcastBits: u32) -> *X86FoldTableEntry {
    let mut BroadcastFoldTable: X86BroadcastFoldTable = X86BroadcastFoldTable {};
    let mut Table: *mut auto = BroadcastFoldTable();
    for let mut I: auto = lower_bound(MemOp); I() != () &&  == MemOp;  += 1 {
        if matchBroadcastSize(operator*(), BroadcastBits) {
            return operator&(operator*());
        }
    }
    return null;
}
