fn X86_64MachoTargetObjectFile::getTTypeGlobalReference(self: *X86_64MachoTargetObjectFile, GV: *GlobalValue, Encoding: u32, TM: *TargetMachine, MMI: *mut MachineModuleInfo, Streamer: *mut MCStreamer) -> *MCExpr {
    if (Encoding & DW_EH_PE_indirect) && (Encoding & DW_EH_PE_pcrel) {
        let mut Sym: *MCSymbol = TM.getSymbol(GV);
        let mut Res: *MCExpr = create(Sym, S_GOTPCREL, self.getContext(), SMLoc {});
        let mut Four: *MCExpr = create(4, self.getContext(), false, 0);
        return createAdd(Res, Four, self.getContext(), SMLoc {});
    }
    return self.getTTypeGlobalReference(GV, Encoding, TM, MMI, Streamer);
}

fn X86_64MachoTargetObjectFile::getCFIPersonalitySymbol(self: *X86_64MachoTargetObjectFile, GV: *GlobalValue, TM: *TargetMachine, MMI: *mut MachineModuleInfo) -> *mut MCSymbol {
    return TM.getSymbol(GV);
}

fn X86_64MachoTargetObjectFile::getIndirectSymViaGOTPCRel(self: *X86_64MachoTargetObjectFile, GV: *GlobalValue, Sym: *MCSymbol, MV: *MCValue, Offset: i64, MMI: *mut MachineModuleInfo, Streamer: *mut MCStreamer) -> *MCExpr {
    let mut FinalOff: u32 = Offset + MV.getConstant() + 4;
    let mut Res: *MCExpr = create(Sym, S_GOTPCREL, self.getContext(), SMLoc {});
    let mut Off: *MCExpr = create(FinalOff, self.getContext(), false, 0);
    return createAdd(Res, Off, self.getContext(), SMLoc {});
}

fn X86ELFTargetObjectFile::X86ELFTargetObjectFile(self) {
    self.PLTRelativeSpecifier = S_PLT;
}

fn X86ELFTargetObjectFile::getDebugThreadLocalSymbol(self: *X86ELFTargetObjectFile, Sym: *MCSymbol) -> *MCExpr {
    return create(Sym, S_DTPOFF, self.getContext(), SMLoc {});
}

fn X86_64ELFTargetObjectFile::getIndirectSymViaGOTPCRel(self: *X86_64ELFTargetObjectFile, GV: *GlobalValue, Sym: *MCSymbol, MV: *MCValue, Offset: i64, MMI: *mut MachineModuleInfo, Streamer: *mut MCStreamer) -> *MCExpr {
    let mut FinalOffset: i64 = Offset + MV.getConstant();
    let mut Res: *MCExpr = create(Sym, S_GOTPCREL, self.getContext(), SMLoc {});
    let mut Off: *MCExpr = create(FinalOffset, self.getContext(), false, 0);
    return createAdd(Res, Off, self.getContext(), SMLoc {});
}
