struct X86AvoidTrailingCallLegacyPass {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86AvoidTrailingCallLegacyPass::getPassName(self: *X86AvoidTrailingCallLegacyPass) -> str {
    return "X86 avoid trailing call pass";
}

fn X86AvoidTrailingCallLegacyPass::getPassKind(self: *X86AvoidTrailingCallLegacyPass) -> PassKind {
    return self.Kind;
}

fn X86AvoidTrailingCallLegacyPass::getPassID(self: *X86AvoidTrailingCallLegacyPass) -> AnalysisID {
    return self.PassID;
}

fn X86AvoidTrailingCallLegacyPass::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86AvoidTrailingCallLegacyPass::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86AvoidTrailingCallLegacyPass::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86AvoidTrailingCallLegacyPass::getResolver(self: *X86AvoidTrailingCallLegacyPass) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86AvoidTrailingCallLegacyPass::getRequiredProperties(self: *X86AvoidTrailingCallLegacyPass) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86AvoidTrailingCallLegacyPass::getSetProperties(self: *X86AvoidTrailingCallLegacyPass) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86AvoidTrailingCallLegacyPass::getClearedProperties(self: *X86AvoidTrailingCallLegacyPass) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86AvoidTrailingCallLegacyPass() -> *mut FunctionPass {
    return X86AvoidTrailingCallLegacyPass {};
}

fn isCallOrRealInstruction(MI: *mut MachineInstr) -> bool {
    return MI.isCall(AnyInBundle) || (!MI.isPseudo(IgnoreBundle) && !MI.isMetaInstruction(IgnoreBundle));
}

fn isCallInstruction(MI: *MachineInstr) -> bool {
    return MI.isCall(AnyInBundle) && !MI.isReturn(AnyInBundle);
}

fn UpdatedOnX86AvoidTrailingCallPass(MF: *mut MachineFunction) -> bool {
    let mut STI: *X86Subtarget = MF;
    let mut TII: *X86InstrInfo = *STI.getInstrInfo();
    assert!(STI.isTargetWin64(), "pass only runs on Win64");
    if !MF.hasWinCFI() {
        return false;
    }
    let mut Changed: bool = false;
    for MBB in MF {
        let mut NextMBB: *mut MachineBasicBlock = MBB.getNextNode();
        if NextMBB && !NextMBB.isEHFuncletEntry() {
            continue;
        }
        let mut LastRealInstr: auto = find_if(reverse(MBB), isCallOrRealInstruction);
        let mut IsEmpty: bool =  == MBB.rend();
        let mut IsCall: bool = !IsEmpty && isCallInstruction(operator*());
        if IsEmpty || IsCall {
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-avoid-trailing-call", 1) {
                    {
                        if IsCall {
                            dbgs() << "inserting int3 after trailing call instruction:\n";
                            LastRealInstr()();
                            dbgs() << 10;
                        } else {
                            dbgs() << "inserting int3 in trailing empty MBB:\n";
                            MBB.dump();
                        }
                    }
                }
            }
                if !(false) { break; }
            }
            let mut MBBI: iterator = MBB.end();
            let mut DL: DebugLoc = DebugLoc { Loc: null };
            if IsCall {
                MBBI = next();
                DL = ();
            }
            BuildMI(MBB, MBBI, DL, TII());
            Changed = true;
        }
    }
    return Changed;
}

fn X86AvoidTrailingCallLegacyPass::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return UpdatedOnX86AvoidTrailingCallPass(MF);
}

fn X86AvoidTrailingCallPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = UpdatedOnX86AvoidTrailingCallPass(MF);
    if !Changed {
        return all();
    }
    return getMachineFunctionPassPreservedAnalyses();
}
