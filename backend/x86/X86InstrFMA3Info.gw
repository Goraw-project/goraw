const Groups: []X86InstrFMA3Group = zeroed();

const BroadcastGroups: []X86InstrFMA3Group = zeroed();

const RoundGroups: []X86InstrFMA3Group = zeroed();

fn verifyTables() {
    let mut TableChecked: atomic<bool> = zeroed();
    if operator!((memory_order_relaxed)) {
        assert!(is_sorted(Groups) && is_sorted(RoundGroups) && is_sorted(BroadcastGroups), "FMA3 tables not sorted!");
        TableChecked()(true, memory_order_relaxed);
    }
}

fn getFMA3Group(Opcode: u32, TSFlags: u64) -> *X86InstrFMA3Group {
    let mut BaseOpcode: u8 = getBaseOpcodeFor(TSFlags);
    let mut IsFMA3Opcode: bool = ((BaseOpcode >= 150 && BaseOpcode <= 159) || (BaseOpcode >= 166 && BaseOpcode <= 175) || (BaseOpcode >= 182 && BaseOpcode <= 191));
    let mut IsFMA3Encoding: bool = ((TSFlags & EncodingMask) == VEX && (TSFlags & OpMapMask) == T8) || ((TSFlags & EncodingMask) == EVEX && ((TSFlags & OpMapMask) == T8 || (TSFlags & OpMapMask) == T_MAP6));
    let mut IsFMA3Prefix: bool = (TSFlags & OpPrefixMask) == PD || (TSFlags & OpPrefixMask) == 0;
    if !IsFMA3Opcode || !IsFMA3Encoding || !IsFMA3Prefix {
        return null;
    }
    verifyTables();
    let mut Table: ArrayRef<X86InstrFMA3Group> = zeroed();
    if TSFlags & EVEX_RC {
        Table() = RoundGroups();
    } else if TSFlags & EVEX_B {
        Table() = BroadcastGroups();
    } else {
        Table() = Groups();
    }
    let mut FormIndex: u32 = ((BaseOpcode - 144) >> 4) & 3;
    let mut I: auto = partition_point(Closure_1 { FormIndex: FormIndex, Opcode: Opcode });
    (((operator!(operator!((I() != () && [FormIndex] == Opcode && "Couldn't find FMA3 opcode!")))) || (_wassert(L"I != Table.end() && I->Opcodes[FormIndex] == Opcode && \"Couldn't find FMA3 opcode!\"", L"llvm\\lib\\Target\\X86\\X86InstrFMA3Info.cpp", (191) as u32) , 0)) as void);
    return ;
}

struct Closure_1 {
    FormIndex: u32,
    Opcode: u32,
}

fn Closure_1::call(self: *Closure_1, Group: *X86InstrFMA3Group) -> bool {
        return Group.Opcodes[self.FormIndex] < self.Opcode;
    }
