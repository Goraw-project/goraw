32SSZrbkz_Int, VFNMADD213SSZrbkz_Int, VFNMADD231SSZrbkz_Int], Intrinsic | KZeroMasked, [VFNMSUB132PDZrb, VFNMSUB213PDZrb, VFNMSUB231PDZrb], 0, [VFNMSUB132PDZrbk, VFNMSUB213PDZrbk, VFNMSUB231PDZrbk], 0 | KMergeMasked, [VFNMSUB132PDZrbkz, VFNMSUB213PDZrbkz, VFNMSUB231PDZrbkz], 0 | KZeroMasked, [VFNMSUB132PHZrb, VFNMSUB213PHZrb, VFNMSUB231PHZrb], 0, [VFNMSUB132PHZrbk, VFNMSUB213PHZrbk, VFNMSUB231PHZrbk], 0 | KMergeMasked, [VFNMSUB132PHZrbkz, VFNMSUB213PHZrbkz, VFNMSUB231PHZrbkz], 0 | KZeroMasked, [VFNMSUB132PSZrb, VFNMSUB213PSZrb, VFNMSUB231PSZrb], 0, [VFNMSUB132PSZrbk, VFNMSUB213PSZrbk, VFNMSUB231PSZrbk], 0 | KMergeMasked, [VFNMSUB132PSZrbkz, VFNMSUB213PSZrbkz, VFNMSUB231PSZrbkz], 0 | KZeroMasked, [VFNMSUB132SDZrb, VFNMSUB213SDZrb, VFNMSUB231SDZrb], Intrinsic, [VFNMSUB132SDZrb_Int, VFNMSUB213SDZrb_Int, VFNMSUB231SDZrb_Int], Intrinsic, [VFNMSUB132SDZrbk_Int, VFNMSUB213SDZrbk_Int, VFNMSUB231SDZrbk_Int], Intrinsic | KMergeMasked, [VFNMSUB132SDZrbkz_Int, VFNMSUB213SDZrbkz_Int, VFNMSUB231SDZrbkz_Int], Intrinsic | KZeroMasked, [VFNMSUB132SHZrb, VFNMSUB213SHZrb, VFNMSUB231SHZrb], Intrinsic, [VFNMSUB132SHZrb_Int, VFNMSUB213SHZrb_Int, VFNMSUB231SHZrb_Int], Intrinsic, [VFNMSUB132SHZrbk_Int, VFNMSUB213SHZrbk_Int, VFNMSUB231SHZrbk_Int], Intrinsic | KMergeMasked, [VFNMSUB132SHZrbkz_Int, VFNMSUB213SHZrbkz_Int, VFNMSUB231SHZrbkz_Int], Intrinsic | KZeroMasked, [VFNMSUB132SSZrb, VFNMSUB213SSZrb, VFNMSUB231SSZrb], Intrinsic, [VFNMSUB132SSZrb_Int, VFNMSUB213SSZrb_Int, VFNMSUB231SSZrb_Int], Intrinsic, [VFNMSUB132SSZrbk_Int, VFNMSUB213SSZrbk_Int, VFNMSUB231SSZrbk_Int], Intrinsic | KMergeMasked, [VFNMSUB132SSZrbkz_Int, VFNMSUB213SSZrbkz_Int, VFNMSUB231SSZrbkz_Int], Intrinsic | KZeroMasked];

fn verifyTables() {
    let mut TableChecked: atomic<bool> = false;
    if !TableChecked.load(memory_order_relaxed) {
        assert!(is_sorted(Groups) && is_sorted(RoundGroups) && is_sorted(BroadcastGroups), "FMA3 tables not sorted!");
        TableChecked.store(true, memory_order_relaxed);
    }
}

fn getFMA3Group(Opcode: u32, TSFlags: u64) -> *X86InstrFMA3Group {
    let mut BaseOpcode: u8 = getBaseOpcodeFor(TSFlags);
    let mut IsFMA3Opcode: bool = ((BaseOpcode >= 150 && BaseOpcode <= 159) || (BaseOpcode >= 166 && BaseOpcode <= 175) || (BaseOpcode >= 182 && BaseOpcode <= 191));
    let mut IsFMA3Encoding: bool = ((TSFlags & EncodingMask) == VEX && (TSFlags & OpMapMask) == T8) || ((TSFlags & EncodingMask) == EVEX && ((TSFlags & OpMapMask) == T8 || (TSFlags & OpMapMask) == T_MAP6));
    let mut IsFMA3Prefix: bool = (TSFlags & OpPrefixMask) == PD || (TSFlags & OpPrefixMask) == 0;
    if !IsFMA3Opcode || !IsFMA3Encoding || !IsFMA3Prefix {
        return null;
    }
    verifyTables();
    let mut Table: ArrayRef<X86InstrFMA3Group> = ArrayRef<X86InstrFMA3Group> {};
    if TSFlags & EVEX_RC {
        Table = RoundGroups;
    } else if TSFlags & EVEX_B {
        Table = BroadcastGroups;
    } else {
        Table = Groups;
    }
    let mut FormIndex: u32 = ((BaseOpcode - 144) >> 4) & 3;
    let mut I: *X86InstrFMA3Group = partition_point(Table, Closure_1 { FormIndex: FormIndex, Opcode: Opcode });
    assert!(I != Table.end() && I.Opcodes[FormIndex] == Opcode, "Couldn't find FMA3 opcode!");
    return I;
}

struct Closure_1 {
    FormIndex: u32,
    Opcode: u32,
}

fn Closure_1::call(self: *Closure_1, Group: *X86InstrFMA3Group) -> bool {
        return Group.Opcodes[self.FormIndex] < self.Opcode;
    }
