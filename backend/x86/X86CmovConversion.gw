fn getDepthOfOptCmov(TrueOpDepth: u32, FalseOpDepth: u32) -> u32 {
    return max(divideCeil(TrueOpDepth * 3 + FalseOpDepth, 4), divideCeil(FalseOpDepth * 3 + TrueOpDepth, 4));
}

