fn createX86CmovConversionLegacyPass() -> *mut FunctionPass {
    return X86CmovConversionLegacy {};
}

fn X86CmovConversionLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut MLI: *mut MachineLoopInfo = operator&();
    let mut Impl: X86CmovConversionImpl = X86CmovConversionImpl { MLI };
    return Impl.runOnMachineFunction(MF);
}

fn X86CmovConversionPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut MLI: *mut MachineLoopInfo = operator&(MFAM);
    let mut Impl: X86CmovConversionImpl = X86CmovConversionImpl { MLI };
    let mut Changed: bool = Impl.runOnMachineFunction(MF);
    return if Changed { getMachineFunctionPassPreservedAnalyses() } else { all() };
}

