struct Closure_3 {}

fn Closure_3::call(self: *Closure_3, Name: str, PM: *mut ModulePassManager, arg: PipelineElement>) -> bool {
        if Name == "x86-asm-printer-begin" {
            PM.addPass(X86AsmPrinterBeginPass {});
            return true;
        }
        if Name == "x86-asm-printer-end" {
            PM.addPass(X86AsmPrinterEndPass {});
            return true;
        }
        if Name == "x86-winehstate" {
            PM.addPass(X86WinEHStatePass {});
            return true;
        }
        return false;
    }

