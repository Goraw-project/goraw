static mut X86EnableMachineCombinerPass: opt<bool> = zeroed();

struct X86CodeGenPassBuilder {
    TM: *mut TargetMachine,
    Opt: CGPassBuilderOption,
    PIC: *mut PassInstrumentationCallbacks,
    BeforeCallbacks: unique_function<bool (StringRef)>, 4>,
    AfterCallbacks: unique_function<void (StringRef, MachineFunctionPassManager &)>, 4>,
    Started: bool,
    Stopped: bool,
    AddInCGSCCOrder: bool,
}

fn X86CodeGenPassBuilder::getTM(self: *X86CodeGenPassBuilder) -> *mut X86TargetMachine {
    return self.TM as X86TargetMachine;
}

fn X86CodeGenPassBuilder::getPassInstrumentationCallbacks(self: *X86CodeGenPassBuilder) -> *mut PassInstrumentationCallbacks {
    return self.PIC;
}

fn X86CodeGenPassBuilder::requireCGSCCOrder(self, PMW: *mut PassManagerWrapper) {
    assert!(!self.AddInCGSCCOrder);
    assert!(PMW.FPM.isEmpty() && PMW.MFPM.isEmpty(), "Requiring CGSCC ordering requires flushing the current function pipelines to the MPM.");
    self.AddInCGSCCOrder = true;
}

fn X86CodeGenPassBuilder::stopAddingInCGSCCOrder(self, PMW: *mut PassManagerWrapper) {
    assert!(self.AddInCGSCCOrder);
    assert!(PMW.FPM.isEmpty() && PMW.MFPM.isEmpty(), "Stopping CGSCC ordering requires flushing the current function pipelines to the MPM.");
    self.AddInCGSCCOrder = false;
}

fn X86CodeGenPassBuilder::getOptLevel(self: *X86CodeGenPassBuilder) -> CodeGenOptLevel {
    return self.TM.getOptLevel();
}

fn X86CodeGenPassBuilder::isGlobalISelAbortEnabled(self: *X86CodeGenPassBuilder) -> bool {
    return self.TM.Options.GlobalISelAbort == Enable;
}

fn X86CodeGenPassBuilder::reportDiagnosticWhenGlobalISelFallback(self: *X86CodeGenPassBuilder) -> bool {
    return self.TM.Options.GlobalISelAbort == DisableWithDiag;
}

fn X86CodeGenPassBuilder::addGlobalMergePass(self, PMW: *mut PassManagerWrapper) {}

fn X86CodeGenPassBuilder::addPreRewrite(self, PMW: *mut PassManagerWrapper) {}

fn X86CodeGenPassBuilder::addPostRewrite(self, PMW: *mut PassManagerWrapper) {}

fn X86CodeGenPassBuilder::addPreGlobalInstructionSelect(self, PMW: *mut PassManagerWrapper) {}

fn X86CodeGenPassBuilder::addGCPasses(self, PMW: *mut PassManagerWrapper) {}

fn X86CodeGenPassBuilder::addPostBBSections(self, PMW: *mut PassManagerWrapper) {}

fn X86CodeGenPassBuilder::runBeforeAdding(self, Name: str) -> bool {
    let mut ShouldAdd: bool = true;
    for C in self.BeforeCallbacks {
        ShouldAdd &= C.call(Name);
    }
    return ShouldAdd;
}

fn X86CodeGenPassBuilder::addIRPasses(self, PMW: *mut PassManagerWrapper) {
    self.addFunctionPass(self.TM, PMW, false, name());
    self.addFunctionPass(&mut self.TM, PMW, false, name());
    self.addFunctionPass(&mut self.TM, PMW, false, name());
    self.addIRPasses(PMW);
    if self.getOptLevel() != None {
        self.addFunctionPass(self.TM, PMW, false, name());
        self.addFunctionPass(&mut self.getTM(), PMW, false, name());
    }
    self.addFunctionPass(self.TM, PMW, false, name());
    let mut TT: *Triple = self.TM.getTargetTriple();
    if TT.isOSWindows() {
        self.addFunctionPass(CFGuardPass {}, PMW, false, name());
    }
    if self.TM.Options.JMCInstrument {
        self.flushFPMsToMPM(PMW, false);
        self.addModulePass(JMCInstrumenterPass {}, PMW, false, name());
    }
}

fn X86CodeGenPassBuilder::addPreISel(self, PMW: *mut PassManagerWrapper) {
    let mut TT: *Triple = self.TM.getTargetTriple();
    if TT.isOSWindows() && TT.isX86_32() {
        self.flushFPMsToMPM(PMW, false);
        self.addModulePass(X86WinEHStatePass {}, PMW, false, name());
    }
}

fn X86CodeGenPassBuilder::addInstSelector(self, PMW: *mut PassManagerWrapper) -> Error {
    self.addMachineFunctionPass(self.getTM(), PMW, false, name());
    if self.TM.getTargetTriple().isOSBinFormatELF() && self.getOptLevel() != None {
        self.addMachineFunctionPass(X86CleanupLocalDynamicTLSPass {}, PMW, false, name());
    }
    self.addMachineFunctionPass(X86GlobalBaseRegPass {}, PMW, false, name());
    self.addMachineFunctionPass(X86ArgumentStackSlotPass {}, PMW, false, name());
    return success();
}

fn X86CodeGenPassBuilder::addIRTranslator(self, PMW: *mut PassManagerWrapper) -> Error {
    self.addMachineFunctionPass(self.getOptLevel(), PMW, false, name());
    return success();
}

fn X86CodeGenPassBuilder::addPreLegalizeMachineIR(self, PMW: *mut PassManagerWrapper) {
    if self.getOptLevel() != None {
        self.addMachineFunctionPass(X86PreLegalizerCombinerPass {}, PMW, false, name());
    }
}

fn X86CodeGenPassBuilder::addLegalizeMachineIR(self, PMW: *mut PassManagerWrapper) -> Error {
    self.addMachineFunctionPass(LegalizerPass {}, PMW, false, name());
    return success();
}

fn X86CodeGenPassBuilder::addPreRegBankSelect(self, PMW: *mut PassManagerWrapper) {
    if self.getOptLevel() != None {
        self.addMachineFunctionPass(X86PostLegalizerCombinerPass {}, PMW, false, name());
    }
}

fn X86CodeGenPassBuilder::addRegBankSelect(self, PMW: *mut PassManagerWrapper) -> Error {
    self.addMachineFunctionPass(RegBankSelectPass { OptMode: Fast }, PMW, false, name());
    return success();
}

fn X86CodeGenPassBuilder::addGlobalInstructionSelect(self, PMW: *mut PassManagerWrapper) -> Error {
    self.addMachineFunctionPass(InstructionSelectPass { OptLevel: self.getOptLevel(), RequireRegBankSelection: true }, PMW, false, name());
    if self.isGlobalISelAbortEnabled() {
        self.addMachineFunctionPass(X86GlobalBaseRegPass {}, PMW, false, name());
    }
    return success();
}

fn X86CodeGenPassBuilder::addILPOpts(self, PMW: *mut PassManagerWrapper) {
    self.addMachineFunctionPass(EarlyIfConverterPass {}, PMW, false, name());
    if X86EnableMachineCombinerPass {
        self.addMachineFunctionPass(MachineCombinerPass {}, PMW, false, name());
    }
    self.addMachineFunctionPass(X86CmovConversionPass {}, PMW, false, name());
}

fn X86CodeGenPassBuilder::addMachineSSAOptimization(self, PMW: *mut PassManagerWrapper) {
    self.addMachineFunctionPass(X86DomainReassignmentPass {}, PMW, false, name());
    self.addMachineSSAOptimization(PMW);
}

fn X86CodeGenPassBuilder::addPreRegAlloc(self, PMW: *mut PassManagerWrapper) {
    if self.getOptLevel() != None {
        self.addMachineFunctionPass(LiveRangeShrinkPass {}, PMW, false, name());
        self.addMachineFunctionPass(X86FixupSetCCPass {}, PMW, false, name());
        self.addMachineFunctionPass(X86CallFrameOptimizationPass {}, PMW, false, name());
        self.addMachineFunctionPass(X86AvoidStoreForwardingBlocksPass {}, PMW, false, name());
    }
    self.addMachineFunctionPass(X86SuppressAPXForRelocationPass {}, PMW, false, name());
    self.addMachineFunctionPass(X86SpeculativeLoadHardeningPass {}, PMW, false, name());
    self.addMachineFunctionPass(X86FlagsCopyLoweringPass {}, PMW, false, name());
    self.addMachineFunctionPass(X86DynAllocaExpanderPass {}, PMW, false, name());
    if self.getOptLevel() != None {
        self.addMachineFunctionPass(X86PreTileConfigPass {}, PMW, false, name());
    } else {
        self.addMachineFunctionPass(X86FastPreTileConfigPass {}, PMW, false, name());
    }
}

fn X86CodeGenPassBuilder::addPostRegAlloc(self, PMW: *mut PassManagerWrapper) {
    self.addMachineFunctionPass(X86LowerTileCopyPass {}, PMW, false, name());
    self.addMachineFunctionPass(X86FPStackifierPass {}, PMW, false, name());
    if self.getOptLevel() != None {
        self.addMachineFunctionPass(X86LoadValueInjectionLoadHardeningPass {}, PMW, false, name());
    }
}

fn X86CodeGenPassBuilder::addPreSched2(self, PMW: *mut PassManagerWrapper) {
    self.addMachineFunctionPass(X86ExpandPseudoPass {}, PMW, false, name());
    self.addMachineFunctionPass(MachineKCFIPass {}, PMW, false, name());
}

fn X86CodeGenPassBuilder::addPreEmitPass(self, PMW: *mut PassManagerWrapper) {
    if self.getOptLevel() != None {
        self.addMachineFunctionPass(BreakFalseDepsPass {}, PMW, false, name());
    }
    self.addMachineFunctionPass(X86IndirectBranchTrackingPass {}, PMW, false, name());
    self.addMachineFunctionPass(X86InsertVZeroUpperPass {}, PMW, false, name());
    if self.getOptLevel() != None {
        self.addMachineFunctionPass(X86FixupBWInstsPass {}, PMW, false, name());
        self.addMachineFunctionPass(X86FixupLEAsPass {}, PMW, false, name());
        self.addMachineFunctionPass(X86FixupInstTuningPass {}, PMW, false, name());
        self.addMachineFunctionPass(X86FixupVectorConstantsPass {}, PMW, false, name());
    }
    self.addMachineFunctionPass(X86CompressEVEXPass {}, PMW, false, name());
    self.addMachineFunctionPass(X86InsertX87WaitPass {}, PMW, false, name());
    if self.TM.getTargetTriple().isLFI() {
        self.addMachineFunctionPass(X86LFIRewritePass {}, PMW, false, name());
    }
}

fn X86CodeGenPassBuilder::addPreEmitPass2(self, PMW: *mut PassManagerWrapper) {
    let mut TT: *Triple = self.TM.getTargetTriple();
    let mut MAI: *MCAsmInfo = self.TM.getMCAsmInfo();
    self.addMachineFunctionPass(X86SpeculativeExecutionSideEffectSuppressionPass {}, PMW, false, name());
    self.addMachineFunctionPass(X86ReturnThunksPass {}, PMW, false, name());
    if TT.isOSWindows() && TT.isX86_64() {
        self.addMachineFunctionPass(X86AvoidTrailingCallPass {}, PMW, false, name());
    }
    if !TT.isOSDarwin() && (!TT.isOSWindows() || MAI.getExceptionHandlingType() == DwarfCFI) {
        self.addMachineFunctionPass(CFIInstrInserterPass {}, PMW, false, name());
    }
    if TT.isOSWindows() {
        self.addMachineFunctionPass(EHContGuardTargetsPass {}, PMW, false, name());
    }
    self.addMachineFunctionPass(X86LoadValueInjectionRetHardeningPass {}, PMW, false, name());
    self.addMachineFunctionPass(Closure_1 { TT: &mut TT }, PMW, false, name());
    if TT.isOSWindows() && TT.isX86_64() {
        self.addMachineFunctionPass(X86WinEHUnwindV2Pass {}, PMW, false, name());
    }
}

fn X86CodeGenPassBuilder::addAsmPrinterBegin(self, PMW: *mut PassManagerWrapper) {
    self.addModulePass(X86AsmPrinterBeginPass {}, PMW, true, name());
}

fn X86CodeGenPassBuilder::addAsmPrinter(self, PMW: *mut PassManagerWrapper) {
    self.addMachineFunctionPass(X86AsmPrinterPass {}, PMW, false, name());
}

fn X86CodeGenPassBuilder::addAsmPrinterEnd(self, PMW: *mut PassManagerWrapper) {
    self.addModulePass(X86AsmPrinterEndPass {}, PMW, true, name());
}

fn X86TargetMachine::registerPassBuilderCallbacks(self, PB: *mut PassBuilder) {
    let mut PIC: *mut PassInstrumentationCallbacks = PB.getPassInstrumentationCallbacks();
    if PIC {
        PIC.registerClassToPassNameCallback(Closure_2 { cap_0: self, PIC: PIC });
    }
    PB.registerPipelineParsingCallback(Closure_3 {});
    PB.registerPipelineParsingCallback(Closure_4 {});
    PB.registerPipelineParsingCallback(Closure_5 { cap_0: self });
    PB.registerPipelineParsingCallback(Closure_6 {});
    PB.registerPipelineParsingCallback(Closure_7 {});
    PB.registerPipelineParsingCallback(Closure_8 { cap_0: self });
    PB.registerPipelineParsingCallback(Closure_9 {});
    PB.registerPipelineParsingCallback(Closure_10 {});
    PB.registerAnalysisRegistrationCallback(Closure_11 {});
    PB.registerAnalysisRegistrationCallback(Closure_12 {});
    PB.registerParseAACallback(Closure_13 {});
    PB.registerAnalysisRegistrationCallback(Closure_14 {});
    PB.registerAnalysisRegistrationCallback(Closure_15 {});
}

fn X86TargetMachine::buildCodeGenPipeline(self, MPM: *mut ModulePassManager, MAM: *mut ModuleAnalysisManager, Out: *mut raw_pwrite_stream, DwoOut: *mut raw_pwrite_stream, FileType: CodeGenFileType, Opt: *CGPassBuilderOption, Ctx: *mut MCContext, PIC: *mut PassInstrumentationCallbacks) -> Error {
    let mut CGPB: X86CodeGenPassBuilder = X86CodeGenPassBuilder { *self, Opt, PIC };
    return CGPB.buildPipeline(MPM, MAM, Out, DwoOut, FileType, Ctx);
}

struct Closure_1 {
    TT: *mut Triple,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MF: *MachineFunction) -> bool {
        let mut F: *Function = MF.getFunction();
        let mut M: *Module = F.getParent();
        return M.getModuleFlag("kcfi") || ((*self.TT).isOSDarwin() && (M.getFunction("objc_retainAutoreleasedReturnValue") || M.getFunction("objc_unsafeClaimAutoreleasedReturnValue")));
    }

