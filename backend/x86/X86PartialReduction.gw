static mut ID: i8 = 0;

fn matchVPDPBUSDPattern(ST: *X86Subtarget, Mul: *mut BinaryOperator, DL: *DataLayout) -> bool {
    if operator!(ST()()) && operator!(ST()()) {
        return false;
    }
    let mut LHS: *mut Value = Mul.getOperand(0);
    let mut RHS: *mut Value = Mul.getOperand(1);
    if isa(LHS) {
        swap(LHS, RHS);
    }
    let mut IsFreeTruncation: Closure_1 = Closure_1 { Mul: &mut Mul };
    if (IsFreeTruncation(LHS) && computeKnownBits(LHS, *DL, null, null, null, true, 0).countMaxActiveBits() <= 8) && (IsFreeTruncation(RHS) && ComputeMaxSignificantBits(RHS, *DL, null, null, null, 0) <= 8) {
        return true;
    }
    return false;
}

fn X86PartialReduction::tryMAddReplacement(self, Op: *mut Instruction, ReduceInOneBB: bool) -> bool {
    if !self.ST.hasSSE2() {
        return false;
    }
    if cast(Op.getType())() < 8 {
        return false;
    }
    if operator!(cast(Op.getType())()(32)) {
        return false;
    }
    let mut Mul: *mut auto = dyn_cast(Op);
    if operator!() || () != Mul {
        return false;
    }
    let mut LHS: *mut Value = (0);
    let mut RHS: *mut Value = (1);
    if ReduceInOneBB && matchVPDPBUSDPattern(self.ST, self.DL) {
        return false;
    }
    if self.ST.hasSSE41() {
        if LHS == RHS {
            if !isa(LHS) && !LHS.hasNUses(2) {
                return false;
            }
        } else {
            if !isa(LHS) && !LHS.hasOneUse() {
                return false;
            }
            if !isa(RHS) && !RHS.hasOneUse() {
                return false;
            }
        }
    }
    let mut CanShrinkOp: Closure_2 = Closure_2 { cap_0: self };
    if !CanShrinkOp.call(LHS) && !CanShrinkOp.call(RHS) {
        return false;
    }
    let mut Builder: i32 = Mul();
    let mut MulTy: *mut auto = cast(Op.getType());
    let mut NumElts: u32 = ();
    let mut EvenMask: SmallVector<int, 16> = SmallVector<int, 16> { NumElts / 2 };
    let mut OddMask: SmallVector<int, 16> = SmallVector<int, 16> { NumElts / 2 };
    for let mut i: i32 = 0;
let mut e: i32 = NumElts / 2; i != e; i += 1 {
        EvenMask[i] = i * 2;
        OddMask[i] = i * 2 + 1;
    }
    let mut NewMul: *mut Value = ((0), (1));
    let mut EvenElts: *mut Value = (NewMul, NewMul, EvenMask);
    let mut OddElts: *mut Value = (NewMul, NewMul, OddMask);
    let mut MAdd: *mut Value = (EvenElts, OddElts);
    let mut ConcatMask: SmallVector<int, 32> = zeroed();
    iota(0);
    let mut Zero: *mut Value = getNullValue(MAdd.getType());
    let mut Concat: *mut Value = (MAdd, Zero);
    Mul()(Concat);
    Mul()();
    return true;
}

fn X86PartialReduction::trySADReplacement(self, Op: *mut Instruction) -> bool {
    if !self.ST.hasSSE2() {
        return false;
    }
    if operator!(cast(Op.getType())()(32)) {
        return false;
    }
    let mut LHS: *mut Value = null;
    if match(Op, m_Intrinsic()) {
        LHS = Op.getOperand(0);
    } else {
        let mut SI: *mut auto = dyn_cast(Op);
        if operator!() {
            return false;
        }
        let mut RHS: *mut Value = null;
        let mut SPR: auto = matchSelectPattern(LHS, RHS);
        if SPR() != SPF_ABS {
            return false;
        }
    }
    let mut Sub: *mut auto = dyn_cast(LHS);
    if operator!() || () != Sub {
        return false;
    }
    let mut getZeroExtendedVal: Closure_4 = Closure_4 {};
    let mut Op0: *mut Value = getZeroExtendedVal((0));
    let mut Op1: *mut Value = getZeroExtendedVal((1));
    if !Op0 || !Op1 {
        return false;
    }
    let mut Builder: i32 = Op;
    let mut OpTy: *mut auto = cast(Op.getType());
    let mut NumElts: u32 = ();
    let mut IntrinsicNumElts: u32 = 0;
    let mut IID: ID = zeroed();
    if self.ST.useBWIRegs() && NumElts >= 64 {
        IntrinsicNumElts = 64;
    } else if self.ST.hasAVX2() && NumElts >= 32 {
        IntrinsicNumElts = 32;
    } else {
        IntrinsicNumElts = 16;
    }
    let mut PSADBWFn: *mut Function = getOrInsertDeclaration(Op.getModule(), IID, ArrayRef<Type *> {});
    if NumElts < 16 {
        let mut ConcatMask: SmallVector<int, 32> = zeroed();
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            ConcatMask()[i] = i;
        }
        for let mut i: u32 = NumElts; i != 16; i += 1 {
            ConcatMask()[i] = (i % NumElts) + NumElts;
        }
        let mut Zero: *mut Value = getNullValue(Op0.getType());
        Op0 = (Op0, Zero);
        Op1 = (Op1, Zero);
        NumElts = 16;
    }
    let mut I32Ty: *mut auto = get(IntrinsicNumElts / 4);
    assert!(NumElts % IntrinsicNumElts == 0, "Unexpected number of elements!");
    let mut NumSplits: u32 = NumElts / IntrinsicNumElts;
    let mut Ops: SmallVector<Value *, 4> = zeroed();
    for let mut i: u32 = 0; i != NumSplits; i += 1 {
        let mut ExtractMask: SmallVector<int, 64> = zeroed();
        iota(i * IntrinsicNumElts);
        let mut ExtractOp0: *mut Value = (Op0, Op0);
        let mut ExtractOp1: *mut Value = (Op1, Op0);
        Ops()[i] = (PSADBWFn, void { ExtractOp0, ExtractOp1 });
        Ops()[i] = ([i]);
    }
    assert!(isPowerOf2_32(NumSplits), "Expected power of 2 splits");
    let mut Stages: u32 = Log2_32(NumSplits);
    for let mut s: u32 = Stages; s > 0; s -= 1 {
        let mut NumConcatElts: u32 = cast([0]())() * 2;
        for let mut i: u32 = 0; i != 1 << (s - 1); i += 1 {
            let mut ConcatMask: SmallVector<int, 64> = zeroed();
            iota(0);
            Ops()[i] = ([i * 2], [i * 2 + 1]);
        }
    }
    NumElts = cast()();
    if NumElts == 2 {
        Ops()[0] = ([0], [0], ArrayRef<int> { [0, 1] });
    } else if NumElts >= 8 {
        let mut ConcatMask: SmallVector<int, 32> = zeroed();
        let mut SubElts: u32 = cast([0]())();
        for let mut i: u32 = 0; i != SubElts; i += 1 {
            ConcatMask()[i] = i;
        }
        for let mut i: u32 = SubElts; i != NumElts; i += 1 {
            ConcatMask()[i] = (i % SubElts) + SubElts;
        }
        let mut Zero: *mut Value = getNullValue([0]());
        Ops()[0] = ([0], Zero);
    }
    Op.replaceAllUsesWith([0]);
    Op.eraseFromParent();
    return true;
}

fn X86PartialReduction::tryByteSumReplacement(self, Op: *mut Instruction) -> bool {
    if !self.ST.hasSSE2() {
        return false;
    }
    let mut OpTy: *mut auto = dyn_cast(Op.getType());
    if operator!() {
        return false;
    }
    let mut ElemBits: u32 = ()();
    if ElemBits != 32 && ElemBits != 64 {
        return false;
    }
    let mut ZExt: *mut auto = dyn_cast(Op);
    if operator!() {
        return false;
    }
    let mut SrcTy: *mut auto = dyn_cast((0)());
    if operator!() || operator!(()(8)) {
        return false;
    }
    let mut NumElts: u32 = ();
    if NumElts < 16 {
        return false;
    }
    let mut IntrinsicNumElts: u32 = 0;
    let mut IID: ID = zeroed();
    if self.ST.useBWIRegs() && NumElts >= 64 {
        IntrinsicNumElts = 64;
    } else if self.ST.hasAVX2() && NumElts >= 32 {
        IntrinsicNumElts = 32;
    } else {
        IntrinsicNumElts = 16;
    }
    if NumElts % IntrinsicNumElts != 0 || !isPowerOf2_32(NumElts / IntrinsicNumElts) {
        return false;
    }
    let mut NumSplits: u32 = NumElts / IntrinsicNumElts;
    let mut Builder: i32 = Op;
    Builder()(Op.getDebugLoc());
    let mut PSADBWFn: *mut Function = getOrInsertDeclaration(Op.getModule(), IID, ArrayRef<Type *> {});
    let mut I8VecTy: *mut auto = get(IntrinsicNumElts);
    let mut Zeroes: *mut Value = getNullValue();
    let mut I32PerSplitTy: *mut FixedVectorType = if ElemBits == 32 { get(IntrinsicNumElts / 4) } else { null };
    let mut Src: *mut Value = (0);
    let mut Ops: SmallVector<Value *, 4> = zeroed();
    for let mut i: u32 = 0; i != NumSplits; i += 1 {
        let mut ExtractMask: SmallVector<int, 64> = zeroed();
        iota(i * IntrinsicNumElts);
        let mut ExtractSrc: *mut Value = (Src, Src);
        Ops()[i] = (PSADBWFn, void { ExtractSrc, Zeroes });
        if I32PerSplitTy {
            Ops()[i] = ([i], I32PerSplitTy);
        }
    }
    let mut Stages: u32 = Log2_32(NumSplits);
    for let mut S: u32 = Stages; S > 0; S -= 1 {
        let mut NumConcatElts: u32 = cast([0]())() * 2;
        for let mut i: u32 = 0; i != 1 << (S - 1); i += 1 {
            let mut ConcatMask: SmallVector<int, 64> = zeroed();
            iota(0);
            Ops()[i] = ([i * 2], [i * 2 + 1]);
        }
    }
    let mut ConcatMask: SmallVector<int, 32> = zeroed();
    let mut SubElts: u32 = cast([0]())();
    for let mut i: u32 = 0; i != SubElts; i += 1 {
        ConcatMask()[i] = i;
    }
    for let mut i: u32 = SubElts; i != NumElts; i += 1 {
        ConcatMask()[i] = (i % SubElts) + SubElts;
    }
    let mut Zero: *mut Value = getNullValue([0]());
    Ops()[0] = ([0], Zero);
    Op.replaceAllUsesWith([0]);
    Op.eraseFromParent();
    return true;
}

fn matchAddReduction(EE: *ExtractElementInst, ReduceInOneBB: *mut bool) -> *mut Value {
    ReduceInOneBB = true;
    let mut Index: *mut auto = dyn_cast(EE.getIndexOperand());
    if operator!() || operator!() {
        return null;
    }
    let mut BO: *auto = dyn_cast(EE.getVectorOperand());
    if operator!() || () != Add || operator!() {
        return null;
    }
    if EE.getParent() != () {
        ReduceInOneBB = false;
    }
    let mut NumElems: u32 = cast()();
    if !isPowerOf2_32(NumElems) {
        return null;
    }
    let mut Op: *Value = ;
    let mut Stages: u32 = Log2_32(NumElems);
    for let mut i: u32 = 0; i != Stages; i += 1 {
        let mut BO: *auto = dyn_cast(Op);
        if operator!() || () != Add {
            return null;
        }
        if EE.getParent() != () {
            ReduceInOneBB = false;
        }
        if i != 0 && operator!((2)) {
            return null;
        }
        let mut LHS: *mut Value = (0);
        let mut RHS: *mut Value = (1);
        let mut Shuffle: *mut auto = dyn_cast(LHS);
        if Shuffle() {
            Op = RHS;
        } else {
            Shuffle() = dyn_cast(RHS);
            Op = LHS;
        }
        if operator!() || (0) != Op {
            return null;
        }
        let mut MaskEnd: u32 = 1 << i;
        for let mut Index: u32 = 0; Index < MaskEnd; Index += 1 {
            if Shuffle()(Index) != (MaskEnd + Index) as i32 {
                return null;
            }
        }
    }
    return Op;
}

fn isReachableFromPHI(Phi: *mut PHINode, BO: *mut BinaryOperator) -> bool {
    if !Phi.hasOneUse() {
        return false;
    }
    let mut U: *mut Instruction = cast(operator(Phi.user_begin()));
    if U == BO {
        return true;
    }
    while U.hasOneUse() && U.getOpcode() == BO.getOpcode() {
        U = cast(operator(U.user_begin()));
    }
    return U == BO;
}

fn collectLeaves(Root: *mut Value, Leaves: *mut SmallVectorImpl<Instruction *>) {
    let mut Visited: SmallPtrSet<Value *, 8> = zeroed();
    let mut Worklist: SmallVector<Value *, 8> = zeroed();
    Worklist()(Root);
    while operator!() {
        let mut V: *mut Value = ();
        if operator!((V)) {
            continue;
        }
        if  {
            if operator!((if  == Root { 2 } else { 1 })) {
                break;
            }
            append_range();
            continue;
        }
        if  {
            if BO()() == Add {
                if BO()(if  == Root { 2 } else { 1 }) {
                    append_range();
                    continue;
                }
                if BO()(if  == Root { 3 } else { 2 }) {
                    let mut PN: *mut PHINode = null;
                    if !PN || PN.getNumIncomingValues() != 2 {
                        continue;
                    }
                    if operator!(isReachableFromPHI(PN)) {
                        continue;
                    }
                    append_range();
                }
            }
        }
        if  {
            if operator!(V.hasNUses(if  == Root { 2 } else { 1 })) {
                continue;
            }
            Leaves()();
        }
    }
}

fn X86PartialReduction::run(self, F: *mut Function) -> bool {
    self.ST = self.TM.getSubtargetImpl(F);
    self.DL = &mut F.getDataLayout();
    let mut MadeChange: bool = false;
    for BB in F {
        for I in BB {
            let mut EE: *mut auto = dyn_cast(&mut I);
            if operator!() {
                continue;
            }
            let mut ReduceInOneBB: bool = false;
            let mut Root: *mut Value = matchAddReduction(operator*(), ReduceInOneBB);
            if !Root {
                continue;
            }
            let mut Leaves: SmallVector<Instruction *, 8> = zeroed();
            collectLeaves(Root);
        }
    }
    return MadeChange;
}

fn X86PartialReductionLegacy::runOnFunction(self, F: *mut Function) -> bool {
    if self.skipFunction(F) {
        return false;
    }
    let mut TPC: *mut auto = ;
    if operator!() {
        return false;
    }
    return operator&().run(F);
}

fn X86PartialReductionPass::run(self, F: *mut Function, FAM: *mut FunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = X86PartialReduction { self.TM }.run(F);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = none();
    PA;
    return PA;
}

struct Closure_1 {
    Mul: *mut *mut BinaryOperator,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Op: *mut Value) -> bool {
        if  {
            if Cast()() == (*self.Mul).getParent() && (Cast()() == SExt || () == ZExt) && (0)()() <= 8 {
                return true;
            }
        }
    }

struct Closure_3 {}

fn Closure_3::call(self: *Closure_3, Op: *mut Value) -> bool {
            if  {
                if Cast()() == () && (Cast()() == SExt || () == ZExt) && (0)()() <= 16 {
                    return true;
                }
            }
        }

struct Closure_2 {
    cap_0: *mut X86PartialReduction,
}

fn Closure_2::call(self: *Closure_2, Op: *mut Value) -> bool {
        let mut IsFreeTruncation: Closure_3 = Closure_3 {};
        if IsFreeTruncation(Op) && ComputeNumSignBits(Op, *self.DL, null) > 16 {
            return true;
        }
        if  {
            if BO()() == () && IsFreeTruncation((0)) && IsFreeTruncation((1)) && ComputeNumSignBits(Op, *self.DL, null) > 16 {
                return true;
            }
        }
        return false;
    }

struct Closure_4 {}

fn Closure_4::call(self: *mut Closure_4, Op: *mut Value) -> auto {
        if  {
            if cast((0)())()(8) {
                return (0);
            }
        }
        return null;
    }
