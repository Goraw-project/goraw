static mut FixupBWInsts: i32 = "fixup-byte-word-insts";

struct X86FixupBWInstImpl {
    MF: *mut MachineFunction,
    TII: *X86InstrInfo,
    TRI: *TargetRegisterInfo,
    OptForSize: bool,
    LiveUnits: LiveRegUnits,
    PSI: *mut ProfileSummaryInfo,
    MBFI: *mut MachineBlockFrequencyInfo,
}

struct X86FixupBWInstLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86FixupBWInstLegacy::getPassName(self: *X86FixupBWInstLegacy) -> str {
    return "X86 Byte/Word Instruction Fixup";
}

fn X86FixupBWInstLegacy::getAnalysisUsage(self: *X86FixupBWInstLegacy, AU: *mut AnalysisUsage) {
    AU;
    AU;
    self.getAnalysisUsage(AU);
}

fn X86FixupBWInstLegacy::getRequiredProperties(self: *X86FixupBWInstLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn X86FixupBWInstLegacy::getPassKind(self: *X86FixupBWInstLegacy) -> PassKind {
    return self.Kind;
}

fn X86FixupBWInstLegacy::getPassID(self: *X86FixupBWInstLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86FixupBWInstLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FixupBWInstLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
