static mut FixupBWInsts: opt<bool> = opt<bool> { "fixup-byte-word-insts", "Change byte and word instructions to larger sizes", init(true), Hidden };

struct X86FixupBWInstImpl {
    MF: *mut MachineFunction,
    TII: *X86InstrInfo,
    TRI: *TargetRegisterInfo,
    OptForSize: bool,
    LiveUnits: LiveRegUnits,
    PSI: *mut ProfileSummaryInfo,
    MBFI: *mut MachineBlockFrequencyInfo,
}

struct X86FixupBWInstLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86FixupBWInstLegacy::getPassName(self: *X86FixupBWInstLegacy) -> str {
    return "X86 Byte/Word Instruction Fixup";
}

fn X86FixupBWInstLegacy::getAnalysisUsage(self: *X86FixupBWInstLegacy, AU: *mut AnalysisUsage) {
    AU.addRequired();
    AU.addRequired();
    self.getAnalysisUsage(AU);
}

fn X86FixupBWInstLegacy::getRequiredProperties(self: *X86FixupBWInstLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn X86FixupBWInstLegacy::getPassKind(self: *X86FixupBWInstLegacy) -> PassKind {
    return self.Kind;
}

fn X86FixupBWInstLegacy::getPassID(self: *X86FixupBWInstLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86FixupBWInstLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FixupBWInstLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FixupBWInstLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86FixupBWInstLegacy::getResolver(self: *X86FixupBWInstLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86FixupBWInstLegacy::getSetProperties(self: *X86FixupBWInstLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86FixupBWInstLegacy::getClearedProperties(self: *X86FixupBWInstLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86FixupBWInstsLegacyPass() -> *mut FunctionPass {
    return X86FixupBWInstLegacy {};
}

fn X86FixupBWInstImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if !FixupBWInsts {
        return false;
    }
    self.MF = &mut MF;
    self.TII = MF.getSubtarget().getInstrInfo();
    self.TRI = MF.getRegInfo().getTargetRegisterInfo();
    self.LiveUnits.init(self.TII.getRegisterInfo());
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-bw-insts", 1) {
            dbgs() << "Start X86FixupBWInsts\n";
        }
    }
        if !(false) { break; }
    }
    for MBB in MF {
        self.processBasicBlock(MF, MBB);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-bw-insts", 1) {
            dbgs() << "End X86FixupBWInsts\n";
        }
    }
        if !(false) { break; }
    }
    return true;
}

fn X86FixupBWInstImpl::getSuperRegDestIfDead(self: *X86FixupBWInstImpl, OrigMI: *mut MachineInstr) -> Register {
    let mut TRI: *X86RegisterInfo = &mut self.TII.getRegisterInfo();
    let mut OrigDestReg: Register = OrigMI.getOperand(0).getReg();
    let mut SuperDestReg: Register = getX86SubSuperRegister(OrigDestReg.operator MCRegister(), 32, false);
    assert!(SuperDestReg.isValid(), "Invalid Operand");
    let mut SubRegIdx: u32 = TRI.getSubRegIndex(SuperDestReg.operator MCRegister(), OrigDestReg.operator MCRegister());
    if SubRegIdx == sub_8bit_hi {
        return Register { Reg: 0 };
    }
    let mut SuperIsLive: bool = false;
    let mut Range: iterator_range<MCRegUnitIterator> = TRI.regunits(OrigDestReg.operator MCRegister());
    let mut I: MCRegUnitIterator = Range.begin();
    let mut E: MCRegUnitIterator = Range.end();
    for S in TRI.regunits(SuperDestReg.operator MCRegister()) {
        I = lower_bound(I, E, S);
        if (I == E || operator(I) > S) && self.LiveUnits.getBitVector().test(S as u32) {
            SuperIsLive = true;
            break;
        }
    }
    if !SuperIsLive {
        return SuperDestReg;
    }
    let mut Opc: u32 = OrigMI.getOpcode();
    if Opc != MOV8rm && Opc != MOV16rm && Opc != MOV8rr && Opc != MOV16rr {
        return Register { Reg: 0 };
    }
    let mut IsDefined: bool = false;
    for MO in OrigMI.implicit_operands() {
        if !MO.isReg() {
            continue;
        }
        if MO.isDef() && TRI.isSuperRegisterEq(OrigDestReg.operator MCRegister(), MO.getReg().operator MCRegister()) {
            IsDefined = true;
        }
        if MO.isUse() && !TRI.isSubRegisterEq(OrigDestReg.operator MCRegister(), MO.getReg().operator MCRegister()) && TRI.regsOverlap(SuperDestReg, MO.getReg()) {
            return Register { Reg: 0 };
        }
    }
    if !IsDefined {
        return Register { Reg: 0 };
    }
    return SuperDestReg;
}

fn X86FixupBWInstImpl::tryReplaceLoad(self: *X86FixupBWInstImpl, New32BitOpcode: u32, MI: *mut MachineInstr) -> *mut MachineInstr {
    let mut NewDestReg: Register = self.getSuperRegDestIfDead(MI);
    if !NewDestReg.operator unsigned int() {
        return null;
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*self.MF, *MI, self.TII.get(New32BitOpcode), NewDestReg);
    let mut NumArgs: u32 = MI.getNumOperands();
    for let mut i: u32 = 1; i < NumArgs; i += 1 {
        MIB.add(MI.getOperand(i));
    }
    MIB.setMemRefs(MI.memoperands());
    if MI.peekDebugInstrNum() {
        OldInstrNum;
    } else {
        let mut Subreg: u32 = self.TRI.getSubRegIndex(operator(MIB).getOperand(0).getReg().operator MCRegister(), MI.getOperand(0).getReg().operator MCRegister());
        let mut NewInstrNum: u32 = operator(MIB).getDebugInstrNum(*self.MF);
        self.MF.makeDebugValueSubstitution(DebugInstrOperandPair { OldInstrNum, 0 }, DebugInstrOperandPair { NewInstrNum, 0 }, Subreg);
    }
    return MIB.operator llvm::MachineInstr *();
}

fn X86FixupBWInstImpl::tryReplaceCopy(self: *X86FixupBWInstImpl, MI: *mut MachineInstr) -> *mut MachineInstr {
    assert!(MI.getNumExplicitOperands() == 2);
    let mut OldDest: *mut MachineOperand = MI.getOperand(0);
    let mut OldSrc: *mut MachineOperand = MI.getOperand(1);
    let mut NewDestReg: Register = self.getSuperRegDestIfDead(MI);
    if !NewDestReg.operator unsigned int() {
        return null;
    }
    let mut NewSrcReg: Register = getX86SubSuperRegister(OldSrc.getReg().operator MCRegister(), 32, false);
    assert!(NewSrcReg.isValid(), "Invalid Operand");
    let mut TRI: *X86RegisterInfo = &mut self.TII.getRegisterInfo();
    if TRI.getSubRegIndex(NewSrcReg.operator MCRegister(), OldSrc.getReg().operator MCRegister()) != TRI.getSubRegIndex(NewDestReg.operator MCRegister(), OldDest.getReg().operator MCRegister()) {
        return null;
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*self.MF, *MI, self.TII.get(MOV32rr), NewDestReg).addReg(NewSrcReg, Undef, 0).addReg(OldSrc.getReg(), Implicit, 0);
    for Op in MI.implicit_operands() {
        if Op.getReg() != (if Op.isDef() { NewDestReg } else { NewSrcReg }) {
            MIB.add(Op);
        }
    }
    return MIB.operator llvm::MachineInstr *();
}

fn X86FixupBWInstImpl::tryReplaceExtend(self: *X86FixupBWInstImpl, New32BitOpcode: u32, MI: *mut MachineInstr) -> *mut MachineInstr {
    let mut NewDestReg: Register = self.getSuperRegDestIfDead(MI);
    if !NewDestReg.operator unsigned int() {
        return null;
    }
    if MI.getOpcode() == MOVSX16rr8 && MI.getOperand(0).getReg() == AX && MI.getOperand(1).getReg() == AL {
        return null;
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*self.MF, *MI, self.TII.get(New32BitOpcode), NewDestReg);
    let mut NumArgs: u32 = MI.getNumOperands();
    for let mut i: u32 = 1; i < NumArgs; i += 1 {
        MIB.add(MI.getOperand(i));
    }
    MIB.setMemRefs(MI.memoperands());
    if MI.peekDebugInstrNum() {
        OldInstrNum;
    } else {
        let mut Subreg: u32 = self.TRI.getSubRegIndex(operator(MIB).getOperand(0).getReg().operator MCRegister(), MI.getOperand(0).getReg().operator MCRegister());
        let mut NewInstrNum: u32 = operator(MIB).getDebugInstrNum(*self.MF);
        self.MF.makeDebugValueSubstitution(DebugInstrOperandPair { OldInstrNum, 0 }, DebugInstrOperandPair { NewInstrNum, 0 }, Subreg);
    }
    return MIB.operator llvm::MachineInstr *();
}

fn X86FixupBWInstImpl::tryReplaceInstr(self: *X86FixupBWInstImpl, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) -> *mut MachineInstr {
    match MI.getOpcode() {
        MOV8rm => {
            if !self.OptForSize {
                return self.tryReplaceLoad(MOVZX32rm8, MI);
            }
        },
        MOV16rm => {
            return self.tryReplaceLoad(MOVZX32rm16, MI);
        },
        MOV8rr => {
            MOV16rr;
        },
        MOVSX16rr8 => {
            return self.tryReplaceExtend(MOVSX32rr8, MI);
        },
        MOVSX16rm8 => {
            return self.tryReplaceExtend(MOVSX32rm8, MI);
        },
        MOVZX16rr8 => {
            return self.tryReplaceExtend(MOVZX32rr8, MI);
        },
        MOVZX16rm8 => {
            return self.tryReplaceExtend(MOVZX32rm8, MI);
        },
        _ => {
            break;
        },
    }
    return null;
}

fn X86FixupBWInstImpl::processBasicBlock(self, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock) {
    let mut MIReplacements: pair<MachineInstr *, MachineInstr *>, 8> = pair<MachineInstr *, MachineInstr *>, 8> {};
    self.LiveUnits.clear();
    self.LiveUnits.addLiveOuts(MBB);
    self.OptForSize = shouldOptimizeForSize(&mut MBB, self.PSI, self.MBFI, Other);
    for MI in reverse(MBB) {
        if self.tryReplaceInstr(&mut MI, MBB) {
            NewMI;
        } else {
            MIReplacements.push(make_pair(&mut MI, NewMI));
        }
        if !MI.isDebugInstr() {
            self.LiveUnits.stepBackward(MI);
        }
    }
    while !MIReplacements.is_empty() {
        let mut MI: *mut MachineInstr = MIReplacements.back().first;
        let mut NewMI: *mut MachineInstr = MIReplacements.back().second;
        MIReplacements.pop();
        MBB.insert(MI, NewMI);
        MBB.erase(MI);
    }
}

fn X86FixupBWInstLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut PSI: *mut ProfileSummaryInfo = &mut self.getAnalysis().getPSI();
    let mut MBFI: *mut MachineBlockFrequencyInfo = if (PSI && PSI.hasProfileSummary()) { &mut self.getAnalysis().getBFI() } else { null };
    let mut Impl: X86FixupBWInstImpl = X86FixupBWInstImpl { PSI, MBFI };
    return Impl.runOnMachineFunction(MF);
}

fn X86FixupBWInstsPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut PSI: *mut ProfileSummaryInfo = MFAM.getResult(MF).getCachedResult(*MF.getFunction().getParent());
    let mut MBFI: *mut MachineBlockFrequencyInfo = null;
    if PSI && PSI.hasProfileSummary() {
        MBFI = &mut MFAM.getResult(MF);
    }
    let mut Impl: X86FixupBWInstImpl = X86FixupBWInstImpl { PSI, MBFI };
    let mut Changed: bool = Impl.runOnMachineFunction(MF);
    return if Changed { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}
