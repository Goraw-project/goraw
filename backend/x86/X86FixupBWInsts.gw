fn X86FixupBWInstLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86FixupBWInstLegacy::getResolver(self: *X86FixupBWInstLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
