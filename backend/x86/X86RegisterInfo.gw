fn CantUseSP(MFI: *MachineFrameInfo) -> bool {
    return MFI.hasVarSizedObjects() || MFI.hasOpaqueSPAdjustment();
}

fn X86RegisterInfo::hasBasePointer(self: *X86RegisterInfo, MF: *MachineFunction) -> bool {
    let mut X86FI: *X86MachineFunctionInfo = MF;
    if X86FI.getStackPtrSaveMI() != null {
        return false;
    }
    if X86FI.hasPreallocatedCall() {
        return true;
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    if operator!() {
        return false;
    }
    let mut CantUseFP: bool = hasStackRealignment(MF);
    return CantUseFP && CantUseSP(MFI);
}

fn X86RegisterInfo::canRealignStack(self: *X86RegisterInfo, MF: *MachineFunction) -> bool {
    if  {
        return false;
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut MRI: *MachineRegisterInfo = &mut MF.getRegInfo();
    if !MRI.canReserveReg(MCRegister { Reg: self.FramePtr }) {
        return false;
    }
    if CantUseSP(MFI) {
        return MRI.canReserveReg(MCRegister { Reg: self.BasePtr });
    }
    return true;
}

fn X86RegisterInfo::shouldRealignStack(self: *X86RegisterInfo, MF: *MachineFunction) -> bool {
    if  {
        return true;
    }
    return !self.Is64Bit && MF.getFunction().getCallingConv() == X86_INTR;
}

fn tryOptimizeLEAtoMOV(II: iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(II);
    let mut Opc: u32 = operator(II).getOpcode();
    if  {
        return false;
    }
    let mut BasePtr: Register = MI.getOperand(1).getReg();
    if  {
        BasePtr = Register { Reg: getX86SubSuperRegister(BasePtr.operator MCRegister(), 32, false) };
    }
    let mut NewDestReg: Register = MI.getOperand(0).getReg();
    let mut TII: *X86InstrInfo = MI.getParent().getParent()();
    TII.copyPhysReg(*MI.getParent(), iterator { II }, MI.getDebugLoc(), NewDestReg, BasePtr, MI.getOperand(1).isKill(), false, false);
    MI.eraseFromParent();
    return true;
}

