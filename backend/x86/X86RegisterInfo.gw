struct Closure_6 {
    VRM: *mut *VirtRegMap,
    MRI: *mut *MachineRegisterInfo,
    Hints: *mut SmallSetVector<MCPhysReg, 16>,
    TwoAddrHints: *mut SmallSet<unsigned int, 4>,
}

unsafe fn Closure_6::call(self: *mut Closure_6, MO: *MachineOperand) {
            let mut Reg: Register = MO.getReg();
            let mut PhysReg: Register = if Reg.isPhysical() { Reg } else { (*self.VRM).getPhys(Reg) };
            if PhysReg.operator unsigned int() && !(*self.MRI).isReserved(PhysReg.operator MCRegister()) && !(*self.Hints).contains(PhysReg.operator unsigned int()) {
                (*self.TwoAddrHints).insert(PhysReg.operator unsigned int());
            }
        }

struct Closure_7 {
    Matrix: *mut *LiveRegMatrix,
    Hints: *mut SmallSetVector<MCPhysReg, 16>,
    VRM: *mut *VirtRegMap,
    MRI: *mut *MachineRegisterInfo,
    VirtShape: *mut ShapeT,
}

unsafe fn Closure_7::call(self: *mut Closure_7, PhysReg: MCPhysReg) {
        let mut VReg: Register = (*self.Matrix).getOneVReg(PhysReg);
        if VReg == NoRegister {
            (*self.Hints).insert(PhysReg);
            return;
        }
        let mut PhysShape: ShapeT = getTileShape(VReg, (*self.VRM), (*self.MRI));
        if PhysShape == (*self.VirtShape) {
            (*self.Hints).insert(PhysReg);
        }
    }
