fn X86RegisterInfo::isArgumentRegister(self: *X86RegisterInfo, MF: *MachineFunction, Reg: MCRegister) -> bool {
    let mut ST: *X86Subtarget = MF;
    let mut TRI: *TargetRegisterInfo = *ST.getRegisterInfo();
    let mut IsSubReg: Closure_1 = Closure_1 { TRI: &mut TRI };
    let mut CC: ID = MF.getFunction().getCallingConv();
    if CC == X86_64_SysV && IsSubReg(Reg) {
        return true;
    }
    if any_of(Closure_2 { IsSubReg: &mut IsSubReg, Reg: &mut Reg }) {
        return true;
    }
    if CC != Win64 && any_of(Closure_3 { IsSubReg: &mut IsSubReg, Reg: &mut Reg }) {
        return true;
    }
    if ST.hasSSE1() && any_of(Closure_4 { IsSubReg: &mut IsSubReg, Reg: &mut Reg }) {
        return true;
    }
}

fn X86RegisterInfo::isFixedRegister(self: *X86RegisterInfo, MF: *MachineFunction, PhysReg: MCRegister) -> bool {
    let mut ST: *X86Subtarget = MF;
    let mut TRI: *TargetRegisterInfo = *ST.getRegisterInfo();
    if TRI.isSuperOrSubRegisterEq {
        return true;
    }
    let mut TFI: *X86FrameLowering = operator*(getFrameLowering(MF));
    if TFI.hasFP(MF) && TRI.isSuperOrSubRegisterEq {
        return true;
    }
}

