fn CC_X86_32_RegCall_Assign2Regs(ValNo: *mut u32, ValVT: *mut MVT, LocVT: *mut MVT, LocInfo: *mut LocInfo, ArgFlags: *mut ArgFlagsTy, State: *mut CCState) -> bool {
    let mut RegList: []MCPhysReg = zeroed();
    let mut AvailableRegs: SmallVector<unsigned int, 5> = zeroed();
    let mut RequiredGprsUponSplit: u64 = 2;
    if AvailableRegs()() < RequiredGprsUponSplit {
        return false;
    }
    for let mut I: u32 = 0; I < RequiredGprsUponSplit; I += 1 {
        let mut Reg: MCRegister = State([I]);
        assert!(Reg.operator unsigned int(), "Expecting a register will be available");
        State.addLoc(getCustomReg(ValNo, ValVT, Reg, LocVT, LocInfo));
    }
    return true;
}

fn CC_X86_VectorCallGetSSEs(ValVT: *MVT) -> ArrayRef<MCPhysReg> {
    if ValVT.is512BitVector() {
        let mut RegListZMM: []MCPhysReg = zeroed();
        return RegListZMM();
    }
    if ValVT.is256BitVector() {
        let mut RegListYMM: []MCPhysReg = zeroed();
        return RegListYMM();
    }
    let mut RegListXMM: []MCPhysReg = zeroed();
    return RegListXMM();
}

fn CC_X86_64_VectorCallGetGPRs() -> ArrayRef<MCPhysReg> {
    let mut RegListGPR: []MCPhysReg = zeroed();
    return RegListGPR();
}

fn CC_X86_VectorCallAssignRegister(ValNo: *mut u32, ValVT: *mut MVT, LocVT: *mut MVT, LocInfo: *mut LocInfo, ArgFlags: *mut ArgFlagsTy, State: *mut CCState) -> bool {
    let mut RegList: ArrayRef<MCPhysReg> = zeroed();
    let mut Is64bit: bool = false;
    llvm_unreachable_internal("Clang should ensure that hva marked vectors will have an available register.", "llvm\\lib\\Target\\X86\\X86CallingConv.cpp", 118);
    return false;
}

fn CC_X86_64_VectorCall(ValNo: *mut u32, ValVT: *mut MVT, LocVT: *mut MVT, LocInfo: *mut LocInfo, ArgFlags: *mut ArgFlagsTy, State: *mut CCState) -> bool {
    if ArgFlags.isSecArgPass() {
        if ArgFlags.isHva() {
            return CC_X86_VectorCallAssignRegister(ValNo, ValVT, LocVT, LocInfo, ArgFlags, State);
        }
        return true;
    }
    if operator!((ValVT.isFloatingPoint() || (ValVT.isVector() && ValVT.getSizeInBits()))) {
        if State.isAllocated {
            State as void;
        }
        return false;
    }
    if !ArgFlags.isHva() || ArgFlags.isHvaStart() {
        State as void;
        if State {
            Reg.operator unsigned int();
        } else {
            let mut TRI: *TargetRegisterInfo = State.getMachineFunction().getSubtarget().getRegisterInfo();
            if TRI.regsOverlap || TRI.regsOverlap {
                State.AllocateStack(8, Align { ShiftValue: 8 });
            }
            if !ArgFlags.isHva() {
                State.addLoc(getReg(ValNo, ValVT, Reg, LocVT, LocInfo, false));
                return true;
            }
        }
    }
    return ArgFlags.isHva();
}

fn CC_X86_32_VectorCall(ValNo: *mut u32, ValVT: *mut MVT, LocVT: *mut MVT, LocInfo: *mut LocInfo, ArgFlags: *mut ArgFlagsTy, State: *mut CCState) -> bool {
    if ArgFlags.isSecArgPass() {
        if ArgFlags.isHva() {
            return CC_X86_VectorCallAssignRegister(ValNo, ValVT, LocVT, LocInfo, ArgFlags, State);
        }
        return true;
    }
    if operator!((ValVT.isFloatingPoint() || (ValVT.isVector() && ValVT.getSizeInBits()))) {
        return false;
    }
    if ArgFlags.isHva() {
        return true;
    }
    if State {
        Reg.operator unsigned int();
    } else {
        State.addLoc(getReg(ValNo, ValVT, Reg, LocVT, LocInfo, false));
        return true;
    }
    if !ValVT.isFloatingPoint() {
        LocVT = MVT { SimpleTy: i32 };
        LocInfo = Indirect;
        ArgFlags.setInReg();
    }
    return false;
}

fn CC_X86_AnyReg_Error(arg: *mut u32, arg: *mut MVT, arg: *mut MVT, arg: *mut LocInfo, arg: *mut ArgFlagsTy, arg: *mut CCState) -> bool {
    llvm_unreachable_internal("The AnyReg calling convention is only supported by the stackmap and patchpoint intrinsics.", "llvm\\lib\\Target\\X86\\X86CallingConv.cpp", 232);
    return false;
}

fn CC_X86_32_MCUInReg(ValNo: *mut u32, ValVT: *mut MVT, LocVT: *mut MVT, LocInfo: *mut LocInfo, ArgFlags: *mut ArgFlagsTy, State: *mut CCState) -> bool {
    let mut RegList: []MCPhysReg = zeroed();
    let mut NumRegs: u32 = size(RegList);
    let mut PendingMembers: *mut SmallVectorImpl<CCValAssign> = State.getPendingLocs();
    if ArgFlags.isSplit() || operator!(PendingMembers()()) {
        PendingMembers()(getPending(ValNo, ValVT, LocVT, LocInfo, 0));
        if !ArgFlags.isSplitEnd() {
            return true;
        }
    }
    if PendingMembers()() {
        if State {
            Reg.operator unsigned int();
        } else {
            State.addLoc(getReg(ValNo, ValVT, Reg, LocVT, LocInfo, false));
            return true;
        }
        return false;
    }
    assert!(ArgFlags.isSplitEnd();
    let mut FirstFree: u32 = State.getFirstUnallocated;
    let mut UseRegs: bool = PendingMembers()() <= min(2, NumRegs - FirstFree);
    PendingMembers()();
    return true;
}

fn CC_X86_Intr(ValNo: *mut u32, ValVT: *mut MVT, LocVT: *mut MVT, LocInfo: *mut LocInfo, ArgFlags: *mut ArgFlagsTy, State: *mut CCState) -> bool {
    let mut MF: *MachineFunction = State.getMachineFunction();
    let mut ArgCount: u64 = State.getMachineFunction().getFunction().arg_size();
    let mut Is64Bit: bool = MF();
    let mut SlotSize: u32 = if Is64Bit { 8 } else { 4 };
    let mut Offset: u32 = 0;
    if ArgCount == 1 && ValNo == 0 {
        Offset = State.AllocateStack(5 * SlotSize, Align { ShiftValue: 4 });
    } else if ArgCount == 2 && ValNo == 0 {
        Offset = SlotSize;
    } else if ArgCount == 2 && ValNo == 1 {
        Offset = 0;
        State.AllocateStack(6 * SlotSize, Align { ShiftValue: 4 }) as void;
    } else {
        report_fatal_error("unsupported x86 interrupt prototype", true);
    }
    if Is64Bit && ArgCount == 2 {
        Offset += SlotSize;
    }
    State.addLoc(getMem(ValNo, ValVT, Offset, LocVT, LocInfo, false));
    return true;
}

fn CC_X86_64_Pointer(ValNo: *mut u32, ValVT: *mut MVT, LocVT: *mut MVT, LocInfo: *mut LocInfo, ArgFlags: *mut ArgFlagsTy, State: *mut CCState) -> bool {
    if LocVT != i64 {
        LocVT = MVT { SimpleTy: i64 };
        LocInfo = ZExt;
    }
    return false;
}

fn CC_X86_64_I128(ValNo: *mut u32, ValVT: *mut MVT, LocVT: *mut MVT, LocInfo: *mut LocInfo, ArgFlags: *mut ArgFlagsTy, State: *mut CCState) -> bool {
    assert!(ValVT == i64, "Should have i64 parts");
    let mut PendingMembers: *mut SmallVectorImpl<CCValAssign> = State.getPendingLocs();
    PendingMembers()(getPending(ValNo, ValVT, LocVT, LocInfo, 0));
    if !ArgFlags.isInConsecutiveRegsLast() {
        return true;
    }
    let mut NumRegs: u32 = PendingMembers()();
    assert!(NumRegs == 2, "Should have two parts");
    let mut Regs: []MCPhysReg = zeroed();
    let mut Allocated: ArrayRef<MCPhysReg> = zeroed();
    if operator!() {} else {
        let mut Offset: i64 = State.AllocateStack(16, Align { ShiftValue: 16 });
    }
    State.addLoc;
    State.addLoc;
    PendingMembers()();
    return true;
}

fn CC_X86_32_I128_FP128(ValNo: *mut u32, ValVT: *mut MVT, LocVT: *mut MVT, LocInfo: *mut LocInfo, ArgFlags: *mut ArgFlagsTy, State: *mut CCState) -> bool {
    assert!(ValVT == i32, "Should have i32 parts");
    let mut PendingMembers: *mut SmallVectorImpl<CCValAssign> = State.getPendingLocs();
    PendingMembers()(getPending(ValNo, ValVT, LocVT, LocInfo, 0));
    if !ArgFlags.isInConsecutiveRegsLast() {
        return true;
    }
    (((operator!(operator!((PendingMembers()() == 4 && "Should have four parts")))) || (_wassert(L"PendingMembers.size() == 4 && \"Should have four parts\"", L"llvm\\lib\\Target\\X86\\X86CallingConv.cpp", (392) as u32) , 0)) as void);
    let mut Offset: i64 = State.AllocateStack(16, Align { ShiftValue: 16 });
    State.addLoc;
    State.addLoc;
    State.addLoc;
    State.addLoc;
    PendingMembers()();
    return true;
}
