fn classifyFirst(MI: *MachineInstr) -> FirstMacroFusionInstKind {
    return classifyFirstOpcodeInMacroFusion(MI.getOpcode());
}

fn classifySecond(MI: *MachineInstr) -> SecondMacroFusionInstKind {
    let mut CC: CondCode = getCondFromBranch(MI);
    return classifySecondCondCodeInMacroFusion(CC);
}

fn shouldScheduleAdjacent(TII: *TargetInstrInfo, TSI: *TargetSubtargetInfo, FirstMI: *MachineInstr, SecondMI: *MachineInstr, Dep: *SDep) -> bool {
    if isNonDataDep(Dep) {
        return false;
    }
    let mut ST: *X86Subtarget = null;
    if operator!((ST()() || ST()())) {
        return false;
    }
    let mut BranchKind: SecondMacroFusionInstKind = classifySecond(SecondMI);
    if BranchKind == Invalid {
        return false;
    }
    if FirstMI == null {
        return true;
    }
    let mut TestKind: FirstMacroFusionInstKind = classifyFirst(*FirstMI);
    if ST()() {
        return (TestKind == Cmp || TestKind == Test);
    }
    if ST()() {
        return isMacroFused(TestKind, BranchKind);
    }
    llvm_unreachable_internal("unknown fusion type", "llvm\\lib\\Target\\X86\\X86MacroFusion.cpp", 68);
}

fn createX86MacroFusionDAGMutation() -> i32 {}
