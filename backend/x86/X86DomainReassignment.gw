static mut NumClosuresConverted: Statistic = Statistic { "x86-domain-reassignment", "NumClosuresConverted", "Number of closures converted by the pass" };

static mut NumClosuresBuilt: Statistic = Statistic { "x86-domain-reassignment", "NumClosuresBuilt", "Number of closures built by the pass" };

static mut DisableX86DomainReassignment: i32 = "disable-x86-domain-reassignment";

enum RegDomain {
    NoDomain = 0,
    GPRDomain = 1,
    MaskDomain = 2,
    OtherDomain = 3,
    NumDomains = 4,
}

fn isMask(RC: *TargetRegisterClass, TRI: *TargetRegisterInfo) -> bool {}

fn getDomain(RC: *TargetRegisterClass, TRI: *TargetRegisterInfo) -> RegDomain {
    if TRI.isGeneralPurposeRegisterClass(RC) {
        return GPRDomain;
    }
    if isMask(RC, TRI) {
        return MaskDomain;
    }
    return OtherDomain;
}

fn getDstRC(SrcRC: *TargetRegisterClass, Domain: RegDomain) -> *TargetRegisterClass {
    assert!(Domain == MaskDomain, "add domain");
    llvm_unreachable_internal("add register class", "llvm\\lib\\Target\\X86\\X86DomainReassignment.cpp", 71);
    return null;
}

struct InstrConverterBase {
    SrcOpcode: u32,
}

fn InstrConverterBase::~InstrConverterBase(self) {}

fn InstrConverterBase::isLegal(self: *InstrConverterBase, MI: *MachineInstr, TII: *TargetInstrInfo) -> bool {
    assert!(MI.getOpcode() == self.SrcOpcode, "Wrong instruction passed to converter");
    return true;
}

struct InstrIgnore {
    SrcOpcode: u32,
}

fn InstrIgnore::convertInstr(self: *InstrIgnore, MI: *mut MachineInstr, TII: *TargetInstrInfo, MRI: *mut MachineRegisterInfo) -> bool {
    assert!(self.isLegal(MI, TII), "Cannot convert instruction");
    return false;
}

fn InstrIgnore::getExtraCost(self: *InstrIgnore, MI: *MachineInstr, MRI: *mut MachineRegisterInfo) -> f64 {
    return 0;
}

fn InstrIgnore::isLegal(self: *InstrIgnore, MI: *MachineInstr, TII: *TargetInstrInfo) -> bool {
    assert!(MI.getOpcode() == self.SrcOpcode, "Wrong instruction passed to converter");
    return true;
}

struct InstrReplacer {
    SrcOpcode: u32,
    DstOpcode: u32,
}

fn InstrReplacer::isLegal(self: *InstrReplacer, MI: *MachineInstr, TII: *TargetInstrInfo) -> bool {
    if !self.isLegal(MI, TII) {
        return false;
    }
    for MO in MI.implicit_operands() {
        if MO.isReg() && MO.isDef() && !MO.isDead() && operator!(TII.get(MO.getReg())) {
            return false;
        }
    }
    return true;
}

fn InstrReplacer::convertInstr(self: *InstrReplacer, MI: *mut MachineInstr, TII: *TargetInstrInfo, MRI: *mut MachineRegisterInfo) -> bool {
    assert!(self.isLegal(MI, TII), "Cannot convert instruction");
    let mut Bld: MachineInstrBuilder = BuildMI(*MI.getParent(), MI, MI.getDebugLoc(), TII.get);
    for Op in MI.explicit_operands() {
        Bld.add(Op);
    }
    return true;
}

fn InstrReplacer::getExtraCost(self: *InstrReplacer, MI: *MachineInstr, MRI: *mut MachineRegisterInfo) -> f64 {
    return 0;
}

struct InstrReplacerDstCOPY {
    SrcOpcode: u32,
    DstOpcode: u32,
}

fn InstrReplacerDstCOPY::convertInstr(self: *InstrReplacerDstCOPY, MI: *mut MachineInstr, TII: *TargetInstrInfo, MRI: *mut MachineRegisterInfo) -> bool {
    assert!(self.isLegal(MI, TII), "Cannot convert instruction");
    let mut MBB: *mut MachineBasicBlock = MI.getParent();
    let mut DL: *DebugLoc = MI.getDebugLoc();
    let mut Reg: Register = MRI(TII.getRegClass(TII.get, 0));
    let mut Bld: MachineInstrBuilder = BuildMI(*MBB, MI, DL, TII.get, Reg);
    BuildMI(*MBB, MI, DL, TII.get)(MI.getOperand(0))(Reg);
    return true;
}

fn InstrReplacerDstCOPY::getExtraCost(self: *InstrReplacerDstCOPY, MI: *MachineInstr, MRI: *mut MachineRegisterInfo) -> f64 {
    return 0;
}

fn InstrReplacerDstCOPY::isLegal(self: *InstrReplacerDstCOPY, MI: *MachineInstr, TII: *TargetInstrInfo) -> bool {
    assert!(MI.getOpcode() == self.SrcOpcode, "Wrong instruction passed to converter");
    return true;
}

struct InstrCOPYReplacer {
    SrcOpcode: u32,
    DstOpcode: u32,
    DstDomain: RegDomain,
}

fn InstrCOPYReplacer::isLegal(self: *InstrCOPYReplacer, MI: *MachineInstr, TII: *TargetInstrInfo) -> bool {
    if !self.isLegal(MI, TII) {
        return false;
    }
    let mut DstReg: Register = MI.getOperand(0).getReg();
    if  {
        return false;
    }
    let mut SrcReg: Register = MI.getOperand(1).getReg();
    if  {
        return false;
    }
    return true;
}

fn InstrCOPYReplacer::getExtraCost(self: *InstrCOPYReplacer, MI: *MachineInstr, MRI: *mut MachineRegisterInfo) -> f64 {
    assert!(MI.getOpcode() == COPY, "Expected a COPY");
    for MO in MI.operands() {
        if MO.getReg().isPhysical() {
            return 1;
        }
        let mut OpDomain: RegDomain = getDomain(MRI.getRegClass(MO.getReg()), MRI.getTargetRegisterInfo());
        if OpDomain == self.DstDomain {
            return -1;
        }
    }
    return 0;
}

fn InstrCOPYReplacer::convertInstr(self: *InstrCOPYReplacer, MI: *mut MachineInstr, TII: *TargetInstrInfo, MRI: *mut MachineRegisterInfo) -> bool {
    assert!(self.isLegal(MI, TII), "Cannot convert instruction");
    let mut Bld: MachineInstrBuilder = BuildMI(*MI.getParent(), MI, MI.getDebugLoc(), TII.get);
    for Op in MI.explicit_operands() {
        Bld.add(Op);
    }
    return true;
}

struct InstrReplaceWithCopy {
    SrcOpcode: u32,
    SrcOpIdx: u32,
}

fn InstrReplaceWithCopy::convertInstr(self: *InstrReplaceWithCopy, MI: *mut MachineInstr, TII: *TargetInstrInfo, MRI: *mut MachineRegisterInfo) -> bool {
    assert!(self.isLegal(MI, TII), "Cannot convert instruction");
    BuildMI(*MI.getParent(), MI, MI.getDebugLoc(), TII.get)(void { MI.getOperand(0), MI.getOperand(self.SrcOpIdx) });
    return true;
}

fn InstrReplaceWithCopy::getExtraCost(self: *InstrReplaceWithCopy, MI: *MachineInstr, MRI: *mut MachineRegisterInfo) -> f64 {
    return 0;
}

fn InstrReplaceWithCopy::isLegal(self: *InstrReplaceWithCopy, MI: *MachineInstr, TII: *TargetInstrInfo) -> bool {
    assert!(MI.getOpcode() == self.SrcOpcode, "Wrong instruction passed to converter");
    return true;
}

struct Closure {
    Edges: i32,
    Instrs: SmallVector<MachineInstr *, 8>,
    LegalDstDomains: bitset<NumDomains>,
    ID: u32,
}

fn Closure::setAllIllegal(self) {}

fn Closure::hasLegalDstDomain(self: *Closure) -> bool {}

fn Closure::isLegal(self: *Closure, RD: RegDomain) -> bool {}

fn Closure::setIllegal(self, RD: RegDomain) {}

fn Closure::empty(self: *Closure) -> bool {}

fn Closure::insertEdge(self, Reg: Register) -> bool {}

fn Closure::edges(self: *Closure) -> i32 {}

fn Closure::addInstruction(self, I: *mut MachineInstr) {}

fn Closure::instructions(self: *Closure) -> ArrayRef<MachineInstr *> {}

fn Closure::dump(self: *Closure, MRI: *MachineRegisterInfo) {
    dbgs() << "Registers: ";
    let mut LS: ListSeparator = ListSeparator { ", ", "" };
    dbgs() << "\n" << "Instructions:";
    dbgs() << "\n";
}

fn Closure::getID(self: *Closure) -> u32 {
    return self.ID;
}

