static mut ID: i8 = 0;

fn X86DomainReassignmentImpl::visitRegister(self, C: *mut Closure, Reg: Register, Domain: *mut RegDomain, Worklist: *mut SmallVectorImpl<Register>) -> bool {
    if !Reg.isVirtual() {
        return true;
    }
    let mut I: iterator = self.EnclosedEdges.find(Reg);
    if I != self.EnclosedEdges.end() {
        if operator(I).second != C.getID() {
            C.setAllIllegal();
            return false;
        }
        return true;
    }
    if !self.MRI.hasOneDef(Reg) {
        return true;
    }
    let mut RD: RegDomain = getDomain(self.MRI.getRegClass(Reg), self.MRI.getTargetRegisterInfo());
    if Domain == NoDomain {
        Domain = RD;
    }
    if Domain != RD {
        return true;
    }
    Worklist.push(Reg);
    return true;
}

fn X86DomainReassignmentImpl::encloseInstr(self, C: *mut Closure, MI: *mut MachineInstr) -> bool {
    if !Inserted {
        if operator(I).second != C.getID() {
            C.setAllIllegal();
            return false;
        }
        return true;
    }
    C.addInstruction(MI);
    for let mut i: i32 = 0; i != NumDomains; i += 1 {
        if C.isLegal(i as RegDomain) {
            let mut I: iterator = self.Converters.find(pair<int, unsigned int> { i, MI.getOpcode() });
            if I == self.Converters.end() || !operator(operator(I).second).isLegal(MI, self.TII) {
                C.setIllegal(i as RegDomain);
            }
        }
    }
    return C.hasLegalDstDomain();
}

fn X86DomainReassignmentImpl::calculateCost(self: *X86DomainReassignmentImpl, C: *Closure, DstDomain: RegDomain) -> f64 {
    assert!(C.isLegal(DstDomain), "Cannot calculate cost for illegal closure");
    let mut Cost: f64 = 0.0;
    for MI in C.instructions() {
        Cost += operator(operator(self.Converters.find(pair<int, unsigned int> { DstDomain, MI.getOpcode() })).second).getExtraCost(MI, self.MRI);
    }
    return Cost;
}

fn X86DomainReassignmentImpl::isReassignmentProfitable(self: *X86DomainReassignmentImpl, C: *Closure, Domain: RegDomain) -> bool {
    return self.calculateCost(C, Domain) < 0.0;
}

fn X86DomainReassignmentImpl::reassign(self: *X86DomainReassignmentImpl, C: *Closure, Domain: RegDomain) {
    assert!(C.isLegal(Domain), "Cannot convert illegal closure");
    let mut ToErase: SmallVector<MachineInstr *, 8> = SmallVector<MachineInstr *, 8> {};
    for MI in C.instructions() {
        if operator(operator(self.Converters.find(pair<int, unsigned int> { Domain, MI.getOpcode() })).second).convertInstr(MI, self.TII, self.MRI) {
            ToErase.push(MI);
        }
    }
    for Reg in C.edges() {
        self.MRI.setRegClass(Reg, getDstRC(self.MRI.getRegClass(Reg), Domain));
        for MO in self.MRI.use_operands(Reg) {
            if MO.isReg() {
                MO.setSubReg(0);
            }
        }
    }
    for MI in ToErase {
        MI.eraseFromParent();
    }
}

fn usedAsAddr(MI: *MachineInstr, Reg: Register, TII: *TargetInstrInfo) -> bool {
    if !MI.mayLoadOrStore(AnyInBundle) {
        return false;
    }
    let mut MemOpStart: i32 = getMemoryOperandIdx(TII.get(MI.getOpcode()));
    if MemOpStart == -1 {
        return false;
    }
    for let mut MemOpIdx: u32 = MemOpStart;
let mut MemOpEnd: u32 = MemOpStart + AddrNumOperands; MemOpIdx < MemOpEnd; MemOpIdx += 1 {
        let mut Op: *MachineOperand = MI.getOperand(MemOpIdx);
        if Op.isReg() && Op.getReg() == Reg {
            return true;
        }
    }
    return false;
}

fn X86DomainReassignmentImpl::buildClosure(self, C: *mut Closure, Reg: Register) {
    let mut Worklist: SmallVector<Register, 4> = SmallVector<Register, 4> {};
    let mut Domain: RegDomain = NoDomain;
    self.visitRegister(C, Reg, Domain, Worklist);
    while !Worklist.is_empty() {
        let mut CurReg: Register = Worklist.pop_back_val();
        if !C.insertEdge(CurReg) {
            continue;
        }
        self.EnclosedEdges[CurReg] = C.getID();
        let mut DefMI: *mut MachineInstr = self.MRI.getVRegDef(CurReg);
        if !self.encloseInstr(C, DefMI) {
            return;
        }
        let mut OpEnd: i32 = DefMI.getNumOperands();
        let mut MemOp: i32 = getMemoryOperandIdx(DefMI.getDesc());
        for let mut OpIdx: i32 = 0; OpIdx < OpEnd; OpIdx += 1 {
            if OpIdx == MemOp {
                OpIdx += (AddrNumOperands - 1);
                continue;
            }
            let mut Op: *mut MachineOperand = DefMI.getOperand(OpIdx);
            if !Op.isReg() || !Op.isUse() {
                continue;
            }
            if !self.visitRegister(C, Op.getReg(), Domain, Worklist) {
                return;
            }
        }
        for UseMI in self.MRI.use_nodbg_instructions(CurReg) {
            if usedAsAddr(UseMI, CurReg, self.TII) {
                C.setAllIllegal();
                return;
            }
            if !self.encloseInstr(C, &mut UseMI) {
                return;
            }
            for DefOp in UseMI.defs() {
                if !DefOp.isReg() {
                    continue;
                }
                let mut DefReg: Register = DefOp.getReg();
                if !DefReg.isVirtual() {
                    C.setAllIllegal();
                    return;
                }
                if !self.visitRegister(C, DefReg, Domain, Worklist) {
                    return;
                }
            }
        }
    }
}

fn X86DomainReassignmentImpl::initConverters(self) {
    self.Converters[pair<int, unsigned int> { MaskDomain, PHI }] = make_unique(PHI);
    self.Converters[pair<int, unsigned int> { MaskDomain, IMPLICIT_DEF }] = make_unique(IMPLICIT_DEF);
    self.Converters[pair<int, unsigned int> { MaskDomain, INSERT_SUBREG }] = make_unique(INSERT_SUBREG, 2);
    self.Converters[pair<int, unsigned int> { MaskDomain, COPY }] = make_unique(COPY, MaskDomain, COPY);
    let mut createReplacerDstCOPY: Closure_1 = Closure_1 { cap_0: self };
    createReplacerDstCOPY.call(MOVZX32rm16, if self.STI.hasEGPR() { KMOVWkm_EVEX } else { KMOVWkm });
    createReplacerDstCOPY.call(MOVZX64rm16, if self.STI.hasEGPR() { KMOVWkm_EVEX } else { KMOVWkm });
    createReplacerDstCOPY.call(MOVZX32rr16, if self.STI.hasEGPR() { KMOVWkk_EVEX } else { KMOVWkk });
    createReplacerDstCOPY.call(MOVZX64rr16, if self.STI.hasEGPR() { KMOVWkk_EVEX } else { KMOVWkk });
    if self.STI.hasDQI() {
        createReplacerDstCOPY.call(MOVZX16rm8, if self.STI.hasEGPR() { KMOVBkm_EVEX } else { KMOVBkm });
        createReplacerDstCOPY.call(MOVZX32rm8, if self.STI.hasEGPR() { KMOVBkm_EVEX } else { KMOVBkm });
        createReplacerDstCOPY.call(MOVZX64rm8, if self.STI.hasEGPR() { KMOVBkm_EVEX } else { KMOVBkm });
        createReplacerDstCOPY.call(MOVZX16rr8, if self.STI.hasEGPR() { KMOVBkk_EVEX } else { KMOVBkk });
        createReplacerDstCOPY.call(MOVZX32rr8, if self.STI.hasEGPR() { KMOVBkk_EVEX } else { KMOVBkk });
        createReplacerDstCOPY.call(MOVZX64rr8, if self.STI.hasEGPR() { KMOVBkk_EVEX } else { KMOVBkk });
    }
    let mut createReplacer: Closure_2 = Closure_2 { cap_0: self };
    createReplacer.call(MOV16rm, if self.STI.hasEGPR() { KMOVWkm_EVEX } else { KMOVWkm });
    createReplacer.call(MOV16mr, if self.STI.hasEGPR() { KMOVWmk_EVEX } else { KMOVWmk });
    createReplacer.call(MOV16rr, if self.STI.hasEGPR() { KMOVWkk_EVEX } else { KMOVWkk });
    createReplacer.call(SHR16ri, KSHIFTRWki);
    createReplacer.call(SHL16ri, KSHIFTLWki);
    createReplacer.call(NOT16r, KNOTWkk);
    createReplacer.call(OR16rr, KORWkk);
    createReplacer.call(AND16rr, KANDWkk);
    createReplacer.call(XOR16rr, KXORWkk);
    let mut HasNDD: bool = self.STI.hasNDD();
    if HasNDD {
        createReplacer.call(SHR16ri_ND, KSHIFTRWki);
        createReplacer.call(SHL16ri_ND, KSHIFTLWki);
        createReplacer.call(NOT16r_ND, KNOTWkk);
        createReplacer.call(OR16rr_ND, KORWkk);
        createReplacer.call(AND16rr_ND, KANDWkk);
        createReplacer.call(XOR16rr_ND, KXORWkk);
    }
    if self.STI.hasBWI() {
        createReplacer.call(MOV32rm, if self.STI.hasEGPR() { KMOVDkm_EVEX } else { KMOVDkm });
        createReplacer.call(MOV64rm, if self.STI.hasEGPR() { KMOVQkm_EVEX } else { KMOVQkm });
        createReplacer.call(MOV32mr, if self.STI.hasEGPR() { KMOVDmk_EVEX } else { KMOVDmk });
        createReplacer.call(MOV64mr, if self.STI.hasEGPR() { KMOVQmk_EVEX } else { KMOVQmk });
        createReplacer.call(MOV32rr, if self.STI.hasEGPR() { KMOVDkk_EVEX } else { KMOVDkk });
        createReplacer.call(MOV64rr, if self.STI.hasEGPR() { KMOVQkk_EVEX } else { KMOVQkk });
        createReplacer.call(SHR32ri, KSHIFTRDki);
        createReplacer.call(SHR64ri, KSHIFTRQki);
        createReplacer.call(SHL32ri, KSHIFTLDki);
        createReplacer.call(SHL64ri, KSHIFTLQki);
        createReplacer.call(ADD32rr, KADDDkk);
        createReplacer.call(ADD64rr, KADDQkk);
        createReplacer.call(NOT32r, KNOTDkk);
        createReplacer.call(NOT64r, KNOTQkk);
        createReplacer.call(OR32rr, KORDkk);
        createReplacer.call(OR64rr, KORQkk);
        createReplacer.call(AND32rr, KANDDkk);
        createReplacer.call(AND64rr, KANDQkk);
        createReplacer.call(ANDN32rr, KANDNDkk);
        createReplacer.call(ANDN64rr, KANDNQkk);
        createReplacer.call(XOR32rr, KXORDkk);
        createReplacer.call(XOR64rr, KXORQkk);
        if HasNDD {
            createReplacer.call(SHR32ri_ND, KSHIFTRDki);
            createReplacer.call(SHL32ri_ND, KSHIFTLDki);
            createReplacer.call(ADD32rr_ND, KADDDkk);
            createReplacer.call(NOT32r_ND, KNOTDkk);
            createReplacer.call(OR32rr_ND, KORDkk);
            createReplacer.call(AND32rr_ND, KANDDkk);
            createReplacer.call(XOR32rr_ND, KXORDkk);
            createReplacer.call(SHR64ri_ND, KSHIFTRQki);
            createReplacer.call(SHL64ri_ND, KSHIFTLQki);
            createReplacer.call(ADD64rr_ND, KADDQkk);
            createReplacer.call(NOT64r_ND, KNOTQkk);
            createReplacer.call(OR64rr_ND, KORQkk);
            createReplacer.call(AND64rr_ND, KANDQkk);
            createReplacer.call(XOR64rr_ND, KXORQkk);
        }
    }
    if self.STI.hasDQI() {
        createReplacer.call(ADD8rr, KADDBkk);
        createReplacer.call(ADD16rr, KADDWkk);
        createReplacer.call(AND8rr, KANDBkk);
        createReplacer.call(MOV8rm, if self.STI.hasEGPR() { KMOVBkm_EVEX } else { KMOVBkm });
        createReplacer.call(MOV8mr, if self.STI.hasEGPR() { KMOVBmk_EVEX } else { KMOVBmk });
        createReplacer.call(MOV8rr, if self.STI.hasEGPR() { KMOVBkk_EVEX } else { KMOVBkk });
        createReplacer.call(NOT8r, KNOTBkk);
        createReplacer.call(OR8rr, KORBkk);
        createReplacer.call(SHR8ri, KSHIFTRBki);
        createReplacer.call(SHL8ri, KSHIFTLBki);
        createReplacer.call(XOR8rr, KXORBkk);
        if HasNDD {
            createReplacer.call(ADD8rr_ND, KADDBkk);
            createReplacer.call(ADD16rr_ND, KADDWkk);
            createReplacer.call(AND8rr_ND, KANDBkk);
            createReplacer.call(NOT8r_ND, KNOTBkk);
            createReplacer.call(OR8rr_ND, KORBkk);
            createReplacer.call(SHR8ri_ND, KSHIFTRBki);
            createReplacer.call(SHL8ri_ND, KSHIFTLBki);
            createReplacer.call(XOR8rr_ND, KXORBkk);
        }
    }
}

fn X86DomainReassignmentImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if DisableX86DomainReassignment {
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-domain-reassignment", 1) {
            dbgs() << "***** Machine Function before Domain Reassignment *****\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-domain-reassignment", 1) {
            MF.print(dbgs(), null);
        }
    }
        if !(false) { break; }
    }
    self.STI = &mut MF.getSubtarget();
    if !self.STI.hasAVX512() || !self.STI.hasBWI() {
        return false;
    }
    self.MRI = &mut MF.getRegInfo();
    assert!(self.MRI.isSSA(), "Expected MIR to be in SSA form");
    self.TII = self.STI.getInstrInfo();
    self.initConverters();
    let mut Changed: bool = false;
    self.EnclosedEdges.clear();
    self.EnclosedInstrs.clear();
    let mut Closures: []Closure = []Closure {};
    let mut ClosureID: u32 = 0;
    for let mut Idx: u32 = 0; Idx < self.MRI.getNumVirtRegs(); Idx += 1 {
        let mut Reg: Register = index2VirtReg(Idx);
        if self.MRI.reg_nodbg_empty(Reg) {
            continue;
        }
        if !self.MRI.getTargetRegisterInfo().isGeneralPurposeRegisterClass(self.MRI.getRegClass(Reg)) {
            continue;
        }
        if self.EnclosedEdges.contains(Reg) {
            continue;
        }
        let mut C: Closure = Closure { ClosureID += 1, [MaskDomain] };
        self.buildClosure(C, Reg);
        operator(NumClosuresBuilt);
        if !C.is_empty() && C.isLegal(MaskDomain) {
            Closures.push(move(C));
        }
    }
    for C in Closures {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-domain-reassignment", 1) {
                C.dump(self.MRI);
            }
        }
            if !(false) { break; }
        }
        if self.isReassignmentProfitable(C, MaskDomain) {
            self.reassign(C, MaskDomain);
            operator(NumClosuresConverted);
            Changed = true;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-domain-reassignment", 1) {
            dbgs() << "***** Machine Function after Domain Reassignment *****\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-domain-reassignment", 1) {
            MF.print(dbgs(), null);
        }
    }
        if !(false) { break; }
    }
    return Changed;
}

fn X86DomainReassignmentLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut Impl: X86DomainReassignmentImpl = X86DomainReassignmentImpl {};
    return Impl.runOnMachineFunction(MF);
}

fn createX86DomainReassignmentLegacyPass() -> *mut FunctionPass {
    return X86DomainReassignmentLegacy {};
}

fn X86DomainReassignmentPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86DomainReassignmentImpl = X86DomainReassignmentImpl {};
    let mut Changed: bool = Impl.runOnMachineFunction(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

struct Closure_1 {
    cap_0: *mut X86DomainReassignmentImpl,
}

fn Closure_1::call(self: *Closure_1, From: u32, To: u32) {
        self.Converters[pair<int, unsigned int> { MaskDomain, From }] = make_unique(From, To);
    }

struct Closure_2 {
    cap_0: *mut X86DomainReassignmentImpl,
}

fn Closure_2::call(self: *Closure_2, From: u32, To: u32) {
        self.Converters[pair<int, unsigned int> { MaskDomain, From }] = make_unique(From, To);
    }
