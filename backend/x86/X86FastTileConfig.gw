struct X86FastTileConfigImpl {
    MF: *mut MachineFunction,
    TII: *TargetInstrInfo,
    MRI: *mut MachineRegisterInfo,
    TRI: *TargetRegisterInfo,
    X86FI: *mut X86MachineFunctionInfo,
}

struct X86FastTileConfigLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86FastTileConfigLegacy::getPassName(self: *X86FastTileConfigLegacy) -> str {
    return "Fast Tile Register Configure";
}

fn X86FastTileConfigLegacy::getAnalysisUsage(self: *X86FastTileConfigLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesAll();
    self.getAnalysisUsage(AU);
}

fn X86FastTileConfigLegacy::getRequiredProperties(self: *X86FastTileConfigLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoPHIs();
}

fn X86FastTileConfigLegacy::getPassKind(self: *X86FastTileConfigLegacy) -> PassKind {
    return self.Kind;
}

fn X86FastTileConfigLegacy::getPassID(self: *X86FastTileConfigLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86FastTileConfigLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FastTileConfigLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FastTileConfigLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86FastTileConfigLegacy::getResolver(self: *X86FastTileConfigLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86FastTileConfigLegacy::getSetProperties(self: *X86FastTileConfigLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86FastTileConfigLegacy::getClearedProperties(self: *X86FastTileConfigLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn isTileDef(MRI: *mut MachineRegisterInfo, MI: *mut MachineInstr) -> bool {
    assert!(MI.isPHI() == false);
    if MI.isDebugInstr() || MI.isCopy() || MI.getNumOperands() < 3 || !MI.isPseudo(IgnoreBundle) {
        return false;
    }
    let mut MO: *mut MachineOperand = MI.getOperand(0);
    if MO.isReg() {
        let mut Reg: Register = MO.getReg();
        if Reg.isVirtual() {
            if  {
                return true;
            }
        }
        if  {
            return true;
        }
    }
    return false;
}

fn getTMMIndex(Reg: Register) -> u32 {
    llvm_unreachable_internal("Invalid Tmm Reg!", "llvm\\lib\\Target\\X86\\X86FastTileConfig.cpp", 114);
}

fn X86FastTileConfigImpl::configBasicBlock(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Change: bool = false;
    let mut ShapeInfos: pair<unsigned int, ShapeT>, 6> = zeroed();
    return Change;
}

fn X86FastTileConfigImpl::runOnMachineFunction(self, MFunc: *mut MachineFunction) -> bool {
    self.X86FI = MFunc;
    if self.X86FI.getAMXProgModel() != ManagedRA {
        return false;
    }
    self.MF = &mut MFunc;
    self.MRI = &mut MFunc.getRegInfo();
    let mut ST: *TargetSubtargetInfo = operator&(MFunc);
    self.TRI = ST.getRegisterInfo();
    self.TII = MFunc.getSubtarget().getInstrInfo();
    let mut Change: bool = false;
    for MBB in MFunc {
        Change |= self.configBasicBlock(MBB);
    }
    return Change;
}

fn createX86FastTileConfigLegacyPass() -> *mut FunctionPass {
    return X86FastTileConfigLegacy {};
}

fn X86FastTileConfigLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut Impl: X86FastTileConfigImpl = X86FastTileConfigImpl {};
    return Impl.runOnMachineFunction(MF);
}

fn X86FastTileConfigPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86FastTileConfigImpl = X86FastTileConfigImpl {};
    Impl.runOnMachineFunction(MF);
    return getMachineFunctionPassPreservedAnalyses();
}
