static mut ID: i8 = 0;

fn X86PreTileConfigImpl::collectShapeInfo(self, MI: *mut MachineInstr) {
    let mut RecordShape: Closure_2 = Closure_2 { cap_0: self };
    let mut WorkList: SmallVector<Register, 8> = [MI.getOperand(1).getReg(), MI.getOperand(2).getReg()];
    while !WorkList.is_empty() {
        let mut R: Register = WorkList.pop_back_val();
        let mut DefMI: *mut MachineInstr = self.MRI.getVRegDef(R);
        assert!(DefMI, "R must has one define instruction");
        let mut DefMBB: *mut MachineBasicBlock = DefMI.getParent();
        if DefMI.isMoveImmediate(IgnoreBundle) || !self.DefVisited.insert(DefMI).second {
            continue;
        }
        if DefMI.isPHI() {
            for let mut I: u32 = 1; I < DefMI.getNumOperands(); I += 2 {
                if self.isLoopBackEdge(DefMBB, DefMI.getOperand(I + 1).getMBB()) {
                    RecordShape.call(DefMI, DefMBB);
                } else {
                    WorkList.push(DefMI.getOperand(I).getReg());
                }
            }
        } else {
            RecordShape.call(DefMI, DefMBB);
        }
    }
}

fn X86PreTileConfigImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut ClearStateOnExit: Closure_3 = Closure_3 { cap_0: self };
    let mut X86FI: *mut X86MachineFunctionInfo = MF.getInfo();
    if X86FI.getAMXProgModel() != ManagedRA {
        return false;
    }
    let mut ST: *X86Subtarget = MF.getSubtarget();
    let mut TII: *TargetInstrInfo = ST.getInstrInfo();
    let mut TRI: *TargetRegisterInfo = ST.getRegisterInfo();
    let mut RC: *TargetRegisterClass = TRI.getRegClass(TILERegClassID);
    let mut AMXRegs: BitVector = BitVector { Bits: TRI.getNumRegs(), Size: false };
    for let mut I: u32 = 0; I < RC.getNumRegs(); I += 1 {
        AMXRegs.set(TMM0 + I);
    }
    self.MRI = &mut MF.getRegInfo();
    self.MLI = self.GetMLI.call();
    let mut CfgNeedInsert: SmallSet<MIRef, 8> = SmallSet<MIRef, 8> {};
    let mut CfgLiveInBBs: SmallVector<MachineBasicBlock *, 8> = SmallVector<MachineBasicBlock *, 8> {};
    for MBB in MF {
        let mut Pos: u64 = 0;
        let mut Info: *mut BBInfo = self.BBVisitedInfo[&mut MBB];
        for MI in MBB {
            Pos += 1;
            if self.isAMXInstruction(MI) {
                if Info.LastCall {
                    CfgNeedInsert.insert(Info.LastCall);
                } else {
                    Info.NeedTileCfgLiveIn = true;
                }
                if !Info.FirstAMX {
                    Info.FirstAMX = MIRef { MI: &mut MI, MBB: &mut MBB, Pos: Pos };
                }
            } else if MI.isCall(AnyInBundle) && self.isDestructiveCall(MI, AMXRegs) {
                Info.LastCall = MIRef { MI: &mut MI, MBB: &mut MBB, Pos: Pos };
            }
        }
        if Info.NeedTileCfgLiveIn {
            if &mut MBB == &mut MF.front() {
                CfgNeedInsert.insert(&mut MBB);
            } else {
                CfgLiveInBBs.push(&mut MBB);
            }
        }
        if Info.FirstAMX || Info.HasAMXRegLiveIn {
            for Succ in MBB.successors() {
                if !self.isLoopBackEdge(Succ, &mut MBB) {
                    self.BBVisitedInfo[Succ].HasAMXRegLiveIn = true;
                }
            }
        }
    }
    while !CfgLiveInBBs.is_empty() {
        let mut MBB: *mut MachineBasicBlock = CfgLiveInBBs.pop_back_val();
        for Pred in MBB.predecessors() {
            let mut Info: *mut BBInfo = self.BBVisitedInfo[Pred];
            if Info.LastCall {
                CfgNeedInsert.insert(Info.LastCall);
            } else if !Info.NeedTileCfgLiveIn {
                Info.NeedTileCfgLiveIn = true;
                if Pred == &mut MF.front() {
                    CfgNeedInsert.insert(Pred);
                } else {
                    CfgLiveInBBs.push(Pred);
                }
            }
        }
    }
    if CfgNeedInsert.is_empty() {
        return false;
    }
    let mut WorkList: SmallVector<MachineBasicBlock *, 8> = SmallVector<MachineBasicBlock *, 8> {};
    for I in self.ShapeBBs {
        let mut Info: *mut BBInfo = self.BBVisitedInfo[I.first];
        if Info.HasAMXRegLiveIn {
            emitErrorMsg(MF);
            return false;
        }
        if Info.FirstAMX && Info.FirstAMX < I.second.back() && !self.hoistShapesInBB(I.first, I.second) {
            emitErrorMsg(MF);
            return false;
        }
        WorkList.push(I.first);
    }
    while !WorkList.is_empty() {
        let mut MBB: *mut MachineBasicBlock = WorkList.pop_back_val();
        for Pred in MBB.predecessors() {
            let mut Info: *mut BBInfo = self.BBVisitedInfo[Pred];
            if !Info.TileCfgForbidden && !self.isLoopBackEdge(MBB, Pred) {
                Info.TileCfgForbidden = true;
                WorkList.push(Pred);
            }
        }
    }
    let mut DL: DebugLoc = null;
    let mut VisitedOrInserted: SmallSet<MIRef, 8> = SmallSet<MIRef, 8> {};
    let mut SS: i32 = MF.getFrameInfo().CreateStackObject(ST.getTileConfigSize(), ST.getTileConfigAlignment(), false, null, 0);
    for I in CfgNeedInsert {
        let mut InsertPoints: SmallSet<MIRef, 8> = SmallSet<MIRef, 8> {};
        let mut WorkList: SmallVector<MIRef, 8> = [I];
        while !WorkList.is_empty() {
            let mut I: MIRef = WorkList.pop_back_val();
            if !VisitedOrInserted.count(I) {
                if !self.BBVisitedInfo[I.MBB].TileCfgForbidden {
                    InsertPoints.insert(I);
                } else {
                    VisitedOrInserted.insert(I);
                    for Succ in I.MBB.successors() {
                        if self.BBVisitedInfo[Succ].NeedTileCfgLiveIn {
                            WorkList.push(Succ);
                        }
                    }
                }
            }
        }
        for I in InsertPoints {
            let mut It: iterator = self.ShapeBBs.find(I.MBB);
            if It != self.ShapeBBs.end() && I < operator(It).second.back() {
                I = operator(It).second.back();
            }
            if VisitedOrInserted.insert(I).second {
                let mut II: MachineInstr, true, true, void, false, void>, false, false> = if I.MI { I.MI.getIterator() } else { I.MBB.instr_begin() };
                operator(addFrameReference(BuildMI(*I.MBB, operator(II), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(PLDTILECFGV)), SS, 0)).setImplicitPhysRegDefsDead();
            }
        }
    }
    let mut MBB: *mut MachineBasicBlock = MF.front();
    let mut MI: *mut MachineInstr = &mut operator(MBB.begin());
    if ST.hasAVX512() {
        let mut Xmm: Register = self.MRI.createVirtualRegister(&mut VR128XRegClass, "");
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(AVX512_128_SET0), Xmm);
        let mut Zmm: Register = self.MRI.createVirtualRegister(&mut VR512RegClass, "");
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SUBREG_TO_REG), Zmm).addReg(Xmm, RegState {}, 0).addImm(sub_xmm);
        addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(VMOVUPSZmr)), SS, 0).addReg(Zmm, RegState {}, 0);
    } else if ST.hasAVX2() {
        let mut Xmm: Register = self.MRI.createVirtualRegister(&mut VR128RegClass, "");
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(V_SET0), Xmm);
        let mut Ymm: Register = self.MRI.createVirtualRegister(&mut VR256RegClass, "");
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SUBREG_TO_REG), Ymm).addReg(Xmm, RegState {}, 0).addImm(sub_xmm);
        addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(VMOVUPSYmr)), SS, 0).addReg(Ymm, RegState {}, 0);
        addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(VMOVUPSYmr)), SS, 32).addReg(Ymm, RegState {}, 0);
    } else {
        assert!(ST.hasSSE2(), "AMX should assume SSE2 enabled");
        let mut StoreOpc: u32 = if ST.hasAVX() { VMOVUPSmr } else { MOVUPSmr };
        let mut Xmm: Register = self.MRI.createVirtualRegister(&mut VR128RegClass, "");
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(V_SET0), Xmm);
        addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(StoreOpc)), SS, 0).addReg(Xmm, RegState {}, 0);
        addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(StoreOpc)), SS, 16).addReg(Xmm, RegState {}, 0);
        addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(StoreOpc)), SS, 32).addReg(Xmm, RegState {}, 0);
        addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(StoreOpc)), SS, 48).addReg(Xmm, RegState {}, 0);
    }
    addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOV8mi)), SS, 0).addImm(1);
    return true;
}

fn createX86PreTileConfigLegacyPass() -> *mut FunctionPass {
    return X86PreTileConfigLegacy {};
}

fn X86PreTileConfigLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut Impl: X86PreTileConfigImpl = Closure_4 { cap_0: self };
    return Impl.runOnMachineFunction(MF);
}

fn X86PreTileConfigPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86PreTileConfigImpl = Closure_5 { MFAM: &mut MFAM, MF: &mut MF };
    return if Impl.runOnMachineFunction(MF) { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, MO: *mut MachineOperand) -> bool {
        return MO.isRegMask();
    }

struct Closure_2 {
    cap_0: *mut X86PreTileConfigImpl,
}

fn Closure_2::call(self: *Closure_2, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) {
        let mut MIR: MIRef = MIRef { MI, MBB };
        let mut Refs: *mut MIRef, 8> = self.ShapeBBs[MBB];
        let mut I: *mut MIRef = lower_bound(Refs, MIR);
        if I == Refs.end() || *I != MIR {
            Refs.insert(I, MIR);
        }
    }

struct Closure_3 {
    cap_0: *mut X86PreTileConfigImpl,
}

fn Closure_3::call(self: *mut Closure_3) -> auto {
        self.releaseMemory();
    }

struct Closure_4 {
    cap_0: *mut X86PreTileConfigLegacy,
}

fn Closure_4::call(self: *Closure_4) -> *mut MachineLoopInfo {
        return &mut self.getAnalysis().getLI();
    }

struct Closure_5 {
    MFAM: *mut MachineFunctionAnalysisManager,
    MF: *mut MachineFunction,
}

unsafe fn Closure_5::call(self: *mut Closure_5) -> *mut Result {
        return &mut (*self.MFAM).getResult((*self.MF));
    }
