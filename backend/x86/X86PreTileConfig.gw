fn emitErrorMsg(MF: *mut MachineFunction) {
    let mut Context: *mut LLVMContext = MF.getFunction().getContext();
    Context.emitError(MF.getName() + ": Failed to config tile register, please define the shape earlier");
}

struct MIRef {
    MI: *mut MachineInstr,
    MBB: *mut MachineBasicBlock,
    Pos: u64,
}

fn MIRef::MIRef(self, MBB: *mut MachineBasicBlock) {
    for let mut I: iterator = MBB.begin();
let mut E: iterator = MBB.end(); I != E && operator(I).isPHI(); operator(I) , self.Pos += 1 {
        self.MI = &mut operator(I);
    }
}

fn MIRef::operator==(self: *MIRef, RHS: *MIRef) -> bool {
    return self.MI == RHS.MI && self.MBB == RHS.MBB;
}

fn MIRef::operator!=(self: *MIRef, RHS: *MIRef) -> bool {
    return !(*self == RHS);
}

fn MIRef::operator<(self: *MIRef, RHS: *MIRef) -> bool {
    return tie(self.MBB, self.Pos) < tie(RHS.MBB, RHS.Pos);
}

fn MIRef::operator>(self: *MIRef, RHS: *MIRef) -> bool {
    return tie(self.MBB, self.Pos) > tie(RHS.MBB, RHS.Pos);
}

struct BBInfo {
    FirstAMX: MIRef,
    LastCall: MIRef,
    HasAMXRegLiveIn: bool,
    TileCfgForbidden: bool,
    NeedTileCfgLiveIn: bool,
}

struct X86PreTileConfigImpl {
    GetMLI: function<MachineLoopInfo *()>,
    MRI: *mut MachineRegisterInfo,
    MLI: *MachineLoopInfo,
    DefVisited: SmallPtrSet<MachineInstr *, 8>,
    BBVisitedInfo: i32,
    ShapeBBs: i32,
}

fn X86PreTileConfigImpl::isDestructiveCall(self, MI: *mut MachineInstr, UsableRegs: BitVector) -> bool {
    let mut Iter: auto = find_if(MI.operands(), Closure_1 {});
    if Iter() == MI.operands_end() {
        return false;
    }
    UsableRegs.clearBitsInMask();
    return !UsableRegs.none();
}

fn X86PreTileConfigImpl::isAMXInstruction(self, MI: *mut MachineInstr) -> bool {
    if MI.isPHI() || MI.isDebugInstr() || MI.getNumOperands() < 3 {
        return false;
    }
    match MI.getOpcode() {

    }
    let mut MO: *mut MachineOperand = MI.getOperand(0);
    if !MO.isReg() || !MO.getReg().isVirtual() {
        return false;
    }
    if  {
        return false;
    }
    self.collectShapeInfo(MI);
    return true;
}

fn X86PreTileConfigImpl::isLoopBackEdge(self, Header: *mut MachineBasicBlock, Bottom: *mut MachineBasicBlock) -> bool {
    if operator!(self.MLI(Header)) {
        return false;
    }
    let mut ML: *mut auto = self.MLI(Header);
    if ML()(Bottom) && (Bottom) {
        return true;
    }
    return false;
}

fn X86PreTileConfigImpl::hoistShapesInBB(self, MBB: *mut MachineBasicBlock, Shapes: *mut SmallVectorImpl<MIRef>) -> bool {
    let mut FirstAMX: *mut MIRef = null;
    let mut FirstShapeBelowAMX: auto = lower_bound(Shapes, FirstAMX);
    let mut InsertPoint: self_iterator = FirstAMX.MI.getIterator();
    for let mut I: auto = ;
let mut E: auto = Shapes()(); I() != ;  += 1 {
        if I()() {
            return false;
        }
        MBB(InsertPoint);
    }
    Shapes()();
    Shapes()(MIRef { &mut operator(operator(InsertPoint)), MBB });
    return true;
}

