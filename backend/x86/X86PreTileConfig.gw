static mut ID: i8 = 0;

fn X86PreTileConfigImpl::collectShapeInfo(self, MI: *mut MachineInstr) {
    let mut RecordShape: Closure_2 = Closure_2 { cap_0: self };
    let mut WorkList: SmallVector<Register, 8> = zeroed();
    while operator!() {
        let mut R: Register = ();
        let mut DefMI: *mut MachineInstr = self.MRI.getVRegDef(R);
        assert!(DefMI, "R must has one define instruction");
        let mut DefMBB: *mut MachineBasicBlock = DefMI.getParent();
        if  {
            continue;
        }
        if DefMI.isPHI() {
            for let mut I: u32 = 1; I < DefMI.getNumOperands(); I += 2 {
                if self.isLoopBackEdge(DefMBB, DefMI.getOperand(I + 1).getMBB()) {
                    RecordShape.call(DefMI, DefMBB);
                } else {
                    WorkList()(DefMI.getOperand(I).getReg());
                }
            }
        } else {
            RecordShape.call(DefMI, DefMBB);
        }
    }
}

fn X86PreTileConfigImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut ClearStateOnExit: scope_exit = Closure_3 { cap_0: self };
    let mut X86FI: *mut X86MachineFunctionInfo = MF;
    if X86FI.getAMXProgModel() != ManagedRA {
        return false;
    }
    let mut ST: *X86Subtarget = MF;
    let mut TII: *TargetInstrInfo = ST.getInstrInfo();
    let mut TRI: *TargetRegisterInfo = ST.getRegisterInfo();
    let mut RC: *TargetRegisterClass = TRI.getRegClass;
    let mut AMXRegs: BitVector = BitVector { Bits: TRI.getNumRegs(), Size: false };
    for let mut I: u32 = 0; I < RC.getNumRegs(); I += 1 {
        AMXRegs;
    }
    self.MRI = &mut MF.getRegInfo();
    let mut CfgNeedInsert: i32 = 0;
    let mut CfgLiveInBBs: SmallVector<MachineBasicBlock *, 8> = zeroed();
    for MBB in MF {
        let mut Pos: u64 = 0;
        let mut Info: *mut auto = null;
        for MI in MBB {
            Pos += 1;
            if self.isAMXInstruction(MI) {
                if Info() {
                    CfgNeedInsert()();
                } else {
                    Info() = true;
                }
                if operator!() {
                    Info() = MIRef { MI: &mut MI, MBB: &mut MBB, Pos: Pos };
                }
            } else if MI.isCall(AnyInBundle) && self.isDestructiveCall(MI, AMXRegs) {
                Info() = MIRef { MI: &mut MI, MBB: &mut MBB, Pos: Pos };
            }
        }
        if Info() {
            if &mut MBB == &mut MF.front() {
                CfgNeedInsert()(MIRef { &mut MBB });
            } else {
                CfgLiveInBBs()(&mut MBB);
            }
        }
    }
    while operator!() {
        let mut MBB: *mut MachineBasicBlock = ();
    }
    if CfgNeedInsert()() {
        return false;
    }
    let mut WorkList: SmallVector<MachineBasicBlock *, 8> = zeroed();
    while operator!() {
        let mut MBB: *mut MachineBasicBlock = ();
    }
    let mut DL: DebugLoc = DebugLoc { Loc: null };
    let mut VisitedOrInserted: i32 = 0;
    let mut SS: i32 = MF.getFrameInfo().CreateStackObject(ST.getTileConfigSize(), ST.getTileConfigAlignment(), false, null, 0);
    let mut MBB: *mut MachineBasicBlock = MF.front();
    let mut MI: *mut MachineInstr = &mut operator(MBB.begin());
    if ST.hasAVX512() {
        let mut Xmm: Register = self.MRI;
        BuildMI(MBB, MI, DL, TII.get, Xmm);
        let mut Zmm: Register = self.MRI;
        BuildMI(MBB, MI, DL, TII.get, Zmm)(Xmm);
        addFrameReference(BuildMI(MBB, MI, DL, TII.get), SS)(Zmm);
    } else if ST.hasAVX2() {
        let mut Xmm: Register = self.MRI;
        BuildMI(MBB, MI, DL, TII.get, Xmm);
        let mut Ymm: Register = self.MRI;
        BuildMI(MBB, MI, DL, TII.get, Ymm)(Xmm);
        addFrameReference(BuildMI(MBB, MI, DL, TII.get), SS)(Ymm);
        addFrameReference(BuildMI(MBB, MI, DL, TII.get), SS, 32)(Ymm);
    } else {
        assert!(ST.hasSSE2(), "AMX should assume SSE2 enabled");
        let mut StoreOpc: u32 = 0;
        let mut Xmm: Register = self.MRI;
        BuildMI(MBB, MI, DL, TII.get, Xmm);
        addFrameReference(BuildMI(MBB, MI, DL, TII.get), SS)(Xmm);
        addFrameReference(BuildMI(MBB, MI, DL, TII.get), SS, 16)(Xmm);
        addFrameReference(BuildMI(MBB, MI, DL, TII.get), SS, 32)(Xmm);
        addFrameReference(BuildMI(MBB, MI, DL, TII.get), SS, 48)(Xmm);
    }
    addFrameReference(BuildMI(MBB, MI, DL, TII.get), SS)(1);
    return true;
}

fn createX86PreTileConfigLegacyPass() -> *mut FunctionPass {
    return X86PreTileConfigLegacy {};
}

fn X86PreTileConfigLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut Impl: X86PreTileConfigImpl = Closure_4 { cap_0: self };
    return Impl.runOnMachineFunction(MF);
}

fn X86PreTileConfigPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86PreTileConfigImpl = Closure_5 { MFAM: &mut MFAM, MF: &mut MF };
    return if Impl.runOnMachineFunction(MF) { getMachineFunctionPassPreservedAnalyses() } else { all() };
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, MO: *mut MachineOperand) -> bool {
        return MO.isRegMask();
    }

struct Closure_2 {
    cap_0: *mut X86PreTileConfigImpl,
}

fn Closure_2::call(self: *Closure_2, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) {
        let mut MIR: MIRef = MIRef { MI, MBB };
        let mut Refs: *mut auto = null;
        let mut I: auto = lower_bound(MIR);
        if I() == () || operator*() != MIR {
            Refs()(MIR);
        }
    }

struct Closure_3 {
    cap_0: *mut X86PreTileConfigImpl,
}

fn Closure_3::call(self: *mut Closure_3) -> auto {
        self.releaseMemory();
    }

struct Closure_4 {
    cap_0: *mut X86PreTileConfigLegacy,
}

fn Closure_4::call(self: *Closure_4) -> auto {}

struct Closure_5 {
    MFAM: *mut MachineFunctionAnalysisManager,
    MF: *mut MachineFunction,
}

unsafe fn Closure_5::call(self: *mut Closure_5) -> auto {}
