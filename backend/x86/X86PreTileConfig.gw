fn emitErrorMsg(MF: *mut MachineFunction) {
    let mut Context: *mut LLVMContext = MF.getFunction().getContext();
    Context.emitError(MF.getName() + ": Failed to config tile register, please define the shape earlier");
}

struct MIRef {
    MI: *mut MachineInstr,
    MBB: *mut MachineBasicBlock,
    Pos: u64,
}

fn MIRef::MIRef(self, MBB: *mut MachineBasicBlock) {
    for let mut I: iterator = MBB.begin();
let mut E: iterator = MBB.end(); I != E && operator(I).isPHI(); operator(I) , self.Pos += 1 {
        self.MI = &mut operator(I);
    }
}

fn MIRef::operator==(self: *MIRef, RHS: *MIRef) -> bool {
    return self.MI == RHS.MI && self.MBB == RHS.MBB;
}

fn MIRef::operator!=(self: *MIRef, RHS: *MIRef) -> bool {
    return !(*self == RHS);
}

fn MIRef::operator<(self: *MIRef, RHS: *MIRef) -> bool {
    return operator(tie(self.MBB, self.Pos), tie(RHS.MBB, RHS.Pos)) < 0;
}

fn MIRef::operator>(self: *MIRef, RHS: *MIRef) -> bool {
    return operator(tie(self.MBB, self.Pos), tie(RHS.MBB, RHS.Pos)) > 0;
}

fn MIRef::operator=(self, arg: *MIRef) -> *mut MIRef {
    self.MI = .MI;
    self.MBB = .MBB;
    self.Pos = .Pos;
    return *self;
}

fn MIRef::operator=(self, arg: *mut *mut MIRef) -> *mut MIRef {
    self.MI =  as MIRef.MI;
    self.MBB =  as MIRef.MBB;
    self.Pos =  as MIRef.Pos;
    return *self;
}

struct BBInfo {
    FirstAMX: MIRef,
    LastCall: MIRef,
    HasAMXRegLiveIn: bool,
    TileCfgForbidden: bool,
    NeedTileCfgLiveIn: bool,
}

struct X86PreTileConfigImpl {
    GetMLI: function<MachineLoopInfo *()>,
    MRI: *mut MachineRegisterInfo,
    MLI: *MachineLoopInfo,
    DefVisited: SmallPtrSet<MachineInstr *, 8>,
    BBVisitedInfo: DenseMap<MachineBasicBlock *, BBInfo>,
    ShapeBBs: DenseMap<MachineBasicBlock *, SmallVector<MIRef, 8>>,
}

fn X86PreTileConfigImpl::isDestructiveCall(self, MI: *mut MachineInstr, UsableRegs: BitVector) -> bool {
    let mut Iter: *mut MachineOperand = find_if(MI.operands(), Closure_1 {});
    if Iter == MI.operands_end() {
        return false;
    }
    UsableRegs.clearBitsInMask(Iter.getRegMask(), ~0);
    return !UsableRegs.none();
}

fn X86PreTileConfigImpl::isAMXInstruction(self, MI: *mut MachineInstr) -> bool {
    if MI.isPHI() || MI.isDebugInstr() || MI.getNumOperands() < 3 {
        return false;
    }
    match MI.getOpcode() {
        PTILESTOREDV => {
            PTCVTROWD2PSrteV;
        },
    }
    let mut MO: *mut MachineOperand = MI.getOperand(0);
    if !MO.isReg() || !MO.getReg().isVirtual() {
        return false;
    }
    if self.MRI.getRegClass(MO.getReg()).getID() != TILERegClassID {
        return false;
    }
    self.collectShapeInfo(MI);
    return true;
}

fn X86PreTileConfigImpl::isLoopBackEdge(self, Header: *mut MachineBasicBlock, Bottom: *mut MachineBasicBlock) -> bool {
    if !self.MLI.isLoopHeader(Header) {
        return false;
    }
    let mut ML: *mut MachineLoop = self.MLI.getLoopFor(Header);
    if ML.contains(Bottom) && ML.isLoopLatch(Bottom) {
        return true;
    }
    return false;
}

fn X86PreTileConfigImpl::hoistShapesInBB(self, MBB: *mut MachineBasicBlock, Shapes: *mut SmallVectorImpl<MIRef>) -> bool {
    let mut FirstAMX: *mut MIRef = self.BBVisitedInfo[MBB].FirstAMX;
    let mut FirstShapeBelowAMX: *mut MIRef = lower_bound(Shapes, FirstAMX);
    let mut InsertPoint: self_iterator = FirstAMX.MI.getIterator();
    for let mut I: *mut MIRef = FirstShapeBelowAMX;
let mut E: iterator = Shapes.end(); I != E; I += 1 {
        if I.MI.mayLoadOrStore(AnyInBundle) {
            return false;
        }
        for MO in I.MI.operands() {
            if MO.isDef() {
                continue;
            }
            if MO.isReg() && self.MRI.getVRegDef(MO.getReg()) > FirstAMX {
                return false;
            }
        }
        MBB.insert(InsertPoint, I.MI.removeFromParent());
    }
    Shapes.clear();
    Shapes.push(MIRef { &mut operator(operator(InsertPoint)), MBB });
    return true;
}

fn X86PreTileConfigImpl::releaseMemory(self) {
    self.ShapeBBs.clear();
    self.DefVisited.clear();
    self.BBVisitedInfo.clear();
}

