struct X86TileConfigLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86TileConfigLegacy::getPassName(self: *X86TileConfigLegacy) -> str {
    return "Tile Register Configure";
}

fn X86TileConfigLegacy::getAnalysisUsage(self: *X86TileConfigLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesAll();
    AU;
    AU;
    self.getAnalysisUsage(AU);
}

fn X86TileConfigLegacy::getRequiredProperties(self: *X86TileConfigLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoPHIs();
}

fn X86TileConfigLegacy::getPassKind(self: *X86TileConfigLegacy) -> PassKind {
    return self.Kind;
}

fn X86TileConfigLegacy::getPassID(self: *X86TileConfigLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86TileConfigLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86TileConfigLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86TileConfigLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86TileConfigLegacy::getResolver(self: *X86TileConfigLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86TileConfigLegacy::getSetProperties(self: *X86TileConfigLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86TileConfigLegacy::getClearedProperties(self: *X86TileConfigLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn tileConfig(MF: *mut MachineFunction, GetLIs: function_ref<LiveIntervals *()>, GetVRM: function_ref<VirtRegMap *()>) -> bool {
    let mut X86FI: *mut X86MachineFunctionInfo = MF;
    if X86FI.getAMXProgModel() != ManagedRA {
        return false;
    }
    let mut ST: *X86Subtarget = MF;
    let mut TRI: *X86RegisterInfo = ST.getRegisterInfo();
    let mut TII: *TargetInstrInfo = ST.getInstrInfo();
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut LIS: *mut LiveIntervals = operator*();
    let mut VRM: *mut VirtRegMap = operator*();
    if VRM.isShapeMapEmpty() {
        return false;
    }
    let mut SS: i32 = 2147483647;
    for MBB in MF {
        for MI in MBB {
            if  {
                SS = MI.getOperand(0).getIndex();
                break;
            }
        }
        if SS != 2147483647 {
            break;
        }
    }
    if SS == 2147483647 {
        return false;
    }
    let mut ConstPos: u32 = 0;
    let mut ConstMI: *mut MachineInstr = null;
    for MI in MF.front() {
        if  {
            ConstMI = &mut MI;
            break;
        }
        ConstPos += 1;
    }
    assert!(ConstMI, "Cannot find an insertion point");
    let mut AMXRegNum: u32 = TRI()();
    let mut Phys2Virt: SmallVector<Register, 8> = zeroed();
    for let mut I: u32 = 0;
let mut E: u32 = MRI.getNumVirtRegs(); I != E; I += 1 {
        let mut VirtReg: Register = index2VirtReg(I);
        if MRI.reg_nodbg_empty(VirtReg) {
            continue;
        }
        if !TRI.isTileRegisterClass(MRI.getRegClass(VirtReg)) {
            continue;
        }
        let mut PhysReg: MCRegister = VRM.getPhys(VirtReg);
        if !PhysReg.operator unsigned int() {
            continue;
        }
        let mut Index: u32 = 0;
        if operator!([Index]) {
            Phys2Virt()[Index] = VirtReg;
        }
    }
    for let mut I: u32 = 0; I < AMXRegNum; I += 1 {
        if operator!([I]) {
            continue;
        }
        let mut DL: DebugLoc = DebugLoc { Loc: null };
        let mut IsRow: bool = true;
        let mut NewMI: *mut MachineInstr = null;
        let mut Shape: ShapeT = VRM.getShape([I]);
    }
    return true;
}

fn createX86TileConfigLegacyPass() -> *mut FunctionPass {
    return X86TileConfigLegacy {};
}

fn X86TileConfigLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return tileConfig(MF, Closure_1 { cap_0: self }, Closure_2 { cap_0: self });
}

fn X86TileConfigPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = tileConfig(MF, Closure_3 { MFAM: &mut MFAM, MF: &mut MF }, Closure_4 { MFAM: &mut MFAM, MF: &mut MF });
    return if Changed { getMachineFunctionPassPreservedAnalyses() } else { all() };
}

struct Closure_1 {
    cap_0: *mut X86TileConfigLegacy,
}

fn Closure_1::call(self: *Closure_1) -> auto {}

struct Closure_2 {
    cap_0: *mut X86TileConfigLegacy,
}

fn Closure_2::call(self: *Closure_2) -> auto {}

struct Closure_3 {
    MFAM: *mut MachineFunctionAnalysisManager,
    MF: *mut MachineFunction,
}

unsafe fn Closure_3::call(self: *mut Closure_3) -> auto {}

struct Closure_4 {
    MFAM: *mut MachineFunctionAnalysisManager,
    MF: *mut MachineFunction,
}

unsafe fn Closure_4::call(self: *mut Closure_4) -> auto {}
