static mut FunctionsProcessed: Statistic = Statistic { "x86-wineh-unwindv3", "FunctionsProcessed", "Number of functions processed by Unwind v3 pass" };

static mut SubFragmentSplits: Statistic = Statistic { "x86-wineh-unwindv3", "SubFragmentSplits", "Number of sub-fragment splits inserted for Unwind v3" };

const MaxV3PrologOps: u32 = 31;

const MaxV3Epilogs: u32 = 7;

const MaxV3EpilogOps: u32 = 31;

const EpilogDistanceThreshold: u32 = 32767;

static mut ApproxBytesPerInstr: i32 = "x86-wineh-unwindv3-instr-avg-size";

fn suppressWinCFI(MF: *mut MachineFunction) {
    for MBB in MF {}
    MF.setHasWinCFI(false);
}

struct EpilogSplitPoint {
    BeginEpilog: *mut MachineInstr,
    ApproxBytePos: u32,
}

struct FuncletInfo {
    PrologOpCount: u32,
    MaxEpilogOpCount: u32,
    EndBytePos: u32,
    Epilogs: SmallVector<EpilogSplitPoint, 8>,
}

struct X86WinEHUnwindV3 {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86WinEHUnwindV3::X86WinEHUnwindV3(self) {
    initializeX86WinEHUnwindV3Pass(*getPassRegistry());
}

fn X86WinEHUnwindV3::getPassName(self: *X86WinEHUnwindV3) -> str {
    return "WinEH Unwind V3";
}

fn X86WinEHUnwindV3::getPassKind(self: *X86WinEHUnwindV3) -> PassKind {
    return self.Kind;
}

fn X86WinEHUnwindV3::getPassID(self: *X86WinEHUnwindV3) -> AnalysisID {
    return self.PassID;
}

fn X86WinEHUnwindV3::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86WinEHUnwindV3::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86WinEHUnwindV3::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86WinEHUnwindV3::getResolver(self: *X86WinEHUnwindV3) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86WinEHUnwindV3::getRequiredProperties(self: *X86WinEHUnwindV3) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86WinEHUnwindV3::getSetProperties(self: *X86WinEHUnwindV3) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86WinEHUnwindV3::getClearedProperties(self: *X86WinEHUnwindV3) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86WinEHUnwindV3Pass() -> *mut FunctionPass {
    return X86WinEHUnwindV3 {};
}

fn X86WinEHUnwindV3::analyzeFunclet(self, MF: *mut MachineFunction, Iter: *mut iterator, ApproxBytePos: *mut u32) -> FuncletInfo {
    let mut Info: FuncletInfo = FuncletInfo {};
    let mut InEpilog: bool = false;
    let mut SeenProlog: bool = false;
    let mut CurrentEpilogOpCount: u32 = 0;
    for ; Iter != MF.end(); operator(Iter) {
        let mut MBB: *mut MachineBasicBlock = operator(Iter);
        if MBB.isEHFuncletEntry() && SeenProlog {
            break;
        }
        let mut A: Align = MBB.getAlignment();
        let mut MaxPadding: u32 = A.value() - 1;
        if MBB.getMaxBytesForAlignment() {
            MaxBytes;
        } else {
            MaxPadding = min(MaxPadding, MaxBytes);
        }
        ApproxBytePos += MaxPadding;
        for MI in MBB {
            if !MI.isPseudo(IgnoreBundle) && !MI.isMetaInstruction(IgnoreBundle) {
                operator+=(ApproxBytePos);
            }
            match MI.getOpcode() {
                _ => {
                    break;
                },
            }
        }
    }
    Info.EndBytePos = ApproxBytePos;
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-wineh-unwindv3", 1) {
            dbgs() << "  funclet has " << Info()() << " epilog(s); ends at approx byte position " << ApproxBytePos << "\n";
        }
    }
        if !(false) { break; }
    }
    return Info;
}

fn X86WinEHUnwindV3::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut F: *mut Function = MF.getFunction();
    let mut Ctx: *mut LLVMContext = F.getContext();
    if !requireWinX64UnwindV3(MF) {
        return false;
    }
    let mut PerFunctionV3: bool = MF.hasWinCFI() && MF.getFunction().getParent().getWinX64EHUnwindMode() != V3;
    let mut Changed: bool = false;
    let mut ApproxBytePos: u32 = 0;
    let mut Iter: iterator = MF.begin();
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-wineh-unwindv3", 1) {
            dbgs() << "X86WinEHUnwindV3: processing " << MF.getName() << "\n";
        }
    }
        if !(false) { break; }
    }
    while Iter != MF.end() {
        if PerFunctionV3 {
            let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
            let mut FuncletEntry: *mut MachineBasicBlock = operator(Iter);
            BuildMI(FuncletEntry, FuncletEntry.begin(), FuncletEntry.findDebugLoc(FuncletEntry.begin()), TII.get)(3)(FrameSetup);
            Changed = true;
        }
        let mut Info: FuncletInfo = analyzeFunclet(MF, Iter, ApproxBytePos);
        if Info.PrologOpCount > MaxV3PrologOps {
            Ctx.diagnose(DiagnosticInfoResourceLimit { F, "number of unwind v3 prolog operations required", Info.PrologOpCount, MaxV3PrologOps, DS_Error, DK_ResourceLimit });
            Ctx.diagnose(DiagnosticInfoGenericWithLoc { "sub-fragment splitting for prolog overflow is not yet implemented", F, DiagnosticLocation { F.getSubprogram() }, DS_Note });
            suppressWinCFI(MF);
            return true;
        }
        if Info.MaxEpilogOpCount > MaxV3EpilogOps {
            Ctx.diagnose(DiagnosticInfoResourceLimit { F, "number of unwind v3 epilog operations required", Info.MaxEpilogOpCount, MaxV3EpilogOps, DS_Error, DK_ResourceLimit });
            Ctx.diagnose(DiagnosticInfoGenericWithLoc { "sub-fragment splitting for epilog overflow is not yet implemented", F, DiagnosticLocation { F.getSubprogram() }, DS_Note });
            suppressWinCFI(MF);
            return true;
        }
        let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
        let mut SplitAfter: Closure_1 = Closure_1 { TII: &mut TII, Changed: &mut Changed };
        let mut EpilogsInFragment: u32 = 0;
        let mut LastEpilog: *EpilogSplitPoint = null;
        let mut LastEpilogIdx: u32 = 0;
        for let mut Idx: u32 = 0; Idx < Info()(); Idx += 1 {
            let mut Epilog: *EpilogSplitPoint = Info()[Idx];
            if EpilogsInFragment > 0 {
                let mut ExceedsEpilogCount: bool = EpilogsInFragment >= MaxV3Epilogs;
                let mut ExceedsDistance: bool = Epilog.ApproxBytePos - LastEpilog.ApproxBytePos >= EpilogDistanceThreshold;
                if ExceedsEpilogCount || ExceedsDistance {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("x86-wineh-unwindv3", 1) {
                            {
                                dbgs() << "  splitting after epilog " << LastEpilogIdx << " because adding epilog " << Idx << " would exceed the ";
                                if ExceedsEpilogCount {
                                    dbgs() << "7-epilog-per-fragment limit\n";
                                } else {
                                    dbgs() << "epilog distance threshold (gap from previous epilog at " << LastEpilog.ApproxBytePos << " to epilog at " << Epilog.ApproxBytePos << ")\n";
                                }
                            }
                        }
                    }
                        if !(false) { break; }
                    }
                    SplitAfter.call(*LastEpilog);
                    EpilogsInFragment = 0;
                }
            }
            EpilogsInFragment += 1;
            LastEpilog = &mut Epilog;
            LastEpilogIdx = Idx;
        }
        if LastEpilog && Info.EndBytePos - LastEpilog.ApproxBytePos >= EpilogDistanceThreshold {
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-wineh-unwindv3", 1) {
                    dbgs() << "  splitting after last epilog " << LastEpilogIdx << " to isolate the trailing tail (gap from epilog at " << LastEpilog.ApproxBytePos << " to funclet end " << Info.EndBytePos << ")\n";
                }
            }
                if !(false) { break; }
            }
            SplitAfter.call(*LastEpilog);
        }
    }
    if Changed {
        operator(FunctionsProcessed, 0);
    }
    return Changed;
}

struct Closure_1 {
    TII: *mut *TargetInstrInfo,
    Changed: *mut bool,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Epilog: *EpilogSplitPoint) {
            let mut MBB: *mut MachineBasicBlock = Epilog.BeginEpilog.getParent();
            BuildMI(*MBB, MBB.begin(), Epilog.BeginEpilog.getDebugLoc(), (*self.TII).get)(FrameDestroy);
            operator(SubFragmentSplits, 0);
            (*self.Changed) = true;
        }
