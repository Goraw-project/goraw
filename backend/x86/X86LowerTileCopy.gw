static mut ID: i8 = 0;

fn X86LowerTileCopyLegacy::getAnalysisUsage(self: *X86LowerTileCopyLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesAll();
    self.getAnalysisUsage(AU);
}

fn createX86LowerTileCopyLegacyPass() -> *mut FunctionPass {
    return X86LowerTileCopyLegacy {};
}

fn lowerTileCopy(MF: *mut MachineFunction) -> bool {
    let mut FuncInfo: *mut X86MachineFunctionInfo = MF;
    if FuncInfo.getAMXProgModel() != ManagedRA {
        return false;
    }
    let mut ST: *X86Subtarget = MF;
    (((operator!(operator!((ST()() && "Only supported on AMXTILE targets")))) || (_wassert(L"ST.hasAMXTILE() && \"Only supported on AMXTILE targets\"", L"llvm\\lib\\Target\\X86\\X86LowerTileCopy.cpp", (78) as u32) , 0)) as void);
    let mut TII: *X86InstrInfo = ST.getInstrInfo();
    let mut TRI: *TargetRegisterInfo = ST.getRegisterInfo();
    let mut GR64Regs: BitVector = TRI.getAllocatableSet(MF, TRI.getRegClass);
    let mut Changed: bool = false;
    for MBB in MF {
        let mut UsedRegs: LiveRegUnits = LiveRegUnits { *TRI };
        UsedRegs.addLiveOuts(MBB);
    }
    return Changed;
}

fn X86LowerTileCopyLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return lowerTileCopy(MF);
}

fn X86LowerTileCopyPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if lowerTileCopy(MF) { getMachineFunctionPassPreservedAnalyses() } else { all() };
}
