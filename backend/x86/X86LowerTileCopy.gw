struct X86LowerTileCopyLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86LowerTileCopyLegacy::getPassName(self: *X86LowerTileCopyLegacy) -> str {
    return "X86 Lower Tile Copy";
}

fn X86LowerTileCopyLegacy::getPassKind(self: *X86LowerTileCopyLegacy) -> PassKind {
    return self.Kind;
}

fn X86LowerTileCopyLegacy::getPassID(self: *X86LowerTileCopyLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86LowerTileCopyLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LowerTileCopyLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LowerTileCopyLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86LowerTileCopyLegacy::getResolver(self: *X86LowerTileCopyLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86LowerTileCopyLegacy::getRequiredProperties(self: *X86LowerTileCopyLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86LowerTileCopyLegacy::getSetProperties(self: *X86LowerTileCopyLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86LowerTileCopyLegacy::getClearedProperties(self: *X86LowerTileCopyLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn X86LowerTileCopyLegacy::getAnalysisUsage(self: *X86LowerTileCopyLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesAll();
    self.getAnalysisUsage(AU);
}

fn createX86LowerTileCopyLegacyPass() -> *mut FunctionPass {
    return X86LowerTileCopyLegacy {};
}

fn lowerTileCopy(MF: *mut MachineFunction) -> bool {
    let mut FuncInfo: *mut X86MachineFunctionInfo = MF.getInfo();
    if FuncInfo.getAMXProgModel() != ManagedRA {
        return false;
    }
    let mut ST: *X86Subtarget = MF.getSubtarget();
    assert!(ST.hasAMXTILE(), "Only supported on AMXTILE targets");
    let mut TII: *X86InstrInfo = ST.getInstrInfo();
    let mut TRI: *TargetRegisterInfo = ST.getRegisterInfo();
    let mut GR64Regs: BitVector = TRI.getAllocatableSet(MF, TRI.getRegClass(GR64RegClassID));
    let mut Changed: bool = false;
    for MBB in MF {
        let mut UsedRegs: LiveRegUnits = *TRI;
        UsedRegs.addLiveOuts(MBB);
        for MI in make_early_inc_range(reverse(MBB)) {
            if MI.isDebugInstr() {
                continue;
            }
            UsedRegs.stepBackward(MI);
            if !MI.isCopy() {
                continue;
            }
            let mut DstMO: *mut MachineOperand = MI.getOperand(0);
            let mut SrcMO: *mut MachineOperand = MI.getOperand(1);
            let mut SrcReg: Register = SrcMO.getReg();
            let mut DstReg: Register = DstMO.getReg();
            if !TILERegClass.contains(DstReg.operator MCRegister(), SrcReg.operator MCRegister()) {
                continue;
            }
            let mut Size: u32 = TRI.getSpillSize(TILERegClass);
            let mut Alignment: Align = TRI.getSpillAlign(TILERegClass);
            let mut TileSS: i32 = MF.getFrameInfo().CreateSpillStackObject(Size, Alignment, Default);
            let mut StrideSS: i32 = 0;
            let mut GR64Cand: Register = NoRegister;
            for RegT in GR64Regs.set_bits() {
                if UsedRegs.available(RegT) {
                    GR64Cand = RegT;
                    break;
                }
            }
            let mut DL: *DebugLoc = MI.getDebugLoc();
            if GR64Cand.operator unsigned int() {
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOV64ri), GR64Cand).addImm(64);
            } else {
                Size = TRI.getSpillSize(GR64RegClass);
                Alignment = TRI.getSpillAlign(GR64RegClass);
                StrideSS = MF.getFrameInfo().CreateSpillStackObject(Size, Alignment, Default);
                addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOV64mr)), StrideSS, 0).addReg(RAX, RegState {}, 0);
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOV64ri), RAX).addImm(64);
            }
            let mut Opc: u32 = (if ST.hasEGPR() { TILESTORED_EVEX } else { TILESTORED });
            let mut NewMI: *mut MachineInstr = addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Opc)), TileSS, 0).addReg(SrcReg, getKillRegState(SrcMO.isKill()), 0).operator llvm::MachineInstr *();
            let mut MO: *mut MachineOperand = &mut NewMI.getOperand(AddrIndexReg);
            MO.setReg(if GR64Cand.operator unsigned int() { GR64Cand } else { RAX });
            Opc = (if ST.hasEGPR() { TILELOADD_EVEX } else { TILELOADD });
            NewMI = addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Opc), DstReg), TileSS, 0).operator llvm::MachineInstr *();
            MO = &mut NewMI.getOperand(1 + AddrIndexReg);
            MO.setReg(if GR64Cand.operator unsigned int() { GR64Cand } else { RAX });
            MO.setIsKill(true);
            if !GR64Cand.operator unsigned int() {
                addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOV64rm), RAX), StrideSS, 0);
            }
            MI.eraseFromParent();
            Changed = true;
        }
    }
    return Changed;
}

fn X86LowerTileCopyLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return lowerTileCopy(MF);
}

fn X86LowerTileCopyPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if lowerTileCopy(MF) { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}
