fn X86TargetMachine::parseMachineFunctionInfo(self: *X86TargetMachine, MFI: *MachineFunctionInfo, PFS: *mut PerFunctionMIParsingState, Error: *mut SMDiagnostic, SourceRange: *mut SMRange) -> bool {
    let mut YamlMFI: *X86MachineFunctionInfo = MFI as X86MachineFunctionInfo;
    PFS.MF(YamlMFI);
    return false;
}

fn X86TargetMachine::isNoopAddrSpaceCast(self: *X86TargetMachine, DL: *DataLayout, SrcAS: u32, DestAS: u32) -> bool {
    assert!(SrcAS != DestAS, "Expected different address spaces!");
    if DL.getPointerSize(SrcAS) != DL.getPointerSize(DestAS) {
        return false;
    }
    return SrcAS < 256 && DestAS < 256;
}

