fn X86PassConfig::addIRPasses(self) {
    self.addPass(createAtomicExpandLegacyPass());
    self.addPass(createX86LowerAMXIntrinsicsLegacyPass());
    self.addPass(createX86LowerAMXTypeLegacyPass());
    self.addIRPasses();
    if self.TM.getOptLevel() != None {
        self.addPass(createInterleavedAccessPass());
        self.addPass(createX86PartialReductionLegacyPass());
    }
    self.addPass(createIndirectBrExpandPass());
    let mut TT: *Triple = self.TM.getTargetTriple();
    if TT.isOSWindows() {
        self.addPass(createCFGuardPass());
    }
    if self.TM.Options.JMCInstrument {
        self.addPass(createJMCInstrumenterPass());
    }
}

fn X86PassConfig::addInstSelector(self) -> bool {
    self.addPass(createX86ISelDag(self.getX86TargetMachine(), self.getOptLevel()));
    if self.TM.getTargetTriple().isOSBinFormatELF() && self.getOptLevel() != None {
        self.addPass(createCleanupLocalDynamicTLSLegacyPass());
    }
    self.addPass(createX86GlobalBaseRegLegacyPass());
    self.addPass(createX86ArgumentStackSlotLegacyPass());
    return false;
}

fn X86PassConfig::addIRTranslator(self) -> bool {
    self.addPass(IRTranslatorLegacy { self.getOptLevel() });
    return false;
}

fn X86PassConfig::addPreRegBankSelect(self) {
    let mut IsOptNone: bool = self.getOptLevel() == None;
    if !IsOptNone {
        self.addPass(createX86PostLegalizerCombinerLegacy());
    }
}

fn X86PassConfig::addLegalizeMachineIR(self) -> bool {
    self.addPass(LegalizerLegacy {});
    return false;
}

fn X86PassConfig::addRegBankSelect(self) -> bool {
    self.addPass(RegBankSelectLegacy { Fast });
    return false;
}

fn X86PassConfig::addGlobalInstructionSelect(self) -> bool {
    self.addPass(InstructionSelectLegacy { self.getOptLevel(), true, ID });
    if self.isGlobalISelAbortEnabled() {
        self.addPass(createX86GlobalBaseRegLegacyPass());
    }
    return false;
}

fn X86PassConfig::addPreLegalizeMachineIR(self) {
    if self.getOptLevel() != None {
        self.addPass(createX86PreLegalizerCombinerLegacy());
    }
}

fn X86PassConfig::addILPOpts(self) -> bool {
    self.addPass(&mut EarlyIfConverterLegacyID);
    if X86EnableMachineCombinerPass() {
        self.addPass(&mut MachineCombinerID);
    }
    self.addPass(createX86CmovConversionLegacyPass());
    return true;
}

fn X86PassConfig::addPreISel(self) -> bool {
    let mut TT: *Triple = self.TM.getTargetTriple();
    if TT.isOSWindows() && TT.isX86_32() {
        self.addPass(createX86WinEHStateLegacyPass());
    }
    return true;
}

fn X86PassConfig::addPreRegAlloc(self) {
    if self.getOptLevel() != None {
        self.addPass(&mut LiveRangeShrinkID);
        self.addPass(createX86FixupSetCCLegacyPass());
        self.addPass(createX86OptimizeLEAsLegacyPass());
        self.addPass(createX86CallFrameOptimizationLegacyPass());
        self.addPass(createX86AvoidStoreForwardingBlocksLegacyPass());
    }
    self.addPass(createX86SuppressAPXForRelocationLegacyPass());
    self.addPass(createX86SpeculativeLoadHardeningLegacyPass());
    self.addPass(createX86FlagsCopyLoweringLegacyPass());
    self.addPass(createX86DynAllocaExpanderLegacyPass());
    if self.getOptLevel() != None {
        self.addPass(createX86PreTileConfigLegacyPass());
    } else {
        self.addPass(createX86FastPreTileConfigLegacyPass());
    }
}

fn X86PassConfig::addMachineSSAOptimization(self) {
    self.addPass(createX86DomainReassignmentLegacyPass());
    self.addMachineSSAOptimization();
}

fn X86PassConfig::addPostRegAlloc(self) {
    self.addPass(createX86LowerTileCopyLegacyPass());
    self.addPass(createX86FPStackifierLegacyPass());
    if self.getOptLevel() != None {
        self.addPass(createX86LoadValueInjectionLoadHardeningLegacyPass());
    }
}

fn X86PassConfig::addPreSched2(self) {
    self.addPass(createX86ExpandPseudoLegacyPass());
    self.addPass(createKCFIPass());
}

fn X86PassConfig::addPreEmitPass(self) {
    if self.getOptLevel() != None {
        self.addPass(X86ExecutionDomainFix {});
        self.addPass(createBreakFalseDepsLegacyPass());
    }
    self.addPass(createX86IndirectBranchTrackingLegacyPass());
    self.addPass(createX86InsertVZeroUpperLegacyPass());
    if self.getOptLevel() != None {
        self.addPass(createX86FixupBWInstsLegacyPass());
        self.addPass(createX86PadShortFunctions());
        self.addPass(createX86FixupLEAsLegacyPass());
        self.addPass(createX86FixupInstTuningLegacyPass());
        self.addPass(createX86FixupVectorConstantsLegacyPass());
    }
    self.addPass(createX86CompressEVEXLegacyPass());
    self.addPass(createX86InsertX87WaitLegacyPass());
    if self.TM.getTargetTriple().isLFI() {
        self.addPass(createX86LFIRewritePass());
    }
}

fn X86PassConfig::addPreEmitPass2(self) {
    let mut TT: *Triple = self.TM.getTargetTriple();
    let mut MAI: *MCAsmInfo = self.TM.getMCAsmInfo();
    self.addPass(createX86SpeculativeExecutionSideEffectSuppressionLegacyPass());
    self.addPass(createX86IndirectThunksPass());
    self.addPass(createX86ReturnThunksLegacyPass());
    if TT.isOSWindows() && TT.isX86_64() {
        self.addPass(createX86AvoidTrailingCallLegacyPass());
    }
    if !TT.isOSDarwin() && (!TT.isOSWindows() || MAI.getExceptionHandlingType() == DwarfCFI) {
        self.addPass(createCFIInstrInserterLegacy());
    }
    if TT.isOSWindows() {
        self.addPass(createCFGuardLongjmpPass());
        self.addPass(createEHContGuardTargetsLegacy());
    }
    self.addPass(createX86LoadValueInjectionRetHardeningLegacyPass());
    self.addPass(createPseudoProbeInserter());
    self.addPass(createUnpackMachineBundlesLegacy(Closure_1 { TT: &mut TT }));
    if TT.isOSWindows() && TT.isX86_64() {
        self.addPass(createX86WinEHUnwindV2LegacyPass());
        self.addPass(createX86WinEHUnwindV3Pass());
    }
}

fn X86PassConfig::addPostFastRegAllocRewrite(self) -> bool {
    self.addPass(createX86FastTileConfigLegacyPass());
    return true;
}

fn X86PassConfig::getCSEConfig(self: *X86PassConfig) -> i32 {}

fn onlyAllocateTileRegisters(TRI: *TargetRegisterInfo, MRI: *MachineRegisterInfo, Reg: Register) -> bool {
    let mut RC: *TargetRegisterClass = MRI.getRegClass(Reg);
}

fn X86PassConfig::addRegAssignAndRewriteOptimized(self) -> bool {
    if !self.isCustomizedRegAlloc() &&  {
        self.addPass(createGreedyRegisterAllocator(onlyAllocateTileRegisters));
        self.addPass(createX86TileConfigLegacyPass());
    }
    return self.addRegAssignAndRewriteOptimized();
}

struct Closure_1 {
    TT: *mut Triple,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MF: *MachineFunction) -> bool {
        let mut F: *Function = MF.getFunction();
        let mut M: *Module = F.getParent();
        return M.getModuleFlag("kcfi") || ((*self.TT).isOSDarwin() && (M.getFunction("objc_retainAutoreleasedReturnValue") || M.getFunction("objc_unsafeClaimAutoreleasedReturnValue")));
    }
