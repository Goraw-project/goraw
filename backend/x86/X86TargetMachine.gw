static mut X86EnableMachineCombinerPass: i32 = "x86-machine-combiner";

static mut EnableTileRAPass: i32 = "x86-tile-ra";

fn createTLOF(TT: *Triple) -> i32 {
    if TT.isOSBinFormatMachO() {
        if TT.isX86_64() {
            return make_unique();
        }
        return make_unique();
    }
    if TT.isOSBinFormatCOFF() {
        return make_unique();
    }
    if TT.isX86_64() {
        return make_unique();
    }
    return make_unique();
}

fn getEffectiveRelocModel(TT: *Triple, JIT: bool, RM: Model>) -> Model {
    let mut is64Bit: bool = TT.isX86_64();
    if operator!() {
        if JIT {
            return Static;
        }
        if TT.isOSDarwin() {
            if is64Bit {
                return PIC_;
            }
            return DynamicNoPIC;
        }
        if TT.isOSWindows() && is64Bit {
            return PIC_;
        }
        return Static;
    }
    if operator*() == DynamicNoPIC {
        if is64Bit {
            return PIC_;
        }
        if !TT.isOSDarwin() {
            return Static;
        }
    }
    if operator*() == Static && TT.isOSDarwin() && is64Bit {
        return PIC_;
    }
    return operator*();
}

fn getEffectiveX86CodeModel(TT: *Triple, CM: Model>, JIT: bool) -> Model {
    let mut Is64Bit: bool = TT.isX86_64();
    if CM() {
        if operator*() == Tiny {
            reportFatalUsageError("target does not support the tiny CodeModel");
        }
        return operator*();
    }
    if JIT {
        return if Is64Bit { Large } else { Small };
    }
    return Small;
}

fn X86TargetMachine::X86TargetMachine(self, T: *Target, TT: *Triple, CPU: str, FS: str, Options: *TargetOptions, RM: Model>, CM: Model>, OL: CodeGenOptLevel, JIT: bool) {
    if TT.isPS() || TT.isOSBinFormatMachO() {
        self = true;
        self = TT.isOSBinFormatMachO();
    }
    self.setMachineOutliner;
    self.setSupportsDebugEntryValues;
    self.initAsmInfo;
}

fn X86TargetMachine::~X86TargetMachine(self) {}

fn X86TargetMachine::getSubtargetImpl(self: *X86TargetMachine, F: *Function) -> *X86Subtarget {
    let mut CPUAttr: Attribute = F.getFnAttribute("target-cpu");
    let mut TuneAttr: Attribute = F.getFnAttribute("tune-cpu");
    let mut FSAttr: Attribute = F.getFnAttribute("target-features");
    let mut CPU: str = zeroed();
    let mut TuneCPU: str = if TuneAttr.isValid() { TuneAttr.getValueAsString() } else { if CPU == "x86-64" { "generic" } else { CPU as str } };
    let mut FS: str = zeroed();
    let mut Key: str = zeroed();
    let mut PreferVectorWidthOverride: u32 = 0;
    let mut PreferVecWidthAttr: Attribute = F.getFnAttribute("prefer-vector-width");
    if PreferVecWidthAttr.isValid() {
        let mut Val: str = PreferVecWidthAttr.getValueAsString();
        let mut Width: u32 = 0;
        if !Val {
            operator+=(Key(), 'p');
            operator+=(Key(), Val);
            PreferVectorWidthOverride = Width;
        }
    }
    let mut RequiredVectorWidth: u32 = 4294967295;
    let mut MinLegalVecWidthAttr: Attribute = F.getFnAttribute("min-legal-vector-width");
    if MinLegalVecWidthAttr.isValid() {
        let mut Val: str = MinLegalVecWidthAttr.getValueAsString();
        let mut Width: u32 = 0;
        if !Val {
            operator+=(Key(), 'm');
            operator+=(Key(), Val);
            RequiredVectorWidth = Width;
        }
    }
    operator+=(Key(), CPU);
    operator+=(Key(), TuneCPU);
    let mut FSStart: u32 = ();
    let mut SoftFloat: bool = F.getFnAttribute("use-soft-float").getValueAsBool();
    if SoftFloat {
        operator+=(Key(), if FS.len == 0 { "+soft-float" } else { "+soft-float," });
    }
    operator+=(Key(), FS);
    FS = (FSStart);
    let mut I: *mut auto = null;
    if operator!() {
        I() = make_unique(CPU, TuneCPU, FS, *self, MaybeAlign { F.getParent().getOverrideStackAlignment() }, PreferVectorWidthOverride, RequiredVectorWidth);
    }
    return ();
}

