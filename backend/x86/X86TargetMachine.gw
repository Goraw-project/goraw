static mut X86EnableMachineCombinerPass: opt<bool> = opt<bool> { "x86-machine-combiner", "Enable the machine combiner pass", init(true), Hidden };

static mut EnableTileRAPass: opt<bool> = opt<bool> { "x86-tile-ra", "Enable the tile register allocation pass", init(true), Hidden };

fn LLVMInitializeX86Target() {
    let mut X: RegisterTargetMachine<X86TargetMachine> = getTheX86_32Target();
    let mut Y: RegisterTargetMachine<X86TargetMachine> = getTheX86_64Target();
    let mut PR: *mut PassRegistry = *getPassRegistry();
    initializeX86LowerAMXIntrinsicsLegacyPassPass(PR);
    initializeX86LowerAMXTypeLegacyPassPass(PR);
    initializeX86PreTileConfigLegacyPass(PR);
    initializeGlobalISel(PR);
    initializeWinEHStateLegacyPass(PR);
    initializeX86FixupBWInstLegacyPass(PR);
    initializeCompressEVEXLegacyPass(PR);
    initializeFixupLEAsLegacyPass(PR);
    initializeX86FPStackifierLegacyPass(PR);
    initializeX86FixupSetCCLegacyPass(PR);
    initializeX86CallFrameOptimizationLegacyPass(PR);
    initializeX86CmovConversionLegacyPass(PR);
    initializeX86TileConfigLegacyPass(PR);
    initializeX86FastPreTileConfigLegacyPass(PR);
    initializeX86FastTileConfigLegacyPass(PR);
    initializeMachineKCFILegacyPass(PR);
    initializeX86LowerTileCopyLegacyPass(PR);
    initializeX86ExpandPseudoLegacyPass(PR);
    initializeX86ExecutionDomainFixPass(PR);
    initializeX86DomainReassignmentLegacyPass(PR);
    initializeX86AvoidSFBLegacyPass(PR);
    initializeX86AvoidTrailingCallLegacyPassPass(PR);
    initializeX86SpeculativeLoadHardeningLegacyPass(PR);
    initializeX86SpeculativeExecutionSideEffectSuppressionLegacyPass(PR);
    initializeX86FlagsCopyLoweringLegacyPass(PR);
    initializeX86LoadValueInjectionLoadHardeningLegacyPass(PR);
    initializeX86LoadValueInjectionRetHardeningLegacyPass(PR);
    initializeX86OptimizeLEAsLegacyPass(PR);
    initializeX86PartialReductionLegacyPass(PR);
    initializeX86ReturnThunksLegacyPass(PR);
    initializeX86DAGToDAGISelLegacyPass(PR);
    initializeX86ArgumentStackSlotLegacyPass(PR);
    initializeX86AsmPrinterPass(PR);
    initializeX86FixupInstTuningLegacyPass(PR);
    initializeX86FixupVectorConstantsLegacyPass(PR);
    initializeX86DynAllocaExpanderLegacyPass(PR);
    initializeX86SuppressAPXForRelocationLegacyPass(PR);
    initializeX86WinEHUnwindV2LegacyPass(PR);
    initializeX86PreLegalizerCombinerLegacyPass(PR);
    initializeX86PostLegalizerCombinerLegacyPass(PR);
    initializeX86WinEHUnwindV3Pass(PR);
}

fn createTLOF(TT: *Triple) -> unique_ptr<TargetLoweringObjectFile> {
    if TT.isOSBinFormatMachO() {
        if TT.isX86_64() {
            return make_unique();
        }
        return make_unique();
    }
    if TT.isOSBinFormatCOFF() {
        return make_unique();
    }
    if TT.isX86_64() {
        return make_unique();
    }
    return make_unique();
}

fn getEffectiveRelocModel(TT: *Triple, JIT: bool, RM: Model>) -> Model {
    let mut is64Bit: bool = TT.isX86_64();
    if !RM {
        if JIT {
            return Static;
        }
        if TT.isOSDarwin() {
            if is64Bit {
                return PIC_;
            }
            return DynamicNoPIC;
        }
        if TT.isOSWindows() && is64Bit {
            return PIC_;
        }
        return Static;
    }
    if operator(RM) == DynamicNoPIC {
        if is64Bit {
            return PIC_;
        }
        if !TT.isOSDarwin() {
            return Static;
        }
    }
    if operator(RM) == Static && TT.isOSDarwin() && is64Bit {
        return PIC_;
    }
    return operator(RM);
}

fn getEffectiveX86CodeModel(TT: *Triple, CM: Model>, JIT: bool) -> Model {
    let mut Is64Bit: bool = TT.isX86_64();
    if CM {
        if operator(CM) == Tiny {
            reportFatalUsageError("target does not support the tiny CodeModel");
        }
        return operator(CM);
    }
    if JIT {
        return if Is64Bit { Large } else { Small };
    }
    return Small;
}

fn X86TargetMachine::X86TargetMachine(self, T: *Target, TT: *Triple, CPU: str, FS: str, Options: *TargetOptions, RM: Model>, CM: Model>, OL: CodeGenOptLevel, JIT: bool) {
    if TT.isPS() || TT.isOSBinFormatMachO() {
        self.Options.TrapUnreachable = true;
        self.Options.NoTrapAfterNoreturn = TT.isOSBinFormatMachO();
    }
    self.setMachineOutliner(true);
    self.setSupportsDebugEntryValues(true);
    self.initAsmInfo();
}

fn X86TargetMachine::~X86TargetMachine(self) {}

fn X86TargetMachine::getSubtargetImpl(self: *X86TargetMachine, F: *Function) -> *X86Subtarget {
    let mut CPUAttr: Attribute = F.getFnAttribute("target-cpu");
    let mut TuneAttr: Attribute = F.getFnAttribute("tune-cpu");
    let mut FSAttr: Attribute = F.getFnAttribute("target-features");
    let mut CPU: str = if CPUAttr.isValid() { CPUAttr.getValueAsString() } else { self.TargetCPU as str };
    let mut TuneCPU: str = if TuneAttr.isValid() { TuneAttr.getValueAsString() } else { if CPU == "x86-64" { "generic" } else { CPU as str } };
    let mut FS: str = if FSAttr.isValid() { FSAttr.getValueAsString() } else { self.TargetFS as str };
    let mut Key: str = "";
    let mut PreferVectorWidthOverride: u32 = 0;
    let mut PreferVecWidthAttr: Attribute = F.getFnAttribute("prefer-vector-width");
    if PreferVecWidthAttr.isValid() {
        let mut Val: str = PreferVecWidthAttr.getValueAsString();
        let mut Width: u32 = 0;
        if !Val.getAsInteger(0, Width) {
            operator(Key, 'p');
            operator(Key, Val);
            PreferVectorWidthOverride = Width;
        }
    }
    let mut RequiredVectorWidth: u32 = 4294967295;
    let mut MinLegalVecWidthAttr: Attribute = F.getFnAttribute("min-legal-vector-width");
    if MinLegalVecWidthAttr.isValid() {
        let mut Val: str = MinLegalVecWidthAttr.getValueAsString();
        let mut Width: u32 = 0;
        if !Val.getAsInteger(0, Width) {
            operator(Key, 'm');
            operator(Key, Val);
            RequiredVectorWidth = Width;
        }
    }
    operator(Key, CPU);
    operator(Key, TuneCPU);
    let mut FSStart: u32 = Key.len;
    let mut SoftFloat: bool = F.getFnAttribute("use-soft-float").getValueAsBool();
    if SoftFloat {
        operator(Key, if FS.is_empty() { "+soft-float" } else { "+soft-float," });
    }
    operator(Key, FS);
    FS = Key[FSStart..FSStart + npos];
    let mut I: *mut X86Subtarget> = self.SubtargetMap[Key.operator StringRef()];
    if !I {
        I = make_unique(self.TargetTriple, CPU, TuneCPU, FS, *self, F.getParent().getOverrideStackAlignment(), PreferVectorWidthOverride, RequiredVectorWidth);
    }
    return I.get();
}

fn X86TargetMachine::createDefaultFuncInfoYAML(self: *X86TargetMachine) -> *mut MachineFunctionInfo {
    return X86MachineFunctionInfo {};
}

fn X86TargetMachine::convertFuncInfoToYAML(self: *X86TargetMachine, MF: *MachineFunction) -> *mut MachineFunctionInfo {
    let mut MFI: *X86MachineFunctionInfo const = MF.getInfo();
    return *MFI;
}

fn X86TargetMachine::parseMachineFunctionInfo(self: *X86TargetMachine, MFI: *MachineFunctionInfo, PFS: *mut PerFunctionMIParsingState, Error: *mut SMDiagnostic, SourceRange: *mut SMRange) -> bool {
    let mut YamlMFI: *X86MachineFunctionInfo = MFI as X86MachineFunctionInfo;
    PFS.MF.getInfo().initializeBaseYamlFields(YamlMFI);
    return false;
}

fn X86TargetMachine::isNoopAddrSpaceCast(self: *X86TargetMachine, DL: *DataLayout, SrcAS: u32, DestAS: u32) -> bool {
    assert!(SrcAS != DestAS, "Expected different address spaces!");
    if DL.getPointerSize(SrcAS) != DL.getPointerSize(DestAS) {
        return false;
    }
    return SrcAS < 256 && DestAS < 256;
}

fn X86TargetMachine::reset(self) {
    self.SubtargetMap.clear();
}

fn X86TargetMachine::createMachineScheduler(self: *X86TargetMachine, C: *mut MachineSchedContext) -> *mut ScheduleDAGInstrs {
    let mut DAG: *mut ScheduleDAGMILive = createSchedLive(C);
    DAG.addMutation(createX86MacroFusionDAGMutation());
    return DAG;
}

fn X86TargetMachine::createPostMachineScheduler(self: *X86TargetMachine, C: *mut MachineSchedContext) -> *mut ScheduleDAGInstrs {
    let mut DAG: *mut ScheduleDAGMI = createSchedPostRA(C);
    DAG.addMutation(createX86MacroFusionDAGMutation());
    return DAG;
}

fn X86TargetMachine::getTargetTransformInfo(self: *X86TargetMachine, F: *Function) -> TargetTransformInfo {
    return make_unique(self, F);
}

