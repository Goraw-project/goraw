static mut EnableBranchHint: opt<bool> = opt<bool> { "enable-branch-hint", "Enable branch hint.", init(false), Hidden };

static mut BranchHintProbabilityThreshold: opt<unsigned int> = opt<unsigned int> { "branch-hint-probability-threshold", "The probability threshold of enabling branch hint.", init(50), Hidden };

struct X86MCInstLower {
    Ctx: *mut MCContext,
    MF: *MachineFunction,
    TM: *TargetMachine,
    MAI: *MCAsmInfo,
    AsmPrinter: *mut X86AsmPrinter,
}

struct NoAutoPaddingScope {
    OS: *mut MCStreamer,
    OldAllowAutoPadding: bool,
}

fn NoAutoPaddingScope::NoAutoPaddingScope(self, OS: *mut MCStreamer) {
    self.changeAndComment(false);
}

fn NoAutoPaddingScope::~NoAutoPaddingScope(self) {
    self.changeAndComment(self.OldAllowAutoPadding);
}

fn NoAutoPaddingScope::changeAndComment(self, b: bool) {
    if b == self.OS.getAllowAutoPadding() {
        return;
    }
    self.OS.setAllowAutoPadding(b);
    if b {
        self.OS.emitRawComment("autopadding", true);
    } else {
        self.OS.emitRawComment("noautopadding", true);
    }
}

fn StackMapShadowTracker@X86AsmPrinter@llvm::count(self, Inst: *MCInst, STI: *MCSubtargetInfo, CodeEmitter: *mut MCCodeEmitter) {
    if self.InShadow {
        let mut Code: str = "";
        let mut Fixups: SmallVector<MCFixup, 4> = SmallVector<MCFixup, 4> {};
        CodeEmitter.encodeInstruction(Inst, Code, Fixups, STI);
        self.CurrentShadowSize += Code.len;
        if self.CurrentShadowSize >= self.RequiredShadowSize {
            self.InShadow = false;
        }
    }
}

fn StackMapShadowTracker@X86AsmPrinter@llvm::emitShadowPadding(self, OutStreamer: *mut MCStreamer, STI: *MCSubtargetInfo) {
    if self.InShadow && self.CurrentShadowSize < self.RequiredShadowSize {
        self.InShadow = false;
        emitX86Nops(OutStreamer, self.RequiredShadowSize - self.CurrentShadowSize, &mut self.MF.getSubtarget());
    }
}

fn X86AsmPrinter::EmitAndCountInstruction(self, Inst: *mut MCInst) {
    operator(self.OutStreamer).emitInstruction(Inst, self.getSubtargetInfo());
    self.SMShadowTracker.count(Inst, self.getSubtargetInfo(), self.CodeEmitter.get());
}

fn X86MCInstLower::getMachOMMI(self: *X86MCInstLower) -> *mut MachineModuleInfoMachO {
    return self.AsmPrinter.MMI.getObjFileInfo();
}

fn X86MCInstLower::GetSymbolFromOperand(self: *X86MCInstLower, MO: *MachineOperand) -> *mut MCSymbol {
    let mut TT: *Triple = self.TM.getTargetTriple();
    if MO.isGlobal() && TT.isOSBinFormatELF() {
        return self.AsmPrinter.getSymbolPreferLocal(*MO.getGlobal());
    }
    let mut DL: *DataLayout = self.MF.getDataLayout();
    assert!((MO.isGlobal() || MO.isSymbol() || MO.isMBB()), "Isn't a symbol reference");
    let mut Sym: *mut MCSymbol = null;
    let mut Name: str = "";
    let mut Suffix: str = "";
    match MO.getTargetFlags() {
        MO_DLLIMPORT => {
            operator(Name, "__imp_");
        },
        MO_COFFSTUB => {
            operator(Name, ".refptr.");
        },
        MO_DARWIN_NONLAZY => {
            MO_DARWIN_NONLAZY_PIC_BASE;
        },
    }
    if !Suffix.is_empty() {
        operator(Name, DL.getInternalSymbolPrefix());
    }
    if MO.isGlobal() {
        let mut GV: *GlobalValue = MO.getGlobal();
        self.AsmPrinter.getNameWithPrefix(Name, GV);
    } else if MO.isSymbol() {
        getNameWithPrefix(Name, MO.getSymbolName(), DL);
    } else if MO.isMBB() {
        assert!(Suffix.is_empty();
        Sym = MO.getMBB().getSymbol();
    }
    operator(Name, Suffix);
    if !Sym {
        Sym = self.Ctx.getOrCreateSymbol(Name);
    }
    match MO.getTargetFlags() {
        _ => {
            break;
        },
        MO_COFFSTUB => {
            let mut MMICOFF: *mut MachineModuleInfoCOFF = self.AsmPrinter.MMI.getObjFileInfo();
            let mut StubSym: *mut StubValueTy = MMICOFF.getGVStubEntry(Sym);
            if !StubSym.getPointer() {
                assert!(MO.isGlobal(), "Extern symbol not handled yet");
                StubSym = StubValueTy { self.AsmPrinter.getSymbol(MO.getGlobal()), true };
            }
            break;
        },
        MO_DARWIN_NONLAZY => {
            MO_DARWIN_NONLAZY_PIC_BASE;
        },
    }
    return Sym;
}

fn X86MCInstLower::LowerSymbolOperand(self: *X86MCInstLower, MO: *MachineOperand, Sym: *mut MCSymbol) -> MCOperand {
    let mut Expr: *MCExpr = null;
    let mut Specifier: u16 = S_None;
    match MO.getTargetFlags() {
        _ => {
            llvm_unreachable_internal("Unknown target flag on GV operand", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86MCInstLower.cpp", 242);
        },
        MO_NO_FLAG => {
            MO_DARWIN_NONLAZY;
        },
        MO_TLVP => {
            Specifier = S_TLVP;
        },
        MO_TLVP_PIC_BASE => {
            Expr = create(Sym, S_TLVP, self.Ctx, SMLoc {});
        },
        MO_SECREL => {
            Specifier = S_COFF_SECREL;
        },
        MO_TLSGD => {
            Specifier = S_TLSGD;
        },
        MO_TLSLD => {
            Specifier = S_TLSLD;
        },
        MO_TLSLDM => {
            Specifier = S_TLSLDM;
        },
        MO_GOTTPOFF => {
            Specifier = S_GOTTPOFF;
        },
        MO_INDNTPOFF => {
            Specifier = S_INDNTPOFF;
        },
        MO_TPOFF => {
            Specifier = S_TPOFF;
        },
        MO_DTPOFF => {
            Specifier = S_DTPOFF;
        },
        MO_NTPOFF => {
            Specifier = S_NTPOFF;
        },
        MO_GOTNTPOFF => {
            Specifier = S_GOTNTPOFF;
        },
        MO_GOTPCREL => {
            Specifier = S_GOTPCREL;
        },
        MO_GOTPCREL_NORELAX => {
            Specifier = S_GOTPCREL_NORELAX;
        },
        MO_GOT => {
            Specifier = S_GOT;
        },
        MO_GOTOFF => {
            Specifier = S_GOTOFF;
        },
        MO_PLT => {
            Specifier = S_PLT;
        },
        MO_ABS8 => {
            Specifier = S_ABS8;
        },
        MO_PIC_BASE_OFFSET => {
            MO_DARWIN_NONLAZY_PIC_BASE;
        },
    }
    if !Expr {
        Expr = create(Sym, Specifier, self.Ctx, SMLoc {});
    }
    if !MO.isJTI() && !MO.isMBB() && MO.getOffset() {
        Expr = createAdd(Expr, create(MO.getOffset(), self.Ctx, false, 0), self.Ctx, SMLoc {});
    }
    return createExpr(Expr);
}

fn getRetOpcode(Subtarget: *X86Subtarget) -> u32 {
    return if Subtarget.is64Bit() { RET64 } else { RET32 };
}

fn X86MCInstLower::LowerMachineOperand(self: *X86MCInstLower, MI: *MachineInstr, MO: *MachineOperand) -> MCOperand {
    match MO.getType() {
        _ => {
            MI.print(errs(), true, false, false, true, null);
        },
        MO_Register => {
            if MO.isImplicit() {
                return MCOperand {};
            }
        },
        MO_Immediate => {
            return createImm(MO.getImm());
        },
        MO_MachineBasicBlock => {
            MO_GlobalAddress;
        },
        MO_MCSymbol => {
            return self.LowerSymbolOperand(MO, MO.getMCSymbol());
        },
        MO_JumpTableIndex => {
            return self.LowerSymbolOperand(MO, self.AsmPrinter.GetJTISymbol(MO.getIndex(), false));
        },
        MO_ConstantPoolIndex => {
            return self.LowerSymbolOperand(MO, self.AsmPrinter.GetCPISymbol(MO.getIndex()));
        },
        MO_BlockAddress => {
            return self.LowerSymbolOperand(MO, self.AsmPrinter.GetBlockAddressSymbol(MO.getBlockAddress()));
        },
        MO_RegisterMask => {
            return MCOperand {};
        },
    }
}

fn convertTailJumpOpcode(Opcode: u32, IsLarge: bool) -> u32 {
    match Opcode {
        TAILJMPr => {
            Opcode = JMP32r;
        },
        TAILJMPm => {
            Opcode = JMP32m;
        },
        TAILJMPr64 => {
            Opcode = JMP64r;
        },
        TAILJMPm64 => {
            Opcode = JMP64m;
        },
        TAILJMPr64_REX => {
            Opcode = JMP64r_REX;
        },
        TAILJMPm64_REX => {
            Opcode = JMP64m_REX;
        },
        TAILJMPd => {
            TAILJMPd64;
        },
        TAILJMPd_CC => {
            TAILJMPd64_CC;
        },
    }
    return Opcode;
}

fn X86MCInstLower::Lower(self: *X86MCInstLower, MI: *MachineInstr, OutMI: *mut MCInst) {
    OutMI.setOpcode(MI.getOpcode());
    for MO in MI.operands() {
        let mut Op: MCOperand = self.LowerMachineOperand(MI, MO);
        if Op.isValid() {
            OutMI.addOperand(Op);
        }
    }
    let mut In64BitMode: bool = self.AsmPrinter.getSubtarget().is64Bit();
    if optimizeInstFromVEX3ToVEX2(OutMI, MI.getDesc()) || optimizeShiftRotateWithImmediateOne(OutMI) || optimizeVPCMPWithImmediateOneOrSix(OutMI) || optimizeMOVSX(OutMI) || optimizeINCDEC(OutMI, In64BitMode) || optimizeMOV(OutMI, In64BitMode) || optimizeToFixedRegisterOrShortImmediateForm(OutMI) {
        return;
    }
    match OutMI.getOpcode() {
        LEA64_32r => {
            LEA64r;
        },
        MULX32Hrr => {
            MULX32Hrm;
        },
        CALL64r => {
            CALL64pcrel32;
        },
        EH_RETURN => {
            EH_RETURN64;
        },
        CLEANUPRET => {
            OutMI = MCInst {};
            OutMI.setOpcode(getRetOpcode(self.AsmPrinter.getSubtarget()));
            break;
        },
        CATCHRET => {
            let mut Subtarget: *X86Subtarget = self.AsmPrinter.getSubtarget();
            let mut ReturnReg: u32 = if In64BitMode { RAX } else { EAX };
            OutMI = MCInst {};
            OutMI.setOpcode(getRetOpcode(Subtarget));
            OutMI.addOperand(createReg(ReturnReg));
            break;
        },
        TAILJMPr => {
            TAILJMPr64;
        },
        TAILJMPd64 => {
            assert!(OutMI.getNumOperands() == 1, "Unexpected number of operands!");
            let mut IsLarge: bool = self.TM.getCodeModel() == Large;
            assert!((!IsLarge || self.AsmPrinter.getSubtarget().hasJMPABS()), "Unexpected TAILJMPd64 in large code model without JMPABS");
            OutMI.setOpcode(convertTailJumpOpcode(OutMI.getOpcode(), IsLarge));
            break;
        },
        TAILJMPd_CC => {
            TAILJMPd64_CC;
        },
        TAILJMPm => {
            TAILJMPm64;
        },
        MASKMOVDQU => {
            VMASKMOVDQU;
        },
        BSF16rm => {
            BSF16rr;
        },
        _ => {
            break;
        },
    }
}

fn X86AsmPrinter::LowerTlsAddr(self, MCInstLowering: *mut X86MCInstLower, MI: *MachineInstr) {
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut Is64Bits: bool = self.getSubtarget().is64Bit();
    let mut Is64BitsLP64: bool = self.getSubtarget().isTarget64BitLP64();
    let mut Ctx: *mut MCContext = operator(self.OutStreamer).getContext();
    let mut Specifier: Specifier = zeroed();
    match MI.getOpcode() {
        TLS_addr32 => {
            TLS_addr64;
        },
        TLS_base_addr32 => {
            Specifier = S_TLSLDM;
        },
        TLS_base_addr64 => {
            TLS_base_addrX32;
        },
        TLS_desc32 => {
            TLS_desc64;
        },
        _ => {
            llvm_unreachable_internal("unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86MCInstLower.cpp", 563);
        },
    }
    let mut Sym: *MCSymbolRefExpr = create(MCInstLowering.GetSymbolFromOperand(MI.getOperand(3)), Specifier, Ctx, SMLoc {});
    let mut UseGot: bool = self.MMI.getModule().getRtLibUseGOT() && Ctx.getTargetOptions().X86RelaxRelocations;
    if Specifier == S_TLSDESC {
        let mut Expr: *MCSymbolRefExpr = create(MCInstLowering.GetSymbolFromOperand(MI.getOperand(3)), S_TLSCALL, Ctx, SMLoc {});
        self.EmitAndCountInstruction(if Is64BitsLP64 { LEA64r } else { LEA32r }.addReg(if Is64BitsLP64 { RAX } else { EAX }).addReg(if Is64Bits { RIP } else { EBX }).addImm(1).addReg(0).addExpr(Sym).addReg(0).operator llvm::MCInst &());
        self.EmitAndCountInstruction(if Is64Bits { CALL64m } else { CALL32m }.addReg(if Is64BitsLP64 { RAX } else { EAX }).addImm(1).addReg(0).addExpr(Expr).addReg(0).operator llvm::MCInst &());
    } else if Is64Bits {
        let mut NeedsPadding: bool = Specifier == S_TLSGD;
        if NeedsPadding && Is64BitsLP64 {
            self.EmitAndCountInstruction(DATA16_PREFIX.operator llvm::MCInst &());
        }
        self.EmitAndCountInstruction(LEA64r.addReg(RDI).addReg(RIP).addImm(1).addReg(0).addExpr(Sym).addReg(0).operator llvm::MCInst &());
        let mut TlsGetAddr: *MCSymbol = Ctx.getOrCreateSymbol("__tls_get_addr");
        if NeedsPadding {
            if !UseGot {
                self.EmitAndCountInstruction(DATA16_PREFIX.operator llvm::MCInst &());
            }
            self.EmitAndCountInstruction(DATA16_PREFIX.operator llvm::MCInst &());
            self.EmitAndCountInstruction(REX64_PREFIX.operator llvm::MCInst &());
        }
        if UseGot {
            let mut Expr: *MCExpr = create(TlsGetAddr, S_GOTPCREL, Ctx, SMLoc {});
            self.EmitAndCountInstruction(CALL64m.addReg(RIP).addImm(1).addReg(0).addExpr(Expr).addReg(0).operator llvm::MCInst &());
        } else {
            self.EmitAndCountInstruction(CALL64pcrel32.addExpr(create(TlsGetAddr, S_PLT, Ctx, SMLoc {})).operator llvm::MCInst &());
        }
    } else {
        if Specifier == S_TLSGD && !UseGot {
            self.EmitAndCountInstruction(LEA32r.addReg(EAX).addReg(0).addImm(1).addReg(EBX).addExpr(Sym).addReg(0).operator llvm::MCInst &());
        } else {
            self.EmitAndCountInstruction(LEA32r.addReg(EAX).addReg(EBX).addImm(1).addReg(0).addExpr(Sym).addReg(0).operator llvm::MCInst &());
        }
        let mut TlsGetAddr: *MCSymbol = Ctx.getOrCreateSymbol("___tls_get_addr");
        if UseGot {
            let mut Expr: *MCExpr = create(TlsGetAddr, S_GOT, Ctx, SMLoc {});
            self.EmitAndCountInstruction(CALL32m.addReg(EBX).addImm(1).addReg(0).addExpr(Expr).addReg(0).operator llvm::MCInst &());
        } else {
            self.EmitAndCountInstruction(CALLpcrel32.addExpr(create(TlsGetAddr, S_PLT, Ctx, SMLoc {})).operator llvm::MCInst &());
        }
    }
}

fn emitNop(OS: *mut MCStreamer, NumBytes: u32, Subtarget: *X86Subtarget) -> u32 {
    let mut MaxNopLength: u32 = 1;
    if Subtarget.is64Bit() {
        if Subtarget.hasFeature(TuningFast7ByteNOP) {
            MaxNopLength = 7;
        } else if Subtarget.hasFeature(TuningFast15ByteNOP) {
            MaxNopLength = 15;
        } else if Subtarget.hasFeature(TuningFast11ByteNOP) {
            MaxNopLength = 11;
        } else {
            MaxNopLength = 10;
        }
    }
    if Subtarget.is32Bit() {
        MaxNopLength = 2;
    }
    NumBytes = if NumBytes < MaxNopLength { NumBytes } else { MaxNopLength };
    let mut NopSize: u32 = 0;
    let mut Opc: u32 = 0;
    let mut BaseReg: u32 = 0;
    let mut ScaleVal: u32 = 0;
    let mut IndexReg: u32 = 0;
    let mut Displacement: u32 = 0;
    let mut SegmentReg: u32 = 0;
    IndexReg = Displacement = SegmentReg = 0;
    BaseReg = RAX;
    ScaleVal = 1;
    match NumBytes {
        0 => {
            llvm_unreachable_internal("Zero nops?", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86MCInstLower.cpp", 696);
        },
        1 => {
            NopSize = 1;
        },
        2 => {
            NopSize = 2;
        },
        3 => {
            NopSize = 3;
        },
        4 => {
            NopSize = 4;
        },
        5 => {
            NopSize = 5;
        },
        6 => {
            NopSize = 6;
        },
        7 => {
            NopSize = 7;
        },
        8 => {
            NopSize = 8;
        },
        9 => {
            NopSize = 9;
        },
        _ => {
            NopSize = 10;
        },
    }
    let mut NumPrefixes: u32 = if NumBytes - NopSize < 5 { NumBytes - NopSize } else { 5 };
    NopSize += NumPrefixes;
    for let mut i: u32 = 0; i != NumPrefixes; i += 1 {
        OS.emitBytes("f");
    }
    match Opc {
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86MCInstLower.cpp", 759);
        },
        NOOP => {
            OS.emitInstruction(Opc.operator llvm::MCInst &(), *Subtarget);
        },
        XCHG16ar => {
            OS.emitInstruction(Opc.addReg(AX).addReg(AX).operator llvm::MCInst &(), *Subtarget);
        },
        NOOPL => {
            NOOPW;
        },
    }
    assert!(NopSize <= NumBytes, "We overemitted?");
    return NopSize;
}

fn emitX86Nops(OS: *mut MCStreamer, NumBytes: u32, Subtarget: *X86Subtarget) {
    let mut NopsToEmit: u32 = NumBytes;
    NopsToEmit as void;
    while NumBytes {
        NumBytes -= emitNop(OS, NumBytes, Subtarget);
        assert!(NopsToEmit >= NumBytes, "Emitted more than I asked for!");
    }
}

fn X86AsmPrinter::LowerSTATEPOINT(self, MI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    assert!(self.Subtarget.is64Bit(), "Statepoint currently only supports X86-64");
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut SOpers: StatepointOpers = &mut MI;
    if SOpers.getNumPatchBytes() {
        PatchBytes;
    } else {
        emitX86Nops(operator(self.OutStreamer), PatchBytes, self.Subtarget);
    }
    let mut Ctx: *mut MCContext = operator(self.OutStreamer).getContext();
    let mut MILabel: *mut MCSymbol = Ctx.createTempSymbol();
    operator(self.OutStreamer).emitLabel(MILabel, SMLoc {});
    self.SM.recordStatepoint(*MILabel, MI);
}

fn X86AsmPrinter::LowerFAULTING_OP(self, FaultingMI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut DefRegister: Register = FaultingMI.getOperand(0).getReg();
    let mut FK: FaultKind = FaultingMI.getOperand(1).getImm() as FaultKind;
    let mut HandlerLabel: *mut MCSymbol = FaultingMI.getOperand(2).getMBB().getSymbol();
    let mut Opcode: u32 = FaultingMI.getOperand(3).getImm();
    let mut OperandsBeginIdx: u32 = 4;
    let mut Ctx: *mut MCContext = operator(self.OutStreamer).getContext();
    let mut FaultingLabel: *mut MCSymbol = Ctx.createTempSymbol();
    operator(self.OutStreamer).emitLabel(FaultingLabel, SMLoc {});
    assert!(FK < FaultKindMax, "Invalid Faulting Kind!");
    self.FM.recordFaultingOp(FK, FaultingLabel, HandlerLabel);
    let mut MI: MCInst = MCInst {};
    MI.setOpcode(Opcode);
    if DefRegister != NoRegister {
        MI.addOperand(createReg(DefRegister.operator MCRegister()));
    }
    for MO in drop_begin(FaultingMI.operands(), OperandsBeginIdx) {
        let mut Op: MCOperand = MCIL.LowerMachineOperand(&mut FaultingMI, MO);
        if Op.isValid() {
            MI.addOperand(Op);
        }
    }
    operator(self.OutStreamer).AddComment("on-fault: " + HandlerLabel.getName(), true);
    operator(self.OutStreamer).emitInstruction(MI, self.getSubtargetInfo());
}

fn X86AsmPrinter::LowerFENTRY_CALL(self, MI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    let mut Is64Bits: bool = self.Subtarget.is64Bit();
    let mut Ctx: *mut MCContext = operator(self.OutStreamer).getContext();
    let mut fentry: *mut MCSymbol = Ctx.getOrCreateSymbol("__fentry__");
    let mut Op: *MCSymbolRefExpr = create(fentry, Ctx, SMLoc {});
    self.EmitAndCountInstruction(if Is64Bits { CALL64pcrel32 } else { CALLpcrel32 }.addExpr(Op).operator llvm::MCInst &());
}

fn X86AsmPrinter::LowerKCFI_CHECK(self, MI: *MachineInstr) {
    assert!(operator(next(MI.getIterator(), 1)).isCall(AnyInBundle), "KCFI_CHECK not followed by a call instruction");
    let mut MF: *MachineFunction = *MI.getMF();
    let mut PrefixNops: i64 = MF.getFunction().getFnAttributeAsParsedInteger("patchable-function-prefix", 0);
    let mut AddrReg: Register = MI.getOperand(0).getReg();
    let mut Type: u32 = MI.getOperand(1).getImm();
    let mut TempReg: u32 = if AddrReg == R10 { R11D } else { R10D };
    self.EmitAndCountInstruction(MOV32ri.addReg(TempReg).addImm(-self.MaskKCFIType(Type)).operator llvm::MCInst &());
    self.EmitAndCountInstruction(ADD32rm.addReg(NoRegister).addReg(TempReg).addReg(AddrReg.operator MCRegister()).addImm(1).addReg(NoRegister).addImm(-(PrefixNops + 4)).addReg(NoRegister).operator llvm::MCInst &());
    let mut Pass: *mut MCSymbol = self.OutContext.createTempSymbol();
    self.EmitAndCountInstruction(JCC_1.addExpr(create(Pass, self.OutContext, SMLoc {})).addImm(COND_E).operator llvm::MCInst &());
    let mut Trap: *mut MCSymbol = self.OutContext.createTempSymbol();
    operator(self.OutStreamer).emitLabel(Trap, SMLoc {});
    self.EmitAndCountInstruction(TRAP.operator llvm::MCInst &());
    self.emitKCFITrapEntry(MF, Trap);
    operator(self.OutStreamer).emitLabel(Pass, SMLoc {});
}

fn X86AsmPrinter::LowerASAN_CHECK_MEMACCESS(self, MI: *MachineInstr) {
    if !self.TM.getTargetTriple().isOSBinFormatELF() {
        report_fatal_error("llvm.asan.check.memaccess only supported on ELF", true);
        return;
    }
    let mut Reg: *Register = MI.getOperand(0).getReg();
    let mut AccessInfo: ASanAccessInfo = MI.getOperand(1).getImm();
    let mut ShadowBase: u64 = 0;
    let mut MappingScale: i32 = 0;
    let mut OrShadowOffset: bool = false;
    getAddressSanitizerParams(self.TM.getTargetTriple(), 64, AccessInfo.CompileKernel, &mut ShadowBase, &mut MappingScale, &mut OrShadowOffset);
    let mut Name: str = if AccessInfo.IsWrite { "store" } else { "load" };
    let mut Op: str = if OrShadowOffset { "or" } else { "add" };
    let mut SymName: str = ("__asan_check_" + Name + "_" + Op + "_" + 1 << AccessInfo.AccessSizeIndex + "_" + self.TM.getMCRegisterInfo().getName(Reg.asMCReg()));
    if OrShadowOffset {
        report_fatal_error("OrShadowOffset is not supported with optimized callbacks", true);
    }
    self.EmitAndCountInstruction(CALL64pcrel32.addExpr(create(self.OutContext.getOrCreateSymbol(SymName), self.OutContext, SMLoc {})).operator llvm::MCInst &());
}

fn X86AsmPrinter::LowerPATCHABLE_OP(self, MI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut NextMI: MachineInstr, true, true, void, false, void>, false, true> = find_if(next(MI.getIterator(), 1), MI.getParent().end().getInstrIterator(), Closure_1 {});
    let mut Code: str = "";
    let mut MinSize: u32 = MI.getOperand(0).getImm();
    if NextMI != MI.getParent().end() && !operator(NextMI).isInlineAsm() {
        let mut MCI: MCInst = MCInst {};
        MCIL.Lower(&mut operator(NextMI), MCI);
        let mut Fixups: SmallVector<MCFixup, 4> = SmallVector<MCFixup, 4> {};
        operator(self.CodeEmitter).encodeInstruction(MCI, Code, Fixups, self.getSubtargetInfo());
    }
    if Code.len < MinSize {
        if MinSize == 2 && self.Subtarget.is32Bit() && self.Subtarget.isTargetWindowsMSVC() && (self.Subtarget.getCPU().is_empty() || self.Subtarget.getCPU() == "pentium3") {
            operator(self.OutStreamer).emitInstruction(MOV32rr_REV.addReg(EDI).addReg(EDI).operator llvm::MCInst &(), *self.Subtarget);
        } else {
            let mut NopSize: u32 = emitNop(operator(self.OutStreamer), MinSize, self.Subtarget);
            assert!(NopSize == MinSize, "Could not implement MinSize!");
            NopSize as void;
        }
    }
}

fn X86AsmPrinter::LowerSTACKMAP(self, MI: *MachineInstr) {
    self.SMShadowTracker.emitShadowPadding(operator(self.OutStreamer), self.getSubtargetInfo());
    let mut Ctx: *mut MCContext = operator(self.OutStreamer).getContext();
    let mut MILabel: *mut MCSymbol = Ctx.createTempSymbol();
    operator(self.OutStreamer).emitLabel(MILabel, SMLoc {});
    self.SM.recordStackMap(*MILabel, MI);
    let mut NumShadowBytes: u32 = MI.getOperand(1).getImm();
    self.SMShadowTracker.reset(NumShadowBytes);
}

fn X86AsmPrinter::LowerPATCHPOINT(self, MI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    assert!(self.Subtarget.is64Bit(), "Patchpoint currently only supports X86-64");
    self.SMShadowTracker.emitShadowPadding(operator(self.OutStreamer), self.getSubtargetInfo());
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut Ctx: *mut MCContext = operator(self.OutStreamer).getContext();
    let mut MILabel: *mut MCSymbol = Ctx.createTempSymbol();
    operator(self.OutStreamer).emitLabel(MILabel, SMLoc {});
    self.SM.recordPatchPoint(*MILabel, MI);
    let mut opers: PatchPointOpers = &mut MI;
    let mut ScratchIdx: u32 = opers.getNextScratchIdx(0);
    let mut EncodedBytes: u32 = 0;
    let mut CalleeMO: *MachineOperand = opers.getCallTarget();
    if !(CalleeMO.isImm() && !CalleeMO.getImm()) {
        let mut CalleeMCOp: MCOperand = MCOperand {};
        match CalleeMO.getType() {
            _ => {
                llvm_unreachable_internal("Unrecognized callee operand type.", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86MCInstLower.cpp", 1065);
            },
            MO_Immediate => {
                if CalleeMO.getImm() {
                    CalleeMCOp = createImm(CalleeMO.getImm());
                }
            },
            MO_ExternalSymbol => {
                MO_GlobalAddress;
            },
        }
        let mut ScratchReg: Register = MI.getOperand(ScratchIdx).getReg();
        if isX86_64ExtendedReg(ScratchReg.operator MCRegister()) {
            EncodedBytes = 13;
        } else {
            EncodedBytes = 12;
        }
        self.EmitAndCountInstruction(MOV64ri.addReg(ScratchReg.operator MCRegister()).addOperand(CalleeMCOp).operator llvm::MCInst &());
        if self.Subtarget.useIndirectThunkCalls() {
            report_fatal_error("Lowering patchpoint with thunks not yet implemented.", true);
        }
        self.EmitAndCountInstruction(CALL64r.addReg(ScratchReg.operator MCRegister()).operator llvm::MCInst &());
    }
    let mut NumBytes: u32 = opers.getNumPatchBytes();
    assert!(NumBytes >= EncodedBytes, "Patchpoint can't request size less than the length of a call.");
    emitX86Nops(operator(self.OutStreamer), NumBytes - EncodedBytes, self.Subtarget);
}

fn X86AsmPrinter::LowerPATCHABLE_EVENT_CALL(self, MI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    assert!(self.Subtarget.is64Bit(), "XRay custom events only supports X86-64");
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut CurSled: *mut MCSymbol = self.OutContext.createTempSymbol("xray_event_sled_", true);
    operator(self.OutStreamer).AddComment("# XRay Custom Event Log", true);
    operator(self.OutStreamer).emitCodeAlignment(2, self.getSubtargetInfo(), 0);
    operator(self.OutStreamer).emitLabel(CurSled, SMLoc {});
    operator(self.OutStreamer).emitBinaryData("\353\017");
    let mut DestRegs: [2]Register = [RDI, RSI];
    let mut UsedMask: [2]bool = [false, false];
    let mut SrcRegs: [2]Register = [0, 0];
    for let mut I: u32 = 0; I < MI.getNumOperands(); I += 1 {
        let mut Op: MCOperand = MCIL.LowerMachineOperand(&mut MI, MI.getOperand(I));
        if Op.isValid() {
            assert!(Op.isReg(), "Only support arguments in registers");
            SrcRegs[I] = getX86SubSuperRegister(Op.getReg(), 64, false);
            assert!(SrcRegs[I].isValid(), "Invalid operand");
            if SrcRegs[I] != DestRegs[I] {
                UsedMask[I] = true;
                self.EmitAndCountInstruction(PUSH64r.addReg(DestRegs[I].operator MCRegister()).operator llvm::MCInst &());
            } else {
                emitX86Nops(operator(self.OutStreamer), 4, self.Subtarget);
            }
        }
    }
    for let mut I: u32 = 0; I < MI.getNumOperands(); I += 1 {
        if SrcRegs[I] != DestRegs[I] {
            self.EmitAndCountInstruction(MOV64rr.addReg(DestRegs[I].operator MCRegister()).addReg(SrcRegs[I].operator MCRegister()).operator llvm::MCInst &());
        }
    }
    let mut TSym: *mut MCSymbol = self.OutContext.getOrCreateSymbol("__xray_CustomEvent");
    let mut TOp: MachineOperand = CreateMCSymbol(TSym, 0);
    if self.isPositionIndependent() {
        TOp.setTargetFlags(MO_PLT);
    }
    self.EmitAndCountInstruction(CALL64pcrel32.addOperand(MCIL.LowerSymbolOperand(TOp, TSym)).operator llvm::MCInst &());
    for let mut I: u32 = UsedMask; I -= 1 > 0;  {
        if UsedMask[I] {
            self.EmitAndCountInstruction(POP64r.addReg(DestRegs[I].operator MCRegister()).operator llvm::MCInst &());
        } else {
            emitX86Nops(operator(self.OutStreamer), 1, self.Subtarget);
        }
    }
    operator(self.OutStreamer).AddComment("xray custom event end.", true);
    self.recordSled(CurSled, MI, CUSTOM_EVENT, 2);
}

fn X86AsmPrinter::LowerPATCHABLE_TYPED_EVENT_CALL(self, MI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    assert!(self.Subtarget.is64Bit(), "XRay typed events only supports X86-64");
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut CurSled: *mut MCSymbol = self.OutContext.createTempSymbol("xray_typed_event_sled_", true);
    operator(self.OutStreamer).AddComment("# XRay Typed Event Log", true);
    operator(self.OutStreamer).emitCodeAlignment(2, self.getSubtargetInfo(), 0);
    operator(self.OutStreamer).emitLabel(CurSled, SMLoc {});
    operator(self.OutStreamer).emitBinaryData("\353\024");
    let mut DestRegs: [3]Register = [RDI, RSI, RDX];
    let mut UsedMask: [3]bool = [false, false, false];
    let mut SrcRegs: [3]Register = [0, 0, 0];
    for let mut I: u32 = 0; I < MI.getNumOperands(); I += 1 {
        let mut Op: MCOperand = MCIL.LowerMachineOperand(&mut MI, MI.getOperand(I));
        if Op.isValid() {
            assert!(Op.isReg(), "Only supports arguments in registers");
            SrcRegs[I] = getX86SubSuperRegister(Op.getReg(), 64, false);
            assert!(SrcRegs[I].isValid(), "Invalid operand");
            if SrcRegs[I] != DestRegs[I] {
                UsedMask[I] = true;
                self.EmitAndCountInstruction(PUSH64r.addReg(DestRegs[I].operator MCRegister()).operator llvm::MCInst &());
            } else {
                emitX86Nops(operator(self.OutStreamer), 4, self.Subtarget);
            }
        }
    }
    for let mut I: u32 = 0; I < MI.getNumOperands(); I += 1 {
        if UsedMask[I] {
            self.EmitAndCountInstruction(MOV64rr.addReg(DestRegs[I].operator MCRegister()).addReg(SrcRegs[I].operator MCRegister()).operator llvm::MCInst &());
        }
    }
    let mut TSym: *mut MCSymbol = self.OutContext.getOrCreateSymbol("__xray_TypedEvent");
    let mut TOp: MachineOperand = CreateMCSymbol(TSym, 0);
    if self.isPositionIndependent() {
        TOp.setTargetFlags(MO_PLT);
    }
    self.EmitAndCountInstruction(CALL64pcrel32.addOperand(MCIL.LowerSymbolOperand(TOp, TSym)).operator llvm::MCInst &());
    for let mut I: u32 = UsedMask; I -= 1 > 0;  {
        if UsedMask[I] {
            self.EmitAndCountInstruction(POP64r.addReg(DestRegs[I].operator MCRegister()).operator llvm::MCInst &());
        } else {
            emitX86Nops(operator(self.OutStreamer), 1, self.Subtarget);
        }
    }
    operator(self.OutStreamer).AddComment("xray typed event end.", true);
    self.recordSled(CurSled, MI, TYPED_EVENT, 2);
}

fn X86AsmPrinter::LowerPATCHABLE_FUNCTION_ENTER(self, MI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut F: *Function = self.MF.getFunction();
    if F.hasFnAttribute("patchable-function-entry") {
        let mut Num: u32 = F.getFnAttributeAsParsedInteger("patchable-function-entry", 0);
        emitX86Nops(operator(self.OutStreamer), Num, self.Subtarget);
        return;
    }
    let mut CurSled: *mut MCSymbol = self.OutContext.createTempSymbol("xray_sled_", true);
    operator(self.OutStreamer).emitCodeAlignment(2, self.getSubtargetInfo(), 0);
    operator(self.OutStreamer).emitLabel(CurSled, SMLoc {});
    operator(self.OutStreamer).emitBytes("\353\t");
    emitX86Nops(operator(self.OutStreamer), 9, self.Subtarget);
    self.recordSled(CurSled, MI, FUNCTION_ENTER, 2);
}

fn X86AsmPrinter::LowerPATCHABLE_RET(self, MI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut CurSled: *mut MCSymbol = self.OutContext.createTempSymbol("xray_sled_", true);
    operator(self.OutStreamer).emitCodeAlignment(2, self.getSubtargetInfo(), 0);
    operator(self.OutStreamer).emitLabel(CurSled, SMLoc {});
    let mut OpCode: u32 = MI.getOperand(0).getImm();
    let mut Ret: MCInst = MCInst {};
    Ret.setOpcode(OpCode);
    for MO in drop_begin(MI.operands(), 1) {
        let mut Op: MCOperand = MCIL.LowerMachineOperand(&mut MI, MO);
        if Op.isValid() {
            Ret.addOperand(Op);
        }
    }
    operator(self.OutStreamer).emitInstruction(Ret, self.getSubtargetInfo());
    emitX86Nops(operator(self.OutStreamer), 10, self.Subtarget);
    self.recordSled(CurSled, MI, FUNCTION_EXIT, 2);
}

fn X86AsmPrinter::LowerPATCHABLE_TAIL_CALL(self, MI: *MachineInstr, MCIL: *mut X86MCInstLower) {
    let mut TC: MCInst = MCInst {};
    TC.setOpcode(convertTailJumpOpcode(MI.getOperand(0).getImm(), false));
    let mut TCOperands: MachineOperand *> = drop_begin(MI.operands(), 1);
    let mut IsConditional: bool = TC.getOpcode() == JCC_1;
    let mut FallthroughLabel: *mut MCSymbol = null;
    if IsConditional {
        FallthroughLabel = self.OutContext.createTempSymbol();
        self.EmitToStreamer(operator(self.OutStreamer), JCC_1.addExpr(create(FallthroughLabel, self.OutContext, SMLoc {})).addImm(GetOppositeBranchCondition(MI.getOperand(2).getImm() as CondCode)).operator llvm::MCInst &());
        TC.setOpcode(JMP_1);
        TCOperands = drop_end(TCOperands, 1);
    }
    let mut NoPadScope: NoAutoPaddingScope = operator(self.OutStreamer);
    let mut CurSled: *mut MCSymbol = self.OutContext.createTempSymbol("xray_sled_", true);
    operator(self.OutStreamer).emitCodeAlignment(2, self.getSubtargetInfo(), 0);
    operator(self.OutStreamer).emitLabel(CurSled, SMLoc {});
    let mut Target: *mut MCSymbol = self.OutContext.createTempSymbol();
    operator(self.OutStreamer).emitBytes("\353\t");
    emitX86Nops(operator(self.OutStreamer), 9, self.Subtarget);
    operator(self.OutStreamer).emitLabel(Target, SMLoc {});
    self.recordSled(CurSled, MI, TAIL_CALL, 2);
    operator(self.OutStreamer).AddComment("TAILCALL", true);
    for MO in TCOperands {
        let mut Op: MCOperand = MCIL.LowerMachineOperand(&mut MI, MO);
        if Op.isValid() {
            TC.addOperand(Op);
        }
    }
    operator(self.OutStreamer).emitInstruction(TC, self.getSubtargetInfo());
    if IsConditional {
        operator(self.OutStreamer).emitLabel(FallthroughLabel, SMLoc {});
    }
}

fn getSrcIdx(MI: *MachineInstr, SrcIdx: u32) -> u32 {
    if isKMasked(MI.getDesc().TSFlags) {
        SrcIdx += 1;
        if isKMergeMasked(MI.getDesc().TSFlags) {
            SrcIdx += 1;
        }
    }
    return SrcIdx;
}

fn printDstRegisterName(CS: *mut raw_ostream, MI: *MachineInstr, SrcOpIdx: u32) {
    let mut DstOp: *MachineOperand = MI.getOperand(0);
    CS << getRegisterName(DstOp.getReg().operator MCRegister());
    if isKMasked(MI.getDesc().TSFlags) {
        let mut WriteMaskOp: *MachineOperand = MI.getOperand(SrcOpIdx - 1);
        let mut Mask: str = getRegisterName(WriteMaskOp.getReg().operator MCRegister());
        CS << " {%" << Mask << "}";
        if !isKMergeMasked(MI.getDesc().TSFlags) {
            CS << " {z}";
        }
    }
}

fn printShuffleMask(CS: *mut raw_ostream, Src1Name: str, Src2Name: str, Mask: ArrayRef<int>) {
    let mut ShuffleMask: SmallVector<int, 8> = Mask;
    if Src1Name == Src2Name {
        for let mut i: i32 = 0;
let mut e: i32 = ShuffleMask.len; i != e; i += 1 {
            if ShuffleMask[i] >= e {
                ShuffleMask[i] -= e;
            }
        }
    }
    for let mut i: i32 = 0;
let mut e: i32 = ShuffleMask.len; i != e; i += 1 {
        if i != 0 {
            CS << ",";
        }
        if ShuffleMask[i] == SM_SentinelZero {
            CS << "zero";
            continue;
        }
        let mut isSrc1: bool = ShuffleMask[i] < e as i32;
        CS << (if isSrc1 { Src1Name } else { Src2Name }) << '[';
        let mut IsFirst: bool = true;
        while i != e && ShuffleMask[i] != SM_SentinelZero && (ShuffleMask[i] < e as i32) == isSrc1 {
            if !IsFirst {
                CS << ',';
            } else {
                IsFirst = false;
            }
            if ShuffleMask[i] == SM_SentinelUndef {
                CS << "u";
            } else {
                CS << ShuffleMask[i] % e as i32;
            }
            i += 1;
        }
        CS << ']';
        i -= 1;
    }
}

fn getShuffleComment(MI: *MachineInstr, SrcOp1Idx: u32, SrcOp2Idx: u32, Mask: ArrayRef<int>) -> str {
    let mut Comment: str = "";
    let mut SrcOp1: *MachineOperand = MI.getOperand(SrcOp1Idx);
    let mut SrcOp2: *MachineOperand = MI.getOperand(SrcOp2Idx);
    let mut Src1Name: str = if SrcOp1.isReg() { getRegisterName(SrcOp1.getReg().operator MCRegister()) } else { "mem" };
    let mut Src2Name: str = if SrcOp2.isReg() { getRegisterName(SrcOp2.getReg().operator MCRegister()) } else { "mem" };
    let mut CS: raw_string_ostream = Comment;
    printDstRegisterName(CS, MI, SrcOp1Idx);
    CS << " = ";
    printShuffleMask(CS, Src1Name, Src2Name, Mask);
    return Comment;
}

fn printConstant(Val: *APInt, CS: *mut raw_ostream, PrintZero: bool) {
    if Val.getBitWidth() <= 64 {
        CS << (if PrintZero { 0 } else { Val.getZExtValue() });
    } else {
        CS << "(";
        for let mut i: i32 = 0;
let mut N: i32 = Val.getNumWords(); i < N; i += 1 {
            if i > 0 {
                CS << ",";
            }
            CS << (if PrintZero { 0 } else { Val.getRawData()[i] });
        }
        CS << ")";
    }
}

fn printConstant(Flt: *APFloat, CS: *mut raw_ostream, PrintZero: bool) {
    let mut Str: str = "";
    if PrintZero {
        getZero(Flt.getSemantics(), false).toString(Str, 0, 0, true);
    } else {
        Flt.toString(Str, 0, 0, true);
    }
    CS << Str;
}

fn printConstant(COp: *Constant, BitWidth: u32, CS: *mut raw_ostream, PrintZero: bool) {
    if isa(COp) {
        CS << "u";
    } else if dyn_cast(COp) {
        CI;
    } else {
        if dyn_cast(CI.getType()) {
            VTy;
        } else {
            for let mut I: u32 = 0;
let mut E: u32 = VTy.getNumElements(); I != E; I += 1 {
                if I != 0 {
                    CS << ',';
                }
                printConstant(CI.getValue(), CS, PrintZero);
            }
        }
    }
}

fn printZeroUpperMove(MI: *MachineInstr, OutStreamer: *mut MCStreamer, SclWidth: i32, VecWidth: i32, ShuffleComment: *u8) {
    let mut SrcIdx: u32 = getSrcIdx(MI, 1);
    let mut Comment: str = "";
    let mut CS: raw_string_ostream = Comment;
    printDstRegisterName(CS, MI, SrcIdx);
    CS << " = ";
    if getConstantFromPool(*MI, SrcIdx) {
        C;
    } else {
        CS << "[";
        printConstant(C, SclWidth, CS, false);
        for let mut I: i32 = 1;
let mut E: i32 = VecWidth / SclWidth; I < E; I += 1 {
            CS << ",";
            printConstant(C, SclWidth, CS, true);
        }
        CS << "]";
        OutStreamer.AddComment(CS, true);
        return;
    }
    CS << ShuffleComment;
    OutStreamer.AddComment(CS, true);
}

fn printBroadcast(MI: *MachineInstr, OutStreamer: *mut MCStreamer, Repeats: i32, BitWidth: i32) {
    let mut SrcIdx: u32 = getSrcIdx(MI, 1);
    if getConstantFromPool(*MI, SrcIdx) {
        C;
    } else {
        let mut Comment: str = "";
        let mut CS: raw_string_ostream = Comment;
        printDstRegisterName(CS, MI, SrcIdx);
        CS << " = [";
        for let mut l: i32 = 0; l != Repeats; l += 1 {
            if l != 0 {
                CS << ",";
            }
            printConstant(C, BitWidth, CS, false);
        }
        CS << "]";
        OutStreamer.AddComment(CS, true);
    }
}

fn addConstantComment(MI: *MachineInstr, OutStreamer: *mut MCStreamer, OpNo: u32, BitWidth: i32, Repeats: i32) {
    if getConstantFromPool(*MI, OpNo) {
        C;
    } else {
        let mut Comment: str = "";
        let mut CS: raw_string_ostream = Comment;
        CS << "[";
        for let mut I: i32 = 0; I != Repeats; I += 1 {
            if I != 0 {
                CS << ",";
            }
            printConstant(C, BitWidth, CS, false);
        }
        CS << "]";
        OutStreamer.AddComment(CS, true);
    }
}

fn printExtend(MI: *MachineInstr, OutStreamer: *mut MCStreamer, SrcEltBits: i32, DstEltBits: i32, IsSext: bool) -> bool {
    let mut SrcIdx: u32 = getSrcIdx(MI, 1);
    let mut C: *Constant = getConstantFromPool(*MI, SrcIdx);
    if C && C.getType().getScalarSizeInBits() == SrcEltBits {
        if dyn_cast(C) {
            CDS;
        } else {
            let mut NumElts: i32 = CDS.getNumElements();
            let mut Comment: str = "";
            let mut CS: raw_string_ostream = Comment;
            printDstRegisterName(CS, MI, SrcIdx);
            CS << " = [";
            for let mut i: i32 = 0; i != NumElts; i += 1 {
                if i != 0 {
                    CS << ",";
                }
                if CDS.getElementType().isIntegerTy() {
                    let mut Elt: APInt = CDS.getElementAsAPInt(i);
                    Elt = if IsSext { Elt.sext(DstEltBits) } else { Elt.zext(DstEltBits) };
                    printConstant(Elt, CS, false);
                } else {
                    CS << "?";
                }
            }
            CS << "]";
            OutStreamer.AddComment(CS, true);
            return true;
        }
    }
    return false;
}

fn printSignExtend(MI: *MachineInstr, OutStreamer: *mut MCStreamer, SrcEltBits: i32, DstEltBits: i32) {
    printExtend(MI, OutStreamer, SrcEltBits, DstEltBits, true);
}

fn printZeroExtend(MI: *MachineInstr, OutStreamer: *mut MCStreamer, SrcEltBits: i32, DstEltBits: i32) {
    if printExtend(MI, OutStreamer, SrcEltBits, DstEltBits, false) {
        return;
    }
    let mut Comment: str = "";
    let mut CS: raw_string_ostream = Comment;
    printDstRegisterName(CS, MI, getSrcIdx(MI, 1));
    CS << " = ";
    let mut Mask: SmallVector<int> = SmallVector<int> {};
    let mut Width: u32 = getVectorRegisterWidth(MI.getDesc().operands()[0]);
    assert!((Width % DstEltBits) == 0 && (DstEltBits % SrcEltBits) == 0, "Illegal extension ratio");
    DecodeZeroExtendMask(SrcEltBits, DstEltBits, Width / DstEltBits, false, Mask);
    printShuffleMask(CS, "mem", "", Mask);
    OutStreamer.AddComment(CS, true);
}

fn X86AsmPrinter::EmitSEHInstruction(self, MI: *MachineInstr) {
    assert!(self.MF.hasWinCFI(), "SEH_ instruction in function without WinCFI?");
    assert!(self.getSubtarget().isOSWindowsOrUEFI(), "SEH_ instruction Windows and UEFI only");
    if self.EmitFPOData {
        let mut XTS: *mut X86TargetStreamer = operator(self.OutStreamer).getTargetStreamer() as *mut X86TargetStreamer;
        match MI.getOpcode() {
            SEH_PushReg => {
                XTS.emitFPOPushReg(MI.getOperand(0).getImm(), SMLoc {});
            },
            SEH_StackAlloc => {
                XTS.emitFPOStackAlloc(MI.getOperand(0).getImm(), SMLoc {});
            },
            SEH_StackAlign => {
                XTS.emitFPOStackAlign(MI.getOperand(0).getImm(), SMLoc {});
            },
            SEH_SetFrame => {
                assert!(MI.getOperand(1).getImm() == 0, ".cv_fpo_setframe takes no offset");
            },
            SEH_EndPrologue => {
                XTS.emitFPOEndPrologue(SMLoc {});
            },
            SEH_SaveReg => {
                SEH_SaveXMM;
            },
            _ => {
                llvm_unreachable_internal("expected SEH_ instruction", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86MCInstLower.cpp", 1767);
            },
        }
        return;
    }
    match MI.getOpcode() {
        SEH_PushReg => {
            operator(self.OutStreamer).emitWinCFIPushReg(MI.getOperand(0).getImm(), SMLoc {});
        },
        SEH_Push2Regs => {
            operator(self.OutStreamer).emitWinCFIPush2Regs(MI.getOperand(0).getImm(), MI.getOperand(1).getImm(), SMLoc {});
        },
        SEH_SaveReg => {
            operator(self.OutStreamer).emitWinCFISaveReg(MI.getOperand(0).getImm(), MI.getOperand(1).getImm(), SMLoc {});
        },
        SEH_SaveXMM => {
            operator(self.OutStreamer).emitWinCFISaveXMM(MI.getOperand(0).getImm(), MI.getOperand(1).getImm(), SMLoc {});
        },
        SEH_StackAlloc => {
            operator(self.OutStreamer).emitWinCFIAllocStack(MI.getOperand(0).getImm(), SMLoc {});
        },
        SEH_SetFrame => {
            operator(self.OutStreamer).emitWinCFISetFrame(MI.getOperand(0).getImm(), MI.getOperand(1).getImm(), SMLoc {});
        },
        SEH_PushFrame => {
            operator(self.OutStreamer).emitWinCFIPushFrame(MI.getOperand(0).getImm(), SMLoc {});
        },
        SEH_EndPrologue => {
            operator(self.OutStreamer).emitWinCFIEndProlog(SMLoc {});
        },
        SEH_BeginEpilogue => {
            operator(self.OutStreamer).emitWinCFIBeginEpilogue(SMLoc {});
        },
        SEH_EndEpilogue => {
            operator(self.OutStreamer).emitWinCFIEndEpilogue(SMLoc {});
        },
        SEH_UnwindV2Start => {
            operator(self.OutStreamer).emitWinCFIUnwindV2Start(SMLoc {});
        },
        SEH_UnwindVersion => {
            operator(self.OutStreamer).emitWinCFIUnwindVersion(MI.getOperand(0).getImm(), SMLoc {});
        },
        _ => {
            llvm_unreachable_internal("expected SEH_ instruction", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86MCInstLower.cpp", 1827);
        },
    }
}

fn addConstantComments(MI: *MachineInstr, OutStreamer: *mut MCStreamer) {
    match MI.getOpcode() {
        PSHUFBrm => {
            VPSHUFBrm;
        },
        VPERMILPSrm => {
            VPERMILPSYrm;
        },
        VPERMILPDrm => {
            VPERMILPDYrm;
        },
        VPERMIL2PDrm => {
            VPERMIL2PSrm;
        },
        VPPERMrrm => {
            if getConstantFromPool(*MI, 3) {
                C;
            } else {
                let mut Width: u32 = getVectorRegisterWidth(MI.getDesc().operands()[0]);
                let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
                DecodeVPPERMMask(C, Width, Mask);
                if !Mask.is_empty() {
                    OutStreamer.AddComment(getShuffleComment(MI, 1, 2, Mask), true);
                }
            }
            break;
        },
        MMX_MOVQ64rm => {
            if getConstantFromPool(*MI, 1) {
                C;
            } else {
                let mut Comment: str = "";
                let mut CS: raw_string_ostream = Comment;
                let mut DstOp: *MachineOperand = MI.getOperand(0);
                CS << getRegisterName(DstOp.getReg().operator MCRegister()) << " = ";
                if dyn_cast(C) {
                    CF;
                } else {
                    CS << "0x" << toString(CF.getValueAPF().bitcastToAPInt(), 16, false, false, true, false);
                    OutStreamer.AddComment(CS, true);
                }
            }
            break;
        },
        GF2P8AFFINEQBrmi => {
            VGF2P8AFFINEQBrmi;
        },
        VGF2P8AFFINEQBZ128rmbi => {
            VGF2P8AFFINEQBZ256rmbi;
        },
        PADDBrm => {
            VPADDBrm;
        },
        MOVSDrm => {
            VMOVSDrm;
        },
        VMOVSHZrm => {
            VMOVSHZrmk;
        },
        MOVSSrm => {
            VMOVSSrm;
        },
        MOVAPDrm => {
            MOVAPSrm;
        },
        VMOVAPDYrm => {
            VMOVAPSYrm;
        },
        VMOVDQA64Zrm => {
            VMOVDQA32Zrm;
        },
        VBROADCASTF128rm => {
            VBROADCASTI128rm;
        },
        VBROADCASTF32X4Zrm => {
            VBROADCASTF32X4Zrmk;
        },
        VBROADCASTF32X8Zrm => {
            VBROADCASTF32X8Zrmk;
        },
        MOVDDUPrm => {
            VMOVDDUPrm;
        },
        VBROADCASTSDYrm => {
            VBROADCASTSDZ256rm;
        },
        VBROADCASTSDZrm => {
            VBROADCASTSDZrmk;
        },
        VBROADCASTSSrm => {
            VBROADCASTSSZ128rm;
        },
        VBROADCASTSSYrm => {
            VBROADCASTSSZ256rm;
        },
        VBROADCASTSSZrm => {
            VBROADCASTSSZrmk;
        },
        VPBROADCASTWrm => {
            VPBROADCASTWZ128rm;
        },
        VPBROADCASTWYrm => {
            VPBROADCASTWZ256rm;
        },
        VPBROADCASTWZrm => {
            VPBROADCASTWZrmk;
        },
        VPBROADCASTBrm => {
            VPBROADCASTBZ128rm;
        },
        VPBROADCASTBYrm => {
            VPBROADCASTBZ256rm;
        },
        VPBROADCASTBZrm => {
            VPBROADCASTBZrmk;
        },
        PMOVSXBDrm => {
            VPMOVSXBDrm;
        },
        PMOVSXBQrm => {
            VPMOVSXBQrm;
        },
        PMOVSXBWrm => {
            VPMOVSXBWrm;
        },
        PMOVSXDQrm => {
            VPMOVSXDQrm;
        },
        PMOVSXWDrm => {
            VPMOVSXWDrm;
        },
        PMOVSXWQrm => {
            VPMOVSXWQrm;
        },
        PMOVZXBDrm => {
            VPMOVZXBDrm;
        },
        PMOVZXBQrm => {
            VPMOVZXBQrm;
        },
        PMOVZXBWrm => {
            VPMOVZXBWrm;
        },
        PMOVZXDQrm => {
            VPMOVZXDQrm;
        },
        PMOVZXWDrm => {
            VPMOVZXWDrm;
        },
        PMOVZXWQrm => {
            VPMOVZXWQrm;
        },
    }
}

fn isImportedFunction(MO: *MachineOperand) -> bool {
    return MO.isGlobal() && (MO.getTargetFlags() == MO_DLLIMPORT);
}

fn isCallToCFGuardFunction(MI: *MachineInstr) -> bool {
    assert!(MI.getOpcode() == TAILJMPm64_REX || MI.getOpcode() == CALL64m);
    let mut MO: *MachineOperand = MI.getOperand(3);
    return MO.isGlobal() && (MO.getTargetFlags() == MO_NO_FLAG) && isCFGuardFunction(MO.getGlobal());
}

fn hasJumpTableInfoInBlock(MI: *MachineInstr) -> bool {
    let mut MBB: *MachineBasicBlock = *MI.getParent();
    for let mut I: const_reverse_instr_iterator = MBB.instr_rbegin();
let mut E: const_reverse_instr_iterator = MBB.instr_rend(); I != E; operator(I) {
        if operator(I).isJumpTableDebugInfo() {
            return true;
        }
    }
    return false;
}

fn X86AsmPrinter::emitInstruction(self, MI: *MachineInstr) {
    let mut MCInstLowering: X86MCInstLower = X86MCInstLower { *self.MF, *self };
    let mut RI: *X86RegisterInfo = self.MF.getSubtarget().getRegisterInfo();
    if MI.getOpcode() == OR64rm {
        for Opd in MI.operands() {
            if Opd.isSymbol() && Opd.getSymbolName() == "swift_async_extendedFramePointerFlags" {
                self.ShouldEmitWeakSwiftAsyncExtendedFramePointerFlags = true;
            }
        }
    }
    if operator(self.OutStreamer).isVerboseAsm() {
        addConstantComments(MI, operator(self.OutStreamer));
    }
    if self.TM.Options.MCOptions.ShowMCEncoding {
        if MI.getAsmPrinterFlags() & AC_EVEX_2_LEGACY {
            operator(self.OutStreamer).AddComment("EVEX TO LEGACY Compression ", false);
        } else if MI.getAsmPrinterFlags() & AC_EVEX_2_VEX {
            operator(self.OutStreamer).AddComment("EVEX TO VEX Compression ", false);
        } else if MI.getAsmPrinterFlags() & AC_EVEX_2_EVEX {
            operator(self.OutStreamer).AddComment("EVEX TO EVEX Compression ", false);
        }
    }
    let mut IsTailJump: bool = false;
    match MI.getOpcode() {
        DBG_VALUE => {
            llvm_unreachable_internal("Should be handled target independently", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86MCInstLower.cpp", 2310);
        },
        EH_RETURN => {
            EH_RETURN64;
        },
        CLEANUPRET => {
            operator(self.OutStreamer).AddComment("CLEANUPRET", true);
            break;
        },
        CATCHRET => {
            operator(self.OutStreamer).AddComment("CATCHRET", true);
            break;
        },
        ENDBR32 => {
            ENDBR64;
        },
        TAILJMPd64 => {
            if self.IndCSPrefix && MI.hasRegisterImplicitUseOperand(R11) {
                self.EmitAndCountInstruction(CS_PREFIX.operator llvm::MCInst &());
            }
        },
        TAILJMPr => {
            TAILJMPm;
        },
        TAILJMPm64_REX => {
            if self.EnableImportCallOptimization && isCallToCFGuardFunction(MI) {
                self.emitLabelAndRecordForImportCallOptimization(IMAGE_RETPOLINE_AMD64_CFG_BR_REX);
            }
        },
        TAILJMPr64_REX => {
            if self.EnableImportCallOptimization {
                assert!(MI.getOperand(0).getReg() == RAX, "Indirect tail calls with impcall enabled must go through RAX (as enforced by TCRETURNImpCallri64)");
                self.emitLabelAndRecordForImportCallOptimization(IMAGE_RETPOLINE_AMD64_INDIR_BR);
            }
            operator(self.OutStreamer).AddComment("TAILCALL", true);
            IsTailJump = true;
            break;
        },
        JMP64r => {
            if self.EnableImportCallOptimization && hasJumpTableInfoInBlock(MI) {
                let mut EncodedReg: u16 = self.getSubtarget().getRegisterInfo().getEncodingValue(MI.getOperand(0).getReg().asMCReg());
                self.emitLabelAndRecordForImportCallOptimization((IMAGE_RETPOLINE_AMD64_SWITCHTABLE_FIRST + EncodedReg) as ImportCallKind);
            }
        },
        JMP16r => {
            JMP16m;
        },
        TLS_addr32 => {
            TLS_addr64;
        },
        MOVPC32r => {
            let mut PICBase: *mut MCSymbol = self.MF.getPICBaseSymbol();
            self.EmitAndCountInstruction(CALLpcrel32.addExpr(create(PICBase, self.OutContext, SMLoc {})).operator llvm::MCInst &());
            let mut FrameLowering: *X86FrameLowering = self.MF.getSubtarget().getFrameLowering();
            let mut hasFP: bool = FrameLowering.hasFP(*self.MF);
            let mut HasActiveDwarfFrame: bool = operator(self.OutStreamer).getNumFrameInfos() && !operator(self.OutStreamer).getDwarfFrameInfos().back().End;
            let mut stackGrowth: i32 = -RI.getSlotSize();
            if HasActiveDwarfFrame && !hasFP {
                operator(self.OutStreamer).emitCFIAdjustCfaOffset(-stackGrowth, SMLoc {});
                self.MF.getInfo().setHasCFIAdjustCfa(true);
            }
            operator(self.OutStreamer).emitLabel(PICBase, SMLoc {});
            self.EmitAndCountInstruction(POP32r.addReg(MI.getOperand(0).getReg().operator MCRegister()).operator llvm::MCInst &());
            if HasActiveDwarfFrame && !hasFP {
                operator(self.OutStreamer).emitCFIAdjustCfaOffset(stackGrowth, SMLoc {});
            }
            return;
        },
        ADD32ri => {
            if MI.getOperand(2).getTargetFlags() != MO_GOT_ABSOLUTE_ADDRESS {
                break;
            }
            let mut DotSym: *mut MCSymbol = self.OutContext.createTempSymbol();
            operator(self.OutStreamer).emitLabel(DotSym, SMLoc {});
            let mut OpSym: *mut MCSymbol = MCInstLowering.GetSymbolFromOperand(MI.getOperand(2));
            let mut DotExpr: *MCExpr = create(DotSym, self.OutContext, SMLoc {});
            let mut PICBase: *MCExpr = create(self.MF.getPICBaseSymbol(), self.OutContext, SMLoc {});
            DotExpr = createSub(DotExpr, PICBase, self.OutContext);
            DotExpr = createAdd(create(OpSym, self.OutContext, SMLoc {}), DotExpr, self.OutContext, SMLoc {});
            self.EmitAndCountInstruction(ADD32ri.addReg(MI.getOperand(0).getReg().operator MCRegister()).addReg(MI.getOperand(1).getReg().operator MCRegister()).addExpr(DotExpr).operator llvm::MCInst &());
            return;
        },
        STATEPOINT => {
            return self.LowerSTATEPOINT(*MI, MCInstLowering);
        },
        FAULTING_OP => {
            return self.LowerFAULTING_OP(*MI, MCInstLowering);
        },
        FENTRY_CALL => {
            return self.LowerFENTRY_CALL(*MI, MCInstLowering);
        },
        PATCHABLE_OP => {
            return self.LowerPATCHABLE_OP(*MI, MCInstLowering);
        },
        STACKMAP => {
            return self.LowerSTACKMAP(*MI);
        },
        PATCHPOINT => {
            return self.LowerPATCHPOINT(*MI, MCInstLowering);
        },
        PATCHABLE_FUNCTION_ENTER => {
            return self.LowerPATCHABLE_FUNCTION_ENTER(*MI, MCInstLowering);
        },
        PATCHABLE_RET => {
            return self.LowerPATCHABLE_RET(*MI, MCInstLowering);
        },
        PATCHABLE_TAIL_CALL => {
            return self.LowerPATCHABLE_TAIL_CALL(*MI, MCInstLowering);
        },
        PATCHABLE_EVENT_CALL => {
            return self.LowerPATCHABLE_EVENT_CALL(*MI, MCInstLowering);
        },
        PATCHABLE_TYPED_EVENT_CALL => {
            return self.LowerPATCHABLE_TYPED_EVENT_CALL(*MI, MCInstLowering);
        },
        MORESTACK_RET => {
            self.EmitAndCountInstruction(getRetOpcode(*self.Subtarget).operator llvm::MCInst &());
        },
        KCFI_CHECK => {
            return self.LowerKCFI_CHECK(*MI);
        },
        ASAN_CHECK_MEMACCESS => {
            return self.LowerASAN_CHECK_MEMACCESS(*MI);
        },
        MORESTACK_RET_RESTORE_R10 => {
            self.EmitAndCountInstruction(getRetOpcode(*self.Subtarget).operator llvm::MCInst &());
        },
        SEH_PushReg => {
            SEH_Push2Regs;
        },
        SEH_SplitChainedAtEndOfBlock => {
            assert!(!self.SplitChainedAtEndOfBlock, "Duplicate SEH_SplitChainedAtEndOfBlock in a current block");
        },
        SEH_SplitChained => {
            assert!(self.MF.hasWinCFI(), "SEH_ instruction in function without WinCFI?");
        },
        SEH_BeginEpilogue => {
            assert!(self.MF.hasWinCFI(), "SEH_ instruction in function without WinCFI?");
            self.EmitSEHInstruction(MI);
            return;
        },
        UBSAN_UD1 => {
            self.EmitAndCountInstruction(UD1Lm.addReg(EAX).addReg(EAX).addImm(1).addReg(NoRegister).addImm(MI.getOperand(0).getImm()).addReg(NoRegister).operator llvm::MCInst &());
        },
        CALL64pcrel32 => {
            if self.IndCSPrefix && MI.hasRegisterImplicitUseOperand(R11) {
                self.EmitAndCountInstruction(CS_PREFIX.operator llvm::MCInst &());
            }
        },
        CALL64r => {
            if self.EnableImportCallOptimization {
                assert!(MI.getOperand(0).getReg() == RAX, "Indirect calls with impcall enabled must go through RAX (as enforced by CALL64r_ImpCall)");
                self.emitLabelAndRecordForImportCallOptimization(IMAGE_RETPOLINE_AMD64_INDIR_CALL);
                let mut TmpInst: MCInst = MCInst {};
                MCInstLowering.Lower(MI, TmpInst);
                self.emitCallInstruction(TmpInst);
                emitNop(operator(self.OutStreamer), 3, self.Subtarget);
                self.maybeEmitNopAfterCallForWindowsEH(MI);
                return;
            }
        },
        CALL64m => {
            if self.EnableImportCallOptimization && isCallToCFGuardFunction(MI) {
                self.emitLabelAndRecordForImportCallOptimization(IMAGE_RETPOLINE_AMD64_CFG_CALL);
            }
        },
        JCC_1 => {
            if self.getSubtarget().hasBranchHint() && EnableBranchHint {
                let mut MBPI: *MachineBranchProbabilityInfo = &mut self.getAnalysis().getMBPI();
                let mut DestBB: *mut MachineBasicBlock = MI.getOperand(0).getMBB();
                let mut EdgeProb: BranchProbability = MBPI.getEdgeProbability(MI.getParent(), DestBB);
                let mut Threshold: BranchProbability = BranchProbability { BranchHintProbabilityThreshold.operator unsigned int(), 100 };
                if EdgeProb > Threshold {
                    self.EmitAndCountInstruction(DS_PREFIX.operator llvm::MCInst &());
                }
            }
        },
        JCC_SELF => {
            let mut Sym: *mut MCSymbol = self.OutContext.createTempSymbol();
        },
    }
    let mut TmpInst: MCInst = MCInst {};
    MCInstLowering.Lower(MI, TmpInst);
    if MI.isCall(AnyInBundle) {
        self.emitCallInstruction(TmpInst);
        if !IsTailJump {
            self.maybeEmitNopAfterCallForWindowsEH(MI);
        }
        return;
    }
    self.EmitAndCountInstruction(TmpInst);
}

fn X86AsmPrinter::emitInlineAsmEnd(self, StartInfo: *MCSubtargetInfo, EndInfo: *MCSubtargetInfo, MI: *MachineInstr) {
    if MI {
        let mut ExtraInfo: u32 = MI.getOperand(MIOp_ExtraInfo).getImm();
        if ExtraInfo & Extra_MayUnwind {
            self.maybeEmitNopAfterCallForWindowsEH(MI);
        }
    }
}

fn X86AsmPrinter::emitCallInstruction(self, MCI: *MCInst) {
    self.SMShadowTracker.count(MCI, self.getSubtargetInfo(), self.CodeEmitter.get());
    self.SMShadowTracker.emitShadowPadding(operator(self.OutStreamer), self.getSubtargetInfo());
    operator(self.OutStreamer).emitInstruction(MCI, self.getSubtargetInfo());
}

fn X86AsmPrinter::maybeEmitNopAfterCallForWindowsEH(self, MI: *MachineInstr) {
    if self.MAI.getExceptionHandlingType() != WinEH || self.MAI.getWinEHEncodingType() != Itanium {
        return;
    }
    let mut HasEHPersonality: bool = self.MF.getWinEHFuncInfo() != null;
    let mut MFI: const_iterator = MI.getParent();
    let mut MFE: const_iterator = const_iterator { self.MF.end(), null };
    let mut MBBI: const_iterator = MI;
    let mut MBBE: const_iterator = MI.getParent().end();
    operator(MBBI);
    for {
        for ; MBBI != MBBE; operator(MBBI) {
            let mut NextMI: *MachineInstr = operator(MBBI);
            if NextMI.isEHLabel() {
                if HasEHPersonality {
                    self.EmitAndCountInstruction(NOOP.operator llvm::MCInst &());
                    return;
                }
                continue;
            }
            if NextMI.getOpcode() == SEH_BeginEpilogue {
                self.EmitAndCountInstruction(NOOP.operator llvm::MCInst &());
                return;
            }
            if !NextMI.isPseudo(IgnoreBundle) && !NextMI.isMetaInstruction(IgnoreBundle) {
                return;
            }
        }
        operator(MFI);
        if MFI == MFE {
            if HasEHPersonality {
                if MI.getParent().succ_empty() {
                    self.EmitAndCountInstruction(INT3.operator llvm::MCInst &());
                } else {
                    self.EmitAndCountInstruction(NOOP.operator llvm::MCInst &());
                }
            }
            return;
        }
        let mut NextMBB: *MachineBasicBlock = &mut operator(MFI);
        MBBI = NextMBB.instr_begin();
        MBBE = NextMBB.instr_end();
    }
}

fn X86AsmPrinter::emitLabelAndRecordForImportCallOptimization(self, Kind: ImportCallKind) {
    assert!(self.EnableImportCallOptimization);
    let mut CallSiteSymbol: *mut MCSymbol = self.MMI.getContext().createNamedTempSymbol("impcall");
    operator(self.OutStreamer).emitLabel(CallSiteSymbol, SMLoc {});
    self.SectionToImportedFunctionCalls[operator(self.OutStreamer).getCurrentSectionOnly()].push(ImportCallInfo { CallSiteSymbol, Kind });
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1) {
        return operator!(II.isMetaInstruction());
    }
