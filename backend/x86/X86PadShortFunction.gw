static mut NumBBsPadded: Statistic = Statistic { "x86-pad-short-functions", "NumBBsPadded", "Number of basic blocks padded" };

struct VisitedBBInfo {
    HasReturn: bool,
    Cycles: u32,
}

fn VisitedBBInfo::operator=(self, arg: *mut *mut VisitedBBInfo) -> *mut VisitedBBInfo {
    self.HasReturn =  as VisitedBBInfo.HasReturn;
    self.Cycles =  as VisitedBBInfo.Cycles;
    return *self;
}

struct PadShortFunc {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
    Threshold: u32,
    ReturnBBs: DenseMap<MachineBasicBlock *, unsigned int>,
    VisitedBBs: DenseMap<MachineBasicBlock *, VisitedBBInfo>,
    TSM: TargetSchedModel,
}

fn PadShortFunc::getAnalysisUsage(self: *PadShortFunc, AU: *mut AnalysisUsage) {
    AU.addRequired();
    AU.addRequired();
    AU.addPreserved();
    self.getAnalysisUsage(AU);
}

fn PadShortFunc::getRequiredProperties(self: *PadShortFunc) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn PadShortFunc::getPassName(self: *PadShortFunc) -> str {
    return "X86 Atom pad short functions";
}

fn PadShortFunc::getPassKind(self: *PadShortFunc) -> PassKind {
    return self.Kind;
}

fn PadShortFunc::getPassID(self: *PadShortFunc) -> AnalysisID {
    return self.PassID;
}

fn PadShortFunc::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn PadShortFunc::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn PadShortFunc::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn PadShortFunc::getResolver(self: *PadShortFunc) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn PadShortFunc::getSetProperties(self: *PadShortFunc) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn PadShortFunc::getClearedProperties(self: *PadShortFunc) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86PadShortFunctions() -> *mut FunctionPass {
    return PadShortFunc {};
}

fn PadShortFunc::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-pad-short-functions", 1) {
            dbgs() << "Start X86PadShortFunctionPass\n";
        }
    }
        if !(false) { break; }
    }
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    if MF.getFunction().hasOptSize() {
        return false;
    }
    if !MF.getSubtarget().padShortFunctions() {
        return false;
    }
    self.TSM.init(&mut MF.getSubtarget(), true, true);
    let mut PSI: *mut ProfileSummaryInfo = &mut self.getAnalysis().getPSI();
    let mut MBFI: *mut MachineBlockFrequencyInfo = if (PSI && PSI.hasProfileSummary()) { &mut self.getAnalysis().getBFI() } else { null };
    self.ReturnBBs.clear();
    self.VisitedBBs.clear();
    self.findReturns(&mut MF.front(), 0);
    let mut MadeChange: bool = false;
    for ReturnBB in self.ReturnBBs {
        let mut MBB: *mut MachineBasicBlock = ReturnBB.first;
        let mut Cycles: u32 = ReturnBB.second;
        if shouldOptimizeForSize(MBB, PSI, MBFI, Other) {
            continue;
        }
        if Cycles < self.Threshold {
            assert!(MBB.len > 0, "Basic block should contain at least a RET but is empty");
            let mut ReturnLoc: iterator = operator(MBB.end());
            while operator(ReturnLoc).isDebugInstr() {
                operator(ReturnLoc);
            }
            assert!(operator(ReturnLoc).isReturn(AnyInBundle) && !operator(ReturnLoc).isCall(AnyInBundle), "Basic block does not end with RET");
            self.addPadding(MBB, ReturnLoc, self.Threshold - Cycles);
            operator(NumBBsPadded, 0);
            MadeChange = true;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-pad-short-functions", 1) {
            dbgs() << "End X86PadShortFunctionPass\n";
        }
    }
        if !(false) { break; }
    }
    return MadeChange;
}

fn PadShortFunc::findReturns(self, MBB: *mut MachineBasicBlock, Cycles: u32) {
    let mut hasReturn: bool = self.cyclesUntilReturn(MBB, Cycles);
    if Cycles >= self.Threshold {
        return;
    }
    if hasReturn {
        let mut NumCycles: *mut u32 = self.ReturnBBs[MBB];
        NumCycles = if NumCycles > Cycles { NumCycles } else { Cycles };
        return;
    }
    for Succ in MBB.successors() {
        if Succ != MBB {
            self.findReturns(Succ, Cycles);
        }
    }
}

fn PadShortFunc::cyclesUntilReturn(self, MBB: *mut MachineBasicBlock, Cycles: *mut u32) -> bool {
    if !Inserted {
        let mut BBInfo: VisitedBBInfo = operator(It).second;
        Cycles += BBInfo.Cycles;
        return BBInfo.HasReturn;
    }
    let mut CyclesToEnd: u32 = 0;
    for MI in *MBB {
        if MI.isReturn(AnyInBundle) && !MI.isCall(AnyInBundle) {
            operator(It).second = VisitedBBInfo { HasReturn: true, Cycles: CyclesToEnd };
            Cycles += CyclesToEnd;
            return true;
        }
        CyclesToEnd += self.TSM.computeInstrLatency(&mut MI, true);
    }
    operator(It).second = VisitedBBInfo { HasReturn: false, Cycles: CyclesToEnd };
    Cycles += CyclesToEnd;
    return false;
}

fn PadShortFunc::addPadding(self, MBB: *mut MachineBasicBlock, MBBI: *mut iterator, NOOPsToAdd: u32) {
    let mut DL: *DebugLoc = operator(MBBI).getDebugLoc();
    let mut IssueWidth: u32 = self.TSM.getIssueWidth();
    for let mut i: u32 = 0;
let mut e: u32 = IssueWidth * NOOPsToAdd; i != e; i += 1 {
        BuildMI(*MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TSM.getInstrInfo().get(NOOP));
    }
}
