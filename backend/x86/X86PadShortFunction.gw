static mut ID: i8 = 0;

fn createX86PadShortFunctions() -> *mut FunctionPass {
    return PadShortFunc {};
}

fn PadShortFunc::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-pad-short-functions", 1) {
            dbgs() << "Start X86PadShortFunctionPass\n";
        }
    }
        if !(false) { break; }
    }
    if self.skipFunction {
        return false;
    }
    if MF.getFunction().hasOptSize() {
        return false;
    }
    if operator!(MF()) {
        return false;
    }
    let mut PSI: *mut auto = operator&();
    let mut MBFI: *mut auto = if (PSI() && ()) { operator&() } else { null };
    self.findReturns(&mut MF.front(), 0);
    let mut MadeChange: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-pad-short-functions", 1) {
            dbgs() << "End X86PadShortFunctionPass\n";
        }
    }
        if !(false) { break; }
    }
    return MadeChange;
}

fn PadShortFunc::findReturns(self, MBB: *mut MachineBasicBlock, Cycles: u32) {
    let mut hasReturn: bool = self.cyclesUntilReturn(MBB, Cycles);
    if Cycles >= self.Threshold {
        return;
    }
    if hasReturn {
        let mut NumCycles: *mut u32 = null;
        NumCycles = max(NumCycles, Cycles);
        return;
    }
    for Succ in MBB.successors() {
        if Succ != MBB {
            self.findReturns(Succ, Cycles);
        }
    }
}

fn PadShortFunc::cyclesUntilReturn(self, MBB: *mut MachineBasicBlock, Cycles: *mut u32) -> bool {
    if operator!() {
        let mut BBInfo: VisitedBBInfo = ;
        Cycles += BBInfo.Cycles;
        return BBInfo.HasReturn;
    }
    let mut CyclesToEnd: u32 = 0;
    for MI in *MBB {
        if MI.isReturn(AnyInBundle) && !MI.isCall(AnyInBundle) {
            Cycles += CyclesToEnd;
            return true;
        }
    }
    Cycles += CyclesToEnd;
    return false;
}

fn PadShortFunc::addPadding(self, MBB: *mut MachineBasicBlock, MBBI: *mut iterator, NOOPsToAdd: u32) {
    let mut DL: *DebugLoc = operator(MBBI).getDebugLoc();
    let mut IssueWidth: u32 = 0;
    for let mut i: u32 = 0;
let mut e: u32 = IssueWidth * NOOPsToAdd; i != e; i += 1 {
        BuildMI(*MBB, MBBI, DL);
    }
}
