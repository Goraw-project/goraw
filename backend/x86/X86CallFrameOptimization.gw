    for let mut I: i32 = *DefMI; I() != ;  += 1 {
        if I()() {
            return null;
        }
    }
    return DefMI;
}

fn createX86CallFrameOptimizationLegacyPass() -> *mut FunctionPass {
    return X86CallFrameOptimizationLegacy {};
}

fn X86CallFrameOptimizationLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction {
        return false;
    }
    let mut Impl: X86CallFrameOptimizationImpl = X86CallFrameOptimizationImpl {};
    return Impl.runOnMachineFunction(MF);
}

fn X86CallFrameOptimizationPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86CallFrameOptimizationImpl = X86CallFrameOptimizationImpl {};
    let mut Changed: bool = Impl.runOnMachineFunction(MF);
    return if Changed { getMachineFunctionPassPreservedAnalyses() } else { all() };
}
