fn X86CallFrameOptimizationImpl::canFoldIntoRegPush(self, FrameSetup: i32, Reg: Register) -> *mut MachineInstr {
    if !Reg.isVirtual() {
        return null;
    }
    if !self.MRI.hasOneNonDBGUse(Reg) {
        return null;
    }
    let mut DefMI: *mut MachineInstr = self.MRI.getVRegDef(Reg);
