fn X86CallFrameOptimizationImpl::isLegal(self, MF: *mut MachineFunction) -> bool {
    if NoX86CFOpt()() {
        return false;
    }
    if self.STI.isTargetDarwin() && (operator!(MF()()()) || (MF.getFunction().needsUnwindTableEntry() && !self.TFL.hasFP(MF))) {
        return false;
    }
    if self.STI.isTargetWin64() {
        return false;
    }
    let mut FrameSetupOpcode: u32 = self.TII();
    let mut FrameDestroyOpcode: u32 = self.TII();
    let mut EmitStackProbeCall: bool = self.STI.getTargetLowering().hasStackProbeSymbol(MF);
    let mut StackProbeSize: u32 = self.STI.getTargetLowering().getStackProbeSize(MF);
    return true;
}

fn X86CallFrameOptimizationImpl::isProfitable(self, MF: *mut MachineFunction, CallSeqVector: *mut ContextVector) -> bool {
    let mut CannotReserveFrame: bool = MF.getFrameInfo().hasVarSizedObjects();
    if CannotReserveFrame {
        return true;
    }
    let mut StackAlign: Align = self.TFL.getStackAlign();
    let mut Advantage: i64 = 0;
    return Advantage >= 0;
}

fn X86CallFrameOptimizationImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    self.STI = operator&(MF);
    self.TII = self.STI.getInstrInfo();
    self.TFL = self.STI.getFrameLowering();
    self.MRI = &mut MF.getRegInfo();
    let mut RegInfo: *X86RegisterInfo = *self.STI.getRegisterInfo();
    self.SlotSize = RegInfo.getSlotSize();
    assert!(isPowerOf2_32(self.SlotSize), "Expect power of 2 stack slot size");
    self.Log2SlotSize = Log2_32(self.SlotSize);
    if !self.isLegal(MF) {
        return false;
    }
    let mut FrameSetupOpcode: u32 = self.TII();
    let mut Changed: bool = false;
    let mut CallSeqVector: ContextVector = zeroed();
    if operator!(self.isProfitable(MF)) {
        return false;
    }
    return Changed;
}

