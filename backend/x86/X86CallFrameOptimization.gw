    return MachineFunctionProperties {};
}

fn X86CallFrameOptimizationLegacy::getClearedProperties(self: *X86CallFrameOptimizationLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn X86CallFrameOptimizationImpl::isLegal(self, MF: *mut MachineFunction) -> bool {
    if NoX86CFOpt.getValue() {
        return false;
    }
    if self.STI.isTargetDarwin() && (!MF.getLandingPads().is_empty() || (MF.getFunction().needsUnwindTableEntry() && !self.TFL.hasFP(MF))) {
        return false;
    }
    if self.STI.isTargetWin64() {
        return false;
    }
    let mut FrameSetupOpcode: u32 = self.TII.getCallFrameSetupOpcode();
    let mut FrameDestroyOpcode: u32 = self.TII.getCallFrameDestroyOpcode();
    let mut EmitStackProbeCall: bool = self.STI.getTargetLowering().hasStackProbeSymbol(MF);
    let mut StackProbeSize: u32 = self.STI.getTargetLowering().getStackProbeSize(MF);
    for BB in MF {
        let mut InsideFrameSequence: bool = false;
        for MI in BB {
            if MI.getOpcode() == FrameSetupOpcode {
                if self.TII.getFrameSize(MI) >= StackProbeSize && EmitStackProbeCall {
                    return false;
                }
                if InsideFrameSequence {
                    return false;
                }
                InsideFrameSequence = true;
            } else if MI.getOpcode() == FrameDestroyOpcode {
                if !InsideFrameSequence {
                    return false;
                }
                InsideFrameSequence = false;
            }
        }
        if InsideFrameSequence {
            return false;
        }
    }
    return true;
}

fn X86CallFrameOptimizationImpl::isProfitable(self, MF: *mut MachineFunction, CallSeqVector: *mut ContextVector) -> bool {
    let mut CannotReserveFrame: bool = MF.getFrameInfo().hasVarSizedObjects();
    if CannotReserveFrame {
        return true;
    }
    let mut StackAlign: Align = self.TFL.getStackAlign();
    let mut Advantage: i64 = 0;
    for CC in CallSeqVector {
        if CC.NoStackParams {
            continue;
        }
        if !CC.UsePush {
            Advantage -= 6;
        } else {
            Advantage -= 3;
            if !isAligned(StackAlign, CC.ExpectedDist) {
                Advantage -= 3;
            }
            Advantage += (CC.ExpectedDist >> self.Log2SlotSize) * 3;
        }
    }
    return Advantage >= 0;
}

fn X86CallFrameOptimizationImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    self.STI = &mut MF.getSubtarget();
    self.TII = self.STI.getInstrInfo();
    self.TFL = self.STI.getFrameLowering();
    self.MRI = &mut MF.getRegInfo();
    let mut RegInfo: *X86RegisterInfo = *self.STI.getRegisterInfo();
    self.SlotSize = RegInfo.getSlotSize();
    assert!(isPowerOf2_32(self.SlotSize), "Expect power of 2 stack slot size");
    self.Log2SlotSize = Log2_32(self.SlotSize);
    if !self.isLegal(MF) {
        return false;
    }
    let mut FrameSetupOpcode: u32 = self.TII.getCallFrameSetupOpcode();
    let mut Changed: bool = false;
    let mut CallSeqVector: ContextVector = ContextVector {};
    for MBB in MF {
        for MI in MBB {
            if MI.getOpcode() == FrameSetupOpcode {
                let mut Context: CallContext = CallContext {};
                self.collectCallInfo(MF, MBB, MI, Context);
                CallSeqVector.push(Context);
            }
        }
    }
    if !self.isProfitable(MF, CallSeqVector) {
        return false;
    }
    for CC in CallSeqVector {
        if CC.UsePush {
            self.adjustCallSequence(MF, CC);
            Changed = true;
        }
    }
    return Changed;
}

fn X86CallFrameOptimizationImpl::classifyInstruction(self, MBB: *mut MachineBasicBlock, MI: iterator, RegInfo: *X86RegisterInfo, UsedRegs: *DenseSet<MCRegister>) -> InstClassification {
    if MI == MBB.end() {
        return Exit;
    }
    match operator(MI).getOpcode() {
        AND16mi => {
            AND32mi;
        },
        OR16mi => {
            OR32mi;
        },
        MOV32mi => {
            MOV32mr;
        },
    }
    if operator(MI).isCall(AnyInBundle) || operator(MI).mayStore(AnyInBundle) {
        return Exit;
    }
    for MO in operator(MI).operands() {
        if !MO.isReg() {
            continue;
        }
        let mut Reg: Register = MO.getReg();
        if !Reg.isPhysical() {
            continue;
        }
        if RegInfo.regsOverlap(Reg, RegInfo.getStackRegister()) {
            return Exit;
        }
        if MO.isDef() {
            for U in UsedRegs {
                if RegInfo.regsOverlap(Reg, U) {
                    return Exit;
                }
            }
        }
    }
    return Skip;
}

fn X86CallFrameOptimizationImpl::collectCallInfo(self, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, I: iterator, Context: *mut CallContext) {
    let mut RegInfo: *X86RegisterInfo = *self.STI.getRegisterInfo();
    assert!(operator(I).getOpcode() == self.TII.getCallFrameSetupOpcode();
    let mut FrameSetup: iterator = operator(I, 0);
    Context.FrameSetup = FrameSetup;
    let mut MaxAdjust: u32 = self.TII.getFrameSize(operator(FrameSetup)) >> self.Log2SlotSize;
    if !MaxAdjust {
        Context.NoStackParams = true;
        return;
    }
    while operator(I).getOpcode() == LEA32r || operator(I).isDebugInstr() {
        operator(I);
    }
    let mut StackPtr: Register = RegInfo.getStackRegister();
    let mut StackPtrCopyInst: iterator = MBB.end();
    for let mut J: iterator = I; !operator(J).isCall(AnyInBundle); operator(J) {
        if operator(J).isCopy() && operator(J).getOperand(0).isReg() && operator(J).getOperand(1).isReg() && operator(J).getOperand(1).getReg() == StackPtr {
            StackPtrCopyInst = J;
            Context.SPCopy = &mut operator(operator(J, 0));
            StackPtr = Context.SPCopy.getOperand(0).getReg();
            break;
        }
    }
    if MaxAdjust > 4 {
        Context.ArgStoreVector.resize(MaxAdjust, null);
    }
    let mut UsedRegs: DenseSet<MCRegister> = DenseSet<MCRegister> {};
    for let mut Classification: InstClassification = Skip; Classification != Exit; operator(I) {
        if I == StackPtrCopyInst {
            continue;
        }
        Classification = self.classifyInstruction(MBB, I, RegInfo, UsedRegs);
        if Classification != Convert {
            continue;
        }
        if !operator(I).getOperand(AddrBaseReg).isReg() || (operator(I).getOperand(AddrBaseReg).getReg() != StackPtr) || !operator(I).getOperand(AddrScaleAmt).isImm() || (operator(I).getOperand(AddrScaleAmt).getImm() != 1) || (operator(I).getOperand(AddrIndexReg).getReg() != NoRegister) || (operator(I).getOperand(AddrSegmentReg).getReg() != NoRegister) || !operator(I).getOperand(AddrDisp).isImm() {
            return;
        }
        let mut StackDisp: i64 = operator(I).getOperand(AddrDisp).getImm();
        assert!(StackDisp >= 0, "Negative stack displacement when passing parameters");
        if StackDisp & (self.SlotSize - 1) {
            return;
        }
        StackDisp >>= self.Log2SlotSize;
        assert!(StackDisp as u64 < Context.ArgStoreVector.len, "Function call has more parameters than the stack is adjusted for.");
        if Context.ArgStoreVector[StackDisp] != null {
            return;
        }
        Context.ArgStoreVector[StackDisp] = &mut operator(I);
        for MO in operator(I).uses() {
            if !MO.isReg() {
                continue;
            }
            let mut Reg: Register = MO.getReg();
            if Reg.isPhysical() {
                UsedRegs.insert(Reg.asMCReg());
            }
        }
    }
    operator(I);
    if I == MBB.end() || !operator(I).isCall(AnyInBundle) {
        return;
    }
    Context.Call = &mut operator(I);
    if operator((operator(I))).getOpcode() != self.TII.getCallFrameDestroyOpcode() {
        return;
    }
    let mut MMI: iterator = Context.ArgStoreVector.begin();
    let mut MME: iterator = Context.ArgStoreVector.end();
    for ; MMI != MME; MMI += 1 , Context.ExpectedDist += self.SlotSize {
        if *MMI == null {
            break;
        }
    }
    if MMI == Context.ArgStoreVector.begin() {
        return;
    }
    for ; MMI != MME; MMI += 1 {
        if *MMI != null {
            return;
        }
    }
    Context.UsePush = true;
}

fn X86CallFrameOptimizationImpl::adjustCallSequence(self, MF: *mut MachineFunction, Context: *CallContext) {
    let mut FrameSetup: iterator = Context.FrameSetup;
    let mut MBB: *mut MachineBasicBlock = *(operator(FrameSetup).getParent());
    self.TII.setFrameAdjustment(operator(FrameSetup), Context.ExpectedDist);
    let mut DL: *DebugLoc = operator(FrameSetup).getDebugLoc();
    let mut Is64Bit: bool = self.STI.is64Bit();
    for let mut Idx: i32 = (Context.ExpectedDist >> self.Log2SlotSize) - 1; Idx >= 0; Idx -= 1 {
        let mut Store: iterator = *Context.ArgStoreVector[Idx];
        let mut PushOp: *MachineOperand = operator(Store).getOperand(AddrNumOperands);
        let mut Push: iterator = null;
        let mut PushOpcode: u32 = 0;
        match operator(Store).getOpcode() {
            _ => {
                llvm_unreachable_internal("Unexpected Opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86CallFrameOptimization.cpp", 523);
            },
            AND16mi => {
                AND32mi;
            },
            MOV32mr => {
                MOV64mr;
            },
        }
        if !self.TFL.hasFP(MF) {
            self.TFL.BuildCFI(MBB, next(Push, 1), DL, createAdjustCfaOffset(null, self.SlotSize, SMLoc {}), NoFlags);
        }
        MBB.erase(Store);
    }
    if Context.SPCopy && self.MRI.use_empty(Context.SPCopy.getOperand(0).getReg()) {
        Context.SPCopy.eraseFromParent();
    }
    let mut FuncInfo: *mut X86MachineFunctionInfo = MF.getInfo();
    FuncInfo.setHasPushSequences(true);
}

fn X86CallFrameOptimizationImpl::canFoldIntoRegPush(self, FrameSetup: iterator, Reg: Register) -> *mut MachineInstr {
    if !Reg.isVirtual() {
        return null;
    }
    if !self.MRI.hasOneNonDBGUse(Reg) {
        return null;
    }
    let mut DefMI: *mut MachineInstr = self.MRI.getVRegDef(Reg);
    if !DefMI {
        return null;
    }
    if (DefMI.getOpcode() != MOV32rm && DefMI.getOpcode() != MOV64rm) || DefMI.getParent() != operator(FrameSetup).getParent() {
        return null;
    }
    for let mut I: iterator = *DefMI; I != FrameSetup; operator(I) {
        if operator(I).isLoadFoldBarrier() {
            return null;
        }
    }
    return DefMI;
}

fn createX86CallFrameOptimizationLegacyPass() -> *mut FunctionPass {
    return X86CallFrameOptimizationLegacy {};
}

fn X86CallFrameOptimizationLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut Impl: X86CallFrameOptimizationImpl = X86CallFrameOptimizationImpl {};
    return Impl.runOnMachineFunction(MF);
}

fn X86CallFrameOptimizationPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86CallFrameOptimizationImpl = X86CallFrameOptimizationImpl {};
    let mut Changed: bool = Impl.runOnMachineFunction(MF);
    return if Changed { getMachineFunctionPassPreservedAnalyses() } else { all() };
}
