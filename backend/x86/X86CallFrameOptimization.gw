static mut NoX86CFOpt: i32 = "no-x86-call-frame-opt";

struct X86CallFrameOptimizationImpl {
    TII: *X86InstrInfo,
    TFL: *X86FrameLowering,
    STI: *X86Subtarget,
    MRI: *mut MachineRegisterInfo,
    SlotSize: u32,
    Log2SlotSize: u32,
}

