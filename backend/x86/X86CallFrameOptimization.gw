static mut NoX86CFOpt: opt<bool> = opt<bool> { "no-x86-call-frame-opt", "Avoid optimizing x86 call frames for size", init(false), Hidden };

struct X86CallFrameOptimizationImpl {
    TII: *X86InstrInfo,
    TFL: *X86FrameLowering,
    STI: *X86Subtarget,
    MRI: *mut MachineRegisterInfo,
    SlotSize: u32,
    Log2SlotSize: u32,
}

struct X86CallFrameOptimizationLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86CallFrameOptimizationLegacy::getAnalysisUsage(self: *X86CallFrameOptimizationLegacy, AU: *mut AnalysisUsage) {
    AU.addPreserved();
    self.getAnalysisUsage(AU);
}

fn X86CallFrameOptimizationLegacy::getPassName(self: *X86CallFrameOptimizationLegacy) -> str {
    return "X86 Optimize Call Frame";
}

fn X86CallFrameOptimizationLegacy::getPassKind(self: *X86CallFrameOptimizationLegacy) -> PassKind {
    return self.Kind;
}

fn X86CallFrameOptimizationLegacy::getPassID(self: *X86CallFrameOptimizationLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86CallFrameOptimizationLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86CallFrameOptimizationLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86CallFrameOptimizationLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86CallFrameOptimizationLegacy::getResolver(self: *X86CallFrameOptimizationLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86CallFrameOptimizationLegacy::getRequiredProperties(self: *X86CallFrameOptimizationLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

