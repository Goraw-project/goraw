static mut UseFSRMForMemcpy: i32 = "x86-use-fsrm-for-memcpy";

fn X86SelectionDAGInfo::getTargetNodeName(self: *X86SelectionDAGInfo, Opcode: u32) -> *u8 {
    match Opcode as NodeType {
        POP_FROM_X87_REG => {
            return "X86ISD::POP_FROM_X87_REG";
        },
        GlobalBaseReg => {
            return "X86ISD::GlobalBaseReg";
        },
        LCMPXCHG16_SAVE_RBX_DAG => {
            return "X86ISD::LCMPXCHG16_SAVE_RBX_DAG";
        },
        PCMPESTR => {
            return "X86ISD::PCMPESTR";
        },
        PCMPISTR => {
            return "X86ISD::PCMPISTR";
        },
        MGATHER => {
            return "X86ISD::MGATHER";
        },
        MSCATTER => {
            return "X86ISD::MSCATTER";
        },
        AESENCWIDE128KL => {
            return "X86ISD::AESENCWIDE128KL";
        },
        AESDECWIDE128KL => {
            return "X86ISD::AESDECWIDE128KL";
        },
        AESENCWIDE256KL => {
            return "X86ISD::AESENCWIDE256KL";
        },
        AESDECWIDE256KL => {
            return "X86ISD::AESDECWIDE256KL";
        },
    }
    return self.getTargetNodeName(Opcode);
}

fn X86SelectionDAGInfo::isTargetMemoryOpcode(self: *X86SelectionDAGInfo, Opcode: u32) -> bool {
    if Opcode >= FIRST_MEMORY_OPCODE && Opcode <= LAST_MEMORY_OPCODE {
        return true;
    }
    return self.isTargetMemoryOpcode(Opcode);
}

fn X86SelectionDAGInfo::verifyTargetNode(self: *X86SelectionDAGInfo, DAG: *SelectionDAG, N: *SDNode) {
    match N.getOpcode() {
        _ => {
            break;
        },
    }
    self.verifyTargetNode(DAG, N);
}

fn getOptimalRepType(Subtarget: *X86Subtarget, Alignment: Align) -> MVT {
    let mut Align: u64 = Alignment.value();
    assert!((Align != 0), "Align is normalized");
    assert!(isPowerOf2_64(Align), "Align is a power of 2");
    match Align {
        1 => {
            return MVT { SimpleTy: i8 };
        },
        2 => {
            return MVT { SimpleTy: i16 };
        },
        4 => {
            return MVT { SimpleTy: i32 };
        },
        _ => {
            return if Subtarget()() { i64 } else { i32 };
        },
    }
}

fn X86SelectionDAGInfo::isBaseRegConflictPossible(self: *X86SelectionDAGInfo, DAG: *mut SelectionDAG, ClobberSet: ArrayRef<MCPhysReg>) -> bool {
    let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
    if !MFI.hasVarSizedObjects() && !MFI.hasOpaqueSPAdjustment() {
        return false;
    }
    let mut TRI: *X86RegisterInfo = null;
    return is_contained(TRI.getBaseRegister());
}

fn emitRepstos(Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Val: SDValue, Size: SDValue, AVT: MVT) -> SDValue {
    let mut Use64BitRegs: bool = Subtarget.isTarget64BitLP64();
    let mut AX: u32 = 0;
    match AVT.getSizeInBits().operator unsigned long long() {
        8 => {
            
        },
        16 => {
            
        },
        32 => {
            
        },
        _ => {
            
        },
    }
    let mut CX: u32 = 0;
    let mut DI: u32 = 0;
    let mut InGlue: SDValue = SDValue {};
    Chain = DAG.getCopyToReg(Chain, dl, Register { Reg: AX }, Val, InGlue);
    InGlue = Chain.getValue(1);
    Chain = DAG.getCopyToReg(Chain, dl, Register { Reg: CX }, Size, InGlue);
    InGlue = Chain.getValue(1);
    Chain = DAG.getCopyToReg(Chain, dl, Register { Reg: DI }, Dst, InGlue);
    InGlue = Chain.getValue(1);
    let mut Tys: SDVTList = DAG.getVTList(EVT { Other }, EVT { Glue });
    let mut Ops: [3]SDValue = [Chain, DAG.getValueType(EVT { AVT }), InGlue];
    return DAG;
}

fn emitRepstosB(Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Val: SDValue, Size: u64) -> SDValue {
    return emitRepstos(Subtarget, DAG, dl, Chain, Dst, Val, DAG.getIntPtrConstant(Size, dl, false), MVT { SimpleTy: i8 });
}

fn emitConstantSizeRepstos(DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Val: SDValue, Size: u64, SizeVT: EVT, Alignment: Align, isVolatile: bool, AlwaysInline: bool, DstPtrInfo: MachinePointerInfo) -> SDValue {
    if DAG.getMachineFunction().getFunction().hasMinSize() {
        if  {
            if (Size & 31) == 0 && (ValC()() & 255) == 0 {
                let mut BlockType: MVT = MVT { SimpleTy: i32 };
                let mut BlockBits: u64 = BlockType.getSizeInBits().operator unsigned long long();
                let mut BlockBytes: u64 = BlockBits / 8;
                let mut BlockCount: u64 = Size / BlockBytes;
                Val = DAG.getConstant(0, dl, EVT { BlockType }, false, false);
                return emitRepstos(Subtarget, DAG, dl, Chain, Dst, Val, DAG.getIntPtrConstant(BlockCount, dl, false), BlockType);
            }
        }
        return emitRepstosB(Subtarget, DAG, dl, Chain, Dst, Val, Size);
    }
    if Size > Subtarget.getMaxInlineSizeThreshold() {
        return SDValue {};
    }
    if Alignment < Align { ShiftValue: 4 } {
        return SDValue {};
    }
    let mut BlockType: MVT = MVT { SimpleTy: i8 };
    let mut BlockCount: u64 = Size;
    let mut BytesLeft: u64 = 0;
    let mut OriginalVal: SDValue = Val;
    if  {
        BlockType = getOptimalRepType(Subtarget, Alignment);
        let mut Value: u64 = () & 255;
        let mut BlockBits: u64 = BlockType.getSizeInBits().operator unsigned long long();
        if BlockBits >= 16 {
            Value = (Value << 8) | Value;
        }
        if BlockBits >= 32 {
            Value = (Value << 16) | Value;
        }
        if BlockBits >= 64 {
            Value = (Value << 32) | Value;
        }
        let mut BlockBytes: u64 = BlockBits / 8;
        BlockCount = Size / BlockBytes;
        BytesLeft = Size % BlockBytes;
        Val = DAG.getConstant(Value, dl, EVT { BlockType }, false, false);
    }
    let mut RepStos: SDValue = emitRepstos(Subtarget, DAG, dl, Chain, Dst, Val, DAG.getIntPtrConstant(BlockCount, dl, false), BlockType);
    if BytesLeft == 0 {
        return RepStos;
    }
    let mut Results: SmallVector<SDValue, 4> = zeroed();
    Results()(RepStos);
    let mut Offset: u32 = Size - BytesLeft;
    let mut AddrVT: EVT = Dst.getValueType();
    Results()(DAG.getMemset(Chain, dl, DAG.getNode(ADD, dl, AddrVT, Dst, DAG.getConstant(Offset, dl, AddrVT, false, false)), OriginalVal, DAG.getConstant(BytesLeft, dl, SizeVT, false, false), Alignment, isVolatile, AlwaysInline, null, DstPtrInfo.getWithOffset(Offset), AAMDNodes {}));
    return DAG(TokenFactor, dl, Other);
}

fn X86SelectionDAGInfo::EmitTargetCodeForMemset(self: *X86SelectionDAGInfo, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Val: SDValue, Size: SDValue, Alignment: Align, isVolatile: bool, AlwaysInline: bool, DstPtrInfo: MachinePointerInfo) -> SDValue {
    let mut Subtarget: *X86Subtarget = DAG.getMachineFunction();
    if DstPtrInfo.getAddrSpace() >= 256 {
        return SDValue {};
    }
    if operator!(Subtarget()()) && Subtarget.isRegisterReservedByUser {
        return SDValue {};
    }
    let mut ClobberSet: []MCPhysReg = zeroed();
    if self.isBaseRegConflictPossible {
        return SDValue {};
    }
    let mut ConstantSize: *mut ConstantSDNode = dyn_cast(Size);
    if !ConstantSize {
        return SDValue {};
    }
    return emitConstantSizeRepstos(DAG, Subtarget, dl, Chain, Dst, Val, ConstantSize.getZExtValue(), Size.getValueType(), Alignment, isVolatile, AlwaysInline, DstPtrInfo);
}

fn emitRepmovs(Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: SDValue, AVT: MVT) -> SDValue {
    let mut Use64BitRegs: bool = Subtarget.isTarget64BitLP64();
    let mut CX: u32 = 0;
    let mut DI: u32 = 0;
    let mut SI: u32 = 0;
    let mut InGlue: SDValue = SDValue {};
    Chain = DAG.getCopyToReg(Chain, dl, Register { Reg: CX }, Size, InGlue);
    InGlue = Chain.getValue(1);
    Chain = DAG.getCopyToReg(Chain, dl, Register { Reg: DI }, Dst, InGlue);
    InGlue = Chain.getValue(1);
    Chain = DAG.getCopyToReg(Chain, dl, Register { Reg: SI }, Src, InGlue);
    InGlue = Chain.getValue(1);
    let mut Tys: SDVTList = DAG.getVTList(EVT { Other }, EVT { Glue });
    let mut Ops: [3]SDValue = [Chain, DAG.getValueType(EVT { AVT }), InGlue];
    return DAG;
}

fn emitRepmovsB(Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: u64) -> SDValue {
    return emitRepmovs(Subtarget, DAG, dl, Chain, Dst, Src, DAG.getIntPtrConstant(Size, dl, false), MVT { SimpleTy: i8 });
}

fn emitConstantSizeRepmov(DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: u64, SizeVT: EVT, Alignment: Align, isVolatile: bool, AlwaysInline: bool, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo) -> SDValue {
    if DAG.getMachineFunction().getFunction().hasMinSize() {
        return emitRepmovsB(Subtarget, DAG, dl, Chain, Dst, Src, Size);
    }
    if !AlwaysInline && Size > Subtarget.getMaxInlineSizeThreshold() {
        return SDValue {};
    }
    if Subtarget()() {
        return emitRepmovsB(Subtarget, DAG, dl, Chain, Dst, Src, Size);
    }
    (((operator!(operator!((operator!(Subtarget()()) && "No efficient RepMovs")))) || (_wassert(L"!Subtarget.hasERMSB() && \"No efficient RepMovs\"", L"llvm\\lib\\Target\\X86\\X86SelectionDAGInfo.cpp", (347) as u32) , 0)) as void);
    if !AlwaysInline && (Alignment < Align { ShiftValue: 4 }) {
        return SDValue {};
    }
    let mut BlockType: MVT = getOptimalRepType(Subtarget, Alignment);
    let mut BlockBytes: u64 = BlockType.getSizeInBits().operator unsigned long long() / 8;
    let mut BlockCount: u64 = Size / BlockBytes;
    let mut BytesLeft: u64 = Size % BlockBytes;
    let mut RepMovs: SDValue = emitRepmovs(Subtarget, DAG, dl, Chain, Dst, Src, DAG.getIntPtrConstant(BlockCount, dl, false), BlockType);
    if BytesLeft == 0 {
        return RepMovs;
    }
    assert!(BytesLeft, "We have leftover at this point");
    let mut Results: SmallVector<SDValue, 4> = zeroed();
    Results()(RepMovs);
    let mut Offset: u32 = Size - BytesLeft;
    let mut DstVT: EVT = Dst.getValueType();
    let mut SrcVT: EVT = Src.getValueType();
    Results()(DAG.getMemcpy(Chain, dl, DAG.getNode(ADD, dl, DstVT, Dst, DAG.getConstant(Offset, dl, DstVT, false, false)), DAG.getNode(ADD, dl, SrcVT, Src, DAG.getConstant(Offset, dl, SrcVT, false, false)), DAG.getConstant(BytesLeft, dl, SizeVT, false, false), Alignment, Alignment, isVolatile, true, null, optional<bool> { nullopt }, DstPtrInfo.getWithOffset(Offset), SrcPtrInfo.getWithOffset(Offset), AAMDNodes {}, null));
    return DAG(TokenFactor, dl, Other);
}

fn X86SelectionDAGInfo::EmitTargetCodeForMemcpy(self: *X86SelectionDAGInfo, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: SDValue, DstAlign: Align, SrcAlign: Align, isVolatile: bool, AlwaysInline: bool, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo) -> SDValue {
    let mut Subtarget: *X86Subtarget = DAG.getMachineFunction();
    if DstPtrInfo.getAddrSpace() >= 256 || SrcPtrInfo.getAddrSpace() >= 256 {
        return SDValue {};
    }
    if operator!(Subtarget()()) && Subtarget.isRegisterReservedByUser {
        return SDValue {};
    }
    let mut ClobberSet: []MCPhysReg = zeroed();
    if self.isBaseRegConflictPossible {
        return SDValue {};
    }
    if UseFSRMForMemcpy() && Subtarget()() {
        return emitRepmovs(Subtarget, DAG, dl, Chain, Dst, Src, Size, MVT { SimpleTy: i8 });
    }
    if dyn_cast(Size) {
        ConstantSize;
    } else {
        let mut Alignment: Align = min(DstAlign, SrcAlign);
        return emitConstantSizeRepmov(DAG, Subtarget, dl, Chain, Dst, Src, ConstantSize.getZExtValue(), Size.getValueType(), Alignment, isVolatile, AlwaysInline, DstPtrInfo, SrcPtrInfo);
    }
    return SDValue {};
}
