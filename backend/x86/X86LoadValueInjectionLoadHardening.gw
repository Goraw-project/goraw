static mut NumFences: Statistic = Statistic { "x86-lvi-load", "NumFences", "Number of LFENCEs inserted for LVI mitigation" };

static mut NumFunctionsConsidered: Statistic = Statistic { "x86-lvi-load", "NumFunctionsConsidered", "Number of functions analyzed" };

static mut NumFunctionsMitigated: Statistic = Statistic { "x86-lvi-load", "NumFunctionsMitigated", "Number of functions for which mitigations were deployed" };

static mut NumGadgets: Statistic = Statistic { "x86-lvi-load", "NumGadgets", "Number of LVI gadgets detected during analysis" };

static mut OptimizePluginPath: string> = string> { "x86-lvi-load-opt-plugin", "Specify a plugin to optimize LFENCE insertion", Hidden };

static mut NoConditionalBranches: opt<bool> = opt<bool> { "x86-lvi-load-no-cbranch", "Don't treat conditional branches as disclosure gadgets. This may improve performance, at the cost of security.", init(false), Hidden };

static mut EmitDot: opt<bool> = opt<bool> { "x86-lvi-load-dot", "For each function, emit a dot graph depicting potential LVI gadgets", init(false), Hidden };

static mut EmitDotOnly: opt<bool> = opt<bool> { "x86-lvi-load-dot-only", "For each function, emit a dot graph depicting potential LVI gadgets, and do not insert any fences", init(false), Hidden };

static mut EmitDotVerify: opt<bool> = opt<bool> { "x86-lvi-load-dot-verify", "For each function, emit a dot graph to stdout depicting potential LVI gadgets, used for testing purposes only", init(false), Hidden };

static mut OptimizeDL: DynamicLibrary = &mut Invalid;

static mut OptimizeCut: OptimizeCutT = null;

struct MachineGadgetGraph {
    NumFences: i32,
    NumGadgets: i32,
}

fn MachineGadgetGraph::isCFGEdge(self, E: *Edge) -> bool {
    return E.getValue() != GadgetEdgeSentinel;
}

fn MachineGadgetGraph::isGadgetEdge(self, E: *Edge) -> bool {
    return E.getValue() == GadgetEdgeSentinel;
}

const X86LVILHPassName: str = "X86 Load Value Injection (LVI) Load Hardening";

struct X86LoadValueInjectionLoadHardeningLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86LoadValueInjectionLoadHardeningLegacy::getPassName(self: *X86LoadValueInjectionLoadHardeningLegacy) -> str {
    return X86LVILHPassName;
}

fn X86LoadValueInjectionLoadHardeningLegacy::getPassKind(self: *X86LoadValueInjectionLoadHardeningLegacy) -> PassKind {
    return self.Kind;
}

fn X86LoadValueInjectionLoadHardeningLegacy::getPassID(self: *X86LoadValueInjectionLoadHardeningLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86LoadValueInjectionLoadHardeningLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LoadValueInjectionLoadHardeningLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LoadValueInjectionLoadHardeningLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86LoadValueInjectionLoadHardeningLegacy::getResolver(self: *X86LoadValueInjectionLoadHardeningLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86LoadValueInjectionLoadHardeningLegacy::getRequiredProperties(self: *X86LoadValueInjectionLoadHardeningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86LoadValueInjectionLoadHardeningLegacy::getSetProperties(self: *X86LoadValueInjectionLoadHardeningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86LoadValueInjectionLoadHardeningLegacy::getClearedProperties(self: *X86LoadValueInjectionLoadHardeningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

struct X86LoadValueInjectionLoadHardeningImpl {
    STI: *X86Subtarget,
    TII: *TargetInstrInfo,
    TRI: *TargetRegisterInfo,
}

fn X86LoadValueInjectionLoadHardeningImpl::isFence(self: *X86LoadValueInjectionLoadHardeningImpl, MI: *MachineInstr) -> bool {
    return MI && (MI.getOpcode() == LFENCE || (self.STI.useLVIControlFlowIntegrity() && MI.isCall(AnyInBundle)));
}

static mut ID: i8 = 0;

fn X86LoadValueInjectionLoadHardeningLegacy::getAnalysisUsage(self: *X86LoadValueInjectionLoadHardeningLegacy, AU: *mut AnalysisUsage) {
    self.getAnalysisUsage(AU);
    AU.addRequired();
    AU.addRequired();
    AU.addRequired();
    AU.setPreservesCFG();
}

fn writeGadgetGraph(OS: *mut raw_ostream, MF: *mut MachineFunction, G: *mut MachineGadgetGraph) {
    WriteGraph(OS, G, false, "Speculative gadgets for \"" + MF.getName() + "\" function");
}

fn X86LoadValueInjectionLoadHardeningImpl::run(self, MF: *mut MachineFunction, MLI: *MachineLoopInfo, MDT: *MachineDominatorTree, MDF: *MachineDominanceFrontier) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "***** " << X86LVILHPassName << " : " << MF.getName() << " *****\n";
        }
    }
        if !(false) { break; }
    }
    self.STI = &mut MF.getSubtarget();
    if !self.STI.is64Bit() {
        report_fatal_error("LVI load hardening is only supported on 64-bit", false);
    }
    operator(NumFunctionsConsidered);
    self.TII = self.STI.getInstrInfo();
    self.TRI = self.STI.getRegisterInfo();
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Building gadget graph...\n";
        }
    }
        if !(false) { break; }
    }
    let mut Graph: unique_ptr<MachineGadgetGraph> = self.getGadgetGraph(MF, MLI, MDT, MDF);
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Building gadget graph... Done\n";
        }
    }
        if !(false) { break; }
    }
    if Graph == null {
        return false;
    }
    if EmitDotVerify {
        writeGadgetGraph(outs(), MF, Graph.get());
        return false;
    }
    if EmitDot || EmitDotOnly {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Emitting gadget graph...\n";
            }
        }
            if !(false) { break; }
        }
        let mut FileError: error_code = error_code {};
        let mut FileName: str = "lvi.";
        operator(FileName, MF.getName());
        operator(FileName, ".dot");
        let mut FileOut: raw_fd_ostream = raw_fd_ostream { FileName, FileError };
        if FileError {
            errs() << FileError.message();
        }
        writeGadgetGraph(FileOut, MF, Graph.get());
        FileOut.close();
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Emitting gadget graph... Done\n";
            }
        }
            if !(false) { break; }
        }
        if EmitDotOnly {
            return false;
        }
    }
    let mut FencesInserted: i32 = 0;
    if !OptimizePluginPath.is_empty() {
        if !OptimizeDL.isValid() {
            let mut ErrorMsg: str = "";
            OptimizeDL = getPermanentLibrary(OptimizePluginPath.ptr, &mut ErrorMsg);
            if !ErrorMsg.is_empty() {
                report_fatal_error("Failed to load opt plugin: \"" + ErrorMsg + "\"", true);
            }
            OptimizeCut = OptimizeDL.getAddressOfSymbol("optimize_cut") as OptimizeCutT;
            if !OptimizeCut {
                report_fatal_error("Invalid optimization plugin", true);
            }
        }
        FencesInserted = self.hardenLoadsWithPlugin(MF, move(Graph));
    } else {
        FencesInserted = self.hardenLoadsWithHeuristic(MF, move(Graph));
    }
    if FencesInserted > 0 {
        operator(NumFunctionsMitigated);
    }
    operator(NumFences, FencesInserted);
    return (FencesInserted > 0);
}

fn X86LoadValueInjectionLoadHardeningImpl::getGadgetGraph(self: *X86LoadValueInjectionLoadHardeningImpl, MF: *mut MachineFunction, MLI: *MachineLoopInfo, MDT: *MachineDominatorTree, MDF: *MachineDominanceFrontier) -> unique_ptr<MachineGadgetGraph> {
    let mut DFG: DataFlowGraph = DataFlowGraph { MF, *self.TII, *self.TRI, MDT, MDF };
    DFG.build();
    let mut L: Liveness = Liveness { MF.getRegInfo(), DFG };
    L.computePhiInfo();
    let mut Builder: GraphBuilder = GraphBuilder {};
    let mut NodeMap: DenseMap<MachineInstr *, GraphIter> = DenseMap<MachineInstr *, GraphIter> {};
    let mut FenceCount: i32 = 0;
    let mut GadgetCount: i32 = 0;
    let mut MaybeAddNode: Closure_1 = Closure_1 { NodeMap: &mut NodeMap, Builder: &mut Builder };
    let mut Transmitters: vector<NodeId>> = vector<NodeId>> {};
    let mut AnalyzeDef: Closure_2 = Closure_2 { Transmitters: &mut Transmitters, DFG: &mut DFG, L: &mut L, cap_3: self, MaybeAddNode: &mut MaybeAddNode, Builder: &mut Builder, GadgetCount: &mut GadgetCount };
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Analyzing def-use chains to find gadgets\n";
        }
    }
        if !(false) { break; }
    }
    let mut EntryBlock: NodeAddr<BlockNode *> = DFG.getFunc().Addr.getEntryBlock(DFG);
    for ArgPhi in EntryBlock.Addr.members_if(IsPhi, DFG) {
        let mut Defs: NodeList = ArgPhi.Addr.members_if(IsDef, DFG);
        for_each(Defs, AnalyzeDef);
    }
    for BA in DFG.getFunc().Addr.members(DFG) {
        for SA in BA.Addr.members_if(IsCode, DFG) {
            let mut MI: *mut MachineInstr = SA.Addr.getCode();
            if self.isFence(MI) {
                MaybeAddNode.call(MI);
                FenceCount += 1;
            } else if MI.mayLoad(AnyInBundle) {
                let mut Defs: NodeList = SA.Addr.members_if(IsDef, DFG);
                for_each(Defs, AnalyzeDef);
            }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Found " << FenceCount << " fences\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Found " << GadgetCount << " gadgets\n";
        }
    }
        if !(false) { break; }
    }
    if GadgetCount == 0 {
        return null;
    }
    operator(NumGadgets, GadgetCount);
    let mut BlocksVisited: SmallPtrSet<MachineBasicBlock *, 8> = SmallPtrSet<MachineBasicBlock *, 8> {};
    let mut TraverseCFG: function<void (MachineBasicBlock *, GraphIter, unsigned int)> = Closure_4 { MLI: &mut MLI, MaybeAddNode: &mut MaybeAddNode, Builder: &mut Builder, BlocksVisited: &mut BlocksVisited, NodeMap: &mut NodeMap, TraverseCFG: &mut TraverseCFG };
    let mut ArgNode: GraphIter = MaybeAddNode.call(ArgNodeSentinel).first;
    TraverseCFG.call(&mut MF.front(), ArgNode, 0);
    let mut G: unique_ptr<MachineGadgetGraph> = MachineGadgetGraph> { Builder.get(FenceCount, GadgetCount) };
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Found " << operator(G).nodes_size() << " nodes\n";
        }
    }
        if !(false) { break; }
    }
    return G;
}

fn X86LoadValueInjectionLoadHardeningImpl::elimMitigatedEdgesAndNodes(self: *X86LoadValueInjectionLoadHardeningImpl, G: *mut MachineGadgetGraph, ElimEdges: *mut EdgeSet, ElimNodes: *mut NodeSet) -> i32 {
    if G.NumFences > 0 {
        for E in G.edges() {
            let mut Dest: *Node = E.getDest();
            if self.isFence(Dest.getValue()) {
                ElimNodes.insert(*Dest);
                ElimEdges.insert(E);
                for DE in Dest.edges() {
                    ElimEdges.insert(DE);
                }
            }
        }
    }
    let mut RemainingGadgets: i32 = 0;
    let mut ReachableNodes: NodeSet = NodeSet { G, false };
    for RootN in G.nodes() {
        if none_of(RootN.edges(), isGadgetEdge) {
            continue;
        }
        ReachableNodes.clear();
        let mut FindReachableNodes: function<void (const Node *, bool)> = Closure_5 { ReachableNodes: &mut ReachableNodes, ElimEdges: &mut ElimEdges, FindReachableNodes: &mut FindReachableNodes };
        FindReachableNodes.call(&mut RootN, true);
        for E in RootN.edges() {
            if isGadgetEdge(E) {
                if ReachableNodes.contains(*E.getDest()) {
                    RemainingGadgets += 1;
                } else {
                    ElimEdges.insert(E);
                }
            }
        }
    }
    return RemainingGadgets;
}

fn X86LoadValueInjectionLoadHardeningImpl::trimMitigatedEdges(self: *X86LoadValueInjectionLoadHardeningImpl, Graph: unique_ptr<MachineGadgetGraph>) -> unique_ptr<MachineGadgetGraph> {
    let mut ElimNodes: NodeSet = NodeSet { operator(Graph), false };
    let mut ElimEdges: EdgeSet = EdgeSet { operator(Graph), false };
    let mut RemainingGadgets: i32 = self.elimMitigatedEdgesAndNodes(operator(Graph), ElimEdges, ElimNodes);
    if ElimEdges.is_empty() && ElimNodes.is_empty() {
        operator(Graph).NumFences = 0;
        operator(Graph).NumGadgets = RemainingGadgets;
    } else {
        Graph = trim(operator(Graph), ElimNodes, ElimEdges, 0, RemainingGadgets);
    }
    return Graph;
}

fn X86LoadValueInjectionLoadHardeningImpl::hardenLoadsWithPlugin(self: *X86LoadValueInjectionLoadHardeningImpl, MF: *mut MachineFunction, Graph: unique_ptr<MachineGadgetGraph>) -> i32 {
    let mut FencesInserted: i32 = 0;
    while true {
        {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Eliminating mitigated paths...\n";
            }
        }
            if !(false) { break; }
        }
        Graph = self.trimMitigatedEdges(move(Graph));
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Eliminating mitigated paths... Done\n";
            }
        }
            if !(false) { break; }
        }
        if operator(Graph).NumGadgets == 0 {
            break;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Cutting edges...\n";
            }
        }
            if !(false) { break; }
        }
        let mut CutEdges: EdgeSet = EdgeSet { operator(Graph), false };
        let mut Nodes: []unique_ptr<unsigned int = make_unique(operator(Graph).nodes_size() + 1);
        let mut Edges: []unique_ptr<unsigned int = make_unique(operator(Graph).edges_size());
        let mut EdgeCuts: []unique_ptr<int = make_unique(operator(Graph).edges_size());
        let mut EdgeValues: []unique_ptr<int = make_unique(operator(Graph).edges_size());
        for N in operator(Graph).nodes() {
            Nodes[operator(Graph).getNodeIndex(N)] = operator(Graph).getEdgeIndex(*N.edges_begin());
        }
        Nodes[operator(Graph).nodes_size()] = operator(Graph).edges_size();
        for E in operator(Graph).edges() {
            Edges[operator(Graph).getEdgeIndex(E)] = operator(Graph).getNodeIndex(*E.getDest());
            EdgeValues[operator(Graph).getEdgeIndex(E)] = E.getValue();
        }
        OptimizeCut(Nodes.get(), operator(Graph).nodes_size(), Edges.get(), EdgeValues.get(), EdgeCuts.get(), operator(Graph).edges_size());
        for let mut I: i32 = 0; I < operator(Graph).edges_size(); I += 1 {
            if EdgeCuts[I] {
                CutEdges.set(I);
            }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Cutting edges... Done\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Cut " << CutEdges.count() << " edges\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Inserting LFENCEs...\n";
            }
        }
            if !(false) { break; }
        }
        FencesInserted += self.insertFences(MF, operator(Graph), CutEdges);
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Inserting LFENCEs... Done\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Inserted " << FencesInserted << " fences\n";
            }
        }
            if !(false) { break; }
        }
        Graph = trim(operator(Graph), NodeSet { operator(Graph), false }, CutEdges);
    }
        if !(true) { break; }
    }
    return FencesInserted;
}

fn X86LoadValueInjectionLoadHardeningImpl::hardenLoadsWithHeuristic(self: *X86LoadValueInjectionLoadHardeningImpl, MF: *mut MachineFunction, Graph: unique_ptr<MachineGadgetGraph>) -> i32 {
    if operator(Graph).NumFences > 0 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Eliminating mitigated paths...\n";
            }
        }
            if !(false) { break; }
        }
        Graph = self.trimMitigatedEdges(move(Graph));
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Eliminating mitigated paths... Done\n";
            }
        }
            if !(false) { break; }
        }
    }
    if operator(Graph).NumGadgets == 0 {
        return 0;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Cutting edges...\n";
        }
    }
        if !(false) { break; }
    }
    let mut CutEdges: EdgeSet = EdgeSet { operator(Graph), false };
    let mut IngressEdgeMap: DenseMap<const Node *, SmallVector<const Edge *, 2>> = DenseMap<const Node *, SmallVector<const Edge *, 2>> {};
    for E in operator(Graph).edges() {
        if isCFGEdge(E) {
            IngressEdgeMap[E.getDest()].push(&mut E);
        }
    }
    for N in operator(Graph).nodes() {
        for E in N.edges() {
            if !isGadgetEdge(E) {
                continue;
            }
            let mut EgressEdges: SmallVector<const Edge *, 2> = SmallVector<const Edge *, 2> {};
            let mut IngressEdges: *SmallVector<const Edge *, 2> = IngressEdgeMap[E.getDest()];
            for EgressEdge in N.edges() {
                if isCFGEdge(EgressEdge) {
                    EgressEdges.push(&mut EgressEdge);
                }
            }
            let mut EgressCutCost: i32 = 0;
            let mut IngressCutCost: i32 = 0;
            for EgressEdge in EgressEdges {
                if !CutEdges.contains(*EgressEdge) {
                    EgressCutCost += EgressEdge.getValue();
                }
            }
            for IngressEdge in IngressEdges {
                if !CutEdges.contains(*IngressEdge) {
                    IngressCutCost += IngressEdge.getValue();
                }
            }
            let mut EdgesToCut: *SmallVector<const Edge *, 2> = if IngressCutCost < EgressCutCost { IngressEdges } else { EgressEdges };
            for E in EdgesToCut {
                CutEdges.insert(*E);
            }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Cutting edges... Done\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Cut " << CutEdges.count() << " edges\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Inserting LFENCEs...\n";
        }
    }
        if !(false) { break; }
    }
    let mut FencesInserted: i32 = self.insertFences(MF, operator(Graph), CutEdges);
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Inserting LFENCEs... Done\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Inserted " << FencesInserted << " fences\n";
        }
    }
        if !(false) { break; }
    }
    return FencesInserted;
}

fn X86LoadValueInjectionLoadHardeningImpl::insertFences(self: *X86LoadValueInjectionLoadHardeningImpl, MF: *mut MachineFunction, G: *mut MachineGadgetGraph, CutEdges: *mut EdgeSet) -> i32 {
    let mut FencesInserted: i32 = 0;
    for N in G.nodes() {
        for E in N.edges() {
            if CutEdges.contains(E) {
                let mut MI: *mut MachineInstr = N.getValue();
                let mut Prev: *mut MachineInstr = null;
                let mut MBB: *mut MachineBasicBlock = null;
                let mut InsertionPt: iterator = iterator {};
                if MI == ArgNodeSentinel {
                    MBB = &mut MF.front();
                    InsertionPt = MBB.begin();
                    Prev = null;
                } else if MI.isBranch(AnyInBundle) {
                    MBB = MI.getParent();
                    InsertionPt = MI;
                    Prev = MI.getPrevNode();
                    for E in N.edges() {
                        if isCFGEdge(E) {
                            CutEdges.insert(E);
                        }
                    }
                } else {
                    MBB = MI.getParent();
                    InsertionPt = if MI.getNextNode() { MI.getNextNode() } else { MBB.end() };
                    Prev = if InsertionPt == MBB.end() { (if MBB.is_empty() { null } else { &mut MBB.back() }) } else { operator(InsertionPt).getPrevNode() };
                }
                if (InsertionPt == MBB.end() || !self.isFence(&mut operator(InsertionPt))) && (!Prev || !self.isFence(Prev)) {
                    BuildMI(*MBB, InsertionPt, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LFENCE));
                    FencesInserted += 1;
                }
            }
        }
    }
    return FencesInserted;
}

fn X86LoadValueInjectionLoadHardeningImpl::instrUsesRegToAccessMemory(self: *X86LoadValueInjectionLoadHardeningImpl, MI: *MachineInstr, Reg: Register) -> bool {
    if !MI.mayLoadOrStore(AnyInBundle) || MI.getOpcode() == MFENCE || MI.getOpcode() == SFENCE || MI.getOpcode() == LFENCE {
        return false;
    }
    let mut MemRefBeginIdx: i32 = getFirstAddrOperandIdx(MI);
    if MemRefBeginIdx < 0 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Warning: unable to obtain memory operand for loading instruction:\n";
                MI.print(dbgs(), true, false, false, true, null);
                dbgs() << 10;
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut BaseMO: *MachineOperand = MI.getOperand(MemRefBeginIdx + AddrBaseReg);
    let mut IndexMO: *MachineOperand = MI.getOperand(MemRefBeginIdx + AddrIndexReg);
    return (BaseMO.isReg() && BaseMO.getReg().isValid() && self.TRI.regsOverlap(BaseMO.getReg(), Reg)) || (IndexMO.isReg() && IndexMO.getReg().isValid() && self.TRI.regsOverlap(IndexMO.getReg(), Reg));
}

fn X86LoadValueInjectionLoadHardeningImpl::instrUsesRegToBranch(self: *X86LoadValueInjectionLoadHardeningImpl, MI: *MachineInstr, Reg: Register) -> bool {
    if !MI.isConditionalBranch(AnyInBundle) {
        return false;
    }
    for Use in MI.uses() {
        if Use.isReg() && Use.getReg() == Reg {
            return true;
        }
    }
    return false;
}

fn X86LoadValueInjectionLoadHardeningLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut F: *Function = MF.getFunction();
    if !F.hasOptNone() && self.skipFunction(F) {
        return false;
    }
    if !MF.getSubtarget().useLVILoadHardening() {
        return false;
    }
    let mut MLI: *MachineLoopInfo = self.getAnalysis().getLI();
    let mut MDT: *MachineDominatorTree = self.getAnalysis().getDomTree();
    let mut MDF: *MachineDominanceFrontier = self.getAnalysis().getMDF();
    let mut Impl: X86LoadValueInjectionLoadHardeningImpl = X86LoadValueInjectionLoadHardeningImpl {};
    return Impl.run(MF, MLI, MDT, MDF);
}

fn X86LoadValueInjectionLoadHardeningPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    if !MF.getSubtarget().useLVILoadHardening() {
        return all();
    }
    let mut MLI: *Result = MFAM.getResult(MF);
    let mut MDT: *Result = MFAM.getResult(MF);
    let mut MDF: *Result = MFAM.getResult(MF);
    let mut Impl: X86LoadValueInjectionLoadHardeningImpl = X86LoadValueInjectionLoadHardeningImpl {};
    let mut Modified: bool = Impl.run(MF, MLI, MDT, MDF);
    return if Modified { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}

fn createX86LoadValueInjectionLoadHardeningLegacyPass() -> *mut FunctionPass {
    return X86LoadValueInjectionLoadHardeningLegacy {};
}

struct Closure_1 {
    NodeMap: *mut DenseMap<MachineInstr *, GraphIter>,
    Builder: *mut GraphBuilder,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MI: *mut MachineInstr) -> pair<GraphIter, bool> {
        if Inserted {
            let mut I: BuilderNodeRef = (*self.Builder).addVertex(MI);
            operator(Ref).second = I;
            return pair<GraphIter, bool> { I, true };
        }
        return pair<GraphIter, bool> { operator(Ref).getSecond(), false };
    }

struct Closure_3 {
    Transmitters: *mut vector<NodeId>>,
    DFG: *mut DataFlowGraph,
    L: *mut Liveness,
    UsesVisited: *mut SmallSet<NodeId, 8>,
    cap_4: *X86LoadValueInjectionLoadHardeningImpl,
    DefsVisited: *mut SmallSet<NodeId, 8>,
    AnalyzeDefUseChain: *mut function<void (NodeAddr<DefNode *>)>,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Def: NodeAddr<DefNode *>) {
            if (*self.Transmitters).contains(Def.Id) {
                return;
            }
            let mut Uses: NodeSet = NodeSet {};
            let mut DefReg: RegisterRef = Def.Addr.getRegRef((*self.DFG));
            for UseID in (*self.L).getAllReachedUses(DefReg, Def) {
                let mut Use: UseNode *> = (*self.DFG).addr(UseID);
                if Use.Addr.getFlags() & PhiRef {
                    let mut Phi: NodeAddr<PhiNode *> = Use.Addr.getOwner((*self.DFG));
                    for I in (*self.L).getRealUses(Phi.Id) {
                        if (*self.DFG).getPRI().alias(RegisterRef { Id: I.first, Mask: getAll() }, DefReg) {
                            for UA in I.second {
                                Uses.emplace(UA.first);
                            }
                        }
                    }
                } else {
                    Uses.emplace(UseID);
                }
            }
            for UseID in Uses {
                if !(*self.UsesVisited).insert(UseID).second {
                    continue;
                }
                let mut Use: UseNode *> = (*self.DFG).addr(UseID);
                assert!(!(Use.Addr.getFlags() & PhiRef);
                let mut UseMO: *mut MachineOperand = Use.Addr.getOp();
                let mut UseMI: *mut MachineInstr = *UseMO.getParent();
                assert!(UseMO.isReg();
                if UseMI.isCall(AnyInBundle) {
                    continue;
                }
                if self.instrUsesRegToAccessMemory(UseMI, UseMO.getReg()) || (!NoConditionalBranches && self.instrUsesRegToBranch(UseMI, UseMO.getReg())) {
                    (*self.Transmitters)[Def.Id].push(Use.Addr.getOwner((*self.DFG)).Id);
                    if UseMI.mayLoad(AnyInBundle) {
                        continue;
                    }
                }
                let mut Owner: NodeAddr<InstrNode *> = Use.Addr.getOwner((*self.DFG));
                for ChildDef in Owner.Addr.members_if(IsDef, (*self.DFG)) {
                    if !(*self.DefsVisited).insert(ChildDef.Id).second {
                        continue;
                    }
                    if Def.Addr.getAttrs() & Dead {
                        continue;
                    }
                    if Def.Id == ChildDef.Id {
                        continue;
                    }
                    (*self.AnalyzeDefUseChain).call(ChildDef);
                    for TransmitterId in (*self.Transmitters)[ChildDef.Id] {
                        (*self.Transmitters)[Def.Id].push(TransmitterId);
                    }
                }
            }
            let mut DefTransmitters: *mut []u32 = (*self.Transmitters)[Def.Id];
            sort(DefTransmitters);
            DefTransmitters.erase(unique(DefTransmitters), DefTransmitters.end());
        }

struct Closure_2 {
    Transmitters: *mut vector<NodeId>>,
    DFG: *mut DataFlowGraph,
    L: *mut Liveness,
    cap_3: *X86LoadValueInjectionLoadHardeningImpl,
    MaybeAddNode: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86LoadValueInjectionLoadHardening.cpp:339:23),
    Builder: *mut GraphBuilder,
    GadgetCount: *mut i32,
}

unsafe fn Closure_2::call(self: *mut Closure_2, SourceDef: NodeAddr<DefNode *>) {
        let mut UsesVisited: SmallSet<NodeId, 8> = SmallSet<NodeId, 8> {};
        let mut DefsVisited: SmallSet<NodeId, 8> = SmallSet<NodeId, 8> {};
        let mut AnalyzeDefUseChain: function<void (NodeAddr<DefNode *>)> = Closure_3 { Transmitters: &mut (*self.Transmitters), DFG: &mut (*self.DFG), L: &mut (*self.L), UsesVisited: &mut UsesVisited, cap_4: self, DefsVisited: &mut DefsVisited, AnalyzeDefUseChain: &mut AnalyzeDefUseChain };
        AnalyzeDefUseChain.call(SourceDef);
        let mut SourceDefTransmitters: *mut []u32 = (*self.Transmitters)[SourceDef.Id];
        if SourceDefTransmitters.is_empty() {
            return;
        }
        let mut Source: *mut MachineInstr = if SourceDef.Addr.getFlags() & PhiRef { ArgNodeSentinel } else { SourceDef.Addr.getOp().getParent() };
        let mut GadgetSource: pair<GraphIter, bool> = (*self.MaybeAddNode).call(Source);
        for TransmitterId in SourceDefTransmitters {
            let mut Sink: *mut MachineInstr = (*self.DFG).addr(TransmitterId).Addr.getCode();
            let mut GadgetSink: pair<GraphIter, bool> = (*self.MaybeAddNode).call(Sink);
            (*self.Builder).addEdge(GadgetEdgeSentinel, GadgetSource.first, GadgetSink.first);
            (*self.GadgetCount) += 1;
        }
    }

struct Closure_4 {
    MLI: *mut MachineLoopInfo,
    MaybeAddNode: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86LoadValueInjectionLoadHardening.cpp:339:23),
    Builder: *mut GraphBuilder,
    BlocksVisited: *mut SmallPtrSet<MachineBasicBlock *, 8>,
    NodeMap: *mut DenseMap<MachineInstr *, GraphIter>,
    TraverseCFG: *mut function<void (MachineBasicBlock *, GraphIter, unsigned int)>,
}

unsafe fn Closure_4::call(self: *mut Closure_4, MBB: *mut MachineBasicBlock, GI: GraphIter, ParentDepth: u32) {
        let mut LoopDepth: u32 = (*self.MLI).getLoopDepth(MBB);
        if !MBB.is_empty() {
            let mut NI: iterator = MBB.begin();
            let mut BeginBB: pair<GraphIter, bool> = (*self.MaybeAddNode).call(&mut operator(NI));
            (*self.Builder).addEdge(ParentDepth, GI, BeginBB.first);
            if !(*self.BlocksVisited).insert(MBB).second {
                return;
            }
            GI = BeginBB.first;
            while operator(NI) != MBB.end() {
                let mut Ref: iterator = (*self.NodeMap).find(&mut operator(NI));
                if Ref != (*self.NodeMap).end() {
                    (*self.Builder).addEdge(LoopDepth, GI, operator(Ref).getSecond());
                    GI = operator(Ref).getSecond();
                }
            }
            let mut T: iterator = MBB.getFirstTerminator();
            if T != MBB.end() {
                let mut EndBB: pair<GraphIter, bool> = (*self.MaybeAddNode).call(&mut operator(T));
                if EndBB.second {
                    (*self.Builder).addEdge(LoopDepth, GI, EndBB.first);
                }
                GI = EndBB.first;
            }
        }
        for Succ in MBB.successors() {
            (*self.TraverseCFG).call(Succ, GI, LoopDepth);
        }
    }

struct Closure_5 {
    ReachableNodes: *mut NodeSet,
    ElimEdges: *mut EdgeSet,
    FindReachableNodes: *mut function<void (const Node *, bool)>,
}

unsafe fn Closure_5::call(self: *mut Closure_5, N: *Node, FirstNode: bool) {
            if !FirstNode {
                (*self.ReachableNodes).insert(*N);
            }
            for E in N.edges() {
                let mut Dest: *Node = E.getDest();
                if isCFGEdge(E) && !(*self.ElimEdges).contains(E) && !(*self.ReachableNodes).contains(*Dest) {
                    (*self.FindReachableNodes).call(Dest, false);
                }
            }
        }
