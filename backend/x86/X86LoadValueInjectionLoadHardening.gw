fn writeGadgetGraph(OS: *mut raw_ostream, MF: *mut MachineFunction, G: *mut MachineGadgetGraph) {
    WriteGraph(OS, G, false, "Speculative gadgets for \"" + MF.getName() + "\" function");
}

fn X86LoadValueInjectionLoadHardeningImpl::run(self, MF: *mut MachineFunction, MLI: *MachineLoopInfo, MDT: *MachineDominatorTree, MDF: *MachineDominanceFrontier) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "***** " << X86LVILHPassName << " : " << MF.getName() << " *****\n";
        }
    }
        if !(false) { break; }
    }
    self.STI = operator&(MF);
    if operator!(self.STI()) {
        report_fatal_error("LVI load hardening is only supported on 64-bit", false);
    }
    operator(NumFunctionsConsidered);
    self.TII;
    self.TRI;
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Building gadget graph...\n";
        }
    }
        if !(false) { break; }
    }
    let mut Graph: i32 = 0;
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Building gadget graph... Done\n";
        }
    }
        if !(false) { break; }
    }
    if Graph() == null {
        return false;
    }
    if EmitDotVerify() {
        writeGadgetGraph(outs(), MF);
        return false;
    }
    if EmitDot() ||  {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Emitting gadget graph...\n";
            }
        }
            if !(false) { break; }
        }
        let mut FileError: error_code = error_code {};
        let mut FileName: str = "lvi.";
        operator(FileName, MF.getName());
        operator(FileName, ".dot");
        let mut FileOut: raw_fd_ostream = raw_fd_ostream { FileName, FileError };
        if FileError {
            errs() << FileError.message();
        }
        writeGadgetGraph(FileOut, MF);
        FileOut.close();
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Emitting gadget graph... Done\n";
            }
        }
            if !(false) { break; }
        }
        if EmitDotOnly() {
            return false;
        }
    }
    let mut FencesInserted: i32 = 0;
    if operator!() {
        if !OptimizeDL.isValid() {
            let mut ErrorMsg: str = "";
            OptimizeDL = getPermanentLibrary(&mut ErrorMsg);
            if !ErrorMsg.is_empty() {
                report_fatal_error("Failed to load opt plugin: \"" + ErrorMsg + "\"", true);
            }
            OptimizeCut = OptimizeDL.getAddressOfSymbol("optimize_cut") as OptimizeCutT;
            if !OptimizeCut {
                report_fatal_error("Invalid optimization plugin", true);
            }
        }
    } else {}
    if FencesInserted > 0 {
        operator(NumFunctionsMitigated);
    }
    operator(NumFences, FencesInserted);
    return (FencesInserted > 0);
}

fn X86LoadValueInjectionLoadHardeningImpl::getGadgetGraph(self: *X86LoadValueInjectionLoadHardeningImpl, MF: *mut MachineFunction, MLI: *MachineLoopInfo, MDT: *MachineDominatorTree, MDF: *MachineDominanceFrontier) -> i32 {
    let mut DFG: DataFlowGraph = DataFlowGraph { MF, *self.TII, *self.TRI, MDT, MDF };
    DFG.build();
    let mut L: Liveness = Liveness { MF.getRegInfo(), DFG };
    L.computePhiInfo();
    let mut Builder: GraphBuilder = zeroed();
    let mut NodeMap: i32 = 0;
    let mut FenceCount: i32 = 0;
    let mut GadgetCount: i32 = 0;
    let mut MaybeAddNode: Closure_1 = Closure_1 {};
    let mut Transmitters: i32 = 0;
    let mut AnalyzeDef: Closure_2 = Closure_2 { DFG: &mut DFG, L: &mut L, cap_2: self, MaybeAddNode: &mut MaybeAddNode, GadgetCount: &mut GadgetCount };
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Analyzing def-use chains to find gadgets\n";
        }
    }
        if !(false) { break; }
    }
    let mut EntryBlock: NodeAddr<BlockNode *> = zeroed();
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Found " << " fences\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Found " << " gadgets\n";
        }
    }
        if !(false) { break; }
    }
    if GadgetCount == 0 {
        return null;
    }
    operator(NumGadgets, GadgetCount);
    let mut BlocksVisited: SmallPtrSet<MachineBasicBlock *, 8> = zeroed();
    let mut TraverseCFG: function<void (MachineBasicBlock *, int, unsigned int)> = zeroed();
    let mut ArgNode: i32 = MaybeAddNode.call(ArgNodeSentinel);
    TraverseCFG()(&mut MF.front(), 0);
    let mut G: i32 = void { (FenceCount, GadgetCount) };
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
            dbgs() << "Found " << () << " nodes\n";
        }
    }
        if !(false) { break; }
    }
    return ;
}

fn X86LoadValueInjectionLoadHardeningImpl::elimMitigatedEdgesAndNodes(self: *X86LoadValueInjectionLoadHardeningImpl, G: *mut MachineGadgetGraph, ElimEdges: *mut i32, ElimNodes: *mut i32) -> i32 {
    if G.NumFences > 0 {}
    let mut RemainingGadgets: i32 = 0;
    let mut ReachableNodes: i32 = void { G };
    return RemainingGadgets;
}

fn X86LoadValueInjectionLoadHardeningImpl::trimMitigatedEdges(self: *X86LoadValueInjectionLoadHardeningImpl, Graph: i32) -> i32 {
    let mut ElimNodes: i32 = void { operator*() };
    let mut ElimEdges: i32 = void { operator*() };
    let mut RemainingGadgets: i32 = 0;
    if ElimEdges()() && () {
        Graph() = 0;
        Graph() = RemainingGadgets;
    } else {}
    return ;
}

fn X86LoadValueInjectionLoadHardeningImpl::hardenLoadsWithPlugin(self: *X86LoadValueInjectionLoadHardeningImpl, MF: *mut MachineFunction, Graph: i32) -> i32 {
    let mut FencesInserted: i32 = 0;
    while true {
        {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Eliminating mitigated paths...\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Eliminating mitigated paths... Done\n";
            }
        }
            if !(false) { break; }
        }
        if Graph() == 0 {
            break;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Cutting edges...\n";
            }
        }
            if !(false) { break; }
        }
        let mut CutEdges: i32 = void { operator*() };
        let mut Nodes: auto = make_unique(() + 1);
        let mut Edges: auto = make_unique();
        let mut EdgeCuts: auto = make_unique();
        let mut EdgeValues: auto = make_unique();
        Nodes()[()] = ();
        OptimizeCut();
        for let mut I: i32 = 0; I < Graph()(); I += 1 {
            if EdgeCuts()[I] {
                CutEdges()(I);
            }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Cutting edges... Done\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Cut " << () << " edges\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Inserting LFENCEs...\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Inserting LFENCEs... Done\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-lvi-load", 1) {
                dbgs() << "Inserted " << " fences\n";
            }
        }
            if !(false) { break; }
        }
    }
        if !(true) { break; }
    }
    return FencesInserted;
}

