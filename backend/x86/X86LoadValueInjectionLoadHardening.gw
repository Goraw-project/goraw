fn MachineGadgetGraph::isCFGEdge(self, E: i32) -> bool {
    return () != GadgetEdgeSentinel;
}

fn MachineGadgetGraph::isGadgetEdge(self, E: i32) -> bool {
    return () == GadgetEdgeSentinel;
}

