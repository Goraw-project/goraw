            }
            for let mut i: i32 = 8; i != 16; i += 1 {
                ShuffleMask.push(-1);
            }
            let mut SV: *mut Value = Builder()(Builder()(Op0, ShufTy), get(ShufTy), ShuffleMask);
            return Builder()(SV, II.getType());
        }
        if CI0() {
            let mut Elt: APInt = ();
            Elt.lshrInPlace(Index);
            Elt = Elt.zextOrTrunc(Length);
            return LowConstantHighUndef(Elt.getZExtValue());
        }
        if  {
            let mut Args: [3]*mut Value = [Op0, CILength, CIIndex];
            return Builder();
        }
    }
    if CI0() && () {
        return LowConstantHighUndef(0);
    }
    return null;
}

fn simplifyX86insertq(II: *mut IntrinsicInst, Op0: *mut Value, Op1: *mut Value, APLength: APInt, APIndex: APInt, Builder: *mut BuilderTy) -> *mut Value {
    APIndex = APIndex.zextOrTrunc(6);
    APLength = APLength.zextOrTrunc(6);
    let mut Index: u32 = APIndex.getZExtValue();
    let mut Length: u32 = if APLength == 0 { 64 } else { APLength.getZExtValue() };
    let mut End: u32 = Index + Length;
    if End > 64 {
        return get(II.getType());
    }
    if (Length % 8) == 0 && (Index % 8) == 0 {
        Length /= 8;
        Index /= 8;
        let mut IntTy8: *mut Type = getInt8Ty(II.getContext());
        let mut ShufTy: *mut FixedVectorType = get(IntTy8, 16);
        let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        for let mut i: i32 = 0; i != Index as i32; i += 1 {
            ShuffleMask.push(i);
        }
        for let mut i: i32 = 0; i != Length as i32; i += 1 {
            ShuffleMask.push(i + 16);
        }
        for let mut i: i32 = Index + Length; i != 8; i += 1 {
            ShuffleMask.push(i);
        }
        for let mut i: i32 = 8; i != 16; i += 1 {
            ShuffleMask.push(-1);
        }
        let mut SV: *mut Value = Builder()(Builder()(Op0, ShufTy), Builder()(Op1, ShufTy), ShuffleMask);
        return Builder()(SV, II.getType());
    }
    let mut C0: *mut auto = dyn_cast(Op0);
    let mut C1: *mut auto = dyn_cast(Op1);
    let mut CI00: *mut auto = if  { dyn_cast_or_null((0 as u32)) } else { null };
    let mut CI10: *mut auto = if  { dyn_cast_or_null((0 as u32)) } else { null };
    if CI00() &&  {
        let mut V00: APInt = ();
        let mut V10: APInt = ();
        let mut Mask: APInt = getLowBitsSet(64, Length).shl(Index);
        V00 = V00 & operator(Mask);
        V10 = V10.zextOrTrunc(Length).zextOrTrunc(64).shl(Index);
        let mut Val: APInt = V00 | V10;
        let mut IntTy64: *mut Type = getInt64Ty(II.getContext());
        let mut Args: [2]*mut Constant = [get(IntTy64, Val.getZExtValue(), false, false), get(IntTy64)];
        return get(Args);
    }
    if  {
        let mut IntTy8: *mut Type = getInt8Ty(II.getContext());
        let mut CILength: *mut Constant = get(IntTy8, Length, false, false);
        let mut CIIndex: *mut Constant = get(IntTy8, Index, false, false);
        let mut Args: [4]*mut Value = [Op0, Op1, CILength, CIIndex];
        return Builder();
    }
    return null;
}

fn simplifyX86pshufb(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut V: *mut auto = dyn_cast(II.getArgOperand(1));
    if operator!() {
        return null;
    }
    let mut VecTy: *mut auto = cast(II.getType());
    let mut NumElts: u32 = ();
    assert!((NumElts == 16 || NumElts == 32 || NumElts == 64), "Unexpected number of elements in shuffle mask!");
    let mut Indexes: [64]i32 = zeroed();
    for let mut I: u32 = 0; I < NumElts; I += 1 {
        let mut COp: *mut Constant = (I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: i8 = cast(COp)()();
        Index = (if (Index < 0) { NumElts } else { Index & 15 }) + (I & 240);
        Indexes[I] = Index;
    }
    let mut V1: *mut Value = II.getArgOperand(0);
    let mut V2: auto = getNullValue();
    return Builder()(V1, Indexes(NumElts));
}

fn simplifyX86vpermilvar(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut V: *mut auto = dyn_cast(II.getArgOperand(1));
    if operator!() {
        return null;
    }
    let mut VecTy: *mut auto = cast(II.getType());
    let mut NumElts: u32 = ();
    let mut IsPD: bool = ()();
    let mut NumLaneElts: u32 = if IsPD { 2 } else { 4 };
    assert!(NumElts == 16 || NumElts == 8 || NumElts == 4 || NumElts == 2);
    let mut Indexes: [16]i32 = zeroed();
    for let mut I: u32 = 0; I < NumElts; I += 1 {
        let mut COp: *mut Constant = (I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: APInt = cast(COp)();
        Index = Index.zextOrTrunc(32).getLoBits(2);
        if IsPD {
            Index.lshrInPlace(1);
        }
        operator(Index, APInt { 32, (I / NumLaneElts) * NumLaneElts, false, false });
        Indexes[I] = Index.getZExtValue();
    }
    let mut V1: *mut Value = II.getArgOperand(0);
    return Builder()(V1, Indexes(NumElts));
}

fn simplifyX86vpermv(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut V: *mut auto = dyn_cast(II.getArgOperand(1));
    if operator!() {
        return null;
    }
    let mut VecTy: *mut auto = cast(II.getType());
    let mut Size: u32 = ();
    assert!((Size == 4 || Size == 8 || Size == 16 || Size == 32 || Size == 64), "Unexpected shuffle mask size");
    let mut Indexes: [64]i32 = zeroed();
    for let mut I: u32 = 0; I < Size; I += 1 {
        let mut COp: *mut Constant = (I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: u32 = cast(COp)();
        Index &= Size - 1;
        Indexes[I] = Index;
    }
    let mut V1: *mut Value = II.getArgOperand(0);
    return Builder()(V1, Indexes(Size));
}

fn simplifyX86vpermv3(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut V: *mut auto = dyn_cast(II.getArgOperand(1));
    if operator!() {
        return null;
    }
    let mut VecTy: *mut auto = cast(II.getType());
    let mut Size: u32 = ();
    assert!((Size == 2 || Size == 4 || Size == 8 || Size == 16 || Size == 32 || Size == 64), "Unexpected shuffle mask size");
    let mut Indexes: [64]i32 = zeroed();
    for let mut I: u32 = 0; I < Size; I += 1 {
        let mut COp: *mut Constant = (I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: u32 = cast(COp)();
        Index &= (2 * Size) - 1;
        Indexes[I] = Index;
    }
    let mut V1: *mut Value = II.getArgOperand(0);
    let mut V2: *mut Value = II.getArgOperand(2);
    return Builder()(V1, V2, Indexes(Size));
}

fn simplifyX86VPERMMask(II: *mut Instruction, IsBinary: bool, IC: *mut InstCombiner) -> bool {
    let mut VecTy: *mut auto = cast(II.getType());
    let mut EltSizeInBits: u32 = ();
    let mut NumElts: u32 = ();
    assert!(isPowerOf2_32(NumElts) && isPowerOf2_32(EltSizeInBits), "Unexpected shuffle mask size");
    let mut IdxSizeInBits: u32 = Log2_32(if IsBinary { (2 * NumElts) } else { NumElts });
    let mut DemandedMask: APInt = getLowBitsSet(EltSizeInBits, IdxSizeInBits);
    let mut KnownMask: KnownBits = KnownBits { EltSizeInBits };
    return IC.SimplifyDemandedBits(II, 1, DemandedMask, KnownMask);
}

