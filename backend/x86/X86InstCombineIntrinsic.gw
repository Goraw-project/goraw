    assert!((Res.first == null || Res.second == Imm), "Simplification of ternary logic does not verify!");
    return Res.first;
}

fn simplifyX86FPMaxMin(II: *IntrinsicInst, IC: *mut InstCombiner, NewIID: ID, IsScalar: bool) -> *mut Value {
    let mut Arg0: *mut Value = II.getArgOperand(0);
    let mut Arg1: *mut Value = II.getArgOperand(1);
    let mut VWidth: u32 = cast(Arg0.getType()).getNumElements();
    let mut SQ: SimplifyQuery = IC.getSimplifyQuery().getWithInstruction(&mut II);
    let mut DemandedElts: APInt = if IsScalar { getOneBitSet(VWidth, 0) } else { getAllOnes(VWidth) };
    let mut Forbidden0: FPClassTest = fcNan | fcInf | fcSubnormal;
    let mut Forbidden1: FPClassTest = fcNan | fcInf | fcSubnormal;
    if NewIID == maxnum {
        operator(Forbidden1, fcNegZero);
    } else {
        assert!(NewIID == minnum, "Unknown intrinsic");
        operator(Forbidden0, fcNegZero);
    }
    let mut KnownArg0: KnownFPClass = computeKnownFPClass(Arg0, DemandedElts, Forbidden0, SQ, 0);
    let mut KnownArg1: KnownFPClass = computeKnownFPClass(Arg1, DemandedElts, Forbidden1, SQ, 0);
    if KnownArg0.isKnownNever(Forbidden0) && KnownArg1.isKnownNever(Forbidden1) {
        if IsScalar {
            let mut Scalar0: *mut Value = IC.Builder.CreateExtractElement(Arg0, 0 as u64, "");
            let mut Scalar1: *mut Value = IC.Builder.CreateExtractElement(Arg1, 0 as u64, "");
            let mut NewScalar: *mut Value = if (NewIID == maxnum) { IC.Builder.CreateMaxNum(Scalar0, Scalar1, FMFSource {}, "") } else { IC.Builder.CreateMinNum(Scalar0, Scalar1, FMFSource {}, "") };
            return IC.Builder.CreateInsertElement(Arg0, NewScalar, 0 as u64, "");
        } else {
            return if (NewIID == maxnum) { IC.Builder.CreateMaxNum(Arg0, Arg1, FMFSource {}, "") } else { IC.Builder.CreateMinNum(Arg0, Arg1, FMFSource {}, "") };
        }
    }
    return null;
}

fn simplifyX86insertps(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut CInt: *mut ConstantInt = dyn_cast(II.getArgOperand(2));
    if !CInt {
        return null;
    }
    let mut VecTy: *mut FixedVectorType = cast(II.getType());
    assert!(VecTy.getNumElements() == 4, "insertps with wrong vector type");
    let mut Imm: u8 = CInt.getZExtValue();
    let mut ZMask: u8 = Imm & 15;
    let mut DestLane: u8 = (Imm >> 4) & 3;
    let mut SourceLane: u8 = (Imm >> 6) & 3;
    let mut ZeroVector: *mut ConstantAggregateZero = get(VecTy);
    if ZMask == 15 {
        return ZeroVector;
    }
    let mut ShuffleMask: [4]i32 = [0, 1, 2, 3];
    let mut V1: *mut Value = II.getArgOperand(1);
    if ZMask {
        if (II.getArgOperand(0) == II.getArgOperand(1)) || (ZMask & (1 << DestLane)) {
            V1 = ZeroVector;
            ShuffleMask[DestLane] = SourceLane;
            for let mut i: u32 = 0; i < 4; i += 1 {
                if (ZMask >> i) & 1 {
                    ShuffleMask[i] = i + 4;
                }
            }
        } else {
            return null;
        }
    } else {
        ShuffleMask[DestLane] = SourceLane + 4;
    }
    return Builder.CreateShuffleVector(II.getArgOperand(0), V1, ShuffleMask, "");
}

fn simplifyX86extrq(II: *mut IntrinsicInst, Op0: *mut Value, CILength: *mut ConstantInt, CIIndex: *mut ConstantInt, Builder: *mut BuilderTy) -> *mut Value {
    let mut LowConstantHighUndef: Closure_11 = Closure_11 { II: &mut II };
    let mut C0: *mut Constant = dyn_cast(Op0);
    let mut CI0: *mut ConstantInt = if C0 { dyn_cast_or_null(C0.getAggregateElement(0 as u32)) } else { null };
    if CILength && CIIndex {
        let mut APIndex: APInt = CIIndex.getValue().zextOrTrunc(6);
        let mut APLength: APInt = CILength.getValue().zextOrTrunc(6);
        let mut Index: u32 = APIndex.getZExtValue();
        let mut Length: u32 = if APLength == 0 { 64 } else { APLength.getZExtValue() };
        let mut End: u32 = Index + Length;
        if End > 64 {
            return get(II.getType());
        }
        if (Length % 8) == 0 && (Index % 8) == 0 {
            Length /= 8;
            Index /= 8;
            let mut IntTy8: *mut Type = getInt8Ty(II.getContext());
            let mut ShufTy: *mut FixedVectorType = get(IntTy8, 16);
            let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> {};
            for let mut i: i32 = 0; i != Length as i32; i += 1 {
                ShuffleMask.push(i + Index);
            }
            for let mut i: i32 = Length; i != 8; i += 1 {
                ShuffleMask.push(i + 16);
            }
            for let mut i: i32 = 8; i != 16; i += 1 {
                ShuffleMask.push(-1);
            }
            let mut SV: *mut Value = Builder.CreateShuffleVector(Builder.CreateBitCast(Op0, ShufTy, ""), get(ShufTy), ShuffleMask, "");
            return Builder.CreateBitCast(SV, II.getType(), "");
        }
        if CI0 {
            let mut Elt: APInt = CI0.getValue();
            Elt.lshrInPlace(Index);
            Elt = Elt.zextOrTrunc(Length);
            return LowConstantHighUndef.call(Elt.getZExtValue());
        }
        if II.getIntrinsicID() == x86_sse4a_extrq {
            let mut Args: [3]*mut Value = [Op0, CILength, CIIndex];
            return Builder.CreateIntrinsic(x86_sse4a_extrqi, Args, FMFSource {}, "", function_ref<void (CallInst *)> { Closure_12 {}, null, null });
        }
    }
    if CI0 && CI0.isZero() {
        return LowConstantHighUndef.call(0);
    }
    return null;
}

fn simplifyX86insertq(II: *mut IntrinsicInst, Op0: *mut Value, Op1: *mut Value, APLength: APInt, APIndex: APInt, Builder: *mut BuilderTy) -> *mut Value {
    APIndex = APIndex.zextOrTrunc(6);
    APLength = APLength.zextOrTrunc(6);
    let mut Index: u32 = APIndex.getZExtValue();
    let mut Length: u32 = if APLength == 0 { 64 } else { APLength.getZExtValue() };
    let mut End: u32 = Index + Length;
    if End > 64 {
        return get(II.getType());
    }
    if (Length % 8) == 0 && (Index % 8) == 0 {
        Length /= 8;
        Index /= 8;
        let mut IntTy8: *mut Type = getInt8Ty(II.getContext());
        let mut ShufTy: *mut FixedVectorType = get(IntTy8, 16);
        let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        for let mut i: i32 = 0; i != Index as i32; i += 1 {
            ShuffleMask.push(i);
        }
        for let mut i: i32 = 0; i != Length as i32; i += 1 {
            ShuffleMask.push(i + 16);
        }
        for let mut i: i32 = Index + Length; i != 8; i += 1 {
            ShuffleMask.push(i);
        }
        for let mut i: i32 = 8; i != 16; i += 1 {
            ShuffleMask.push(-1);
        }
        let mut SV: *mut Value = Builder.CreateShuffleVector(Builder.CreateBitCast(Op0, ShufTy, ""), Builder.CreateBitCast(Op1, ShufTy, ""), ShuffleMask, "");
        return Builder.CreateBitCast(SV, II.getType(), "");
    }
    let mut C0: *mut Constant = dyn_cast(Op0);
    let mut C1: *mut Constant = dyn_cast(Op1);
    let mut CI00: *mut ConstantInt = if C0 { dyn_cast_or_null(C0.getAggregateElement(0 as u32)) } else { null };
    let mut CI10: *mut ConstantInt = if C1 { dyn_cast_or_null(C1.getAggregateElement(0 as u32)) } else { null };
    if CI00 && CI10 {
        let mut V00: APInt = CI00.getValue();
        let mut V10: APInt = CI10.getValue();
        let mut Mask: APInt = getLowBitsSet(64, Length).shl(Index);
        V00 = V00 & operator(Mask);
        V10 = V10.zextOrTrunc(Length).zextOrTrunc(64).shl(Index);
        let mut Val: APInt = V00 | V10;
        let mut IntTy64: *mut Type = getInt64Ty(II.getContext());
        let mut Args: [2]*mut Constant = [get(IntTy64, Val.getZExtValue(), false, false), get(IntTy64)];
        return get(Args);
    }
    if II.getIntrinsicID() == x86_sse4a_insertq {
        let mut IntTy8: *mut Type = getInt8Ty(II.getContext());
        let mut CILength: *mut Constant = get(IntTy8, Length, false, false);
        let mut CIIndex: *mut Constant = get(IntTy8, Index, false, false);
        let mut Args: [4]*mut Value = [Op0, Op1, CILength, CIIndex];
        return Builder.CreateIntrinsic(x86_sse4a_insertqi, Args, FMFSource {}, "", function_ref<void (CallInst *)> { Closure_13 {}, null, null });
    }
    return null;
}

fn simplifyX86pshufb(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut V: *mut Constant = dyn_cast(II.getArgOperand(1));
    if !V {
        return null;
    }
    let mut VecTy: *mut FixedVectorType = cast(II.getType());
    let mut NumElts: u32 = VecTy.getNumElements();
    assert!((NumElts == 16 || NumElts == 32 || NumElts == 64), "Unexpected number of elements in shuffle mask!");
    let mut Indexes: [64]i32 = zeroed();
    for let mut I: u32 = 0; I < NumElts; I += 1 {
        let mut COp: *mut Constant = V.getAggregateElement(I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: i8 = cast(COp).getValue().getZExtValue();
        Index = (if (Index < 0) { NumElts } else { Index & 15 }) + (I & 240);
        Indexes[I] = Index;
    }
    let mut V1: *mut Value = II.getArgOperand(0);
    let mut V2: *mut Constant = getNullValue(VecTy);
    return Builder.CreateShuffleVector(V1, V2, ArrayRef<int> { Indexes, NumElts }, "");
}

fn simplifyX86vpermilvar(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut V: *mut Constant = dyn_cast(II.getArgOperand(1));
    if !V {
        return null;
    }
    let mut VecTy: *mut FixedVectorType = cast(II.getType());
    let mut NumElts: u32 = VecTy.getNumElements();
    let mut IsPD: bool = VecTy.getScalarType().isDoubleTy();
    let mut NumLaneElts: u32 = if IsPD { 2 } else { 4 };
    assert!(NumElts == 16 || NumElts == 8 || NumElts == 4 || NumElts == 2);
    let mut Indexes: [16]i32 = zeroed();
    for let mut I: u32 = 0; I < NumElts; I += 1 {
        let mut COp: *mut Constant = V.getAggregateElement(I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: APInt = cast(COp).getValue();
        Index = Index.zextOrTrunc(32).getLoBits(2);
        if IsPD {
            Index.lshrInPlace(1);
        }
        operator(Index, APInt { 32, (I / NumLaneElts) * NumLaneElts, false, false });
        Indexes[I] = Index.getZExtValue();
    }
    let mut V1: *mut Value = II.getArgOperand(0);
    return Builder.CreateShuffleVector(V1, ArrayRef<int> { Indexes, NumElts }, "");
}

fn simplifyX86vpermv(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut V: *mut Constant = dyn_cast(II.getArgOperand(1));
    if !V {
        return null;
    }
    let mut VecTy: *mut FixedVectorType = cast(II.getType());
    let mut Size: u32 = VecTy.getNumElements();
    assert!((Size == 4 || Size == 8 || Size == 16 || Size == 32 || Size == 64), "Unexpected shuffle mask size");
    let mut Indexes: [64]i32 = zeroed();
    for let mut I: u32 = 0; I < Size; I += 1 {
        let mut COp: *mut Constant = V.getAggregateElement(I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: u32 = cast(COp).getZExtValue();
        Index &= Size - 1;
        Indexes[I] = Index;
    }
    let mut V1: *mut Value = II.getArgOperand(0);
    return Builder.CreateShuffleVector(V1, ArrayRef<int> { Indexes, Size }, "");
}

fn simplifyX86vpermv3(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut V: *mut Constant = dyn_cast(II.getArgOperand(1));
    if !V {
        return null;
    }
    let mut VecTy: *mut FixedVectorType = cast(II.getType());
    let mut Size: u32 = VecTy.getNumElements();
    assert!((Size == 2 || Size == 4 || Size == 8 || Size == 16 || Size == 32 || Size == 64), "Unexpected shuffle mask size");
    let mut Indexes: [64]i32 = zeroed();
    for let mut I: u32 = 0; I < Size; I += 1 {
        let mut COp: *mut Constant = V.getAggregateElement(I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: u32 = cast(COp).getZExtValue();
        Index &= (2 * Size) - 1;
        Indexes[I] = Index;
    }
    let mut V1: *mut Value = II.getArgOperand(0);
    let mut V2: *mut Value = II.getArgOperand(2);
    return Builder.CreateShuffleVector(V1, V2, ArrayRef<int> { Indexes, Size }, "");
}

fn simplifyX86VPERMMask(II: *mut Instruction, IsBinary: bool, IC: *mut InstCombiner) -> bool {
    let mut VecTy: *mut FixedVectorType = cast(II.getType());
    let mut EltSizeInBits: u32 = VecTy.getScalarSizeInBits();
    let mut NumElts: u32 = VecTy.getNumElements();
    assert!(isPowerOf2_32(NumElts) && isPowerOf2_32(EltSizeInBits), "Unexpected shuffle mask size");
    let mut IdxSizeInBits: u32 = Log2_32(if IsBinary { (2 * NumElts) } else { NumElts });
    let mut DemandedMask: APInt = getLowBitsSet(EltSizeInBits, IdxSizeInBits);
    let mut KnownMask: KnownBits = EltSizeInBits;
    return IC.SimplifyDemandedBits(II, 1, DemandedMask, KnownMask);
}

fn X86TTIImpl::instCombineIntrinsic(self: *X86TTIImpl, IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut SimplifyDemandedVectorEltsLow: Closure_14 = Closure_14 { IC: &mut IC };
    let mut IID: ID = II.getIntrinsicID();
    match IID {
        x86_bmi_bextr_32 => {
            x86_bmi_bextr_64;
        },
        x86_bmi_bzhi_32 => {
            x86_bmi_bzhi_64;
        },
        x86_sse_cvtss2si => {
            x86_sse_cvtss2si64;
        },
        x86_mmx_pmovmskb => {
            x86_sse_movmsk_ps;
        },
        x86_sse_comieq_ss => {
            x86_sse_comige_ss;
        },
        x86_avx512_add_ps_512 => {
            x86_avx512_div_ps_512;
        },
        x86_avx512_mask_add_ss_round => {
            x86_avx512_mask_div_ss_round;
        },
        x86_sse_max_ps => {
            x86_sse2_max_pd;
        },
        x86_sse_max_ss => {
            x86_sse2_max_sd;
        },
        x86_sse_min_ps => {
            x86_sse2_min_pd;
        },
        x86_sse_min_ss => {
            x86_sse2_min_sd;
        },
        x86_sse2_psrai_d => {
            x86_sse2_psrai_w;
        },
        x86_sse2_psra_d => {
            x86_sse2_psra_w;
        },
        x86_avx2_psllv_d => {
            x86_avx2_psllv_d_256;
        },
        x86_sse2_packssdw_128 => {
            x86_sse2_packsswb_128;
        },
        x86_sse2_packuswb_128 => {
            x86_sse41_packusdw;
        },
        x86_ssse3_pmul_hr_sw_128 => {
            x86_avx2_pmul_hr_sw;
        },
        x86_sse2_pmadd_wd => {
            x86_avx2_pmadd_wd;
        },
        x86_ssse3_pmadd_ub_sw_128 => {
            x86_avx2_pmadd_ub_sw;
        },
        x86_pclmulqdq => {
            x86_pclmulqdq_256;
        },
        x86_sse41_insertps => {
            if simplifyX86insertps(II, IC.Builder) {
                V;
            } else {
                return IC.replaceInstUsesWith(II, V);
            }
        },
        x86_sse4a_extrq => {
            let mut Op0: *mut Value = II.getArgOperand(0);
            let mut Op1: *mut Value = II.getArgOperand(1);
            let mut VWidth0: u32 = cast(Op0.getType()).getNumElements();
            let mut VWidth1: u32 = cast(Op1.getType()).getNumElements();
            assert!(Op0.getType().getPrimitiveSizeInBits().operator unsigned long long() == 128 && Op1.getType().getPrimitiveSizeInBits().operator unsigned long long() == 128 && VWidth0 == 2 && VWidth1 == 16, "Unexpected operand sizes");
            let mut C1: *mut Constant = dyn_cast(Op1);
            let mut CILength: *mut ConstantInt = if C1 { dyn_cast_or_null(C1.getAggregateElement(0 as u32)) } else { null };
            let mut CIIndex: *mut ConstantInt = if C1 { dyn_cast_or_null(C1.getAggregateElement(1 as u32)) } else { null };
