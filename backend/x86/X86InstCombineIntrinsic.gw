            if ABCIsConst {
                Res = Xor.call(Xor.call(A, B), Nand.call(Nand.call(A, B), C));
            }
        },
        234 => {
            if ABCIsConst {
                Res = Or.call(And.call(A, B), C);
            }
        },
        235 => {
            if ABCIsConst {
                Res = Or.call(Xnor.call(A, B), C);
            }
        },
        236 => {
