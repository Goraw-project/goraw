fn getNegativeIsTrueBoolVec(V: *mut Constant, DL: *DataLayout) -> *mut Constant {
    let mut IntTy: *mut VectorType = getInteger(cast(V.getType()));
    V = getBitCast(V, IntTy, false);
    V = ConstantFoldCompareInstOperands(ICMP_SGT, getNullValue(IntTy), V, DL, null, null);
    assert!(V, "Vector must be foldable");
    return V;
}

fn getBoolVecFromMask(Mask: *mut Value, DL: *DataLayout) -> *mut Value {
    if isa(Mask) {
        return getNegativeIsTrueBoolVec(cast(Mask), DL);
    }
    let mut ExtMask: *mut Value = null;
    if match(Mask, m_SExt(m_Value(ExtMask))) && ExtMask.getType().isIntOrIntVectorTy(1) {
        return ExtMask;
    }
    return null;
}

fn simplifyX86MaskedLoad(II: *mut IntrinsicInst, IC: *mut InstCombiner) -> *mut Instruction {
    let mut Ptr: *mut Value = II.getOperand(0);
    let mut Mask: *mut Value = II.getOperand(1);
    let mut ZeroVec: *mut Constant = getNullValue(II.getType());
    if isa(Mask) {
        return IC.replaceInstUsesWith(II, ZeroVec);
    }
    if getBoolVecFromMask(Mask, IC.getDataLayout()) {
        BoolMask;
    } else {
        let mut NewMaskedLoad: *mut CallInst = IC.Builder.CreateMaskedLoad(II.getType(), Ptr, 1, BoolMask, ZeroVec, "");
        return IC.replaceInstUsesWith(II, NewMaskedLoad);
    }
    return null;
}

fn simplifyX86MaskedStore(II: *mut IntrinsicInst, IC: *mut InstCombiner) -> bool {
    let mut Ptr: *mut Value = II.getOperand(0);
    let mut Mask: *mut Value = II.getOperand(1);
    let mut Vec: *mut Value = II.getOperand(2);
    if isa(Mask) {
        IC.eraseInstFromFunction(II);
        return true;
    }
    if II.getIntrinsicID() == x86_sse2_maskmov_dqu {
        return false;
    }
    if getBoolVecFromMask(Mask, IC.getDataLayout()) {
        BoolMask;
    } else {
        let mut AddrSpace: u32 = cast(Ptr.getType()).getAddressSpace();
        let mut VecPtrTy: *mut PointerType = get(Vec.getContext(), AddrSpace);
        let mut PtrCast: *mut Value = IC.Builder.CreateBitCast(Ptr, VecPtrTy, "castvec");
        IC.Builder.CreateMaskedStore(Vec, PtrCast, 1, BoolMask);
        IC.eraseInstFromFunction(II);
        return true;
    }
    return false;
}

fn simplifyX86immShift(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut LogicalShift: bool = false;
    let mut ShiftLeft: bool = false;
    let mut IsImm: bool = false;
    match II.getIntrinsicID() {
        _ => {
            llvm_unreachable_internal("Unexpected intrinsic!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstCombineIntrinsic.cpp", 123);
        },
        x86_sse2_psrai_d => {
            x86_sse2_psrai_w;
        },
        x86_sse2_psra_d => {
            x86_sse2_psra_w;
        },
        x86_sse2_psrli_d => {
            x86_sse2_psrli_q;
        },
        x86_sse2_psrl_d => {
            x86_sse2_psrl_q;
        },
        x86_sse2_pslli_d => {
            x86_sse2_pslli_q;
        },
        x86_sse2_psll_d => {
            x86_sse2_psll_q;
        },
    }
    assert!((LogicalShift || !ShiftLeft), "Only logical shifts can shift left");
    let mut Vec: *mut Value = II.getArgOperand(0);
    let mut Amt: *mut Value = II.getArgOperand(1);
    let mut VT: *mut FixedVectorType = cast(Vec.getType());
    let mut SVT: *mut Type = VT.getElementType();
    let mut AmtVT: *mut Type = Amt.getType();
    let mut VWidth: u32 = VT.getNumElements();
    let mut BitWidth: u32 = SVT.getPrimitiveSizeInBits().operator unsigned long long();
    if IsImm {
        assert!(AmtVT.isIntegerTy(32), "Unexpected shift-by-immediate type");
        let mut KnownAmtBits: KnownBits = computeKnownBits(Amt, II.getDataLayout(), null, null, null, true, 0);
        if KnownAmtBits.getMaxValue().ult(BitWidth) {
            Amt = Builder.CreateZExtOrTrunc(Amt, SVT, "");
            Amt = Builder.CreateVectorSplat(VWidth, Amt, "");
            return (if LogicalShift { (if ShiftLeft { Builder.CreateShl(Vec, Amt, "", false, false) } else { Builder.CreateLShr(Vec, Amt, "", false) }) } else { Builder.CreateAShr(Vec, Amt, "", false) });
        }
        if KnownAmtBits.getMinValue().uge(BitWidth) {
            if LogicalShift {
                return get(VT);
            }
            Amt = get(SVT, BitWidth - 1, false, false);
            return Builder.CreateAShr(Vec, Builder.CreateVectorSplat(VWidth, Amt, ""), "", false);
        }
    } else {
        assert!(AmtVT.isVectorTy() && AmtVT.getPrimitiveSizeInBits().operator unsigned long long() == 128 && cast(AmtVT).getElementType() == SVT, "Unexpected shift-by-scalar type");
        let mut NumAmtElts: u32 = cast(AmtVT).getNumElements();
        let mut DemandedLower: APInt = getOneBitSet(NumAmtElts, 0);
        let mut DemandedUpper: APInt = getBitsSet(NumAmtElts, 1, NumAmtElts / 2);
        let mut KnownLowerBits: KnownBits = computeKnownBits(Amt, DemandedLower, SimplifyQuery { II.getDataLayout(), null }, 0);
        let mut KnownUpperBits: KnownBits = computeKnownBits(Amt, DemandedUpper, SimplifyQuery { II.getDataLayout(), null }, 0);
        if KnownLowerBits.getMaxValue().ult(BitWidth) && (DemandedUpper.isZero() || KnownUpperBits.isZero()) {
            let mut ZeroSplat: SmallVector<int, 16> = SmallVector<int, 16> { VWidth, 0 };
            Amt = Builder.CreateShuffleVector(Amt, ZeroSplat, "");
            return (if LogicalShift { (if ShiftLeft { Builder.CreateShl(Vec, Amt, "", false, false) } else { Builder.CreateLShr(Vec, Amt, "", false) }) } else { Builder.CreateAShr(Vec, Amt, "", false) });
        }
    }
    let mut CDV: *mut ConstantDataVector = dyn_cast(Amt);
    if !CDV {
        return null;
    }
    assert!(AmtVT.isVectorTy() && AmtVT.getPrimitiveSizeInBits().operator unsigned long long() == 128 && cast(AmtVT).getElementType() == SVT, "Unexpected shift-by-scalar type");
    let mut Count: APInt = APInt { 64, 0, false, false };
    for let mut i: u32 = 0;
let mut NumSubElts: u32 = 64 / BitWidth; i != NumSubElts; i += 1 {
        let mut SubEltIdx: u32 = (NumSubElts - 1) - i;
        let mut SubElt: *mut ConstantInt = cast(CDV.getElementAsConstant(SubEltIdx));
        operator(Count, BitWidth);
        operator(Count, SubElt.getValue().zextOrTrunc(64));
    }
    if Count.isZero() {
        return Vec;
    }
    if Count.uge(BitWidth) {
        if LogicalShift {
            return get(VT);
        }
        Count = APInt { 64, BitWidth - 1, false, false };
    }
    let mut ShiftAmt: *mut Constant = get(SVT, Count.zextOrTrunc(BitWidth));
    let mut ShiftVec: *mut Value = Builder.CreateVectorSplat(VWidth, ShiftAmt, "");
    if ShiftLeft {
        return Builder.CreateShl(Vec, ShiftVec, "", false, false);
    }
    if LogicalShift {
        return Builder.CreateLShr(Vec, ShiftVec, "", false);
    }
    return Builder.CreateAShr(Vec, ShiftVec, "", false);
}

fn simplifyX86varShift(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut LogicalShift: bool = false;
    let mut ShiftLeft: bool = false;
    match II.getIntrinsicID() {
        _ => {
            llvm_unreachable_internal("Unexpected intrinsic!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstCombineIntrinsic.cpp", 304);
        },
        x86_avx2_psrav_d => {
            x86_avx2_psrav_d_256;
        },
        x86_avx2_psrlv_d => {
            x86_avx2_psrlv_d_256;
        },
        x86_avx2_psllv_d => {
            x86_avx2_psllv_d_256;
        },
    }
    assert!((LogicalShift || !ShiftLeft), "Only logical shifts can shift left");
    let mut Vec: *mut Value = II.getArgOperand(0);
    let mut Amt: *mut Value = II.getArgOperand(1);
    let mut VT: *mut FixedVectorType = cast(II.getType());
    let mut SVT: *mut Type = VT.getElementType();
    let mut NumElts: i32 = VT.getNumElements();
    let mut BitWidth: i32 = SVT.getIntegerBitWidth();
    let mut KnownAmt: KnownBits = computeKnownBits(Amt, II.getDataLayout(), null, null, null, true, 0);
    if KnownAmt.getMaxValue().ult(BitWidth) {
        return (if LogicalShift { (if ShiftLeft { Builder.CreateShl(Vec, Amt, "", false, false) } else { Builder.CreateLShr(Vec, Amt, "", false) }) } else { Builder.CreateAShr(Vec, Amt, "", false) });
    }
    let mut CShift: *mut Constant = dyn_cast(Amt);
    if !CShift {
        return null;
    }
    let mut AnyOutOfRange: bool = false;
    let mut ShiftAmts: SmallVector<int, 8> = SmallVector<int, 8> {};
    for let mut I: i32 = 0; I < NumElts; I += 1 {
        let mut CElt: *mut Constant = CShift.getAggregateElement(I);
        if isa_and_nonnull(CElt) {
            ShiftAmts.push(-1);
            continue;
        }
        let mut COp: *mut ConstantInt = dyn_cast_or_null(CElt);
        if !COp {
            return null;
        }
        let mut ShiftVal: APInt = COp.getValue();
        if ShiftVal.uge(BitWidth) {
            AnyOutOfRange = LogicalShift;
            ShiftAmts.push(if LogicalShift { BitWidth } else { BitWidth - 1 });
            continue;
        }
        ShiftAmts.push(ShiftVal.getZExtValue() as i32);
    }
    let mut OutOfRange: Closure_1 = Closure_1 { BitWidth: &mut BitWidth };
    if all_of(ShiftAmts, OutOfRange) {
        let mut ConstantVec: SmallVector<Constant *, 8> = SmallVector<Constant *, 8> {};
        for Idx in ShiftAmts {
            if Idx < 0 {
                ConstantVec.push(get(SVT));
            } else {
                assert!(LogicalShift, "Logical shift expected");
                ConstantVec.push(getNullValue(SVT));
            }
        }
        return get(ConstantVec);
    }
    if AnyOutOfRange {
        return null;
    }
    let mut ShiftVecAmts: SmallVector<Constant *, 8> = SmallVector<Constant *, 8> {};
    for Idx in ShiftAmts {
        if Idx < 0 {
            ShiftVecAmts.push(get(SVT));
        } else {
            ShiftVecAmts.push(get(SVT, Idx, false, false));
        }
    }
    let mut ShiftVec: *mut Constant = get(ShiftVecAmts);
    if ShiftLeft {
        return Builder.CreateShl(Vec, ShiftVec, "", false, false);
    }
    if LogicalShift {
        return Builder.CreateLShr(Vec, ShiftVec, "", false);
    }
    return Builder.CreateAShr(Vec, ShiftVec, "", false);
}

fn simplifyX86pack(II: *mut IntrinsicInst, Builder: *mut BuilderTy, IsSigned: bool) -> *mut Value {
    let mut Arg0: *mut Value = II.getArgOperand(0);
    let mut Arg1: *mut Value = II.getArgOperand(1);
    let mut ResTy: *mut Type = II.getType();
    if isa(Arg0) && isa(Arg1) {
        return get(ResTy);
    }
    let mut ArgTy: *mut FixedVectorType = cast(Arg0.getType());
    let mut NumLanes: u32 = ResTy.getPrimitiveSizeInBits().operator unsigned long long() / 128;
    let mut NumSrcElts: u32 = ArgTy.getNumElements();
    assert!(cast(ResTy).getNumElements() == (2 * NumSrcElts), "Unexpected packing types");
    let mut NumSrcEltsPerLane: u32 = NumSrcElts / NumLanes;
    let mut DstScalarSizeInBits: u32 = ResTy.getScalarSizeInBits();
    let mut SrcScalarSizeInBits: u32 = ArgTy.getScalarSizeInBits();
    assert!(SrcScalarSizeInBits == (2 * DstScalarSizeInBits), "Unexpected packing types");
    if !isa(Arg0) || !isa(Arg1) {
        return null;
    }
    let mut MinValue: APInt = APInt {};
    let mut MaxValue: APInt = APInt {};
    if IsSigned {
        MinValue = getSignedMinValue(DstScalarSizeInBits).sext(SrcScalarSizeInBits);
        MaxValue = getSignedMaxValue(DstScalarSizeInBits).sext(SrcScalarSizeInBits);
    } else {
        MinValue = getZero(SrcScalarSizeInBits);
        MaxValue = getLowBitsSet(SrcScalarSizeInBits, DstScalarSizeInBits);
    }
    let mut MinC: *mut Constant = getIntegerValue(ArgTy, MinValue);
    let mut MaxC: *mut Constant = getIntegerValue(ArgTy, MaxValue);
    Arg0 = Builder.CreateSelect(Builder.CreateICmpSLT(Arg0, MinC, ""), MinC, Arg0, "", null);
    Arg1 = Builder.CreateSelect(Builder.CreateICmpSLT(Arg1, MinC, ""), MinC, Arg1, "", null);
    Arg0 = Builder.CreateSelect(Builder.CreateICmpSGT(Arg0, MaxC, ""), MaxC, Arg0, "", null);
    Arg1 = Builder.CreateSelect(Builder.CreateICmpSGT(Arg1, MaxC, ""), MaxC, Arg1, "", null);
    let mut PackMask: SmallVector<int, 32> = SmallVector<int, 32> {};
    for let mut Lane: u32 = 0; Lane != NumLanes; Lane += 1 {
        for let mut Elt: u32 = 0; Elt != NumSrcEltsPerLane; Elt += 1 {
            PackMask.push(Elt + (Lane * NumSrcEltsPerLane));
        }
        for let mut Elt: u32 = 0; Elt != NumSrcEltsPerLane; Elt += 1 {
            PackMask.push(Elt + (Lane * NumSrcEltsPerLane) + NumSrcElts);
        }
    }
    let mut Shuffle: *mut Value = Builder.CreateShuffleVector(Arg0, Arg1, PackMask, "");
    return Builder.CreateTrunc(Shuffle, ResTy, "", false, false);
}

fn simplifyX86pmulhrsw(II: *mut IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut Arg0: *mut Value = II.getArgOperand(0);
    let mut Arg1: *mut Value = II.getArgOperand(1);
    let mut ResTy: *mut FixedVectorType = cast(II.getType());
    let mut ArgTy: *mut FixedVectorType = cast(Arg0.getType());
    assert!(ArgTy == ResTy && ResTy.getScalarSizeInBits() == 16, "Unexpected PMULH types");
    if isa(Arg0) || isa(Arg1) {
        return get(ResTy);
    }
    if isa(Arg0) || isa(Arg1) {
        return get(ResTy);
    }
    if !isa(Arg0) || !isa(Arg1) {
        return null;
    }
    let mut ExtTy: *mut FixedVectorType = getExtendedElementVectorType(ArgTy);
    let mut LHS: *mut Value = Builder.CreateSExt(Arg0, ExtTy, "");
    let mut RHS: *mut Value = Builder.CreateSExt(Arg1, ExtTy, "");
    let mut Mul: *mut Value = Builder.CreateMul(LHS, RHS, "", false, false);
    let mut RndEltTy: *mut IntegerType = get(ExtTy.getContext(), 18);
    let mut RndTy: *mut FixedVectorType = get(RndEltTy, ExtTy);
    Mul = Builder.CreateLShr(Mul, 14, "", false);
    Mul = Builder.CreateTrunc(Mul, RndTy, "", false, false);
    Mul = Builder.CreateAdd(Mul, get(RndTy, 1, false, false), "", false, false);
    Mul = Builder.CreateLShr(Mul, 1, "", false);
    return Builder.CreateTrunc(Mul, ResTy, "", false, false);
}

fn simplifyX86pmadd(II: *mut IntrinsicInst, Builder: *mut BuilderTy, IsPMADDWD: bool) -> *mut Value {
    let mut Arg0: *mut Value = II.getArgOperand(0);
    let mut Arg1: *mut Value = II.getArgOperand(1);
    let mut ResTy: *mut FixedVectorType = cast(II.getType());
    let mut ArgTy: *mut FixedVectorType = cast(Arg0.getType());
    let mut NumDstElts: u32 = ResTy.getNumElements();
    assert!(ArgTy.getNumElements() == (2 * NumDstElts) && ResTy.getScalarSizeInBits() == (2 * ArgTy.getScalarSizeInBits()), "Unexpected PMADD types");
    if isa(Arg0) || isa(Arg1) {
        return get(ResTy);
    }
    if isa(Arg0) || isa(Arg1) {
        return get(ResTy);
    }
    if !isa(Arg0) || !isa(Arg1) {
        return null;
    }
    let mut LoMask: SmallVector<int> = SmallVector<int> {};
    let mut HiMask: SmallVector<int> = SmallVector<int> {};
    for let mut I: u32 = 0; I != NumDstElts; I += 1 {
        LoMask.push(2 * I + 0);
        HiMask.push(2 * I + 1);
    }
    let mut LHSLo: *mut Value = Builder.CreateShuffleVector(Arg0, LoMask, "");
    let mut LHSHi: *mut Value = Builder.CreateShuffleVector(Arg0, HiMask, "");
    let mut RHSLo: *mut Value = Builder.CreateShuffleVector(Arg1, LoMask, "");
    let mut RHSHi: *mut Value = Builder.CreateShuffleVector(Arg1, HiMask, "");
    let mut LHSCast: CastOps = if IsPMADDWD { SExt } else { ZExt };
    LHSLo = Builder.CreateCast(LHSCast, LHSLo, ResTy, "", null, FMFSource {});
    LHSHi = Builder.CreateCast(LHSCast, LHSHi, ResTy, "", null, FMFSource {});
    RHSLo = Builder.CreateCast(SExt, RHSLo, ResTy, "", null, FMFSource {});
    RHSHi = Builder.CreateCast(SExt, RHSHi, ResTy, "", null, FMFSource {});
    let mut Lo: *mut Value = Builder.CreateMul(LHSLo, RHSLo, "", false, false);
    let mut Hi: *mut Value = Builder.CreateMul(LHSHi, RHSHi, "", false, false);
    return if IsPMADDWD { Builder.CreateAdd(Lo, Hi, "", false, false) } else { Builder.CreateIntrinsic(ResTy, sadd_sat, [Lo, Hi], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_2 {}, null, null }) };
}

fn simplifyX86movmsk(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut Arg: *mut Value = II.getArgOperand(0);
    let mut ResTy: *mut Type = II.getType();
    if isa(Arg) {
        return getNullValue(ResTy);
    }
    if II.getIntrinsicID() == x86_mmx_pmovmskb {
        return null;
    }
    let mut ArgTy: *mut FixedVectorType = cast(Arg.getType());
    let mut NumElts: u32 = ArgTy.getNumElements();
    let mut IntegerTy: *mut Type = Builder.getIntNTy(NumElts);
    let mut Res: *mut Value = Builder.CreateBitCast(Arg, getInteger(ArgTy), "");
    Res = Builder.CreateIsNeg(Res, "");
    Res = Builder.CreateBitCast(Res, IntegerTy, "");
    Res = Builder.CreateZExtOrTrunc(Res, ResTy, "");
    return Res;
}

fn simplifyX86addcarry(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut CarryIn: *mut Value = II.getArgOperand(0);
    let mut Op1: *mut Value = II.getArgOperand(1);
    let mut Op2: *mut Value = II.getArgOperand(2);
    let mut RetTy: *mut Type = II.getType();
    let mut OpTy: *mut Type = Op1.getType();
    assert!(RetTy.getStructElementType(0).isIntegerTy(8) && RetTy.getStructElementType(1) == OpTy && OpTy == Op2.getType(), "Unexpected types for x86 addcarry");
    if match(CarryIn, m_ZeroInt()) {
        let mut UAdd: *mut Value = Builder.CreateIntrinsic(uadd_with_overflow, OpTy, [Op1, Op2], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_3 {}, null, null });
        let mut UAddResult: *mut Value = Builder.CreateExtractValue(UAdd, 0, "");
        let mut UAddOV: *mut Value = Builder.CreateZExt(Builder.CreateExtractValue(UAdd, 1, ""), Builder.getInt8Ty(), "", false);
        let mut Res: *mut Value = get(RetTy);
        Res = Builder.CreateInsertValue(Res, UAddOV, 0, "");
        return Builder.CreateInsertValue(Res, UAddResult, 1, "");
    }
    return null;
}

fn simplifyTernarylogic(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut ArgImm: *mut ConstantInt = dyn_cast(II.getArgOperand(3));
    if !ArgImm || ArgImm.getValue().uge(256) {
        return null;
    }
    let mut ArgA: *mut Value = II.getArgOperand(0);
    let mut ArgB: *mut Value = II.getArgOperand(1);
    let mut ArgC: *mut Value = II.getArgOperand(2);
    let mut Ty: *mut Type = II.getType();
    let mut Or: Closure_4 = Closure_4 { Builder: &mut Builder };
    let mut Xor: Closure_5 = Closure_5 { Builder: &mut Builder };
    let mut And: Closure_6 = Closure_6 { Builder: &mut Builder };
    let mut Not: Closure_7 = Closure_7 { Builder: &mut Builder };
    let mut Nor: Closure_8 = Closure_8 { Not: &mut Not, Or: &mut Or };
    let mut Xnor: Closure_9 = Closure_9 { Not: &mut Not, Xor: &mut Xor };
    let mut Nand: Closure_10 = Closure_10 { Not: &mut Not, And: &mut And };
    let mut AIsConst: bool = match(ArgA, m_ImmConstant());
    let mut BIsConst: bool = match(ArgB, m_ImmConstant());
    let mut CIsConst: bool = match(ArgC, m_ImmConstant());
    let mut ABIsConst: bool = AIsConst && BIsConst;
    let mut ACIsConst: bool = AIsConst && CIsConst;
    let mut BCIsConst: bool = BIsConst && CIsConst;
    let mut ABCIsConst: bool = AIsConst && BIsConst && CIsConst;
    let mut A: pair<Value *, uint8_t> = pair<Value *, uint8_t> { ArgA, 240 };
    let mut B: pair<Value *, uint8_t> = pair<Value *, uint8_t> { ArgB, 204 };
    let mut C: pair<Value *, uint8_t> = pair<Value *, uint8_t> { ArgC, 170 };
    let mut Res: pair<Value *, uint8_t> = pair<Value *, uint8_t> { null, 0 };
    let mut Imm: u8 = ArgImm.getValue().getZExtValue();
    match Imm {
        0 => {
            Res = Value *, unsigned char> { getNullValue(Ty), 0 };
        },
        1 => {
            if ABCIsConst {
                Res = Nor.call(Or.call(A, B), C);
            }
        },
        2 => {
            if ABCIsConst {
                Res = And.call(Nor.call(A, B), C);
            }
        },
        3 => {
            if ABIsConst {
                Res = Nor.call(A, B);
            }
        },
        4 => {
            if ABCIsConst {
                Res = And.call(Nor.call(A, C), B);
            }
        },
        5 => {
            if ACIsConst {
                Res = Nor.call(A, C);
            }
        },
        6 => {
            if ABCIsConst {
                Res = Nor.call(A, Xnor.call(B, C));
            }
        },
        7 => {
            if ABCIsConst {
                Res = Nor.call(A, And.call(B, C));
            }
        },
        8 => {
            if ABCIsConst {
                Res = Nor.call(A, Nand.call(B, C));
            }
        },
        9 => {
            if ABCIsConst {
                Res = Nor.call(A, Xor.call(B, C));
            }
        },
        10 => {
            if ACIsConst {
                Res = Nor.call(A, Not.call(C));
            }
        },
        11 => {
            if ABCIsConst {
                Res = Nor.call(A, Nor.call(C, Not.call(B)));
            }
        },
        12 => {
            if ABIsConst {
                Res = Nor.call(A, Not.call(B));
            }
        },
        13 => {
            if ABCIsConst {
                Res = Nor.call(A, Nor.call(B, Not.call(C)));
            }
        },
        14 => {
            if ABCIsConst {
                Res = Nor.call(A, Nor.call(B, C));
            }
        },
        15 => {
            Res = Not.call(A);
        },
        16 => {
            if ABCIsConst {
                Res = And.call(A, Nor.call(B, C));
            }
        },
        17 => {
            if BCIsConst {
                Res = Nor.call(B, C);
            }
        },
        18 => {
            if ABCIsConst {
                Res = Nor.call(Xnor.call(A, C), B);
            }
        },
        19 => {
            if ABCIsConst {
                Res = Nor.call(And.call(A, C), B);
            }
        },
        20 => {
            if ABCIsConst {
                Res = Nor.call(Xnor.call(A, B), C);
            }
        },
        21 => {
            if ABCIsConst {
                Res = Nor.call(And.call(A, B), C);
            }
        },
        22 => {
            if ABCIsConst {
                Res = Xor.call(Xor.call(A, B), And.call(Nand.call(A, B), C));
            }
        },
        23 => {
            if ABCIsConst {
                Res = Xor.call(Or.call(A, B), Or.call(Xnor.call(A, B), C));
            }
        },
        24 => {
            if ABCIsConst {
                Res = Nor.call(Xnor.call(A, B), Xnor.call(A, C));
            }
        },
