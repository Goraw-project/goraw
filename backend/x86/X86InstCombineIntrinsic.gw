fn simplifyX86FPMaxMin(II: *IntrinsicInst, IC: *mut InstCombiner, NewIID: ID, IsScalar: bool) -> *mut Value {
    let mut Arg0: *mut Value = II.getArgOperand(0);
    let mut Arg1: *mut Value = II.getArgOperand(1);
    let mut VWidth: u32 = cast(Arg0.getType())();
    let mut SQ: SimplifyQuery = IC.getSimplifyQuery().getWithInstruction(&mut II);
    let mut DemandedElts: APInt = if IsScalar { getOneBitSet(VWidth, 0) } else { getAllOnes(VWidth) };
    let mut Forbidden0: FPClassTest = fcNan | fcInf | fcSubnormal;
    let mut Forbidden1: FPClassTest = fcNan | fcInf | fcSubnormal;
    if NewIID == maxnum {
        Forbidden1(fcNegZero);
    } else {
        assert!(NewIID == minnum, "Unknown intrinsic");
        Forbidden0(fcNegZero);
    }
    let mut KnownArg0: KnownFPClass = computeKnownFPClass(Arg0, DemandedElts, Forbidden0, SQ, 0);
    let mut KnownArg1: KnownFPClass = computeKnownFPClass(Arg1, DemandedElts, Forbidden1, SQ, 0);
    if KnownArg0.isKnownNever(Forbidden0) && KnownArg1.isKnownNever(Forbidden1) {
        if IsScalar {
            let mut Scalar0: *mut Value = IC()(Arg0, 0 as u64);
            let mut Scalar1: *mut Value = IC()(Arg1, 0 as u64);
            let mut NewScalar: *mut Value = if (NewIID == maxnum) { IC()(Scalar0, Scalar1) } else { IC()(Scalar0, Scalar1) };
            return IC()(Arg0, NewScalar, 0 as u64);
        } else {
            return if (NewIID == maxnum) { IC()(Arg0, Arg1) } else { IC()(Arg0, Arg1) };
        }
    }
    return null;
}

fn simplifyX86insertps(II: *IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut CInt: *mut auto = dyn_cast(II.getArgOperand(2));
    if operator!() {
        return null;
    }
    let mut VecTy: *mut auto = cast(II.getType());
    (((operator!(operator!((VecTy()() == 4 && "insertps with wrong vector type")))) || (_wassert(L"VecTy->getNumElements() == 4 && \"insertps with wrong vector type\"", L"llvm\\lib\\Target\\X86\\X86InstCombineIntrinsic.cpp", (1772) as u32) , 0)) as void);
    let mut Imm: u8 = ();
    let mut ZMask: u8 = Imm & 15;
    let mut DestLane: u8 = (Imm >> 4) & 3;
    let mut SourceLane: u8 = (Imm >> 6) & 3;
    let mut ZeroVector: *mut ConstantAggregateZero = get();
    if ZMask == 15 {
        return ZeroVector;
    }
    let mut ShuffleMask: [4]i32 = [0, 1, 2, 3];
    let mut V1: *mut Value = II.getArgOperand(1);
    if ZMask {
        if (II.getArgOperand(0) == II.getArgOperand(1)) || (ZMask & (1 << DestLane)) {
            V1 = ZeroVector;
            ShuffleMask[DestLane] = SourceLane;
            for let mut i: u32 = 0; i < 4; i += 1 {
                if (ZMask >> i) & 1 {
                    ShuffleMask[i] = i + 4;
                }
            }
        } else {
            return null;
        }
    } else {
        ShuffleMask[DestLane] = SourceLane + 4;
    }
    return Builder()(II.getArgOperand(0), V1, ShuffleMask);
}

fn simplifyX86extrq(II: *mut IntrinsicInst, Op0: *mut Value, CILength: *mut ConstantInt, CIIndex: *mut ConstantInt, Builder: *mut BuilderTy) -> *mut Value {
