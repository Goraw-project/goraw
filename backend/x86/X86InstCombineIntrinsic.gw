fn X86TTIImpl::simplifyDemandedUseBitsIntrinsic(self: *X86TTIImpl, IC: *mut InstCombiner, II: *mut IntrinsicInst, DemandedMask: APInt, Known: *mut KnownBits, KnownBitsComputed: *mut bool) -> optional<Value *> {
    match II.getIntrinsicID() {
        _ => {
            break;
        },
        x86_mmx_pmovmskb => {
            x86_sse_movmsk_ps;
        },
    }
    return nullopt;
}

fn X86TTIImpl::simplifyDemandedVectorEltsIntrinsic(self: *X86TTIImpl, IC: *mut InstCombiner, II: *mut IntrinsicInst, DemandedElts: APInt, UndefElts: *mut APInt, UndefElts2: *mut APInt, UndefElts3: *mut APInt, simplifyAndSetOp: function<void (Instruction *, unsigned int, APInt, APInt &)>) -> optional<Value *> {
    let mut VWidth: u32 = cast(II.getType()).getNumElements();
    match II.getIntrinsicID() {
        _ => {
            break;
        },
        x86_xop_vfrcz_ss => {
            x86_xop_vfrcz_sd;
        },
        x86_sse_rcp_ss => {
            x86_sse_rsqrt_ss;
        },
        x86_sse_min_ss => {
            x86_sse_max_ss;
        },
        x86_sse41_round_ss => {
            x86_sse41_round_sd;
        },
        x86_avx512_mask_add_ss_round => {
            x86_avx512_mask_div_ss_round;
        },
        x86_sse3_addsub_pd => {
            x86_sse3_addsub_ps;
        },
        x86_avx2_psllv_d => {
            x86_avx2_psllv_d_256;
        },
        x86_ssse3_pmul_hr_sw_128 => {
            x86_avx2_pmul_hr_sw;
        },
        x86_sse2_packssdw_128 => {
            x86_sse2_packsswb_128;
        },
        x86_sse2_pmadd_wd => {
            x86_avx2_pmadd_wd;
        },
        x86_ssse3_pshuf_b_128 => {
            x86_avx2_pshuf_b;
        },
        x86_sse4a_extrq => {
            x86_sse4a_extrqi;
        },
    }
    return nullopt;
}

