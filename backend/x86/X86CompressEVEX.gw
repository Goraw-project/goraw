fn tryCompressMaskProducer(MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, ST: *X86Subtarget, ToErase: *mut SmallVectorImpl<MachineInstr *>) -> bool {
    let mut TII: *X86InstrInfo = ST.getInstrInfo();
    let mut TRI: *TargetRegisterInfo = ST.getRegisterInfo();
    let mut MRI: *mut MachineRegisterInfo = &mut MBB.getParent().getRegInfo();
    let mut Opc: u32 = MI.getOpcode();
    let mut IsSignMaskCmp: bool = false;
    if  {
        return false;
    }
    if usesExtendedRegister(MI) {
        return false;
    }
    let mut MaskReg: Register = MI.getOperand(0).getReg();
    let mut SrcVecReg: Register = MI.getOperand(1).getReg();
    let mut ConstantDef: *mut MachineInstr = null;
    let mut ConstantDefOnlyFeedsCmp: bool = false;
    if IsSignMaskCmp {
        let mut Pred: i64 = MI.getOperand(3).getImm();
        if Pred != 5 && Pred != 6 {
            return false;
        }
        let mut ConstantReg: Register = MI.getOperand(2).getReg();
        let mut Is256Bit: bool = false;
        ConstantDef = getSignMaskConstantDef(MI, ConstantReg, Pred == 5, Is256Bit, TRI);
        if !ConstantDef {
            return false;
        }
        ConstantDefOnlyFeedsCmp = !TRI.regsOverlap(ConstantReg, SrcVecReg);
    }
    let mut MovMskOpc: u32 = 0;
    let mut BlendOpc: u32 = 0;
    match Opc {
        _ => {
            llvm_unreachable_internal("Unknown VPMOV opcode", "llvm\\lib\\Target\\X86\\X86CompressEVEX.cpp", 447);
        },
    }
    let mut KMovMI: *mut MachineInstr = null;
    let mut BlendMI: *mut MachineInstr = null;
    let mut BlendIsMaskedBlend: bool = false;
    if !KMovMI && !BlendMI {
        return false;
    }
    let mut MovMskBits: u32 = getMovMskBits(Opc);
    if IsSignMaskCmp && KMovMI {
        if KMovMI.getOperand(0).isDead() || (MovMskBits != 32 && MBB() != LQR_Dead) {
            return false;
        }
    }
    let mut NewMI: *mut MachineInstr = null;
    if KMovMI {
        let mut OldDst: MachineOperand = KMovMI.getOperand(0);
        KMovMI.setDesc(TII()(MovMskOpc));
        let mut NewSrc: *mut MachineOperand = KMovMI.getOperand(1);
        NewSrc.setReg(SrcVecReg);
        NewSrc.setIsKill(MI.getOperand(1).isKill());
        NewMI = KMovMI;
        if IsSignMaskCmp {
            let mut DstReg: Register = OldDst.getReg();
            let mut ComplementMask: i64 = getLowBitsSet(32, MovMskBits).getSExtValue();
            let mut ComplementOpc: u32 = 0;
            let mut MIB: auto = BuildMI(MBB, next(), KMovMI.getDebugLoc(), TII()(ComplementOpc), DstReg)(DstReg, Kill);
            if MovMskBits != 32 {
                MIB()(ComplementMask);
                MIB()();
            }
            MIB()(0)(OldDst.isRenamable());
        }
    } else if BlendMI {
        let mut MaskVec: *MachineOperand = MI.getOperand(1);
        let mut Dst: *MachineOperand = BlendMI.getOperand(0);
        let mut Passthru: *MachineOperand = BlendMI.getOperand(if BlendIsMaskedBlend { 2 } else { 1 });
        let mut Src: *MachineOperand = BlendMI.getOperand(3);
        let mut MIB: auto = BuildMI(MBB, *BlendMI, BlendMI.getDebugLoc(), TII()(BlendOpc))(Dst.getReg(), getRegState(Dst))(Passthru.getReg(), getRegState(Passthru))(Src.getReg(), getRegState(Src))(MaskVec.getReg(), getRegState(MaskVec));
        NewMI = ;
        ToErase()(BlendMI);
    }
    assert!(NewMI, "Expected a compressed instruction");
    NewMI.setAsmPrinterFlag(AC_EVEX_2_VEX);
    ToErase()(&mut MI);
    if ConstantDefOnlyFeedsCmp && MI.getOperand(2).isKill() {
        ToErase()(ConstantDef);
    }
    return true;
}

fn CompressEVEXImpl(MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, ST: *X86Subtarget, ToErase: *mut SmallVectorImpl<MachineInstr *>) -> bool {
    let mut TSFlags: u64 = MI.getDesc().TSFlags;
    if (TSFlags & EncodingMask) != EVEX {
        return false;
    }
    if TSFlags & (EVEX_K | EVEX_L2) {
        return false;
    }
    if hasShorterEVEXViaCDisp8(MI) {
        return false;
    }
    if tryCompressMaskProducer(MI, MBB, ST, ToErase) {
        return true;
    }
    let mut IsRedundantNewDataDest: Closure_2 = Closure_2 { MI: &mut MI, ST: &mut ST };
    let mut IsND: bool = hasNewDataDest(TSFlags);
    let mut Opc: u32 = MI.getOpcode();
    let mut IsSetZUCCm: bool = false;
    if TSFlags & EVEX_B && !IsND && !IsSetZUCCm {
        return false;
    }
    let mut IsNDLike: bool = false;
    let mut IsRedundantNDD: bool = if IsNDLike { IsRedundantNewDataDest.call(Opc) } else { false };
    let mut GetCompressedOpc: Closure_3 = Closure_3 { MI: &mut MI, ST: &mut ST };
    let mut Dst: Register = MI.getOperand(0).getReg();
    if IsRedundantNDD {
        if  {
            let mut Super: Register = Register { Reg: getX86SubSuperRegister(Dst.operator MCRegister(), 64, false) };
            if MI.definesRegister(Super, null) {
                IsRedundantNDD = false;
            }
        }
        if operator!() {
            assert!(!isAddMemInstrWithRelocation(MI), "Unexpected NDD instruction with relocation!");
        }
    } else if  {
        if !usesExtendedRegister(MI) && MI.registerDefIsDead {
            let mut Src1: Register = MI.getOperand(1).getReg();
            let mut Src2: *MachineOperand = MI.getOperand(2);
            let mut Is32BitReg: bool = false;
            let mut NewDesc: *MCInstrDesc = ST.getInstrInfo();
            if Is32BitReg {
                Src1 = Register { Reg: getX86SubSuperRegister(Src1.operator MCRegister(), 64, false) };
            }
            let mut MIB: MachineInstrBuilder = BuildMI(MBB, MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, NewDesc, Dst)(Src1)(1);
            if  {
                MIB()(0)(Src2);
            } else if Is32BitReg {
                MIB()(getX86SubSuperRegister(Src2.getReg().operator MCRegister(), 64, false))(0);
            } else {
                MIB()(Src2)(0);
            }
            MIB()(0);
            MI.removeFromParent();
            return true;
        }
    }
    let mut NewOpc: u32 = if IsRedundantNDD { getNonNDVariant(Opc) } else { (if (IsNDLike && ST()() && MI.registerDefIsDead) { getNFVariant(Opc) } else { GetCompressedOpc.call(Opc) }) };
    if !NewOpc {
        return false;
    }
    assert!((IsND || !(TSFlags & EVEX_NF)), "Unexpected to compress NF instructions without ND.");
    let mut NewDesc: *MCInstrDesc = ST.getInstrInfo()(NewOpc);
    MI.setDesc(NewDesc);
    let mut AsmComment: u32 = 0;
    match NewDesc.TSFlags & EncodingMask {
        LEGACY => {
            AsmComment = AC_EVEX_2_LEGACY;
        },
        VEX => {
            AsmComment = AC_EVEX_2_VEX;
        },
        EVEX => {
            AsmComment = AC_EVEX_2_EVEX;
        },
        _ => {
            llvm_unreachable_internal("Unknown EVEX compression", "llvm\\lib\\Target\\X86\\X86CompressEVEX.cpp", 734);
        },
    }
    MI.setAsmPrinterFlag(AsmComment);
    if IsRedundantNDD {
        MI.tieOperands(0, 1);
    }
    return true;
}

fn runOnMF(MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-compress-evex", 1) {
            dbgs() << "Start X86CompressEVEXPass\n";
        }
    }
        if !(false) { break; }
    }
    let mut TableChecked: atomic<bool> = zeroed();
    if operator!((memory_order_relaxed)) {
        (((operator!(operator!((is_sorted() && "X86CompressEVEXTable is not sorted!")))) || (_wassert(L"llvm::is_sorted(X86CompressEVEXTable) && \"X86CompressEVEXTable is not sorted!\"", L"llvm\\lib\\Target\\X86\\X86CompressEVEX.cpp", (750) as u32) , 0)) as void);
        TableChecked()(true, memory_order_relaxed);
    }
    let mut ST: *X86Subtarget = MF;
    if !ST.hasAVX512() && operator!(ST()()) && operator!(ST()()) && operator!(ST()()) {
        return false;
    }
    let mut Changed: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-compress-evex", 1) {
            dbgs() << "End X86CompressEVEXPass\n";
        }
    }
        if !(false) { break; }
    }
    return Changed;
}

fn createX86CompressEVEXLegacyPass() -> *mut FunctionPass {
    return CompressEVEXLegacy {};
}

fn CompressEVEXLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return runOnMF(MF);
}

fn X86CompressEVEXPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = runOnMF(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA;
    return PA;
}

