static mut IndirectBranchTracking: i32 = "x86-indirect-branch-tracking";

static mut NumEndBranchAdded: Statistic = Statistic { "x86-indirect-branch-tracking", "NumEndBranchAdded", "Number of ENDBR instructions added" };

struct X86IndirectBranchTrackingLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86IndirectBranchTrackingLegacy::getPassName(self: *X86IndirectBranchTrackingLegacy) -> str {
    return "X86 Indirect Branch Tracking";
}

fn X86IndirectBranchTrackingLegacy::getPassKind(self: *X86IndirectBranchTrackingLegacy) -> PassKind {
    return self.Kind;
}

fn X86IndirectBranchTrackingLegacy::getPassID(self: *X86IndirectBranchTrackingLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86IndirectBranchTrackingLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86IndirectBranchTrackingLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86IndirectBranchTrackingLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86IndirectBranchTrackingLegacy::getResolver(self: *X86IndirectBranchTrackingLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86IndirectBranchTrackingLegacy::getRequiredProperties(self: *X86IndirectBranchTrackingLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86IndirectBranchTrackingLegacy::getSetProperties(self: *X86IndirectBranchTrackingLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86IndirectBranchTrackingLegacy::getClearedProperties(self: *X86IndirectBranchTrackingLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn addENDBR(MBB: *mut MachineBasicBlock, I: iterator) -> bool {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut SubTarget: *X86Subtarget = MF;
    let mut TII: *X86InstrInfo = SubTarget.getInstrInfo();
    let mut EndbrOpcode: u32 = 0;
    assert!(TII, "Target instruction info was not initialized");
    if I == MBB.end() || operator(I).getOpcode() != EndbrOpcode {
        BuildMI(MBB, I, MBB.findDebugLoc(iterator { I }), TII()(EndbrOpcode));
        operator(NumEndBranchAdded);
        return true;
    }
    return false;
}

static mut ID: i8 = 0;

fn createX86IndirectBranchTrackingLegacyPass() -> *mut FunctionPass {
    return X86IndirectBranchTrackingLegacy {};
}

fn IsCallReturnTwice(MOp: *mut MachineOperand) -> bool {
    if !MOp.isGlobal() {
        return false;
    }
    let mut CalleeFn: *mut auto = dyn_cast(MOp.getGlobal());
    if operator!() {
        return false;
    }
    let mut Attrs: AttributeList = ();
    return Attrs.hasFnAttr(ReturnsTwice);
}

fn needsPrologueENDBR(MF: *mut MachineFunction, M: *Module) -> bool {
    let mut F: *mut Function = MF.getFunction();
    if F.doesNoCfCheck() {
        return false;
    }
    match MF.getTarget().getCodeModel() {
        Large => {
            return true;
        },
        _ => {
            return (F.hasAddressTaken(null, false, true, false, false, false) || !F.hasLocalLinkage());
        },
    }
}

fn runIndirectBranchTracking(MF: *mut MachineFunction) -> bool {
    let mut M: *Module = MF.getFunction().getParent();
    let mut isCFProtectionSupported: *mut Metadata = M.getModuleFlag("cf-protection-branch");
    let mut TM: *X86TargetMachine = null;
    let mut isJITwithCET: bool = false;
    if !isCFProtectionSupported && operator!() && !isJITwithCET {
        return false;
    }
    let mut Changed: bool = false;
    if needsPrologueENDBR(MF, M) {
        let mut MBB: iterator = MF.begin();
        Changed |= addENDBR(operator(MBB), operator(MBB).begin());
    }
    for MBB in MF {
        if MBB.isMachineBlockAddressTaken() || MBB.isIRBlockAddressTaken() {
            Changed |= addENDBR(MBB, MBB.begin());
        }
        for let mut I: iterator = MBB.begin(); I != MBB.end(); operator(I) {
            if operator(I).isCall(AnyInBundle) && operator(I).getNumOperands() > 0 && IsCallReturnTwice(operator(I).getOperand(0)) {
                operator|=(Changed, addENDBR(MBB, next(I)));
            }
        }
        if TM() == SjLj {
            for let mut I: iterator = MBB.begin(); I != MBB.end(); operator(I) {
                if MBB.isEHPad() {
                    if operator(I).isDebugInstr() {
                        continue;
                    }
                    Changed |= addENDBR(MBB, iterator { I });
                    break;
                } else if operator(I).isEHLabel() {
                    let mut Sym: *mut MCSymbol = operator(I).getOperand(0).getMCSymbol();
                    if !MF.hasCallSiteLandingPad(Sym) {
                        continue;
                    }
                    operator|=(Changed, addENDBR(MBB, next(I)));
                    break;
                }
            }
        } else if MBB.isEHPad() {
            for let mut I: iterator = MBB.begin(); I != MBB.end(); operator(I) {
                if !operator(I).isEHLabel() {
                    continue;
                }
                operator|=(Changed, addENDBR(MBB, next(I)));
                break;
            }
        }
    }
    return Changed;
}

fn X86IndirectBranchTrackingLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return runIndirectBranchTracking(MF);
}

fn X86IndirectBranchTrackingPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if runIndirectBranchTracking(MF) { getMachineFunctionPassPreservedAnalyses() } else { all() };
}
