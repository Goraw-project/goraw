        (((operator!(operator!((MOs()() == 5 && "Unexpected memory operand list length")))) || (_wassert(L"MOs.size() == 5 && \"Unexpected memory operand list length\"", L"llvm\\lib\\Target\\X86\\X86InstrInfo.cpp", (7485) as u32) , 0)) as void);
        for let mut i: u32 = 0; i != NumAddrOps; i += 1 {
            let mut MO: *MachineOperand = [i];
            if i == 3 && PtrOffset != 0 {
                MIB()(MO, PtrOffset);
            } else {
                MIB()(MO);
            }
        }
    }
}

