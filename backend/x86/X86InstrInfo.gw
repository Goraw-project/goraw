        },
        CMP32rr => {
            return CMP32ri;
        },
        CCMP32rr => {
            return CCMP32ri;
        },
        ADD64rr_ND => {
            return ADD64ri32_ND;
        },
        SUB64rr_ND => {
            return SUB64ri32_ND;
        },
    }
}

fn X86InstrInfo::foldImmediateImpl(self: *X86InstrInfo, UseMI: *mut MachineInstr, DefMI: *mut MachineInstr, Reg: Register, ImmVal: i64, MRI: *mut MachineRegisterInfo, MakeChange: bool) -> bool {
    let mut Modified: bool = false;
    let mut RC: *TargetRegisterClass = null;
    if Reg.isVirtual() {
        RC = MRI.getRegClass(Reg);
    }
    if (Reg.isPhysical() && GR64RegClass.contains(Reg.operator MCRegister())) || (Reg.isVirtual() && GR64RegClass.hasSubClassEq(RC)) {
        if !isInt(ImmVal) {
            return false;
        }
    }
    if UseMI.findRegisterUseOperand(Reg, null, false).getSubReg() {
        return false;
    }
    if UseMI.getMF().getFunction().hasOptSize() && Reg.isVirtual() && !MRI.hasOneNonDBGUse(Reg) {
        return false;
    }
    let mut Opc: u32 = UseMI.getOpcode();
    let mut NewOpc: u32 = 0;
    if Opc == COPY {
        let mut ToReg: Register = UseMI.getOperand(0).getReg();
        let mut RC: *TargetRegisterClass = null;
        if ToReg.isVirtual() {
            RC = MRI.getRegClass(ToReg);
        }
        let mut GR32Reg: bool = (ToReg.isVirtual() && GR32RegClass.hasSubClassEq(RC)) || (ToReg.isPhysical() && GR32RegClass.contains(ToReg.operator MCRegister()));
        let mut GR64Reg: bool = (ToReg.isVirtual() && GR64RegClass.hasSubClassEq(RC)) || (ToReg.isPhysical() && GR64RegClass.contains(ToReg.operator MCRegister()));
        let mut GR8Reg: bool = (ToReg.isVirtual() && GR8RegClass.hasSubClassEq(RC)) || (ToReg.isPhysical() && GR8RegClass.contains(ToReg.operator MCRegister()));
        if ImmVal == 0 {
            if !GR32Reg {
                return false;
            }
        }
        if GR64Reg {
            if isUInt(ImmVal) {
                NewOpc = MOV32ri64;
            } else {
                NewOpc = MOV64ri;
            }
        } else if GR32Reg {
            NewOpc = MOV32ri;
            if ImmVal == 0 {
                let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
                if UseMI.getParent().computeRegisterLiveness(TRI, EFLAGS, UseMI, 10) != LQR_Dead {
                    return false;
                }
                if !MakeChange {
                    return true;
                }
                UseMI.setDesc(self.get(MOV32r0));
                UseMI.removeOperand(UseMI.findRegisterUseOperandIdx(Reg, null, false));
                UseMI.addOperand(CreateReg(EFLAGS, true, true, false, true, false, false, 0, false, false, false));
                Modified = true;
            }
        } else if GR8Reg {
            NewOpc = MOV8ri;
        } else {
            return false;
        }
    } else {
        NewOpc = convertALUrr2ALUri(Opc);
    }
    if !NewOpc {
        return false;
    }
    if (NewOpc == SUB64ri32 || NewOpc == SUB32ri || NewOpc == SBB64ri32 || NewOpc == SBB32ri || NewOpc == SUB64ri32_ND || NewOpc == SUB32ri_ND || NewOpc == SBB64ri32_ND || NewOpc == SBB32ri_ND) && UseMI.findRegisterUseOperandIdx(Reg, null, false) != 2 {
        return false;
    }
    if ((NewOpc == CMP64ri32 || NewOpc == CMP32ri) || (NewOpc == CCMP64ri32 || NewOpc == CCMP32ri)) && UseMI.findRegisterUseOperandIdx(Reg, null, false) != 1 {
        return false;
    }
    if isSHL(Opc) || isSHR(Opc) || isSAR(Opc) || isROL(Opc) || isROR(Opc) || isRCL(Opc) || isRCR(Opc) {
        let mut RegIdx: u32 = UseMI.findRegisterUseOperandIdx(Reg, null, false);
        if RegIdx < 2 {
            return false;
        }
        if !isInt(ImmVal) {
            return false;
        }
        assert!(Reg == CL);
        if !MakeChange {
            return true;
        }
        UseMI.setDesc(self.get(NewOpc));
        UseMI.removeOperand(RegIdx);
        UseMI.addOperand(CreateImm(ImmVal));
        return true;
    }
    if !MakeChange {
        return true;
    }
    if !Modified {
        if ImmVal == 0 && canConvert2Copy(NewOpc) && UseMI.registerDefIsDead(EFLAGS, null) {
            UseMI.setDesc(self.get(COPY));
            UseMI.removeOperand(UseMI.findRegisterUseOperandIdx(Reg, null, false));
            UseMI.removeOperand(UseMI.findRegisterDefOperandIdx(EFLAGS, null, false, false));
            UseMI.untieRegOperand(0);
            UseMI.clearFlag(NoSWrap);
            UseMI.clearFlag(NoUWrap);
        } else {
            let mut Op1: u32 = 1;
            let mut Op2: u32 = CommuteAnyOperandIndex;
            let mut ImmOpNum: u32 = 2;
            if !UseMI.getOperand(0).isDef() {
                Op1 = 0;
                ImmOpNum = 1;
            }
            if Opc == COPY {
                ImmOpNum = 1;
            }
            if self.findCommutedOpIndices(UseMI, Op1, Op2) && UseMI.getOperand(Op1).getReg() == Reg {
                self.commuteInstruction(UseMI, false, CommuteAnyOperandIndex, CommuteAnyOperandIndex);
            }
            assert!(UseMI.getOperand(ImmOpNum).getReg() == Reg);
            UseMI.setDesc(self.get(NewOpc));
            UseMI.getOperand(ImmOpNum).ChangeToImmediate(ImmVal, 0);
        }
    }
    if Reg.isVirtual() && MRI.use_nodbg_empty(Reg) {
        DefMI.eraseFromBundle();
    }
    return true;
}

fn X86InstrInfo::foldImmediate(self: *X86InstrInfo, UseMI: *mut MachineInstr, DefMI: *mut MachineInstr, Reg: Register, MRI: *mut MachineRegisterInfo) -> bool {
    let mut ImmVal: i64 = 0;
    if !self.getConstValDefinedInReg(DefMI, Reg, ImmVal) {
        return false;
    }
    return self.foldImmediateImpl(UseMI, &mut DefMI, Reg, ImmVal, MRI, true);
}

fn Expand2AddrUndef(MIB: *mut MachineInstrBuilder, Desc: *MCInstrDesc) -> bool {
    assert!(Desc.getNumOperands() == 3, "Expected two-addr instruction.");
    let mut Reg: Register = MIB.getReg(0);
    operator(MIB).setDesc(Desc);
    MIB.addReg(Reg, Undef, 0).addReg(Reg, Undef, 0);
    assert!(MIB.getReg(1) == Reg && MIB.getReg(2) == Reg, "Misplaced operand");
    return true;
}

fn Expand2AddrKreg(MIB: *mut MachineInstrBuilder, Desc: *MCInstrDesc, Reg: Register) -> bool {
    assert!(Desc.getNumOperands() == 3, "Expected two-addr instruction.");
    operator(MIB).setDesc(Desc);
    MIB.addReg(Reg, Undef, 0).addReg(Reg, Undef, 0);
    return true;
}

fn expandMOV32r1(MIB: *mut MachineInstrBuilder, TII: *TargetInstrInfo, MinusOne: bool) -> bool {
    let mut MBB: *mut MachineBasicBlock = *operator(MIB).getParent();
    let mut DL: *DebugLoc = operator(MIB).getDebugLoc();
    let mut Reg: Register = MIB.getReg(0);
    BuildMI(MBB, MIB.getInstr(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(XOR32rr), Reg).addReg(Reg, Undef, 0).addReg(Reg, Undef, 0);
    operator(MIB).setDesc(TII.get(if MinusOne { DEC32r } else { INC32r }));
    MIB.addReg(Reg, RegState {}, 0);
    return true;
}

fn ExpandMOVImmSExti8(MIB: *mut MachineInstrBuilder, TII: *TargetInstrInfo, Subtarget: *X86Subtarget) -> bool {
    let mut MBB: *mut MachineBasicBlock = *operator(MIB).getParent();
    let mut DL: *DebugLoc = operator(MIB).getDebugLoc();
    let mut Imm: i64 = operator(MIB).getOperand(1).getImm();
    assert!(Imm != 0, "Using push/pop for 0 is not efficient.");
    let mut I: iterator = MIB.getInstr();
    let mut StackAdjustment: i32 = 0;
    if Subtarget.is64Bit() {
        assert!(operator(MIB).getOpcode() == MOV64ImmSExti8 || operator(MIB).getOpcode() == MOV32ImmSExti8);
        let mut X86FI: *mut X86MachineFunctionInfo = MBB.getParent().getInfo();
        if X86FI.getUsesRedZone() {
            operator(MIB).setDesc(TII.get(if operator(MIB).getOpcode() == MOV32ImmSExti8 { MOV32ri } else { MOV64ri }));
            return true;
        }
        StackAdjustment = 8;
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(PUSH64i32)).addImm(Imm);
        operator(MIB).setDesc(TII.get(POP64r));
        operator(MIB).getOperand(0).setReg(getX86SubSuperRegister(MIB.getReg(0).operator MCRegister(), 64, false));
    } else {
        assert!(operator(MIB).getOpcode() == MOV32ImmSExti8);
        StackAdjustment = 4;
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(PUSH32i)).addImm(Imm);
        operator(MIB).setDesc(TII.get(POP32r));
    }
    operator(MIB).removeOperand(1);
    operator(MIB).addImplicitDefUseOperands(*MBB.getParent());
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut TFL: *X86FrameLowering = Subtarget.getFrameLowering();
    let mut IsWin64Prologue: bool = MF.getTarget().getMCAsmInfo().usesWindowsCFI();
    let mut NeedsDwarfCFI: bool = !IsWin64Prologue && MF.needsFrameMoves();
    let mut EmitCFI: bool = !TFL.hasFP(MF) && NeedsDwarfCFI;
    if EmitCFI {
        TFL.BuildCFI(MBB, I, DL, createAdjustCfaOffset(null, StackAdjustment, SMLoc {}), NoFlags);
        TFL.BuildCFI(MBB, next(I, 1), DL, createAdjustCfaOffset(null, -StackAdjustment, SMLoc {}), NoFlags);
    }
    return true;
}

fn expandLoadStackGuard(MIB: *mut MachineInstrBuilder, TII: *TargetInstrInfo) {
    let mut MBB: *mut MachineBasicBlock = *operator(MIB).getParent();
    let mut DL: *DebugLoc = operator(MIB).getDebugLoc();
    let mut Reg: Register = MIB.getReg(0);
    let mut GV: *GlobalValue = cast((*operator(MIB).memoperands_begin()).getValue());
    let mut Flags: Flags = MOLoad | MODereferenceable | MOInvariant;
    let mut MMO: *mut MachineMemOperand = MBB.getParent().getMachineMemOperand(getGOT(*MBB.getParent()), Flags, 8, 8, MMOMetadata {}, System, NotAtomic, NotAtomic);
    let mut I: iterator = MIB.getInstr();
    BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOV64rm), Reg).addReg(RIP, RegState {}, 0).addImm(1).addReg(0, RegState {}, 0).addGlobalAddress(GV, 0, MO_GOTPCREL).addReg(0, RegState {}, 0).addMemOperand(MMO);
    operator(MIB).setDebugLoc(DL);
    operator(MIB).setDesc(TII.get(MOV64rm));
    MIB.addReg(Reg, Kill, 0).addImm(1).addReg(0, RegState {}, 0).addImm(0).addReg(0, RegState {}, 0);
}

fn expandXorFP(MIB: *mut MachineInstrBuilder, TII: *TargetInstrInfo) -> bool {
    let mut MBB: *mut MachineBasicBlock = *operator(MIB).getParent();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut Subtarget: *X86Subtarget = MF.getSubtarget();
    let mut TRI: *X86RegisterInfo = Subtarget.getRegisterInfo();
    let mut XorOp: u32 = if operator(MIB).getOpcode() == XOR64_FP { XOR64rr } else { XOR32rr };
    operator(MIB).setDesc(TII.get(XorOp));
    MIB.addReg(TRI.getFrameRegister(MF), Undef, 0);
    return true;
}

fn expandNOVLXLoad(MIB: *mut MachineInstrBuilder, TRI: *TargetRegisterInfo, LoadDesc: *MCInstrDesc, BroadcastDesc: *MCInstrDesc, SubIdx: u32) -> bool {
    let mut DestReg: Register = MIB.getReg(0);
    if TRI.getEncodingValue(DestReg.operator MCRegister()) < 16 {
        operator(MIB).setDesc(LoadDesc);
    } else {
        operator(MIB).setDesc(BroadcastDesc);
        DestReg = TRI.getMatchingSuperReg(DestReg.operator MCRegister(), SubIdx, &mut VR512RegClass);
        operator(MIB).getOperand(0).setReg(DestReg);
    }
    return true;
}

fn expandNOVLXStore(MIB: *mut MachineInstrBuilder, TRI: *TargetRegisterInfo, StoreDesc: *MCInstrDesc, ExtractDesc: *MCInstrDesc, SubIdx: u32) -> bool {
    let mut SrcReg: Register = MIB.getReg(AddrNumOperands);
    if TRI.getEncodingValue(SrcReg.operator MCRegister()) < 16 {
        operator(MIB).setDesc(StoreDesc);
    } else {
        operator(MIB).setDesc(ExtractDesc);
        SrcReg = TRI.getMatchingSuperReg(SrcReg.operator MCRegister(), SubIdx, &mut VR512RegClass);
        operator(MIB).getOperand(AddrNumOperands).setReg(SrcReg);
        MIB.addImm(0);
    }
    return true;
}

fn expandSHXDROT(MIB: *mut MachineInstrBuilder, Desc: *MCInstrDesc) -> bool {
    operator(MIB).setDesc(Desc);
    let mut ShiftAmt: i64 = operator(MIB).getOperand(2).getImm();
    operator(MIB).removeOperand(2);
    MIB.addReg(MIB.getReg(1), getUndefRegState(operator(MIB).getOperand(1).isUndef()), 0);
    MIB.addImm(ShiftAmt);
    return true;
}

fn expandMOVSHP(MIB: *mut MachineInstrBuilder, MI: *mut MachineInstr, TII: *TargetInstrInfo, HasAVX: bool) -> bool {
    let mut NewOpc: u32 = 0;
    if MI.getOpcode() == MOVSHPrm {
        NewOpc = if HasAVX { VMOVSSrm } else { MOVSSrm };
        let mut Reg: Register = MI.getOperand(0).getReg();
        if Reg.operator unsigned int() > XMM15 {
            NewOpc = VMOVSSZrm;
        }
    } else {
        NewOpc = if HasAVX { VMOVSSmr } else { MOVSSmr };
        let mut Reg: Register = MI.getOperand(5).getReg();
        if Reg.operator unsigned int() > XMM15 {
            NewOpc = VMOVSSZmr;
        }
    }
    operator(MIB).setDesc(TII.get(NewOpc));
    return true;
}

fn X86InstrInfo::expandPostRAPseudo(self: *X86InstrInfo, MI: *mut MachineInstr) -> bool {
    let mut HasAVX: bool = self.Subtarget.hasAVX();
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder { MF: *MI.getParent().getParent(), MI: MI };
    match MI.getOpcode() {
        MOV32r0 => {
            return Expand2AddrUndef(MIB, self.get(XOR32rr));
        },
        MOV32r1 => {
            return expandMOV32r1(MIB, *self, false);
        },
        MOV32r_1 => {
            return expandMOV32r1(MIB, *self, true);
        },
        MOV32ImmSExti8 => {
            MOV64ImmSExti8;
        },
        SETB_C32r => {
            return Expand2AddrUndef(MIB, self.get(SBB32rr));
        },
        SETB_C64r => {
            return Expand2AddrUndef(MIB, self.get(SBB64rr));
        },
        MMX_SET0 => {
            return Expand2AddrUndef(MIB, self.get(MMX_PXORrr));
        },
        V_SET0 => {
            FsFLD0SS;
        },
        AVX512_128_SET0 => {
            AVX512_FsFLD0SH;
        },
        MOVSHPmr => {
            MOVSHPrm;
        },
        V_SETALLONES => {
            return Expand2AddrUndef(MIB, self.get(if HasAVX { VPCMPEQDrr } else { PCMPEQDrr }));
        },
        AVX2_SETALLONES => {
            return Expand2AddrUndef(MIB, self.get(VPCMPEQDYrr));
        },
        AVX1_SETALLONES => {
            let mut Reg: Register = MIB.getReg(0);
            operator(MIB).setDesc(self.get(VCMPPSYrri));
            MIB.addReg(Reg, Undef, 0).addReg(Reg, Undef, 0).addImm(15);
            return true;
        },
        AVX512_128_SETALLONES => {
            AVX512_256_SETALLONES;
        },
        AVX512_512_SEXT_MASK_32 => {
            AVX512_512_SEXT_MASK_64;
        },
        VMOVAPSZ128rm_NOVLX => {
            return expandNOVLXLoad(MIB, &mut self.getRegisterInfo(), self.get(VMOVAPSrm), self.get(VBROADCASTF32X4Zrm), sub_xmm);
        },
        VMOVUPSZ128rm_NOVLX => {
            return expandNOVLXLoad(MIB, &mut self.getRegisterInfo(), self.get(VMOVUPSrm), self.get(VBROADCASTF32X4Zrm), sub_xmm);
        },
        VMOVAPSZ256rm_NOVLX => {
            return expandNOVLXLoad(MIB, &mut self.getRegisterInfo(), self.get(VMOVAPSYrm), self.get(VBROADCASTF64X4Zrm), sub_ymm);
        },
        VMOVUPSZ256rm_NOVLX => {
            return expandNOVLXLoad(MIB, &mut self.getRegisterInfo(), self.get(VMOVUPSYrm), self.get(VBROADCASTF64X4Zrm), sub_ymm);
        },
        VMOVAPSZ128mr_NOVLX => {
            return expandNOVLXStore(MIB, &mut self.getRegisterInfo(), self.get(VMOVAPSmr), self.get(VEXTRACTF32X4Zmri), sub_xmm);
        },
        VMOVUPSZ128mr_NOVLX => {
            return expandNOVLXStore(MIB, &mut self.getRegisterInfo(), self.get(VMOVUPSmr), self.get(VEXTRACTF32X4Zmri), sub_xmm);
        },
        VMOVAPSZ256mr_NOVLX => {
            return expandNOVLXStore(MIB, &mut self.getRegisterInfo(), self.get(VMOVAPSYmr), self.get(VEXTRACTF64X4Zmri), sub_ymm);
        },
        VMOVUPSZ256mr_NOVLX => {
            return expandNOVLXStore(MIB, &mut self.getRegisterInfo(), self.get(VMOVUPSYmr), self.get(VEXTRACTF64X4Zmri), sub_ymm);
        },
        MOV32ri64 => {
            let mut Reg: Register = MIB.getReg(0);
            let mut Reg32: Register = self.RI.getSubReg(Reg.operator MCRegister(), sub_32bit);
            MI.setDesc(self.get(MOV32ri));
            operator(MIB).getOperand(0).setReg(Reg32);
            MIB.addReg(Reg, ImplicitDefine, 0);
            return true;
        },
        RDFLAGS32 => {
            RDFLAGS64;
        },
        WRFLAGS32 => {
            WRFLAGS64;
        },
        KSET0B => {
            return Expand2AddrKreg(MIB, self.get(KXORBkk), K0);
        },
        KSET0W => {
            return Expand2AddrKreg(MIB, self.get(KXORWkk), K0);
        },
        KSET0D => {
            return Expand2AddrKreg(MIB, self.get(KXORDkk), K0);
        },
        KSET0Q => {
            return Expand2AddrKreg(MIB, self.get(KXORQkk), K0);
        },
        KSET1B => {
            return Expand2AddrKreg(MIB, self.get(KXNORBkk), K0);
        },
        KSET1W => {
            return Expand2AddrKreg(MIB, self.get(KXNORWkk), K0);
        },
        KSET1D => {
            return Expand2AddrKreg(MIB, self.get(KXNORDkk), K0);
        },
        KSET1Q => {
            return Expand2AddrKreg(MIB, self.get(KXNORQkk), K0);
        },
        LOAD_STACK_GUARD => {
            expandLoadStackGuard(MIB, *self);
        },
        XOR64_FP => {
            XOR32_FP;
        },
        SHLDROT32ri => {
            return expandSHXDROT(MIB, self.get(SHLD32rri8));
        },
        SHLDROT64ri => {
            return expandSHXDROT(MIB, self.get(SHLD64rri8));
        },
        SHRDROT32ri => {
            return expandSHXDROT(MIB, self.get(SHRD32rri8));
        },
        SHRDROT64ri => {
            return expandSHXDROT(MIB, self.get(SHRD64rri8));
        },
        ADD8rr_DB => {
            operator(MIB).setDesc(self.get(OR8rr));
        },
        ADD16rr_DB => {
            operator(MIB).setDesc(self.get(OR16rr));
        },
        ADD32rr_DB => {
            operator(MIB).setDesc(self.get(OR32rr));
        },
        ADD64rr_DB => {
            operator(MIB).setDesc(self.get(OR64rr));
        },
        ADD8ri_DB => {
            operator(MIB).setDesc(self.get(OR8ri));
        },
        ADD16ri_DB => {
            operator(MIB).setDesc(self.get(OR16ri));
        },
        ADD32ri_DB => {
            operator(MIB).setDesc(self.get(OR32ri));
        },
        ADD64ri32_DB => {
            operator(MIB).setDesc(self.get(OR64ri32));
        },
    }
    return false;
}

fn hasPartialRegUpdate(Opcode: u32, Subtarget: *X86Subtarget, ForLoadFold: bool) -> bool {
    match Opcode {
        CVTSI2SSrr => {
            CVTSI2SSrm;
        },
        CVTSD2SSrr => {
            CVTSD2SSrm;
        },
        VFCMULCPHZ128rm => {
            VFCMULCPHZ128rmb;
        },
        VPERMDYrm => {
            VPERMDYrr;
        },
        VRANGEPDZ128rmbi => {
            VRANGEPDZ128rmbikz;
        },
        VGETMANTSSZrmi => {
            VGETMANTSSZrmikz;
        },
        VPMULLQZ128rm => {
            VPMULLQZ128rmb;
        },
        VPCOMPRESSBZ128rrkz => {
            VPCOMPRESSBZ256rrkz;
        },
        VPEXPANDBZ128rmkz => {
            VPEXPANDBZ128rrkz;
        },
        POPCNT32rm => {
            POPCNT32rr;
        },
        LZCNT32rm => {
            LZCNT32rr;
        },
        TZCNT32rm => {
            TZCNT32rr;
        },
        BLSR32rr => {
            BLSR32rm;
        },
    }
    return false;
}

fn X86InstrInfo::getPartialRegUpdateClearance(self: *X86InstrInfo, MI: *MachineInstr, OpNum: u32, TRI: *TargetRegisterInfo) -> u32 {
    if OpNum != 0 {
        return 0;
    }
    let mut HasNDDPartialWrite: bool = false;
    if hasNewDataDest(MI.getDesc().TSFlags) {
        let mut Reg: Register = MI.getOperand(0).getReg();
        if !Reg.isVirtual() {
            HasNDDPartialWrite = GR8RegClass.contains(Reg.operator MCRegister()) || GR16RegClass.contains(Reg.operator MCRegister());
        }
    }
    if !(HasNDDPartialWrite || hasPartialRegUpdate(MI.getOpcode(), self.Subtarget, false)) {
        return 0;
    }
    let mut MO: *MachineOperand = MI.getOperand(0);
    let mut Reg: Register = MO.getReg();
    let mut ReadsReg: bool = false;
    if Reg.isVirtual() {
        ReadsReg = (MO.readsReg() || MI.readsVirtualRegister(Reg));
    } else {
        ReadsReg = MI.readsRegister(Reg, TRI);
    }
    if ReadsReg != HasNDDPartialWrite {
        return 0;
    }
    return PartialRegUpdateClearance.operator unsigned int();
}

fn hasUndefRegUpdate(Opcode: u32, OpNum: u32, ForLoadFold: bool) -> bool {
    match Opcode {
        MMX_PUNPCKHBWrr => {
            MMX_PUNPCKHWDrr;
        },
        VMOVLHPSrr => {
            VMOVLHPSZrr;
        },
        VCVTSI2SSrr => {
            VCVTSI2SSrm;
        },
        VCVTSD2SSrr => {
            VCVTSD2SSrm;
        },
        VMOVSSZrrk => {
            VMOVSDZrrk;
        },
        VMOVSSZrrkz => {
            VMOVSDZrrkz;
        },
    }
    return false;
}

fn X86InstrInfo::getUndefRegClearance(self: *X86InstrInfo, MI: *MachineInstr, OpNum: u32, TRI: *TargetRegisterInfo) -> u32 {
    let mut MO: *MachineOperand = MI.getOperand(OpNum);
    if MO.getReg().isPhysical() && hasUndefRegUpdate(MI.getOpcode(), OpNum, false) {
        return UndefRegClearance.operator unsigned int();
    }
    return 0;
}

fn X86InstrInfo::breakPartialRegDependency(self: *X86InstrInfo, MI: *mut MachineInstr, OpNum: u32, TRI: *TargetRegisterInfo) {
    let mut Reg: Register = MI.getOperand(OpNum).getReg();
    if MI.killsRegister(Reg, TRI) {
        return;
    }
    if VR128RegClass.contains(Reg.operator MCRegister()) {
        let mut Opc: u32 = if self.Subtarget.hasAVX() { VXORPSrr } else { XORPSrr };
        BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc), Reg).addReg(Reg, Undef, 0).addReg(Reg, Undef, 0);
        MI.addRegisterKilled(Reg, TRI, true);
    } else if VR256RegClass.contains(Reg.operator MCRegister()) {
        let mut XReg: Register = TRI.getSubReg(Reg.operator MCRegister(), sub_xmm);
        BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(VXORPSrr), XReg).addReg(XReg, Undef, 0).addReg(XReg, Undef, 0).addReg(Reg, ImplicitDefine, 0);
        MI.addRegisterKilled(Reg, TRI, true);
    } else if VR128XRegClass.contains(Reg.operator MCRegister()) {
        if !self.Subtarget.hasVLX() {
            return;
        }
        BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(VPXORDZ128rr), Reg).addReg(Reg, Undef, 0).addReg(Reg, Undef, 0);
        MI.addRegisterKilled(Reg, TRI, true);
    } else if VR256XRegClass.contains(Reg.operator MCRegister()) || VR512RegClass.contains(Reg.operator MCRegister()) {
        if !self.Subtarget.hasVLX() {
            return;
        }
        let mut XReg: Register = TRI.getSubReg(Reg.operator MCRegister(), sub_xmm);
        BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(VPXORDZ128rr), XReg).addReg(XReg, Undef, 0).addReg(XReg, Undef, 0).addReg(Reg, ImplicitDefine, 0);
        MI.addRegisterKilled(Reg, TRI, true);
    } else if GR64RegClass.contains(Reg.operator MCRegister()) {
        let mut XReg: Register = TRI.getSubReg(Reg.operator MCRegister(), sub_32bit);
        BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(XOR32rr), XReg).addReg(XReg, Undef, 0).addReg(XReg, Undef, 0).addReg(Reg, ImplicitDefine, 0);
        MI.addRegisterKilled(Reg, TRI, true);
    } else if GR32RegClass.contains(Reg.operator MCRegister()) {
        BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(XOR32rr), Reg).addReg(Reg, Undef, 0).addReg(Reg, Undef, 0);
        MI.addRegisterKilled(Reg, TRI, true);
    } else if (GR16RegClass.contains(Reg.operator MCRegister()) || GR8RegClass.contains(Reg.operator MCRegister())) && hasNewDataDest(MI.getDesc().TSFlags) {
        let mut SuperReg: Register = getX86SubSuperRegister(Reg.operator MCRegister(), 64, false);
        let mut BuildMI: MachineInstrBuilder = MachineInstrBuilder { MF: *MI.getParent().getParent(), MI: &mut MI };
        if !MI.definesRegister(SuperReg, null) {
            BuildMI.addReg(SuperReg, ImplicitDefine, 0);
        }
    }
}

fn addOperands(MIB: *mut MachineInstrBuilder, MOs: ArrayRef<MachineOperand>, PtrOffset: i32) {
    let mut NumAddrOps: u32 = MOs.len;
    if NumAddrOps < 4 {
        for let mut i: u32 = 0; i != NumAddrOps; i += 1 {
            MIB.add(MOs[i]);
        }
        addOffset(MIB, PtrOffset);
    } else {
        assert!(MOs.len == 5, "Unexpected memory operand list length");
        for let mut i: u32 = 0; i != NumAddrOps; i += 1 {
            let mut MO: *MachineOperand = MOs[i];
            if i == 3 && PtrOffset != 0 {
                MIB.addDisp(MO, PtrOffset, 0);
            } else {
                MIB.add(MO);
            }
        }
    }
}

fn updateOperandRegConstraints(MF: *mut MachineFunction, NewMI: *mut MachineInstr, TII: *TargetInstrInfo) {
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    for Idx in seq(0, NewMI.getNumOperands()) {
        let mut MO: *mut MachineOperand = NewMI.getOperand(Idx);
        if !MO.isReg() {
            continue;
        }
        let mut Reg: Register = MO.getReg();
        if !Reg.isVirtual() {
            continue;
        }
        let mut NewRC: *TargetRegisterClass = MRI.constrainRegClass(Reg, TII.getRegClass(NewMI.getDesc(), Idx), 0);
        if !NewRC {
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-instr-info", 1) {
                    dbgs() << "WARNING: Unable to update register constraint for operand " << Idx << " of instruction:\n";
                    NewMI.dump();
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
        }
    }
}

fn fuseTwoAddrInst(MF: *mut MachineFunction, Opcode: u32, MOs: ArrayRef<MachineOperand>, InsertPt: iterator, MI: *mut MachineInstr, TII: *TargetInstrInfo) -> *mut MachineInstr {
    let mut NewMI: *mut MachineInstr = MF.CreateMachineInstr(TII.get(Opcode), MI.getDebugLoc(), true);
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder { MF: MF, MI: NewMI };
    addOperands(MIB, MOs, 0);
    let mut NumOps: u32 = MI.getDesc().getNumOperands() - 2;
    for let mut i: u32 = 0; i != NumOps; i += 1 {
        let mut MO: *mut MachineOperand = MI.getOperand(i + 2);
        MIB.add(MO);
    }
    for MO in drop_begin(MI.operands(), NumOps + 2) {
        MIB.add(MO);
    }
    updateOperandRegConstraints(MF, *NewMI, TII);
    let mut MBB: *mut MachineBasicBlock = operator(InsertPt).getParent();
    MBB.insert(InsertPt, NewMI);
    return MIB.operator llvm::MachineInstr *();
}

fn fuseInst(MF: *mut MachineFunction, Opcode: u32, OpNo: u32, MOs: ArrayRef<MachineOperand>, InsertPt: iterator, MI: *mut MachineInstr, TII: *TargetInstrInfo, PtrOffset: i32) -> *mut MachineInstr {
    let mut NewMI: *mut MachineInstr = MF.CreateMachineInstr(TII.get(Opcode), MI.getDebugLoc(), true);
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder { MF: MF, MI: NewMI };
    for let mut i: u32 = 0;
let mut e: u32 = MI.getNumOperands(); i != e; i += 1 {
        let mut MO: *mut MachineOperand = MI.getOperand(i);
        if i == OpNo {
            assert!(MO.isReg(), "Expected to fold into reg operand!");
            addOperands(MIB, MOs, PtrOffset);
        } else {
            MIB.add(MO);
        }
    }
    updateOperandRegConstraints(MF, *NewMI, TII);
    if MI.getFlag(NoFPExcept) {
        NewMI.setFlag(NoFPExcept);
    }
    let mut MBB: *mut MachineBasicBlock = operator(InsertPt).getParent();
    MBB.insert(InsertPt, NewMI);
    return MIB.operator llvm::MachineInstr *();
}

fn makeM0Inst(TII: *TargetInstrInfo, Opcode: u32, MOs: ArrayRef<MachineOperand>, InsertPt: iterator, MI: *mut MachineInstr) -> *mut MachineInstr {
    let mut MIB: MachineInstrBuilder = BuildMI(*operator(InsertPt).getParent(), InsertPt, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Opcode));
    addOperands(MIB, MOs, 0);
    return MIB.addImm(0).operator llvm::MachineInstr *();
}

fn X86InstrInfo::foldMemoryOperandCustom(self: *X86InstrInfo, MF: *mut MachineFunction, MI: *mut MachineInstr, OpNum: u32, MOs: ArrayRef<MachineOperand>, InsertPt: iterator, Size: u32, Alignment: Align) -> *mut MachineInstr {
    match MI.getOpcode() {
        INSERTPSrri => {
            VINSERTPSrri;
        },
        MOVHLPSrr => {
            VMOVHLPSrr;
        },
        UNPCKLPDrr => {
            if OpNum == 2 {
                let mut TRI: *TargetRegisterInfo = *MF.getSubtarget().getRegisterInfo();
                let mut RC: *TargetRegisterClass = self.getRegClass(MI.getDesc(), OpNum);
                let mut RCSize: u32 = TRI.getRegSizeInBits(*RC).operator unsigned long long() / 8;
                if (Size == 0 || Size >= 16) && RCSize >= 16 && Alignment < 16 {
                    let mut NewMI: *mut MachineInstr = fuseInst(MF, MOVHPDrm, OpNum, MOs, InsertPt, MI, *self, 0);
                    return NewMI;
                }
            }
        },
        MOV32r0 => {
            if makeM0Inst(*self, if (Size == 4) { MOV32mi } else { MOV64mi32 }, MOs, InsertPt, MI) {
                NewMI;
            } else {
                return NewMI;
            }
        },
    }
    return null;
}

fn shouldPreventUndefRegUpdateMemFold(MF: *mut MachineFunction, MI: *mut MachineInstr) -> bool {
    if !hasUndefRegUpdate(MI.getOpcode(), 1, true) || !MI.getOperand(1).isReg() {
        return false;
    }
    if MI.getOperand(1).isUndef() {
        return true;
    }
    let mut RegInfo: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut VRegDef: *mut MachineInstr = RegInfo.getUniqueVRegDef(MI.getOperand(1).getReg());
    return VRegDef && VRegDef.isImplicitDef();
}

fn X86InstrInfo::commuteOperandsForFold(self: *X86InstrInfo, MI: *mut MachineInstr, Idx1: u32) -> u32 {
    let mut Idx2: u32 = CommuteAnyOperandIndex;
    if !self.findCommutedOpIndices(MI, Idx1, Idx2) {
        return Idx1;
    }
    let mut HasDef: bool = MI.getDesc().getNumDefs();
    let mut Reg0: Register = if HasDef { MI.getOperand(0).getReg() } else { Register { Reg: 0 } };
    let mut Reg1: Register = MI.getOperand(Idx1).getReg();
    let mut Reg2: Register = MI.getOperand(Idx2).getReg();
    let mut Tied1: bool = 0 == MI.getDesc().getOperandConstraint(Idx1, TIED_TO);
    let mut Tied2: bool = 0 == MI.getDesc().getOperandConstraint(Idx2, TIED_TO);
    if (HasDef && Reg0 == Reg1 && Tied1) || (HasDef && Reg0 == Reg2 && Tied2) {
        return Idx1;
    }
    return if self.commuteInstruction(MI, false, Idx1, Idx2) { Idx2 } else { Idx1 };
}

fn printFailMsgforFold(MI: *MachineInstr, Idx: u32) {
    if PrintFailedFusing && !MI.isCopy() {
        dbgs() << "We failed to fuse operand " << Idx << " in " << MI;
    }
}

fn X86InstrInfo::foldMemoryOperandImpl(self: *X86InstrInfo, MF: *mut MachineFunction, MI: *mut MachineInstr, OpNum: u32, MOs: ArrayRef<MachineOperand>, InsertPt: iterator, Size: u32, Alignment: Align, AllowCommute: bool, CopyMI: *mut *mut MachineInstr, VRM: *mut VirtRegMap) -> *mut MachineInstr {
    let mut isSlowTwoMemOps: bool = self.Subtarget.slowTwoMemOps();
    let mut isSlowIndirectCall: bool = self.Subtarget.slowIndirectCall();
    let mut Opc: u32 = MI.getOpcode();
    if (isSlowTwoMemOps || isSlowIndirectCall) && !MF.getFunction().hasMinSize() && (Opc == CALL32r || Opc == CALL64r || Opc == CALL64r_ImpCall) {
        return null;
    }
    if isSlowTwoMemOps && !MF.getFunction().hasMinSize() && (Opc == PUSH16r || Opc == PUSH32r || Opc == PUSH64r) {
        return null;
    }
    if !MF.getFunction().hasOptSize() && (hasPartialRegUpdate(Opc, self.Subtarget, true) || shouldPreventUndefRegUpdateMemFold(MF, MI)) {
        return null;
    }
    let mut NumOps: u32 = MI.getDesc().getNumOperands();
    let mut IsTwoAddr: bool = NumOps > 1 && OpNum < 2 && MI.getOperand(0).isReg() && MI.getOperand(1).isReg() && MI.getOperand(0).getReg() == MI.getOperand(1).getReg();
    if Opc == ADD32ri && MI.getOperand(2).getTargetFlags() == MO_GOT_ABSOLUTE_ADDRESS {
        return null;
    }
    if MOs.len == AddrNumOperands && MOs[AddrDisp].getTargetFlags() == MO_GOTTPOFF && Opc != ADD64rr {
        return null;
    }
    if MI.isCall(AnyInBundle) && MI.getCFIType() {
        return null;
    }
    if self.foldMemoryOperandCustom(MF, MI, OpNum, MOs, InsertPt, Size, Alignment) {
        CustomMI;
    } else {
        return CustomMI;
    }
    let mut NonNDOpc: u32 = if self.Subtarget.hasNDD() { getNonNDVariant(Opc) } else { 0 };
    let mut NoNDDM: bool = NonNDOpc && !self.Subtarget.hasNDDM();
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    if NoNDDM && !IsTwoAddr && !MRI.isSSA() {
        if MI.getOperand(0).getSubReg() {
            return null;
        }
        let mut Dst: Register = MI.getOperand(0).getReg();
        if VRM && Dst != MI.getOperand(1).getReg() && (!Dst.isVirtual() || VRM.getPhys(Dst).operator unsigned int()) {
            return null;
        }
    }
    let mut I: *X86FoldTableEntry = if IsTwoAddr { lookupTwoAddrFoldTable(if NonNDOpc { NonNDOpc } else { Opc }) } else { lookupFoldTable(if NoNDDM { NonNDOpc } else { Opc }, OpNum) };
    let mut NewMI: *mut MachineInstr = null;
    if I {
        let mut Opcode: u32 = I.DstOp;
        if Alignment < 1 << ((I.Flags & TB_ALIGN_MASK) >> TB_ALIGN_SHIFT) {
            return null;
        }
        let mut NarrowToMOV32rm: bool = false;
        if Size {
            let mut TRI: *TargetRegisterInfo = *MF.getSubtarget().getRegisterInfo();
            let mut RC: *TargetRegisterClass = self.getRegClass(MI.getDesc(), OpNum);
            let mut RCSize: u32 = TRI.getRegSizeInBits(*RC).operator unsigned long long() / 8;
            if (I.Flags & TB_FOLDED_LOAD) && Size < RCSize {
                if Opcode != MOV64rm || RCSize != 8 || Size != 4 {
                    return null;
                }
                if MI.getOperand(0).getSubReg() || MI.getOperand(1).getSubReg() {
                    return null;
                }
                Opcode = MOV32rm;
                NarrowToMOV32rm = true;
            }
            if (I.Flags & TB_FOLDED_STORE) && Size != RCSize {
                return null;
            }
        }
        NewMI = if IsTwoAddr { fuseTwoAddrInst(MF, Opcode, MOs, InsertPt, MI, *self) } else { fuseInst(MF, Opcode, OpNum, MOs, InsertPt, MI, *self, 0) };
        if NarrowToMOV32rm {
            let mut DstReg: Register = NewMI.getOperand(0).getReg();
            if DstReg.isPhysical() {
                NewMI.getOperand(0).setReg(self.RI.getSubReg(DstReg.operator MCRegister(), sub_32bit));
            } else {
                NewMI.getOperand(0).setSubReg(sub_32bit);
            }
        }
        if NoNDDM && !IsTwoAddr {
            let mut SrcReg: Register = MI.getOperand(1).getReg();
            let mut SrcSub: u32 = MI.getOperand(1).getSubReg();
            if MI.killsRegister(SrcReg, null) || MI.getOperand(0).getReg() == SrcReg {
                return NewMI;
            }
            let mut NewSrc: Register = MI.getOperand(0).getReg();
            if MRI.isSSA() {
                NewSrc = MRI.createVirtualRegister(self.getRegClass(NewMI.getDesc(), 1), "");
            }
            CopyMI = BuildMI(*NewMI.getParent(), *NewMI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(COPY)).addDef(NewSrc, RegState {}, 0).addReg(SrcReg, RegState {}, SrcSub).operator llvm::MachineInstr *();
            NewMI.getOperand(1).setReg(NewSrc);
            NewMI.getOperand(1).setSubReg(0);
        }
        return NewMI;
    }
    if AllowCommute {
        let mut CommuteOpIdx2: u32 = self.commuteOperandsForFold(MI, OpNum);
        if CommuteOpIdx2 == OpNum {
            printFailMsgforFold(MI, OpNum);
            return null;
        }
        NewMI = self.foldMemoryOperandImpl(MF, MI, CommuteOpIdx2, MOs, InsertPt, Size, Alignment, false, CopyMI, null);
        if NewMI {
            return NewMI;
        }
        self.commuteInstruction(MI, false, OpNum, CommuteOpIdx2);
    }
    printFailMsgforFold(MI, OpNum);
    return null;
}

fn X86InstrInfo::foldMemoryOperandImpl(self: *X86InstrInfo, MF: *mut MachineFunction, MI: *mut MachineInstr, Ops: ArrayRef<unsigned int>, FrameIndex: i32, CopyMI: *mut *mut MachineInstr, LIS: *mut LiveIntervals, VRM: *mut VirtRegMap) -> *mut MachineInstr {
    let mut InsertPt: iterator = MI;
    if NoFusing {
        return null;
    }
    if !MF.getFunction().hasOptSize() && (hasPartialRegUpdate(MI.getOpcode(), self.Subtarget, true) || shouldPreventUndefRegUpdateMemFold(MF, MI)) {
        return null;
    }
    for Op in Ops {
        let mut MO: *mut MachineOperand = MI.getOperand(Op);
        let mut SubReg: u32 = MO.getSubReg();
        if MI.getOpcode() == MOV32r0 && SubReg == sub_32bit {
            continue;
        }
        if SubReg && (MO.isDef() || SubReg == sub_8bit_hi) {
            return null;
        }
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut Size: u32 = MFI.getObjectSize(FrameIndex);
    let mut Alignment: Align = MFI.getObjectAlign(FrameIndex);
    if !self.RI.hasStackRealignment(MF) {
        Alignment = if Alignment < self.Subtarget.getFrameLowering().getStackAlign() { Alignment } else { self.Subtarget.getFrameLowering().getStackAlign() };
    }
    let mut Impl: Closure_5 = Closure_5 { cap_0: self, MF: &mut MF, MI: &mut MI, Ops: &mut Ops, FrameIndex: &mut FrameIndex, InsertPt: &mut InsertPt, Size: &mut Size, Alignment: &mut Alignment, CopyMI: &mut CopyMI, VRM: &mut VRM };
    if Ops.len == 2 && Ops[0] == 0 && Ops[1] == 1 {
        let mut NewOpc: u32 = 0;
        let mut RCSize: u32 = 0;
        let mut Opc: u32 = MI.getOpcode();
        match Opc {
            _ => {
                return if (if self.Subtarget.hasNDD() { getNonNDVariant(Opc) } else { 0 }) { Impl.call() } else { null };
            },
            TEST8rr => {
                NewOpc = CMP8ri;
            },
            TEST16rr => {
                NewOpc = CMP16ri;
            },
            TEST32rr => {
                NewOpc = CMP32ri;
            },
            TEST64rr => {
                NewOpc = CMP64ri32;
            },
        }
        if Size < RCSize {
            return null;
        }
        MI.setDesc(self.get(NewOpc));
        MI.getOperand(1).ChangeToImmediate(0, 0);
    } else if Ops.len != 1 {
        return null;
    }
    return Impl.call();
}

fn isNonFoldablePartialRegisterLoad(LoadMI: *MachineInstr, UserMI: *MachineInstr, MF: *MachineFunction) -> bool {
    let mut Opc: u32 = LoadMI.getOpcode();
    let mut UserOpc: u32 = UserMI.getOpcode();
    let mut TRI: *TargetRegisterInfo = *MF.getSubtarget().getRegisterInfo();
    let mut RC: *TargetRegisterClass = MF.getRegInfo().getRegClass(LoadMI.getOperand(0).getReg());
    let mut RegSize: u32 = TRI.getRegSizeInBits(*RC).operator unsigned long long();
    if (Opc == MOVSSrm || Opc == VMOVSSrm || Opc == VMOVSSZrm || Opc == MOVSSrm_alt || Opc == VMOVSSrm_alt || Opc == VMOVSSZrm_alt) && RegSize > 32 {
        match UserOpc {
            CVTSS2SDrr_Int => {
                VCVTSS2SDrr_Int;
            },
            _ => {
                return true;
            },
        }
    }
    if (Opc == MOVSDrm || Opc == VMOVSDrm || Opc == VMOVSDZrm || Opc == MOVSDrm_alt || Opc == VMOVSDrm_alt || Opc == VMOVSDZrm_alt) && RegSize > 64 {
        match UserOpc {
            CVTSD2SSrr_Int => {
                VCVTSD2SSrr_Int;
            },
            _ => {
                return true;
            },
        }
    }
    if (Opc == VMOVSHZrm || Opc == VMOVSHZrm_alt) && RegSize > 16 {
        match UserOpc {
            VADDSHZrr_Int => {
                VCMPSHZrri_Int;
            },
            _ => {
                return true;
            },
        }
    }
    return false;
}

fn X86InstrInfo::foldMemoryOperandImpl(self: *X86InstrInfo, MF: *mut MachineFunction, MI: *mut MachineInstr, Ops: ArrayRef<unsigned int>, LoadMI: *mut MachineInstr, CopyMI: *mut *mut MachineInstr, LIS: *mut LiveIntervals, VRM: *mut VirtRegMap) -> *mut MachineInstr {
    let mut InsertPt: iterator = MI;
    let mut MCID: *MCInstrDesc = self.get(LoadMI.getOpcode());
    let mut NumOps: u32 = MCID.getNumOperands();
    if NumOps >= 3 {
        let mut MaskReg: Register = 0;
        let mut Op1: *MachineOperand = LoadMI.getOperand(1);
        let mut Op2: *MachineOperand = LoadMI.getOperand(2);
        let mut IsVKWMClass: Closure_6 = Closure_6 {};
        if Op1.isReg() && IsVKWMClass.call(self.getRegClass(MCID, 1)) {
            MaskReg = Op1.getReg();
        } else if Op2.isReg() && IsVKWMClass.call(self.getRegClass(MCID, 2)) {
            MaskReg = Op2.getReg();
        }
        if MaskReg.operator unsigned int() {
            if isNonFoldableWithSameMask(MI.getOpcode()) {
                return null;
            }
            let mut HasSameMask: bool = false;
            for let mut I: u32 = 1;
let mut E: u32 = MI.getDesc().getNumOperands(); I < E; I += 1 {
                let mut Op: *MachineOperand = MI.getOperand(I);
                if Op.isReg() && Op.getReg() == MaskReg {
                    HasSameMask = true;
                    break;
                }
            }
            if !HasSameMask {
                return null;
            }
        }
    }
    for Op in Ops {
        if MI.getOperand(Op).getSubReg() {
            return null;
        }
    }
    let mut FrameIndex: i32 = 0;
    if self.isLoadFromStackSlot(LoadMI, FrameIndex).operator unsigned int() {
        if isNonFoldablePartialRegisterLoad(LoadMI, MI, MF) {
            return null;
        }
        return self.foldMemoryOperandImpl(MF, MI, Ops, FrameIndex, CopyMI, LIS, VRM);
    }
    if NoFusing {
        return null;
    }
    if !MF.getFunction().hasOptSize() && (hasPartialRegUpdate(MI.getOpcode(), self.Subtarget, true) || shouldPreventUndefRegUpdateMemFold(MF, MI)) {
        return null;
    }
    let mut TSFlags: u64 = MI.getDesc().TSFlags;
    if !X86EnableAPXForRelocation && isMemInstrWithGOTPCREL(LoadMI) && hasNewDataDest(TSFlags) {
        return null;
    }
    let mut Alignment: Align = Align {};
    let mut LoadOpc: u32 = LoadMI.getOpcode();
    if LoadMI.hasOneMemOperand() {
        Alignment = (*LoadMI.memoperands_begin()).getAlign();
    } else {
        match LoadOpc {
            AVX512_512_SETALLONES => {
                Alignment = 64;
            },
            AVX2_SETALLONES => {
                AVX1_SETALLONES;
            },
            V_SET0 => {
                V_SETALLONES;
            },
            MMX_SET0 => {
                FsFLD0SD;
            },
            FsFLD0SS => {
                AVX512_FsFLD0SS;
            },
            FsFLD0SH => {
                AVX512_FsFLD0SH;
            },
            _ => {
                return null;
            },
        }
    }
    if Ops.len == 2 && Ops[0] == 0 && Ops[1] == 1 {
        let mut NewOpc: u32 = 0;
        match MI.getOpcode() {
            _ => {
                return null;
            },
            TEST8rr => {
                NewOpc = CMP8ri;
            },
            TEST16rr => {
                NewOpc = CMP16ri;
            },
            TEST32rr => {
                NewOpc = CMP32ri;
            },
            TEST64rr => {
                NewOpc = CMP64ri32;
            },
        }
        MI.setDesc(self.get(NewOpc));
        MI.getOperand(1).ChangeToImmediate(0, 0);
    } else if Ops.len != 1 {
        return null;
    }
    if LoadMI.getOperand(0).getSubReg() != MI.getOperand(Ops[0]).getSubReg() {
        return null;
    }
    let mut MOs: AddrNumOperands> = AddrNumOperands> {};
    match LoadOpc {
        MMX_SET0 => {
            V_SET0;
        },
        VPBROADCASTBZ128rm => {
            VPBROADCASTBZ256rm;
        },
        VPBROADCASTWZ128rm => {
            VPBROADCASTWZ256rm;
        },
        VPBROADCASTDZ128rm => {
            VPBROADCASTDZ256rm;
        },
        VPBROADCASTQZ128rm => {
            VPBROADCASTQZ256rm;
        },
        _ => {
            if isNonFoldablePartialRegisterLoad(LoadMI, MI, MF) {
                return null;
            }
            MOs.append(LoadMI.operands_begin() + NumOps - AddrNumOperands, LoadMI.operands_begin() + NumOps);
            break;
        },
    }
    return self.foldMemoryOperandImpl(MF, MI, Ops[0], MOs, InsertPt, 0, Alignment, true, CopyMI, VRM);
}

fn X86InstrInfo::foldMemoryBroadcast(self: *X86InstrInfo, MF: *mut MachineFunction, MI: *mut MachineInstr, OpNum: u32, MOs: ArrayRef<MachineOperand>, InsertPt: iterator, BitsSize: u32, AllowCommute: bool) -> *mut MachineInstr {
    if lookupBroadcastFoldTable(MI.getOpcode(), OpNum) {
        I;
    } else {
        return if matchBroadcastSize(*I, BitsSize) { fuseInst(MF, I.DstOp, OpNum, MOs, InsertPt, MI, *self, 0) } else { null };
    }
    if AllowCommute {
        let mut CommuteOpIdx2: u32 = self.commuteOperandsForFold(MI, OpNum);
        if CommuteOpIdx2 == OpNum {
            printFailMsgforFold(MI, OpNum);
            return null;
        }
        let mut NewMI: *mut MachineInstr = self.foldMemoryBroadcast(MF, MI, CommuteOpIdx2, MOs, InsertPt, BitsSize, false);
        if NewMI {
            return NewMI;
        }
        self.commuteInstruction(MI, false, OpNum, CommuteOpIdx2);
    }
    printFailMsgforFold(MI, OpNum);
    return null;
}

fn extractLoadMMOs(MMOs: ArrayRef<MachineMemOperand *>, MF: *mut MachineFunction) -> SmallVector<MachineMemOperand *, 2> {
    let mut LoadMMOs: SmallVector<MachineMemOperand *, 2> = SmallVector<MachineMemOperand *, 2> {};
    for MMO in MMOs {
        if !MMO.isLoad() {
            continue;
        }
        if !MMO.isStore() {
            LoadMMOs.push(MMO);
        } else {
            LoadMMOs.push(MF.getMachineMemOperand(MMO, MMO.getFlags() & operator(MOStore)));
        }
    }
    return LoadMMOs;
}

fn extractStoreMMOs(MMOs: ArrayRef<MachineMemOperand *>, MF: *mut MachineFunction) -> SmallVector<MachineMemOperand *, 2> {
    let mut StoreMMOs: SmallVector<MachineMemOperand *, 2> = SmallVector<MachineMemOperand *, 2> {};
    for MMO in MMOs {
        if !MMO.isStore() {
            continue;
        }
        if !MMO.isLoad() {
            StoreMMOs.push(MMO);
        } else {
            StoreMMOs.push(MF.getMachineMemOperand(MMO, MMO.getFlags() & operator(MOLoad)));
        }
    }
    return StoreMMOs;
}

fn getBroadcastOpcode(I: *X86FoldTableEntry, RC: *TargetRegisterClass, STI: *X86Subtarget) -> u32 {
    assert!(STI.hasAVX512(), "Expected at least AVX512!");
    let mut SpillSize: u32 = STI.getRegisterInfo().getSpillSize(*RC);
    assert!((SpillSize == 64 || STI.hasVLX()), "Can't broadcast less than 64 bytes without AVX512VL!");
    match I.Flags & TB_BCAST_MASK {
        _ => {
            llvm_unreachable_internal("Unexpected broadcast type!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 8809);
        },
        TB_BCAST_W => {
            match SpillSize {
                _ => {
                    llvm_unreachable_internal("Unknown spill size", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 8811);
                },
                16 => {
                    return VPBROADCASTWZ128rm;
                },
                32 => {
                    return VPBROADCASTWZ256rm;
                },
                64 => {
                    return VPBROADCASTWZrm;
                },
            }
        },
        TB_BCAST_D => {
            match SpillSize {
                _ => {
                    llvm_unreachable_internal("Unknown spill size", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 8813);
                },
                16 => {
                    return VPBROADCASTDZ128rm;
                },
                32 => {
                    return VPBROADCASTDZ256rm;
                },
                64 => {
                    return VPBROADCASTDZrm;
                },
            }
        },
        TB_BCAST_Q => {
            match SpillSize {
                _ => {
                    llvm_unreachable_internal("Unknown spill size", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 8815);
                },
                16 => {
                    return VPBROADCASTQZ128rm;
                },
                32 => {
                    return VPBROADCASTQZ256rm;
                },
                64 => {
                    return VPBROADCASTQZrm;
                },
            }
        },
        TB_BCAST_SH => {
            match SpillSize {
                _ => {
                    llvm_unreachable_internal("Unknown spill size", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 8817);
                },
                16 => {
                    return VPBROADCASTWZ128rm;
                },
                32 => {
                    return VPBROADCASTWZ256rm;
                },
                64 => {
                    return VPBROADCASTWZrm;
                },
            }
        },
        TB_BCAST_SS => {
            match SpillSize {
                _ => {
                    llvm_unreachable_internal("Unknown spill size", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 8819);
                },
                16 => {
                    return VBROADCASTSSZ128rm;
                },
                32 => {
                    return VBROADCASTSSZ256rm;
                },
                64 => {
                    return VBROADCASTSSZrm;
                },
            }
        },
        TB_BCAST_SD => {
            match SpillSize {
                _ => {
                    llvm_unreachable_internal("Unknown spill size", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 8821);
                },
                16 => {
                    return VMOVDDUPZ128rm;
                },
                32 => {
                    return VBROADCASTSDZ256rm;
                },
                64 => {
                    return VBROADCASTSDZrm;
                },
            }
        },
    }
}

fn X86InstrInfo::unfoldMemoryOperand(self: *X86InstrInfo, MF: *mut MachineFunction, MI: *mut MachineInstr, Reg: Register, UnfoldLoad: bool, UnfoldStore: bool, NewMIs: *mut SmallVectorImpl<MachineInstr *>) -> bool {
    let mut I: *X86FoldTableEntry = lookupUnfoldTable(MI.getOpcode());
    if I == null {
        return false;
    }
    let mut Opc: u32 = I.DstOp;
    let mut Index: u32 = I.Flags & TB_INDEX_MASK;
    let mut FoldedLoad: bool = I.Flags & TB_FOLDED_LOAD;
    let mut FoldedStore: bool = I.Flags & TB_FOLDED_STORE;
    if UnfoldLoad && !FoldedLoad {
        return false;
    }
    UnfoldLoad &= FoldedLoad;
    if UnfoldStore && !FoldedStore {
        return false;
    }
    UnfoldStore &= FoldedStore;
    let mut MCID: *MCInstrDesc = self.get(Opc);
    let mut RC: *TargetRegisterClass = self.getRegClass(MCID, Index);
    let mut TRI: *TargetRegisterInfo = *MF.getSubtarget().getRegisterInfo();
    if !MI.hasOneMemOperand() && RC == &mut VR128RegClass && self.Subtarget.isUnalignedMem16Slow() {
        return false;
    }
    let mut AddrOps: AddrNumOperands> = AddrNumOperands> {};
    let mut BeforeOps: SmallVector<MachineOperand, 2> = SmallVector<MachineOperand, 2> {};
    let mut AfterOps: SmallVector<MachineOperand, 2> = SmallVector<MachineOperand, 2> {};
    let mut ImpOps: SmallVector<MachineOperand, 4> = SmallVector<MachineOperand, 4> {};
    for let mut i: u32 = 0;
let mut e: u32 = MI.getNumOperands(); i != e; i += 1 {
        let mut Op: *mut MachineOperand = MI.getOperand(i);
        if i >= Index && i < Index + AddrNumOperands {
            AddrOps.push(Op);
        } else if Op.isReg() && Op.isImplicit() {
            ImpOps.push(Op);
        } else if i < Index {
            BeforeOps.push(Op);
        } else if i > Index {
            AfterOps.push(Op);
        }
    }
    if UnfoldLoad {
        let mut MMOs: SmallVector<MachineMemOperand *, 2> = extractLoadMMOs(MI.memoperands(), MF);
        let mut Opc: u32 = 0;
        if I.Flags & TB_BCAST_MASK {
            Opc = getBroadcastOpcode(I, RC, self.Subtarget);
        } else {
            let mut Alignment: u32 = if TRI.getSpillSize(*RC) > 16 { TRI.getSpillSize(*RC) } else { 16 };
            let mut isAligned: bool = !MMOs.is_empty() && MMOs.front().getAlign() >= Alignment;
            Opc = getLoadRegOpcode(Reg, RC, isAligned, self.Subtarget);
        }
        let mut DL: DebugLoc = null;
        let mut MIB: MachineInstrBuilder = BuildMI(MF, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc), Reg);
        for AddrOp in AddrOps {
            MIB.add(AddrOp);
        }
        MIB.setMemRefs(MMOs);
        NewMIs.push(MIB.operator llvm::MachineInstr *());
        if UnfoldStore {
            for let mut i: u32 = 1; i != 1 + AddrNumOperands; i += 1 {
                let mut MO: *mut MachineOperand = NewMIs[0].getOperand(i);
                if MO.isReg() {
                    MO.setIsKill(false);
                }
            }
        }
    }
    let mut DataMI: *mut MachineInstr = MF.CreateMachineInstr(MCID, MI.getDebugLoc(), true);
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder { MF: MF, MI: DataMI };
    if FoldedStore {
        MIB.addReg(Reg, Define, 0);
    }
    for BeforeOp in BeforeOps {
        MIB.add(BeforeOp);
    }
    if FoldedLoad {
        MIB.addReg(Reg, RegState {}, 0);
    }
    for AfterOp in AfterOps {
        MIB.add(AfterOp);
    }
    for ImpOp in ImpOps {
        MIB.addReg(ImpOp.getReg(), getDefRegState(ImpOp.isDef()) | Implicit | getKillRegState(ImpOp.isKill()) | getDeadRegState(ImpOp.isDead()) | getUndefRegState(ImpOp.isUndef()), 0);
    }
    match DataMI.getOpcode() {
        _ => {
            break;
        },
        CMP64ri32 => {
            CMP32ri;
        },
    }
    NewMIs.push(DataMI);
    if UnfoldStore {
        let mut DstRC: *TargetRegisterClass = self.getRegClass(MCID, 0);
        let mut MMOs: SmallVector<MachineMemOperand *, 2> = extractStoreMMOs(MI.memoperands(), MF);
        let mut Alignment: u32 = if TRI.getSpillSize(*DstRC) > 16 { TRI.getSpillSize(*DstRC) } else { 16 };
        let mut isAligned: bool = !MMOs.is_empty() && MMOs.front().getAlign() >= Alignment;
        let mut Opc: u32 = getStoreRegOpcode(Reg, DstRC, isAligned, self.Subtarget);
        let mut DL: DebugLoc = null;
        let mut MIB: MachineInstrBuilder = BuildMI(MF, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc));
        for AddrOp in AddrOps {
            MIB.add(AddrOp);
        }
        MIB.addReg(Reg, Kill, 0);
        MIB.setMemRefs(MMOs);
        NewMIs.push(MIB.operator llvm::MachineInstr *());
    }
    return true;
}

fn X86InstrInfo::unfoldMemoryOperand(self: *X86InstrInfo, DAG: *mut SelectionDAG, N: *mut SDNode, NewNodes: *mut SmallVectorImpl<SDNode *>) -> bool {
    if !N.isMachineOpcode() {
        return false;
    }
    let mut I: *X86FoldTableEntry = lookupUnfoldTable(N.getMachineOpcode());
    if I == null {
        return false;
    }
    let mut Opc: u32 = I.DstOp;
    let mut Index: u32 = I.Flags & TB_INDEX_MASK;
    let mut FoldedLoad: bool = I.Flags & TB_FOLDED_LOAD;
    let mut FoldedStore: bool = I.Flags & TB_FOLDED_STORE;
    let mut MCID: *MCInstrDesc = self.get(Opc);
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut TRI: *TargetRegisterInfo = *MF.getSubtarget().getRegisterInfo();
    let mut RC: *TargetRegisterClass = self.getRegClass(MCID, Index);
    let mut NumDefs: u32 = MCID.NumDefs;
    let mut AddrOps: []SDValue = []SDValue {};
    let mut BeforeOps: []SDValue = []SDValue {};
    let mut AfterOps: []SDValue = []SDValue {};
    let mut dl: SDLoc = N;
    let mut NumOps: u32 = N.getNumOperands();
    for let mut i: u32 = 0; i != NumOps - 1; i += 1 {
        let mut Op: SDValue = N.getOperand(i);
        if i >= Index - NumDefs && i < Index - NumDefs + AddrNumOperands {
            AddrOps.push(Op);
        } else if i < Index - NumDefs {
            BeforeOps.push(Op);
        } else if i > Index - NumDefs {
            AfterOps.push(Op);
        }
    }
    let mut Chain: SDValue = N.getOperand(NumOps - 1);
    AddrOps.push(Chain);
    let mut Load: *mut SDNode = null;
    if FoldedLoad {
        let mut VT: EVT = *TRI.legalclasstypes_begin(*RC);
        let mut MMOs: SmallVector<MachineMemOperand *, 2> = extractLoadMMOs(cast(N).memoperands(), MF);
        if MMOs.is_empty() && RC == &mut VR128RegClass && self.Subtarget.isUnalignedMem16Slow() {
            return false;
        }
        let mut Opc: u32 = 0;
        if I.Flags & TB_BCAST_MASK {
            Opc = getBroadcastOpcode(I, RC, self.Subtarget);
        } else {
            let mut Alignment: u32 = if TRI.getSpillSize(*RC) > 16 { TRI.getSpillSize(*RC) } else { 16 };
            let mut isAligned: bool = !MMOs.is_empty() && MMOs.front().getAlign() >= Alignment;
            Opc = getLoadRegOpcode(0, RC, isAligned, self.Subtarget);
        }
        Load = DAG.getMachineNode(Opc, dl, VT, Other, AddrOps);
        NewNodes.push(Load);
        DAG.setNodeMemRefs(cast(Load), MMOs);
    }
    let mut VTs: []EVT = []EVT {};
    let mut DstRC: *TargetRegisterClass = null;
    if MCID.getNumDefs() > 0 {
        DstRC = self.getRegClass(MCID, 0);
        VTs.push(*TRI.legalclasstypes_begin(*DstRC));
    }
    for let mut i: u32 = 0;
let mut e: u32 = N.getNumValues(); i != e; i += 1 {
        let mut VT: EVT = N.getValueType(i);
        if VT != Other && i >= MCID.getNumDefs() as u32 {
            VTs.push(VT);
        }
    }
    if Load {
        BeforeOps.push(SDValue { Node: Load, ResNo: 0 });
    }
    append_range(BeforeOps, AfterOps);
    match Opc {
        _ => {
            break;
        },
        CMP64ri32 => {
            CMP32ri;
        },
    }
    let mut NewNode: *mut SDNode = DAG.getMachineNode(Opc, dl, VTs, BeforeOps);
    NewNodes.push(NewNode);
    if FoldedStore {
        AddrOps.pop();
        AddrOps.push(SDValue { Node: NewNode, ResNo: 0 });
        AddrOps.push(Chain);
        let mut MMOs: SmallVector<MachineMemOperand *, 2> = extractStoreMMOs(cast(N).memoperands(), MF);
        if MMOs.is_empty() && RC == &mut VR128RegClass && self.Subtarget.isUnalignedMem16Slow() {
            return false;
        }
        let mut Alignment: u32 = if TRI.getSpillSize(*RC) > 16 { TRI.getSpillSize(*RC) } else { 16 };
        let mut isAligned: bool = !MMOs.is_empty() && MMOs.front().getAlign() >= Alignment;
        let mut Store: *mut SDNode = DAG.getMachineNode(getStoreRegOpcode(0, DstRC, isAligned, self.Subtarget), dl, Other, AddrOps);
        NewNodes.push(Store);
        DAG.setNodeMemRefs(cast(Store), MMOs);
    }
    return true;
}

fn X86InstrInfo::getOpcodeAfterMemoryUnfold(self: *X86InstrInfo, Opc: u32, UnfoldLoad: bool, UnfoldStore: bool, LoadRegIndex: *mut u32) -> u32 {
    let mut I: *X86FoldTableEntry = lookupUnfoldTable(Opc);
    if I == null {
        return 0;
    }
    let mut FoldedLoad: bool = I.Flags & TB_FOLDED_LOAD;
    let mut FoldedStore: bool = I.Flags & TB_FOLDED_STORE;
    if UnfoldLoad && !FoldedLoad {
        return 0;
    }
    if UnfoldStore && !FoldedStore {
        return 0;
    }
    if LoadRegIndex {
        *LoadRegIndex = I.Flags & TB_INDEX_MASK;
    }
    return I.DstOp;
}

fn X86InstrInfo::areLoadsFromSameBasePtr(self: *X86InstrInfo, Load1: *mut SDNode, Load2: *mut SDNode, Offset1: *mut i64, Offset2: *mut i64) -> bool {
    if !Load1.isMachineOpcode() || !Load2.isMachineOpcode() {
        return false;
    }
    let mut IsLoadOpcode: Closure_7 = Closure_7 {};
    if !IsLoadOpcode.call(Load1.getMachineOpcode()) || !IsLoadOpcode.call(Load2.getMachineOpcode()) {
        return false;
    }
    let mut HasSameOp: Closure_8 = Closure_8 { Load1: &mut Load1, Load2: &mut Load2 };
    if !HasSameOp.call(AddrBaseReg) || !HasSameOp.call(AddrScaleAmt) || !HasSameOp.call(AddrIndexReg) || !HasSameOp.call(AddrSegmentReg) {
        return false;
    }
    if !HasSameOp.call(5) {
        return false;
    }
    let mut Disp1: CastReturnType = dyn_cast(Load1.getOperand(AddrDisp));
    let mut Disp2: CastReturnType = dyn_cast(Load2.getOperand(AddrDisp));
    if !Disp1 || !Disp2 {
        return false;
    }
    Offset1 = Disp1.getSExtValue();
    Offset2 = Disp2.getSExtValue();
    return true;
}

fn X86InstrInfo::shouldScheduleLoadsNear(self: *X86InstrInfo, Load1: *mut SDNode, Load2: *mut SDNode, Offset1: i64, Offset2: i64, NumLoads: u32) -> bool {
    assert!(Offset2 > Offset1);
    if (Offset2 - Offset1) / 8 > 64 {
        return false;
    }
    let mut Opc1: u32 = Load1.getMachineOpcode();
    let mut Opc2: u32 = Load2.getMachineOpcode();
    if Opc1 != Opc2 {
        return false;
    }
    match Opc1 {
        _ => {
            break;
        },
        LD_Fp32m => {
            LD_Fp64m;
        },
    }
    let mut VT: EVT = Load1.getValueType(0);
    match VT.getSimpleVT().SimpleTy {
        _ => {
            if self.Subtarget.is64Bit() {
                if NumLoads >= 3 {
                    return false;
                }
            } else if NumLoads {
                return false;
            }
        },
        i8 => {
            i16;
        },
    }
    return true;
}

fn X86InstrInfo::isSchedulingBoundary(self: *X86InstrInfo, MI: *MachineInstr, MBB: *MachineBasicBlock, MF: *MachineFunction) -> bool {
    let mut Opcode: u32 = MI.getOpcode();
    if Opcode == ENDBR64 || Opcode == ENDBR32 || Opcode == PLDTILECFGV {
        return true;
    }
    if MI.getFlag(FrameSetup) || MI.getFlag(FrameDestroy) {
        return true;
    }
    return self.isSchedulingBoundary(MI, MBB, MF);
}

fn X86InstrInfo::reverseBranchCondition(self: *X86InstrInfo, Cond: *mut SmallVectorImpl<MachineOperand>) -> bool {
    assert!(Cond.len == 1, "Invalid X86 branch condition!");
    let mut CC: CondCode = Cond[0].getImm() as CondCode;
    Cond[0].setImm(GetOppositeBranchCondition(CC));
    return false;
}

fn X86InstrInfo::isSafeToMoveRegClassDefs(self: *X86InstrInfo, RC: *TargetRegisterClass) -> bool {
    return !(RC == &mut CCRRegClass || RC == &mut DFCCRRegClass || RC == &mut RFP32RegClass || RC == &mut RFP64RegClass || RC == &mut RFP80RegClass);
}

fn X86InstrInfo::getGlobalBaseReg(self: *X86InstrInfo, MF: *mut MachineFunction) -> Register {
    let mut X86FI: *mut X86MachineFunctionInfo = MF.getInfo();
    let mut GlobalBaseReg: Register = X86FI.getGlobalBaseReg();
    if GlobalBaseReg.operator unsigned int() {
        return GlobalBaseReg;
    }
    let mut RegInfo: *mut MachineRegisterInfo = MF.getRegInfo();
    GlobalBaseReg = RegInfo.createVirtualRegister(if self.Subtarget.is64Bit() { &mut GR64_NOSPRegClass } else { &mut GR32_NOSPRegClass }, "");
    X86FI.setGlobalBaseReg(GlobalBaseReg);
    return GlobalBaseReg;
}

fn lookup(opcode: u32, domain: u32, Table: [3]ArrayRef<uint16_t) -> *u16 {
    for Row in Table[..] {
        if Row[domain - 1] == opcode {
            return Row;
        }
    }
    return null;
}

fn lookupAVX512(opcode: u32, domain: u32, Table: [4]ArrayRef<uint16_t) -> *u16 {
    for Row in Table[..] {
        if Row[domain - 1] == opcode || (domain == 3 && Row[3] == opcode) {
            return Row;
        }
    }
    return null;
}

fn AdjustBlendMask(OldMask: u32, OldWidth: u32, NewWidth: u32, pNewMask: *mut u32) -> bool {
    assert!(((OldWidth % NewWidth) == 0 || (NewWidth % OldWidth) == 0), "Illegal blend mask scale");
    let mut NewMask: u32 = 0;
    if (OldWidth % NewWidth) == 0 {
        let mut Scale: u32 = OldWidth / NewWidth;
        let mut SubMask: u32 = (1 << Scale) - 1;
        for let mut i: u32 = 0; i != NewWidth; i += 1 {
            let mut Sub: u32 = (OldMask >> (i * Scale)) & SubMask;
            if Sub == SubMask {
                NewMask |= (1 << i);
            } else if Sub != 0 {
                return false;
            }
        }
    } else {
        let mut Scale: u32 = NewWidth / OldWidth;
        let mut SubMask: u32 = (1 << Scale) - 1;
        for let mut i: u32 = 0; i != OldWidth; i += 1 {
            if OldMask & (1 << i) {
                NewMask |= (SubMask << (i * Scale));
            }
        }
    }
    if pNewMask {
        *pNewMask = NewMask;
    }
    return true;
}

fn X86InstrInfo::getExecutionDomainCustom(self: *X86InstrInfo, MI: *MachineInstr) -> u16 {
    let mut Opcode: u32 = MI.getOpcode();
    let mut NumOperands: u32 = MI.getDesc().getNumOperands();
    let mut GetBlendDomains: Closure_9 = Closure_9 { MI: &mut MI, NumOperands: &mut NumOperands, cap_2: self };
    match Opcode {
        BLENDPDrmi => {
            BLENDPDrri;
        },
        VBLENDPDYrmi => {
            VBLENDPDYrri;
        },
        BLENDPSrmi => {
            BLENDPSrri;
        },
        VBLENDPSYrmi => {
            VBLENDPSYrri;
        },
        PBLENDWrmi => {
            PBLENDWrri;
        },
        VPANDDZ128rr => {
            VPANDDZ128rm;
        },
        MOVHLPSrr => {
            if MI.getOperand(1).getReg() == MI.getOperand(2).getReg() && MI.getOperand(0).getSubReg() == 0 && MI.getOperand(1).getSubReg() == 0 && MI.getOperand(2).getSubReg() == 0 {
                return 6;
            }
        },
        SHUFPDrri => {
            return 6;
        },
    }
    return 0;
}

fn X86InstrInfo::setExecutionDomainCustom(self: *X86InstrInfo, MI: *mut MachineInstr, Domain: u32) -> bool {
    assert!(Domain > 0 && Domain < 4, "Invalid execution domain");
    let mut dom: u16 = (MI.getDesc().TSFlags >> SSEDomainShift) & 3;
    assert!(dom, "Not an SSE instruction");
    let mut Opcode: u32 = MI.getOpcode();
    let mut NumOperands: u32 = MI.getDesc().getNumOperands();
    let mut SetBlendDomain: Closure_10 = Closure_10 { MI: &mut MI, NumOperands: &mut NumOperands, Opcode: &mut Opcode, dom: &mut dom, Domain: &mut Domain, cap_5: self };
    match Opcode {
        BLENDPDrmi => {
            BLENDPDrri;
        },
        VBLENDPDYrmi => {
            VBLENDPDYrri;
        },
        BLENDPSrmi => {
            BLENDPSrri;
        },
        VBLENDPSYrmi => {
            VBLENDPSYrri;
        },
        PBLENDWrmi => {
            PBLENDWrri;
        },
        VPBLENDWYrmi => {
            VPBLENDWYrri;
        },
        VPANDDZ128rr => {
            VPANDDZ128rm;
        },
        UNPCKHPDrr => {
            MOVHLPSrr;
        },
        SHUFPDrri => {
            if Domain == 1 {
                let mut Imm: u32 = MI.getOperand(3).getImm();
                let mut NewImm: u32 = 68;
                if Imm & 1 {
                    NewImm |= 10;
                }
                if Imm & 2 {
                    NewImm |= 160;
                }
                MI.getOperand(3).setImm(NewImm);
                MI.setDesc(self.get(SHUFPSrri));
            }
            return true;
        },
    }
    return false;
}

fn X86InstrInfo::getExecutionDomain(self: *X86InstrInfo, MI: *MachineInstr) -> pair<uint16_t, uint16_t> {
    let mut domain: u16 = (MI.getDesc().TSFlags >> SSEDomainShift) & 3;
    let mut opcode: u32 = MI.getOpcode();
    let mut validDomains: u16 = 0;
    if domain {
        validDomains = self.getExecutionDomainCustom(MI);
        if validDomains {
            return make_pair(domain, validDomains);
        }
        if lookup(opcode, domain, ReplaceableInstrs) {
            validDomains = 14;
        } else if lookup(opcode, domain, ReplaceableInstrsAVX2) {
            validDomains = if self.Subtarget.hasAVX2() { 14 } else { 6 };
        } else if lookup(opcode, domain, ReplaceableInstrsFP) {
            validDomains = 6;
        } else if lookup(opcode, domain, ReplaceableInstrsAVX2InsertExtract) {
            if !self.Subtarget.hasAVX2() {
                return make_pair(0, 0);
            }
            validDomains = 14;
        } else if lookupAVX512(opcode, domain, ReplaceableInstrsAVX512) {
            validDomains = 14;
        } else if self.Subtarget.hasDQI() && lookupAVX512(opcode, domain, ReplaceableInstrsAVX512DQ) {
            validDomains = 14;
        } else if self.Subtarget.hasDQI() {
            if lookupAVX512(opcode, domain, ReplaceableInstrsAVX512DQMasked) {
                table;
            } else {
                if domain == 1 || (domain == 3 && table[3] == opcode) {
                    validDomains = 10;
                } else {
                    validDomains = 12;
                }
            }
        }
    }
    return make_pair(domain, validDomains);
}

fn X86InstrInfo::setExecutionDomain(self: *X86InstrInfo, MI: *mut MachineInstr, Domain: u32) {
    assert!(Domain > 0 && Domain < 4, "Invalid execution domain");
    let mut dom: u16 = (MI.getDesc().TSFlags >> SSEDomainShift) & 3;
    assert!(dom, "Not an SSE instruction");
    if self.setExecutionDomainCustom(MI, Domain) {
        return;
    }
    let mut table: *u16 = lookup(MI.getOpcode(), dom, ReplaceableInstrs);
    if !table {
        assert!((self.Subtarget.hasAVX2() || Domain < 3), "256-bit vector operations only available in AVX2");
        table = lookup(MI.getOpcode(), dom, ReplaceableInstrsAVX2);
    }
    if !table {
        table = lookup(MI.getOpcode(), dom, ReplaceableInstrsFP);
        assert!((!table || Domain < 3), "Can only select PackedSingle or PackedDouble");
    }
    if !table {
        assert!(self.Subtarget.hasAVX2(), "256-bit insert/extract only available in AVX2");
        table = lookup(MI.getOpcode(), dom, ReplaceableInstrsAVX2InsertExtract);
    }
    if !table {
        assert!(self.Subtarget.hasAVX512(), "Requires AVX-512");
        table = lookupAVX512(MI.getOpcode(), dom, ReplaceableInstrsAVX512);
        if table && Domain == 3 && table[3] == MI.getOpcode() {
            Domain = 4;
        }
    }
    if !table {
        assert!((self.Subtarget.hasDQI() || Domain >= 3), "Requires AVX-512DQ");
        table = lookupAVX512(MI.getOpcode(), dom, ReplaceableInstrsAVX512DQ);
        if table && Domain == 3 && (dom == 1 || table[3] == MI.getOpcode()) {
            Domain = 4;
        }
    }
    if !table {
        assert!((self.Subtarget.hasDQI() || Domain >= 3), "Requires AVX-512DQ");
        table = lookupAVX512(MI.getOpcode(), dom, ReplaceableInstrsAVX512DQMasked);
        if table && Domain == 3 && (dom == 1 || table[3] == MI.getOpcode()) {
            Domain = 4;
        }
    }
    assert!(table, "Cannot change domain");
    MI.setDesc(self.get(table[Domain - 1]));
}

fn X86InstrInfo::insertNoop(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, MI: iterator) {
    let mut DL: DebugLoc = null;
    BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(NOOP));
}

fn X86InstrInfo::getNop(self: *X86InstrInfo) -> MCInst {
    let mut Nop: MCInst = MCInst {};
    Nop.setOpcode(NOOP);
    return Nop;
}

fn X86InstrInfo::isHighLatencyDef(self: *X86InstrInfo, opc: i32) -> bool {
    match opc {
        _ => {
            return false;
        },
        DIVPDrm => {
            DIVPDrr;
        },
    }
}

fn X86InstrInfo::hasHighOperandLatency(self: *X86InstrInfo, SchedModel: *TargetSchedModel, MRI: *MachineRegisterInfo, DefMI: *MachineInstr, DefIdx: u32, UseMI: *MachineInstr, UseIdx: u32) -> bool {
    return self.isHighLatencyDef(DefMI.getOpcode());
}

fn X86InstrInfo::hasReassociableOperands(self: *X86InstrInfo, Inst: *MachineInstr, MBB: *MachineBasicBlock) -> bool {
    assert!(Inst.getNumExplicitOperands() == 3 && Inst.getNumExplicitDefs() == 1 && Inst.getNumDefs() <= 2, "Reassociation needs binary operators");
    let mut FlagDef: *MachineOperand = Inst.findRegisterDefOperand(EFLAGS, null, false, false);
    assert!((Inst.getNumDefs() == 1 || FlagDef), "Implicit def isn't flags?");
    if FlagDef && !FlagDef.isDead() {
        return false;
    }
    return self.hasReassociableOperands(Inst, MBB);
}

fn X86InstrInfo::isAssociativeAndCommutative(self: *X86InstrInfo, Inst: *MachineInstr, Invert: bool) -> bool {
    if Invert {
        return false;
    }
    match Inst.getOpcode() {
        ADD8rr => {
            ADD8rr_ND;
        },
        ADDPDrr => {
            ADDPSrr;
        },
        _ => {
            return false;
        },
    }
}

fn describeMOVrrLoadedValue(MI: *MachineInstr, DescribedReg: Register, TRI: *TargetRegisterInfo) -> optional<ParamLoadedValue> {
    let mut DestReg: Register = MI.getOperand(0).getReg();
    let mut SrcReg: Register = MI.getOperand(1).getReg();
    let mut Expr: *mut DIExpression = get(MI.getMF().getFunction().getContext(), ArrayRef<uint64_t> {});
    if DestReg == DescribedReg {
        return ParamLoadedValue { CreateReg(SrcReg, false, false, false, false, false, false, 0, false, false, false), Expr };
    }
    if TRI.getSubRegIndex(DestReg.operator MCRegister(), DescribedReg.operator MCRegister()) {
        SubRegIdx;
    } else {
        let mut SrcSubReg: Register = TRI.getSubReg(SrcReg.operator MCRegister(), SubRegIdx);
        return ParamLoadedValue { CreateReg(SrcSubReg, false, false, false, false, false, false, 0, false, false, false), Expr };
    }
    if MI.getOpcode() == MOV8rr || MI.getOpcode() == MOV16rr || !TRI.isSuperRegister(DestReg.operator MCRegister(), DescribedReg.operator MCRegister()) {
        return nullopt;
    }
    assert!(MI.getOpcode() == MOV32rr, "Unexpected super-register case");
    return ParamLoadedValue { CreateReg(SrcReg, false, false, false, false, false, false, 0, false, false, false), Expr };
}

fn X86InstrInfo::describeLoadedValue(self: *X86InstrInfo, MI: *MachineInstr, Reg: Register) -> optional<ParamLoadedValue> {
    let mut Op: *MachineOperand = null;
    let mut Expr: *mut DIExpression = null;
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    match MI.getOpcode() {
        LEA32r => {
            LEA64r;
        },
        MOV8ri => {
            MOV16ri;
        },
        MOV32ri => {
            MOV64ri;
        },
        MOV8rr => {
            MOV16rr;
        },
        XOR32rr => {
            if !TRI.isSuperRegisterEq(MI.getOperand(0).getReg().operator MCRegister(), Reg.operator MCRegister()) {
                return nullopt;
            }
            if MI.getOperand(1).getReg() == MI.getOperand(2).getReg() {
                return ParamLoadedValue { CreateImm(0), Expr };
            }
            return nullopt;
        },
        MOVSX64rr32 => {
            if !TRI.isSubRegisterEq(MI.getOperand(0).getReg().operator MCRegister(), Reg.operator MCRegister()) {
                return nullopt;
            }
            Expr = get(MI.getMF().getFunction().getContext(), ArrayRef<uint64_t> {});
            if Reg == MI.getOperand(0).getReg() {
                Expr = appendExt(Expr, 32, 64, true);
            } else {
                assert!(getX86MCRegisterClass(GR32RegClassID).contains(Reg.operator MCRegister()), "Unhandled sub-register case for MOVSX64rr32");
            }
            return ParamLoadedValue { MI.getOperand(1), Expr };
        },
        _ => {
            assert!(!MI.isMoveImmediate(IgnoreBundle), "Unexpected MoveImm instruction");
        },
    }
}

fn X86InstrInfo::setSpecialOperandAttr(self: *X86InstrInfo, OldMI1: *mut MachineInstr, OldMI2: *mut MachineInstr, NewMI1: *mut MachineInstr, NewMI2: *mut MachineInstr) {
    let mut OldFlagDef1: *mut MachineOperand = OldMI1.findRegisterDefOperand(EFLAGS, null, false, false);
    let mut OldFlagDef2: *mut MachineOperand = OldMI2.findRegisterDefOperand(EFLAGS, null, false, false);
    assert!(!OldFlagDef1 == !OldFlagDef2, "Unexpected instruction type for reassociation");
    if !OldFlagDef1 || !OldFlagDef2 {
        return;
    }
    assert!(OldFlagDef1.isDead() && OldFlagDef2.isDead(), "Must have dead EFLAGS operand in reassociable instruction");
    let mut NewFlagDef1: *mut MachineOperand = NewMI1.findRegisterDefOperand(EFLAGS, null, false, false);
    let mut NewFlagDef2: *mut MachineOperand = NewMI2.findRegisterDefOperand(EFLAGS, null, false, false);
    assert!(NewFlagDef1 && NewFlagDef2, "Unexpected operand in reassociable instruction");
    NewFlagDef1.setIsDead(true);
    NewFlagDef2.setIsDead(true);
}

fn X86InstrInfo::decomposeMachineOperandsTargetFlags(self: *X86InstrInfo, TF: u32) -> pair<unsigned int, unsigned int> {
    return make_pair(TF, 0);
}

fn X86InstrInfo::getSerializableDirectMachineOperandTargetFlags(self: *X86InstrInfo) -> pair<unsigned int, const char *>> {
    let mut TargetFlags: [23]pair<unsigned int, const char *> = [pair<unsigned int, const char *> { MO_GOT_ABSOLUTE_ADDRESS, "x86-got-absolute-address" }, pair<unsigned int, const char *> { MO_PIC_BASE_OFFSET, "x86-pic-base-offset" }, pair<unsigned int, const char *> { MO_GOT, "x86-got" }, pair<unsigned int, const char *> { MO_GOTOFF, "x86-gotoff" }, pair<unsigned int, const char *> { MO_GOTPCREL, "x86-gotpcrel" }, pair<unsigned int, const char *> { MO_GOTPCREL_NORELAX, "x86-gotpcrel-norelax" }, pair<unsigned int, const char *> { MO_PLT, "x86-plt" }, pair<unsigned int, const char *> { MO_TLSGD, "x86-tlsgd" }, pair<unsigned int, const char *> { MO_TLSLD, "x86-tlsld" }, pair<unsigned int, const char *> { MO_TLSLDM, "x86-tlsldm" }, pair<unsigned int, const char *> { MO_GOTTPOFF, "x86-gottpoff" }, pair<unsigned int, const char *> { MO_INDNTPOFF, "x86-indntpoff" }, pair<unsigned int, const char *> { MO_TPOFF, "x86-tpoff" }, pair<unsigned int, const char *> { MO_DTPOFF, "x86-dtpoff" }, pair<unsigned int, const char *> { MO_NTPOFF, "x86-ntpoff" }, pair<unsigned int, const char *> { MO_GOTNTPOFF, "x86-gotntpoff" }, pair<unsigned int, const char *> { MO_DLLIMPORT, "x86-dllimport" }, pair<unsigned int, const char *> { MO_DARWIN_NONLAZY, "x86-darwin-nonlazy" }, pair<unsigned int, const char *> { MO_DARWIN_NONLAZY_PIC_BASE, "x86-darwin-nonlazy-pic-base" }, pair<unsigned int, const char *> { MO_TLVP, "x86-tlvp" }, pair<unsigned int, const char *> { MO_TLVP_PIC_BASE, "x86-tlvp-pic-base" }, pair<unsigned int, const char *> { MO_SECREL, "x86-secrel" }, pair<unsigned int, const char *> { MO_COFFSTUB, "x86-coffstub" }];
    return TargetFlags;
}

enum MachineOutlinerClass {
    MachineOutlinerDefault = 0,
    MachineOutlinerTailCall = 1,
}

fn X86InstrInfo::getOutliningCandidateInfo(self: *X86InstrInfo, MMI: *MachineModuleInfo, RepeatedSequenceLocs: *mut []Candidate, MinRepeats: u32) -> OutlinedFunction>> {
    let mut SequenceSize: u32 = 0;
    for MI in RepeatedSequenceLocs[0] {
        if MI.isDebugInstr() || MI.isKill() {
            continue;
        }
        SequenceSize += 1;
    }
    let mut CFICount: u32 = 0;
    for I in RepeatedSequenceLocs[0] {
        if I.isCFIInstruction() {
            CFICount += 1;
        }
    }
    for C in RepeatedSequenceLocs {
        let mut CFIInstructions: []MCCFIInstruction = C.getMF().getFrameInstructions();
        if CFICount > 0 && CFICount != CFIInstructions.len {
            return nullopt;
        }
    }
    if RepeatedSequenceLocs[0].back().isTerminator(AnyInBundle) {
        for C in RepeatedSequenceLocs {
            C.setCallInfo(MachineOutlinerTailCall, 1);
        }
        return make_unique(RepeatedSequenceLocs, SequenceSize, 0, MachineOutlinerTailCall);
    }
    if CFICount > 0 {
        return nullopt;
    }
    for C in RepeatedSequenceLocs {
        C.setCallInfo(MachineOutlinerDefault, 1);
    }
    return make_unique(RepeatedSequenceLocs, SequenceSize, 1, MachineOutlinerDefault);
}

fn X86InstrInfo::isFunctionSafeToOutlineFrom(self: *X86InstrInfo, MF: *mut MachineFunction, OutlineFromLinkOnceODRs: bool) -> bool {
    let mut F: *Function = MF.getFunction();
    if self.Subtarget.getFrameLowering().has128ByteRedZone(MF) {
        let mut X86FI: *X86MachineFunctionInfo = MF.getInfo();
        if !X86FI || X86FI.getUsesRedZone() {
            return false;
        }
    }
    if !OutlineFromLinkOnceODRs && F.hasLinkOnceODRLinkage() {
        return false;
    }
    return true;
}

fn X86InstrInfo::getOutliningTypeImpl(self: *X86InstrInfo, MMI: *MachineModuleInfo, MIT: *mut iterator, Flags: u32) -> InstrType {
    let mut MI: *mut MachineInstr = operator(MIT);
    if MI.isTerminator(AnyInBundle) {
        return Legal;
    }
    if MI.modifiesRegister(RSP, &mut self.RI) || MI.readsRegister(RSP, &mut self.RI) || MI.getDesc().hasImplicitUseOfPhysReg(RSP) || MI.getDesc().hasImplicitDefOfPhysReg(RSP, null) {
        return Illegal;
    }
    if MI.readsRegister(RIP, &mut self.RI) || MI.getDesc().hasImplicitUseOfPhysReg(RIP) || MI.getDesc().hasImplicitDefOfPhysReg(RIP, null) {
        return Illegal;
    }
    if MI.isCFIInstruction() {
        return Illegal;
    }
    return Legal;
}

fn X86InstrInfo::buildOutlinedFrame(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, MF: *mut MachineFunction, OF: *OutlinedFunction) {
    if OF.FrameConstructionID == MachineOutlinerTailCall {
        return;
    }
    let mut retq: *mut MachineInstr = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(RET64)).operator llvm::MachineInstr *();
    MBB.insert(MBB.end(), retq);
}

fn X86InstrInfo::insertOutlinedCall(self: *X86InstrInfo, M: *mut Module, MBB: *mut MachineBasicBlock, It: *mut iterator, MF: *mut MachineFunction, C: *mut Candidate) -> iterator {
    if C.CallConstructionID == MachineOutlinerTailCall {
        It = MBB.insert(It, BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(TAILJMPd64)).addGlobalAddress(M.getNamedValue(MF.getName()), 0, 0).operator llvm::MachineInstr *());
    } else {
        It = MBB.insert(It, BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(CALL64pcrel32)).addGlobalAddress(M.getNamedValue(MF.getName()), 0, 0).operator llvm::MachineInstr *());
    }
    return It;
}

fn X86InstrInfo::buildClearRegister(self: *X86InstrInfo, Reg: Register, MBB: *mut MachineBasicBlock, Iter: iterator, DL: *mut DebugLoc, AllowSideEffects: bool) {
    let mut MF: *MachineFunction = *MBB.getParent();
    let mut ST: *X86Subtarget = MF.getSubtarget();
    let mut TRI: *TargetRegisterInfo = self.getRegisterInfo();
    if ST.hasMMX() && VR64RegClass.contains(Reg.operator MCRegister()) {
        return;
    }
    if TRI.isGeneralPurposeRegister(MF, Reg.operator MCRegister()) {
        Reg = getX86SubSuperRegister(Reg.operator MCRegister(), 32, false);
        if !AllowSideEffects {
            BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOV32ri), Reg).addImm(0);
        } else {
            BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(XOR32rr), Reg).addReg(Reg, Undef, 0).addReg(Reg, Undef, 0);
        }
    } else if VR128RegClass.contains(Reg.operator MCRegister()) {
        if !ST.hasSSE1() {
            return;
        }
        BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(V_SET0), Reg);
    } else if VR256RegClass.contains(Reg.operator MCRegister()) {
        if !ST.hasAVX() {
            return;
        }
        BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(V_SET0), TRI.getSubReg(Reg.operator MCRegister(), sub_xmm));
    } else if VR512RegClass.contains(Reg.operator MCRegister()) {
        if !ST.hasAVX512() {
            return;
        }
        BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(AVX512_128_SET0), TRI.getSubReg(Reg.operator MCRegister(), sub_xmm));
    } else if VK1RegClass.contains(Reg.operator MCRegister()) || VK2RegClass.contains(Reg.operator MCRegister()) || VK4RegClass.contains(Reg.operator MCRegister()) || VK8RegClass.contains(Reg.operator MCRegister()) || VK16RegClass.contains(Reg.operator MCRegister()) {
        if !ST.hasAVX512() {
            return;
        }
        let mut Op: u32 = if ST.hasBWI() { KSET0Q } else { KSET0W };
        BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Op), Reg);
    }
}

fn X86InstrInfo::getMachineCombinerPatterns(self: *X86InstrInfo, Root: *mut MachineInstr, Patterns: *mut SmallVectorImpl<unsigned int>, DoRegPressureReduce: bool) -> bool {
    let mut Opc: u32 = Root.getOpcode();
    match Opc {
        VPDPWSSDrr => {
            VPDPWSSDrm;
        },
        VPDPWSSDZ128rr => {
            VPDPWSSDZ128rm;
        },
    }
    return self.getMachineCombinerPatterns(Root, Patterns, DoRegPressureReduce);
}

fn genAlternativeDpCodeSequence(Root: *mut MachineInstr, TII: *TargetInstrInfo, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, DelInstrs: *mut SmallVectorImpl<MachineInstr *>, InstrIdxForVirtReg: *mut DenseMap<Register, unsigned int>) {
    let mut MF: *mut MachineFunction = Root.getMF();
    let mut RegInfo: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut Opc: u32 = Root.getOpcode();
    let mut AddOpc: u32 = 0;
    let mut MaddOpc: u32 = 0;
    match Opc {
        _ => {
            assert!(false, "It should not reach here");
        },
        VPDPWSSDrr => {
            MaddOpc = VPMADDWDrr;
        },
        VPDPWSSDrm => {
            MaddOpc = VPMADDWDrm;
        },
        VPDPWSSDZ128rr => {
            MaddOpc = VPMADDWDZ128rr;
        },
        VPDPWSSDZ128rm => {
            MaddOpc = VPMADDWDZ128rm;
        },
        VPDPWSSDYrr => {
            MaddOpc = VPMADDWDYrr;
        },
        VPDPWSSDYrm => {
            MaddOpc = VPMADDWDYrm;
        },
        VPDPWSSDZ256rr => {
            MaddOpc = VPMADDWDZ256rr;
        },
        VPDPWSSDZ256rm => {
            MaddOpc = VPMADDWDZ256rm;
        },
        VPDPWSSDZrr => {
            MaddOpc = VPMADDWDZrr;
        },
        VPDPWSSDZrm => {
            MaddOpc = VPMADDWDZrm;
        },
    }
    let mut RC: *TargetRegisterClass = RegInfo.getRegClass(Root.getOperand(0).getReg());
    let mut NewReg: Register = RegInfo.createVirtualRegister(RC, "");
    let mut Madd: *mut MachineInstr = Root.getMF().CloneMachineInstr(&mut Root);
    Madd.setDesc(TII.get(MaddOpc));
    Madd.untieRegOperand(1);
    Madd.removeOperand(1);
    Madd.getOperand(0).setReg(NewReg);
    InstrIdxForVirtReg.insert(make_pair(NewReg, 0));
    let mut DstReg: Register = Root.getOperand(0).getReg();
    let mut IsKill: bool = Root.getOperand(1).isKill();
    let mut Add: *mut MachineInstr = BuildMI(*MF, Root, TII.get(AddOpc), DstReg).addReg(Root.getOperand(1).getReg(), getKillRegState(IsKill), 0).addReg(Madd.getOperand(0).getReg(), getKillRegState(true), 0).operator llvm::MachineInstr *();
    InsInstrs.push(Madd);
    InsInstrs.push(Add);
    DelInstrs.push(&mut Root);
}

fn X86InstrInfo::genAlternativeCodeSequence(self: *X86InstrInfo, Root: *mut MachineInstr, Pattern: u32, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, DelInstrs: *mut SmallVectorImpl<MachineInstr *>, InstrIdxForVirtReg: *mut DenseMap<Register, unsigned int>) {
    match Pattern {
        _ => {
            self.genAlternativeCodeSequence(Root, Pattern, InsInstrs, DelInstrs, InstrIdxForVirtReg);
        },
        DPWSSD => {
            genAlternativeDpCodeSequence(Root, *self, InsInstrs, DelInstrs, InstrIdxForVirtReg);
        },
    }
}

fn X86InstrInfo::getFrameIndexOperands(self: *X86InstrInfo, Ops: *mut SmallVectorImpl<MachineOperand>, FI: i32) {
    let mut M: X86AddressMode = X86AddressMode {};
    M.BaseType = FrameIndexBase;
    M.Base.FrameIndex = FI;
    M.getFullAddress(Ops);
}

fn X86InstrInfo::insertCodePrefetchInstr(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, InsertBefore: iterator, GV: *GlobalValue) -> *mut MachineInstr {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut PrefetchInstr: *mut MachineInstr = MF.CreateMachineInstr(self.get(PREFETCHIT1), if InsertBefore == MBB.instr_end() { MBB.findPrevDebugLoc(InsertBefore) } else { operator(InsertBefore).getDebugLoc() }, true);
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder { MF: MF, MI: PrefetchInstr };
    MIB.addMemOperand(MF.getMachineMemOperand(MachinePointerInfo { GV, 0, 0 }, MOLoad, 8, 1, MMOMetadata {}, System, NotAtomic, NotAtomic));
    MIB.addReg(RIP, RegState {}, 0).addImm(1).addReg(NoRegister, RegState {}, 0);
    MIB.addGlobalAddress(GV, 0, 0);
    MIB.addReg(NoRegister, RegState {}, 0);
    MBB.insert(InsertBefore, PrefetchInstr);
    return PrefetchInstr;
}

struct Closure_1 {
    NewMI: *mut bool,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MI: *mut MachineInstr) -> *mut MachineInstr {
        return if exchange((*self.NewMI), false) { MI.getParent().getParent().CloneMachineInstr(&mut MI) } else { &mut MI };
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, OpInfo: *MCOperandInfo) -> bool {
        return OpInfo.OperandType == OPERAND_MEMORY;
    }

struct Closure_3 {
    TRI: *mut *TargetRegisterInfo,
    NullValueReg: *mut Register,
}

unsafe fn Closure_3::call(self: *mut Closure_3, MO: *MachineOperand) -> bool {
                return (*self.TRI).isSubRegisterEq((*self.NullValueReg).operator MCRegister(), MO.getReg().operator MCRegister());
            }

struct Closure_4 {
    CmpMBB: *mut *mut MachineBasicBlock,
    CmpMBBOnCycle: *mut bool,
    Visited: *mut SmallPtrSet<MachineBasicBlock *, 8>,
    Worklist: *mut SmallVector<MachineBasicBlock *, 8>,
}

unsafe fn Closure_4::call(self: *mut Closure_4, Pred: *mut MachineBasicBlock) {
        if Pred == (*self.CmpMBB) {
            (*self.CmpMBBOnCycle) = true;
        }
        if (*self.Visited).insert(Pred).second {
            (*self.Worklist).push(Pred);
        }
    }

struct Closure_5 {
    cap_0: *X86InstrInfo,
    MF: *mut MachineFunction,
    MI: *mut MachineInstr,
    Ops: *mut ArrayRef<unsigned int>,
    FrameIndex: *mut i32,
    InsertPt: *mut iterator,
    Size: *mut u32,
    Alignment: *mut Align,
    CopyMI: *mut *mut MachineInstr,
    VRM: *mut *mut VirtRegMap,
}

unsafe fn Closure_5::call(self: *mut Closure_5) -> *mut MachineInstr {
        return self.foldMemoryOperandImpl((*self.MF), (*self.MI), (*self.Ops)[0], CreateFI((*self.FrameIndex)), (*self.InsertPt), (*self.Size), (*self.Alignment), true, (*self.CopyMI), (*self.VRM));
    }

struct Closure_6 {}

fn Closure_6::call(self: *Closure_6, RC: *TargetRegisterClass) -> bool {
            return RC == &mut VK2WMRegClass || RC == &mut VK4WMRegClass || RC == &mut VK8WMRegClass || RC == &mut VK16WMRegClass || RC == &mut VK32WMRegClass || RC == &mut VK64WMRegClass;
        }

struct Closure_7 {}

fn Closure_7::call(self: *Closure_7, Opcode: u32) -> bool {
        match Opcode {
            _ => {
                return false;
            },
            MOV8rm => {
                MOV16rm;
            },
        }
    }

struct Closure_8 {
    Load1: *mut *mut SDNode,
    Load2: *mut *mut SDNode,
}

unsafe fn Closure_8::call(self: *mut Closure_8, I: i32) -> bool {
        return (*self.Load1).getOperand(I) == (*self.Load2).getOperand(I);
    }

struct Closure_9 {
    MI: *mut MachineInstr,
    NumOperands: *mut u32,
    cap_2: *X86InstrInfo,
}

unsafe fn Closure_9::call(self: *mut Closure_9, ImmWidth: u32, Is256: bool) -> u16 {
        let mut validDomains: u16 = 0;
        if (*self.MI).getOperand((*self.NumOperands) - 1).isImm() {
            let mut Imm: u32 = (*self.MI).getOperand((*self.NumOperands) - 1).getImm();
            if AdjustBlendMask(Imm, ImmWidth, if Is256 { 8 } else { 4 }, null) {
                validDomains |= 2;
            }
            if AdjustBlendMask(Imm, ImmWidth, if Is256 { 4 } else { 2 }, null) {
                validDomains |= 4;
            }
            if !Is256 || self.Subtarget.hasAVX2() {
                validDomains |= 8;
            }
        }
        return validDomains;
    }

struct Closure_10 {
    MI: *mut MachineInstr,
    NumOperands: *mut u32,
    Opcode: *mut u32,
    dom: *mut u16,
    Domain: *mut u32,
    cap_5: *X86InstrInfo,
}

unsafe fn Closure_10::call(self: *mut Closure_10, ImmWidth: u32, Is256: bool) -> bool {
        if (*self.MI).getOperand((*self.NumOperands) - 1).isImm() {
            let mut Imm: u32 = (*self.MI).getOperand((*self.NumOperands) - 1).getImm() & 255;
            Imm = (if ImmWidth == 16 { ((Imm << 8) | Imm) } else { Imm });
            let mut NewImm: u32 = Imm;
            let mut table: *u16 = lookup((*self.Opcode), (*self.dom), ReplaceableBlendInstrs);
            if !table {
                table = lookup((*self.Opcode), (*self.dom), ReplaceableBlendAVX2Instrs);
            }
            if (*self.Domain) == 1 {
                AdjustBlendMask(Imm, ImmWidth, if Is256 { 8 } else { 4 }, &mut NewImm);
            } else if (*self.Domain) == 2 {
                AdjustBlendMask(Imm, ImmWidth, if Is256 { 4 } else { 2 }, &mut NewImm);
            } else if (*self.Domain) == 3 {
                if self.Subtarget.hasAVX2() {
                    if (ImmWidth / (if Is256 { 2 } else { 1 })) != 8 {
                        table = lookup((*self.Opcode), (*self.dom), ReplaceableBlendAVX2Instrs);
                        AdjustBlendMask(Imm, ImmWidth, if Is256 { 8 } else { 4 }, &mut NewImm);
                    }
                } else {
                    assert!(!Is256, "128-bit vector expected");
                    AdjustBlendMask(Imm, ImmWidth, 8, &mut NewImm);
                }
            }
            assert!(table && table[(*self.Domain) - 1], "Unknown domain op");
            (*self.MI).setDesc(self.get(table[(*self.Domain) - 1]));
            (*self.MI).getOperand((*self.NumOperands) - 1).setImm(NewImm & 255);
        }
        return true;
    }
