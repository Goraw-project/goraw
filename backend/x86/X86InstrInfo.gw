fn fuseTwoAddrInst(MF: *mut MachineFunction, Opcode: u32, MOs: ArrayRef<MachineOperand>, InsertPt: i32, MI: *mut MachineInstr, TII: *TargetInstrInfo) -> *mut MachineInstr {
    let mut NewMI: *mut MachineInstr = MF.CreateMachineInstr(TII.get, MI.getDebugLoc(), true);
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder { MF: MF, MI: NewMI };
    addOperands(MIB);
    let mut NumOps: u32 = MI.getDesc().getNumOperands() - 2;
    for let mut i: u32 = 0; i != NumOps; i += 1 {
        let mut MO: *mut MachineOperand = MI.getOperand(i + 2);
        MIB()(MO);
