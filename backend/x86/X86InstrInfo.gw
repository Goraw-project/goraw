        }
        let mut XReg: Register = TRI.getSubReg;
        BuildMI(*MI.getParent(), MI, MI.getDebugLoc(), get(), XReg)(XReg, Undef)(XReg, Undef)(Reg, ImplicitDefine);
        MI.addRegisterKilled(Reg, TRI, true);
    } else if  {
        let mut XReg: Register = TRI.getSubReg;
        BuildMI(*MI.getParent(), MI, MI.getDebugLoc(), get(), XReg)(XReg, Undef)(XReg, Undef)(Reg, ImplicitDefine);
        MI.addRegisterKilled(Reg, TRI, true);
    } else if  {
        BuildMI(*MI.getParent(), MI, MI.getDebugLoc(), get(), Reg)(Reg, Undef)(Reg, Undef);
        MI.addRegisterKilled(Reg, TRI, true);
