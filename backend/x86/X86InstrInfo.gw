    updateOperandRegConstraints(MF, *NewMI, TII);
    let mut MBB: *mut MachineBasicBlock = ();
    MBB()(NewMI);
    return MIB.operator llvm::MachineInstr *();
}

fn fuseInst(MF: *mut MachineFunction, Opcode: u32, OpNo: u32, MOs: ArrayRef<MachineOperand>, InsertPt: i32, MI: *mut MachineInstr, TII: *TargetInstrInfo, PtrOffset: i32) -> *mut MachineInstr {
    let mut NewMI: *mut MachineInstr = MF.CreateMachineInstr(TII.get, MI.getDebugLoc(), true);
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder { MF: MF, MI: NewMI };
    for let mut i: u32 = 0;
let mut e: u32 = MI.getNumOperands(); i != e; i += 1 {
        let mut MO: *mut MachineOperand = MI.getOperand(i);
        if i == OpNo {
            assert!(MO.isReg(), "Expected to fold into reg operand!");
            addOperands(MIB, PtrOffset);
        } else {
            MIB()(MO);
        }
    }
    updateOperandRegConstraints(MF, *NewMI, TII);
    if MI.getFlag(NoFPExcept) {
        NewMI.setFlag(NoFPExcept);
    }
    let mut MBB: *mut MachineBasicBlock = ();
    MBB()(NewMI);
    return MIB.operator llvm::MachineInstr *();
}

