static mut X86EnableAPXForRelocation: opt<bool> = zeroed();

static mut NoFusing: opt<bool> = opt<bool> { "disable-spill-fusing", "Disable fusing of spill code into instructions", Hidden };

static mut PrintFailedFusing: opt<bool> = opt<bool> { "print-failed-fuse-candidates", "Print instructions that the allocator wants to fuse, but the X86 backend currently can't", Hidden };

static mut ReMatPICStubLoad: opt<bool> = opt<bool> { "remat-pic-stub-load", "Re-materialize load from stub in PIC mode", init(false), Hidden };

static mut PartialRegUpdateClearance: opt<unsigned int> = opt<unsigned int> { "partial-reg-update-clearance", "Clearance between two register writes for inserting XOR to avoid partial register update", init(64), Hidden };

static mut UndefRegClearance: opt<unsigned int> = opt<unsigned int> { "undef-reg-clearance", "How many idle instructions we would like before certain undef register reads", init(128), Hidden };

static mut MaxNFConversions: opt<unsigned int> = opt<unsigned int> { "x86-max-nf-conversions-for-cmp-reuse", "Maximum number of NF conversions allowed to reuse EFLAGS from a producer dominating a multi-predecessor block", init(6), Hidden };

fn X86InstrInfo::anchor(self) {}

fn X86InstrInfo::getRegClass(self: *X86InstrInfo, MCID: *MCInstrDesc, OpNum: u32) -> *TargetRegisterClass {
    let mut RC: *TargetRegisterClass = self.getRegClass(MCID, OpNum);
    if !RC || !self.Subtarget.hasEGPR() {
        return RC;
    }
    if canUseApxExtendedReg(MCID) {
        return RC;
    }
    let mut RI: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    return RI.constrainRegClassToNonRex2(RC);
}

fn X86InstrInfo::getInlineAsmMemoryOperandRegClass(self: *X86InstrInfo, C: ConstraintCode) -> *TargetRegisterClass {
    if self.Subtarget.isTarget64BitLP64() {
        return &mut GR64RegClass;
    }
    return if self.Subtarget.is64Bit() { &mut LOW32_ADDR_ACCESSRegClass } else { &mut GR32RegClass };
}

fn X86InstrInfo::isCoalescableExtInstr(self: *X86InstrInfo, MI: *MachineInstr, SrcReg: *mut Register, DstReg: *mut Register, SubIdx: *mut u32) -> bool {
    match MI.getOpcode() {
        _ => {
            break;
        },
        MOVSX16rr8 => {
            MOVZX16rr8;
        },
        MOVSX32rr16 => {
            MOVZX32rr16;
        },
    }
    return false;
}

fn X86InstrInfo::isDataInvariant(self, MI: *mut MachineInstr) -> bool {
    if MI.mayLoad(AnyInBundle) || MI.mayStore(AnyInBundle) {
        return false;
    }
    if MI.isCopyLike() || MI.isInsertSubreg() {
        return true;
    }
    let mut Opcode: u32 = MI.getOpcode();
    if isIMUL(Opcode) {
        return true;
    }
    if isBSF(Opcode) || isBSR(Opcode) || isLZCNT(Opcode) || isPOPCNT(Opcode) || isTZCNT(Opcode) {
        return true;
    }
    if isBLCFILL(Opcode) || isBLCI(Opcode) || isBLCIC(Opcode) || isBLCMSK(Opcode) || isBLCS(Opcode) || isBLSFILL(Opcode) || isBLSI(Opcode) || isBLSIC(Opcode) || isBLSMSK(Opcode) || isBLSR(Opcode) || isTZMSK(Opcode) {
        return true;
    }
    if isBEXTR(Opcode) || isBZHI(Opcode) {
        return true;
    }
    if isROL(Opcode) || isROR(Opcode) || isSAR(Opcode) || isSHL(Opcode) || isSHR(Opcode) || isSHLD(Opcode) || isSHRD(Opcode) {
        return true;
    }
    if isADC(Opcode) || isADD(Opcode) || isAND(Opcode) || isOR(Opcode) || isSBB(Opcode) || isSUB(Opcode) || isXOR(Opcode) {
        return true;
    }
    if isANDN(Opcode) {
        return true;
    }
    if isDEC(Opcode) || isINC(Opcode) || isNEG(Opcode) {
        return true;
    }
    if isNOT(Opcode) {
        return true;
    }
    if isMOVSX(Opcode) || isMOVZX(Opcode) || isMOVSXD(Opcode) || isMOV(Opcode) {
        return true;
    }
    if isRORX(Opcode) || isSARX(Opcode) || isSHLX(Opcode) || isSHRX(Opcode) {
        return true;
    }
    if isLEA(Opcode) {
        return true;
    }
    return false;
}

fn X86InstrInfo::isDataInvariantLoad(self, MI: *mut MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        IMUL16rm => {
            IMUL16rmi;
        },
    }
}

fn X86InstrInfo::getSPAdjust(self: *X86InstrInfo, MI: *MachineInstr) -> i32 {
    let mut MF: *MachineFunction = MI.getParent().getParent();
    let mut TFI: *TargetFrameLowering = MF.getSubtarget().getFrameLowering();
    if self.isFrameInstr(MI) {
        let mut SPAdj: i32 = alignTo(self.getFrameSize(MI), TFI.getStackAlign());
        SPAdj -= self.getFrameAdjustment(MI);
        if !self.isFrameSetup(MI) {
            SPAdj = -SPAdj;
        }
        return SPAdj;
    }
    if MI.isCall(AnyInBundle) {
        let mut MBB: *MachineBasicBlock = MI.getParent();
        let mut I: MachineInstr> = operator(MI);
        for let mut E: const_iterator = MBB.end(); I != E; operator(I) {
            if operator(I).getOpcode() == self.getCallFrameDestroyOpcode() || operator(I).isCall(AnyInBundle) {
                break;
            }
        }
        if operator(I).getOpcode() != self.getCallFrameDestroyOpcode() {
            return 0;
        }
        return -(operator(I).getOperand(1).getImm());
    }
    match MI.getOpcode() {
        _ => {
            return 0;
        },
        PUSH32r => {
            PUSH32rmm;
        },
        PUSH64r => {
            PUSH64rmm;
        },
    }
}

fn X86InstrInfo::isFrameOperand(self: *X86InstrInfo, MI: *MachineInstr, Op: u32, FrameIndex: *mut i32) -> bool {
    if MI.getOperand(Op + AddrBaseReg).isFI() && MI.getOperand(Op + AddrScaleAmt).isImm() && MI.getOperand(Op + AddrIndexReg).isReg() && MI.getOperand(Op + AddrDisp).isImm() && MI.getOperand(Op + AddrScaleAmt).getImm() == 1 && MI.getOperand(Op + AddrIndexReg).getReg() == 0 && MI.getOperand(Op + AddrDisp).getImm() == 0 {
        FrameIndex = MI.getOperand(Op + AddrBaseReg).getIndex();
        return true;
    }
    return false;
}

fn isFrameLoadOpcode(Opcode: i32, MemBytes: *mut TypeSize) -> bool {
    match Opcode {
        _ => {
            return false;
        },
        MOV8rm => {
            KMOVBkm;
        },
        MOV16rm => {
            KMOVWkm;
        },
        MOV32rm => {
            MOVSSrm;
        },
        MOV64rm => {
            LD_Fp64m;
        },
        MOVAPSrm => {
            MOVUPSrm;
        },
        VMOVAPSYrm => {
            VMOVUPSYrm;
        },
        VMOVAPSZrm => {
            VMOVUPSZrm;
        },
    }
}

fn isFrameStoreOpcode(Opcode: i32, MemBytes: *mut TypeSize) -> bool {
    match Opcode {
        _ => {
            return false;
        },
        MOV8mr => {
            KMOVBmk;
        },
        MOV16mr => {
            KMOVWmk;
        },
        MOV32mr => {
            MOVSSmr;
        },
        MOV64mr => {
            ST_FpP64m;
        },
        MOVAPSmr => {
            MOVUPSmr;
        },
        VMOVUPSYmr => {
            VMOVAPSYmr;
        },
        VMOVUPSZmr => {
            VMOVAPSZmr;
        },
    }
    return false;
}

fn X86InstrInfo::isLoadFromStackSlot(self: *X86InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32) -> Register {
    let mut Dummy: TypeSize = getZero();
    return self.isLoadFromStackSlot(MI, FrameIndex, Dummy);
}

fn X86InstrInfo::isLoadFromStackSlot(self: *X86InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32, MemBytes: *mut TypeSize) -> Register {
    if isFrameLoadOpcode(MI.getOpcode(), MemBytes) {
        if MI.getOperand(0).getSubReg() == 0 && self.isFrameOperand(MI, 1, FrameIndex) {
            return MI.getOperand(0).getReg();
        }
    }
    return Register { Reg: 0 };
}

fn X86InstrInfo::isLoadFromStackSlotPostFE(self: *X86InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32) -> Register {
    let mut Dummy: TypeSize = getZero();
    if isFrameLoadOpcode(MI.getOpcode(), Dummy) {
        if self.isLoadFromStackSlot(MI, FrameIndex) {
            Reg.operator unsigned int();
        } else {
            return Reg;
        }
        let mut Accesses: SmallVector<const MachineMemOperand *, 1> = SmallVector<const MachineMemOperand *, 1> {};
        if self.hasLoadFromStackSlot(MI, Accesses) {
            FrameIndex = cast(Accesses.front().getPseudoValue()).getFrameIndex();
            return MI.getOperand(0).getReg();
        }
    }
    return Register { Reg: 0 };
}

fn X86InstrInfo::isStoreToStackSlot(self: *X86InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32) -> Register {
    let mut Dummy: TypeSize = getZero();
    return self.isStoreToStackSlot(MI, FrameIndex, Dummy);
}

fn X86InstrInfo::isStoreToStackSlot(self: *X86InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32, MemBytes: *mut TypeSize) -> Register {
    if isFrameStoreOpcode(MI.getOpcode(), MemBytes) {
        if MI.getOperand(AddrNumOperands).getSubReg() == 0 && self.isFrameOperand(MI, 0, FrameIndex) {
            return MI.getOperand(AddrNumOperands).getReg();
        }
    }
    return Register { Reg: 0 };
}

fn X86InstrInfo::isStoreToStackSlotPostFE(self: *X86InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32) -> Register {
    let mut Dummy: TypeSize = getZero();
    if isFrameStoreOpcode(MI.getOpcode(), Dummy) {
        if self.isStoreToStackSlot(MI, FrameIndex) {
            Reg.operator unsigned int();
        } else {
            return Reg;
        }
        let mut Accesses: SmallVector<const MachineMemOperand *, 1> = SmallVector<const MachineMemOperand *, 1> {};
        if self.hasStoreToStackSlot(MI, Accesses) {
            FrameIndex = cast(Accesses.front().getPseudoValue()).getFrameIndex();
            return MI.getOperand(AddrNumOperands).getReg();
        }
    }
    return Register { Reg: 0 };
}

fn regIsPICBase(BaseReg: Register, MRI: *MachineRegisterInfo) -> bool {
    if !BaseReg.isVirtual() {
        return false;
    }
    let mut isPICBase: bool = false;
    for DefMI in MRI.def_instructions(BaseReg) {
        if DefMI.getOpcode() != MOVPC32r {
            return false;
        }
        assert!(!isPICBase, "More than one PIC base?");
        isPICBase = true;
    }
    return isPICBase;
}

fn X86InstrInfo::isReMaterializableImpl(self: *X86InstrInfo, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unknown rematerializable operation!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 779);
        },
        IMPLICIT_DEF => {
            break;
        },
        LOAD_STACK_GUARD => {
            LD_Fp032;
        },
        MOV8rm => {
            MOV8rm_NOREX;
        },
        LEA32r => {
            LEA64r;
        },
    }
    return self.isReMaterializableImpl(MI);
}

fn X86InstrInfo::reMaterialize(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, I: iterator, DestReg: Register, SubIdx: u32, Orig: *MachineInstr, UsedLanes: LaneBitmask) {
    let mut ClobbersEFLAGS: bool = Orig.modifiesRegister(EFLAGS, &mut self.TRI);
    if ClobbersEFLAGS && MBB.computeRegisterLiveness(&mut self.TRI, EFLAGS, const_iterator { map: I, path: null }, 10) != LQR_Dead {
        let mut Value: i32 = 0;
        match Orig.getOpcode() {
            MOV32r0 => {
                Value = 0;
            },
            MOV32r1 => {
                Value = 1;
            },
            MOV32r_1 => {
                Value = -1;
            },
            _ => {
                llvm_unreachable_internal("Unexpected instruction!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 995);
            },
        }
        let mut DL: *DebugLoc = Orig.getDebugLoc();
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOV32ri)).add(Orig.getOperand(0)).addImm(Value);
    } else {
        let mut MI: *mut MachineInstr = MBB.getParent().CloneMachineInstr(&mut Orig);
        MBB.insert(I, MI);
    }
    let mut NewMI: *mut MachineInstr = operator(prev(I, 1));
    NewMI.substituteRegister(Orig.getOperand(0).getReg(), DestReg, SubIdx, self.TRI);
}

fn X86InstrInfo::hasLiveCondCodeDef(self: *X86InstrInfo, MI: *mut MachineInstr) -> bool {
    for MO in MI.operands() {
        if MO.isReg() && MO.isDef() && MO.getReg() == EFLAGS && !MO.isDead() {
            return true;
        }
    }
    return false;
}

fn getTruncatedShiftCount(MI: *MachineInstr, ShiftAmtOperandIdx: u32) -> u32 {
    let mut ShiftCountMask: u32 = if (MI.getDesc().TSFlags & REX_W) { 63 } else { 31 };
    let mut Imm: u32 = MI.getOperand(ShiftAmtOperandIdx).getImm();
    return Imm & ShiftCountMask;
}

fn isTruncatedShiftCountForLEA(ShAmt: u32) -> bool {
    return ShAmt < 4 && ShAmt > 0;
}

fn findRedundantFlagInstr(CmpInstr: *mut MachineInstr, CmpValDefInstr: *mut MachineInstr, MRI: *MachineRegisterInfo, AndInstr: *mut *mut MachineInstr, TRI: *TargetRegisterInfo, ST: *X86Subtarget, NoSignFlag: *mut bool, ClearsOverflowFlag: *mut bool) -> bool {
    if !(CmpValDefInstr.getOpcode() == SUBREG_TO_REG && CmpInstr.getOpcode() == TEST64rr) && !(CmpValDefInstr.getOpcode() == COPY && CmpInstr.getOpcode() == TEST16rr) {
        return false;
    }
    assert!((CmpInstr.getOperand(0).getReg() == CmpInstr.getOperand(1).getReg()), "CmpInstr is an analyzable TEST16rr/TEST64rr, and `X86InstrInfo::analyzeCompare` requires two reg operands are thesame.");
    assert!((MRI.getVRegDef(CmpInstr.getOperand(0).getReg()) == &mut CmpValDefInstr), "Caller guarantees that TEST64rr is a user of SUBREG_TO_REG or TEST16rr is a user of COPY sub16bit.");
    let mut VregDefInstr: *mut MachineInstr = null;
    if CmpInstr.getOpcode() == TEST16rr {
        if !CmpValDefInstr.getOperand(1).getReg().isVirtual() {
            return false;
        }
        VregDefInstr = MRI.getVRegDef(CmpValDefInstr.getOperand(1).getReg());
        if !VregDefInstr {
            return false;
        }
        if !((VregDefInstr.getOpcode() == AND32ri || VregDefInstr.getOpcode() == AND64ri32) && isUInt(VregDefInstr.getOperand(2).getImm())) {
            return false;
        }
    }
    if CmpInstr.getOpcode() == TEST64rr {
        if CmpValDefInstr.getOperand(2).getImm() != sub_32bit {
            return false;
        }
        VregDefInstr = MRI.getVRegDef(CmpValDefInstr.getOperand(1).getReg());
    }
    assert!(VregDefInstr, "Must have a definition (SSA)");
    if VregDefInstr.getParent() != CmpValDefInstr.getParent() {
        return false;
    }
    if isAND(VregDefInstr.getOpcode()) && (!ST.hasNF() || VregDefInstr.modifiesRegister(EFLAGS, TRI)) {
        for Instr in make_range(next(VregDefInstr, 1), CmpValDefInstr) {
            if Instr.modifiesRegister(EFLAGS, TRI) {
                return false;
            }
        }
        *AndInstr = VregDefInstr;
        NoSignFlag = true;
        ClearsOverflowFlag = true;
        return true;
    }
    return false;
}

fn X86InstrInfo::classifyLEAReg(self: *X86InstrInfo, MI: *mut MachineInstr, Src: *MachineOperand, Opc: u32, AllowSP: bool, NewSrc: *mut Register, NewSrcSubReg: *mut u32, isKill: *mut bool, ImplicitOp: *mut MachineOperand, LIS: *mut LiveIntervals) -> bool {
    let mut MF: *mut MachineFunction = *MI.getParent().getParent();
    let mut RC: *TargetRegisterClass = null;
    if AllowSP {
        RC = if Opc != LEA32r { &mut GR64RegClass } else { &mut GR32RegClass };
    } else {
        RC = if Opc != LEA32r { &mut GR64_NOSPRegClass } else { &mut GR32_NOSPRegClass };
    }
    let mut SrcReg: Register = Src.getReg();
    let mut SubReg: u32 = Src.getSubReg();
    isKill = MI.killsRegister(SrcReg, null);
    NewSrcSubReg = NoSubRegister;
    if Opc != LEA64_32r {
        NewSrc = SrcReg;
        NewSrcSubReg = SubReg;
        assert!(!Src.isUndef(), "Undef op doesn't need optimization");
        if NewSrc.isVirtual() && !MF.getRegInfo().constrainRegClass(NewSrc, RC, 0) {
            return false;
        }
        return true;
    }
    if SrcReg.isPhysical() {
        ImplicitOp = Src;
        ImplicitOp.setImplicit(true);
        NewSrc = getX86SubSuperRegister(SrcReg.operator MCRegister(), 64, false);
        assert!(!SubReg, "no superregister for source");
        assert!(NewSrc.isValid(), "Invalid Operand");
        assert!(!Src.isUndef(), "Undef op doesn't need optimization");
    } else {
        NewSrc = MF.getRegInfo().createVirtualRegister(RC, "");
        NewSrcSubReg = NoSubRegister;
        let mut Copy: *mut MachineInstr = BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(COPY)).addReg(NewSrc, Define | Undef, sub_32bit).addReg(SrcReg, getKillRegState(isKill), SubReg).operator llvm::MachineInstr *();
        isKill = true;
        if LIS {
            let mut CopyIdx: SlotIndex = LIS.InsertMachineInstrInMaps(*Copy);
            let mut Idx: SlotIndex = LIS.getInstructionIndex(MI);
            let mut LI: *mut LiveInterval = LIS.getInterval(SrcReg);
            let mut S: *mut Segment = LI.getSegmentContaining(Idx);
            if S.end.getBaseIndex() == Idx {
                S.end = CopyIdx.getRegSlot(false);
            }
        }
    }
    return true;
}

fn X86InstrInfo::convertToThreeAddressWithLEA(self: *X86InstrInfo, MIOpc: u32, MI: *mut MachineInstr, LIS: *mut LiveIntervals, Is8BitOp: bool) -> *mut MachineInstr {
    let mut MBB: *mut MachineBasicBlock = *MI.getParent();
    let mut RegInfo: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    assert!((Is8BitOp || RegInfo.getTargetRegisterInfo().getRegSizeInBits(*RegInfo.getRegClass(MI.getOperand(0).getReg())).operator unsigned long long() == 16), "Unexpected type for LEA transform");
    if !self.Subtarget.is64Bit() {
        return null;
    }
    let mut Opcode: u32 = LEA64_32r;
    let mut InRegLEA: Register = RegInfo.createVirtualRegister(&mut GR64_NOSPRegClass, "");
    let mut OutRegLEA: Register = RegInfo.createVirtualRegister(&mut GR32RegClass, "");
    let mut InRegLEA2: Register = 0;
    let mut MBBI: iterator = MI.getIterator();
    let mut Dest: Register = MI.getOperand(0).getReg();
    let mut Src: Register = MI.getOperand(1).getReg();
    let mut SrcSubReg: u32 = MI.getOperand(1).getSubReg();
    let mut Src2: Register = 0;
    let mut Src2SubReg: u32 = 0;
    let mut IsDead: bool = MI.getOperand(0).isDead();
    let mut IsKill: bool = MI.getOperand(1).isKill();
    let mut SubReg: u32 = if Is8BitOp { sub_8bit } else { sub_16bit };
    assert!(!MI.getOperand(1).isUndef(), "Undef op doesn't need optimization");
    let mut ImpDef: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(IMPLICIT_DEF), InRegLEA).operator llvm::MachineInstr *();
    let mut InsMI: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(COPY)).addReg(InRegLEA, Define, SubReg).addReg(Src, getKillRegState(IsKill), SrcSubReg).operator llvm::MachineInstr *();
    let mut ImpDef2: *mut MachineInstr = null;
    let mut InsMI2: *mut MachineInstr = null;
    let mut MIB: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opcode), OutRegLEA);
    match MIOpc {
        _ => {
            llvm_unreachable_internal("Unreachable!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 1284);
        },
        SHL8ri => {
            SHL8ri_NF;
        },
        INC8r => {
            INC8r_NF;
        },
        DEC8r => {
            DEC8r_NF;
        },
        ADD8ri => {
            ADD8ri_NF;
        },
        ADD8rr => {
            ADD8rr_NF;
        },
    }
    let mut NewMI: *mut MachineInstr = MIB.operator llvm::MachineInstr *();
    let mut ExtMI: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(COPY)).addReg(Dest, Define | getDeadRegState(IsDead), 0).addReg(OutRegLEA, Kill, SubReg).operator llvm::MachineInstr *();
    if LIS {
        LIS.InsertMachineInstrInMaps(*ImpDef);
        let mut InsIdx: SlotIndex = LIS.InsertMachineInstrInMaps(*InsMI);
        if ImpDef2 {
            LIS.InsertMachineInstrInMaps(*ImpDef2);
        }
        let mut Ins2Idx: SlotIndex = SlotIndex {};
        if InsMI2 {
            Ins2Idx = LIS.InsertMachineInstrInMaps(*InsMI2);
        }
        let mut NewIdx: SlotIndex = LIS.ReplaceMachineInstrInMaps(MI, *NewMI);
        let mut ExtIdx: SlotIndex = LIS.InsertMachineInstrInMaps(*ExtMI);
        LIS.removePhysRegDefAt(EFLAGS, NewIdx.getRegSlot(false));
        LIS.getInterval(InRegLEA);
        LIS.getInterval(OutRegLEA);
        if InRegLEA2.operator unsigned int() {
            LIS.getInterval(InRegLEA2);
        }
        let mut SrcLI: *mut LiveInterval = LIS.getInterval(Src);
        let mut SrcSeg: *mut Segment = SrcLI.getSegmentContaining(NewIdx);
        if SrcSeg.end == NewIdx.getRegSlot(false) {
            SrcSeg.end = InsIdx.getRegSlot(false);
        }
        if InsMI2 {
            let mut Src2LI: *mut LiveInterval = LIS.getInterval(Src2);
            let mut Src2Seg: *mut Segment = Src2LI.getSegmentContaining(NewIdx);
            if Src2Seg.end == NewIdx.getRegSlot(false) {
                Src2Seg.end = Ins2Idx.getRegSlot(false);
            }
        }
        let mut DestLI: *mut LiveInterval = LIS.getInterval(Dest);
        let mut DestSeg: *mut Segment = DestLI.getSegmentContaining(NewIdx.getRegSlot(false));
        assert!(DestSeg.start == NewIdx.getRegSlot(false) && DestSeg.valno.def == NewIdx.getRegSlot(false);
        DestSeg.start = ExtIdx.getRegSlot(false);
        DestSeg.valno.def = ExtIdx.getRegSlot(false);
    }
    return ExtMI;
}

fn X86InstrInfo::convertToThreeAddress(self: *X86InstrInfo, MI: *mut MachineInstr, LIS: *mut LiveIntervals) -> *mut MachineInstr {
    if self.hasLiveCondCodeDef(MI) {
        return null;
    }
    let mut MF: *mut MachineFunction = *MI.getParent().getParent();
    let mut Dest: *MachineOperand = MI.getOperand(0);
    let mut Src: *MachineOperand = MI.getOperand(1);
    if Src.isUndef() {
        return null;
    }
    if MI.getNumOperands() > 2 {
        if MI.getOperand(2).isReg() && MI.getOperand(2).isUndef() {
            return null;
        }
    }
    let mut NewMI: *mut MachineInstr = null;
    let mut SrcReg: Register = 0;
    let mut SrcReg2: Register = 0;
    let mut SrcSubReg: u32 = 0;
    let mut SrcSubReg2: u32 = 0;
    let mut Is64Bit: bool = self.Subtarget.is64Bit();
    let mut Is8BitOp: bool = false;
    let mut MIOpc: u32 = MI.getOpcode();
    match MIOpc {
        _ => {
            llvm_unreachable_internal("Unreachable!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 1435);
        },
        SHL64ri => {
            SHL64ri_NF;
        },
        SHL32ri => {
            SHL32ri_NF;
        },
