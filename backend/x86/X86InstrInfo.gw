fn genAlternativeDpCodeSequence(Root: *mut MachineInstr, TII: *TargetInstrInfo, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, DelInstrs: *mut SmallVectorImpl<MachineInstr *>, InstrIdxForVirtReg: *mut i32) {
    let mut MF: *mut MachineFunction = Root.getMF();
    let mut RegInfo: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut Opc: u32 = Root.getOpcode();
    let mut AddOpc: u32 = 0;
    let mut MaddOpc: u32 = 0;
    match Opc {
        _ => {
            assert!(false, "It should not reach here");
        },
    }
    let mut RC: *TargetRegisterClass = RegInfo.getRegClass(Root.getOperand(0).getReg());
    let mut NewReg: Register = RegInfo.createVirtualRegister(RC, "");
    let mut Madd: *mut MachineInstr = Root.getMF().CloneMachineInstr(&mut Root);
    Madd.setDesc(TII.get);
    Madd.untieRegOperand(1);
    Madd.removeOperand(1);
    Madd.getOperand(0).setReg(NewReg);
    InstrIdxForVirtReg()(make_pair(NewReg, 0));
    let mut DstReg: Register = Root.getOperand(0).getReg();
    let mut IsKill: bool = Root.getOperand(1).isKill();
    let mut Add: *mut MachineInstr = BuildMI(*MF, MIMetadata { Root }, TII.get, DstReg)(Root.getOperand(1).getReg(), getKillRegState(IsKill))(Madd.getOperand(0).getReg(), getKillRegState(true));
    InsInstrs()(Madd);
    InsInstrs()(Add);
    DelInstrs()(&mut Root);
}

fn X86InstrInfo::genAlternativeCodeSequence(self: *X86InstrInfo, Root: *mut MachineInstr, Pattern: u32, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, DelInstrs: *mut SmallVectorImpl<MachineInstr *>, InstrIdxForVirtReg: *mut i32) {
    match Pattern {
        _ => {
            
        },
        DPWSSD => {
            genAlternativeDpCodeSequence(Root, *self, InsInstrs, DelInstrs);
        },
    }
}

fn X86InstrInfo::getFrameIndexOperands(self: *X86InstrInfo, Ops: *mut SmallVectorImpl<MachineOperand>, FI: i32) {
    let mut M: X86AddressMode = X86AddressMode {};
    M.BaseType = FrameIndexBase;
    M.Base.FrameIndex = FI;
    M.getFullAddress(Ops);
}

fn X86InstrInfo::insertCodePrefetchInstr(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, InsertBefore: i32, GV: *GlobalValue) -> *mut MachineInstr {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut PrefetchInstr: *mut MachineInstr = MF.CreateMachineInstr(get(), if  == MBB()() { MBB()() } else { () }, true);
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder { MF: MF, MI: PrefetchInstr };
    operator(MIB).addMemOperand;
    MIB()(1);
    MIB()(GV);
    MIB();
    MBB()(PrefetchInstr);
    return PrefetchInstr;
}

struct Closure_1 {
    NewMI: *mut bool,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MI: *mut MachineInstr) -> auto {}

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, OpInfo: *MCOperandInfo) -> bool {
        return OpInfo.OperandType == OPERAND_MEMORY;
    }

struct Closure_3 {
    CmpMBB: *mut *mut MachineBasicBlock,
    CmpMBBOnCycle: *mut bool,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Pred: *mut MachineBasicBlock) {
        if Pred == (*self.CmpMBB) {
            (*self.CmpMBBOnCycle) = true;
        }
        if Visited()(Pred) {
            Worklist()(Pred);
        }
    }

