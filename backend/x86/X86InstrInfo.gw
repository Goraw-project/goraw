        ADD64rr => {
            ADD64rr_NF;
        },
        ADD8rr => {
            ADD8rr_NF;
        },
        ADD16rr => {
            ADD16rr_NF;
        },
        ADD64ri32 => {
            ADD64ri32_NF;
        },
        ADD32ri => {
            ADD32ri_NF;
        },
        ADD8ri => {
            ADD8ri_NF;
        },
        ADD16ri => {
            ADD16ri_NF;
        },
        SUB8ri => {
            SUB8ri_NF;
        },
        SUB32ri => {
            SUB32ri_NF;
