fn X86InstrInfo::commuteInstructionImpl(self: *X86InstrInfo, MI: *mut MachineInstr, NewMI: bool, OpIdx1: u32, OpIdx2: u32) -> *mut MachineInstr {
    let mut CloneIfNew: Closure_1 = Closure_1 { NewMI: &mut NewMI };
    let mut WorkingMI: *mut MachineInstr = null;
    let mut Opc: u32 = MI.getOpcode();
    match Opc {
        SHRD16rri8 => {
            SHRD16rri8_ND;
        },
        PFSUBrr => {
            PFSUBRrr;
        },
        BLENDPDrri => {
            BLENDPSrri;
        },
        INSERTPSrri => {
            VINSERTPSrri;
        },
        MOVSDrr => {
            MOVSSrr;
        },
        SHUFPDrri => {
            assert!(MI.getOperand(3).getImm() == 2, "Unexpected immediate!");
            WorkingMI = CloneIfNew.call(MI);
            WorkingMI.setDesc(self.get(MOVSDrr));
            WorkingMI.removeOperand(3);
            break;
        },
        PCLMULQDQrri => {
            VPCLMULQDQrri;
        },
        VPCMPBZ128rri => {
            VPCMPUBZ128rri;
        },
        VPCOMBri => {
            VPCOMUBri;
        },
        VCMPSDZrri => {
            VCMPSSZrri;
        },
        VPERM2F128rri => {
            VPERM2I128rri;
        },
        MOVHLPSrr => {
            UNPCKHPDrr;
        },
        CMOV16rr => {
            CMOV16rr_ND;
        },
        VPTERNLOGDZrri => {
            VPTERNLOGDZrmi;
        },
        _ => {
            if isCommutableVPERMV3Instruction(Opc) {
                WorkingMI = CloneIfNew.call(MI);
                WorkingMI.setDesc(self.get(getCommutedVPERMV3Opcode(Opc)));
                break;
            }
        },
    }
    return self.commuteInstructionImpl(MI, NewMI, OpIdx1, OpIdx2);
}

fn X86InstrInfo::findThreeSrcCommutedOpIndices(self: *X86InstrInfo, MI: *MachineInstr, SrcOpIdx1: *mut u32, SrcOpIdx2: *mut u32, IsIntrinsic: bool) -> bool {
    let mut TSFlags: u64 = MI.getDesc().TSFlags;
    let mut FirstCommutableVecOp: u32 = 1;
    let mut LastCommutableVecOp: u32 = 3;
    let mut KMaskOp: u32 = -1;
    if isKMasked(TSFlags) {
        KMaskOp = 2;
        if isKMergeMasked(TSFlags) || IsIntrinsic {
            FirstCommutableVecOp = 3;
        }
        LastCommutableVecOp += 1;
    } else if IsIntrinsic {
        FirstCommutableVecOp = 2;
    }
    if isMem(MI, LastCommutableVecOp) {
        LastCommutableVecOp -= 1;
    }
    if SrcOpIdx1 != CommuteAnyOperandIndex && (SrcOpIdx1 < FirstCommutableVecOp || SrcOpIdx1 > LastCommutableVecOp || SrcOpIdx1 == KMaskOp) {
        return false;
    }
    if SrcOpIdx2 != CommuteAnyOperandIndex && (SrcOpIdx2 < FirstCommutableVecOp || SrcOpIdx2 > LastCommutableVecOp || SrcOpIdx2 == KMaskOp) {
        return false;
    }
    if SrcOpIdx1 == CommuteAnyOperandIndex || SrcOpIdx2 == CommuteAnyOperandIndex {
        let mut CommutableOpIdx2: u32 = SrcOpIdx2;
        if SrcOpIdx1 == SrcOpIdx2 {
            CommutableOpIdx2 = LastCommutableVecOp;
        } else if SrcOpIdx2 == CommuteAnyOperandIndex {
            CommutableOpIdx2 = SrcOpIdx1;
        }
        let mut Op2Reg: Register = MI.getOperand(CommutableOpIdx2).getReg();
        let mut CommutableOpIdx1: u32 = 0;
        for CommutableOpIdx1 = LastCommutableVecOp; CommutableOpIdx1 >= FirstCommutableVecOp; CommutableOpIdx1 -= 1 {
            if CommutableOpIdx1 == KMaskOp {
                continue;
            }
            if Op2Reg != MI.getOperand(CommutableOpIdx1).getReg() {
                break;
            }
        }
        if CommutableOpIdx1 < FirstCommutableVecOp {
            return false;
        }
        if !fixCommutedOpIndices(SrcOpIdx1, SrcOpIdx2, CommutableOpIdx1, CommutableOpIdx2) {
            return false;
        }
    }
    return true;
}

fn X86InstrInfo::findCommutedOpIndices(self: *X86InstrInfo, MI: *MachineInstr, SrcOpIdx1: *mut u32, SrcOpIdx2: *mut u32) -> bool {
    let mut Desc: *MCInstrDesc = MI.getDesc();
    if !Desc.isCommutable() {
        return false;
    }
    match MI.getOpcode() {
        CMPSDrri => {
            CMPSSrri;
        },
        MOVSSrr => {
            if self.Subtarget.hasSSE41() {
                return self.findCommutedOpIndices(MI, SrcOpIdx1, SrcOpIdx2);
            }
        },
        SHUFPDrri => {
            if MI.getOperand(3).getImm() == 2 {
                return self.findCommutedOpIndices(MI, SrcOpIdx1, SrcOpIdx2);
            }
        },
        MOVHLPSrr => {
            UNPCKHPDrr;
        },
        VPTERNLOGDZrri => {
            VPTERNLOGDZrmi;
        },
        VPDPWSSDYrr => {
            VPDPWSSDrr;
        },
        _ => {
            let mut FMA3Group: *X86InstrFMA3Group = getFMA3Group(MI.getOpcode(), MI.getDesc().TSFlags);
        },
    }
    return false;
}

fn isConvertibleLEA(MI: *mut MachineInstr) -> bool {
    let mut Opcode: u32 = MI.getOpcode();
    if Opcode != LEA32r && Opcode != LEA64r && Opcode != LEA64_32r {
        return false;
    }
    let mut Scale: *MachineOperand = MI.getOperand(1 + AddrScaleAmt);
    let mut Disp: *MachineOperand = MI.getOperand(1 + AddrDisp);
    let mut Segment: *MachineOperand = MI.getOperand(1 + AddrSegmentReg);
    if Segment.getReg() != 0 || !Disp.isImm() || Disp.getImm() != 0 || Scale.getImm() > 1 {
        return false;
    }
    return true;
}

fn X86InstrInfo::hasCommutePreference(self: *X86InstrInfo, MI: *mut MachineInstr, Commute: *mut bool) -> bool {
    let mut Opcode: u32 = MI.getOpcode();
    if Opcode != ADD32rr && Opcode != ADD64rr {
        return false;
    }
    let mut MRI: *MachineRegisterInfo = MI.getParent().getParent().getRegInfo();
    let mut Reg1: Register = MI.getOperand(1).getReg();
    let mut Reg2: Register = MI.getOperand(2).getReg();
    if MRI.getUniqueVRegDef(Reg1) {
        Inst;
    } else {
        if isConvertibleLEA(Inst) && Inst.getParent() == MI.getParent() {
            Commute = true;
            return true;
        }
    }
    if MRI.getUniqueVRegDef(Reg2) {
        Inst;
    } else {
        if isConvertibleLEA(Inst) && Inst.getParent() == MI.getParent() {
            Commute = false;
            return true;
        }
    }
    return false;
}

fn getCondSrcNoFromDesc(MCID: *MCInstrDesc) -> i32 {
    let mut Opcode: u32 = MCID.getOpcode();
    if !(isJCC(Opcode) || isSETCC(Opcode) || isSETZUCC(Opcode) || isCMOVCC(Opcode) || isCFCMOVCC(Opcode) || isCCMPCC(Opcode) || isCTESTCC(Opcode)) {
        return -1;
    }
    let mut NumUses: u32 = MCID.getNumOperands() - MCID.getNumDefs();
    return NumUses - 1;
}

fn getCondFromMI(MI: *MachineInstr) -> CondCode {
    let mut MCID: *MCInstrDesc = MI.getDesc();
    let mut CondNo: i32 = getCondSrcNoFromDesc(MCID);
    if CondNo < 0 {
        return COND_INVALID;
    }
    CondNo += MCID.getNumDefs();
    return MI.getOperand(CondNo).getImm() as CondCode;
}

fn getCondFromBranch(MI: *MachineInstr) -> CondCode {
    return if isJCC(MI.getOpcode()) { getCondFromMI(MI) } else { COND_INVALID };
}

fn getCondFromSETCC(MI: *MachineInstr) -> CondCode {
    return if isSETCC(MI.getOpcode()) || isSETZUCC(MI.getOpcode()) { getCondFromMI(MI) } else { COND_INVALID };
}

fn getCondFromCMov(MI: *MachineInstr) -> CondCode {
    return if isCMOVCC(MI.getOpcode()) { getCondFromMI(MI) } else { COND_INVALID };
}

fn getCondFromCFCMov(MI: *MachineInstr) -> CondCode {
    return if isCFCMOVCC(MI.getOpcode()) { getCondFromMI(MI) } else { COND_INVALID };
}

fn getCondFromCCMP(MI: *MachineInstr) -> CondCode {
    return if isCCMPCC(MI.getOpcode()) || isCTESTCC(MI.getOpcode()) { getCondFromMI(MI) } else { COND_INVALID };
}

fn getCCMPCondFlagsFromCondCode(CC: CondCode) -> i32 {
    match CC {
        _ => {
            llvm_unreachable_internal("Illegal condition code!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 3210);
        },
        COND_NO => {
            COND_NE;
        },
        COND_O => {
            return OF;
        },
        COND_B => {
            COND_BE;
        },
        COND_E => {
            COND_LE;
        },
        COND_S => {
            COND_L;
        },
        COND_P => {
            return PF;
        },
    }
}

fn getNewOpcFromTable(Table: ArrayRef<X86TableEntry>, Opc: u32) -> u32 {
    let mut I: *X86TableEntry = lower_bound(Table, Opc);
    return if (I == Table.end() || I.OldOpc != Opc) { 0 } else { I.NewOpc };
}

fn getNFVariant(Opc: u32) -> u32 {
    return getNewOpcFromTable(X86NFTransformTable, Opc);
}

fn getNFVariantIfClobberRemovable(MI: *MachineInstr, TRI: *TargetRegisterInfo) -> u32 {
    if !MI.registerDefIsDead(EFLAGS, TRI) {
        return 0;
    }
    if !X86EnableAPXForRelocation && isAddMemInstrWithRelocation(MI) {
        return 0;
    }
    return getNFVariant(MI.getOpcode());
}

fn getNonNDVariant(Opc: u32) -> u32 {
    return getNewOpcFromTable(X86ND2NonNDTable, Opc);
}

fn GetOppositeBranchCondition(CC: CondCode) -> CondCode {
    match CC {
        _ => {
            llvm_unreachable_internal("Illegal condition code!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 3290);
        },
        COND_E => {
            return COND_NE;
        },
        COND_NE => {
            return COND_E;
        },
        COND_L => {
            return COND_GE;
        },
        COND_LE => {
            return COND_G;
        },
        COND_G => {
            return COND_LE;
        },
        COND_GE => {
            return COND_L;
        },
        COND_B => {
            return COND_AE;
        },
        COND_BE => {
            return COND_A;
        },
        COND_A => {
            return COND_BE;
        },
        COND_AE => {
            return COND_B;
        },
        COND_S => {
            return COND_NS;
        },
        COND_NS => {
            return COND_S;
        },
        COND_P => {
            return COND_NP;
        },
        COND_NP => {
            return COND_P;
        },
        COND_O => {
            return COND_NO;
        },
        COND_NO => {
            return COND_O;
        },
        COND_NE_OR_P => {
            return COND_E_AND_NP;
        },
        COND_E_AND_NP => {
            return COND_NE_OR_P;
        },
    }
}

fn getSwappedCondition(CC: CondCode) -> CondCode {
    match CC {
        _ => {
            return COND_INVALID;
        },
        COND_E => {
            return COND_E;
        },
        COND_NE => {
            return COND_NE;
        },
        COND_L => {
            return COND_G;
        },
        COND_LE => {
            return COND_GE;
        },
        COND_G => {
            return COND_L;
        },
        COND_GE => {
            return COND_LE;
        },
        COND_B => {
            return COND_A;
        },
        COND_BE => {
            return COND_AE;
        },
        COND_A => {
            return COND_B;
        },
        COND_AE => {
            return COND_BE;
        },
    }
}

fn getX86ConditionCode(Predicate: Predicate) -> CondCode, bool> {
    let mut CC: CondCode = COND_INVALID;
    let mut NeedSwap: bool = false;
    match Predicate {
        _ => {
            break;
        },
        FCMP_UEQ => {
            CC = COND_E;
        },
        FCMP_OLT => {
            NeedSwap = true;
        },
        FCMP_OGT => {
            CC = COND_A;
        },
        FCMP_OLE => {
            NeedSwap = true;
        },
        FCMP_OGE => {
            CC = COND_AE;
        },
        FCMP_UGT => {
            NeedSwap = true;
        },
        FCMP_ULT => {
            CC = COND_B;
        },
        FCMP_UGE => {
            NeedSwap = true;
        },
        FCMP_ULE => {
            CC = COND_BE;
        },
        FCMP_ONE => {
            CC = COND_NE;
        },
        FCMP_UNO => {
            CC = COND_P;
        },
        FCMP_ORD => {
            CC = COND_NP;
        },
        FCMP_OEQ => {
            
        },
        FCMP_UNE => {
            CC = COND_INVALID;
        },
        ICMP_EQ => {
            CC = COND_E;
        },
        ICMP_NE => {
            CC = COND_NE;
        },
        ICMP_UGT => {
            CC = COND_A;
        },
        ICMP_UGE => {
            CC = COND_AE;
        },
        ICMP_ULT => {
            CC = COND_B;
        },
        ICMP_ULE => {
            CC = COND_BE;
        },
        ICMP_SGT => {
            CC = COND_G;
        },
        ICMP_SGE => {
            CC = COND_GE;
        },
        ICMP_SLT => {
            CC = COND_L;
        },
        ICMP_SLE => {
            CC = COND_LE;
        },
    }
    return make_pair(CC, NeedSwap);
}

fn getCMovOpcode(RegBytes: u32, HasMemoryOperand: bool, HasNDD: bool) -> u32 {
    match RegBytes {
        _ => {
            llvm_unreachable_internal("Illegal register size!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 3450);
        },
        2 => {
            return if HasMemoryOperand { (if HasNDD { CMOV16rm_ND } else { CMOV16rm }) } else { (if HasNDD { CMOV16rr_ND } else { CMOV16rr }) };
        },
        4 => {
            return if HasMemoryOperand { (if HasNDD { CMOV32rm_ND } else { CMOV32rm }) } else { (if HasNDD { CMOV32rr_ND } else { CMOV32rr }) };
        },
        8 => {
            return if HasMemoryOperand { (if HasNDD { CMOV64rm_ND } else { CMOV64rm }) } else { (if HasNDD { CMOV64rr_ND } else { CMOV64rr }) };
        },
    }
}

fn getMOVriOpcode(Use64BitReg: bool, Imm: i64) -> u32 {
    if !Use64BitReg {
        return MOV32ri;
    }
    if isUInt(Imm) {
        return MOV32ri64;
    }
    if isInt(Imm) {
        return MOV64ri32;
    }
    return MOV64ri;
}

fn getVPCMPImmForCond(CC: CondCode) -> u32 {
    match CC {
        _ => {
            llvm_unreachable_internal("Unexpected SETCC condition", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 3479);
        },
        SETNE => {
            return 4;
        },
        SETEQ => {
            return 0;
        },
        SETULT => {
            SETLT;
        },
        SETUGT => {
            SETGT;
        },
        SETUGE => {
            SETGE;
        },
        SETULE => {
            SETLE;
        },
    }
}

fn getSwappedVPCMPImm(Imm: u32) -> u32 {
    match Imm {
        _ => {
            llvm_unreachable_internal("Unreachable!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 3503);
        },
        1 => {
            Imm = 6;
        },
        2 => {
            Imm = 5;
        },
        5 => {
            Imm = 2;
        },
        6 => {
            Imm = 1;
        },
        0 => {
            3;
        },
    }
    return Imm;
}

fn getSwappedVPCOMImm(Imm: u32) -> u32 {
    match Imm {
        _ => {
            llvm_unreachable_internal("Unreachable!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 3530);
        },
        0 => {
            Imm = 2;
        },
        1 => {
            Imm = 3;
        },
        2 => {
            Imm = 0;
        },
        3 => {
            Imm = 1;
        },
        4 => {
            5;
        },
    }
    return Imm;
}

fn getSwappedVCMPImm(Imm: u32) -> u32 {
    match Imm & 3 {
        _ => {
            llvm_unreachable_internal("Unreachable!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 3558);
        },
        0 => {
            3;
        },
        1 => {
            2;
        },
    }
    return Imm;
}

fn getVectorRegisterWidth(Info: *MCOperandInfo) -> u32 {
    if Info.RegClass == VR128RegClassID || Info.RegClass == VR128XRegClassID {
        return 128;
    }
    if Info.RegClass == VR256RegClassID || Info.RegClass == VR256XRegClassID {
        return 256;
    }
    if Info.RegClass == VR512RegClassID {
        return 512;
    }
    llvm_unreachable_internal("Unknown register class!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 3582);
}

fn isX87Reg(Reg: Register) -> bool {
    return (Reg == FPCW || Reg == FPSW || (Reg.operator unsigned int() >= ST0 && Reg.operator unsigned int() <= ST7));
}

fn isX87Instruction(MI: *mut MachineInstr) -> bool {
    if MI.isCall(AnyInBundle) || MI.isInlineAsm() {
        return false;
    }
    for MO in MI.operands() {
        if !MO.isReg() {
            continue;
        }
        if isX87Reg(MO.getReg()) {
            return true;
        }
    }
    return false;
}

fn getFirstAddrOperandIdx(MI: *MachineInstr) -> i32 {
    let mut IsMemOp: Closure_2 = Closure_2 {};
    let mut Desc: *MCInstrDesc = MI.getDesc();
    if !isPseudo(Desc.TSFlags) {
        let mut MemRefIdx: i32 = getMemoryOperandIdx(Desc);
        if MemRefIdx >= 0 {
            return MemRefIdx;
        }
        return -1;
    }
    let mut NumOps: u32 = Desc.getNumOperands();
    if NumOps < AddrNumOperands {
        return -1;
    }
    for let mut I: u32 = 0;
let mut E: u32 = NumOps - AddrNumOperands; I != E; I += 1 {
        if IsMemOp.call(Desc.operands()[I]) {
            return I;
        }
    }
    return -1;
}

fn getConstantFromPool(MI: *MachineInstr, OpNo: u32) -> *Constant {
    assert!(MI.getNumOperands() >= (OpNo + AddrNumOperands), "Unexpected number of operands!");
    let mut Index: *MachineOperand = MI.getOperand(OpNo + AddrIndexReg);
    if !Index.isReg() || Index.getReg() != NoRegister {
        return null;
    }
    let mut Disp: *MachineOperand = MI.getOperand(OpNo + AddrDisp);
    if !Disp.isCPI() || Disp.getOffset() != 0 {
        return null;
    }
    let mut Constants: ArrayRef<MachineConstantPoolEntry> = MI.getParent().getParent().getConstantPool().getConstants();
    let mut ConstantEntry: *MachineConstantPoolEntry = Constants[Disp.getIndex()];
    if ConstantEntry.isMachineConstantPoolEntry() {
        return null;
    }
    return ConstantEntry.Val.ConstVal;
}

fn X86InstrInfo::isUnconditionalTailCall(self: *X86InstrInfo, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        TCRETURNdi => {
            TCRETURNri;
        },
        _ => {
            return false;
        },
    }
}

fn X86InstrInfo::canMakeTailCallConditional(self: *X86InstrInfo, BranchCond: *mut SmallVectorImpl<MachineOperand>, TailCall: *MachineInstr) -> bool {
    let mut MF: *MachineFunction = TailCall.getMF();
    if MF.getTarget().getCodeModel() == Kernel {
        let mut Target: *MachineOperand = TailCall.getOperand(0);
        if Target.isSymbol() {
            let mut Symbol: str = Target.getSymbolName();
            if Symbol == "__x86_indirect_thunk_r11" {
                return false;
            }
        }
    }
    if TailCall.getOpcode() != TCRETURNdi && TailCall.getOpcode() != TCRETURNdi64 {
        return false;
    }
    if self.Subtarget.isTargetWin64() && MF.hasWinCFI() {
        return false;
    }
    assert!(BranchCond.len == 1);
    if BranchCond[0].getImm() > LAST_VALID_COND {
        return false;
    }
    let mut X86FI: *X86MachineFunctionInfo = MF.getInfo();
    if X86FI.getTCReturnAddrDelta() != 0 || TailCall.getOperand(1).getImm() != 0 {
        return false;
    }
    return true;
}

fn X86InstrInfo::replaceBranchWithTailCall(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, BranchCond: *mut SmallVectorImpl<MachineOperand>, TailCall: *MachineInstr) {
    assert!(self.canMakeTailCallConditional(BranchCond, TailCall);
    let mut I: iterator = MBB.end();
    while I != MBB.begin() {
        operator(I);
        if operator(I).isDebugInstr() {
            continue;
        }
        if !operator(I).isBranch(AnyInBundle) {
            assert!(0, "Can't find the branch to replace!");
        }
        let mut CC: CondCode = getCondFromBranch(operator(I));
        assert!(BranchCond.len == 1);
        if CC != BranchCond[0].getImm() {
            continue;
        }
        break;
    }
    let mut Opc: u32 = if TailCall.getOpcode() == TCRETURNdi { TCRETURNdicc } else { TCRETURNdi64cc };
    let mut MIB: MachineInstrBuilder = BuildMI(MBB, I, MIMetadata { DL: MBB.findDebugLoc(I), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc));
    operator(MIB).addOperand(TailCall.getOperand(0));
    MIB.addImm(0);
    operator(MIB).addOperand(BranchCond[0]);
    MIB.copyImplicitOps(TailCall);
    let mut LiveRegs: LivePhysRegs = self.getRegisterInfo();
    LiveRegs.addLiveOuts(MBB);
    let mut Clobbers: pair<MCPhysReg, const MachineOperand *>, 8> = pair<MCPhysReg, const MachineOperand *>, 8> {};
    LiveRegs.stepForward(*MIB.operator llvm::MachineInstr *(), Clobbers);
    for C in Clobbers {
        MIB.addReg(C.first, Implicit, 0);
        MIB.addReg(C.first, Implicit | Define, 0);
    }
    operator(I).eraseFromParent();
}

fn getFallThroughMBB(MBB: *mut MachineBasicBlock, TBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut FallthroughBB: *mut MachineBasicBlock = null;
    for Succ in MBB.successors() {
        if Succ.isEHPad() || (Succ == TBB && FallthroughBB) {
            continue;
        }
        if FallthroughBB && FallthroughBB != TBB {
            return null;
        }
        FallthroughBB = Succ;
    }
    return FallthroughBB;
}

fn X86InstrInfo::analyzeBranchImpl(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, TBB: *mut *mut MachineBasicBlock, FBB: *mut *mut MachineBasicBlock, Cond: *mut SmallVectorImpl<MachineOperand>, CondBranches: *mut SmallVectorImpl<MachineInstr *>, AllowModify: bool) -> bool {
    let mut I: iterator = MBB.end();
    let mut UnCondBrIter: iterator = MBB.end();
    while I != MBB.begin() {
        operator(I);
        if operator(I).isDebugInstr() {
            continue;
        }
        if !self.isUnpredicatedTerminator(operator(I)) {
            break;
        }
        if !operator(I).isBranch(AnyInBundle) {
            return true;
        }
        if operator(I).getOpcode() == JMP_1 {
            UnCondBrIter = I;
            if !AllowModify {
                TBB = operator(I).getOperand(0).getMBB();
                continue;
            }
            MBB.erase(next(I, 1), MBB.end());
            Cond.clear();
            FBB = null;
            if MBB.isLayoutSuccessor(operator(I).getOperand(0).getMBB()) {
                TBB = null;
                operator(I).eraseFromParent();
                I = MBB.end();
                UnCondBrIter = MBB.end();
                continue;
            }
            TBB = operator(I).getOperand(0).getMBB();
            continue;
        }
        let mut BranchCode: CondCode = getCondFromBranch(operator(I));
        if BranchCode == COND_INVALID {
            return true;
        }
        if operator(I).findRegisterUseOperand(EFLAGS, null, false).isUndef() {
            return true;
        }
        if Cond.is_empty() {
            FBB = TBB;
            TBB = operator(I).getOperand(0).getMBB();
            Cond.push(CreateImm(BranchCode));
            CondBranches.push(&mut operator(I));
            continue;
        }
        assert!(Cond.len == 1);
        assert!(TBB);
        let mut OldBranchCode: CondCode = Cond[0].getImm() as CondCode;
        let mut NewTBB: *mut MachineBasicBlock = operator(I).getOperand(0).getMBB();
        if OldBranchCode == BranchCode && TBB == NewTBB {
            continue;
        }
        if TBB == NewTBB && ((OldBranchCode == COND_P && BranchCode == COND_NE) || (OldBranchCode == COND_NE && BranchCode == COND_P)) {
            BranchCode = COND_NE_OR_P;
        } else if (OldBranchCode == COND_NP && BranchCode == COND_NE) || (OldBranchCode == COND_E && BranchCode == COND_P) {
            if NewTBB != (if FBB { FBB } else { getFallThroughMBB(&mut MBB, TBB) }) {
                return true;
            }
            BranchCode = COND_E_AND_NP;
        } else {
            return true;
        }
        Cond[0].setImm(BranchCode);
        CondBranches.push(&mut operator(I));
    }
    return false;
}

fn X86InstrInfo::analyzeBranch(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, TBB: *mut *mut MachineBasicBlock, FBB: *mut *mut MachineBasicBlock, Cond: *mut SmallVectorImpl<MachineOperand>, AllowModify: bool) -> bool {
    let mut CondBranches: SmallVector<MachineInstr *, 4> = SmallVector<MachineInstr *, 4> {};
    return self.analyzeBranchImpl(MBB, TBB, FBB, Cond, CondBranches, AllowModify);
}

fn getJumpTableIndexFromAddr(MI: *MachineInstr) -> i32 {
    let mut MemRefBegin: i32 = getMemoryOperandIdx(MI.getDesc());
    assert!(MemRefBegin >= 0, "Expected a memory operand");
    let mut MO: *MachineOperand = MI.getOperand(MemRefBegin + AddrDisp);
    if !MO.isJTI() {
        return -1;
    }
    return MO.getIndex();
}

fn getJumpTableIndexFromReg(MRI: *MachineRegisterInfo, Reg: Register) -> i32 {
    if !Reg.isVirtual() {
        return -1;
    }
    let mut MI: *mut MachineInstr = MRI.getUniqueVRegDef(Reg);
    if MI == null {
        return -1;
    }
    let mut Opcode: u32 = MI.getOpcode();
    if Opcode != LEA64r && Opcode != LEA32r {
        return -1;
    }
    return getJumpTableIndexFromAddr(*MI);
}

fn X86InstrInfo::getJumpTableIndex(self: *X86InstrInfo, MI: *MachineInstr) -> i32 {
    let mut Opcode: u32 = MI.getOpcode();
    if Opcode == JMP64m || Opcode == JMP32m {
        return getJumpTableIndexFromAddr(MI);
    }
    if Opcode == JMP64r || Opcode == JMP32r {
        let mut Reg: Register = MI.getOperand(0).getReg();
        if !Reg.isVirtual() {
            return -1;
        }
        let mut MF: *MachineFunction = *MI.getParent().getParent();
        let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
        let mut Add: *mut MachineInstr = MRI.getUniqueVRegDef(Reg);
        if Add == null {
            return -1;
        }
        if Add.getOpcode() != ADD64rr && Add.getOpcode() != ADD32rr {
            return -1;
        }
        let mut JTI1: i32 = getJumpTableIndexFromReg(MRI, Add.getOperand(1).getReg());
        if JTI1 >= 0 {
            return JTI1;
        }
        let mut JTI2: i32 = getJumpTableIndexFromReg(MRI, Add.getOperand(2).getReg());
        if JTI2 >= 0 {
            return JTI2;
        }
    }
    return -1;
}

fn X86InstrInfo::analyzeBranchPredicate(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, MBP: *mut MachineBranchPredicate, AllowModify: bool) -> bool {
    let mut Cond: SmallVector<MachineOperand, 4> = SmallVector<MachineOperand, 4> {};
    let mut CondBranches: SmallVector<MachineInstr *, 4> = SmallVector<MachineInstr *, 4> {};
    if self.analyzeBranchImpl(MBB, MBP.TrueDest, MBP.FalseDest, Cond, CondBranches, AllowModify) {
        return true;
    }
    if Cond.len != 1 {
        return true;
    }
    assert!(MBP.TrueDest, "expected!");
    if !MBP.FalseDest {
        MBP.FalseDest = MBB.getNextNode();
    }
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    let mut ConditionDef: *mut MachineInstr = null;
    let mut SingleUseCondition: bool = true;
    for MI in drop_begin(reverse(MBB), 1) {
        if MI.modifiesRegister(EFLAGS, TRI) {
            ConditionDef = &mut MI;
            break;
        }
        if MI.readsRegister(EFLAGS, TRI) {
            SingleUseCondition = false;
        }
    }
    if !ConditionDef {
        return true;
    }
    if SingleUseCondition {
        for Succ in MBB.successors() {
            if Succ.isLiveIn(EFLAGS, getAll()) {
                SingleUseCondition = false;
            }
        }
    }
    MBP.ConditionDef = ConditionDef;
    MBP.SingleUseCondition = SingleUseCondition;
    let mut TestOpcode: u32 = if self.Subtarget.is64Bit() { TEST64rr } else { TEST32rr };
    if ConditionDef.getOpcode() == TestOpcode && ConditionDef.getNumOperands() == 3 && ConditionDef.getOperand(0).isIdenticalTo(ConditionDef.getOperand(1)) && (Cond[0].getImm() == COND_NE || Cond[0].getImm() == COND_E) {
        MBP.LHS = ConditionDef.getOperand(0);
        MBP.RHS = CreateImm(0);
        MBP.Predicate = if Cond[0].getImm() == COND_NE { PRED_NE } else { PRED_EQ };
        return false;
    }
    return true;
}

fn X86InstrInfo::removeBranch(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, BytesRemoved: *mut i32) -> u32 {
    assert!(!BytesRemoved, "code size not handled");
    let mut I: iterator = MBB.end();
    let mut Count: u32 = 0;
    while I != MBB.begin() {
        operator(I);
        if operator(I).isDebugInstr() {
            continue;
        }
        if operator(I).getOpcode() != JMP_1 && getCondFromBranch(operator(I)) == COND_INVALID {
            break;
        }
        operator(I).eraseFromParent();
        I = MBB.end();
        Count += 1;
    }
    return Count;
}

fn X86InstrInfo::insertBranch(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, TBB: *mut MachineBasicBlock, FBB: *mut MachineBasicBlock, Cond: ArrayRef<MachineOperand>, DL: *DebugLoc, BytesAdded: *mut i32) -> u32 {
    assert!(TBB, "insertBranch must not be told to insert a fallthrough");
    assert!((Cond.len == 1 || Cond.len == 0), "X86 branch conditions have one component!");
    assert!(!BytesAdded, "code size not handled");
    if Cond.is_empty() {
        assert!(!FBB, "Unconditional branch with multiple successors!");
        BuildMI(&mut MBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(JMP_1)).addMBB(TBB, 0);
        return 1;
    }
    let mut FallThru: bool = FBB == null;
    let mut Count: u32 = 0;
    let mut CC: CondCode = Cond[0].getImm() as CondCode;
    match CC {
        COND_NE_OR_P => {
            BuildMI(&mut MBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(JCC_1)).addMBB(TBB, 0).addImm(COND_NE);
        },
        COND_E_AND_NP => {
            if FBB == null {
                FBB = getFallThroughMBB(&mut MBB, TBB);
                assert!(FBB, "MBB cannot be the last block in function when the false body is a fall-through.");
            }
        },
        _ => {
            BuildMI(&mut MBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(JCC_1)).addMBB(TBB, 0).addImm(CC);
            Count += 1;
        },
    }
    if !FallThru {
        BuildMI(&mut MBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(JMP_1)).addMBB(FBB, 0);
        Count += 1;
    }
    return Count;
}

fn X86InstrInfo::canInsertSelect(self: *X86InstrInfo, MBB: *MachineBasicBlock, Cond: ArrayRef<MachineOperand>, DstReg: Register, TrueReg: Register, FalseReg: Register, CondCycles: *mut i32, TrueCycles: *mut i32, FalseCycles: *mut i32) -> bool {
    if !self.Subtarget.canUseCMOV() {
        return false;
    }
    if Cond.len != 1 {
        return false;
    }
    if Cond[0].getImm() as CondCode > LAST_VALID_COND {
        return false;
    }
    let mut MRI: *MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut RC: *TargetRegisterClass = self.RI.getCommonSubClass(MRI.getRegClass(TrueReg), MRI.getRegClass(FalseReg));
    if !RC {
        return false;
    }
    if GR16RegClass.hasSubClassEq(RC) || GR32RegClass.hasSubClassEq(RC) || GR64RegClass.hasSubClassEq(RC) {
        CondCycles = 2;
        TrueCycles = 2;
        FalseCycles = 2;
        return true;
    }
    return false;
}

fn X86InstrInfo::insertSelect(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, I: iterator, DL: *DebugLoc, DstReg: Register, Cond: ArrayRef<MachineOperand>, TrueReg: Register, FalseReg: Register) {
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut TRI: *TargetRegisterInfo = *MRI.getTargetRegisterInfo();
    let mut RC: *TargetRegisterClass = *MRI.getRegClass(DstReg);
    assert!(Cond.len == 1, "Invalid Cond array");
    let mut Opc: u32 = getCMovOpcode(TRI.getRegSizeInBits(RC).operator unsigned long long() / 8, false, self.Subtarget.hasNDD());
    BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc), DstReg).addReg(FalseReg, RegState {}, 0).addReg(TrueReg, RegState {}, 0).addImm(Cond[0].getImm());
}

fn isHReg(Reg: Register) -> bool {
    return GR8_ABCD_HRegClass.contains(Reg.operator MCRegister());
}

fn CopyToFromAsymmetricReg(DestReg: Register, SrcReg: Register, Subtarget: *X86Subtarget) -> u32 {
    let mut HasAVX: bool = Subtarget.hasAVX();
    let mut HasAVX512: bool = Subtarget.hasAVX512();
    let mut HasEGPR: bool = Subtarget.hasEGPR();
    if VK16RegClass.contains(SrcReg.operator MCRegister()) {
        if GR64RegClass.contains(DestReg.operator MCRegister()) {
            assert!(Subtarget.hasBWI();
            return if HasEGPR { KMOVQrk_EVEX } else { KMOVQrk };
        }
        if GR32RegClass.contains(DestReg.operator MCRegister()) {
            return if Subtarget.hasBWI() { (if HasEGPR { KMOVDrk_EVEX } else { KMOVDrk }) } else { (if HasEGPR { KMOVWrk_EVEX } else { KMOVWrk }) };
        }
    }
    if VK16RegClass.contains(DestReg.operator MCRegister()) {
        if GR64RegClass.contains(SrcReg.operator MCRegister()) {
            assert!(Subtarget.hasBWI();
            return if HasEGPR { KMOVQkr_EVEX } else { KMOVQkr };
        }
        if GR32RegClass.contains(SrcReg.operator MCRegister()) {
            return if Subtarget.hasBWI() { (if HasEGPR { KMOVDkr_EVEX } else { KMOVDkr }) } else { (if HasEGPR { KMOVWkr_EVEX } else { KMOVWkr }) };
        }
    }
    if GR64RegClass.contains(DestReg.operator MCRegister()) {
        if VR128XRegClass.contains(SrcReg.operator MCRegister()) {
            return if HasAVX512 { VMOVPQIto64Zrr } else { if HasAVX { VMOVPQIto64rr } else { MOVPQIto64rr } };
        }
        if VR64RegClass.contains(SrcReg.operator MCRegister()) {
            return MMX_MOVD64from64rr;
        }
    } else if GR64RegClass.contains(SrcReg.operator MCRegister()) {
        if VR128XRegClass.contains(DestReg.operator MCRegister()) {
            return if HasAVX512 { VMOV64toPQIZrr } else { if HasAVX { VMOV64toPQIrr } else { MOV64toPQIrr } };
        }
        if VR64RegClass.contains(DestReg.operator MCRegister()) {
            return MMX_MOVD64to64rr;
        }
    }
    if GR32RegClass.contains(DestReg.operator MCRegister()) && VR128XRegClass.contains(SrcReg.operator MCRegister()) {
        return if HasAVX512 { VMOVPDI2DIZrr } else { if HasAVX { VMOVPDI2DIrr } else { MOVPDI2DIrr } };
    }
    if VR128XRegClass.contains(DestReg.operator MCRegister()) && GR32RegClass.contains(SrcReg.operator MCRegister()) {
        return if HasAVX512 { VMOVDI2PDIZrr } else { if HasAVX { VMOVDI2PDIrr } else { MOVDI2PDIrr } };
    }
    return 0;
}

fn X86InstrInfo::copyPhysReg(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, MI: iterator, DL: *DebugLoc, DestReg: Register, SrcReg: Register, KillSrc: bool, RenamableDest: bool, RenamableSrc: bool) {
    let mut HasAVX: bool = self.Subtarget.hasAVX();
    let mut HasVLX: bool = self.Subtarget.hasVLX();
    let mut HasEGPR: bool = self.Subtarget.hasEGPR();
    let mut Opc: u32 = 0;
    if GR64RegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
        Opc = MOV64rr;
    } else if GR32RegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
        Opc = MOV32rr;
    } else if GR16RegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
        Opc = MOV16rr;
    } else if GR8RegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
        if (isHReg(DestReg) || isHReg(SrcReg)) && self.Subtarget.is64Bit() {
            Opc = MOV8rr_NOREX;
            assert!(GR8_NOREXRegClass.contains(SrcReg.operator MCRegister(), DestReg.operator MCRegister()), "8-bit H register can not be copied outside GR8_NOREX");
        } else {
            Opc = MOV8rr;
        }
    } else if VR64RegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
        Opc = MMX_MOVQ64rr;
    } else if VR128XRegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
        if HasVLX {
            Opc = VMOVAPSZ128rr;
        } else if VR128RegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
            Opc = if HasAVX { VMOVAPSrr } else { MOVAPSrr };
        } else {
            Opc = VMOVAPSZrr;
            let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
            DestReg = TRI.getMatchingSuperReg(DestReg.operator MCRegister(), sub_xmm, &mut VR512RegClass);
            SrcReg = TRI.getMatchingSuperReg(SrcReg.operator MCRegister(), sub_xmm, &mut VR512RegClass);
        }
    } else if VR256XRegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
        if HasVLX {
            Opc = VMOVAPSZ256rr;
        } else if VR256RegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
            Opc = VMOVAPSYrr;
        } else {
            Opc = VMOVAPSZrr;
            let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
            DestReg = TRI.getMatchingSuperReg(DestReg.operator MCRegister(), sub_ymm, &mut VR512RegClass);
            SrcReg = TRI.getMatchingSuperReg(SrcReg.operator MCRegister(), sub_ymm, &mut VR512RegClass);
        }
    } else if VR512RegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
        Opc = VMOVAPSZrr;
    } else if VK16RegClass.contains(DestReg.operator MCRegister(), SrcReg.operator MCRegister()) {
        Opc = if self.Subtarget.hasBWI() { (if HasEGPR { KMOVQkk_EVEX } else { KMOVQkk }) } else { (if HasEGPR { KMOVWkk_EVEX } else { KMOVWkk }) };
    }
    if !Opc {
        Opc = CopyToFromAsymmetricReg(DestReg, SrcReg, self.Subtarget);
    }
    if Opc {
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0);
        return;
    }
    if SrcReg == EFLAGS || DestReg == EFLAGS {
        report_fatal_error("Unable to copy EFLAGS physical register!", true);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-instr-info", 1) {
            dbgs() << "Cannot copy " << self.RI.getName(SrcReg.operator MCRegister()) << " to " << self.RI.getName(DestReg.operator MCRegister()) << 10;
        }
    }
        if !(false) { break; }
    }
    report_fatal_error("Cannot emit physreg copy instruction", true);
}

fn X86InstrInfo::isCopyInstrImpl(self: *X86InstrInfo, MI: *MachineInstr) -> optional<DestSourcePair> {
    if MI.isMoveReg(IgnoreBundle) {
        if MI.getOperand(0).isUndef() && MI.getOperand(0).getSubReg() {
            return nullopt;
        }
        return DestSourcePair { Destination: MI.getOperand(0), Source: MI.getOperand(1) };
    }
    return nullopt;
}

fn getLoadStoreOpcodeForFP16(Load: bool, STI: *X86Subtarget) -> u32 {
    if STI.hasFP16() {
        return if Load { VMOVSHZrm_alt } else { VMOVSHZmr };
    }
    if Load {
        return MOVSHPrm;
    }
    return MOVSHPmr;
}

fn getLoadStoreRegOpcode(Reg: Register, RC: *TargetRegisterClass, IsStackAligned: bool, STI: *X86Subtarget, Load: bool) -> u32 {
    let mut HasAVX: bool = STI.hasAVX();
    let mut HasAVX512: bool = STI.hasAVX512();
    let mut HasVLX: bool = STI.hasVLX();
    let mut HasEGPR: bool = STI.hasEGPR();
    assert!(RC != null, "Invalid target register class");
    match STI.getRegisterInfo().getSpillSize(*RC) {
        _ => {
            llvm_unreachable_internal("Unknown spill size", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 4414);
        },
        1 => {
            assert!(GR8RegClass.hasSubClassEq(RC), "Unknown 1-byte regclass");
        },
        2 => {
            if VK16RegClass.hasSubClassEq(RC) {
                return if Load { (if HasEGPR { KMOVWkm_EVEX } else { KMOVWkm }) } else { (if HasEGPR { KMOVWmk_EVEX } else { KMOVWmk }) };
            }
        },
        4 => {
            if GR32RegClass.hasSubClassEq(RC) {
                return if Load { MOV32rm } else { MOV32mr };
            }
        },
        8 => {
            if GR64RegClass.hasSubClassEq(RC) {
                return if Load { MOV64rm } else { MOV64mr };
            }
        },
        10 => {
            assert!(RFP80RegClass.hasSubClassEq(RC), "Unknown 10-byte regclass");
        },
        16 => {
            if VR128XRegClass.hasSubClassEq(RC) {
                if IsStackAligned {
                    return if Load { (if HasVLX { VMOVAPSZ128rm } else { if HasAVX512 { VMOVAPSZ128rm_NOVLX } else { if HasAVX { VMOVAPSrm } else { MOVAPSrm } } }) } else { (if HasVLX { VMOVAPSZ128mr } else { if HasAVX512 { VMOVAPSZ128mr_NOVLX } else { if HasAVX { VMOVAPSmr } else { MOVAPSmr } } }) };
                } else {
                    return if Load { (if HasVLX { VMOVUPSZ128rm } else { if HasAVX512 { VMOVUPSZ128rm_NOVLX } else { if HasAVX { VMOVUPSrm } else { MOVUPSrm } } }) } else { (if HasVLX { VMOVUPSZ128mr } else { if HasAVX512 { VMOVUPSZ128mr_NOVLX } else { if HasAVX { VMOVUPSmr } else { MOVUPSmr } } }) };
                }
            }
            llvm_unreachable_internal("Unknown 16-byte regclass", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 4503);
        },
        32 => {
            assert!(VR256XRegClass.hasSubClassEq(RC), "Unknown 32-byte regclass");
        },
        64 => {
            assert!(VR512RegClass.hasSubClassEq(RC), "Unknown 64-byte regclass");
        },
        1024 => {
            assert!(TILERegClass.hasSubClassEq(RC), "Unknown 1024-byte regclass");
        },
    }
}

fn X86InstrInfo::getAddrModeFromMemoryOp(self: *X86InstrInfo, MemI: *MachineInstr, TRI: *TargetRegisterInfo) -> optional<ExtAddrMode> {
    let mut MemRefBegin: i32 = getMemoryOperandIdx(MemI.getDesc());
    if MemRefBegin < 0 {
        return nullopt;
    }
    let mut BaseOp: *MachineOperand = MemI.getOperand(MemRefBegin + AddrBaseReg);
    if !BaseOp.isReg() {
        return nullopt;
    }
    let mut DispMO: *MachineOperand = MemI.getOperand(MemRefBegin + AddrDisp);
    if !DispMO.isImm() {
        return nullopt;
    }
    let mut AM: ExtAddrMode = ExtAddrMode {};
    AM.BaseReg = BaseOp.getReg();
    AM.ScaledReg = MemI.getOperand(MemRefBegin + AddrIndexReg).getReg();
    AM.Scale = MemI.getOperand(MemRefBegin + AddrScaleAmt).getImm();
    AM.Displacement = DispMO.getImm();
    return AM;
}

fn X86InstrInfo::verifyInstruction(self: *X86InstrInfo, MI: *MachineInstr, ErrInfo: *mut str) -> bool {
    let mut AMOrNone: optional<ExtAddrMode> = self.getAddrModeFromMemoryOp(MI, null);
    if !AMOrNone {
        return true;
    }
    let mut AM: ExtAddrMode = operator(AMOrNone);
    assert!(AM.Form == Basic);
    if AM.ScaledReg != NoRegister {
        match AM.Scale {
            1 => {
                2;
            },
            _ => {
                ErrInfo = "Scale factor in address must be 1, 2, 4 or 8";
            },
        }
    }
    if !isInt(AM.Displacement) {
        ErrInfo = "Displacement in address must fit into 32-bit signed integer";
        return false;
    }
    return true;
}

fn X86InstrInfo::getConstValDefinedInReg(self: *X86InstrInfo, MI: *MachineInstr, Reg: Register, ImmVal: *mut i64) -> bool {
    let mut MovReg: Register = Reg;
    let mut MovMI: *MachineInstr = &mut MI;
    if MI.isSubregToReg() {
        let mut SubIdx: u32 = MI.getOperand(2).getImm();
        MovReg = MI.getOperand(1).getReg();
        if SubIdx != sub_32bit {
            return false;
        }
        let mut MRI: *MachineRegisterInfo = MI.getParent().getParent().getRegInfo();
        MovMI = MRI.getUniqueVRegDef(MovReg);
        if !MovMI {
            return false;
        }
    }
    if MovMI.getOpcode() == MOV32r0 && MovMI.getOperand(0).getReg() == MovReg {
        ImmVal = 0;
        return true;
    }
    if MovMI.getOpcode() != MOV32ri && MovMI.getOpcode() != MOV64ri && MovMI.getOpcode() != MOV32ri64 && MovMI.getOpcode() != MOV8ri {
        return false;
    }
    if !MovMI.getOperand(1).isImm() || MovMI.getOperand(0).getReg() != MovReg {
        return false;
    }
    ImmVal = MovMI.getOperand(1).getImm();
    return true;
}

fn X86InstrInfo::preservesZeroValueInReg(self: *X86InstrInfo, MI: *MachineInstr, NullValueReg: Register, TRI: *TargetRegisterInfo) -> bool {
    if !MI.modifiesRegister(NullValueReg, TRI) {
        return true;
    }
    match MI.getOpcode() {
        SHR64ri => {
            SHR32ri;
        },
        MOV32rr => {
            return all_of(MI.operands(), Closure_3 { TRI: &mut TRI, NullValueReg: &mut NullValueReg });
        },
        _ => {
            return false;
        },
    }
    llvm_unreachable_internal("Should be handled above!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 4656);
}

fn X86InstrInfo::getMemOperandsWithOffsetWidth(self: *X86InstrInfo, MemOp: *MachineInstr, BaseOps: *SmallVectorImpl<const MachineOperand *>, Offset: *mut i64, OffsetIsScalable: *mut bool, Width: *mut LocationSize, TRI: *TargetRegisterInfo) -> bool {
    let mut MemRefBegin: i32 = getMemoryOperandIdx(MemOp.getDesc());
    if MemRefBegin < 0 {
        return false;
    }
    let mut BaseOp: *MachineOperand = &mut MemOp.getOperand(MemRefBegin + AddrBaseReg);
    if !BaseOp.isReg() {
        return false;
    }
    if MemOp.getOperand(MemRefBegin + AddrScaleAmt).getImm() != 1 {
        return false;
    }
    if MemOp.getOperand(MemRefBegin + AddrIndexReg).getReg() != NoRegister {
        return false;
    }
    let mut DispMO: *MachineOperand = MemOp.getOperand(MemRefBegin + AddrDisp);
    if !DispMO.isImm() {
        return false;
    }
    Offset = DispMO.getImm();
    if !BaseOp.isReg() {
        return false;
    }
    OffsetIsScalable = false;
    Width = if !MemOp.memoperands_empty() { MemOp.memoperands().front().getSize() } else { precise(0) };
    BaseOps.push(BaseOp);
    return true;
}

fn getStoreRegOpcode(SrcReg: Register, RC: *TargetRegisterClass, IsStackAligned: bool, STI: *X86Subtarget) -> u32 {
    return getLoadStoreRegOpcode(SrcReg, RC, IsStackAligned, STI, false);
}

fn getLoadRegOpcode(DestReg: Register, RC: *TargetRegisterClass, IsStackAligned: bool, STI: *X86Subtarget) -> u32 {
    return getLoadStoreRegOpcode(DestReg, RC, IsStackAligned, STI, true);
}

fn isAMXOpcode(Opc: u32) -> bool {
    match Opc {
        _ => {
            return false;
        },
        TILELOADD => {
            TILESTORED;
        },
    }
}

fn X86InstrInfo::loadStoreTileReg(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, MI: iterator, Opc: u32, Reg: Register, FrameIdx: i32, isKill: bool) {
    match Opc {
        _ => {
            llvm_unreachable_internal("Unexpected special opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 4731);
        },
        TILESTORED => {
            TILESTORED_EVEX;
        },
        TILELOADD => {
            TILELOADD_EVEX;
        },
    }
}

fn X86InstrInfo::storeRegToStackSlot(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, MI: iterator, SrcReg: Register, isKill: bool, FrameIdx: i32, RC: *TargetRegisterClass, VReg: Register, Flags: MIFlag) {
    let mut MF: *MachineFunction = *MBB.getParent();
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    assert!(MFI.getObjectSize(FrameIdx) >= self.RI.getSpillSize(*RC), "Stack slot too small for store");
    let mut Alignment: u32 = if self.RI.getSpillSize(*RC) > 16 { self.RI.getSpillSize(*RC) } else { 16 };
    let mut isAligned: bool = (self.Subtarget.getFrameLowering().getStackAlign() >= Alignment) || (self.RI.canRealignStack(MF) && !MFI.isFixedObjectIndex(FrameIdx));
    let mut Opc: u32 = getStoreRegOpcode(SrcReg, RC, isAligned, self.Subtarget);
    if isAMXOpcode(Opc) {
        self.loadStoreTileReg(MBB, MI, Opc, SrcReg, FrameIdx, isKill);
    } else {
        addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc)), FrameIdx, 0).addReg(SrcReg, getKillRegState(isKill), 0).setMIFlag(Flags);
    }
}

fn X86InstrInfo::loadRegFromStackSlot(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, MI: iterator, DestReg: Register, FrameIdx: i32, RC: *TargetRegisterClass, VReg: Register, SubReg: u32, Flags: MIFlag) {
    let mut MF: *MachineFunction = *MBB.getParent();
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    assert!(MFI.getObjectSize(FrameIdx) >= self.RI.getSpillSize(*RC), "Load size exceeds stack slot");
    let mut Alignment: u32 = if self.RI.getSpillSize(*RC) > 16 { self.RI.getSpillSize(*RC) } else { 16 };
    let mut isAligned: bool = (self.Subtarget.getFrameLowering().getStackAlign() >= Alignment) || (self.RI.canRealignStack(MF) && !MFI.isFixedObjectIndex(FrameIdx));
    let mut Opc: u32 = getLoadRegOpcode(DestReg, RC, isAligned, self.Subtarget);
    if isAMXOpcode(Opc) {
        self.loadStoreTileReg(MBB, MI, Opc, DestReg, FrameIdx, false);
    } else {
        addFrameReference(BuildMI(MBB, MI, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc), DestReg), FrameIdx, 0).setMIFlag(Flags);
    }
}

fn X86InstrInfo::analyzeCompare(self: *X86InstrInfo, MI: *MachineInstr, SrcReg: *mut Register, SrcReg2: *mut Register, CmpMask: *mut i64, CmpValue: *mut i64) -> bool {
    match MI.getOpcode() {
        _ => {
            break;
        },
        CMP64ri32 => {
            CMP32ri;
        },
        SUB64rm => {
            SUB64rm_ND;
        },
        SUB64rr => {
            SUB64rr_ND;
        },
        SUB64ri32 => {
            SUB64ri32_ND;
        },
        CMP64rr => {
            CMP32rr;
        },
        TEST8rr => {
            TEST16rr;
        },
        TEST64ri32 => {
            TEST32ri;
        },
    }
    return false;
}

fn X86InstrInfo::isRedundantFlagInstr(self: *X86InstrInfo, FlagI: *MachineInstr, SrcReg: Register, SrcReg2: Register, ImmMask: i64, ImmValue: i64, OI: *MachineInstr, IsSwapped: *mut bool, ImmDelta: *mut i64) -> bool {
    match OI.getOpcode() {
        CMP64rr => {
            CMP32rr;
        },
        CMP64ri32 => {
            CMP32ri;
        },
        _ => {
            return false;
        },
    }
}

fn isCmpRedundantAfterLTZCNT(SrcReg: Register, SrcReg2: Register, ImmMask: i64, ImmValue: i64, OI: *MachineInstr) -> bool {
    match OI.getOpcode() {
        _ => {
            return false;
        },
        LZCNT16rr => {
            LZCNT32rr;
        },
    }
}

fn isDefConvertible(MI: *MachineInstr, NoSignFlag: *mut bool, ClearsOverflowFlag: *mut bool) -> bool {
    NoSignFlag = false;
    ClearsOverflowFlag = false;
    if MI.getOpcode() == ADD64rm || MI.getOpcode() == ADD32rm {
        let mut Flags: u32 = MI.getOperand(5).getTargetFlags();
        if Flags == MO_GOTTPOFF || Flags == MO_INDNTPOFF || Flags == MO_GOTNTPOFF {
            return false;
        }
    }
    match MI.getOpcode() {
        _ => {
            return false;
        },
        SAR8ri => {
            SAR8ri_ND;
        },
        SHL8ri => {
            SHL8ri_ND;
        },
        SHRD16rri8 => {
            SHRD16rri8_ND;
        },
        SUB64ri32 => {
            SUB64ri32_ND;
        },
        AND64ri32 => {
            AND64ri32_ND;
        },
        BEXTR32rr => {
            BEXTR32rr_EVEX;
        },
    }
}

fn isUseDefConvertible(MI: *MachineInstr) -> CondCode, unsigned int> {
    match MI.getOpcode() {
        _ => {
            return make_pair(COND_INVALID, ~0);
        },
        NEG8r => {
            NEG8r_ND;
        },
        LZCNT16rr => {
            LZCNT32rr;
        },
        POPCNT16rr => {
            POPCNT32rr;
        },
        TZCNT16rr => {
            TZCNT32rr;
        },
        BSF16rr => {
            BSF32rr;
        },
        BLSI32rr => {
            BLSI32rr_EVEX;
        },
        BLSR32rr => {
            BLSR32rr_EVEX;
        },
    }
}

fn X86InstrInfo::findDominatingRedundantFlagInstr(self: *X86InstrInfo, CmpInstr: *mut MachineInstr, SrcReg: Register, SrcReg2: Register, CmpMask: i64, CmpValue: i64, MultiPredMBB: *mut MachineBasicBlock, IsSwapped: *mut bool, ImmDelta: *mut i64, InstsToUpdate: *mut pair<MachineInstr *, unsigned int>>) -> *mut MachineInstr {
    assert!(self.Subtarget.hasNF(), "NF feature required");
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    let mut Sub: *mut MachineInstr = null;
    let mut SubMBB: *mut MachineBasicBlock = null;
    let mut Pending: pair<MachineInstr *, unsigned int>, 4> = pair<MachineInstr *, unsigned int>, 4> {};
    let mut CmpMBB: *mut MachineBasicBlock = CmpInstr.getParent();
    let mut Visited: SmallPtrSet<MachineBasicBlock *, 8> = SmallPtrSet<MachineBasicBlock *, 8> {};
    let mut Worklist: SmallVector<MachineBasicBlock *, 8> = SmallVector<MachineBasicBlock *, 8> {};
    for let mut MBB: *mut MachineBasicBlock = CmpMBB; MBB != MultiPredMBB; MBB = MBB.getSinglePredecessor() {
        Visited.insert(MBB);
    }
    Visited.insert(MultiPredMBB);
    let mut CmpMBBOnCycle: bool = false;
    let mut TryPush: Closure_4 = Closure_4 { CmpMBB: &mut CmpMBB, CmpMBBOnCycle: &mut CmpMBBOnCycle, Visited: &mut Visited, Worklist: &mut Worklist };
    for Pred in MultiPredMBB.predecessors() {
        TryPush.call(Pred);
    }
    while !Worklist.is_empty() {
        let mut MBB: *mut MachineBasicBlock = Worklist.pop_back_val();
        let mut Producer: *mut MachineInstr = null;
        for Inst in reverse(*MBB) {
            if !Inst.modifiesRegister(EFLAGS, TRI) {
                continue;
            }
            if self.isRedundantFlagInstr(CmpInstr, SrcReg, SrcReg2, CmpMask, CmpValue, Inst, &mut IsSwapped, &mut ImmDelta) {
                Producer = &mut Inst;
                break;
            }
            let mut NewOpc: u32 = getNFVariantIfClobberRemovable(Inst, TRI);
            if !NewOpc {
                return null;
            }
            if InstsToUpdate.len + Pending.len >= MaxNFConversions.operator unsigned int() {
                return null;
            }
            Pending.push(make_pair(&mut Inst, NewOpc));
        }
        if Producer {
            if Sub && SubMBB != MBB {
                return null;
            }
            Sub = Producer;
            SubMBB = MBB;
            continue;
        }
        if MBB.pred_empty() {
            return null;
        }
        for Pred in MBB.predecessors() {
            TryPush.call(Pred);
        }
    }
    if !Sub {
        return null;
    }
    if IsSwapped || ImmDelta != 0 {
        return null;
    }
    if CmpMBBOnCycle {
        for Inst in make_range(next(CmpInstr, 1), CmpMBB.end()) {
            if !Inst.modifiesRegister(EFLAGS, TRI) {
                continue;
            }
            let mut NewOpc: u32 = getNFVariantIfClobberRemovable(Inst, TRI);
            if !NewOpc {
                return null;
            }
            if InstsToUpdate.len + Pending.len >= MaxNFConversions.operator unsigned int() {
                return null;
            }
            Pending.push(make_pair(&mut Inst, NewOpc));
        }
    }
    InstsToUpdate.append(Pending.begin(), Pending.end());
    return Sub;
}

fn X86InstrInfo::optimizeCompareInstr(self: *X86InstrInfo, CmpInstr: *mut MachineInstr, SrcReg: Register, SrcReg2: Register, CmpMask: i64, CmpValue: i64, MRI: *MachineRegisterInfo) -> bool {
    match CmpInstr.getOpcode() {
        _ => {
            break;
        },
        SUB64ri32 => {
            SUB64ri32_ND;
        },
    }
    let mut IsCmpZero: bool = (CmpMask != 0 && CmpValue == 0);
    if SrcReg2.isPhysical() {
        return false;
    }
    let mut SrcRegDef: *mut MachineInstr = MRI.getVRegDef(SrcReg);
    if !SrcRegDef {
        return false;
    }
    let mut MI: *mut MachineInstr = null;
    let mut Sub: *mut MachineInstr = null;
    let mut Movr0Inst: *mut MachineInstr = null;
    let mut LTZCNTInst: *mut MachineInstr = null;
    let mut InstsToUpdate: pair<MachineInstr *, unsigned int>, 4> = pair<MachineInstr *, unsigned int>, 4> {};
    let mut NoSignFlag: bool = false;
    let mut ClearsOverflowFlag: bool = false;
    let mut ShouldUpdateCC: bool = false;
    let mut IsSwapped: bool = false;
    let mut HasNF: bool = self.Subtarget.hasNF();
    let mut OpNo: u32 = 0;
    let mut NewCC: CondCode = COND_INVALID;
    let mut ImmDelta: i64 = 0;
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    let mut CmpMBB: *mut MachineBasicBlock = *CmpInstr.getParent();
    let mut From: reverse_iterator = next(CmpInstr, 1);
    for let mut MBB: *mut MachineBasicBlock = &mut CmpMBB; ;  {
        for Inst in make_range(From, MBB.rend()) {
            if &mut Inst == SrcRegDef {
                if IsCmpZero && isDefConvertible(Inst, NoSignFlag, ClearsOverflowFlag) {
                    MI = &mut Inst;
                    break;
                }
                let mut AndInstr: *mut MachineInstr = null;
                if IsCmpZero && findRedundantFlagInstr(CmpInstr, Inst, MRI, &mut AndInstr, TRI, self.Subtarget, NoSignFlag, ClearsOverflowFlag) {
                    assert!(AndInstr != null && isAND(AndInstr.getOpcode();
                    MI = AndInstr;
                    break;
                }
                return false;
            }
            if Inst.modifiesRegister(EFLAGS, TRI) {
                if IsCmpZero {
                    tie(NewCC, OpNo) = isUseDefConvertible(Inst);
                    if NewCC != COND_INVALID && Inst.getOperand(OpNo).isReg() && Inst.getOperand(OpNo).getReg() == SrcReg {
                        ShouldUpdateCC = true;
                        MI = &mut Inst;
                        break;
                    }
                }
                if self.isRedundantFlagInstr(CmpInstr, SrcReg, SrcReg2, CmpMask, CmpValue, Inst, &mut IsSwapped, &mut ImmDelta) {
                    Sub = &mut Inst;
                    break;
                }
                if isCmpRedundantAfterLTZCNT(SrcReg, SrcReg2, CmpMask, CmpValue, Inst) {
                    LTZCNTInst = &mut Inst;
                    break;
                }
                if !Movr0Inst && Inst.getOpcode() == MOV32r0 && Inst.registerDefIsDead(EFLAGS, TRI) {
                    Movr0Inst = &mut Inst;
                    continue;
                }
                if HasNF {
                    let mut NewOp: u32 = getNFVariantIfClobberRemovable(Inst, TRI);
                    if !NewOp {
                        return false;
                    }
                    InstsToUpdate.push(make_pair(&mut Inst, NewOp));
                    continue;
                }
                return false;
            }
        }
        if MI || Sub || LTZCNTInst {
            break;
        }
        if MBB.pred_size() != 1 {
            if HasNF {
                Sub = self.findDominatingRedundantFlagInstr(CmpInstr, SrcReg, SrcReg2, CmpMask, CmpValue, MBB, IsSwapped, ImmDelta, InstsToUpdate);
            }
            if !Sub {
                return false;
            }
            break;
        }
        MBB = *MBB.pred_begin();
        From = MBB.rbegin();
    }
    let mut FlagsMayLiveOut: bool = true;
    let mut OpsToUpdate: CondCode>, 4> = CondCode>, 4> {};
    let mut AfterCmpInstr: iterator = next(CmpInstr, 1);
    for Instr in make_range(AfterCmpInstr, CmpMBB.end()) {
        let mut ModifyEFLAGS: bool = Instr.modifiesRegister(EFLAGS, TRI);
        let mut UseEFLAGS: bool = Instr.readsRegister(EFLAGS, TRI);
        if !UseEFLAGS && ModifyEFLAGS {
            FlagsMayLiveOut = false;
            break;
        }
        if !UseEFLAGS && !ModifyEFLAGS {
            continue;
        }
        let mut OldCC: CondCode = getCondFromMI(Instr);
        if (MI || IsSwapped || ImmDelta != 0) && OldCC == COND_INVALID {
            return false;
        }
        let mut ReplacementCC: CondCode = COND_INVALID;
        if MI {
            match OldCC {
                _ => {
                    break;
                },
                COND_A => {
                    COND_AE;
                },
                COND_G => {
                    COND_GE;
                },
                COND_O => {
                    COND_NO;
                },
                COND_S => {
                    COND_NS;
                },
            }
            if ShouldUpdateCC {
                match OldCC {
                    _ => {
                        return false;
                    },
                    COND_E => {
                        ReplacementCC = NewCC;
                    },
                    COND_NE => {
                        ReplacementCC = GetOppositeBranchCondition(NewCC);
                    },
                }
            }
        } else if IsSwapped {
            ReplacementCC = getSwappedCondition(OldCC);
            if ReplacementCC == COND_INVALID {
                return false;
            }
            ShouldUpdateCC = true;
        } else if ImmDelta != 0 {
            let mut BitWidth: u32 = self.RI.getRegSizeInBits(*MRI.getRegClass(SrcReg)).operator unsigned long long();
            match OldCC {
                COND_L => {
                    if ImmDelta != 1 || getSignedMinValue(BitWidth) == CmpValue {
                        return false;
                    }
                },
                COND_B => {
                    if ImmDelta != 1 || CmpValue == 0 {
                        return false;
                    }
                },
                COND_GE => {
                    if ImmDelta != 1 || getSignedMinValue(BitWidth) == CmpValue {
                        return false;
                    }
                },
                COND_AE => {
                    if ImmDelta != 1 || CmpValue == 0 {
                        return false;
                    }
                },
                COND_G => {
                    if ImmDelta != -1 || getSignedMaxValue(BitWidth) == CmpValue {
                        return false;
                    }
                },
                COND_A => {
                    if ImmDelta != -1 || getMaxValue(BitWidth) == CmpValue {
                        return false;
                    }
                },
                COND_LE => {
                    if ImmDelta != -1 || getSignedMaxValue(BitWidth) == CmpValue {
                        return false;
                    }
                },
                COND_BE => {
                    if ImmDelta != -1 || getMaxValue(BitWidth) == CmpValue {
                        return false;
                    }
                },
                _ => {
                    return false;
                },
            }
            ShouldUpdateCC = true;
        }
        if LTZCNTInst {
            let mut InstCode: u32 = Instr.getOpcode();
            if !isADC(InstCode) && !isSBB(InstCode) && !isRCL(InstCode) && !isRCR(InstCode) {
                return false;
            }
            MI = LTZCNTInst;
        }
        if ShouldUpdateCC && ReplacementCC != OldCC {
            OpsToUpdate.push(make_pair(&mut Instr, ReplacementCC));
        }
        if ModifyEFLAGS || Instr.killsRegister(EFLAGS, TRI) {
            FlagsMayLiveOut = false;
            break;
        }
    }
    if LTZCNTInst && !MI {
        return false;
    }
    if (MI != null || ShouldUpdateCC) && FlagsMayLiveOut {
        for Successor in CmpMBB.successors() {
            if Successor.isLiveIn(EFLAGS, getAll()) {
                return false;
            }
        }
    }
    assert!((MI == null || Sub == null), "Should not have Sub and MI set");
    Sub = if MI != null { MI } else { Sub };
    let mut SubBB: *mut MachineBasicBlock = Sub.getParent();
    if Movr0Inst {
        if &mut CmpMBB != SubBB {
            return false;
        }
        let mut InsertI: reverse_iterator = Sub;
        let mut InsertE: reverse_iterator = Sub.getParent().rend();
        for ; InsertI != InsertE; operator(InsertI) {
            let mut Instr: *mut MachineInstr = &mut operator(InsertI);
            if !Instr.readsRegister(EFLAGS, TRI) && Instr.modifiesRegister(EFLAGS, TRI) {
                Movr0Inst.getParent().remove(Movr0Inst);
                Instr.getParent().insert(Instr, Movr0Inst);
                break;
            }
        }
        if InsertI == InsertE {
            return false;
        }
    }
    for Inst in InstsToUpdate {
        Inst.first.setDesc(self.get(Inst.second));
        Inst.first.removeOperand(Inst.first.findRegisterDefOperandIdx(EFLAGS, null, false, false));
    }
    let mut FlagDef: *mut MachineOperand = Sub.findRegisterDefOperand(EFLAGS, null, false, false);
    assert!(FlagDef, "Unable to locate a def EFLAGS operand");
    FlagDef.setIsDead(false);
    CmpInstr.eraseFromParent();
    for Op in OpsToUpdate {
        Op.first.getOperand(Op.first.getDesc().getNumOperands() - 1).setImm(Op.second);
    }
    let mut Visited: SmallPtrSet<MachineBasicBlock *, 8> = SmallPtrSet<MachineBasicBlock *, 8> {};
    let mut Worklist: SmallVector<MachineBasicBlock *, 8> = SmallVector<MachineBasicBlock *, 8> { 1, &mut CmpMBB };
    Visited.insert(&mut CmpMBB);
    while !Worklist.is_empty() {
        let mut MBB: *mut MachineBasicBlock = Worklist.pop_back_val();
        if MBB == SubBB {
            continue;
        }
        if !MBB.isLiveIn(EFLAGS, getAll()) {
            MBB.addLiveIn(EFLAGS, getAll());
        }
        for Pred in MBB.predecessors() {
            if Visited.insert(Pred).second {
                Worklist.push(Pred);
            }
        }
    }
    return true;
}

fn canConvert2Copy(Opc: u32) -> bool {
    match Opc {
        _ => {
