            },
        }
        let mut DL: *DebugLoc = Orig.getDebugLoc();
        BuildMI(MBB, DL, get())(Orig.getOperand(0))(Value);
    } else {
        let mut MI: *mut MachineInstr = MBB.getParent().CloneMachineInstr(&mut Orig);
        MBB()(MI);
    }
    let mut NewMI: *mut MachineInstr = operator*(prev());
    NewMI.substituteRegister;
}

