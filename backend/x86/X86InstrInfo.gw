enum MachineOutlinerClass {
    MachineOutlinerDefault = 0,
    MachineOutlinerTailCall = 1,
}

fn X86InstrInfo::getOutliningCandidateInfo(self: *X86InstrInfo, MMI: *MachineModuleInfo, RepeatedSequenceLocs: *mut i32, MinRepeats: u32) -> i32 {
    let mut SequenceSize: u32 = 0;
    let mut CFICount: u32 = 0;
    if RepeatedSequenceLocs()[0]()() {
        return make_unique(SequenceSize, 0, MachineOutlinerTailCall);
    }
    if CFICount > 0 {
        return nullopt();
    }
    return make_unique(SequenceSize, 1, MachineOutlinerDefault);
}

fn X86InstrInfo::isFunctionSafeToOutlineFrom(self: *X86InstrInfo, MF: *mut MachineFunction, OutlineFromLinkOnceODRs: bool) -> bool {
    let mut F: *Function = MF.getFunction();
    if self.Subtarget.getFrameLowering().has128ByteRedZone(MF) {
        let mut X86FI: *X86MachineFunctionInfo = MF;
        if !X86FI || X86FI.getUsesRedZone() {
            return false;
        }
    }
    if !OutlineFromLinkOnceODRs && F.hasLinkOnceODRLinkage {
        return false;
    }
    return true;
}

fn X86InstrInfo::getOutliningTypeImpl(self: *X86InstrInfo, MMI: *MachineModuleInfo, MIT: *mut i32, Flags: u32) -> InstrType {
    let mut MI: *mut MachineInstr = operator*();
    if MI.isTerminator(AnyInBundle) {
        return Legal;
    }
    if MI.modifiesRegister || MI.readsRegister || MI.getDesc().hasImplicitUseOfPhysReg || MI.getDesc().hasImplicitDefOfPhysReg {
        return Illegal;
    }
    if MI.readsRegister || MI.getDesc().hasImplicitUseOfPhysReg || MI.getDesc().hasImplicitDefOfPhysReg {
        return Illegal;
    }
    if MI.isCFIInstruction() {
        return Illegal;
    }
    return Legal;
}

fn X86InstrInfo::buildOutlinedFrame(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, MF: *mut MachineFunction, OF: *OutlinedFunction) {
    if OF.FrameConstructionID == MachineOutlinerTailCall {
        return;
    }
    let mut retq: *mut MachineInstr = BuildMI(MF, DebugLoc { Loc: null }, get());
    MBB()(MBB()(), retq);
}

fn X86InstrInfo::insertOutlinedCall(self: *X86InstrInfo, M: *mut Module, MBB: *mut MachineBasicBlock, It: *mut i32, MF: *mut MachineFunction, C: *mut Candidate) -> i32 {
    if C.CallConstructionID == MachineOutlinerTailCall {
        It() = MBB()(BuildMI(MF, DebugLoc { Loc: null }, get())(M.getNamedValue(MF.getName())));
    } else {
        It() = MBB()(BuildMI(MF, DebugLoc { Loc: null }, get())(M.getNamedValue(MF.getName())));
    }
    return ;
}

fn X86InstrInfo::buildClearRegister(self: *X86InstrInfo, Reg: Register, MBB: *mut MachineBasicBlock, Iter: i32, DL: *mut DebugLoc, AllowSideEffects: bool) {
    let mut MF: *MachineFunction = *MBB.getParent();
    let mut ST: *X86Subtarget = MF;
    let mut TRI: *TargetRegisterInfo = self.getRegisterInfo();
    if  {
        return;
    }
    if TRI.isGeneralPurposeRegister(MF, Reg.operator MCRegister()) {
        Reg = Register { Reg: getX86SubSuperRegister(Reg.operator MCRegister(), 32, false) };
        if !AllowSideEffects {
            BuildMI(MBB, DL, get(), Reg)(0);
        } else {
            BuildMI(MBB, DL, get(), Reg)(Reg, Undef)(Reg, Undef);
        }
    } else if  {
        if !ST.hasSSE1() {
            return;
        }
        BuildMI(MBB, DL, get(), Reg);
    } else if  {
        if !ST.hasAVX() {
            return;
        }
        BuildMI(MBB, DL, get(), TRI.getSubReg);
    } else if  {
        if !ST.hasAVX512() {
            return;
        }
        BuildMI(MBB, DL, get(), TRI.getSubReg);
    } else if  {
        if !ST.hasAVX512() {
            return;
        }
        let mut Op: u32 = 0;
        BuildMI(MBB, DL, get(Op), Reg);
    }
}

