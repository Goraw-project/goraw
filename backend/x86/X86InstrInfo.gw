fn getThreeSrcCommuteCase(TSFlags: u64, SrcOpIdx1: u32, SrcOpIdx2: u32) -> u32 {
    if SrcOpIdx1 > SrcOpIdx2 {
        swap(SrcOpIdx1, SrcOpIdx2);
    }
    let mut Op1: u32 = 1;
    let mut Op2: u32 = 2;
    let mut Op3: u32 = 3;
    if isKMasked(TSFlags) {
        Op2 += 1;
        Op3 += 1;
    }
    if SrcOpIdx1 == Op1 && SrcOpIdx2 == Op2 {
        return 0;
    }
    if SrcOpIdx1 == Op1 && SrcOpIdx2 == Op3 {
        return 1;
    }
    if SrcOpIdx1 == Op2 && SrcOpIdx2 == Op3 {
        return 2;
    }
    llvm_unreachable_internal("Unknown three src commute case.", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 2045);
}

fn X86InstrInfo::getFMA3OpcodeToCommuteOperands(self: *X86InstrInfo, MI: *MachineInstr, SrcOpIdx1: u32, SrcOpIdx2: u32, FMA3Group: *X86InstrFMA3Group) -> u32 {
    let mut Opc: u32 = MI.getOpcode();
    assert!(!(FMA3Group.isIntrinsic() && (SrcOpIdx1 == 1 || SrcOpIdx2 == 1)), "Intrinsic instructions can't commute operand 1");
    let mut Case: u32 = getThreeSrcCommuteCase(MI.getDesc().TSFlags, SrcOpIdx1, SrcOpIdx2);
    assert!(Case < 3, "Unexpected case number!");
    let mut Form132Index: u32 = 0;
    let mut Form213Index: u32 = 1;
    let mut Form231Index: u32 = 2;
    let mut FormMapping: [3]u32 = [[Form231Index, Form213Index, Form132Index], [Form132Index, Form231Index, Form213Index], [Form213Index, Form132Index, Form231Index]];
    let mut FMAForms: [3]u32 = zeroed();
    FMAForms[0] = FMA3Group.get132Opcode();
    FMAForms[1] = FMA3Group.get213Opcode();
    FMAForms[2] = FMA3Group.get231Opcode();
    for let mut FormIndex: u32 = 0; FormIndex < 3; FormIndex += 1 {
        if Opc == FMAForms[FormIndex] {
            return FMAForms[FormMapping[Case][FormIndex]];
        }
    }
    llvm_unreachable_internal("Illegal FMA3 format", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86InstrInfo.cpp", 2101);
}

fn commuteVPTERNLOG(MI: *mut MachineInstr, SrcOpIdx1: u32, SrcOpIdx2: u32) {
    let mut Case: u32 = getThreeSrcCommuteCase(MI.getDesc().TSFlags, SrcOpIdx1, SrcOpIdx2);
    assert!(Case < 3, "Unexpected case value!");
    let mut SwapMasks: [3]u8 = [[4, 16, 8, 32], [2, 16, 8, 64], [2, 4, 32, 64]];
    let mut Imm: u8 = MI.getOperand(MI.getNumOperands() - 1).getImm();
    let mut NewImm: u8 = Imm & ~(SwapMasks[Case][0] | SwapMasks[Case][1] | SwapMasks[Case][2] | SwapMasks[Case][3]);
    if Imm & SwapMasks[Case][0] {
        NewImm |= SwapMasks[Case][1];
    }
    if Imm & SwapMasks[Case][1] {
        NewImm |= SwapMasks[Case][0];
    }
    if Imm & SwapMasks[Case][2] {
        NewImm |= SwapMasks[Case][3];
    }
    if Imm & SwapMasks[Case][3] {
        NewImm |= SwapMasks[Case][2];
    }
    MI.getOperand(MI.getNumOperands() - 1).setImm(NewImm);
}

