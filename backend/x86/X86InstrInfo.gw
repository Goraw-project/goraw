fn X86InstrInfo::reMaterialize(self: *X86InstrInfo, MBB: *mut MachineBasicBlock, I: i32, DestReg: Register, SubIdx: u32, Orig: *MachineInstr, UsedLanes: LaneBitmask) {
    let mut ClobbersEFLAGS: bool = Orig.modifiesRegister;
