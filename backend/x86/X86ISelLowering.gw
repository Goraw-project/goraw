fn isTargetShuffle(Opcode: u32) -> bool {
    match Opcode {
        _ => {
            return false;
        },
    }
}

fn isTargetShuffleVariableMask(Opcode: u32) -> bool {
    match Opcode {
        _ => {
            return false;
        },
        OR => {
            AND;
        },
    }
}

fn X86TargetLowering::getReturnAddressFrameIndex(self: *X86TargetLowering, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut RegInfo: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut FuncInfo: *mut X86MachineFunctionInfo = MF;
    let mut ReturnAddrIndex: i32 = FuncInfo.getRAIndex();
    if ReturnAddrIndex == 0 {
        let mut SlotSize: u32 = RegInfo.getSlotSize();
        ReturnAddrIndex = MF.getFrameInfo().CreateFixedObject(SlotSize, -SlotSize as i64, false, false);
        FuncInfo.setRAIndex(ReturnAddrIndex);
    }
    return DAG.getFrameIndex(ReturnAddrIndex, self.getPointerTy);
}

fn isOffsetSuitableForCodeModel(Offset: i64, CM: Model, HasSymbolicDisplacement: bool) -> bool {
    if !isInt(Offset) {
        return false;
    }
    if !HasSymbolicDisplacement {
        return true;
    }
    if CM == Large {
        return true;
    }
    if CM == Kernel {
        return Offset >= 0;
    }
    return Offset < 16 * 1024 * 1024;
}

fn isX86CCSigned(X86CC: CondCode) -> bool {
    match X86CC {
        _ => {
            llvm_unreachable_internal("Invalid integer condition!", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 3224);
        },
        COND_E => {
            COND_NE;
        },
        COND_G => {
            COND_GE;
        },
    }
}

fn TranslateIntegerX86CC(SetCCOpcode: CondCode) -> CondCode {
    match SetCCOpcode {
        _ => {
            llvm_unreachable_internal("Invalid integer condition!", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 3243);
        },
        SETEQ => {
            return COND_E;
        },
        SETGT => {
            return COND_G;
        },
        SETGE => {
            return COND_GE;
        },
        SETLT => {
            return COND_L;
        },
        SETLE => {
            return COND_LE;
        },
        SETNE => {
            return COND_NE;
        },
        SETULT => {
            return COND_B;
        },
        SETUGT => {
            return COND_A;
        },
        SETULE => {
            return COND_BE;
        },
        SETUGE => {
            return COND_AE;
        },
    }
}

fn TranslateX86CC(SetCCOpcode: CondCode, DL: *SDLoc, isFP: bool, LHS: *mut SDValue, RHS: *mut SDValue, DAG: *mut SelectionDAG) -> CondCode {
    if !isFP {
        if dyn_cast(RHS) {
            RHSC;
        } else {
            if SetCCOpcode == SETGT && RHSC.isAllOnes() {
                RHS = DAG.getConstant(0, DL, RHS.getValueType(), false, false);
                return COND_NS;
            }
            if SetCCOpcode == SETLT && RHSC.isZero() {
                return COND_S;
            }
            if SetCCOpcode == SETGE && RHSC.isZero() {
                return COND_NS;
            }
            if SetCCOpcode == SETLT && RHSC.isOne() {
                RHS = DAG.getConstant(0, DL, RHS.getValueType(), false, false);
                return COND_LE;
            }
        }
        return TranslateIntegerX86CC(SetCCOpcode);
    }
    if isNON_EXTLoad(LHS.getNode()) && !isNON_EXTLoad(RHS.getNode()) {
        SetCCOpcode = getSetCCSwappedOperands(SetCCOpcode);
        swap(LHS, RHS);
    }
    match SetCCOpcode {
        _ => {
            break;
        },
        SETOLT => {
            SETOLE;
        },
    }
    match SetCCOpcode {
        _ => {
            llvm_unreachable_internal("Condcode should be pre-legalized away", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 3316);
        },
        SETUEQ => {
            SETEQ;
        },
        SETOLT => {
            SETOGT;
        },
        SETOLE => {
            SETOGE;
        },
        SETUGT => {
            SETULT;
        },
        SETUGE => {
            SETULE;
        },
        SETONE => {
            SETNE;
        },
        SETUO => {
            return COND_P;
        },
        SETO => {
            return COND_NP;
        },
        SETOEQ => {
            SETUNE;
        },
    }
}

fn hasFPCMov(X86CC: u32) -> bool {
    match X86CC {
        _ => {
            return false;
        },
        COND_B => {
            COND_BE;
        },
    }
}

fn useVPTERNLOG(Subtarget: *X86Subtarget, VT: MVT) -> bool {
    return Subtarget()() || Subtarget.canExtendTo512DQ() || VT.is512BitVector();
}

fn X86TargetLowering::getTgtMemIntrinsic(self: *X86TargetLowering, Infos: *mut SmallVectorImpl<IntrinsicInfo>, I: *CallBase, MF: *mut MachineFunction, Intrinsic: u32) {
    let mut Info: IntrinsicInfo = IntrinsicInfo {};
    Info.flags = MONone;
    Info.offset = 0;
    let mut IntrData: *IntrinsicData = getIntrinsicWithChain(Intrinsic);
    if !IntrData {
        match Intrinsic {

        }
        return;
    }
    match IntrData.Type {
        TRUNCATE_TO_MEM_VI8 => {
            TRUNCATE_TO_MEM_VI16;
        },
        GATHER => {
            GATHER_AVX2;
        },
        SCATTER => {
            Info.opc = INTRINSIC_VOID;
            Info.ptrVal = null;
            let mut DataVT: MVT = getVT(I.getArgOperand(3).getType(), false);
            let mut IndexVT: MVT = getVT(I.getArgOperand(2).getType(), false);
            let mut NumElts: u32 = min(DataVT.getVectorNumElements(), IndexVT.getVectorNumElements());
            Info.memVT = EVT { getVectorVT(DataVT.getVectorElementType(), NumElts) };
            Info.align = MaybeAlign { Align { ShiftValue: 1 } };
            Info.flags;
            Infos()(Info);
            return;
        },
        _ => {
            return;
        },
    }
}

