unsafe fn Closure_38::call(self: *mut Closure_38, N1: SDValue, N2: SDValue, PackVT: MVT) -> bool {
        let mut NumSrcBits: u32 = PackVT.getScalarSizeInBits();
        let mut NumPackedBits: u32 = NumSrcBits - (*self.BitSize);
        N1 = peekThroughBitcasts(N1);
        N2 = peekThroughBitcasts(N2);
        let mut NumBits1: u32 = N1.getScalarValueSizeInBits();
        let mut NumBits2: u32 = N2.getScalarValueSizeInBits();
        let mut IsZero1: bool = isNullOrNullSplat(N1, false);
        let mut IsZero2: bool = isNullOrNullSplat(N2, false);
        if (!N1.isUndef() && !IsZero1 && NumBits1 != NumSrcBits) || (!N2.isUndef() && !IsZero2 && NumBits2 != NumSrcBits) {
            return false;
        }
        if (*self.Subtarget).hasSSE41() || (*self.BitSize) == 8 {
            let mut ZeroMask: APInt = getHighBitsSet(NumSrcBits, NumPackedBits);
            if (N1.isUndef() || IsZero1 || (*self.DAG).MaskedValueIsZero(N1, ZeroMask, 0)) && (N2.isUndef() || IsZero2 || (*self.DAG).MaskedValueIsZero(N2, ZeroMask, 0)) {
                (*self.V1) = N1;
                (*self.V2) = N2;
                (*self.SrcVT) = PackVT;
                (*self.PackOpcode) = PACKUS;
                return true;
            }
        }
        let mut IsAllOnes1: bool = isAllOnesOrAllOnesSplat(N1, false);
        let mut IsAllOnes2: bool = isAllOnesOrAllOnesSplat(N2, false);
        if (N1.isUndef() || IsZero1 || IsAllOnes1 || (*self.DAG).ComputeNumSignBits(N1, 0) > NumPackedBits) && (N2.isUndef() || IsZero2 || IsAllOnes2 || (*self.DAG).ComputeNumSignBits(N2, 0) > NumPackedBits) {
            (*self.V1) = N1;
            (*self.V2) = N2;
            (*self.SrcVT) = PackVT;
            (*self.PackOpcode) = PACKSS;
            return true;
        }
        return false;
    }

