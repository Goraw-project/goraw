    let mut Res13: SDValue = DAG;
    Res02 = DAG.getBitcast(EVT { VT }, Res02);
    Res13 = DAG.getBitcast(EVT { VT }, Res13);
    return DAG.getNode(OR, DL, EVT { VT }, DAG.getVectorShuffle(EVT { VT }, DL, Res02, Res13, ArrayRef<int> { [0, 4, 2, 6] }), DAG.getVectorShuffle(EVT { VT }, DL, Res02, Res13, ArrayRef<int> { [1, 5, 3, 7] }));
}

fn X86TargetLowering::needsCmpXchgNb(self: *X86TargetLowering, MemType: *mut Type) -> bool {
    let mut OpWidth: u32 = MemType.getPrimitiveSizeInBits().operator unsigned long long();
    if OpWidth == 64 {
        return self.Subtarget.canUseCMPXCHG8B() && operator!(self.Subtarget());
    }
    if OpWidth == 128 {
        return self.Subtarget.canUseCMPXCHG16B();
    }
    return false;
}

fn X86TargetLowering::shouldExpandAtomicStoreInIR(self: *X86TargetLowering, SI: *mut StoreInst) -> AtomicExpansionKind {
    let mut MemType: *mut Type = SI.getValueOperand().getType();
    if !SI.getFunction().hasFnAttribute(NoImplicitFloat) && operator!(self.Subtarget()) {
        if MemType.getPrimitiveSizeInBits().operator unsigned long long() == 64 && operator!(self.Subtarget()) && (self.Subtarget.hasSSE1() || self.Subtarget()) {
            return None;
        }
        if MemType.getPrimitiveSizeInBits().operator unsigned long long() == 128 && self.Subtarget() && self.Subtarget.hasAVX() {
            return None;
        }
    }
    return if self.needsCmpXchgNb(MemType) { Expand } else { None };
}

fn X86TargetLowering::shouldExpandAtomicLoadInIR(self: *X86TargetLowering, LI: *mut LoadInst) -> AtomicExpansionKind {
    let mut MemType: *mut Type = LI.getType();
    if !LI.getFunction().hasFnAttribute(NoImplicitFloat) && operator!(self.Subtarget()) {
        if MemType.getPrimitiveSizeInBits().operator unsigned long long() == 64 && operator!(self.Subtarget()) && (self.Subtarget.hasSSE1() || self.Subtarget()) {
            return None;
        }
        if MemType.getPrimitiveSizeInBits().operator unsigned long long() == 128 && self.Subtarget() && self.Subtarget.hasAVX() {
            return None;
        }
    }
    return if self.needsCmpXchgNb(MemType) { CmpXChg } else { None };
}

