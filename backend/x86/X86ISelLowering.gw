        let mut RLo: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackl(DAG, DL, EVT { VT }, R, R));
        let mut RHi: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackh(DAG, DL, EVT { VT }, R, R));
        let mut ALo: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackl(DAG, DL, EVT { VT }, AmtMod, Z));
        let mut AHi: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackh(DAG, DL, EVT { VT }, AmtMod, Z));
        let mut Lo: SDValue = DAG.getNode(ShiftOpc, DL, EVT { ExtVT }, RLo, ALo);
        let mut Hi: SDValue = DAG.getNode(ShiftOpc, DL, EVT { ExtVT }, RHi, AHi);
        return getPack(DAG, Subtarget, DL, VT, Lo, Hi, IsROTL);
    }
    if EltSizeInBits == 8 {
        let mut WideVT: MVT = getVectorVT(if Subtarget()() { i16 } else { i32 }, NumElts);
        if supportedVectorVarShift(EVT { WideVT }, Subtarget, ShiftOpc) && supportedVectorShiftWithImm(EVT { WideVT }, Subtarget, ShiftOpc) {
            if ConstantAmt {
                return SDValue {};
            }
            R = DAG.getNode(ZERO_EXTEND, DL, EVT { WideVT }, R);
            R = DAG(OR, DL, WideVT, R, getTargetVShiftByConstNode(DL, WideVT, R, 8, DAG));
            Amt = DAG.getNode(ZERO_EXTEND, DL, EVT { WideVT }, AmtMod);
            R = DAG.getNode(ShiftOpc, DL, EVT { WideVT }, R, Amt);
            if IsROTL {
                R = getTargetVShiftByConstNode(DL, WideVT, R, 8, DAG);
            }
            return DAG.getNode(TRUNCATE, DL, EVT { VT }, R);
        }
