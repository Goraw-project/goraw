fn Closure_260::call(self: *Closure_260, Op: SDValue) -> bool {
        if !Op.hasOneUse() {
            return false;
        }
        let mut User: *mut SDNode = operator(operator(Op).user_begin());
        let mut VT: EVT = User.getValueType(0);
        return (User.getOpcode() == ZERO_EXTEND && (VT == EVT { i32 } || VT == EVT { i64 }));
