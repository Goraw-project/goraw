unsafe fn Closure_267::call(self: *mut Closure_267, I: i32) -> bool {
            return getTargetShuffleInputs((*self.Ops)[I], (*self.SrcOps)[I], (*self.SrcMasks)[I], (*self.DAG), (*self.Depth) + 1, true) && !is128BitLaneCrossingShuffleMask((*self.OpVT), (*self.SrcMasks)[I]) && none_of((*self.SrcMasks)[I], isUndefOrZero) && (*self.SrcMasks)[I].len == (*self.NumOpElts) && all_of((*self.SrcOps)[I], Closure_268 { OpVT: &mut (*self.OpVT) });
        }

