    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    if VT.isVectorOf(MVT { SimpleTy: i32 }) {
        if operator!(Subtarget()()) && !VT.is128BitVector() {
            return splitVectorIntBinary(Op, DAG, DL);
        }
        let mut MulVT: MVT = getVectorVT(MVT { SimpleTy: i64 }, VT.getSizeInBits().operator unsigned long long() / 64);
        let mut LHSLo: SDValue = DAG.getBitcast(EVT { MulVT }, LHS);
        let mut RHSLo: SDValue = DAG.getBitcast(EVT { MulVT }, RHS);
        if IsHigh {
            let mut Mask: SDValue = DAG.getTargetConstant(4294967295, DL, EVT { MulVT }, false);
            LHSLo = DAG.getNode(AND, DL, EVT { MulVT }, LHSLo, Mask);
            RHSLo = DAG.getNode(AND, DL, EVT { MulVT }, RHSLo, Mask);
        }
        let mut Res0: SDValue = DAG;
        let mut Res2: SDValue = DAG;
        LHS = getTargetVShiftByConstNode(DL, MulVT, LHS, 32, DAG);
        RHS = getTargetVShiftByConstNode(DL, MulVT, RHS, 32, DAG);
        let mut Res1: SDValue = DAG;
        let mut Res3: SDValue = DAG;
        let mut Res02: SDValue = getUnpackl(DAG, DL, EVT { VT }, DAG.getBitcast(EVT { VT }, Res0), DAG.getBitcast(EVT { VT }, Res2));
        let mut Res13: SDValue = getUnpackl(DAG, DL, EVT { VT }, DAG.getBitcast(EVT { VT }, Res1), DAG.getBitcast(EVT { VT }, Res3));
        return getUnpack(DAG, DL, EVT { VT }, Res02, Res13, IsHigh);
    }
    if VT.isVector() {
        return DAG.UnrollVectorOp(Op.getNode(), 0);
    }
    let mut ScalarVT: MVT = if Subtarget()() { i64 } else { i32 };
    let mut VecVT: MVT = if Subtarget()() { v2i64 } else { v4i32 };
    if VT != ScalarVT {
        LHS = DAG.getNode(ANY_EXTEND, DL, EVT { ScalarVT }, LHS);
        RHS = DAG.getNode(ANY_EXTEND, DL, EVT { ScalarVT }, RHS);
    }
    LHS = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { VecVT }, LHS);
    RHS = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { VecVT }, RHS);
    LHS = DAG.getBitcast(EVT { v2i64 }, LHS);
    RHS = DAG.getBitcast(EVT { v2i64 }, RHS);
    let mut Result: SDValue = DAG;
    let mut ExtractIdx: u32 = if IsHigh { 1 } else { 0 };
    Result = DAG.getBitcast(EVT { VecVT }, Result);
    Result = DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { ScalarVT }, Result, DAG.getVectorIdxConstant(ExtractIdx, DL, false));
    if VT != ScalarVT {
        Result = DAG.getNode(TRUNCATE, DL, EVT { VT }, Result);
    }
    return Result;
}

fn LowerPDEPPEXT(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    (((operator!(operator!((Subtarget()() && "BMI2 expected for PDEP/PEXT lowering")))) || (_wassert(L"Subtarget.hasBMI2() && \"BMI2 expected for PDEP/PEXT lowering\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (34020) as u32) , 0)) as void);
    let mut VT: MVT = Op.getSimpleValueType();
    let mut IsMinSize: bool = DAG.getMachineFunction().getFunction().hasMinSize();
    if VT.isVector() {
        if IsMinSize {
            return DAG.UnrollVectorOp(Op.getNode(), 0);
        }
        return SDValue {};
    }
    assert!((VT == i32 || VT == i64), "Unexpected PDEP/PEXT type");
    return Op;
}

fn LowerPARITY(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Op };
    let mut X: SDValue = Op.getOperand(0);
    let mut VT: MVT = Op.getSimpleValueType();
    if VT == i8 || DAG.computeKnownBits(X, 0).countMaxActiveBits() <= 8 {
        X = DAG.getNode(TRUNCATE, DL, EVT { i8 }, X);
        let mut Flags: SDValue = DAG;
        let mut Setnp: SDValue = getSETCC(COND_NP, Flags, DL, DAG);
        return DAG.getNode(ZERO_EXTEND, DL, EVT { VT }, Setnp);
    }
    if Subtarget()() {
        return SDValue {};
    }
    if VT == i64 {
        let mut Hi: SDValue = DAG.getNode(TRUNCATE, DL, EVT { i32 }, DAG.getNode(SRL, DL, EVT { i64 }, X, DAG.getConstant(32, DL, EVT { i8 }, false, false)));
        let mut Lo: SDValue = DAG.getNode(TRUNCATE, DL, EVT { i32 }, X);
        X = DAG.getNode(XOR, DL, EVT { i32 }, Lo, Hi);
    }
    if VT != i16 {
        let mut Hi16: SDValue = DAG.getNode(SRL, DL, EVT { i32 }, X, DAG.getConstant(16, DL, EVT { i8 }, false, false));
        X = DAG.getNode(XOR, DL, EVT { i32 }, X, Hi16);
    } else {
        X = DAG.getNode(ANY_EXTEND, DL, EVT { i32 }, X);
    }
    let mut Hi: SDValue = DAG.getNode(TRUNCATE, DL, EVT { i8 }, DAG.getNode(SRL, DL, EVT { i32 }, X, DAG.getConstant(8, DL, EVT { i8 }, false, false)));
    let mut Lo: SDValue = DAG.getNode(TRUNCATE, DL, EVT { i8 }, X);
    let mut VTs: SDVTList = DAG.getVTList(EVT { i8 }, EVT { i32 });
    let mut Flags: SDValue = DAG(1);
    let mut Setnp: SDValue = getSETCC(COND_NP, Flags, DL, DAG);
    return DAG.getNode(ZERO_EXTEND, DL, EVT { VT }, Setnp);
}

fn lowerAtomicArithWithLOCK(N: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut NewOpc: u32 = 0;
    match operator(N).getOpcode() {
        ATOMIC_LOAD_ADD => {
            
        },
        ATOMIC_LOAD_SUB => {
            
        },
        ATOMIC_LOAD_OR => {
            
        },
        ATOMIC_LOAD_XOR => {
            
        },
        ATOMIC_LOAD_AND => {
            
        },
        _ => {
            llvm_unreachable_internal("Unknown ATOMIC_LOAD_ opcode", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 34110);
        },
    }
    let mut MMO: *mut MachineMemOperand = cast(N)();
    return DAG;
}

fn lowerAtomicArith(N: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut AN: *mut AtomicSDNode = cast(N.getNode());
    let mut Chain: SDValue = operator(N).getOperand(0);
    let mut LHS: SDValue = operator(N).getOperand(1);
    let mut RHS: SDValue = operator(N).getOperand(2);
    let mut Opc: u32 = operator(N).getOpcode();
    let mut VT: MVT = operator(N).getSimpleValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if operator(N).hasAnyUseOfValue(0) {
        if Opc == ATOMIC_LOAD_SUB || (Opc == ATOMIC_LOAD_XOR && isMinSignedConstant(RHS)) {
            return DAG.getAtomic(ATOMIC_LOAD_ADD, DL, EVT { VT }, Chain, LHS, DAG.getNegative(RHS, DL, EVT { VT }), AN.getMemOperand());
        }
        assert!(Opc == ATOMIC_LOAD_ADD, "Used AtomicRMW ops other than Add should have been expanded!");
        return N;
    }
    if Opc == ATOMIC_LOAD_OR && isNullConstant(RHS) && !AN.isVolatile() {
        if AN.getSuccessOrdering() == SequentiallyConsistent && AN.getSyncScopeID() == System {
            let mut NewChain: SDValue = emitLockedStackOp(DAG, Subtarget, Chain, DL);
            assert!(!operator(N).hasAnyUseOfValue(0);
            return DAG.getNode(MERGE_VALUES, DL, operator(N).getVTList(), DAG.getUNDEF(EVT { VT }), NewChain);
        }
        let mut NewChain: SDValue = DAG.getNode(MEMBARRIER, DL, EVT { Other }, Chain);
        assert!(!operator(N).hasAnyUseOfValue(0);
        return DAG.getNode(MERGE_VALUES, DL, operator(N).getVTList(), DAG.getUNDEF(EVT { VT }), NewChain);
    }
    let mut LockOp: SDValue = lowerAtomicArithWithLOCK(N, DAG, Subtarget);
    assert!(!operator(N).hasAnyUseOfValue(0);
    return DAG.getNode(MERGE_VALUES, DL, operator(N).getVTList(), DAG.getUNDEF(EVT { VT }), LockOp.getValue(1));
}

fn LowerATOMIC_STORE(Op: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Node: *mut auto = cast(Op.getNode());
    let mut dl: SDLoc = Node();
    let mut VT: EVT = ();
    let mut IsSeqCst: bool = () == SequentiallyConsistent;
    let mut IsTypeLegal: bool = DAG.getTargetLoweringInfo().isTypeLegal;
    if !IsSeqCst && IsTypeLegal {
        return Op;
    }
    if !IsTypeLegal && operator!(Subtarget()()) && !DAG.getMachineFunction().getFunction().hasFnAttribute(NoImplicitFloat) {
        let mut Chain: SDValue = SDValue {};
        if VT == EVT { i128 } && Subtarget()() && Subtarget.hasAVX() {
            let mut VecVal: SDValue = DAG.getBitcast(v2i64);
            Chain = DAG(dl, VecVal);
        }
        if VT == EVT { i64 } {
            let mut BCValue: SDValue = peekThroughBitcasts();
            if BCValue.getValueType() == EVT { f64 } && (Subtarget()() || Subtarget.hasSSE2()) {
                Chain = DAG(dl, BCValue);
            } else if Subtarget.hasSSE1() {
                let mut SclToVec: SDValue = DAG(SCALAR_TO_VECTOR, dl, v2i64);
                let mut StVT: MVT = MVT { SimpleTy: if Subtarget.hasSSE2() { v2i64 } else { v4f32 } };
                SclToVec = DAG.getBitcast(EVT { StVT }, SclToVec);
                let mut Tys: SDVTList = DAG.getVTList(EVT { Other });
                let mut Ops: []SDValue = void { (), SclToVec, () };
                Chain = DAG;
            } else if Subtarget()() {
                let mut StackPtr: SDValue = DAG.CreateStackTemporary(EVT { i64 }, 1);
                let mut SPFI: i32 = cast(StackPtr.getNode())();
                let mut MPI: MachinePointerInfo = getFixedStack(DAG.getMachineFunction(), SPFI, 0);
                Chain = DAG(dl, StackPtr, MPI, MaybeAlign {}, MOStore);
                let mut Tys: SDVTList = DAG.getVTList(EVT { f80 }, EVT { Other });
                let mut LdOps: [2]SDValue = [Chain, StackPtr];
                let mut Value: SDValue = DAG;
                Chain = Value.getValue(1);
                let mut StoreOps: []SDValue = void { Chain, Value, () };
                Chain = DAG;
            }
        }
        if Chain {
            if IsSeqCst {
                Chain = emitLockedStackOp(DAG, Subtarget, Chain, dl);
            }
            return Chain;
        }
    }
    let mut Swap: SDValue = DAG(ATOMIC_SWAP, dl, (0), (2), (1));
    return Swap.getValue(1);
}

fn LowerADDSUBO_CARRY(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut N: *mut SDNode = Op.getNode();
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut Opc: u32 = Op.getOpcode();
    if operator!(DAG.getTargetLoweringInfo().isTypeLegal) {
        return SDValue {};
    }
    let mut VTs: SDVTList = DAG.getVTList(EVT { VT }, EVT { i32 });
    let mut DL: SDLoc = SDLoc { N };
    let mut Carry: SDValue = Op.getOperand(2);
    let mut CarryVT: EVT = Carry.getValueType();
    Carry = DAG;
    let mut IsAdd: bool = Opc == UADDO_CARRY || Opc == SADDO_CARRY;
    let mut Sum: SDValue = DAG;
    let mut IsSigned: bool = Opc == SADDO_CARRY || Opc == SSUBO_CARRY;
    let mut SetCC: SDValue = getSETCC(if IsSigned { COND_O } else { COND_B }, Sum.getValue(1), DL, DAG);
    if N.getValueType(1) == EVT { i1 } {
        SetCC = DAG.getNode(TRUNCATE, DL, EVT { i1 }, SetCC);
    }
    return DAG.getNode(MERGE_VALUES, DL, N.getVTList(), Sum, SetCC);
}

fn ExtendToType(InOp: SDValue, NVT: MVT, DAG: *mut SelectionDAG, FillWithZeroes: bool) -> SDValue {
    let mut InVT: MVT = InOp.getSimpleValueType();
    if InVT == NVT {
        return InOp;
    }
    if InOp.isUndef() {
        return DAG.getUNDEF(EVT { NVT });
    }
    assert!(InVT.getVectorElementType() == NVT.getVectorElementType(), "input and widen element type must match");
    let mut InNumElts: u32 = InVT.getVectorNumElements();
    let mut WidenNumElts: u32 = NVT.getVectorNumElements();
    assert!(WidenNumElts > InNumElts && WidenNumElts % InNumElts == 0, "Unexpected request for vector widening");
    let mut dl: SDLoc = SDLoc { InOp };
    if InOp.getOpcode() == CONCAT_VECTORS && InOp.getNumOperands() == 2 {
        let mut N1: SDValue = InOp.getOperand(1);
        if (isBuildVectorAllZeros(N1.getNode()) && FillWithZeroes) || N1.isUndef() {
            InOp = InOp.getOperand(0);
            InVT = InOp.getSimpleValueType();
            InNumElts = InVT.getVectorNumElements();
        }
    }
    if isBuildVectorOfConstantSDNodes(InOp.getNode()) || isBuildVectorOfConstantFPSDNodes(InOp.getNode()) {
        let mut EltVT: EVT = InOp.getOperand(0).getValueType();
        let mut FillVal: SDValue = if FillWithZeroes { DAG.getConstant(0, dl, EltVT, false, false) } else { DAG.getUNDEF(EltVT) };
        let mut Ops: SmallVector<SDValue, 16> = zeroed();
        Ops()(WidenNumElts - InNumElts, FillVal);
        return DAG(NVT, dl);
    }
    let mut FillVal: SDValue = if FillWithZeroes { DAG.getConstant(0, dl, EVT { NVT }, false, false) } else { DAG.getUNDEF(EVT { NVT }) };
    return DAG.getNode(INSERT_SUBVECTOR, dl, EVT { NVT }, FillVal, InOp, DAG.getVectorIdxConstant(0, dl, false));
}

fn LowerMSCATTER(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Subtarget.hasAVX512(), "MGATHER/MSCATTER are supported on AVX-512 arch only");
    let mut N: *mut MaskedScatterSDNode = cast(Op.getNode());
    let mut Src: SDValue = N.getValue();
    let mut VT: MVT = Src.getSimpleValueType();
    assert!(VT.getScalarSizeInBits() >= 32, "Unsupported scatter op");
    let mut dl: SDLoc = SDLoc { Op };
    let mut Scale: SDValue = N.getScale();
    let mut Index: SDValue = N.getIndex();
    let mut Mask: SDValue = N.getMask();
    let mut Chain: SDValue = N.getChain();
    let mut BasePtr: SDValue = N.getBasePtr();
    if VT == v2f32 || VT == v2i32 {
        assert!(Mask.getValueType() == EVT { v2i1 }, "Unexpected mask type");
        if Index.getValueType() == EVT { v2i64 } && Subtarget()() {
            let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
            let mut WideVT: EVT = TLI.getTypeToTransformTo;
            Src = DAG.getNode(CONCAT_VECTORS, dl, WideVT, Src, DAG.getUNDEF(EVT { VT }));
            let mut VTs: SDVTList = DAG.getVTList(EVT { Other });
            let mut Ops: [6]SDValue = [Chain, Src, Mask, BasePtr, Index, Scale];
            return DAG;
        }
        return SDValue {};
    }
    let mut IndexVT: MVT = Index.getSimpleValueType();
    if IndexVT == v2i32 {
        return SDValue {};
    }
    if operator!(Subtarget()()) && !VT.is512BitVector() && !Index.getSimpleValueType().is512BitVector() {
        let mut Factor: u32 = min(512 / VT.getSizeInBits().operator unsigned long long(), 512 / IndexVT.getSizeInBits().operator unsigned long long());
        let mut NumElts: u32 = VT.getVectorNumElements() * Factor;
        VT = getVectorVT(VT.getVectorElementType(), NumElts);
        IndexVT = getVectorVT(IndexVT.getVectorElementType(), NumElts);
        let mut MaskVT: MVT = getVectorVT(MVT { SimpleTy: i1 }, NumElts);
        Src = ExtendToType(Src, VT, DAG, false);
        Index = ExtendToType(Index, IndexVT, DAG, false);
        Mask = ExtendToType(Mask, MaskVT, DAG, true);
    }
    let mut VTs: SDVTList = DAG.getVTList(EVT { Other });
    let mut Ops: [6]SDValue = [Chain, Src, Mask, BasePtr, Index, Scale];
    return DAG;
}

fn LowerMLOAD(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut N: *mut MaskedLoadSDNode = cast(Op.getNode());
    let mut VT: MVT = Op.getSimpleValueType();
    let mut ScalarVT: MVT = VT.getScalarType();
    let mut Mask: SDValue = N.getMask();
    let mut MaskVT: MVT = Mask.getSimpleValueType();
    let mut PassThru: SDValue = N.getPassThru();
    let mut dl: SDLoc = SDLoc { Op };
    if MaskVT.getVectorElementType() != i1 {
        if PassThru.isUndef() || isBuildVectorAllZeros(PassThru.getNode()) {
            return Op;
        }
        let mut NewLoad: SDValue = DAG.getMaskedLoad(EVT { VT }, dl, N.getChain(), N.getBasePtr(), N.getOffset(), Mask, getZeroVector(VT, Subtarget, DAG, dl), N.getMemoryVT(), N.getMemOperand(), N.getAddressingMode(), N.getExtensionType(), N.isExpandingLoad());
        let mut Select: SDValue = DAG.getNode(VSELECT, dl, EVT { VT }, Mask, NewLoad, PassThru);
        return DAG.getMergeValues;
    }
    assert!((!N.isExpandingLoad() || Subtarget.hasAVX512()), "Expanding masked load is supported on AVX-512 target only!");
    assert!((!N.isExpandingLoad() || ScalarVT.getSizeInBits().operator unsigned long long() >= 32), "Expanding masked load is supported for 32 and 64-bit types only!");
    (((operator!(operator!((Subtarget.hasAVX512() && operator!(Subtarget()()) && !VT.is512BitVector() && "Cannot lower masked load op.")))) || (_wassert(L"Subtarget.hasAVX512() && !Subtarget.hasVLX() && !VT.is512BitVector() && \"Cannot lower masked load op.\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (34453) as u32) , 0)) as void);
    (((operator!(operator!(((ScalarVT.getSizeInBits().operator unsigned long long() >= 32 || (Subtarget()() && (ScalarVT == i8 || ScalarVT == i16 || ScalarVT == f16))) && "Unsupported masked load op.")))) || (_wassert(L"(ScalarVT.getSizeInBits() >= 32 || (Subtarget.hasBWI() && (ScalarVT == MVT::i8 || ScalarVT == MVT::i16 || ScalarVT == MVT::f16))) && \"Unsupported masked load op.\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (34458) as u32) , 0)) as void);
    let mut NumEltsInWideVec: u32 = 512 / VT.getScalarSizeInBits();
    let mut WideDataVT: MVT = getVectorVT(ScalarVT, NumEltsInWideVec);
    PassThru = ExtendToType(PassThru, WideDataVT, DAG, false);
    assert!(Mask.getSimpleValueType().getScalarType() == i1, "Unexpected mask type");
    let mut WideMaskVT: MVT = getVectorVT(MVT { SimpleTy: i1 }, NumEltsInWideVec);
    Mask = ExtendToType(Mask, WideMaskVT, DAG, true);
    let mut NewLoad: SDValue = DAG.getMaskedLoad(EVT { WideDataVT }, dl, N.getChain(), N.getBasePtr(), N.getOffset(), Mask, PassThru, N.getMemoryVT(), N.getMemOperand(), N.getAddressingMode(), N.getExtensionType(), N.isExpandingLoad());
    let mut Extract: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, dl, EVT { VT }, NewLoad.getValue(0), DAG.getVectorIdxConstant(0, dl, false));
    let mut RetOps: [2]SDValue = [Extract, NewLoad.getValue(1)];
    return DAG.getMergeValues;
}

fn LowerMSTORE(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut N: *mut MaskedStoreSDNode = cast(Op.getNode());
    let mut DataToStore: SDValue = N.getValue();
    let mut VT: MVT = DataToStore.getSimpleValueType();
    let mut ScalarVT: MVT = VT.getScalarType();
    let mut Mask: SDValue = N.getMask();
    let mut dl: SDLoc = SDLoc { Op };
    assert!((!N.isCompressingStore() || Subtarget.hasAVX512()), "Expanding masked load is supported on AVX-512 target only!");
    assert!((!N.isCompressingStore() || ScalarVT.getSizeInBits().operator unsigned long long() >= 32), "Expanding masked load is supported for 32 and 64-bit types only!");
    (((operator!(operator!((Subtarget.hasAVX512() && operator!(Subtarget()()) && !VT.is512BitVector() && "Cannot lower masked store op.")))) || (_wassert(L"Subtarget.hasAVX512() && !Subtarget.hasVLX() && !VT.is512BitVector() && \"Cannot lower masked store op.\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (34501) as u32) , 0)) as void);
    (((operator!(operator!(((ScalarVT.getSizeInBits().operator unsigned long long() >= 32 || (Subtarget()() && (ScalarVT == i8 || ScalarVT == i16 || ScalarVT == f16))) && "Unsupported masked store op.")))) || (_wassert(L"(ScalarVT.getSizeInBits() >= 32 || (Subtarget.hasBWI() && (ScalarVT == MVT::i8 || ScalarVT == MVT::i16 || ScalarVT == MVT::f16))) && \"Unsupported masked store op.\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (34506) as u32) , 0)) as void);
    let mut NumEltsInWideVec: u32 = 512 / VT.getScalarSizeInBits();
    let mut WideDataVT: MVT = getVectorVT(ScalarVT, NumEltsInWideVec);
    assert!(Mask.getSimpleValueType().getScalarType() == i1, "Unexpected mask type");
    let mut WideMaskVT: MVT = getVectorVT(MVT { SimpleTy: i1 }, NumEltsInWideVec);
    DataToStore = ExtendToType(DataToStore, WideDataVT, DAG, false);
    Mask = ExtendToType(Mask, WideMaskVT, DAG, true);
    return DAG.getMaskedStore(N.getChain(), dl, DataToStore, N.getBasePtr(), N.getOffset(), Mask, N.getMemoryVT(), N.getMemOperand(), N.getAddressingMode(), N.isTruncatingStore(), N.isCompressingStore());
}

fn LowerMGATHER(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Subtarget.hasAVX2(), "MGATHER/MSCATTER are supported on AVX-512/AVX-2 arch only");
    let mut N: *mut MaskedGatherSDNode = cast(Op.getNode());
    let mut dl: SDLoc = SDLoc { Op };
    let mut VT: MVT = Op.getSimpleValueType();
    let mut Index: SDValue = N.getIndex();
    let mut Mask: SDValue = N.getMask();
    let mut PassThru: SDValue = N.getPassThru();
    let mut IndexVT: MVT = Index.getSimpleValueType();
    assert!(VT.getScalarSizeInBits() >= 32, "Unsupported gather op");
    if IndexVT == v2i32 {
        return SDValue {};
    }
    let mut OrigVT: MVT = VT;
    if Subtarget.hasAVX512() && operator!(Subtarget()()) && !VT.is512BitVector() && !IndexVT.is512BitVector() {
        let mut Factor: u32 = min(512 / VT.getSizeInBits().operator unsigned long long(), 512 / IndexVT.getSizeInBits().operator unsigned long long());
        let mut NumElts: u32 = VT.getVectorNumElements() * Factor;
        VT = getVectorVT(VT.getVectorElementType(), NumElts);
        IndexVT = getVectorVT(IndexVT.getVectorElementType(), NumElts);
        let mut MaskVT: MVT = getVectorVT(MVT { SimpleTy: i1 }, NumElts);
        PassThru = ExtendToType(PassThru, VT, DAG, false);
        Index = ExtendToType(Index, IndexVT, DAG, false);
        Mask = ExtendToType(Mask, MaskVT, DAG, true);
    }
    if PassThru.isUndef() {
        PassThru = getZeroVector(VT, Subtarget, DAG, dl);
    }
    let mut Ops: [6]SDValue = [N.getChain(), PassThru, Mask, N.getBasePtr(), Index, N.getScale()];
    let mut NewGather: SDValue = DAG;
    let mut Extract: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, dl, EVT { OrigVT }, NewGather, DAG.getVectorIdxConstant(0, dl, false));
    return DAG.getMergeValues;
}

fn LowerADDRSPACECAST(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Op };
    let mut Src: SDValue = Op.getOperand(0);
    let mut DstVT: MVT = Op.getSimpleValueType();
    let mut N: *mut AddrSpaceCastSDNode = cast(Op.getNode());
    let mut SrcAS: u32 = N.getSrcAddressSpace();
    assert!(SrcAS != N.getDestAddressSpace(), "addrspacecast must be between different address spaces");
    if SrcAS == PTR32_UPTR && DstVT == i64 {
        Op = DAG.getNode(ZERO_EXTEND, dl, EVT { DstVT }, Src);
    } else if DstVT == i64 {
        Op = DAG.getNode(SIGN_EXTEND, dl, EVT { DstVT }, Src);
    } else if DstVT == i32 {
        Op = DAG.getNode(TRUNCATE, dl, EVT { DstVT }, Src);
    } else {
        report_fatal_error("Bad address space in addrspacecast", true);
    }
    return Op;
}

fn X86TargetLowering::LowerGC_TRANSITION(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Ops: SmallVector<SDValue, 2> = zeroed();
    Ops()(Op.getOperand(0));
    if operator(Op).getGluedNode() {
        Ops()(operator(Op).getOperand(operator(Op).getNumOperands() - 1));
    }
    let mut VTs: SDVTList = DAG.getVTList(EVT { Other }, EVT { Glue });
    return DAG;
}

fn LowerCVTPS2PH(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Op };
    let mut VT: EVT = Op.getValueType();
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    tie(Lo, Hi) = DAG.SplitVectorOperand(Op.getNode(), 0);
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = DAG.GetSplitDestVTs;
    let mut RC: SDValue = Op.getOperand(1);
    Lo = DAG;
    Hi = DAG;
    return DAG.getNode(CONCAT_VECTORS, dl, VT, Lo, Hi);
}

fn LowerPREFETCH(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsData: u32 = Op.getConstantOperandVal(4);
    if !IsData && operator!(Subtarget()()) {
        return Op.getOperand(0);
    }
    return Op;
}

fn getInstrStrFromOpNo(AsmStrs: *SmallVectorImpl<StringRef>, OpNo: u32) -> str {
    let mut Operand: APInt = APInt { 32, OpNo, false, false };
    let mut OpNoStr: str = toString(Operand, 10, false, false, true, false);
    let mut Str: str = " $";
    let mut OpNoStr1: str = Str + OpNoStr;
    let mut OpNoStr2: str = Str + "{" + OpNoStr + ":";
    let mut I: u64 = npos;
    for AsmStr in AsmStrs {
        if AsmStr.ends_with(OpNoStr1) {
            I = AsmStr.len - OpNoStr1.len;
        }
        if I == npos {
            I = AsmStr;
        }
        if I == npos {
            I = AsmStr.find(OpNoStr2, 0);
        }
        if I == npos {
            continue;
        }
        assert!(I > 0, "Unexpected inline asm string!");
        let mut TmpStr: str = AsmStr[0..0 + I];
        I = TmpStr.rfind(':', npos);
        if I != npos {
            TmpStr = TmpStr[I + 1..I + 1 + npos];
        }
        return TmpStr.take_while;
    }
    return "";
}

fn X86TargetLowering::isInlineAsmTargetBranch(self: *X86TargetLowering, AsmStrs: *SmallVectorImpl<StringRef>, OpNo: u32) -> bool {
    let mut Inst: str = getInstrStrFromOpNo(AsmStrs, OpNo);
    return Inst.equals_insensitive("call") || Inst.equals_insensitive("jmp");
}

fn getFlagsOfCmpZeroFori1(DAG: *mut SelectionDAG, DL: *SDLoc, Mask: SDValue) -> SDValue {
    let mut Ty: EVT = EVT { i8 };
    let mut V: SDValue = DAG.getBitcast(EVT { i1 }, Mask);
    let mut VE: SDValue = DAG.getZExtOrTrunc(V, DL, Ty);
    let mut Zero: SDValue = DAG.getConstant(0, DL, Ty, false, false);
    let mut X86SubVTs: SDVTList = DAG.getVTList(Ty, EVT { i32 });
    let mut CmpZero: auto = DAG;
    return ();
}

fn X86TargetLowering::visitMaskedLoad(self: *X86TargetLowering, DAG: *mut SelectionDAG, DL: *SDLoc, Chain: SDValue, MMO: *mut MachineMemOperand, NewLoad: *mut SDValue, Ptr: SDValue, PassThru: SDValue, Mask: SDValue) -> SDValue {
    let mut VTy: EVT = PassThru.getValueType();
    let mut Ty: EVT = VTy.getVectorElementType();
    let mut Tys: SDVTList = DAG.getVTList(Ty, EVT { Other });
    let mut ScalarPassThru: SDValue = if PassThru.isUndef() { DAG.getConstant(0, DL, Ty, false, false) } else { DAG.getBitcast(Ty, PassThru) };
    let mut Flags: SDValue = getFlagsOfCmpZeroFori1(DAG, DL, Mask);
    let mut COND_NE: SDValue = DAG.getTargetConstant(COND_NE, DL, EVT { i8 }, false);
    let mut Ops: [5]SDValue = [Chain, Ptr, ScalarPassThru, COND_NE, Flags];
    NewLoad = DAG;
    return DAG.getBitcast(VTy, NewLoad);
}

fn X86TargetLowering::visitMaskedStore(self: *X86TargetLowering, DAG: *mut SelectionDAG, DL: *SDLoc, Chain: SDValue, MMO: *mut MachineMemOperand, Ptr: SDValue, Val: SDValue, Mask: SDValue) -> SDValue {
    let mut Ty: EVT = Val.getValueType().getVectorElementType();
    let mut Tys: SDVTList = DAG.getVTList(EVT { Other });
    let mut ScalarVal: SDValue = DAG.getBitcast(Ty, Val);
    let mut Flags: SDValue = getFlagsOfCmpZeroFori1(DAG, DL, Mask);
    let mut COND_NE: SDValue = DAG.getTargetConstant(COND_NE, DL, EVT { i8 }, false);
    let mut Ops: [5]SDValue = [Chain, ScalarVal, Ptr, COND_NE, Flags];
    return DAG;
}

fn LowerPARTIAL_REDUCE_FMLA(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Op };
    let mut VT: MVT = Op.getSimpleValueType();
    let mut Acc: SDValue = Op.getOperand(0);
    let mut LHS: SDValue = Op.getOperand(1);
    let mut RHS: SDValue = Op.getOperand(2);
    let mut Opc: u32 = 0;
    if !VT.is512BitVector() && operator!(Subtarget()()) {
        Acc = widenSubVector(Acc, false, Subtarget, DAG, DL, 512);
        LHS = widenSubVector(LHS, false, Subtarget, DAG, DL, 512);
        RHS = widenSubVector(RHS, false, Subtarget, DAG, DL, 512);
        let mut Res: SDValue = DAG.getNode(Opc, DL, EVT { v16f32 }, Acc, LHS, RHS);
        return extractSubVector(Res, 0, DAG, DL, VT.getSizeInBits().operator unsigned long long());
    }
    return DAG.getNode(Opc, DL, EVT { VT }, Acc, LHS, RHS);
}

fn LowerPARTIAL_REDUCE_MLA(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Op };
    let mut VT: MVT = Op.getSimpleValueType();
    let mut Acc: SDValue = Op.getOperand(0);
    let mut LHS: SDValue = Op.getOperand(1);
    let mut RHS: SDValue = Op.getOperand(2);
    let mut IsI8: bool = LHS.getSimpleValueType().getScalarType() == i8;
    let mut Opc: u32 = 0;
    let mut Has512: bool = false;
    let mut HasVEX: bool = false;
    match Op.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected partial reduction opcode", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 34792);
        },
        PARTIAL_REDUCE_SUMLA => {
            if IsI8 {
                swap(LHS, RHS);
                Has512 = Subtarget()();
                HasVEX = Subtarget()();
            } else {
                Has512 = Subtarget()();
                HasVEX = Subtarget()();
            }
        },
        PARTIAL_REDUCE_SMLA => {
            if IsI8 {
                Has512 = Subtarget()();
                HasVEX = Subtarget()();
            } else {
                Has512 = Subtarget()();
                HasVEX = Subtarget()();
            }
        },
        PARTIAL_REDUCE_UMLA => {
            
        },
    }
    if VT.is512BitVector() && !Has512 {
        return splitVectorOp(Op, DAG, DL);
    }
    LHS = DAG.getBitcast(EVT { VT }, LHS);
    RHS = DAG.getBitcast(EVT { VT }, RHS);
    if !VT.is512BitVector() && operator!(Subtarget()()) && !HasVEX {
        return getAVX512Node(Opc, DL, VT, void { Acc, LHS, RHS }, DAG, Subtarget);
    }
    return DAG.getNode(Opc, DL, EVT { VT }, Acc, LHS, RHS);
}

fn X86TargetLowering::LowerOperation(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    match Op.getOpcode() {
        _ => {
            llvm_unreachable_internal("Should not custom lower this!", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 34844);
        },
        ATOMIC_FENCE => {
            return LowerATOMIC_FENCE(Op, self.Subtarget, DAG);
        },
        ATOMIC_CMP_SWAP_WITH_SUCCESS => {
            return LowerCMP_SWAP(Op, self.Subtarget, DAG);
        },
        CTPOP => {
            return LowerCTPOP(Op, self.Subtarget, DAG);
        },
        ATOMIC_LOAD_ADD => {
            ATOMIC_LOAD_SUB;
        },
        ATOMIC_STORE => {
            return LowerATOMIC_STORE(Op, DAG, self.Subtarget);
        },
        BITREVERSE => {
            return LowerBITREVERSE(Op, self.Subtarget, DAG);
        },
        CLMUL => {
            CLMULH;
        },
        PARITY => {
            return LowerPARITY(Op, self.Subtarget, DAG);
        },
        BUILD_VECTOR => {
            return self.LowerBUILD_VECTOR(Op, DAG);
        },
        CONCAT_VECTORS => {
            return LowerCONCAT_VECTORS(Op, self.Subtarget, DAG);
        },
        VECTOR_SHUFFLE => {
            return lowerVECTOR_SHUFFLE(Op, self.Subtarget, DAG);
        },
        VECTOR_COMPRESS => {
            return lowerVECTOR_COMPRESS(Op, self.Subtarget, DAG);
        },
        VSELECT => {
            return self.LowerVSELECT(Op, DAG);
        },
        EXTRACT_VECTOR_ELT => {
            return self.LowerEXTRACT_VECTOR_ELT(Op, DAG);
        },
        INSERT_VECTOR_ELT => {
            return self.LowerINSERT_VECTOR_ELT(Op, DAG);
        },
        INSERT_SUBVECTOR => {
            return LowerINSERT_SUBVECTOR(Op, self.Subtarget, DAG);
        },
        EXTRACT_SUBVECTOR => {
            return LowerEXTRACT_SUBVECTOR(Op, self.Subtarget, DAG);
        },
        SCALAR_TO_VECTOR => {
            return LowerSCALAR_TO_VECTOR(Op, self.Subtarget, DAG);
        },
        ConstantPool => {
            return self.LowerConstantPool(Op, DAG);
        },
        GlobalAddress => {
            return self.LowerGlobalAddress(Op, DAG);
        },
        GlobalTLSAddress => {
            return self.LowerGlobalTLSAddress(Op, DAG);
        },
        ExternalSymbol => {
            return self.LowerExternalSymbol(Op, DAG);
        },
        BlockAddress => {
            return self.LowerBlockAddress(Op, DAG);
        },
        SHL_PARTS => {
            SRA_PARTS;
        },
        FSHL => {
            FSHR;
        },
        STRICT_SINT_TO_FP => {
            SINT_TO_FP;
        },
        STRICT_UINT_TO_FP => {
            UINT_TO_FP;
        },
        TRUNCATE => {
            return self.LowerTRUNCATE(Op, DAG);
        },
        ZERO_EXTEND => {
            return LowerZERO_EXTEND(Op, self.Subtarget, DAG);
        },
        SIGN_EXTEND => {
            return LowerSIGN_EXTEND(Op, self.Subtarget, DAG);
        },
        ANY_EXTEND => {
            return LowerANY_EXTEND(Op, self.Subtarget, DAG);
        },
        ZERO_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        FP_TO_SINT => {
            STRICT_FP_TO_SINT;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        FP_EXTEND => {
            STRICT_FP_EXTEND;
        },
        FP_ROUND => {
            STRICT_FP_ROUND;
        },
        FP16_TO_FP => {
            STRICT_FP16_TO_FP;
        },
        FP_TO_FP16 => {
            STRICT_FP_TO_FP16;
        },
        BF16_TO_FP => {
            return self.LowerBF16_TO_FP(Op, DAG);
        },
        FP_TO_BF16 => {
            return self.LowerFP_TO_BF16(Op, DAG);
        },
        LOAD => {
            return LowerLoad(Op, self.Subtarget, DAG);
        },
        STORE => {
            return LowerStore(Op, self.Subtarget, DAG);
        },
        FADD => {
            FSUB;
        },
        FROUND => {
            return LowerFROUND(Op, DAG);
        },
        FABS => {
            FNEG;
        },
        FCOPYSIGN => {
            return LowerFCOPYSIGN(Op, DAG);
        },
        FGETSIGN => {
            return LowerFGETSIGN(Op, DAG);
        },
        LRINT => {
            LLRINT;
        },
        SETCC => {
            STRICT_FSETCC;
        },
        SETCCCARRY => {
            return self.LowerSETCCCARRY(Op, DAG);
        },
        SELECT => {
            return self.LowerSELECT(Op, DAG);
        },
        COND_LOOP => {
            BRCOND;
        },
        JumpTable => {
            return self.LowerJumpTable(Op, DAG);
        },
        VASTART => {
            return self.LowerVASTART(Op, DAG);
        },
        VAARG => {
            return self.LowerVAARG(Op, DAG);
        },
        VACOPY => {
            return LowerVACOPY(Op, self.Subtarget, DAG);
        },
        INTRINSIC_WO_CHAIN => {
            return self.LowerINTRINSIC_WO_CHAIN(Op, DAG);
        },
        INTRINSIC_VOID => {
            INTRINSIC_W_CHAIN;
        },
        RETURNADDR => {
            return self.LowerRETURNADDR(Op, DAG);
        },
        ADDROFRETURNADDR => {
            return self.LowerADDROFRETURNADDR(Op, DAG);
        },
        FRAMEADDR => {
            return self.LowerFRAMEADDR(Op, DAG);
        },
        FRAME_TO_ARGS_OFFSET => {
            return self.LowerFRAME_TO_ARGS_OFFSET(Op, DAG);
        },
        DYNAMIC_STACKALLOC => {
            return self.LowerDYNAMIC_STACKALLOC(Op, DAG);
        },
        EH_RETURN => {
            return self.LowerEH_RETURN(Op, DAG);
        },
        EH_SJLJ_SETJMP => {
            return self.lowerEH_SJLJ_SETJMP(Op, DAG);
        },
        EH_SJLJ_LONGJMP => {
            return self.lowerEH_SJLJ_LONGJMP(Op, DAG);
        },
        EH_SJLJ_SETUP_DISPATCH => {
            return self.lowerEH_SJLJ_SETUP_DISPATCH(Op, DAG);
        },
        INIT_TRAMPOLINE => {
            return self.LowerINIT_TRAMPOLINE(Op, DAG);
        },
        ADJUST_TRAMPOLINE => {
            return LowerADJUST_TRAMPOLINE(Op, DAG);
        },
        GET_ROUNDING => {
            return self.LowerGET_ROUNDING(Op, DAG);
        },
        SET_ROUNDING => {
            return self.LowerSET_ROUNDING(Op, DAG);
        },
        GET_FPENV_MEM => {
            return self.LowerGET_FPENV_MEM(Op, DAG);
        },
        SET_FPENV_MEM => {
            return self.LowerSET_FPENV_MEM(Op, DAG);
        },
        RESET_FPENV => {
            return self.LowerRESET_FPENV(Op, DAG);
        },
        CTLZ => {
            CTLZ_ZERO_POISON;
        },
        CTTZ => {
            CTTZ_ZERO_POISON;
        },
        MUL => {
            return LowerMUL(Op, self.Subtarget, DAG);
        },
        MULHS => {
            MULHU;
        },
        SMUL_LOHI => {
            UMUL_LOHI;
        },
        ROTL => {
            ROTR;
        },
        SRA => {
            SRL;
        },
        PDEP => {
            PEXT;
        },
        SADDO => {
            UADDO;
        },
        SMULO => {
            UMULO;
        },
        READCYCLECOUNTER => {
            return LowerREADCYCLECOUNTER(Op, self.Subtarget, DAG);
        },
        BITCAST => {
            return LowerBITCAST(Op, self.Subtarget, DAG);
        },
        SADDO_CARRY => {
            SSUBO_CARRY;
        },
        ADD => {
            SUB;
        },
        UADDSAT => {
            SADDSAT;
        },
        SMAX => {
            SMIN;
        },
        VECREDUCE_SMAX => {
            VECREDUCE_SMIN;
        },
        VECREDUCE_AND => {
            VECREDUCE_OR;
        },
        FMINIMUM => {
            FMAXIMUM;
        },
        ABS => {
            return LowerABS(Op, self.Subtarget, DAG);
        },
        ABDS => {
            ABDU;
        },
        AVGCEILU => {
            return LowerAVG(Op, self.Subtarget, DAG);
        },
        MLOAD => {
            return LowerMLOAD(Op, self.Subtarget, DAG);
        },
        MSTORE => {
            return LowerMSTORE(Op, self.Subtarget, DAG);
        },
        MGATHER => {
            return LowerMGATHER(Op, self.Subtarget, DAG);
        },
        MSCATTER => {
            return LowerMSCATTER(Op, self.Subtarget, DAG);
        },
        GC_TRANSITION_START => {
            GC_TRANSITION_END;
        },
        ADDRSPACECAST => {
            return LowerADDRSPACECAST(Op, DAG);
        },
        PREFETCH => {
            return LowerPREFETCH(Op, self.Subtarget, DAG);
        },
        FLDEXP => {
            return LowerFLDEXP(Op, self.Subtarget, DAG);
        },
        PARTIAL_REDUCE_SMLA => {
            PARTIAL_REDUCE_UMLA;
        },
        PARTIAL_REDUCE_FMLA => {
            return LowerPARTIAL_REDUCE_FMLA(Op, self.Subtarget, DAG);
        },
    }
}

fn X86TargetLowering::ReplaceNodeResults(self: *X86TargetLowering, N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) {
    let mut dl: SDLoc = SDLoc { N };
    let mut Opc: u32 = N.getOpcode();
    let mut NoImplicitFloatOps: bool = DAG.getMachineFunction().getFunction().hasFnAttribute(NoImplicitFloat);
    match Opc {
        _ => {
            dbgs() << "ReplaceNodeResults: ";
        },
        FADD => {
            FSUB;
        },
        AND => {
            OR;
        },
        SELECT => {
            let mut Cond: SDValue = N.getOperand(0);
            let mut TVal: SDValue = N.getOperand(1);
            let mut FVal: SDValue = N.getOperand(2);
            let mut VT: EVT = N.getValueType(0);
            assert!((VT == EVT { i128 } || VT == EVT { i256 } || VT == EVT { i512 }), "Unexpected VT!");
            if Cond.getValueType() != EVT { i1 } || !mayFoldIntoVector(TVal, DAG, self.Subtarget) || !mayFoldIntoVector(FVal, DAG, self.Subtarget) {
                return;
            }
            let mut VecVT: MVT = getVectorVT(MVT { SimpleTy: i32 }, VT.getSizeInBits().operator unsigned long long() / 32);
            let mut CondVT: MVT = VecVT.changeVectorElementType(MVT { SimpleTy: i1 });
            if self.isTypeLegal {
                let mut CondIntVT: MVT = getIntegerVT(CondVT.getVectorNumElements());
                Cond = DAG.getNode(SIGN_EXTEND, dl, EVT { CondIntVT }, Cond);
                Cond = DAG.getBitcast(EVT { CondVT }, Cond);
            } else {
                Cond = DAG.getNode(SIGN_EXTEND, dl, EVT { i32 }, Cond);
                Cond = DAG.getSetCC(dl, EVT { CondVT }, DAG.getConstant(0, dl, EVT { VecVT }, false, false), DAG.getSplatBuildVector(EVT { VecVT }, dl, Cond), SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
            }
            let mut Op: SDValue = DAG.getSelect(dl, EVT { VecVT }, Cond, DAG.getBitcast(EVT { VecVT }, TVal), DAG.getBitcast(EVT { VecVT }, FVal), SDNodeFlags { Flags: None });
            Results()(DAG.getBitcast(VT, Op));
            return;
        },
        ADD => {
            SUB;
        },
        SHL => {
            SRL;
        },
        FSHL => {
            FSHR;
        },
        CTPOP => {
            let mut N0: SDValue = N.getOperand(0);
            let mut VT: EVT = N.getValueType(0);
            if VT == EVT { i256 } || VT == EVT { i512 } {
                (((operator!(operator!((self.Subtarget() && "AVX512VPOPCNTDQ required")))) || (_wassert(L"Subtarget.hasVPOPCNTDQ() && \"AVX512VPOPCNTDQ required\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (35410) as u32) , 0)) as void);
                if !mayFoldIntoVector(N0, DAG, self.Subtarget) {
                    return;
                }
                let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
                let mut VecVT: MVT = getVectorVT(MVT { SimpleTy: i64 }, SizeInBits / 64);
                let mut Vec: SDValue = DAG.getBitcast(EVT { VecVT }, N0);
                if SizeInBits == 256 && operator!(self.Subtarget()) {
                    Vec = widenSubVector(Vec, true, self.Subtarget, DAG, dl, 512);
                }
                let mut Cnt: SDValue = DAG.getNode(CTPOP, dl, Vec.getValueType(), Vec);
                Cnt = DAG;
                Cnt = DAG;
                Cnt = DAG.getExtractVectorElt(dl, EVT { i64 }, Cnt, 0);
                Results()(DAG.getNode(ZERO_EXTEND, dl, VT, Cnt));
                return;
            }
            assert!(VT == EVT { i64 }, "Unexpected VT!");
            let mut Known: KnownBits = DAG.computeKnownBits(N0, 0);
            let mut LZ: u32 = Known.countMinLeadingZeros();
            let mut TZ: u32 = Known.countMinTrailingZeros();
            if (LZ + TZ) >= 32 {
                let mut Op: SDValue = DAG.getNode(SRL, dl, EVT { i64 }, N0, DAG.getShiftAmountConstant(TZ, EVT { i64 }, dl));
                Op = DAG.getNode(TRUNCATE, dl, EVT { i32 }, Op);
                Op = DAG.getNode(CTPOP, dl, EVT { i32 }, Op);
                Op = DAG.getNode(ZERO_EXTEND, dl, EVT { i64 }, Op);
                Results()(Op);
                return;
            }
            if self.isTypeLegal && !NoImplicitFloatOps {
                let mut Wide: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { v2i64 }, N0);
                Wide = DAG.getNode(CTPOP, dl, EVT { v2i64 }, Wide);
                Wide = DAG.getNode(BITCAST, dl, EVT { v4i32 }, Wide);
                Wide = DAG.getNode(EXTRACT_VECTOR_ELT, dl, EVT { i32 }, Wide, DAG.getVectorIdxConstant(0, dl, false));
                Wide = DAG.getNode(ZERO_EXTEND, dl, EVT { i64 }, Wide);
                Results()(Wide);
            }
            return;
        },
        CTLZ => {
            CTTZ;
        },
        MUL => {
            let mut VT: EVT = N.getValueType(0);
            assert!(== TypeWidenVector && VT.getVectorElementType() == EVT { i8 }, "Unexpected VT!");
            let mut MulVT: MVT = getVectorVT(MVT { SimpleTy: i16 }, VT.getVectorNumElements());
            let mut Op0: SDValue = DAG.getNode(ANY_EXTEND, dl, EVT { MulVT }, N.getOperand(0));
            let mut Op1: SDValue = DAG.getNode(ANY_EXTEND, dl, EVT { MulVT }, N.getOperand(1));
            let mut Res: SDValue = DAG.getNode(MUL, dl, EVT { MulVT }, Op0, Op1);
            Res = DAG.getNode(TRUNCATE, dl, VT, Res);
            let mut NumConcats: u32 = 16 / VT.getVectorNumElements();
            let mut ConcatOps: SmallVector<SDValue, 8> = zeroed();
            ConcatOps()[0] = Res;
            Res = DAG(CONCAT_VECTORS, dl, v16i8);
            Results()(Res);
            return;
        },
        SMULO => {
            UMULO;
        },
        CLMUL => {
            CLMULH;
        },
        STRICT_PSEUDO_FMIN => {
            STRICT_PSEUDO_FMAX;
        },
        SDIV => {
            UDIV;
        },
        TRUNCATE => {
            let mut VT: MVT = N.getSimpleValueType(0);
            if  != TypeWidenVector {
                return;
            }
            let mut WidenVT: MVT = self.getTypeToTransformTo(*DAG.getContext(), EVT { VT }).getSimpleVT();
            let mut In: SDValue = N.getOperand(0);
            let mut InVT: EVT = In.getValueType();
            let mut InEltVT: EVT = InVT.getVectorElementType();
