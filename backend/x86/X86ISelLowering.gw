fn X86TargetLowering::SetupEntryBlockForSjLj(self: *X86TargetLowering, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, DispatchBB: *mut MachineBasicBlock, FI: i32) {
    let mut MIMD: MIMetadata = MIMetadata { MI };
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut MRI: *mut MachineRegisterInfo = &mut MF.getRegInfo();
    let mut TII: *X86InstrInfo = self.Subtarget.getInstrInfo();
    let mut PVT: MVT = self.getPointerTy;
    assert!((PVT == i64 || PVT == i32), "Invalid Pointer Size!");
    let mut Op: u32 = 0;
    let mut VR: Register = Register { Reg: 0 };
    let mut UseImmLabel: bool = (MF.getTarget().getCodeModel() == Small) && operator!(self.isPositionIndependent);
    if UseImmLabel {} else {
        let mut TRC: *TargetRegisterClass = null;
        VR = MRI.createVirtualRegister(TRC, "");
        if self.Subtarget() {
            BuildMI(*MBB, MI, MIMD, TII(), VR)(1)(0)(DispatchBB)(0);
        } else {
            BuildMI(*MBB, MI, MIMD, TII(), VR)(0)(1)(0)(DispatchBB, self.Subtarget.classifyBlockAddressReference())(0);
        }
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*MBB, MI, MIMD, TII()(Op));
    addFrameReference(MIB, FI, if self.Subtarget() { 56 } else { 36 });
    if UseImmLabel {
        MIB()(DispatchBB);
    } else {
        MIB()(VR);
    }
}

fn X86TargetLowering::EmitSjLjDispatchBlock(self: *X86TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MIMD: MIMetadata = MIMetadata { MI };
    let mut MF: *mut MachineFunction = BB.getParent();
    let mut MRI: *mut MachineRegisterInfo = &mut MF.getRegInfo();
    let mut TII: *X86InstrInfo = self.Subtarget.getInstrInfo();
    let mut FI: i32 = MF.getFrameInfo().getFunctionContextIndex();
    let mut CallSiteNumToLPad: i32 = 0;
    let mut MaxCSNum: u32 = 0;
    let mut LPadList: i32 = 0;
