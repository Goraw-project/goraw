fn matchShuffleAsVSHLD(ShiftVT: *mut MVT, V1: *mut SDValue, V2: *mut SDValue, ScalarSizeInBits: u32, Mask: ArrayRef<int>) -> i32 {
    assert!(isPowerOf2_32(ScalarSizeInBits) && ScalarSizeInBits >= 8, "Unexpected element size");
    let mut Size: i32 = Mask.len;
    if is_contained(Mask, SM_SentinelZero) {
        return -1;
    }
    let mut FunnelMask: SmallVector<int, 32> = zeroed();
    for let mut Scale: i32 = 2; (Scale * ScalarSizeInBits) <= 64; Scale *= 2 {
        for let mut Shift: i32 = 1; Shift != Scale; Shift += 1 {
            for let mut Elt: i32 = 0; Elt != Size; Elt += Scale {
                iota(() + Elt, () + Elt + Shift, Elt + Size + (Scale - Shift));
                iota(() + Elt + Shift, () + Elt + Scale, Elt);
            }
            if isShuffleEquivalent(Mask) {
                let mut ShiftSVT: MVT = getIntegerVT(ScalarSizeInBits * Scale);
                ShiftVT = getVectorVT(ShiftSVT, Size / Scale);
                return Shift * ScalarSizeInBits;
            }
            commuteMask();
            if isShuffleEquivalent(Mask) {
                let mut ShiftSVT: MVT = getIntegerVT(ScalarSizeInBits * Scale);
                ShiftVT = getVectorVT(ShiftSVT, Size / Scale);
                swap(V1, V2);
                return Shift * ScalarSizeInBits;
            }
        }
    }
    return -1;
}

fn matchShuffleAsEXTRQ(VT: MVT, V1: *mut SDValue, V2: *mut SDValue, Mask: ArrayRef<int>, BitLen: *mut u64, BitIdx: *mut u64, Zeroable: *APInt) -> bool {
    let mut Size: i32 = Mask.len;
    let mut HalfSize: i32 = Size / 2;
    assert!(Size == VT.getVectorNumElements() as i32, "Unexpected mask size");
    assert!(!Zeroable.isAllOnes(), "Fully zeroable shuffle mask");
    if !isUndefUpperHalf(Mask) {
        return false;
    }
    let mut Len: i32 = HalfSize;
    for ; Len > 0; Len -= 1 {
        if !Zeroable[Len - 1] {
            break;
        }
    }
    assert!(Len > 0, "Zeroable shuffle mask");
    let mut Src: SDValue = SDValue {};
    let mut Idx: i32 = -1;
    for let mut i: i32 = 0; i != Len; i += 1 {
        let mut M: i32 = Mask[i];
        if M == SM_SentinelUndef {
            continue;
        }
        let mut V: *mut SDValue = (if M < Size { V1 } else { V2 });
        M = M % Size;
        if i > M || M >= HalfSize {
            return false;
        }
        if Idx < 0 || (Src == V && Idx == (M - i)) {
            Src = V;
            Idx = M - i;
            continue;
        }
        return false;
    }
    if !Src || Idx < 0 {
        return false;
    }
    assert!((Idx + Len) <= HalfSize, "Illegal extraction mask");
    BitLen = (Len * VT.getScalarSizeInBits()) & 63;
    BitIdx = (Idx * VT.getScalarSizeInBits()) & 63;
    V1 = Src;
    return true;
}

fn matchShuffleAsINSERTQ(VT: MVT, V1: *mut SDValue, V2: *mut SDValue, Mask: ArrayRef<int>, BitLen: *mut u64, BitIdx: *mut u64) -> bool {
    let mut Size: i32 = Mask.len;
    let mut HalfSize: i32 = Size / 2;
    assert!(Size == VT.getVectorNumElements() as i32, "Unexpected mask size");
    if !isUndefUpperHalf(Mask) {
        return false;
    }
    for let mut Idx: i32 = 0; Idx != HalfSize; Idx += 1 {
        let mut Base: SDValue = SDValue {};
        if isUndefInRange(Mask, 0, Idx) {} else if isSequentialOrUndefInRange(Mask, 0, Idx, 0, 1) {
            Base = V1;
        } else if isSequentialOrUndefInRange(Mask, 0, Idx, Size, 1) {
            Base = V2;
        } else {
            continue;
        }
        for let mut Hi: i32 = Idx + 1; Hi <= HalfSize; Hi += 1 {
            let mut Insert: SDValue = SDValue {};
            let mut Len: i32 = Hi - Idx;
            if isSequentialOrUndefInRange(Mask, Idx, Len, 0, 1) {
                Insert = V1;
            } else if isSequentialOrUndefInRange(Mask, Idx, Len, Size, 1) {
                Insert = V2;
            } else {
                continue;
            }
            if isUndefInRange(Mask, Hi, HalfSize - Hi) {} else if (!Base || (Base == V1)) && isSequentialOrUndefInRange(Mask, Hi, HalfSize - Hi, Hi, 1) {
                Base = V1;
            } else if (!Base || (Base == V2)) && isSequentialOrUndefInRange(Mask, Hi, HalfSize - Hi, Size + Hi, 1) {
                Base = V2;
            } else {
                continue;
            }
            BitLen = (Len * VT.getScalarSizeInBits()) & 63;
            BitIdx = (Idx * VT.getScalarSizeInBits()) & 63;
            V1 = Base;
            V2 = Insert;
            return true;
        }
    }
    return false;
}

fn lowerShuffleWithSSE4A(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, DAG: *mut SelectionDAG) -> SDValue {
    let mut BitLen: u64 = 0;
    let mut BitIdx: u64 = 0;
    if matchShuffleAsEXTRQ(VT, V1, V2, Mask, BitLen, BitIdx, Zeroable) {
        return DAG;
    }
    if matchShuffleAsINSERTQ(VT, V1, V2, Mask, BitLen, BitIdx) {
        return DAG;
    }
    return SDValue {};
}

fn lowerShuffleAsSpecificExtension(DL: *SDLoc, VT: MVT, Scale: i32, Offset: i32, ExtOpc: u32, InputV: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Scale > 1, "Need a scale to extend.");
    assert!(isExtOpcode(ExtOpc), "Unsupported extension");
    let mut EltBits: i32 = VT.getScalarSizeInBits();
    let mut NumElements: i32 = VT.getVectorNumElements();
    let mut NumEltsPerLane: i32 = 128 / EltBits;
    let mut OffsetLane: i32 = Offset / NumEltsPerLane;
    assert!((EltBits == 8 || EltBits == 16 || EltBits == 32), "Only 8, 16, and 32 bit elements can be extended.");
    assert!(Scale * EltBits <= 64, "Cannot zero extend past 64 bits.");
    assert!(0 <= Offset, "Extension offset must be positive.");
    assert!((Offset < NumEltsPerLane || Offset % NumEltsPerLane == 0), "Extension offset must be in the first lane or start an upper lane.");
    let mut SafeOffset: Closure_47 = Closure_47 { OffsetLane: &mut OffsetLane, NumEltsPerLane: &mut NumEltsPerLane };
    let mut ShuffleOffset: Closure_48 = Closure_48 { Offset: &mut Offset, NumElements: &mut NumElements, Scale: &mut Scale, SafeOffset: &mut SafeOffset, DAG: &mut DAG, VT: &mut VT, DL: &mut DL };
    if Subtarget.hasSSE41() {
        if Offset && Scale == 2 && VT.is128BitVector() {
            return SDValue {};
        }
        let mut ExtVT: MVT = getVectorVT(getIntegerVT(EltBits * Scale), NumElements / Scale);
        InputV = DAG.getBitcast(EVT { VT }, InputV);
        InputV = ShuffleOffset(InputV);
        InputV = getEXTEND_VECTOR_INREG(ExtOpc, DL, EVT { ExtVT }, InputV, DAG);
        return DAG.getBitcast(EVT { VT }, InputV);
    }
    assert!(VT.is128BitVector(), "Only 128-bit vectors can be extended.");
    InputV = DAG.getBitcast(EVT { VT }, InputV);
    let mut AnyExt: bool = ExtOpc == ANY_EXTEND;
    if ExtOpc == SIGN_EXTEND {
        return SDValue {};
    }
    if AnyExt && EltBits == 32 {
        let mut PSHUFDMask: [4]i32 = [Offset, -1, if SafeOffset.call(Offset + 1) { Offset + 1 } else { -1 }, -1];
        return DAG.getBitcast(VT, DAG);
    }
    if AnyExt && EltBits == 16 && Scale > 2 {
        let mut PSHUFDMask: [4]i32 = [Offset / 2, -1, if SafeOffset.call(Offset + 1) { (Offset + 1) / 2 } else { -1 }, -1];
        InputV = DAG;
        let mut PSHUFWMask: [4]i32 = [1, -1, -1, -1];
        let mut OddEvenOp: u32 = 0;
        return DAG.getBitcast(EVT { VT }, DAG.getNode(OddEvenOp, DL, EVT { v8i16 }, DAG.getBitcast(EVT { v8i16 }, InputV), getV4X86ShuffleImm8ForMask(PSHUFWMask, DL, DAG)));
    }
    if (Scale * EltBits) == 64 && EltBits < 32 && Subtarget()() {
        assert!(NumElements == Mask.len as i32, "Unexpected shuffle mask size!");
        assert!(VT.is128BitVector(), "Unexpected vector width!");
        let mut LoIdx: i32 = Offset * EltBits;
        let mut Lo: SDValue = DAG.getBitcast(v2i64, DAG);
        if isUndefUpperHalf(Mask) || !SafeOffset.call(Offset + 1) {
            return DAG.getBitcast(EVT { VT }, Lo);
        }
        let mut HiIdx: i32 = (Offset + 1) * EltBits;
        let mut Hi: SDValue = DAG.getBitcast(v2i64, DAG);
        return DAG.getBitcast(VT, DAG);
    }
    if Scale > 4 && EltBits == 8 && Subtarget.hasSSSE3() {
        assert!(NumElements == 16, "Unexpected byte vector width!");
        let mut PSHUFBMask: [16]SDValue = [16]SDValue {};
        for let mut i: i32 = 0; i < 16; i += 1 {
            let mut Idx: i32 = Offset + (i / Scale);
            if (i % Scale == 0 && SafeOffset.call(Idx)) {
                PSHUFBMask[i] = DAG.getConstant(Idx, DL, EVT { i8 }, false, false);
                continue;
            }
            PSHUFBMask[i] = if AnyExt { DAG.getUNDEF(EVT { i8 }) } else { DAG.getConstant(128, DL, EVT { i8 }, false, false) };
        }
        InputV = DAG.getBitcast(EVT { v16i8 }, InputV);
        return DAG.getBitcast(VT, DAG);
    }
    let mut AlignToUnpack: i32 = Offset % (NumElements / Scale);
    if AlignToUnpack {
        let mut ShMask: SmallVector<int, 8> = zeroed();
        for let mut i: i32 = AlignToUnpack; i < NumElements; i += 1 {
            ShMask()[i - AlignToUnpack] = i;
        }
        InputV = DAG.getVectorShuffle(VT, DL, InputV, DAG.getUNDEF(EVT { VT }));
        Offset -= AlignToUnpack;
    }
    while true {
        {
        let mut UnpackLoHi: u32 = 0;
        if Offset >= (NumElements / 2) {
            Offset -= (NumElements / 2);
        }
        let mut InputVT: MVT = getVectorVT(getIntegerVT(EltBits), NumElements);
        let mut Ext: SDValue = if AnyExt { DAG.getUNDEF(EVT { InputVT }) } else { getZeroVector(InputVT, Subtarget, DAG, DL) };
        InputV = DAG.getBitcast(EVT { InputVT }, InputV);
        InputV = DAG.getNode(UnpackLoHi, DL, EVT { InputVT }, InputV, Ext);
        Scale /= 2;
        EltBits *= 2;
        NumElements /= 2;
    }
        if !(Scale > 1) { break; }
    }
    return DAG.getBitcast(EVT { VT }, InputV);
}

fn lowerShuffleAsZeroOrAnyExtend(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut Bits: i32 = VT.getSizeInBits().operator unsigned long long();
    let mut NumLanes: i32 = Bits / 128;
    let mut NumElements: i32 = VT.getVectorNumElements();
    let mut NumEltsPerLane: i32 = NumElements / NumLanes;
    assert!(VT.getScalarSizeInBits() <= 32, "Exceeds 32-bit integer zero extension limit");
    assert!(Mask.len as i32 == NumElements, "Unexpected shuffle mask size");
    let mut Lower: Closure_49 = Closure_49 { NumElements: &mut NumElements, Mask: &mut Mask, Zeroable: &mut Zeroable, V1: &mut V1, V2: &mut V2, NumEltsPerLane: &mut NumEltsPerLane, DL: &mut DL, VT: &mut VT, Subtarget: &mut Subtarget, DAG: &mut DAG };
    if VT == v4i32 && (V1.getOpcode() == SCALAR_TO_VECTOR || isa(V1)) && Mask[0] == 0 && (NumElements - 1) == Zeroable.countLeadingOnes() as i32 {
        return DAG;
    }
    assert!(Bits % 64 == 0, "The number of bits in a vector must be divisible by 64 on x86!");
    let mut NumExtElements: i32 = Bits / 64;
    for ; NumExtElements < NumElements; NumExtElements *= 2 {
        assert!(NumElements % NumExtElements == 0, "The input vector size must be divisible by the extended size.");
        if Lower.call(NumElements / NumExtElements) {
            V;
        } else {
            return V;
        }
    }
    if Bits != 128 {
        return SDValue {};
    }
    let mut CanZExtLowHalf: Closure_50 = Closure_50 { NumElements: &mut NumElements, Zeroable: &mut Zeroable, Mask: &mut Mask, V1: &mut V1, V2: &mut V2 };
    if CanZExtLowHalf.call() {
        V;
    } else {
        V = DAG.getBitcast(EVT { v2i64 }, V);
        V = DAG;
        return DAG.getBitcast(EVT { VT }, V);
    }
    return SDValue {};
}

fn getScalarValueForVectorElement(V: SDValue, Idx: i32, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = V.getSimpleValueType();
    let mut EltVT: MVT = VT.getVectorElementType();
    V = peekThroughBitcasts(V);
    let mut NewVT: MVT = V.getSimpleValueType();
    if !NewVT.isVector() || NewVT.getScalarSizeInBits() != VT.getScalarSizeInBits() {
        return SDValue {};
    }
    if V.getOpcode() == BUILD_VECTOR || (Idx == 0 && V.getOpcode() == SCALAR_TO_VECTOR) {
        let mut S: SDValue = V.getOperand(Idx);
        if EltVT.getSizeInBits() == S.getSimpleValueType().getSizeInBits() {
            return DAG.getBitcast(EVT { EltVT }, S);
        }
    }
    return SDValue {};
}

fn isShuffleFoldableLoad(V: SDValue) -> bool {
    return V.hasOneUse() && isNON_EXTLoad(peekThroughOneUseBitcasts(V).getNode());
}

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: isSoftF16]
// template <typename T>
// fn isSoftF16(VT: T, Subtarget: *X86Subtarget) -> bool {
//     let mut EltVT: T = VT();
//     return (EltVT == bf16 && operator!(Subtarget()())) || (EltVT == f16 && operator!(Subtarget()()));
// }
// ========================================================

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: isBF16orSoftF16]
// template <typename T>
// fn isBF16orSoftF16(VT: T, Subtarget: *X86Subtarget) -> bool {
//     let mut EltVT: T = VT();
//     return EltVT == bf16 || (EltVT == f16 && operator!(Subtarget()()));
// }
// ========================================================

fn lowerShuffleAsElementInsertion(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut ExtVT: MVT = VT;
    let mut EltVT: MVT = VT.getVectorElementType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    if isSoftF16(EltVT, Subtarget) {
        return SDValue {};
    }
    let mut V2Index: i32 = find_if(Mask, Closure_51 { Mask: &mut Mask }) - Mask.begin();
    let mut IsV1Constant: bool = getTargetConstantFromNode(V1) != null;
    let mut IsV1Zeroable: bool = true;
    for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
        if i != V2Index && !Zeroable[i] {
            IsV1Zeroable = false;
            break;
        }
    }
    if !IsV1Zeroable {
        let mut V1Mask: SmallVector<int, 8> = zeroed();
        V1Mask()[V2Index] = -1;
        if operator!(isNoopShuffleMask()) {
            return SDValue {};
        }
    }
    let mut V2S: SDValue = getScalarValueForVectorElement(V2, Mask[V2Index] - Mask.len, DAG);
    if V2S && DAG.getTargetLoweringInfo().isTypeLegal {
        V2S = DAG.getBitcast(EVT { EltVT }, V2S);
        if EltVT == i8 || (EltVT == i16 && operator!(Subtarget()())) {
            if !IsV1Zeroable && !(IsV1Constant && V2Index == 0) {
                return SDValue {};
            }
            ExtVT = getVectorVT(MVT { SimpleTy: i32 }, ExtVT.getSizeInBits().operator unsigned long long() / 32);
            V2S = DAG.getNode(ZERO_EXTEND, DL, EVT { i32 }, V2S);
            if !IsV1Zeroable {
                let mut Bits: i32 = NumElts;
                Bits()[V2Index] = getZero(EltBits);
                let mut BitMask: SDValue = getConstVector(VT, DAG, DL);
                V1 = DAG.getNode(AND, DL, EVT { VT }, V1, BitMask);
                V2 = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { ExtVT }, V2S);
                V2 = DAG.getBitcast(VT, DAG);
                return DAG.getNode(OR, DL, EVT { VT }, V1, V2);
            }
        }
        V2 = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { ExtVT }, V2S);
    } else if Mask[V2Index] != Mask.len as i32 || EltVT == i8 || (EltVT == i16 && operator!(Subtarget()())) {
        return SDValue {};
    }
    if !IsV1Zeroable {
        assert!(VT == ExtVT, "Cannot change extended type when non-zeroable!");
        if !VT.isFloatingPoint() || V2Index != 0 {
            return SDValue {};
        }
        if !VT.is128BitVector() {
            return SDValue {};
        }
        let mut MovOpc: u32 = 0;
        if EltVT == f16 {
            
        } else if EltVT == f32 {
            
        } else if EltVT == f64 {
            
        } else {
            llvm_unreachable_internal("Unsupported floating point element type to handle!", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 13221);
        }
        return DAG.getNode(MovOpc, DL, EVT { ExtVT }, V1, V2);
    }
    if VT.isFloatingPoint() && V2Index != 0 {
        return SDValue {};
    }
    V2 = DAG;
    if ExtVT != VT {
        V2 = DAG.getBitcast(EVT { VT }, V2);
    }
    if V2Index != 0 {
        if VT.isFloatingPoint() || NumElts <= 4 {
            let mut V2Shuffle: SmallVector<int, 4> = SmallVector<int, 4> { Mask.len, 1 };
            V2Shuffle[V2Index] = 0;
            V2 = DAG.getVectorShuffle;
        } else {
            V2 = DAG.getBitcast(EVT { v16i8 }, V2);
            V2 = DAG;
            V2 = DAG.getBitcast(EVT { VT }, V2);
        }
    }
    return V2;
}

fn lowerShuffleAsTruncBroadcast(DL: *SDLoc, VT: MVT, V0: SDValue, BroadcastIdx: i32, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Subtarget.hasAVX2(), "We can only lower integer broadcasts with AVX2!");
    let mut EltVT: MVT = VT.getVectorElementType();
    let mut V0VT: MVT = V0.getSimpleValueType();
    assert!(VT.isInteger(), "Unexpected non-integer trunc broadcast!");
    assert!(V0VT.isVector(), "Unexpected non-vector vector-sized value!");
    let mut V0EltVT: MVT = V0VT.getVectorElementType();
    if !V0EltVT.isInteger() {
        return SDValue {};
    }
    let mut EltSize: u32 = EltVT.getSizeInBits().operator unsigned long long();
    let mut V0EltSize: u32 = V0EltVT.getSizeInBits().operator unsigned long long();
    if V0EltSize <= EltSize {
        return SDValue {};
    }
    assert!(((V0EltSize % EltSize) == 0), "Scalar type sizes must all be powers of 2 on x86!");
    let mut V0Opc: u32 = V0.getOpcode();
    let mut Scale: u32 = V0EltSize / EltSize;
    let mut V0BroadcastIdx: u32 = BroadcastIdx / Scale;
    if (V0Opc != SCALAR_TO_VECTOR || V0BroadcastIdx != 0) && V0Opc != BUILD_VECTOR {
        return SDValue {};
    }
    let mut Scalar: SDValue = V0.getOperand(V0BroadcastIdx);
    if BroadcastIdx % Scale {
        OffsetIdx;
    } else {
        Scalar = DAG.getNode(SRL, DL, Scalar.getValueType(), Scalar, DAG.getConstant(OffsetIdx * EltSize, DL, EVT { i8 }, false, false));
    }
    return DAG;
}

fn isSingleSHUFPSMask(Mask: ArrayRef<int>) -> bool {
    assert!(Mask.len == 4, "Unsupported mask size!");
    assert!(Mask[0] >= -1 && Mask[0] < 8, "Out of bound mask element!");
    assert!(Mask[1] >= -1 && Mask[1] < 8, "Out of bound mask element!");
    assert!(Mask[2] >= -1 && Mask[2] < 8, "Out of bound mask element!");
    assert!(Mask[3] >= -1 && Mask[3] < 8, "Out of bound mask element!");
    if Mask[0] >= 0 && Mask[1] >= 0 && (Mask[0] < 4) != (Mask[1] < 4) {
        return false;
    }
    if Mask[2] >= 0 && Mask[3] >= 0 && (Mask[2] < 4) != (Mask[3] < 4) {
        return false;
    }
    return true;
}

fn isShuffleMaskInputInPlace(Input: i32, Mask: ArrayRef<int>) -> bool {
    assert!((Input == 0 || Input == 1), "Only two inputs to shuffles.");
    let mut Size: i32 = Mask.len;
    for let mut i: i32 = 0; i < Size; i += 1 {
        if Mask[i] >= 0 && Mask[i] / Size == Input && Mask[i] % Size != i {
            return false;
        }
    }
    return true;
}

fn isShuffleMaskInputBroadcastable(Input: i32, Mask: ArrayRef<int>, BroadcastableElement: i32) -> bool {
    assert!((Input == 0 || Input == 1), "Only two inputs to shuffles.");
    let mut Size: i32 = Mask.len;
    for let mut i: i32 = 0; i < Size; i += 1 {
        if Mask[i] >= 0 && Mask[i] / Size == Input && Mask[i] % Size != BroadcastableElement {
            return false;
        }
    }
    return true;
}

fn lowerShuffleOfExtractsAsVperm(DL: *SDLoc, N0: SDValue, N1: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = N0.getSimpleValueType();
    assert!((VT.is128BitVector() && (VT.getScalarSizeInBits() == 32 || VT.getScalarSizeInBits() == 64)), "VPERM* family of shuffles requires 32-bit or 64-bit elements");
    if N0.getOpcode() != EXTRACT_SUBVECTOR || N1.getOpcode() != EXTRACT_SUBVECTOR || N0.getOperand(0) != N1.getOperand(0) || !N0.hasOneUse() || !N1.hasOneUse() {
        return SDValue {};
    }
    let mut WideVec: SDValue = N0.getOperand(0);
    let mut WideVT: MVT = WideVec.getSimpleValueType();
    if !WideVT.is256BitVector() {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut NewMask: SmallVector<int, 4> = Mask();
    let mut ExtIndex0: *APInt = N0.getConstantOperandAPInt(1);
    let mut ExtIndex1: *APInt = N1.getConstantOperandAPInt(1);
    if ExtIndex1 == 0 && ExtIndex0 == NumElts {
        commuteMask(NewMask);
    } else if ExtIndex0 != 0 || ExtIndex1 != NumElts {
        return SDValue {};
    }
    if NumElts == 4 && (isSingleSHUFPSMask(NewMask) || is128BitUnpackShuffleMask(NewMask, DAG)) {
        return SDValue {};
    }
    NewMask.append(NumElts, -1);
    let mut Shuf: SDValue = DAG.getVectorShuffle;
    return DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { VT }, Shuf, DAG.getVectorIdxConstant(0, DL, false));
}

fn lowerShuffleAsBroadcast(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut EltVT: MVT = VT.getVectorElementType();
    if !((Subtarget.hasSSE3() && VT == v2f64) || (Subtarget.hasAVX() && (EltVT == f64 || EltVT == f32)) || (Subtarget.hasAVX2() && (VT.isInteger() || EltVT == f16))) {
        return SDValue {};
    }
    let mut NumEltBits: u32 = VT.getScalarSizeInBits();
    let mut Opcode: u32 = 0;
    let mut BroadcastFromReg: bool = false;
    let mut BroadcastIdx: i32 = getSplatIndex(Mask);
    if BroadcastIdx < 0 {
        let mut BroadcastMask: SmallVector<int, 16> = SmallVector<int, 16> { VT.getVectorNumElements(), 0 };
        if !isShuffleEquivalent(Mask, BroadcastMask, V1, V2) {
            return SDValue {};
        }
        BroadcastIdx = 0;
    }
    assert!(BroadcastIdx < Mask.len as i32, "We only expect to be called with a sorted mask where the broadcast comes from V1.");
    let mut NumActiveElts: i32 = count_if(Mask, Closure_52 {});
    let mut BitOffset: i32 = BroadcastIdx * NumEltBits;
    let mut V: SDValue = V1;
    for {
        match V.getOpcode() {
            BITCAST => {
                V = V.getOperand(0);
                continue;
            },
            CONCAT_VECTORS => {
                let mut OpBitWidth: i32 = V.getOperand(0).getValueSizeInBits().operator unsigned long long();
                let mut OpIdx: i32 = BitOffset / OpBitWidth;
                V = V.getOperand(OpIdx);
                BitOffset %= OpBitWidth;
                continue;
            },
            EXTRACT_SUBVECTOR => {
                let mut EltBitWidth: u32 = V.getScalarValueSizeInBits();
                let mut Idx: u32 = V.getConstantOperandVal(1);
                let mut BeginOffset: u32 = Idx * EltBitWidth;
                BitOffset += BeginOffset;
                V = V.getOperand(0);
                continue;
            },
            INSERT_SUBVECTOR => {
                let mut VOuter: SDValue = V.getOperand(0);
                let mut VInner: SDValue = V.getOperand(1);
                let mut EltBitWidth: i32 = VOuter.getScalarValueSizeInBits();
                let mut Idx: i32 = V.getConstantOperandVal(2) as i32;
                let mut NumSubElts: i32 = VInner.getSimpleValueType().getVectorNumElements() as i32;
                let mut BeginOffset: i32 = Idx * EltBitWidth;
                let mut EndOffset: i32 = BeginOffset + NumSubElts * EltBitWidth;
                if BeginOffset <= BitOffset && BitOffset < EndOffset {
                    BitOffset -= BeginOffset;
                    V = VInner;
                } else {
                    V = VOuter;
                }
                continue;
            },
        }
        break;
    }
    assert!((BitOffset % NumEltBits) == 0, "Illegal bit-offset");
    BroadcastIdx = BitOffset / NumEltBits;
    let mut BitCastSrc: bool = V.getScalarValueSizeInBits() != NumEltBits;
    if BitCastSrc && VT.isInteger() {
        if lowerShuffleAsTruncBroadcast(DL, VT, V, BroadcastIdx, Subtarget, DAG) {
            TruncBroadcast;
        } else {
            return TruncBroadcast;
        }
    }
    if !BitCastSrc && ((V.getOpcode() == BUILD_VECTOR && V.hasOneUse()) || (V.getOpcode() == SCALAR_TO_VECTOR && BroadcastIdx == 0)) {
        V = V.getOperand(BroadcastIdx);
        if !BroadcastFromReg && !isShuffleFoldableLoad(V) {
            return SDValue {};
        }
    } else if isNormalLoad(V.getNode()) && cast(V)() {
        let mut Ld: *mut auto = cast(V);
        let mut BaseAddr: SDValue = ();
        let mut SVT: MVT = VT.getScalarType();
        let mut Offset: u32 = BroadcastIdx * SVT.getStoreSize().operator unsigned long long();
        assert!((Offset * 8) as i32 == BitOffset, "Unexpected bit-offset");
        let mut NewAddr: SDValue = DAG.getMemBasePlusOffset(BaseAddr, getFixed(Offset), DL, SDNodeFlags { Flags: None });
        if  {
            let mut Tys: SDVTList = DAG.getVTList(EVT { VT }, EVT { Other });
            let mut Ops: []SDValue = void { (), NewAddr };
            V = DAG;
            DAG(V);
            return DAG.getBitcast(EVT { VT }, V);
        }
        assert!(SVT == f64, "Unexpected VT!");
        V = DAG(SVT, DL, NewAddr, DAG.getMachineFunction()(Offset, SVT.getStoreSize()));
        DAG(V);
    } else if !BroadcastFromReg {
        return SDValue {};
    } else if BitOffset != 0 {
        if !VT.is256BitVector() && !VT.is512BitVector() {
            return SDValue {};
        }
        if VT == v4f64 || VT == v4i64 {
            return SDValue {};
        }
        if BitOffset < 128 && NumActiveElts > 1 && V.getScalarValueSizeInBits() == NumEltBits {
            assert!((BitOffset % V.getScalarValueSizeInBits()) == 0, "Unexpected bit-offset");
            let mut ExtractMask: SmallVector<int, 16> = SmallVector<int, 16> { 128 / NumEltBits, SM_SentinelUndef };
            ExtractMask[0] = BitOffset / V.getScalarValueSizeInBits();
            V = extractSubVector(V, 0, DAG, DL, 128);
            V = DAG.getVectorShuffle;
        } else {
            if (BitOffset % 128) != 0 {
                return SDValue {};
            }
            assert!((BitOffset % V.getScalarValueSizeInBits()) == 0, "Unexpected bit-offset");
            assert!((V.getValueSizeInBits().operator unsigned long long() == 256 || V.getValueSizeInBits().operator unsigned long long() == 512), "Unexpected vector size");
            let mut ExtractIdx: u32 = BitOffset / V.getScalarValueSizeInBits();
            V = extract128BitVector(V, ExtractIdx, DAG, DL);
        }
    }
    if  {
        V = DAG.getBitcast(EVT { f64 }, V);
        if Subtarget.hasAVX() {
            V = DAG;
            return DAG.getBitcast(EVT { VT }, V);
        }
        V = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v2f64 }, V);
    }
    if !V.getValueType().isVector() {
        assert!(V.getScalarValueSizeInBits() == NumEltBits, "Unexpected scalar size");
        let mut BroadcastVT: MVT = getVectorVT(V.getSimpleValueType(), VT.getVectorNumElements());
        return DAG.getBitcast(EVT { VT }, DAG.getNode(Opcode, DL, EVT { BroadcastVT }, V));
    }
    if V.getValueSizeInBits().operator unsigned long long() > 128 {
        V = extract128BitVector(peekThroughBitcasts(V), 0, DAG, DL);
    }
    let mut NumSrcElts: u32 = V.getValueSizeInBits().operator unsigned long long() / NumEltBits;
    let mut CastVT: MVT = getVectorVT(VT.getVectorElementType(), NumSrcElts);
    return DAG.getNode(Opcode, DL, EVT { VT }, DAG.getBitcast(EVT { CastVT }, V));
}

fn matchShuffleAsInsertPS(V1: *mut SDValue, V2: *mut SDValue, InsertPSMask: *mut u32, Zeroable: *APInt, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> bool {
    assert!(V1.getSimpleValueType().is128BitVector(), "Bad operand type!");
    assert!(V2.getSimpleValueType().is128BitVector(), "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    let mut matchAsInsertPS: Closure_53 = Closure_53 { Zeroable: &mut Zeroable, DAG: &mut DAG, V1: &mut V1, V2: &mut V2, InsertPSMask: &mut InsertPSMask };
    if matchAsInsertPS.call(V1, V2, Mask) {
        return true;
    }
    let mut CommutedMask: SmallVector<int, 4> = Mask();
    commuteMask(CommutedMask);
    if matchAsInsertPS(V2, V1, CommutedMask) {
        return true;
    }
    return false;
}

fn lowerShuffleAsInsertPS(DL: *SDLoc, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4f32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4f32, "Bad operand type!");
    let mut InsertPSMask: u32 = 0;
    if !matchShuffleAsInsertPS(V1, V2, InsertPSMask, Zeroable, Mask, DAG) {
        return SDValue {};
    }
    return DAG;
}

fn lowerV2F64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v2f64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v2f64, "Bad operand type!");
    assert!(Mask.len == 2, "Unexpected mask size for v2 shuffle!");
    if V2.isUndef() {
        if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v2f64 }, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        let mut SHUFPDMask: u32 = (Mask[0] == 1) | ((Mask[1] == 1) << 1);
        if Subtarget.hasAVX() {
            return DAG;
        }
        return DAG;
    }
    assert!(Mask[0] >= 0, "No undef lanes in multi-input v2 shuffles!");
    assert!(Mask[1] >= 0, "No undef lanes in multi-input v2 shuffles!");
    assert!(Mask[0] < 2, "We sort V1 to be the first input.");
    assert!(Mask[1] >= 2, "We sort V2 to be the second input.");
    if Subtarget.hasAVX2() {
        if lowerShuffleOfExtractsAsVperm(DL, V1, V2, Mask, DAG) {
            Extract;
        } else {
            return Extract;
        }
    }
    if lowerShuffleAsElementInsertion(DL, MVT { SimpleTy: v2f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Insertion;
    } else {
        return Insertion;
    }
    let mut InverseMask: [2]i32 = [if Mask[0] < 0 { -1 } else { (Mask[0] ^ 2) }, if Mask[1] < 0 { -1 } else { (Mask[1] ^ 2) }];
    if lowerShuffleAsElementInsertion(DL, v2f64, V2, V1, InverseMask, Zeroable, Subtarget, DAG) {
        Insertion;
    } else {
        return Insertion;
    }
    if isShuffleEquivalent(Mask, ArrayRef<int> { [0, 3] }, V1, V2) || isShuffleEquivalent(Mask, ArrayRef<int> { [1, 3] }, V1, V2) {
        if getScalarValueForVectorElement(V1, Mask[0], DAG) {
            V1S;
        } else {
            return DAG;
        }
    }
    if Subtarget.hasSSE41() {
        if lowerShuffleAsBlend(DL, MVT { SimpleTy: v2f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v2f64 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    let mut SHUFPDMask: u32 = (Mask[0] == 1) | (((Mask[1] - 2) == 1) << 1);
    return DAG;
}

fn lowerV2I64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v2i64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v2i64, "Bad operand type!");
    assert!(Mask.len == 2, "Unexpected mask size for v2 shuffle!");
    if V2.isUndef() {
        if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v2i64 }, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        V1 = DAG.getBitcast(EVT { v4i32 }, V1);
        let mut WidenedMask: [4]i32 = [if Mask[0] < 0 { -1 } else { (Mask[0] * 2) }, if Mask[0] < 0 { -1 } else { ((Mask[0] * 2) + 1) }, if Mask[1] < 0 { -1 } else { (Mask[1] * 2) }, if Mask[1] < 0 { -1 } else { ((Mask[1] * 2) + 1) }];
        return DAG.getBitcast(v2i64, DAG);
    }
    assert!(Mask[0] != -1, "No undef lanes in multi-input v2 shuffles!");
    assert!(Mask[1] != -1, "No undef lanes in multi-input v2 shuffles!");
    assert!(Mask[0] < 2, "We sort V1 to be the first input.");
    assert!(Mask[1] >= 2, "We sort V2 to be the second input.");
    if Subtarget.hasAVX2() {
        if lowerShuffleOfExtractsAsVperm(DL, V1, V2, Mask, DAG) {
            Extract;
        } else {
            return Extract;
        }
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v2i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsElementInsertion(DL, MVT { SimpleTy: v2i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Insertion;
    } else {
        return Insertion;
    }
    let mut InverseMask: [2]i32 = [Mask[0] ^ 2, Mask[1] ^ 2];
    if lowerShuffleAsElementInsertion(DL, v2i64, V2, V1, InverseMask, Zeroable, Subtarget, DAG) {
        Insertion;
    } else {
        return Insertion;
    }
    let mut IsBlendSupported: bool = Subtarget.hasSSE41();
    if IsBlendSupported {
        if lowerShuffleAsBlend(DL, MVT { SimpleTy: v2i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v2i64 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if Subtarget.hasSSSE3() {
        if Subtarget()() {
            if lowerShuffleAsVALIGN(DL, MVT { SimpleTy: v2i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
        if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v2i64 }, V1, V2, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if IsBlendSupported {
        return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v2i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    V1 = DAG.getBitcast(EVT { v2f64 }, V1);
    V2 = DAG.getBitcast(EVT { v2f64 }, V2);
    return DAG.getBitcast(EVT { v2i64 }, DAG.getVectorShuffle(EVT { v2f64 }, DL, V1, V2, Mask));
}

fn lowerShuffleWithSHUFPS(DL: *SDLoc, VT: MVT, Mask: ArrayRef<int>, V1: SDValue, V2: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut LowV: SDValue = V1;
    let mut HighV: SDValue = V2;
    let mut NewMask: SmallVector<int, 4> = Mask();
    let mut NumV2Elements: i32 = count_if(Mask, Closure_54 {});
    if NumV2Elements == 1 {
        let mut V2Index: i32 = find_if(Mask, Closure_55 {}) - Mask.begin();
        let mut V2AdjIndex: i32 = V2Index ^ 1;
        if Mask[V2AdjIndex] < 0 {
            if V2Index < 2 {
                swap(LowV, HighV);
            }
            NewMask[V2Index] -= 4;
        } else {
            let mut V1Index: i32 = V2AdjIndex;
            let mut BlendMask: [4]i32 = [Mask[V2Index] - 4, 0, Mask[V1Index], 0];
            V2 = DAG;
            if V2Index < 2 {
                LowV = V2;
                HighV = V1;
            } else {
                HighV = V2;
            }
            NewMask[V1Index] = 2;
            NewMask[V2Index] = 0;
        }
    } else if NumV2Elements == 2 {
        if Mask[0] < 4 && Mask[1] < 4 {
            NewMask[2] -= 4;
            NewMask[3] -= 4;
        } else if Mask[2] < 4 && Mask[3] < 4 {
            NewMask[0] -= 4;
            NewMask[1] -= 4;
            HighV = V1;
            LowV = V2;
        } else {
            let mut BlendMask: [4]i32 = [if Mask[0] < 4 { Mask[0] } else { Mask[1] }, if Mask[2] < 4 { Mask[2] } else { Mask[3] }, (if Mask[0] >= 4 { Mask[0] } else { Mask[1] }) - 4, (if Mask[2] >= 4 { Mask[2] } else { Mask[3] }) - 4];
            V1 = DAG;
            LowV = HighV = V1;
            NewMask[0] = if Mask[0] < 4 { 0 } else { 2 };
            NewMask[1] = if Mask[0] < 4 { 2 } else { 0 };
            NewMask[2] = if Mask[2] < 4 { 1 } else { 3 };
            NewMask[3] = if Mask[2] < 4 { 3 } else { 1 };
        }
    } else if NumV2Elements == 3 {
        commuteMask(NewMask);
        return lowerShuffleWithSHUFPS(DL, VT, NewMask, V2, V1, DAG);
    }
    return DAG;
}

fn lowerV4F32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4f32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4f32, "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    if Subtarget.hasSSE41() {
        if lowerShuffleAsBlend(DL, MVT { SimpleTy: v4f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    let mut NumV2Elements: i32 = count_if(Mask, Closure_56 {});
    if NumV2Elements == 0 {
        if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v4f32 }, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        if Subtarget.hasSSE3() {
            if isShuffleEquivalent(Mask, ArrayRef<int> { [0, 0, 2, 2] }, V1, V2) {
                return DAG;
            }
            if isShuffleEquivalent(Mask, ArrayRef<int> { [1, 1, 3, 3] }, V1, V2) {
                return DAG;
            }
        }
        if Subtarget.hasAVX() {
            return DAG;
        }
        if !Subtarget.hasSSE2() {
            if isShuffleEquivalent(Mask, ArrayRef<int> { [0, 1, 0, 1] }, V1, V2) {
                return DAG;
            }
            if isShuffleEquivalent(Mask, ArrayRef<int> { [2, 3, 2, 3] }, V1, V2) {
                return DAG;
            }
        }
        return DAG;
    }
    if Subtarget.hasSSE2() {
        if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            ZExt;
        } else {
            ZExt = DAG.getBitcast(EVT { v4f32 }, ZExt);
            return ZExt;
        }
    }
    if Subtarget.hasAVX2() {
        if lowerShuffleOfExtractsAsVperm(DL, V1, V2, Mask, DAG) {
            Extract;
        } else {
            return Extract;
        }
    }
    if NumV2Elements == 1 && Mask[0] >= 4 {
        if lowerShuffleAsElementInsertion(DL, MVT { SimpleTy: v4f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if Subtarget.hasSSE41() {
        let mut MatchesShufPS: bool = isSingleSHUFPSMask(Mask);
        if !MatchesShufPS || Zeroable == 3 || Zeroable == 12 {
            if lowerShuffleAsInsertPS(DL, V1, V2, Mask, Zeroable, DAG) {
                V;
            } else {
                return V;
            }
        }
        if !MatchesShufPS {
            if lowerShuffleAsBlendAndPermute(DL, MVT { SimpleTy: v4f32 }, V1, V2, Mask, DAG, false) {
                BlendPerm;
            } else {
                return BlendPerm;
            }
        }
    }
    if !Subtarget.hasSSE2() {
        if isShuffleEquivalent(Mask, ArrayRef<int> { [0, 1, 4, 5] }, V1, V2) {
            return DAG;
        }
        if isShuffleEquivalent(Mask, ArrayRef<int> { [2, 3, 6, 7] }, V1, V2) {
            return DAG;
        }
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v4f32 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    return lowerShuffleWithSHUFPS(DL, MVT { SimpleTy: v4f32 }, Mask, V1, V2, DAG);
}

fn lowerV4I32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4i32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4i32, "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    let mut NumV2Elements: i32 = count_if(Mask, Closure_57 {});
    if Subtarget()() {
        if lowerShuffleAsShift(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
        if NumV2Elements == 0 {
            if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v4i32 }, V1, Mask, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
    }
    if NumV2Elements == 0 {
        if count_if(Mask, Closure_58 {}) > 1 {
            if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Subtarget, DAG) {
                Broadcast;
            } else {
                return Broadcast;
            }
        }
        let mut UnpackLoMask: [4]i32 = [0, 0, 1, 1];
        let mut UnpackHiMask: [4]i32 = [2, 2, 3, 3];
        if !isSingleElementRepeatedMask(Mask) {
            if isShuffleEquivalent(Mask, ArrayRef<int> { [0, 0, 1, 1] }, V1, V2) {
                Mask(UnpackLoMask);
            } else if isShuffleEquivalent(Mask, ArrayRef<int> { [2, 2, 3, 3] }, V1, V2) {
                Mask(UnpackHiMask);
            }
        }
        return DAG;
    }
    if Subtarget.hasAVX2() {
        if lowerShuffleOfExtractsAsVperm(DL, V1, V2, Mask, DAG) {
            Extract;
        } else {
            return Extract;
        }
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if NumV2Elements == 1 {
        if lowerShuffleAsElementInsertion(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    let mut IsBlendSupported: bool = Subtarget.hasSSE41();
    if IsBlendSupported {
        if lowerShuffleAsBlend(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    if lowerShuffleAsBitMask(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Zeroable, DAG) {
        Masked;
    } else {
        return Masked;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if Subtarget.hasSSSE3() {
        if Subtarget()() {
            if lowerShuffleAsVALIGN(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
        if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if !isSingleSHUFPSMask(Mask) {
        if IsBlendSupported {
            return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
        }
        if lowerShuffleAsPermuteAndUnpack(DL, MVT { SimpleTy: v4i32 }, V1, V2, Mask, Subtarget, DAG) {
            Unpack;
        } else {
            return Unpack;
        }
    }
    let mut CastV1: SDValue = DAG.getBitcast(EVT { v4f32 }, V1);
    let mut CastV2: SDValue = DAG.getBitcast(EVT { v4f32 }, V2);
    let mut ShufPS: SDValue = DAG.getVectorShuffle(EVT { v4f32 }, DL, CastV1, CastV2, Mask);
    return DAG.getBitcast(EVT { v4i32 }, ShufPS);
}

fn lowerV8I16GeneralSingleInputShuffle(DL: *SDLoc, VT: MVT, V: SDValue, Mask: MutableArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT.getVectorElementType() == i16, "Bad input type!");
    let mut PSHUFDVT: MVT = getVectorVT(MVT { SimpleTy: i32 }, VT.getVectorNumElements() / 2);
    assert!(Mask.len == 8, "Shuffle mask length doesn't match!");
    let mut LoMask: MutableArrayRef<int> = Mask.slice(0, 4);
    let mut HiMask: MutableArrayRef<int> = Mask.slice(4, 4);
    if isUndefOrInRange(LoMask, 0, 4) && isSequentialOrUndefInRange(HiMask, 0, 4, 4, 1) {
        return DAG;
    }
    if isUndefOrInRange(HiMask, 4, 8) && isSequentialOrUndefInRange(LoMask, 0, 4, 0, 1) {
        for let mut i: i32 = 0; i != 4; i += 1 {
            HiMask[i] = (if HiMask[i] < 0 { HiMask[i] } else { (HiMask[i] - 4) });
        }
        return DAG;
    }
    let mut LoInputs: SmallVector<int, 4> = SmallVector<int, 4> {};
    copy_if(LoMask, back_inserter(LoInputs), Closure_59 {});
    array_pod_sort(LoInputs.begin(), LoInputs.end());
    LoInputs(unique(LoInputs), LoInputs.end());
    let mut HiInputs: SmallVector<int, 4> = SmallVector<int, 4> {};
    copy_if(HiMask, back_inserter(HiInputs), Closure_60 {});
    array_pod_sort(HiInputs.begin(), HiInputs.end());
    HiInputs(unique(HiInputs), HiInputs.end());
    let mut NumLToL: i32 = lower_bound(LoInputs, 4) - LoInputs.begin();
    let mut NumHToL: i32 = LoInputs.len - NumLToL;
    let mut NumLToH: i32 = lower_bound(HiInputs, 4) - HiInputs.begin();
    let mut NumHToH: i32 = HiInputs.len - NumLToH;
    let mut LToLInputs: MutableArrayRef<int> = MutableArrayRef<int> { LoInputs.ptr, NumLToL };
    let mut LToHInputs: MutableArrayRef<int> = MutableArrayRef<int> { HiInputs.ptr, NumLToH };
    let mut HToLInputs: MutableArrayRef<int> = MutableArrayRef<int> { LoInputs.ptr + NumLToL, NumHToL };
    let mut HToHInputs: MutableArrayRef<int> = MutableArrayRef<int> { HiInputs.ptr + NumLToH, NumHToH };
    let mut ShuffleDWordPairs: Closure_61 = Closure_61 { V: &mut V, DAG: &mut DAG, DL: &mut DL, VT: &mut VT, PSHUFDVT: &mut PSHUFDVT };
    if (NumHToL + NumHToH) == 0 || (NumLToL + NumLToH) == 0 {
        let mut PSHUFDMask: [4]i32 = [-1, -1, -1, -1];
        let mut DWordPairs: pair<int, int>, 4> = zeroed();
        let mut DOffset: i32 = (if (NumHToL + NumHToH) == 0 { 0 } else { 2 });
        for let mut DWord: i32 = 0; DWord != 4; DWord += 1 {
            let mut M0: i32 = Mask[2 * DWord + 0];
            let mut M1: i32 = Mask[2 * DWord + 1];
            M0 = (if M0 >= 0 { M0 % 4 } else { M0 });
            M1 = (if M1 >= 0 { M1 % 4 } else { M1 });
            if M0 < 0 && M1 < 0 {
                continue;
            }
            let mut Match: bool = false;
            for let mut j: i32 = 0;
let mut e: i32 = (); j < e; j += 1 {
                let mut DWordPair: *mut auto = [j];
                if (M0 < 0 || isUndefOrEqual(M0)) && (M1 < 0 || isUndefOrEqual(M1)) {
                    DWordPair() = (if M0 >= 0 { M0 } else {  });
                    DWordPair() = (if M1 >= 0 { M1 } else {  });
                    PSHUFDMask[DWord] = DOffset + j;
                    Match = true;
                    break;
                }
            }
            if !Match {
                PSHUFDMask[DWord] = DOffset + ();
                DWordPairs()(make_pair(M0, M1));
            }
        }
        if DWordPairs()() <= 2 {
            DWordPairs()(2, make_pair(-1, -1));
            let mut PSHUFHalfMask: [4]i32 = void { [0], [0], [1], [1] };
            if isSplatMask(PSHUFDMask) && isSplatMask(PSHUFHalfMask) {
                let mut SplatIdx: i32 = getSplatMaskIndex(PSHUFHalfMask);
                fill(PSHUFHalfMask, PSHUFHalfMask + 4, SplatIdx);
                PSHUFDMask[0] = PSHUFDMask[2] = DOffset + 0;
                PSHUFDMask[1] = PSHUFDMask[3] = DOffset + 1;
            }
            if (NumHToL + NumHToH) == 0 {
                return ShuffleDWordPairs(PSHUFHalfMask, PSHUFDMask);
            }
            if (NumLToL + NumLToH) == 0 {
                return ShuffleDWordPairs(PSHUFHalfMask, PSHUFDMask);
            }
        }
    }
    let mut balanceSides: Closure_62 = Closure_62 { V: &mut V, DL: &mut DL, Mask: &mut Mask, DAG: &mut DAG, VT: &mut VT, PSHUFDVT: &mut PSHUFDVT, Subtarget: &mut Subtarget };
    if (NumLToL == 3 && NumHToL == 1) || (NumLToL == 1 && NumHToL == 3) {
        return balanceSides.call(LToLInputs, HToLInputs, HToHInputs, LToHInputs, 0, 4);
    }
    if (NumHToH == 3 && NumLToH == 1) || (NumHToH == 1 && NumLToH == 3) {
        return balanceSides.call(HToHInputs, LToHInputs, LToLInputs, HToLInputs, 4, 0);
    }
    let mut PSHUFLMask: [4]i32 = [-1, -1, -1, -1];
    let mut PSHUFHMask: [4]i32 = [-1, -1, -1, -1];
    let mut PSHUFDMask: [4]i32 = [-1, -1, -1, -1];
    let mut fixInPlaceInputs: Closure_64 = Closure_64 { PSHUFDMask: &mut PSHUFDMask };
    fixInPlaceInputs(LToLInputs, HToLInputs, PSHUFLMask, LoMask, 0);
    fixInPlaceInputs(HToHInputs, LToHInputs, PSHUFHMask, HiMask, 4);
    let mut moveInputsToRightHalf: Closure_65 = Closure_65 { PSHUFDMask: &mut PSHUFDMask };
    moveInputsToRightHalf(HToLInputs, LToLInputs, PSHUFHMask, LoMask, HiMask, 4, 0);
    moveInputsToRightHalf(LToHInputs, HToHInputs, PSHUFLMask, HiMask, LoMask, 0, 4);
    if !isNoopShuffleMask(PSHUFLMask) {
        V = DAG;
    }
    if !isNoopShuffleMask(PSHUFHMask) {
        V = DAG;
    }
    if !isNoopShuffleMask(PSHUFDMask) {
        V = DAG.getBitcast(VT, DAG);
    }
    assert!(none_of(LoMask, Closure_68 {}), "Failed to lift all the high half inputs to the low mask!");
    assert!(none_of(HiMask, Closure_69 {}), "Failed to lift all the low half inputs to the high mask!");
    if !isNoopShuffleMask(LoMask) {
        V = DAG;
    }
    for M in HiMask {
        if M >= 0 {
            M -= 4;
        }
    }
    if !isNoopShuffleMask(HiMask) {
        V = DAG;
    }
    return V;
}

fn lowerShuffleAsBlendOfPSHUFBs(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, DAG: *mut SelectionDAG, V1InUse: *mut bool, V2InUse: *mut bool) -> SDValue {
    assert!(!is128BitLaneCrossingShuffleMask(VT, Mask), "Lane crossing shuffle masks not supported");
    let mut NumBytes: i32 = VT.getSizeInBits().operator unsigned long long() / 8;
    let mut Size: i32 = Mask.len;
    let mut Scale: i32 = NumBytes / Size;
    let mut V1Mask: SmallVector<SDValue, 64> = zeroed();
    let mut V2Mask: SmallVector<SDValue, 64> = zeroed();
    V1InUse = false;
    V2InUse = false;
    for let mut i: i32 = 0; i < NumBytes; i += 1 {
        let mut M: i32 = Mask[i / Scale];
        if M < 0 {
            continue;
        }
        let mut ZeroMask: i32 = 128;
        let mut V1Idx: i32 = if M < Size { M * Scale + i % Scale } else { ZeroMask };
        let mut V2Idx: i32 = if M < Size { ZeroMask } else { (M - Size) * Scale + i % Scale };
        if Zeroable[i / Scale] {
            V1Idx = V2Idx = ZeroMask;
        }
        V1Mask()[i] = DAG.getConstant(V1Idx, DL, EVT { i8 }, false, false);
        V2Mask()[i] = DAG.getConstant(V2Idx, DL, EVT { i8 }, false, false);
        V1InUse |= (ZeroMask != V1Idx);
        V2InUse |= (ZeroMask != V2Idx);
    }
    let mut ShufVT: MVT = getVectorVT(MVT { SimpleTy: i8 }, NumBytes);
    if V1InUse {
        V1 = DAG;
    }
    if V2InUse {
        V2 = DAG;
    }
    let mut V: SDValue = SDValue {};
    if V1InUse && V2InUse {
        V = DAG.getNode(OR, DL, EVT { ShufVT }, V1, V2);
    } else {
        V = if V1InUse { V1 } else { V2 };
    }
    return DAG.getBitcast(EVT { VT }, V);
}

fn lowerV8I16Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8i16, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8i16, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleWithVPMOV(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    let mut NumV2Inputs: i32 = count_if(Mask, Closure_70 {});
    if NumV2Inputs == 0 {
        if lowerShuffleAsShift(DL, MVT { SimpleTy: v8i16 }, V1, V1, Mask, Zeroable, Subtarget, DAG, false) {
            Shift;
        } else {
            return Shift;
        }
        if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v8i16 }, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleWithPACK(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v8i16 }, V1, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        let mut MutableMask: SmallVector<int, 8> = zeroed();
        return lowerV8I16GeneralSingleInputShuffle(DL, v8i16, V1, Subtarget, DAG);
    }
    assert!(any_of(Mask, Closure_71 {}), "All single-input shuffles should be canonicalized to be V1-input shuffles.");
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if Subtarget()() {
        if lowerShuffleWithSSE4A(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, DAG) {
            V;
        } else {
            return V;
        }
    }
    if NumV2Inputs == 1 {
        if lowerShuffleAsElementInsertion(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    let mut IsBlendSupported: bool = Subtarget.hasSSE41();
    if IsBlendSupported {
        if lowerShuffleAsBlend(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    if lowerShuffleAsBitMask(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, DAG) {
        Masked;
    } else {
        return Masked;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVTRUNC(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleAsBitBlend(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, DAG) {
        BitBlend;
    } else {
        return BitBlend;
    }
    if lowerShuffleAsByteShiftMask(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    let mut NumEvenDrops: i32 = canLowerByDroppingElements(Mask, true, false);
    if (NumEvenDrops == 1 || (NumEvenDrops == 2 && Subtarget.hasSSE41())) && operator!(Subtarget()()) {
        let mut PackOpc: u32 = 0;
        if NumEvenDrops == 2 && Subtarget.hasAVX2() && peekThroughBitcasts(V1).getOpcode() == EXTRACT_SUBVECTOR && peekThroughBitcasts(V2).getOpcode() == EXTRACT_SUBVECTOR {
            let mut V1V2: SDValue = concatSubVectors(V1, V2, DAG, DL);
            V1V2 = DAG;
            V1V2 = DAG.getBitcast(EVT { v8i32 }, V1V2);
            V1 = extract128BitVector(V1V2, 0, DAG, DL);
            V2 = extract128BitVector(V1V2, 4, DAG, DL);
        } else if Subtarget.hasSSE41() {
            let mut DWordClearOps: SmallVector<SDValue, 4> = zeroed();
            for let mut i: u32 = 0; i != 4; i += 1 << (NumEvenDrops - 1) {
                DWordClearOps()[i] = DAG.getConstant(65535, DL, EVT { i32 }, false, false);
            }
            let mut DWordClearMask: SDValue = DAG(v4i32, DL);
            V1 = DAG.getNode(AND, DL, EVT { v4i32 }, DAG.getBitcast(EVT { v4i32 }, V1), DWordClearMask);
            V2 = DAG.getNode(AND, DL, EVT { v4i32 }, DAG.getBitcast(EVT { v4i32 }, V2), DWordClearMask);
        } else if !Subtarget.hasSSSE3() {
            let mut ShAmt: SDValue = DAG.getTargetConstant(16, DL, EVT { i8 }, false);
            V1 = DAG.getBitcast(EVT { v4i32 }, V1);
            V2 = DAG.getBitcast(EVT { v4i32 }, V2);
            V1 = DAG;
            V2 = DAG;
            V1 = DAG;
            V2 = DAG;
        }
        if PackOpc {
            let mut Result: SDValue = DAG.getNode(PackOpc, DL, EVT { v8i16 }, V1, V2);
            if NumEvenDrops == 2 {
                Result = DAG.getBitcast(EVT { v4i32 }, Result);
                Result = DAG.getNode(PackOpc, DL, EVT { v8i16 }, Result, Result);
            }
            return Result;
        }
    }
    let mut NumOddDrops: i32 = canLowerByDroppingElements(Mask, false, false);
    if NumOddDrops == 1 {
        let mut HasSSE41: bool = Subtarget.hasSSE41();
        V1 = DAG;
        V2 = DAG;
        return DAG;
    }
    if lowerShuffleAsPermuteAndUnpack(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Subtarget, DAG) {
        Unpack;
    } else {
        return Unpack;
    }
    if !IsBlendSupported && Subtarget.hasSSSE3() {
        let mut V1InUse: bool = false;
        let mut V2InUse: bool = false;
        return lowerShuffleAsBlendOfPSHUFBs(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, DAG, V1InUse, V2InUse);
    }
    return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v8i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV8F16Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8f16, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8f16, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    let mut NumV2Elements: i32 = count_if(Mask, Closure_72 {});
    if Subtarget()() {
        if NumV2Elements == 0 {
            if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v8f16 }, V1, V2, Mask, Subtarget, DAG) {
                Broadcast;
            } else {
                return Broadcast;
            }
        }
        if NumV2Elements == 1 && Mask[0] >= 8 {
            if lowerShuffleAsElementInsertion(DL, MVT { SimpleTy: v8f16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
                V;
            } else {
                return V;
            }
        }
    }
    V1 = DAG.getBitcast(EVT { v8i16 }, V1);
    V2 = DAG.getBitcast(EVT { v8i16 }, V2);
    return DAG.getBitcast(EVT { v8f16 }, DAG.getVectorShuffle(EVT { v8i16 }, DL, V1, V2, Mask));
}

fn lowerShuffleWithPERMV(DL: *SDLoc, VT: MVT, OriginalMask: ArrayRef<int>, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut Mask: SmallVector<int, 32> = zeroed();
    if !V2.isUndef() && isShuffleFoldableLoad(V1) && !isShuffleFoldableLoad(V2) {
        commuteMask();
        swap(V1, V2);
    }
    let mut MaskVT: MVT = VT.changeTypeToInteger();
    let mut MaskNode: SDValue = SDValue {};
    let mut ShuffleVT: MVT = VT;
    if !VT.is512BitVector() && operator!(Subtarget()()) {
        V1 = widenSubVector(V1, false, Subtarget, DAG, DL, 512);
        V2 = widenSubVector(V2, false, Subtarget, DAG, DL, 512);
        ShuffleVT = V1.getSimpleValueType();
        let mut NumElts: i32 = VT.getVectorNumElements();
        let mut Scale: u32 = 512 / VT.getSizeInBits().operator unsigned long long();
        let mut AdjustedMask: SmallVector<int, 32> = zeroed();
        MaskNode = getConstVector(MaskVT, DAG, DL, true);
        MaskNode = widenSubVector(MaskNode, false, Subtarget, DAG, DL, 512);
    } else {
        MaskNode = getConstVector(MaskVT, DAG, DL, true);
    }
    let mut Result: SDValue = SDValue {};
    if V2.isUndef() {
        Result = DAG;
    } else {
        Result = DAG;
    }
    if VT != ShuffleVT {
        Result = extractSubVector(Result, 0, DAG, DL, VT.getSizeInBits().operator unsigned long long());
    }
    return Result;
}

fn lowerV16I8Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v16i8, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v16i8, "Bad operand type!");
    assert!(Mask.len == 16, "Unexpected mask size for v16 shuffle!");
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleWithPACK(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleWithVPMOV(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVTRUNC(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if Subtarget()() {
        if lowerShuffleWithSSE4A(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, DAG) {
            V;
        } else {
            return V;
        }
    }
    let mut NumV2Elements: i32 = count_if(Mask, Closure_73 {});
    if NumV2Elements == 0 {
        if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v16i8 }, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        let mut canWidenViaDuplication: Closure_74 = Closure_74 {};
        let mut tryToWidenViaDuplication: Closure_75 = Closure_75 { canWidenViaDuplication: &mut canWidenViaDuplication, Mask: &mut Mask, V1: &mut V1, DAG: &mut DAG, DL: &mut DL };
        if tryToWidenViaDuplication.call() {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsBitMask(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, DAG) {
        Masked;
    } else {
        return Masked;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsByteShiftMask(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    let mut IsSingleInput: bool = V2.isUndef();
    let mut NumEvenDrops: i32 = canLowerByDroppingElements(Mask, true, IsSingleInput);
    if Subtarget.hasSSSE3() && (IsSingleInput || NumEvenDrops != 1) {
        let mut V1InUse: bool = false;
        let mut V2InUse: bool = false;
        let mut PSHUFB: SDValue = lowerShuffleAsBlendOfPSHUFBs(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, DAG, V1InUse, V2InUse);
        if V1InUse && V2InUse {
            if Subtarget.hasSSE41() {
                if lowerShuffleAsBlend(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
                    Blend;
                } else {
                    return Blend;
                }
            }
            if lowerShuffleAsPermuteAndUnpack(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Subtarget, DAG) {
                Unpack;
            } else {
                return Unpack;
            }
            if Subtarget()() {
                return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v16i8 }, Mask, V1, V2, Subtarget, DAG);
            }
            if Subtarget()() {
                let mut MaskNode: SDValue = getConstVector(Mask, MVT { SimpleTy: v16i8 }, DAG, DL, true);
                return DAG;
            }
            if lowerShuffleAsByteRotateAndPermute(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Subtarget, DAG) {
                V;
            } else {
                return V;
            }
        }
        return PSHUFB;
    }
    if NumV2Elements == 1 {
        if lowerShuffleAsElementInsertion(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsBitBlend(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if NumEvenDrops {
        assert!(NumEvenDrops <= 3, "No support for dropping even elements more than 3 times.");
        let mut WordClearOps: SmallVector<SDValue, 8> = zeroed();
        for let mut i: u32 = 0; i != 8; i += 1 << (NumEvenDrops - 1) {
            WordClearOps()[i] = DAG.getConstant(255, DL, EVT { i16 }, false, false);
        }
        let mut WordClearMask: SDValue = DAG(v8i16, DL);
        V1 = DAG.getNode(AND, DL, EVT { v8i16 }, DAG.getBitcast(EVT { v8i16 }, V1), WordClearMask);
        if !IsSingleInput {
            V2 = DAG.getNode(AND, DL, EVT { v8i16 }, DAG.getBitcast(EVT { v8i16 }, V2), WordClearMask);
        }
        let mut Result: SDValue = DAG;
        for let mut i: i32 = 1; i < NumEvenDrops; i += 1 {
            Result = DAG.getBitcast(EVT { v8i16 }, Result);
            Result = DAG;
        }
        return Result;
    }
    let mut NumOddDrops: i32 = canLowerByDroppingElements(Mask, false, IsSingleInput);
    if NumOddDrops == 1 {
        V1 = DAG;
        if !IsSingleInput {
            V2 = DAG;
        }
        return DAG;
    }
    if NumV2Elements > 0 {
        return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v16i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    let mut V: SDValue = V1;
    let mut LoBlendMask: array<int, 8> = zeroed();
    let mut HiBlendMask: array<int, 8> = zeroed();
    for let mut i: i32 = 0; i < 16; i += 1 {
        if Mask[i] >= 0 {
            (if i < 8 { [i] } else { [i % 8] }) = Mask[i];
        }
    }
    let mut VLoHalf: SDValue = SDValue {};
    let mut VHiHalf: SDValue = SDValue {};
    if none_of(Closure_78 {}) && none_of(Closure_79 {}) {
        VLoHalf = DAG.getBitcast(EVT { v8i16 }, V);
        VLoHalf = DAG.getNode(AND, DL, EVT { v8i16 }, VLoHalf, DAG.getConstant(255, DL, EVT { v8i16 }, false, false));
        VHiHalf = DAG.getUNDEF(EVT { v8i16 });
    } else {
        let mut Zero: SDValue = getZeroVector(MVT { SimpleTy: v16i8 }, Subtarget, DAG, DL);
        VLoHalf = DAG.getBitcast(v8i16, DAG);
        VHiHalf = DAG.getBitcast(v8i16, DAG);
    }
    let mut LoV: SDValue = DAG.getVectorShuffle(v8i16, DL, VLoHalf, VHiHalf);
    let mut HiV: SDValue = DAG.getVectorShuffle(v8i16, DL, VLoHalf, VHiHalf);
    return DAG;
}

fn lower128BitShuffle(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if VT == v8bf16 {
        V1 = DAG.getBitcast(EVT { v8i16 }, V1);
        V2 = DAG.getBitcast(EVT { v8i16 }, V2);
        return DAG.getBitcast(EVT { VT }, DAG.getVectorShuffle(EVT { v8i16 }, DL, V1, V2, Mask));
    }
    match VT.SimpleTy {
        v2i64 => {
            return lowerV2I64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v2f64 => {
            return lowerV2F64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v4i32 => {
            return lowerV4I32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v4f32 => {
            return lowerV4F32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8i16 => {
            return lowerV8I16Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8f16 => {
            return lowerV8F16Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v16i8 => {
            return lowerV16I8Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        _ => {
            llvm_unreachable_internal("Unimplemented!", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 15497);
        },
    }
}

fn splitAndLowerShuffle(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG, SimpleOnly: bool) -> SDValue {
    assert!(VT.getSizeInBits().operator unsigned long long() >= 256, "Only for 256-bit or wider vector shuffles!");
    assert!(V1.getSimpleValueType() == VT, "Bad operand type!");
    assert!(V2.getSimpleValueType() == VT, "Bad operand type!");
    if VT == v8f32 {
        let mut BC1: SDValue = peekThroughBitcasts(V1);
        let mut BC2: SDValue = peekThroughBitcasts(V2);
        if BC1.getValueType() == EVT { v8i32 } && BC2.getValueType() == EVT { v8i32 } {
            if splitAndLowerShuffle(DL, MVT { SimpleTy: v8i32 }, BC1, BC2, Mask, DAG, SimpleOnly) {
                Split;
            } else {
                return DAG.getBitcast(EVT { VT }, Split);
            }
        }
    }
    let mut LoMask: ArrayRef<int> = Mask.slice(0, Mask.len / 2);
    let mut HiMask: ArrayRef<int> = Mask.slice(Mask.len / 2);
    let mut NumElements: i32 = VT.getVectorNumElements();
    let mut SplitNumElements: i32 = NumElements / 2;
    let mut ScalarVT: MVT = VT.getVectorElementType();
    let mut SplitVT: MVT = getVectorVT(ScalarVT, SplitNumElements);
    let mut SplitVector: Closure_80 = Closure_80 { DAG: &mut DAG, DL: &mut DL, SplitVT: &mut SplitVT };
    let mut LoV1: SDValue = SDValue {};
    let mut HiV1: SDValue = SDValue {};
    let mut LoV2: SDValue = SDValue {};
    let mut HiV2: SDValue = SDValue {};
    tie(LoV1, HiV1) = SplitVector(V1);
    tie(LoV2, HiV2) = SplitVector(V2);
    let mut GetHalfBlendPiecesReq: Closure_81 = Closure_81 { SplitNumElements: &mut SplitNumElements, NumElements: &mut NumElements };
    let mut CheckHalfBlendUsable: Closure_82 = Closure_82 { SimpleOnly: &mut SimpleOnly, GetHalfBlendPiecesReq: &mut GetHalfBlendPiecesReq };
    let mut HalfBlend: Closure_83 = Closure_83 { SplitNumElements: &mut SplitNumElements, NumElements: &mut NumElements, GetHalfBlendPiecesReq: &mut GetHalfBlendPiecesReq, SimpleOnly: &mut SimpleOnly, DAG: &mut DAG, SplitVT: &mut SplitVT, DL: &mut DL, LoV1: &mut LoV1, HiV1: &mut HiV1, LoV2: &mut LoV2, HiV2: &mut HiV2 };
    if !CheckHalfBlendUsable.call(LoMask) || !CheckHalfBlendUsable.call(HiMask) {
        return SDValue {};
    }
    let mut Lo: SDValue = HalfBlend(LoMask);
    let mut Hi: SDValue = HalfBlend(HiMask);
    return DAG.getNode(CONCAT_VECTORS, DL, EVT { VT }, Lo, Hi);
}

fn lowerShuffleAsSplitOrBlend(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(!V2.isUndef(), "This routine must not be used to lower single-input shuffles as it could then recurse on itself.");
    let mut Size: i32 = Mask.len;
    let mut DoBothBroadcast: Closure_84 = Closure_84 { Mask: &mut Mask, Size: &mut Size, V2: &mut V2, V1: &mut V1 };
    if DoBothBroadcast.call() {
        return lowerShuffleAsDecomposedShuffleMerge(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    let mut LaneCount: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut LaneSize: i32 = Size / LaneCount;
    let mut LaneInputs: [2]SmallBitVector = [2]SmallBitVector {};
    LaneInputs[0].resize(LaneCount, false);
    LaneInputs[1].resize(LaneCount, false);
    for let mut i: i32 = 0; i < Size; i += 1 {
        if Mask[i] >= 0 {
            LaneInputs[Mask[i] / Size][(Mask[i] % Size) / LaneSize] = true;
        }
    }
    if LaneInputs[0].count() <= 1 && LaneInputs[1].count() <= 1 {
        return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
    }
    if !Subtarget.hasAVX2() {
        let mut BC1: SDValue = peekThroughBitcasts(V1);
        let mut BC2: SDValue = peekThroughBitcasts(V2);
        let mut SplatOrSplitV1: bool = isFreeToSplitVector(BC1, DAG) || DAG.isSplatValue(BC1, true);
        let mut SplatOrSplitV2: bool = isFreeToSplitVector(BC2, DAG) || DAG.isSplatValue(BC2, true);
        if SplatOrSplitV1 && SplatOrSplitV2 {
            return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
        }
    }
    return lowerShuffleAsDecomposedShuffleMerge(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerShuffleAsLanePermuteAndSHUFP(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT == v4f64, "Only for v4f64 shuffles");
    let mut LHSMask: [4]i32 = [-1, -1, -1, -1];
    let mut RHSMask: [4]i32 = [-1, -1, -1, -1];
    let mut SHUFPDMask: [4]i32 = [-1, -1, -1, -1];
    for let mut i: i32 = 0; i != 4; i += 1 {
        let mut M: i32 = Mask[i];
        if M < 0 {
            continue;
        }
        let mut LaneBase: i32 = i & ~1;
        let mut LaneMask: [4]*mut i32 = if (i & 1) { RHSMask } else { LHSMask };
        LaneMask[LaneBase + (M & 1)] = M;
        SHUFPDMask[i] = M & 1;
    }
    let mut LHS: SDValue = DAG.getVectorShuffle;
    let mut RHS: SDValue = DAG.getVectorShuffle;
    return DAG;
}

fn lowerShuffleAsLanePermuteAndPermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumEltsPerLane: i32 = NumElts / NumLanes;
    let mut CanUseSublanes: bool = Subtarget.hasAVX2() && V2.isUndef();
    let mut getSublanePermute: Closure_85 = Closure_85 { NumLanes: &mut NumLanes, NumElts: &mut NumElts, Mask: &mut Mask, NumEltsPerLane: &mut NumEltsPerLane, CanUseSublanes: &mut CanUseSublanes, V1: &mut V1, DAG: &mut DAG, VT: &mut VT, DL: &mut DL, V2: &mut V2 };
    let mut MaxSublaneScale: i32 = 1;
    if CanUseSublanes {
        MaxSublaneScale = if Subtarget()() { 4 } else { 2 };
    }
    for let mut SublaneScale: i32 = 1; SublaneScale <= MaxSublaneScale; SublaneScale *= 2 {
        let mut SameMask: bool = false;
        if getSublanePermute.call(NumLanes * SublaneScale, SameMask) {
            V;
        } else {
            return V;
        }
        if SameMask {
            return SDValue {};
        }
    }
    return SDValue {};
}

fn computeInLaneShuffleMask(Mask: *ArrayRef<int>, LaneSize: i32, InLaneMask: *mut i32) {
    let mut Size: i32 = Mask.len;
    InLaneMask()(Mask.begin(), Mask.end());
    for let mut i: i32 = 0; i < Size; i += 1 {
        let mut M: *mut i32 = [i];
        if M < 0 {
            continue;
        }
        if ((M % Size) / LaneSize) != (i / LaneSize) {
            M = (M % LaneSize) + ((i / LaneSize) * LaneSize) + Size;
        }
    }
}

fn lowerShuffleAsLanePermuteAndShuffle(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(VT.is256BitVector(), "Only for 256-bit vector shuffles!");
    let mut Size: i32 = Mask.len;
    let mut LaneSize: i32 = Size / 2;
    if VT == v4f64 && !all_of(Mask, Closure_86 { LaneSize: LaneSize }) {
        return lowerShuffleAsLanePermuteAndSHUFP(DL, VT, V1, V2, Mask, DAG);
    }
    let mut AllLanes: bool = false;
    if !Subtarget.hasAVX2() {
        let mut LaneCrossing: [2]bool = [false, false];
        for let mut i: i32 = 0; i < Size; i += 1 {
            if Mask[i] >= 0 && ((Mask[i] % Size) / LaneSize) != (i / LaneSize) {
                LaneCrossing[(Mask[i] % Size) / LaneSize] = true;
            }
        }
        AllLanes = LaneCrossing[0] && LaneCrossing[1];
    } else {
        let mut LaneUsed: [2]bool = [false, false];
        for let mut i: i32 = 0; i < Size; i += 1 {
            if Mask[i] >= 0 {
                LaneUsed[(Mask[i] % Size) / LaneSize] = true;
            }
        }
        AllLanes = LaneUsed[0] && LaneUsed[1];
    }
    assert!(V2.isUndef(), "This last part of this routine only works on single input shuffles");
    let mut InLaneMask: i32 = 0;
    computeInLaneShuffleMask(Mask, Mask.len / 2);
    (((operator!(operator!((operator!(is128BitLaneCrossingShuffleMask(VT)) && "In-lane shuffle mask expected")))) || (_wassert(L"!is128BitLaneCrossingShuffleMask(VT, InLaneMask) && \"In-lane shuffle mask expected\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (15930) as u32) , 0)) as void);
    if !AllLanes && operator!(is128BitLaneRepeatedShuffleMask(VT)) {
        return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
    }
    let mut PVT: MVT = MVT { SimpleTy: if VT.isFloatingPoint() { v4f64 } else { v4i64 } };
    let mut Flipped: SDValue = DAG.getBitcast(EVT { PVT }, V1);
    Flipped = DAG.getVectorShuffle(EVT { PVT }, DL, Flipped, DAG.getUNDEF(EVT { PVT }), ArrayRef<int> { [2, 3, 0, 1] });
    Flipped = DAG.getBitcast(EVT { VT }, Flipped);
    return DAG.getVectorShuffle(VT, DL, V1, Flipped);
}

fn lowerV2X128Shuffle(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if V2.isUndef() {
        let mut SplatLo: bool = isShuffleEquivalent(Mask, ArrayRef<int> { [0, 1, 0, 1] }, V1, SDValue {});
        let mut SplatHi: bool = isShuffleEquivalent(Mask, ArrayRef<int> { [2, 3, 2, 3] }, V1, SDValue {});
        if (SplatLo || SplatHi) && !Subtarget.hasAVX512() && V1.hasOneUse() && mayFoldLoad(peekThroughOneUseBitcasts(V1), Subtarget, false, false) {
            let mut MemVT: MVT = VT.getHalfNumVectorElementsVT();
            let mut Ofs: u32 = if SplatLo { 0 } else { MemVT.getStoreSize().operator unsigned long long() };
            let mut Ld: *mut auto = cast(peekThroughOneUseBitcasts(V1));
            if getBROADCAST_LOAD(DL, VT, MemVT, Ofs, DAG) {
                BcstLd;
            } else {
                return BcstLd;
            }
        }
        if Subtarget.hasAVX2() {
            return SDValue {};
        }
    }
    let mut V2IsZero: bool = !V2.isUndef() && isBuildVectorAllZeros(V2.getNode());
    let mut WidenedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    if !canWidenShuffleElements(Mask, Zeroable, V2IsZero, WidenedMask) {
        return SDValue {};
    }
    let mut IsLowZero: bool = (Zeroable & 3) == 3;
    let mut IsHighZero: bool = (Zeroable & 12) == 12;
    if WidenedMask[0] == 0 && IsHighZero {
        let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), 2);
        let mut LoV: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { SubVT }, V1, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, EVT { VT }, getZeroVector(VT, Subtarget, DAG, DL), LoV, DAG.getVectorIdxConstant(0, DL, false));
    }
    if lowerShuffleAsBlend(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if !IsLowZero && !IsHighZero {
        let mut OnlyUsesV1: bool = isShuffleEquivalent(Mask, ArrayRef<int> { [0, 1, 0, 1] }, V1, V2);
        if OnlyUsesV1 || isShuffleEquivalent(Mask, ArrayRef<int> { [0, 1, 4, 5] }, V1, V2) {
            if !isa(peekThroughBitcasts(V1)) {
                let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), 2);
                let mut SubVec: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { SubVT }, if OnlyUsesV1 { V1 } else { V2 }, DAG.getVectorIdxConstant(0, DL, false));
                return DAG.getNode(INSERT_SUBVECTOR, DL, EVT { VT }, V1, SubVec, DAG.getVectorIdxConstant(2, DL, false));
            }
        }
        if Subtarget()() {
            if WidenedMask[0] < 2 && WidenedMask[1] >= 2 {
                let mut PermMask: u32 = ((WidenedMask[0] % 2) << 0) | ((WidenedMask[1] % 2) << 1);
                return DAG;
            }
        }
    }
    assert!((WidenedMask[0] >= 0 || IsLowZero) && (WidenedMask[1] >= 0 || IsHighZero), "Undef half?");
    let mut PermMask: u32 = 0;
    PermMask |= if IsLowZero { 8 } else { (WidenedMask[0] << 0) };
    PermMask |= if IsHighZero { 128 } else { (WidenedMask[1] << 4) };
    if (PermMask & 10) != 0 && (PermMask & 160) != 0 {
        V1 = DAG.getUNDEF(EVT { VT });
    }
    if (PermMask & 10) != 2 && (PermMask & 160) != 32 {
        V2 = DAG.getUNDEF(EVT { VT });
    }
    return DAG;
}

fn lowerShuffleAsLanePermuteAndRepeatedMask(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if V2.isUndef() || is128BitLaneRepeatedShuffleMask(VT, Mask) {
        return SDValue {};
    }
    let mut NumElts: i32 = Mask.len;
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumLaneElts: i32 = 128 / VT.getScalarSizeInBits();
    let mut RepeatMask: SmallVector<int, 16> = SmallVector<int, 16> { NumLaneElts, -1 };
    let mut LaneSrcs: array<int, 2>, 2> = zeroed();
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        let mut Srcs: [2]i32 = [-1, -1];
        let mut InLaneMask: SmallVector<int, 16> = SmallVector<int, 16> { NumLaneElts, -1 };
        for let mut i: i32 = 0; i != NumLaneElts; i += 1 {
            let mut M: i32 = Mask[(Lane * NumLaneElts) + i];
            if M < 0 {
                continue;
            }
            let mut LaneSrc: i32 = M / NumLaneElts;
            let mut Src: i32 = 0;
            if Srcs[0] < 0 || Srcs[0] == LaneSrc {
                Src = 0;
            } else if Srcs[1] < 0 || Srcs[1] == LaneSrc {
                Src = 1;
            } else {
                return SDValue {};
            }
            Srcs[Src] = LaneSrc;
            InLaneMask[i] = (M % NumLaneElts) + Src * NumElts;
        }
        if Srcs[1] < 0 {
            continue;
        }
        LaneSrcs()[Lane][0] = Srcs[0];
        LaneSrcs()[Lane][1] = Srcs[1];
        let mut MatchMasks: Closure_87 = Closure_87 {};
        let mut MergeMasks: Closure_88 = Closure_88 {};
        if MatchMasks(InLaneMask, RepeatMask) {
            MergeMasks(InLaneMask, RepeatMask);
            continue;
        }
        swap([Lane][0], [Lane][1]);
        commuteMask(InLaneMask);
        if MatchMasks(InLaneMask, RepeatMask) {
            MergeMasks(InLaneMask, RepeatMask);
            continue;
        }
        return SDValue {};
    }
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        if LaneSrcs()[Lane][0] >= 0 {
            continue;
        }
        for let mut i: i32 = 0; i != NumLaneElts; i += 1 {
            let mut M: i32 = Mask[(Lane * NumLaneElts) + i];
            if M < 0 {
                continue;
            }
            if RepeatMask[i] < 0 {
                RepeatMask[i] = M % NumLaneElts;
            }
            if RepeatMask[i] < NumElts {
                if RepeatMask[i] != M % NumLaneElts {
                    return SDValue {};
                }
                LaneSrcs()[Lane][0] = M / NumLaneElts;
            } else {
                if RepeatMask[i] != ((M % NumLaneElts) + NumElts) {
                    return SDValue {};
                }
                LaneSrcs()[Lane][1] = M / NumLaneElts;
            }
        }
        if LaneSrcs()[Lane][0] < 0 && [Lane][1] < 0 {
            return SDValue {};
        }
    }
    let mut NewMask: SmallVector<int, 16> = SmallVector<int, 16> { NumElts, -1 };
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        let mut Src: i32 = [Lane][0];
        for let mut i: i32 = 0; i != NumLaneElts; i += 1 {
            let mut M: i32 = -1;
            if Src >= 0 {
                M = Src * NumLaneElts + i;
            }
            NewMask[Lane * NumLaneElts + i] = M;
        }
    }
    let mut NewV1: SDValue = DAG.getVectorShuffle;
    if isa(NewV1) && cast(NewV1)() == Mask {
        return SDValue {};
    }
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        let mut Src: i32 = [Lane][1];
        for let mut i: i32 = 0; i != NumLaneElts; i += 1 {
            let mut M: i32 = -1;
            if Src >= 0 {
                M = Src * NumLaneElts + i;
            }
            NewMask[Lane * NumLaneElts + i] = M;
        }
    }
    let mut NewV2: SDValue = DAG.getVectorShuffle;
    if isa(NewV2) && cast(NewV2)() == Mask {
        return SDValue {};
    }
    for let mut i: i32 = 0; i != NumElts; i += 1 {
        if Mask[i] < 0 {
            NewMask[i] = -1;
            continue;
        }
        NewMask[i] = RepeatMask[i % NumLaneElts];
        if NewMask[i] < 0 {
            continue;
        }
        NewMask[i] += (i / NumLaneElts) * NumLaneElts;
    }
    return DAG.getVectorShuffle;
}

fn getHalfShuffleMask(Mask: ArrayRef<int>, HalfMask: MutableArrayRef<int>, HalfIdx1: *mut i32, HalfIdx2: *mut i32) -> bool {
    assert!((Mask.len == HalfMask.len * 2), "Expected input mask to be twice as long as output");
    let mut UndefLower: bool = isUndefLowerHalf(Mask);
    let mut UndefUpper: bool = isUndefUpperHalf(Mask);
    if UndefLower == UndefUpper {
        return false;
    }
    let mut HalfNumElts: u32 = HalfMask.len;
    let mut MaskIndexOffset: u32 = if UndefLower { HalfNumElts } else { 0 };
    HalfIdx1 = -1;
    HalfIdx2 = -1;
    for let mut i: u32 = 0; i != HalfNumElts; i += 1 {
        let mut M: i32 = Mask[i + MaskIndexOffset];
        if M < 0 {
            HalfMask[i] = M;
            continue;
        }
        let mut HalfIdx: i32 = M / HalfNumElts;
        let mut HalfElt: i32 = M % HalfNumElts;
        if HalfIdx1 < 0 || HalfIdx1 == HalfIdx {
            HalfMask[i] = HalfElt;
            HalfIdx1 = HalfIdx;
            continue;
        }
        if HalfIdx2 < 0 || HalfIdx2 == HalfIdx {
            HalfMask[i] = HalfElt + HalfNumElts;
            HalfIdx2 = HalfIdx;
            continue;
        }
        return false;
    }
    return true;
}

fn getShuffleHalfVectors(DL: *SDLoc, V1: SDValue, V2: SDValue, HalfMask: ArrayRef<int>, HalfIdx1: i32, HalfIdx2: i32, UndefLower: bool, DAG: *mut SelectionDAG, UseConcat: bool) -> SDValue {
    assert!(V1.getValueType() == V2.getValueType(), "Different sized vectors?");
    assert!(V1.getValueType().isSimple(), "Expecting only simple types");
    let mut VT: MVT = V1.getSimpleValueType();
    let mut HalfVT: MVT = VT.getHalfNumVectorElementsVT();
    let mut HalfNumElts: u32 = HalfVT.getVectorNumElements();
    let mut getHalfVector: Closure_89 = Closure_89 { DAG: &mut DAG, HalfVT: &mut HalfVT, V1: &mut V1, V2: &mut V2, HalfNumElts: &mut HalfNumElts, DL: &mut DL };
    let mut Half1: SDValue = getHalfVector.call(HalfIdx1);
    let mut Half2: SDValue = getHalfVector.call(HalfIdx2);
    let mut V: SDValue = DAG.getVectorShuffle(EVT { HalfVT }, DL, Half1, Half2, HalfMask);
    if UseConcat {
        let mut Op0: SDValue = V;
        let mut Op1: SDValue = DAG.getUNDEF(EVT { HalfVT });
        if UndefLower {
            swap(Op0, Op1);
        }
        return DAG.getNode(CONCAT_VECTORS, DL, EVT { VT }, Op0, Op1);
    }
    let mut Offset: u32 = if UndefLower { HalfNumElts } else { 0 };
    return DAG.getNode(INSERT_SUBVECTOR, DL, EVT { VT }, DAG.getUNDEF(EVT { VT }), V, DAG.getVectorIdxConstant(Offset, DL, false));
}

fn lowerShuffleWithUndefHalf(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!((VT.is256BitVector() || VT.is512BitVector()), "Expected 256-bit or 512-bit vector");
    let mut UndefLower: bool = isUndefLowerHalf(Mask);
    if !UndefLower && !isUndefUpperHalf(Mask) {
        return SDValue {};
    }
    assert!((!UndefLower || !isUndefUpperHalf(Mask)), "Completely undef shuffle mask should have been simplified already");
    let mut HalfVT: MVT = VT.getHalfNumVectorElementsVT();
    let mut HalfNumElts: u32 = HalfVT.getVectorNumElements();
    if !UndefLower && isSequentialOrUndefInRange(Mask, 0, HalfNumElts, HalfNumElts, 1) {
        let mut Hi: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { HalfVT }, V1, DAG.getVectorIdxConstant(HalfNumElts, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, EVT { VT }, DAG.getUNDEF(EVT { VT }), Hi, DAG.getVectorIdxConstant(0, DL, false));
    }
    if UndefLower && isSequentialOrUndefInRange(Mask, HalfNumElts, HalfNumElts, 0, 1) {
        let mut Hi: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { HalfVT }, V1, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, EVT { VT }, DAG.getUNDEF(EVT { VT }), Hi, DAG.getVectorIdxConstant(HalfNumElts, DL, false));
    }
    let mut HalfIdx1: i32 = 0;
    let mut HalfIdx2: i32 = 0;
    let mut HalfMask: SmallVector<int, 8> = zeroed();
    if operator!(getHalfShuffleMask(Mask, HalfIdx1, HalfIdx2)) {
        return SDValue {};
    }
    (((operator!(operator!((HalfMask()() == HalfNumElts && "Unexpected shuffle mask length")))) || (_wassert(L"HalfMask.size() == HalfNumElts && \"Unexpected shuffle mask length\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (16372) as u32) , 0)) as void);
    let mut NumLowerHalves: u32 = (HalfIdx1 == 0 || HalfIdx1 == 2) + (HalfIdx2 == 0 || HalfIdx2 == 2);
    let mut NumUpperHalves: u32 = (HalfIdx1 == 1 || HalfIdx1 == 3) + (HalfIdx2 == 1 || HalfIdx2 == 3);
    assert!(NumLowerHalves + NumUpperHalves <= 2, "Only 1 or 2 halves allowed");
    let mut EltWidth: u32 = VT.getVectorElementType().getSizeInBits().operator unsigned long long();
    if !UndefLower {
        if NumUpperHalves == 0 {
            return getShuffleHalfVectors(DL, V1, V2, HalfIdx1, HalfIdx2, UndefLower, DAG);
        }
        if NumUpperHalves == 1 {
            if Subtarget.hasAVX2() {
                if EltWidth == 32 && NumLowerHalves && HalfVT.is128BitVector() && operator!(is128BitUnpackShuffleMask(DAG)) && (operator!(isSingleSHUFPSMask()) || Subtarget()()) {
                    return SDValue {};
                }
                if EltWidth == 64 && V2.isUndef() {
                    return SDValue {};
                }
                if EltWidth == 8 && HalfIdx1 == 0 && HalfIdx2 == 1 {
                    return SDValue {};
                }
            }
            if Subtarget.hasAVX512() && VT.is512BitVector() {
                return SDValue {};
            }
            return getShuffleHalfVectors(DL, V1, V2, HalfIdx1, HalfIdx2, UndefLower, DAG);
        }
        assert!(NumUpperHalves == 2, "Half vector count went wrong");
        return SDValue {};
    }
    if NumUpperHalves == 0 {
        if Subtarget.hasAVX2() && EltWidth == 64 {
            return SDValue {};
        }
        if Subtarget.hasAVX512() && VT.is512BitVector() {
            return SDValue {};
        }
        return getShuffleHalfVectors(DL, V1, V2, HalfIdx1, HalfIdx2, UndefLower, DAG);
    }
    return SDValue {};
}

fn lowerShuffleAsRepeatedMaskAndLanePermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumLaneElts: i32 = NumElts / NumLanes;
    if Subtarget.hasAVX2() {
        for BroadcastSize in [16, 32, 64] {
            if BroadcastSize <= VT.getScalarSizeInBits() {
                continue;
            }
            let mut NumBroadcastElts: i32 = BroadcastSize / VT.getScalarSizeInBits();
            let mut FindRepeatingBroadcastMask: Closure_90 = Closure_90 { NumElts: &mut NumElts, NumBroadcastElts: &mut NumBroadcastElts, Mask: &mut Mask, NumLaneElts: &mut NumLaneElts };
            let mut RepeatMask: SmallVector<int, 8> = zeroed();
            if operator!(FindRepeatingBroadcastMask()) {
                continue;
            }
            let mut RepeatShuf: SDValue = DAG.getVectorShuffle(VT, DL, V1, V2);
            let mut BroadcastMask: SmallVector<int, 8> = zeroed();
            for let mut i: i32 = 0; i != NumElts; i += NumBroadcastElts {
                for let mut j: i32 = 0; j != NumBroadcastElts; j += 1 {
                    BroadcastMask()[i + j] = j;
                }
            }
            if BroadcastMask() == Mask {
                return SDValue {};
            }
            return DAG.getVectorShuffle(VT, DL, RepeatShuf, DAG.getUNDEF(EVT { VT }));
        }
    }
    if !is128BitLaneCrossingShuffleMask(VT, Mask) {
        return SDValue {};
    }
    if is128BitLaneRepeatedShuffleMask(VT, Mask) {
        return SDValue {};
    }
    let mut ShuffleSubLanes: Closure_91 = Closure_91 { NumLanes: &mut NumLanes, NumLaneElts: &mut NumLaneElts, Mask: &mut Mask, NumElts: &mut NumElts, DAG: &mut DAG, VT: &mut VT, DL: &mut DL, V1: &mut V1, V2: &mut V2 };
    let mut MinSubLaneScale: i32 = 1;
    let mut MaxSubLaneScale: i32 = 1;
    if Subtarget.hasAVX2() && VT.is256BitVector() {
        let mut OnlyLowestElts: bool = isUndefOrInRange(Mask, 0, NumLaneElts);
        MinSubLaneScale = 2;
        MaxSubLaneScale = if (!OnlyLowestElts && V2.isUndef() && VT == v32i8) { 4 } else { 2 };
    }
    if Subtarget()() && VT == v64i8 {
        MinSubLaneScale = MaxSubLaneScale = 4;
    }
    for let mut Scale: i32 = MinSubLaneScale; Scale <= MaxSubLaneScale; Scale *= 2 {
        if ShuffleSubLanes(Scale) {
            Shuffle;
        } else {
            return Shuffle;
        }
    }
    return SDValue {};
}

fn matchShuffleWithSHUFPD(VT: MVT, V1: *mut SDValue, V2: *mut SDValue, ForceV1Zero: *mut bool, ForceV2Zero: *mut bool, ShuffleImm: *mut u32, Mask: ArrayRef<int>, Zeroable: *APInt) -> bool {
    let mut NumElts: i32 = VT.getVectorNumElements();
    assert!(VT.getScalarSizeInBits() == 64 && (NumElts == 2 || NumElts == 4 || NumElts == 8), "Unexpected data type for VSHUFPD");
    assert!(isUndefOrZeroOrInRange(Mask, 0, 2 * NumElts), "Illegal shuffle mask");
    let mut ZeroLane: [2]bool = [true, true];
    for let mut i: i32 = 0; i < NumElts; i += 1 {
        ZeroLane[i & 1] &= Zeroable[i];
    }
    let mut IsSHUFPD: bool = true;
    let mut IsCommutable: bool = true;
    let mut SHUFPDMask: SmallVector<int, 8> = zeroed();
    for let mut i: i32 = 0; i < NumElts; i += 1 {
        if Mask[i] == SM_SentinelUndef || ZeroLane[i & 1] {
            continue;
        }
        if Mask[i] < 0 {
            return false;
        }
        let mut Val: i32 = (i & 6) + NumElts * (i & 1);
        let mut CommutVal: i32 = (i & 14) + NumElts * ((i & 1) ^ 1);
        if Mask[i] < Val || Mask[i] > Val + 1 {
            IsSHUFPD = false;
        }
        if Mask[i] < CommutVal || Mask[i] > CommutVal + 1 {
            IsCommutable = false;
        }
        SHUFPDMask()[i] = Mask[i] % 2;
    }
    if !IsSHUFPD && !IsCommutable {
        return false;
    }
    if !IsSHUFPD && IsCommutable {
        swap(V1, V2);
    }
    ForceV1Zero = ZeroLane[0];
    ForceV2Zero = ZeroLane[1];
    ShuffleImm = getSHUFPDImm();
    return true;
}

fn lowerShuffleWithSHUFPD(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!((VT == v2f64 || VT == v4f64 || VT == v8f64), "Unexpected data type for VSHUFPD");
    let mut Immediate: u32 = 0;
    let mut ForceV1Zero: bool = false;
    let mut ForceV2Zero: bool = false;
    if !matchShuffleWithSHUFPD(VT, V1, V2, ForceV1Zero, ForceV2Zero, Immediate, Mask, Zeroable) {
        return SDValue {};
    }
    if ForceV1Zero {
        V1 = getZeroVector(VT, Subtarget, DAG, DL);
    }
    if ForceV2Zero {
        V2 = getZeroVector(VT, Subtarget, DAG, DL);
    }
    return DAG;
}

fn lowerShuffleAsVTRUNCAndUnpack(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT == v32i8, "Unexpected type!");
    if !isSequentialOrUndefInRange(Mask, 0, 8, 0, 8) {
        return SDValue {};
    }
    if Zeroable.countl_one() < (Mask.len - 8) {
        return SDValue {};
    }
    V1 = DAG.getBitcast(EVT { v4i64 }, V1);
    V2 = DAG.getBitcast(EVT { v4i64 }, V2);
    V1 = DAG;
    V2 = DAG;
    let mut Unpack: SDValue = DAG.getVectorShuffle(EVT { v16i8 }, DL, V1, V2, ArrayRef<int> { [0, 1, 2, 3, 16, 17, 18, 19, 4, 5, 6, 7, 20, 21, 22, 23] });
    return DAG.getNode(INSERT_SUBVECTOR, DL, EVT { v32i8 }, DAG.getConstant(0, DL, EVT { v32i8 }, false, false), Unpack, DAG.getVectorIdxConstant(0, DL, false));
}

fn lowerShufflePairAsUNPCKAndPermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    if VT != v8f32 && VT != v8i32 && VT != v16i16 && VT != v32i8 {
        return SDValue {};
    }
    let mut IsInterleavingPattern: Closure_93 = Closure_93 {};
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut FirstQtr: u64 = NumElts / 2;
    let mut ThirdQtr: u64 = NumElts + NumElts / 2;
    let mut IsFirstHalf: bool = IsInterleavingPattern.call(Mask, 0, NumElts);
    let mut IsSecondHalf: bool = IsInterleavingPattern.call(Mask, FirstQtr, ThirdQtr);
    if !IsFirstHalf && !IsSecondHalf {
        return SDValue {};
    }
    let mut Shuffles: SmallVector<SDNode *, 2> = zeroed();
    for User in operator(V1).users() {
        if User.getOpcode() == VECTOR_SHUFFLE && User.getOperand(0) == V1 && User.getOperand(1) == V2 {
            Shuffles()(User);
        }
    }
    if Shuffles()() != 2 {
        return SDValue {};
    }
    let mut SVN1: *mut auto = cast([0]);
    let mut SVN2: *mut auto = cast([1]);
    let mut FirstHalf: *mut SDNode = null;
    let mut SecondHalf: *mut SDNode = null;
    if IsInterleavingPattern(0, NumElts) && IsInterleavingPattern(FirstQtr, ThirdQtr) {
        FirstHalf = [0];
        SecondHalf = [1];
    } else if IsInterleavingPattern(FirstQtr, ThirdQtr) && IsInterleavingPattern(0, NumElts) {
        FirstHalf = [1];
        SecondHalf = [0];
    } else {
        return SDValue {};
    }
    let mut Unpckl: SDValue = DAG;
    let mut Unpckh: SDValue = DAG;
    let mut Perm1: SDValue = DAG;
    let mut Perm2: SDValue = DAG;
    if IsFirstHalf {
        DAG.ReplaceAllUsesWith(SecondHalf, &mut Perm2);
        return Perm1;
    }
    DAG.ReplaceAllUsesWith(FirstHalf, &mut Perm1);
    return Perm2;
}

fn lowerV4F64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4f64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4f64, "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    if lowerV2X128Shuffle(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() {
        if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        if isShuffleEquivalent(Mask, ArrayRef<int> { [0, 0, 2, 2] }, V1, V2) {
            return DAG;
        }
        if !is128BitLaneCrossingShuffleMask(MVT { SimpleTy: v4f64 }, Mask) {
            let mut VPERMILPMask: u32 = (Mask[0] == 1) | ((Mask[1] == 1) << 1) | ((Mask[2] == 3) << 2) | ((Mask[3] == 3) << 3);
            return DAG;
        }
        if Subtarget.hasAVX2() {
            return DAG;
        }
        if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsLanePermuteAndPermute(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, DAG, Subtarget) {
            V;
        } else {
            return V;
        }
        return lowerShuffleAsLanePermuteAndShuffle(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, DAG, Subtarget);
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithSHUFPD(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Op;
    } else {
        return Op;
    }
    let mut V1IsInPlace: bool = isShuffleMaskInputInPlace(0, Mask);
    let mut V2IsInPlace: bool = isShuffleMaskInputInPlace(1, Mask);
    let mut V1IsSplat: bool = isShuffleMaskInputBroadcastable(0, Mask, 0);
    let mut V2IsSplat: bool = isShuffleMaskInputBroadcastable(1, Mask, 0);
    if is128BitLaneCrossingShuffleMask(MVT { SimpleTy: v4f64 }, Mask) && !all_of(Mask, Closure_94 {}) && (V1.getOpcode() != BUILD_VECTOR) && (V2.getOpcode() != BUILD_VECTOR) && (!Subtarget.hasAVX2() || !((V1IsInPlace || V1IsSplat) && (V2IsInPlace || V2IsSplat))) {
        return lowerShuffleAsLanePermuteAndSHUFP(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, DAG);
    }
    if V1IsInPlace || V2IsInPlace {
        return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if !(Subtarget.hasAVX2() && (V1IsInPlace || V2IsInPlace)) {
        if lowerShuffleAsLanePermuteAndRepeatedMask(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if Subtarget()() {
        if lowerShuffleWithEXPAND(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if Subtarget.hasAVX2() {
        return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    return lowerShuffleAsSplitOrBlend(DL, MVT { SimpleTy: v4f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV4I64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4i64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4i64, "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    assert!(Subtarget.hasAVX2(), "We can only lower v4i64 with AVX2!");
    if lowerV2X128Shuffle(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if Subtarget()() {
        if lowerShuffleAsShift(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
    }
    if V2.isUndef() {
        let mut RepeatedMask: SmallVector<int, 2> = zeroed();
        if is128BitLaneRepeatedShuffleMask(v4i64, Mask) {
            let mut PSHUFDMask: SmallVector<int, 4> = SmallVector<int, 4> {};
            narrowShuffleMaskElts(2, PSHUFDMask);
            return DAG.getBitcast(v4i64, DAG);
        }
        return DAG;
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if Subtarget()() {
        if lowerShuffleAsVALIGN(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithEXPAND(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    let mut V1IsInPlace: bool = isShuffleMaskInputInPlace(0, Mask);
    let mut V2IsInPlace: bool = isShuffleMaskInputInPlace(1, Mask);
    if V1IsInPlace || V2IsInPlace {
        return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlendAndPermute(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, DAG, false) {
        V;
    } else {
        return V;
    }
    if !V1IsInPlace && !V2IsInPlace {
        if lowerShuffleAsLanePermuteAndRepeatedMask(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Subtarget, DAG) {
            Result;
        } else {
            return Result;
        }
    }
    return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v4i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV8F32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8f32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8f32, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if !Subtarget.hasAVX2() {
        let mut InLaneMask: i32 = 0;
        computeInLaneShuffleMask(Mask, Mask.len / 2);
        if operator!(is128BitLaneRepeatedShuffleMask(v8f32)) {
            if splitAndLowerShuffle(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, DAG, true) {
                R;
            } else {
                return R;
            }
        }
    }
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return DAG.getBitcast(EVT { v8f32 }, ZExt);
    }
    let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    if is128BitLaneRepeatedShuffleMask(MVT { SimpleTy: v8f32 }, Mask, RepeatedMask) {
        assert!(RepeatedMask.len == 4, "Repeated masks must be half the mask width!");
        if isShuffleEquivalent(RepeatedMask, void { 0, 0, 2, 2 }, V1, V2) {
            return DAG;
        }
        if isShuffleEquivalent(RepeatedMask, void { 1, 1, 3, 3 }, V1, V2) {
            return DAG;
        }
        if V2.isUndef() {
            return DAG;
        }
        if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        return lowerShuffleWithSHUFPS(DL, v8f32, RepeatedMask, V1, V2, DAG);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() {
        if !is128BitLaneCrossingShuffleMask(MVT { SimpleTy: v8f32 }, Mask) {
            let mut VPermMask: SDValue = getConstVector(Mask, MVT { SimpleTy: v8i32 }, DAG, DL, true);
            return DAG;
        }
        if Subtarget.hasAVX2() {
            let mut VPermMask: SDValue = getConstVector(Mask, MVT { SimpleTy: v8i32 }, DAG, DL, true);
            return DAG;
        }
        return lowerShuffleAsLanePermuteAndShuffle(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, DAG, Subtarget);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    if Subtarget()() {
        if lowerShuffleWithEXPAND(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if (Subtarget.hasAVX2() || !(isFreeToSplitVector(peekThroughBitcasts(V1), DAG) || isFreeToSplitVector(peekThroughBitcasts(V2), DAG))) && !Subtarget.hasAVX512() {
        if lowerShufflePairAsUNPCKAndPermute(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    if !Subtarget.hasAVX512() && isUnpackWdShuffleMask(Mask, MVT { SimpleTy: v8f32 }, DAG) {
        return lowerShuffleAsSplitOrBlend(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    if Subtarget.hasAVX2() {
        return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    return lowerShuffleAsSplitOrBlend(DL, MVT { SimpleTy: v8f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV8I32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8i32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8i32, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    assert!(Subtarget.hasAVX2(), "We can only lower v8i32 with AVX2!");
    let mut NumV2Elements: i32 = count_if(Mask, Closure_95 {});
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if !Subtarget.hasAVX512() {
        if lowerShufflePairAsUNPCKAndPermute(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    if isUnpackWdShuffleMask(Mask, MVT { SimpleTy: v8i32 }, DAG) && !V2.isUndef() && !Subtarget.hasAVX512() {
        return lowerShuffleAsSplitOrBlend(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if Subtarget()() {
        if lowerShuffleAsShift(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
        if NumV2Elements == 0 {
            if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v8i32 }, V1, Mask, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
    }
    let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    let mut Is128BitLaneRepeatedShuffle: bool = is128BitLaneRepeatedShuffleMask(MVT { SimpleTy: v8i32 }, Mask, RepeatedMask);
    if Is128BitLaneRepeatedShuffle {
        assert!(RepeatedMask.len == 4, "Unexpected repeated mask size!");
        if V2.isUndef() {
            return DAG;
        }
        if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if operator!(Subtarget()()) && NumV2Elements == 0 {
        if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v8i32 }, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if Subtarget()() {
        if lowerShuffleAsVALIGN(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithEXPAND(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() {
        if lowerShuffleWithUNPCK256(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        let mut VPermMask: SDValue = getConstVector(Mask, MVT { SimpleTy: v8i32 }, DAG, DL, true);
        return DAG;
    }
    if Is128BitLaneRepeatedShuffle && isSingleSHUFPSMask(RepeatedMask) {
        let mut CastV1: SDValue = DAG.getBitcast(EVT { v8f32 }, V1);
        let mut CastV2: SDValue = DAG.getBitcast(EVT { v8f32 }, V2);
        let mut ShufPS: SDValue = lowerShuffleWithSHUFPS(DL, v8f32, RepeatedMask, CastV1, CastV2, DAG);
        return DAG.getBitcast(EVT { v8i32 }, ShufPS);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    return lowerShuffleAsDecomposedShuffleMerge(DL, MVT { SimpleTy: v8i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV16I16Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v16i16, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v16i16, "Bad operand type!");
    assert!(Mask.len == 16, "Unexpected mask size for v16 shuffle!");
    assert!(Subtarget.hasAVX2(), "We can only lower v16i16 with AVX2!");
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVTRUNC(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() {
        if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v16i16 }, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithUNPCK256(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        if is128BitLaneCrossingShuffleMask(MVT { SimpleTy: v16i16 }, Mask) {
            if lowerShuffleAsLanePermuteAndPermute(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, DAG, Subtarget) {
                V;
            } else {
                return V;
            }
            return lowerShuffleAsLanePermuteAndShuffle(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, DAG, Subtarget);
        }
        let mut RepeatedMask: SmallVector<int, 8> = zeroed();
        if is128BitLaneRepeatedShuffleMask(v16i16, Mask) {
            return lowerV8I16GeneralSingleInputShuffle(DL, v16i16, V1, Subtarget, DAG);
        }
    }
    if lowerShuffleWithPSHUFB(DL, MVT { SimpleTy: v16i16 }, Mask, V1, V2, Zeroable, Subtarget, DAG) {
        PSHUFB;
    } else {
        return PSHUFB;
    }
    if Subtarget()() {
        return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v16i16 }, Mask, V1, V2, Subtarget, DAG);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    if lowerShuffleAsLanePermuteAndPermute(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if !Subtarget.hasAVX512() {
        if lowerShufflePairAsUNPCKAndPermute(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    return lowerShuffleAsSplitOrBlend(DL, MVT { SimpleTy: v16i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV32I8Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v32i8, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v32i8, "Bad operand type!");
    assert!(Mask.len == 32, "Unexpected mask size for v32 shuffle!");
    assert!(Subtarget.hasAVX2(), "We can only lower v32i8 with AVX2!");
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleAsBroadcast(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVTRUNC(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if V2.isUndef() {
        if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v32i8 }, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() && is128BitLaneCrossingShuffleMask(MVT { SimpleTy: v32i8 }, Mask) {
        if lowerShuffleWithUNPCK256(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsLanePermuteAndPermute(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, DAG, Subtarget) {
            V;
        } else {
            return V;
        }
        return lowerShuffleAsLanePermuteAndShuffle(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, DAG, Subtarget);
    }
    if lowerShuffleWithPSHUFB(DL, MVT { SimpleTy: v32i8 }, Mask, V1, V2, Zeroable, Subtarget, DAG) {
        PSHUFB;
    } else {
        return PSHUFB;
    }
    if Subtarget()() {
        return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v32i8 }, Mask, V1, V2, Subtarget, DAG);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    if lowerShuffleAsLanePermuteAndPermute(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if Subtarget()() {
        if lowerShuffleAsVTRUNCAndUnpack(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Zeroable, DAG) {
            V;
        } else {
            return V;
        }
    }
    if !Subtarget.hasAVX512() {
        if lowerShufflePairAsUNPCKAndPermute(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    return lowerShuffleAsSplitOrBlend(DL, MVT { SimpleTy: v32i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lower256BitShuffle(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut NumV2Elements: i32 = count_if(Mask, Closure_96 { NumElts: NumElts });
    if NumV2Elements == 1 && Mask[0] >= NumElts {
        if lowerShuffleAsElementInsertion(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Insertion;
        } else {
            return Insertion;
        }
    }
    if lowerShuffleWithUndefHalf(DL, VT, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if VT.isInteger() && !Subtarget.hasAVX2() {
        let mut ElementBits: i32 = VT.getScalarSizeInBits();
        if ElementBits < 32 {
            if lowerShuffleAsBitMask(DL, VT, V1, V2, Mask, Zeroable, DAG) {
                V;
            } else {
                return V;
            }
            if lowerShuffleAsBitBlend(DL, VT, V1, V2, Mask, DAG) {
                V;
            } else {
                return V;
            }
            return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
        }
        let mut FpVT: MVT = getVectorVT(getFloatingPointVT(ElementBits), VT.getVectorNumElements());
        V1 = DAG.getBitcast(EVT { FpVT }, V1);
        V2 = DAG.getBitcast(EVT { FpVT }, V2);
        return DAG.getBitcast(EVT { VT }, DAG.getVectorShuffle(EVT { FpVT }, DL, V1, V2, Mask));
    }
    if VT == v16f16 || VT == v16bf16 {
        V1 = DAG.getBitcast(EVT { v16i16 }, V1);
        V2 = DAG.getBitcast(EVT { v16i16 }, V2);
        return DAG.getBitcast(EVT { VT }, DAG.getVectorShuffle(EVT { v16i16 }, DL, V1, V2, Mask));
    }
    match VT.SimpleTy {
        v4f64 => {
            return lowerV4F64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v4i64 => {
            return lowerV4I64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8f32 => {
            return lowerV8F32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8i32 => {
            return lowerV8I32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v16i16 => {
            return lowerV16I16Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v32i8 => {
            return lowerV32I8Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        _ => {
            llvm_unreachable_internal("Not a valid 256-bit x86 vector type!", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 17652);
        },
    }
}

fn lowerV4X128Shuffle(DL: *SDLoc, VT: MVT, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT.getScalarSizeInBits() == 64, "Unexpected element type size for 128bit shuffle.");
    assert!(VT.is512BitVector(), "Unexpected vector size for 512bit shuffle.");
    let mut Widened128Mask: SmallVector<int, 4> = SmallVector<int, 4> {};
    if !canWidenShuffleElements(Mask, Widened128Mask) {
        return SDValue {};
    }
    assert!(Widened128Mask.len == 4, "Shuffle widening mismatch");
    if Widened128Mask[0] == 0 && (Zeroable & 240) == 240 && (Widened128Mask[1] == 1 || (Zeroable & 12) == 12) {
        let mut NumElts: u32 = if ((Zeroable & 12) == 12) { 2 } else { 4 };
        let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), NumElts);
        let mut LoV: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { SubVT }, V1, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, EVT { VT }, getZeroVector(VT, Subtarget, DAG, DL), LoV, DAG.getVectorIdxConstant(0, DL, false));
    }
    let mut OnlyUsesV1: bool = isShuffleEquivalent(Mask, ArrayRef<int> { [0, 1, 2, 3, 0, 1, 2, 3] }, V1, V2);
    if OnlyUsesV1 || isShuffleEquivalent(Mask, ArrayRef<int> { [0, 1, 2, 3, 8, 9, 10, 11] }, V1, V2) {
        let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), 4);
        let mut SubVec: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { SubVT }, if OnlyUsesV1 { V1 } else { V2 }, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, EVT { VT }, V1, SubVec, DAG.getVectorIdxConstant(4, DL, false));
    }
    let mut IsInsert: bool = true;
    let mut V2Index: i32 = -1;
    for let mut i: i32 = 0; i < 4; i += 1 {
        assert!(Widened128Mask[i] >= -1, "Illegal shuffle sentinel value");
        if Widened128Mask[i] < 0 {
            continue;
        }
        if Widened128Mask[i] < 4 {
            if Widened128Mask[i] != i {
                IsInsert = false;
                break;
            }
        } else {
            if V2Index >= 0 || Widened128Mask[i] != 4 {
                IsInsert = false;
                break;
            }
            V2Index = i;
        }
    }
    if IsInsert && V2Index >= 0 {
        let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), 2);
        let mut Subvec: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { SubVT }, V2, DAG.getVectorIdxConstant(0, DL, false));
        return insert128BitVector(V1, Subvec, V2Index * 2, DAG, DL);
    }
    let mut Widened256Mask: SmallVector<int, 2> = zeroed();
    if canWidenShuffleElements(Widened128Mask) {
        Widened128Mask.clear();
        narrowShuffleMaskElts(2, Widened128Mask);
    }
    let mut Ops: [2]SDValue = [DAG.getUNDEF(EVT { VT }), DAG.getUNDEF(EVT { VT })];
    let mut PermMask: [4]i32 = [-1, -1, -1, -1];
    for let mut i: i32 = 0; i < 4; i += 1 {
        assert!(Widened128Mask[i] >= -1, "Illegal shuffle sentinel value");
        if Widened128Mask[i] < 0 {
            continue;
        }
        let mut Op: SDValue = if Widened128Mask[i] >= 4 { V2 } else { V1 };
        let mut OpIndex: u32 = i / 2;
        if Ops[OpIndex].isUndef() {
            Ops[OpIndex] = Op;
        } else if Ops[OpIndex] != Op {
            return SDValue {};
        }
        PermMask[i] = Widened128Mask[i] % 4;
    }
    return DAG;
}

fn lowerV8F64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8f64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8f64, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    if V2.isUndef() {
        if isShuffleEquivalent(Mask, ArrayRef<int> { [0, 0, 2, 2, 4, 4, 6, 6] }, V1, V2) {
            return DAG;
        }
        if !is128BitLaneCrossingShuffleMask(MVT { SimpleTy: v8f64 }, Mask) {
            let mut VPERMILPMask: u32 = (Mask[0] == 1) | ((Mask[1] == 1) << 1) | ((Mask[2] == 3) << 2) | ((Mask[3] == 3) << 3) | ((Mask[4] == 5) << 4) | ((Mask[5] == 5) << 5) | ((Mask[6] == 7) << 6) | ((Mask[7] == 7) << 7);
            return DAG;
        }
        let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
        if is256BitLaneRepeatedShuffleMask(MVT { SimpleTy: v8f64 }, Mask, RepeatedMask) {
            return DAG;
        }
    }
    if lowerV4X128Shuffle(DL, MVT { SimpleTy: v8f64 }, Mask, Zeroable, V1, V2, Subtarget, DAG) {
        Shuf128;
    } else {
        return Shuf128;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v8f64 }, V1, V2, Mask, DAG) {
        Unpck;
    } else {
        return Unpck;
    }
    if lowerShuffleWithSHUFPD(DL, MVT { SimpleTy: v8f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Op;
    } else {
        return Op;
    }
    if lowerShuffleWithEXPAND(DL, MVT { SimpleTy: v8f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v8f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsVALIGN(DL, MVT { SimpleTy: v8f64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v8f64 }, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV16F32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v16f32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v16f32, "Bad operand type!");
    assert!(Mask.len == 16, "Unexpected mask size for v16 shuffle!");
    let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    if is128BitLaneRepeatedShuffleMask(MVT { SimpleTy: v16f32 }, Mask, RepeatedMask) {
        assert!(RepeatedMask.len == 4, "Unexpected repeated mask size!");
        if isShuffleEquivalent(RepeatedMask, void { 0, 0, 2, 2 }, V1, V2) {
            return DAG;
        }
        if isShuffleEquivalent(RepeatedMask, void { 1, 1, 3, 3 }, V1, V2) {
            return DAG;
        }
        if V2.isUndef() {
            return DAG;
        }
        if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v16f32 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsBlend(DL, MVT { SimpleTy: v16f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
        return lowerShuffleWithSHUFPS(DL, v16f32, RepeatedMask, V1, V2, DAG);
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v16f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return DAG.getBitcast(EVT { v16f32 }, ZExt);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v16f32 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() && !is128BitLaneCrossingShuffleMask(MVT { SimpleTy: v16f32 }, Mask) {
        let mut VPermMask: SDValue = getConstVector(Mask, MVT { SimpleTy: v16i32 }, DAG, DL, true);
        return DAG;
    }
    if lowerShuffleWithEXPAND(DL, MVT { SimpleTy: v16f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVALIGN(DL, MVT { SimpleTy: v16f32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v16f32 }, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV8I64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8i64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8i64, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    if Subtarget()() {
        if lowerShuffleAsShift(DL, MVT { SimpleTy: v8i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
    }
    if V2.isUndef() {
        let mut Repeated128Mask: SmallVector<int, 2> = zeroed();
        if is128BitLaneRepeatedShuffleMask(v8i64, Mask) {
            let mut PSHUFDMask: SmallVector<int, 4> = SmallVector<int, 4> {};
            narrowShuffleMaskElts(2, PSHUFDMask);
            return DAG.getBitcast(v8i64, DAG);
        }
        let mut Repeated256Mask: SmallVector<int, 4> = SmallVector<int, 4> {};
        if is256BitLaneRepeatedShuffleMask(MVT { SimpleTy: v8i64 }, Mask, Repeated256Mask) {
            return DAG;
        }
    }
    if lowerV4X128Shuffle(DL, MVT { SimpleTy: v8i64 }, Mask, Zeroable, V1, V2, Subtarget, DAG) {
        Shuf128;
    } else {
        return Shuf128;
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v8i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsVALIGN(DL, MVT { SimpleTy: v8i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if Subtarget()() {
        if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v8i64 }, V1, V2, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v8i64 }, V1, V2, Mask, DAG) {
        Unpck;
    } else {
        return Unpck;
    }
    if lowerShuffleWithEXPAND(DL, MVT { SimpleTy: v8i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v8i64 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v8i64 }, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV16I32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v16i32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v16i32, "Bad operand type!");
    assert!(Mask.len == 16, "Unexpected mask size for v16 shuffle!");
    let mut NumV2Elements: i32 = count_if(Mask, Closure_97 {});
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if Subtarget()() {
        if lowerShuffleAsShift(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
        if NumV2Elements == 0 {
            if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v16i32 }, V1, Mask, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
    }
    let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    let mut Is128BitLaneRepeatedShuffle: bool = is128BitLaneRepeatedShuffleMask(MVT { SimpleTy: v16i32 }, Mask, RepeatedMask);
    if Is128BitLaneRepeatedShuffle {
        assert!(RepeatedMask.len == 4, "Unexpected repeated mask size!");
        if V2.isUndef() {
            return DAG;
        }
        if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if operator!(Subtarget()()) && NumV2Elements != 0 {
        if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v16i32 }, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if lowerShuffleAsVALIGN(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if Subtarget()() {
        if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if Is128BitLaneRepeatedShuffle && isSingleSHUFPSMask(RepeatedMask) {
        let mut CastV1: SDValue = DAG.getBitcast(EVT { v16f32 }, V1);
        let mut CastV2: SDValue = DAG.getBitcast(EVT { v16f32 }, V2);
        let mut ShufPS: SDValue = lowerShuffleWithSHUFPS(DL, v16f32, RepeatedMask, CastV1, CastV2, DAG);
        return DAG.getBitcast(EVT { v16i32 }, ShufPS);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithEXPAND(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v16i32 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v16i32 }, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV32I16Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v32i16, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v32i16, "Bad operand type!");
    assert!(Mask.len == 32, "Unexpected mask size for v32 shuffle!");
    (((operator!(operator!((Subtarget()() && "We can only lower v32i16 with AVX-512-BWI!")))) || (_wassert(L"Subtarget.hasBWI() && \"We can only lower v32i16 with AVX-512-BWI!\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (18073) as u32) , 0)) as void);
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v32i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v32i16 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, MVT { SimpleTy: v32i16 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v32i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v32i16 }, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if V2.isUndef() {
        if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v32i16 }, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        let mut RepeatedMask: SmallVector<int, 8> = zeroed();
        if is128BitLaneRepeatedShuffleMask(v32i16, Mask) {
            return lowerV8I16GeneralSingleInputShuffle(DL, v32i16, V1, Subtarget, DAG);
        }
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v32i16 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleWithPSHUFB(DL, MVT { SimpleTy: v32i16 }, Mask, V1, V2, Zeroable, Subtarget, DAG) {
        PSHUFB;
    } else {
        return PSHUFB;
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, MVT { SimpleTy: v32i16 }, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v32i16 }, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV64I8Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v64i8, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v64i8, "Bad operand type!");
    assert!(Mask.len == 64, "Unexpected mask size for v64 shuffle!");
    (((operator!(operator!((Subtarget()() && "We can only lower v64i8 with AVX-512-BWI!")))) || (_wassert(L"Subtarget.hasBWI() && \"We can only lower v64i8 with AVX-512-BWI!\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (18143) as u32) , 0)) as void);
    if lowerShuffleAsZeroOrAnyExtend(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleWithUNPCK(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsShift(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if V2.isUndef() {
        if lowerShuffleAsBitRotate(DL, MVT { SimpleTy: v64i8 }, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if lowerShuffleAsBitMask(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Zeroable, DAG) {
        Masked;
    } else {
        return Masked;
    }
    if lowerShuffleWithPSHUFB(DL, MVT { SimpleTy: v64i8 }, Mask, V1, V2, Zeroable, Subtarget, DAG) {
        PSHUFB;
    } else {
        return PSHUFB;
    }
    if operator!(Subtarget()()) {
        if lowerShuffleAsRepeatedMaskAndLanePermute(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsLanePermuteAndPermute(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, DAG, Subtarget) {
        Result;
    } else {
        return Result;
    }
    if lowerShuffleAsBlend(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if !is128BitLaneCrossingShuffleMask(MVT { SimpleTy: v64i8 }, Mask) {
        if lowerShuffleAsByteRotateAndPermute(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
        if Subtarget()() {
            return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v64i8 }, Mask, V1, V2, Subtarget, DAG);
        }
        let mut V1InUse: bool = false;
        let mut V2InUse: bool = false;
        return lowerShuffleAsBlendOfPSHUFBs(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Zeroable, DAG, V1InUse, V2InUse);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    if Subtarget()() {
        return lowerShuffleWithPERMV(DL, MVT { SimpleTy: v64i8 }, Mask, V1, V2, Subtarget, DAG);
    }
    return splitAndLowerShuffle(DL, MVT { SimpleTy: v64i8 }, V1, V2, Mask, DAG, false);
}

fn lower512BitShuffle(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Subtarget.hasAVX512(), "Cannot lower 512-bit vectors w/ basic ISA!");
    let mut NumElts: i32 = Mask.len;
    let mut NumV2Elements: i32 = count_if(Mask, Closure_98 { NumElts: NumElts });
    if NumV2Elements == 1 && Mask[0] >= NumElts {
        if lowerShuffleAsElementInsertion(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Insertion;
        } else {
            return Insertion;
        }
    }
    if lowerShuffleWithUndefHalf(DL, VT, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBroadcast(DL, VT, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if (VT == v32i16 || VT == v64i8) && operator!(Subtarget()()) {
        if lowerShuffleAsBitMask(DL, VT, V1, V2, Mask, Zeroable, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsBitBlend(DL, VT, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
    }
    if VT == v32f16 || VT == v32bf16 {
        if operator!(Subtarget()()) {
            return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
        }
        V1 = DAG.getBitcast(EVT { v32i16 }, V1);
        V2 = DAG.getBitcast(EVT { v32i16 }, V2);
        return DAG.getBitcast(EVT { VT }, DAG.getVectorShuffle(EVT { v32i16 }, DL, V1, V2, Mask));
    }
    match VT.SimpleTy {
        v8f64 => {
            return lowerV8F64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v16f32 => {
            return lowerV16F32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8i64 => {
            return lowerV8I64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v16i32 => {
            return lowerV16I32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v32i16 => {
            return lowerV32I16Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v64i8 => {
            return lowerV64I8Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        _ => {
            llvm_unreachable_internal("Not a valid 512-bit x86 vector type!", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 18312);
        },
    }
}

fn lower1BitShuffleAsKSHIFTR(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if !V2.isUndef() {
        return SDValue {};
    }
    let mut ShiftAmt: i32 = -1;
    let mut NumElts: i32 = Mask.len;
    for let mut i: i32 = 0; i != NumElts; i += 1 {
        let mut M: i32 = Mask[i];
        assert!((M == SM_SentinelUndef || (0 <= M && M < NumElts)), "Unexpected mask index.");
        if M < 0 {
            continue;
        }
        if ShiftAmt < 0 {
            ShiftAmt = M - i;
            if ShiftAmt <= 0 {
                return SDValue {};
            }
        }
        if ShiftAmt != M - i {
            return SDValue {};
        }
    }
    assert!(ShiftAmt >= 0, "All undef?");
    let mut Res: SDValue = widenMaskVector(V1, false, Subtarget, DAG, DL);
    Res = DAG;
    return DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { VT }, Res, DAG.getVectorIdxConstant(0, DL, false));
}

fn match1BitShuffleAsKSHIFT(Opcode: *mut u32, Mask: ArrayRef<int>, MaskOffset: i32, Zeroable: *APInt) -> i32 {
    let mut Size: i32 = Mask.len;
    let mut CheckZeros: Closure_99 = Closure_99 { Zeroable: &mut Zeroable, Size: &mut Size };
    let mut MatchShift: Closure_100 = Closure_100 { Size: &mut Size, Mask: &mut Mask, MaskOffset: &mut MaskOffset };
    for let mut Shift: i32 = 1; Shift != Size; Shift += 1 {
        for Left in [true, false] {
            if CheckZeros.call(Shift, Left) && MatchShift.call(Shift, Left) {
                return Shift;
            }
        }
    }
    return -1;
}

fn lower1BitShuffle(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Subtarget.hasAVX512(), "Cannot lower 512-bit vectors w/o basic ISA!");
    let mut NumElts: i32 = Mask.len;
    let mut NumV2Elements: i32 = count_if(Mask, Closure_101 { NumElts: NumElts });
    let mut SubvecElts: i32 = 0;
    let mut Src: i32 = -1;
    for let mut i: i32 = 0; i != NumElts; i += 1 {
        if Mask[i] >= 0 {
            if Src < 0 {
                Src = Mask[i] / NumElts;
            }
            if Src != (Mask[i] / NumElts) || (Mask[i] % NumElts) != i {
                break;
            }
        }
        SubvecElts += 1;
    }
    assert!(SubvecElts != NumElts, "Identity shuffle?");
    SubvecElts = bit_floor(SubvecElts);
    if Zeroable.countl_one() as i32 >= (NumElts - SubvecElts) {
        assert!(Src >= 0, "Expected a source!");
        let mut ExtractVT: MVT = getVectorVT(MVT { SimpleTy: i1 }, SubvecElts);
        let mut Extract: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { ExtractVT }, if Src == 0 { V1 } else { V2 }, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, EVT { VT }, DAG.getConstant(0, DL, EVT { VT }, false, false), Extract, DAG.getVectorIdxConstant(0, DL, false));
    }
    if lower1BitShuffleAsKSHIFTR(DL, Mask, VT, V1, V2, Subtarget, DAG) {
        Shift;
    } else {
        return Shift;
    }
    let mut Offset: u32 = 0;
    if NumV2Elements == 0 && V1.getOpcode() == SETCC && operator(V1).hasOneUse() {
        let mut Op0: SDValue = V1.getOperand(0);
        let mut Op1: SDValue = V1.getOperand(1);
        let mut CC: CondCode = cast(V1.getOperand(2))();
        let mut OpVT: EVT = Op0.getValueType();
        if OpVT.getScalarSizeInBits() >= 32 || isBroadcastShuffleMask(Mask) {
            return DAG.getSetCC(DL, EVT { VT }, DAG.getVectorShuffle(OpVT, DL, Op0, DAG.getUNDEF(OpVT), Mask), DAG.getVectorShuffle(OpVT, DL, Op1, DAG.getUNDEF(OpVT), Mask), CC, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    let mut IsBlendWithZero: bool = all_of(enumerate(Mask), Closure_102 { Zeroable: &mut Zeroable });
    if IsBlendWithZero {
        let mut Width: u32 = max(NumElts, 8);
        let mut IntVT: MVT = getIntegerVT(Width);
        let mut MaskValue: APInt = (operator(Zeroable)).zextOrTrunc(Width);
        let mut MaskNode: SDValue = DAG.getConstant(MaskValue, DL, EVT { IntVT }, false, false);
        let mut MaskVecVT: MVT = getVectorVT(MVT { SimpleTy: i1 }, Width);
        let mut MaskVecNode: SDValue = DAG.getBitcast(EVT { MaskVecVT }, MaskNode);
        let mut MaskVec: SDValue = DAG.getExtractSubvector(DL, EVT { VT }, MaskVecNode, 0);
        return DAG.getNode(AND, DL, EVT { VT }, V1, MaskVec);
    }
    let mut ExtVT: MVT = MVT {};
    match VT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Expected a vector of i1 elements", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 18502);
        },
        v2i1 => {
            ExtVT = MVT { SimpleTy: v2i64 };
        },
        v4i1 => {
            ExtVT = MVT { SimpleTy: v4i32 };
        },
        v8i1 => {
            ExtVT = if Subtarget()() { v8i32 } else { v8i64 };
        },
        v16i1 => {
            ExtVT = MVT { SimpleTy: if Subtarget.canExtendTo512DQ() { v16i32 } else { v16i16 } };
        },
        v32i1 => {
            (((operator!(operator!((Subtarget()() && "Expected AVX512BW support")))) || (_wassert(L"Subtarget.hasBWI() && \"Expected AVX512BW support\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (18522) as u32) , 0)) as void);
        },
        v64i1 => {
            if !Subtarget.useBWIRegs() {
                return SDValue {};
            }
        },
    }
    V1 = DAG.getNode(SIGN_EXTEND, DL, EVT { ExtVT }, V1);
    V2 = DAG.getNode(SIGN_EXTEND, DL, EVT { ExtVT }, V2);
    let mut Shuffle: SDValue = DAG.getVectorShuffle(EVT { ExtVT }, DL, V1, V2, Mask);
    let mut NumElems: i32 = VT.getVectorNumElements();
    if (Subtarget()() && (NumElems >= 32)) || (Subtarget()() && (NumElems < 32)) {
        return DAG.getSetCC(DL, EVT { VT }, DAG.getConstant(0, DL, EVT { ExtVT }, false, false), Shuffle, SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    return DAG.getNode(TRUNCATE, DL, EVT { VT }, Shuffle);
}

fn canonicalizeShuffleMaskWithCommute(Mask: ArrayRef<int>) -> bool {
    let mut NumElements: i32 = Mask.len;
    let mut NumV1Elements: i32 = 0;
    let mut NumV2Elements: i32 = 0;
    for M in Mask {
        if M < 0 {
            continue;
        } else if M < NumElements {
            NumV1Elements += 1;
        } else {
            NumV2Elements += 1;
        }
    }
    if NumV2Elements > NumV1Elements {
        return true;
    }
    assert!(NumV1Elements > 0, "No V1 indices");
    if NumV2Elements == 0 {
        return false;
    }
    if NumV1Elements == NumV2Elements {
        let mut LowV1Elements: i32 = 0;
        let mut LowV2Elements: i32 = 0;
        for M in Mask.slice(0, NumElements / 2) {
            if M >= NumElements {
                LowV2Elements += 1;
            } else if M >= 0 {
                LowV1Elements += 1;
            }
        }
        if LowV2Elements > LowV1Elements {
            return true;
        }
        if LowV2Elements == LowV1Elements {
            let mut SumV1Indices: i32 = 0;
            let mut SumV2Indices: i32 = 0;
            for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
                if Mask[i] >= NumElements {
                    SumV2Indices += i;
                } else if Mask[i] >= 0 {
                    SumV1Indices += i;
                }
            }
            if SumV2Indices < SumV1Indices {
                return true;
            }
            if SumV2Indices == SumV1Indices {
                let mut NumV1OddIndices: i32 = 0;
                let mut NumV2OddIndices: i32 = 0;
                for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
                    if Mask[i] >= NumElements {
                        NumV2OddIndices += i % 2;
                    } else if Mask[i] >= 0 {
                        NumV1OddIndices += i % 2;
                    }
                }
                if NumV2OddIndices < NumV1OddIndices {
                    return true;
                }
            }
        }
    }
    return false;
}

fn canCombineAsMaskOperation(V: SDValue, Subtarget: *X86Subtarget) -> bool {
    if !Subtarget.hasAVX512() {
        return false;
    }
    if !V.getValueType().isSimple() {
        return false;
    }
    let mut VT: MVT = V.getSimpleValueType().getScalarType();
    if (VT == i16 || VT == i8) && operator!(Subtarget()()) {
        return false;
    }
    if (VT == i16 || VT == i8) && V.getSimpleValueType().getSizeInBits().operator unsigned long long() < 512 {
        return false;
    }
    let mut HasMaskOperation: Closure_103 = Closure_103 {};
    if HasMaskOperation.call(V) {
        return true;
    }
    return false;
}

fn lowerVECTOR_SHUFFLE(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut SVOp: *mut ShuffleVectorSDNode = cast(Op);
    let mut OrigMask: ArrayRef<int> = SVOp.getMask();
    let mut V1: SDValue = Op.getOperand(0);
    let mut V2: SDValue = Op.getOperand(1);
    let mut VT: MVT = Op.getSimpleValueType();
    let mut NumElements: i32 = VT.getVectorNumElements();
    let mut DL: SDLoc = SDLoc { Op };
    let mut Is1BitVector: bool = (VT.getVectorElementType() == i1);
    assert!((VT.getSizeInBits().operator unsigned long long() != 64 || Is1BitVector), "Can't lower MMX shuffles");
