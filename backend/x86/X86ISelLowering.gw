            for let mut i: i32 = 0;
let mut e: i32 = M1.len; i != e; i += 1 {
                if M1[i] >= 0 && M2[i] >= 0 && M1[i] != M2[i] {
                    return false;
                }
            }
            return true;
        }

struct Closure_88 {}

fn Closure_88::call(self: *Closure_88, Mask: ArrayRef<int>, MergedMask: MutableArrayRef<int>) {
