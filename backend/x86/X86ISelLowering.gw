let mut e: i32 = MergedMask.len; i != e; i += 1 {
                let mut M: i32 = Mask[i];
                if M < 0 {
                    continue;
                }
                assert!((MergedMask[i] < 0 || MergedMask[i] == M), "Unexpected mask element");
                MergedMask[i] = M;
            }
        }

struct Closure_89 {
