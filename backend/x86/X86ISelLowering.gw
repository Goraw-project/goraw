    let mut DL: SDLoc = SDLoc { Op };
    let mut CV: SDValue = TLO.DAG(get(), BCVT);
    let mut LegalCV: SDValue = self.LowerConstantPool(CV, TLO.DAG);
    let mut NewMask: SDValue = TLO.DAG(BCVT, DL, TLO.DAG.getEntryNode(), LegalCV, getConstantPool(TLO.DAG.getMachineFunction()));
    return TLO.CombineTo(Mask, TLO.DAG.getBitcast(Mask.getValueType(), NewMask));
}

