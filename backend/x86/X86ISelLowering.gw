            Hi = getTargetVShiftNode(ShiftX86Opc, DL, ExtVT, Hi, BaseRotAmt, BaseRotAmtIdx, Subtarget, DAG);
            return getPack(DAG, Subtarget, DL, VT, Lo, Hi, IsROTL);
