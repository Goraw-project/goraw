unsafe fn Closure_23::call(self: *mut Closure_23, Val: *APInt) -> auto {
        if (*self.VT).isFloatingPoint() {
            if (*self.ScalarSize) == 16 {
                return get((*self.C), APFloat { IEEEhalf(), Val });
            }
            if (*self.ScalarSize) == 32 {
                return get((*self.C), APFloat { IEEEsingle(), Val });
            }
            assert!((*self.ScalarSize) == 64, "Unsupported floating point scalar size");
            return get((*self.C), APFloat { IEEEdouble(), Val });
        }
        return getIntegerValue((*self.Ty), Val);
    }

