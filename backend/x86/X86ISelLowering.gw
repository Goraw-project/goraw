// ========================================================

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: isBF16orSoftF16]
// template <typename T>
// fn isBF16orSoftF16(VT: EVT, Subtarget: *X86Subtarget) -> bool {
//     let mut EltVT: EVT = VT.getScalarType();
//     return EltVT == bf16 || (EltVT == f16 && !Subtarget.hasFP16());
// }
// ========================================================

fn lowerShuffleAsElementInsertion(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut ExtVT: MVT = VT;
    let mut EltVT: MVT = VT.getVectorElementType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    if isSoftF16(EltVT, Subtarget) {
        return SDValue {};
    }
    let mut V2Index: i32 = find_if(Mask, Closure_51 { Mask: &mut Mask }) - Mask.begin();
    let mut IsV1Constant: bool = getTargetConstantFromNode(V1) != null;
    let mut IsV1Zeroable: bool = true;
    for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
        if i != V2Index && !Zeroable[i] {
            IsV1Zeroable = false;
            break;
        }
    }
    if !IsV1Zeroable {
        let mut V1Mask: SmallVector<int, 8> = Mask;
        V1Mask[V2Index] = -1;
        if !isNoopShuffleMask(V1Mask) {
            return SDValue {};
        }
    }
    let mut V2S: SDValue = getScalarValueForVectorElement(V2, Mask[V2Index] - Mask.len, DAG);
    if V2S && DAG.getTargetLoweringInfo().isTypeLegal(V2S.getValueType()) {
        V2S = DAG.getBitcast(EltVT, V2S);
        if EltVT == i8 || (EltVT == i16 && !Subtarget.hasFP16()) {
            if !IsV1Zeroable && !(IsV1Constant && V2Index == 0) {
                return SDValue {};
            }
            ExtVT = getVectorVT(i32, ExtVT.getSizeInBits().operator unsigned long long() / 32);
            V2S = DAG.getNode(ZERO_EXTEND, DL, i32, V2S);
            if !IsV1Zeroable {
                let mut Bits: SmallVector<APInt> = SmallVector<APInt> { NumElts, getAllOnes(EltBits) };
                Bits[V2Index] = getZero(EltBits);
                let mut BitMask: SDValue = getConstVector(Bits, VT, DAG, DL);
                V1 = DAG.getNode(AND, DL, VT, V1, BitMask);
                V2 = DAG.getNode(SCALAR_TO_VECTOR, DL, ExtVT, V2S);
                V2 = DAG.getBitcast(VT, DAG.getNode(VZEXT_MOVL, DL, ExtVT, V2));
                return DAG.getNode(OR, DL, VT, V1, V2);
            }
        }
        V2 = DAG.getNode(SCALAR_TO_VECTOR, DL, ExtVT, V2S);
    } else if Mask[V2Index] != Mask.len as i32 || EltVT == i8 || (EltVT == i16 && !Subtarget.hasAVX10_2()) {
        return SDValue {};
    }
    if !IsV1Zeroable {
        assert!(VT == ExtVT, "Cannot change extended type when non-zeroable!");
        if !VT.isFloatingPoint() || V2Index != 0 {
            return SDValue {};
        }
        if !VT.is128BitVector() {
            return SDValue {};
        }
        let mut MovOpc: u32 = 0;
        if EltVT == f16 {
            MovOpc = MOVSH;
        } else if EltVT == f32 {
            MovOpc = MOVSS;
        } else if EltVT == f64 {
            MovOpc = MOVSD;
        } else {
            llvm_unreachable_internal("Unsupported floating point element type to handle!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 13221);
        }
        return DAG.getNode(MovOpc, DL, ExtVT, V1, V2);
    }
    if VT.isFloatingPoint() && V2Index != 0 {
        return SDValue {};
    }
    V2 = DAG.getNode(VZEXT_MOVL, DL, ExtVT, V2);
    if ExtVT != VT {
        V2 = DAG.getBitcast(VT, V2);
    }
    if V2Index != 0 {
        if VT.isFloatingPoint() || NumElts <= 4 {
            let mut V2Shuffle: SmallVector<int, 4> = SmallVector<int, 4> { Mask.len, 1 };
            V2Shuffle[V2Index] = 0;
            V2 = DAG.getVectorShuffle(VT, DL, V2, DAG.getUNDEF(VT), V2Shuffle);
        } else {
            V2 = DAG.getBitcast(v16i8, V2);
            V2 = DAG.getNode(VSHLDQ, DL, v16i8, V2, DAG.getTargetConstant(V2Index * EltBits / 8, DL, i8, false));
            V2 = DAG.getBitcast(VT, V2);
        }
    }
    return V2;
}

fn lowerShuffleAsTruncBroadcast(DL: *SDLoc, VT: MVT, V0: SDValue, BroadcastIdx: i32, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Subtarget.hasAVX2(), "We can only lower integer broadcasts with AVX2!");
    let mut EltVT: MVT = VT.getVectorElementType();
    let mut V0VT: MVT = V0.getSimpleValueType();
    assert!(VT.isInteger(), "Unexpected non-integer trunc broadcast!");
    assert!(V0VT.isVector(), "Unexpected non-vector vector-sized value!");
    let mut V0EltVT: MVT = V0VT.getVectorElementType();
    if !V0EltVT.isInteger() {
        return SDValue {};
    }
    let mut EltSize: u32 = EltVT.getSizeInBits().operator unsigned long long();
    let mut V0EltSize: u32 = V0EltVT.getSizeInBits().operator unsigned long long();
    if V0EltSize <= EltSize {
        return SDValue {};
    }
    assert!(((V0EltSize % EltSize) == 0), "Scalar type sizes must all be powers of 2 on x86!");
    let mut V0Opc: u32 = V0.getOpcode();
    let mut Scale: u32 = V0EltSize / EltSize;
    let mut V0BroadcastIdx: u32 = BroadcastIdx / Scale;
    if (V0Opc != SCALAR_TO_VECTOR || V0BroadcastIdx != 0) && V0Opc != BUILD_VECTOR {
        return SDValue {};
    }
    let mut Scalar: SDValue = V0.getOperand(V0BroadcastIdx);
    if BroadcastIdx % Scale {
        OffsetIdx;
    } else {
        Scalar = DAG.getNode(SRL, DL, Scalar.getValueType(), Scalar, DAG.getConstant(OffsetIdx * EltSize, DL, i8, false, false));
    }
    return DAG.getNode(VBROADCAST, DL, VT, DAG.getNode(TRUNCATE, DL, EltVT, Scalar));
}

fn isSingleSHUFPSMask(Mask: ArrayRef<int>) -> bool {
    assert!(Mask.len == 4, "Unsupported mask size!");
    assert!(Mask[0] >= -1 && Mask[0] < 8, "Out of bound mask element!");
    assert!(Mask[1] >= -1 && Mask[1] < 8, "Out of bound mask element!");
    assert!(Mask[2] >= -1 && Mask[2] < 8, "Out of bound mask element!");
    assert!(Mask[3] >= -1 && Mask[3] < 8, "Out of bound mask element!");
    if Mask[0] >= 0 && Mask[1] >= 0 && (Mask[0] < 4) != (Mask[1] < 4) {
        return false;
    }
    if Mask[2] >= 0 && Mask[3] >= 0 && (Mask[2] < 4) != (Mask[3] < 4) {
        return false;
    }
    return true;
}

fn isShuffleMaskInputInPlace(Input: i32, Mask: ArrayRef<int>) -> bool {
    assert!((Input == 0 || Input == 1), "Only two inputs to shuffles.");
    let mut Size: i32 = Mask.len;
    for let mut i: i32 = 0; i < Size; i += 1 {
        if Mask[i] >= 0 && Mask[i] / Size == Input && Mask[i] % Size != i {
            return false;
        }
    }
    return true;
}

fn isShuffleMaskInputBroadcastable(Input: i32, Mask: ArrayRef<int>, BroadcastableElement: i32) -> bool {
    assert!((Input == 0 || Input == 1), "Only two inputs to shuffles.");
    let mut Size: i32 = Mask.len;
    for let mut i: i32 = 0; i < Size; i += 1 {
        if Mask[i] >= 0 && Mask[i] / Size == Input && Mask[i] % Size != BroadcastableElement {
            return false;
        }
    }
    return true;
}

fn lowerShuffleOfExtractsAsVperm(DL: *SDLoc, N0: SDValue, N1: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = N0.getSimpleValueType();
    assert!((VT.is128BitVector() && (VT.getScalarSizeInBits() == 32 || VT.getScalarSizeInBits() == 64)), "VPERM* family of shuffles requires 32-bit or 64-bit elements");
    if N0.getOpcode() != EXTRACT_SUBVECTOR || N1.getOpcode() != EXTRACT_SUBVECTOR || N0.getOperand(0) != N1.getOperand(0) || !N0.hasOneUse() || !N1.hasOneUse() {
        return SDValue {};
    }
    let mut WideVec: SDValue = N0.getOperand(0);
    let mut WideVT: MVT = WideVec.getSimpleValueType();
    if !WideVT.is256BitVector() {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut NewMask: SmallVector<int, 4> = Mask;
    let mut ExtIndex0: *APInt = N0.getConstantOperandAPInt(1);
    let mut ExtIndex1: *APInt = N1.getConstantOperandAPInt(1);
    if ExtIndex1 == 0 && ExtIndex0 == NumElts {
        commuteMask(NewMask);
    } else if ExtIndex0 != 0 || ExtIndex1 != NumElts {
        return SDValue {};
    }
    if NumElts == 4 && (isSingleSHUFPSMask(NewMask) || is128BitUnpackShuffleMask(NewMask, DAG)) {
        return SDValue {};
    }
    NewMask.append(NumElts, -1);
    let mut Shuf: SDValue = DAG.getVectorShuffle(WideVT, DL, WideVec, DAG.getUNDEF(WideVT), NewMask);
    return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Shuf, DAG.getVectorIdxConstant(0, DL, false));
}

fn lowerShuffleAsBroadcast(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut EltVT: MVT = VT.getVectorElementType();
    if !((Subtarget.hasSSE3() && VT == v2f64) || (Subtarget.hasAVX() && (EltVT == f64 || EltVT == f32)) || (Subtarget.hasAVX2() && (VT.isInteger() || EltVT == f16))) {
        return SDValue {};
    }
    let mut NumEltBits: u32 = VT.getScalarSizeInBits();
    let mut Opcode: u32 = if (VT == v2f64 && !Subtarget.hasAVX2()) { MOVDDUP } else { VBROADCAST };
    let mut BroadcastFromReg: bool = (Opcode == MOVDDUP) || Subtarget.hasAVX2();
    let mut BroadcastIdx: i32 = getSplatIndex(Mask);
    if BroadcastIdx < 0 {
        let mut BroadcastMask: SmallVector<int, 16> = SmallVector<int, 16> { VT.getVectorNumElements(), 0 };
        if !isShuffleEquivalent(Mask, BroadcastMask, V1, V2) {
            return SDValue {};
        }
        BroadcastIdx = 0;
    }
    assert!(BroadcastIdx < Mask.len as i32, "We only expect to be called with a sorted mask where the broadcast comes from V1.");
    let mut NumActiveElts: i32 = count_if(Mask, Closure_52 {});
    let mut BitOffset: i32 = BroadcastIdx * NumEltBits;
    let mut V: SDValue = V1;
    for {
        match V.getOpcode() {
            BITCAST => {
                V = V.getOperand(0);
                continue;
            },
            CONCAT_VECTORS => {
                let mut OpBitWidth: i32 = V.getOperand(0).getValueSizeInBits().operator unsigned long long();
                let mut OpIdx: i32 = BitOffset / OpBitWidth;
                V = V.getOperand(OpIdx);
                BitOffset %= OpBitWidth;
                continue;
            },
            EXTRACT_SUBVECTOR => {
                let mut EltBitWidth: u32 = V.getScalarValueSizeInBits();
                let mut Idx: u32 = V.getConstantOperandVal(1);
                let mut BeginOffset: u32 = Idx * EltBitWidth;
                BitOffset += BeginOffset;
                V = V.getOperand(0);
                continue;
            },
            INSERT_SUBVECTOR => {
                let mut VOuter: SDValue = V.getOperand(0);
                let mut VInner: SDValue = V.getOperand(1);
                let mut EltBitWidth: i32 = VOuter.getScalarValueSizeInBits();
                let mut Idx: i32 = V.getConstantOperandVal(2) as i32;
                let mut NumSubElts: i32 = VInner.getSimpleValueType().getVectorNumElements() as i32;
                let mut BeginOffset: i32 = Idx * EltBitWidth;
                let mut EndOffset: i32 = BeginOffset + NumSubElts * EltBitWidth;
                if BeginOffset <= BitOffset && BitOffset < EndOffset {
                    BitOffset -= BeginOffset;
                    V = VInner;
                } else {
                    V = VOuter;
                }
                continue;
            },
        }
        break;
    }
    assert!((BitOffset % NumEltBits) == 0, "Illegal bit-offset");
    BroadcastIdx = BitOffset / NumEltBits;
    let mut BitCastSrc: bool = V.getScalarValueSizeInBits() != NumEltBits;
    if BitCastSrc && VT.isInteger() {
        if lowerShuffleAsTruncBroadcast(DL, VT, V, BroadcastIdx, Subtarget, DAG) {
            TruncBroadcast;
        } else {
            return TruncBroadcast;
        }
    }
    if !BitCastSrc && ((V.getOpcode() == BUILD_VECTOR && V.hasOneUse()) || (V.getOpcode() == SCALAR_TO_VECTOR && BroadcastIdx == 0)) {
        V = V.getOperand(BroadcastIdx);
        if !BroadcastFromReg && !isShuffleFoldableLoad(V) {
            return SDValue {};
        }
    } else if isNormalLoad(V.getNode()) && cast(V).isSimple() {
        let mut Ld: *mut LoadSDNode = cast(V);
        let mut BaseAddr: SDValue = Ld.getBasePtr();
        let mut SVT: MVT = VT.getScalarType();
        let mut Offset: u32 = BroadcastIdx * SVT.getStoreSize().operator unsigned long long();
        assert!((Offset * 8) as i32 == BitOffset, "Unexpected bit-offset");
        let mut NewAddr: SDValue = DAG.getMemBasePlusOffset(BaseAddr, getFixed(Offset), DL, SDNodeFlags { Flags: None });
        if Opcode == VBROADCAST {
            let mut Tys: SDVTList = DAG.getVTList(VT, Other);
            let mut Ops: [2]SDValue = [Ld.getChain(), NewAddr];
            V = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, DL, Tys, Ops, SVT, DAG.getMachineFunction().getMachineMemOperand(Ld.getMemOperand(), Offset, SVT.getStoreSize()));
            DAG.makeEquivalentMemoryOrdering(Ld, V);
            return DAG.getBitcast(VT, V);
        }
        assert!(SVT == f64, "Unexpected VT!");
        V = DAG.getLoad(SVT, DL, Ld.getChain(), NewAddr, DAG.getMachineFunction().getMachineMemOperand(Ld.getMemOperand(), Offset, SVT.getStoreSize()));
        DAG.makeEquivalentMemoryOrdering(Ld, V);
    } else if !BroadcastFromReg {
        return SDValue {};
    } else if BitOffset != 0 {
        if !VT.is256BitVector() && !VT.is512BitVector() {
            return SDValue {};
        }
        if VT == v4f64 || VT == v4i64 {
            return SDValue {};
        }
        if BitOffset < 128 && NumActiveElts > 1 && V.getScalarValueSizeInBits() == NumEltBits {
            assert!((BitOffset % V.getScalarValueSizeInBits()) == 0, "Unexpected bit-offset");
            let mut ExtractMask: SmallVector<int, 16> = SmallVector<int, 16> { 128 / NumEltBits, SM_SentinelUndef };
            ExtractMask[0] = BitOffset / V.getScalarValueSizeInBits();
            V = extractSubVector(V, 0, DAG, DL, 128);
            V = DAG.getVectorShuffle(V.getValueType(), DL, V, V, ExtractMask);
        } else {
            if (BitOffset % 128) != 0 {
                return SDValue {};
            }
            assert!((BitOffset % V.getScalarValueSizeInBits()) == 0, "Unexpected bit-offset");
            assert!((V.getValueSizeInBits().operator unsigned long long() == 256 || V.getValueSizeInBits().operator unsigned long long() == 512), "Unexpected vector size");
            let mut ExtractIdx: u32 = BitOffset / V.getScalarValueSizeInBits();
            V = extract128BitVector(V, ExtractIdx, DAG, DL);
        }
    }
    if Opcode == MOVDDUP && !V.getValueType().isVector() {
        V = DAG.getBitcast(f64, V);
        if Subtarget.hasAVX() {
            V = DAG.getNode(VBROADCAST, DL, v2f64, V);
            return DAG.getBitcast(VT, V);
        }
        V = DAG.getNode(SCALAR_TO_VECTOR, DL, v2f64, V);
    }
    if !V.getValueType().isVector() {
        assert!(V.getScalarValueSizeInBits() == NumEltBits, "Unexpected scalar size");
        let mut BroadcastVT: MVT = getVectorVT(V.getSimpleValueType(), VT.getVectorNumElements());
        return DAG.getBitcast(VT, DAG.getNode(Opcode, DL, BroadcastVT, V));
    }
    if V.getValueSizeInBits().operator unsigned long long() > 128 {
        V = extract128BitVector(peekThroughBitcasts(V), 0, DAG, DL);
    }
    let mut NumSrcElts: u32 = V.getValueSizeInBits().operator unsigned long long() / NumEltBits;
    let mut CastVT: MVT = getVectorVT(VT.getVectorElementType(), NumSrcElts);
    return DAG.getNode(Opcode, DL, VT, DAG.getBitcast(CastVT, V));
}

fn matchShuffleAsInsertPS(V1: *mut SDValue, V2: *mut SDValue, InsertPSMask: *mut u32, Zeroable: *APInt, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> bool {
    assert!(V1.getSimpleValueType().is128BitVector(), "Bad operand type!");
    assert!(V2.getSimpleValueType().is128BitVector(), "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    let mut matchAsInsertPS: Closure_53 = Closure_53 { Zeroable: &mut Zeroable, DAG: &mut DAG, V1: &mut V1, V2: &mut V2, InsertPSMask: &mut InsertPSMask };
    if matchAsInsertPS.call(V1, V2, Mask) {
        return true;
    }
    let mut CommutedMask: SmallVector<int, 4> = Mask;
    commuteMask(CommutedMask);
    if matchAsInsertPS.call(V2, V1, CommutedMask) {
        return true;
    }
    return false;
}

fn lowerShuffleAsInsertPS(DL: *SDLoc, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4f32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4f32, "Bad operand type!");
    let mut InsertPSMask: u32 = 0;
    if !matchShuffleAsInsertPS(V1, V2, InsertPSMask, Zeroable, Mask, DAG) {
        return SDValue {};
    }
    return DAG.getNode(INSERTPS, DL, v4f32, V1, V2, DAG.getTargetConstant(InsertPSMask, DL, i8, false));
}

fn lowerV2F64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v2f64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v2f64, "Bad operand type!");
    assert!(Mask.len == 2, "Unexpected mask size for v2 shuffle!");
    if V2.isUndef() {
        if lowerShuffleAsBroadcast(DL, v2f64, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        let mut SHUFPDMask: u32 = (Mask[0] == 1) | ((Mask[1] == 1) << 1);
        if Subtarget.hasAVX() {
            return DAG.getNode(VPERMILPI, DL, v2f64, V1, DAG.getTargetConstant(SHUFPDMask, DL, i8, false));
        }
        return DAG.getNode(SHUFP, DL, v2f64, if Mask[0] == SM_SentinelUndef { DAG.getUNDEF(v2f64) } else { V1 }, if Mask[1] == SM_SentinelUndef { DAG.getUNDEF(v2f64) } else { V1 }, DAG.getTargetConstant(SHUFPDMask, DL, i8, false));
    }
    assert!(Mask[0] >= 0, "No undef lanes in multi-input v2 shuffles!");
    assert!(Mask[1] >= 0, "No undef lanes in multi-input v2 shuffles!");
    assert!(Mask[0] < 2, "We sort V1 to be the first input.");
    assert!(Mask[1] >= 2, "We sort V2 to be the second input.");
    if Subtarget.hasAVX2() {
        if lowerShuffleOfExtractsAsVperm(DL, V1, V2, Mask, DAG) {
            Extract;
        } else {
            return Extract;
        }
    }
    if lowerShuffleAsElementInsertion(DL, v2f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Insertion;
    } else {
        return Insertion;
    }
    let mut InverseMask: [2]i32 = [if Mask[0] < 0 { -1 } else { (Mask[0] ^ 2) }, if Mask[1] < 0 { -1 } else { (Mask[1] ^ 2) }];
    if lowerShuffleAsElementInsertion(DL, v2f64, V2, V1, InverseMask, Zeroable, Subtarget, DAG) {
        Insertion;
    } else {
        return Insertion;
    }
    if isShuffleEquivalent(Mask, [0, 3], V1, V2) || isShuffleEquivalent(Mask, [1, 3], V1, V2) {
        if getScalarValueForVectorElement(V1, Mask[0], DAG) {
            V1S;
        } else {
            return DAG.getNode(MOVSD, DL, v2f64, V2, DAG.getNode(SCALAR_TO_VECTOR, DL, v2f64, V1S));
        }
    }
    if Subtarget.hasSSE41() {
        if lowerShuffleAsBlend(DL, v2f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    if lowerShuffleWithUNPCK(DL, v2f64, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    let mut SHUFPDMask: u32 = (Mask[0] == 1) | (((Mask[1] - 2) == 1) << 1);
    return DAG.getNode(SHUFP, DL, v2f64, V1, V2, DAG.getTargetConstant(SHUFPDMask, DL, i8, false));
}

fn lowerV2I64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v2i64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v2i64, "Bad operand type!");
    assert!(Mask.len == 2, "Unexpected mask size for v2 shuffle!");
    if V2.isUndef() {
        if lowerShuffleAsBroadcast(DL, v2i64, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        V1 = DAG.getBitcast(v4i32, V1);
        let mut WidenedMask: [4]i32 = [if Mask[0] < 0 { -1 } else { (Mask[0] * 2) }, if Mask[0] < 0 { -1 } else { ((Mask[0] * 2) + 1) }, if Mask[1] < 0 { -1 } else { (Mask[1] * 2) }, if Mask[1] < 0 { -1 } else { ((Mask[1] * 2) + 1) }];
        return DAG.getBitcast(v2i64, DAG.getNode(PSHUFD, DL, v4i32, V1, getV4X86ShuffleImm8ForMask(WidenedMask, DL, DAG)));
    }
    assert!(Mask[0] != -1, "No undef lanes in multi-input v2 shuffles!");
    assert!(Mask[1] != -1, "No undef lanes in multi-input v2 shuffles!");
    assert!(Mask[0] < 2, "We sort V1 to be the first input.");
    assert!(Mask[1] >= 2, "We sort V2 to be the second input.");
    if Subtarget.hasAVX2() {
        if lowerShuffleOfExtractsAsVperm(DL, V1, V2, Mask, DAG) {
            Extract;
        } else {
            return Extract;
        }
    }
    if lowerShuffleAsShift(DL, v2i64, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsElementInsertion(DL, v2i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Insertion;
    } else {
        return Insertion;
    }
    let mut InverseMask: [2]i32 = [Mask[0] ^ 2, Mask[1] ^ 2];
    if lowerShuffleAsElementInsertion(DL, v2i64, V2, V1, InverseMask, Zeroable, Subtarget, DAG) {
        Insertion;
    } else {
        return Insertion;
    }
    let mut IsBlendSupported: bool = Subtarget.hasSSE41();
    if IsBlendSupported {
        if lowerShuffleAsBlend(DL, v2i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    if lowerShuffleWithUNPCK(DL, v2i64, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if Subtarget.hasSSSE3() {
        if Subtarget.hasVLX() {
            if lowerShuffleAsVALIGN(DL, v2i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
        if lowerShuffleAsByteRotate(DL, v2i64, V1, V2, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if IsBlendSupported {
        return lowerShuffleAsDecomposedShuffleMerge(DL, v2i64, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    V1 = DAG.getBitcast(v2f64, V1);
    V2 = DAG.getBitcast(v2f64, V2);
    return DAG.getBitcast(v2i64, DAG.getVectorShuffle(v2f64, DL, V1, V2, Mask));
}

fn lowerShuffleWithSHUFPS(DL: *SDLoc, VT: MVT, Mask: ArrayRef<int>, V1: SDValue, V2: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut LowV: SDValue = V1;
    let mut HighV: SDValue = V2;
    let mut NewMask: SmallVector<int, 4> = Mask;
    let mut NumV2Elements: i32 = count_if(Mask, Closure_54 {});
    if NumV2Elements == 1 {
        let mut V2Index: i32 = find_if(Mask, Closure_55 {}) - Mask.begin();
        let mut V2AdjIndex: i32 = V2Index ^ 1;
        if Mask[V2AdjIndex] < 0 {
            if V2Index < 2 {
                swap(LowV, HighV);
            }
            NewMask[V2Index] -= 4;
        } else {
            let mut V1Index: i32 = V2AdjIndex;
            let mut BlendMask: [4]i32 = [Mask[V2Index] - 4, 0, Mask[V1Index], 0];
            V2 = DAG.getNode(SHUFP, DL, VT, V2, V1, getV4X86ShuffleImm8ForMask(BlendMask, DL, DAG));
            if V2Index < 2 {
                LowV = V2;
                HighV = V1;
            } else {
                HighV = V2;
            }
            NewMask[V1Index] = 2;
            NewMask[V2Index] = 0;
        }
    } else if NumV2Elements == 2 {
        if Mask[0] < 4 && Mask[1] < 4 {
            NewMask[2] -= 4;
            NewMask[3] -= 4;
        } else if Mask[2] < 4 && Mask[3] < 4 {
            NewMask[0] -= 4;
            NewMask[1] -= 4;
            HighV = V1;
            LowV = V2;
        } else {
            let mut BlendMask: [4]i32 = [if Mask[0] < 4 { Mask[0] } else { Mask[1] }, if Mask[2] < 4 { Mask[2] } else { Mask[3] }, (if Mask[0] >= 4 { Mask[0] } else { Mask[1] }) - 4, (if Mask[2] >= 4 { Mask[2] } else { Mask[3] }) - 4];
            V1 = DAG.getNode(SHUFP, DL, VT, V1, V2, getV4X86ShuffleImm8ForMask(BlendMask, DL, DAG));
            LowV = HighV = V1;
            NewMask[0] = if Mask[0] < 4 { 0 } else { 2 };
            NewMask[1] = if Mask[0] < 4 { 2 } else { 0 };
            NewMask[2] = if Mask[2] < 4 { 1 } else { 3 };
            NewMask[3] = if Mask[2] < 4 { 3 } else { 1 };
        }
    } else if NumV2Elements == 3 {
        commuteMask(NewMask);
        return lowerShuffleWithSHUFPS(DL, VT, NewMask, V2, V1, DAG);
    }
    return DAG.getNode(SHUFP, DL, VT, LowV, HighV, getV4X86ShuffleImm8ForMask(NewMask, DL, DAG));
}

fn lowerV4F32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4f32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4f32, "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    if Subtarget.hasSSE41() {
        if lowerShuffleAsBlend(DL, v4f32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    let mut NumV2Elements: i32 = count_if(Mask, Closure_56 {});
    if NumV2Elements == 0 {
        if lowerShuffleAsBroadcast(DL, v4f32, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        if Subtarget.hasSSE3() {
            if isShuffleEquivalent(Mask, [0, 0, 2, 2], V1, V2) {
                return DAG.getNode(MOVSLDUP, DL, v4f32, V1);
            }
            if isShuffleEquivalent(Mask, [1, 1, 3, 3], V1, V2) {
                return DAG.getNode(MOVSHDUP, DL, v4f32, V1);
            }
        }
        if Subtarget.hasAVX() {
            return DAG.getNode(VPERMILPI, DL, v4f32, V1, getV4X86ShuffleImm8ForMask(Mask, DL, DAG));
        }
        if !Subtarget.hasSSE2() {
            if isShuffleEquivalent(Mask, [0, 1, 0, 1], V1, V2) {
                return DAG.getNode(MOVLHPS, DL, v4f32, V1, V1);
            }
            if isShuffleEquivalent(Mask, [2, 3, 2, 3], V1, V2) {
                return DAG.getNode(MOVHLPS, DL, v4f32, V1, V1);
            }
        }
        return DAG.getNode(SHUFP, DL, v4f32, V1, V1, getV4X86ShuffleImm8ForMask(Mask, DL, DAG));
    }
    if Subtarget.hasSSE2() {
        if lowerShuffleAsZeroOrAnyExtend(DL, v4i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            ZExt;
        } else {
            ZExt = DAG.getBitcast(v4f32, ZExt);
            return ZExt;
        }
    }
    if Subtarget.hasAVX2() {
        if lowerShuffleOfExtractsAsVperm(DL, V1, V2, Mask, DAG) {
            Extract;
        } else {
            return Extract;
        }
    }
    if NumV2Elements == 1 && Mask[0] >= 4 {
        if lowerShuffleAsElementInsertion(DL, v4f32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if Subtarget.hasSSE41() {
        let mut MatchesShufPS: bool = isSingleSHUFPSMask(Mask);
        if !MatchesShufPS || Zeroable == 3 || Zeroable == 12 {
            if lowerShuffleAsInsertPS(DL, V1, V2, Mask, Zeroable, DAG) {
                V;
            } else {
                return V;
            }
        }
        if !MatchesShufPS {
            if lowerShuffleAsBlendAndPermute(DL, v4f32, V1, V2, Mask, DAG, false) {
                BlendPerm;
            } else {
                return BlendPerm;
            }
        }
    }
    if !Subtarget.hasSSE2() {
        if isShuffleEquivalent(Mask, [0, 1, 4, 5], V1, V2) {
            return DAG.getNode(MOVLHPS, DL, v4f32, V1, V2);
        }
        if isShuffleEquivalent(Mask, [2, 3, 6, 7], V1, V2) {
            return DAG.getNode(MOVHLPS, DL, v4f32, V2, V1);
        }
    }
    if lowerShuffleWithUNPCK(DL, v4f32, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    return lowerShuffleWithSHUFPS(DL, v4f32, Mask, V1, V2, DAG);
}

fn lowerV4I32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4i32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4i32, "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    if lowerShuffleAsZeroOrAnyExtend(DL, v4i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    let mut NumV2Elements: i32 = count_if(Mask, Closure_57 {});
    if Subtarget.preferLowerShuffleAsShift() {
        if lowerShuffleAsShift(DL, v4i32, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
        if NumV2Elements == 0 {
            if lowerShuffleAsBitRotate(DL, v4i32, V1, Mask, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
    }
    if NumV2Elements == 0 {
        if count_if(Mask, Closure_58 {}) > 1 {
            if lowerShuffleAsBroadcast(DL, v4i32, V1, V2, Mask, Subtarget, DAG) {
                Broadcast;
            } else {
                return Broadcast;
            }
        }
        let mut UnpackLoMask: [4]i32 = [0, 0, 1, 1];
        let mut UnpackHiMask: [4]i32 = [2, 2, 3, 3];
        if !isSingleElementRepeatedMask(Mask) {
            if isShuffleEquivalent(Mask, [0, 0, 1, 1], V1, V2) {
                Mask = UnpackLoMask;
            } else if isShuffleEquivalent(Mask, [2, 2, 3, 3], V1, V2) {
                Mask = UnpackHiMask;
            }
        }
        return DAG.getNode(PSHUFD, DL, v4i32, V1, getV4X86ShuffleImm8ForMask(Mask, DL, DAG));
    }
    if Subtarget.hasAVX2() {
        if lowerShuffleOfExtractsAsVperm(DL, V1, V2, Mask, DAG) {
            Extract;
        } else {
            return Extract;
        }
    }
    if lowerShuffleAsShift(DL, v4i32, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if NumV2Elements == 1 {
        if lowerShuffleAsElementInsertion(DL, v4i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    let mut IsBlendSupported: bool = Subtarget.hasSSE41();
    if IsBlendSupported {
        if lowerShuffleAsBlend(DL, v4i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    if lowerShuffleAsBitMask(DL, v4i32, V1, V2, Mask, Zeroable, DAG) {
        Masked;
    } else {
        return Masked;
    }
    if lowerShuffleWithUNPCK(DL, v4i32, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if Subtarget.hasSSSE3() {
        if Subtarget.hasVLX() {
            if lowerShuffleAsVALIGN(DL, v4i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
        if lowerShuffleAsByteRotate(DL, v4i32, V1, V2, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if !isSingleSHUFPSMask(Mask) {
        if IsBlendSupported {
            return lowerShuffleAsDecomposedShuffleMerge(DL, v4i32, V1, V2, Mask, Zeroable, Subtarget, DAG);
        }
        if lowerShuffleAsPermuteAndUnpack(DL, v4i32, V1, V2, Mask, Subtarget, DAG) {
            Unpack;
        } else {
            return Unpack;
        }
    }
    let mut CastV1: SDValue = DAG.getBitcast(v4f32, V1);
    let mut CastV2: SDValue = DAG.getBitcast(v4f32, V2);
    let mut ShufPS: SDValue = DAG.getVectorShuffle(v4f32, DL, CastV1, CastV2, Mask);
    return DAG.getBitcast(v4i32, ShufPS);
}

fn lowerV8I16GeneralSingleInputShuffle(DL: *SDLoc, VT: MVT, V: SDValue, Mask: MutableArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT.getVectorElementType() == i16, "Bad input type!");
    let mut PSHUFDVT: MVT = getVectorVT(i32, VT.getVectorNumElements() / 2);
    assert!(Mask.len == 8, "Shuffle mask length doesn't match!");
    let mut LoMask: MutableArrayRef<int> = Mask.slice(0, 4);
    let mut HiMask: MutableArrayRef<int> = Mask.slice(4, 4);
    if isUndefOrInRange(LoMask, 0, 4) && isSequentialOrUndefInRange(HiMask, 0, 4, 4, 1) {
        return DAG.getNode(PSHUFLW, DL, VT, V, getV4X86ShuffleImm8ForMask(LoMask, DL, DAG));
    }
    if isUndefOrInRange(HiMask, 4, 8) && isSequentialOrUndefInRange(LoMask, 0, 4, 0, 1) {
        for let mut i: i32 = 0; i != 4; i += 1 {
            HiMask[i] = (if HiMask[i] < 0 { HiMask[i] } else { (HiMask[i] - 4) });
        }
        return DAG.getNode(PSHUFHW, DL, VT, V, getV4X86ShuffleImm8ForMask(HiMask, DL, DAG));
    }
    let mut LoInputs: SmallVector<int, 4> = SmallVector<int, 4> {};
    copy_if(LoMask, back_inserter(LoInputs), Closure_59 {});
    array_pod_sort(LoInputs.begin(), LoInputs.end());
    LoInputs.erase(unique(LoInputs), LoInputs.end());
    let mut HiInputs: SmallVector<int, 4> = SmallVector<int, 4> {};
    copy_if(HiMask, back_inserter(HiInputs), Closure_60 {});
    array_pod_sort(HiInputs.begin(), HiInputs.end());
    HiInputs.erase(unique(HiInputs), HiInputs.end());
    let mut NumLToL: i32 = lower_bound(LoInputs, 4) - LoInputs.begin();
    let mut NumHToL: i32 = LoInputs.len - NumLToL;
    let mut NumLToH: i32 = lower_bound(HiInputs, 4) - HiInputs.begin();
    let mut NumHToH: i32 = HiInputs.len - NumLToH;
    let mut LToLInputs: MutableArrayRef<int> = MutableArrayRef<int> { LoInputs.ptr, NumLToL };
    let mut LToHInputs: MutableArrayRef<int> = MutableArrayRef<int> { HiInputs.ptr, NumLToH };
    let mut HToLInputs: MutableArrayRef<int> = MutableArrayRef<int> { LoInputs.ptr + NumLToL, NumHToL };
    let mut HToHInputs: MutableArrayRef<int> = MutableArrayRef<int> { HiInputs.ptr + NumLToH, NumHToH };
    let mut ShuffleDWordPairs: Closure_61 = Closure_61 { V: &mut V, DAG: &mut DAG, DL: &mut DL, VT: &mut VT, PSHUFDVT: &mut PSHUFDVT };
    if (NumHToL + NumHToH) == 0 || (NumLToL + NumLToH) == 0 {
        let mut PSHUFDMask: [4]i32 = [-1, -1, -1, -1];
        let mut DWordPairs: pair<int, int>, 4> = pair<int, int>, 4> {};
        let mut DOffset: i32 = (if (NumHToL + NumHToH) == 0 { 0 } else { 2 });
        for let mut DWord: i32 = 0; DWord != 4; DWord += 1 {
            let mut M0: i32 = Mask[2 * DWord + 0];
            let mut M1: i32 = Mask[2 * DWord + 1];
            M0 = (if M0 >= 0 { M0 % 4 } else { M0 });
            M1 = (if M1 >= 0 { M1 % 4 } else { M1 });
            if M0 < 0 && M1 < 0 {
                continue;
            }
            let mut Match: bool = false;
            for let mut j: i32 = 0;
let mut e: i32 = DWordPairs.len; j < e; j += 1 {
                let mut DWordPair: *mut pair<int, int> = DWordPairs[j];
                if (M0 < 0 || isUndefOrEqual(DWordPair.first, M0)) && (M1 < 0 || isUndefOrEqual(DWordPair.second, M1)) {
                    DWordPair.first = (if M0 >= 0 { M0 } else { DWordPair.first });
                    DWordPair.second = (if M1 >= 0 { M1 } else { DWordPair.second });
                    PSHUFDMask[DWord] = DOffset + j;
                    Match = true;
                    break;
                }
            }
            if !Match {
                PSHUFDMask[DWord] = DOffset + DWordPairs.len;
                DWordPairs.push(make_pair(M0, M1));
            }
        }
        if DWordPairs.len <= 2 {
            DWordPairs.resize(2, make_pair(-1, -1));
            let mut PSHUFHalfMask: [4]i32 = [DWordPairs[0].first, DWordPairs[0].second, DWordPairs[1].first, DWordPairs[1].second];
            if isSplatMask(PSHUFDMask) && isSplatMask(PSHUFHalfMask) {
                let mut SplatIdx: i32 = getSplatMaskIndex(PSHUFHalfMask);
                fill(PSHUFHalfMask, PSHUFHalfMask + 4, SplatIdx);
                PSHUFDMask[0] = PSHUFDMask[2] = DOffset + 0;
                PSHUFDMask[1] = PSHUFDMask[3] = DOffset + 1;
            }
            if (NumHToL + NumHToH) == 0 {
                return ShuffleDWordPairs.call(PSHUFHalfMask, PSHUFDMask, PSHUFLW);
            }
            if (NumLToL + NumLToH) == 0 {
                return ShuffleDWordPairs.call(PSHUFHalfMask, PSHUFDMask, PSHUFHW);
            }
        }
    }
    let mut balanceSides: Closure_62 = Closure_62 { V: &mut V, DL: &mut DL, Mask: &mut Mask, DAG: &mut DAG, VT: &mut VT, PSHUFDVT: &mut PSHUFDVT, Subtarget: &mut Subtarget };
    if (NumLToL == 3 && NumHToL == 1) || (NumLToL == 1 && NumHToL == 3) {
        return balanceSides.call(LToLInputs, HToLInputs, HToHInputs, LToHInputs, 0, 4);
    }
    if (NumHToH == 3 && NumLToH == 1) || (NumHToH == 1 && NumLToH == 3) {
        return balanceSides.call(HToHInputs, LToHInputs, LToLInputs, HToLInputs, 4, 0);
    }
    let mut PSHUFLMask: [4]i32 = [-1, -1, -1, -1];
    let mut PSHUFHMask: [4]i32 = [-1, -1, -1, -1];
    let mut PSHUFDMask: [4]i32 = [-1, -1, -1, -1];
    let mut fixInPlaceInputs: Closure_64 = Closure_64 { PSHUFDMask: &mut PSHUFDMask };
    fixInPlaceInputs.call(LToLInputs, HToLInputs, PSHUFLMask, LoMask, 0);
    fixInPlaceInputs.call(HToHInputs, LToHInputs, PSHUFHMask, HiMask, 4);
    let mut moveInputsToRightHalf: Closure_65 = Closure_65 { PSHUFDMask: &mut PSHUFDMask };
    moveInputsToRightHalf.call(HToLInputs, LToLInputs, PSHUFHMask, LoMask, HiMask, 4, 0);
    moveInputsToRightHalf.call(LToHInputs, HToHInputs, PSHUFLMask, HiMask, LoMask, 0, 4);
    if !isNoopShuffleMask(PSHUFLMask) {
        V = DAG.getNode(PSHUFLW, DL, VT, V, getV4X86ShuffleImm8ForMask(PSHUFLMask, DL, DAG));
    }
    if !isNoopShuffleMask(PSHUFHMask) {
        V = DAG.getNode(PSHUFHW, DL, VT, V, getV4X86ShuffleImm8ForMask(PSHUFHMask, DL, DAG));
    }
    if !isNoopShuffleMask(PSHUFDMask) {
        V = DAG.getBitcast(VT, DAG.getNode(PSHUFD, DL, PSHUFDVT, DAG.getBitcast(PSHUFDVT, V), getV4X86ShuffleImm8ForMask(PSHUFDMask, DL, DAG)));
    }
    assert!(none_of(LoMask, Closure_68 {}), "Failed to lift all the high half inputs to the low mask!");
    assert!(none_of(HiMask, Closure_69 {}), "Failed to lift all the low half inputs to the high mask!");
    if !isNoopShuffleMask(LoMask) {
        V = DAG.getNode(PSHUFLW, DL, VT, V, getV4X86ShuffleImm8ForMask(LoMask, DL, DAG));
    }
    for M in HiMask {
        if M >= 0 {
            M -= 4;
        }
    }
    if !isNoopShuffleMask(HiMask) {
        V = DAG.getNode(PSHUFHW, DL, VT, V, getV4X86ShuffleImm8ForMask(HiMask, DL, DAG));
    }
    return V;
}

fn lowerShuffleAsBlendOfPSHUFBs(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, DAG: *mut SelectionDAG, V1InUse: *mut bool, V2InUse: *mut bool) -> SDValue {
    assert!(!is128BitLaneCrossingShuffleMask(VT, Mask), "Lane crossing shuffle masks not supported");
    let mut NumBytes: i32 = VT.getSizeInBits().operator unsigned long long() / 8;
    let mut Size: i32 = Mask.len;
    let mut Scale: i32 = NumBytes / Size;
    let mut V1Mask: SmallVector<SDValue, 64> = SmallVector<SDValue, 64> { NumBytes, DAG.getUNDEF(i8) };
    let mut V2Mask: SmallVector<SDValue, 64> = SmallVector<SDValue, 64> { NumBytes, DAG.getUNDEF(i8) };
    V1InUse = false;
    V2InUse = false;
    for let mut i: i32 = 0; i < NumBytes; i += 1 {
        let mut M: i32 = Mask[i / Scale];
        if M < 0 {
            continue;
        }
        let mut ZeroMask: i32 = 128;
        let mut V1Idx: i32 = if M < Size { M * Scale + i % Scale } else { ZeroMask };
        let mut V2Idx: i32 = if M < Size { ZeroMask } else { (M - Size) * Scale + i % Scale };
        if Zeroable[i / Scale] {
            V1Idx = V2Idx = ZeroMask;
        }
        V1Mask[i] = DAG.getConstant(V1Idx, DL, i8, false, false);
        V2Mask[i] = DAG.getConstant(V2Idx, DL, i8, false, false);
        V1InUse |= (ZeroMask != V1Idx);
        V2InUse |= (ZeroMask != V2Idx);
    }
    let mut ShufVT: MVT = getVectorVT(i8, NumBytes);
    if V1InUse {
        V1 = DAG.getNode(PSHUFB, DL, ShufVT, DAG.getBitcast(ShufVT, V1), DAG.getBuildVector(ShufVT, DL, V1Mask));
    }
    if V2InUse {
        V2 = DAG.getNode(PSHUFB, DL, ShufVT, DAG.getBitcast(ShufVT, V2), DAG.getBuildVector(ShufVT, DL, V2Mask));
    }
    let mut V: SDValue = SDValue {};
    if V1InUse && V2InUse {
        V = DAG.getNode(OR, DL, ShufVT, V1, V2);
    } else {
        V = if V1InUse { V1 } else { V2 };
    }
    return DAG.getBitcast(VT, V);
}

fn lowerV8I16Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8i16, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8i16, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    if lowerShuffleAsZeroOrAnyExtend(DL, v8i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleWithVPMOV(DL, v8i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    let mut NumV2Inputs: i32 = count_if(Mask, Closure_70 {});
    if NumV2Inputs == 0 {
        if lowerShuffleAsShift(DL, v8i16, V1, V1, Mask, Zeroable, Subtarget, DAG, false) {
            Shift;
        } else {
            return Shift;
        }
        if lowerShuffleAsBroadcast(DL, v8i16, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        if lowerShuffleAsBitRotate(DL, v8i16, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithUNPCK(DL, v8i16, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleWithPACK(DL, v8i16, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsByteRotate(DL, v8i16, V1, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        let mut MutableMask: SmallVector<int, 8> = Mask;
        return lowerV8I16GeneralSingleInputShuffle(DL, v8i16, V1, MutableMask, Subtarget, DAG);
    }
    assert!(any_of(Mask, Closure_71 {}), "All single-input shuffles should be canonicalized to be V1-input shuffles.");
    if lowerShuffleAsShift(DL, v8i16, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if Subtarget.hasSSE4A() {
        if lowerShuffleWithSSE4A(DL, v8i16, V1, V2, Mask, Zeroable, DAG) {
            V;
        } else {
            return V;
        }
    }
    if NumV2Inputs == 1 {
        if lowerShuffleAsElementInsertion(DL, v8i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    let mut IsBlendSupported: bool = Subtarget.hasSSE41();
    if IsBlendSupported {
        if lowerShuffleAsBlend(DL, v8i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
    }
    if lowerShuffleAsBitMask(DL, v8i16, V1, V2, Mask, Zeroable, DAG) {
        Masked;
    } else {
        return Masked;
    }
    if lowerShuffleWithUNPCK(DL, v8i16, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, v8i16, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVTRUNC(DL, v8i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsByteRotate(DL, v8i16, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleAsBitBlend(DL, v8i16, V1, V2, Mask, DAG) {
        BitBlend;
    } else {
        return BitBlend;
    }
    if lowerShuffleAsByteShiftMask(DL, v8i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    let mut NumEvenDrops: i32 = canLowerByDroppingElements(Mask, true, false);
    if (NumEvenDrops == 1 || (NumEvenDrops == 2 && Subtarget.hasSSE41())) && !Subtarget.hasVLX() {
        let mut PackOpc: u32 = 0;
        if NumEvenDrops == 2 && Subtarget.hasAVX2() && peekThroughBitcasts(V1).getOpcode() == EXTRACT_SUBVECTOR && peekThroughBitcasts(V2).getOpcode() == EXTRACT_SUBVECTOR {
            let mut V1V2: SDValue = concatSubVectors(V1, V2, DAG, DL);
            V1V2 = DAG.getNode(BLENDI, DL, v16i16, V1V2, getZeroVector(v16i16, Subtarget, DAG, DL), DAG.getTargetConstant(238, DL, i8, false));
            V1V2 = DAG.getBitcast(v8i32, V1V2);
            V1 = extract128BitVector(V1V2, 0, DAG, DL);
            V2 = extract128BitVector(V1V2, 4, DAG, DL);
            PackOpc = PACKUS;
        } else if Subtarget.hasSSE41() {
            let mut DWordClearOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { 4, DAG.getConstant(0, DL, i32, false, false) };
            for let mut i: u32 = 0; i != 4; i += 1 << (NumEvenDrops - 1) {
                DWordClearOps[i] = DAG.getConstant(65535, DL, i32, false, false);
            }
            let mut DWordClearMask: SDValue = DAG.getBuildVector(v4i32, DL, DWordClearOps);
            V1 = DAG.getNode(AND, DL, v4i32, DAG.getBitcast(v4i32, V1), DWordClearMask);
            V2 = DAG.getNode(AND, DL, v4i32, DAG.getBitcast(v4i32, V2), DWordClearMask);
            PackOpc = PACKUS;
        } else if !Subtarget.hasSSSE3() {
            let mut ShAmt: SDValue = DAG.getTargetConstant(16, DL, i8, false);
            V1 = DAG.getBitcast(v4i32, V1);
            V2 = DAG.getBitcast(v4i32, V2);
            V1 = DAG.getNode(VSHLI, DL, v4i32, V1, ShAmt);
            V2 = DAG.getNode(VSHLI, DL, v4i32, V2, ShAmt);
            V1 = DAG.getNode(VSRAI, DL, v4i32, V1, ShAmt);
            V2 = DAG.getNode(VSRAI, DL, v4i32, V2, ShAmt);
            PackOpc = PACKSS;
        }
        if PackOpc {
            let mut Result: SDValue = DAG.getNode(PackOpc, DL, v8i16, V1, V2);
            if NumEvenDrops == 2 {
                Result = DAG.getBitcast(v4i32, Result);
                Result = DAG.getNode(PackOpc, DL, v8i16, Result, Result);
            }
            return Result;
        }
    }
    let mut NumOddDrops: i32 = canLowerByDroppingElements(Mask, false, false);
    if NumOddDrops == 1 {
        let mut HasSSE41: bool = Subtarget.hasSSE41();
        V1 = DAG.getNode(if HasSSE41 { VSRLI } else { VSRAI }, DL, v4i32, DAG.getBitcast(v4i32, V1), DAG.getTargetConstant(16, DL, i8, false));
        V2 = DAG.getNode(if HasSSE41 { VSRLI } else { VSRAI }, DL, v4i32, DAG.getBitcast(v4i32, V2), DAG.getTargetConstant(16, DL, i8, false));
        return DAG.getNode(if HasSSE41 { PACKUS } else { PACKSS }, DL, v8i16, V1, V2);
    }
    if lowerShuffleAsPermuteAndUnpack(DL, v8i16, V1, V2, Mask, Subtarget, DAG) {
        Unpack;
    } else {
        return Unpack;
    }
    if !IsBlendSupported && Subtarget.hasSSSE3() {
        let mut V1InUse: bool = false;
        let mut V2InUse: bool = false;
        return lowerShuffleAsBlendOfPSHUFBs(DL, v8i16, V1, V2, Mask, Zeroable, DAG, V1InUse, V2InUse);
    }
    return lowerShuffleAsDecomposedShuffleMerge(DL, v8i16, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV8F16Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8f16, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8f16, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    let mut NumV2Elements: i32 = count_if(Mask, Closure_72 {});
    if Subtarget.hasFP16() {
        if NumV2Elements == 0 {
            if lowerShuffleAsBroadcast(DL, v8f16, V1, V2, Mask, Subtarget, DAG) {
                Broadcast;
            } else {
                return Broadcast;
            }
        }
        if NumV2Elements == 1 && Mask[0] >= 8 {
            if lowerShuffleAsElementInsertion(DL, v8f16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
                V;
            } else {
                return V;
            }
        }
    }
    V1 = DAG.getBitcast(v8i16, V1);
    V2 = DAG.getBitcast(v8i16, V2);
    return DAG.getBitcast(v8f16, DAG.getVectorShuffle(v8i16, DL, V1, V2, Mask));
}

fn lowerShuffleWithPERMV(DL: *SDLoc, VT: MVT, OriginalMask: ArrayRef<int>, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut Mask: SmallVector<int, 32> = OriginalMask;
    if !V2.isUndef() && isShuffleFoldableLoad(V1) && !isShuffleFoldableLoad(V2) {
        commuteMask(Mask);
        swap(V1, V2);
    }
    let mut MaskVT: MVT = VT.changeTypeToInteger();
    let mut MaskNode: SDValue = SDValue {};
    let mut ShuffleVT: MVT = VT;
    if !VT.is512BitVector() && !Subtarget.hasVLX() {
        V1 = widenSubVector(V1, false, Subtarget, DAG, DL, 512);
        V2 = widenSubVector(V2, false, Subtarget, DAG, DL, 512);
        ShuffleVT = V1.getSimpleValueType();
        let mut NumElts: i32 = VT.getVectorNumElements();
        let mut Scale: u32 = 512 / VT.getSizeInBits().operator unsigned long long();
        let mut AdjustedMask: SmallVector<int, 32> = Mask;
        for M in AdjustedMask {
            if NumElts <= M {
                M += (Scale - 1) * NumElts;
            }
        }
        MaskNode = getConstVector(AdjustedMask, MaskVT, DAG, DL, true);
        MaskNode = widenSubVector(MaskNode, false, Subtarget, DAG, DL, 512);
    } else {
        MaskNode = getConstVector(Mask, MaskVT, DAG, DL, true);
    }
    let mut Result: SDValue = SDValue {};
    if V2.isUndef() {
        Result = DAG.getNode(VPERMV, DL, ShuffleVT, MaskNode, V1);
    } else {
        Result = DAG.getNode(VPERMV3, DL, ShuffleVT, V1, MaskNode, V2);
    }
    if VT != ShuffleVT {
        Result = extractSubVector(Result, 0, DAG, DL, VT.getSizeInBits().operator unsigned long long());
    }
    return Result;
}

fn lowerV16I8Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v16i8, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v16i8, "Bad operand type!");
    assert!(Mask.len == 16, "Unexpected mask size for v16 shuffle!");
    if lowerShuffleAsShift(DL, v16i8, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, v16i8, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleWithPACK(DL, v16i8, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsZeroOrAnyExtend(DL, v16i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleWithVPMOV(DL, v16i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVTRUNC(DL, v16i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if Subtarget.hasSSE4A() {
        if lowerShuffleWithSSE4A(DL, v16i8, V1, V2, Mask, Zeroable, DAG) {
            V;
        } else {
            return V;
        }
    }
    let mut NumV2Elements: i32 = count_if(Mask, Closure_73 {});
    if NumV2Elements == 0 {
        if lowerShuffleAsBroadcast(DL, v16i8, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        if lowerShuffleAsBitRotate(DL, v16i8, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithUNPCK(DL, v16i8, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        let mut canWidenViaDuplication: Closure_74 = Closure_74 {};
        let mut tryToWidenViaDuplication: Closure_75 = Closure_75 { canWidenViaDuplication: &mut canWidenViaDuplication, Mask: &mut Mask, V1: &mut V1, DAG: &mut DAG, DL: &mut DL };
        if tryToWidenViaDuplication.call() {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsBitMask(DL, v16i8, V1, V2, Mask, Zeroable, DAG) {
        Masked;
    } else {
        return Masked;
    }
    if lowerShuffleWithUNPCK(DL, v16i8, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsByteShiftMask(DL, v16i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    let mut IsSingleInput: bool = V2.isUndef();
    let mut NumEvenDrops: i32 = canLowerByDroppingElements(Mask, true, IsSingleInput);
    if Subtarget.hasSSSE3() && (IsSingleInput || NumEvenDrops != 1) {
        let mut V1InUse: bool = false;
        let mut V2InUse: bool = false;
        let mut PSHUFB: SDValue = lowerShuffleAsBlendOfPSHUFBs(DL, v16i8, V1, V2, Mask, Zeroable, DAG, V1InUse, V2InUse);
        if V1InUse && V2InUse {
            if Subtarget.hasSSE41() {
                if lowerShuffleAsBlend(DL, v16i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
                    Blend;
                } else {
                    return Blend;
                }
            }
            if lowerShuffleAsPermuteAndUnpack(DL, v16i8, V1, V2, Mask, Subtarget, DAG) {
                Unpack;
            } else {
                return Unpack;
            }
            if Subtarget.hasVBMI() {
                return lowerShuffleWithPERMV(DL, v16i8, Mask, V1, V2, Subtarget, DAG);
            }
            if Subtarget.hasXOP() {
                let mut MaskNode: SDValue = getConstVector(Mask, v16i8, DAG, DL, true);
                return DAG.getNode(VPPERM, DL, v16i8, V1, V2, MaskNode);
            }
            if lowerShuffleAsByteRotateAndPermute(DL, v16i8, V1, V2, Mask, Subtarget, DAG) {
                V;
            } else {
                return V;
            }
        }
        return PSHUFB;
    }
    if NumV2Elements == 1 {
        if lowerShuffleAsElementInsertion(DL, v16i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsBitBlend(DL, v16i8, V1, V2, Mask, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if NumEvenDrops {
        assert!(NumEvenDrops <= 3, "No support for dropping even elements more than 3 times.");
        let mut WordClearOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { 8, DAG.getConstant(0, DL, i16, false, false) };
        for let mut i: u32 = 0; i != 8; i += 1 << (NumEvenDrops - 1) {
            WordClearOps[i] = DAG.getConstant(255, DL, i16, false, false);
        }
        let mut WordClearMask: SDValue = DAG.getBuildVector(v8i16, DL, WordClearOps);
        V1 = DAG.getNode(AND, DL, v8i16, DAG.getBitcast(v8i16, V1), WordClearMask);
        if !IsSingleInput {
            V2 = DAG.getNode(AND, DL, v8i16, DAG.getBitcast(v8i16, V2), WordClearMask);
        }
        let mut Result: SDValue = DAG.getNode(PACKUS, DL, v16i8, V1, if IsSingleInput { V1 } else { V2 });
        for let mut i: i32 = 1; i < NumEvenDrops; i += 1 {
            Result = DAG.getBitcast(v8i16, Result);
            Result = DAG.getNode(PACKUS, DL, v16i8, Result, Result);
        }
        return Result;
    }
    let mut NumOddDrops: i32 = canLowerByDroppingElements(Mask, false, IsSingleInput);
    if NumOddDrops == 1 {
        V1 = DAG.getNode(VSRLI, DL, v8i16, DAG.getBitcast(v8i16, V1), DAG.getTargetConstant(8, DL, i8, false));
        if !IsSingleInput {
            V2 = DAG.getNode(VSRLI, DL, v8i16, DAG.getBitcast(v8i16, V2), DAG.getTargetConstant(8, DL, i8, false));
        }
        return DAG.getNode(PACKUS, DL, v16i8, V1, if IsSingleInput { V1 } else { V2 });
    }
    if NumV2Elements > 0 {
        return lowerShuffleAsDecomposedShuffleMerge(DL, v16i8, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    let mut V: SDValue = V1;
    let mut LoBlendMask: array<int, 8> = array<int, 8> { [-1, -1, -1, -1, -1, -1, -1, -1] };
    let mut HiBlendMask: array<int, 8> = array<int, 8> { [-1, -1, -1, -1, -1, -1, -1, -1] };
    for let mut i: i32 = 0; i < 16; i += 1 {
        if Mask[i] >= 0 {
            (if i < 8 { LoBlendMask[i] } else { HiBlendMask[i % 8] }) = Mask[i];
        }
    }
    let mut VLoHalf: SDValue = SDValue {};
    let mut VHiHalf: SDValue = SDValue {};
    if none_of(LoBlendMask, Closure_78 {}) && none_of(HiBlendMask, Closure_79 {}) {
        VLoHalf = DAG.getBitcast(v8i16, V);
        VLoHalf = DAG.getNode(AND, DL, v8i16, VLoHalf, DAG.getConstant(255, DL, v8i16, false, false));
        VHiHalf = DAG.getUNDEF(v8i16);
        for M in LoBlendMask {
            if M >= 0 {
                M /= 2;
            }
        }
        for M in HiBlendMask {
            if M >= 0 {
                M /= 2;
            }
        }
    } else {
        let mut Zero: SDValue = getZeroVector(v16i8, Subtarget, DAG, DL);
        VLoHalf = DAG.getBitcast(v8i16, DAG.getNode(UNPCKL, DL, v16i8, V, Zero));
        VHiHalf = DAG.getBitcast(v8i16, DAG.getNode(UNPCKH, DL, v16i8, V, Zero));
    }
    let mut LoV: SDValue = DAG.getVectorShuffle(v8i16, DL, VLoHalf, VHiHalf, LoBlendMask);
    let mut HiV: SDValue = DAG.getVectorShuffle(v8i16, DL, VLoHalf, VHiHalf, HiBlendMask);
    return DAG.getNode(PACKUS, DL, v16i8, LoV, HiV);
}

fn lower128BitShuffle(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if VT == v8bf16 {
        V1 = DAG.getBitcast(v8i16, V1);
        V2 = DAG.getBitcast(v8i16, V2);
        return DAG.getBitcast(VT, DAG.getVectorShuffle(v8i16, DL, V1, V2, Mask));
    }
    match VT.SimpleTy {
        v2i64 => {
            return lowerV2I64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v2f64 => {
            return lowerV2F64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v4i32 => {
            return lowerV4I32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v4f32 => {
            return lowerV4F32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8i16 => {
            return lowerV8I16Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8f16 => {
            return lowerV8F16Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v16i8 => {
            return lowerV16I8Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        _ => {
            llvm_unreachable_internal("Unimplemented!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 15497);
        },
    }
}

fn splitAndLowerShuffle(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG, SimpleOnly: bool) -> SDValue {
    assert!(VT.getSizeInBits().operator unsigned long long() >= 256, "Only for 256-bit or wider vector shuffles!");
    assert!(V1.getSimpleValueType() == VT, "Bad operand type!");
    assert!(V2.getSimpleValueType() == VT, "Bad operand type!");
    if VT == v8f32 {
        let mut BC1: SDValue = peekThroughBitcasts(V1);
        let mut BC2: SDValue = peekThroughBitcasts(V2);
        if BC1.getValueType() == v8i32 && BC2.getValueType() == v8i32 {
            if splitAndLowerShuffle(DL, v8i32, BC1, BC2, Mask, DAG, SimpleOnly) {
                Split;
            } else {
                return DAG.getBitcast(VT, Split);
            }
        }
    }
    let mut LoMask: ArrayRef<int> = Mask.slice(0, Mask.len / 2);
    let mut HiMask: ArrayRef<int> = Mask.slice(Mask.len / 2);
    let mut NumElements: i32 = VT.getVectorNumElements();
    let mut SplitNumElements: i32 = NumElements / 2;
    let mut ScalarVT: MVT = VT.getVectorElementType();
    let mut SplitVT: MVT = getVectorVT(ScalarVT, SplitNumElements);
    let mut SplitVector: Closure_80 = Closure_80 { DAG: &mut DAG, DL: &mut DL, SplitVT: &mut SplitVT };
    let mut LoV1: SDValue = SDValue {};
    let mut HiV1: SDValue = SDValue {};
    let mut LoV2: SDValue = SDValue {};
    let mut HiV2: SDValue = SDValue {};
    tie(LoV1, HiV1) = SplitVector.call(V1);
    tie(LoV2, HiV2) = SplitVector.call(V2);
    let mut GetHalfBlendPiecesReq: Closure_81 = Closure_81 { SplitNumElements: &mut SplitNumElements, NumElements: &mut NumElements };
    let mut CheckHalfBlendUsable: Closure_82 = Closure_82 { SimpleOnly: &mut SimpleOnly, GetHalfBlendPiecesReq: &mut GetHalfBlendPiecesReq };
    let mut HalfBlend: Closure_83 = Closure_83 { SplitNumElements: &mut SplitNumElements, NumElements: &mut NumElements, GetHalfBlendPiecesReq: &mut GetHalfBlendPiecesReq, SimpleOnly: &mut SimpleOnly, DAG: &mut DAG, SplitVT: &mut SplitVT, DL: &mut DL, LoV1: &mut LoV1, HiV1: &mut HiV1, LoV2: &mut LoV2, HiV2: &mut HiV2 };
    if !CheckHalfBlendUsable.call(LoMask) || !CheckHalfBlendUsable.call(HiMask) {
        return SDValue {};
    }
    let mut Lo: SDValue = HalfBlend.call(LoMask);
    let mut Hi: SDValue = HalfBlend.call(HiMask);
    return DAG.getNode(CONCAT_VECTORS, DL, VT, Lo, Hi);
}

fn lowerShuffleAsSplitOrBlend(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(!V2.isUndef(), "This routine must not be used to lower single-input shuffles as it could then recurse on itself.");
    let mut Size: i32 = Mask.len;
    let mut DoBothBroadcast: Closure_84 = Closure_84 { Mask: &mut Mask, Size: &mut Size, V2: &mut V2, V1: &mut V1 };
    if DoBothBroadcast.call() {
        return lowerShuffleAsDecomposedShuffleMerge(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    let mut LaneCount: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut LaneSize: i32 = Size / LaneCount;
    let mut LaneInputs: [2]SmallBitVector = [2]SmallBitVector {};
    LaneInputs[0].resize(LaneCount, false);
    LaneInputs[1].resize(LaneCount, false);
    for let mut i: i32 = 0; i < Size; i += 1 {
        if Mask[i] >= 0 {
            LaneInputs[Mask[i] / Size][(Mask[i] % Size) / LaneSize] = true;
        }
    }
    if LaneInputs[0].count() <= 1 && LaneInputs[1].count() <= 1 {
        return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
    }
    if !Subtarget.hasAVX2() {
        let mut BC1: SDValue = peekThroughBitcasts(V1);
        let mut BC2: SDValue = peekThroughBitcasts(V2);
        let mut SplatOrSplitV1: bool = isFreeToSplitVector(BC1, DAG) || DAG.isSplatValue(BC1, true);
        let mut SplatOrSplitV2: bool = isFreeToSplitVector(BC2, DAG) || DAG.isSplatValue(BC2, true);
        if SplatOrSplitV1 && SplatOrSplitV2 {
            return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
        }
    }
    return lowerShuffleAsDecomposedShuffleMerge(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerShuffleAsLanePermuteAndSHUFP(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT == v4f64, "Only for v4f64 shuffles");
    let mut LHSMask: [4]i32 = [-1, -1, -1, -1];
    let mut RHSMask: [4]i32 = [-1, -1, -1, -1];
    let mut SHUFPDMask: [4]i32 = [-1, -1, -1, -1];
    for let mut i: i32 = 0; i != 4; i += 1 {
        let mut M: i32 = Mask[i];
        if M < 0 {
            continue;
        }
        let mut LaneBase: i32 = i & ~1;
        let mut LaneMask: [4]*mut i32 = if (i & 1) { RHSMask } else { LHSMask };
        LaneMask[LaneBase + (M & 1)] = M;
        SHUFPDMask[i] = M & 1;
    }
    let mut LHS: SDValue = DAG.getVectorShuffle(VT, DL, V1, V2, LHSMask);
    let mut RHS: SDValue = DAG.getVectorShuffle(VT, DL, V1, V2, RHSMask);
    return DAG.getNode(SHUFP, DL, VT, LHS, RHS, getSHUFPDImmForMask(SHUFPDMask, DL, DAG));
}

fn lowerShuffleAsLanePermuteAndPermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumEltsPerLane: i32 = NumElts / NumLanes;
    let mut CanUseSublanes: bool = Subtarget.hasAVX2() && V2.isUndef();
    let mut getSublanePermute: Closure_85 = Closure_85 { NumLanes: &mut NumLanes, NumElts: &mut NumElts, Mask: &mut Mask, NumEltsPerLane: &mut NumEltsPerLane, CanUseSublanes: &mut CanUseSublanes, V1: &mut V1, DAG: &mut DAG, VT: &mut VT, DL: &mut DL, V2: &mut V2 };
    let mut MaxSublaneScale: i32 = 1;
    if CanUseSublanes {
        MaxSublaneScale = if Subtarget.hasFastVariableCrossLaneShuffle() { 4 } else { 2 };
    }
    for let mut SublaneScale: i32 = 1; SublaneScale <= MaxSublaneScale; SublaneScale *= 2 {
        let mut SameMask: bool = false;
        if getSublanePermute.call(NumLanes * SublaneScale, SameMask) {
            V;
        } else {
            return V;
        }
        if SameMask {
            return SDValue {};
        }
    }
    return SDValue {};
}

fn computeInLaneShuffleMask(Mask: *ArrayRef<int>, LaneSize: i32, InLaneMask: *mut SmallVector<int>) {
    let mut Size: i32 = Mask.len;
    InLaneMask.assign(Mask.begin(), Mask.end());
    for let mut i: i32 = 0; i < Size; i += 1 {
        let mut M: *mut i32 = InLaneMask[i];
        if M < 0 {
            continue;
        }
        if ((M % Size) / LaneSize) != (i / LaneSize) {
            M = (M % LaneSize) + ((i / LaneSize) * LaneSize) + Size;
        }
    }
}

fn lowerShuffleAsLanePermuteAndShuffle(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(VT.is256BitVector(), "Only for 256-bit vector shuffles!");
    let mut Size: i32 = Mask.len;
    let mut LaneSize: i32 = Size / 2;
    if VT == v4f64 && !all_of(Mask, Closure_86 { LaneSize: LaneSize }) {
        return lowerShuffleAsLanePermuteAndSHUFP(DL, VT, V1, V2, Mask, DAG);
    }
    let mut AllLanes: bool = false;
    if !Subtarget.hasAVX2() {
        let mut LaneCrossing: [2]bool = [false, false];
        for let mut i: i32 = 0; i < Size; i += 1 {
            if Mask[i] >= 0 && ((Mask[i] % Size) / LaneSize) != (i / LaneSize) {
                LaneCrossing[(Mask[i] % Size) / LaneSize] = true;
            }
        }
        AllLanes = LaneCrossing[0] && LaneCrossing[1];
    } else {
        let mut LaneUsed: [2]bool = [false, false];
        for let mut i: i32 = 0; i < Size; i += 1 {
            if Mask[i] >= 0 {
                LaneUsed[(Mask[i] % Size) / LaneSize] = true;
            }
        }
        AllLanes = LaneUsed[0] && LaneUsed[1];
    }
    assert!(V2.isUndef(), "This last part of this routine only works on single input shuffles");
    let mut InLaneMask: SmallVector<int> = SmallVector<int> {};
    computeInLaneShuffleMask(Mask, Mask.len / 2, InLaneMask);
    assert!(!is128BitLaneCrossingShuffleMask(VT, InLaneMask), "In-lane shuffle mask expected");
    if !AllLanes && !is128BitLaneRepeatedShuffleMask(VT, InLaneMask) {
        return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
    }
    let mut PVT: MVT = if VT.isFloatingPoint() { v4f64 } else { v4i64 };
    let mut Flipped: SDValue = DAG.getBitcast(PVT, V1);
    Flipped = DAG.getVectorShuffle(PVT, DL, Flipped, DAG.getUNDEF(PVT), [2, 3, 0, 1]);
    Flipped = DAG.getBitcast(VT, Flipped);
    return DAG.getVectorShuffle(VT, DL, V1, Flipped, InLaneMask);
}

fn lowerV2X128Shuffle(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if V2.isUndef() {
        let mut SplatLo: bool = isShuffleEquivalent(Mask, [0, 1, 0, 1], V1, SDValue {});
        let mut SplatHi: bool = isShuffleEquivalent(Mask, [2, 3, 2, 3], V1, SDValue {});
        if (SplatLo || SplatHi) && !Subtarget.hasAVX512() && V1.hasOneUse() && mayFoldLoad(peekThroughOneUseBitcasts(V1), Subtarget, false, false) {
            let mut MemVT: MVT = VT.getHalfNumVectorElementsVT();
            let mut Ofs: u32 = if SplatLo { 0 } else { MemVT.getStoreSize().operator unsigned long long() };
            let mut Ld: *mut LoadSDNode = cast(peekThroughOneUseBitcasts(V1));
            if getBROADCAST_LOAD(SUBV_BROADCAST_LOAD, DL, VT, MemVT, Ld, Ofs, DAG) {
                BcstLd;
            } else {
                return BcstLd;
            }
        }
        if Subtarget.hasAVX2() {
            return SDValue {};
        }
    }
    let mut V2IsZero: bool = !V2.isUndef() && isBuildVectorAllZeros(V2.getNode());
    let mut WidenedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    if !canWidenShuffleElements(Mask, Zeroable, V2IsZero, WidenedMask) {
        return SDValue {};
    }
    let mut IsLowZero: bool = (Zeroable & 3) == 3;
    let mut IsHighZero: bool = (Zeroable & 12) == 12;
    if WidenedMask[0] == 0 && IsHighZero {
        let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), 2);
        let mut LoV: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, SubVT, V1, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, VT, getZeroVector(VT, Subtarget, DAG, DL), LoV, DAG.getVectorIdxConstant(0, DL, false));
    }
    if lowerShuffleAsBlend(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if !IsLowZero && !IsHighZero {
        let mut OnlyUsesV1: bool = isShuffleEquivalent(Mask, [0, 1, 0, 1], V1, V2);
        if OnlyUsesV1 || isShuffleEquivalent(Mask, [0, 1, 4, 5], V1, V2) {
            if !isa(peekThroughBitcasts(V1)) {
                let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), 2);
                let mut SubVec: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, SubVT, if OnlyUsesV1 { V1 } else { V2 }, DAG.getVectorIdxConstant(0, DL, false));
                return DAG.getNode(INSERT_SUBVECTOR, DL, VT, V1, SubVec, DAG.getVectorIdxConstant(2, DL, false));
            }
        }
        if Subtarget.hasVLX() {
            if WidenedMask[0] < 2 && WidenedMask[1] >= 2 {
                let mut PermMask: u32 = ((WidenedMask[0] % 2) << 0) | ((WidenedMask[1] % 2) << 1);
                return DAG.getNode(SHUF128, DL, VT, V1, V2, DAG.getTargetConstant(PermMask, DL, i8, false));
            }
        }
    }
    assert!((WidenedMask[0] >= 0 || IsLowZero) && (WidenedMask[1] >= 0 || IsHighZero), "Undef half?");
    let mut PermMask: u32 = 0;
    PermMask |= if IsLowZero { 8 } else { (WidenedMask[0] << 0) };
    PermMask |= if IsHighZero { 128 } else { (WidenedMask[1] << 4) };
    if (PermMask & 10) != 0 && (PermMask & 160) != 0 {
        V1 = DAG.getUNDEF(VT);
    }
    if (PermMask & 10) != 2 && (PermMask & 160) != 32 {
        V2 = DAG.getUNDEF(VT);
    }
    return DAG.getNode(VPERM2X128, DL, VT, V1, V2, DAG.getTargetConstant(PermMask, DL, i8, false));
}

fn lowerShuffleAsLanePermuteAndRepeatedMask(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if V2.isUndef() || is128BitLaneRepeatedShuffleMask(VT, Mask) {
        return SDValue {};
    }
    let mut NumElts: i32 = Mask.len;
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumLaneElts: i32 = 128 / VT.getScalarSizeInBits();
    let mut RepeatMask: SmallVector<int, 16> = SmallVector<int, 16> { NumLaneElts, -1 };
    let mut LaneSrcs: array<int, 2>, 2> = array<int, 2>, 2> { NumLanes, array<int, 2> { [-1, -1] } };
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        let mut Srcs: [2]i32 = [-1, -1];
        let mut InLaneMask: SmallVector<int, 16> = SmallVector<int, 16> { NumLaneElts, -1 };
        for let mut i: i32 = 0; i != NumLaneElts; i += 1 {
            let mut M: i32 = Mask[(Lane * NumLaneElts) + i];
            if M < 0 {
                continue;
            }
            let mut LaneSrc: i32 = M / NumLaneElts;
            let mut Src: i32 = 0;
            if Srcs[0] < 0 || Srcs[0] == LaneSrc {
                Src = 0;
            } else if Srcs[1] < 0 || Srcs[1] == LaneSrc {
                Src = 1;
            } else {
                return SDValue {};
            }
            Srcs[Src] = LaneSrc;
            InLaneMask[i] = (M % NumLaneElts) + Src * NumElts;
        }
        if Srcs[1] < 0 {
            continue;
        }
        LaneSrcs[Lane][0] = Srcs[0];
        LaneSrcs[Lane][1] = Srcs[1];
        let mut MatchMasks: Closure_87 = Closure_87 {};
        let mut MergeMasks: Closure_88 = Closure_88 {};
        if MatchMasks.call(InLaneMask, RepeatMask) {
            MergeMasks.call(InLaneMask, RepeatMask);
            continue;
        }
        swap(LaneSrcs[Lane][0], LaneSrcs[Lane][1]);
        commuteMask(InLaneMask);
        if MatchMasks.call(InLaneMask, RepeatMask) {
            MergeMasks.call(InLaneMask, RepeatMask);
            continue;
        }
        return SDValue {};
    }
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        if LaneSrcs[Lane][0] >= 0 {
            continue;
        }
        for let mut i: i32 = 0; i != NumLaneElts; i += 1 {
            let mut M: i32 = Mask[(Lane * NumLaneElts) + i];
            if M < 0 {
                continue;
            }
            if RepeatMask[i] < 0 {
                RepeatMask[i] = M % NumLaneElts;
            }
            if RepeatMask[i] < NumElts {
                if RepeatMask[i] != M % NumLaneElts {
                    return SDValue {};
                }
                LaneSrcs[Lane][0] = M / NumLaneElts;
            } else {
                if RepeatMask[i] != ((M % NumLaneElts) + NumElts) {
                    return SDValue {};
                }
                LaneSrcs[Lane][1] = M / NumLaneElts;
            }
        }
        if LaneSrcs[Lane][0] < 0 && LaneSrcs[Lane][1] < 0 {
            return SDValue {};
        }
    }
    let mut NewMask: SmallVector<int, 16> = SmallVector<int, 16> { NumElts, -1 };
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        let mut Src: i32 = LaneSrcs[Lane][0];
        for let mut i: i32 = 0; i != NumLaneElts; i += 1 {
            let mut M: i32 = -1;
            if Src >= 0 {
                M = Src * NumLaneElts + i;
            }
            NewMask[Lane * NumLaneElts + i] = M;
        }
    }
    let mut NewV1: SDValue = DAG.getVectorShuffle(VT, DL, V1, V2, NewMask);
    if isa(NewV1) && cast(NewV1).getMask() == Mask {
        return SDValue {};
    }
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        let mut Src: i32 = LaneSrcs[Lane][1];
        for let mut i: i32 = 0; i != NumLaneElts; i += 1 {
            let mut M: i32 = -1;
            if Src >= 0 {
                M = Src * NumLaneElts + i;
            }
            NewMask[Lane * NumLaneElts + i] = M;
        }
    }
    let mut NewV2: SDValue = DAG.getVectorShuffle(VT, DL, V1, V2, NewMask);
    if isa(NewV2) && cast(NewV2).getMask() == Mask {
        return SDValue {};
    }
    for let mut i: i32 = 0; i != NumElts; i += 1 {
        if Mask[i] < 0 {
            NewMask[i] = -1;
            continue;
        }
        NewMask[i] = RepeatMask[i % NumLaneElts];
        if NewMask[i] < 0 {
            continue;
        }
        NewMask[i] += (i / NumLaneElts) * NumLaneElts;
    }
    return DAG.getVectorShuffle(VT, DL, NewV1, NewV2, NewMask);
}

fn getHalfShuffleMask(Mask: ArrayRef<int>, HalfMask: MutableArrayRef<int>, HalfIdx1: *mut i32, HalfIdx2: *mut i32) -> bool {
    assert!((Mask.len == HalfMask.len * 2), "Expected input mask to be twice as long as output");
    let mut UndefLower: bool = isUndefLowerHalf(Mask);
    let mut UndefUpper: bool = isUndefUpperHalf(Mask);
    if UndefLower == UndefUpper {
        return false;
    }
    let mut HalfNumElts: u32 = HalfMask.len;
    let mut MaskIndexOffset: u32 = if UndefLower { HalfNumElts } else { 0 };
    HalfIdx1 = -1;
    HalfIdx2 = -1;
    for let mut i: u32 = 0; i != HalfNumElts; i += 1 {
        let mut M: i32 = Mask[i + MaskIndexOffset];
        if M < 0 {
            HalfMask[i] = M;
            continue;
        }
        let mut HalfIdx: i32 = M / HalfNumElts;
        let mut HalfElt: i32 = M % HalfNumElts;
        if HalfIdx1 < 0 || HalfIdx1 == HalfIdx {
            HalfMask[i] = HalfElt;
            HalfIdx1 = HalfIdx;
            continue;
        }
        if HalfIdx2 < 0 || HalfIdx2 == HalfIdx {
            HalfMask[i] = HalfElt + HalfNumElts;
            HalfIdx2 = HalfIdx;
            continue;
        }
        return false;
    }
    return true;
}

fn getShuffleHalfVectors(DL: *SDLoc, V1: SDValue, V2: SDValue, HalfMask: ArrayRef<int>, HalfIdx1: i32, HalfIdx2: i32, UndefLower: bool, DAG: *mut SelectionDAG, UseConcat: bool) -> SDValue {
    assert!(V1.getValueType() == V2.getValueType(), "Different sized vectors?");
    assert!(V1.getValueType().isSimple(), "Expecting only simple types");
    let mut VT: MVT = V1.getSimpleValueType();
    let mut HalfVT: MVT = VT.getHalfNumVectorElementsVT();
    let mut HalfNumElts: u32 = HalfVT.getVectorNumElements();
    let mut getHalfVector: Closure_89 = Closure_89 { DAG: &mut DAG, HalfVT: &mut HalfVT, V1: &mut V1, V2: &mut V2, HalfNumElts: &mut HalfNumElts, DL: &mut DL };
    let mut Half1: SDValue = getHalfVector.call(HalfIdx1);
    let mut Half2: SDValue = getHalfVector.call(HalfIdx2);
    let mut V: SDValue = DAG.getVectorShuffle(HalfVT, DL, Half1, Half2, HalfMask);
    if UseConcat {
        let mut Op0: SDValue = V;
        let mut Op1: SDValue = DAG.getUNDEF(HalfVT);
        if UndefLower {
            swap(Op0, Op1);
        }
        return DAG.getNode(CONCAT_VECTORS, DL, VT, Op0, Op1);
    }
    let mut Offset: u32 = if UndefLower { HalfNumElts } else { 0 };
    return DAG.getNode(INSERT_SUBVECTOR, DL, VT, DAG.getUNDEF(VT), V, DAG.getVectorIdxConstant(Offset, DL, false));
}

fn lowerShuffleWithUndefHalf(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!((VT.is256BitVector() || VT.is512BitVector()), "Expected 256-bit or 512-bit vector");
    let mut UndefLower: bool = isUndefLowerHalf(Mask);
    if !UndefLower && !isUndefUpperHalf(Mask) {
        return SDValue {};
    }
    assert!((!UndefLower || !isUndefUpperHalf(Mask)), "Completely undef shuffle mask should have been simplified already");
    let mut HalfVT: MVT = VT.getHalfNumVectorElementsVT();
    let mut HalfNumElts: u32 = HalfVT.getVectorNumElements();
    if !UndefLower && isSequentialOrUndefInRange(Mask, 0, HalfNumElts, HalfNumElts, 1) {
        let mut Hi: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, HalfVT, V1, DAG.getVectorIdxConstant(HalfNumElts, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, VT, DAG.getUNDEF(VT), Hi, DAG.getVectorIdxConstant(0, DL, false));
    }
    if UndefLower && isSequentialOrUndefInRange(Mask, HalfNumElts, HalfNumElts, 0, 1) {
        let mut Hi: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, HalfVT, V1, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, VT, DAG.getUNDEF(VT), Hi, DAG.getVectorIdxConstant(HalfNumElts, DL, false));
    }
    let mut HalfIdx1: i32 = 0;
    let mut HalfIdx2: i32 = 0;
    let mut HalfMask: SmallVector<int, 8> = HalfNumElts;
    if !getHalfShuffleMask(Mask, HalfMask, HalfIdx1, HalfIdx2) {
        return SDValue {};
    }
    assert!(HalfMask.len == HalfNumElts, "Unexpected shuffle mask length");
    let mut NumLowerHalves: u32 = (HalfIdx1 == 0 || HalfIdx1 == 2) + (HalfIdx2 == 0 || HalfIdx2 == 2);
    let mut NumUpperHalves: u32 = (HalfIdx1 == 1 || HalfIdx1 == 3) + (HalfIdx2 == 1 || HalfIdx2 == 3);
    assert!(NumLowerHalves + NumUpperHalves <= 2, "Only 1 or 2 halves allowed");
    let mut EltWidth: u32 = VT.getVectorElementType().getSizeInBits().operator unsigned long long();
    if !UndefLower {
        if NumUpperHalves == 0 {
            return getShuffleHalfVectors(DL, V1, V2, HalfMask, HalfIdx1, HalfIdx2, UndefLower, DAG, false);
        }
        if NumUpperHalves == 1 {
            if Subtarget.hasAVX2() {
                if EltWidth == 32 && NumLowerHalves && HalfVT.is128BitVector() && !is128BitUnpackShuffleMask(HalfMask, DAG) && (!isSingleSHUFPSMask(HalfMask) || Subtarget.hasFastVariableCrossLaneShuffle()) {
                    return SDValue {};
                }
                if EltWidth == 64 && V2.isUndef() {
                    return SDValue {};
                }
                if EltWidth == 8 && HalfIdx1 == 0 && HalfIdx2 == 1 {
                    return SDValue {};
                }
            }
            if Subtarget.hasAVX512() && VT.is512BitVector() {
                return SDValue {};
            }
            return getShuffleHalfVectors(DL, V1, V2, HalfMask, HalfIdx1, HalfIdx2, UndefLower, DAG, false);
        }
        assert!(NumUpperHalves == 2, "Half vector count went wrong");
        return SDValue {};
    }
    if NumUpperHalves == 0 {
        if Subtarget.hasAVX2() && EltWidth == 64 {
            return SDValue {};
        }
        if Subtarget.hasAVX512() && VT.is512BitVector() {
            return SDValue {};
        }
        return getShuffleHalfVectors(DL, V1, V2, HalfMask, HalfIdx1, HalfIdx2, UndefLower, DAG, false);
    }
    return SDValue {};
}

fn lowerShuffleAsRepeatedMaskAndLanePermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumLaneElts: i32 = NumElts / NumLanes;
    if Subtarget.hasAVX2() {
        for BroadcastSize in [16, 32, 64] {
            if BroadcastSize <= VT.getScalarSizeInBits() {
                continue;
            }
            let mut NumBroadcastElts: i32 = BroadcastSize / VT.getScalarSizeInBits();
            let mut FindRepeatingBroadcastMask: Closure_90 = Closure_90 { NumElts: &mut NumElts, NumBroadcastElts: &mut NumBroadcastElts, Mask: &mut Mask, NumLaneElts: &mut NumLaneElts };
            let mut RepeatMask: SmallVector<int, 8> = SmallVector<int, 8> { NumElts as u32, -1 };
            if !FindRepeatingBroadcastMask.call(RepeatMask) {
                continue;
            }
            let mut RepeatShuf: SDValue = DAG.getVectorShuffle(VT, DL, V1, V2, RepeatMask);
            let mut BroadcastMask: SmallVector<int, 8> = SmallVector<int, 8> { NumElts as u32, -1 };
            for let mut i: i32 = 0; i != NumElts; i += NumBroadcastElts {
                for let mut j: i32 = 0; j != NumBroadcastElts; j += 1 {
                    BroadcastMask[i + j] = j;
                }
            }
            if BroadcastMask == Mask {
                return SDValue {};
            }
            return DAG.getVectorShuffle(VT, DL, RepeatShuf, DAG.getUNDEF(VT), BroadcastMask);
        }
    }
    if !is128BitLaneCrossingShuffleMask(VT, Mask) {
        return SDValue {};
    }
    if is128BitLaneRepeatedShuffleMask(VT, Mask) {
        return SDValue {};
    }
    let mut ShuffleSubLanes: Closure_91 = Closure_91 { NumLanes: &mut NumLanes, NumLaneElts: &mut NumLaneElts, Mask: &mut Mask, NumElts: &mut NumElts, DAG: &mut DAG, VT: &mut VT, DL: &mut DL, V1: &mut V1, V2: &mut V2 };
    let mut MinSubLaneScale: i32 = 1;
    let mut MaxSubLaneScale: i32 = 1;
    if Subtarget.hasAVX2() && VT.is256BitVector() {
        let mut OnlyLowestElts: bool = isUndefOrInRange(Mask, 0, NumLaneElts);
        MinSubLaneScale = 2;
        MaxSubLaneScale = if (!OnlyLowestElts && V2.isUndef() && VT == v32i8) { 4 } else { 2 };
    }
    if Subtarget.hasBWI() && VT == v64i8 {
        MinSubLaneScale = MaxSubLaneScale = 4;
    }
    for let mut Scale: i32 = MinSubLaneScale; Scale <= MaxSubLaneScale; Scale *= 2 {
        if ShuffleSubLanes.call(Scale) {
            Shuffle;
        } else {
            return Shuffle;
        }
    }
    return SDValue {};
}

fn matchShuffleWithSHUFPD(VT: MVT, V1: *mut SDValue, V2: *mut SDValue, ForceV1Zero: *mut bool, ForceV2Zero: *mut bool, ShuffleImm: *mut u32, Mask: ArrayRef<int>, Zeroable: *APInt) -> bool {
    let mut NumElts: i32 = VT.getVectorNumElements();
    assert!(VT.getScalarSizeInBits() == 64 && (NumElts == 2 || NumElts == 4 || NumElts == 8), "Unexpected data type for VSHUFPD");
    assert!(isUndefOrZeroOrInRange(Mask, 0, 2 * NumElts), "Illegal shuffle mask");
    let mut ZeroLane: [2]bool = [true, true];
    for let mut i: i32 = 0; i < NumElts; i += 1 {
        ZeroLane[i & 1] &= Zeroable[i];
    }
    let mut IsSHUFPD: bool = true;
    let mut IsCommutable: bool = true;
    let mut SHUFPDMask: SmallVector<int, 8> = SmallVector<int, 8> { NumElts, -1 };
    for let mut i: i32 = 0; i < NumElts; i += 1 {
        if Mask[i] == SM_SentinelUndef || ZeroLane[i & 1] {
            continue;
        }
        if Mask[i] < 0 {
            return false;
        }
        let mut Val: i32 = (i & 6) + NumElts * (i & 1);
        let mut CommutVal: i32 = (i & 14) + NumElts * ((i & 1) ^ 1);
        if Mask[i] < Val || Mask[i] > Val + 1 {
            IsSHUFPD = false;
        }
        if Mask[i] < CommutVal || Mask[i] > CommutVal + 1 {
            IsCommutable = false;
        }
        SHUFPDMask[i] = Mask[i] % 2;
    }
    if !IsSHUFPD && !IsCommutable {
        return false;
    }
    if !IsSHUFPD && IsCommutable {
        swap(V1, V2);
    }
    ForceV1Zero = ZeroLane[0];
    ForceV2Zero = ZeroLane[1];
    ShuffleImm = getSHUFPDImm(SHUFPDMask);
    return true;
}

fn lowerShuffleWithSHUFPD(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!((VT == v2f64 || VT == v4f64 || VT == v8f64), "Unexpected data type for VSHUFPD");
    let mut Immediate: u32 = 0;
    let mut ForceV1Zero: bool = false;
    let mut ForceV2Zero: bool = false;
    if !matchShuffleWithSHUFPD(VT, V1, V2, ForceV1Zero, ForceV2Zero, Immediate, Mask, Zeroable) {
        return SDValue {};
    }
    if ForceV1Zero {
        V1 = getZeroVector(VT, Subtarget, DAG, DL);
    }
    if ForceV2Zero {
        V2 = getZeroVector(VT, Subtarget, DAG, DL);
    }
    return DAG.getNode(SHUFP, DL, VT, V1, V2, DAG.getTargetConstant(Immediate, DL, i8, false));
}

fn lowerShuffleAsVTRUNCAndUnpack(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT == v32i8, "Unexpected type!");
    if !isSequentialOrUndefInRange(Mask, 0, 8, 0, 8) {
        return SDValue {};
    }
    if Zeroable.countl_one() < (Mask.len - 8) {
        return SDValue {};
    }
    V1 = DAG.getBitcast(v4i64, V1);
    V2 = DAG.getBitcast(v4i64, V2);
    V1 = DAG.getNode(VTRUNC, DL, v16i8, V1);
    V2 = DAG.getNode(VTRUNC, DL, v16i8, V2);
    let mut Unpack: SDValue = DAG.getVectorShuffle(v16i8, DL, V1, V2, [0, 1, 2, 3, 16, 17, 18, 19, 4, 5, 6, 7, 20, 21, 22, 23]);
    return DAG.getNode(INSERT_SUBVECTOR, DL, v32i8, DAG.getConstant(0, DL, v32i8, false, false), Unpack, DAG.getVectorIdxConstant(0, DL, false));
}

fn lowerShufflePairAsUNPCKAndPermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    if VT != v8f32 && VT != v8i32 && VT != v16i16 && VT != v32i8 {
        return SDValue {};
    }
    let mut IsInterleavingPattern: Closure_93 = Closure_93 {};
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut FirstQtr: u64 = NumElts / 2;
    let mut ThirdQtr: u64 = NumElts + NumElts / 2;
    let mut IsFirstHalf: bool = IsInterleavingPattern.call(Mask, 0, NumElts);
    let mut IsSecondHalf: bool = IsInterleavingPattern.call(Mask, FirstQtr, ThirdQtr);
    if !IsFirstHalf && !IsSecondHalf {
        return SDValue {};
    }
    let mut Shuffles: SmallVector<SDNode *, 2> = SmallVector<SDNode *, 2> {};
    for User in operator(V1).users() {
        if User.getOpcode() == VECTOR_SHUFFLE && User.getOperand(0) == V1 && User.getOperand(1) == V2 {
            Shuffles.push(User);
        }
    }
    if Shuffles.len != 2 {
        return SDValue {};
    }
    let mut SVN1: *mut ShuffleVectorSDNode = cast(Shuffles[0]);
    let mut SVN2: *mut ShuffleVectorSDNode = cast(Shuffles[1]);
    let mut FirstHalf: *mut SDNode = null;
    let mut SecondHalf: *mut SDNode = null;
    if IsInterleavingPattern.call(SVN1.getMask(), 0, NumElts) && IsInterleavingPattern.call(SVN2.getMask(), FirstQtr, ThirdQtr) {
        FirstHalf = Shuffles[0];
        SecondHalf = Shuffles[1];
    } else if IsInterleavingPattern.call(SVN1.getMask(), FirstQtr, ThirdQtr) && IsInterleavingPattern.call(SVN2.getMask(), 0, NumElts) {
        FirstHalf = Shuffles[1];
        SecondHalf = Shuffles[0];
    } else {
        return SDValue {};
    }
    let mut Unpckl: SDValue = DAG.getNode(UNPCKL, DL, VT, V1, V2);
    let mut Unpckh: SDValue = DAG.getNode(UNPCKH, DL, VT, V1, V2);
    let mut Perm1: SDValue = DAG.getNode(VPERM2X128, DL, VT, Unpckl, Unpckh, DAG.getTargetConstant(32, DL, i8, false));
    let mut Perm2: SDValue = DAG.getNode(VPERM2X128, DL, VT, Unpckl, Unpckh, DAG.getTargetConstant(49, DL, i8, false));
    if IsFirstHalf {
        DAG.ReplaceAllUsesWith(SecondHalf, &mut Perm2);
        return Perm1;
    }
    DAG.ReplaceAllUsesWith(FirstHalf, &mut Perm1);
    return Perm2;
}

fn lowerV4F64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4f64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4f64, "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    if lowerV2X128Shuffle(DL, v4f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() {
        if lowerShuffleAsBroadcast(DL, v4f64, V1, V2, Mask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        if isShuffleEquivalent(Mask, [0, 0, 2, 2], V1, V2) {
            return DAG.getNode(MOVDDUP, DL, v4f64, V1);
        }
        if !is128BitLaneCrossingShuffleMask(v4f64, Mask) {
            let mut VPERMILPMask: u32 = (Mask[0] == 1) | ((Mask[1] == 1) << 1) | ((Mask[2] == 3) << 2) | ((Mask[3] == 3) << 3);
            return DAG.getNode(VPERMILPI, DL, v4f64, V1, DAG.getTargetConstant(VPERMILPMask, DL, i8, false));
        }
        if Subtarget.hasAVX2() {
            return DAG.getNode(VPERMI, DL, v4f64, V1, getV4X86ShuffleImm8ForMask(Mask, DL, DAG));
        }
        if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v4f64, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsLanePermuteAndPermute(DL, v4f64, V1, V2, Mask, DAG, Subtarget) {
            V;
        } else {
            return V;
        }
        return lowerShuffleAsLanePermuteAndShuffle(DL, v4f64, V1, V2, Mask, DAG, Subtarget);
    }
    if lowerShuffleAsBlend(DL, v4f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleWithUNPCK(DL, v4f64, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithSHUFPD(DL, v4f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Op;
    } else {
        return Op;
    }
    let mut V1IsInPlace: bool = isShuffleMaskInputInPlace(0, Mask);
    let mut V2IsInPlace: bool = isShuffleMaskInputInPlace(1, Mask);
    let mut V1IsSplat: bool = isShuffleMaskInputBroadcastable(0, Mask, 0);
    let mut V2IsSplat: bool = isShuffleMaskInputBroadcastable(1, Mask, 0);
    if is128BitLaneCrossingShuffleMask(v4f64, Mask) && !all_of(Mask, Closure_94 {}) && (V1.getOpcode() != BUILD_VECTOR) && (V2.getOpcode() != BUILD_VECTOR) && (!Subtarget.hasAVX2() || !((V1IsInPlace || V1IsSplat) && (V2IsInPlace || V2IsSplat))) {
        return lowerShuffleAsLanePermuteAndSHUFP(DL, v4f64, V1, V2, Mask, DAG);
    }
    if V1IsInPlace || V2IsInPlace {
        return lowerShuffleAsDecomposedShuffleMerge(DL, v4f64, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v4f64, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if !(Subtarget.hasAVX2() && (V1IsInPlace || V2IsInPlace)) {
        if lowerShuffleAsLanePermuteAndRepeatedMask(DL, v4f64, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if Subtarget.hasVLX() {
        if lowerShuffleWithEXPAND(DL, v4f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if Subtarget.hasAVX2() {
        return lowerShuffleAsDecomposedShuffleMerge(DL, v4f64, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    return lowerShuffleAsSplitOrBlend(DL, v4f64, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV4I64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v4i64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v4i64, "Bad operand type!");
    assert!(Mask.len == 4, "Unexpected mask size for v4 shuffle!");
    assert!(Subtarget.hasAVX2(), "We can only lower v4i64 with AVX2!");
    if lowerV2X128Shuffle(DL, v4i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlend(DL, v4i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsBroadcast(DL, v4i64, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if Subtarget.preferLowerShuffleAsShift() {
        if lowerShuffleAsShift(DL, v4i64, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
    }
    if V2.isUndef() {
        let mut RepeatedMask: SmallVector<int, 2> = SmallVector<int, 2> {};
        if is128BitLaneRepeatedShuffleMask(v4i64, Mask, RepeatedMask) {
            let mut PSHUFDMask: SmallVector<int, 4> = SmallVector<int, 4> {};
            narrowShuffleMaskElts(2, RepeatedMask, PSHUFDMask);
            return DAG.getBitcast(v4i64, DAG.getNode(PSHUFD, DL, v8i32, DAG.getBitcast(v8i32, V1), getV4X86ShuffleImm8ForMask(PSHUFDMask, DL, DAG)));
        }
        return DAG.getNode(VPERMI, DL, v4i64, V1, getV4X86ShuffleImm8ForMask(Mask, DL, DAG));
    }
    if lowerShuffleAsShift(DL, v4i64, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if Subtarget.hasVLX() {
        if lowerShuffleAsVALIGN(DL, v4i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithEXPAND(DL, v4i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsByteRotate(DL, v4i64, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleWithUNPCK(DL, v4i64, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    let mut V1IsInPlace: bool = isShuffleMaskInputInPlace(0, Mask);
    let mut V2IsInPlace: bool = isShuffleMaskInputInPlace(1, Mask);
    if V1IsInPlace || V2IsInPlace {
        return lowerShuffleAsDecomposedShuffleMerge(DL, v4i64, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v4i64, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlendAndPermute(DL, v4i64, V1, V2, Mask, DAG, false) {
        V;
    } else {
        return V;
    }
    if !V1IsInPlace && !V2IsInPlace {
        if lowerShuffleAsLanePermuteAndRepeatedMask(DL, v4i64, V1, V2, Mask, Subtarget, DAG) {
            Result;
        } else {
            return Result;
        }
    }
    return lowerShuffleAsDecomposedShuffleMerge(DL, v4i64, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV8F32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8f32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8f32, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    if lowerShuffleAsBlend(DL, v8f32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsBroadcast(DL, v8f32, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if !Subtarget.hasAVX2() {
        let mut InLaneMask: SmallVector<int> = SmallVector<int> {};
        computeInLaneShuffleMask(Mask, Mask.len / 2, InLaneMask);
        if !is128BitLaneRepeatedShuffleMask(v8f32, InLaneMask) {
            if splitAndLowerShuffle(DL, v8f32, V1, V2, Mask, DAG, true) {
                R;
            } else {
                return R;
            }
        }
    }
    if lowerShuffleAsZeroOrAnyExtend(DL, v8i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return DAG.getBitcast(v8f32, ZExt);
    }
    let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    if is128BitLaneRepeatedShuffleMask(v8f32, Mask, RepeatedMask) {
        assert!(RepeatedMask.len == 4, "Repeated masks must be half the mask width!");
        if isShuffleEquivalent(RepeatedMask, [0, 0, 2, 2], V1, V2) {
            return DAG.getNode(MOVSLDUP, DL, v8f32, V1);
        }
        if isShuffleEquivalent(RepeatedMask, [1, 1, 3, 3], V1, V2) {
            return DAG.getNode(MOVSHDUP, DL, v8f32, V1);
        }
        if V2.isUndef() {
            return DAG.getNode(VPERMILPI, DL, v8f32, V1, getV4X86ShuffleImm8ForMask(RepeatedMask, DL, DAG));
        }
        if lowerShuffleWithUNPCK(DL, v8f32, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        return lowerShuffleWithSHUFPS(DL, v8f32, RepeatedMask, V1, V2, DAG);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v8f32, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() {
        if !is128BitLaneCrossingShuffleMask(v8f32, Mask) {
            let mut VPermMask: SDValue = getConstVector(Mask, v8i32, DAG, DL, true);
            return DAG.getNode(VPERMILPV, DL, v8f32, V1, VPermMask);
        }
        if Subtarget.hasAVX2() {
            let mut VPermMask: SDValue = getConstVector(Mask, v8i32, DAG, DL, true);
            return DAG.getNode(VPERMV, DL, v8f32, VPermMask, V1);
        }
        return lowerShuffleAsLanePermuteAndShuffle(DL, v8f32, V1, V2, Mask, DAG, Subtarget);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, v8f32, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    if Subtarget.hasVLX() {
        if lowerShuffleWithEXPAND(DL, v8f32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if (Subtarget.hasAVX2() || !(isFreeToSplitVector(peekThroughBitcasts(V1), DAG) || isFreeToSplitVector(peekThroughBitcasts(V2), DAG))) && !Subtarget.hasAVX512() {
        if lowerShufflePairAsUNPCKAndPermute(DL, v8f32, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    if !Subtarget.hasAVX512() && isUnpackWdShuffleMask(Mask, v8f32, DAG) {
        return lowerShuffleAsSplitOrBlend(DL, v8f32, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    if Subtarget.hasAVX2() {
        return lowerShuffleAsDecomposedShuffleMerge(DL, v8f32, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    return lowerShuffleAsSplitOrBlend(DL, v8f32, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV8I32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8i32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8i32, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    assert!(Subtarget.hasAVX2(), "We can only lower v8i32 with AVX2!");
    let mut NumV2Elements: i32 = count_if(Mask, Closure_95 {});
    if lowerShuffleAsZeroOrAnyExtend(DL, v8i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if !Subtarget.hasAVX512() {
        if lowerShufflePairAsUNPCKAndPermute(DL, v8i32, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    if isUnpackWdShuffleMask(Mask, v8i32, DAG) && !V2.isUndef() && !Subtarget.hasAVX512() {
        return lowerShuffleAsSplitOrBlend(DL, v8i32, V1, V2, Mask, Zeroable, Subtarget, DAG);
    }
    if lowerShuffleAsBlend(DL, v8i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsBroadcast(DL, v8i32, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if Subtarget.preferLowerShuffleAsShift() {
        if lowerShuffleAsShift(DL, v8i32, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
        if NumV2Elements == 0 {
            if lowerShuffleAsBitRotate(DL, v8i32, V1, Mask, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
    }
    let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    let mut Is128BitLaneRepeatedShuffle: bool = is128BitLaneRepeatedShuffleMask(v8i32, Mask, RepeatedMask);
    if Is128BitLaneRepeatedShuffle {
        assert!(RepeatedMask.len == 4, "Unexpected repeated mask size!");
        if V2.isUndef() {
            return DAG.getNode(PSHUFD, DL, v8i32, V1, getV4X86ShuffleImm8ForMask(RepeatedMask, DL, DAG));
        }
        if lowerShuffleWithUNPCK(DL, v8i32, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsShift(DL, v8i32, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if !Subtarget.preferLowerShuffleAsShift() && NumV2Elements == 0 {
        if lowerShuffleAsBitRotate(DL, v8i32, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if Subtarget.hasVLX() {
        if lowerShuffleAsVALIGN(DL, v8i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithEXPAND(DL, v8i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsByteRotate(DL, v8i32, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v8i32, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() {
        if lowerShuffleWithUNPCK256(DL, v8i32, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        let mut VPermMask: SDValue = getConstVector(Mask, v8i32, DAG, DL, true);
        return DAG.getNode(VPERMV, DL, v8i32, VPermMask, V1);
    }
    if Is128BitLaneRepeatedShuffle && isSingleSHUFPSMask(RepeatedMask) {
        let mut CastV1: SDValue = DAG.getBitcast(v8f32, V1);
        let mut CastV2: SDValue = DAG.getBitcast(v8f32, V2);
        let mut ShufPS: SDValue = lowerShuffleWithSHUFPS(DL, v8f32, RepeatedMask, CastV1, CastV2, DAG);
        return DAG.getBitcast(v8i32, ShufPS);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, v8i32, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    return lowerShuffleAsDecomposedShuffleMerge(DL, v8i32, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV16I16Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v16i16, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v16i16, "Bad operand type!");
    assert!(Mask.len == 16, "Unexpected mask size for v16 shuffle!");
    assert!(Subtarget.hasAVX2(), "We can only lower v16i16 with AVX2!");
    if lowerShuffleAsZeroOrAnyExtend(DL, v16i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleAsBroadcast(DL, v16i16, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if lowerShuffleAsBlend(DL, v16i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleWithUNPCK(DL, v16i16, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, v16i16, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVTRUNC(DL, v16i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsShift(DL, v16i16, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, v16i16, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v16i16, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() {
        if lowerShuffleAsBitRotate(DL, v16i16, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        if lowerShuffleWithUNPCK256(DL, v16i16, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        if is128BitLaneCrossingShuffleMask(v16i16, Mask) {
            if lowerShuffleAsLanePermuteAndPermute(DL, v16i16, V1, V2, Mask, DAG, Subtarget) {
                V;
            } else {
                return V;
            }
            return lowerShuffleAsLanePermuteAndShuffle(DL, v16i16, V1, V2, Mask, DAG, Subtarget);
        }
        let mut RepeatedMask: SmallVector<int, 8> = SmallVector<int, 8> {};
        if is128BitLaneRepeatedShuffleMask(v16i16, Mask, RepeatedMask) {
            return lowerV8I16GeneralSingleInputShuffle(DL, v16i16, V1, RepeatedMask, Subtarget, DAG);
        }
    }
    if lowerShuffleWithPSHUFB(DL, v16i16, Mask, V1, V2, Zeroable, Subtarget, DAG) {
        PSHUFB;
    } else {
        return PSHUFB;
    }
    if Subtarget.hasBWI() {
        return lowerShuffleWithPERMV(DL, v16i16, Mask, V1, V2, Subtarget, DAG);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, v16i16, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    if lowerShuffleAsLanePermuteAndPermute(DL, v16i16, V1, V2, Mask, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if !Subtarget.hasAVX512() {
        if lowerShufflePairAsUNPCKAndPermute(DL, v16i16, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    return lowerShuffleAsSplitOrBlend(DL, v16i16, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lowerV32I8Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v32i8, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v32i8, "Bad operand type!");
    assert!(Mask.len == 32, "Unexpected mask size for v32 shuffle!");
    assert!(Subtarget.hasAVX2(), "We can only lower v32i8 with AVX2!");
    if lowerShuffleAsZeroOrAnyExtend(DL, v32i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleAsBroadcast(DL, v32i8, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if lowerShuffleAsBlend(DL, v32i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleWithUNPCK(DL, v32i8, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, v32i8, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVTRUNC(DL, v32i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsShift(DL, v32i8, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, v32i8, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if V2.isUndef() {
        if lowerShuffleAsBitRotate(DL, v32i8, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v32i8, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() && is128BitLaneCrossingShuffleMask(v32i8, Mask) {
        if lowerShuffleWithUNPCK256(DL, v32i8, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsLanePermuteAndPermute(DL, v32i8, V1, V2, Mask, DAG, Subtarget) {
            V;
        } else {
            return V;
        }
        return lowerShuffleAsLanePermuteAndShuffle(DL, v32i8, V1, V2, Mask, DAG, Subtarget);
    }
    if lowerShuffleWithPSHUFB(DL, v32i8, Mask, V1, V2, Zeroable, Subtarget, DAG) {
        PSHUFB;
    } else {
        return PSHUFB;
    }
    if Subtarget.hasVBMI() {
        return lowerShuffleWithPERMV(DL, v32i8, Mask, V1, V2, Subtarget, DAG);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, v32i8, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    if lowerShuffleAsLanePermuteAndPermute(DL, v32i8, V1, V2, Mask, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if Subtarget.hasVLX() {
        if lowerShuffleAsVTRUNCAndUnpack(DL, v32i8, V1, V2, Mask, Zeroable, DAG) {
            V;
        } else {
            return V;
        }
    }
    if !Subtarget.hasAVX512() {
        if lowerShufflePairAsUNPCKAndPermute(DL, v32i8, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    return lowerShuffleAsSplitOrBlend(DL, v32i8, V1, V2, Mask, Zeroable, Subtarget, DAG);
}

fn lower256BitShuffle(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut NumV2Elements: i32 = count_if(Mask, Closure_96 { NumElts: NumElts });
    if NumV2Elements == 1 && Mask[0] >= NumElts {
        if lowerShuffleAsElementInsertion(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Insertion;
        } else {
            return Insertion;
        }
    }
    if lowerShuffleWithUndefHalf(DL, VT, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if VT.isInteger() && !Subtarget.hasAVX2() {
        let mut ElementBits: i32 = VT.getScalarSizeInBits();
        if ElementBits < 32 {
            if lowerShuffleAsBitMask(DL, VT, V1, V2, Mask, Zeroable, DAG) {
                V;
            } else {
                return V;
            }
            if lowerShuffleAsBitBlend(DL, VT, V1, V2, Mask, DAG) {
                V;
            } else {
                return V;
            }
            return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
        }
        let mut FpVT: MVT = getVectorVT(getFloatingPointVT(ElementBits), VT.getVectorNumElements());
        V1 = DAG.getBitcast(FpVT, V1);
        V2 = DAG.getBitcast(FpVT, V2);
        return DAG.getBitcast(VT, DAG.getVectorShuffle(FpVT, DL, V1, V2, Mask));
    }
    if VT == v16f16 || VT == v16bf16 {
        V1 = DAG.getBitcast(v16i16, V1);
        V2 = DAG.getBitcast(v16i16, V2);
        return DAG.getBitcast(VT, DAG.getVectorShuffle(v16i16, DL, V1, V2, Mask));
    }
    match VT.SimpleTy {
        v4f64 => {
            return lowerV4F64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v4i64 => {
            return lowerV4I64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8f32 => {
            return lowerV8F32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8i32 => {
            return lowerV8I32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v16i16 => {
            return lowerV16I16Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v32i8 => {
            return lowerV32I8Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        _ => {
            llvm_unreachable_internal("Not a valid 256-bit x86 vector type!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 17652);
        },
    }
}

fn lowerV4X128Shuffle(DL: *SDLoc, VT: MVT, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT.getScalarSizeInBits() == 64, "Unexpected element type size for 128bit shuffle.");
    assert!(VT.is512BitVector(), "Unexpected vector size for 512bit shuffle.");
    let mut Widened128Mask: SmallVector<int, 4> = SmallVector<int, 4> {};
    if !canWidenShuffleElements(Mask, Widened128Mask) {
        return SDValue {};
    }
    assert!(Widened128Mask.len == 4, "Shuffle widening mismatch");
    if Widened128Mask[0] == 0 && (Zeroable & 240) == 240 && (Widened128Mask[1] == 1 || (Zeroable & 12) == 12) {
        let mut NumElts: u32 = if ((Zeroable & 12) == 12) { 2 } else { 4 };
        let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), NumElts);
        let mut LoV: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, SubVT, V1, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, VT, getZeroVector(VT, Subtarget, DAG, DL), LoV, DAG.getVectorIdxConstant(0, DL, false));
    }
    let mut OnlyUsesV1: bool = isShuffleEquivalent(Mask, [0, 1, 2, 3, 0, 1, 2, 3], V1, V2);
    if OnlyUsesV1 || isShuffleEquivalent(Mask, [0, 1, 2, 3, 8, 9, 10, 11], V1, V2) {
        let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), 4);
        let mut SubVec: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, SubVT, if OnlyUsesV1 { V1 } else { V2 }, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, VT, V1, SubVec, DAG.getVectorIdxConstant(4, DL, false));
    }
    let mut IsInsert: bool = true;
    let mut V2Index: i32 = -1;
    for let mut i: i32 = 0; i < 4; i += 1 {
        assert!(Widened128Mask[i] >= -1, "Illegal shuffle sentinel value");
        if Widened128Mask[i] < 0 {
            continue;
        }
        if Widened128Mask[i] < 4 {
            if Widened128Mask[i] != i {
                IsInsert = false;
                break;
            }
        } else {
            if V2Index >= 0 || Widened128Mask[i] != 4 {
                IsInsert = false;
                break;
            }
            V2Index = i;
        }
    }
    if IsInsert && V2Index >= 0 {
        let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), 2);
        let mut Subvec: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, SubVT, V2, DAG.getVectorIdxConstant(0, DL, false));
        return insert128BitVector(V1, Subvec, V2Index * 2, DAG, DL);
    }
    let mut Widened256Mask: SmallVector<int, 2> = SmallVector<int, 2> {};
    if canWidenShuffleElements(Widened128Mask, Widened256Mask) {
        Widened128Mask.clear();
        narrowShuffleMaskElts(2, Widened256Mask, Widened128Mask);
    }
    let mut Ops: [2]SDValue = [DAG.getUNDEF(VT), DAG.getUNDEF(VT)];
    let mut PermMask: [4]i32 = [-1, -1, -1, -1];
    for let mut i: i32 = 0; i < 4; i += 1 {
        assert!(Widened128Mask[i] >= -1, "Illegal shuffle sentinel value");
        if Widened128Mask[i] < 0 {
            continue;
        }
        let mut Op: SDValue = if Widened128Mask[i] >= 4 { V2 } else { V1 };
        let mut OpIndex: u32 = i / 2;
        if Ops[OpIndex].isUndef() {
            Ops[OpIndex] = Op;
        } else if Ops[OpIndex] != Op {
            return SDValue {};
        }
        PermMask[i] = Widened128Mask[i] % 4;
    }
    return DAG.getNode(SHUF128, DL, VT, Ops[0], Ops[1], getV4X86ShuffleImm8ForMask(PermMask, DL, DAG));
}

fn lowerV8F64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8f64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8f64, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    if V2.isUndef() {
        if isShuffleEquivalent(Mask, [0, 0, 2, 2, 4, 4, 6, 6], V1, V2) {
            return DAG.getNode(MOVDDUP, DL, v8f64, V1);
        }
        if !is128BitLaneCrossingShuffleMask(v8f64, Mask) {
            let mut VPERMILPMask: u32 = (Mask[0] == 1) | ((Mask[1] == 1) << 1) | ((Mask[2] == 3) << 2) | ((Mask[3] == 3) << 3) | ((Mask[4] == 5) << 4) | ((Mask[5] == 5) << 5) | ((Mask[6] == 7) << 6) | ((Mask[7] == 7) << 7);
            return DAG.getNode(VPERMILPI, DL, v8f64, V1, DAG.getTargetConstant(VPERMILPMask, DL, i8, false));
        }
        let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
        if is256BitLaneRepeatedShuffleMask(v8f64, Mask, RepeatedMask) {
            return DAG.getNode(VPERMI, DL, v8f64, V1, getV4X86ShuffleImm8ForMask(RepeatedMask, DL, DAG));
        }
    }
    if lowerV4X128Shuffle(DL, v8f64, Mask, Zeroable, V1, V2, Subtarget, DAG) {
        Shuf128;
    } else {
        return Shuf128;
    }
    if lowerShuffleWithUNPCK(DL, v8f64, V1, V2, Mask, DAG) {
        Unpck;
    } else {
        return Unpck;
    }
    if lowerShuffleWithSHUFPD(DL, v8f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Op;
    } else {
        return Op;
    }
    if lowerShuffleWithEXPAND(DL, v8f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlend(DL, v8f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsVALIGN(DL, v8f64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    return lowerShuffleWithPERMV(DL, v8f64, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV16F32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v16f32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v16f32, "Bad operand type!");
    assert!(Mask.len == 16, "Unexpected mask size for v16 shuffle!");
    let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    if is128BitLaneRepeatedShuffleMask(v16f32, Mask, RepeatedMask) {
        assert!(RepeatedMask.len == 4, "Unexpected repeated mask size!");
        if isShuffleEquivalent(RepeatedMask, [0, 0, 2, 2], V1, V2) {
            return DAG.getNode(MOVSLDUP, DL, v16f32, V1);
        }
        if isShuffleEquivalent(RepeatedMask, [1, 1, 3, 3], V1, V2) {
            return DAG.getNode(MOVSHDUP, DL, v16f32, V1);
        }
        if V2.isUndef() {
            return DAG.getNode(VPERMILPI, DL, v16f32, V1, getV4X86ShuffleImm8ForMask(RepeatedMask, DL, DAG));
        }
        if lowerShuffleWithUNPCK(DL, v16f32, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsBlend(DL, v16f32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Blend;
        } else {
            return Blend;
        }
        return lowerShuffleWithSHUFPS(DL, v16f32, RepeatedMask, V1, V2, DAG);
    }
    if lowerShuffleAsBlend(DL, v16f32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleAsZeroOrAnyExtend(DL, v16i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return DAG.getBitcast(v16f32, ZExt);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v16f32, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if V2.isUndef() && !is128BitLaneCrossingShuffleMask(v16f32, Mask) {
        let mut VPermMask: SDValue = getConstVector(Mask, v16i32, DAG, DL, true);
        return DAG.getNode(VPERMILPV, DL, v16f32, V1, VPermMask);
    }
    if lowerShuffleWithEXPAND(DL, v16f32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsVALIGN(DL, v16f32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    return lowerShuffleWithPERMV(DL, v16f32, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV8I64Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v8i64, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v8i64, "Bad operand type!");
    assert!(Mask.len == 8, "Unexpected mask size for v8 shuffle!");
    if Subtarget.preferLowerShuffleAsShift() {
        if lowerShuffleAsShift(DL, v8i64, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
    }
    if V2.isUndef() {
        let mut Repeated128Mask: SmallVector<int, 2> = SmallVector<int, 2> {};
        if is128BitLaneRepeatedShuffleMask(v8i64, Mask, Repeated128Mask) {
            let mut PSHUFDMask: SmallVector<int, 4> = SmallVector<int, 4> {};
            narrowShuffleMaskElts(2, Repeated128Mask, PSHUFDMask);
            return DAG.getBitcast(v8i64, DAG.getNode(PSHUFD, DL, v16i32, DAG.getBitcast(v16i32, V1), getV4X86ShuffleImm8ForMask(PSHUFDMask, DL, DAG)));
        }
        let mut Repeated256Mask: SmallVector<int, 4> = SmallVector<int, 4> {};
        if is256BitLaneRepeatedShuffleMask(v8i64, Mask, Repeated256Mask) {
            return DAG.getNode(VPERMI, DL, v8i64, V1, getV4X86ShuffleImm8ForMask(Repeated256Mask, DL, DAG));
        }
    }
    if lowerV4X128Shuffle(DL, v8i64, Mask, Zeroable, V1, V2, Subtarget, DAG) {
        Shuf128;
    } else {
        return Shuf128;
    }
    if lowerShuffleAsShift(DL, v8i64, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsVALIGN(DL, v8i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if Subtarget.hasBWI() {
        if lowerShuffleAsByteRotate(DL, v8i64, V1, V2, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if lowerShuffleWithUNPCK(DL, v8i64, V1, V2, Mask, DAG) {
        Unpck;
    } else {
        return Unpck;
    }
    if lowerShuffleWithEXPAND(DL, v8i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlend(DL, v8i64, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    return lowerShuffleWithPERMV(DL, v8i64, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV16I32Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v16i32, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v16i32, "Bad operand type!");
    assert!(Mask.len == 16, "Unexpected mask size for v16 shuffle!");
    let mut NumV2Elements: i32 = count_if(Mask, Closure_97 {});
    if lowerShuffleAsZeroOrAnyExtend(DL, v16i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if Subtarget.preferLowerShuffleAsShift() {
        if lowerShuffleAsShift(DL, v16i32, V1, V2, Mask, Zeroable, Subtarget, DAG, true) {
            Shift;
        } else {
            return Shift;
        }
        if NumV2Elements == 0 {
            if lowerShuffleAsBitRotate(DL, v16i32, V1, Mask, Subtarget, DAG) {
                Rotate;
            } else {
                return Rotate;
            }
        }
    }
    let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
    let mut Is128BitLaneRepeatedShuffle: bool = is128BitLaneRepeatedShuffleMask(v16i32, Mask, RepeatedMask);
    if Is128BitLaneRepeatedShuffle {
        assert!(RepeatedMask.len == 4, "Unexpected repeated mask size!");
        if V2.isUndef() {
            return DAG.getNode(PSHUFD, DL, v16i32, V1, getV4X86ShuffleImm8ForMask(RepeatedMask, DL, DAG));
        }
        if lowerShuffleWithUNPCK(DL, v16i32, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsShift(DL, v16i32, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if !Subtarget.preferLowerShuffleAsShift() && NumV2Elements != 0 {
        if lowerShuffleAsBitRotate(DL, v16i32, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if lowerShuffleAsVALIGN(DL, v16i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if Subtarget.hasBWI() {
        if lowerShuffleAsByteRotate(DL, v16i32, V1, V2, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if Is128BitLaneRepeatedShuffle && isSingleSHUFPSMask(RepeatedMask) {
        let mut CastV1: SDValue = DAG.getBitcast(v16f32, V1);
        let mut CastV2: SDValue = DAG.getBitcast(v16f32, V2);
        let mut ShufPS: SDValue = lowerShuffleWithSHUFPS(DL, v16f32, RepeatedMask, CastV1, CastV2, DAG);
        return DAG.getBitcast(v16i32, ShufPS);
    }
    if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v16i32, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithEXPAND(DL, v16i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBlend(DL, v16i32, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    return lowerShuffleWithPERMV(DL, v16i32, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV32I16Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v32i16, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v32i16, "Bad operand type!");
    assert!(Mask.len == 32, "Unexpected mask size for v32 shuffle!");
    assert!(Subtarget.hasBWI(), "We can only lower v32i16 with AVX-512-BWI!");
    if lowerShuffleAsZeroOrAnyExtend(DL, v32i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleWithUNPCK(DL, v32i16, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, v32i16, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsShift(DL, v32i16, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, v32i16, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if V2.isUndef() {
        if lowerShuffleAsBitRotate(DL, v32i16, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
        let mut RepeatedMask: SmallVector<int, 8> = SmallVector<int, 8> {};
        if is128BitLaneRepeatedShuffleMask(v32i16, Mask, RepeatedMask) {
            return lowerV8I16GeneralSingleInputShuffle(DL, v32i16, V1, RepeatedMask, Subtarget, DAG);
        }
    }
    if lowerShuffleAsBlend(DL, v32i16, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if lowerShuffleWithPSHUFB(DL, v32i16, Mask, V1, V2, Zeroable, Subtarget, DAG) {
        PSHUFB;
    } else {
        return PSHUFB;
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, v32i16, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    return lowerShuffleWithPERMV(DL, v32i16, Mask, V1, V2, Subtarget, DAG);
}

fn lowerV64I8Shuffle(DL: *SDLoc, Mask: ArrayRef<int>, Zeroable: *APInt, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(V1.getSimpleValueType() == v64i8, "Bad operand type!");
    assert!(V2.getSimpleValueType() == v64i8, "Bad operand type!");
    assert!(Mask.len == 64, "Unexpected mask size for v64 shuffle!");
    assert!(Subtarget.hasBWI(), "We can only lower v64i8 with AVX-512-BWI!");
    if lowerShuffleAsZeroOrAnyExtend(DL, v64i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        ZExt;
    } else {
        return ZExt;
    }
    if lowerShuffleWithUNPCK(DL, v64i8, V1, V2, Mask, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleWithPACK(DL, v64i8, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsShift(DL, v64i8, V1, V2, Mask, Zeroable, Subtarget, DAG, false) {
        Shift;
    } else {
        return Shift;
    }
    if lowerShuffleAsByteRotate(DL, v64i8, V1, V2, Mask, Subtarget, DAG) {
        Rotate;
    } else {
        return Rotate;
    }
    if V2.isUndef() {
        if lowerShuffleAsBitRotate(DL, v64i8, V1, Mask, Subtarget, DAG) {
            Rotate;
        } else {
            return Rotate;
        }
    }
    if lowerShuffleAsBitMask(DL, v64i8, V1, V2, Mask, Zeroable, DAG) {
        Masked;
    } else {
        return Masked;
    }
    if lowerShuffleWithPSHUFB(DL, v64i8, Mask, V1, V2, Zeroable, Subtarget, DAG) {
        PSHUFB;
    } else {
        return PSHUFB;
    }
    if !Subtarget.hasVBMI() {
        if lowerShuffleAsRepeatedMaskAndLanePermute(DL, v64i8, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    if lowerShuffleAsLanePermuteAndPermute(DL, v64i8, V1, V2, Mask, DAG, Subtarget) {
        Result;
    } else {
        return Result;
    }
    if lowerShuffleAsBlend(DL, v64i8, V1, V2, Mask, Zeroable, Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if !is128BitLaneCrossingShuffleMask(v64i8, Mask) {
        if lowerShuffleAsByteRotateAndPermute(DL, v64i8, V1, V2, Mask, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
        if Subtarget.hasVBMI() {
            return lowerShuffleWithPERMV(DL, v64i8, Mask, V1, V2, Subtarget, DAG);
        }
        let mut V1InUse: bool = false;
        let mut V2InUse: bool = false;
        return lowerShuffleAsBlendOfPSHUFBs(DL, v64i8, V1, V2, Mask, Zeroable, DAG, V1InUse, V2InUse);
    }
    if lowerShuffleAsLanePermuteAndRepeatedMask(DL, v64i8, V1, V2, Mask, Subtarget, DAG) {
        Result;
    } else {
        return Result;
    }
    if Subtarget.hasVBMI() {
        return lowerShuffleWithPERMV(DL, v64i8, Mask, V1, V2, Subtarget, DAG);
    }
    return splitAndLowerShuffle(DL, v64i8, V1, V2, Mask, DAG, false);
}

fn lower512BitShuffle(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Subtarget.hasAVX512(), "Cannot lower 512-bit vectors w/ basic ISA!");
    let mut NumElts: i32 = Mask.len;
    let mut NumV2Elements: i32 = count_if(Mask, Closure_98 { NumElts: NumElts });
    if NumV2Elements == 1 && Mask[0] >= NumElts {
        if lowerShuffleAsElementInsertion(DL, VT, V1, V2, Mask, Zeroable, Subtarget, DAG) {
            Insertion;
        } else {
            return Insertion;
        }
    }
    if lowerShuffleWithUndefHalf(DL, VT, V1, V2, Mask, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    if lowerShuffleAsBroadcast(DL, VT, V1, V2, Mask, Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if (VT == v32i16 || VT == v64i8) && !Subtarget.hasBWI() {
        if lowerShuffleAsBitMask(DL, VT, V1, V2, Mask, Zeroable, DAG) {
            V;
        } else {
            return V;
        }
        if lowerShuffleAsBitBlend(DL, VT, V1, V2, Mask, DAG) {
            V;
        } else {
            return V;
        }
        return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
    }
    if VT == v32f16 || VT == v32bf16 {
        if !Subtarget.hasBWI() {
            return splitAndLowerShuffle(DL, VT, V1, V2, Mask, DAG, false);
        }
        V1 = DAG.getBitcast(v32i16, V1);
        V2 = DAG.getBitcast(v32i16, V2);
        return DAG.getBitcast(VT, DAG.getVectorShuffle(v32i16, DL, V1, V2, Mask));
    }
    match VT.SimpleTy {
        v8f64 => {
            return lowerV8F64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v16f32 => {
            return lowerV16F32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v8i64 => {
            return lowerV8I64Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v16i32 => {
            return lowerV16I32Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v32i16 => {
            return lowerV32I16Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        v64i8 => {
            return lowerV64I8Shuffle(DL, Mask, Zeroable, V1, V2, Subtarget, DAG);
        },
        _ => {
            llvm_unreachable_internal("Not a valid 512-bit x86 vector type!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 18312);
        },
    }
}

fn lower1BitShuffleAsKSHIFTR(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if !V2.isUndef() {
        return SDValue {};
    }
    let mut ShiftAmt: i32 = -1;
    let mut NumElts: i32 = Mask.len;
    for let mut i: i32 = 0; i != NumElts; i += 1 {
        let mut M: i32 = Mask[i];
        assert!((M == SM_SentinelUndef || (0 <= M && M < NumElts)), "Unexpected mask index.");
        if M < 0 {
            continue;
        }
        if ShiftAmt < 0 {
            ShiftAmt = M - i;
            if ShiftAmt <= 0 {
                return SDValue {};
            }
        }
        if ShiftAmt != M - i {
            return SDValue {};
        }
    }
    assert!(ShiftAmt >= 0, "All undef?");
    let mut Res: SDValue = widenMaskVector(V1, false, Subtarget, DAG, DL);
    Res = DAG.getNode(KSHIFTR, DL, Res.getValueType(), Res, DAG.getTargetConstant(ShiftAmt, DL, i8, false));
    return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Res, DAG.getVectorIdxConstant(0, DL, false));
}

fn match1BitShuffleAsKSHIFT(Opcode: *mut u32, Mask: ArrayRef<int>, MaskOffset: i32, Zeroable: *APInt) -> i32 {
    let mut Size: i32 = Mask.len;
    let mut CheckZeros: Closure_99 = Closure_99 { Zeroable: &mut Zeroable, Size: &mut Size };
    let mut MatchShift: Closure_100 = Closure_100 { Size: &mut Size, Mask: &mut Mask, MaskOffset: &mut MaskOffset };
    for let mut Shift: i32 = 1; Shift != Size; Shift += 1 {
        for Left in [true, false] {
            if CheckZeros.call(Shift, Left) && MatchShift.call(Shift, Left) {
                Opcode = if Left { KSHIFTL } else { KSHIFTR };
                return Shift;
            }
        }
    }
    return -1;
}

fn lower1BitShuffle(DL: *SDLoc, Mask: ArrayRef<int>, VT: MVT, V1: SDValue, V2: SDValue, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Subtarget.hasAVX512(), "Cannot lower 512-bit vectors w/o basic ISA!");
    let mut NumElts: i32 = Mask.len;
    let mut NumV2Elements: i32 = count_if(Mask, Closure_101 { NumElts: NumElts });
    let mut SubvecElts: i32 = 0;
    let mut Src: i32 = -1;
    for let mut i: i32 = 0; i != NumElts; i += 1 {
        if Mask[i] >= 0 {
            if Src < 0 {
                Src = Mask[i] / NumElts;
            }
            if Src != (Mask[i] / NumElts) || (Mask[i] % NumElts) != i {
                break;
            }
        }
        SubvecElts += 1;
    }
    assert!(SubvecElts != NumElts, "Identity shuffle?");
    SubvecElts = bit_floor(SubvecElts);
    if Zeroable.countl_one() as i32 >= (NumElts - SubvecElts) {
        assert!(Src >= 0, "Expected a source!");
        let mut ExtractVT: MVT = getVectorVT(i1, SubvecElts);
        let mut Extract: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, ExtractVT, if Src == 0 { V1 } else { V2 }, DAG.getVectorIdxConstant(0, DL, false));
        return DAG.getNode(INSERT_SUBVECTOR, DL, VT, DAG.getConstant(0, DL, VT, false, false), Extract, DAG.getVectorIdxConstant(0, DL, false));
    }
    if lower1BitShuffleAsKSHIFTR(DL, Mask, VT, V1, V2, Subtarget, DAG) {
        Shift;
    } else {
        return Shift;
    }
    let mut Offset: u32 = 0;
    for V in [V1, V2] {
        let mut Opcode: u32 = 0;
        let mut ShiftAmt: i32 = match1BitShuffleAsKSHIFT(Opcode, Mask, Offset, Zeroable);
        if ShiftAmt >= 0 {
            let mut Res: SDValue = widenMaskVector(V, false, Subtarget, DAG, DL);
            let mut WideVT: MVT = Res.getSimpleValueType();
            if Opcode == KSHIFTR && WideVT != VT {
                let mut WideElts: i32 = WideVT.getVectorNumElements();
                Res = DAG.getNode(KSHIFTL, DL, WideVT, Res, DAG.getTargetConstant(WideElts - NumElts, DL, i8, false));
                ShiftAmt += WideElts - NumElts;
            }
            Res = DAG.getNode(Opcode, DL, WideVT, Res, DAG.getTargetConstant(ShiftAmt, DL, i8, false));
            return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Res, DAG.getVectorIdxConstant(0, DL, false));
        }
        Offset += NumElts;
    }
    if NumV2Elements == 0 && V1.getOpcode() == SETCC && operator(V1).hasOneUse() {
        let mut Op0: SDValue = V1.getOperand(0);
        let mut Op1: SDValue = V1.getOperand(1);
        let mut CC: CondCode = cast(V1.getOperand(2)).get();
        let mut OpVT: EVT = Op0.getValueType();
        if OpVT.getScalarSizeInBits() >= 32 || isBroadcastShuffleMask(Mask) {
            return DAG.getSetCC(DL, VT, DAG.getVectorShuffle(OpVT, DL, Op0, DAG.getUNDEF(OpVT), Mask), DAG.getVectorShuffle(OpVT, DL, Op1, DAG.getUNDEF(OpVT), Mask), CC, SDValue {}, false, None);
        }
    }
    let mut IsBlendWithZero: bool = all_of(enumerate(Mask), Closure_102 { Zeroable: &mut Zeroable });
    if IsBlendWithZero {
        let mut Width: u32 = if NumElts > 8 { NumElts } else { 8 };
        let mut IntVT: MVT = getIntegerVT(Width);
        let mut MaskValue: APInt = (operator(Zeroable)).zextOrTrunc(Width);
        let mut MaskNode: SDValue = DAG.getConstant(MaskValue, DL, IntVT, false, false);
        let mut MaskVecVT: MVT = getVectorVT(i1, Width);
        let mut MaskVecNode: SDValue = DAG.getBitcast(MaskVecVT, MaskNode);
        let mut MaskVec: SDValue = DAG.getExtractSubvector(DL, VT, MaskVecNode, 0);
        return DAG.getNode(AND, DL, VT, V1, MaskVec);
    }
    let mut ExtVT: MVT = MVT {};
    match VT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Expected a vector of i1 elements", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 18502);
        },
        v2i1 => {
            ExtVT = v2i64;
        },
        v4i1 => {
            ExtVT = v4i32;
        },
        v8i1 => {
            ExtVT = if Subtarget.hasVLX() { v8i32 } else { v8i64 };
        },
        v16i1 => {
            ExtVT = if Subtarget.canExtendTo512DQ() { v16i32 } else { v16i16 };
        },
        v32i1 => {
            assert!(Subtarget.hasBWI(), "Expected AVX512BW support");
        },
        v64i1 => {
            if !Subtarget.useBWIRegs() {
                return SDValue {};
            }
        },
    }
    V1 = DAG.getNode(SIGN_EXTEND, DL, ExtVT, V1);
    V2 = DAG.getNode(SIGN_EXTEND, DL, ExtVT, V2);
    let mut Shuffle: SDValue = DAG.getVectorShuffle(ExtVT, DL, V1, V2, Mask);
    let mut NumElems: i32 = VT.getVectorNumElements();
    if (Subtarget.hasBWI() && (NumElems >= 32)) || (Subtarget.hasDQI() && (NumElems < 32)) {
        return DAG.getSetCC(DL, VT, DAG.getConstant(0, DL, ExtVT, false, false), Shuffle, SETGT, SDValue {}, false, None);
    }
    return DAG.getNode(TRUNCATE, DL, VT, Shuffle);
}

fn canonicalizeShuffleMaskWithCommute(Mask: ArrayRef<int>) -> bool {
    let mut NumElements: i32 = Mask.len;
    let mut NumV1Elements: i32 = 0;
    let mut NumV2Elements: i32 = 0;
    for M in Mask {
        if M < 0 {
            continue;
        } else if M < NumElements {
            NumV1Elements += 1;
        } else {
            NumV2Elements += 1;
        }
    }
    if NumV2Elements > NumV1Elements {
        return true;
    }
    assert!(NumV1Elements > 0, "No V1 indices");
    if NumV2Elements == 0 {
        return false;
    }
    if NumV1Elements == NumV2Elements {
        let mut LowV1Elements: i32 = 0;
        let mut LowV2Elements: i32 = 0;
        for M in Mask.slice(0, NumElements / 2) {
            if M >= NumElements {
                LowV2Elements += 1;
            } else if M >= 0 {
                LowV1Elements += 1;
            }
        }
        if LowV2Elements > LowV1Elements {
            return true;
        }
        if LowV2Elements == LowV1Elements {
            let mut SumV1Indices: i32 = 0;
            let mut SumV2Indices: i32 = 0;
            for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
                if Mask[i] >= NumElements {
                    SumV2Indices += i;
                } else if Mask[i] >= 0 {
                    SumV1Indices += i;
                }
            }
            if SumV2Indices < SumV1Indices {
                return true;
            }
            if SumV2Indices == SumV1Indices {
                let mut NumV1OddIndices: i32 = 0;
                let mut NumV2OddIndices: i32 = 0;
                for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
                    if Mask[i] >= NumElements {
                        NumV2OddIndices += i % 2;
                    } else if Mask[i] >= 0 {
                        NumV1OddIndices += i % 2;
                    }
                }
                if NumV2OddIndices < NumV1OddIndices {
                    return true;
                }
            }
        }
    }
    return false;
}

fn canCombineAsMaskOperation(V: SDValue, Subtarget: *X86Subtarget) -> bool {
    if !Subtarget.hasAVX512() {
        return false;
    }
    if !V.getValueType().isSimple() {
        return false;
    }
    let mut VT: MVT = V.getSimpleValueType().getScalarType();
    if (VT == i16 || VT == i8) && !Subtarget.hasBWI() {
        return false;
    }
    if (VT == i16 || VT == i8) && V.getSimpleValueType().getSizeInBits().operator unsigned long long() < 512 {
        return false;
    }
    let mut HasMaskOperation: Closure_103 = Closure_103 {};
    if HasMaskOperation.call(V) {
        return true;
    }
    return false;
}

fn lowerVECTOR_SHUFFLE(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut SVOp: *mut ShuffleVectorSDNode = cast(Op);
    let mut OrigMask: ArrayRef<int> = SVOp.getMask();
    let mut V1: SDValue = Op.getOperand(0);
    let mut V2: SDValue = Op.getOperand(1);
    let mut VT: MVT = Op.getSimpleValueType();
    let mut NumElements: i32 = VT.getVectorNumElements();
    let mut DL: SDLoc = Op;
    let mut Is1BitVector: bool = (VT.getVectorElementType() == i1);
    assert!((VT.getSizeInBits().operator unsigned long long() != 64 || Is1BitVector), "Can't lower MMX shuffles");
    let mut V1IsUndef: bool = V1.isUndef();
    let mut V2IsUndef: bool = V2.isUndef();
    if V1IsUndef && V2IsUndef {
        return DAG.getUNDEF(VT);
    }
    if V1IsUndef {
        return DAG.getCommutedVectorShuffle(*SVOp);
    }
    if V2IsUndef && any_of(OrigMask, Closure_104 { NumElements: NumElements }) {
        let mut NewMask: SmallVector<int, 8> = OrigMask;
        for M in NewMask {
            if M >= NumElements {
                M = -1;
            }
        }
        return DAG.getVectorShuffle(VT, DL, V1, V2, NewMask);
    }
    let mut MaskUpperLimit: i32 = OrigMask.len * (if V2IsUndef { 1 } else { 2 });
    MaskUpperLimit as void;
    assert!(all_of(OrigMask, Closure_105 { MaskUpperLimit: &mut MaskUpperLimit }), "Out of bounds shuffle index");
    let mut KnownUndef: APInt = APInt {};
    let mut KnownZero: APInt = APInt {};
    computeZeroableShuffleElements(OrigMask, V1, V2, KnownUndef, KnownZero);
    let mut Zeroable: APInt = KnownUndef | KnownZero;
    if Zeroable.isAllOnes() {
        return getZeroVector(VT, Subtarget, DAG, DL);
    }
    let mut V2IsZero: bool = !V2IsUndef && isBuildVectorAllZeros(V2.getNode());
    let mut WidenedMask: SmallVector<int, 16> = SmallVector<int, 16> {};
    if VT.getScalarSizeInBits() < 64 && !Is1BitVector && !canCombineAsMaskOperation(V1, Subtarget) && !canCombineAsMaskOperation(V2, Subtarget) && canWidenShuffleElements(OrigMask, Zeroable, V2IsZero, WidenedMask) {
        if lowerShuffleAsBroadcast(DL, VT, V1, V2, OrigMask, Subtarget, DAG) {
            Broadcast;
        } else {
            return Broadcast;
        }
        let mut NewEltVT: MVT = if VT.isFloatingPoint() { getFloatingPointVT(VT.getScalarSizeInBits() * 2) } else { getIntegerVT(VT.getScalarSizeInBits() * 2) };
        let mut NewNumElts: i32 = NumElements / 2;
        let mut NewVT: MVT = getVectorVT(NewEltVT, NewNumElts);
        if DAG.getTargetLoweringInfo().isTypeLegal(NewVT) {
            if V2IsZero {
                let mut UsedZeroVector: bool = false;
                assert!(is_contained(WidenedMask, SM_SentinelZero), "V2's non-undef elements are used?!");
                for let mut i: i32 = 0; i != NewNumElts; i += 1 {
                    if WidenedMask[i] == SM_SentinelZero {
                        WidenedMask[i] = i + NewNumElts;
                        UsedZeroVector = true;
                    }
                }
                if UsedZeroVector {
                    V2 = getZeroVector(NewVT, Subtarget, DAG, DL);
                }
            }
            V1 = DAG.getBitcast(NewVT, V1);
            V2 = DAG.getBitcast(NewVT, V2);
            return DAG.getBitcast(VT, DAG.getVectorShuffle(NewVT, DL, V1, V2, WidenedMask));
        }
    }
    let mut Ops: SmallVector<SDValue> = [V1, V2];
    let mut Mask: SmallVector<int> = OrigMask;
    if !canWidenShuffleElements(Mask) {
        if canonicalizeShuffleMaskWithHorizOp(Ops, Mask, VT.getSizeInBits().operator unsigned long long(), DL, DAG, Subtarget) {
            HOp;
        } else {
            return DAG.getBitcast(VT, HOp);
        }
        V1 = DAG.getBitcast(VT, Ops[0]);
        V2 = DAG.getBitcast(VT, Ops[1]);
        assert!(NumElements == Mask.len as i32, "canonicalizeShuffleMaskWithHorizOp shouldn't alter the shuffle mask size");
    }
    let mut CanonicalizeConstant: Closure_106 = Closure_106 { cap_0: VT, DL: &mut DL, DAG: &mut DAG };
    V1 = CanonicalizeConstant.call(V1);
    V2 = CanonicalizeConstant.call(V2);
    if canonicalizeShuffleMaskWithCommute(Mask) {
        commuteMask(Mask);
        swap(V1, V2);
    }
    if VT.is128BitVector() {
        return lower128BitShuffle(DL, Mask, VT, V1, V2, Zeroable, Subtarget, DAG);
    }
    if VT.is256BitVector() {
        return lower256BitShuffle(DL, Mask, VT, V1, V2, Zeroable, Subtarget, DAG);
    }
    if VT.is512BitVector() {
        return lower512BitShuffle(DL, Mask, VT, V1, V2, Zeroable, Subtarget, DAG);
    }
    if Is1BitVector {
        return lower1BitShuffle(DL, Mask, VT, V1, V2, Zeroable, Subtarget, DAG);
    }
    llvm_unreachable_internal("Unimplemented!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 18840);
}

fn lowerVECTOR_COMPRESS(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Subtarget.hasAVX512(), "Need AVX512 for custom VECTOR_COMPRESS lowering.");
    let mut DL: SDLoc = Op;
    let mut Vec: SDValue = Op.getOperand(0);
    let mut Mask: SDValue = Op.getOperand(1);
    let mut Passthru: SDValue = Op.getOperand(2);
    let mut VecVT: EVT = Vec.getValueType();
    let mut ElementVT: EVT = VecVT.getVectorElementType();
    let mut NumElements: u32 = VecVT.getVectorNumElements();
    let mut NumVecBits: u32 = VecVT.getFixedSizeInBits();
    let mut NumElementBits: u32 = ElementVT.getFixedSizeInBits();
    if NumVecBits != 128 && NumVecBits != 256 {
        return SDValue {};
    }
    if NumElementBits == 32 || NumElementBits == 64 {
        let mut NumLargeElements: u32 = 512 / NumElementBits;
        let mut LargeVecVT: MVT = getVectorVT(ElementVT.getSimpleVT(), NumLargeElements);
        let mut LargeMaskVT: MVT = getVectorVT(i1, NumLargeElements);
        Vec = widenSubVector(LargeVecVT, Vec, false, Subtarget, DAG, DL);
        Mask = widenSubVector(LargeMaskVT, Mask, true, Subtarget, DAG, DL);
        Passthru = if Passthru.isUndef() { DAG.getUNDEF(LargeVecVT) } else { widenSubVector(LargeVecVT, Passthru, false, Subtarget, DAG, DL) };
        let mut Compressed: SDValue = DAG.getNode(VECTOR_COMPRESS, DL, LargeVecVT, Vec, Mask, Passthru);
        return DAG.getNode(EXTRACT_SUBVECTOR, DL, VecVT, Compressed, DAG.getConstant(0, DL, i64, false, false));
    }
    if VecVT == v8i16 || VecVT == v8i8 || VecVT == v16i8 || VecVT == v16i16 {
        let mut LageElementVT: MVT = getIntegerVT(512 / NumElements);
        let mut LargeVecVT: EVT = getVectorVT(LageElementVT, NumElements);
        Vec = DAG.getNode(ANY_EXTEND, DL, LargeVecVT, Vec);
        Passthru = if Passthru.isUndef() { DAG.getUNDEF(LargeVecVT) } else { DAG.getNode(ANY_EXTEND, DL, LargeVecVT, Passthru) };
        let mut Compressed: SDValue = DAG.getNode(VECTOR_COMPRESS, DL, LargeVecVT, Vec, Mask, Passthru);
        return DAG.getNode(TRUNCATE, DL, VecVT, Compressed);
    }
    return SDValue {};
}

fn lowerVSELECTtoVectorShuffle(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut Cond: SDValue = Op.getOperand(0);
    let mut LHS: SDValue = Op.getOperand(1);
    let mut RHS: SDValue = Op.getOperand(2);
    let mut VT: MVT = Op.getSimpleValueType();
    if isBuildVectorOfConstantSDNodes(Cond.getNode()) {
        let mut Mask: SmallVector<int, 32> = SmallVector<int, 32> {};
        if createShuffleMaskFromVSELECT(Mask, Cond, false) {
            return DAG.getVectorShuffle(VT, Op, LHS, RHS, Mask);
        }
    }
    return SDValue {};
}

fn X86TargetLowering::LowerVSELECT(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Cond: SDValue = Op.getOperand(0);
    let mut LHS: SDValue = Op.getOperand(1);
    let mut RHS: SDValue = Op.getOperand(2);
    let mut dl: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    if isSoftF16(VT, self.Subtarget) {
        let mut NVT: MVT = VT.changeVectorElementTypeToInteger();
        return DAG.getBitcast(VT, DAG.getNode(VSELECT, dl, NVT, Cond, DAG.getBitcast(NVT, LHS), DAG.getBitcast(NVT, RHS)));
    }
    if isBuildVectorOfConstantSDNodes(Cond.getNode()) && isBuildVectorOfConstantSDNodes(LHS.getNode()) && isBuildVectorOfConstantSDNodes(RHS.getNode()) {
        return SDValue {};
    }
    if lowerVSELECTtoVectorShuffle(Op, self.Subtarget, DAG) {
        BlendOp;
    } else {
        return BlendOp;
    }
    let mut CondVT: MVT = Cond.getSimpleValueType();
    let mut CondEltSize: u32 = Cond.getScalarValueSizeInBits();
    if CondEltSize == 1 {
        return Op;
    }
    if !self.Subtarget.hasSSE41() {
        return SDValue {};
    }
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    let mut NumElts: u32 = VT.getVectorNumElements();
    if (VT == v32i16 || VT == v64i8) && !self.Subtarget.hasBWI() {
        return SDValue {};
    }
    if VT.getSizeInBits().operator unsigned long long() == 512 {
        let mut MaskVT: MVT = getVectorVT(i1, NumElts);
        let mut Mask: SDValue = DAG.getSetCC(dl, MaskVT, Cond, DAG.getConstant(0, dl, CondVT, false, false), SETNE, SDValue {}, false, None);
        return DAG.getSelect(dl, VT, Mask, LHS, RHS, SDNodeFlags { Flags: None });
    }
    if CondEltSize != EltSize {
        if CondEltSize != DAG.ComputeNumSignBits(Cond, 0) {
            return SDValue {};
        }
        let mut NewCondSVT: MVT = getIntegerVT(EltSize);
        let mut NewCondVT: MVT = getVectorVT(NewCondSVT, NumElts);
        Cond = DAG.getSExtOrTrunc(Cond, dl, NewCondVT);
        return DAG.getNode(VSELECT, dl, VT, Cond, LHS, RHS);
    }
    if EltSize < 32 && VT.is256BitVector() && !self.Subtarget.hasAVX2() && !self.Subtarget.hasXOP() {
        let mut FreeCond: bool = isFreeToSplitVector(Cond, DAG);
        let mut FreeLHS: bool = isFreeToSplitVector(LHS, DAG) || (isNormalLoad(LHS.getNode()) && LHS.hasOneUse());
        let mut FreeRHS: bool = isFreeToSplitVector(RHS, DAG) || (isNormalLoad(RHS.getNode()) && RHS.hasOneUse());
        if FreeCond && (FreeLHS || FreeRHS) {
            return splitVectorOp(Op, DAG, dl);
        }
    }
    match VT.SimpleTy {
        _ => {
            return Op;
        },
        v32i8 => {
            if self.Subtarget.hasAVX2() {
                return Op;
            }
        },
        v8i16 => {
            v16i16;
        },
    }
}

fn LowerEXTRACT_VECTOR_ELT_SSE4(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut Vec: SDValue = Op.getOperand(0);
    let mut Idx: SDValue = Op.getOperand(1);
    assert!(isa(Idx), "Constant index expected");
    let mut dl: SDLoc = Op;
    if !Vec.getSimpleValueType().is128BitVector() {
        return SDValue {};
    }
    if VT.getSizeInBits().operator unsigned long long() == 8 {
        if isNullConstant(Idx) && !mayFoldIntoZeroExtend(Op) && !mayFoldIntoStore(Op) {
            return DAG.getNode(TRUNCATE, dl, i8, DAG.getNode(EXTRACT_VECTOR_ELT, dl, i32, DAG.getBitcast(v4i32, Vec), Idx));
        }
        let mut IdxVal: u32 = operator(Idx).getAsZExtVal();
        let mut Extract: SDValue = DAG.getNode(PEXTRB, dl, i32, Vec, DAG.getTargetConstant(IdxVal, dl, i8, false));
        return DAG.getNode(TRUNCATE, dl, VT, Extract);
    }
    if VT == f32 {
        if !Op.hasOneUse() {
            return SDValue {};
        }
        let mut User: *mut SDNode = operator(Op.getNode().user_begin());
        if (User.getOpcode() != STORE || isNullConstant(Idx)) && (User.getOpcode() != BITCAST || User.getValueType(0) != i32) {
            return SDValue {};
        }
        let mut Extract: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, dl, i32, DAG.getBitcast(v4i32, Vec), Idx);
        return DAG.getBitcast(f32, Extract);
    }
    if VT == i32 || VT == i64 {
        return Op;
    }
    return SDValue {};
}

fn ExtractBitFromMaskVector(Op: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Vec: SDValue = Op.getOperand(0);
    let mut dl: SDLoc = Vec;
    let mut VecVT: MVT = Vec.getSimpleValueType();
    let mut Idx: SDValue = Op.getOperand(1);
    let mut IdxC: *mut ConstantSDNode = dyn_cast(Idx);
    let mut EltVT: MVT = Op.getSimpleValueType();
    assert!((VecVT.getVectorNumElements() <= 16 || Subtarget.hasBWI()), "Unexpected vector type in ExtractBitFromMaskVector");
    if !IdxC {
        let mut NumElts: u32 = VecVT.getVectorNumElements();
        if NumElts == 1 {
            Vec = widenMaskVector(Vec, false, Subtarget, DAG, dl);
            let mut IntVT: MVT = getIntegerVT(Vec.getValueType().getVectorNumElements());
            return DAG.getNode(TRUNCATE, dl, i8, DAG.getBitcast(IntVT, Vec));
        }
        let mut ExtEltVT: MVT = if (NumElts <= 8) { getIntegerVT(128 / NumElts) } else { i8 };
        let mut ExtVecVT: MVT = getVectorVT(ExtEltVT, NumElts);
        let mut Ext: SDValue = DAG.getNode(SIGN_EXTEND, dl, ExtVecVT, Vec);
        let mut Elt: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, dl, ExtEltVT, Ext, Idx);
        return DAG.getNode(TRUNCATE, dl, EltVT, Elt);
    }
    let mut IdxVal: u32 = IdxC.getZExtValue();
    if IdxVal == 0 {
        return Op;
    }
    Vec = widenMaskVector(Vec, false, Subtarget, DAG, dl);
    Vec = DAG.getNode(KSHIFTR, dl, Vec.getSimpleValueType(), Vec, DAG.getTargetConstant(IdxVal, dl, i8, false));
    return DAG.getNode(EXTRACT_VECTOR_ELT, dl, Op.getValueType(), Vec, DAG.getVectorIdxConstant(0, dl, false));
}

fn getExtractedDemandedElts(N: *mut SDNode) -> APInt {
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut DemandedElts: APInt = getZero(NumElts);
    for User in N.users() {
        match User.getOpcode() {
            PEXTRB => {
                PEXTRW;
            },
            BITCAST => {
                if !User.getValueType(0).isSimple() || !User.getValueType(0).isVector() {
                    DemandedElts.setAllBits();
                    return DemandedElts;
                }
                let mut DemandedSrcElts: APInt = getExtractedDemandedElts(User);
                operator(DemandedElts, ScaleBitMask(DemandedSrcElts, NumElts, false));
                break;
            },
            _ => {
                DemandedElts.setAllBits();
            },
        }
    }
    return DemandedElts;
}

fn X86TargetLowering::LowerEXTRACT_VECTOR_ELT(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = Op;
    let mut Vec: SDValue = Op.getOperand(0);
    let mut VecVT: MVT = Vec.getSimpleValueType();
    let mut Idx: SDValue = Op.getOperand(1);
    let mut IdxC: *mut ConstantSDNode = dyn_cast(Idx);
    if VecVT.getVectorElementType() == i1 {
        return ExtractBitFromMaskVector(Op, DAG, self.Subtarget);
    }
    if !IdxC {
        return SDValue {};
    }
    let mut IdxVal: u32 = IdxC.getZExtValue();
    if VecVT.is256BitVector() || VecVT.is512BitVector() {
        Vec = extract128BitVector(Vec, IdxVal, DAG, dl);
        let mut EltVT: MVT = VecVT.getVectorElementType();
        let mut ElemsPerChunk: u32 = 128 / EltVT.getSizeInBits().operator unsigned long long();
        assert!(isPowerOf2_32(ElemsPerChunk), "Elements per chunk not power of 2");
        IdxVal &= ElemsPerChunk - 1;
        return DAG.getNode(EXTRACT_VECTOR_ELT, dl, Op.getValueType(), Vec, DAG.getVectorIdxConstant(IdxVal, dl, false));
    }
    assert!(VecVT.is128BitVector(), "Unexpected vector length");
    let mut VT: MVT = Op.getSimpleValueType();
    if VT == i16 {
        if IdxVal == 0 && !mayFoldIntoZeroExtend(Op) && !(self.Subtarget.hasSSE41() && mayFoldIntoStore(Op)) {
            if self.Subtarget.hasFP16() {
                return Op;
            }
            return DAG.getNode(TRUNCATE, dl, i16, DAG.getNode(EXTRACT_VECTOR_ELT, dl, i32, DAG.getBitcast(v4i32, Vec), Idx));
        }
        let mut Extract: SDValue = DAG.getNode(PEXTRW, dl, i32, Vec, DAG.getTargetConstant(IdxVal, dl, i8, false));
        return DAG.getNode(TRUNCATE, dl, VT, Extract);
    }
    if self.Subtarget.hasSSE41() {
        if LowerEXTRACT_VECTOR_ELT_SSE4(Op, DAG) {
            Res;
        } else {
            return Res;
        }
    }
    if VT == i8 {
        let mut DemandedElts: APInt = getExtractedDemandedElts(Vec.getNode());
        assert!(DemandedElts.getBitWidth() == 16, "Vector width mismatch");
        let mut DWordIdx: i32 = IdxVal / 4;
        if DWordIdx == 0 && DemandedElts == (DemandedElts & 15) {
            let mut Res: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, dl, i32, DAG.getBitcast(v4i32, Vec), DAG.getVectorIdxConstant(DWordIdx, dl, false));
            let mut ShiftVal: i32 = (IdxVal % 4) * 8;
            if ShiftVal != 0 {
                Res = DAG.getNode(SRL, dl, i32, Res, DAG.getConstant(ShiftVal, dl, i8, false, false));
            }
            return DAG.getNode(TRUNCATE, dl, VT, Res);
        }
        let mut WordIdx: i32 = IdxVal / 2;
        if DemandedElts == (DemandedElts & (3 << (WordIdx * 2))) {
            let mut Res: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, dl, i16, DAG.getBitcast(v8i16, Vec), DAG.getVectorIdxConstant(WordIdx, dl, false));
            let mut ShiftVal: i32 = (IdxVal % 2) * 8;
            if ShiftVal != 0 {
                Res = DAG.getNode(SRL, dl, i16, Res, DAG.getConstant(ShiftVal, dl, i8, false, false));
            }
            return DAG.getNode(TRUNCATE, dl, VT, Res);
        }
    }
    if VT == f16 || VT.getSizeInBits().operator unsigned long long() == 32 {
        if IdxVal == 0 {
            return Op;
        }
        let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> { VecVT.getVectorNumElements(), -1 };
        Mask[0] = IdxVal as i32;
        Vec = DAG.getVectorShuffle(VecVT, dl, Vec, DAG.getUNDEF(VecVT), Mask);
        return DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT, Vec, DAG.getVectorIdxConstant(0, dl, false));
    }
    if VT.getSizeInBits().operator unsigned long long() == 64 {
        if IdxVal == 0 {
            return Op;
        }
        let mut Mask: [2]i32 = [1, -1];
        Vec = DAG.getVectorShuffle(VecVT, dl, Vec, DAG.getUNDEF(VecVT), Mask);
        return DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT, Vec, DAG.getVectorIdxConstant(0, dl, false));
    }
    return SDValue {};
}

fn InsertBitToMaskVector(Op: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut dl: SDLoc = Op;
    let mut Vec: SDValue = Op.getOperand(0);
    let mut Elt: SDValue = Op.getOperand(1);
    let mut Idx: SDValue = Op.getOperand(2);
    let mut VecVT: MVT = Vec.getSimpleValueType();
    if !isa(Idx) {
        let mut NumElts: u32 = VecVT.getVectorNumElements();
        let mut ExtEltVT: MVT = if (NumElts <= 8) { getIntegerVT(128 / NumElts) } else { i8 };
        let mut ExtVecVT: MVT = getVectorVT(ExtEltVT, NumElts);
        let mut ExtOp: SDValue = DAG.getNode(INSERT_VECTOR_ELT, dl, ExtVecVT, DAG.getNode(SIGN_EXTEND, dl, ExtVecVT, Vec), DAG.getNode(SIGN_EXTEND, dl, ExtEltVT, Elt), Idx);
        return DAG.getNode(TRUNCATE, dl, VecVT, ExtOp);
    }
    let mut EltInVec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, v1i1, Elt);
    return DAG.getNode(INSERT_SUBVECTOR, dl, VecVT, Vec, EltInVec, Idx);
}

fn X86TargetLowering::LowerINSERT_VECTOR_ELT(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut EltVT: MVT = VT.getVectorElementType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltSizeInBits: u32 = EltVT.getScalarSizeInBits();
    if EltVT == i1 {
        return InsertBitToMaskVector(Op, DAG, self.Subtarget);
    }
    let mut dl: SDLoc = Op;
    let mut N0: SDValue = Op.getOperand(0);
    let mut N1: SDValue = Op.getOperand(1);
    let mut N2: SDValue = Op.getOperand(2);
    let mut N2C: *mut ConstantSDNode = dyn_cast(N2);
    if !N2C {
        if !(self.Subtarget.hasBWI() || (self.Subtarget.hasAVX512() && EltSizeInBits >= 32) || (self.Subtarget.hasSSE41() && (EltVT == f32 || EltVT == f64))) {
            return SDValue {};
        }
        let mut IdxSVT: MVT = getIntegerVT(EltSizeInBits);
        let mut IdxVT: MVT = getVectorVT(IdxSVT, NumElts);
        if !self.isTypeLegal(IdxSVT) || !self.isTypeLegal(IdxVT) {
            return SDValue {};
        }
        let mut IdxExt: SDValue = DAG.getZExtOrTrunc(N2, dl, IdxSVT);
        let mut IdxSplat: SDValue = DAG.getSplatBuildVector(IdxVT, dl, IdxExt);
        let mut EltSplat: SDValue = DAG.getSplatBuildVector(VT, dl, N1);
        let mut RawIndices: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        for let mut I: u32 = 0; I != NumElts; I += 1 {
            RawIndices.push(DAG.getConstant(I, dl, IdxSVT, false, false));
        }
        let mut Indices: SDValue = DAG.getBuildVector(IdxVT, dl, RawIndices);
        return DAG.getSelectCC(dl, IdxSplat, Indices, EltSplat, N0, SETEQ, SDNodeFlags { Flags: None });
    }
    if N2C.getAPIntValue().uge(NumElts) {
        return SDValue {};
    }
    let mut IdxVal: u64 = N2C.getZExtValue();
    let mut IsZeroElt: bool = isZeroNode(N1);
    let mut IsAllOnesElt: bool = VT.isInteger() && isAllOnesConstant(N1);
    if IsZeroElt || IsAllOnesElt {
        if IsAllOnesElt && ((VT == v16i8 && !self.Subtarget.hasSSE41()) || ((VT == v32i8 || VT == v16i16) && !self.Subtarget.hasInt256())) {
            let mut ZeroCst: SDValue = DAG.getConstant(0, dl, VT.getScalarType(), false, false);
            let mut OnesCst: SDValue = DAG.getAllOnesConstant(dl, VT.getScalarType(), false, false);
            let mut CstVectorElts: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumElts, ZeroCst };
            CstVectorElts[IdxVal] = OnesCst;
            let mut CstVector: SDValue = DAG.getBuildVector(VT, dl, CstVectorElts);
            return DAG.getNode(OR, dl, VT, N0, CstVector);
        }
        if self.Subtarget.hasSSE41() && (EltSizeInBits >= 16 || (IsZeroElt && !VT.is128BitVector())) {
            let mut BlendMask: SmallVector<int, 8> = SmallVector<int, 8> {};
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                BlendMask.push(if i == IdxVal { i + NumElts } else { i });
            }
            let mut CstVector: SDValue = if IsZeroElt { getZeroVector(VT, self.Subtarget, DAG, dl) } else { getOnesVector(VT, DAG, dl) };
            return DAG.getVectorShuffle(VT, dl, N0, CstVector, BlendMask);
        }
    }
    if VT.is256BitVector() || VT.is512BitVector() {
        if VT.is256BitVector() && IdxVal == 0 {
            if (self.Subtarget.hasAVX() && (EltVT == f64 || EltVT == f32)) || (self.Subtarget.hasAVX2() && (EltVT == i32 || EltVT == i64)) {
                let mut N1Vec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, N1);
                return DAG.getNode(BLENDI, dl, VT, N0, N1Vec, DAG.getTargetConstant(1, dl, i8, false));
            }
        }
        let mut NumEltsIn128: u32 = 128 / EltSizeInBits;
        assert!(isPowerOf2_32(NumEltsIn128), "Vectors will always have power-of-two number of elements.");
        if IdxVal >= NumEltsIn128 && ((self.Subtarget.hasAVX2() && EltSizeInBits != 8) || (self.Subtarget.hasAVX() && (EltSizeInBits >= 32) && mayFoldLoad(N1, self.Subtarget, false, false))) {
            let mut N1SplatVec: SDValue = DAG.getSplatBuildVector(VT, dl, N1);
            let mut BlendMask: SmallVector<int, 8> = SmallVector<int, 8> {};
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                BlendMask.push(if i == IdxVal { i + NumElts } else { i });
            }
            return DAG.getVectorShuffle(VT, dl, N0, N1SplatVec, BlendMask);
        }
        let mut V: SDValue = extract128BitVector(N0, IdxVal, DAG, dl);
        let mut IdxIn128: u32 = IdxVal & (NumEltsIn128 - 1);
        V = DAG.getNode(INSERT_VECTOR_ELT, dl, V.getValueType(), V, N1, DAG.getVectorIdxConstant(IdxIn128, dl, false));
        return insert128BitVector(N0, V, IdxVal, DAG, dl);
    }
    assert!(VT.is128BitVector(), "Only 128-bit vector types should be left!");
    if IdxVal == 0 && isBuildVectorAllZeros(N0.getNode()) {
        if EltVT == i32 || EltVT == f32 || EltVT == f64 || EltVT == f16 || EltVT == i64 {
            N1 = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, N1);
            return getShuffleVectorZeroOrUndef(N1, 0, true, self.Subtarget, DAG);
        }
        if EltVT == i16 || EltVT == i8 {
            N1 = DAG.getNode(ZERO_EXTEND, dl, i32, N1);
            let mut ShufVT: MVT = getVectorVT(i32, VT.getSizeInBits().operator unsigned long long() / 32);
            N1 = DAG.getNode(SCALAR_TO_VECTOR, dl, ShufVT, N1);
            N1 = getShuffleVectorZeroOrUndef(N1, 0, true, self.Subtarget, DAG);
            return DAG.getBitcast(VT, N1);
        }
    }
    if VT == v8i16 || (VT == v16i8 && self.Subtarget.hasSSE41()) {
        let mut Opc: u32 = 0;
        if VT == v8i16 {
            assert!(self.Subtarget.hasSSE2(), "SSE2 required for PINSRW");
            Opc = PINSRW;
        } else {
            assert!(VT == v16i8, "PINSRB requires v16i8 vector");
            assert!(self.Subtarget.hasSSE41(), "SSE41 required for PINSRB");
            Opc = PINSRB;
        }
        assert!(N1.getValueType() != i32, "Unexpected VT");
        N1 = DAG.getNode(ANY_EXTEND, dl, i32, N1);
        N2 = DAG.getTargetConstant(IdxVal, dl, i8, false);
        return DAG.getNode(Opc, dl, VT, N0, N1, N2);
    }
    if self.Subtarget.hasSSE41() {
        if EltVT == f32 {
            let mut MinSize: bool = DAG.getMachineFunction().getFunction().hasMinSize();
            if IdxVal == 0 && (!MinSize || !mayFoldLoad(N1, self.Subtarget, false, false)) {
                N1 = DAG.getNode(SCALAR_TO_VECTOR, dl, v4f32, N1);
                return DAG.getNode(BLENDI, dl, VT, N0, N1, DAG.getTargetConstant(1, dl, i8, false));
            }
            N1 = DAG.getNode(SCALAR_TO_VECTOR, dl, v4f32, N1);
            return DAG.getNode(INSERTPS, dl, VT, N0, N1, DAG.getTargetConstant(IdxVal << 4, dl, i8, false));
        }
        if EltVT == i32 || EltVT == i64 {
            return Op;
        }
    }
    return SDValue {};
}

fn LowerFLDEXP(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut X: SDValue = Op.getOperand(0);
    let mut XTy: MVT = X.getSimpleValueType();
    let mut Exp: SDValue = Op.getOperand(1);
    match XTy.SimpleTy {
        _ => {
            return SDValue {};
        },
        f16 => {
            if !Subtarget.hasFP16() {
                X = DAG.getFPExtendOrRound(X, DL, f32);
            }
        },
        f32 => {
            f64;
        },
        v4f32 => {
            v2f64;
        },
        v8f16 => {
            v16f16;
        },
        v32f16 => {
            if Subtarget.hasFP16() {
                Exp = DAG.getNode(SINT_TO_FP, DL, XTy, Exp);
                return DAG.getNode(SCALEF, DL, XTy, X, Exp);
            }
        },
    }
    let mut WideX: SDValue = widenSubVector(X, true, Subtarget, DAG, DL, 512);
    let mut WideExpVT: MVT = getVectorVT(Exp.getSimpleValueType().getVectorElementType(), WideX.getValueType().getVectorNumElements());
    let mut WideExp: SDValue = widenSubVector(WideExpVT, Exp, true, Subtarget, DAG, DL);
    let mut WideExpFp: SDValue = DAG.getNode(SINT_TO_FP, DL, WideX.getValueType(), WideExp);
    let mut Scalef: SDValue = DAG.getNode(SCALEF, DL, WideX.getValueType(), WideX, WideExpFp);
    let mut Final: SDValue = DAG.getExtractSubvector(DL, X.getSimpleValueType(), Scalef, 0);
    return DAG.getFPExtendOrRound(Final, DL, XTy);
}

fn LowerSCALAR_TO_VECTOR(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = Op;
    let mut OpVT: MVT = Op.getSimpleValueType();
    if isZeroNode(Op.getOperand(0)) {
        return getZeroVector(OpVT, Subtarget, DAG, dl);
    }
    if !OpVT.is128BitVector() {
        let mut SizeFactor: u32 = OpVT.getSizeInBits().operator unsigned long long() / 128;
        let mut VT128: MVT = getVectorVT(OpVT.getVectorElementType(), OpVT.getVectorNumElements() / SizeFactor);
        Op = DAG.getNode(SCALAR_TO_VECTOR, dl, VT128, Op.getOperand(0));
        return insert128BitVector(DAG.getUNDEF(OpVT), Op, 0, DAG, dl);
    }
    assert!(OpVT.is128BitVector() && OpVT.isInteger() && OpVT != v2i64, "Expected an SSE type!");
    if OpVT == v4i32 || (OpVT == v8i16 && Subtarget.hasFP16()) {
        return Op;
    }
    let mut AnyExt: SDValue = DAG.getNode(ANY_EXTEND, dl, i32, Op.getOperand(0));
    return DAG.getBitcast(OpVT, DAG.getNode(SCALAR_TO_VECTOR, dl, v4i32, AnyExt));
}

fn LowerINSERT_SUBVECTOR(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op.getSimpleValueType().getVectorElementType() == i1);
    return insert1BitVector(Op, DAG, Subtarget);
}

fn LowerEXTRACT_SUBVECTOR(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op.getSimpleValueType().getVectorElementType() == i1, "Only vXi1 extract_subvectors need custom lowering");
    let mut dl: SDLoc = Op;
    let mut Vec: SDValue = Op.getOperand(0);
    let mut IdxVal: u64 = Op.getConstantOperandVal(1);
    if IdxVal == 0 {
        return Op;
    }
    Vec = widenMaskVector(Vec, false, Subtarget, DAG, dl);
    Vec = DAG.getNode(KSHIFTR, dl, Vec.getSimpleValueType(), Vec, DAG.getTargetConstant(IdxVal, dl, i8, false));
    return DAG.getNode(EXTRACT_SUBVECTOR, dl, Op.getValueType(), Vec, DAG.getVectorIdxConstant(0, dl, false));
}

fn X86TargetLowering::getGlobalWrapperKind(self: *X86TargetLowering, GV: *GlobalValue, OpFlags: u8) -> u32 {
    if GV && GV.isAbsoluteSymbolRef() {
        return Wrapper;
    }
    if self.Subtarget.isPICStyleRIPRel() && (OpFlags == MO_NO_FLAG || OpFlags == MO_COFFSTUB || OpFlags == MO_DLLIMPORT) {
        return WrapperRIP;
    }
    if OpFlags == MO_GOTPCREL || OpFlags == MO_GOTPCREL_NORELAX {
        return WrapperRIP;
    }
    return Wrapper;
}

fn X86TargetLowering::LowerConstantPool(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut CP: *mut ConstantPoolSDNode = cast(Op);
    let mut OpFlag: u8 = self.Subtarget.classifyLocalReference(null);
    let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut Result: SDValue = DAG.getTargetConstantPool(CP.getConstVal(), PtrVT, CP.getAlign(), CP.getOffset(), OpFlag);
    let mut DL: SDLoc = CP;
    Result = DAG.getNode(self.getGlobalWrapperKind(null, OpFlag), DL, PtrVT, Result);
    if OpFlag {
        Result = DAG.getNode(ADD, DL, PtrVT, DAG.getNode(GlobalBaseReg, SDLoc {}, PtrVT), Result);
    }
    return Result;
}

fn X86TargetLowering::LowerJumpTable(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut JT: *mut JumpTableSDNode = cast(Op);
    let mut OpFlag: u8 = self.Subtarget.classifyLocalReference(null);
    let mut PtrVT: EVT = Op.getValueType();
    let mut Result: SDValue = DAG.getTargetJumpTable(JT.getIndex(), PtrVT, OpFlag);
    let mut DL: SDLoc = JT;
    Result = DAG.getNode(self.getGlobalWrapperKind(null, OpFlag), DL, PtrVT, Result);
    if OpFlag {
        Result = DAG.getNode(ADD, DL, PtrVT, DAG.getNode(GlobalBaseReg, SDLoc {}, PtrVT), Result);
    }
    return Result;
}

fn X86TargetLowering::LowerExternalSymbol(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    return self.LowerGlobalOrExternal(Op, DAG, false, null);
}

fn X86TargetLowering::LowerBlockAddress(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut OpFlags: u8 = self.Subtarget.classifyBlockAddressReference();
    let mut BA: *BlockAddress = cast(Op).getBlockAddress();
    let mut Offset: i64 = cast(Op).getOffset();
    let mut dl: SDLoc = Op;
    let mut PtrVT: EVT = Op.getValueType();
    let mut Result: SDValue = DAG.getTargetBlockAddress(BA, PtrVT, Offset, OpFlags);
    Result = DAG.getNode(self.getGlobalWrapperKind(null, OpFlags), dl, PtrVT, Result);
    if isGlobalRelativeToPICBase(OpFlags) {
        Result = DAG.getNode(ADD, dl, PtrVT, DAG.getNode(GlobalBaseReg, dl, PtrVT), Result);
    }
    return Result;
}

fn X86TargetLowering::LowerGlobalOrExternal(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, ForCall: bool, IsImpCall: *mut bool) -> SDValue {
    let mut dl: SDLoc = Op;
    let mut GV: *GlobalValue = null;
    let mut Offset: i64 = 0;
    let mut ExternalSym: *u8 = null;
    if dyn_cast(Op) {
        G;
    } else {
        GV = G.getGlobal();
        Offset = G.getOffset();
    }
    let mut Mod: *Module = *DAG.getMachineFunction().getFunction().getParent();
    let mut OpFlags: u8 = 0;
    if ForCall {
        OpFlags = self.Subtarget.classifyGlobalFunctionReference(GV, Mod);
    } else {
        OpFlags = self.Subtarget.classifyGlobalReference(GV, Mod);
    }
    let mut HasPICReg: bool = isGlobalRelativeToPICBase(OpFlags);
    let mut NeedsLoad: bool = isGlobalStubReference(OpFlags);
    let mut M: Model = DAG.getTarget().getCodeModel();
    let mut PtrVT: EVT = Op.getValueType();
    let mut Result: SDValue = SDValue {};
    if GV {
        let mut GlobalOffset: i64 = 0;
        if OpFlags == MO_NO_FLAG && Offset >= 0 && isOffsetSuitableForCodeModel(Offset, M, true) {
            swap(GlobalOffset, Offset);
        }
        Result = DAG.getTargetGlobalAddress(GV, dl, PtrVT, GlobalOffset, OpFlags);
    } else {
        Result = DAG.getTargetExternalSymbol(ExternalSym, PtrVT, OpFlags);
    }
    if ForCall && !NeedsLoad && !HasPICReg && Offset == 0 {
        return Result;
    }
    if IsImpCall && (OpFlags == MO_DLLIMPORT) && Mod.getModuleFlag("import-call-optimization") {
        assert!(ForCall, "Should only enable import call optimization if we are lowering a call");
        *IsImpCall = true;
        return Result;
    }
    Result = DAG.getNode(self.getGlobalWrapperKind(GV, OpFlags), dl, PtrVT, Result);
    if HasPICReg {
        Result = DAG.getNode(ADD, dl, PtrVT, DAG.getNode(GlobalBaseReg, dl, PtrVT), Result);
    }
    if NeedsLoad {
        Result = DAG.getLoad(PtrVT, dl, DAG.getEntryNode(), Result, getGOT(DAG.getMachineFunction()), MaybeAlign {}, MONone, MMOMetadata {});
    }
    if Offset != 0 {
        Result = DAG.getNode(ADD, dl, PtrVT, Result, DAG.getSignedConstant(Offset, dl, PtrVT, false, false));
    }
    return Result;
}

fn X86TargetLowering::LowerGlobalAddress(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    return self.LowerGlobalOrExternal(Op, DAG, false, null);
}

fn GetTLSADDR(DAG: *mut SelectionDAG, GA: *mut GlobalAddressSDNode, PtrVT: EVT, ReturnReg: u32, OperandFlags: u8, LoadGlobalBaseReg: bool, LocalDynamic: bool) -> SDValue {
    let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
    let mut NodeTys: SDVTList = DAG.getVTList(Other, Glue);
    let mut dl: SDLoc = GA;
    let mut TGA: SDValue = SDValue {};
    let mut UseTLSDESC: bool = DAG.getTarget().useTLSDESC();
    let mut Chain: SDValue = DAG.getEntryNode();
    let mut Ret: SDValue = SDValue {};
    if LocalDynamic && UseTLSDESC {
        TGA = DAG.getTargetExternalSymbol("_TLS_MODULE_BASE_", PtrVT, OperandFlags);
        if operator(TGA).hasOneUse() {
            let mut TLSDescOp: *mut SDNode = operator(operator(TGA).user_begin());
            assert!(TLSDescOp.getOpcode() == TLSDESC, "Unexpected TLSDESC DAG");
            let mut CallSeqEndOp: *mut SDNode = TLSDescOp.getGluedUser();
            assert!(CallSeqEndOp && CallSeqEndOp.getOpcode() == CALLSEQ_END, "Unexpected TLSDESC DAG");
            let mut CopyFromRegOp: *mut SDNode = CallSeqEndOp.getGluedUser();
            assert!(CopyFromRegOp && CopyFromRegOp.getOpcode() == CopyFromReg, "Unexpected TLSDESC DAG");
            Ret = SDValue { Node: CopyFromRegOp, ResNo: 0 };
        }
    } else {
        TGA = DAG.getTargetGlobalAddress(GA.getGlobal(), dl, GA.getValueType(0), GA.getOffset(), OperandFlags);
    }
    if !Ret {
        let mut CallType: u32 = if UseTLSDESC { TLSDESC } else { if LocalDynamic { TLSBASEADDR } else { TLSADDR } };
        Chain = DAG.getCALLSEQ_START(Chain, 0, 0, dl);
        if LoadGlobalBaseReg {
            let mut InGlue: SDValue = SDValue {};
            Chain = DAG.getCopyToReg(Chain, dl, EBX, DAG.getNode(GlobalBaseReg, dl, PtrVT), InGlue);
            InGlue = Chain.getValue(1);
            Chain = DAG.getNode(CallType, dl, NodeTys, [Chain, TGA, InGlue]);
        } else {
            Chain = DAG.getNode(CallType, dl, NodeTys, [Chain, TGA]);
        }
        Chain = DAG.getCALLSEQ_END(Chain, 0, 0, Chain.getValue(1), dl);
        MFI.setHasCalls(true);
        let mut Glue: SDValue = Chain.getValue(1);
        Ret = DAG.getCopyFromReg(Chain, dl, ReturnReg, PtrVT, Glue);
    }
    if !UseTLSDESC {
        return Ret;
    }
    let mut Subtarget: *X86Subtarget = DAG.getSubtarget();
    let mut Seg: u32 = if Subtarget.is64Bit() { FS } else { GS };
    let mut Ptr: *mut Value = getNullValue(get(*DAG.getContext(), Seg));
    let mut Offset: SDValue = DAG.getLoad(PtrVT, dl, DAG.getEntryNode(), DAG.getIntPtrConstant(0, dl, false), MachinePointerInfo { Ptr, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    return DAG.getNode(ADD, dl, PtrVT, Ret, Offset);
}

fn LowerToTLSGeneralDynamicModel32(GA: *mut GlobalAddressSDNode, DAG: *mut SelectionDAG, PtrVT: EVT) -> SDValue {
    return GetTLSADDR(DAG, GA, PtrVT, EAX, MO_TLSGD, true, false);
}

fn LowerToTLSGeneralDynamicModel64(GA: *mut GlobalAddressSDNode, DAG: *mut SelectionDAG, PtrVT: EVT) -> SDValue {
    return GetTLSADDR(DAG, GA, PtrVT, RAX, MO_TLSGD, false, false);
}

fn LowerToTLSGeneralDynamicModelX32(GA: *mut GlobalAddressSDNode, DAG: *mut SelectionDAG, PtrVT: EVT) -> SDValue {
    return GetTLSADDR(DAG, GA, PtrVT, EAX, MO_TLSGD, false, false);
}

fn LowerToTLSLocalDynamicModel(GA: *mut GlobalAddressSDNode, DAG: *mut SelectionDAG, PtrVT: EVT, Is64Bit: bool, Is64BitLP64: bool) -> SDValue {
    let mut dl: SDLoc = GA;
    let mut MFI: *mut X86MachineFunctionInfo = DAG.getMachineFunction().getInfo();
    MFI.incNumLocalDynamicTLSAccesses();
    let mut Base: SDValue = SDValue {};
    if Is64Bit {
        let mut ReturnReg: u32 = if Is64BitLP64 { RAX } else { EAX };
        Base = GetTLSADDR(DAG, GA, PtrVT, ReturnReg, MO_TLSLD, false, true);
    } else {
        Base = GetTLSADDR(DAG, GA, PtrVT, EAX, MO_TLSLDM, true, true);
    }
    let mut OperandFlags: u8 = MO_DTPOFF;
    let mut WrapperKind: u32 = Wrapper;
    let mut TGA: SDValue = DAG.getTargetGlobalAddress(GA.getGlobal(), dl, GA.getValueType(0), GA.getOffset(), OperandFlags);
    let mut Offset: SDValue = DAG.getNode(WrapperKind, dl, PtrVT, TGA);
    return DAG.getNode(ADD, dl, PtrVT, Offset, Base);
}

fn LowerToTLSExecModel(GA: *mut GlobalAddressSDNode, DAG: *mut SelectionDAG, PtrVT: EVT, model: Model, is64Bit: bool, isPIC: bool) -> SDValue {
    let mut dl: SDLoc = GA;
    let mut Ptr: *mut Value = getNullValue(get(*DAG.getContext(), if is64Bit { FS } else { GS }));
    let mut ThreadPointer: SDValue = DAG.getLoad(PtrVT, dl, DAG.getEntryNode(), DAG.getIntPtrConstant(0, dl, false), MachinePointerInfo { Ptr, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    let mut OperandFlags: u8 = 0;
    let mut WrapperKind: u32 = Wrapper;
    if model == LocalExec {
        OperandFlags = if is64Bit { MO_TPOFF } else { MO_NTPOFF };
    } else if model == InitialExec {
        if is64Bit {
            OperandFlags = MO_GOTTPOFF;
            WrapperKind = WrapperRIP;
        } else {
            OperandFlags = if isPIC { MO_GOTNTPOFF } else { MO_INDNTPOFF };
        }
    } else {
        llvm_unreachable_internal("Unexpected model", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 20049);
    }
    let mut TGA: SDValue = DAG.getTargetGlobalAddress(GA.getGlobal(), dl, GA.getValueType(0), GA.getOffset(), OperandFlags);
    let mut Offset: SDValue = DAG.getNode(WrapperKind, dl, PtrVT, TGA);
    if model == InitialExec {
        if isPIC && !is64Bit {
            Offset = DAG.getNode(ADD, dl, PtrVT, DAG.getNode(GlobalBaseReg, SDLoc {}, PtrVT), Offset);
        }
        Offset = DAG.getLoad(PtrVT, dl, DAG.getEntryNode(), Offset, getGOT(DAG.getMachineFunction()), MaybeAlign {}, MONone, MMOMetadata {});
    }
    return DAG.getNode(ADD, dl, PtrVT, ThreadPointer, Offset);
}

fn X86TargetLowering::LowerGlobalTLSAddress(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut GA: *mut GlobalAddressSDNode = cast(Op);
    if DAG.getTarget().useEmulatedTLS() {
        return self.LowerToTLSEmulatedModel(GA, DAG);
    }
    let mut GV: *GlobalValue = GA.getGlobal();
    let mut PtrVT: EVT = Op.getValueType();
    let mut PositionIndependent: bool = self.isPositionIndependent();
    if self.Subtarget.isTargetELF() {
        let mut model: Model = DAG.getTarget().getTLSModel(GV);
        if self.Subtarget.isLFI() {
            if model == GeneralDynamic || model == LocalDynamic {
                model = InitialExec;
            }
        }
        match model {
            GeneralDynamic => {
                if self.Subtarget.is64Bit() {
                    if self.Subtarget.isTarget64BitLP64() {
                        return LowerToTLSGeneralDynamicModel64(GA, DAG, PtrVT);
                    }
                    return LowerToTLSGeneralDynamicModelX32(GA, DAG, PtrVT);
                }
            },
            LocalDynamic => {
                return LowerToTLSLocalDynamicModel(GA, DAG, PtrVT, self.Subtarget.is64Bit(), self.Subtarget.isTarget64BitLP64());
            },
            InitialExec => {
                LocalExec;
            },
        }
        llvm_unreachable_internal("Unknown TLS model.", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 20113);
    }
    if self.Subtarget.isTargetDarwin() {
        let mut OpFlag: u8 = 0;
        let mut WrapperKind: u32 = 0;
        let mut PIC32: bool = PositionIndependent && !self.Subtarget.is64Bit();
        if PIC32 {
            OpFlag = MO_TLVP_PIC_BASE;
            WrapperKind = Wrapper;
        } else {
            OpFlag = MO_TLVP;
            WrapperKind = WrapperRIP;
        }
        let mut DL: SDLoc = Op;
        let mut Result: SDValue = DAG.getTargetGlobalAddress(GA.getGlobal(), DL, GA.getValueType(0), GA.getOffset(), OpFlag);
        let mut Offset: SDValue = DAG.getNode(WrapperKind, DL, PtrVT, Result);
        if PIC32 {
            Offset = DAG.getNode(ADD, DL, PtrVT, DAG.getNode(GlobalBaseReg, SDLoc {}, PtrVT), Offset);
        }
        let mut Chain: SDValue = DAG.getEntryNode();
        let mut NodeTys: SDVTList = DAG.getVTList(Other, Glue);
        Chain = DAG.getCALLSEQ_START(Chain, 0, 0, DL);
        let mut Args: [2]SDValue = [Chain, Offset];
        Chain = DAG.getNode(TLSCALL, DL, NodeTys, Args);
        Chain = DAG.getCALLSEQ_END(Chain, 0, 0, Chain.getValue(1), DL);
        let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
        MFI.setAdjustsStack(true);
        let mut Reg: u32 = if self.Subtarget.is64Bit() { RAX } else { EAX };
        return DAG.getCopyFromReg(Chain, DL, Reg, PtrVT, Chain.getValue(1));
    }
    if self.Subtarget.isOSWindows() {
        let mut dl: SDLoc = GA;
        let mut Chain: SDValue = DAG.getEntryNode();
        let mut Ptr: *mut Value = getNullValue(if self.Subtarget.is64Bit() { get(*DAG.getContext(), GS) } else { get(*DAG.getContext(), FS) });
        let mut TlsArray: SDValue = if self.Subtarget.is64Bit() { DAG.getIntPtrConstant(88, dl, false) } else { (if self.Subtarget.isTargetWindowsGNU() { DAG.getIntPtrConstant(44, dl, false) } else { DAG.getExternalSymbol("_tls_array", PtrVT) }) };
        let mut ThreadPointer: SDValue = DAG.getLoad(PtrVT, dl, Chain, TlsArray, MachinePointerInfo { Ptr, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
        let mut res: SDValue = SDValue {};
        if GV.getThreadLocalMode() == LocalExecTLSModel {
            res = ThreadPointer;
        } else {
            let mut IDX: SDValue = DAG.getExternalSymbol("_tls_index", PtrVT);
            if self.Subtarget.is64Bit() {
                IDX = DAG.getExtLoad(ZEXTLOAD, dl, PtrVT, Chain, IDX, MachinePointerInfo { 0, 0 }, i32, MaybeAlign {}, MONone, MMOMetadata {});
            } else {
                IDX = DAG.getLoad(PtrVT, dl, Chain, IDX, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
            }
            let mut DL: *DataLayout = DAG.getDataLayout();
            let mut Scale: SDValue = DAG.getConstant(Log2_64_Ceil(DL.getPointerSize(0)), dl, i8, false, false);
            IDX = DAG.getNode(SHL, dl, PtrVT, IDX, Scale);
            res = DAG.getNode(ADD, dl, PtrVT, ThreadPointer, IDX);
        }
        res = DAG.getLoad(PtrVT, dl, Chain, res, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
        let mut TGA: SDValue = DAG.getTargetGlobalAddress(GA.getGlobal(), dl, GA.getValueType(0), GA.getOffset(), MO_SECREL);
        let mut Offset: SDValue = DAG.getNode(Wrapper, dl, PtrVT, TGA);
        return DAG.getNode(ADD, dl, PtrVT, res, Offset);
    }
    llvm_unreachable_internal("TLS not implemented for this target.", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 20226);
}

fn X86TargetLowering::addressingModeSupportsTLS(self: *X86TargetLowering, GV: *GlobalValue) -> bool {
    if self.Subtarget.is64Bit() && self.Subtarget.isTargetELF() {
        let mut TM: *TargetMachine = self.getTargetMachine();
        let mut Model: Model = TM.getTLSModel(&mut GV);
        match Model {
            LocalExec => {
                InitialExec;
            },
            LocalDynamic => {
                GeneralDynamic;
            },
        }
    }
    return false;
}

fn LowerShiftParts(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    DAG.getTargetLoweringInfo().expandShiftParts(Op.getNode(), Lo, Hi, DAG);
    return DAG.getMergeValues([Lo, Hi], Op);
}

fn LowerI64IntToFP_AVX512DQ(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!((Op.getOpcode() == SINT_TO_FP || Op.getOpcode() == STRICT_SINT_TO_FP || Op.getOpcode() == STRICT_UINT_TO_FP || Op.getOpcode() == UINT_TO_FP), "Unexpected opcode!");
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut OpNo: u32 = if IsStrict { 1 } else { 0 };
    let mut Src: SDValue = Op.getOperand(OpNo);
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut VT: MVT = Op.getSimpleValueType();
    if !Subtarget.hasDQI() || SrcVT != i64 || Subtarget.is64Bit() || (VT != f32 && VT != f64) {
        return SDValue {};
    }
    let mut NumElts: u32 = if Subtarget.hasVLX() { 4 } else { 8 };
    let mut VecInVT: MVT = getVectorVT(i64, NumElts);
    let mut VecVT: MVT = getVectorVT(VT, NumElts);
    let mut InVec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, VecInVT, Src);
    if IsStrict {
        let mut CvtVec: SDValue = DAG.getNode(Op.getOpcode(), dl, [VecVT, Other], [Op.getOperand(0), InVec]);
        let mut Chain: SDValue = CvtVec.getValue(1);
        let mut Value: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT, CvtVec, DAG.getVectorIdxConstant(0, dl, false));
        return DAG.getMergeValues([Value, Chain], dl);
    }
    let mut CvtVec: SDValue = DAG.getNode(Op.getOpcode(), dl, VecVT, InVec);
    return DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT, CvtVec, DAG.getVectorIdxConstant(0, dl, false));
}

fn LowerI64IntToFP16(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!((Op.getOpcode() == SINT_TO_FP || Op.getOpcode() == STRICT_SINT_TO_FP || Op.getOpcode() == STRICT_UINT_TO_FP || Op.getOpcode() == UINT_TO_FP), "Unexpected opcode!");
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut Src: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut VT: MVT = Op.getSimpleValueType();
    if SrcVT != i64 || Subtarget.is64Bit() || VT != f16 {
        return SDValue {};
    }
    assert!(Subtarget.hasFP16(), "Expected FP16");
    let mut InVec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, v2i64, Src);
    if IsStrict {
        let mut CvtVec: SDValue = DAG.getNode(Op.getOpcode(), dl, [v2f16, Other], [Op.getOperand(0), InVec]);
        let mut Chain: SDValue = CvtVec.getValue(1);
        let mut Value: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT, CvtVec, DAG.getVectorIdxConstant(0, dl, false));
        return DAG.getMergeValues([Value, Chain], dl);
    }
    let mut CvtVec: SDValue = DAG.getNode(Op.getOpcode(), dl, v2f16, InVec);
    return DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT, CvtVec, DAG.getVectorIdxConstant(0, dl, false));
}

fn useVectorCast(Opcode: u32, FromVT: MVT, ToVT: MVT, Subtarget: *X86Subtarget) -> bool {
    match Opcode {
        SINT_TO_FP => {
            if !Subtarget.hasSSE2() || FromVT != v4i32 {
                return false;
            }
        },
        UINT_TO_FP => {
            if !Subtarget.hasAVX512() || FromVT != v4i32 {
                return false;
            }
        },
        _ => {
            return false;
        },
    }
}

fn vectorizeExtractedCast(Cast: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Extract: SDValue = Cast.getOperand(0);
    let mut DestVT: MVT = Cast.getSimpleValueType();
    if Extract.getOpcode() != EXTRACT_VECTOR_ELT || !isa(Extract.getOperand(1)) {
        return SDValue {};
    }
    let mut VecOp: SDValue = Extract.getOperand(0);
    let mut FromVT: EVT = VecOp.getValueType();
    let mut NumEltsInXMM: u32 = 128 / FromVT.getScalarSizeInBits();
    let mut Vec128VT: MVT = getVectorVT(FromVT.getScalarType().getSimpleVT(), NumEltsInXMM);
    let mut ToVT: MVT = getVectorVT(DestVT, NumEltsInXMM);
    if !useVectorCast(Cast.getOpcode(), Vec128VT, ToVT, Subtarget) {
        return SDValue {};
    }
    if !isNullConstant(Extract.getOperand(1)) {
        let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { FromVT.getVectorNumElements(), -1 };
        Mask[0] = Extract.getConstantOperandVal(1);
        VecOp = DAG.getVectorShuffle(FromVT, DL, VecOp, DAG.getUNDEF(FromVT), Mask);
    }
    if FromVT != Vec128VT {
        VecOp = extract128BitVector(VecOp, 0, DAG, DL);
    }
    let mut VCast: SDValue = DAG.getNode(Cast.getOpcode(), DL, ToVT, VecOp);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, DestVT, VCast, DAG.getVectorIdxConstant(0, DL, false));
}

fn lowerFPToIntToFP(CastToFP: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut CastToInt: SDValue = CastToFP.getOperand(0);
    let mut VT: MVT = CastToFP.getSimpleValueType();
    if (CastToFP.getOpcode() != SINT_TO_FP && CastToFP.getOpcode() != UINT_TO_FP) || (CastToInt.getOpcode() != FP_TO_SINT && CastToInt.getOpcode() != FP_TO_UINT) || VT.isVector() {
        return SDValue {};
    }
    let mut IntVT: MVT = CastToInt.getSimpleValueType();
    let mut X: SDValue = CastToInt.getOperand(0);
    let mut SrcVT: MVT = X.getSimpleValueType();
    if SrcVT != f32 && SrcVT != f64 {
        return SDValue {};
    }
    if !Subtarget.hasSSE2() || (VT != f32 && VT != f64) || (IntVT != i32 && IntVT != i64) {
        return SDValue {};
    }
    let mut SrcSize: u32 = SrcVT.getSizeInBits().operator unsigned long long();
    let mut IntSize: u32 = IntVT.getSizeInBits().operator unsigned long long();
    let mut VTSize: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut FromUnsigned: bool = CastToFP.getOpcode() == UINT_TO_FP;
    let mut ToUnsigned: bool = CastToInt.getOpcode() == FP_TO_UINT;
    let mut ToIntOpcode: u32 = if SrcSize != IntSize { CVTTP2SI } else { FP_TO_SINT as u32 };
    let mut ToFPOpcode: u32 = if IntSize != VTSize { CVTSI2P } else { SINT_TO_FP as u32 };
    let mut Width: u32 = 128;
    if Subtarget.hasVLX() && Subtarget.hasDQI() {
        if ToUnsigned {
            ToIntOpcode = if SrcSize != IntSize { CVTTP2UI } else { FP_TO_UINT as u32 };
        }
        if FromUnsigned {
            ToFPOpcode = if IntSize != VTSize { CVTUI2P } else { UINT_TO_FP as u32 };
        }
    } else {
        if FromUnsigned || ToUnsigned || IntVT == i64 {
            if !Subtarget.useAVX512Regs() || !Subtarget.hasDQI() {
                return SDValue {};
            }
            Width = 512;
            ToIntOpcode = CastToInt.getOpcode();
            ToFPOpcode = if FromUnsigned { UINT_TO_FP } else { SINT_TO_FP };
        }
    }
    let mut VecSrcVT: MVT = MVT {};
    let mut VecIntVT: MVT = MVT {};
    let mut VecVT: MVT = MVT {};
    let mut NumElts: u32 = 0;
    let mut SrcElts: u32 = 0;
    let mut VTElts: u32 = 0;
    if Width == 512 {
        NumElts = if Width / IntSize < Width / SrcSize { Width / IntSize } else { Width / SrcSize };
        SrcElts = NumElts;
        VTElts = NumElts;
    } else {
        NumElts = Width / IntSize;
        SrcElts = Width / SrcSize;
        VTElts = Width / VTSize;
    }
    VecIntVT = getVectorVT(IntVT, NumElts);
    VecSrcVT = getVectorVT(SrcVT, SrcElts);
    VecVT = getVectorVT(VT, VTElts);
    let mut ZeroIdx: SDValue = DAG.getVectorIdxConstant(0, DL, false);
    let mut VecX: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, VecSrcVT, X);
    let mut VCastToInt: SDValue = DAG.getNode(ToIntOpcode, DL, VecIntVT, VecX);
    let mut VCastToFP: SDValue = DAG.getNode(ToFPOpcode, DL, VecVT, VCastToInt);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, VCastToFP, ZeroIdx);
}

fn lowerINT_TO_FP_vXi64(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut VT: MVT = operator(Op).getSimpleValueType(0);
    let mut Src: SDValue = operator(Op).getOperand(if IsStrict { 1 } else { 0 });
    if Subtarget.hasDQI() {
        assert!(!Subtarget.hasVLX(), "Unexpected features");
        assert!((Src.getSimpleValueType() == v2i64 || Src.getSimpleValueType() == v4i64), "Unsupported custom type");
        assert!((VT == v4f32 || VT == v2f64 || VT == v4f64), "Unexpected VT!");
        let mut WideVT: MVT = if VT == v4f32 { v8f32 } else { v8f64 };
        let mut Tmp: SDValue = if IsStrict { DAG.getConstant(0, DL, v8i64, false, false) } else { DAG.getUNDEF(v8i64) };
        Src = DAG.getNode(INSERT_SUBVECTOR, DL, v8i64, Tmp, Src, DAG.getVectorIdxConstant(0, DL, false));
        let mut Res: SDValue = SDValue {};
        let mut Chain: SDValue = SDValue {};
        if IsStrict {
            Res = DAG.getNode(Op.getOpcode(), DL, [WideVT, Other], [operator(Op).getOperand(0), Src]);
            Chain = Res.getValue(1);
        } else {
            Res = DAG.getNode(Op.getOpcode(), DL, WideVT, Src);
        }
        Res = DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Res, DAG.getVectorIdxConstant(0, DL, false));
        if IsStrict {
            return DAG.getMergeValues([Res, Chain], DL);
        }
        return Res;
    }
    let mut IsSigned: bool = operator(Op).getOpcode() == SINT_TO_FP || operator(Op).getOpcode() == STRICT_SINT_TO_FP;
    if VT != v4f32 || IsSigned {
        return SDValue {};
    }
    let mut Zero: SDValue = DAG.getConstant(0, DL, v4i64, false, false);
    let mut One: SDValue = DAG.getConstant(1, DL, v4i64, false, false);
    let mut Sign: SDValue = DAG.getNode(OR, DL, v4i64, DAG.getNode(SRL, DL, v4i64, Src, One), DAG.getNode(AND, DL, v4i64, Src, One));
    let mut IsNeg: SDValue = DAG.getSetCC(DL, v4i64, Src, Zero, SETLT, SDValue {}, false, None);
    let mut SignSrc: SDValue = DAG.getSelect(DL, v4i64, IsNeg, Sign, Src, SDNodeFlags { Flags: None });
    let mut SignCvts: SmallVector<SDValue, 4> = 4;
    let mut Chains: SmallVector<SDValue, 4> = 4;
    for let mut i: i32 = 0; i != 4; i += 1 {
        let mut Elt: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, i64, SignSrc, DAG.getVectorIdxConstant(i, DL, false));
        if IsStrict {
            SignCvts[i] = DAG.getNode(STRICT_SINT_TO_FP, DL, [f32, Other], [Op.getOperand(0), Elt]);
            Chains[i] = SignCvts[i].getValue(1);
        } else {
            SignCvts[i] = DAG.getNode(SINT_TO_FP, DL, f32, Elt);
        }
    }
    let mut SignCvt: SDValue = DAG.getBuildVector(VT, DL, SignCvts);
    let mut Slow: SDValue = SDValue {};
    let mut Chain: SDValue = SDValue {};
    if IsStrict {
        Chain = DAG.getNode(TokenFactor, DL, Other, Chains);
        Slow = DAG.getNode(STRICT_FADD, DL, [v4f32, Other], [Chain, SignCvt, SignCvt]);
        Chain = Slow.getValue(1);
    } else {
        Slow = DAG.getNode(FADD, DL, v4f32, SignCvt, SignCvt);
    }
    IsNeg = DAG.getNode(TRUNCATE, DL, v4i32, IsNeg);
    let mut Cvt: SDValue = DAG.getSelect(DL, v4f32, IsNeg, Slow, SignCvt, SDNodeFlags { Flags: None });
    if IsStrict {
        return DAG.getMergeValues([Cvt, Chain], DL);
    }
    return Cvt;
}

fn promoteXINT_TO_FP(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut Src: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut Chain: SDValue = if IsStrict { operator(Op).getOperand(0) } else { DAG.getEntryNode() };
    let mut VT: MVT = Op.getSimpleValueType();
    let mut NVT: MVT = VT.changeElementType(f32);
    let mut Rnd: SDValue = DAG.getIntPtrConstant(0, dl, true);
    if IsStrict {
        return DAG.getNode(STRICT_FP_ROUND, dl, [VT, Other], [Chain, DAG.getNode(Op.getOpcode(), dl, [NVT, Other], [Chain, Src]), Rnd]);
    }
    return DAG.getNode(FP_ROUND, dl, VT, DAG.getNode(Op.getOpcode(), dl, NVT, Src), Rnd);
}

fn isLegalConversion(VT: MVT, FloatVT: MVT, IsSigned: bool, Subtarget: *X86Subtarget) -> bool {
    if FloatVT.getScalarType() != f16 || Subtarget.hasVLX() {
        if VT == v4i32 && Subtarget.hasSSE2() && IsSigned {
            return true;
        }
        if VT == v8i32 && Subtarget.hasAVX() && IsSigned {
            return true;
        }
    }
    if Subtarget.hasVLX() && (VT == v4i32 || VT == v8i32) {
        return true;
    }
    if Subtarget.useAVX512Regs() {
        if VT == v16i32 {
            return true;
        }
        if VT == v8i64 && FloatVT == v8f16 && Subtarget.hasFP16() {
            return true;
        }
        if VT == v8i64 && Subtarget.hasDQI() {
            return true;
        }
    }
    if Subtarget.hasDQI() && Subtarget.hasVLX() && (VT == v2i64 || VT == v4i64) {
        return true;
    }
    return false;
}

fn X86TargetLowering::LowerSINT_TO_FP(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut OpNo: u32 = if IsStrict { 1 } else { 0 };
    let mut Src: SDValue = Op.getOperand(OpNo);
    let mut Chain: SDValue = if IsStrict { operator(Op).getOperand(0) } else { DAG.getEntryNode() };
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut VT: MVT = Op.getSimpleValueType();
    let mut dl: SDLoc = Op;
    if isBF16orSoftF16(VT, self.Subtarget) {
        return promoteXINT_TO_FP(Op, dl, DAG);
    } else if isLegalConversion(SrcVT, VT, true, self.Subtarget) {
        return Op;
    }
    if self.Subtarget.isTargetWin64() && SrcVT == i128 {
        return self.LowerWin64_INT128_TO_FP(Op, DAG);
    }
    if vectorizeExtractedCast(Op, dl, DAG, self.Subtarget) {
        Extract;
    } else {
        return Extract;
    }
    if lowerFPToIntToFP(Op, dl, DAG, self.Subtarget) {
        R;
    } else {
        return R;
    }
    if SrcVT.isVector() {
        if SrcVT == v2i32 && VT == v2f64 {
            if IsStrict {
                return DAG.getNode(STRICT_CVTSI2P, dl, [VT, Other], [Chain, DAG.getNode(CONCAT_VECTORS, dl, v4i32, Src, DAG.getUNDEF(SrcVT))]);
            }
            return DAG.getNode(CVTSI2P, dl, VT, DAG.getNode(CONCAT_VECTORS, dl, v4i32, Src, DAG.getUNDEF(SrcVT)));
        }
        if SrcVT == v2i64 || SrcVT == v4i64 {
            return lowerINT_TO_FP_vXi64(Op, dl, DAG, self.Subtarget);
        }
        return SDValue {};
    }
    assert!(SrcVT <= i64 && SrcVT >= i16, "Unknown SINT_TO_FP to lower!");
    let mut UseSSEReg: bool = self.isScalarFPTypeInSSEReg(VT);
    if SrcVT == i32 && UseSSEReg {
        return Op;
    }
    if SrcVT == i64 && UseSSEReg && self.Subtarget.is64Bit() {
        return Op;
    }
    if LowerI64IntToFP_AVX512DQ(Op, dl, DAG, self.Subtarget) {
        V;
    } else {
        return V;
    }
    if LowerI64IntToFP16(Op, dl, DAG, self.Subtarget) {
        V;
    } else {
        return V;
    }
    if SrcVT == i16 && (UseSSEReg || VT == f128) {
        let mut Ext: SDValue = DAG.getNode(SIGN_EXTEND, dl, i32, Src);
        if IsStrict {
            return DAG.getNode(STRICT_SINT_TO_FP, dl, [VT, Other], [Chain, Ext]);
        }
        return DAG.getNode(SINT_TO_FP, dl, VT, Ext);
    }
    if VT == f128 || !self.Subtarget.hasX87() {
        return SDValue {};
    }
    let mut ValueToStore: SDValue = Src;
    if SrcVT == i64 && self.Subtarget.hasSSE2() && !self.Subtarget.is64Bit() {
        ValueToStore = DAG.getBitcast(f64, ValueToStore);
    }
    let mut Size: u32 = SrcVT.getStoreSize().operator unsigned long long();
    let mut Alignment: Align = Size;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut PtrVT: MVT = self.getPointerTy(MF.getDataLayout(), 0);
    let mut SSFI: i32 = MF.getFrameInfo().CreateStackObject(Size, Alignment, false, null, 0);
    let mut MPI: MachinePointerInfo = getFixedStack(DAG.getMachineFunction(), SSFI, 0);
    let mut StackSlot: SDValue = DAG.getFrameIndex(SSFI, PtrVT, false);
    Chain = DAG.getStore(Chain, dl, ValueToStore, StackSlot, MPI, Alignment, MONone, MMOMetadata {});
    let mut Tmp: pair<SDValue, SDValue> = self.BuildFILD(VT, SrcVT, dl, Chain, StackSlot, MPI, Alignment, DAG);
    if IsStrict {
        return DAG.getMergeValues([Tmp.first, Tmp.second], dl);
    }
    return Tmp.first;
}

fn X86TargetLowering::BuildFILD(self: *X86TargetLowering, DstVT: EVT, SrcVT: EVT, DL: *SDLoc, Chain: SDValue, Pointer: SDValue, PtrInfo: MachinePointerInfo, Alignment: Align, DAG: *mut SelectionDAG) -> pair<SDValue, SDValue> {
    let mut Tys: SDVTList = SDVTList {};
    let mut useSSE: bool = self.isScalarFPTypeInSSEReg(DstVT);
    if useSSE {
        Tys = DAG.getVTList(f80, Other);
    } else {
        Tys = DAG.getVTList(DstVT, Other);
    }
    let mut FILDOps: [2]SDValue = [Chain, Pointer];
    let mut Result: SDValue = DAG.getMemIntrinsicNode(FILD, DL, Tys, FILDOps, SrcVT, PtrInfo, Alignment, MOLoad, precise(0), AAMDNodes {});
    Chain = Result.getValue(1);
    if useSSE {
        let mut MF: *mut MachineFunction = DAG.getMachineFunction();
        let mut SSFISize: u32 = DstVT.getStoreSize().operator unsigned long long();
        let mut SlotAlign: Align = DAG.getEVTAlign(DstVT);
        let mut SSFI: i32 = MF.getFrameInfo().CreateStackObject(SSFISize, SlotAlign, false, null, 0);
        let mut PtrVT: MVT = self.getPointerTy(MF.getDataLayout(), 0);
        let mut StackSlot: SDValue = DAG.getFrameIndex(SSFI, PtrVT, false);
        Tys = DAG.getVTList(Other);
        let mut FSTOps: [3]SDValue = [Chain, Result, StackSlot];
        let mut StoreMMO: *mut MachineMemOperand = DAG.getMachineFunction().getMachineMemOperand(getFixedStack(DAG.getMachineFunction(), SSFI, 0), MOStore, SSFISize, SlotAlign, MMOMetadata {}, System, NotAtomic, NotAtomic);
        Chain = DAG.getMemIntrinsicNode(FST, DL, Tys, FSTOps, DstVT, StoreMMO);
        Result = DAG.getLoad(DstVT, DL, Chain, StackSlot, getFixedStack(DAG.getMachineFunction(), SSFI, 0), SlotAlign, MONone, MMOMetadata {});
        Chain = Result.getValue(1);
    }
    return pair<SDValue, SDValue> { Result, Chain };
}

fn shouldUseHorizontalOp(IsSingleSource: bool, DAG: *SelectionDAG, Subtarget: *X86Subtarget) -> bool {
    let mut IsOptimizingSize: bool = DAG.shouldOptForSize();
    let mut HasFastHOps: bool = Subtarget.hasFastHorizontalOps();
    return !IsSingleSource || IsOptimizingSize || HasFastHOps;
}

fn LowerUINT_TO_FP_i64(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(!operator(Op).isStrictFPOpcode(), "Expected non-strict uint_to_fp!");
    let mut Context: *mut LLVMContext = DAG.getContext();
    let mut CV0: [4]u32 = [1127219200, 1160773632, 0, 0];
    let mut C0: *mut Constant = get(*Context, CV0);
    let mut PtrVT: MVT = DAG.getTargetLoweringInfo().getPointerTy(DAG.getDataLayout(), 0);
    let mut CPIdx0: SDValue = DAG.getConstantPool(C0, PtrVT, 16, 0, false, 0);
    let mut CV1: SmallVector<Constant *, 2> = SmallVector<Constant *, 2> {};
    CV1.push(get(*Context, APFloat { IEEEdouble(), APInt { 64, 4841369599423283200, false, false } }));
    CV1.push(get(*Context, APFloat { IEEEdouble(), APInt { 64, 4985484787499139072, false, false } }));
    let mut C1: *mut Constant = get(CV1);
    let mut CPIdx1: SDValue = DAG.getConstantPool(C1, PtrVT, 16, 0, false, 0);
    let mut XR1: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, v2i64, Op.getOperand(0));
    let mut CLod0: SDValue = DAG.getLoad(v4i32, dl, DAG.getEntryNode(), CPIdx0, getConstantPool(DAG.getMachineFunction()), 16, MONone, MMOMetadata {});
    let mut Unpck1: SDValue = getUnpackl(DAG, dl, v4i32, DAG.getBitcast(v4i32, XR1), CLod0);
    let mut CLod1: SDValue = DAG.getLoad(v2f64, dl, CLod0.getValue(1), CPIdx1, getConstantPool(DAG.getMachineFunction()), 16, MONone, MMOMetadata {});
    let mut XR2F: SDValue = DAG.getBitcast(v2f64, Unpck1);
    let mut Sub: SDValue = DAG.getNode(FSUB, dl, v2f64, XR2F, CLod1);
    let mut Result: SDValue = SDValue {};
    if Subtarget.hasSSE3() && shouldUseHorizontalOp(true, DAG, Subtarget) {
        Result = DAG.getNode(FHADD, dl, v2f64, Sub, Sub);
    } else {
        let mut Shuffle: SDValue = DAG.getVectorShuffle(v2f64, dl, Sub, Sub, [1, -1]);
        Result = DAG.getNode(FADD, dl, v2f64, Shuffle, Sub);
    }
    Result = DAG.getNode(EXTRACT_VECTOR_ELT, dl, f64, Result, DAG.getVectorIdxConstant(0, dl, false));
    return Result;
}

fn LowerUINT_TO_FP_i32(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut OpNo: u32 = if Op.getNode().isStrictFPOpcode() { 1 } else { 0 };
    let mut Bias: SDValue = DAG.getConstantFP(bit_cast(4841369599423283200), dl, f64, false);
    let mut Load: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, v4i32, Op.getOperand(OpNo));
    Load = getShuffleVectorZeroOrUndef(Load, 0, true, Subtarget, DAG);
    let mut Or: SDValue = DAG.getNode(OR, dl, v2i64, DAG.getBitcast(v2i64, Load), DAG.getBitcast(v2i64, DAG.getNode(SCALAR_TO_VECTOR, dl, v2f64, Bias)));
    Or = DAG.getNode(EXTRACT_VECTOR_ELT, dl, f64, DAG.getBitcast(v2f64, Or), DAG.getVectorIdxConstant(0, dl, false));
    if Op.getNode().isStrictFPOpcode() {
        let mut Chain: SDValue = Op.getOperand(0);
        let mut Sub: SDValue = DAG.getNode(STRICT_FSUB, dl, [f64, Other], [Chain, Or, Bias]);
        if Op.getValueType() == Sub.getValueType() {
            return Sub;
        }
        let mut ResultPair: pair<SDValue, SDValue> = DAG.getStrictFPExtendOrRound(Sub, Sub.getValue(1), dl, Op.getSimpleValueType());
        return DAG.getMergeValues([ResultPair.first, ResultPair.second], dl);
    }
    let mut Sub: SDValue = DAG.getNode(FSUB, dl, f64, Or, Bias);
    return DAG.getFPExtendOrRound(Sub, dl, Op.getSimpleValueType());
}

fn lowerUINT_TO_FP_v2i32(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if Op.getSimpleValueType() != v2f64 {
        return SDValue {};
    }
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut N0: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    assert!(N0.getSimpleValueType() == v2i32, "Unexpected input type");
    if Subtarget.hasAVX512() {
        if !Subtarget.hasVLX() {
            if !IsStrict {
                return SDValue {};
            }
            N0 = DAG.getNode(CONCAT_VECTORS, DL, v4i32, N0, DAG.getConstant(0, DL, v2i32, false, false));
            let mut Res: SDValue = DAG.getNode(operator(Op).getOpcode(), DL, [v4f64, Other], [Op.getOperand(0), N0]);
            let mut Chain: SDValue = Res.getValue(1);
            Res = DAG.getNode(EXTRACT_SUBVECTOR, DL, v2f64, Res, DAG.getVectorIdxConstant(0, DL, false));
            return DAG.getMergeValues([Res, Chain], DL);
        }
        N0 = DAG.getNode(CONCAT_VECTORS, DL, v4i32, N0, DAG.getUNDEF(v2i32));
        if IsStrict {
            return DAG.getNode(STRICT_CVTUI2P, DL, [v2f64, Other], [Op.getOperand(0), N0]);
        }
        return DAG.getNode(CVTUI2P, DL, v2f64, N0);
    }
    let mut ZExtIn: SDValue = DAG.getNode(ZERO_EXTEND, DL, v2i64, N0);
    let mut VBias: SDValue = DAG.getConstantFP(bit_cast(4841369599423283200), DL, v2f64, false);
    let mut Or: SDValue = DAG.getNode(OR, DL, v2i64, ZExtIn, DAG.getBitcast(v2i64, VBias));
    Or = DAG.getBitcast(v2f64, Or);
    if IsStrict {
        return DAG.getNode(STRICT_FSUB, DL, [v2f64, Other], [Op.getOperand(0), Or, VBias]);
    }
    return DAG.getNode(FSUB, DL, v2f64, Or, VBias);
}

fn lowerUINT_TO_FP_vXi32(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut V: SDValue = operator(Op).getOperand(if IsStrict { 1 } else { 0 });
    let mut VecIntVT: MVT = V.getSimpleValueType();
    assert!((VecIntVT == v4i32 || VecIntVT == v8i32), "Unsupported custom type");
    if Subtarget.hasAVX512() {
        assert!(!Subtarget.hasVLX(), "Unexpected features");
        let mut VT: MVT = operator(Op).getSimpleValueType(0);
        if VT == v8f64 {
            return Op;
        }
        assert!((VT == v4f32 || VT == v8f32 || VT == v4f64 || VT == v8f16), "Unexpected VT!");
        let mut WideVT: MVT = if VT == v8f16 { v16f16 } else { v16f32 };
        let mut WideIntVT: MVT = v16i32;
        if VT == v4f64 {
            WideVT = v8f64;
            WideIntVT = v8i32;
        }
        let mut Tmp: SDValue = if IsStrict { DAG.getConstant(0, DL, WideIntVT, false, false) } else { DAG.getUNDEF(WideIntVT) };
        V = DAG.getNode(INSERT_SUBVECTOR, DL, WideIntVT, Tmp, V, DAG.getVectorIdxConstant(0, DL, false));
        let mut Res: SDValue = SDValue {};
        let mut Chain: SDValue = SDValue {};
        if IsStrict {
            Res = DAG.getNode(STRICT_UINT_TO_FP, DL, [WideVT, Other], [operator(Op).getOperand(0), V]);
            Chain = Res.getValue(1);
        } else {
            Res = DAG.getNode(UINT_TO_FP, DL, WideVT, V);
        }
        Res = DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Res, DAG.getVectorIdxConstant(0, DL, false));
        if IsStrict {
            return DAG.getMergeValues([Res, Chain], DL);
        }
        return Res;
    }
    if Subtarget.hasAVX() && VecIntVT == v4i32 && operator(Op).getSimpleValueType(0) == v4f64 {
        let mut ZExtIn: SDValue = DAG.getNode(ZERO_EXTEND, DL, v4i64, V);
        let mut Bias: *mut Constant = get(*DAG.getContext(), APFloat { IEEEdouble(), APInt { 64, 4841369599423283200, false, false } });
        let mut PtrVT: MVT = DAG.getTargetLoweringInfo().getPointerTy(DAG.getDataLayout(), 0);
        let mut CPIdx: SDValue = DAG.getConstantPool(Bias, PtrVT, 8, 0, false, 0);
        let mut Tys: SDVTList = DAG.getVTList(v4f64, Other);
        let mut Ops: [2]SDValue = [DAG.getEntryNode(), CPIdx];
        let mut VBias: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, DL, Tys, Ops, f64, getConstantPool(DAG.getMachineFunction()), 8, MOLoad, precise(0), AAMDNodes {});
        let mut Or: SDValue = DAG.getNode(OR, DL, v4i64, ZExtIn, DAG.getBitcast(v4i64, VBias));
        Or = DAG.getBitcast(v4f64, Or);
        if IsStrict {
            return DAG.getNode(STRICT_FSUB, DL, [v4f64, Other], [Op.getOperand(0), Or, VBias]);
        }
        return DAG.getNode(FSUB, DL, v4f64, Or, VBias);
    }
    let mut Is128: bool = VecIntVT == v4i32;
    let mut VecFloatVT: MVT = if Is128 { v4f32 } else { v8f32 };
    if VecFloatVT != operator(Op).getSimpleValueType(0) {
        return SDValue {};
    }
    let mut VecCstLow: SDValue = DAG.getConstant(1258291200, DL, VecIntVT, false, false);
    let mut VecCstHigh: SDValue = DAG.getConstant(1392508928, DL, VecIntVT, false, false);
    let mut VecCstShift: SDValue = DAG.getConstant(16, DL, VecIntVT, false, false);
    let mut HighShift: SDValue = DAG.getNode(SRL, DL, VecIntVT, V, VecCstShift);
    let mut Low: SDValue = SDValue {};
    let mut High: SDValue = SDValue {};
    if Subtarget.hasSSE41() {
        let mut VecI16VT: MVT = if Is128 { v8i16 } else { v16i16 };
        let mut VecCstLowBitcast: SDValue = DAG.getBitcast(VecI16VT, VecCstLow);
        let mut VecBitcast: SDValue = DAG.getBitcast(VecI16VT, V);
        Low = DAG.getNode(BLENDI, DL, VecI16VT, VecBitcast, VecCstLowBitcast, DAG.getTargetConstant(170, DL, i8, false));
        let mut VecCstHighBitcast: SDValue = DAG.getBitcast(VecI16VT, VecCstHigh);
        let mut VecShiftBitcast: SDValue = DAG.getBitcast(VecI16VT, HighShift);
        High = DAG.getNode(BLENDI, DL, VecI16VT, VecShiftBitcast, VecCstHighBitcast, DAG.getTargetConstant(170, DL, i8, false));
    } else {
        let mut VecCstMask: SDValue = DAG.getConstant(65535, DL, VecIntVT, false, false);
        let mut LowAnd: SDValue = DAG.getNode(AND, DL, VecIntVT, V, VecCstMask);
        Low = DAG.getNode(OR, DL, VecIntVT, LowAnd, VecCstLow);
        High = DAG.getNode(OR, DL, VecIntVT, HighShift, VecCstHigh);
    }
    let mut VecCstFSub: SDValue = DAG.getConstantFP(APFloat { IEEEsingle(), APInt { 32, 1392509056, false, false } }, DL, VecFloatVT, false);
    let mut HighBitcast: SDValue = DAG.getBitcast(VecFloatVT, High);
    let mut LowBitcast: SDValue = DAG.getBitcast(VecFloatVT, Low);
    if IsStrict {
        let mut FHigh: SDValue = DAG.getNode(STRICT_FSUB, DL, [VecFloatVT, Other], [Op.getOperand(0), HighBitcast, VecCstFSub]);
        return DAG.getNode(STRICT_FADD, DL, [VecFloatVT, Other], [FHigh.getValue(1), LowBitcast, FHigh]);
    }
    let mut FHigh: SDValue = DAG.getNode(FSUB, DL, VecFloatVT, HighBitcast, VecCstFSub);
    return DAG.getNode(FADD, DL, VecFloatVT, LowBitcast, FHigh);
}

fn lowerUINT_TO_FP_vec(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut OpNo: u32 = if Op.getNode().isStrictFPOpcode() { 1 } else { 0 };
    let mut N0: SDValue = Op.getOperand(OpNo);
    let mut SrcVT: MVT = N0.getSimpleValueType();
    match SrcVT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Custom UINT_TO_FP is not supported!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 21124);
        },
        v2i32 => {
            return lowerUINT_TO_FP_v2i32(Op, dl, DAG, Subtarget);
        },
        v4i32 => {
            v8i32;
        },
        v2i64 => {
            v4i64;
        },
    }
}

fn X86TargetLowering::LowerUINT_TO_FP(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut OpNo: u32 = if IsStrict { 1 } else { 0 };
    let mut Src: SDValue = Op.getOperand(OpNo);
    let mut Chain: SDValue = if IsStrict { Op.getOperand(0) } else { DAG.getEntryNode() };
    let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut DstVT: MVT = operator(Op).getSimpleValueType(0);
    let mut dl: SDLoc = Op;
    if isBF16orSoftF16(DstVT, self.Subtarget) {
        return promoteXINT_TO_FP(Op, dl, DAG);
    } else if isLegalConversion(SrcVT, DstVT, false, self.Subtarget) {
        return Op;
    }
    if self.Subtarget.isTargetWin64() && SrcVT == i128 {
        return self.LowerWin64_INT128_TO_FP(Op, DAG);
    }
    if vectorizeExtractedCast(Op, dl, DAG, self.Subtarget) {
        Extract;
    } else {
        return Extract;
    }
    if lowerFPToIntToFP(Op, dl, DAG, self.Subtarget) {
        V;
    } else {
        return V;
    }
    if DstVT.isVector() {
        return lowerUINT_TO_FP_vec(Op, dl, DAG, self.Subtarget);
    }
    if DstVT == f128 {
        return SDValue {};
    }
    if self.Subtarget.hasAVX512() && self.isScalarFPTypeInSSEReg(DstVT) && (SrcVT == i32 || (SrcVT == i64 && self.Subtarget.is64Bit())) {
        return Op;
    }
    if SrcVT == i32 && self.Subtarget.is64Bit() {
        Src = DAG.getNode(ZERO_EXTEND, dl, i64, Src);
        if IsStrict {
            return DAG.getNode(STRICT_SINT_TO_FP, dl, [DstVT, Other], [Chain, Src]);
        }
        return DAG.getNode(SINT_TO_FP, dl, DstVT, Src);
    }
    if LowerI64IntToFP_AVX512DQ(Op, dl, DAG, self.Subtarget) {
        V;
    } else {
        return V;
    }
    if LowerI64IntToFP16(Op, dl, DAG, self.Subtarget) {
        V;
    } else {
        return V;
    }
    if SrcVT == i64 && DstVT == f64 && self.Subtarget.hasSSE2() && !IsStrict {
        return LowerUINT_TO_FP_i64(Op, dl, DAG, self.Subtarget);
    }
    if SrcVT == i32 && self.Subtarget.hasSSE2() && DstVT != f80 && !IsStrict {
        return LowerUINT_TO_FP_i32(Op, dl, DAG, self.Subtarget);
    }
    if self.Subtarget.is64Bit() && SrcVT == i64 && (DstVT == f32 || DstVT == f64) {
        return SDValue {};
    }
    let mut StackSlot: SDValue = DAG.CreateStackTemporary(i64, 8);
    let mut SSFI: i32 = cast(StackSlot).getIndex();
    let mut SlotAlign: Align = 8;
    let mut MPI: MachinePointerInfo = getFixedStack(DAG.getMachineFunction(), SSFI, 0);
    if SrcVT == i32 {
        let mut OffsetSlot: SDValue = DAG.getMemBasePlusOffset(StackSlot, getFixed(4), dl, SDNodeFlags { Flags: None });
        let mut Store1: SDValue = DAG.getStore(Chain, dl, Src, StackSlot, MPI, SlotAlign, MONone, MMOMetadata {});
        let mut Store2: SDValue = DAG.getStore(Store1, dl, DAG.getConstant(0, dl, i32, false, false), OffsetSlot, MPI.getWithOffset(4), SlotAlign, MONone, MMOMetadata {});
        let mut Tmp: pair<SDValue, SDValue> = self.BuildFILD(DstVT, i64, dl, Store2, StackSlot, MPI, SlotAlign, DAG);
        if IsStrict {
            return DAG.getMergeValues([Tmp.first, Tmp.second], dl);
        }
        return Tmp.first;
    }
    assert!(SrcVT == i64, "Unexpected type in UINT_TO_FP");
    let mut ValueToStore: SDValue = Src;
    if self.isScalarFPTypeInSSEReg(Op.getValueType()) && !self.Subtarget.is64Bit() {
        ValueToStore = DAG.getBitcast(f64, ValueToStore);
    }
    let mut Store: SDValue = DAG.getStore(Chain, dl, ValueToStore, StackSlot, MPI, SlotAlign, MONone, MMOMetadata {});
    let mut Tys: SDVTList = DAG.getVTList(f80, Other);
    let mut Ops: [2]SDValue = [Store, StackSlot];
    let mut Fild: SDValue = DAG.getMemIntrinsicNode(FILD, dl, Tys, Ops, i64, MPI, SlotAlign, MOLoad, precise(0), AAMDNodes {});
    Chain = Fild.getValue(1);
    let mut SignSet: SDValue = DAG.getSetCC(dl, self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), i64), Op.getOperand(OpNo), DAG.getConstant(0, dl, i64, false, false), SETLT, SDValue {}, false, None);
    let mut FF: APInt = APInt { 64, 6881500230622117888, false, false };
    let mut FudgePtr: SDValue = DAG.getConstantPool(get(*DAG.getContext(), FF), PtrVT, nullopt, 0, false, 0);
    let mut CPAlignment: Align = cast(FudgePtr).getAlign();
    let mut Zero: SDValue = DAG.getIntPtrConstant(0, dl, false);
    let mut Four: SDValue = DAG.getIntPtrConstant(4, dl, false);
    let mut Offset: SDValue = DAG.getSelect(dl, Zero.getValueType(), SignSet, Four, Zero, SDNodeFlags { Flags: None });
    FudgePtr = DAG.getNode(ADD, dl, PtrVT, FudgePtr, Offset);
    let mut Fudge: SDValue = DAG.getExtLoad(EXTLOAD, dl, f80, Chain, FudgePtr, getConstantPool(DAG.getMachineFunction()), f32, CPAlignment, MONone, MMOMetadata {});
    Chain = Fudge.getValue(1);
    if IsStrict {
        let mut Opc: u32 = STRICT_FADD;
        if self.Subtarget.isOSWindows() && DstVT == f32 {
            Opc = STRICT_FP80_ADD;
        }
        let mut Add: SDValue = DAG.getNode(Opc, dl, [f80, Other], [Chain, Fild, Fudge]);
        if DstVT == f80 {
            return Add;
        }
        return DAG.getNode(STRICT_FP_ROUND, dl, [DstVT, Other], [Add.getValue(1), Add, DAG.getIntPtrConstant(0, dl, true)]);
    }
    let mut Opc: u32 = FADD;
    if self.Subtarget.isOSWindows() && DstVT == f32 {
        Opc = FP80_ADD;
    }
    let mut Add: SDValue = DAG.getNode(Opc, dl, f80, Fild, Fudge);
    return DAG.getNode(FP_ROUND, dl, DstVT, Add, DAG.getIntPtrConstant(0, dl, true));
}

fn X86TargetLowering::FP_TO_INTHelper(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, IsSigned: bool, Chain: *mut SDValue) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut DL: SDLoc = Op;
    let mut DstTy: EVT = Op.getValueType();
    let mut Value: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut TheVT: EVT = Value.getValueType();
    let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
    if TheVT != f32 && TheVT != f64 && TheVT != f80 {
        return SDValue {};
    }
    let mut UnsignedFixup: bool = !IsSigned && DstTy == i64;
    if !IsSigned && DstTy != i64 {
        assert!(DstTy == i32, "Unexpected FP_TO_UINT");
        DstTy = i64;
    }
    assert!(DstTy.getSimpleVT() <= i64 && DstTy.getSimpleVT() >= i16, "Unknown FP_TO_INT to lower!");
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut MemSize: u32 = DstTy.getStoreSize().operator unsigned long long();
    let mut SSFI: i32 = MF.getFrameInfo().CreateStackObject(MemSize, MemSize, false, null, 0);
    let mut StackSlot: SDValue = DAG.getFrameIndex(SSFI, PtrVT, false);
    Chain = if IsStrict { Op.getOperand(0) } else { DAG.getEntryNode() };
    let mut Adjust: SDValue = SDValue {};
    if UnsignedFixup {
        let mut Thresh: APFloat = APFloat { IEEEsingle(), APInt { 32, 1593835520, false, false } };
        let mut Status: opStatus = opOK;
        let mut LosesInfo: bool = false;
        if TheVT == f64 {
            Status = Thresh.convert(IEEEdouble(), rmNearestTiesToEven, &mut LosesInfo);
        } else if TheVT == f80 {
            Status = Thresh.convert(x87DoubleExtended(), rmNearestTiesToEven, &mut LosesInfo);
        }
        assert!(Status == opOK && !LosesInfo, "FP conversion should have been exact");
        let mut ThreshVal: SDValue = DAG.getConstantFP(Thresh, DL, TheVT, false);
        let mut ResVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), TheVT);
        let mut Cmp: SDValue = SDValue {};
        if IsStrict {
            Cmp = DAG.getSetCC(DL, ResVT, Value, ThreshVal, SETGE, Chain, true, None);
            Chain = Cmp.getValue(1);
        } else {
            Cmp = DAG.getSetCC(DL, ResVT, Value, ThreshVal, SETGE, SDValue {}, false, None);
        }
        let mut Zext: SDValue = DAG.getNode(ZERO_EXTEND, DL, i64, Cmp);
        let mut Const63: SDValue = DAG.getConstant(63, DL, i8, false, false);
        Adjust = DAG.getNode(SHL, DL, i64, Zext, Const63);
        let mut FltOfs: SDValue = DAG.getSelect(DL, TheVT, Cmp, ThreshVal, DAG.getConstantFP(0.0, DL, TheVT, false), SDNodeFlags { Flags: None });
        if IsStrict {
            Value = DAG.getNode(STRICT_FSUB, DL, [TheVT, Other], [Chain, Value, FltOfs]);
            Chain = Value.getValue(1);
        } else {
            Value = DAG.getNode(FSUB, DL, TheVT, Value, FltOfs);
        }
    }
    let mut MPI: MachinePointerInfo = getFixedStack(MF, SSFI, 0);
    if self.isScalarFPTypeInSSEReg(TheVT) {
        assert!(DstTy == i64, "Invalid FP_TO_SINT to lower!");
        Chain = DAG.getStore(Chain, DL, Value, StackSlot, MPI, MaybeAlign {}, MONone, MMOMetadata {});
        let mut Tys: SDVTList = DAG.getVTList(f80, Other);
        let mut Ops: [2]SDValue = [Chain, StackSlot];
        let mut FLDSize: u32 = TheVT.getStoreSize().operator unsigned long long();
        assert!(FLDSize <= MemSize, "Stack slot not big enough");
        let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(MPI, MOLoad, FLDSize, FLDSize, MMOMetadata {}, System, NotAtomic, NotAtomic);
        Value = DAG.getMemIntrinsicNode(FLD, DL, Tys, Ops, TheVT, MMO);
        Chain = Value.getValue(1);
    }
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(MPI, MOStore, MemSize, MemSize, MMOMetadata {}, System, NotAtomic, NotAtomic);
    let mut Ops: [3]SDValue = [Chain, Value, StackSlot];
    let mut FIST: SDValue = DAG.getMemIntrinsicNode(FP_TO_INT_IN_MEM, DL, DAG.getVTList(Other), Ops, DstTy, MMO);
    let mut Res: SDValue = DAG.getLoad(Op.getValueType(), DL, FIST, StackSlot, MPI, MaybeAlign {}, MONone, MMOMetadata {});
    Chain = Res.getValue(1);
    if UnsignedFixup {
        Res = DAG.getNode(XOR, DL, i64, Res, Adjust);
    }
    return Res;
}

fn LowerAVXExtend(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut In: SDValue = Op.getOperand(0);
    let mut InVT: MVT = In.getSimpleValueType();
    let mut Opc: u32 = Op.getOpcode();
    assert!(VT.isVector() && InVT.isVector(), "Expected vector type");
    assert!((Opc == ANY_EXTEND || Opc == ZERO_EXTEND), "Unexpected extension opcode");
    assert!(VT.getVectorNumElements() == InVT.getVectorNumElements(), "Expected same number of elements");
    assert!((VT.getVectorElementType() == i16 || VT.getVectorElementType() == i32 || VT.getVectorElementType() == i64), "Unexpected element type");
    assert!((InVT.getVectorElementType() == i8 || InVT.getVectorElementType() == i16 || InVT.getVectorElementType() == i32), "Unexpected element type");
    let mut ExtendInVecOpc: u32 = DAG.getOpcode_EXTEND_VECTOR_INREG(Opc);
    if VT == v32i16 && !Subtarget.hasBWI() {
        assert!(InVT == v32i8, "Unexpected VT!");
        return splitVectorIntUnary(Op, DAG, dl);
    }
    if Subtarget.hasInt256() {
        return Op;
    }
    let mut HalfVT: MVT = VT.getHalfNumVectorElementsVT();
    let mut OpLo: SDValue = DAG.getNode(ExtendInVecOpc, dl, HalfVT, In);
    if dyn_cast(In) {
        Shuf;
    } else if hasIdenticalHalvesShuffleMask(Shuf.getMask()) {
        return DAG.getNode(CONCAT_VECTORS, dl, VT, OpLo, OpLo);
    }
    let mut ZeroVec: SDValue = DAG.getConstant(0, dl, InVT, false, false);
    let mut Undef: SDValue = DAG.getUNDEF(InVT);
    let mut NeedZero: bool = Opc == ZERO_EXTEND;
    let mut OpHi: SDValue = getUnpackh(DAG, dl, InVT, In, if NeedZero { ZeroVec } else { Undef });
    OpHi = DAG.getBitcast(HalfVT, OpHi);
    return DAG.getNode(CONCAT_VECTORS, dl, VT, OpLo, OpHi);
}

fn SplitAndExtendv16i1(ExtOpc: u32, VT: MVT, In: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!((VT == v16i8 || VT == v16i16), "Unexpected VT.");
    let mut Lo: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, dl, v8i1, In, DAG.getVectorIdxConstant(0, dl, false));
    let mut Hi: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, dl, v8i1, In, DAG.getVectorIdxConstant(8, dl, false));
    Lo = DAG.getNode(ExtOpc, dl, v8i16, Lo);
    Hi = DAG.getNode(ExtOpc, dl, v8i16, Hi);
    let mut Res: SDValue = DAG.getNode(CONCAT_VECTORS, dl, v16i16, Lo, Hi);
    return DAG.getNode(TRUNCATE, dl, VT, Res);
}

fn LowerZERO_EXTEND_Mask(Op: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = operator(Op).getSimpleValueType(0);
    let mut In: SDValue = operator(Op).getOperand(0);
    let mut InVT: MVT = In.getSimpleValueType();
    assert!(InVT.getVectorElementType() == i1, "Unexpected input type!");
    let mut NumElts: u32 = VT.getVectorNumElements();
    if VT.getVectorElementType() != i8 {
        let mut Extend: SDValue = DAG.getNode(SIGN_EXTEND, DL, VT, In);
        return DAG.getNode(SRL, DL, VT, Extend, DAG.getConstant(VT.getScalarSizeInBits() - 1, DL, VT, false, false));
    }
    let mut ExtVT: MVT = VT;
    if !Subtarget.hasBWI() {
        if NumElts == 16 && !Subtarget.canExtendTo512DQ() {
            return SplitAndExtendv16i1(ZERO_EXTEND, VT, In, DL, DAG);
        }
        ExtVT = getVectorVT(i32, NumElts);
    }
    let mut WideVT: MVT = ExtVT;
    if !ExtVT.is512BitVector() && !Subtarget.hasVLX() {
        NumElts *= 512 / ExtVT.getSizeInBits().operator unsigned long long();
        InVT = getVectorVT(i1, NumElts);
        In = DAG.getNode(INSERT_SUBVECTOR, DL, InVT, DAG.getUNDEF(InVT), In, DAG.getVectorIdxConstant(0, DL, false));
        WideVT = getVectorVT(ExtVT.getVectorElementType(), NumElts);
    }
    let mut One: SDValue = DAG.getConstant(1, DL, WideVT, false, false);
    let mut Zero: SDValue = DAG.getConstant(0, DL, WideVT, false, false);
    let mut SelectedVal: SDValue = DAG.getSelect(DL, WideVT, In, One, Zero, SDNodeFlags { Flags: None });
    if VT != ExtVT {
        WideVT = getVectorVT(i8, NumElts);
        SelectedVal = DAG.getNode(TRUNCATE, DL, WideVT, SelectedVal);
    }
    if WideVT != VT {
        SelectedVal = DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, SelectedVal, DAG.getVectorIdxConstant(0, DL, false));
    }
    return SelectedVal;
}

fn LowerZERO_EXTEND(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut In: SDValue = Op.getOperand(0);
    let mut SVT: MVT = In.getSimpleValueType();
    let mut DL: SDLoc = Op;
    if SVT.getVectorElementType() == i1 {
        return LowerZERO_EXTEND_Mask(Op, DL, Subtarget, DAG);
    }
    assert!(Subtarget.hasAVX(), "Expected AVX support");
    return LowerAVXExtend(Op, DL, DAG, Subtarget);
}

fn truncateVectorWithPACK(Opcode: u32, DstVT: EVT, In: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!((Opcode == PACKSS || Opcode == PACKUS), "Unexpected PACK opcode");
    assert!(DstVT.isVector(), "VT not a vector?");
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut SrcVT: EVT = In.getValueType();
    if SrcVT == DstVT {
        return In;
    }
    let mut NumElems: u32 = SrcVT.getVectorNumElements();
    if NumElems < 2 || !isPowerOf2_32(NumElems) {
        return SDValue {};
    }
    let mut DstSizeInBits: u32 = DstVT.getSizeInBits().operator unsigned long long();
    let mut SrcSizeInBits: u32 = SrcVT.getSizeInBits().operator unsigned long long();
    assert!(DstVT.getVectorNumElements() == NumElems, "Illegal truncation");
    assert!(SrcSizeInBits > DstSizeInBits, "Illegal truncation");
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    let mut PackedSVT: EVT = getIntegerVT(Ctx, SrcVT.getScalarSizeInBits() / 2);
    let mut PackedVT: EVT = getVectorVT(Ctx, PackedSVT, NumElems, false);
    let mut InVT: EVT = i16;
    let mut OutVT: EVT = i8;
    if SrcVT.getScalarSizeInBits() > 16 && (Opcode == PACKSS || Subtarget.hasSSE41()) {
        InVT = i32;
        OutVT = i16;
    }
    if SrcSizeInBits <= 128 {
        InVT = getVectorVT(Ctx, InVT, 128 / InVT.getSizeInBits().operator unsigned long long(), false);
        OutVT = getVectorVT(Ctx, OutVT, 128 / OutVT.getSizeInBits().operator unsigned long long(), false);
        In = widenSubVector(In, false, Subtarget, DAG, DL, 128);
        let mut LHS: SDValue = DAG.getBitcast(InVT, In);
        let mut RHS: SDValue = if Subtarget.hasAVX512() { DAG.getUNDEF(InVT) } else { LHS };
        let mut Res: SDValue = DAG.getNode(Opcode, DL, OutVT, LHS, RHS);
        Res = extractSubVector(Res, 0, DAG, DL, SrcSizeInBits / 2);
        Res = DAG.getBitcast(PackedVT, Res);
        return truncateVectorWithPACK(Opcode, DstVT, Res, DL, DAG, Subtarget);
    }
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    tie(Lo, Hi) = splitVector(In, DAG, DL);
    if Hi.isUndef() {
        let mut DstHalfVT: EVT = DstVT.getHalfNumVectorElementsVT(Ctx);
        if truncateVectorWithPACK(Opcode, DstHalfVT, Lo, DL, DAG, Subtarget) {
            Res;
        } else {
            return widenSubVector(Res, false, Subtarget, DAG, DL, DstSizeInBits);
        }
    }
    let mut SubSizeInBits: u32 = SrcSizeInBits / 2;
    InVT = getVectorVT(Ctx, InVT, SubSizeInBits / InVT.getSizeInBits().operator unsigned long long(), false);
    OutVT = getVectorVT(Ctx, OutVT, SubSizeInBits / OutVT.getSizeInBits().operator unsigned long long(), false);
    if SrcVT.is256BitVector() && DstVT.is128BitVector() {
        Lo = DAG.getBitcast(InVT, Lo);
        Hi = DAG.getBitcast(InVT, Hi);
        let mut Res: SDValue = DAG.getNode(Opcode, DL, OutVT, Lo, Hi);
        return DAG.getBitcast(DstVT, Res);
    }
    if SrcVT.is512BitVector() && Subtarget.hasInt256() {
        Lo = DAG.getBitcast(InVT, Lo);
        Hi = DAG.getBitcast(InVT, Hi);
        let mut Res: SDValue = DAG.getNode(Opcode, DL, OutVT, Lo, Hi);
        let mut Mask: SmallVector<int, 64> = SmallVector<int, 64> {};
        let mut Scale: i32 = 64 / OutVT.getScalarSizeInBits();
        narrowShuffleMaskElts(Scale, [0, 2, 1, 3], Mask);
        Res = DAG.getVectorShuffle(OutVT, DL, Res, Res, Mask);
        if DstVT.is256BitVector() {
            return DAG.getBitcast(DstVT, Res);
        }
        Res = DAG.getBitcast(PackedVT, Res);
        return truncateVectorWithPACK(Opcode, DstVT, Res, DL, DAG, Subtarget);
    }
    assert!(SrcSizeInBits >= 256, "Expected 256-bit vector or greater");
    if PackedVT.is128BitVector() {
        let mut Res: SDValue = truncateVectorWithPACK(Opcode, PackedVT, In, DL, DAG, Subtarget);
        return truncateVectorWithPACK(Opcode, DstVT, Res, DL, DAG, Subtarget);
    }
    let mut HalfPackedVT: EVT = getVectorVT(Ctx, PackedSVT, NumElems / 2, false);
    Lo = truncateVectorWithPACK(Opcode, HalfPackedVT, Lo, DL, DAG, Subtarget);
    Hi = truncateVectorWithPACK(Opcode, HalfPackedVT, Hi, DL, DAG, Subtarget);
    let mut Res: SDValue = DAG.getNode(CONCAT_VECTORS, DL, PackedVT, Lo, Hi);
    return truncateVectorWithPACK(Opcode, DstVT, Res, DL, DAG, Subtarget);
}

fn truncateVectorWithPACKUS(DstVT: EVT, In: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    In = DAG.getZeroExtendInReg(In, DL, DstVT);
    return truncateVectorWithPACK(PACKUS, DstVT, In, DL, DAG, Subtarget);
}

fn truncateVectorWithPACKSS(DstVT: EVT, In: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut SrcVT: EVT = In.getValueType();
    In = DAG.getNode(SIGN_EXTEND_INREG, DL, SrcVT, In, DAG.getValueType(DstVT));
    return truncateVectorWithPACK(PACKSS, DstVT, In, DL, DAG, Subtarget);
}

fn matchTruncateWithPACK(PackOpcode: *mut u32, DstVT: EVT, In: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, Flags: SDNodeFlags) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut SrcVT: EVT = In.getValueType();
    let mut DstSVT: EVT = DstVT.getVectorElementType();
    let mut SrcSVT: EVT = SrcVT.getVectorElementType();
    let mut NumDstEltBits: u32 = DstSVT.getSizeInBits().operator unsigned long long();
    let mut NumSrcEltBits: u32 = SrcSVT.getSizeInBits().operator unsigned long long();
    if !((SrcSVT == i16 || SrcSVT == i32 || SrcSVT == i64) && (DstSVT == i8 || DstSVT == i16 || DstSVT == i32)) {
        return SDValue {};
    }
    assert!(NumSrcEltBits > NumDstEltBits, "Bad truncation");
    let mut NumStages: u32 = Log2_32(NumSrcEltBits / NumDstEltBits);
    if (DstSVT == i32 && SrcVT.getSizeInBits().operator unsigned long long() <= 128) || (DstSVT == i16 && SrcVT.getSizeInBits().operator unsigned long long() <= (64 * NumStages)) || (DstVT == v2i8 && SrcVT == v2i64 && Subtarget.hasSSSE3()) {
        return SDValue {};
    }
    if SrcVT == v4i64 && DstVT == v4i32 && !isFreeToSplitVector(In, DAG) && (!Subtarget.hasAVX() || DAG.ComputeNumSignBits(In, 0) != 64) {
        return SDValue {};
    }
    if Subtarget.hasAVX512() && NumStages > 1 {
        return SDValue {};
    }
    let mut NumPackedSignBits: u32 = if NumDstEltBits < 16 { NumDstEltBits } else { 16 };
    let mut NumPackedZeroBits: u32 = if Subtarget.hasSSE41() { NumPackedSignBits } else { 8 };
    let mut Known: KnownBits = DAG.computeKnownBits(In, 0);
    if (Flags.hasNoUnsignedWrap() && NumDstEltBits <= NumPackedZeroBits) || (NumSrcEltBits - NumPackedZeroBits) <= Known.countMinLeadingZeros() {
        PackOpcode = PACKUS;
        return In;
    }
    let mut NumSignBits: u32 = DAG.ComputeNumSignBits(In, 0);
    if DstSVT == i32 && NumSignBits != NumSrcEltBits && !Subtarget.hasAVX512() {
        return SDValue {};
    }
    let mut MinSignBits: u32 = NumSrcEltBits - NumPackedSignBits;
    if (Flags.hasNoSignedWrap() && DstSVT != i32) || MinSignBits < NumSignBits {
        PackOpcode = PACKSS;
        return In;
    }
    if In.getOpcode() == SRL && operator(In).hasOneUse() {
        if DAG.getValidShiftAmount(In, 0) {
            ShAmt;
        } else {
            if operator(ShAmt) == MinSignBits {
                PackOpcode = PACKSS;
                return DAG.getNode(SRA, DL, SrcVT, operator(In).ops());
            }
        }
    }
    return SDValue {};
}

fn LowerTruncateVecPackWithSignBits(DstVT: MVT, In: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, Flags: SDNodeFlags) -> SDValue {
    let mut SrcVT: MVT = In.getSimpleValueType();
    let mut DstSVT: MVT = DstVT.getVectorElementType();
    let mut SrcSVT: MVT = SrcVT.getVectorElementType();
    if !((SrcSVT == i16 || SrcSVT == i32 || SrcSVT == i64) && (DstSVT == i8 || DstSVT == i16 || DstSVT == i32)) {
        return SDValue {};
    }
    if DstVT.getSizeInBits().operator unsigned long long() >= 128 {
        if isUpperSubvectorUndef(In, DL, DAG) {
            Lo;
        } else {
            let mut DstHalfVT: MVT = DstVT.getHalfNumVectorElementsVT();
            if LowerTruncateVecPackWithSignBits(DstHalfVT, Lo, DL, Subtarget, DAG, SDNodeFlags { Flags: None }) {
                Res;
            } else {
                return widenSubVector(Res, false, Subtarget, DAG, DL, DstVT.getSizeInBits().operator unsigned long long());
            }
        }
    }
    let mut PackOpcode: u32 = 0;
    if matchTruncateWithPACK(PackOpcode, DstVT, In, DL, DAG, Subtarget, Flags) {
        Src;
    } else {
        return truncateVectorWithPACK(PackOpcode, DstVT, Src, DL, DAG, Subtarget);
    }
    return SDValue {};
}

fn LowerTruncateVecPack(DstVT: MVT, In: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut SrcVT: MVT = In.getSimpleValueType();
    let mut DstSVT: MVT = DstVT.getVectorElementType();
    let mut SrcSVT: MVT = SrcVT.getVectorElementType();
    let mut NumElems: u32 = DstVT.getVectorNumElements();
    if !((SrcSVT == i16 || SrcSVT == i32 || SrcSVT == i64) && (DstSVT == i8 || DstSVT == i16) && isPowerOf2_32(NumElems) && NumElems >= 8) {
        return SDValue {};
    }
    if Subtarget.hasSSSE3() && NumElems == 8 {
        if SrcSVT == i16 {
            return SDValue {};
        }
        if SrcSVT == i32 && (DstSVT == i8 || !Subtarget.hasSSE41()) {
            return SDValue {};
        }
    }
    if DstVT.getSizeInBits().operator unsigned long long() >= 128 {
        if isUpperSubvectorUndef(In, DL, DAG) {
            Lo;
        } else {
            let mut DstHalfVT: MVT = DstVT.getHalfNumVectorElementsVT();
            if LowerTruncateVecPack(DstHalfVT, Lo, DL, Subtarget, DAG) {
                Res;
            } else {
                return widenSubVector(Res, false, Subtarget, DAG, DL, DstVT.getSizeInBits().operator unsigned long long());
            }
        }
    }
    if Subtarget.hasSSE41() || DstSVT == i8 {
        return truncateVectorWithPACKUS(DstVT, In, DL, Subtarget, DAG);
    }
    if SrcSVT == i16 || SrcSVT == i32 {
        return truncateVectorWithPACKSS(DstVT, In, DL, Subtarget, DAG);
    }
    if DstSVT == i16 && SrcSVT == i64 {
        let mut TruncVT: MVT = getVectorVT(i32, NumElems);
        let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, TruncVT, In);
        return truncateVectorWithPACKSS(DstVT, Trunc, DL, Subtarget, DAG);
    }
    return SDValue {};
}

fn LowerTruncateVecI1(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut In: SDValue = Op.getOperand(0);
    let mut InVT: MVT = In.getSimpleValueType();
    assert!(VT.getVectorElementType() == i1, "Unexpected vector type.");
    let mut ShiftInx: u32 = InVT.getScalarSizeInBits() - 1;
    if InVT.getScalarSizeInBits() <= 16 {
        if Subtarget.hasBWI() {
            if DAG.ComputeNumSignBits(In, 0) < InVT.getScalarSizeInBits() {
                let mut ExtVT: MVT = getVectorVT(i16, InVT.getSizeInBits().operator unsigned long long() / 16);
                In = DAG.getNode(SHL, DL, ExtVT, DAG.getBitcast(ExtVT, In), DAG.getConstant(ShiftInx, DL, ExtVT, false, false));
                In = DAG.getBitcast(InVT, In);
            }
            return DAG.getSetCC(DL, VT, DAG.getConstant(0, DL, InVT, false, false), In, SETGT, SDValue {}, false, None);
        }
        assert!((InVT.is256BitVector() || InVT.is128BitVector()), "Unexpected vector type.");
        let mut NumElts: u32 = InVT.getVectorNumElements();
        assert!((NumElts == 8 || NumElts == 16), "Unexpected number of elements");
        if NumElts == 16 && !Subtarget.canExtendTo512DQ() {
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            if InVT == v16i8 {
                Lo = DAG.getNode(SIGN_EXTEND_VECTOR_INREG, DL, v8i32, In);
                Hi = DAG.getVectorShuffle(InVT, DL, In, In, [8, 9, 10, 11, 12, 13, 14, 15, -1, -1, -1, -1, -1, -1, -1, -1]);
                Hi = DAG.getNode(SIGN_EXTEND_VECTOR_INREG, DL, v8i32, Hi);
            } else {
                assert!(InVT == v16i16, "Unexpected VT!");
                Lo = extract128BitVector(In, 0, DAG, DL);
                Hi = extract128BitVector(In, 8, DAG, DL);
            }
            Lo = DAG.getNode(TRUNCATE, DL, v8i1, Lo);
            Hi = DAG.getNode(TRUNCATE, DL, v8i1, Hi);
            return DAG.getNode(CONCAT_VECTORS, DL, VT, Lo, Hi);
        }
        let mut EltVT: MVT = if Subtarget.hasVLX() { i32 } else { getIntegerVT(512 / NumElts) };
        let mut ExtVT: MVT = getVectorVT(EltVT, NumElts);
        In = DAG.getNode(SIGN_EXTEND, DL, ExtVT, In);
        InVT = ExtVT;
        ShiftInx = InVT.getScalarSizeInBits() - 1;
    }
    if DAG.ComputeNumSignBits(In, 0) < InVT.getScalarSizeInBits() {
        In = DAG.getNode(SHL, DL, InVT, In, DAG.getConstant(ShiftInx, DL, InVT, false, false));
    }
    if Subtarget.hasDQI() {
        return DAG.getSetCC(DL, VT, DAG.getConstant(0, DL, InVT, false, false), In, SETGT, SDValue {}, false, None);
    }
    return DAG.getSetCC(DL, VT, In, DAG.getConstant(0, DL, InVT, false, false), SETNE, SDValue {}, false, None);
}

fn X86TargetLowering::LowerTRUNCATE(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    let mut In: SDValue = Op.getOperand(0);
    let mut InVT: MVT = In.getSimpleValueType();
    assert!(VT.getVectorNumElements() == InVT.getVectorNumElements(), "Invalid TRUNCATE operation");
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isTypeLegal(VT) || !TLI.isTypeLegal(InVT) {
        if (InVT == v8i64 || InVT == v16i32 || InVT == v16i64) && VT.is128BitVector() && self.Subtarget.hasAVX512() {
            assert!((InVT == v16i64 || self.Subtarget.hasVLX()), "Unexpected subtarget!");
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = DAG.SplitVector(In, DL);
            let mut LoVT: EVT = EVT {};
            let mut HiVT: EVT = EVT {};
            tie(LoVT, HiVT) = DAG.GetSplitDestVTs(VT);
            Lo = DAG.getNode(TRUNCATE, DL, LoVT, Lo);
            Hi = DAG.getNode(TRUNCATE, DL, HiVT, Hi);
            return DAG.getNode(CONCAT_VECTORS, DL, VT, Lo, Hi);
        }
        if !self.Subtarget.hasAVX512() || (InVT.is512BitVector() && VT.is256BitVector()) {
            if LowerTruncateVecPackWithSignBits(VT, In, DL, self.Subtarget, DAG, operator(Op).getFlags()) {
                SignPack;
            } else {
                return SignPack;
            }
        }
        if !self.Subtarget.hasAVX512() {
            return LowerTruncateVecPack(VT, In, DL, self.Subtarget, DAG);
        }
        return SDValue {};
    }
    if VT.getVectorElementType() == i1 {
        return LowerTruncateVecI1(Op, DL, DAG, self.Subtarget);
    }
    if !self.Subtarget.hasAVX512() || isFreeToSplitVector(In, DAG) {
        if LowerTruncateVecPackWithSignBits(VT, In, DL, self.Subtarget, DAG, operator(Op).getFlags()) {
            SignPack;
        } else {
            return SignPack;
        }
    }
    if self.Subtarget.hasAVX512() {
        if InVT == v32i16 && !self.Subtarget.hasBWI() {
            assert!(VT == v32i8, "Unexpected VT!");
            return splitVectorIntUnary(Op, DAG, DL);
        }
        if InVT != v16i16 || self.Subtarget.hasBWI() || self.Subtarget.canExtendTo512DQ() {
            return Op;
        }
    }
    assert!(VT.is128BitVector() && InVT.is256BitVector(), "Unexpected types!");
    if (VT == v4i32) && (InVT == v4i64) {
        if self.Subtarget.hasInt256() {
            let mut ShufMask: [8]i32 = [0, 2, 4, 6, -1, -1, -1, -1];
            In = DAG.getBitcast(v8i32, In);
            In = DAG.getVectorShuffle(v8i32, DL, In, In, ShufMask);
            return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, In, DAG.getVectorIdxConstant(0, DL, false));
        }
        let mut OpLo: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, v2i64, In, DAG.getVectorIdxConstant(0, DL, false));
        let mut OpHi: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, v2i64, In, DAG.getVectorIdxConstant(2, DL, false));
        let mut ShufMask: [4]i32 = [0, 2, 4, 6];
        return DAG.getVectorShuffle(VT, DL, DAG.getBitcast(v4i32, OpLo), DAG.getBitcast(v4i32, OpHi), ShufMask);
    }
    if (VT == v8i16) && (InVT == v8i32) {
        if self.Subtarget.hasInt256() {
            let mut ShufMask1: [32]i32 = [0, 1, 4, 5, 8, 9, 12, 13, -1, -1, -1, -1, -1, -1, -1, -1, 16, 17, 20, 21, 24, 25, 28, 29, -1, -1, -1, -1, -1, -1, -1, -1];
            In = DAG.getBitcast(v32i8, In);
            In = DAG.getVectorShuffle(v32i8, DL, In, In, ShufMask1);
            In = DAG.getBitcast(v4i64, In);
            let mut ShufMask2: [4]i32 = [0, 2, -1, -1];
            In = DAG.getVectorShuffle(v4i64, DL, In, In, ShufMask2);
            In = DAG.getNode(EXTRACT_SUBVECTOR, DL, v2i64, In, DAG.getVectorIdxConstant(0, DL, false));
            return DAG.getBitcast(v8i16, In);
        }
        return if self.Subtarget.hasSSE41() { truncateVectorWithPACKUS(VT, In, DL, self.Subtarget, DAG) } else { truncateVectorWithPACKSS(VT, In, DL, self.Subtarget, DAG) };
    }
    if VT == v16i8 && InVT == v16i16 {
        return truncateVectorWithPACKUS(VT, In, DL, self.Subtarget, DAG);
    }
    llvm_unreachable_internal("All 256->128 cases should have been handled above!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 22117);
}

fn expandFP_TO_UINT_SSE(VT: MVT, Src: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut DstBits: u32 = VT.getScalarSizeInBits();
    assert!(DstBits == 32, "expandFP_TO_UINT_SSE - only vXi32 supported");
    let mut Small: SDValue = DAG.getNode(CVTTP2SI, dl, VT, Src);
    let mut Big: SDValue = DAG.getNode(CVTTP2SI, dl, VT, DAG.getNode(FSUB, dl, SrcVT, Src, DAG.getConstantFP(2.14748365E+9, dl, SrcVT, false)));
    if VT == v8i32 && !Subtarget.hasAVX2() {
        let mut Overflow: SDValue = DAG.getNode(OR, dl, VT, Small, Big);
        return DAG.getNode(BLENDV, dl, VT, Small, Overflow, Small);
    }
    let mut IsOverflown: SDValue = getTargetVShiftByConstNode(VSRAI, dl, VT, Small, DstBits - 1, DAG);
    return DAG.getNode(OR, dl, VT, Small, DAG.getNode(AND, dl, VT, Big, IsOverflown));
}

fn X86TargetLowering::LowerFP_TO_INT(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut IsSigned: bool = Op.getOpcode() == FP_TO_SINT || Op.getOpcode() == STRICT_FP_TO_SINT;
    let mut HasVLX: bool = self.Subtarget.hasVLX();
    let mut VT: MVT = operator(Op).getSimpleValueType(0);
    let mut Src: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut Chain: SDValue = if IsStrict { operator(Op).getOperand(0) } else { SDValue {} };
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut dl: SDLoc = Op;
    let mut Res: SDValue = SDValue {};
    if isBF16orSoftF16(SrcVT, self.Subtarget) {
        let mut NVT: MVT = VT.changeElementType(f32);
        if IsStrict {
            return DAG.getNode(Op.getOpcode(), dl, [VT, Other], [Chain, DAG.getNode(STRICT_FP_EXTEND, dl, [NVT, Other], [Chain, Src])]);
        }
        return DAG.getNode(Op.getOpcode(), dl, VT, DAG.getNode(FP_EXTEND, dl, NVT, Src));
    } else if self.isTypeLegal(SrcVT) && isLegalConversion(VT, SrcVT, IsSigned, self.Subtarget) {
        return Op;
    }
    if VT.isVector() {
        if VT == v2i1 && SrcVT == v2f64 {
            let mut ResVT: MVT = v4i32;
            let mut TruncVT: MVT = v4i1;
            let mut Opc: u32 = 0;
            if IsStrict {
                Opc = if IsSigned { STRICT_CVTTP2SI } else { STRICT_CVTTP2UI };
            } else {
                Opc = if IsSigned { CVTTP2SI } else { CVTTP2UI };
            }
            if !IsSigned && !HasVLX {
                assert!(self.Subtarget.useAVX512Regs(), "Unexpected features!");
                ResVT = v8i32;
                TruncVT = v8i1;
                Opc = Op.getOpcode();
                let mut Tmp: SDValue = if IsStrict { DAG.getConstantFP(0.0, dl, v8f64, false) } else { DAG.getUNDEF(v8f64) };
                Src = DAG.getNode(INSERT_SUBVECTOR, dl, v8f64, Tmp, Src, DAG.getVectorIdxConstant(0, dl, false));
            }
            if IsStrict {
                Res = DAG.getNode(Opc, dl, [ResVT, Other], [Chain, Src]);
                Chain = Res.getValue(1);
            } else {
                Res = DAG.getNode(Opc, dl, ResVT, Src);
            }
            Res = DAG.getNode(TRUNCATE, dl, TruncVT, Res);
            Res = DAG.getNode(EXTRACT_SUBVECTOR, dl, v2i1, Res, DAG.getVectorIdxConstant(0, dl, false));
            if IsStrict {
                return DAG.getMergeValues([Res, Chain], dl);
            }
            return Res;
        }
        if self.Subtarget.hasFP16() && SrcVT.getVectorElementType() == f16 {
            if (HasVLX && (VT == v8i16 || VT == v16i16)) || VT == v32i16 {
                return Op;
            }
            let mut ResVT: MVT = VT;
            let mut EleVT: MVT = VT.getVectorElementType();
            if EleVT != i64 {
                ResVT = if EleVT == i32 { v4i32 } else { v8i16 };
            }
            if SrcVT == v2f16 || SrcVT == v4f16 {
                let mut Tmp: SDValue = if IsStrict { DAG.getConstantFP(0.0, dl, SrcVT, false) } else { DAG.getUNDEF(SrcVT) };
                let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { if SrcVT == v2f16 { 4 } else { 2 }, Tmp };
                Ops[0] = Src;
                Src = DAG.getNode(CONCAT_VECTORS, dl, v8f16, Ops);
            }
            if !HasVLX {
                assert!(self.Subtarget.useAVX512Regs(), "Unexpected features!");
                let mut IntSize: u32 = EleVT.getSizeInBits().operator unsigned long long();
                let mut Num: u32 = if IntSize > 16 { 512 / IntSize } else { 32 };
                ResVT = getVectorVT(EleVT, Num);
                Src = widenSubVector(getVectorVT(f16, Num), Src, IsStrict, self.Subtarget, DAG, dl);
            }
            if IsStrict {
                Res = DAG.getNode(if IsSigned { STRICT_CVTTP2SI } else { STRICT_CVTTP2UI }, dl, [ResVT, Other], [Chain, Src]);
                Chain = Res.getValue(1);
            } else {
                Res = DAG.getNode(if IsSigned { CVTTP2SI } else { CVTTP2UI }, dl, ResVT, Src);
            }
            if EleVT.getSizeInBits().operator unsigned long long() < 16 {
                if HasVLX {
                    ResVT = getVectorVT(EleVT, 8);
                }
                Res = DAG.getNode(TRUNCATE, dl, ResVT, Res);
            }
            if ResVT != VT {
                Res = DAG.getNode(EXTRACT_SUBVECTOR, dl, VT, Res, DAG.getVectorIdxConstant(0, dl, false));
            }
            if IsStrict {
                return DAG.getMergeValues([Res, Chain], dl);
            }
            return Res;
        }
        if VT.getVectorElementType() == i16 {
            assert!((SrcVT.getVectorElementType() == f32 || SrcVT.getVectorElementType() == f64), "Expected f32/f64 vector!");
            let mut NVT: MVT = VT.changeVectorElementType(i32);
            if IsStrict {
                Res = DAG.getNode(if IsSigned { STRICT_FP_TO_SINT } else { STRICT_FP_TO_UINT }, dl, [NVT, Other], [Chain, Src]);
                Chain = Res.getValue(1);
            } else {
                Res = DAG.getNode(if IsSigned { FP_TO_SINT } else { FP_TO_UINT }, dl, NVT, Src);
            }
            Res = DAG.getNode(TRUNCATE, dl, VT, Res);
            if IsStrict {
                return DAG.getMergeValues([Res, Chain], dl);
            }
            return Res;
        }
        if VT == v8i32 && SrcVT == v8f64 {
            assert!(!IsSigned, "Expected unsigned conversion!");
            assert!(self.Subtarget.useAVX512Regs(), "Requires avx512f");
            return Op;
        }
        if (VT == v4i32 || VT == v8i32) && (SrcVT == v4f64 || SrcVT == v4f32 || SrcVT == v8f32) && self.Subtarget.useAVX512Regs() {
            assert!(!IsSigned, "Expected unsigned conversion!");
            assert!(!self.Subtarget.hasVLX(), "Unexpected features!");
            let mut WideVT: MVT = if SrcVT == v4f64 { v8f64 } else { v16f32 };
            let mut ResVT: MVT = if SrcVT == v4f64 { v8i32 } else { v16i32 };
            let mut Tmp: SDValue = if IsStrict { DAG.getConstantFP(0.0, dl, WideVT, false) } else { DAG.getUNDEF(WideVT) };
            Src = DAG.getNode(INSERT_SUBVECTOR, dl, WideVT, Tmp, Src, DAG.getVectorIdxConstant(0, dl, false));
            if IsStrict {
                Res = DAG.getNode(STRICT_FP_TO_UINT, dl, [ResVT, Other], [Chain, Src]);
                Chain = Res.getValue(1);
            } else {
                Res = DAG.getNode(FP_TO_UINT, dl, ResVT, Src);
            }
            Res = DAG.getNode(EXTRACT_SUBVECTOR, dl, VT, Res, DAG.getVectorIdxConstant(0, dl, false));
            if IsStrict {
                return DAG.getMergeValues([Res, Chain], dl);
            }
            return Res;
        }
        if (VT == v2i64 || VT == v4i64) && (SrcVT == v2f64 || SrcVT == v4f64 || SrcVT == v4f32) && self.Subtarget.useAVX512Regs() && self.Subtarget.hasDQI() {
            assert!(!self.Subtarget.hasVLX(), "Unexpected features!");
            let mut WideVT: MVT = if SrcVT == v4f32 { v8f32 } else { v8f64 };
            let mut Tmp: SDValue = if IsStrict { DAG.getConstantFP(0.0, dl, WideVT, false) } else { DAG.getUNDEF(WideVT) };
            Src = DAG.getNode(INSERT_SUBVECTOR, dl, WideVT, Tmp, Src, DAG.getVectorIdxConstant(0, dl, false));
            if IsStrict {
                Res = DAG.getNode(Op.getOpcode(), dl, [v8i64, Other], [Chain, Src]);
                Chain = Res.getValue(1);
            } else {
                Res = DAG.getNode(Op.getOpcode(), dl, v8i64, Src);
            }
            Res = DAG.getNode(EXTRACT_SUBVECTOR, dl, VT, Res, DAG.getVectorIdxConstant(0, dl, false));
            if IsStrict {
                return DAG.getMergeValues([Res, Chain], dl);
            }
            return Res;
        }
        if VT == v2i64 && SrcVT == v2f32 {
            if !self.Subtarget.hasVLX() {
                if !IsStrict {
                    return SDValue {};
                }
                let mut Zero: SDValue = DAG.getConstantFP(0.0, dl, v2f32, false);
                let mut Tmp: SDValue = DAG.getNode(CONCAT_VECTORS, dl, v8f32, [Src, Zero, Zero, Zero]);
                Tmp = DAG.getNode(Op.getOpcode(), dl, [v8i64, Other], [Chain, Tmp]);
                let mut Chain: SDValue = Tmp.getValue(1);
                Tmp = DAG.getNode(EXTRACT_SUBVECTOR, dl, v2i64, Tmp, DAG.getVectorIdxConstant(0, dl, false));
                return DAG.getMergeValues([Tmp, Chain], dl);
            }
            assert!(self.Subtarget.hasDQI() && self.Subtarget.hasVLX(), "Requires AVX512DQVL");
            let mut Tmp: SDValue = DAG.getNode(CONCAT_VECTORS, dl, v4f32, Src, DAG.getUNDEF(v2f32));
            if IsStrict {
                let mut Opc: u32 = if IsSigned { STRICT_CVTTP2SI } else { STRICT_CVTTP2UI };
                return DAG.getNode(Opc, dl, [VT, Other], [operator(Op).getOperand(0), Tmp]);
            }
            let mut Opc: u32 = if IsSigned { CVTTP2SI } else { CVTTP2UI };
            return DAG.getNode(Opc, dl, VT, Tmp);
        }
        if (VT == v4i32 && SrcVT == v4f32) || (VT == v4i32 && SrcVT == v4f64) || (VT == v8i32 && SrcVT == v8f32) {
            assert!(!IsSigned, "Expected unsigned conversion!");
            return expandFP_TO_UINT_SSE(VT, Src, dl, DAG, self.Subtarget);
        }
        return SDValue {};
    }
    assert!(!VT.isVector();
    let mut UseSSEReg: bool = self.isScalarFPTypeInSSEReg(SrcVT);
    if !IsSigned && UseSSEReg {
        if self.Subtarget.hasAVX512() {
            return Op;
        }
        if !IsStrict && ((VT == i32 && !self.Subtarget.is64Bit()) || (VT == i64 && self.Subtarget.is64Bit())) {
            let mut DstBits: u32 = VT.getScalarSizeInBits();
            let mut UIntLimit: APInt = getSignMask(DstBits);
            let mut FloatOffset: SDValue = DAG.getNode(UINT_TO_FP, dl, SrcVT, DAG.getConstant(UIntLimit, dl, VT, false, false));
            let mut SrcVecVT: MVT = getVectorVT(SrcVT, 128 / SrcVT.getScalarSizeInBits());
            let mut Small: SDValue = DAG.getNode(CVTTS2SI, dl, VT, DAG.getNode(SCALAR_TO_VECTOR, dl, SrcVecVT, Src));
            let mut Big: SDValue = DAG.getNode(CVTTS2SI, dl, VT, DAG.getNode(SCALAR_TO_VECTOR, dl, SrcVecVT, DAG.getNode(FSUB, dl, SrcVT, Src, FloatOffset)));
            let mut IsOverflown: SDValue = DAG.getNode(SRA, dl, VT, Small, DAG.getConstant(DstBits - 1, dl, i8, false, false));
            return DAG.getNode(OR, dl, VT, Small, DAG.getNode(AND, dl, VT, Big, IsOverflown));
        }
        if VT == i64 {
            return SDValue {};
        }
        assert!(VT == i32, "Unexpected VT!");
        if self.Subtarget.is64Bit() {
            if IsStrict {
                Res = DAG.getNode(STRICT_FP_TO_SINT, dl, [i64, Other], [Chain, Src]);
                Chain = Res.getValue(1);
            } else {
                Res = DAG.getNode(FP_TO_SINT, dl, i64, Src);
            }
            Res = DAG.getNode(TRUNCATE, dl, VT, Res);
            if IsStrict {
                return DAG.getMergeValues([Res, Chain], dl);
            }
            return Res;
        }
        if !self.Subtarget.hasSSE3() {
            return SDValue {};
        }
    }
    if VT == i16 && (UseSSEReg || SrcVT == f128) {
        assert!(IsSigned, "Expected i16 FP_TO_UINT to have been promoted!");
        if IsStrict {
            Res = DAG.getNode(STRICT_FP_TO_SINT, dl, [i32, Other], [Chain, Src]);
            Chain = Res.getValue(1);
        } else {
            Res = DAG.getNode(FP_TO_SINT, dl, i32, Src);
        }
        Res = DAG.getNode(TRUNCATE, dl, VT, Res);
        if IsStrict {
            return DAG.getMergeValues([Res, Chain], dl);
        }
        return Res;
    }
    if UseSSEReg && IsSigned {
        return Op;
    }
    if SrcVT == f128 {
        let mut LC: Libcall = zeroed();
        if IsSigned {
            LC = getFPTOSINT(SrcVT, VT);
        } else {
            LC = getFPTOUINT(SrcVT, VT);
        }
        let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
        let mut Tmp: pair<SDValue, SDValue> = self.makeLibCall(DAG, LC, VT, Src, CallOptions, dl, Chain);
        if IsStrict {
            return DAG.getMergeValues([Tmp.first, Tmp.second], dl);
        }
        return Tmp.first;
    }
    if self.FP_TO_INTHelper(Op, DAG, IsSigned, Chain) {
        V;
    } else {
        if IsStrict {
            return DAG.getMergeValues([V, Chain], dl);
        }
        return V;
    }
    llvm_unreachable_internal("Expected FP_TO_INTHelper to handle all remaining cases.", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 22528);
}

fn X86TargetLowering::LowerLRINT_LLRINT(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Src: SDValue = Op.getOperand(0);
    let mut DstVT: EVT = Op.getSimpleValueType();
    let mut SrcVT: MVT = Src.getSimpleValueType();
    if SrcVT.isVector() {
        return if DstVT.getScalarType() == i32 { Op } else { SDValue {} };
    }
    if SrcVT == f16 {
        return SDValue {};
    }
    if self.isScalarFPTypeInSSEReg(SrcVT) {
        return Op;
    }
    return self.LRINT_LLRINTHelper(Op.getNode(), DAG);
}

fn X86TargetLowering::LRINT_LLRINTHelper(self: *X86TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(DAG.getSubtarget().hasX87(), "Expected X87");
    let mut DstVT: EVT = N.getValueType(0);
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    if SrcVT != f32 && SrcVT != f64 && SrcVT != f80 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut Chain: SDValue = DAG.getEntryNode();
    let mut UseSSE: bool = self.isScalarFPTypeInSSEReg(SrcVT);
    let mut OtherVT: EVT = if UseSSE { SrcVT } else { DstVT };
    let mut StackPtr: SDValue = DAG.CreateStackTemporary(DstVT, OtherVT);
    let mut SPFI: i32 = cast(StackPtr.getNode()).getIndex();
    let mut MPI: MachinePointerInfo = getFixedStack(DAG.getMachineFunction(), SPFI, 0);
    if UseSSE {
        assert!(DstVT == i64, "Invalid LRINT/LLRINT to lower!");
        Chain = DAG.getStore(Chain, DL, Src, StackPtr, MPI, MaybeAlign {}, MONone, MMOMetadata {});
        let mut Tys: SDVTList = DAG.getVTList(f80, Other);
        let mut Ops: [2]SDValue = [Chain, StackPtr];
        Src = DAG.getMemIntrinsicNode(FLD, DL, Tys, Ops, SrcVT, MPI, nullopt, MOLoad, precise(0), AAMDNodes {});
        Chain = Src.getValue(1);
    }
    let mut StoreOps: [3]SDValue = [Chain, Src, StackPtr];
    Chain = DAG.getMemIntrinsicNode(FIST, DL, DAG.getVTList(Other), StoreOps, DstVT, MPI, nullopt, MOStore, precise(0), AAMDNodes {});
    return DAG.getLoad(DstVT, DL, Chain, StackPtr, MPI, MaybeAlign {}, MONone, MMOMetadata {});
}

fn X86TargetLowering::LowerFP_TO_INT_SAT(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsSigned: bool = Op.getOpcode() == FP_TO_SINT_SAT;
    let mut FpToIntOpcode: u32 = if IsSigned { FP_TO_SINT } else { FP_TO_UINT };
    let mut dl: SDLoc = Op;
    let mut Src: SDValue = Op.getOperand(0);
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut DstVT: MVT = Op.getSimpleValueType();
    let mut TmpVT: MVT = DstVT;
    let mut SatVT: EVT = cast(Op.getOperand(1)).getVT();
    if self.Subtarget.hasAVX10_2() && SrcVT.isVector() && SrcVT.getVectorElementType() == bf16 && SatVT == i8 {
        let mut VecI16VT: MVT = SrcVT.changeVectorElementType(i16);
        let mut Res: SDValue = DAG.getNode(if IsSigned { CVTTP2IBS } else { CVTTP2IUBS }, dl, VecI16VT, Src);
        return DAG.getNode(TRUNCATE, dl, DstVT, Res);
    }
    if !self.isScalarFPTypeInSSEReg(SrcVT) || isBF16orSoftF16(SrcVT, self.Subtarget) {
        return SDValue {};
    }
    let mut SatWidth: u32 = SatVT.getScalarSizeInBits();
    let mut DstWidth: u32 = DstVT.getScalarSizeInBits();
    let mut TmpWidth: u32 = TmpVT.getScalarSizeInBits();
    assert!(SatWidth <= DstWidth && SatWidth <= TmpWidth, "Expected saturation width smaller than result width");
    if TmpWidth < 32 {
        TmpVT = i32;
        TmpWidth = 32;
    }
    if SatWidth == 32 && !IsSigned && self.Subtarget.is64Bit() {
        TmpVT = i64;
        TmpWidth = 64;
    }
    if SatWidth < TmpWidth {
        FpToIntOpcode = FP_TO_SINT;
    }
    let mut MinInt: APInt = APInt {};
    let mut MaxInt: APInt = APInt {};
    if IsSigned {
        MinInt = getSignedMinValue(SatWidth).sext(DstWidth);
        MaxInt = getSignedMaxValue(SatWidth).sext(DstWidth);
    } else {
        MinInt = getMinValue(SatWidth).zext(DstWidth);
        MaxInt = getMaxValue(SatWidth).zext(DstWidth);
    }
    let mut Sem: *fltSemantics = SrcVT.getFltSemantics();
    let mut MinFloat: APFloat = Sem;
    let mut MaxFloat: APFloat = Sem;
    let mut MinStatus: opStatus = MinFloat.convertFromAPInt(MinInt, IsSigned, rmTowardZero);
    let mut MaxStatus: opStatus = MaxFloat.convertFromAPInt(MaxInt, IsSigned, rmTowardZero);
    let mut AreExactFloatBounds: bool = !(MinStatus & opInexact) && !(MaxStatus & opInexact);
    let mut MinFloatNode: SDValue = DAG.getConstantFP(MinFloat, dl, SrcVT, false);
    let mut MaxFloatNode: SDValue = DAG.getConstantFP(MaxFloat, dl, SrcVT, false);
    if AreExactFloatBounds {
        if DstVT != TmpVT {
            let mut MinClamped: SDValue = DAG.getNode(PSEUDO_FMAX, dl, SrcVT, MinFloatNode, Src);
            let mut BothClamped: SDValue = DAG.getNode(PSEUDO_FMIN, dl, SrcVT, MaxFloatNode, MinClamped);
            let mut FpToInt: SDValue = DAG.getNode(FpToIntOpcode, dl, TmpVT, BothClamped);
            return DAG.getNode(TRUNCATE, dl, DstVT, FpToInt);
        }
        let mut MinClamped: SDValue = DAG.getNode(PSEUDO_FMAX, dl, SrcVT, Src, MinFloatNode);
        let mut BothClamped: SDValue = DAG.getNode(FMINC, dl, SrcVT, MinClamped, MaxFloatNode);
        let mut FpToInt: SDValue = DAG.getNode(FpToIntOpcode, dl, DstVT, BothClamped);
        if !IsSigned {
            return FpToInt;
        }
        let mut ZeroInt: SDValue = DAG.getConstant(0, dl, DstVT, false, false);
        return DAG.getSelectCC(dl, Src, Src, ZeroInt, FpToInt, SETUO, SDNodeFlags { Flags: None });
    }
    let mut MinIntNode: SDValue = DAG.getConstant(MinInt, dl, DstVT, false, false);
    let mut MaxIntNode: SDValue = DAG.getConstant(MaxInt, dl, DstVT, false, false);
    let mut FpToInt: SDValue = DAG.getNode(FpToIntOpcode, dl, TmpVT, Src);
    if DstVT != TmpVT {
        FpToInt = DAG.getNode(TRUNCATE, dl, DstVT, FpToInt);
    }
    let mut Select: SDValue = FpToInt;
    if !IsSigned || SatWidth != TmpVT.getScalarSizeInBits() {
        let mut MinCC: CondCode = if (IsSigned && DstVT != TmpVT) { SETOLT } else { SETULT };
        Select = DAG.getSelectCC(dl, Src, MinFloatNode, MinIntNode, Select, MinCC, SDNodeFlags { Flags: None });
    }
    Select = DAG.getSelectCC(dl, Src, MaxFloatNode, MaxIntNode, Select, SETOGT, SDNodeFlags { Flags: None });
    if !IsSigned || DstVT != TmpVT {
        return Select;
    }
    let mut ZeroInt: SDValue = DAG.getConstant(0, dl, DstVT, false, false);
    return DAG.getSelectCC(dl, Src, Src, ZeroInt, Select, SETUO, SDNodeFlags { Flags: None });
}

fn X86TargetLowering::LowerFP_EXTEND(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut DL: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    let mut Chain: SDValue = if IsStrict { Op.getOperand(0) } else { SDValue {} };
    let mut In: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut SVT: MVT = In.getSimpleValueType();
    if VT == f128 || (SVT == f16 && VT == f80 && !self.Subtarget.getTargetTriple().isOSDarwin()) {
        return SDValue {};
    }
    if (SVT == v8f16 && self.Subtarget.hasF16C()) || (SVT == v16f16 && self.Subtarget.useAVX512Regs()) {
        return Op;
    }
    if SVT == f16 {
        if self.Subtarget.hasFP16() {
            return Op;
        }
        if VT != f32 {
            if IsStrict {
                return DAG.getNode(STRICT_FP_EXTEND, DL, [VT, Other], [Chain, DAG.getNode(STRICT_FP_EXTEND, DL, [f32, Other], [Chain, In])]);
            }
            return DAG.getNode(FP_EXTEND, DL, VT, DAG.getNode(FP_EXTEND, DL, f32, In));
        }
        if !self.Subtarget.hasF16C() {
            if !self.Subtarget.getTargetTriple().isOSDarwin() {
                return SDValue {};
            }
            assert!(VT == f32 && SVT == f16, "unexpected extend libcall");
            let mut CLI: CallLoweringInfo = DAG;
            Chain = if IsStrict { Op.getOperand(0) } else { DAG.getEntryNode() };
            In = DAG.getBitcast(i16, In);
            let mut Args: ArgListTy = ArgListTy {};
            let mut Entry: ArgListEntry = ArgListEntry { In, i16.getTypeForEVT(*DAG.getContext()) };
            Entry.IsSExt = false;
            Entry.IsZExt = true;
            Args.push(Entry);
            let mut FPExtImpl: LibcallImpl = DAG.getLibcalls().getLibcallImpl(FPEXT_F16_F32);
            if FPExtImpl == Unsupported {
                return SDValue {};
            }
            let mut CC: ID = DAG.getLibcalls().getLibcallImplCallingConv(FPExtImpl);
            let mut Callee: SDValue = DAG.getExternalSymbol(FPExtImpl, self.getPointerTy(DAG.getDataLayout(), 0));
            CLI.setDebugLoc(DL).setChain(Chain).setLibCallee(CC, VT.getTypeForEVT(*DAG.getContext()), Callee, move(Args));
            let mut Res: SDValue = SDValue {};
            tie(Res, Chain) = self.LowerCallTo(CLI);
            if IsStrict {
                Res = DAG.getMergeValues([Res, Chain], DL);
            }
            return Res;
        }
        In = DAG.getBitcast(i16, In);
        let mut Res: SDValue = SDValue {};
        if IsStrict {
            In = DAG.getNode(INSERT_VECTOR_ELT, DL, v8i16, getZeroVector(v8i16, self.Subtarget, DAG, DL), In, DAG.getVectorIdxConstant(0, DL, false));
            Res = DAG.getNode(STRICT_CVTPH2PS, DL, [v4f32, Other], [Chain, In]);
            Chain = Res.getValue(1);
        } else {
            In = DAG.getNode(ANY_EXTEND, DL, i32, In);
            In = DAG.getNode(INSERT_VECTOR_ELT, DL, v4i32, DAG.getUNDEF(v4i32), In, DAG.getVectorIdxConstant(0, DL, false));
            In = DAG.getBitcast(v8i16, In);
            Res = DAG.getNode(CVTPH2PS, DL, v4f32, In);
        }
        Res = DAG.getNode(EXTRACT_VECTOR_ELT, DL, f32, Res, DAG.getVectorIdxConstant(0, DL, false));
        if IsStrict {
            return DAG.getMergeValues([Res, Chain], DL);
        }
        return Res;
    }
    if !SVT.isVector() || SVT.getVectorElementType() == bf16 {
        return Op;
    }
    if SVT.getVectorElementType() == f16 {
        if self.Subtarget.hasFP16() && self.isTypeLegal(SVT) {
            return Op;
        }
        assert!(self.Subtarget.hasF16C(), "Unexpected features!");
        if SVT == v2f16 {
            In = DAG.getNode(CONCAT_VECTORS, DL, v4f16, In, DAG.getUNDEF(v2f16));
        }
        let mut Res: SDValue = DAG.getNode(CONCAT_VECTORS, DL, v8f16, In, DAG.getUNDEF(v4f16));
        if IsStrict {
            return DAG.getNode(STRICT_VFPEXT, DL, [VT, Other], [operator(Op).getOperand(0), Res]);
        }
        return DAG.getNode(VFPEXT, DL, VT, Res);
    } else if VT == v4f64 || VT == v8f64 {
        return Op;
    }
    assert!(SVT == v2f32, "Only customize MVT::v2f32 type legalization!");
    let mut Res: SDValue = DAG.getNode(CONCAT_VECTORS, DL, v4f32, In, DAG.getUNDEF(SVT));
    if IsStrict {
        return DAG.getNode(STRICT_VFPEXT, DL, [VT, Other], [operator(Op).getOperand(0), Res]);
    }
    return DAG.getNode(VFPEXT, DL, VT, Res);
}

fn X86TargetLowering::LowerFP_ROUND(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = if IsStrict { Op.getOperand(0) } else { SDValue {} };
    let mut In: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut VT: MVT = Op.getSimpleValueType();
    let mut SVT: MVT = In.getSimpleValueType();
    if SVT == f128 || (VT == f16 && SVT == f80) {
        return SDValue {};
    }
    if VT == f16 && (SVT == f64 || SVT == f32) && !self.Subtarget.hasFP16() && (SVT == f64 || !self.Subtarget.hasF16C()) {
        if !self.Subtarget.getTargetTriple().isOSDarwin() {
            return SDValue {};
        }
        let mut CLI: CallLoweringInfo = DAG;
        Chain = if IsStrict { Op.getOperand(0) } else { DAG.getEntryNode() };
        let mut Args: ArgListTy = ArgListTy {};
        let mut Entry: ArgListEntry = ArgListEntry { In, SVT.getTypeForEVT(*DAG.getContext()) };
        Entry.IsSExt = false;
        Entry.IsZExt = true;
        Args.push(Entry);
        let mut FPRoundImpl: LibcallImpl = DAG.getLibcalls().getLibcallImpl(if SVT == f64 { FPROUND_F64_F16 } else { FPROUND_F32_F16 });
        if FPRoundImpl == Unsupported {
            return SDValue {};
        }
        let mut CC: ID = DAG.getLibcalls().getLibcallImplCallingConv(FPRoundImpl);
        let mut Callee: SDValue = DAG.getExternalSymbol(FPRoundImpl, self.getPointerTy(DAG.getDataLayout(), 0));
        CLI.setDebugLoc(DL).setChain(Chain).setLibCallee(CC, i16.getTypeForEVT(*DAG.getContext()), Callee, move(Args));
        let mut Res: SDValue = SDValue {};
        tie(Res, Chain) = self.LowerCallTo(CLI);
        Res = DAG.getBitcast(f16, Res);
        if IsStrict {
            Res = DAG.getMergeValues([Res, Chain], DL);
        }
        return Res;
    }
    if VT.getScalarType() == bf16 {
        if SVT.getScalarType() == f32 && ((self.Subtarget.hasBF16() && self.Subtarget.hasVLX()) || self.Subtarget.hasAVXNECONVERT()) {
            return Op;
        }
        return SDValue {};
    }
    if VT.getScalarType() == f16 && !self.Subtarget.hasFP16() {
        if !self.Subtarget.hasF16C() || SVT.getScalarType() != f32 {
            return SDValue {};
        }
        if VT.isVector() {
            return Op;
        }
        let mut Res: SDValue = SDValue {};
        let mut Rnd: SDValue = DAG.getTargetConstant(CUR_DIRECTION, DL, i32, false);
        if IsStrict {
            Res = DAG.getNode(INSERT_VECTOR_ELT, DL, v4f32, DAG.getConstantFP(0, DL, v4f32, false), In, DAG.getVectorIdxConstant(0, DL, false));
            Res = DAG.getNode(STRICT_CVTPS2PH, DL, [v8i16, Other], [Chain, Res, Rnd]);
            Chain = Res.getValue(1);
        } else {
            Res = DAG.getNode(SCALAR_TO_VECTOR, DL, v4f32, In);
            Res = DAG.getNode(CVTPS2PH, DL, v8i16, Res, Rnd);
        }
        Res = DAG.getNode(EXTRACT_VECTOR_ELT, DL, i16, Res, DAG.getVectorIdxConstant(0, DL, false));
        Res = DAG.getBitcast(f16, Res);
        if IsStrict {
            return DAG.getMergeValues([Res, Chain], DL);
        }
        return Res;
    }
    return Op;
}

fn LowerFP16_TO_FP(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut Src: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    assert!(Src.getValueType() == i16 && Op.getValueType() == f32, "Unexpected VT!");
    let mut dl: SDLoc = Op;
    let mut Res: SDValue = DAG.getNode(INSERT_VECTOR_ELT, dl, v8i16, DAG.getConstant(0, dl, v8i16, false, false), Src, DAG.getVectorIdxConstant(0, dl, false));
    let mut Chain: SDValue = SDValue {};
    if IsStrict {
        Res = DAG.getNode(STRICT_CVTPH2PS, dl, [v4f32, Other], [Op.getOperand(0), Res]);
        Chain = Res.getValue(1);
    } else {
        Res = DAG.getNode(CVTPH2PS, dl, v4f32, Res);
    }
    Res = DAG.getNode(EXTRACT_VECTOR_ELT, dl, f32, Res, DAG.getVectorIdxConstant(0, dl, false));
    if IsStrict {
        return DAG.getMergeValues([Res, Chain], dl);
    }
    return Res;
}

fn LowerFP_TO_FP16(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut Src: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    assert!(Src.getValueType() == f32 && Op.getValueType() == i16, "Unexpected VT!");
    let mut dl: SDLoc = Op;
    let mut Res: SDValue = SDValue {};
    let mut Chain: SDValue = SDValue {};
    if IsStrict {
        Res = DAG.getNode(INSERT_VECTOR_ELT, dl, v4f32, DAG.getConstantFP(0, dl, v4f32, false), Src, DAG.getVectorIdxConstant(0, dl, false));
        Res = DAG.getNode(STRICT_CVTPS2PH, dl, [v8i16, Other], [Op.getOperand(0), Res, DAG.getTargetConstant(CUR_DIRECTION, dl, i32, false)]);
        Chain = Res.getValue(1);
    } else {
        Res = DAG.getNode(SCALAR_TO_VECTOR, dl, v4f32, Src);
        Res = DAG.getNode(CVTPS2PH, dl, v8i16, Res, DAG.getTargetConstant(CUR_DIRECTION, dl, i32, false));
    }
    Res = DAG.getNode(EXTRACT_VECTOR_ELT, dl, i16, Res, DAG.getVectorIdxConstant(0, dl, false));
    if IsStrict {
        return DAG.getMergeValues([Res, Chain], dl);
    }
    return Res;
}

fn X86TargetLowering::LowerBF16_TO_FP(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Src: SDValue = DAG.getBitcast(i16, Op.getOperand(0));
    let mut Res: SDValue = SDValue {};
    if !self.Subtarget.hasFP16() && isNormalLoad(Src.getNode()) {
        let mut Wide: SDValue = DAG.getZExtOrTrunc(Src, DL, i32);
        Wide = DAG.getNode(SHL, DL, i32, Wide, DAG.getShiftAmountConstant(16, i32, DL));
        Res = DAG.getBitcast(f32, Wide);
    } else {
        let mut Vec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, v8i16, Src);
        Vec = DAG.getBitcast(v4i32, Vec);
        Vec = getTargetVShiftByConstNode(VSHLI, DL, v4i32, Vec, 16, DAG);
        Vec = DAG.getBitcast(v4f32, Vec);
        Res = DAG.getExtractVectorElt(DL, f32, Vec, 0);
    }
    let mut DstVT: EVT = Op.getValueType();
    if DstVT != f32 {
        Res = DAG.getNode(FP_EXTEND, DL, DstVT, Res);
    }
    return Res;
}

fn X86TargetLowering::LowerFP_TO_BF16(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut SVT: MVT = Op.getOperand(0).getSimpleValueType();
    if SVT == f32 && ((self.Subtarget.hasBF16() && self.Subtarget.hasVLX()) || self.Subtarget.hasAVXNECONVERT()) {
        let mut Res: SDValue = SDValue {};
        Res = DAG.getNode(SCALAR_TO_VECTOR, DL, v4f32, Op.getOperand(0));
        Res = DAG.getNode(CVTNEPS2BF16, DL, v8bf16, Res);
        Res = DAG.getBitcast(v8i16, Res);
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, i16, Res, DAG.getVectorIdxConstant(0, DL, false));
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut LC: Libcall = getFPROUND(SVT, bf16);
    let mut Res: SDValue = self.makeLibCall(DAG, LC, f16, Op.getOperand(0), CallOptions, DL, SDValue {}).first;
    return DAG.getBitcast(i16, Res);
}

fn lowerAddSubToHorizontalOp(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    if !LHS.hasOneUse() && !RHS.hasOneUse() {
        return Op;
    }
    let mut IsFP: bool = Op.getSimpleValueType().isFloatingPoint();
    if IsFP && !Subtarget.hasSSE3() {
        return Op;
    }
    if !IsFP && !Subtarget.hasSSSE3() {
        return Op;
    }
    if LHS.getOpcode() != EXTRACT_VECTOR_ELT || RHS.getOpcode() != EXTRACT_VECTOR_ELT || LHS.getOperand(0) != RHS.getOperand(0) || !isa(LHS.getOperand(1)) || !isa(RHS.getOperand(1)) || !shouldUseHorizontalOp(true, DAG, Subtarget) {
        return Op;
    }
    let mut HOpcode: u32 = 0;
    match Op.getOpcode() {
        ADD => {
            HOpcode = HADD;
        },
        SUB => {
            HOpcode = HSUB;
        },
        FADD => {
            HOpcode = FHADD;
        },
        FSUB => {
            HOpcode = FHSUB;
        },
        _ => {
            llvm_unreachable_internal("Trying to lower unsupported opcode to horizontal op", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 23136);
        },
    }
    let mut LExtIndex: u32 = LHS.getConstantOperandVal(1);
    let mut RExtIndex: u32 = RHS.getConstantOperandVal(1);
    if (LExtIndex & 1) == 1 && (RExtIndex & 1) == 0 && (HOpcode == HADD || HOpcode == FHADD) {
        swap(LExtIndex, RExtIndex);
    }
    if (LExtIndex & 1) != 0 || RExtIndex != (LExtIndex + 1) {
        return Op;
    }
    let mut X: SDValue = LHS.getOperand(0);
    let mut VecVT: EVT = X.getValueType();
    let mut BitWidth: u32 = VecVT.getSizeInBits().operator unsigned long long();
    let mut NumLanes: u32 = BitWidth / 128;
    let mut NumEltsPerLane: u32 = VecVT.getVectorNumElements() / NumLanes;
    assert!((BitWidth == 128 || BitWidth == 256 || BitWidth == 512), "Not expecting illegal vector widths here");
    if BitWidth == 256 || BitWidth == 512 {
        let mut LaneIdx: u32 = LExtIndex / NumEltsPerLane;
        X = extract128BitVector(X, LaneIdx * NumEltsPerLane, DAG, DL);
        LExtIndex %= NumEltsPerLane;
    }
    let mut HOp: SDValue = DAG.getNode(HOpcode, DL, X.getValueType(), X, X);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, Op.getSimpleValueType(), HOp, DAG.getVectorIdxConstant(LExtIndex / 2, DL, false));
}

fn X86TargetLowering::lowerFaddFsub(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Op.getValueType() == f32 || Op.getValueType() == f64), "Only expecting float/double");
    return lowerAddSubToHorizontalOp(Op, Op, DAG, self.Subtarget);
}

fn LowerFROUND(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut N0: SDValue = Op.getOperand(0);
    let mut dl: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    let mut Sem: *fltSemantics = VT.getFltSemantics();
    let mut Ignored: bool = false;
    let mut Point5Pred: APFloat = 0.5;
    Point5Pred.convert(Sem, rmNearestTiesToEven, &mut Ignored);
    Point5Pred.next(true);
    let mut Adder: SDValue = DAG.getNode(FCOPYSIGN, dl, VT, DAG.getConstantFP(Point5Pred, dl, VT, false), N0);
    N0 = DAG.getNode(FADD, dl, VT, N0, Adder);
    return DAG.getNode(FTRUNC, dl, VT, N0);
}

fn LowerFABSorFNEG(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Op.getOpcode() == FABS || Op.getOpcode() == FNEG), "Wrong opcode for lowering FABS or FNEG.");
    let mut IsFABS: bool = (Op.getOpcode() == FABS);
    if IsFABS {
        for User in operator(Op).users() {
            if User.getOpcode() == FNEG {
                return Op;
            }
        }
    }
    let mut dl: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    let mut IsF128: bool = (VT == f128);
    assert!(VT.isFloatingPoint() && VT != f80 && DAG.getTargetLoweringInfo().isTypeLegal(VT), "Unexpected type in LowerFABSorFNEG");
    let mut IsFakeVector: bool = !VT.isVector() && !IsF128;
    let mut LogicVT: MVT = VT;
    if IsFakeVector {
        LogicVT = if (VT == f64) { v2f64 } else { if (VT == f32) { v4f32 } else { v8f16 } };
    }
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    let mut MaskElt: APInt = if IsFABS { getSignedMaxValue(EltBits) } else { getSignMask(EltBits) };
    let mut Sem: *fltSemantics = VT.getFltSemantics();
    let mut Mask: SDValue = DAG.getConstantFP(APFloat { Sem, MaskElt }, dl, LogicVT, false);
    let mut Op0: SDValue = Op.getOperand(0);
    let mut IsFNABS: bool = !IsFABS && (Op0.getOpcode() == FABS);
    let mut LogicOp: u32 = if IsFABS { FAND } else { if IsFNABS { FOR } else { FXOR } };
    let mut Operand: SDValue = if IsFNABS { Op0.getOperand(0) } else { Op0 };
    if VT.isVector() || IsF128 {
        return DAG.getNode(LogicOp, dl, LogicVT, Operand, Mask);
    }
    Operand = DAG.getNode(SCALAR_TO_VECTOR, dl, LogicVT, Operand);
    let mut LogicNode: SDValue = DAG.getNode(LogicOp, dl, LogicVT, Operand, Mask);
    return DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT, LogicNode, DAG.getVectorIdxConstant(0, dl, false));
}

fn LowerFCOPYSIGN(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Mag: SDValue = Op.getOperand(0);
    let mut Sign: SDValue = Op.getOperand(1);
    let mut dl: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    if Sign.getSimpleValueType().bitsLT(VT) {
        Sign = DAG.getNode(FP_EXTEND, dl, VT, Sign);
    }
    if Sign.getSimpleValueType().bitsGT(VT) {
        Sign = DAG.getNode(FP_ROUND, dl, VT, Sign, DAG.getIntPtrConstant(0, dl, true));
    }
    let mut IsF128: bool = (VT == f128);
    assert!(VT.isFloatingPoint() && VT != f80 && DAG.getTargetLoweringInfo().isTypeLegal(VT), "Unexpected type in LowerFCOPYSIGN");
    let mut Sem: *fltSemantics = VT.getFltSemantics();
    let mut IsFakeVector: bool = !VT.isVector() && !IsF128;
    let mut LogicVT: MVT = VT;
    if IsFakeVector {
        LogicVT = if (VT == f64) { v2f64 } else { if (VT == f32) { v4f32 } else { v8f16 } };
    }
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut SignMask: SDValue = DAG.getConstantFP(APFloat { Sem, getSignMask(EltSizeInBits) }, dl, LogicVT, false);
    let mut MagMask: SDValue = DAG.getConstantFP(APFloat { Sem, getSignedMaxValue(EltSizeInBits) }, dl, LogicVT, false);
    if IsFakeVector {
        Sign = DAG.getNode(SCALAR_TO_VECTOR, dl, LogicVT, Sign);
    }
    let mut SignBit: SDValue = DAG.getNode(FAND, dl, LogicVT, Sign, SignMask);
    let mut MagBits: SDValue = SDValue {};
    if isConstOrConstSplatFP(Mag, false) {
        Op0CN;
    } else {
        let mut APF: APFloat = Op0CN.getValueAPF();
        APF.clearSign();
        MagBits = DAG.getConstantFP(APF, dl, LogicVT, false);
    }
    let mut Or: SDValue = DAG.getNode(FOR, dl, LogicVT, MagBits, SignBit);
    return if !IsFakeVector { Or } else { DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT, Or, DAG.getVectorIdxConstant(0, dl, false)) };
}

fn LowerFGETSIGN(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut N0: SDValue = Op.getOperand(0);
    let mut dl: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    let mut OpVT: MVT = N0.getSimpleValueType();
    assert!((OpVT == f32 || OpVT == f64), "Unexpected type for FGETSIGN");
    let mut VecVT: MVT = (if OpVT == f32 { v4f32 } else { v2f64 });
    let mut Res: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, VecVT, N0);
    Res = DAG.getNode(MOVMSK, dl, i32, Res);
    Res = DAG.getZExtOrTrunc(Res, dl, VT);
    Res = DAG.getNode(AND, dl, VT, Res, DAG.getConstant(1, dl, VT, false, false));
    return Res;
}

fn getBT(Src: SDValue, BitNo: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if Src.getValueType().getScalarSizeInBits() < 32 {
        Src = DAG.getNode(ANY_EXTEND, DL, i32, Src);
    }
    if !DAG.getTargetLoweringInfo().isTypeLegal(Src.getValueType()) {
        return SDValue {};
    }
    if Src.getValueType() == i64 && DAG.MaskedValueIsZero(BitNo, APInt { BitNo.getValueSizeInBits().operator unsigned long long(), 32, false, false }, 0) {
        Src = DAG.getNode(TRUNCATE, DL, i32, Src);
    }
    if Src.getValueType() != BitNo.getValueType() {
        if BitNo.getOpcode() == AND && operator(BitNo).hasOneUse() {
            BitNo = DAG.getNode(AND, DL, Src.getValueType(), DAG.getAnyExtOrTrunc(BitNo.getOperand(0), DL, Src.getValueType()), DAG.getAnyExtOrTrunc(BitNo.getOperand(1), DL, Src.getValueType()));
        } else {
            BitNo = DAG.getAnyExtOrTrunc(BitNo, DL, Src.getValueType());
        }
    }
    return DAG.getNode(BT, DL, i32, Src, BitNo);
}

fn getSETCC(Cond: CondCode, EFLAGS: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    return DAG.getNode(SETCC, dl, i8, DAG.getTargetConstant(Cond, dl, i8, false), EFLAGS);
}

fn isOrXorXorTree(X: SDValue, Root: bool) -> bool {
    if X.getOpcode() == OR {
        return isOrXorXorTree(X.getOperand(0), false) && isOrXorXorTree(X.getOperand(1), false);
    }
    if Root {
        return false;
    }
    return X.getOpcode() == XOR;
}

