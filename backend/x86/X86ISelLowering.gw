        if (Subtarget.hasAVX2() || (Subtarget.hasAVX() && 32 <= MaskEltSizeInBits)) && (!IsMaskedShuffle || NumRootElts == NumMaskElts) {
            if isUndefOrEqual(0) {
                if V1.getValueType() == EVT { MaskVT } && V1.getOpcode() == SCALAR_TO_VECTOR && mayFoldLoad(V1.getOperand(0), Subtarget, false, false) {
                    if  {
                        return SDValue {};
                    }
                    Res = V1.getOperand(0);
                    Res = DAG;
                    return DAG.getBitcast(EVT { RootVT }, Res);
                }
                if Subtarget.hasAVX2() {
                    if  {
                        return SDValue {};
                    }
                    Res = CanonicalizeShuffleInput.call(MaskVT, V1);
                    Res = DAG;
                    return DAG.getBitcast(EVT { RootVT }, Res);
                }
            }
        }
        if matchUnaryShuffle(MaskVT, AllowFloatDomain, AllowIntDomain, V1, DAG, Subtarget, Shuffle, ShuffleSrcVT, ShuffleVT) && (!IsMaskedShuffle || (NumRootElts == ShuffleVT.getVectorNumElements())) {
            if Depth == 0 && RootOpc == Shuffle {
                return SDValue {};
            }
            Res = CanonicalizeShuffleInput.call(ShuffleSrcVT, V1);
            Res = DAG.getNode(Shuffle, DL, EVT { ShuffleVT }, Res);
            return DAG.getBitcast(EVT { RootVT }, Res);
        }
        if matchUnaryPermuteShuffle(MaskVT, Zeroable, AllowFloatDomain, AllowIntDomain, DAG, Subtarget, Shuffle, ShuffleVT, PermuteImm) && (!IsMaskedShuffle || (NumRootElts == ShuffleVT.getVectorNumElements())) {
            if Depth == 0 && RootOpc == Shuffle {
                return SDValue {};
            }
            Res = CanonicalizeShuffleInput.call(ShuffleVT, V1);
            Res = DAG.getNode(Shuffle, DL, EVT { ShuffleVT }, Res, DAG.getTargetConstant(PermuteImm, DL, EVT { i8 }, false));
            return DAG.getBitcast(EVT { RootVT }, Res);
        }
    }
    if !UnaryShuffle && AllowFloatDomain && RootSizeInBits == 128 && Subtarget.hasSSE41() && operator!(isTargetShuffleEquivalent(MaskVT, void { 4, 1, 2, 3 }, DAG)) {
        if MaskEltSizeInBits == 32 {
            let mut SrcV1: SDValue = V1;
            let mut SrcV2: SDValue = V2;
            if matchShuffleAsInsertPS(SrcV1, SrcV2, PermuteImm, Zeroable, DAG) && SrcV2.getOpcode() == SCALAR_TO_VECTOR {
                if  {
                    return SDValue {};
                }
                Res = DAG;
                return DAG.getBitcast(EVT { RootVT }, Res);
            }
        }
        if MaskEltSizeInBits == 64 && isTargetShuffleEquivalent(MaskVT, void { 0, 2 }, DAG) && V2.getOpcode() == SCALAR_TO_VECTOR && V2.getScalarValueSizeInBits() <= 32 {
            if  {
                return SDValue {};
            }
            PermuteImm = (2 << 4) | (0 << 0);
            Res = DAG;
            return DAG.getBitcast(EVT { RootVT }, Res);
        }
    }
    let mut NewV1: SDValue = V1;
    let mut NewV2: SDValue = V2;
    if matchBinaryShuffle(MaskVT, AllowFloatDomain, AllowIntDomain, NewV1, NewV2, DL, DAG, Subtarget, Shuffle, ShuffleSrcVT, ShuffleVT, UnaryShuffle) && (!IsMaskedShuffle || (NumRootElts == ShuffleVT.getVectorNumElements())) {
        if Depth == 0 && RootOpc == Shuffle {
            return SDValue {};
        }
        NewV1 = CanonicalizeShuffleInput.call(ShuffleSrcVT, NewV1);
        NewV2 = CanonicalizeShuffleInput.call(ShuffleSrcVT, NewV2);
        Res = DAG.getNode(Shuffle, DL, EVT { ShuffleVT }, NewV1, NewV2);
        return DAG.getBitcast(EVT { RootVT }, Res);
    }
    NewV1 = V1;
    NewV2 = V2;
    if matchBinaryPermuteShuffle(MaskVT, Zeroable, AllowFloatDomain, AllowIntDomain, NewV1, NewV2, DL, DAG, Subtarget, Shuffle, ShuffleVT, PermuteImm) && (!IsMaskedShuffle || (NumRootElts == ShuffleVT.getVectorNumElements())) {
        if Depth == 0 && RootOpc == Shuffle {
            return SDValue {};
        }
        NewV1 = CanonicalizeShuffleInput.call(ShuffleVT, NewV1);
        NewV2 = CanonicalizeShuffleInput.call(ShuffleVT, NewV2);
        Res = DAG.getNode(Shuffle, DL, EVT { ShuffleVT }, NewV1, NewV2, DAG.getTargetConstant(PermuteImm, DL, EVT { i8 }, false));
        return DAG.getBitcast(EVT { RootVT }, Res);
    }
    let mut IntMaskVT: MVT = getIntegerVT(MaskEltSizeInBits);
    IntMaskVT = getVectorVT(IntMaskVT, NumMaskElts);
    if Subtarget()() && AllowIntDomain && RootSizeInBits == 128 {
        let mut BitLen: u64 = 0;
        let mut BitIdx: u64 = 0;
        if matchShuffleAsEXTRQ(IntMaskVT, V1, V2, BitLen, BitIdx, Zeroable) {
            if  {
                return SDValue {};
            }
            V1 = CanonicalizeShuffleInput.call(IntMaskVT, V1);
            Res = DAG;
            return DAG.getBitcast(EVT { RootVT }, Res);
        }
        if matchShuffleAsINSERTQ(IntMaskVT, V1, V2, BitLen, BitIdx) {
            if  {
                return SDValue {};
            }
            V1 = CanonicalizeShuffleInput.call(IntMaskVT, V1);
            V2 = CanonicalizeShuffleInput.call(IntMaskVT, V2);
            Res = DAG;
            return DAG.getBitcast(EVT { RootVT }, Res);
        }
    }
    if AllowIntDomain && MaskEltSizeInBits < 64 && Subtarget.hasAVX512() {
        if matchShuffleAsVTRUNC(ShuffleSrcVT, ShuffleVT, IntMaskVT, Zeroable, Subtarget) {
            let mut IsTRUNCATE: bool = ShuffleVT.getVectorNumElements() == ShuffleSrcVT.getVectorNumElements();
            let mut Opc: u32 = 0;
            if Depth == 0 && RootOpc == Opc {
                return SDValue {};
            }
            V1 = CanonicalizeShuffleInput.call(ShuffleSrcVT, V1);
            Res = DAG.getNode(Opc, DL, EVT { ShuffleVT }, V1);
            if ShuffleVT.getSizeInBits().operator unsigned long long() < RootSizeInBits {
                Res = widenSubVector(Res, true, Subtarget, DAG, DL, RootSizeInBits);
            }
            return DAG.getBitcast(EVT { RootVT }, Res);
        }
        if RootSizeInBits < 512 && ((RootVT.is256BitVector() && Subtarget.useAVX512Regs()) || (RootVT.is128BitVector() && Subtarget()())) && (MaskEltSizeInBits > 8 || Subtarget()()) && isSequentialOrUndefInRange(0, NumMaskElts, 0, 2) {
            if  {
                return SDValue {};
            }
            if VT1 == VT2 && VT1.getSizeInBits().operator unsigned long long() == RootSizeInBits {
                let mut WideVT: MVT = VT1.getDoubleNumVectorElementsVT();
                let mut Concat: SDValue = combineConcatVectorOps(DL, WideVT, void { V1, V2 }, DAG, Subtarget, Depth);
                if !Concat && V2.isUndef() {
                    Concat = DAG.getNode(CONCAT_VECTORS, DL, EVT { WideVT }, V1, V2);
                }
                if Concat {
                    Res = DAG.getBitcast(EVT { IntMaskVT.widenIntegerElementType() }, Concat);
                    Res = DAG.getNode(TRUNCATE, DL, EVT { IntMaskVT }, Res);
                    return DAG.getBitcast(EVT { RootVT }, Res);
                }
            }
        }
    }
    if Depth < 1 {
        return SDValue {};
    }
    let mut NumVariableMasks: i32 = count_if(Closure_136 {});
    let mut HasSlowVariableMask: bool = any_of(Closure_137 {});
    let mut VariableCrossLaneShuffleDepth: i32 = if Subtarget()() { 1 } else { 2 };
    let mut VariablePerLaneShuffleDepth: i32 = if Subtarget()() { 1 } else { 2 };
    AllowVariableCrossLaneMask &= (Depth >= VariableCrossLaneShuffleDepth) || NumVariableMasks;
    AllowVariablePerLaneMask &= (Depth >= VariablePerLaneShuffleDepth) || NumVariableMasks;
    let mut BWIVPERMV3ShuffleDepth: i32 = VariableCrossLaneShuffleDepth + 2 - NumVariableMasks;
    let mut AllowBWIVPERMV3: bool = (Depth >= BWIVPERMV3ShuffleDepth || HasSlowVariableMask);
    if  {
        AllowVariableCrossLaneMask = AllowVariablePerLaneMask = true;
    }
    let mut MaskContainsZeros: bool = isAnyZero();
    if is128BitLaneCrossingShuffleMask(MaskVT) {
        if UnaryShuffle && AllowVariableCrossLaneMask && !MaskContainsZeros {
            if Subtarget.hasAVX2() && (MaskVT == v8f32 || MaskVT == v8i32) {
                let mut VPermMask: SDValue = getConstVector(IntMaskVT, DAG, DL, true);
                Res = CanonicalizeShuffleInput.call(MaskVT, V1);
                Res = DAG;
                return DAG.getBitcast(EVT { RootVT }, Res);
            }
            if (Subtarget.hasAVX512() && (MaskVT == v8f64 || MaskVT == v8i64 || MaskVT == v16f32 || MaskVT == v16i32)) || (Subtarget()() && (MaskVT == v16i16 || MaskVT == v32i16)) || (Subtarget()() && (MaskVT == v32i8 || MaskVT == v64i8)) {
                V1 = CanonicalizeShuffleInput.call(MaskVT, V1);
                V2 = DAG.getUNDEF(EVT { MaskVT });
                Res = lowerShuffleWithPERMV(DL, MaskVT, V1, V2, Subtarget, DAG);
                return DAG.getBitcast(EVT { RootVT }, Res);
            }
        }
        if UnaryShuffle && AllowVariableCrossLaneMask && ((Subtarget.hasAVX512() && (MaskVT == v8f64 || MaskVT == v8i64 || MaskVT == v4f64 || MaskVT == v4i64 || MaskVT == v8f32 || MaskVT == v8i32 || MaskVT == v16f32 || MaskVT == v16i32)) || (Subtarget()() && AllowBWIVPERMV3 && (MaskVT == v16i16 || MaskVT == v32i16)) || (Subtarget()() && AllowBWIVPERMV3 && (MaskVT == v32i8 || MaskVT == v64i8))) {
            for let mut i: u32 = 0; i != NumMaskElts; i += 1 {
                if Mask()[i] == SM_SentinelZero {
                    Mask()[i] = NumMaskElts + i;
                }
            }
            V1 = CanonicalizeShuffleInput.call(MaskVT, V1);
            V2 = getZeroVector(MaskVT, Subtarget, DAG, DL);
            Res = lowerShuffleWithPERMV(DL, MaskVT, V1, V2, Subtarget, DAG);
            return DAG.getBitcast(EVT { RootVT }, Res);
        }
        if combineX86ShuffleChainWithExtract(RootOpc, RootVT, BaseMask, Depth, AllowVariableCrossLaneMask, AllowVariablePerLaneMask, IsMaskedShuffle, DAG, DL, Subtarget) {
            WideShuffle;
        } else {
            return WideShuffle;
        }
        if AllowVariableCrossLaneMask && !MaskContainsZeros && ((Subtarget.hasAVX512() && (MaskVT == v8f64 || MaskVT == v8i64 || MaskVT == v4f64 || MaskVT == v4i64 || MaskVT == v16f32 || MaskVT == v16i32 || MaskVT == v8f32 || MaskVT == v8i32)) || (Subtarget()() && AllowBWIVPERMV3 && (MaskVT == v16i16 || MaskVT == v32i16)) || (Subtarget()() && AllowBWIVPERMV3 && (MaskVT == v32i8 || MaskVT == v64i8))) {
            V1 = CanonicalizeShuffleInput.call(MaskVT, V1);
            V2 = CanonicalizeShuffleInput.call(MaskVT, V2);
            Res = lowerShuffleWithPERMV(DL, MaskVT, V1, V2, Subtarget, DAG);
            return DAG.getBitcast(EVT { RootVT }, Res);
        }
        return SDValue {};
    }
    if UnaryShuffle && MaskContainsZeros && AllowVariablePerLaneMask && isSequentialOrUndefOrZeroInRange(0, NumMaskElts, 0) && TLI.isTypeLegal {
        let mut Zero: APInt = getZero(MaskEltSizeInBits);
        let mut AllOnes: APInt = getAllOnes(MaskEltSizeInBits);
        let mut UndefElts: APInt = APInt { NumMaskElts, 0, false, false };
        let mut EltBits: SmallVector<APInt, 64> = zeroed();
        for let mut i: u32 = 0; i != NumMaskElts; i += 1 {
            let mut M: i32 = [i];
            if M == SM_SentinelUndef {
                UndefElts.setBit(i);
                continue;
            }
            if M == SM_SentinelZero {
                continue;
            }
            EltBits()[i] = AllOnes;
        }
        let mut BitMask: SDValue = getConstVector(UndefElts, MaskVT, DAG, DL);
        Res = CanonicalizeShuffleInput.call(MaskVT, V1);
        let mut AndOpcode: u32 = 0;
        Res = DAG.getNode(AndOpcode, DL, EVT { MaskVT }, Res, BitMask);
        return DAG.getBitcast(EVT { RootVT }, Res);
    }
    if UnaryShuffle && AllowVariablePerLaneMask && !MaskContainsZeros && ((MaskVT == v8f32 && Subtarget.hasAVX()) || (MaskVT == v16f32 && Subtarget.hasAVX512())) {
        let mut VPermIdx: SmallVector<SDValue, 16> = zeroed();
        let mut VPermMask: SDValue = DAG(IntMaskVT, DL);
        Res = CanonicalizeShuffleInput.call(MaskVT, V1);
        Res = DAG;
        return DAG.getBitcast(EVT { RootVT }, Res);
    }
    if AllowVariablePerLaneMask && Subtarget()() && (MaskVT == v2f64 || MaskVT == v4f64 || MaskVT == v4f32 || MaskVT == v8f32) {
        let mut NumLanes: u32 = MaskVT.getSizeInBits().operator unsigned long long() / 128;
        let mut NumEltsPerLane: u32 = NumMaskElts / NumLanes;
        let mut VPerm2Idx: SmallVector<int, 8> = zeroed();
        let mut M2ZImm: u32 = 0;
        V1 = CanonicalizeShuffleInput.call(MaskVT, V1);
        V2 = CanonicalizeShuffleInput.call(MaskVT, V2);
        let mut VPerm2MaskOp: SDValue = getConstVector(IntMaskVT, DAG, DL, true);
        Res = DAG;
        return DAG.getBitcast(EVT { RootVT }, Res);
    }
    if UnaryShuffle && AllowVariablePerLaneMask && ((RootVT.is128BitVector() && Subtarget.hasSSSE3()) || (RootVT.is256BitVector() && Subtarget.hasAVX2()) || (RootVT.is512BitVector() && Subtarget()())) {
        let mut PSHUFBMask: SmallVector<SDValue, 16> = zeroed();
        let mut NumBytes: i32 = RootVT.getSizeInBits().operator unsigned long long() / 8;
        let mut Ratio: i32 = NumBytes / NumMaskElts;
        for let mut i: i32 = 0; i < NumBytes; i += 1 {
            let mut M: i32 = [i / Ratio];
            if M == SM_SentinelUndef {
                PSHUFBMask()(DAG.getUNDEF(EVT { i8 }));
                continue;
            }
            if M == SM_SentinelZero {
                PSHUFBMask()(DAG.getConstant(128, DL, EVT { i8 }, false, false));
                continue;
            }
            M = Ratio * M + i % Ratio;
            assert!((M / 16) == (i / 16), "Lane crossing detected");
            PSHUFBMask()(DAG.getConstant(M, DL, EVT { i8 }, false, false));
        }
        let mut ByteVT: MVT = getVectorVT(MVT { SimpleTy: i8 }, NumBytes);
        Res = CanonicalizeShuffleInput.call(ByteVT, V1);
        let mut PSHUFBMaskOp: SDValue = DAG(ByteVT, DL);
        Res = DAG;
        return DAG.getBitcast(EVT { RootVT }, Res);
    }
    if AllowVariablePerLaneMask && RootVT.is128BitVector() && Subtarget()() {
        let mut VPPERMMask: SmallVector<SDValue, 16> = zeroed();
        let mut NumBytes: i32 = 16;
        let mut Ratio: i32 = NumBytes / NumMaskElts;
        for let mut i: i32 = 0; i < NumBytes; i += 1 {
            let mut M: i32 = [i / Ratio];
            if M == SM_SentinelUndef {
                VPPERMMask()(DAG.getUNDEF(EVT { i8 }));
                continue;
            }
            if M == SM_SentinelZero {
                VPPERMMask()(DAG.getConstant(128, DL, EVT { i8 }, false, false));
                continue;
            }
            M = Ratio * M + i % Ratio;
            VPPERMMask()(DAG.getConstant(M, DL, EVT { i8 }, false, false));
        }
        let mut ByteVT: MVT = MVT { SimpleTy: v16i8 };
        V1 = CanonicalizeShuffleInput.call(ByteVT, V1);
        V2 = CanonicalizeShuffleInput.call(ByteVT, V2);
        let mut VPPERMMaskOp: SDValue = DAG(ByteVT, DL);
        Res = DAG;
        return DAG.getBitcast(EVT { RootVT }, Res);
    }
    if combineX86ShuffleChainWithExtract(RootOpc, RootVT, BaseMask, Depth, AllowVariableCrossLaneMask, AllowVariablePerLaneMask, IsMaskedShuffle, DAG, DL, Subtarget) {
        WideShuffle;
    } else {
        return WideShuffle;
    }
    if !UnaryShuffle && AllowVariablePerLaneMask && !MaskContainsZeros && ((Subtarget.hasAVX512() && (MaskVT == v2f64 || MaskVT == v4f64 || MaskVT == v8f64 || MaskVT == v2i64 || MaskVT == v4i64 || MaskVT == v8i64 || MaskVT == v4f32 || MaskVT == v4i32 || MaskVT == v8f32 || MaskVT == v8i32 || MaskVT == v16f32 || MaskVT == v16i32)) || (Subtarget()() && AllowBWIVPERMV3 && (MaskVT == v8i16 || MaskVT == v16i16 || MaskVT == v32i16)) || (Subtarget()() && AllowBWIVPERMV3 && (MaskVT == v16i8 || MaskVT == v32i8 || MaskVT == v64i8))) {
        V1 = CanonicalizeShuffleInput.call(MaskVT, V1);
        V2 = CanonicalizeShuffleInput.call(MaskVT, V2);
        Res = lowerShuffleWithPERMV(DL, MaskVT, V1, V2, Subtarget, DAG);
        return DAG.getBitcast(EVT { RootVT }, Res);
    }
    return SDValue {};
}

fn combineX86ShuffleChainWithExtract(Inputs: ArrayRef<SDValue>, RootOpcode: u32, RootVT: MVT, BaseMask: ArrayRef<int>, Depth: i32, SrcNodes: ArrayRef<const SDNode *>, AllowVariableCrossLaneMask: bool, AllowVariablePerLaneMask: bool, IsMaskedShuffle: bool, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut NumMaskElts: u32 = BaseMask.len;
    let mut NumInputs: u32 = ();
    if NumInputs == 0 {
        return SDValue {};
    }
    let mut RootSizeInBits: u32 = RootVT.getSizeInBits().operator unsigned long long();
    let mut RootEltSizeInBits: u32 = RootSizeInBits / NumMaskElts;
    assert!((RootSizeInBits % NumMaskElts) == 0, "Unexpected root shuffle mask");
    let mut WideSizeInBits: u32 = RootSizeInBits;
    if WideSizeInBits <= RootSizeInBits || (WideSizeInBits % RootSizeInBits) != 0 {
        return SDValue {};
    }
    let mut WideMask: SmallVector<int, 64> = zeroed();
    growShuffleMask(BaseMask, RootSizeInBits, WideSizeInBits);
    let mut AdjustedMasks: i32 = 0;
    let mut WideInputs: SmallVector<SDValue, 4> = zeroed();
    for let mut I: u32 = 0; I != NumInputs; I += 1 {
        let mut Input: *mut SDValue = [I];
        Input = peekThroughBitcasts(Input);
        while 1 {
            if Input.getOpcode() == EXTRACT_SUBVECTOR && Input.getOperand(0).getValueSizeInBits().operator unsigned long long() <= WideSizeInBits {
                let mut Idx: u64 = Input.getConstantOperandVal(1);
                if Idx != 0 {
                    AdjustedMasks += 1;
                    let mut InputEltSizeInBits: u32 = Input.getScalarValueSizeInBits();
                    Idx = (Idx * InputEltSizeInBits) / RootEltSizeInBits;
                    let mut lo: i32 = I * ();
                    let mut hi: i32 = (I + 1) * ();
                }
                Input = peekThroughBitcasts(Input.getOperand(0));
                continue;
            }
            if Input.getOpcode() == INSERT_SUBVECTOR && Input.getOperand(0).isUndef() && isNullConstant(Input.getOperand(2)) {
                Input = peekThroughBitcasts(Input.getOperand(1));
                continue;
            }
            break;
        }
    }
    resolveTargetShuffleInputsAndMask();
    if WideInputs()() || all_of(Closure_138 { WideSizeInBits: WideSizeInBits }) {
        return SDValue {};
    }
    if AdjustedMasks == 0 || () > 2 {
        return SDValue {};
    }
    while WideMask()() > 1 {
        let mut WidenedMask: SmallVector<int, 64> = zeroed();
        if operator!(canWidenShuffleElements()) {
            break;
        }
        WideMask() = move();
    }
    if WideInputs()() == 2 && canonicalizeShuffleMaskWithCommute() {
        commuteMask();
        swap([0], [1]);
    }
    Depth += AdjustedMasks;
    let mut WideRoot: SDValue = if ()() > ()() { () } else { () };
    assert!(WideRoot.getValueSizeInBits().operator unsigned long long() == WideSizeInBits, "WideRootSize mismatch");
    if combineX86ShuffleChain(RootOpcode, WideRoot.getSimpleValueType(), Depth, AllowVariableCrossLaneMask, AllowVariablePerLaneMask, IsMaskedShuffle, DAG, SDLoc { WideRoot }, Subtarget) {
        WideShuffle;
    } else {
        WideShuffle = extractSubVector(WideShuffle, 0, DAG, DL, RootSizeInBits);
        return DAG.getBitcast(EVT { RootVT }, WideShuffle);
    }
    return SDValue {};
}

fn canonicalizeShuffleMaskWithHorizOp(Ops: MutableArrayRef<SDValue>, Mask: MutableArrayRef<int>, RootSizeInBits: u32, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if Mask.len == 0 || () {
        return SDValue {};
    }
    let mut BC: i32 = 0;
    let mut BC0: SDValue = [0];
    let mut VT0: EVT = BC0.getValueType();
    let mut Opcode0: u32 = BC0.getOpcode();
    if VT0.getSizeInBits().operator unsigned long long() != RootSizeInBits || any_of(Closure_139 { Opcode0: &mut Opcode0, VT0: &mut VT0 }) {
        return SDValue {};
    }
    let mut isHoriz: bool = false;
    let mut isPack: bool = false;
    if !isHoriz && !isPack {
        return SDValue {};
    }
    let mut OneUseOps: bool = all_of(Closure_140 {});
    let mut NumElts: i32 = VT0.getVectorNumElements();
    let mut NumLanes: i32 = VT0.getSizeInBits().operator unsigned long long() / 128;
    let mut NumEltsPerLane: i32 = NumElts / NumLanes;
    let mut NumHalfEltsPerLane: i32 = NumEltsPerLane / 2;
    let mut SrcVT: MVT = BC0.getOperand(0).getSimpleValueType();
    let mut EltSizeInBits: u32 = RootSizeInBits / Mask.len;
    if NumEltsPerLane >= 4 && (isPack || shouldUseHorizontalOp(() == 1, DAG, Subtarget)) {
        let mut LaneMask: i32 = 0;
        if isRepeatedTargetShuffleMask(128, EltSizeInBits, Mask) && scaleShuffleElements(4) {
            if isHoriz {
                let mut GetHOpSrc: Closure_141 = Closure_141 { DAG: &mut DAG, VT0: &mut VT0, Subtarget: &mut Subtarget, DL: &mut DL, Opcode0: &mut Opcode0 };
                let mut M0: SDValue = GetHOpSrc();
                let mut M1: SDValue = GetHOpSrc();
                let mut M2: SDValue = GetHOpSrc();
                let mut M3: SDValue = GetHOpSrc();
                if M0 && M1 && M2 && M3 {
                    let mut LHS: SDValue = DAG.getNode(Opcode0, DL, EVT { SrcVT }, M0, M1);
                    let mut RHS: SDValue = DAG.getNode(Opcode0, DL, EVT { SrcVT }, M2, M3);
                    return DAG.getNode(Opcode0, DL, VT0, LHS, RHS);
                }
            }
            if Ops()() >= 2 {
                let mut LHS: SDValue = SDValue {};
                let mut RHS: SDValue = SDValue {};
                let mut GetHOpSrc: Closure_142 = Closure_142 { LHS: &mut LHS, RHS: &mut RHS };
                let mut PostMask: [4]i32 = [-1, -1, -1, -1];
                if GetHOpSrc(PostMask[0]) && GetHOpSrc(PostMask[1]) && GetHOpSrc(PostMask[2]) && GetHOpSrc(PostMask[3]) {
                    LHS = DAG.getBitcast(EVT { SrcVT }, LHS);
                    RHS = DAG.getBitcast(EVT { SrcVT }, if RHS {} else { LHS });
                    let mut Res: SDValue = DAG.getNode(Opcode0, DL, VT0, LHS, RHS);
                    let mut ShuffleVT: MVT = getVectorVT(MVT { SimpleTy: f32 }, RootSizeInBits / 32);
                    Res = DAG.getBitcast(EVT { ShuffleVT }, Res);
                    return DAG;
                }
            }
        }
    }
    if 2 < () {
        return SDValue {};
    }
    let mut BC1: SDValue = [() - 1];
    if Mask.len == VT0.getVectorNumElements() {
        if Ops()() == 2 {
            let mut ContainsOps: Closure_143 = Closure_143 {};
            if ContainsOps.call(BC1, BC0.getOperand(0)) && ContainsOps.call(BC1, BC0.getOperand(1)) {
                commuteMask(Mask);
                swap([0], [1]);
                swap(BC0, BC1);
            }
            if ContainsOps.call(BC0, BC1.getOperand(0)) && ContainsOps.call(BC0, BC1.getOperand(1)) {
                for M in Mask {
                    if M < NumElts {
                        continue;
                    }
                    let mut SubLane: i32 = if ((M % NumEltsPerLane) >= NumHalfEltsPerLane) { 1 } else { 0 };
                    M -= NumElts + (SubLane * NumHalfEltsPerLane);
                    if BC1.getOperand(SubLane) != BC0.getOperand(0) {
                        M += NumHalfEltsPerLane;
                    }
                }
            }
        }
        for let mut i: i32 = 0; i != NumElts; i += 1 {
            let mut M: *mut i32 = Mask[i];
