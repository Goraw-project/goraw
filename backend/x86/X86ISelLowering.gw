unsafe fn Closure_90::call(self: *mut Closure_90, RepeatMask: *mut SmallVectorImpl<int>) -> bool {
                for let mut i: i32 = 0; i != (*self.NumElts); i += (*self.NumBroadcastElts) {
                    for let mut j: i32 = 0; j != (*self.NumBroadcastElts); j += 1 {
                        let mut M: i32 = (*self.Mask)[i + j];
                        if M < 0 {
                            continue;
                        }
                        let mut R: *mut i32 = RepeatMask[j];
                        if 0 != ((M % (*self.NumElts)) / (*self.NumLaneElts)) {
                            return false;
                        }
                        if 0 <= R && R != M {
                            return false;
                        }
                        R = M;
                    }
                }
                return true;
            }

