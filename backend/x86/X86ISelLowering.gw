static mut ExperimentalPrefInnermostLoopAlignment: opt<int> = opt<int> { "x86-experimental-pref-innermost-loop-alignment", init(4), "Sets the preferable loop alignment for experiments (as log2 bytes) for innermost loops only. If specified, this option overrides alignment set by x86-experimental-pref-loop-alignment.", Hidden };

static mut BrMergingBaseCostThresh: opt<int> = opt<int> { "x86-br-merging-base-cost", init(2), "Sets the cost threshold for when multiple conditionals will be merged into one branch versus be split in multiple branches. Merging conditionals saves branches at the cost of additional instructions. This value sets the instruction cost limit, below which conditionals will be merged, and above which conditionals will be split. Set to -1 to never merge branches.", Hidden };

static mut BrMergingCcmpBias: opt<int> = opt<int> { "x86-br-merging-ccmp-bias", init(6), "Increases 'x86-br-merging-base-cost' in cases that the target supports conditional compare instructions.", Hidden };

static mut WidenShift: opt<bool> = opt<bool> { "x86-widen-shift", init(true), "Replace narrow shifts with wider shifts.", Hidden };

static mut BrMergingLikelyBias: opt<int> = opt<int> { "x86-br-merging-likely-bias", init(0), "Increases 'x86-br-merging-base-cost' in cases that it is likely that all conditionals will be executed. For example for merging the conditionals (a == b && c > d), if its known that a == b is likely, then it is likely that if the conditionals are split both sides will be executed, so it may be desirable to increase the instruction cost threshold. Set to -1 to never merge likely branches.", Hidden };

static mut BrMergingUnlikelyBias: opt<int> = opt<int> { "x86-br-merging-unlikely-bias", init(-1), "Decreases 'x86-br-merging-base-cost' in cases that it is unlikely that all conditionals will be executed. For example for merging the conditionals (a == b && c > d), if its known that a == b is unlikely, then it is unlikely that if the conditionals are split both sides will be executed, so it may be desirable to decrease the instruction cost threshold. Set to -1 to never merge unlikely branches.", Hidden };

static mut MulConstantOptimization: opt<bool> = opt<bool> { "mul-constant-optimization", init(true), "Replace 'mul x, Const' with more effective instructions like SHIFT, LEA, etc.", Hidden };

fn X86TargetLowering::X86TargetLowering(self, TM: *X86TargetMachine, STI: *X86Subtarget) {
    let mut UseX87: bool = !self.Subtarget.useSoftFloat() && self.Subtarget.hasX87();
    let mut PtrVT: MVT = if self.Subtarget.isTarget64BitLP64() { i64 } else { i32 };
    self.setBooleanContents(ZeroOrOneBooleanContent);
    self.setBooleanVectorContents(ZeroOrNegativeOneBooleanContent);
    self.setOperationAction(CLEAR_CACHE, Other, Expand);
    if self.Subtarget.isAtom() {
        self.setSchedulingPreference(ILP);
    } else if self.Subtarget.is64Bit() {
        self.setSchedulingPreference(ILP);
    } else {
        self.setSchedulingPreference(RegPressure);
    }
    let mut RegInfo: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    self.setStackPointerRegisterToSaveRestore(RegInfo.getStackRegister());
    if TM.getOptLevel() >= Default {
        if self.Subtarget.hasSlowDivide32() {
            self.addBypassSlowDiv(32, 8);
        }
        if self.Subtarget.hasSlowDivide64() && self.Subtarget.is64Bit() {
            self.addBypassSlowDiv(64, 32);
        }
    }
    if self.Subtarget.canUseCMPXCHG16B() {
        self.setMaxAtomicSizeInBitsSupported(128);
    } else if self.Subtarget.canUseCMPXCHG8B() {
        self.setMaxAtomicSizeInBitsSupported(64);
    } else {
        self.setMaxAtomicSizeInBitsSupported(32);
    }
    self.setMaxDivRemBitWidthSupported(if self.Subtarget.is64Bit() { 128 } else { 64 });
    self.setMaxLargeFPConvertBitWidthSupported(128);
    self.addRegisterClass(i8, &mut GR8RegClass);
    self.addRegisterClass(i16, &mut GR16RegClass);
    self.addRegisterClass(i32, &mut GR32RegClass);
    if self.Subtarget.is64Bit() {
        self.addRegisterClass(i64, &mut GR64RegClass);
    }
    for VT in integer_valuetypes() {
        self.setLoadExtAction(SEXTLOAD, VT, i1, Promote);
    }
    self.setTruncStoreAction(i64, i32, Expand);
    self.setTruncStoreAction(i64, i16, Expand);
    self.setTruncStoreAction(i64, i8, Expand);
    self.setTruncStoreAction(i32, i16, Expand);
    self.setTruncStoreAction(i32, i8, Expand);
    self.setTruncStoreAction(i16, i8, Expand);
    self.setTruncStoreAction(f64, f32, Expand);
    for VT in [f32, f64, f80] {
        self.setCondCodeAction(SETOEQ, VT, Expand);
        self.setCondCodeAction(SETUNE, VT, Expand);
    }
    if self.Subtarget.canUseCMOV() {
        self.setOperationAction(ABS, i16, Custom);
        self.setOperationAction(ABS, i32, Custom);
        if self.Subtarget.is64Bit() {
            self.setOperationAction(ABS, i64, Custom);
        }
    }
    for Op in [ABDS, ABDU] {
        self.setOperationAction(Op, i8, Custom);
        self.setOperationAction(Op, i16, Custom);
        self.setOperationAction(Op, i32, Custom);
        if self.Subtarget.is64Bit() {
            self.setOperationAction(Op, i64, Custom);
        }
    }
    self.setOperationAction(SSUBSAT, i8, Custom);
    self.setOperationAction(SSUBSAT, i16, Custom);
    self.setOperationAction(SSUBSAT, i32, Custom);
    if self.Subtarget.is64Bit() {
        self.setOperationAction(SSUBSAT, i64, Custom);
    }
    for ShiftOp in [FSHL, FSHR] {
        let mut ShiftDoubleAction: LegalizeAction = if self.Subtarget.isSHLDSlow() { Custom } else { Legal };
        self.setOperationAction(ShiftOp, i8, Custom);
        self.setOperationAction(ShiftOp, i16, Custom);
        self.setOperationAction(ShiftOp, i32, ShiftDoubleAction);
        if self.Subtarget.is64Bit() {
            self.setOperationAction(ShiftOp, i64, ShiftDoubleAction);
        }
    }
    if !self.Subtarget.useSoftFloat() {
        self.setOperationAction(UINT_TO_FP, i8, Promote);
        self.setOperationAction(STRICT_UINT_TO_FP, i8, Promote);
        self.setOperationAction(UINT_TO_FP, i16, Promote);
        self.setOperationAction(STRICT_UINT_TO_FP, i16, Promote);
        self.setOperationAction(UINT_TO_FP, i32, Custom);
        self.setOperationAction(STRICT_UINT_TO_FP, i32, Custom);
        self.setOperationAction(UINT_TO_FP, i64, Custom);
        self.setOperationAction(STRICT_UINT_TO_FP, i64, Custom);
        self.setOperationAction(SINT_TO_FP, i8, Promote);
        self.setOperationAction(STRICT_SINT_TO_FP, i8, Promote);
        self.setOperationAction(SINT_TO_FP, i16, Custom);
        self.setOperationAction(STRICT_SINT_TO_FP, i16, Custom);
        self.setOperationAction(SINT_TO_FP, i32, Custom);
        self.setOperationAction(STRICT_SINT_TO_FP, i32, Custom);
        self.setOperationAction(SINT_TO_FP, i64, Custom);
        self.setOperationAction(STRICT_SINT_TO_FP, i64, Custom);
        self.setOperationAction(FP_TO_SINT, i8, Promote);
        self.setOperationAction(STRICT_FP_TO_SINT, i8, Promote);
        self.setOperationAction(FP_TO_SINT, i16, Custom);
        self.setOperationAction(STRICT_FP_TO_SINT, i16, Custom);
        self.setOperationAction(FP_TO_SINT, i32, Custom);
        self.setOperationAction(STRICT_FP_TO_SINT, i32, Custom);
        self.setOperationAction(FP_TO_SINT, i64, Custom);
        self.setOperationAction(STRICT_FP_TO_SINT, i64, Custom);
        self.setOperationAction(FP_TO_UINT, i8, Promote);
        self.setOperationAction(STRICT_FP_TO_UINT, i8, Promote);
        self.setOperationAction(FP_TO_UINT, i16, Promote);
        self.setOperationAction(STRICT_FP_TO_UINT, i16, Promote);
        self.setOperationAction(FP_TO_UINT, i32, Custom);
        self.setOperationAction(STRICT_FP_TO_UINT, i32, Custom);
        self.setOperationAction(FP_TO_UINT, i64, Custom);
        self.setOperationAction(STRICT_FP_TO_UINT, i64, Custom);
        self.setOperationAction(LRINT, f32, Custom);
        self.setOperationAction(LRINT, f64, Custom);
        self.setOperationAction(LLRINT, f32, Custom);
        self.setOperationAction(LLRINT, f64, Custom);
        if !self.Subtarget.is64Bit() && self.Subtarget.hasX87() {
            self.setOperationAction(LRINT, i64, Custom);
            self.setOperationAction(LLRINT, i64, Custom);
        }
    }
    self.setOperationAction(ADDRSPACECAST, i32, Custom);
    self.setOperationAction(ADDRSPACECAST, i64, Custom);
    if !self.Subtarget.hasSSE2() {
        self.setOperationAction(BITCAST, f32, Expand);
        self.setOperationAction(BITCAST, i32, Expand);
        if self.Subtarget.is64Bit() {
            self.setOperationAction(BITCAST, f64, Expand);
            self.setOperationAction(BITCAST, i64, Expand);
        }
    } else if !self.Subtarget.is64Bit() {
        self.setOperationAction(BITCAST, i64, Custom);
    }
    for VT in [i8, i16, i32, i64] {
        self.setOperationAction(MULHS, VT, Expand);
        self.setOperationAction(MULHU, VT, Expand);
        self.setOperationAction(SDIV, VT, Expand);
        self.setOperationAction(UDIV, VT, Expand);
        self.setOperationAction(SREM, VT, Expand);
        self.setOperationAction(UREM, VT, Expand);
    }
    self.setOperationAction(BR_JT, Other, Expand);
    self.setOperationAction(BRCOND, Other, Custom);
    for VT in [f32, f64, f80, f128, i8, i16, i32, i64] {
        self.setOperationAction(BR_CC, VT, Expand);
        self.setOperationAction(SELECT_CC, VT, Expand);
    }
    if self.Subtarget.is64Bit() {
        self.setOperationAction(SIGN_EXTEND_INREG, i32, Legal);
    }
    self.setOperationAction(SIGN_EXTEND_INREG, i16, Legal);
    self.setOperationAction(SIGN_EXTEND_INREG, i8, Legal);
    self.setOperationAction(SIGN_EXTEND_INREG, i1, Expand);
    self.setOperationAction(FREM, f32, LibCall);
    self.setOperationAction(FREM, f64, LibCall);
    self.setOperationAction(FREM, f80, LibCall);
    self.setOperationAction(FREM, f128, LibCall);
    if !self.Subtarget.useSoftFloat() && self.Subtarget.hasX87() {
        self.setOperationAction(GET_ROUNDING, i32, Custom);
        self.setOperationAction(SET_ROUNDING, Other, Custom);
        self.setOperationAction(GET_FPENV_MEM, Other, Custom);
        self.setOperationAction(SET_FPENV_MEM, Other, Custom);
        self.setOperationAction(RESET_FPENV, Other, Custom);
    }
    self.setOperationPromotedToType(CTTZ, i8, i32);
    self.setOperationPromotedToType(CTTZ_ZERO_POISON, i8, i32);
    self.setOperationPromotedToType(CTTZ, i16, i32);
    self.setOperationPromotedToType(CTTZ_ZERO_POISON, i16, i32);
    if !self.Subtarget.hasBMI() {
        self.setOperationAction(CTTZ, i32, Custom);
        self.setOperationAction(CTTZ_ZERO_POISON, i32, Legal);
        if self.Subtarget.is64Bit() {
            self.setOperationAction(CTTZ, i64, Custom);
            self.setOperationAction(CTTZ_ZERO_POISON, i64, Legal);
        }
    }
    if self.Subtarget.hasLZCNT() {
        self.setOperationPromotedToType(CTLZ, i8, i32);
        self.setOperationPromotedToType(CTLZ_ZERO_POISON, i8, i32);
    } else {
        for VT in [i8, i16, i32, i64] {
            if VT == i64 && !self.Subtarget.is64Bit() {
                continue;
            }
            self.setOperationAction(CTLZ, VT, Custom);
            self.setOperationAction(CTLZ_ZERO_POISON, VT, Custom);
        }
    }
    for Op in [FP16_TO_FP, STRICT_FP16_TO_FP, FP_TO_FP16, STRICT_FP_TO_FP16] {
        self.setOperationAction(Op, f32, if (!self.Subtarget.useSoftFloat() && self.Subtarget.hasF16C()) { Custom } else { Expand });
        self.setOperationAction(Op, f64, Expand);
        self.setOperationAction(Op, f80, Expand);
        self.setOperationAction(Op, f128, Expand);
    }
    for VT in [f32, f64, f80, f128] {
        self.setOperationAction(STRICT_FP_TO_BF16, VT, Expand);
        self.setOperationAction(STRICT_BF16_TO_FP, VT, Expand);
    }
    for VT in [f32, f64, f80, f128] {
        self.setLoadExtAction(EXTLOAD, VT, f16, Expand);
        self.setLoadExtAction(EXTLOAD, VT, bf16, Expand);
        self.setTruncStoreAction(VT, f16, Expand);
        self.setTruncStoreAction(VT, bf16, Expand);
        self.setOperationAction(BF16_TO_FP, VT, Expand);
        self.setOperationAction(FP_TO_BF16, VT, Custom);
    }
    self.setOperationAction(PARITY, i8, Custom);
    self.setOperationAction(PARITY, i16, Custom);
    self.setOperationAction(PARITY, i32, Custom);
    if self.Subtarget.is64Bit() {
        self.setOperationAction(PARITY, i64, Custom);
    }
    if self.Subtarget.hasPOPCNT() {
        self.setOperationPromotedToType(CTPOP, i8, i32);
        self.setOperationPromotedToType(CTPOP, i16, i32);
    } else {
        self.setOperationAction(CTPOP, i8, Custom);
        self.setOperationAction(CTPOP, i16, Custom);
        self.setOperationAction(CTPOP, i32, Custom);
        self.setOperationAction(CTPOP, i64, Custom);
    }
    if self.Subtarget.hasBMI2() {
        let mut SlowPDEP: bool = self.Subtarget.isPDEPSlow();
        let mut SlowPEXT: bool = self.Subtarget.isPEXTSlow();
        self.setOperationAction([PEXT, PDEP], i8, Promote);
        self.setOperationAction([PEXT, PDEP], i16, Promote);
        self.setOperationAction(PDEP, i32, if SlowPDEP { Custom } else { Legal });
        self.setOperationAction(PEXT, i32, if SlowPEXT { Custom } else { Legal });
        if self.Subtarget.is64Bit() {
            self.setOperationAction(PDEP, i64, if SlowPDEP { Custom } else { Legal });
            self.setOperationAction(PEXT, i64, if SlowPEXT { Custom } else { Legal });
        }
    }
    self.setOperationAction(READCYCLECOUNTER, i64, Custom);
    if !self.Subtarget.hasMOVBE() {
        self.setOperationAction(BSWAP, i16, Expand);
    }
    for VT in [f32, f64, f80, f128] {
        self.setOperationAction(SELECT, VT, Custom);
        self.setOperationAction(SETCC, VT, Custom);
        self.setOperationAction(STRICT_FSETCC, VT, Custom);
        self.setOperationAction(STRICT_FSETCCS, VT, Custom);
    }
    for VT in [i8, i16, i32, i64] {
        if VT == i64 && !self.Subtarget.is64Bit() {
            continue;
        }
        self.setOperationAction(SELECT, VT, Custom);
        self.setOperationAction(SETCC, VT, Custom);
    }
    self.setOperationAction(COND_LOOP, Other, Custom);
    self.setOperationAction(SELECT, x86mmx, Custom);
    self.setOperationAction(SELECT_CC, x86mmx, Expand);
    self.setOperationAction(EH_RETURN, Other, Custom);
    self.setOperationAction(EH_SJLJ_SETJMP, i32, Custom);
    self.setOperationAction(EH_SJLJ_LONGJMP, Other, Custom);
    self.setOperationAction(EH_SJLJ_SETUP_DISPATCH, Other, Custom);
    for VT in [i32, i64] {
        if VT == i64 && !self.Subtarget.is64Bit() {
            continue;
        }
        self.setOperationAction(ConstantPool, VT, Custom);
        self.setOperationAction(JumpTable, VT, Custom);
        self.setOperationAction(GlobalAddress, VT, Custom);
        self.setOperationAction(GlobalTLSAddress, VT, Custom);
        self.setOperationAction(ExternalSymbol, VT, Custom);
        self.setOperationAction(BlockAddress, VT, Custom);
    }
    for VT in [i32, i64] {
        if VT == i64 && !self.Subtarget.is64Bit() {
            continue;
        }
        self.setOperationAction(SHL_PARTS, VT, Custom);
        self.setOperationAction(SRA_PARTS, VT, Custom);
        self.setOperationAction(SRL_PARTS, VT, Custom);
    }
    if self.Subtarget.hasSSEPrefetch() {
        self.setOperationAction(PREFETCH, Other, Custom);
    }
    self.setOperationAction(ATOMIC_FENCE, Other, Custom);
    for VT in [i8, i16, i32, i64] {
        self.setOperationAction(ATOMIC_CMP_SWAP_WITH_SUCCESS, VT, Custom);
        self.setOperationAction(ATOMIC_LOAD_SUB, VT, Custom);
        self.setOperationAction(ATOMIC_LOAD_ADD, VT, Custom);
        self.setOperationAction(ATOMIC_LOAD_OR, VT, Custom);
        self.setOperationAction(ATOMIC_LOAD_XOR, VT, Custom);
        self.setOperationAction(ATOMIC_LOAD_AND, VT, Custom);
        self.setOperationAction(ATOMIC_STORE, VT, Custom);
    }
    if !self.Subtarget.is64Bit() {
        self.setOperationAction(ATOMIC_LOAD, i64, Custom);
    }
    if self.Subtarget.is64Bit() && self.Subtarget.hasAVX() {
        self.setOperationAction(ATOMIC_LOAD, i128, Custom);
        self.setOperationAction(ATOMIC_STORE, i128, Custom);
    }
    if self.Subtarget.canUseCMPXCHG16B() {
        self.setOperationAction(ATOMIC_CMP_SWAP_WITH_SUCCESS, i128, Custom);
    }
    self.setOperationAction(FRAME_TO_ARGS_OFFSET, i32, Custom);
    self.setOperationAction(FRAME_TO_ARGS_OFFSET, i64, Custom);
    self.setOperationAction(INIT_TRAMPOLINE, Other, Custom);
    self.setOperationAction(ADJUST_TRAMPOLINE, Other, Custom);
    self.setOperationAction(TRAP, Other, Legal);
    self.setOperationAction(DEBUGTRAP, Other, Legal);
    if self.Subtarget.isTargetPS() {
        self.setOperationAction(UBSANTRAP, Other, Expand);
    } else {
        self.setOperationAction(UBSANTRAP, Other, Legal);
    }
    self.setOperationAction(VASTART, Other, Custom);
    self.setOperationAction(VAEND, Other, Expand);
    let mut Is64Bit: bool = self.Subtarget.is64Bit();
    self.setOperationAction(VAARG, Other, if Is64Bit { Custom } else { Expand });
    self.setOperationAction(VACOPY, Other, if Is64Bit { Custom } else { Expand });
    self.setOperationAction(STACKSAVE, Other, Expand);
    self.setOperationAction(STACKRESTORE, Other, Expand);
    self.setOperationAction(DYNAMIC_STACKALLOC, PtrVT, Custom);
    self.setOperationAction(GC_TRANSITION_START, Other, Custom);
    self.setOperationAction(GC_TRANSITION_END, Other, Custom);
    self.setOperationAction(STRICT_FP_EXTEND, f64, Legal);
    let mut setF16Action: Closure_1 = Closure_1 { cap_0: self };
    if !self.Subtarget.useSoftFloat() && self.Subtarget.hasSSE2() {
        self.addRegisterClass(f16, if self.Subtarget.hasAVX512() { &mut FR16XRegClass } else { &mut FR16RegClass });
        self.addRegisterClass(f32, if self.Subtarget.hasAVX512() { &mut FR32XRegClass } else { &mut FR32RegClass });
        self.addRegisterClass(f64, if self.Subtarget.hasAVX512() { &mut FR64XRegClass } else { &mut FR64RegClass });
        self.setLoadExtAction(EXTLOAD, f64, f32, Expand);
        for VT in [f32, f64] {
            self.setOperationAction(FABS, VT, Custom);
            self.setOperationAction(FNEG, VT, Custom);
            self.setOperationAction(FCOPYSIGN, VT, Custom);
            self.setOperationAction(FADD, VT, Custom);
            self.setOperationAction(FSUB, VT, Custom);
            self.setOperationAction(FSIN, VT, Expand);
            self.setOperationAction(FCOS, VT, Expand);
            self.setOperationAction(FSINCOS, VT, Expand);
        }
        setF16Action.call(f16, Promote);
        self.setOperationAction(FADD, f16, Promote);
        self.setOperationAction(FSUB, f16, Promote);
        self.setOperationAction(FMUL, f16, Promote);
        self.setOperationAction(FDIV, f16, Promote);
        self.setOperationAction(FABS, f16, Custom);
        self.setOperationAction(FNEG, f16, Custom);
        self.setOperationAction(FCOPYSIGN, f16, Custom);
        self.setOperationAction(FP_ROUND, f16, Custom);
        self.setOperationAction(FP_EXTEND, f32, Custom);
        self.setOperationAction(FP_EXTEND, f64, Custom);
        self.setOperationAction(STRICT_FADD, f16, Promote);
        self.setOperationAction(STRICT_FSUB, f16, Promote);
        self.setOperationAction(STRICT_FMUL, f16, Promote);
        self.setOperationAction(STRICT_FDIV, f16, Promote);
        self.setOperationAction(STRICT_FMA, f16, Promote);
        self.setOperationAction(STRICT_FMINNUM, f16, Promote);
        self.setOperationAction(STRICT_FMAXNUM, f16, Promote);
        self.setOperationAction(STRICT_FMINIMUM, f16, Promote);
        self.setOperationAction(STRICT_FMAXIMUM, f16, Promote);
        self.setOperationAction(STRICT_FSQRT, f16, Promote);
        self.setOperationAction(STRICT_FPOW, f16, Promote);
        self.setOperationAction(STRICT_FLDEXP, f16, Promote);
        self.setOperationAction(STRICT_FLOG, f16, Promote);
        self.setOperationAction(STRICT_FLOG2, f16, Promote);
        self.setOperationAction(STRICT_FLOG10, f16, Promote);
        self.setOperationAction(STRICT_FEXP, f16, Promote);
        self.setOperationAction(STRICT_FEXP2, f16, Promote);
        self.setOperationAction(STRICT_FCEIL, f16, Promote);
        self.setOperationAction(STRICT_FFLOOR, f16, Promote);
        self.setOperationAction(STRICT_FNEARBYINT, f16, Promote);
        self.setOperationAction(STRICT_FRINT, f16, Promote);
        self.setOperationAction(STRICT_FSETCC, f16, Promote);
        self.setOperationAction(STRICT_FSETCCS, f16, Promote);
        self.setOperationAction(STRICT_FROUND, f16, Promote);
        self.setOperationAction(STRICT_FROUNDEVEN, f16, Promote);
        self.setOperationAction(STRICT_FTRUNC, f16, Promote);
        self.setOperationAction(STRICT_FP_ROUND, f16, Custom);
        self.setOperationAction(STRICT_FP_EXTEND, f32, Custom);
        self.setOperationAction(STRICT_FP_EXTEND, f64, Custom);
        self.setOperationAction(LLROUND, f16, Expand);
        self.setOperationAction(LROUND, f16, Expand);
        self.setOperationAction(LRINT, f16, Expand);
        self.setOperationAction(LLRINT, f16, Expand);
        self.setOperationAction(STRICT_LLROUND, f16, Promote);
        self.setOperationAction(STRICT_LROUND, f16, Promote);
        self.setOperationAction(STRICT_LRINT, f16, Promote);
        self.setOperationAction(STRICT_LLRINT, f16, Promote);
        self.setOperationAction(BF16_TO_FP, f32, Custom);
        self.setOperationAction(BF16_TO_FP, f64, Custom);
        self.setOperationAction(FGETSIGN, i64, Custom);
        self.setOperationAction(FGETSIGN, i32, Custom);
    } else if !self.Subtarget.useSoftFloat() && self.Subtarget.hasSSE1() && (UseX87 || Is64Bit) {
        self.addRegisterClass(f32, &mut FR32RegClass);
        if UseX87 {
            self.addRegisterClass(f64, &mut RFP64RegClass);
        }
        self.setOperationAction(FABS, f32, Custom);
        self.setOperationAction(FNEG, f32, Custom);
        if UseX87 {
            self.setOperationAction([UNDEF, POISON], f64, Expand);
        }
        if UseX87 {
            self.setOperationAction(FCOPYSIGN, f64, Expand);
        }
        self.setOperationAction(FCOPYSIGN, f32, Custom);
        self.setOperationAction(FSIN, f32, Expand);
        self.setOperationAction(FCOS, f32, Expand);
        self.setOperationAction(FSINCOS, f32, Expand);
        if UseX87 {
            self.setOperationAction(FSIN, f64, Expand);
            self.setOperationAction(FCOS, f64, Expand);
            self.setOperationAction(FSINCOS, f64, Expand);
        }
    } else if UseX87 {
        self.addRegisterClass(f64, &mut RFP64RegClass);
        self.addRegisterClass(f32, &mut RFP32RegClass);
        for VT in [f32, f64] {
            self.setOperationAction([UNDEF, POISON], VT, Expand);
            self.setOperationAction(FCOPYSIGN, VT, Expand);
            self.setOperationAction(FSIN, VT, Expand);
            self.setOperationAction(FCOS, VT, Expand);
            self.setOperationAction(FSINCOS, VT, Expand);
        }
    }
    if self.isTypeLegal(f32) {
        if UseX87 && (self.getRegClassFor(f32, false) == &mut RFP32RegClass) {
            self.addLegalFPImmediate(0.0);
            self.addLegalFPImmediate(1.0);
            self.addLegalFPImmediate(-0.0);
            self.addLegalFPImmediate(-1.0);
        } else {
