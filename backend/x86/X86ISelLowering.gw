fn X86TargetLowering::shouldExpandAtomicRMWInIR(self: *X86TargetLowering, AI: *AtomicRMWInst) -> AtomicExpansionKind {
    let mut NativeWidth: u32 = if self.Subtarget() { 64 } else { 32 };
    let mut MemType: *mut Type = AI.getType();
    if MemType.getPrimitiveSizeInBits().operator unsigned long long() > NativeWidth {
        return if self.needsCmpXchgNb(MemType) { CmpXChg } else { None };
