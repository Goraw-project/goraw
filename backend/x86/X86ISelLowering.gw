fn lowerShuffleAsByteRotateAndPermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if (VT.is128BitVector() && !Subtarget.hasSSSE3()) || (VT.is256BitVector() && !Subtarget.hasAVX2()) || (VT.is512BitVector() && operator!(Subtarget()())) {
