        for let mut Lane: i32 = 0; Lane != (*self.NumElts); Lane += (*self.NumEltsPerLane) {
            for let mut Elt: i32 = 0; Elt != (*self.NumEltsPerLane); Elt += 1 {
                let mut M: i32 = (*self.Mask)[Lane + Elt];
                if M < 0 {
                    continue;
                }
                if M < (*self.NumElts) {
                    PermMask[Lane + Elt] = Lane + ((M + Ofs - RotAmt) % (*self.NumEltsPerLane));
                } else {
                    PermMask[Lane + Elt] = Lane + ((M - Ofs - RotAmt) % (*self.NumEltsPerLane));
                }
            }
