        let mut Rot: SDValue = DAG.getNode(OR, DL, EVT { RotateVT }, SHL, SRL);
        return DAG.getBitcast(EVT { VT }, Rot);
    }
    let mut Rot: SDValue = DAG;
    return DAG.getBitcast(EVT { VT }, Rot);
}

fn matchShuffleAsElementRotate(V1: *mut SDValue, V2: *mut SDValue, Mask: ArrayRef<int>) -> i32 {
