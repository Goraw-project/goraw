    }
    if AllowVariablePerLaneMask && RootVT.is128BitVector() && Subtarget.hasXOP() {
        let mut VPPERMMask: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        let mut NumBytes: i32 = 16;
        let mut Ratio: i32 = NumBytes / NumMaskElts;
        for let mut i: i32 = 0; i < NumBytes; i += 1 {
            let mut M: i32 = Mask[i / Ratio];
            if M == SM_SentinelUndef {
                VPPERMMask.push(DAG.getUNDEF(i8));
                continue;
            }
            if M == SM_SentinelZero {
                VPPERMMask.push(DAG.getConstant(128, DL, i8, false, false));
                continue;
            }
            M = Ratio * M + i % Ratio;
            VPPERMMask.push(DAG.getConstant(M, DL, i8, false, false));
        }
        let mut ByteVT: MVT = v16i8;
        V1 = CanonicalizeShuffleInput.call(ByteVT, V1);
        V2 = CanonicalizeShuffleInput.call(ByteVT, V2);
        let mut VPPERMMaskOp: SDValue = DAG.getBuildVector(ByteVT, DL, VPPERMMask);
        Res = DAG.getNode(VPPERM, DL, ByteVT, V1, V2, VPPERMMaskOp);
        return DAG.getBitcast(RootVT, Res);
    }
    if combineX86ShuffleChainWithExtract(Inputs, RootOpc, RootVT, BaseMask, Depth, SrcNodes, AllowVariableCrossLaneMask, AllowVariablePerLaneMask, IsMaskedShuffle, DAG, DL, Subtarget) {
        WideShuffle;
    } else {
        return WideShuffle;
    }
    if !UnaryShuffle && AllowVariablePerLaneMask && !MaskContainsZeros && ((Subtarget.hasAVX512() && (MaskVT == v2f64 || MaskVT == v4f64 || MaskVT == v8f64 || MaskVT == v2i64 || MaskVT == v4i64 || MaskVT == v8i64 || MaskVT == v4f32 || MaskVT == v4i32 || MaskVT == v8f32 || MaskVT == v8i32 || MaskVT == v16f32 || MaskVT == v16i32)) || (Subtarget.hasBWI() && AllowBWIVPERMV3 && (MaskVT == v8i16 || MaskVT == v16i16 || MaskVT == v32i16)) || (Subtarget.hasVBMI() && AllowBWIVPERMV3 && (MaskVT == v16i8 || MaskVT == v32i8 || MaskVT == v64i8))) {
        V1 = CanonicalizeShuffleInput.call(MaskVT, V1);
        V2 = CanonicalizeShuffleInput.call(MaskVT, V2);
        Res = lowerShuffleWithPERMV(DL, MaskVT, Mask, V1, V2, Subtarget, DAG);
        return DAG.getBitcast(RootVT, Res);
    }
    return SDValue {};
}

fn combineX86ShuffleChainWithExtract(Inputs: ArrayRef<SDValue>, RootOpcode: u32, RootVT: MVT, BaseMask: ArrayRef<int>, Depth: i32, SrcNodes: ArrayRef<const SDNode *>, AllowVariableCrossLaneMask: bool, AllowVariablePerLaneMask: bool, IsMaskedShuffle: bool, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut NumMaskElts: u32 = BaseMask.len;
    let mut NumInputs: u32 = Inputs.len;
    if NumInputs == 0 {
        return SDValue {};
    }
    let mut RootSizeInBits: u32 = RootVT.getSizeInBits().operator unsigned long long();
    let mut RootEltSizeInBits: u32 = RootSizeInBits / NumMaskElts;
    assert!((RootSizeInBits % NumMaskElts) == 0, "Unexpected root shuffle mask");
    let mut WideSizeInBits: u32 = RootSizeInBits;
    for Input in Inputs {
        Input = peekThroughBitcasts(Input);
        while 1 {
            if Input.getOpcode() == EXTRACT_SUBVECTOR {
                Input = peekThroughBitcasts(Input.getOperand(0));
                continue;
            }
            if Input.getOpcode() == INSERT_SUBVECTOR && Input.getOperand(0).isUndef() && isNullConstant(Input.getOperand(2)) {
                Input = peekThroughBitcasts(Input.getOperand(1));
                continue;
            }
            break;
        }
        if DAG.getTargetLoweringInfo().isTypeLegal(Input.getValueType()) && WideSizeInBits < Input.getValueSizeInBits().operator unsigned long long() {
            WideSizeInBits = Input.getValueSizeInBits().operator unsigned long long();
        }
    }
    if WideSizeInBits <= RootSizeInBits || (WideSizeInBits % RootSizeInBits) != 0 {
        return SDValue {};
    }
    let mut WideMask: SmallVector<int, 64> = SmallVector<int, 64> {};
    growShuffleMask(BaseMask, WideMask, RootSizeInBits, WideSizeInBits);
    let mut AdjustedMasks: i32 = 0;
    let mut WideInputs: SmallVector<SDValue, 4> = Inputs;
    for let mut I: u32 = 0; I != NumInputs; I += 1 {
        let mut Input: *mut SDValue = WideInputs[I];
        Input = peekThroughBitcasts(Input);
        while 1 {
            if Input.getOpcode() == EXTRACT_SUBVECTOR && Input.getOperand(0).getValueSizeInBits().operator unsigned long long() <= WideSizeInBits {
                let mut Idx: u64 = Input.getConstantOperandVal(1);
                if Idx != 0 {
                    AdjustedMasks += 1;
                    let mut InputEltSizeInBits: u32 = Input.getScalarValueSizeInBits();
                    Idx = (Idx * InputEltSizeInBits) / RootEltSizeInBits;
                    let mut lo: i32 = I * WideMask.len;
                    let mut hi: i32 = (I + 1) * WideMask.len;
                    for M in WideMask {
                        if lo <= M && M < hi {
                            M += Idx;
                        }
                    }
                }
                Input = peekThroughBitcasts(Input.getOperand(0));
                continue;
            }
            if Input.getOpcode() == INSERT_SUBVECTOR && Input.getOperand(0).isUndef() && isNullConstant(Input.getOperand(2)) {
                Input = peekThroughBitcasts(Input.getOperand(1));
                continue;
            }
            break;
        }
    }
    resolveTargetShuffleInputsAndMask(WideInputs, WideMask);
    if WideInputs.is_empty() || all_of(WideInputs, Closure_145 { WideSizeInBits: WideSizeInBits }) {
        return SDValue {};
    }
    if AdjustedMasks == 0 || WideInputs.len > 2 {
        return SDValue {};
    }
    while WideMask.len > 1 {
        let mut WidenedMask: SmallVector<int, 64> = SmallVector<int, 64> {};
        if !canWidenShuffleElements(WideMask, WidenedMask) {
            break;
        }
        WideMask = move(WidenedMask);
    }
    if WideInputs.len == 2 && canonicalizeShuffleMaskWithCommute(WideMask) {
        commuteMask(WideMask);
        swap(WideInputs[0], WideInputs[1]);
    }
    Depth += AdjustedMasks;
    let mut WideRoot: SDValue = if WideInputs.front().getValueSizeInBits().operator unsigned long long() > WideInputs.back().getValueSizeInBits().operator unsigned long long() { WideInputs.front() } else { WideInputs.back() };
    assert!(WideRoot.getValueSizeInBits().operator unsigned long long() == WideSizeInBits, "WideRootSize mismatch");
    if combineX86ShuffleChain(WideInputs, RootOpcode, WideRoot.getSimpleValueType(), WideMask, Depth, SrcNodes, AllowVariableCrossLaneMask, AllowVariablePerLaneMask, IsMaskedShuffle, DAG, WideRoot, Subtarget) {
        WideShuffle;
    } else {
        WideShuffle = extractSubVector(WideShuffle, 0, DAG, DL, RootSizeInBits);
        return DAG.getBitcast(RootVT, WideShuffle);
    }
    return SDValue {};
}

fn canonicalizeShuffleMaskWithHorizOp(Ops: MutableArrayRef<SDValue>, Mask: MutableArrayRef<int>, RootSizeInBits: u32, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if Mask.is_empty() || Ops.is_empty() {
        return SDValue {};
    }
    let mut BC: SmallVector<SDValue> = SmallVector<SDValue> {};
    for Op in Ops {
        BC.push(peekThroughBitcasts(Op));
    }
    let mut BC0: SDValue = BC[0];
    let mut VT0: EVT = BC0.getValueType();
    let mut Opcode0: u32 = BC0.getOpcode();
    if VT0.getSizeInBits().operator unsigned long long() != RootSizeInBits || any_of(BC, Closure_146 { Opcode0: &mut Opcode0, VT0: &mut VT0 }) {
        return SDValue {};
    }
    let mut isHoriz: bool = (Opcode0 == FHADD || Opcode0 == FHSUB || Opcode0 == HADD || Opcode0 == HSUB || Opcode0 == HADDS || Opcode0 == HSUBS);
    let mut isPack: bool = (Opcode0 == PACKSS || Opcode0 == PACKUS);
    if !isHoriz && !isPack {
        return SDValue {};
    }
    let mut OneUseOps: bool = all_of(Ops, Closure_147 {});
    let mut NumElts: i32 = VT0.getVectorNumElements();
    let mut NumLanes: i32 = VT0.getSizeInBits().operator unsigned long long() / 128;
    let mut NumEltsPerLane: i32 = NumElts / NumLanes;
    let mut NumHalfEltsPerLane: i32 = NumEltsPerLane / 2;
    let mut SrcVT: MVT = BC0.getOperand(0).getSimpleValueType();
    let mut EltSizeInBits: u32 = RootSizeInBits / Mask.len;
    if NumEltsPerLane >= 4 && (isPack || shouldUseHorizontalOp(Ops.len == 1, DAG, Subtarget)) {
        let mut LaneMask: SmallVector<int> = SmallVector<int> {};
        let mut ScaledMask: SmallVector<int> = SmallVector<int> {};
        if isRepeatedTargetShuffleMask(128, EltSizeInBits, Mask, LaneMask) && scaleShuffleElements(LaneMask, 4, ScaledMask) {
            if isHoriz {
                let mut GetHOpSrc: Closure_148 = Closure_148 { DAG: &mut DAG, VT0: &mut VT0, Subtarget: &mut Subtarget, DL: &mut DL, BC: &mut BC, Opcode0: &mut Opcode0 };
                let mut M0: SDValue = GetHOpSrc.call(ScaledMask[0]);
                let mut M1: SDValue = GetHOpSrc.call(ScaledMask[1]);
                let mut M2: SDValue = GetHOpSrc.call(ScaledMask[2]);
                let mut M3: SDValue = GetHOpSrc.call(ScaledMask[3]);
                if M0 && M1 && M2 && M3 {
                    let mut LHS: SDValue = DAG.getNode(Opcode0, DL, SrcVT, M0, M1);
                    let mut RHS: SDValue = DAG.getNode(Opcode0, DL, SrcVT, M2, M3);
                    return DAG.getNode(Opcode0, DL, VT0, LHS, RHS);
                }
            }
            if Ops.len >= 2 {
                let mut LHS: SDValue = SDValue {};
                let mut RHS: SDValue = SDValue {};
                let mut GetHOpSrc: Closure_149 = Closure_149 { BC: &mut BC, LHS: &mut LHS, RHS: &mut RHS };
                let mut PostMask: [4]i32 = [-1, -1, -1, -1];
                if GetHOpSrc.call(ScaledMask[0], PostMask[0]) && GetHOpSrc.call(ScaledMask[1], PostMask[1]) && GetHOpSrc.call(ScaledMask[2], PostMask[2]) && GetHOpSrc.call(ScaledMask[3], PostMask[3]) {
                    LHS = DAG.getBitcast(SrcVT, LHS);
                    RHS = DAG.getBitcast(SrcVT, if RHS { RHS } else { LHS });
                    let mut Res: SDValue = DAG.getNode(Opcode0, DL, VT0, LHS, RHS);
                    let mut ShuffleVT: MVT = getVectorVT(f32, RootSizeInBits / 32);
                    Res = DAG.getBitcast(ShuffleVT, Res);
                    return DAG.getNode(SHUFP, DL, ShuffleVT, Res, Res, getV4X86ShuffleImm8ForMask(PostMask, DL, DAG));
                }
            }
        }
    }
    if 2 < Ops.len {
        return SDValue {};
    }
    let mut BC1: SDValue = BC[BC.len - 1];
    if Mask.len == VT0.getVectorNumElements() {
        if Ops.len == 2 {
            let mut ContainsOps: Closure_150 = Closure_150 {};
            if ContainsOps.call(BC1, BC0.getOperand(0)) && ContainsOps.call(BC1, BC0.getOperand(1)) {
                commuteMask(Mask);
                swap(Ops[0], Ops[1]);
                swap(BC0, BC1);
            }
            if ContainsOps.call(BC0, BC1.getOperand(0)) && ContainsOps.call(BC0, BC1.getOperand(1)) {
                for M in Mask {
                    if M < NumElts {
                        continue;
                    }
                    let mut SubLane: i32 = if ((M % NumEltsPerLane) >= NumHalfEltsPerLane) { 1 } else { 0 };
                    M -= NumElts + (SubLane * NumHalfEltsPerLane);
                    if BC1.getOperand(SubLane) != BC0.getOperand(0) {
                        M += NumHalfEltsPerLane;
                    }
                }
            }
        }
        for let mut i: i32 = 0; i != NumElts; i += 1 {
            let mut M: *mut i32 = Mask[i];
            if isUndefOrZero(M) {
                continue;
            }
            if M < NumElts && BC0.getOperand(0) == BC0.getOperand(1) && (M % NumEltsPerLane) >= NumHalfEltsPerLane {
                M -= NumHalfEltsPerLane;
            }
            if NumElts <= M && BC1.getOperand(0) == BC1.getOperand(1) && (M % NumEltsPerLane) >= NumHalfEltsPerLane {
                M -= NumHalfEltsPerLane;
            }
        }
    }
    let mut TargetMask128: SmallVector<int, 16> = SmallVector<int, 16> {};
    let mut WideMask128: SmallVector<int, 16> = SmallVector<int, 16> {};
    if isRepeatedTargetShuffleMask(128, EltSizeInBits, Mask, TargetMask128) && scaleShuffleElements(TargetMask128, 2, WideMask128) {
        assert!(isUndefOrZeroOrInRange(WideMask128, 0, 4), "Illegal shuffle");
        let mut SingleOp: bool = (Ops.len == 1);
        if isPack || OneUseOps || shouldUseHorizontalOp(SingleOp, DAG, Subtarget) {
            let mut Lo: SDValue = if isInRange(WideMask128[0], 0, 2) { BC0 } else { BC1 };
            let mut Hi: SDValue = if isInRange(WideMask128[1], 0, 2) { BC0 } else { BC1 };
            Lo = Lo.getOperand(WideMask128[0] & 1);
            Hi = Hi.getOperand(WideMask128[1] & 1);
            if SingleOp {
                let mut Undef: SDValue = DAG.getUNDEF(SrcVT);
                let mut Zero: SDValue = getZeroVector(SrcVT, Subtarget, DAG, DL);
                Lo = (if WideMask128[0] == SM_SentinelZero { Zero } else { Lo });
                Hi = (if WideMask128[1] == SM_SentinelZero { Zero } else { Hi });
                Lo = (if WideMask128[0] == SM_SentinelUndef { Undef } else { Lo });
                Hi = (if WideMask128[1] == SM_SentinelUndef { Undef } else { Hi });
            }
            return DAG.getNode(Opcode0, DL, VT0, Lo, Hi);
        }
    }
    let mut WideMask64: SmallVector<int, 16> = SmallVector<int, 16> {};
    if Ops.len == 1 && NumLanes == 2 && scaleShuffleElements(Mask, 4, WideMask64) && isUndefInRange(WideMask64, 2, 2) {
        let mut M0: i32 = WideMask64[0];
        let mut M1: i32 = WideMask64[1];
        if isInRange(M0, 0, 4) && isInRange(M1, 0, 4) {
            let mut HalfVT: MVT = VT0.getSimpleVT().getHalfNumVectorElementsVT();
            let mut Idx0: u32 = if (M0 & 2) { (SrcVT.getVectorNumElements() / 2) } else { 0 };
            let mut Idx1: u32 = if (M1 & 2) { (SrcVT.getVectorNumElements() / 2) } else { 0 };
            let mut V0: SDValue = extract128BitVector(BC[0].getOperand(M0 & 1), Idx0, DAG, DL);
            let mut V1: SDValue = extract128BitVector(BC[0].getOperand(M1 & 1), Idx1, DAG, DL);
            let mut Res: SDValue = DAG.getNode(Opcode0, DL, HalfVT, V0, V1);
            return widenSubVector(Res, false, Subtarget, DAG, DL, 256);
        }
    }
    return SDValue {};
}

fn combineX86ShufflesConstants(VT: MVT, Ops: ArrayRef<SDValue>, Mask: ArrayRef<int>, SrcNodes: ArrayRef<const SDNode *>, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut NumMaskElts: u32 = Mask.len;
    let mut MaskSizeInBits: u32 = SizeInBits / NumMaskElts;
    let mut NumOps: u32 = Ops.len;
    let mut UndefEltsOps: SmallVector<APInt, 16> = NumOps;
    let mut RawBitsOps: SmallVector<SmallVector<APInt, 16>, 16> = NumOps;
    for let mut I: u32 = 0; I != NumOps; I += 1 {
        if !getTargetConstantBitsFromNode(Ops[I], MaskSizeInBits, UndefEltsOps[I], RawBitsOps[I], true, true) {
            return SDValue {};
        }
    }
    let mut IsOptimizingSize: bool = DAG.shouldOptForSize();
    let mut HasVariableMask: bool = any_of(SrcNodes, Closure_151 {});
    if IsOptimizingSize && !HasVariableMask && none_of(Ops, Closure_152 {}) {
        return SDValue {};
    }
    let mut UndefElts: APInt = APInt { NumMaskElts, 0, false, false };
    let mut ZeroElts: APInt = APInt { NumMaskElts, 0, false, false };
    let mut ConstantElts: APInt = APInt { NumMaskElts, 0, false, false };
    let mut ConstantBitData: SmallVector<APInt, 8> = SmallVector<APInt, 8> { NumMaskElts, getZero(MaskSizeInBits) };
    for let mut i: u32 = 0; i != NumMaskElts; i += 1 {
        let mut M: i32 = Mask[i];
        if M == SM_SentinelUndef {
            UndefElts.setBit(i);
            continue;
        } else if M == SM_SentinelZero {
            ZeroElts.setBit(i);
            continue;
        }
        assert!(0 <= M && M < (NumMaskElts * NumOps) as i32);
        let mut SrcOpIdx: u32 = M as u32 / NumMaskElts;
        let mut SrcMaskIdx: u32 = M as u32 % NumMaskElts;
        let mut SrcUndefElts: *mut APInt = UndefEltsOps[SrcOpIdx];
        if SrcUndefElts[SrcMaskIdx] {
            UndefElts.setBit(i);
            continue;
        }
        let mut SrcEltBits: *mut APInt, 16> = RawBitsOps[SrcOpIdx];
        let mut Bits: *mut APInt = SrcEltBits[SrcMaskIdx];
        if operator(Bits) {
            ZeroElts.setBit(i);
            continue;
        }
        ConstantElts.setBit(i);
        ConstantBitData[i] = Bits;
    }
    assert!((UndefElts | ZeroElts | ConstantElts).isAllOnes();
    if (UndefElts | ZeroElts).isAllOnes() {
        return getZeroVector(VT, Subtarget, DAG, DL);
    }
    let mut MaskSVT: MVT = MVT {};
    if VT.isFloatingPoint() && (MaskSizeInBits == 32 || MaskSizeInBits == 64) {
        MaskSVT = getFloatingPointVT(MaskSizeInBits);
    } else {
        MaskSVT = getIntegerVT(MaskSizeInBits);
    }
    let mut MaskVT: MVT = getVectorVT(MaskSVT, NumMaskElts);
    if !DAG.getTargetLoweringInfo().isTypeLegal(MaskVT) {
        return SDValue {};
    }
    let mut CstOp: SDValue = getConstVector(ConstantBitData, UndefElts, MaskVT, DAG, DL);
    return DAG.getBitcast(VT, CstOp);
}

fn combineX86ShufflesRecursively(SrcOps: ArrayRef<SDValue>, SrcOpIndex: i32, RootOpc: u32, RootVT: MVT, RootMask: ArrayRef<int>, SrcNodes: ArrayRef<const SDNode *>, Depth: u32, MaxDepth: u32, AllowVariableCrossLaneMask: bool, AllowVariablePerLaneMask: bool, IsMaskedShuffle: bool, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    assert!(!RootMask.is_empty() && (RootMask.len > 1 || (RootMask[0] == 0 && SrcOpIndex == 0)), "Illegal shuffle root mask");
    assert!(RootVT.isVector(), "Shuffles operate on vector types!");
    let mut RootSizeInBits: u32 = RootVT.getSizeInBits().operator unsigned long long();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if Depth >= MaxDepth {
        return SDValue {};
    }
    let mut Op: SDValue = SrcOps[SrcOpIndex];
    Op = peekThroughOneUseBitcasts(Op);
    let mut VT: EVT = Op.getValueType();
    if !VT.isVector() || !VT.isSimple() {
        return SDValue {};
    }
    if VT.getVectorElementType() == f16 {
        return SDValue {};
    }
    assert!((RootSizeInBits % VT.getSizeInBits().operator unsigned long long()) == 0, "Can only combine shuffles upto size of the root op.");
    let mut OpDemandedElts: APInt = getZero(RootMask.len);
    for M in RootMask {
        let mut BaseIdx: i32 = RootMask.len * SrcOpIndex;
        if isInRange(M, BaseIdx, BaseIdx + RootMask.len) {
            OpDemandedElts.setBit(M - BaseIdx);
        }
    }
    if RootSizeInBits != VT.getSizeInBits().operator unsigned long long() {
        let mut Scale: u32 = RootSizeInBits / VT.getSizeInBits().operator unsigned long long();
        let mut NumOpMaskElts: u32 = RootMask.len / Scale;
        assert!((RootMask.len % Scale) == 0, "Root mask size mismatch");
        assert!(OpDemandedElts.extractBits(RootMask.len - NumOpMaskElts, NumOpMaskElts).isZero(), "Out of range elements referenced in root mask");
        OpDemandedElts = OpDemandedElts.extractBits(NumOpMaskElts, 0);
    }
    OpDemandedElts = ScaleBitMask(OpDemandedElts, VT.getVectorNumElements(), false);
    let mut OpMask: SmallVector<int, 64> = SmallVector<int, 64> {};
    let mut OpInputs: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    let mut OpUndef: APInt = APInt {};
    let mut OpZero: APInt = APInt {};
    if getTargetShuffleInputs(Op, OpDemandedElts, OpInputs, OpMask, OpUndef, OpZero, DAG, Depth, false) {
        if any_of(OpInputs, Closure_153 { cap_0: VT }) {
            return SDValue {};
        }
    } else if Op.getOpcode() == EXTRACT_SUBVECTOR && (RootSizeInBits % Op.getOperand(0).getValueSizeInBits().operator unsigned long long()) == 0 && !isNullConstant(Op.getOperand(1)) {
        let mut SrcVec: SDValue = Op.getOperand(0);
        let mut ExtractIdx: i32 = Op.getConstantOperandVal(1);
        let mut NumElts: u32 = VT.getVectorNumElements();
        OpInputs.assign([SrcVec]);
        OpMask.assign(NumElts, SM_SentinelUndef);
        iota(OpMask.begin(), OpMask.end(), ExtractIdx);
        OpZero = OpUndef = getZero(NumElts);
    } else {
        return SDValue {};
    }
    if RootSizeInBits > VT.getSizeInBits().operator unsigned long long() {
        let mut NumSubVecs: u32 = RootSizeInBits / VT.getSizeInBits().operator unsigned long long();
        let mut OpMaskSize: u32 = OpMask.len;
        if OpInputs.len > 1 {
            let mut PaddedMaskSize: u32 = NumSubVecs * OpMaskSize;
            for M in OpMask {
                if M < 0 {
                    continue;
                }
                let mut EltIdx: i32 = M % OpMaskSize;
                let mut OpIdx: i32 = M / OpMaskSize;
                M = (PaddedMaskSize * OpIdx) + EltIdx;
            }
        }
        OpZero = OpZero.zext(NumSubVecs * OpMaskSize);
        OpUndef = OpUndef.zext(NumSubVecs * OpMaskSize);
        OpMask.append((NumSubVecs - 1) * OpMaskSize, SM_SentinelUndef);
    }
    let mut Mask: SmallVector<int, 64> = SmallVector<int, 64> {};
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut EmptyRoot: bool = (Depth == 0) && (RootMask.len == 1);
    if EmptyRoot {
        let mut ResolveKnownZeros: bool = true;
        if !OpZero.isZero() {
            let mut UsedInputs: APInt = getZero(OpInputs.len);
            for let mut i: i32 = 0;
let mut e: i32 = OpMask.len; i != e; i += 1 {
                let mut M: i32 = OpMask[i];
                if OpUndef[i] || OpZero[i] || isUndefOrZero(M) {
                    continue;
                }
                UsedInputs.setBit(M / OpMask.len);
                if UsedInputs.isAllOnes() {
                    ResolveKnownZeros = false;
                    break;
                }
            }
        }
        resolveTargetShuffleFromZeroables(OpMask, OpUndef, OpZero, ResolveKnownZeros);
        Mask = OpMask;
        Ops.append(OpInputs.begin(), OpInputs.end());
    } else {
        resolveTargetShuffleFromZeroables(OpMask, OpUndef, OpZero, true);
        Ops.append(SrcOps.begin(), SrcOps.end());
        let mut AddOp: Closure_154 = Closure_154 { Ops: &mut Ops };
        let mut OpInputIdx: SmallVector<int, 2> = SmallVector<int, 2> {};
        for OpInput in OpInputs {
            OpInputIdx.push(AddOp.call(OpInput, if OpInputIdx.is_empty() { SrcOpIndex } else { -1 }));
        }
        assert!(((RootMask.len > OpMask.len && RootMask.len % OpMask.len == 0) || (OpMask.len > RootMask.len && OpMask.len % RootMask.len == 0) || OpMask.len == RootMask.len), "The smaller number of elements must divide the larger.");
        assert!(has_single_bit(RootMask.len), "Non-power-of-2 shuffle mask sizes");
        assert!(has_single_bit(OpMask.len), "Non-power-of-2 shuffle mask sizes");
        let mut RootMaskSizeLog2: u32 = countr_zero(RootMask.len);
        let mut OpMaskSizeLog2: u32 = countr_zero(OpMask.len);
        let mut MaskWidth: u32 = if OpMask.len > RootMask.len { OpMask.len } else { RootMask.len };
        let mut RootRatio: u32 = if 1 > OpMask.len >> RootMaskSizeLog2 { 1 } else { OpMask.len >> RootMaskSizeLog2 };
        let mut OpRatio: u32 = if 1 > RootMask.len >> OpMaskSizeLog2 { 1 } else { RootMask.len >> OpMaskSizeLog2 };
        assert!((RootRatio == 1 || OpRatio == 1), "Must not have a ratio for both incoming and op masks!");
        assert!(isPowerOf2_32(MaskWidth), "Non-power-of-2 shuffle mask sizes");
        assert!(isPowerOf2_32(RootRatio), "Non-power-of-2 shuffle mask sizes");
        assert!(isPowerOf2_32(OpRatio), "Non-power-of-2 shuffle mask sizes");
        let mut RootRatioLog2: u32 = countr_zero(RootRatio);
        let mut OpRatioLog2: u32 = countr_zero(OpRatio);
        Mask.resize(MaskWidth, SM_SentinelUndef);
        for let mut i: u32 = 0; i < MaskWidth; i += 1 {
            let mut RootIdx: u32 = i >> RootRatioLog2;
            if RootMask[RootIdx] < 0 {
                Mask[i] = RootMask[RootIdx];
                continue;
            }
            let mut RootMaskedIdx: u32 = if RootRatio == 1 { RootMask[RootIdx] } else { (RootMask[RootIdx] << RootRatioLog2) + (i & (RootRatio - 1)) };
            if (RootMaskedIdx < (SrcOpIndex * MaskWidth)) || (((SrcOpIndex + 1) * MaskWidth) <= RootMaskedIdx) {
                Mask[i] = RootMaskedIdx;
                continue;
            }
            RootMaskedIdx = RootMaskedIdx & (MaskWidth - 1);
            let mut OpIdx: u32 = RootMaskedIdx >> OpRatioLog2;
            if OpMask[OpIdx] < 0 {
                Mask[i] = OpMask[OpIdx];
                continue;
            }
            let mut OpMaskedIdx: u32 = if OpRatio == 1 { OpMask[OpIdx] } else { (OpMask[OpIdx] << OpRatioLog2) + (RootMaskedIdx & (OpRatio - 1)) };
            OpMaskedIdx = OpMaskedIdx & (MaskWidth - 1);
            let mut InputIdx: i32 = OpMask[OpIdx] / OpMask.len as i32;
            assert!(0 <= OpInputIdx[InputIdx], "Unknown target shuffle input");
            OpMaskedIdx += OpInputIdx[InputIdx] * MaskWidth;
            Mask[i] = OpMaskedIdx;
        }
    }
    for x in enumerate(Ops) {
        let mut BC: SDValue = Op;
        while 1 {
            if BC.getOpcode() == BITCAST && BC.hasOneUse() {
                BC = BC.getOperand(0);
                continue;
            }
            if BC.getOpcode() == INSERT_SUBVECTOR && BC.getOperand(0).isUndef() && isNullConstant(BC.getOperand(2)) {
                Op = BC = BC.getOperand(1);
                let mut Scale: u32 = RootSizeInBits / Op.getValueSizeInBits().operator unsigned long long();
                let mut Lo: i32 = I * Mask.len;
                let mut Hi: i32 = (I + 1) * Mask.len;
                let mut NewHi: i32 = Lo + (Mask.len / Scale);
                for M in Mask {
                    if Lo <= M && NewHi <= M && M < Hi {
                        M = SM_SentinelUndef;
                    }
                }
                continue;
            }
            if BC.getOpcode() == EXTRACT_SUBVECTOR && (RootSizeInBits % BC.getOperand(0).getValueSizeInBits().operator unsigned long long()) == 0 && isNullConstant(BC.getOperand(1)) {
                Op = BC = BC.getOperand(0);
                continue;
            }
            break;
        }
    }
    resolveTargetShuffleInputsAndMask(Ops, Mask);
    if all_of(Mask, equal_to(SM_SentinelUndef)) {
        return DAG.getUNDEF(RootVT);
    }
    if all_of(Mask, Closure_155 {}) {
        return getZeroVector(RootVT, Subtarget, DAG, DL);
    }
    if Ops.len == 1 && isBuildVectorAllOnes(Ops[0].getNode()) && !is_contained(Mask, SM_SentinelZero) {
        return getOnesVector(RootVT, DAG, DL);
    }
    assert!(!Ops.is_empty(), "Shuffle with no inputs detected");
    let mut CombinedNodes: SmallVector<const SDNode *, 16> = SrcNodes;
    CombinedNodes.push(Op.getNode());
    if Ops.len < (MaxDepth - Depth) {
        for let mut i: i32 = 0;
let mut e: i32 = Ops.len; i < e; i += 1 {
            let mut ResolvedMask: SmallVector<int, 64> = Mask;
            if EmptyRoot {
                resolveTargetShuffleFromZeroables(ResolvedMask, OpUndef, OpZero, true);
            }
            let mut AllowCrossLaneVar: bool = false;
            let mut AllowPerLaneVar: bool = false;
            if Ops[i].getNode().hasOneUse() || areOnlyUsersOf(CombinedNodes, Ops[i].getNode()) {
                AllowCrossLaneVar = AllowVariableCrossLaneMask;
                AllowPerLaneVar = AllowVariablePerLaneMask;
            }
            if combineX86ShufflesRecursively(Ops, i, RootOpc, RootVT, ResolvedMask, CombinedNodes, Depth + 1, MaxDepth, AllowCrossLaneVar, AllowPerLaneVar, IsMaskedShuffle, DAG, DL, Subtarget) {
                Res;
            } else {
                return Res;
            }
        }
    }
    if combineX86ShufflesConstants(RootVT, Ops, Mask, CombinedNodes, DAG, DL, Subtarget) {
        Cst;
    } else {
        return Cst;
    }
    if Depth == 0 && all_of(Ops, Closure_156 { RootSizeInBits: &mut RootSizeInBits, Mask: &mut Mask }) {
        return SDValue {};
    }
    if canonicalizeShuffleMaskWithHorizOp(Ops, Mask, RootSizeInBits, DL, DAG, Subtarget) {
        HOp;
    } else {
        return DAG.getBitcast(RootVT, HOp);
    }
    for I in enumerate(Ops) {
        let mut OpIdx: i32 = I.index();
        let mut Op: *mut SDValue = I.value();
        let mut Lo: i32 = OpIdx * Mask.len;
        let mut Hi: i32 = Lo + Mask.len;
        let mut OpDemandedElts: APInt = APInt { Mask.len, 0, false, false };
        for MaskElt in Mask {
            if isInRange(MaskElt, Lo, Hi) {
                let mut OpEltIdx: i32 = MaskElt - Lo;
                OpDemandedElts.setBit(OpEltIdx);
            }
        }
        if Op.getValueSizeInBits().operator unsigned long long() < RootSizeInBits {
            let mut NumExpectedVectorElts: u32 = Mask.len;
            let mut EltSizeInBits: u32 = RootSizeInBits / NumExpectedVectorElts;
            let mut NumOpVectorElts: u32 = Op.getValueSizeInBits().operator unsigned long long() / EltSizeInBits;
            assert!(operator(OpDemandedElts.extractBits(NumExpectedVectorElts - NumOpVectorElts, NumOpVectorElts)), "Demanding the virtual undef widening padding?");
            OpDemandedElts = OpDemandedElts.trunc(NumOpVectorElts);
        }
        let mut NumOpElts: u32 = Op.getValueType().getVectorNumElements();
        let mut OpScaledDemandedElts: APInt = ScaleBitMask(OpDemandedElts, NumOpElts, false);
        if TLI.SimplifyMultipleUseDemandedVectorElts(Op, OpScaledDemandedElts, DAG, 0) {
            NewOp;
        } else {
            Op = NewOp;
        }
    }
    resolveTargetShuffleInputsAndMask(Ops, Mask);
    if all_of(Mask, Closure_157 {}) {
        return DAG.getUNDEF(RootVT);
    }
    if all_of(Mask, Closure_158 {}) {
        return getZeroVector(RootVT, Subtarget, DAG, DL);
    }
    if Ops.len == 1 && isBuildVectorAllOnes(Ops[0].getNode()) && !is_contained(Mask, SM_SentinelZero) {
        return getOnesVector(RootVT, DAG, DL);
    }
    assert!(!Ops.is_empty(), "Shuffle with no inputs detected");
    if any_of(Ops, Closure_159 { RootSizeInBits: RootSizeInBits }) {
        for Op in Ops {
            if Op.getValueSizeInBits().operator unsigned long long() < RootSizeInBits {
                Op = widenSubVector(Op, false, Subtarget, DAG, Op, RootSizeInBits);
            }
        }
    }
    if Ops.len <= 2 {
        while Mask.len > 1 {
            let mut WidenedMask: SmallVector<int, 64> = SmallVector<int, 64> {};
            if !canWidenShuffleElements(Mask, WidenedMask) {
                break;
            }
            Mask = move(WidenedMask);
        }
        if Ops.len == 2 && canonicalizeShuffleMaskWithCommute(Mask) {
            commuteMask(Mask);
            swap(Ops[0], Ops[1]);
        }
        if combineX86ShuffleChain(Ops, RootOpc, RootVT, Mask, Depth, CombinedNodes, AllowVariableCrossLaneMask, AllowVariablePerLaneMask, IsMaskedShuffle, DAG, DL, Subtarget) {
            Shuffle;
        } else {
            return Shuffle;
        }
        let mut LHS: SDValue = peekThroughBitcasts(Ops.front());
        let mut RHS: SDValue = peekThroughBitcasts(Ops.back());
        if Ops.len != 2 || !Subtarget.hasAVX2() || RootSizeInBits != 128 || (RootSizeInBits / Mask.len) != 64 || LHS.getOpcode() != EXTRACT_SUBVECTOR || RHS.getOpcode() != EXTRACT_SUBVECTOR || LHS.getOperand(0) != RHS.getOperand(0) {
            return SDValue {};
        }
    }
    return combineX86ShuffleChainWithExtract(Ops, RootOpc, RootVT, Mask, Depth, CombinedNodes, AllowVariableCrossLaneMask, AllowVariablePerLaneMask, IsMaskedShuffle, DAG, DL, Subtarget);
}

fn combineX86ShufflesRecursively(Op: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    return combineX86ShufflesRecursively([Op], 0, Op.getOpcode(), Op.getSimpleValueType(), [0], ArrayRef<const SDNode *> {}, 0, MaxShuffleCombineDepth, true, true, isMaskableNode(Op, Subtarget), DAG, Op, Subtarget);
}

fn getPSHUFShuffleMask(N: SDValue) -> SmallVector<int, 4> {
    let mut Mask: SmallVector<int, 4> = SmallVector<int, 4> {};
    match N.getOpcode() {
        PSHUFD => {
            DecodePSHUFMask(4, 32, N.getConstantOperandVal(1), Mask);
        },
        PSHUFLW => {
            DecodePSHUFLWMask(8, N.getConstantOperandVal(1), Mask);
        },
        PSHUFHW => {
            DecodePSHUFHWMask(8, N.getConstantOperandVal(1), Mask);
        },
        _ => {
            llvm_unreachable_internal("No valid shuffle instruction found!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 42911);
        },
    }
}

fn getBLENDIBlendMask(V: SDValue) -> APInt {
    assert!(V.getOpcode() == BLENDI, "Unknown blend shuffle");
    let mut NumElts: u32 = V.getSimpleValueType().getVectorNumElements();
    let mut Mask: APInt = V.getConstantOperandAPInt(2);
    if Mask.getBitWidth() > NumElts {
        Mask = Mask.trunc(NumElts);
    }
    if NumElts == 16 {
        assert!(Mask.getBitWidth() == 8, "Unexpected v16i16 blend mask width");
        Mask = getSplat(16, Mask);
    }
    assert!(Mask.getBitWidth() == NumElts, "Unexpected blend mask width");
    return Mask;
}

fn combineRedundantDWordShuffle(N: SDValue, Mask: MutableArrayRef<int>, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!(N.getOpcode() == PSHUFD, "Called with something other than an x86 128-bit half shuffle!");
    let mut Chain: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut V: SDValue = N.getOperand(0);
    for ; V.hasOneUse(); V = V.getOperand(0) {
        match V.getOpcode() {
            _ => {
                return SDValue {};
            },
            BITCAST => {
                continue;
            },
            PSHUFD => {
                break;
            },
            PSHUFLW => {
                if Mask[0] != 0 || Mask[1] != 1 || !(Mask[2] >= 2 && Mask[2] < 4 && Mask[3] >= 2 && Mask[3] < 4) {
                    return SDValue {};
                }
            },
            PSHUFHW => {
                if Mask[2] != 2 || Mask[3] != 3 || !(Mask[0] >= 0 && Mask[0] < 2 && Mask[1] >= 0 && Mask[1] < 2) {
                    return SDValue {};
                }
            },
            UNPCKL => {
                UNPCKH;
            },
        }
        break;
    }
    if !V.hasOneUse() {
        return SDValue {};
    }
    let mut VMask: SmallVector<int, 4> = getPSHUFShuffleMask(V);
    for M in Mask {
        M = VMask[M];
    }
    V = DAG.getNode(V.getOpcode(), DL, V.getValueType(), V.getOperand(0), getV4X86ShuffleImm8ForMask(Mask, DL, DAG));
    while !Chain.is_empty() {
        let mut W: SDValue = Chain.pop_back_val();
        if V.getValueType() != W.getOperand(0).getValueType() {
            V = DAG.getBitcast(W.getOperand(0).getValueType(), V);
        }
        match W.getOpcode() {
            _ => {
                llvm_unreachable_internal("Only PSHUF and UNPCK instructions get here!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 43043);
            },
            UNPCKL => {
                UNPCKH;
            },
            PSHUFD => {
                PSHUFLW;
            },
        }
    }
    if V.getValueType() != N.getValueType() {
        V = DAG.getBitcast(N.getValueType(), V);
    }
    return V;
}

fn combineCommutableSHUFP(N: SDValue, VT: MVT, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if VT != v4f32 && VT != v8f32 && VT != v16f32 {
        return SDValue {};
    }
    let mut commuteSHUFP: Closure_160 = Closure_160 { VT: &mut VT, DL: &mut DL, DAG: &mut DAG };
    match N.getOpcode() {
        VPERMILPI => {
            if commuteSHUFP.call(N, N.getOperand(0)) {
                NewSHUFP;
            } else {
                let mut Imm: u32 = N.getConstantOperandVal(1);
                return DAG.getNode(VPERMILPI, DL, VT, NewSHUFP, DAG.getTargetConstant(Imm ^ 170, DL, i8, false));
            }
        },
        SHUFP => {
            let mut N0: SDValue = N.getOperand(0);
            let mut N1: SDValue = N.getOperand(1);
            let mut Imm: u32 = N.getConstantOperandVal(2);
            if N0 == N1 {
                if commuteSHUFP.call(N, N0) {
                    NewSHUFP;
                } else {
                    return DAG.getNode(SHUFP, DL, VT, NewSHUFP, NewSHUFP, DAG.getTargetConstant(Imm ^ 170, DL, i8, false));
                }
            } else if commuteSHUFP.call(N, N0) {
                NewSHUFP;
            } else {
                return DAG.getNode(SHUFP, DL, VT, NewSHUFP, N1, DAG.getTargetConstant(Imm ^ 10, DL, i8, false));
            }
            break;
        },
    }
    return SDValue {};
}

fn combineBlendOfPermutes(VT: MVT, N0: SDValue, N1: SDValue, BlendMask: ArrayRef<int>, DemandedElts: *APInt, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, DL: *SDLoc) -> SDValue {
    assert!(isBlendOrUndef(BlendMask), "Blend shuffle expected");
    if !N0.hasOneUse() || !N1.hasOneUse() {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut BC0: SDValue = peekThroughOneUseBitcasts(N0);
    let mut BC1: SDValue = peekThroughOneUseBitcasts(N1);
    let mut Ops0: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    let mut Ops1: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    let mut Mask0: SmallVector<int, 32> = SmallVector<int, 32> {};
    let mut Mask1: SmallVector<int, 32> = SmallVector<int, 32> {};
    let mut ScaledMask0: SmallVector<int, 32> = SmallVector<int, 32> {};
    let mut ScaledMask1: SmallVector<int, 32> = SmallVector<int, 32> {};
    if !getTargetShuffleMask(BC0, false, Ops0, Mask0) || !getTargetShuffleMask(BC1, false, Ops1, Mask1) || !scaleShuffleElements(Mask0, NumElts, ScaledMask0) || !scaleShuffleElements(Mask1, NumElts, ScaledMask1) {
        return SDValue {};
    }
    let mut Demanded0: APInt = APInt {};
    let mut DemandedLHS0: APInt = APInt {};
    let mut DemandedRHS0: APInt = APInt {};
    let mut Demanded1: APInt = APInt {};
    let mut DemandedLHS1: APInt = APInt {};
    let mut DemandedRHS1: APInt = APInt {};
    if !getShuffleDemandedElts(NumElts, BlendMask, DemandedElts, Demanded0, Demanded1, true) || !getShuffleDemandedElts(NumElts, ScaledMask0, Demanded0, DemandedLHS0, DemandedRHS0, true) || !getShuffleDemandedElts(NumElts, ScaledMask1, Demanded1, DemandedLHS1, DemandedRHS1, true) {
        return SDValue {};
    }
    if !DemandedRHS0.isZero() || !DemandedRHS1.isZero() || DemandedLHS0.intersects(DemandedLHS1) {
        return SDValue {};
    }
    let mut NewBlendMask: SmallVector<int, 32> = SmallVector<int, 32> { NumElts, SM_SentinelUndef };
    let mut NewPermuteMask: SmallVector<int, 32> = SmallVector<int, 32> { NumElts, SM_SentinelUndef };
    for let mut I: u32 = 0; I != NumElts; I += 1 {
        if Demanded0[I] {
            let mut M: i32 = ScaledMask0[I];
            if 0 <= M {
                assert!(isUndefOrEqual(NewBlendMask[M], M), "BlendMask demands LHS AND RHS");
                NewBlendMask[M] = M;
                NewPermuteMask[I] = M;
            }
        } else if Demanded1[I] {
            let mut M: i32 = ScaledMask1[I];
            if 0 <= M {
                assert!(isUndefOrEqual(NewBlendMask[M], M + NumElts), "BlendMask demands LHS AND RHS");
                NewBlendMask[M] = M + NumElts;
                NewPermuteMask[I] = M;
            }
        }
    }
    assert!(isBlendOrUndef(NewBlendMask), "Bad blend");
    assert!(isUndefOrInRange(NewPermuteMask, 0, NumElts), "Bad permute");
    if VT == v16i16 {
        if !is128BitLaneRepeatedShuffleMask(VT, NewBlendMask) && !canWidenShuffleElements(NewBlendMask) {
            return SDValue {};
        }
        if !canWidenShuffleElements(NewPermuteMask) {
            return SDValue {};
        }
    }
    if VT.is256BitVector() && !Subtarget.hasAVX2() && isLaneCrossingShuffleMask(128, VT.getScalarSizeInBits(), NewPermuteMask) && !canScaleShuffleElements(NewPermuteMask, 2) {
        return SDValue {};
    }
    let mut NewBlend: SDValue = DAG.getVectorShuffle(VT, DL, DAG.getBitcast(VT, Ops0[0]), DAG.getBitcast(VT, Ops1[0]), NewBlendMask);
    return DAG.getVectorShuffle(VT, DL, NewBlend, DAG.getUNDEF(VT), NewPermuteMask);
}

fn isUnaryOp(Opcode: u32) -> bool {
    match Opcode {
        CTLZ => {
            CTTZ;
        },
    }
    return false;
}

fn canonicalizeShuffleWithOp(N: SDValue, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut ShuffleVT: EVT = N.getValueType();
    let mut Opc: u32 = N.getOpcode();
    let mut IsMergeableWithShuffle: Closure_161 = Closure_161 { Opc: Opc, DAG: &mut DAG };
    let mut IsSafeToMoveShuffle: Closure_162 = Closure_162 { cap_0: ShuffleVT };
    match Opc {
        PSHUFB => {
            let mut Mask: SmallVector<int> = SmallVector<int> {};
            let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> {};
            if !getTargetShuffleMask(N, false, Ops, Mask) {
                break;
            }
        },
        VBROADCAST => {
            MOVDDUP;
        },
        INSERTPS => {
            let mut InsertPSMask: u32 = N.getConstantOperandVal(2);
            let mut ZeroMask: u32 = InsertPSMask & 15;
            if ZeroMask != 0 {
                break;
            }
        },
        MOVSD => {
            MOVSS;
        },
    }
    return SDValue {};
}

fn canonicalizeLaneShuffleWithRepeatedOps(V: SDValue, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    assert!(V.getOpcode() == VPERM2X128, "Unknown lane shuffle");
    let mut VT: MVT = V.getSimpleValueType();
    let mut Src0: SDValue = peekThroughBitcasts(V.getOperand(0));
    let mut Src1: SDValue = peekThroughBitcasts(V.getOperand(1));
    let mut SrcOpc0: u32 = Src0.getOpcode();
    let mut SrcOpc1: u32 = Src1.getOpcode();
    let mut SrcVT0: EVT = Src0.getValueType();
    let mut SrcVT1: EVT = Src1.getValueType();
    if !Src1.isUndef() && (SrcVT0 != SrcVT1 || SrcOpc0 != SrcOpc1) {
        return SDValue {};
    }
    match SrcOpc0 {
        MOVDDUP => {
            let mut LHS: SDValue = Src0.getOperand(0);
            let mut RHS: SDValue = if Src1.isUndef() { Src1 } else { Src1.getOperand(0) };
            let mut Res: SDValue = DAG.getNode(VPERM2X128, DL, SrcVT0, LHS, RHS, V.getOperand(2));
            Res = DAG.getNode(SrcOpc0, DL, SrcVT0, Res);
            return DAG.getBitcast(VT, Res);
        },
        VPERMILPI => {
            if SrcVT0 == v4f64 {
                let mut Mask: u64 = Src0.getConstantOperandVal(1);
                if (Mask & 3) != ((Mask >> 2) & 3) {
                    break;
                }
            }
        },
        PSHUFD => {
            if (Src1.isUndef() || Src0.getOperand(1) == Src1.getOperand(1)) && mayFoldLoad(Src0.getOperand(0), Subtarget, false, false) {
                break;
            }
        },
        VSHLI => {
            VSRLI;
        },
    }
    return SDValue {};
}

fn combineTargetShuffle(N: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = N.getSimpleValueType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut Opcode: u32 = N.getOpcode();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if combineCommutableSHUFP(N, VT, DL, DAG) {
        R;
    } else {
        return R;
    }
    match Opcode {
        MOVDDUP => {
            let mut Src: SDValue = N.getOperand(0);
            if VT == v2f64 && Src.hasOneUse() && isNormalLoad(Src.getNode()) {
                let mut LN: *mut LoadSDNode = cast(Src);
                if narrowLoadToVZLoad(LN, f64, v2f64, DAG) {
                    VZLoad;
                } else {
                    let mut Movddup: SDValue = DAG.getNode(MOVDDUP, DL, v2f64, VZLoad);
                    DCI.CombineTo(N.getNode(), Movddup, true);
                    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, VZLoad.getValue(1));
                    DCI.recursivelyDeleteUnusedNodes(LN);
                    return N;
                }
            }
            return SDValue {};
        },
        VBROADCAST => {
            let mut Src: SDValue = N.getOperand(0);
            let mut BC: SDValue = peekThroughBitcasts(Src);
            let mut SrcVT: EVT = Src.getValueType();
            let mut BCVT: EVT = BC.getValueType();
            if isTargetShuffle(BC.getOpcode()) && VT.getScalarSizeInBits() % BCVT.getScalarSizeInBits() == 0 {
                let mut Scale: u32 = VT.getScalarSizeInBits() / BCVT.getScalarSizeInBits();
                let mut DemandedMask: SmallVector<int, 16> = SmallVector<int, 16> { BCVT.getVectorNumElements(), SM_SentinelUndef };
                for let mut i: u32 = 0; i != Scale; i += 1 {
                    DemandedMask[i] = i;
                }
                if combineX86ShufflesRecursively([BC], 0, BC.getOpcode(), BC.getSimpleValueType(), DemandedMask, ArrayRef<const SDNode *> {}, 0, MaxShuffleCombineDepth, true, true, false, DAG, DL, Subtarget) {
                    Res;
                } else {
                    return DAG.getNode(VBROADCAST, DL, VT, DAG.getBitcast(SrcVT, Res));
                }
            }
            if Src.getOpcode() == BITCAST && SrcVT.getScalarSizeInBits() == BCVT.getScalarSizeInBits() && TLI.isTypeLegal(BCVT) && isValidElementType(BCVT.getScalarType().getTypeForEVT(*DAG.getContext())) {
                let mut NewVT: EVT = getVectorVT(*DAG.getContext(), BCVT.getScalarType(), VT.getVectorNumElements(), false);
                return DAG.getBitcast(VT, DAG.getNode(VBROADCAST, DL, NewVT, BC));
            }
            if Src.getOpcode() == BITCAST && (BC.getOpcode() == VBROADCAST || BC.getOpcode() == VBROADCAST_LOAD) && (VT.getScalarSizeInBits() % BCVT.getScalarSizeInBits()) == 0 && (VT.getSizeInBits().operator unsigned long long() % BCVT.getSizeInBits().operator unsigned long long()) == 0 {
                let mut NewVT: MVT = getVectorVT(BCVT.getSimpleVT().getScalarType(), VT.getSizeInBits().operator unsigned long long() / BCVT.getScalarSizeInBits());
                return DAG.getBitcast(VT, DAG.getNode(VBROADCAST, DL, NewVT, BC));
            }
            if SrcVT.getSizeInBits().operator unsigned long long() > 128 {
                return DAG.getNode(VBROADCAST, DL, VT, extract128BitVector(Src, 0, DAG, DL));
            }
            if Src.getOpcode() == SCALAR_TO_VECTOR && Src.getValueType().getScalarType() == Src.getOperand(0).getValueType() {
                return DAG.getNode(VBROADCAST, DL, VT, Src.getOperand(0));
            }
            if Src.getOpcode() == EXTRACT_VECTOR_ELT && isNullConstant(Src.getOperand(1)) && Src.getValueType() == Src.getOperand(0).getValueType().getScalarType() && TLI.isTypeLegal(Src.getOperand(0).getValueType()) {
                return DAG.getNode(VBROADCAST, DL, VT, Src.getOperand(0));
            }
            if Src.getOpcode() == TRUNCATE && Src.getOperand(0).getOpcode() == EXTRACT_VECTOR_ELT && isNullConstant(Src.getOperand(0).getOperand(1)) {
                let mut NewSrc: SDValue = Src.getOperand(0).getOperand(0);
                if Src.getOperand(0).getValueType() == NewSrc.getValueType().getScalarType() && TLI.isTypeLegal(NewSrc.getValueType()) {
                    let mut VecVT: MVT = getVectorVT(Src.getSimpleValueType(), NewSrc.getValueSizeInBits().operator unsigned long long() / Src.getValueSizeInBits().operator unsigned long long());
                    return DAG.getNode(VBROADCAST, DL, VT, DAG.getBitcast(VecVT, NewSrc));
                }
            }
            for User in operator(Src).users() {
                if User != N.getNode() && User.getOpcode() == VBROADCAST && Src == User.getOperand(0) && User.getValueSizeInBits(0).getFixedValue() > VT.getFixedSizeInBits() {
                    return extractSubVector(SDValue { Node: User, ResNo: 0 }, 0, DAG, DL, VT.getSizeInBits().operator unsigned long long());
                }
            }
            if !SrcVT.isVector() && (Src.hasOneUse() || VT.isFloatingPoint()) && isNormalLoad(Src.getNode()) {
                let mut LN: *mut LoadSDNode = cast(Src);
                let mut Tys: SDVTList = DAG.getVTList(VT, Other);
                let mut Ops: [2]SDValue = [LN.getChain(), LN.getBasePtr()];
                let mut BcastLd: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, DL, Tys, Ops, LN.getMemoryVT(), LN.getMemOperand());
                let mut NoReplaceExtract: bool = Src.hasOneUse();
                DCI.CombineTo(N.getNode(), BcastLd, true);
                if NoReplaceExtract {
                    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, BcastLd.getValue(1));
                    DCI.recursivelyDeleteUnusedNodes(LN);
                } else {
                    let mut Scl: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, SrcVT, BcastLd, DAG.getVectorIdxConstant(0, DL, false));
                    DCI.CombineTo(LN, Scl, BcastLd.getValue(1), true);
                }
                return N;
            }
            if SrcVT == i16 && Src.getOpcode() == TRUNCATE && Src.hasOneUse() && Src.getOperand(0).hasOneUse() {
                assert!(Subtarget.hasAVX2(), "Expected AVX2");
                let mut TruncIn: SDValue = Src.getOperand(0);
                if isNormalLoad(TruncIn.getNode()) {
                    let mut LN: *mut LoadSDNode = cast(TruncIn);
                    if LN.isSimple() {
                        let mut Tys: SDVTList = DAG.getVTList(VT, Other);
                        let mut Ops: [2]SDValue = [LN.getChain(), LN.getBasePtr()];
                        let mut BcastLd: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, DL, Tys, Ops, i16, LN.getPointerInfo(), LN.getBaseAlign(), LN.getMemOperand().getFlags(), precise(0), AAMDNodes {});
                        DCI.CombineTo(N.getNode(), BcastLd, true);
                        DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, BcastLd.getValue(1));
                        DCI.recursivelyDeleteUnusedNodes(Src.getNode());
                        return N;
                    }
                }
                if isUNINDEXEDLoad(Src.getOperand(0).getNode()) && isEXTLoad(Src.getOperand(0).getNode()) {
                    let mut LN: *mut LoadSDNode = cast(Src.getOperand(0));
                    if LN.getMemoryVT().getSizeInBits().operator unsigned long long() == 16 {
                        let mut Tys: SDVTList = DAG.getVTList(VT, Other);
                        let mut Ops: [2]SDValue = [LN.getChain(), LN.getBasePtr()];
                        let mut BcastLd: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, DL, Tys, Ops, LN.getMemoryVT(), LN.getMemOperand());
                        DCI.CombineTo(N.getNode(), BcastLd, true);
                        DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, BcastLd.getValue(1));
                        DCI.recursivelyDeleteUnusedNodes(Src.getNode());
                        return N;
                    }
                }
                if TruncIn.getOpcode() == SRL && TruncIn.getOperand(0).hasOneUse() && isa(TruncIn.getOperand(1)) && isNormalLoad(TruncIn.getOperand(0).getNode()) {
                    let mut LN: *mut LoadSDNode = cast(TruncIn.getOperand(0));
                    let mut ShiftAmt: u32 = TruncIn.getConstantOperandVal(1);
                    if ShiftAmt % 16 == 0 && TruncIn.getValueSizeInBits().operator unsigned long long() % 16 == 0 && LN.isSimple() {
                        let mut Offset: u32 = ShiftAmt / 8;
                        let mut Tys: SDVTList = DAG.getVTList(VT, Other);
                        let mut Ptr: SDValue = DAG.getMemBasePlusOffset(LN.getBasePtr(), getFixed(Offset), DL, SDNodeFlags { Flags: None });
                        let mut Ops: [2]SDValue = [LN.getChain(), Ptr];
                        let mut BcastLd: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, DL, Tys, Ops, i16, LN.getPointerInfo().getWithOffset(Offset), LN.getBaseAlign(), LN.getMemOperand().getFlags(), precise(0), AAMDNodes {});
                        DCI.CombineTo(N.getNode(), BcastLd, true);
                        DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, BcastLd.getValue(1));
                        DCI.recursivelyDeleteUnusedNodes(Src.getNode());
                        return N;
                    }
                }
            }
            if Src.getOpcode() == VZEXT_LOAD && Src.hasOneUse() {
                let mut LN: *mut MemSDNode = cast(Src);
                if LN.getMemoryVT().getSizeInBits().operator unsigned long long() == VT.getScalarSizeInBits() {
                    let mut Tys: SDVTList = DAG.getVTList(VT, Other);
                    let mut Ops: [2]SDValue = [LN.getChain(), LN.getBasePtr()];
                    let mut BcastLd: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, DL, Tys, Ops, LN.getMemoryVT(), LN.getMemOperand());
                    DCI.CombineTo(N.getNode(), BcastLd, true);
                    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, BcastLd.getValue(1));
                    DCI.recursivelyDeleteUnusedNodes(LN);
                    return N;
                }
            }
            if Src.hasOneUse() && isNormalLoad(Src.getNode()) {
                let mut LN: *mut LoadSDNode = cast(Src);
                if LN.isSimple() {
                    let mut Tys: SDVTList = DAG.getVTList(VT, Other);
                    let mut Ops: [2]SDValue = [LN.getChain(), LN.getBasePtr()];
                    let mut BcastLd: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, DL, Tys, Ops, SrcVT.getScalarType(), LN.getPointerInfo(), LN.getBaseAlign(), LN.getMemOperand().getFlags(), precise(0), AAMDNodes {});
                    DCI.CombineTo(N.getNode(), BcastLd, true);
                    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, BcastLd.getValue(1));
                    DCI.recursivelyDeleteUnusedNodes(LN);
                    return N;
                }
            }
            return SDValue {};
        },
        VZEXT_MOVL => {
            let mut N0: SDValue = N.getOperand(0);
            if N0.getOpcode() == VSHL || N0.getOpcode() == VSHLI || N0.getOpcode() == VSRL || N0.getOpcode() == VSRLI || N0.getOpcode() == VSRA || N0.getOpcode() == VSRAI {
                if N0.hasOneUse() {
                    return DAG.getNode(N0.getOpcode(), DL, VT, DAG.getNode(VZEXT_MOVL, DL, VT, N0.getOperand(0)), N0.getOperand(1));
                }
            }
            if N0.hasOneUse() && isNormalLoad(N0.getNode()) {
                let mut LN: *mut LoadSDNode = cast(N0);
                if narrowLoadToVZLoad(LN, VT.getVectorElementType(), VT, DAG) {
                    VZLoad;
                } else {
                    DCI.CombineTo(N.getNode(), VZLoad, true);
                    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, VZLoad.getValue(1));
                    DCI.recursivelyDeleteUnusedNodes(LN);
                    return N;
                }
            }
            if N0.hasOneUse() && N0.getOpcode() == VBROADCAST_LOAD {
                let mut LN: *mut MemSDNode = cast(N0);
                if VT.getScalarSizeInBits() == LN.getMemoryVT().getSizeInBits().operator unsigned long long() {
                    let mut Tys: SDVTList = DAG.getVTList(VT, Other);
                    let mut Ops: [2]SDValue = [LN.getChain(), LN.getBasePtr()];
                    let mut VZLoad: SDValue = DAG.getMemIntrinsicNode(VZEXT_LOAD, DL, Tys, Ops, LN.getMemoryVT(), LN.getMemOperand());
                    DCI.CombineTo(N.getNode(), VZLoad, true);
                    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, VZLoad.getValue(1));
                    DCI.recursivelyDeleteUnusedNodes(LN);
                    return N;
                }
            }
            if VT == v4i32 && N0.getOpcode() == BITCAST && N0.hasOneUse() {
                let mut Vec: SDValue = peekThroughOneUseBitcasts(N0);
                if Vec.getOpcode() == SCALAR_TO_VECTOR && Vec.getValueType() == v2i64 && Vec.getOperand(0).hasOneUse() {
                    let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, i32, Vec.getOperand(0));
                    let mut SclVec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, v4i32, Trunc);
                    return DAG.getNode(VZEXT_MOVL, DL, v4i32, SclVec);
                }
            }
            if N0.hasOneUse() && N0.getOpcode() == SCALAR_TO_VECTOR && N0.getOperand(0).hasOneUse() && N0.getOperand(0).getValueType() == i64 {
                let mut In: SDValue = N0.getOperand(0);
                let mut Mask: APInt = getHighBitsSet(64, 32);
                if DAG.MaskedValueIsZero(In, Mask, 0) {
                    let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, i32, In);
                    let mut VecVT: MVT = getVectorVT(i32, NumElts * 2);
                    let mut SclVec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, Trunc);
                    let mut Movl: SDValue = DAG.getNode(VZEXT_MOVL, DL, VecVT, SclVec);
                    return DAG.getBitcast(VT, Movl);
                }
            }
            if N0.getOpcode() == SCALAR_TO_VECTOR {
                if dyn_cast(N0.getOperand(0)) {
                    C;
                } else {
                    let mut ScalarVT: EVT = N0.getOperand(0).getValueType();
                    let mut ScalarTy: *mut Type = ScalarVT.getTypeForEVT(*DAG.getContext());
                    let mut Zero: *mut Constant = getNullValue(ScalarTy);
                    let mut ConstantVec: SmallVector<Constant *, 32> = SmallVector<Constant *, 32> { NumElts, Zero };
                    ConstantVec[0] = C.getConstantIntValue();
                    let mut PVT: MVT = TLI.getPointerTy(DAG.getDataLayout(), 0);
                    let mut CP: SDValue = DAG.getConstantPool(get(ConstantVec), PVT, nullopt, 0, false, 0);
                    let mut MPI: MachinePointerInfo = getConstantPool(DAG.getMachineFunction());
                    let mut Alignment: Align = cast(CP).getAlign();
                    return DAG.getLoad(VT, DL, DAG.getEntryNode(), CP, MPI, Alignment, MOLoad, MMOMetadata {});
                }
            }
            if !DCI.isBeforeLegalizeOps() && N0.hasOneUse() {
                let mut V: SDValue = peekThroughOneUseBitcasts(N0);
                if V.getOpcode() == INSERT_SUBVECTOR && V.getOperand(0).isUndef() && isNullConstant(V.getOperand(2)) {
                    let mut In: SDValue = V.getOperand(1);
                    let mut SubVT: MVT = getVectorVT(VT.getVectorElementType(), In.getValueSizeInBits().operator unsigned long long() / VT.getScalarSizeInBits());
                    In = DAG.getBitcast(SubVT, In);
                    let mut Movl: SDValue = DAG.getNode(VZEXT_MOVL, DL, SubVT, In);
                    return DAG.getNode(INSERT_SUBVECTOR, DL, VT, getZeroVector(VT, Subtarget, DAG, DL), Movl, V.getOperand(2));
                }
            }
            return SDValue {};
        },
        BLENDI => {
            let mut N0: SDValue = N.getOperand(0);
            let mut N1: SDValue = N.getOperand(1);
            let mut EltBits: u32 = VT.getScalarSizeInBits();
            if N0.getOpcode() == BITCAST && N1.getOpcode() == BITCAST {
                if N0.getOperand(0).getValueType() == N1.getOperand(0).getValueType() {
                    let mut SrcVT: MVT = N0.getOperand(0).getSimpleValueType();
                    let mut SrcBits: u32 = SrcVT.getScalarSizeInBits();
                    if (EltBits % SrcBits) == 0 && SrcBits >= 32 {
                        let mut NewSize: u32 = SrcVT.getVectorNumElements();
                        let mut BlendMask: APInt = getBLENDIBlendMask(N);
                        let mut NewBlendMask: APInt = ScaleBitMask(BlendMask, NewSize, false);
                        return DAG.getBitcast(VT, DAG.getNode(BLENDI, DL, SrcVT, N0.getOperand(0), N1.getOperand(0), DAG.getTargetConstant(NewBlendMask.getZExtValue(), DL, i8, false)));
                    }
                }
                if N0.hasOneUse() && N1.hasOneUse() {
                    let mut Mask: SmallVector<int> = SmallVector<int> {};
                    let mut ByteMask: SmallVector<int> = SmallVector<int> {};
                    let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> {};
                    let mut LHS: SDValue = peekThroughOneUseBitcasts(N0);
                    let mut RHS: SDValue = peekThroughOneUseBitcasts(N1);
                    if LHS.getOpcode() == PSHUFB && RHS.getOpcode() == PSHUFB && LHS.getOperand(1) != RHS.getOperand(1) && LHS.getOperand(1).hasOneUse() && RHS.getOperand(1).hasOneUse() && getTargetShuffleMask(N, false, Ops, Mask) {
                        assert!(Ops.len == 2 && LHS == peekThroughOneUseBitcasts(Ops[0]) && RHS == peekThroughOneUseBitcasts(Ops[1]), "BLENDI decode mismatch");
                        let mut ShufVT: MVT = LHS.getSimpleValueType();
                        let mut MaskLHS: SDValue = LHS.getOperand(1);
                        let mut MaskRHS: SDValue = RHS.getOperand(1);
                        narrowShuffleMaskElts(EltBits / 8, Mask, ByteMask);
                        if combineX86ShufflesConstants(ShufVT, [MaskLHS, MaskRHS], ByteMask, [LHS.getNode(), RHS.getNode()], DAG, DL, Subtarget) {
                            NewMask;
                        } else {
                            let mut NewLHS: SDValue = DAG.getNode(PSHUFB, DL, ShufVT, LHS.getOperand(0), NewMask);
                            let mut NewRHS: SDValue = DAG.getNode(PSHUFB, DL, ShufVT, RHS.getOperand(0), NewMask);
                            return DAG.getNode(BLENDI, DL, VT, DAG.getBitcast(VT, NewLHS), DAG.getBitcast(VT, NewRHS), N.getOperand(2));
                        }
                    }
                }
            }
            if 32 <= EltBits && DAG.MaskedVectorIsZero(N, getHighBitsSet(NumElts, NumElts - 1), 0) {
                return DAG.getNode(VZEXT_MOVL, DL, VT, if N.getConstantOperandVal(2) & 1 { N1 } else { N0 });
            }
            return SDValue {};
        },
        SHUFP => {
            if VT == v4f32 {
                let mut Updated: bool = false;
                let mut Mask: SmallVector<int> = SmallVector<int> {};
                let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> {};
                if getTargetShuffleMask(N, false, Ops, Mask) && Ops.len == 2 {
                    for let mut i: i32 = 0; i != 2; i += 1 {
                        let mut SubOps: SmallVector<SDValue> = SmallVector<SDValue> {};
                        let mut SubMask: SmallVector<int> = SmallVector<int> {};
                        let mut SubScaledMask: SmallVector<int> = SmallVector<int> {};
                        let mut Sub: SDValue = peekThroughBitcasts(Ops[i]);
                        if getTargetShuffleInputs(Sub, SubOps, SubMask, DAG, 0, false) && scaleShuffleElements(SubMask, 4, SubScaledMask) && SubOps.len == 1 && isUndefOrInRange(SubScaledMask, 0, 4) {
                            let mut Ofs: i32 = i * 2;
                            Mask[Ofs + 0] = SubScaledMask[Mask[Ofs + 0] % 4] + (i * 4);
                            Mask[Ofs + 1] = SubScaledMask[Mask[Ofs + 1] % 4] + (i * 4);
                            Ops[i] = DAG.getBitcast(VT, SubOps[0]);
                            Updated = true;
                        }
                    }
                }
                if Updated {
                    for M in Mask {
                        M %= 4;
                    }
                    Ops.push(getV4X86ShuffleImm8ForMask(Mask, DL, DAG));
                    return DAG.getNode(SHUFP, DL, VT, Ops);
                }
            }
            return SDValue {};
        },
        VPERMI => {
            let mut N0: SDValue = N.getOperand(0);
            let mut N1: SDValue = N.getOperand(1);
            let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
            if N0.getOpcode() == BITCAST && N0.getOperand(0).getScalarValueSizeInBits() == EltSizeInBits {
                let mut Src: SDValue = N0.getOperand(0);
                let mut SrcVT: EVT = Src.getValueType();
                let mut Res: SDValue = DAG.getNode(VPERMI, DL, SrcVT, Src, N1);
                return DAG.getBitcast(VT, Res);
            }
            return SDValue {};
        },
        SHUF128 => {
            if VT.is512BitVector() {
                let mut LHS: SDValue = peekThroughBitcasts(operator(N).getOperand(0));
                let mut RHS: SDValue = peekThroughBitcasts(operator(N).getOperand(1));
                let mut Mask: u64 = operator(N).getConstantOperandVal(2);
                if Mask == 68 && LHS.getValueType() == RHS.getValueType() && LHS.getValueType().isSimple() {
                    let mut LHSOps: SmallVector<SDValue> = SmallVector<SDValue> {};
                    let mut RHSOps: SmallVector<SDValue> = SmallVector<SDValue> {};
                    if collectConcatOps(LHS.getNode(), LHSOps, DAG) && collectConcatOps(RHS.getNode(), RHSOps, DAG) && LHSOps.len == 2 && RHSOps.len == 2 {
                        if combineConcatVectorOps(DL, LHS.getSimpleValueType(), [LHSOps[0], RHSOps[0]], DAG, Subtarget, 0) {
                            Concat;
                        } else {
                            return DAG.getBitcast(VT, Concat);
                        }
                    }
                }
                let mut LHSOps: SmallVector<SDValue> = SmallVector<SDValue> {};
                let mut RHSOps: SmallVector<SDValue> = SmallVector<SDValue> {};
                let mut NewLHS: SDValue = SDValue {};
                let mut NewRHS: SDValue = SDValue {};
                if (Mask & 10) == 10 && collectConcatOps(LHS.getNode(), LHSOps, DAG) && LHSOps.len == 2 {
                    NewLHS = widenSubVector(LHSOps[1], false, Subtarget, DAG, DL, 512);
                    Mask &= ~10;
                }
                if (Mask & 160) == 160 && collectConcatOps(RHS.getNode(), RHSOps, DAG) && RHSOps.len == 2 {
                    NewRHS = widenSubVector(RHSOps[1], false, Subtarget, DAG, DL, 512);
                    Mask &= ~160;
                }
                if NewLHS || NewRHS {
                    return DAG.getNode(SHUF128, DL, VT, DAG.getBitcast(VT, if NewLHS { NewLHS } else { LHS }), DAG.getBitcast(VT, if NewRHS { NewRHS } else { RHS }), DAG.getTargetConstant(Mask, DL, i8, false));
                }
            }
            return SDValue {};
        },
        VPERM2X128 => {
            let mut LHS: SDValue = operator(N).getOperand(0);
            let mut RHS: SDValue = operator(N).getOperand(1);
            let mut Imm: u32 = N.getConstantOperandVal(2) & 255;
            if LHS.isUndef() && !RHS.isUndef() {
                return DAG.getNode(VPERM2X128, DL, VT, RHS, LHS, DAG.getTargetConstant(Imm ^ 34, DL, i8, false));
            }
            if LHS == RHS {
                return DAG.getNode(VPERM2X128, DL, VT, LHS, DAG.getUNDEF(VT), DAG.getTargetConstant(Imm & ~34, DL, i8, false));
            }
            if LHS.getOpcode() == BITCAST && (RHS.getOpcode() == BITCAST || RHS.isUndef()) {
                let mut SrcVT: EVT = LHS.getOperand(0).getValueType();
                if RHS.isUndef() || SrcVT == RHS.getOperand(0).getValueType() {
                    return DAG.getBitcast(VT, DAG.getNode(VPERM2X128, DL, SrcVT, DAG.getBitcast(SrcVT, LHS), DAG.getBitcast(SrcVT, RHS), operator(N).getOperand(2)));
                }
            }
            if canonicalizeLaneShuffleWithRepeatedOps(N, DAG, DL, Subtarget) {
                Res;
            } else {
                return Res;
            }
            let mut FindSubVector128: Closure_163 = Closure_163 { N: &mut N, DAG: &mut DAG };
            if FindSubVector128.call(Imm & 15) {
                SubLo;
            } else {
                if FindSubVector128.call((Imm & 240) >> 4) {
                    SubHi;
                } else {
                    let mut SubVT: MVT = VT.getHalfNumVectorElementsVT();
                    SubLo = DAG.getBitcast(SubVT, SubLo);
                    SubHi = DAG.getBitcast(SubVT, SubHi);
                    return DAG.getNode(CONCAT_VECTORS, DL, VT, SubLo, SubHi);
                }
            }
            if RHS.isUndef() {
                let mut Mask: SmallVector<int, 4> = SmallVector<int, 4> {};
                DecodeVPERM2X128Mask(4, Imm, Mask);
                if isUndefOrInRange(Mask, 0, 4) {
                    let mut SplatLo: bool = isShuffleEquivalent(Mask, [0, 1, 0, 1], LHS, SDValue {});
                    let mut SplatHi: bool = isShuffleEquivalent(Mask, [2, 3, 2, 3], LHS, SDValue {});
                    if (SplatLo || SplatHi) && !Subtarget.hasAVX512() && mayFoldLoad(LHS, Subtarget, true, false) {
                        let mut MemVT: MVT = VT.getHalfNumVectorElementsVT();
                        let mut Ofs: u32 = if SplatLo { 0 } else { MemVT.getStoreSize().operator unsigned long long() };
                        return getBROADCAST_LOAD(SUBV_BROADCAST_LOAD, DL, VT, MemVT, cast(LHS), Ofs, DAG);
                    }
                }
            }
            return SDValue {};
        },
        PSHUFD => {
            let mut Mask: SmallVector<int, 4> = getPSHUFShuffleMask(N);
            assert!(Mask.len == 4);
            return combineRedundantDWordShuffle(N, Mask, DL, DAG);
        },
        PSHUFLW => {
            PSHUFHW;
        },
        MOVSD => {
            MOVSH;
        },
        INSERTPS => {
            assert!(VT == v4f32, "INSERTPS ValueType must be MVT::v4f32");
            let mut Op0: SDValue = N.getOperand(0);
            let mut Op1: SDValue = N.getOperand(1);
            let mut InsertPSMask: u32 = N.getConstantOperandVal(2);
            let mut SrcIdx: u32 = (InsertPSMask >> 6) & 3;
            let mut DstIdx: u32 = (InsertPSMask >> 4) & 3;
            let mut ZeroMask: u32 = InsertPSMask & 15;
            if Op0.getOpcode() == INSERTPS && Op0.getOperand(1) == Op1 {
                let mut InnerPSMask: u32 = Op0.getConstantOperandVal(2);
                let mut InnerSrcIdx: u32 = (InnerPSMask >> 6) & 3;
                let mut InnerDstIdx: u32 = (InnerPSMask >> 4) & 3;
                let mut InnerZeroMask: u32 = InnerPSMask & 15;
                if SrcIdx == InnerSrcIdx && ZeroMask == 0 && InnerZeroMask == 0 {
                    let mut SplatMask: SmallVector<int, 4> = SmallVector<int, 4> { 4, SrcIdx as i32 };
                    Op1 = DAG.getNode(SHUFP, DL, VT, Op1, Op1, getV4X86ShuffleImm8ForMask(SplatMask, DL, DAG));
                    let mut BlendMask: u32 = (1 << DstIdx) | (1 << InnerDstIdx);
                    return DAG.getNode(BLENDI, DL, VT, Op0, Op1, DAG.getTargetConstant(BlendMask, DL, i8, false));
                }
            }
            if Op1.getOpcode() == VBROADCAST_LOAD && Op1.hasOneUse() {
                let mut MemIntr: *mut MemIntrinsicSDNode = cast(Op1);
                if MemIntr.getMemoryVT().getScalarSizeInBits() == 32 {
                    let mut Load: SDValue = DAG.getLoad(f32, DL, MemIntr.getChain(), MemIntr.getBasePtr(), MemIntr.getMemOperand());
                    let mut Insert: SDValue = DAG.getNode(INSERTPS, DL, VT, Op0, DAG.getNode(SCALAR_TO_VECTOR, DL, VT, Load), DAG.getTargetConstant(InsertPSMask & 63, DL, i8, false));
                    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: MemIntr, ResNo: 1 }, Load.getValue(1));
                    return Insert;
                }
            }
            return SDValue {};
        },
        COMPRESS => {
            let mut CmpVec: SDValue = N.getOperand(0);
            let mut PassThru: SDValue = N.getOperand(1);
            if CmpVec == PassThru && DAG.isSplatValue(CmpVec, false) {
                return CmpVec;
            }
            return SDValue {};
        },
        EXPAND => {
            let mut ExpVec: SDValue = N.getOperand(0);
            let mut PassThru: SDValue = N.getOperand(1);
            let mut ExpMask: SDValue = N.getOperand(2);
            if dyn_cast(peekThroughBitcasts(ExpMask)) {
                Msk;
            } else if Msk.getAPIntValue().isMask() {
                return DAG.getSelect(DL, VT, ExpMask, ExpVec, PassThru, SDNodeFlags { Flags: None });
            }
            if DAG.isSplatValue(ExpVec, false) {
                return DAG.getSelect(DL, VT, ExpMask, ExpVec, PassThru, SDNodeFlags { Flags: None });
            }
            return SDValue {};
        },
        VPERMV => {
            let mut Mask: SmallVector<int, 32> = SmallVector<int, 32> {};
            let mut SrcOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
            let mut SubOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
            let mut Src: SDValue = peekThroughBitcasts(N.getOperand(1));
            if (Subtarget.hasVLX() || VT.is512BitVector()) && getTargetShuffleMask(N, false, SrcOps, Mask) && collectConcatOps(Src.getNode(), SubOps, DAG) {
                assert!(Mask.len == NumElts, "Unexpected shuffle mask size");
                assert!(SrcOps.len == 1, "Unexpected shuffle ops");
                assert!((SubOps.len == 2 || SubOps.len == 4), "Unexpected split ops");
                if SubOps[1].isUndef() && (SubOps.len == 2 || (SubOps[2].isUndef() && SubOps[3].isUndef())) {
                    return SDValue {};
                }
                if any_of(SubOps, isShuffleFoldableLoad) {
                    return SDValue {};
                }
                if SubOps.len == 4 {
                    SubOps[0] = concatSubVectors(SubOps[0], SubOps[1], DAG, DL);
                    SubOps[1] = concatSubVectors(SubOps[2], SubOps[3], DAG, DL);
                }
                let mut HalfElts: i32 = NumElts / 2;
                for M in Mask {
                    M += if M >= HalfElts { HalfElts } else { 0 };
                }
                let mut Lo: SDValue = widenSubVector(SubOps[0], false, Subtarget, DAG, DL, VT.getSizeInBits().operator unsigned long long());
                let mut Hi: SDValue = widenSubVector(SubOps[1], false, Subtarget, DAG, DL, VT.getSizeInBits().operator unsigned long long());
                return lowerShuffleWithPERMV(DL, VT, Mask, DAG.getBitcast(VT, Lo), DAG.getBitcast(VT, Hi), Subtarget, DAG);
            }
            return SDValue {};
        },
        VPERMV3 => {
            let mut WideVT: MVT = VT.getDoubleNumVectorElementsVT();
            let mut CanConcat: bool = VT.is128BitVector() || (VT.is256BitVector() && Subtarget.useAVX512Regs());
            let mut SrcOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
            let mut Mask: SmallVector<int, 32> = SmallVector<int, 32> {};
            if getTargetShuffleMask(N, false, SrcOps, Mask) {
                assert!(Mask.len == NumElts, "Unexpected shuffle mask size");
                let mut V1: SDValue = peekThroughBitcasts(N.getOperand(0));
                let mut V2: SDValue = peekThroughBitcasts(N.getOperand(2));
                if V1 == V2 {
                    for M in Mask {
                        M = (if M < 0 { M } else { (M & (NumElts - 1)) });
                    }
                    return lowerShuffleWithPERMV(DL, VT, Mask, N.getOperand(0), DAG.getUNDEF(VT), Subtarget, DAG);
                }
                let mut Ops: [2]SDValue = [2]SDValue {};
                if sd_match(V1, m_InsertSubvector(m_Undef(), m_Value(Ops[0]), m_Zero(false))) && sd_match(V2, m_InsertSubvector(m_Undef(), m_Value(Ops[1]), m_Zero(false))) && (Ops[0].getValueSizeInBits().operator unsigned long long() % VT.getScalarSizeInBits()) == 0 && Ops[0].getValueType() == Ops[1].getValueType() && Ops[0].getValueType().isSimple() {
                    let mut SubVT: MVT = Ops[0].getSimpleValueType();
                    let mut ConcatVT: MVT = SubVT.getDoubleNumVectorElementsVT();
                    let mut NumSubElts: u32 = SubVT.getSizeInBits().operator unsigned long long() / VT.getScalarSizeInBits();
                    if combineConcatVectorOps(DL, ConcatVT, Ops, DAG, Subtarget, 0) {
                        ConcatSrc;
                    } else {
                        ConcatSrc = widenSubVector(ConcatSrc, false, Subtarget, DAG, DL, VT.getSizeInBits().operator unsigned long long());
                        for M in Mask {
                            M = (if M < NumElts as i32 { M } else { (M - (NumElts - NumSubElts)) });
                        }
                        return lowerShuffleWithPERMV(DL, VT, Mask, DAG.getBitcast(VT, ConcatSrc), DAG.getUNDEF(VT), Subtarget, DAG);
                    }
                }
                if isShuffleFoldableLoad(N.getOperand(0)) && !isShuffleFoldableLoad(N.getOperand(2)) {
                    commuteMask(Mask);
                    return lowerShuffleWithPERMV(DL, VT, Mask, N.getOperand(2), N.getOperand(0), Subtarget, DAG);
                }
                if CanConcat {
                    if combineConcatVectorOps(DL, WideVT, [N.getOperand(2), N.getOperand(0)], DAG, Subtarget, 0) {
                        ConcatSrc;
                    } else {
                        commuteMask(Mask);
                        Mask.append(NumElts, SM_SentinelUndef);
                        let mut Perm: SDValue = lowerShuffleWithPERMV(DL, WideVT, Mask, ConcatSrc, DAG.getUNDEF(WideVT), Subtarget, DAG);
                        return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Perm, DAG.getVectorIdxConstant(0, DL, false));
                    }
                }
            }
            if CanConcat {
                if combineConcatVectorOps(DL, WideVT, [N.getOperand(0), N.getOperand(2)], DAG, Subtarget, 0) {
                    ConcatSrc;
                } else {
                    let mut Mask: SDValue = widenSubVector(N.getOperand(1), false, Subtarget, DAG, DL, WideVT.getSizeInBits().operator unsigned long long());
                    let mut Perm: SDValue = DAG.getNode(VPERMV, DL, WideVT, Mask, ConcatSrc);
                    return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Perm, DAG.getVectorIdxConstant(0, DL, false));
                }
            }
            return SDValue {};
        },
    }
    return SDValue {};
}

fn isAddSubOrSubAddMask(Mask: ArrayRef<int>, Op0Even: *mut bool) -> bool {
    let mut ParitySrc: [2]i32 = [-1, -1];
    let mut Size: u32 = Mask.len;
    for let mut i: u32 = 0; i != Size; i += 1 {
        let mut M: i32 = Mask[i];
        if M < 0 {
            continue;
        }
        if (M % Size) != i {
            return false;
        }
        let mut Src: i32 = M / Size;
        if ParitySrc[i % 2] >= 0 && ParitySrc[i % 2] != Src {
            return false;
        }
        ParitySrc[i % 2] = Src;
    }
    if ParitySrc[0] < 0 || ParitySrc[1] < 0 || ParitySrc[0] == ParitySrc[1] {
        return false;
    }
    Op0Even = ParitySrc[0] == 0;
    return true;
}

fn isAddSubOrSubAdd(N: *mut SDNode, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, Opnd0: *mut SDValue, Opnd1: *mut SDValue, IsSubAdd: *mut bool, HasAllowContract: *mut bool) -> bool {
    let mut VT: EVT = N.getValueType(0);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !Subtarget.hasSSE3() || !TLI.isTypeLegal(VT) || !VT.getSimpleVT().isFloatingPoint() {
        return false;
    }
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
    let mut OpInputs: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    if !getTargetShuffleInputs(SDValue { Node: N, ResNo: 0 }, OpInputs, Mask, DAG, 0, true) || OpInputs.len != 2 || isAnyZero(Mask) || OpInputs[0].getValueType() != VT || OpInputs[1].getValueType() != VT {
        return false;
    }
    let mut V1: SDValue = OpInputs[0];
    let mut V2: SDValue = OpInputs[1];
    if (V1.getOpcode() != FADD && V1.getOpcode() != FSUB) || (V2.getOpcode() != FADD && V2.getOpcode() != FSUB) || V1.getOpcode() == V2.getOpcode() {
        return false;
    }
    if !operator(V1).hasOneUse() || !operator(V2).hasOneUse() {
        return false;
    }
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if V1.getOpcode() == FSUB {
        LHS = operator(V1).getOperand(0);
        RHS = operator(V1).getOperand(1);
        if (operator(V2).getOperand(0) != LHS || operator(V2).getOperand(1) != RHS) && (operator(V2).getOperand(0) != RHS || operator(V2).getOperand(1) != LHS) {
            return false;
        }
    } else {
        assert!(V2.getOpcode() == FSUB, "Unexpected opcode");
        LHS = operator(V2).getOperand(0);
        RHS = operator(V2).getOperand(1);
        if (operator(V1).getOperand(0) != LHS || operator(V1).getOperand(1) != RHS) && (operator(V1).getOperand(0) != RHS || operator(V1).getOperand(1) != LHS) {
            return false;
        }
    }
    let mut Op0Even: bool = false;
    if !isAddSubOrSubAddMask(Mask, Op0Even) {
        return false;
    }
    IsSubAdd = if Op0Even { operator(V1).getOpcode() == FADD } else { operator(V2).getOpcode() == FADD };
    HasAllowContract = operator(V1).getFlags().hasAllowContract() && operator(V2).getFlags().hasAllowContract();
    Opnd0 = LHS;
    Opnd1 = RHS;
    return true;
}

fn combineShuffleToFMAddSub(N: *mut SDNode, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !Subtarget.hasAnyFMA() || !TLI.isTypeLegal(VT) {
        return SDValue {};
    }
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
    let mut OpInputs: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    if !getTargetShuffleInputs(SDValue { Node: N, ResNo: 0 }, OpInputs, Mask, DAG, 0, true) || OpInputs.len != 2 || isAnyZero(Mask) || OpInputs[0].getValueType() != VT || OpInputs[1].getValueType() != VT {
        return SDValue {};
    }
    let mut Op0: SDValue = OpInputs[0];
    let mut Op1: SDValue = OpInputs[1];
    let mut FMAdd: SDValue = Op0;
    let mut FMSub: SDValue = Op1;
    if FMSub.getOpcode() != FMSUB {
        swap(FMAdd, FMSub);
    }
    if FMAdd.getOpcode() != FMA || FMSub.getOpcode() != FMSUB || FMAdd.getOperand(0) != FMSub.getOperand(0) || !FMAdd.hasOneUse() || FMAdd.getOperand(1) != FMSub.getOperand(1) || !FMSub.hasOneUse() || FMAdd.getOperand(2) != FMSub.getOperand(2) {
        return SDValue {};
    }
    let mut Op0Even: bool = false;
    if !isAddSubOrSubAddMask(Mask, Op0Even) {
        return SDValue {};
    }
    let mut IsSubAdd: bool = if Op0Even { Op0 == FMAdd } else { Op1 == FMAdd };
    let mut Opcode: u32 = if IsSubAdd { FMSUBADD } else { FMADDSUB };
    return DAG.getNode(Opcode, DL, VT, FMAdd.getOperand(0), FMAdd.getOperand(1), FMAdd.getOperand(2));
}

fn combineShuffleToAddSubOrFMAddSub(N: *mut SDNode, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if combineShuffleToFMAddSub(N, DL, Subtarget, DAG) {
        V;
    } else {
        return V;
    }
    let mut Opnd0: SDValue = SDValue {};
    let mut Opnd1: SDValue = SDValue {};
    let mut IsSubAdd: bool = false;
    let mut HasAllowContract: bool = false;
    if !isAddSubOrSubAdd(N, Subtarget, DAG, Opnd0, Opnd1, IsSubAdd, HasAllowContract) {
        return SDValue {};
    }
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut Opnd2: SDValue = SDValue {};
    if isFMAddSubOrFMSubAdd(Subtarget, Opnd0, Opnd1, Opnd2, 2, HasAllowContract) {
        let mut Opc: u32 = if IsSubAdd { FMSUBADD } else { FMADDSUB };
        return DAG.getNode(Opc, DL, VT, Opnd0, Opnd1, Opnd2);
    }
    if IsSubAdd {
        return SDValue {};
    }
    if VT.is512BitVector() {
        return SDValue {};
    }
    if VT.getVectorElementType() == f16 {
        return SDValue {};
    }
    return DAG.getNode(ADDSUB, DL, VT, Opnd0, Opnd1);
}

fn narrowShuffle(Shuf: *mut ShuffleVectorSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Shuf.getValueType(0);
    if !DAG.getTargetLoweringInfo().isTypeLegal(Shuf.getValueType(0)) {
        return SDValue {};
    }
    if !VT.is256BitVector() && !VT.is512BitVector() {
        return SDValue {};
    }
    let mut Mask: ArrayRef<int> = Shuf.getMask();
    if !isUndefUpperHalf(Mask) {
        return SDValue {};
    }
    let mut HalfIdx1: i32 = 0;
    let mut HalfIdx2: i32 = 0;
    let mut HalfMask: SmallVector<int, 8> = Mask.len / 2;
    if !getHalfShuffleMask(Mask, HalfMask, HalfIdx1, HalfIdx2) || (HalfIdx1 % 2 == 1) || (HalfIdx2 % 2 == 1) {
        return SDValue {};
    }
    return getShuffleHalfVectors(Shuf, Shuf.getOperand(0), Shuf.getOperand(1), HalfMask, HalfIdx1, HalfIdx2, false, DAG, true);
}

fn combineShuffle(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if dyn_cast(N) {
        Shuf;
    } else if narrowShuffle(Shuf, DAG) {
        V;
    } else {
        return V;
    }
    let mut dl: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.isTypeLegal(VT) && !isSoftF16(VT, Subtarget) {
        if combineShuffleToAddSubOrFMAddSub(N, dl, Subtarget, DAG) {
            AddSub;
        } else {
            return AddSub;
        }
    }
    if combineToConsecutiveLoads(VT, SDValue { Node: N, ResNo: 0 }, dl, DAG, Subtarget, true) {
        LD;
    } else {
        return LD;
    }
    if isTargetShuffle(N.getOpcode()) {
        let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
        if combineTargetShuffle(Op, dl, DAG, DCI, Subtarget) {
            Shuffle;
        } else {
            return Shuffle;
        }
        if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
            Res;
        } else {
            return Res;
        }
        let mut DemandedElts: APInt = getAllOnes(VT.getVectorNumElements());
        if TLI.SimplifyDemandedVectorElts(Op, DemandedElts, DCI) {
            return SDValue { Node: N, ResNo: 0 };
        }
        if canonicalizeShuffleWithOp(Op, DAG, dl) {
            BinOp;
        } else {
            return BinOp;
        }
    }
    return SDValue {};
}

fn X86TargetLowering::SimplifyDemandedVectorEltsForTargetShuffle(self: *X86TargetLowering, Op: SDValue, DemandedElts: *APInt, MaskIndex: u32, TLO: *mut TargetLoweringOpt, Depth: u32) -> bool {
    let mut NumElts: u32 = DemandedElts.getBitWidth();
    if DemandedElts.isAllOnes() {
        return false;
    }
    let mut Mask: SDValue = Op.getOperand(MaskIndex);
    if !Mask.hasOneUse() {
        return false;
    }
    let mut MaskUndef: APInt = APInt {};
    let mut MaskZero: APInt = APInt {};
    if self.SimplifyDemandedVectorElts(Mask, DemandedElts, MaskUndef, MaskZero, TLO, Depth + 1, false) {
        return true;
    }
    let mut BC: SDValue = peekThroughOneUseBitcasts(Mask);
    let mut BCVT: EVT = BC.getValueType();
    let mut Load: *mut LoadSDNode = dyn_cast(BC);
    if !Load || !Load.getBasePtr().hasOneUse() {
        return false;
    }
    let mut C: *Constant = getTargetConstantFromNode(Load);
    if !C {
        return false;
    }
    let mut CTy: *mut Type = C.getType();
    if !CTy.isVectorTy() || CTy.getPrimitiveSizeInBits() != Mask.getValueSizeInBits() {
        return false;
    }
    let mut NumCstElts: u32 = cast(CTy).getNumElements();
    if NumCstElts != NumElts && NumCstElts != (NumElts * 2) {
        return false;
    }
    let mut Scale: u32 = NumCstElts / NumElts;
    let mut Simplified: bool = false;
    let mut ConstVecOps: SmallVector<Constant *, 32> = SmallVector<Constant *, 32> {};
    for let mut i: u32 = 0; i != NumCstElts; i += 1 {
        let mut Elt: *mut Constant = C.getAggregateElement(i);
        if !DemandedElts[i / Scale] && !isa(Elt) {
            ConstVecOps.push(get(Elt.getType()));
            Simplified = true;
            continue;
        }
        ConstVecOps.push(Elt);
    }
    if !Simplified {
        return false;
    }
    let mut DL: SDLoc = Op;
    let mut CV: SDValue = TLO.DAG.getConstantPool(get(ConstVecOps), BCVT, nullopt, 0, false, 0);
    let mut LegalCV: SDValue = self.LowerConstantPool(CV, TLO.DAG);
    let mut NewMask: SDValue = TLO.DAG.getLoad(BCVT, DL, TLO.DAG.getEntryNode(), LegalCV, getConstantPool(TLO.DAG.getMachineFunction()), Load.getAlign(), MONone, MMOMetadata {});
    return TLO.CombineTo(Mask, TLO.DAG.getBitcast(Mask.getValueType(), NewMask));
}

fn X86TargetLowering::SimplifyDemandedVectorEltsForTargetNode(self: *X86TargetLowering, Op: SDValue, DemandedElts: *APInt, KnownUndef: *mut APInt, KnownZero: *mut APInt, TLO: *mut TargetLoweringOpt, Depth: u32) -> bool {
    let mut NumElts: i32 = DemandedElts.getBitWidth();
    let mut Opc: u32 = Op.getOpcode();
    let mut VT: EVT = Op.getValueType();
    match Opc {
        PMULDQ => {
            PMULUDQ;
        },
        VPMADDUBSW => {
            VPMADDWD;
        },
        PCLMULQDQ => {
            let mut LHSUndef: APInt = APInt {};
            let mut LHSZero: APInt = APInt {};
            let mut RHSUndef: APInt = APInt {};
            let mut RHSZero: APInt = APInt {};
            let mut LHS: SDValue = Op.getOperand(0);
            let mut RHS: SDValue = Op.getOperand(1);
            let mut Imm: u64 = Op.getConstantOperandVal(2);
            assert!(VT.getScalarType() == i64 && LHS.getValueType() == VT && LHS.getValueType() == RHS.getValueType(), "Unexpected PCLMULQDQ types");
            let mut DemandedLHS: APInt = getSplat(NumElts, APInt { 2, if (Imm & 1) { 2 } else { 1 }, false, false });
            let mut DemandedRHS: APInt = getSplat(NumElts, APInt { 2, if (Imm & 16) { 2 } else { 1 }, false, false });
            if self.SimplifyDemandedVectorElts(LHS, DemandedLHS, LHSUndef, LHSZero, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedVectorElts(RHS, DemandedRHS, RHSUndef, RHSZero, TLO, Depth + 1, false) {
                return true;
            }
            let mut NewLHS: SDValue = self.SimplifyMultipleUseDemandedVectorElts(LHS, DemandedLHS, TLO.DAG, Depth + 1);
            let mut NewRHS: SDValue = self.SimplifyMultipleUseDemandedVectorElts(RHS, DemandedRHS, TLO.DAG, Depth + 1);
            if NewLHS || NewRHS {
                NewLHS = if NewLHS { NewLHS } else { LHS };
                NewRHS = if NewRHS { NewRHS } else { RHS };
                return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, Op, VT, NewLHS, NewRHS, Op.getOperand(2)));
            }
            break;
        },
        PSADBW => {
            let mut LHSUndef: APInt = APInt {};
            let mut LHSZero: APInt = APInt {};
            let mut RHSUndef: APInt = APInt {};
            let mut RHSZero: APInt = APInt {};
            let mut LHS: SDValue = Op.getOperand(0);
            let mut RHS: SDValue = Op.getOperand(1);
            assert!(VT.getScalarType() == i64 && LHS.getValueType() == RHS.getValueType() && LHS.getValueType().getScalarType() == i8, "Unexpected PSADBW types");
            let mut DemandedSrcElts: APInt = ScaleBitMask(DemandedElts, NumElts * 8, false);
            if self.SimplifyDemandedVectorElts(LHS, DemandedSrcElts, LHSUndef, LHSZero, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedVectorElts(RHS, DemandedSrcElts, RHSUndef, RHSZero, TLO, Depth + 1, false) {
                return true;
            }
            if !DemandedElts.isAllOnes() {
                let mut NewLHS: SDValue = self.SimplifyMultipleUseDemandedVectorElts(LHS, DemandedSrcElts, TLO.DAG, Depth + 1);
                let mut NewRHS: SDValue = self.SimplifyMultipleUseDemandedVectorElts(RHS, DemandedSrcElts, TLO.DAG, Depth + 1);
                if NewLHS || NewRHS {
                    NewLHS = if NewLHS { NewLHS } else { LHS };
                    NewRHS = if NewRHS { NewRHS } else { RHS };
                    return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, Op, VT, NewLHS, NewRHS));
                }
            }
            break;
        },
        VSHL => {
            VSRL;
        },
        VSHLI => {
            VSRLI;
        },
        VPSHA => {
            VPSHL;
        },
        CMPM => {
            CMPP;
        },
        PCMPEQ => {
            PCMPGT;
        },
        KSHIFTL => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut Amt: *mut ConstantSDNode = cast(Op.getOperand(1));
            assert!(Amt.getAPIntValue().ult(NumElts), "Out of range shift amount");
            let mut ShiftAmt: u32 = Amt.getZExtValue();
            if ShiftAmt == 0 {
                return TLO.CombineTo(Op, Src);
            }
            if Src.getOpcode() == KSHIFTR {
                if !DemandedElts.intersects(getLowBitsSet(NumElts, ShiftAmt)) {
                    let mut C1: u32 = Src.getConstantOperandVal(1);
                    let mut NewOpc: u32 = KSHIFTL;
                    let mut Diff: i32 = ShiftAmt - C1;
                    if Diff < 0 {
                        Diff = -Diff;
                        NewOpc = KSHIFTR;
                    }
                    let mut dl: SDLoc = Op;
                    let mut NewSA: SDValue = TLO.DAG.getTargetConstant(Diff, dl, i8, false);
                    return TLO.CombineTo(Op, TLO.DAG.getNode(NewOpc, dl, VT, Src.getOperand(0), NewSA));
                }
            }
            let mut DemandedSrc: APInt = DemandedElts.lshr(ShiftAmt);
            if self.SimplifyDemandedVectorElts(Src, DemandedSrc, KnownUndef, KnownZero, TLO, Depth + 1, false) {
                return true;
            }
            operator(KnownUndef, ShiftAmt);
            operator(KnownZero, ShiftAmt);
            KnownZero.setLowBits(ShiftAmt);
            break;
        },
        KSHIFTR => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut Amt: *mut ConstantSDNode = cast(Op.getOperand(1));
            assert!(Amt.getAPIntValue().ult(NumElts), "Out of range shift amount");
            let mut ShiftAmt: u32 = Amt.getZExtValue();
            if ShiftAmt == 0 {
                return TLO.CombineTo(Op, Src);
            }
            if Src.getOpcode() == KSHIFTL {
                if !DemandedElts.intersects(getHighBitsSet(NumElts, ShiftAmt)) {
                    let mut C1: u32 = Src.getConstantOperandVal(1);
                    let mut NewOpc: u32 = KSHIFTR;
                    let mut Diff: i32 = ShiftAmt - C1;
                    if Diff < 0 {
                        Diff = -Diff;
                        NewOpc = KSHIFTL;
                    }
                    let mut dl: SDLoc = Op;
                    let mut NewSA: SDValue = TLO.DAG.getTargetConstant(Diff, dl, i8, false);
                    return TLO.CombineTo(Op, TLO.DAG.getNode(NewOpc, dl, VT, Src.getOperand(0), NewSA));
                }
            }
            let mut DemandedSrc: APInt = DemandedElts.shl(ShiftAmt);
            if self.SimplifyDemandedVectorElts(Src, DemandedSrc, KnownUndef, KnownZero, TLO, Depth + 1, false) {
                return true;
            }
            KnownUndef.lshrInPlace(ShiftAmt);
            KnownZero.lshrInPlace(ShiftAmt);
            KnownZero.setHighBits(ShiftAmt);
            break;
        },
        ANDNP => {
            let mut LHS: SDValue = Op.getOperand(0);
            let mut RHS: SDValue = Op.getOperand(1);
            let mut GetDemandedMasks: Closure_164 = Closure_164 { VT: &mut VT, DemandedElts: &mut DemandedElts };
            let mut BitsLHS: APInt = APInt {};
            let mut EltsLHS: APInt = APInt {};
            let mut BitsRHS: APInt = APInt {};
            let mut EltsRHS: APInt = APInt {};
            tie(BitsLHS, EltsLHS) = GetDemandedMasks.call(RHS, false);
            tie(BitsRHS, EltsRHS) = GetDemandedMasks.call(LHS, true);
            let mut LHSUndef: APInt = APInt {};
            let mut LHSZero: APInt = APInt {};
            let mut RHSUndef: APInt = APInt {};
            let mut RHSZero: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(LHS, EltsLHS, LHSUndef, LHSZero, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedVectorElts(RHS, EltsRHS, RHSUndef, RHSZero, TLO, Depth + 1, false) {
                return true;
            }
            if !DemandedElts.isAllOnes() {
                let mut NewLHS: SDValue = self.SimplifyMultipleUseDemandedBits(LHS, BitsLHS, EltsLHS, TLO.DAG, Depth + 1);
                let mut NewRHS: SDValue = self.SimplifyMultipleUseDemandedBits(RHS, BitsRHS, EltsRHS, TLO.DAG, Depth + 1);
                if NewLHS || NewRHS {
                    NewLHS = if NewLHS { NewLHS } else { LHS };
                    NewRHS = if NewRHS { NewRHS } else { RHS };
                    return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, Op, VT, NewLHS, NewRHS));
                }
            }
            break;
        },
        CVTSI2P => {
            CVTUI2P;
        },
        PACKSS => {
            PACKUS;
        },
        HADD => {
            HSUB;
        },
        VTRUNC => {
            VTRUNCS;
        },
        BLENDI => {
            let mut BlendMask: SmallVector<int, 16> = SmallVector<int, 16> {};
            DecodeBLENDMask(NumElts, Op.getConstantOperandVal(2), BlendMask);
            if combineBlendOfPermutes(VT.getSimpleVT(), Op.getOperand(0), Op.getOperand(1), BlendMask, DemandedElts, TLO.DAG, self.Subtarget, Op) {
                R;
            } else {
                return TLO.CombineTo(Op, R);
            }
            break;
        },
        BLENDV => {
            let mut SelUndef: APInt = APInt {};
            let mut SelZero: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(Op.getOperand(0), DemandedElts, SelUndef, SelZero, TLO, Depth + 1, false) {
                return true;
            }
            let mut LHSUndef: APInt = APInt {};
            let mut LHSZero: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(Op.getOperand(1), DemandedElts, LHSUndef, LHSZero, TLO, Depth + 1, false) {
                return true;
            }
            let mut RHSUndef: APInt = APInt {};
            let mut RHSZero: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(Op.getOperand(2), DemandedElts, RHSUndef, RHSZero, TLO, Depth + 1, false) {
                return true;
            }
            KnownZero = LHSZero & RHSZero;
            KnownUndef = LHSUndef & RHSUndef;
            break;
        },
        VZEXT_MOVL => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut DemandedUpperElts: APInt = DemandedElts;
            DemandedUpperElts.clearLowBits(1);
            if TLO.DAG.MaskedVectorIsZero(Src, DemandedUpperElts, Depth + 1) {
                return TLO.CombineTo(Op, Src);
            }
            break;
        },
        VZEXT_LOAD => {
            let mut SVT: MVT = VT.getSimpleVT().getVectorElementType();
            if DemandedElts == 1 && Op.getValue(1).use_empty() && self.isTypeLegal(SVT) {
                let mut DL: SDLoc = Op;
                let mut Mem: *mut MemSDNode = cast(Op);
                let mut Elt: SDValue = TLO.DAG.getLoad(SVT, DL, Mem.getChain(), Mem.getBasePtr(), Mem.getMemOperand());
                let mut Vec: SDValue = TLO.DAG.getNode(SCALAR_TO_VECTOR, DL, VT, Elt);
                return TLO.CombineTo(Op, TLO.DAG.getBitcast(VT, Vec));
            }
            break;
        },
        VBROADCAST => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: MVT = Src.getSimpleValueType();
            if DemandedElts == 1 {
                if !SrcVT.isVector() {
                    Src = TLO.DAG.getNode(SCALAR_TO_VECTOR, Op, VT, Src);
                } else if Src.getValueType() != VT {
                    Src = widenSubVector(VT.getSimpleVT(), Src, false, self.Subtarget, TLO.DAG, Op);
                }
                return TLO.CombineTo(Op, Src);
            }
            if !SrcVT.isVector() {
                break;
            }
            let mut SrcUndef: APInt = APInt {};
            let mut SrcZero: APInt = APInt {};
            let mut SrcElts: APInt = getOneBitSet(SrcVT.getVectorNumElements(), 0);
            if self.SimplifyDemandedVectorElts(Src, SrcElts, SrcUndef, SrcZero, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyMultipleUseDemandedVectorElts(Src, SrcElts, TLO.DAG, Depth + 1) {
                NewSrc;
            } else {
                return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, Op, VT, NewSrc));
            }
            break;
        },
        VPERMV => {
            if self.SimplifyDemandedVectorEltsForTargetShuffle(Op, DemandedElts, 0, TLO, Depth) {
                return true;
            }
        },
        PSHUFB => {
            VPERMV3;
        },
        VPPERM => {
            VPERMIL2;
        },
    }
    if (VT.is256BitVector() || VT.is512BitVector()) && DemandedElts.lshr(NumElts / 2) == 0 {
        let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
        let mut ExtSizeInBits: u32 = SizeInBits / 2;
        if VT.is512BitVector() && DemandedElts.lshr(NumElts / 4) == 0 {
            ExtSizeInBits = SizeInBits / 4;
        }
        match Opc {
            VBROADCAST => {
                let mut DL: SDLoc = Op;
                let mut Src: SDValue = Op.getOperand(0);
                if Src.getValueSizeInBits().operator unsigned long long() > ExtSizeInBits {
                    Src = extractSubVector(Src, 0, TLO.DAG, DL, ExtSizeInBits);
                }
                let mut BcstVT: EVT = getVectorVT(*TLO.DAG.getContext(), VT.getScalarType(), ExtSizeInBits / VT.getScalarSizeInBits(), false);
                let mut Bcst: SDValue = TLO.DAG.getNode(VBROADCAST, DL, BcstVT, Src);
                return TLO.CombineTo(Op, insertSubVector(TLO.DAG.getUNDEF(VT), Bcst, 0, TLO.DAG, DL, ExtSizeInBits));
            },
            VBROADCAST_LOAD => {
                let mut DL: SDLoc = Op;
                let mut MemIntr: *mut MemIntrinsicSDNode = cast(Op);
                let mut BcstVT: EVT = getVectorVT(*TLO.DAG.getContext(), VT.getScalarType(), ExtSizeInBits / VT.getScalarSizeInBits(), false);
                let mut Tys: SDVTList = TLO.DAG.getVTList(BcstVT, Other);
                let mut Ops: [2]SDValue = [MemIntr.getOperand(0), MemIntr.getOperand(1)];
                let mut Bcst: SDValue = TLO.DAG.getMemIntrinsicNode(VBROADCAST_LOAD, DL, Tys, Ops, MemIntr.getMemoryVT(), MemIntr.getMemOperand());
                TLO.DAG.makeEquivalentMemoryOrdering(SDValue { Node: MemIntr, ResNo: 1 }, Bcst.getValue(1));
                return TLO.CombineTo(Op, insertSubVector(TLO.DAG.getUNDEF(VT), Bcst, 0, TLO.DAG, DL, ExtSizeInBits));
            },
            SUBV_BROADCAST_LOAD => {
                let mut MemIntr: *mut MemIntrinsicSDNode = cast(Op);
                let mut MemVT: EVT = MemIntr.getMemoryVT();
                if ExtSizeInBits == MemVT.getStoreSizeInBits().operator unsigned long long() {
                    let mut DL: SDLoc = Op;
                    let mut Ld: SDValue = TLO.DAG.getLoad(MemVT, DL, MemIntr.getChain(), MemIntr.getBasePtr(), MemIntr.getMemOperand());
                    TLO.DAG.makeEquivalentMemoryOrdering(SDValue { Node: MemIntr, ResNo: 1 }, Ld.getValue(1));
                    return TLO.CombineTo(Op, insertSubVector(TLO.DAG.getUNDEF(VT), Ld, 0, TLO.DAG, DL, ExtSizeInBits));
                } else if (ExtSizeInBits % MemVT.getStoreSizeInBits().operator unsigned long long()) == 0 {
                    let mut DL: SDLoc = Op;
                    let mut BcstVT: EVT = getVectorVT(*TLO.DAG.getContext(), VT.getScalarType(), ExtSizeInBits / VT.getScalarSizeInBits(), false);
                    if getBROADCAST_LOAD(Opc, DL, BcstVT, MemVT, MemIntr, 0, TLO.DAG) {
                        BcstLd;
                    } else {
                        return TLO.CombineTo(Op, insertSubVector(TLO.DAG.getUNDEF(VT), BcstLd, 0, TLO.DAG, DL, ExtSizeInBits));
                    }
                }
                break;
            },
            VSHLDQ => {
                VSRLDQ;
            },
            VPERMI => {
                if VT == v4f64 || VT == v4i64 {
                    let mut Mask: SmallVector<int, 4> = SmallVector<int, 4> {};
                    DecodeVPERMMask(NumElts, Op.getConstantOperandVal(1), Mask);
                    if isUndefOrEqual(Mask[0], 2) && isUndefOrEqual(Mask[1], 3) {
                        let mut DL: SDLoc = Op;
                        let mut Ext: SDValue = extractSubVector(Op.getOperand(0), 2, TLO.DAG, DL, 128);
                        let mut UndefVec: SDValue = TLO.DAG.getUNDEF(VT);
                        let mut Insert: SDValue = insertSubVector(UndefVec, Ext, 0, TLO.DAG, DL, 128);
                        return TLO.CombineTo(Op, Insert);
                    }
                }
                if VT == v8f64 || VT == v8i64 {
                    let mut DL: SDLoc = Op;
                    let mut Ext0: SDValue = extractSubVector(Op.getOperand(0), 0, TLO.DAG, DL, 256);
                    let mut ExtOp: SDValue = TLO.DAG.getNode(Opc, DL, Ext0.getValueType(), Ext0, Op.getOperand(1));
                    let mut UndefVec: SDValue = TLO.DAG.getUNDEF(VT);
                    let mut Insert: SDValue = insertSubVector(UndefVec, ExtOp, 0, TLO.DAG, DL, 256);
                    return TLO.CombineTo(Op, Insert);
                }
                break;
            },
            VPERMV => {
                let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
                let mut Ops: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
                if (VT.is256BitVector() || self.Subtarget.hasVLX() || VT == v16i32 || VT == v16f32) && getTargetShuffleMask(Op, false, Ops, Mask) {
                    let mut HalfElts: u32 = NumElts / 2;
                    let mut HalfSize: u32 = SizeInBits / 2;
                    Mask.resize(HalfElts);
                    if all_of(Mask, Closure_165 { HalfElts: &mut HalfElts }) {
                        let mut HalfVT: MVT = VT.getSimpleVT().getHalfNumVectorElementsVT();
                        let mut DL: SDLoc = Op;
                        let mut Ext: SDValue = SDValue {};
                        let mut M: SDValue = extractSubVector(Op.getOperand(0), 0, TLO.DAG, DL, HalfSize);
                        let mut V: SDValue = extractSubVector(Op.getOperand(1), 0, TLO.DAG, DL, HalfSize);
                        if VT.is512BitVector() || VT.getScalarSizeInBits() <= 16 {
                            Ext = TLO.DAG.getNode(Opc, DL, HalfVT, M, V);
                        } else {
                            let mut ShufSVT: MVT = getFloatingPointVT(VT.getScalarSizeInBits());
                            let mut ShufVT: MVT = HalfVT.changeVectorElementType(ShufSVT);
                            Ext = TLO.DAG.getNode(VPERMILPV, DL, ShufVT, TLO.DAG.getBitcast(ShufVT, V), M);
                            Ext = TLO.DAG.getBitcast(HalfVT, Ext);
                        }
                        let mut Insert: SDValue = widenSubVector(Ext, false, self.Subtarget, TLO.DAG, DL, SizeInBits);
                        return TLO.CombineTo(Op, Insert);
                    }
                }
                break;
            },
            VPERMV3 => {
                let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
                let mut Ops: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
                if self.Subtarget.hasVLX() && getTargetShuffleMask(Op, false, Ops, Mask) {
                    let mut HalfElts: u32 = NumElts / 2;
                    let mut HalfSize: u32 = SizeInBits / 2;
                    Mask.resize(HalfElts);
                    if all_of(Mask, Closure_166 { HalfElts: &mut HalfElts, NumElts: &mut NumElts }) {
                        for M in Mask {
                            M = if (M < NumElts) { M } else { (M - HalfElts) };
                        }
                        let mut HalfVT: MVT = VT.getSimpleVT().getHalfNumVectorElementsVT();
                        let mut HalfIntVT: MVT = HalfVT.changeVectorElementTypeToInteger();
                        let mut DL: SDLoc = Op;
                        let mut Ext: SDValue = TLO.DAG.getNode(Opc, DL, HalfVT, extractSubVector(Op.getOperand(0), 0, TLO.DAG, DL, HalfSize), getConstVector(Mask, HalfIntVT, TLO.DAG, DL, true), extractSubVector(Op.getOperand(2), 0, TLO.DAG, DL, HalfSize));
                        let mut Insert: SDValue = widenSubVector(Ext, false, self.Subtarget, TLO.DAG, DL, SizeInBits);
                        return TLO.CombineTo(Op, Insert);
                    }
                }
                break;
            },
            VPERM2X128 => {
                let mut DL: SDLoc = Op;
                let mut LoMask: u32 = Op.getConstantOperandVal(2) & 15;
                if LoMask & 8 {
                    return TLO.CombineTo(Op, getZeroVector(VT.getSimpleVT(), self.Subtarget, TLO.DAG, DL));
                }
                let mut EltIdx: u32 = (LoMask & 1) * (NumElts / 2);
                let mut SrcIdx: u32 = (LoMask & 2) >> 1;
                let mut ExtOp: SDValue = extractSubVector(Op.getOperand(SrcIdx), EltIdx, TLO.DAG, DL, 128);
                let mut UndefVec: SDValue = TLO.DAG.getUNDEF(VT);
                let mut Insert: SDValue = insertSubVector(UndefVec, ExtOp, 0, TLO.DAG, DL, ExtSizeInBits);
                return TLO.CombineTo(Op, Insert);
            },
            CVTTP2UI => {
                if !self.Subtarget.hasVLX() {
                    break;
                }
            },
            CVTTP2SI => {
                if Op.getOperand(0).getValueType().getVectorElementType() == f16 && !self.Subtarget.hasVLX() {
                    break;
                }
            },
            CVTPH2PS => {
                let mut DL: SDLoc = Op;
                let mut Scale: u32 = SizeInBits / ExtSizeInBits;
                let mut SrcOp: SDValue = Op.getOperand(0);
                let mut SrcVT: MVT = SrcOp.getSimpleValueType();
                let mut SrcExtSize: u32 = if SrcVT.getSizeInBits().operator unsigned long long() / Scale > 128 { SrcVT.getSizeInBits().operator unsigned long long() / Scale } else { 128 };
                let mut ExtVT: MVT = getVectorVT(VT.getSimpleVT().getScalarType(), ExtSizeInBits / VT.getScalarSizeInBits());
                let mut ExtOp: SDValue = TLO.DAG.getNode(Opc, DL, ExtVT, extractSubVector(SrcOp, 0, TLO.DAG, DL, SrcExtSize));
                let mut UndefVec: SDValue = TLO.DAG.getUNDEF(VT);
                let mut Insert: SDValue = insertSubVector(UndefVec, ExtOp, 0, TLO.DAG, DL, ExtSizeInBits);
                return TLO.CombineTo(Op, Insert);
            },
            VZEXT_MOVL => {
                BLENDV;
            },
        }
    }
    if !DemandedElts.isOne() && TLO.DAG.isSplatValue(Op, false) {
        return false;
    }
    let mut OpUndef: APInt = APInt {};
    let mut OpZero: APInt = APInt {};
    let mut OpMask: SmallVector<int, 64> = SmallVector<int, 64> {};
    let mut OpInputs: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    if !getTargetShuffleInputs(Op, DemandedElts, OpInputs, OpMask, OpUndef, OpZero, TLO.DAG, Depth, false) {
        return false;
    }
    if OpMask.len != NumElts as u32 || any_of(OpInputs, Closure_167 { cap_0: VT }) {
        return false;
    }
    KnownZero = OpZero;
    KnownUndef = OpUndef;
    let mut NumSrcs: i32 = OpInputs.len;
    for let mut i: i32 = 0; i != NumElts; i += 1 {
        if !DemandedElts[i] {
            OpMask[i] = SM_SentinelUndef;
        }
    }
    if isUndefInRange(OpMask, 0, NumElts) {
        KnownUndef.setAllBits();
        return TLO.CombineTo(Op, TLO.DAG.getUNDEF(VT));
    }
    if isUndefOrZeroInRange(OpMask, 0, NumElts) {
        KnownZero.setAllBits();
        return TLO.CombineTo(Op, getZeroVector(VT.getSimpleVT(), self.Subtarget, TLO.DAG, Op));
    }
    for let mut Src: i32 = 0; Src != NumSrcs; Src += 1 {
        if isSequentialOrUndefInRange(OpMask, 0, NumElts, Src * NumElts, 1) {
            return TLO.CombineTo(Op, TLO.DAG.getBitcast(VT, OpInputs[Src]));
        }
    }
    for let mut Src: i32 = 0; Src != NumSrcs; Src += 1 {
        if OpInputs[Src].getValueType() != VT {
            continue;
        }
        let mut Lo: i32 = Src * NumElts;
        let mut SrcElts: APInt = getZero(NumElts);
        for let mut i: i32 = 0; i != NumElts; i += 1 {
            if DemandedElts[i] {
                let mut M: i32 = OpMask[i] - Lo;
                if 0 <= M && M < NumElts {
                    SrcElts.setBit(M);
                }
            }
        }
        let mut SrcUndef: APInt = APInt {};
        let mut SrcZero: APInt = APInt {};
        if self.SimplifyDemandedVectorElts(OpInputs[Src], SrcElts, SrcUndef, SrcZero, TLO, Depth + 1, false) {
            return true;
        }
    }
    if !DemandedElts.isAllOnes() {
        assert!(Depth < MaxShuffleCombineDepth, "Depth out of range");
        let mut DemandedMask: SmallVector<int, 64> = SmallVector<int, 64> { NumElts, SM_SentinelUndef };
        for let mut i: i32 = 0; i != NumElts; i += 1 {
            if DemandedElts[i] {
                DemandedMask[i] = i;
            }
        }
        let mut NewShuffle: SDValue = combineX86ShufflesRecursively([Op], 0, Op.getOpcode(), Op.getSimpleValueType(), DemandedMask, ArrayRef<const SDNode *> {}, 0, MaxShuffleCombineDepth - Depth, true, true, isMaskableNode(Op, self.Subtarget), TLO.DAG, Op, self.Subtarget);
        if NewShuffle {
            return TLO.CombineTo(Op, NewShuffle);
        }
    }
    return false;
}

fn X86TargetLowering::getPreferredShrunkVectorSizeInBits(self: *X86TargetLowering, Op: SDValue, DemandedElts: *APInt) -> u32 {
    let mut VT: EVT = Op.getValueType();
    let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut NumElts: u32 = VT.getVectorNumElements();
    match Op.getOpcode() {
        FSUB => {
            FMUL;
        },
        _ => {
            return 0;
        },
    }
    if SizeInBits == 512 && DemandedElts.lshr(NumElts / 4) == 0 {
        return SizeInBits / 4;
    }
    if (SizeInBits == 256 || SizeInBits == 512) && DemandedElts.lshr(NumElts / 2) == 0 {
        return SizeInBits / 2;
    }
    return 0;
}

fn X86TargetLowering::SimplifyDemandedBitsForTargetNode(self: *X86TargetLowering, Op: SDValue, OriginalDemandedBits: *APInt, OriginalDemandedElts: *APInt, Known: *mut KnownBits, TLO: *mut TargetLoweringOpt, Depth: u32) -> bool {
    let mut VT: EVT = Op.getValueType();
    let mut BitWidth: u32 = OriginalDemandedBits.getBitWidth();
    let mut Opc: u32 = Op.getOpcode();
    match Opc {
        VTRUNC => {
            let mut KnownOp: KnownBits = KnownBits {};
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: MVT = Src.getSimpleValueType();
            let mut TruncMask: APInt = OriginalDemandedBits.zext(SrcVT.getScalarSizeInBits());
            let mut DemandedElts: APInt = OriginalDemandedElts.trunc(SrcVT.getVectorNumElements());
            if self.SimplifyDemandedBits(Src, TruncMask, DemandedElts, KnownOp, TLO, Depth + 1, false) {
                return true;
            }
            break;
        },
        PMULDQ => {
            PMULUDQ;
        },
        ANDNP => {
            let mut Known2: KnownBits = KnownBits {};
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            if self.SimplifyDemandedBits(Op1, OriginalDemandedBits, OriginalDemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedBits(Op0, operator(Known.Zero) & OriginalDemandedBits, OriginalDemandedElts, Known2, TLO, Depth + 1, false) {
                return true;
            }
            if self.ShrinkDemandedConstant(Op, operator(Known2.One) & OriginalDemandedBits, OriginalDemandedElts, TLO) {
                return true;
            }
            operator(Known.One, Known2.Zero);
            operator(Known.Zero, Known2.One);
            break;
        },
        VSHLI => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut ShAmt: u32 = operator(Op1).getAsZExtVal();
            if ShAmt >= BitWidth {
                break;
            }
            let mut DemandedMask: APInt = OriginalDemandedBits.lshr(ShAmt);
            if Op0.getOpcode() == VSRLI && OriginalDemandedBits.countr_zero() >= ShAmt {
                let mut Shift2Amt: u32 = Op0.getConstantOperandVal(1);
                if Shift2Amt < BitWidth {
                    let mut Diff: i32 = ShAmt - Shift2Amt;
                    if Diff == 0 {
                        return TLO.CombineTo(Op, Op0.getOperand(0));
                    }
                    let mut NewOpc: u32 = if Diff < 0 { VSRLI } else { VSHLI };
                    let mut NewShift: SDValue = TLO.DAG.getNode(NewOpc, Op, VT, Op0.getOperand(0), TLO.DAG.getTargetConstant(if Diff < 0 { -Diff } else { Diff }, Op, i8, false));
                    return TLO.CombineTo(Op, NewShift);
                }
            }
            let mut NumSignBits: u32 = TLO.DAG.ComputeNumSignBits(Op0, OriginalDemandedElts, Depth + 1);
            let mut UpperDemandedBits: u32 = BitWidth - OriginalDemandedBits.countr_zero();
            if NumSignBits > ShAmt && (NumSignBits - ShAmt) >= UpperDemandedBits {
                return TLO.CombineTo(Op, Op0);
            }
            if self.SimplifyDemandedBits(Op0, DemandedMask, OriginalDemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            operator(Known, ShAmt);
            Known.Zero.setLowBits(ShAmt);
            if !OriginalDemandedBits.isSubsetOf(Known.Zero | Known.One) {
                if self.SimplifyMultipleUseDemandedBits(Op0, DemandedMask, OriginalDemandedElts, TLO.DAG, Depth + 1) {
                    DemandedOp0;
                } else {
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), Op, VT, DemandedOp0, Op1);
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            return false;
        },
        VSRLI => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut ShAmt: u32 = operator(Op1).getAsZExtVal();
            if ShAmt >= BitWidth {
                break;
            }
            let mut DemandedMask: APInt = OriginalDemandedBits << ShAmt;
            if self.SimplifyDemandedBits(Op0, DemandedMask, OriginalDemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            operator(Known, ShAmt);
            Known.Zero.setHighBits(ShAmt);
            if !OriginalDemandedBits.isSubsetOf(Known.Zero | Known.One) {
                if self.SimplifyMultipleUseDemandedBits(Op0, DemandedMask, OriginalDemandedElts, TLO.DAG, Depth + 1) {
                    DemandedOp0;
                } else {
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), Op, VT, DemandedOp0, Op1);
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            return false;
        },
        VSRAI => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut ShAmt: u32 = operator(Op1).getAsZExtVal();
            if ShAmt >= BitWidth {
                break;
            }
            let mut DemandedMask: APInt = OriginalDemandedBits << ShAmt;
            let mut NumHiDemandedBits: u32 = BitWidth - OriginalDemandedBits.countr_zero();
            if TLO.DAG.ComputeNumSignBits(Op0, OriginalDemandedElts, Depth + 1) >= NumHiDemandedBits {
                return TLO.CombineTo(Op, Op0);
            }
            if Op0.getOpcode() == VSHLI && Op1 == Op0.getOperand(1) {
                let mut Op00: SDValue = Op0.getOperand(0);
                let mut NumSignBits: u32 = TLO.DAG.ComputeNumSignBits(Op00, OriginalDemandedElts, 0);
                if ShAmt < NumSignBits {
                    return TLO.CombineTo(Op, Op00);
                }
            }
            if OriginalDemandedBits.countl_zero() < ShAmt {
                DemandedMask.setSignBit();
            }
            if self.SimplifyDemandedBits(Op0, DemandedMask, OriginalDemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            operator(Known, ShAmt);
            if Known.Zero[BitWidth - ShAmt - 1] || OriginalDemandedBits.countl_zero() >= ShAmt {
                return TLO.CombineTo(Op, TLO.DAG.getNode(VSRLI, Op, VT, Op0, Op1));
            }
            if Known.One[BitWidth - ShAmt - 1] {
                Known.One.setHighBits(ShAmt);
            }
            if !OriginalDemandedBits.isSubsetOf(Known.Zero | Known.One) {
                if self.SimplifyMultipleUseDemandedBits(Op0, DemandedMask, OriginalDemandedElts, TLO.DAG, Depth + 1) {
                    DemandedOp0;
                } else {
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), Op, VT, DemandedOp0, Op1);
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            return false;
        },
        BLENDI => {
            let mut LHS: SDValue = Op.getOperand(0);
            let mut RHS: SDValue = Op.getOperand(1);
            let mut Mask: APInt = getBLENDIBlendMask(Op);
            let mut DemandedEltsLHS: APInt = OriginalDemandedElts & operator(Mask);
            if self.SimplifyDemandedBits(LHS, OriginalDemandedBits, DemandedEltsLHS, Known, TLO, Depth + 1, false) {
                return true;
            }
            let mut DemandedEltsRHS: APInt = OriginalDemandedElts & Mask;
            if self.SimplifyDemandedBits(RHS, OriginalDemandedBits, DemandedEltsRHS, Known, TLO, Depth + 1, false) {
                return true;
            }
            let mut NewLHS: SDValue = self.SimplifyMultipleUseDemandedBits(LHS, OriginalDemandedBits, DemandedEltsLHS, TLO.DAG, Depth + 1);
            let mut NewRHS: SDValue = self.SimplifyMultipleUseDemandedBits(RHS, OriginalDemandedBits, DemandedEltsRHS, TLO.DAG, Depth + 1);
            if NewLHS || NewRHS {
                NewLHS = if NewLHS { NewLHS } else { LHS };
                NewRHS = if NewRHS { NewRHS } else { RHS };
                return TLO.CombineTo(Op, TLO.DAG.getNode(Op.getOpcode(), Op, VT, NewLHS, NewRHS, Op.getOperand(2)));
            }
            break;
        },
        BLENDV => {
            let mut Sel: SDValue = Op.getOperand(0);
            let mut LHS: SDValue = Op.getOperand(1);
            let mut RHS: SDValue = Op.getOperand(2);
            let mut SignMask: APInt = getSignMask(BitWidth);
            let mut NewSel: SDValue = self.SimplifyMultipleUseDemandedBits(Sel, SignMask, OriginalDemandedElts, TLO.DAG, Depth + 1);
            let mut NewLHS: SDValue = self.SimplifyMultipleUseDemandedBits(LHS, OriginalDemandedBits, OriginalDemandedElts, TLO.DAG, Depth + 1);
            let mut NewRHS: SDValue = self.SimplifyMultipleUseDemandedBits(RHS, OriginalDemandedBits, OriginalDemandedElts, TLO.DAG, Depth + 1);
            if NewSel || NewLHS || NewRHS {
                NewSel = if NewSel { NewSel } else { Sel };
                NewLHS = if NewLHS { NewLHS } else { LHS };
                NewRHS = if NewRHS { NewRHS } else { RHS };
                return TLO.CombineTo(Op, TLO.DAG.getNode(BLENDV, Op, VT, NewSel, NewLHS, NewRHS));
            }
            break;
        },
        PEXTRB => {
            PEXTRW;
        },
        PINSRB => {
            PINSRW;
        },
        PACKSS => {
            if OriginalDemandedBits.isSignMask() {
                let mut DemandedLHS: APInt = APInt {};
                let mut DemandedRHS: APInt = APInt {};
                getPackDemandedElts(VT, OriginalDemandedElts, DemandedLHS, DemandedRHS);
                let mut KnownLHS: KnownBits = KnownBits {};
                let mut KnownRHS: KnownBits = KnownBits {};
                let mut SignMask: APInt = getSignMask(BitWidth * 2);
                if self.SimplifyDemandedBits(Op.getOperand(0), SignMask, DemandedLHS, KnownLHS, TLO, Depth + 1, false) {
                    return true;
                }
                if self.SimplifyDemandedBits(Op.getOperand(1), SignMask, DemandedRHS, KnownRHS, TLO, Depth + 1, false) {
                    return true;
                }
                let mut DemandedOp0: SDValue = self.SimplifyMultipleUseDemandedBits(Op.getOperand(0), SignMask, DemandedLHS, TLO.DAG, Depth + 1);
                let mut DemandedOp1: SDValue = self.SimplifyMultipleUseDemandedBits(Op.getOperand(1), SignMask, DemandedRHS, TLO.DAG, Depth + 1);
                if DemandedOp0 || DemandedOp1 {
                    let mut Op0: SDValue = if DemandedOp0 { DemandedOp0 } else { Op.getOperand(0) };
                    let mut Op1: SDValue = if DemandedOp1 { DemandedOp1 } else { Op.getOperand(1) };
                    return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, Op, VT, Op0, Op1));
                }
            }
        },
        VBROADCAST => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: MVT = Src.getSimpleValueType();
            let mut DemandedElts: APInt = getOneBitSet(if SrcVT.isVector() { SrcVT.getVectorNumElements() } else { 1 }, 0);
            if self.SimplifyDemandedBits(Src, OriginalDemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            if (BitWidth == 64) && SrcVT.isScalarInteger() && !self.Subtarget.hasAVX512() && OriginalDemandedBits.countl_zero() >= (BitWidth / 2) && operator(Src).hasOneUse() {
                let mut NewSrcVT: MVT = getIntegerVT(BitWidth / 2);
                let mut NewSrc: SDValue = TLO.DAG.getNode(TRUNCATE, Src, NewSrcVT, Src);
                let mut NewVT: MVT = getVectorVT(NewSrcVT, VT.getVectorNumElements() * 2);
                let mut NewBcst: SDValue = TLO.DAG.getNode(VBROADCAST, Op, NewVT, NewSrc);
                return TLO.CombineTo(Op, TLO.DAG.getBitcast(VT, NewBcst));
            }
            break;
        },
        PCMPGT => {
            if isBuildVectorAllZeros(Op.getOperand(0).getNode()) {
                if OriginalDemandedBits.isSignMask() {
                    return TLO.CombineTo(Op, Op.getOperand(1));
                }
                let mut SignMask: APInt = getSignMask(BitWidth);
                if self.SimplifyDemandedBits(Op.getOperand(1), SignMask, OriginalDemandedElts, Known, TLO, Depth + 1, false) {
                    return true;
                }
            }
        },
        MOVMSK => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: MVT = Src.getSimpleValueType();
            let mut SrcBits: u32 = SrcVT.getScalarSizeInBits();
            let mut NumElts: u32 = SrcVT.getVectorNumElements();
            if OriginalDemandedBits.countr_zero() >= NumElts {
                return TLO.CombineTo(Op, TLO.DAG.getConstant(0, Op, VT, false, false));
            }
            if SrcVT.is256BitVector() && OriginalDemandedBits.getActiveBits() <= (NumElts / 2) {
                let mut NewSrc: SDValue = extract128BitVector(Src, 0, TLO.DAG, Src);
                return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, Op, VT, NewSrc));
            }
            let mut KnownUndef: APInt = APInt {};
            let mut KnownZero: APInt = APInt {};
            let mut DemandedElts: APInt = OriginalDemandedBits.zextOrTrunc(NumElts);
            if self.SimplifyDemandedVectorElts(Src, DemandedElts, KnownUndef, KnownZero, TLO, Depth + 1, false) {
                return true;
            }
            Known.Zero = KnownZero.zext(BitWidth);
            Known.Zero.setHighBits(BitWidth - NumElts);
            let mut KnownSrc: KnownBits = KnownBits {};
            let mut DemandedSrcBits: APInt = getSignMask(SrcBits);
            if self.SimplifyDemandedBits(Src, DemandedSrcBits, DemandedElts, KnownSrc, TLO, Depth + 1, false) {
                return true;
            }
            if KnownSrc.One[SrcBits - 1] {
                Known.One.setLowBits(NumElts);
            } else if KnownSrc.Zero[SrcBits - 1] {
                Known.Zero.setLowBits(NumElts);
            }
            if self.SimplifyMultipleUseDemandedBits(Src, DemandedSrcBits, DemandedElts, TLO.DAG, Depth + 1) {
                NewSrc;
            } else {
                return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, Op, VT, NewSrc));
            }
            return false;
        },
        TESTP => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut OpVT: MVT = Op0.getSimpleValueType();
            assert!((OpVT.getVectorElementType() == f32 || OpVT.getVectorElementType() == f64), "Illegal vector type for X86ISD::TESTP");
            let mut KnownSrc: KnownBits = KnownBits {};
            let mut SignMask: APInt = getSignMask(OpVT.getScalarSizeInBits());
            let mut AssumeSingleUse: bool = (Op0 == Op1) && operator(Op).isOnlyUserOf(Op0.getNode());
            return self.SimplifyDemandedBits(Op0, SignMask, KnownSrc, TLO, Depth + 1, AssumeSingleUse) || self.SimplifyDemandedBits(Op1, SignMask, KnownSrc, TLO, Depth + 1, AssumeSingleUse);
        },
        CMOV => {
            let mut Known2: KnownBits = KnownBits {};
            if self.SimplifyDemandedBits(Op.getOperand(1), OriginalDemandedBits, OriginalDemandedElts, Known2, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedBits(Op.getOperand(0), OriginalDemandedBits, OriginalDemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            let mut KnownFalseVal: KnownBits = Known & makeConstant(OriginalDemandedBits);
            let mut KnownTrueVal: KnownBits = Known2 & makeConstant(OriginalDemandedBits);
            if KnownFalseVal.isZero() && KnownTrueVal.isConstant() && KnownTrueVal.getConstant().isOne() && Op.getValueType().isScalarInteger() {
                let mut DL: SDLoc = Op;
                let mut CC: CondCode = Op.getConstantOperandVal(2) as CondCode;
                let mut SetCC: SDValue = getSETCC(CC, Op.getOperand(3), DL, TLO.DAG);
                return TLO.CombineTo(Op, TLO.DAG.getNode(ZERO_EXTEND, DL, Op.getValueType(), SetCC));
            }
            Known = Known.intersectWith(Known2);
            return false;
        },
        BEXTR => {
            BEXTRI;
        },
        VPMADD52L => {
            VPMADD52H;
        },
    }
    return self.SimplifyDemandedBitsForTargetNode(Op, OriginalDemandedBits, OriginalDemandedElts, Known, TLO, Depth);
}

fn X86TargetLowering::SimplifyMultipleUseDemandedBitsForTargetNode(self: *X86TargetLowering, Op: SDValue, DemandedBits: *APInt, DemandedElts: *APInt, DAG: *mut SelectionDAG, Depth: u32) -> SDValue {
    let mut NumElts: i32 = DemandedElts.getBitWidth();
    let mut Opc: u32 = Op.getOpcode();
    let mut VT: EVT = Op.getValueType();
    match Opc {
        PINSRB => {
            PINSRW;
        },
        VSHLI => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut ShAmt: u32 = Op.getConstantOperandVal(1);
            let mut BitWidth: u32 = DemandedBits.getBitWidth();
            let mut NumSignBits: u32 = DAG.ComputeNumSignBits(Op0, DemandedElts, Depth + 1);
            let mut UpperDemandedBits: u32 = BitWidth - DemandedBits.countr_zero();
            if NumSignBits > ShAmt && (NumSignBits - ShAmt) >= UpperDemandedBits {
                return Op0;
            }
            break;
        },
        VSRAI => {
            if DemandedBits.isSignMask() {
                return Op.getOperand(0);
            }
        },
        PCMPGT => {
            if DemandedBits.isSignMask() && isBuildVectorAllZeros(Op.getOperand(0).getNode()) {
                return Op.getOperand(1);
            }
        },
        BLENDV => {
            let mut Cond: SDValue = Op.getOperand(0);
            let mut LHS: SDValue = Op.getOperand(1);
            let mut RHS: SDValue = Op.getOperand(2);
            let mut CondKnown: KnownBits = DAG.computeKnownBits(Cond, DemandedElts, Depth + 1);
            if CondKnown.isNegative() {
                return LHS;
            }
            if CondKnown.isNonNegative() {
                return RHS;
            }
            break;
        },
        ANDNP => {
            let mut LHS: SDValue = Op.getOperand(0);
            let mut RHS: SDValue = Op.getOperand(1);
            let mut LHSKnown: KnownBits = DAG.computeKnownBits(LHS, DemandedElts, Depth + 1);
            let mut RHSKnown: KnownBits = DAG.computeKnownBits(RHS, DemandedElts, Depth + 1);
            if DemandedBits.isSubsetOf(RHSKnown.Zero | LHSKnown.Zero) {
                return RHS;
            }
            break;
        },
    }
    let mut ShuffleUndef: APInt = APInt {};
    let mut ShuffleZero: APInt = APInt {};
    let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> {};
    let mut ShuffleOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    if getTargetShuffleInputs(Op, DemandedElts, ShuffleOps, ShuffleMask, ShuffleUndef, ShuffleZero, DAG, Depth, false) {
        let mut NumOps: i32 = ShuffleOps.len;
        if ShuffleMask.len == NumElts as u32 && all_of(ShuffleOps, Closure_168 { cap_0: VT }) {
            if DemandedElts.isSubsetOf(ShuffleUndef) {
                return DAG.getUNDEF(VT);
            }
            if DemandedElts.isSubsetOf(ShuffleUndef | ShuffleZero) {
                return getZeroVector(VT.getSimpleVT(), self.Subtarget, DAG, Op);
            }
            let mut IdentityOp: APInt = getAllOnes(NumOps);
            for let mut i: i32 = 0; i != NumElts; i += 1 {
                let mut M: i32 = ShuffleMask[i];
                if !DemandedElts[i] || ShuffleUndef[i] {
                    continue;
                }
                let mut OpIdx: i32 = M / NumElts;
                let mut EltIdx: i32 = M % NumElts;
                if M < 0 || EltIdx != i {
                    IdentityOp.clearAllBits();
                    break;
                }
                operator(IdentityOp, getOneBitSet(NumOps, OpIdx));
                if IdentityOp == 0 {
                    break;
                }
            }
            assert!((IdentityOp == 0 || IdentityOp.popcount() == 1), "Multiple identity shuffles detected");
            if IdentityOp != 0 {
                return DAG.getBitcast(VT, ShuffleOps[IdentityOp.countr_zero()]);
            }
        }
    }
    return self.SimplifyMultipleUseDemandedBitsForTargetNode(Op, DemandedBits, DemandedElts, DAG, Depth);
}

fn X86TargetLowering::isGuaranteedNotToBeUndefOrPoisonForTargetNode(self: *X86TargetLowering, Op: SDValue, DemandedElts: *APInt, DAG: *SelectionDAG, Kind: UndefPoisonKind, Depth: u32) -> bool {
    let mut NumElts: u32 = DemandedElts.getBitWidth();
    match Op.getOpcode() {
        GlobalBaseReg => {
            Wrapper;
        },
        PACKSS => {
            PACKUS;
        },
        INSERTPS => {
            BLENDI;
        },
        VBROADCAST => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: MVT = Src.getSimpleValueType();
            if SrcVT.isVector() {
                let mut DemandedSrc: APInt = getOneBitSet(SrcVT.getVectorNumElements(), 0);
                return DAG.isGuaranteedNotToBeUndefOrPoison(Src, DemandedSrc, Kind, Depth + 1);
            }
            return DAG.isGuaranteedNotToBeUndefOrPoison(Src, Kind, Depth + 1);
        },
    }
    return self.isGuaranteedNotToBeUndefOrPoisonForTargetNode(Op, DemandedElts, DAG, Kind, Depth);
}

fn X86TargetLowering::canCreateUndefOrPoisonForTargetNode(self: *X86TargetLowering, Op: SDValue, DemandedElts: *APInt, DAG: *SelectionDAG, Kind: UndefPoisonKind, ConsiderFlags: bool, Depth: u32) -> bool {
    match Op.getOpcode() {
        FAND => {
            FOR;
        },
        PINSRB => {
            PINSRW;
        },
        VPMADDUBSW => {
            VPMADDWD;
        },
        VSHLI => {
            VSRLI;
        },
        BLENDI => {
            BLENDV;
        },
        PACKSS => {
            PACKUS;
        },
        INSERTPS => {
            PSHUFB;
        },
        CMPP => {
            PCMPEQ;
        },
        MOVMSK => {
            return false;
        },
        GF2P8AFFINEINVQB => {
            GF2P8AFFINEQB;
        },
        INTRINSIC_WO_CHAIN => {
            match operator(Op).getConstantOperandVal(0) {
                x86_sse2_pmadd_wd => {
                    x86_avx2_pmadd_wd;
                },
                x86_avx512_vpermi2var_d_128 => {
                    x86_avx512_vpermi2var_d_256;
                },
            }
        },
    }
    return self.canCreateUndefOrPoisonForTargetNode(Op, DemandedElts, DAG, Kind, ConsiderFlags, Depth);
}

fn X86TargetLowering::isSplatValueForTargetNode(self: *X86TargetLowering, Op: SDValue, DemandedElts: *APInt, UndefElts: *mut APInt, DAG: *SelectionDAG, Depth: u32) -> bool {
    let mut NumElts: u32 = DemandedElts.getBitWidth();
    let mut Opc: u32 = Op.getOpcode();
    match Opc {
        VBROADCAST => {
            VBROADCAST_LOAD;
        },
        VSHL => {
            VSRA;
        },
    }
    return self.isSplatValueForTargetNode(Op, DemandedElts, UndefElts, DAG, Depth);
}

fn checkBitcastSrcVectorSize(Src: SDValue, Size: u32, AllowTruncate: bool, Depth: u32) -> bool {
    if Depth >= MaxRecursionDepth {
        return false;
    }
    match Src.getOpcode() {
        TRUNCATE => {
            if !AllowTruncate {
                return false;
            }
        },
        SETCC => {
            return Src.getOperand(0).getValueSizeInBits().operator unsigned long long() == Size;
        },
        FREEZE => {
            return checkBitcastSrcVectorSize(Src.getOperand(0), Size, AllowTruncate, Depth + 1);
        },
        AND => {
            XOR;
        },
        SELECT => {
            VSELECT;
        },
        BUILD_VECTOR => {
            return isBuildVectorAllZeros(Src.getNode()) || isBuildVectorAllOnes(Src.getNode());
        },
    }
    return false;
}

fn getAltBitOpcode(Opcode: u32) -> u32 {
    match Opcode {
        AND => {
            return FAND;
        },
        OR => {
            return FOR;
        },
        XOR => {
            return FXOR;
        },
        ANDNP => {
            return FANDN;
        },
    }
    llvm_unreachable_internal("Unknown bitwise opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 46709);
}

fn adjustBitcastSrcVectorSSE1(DAG: *mut SelectionDAG, Src: SDValue, DL: *SDLoc) -> SDValue {
    let mut SrcVT: EVT = Src.getValueType();
    if SrcVT != v4i1 {
        return SDValue {};
    }
    match Src.getOpcode() {
        SETCC => {
            if Src.getOperand(0).getValueType() == v4i32 && isBuildVectorAllZeros(Src.getOperand(1).getNode()) && cast(Src.getOperand(2)).get() == SETLT {
                let mut Op0: SDValue = Src.getOperand(0);
                if isNormalLoad(Op0.getNode()) {
                    return DAG.getBitcast(v4f32, Op0);
                }
                if Op0.getOpcode() == BITCAST && Op0.getOperand(0).getValueType() == v4f32 {
                    return Op0.getOperand(0);
                }
            }
        },
        AND => {
            XOR;
        },
    }
    return SDValue {};
}

fn signExtendBitcastSrcVector(DAG: *mut SelectionDAG, SExtVT: EVT, Src: SDValue, DL: *SDLoc) -> SDValue {
    match Src.getOpcode() {
        SETCC => {
            FREEZE;
        },
        AND => {
            XOR;
        },
        SELECT => {
            VSELECT;
        },
    }
    llvm_unreachable_internal("Unexpected node type for vXi1 sign extension", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 46769);
}

fn combineBitcastvxi1(DAG: *mut SelectionDAG, VT: EVT, Src: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut SrcVT: EVT = Src.getValueType();
    if Subtarget.useSoftFloat() || !SrcVT.isSimple() || SrcVT.getScalarType() != i1 {
        return SDValue {};
    }
    if Subtarget.hasSSE1() && !Subtarget.hasSSE2() {
        if adjustBitcastSrcVectorSSE1(DAG, Src, DL) {
            V;
        } else {
            V = DAG.getNode(MOVMSK, DL, i32, DAG.getBitcast(v4f32, V));
            return DAG.getZExtOrTrunc(V, DL, VT);
        }
    }
    let mut PreferMovMsk: bool = Src.getOpcode() == TRUNCATE && Src.hasOneUse() && (Src.getOperand(0).getValueType() == v16i8 || Src.getOperand(0).getValueType() == v32i8 || Src.getOperand(0).getValueType() == v64i8);
    if Src.getOpcode() == SETCC && Src.hasOneUse() && cast(Src.getOperand(2)).get() == SETLT && isBuildVectorAllZeros(Src.getOperand(1).getNode()) {
        let mut CmpVT: EVT = Src.getOperand(0).getValueType();
        let mut EltVT: EVT = CmpVT.getVectorElementType();
        if CmpVT.getSizeInBits().operator unsigned long long() <= 256 && (EltVT == i8 || EltVT == i32 || EltVT == i64) {
            PreferMovMsk = true;
        }
    }
    if !Subtarget.hasSSE2() || (Subtarget.hasAVX512() && !PreferMovMsk) {
        return SDValue {};
    }
    let mut SubSrcOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    if collectConcatOps(Src.getNode(), SubSrcOps, DAG) && SubSrcOps.len >= 2 {
        let mut LowerOp: SDValue = SubSrcOps[0];
        let mut UpperOps: ArrayRef<SDValue> = ArrayRef<SDValue> { next(SubSrcOps.begin(), 1), SubSrcOps.end() };
        if LowerOp.getOpcode() == SETCC && all_of(UpperOps, Closure_169 {}) {
            let mut SubVT: EVT = VT.getIntegerVT(*DAG.getContext(), LowerOp.getValueType().getVectorMinNumElements());
            if combineBitcastvxi1(DAG, SubVT, LowerOp, DL, Subtarget) {
                V;
            } else {
                let mut IntVT: EVT = VT.getIntegerVT(*DAG.getContext(), VT.getSizeInBits().operator unsigned long long());
                return DAG.getBitcast(VT, DAG.getNode(ANY_EXTEND, DL, IntVT, V));
            }
        }
    }
    let mut SExtVT: MVT = MVT {};
    let mut PropagateSExt: bool = false;
    match SrcVT.getSimpleVT().SimpleTy {
        _ => {
            return SDValue {};
        },
        v2i1 => {
            SExtVT = v2i64;
        },
        v4i1 => {
            SExtVT = v4i32;
        },
        v8i1 => {
            SExtVT = v8i16;
        },
        v16i1 => {
            SExtVT = v16i8;
        },
        v32i1 => {
            SExtVT = v32i8;
        },
        v64i1 => {
            if Subtarget.hasAVX512() {
                if Subtarget.hasBWI() {
                    return SDValue {};
                }
                SExtVT = v64i8;
                break;
            }
        },
    }
    let mut V: SDValue = if PropagateSExt { signExtendBitcastSrcVector(DAG, SExtVT, Src, DL) } else { DAG.getNode(SIGN_EXTEND, DL, SExtVT, Src) };
    if SExtVT == v16i8 || SExtVT == v32i8 || SExtVT == v64i8 {
        V = getMOVMSK(DL, V, DAG, Subtarget);
    } else {
        if SExtVT == v8i16 {
            V = widenSubVector(V, false, Subtarget, DAG, DL, 256);
            V = DAG.getNode(TRUNCATE, DL, v16i8, V);
        }
        V = DAG.getNode(MOVMSK, DL, i32, V);
    }
    let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), SrcVT.getVectorNumElements());
    V = DAG.getZExtOrTrunc(V, DL, IntVT);
    return DAG.getBitcast(VT, V);
}

fn combinevXi1ConstantToInteger(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut SrcVT: EVT = Op.getValueType();
    assert!(SrcVT.getVectorElementType() == i1, "Expected a vXi1 vector");
    assert!(isBuildVectorOfConstantSDNodes(Op.getNode()), "Expected a constant build vector");
    let mut Imm: APInt = APInt { SrcVT.getVectorNumElements(), 0, false, false };
    for let mut Idx: u32 = 0;
let mut e: u32 = Op.getNumOperands(); Idx < e; Idx += 1 {
        let mut In: SDValue = Op.getOperand(Idx);
        if !In.isUndef() && (operator(In).getAsZExtVal() & 1) {
            Imm.setBit(Idx);
        }
    }
    let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), Imm.getBitWidth());
    return DAG.getConstant(Imm, Op, IntVT, false, false);
}

fn combineCastedMaskArithmetic(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    assert!(N.getOpcode() == BITCAST, "Expected a bitcast");
    if !DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if !Subtarget.hasAVX512() {
        return SDValue {};
    }
    let mut DstVT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Op.getValueType();
    if !(SrcVT.isVectorOf(i1) && DstVT.isScalarInteger()) && !(DstVT.isVectorOf(i1) && SrcVT.isScalarInteger()) {
        return SDValue {};
    }
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if !sd_match(Op, m_OneUse(m_BitwiseLogic(m_Value(LHS), m_Value(RHS)))) {
        return SDValue {};
    }
    if sd_match(LHS, m_OneUse(m_BitCast(m_SpecificVT(DstVT)))) || sd_match(RHS, m_OneUse(m_BitCast(m_SpecificVT(DstVT)))) {
        return DAG.getNode(Op.getOpcode(), N, DstVT, DAG.getBitcast(DstVT, LHS), DAG.getBitcast(DstVT, RHS));
    }
    if isBuildVectorOfConstantSDNodes(RHS.getNode()) {
        RHS = combinevXi1ConstantToInteger(RHS, DAG);
        return DAG.getNode(Op.getOpcode(), N, DstVT, DAG.getBitcast(DstVT, LHS), RHS);
    }
    return SDValue {};
}

fn createMMXBuildVector(BV: *mut BuildVectorSDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = BV;
    let mut NumElts: u32 = BV.getNumOperands();
    let mut Splat: SDValue = BV.getSplatValue(null);
    let mut CreateMMXElement: Closure_170 = Closure_170 { DAG: &mut DAG, Subtarget: &mut Subtarget, DL: &mut DL };
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if Splat {
        if Splat.isUndef() {
            return DAG.getUNDEF(x86mmx);
        }
        Splat = CreateMMXElement.call(Splat);
        if Subtarget.hasSSE1() {
            if NumElts == 8 {
                Splat = DAG.getNode(INTRINSIC_WO_CHAIN, DL, x86mmx, DAG.getTargetConstant(x86_mmx_punpcklbw, DL, TLI.getPointerTy(DAG.getDataLayout(), 0), false), Splat, Splat);
            }
            let mut ShufMask: u32 = (if NumElts > 2 { 0 } else { 68 });
            return DAG.getNode(INTRINSIC_WO_CHAIN, DL, x86mmx, DAG.getTargetConstant(x86_sse_pshuf_w, DL, TLI.getPointerTy(DAG.getDataLayout(), 0), false), Splat, DAG.getTargetConstant(ShufMask, DL, i8, false));
        }
        Ops.append(NumElts, Splat);
    } else {
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            Ops.push(CreateMMXElement.call(BV.getOperand(i)));
        }
    }
    while Ops.len > 1 {
        let mut NumOps: u32 = Ops.len;
        let mut IntrinOp: u32 = (if NumOps == 2 { x86_mmx_punpckldq } else { (if NumOps == 4 { x86_mmx_punpcklwd } else { x86_mmx_punpcklbw }) });
        let mut Intrin: SDValue = DAG.getTargetConstant(IntrinOp, DL, TLI.getPointerTy(DAG.getDataLayout(), 0), false);
        for let mut i: u32 = 0; i != NumOps; i += 2 {
            Ops[i / 2] = DAG.getNode(INTRINSIC_WO_CHAIN, DL, x86mmx, Intrin, Ops[i], Ops[i + 1]);
        }
        Ops.resize(NumOps / 2);
    }
    return Ops[0];
}

fn combineBitcastToBoolVector(VT: EVT, V: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, Depth: u32) -> SDValue {
    if Depth >= MaxRecursionDepth {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Opc: u32 = V.getOpcode();
    match Opc {
        BITCAST => {
            let mut Src: SDValue = V.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            if SrcVT.isVector() || SrcVT.isFloatingPoint() {
                return DAG.getBitcast(VT, Src);
            }
            break;
        },
        Constant => {
            let mut C: *mut ConstantSDNode = cast(V);
            if C.isZero() {
                return DAG.getConstant(0, DL, VT, false, false);
            }
            if C.isAllOnes() {
                return DAG.getAllOnesConstant(DL, VT, false, false);
            }
            break;
        },
        TRUNCATE => {
            let mut Src: SDValue = V.getOperand(0);
            let mut NewSrcVT: EVT = getVectorVT(*DAG.getContext(), i1, Src.getValueSizeInBits().operator unsigned long long(), false);
            if TLI.isTypeLegal(NewSrcVT) {
                if combineBitcastToBoolVector(NewSrcVT, Src, DL, DAG, Subtarget, Depth + 1) {
                    N0;
                } else {
                    return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, N0, DAG.getVectorIdxConstant(0, DL, false));
                }
            }
            break;
        },
        ANY_EXTEND => {
            ZERO_EXTEND;
        },
        OR => {
            XOR;
        },
        SHL => {
            let mut Src0: SDValue = V.getOperand(0);
            if (VT == v8i1 && !Subtarget.hasDQI()) || ((VT == v32i1 || VT == v64i1) && !Subtarget.hasBWI()) {
                break;
            }
            if dyn_cast(V.getOperand(1)) {
                Amt;
            } else if combineBitcastToBoolVector(VT, Src0, DL, DAG, Subtarget, Depth + 1) {
                N0;
            } else {
                return DAG.getNode(KSHIFTL, DL, VT, N0, DAG.getTargetConstant(Amt.getZExtValue(), DL, i8, false));
            }
            break;
        },
    }
    if Depth > 0 {
        if DAG.getNodeIfExists(BITCAST, DAG.getVTList(VT), [V], false) {
            Alt;
        } else {
            return SDValue { Node: Alt, ResNo: 0 };
        }
    }
    return SDValue {};
}

fn combineBitcast(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = N0.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if DCI.isBeforeLegalize() {
        let mut dl: SDLoc = N;
        if combineBitcastvxi1(DAG, VT, N0, dl, Subtarget) {
            V;
        } else {
            return V;
        }
        if (VT == v4i1 || VT == v2i1) && SrcVT.isScalarInteger() && Subtarget.hasAVX512() {
            N0 = DAG.getNode(ANY_EXTEND, dl, i8, N0);
            N0 = DAG.getBitcast(v8i1, N0);
            return DAG.getNode(EXTRACT_SUBVECTOR, dl, VT, N0, DAG.getVectorIdxConstant(0, dl, false));
        }
        if (SrcVT == v4i1 || SrcVT == v2i1) && VT.isScalarInteger() && Subtarget.hasAVX512() {
            if N0.getOpcode() == CONCAT_VECTORS {
                let mut LastOp: SDValue = N0.getOperand(N0.getNumOperands() - 1);
                if isBuildVectorAllZeros(LastOp.getNode()) {
                    SrcVT = LastOp.getValueType();
                    let mut NumConcats: u32 = 8 / SrcVT.getVectorNumElements();
                    let mut Ops: SmallVector<SDValue, 4> = operator(N0).ops();
                    Ops.resize(NumConcats, DAG.getConstant(0, dl, SrcVT, false, false));
                    N0 = DAG.getNode(CONCAT_VECTORS, dl, v8i1, Ops);
                    N0 = DAG.getBitcast(i8, N0);
                    return DAG.getNode(TRUNCATE, dl, VT, N0);
                }
            }
            let mut NumConcats: u32 = 8 / SrcVT.getVectorNumElements();
            let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumConcats, DAG.getUNDEF(SrcVT) };
            Ops[0] = N0;
            N0 = DAG.getNode(CONCAT_VECTORS, dl, v8i1, Ops);
            N0 = DAG.getBitcast(i8, N0);
            return DAG.getNode(TRUNCATE, dl, VT, N0);
        }
    } else if DCI.isAfterLegalizeDAG() {
        if VT.isVectorOf(i1) && SrcVT.isScalarInteger() && TLI.isTypeLegal(VT) {
            if combineBitcastToBoolVector(VT, N0, N, DAG, Subtarget, 0) {
                V;
            } else {
                return V;
            }
        }
    }
    if VT == i8 && SrcVT == v8i1 && Subtarget.hasAVX512() && !Subtarget.hasDQI() && N0.getOpcode() == EXTRACT_SUBVECTOR && N0.getOperand(0).getValueType() == v16i1 && isNullConstant(N0.getOperand(1)) {
        return DAG.getNode(TRUNCATE, N, VT, DAG.getBitcast(i16, N0.getOperand(0)));
    }
    if N0.getOpcode() == VBROADCAST_LOAD && N0.hasOneUse() && VT.isFloatingPoint() != SrcVT.isFloatingPoint() && VT.isVector() {
        let mut BCast: *mut MemIntrinsicSDNode = cast(N0);
        let mut SrcVTSize: u32 = SrcVT.getScalarSizeInBits();
        let mut MemSize: u32 = BCast.getMemoryVT().getScalarSizeInBits();
        if MemSize >= 32 {
            let mut MemVT: MVT = if VT.isFloatingPoint() { getFloatingPointVT(MemSize) } else { getIntegerVT(MemSize) };
            let mut LoadVT: MVT = if VT.isFloatingPoint() { getFloatingPointVT(SrcVTSize) } else { getIntegerVT(SrcVTSize) };
            LoadVT = getVectorVT(LoadVT, SrcVT.getVectorNumElements());
            let mut Tys: SDVTList = DAG.getVTList(LoadVT, Other);
            let mut Ops: [2]SDValue = [BCast.getChain(), BCast.getBasePtr()];
            let mut ResNode: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, N, Tys, Ops, MemVT, BCast.getMemOperand());
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: BCast, ResNo: 1 }, ResNode.getValue(1));
            return DAG.getBitcast(VT, ResNode);
        }
    }
    if VT == f16 && SrcVT == i16 {
        let mut Src: SDValue = peekThroughTruncates(N0);
        if Src.getOpcode() == EXTRACT_VECTOR_ELT && Src.getOperand(0).getValueSizeInBits().operator unsigned long long() == 128 && isNullConstant(Src.getOperand(1)) {
            let mut DL: SDLoc = N;
            return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, DAG.getBitcast(v8f16, Src.getOperand(0)), DAG.getVectorIdxConstant(0, DL, false));
        }
    }
    if VT == x86mmx {
        let mut UndefElts: APInt = APInt {};
        let mut EltBits: SmallVector<APInt, 1> = SmallVector<APInt, 1> {};
        if getTargetConstantBitsFromNode(N0, 64, UndefElts, EltBits, true, true) {
            let mut DL: SDLoc = N0;
            if EltBits[0].countl_zero() >= 32 {
                return DAG.getNode(MMX_MOVW2D, DL, VT, DAG.getConstant(EltBits[0].trunc(32), DL, i32, false, false));
            }
            let mut F64: APFloat = APFloat { IEEEdouble(), EltBits[0] };
            return DAG.getBitcast(VT, DAG.getConstantFP(F64, DL, f64, false));
        }
        if N0.getOpcode() == BUILD_VECTOR && (SrcVT == v2i32 || SrcVT == v4i16 || SrcVT == v8i8) && N0.getOperand(0).getValueType() == SrcVT.getScalarType() {
            let mut LowUndef: bool = true;
            let mut AllUndefOrZero: bool = true;
            for let mut i: u32 = 1;
let mut e: u32 = SrcVT.getVectorNumElements(); i != e; i += 1 {
                let mut Op: SDValue = N0.getOperand(i);
                LowUndef &= Op.isUndef() || (i >= e / 2);
                AllUndefOrZero &= isNullConstantOrUndef(Op);
            }
            if AllUndefOrZero {
                let mut N00: SDValue = N0.getOperand(0);
                let mut dl: SDLoc = N00;
                N00 = if LowUndef { DAG.getAnyExtOrTrunc(N00, dl, i32) } else { DAG.getZExtOrTrunc(N00, dl, i32) };
                return DAG.getNode(MMX_MOVW2D, dl, VT, N00);
            }
        }
        if N0.getOpcode() == BUILD_VECTOR && (SrcVT == v2f32 || SrcVT == v2i32 || SrcVT == v4i16 || SrcVT == v8i8) {
            return createMMXBuildVector(cast(N0), DAG, Subtarget);
        }
        if (N0.getOpcode() == EXTRACT_VECTOR_ELT || N0.getOpcode() == EXTRACT_SUBVECTOR) && isNullConstant(N0.getOperand(1)) {
            let mut N00: SDValue = N0.getOperand(0);
            if N00.getValueType().is128BitVector() {
                return DAG.getNode(MOVDQ2Q, N00, VT, DAG.getBitcast(v2i64, N00));
            }
        }
        if SrcVT == v2i32 && N0.getOpcode() == FP_TO_SINT {
            let mut DL: SDLoc = N0;
            let mut Res: SDValue = DAG.getNode(CONCAT_VECTORS, DL, v4i32, N0, DAG.getUNDEF(v2i32));
            return DAG.getNode(MOVDQ2Q, DL, VT, DAG.getBitcast(v2i64, Res));
        }
    }
    if Subtarget.hasAVX512() && VT.isScalarInteger() && SrcVT.isVectorOf(i1) && isBuildVectorOfConstantSDNodes(N0.getNode()) {
        return combinevXi1ConstantToInteger(N0, DAG);
    }
    if Subtarget.hasAVX512() && SrcVT.isScalarInteger() && VT.isVector() && VT.getVectorElementType() == i1 {
        if dyn_cast(N0) {
            C;
        } else {
            if C.isAllOnes() {
                return DAG.getConstant(1, N0, VT, false, false);
            }
            if C.isZero() {
                return DAG.getConstant(0, N0, VT, false, false);
            }
        }
    }
    if Subtarget.hasAVX512() && SrcVT.isScalarInteger() && VT.isVectorOf(i1) && isPowerOf2_32(VT.getVectorNumElements()) {
        let mut NumElts: u32 = VT.getVectorNumElements();
        let mut Src: SDValue = N0;
        if N0.getOpcode() == TRUNCATE && N0.hasOneUse() {
            Src = N0.getOperand(0);
        }
        if Src.getOpcode() == MOVMSK && Src.hasOneUse() {
            let mut MovmskIn: SDValue = Src.getOperand(0);
            let mut MovmskVT: MVT = MovmskIn.getSimpleValueType();
            let mut MovMskElts: u32 = MovmskVT.getVectorNumElements();
            if MovMskElts <= NumElts && (Subtarget.hasBWI() || MovmskVT.getVectorElementType() != i8) {
                let mut IntVT: EVT = MovmskVT.changeVectorElementTypeToInteger();
                MovmskIn = DAG.getBitcast(IntVT, MovmskIn);
                let mut dl: SDLoc = N;
                let mut CmpVT: MVT = getVectorVT(i1, MovMskElts);
                let mut Cmp: SDValue = DAG.getSetCC(dl, CmpVT, MovmskIn, DAG.getConstant(0, dl, IntVT, false, false), SETLT, SDValue {}, false, None);
                if CmpVT == VT {
                    return Cmp;
                }
                let mut NumConcats: u32 = NumElts / MovMskElts;
                let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumConcats, DAG.getConstant(0, dl, CmpVT, false, false) };
                Ops[0] = Cmp;
                return DAG.getNode(CONCAT_VECTORS, dl, VT, Ops);
            }
        }
    }
    if combineCastedMaskArithmetic(N, DAG, DCI, Subtarget) {
        V;
    } else {
        return V;
    }
    if N0.getOpcode() == INSERT_VECTOR_ELT && SrcVT.getScalarType() == VT && SrcVT.getVectorNumElements() == 1 {
        return N0.getOperand(1);
    }
    let mut FPOpcode: u32 = 0;
    match N0.getOpcode() {
        AND => {
            FPOpcode = FAND;
        },
        OR => {
            FPOpcode = FOR;
        },
        XOR => {
            FPOpcode = FXOR;
        },
        _ => {
            return SDValue {};
        },
    }
    if !((Subtarget.hasSSE1() && VT == f32) || (Subtarget.hasSSE2() && VT == f64) || (Subtarget.hasFP16() && VT == f16) || (Subtarget.hasSSE2() && VT.isInteger() && VT.isVector() && TLI.isTypeLegal(VT))) {
        return SDValue {};
    }
    let mut LogicOp0: SDValue = N0.getOperand(0);
    let mut LogicOp1: SDValue = N0.getOperand(1);
    let mut DL0: SDLoc = N0;
    if N0.hasOneUse() && LogicOp0.getOpcode() == BITCAST && LogicOp0.hasOneUse() && LogicOp0.getOperand(0).hasOneUse() && LogicOp0.getOperand(0).getValueType() == VT && !isa(LogicOp0.getOperand(0)) {
        let mut CastedOp1: SDValue = DAG.getBitcast(VT, LogicOp1);
        let mut Opcode: u32 = if VT.isFloatingPoint() { FPOpcode } else { N0.getOpcode() };
        return DAG.getNode(Opcode, DL0, VT, LogicOp0.getOperand(0), CastedOp1);
    }
    if N0.hasOneUse() && LogicOp1.getOpcode() == BITCAST && LogicOp1.hasOneUse() && LogicOp1.getOperand(0).hasOneUse() && LogicOp1.getOperand(0).getValueType() == VT && !isa(LogicOp1.getOperand(0)) {
        let mut CastedOp0: SDValue = DAG.getBitcast(VT, LogicOp0);
        let mut Opcode: u32 = if VT.isFloatingPoint() { FPOpcode } else { N0.getOpcode() };
        return DAG.getNode(Opcode, DL0, VT, LogicOp1.getOperand(0), CastedOp0);
    }
    return SDValue {};
}

fn detectExtMul(DAG: *mut SelectionDAG, Mul: *SDValue, Op0: *mut SDValue, Op1: *mut SDValue) -> bool {
    Op0 = Mul.getOperand(0);
    Op1 = Mul.getOperand(1);
    if Op0.getOpcode() == SIGN_EXTEND {
        swap(Op0, Op1);
    }
    let mut IsFreeTruncation: Closure_171 = Closure_171 {};
    if (IsFreeTruncation.call(Op0) && DAG.computeKnownBits(Op0, 0).countMaxActiveBits() <= 8) && (IsFreeTruncation.call(Op1) && DAG.ComputeMaxSignificantBits(Op1, 0) <= 8) {
        return true;
    }
    return false;
}

fn createVPDPBUSD(DAG: *mut SelectionDAG, LHS: SDValue, RHS: SDValue, LogBias: *mut u32, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut Vi8VT: MVT = getVectorVT(i8, LHS.getValueType().getVectorElementCount());
    LHS = DAG.getZExtOrTrunc(LHS, DL, Vi8VT);
    RHS = DAG.getSExtOrTrunc(RHS, DL, Vi8VT);
    LogBias = 2;
    let mut RegSize: u32 = if 128 > Vi8VT.getSizeInBits().operator unsigned long long() as u32 { 128 } else { Vi8VT.getSizeInBits().operator unsigned long long() as u32 };
    if Subtarget.hasVNNI() && !Subtarget.hasVLX() {
        RegSize = if 512 > RegSize { 512 } else { RegSize };
    }
    let mut NumConcat: u32 = RegSize / Vi8VT.getSizeInBits().operator unsigned long long();
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumConcat, DAG.getConstant(0, DL, Vi8VT, false, false) };
    Ops[0] = LHS;
    let mut ExtendedVT: MVT = getVectorVT(i8, RegSize / 8);
    let mut DpOp0: SDValue = DAG.getNode(CONCAT_VECTORS, DL, ExtendedVT, Ops);
    Ops[0] = RHS;
    let mut DpOp1: SDValue = DAG.getNode(CONCAT_VECTORS, DL, ExtendedVT, Ops);
    let mut DpBuilder: Closure_172 = Closure_172 {};
    let mut DpVT: MVT = getVectorVT(i32, RegSize / 32);
    let mut Zero: SDValue = DAG.getConstant(0, DL, DpVT, false, false);
    return SplitOpsAndApply(DAG, Subtarget, DL, DpVT, [Zero, DpOp0, DpOp1], DpBuilder, false, Subtarget.hasVNNI());
}

fn createPSADBW(DAG: *mut SelectionDAG, N0: SDValue, N1: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut DstVT: EVT = N0.getValueType();
    let mut SrcVT: EVT = getVectorVT(*DAG.getContext(), i8, DstVT.getVectorElementCount());
    let mut RegSize: u32 = if 128 > SrcVT.getSizeInBits().operator unsigned long long() as u32 { 128 } else { SrcVT.getSizeInBits().operator unsigned long long() as u32 };
    let mut NumConcat: u32 = RegSize / SrcVT.getSizeInBits().operator unsigned long long();
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumConcat, DAG.getConstant(0, DL, SrcVT, false, false) };
    Ops[0] = DAG.getZExtOrTrunc(N0, DL, SrcVT);
    let mut ExtendedVT: MVT = getVectorVT(i8, RegSize / 8);
    let mut SadOp0: SDValue = DAG.getNode(CONCAT_VECTORS, DL, ExtendedVT, Ops);
    Ops[0] = DAG.getZExtOrTrunc(N1, DL, SrcVT);
    let mut SadOp1: SDValue = DAG.getNode(CONCAT_VECTORS, DL, ExtendedVT, Ops);
    let mut PSADBWBuilder: Closure_173 = Closure_173 {};
    let mut SadVT: MVT = getVectorVT(i64, RegSize / 64);
    return SplitOpsAndApply(DAG, Subtarget, DL, SadVT, [SadOp0, SadOp1], PSADBWBuilder, true, true);
}

fn combineVECREDUCE_LOGIC(Reduce: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    if Reduce.getOpcode() != VECREDUCE_AND && Reduce.getOpcode() != VECREDUCE_OR && Reduce.getOpcode() != VECREDUCE_XOR {
        return SDValue {};
    }
    let mut BinOp: NodeType = getVecReduceBaseOpcode(Reduce.getOpcode());
    let mut Match: SDValue = Reduce.getOperand(0);
    let mut ExtractVT: EVT = Reduce.getValueType(0);
    let mut BitWidth: u32 = ExtractVT.getSizeInBits().operator unsigned long long();
    if ExtractVT != i64 && ExtractVT != i32 && ExtractVT != i16 && ExtractVT != i8 && ExtractVT != i1 {
        return SDValue {};
    }
    if Match.getScalarValueSizeInBits() != BitWidth {
        return SDValue {};
    }
    let mut Movmsk: SDValue = SDValue {};
    let mut DL: SDLoc = Reduce;
    let mut MatchVT: EVT = Match.getValueType();
    let mut NumElts: u32 = MatchVT.getVectorNumElements();
    let mut MaxElts: u32 = if Subtarget.hasInt256() { 32 } else { 16 };
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    if ExtractVT == i1 {
        if NumElts > 64 || !isPowerOf2_32(NumElts) {
            return SDValue {};
        }
        if Match.getOpcode() == SETCC {
            let mut CC: CondCode = cast(Match.getOperand(2)).get();
            if (BinOp == AND && CC == SETEQ) || (BinOp == OR && CC == SETNE) {
                let mut X86CC: CondCode = zeroed();
                let mut LHS: SDValue = DAG.getFreeze(Match.getOperand(0));
                let mut RHS: SDValue = DAG.getFreeze(Match.getOperand(1));
                let mut Mask: APInt = getAllOnes(LHS.getScalarValueSizeInBits());
                if LowerVectorAllEqual(DL, LHS, RHS, CC, Mask, Subtarget, DAG, X86CC) {
                    V;
                } else {
                    return DAG.getNode(TRUNCATE, DL, ExtractVT, getSETCC(X86CC, V, DL, DAG));
                }
            }
        }
        if TLI.isTypeLegal(MatchVT) {
            let mut MovmskVT: EVT = getIntegerVT(Ctx, NumElts);
            Movmsk = DAG.getBitcast(MovmskVT, Match);
        } else {
            while NumElts > MaxElts {
                let mut Lo: SDValue = SDValue {};
                let mut Hi: SDValue = SDValue {};
                tie(Lo, Hi) = DAG.SplitVector(Match, DL);
                Match = DAG.getNode(BinOp, DL, Lo.getValueType(), Lo, Hi);
                NumElts /= 2;
            }
            let mut MovmskVT: EVT = getIntegerVT(Ctx, NumElts);
            Movmsk = combineBitcastvxi1(DAG, MovmskVT, Match, DL, Subtarget);
        }
        if !Movmsk {
            return SDValue {};
        }
        Movmsk = DAG.getZExtOrTrunc(Movmsk, DL, if NumElts > 32 { i64 } else { i32 });
    } else {
        let mut MatchSizeInBits: u32 = Match.getValueSizeInBits().operator unsigned long long();
        if !(MatchSizeInBits == 128 || (MatchSizeInBits == 256 && Subtarget.hasAVX())) {
            return SDValue {};
        }
        if Match.getValueType().getVectorNumElements() < 2 {
            return SDValue {};
        }
        if DAG.ComputeNumSignBits(Match, 0) != BitWidth {
            return SDValue {};
        }
        if MatchSizeInBits == 256 && BitWidth < 32 && !Subtarget.hasInt256() {
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = DAG.SplitVector(Match, DL);
            Match = DAG.getNode(BinOp, DL, Lo.getValueType(), Lo, Hi);
            MatchSizeInBits = Match.getValueSizeInBits().operator unsigned long long();
        }
        let mut MaskSrcVT: MVT = MVT {};
        if 64 == BitWidth || 32 == BitWidth {
            MaskSrcVT = getVectorVT(getFloatingPointVT(BitWidth), MatchSizeInBits / BitWidth);
        } else {
            if BinOp == XOR && BitWidth != 8 {
                return SDValue {};
            }
            MaskSrcVT = getVectorVT(i8, MatchSizeInBits / 8);
        }
        let mut BitcastLogicOp: SDValue = DAG.getBitcast(MaskSrcVT, Match);
        Movmsk = getMOVMSK(DL, BitcastLogicOp, DAG, Subtarget);
        NumElts = MaskSrcVT.getVectorNumElements();
    }
    assert!((NumElts <= 32 || NumElts == 64), "Not expecting more than 64 elements");
    let mut Result: SDValue = SDValue {};
    let mut CmpVT: MVT = if NumElts == 64 { i64 } else { i32 };
    if BinOp == XOR {
        Result = DAG.getNode(PARITY, DL, CmpVT, Movmsk);
    } else {
        let mut CmpC: SDValue = SDValue {};
        let mut CondCode: CondCode = zeroed();
        if BinOp == OR {
            CmpC = DAG.getConstant(0, DL, CmpVT, false, false);
            CondCode = SETNE;
        } else {
            CmpC = DAG.getConstant(getLowBitsSet(CmpVT.getSizeInBits().operator unsigned long long(), NumElts), DL, CmpVT, false, false);
            CondCode = SETEQ;
        }
        let mut SetccVT: EVT = TLI.getSetCCResultType(DAG.getDataLayout(), Ctx, CmpVT);
        Result = DAG.getSetCC(DL, SetccVT, Movmsk, CmpC, CondCode, SDValue {}, false, None);
    }
    Result = DAG.getZExtOrTrunc(Result, DL, ExtractVT);
    return DAG.getNegative(Result, DL, ExtractVT);
}

fn combineVPDPBUSDPattern(Extract: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasVNNI() && !Subtarget.hasAVXVNNI() {
        return SDValue {};
    }
    let mut ExtractVT: EVT = Extract.getValueType(0);
    if ExtractVT != i32 {
        return SDValue {};
    }
    let mut VT: EVT = Extract.getOperand(0).getValueType();
    if !isPowerOf2_32(VT.getVectorNumElements()) {
        return SDValue {};
    }
    let mut BinOp: NodeType = zeroed();
    let mut Root: SDValue = DAG.matchBinOpReduction(Extract, BinOp, [ADD], false);
    if !Root || Root.getOpcode() != MUL {
        return SDValue {};
    }
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if !detectExtMul(DAG, Root, LHS, RHS) {
        return SDValue {};
    }
    let mut DL: SDLoc = Extract;
    let mut StageBias: u32 = 0;
    let mut DP: SDValue = createVPDPBUSD(DAG, LHS, RHS, StageBias, DL, Subtarget);
    let mut Stages: u32 = Log2_32(VT.getVectorNumElements());
    let mut DpVT: EVT = DP.getValueType();
    if Stages > StageBias {
        let mut DpElems: u32 = DpVT.getVectorNumElements();
        for let mut i: u32 = Stages - StageBias; i > 0; i -= 1 {
            let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { DpElems, -1 };
            for let mut j: u32 = 0;
let mut MaskEnd: u32 = 1 << (i - 1); j < MaskEnd; j += 1 {
                Mask[j] = MaskEnd + j;
            }
            let mut Shuffle: SDValue = DAG.getVectorShuffle(DpVT, DL, DP, DAG.getUNDEF(DpVT), Mask);
            DP = DAG.getNode(ADD, DL, DpVT, DP, Shuffle);
        }
    }
    let mut ResVT: EVT = getVectorVT(*DAG.getContext(), ExtractVT, DpVT.getSizeInBits().operator unsigned long long() / ExtractVT.getSizeInBits().operator unsigned long long(), false);
    DP = DAG.getBitcast(ResVT, DP);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, ExtractVT, DP, Extract.getOperand(1));
}

fn combineBasicSADPattern(Extract: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut ExtractVT: EVT = Extract.getValueType(0);
    if ExtractVT != i8 && ExtractVT != i16 && ExtractVT != i32 && ExtractVT != i64 {
        return SDValue {};
    }
    let mut VT: EVT = Extract.getOperand(0).getValueType();
    if !isPowerOf2_32(VT.getVectorNumElements()) {
        return SDValue {};
    }
    let mut BinOp: NodeType = zeroed();
    let mut Root: SDValue = DAG.matchBinOpReduction(Extract, BinOp, [ADD], false);
    if !Root {
        return SDValue {};
    }
    if Root.getOpcode() == SIGN_EXTEND || Root.getOpcode() == ZERO_EXTEND || Root.getOpcode() == ANY_EXTEND {
        Root = Root.getOperand(0);
    }
    let mut Src0: SDValue = SDValue {};
    let mut Src1: SDValue = SDValue {};
    if !sd_match(Root, m_AnyOf(m_SpecificVectorElementVT(i8, m_c_BinOp(ABDU, m_Value(Src0), m_Value(Src1), SDNodeFlags { Flags: None })), m_SpecificVectorElementVT(i8, m_Sub(m_UMax(m_Value(Src0), m_Value(Src1)), m_UMin(m_Deferred(Src0), m_Deferred(Src1)))), m_Abs(m_Sub(m_Value(Src0, m_ZExt(m_SpecificVectorElementVT(i8))), m_Value(Src1, m_ZExt(m_SpecificVectorElementVT(i8))))))) {
        return SDValue {};
    }
    let mut DL: SDLoc = Extract;
    let mut SAD: SDValue = createPSADBW(DAG, Src0, Src1, DL, Subtarget);
    let mut Stages: u32 = Log2_32(VT.getVectorNumElements());
    let mut SadVT: EVT = SAD.getValueType();
    if Stages > 3 {
        let mut SadElems: u32 = SadVT.getVectorNumElements();
        for let mut i: u32 = Stages - 3; i > 0; i -= 1 {
            let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { SadElems, -1 };
            for let mut j: u32 = 0;
let mut MaskEnd: u32 = 1 << (i - 1); j < MaskEnd; j += 1 {
                Mask[j] = MaskEnd + j;
            }
            let mut Shuffle: SDValue = DAG.getVectorShuffle(SadVT, DL, SAD, DAG.getUNDEF(SadVT), Mask);
            SAD = DAG.getNode(ADD, DL, SadVT, SAD, Shuffle);
        }
    }
    let mut ExtractSizeInBits: u32 = ExtractVT.getSizeInBits().operator unsigned long long();
    let mut ResVT: EVT = getVectorVT(*DAG.getContext(), ExtractVT, SadVT.getSizeInBits().operator unsigned long long() / ExtractSizeInBits, false);
    SAD = DAG.getBitcast(ResVT, SAD);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, ExtractVT, SAD, Extract.getOperand(1));
}

fn combineExtractFromVectorLoad(N: *mut SDNode, VecVT: EVT, SrcVec: SDValue, Idx: u64, dl: *SDLoc, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    assert!(N.getOpcode() == EXTRACT_VECTOR_ELT, "Only EXTRACT_VECTOR_ELT supported so far");
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut VT: EVT = N.getValueType(0);
    let mut LikelyUsedAsVector: bool = any_of(N.users(), Closure_174 {});
    let mut LoadVec: *mut LoadSDNode = dyn_cast(SrcVec);
    if LoadVec && isNormalLoad(LoadVec) && VT.isInteger() && VecVT.getVectorElementType() == VT && VecVT.getSizeInBits() == SrcVec.getValueSizeInBits() && DCI.isAfterLegalizeDAG() && !LikelyUsedAsVector && LoadVec.isSimple() {
        let mut NewPtr: SDValue = TLI.getVectorElementPointer(DAG, LoadVec.getBasePtr(), VecVT, DAG.getVectorIdxConstant(Idx, dl, false), SDNodeFlags { Flags: None });
        let mut PtrOff: u32 = VT.getSizeInBits() * Idx.operator unsigned long long() / 8;
        let mut MPI: MachinePointerInfo = LoadVec.getPointerInfo().getWithOffset(PtrOff);
        let mut Alignment: Align = commonAlignment(LoadVec.getAlign(), PtrOff);
        let mut Load: SDValue = DAG.getLoad(VT, dl, LoadVec.getChain(), NewPtr, MPI, Alignment, LoadVec.getMemOperand().getFlags(), MMOMetadata { AAInfo: LoadVec.getAAInfo(), Ranges: null, MemCacheHint: null });
        DAG.makeEquivalentMemoryOrdering(LoadVec, Load);
        return Load;
    }
    return SDValue {};
}

fn combineExtractWithShuffle(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut dl: SDLoc = N;
    let mut Src: SDValue = N.getOperand(0);
    let mut Idx: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut SrcSVT: EVT = SrcVT.getVectorElementType();
    let mut SrcEltBits: u32 = SrcSVT.getSizeInBits().operator unsigned long long();
    let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
    if SrcSVT == i1 || !isa(Idx) {
        return SDValue {};
    }
    let mut IdxC: *APInt = N.getConstantOperandAPInt(1);
    if IdxC.uge(NumSrcElts) {
        return SDValue {};
    }
    let mut SrcBC: SDValue = peekThroughBitcasts(Src);
    if VBROADCAST == SrcBC.getOpcode() {
        let mut SrcOp: SDValue = SrcBC.getOperand(0);
        let mut SrcOpVT: EVT = SrcOp.getValueType();
        if SrcOpVT.isScalarInteger() && VT.isInteger() && (SrcOpVT.getSizeInBits().operator unsigned long long() % SrcEltBits) == 0 {
            let mut Scale: u32 = SrcOpVT.getSizeInBits().operator unsigned long long() / SrcEltBits;
            let mut Offset: u32 = IdxC.urem(Scale) * SrcEltBits;
            if Offset == 0 {
                SrcOp = DAG.getZExtOrTrunc(SrcOp, dl, SrcVT.getScalarType());
                SrcOp = DAG.getZExtOrTrunc(SrcOp, dl, VT);
                return SrcOp;
            }
        }
    }
    if peekThroughOneUseBitcasts(Src).getOpcode() == VBROADCAST_LOAD && SrcBC.hasOneUse() {
        let mut MemIntr: *mut MemIntrinsicSDNode = cast(SrcBC);
        let mut SrcBCWidth: u32 = SrcBC.getScalarValueSizeInBits();
        if MemIntr.getMemoryVT().getSizeInBits().operator unsigned long long() == SrcBCWidth && VT.getSizeInBits().operator unsigned long long() == SrcBCWidth && SrcEltBits == SrcBCWidth {
            let mut Load: SDValue = DAG.getLoad(VT, dl, MemIntr.getChain(), MemIntr.getBasePtr(), MemIntr.getPointerInfo(), MemIntr.getBaseAlign(), MemIntr.getMemOperand().getFlags(), MMOMetadata {});
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: MemIntr, ResNo: 1 }, Load.getValue(1));
            return Load;
        }
    }
    if SrcBC.getOpcode() == SCALAR_TO_VECTOR && VT.isInteger() && SrcBC.getValueType().isInteger() && (SrcBC.getScalarValueSizeInBits() % SrcEltBits) == 0 && SrcBC.getScalarValueSizeInBits() == SrcBC.getOperand(0).getValueSizeInBits().operator unsigned long long() {
        let mut Scale: u32 = SrcBC.getScalarValueSizeInBits() / SrcEltBits;
        if IdxC.ult(Scale) {
            let mut Offset: u32 = IdxC.getZExtValue() * SrcVT.getScalarSizeInBits();
            let mut Scl: SDValue = SrcBC.getOperand(0);
            let mut SclVT: EVT = Scl.getValueType();
            if Offset {
                Scl = DAG.getNode(SRL, dl, SclVT, Scl, DAG.getShiftAmountConstant(Offset, SclVT, dl));
            }
            Scl = DAG.getZExtOrTrunc(Scl, dl, SrcVT.getScalarType());
            Scl = DAG.getZExtOrTrunc(Scl, dl, VT);
            return Scl;
        }
    }
    if TRUNCATE == Src.getOpcode() && IdxC == 0 && (SrcVT.getSizeInBits().operator unsigned long long() % 128) == 0 {
        Src = extract128BitVector(Src.getOperand(0), 0, DAG, dl);
        let mut ExtractVT: MVT = getVectorVT(SrcSVT.getSimpleVT(), 128 / SrcEltBits);
        return DAG.getNode(N.getOpcode(), dl, VT, DAG.getBitcast(ExtractVT, Src), Idx);
    }
    let mut GetLegalExtract: Closure_175 = Closure_175 { Subtarget: &mut Subtarget, DAG: &mut DAG, dl: &mut dl };
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
    let mut Ops: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    if !getTargetShuffleInputs(SrcBC, Ops, Mask, DAG, 0, true) {
        return SDValue {};
    }
    if any_of(Ops, Closure_176 { cap_0: SrcVT }) {
        return SDValue {};
    }
    if Mask.len != NumSrcElts {
        if (NumSrcElts % Mask.len) == 0 {
            let mut ScaledMask: SmallVector<int, 16> = SmallVector<int, 16> {};
            let mut Scale: i32 = NumSrcElts / Mask.len;
            narrowShuffleMaskElts(Scale, Mask, ScaledMask);
            Mask = move(ScaledMask);
        } else if (Mask.len % NumSrcElts) == 0 {
            let mut ExtractIdx: i32 = IdxC.getZExtValue() as i32;
            let mut Scale: i32 = Mask.len / NumSrcElts;
            let mut Lo: i32 = Scale * ExtractIdx;
            let mut Hi: i32 = Scale * (ExtractIdx + 1);
            for let mut i: i32 = 0;
let mut e: i32 = Mask.len as i32; i != e; i += 1 {
                if i < Lo || Hi <= i {
                    Mask[i] = SM_SentinelUndef;
                }
            }
            let mut WidenedMask: SmallVector<int, 16> = SmallVector<int, 16> {};
            while Mask.len > NumSrcElts && canWidenShuffleElements(Mask, WidenedMask) {
                Mask = move(WidenedMask);
            }
        }
    }
    let mut ExtractIdx: i32 = 0;
    let mut ExtractVT: EVT = EVT {};
    if Mask.len == NumSrcElts {
        ExtractIdx = Mask[IdxC.getZExtValue()];
        ExtractVT = SrcVT;
    } else {
        let mut Scale: u32 = Mask.len / NumSrcElts;
        if (Mask.len % NumSrcElts) != 0 || SrcVT.isFloatingPoint() {
            return SDValue {};
        }
        let mut ScaledIdx: u32 = Scale * IdxC.getZExtValue();
        if !isUndefOrZeroInRange(Mask, ScaledIdx + 1, Scale - 1) {
            return SDValue {};
        }
        ExtractIdx = Mask[ScaledIdx];
        let mut ExtractSVT: EVT = getIntegerVT(*DAG.getContext(), SrcEltBits / Scale);
        ExtractVT = getVectorVT(*DAG.getContext(), ExtractSVT, Mask.len, false);
        assert!(SrcVT.getSizeInBits() == ExtractVT.getSizeInBits(), "Failed to widen vector type");
    }
    if ExtractIdx == SM_SentinelUndef {
        return DAG.getUNDEF(VT);
    }
    if ExtractIdx == SM_SentinelZero {
        return if VT.isFloatingPoint() { DAG.getConstantFP(0.0, dl, VT, false) } else { DAG.getConstant(0, dl, VT, false, false) };
    }
    let mut SrcOp: SDValue = Ops[ExtractIdx / Mask.len];
    ExtractIdx = ExtractIdx % Mask.len;
    if GetLegalExtract.call(SrcOp, ExtractVT, ExtractIdx) {
        V;
    } else {
        return DAG.getZExtOrTrunc(V, dl, VT);
    }
    if N.getOpcode() == EXTRACT_VECTOR_ELT && ExtractVT == SrcVT {
        if combineExtractFromVectorLoad(N, SrcVT, peekThroughBitcasts(SrcOp), ExtractIdx, dl, DAG, DCI) {
            V;
        } else {
            return V;
        }
    }
    return SDValue {};
}

fn scalarizeExtEltFP(ExtElt: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, DCI: *mut DAGCombinerInfo) -> SDValue {
    assert!(ExtElt.getOpcode() == EXTRACT_VECTOR_ELT, "Expected extract");
    let mut Vec: SDValue = ExtElt.getOperand(0);
    let mut Index: SDValue = ExtElt.getOperand(1);
    let mut VT: EVT = ExtElt.getValueType(0);
    let mut VecVT: EVT = Vec.getValueType();
    if !Vec.hasOneUse() || !isNullConstant(Index) || VecVT.getScalarType() != VT {
        return SDValue {};
    }
    if Vec.getOpcode() == SETCC && VT == i1 {
        let mut OpVT: EVT = Vec.getOperand(0).getValueType().getScalarType();
        if OpVT != f32 && OpVT != f64 {
            return SDValue {};
        }
        let mut DL: SDLoc = ExtElt;
        let mut Ext0: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, OpVT, Vec.getOperand(0), Index);
        let mut Ext1: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, OpVT, Vec.getOperand(1), Index);
        return DAG.getNode(Vec.getOpcode(), DL, VT, Ext0, Ext1, Vec.getOperand(2));
    }
    if !(VT == f16 && Subtarget.hasFP16()) && VT != f32 && VT != f64 {
        return SDValue {};
    }
    if DCI.isBeforeLegalize() && Vec.getOpcode() == VSELECT && Vec.getOperand(0).getOpcode() == SETCC && Vec.getOperand(0).getOperand(0).getValueType() == VecVT && Vec.getOperand(0).getValueType().getScalarType() == i1 {
        let mut DL: SDLoc = ExtElt;
        let mut Ext0: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, Vec.getOperand(0).getValueType().getScalarType(), Vec.getOperand(0), Index);
        let mut Ext1: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Vec.getOperand(1), Index);
        let mut Ext2: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Vec.getOperand(2), Index);
        return DAG.getNode(SELECT, DL, VT, Ext0, Ext1, Ext2);
    }
    match Vec.getOpcode() {
        FMA => {
            FMAD;
        },
        _ => {
            return SDValue {};
        },
    }
    llvm_unreachable_internal("All opcodes should return within switch", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 48219);
}

fn combineArithReduction(ExtElt: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(ExtElt.getOpcode() == EXTRACT_VECTOR_ELT, "Unexpected caller");
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut Opc: NodeType = zeroed();
    let mut Rdx: SDValue = DAG.matchBinOpReduction(ExtElt, Opc, [ADD, FADD], true);
    if !Rdx {
        return SDValue {};
    }
    let mut Index: SDValue = ExtElt.getOperand(1);
    assert!(isNullConstant(Index), "Reduction doesn't end in an extract from index 0");
    let mut VT: EVT = ExtElt.getValueType(0);
    let mut VecVT: EVT = Rdx.getValueType();
    if VecVT.getScalarType() != VT {
        return SDValue {};
    }
    let mut DL: SDLoc = ExtElt;
    let mut NumElts: u32 = VecVT.getVectorNumElements();
    let mut EltSizeInBits: u32 = VecVT.getScalarSizeInBits();
    let mut WidenToV16I8: Closure_177 = Closure_177 { Subtarget: &mut Subtarget, DAG: &mut DAG, DL: &mut DL };
    if VecVT == v4i8 || VecVT == v8i8 {
        Rdx = WidenToV16I8.call(Rdx);
        Rdx = DAG.getNode(PSADBW, DL, v2i64, Rdx, DAG.getConstant(0, DL, v16i8, false, false));
        Rdx = DAG.getBitcast(v16i8, Rdx);
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Rdx, Index);
    }
    if (VecVT.getSizeInBits().operator unsigned long long() % 128) != 0 || !isPowerOf2_32(NumElts) {
        return SDValue {};
    }
    if VT == i8 {
        while Rdx.getValueSizeInBits().operator unsigned long long() > 128 {
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = splitVector(Rdx, DAG, DL);
            VecVT = Lo.getValueType();
            Rdx = DAG.getNode(ADD, DL, VecVT, Lo, Hi);
        }
        assert!(VecVT == v16i8, "v16i8 reduction expected");
        let mut Hi: SDValue = DAG.getVectorShuffle(v16i8, DL, Rdx, Rdx, [8, 9, 10, 11, 12, 13, 14, 15, -1, -1, -1, -1, -1, -1, -1, -1]);
        Rdx = DAG.getNode(ADD, DL, v16i8, Rdx, Hi);
        Rdx = DAG.getNode(PSADBW, DL, v2i64, Rdx, getZeroVector(v16i8, Subtarget, DAG, DL));
        Rdx = DAG.getBitcast(v16i8, Rdx);
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Rdx, Index);
    }
    if Opc == ADD && NumElts >= 4 && EltSizeInBits >= 16 && EltSizeInBits <= 64 && DAG.computeKnownBits(Rdx, 0).getMaxValue().ule(255) && (EltSizeInBits == 16 || Rdx.getOpcode() == ZERO_EXTEND || Subtarget.hasAVX512()) {
        if Rdx.getValueType() == v8i16 {
            Rdx = DAG.getNode(PACKUS, DL, v16i8, Rdx, DAG.getUNDEF(v8i16));
        } else if NumElts == 4 {
            Rdx = DAG.getNode(TRUNCATE, DL, v4i16, Rdx);
            Rdx = DAG.getBitcast(v8i8, Rdx);
            Rdx = WidenToV16I8.call(Rdx);
        } else {
            let mut ByteVT: EVT = VecVT.changeVectorElementType(*DAG.getContext(), i8);
            Rdx = DAG.getNode(TRUNCATE, DL, ByteVT, Rdx);
            if ByteVT.getSizeInBits().operator unsigned long long() < 128 {
                Rdx = WidenToV16I8.call(Rdx);
            }
        }
        let mut PSADBWBuilder: Closure_178 = Closure_178 {};
        let mut SadVT: MVT = getVectorVT(i64, Rdx.getValueSizeInBits().operator unsigned long long() / 64);
        Rdx = SplitOpsAndApply(DAG, Subtarget, DL, SadVT, [Rdx], PSADBWBuilder, true, true);
        while Rdx.getValueSizeInBits().operator unsigned long long() > 128 {
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = splitVector(Rdx, DAG, DL);
            VecVT = Lo.getValueType();
            Rdx = DAG.getNode(ADD, DL, VecVT, Lo, Hi);
        }
        assert!(Rdx.getValueType() == v2i64, "v2i64 reduction expected");
        if NumElts > 8 {
            let mut RdxHi: SDValue = DAG.getVectorShuffle(v2i64, DL, Rdx, Rdx, [1, -1]);
            Rdx = DAG.getNode(ADD, DL, v2i64, Rdx, RdxHi);
        }
        VecVT = getVectorVT(VT.getSimpleVT(), 128 / VT.getSizeInBits().operator unsigned long long());
        Rdx = DAG.getBitcast(VecVT, Rdx);
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Rdx, Index);
    }
    if !shouldUseHorizontalOp(true, DAG, Subtarget) {
        return SDValue {};
    }
    let mut HorizOpcode: u32 = if Opc == ADD { HADD } else { FHADD };
    if ((VecVT == v16i16 || VecVT == v8i32) && Subtarget.hasSSSE3()) || ((VecVT == v8f32 || VecVT == v4f64) && Subtarget.hasSSE3()) {
        let mut NumElts: u32 = VecVT.getVectorNumElements();
        let mut Hi: SDValue = extract128BitVector(Rdx, NumElts / 2, DAG, DL);
        let mut Lo: SDValue = extract128BitVector(Rdx, 0, DAG, DL);
        Rdx = DAG.getNode(HorizOpcode, DL, Lo.getValueType(), Hi, Lo);
        VecVT = Rdx.getValueType();
    }
    if !((VecVT == v8i16 || VecVT == v4i32) && Subtarget.hasSSSE3()) && !((VecVT == v4f32 || VecVT == v2f64) && Subtarget.hasSSE3()) {
        return SDValue {};
    }
    let mut ReductionSteps: u32 = Log2_32(VecVT.getVectorNumElements());
    for let mut i: u32 = 0; i != ReductionSteps; i += 1 {
        Rdx = DAG.getNode(HorizOpcode, DL, VecVT, Rdx, Rdx);
    }
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Rdx, Index);
}

fn combineExtractVectorElt(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if combineExtractWithShuffle(N, DAG, DCI, Subtarget) {
        NewOp;
    } else {
        return NewOp;
    }
    let mut InputVector: SDValue = N.getOperand(0);
    let mut EltIdx: SDValue = N.getOperand(1);
    let mut CIdx: *mut ConstantSDNode = dyn_cast(EltIdx);
    let mut SrcVT: EVT = InputVector.getValueType();
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = InputVector;
    let mut IsPextr: bool = N.getOpcode() != EXTRACT_VECTOR_ELT;
    let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
    let mut NumEltBits: u32 = VT.getScalarSizeInBits();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if CIdx && CIdx.getAPIntValue().uge(NumSrcElts) {
        return if IsPextr { DAG.getConstant(0, dl, VT, false, false) } else { DAG.getUNDEF(VT) };
    }
    if CIdx && VT.isInteger() {
        let mut UndefVecElts: APInt = APInt {};
        let mut EltBits: SmallVector<APInt, 16> = SmallVector<APInt, 16> {};
        let mut VecEltBitWidth: u32 = SrcVT.getScalarSizeInBits();
        if getTargetConstantBitsFromNode(InputVector, VecEltBitWidth, UndefVecElts, EltBits, true, false) {
            let mut Idx: u64 = CIdx.getZExtValue();
            if UndefVecElts[Idx] {
                return if IsPextr { DAG.getConstant(0, dl, VT, false, false) } else { DAG.getUNDEF(VT) };
            }
            return DAG.getConstant(EltBits[Idx].zext(NumEltBits), dl, VT, false, false);
        }
        if InputVector.getOpcode() == BITCAST && (NumEltBits % 8) == 0 {
            let mut Src: SDValue = peekThroughBitcasts(InputVector);
            if Src.getValueType().getScalarType() == i1 && TLI.isTypeLegal(Src.getValueType()) {
                let mut SubVT: MVT = getVectorVT(i1, NumEltBits);
                let mut Sub: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, dl, SubVT, Src, DAG.getVectorIdxConstant(CIdx.getZExtValue() * NumEltBits, dl, false));
                return DAG.getBitcast(VT, Sub);
            }
        }
    }
    if IsPextr {
        if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, getAllOnes(NumEltBits), DCI) {
            return SDValue { Node: N, ResNo: 0 };
        }
        if (InputVector.getOpcode() == PINSRB || InputVector.getOpcode() == PINSRW) && InputVector.getOperand(2) == EltIdx {
            assert!(SrcVT == InputVector.getOperand(0).getValueType(), "Vector type mismatch");
            let mut Scl: SDValue = InputVector.getOperand(1);
            Scl = DAG.getNode(TRUNCATE, dl, SrcVT.getScalarType(), Scl);
            return DAG.getZExtOrTrunc(Scl, dl, VT);
        }
        return SDValue {};
    }
    if CIdx && isBitwiseLogicOp(InputVector.getOpcode()) {
        let mut Idx: u32 = CIdx.getZExtValue();
        let mut DemandedElts: APInt = getOneBitSet(NumSrcElts, Idx);
        if TLI.SimplifyMultipleUseDemandedVectorElts(InputVector, DemandedElts, DAG, 0) {
            NewVector;
        } else if NewVector.getOpcode() == BUILD_VECTOR {
            return DAG.getNode(N.getOpcode(), dl, VT, NewVector, EltIdx);
        }
    }
    if VT == i64 && SrcVT == v1i64 && InputVector.getOpcode() == BITCAST && InputVector.getOperand(0).getValueType() == x86mmx && isNullConstant(EltIdx) && InputVector.hasOneUse() {
        return DAG.getBitcast(VT, InputVector);
    }
    if VT == i32 && SrcVT == v2i32 && InputVector.getOpcode() == BITCAST && InputVector.getOperand(0).getValueType() == x86mmx && isNullConstant(EltIdx) && InputVector.hasOneUse() {
        return DAG.getNode(MMX_MOVD2W, dl, i32, InputVector.getOperand(0));
    }
    if combineBasicSADPattern(N, DAG, Subtarget) {
        SAD;
    } else {
        return SAD;
    }
    if combineVPDPBUSDPattern(N, DAG, Subtarget) {
        VPDPBUSD;
    } else {
        return VPDPBUSD;
    }
    if combineArithReduction(N, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if scalarizeExtEltFP(N, DAG, Subtarget, DCI) {
        V;
    } else {
        return V;
    }
    if CIdx {
        if combineExtractFromVectorLoad(N, InputVector.getValueType(), InputVector, CIdx.getZExtValue(), dl, DAG, DCI) {
            V;
        } else {
            return V;
        }
    }
    if InputVector.getOpcode() == FSHL || InputVector.getOpcode() == FSHR {
        if CIdx && InputVector.hasOneUse() && TLI.isOperationLegal(InputVector.getOpcode(), VT) {
            let mut LHS: SDValue = DAG.getExtractVectorElt(dl, VT, InputVector.getOperand(0), CIdx.getZExtValue());
            let mut RHS: SDValue = DAG.getExtractVectorElt(dl, VT, InputVector.getOperand(1), CIdx.getZExtValue());
            let mut Amt: SDValue = DAG.getExtractVectorElt(dl, VT, InputVector.getOperand(2), CIdx.getZExtValue());
            Amt = DAG.getShiftAmountOperand(VT, Amt);
            return DAG.getNode(InputVector.getOpcode(), dl, VT, LHS, RHS, Amt);
        }
    }
    if SrcVT.getScalarType() == i1 {
        let mut IsVar: bool = !CIdx;
        let mut BoolExtracts: SmallVector<SDNode *, 16> = SmallVector<SDNode *, 16> {};
        let mut ResNo: u32 = InputVector.getResNo();
        let mut IsBoolExtract: Closure_179 = Closure_179 { BoolExtracts: &mut BoolExtracts, ResNo: &mut ResNo, IsVar: &mut IsVar };
        if all_of(operator(InputVector).users(), IsBoolExtract) && (IsVar || BoolExtracts.len > 1) {
            let mut BCVT: EVT = getIntegerVT(*DAG.getContext(), NumSrcElts);
            if combineBitcastvxi1(DAG, BCVT, InputVector, dl, Subtarget) {
                BC;
            } else {
                for Use in BoolExtracts {
                    let mut MaskIdx: SDValue = DAG.getZExtOrTrunc(Use.getOperand(1), dl, i8);
                    let mut MaskBit: SDValue = DAG.getConstant(1, dl, BCVT, false, false);
                    let mut Mask: SDValue = DAG.getNode(SHL, dl, BCVT, MaskBit, MaskIdx);
                    let mut Res: SDValue = DAG.getNode(AND, dl, BCVT, BC, Mask);
                    Res = DAG.getSetCC(dl, i1, Res, Mask, SETEQ, SDValue {}, false, None);
                    DCI.CombineTo(Use, Res, true);
                }
                return SDValue { Node: N, ResNo: 0 };
            }
        }
    }
    if CIdx && InputVector.getOpcode() == TRUNCATE {
        let mut TruncSrc: SDValue = InputVector.getOperand(0);
        let mut TruncSVT: EVT = TruncSrc.getValueType().getScalarType();
        if DCI.isBeforeLegalize() && TLI.isTypeLegal(TruncSVT) {
            let mut NewExt: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, dl, TruncSVT, TruncSrc, EltIdx);
            return DAG.getAnyExtOrTrunc(NewExt, dl, VT);
        }
    }
    return SDValue {};
}

fn combineVECREDUCE_MUL(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut NumElts: u32 = SrcVT.getVectorNumElements();
    let mut DL: SDLoc = N;
    if !isPowerOf2_32(NumElts) || SrcVT.getScalarType() != i8 {
        return SDValue {};
    }
    if NumElts == 2 {
        let mut Hi: SDValue = DAG.getVectorShuffle(SrcVT, DL, Src, Src, [1, -1]);
        let mut Rdx: SDValue = DAG.getNode(MUL, DL, SrcVT, Src, Hi);
        return DAG.getExtractVectorElt(DL, N.getValueType(0), Rdx, 0);
    }
    if SrcVT.getSizeInBits().operator unsigned long long() >= 128 {
        let mut WideVT: EVT = getVectorVT(*DAG.getContext(), i16, NumElts / 2, false);
        let mut Lo: SDValue = getUnpackl(DAG, DL, SrcVT, Src, DAG.getUNDEF(SrcVT));
        let mut Hi: SDValue = getUnpackh(DAG, DL, SrcVT, Src, DAG.getUNDEF(SrcVT));
        Src = DAG.getNode(MUL, DL, WideVT, DAG.getBitcast(WideVT, Lo), DAG.getBitcast(WideVT, Hi));
    } else {
        let mut ExtVT: EVT = SrcVT.changeVectorElementType(*DAG.getContext(), i16);
        Src = DAG.getNode(ANY_EXTEND, DL, ExtVT, Src);
    }
    Src = DAG.getNode(VECREDUCE_MUL, DL, i16, Src);
    return DAG.getZExtOrTrunc(Src, DL, N.getValueType(0));
}

fn combineToExtendBoolVectorInReg(Opcode: u32, DL: *SDLoc, VT: EVT, N0: SDValue, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if Opcode != SIGN_EXTEND && Opcode != ZERO_EXTEND && Opcode != ANY_EXTEND {
        return SDValue {};
    }
    if !DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if !Subtarget.hasSSE2() || Subtarget.hasAVX512() {
        return SDValue {};
    }
    let mut SVT: EVT = VT.getScalarType();
    let mut InSVT: EVT = N0.getValueType().getScalarType();
    let mut EltSizeInBits: u32 = SVT.getSizeInBits().operator unsigned long long();
    if !VT.isVector() {
        return SDValue {};
    }
    if SVT != i64 && SVT != i32 && SVT != i16 && SVT != i8 {
        return SDValue {};
    }
    if InSVT != i1 || N0.getOpcode() != BITCAST {
        return SDValue {};
    }
    let mut N00: SDValue = N0.getOperand(0);
    let mut SclVT: EVT = N00.getValueType();
    if !SclVT.isScalarInteger() {
        return SDValue {};
    }
    let mut Vec: SDValue = SDValue {};
    let mut ShuffleMask: SmallVector<int> = SmallVector<int> {};
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!(NumElts == SclVT.getSizeInBits().operator unsigned long long(), "Unexpected bool vector size");
    if NumElts > EltSizeInBits {
        assert!((NumElts % EltSizeInBits) == 0, "Unexpected integer scale");
        let mut Scale: u32 = NumElts / EltSizeInBits;
        let mut BroadcastVT: EVT = getVectorVT(*DAG.getContext(), SclVT, EltSizeInBits, false);
        let mut UseBroadcast: bool = Subtarget.hasInt256() && (!BroadcastVT.is128BitVector() || isa(N00));
        Vec = if UseBroadcast { DAG.getSplat(BroadcastVT, DL, N00) } else { DAG.getNode(SCALAR_TO_VECTOR, DL, BroadcastVT, N00) };
        Vec = DAG.getBitcast(VT, Vec);
        for let mut i: u32 = 0; i != Scale; i += 1 {
            let mut Offset: i32 = if UseBroadcast { (i * EltSizeInBits) } else { 0 };
            ShuffleMask.append(EltSizeInBits, i + Offset);
        }
        Vec = DAG.getVectorShuffle(VT, DL, Vec, Vec, ShuffleMask);
    } else if Subtarget.hasAVX2() && NumElts < EltSizeInBits && (SclVT == i8 || SclVT == i16 || SclVT == i32) {
        assert!((EltSizeInBits % NumElts) == 0, "Unexpected integer scale");
        let mut BroadcastVT: EVT = getVectorVT(*DAG.getContext(), SclVT, (NumElts * EltSizeInBits) / NumElts, false);
        Vec = DAG.getBitcast(VT, DAG.getSplat(BroadcastVT, DL, N00));
    } else {
        Vec = DAG.getSplat(VT, DL, DAG.getAnyExtOrTrunc(N00, DL, SVT));
    }
    let mut Bits: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut BitIdx: i32 = (i % EltSizeInBits);
        let mut Bit: APInt = getBitsSet(EltSizeInBits, BitIdx, BitIdx + 1);
        Bits.push(DAG.getConstant(Bit, DL, SVT, false, false));
    }
    let mut BitMask: SDValue = DAG.getBuildVector(VT, DL, Bits);
    Vec = DAG.getNode(AND, DL, VT, Vec, BitMask);
    let mut CCVT: EVT = getVectorVT(*DAG.getContext(), i1, NumElts, false);
    Vec = DAG.getSetCC(DL, CCVT, Vec, BitMask, SETEQ, SDValue {}, false, None);
    Vec = DAG.getSExtOrTrunc(Vec, DL, VT);
    if Opcode == SIGN_EXTEND {
        return Vec;
    }
    return DAG.getNode(SRL, DL, VT, Vec, DAG.getConstant(EltSizeInBits - 1, DL, VT, false, false));
}

fn narrowVectorSelect(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    if Opcode != BLENDV && Opcode != VSELECT {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !VT.is256BitVector() {
        return SDValue {};
    }
    let mut Cond: SDValue = N.getOperand(0);
    let mut TVal: SDValue = N.getOperand(1);
    let mut FVal: SDValue = N.getOperand(2);
    if !TVal.hasOneUse() || !FVal.hasOneUse() || !isFreeToSplitVector(TVal, DAG) || !isFreeToSplitVector(FVal, DAG) {
        return SDValue {};
    }
    let mut makeBlend: Closure_180 = Closure_180 { Opcode: Opcode };
    return SplitOpsAndApply(DAG, Subtarget, DL, VT, [Cond, TVal, FVal], makeBlend, false, true);
}

fn combineSelectOfTwoConstants(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    let mut Cond: SDValue = N.getOperand(0);
    let mut LHS: SDValue = N.getOperand(1);
    let mut RHS: SDValue = N.getOperand(2);
    let mut TrueC: *mut ConstantSDNode = dyn_cast(LHS);
    let mut FalseC: *mut ConstantSDNode = dyn_cast(RHS);
    if !TrueC || !FalseC {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !DAG.getTargetLoweringInfo().isTypeLegal(VT) {
        return SDValue {};
    }
    if Cond.getValueType() != i1 {
        return SDValue {};
    }
    let mut TrueVal: *APInt = TrueC.getAPIntValue();
    let mut FalseVal: *APInt = FalseC.getAPIntValue();
    if (TrueVal.isAllOnes() || FalseVal.isAllOnes()) && Cond.getOpcode() == SETCC && isNullConstant(Cond.getOperand(1)) {
        let mut CC: CondCode = cast(Cond.getOperand(2)).get();
        if CC == SETEQ || CC == SETNE {
            return SDValue {};
        }
    }
    let mut OV: bool = false;
    let mut Diff: APInt = TrueVal.ssub_ov(FalseVal, OV);
    if OV {
        return SDValue {};
    }
    let mut AbsDiff: APInt = Diff.abs();
    if AbsDiff.isPowerOf2() || ((VT == i32 || VT == i64) && (AbsDiff == 3 || AbsDiff == 5 || AbsDiff == 9)) {
        if TrueVal.slt(FalseVal) {
            Cond = DAG.getNOT(DL, Cond, i1);
            swap(TrueC, FalseC);
        }
        let mut R: SDValue = DAG.getNode(ZERO_EXTEND, DL, VT, Cond);
        if !AbsDiff.isOne() {
            R = DAG.getNode(MUL, DL, VT, R, DAG.getConstant(AbsDiff, DL, VT, false, false));
        }
        if !FalseC.isZero() {
            R = DAG.getNode(ADD, DL, VT, R, SDValue { Node: FalseC, ResNo: 0 });
        }
        return R;
    }
    return SDValue {};
}

fn combineVSelectToBLENDV(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Cond: SDValue = N.getOperand(0);
    if (N.getOpcode() != VSELECT && N.getOpcode() != BLENDV) || isBuildVectorOfConstantSDNodes(Cond.getNode()) {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut BitWidth: u32 = Cond.getScalarValueSizeInBits();
    let mut VT: EVT = N.getValueType(0);
    if !TLI.isOperationLegalOrCustom(VSELECT, VT, false) {
        return SDValue {};
    }
    if VT.getVectorElementType() == i16 {
        return SDValue {};
    }
    if VT.is128BitVector() && !Subtarget.hasSSE41() {
        return SDValue {};
    }
    if VT == v32i8 && !Subtarget.hasAVX2() {
        return SDValue {};
    }
    if VT.is512BitVector() {
        return SDValue {};
    }
    if BitWidth < 8 || BitWidth > 64 {
        return SDValue {};
    }
    let mut OnlyUsedAsSelectCond: Closure_181 = Closure_181 {};
    let mut DemandedBits: APInt = getSignMask(BitWidth);
    if OnlyUsedAsSelectCond.call(Cond) {
        let mut Known: KnownBits = KnownBits {};
        let mut TLO: TargetLoweringOpt = TargetLoweringOpt { DAG, !DCI.isBeforeLegalize(), !DCI.isBeforeLegalizeOps() };
        if !TLI.SimplifyDemandedBits(Cond, DemandedBits, Known, TLO, 0, true) {
            return SDValue {};
        }
        for U in operator(Cond).users() {
            if U.getOpcode() == BLENDV {
                continue;
            }
            let mut SB: SDValue = DAG.getNode(BLENDV, U, U.getValueType(0), Cond, U.getOperand(1), U.getOperand(2));
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: U, ResNo: 0 }, SB);
            DCI.AddToWorklist(U);
        }
        DCI.CommitTargetLoweringOpt(TLO);
        return SDValue { Node: N, ResNo: 0 };
    }
    if TLI.SimplifyMultipleUseDemandedBits(Cond, DemandedBits, DAG, 0) {
        V;
    } else {
        return DAG.getNode(BLENDV, DL, N.getValueType(0), V, N.getOperand(1), N.getOperand(2));
    }
    return SDValue {};
}

fn combineLogicBlendIntoConditionalNegate(VT: EVT, Mask: SDValue, X: SDValue, Y: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut MaskVT: EVT = Mask.getValueType();
    assert!(MaskVT.isInteger() && DAG.ComputeNumSignBits(Mask, 0) == MaskVT.getScalarSizeInBits(), "Mask must be zero/all-bits");
    if X.getValueType() != MaskVT || Y.getValueType() != MaskVT || !DAG.getTargetLoweringInfo().isOperationLegal(SUB, MaskVT) {
        return SDValue {};
    }
    let mut V: SDValue = SDValue {};
    if !sd_match(Y, m_Neg(m_Value(V, m_Specific(X)))) && !sd_match(X, m_Neg(m_Value(V, m_Specific(Y)))) {
        return SDValue {};
    }
    let mut SubOp1: SDValue = DAG.getNode(XOR, DL, MaskVT, V, Mask);
    let mut SubOp2: SDValue = Mask;
    if V == Y {
        swap(SubOp1, SubOp2);
    }
    let mut Res: SDValue = DAG.getNode(SUB, DL, MaskVT, SubOp1, SubOp2);
    return DAG.getBitcast(VT, Res);
}

fn commuteSelect(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasAVX512() {
        return SDValue {};
    }
    let mut CC: CondCode = zeroed();
    let mut Cond: SDValue = SDValue {};
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if !sd_match(N, m_VSelect(m_Value(Cond, m_SetCC(CC, m_Value(X), m_Value(Y))), m_Value(LHS), m_Value(RHS))) {
        return SDValue {};
    }
    if canCombineAsMaskOperation(LHS, Subtarget) || !canCombineAsMaskOperation(RHS, Subtarget) {
        return SDValue {};
    }
    if !Cond.hasOneUse() {
        if !all_of(operator(Cond).users(), Closure_182 { Cond: &mut Cond, Subtarget: &mut Subtarget }) {
            return SDValue {};
        }
    }
    let mut NewCC: CondCode = getSetCCInverse(CC, X.getValueType());
    let mut NewCond: SDValue = DAG.getSetCC(Cond, Cond.getValueType(), X, Y, NewCC, SDValue {}, false, None);
    return DAG.getSelect(DL, LHS.getValueType(), NewCond, RHS, LHS, SDNodeFlags { Flags: None });
}

fn combineSelect(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Cond: SDValue = N.getOperand(0);
    let mut LHS: SDValue = N.getOperand(1);
    let mut RHS: SDValue = N.getOperand(2);
    if DAG.simplifySelect(Cond, LHS, RHS) {
        V;
    } else {
        return V;
    }
    if commuteSelect(N, DAG, DL, Subtarget) {
        V;
    } else {
        return V;
    }
    let mut VT: EVT = LHS.getValueType();
    let mut CondVT: EVT = Cond.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut CondConstantVector: bool = isBuildVectorOfConstantSDNodes(Cond.getNode());
    let mut EltBitWidth: u32 = VT.getScalarSizeInBits();
    if CondVT.isVector() && CondVT.isInteger() && CondVT.getScalarSizeInBits() == VT.getScalarSizeInBits() && (!CondConstantVector || CondVT.getScalarType() == i8) && DAG.ComputeNumSignBits(Cond, 0) == CondVT.getScalarSizeInBits() {
        if combineLogicBlendIntoConditionalNegate(VT, Cond, RHS, LHS, DL, DAG, Subtarget) {
            V;
        } else {
            return V;
        }
    }
    if N.getOpcode() == BLENDV {
        let mut KnownCond: KnownBits = DAG.computeKnownBits(Cond, 0);
        if KnownCond.isNegative() {
            return LHS;
        }
        if KnownCond.isNonNegative() {
            return RHS;
        }
    }
    if N.getOpcode() == VSELECT || N.getOpcode() == BLENDV {
        let mut CondMask: SmallVector<int, 64> = SmallVector<int, 64> {};
        if createShuffleMaskFromVSELECT(CondMask, Cond, N.getOpcode() == BLENDV) {
            if DCI.isBeforeLegalizeOps() {
                return DAG.getVectorShuffle(VT, DL, LHS, RHS, CondMask);
            }
            if LHS.hasOneUse() && RHS.hasOneUse() {
                let mut LHSOps: SmallVector<SDValue, 1> = SmallVector<SDValue, 1> {};
                let mut RHSOps: SmallVector<SDValue, 1> = SmallVector<SDValue, 1> {};
                let mut LHSMask: SmallVector<int, 64> = SmallVector<int, 64> {};
                let mut RHSMask: SmallVector<int, 64> = SmallVector<int, 64> {};
                let mut ByteMask: SmallVector<int, 64> = SmallVector<int, 64> {};
                let mut LHSShuf: SDValue = peekThroughOneUseBitcasts(LHS);
                let mut RHSShuf: SDValue = peekThroughOneUseBitcasts(RHS);
                if LHSShuf.getOpcode() == PSHUFB && RHSShuf.getOpcode() == PSHUFB && scaleShuffleMaskElts(VT.getSizeInBits().operator unsigned long long() / 8, CondMask, ByteMask) && getTargetShuffleMask(LHSShuf, true, LHSOps, LHSMask) && getTargetShuffleMask(RHSShuf, true, RHSOps, RHSMask) {
                    assert!(ByteMask.len == LHSMask.len && ByteMask.len == RHSMask.len, "Shuffle mask mismatch");
                    for x in enumerate(ByteMask) {
                        if M < ByteMask.len as i32 {
                            LHSMask[I] = if isUndefOrZero(LHSMask[I]) { 128 } else { LHSMask[I] };
                            RHSMask[I] = 128;
                        } else {
                            LHSMask[I] = 128;
                            RHSMask[I] = if isUndefOrZero(RHSMask[I]) { 128 } else { RHSMask[I] };
                        }
                    }
                    let mut ByteVT: MVT = LHSShuf.getSimpleValueType();
                    LHS = DAG.getNode(PSHUFB, DL, ByteVT, LHSOps[0], getConstVector(LHSMask, ByteVT, DAG, DL, true));
                    RHS = DAG.getNode(PSHUFB, DL, ByteVT, RHSOps[0], getConstVector(RHSMask, ByteVT, DAG, DL, true));
                    return DAG.getBitcast(VT, DAG.getNode(OR, DL, ByteVT, LHS, RHS));
                }
            }
            let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
            if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
                Res;
            } else {
                return Res;
            }
        }
    }
    if Subtarget.hasAVX512() && N.getOpcode() == SELECT && Cond.getOpcode() == SETCC && (VT == f32 || VT == f64) {
        let mut CC: CondCode = cast(Cond.getOperand(2)).get();
        let mut AndNode: SDValue = Cond.getOperand(0);
        if AndNode.getOpcode() == AND && CC == SETEQ && isNullConstant(Cond.getOperand(1)) && isOneConstant(AndNode.getOperand(1)) {
            AndNode = DAG.getZExtOrTrunc(AndNode, DL, i8);
            return DAG.getNode(SELECT, DL, VT, AndNode, RHS, LHS);
        }
    }
    if Subtarget.hasAVX512() && !Subtarget.hasBWI() && CondVT.isVector() && CondVT.getVectorElementType() == i1 && (VT.getVectorElementType() == i8 || VT.getVectorElementType() == i16) {
        if LHS.getOpcode() == TRUNCATE {
            let mut TruncSrc: SDValue = LHS.getOperand(0);
            let mut TruncSrcVT: EVT = TruncSrc.getValueType();
            if (VT == v8i16 && TruncSrcVT == v8i64) || (VT == v16i8 && TruncSrcVT == v16i32) || (VT == v16i16 && TruncSrcVT == v16i32) {
                return DAG.getNode(VMTRUNC, DL, VT, TruncSrc, RHS, Cond);
            }
        }
        Cond = DAG.getNode(SIGN_EXTEND, DL, VT, Cond);
        return DAG.getNode(N.getOpcode(), DL, VT, Cond, LHS, RHS);
    }
    if Subtarget.hasAVX512() && CondVT.isVector() && CondVT.getVectorElementType() == i1 && isBuildVectorAllZeros(RHS.getNode()) && LHS.hasOneUse() {
        if LHS.getOpcode() == VTRUNC {
            let mut TruncSrc: SDValue = LHS.getOperand(0);
            let mut TruncSrcVT: EVT = TruncSrc.getValueType();
            if VT == v16i8 && TruncSrcVT == v8i64 {
                let mut MaskCond: SDValue = DAG.getExtractSubvector(DL, v8i1, Cond, 0);
                return DAG.getNode(VMTRUNC, DL, VT, TruncSrc, RHS, MaskCond);
            }
        }
    }
    if Subtarget.hasAVX512() && CondVT.isVector() && CondVT.getVectorElementType() == i1 {
        let mut SelectableOp: Closure_183 = Closure_183 { TLI: &mut TLI };
        let mut SelectableLHS: bool = SelectableOp.call(LHS, RHS);
        let mut SelectableRHS: bool = SelectableOp.call(RHS, LHS);
        if SelectableLHS || SelectableRHS {
            let mut SrcVT: EVT = if SelectableLHS { LHS.getOperand(0).getValueType() } else { RHS.getOperand(0).getValueType() };
            let mut SrcCondVT: EVT = SrcVT.changeVectorElementType(*DAG.getContext(), i1);
            LHS = insertSubVector(DAG.getUNDEF(SrcVT), LHS, 0, DAG, DL, VT.getSizeInBits().operator unsigned long long());
            RHS = insertSubVector(DAG.getUNDEF(SrcVT), RHS, 0, DAG, DL, VT.getSizeInBits().operator unsigned long long());
            Cond = DAG.getNode(INSERT_SUBVECTOR, DL, SrcCondVT, DAG.getUNDEF(SrcCondVT), Cond, DAG.getVectorIdxConstant(0, DL, false));
            let mut Res: SDValue = DAG.getSelect(DL, SrcVT, Cond, LHS, RHS, SDNodeFlags { Flags: None });
            return extractSubVector(Res, 0, DAG, DL, VT.getSizeInBits().operator unsigned long long());
        }
    }
    if combineSelectOfTwoConstants(N, DAG, DL) {
        V;
    } else {
        return V;
    }
    if N.getOpcode() == SELECT && Cond.getOpcode() == SETCC && Cond.hasOneUse() {
        let mut CondVT: EVT = Cond.getValueType();
        let mut Cond0: SDValue = Cond.getOperand(0);
        let mut Cond1: SDValue = Cond.getOperand(1);
        let mut CC: CondCode = cast(Cond.getOperand(2)).get();
        if LHS == Cond0 && RHS == Cond1 {
            if (CC == SETGT && (isNullConstant(RHS) || isOneConstant(RHS))) || (CC == SETLT && isAllOnesConstant(RHS)) {
                let mut NewCC: CondCode = if CC == SETGT { SETGE } else { SETLE };
                Cond = DAG.getSetCC(Cond, CondVT, Cond0, Cond1, NewCC, SDValue {}, false, None);
                return DAG.getSelect(DL, VT, Cond, LHS, RHS, SDNodeFlags { Flags: None });
            }
            if CC == SETUGT && isOneConstant(RHS) {
                let mut NewCC: CondCode = SETUGE;
                Cond = DAG.getSetCC(Cond, CondVT, Cond0, Cond1, NewCC, SDValue {}, false, None);
                return DAG.getSelect(DL, VT, Cond, LHS, RHS, SDNodeFlags { Flags: None });
            }
        }
        if RHS.getOpcode() == SELECT && RHS.getOperand(1) == LHS && RHS.getOperand(0).getOpcode() == SETCC {
            let mut InnerSetCC: SDValue = RHS.getOperand(0);
            let mut InnerCC: CondCode = cast(InnerSetCC.getOperand(2)).get();
            if (CC == SETEQ || InnerCC == SETEQ) && Cond0 == InnerSetCC.getOperand(0) && Cond1 == InnerSetCC.getOperand(1) {
                let mut NewCC: CondCode = zeroed();
                match if CC == SETEQ { InnerCC } else { CC } {
                    SETGT => {
                        NewCC = SETGE;
                    },
                    SETLT => {
                        NewCC = SETLE;
                    },
                    SETUGT => {
                        NewCC = SETUGE;
                    },
                    SETULT => {
                        NewCC = SETULE;
                    },
                    _ => {
                        NewCC = SETCC_INVALID;
                    },
                }
                if NewCC != SETCC_INVALID {
                    Cond = DAG.getSetCC(DL, CondVT, Cond0, Cond1, NewCC, SDValue {}, false, None);
                    return DAG.getSelect(DL, VT, Cond, LHS, RHS.getOperand(2), SDNodeFlags { Flags: None });
                }
            }
        }
    }
    if N.getOpcode() == VSELECT && Cond.hasOneUse() && Subtarget.hasAVX512() && CondVT.getVectorElementType() == i1 && isBuildVectorAllZeros(LHS.getNode()) && !isBuildVectorAllZeros(RHS.getNode()) {
        let mut CondNew: SDValue = DAG.getNOT(DL, Cond, CondVT);
        return DAG.getSelect(DL, VT, CondNew, RHS, LHS, SDNodeFlags { Flags: None });
    }
    if N.getOpcode() == VSELECT && Cond.getOpcode() == BITCAST && CondVT.getVectorElementType() == i1 && TLI.isTypeLegal(VT.getScalarType()) {
        let mut ExtCondVT: EVT = VT.changeVectorElementTypeToInteger();
        if combineToExtendBoolVectorInReg(SIGN_EXTEND, DL, ExtCondVT, Cond, DAG, DCI, Subtarget) {
            ExtCond;
        } else {
            ExtCond = DAG.getNode(TRUNCATE, DL, CondVT, ExtCond);
            return DAG.getSelect(DL, VT, ExtCond, LHS, RHS, SDNodeFlags { Flags: None });
        }
    }
    if N.getOpcode() == VSELECT {
        if (LHS.getOpcode() == SRL || LHS.getOpcode() == SHL) && supportedVectorVarShift(VT, Subtarget, LHS.getOpcode()) && isConstantSplatVectorAllZeros(RHS.getNode(), false) && sd_match(Cond, m_SpecificSetCC(SETULT, m_Specific(LHS.getOperand(1)), m_SpecificInt(VT.getScalarSizeInBits()))) {
            return DAG.getNode(if LHS.getOpcode() == SRL { VSRLV } else { VSHLV }, DL, VT, LHS.getOperand(0), LHS.getOperand(1));
        }
        if (RHS.getOpcode() == SRL || RHS.getOpcode() == SHL) && supportedVectorVarShift(VT, Subtarget, RHS.getOpcode()) && isConstantSplatVectorAllZeros(LHS.getNode(), false) && sd_match(Cond, m_SpecificSetCC(SETUGE, m_Specific(RHS.getOperand(1)), m_SpecificInt(VT.getScalarSizeInBits()))) {
            return DAG.getNode(if RHS.getOpcode() == SRL { VSRLV } else { VSHLV }, DL, VT, RHS.getOperand(0), RHS.getOperand(1));
        }
    }
    if !TLI.isTypeLegal(VT) || isSoftF16(VT, Subtarget) {
        return SDValue {};
    }
    if combineVSelectToBLENDV(N, DAG, DL, DCI, Subtarget) {
        V;
    } else {
        return V;
    }
    if narrowVectorSelect(N, DAG, DL, Subtarget) {
        V;
    } else {
        return V;
    }
    if CondVT.isVector() && CondVT.getScalarType() != i1 {
        if IsNOT(Cond, DAG) {
            CondNot;
        } else {
            return DAG.getNode(N.getOpcode(), DL, VT, DAG.getBitcast(CondVT, CondNot), RHS, LHS);
        }
        if Cond.getOpcode() == PCMPEQ && Cond.getOperand(0).getOpcode() == AND && isBuildVectorAllZeros(Cond.getOperand(1).getNode()) && isConstantPowerOf2(Cond.getOperand(0).getOperand(1), Cond.getScalarValueSizeInBits(), true) && Cond.hasOneUse() {
            Cond = DAG.getNode(PCMPEQ, DL, CondVT, Cond.getOperand(0), Cond.getOperand(0).getOperand(1));
            return DAG.getNode(N.getOpcode(), DL, VT, Cond, RHS, LHS);
        }
        if Cond.getOpcode() == PCMPGT && isBuildVectorAllOnes(Cond.getOperand(1).getNode()) && Cond.hasOneUse() {
            Cond = DAG.getNode(PCMPGT, DL, CondVT, DAG.getConstant(0, DL, CondVT, false, false), Cond.getOperand(0));
            return DAG.getNode(N.getOpcode(), DL, VT, Cond, RHS, LHS);
        }
    }
    if N.getOpcode() == SELECT && VT.isVector() && VT.getVectorElementType() == i1 && (DCI.isBeforeLegalize() || (VT != v64i1 || Subtarget.is64Bit())) {
        let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), VT.getVectorNumElements());
        if DCI.isBeforeLegalize() || TLI.isTypeLegal(IntVT) {
            let mut LHSIsConst: bool = isBuildVectorOfConstantSDNodes(LHS.getNode());
            let mut RHSIsConst: bool = isBuildVectorOfConstantSDNodes(RHS.getNode());
            if (LHSIsConst || (LHS.getOpcode() == BITCAST && LHS.getOperand(0).getValueType() == IntVT)) && (RHSIsConst || (RHS.getOpcode() == BITCAST && RHS.getOperand(0).getValueType() == IntVT)) {
                if LHSIsConst {
                    LHS = combinevXi1ConstantToInteger(LHS, DAG);
                } else {
                    LHS = LHS.getOperand(0);
                }
                if RHSIsConst {
                    RHS = combinevXi1ConstantToInteger(RHS, DAG);
                } else {
                    RHS = RHS.getOperand(0);
                }
                let mut Select: SDValue = DAG.getSelect(DL, IntVT, Cond, LHS, RHS, SDNodeFlags { Flags: None });
                return DAG.getBitcast(VT, Select);
            }
        }
    }
    if DCI.isBeforeLegalize() && !Subtarget.hasAVX512() && N.getOpcode() == VSELECT && Cond.getOpcode() == SETCC && Cond.hasOneUse() && CondVT.getVectorElementType() == i1 && Cond.getOperand(0).getOpcode() == AND && isNullOrNullSplat(Cond.getOperand(1), false) && cast(Cond.getOperand(2)).get() == SETEQ && Cond.getOperand(0).getScalarValueSizeInBits() == EltBitWidth {
        let mut And: SDValue = Cond.getOperand(0);
        let mut Mask: SDValue = And.getOperand(1);
        let mut MskVT: EVT = Mask.getValueType();
        let mut C: *mut ConstantSDNode = isConstOrConstSplat(Mask, false, false);
        if C && C.getAPIntValue().isPowerOf2() {
            let mut NotCond: SDValue = DAG.getSetCC(DL, CondVT, And, Cond.getOperand(1), SETNE, SDValue {}, false, None);
            return DAG.getSelect(DL, VT, NotCond, RHS, LHS, SDNodeFlags { Flags: None });
        }
        let mut CanShiftBlend: bool = TLI.isTypeLegal(VT) && ((Subtarget.hasAVX() && EltBitWidth == 32) || (Subtarget.hasAVX2() && EltBitWidth == 64) || (Subtarget.hasXOP()));
        if CanShiftBlend && DAG.isKnownToBeAPowerOfTwo(Mask, false, 0) {
            if DAG.FoldConstantArithmetic(CTLZ, DL, MskVT, Mask, SDNodeFlags { Flags: None }) {
                ShlAmt;
            } else {
                let mut Shl: SDValue = DAG.getNode(SHL, DL, MskVT, And.getOperand(0), ShlAmt);
                let mut NewCond: SDValue = DAG.getSetCC(DL, CondVT, Shl, Cond.getOperand(1), SETLT, SDValue {}, false, None);
                return DAG.getSelect(DL, VT, NewCond, RHS, LHS, SDNodeFlags { Flags: None });
            }
        }
    }
    return SDValue {};
}

fn combineSetCCAtomicArith(Cmp: SDValue, CC: *mut CondCode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !(Cmp.getOpcode() == CMP || (Cmp.getOpcode() == SUB && !operator(Cmp).hasAnyUseOfValue(0))) {
        return SDValue {};
    }
    if !Cmp.hasOneUse() {
        return SDValue {};
    }
    let mut CmpLHS: SDValue = Cmp.getOperand(0);
    let mut CmpRHS: SDValue = Cmp.getOperand(1);
    let mut CmpVT: EVT = CmpLHS.getValueType();
    if !CmpLHS.hasOneUse() {
        return SDValue {};
    }
    let mut Opc: u32 = CmpLHS.getOpcode();
    if Opc != ATOMIC_LOAD_ADD && Opc != ATOMIC_LOAD_SUB {
        return SDValue {};
    }
    let mut OpRHS: SDValue = CmpLHS.getOperand(2);
    let mut OpRHSC: *mut ConstantSDNode = dyn_cast(OpRHS);
    if !OpRHSC {
        return SDValue {};
    }
    let mut Addend: APInt = OpRHSC.getAPIntValue();
    if Opc == ATOMIC_LOAD_SUB {
        Addend = operator(Addend);
    }
    let mut CmpRHSC: *mut ConstantSDNode = dyn_cast(CmpRHS);
    if !CmpRHSC {
        return SDValue {};
    }
    let mut Comparison: APInt = CmpRHSC.getAPIntValue();
    let mut NegAddend: APInt = operator(Addend);
    if Comparison != NegAddend {
        let mut IncComparison: APInt = Comparison + 1;
        if IncComparison == NegAddend {
            if CC == COND_A && !Comparison.isMaxValue() {
                Comparison = move(IncComparison);
                CC = COND_AE;
            } else if CC == COND_LE && !Comparison.isMaxSignedValue() {
                Comparison = move(IncComparison);
                CC = COND_L;
            }
        }
        let mut DecComparison: APInt = Comparison - 1;
        if DecComparison == NegAddend {
            if CC == COND_AE && !Comparison.isMinValue() {
                Comparison = move(DecComparison);
                CC = COND_A;
            } else if CC == COND_L && !Comparison.isMinSignedValue() {
                Comparison = move(DecComparison);
                CC = COND_LE;
            }
        }
    }
    if Comparison == NegAddend {
        let mut AN: *mut AtomicSDNode = cast(CmpLHS.getNode());
        let mut AtomicSub: SDValue = DAG.getAtomic(ATOMIC_LOAD_SUB, CmpLHS, CmpVT, CmpLHS.getOperand(0), CmpLHS.getOperand(1), DAG.getConstant(NegAddend, CmpRHS, CmpVT, false, false), AN.getMemOperand());
        let mut LockOp: SDValue = lowerAtomicArithWithLOCK(AtomicSub, DAG, Subtarget);
        DAG.ReplaceAllUsesOfValueWith(CmpLHS.getValue(0), DAG.getUNDEF(CmpVT));
        DAG.ReplaceAllUsesOfValueWith(CmpLHS.getValue(1), LockOp.getValue(1));
        return LockOp;
    }
    if !Comparison.isZero() {
        return SDValue {};
    }
    if CC == COND_S && Addend == 1 {
        CC = COND_LE;
    } else if CC == COND_NS && Addend == 1 {
        CC = COND_G;
    } else if CC == COND_G && Addend == -1 {
        CC = COND_GE;
    } else if CC == COND_LE && Addend == -1 {
        CC = COND_L;
    } else {
        return SDValue {};
    }
    let mut LockOp: SDValue = lowerAtomicArithWithLOCK(CmpLHS, DAG, Subtarget);
    DAG.ReplaceAllUsesOfValueWith(CmpLHS.getValue(0), DAG.getUNDEF(CmpVT));
    DAG.ReplaceAllUsesOfValueWith(CmpLHS.getValue(1), LockOp.getValue(1));
    return LockOp;
}

fn checkSignTestSetCCCombine(Cmp: SDValue, CC: *mut CondCode, DAG: *mut SelectionDAG) -> SDValue {
    if CC != COND_S && CC != COND_NS {
        return SDValue {};
    }
    if !Cmp.hasOneUse() {
        return SDValue {};
    }
    let mut Src: SDValue = SDValue {};
    if Cmp.getOpcode() == CMP {
        if !isNullConstant(Cmp.getOperand(1)) {
            return SDValue {};
        }
        Src = Cmp.getOperand(0);
        if !Src.hasOneUse() {
            return SDValue {};
        }
        if Src.getOpcode() == SRA {
            Src = Src.getOperand(0);
        } else if Src.getOpcode() != SHL && Src.getOpcode() != SIGN_EXTEND_INREG {
            return SDValue {};
        }
    } else if Cmp.getOpcode() == OR {
        if DAG.SignBitIsZero(Cmp.getOperand(0), 0) {
            Src = Cmp.getOperand(1);
        } else if DAG.SignBitIsZero(Cmp.getOperand(1), 0) {
            Src = Cmp.getOperand(0);
        } else {
            return SDValue {};
        }
    } else {
        return SDValue {};
    }
    let mut DL: SDLoc = Cmp;
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut BitMask: APInt = getSignMask(SrcVT.getScalarSizeInBits());
    if Src.getOpcode() == SHL {
        if DAG.getValidShiftAmount(Src, 0) {
            ShiftAmt;
        } else {
            Src = Src.getOperand(0);
            BitMask.lshrInPlace(operator(ShiftAmt));
        }
    } else if Src.getOpcode() == SIGN_EXTEND_INREG {
        let mut ExtVT: EVT = cast(Src.getOperand(1)).getVT();
        Src = Src.getOperand(0);
        BitMask.lshrInPlace(BitMask.getBitWidth() - ExtVT.getScalarSizeInBits());
    }
    let mut Mask: SDValue = DAG.getNode(AND, DL, SrcVT, Src, DAG.getConstant(BitMask, DL, SrcVT, false, false));
    CC = if CC == COND_S { COND_NE } else { COND_E };
    return DAG.getNode(CMP, DL, i32, Mask, DAG.getConstant(0, DL, SrcVT, false, false));
}

fn checkBoolTestSetCCCombine(Cmp: SDValue, CC: *mut CondCode) -> SDValue {
    if !(Cmp.getOpcode() == CMP || (Cmp.getOpcode() == SUB && !operator(Cmp).hasAnyUseOfValue(0))) {
        return SDValue {};
    }
    if CC != COND_E && CC != COND_NE {
        return SDValue {};
    }
    let mut Op1: SDValue = Cmp.getOperand(0);
    let mut Op2: SDValue = Cmp.getOperand(1);
    let mut SetCC: SDValue = SDValue {};
    let mut C: *ConstantSDNode = null;
    let mut needOppositeCond: bool = (CC == COND_E);
    let mut checkAgainstTrue: bool = false;
    if (C = dyn_cast(Op1)) {
        SetCC = Op2;
    } else if (C = dyn_cast(Op2)) {
        SetCC = Op1;
    } else {
        return SDValue {};
    }
    if C.getZExtValue() == 1 {
        needOppositeCond = !needOppositeCond;
        checkAgainstTrue = true;
    } else if C.getZExtValue() != 0 {
        return SDValue {};
    }
    let mut truncatedToBoolWithAnd: bool = false;
    while SetCC.getOpcode() == ZERO_EXTEND || SetCC.getOpcode() == TRUNCATE || SetCC.getOpcode() == AND {
        if SetCC.getOpcode() == AND {
            let mut OpIdx: i32 = -1;
            if isOneConstant(SetCC.getOperand(0)) {
                OpIdx = 1;
            }
            if isOneConstant(SetCC.getOperand(1)) {
                OpIdx = 0;
            }
            if OpIdx < 0 {
                break;
            }
            SetCC = SetCC.getOperand(OpIdx);
            truncatedToBoolWithAnd = true;
        } else {
            SetCC = SetCC.getOperand(0);
        }
    }
    match SetCC.getOpcode() {
        SETCC_CARRY => {
            if checkAgainstTrue && !truncatedToBoolWithAnd {
                break;
            }
        },
        SETCC => {
            CC = SetCC.getConstantOperandVal(0);
        },
        CMOV => {
            let mut FVal: *mut ConstantSDNode = dyn_cast(SetCC.getOperand(0));
            let mut TVal: *mut ConstantSDNode = dyn_cast(SetCC.getOperand(1));
            if !TVal {
                return SDValue {};
            }
            if !FVal {
                let mut Op: SDValue = SetCC.getOperand(0);
                if Op.getOpcode() == ZERO_EXTEND || Op.getOpcode() == TRUNCATE {
                    Op = Op.getOperand(0);
                }
                if (Op.getOpcode() != RDRAND && Op.getOpcode() != RDSEED) || Op.getResNo() != 0 {
                    return SDValue {};
                }
            }
            let mut FValIsFalse: bool = true;
            if FVal && FVal.getZExtValue() != 0 {
                if FVal.getZExtValue() != 1 {
                    return SDValue {};
                }
                needOppositeCond = !needOppositeCond;
                FValIsFalse = false;
            }
            if FValIsFalse && TVal.getZExtValue() != 1 {
                return SDValue {};
            }
            if !FValIsFalse && TVal.getZExtValue() != 0 {
                return SDValue {};
            }
            CC = SetCC.getConstantOperandVal(2);
            if needOppositeCond {
                CC = GetOppositeBranchCondition(CC);
            }
            return SetCC.getOperand(3);
        },
    }
    return SDValue {};
}

fn checkBoolTestAndOrSetCCCombine(Cond: SDValue, CC0: *mut CondCode, CC1: *mut CondCode, Flags: *mut SDValue, isAnd: *mut bool) -> bool {
    if operator(Cond).getOpcode() == CMP {
        if !isNullConstant(operator(Cond).getOperand(1)) {
            return false;
        }
        Cond = operator(Cond).getOperand(0);
    }
    isAnd = false;
    let mut SetCC0: SDValue = SDValue {};
    let mut SetCC1: SDValue = SDValue {};
    match operator(Cond).getOpcode() {
        _ => {
            return false;
        },
        AND => {
            AND;
        },
        OR => {
            OR;
        },
    }
    if SetCC0.getOpcode() != SETCC || SetCC1.getOpcode() != SETCC || operator(SetCC0).getOperand(1) != operator(SetCC1).getOperand(1) {
        return false;
    }
    CC0 = operator(SetCC0).getConstantOperandVal(0) as CondCode;
    CC1 = operator(SetCC1).getConstantOperandVal(0) as CondCode;
    Flags = operator(SetCC0).getOperand(1);
    return true;
}

fn combineCarryThroughADD(EFLAGS: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if EFLAGS.getOpcode() == ADD {
        if isAllOnesConstant(EFLAGS.getOperand(1)) {
            let mut FoundAndLSB: bool = false;
            let mut Carry: SDValue = EFLAGS.getOperand(0);
            while Carry.getOpcode() == TRUNCATE || Carry.getOpcode() == ZERO_EXTEND || (Carry.getOpcode() == AND && isOneConstant(Carry.getOperand(1))) {
                FoundAndLSB |= Carry.getOpcode() == AND;
                Carry = Carry.getOperand(0);
            }
            if Carry.getOpcode() == SETCC || Carry.getOpcode() == SETCC_CARRY {
                let mut CarryCC: u64 = Carry.getConstantOperandVal(0);
                let mut CarryOp1: SDValue = Carry.getOperand(1);
                if CarryCC == COND_B {
                    return CarryOp1;
                }
                if CarryCC == COND_A {
                    if CarryOp1.getOpcode() == SUB && CarryOp1.getNode().hasOneUse() && CarryOp1.getValueType().isInteger() && !isa(CarryOp1.getOperand(1)) {
                        let mut SubCommute: SDValue = DAG.getNode(SUB, CarryOp1, operator(CarryOp1).getVTList(), CarryOp1.getOperand(1), CarryOp1.getOperand(0));
                        return SDValue { Node: SubCommute.getNode(), ResNo: CarryOp1.getResNo() };
                    }
                }
                if CarryCC == COND_E && CarryOp1.getOpcode() == ADD && isOneConstant(CarryOp1.getOperand(1)) {
                    return CarryOp1;
                }
            } else if FoundAndLSB {
                let mut DL: SDLoc = Carry;
                let mut BitNo: SDValue = DAG.getConstant(0, DL, Carry.getValueType(), false, false);
                if Carry.getOpcode() == SRL {
                    BitNo = Carry.getOperand(1);
                    Carry = Carry.getOperand(0);
                }
                return getBT(Carry, BitNo, DL, DAG);
            }
        }
    }
    return SDValue {};
}

fn combinePTESTCC(EFLAGS: SDValue, CC: *mut CondCode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if EFLAGS.getOpcode() != PTEST && EFLAGS.getOpcode() != TESTP {
        return SDValue {};
    }
    let mut VT: MVT = EFLAGS.getSimpleValueType();
    let mut Op0: SDValue = EFLAGS.getOperand(0);
    let mut Op1: SDValue = EFLAGS.getOperand(1);
    let mut OpVT: MVT = Op0.getSimpleValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if IsNOT(Op0, DAG) {
        NotOp0;
    } else {
        let mut InvCC: CondCode = zeroed();
        match CC {
            COND_B => {
                InvCC = COND_E;
            },
            COND_AE => {
                InvCC = COND_NE;
            },
            COND_E => {
                InvCC = COND_B;
            },
            COND_NE => {
                InvCC = COND_AE;
            },
            COND_A => {
                COND_BE;
            },
            _ => {
                InvCC = COND_INVALID;
            },
        }
        if InvCC != COND_INVALID {
            CC = InvCC;
            return DAG.getNode(EFLAGS.getOpcode(), EFLAGS, VT, DAG.getBitcast(OpVT, NotOp0), Op1);
        }
    }
    if CC == COND_B || CC == COND_AE {
        if IsNOT(Op1, DAG) {
            NotOp1;
        } else {
            if peekThroughBitcasts(NotOp1) == peekThroughBitcasts(Op0) {
                let mut DL: SDLoc = EFLAGS;
                return DAG.getNode(EFLAGS.getOpcode(), DL, VT, DAG.getBitcast(OpVT, NotOp1), DAG.getBitcast(OpVT, DAG.getAllOnesConstant(DL, NotOp1.getValueType(), false, false)));
            }
        }
        if EFLAGS.getOpcode() == PTEST && isBuildVectorAllOnes(Op1.getNode()) {
            let mut BC0: SDValue = peekThroughBitcasts(Op0);
            if BC0.getOpcode() == PCMPEQ && isBuildVectorAllZeros(BC0.getOperand(1).getNode()) {
                CC = (if CC == COND_B { COND_E } else { COND_NE });
                let mut X: SDValue = DAG.getBitcast(OpVT, DAG.getFreeze(BC0.getOperand(0)));
                return DAG.getNode(EFLAGS.getOpcode(), EFLAGS, VT, X, X);
            }
        }
    }
    if CC == COND_E || CC == COND_NE {
        if Op0 != Op1 && DAG.isConstantIntBuildVectorOrConstantInt(Op0, true) && !DAG.isConstantIntBuildVectorOrConstantInt(Op1, true) {
            return DAG.getNode(EFLAGS.getOpcode(), EFLAGS, VT, Op1, Op0);
        }
        if IsNOT(Op1, DAG) {
            NotOp1;
        } else {
            CC = (if CC == COND_E { COND_B } else { COND_AE });
            return DAG.getNode(EFLAGS.getOpcode(), EFLAGS, VT, DAG.getBitcast(OpVT, NotOp1), Op0);
        }
        if Op0 == Op1 {
            let mut BC: SDValue = peekThroughBitcasts(Op0);
            let mut BCVT: EVT = BC.getValueType();
            if BC.getOpcode() == AND || BC.getOpcode() == FAND {
                return DAG.getNode(EFLAGS.getOpcode(), EFLAGS, VT, DAG.getBitcast(OpVT, BC.getOperand(0)), DAG.getBitcast(OpVT, BC.getOperand(1)));
            }
            if BC.getOpcode() == ANDNP || BC.getOpcode() == FANDN {
                CC = (if CC == COND_E { COND_B } else { COND_AE });
                return DAG.getNode(EFLAGS.getOpcode(), EFLAGS, VT, DAG.getBitcast(OpVT, BC.getOperand(0)), DAG.getBitcast(OpVT, BC.getOperand(1)));
            }
            if BCVT.isVector() && TLI.isTypeLegal(BCVT) {
                let mut EltBits: u32 = BCVT.getScalarSizeInBits();
                if DAG.ComputeNumSignBits(BC, 0) == EltBits {
                    assert!(VT == i32, "Expected i32 EFLAGS comparison result");
                    if (EltBits == 32 || EltBits == 64) && EFLAGS.getOpcode() != TESTP && Subtarget.hasAVX() {
                        let mut FloatSVT: MVT = getFloatingPointVT(EltBits);
                        let mut FloatVT: MVT = getVectorVT(FloatSVT, OpVT.getSizeInBits().operator unsigned long long() / EltBits);
                        BC = DAG.getBitcast(FloatVT, DAG.getFreeze(BC));
                        return DAG.getNode(TESTP, EFLAGS, VT, BC, BC);
                    }
                    let mut SignMask: APInt = getSignMask(EltBits);
                    if TLI.SimplifyMultipleUseDemandedBits(BC, SignMask, DAG, 0) {
                        Res;
                    } else {
                        let mut DL: SDLoc = EFLAGS;
                        if EltBits == 16 {
                            let mut MovmskVT: MVT = if BCVT.is128BitVector() { v16i8 } else { v32i8 };
                            Res = DAG.getBitcast(MovmskVT, Res);
                            Res = getMOVMSK(DL, Res, DAG, Subtarget);
                            Res = DAG.getNode(AND, DL, i32, Res, DAG.getConstant(2863311530, DL, i32, false, false));
                        } else {
                            Res = getMOVMSK(DL, Res, DAG, Subtarget);
                        }
                        return DAG.getNode(CMP, DL, i32, Res, DAG.getConstant(0, DL, i32, false, false));
                    }
                }
            }
        }
        if isBuildVectorAllOnes(Op1.getNode()) {
            Op0 = DAG.getFreeze(Op0);
            return DAG.getNode(EFLAGS.getOpcode(), EFLAGS, VT, Op0, Op0);
        }
        if EFLAGS.getOpcode() == PTEST && Subtarget.hasAVX() {
            let mut KnownOp1: KnownBits = DAG.computeKnownBits(Op1, 0);
            assert!(KnownOp1.getBitWidth() == 64, "Illegal PTEST vector element width");
            if KnownOp1.isConstant() {
                let mut Mask: *APInt = KnownOp1.getConstant();
                if Mask.isSignMask() {
                    let mut FpVT: MVT = getVectorVT(f64, OpVT.getSizeInBits().operator unsigned long long() / 64);
                    Op0 = DAG.getBitcast(FpVT, DAG.getFreeze(Op0));
                    return DAG.getNode(TESTP, EFLAGS, VT, Op0, Op0);
                }
                if Mask.isSplat(32) && Mask.trunc(32).isSignMask() {
                    let mut FpVT: MVT = getVectorVT(f32, OpVT.getSizeInBits().operator unsigned long long() / 32);
                    Op0 = DAG.getBitcast(FpVT, DAG.getFreeze(Op0));
                    return DAG.getNode(TESTP, EFLAGS, VT, Op0, Op0);
                }
            }
        }
        if CC == COND_E && OpVT.is128BitVector() && Subtarget.hasAVX() {
            let mut Src0: SDValue = peekThroughBitcasts(Op0);
            let mut Src1: SDValue = peekThroughBitcasts(Op1);
            if Src0.getOpcode() == OR && Src1.getOpcode() == OR {
                Src0 = getSplitVectorSrc(peekThroughBitcasts(Src0.getOperand(0)), peekThroughBitcasts(Src0.getOperand(1)), true);
                Src1 = getSplitVectorSrc(peekThroughBitcasts(Src1.getOperand(0)), peekThroughBitcasts(Src1.getOperand(1)), true);
                if Src0 && Src1 {
                    let mut OpVT2: MVT = OpVT.getDoubleNumVectorElementsVT();
                    return DAG.getNode(EFLAGS.getOpcode(), EFLAGS, VT, DAG.getBitcast(OpVT2, Src0), DAG.getBitcast(OpVT2, Src1));
                }
            }
        }
    }
    return SDValue {};
}

fn combineSetCCMOVMSK(EFLAGS: SDValue, CC: *mut CondCode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !(CC == COND_E || CC == COND_NE) {
        return SDValue {};
    }
    if EFLAGS.getValueType() != i32 {
        return SDValue {};
    }
    let mut CmpOpcode: u32 = EFLAGS.getOpcode();
    if CmpOpcode != CMP && CmpOpcode != SUB {
        return SDValue {};
    }
    let mut CmpConstant: *mut ConstantSDNode = dyn_cast(EFLAGS.getOperand(1));
    if !CmpConstant {
        return SDValue {};
    }
    let mut CmpVal: *APInt = CmpConstant.getAPIntValue();
    let mut CmpOp: SDValue = EFLAGS.getOperand(0);
    let mut CmpBits: u32 = CmpOp.getValueSizeInBits().operator unsigned long long();
    assert!(CmpBits == CmpVal.getBitWidth(), "Value size mismatch");
    if CmpOp.getOpcode() == TRUNCATE {
        CmpOp = CmpOp.getOperand(0);
    }
    if CmpOp.getOpcode() != MOVMSK {
        return SDValue {};
    }
    let mut Vec: SDValue = CmpOp.getOperand(0);
    let mut VecVT: MVT = Vec.getSimpleValueType();
    assert!((VecVT.is128BitVector() || VecVT.is256BitVector()), "Unexpected MOVMSK operand");
    let mut NumElts: u32 = VecVT.getVectorNumElements();
    let mut NumEltBits: u32 = VecVT.getScalarSizeInBits();
    let mut IsAnyOf: bool = CmpOpcode == CMP && CmpVal.isZero();
    let mut IsAllOf: bool = (CmpOpcode == SUB || CmpOpcode == CMP) && NumElts <= CmpBits && CmpVal.isMask(NumElts);
    if !IsAnyOf && !IsAllOf {
        return SDValue {};
    }
    let mut IsOneUse: bool = CmpOp.getNode().hasOneUse();
    if Vec.getOpcode() == BITCAST && NumElts <= CmpBits {
        let mut BC: SDValue = peekThroughBitcasts(Vec);
        let mut BCVT: MVT = BC.getSimpleValueType();
        let mut BCNumElts: u32 = BCVT.getVectorNumElements();
        let mut BCNumEltBits: u32 = BCVT.getScalarSizeInBits();
        if (BCNumEltBits == 32 || BCNumEltBits == 64) && BCNumEltBits > NumEltBits && DAG.ComputeNumSignBits(BC, 0) > (BCNumEltBits - NumEltBits) {
            let mut DL: SDLoc = EFLAGS;
            let mut CmpMask: APInt = getLowBitsSet(32, if IsAnyOf { 0 } else { BCNumElts });
            return DAG.getNode(CMP, DL, i32, DAG.getNode(MOVMSK, DL, i32, BC), DAG.getConstant(CmpMask, DL, i32, false, false));
        }
    }
    if VecVT.is256BitVector() && NumElts <= CmpBits && IsOneUse {
        let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> {};
        if collectConcatOps(peekThroughBitcasts(Vec).getNode(), Ops, DAG) && Ops.len == 2 {
            let mut DL: SDLoc = EFLAGS;
            let mut SubVT: EVT = Ops[0].getValueType().changeTypeToInteger();
            let mut CmpMask: APInt = getLowBitsSet(32, if IsAnyOf { 0 } else { NumElts / 2 });
            let mut V: SDValue = DAG.getNode(if IsAnyOf { OR } else { AND }, DL, SubVT, DAG.getBitcast(SubVT, Ops[0]), DAG.getBitcast(SubVT, Ops[1]));
            V = DAG.getBitcast(VecVT.getHalfNumVectorElementsVT(), V);
            return DAG.getNode(CMP, DL, i32, DAG.getNode(MOVMSK, DL, i32, V), DAG.getConstant(CmpMask, DL, i32, false, false));
        }
    }
    if IsAllOf && Subtarget.hasSSE41() && IsOneUse {
        let mut TestVT: MVT = if VecVT.is128BitVector() { v2i64 } else { v4i64 };
        let mut BC: SDValue = peekThroughBitcasts(Vec);
        if BC.getValueType().getVectorNumElements() <= NumElts {
            if BC.getOpcode() == PCMPEQ {
                let mut V: SDValue = DAG.getNode(XOR, BC, BC.getValueType(), BC.getOperand(0), BC.getOperand(1));
                V = DAG.getBitcast(TestVT, V);
                return DAG.getNode(PTEST, EFLAGS, i32, V, V);
            }
            if BC.getOpcode() == AND && BC.getOperand(0).getOpcode() == PCMPEQ && BC.getOperand(1).getOpcode() == PCMPEQ {
                let mut LHS: SDValue = BC.getOperand(0);
                let mut RHS: SDValue = BC.getOperand(1);
                LHS = DAG.getNode(XOR, LHS, LHS.getValueType(), LHS.getOperand(0), LHS.getOperand(1));
                RHS = DAG.getNode(XOR, RHS, RHS.getValueType(), RHS.getOperand(0), RHS.getOperand(1));
                LHS = DAG.getBitcast(TestVT, LHS);
                RHS = DAG.getBitcast(TestVT, RHS);
                let mut V: SDValue = DAG.getNode(OR, EFLAGS, TestVT, LHS, RHS);
                return DAG.getNode(PTEST, EFLAGS, i32, V, V);
            }
        }
    }
    if Vec.getOpcode() == PACKSS && VecVT == v16i8 {
        let mut VecOp0: SDValue = Vec.getOperand(0);
        let mut VecOp1: SDValue = Vec.getOperand(1);
        let mut SignExt0: bool = DAG.ComputeNumSignBits(VecOp0, 0) > 8;
        let mut SignExt1: bool = DAG.ComputeNumSignBits(VecOp1, 0) > 8;
        if IsAnyOf && CmpBits == 8 && VecOp1.isUndef() {
            let mut DL: SDLoc = EFLAGS;
            let mut Result: SDValue = DAG.getBitcast(v16i8, VecOp0);
            Result = DAG.getNode(MOVMSK, DL, i32, Result);
            Result = DAG.getZExtOrTrunc(Result, DL, i16);
            if !SignExt0 {
                Result = DAG.getNode(AND, DL, i16, Result, DAG.getConstant(43690, DL, i16, false, false));
            }
            return DAG.getNode(CMP, DL, i32, Result, DAG.getConstant(0, DL, i16, false, false));
        }
        if CmpBits >= 16 && Subtarget.hasInt256() && (IsAnyOf || (SignExt0 && SignExt1)) {
            if getSplitVectorSrc(VecOp0, VecOp1, true) {
                Src;
            } else {
                let mut DL: SDLoc = EFLAGS;
                let mut Result: SDValue = peekThroughBitcasts(Src);
                if IsAllOf && Result.getOpcode() == PCMPEQ && Result.getValueType().getVectorNumElements() <= NumElts {
                    let mut V: SDValue = DAG.getNode(XOR, DL, Result.getValueType(), Result.getOperand(0), Result.getOperand(1));
                    V = DAG.getBitcast(v4i64, V);
                    return DAG.getNode(PTEST, EFLAGS, i32, V, V);
                }
                Result = DAG.getBitcast(v32i8, Result);
                Result = DAG.getNode(MOVMSK, DL, i32, Result);
                let mut CmpMask: u32 = if IsAnyOf { 0 } else { 4294967295 };
                if !SignExt0 || !SignExt1 {
                    assert!(IsAnyOf, "Only perform v16i16 signmasks for any_of patterns");
                    Result = DAG.getNode(AND, DL, i32, Result, DAG.getConstant(2863311530, DL, i32, false, false));
                }
                return DAG.getNode(CMP, DL, i32, Result, DAG.getConstant(CmpMask, DL, i32, false, false));
            }
        }
    }
    let mut ShuffleMask: SmallVector<int, 32> = SmallVector<int, 32> {};
    let mut ShuffleInputs: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    if NumElts <= CmpBits && getTargetShuffleInputs(peekThroughBitcasts(Vec), ShuffleInputs, ShuffleMask, DAG, 0, true) && ShuffleInputs.len == 1 && isCompletePermute(ShuffleMask) && ShuffleInputs[0].getValueSizeInBits() == VecVT.getSizeInBits() && canScaleShuffleElements(ShuffleMask, NumElts) {
        let mut DL: SDLoc = EFLAGS;
        let mut Result: SDValue = DAG.getBitcast(VecVT, ShuffleInputs[0]);
        Result = DAG.getNode(MOVMSK, DL, i32, Result);
        Result = DAG.getZExtOrTrunc(Result, DL, EFLAGS.getOperand(0).getValueType());
        return DAG.getNode(CMP, DL, i32, Result, EFLAGS.getOperand(1));
    }
    if NumElts <= CmpBits && Subtarget.hasAVX() && !Subtarget.preferMovmskOverVTest() && IsOneUse && (NumEltBits == 32 || NumEltBits == 64) {
        let mut DL: SDLoc = EFLAGS;
        let mut FloatSVT: MVT = getFloatingPointVT(NumEltBits);
        let mut FloatVT: MVT = getVectorVT(FloatSVT, NumElts);
        let mut IntVT: MVT = FloatVT.changeVectorElementTypeToInteger();
        let mut LHS: SDValue = Vec;
        let mut RHS: SDValue = if IsAnyOf { Vec } else { DAG.getAllOnesConstant(DL, IntVT, false, false) };
        CC = if IsAnyOf { CC } else { (if CC == COND_E { COND_B } else { COND_AE }) };
        return DAG.getNode(TESTP, DL, i32, DAG.getBitcast(FloatVT, LHS), DAG.getBitcast(FloatVT, RHS));
    }
    return SDValue {};
}

fn combineSetCCEFLAGS(EFLAGS: SDValue, CC: *mut CondCode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if CC == COND_B {
        if combineCarryThroughADD(EFLAGS, DAG) {
            Flags;
        } else {
            return Flags;
        }
    }
    if checkSignTestSetCCCombine(EFLAGS, CC, DAG) {
        R;
    } else {
        return R;
    }
    if checkBoolTestSetCCCombine(EFLAGS, CC) {
        R;
    } else {
        return R;
    }
    if combinePTESTCC(EFLAGS, CC, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    if combineSetCCMOVMSK(EFLAGS, CC, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    return combineSetCCAtomicArith(EFLAGS, CC, DAG, Subtarget);
}

fn combineCMov(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut FalseOp: SDValue = N.getOperand(0);
    let mut TrueOp: SDValue = N.getOperand(1);
    let mut CC: CondCode = N.getConstantOperandVal(2) as CondCode;
    let mut Cond: SDValue = N.getOperand(3);
    if TrueOp == FalseOp {
        return TrueOp;
    }
    if combineSetCCEFLAGS(Cond, CC, DAG, Subtarget) {
        Flags;
    } else {
        if !(FalseOp.getValueType() == f80 || (FalseOp.getValueType() == f64 && !Subtarget.hasSSE2()) || (FalseOp.getValueType() == f32 && !Subtarget.hasSSE1())) || !Subtarget.canUseCMOV() || hasFPCMov(CC) {
            let mut Ops: [4]SDValue = [FalseOp, TrueOp, DAG.getTargetConstant(CC, DL, i8, false), Flags];
            return DAG.getNode(CMOV, DL, VT, Ops, N.getFlags());
        }
    }
    if dyn_cast(TrueOp) {
        TrueC;
    } else {
        if dyn_cast(FalseOp) {
            FalseC;
        } else {
            if TrueC.getAPIntValue().ult(FalseC.getAPIntValue()) {
                CC = GetOppositeBranchCondition(CC);
                swap(TrueC, FalseC);
                swap(TrueOp, FalseOp);
            }
            if FalseC.getAPIntValue() == 0 && TrueC.getAPIntValue().isPowerOf2() {
                Cond = getSETCC(CC, Cond, DL, DAG);
                Cond = DAG.getNode(ZERO_EXTEND, DL, TrueC.getValueType(0), Cond);
                let mut ShAmt: u32 = TrueC.getAPIntValue().logBase2();
                Cond = DAG.getNode(SHL, DL, Cond.getValueType(), Cond, DAG.getConstant(ShAmt, DL, i8, false, false));
                return Cond;
            }
            if FalseC.getAPIntValue() + 1 == TrueC.getAPIntValue() {
                Cond = getSETCC(CC, Cond, DL, DAG);
                Cond = DAG.getNode(ZERO_EXTEND, DL, FalseC.getValueType(0), Cond);
                Cond = DAG.getNode(ADD, DL, Cond.getValueType(), Cond, SDValue { Node: FalseC, ResNo: 0 });
                return Cond;
            }
            if VT == i32 || VT == i64 {
                let mut Diff: APInt = TrueC.getAPIntValue() - FalseC.getAPIntValue();
                assert!(Diff.getBitWidth() == VT.getSizeInBits().operator unsigned long long(), "Implicit constant truncation");
                let mut isFastMultiplier: bool = false;
                if Diff.ult(10) {
                    match Diff.getZExtValue() {
                        _ => {
                            break;
                        },
                        1 => {
                            2;
                        },
                    }
                }
                if isFastMultiplier {
                    Cond = getSETCC(CC, Cond, DL, DAG);
                    Cond = DAG.getNode(ZERO_EXTEND, DL, FalseC.getValueType(0), Cond);
                    if Diff != 1 {
                        Cond = DAG.getNode(MUL, DL, Cond.getValueType(), Cond, DAG.getConstant(Diff, DL, Cond.getValueType(), false, false));
                    }
                    if FalseC.getAPIntValue() != 0 {
                        Cond = DAG.getNode(ADD, DL, Cond.getValueType(), Cond, SDValue { Node: FalseC, ResNo: 0 });
                    }
                    return Cond;
                }
            }
        }
    }
    if !DCI.isBeforeLegalize() && !DCI.isBeforeLegalizeOps() {
        let mut CmpAgainst: *mut ConstantSDNode = null;
        if (Cond.getOpcode() == CMP || Cond.getOpcode() == SUB) && (CmpAgainst = dyn_cast(Cond.getOperand(1))) && !isa(Cond.getOperand(0)) {
            if CC == COND_NE && CmpAgainst == dyn_cast(FalseOp) {
                CC = GetOppositeBranchCondition(CC);
                swap(TrueOp, FalseOp);
            }
            if CC == COND_E && CmpAgainst == dyn_cast(TrueOp) {
                let mut Ops: [4]SDValue = [FalseOp, Cond.getOperand(0), DAG.getTargetConstant(CC, DL, i8, false), Cond];
                return DAG.getNode(CMOV, DL, VT, Ops, N.getFlags());
            }
        }
    }
    if CC == COND_AE && isOneConstant(FalseOp) && Cond.getOpcode() == SUB && operator(Cond).hasOneUse() {
        let mut Cond0: SDValue = Cond.getOperand(0);
        if Cond0.getOpcode() == TRUNCATE {
            Cond0 = Cond0.getOperand(0);
        }
        let mut Sub1C: *mut ConstantSDNode = dyn_cast(Cond.getOperand(1));
        if Cond0 == TrueOp && Sub1C && Sub1C.getZExtValue() == 2 {
            let mut CondVT: EVT = operator(Cond).getValueType(0);
            let mut NewSub: SDValue = DAG.getNode(SUB, DL, operator(Cond).getVTList(), Cond.getOperand(0), DAG.getConstant(1, DL, CondVT, false, false));
            let mut EFLAGS: SDValue = SDValue { Node: NewSub.getNode(), ResNo: 1 };
            return DAG.getNode(ADC, DL, DAG.getVTList(VT, i32), TrueOp, DAG.getConstant(0, DL, VT, false, false), EFLAGS);
        }
    }
    if CC == COND_NE {
        let mut Flags: SDValue = SDValue {};
        let mut CC0: CondCode = zeroed();
        let mut CC1: CondCode = zeroed();
        let mut isAndSetCC: bool = false;
        if checkBoolTestAndOrSetCCCombine(Cond, CC0, CC1, Flags, isAndSetCC) {
            if isAndSetCC {
                swap(FalseOp, TrueOp);
                CC0 = GetOppositeBranchCondition(CC0);
                CC1 = GetOppositeBranchCondition(CC1);
            }
            let mut LOps: [4]SDValue = [FalseOp, TrueOp, DAG.getTargetConstant(CC0, DL, i8, false), Flags];
            let mut LCMOV: SDValue = DAG.getNode(CMOV, DL, VT, LOps, N.getFlags());
            let mut Ops: [4]SDValue = [LCMOV, TrueOp, DAG.getTargetConstant(CC1, DL, i8, false), Flags];
            let mut CMOV: SDValue = DAG.getNode(CMOV, DL, VT, Ops, N.getFlags());
            return CMOV;
        }
    }
    if (CC == COND_NE || CC == COND_E) && Cond.getOpcode() == CMP && isNullConstant(Cond.getOperand(1)) {
        let mut Add: SDValue = TrueOp;
        let mut Const: SDValue = FalseOp;
        if CC == COND_E {
            swap(Add, Const);
        }
        if Subtarget.hasBitScanPassThrough() && Add.getOpcode() == BSR && Add.getResNo() == 0 && Add.hasOneUse() && Add.getOperand(1) == Cond.getOperand(0) {
            return DAG.getNode(Add.getOpcode(), DL, operator(Add).getVTList(), Const, Add.getOperand(1));
        }
        if Const == Cond.getOperand(0) {
            Const = Cond.getOperand(1);
        }
        if isa(Const) && Add.getOpcode() == ADD && Add.hasOneUse() && isa(Add.getOperand(1)) && (Add.getOperand(0).getOpcode() == CTTZ_ZERO_POISON || Add.getOperand(0).getOpcode() == CTTZ) && Add.getOperand(0).getOperand(0) == Cond.getOperand(0) {
            let mut Diff: SDValue = DAG.getNode(SUB, DL, VT, Const, Add.getOperand(1));
            let mut CMov: SDValue = DAG.getNode(CMOV, DL, VT, [Diff, Add.getOperand(0), DAG.getTargetConstant(COND_NE, DL, i8, false), Cond], N.getFlags());
            return DAG.getNode(ADD, DL, VT, CMov, Add.getOperand(1));
        }
    }
    return SDValue {};
}

enum ShrinkMode {
    MULS8 = 0,
    MULU8 = 1,
    MULS16 = 2,
    MULU16 = 3,
}

fn canReduceVMulWidth(N: *mut SDNode, DAG: *mut SelectionDAG, Mode: *mut ShrinkMode) -> bool {
    let mut VT: EVT = N.getOperand(0).getValueType();
    if VT.getScalarSizeInBits() != 32 {
        return false;
    }
    assert!(N.getNumOperands() == 2, "NumOperands of Mul are 2");
    let mut SignBits: [2]u32 = [1, 1];
    let mut IsPositive: [2]bool = [false, false];
    for let mut i: u32 = 0; i < 2; i += 1 {
        let mut Opd: SDValue = N.getOperand(i);
        SignBits[i] = DAG.ComputeNumSignBits(Opd, 0);
        IsPositive[i] = DAG.SignBitIsZero(Opd, 0);
    }
    let mut AllPositive: bool = IsPositive[0] && IsPositive[1];
    let mut MinSignBits: u32 = if SignBits[0] < SignBits[1] { SignBits[0] } else { SignBits[1] };
    if MinSignBits >= 25 {
        Mode = MULS8;
    } else if AllPositive && MinSignBits >= 24 {
        Mode = MULU8;
    } else if MinSignBits >= 17 {
        Mode = MULS16;
    } else if AllPositive && MinSignBits >= 16 {
        Mode = MULU16;
    } else {
        return false;
    }
    return true;
}

fn reduceVMULWidth(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut OptForMinSize: bool = DAG.getMachineFunction().getFunction().hasMinSize();
    if Subtarget.hasSSE41() && (OptForMinSize || !Subtarget.isPMULLDSlow()) {
        return SDValue {};
    }
    let mut Mode: ShrinkMode = zeroed();
    if !canReduceVMulWidth(N, DAG, Mode) {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getOperand(0).getValueType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    if (NumElts % 2) != 0 {
        return SDValue {};
    }
    let mut ReducedVT: EVT = getVectorVT(*DAG.getContext(), i16, NumElts, false);
    let mut NewN0: SDValue = DAG.getNode(TRUNCATE, DL, ReducedVT, N0);
    let mut NewN1: SDValue = DAG.getNode(TRUNCATE, DL, ReducedVT, N1);
    let mut MulLo: SDValue = DAG.getNode(MUL, DL, ReducedVT, NewN0, NewN1);
    if Mode == MULU8 || Mode == MULS8 {
        return DAG.getNode(if (Mode == MULU8) { ZERO_EXTEND } else { SIGN_EXTEND }, DL, VT, MulLo);
    }
    let mut ResVT: EVT = getVectorVT(*DAG.getContext(), i32, NumElts / 2, false);
    let mut MulHi: SDValue = DAG.getNode(if Mode == MULS16 { MULHS } else { MULHU }, DL, ReducedVT, NewN0, NewN1);
    let mut ShuffleMask: SmallVector<int, 16> = NumElts;
    for let mut i: u32 = 0;
let mut e: u32 = NumElts / 2; i < e; i += 1 {
        ShuffleMask[2 * i] = i;
        ShuffleMask[2 * i + 1] = i + NumElts;
    }
    let mut ResLo: SDValue = DAG.getVectorShuffle(ReducedVT, DL, MulLo, MulHi, ShuffleMask);
    ResLo = DAG.getBitcast(ResVT, ResLo);
    for let mut i: u32 = 0;
let mut e: u32 = NumElts / 2; i < e; i += 1 {
        ShuffleMask[2 * i] = i + NumElts / 2;
        ShuffleMask[2 * i + 1] = i + NumElts * 3 / 2;
    }
    let mut ResHi: SDValue = DAG.getVectorShuffle(ReducedVT, DL, MulLo, MulHi, ShuffleMask);
    ResHi = DAG.getBitcast(ResVT, ResHi);
    return DAG.getNode(CONCAT_VECTORS, DL, VT, ResLo, ResHi);
}

fn combineMulSpecial(MulAmt: u64, N: *mut SDNode, DAG: *mut SelectionDAG, VT: EVT, DL: *SDLoc) -> SDValue {
    let mut combineMulShlAddOrSub: Closure_184 = Closure_184 { DAG: &mut DAG, DL: &mut DL, VT: &mut VT, N: &mut N };
    let mut combineMulMulAddOrSub: Closure_185 = Closure_185 { DAG: &mut DAG, DL: &mut DL, VT: &mut VT, N: &mut N };
    match MulAmt {
        _ => {
            break;
        },
        11 => {
            return combineMulShlAddOrSub.call(5, 1, true);
        },
        21 => {
            return combineMulShlAddOrSub.call(5, 2, true);
        },
        41 => {
            return combineMulShlAddOrSub.call(5, 3, true);
        },
        22 => {
            return DAG.getNode(ADD, DL, VT, N.getOperand(0), combineMulShlAddOrSub.call(5, 2, true));
        },
        19 => {
            return combineMulShlAddOrSub.call(9, 1, true);
        },
        37 => {
            return combineMulShlAddOrSub.call(9, 2, true);
        },
        73 => {
            return combineMulShlAddOrSub.call(9, 3, true);
        },
        13 => {
            return combineMulShlAddOrSub.call(3, 2, true);
        },
        23 => {
            return combineMulShlAddOrSub.call(3, 3, false);
        },
        26 => {
            return combineMulMulAddOrSub.call(5, 5, true);
        },
        28 => {
            return combineMulMulAddOrSub.call(9, 3, true);
        },
        29 => {
            return DAG.getNode(ADD, DL, VT, N.getOperand(0), combineMulMulAddOrSub.call(9, 3, true));
        },
    }
    if isPowerOf2_64(MulAmt & (MulAmt - 1)) {
        let mut ScaleShift: u32 = countr_zero(MulAmt);
        if ScaleShift >= 1 && ScaleShift < 4 {
            let mut ShiftAmt: u32 = Log2_64((MulAmt & (MulAmt - 1)));
            let mut Shift1: SDValue = DAG.getNode(SHL, DL, VT, N.getOperand(0), DAG.getConstant(ShiftAmt, DL, i8, false, false));
            let mut Shift2: SDValue = DAG.getNode(SHL, DL, VT, N.getOperand(0), DAG.getConstant(ScaleShift, DL, i8, false, false));
            return DAG.getNode(ADD, DL, VT, Shift1, Shift2);
        }
    }
    return SDValue {};
}

fn combineMulToPMADDWD(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    if Subtarget.isPMADDWDSlow() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !VT.isVectorOf(i32) {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    if NumElts == 1 || !isPowerOf2_32(NumElts) {
        return SDValue {};
    }
    if 32 <= (2 * NumElts) && Subtarget.hasAVX512() && !Subtarget.hasBWI() {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if !Subtarget.hasSSE41() && (((N0.getOpcode() == ZERO_EXTEND && N0.getOperand(0).getScalarValueSizeInBits() <= 8) && (N1.getOpcode() == ZERO_EXTEND && N1.getOperand(0).getScalarValueSizeInBits() <= 8)) || ((N0.getOpcode() == SIGN_EXTEND && N0.getOperand(0).getScalarValueSizeInBits() <= 8) && (N1.getOpcode() == SIGN_EXTEND && N1.getOperand(0).getScalarValueSizeInBits() <= 8))) {
        return SDValue {};
    }
    if !Subtarget.hasSSE41() && (N0.getOpcode() == SIGN_EXTEND && N0.getOperand(0).getValueSizeInBits().operator unsigned long long() > 128) && (N1.getOpcode() == SIGN_EXTEND && N1.getOperand(0).getValueSizeInBits().operator unsigned long long() > 128) {
        return SDValue {};
    }
    if DAG.ComputeMaxSignificantBits(N1, 0) > 16 || DAG.ComputeMaxSignificantBits(N0, 0) > 16 {
        return SDValue {};
    }
    let mut GetZeroableOp: Closure_186 = Closure_186 { DAG: &mut DAG, DL: &mut DL, VT: &mut VT, N: &mut N, Subtarget: &mut Subtarget };
    let mut ZeroN0: SDValue = GetZeroableOp.call(N0);
    let mut ZeroN1: SDValue = GetZeroableOp.call(N1);
    if !ZeroN0 && !ZeroN1 {
        return SDValue {};
    }
    N0 = if ZeroN0 { ZeroN0 } else { N0 };
    N1 = if ZeroN1 { ZeroN1 } else { N1 };
    let mut PMADDWDBuilder: Closure_187 = Closure_187 {};
    return SplitOpsAndApply(DAG, Subtarget, DL, VT, [N0, N1], PMADDWDBuilder, true, true);
}

fn combineMulToPMULDQ(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !VT.isVectorOf(i64) || VT.getVectorNumElements() < 2 || !isPowerOf2_32(VT.getVectorNumElements()) {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if Subtarget.hasSSE41() && DAG.ComputeNumSignBits(N0, 0) > 32 && DAG.ComputeNumSignBits(N1, 0) > 32 {
        let mut PMULDQBuilder: Closure_188 = Closure_188 {};
        return SplitOpsAndApply(DAG, Subtarget, DL, VT, [N0, N1], PMULDQBuilder, false, true);
    }
    let mut Mask: APInt = getHighBitsSet(64, 32);
    if DAG.MaskedValueIsZero(N0, Mask, 0) && DAG.MaskedValueIsZero(N1, Mask, 0) {
        let mut PMULUDQBuilder: Closure_189 = Closure_189 {};
        return SplitOpsAndApply(DAG, Subtarget, DL, VT, [N0, N1], PMULUDQBuilder, false, true);
    }
    return SDValue {};
}

fn combineMulToPMADD52(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if VT.getScalarType() != i64 || !Subtarget.isPMULLQSlow() {
        return SDValue {};
    }
    let mut Supported512: bool = (VT == v8i64) && Subtarget.hasIFMA();
    let mut SupportedSmall: bool = (VT == v2i64 || VT == v4i64) && (Subtarget.hasIFMA() || Subtarget.hasAVXIFMA());
    if !Supported512 && !SupportedSmall {
        return SDValue {};
    }
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut Known0: KnownBits = DAG.computeKnownBits(Op0, 0);
    let mut Known1: KnownBits = DAG.computeKnownBits(Op1, 0);
    let mut KnownMul: KnownBits = mul(Known0, Known1, Op0 == Op1);
    if Known0.countMaxActiveBits() <= 52 && Known1.countMaxActiveBits() <= 52 && KnownMul.countMaxActiveBits() <= 52 {
        let mut Zero: SDValue = getZeroVector(VT.getSimpleVT(), Subtarget, DAG, DL);
        return DAG.getNode(VPMADD52L, DL, VT, Op0, Op1, Zero);
    }
    return SDValue {};
}

fn combineIntDivRemViaExactFPDiv(N: *mut SDNode, FPSclVT: MVT, IsSigned: bool, IsRem: bool, IsStrict: bool, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Dividend: SDValue = N.getOperand(0);
    let mut Divisor: SDValue = N.getOperand(1);
    let mut FPVT: EVT = VT.changeVectorElementType(*DAG.getContext(), FPSclVT);
    if !IsStrict && !IsSigned && VT.getScalarSizeInBits() == 32 && !Subtarget.hasAVX2() {
        return SDValue {};
    }
    let mut FPVTUsable: bool = if IsStrict { FPVT.getSizeInBits().operator unsigned long long() <= 512 } else { DCI.isBeforeLegalize() || DAG.getTargetLoweringInfo().isTypeLegal(FPVT) };
    if !FPVTUsable {
        if VT.is256BitVector() || VT.is512BitVector() {
            let mut HalfVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
            if DAG.getTargetLoweringInfo().isTypeLegal(HalfVT) {
                return splitVectorIntBinary(SDValue { Node: N, ResNo: 0 }, DAG, DL);
            }
        }
        return SDValue {};
    }
    let mut ToFP: u32 = if IsSigned { SINT_TO_FP } else { UINT_TO_FP };
    let mut X: SDValue = DAG.getNode(ToFP, DL, FPVT, Dividend);
    let mut Y: SDValue = DAG.getNode(ToFP, DL, FPVT, Divisor);
    let mut Q: SDValue = SDValue {};
    if IsStrict {
        let mut WideElts: u32 = 512 / FPSclVT.getSizeInBits().operator unsigned long long();
        let mut WideFP: MVT = getVectorVT(FPSclVT, WideElts);
        let mut WideIScl: MVT = i32;
        if VT.getScalarSizeInBits() == 64 && FPSclVT == f64 {
            WideIScl = i64;
        }
        let mut WideI: MVT = getVectorVT(WideIScl, WideElts);
        let mut RN: SDValue = DAG.getTargetConstant(TO_NEAREST_INT, DL, i32, false);
        let mut Quot: SDValue = DAG.getNode(FDIV_RND, DL, WideFP, widenSubVector(X, false, Subtarget, DAG, DL, 512), widenSubVector(Y, false, Subtarget, DAG, DL, 512), RN);
        let mut FromFP: u32 = if IsSigned { CVTTP2SI_SAE } else { CVTTP2UI_SAE };
        Q = DAG.getNode(FromFP, DL, WideI, Quot);
        let mut NarrowI: MVT = getVectorVT(WideIScl, VT.getVectorNumElements());
        Q = extractSubVector(Q, 0, DAG, DL, NarrowI.getSizeInBits().operator unsigned long long());
        Q = if IsSigned { DAG.getSExtOrTrunc(Q, DL, VT) } else { DAG.getZExtOrTrunc(Q, DL, VT) };
    } else {
        let mut FromFP: u32 = if IsSigned { FP_TO_SINT } else { FP_TO_UINT };
        Q = DAG.getNode(FromFP, DL, VT, DAG.getNode(FDIV, DL, FPVT, X, Y));
    }
    if !IsRem {
        return Q;
    }
    return DAG.getNode(SUB, DL, VT, Dividend, DAG.getNode(MUL, DL, VT, Q, Divisor));
}

fn combineInt64DivRemViaFPReciprocal(N: *mut SDNode, IsSigned: bool, IsRem: bool, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Dividend: SDValue = N.getOperand(0);
    let mut Divisor: SDValue = N.getOperand(1);
    if VT.getSizeInBits().operator unsigned long long() > 512 || VT.getVectorNumElements() < 2 {
        return SDValue {};
    }
    let mut Widen: bool = VT != v8i64;
    if VT == v2i64 && Subtarget.isPMULLQSlow() {
        return SDValue {};
    }
    let mut FPVT: MVT = v8f64;
    let mut RD: SDValue = DAG.getTargetConstant(TO_NEG_INF, DL, i32, false);
    let mut RU: SDValue = DAG.getTargetConstant(TO_POS_INF, DL, i32, false);
    let mut UToF: Closure_190 = Closure_190 { Widen: &mut Widen, Subtarget: &mut Subtarget, DAG: &mut DAG, DL: &mut DL, FPVT: &mut FPVT };
    let mut FToU: Closure_191 = Closure_191 { DAG: &mut DAG, DL: &mut DL, RD: &mut RD, Widen: &mut Widen, VT: &mut VT };
    let mut FMul: Closure_192 = Closure_192 { DAG: &mut DAG, DL: &mut DL, FPVT: &mut FPVT, RD: &mut RD };
    let mut A: SDValue = if IsSigned { DAG.getNode(ABS, DL, VT, Dividend) } else { Dividend };
    let mut B: SDValue = if IsSigned { DAG.getNode(ABS, DL, VT, Divisor) } else { Divisor };
    let mut Recip: SDValue = DAG.getNode(FDIV_RND, DL, FPVT, DAG.getConstantFP(1.0, DL, FPVT, false), UToF.call(B, RU), RD);
    let mut First: SDValue = FToU.call(FMul.call(UToF.call(A, RD), Recip));
    let mut Rem: SDValue = DAG.getNode(SUB, DL, VT, A, DAG.getNode(MUL, DL, VT, First, B));
    let mut Second: SDValue = FToU.call(FMul.call(UToF.call(Rem, RD), Recip));
    let mut Quot: SDValue = DAG.getNode(ADD, DL, VT, First, Second);
    Rem = DAG.getNode(SUB, DL, VT, Rem, DAG.getNode(MUL, DL, VT, Second, B));
    let mut CCVT: EVT = DAG.getTargetLoweringInfo().getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut Ge: SDValue = DAG.getSetCC(DL, CCVT, Rem, B, SETUGE, SDValue {}, false, None);
    let mut Mag: SDValue = SDValue {};
    if IsRem {
        Mag = DAG.getSelect(DL, VT, Ge, DAG.getNode(SUB, DL, VT, Rem, B), Rem, SDNodeFlags { Flags: None });
    } else {
        Mag = DAG.getNode(SUB, DL, VT, Quot, DAG.getSExtOrTrunc(Ge, DL, VT));
    }
    if !IsSigned {
        return Mag;
    }
    let mut SignSrc: SDValue = if IsRem { Dividend } else { DAG.getNode(XOR, DL, VT, Dividend, Divisor) };
    let mut Zero: SDValue = DAG.getConstant(0, DL, VT, false, false);
    let mut IsNeg: SDValue = DAG.getSetCC(DL, CCVT, SignSrc, Zero, SETLT, SDValue {}, false, None);
    return DAG.getSelect(DL, VT, IsNeg, DAG.getNode(SUB, DL, VT, Zero, Mag), Mag, SDNodeFlags { Flags: None });
}

fn combineIntDivRem(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    if !VT.isVector() || !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut Dividend: SDValue = N.getOperand(0);
    let mut Divisor: SDValue = N.getOperand(1);
    let mut Opc: u32 = N.getOpcode();
    if Opc == MASKED_UDIV || Opc == MASKED_SDIV || Opc == MASKED_UREM || Opc == MASKED_SREM {
        Opc = getUnmaskedBinOpOpcode(Opc);
    }
    let mut IsRem: bool = Opc == UREM || Opc == SREM;
    let mut IsSigned: bool = Opc == SDIV || Opc == SREM;
    let mut ExtractedElts: APInt = getZero(VT.getVectorNumElements());
    let mut OnlyExtracts: bool = true;
    for U in N.users() {
        if U.getOpcode() != EXTRACT_VECTOR_ELT {
            OnlyExtracts = false;
            break;
        }
        let mut Idx: *mut ConstantSDNode = dyn_cast(U.getOperand(1));
        if !Idx {
            continue;
        }
        let mut IdxVal: *APInt = Idx.getAPIntValue();
        if IdxVal.uge(VT.getVectorNumElements()) {
            continue;
        }
        ExtractedElts.setBit(IdxVal.getZExtValue());
    }
    if OnlyExtracts && !ExtractedElts.isAllOnes() {
        return SDValue {};
    }
    if DAG.isConstantIntBuildVectorOrConstantInt(Divisor, true) {
        return SDValue {};
    }
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    let mut FitsFP: Closure_193 = Closure_193 { IsSigned: &mut IsSigned, DAG: &mut DAG, EltBits: &mut EltBits };
    let mut BothFitFP: Closure_194 = Closure_194 { FitsFP: &mut FitsFP, Dividend: &mut Dividend, Divisor: &mut Divisor };
    let mut NarrowI64: bool = EltBits == 64 && Subtarget.hasDQI() && Subtarget.useAVX512Regs() && BothFitFP.call(IEEEdouble());
    let mut UseExactFPDiv: bool = EltBits <= 32 || NarrowI64;
    if !UseExactFPDiv && EltBits != 64 {
        return SDValue {};
    }
    let mut FPSclVT: MVT = f64;
    if UseExactFPDiv && (EltBits <= 16 || BothFitFP.call(IEEEsingle())) {
        FPSclVT = f32;
    }
    let mut IsStrict: bool = DAG.getMachineFunction().getFunction().hasFnAttribute(StrictFP);
    if IsStrict && !Subtarget.useAVX512Regs() {
        return SDValue {};
    }
    if !UseExactFPDiv && (!Subtarget.hasDQI() || !Subtarget.useAVX512Regs()) {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut Needs512: bool = IsStrict || !UseExactFPDiv;
    if Needs512 && !isPowerOf2_32(NumElts) {
        if NextPowerOf2(NumElts) * FPSclVT.getSizeInBits().operator unsigned long long() > 512 {
            return SDValue {};
        }
        Dividend = DAG.WidenVector(Dividend, DL);
        Divisor = DAG.WidenVector(Divisor, DL);
        N = DAG.getNode(Opc, DL, Dividend.getValueType(), Dividend, Divisor).getNode();
    }
    let mut Res: SDValue = if UseExactFPDiv { combineIntDivRemViaExactFPDiv(N, FPSclVT, IsSigned, IsRem, IsStrict, DAG, DCI, Subtarget, DL) } else { combineInt64DivRemViaFPReciprocal(N, IsSigned, IsRem, DAG, Subtarget, DL) };
    if Res && Res.getValueType() != VT {
        Res = DAG.getExtractSubvector(DL, VT, Res, 0);
    }
    return Res;
}

fn combineMul(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    if combineMulToPMADDWD(N, DL, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if combineMulToPMULDQ(N, DL, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if combineMulToPMADD52(N, DL, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if DCI.isBeforeLegalize() && VT.isVector() {
        return reduceVMULWidth(N, DL, DAG, Subtarget);
    }
    if VT != i64 && VT != i32 && (!VT.isVector() || !VT.isSimple() || !VT.isInteger()) {
        return SDValue {};
    }
    let mut Known1: KnownBits = DAG.computeKnownBits(N.getOperand(1), 0);
    if !Known1.isConstant() {
        return SDValue {};
    }
    let mut C: *APInt = Known1.getConstant();
    if C.isZero() {
        return DAG.getConstant(0, DL, VT, false, false);
    }
    if C.isAllOnes() {
        return DAG.getNegative(N.getOperand(0), DL, VT);
    }
    if isPowerOf2_64(C.getZExtValue()) {
        return SDValue {};
    }
    if !MulConstantOptimization {
        return SDValue {};
    }
    if DAG.getMachineFunction().getFunction().hasMinSize() {
        return SDValue {};
    }
    if DCI.isBeforeLegalize() || DCI.isCalledByLegalizer() {
        return SDValue {};
    }
    let mut SignMulAmt: i64 = C.getSExtValue();
    assert!(SignMulAmt != (-9223372036854775807 - 1), "Int min should have been handled!");
    let mut AbsMulAmt: u64 = if SignMulAmt < 0 { -SignMulAmt } else { SignMulAmt };
    let mut NewMul: SDValue = SDValue {};
    if VT == i64 || VT == i32 {
        if AbsMulAmt == 3 || AbsMulAmt == 5 || AbsMulAmt == 9 {
            NewMul = DAG.getNode(MUL_IMM, DL, VT, N.getOperand(0), DAG.getConstant(AbsMulAmt, DL, VT, false, false));
            if SignMulAmt < 0 {
                NewMul = DAG.getNegative(NewMul, DL, VT);
            }
            return NewMul;
        }
        let mut MulAmt1: u64 = 0;
        let mut MulAmt2: u64 = 0;
        if (AbsMulAmt % 9) == 0 {
            MulAmt1 = 9;
            MulAmt2 = AbsMulAmt / 9;
        } else if (AbsMulAmt % 5) == 0 {
            MulAmt1 = 5;
            MulAmt2 = AbsMulAmt / 5;
        } else if (AbsMulAmt % 3) == 0 {
            MulAmt1 = 3;
            MulAmt2 = AbsMulAmt / 3;
        }
        if MulAmt2 && (isPowerOf2_64(MulAmt2) || (SignMulAmt >= 0 && (MulAmt2 == 3 || MulAmt2 == 5 || MulAmt2 == 9))) {
            if isPowerOf2_64(MulAmt2) && !(SignMulAmt >= 0 && N.hasOneUse() && operator(N.user_begin()).getOpcode() == ADD) {
                swap(MulAmt1, MulAmt2);
            }
            if isPowerOf2_64(MulAmt1) {
                NewMul = DAG.getNode(SHL, DL, VT, N.getOperand(0), DAG.getConstant(Log2_64(MulAmt1), DL, i8, false, false));
            } else {
                NewMul = DAG.getNode(MUL_IMM, DL, VT, N.getOperand(0), DAG.getConstant(MulAmt1, DL, VT, false, false));
            }
            if isPowerOf2_64(MulAmt2) {
                NewMul = DAG.getNode(SHL, DL, VT, NewMul, DAG.getConstant(Log2_64(MulAmt2), DL, i8, false, false));
            } else {
                NewMul = DAG.getNode(MUL_IMM, DL, VT, NewMul, DAG.getConstant(MulAmt2, DL, VT, false, false));
            }
            if SignMulAmt < 0 {
                NewMul = DAG.getNegative(NewMul, DL, VT);
            }
        } else if !Subtarget.slowLEA() {
            NewMul = combineMulSpecial(C.getZExtValue(), N, DAG, VT, DL);
        }
    }
    if !NewMul {
        let mut ShiftVT: EVT = if VT.isVector() { VT } else { i8 };
        if isPowerOf2_64(AbsMulAmt - 1) {
            NewMul = DAG.getNode(ADD, DL, VT, N.getOperand(0), DAG.getNode(SHL, DL, VT, N.getOperand(0), DAG.getConstant(Log2_64(AbsMulAmt - 1), DL, ShiftVT, false, false)));
            if SignMulAmt < 0 {
                NewMul = DAG.getNegative(NewMul, DL, VT);
            }
        } else if isPowerOf2_64(AbsMulAmt + 1) {
            NewMul = DAG.getNode(SHL, DL, VT, N.getOperand(0), DAG.getConstant(Log2_64(AbsMulAmt + 1), DL, ShiftVT, false, false));
            if SignMulAmt < 0 {
                NewMul = DAG.getNode(SUB, DL, VT, N.getOperand(0), NewMul);
            } else {
                NewMul = DAG.getNode(SUB, DL, VT, NewMul, N.getOperand(0));
            }
        } else if SignMulAmt >= 0 && isPowerOf2_64(AbsMulAmt - 2) && (!VT.isVector() || Subtarget.fastImmVectorShift()) {
            NewMul = DAG.getNode(SHL, DL, VT, N.getOperand(0), DAG.getConstant(Log2_64(AbsMulAmt - 2), DL, ShiftVT, false, false));
            NewMul = DAG.getNode(ADD, DL, VT, NewMul, DAG.getNode(ADD, DL, VT, N.getOperand(0), N.getOperand(0)));
        } else if SignMulAmt >= 0 && isPowerOf2_64(AbsMulAmt + 2) && (!VT.isVector() || Subtarget.fastImmVectorShift()) {
            NewMul = DAG.getNode(SHL, DL, VT, N.getOperand(0), DAG.getConstant(Log2_64(AbsMulAmt + 2), DL, ShiftVT, false, false));
            NewMul = DAG.getNode(SUB, DL, VT, NewMul, DAG.getNode(ADD, DL, VT, N.getOperand(0), N.getOperand(0)));
        } else if SignMulAmt >= 0 && VT.isVector() && Subtarget.fastImmVectorShift() {
            let mut AbsMulAmtLowBit: u64 = AbsMulAmt & (-AbsMulAmt);
            let mut ShiftAmt1: u64 = 0;
            let mut Opc: optional<unsigned int> = optional<unsigned int> {};
            if isPowerOf2_64(AbsMulAmt - AbsMulAmtLowBit) {
                ShiftAmt1 = AbsMulAmt - AbsMulAmtLowBit;
                Opc = ADD;
            } else if isPowerOf2_64(AbsMulAmt + AbsMulAmtLowBit) {
                ShiftAmt1 = AbsMulAmt + AbsMulAmtLowBit;
                Opc = SUB;
            }
            if Opc {
                let mut Shift1: SDValue = DAG.getNode(SHL, DL, VT, N.getOperand(0), DAG.getConstant(Log2_64(ShiftAmt1), DL, ShiftVT, false, false));
                let mut Shift2: SDValue = DAG.getNode(SHL, DL, VT, N.getOperand(0), DAG.getConstant(Log2_64(AbsMulAmtLowBit), DL, ShiftVT, false, false));
                NewMul = DAG.getNode(operator(Opc), DL, VT, Shift1, Shift2);
            }
        }
    }
    return NewMul;
}

fn combineShiftToPMULH(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    assert!((N.getOpcode() == SRL || N.getOpcode() == SRA), "SRL or SRA node is required here!");
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !VT.isVector() || VT.getVectorElementType().getSizeInBits().operator unsigned long long() < 32 {
        return SDValue {};
    }
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if !sd_match(N.getOperand(1), m_SpecificInt(16)) || !sd_match(N.getOperand(0), m_OneUse(m_Mul(m_Value(LHS), m_Value(RHS)))) {
        return SDValue {};
    }
    let mut ExtOpc: u32 = LHS.getOpcode();
    if (ExtOpc != SIGN_EXTEND && ExtOpc != ZERO_EXTEND) || RHS.getOpcode() != ExtOpc {
        return SDValue {};
    }
    LHS = LHS.getOperand(0);
    RHS = RHS.getOperand(0);
    let mut MulVT: EVT = LHS.getValueType();
    if MulVT.getVectorElementType() != i16 || RHS.getValueType() != MulVT {
        return SDValue {};
    }
    let mut Opc: u32 = if ExtOpc == SIGN_EXTEND { MULHS } else { MULHU };
    let mut Mulh: SDValue = DAG.getNode(Opc, DL, MulVT, LHS, RHS);
    ExtOpc = if N.getOpcode() == SRA { SIGN_EXTEND } else { ZERO_EXTEND };
    return DAG.getNode(ExtOpc, DL, VT, Mulh);
}

fn combineShiftLeft(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N1C: *mut ConstantSDNode = dyn_cast(N1);
    let mut VT: EVT = N0.getValueType();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut DL: SDLoc = N;
    if N0.getOpcode() == VSELECT && supportedVectorVarShift(VT, Subtarget, SHL) {
        let mut Cond: SDValue = N0.getOperand(0);
        let mut N00: SDValue = N0.getOperand(1);
        let mut N01: SDValue = N0.getOperand(2);
        if isConstantSplatVectorAllZeros(N01.getNode(), false) && sd_match(Cond, m_SpecificSetCC(SETULT, m_Specific(N1), m_SpecificInt(EltSizeInBits))) {
            return DAG.getNode(VSHLV, DL, VT, N00, N1);
        }
        if isConstantSplatVectorAllZeros(N00.getNode(), false) && sd_match(Cond, m_SpecificSetCC(SETUGE, m_Specific(N1), m_SpecificInt(EltSizeInBits))) {
            return DAG.getNode(VSHLV, DL, VT, N01, N1);
        }
    }
    if VT.isInteger() && !VT.isVector() && N1C && N0.getOpcode() == AND && N0.getOperand(1).getOpcode() == Constant {
        let mut N00: SDValue = N0.getOperand(0);
        let mut Mask: APInt = N0.getConstantOperandAPInt(1);
        operator(Mask, N1C.getAPIntValue());
        let mut MaskOK: bool = false;
        if N00.getOpcode() == SETCC_CARRY {
            MaskOK = true;
        } else if N00.getOpcode() == SIGN_EXTEND && N00.getOperand(0).getOpcode() == SETCC_CARRY {
            MaskOK = true;
        } else if (N00.getOpcode() == ZERO_EXTEND || N00.getOpcode() == ANY_EXTEND) && N00.getOperand(0).getOpcode() == SETCC_CARRY {
            MaskOK = Mask.isIntN(N00.getOperand(0).getValueSizeInBits().operator unsigned long long());
        }
        if MaskOK && Mask != 0 {
            return DAG.getNode(AND, DL, VT, N00, DAG.getConstant(Mask, DL, VT, false, false));
        }
    }
    return SDValue {};
}

fn combineShiftRightArithmetic(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut Size: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut DL: SDLoc = N;
    if combineShiftToPMULH(N, DAG, DL, Subtarget) {
        V;
    } else {
        return V;
    }
    if supportedVectorVarShift(VT, Subtarget, SRA) {
        let mut ShrAmtVal: SDValue = SDValue {};
        if sd_match(N1, m_UMin(m_Value(ShrAmtVal), m_SpecificInt(VT.getScalarSizeInBits() - 1))) {
            return DAG.getNode(VSRAV, DL, VT, N0, ShrAmtVal);
        }
    }
    if VT.isVector() || N1.getOpcode() != Constant || N0.getOpcode() != SHL || !N0.hasOneUse() || N0.getOperand(1).getOpcode() != Constant {
        return SDValue {};
    }
    let mut N00: SDValue = N0.getOperand(0);
    let mut N01: SDValue = N0.getOperand(1);
    let mut ShlConst: APInt = operator(N01).getAsAPIntVal();
    let mut SraConst: APInt = operator(N1).getAsAPIntVal();
    let mut CVT: EVT = N1.getValueType();
    if CVT != N01.getValueType() {
        return SDValue {};
    }
    if SraConst.isNegative() {
        return SDValue {};
    }
    for SVT in [i8, i16, i32] {
        let mut ShiftSize: u32 = SVT.getSizeInBits().operator unsigned long long();
        if ShiftSize >= Size || ShlConst != Size - ShiftSize {
            continue;
        }
        let mut NN: SDValue = DAG.getNode(SIGN_EXTEND_INREG, DL, VT, N00, DAG.getValueType(SVT));
        if SraConst.eq(ShlConst) {
            return NN;
        }
        if SraConst.ult(ShlConst) {
            return DAG.getNode(SHL, DL, VT, NN, DAG.getConstant(ShlConst - SraConst, DL, CVT, false, false));
        }
        return DAG.getNode(SRA, DL, VT, NN, DAG.getConstant(SraConst - ShlConst, DL, CVT, false, false));
    }
    return SDValue {};
}

fn combineShiftRightLogical(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut DL: SDLoc = N;
    if combineShiftToPMULH(N, DAG, DL, Subtarget) {
        V;
    } else {
        return V;
    }
    if N0.getOpcode() == VSELECT && supportedVectorVarShift(VT, Subtarget, SRL) {
        let mut Cond: SDValue = N0.getOperand(0);
        let mut N00: SDValue = N0.getOperand(1);
        let mut N01: SDValue = N0.getOperand(2);
        if isConstantSplatVectorAllZeros(N01.getNode(), false) && sd_match(Cond, m_SpecificSetCC(SETULT, m_Specific(N1), m_SpecificInt(EltSizeInBits))) {
            return DAG.getNode(VSRLV, DL, VT, N00, N1);
        }
        if isConstantSplatVectorAllZeros(N00.getNode(), false) && sd_match(Cond, m_SpecificSetCC(SETUGE, m_Specific(N1), m_SpecificInt(EltSizeInBits))) {
            return DAG.getNode(VSRLV, DL, VT, N01, N1);
        }
    }
    if sd_match(N1, m_SpecificInt(EltSizeInBits - 1)) {
        let mut X: SDValue = N0;
        let mut CC: CondCode = SETNE;
        if sd_match(N0, m_Not(m_Value(X))) {
            CC = SETEQ;
        }
        if X.getOpcode() == VECREDUCE_UMAX {
            let mut V: SDValue = X.getOperand(0);
            let mut VecVT: EVT = V.getValueType();
            if DAG.getTargetLoweringInfo().isTypeLegal(VecVT) && VecVT.getScalarSizeInBits() >= 8 {
                if VecVT.is512BitVector() {
                    V = DAG.getNode(OR, DL, Lo.getValueType(), Lo, Hi);
                    VecVT = V.getValueType();
                }
                if VecVT == v16i16 {
                    V = DAG.getNode(PACKSS, DL, v16i8, Lo, Hi);
                } else if VecVT == v8i16 {
                    V = DAG.getNode(PACKSS, DL, v16i8, V, V);
                }
                V = getMOVMSK(DL, V, DAG, Subtarget);
                V = DAG.getSetCC(DL, i8, V, DAG.getConstant(0, DL, i32, false, false), CC, SDValue {}, false, None);
                return DAG.getZExtOrTrunc(V, DL, VT);
            }
        }
    }
    if !DCI.isAfterLegalizeDAG() {
        return SDValue {};
    }
    if N0.getOpcode() != AND || !N0.hasOneUse() {
        return SDValue {};
    }
    let mut ShiftC: *mut ConstantSDNode = dyn_cast(N1);
    let mut AndC: *mut ConstantSDNode = dyn_cast(N0.getOperand(1));
    if !ShiftC || !AndC {
        return SDValue {};
    }
    let mut MaskVal: APInt = AndC.getAPIntValue();
    if MaskVal.isMask() {
        let mut TO: u32 = MaskVal.countr_one();
        if TO >= 8 && isPowerOf2_32(TO) {
            return SDValue {};
        }
    }
    let mut NewMaskVal: APInt = MaskVal.lshr(ShiftC.getAPIntValue());
    let mut OldMaskSize: u32 = MaskVal.getSignificantBits();
    let mut NewMaskSize: u32 = NewMaskVal.getSignificantBits();
    if (OldMaskSize > 8 && NewMaskSize <= 8) || (OldMaskSize > 32 && NewMaskSize <= 32) {
        let mut NewMask: SDValue = DAG.getConstant(NewMaskVal, DL, VT, false, false);
        let mut NewShift: SDValue = DAG.getNode(SRL, DL, VT, N0.getOperand(0), N1);
        return DAG.getNode(AND, DL, VT, NewShift, NewMask);
    }
    return SDValue {};
}

fn combineHorizOpWithShuffle(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    assert!(isHorizOp(Opcode), "Unexpected hadd/hsub/pack opcode");
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut SrcVT: EVT = N0.getValueType();
    let mut BC0: SDValue = if N.isOnlyUserOf(N0.getNode()) { peekThroughOneUseBitcasts(N0) } else { N0 };
    let mut BC1: SDValue = if N.isOnlyUserOf(N1.getNode()) { peekThroughOneUseBitcasts(N1) } else { N1 };
    if VT.is128BitVector() && SrcVT.getScalarSizeInBits() <= 32 {
        if getSplitVectorSrc(BC0, BC1, false) {
            BCSrc;
        } else {
            let mut ShuffleOps: SmallVector<SDValue> = SmallVector<SDValue> {};
            let mut ShuffleMask: SmallVector<int> = SmallVector<int> {};
            let mut ScaledMask: SmallVector<int> = SmallVector<int> {};
            let mut Vec: SDValue = peekThroughBitcasts(BCSrc);
            if getTargetShuffleInputs(Vec, ShuffleOps, ShuffleMask, DAG, 0, true) {
                resolveTargetShuffleInputsAndMask(ShuffleOps, ShuffleMask);
                if !isAnyZero(ShuffleMask) && ShuffleOps.len == 1 && ShuffleOps[0].getValueType().is256BitVector() && scaleShuffleElements(ShuffleMask, 4, ScaledMask) {
                    let mut Lo: SDValue = SDValue {};
                    let mut Hi: SDValue = SDValue {};
                    let mut ShufVT: MVT = if VT.isFloatingPoint() { v4f32 } else { v4i32 };
                    tie(Lo, Hi) = DAG.SplitVector(ShuffleOps[0], DL);
                    Lo = DAG.getBitcast(SrcVT, Lo);
                    Hi = DAG.getBitcast(SrcVT, Hi);
                    let mut Res: SDValue = DAG.getNode(Opcode, DL, VT, Lo, Hi);
                    Res = DAG.getBitcast(ShufVT, Res);
                    Res = DAG.getVectorShuffle(ShufVT, DL, Res, Res, ScaledMask);
                    return DAG.getBitcast(VT, Res);
                }
            }
        }
    }
    if VT.is128BitVector() && SrcVT.getScalarSizeInBits() <= 32 {
        let mut Ops0: SmallVector<SDValue> = SmallVector<SDValue> {};
        let mut Ops1: SmallVector<SDValue> = SmallVector<SDValue> {};
        let mut Mask0: SmallVector<int> = SmallVector<int> {};
        let mut Mask1: SmallVector<int> = SmallVector<int> {};
        let mut ScaledMask0: SmallVector<int> = SmallVector<int> {};
        let mut ScaledMask1: SmallVector<int> = SmallVector<int> {};
        let mut IsShuf0: bool = getTargetShuffleInputs(BC0, Ops0, Mask0, DAG, 0, true) && !isAnyZero(Mask0) && scaleShuffleElements(Mask0, 2, ScaledMask0) && all_of(Ops0, Closure_195 {});
        let mut IsShuf1: bool = getTargetShuffleInputs(BC1, Ops1, Mask1, DAG, 0, true) && !isAnyZero(Mask1) && scaleShuffleElements(Mask1, 2, ScaledMask1) && all_of(Ops1, Closure_196 {});
        if IsShuf0 || IsShuf1 {
            if !IsShuf0 {
                Ops0.assign([BC0]);
                ScaledMask0.assign([0, 1]);
            }
            if !IsShuf1 {
                Ops1.assign([BC1]);
                ScaledMask1.assign([0, 1]);
            }
            let mut LHS: SDValue = SDValue {};
            let mut RHS: SDValue = SDValue {};
            let mut PostShuffle: [4]i32 = [-1, -1, -1, -1];
            let mut FindShuffleOpAndIdx: Closure_197 = Closure_197 { LHS: &mut LHS, RHS: &mut RHS };
            if FindShuffleOpAndIdx.call(ScaledMask0[0], PostShuffle[0], Ops0) && FindShuffleOpAndIdx.call(ScaledMask0[1], PostShuffle[1], Ops0) && FindShuffleOpAndIdx.call(ScaledMask1[0], PostShuffle[2], Ops1) && FindShuffleOpAndIdx.call(ScaledMask1[1], PostShuffle[3], Ops1) {
                LHS = DAG.getBitcast(SrcVT, LHS);
                RHS = DAG.getBitcast(SrcVT, if RHS { RHS } else { LHS });
                let mut ShufVT: MVT = if VT.isFloatingPoint() { v4f32 } else { v4i32 };
                let mut Res: SDValue = DAG.getNode(Opcode, DL, VT, LHS, RHS);
                Res = DAG.getBitcast(ShufVT, Res);
                Res = DAG.getVectorShuffle(ShufVT, DL, Res, Res, PostShuffle);
                return DAG.getBitcast(VT, Res);
            }
        }
    }
    if VT.is256BitVector() && Subtarget.hasInt256() {
        let mut Mask0: SmallVector<int> = SmallVector<int> {};
        let mut Mask1: SmallVector<int> = SmallVector<int> {};
        let mut Ops0: SmallVector<SDValue> = SmallVector<SDValue> {};
        let mut Ops1: SmallVector<SDValue> = SmallVector<SDValue> {};
        let mut ScaledMask0: SmallVector<int, 2> = SmallVector<int, 2> {};
        let mut ScaledMask1: SmallVector<int, 2> = SmallVector<int, 2> {};
        if getTargetShuffleInputs(BC0, Ops0, Mask0, DAG, 0, true) && !isAnyZero(Mask0) && getTargetShuffleInputs(BC1, Ops1, Mask1, DAG, 0, true) && !isAnyZero(Mask1) && !Ops0.is_empty() && !Ops1.is_empty() && all_of(Ops0, Closure_198 {}) && all_of(Ops1, Closure_199 {}) && scaleShuffleElements(Mask0, 2, ScaledMask0) && scaleShuffleElements(Mask1, 2, ScaledMask1) {
            let mut Op00: SDValue = peekThroughBitcasts(Ops0.front());
            let mut Op10: SDValue = peekThroughBitcasts(Ops1.front());
            let mut Op01: SDValue = peekThroughBitcasts(Ops0.back());
            let mut Op11: SDValue = peekThroughBitcasts(Ops1.back());
            if (Op00 == Op11) && (Op01 == Op10) {
                swap(Op10, Op11);
                commuteMask(ScaledMask1);
            }
            if (Op00 == Op10) && (Op01 == Op11) {
                let mut Map: [4]i32 = [0, 2, 1, 3];
                let mut ShuffleMask: [4]i32 = [ScaledMask0[0], ScaledMask1[0], ScaledMask0[1], ScaledMask1[1]];
                for M in ShuffleMask[..] {
                    if 0 <= M {
                        M = Map[M];
                    }
                }
                let mut ShufVT: MVT = if VT.isFloatingPoint() { v4f64 } else { v4i64 };
                let mut Res: SDValue = DAG.getNode(Opcode, DL, VT, DAG.getBitcast(SrcVT, Op00), DAG.getBitcast(SrcVT, Op01));
                Res = DAG.getBitcast(ShufVT, Res);
                Res = DAG.getVectorShuffle(ShufVT, DL, Res, Res, ShuffleMask);
                return DAG.getBitcast(VT, Res);
            }
        }
    }
    return SDValue {};
}

fn combineVectorPack(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    assert!((PACKSS == Opcode || PACKUS == Opcode), "Unexpected pack opcode");
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut NumDstElts: u32 = VT.getVectorNumElements();
    let mut DstBitsPerElt: u32 = VT.getScalarSizeInBits();
    let mut SrcBitsPerElt: u32 = 2 * DstBitsPerElt;
    assert!(N0.getScalarValueSizeInBits() == SrcBitsPerElt && N1.getScalarValueSizeInBits() == SrcBitsPerElt, "Unexpected PACKSS/PACKUS input type");
    let mut IsSigned: bool = (PACKSS == Opcode);
    let mut UndefElts0: APInt = APInt {};
    let mut UndefElts1: APInt = APInt {};
    let mut EltBits0: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
    let mut EltBits1: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
    if (N0.isUndef() || N.isOnlyUserOf(N0.getNode())) && (N1.isUndef() || N.isOnlyUserOf(N1.getNode())) && getTargetConstantBitsFromNode(N0, SrcBitsPerElt, UndefElts0, EltBits0, true, true) && getTargetConstantBitsFromNode(N1, SrcBitsPerElt, UndefElts1, EltBits1, true, true) {
        let mut NumLanes: u32 = VT.getSizeInBits().operator unsigned long long() / 128;
        let mut NumSrcElts: u32 = NumDstElts / 2;
        let mut NumDstEltsPerLane: u32 = NumDstElts / NumLanes;
        let mut NumSrcEltsPerLane: u32 = NumSrcElts / NumLanes;
        let mut Undefs: APInt = APInt { NumDstElts, 0, false, false };
        let mut Bits: SmallVector<APInt, 32> = SmallVector<APInt, 32> { NumDstElts, getZero(DstBitsPerElt) };
        for let mut Lane: u32 = 0; Lane != NumLanes; Lane += 1 {
            for let mut Elt: u32 = 0; Elt != NumDstEltsPerLane; Elt += 1 {
                let mut SrcIdx: u32 = Lane * NumSrcEltsPerLane + Elt % NumSrcEltsPerLane;
                let mut UndefElts: *mut APInt = (if Elt >= NumSrcEltsPerLane { UndefElts1 } else { UndefElts0 });
                let mut EltBits: *mut SmallVector<APInt, 32> = (if Elt >= NumSrcEltsPerLane { EltBits1 } else { EltBits0 });
                if UndefElts[SrcIdx] {
                    Undefs.setBit(Lane * NumDstEltsPerLane + Elt);
                    continue;
                }
                let mut Val: *mut APInt = EltBits[SrcIdx];
                if IsSigned {
                    Val = Val.truncSSat(DstBitsPerElt);
                } else {
                    Val = Val.truncSSatU(DstBitsPerElt);
                }
                Bits[Lane * NumDstEltsPerLane + Elt] = Val;
            }
        }
        return getConstVector(Bits, Undefs, VT.getSimpleVT(), DAG, N);
    }
    if combineHorizOpWithShuffle(N, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if IsSigned && (N0.isUndef() || DAG.ComputeNumSignBits(N0, 0) == SrcBitsPerElt) && (N1.isUndef() || DAG.ComputeNumSignBits(N1, 0) == SrcBitsPerElt) {
        let mut Not0: SDValue = if N0.isUndef() { N0 } else { IsNOT(N0, DAG) };
        let mut Not1: SDValue = if N1.isUndef() { N1 } else { IsNOT(N1, DAG) };
        if Not0 && Not1 {
            let mut DL: SDLoc = N;
            let mut SrcVT: MVT = N0.getSimpleValueType();
            let mut Pack: SDValue = DAG.getNode(PACKSS, DL, VT, DAG.getBitcast(SrcVT, Not0), DAG.getBitcast(SrcVT, Not1));
            return DAG.getNOT(DL, Pack, VT);
        }
    }
    if Subtarget.hasAVX512() && N0.getOpcode() == TRUNCATE && N1.isUndef() && VT == v16i8 && N0.getOperand(0).getValueType() == v8i32 {
        if (IsSigned && DAG.ComputeNumSignBits(N0, 0) > 8) || (!IsSigned && DAG.MaskedValueIsZero(N0, getHighBitsSet(16, 8), 0)) {
            if Subtarget.hasVLX() {
                return DAG.getNode(VTRUNC, N, VT, N0.getOperand(0));
            }
            let mut dl: SDLoc = N;
            let mut Concat: SDValue = DAG.getNode(CONCAT_VECTORS, dl, v16i32, N0.getOperand(0), DAG.getUNDEF(v8i32));
            return DAG.getNode(TRUNCATE, N, VT, Concat);
        }
    }
    if VT.is128BitVector() {
        let mut ExtOpc: u32 = if IsSigned { SIGN_EXTEND } else { ZERO_EXTEND };
        let mut Src0: SDValue = SDValue {};
        let mut Src1: SDValue = SDValue {};
        if N0.getOpcode() == ExtOpc && N0.getOperand(0).getValueType().is64BitVector() && N0.getOperand(0).getScalarValueSizeInBits() == DstBitsPerElt {
            Src0 = N0.getOperand(0);
        }
        if N1.getOpcode() == ExtOpc && N1.getOperand(0).getValueType().is64BitVector() && N1.getOperand(0).getScalarValueSizeInBits() == DstBitsPerElt {
            Src1 = N1.getOperand(0);
        }
        if (Src0 || N0.isUndef()) && (Src1 || N1.isUndef()) {
            assert!((Src0 || Src1), "Found PACK(UNDEF,UNDEF)");
            Src0 = if Src0 { Src0 } else { DAG.getUNDEF(Src1.getValueType()) };
            Src1 = if Src1 { Src1 } else { DAG.getUNDEF(Src0.getValueType()) };
            return DAG.getNode(CONCAT_VECTORS, N, VT, Src0, Src1);
        }
        let mut VecInRegOpc: u32 = if IsSigned { SIGN_EXTEND_VECTOR_INREG } else { ZERO_EXTEND_VECTOR_INREG };
        if N0.getOpcode() == VecInRegOpc && N1.isUndef() && N0.getOperand(0).getScalarValueSizeInBits() < DstBitsPerElt {
            return getEXTEND_VECTOR_INREG(ExtOpc, N, VT, N0.getOperand(0), DAG);
        }
    }
    let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
    if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
        Res;
    } else {
        return Res;
    }
    return SDValue {};
}

fn combineVectorHADDSUB(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    assert!((HADD == N.getOpcode() || FHADD == N.getOpcode() || HSUB == N.getOpcode() || FHSUB == N.getOpcode()), "Unexpected horizontal add/sub opcode");
    if !shouldUseHorizontalOp(true, DAG, Subtarget) {
        let mut VT: MVT = N.getSimpleValueType(0);
        let mut LHS: SDValue = N.getOperand(0);
        let mut RHS: SDValue = N.getOperand(1);
        if LHS != RHS && LHS.getOpcode() == N.getOpcode() && LHS.getOpcode() == RHS.getOpcode() && LHS.getValueType() == RHS.getValueType() && N.isOnlyUserOf(LHS.getNode()) && N.isOnlyUserOf(RHS.getNode()) {
            let mut LHS0: SDValue = LHS.getOperand(0);
            let mut LHS1: SDValue = LHS.getOperand(1);
            let mut RHS0: SDValue = RHS.getOperand(0);
            let mut RHS1: SDValue = RHS.getOperand(1);
            if (LHS0 == LHS1 || LHS0.isUndef() || LHS1.isUndef()) && (RHS0 == RHS1 || RHS0.isUndef() || RHS1.isUndef()) {
                let mut DL: SDLoc = N;
                let mut Res: SDValue = DAG.getNode(LHS.getOpcode(), DL, LHS.getValueType(), if LHS0.isUndef() { LHS1 } else { LHS0 }, if RHS0.isUndef() { RHS1 } else { RHS0 });
                let mut ShufVT: MVT = getVectorVT(i32, VT.getSizeInBits().operator unsigned long long() / 32);
                Res = DAG.getBitcast(ShufVT, Res);
                let mut NewLHS: SDValue = DAG.getNode(PSHUFD, DL, ShufVT, Res, getV4X86ShuffleImm8ForMask([0, 1, 0, 1], DL, DAG));
                let mut NewRHS: SDValue = DAG.getNode(PSHUFD, DL, ShufVT, Res, getV4X86ShuffleImm8ForMask([2, 3, 2, 3], DL, DAG));
                return DAG.getNode(N.getOpcode(), DL, VT, DAG.getBitcast(VT, NewLHS), DAG.getBitcast(VT, NewRHS));
            }
        }
    }
    if combineHorizOpWithShuffle(N, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn combineVectorShiftVar(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    assert!((VSHL == N.getOpcode() || VSRA == N.getOpcode() || VSRL == N.getOpcode()), "Unexpected shift opcode");
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if isBuildVectorAllZeros(N0.getNode()) {
        return DAG.getConstant(0, N, VT, false, false);
    }
    let mut UndefElts: APInt = APInt {};
    let mut EltBits: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
    if getTargetConstantBitsFromNode(N1, 64, UndefElts, EltBits, true, false) {
        let mut X86Opc: u32 = getTargetVShiftUniformOpcode(N.getOpcode(), false);
        return getTargetVShiftByConstNode(X86Opc, N, VT.getSimpleVT(), N0, EltBits[0].getZExtValue(), DAG);
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DemandedElts: APInt = getAllOnes(VT.getVectorNumElements());
    if TLI.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }, DemandedElts, DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn combineVectorShiftImm(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    assert!((VSHLI == Opcode || VSRAI == Opcode || VSRLI == Opcode), "Unexpected shift opcode");
    let mut LogicalShift: bool = VSHLI == Opcode || VSRLI == Opcode;
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut NumBitsPerElt: u32 = VT.getScalarSizeInBits();
    assert!(VT == N0.getValueType() && (NumBitsPerElt % 8) == 0, "Unexpected value type");
    assert!(N1.getValueType() == i8, "Unexpected shift amount type");
    if N0.isUndef() {
        return DAG.getConstant(0, N, VT, false, false);
    }
    let mut ShiftVal: u32 = N.getConstantOperandVal(1);
    if ShiftVal >= NumBitsPerElt {
        if LogicalShift {
            return DAG.getConstant(0, N, VT, false, false);
        }
        ShiftVal = NumBitsPerElt - 1;
    }
    if !ShiftVal {
        return N0;
    }
    if isBuildVectorAllZeros(N0.getNode()) {
        return DAG.getConstant(0, N, VT, false, false);
    }
    if !LogicalShift && isBuildVectorAllOnes(N0.getNode()) {
        return DAG.getAllOnesConstant(N, VT, false, false);
    }
    let mut MergeShifts: Closure_200 = Closure_200 { NumBitsPerElt: &mut NumBitsPerElt, LogicalShift: &mut LogicalShift, DAG: &mut DAG, N: &mut N, VT: &mut VT, Opcode: &mut Opcode, N0: &mut N0 };
    if Opcode == N0.getOpcode() {
        return MergeShifts.call(N0.getOperand(0), ShiftVal, N0.getConstantOperandVal(1));
    }
    if Opcode == VSHLI && N0.getOpcode() == ADD && N0.getOperand(0) == N0.getOperand(1) {
        return MergeShifts.call(N0.getOperand(0), ShiftVal, 1);
    }
    if LogicalShift && (ShiftVal % 8) == 0 {
        let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
        if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
            Res;
        } else {
            return Res;
        }
    }
    if Opcode == VSRAI && NumBitsPerElt == 32 && ShiftVal == 31 && N0.getOpcode() == PSHUFD && N0.getConstantOperandVal(1) == getV4X86ShuffleImm([1, 1, 3, 3]) && operator(N0).hasOneUse() {
        let mut BC: SDValue = peekThroughOneUseBitcasts(N0.getOperand(0));
        if BC.getOpcode() == VSHLI && BC.getScalarValueSizeInBits() == 64 && BC.getConstantOperandVal(1) == 63 {
            let mut DL: SDLoc = N;
            let mut Src: SDValue = BC.getOperand(0);
            Src = DAG.getBitcast(VT, Src);
            Src = DAG.getNode(PSHUFD, DL, VT, Src, getV4X86ShuffleImm8ForMask([0, 0, 2, 2], DL, DAG));
            Src = DAG.getNode(VSHLI, DL, VT, Src, N1);
            Src = DAG.getNode(VSRAI, DL, VT, Src, N1);
            return Src;
        }
    }
    let mut TryConstantFold: Closure_201 = Closure_201 { NumBitsPerElt: &mut NumBitsPerElt, VT: &mut VT, Opcode: &mut Opcode, ShiftVal: &mut ShiftVal, DAG: &mut DAG, N: &mut N };
    if N.isOnlyUserOf(N0.getNode()) {
        if TryConstantFold.call(N0) {
            C;
        } else {
            return C;
        }
        let mut BC: SDValue = peekThroughOneUseBitcasts(N0);
        if isBitwiseLogicOp(BC.getOpcode()) && operator(BC).isOnlyUserOf(BC.getOperand(1).getNode()) && !isBuildVectorAllOnes(BC.getOperand(1).getNode()) {
            if TryConstantFold.call(BC.getOperand(1)) {
                RHS;
            } else {
                let mut DL: SDLoc = N;
                let mut LHS: SDValue = DAG.getNode(Opcode, DL, VT, DAG.getBitcast(VT, BC.getOperand(0)), N1);
                return DAG.getNode(BC.getOpcode(), DL, VT, LHS, RHS);
            }
        }
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, getAllOnes(NumBitsPerElt), DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn combineVectorInsert(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Opcode: u32 = N.getOpcode();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut NumBitsPerElt: u32 = VT.getScalarSizeInBits();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    assert!(((Opcode == PINSRB && VT == v16i8) || (Opcode == PINSRW && VT == v8i16) || Opcode == INSERT_VECTOR_ELT), "Unexpected vector insertion");
    let mut Vec: SDValue = N.getOperand(0);
    let mut Scl: SDValue = N.getOperand(1);
    let mut Idx: SDValue = N.getOperand(2);
    if Opcode == INSERT_VECTOR_ELT {
        let mut CIdx: *mut ConstantSDNode = dyn_cast(Idx);
        if CIdx && CIdx.getAPIntValue().uge(NumElts) {
            return DAG.getPOISON(VT);
        }
        if Vec.isUndef() && isNullConstant(Idx) {
            return DAG.getNode(SCALAR_TO_VECTOR, N, VT, Scl);
        }
        if !DCI.isBeforeLegalize() && VT.isInteger() && CIdx && (CIdx.getZExtValue() & 1) == 1 && TLI.isTypeLegal(VT) {
            let mut Cst: *mut ConstantSDNode = dyn_cast(Scl);
            let mut WideSVT: MVT = getIntegerVT(2 * NumBitsPerElt);
            let mut WideVT: MVT = getVectorVT(WideSVT, NumElts / 2);
            let mut InnerVec: SDValue = SDValue {};
            let mut InnerScl: SDValue = SDValue {};
            if Cst && TLI.isTypeLegal(WideSVT) && TLI.isTypeLegal(WideVT) && sd_match(Vec, m_OneUse(m_InsertElt(m_Value(InnerVec), m_Value(InnerScl), m_SpecificInt(CIdx.getZExtValue() - 1)))) {
                if isa(InnerScl) {
                    let mut DL: SDLoc = N;
                    let mut Lo: SDValue = DAG.getNode(ZERO_EXTEND, DL, WideSVT, InnerScl);
                    let mut Hi: SDValue = DAG.getNode(ZERO_EXTEND, DL, WideSVT, Scl);
                    Lo = DAG.getZeroExtendInReg(Lo, DL, VT.getScalarType());
                    Hi = DAG.getNode(SHL, DL, WideSVT, Hi, DAG.getShiftAmountConstant(NumBitsPerElt, WideSVT, DL));
                    let mut NewIdx: u32 = (CIdx.getZExtValue() - 1) / 2;
                    let mut NewInsert: SDValue = DAG.getInsertVectorElt(DL, DAG.getBitcast(WideVT, InnerVec), DAG.getNode(OR, DL, WideSVT, Lo, Hi), NewIdx);
                    return DAG.getBitcast(VT, NewInsert);
                }
            }
        }
    }
    if Opcode == PINSRB || Opcode == PINSRW {
        if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, getAllOnes(NumBitsPerElt), DCI) {
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if VT.isSimple() && DCI.isAfterLegalizeDAG() {
        let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
        if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
            Res;
        } else {
            return Res;
        }
    }
    return SDValue {};
}

fn combineCompareEqual(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut opcode: u32 = 0;
    if Subtarget.hasSSE2() && isAndOrOfSetCCs(SDValue { Node: N, ResNo: 0 }, opcode) {
        let mut N0: SDValue = N.getOperand(0);
        let mut N1: SDValue = N.getOperand(1);
        let mut CMP0: SDValue = N0.getOperand(1);
        let mut CMP1: SDValue = N1.getOperand(1);
        let mut DL: SDLoc = N;
        if CMP0.getOpcode() != FCMP || CMP0 != CMP1 {
            return SDValue {};
        }
        let mut CMP00: SDValue = operator(CMP0).getOperand(0);
        let mut CMP01: SDValue = operator(CMP0).getOperand(1);
        let mut VT: EVT = CMP00.getValueType();
        if VT == f32 || VT == f64 || (VT == f16 && Subtarget.hasFP16()) {
            let mut ExpectingFlags: bool = false;
            for U in N.users() {
                if ExpectingFlags {
                    break;
                }
                match U.getOpcode() {
                    _ => {
                        BR_CC;
                    },
                    CopyToReg => {
                        SIGN_EXTEND;
                    },
                }
            }
            if !ExpectingFlags {
                let mut cc0: CondCode = N0.getConstantOperandVal(0) as CondCode;
                let mut cc1: CondCode = N1.getConstantOperandVal(0) as CondCode;
                if cc1 == COND_E || cc1 == COND_NE {
                    let mut tmp: CondCode = cc0;
                    cc0 = cc1;
                    cc1 = tmp;
                }
                if (cc0 == COND_E && cc1 == COND_NP) || (cc0 == COND_NE && cc1 == COND_P) {
                    let mut x86cc: u32 = if (cc0 == COND_E) { 0 } else { 4 };
                    if Subtarget.hasAVX512() {
                        let mut FSetCC: SDValue = DAG.getNode(FSETCCM, DL, v1i1, CMP00, CMP01, DAG.getTargetConstant(x86cc, DL, i8, false));
                        let mut Ins: SDValue = DAG.getNode(INSERT_SUBVECTOR, DL, v16i1, DAG.getConstant(0, DL, v16i1, false, false), FSetCC, DAG.getVectorIdxConstant(0, DL, false));
                        return DAG.getZExtOrTrunc(DAG.getBitcast(i16, Ins), DL, N.getSimpleValueType(0));
                    }
                    let mut OnesOrZeroesF: SDValue = DAG.getNode(FSETCC, DL, CMP00.getValueType(), CMP00, CMP01, DAG.getTargetConstant(x86cc, DL, i8, false));
                    let mut is64BitFP: bool = (CMP00.getValueType() == f64);
                    let mut IntVT: MVT = if is64BitFP { i64 } else { i32 };
                    if is64BitFP && !Subtarget.is64Bit() {
                        let mut Vector64: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, v2f64, OnesOrZeroesF);
                        let mut Vector32: SDValue = DAG.getBitcast(v4f32, Vector64);
                        OnesOrZeroesF = DAG.getNode(EXTRACT_VECTOR_ELT, DL, f32, Vector32, DAG.getVectorIdxConstant(0, DL, false));
                        IntVT = i32;
                    }
                    let mut OnesOrZeroesI: SDValue = DAG.getBitcast(IntVT, OnesOrZeroesF);
                    let mut ANDed: SDValue = DAG.getNode(AND, DL, IntVT, OnesOrZeroesI, DAG.getConstant(1, DL, IntVT, false, false));
                    let mut OneBitOfTruth: SDValue = DAG.getNode(TRUNCATE, DL, i8, ANDed);
                    return OneBitOfTruth;
                }
            }
        }
    }
    return SDValue {};
}

fn combineAndNotIntoANDNP(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!(N.getOpcode() == AND, "Unexpected opcode combine into ANDNP");
    let mut VT: MVT = N.getSimpleValueType(0);
    if !VT.is128BitVector() && !VT.is256BitVector() && !VT.is512BitVector() {
        return SDValue {};
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if IsNOT(N0, DAG) {
        Not;
    } else {
        X = Not;
        Y = N1;
    }
    X = DAG.getBitcast(VT, X);
    Y = DAG.getBitcast(VT, Y);
    return DAG.getNode(ANDNP, DL, VT, X, Y);
}

fn combineI8AndNotIntoI32AndNot(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(N.getOpcode() == AND, "Unexpected opcode combine into ANDN");
    if !Subtarget.hasBMI() || N.getValueType(0) != i8 {
        return SDValue {};
    }
    for Use in N.uses() {
        if Use.getResNo() != 0 {
            continue;
        }
        let mut User: *mut SDNode = Use.getUser();
        if User.getOpcode() == SETCC {
            return SDValue {};
        }
        if User.getOpcode() == BITCAST {
            let mut UseVT: EVT = User.getValueType(0);
            if UseVT.isVector() && UseVT.getScalarType() == i1 {
                return SDValue {};
            }
        }
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if IsNOT(N0, DAG) {
        Not;
    } else {
        X = Not;
        Y = N1;
    }
    let mut C: *mut ConstantSDNode = dyn_cast(Y);
    if C && !C.isOpaque() {
        return SDValue {};
    }
    X = DAG.getBitcast(i8, X);
    let mut ExtX: SDValue = DAG.getNode(ANY_EXTEND, DL, i32, X);
    let mut ExtY: SDValue = DAG.getNode(ANY_EXTEND, DL, i32, Y);
    let mut And: SDValue = DAG.getNode(AND, DL, i32, DAG.getNOT(DL, ExtX, i32), ExtY);
    return DAG.getNode(TRUNCATE, DL, i8, And);
}

fn combineAndShuffleNot(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(N.getOpcode() == AND, "Unexpected opcode combine into ANDNP");
    let mut VT: EVT = N.getValueType(0);
    if !((VT.is128BitVector() && Subtarget.hasSSE2()) || ((VT.is256BitVector() || VT.is512BitVector()) && Subtarget.hasAVX())) {
        return SDValue {};
    }
    let mut GetNot: Closure_202 = Closure_202 { DAG: &mut DAG };
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if GetNot.call(N0) {
        Not;
    } else {
        X = Not;
        Y = N1;
    }
    X = DAG.getBitcast(VT, X);
    Y = DAG.getBitcast(VT, Y);
    let mut DL: SDLoc = N;
    if !Subtarget.useAVX512Regs() && VT.is512BitVector() && TLI.isTypeLegal(VT.getHalfNumVectorElementsVT(*DAG.getContext())) {
        let mut LoX: SDValue = SDValue {};
        let mut HiX: SDValue = SDValue {};
        tie(LoX, HiX) = splitVector(X, DAG, DL);
        let mut LoY: SDValue = SDValue {};
        let mut HiY: SDValue = SDValue {};
        tie(LoY, HiY) = splitVector(Y, DAG, DL);
        let mut SplitVT: EVT = LoX.getValueType();
        let mut LoV: SDValue = DAG.getNode(ANDNP, DL, SplitVT, [LoX, LoY]);
        let mut HiV: SDValue = DAG.getNode(ANDNP, DL, SplitVT, [HiX, HiY]);
        return DAG.getNode(CONCAT_VECTORS, DL, VT, [LoV, HiV]);
    }
    if TLI.isTypeLegal(VT) {
        return DAG.getNode(ANDNP, DL, VT, [X, Y]);
    }
    return SDValue {};
}

fn PromoteMaskArithmetic(N: SDValue, DL: *SDLoc, VT: EVT, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, Depth: u32) -> SDValue {
    if Depth >= MaxRecursionDepth {
        return SDValue {};
    }
    if !isBitwiseLogicOp(N.getOpcode()) {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isOperationLegalOrPromote(N.getOpcode(), VT, false) {
        return SDValue {};
    }
    if PromoteMaskArithmetic(N0, DL, VT, DAG, Subtarget, Depth + 1) {
        NN0;
    } else {
        N0 = NN0;
    }
    if PromoteMaskArithmetic(N1, DL, VT, DAG, Subtarget, Depth + 1) {
        NN1;
    } else {
        N1 = NN1;
    }
    return DAG.getNode(N.getOpcode(), DL, VT, N0, N1);
}

fn PromoteMaskArithmetic(N: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType();
    assert!(VT.isVector(), "Expected vector type");
    assert!((N.getOpcode() == ANY_EXTEND || N.getOpcode() == ZERO_EXTEND || N.getOpcode() == SIGN_EXTEND), "Invalid Node");
    let mut Narrow: SDValue = N.getOperand(0);
    let mut NarrowVT: EVT = Narrow.getValueType();
    let mut Op: SDValue = PromoteMaskArithmetic(Narrow, DL, VT, DAG, Subtarget, 0);
    if !Op {
        return SDValue {};
    }
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 52680);
        },
        ANY_EXTEND => {
            return Op;
        },
        ZERO_EXTEND => {
            return DAG.getZeroExtendInReg(Op, DL, NarrowVT);
        },
        SIGN_EXTEND => {
            return DAG.getNode(SIGN_EXTEND_INREG, DL, VT, Op, DAG.getValueType(NarrowVT));
        },
    }
}

fn convertIntLogicToFPLogicOpcode(Opcode: u32) -> u32 {
    let mut FPOpcode: u32 = 0;
    match Opcode {
        _ => {
            llvm_unreachable_internal("Unexpected input node for FP logic conversion", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 52695);
        },
        AND => {
            FPOpcode = FAND;
        },
        OR => {
            FPOpcode = FOR;
        },
        XOR => {
            FPOpcode = FXOR;
        },
    }
    return FPOpcode;
}

fn convertIntLogicToFPLogic(Opc: u32, DL: *SDLoc, VT: EVT, N0: SDValue, N1: SDValue, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    assert!((Opc == OR || Opc == AND || Opc == XOR), "Unexpected bit opcode");
    if !((N0.getOpcode() == BITCAST && N1.getOpcode() == BITCAST) || (N0.getOpcode() == SETCC && N1.getOpcode() == SETCC)) {
        return SDValue {};
    }
    let mut N00: SDValue = N0.getOperand(0);
    let mut N10: SDValue = N1.getOperand(0);
    let mut N00Type: EVT = N00.getValueType();
    let mut N10Type: EVT = N10.getValueType();
    if N00Type != N10Type || !((Subtarget.hasSSE1() && N00Type == f32) || (Subtarget.hasSSE2() && N00Type == f64) || (Subtarget.hasFP16() && N00Type == f16)) {
        return SDValue {};
    }
    if N0.getOpcode() == BITCAST && !DCI.isBeforeLegalizeOps() {
        let mut FPOpcode: u32 = convertIntLogicToFPLogicOpcode(Opc);
        let mut FPLogic: SDValue = DAG.getNode(FPOpcode, DL, N00Type, N00, N10);
        return DAG.getBitcast(VT, FPLogic);
    }
    if VT != i1 || N0.getOpcode() != SETCC || !N0.hasOneUse() || !N1.hasOneUse() {
        return SDValue {};
    }
    let mut CC0: CondCode = cast(N0.getOperand(2)).get();
    let mut CC1: CondCode = cast(N1.getOperand(2)).get();
    if !Subtarget.hasAVX() && !(cheapX86FSETCC_SSE(CC0) && cheapX86FSETCC_SSE(CC1)) {
        return SDValue {};
    }
    let mut NumElts: u32 = 128 / N00Type.getSizeInBits().operator unsigned long long();
    let mut VecVT: EVT = getVectorVT(*DAG.getContext(), N00Type, NumElts, false);
    let mut BoolVecVT: EVT = getVectorVT(*DAG.getContext(), i1, NumElts, false);
    let mut ZeroIndex: SDValue = DAG.getVectorIdxConstant(0, DL, false);
    let mut N01: SDValue = N0.getOperand(1);
    let mut N11: SDValue = N1.getOperand(1);
    let mut Vec00: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, N00);
    let mut Vec01: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, N01);
    let mut Vec10: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, N10);
    let mut Vec11: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, N11);
    let mut Setcc0: SDValue = DAG.getSetCC(DL, BoolVecVT, Vec00, Vec01, CC0, SDValue {}, false, None);
    let mut Setcc1: SDValue = DAG.getSetCC(DL, BoolVecVT, Vec10, Vec11, CC1, SDValue {}, false, None);
    let mut Logic: SDValue = DAG.getNode(Opc, DL, BoolVecVT, Setcc0, Setcc1);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Logic, ZeroIndex);
}

fn combineBitOpWithMOVMSK(Opc: u32, DL: *SDLoc, N0: SDValue, N1: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Opc == OR || Opc == AND || Opc == XOR), "Unexpected bit opcode");
    if N0.getOpcode() != MOVMSK || !N0.hasOneUse() || N1.getOpcode() != MOVMSK || !N1.hasOneUse() {
        return SDValue {};
    }
    let mut Vec0: SDValue = N0.getOperand(0);
    let mut Vec1: SDValue = N1.getOperand(0);
    let mut VecVT0: EVT = Vec0.getValueType();
    let mut VecVT1: EVT = Vec1.getValueType();
    if VecVT0.getSizeInBits() != VecVT1.getSizeInBits() || VecVT0.getScalarSizeInBits() != VecVT1.getScalarSizeInBits() {
        return SDValue {};
    }
    let mut VecOpc: u32 = if VecVT0.isFloatingPoint() { convertIntLogicToFPLogicOpcode(Opc) } else { Opc };
    let mut Result: SDValue = DAG.getNode(VecOpc, DL, VecVT0, Vec0, DAG.getBitcast(VecVT0, Vec1));
    return DAG.getNode(MOVMSK, DL, i32, Result);
}

fn combineBitOpWithShift(Opc: u32, DL: *SDLoc, VT: EVT, N0: SDValue, N1: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Opc == OR || Opc == AND || Opc == XOR), "Unexpected bit opcode");
    if !N0.hasOneUse() || !N1.hasOneUse() {
        return SDValue {};
    }
    let mut BC0: SDValue = peekThroughOneUseBitcasts(N0);
    let mut BC1: SDValue = peekThroughOneUseBitcasts(N1);
    let mut BCOpc: u32 = BC0.getOpcode();
    let mut BCVT: EVT = BC0.getValueType();
    if BCOpc != operator(BC1).getOpcode() || BCVT != BC1.getValueType() {
        return SDValue {};
    }
    match BCOpc {
        VSHLI => {
            VSRLI;
        },
    }
    return SDValue {};
}

fn combineBitOpWithPACK(Opc: u32, DL: *SDLoc, VT: EVT, N0: SDValue, N1: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Opc == OR || Opc == AND || Opc == XOR), "Unexpected bit opcode");
    if !N0.hasOneUse() || !N1.hasOneUse() {
        return SDValue {};
    }
    N0 = peekThroughOneUseBitcasts(N0);
    N1 = peekThroughOneUseBitcasts(N1);
    if N0.getOpcode() != PACKSS || N1.getOpcode() != PACKSS {
        return SDValue {};
    }
    let mut DstVT: MVT = N0.getSimpleValueType();
    if DstVT != N1.getSimpleValueType() {
        return SDValue {};
    }
    let mut SrcVT: MVT = N0.getOperand(0).getSimpleValueType();
    let mut NumSrcBits: u32 = SrcVT.getScalarSizeInBits();
    if DAG.ComputeNumSignBits(N0.getOperand(0), 0) != NumSrcBits || DAG.ComputeNumSignBits(N0.getOperand(1), 0) != NumSrcBits || DAG.ComputeNumSignBits(N1.getOperand(0), 0) != NumSrcBits || DAG.ComputeNumSignBits(N1.getOperand(1), 0) != NumSrcBits {
        return SDValue {};
    }
    let mut LHS: SDValue = DAG.getNode(Opc, DL, SrcVT, N0.getOperand(0), N1.getOperand(0));
    let mut RHS: SDValue = DAG.getNode(Opc, DL, SrcVT, N0.getOperand(1), N1.getOperand(1));
    return DAG.getBitcast(VT, DAG.getNode(PACKSS, DL, DstVT, LHS, RHS));
}

fn combineAndMaskToShift(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Op0: SDValue = peekThroughBitcasts(N.getOperand(0));
    let mut Op1: SDValue = peekThroughBitcasts(N.getOperand(1));
    let mut VT: EVT = Op0.getValueType();
    if VT != Op1.getValueType() || !VT.isSimple() || !VT.isInteger() {
        return SDValue {};
    }
    if N.getValueType(0) == VT && supportedVectorShiftWithImm(VT, Subtarget, SRA) {
        let mut X: SDValue = SDValue {};
        let mut Y: SDValue = SDValue {};
        if Op1.getOpcode() == PCMPGT && isAllOnesOrAllOnesSplat(Op1.getOperand(1), false) && Op1.hasOneUse() {
            X = Op1.getOperand(0);
            Y = Op0;
        } else if Op0.getOpcode() == PCMPGT && isAllOnesOrAllOnesSplat(Op0.getOperand(1), false) && Op0.hasOneUse() {
            X = Op0.getOperand(0);
            Y = Op1;
        }
        if X && Y {
            let mut Sra: SDValue = getTargetVShiftByConstNode(VSRAI, DL, VT.getSimpleVT(), X, VT.getScalarSizeInBits() - 1, DAG);
            return DAG.getNode(ANDNP, DL, VT, Sra, Y);
        }
    }
    let mut SplatVal: APInt = APInt {};
    if !isConstantSplat(Op1, SplatVal, false) || !SplatVal.isMask() {
        return SDValue {};
    }
    if isBitwiseNot(Op0, false) {
        return SDValue {};
    }
    if !supportedVectorShiftWithImm(VT, Subtarget, SRL) {
        return SDValue {};
    }
    let mut EltBitWidth: u32 = VT.getScalarSizeInBits();
    if EltBitWidth != DAG.ComputeNumSignBits(Op0, 0) {
        return SDValue {};
    }
    let mut ShiftVal: u32 = EltBitWidth - SplatVal.countr_one();
    let mut Shift: SDValue = getTargetVShiftByConstNode(VSRLI, DL, VT.getSimpleVT(), Op0, ShiftVal, DAG);
    return DAG.getBitcast(N.getValueType(0), Shift);
}

fn combineAndNotOrIntoAndNotAnd(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = N.getSimpleValueType(0);
    if !DAG.getTargetLoweringInfo().hasAndNot(SDValue { Node: N, ResNo: 0 }) {
        return SDValue {};
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut Z: SDValue = SDValue {};
    if sd_match(N, m_And(m_Value(X), m_OneUse(m_Or(m_Value(Y), m_Not(m_Value(Z)))))) {
        if !DAG.isConstantIntBuildVectorOrConstantInt(Y, true) && !DAG.isConstantIntBuildVectorOrConstantInt(Z, true) {
            return DAG.getNode(AND, DL, VT, X, DAG.getNOT(DL, DAG.getNode(AND, DL, VT, DAG.getNOT(DL, Y, VT), Z), VT));
        }
    }
    return SDValue {};
}

fn combineMaskBitOp(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut Opc: u32 = N.getOpcode();
    assert!(isBitwiseLogicOp(Opc), "Unexpected opcode!");
    let mut VT: EVT = N.getValueType(0);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !VT.isVector() || VT.getScalarType() != i1 || !TLI.isTypeLegal(VT) {
        return SDValue {};
    }
    let mut Src0: SDValue = SDValue {};
    let mut Src1: SDValue = SDValue {};
    if sd_match(N, m_BitwiseLogic(m_Trunc(m_Value(Src0)), m_Trunc(m_Value(Src1)))) {
        let mut SrcVT: EVT = Src0.getValueType();
        if SrcVT == Src1.getValueType() && TLI.isOperationLegal(Opc, SrcVT) {
            return DAG.getNode(TRUNCATE, DL, VT, DAG.getNode(Opc, DL, SrcVT, Src0, Src1));
        }
    }
    if sd_match(N, m_And(m_OneUse(m_Not(m_Trunc(m_Value(Src0)))), m_Trunc(m_Value(Src1)))) {
        let mut SrcVT: EVT = Src0.getValueType();
        if SrcVT == Src1.getValueType() && TLI.isOperationLegal(AND, SrcVT) {
            return DAG.getNode(TRUNCATE, DL, VT, DAG.getNode(ANDNP, DL, SrcVT, Src0, Src1));
        }
    }
    return SDValue {};
}

fn combineScalarAndWithMaskSetcc(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(N.getOpcode() == AND, "Unexpected opcode!");
    let mut VT: EVT = N.getValueType(0);
    let mut C1: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !C1 {
        return SDValue {};
    }
    assert!(!VT.isVector(), "Expected scalar VT!");
    let mut Src: SDValue = N.getOperand(0);
    if !Src.hasOneUse() {
        return SDValue {};
    }
    if Src.getOpcode() == ANY_EXTEND {
        if !Src.getOperand(0).hasOneUse() {
            return SDValue {};
        }
        Src = Src.getOperand(0);
    }
    if Src.getOpcode() != BITCAST || !Src.getOperand(0).hasOneUse() {
        return SDValue {};
    }
    Src = Src.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !SrcVT.isVectorOf(i1) || !TLI.isTypeLegal(SrcVT) {
        return SDValue {};
    }
    if Src.getOpcode() != CONCAT_VECTORS {
        return SDValue {};
    }
    let mut SubVec: SDValue = Src.getOperand(0);
    let mut SubVecVT: EVT = SubVec.getValueType();
    if !TLI.isTypeLegal(SubVecVT) || !C1.getAPIntValue().isMask(SubVecVT.getVectorNumElements()) {
        return SDValue {};
    }
    let mut IsLegalSetCC: Closure_203 = Closure_203 { TLI: &mut TLI, Subtarget: &mut Subtarget };
    if !(IsLegalSetCC.call(SubVec) || (SubVec.getOpcode() == AND && (IsLegalSetCC.call(SubVec.getOperand(0)) || IsLegalSetCC.call(SubVec.getOperand(1))))) {
        return SDValue {};
    }
    let mut dl: SDLoc = N;
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { Src.getNumOperands(), DAG.getConstant(0, dl, SubVecVT, false, false) };
    Ops[0] = SubVec;
    let mut Concat: SDValue = DAG.getNode(CONCAT_VECTORS, dl, SrcVT, Ops);
    let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), SrcVT.getSizeInBits().operator unsigned long long());
    return DAG.getZExtOrTrunc(DAG.getBitcast(IntVT, Concat), dl, VT);
}

fn getBMIMatchingOp(Opc: u32, DAG: *mut SelectionDAG, OpMustEq: SDValue, Op: SDValue, Depth: u32) -> SDValue {
    let mut kMaxDepth: u32 = 2;
    if !Op.hasOneUse() {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    if Op.getOpcode() == Opc {
        if Depth += 1 >= kMaxDepth {
            return SDValue {};
        }
        for let mut OpIdx: u32 = 0; OpIdx < 2; OpIdx += 1 {
            if getBMIMatchingOp(Opc, DAG, OpMustEq, Op.getOperand(OpIdx), Depth) {
                R;
            } else {
                return DAG.getNode(Op.getOpcode(), DL, Op.getValueType(), R, Op.getOperand(1 - OpIdx));
            }
        }
    } else if Op.getOpcode() == SUB {
        if Opc == AND {
            if isNullConstant(Op.getOperand(0)) && Op.getOperand(1) == OpMustEq {
                return DAG.getNode(Opc, DL, Op.getValueType(), OpMustEq, Op);
            }
        }
        if isOneConstant(Op.getOperand(1)) && Op.getOperand(0) == OpMustEq {
            return DAG.getNode(Opc, DL, Op.getValueType(), OpMustEq, Op);
        }
    } else if Op.getOpcode() == ADD {
        if isAllOnesConstant(Op.getOperand(1)) && Op.getOperand(0) == OpMustEq {
            return DAG.getNode(Opc, DL, Op.getValueType(), OpMustEq, Op);
        }
    }
    return SDValue {};
}

fn combineBMILogicOp(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !Subtarget.hasBMI() || !VT.isScalarInteger() || (VT != i32 && VT != i64) {
        return SDValue {};
    }
    assert!(N.getOpcode() == AND || N.getOpcode() == XOR);
    for let mut OpIdx: u32 = 0; OpIdx < 2; OpIdx += 1 {
        if getBMIMatchingOp(N.getOpcode(), DAG, N.getOperand(OpIdx), N.getOperand(1 - OpIdx), 0) {
            OpMatch;
        } else {
            return OpMatch;
        }
    }
    return SDValue {};
}

fn combineAndXorSubWithBMI(And: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = And.getValueType(0);
    if !Subtarget.hasBMI() || (VT != i32 && VT != i64) {
        return SDValue {};
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if !sd_match(And, m_And(m_OneUse(m_Xor(m_Value(X), m_OneUse(m_Neg(m_Deferred(X))))), m_Value(Y))) {
        return SDValue {};
    }
    let mut BLSMSK: SDValue = DAG.getNode(XOR, DL, VT, X, DAG.getNode(SUB, DL, VT, X, DAG.getConstant(1, DL, VT, false, false)));
    let mut AndN: SDValue = DAG.getNode(AND, DL, VT, Y, DAG.getNOT(DL, BLSMSK, VT));
    return AndN;
}

fn combineX86SubCmpForFlags(N: *mut SDNode, Flag: SDValue, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, ST: *X86Subtarget) -> SDValue {
    let mut SetCC: SDValue = N.getOperand(0);
    if SetCC.getOpcode() != SETCC || !Flag.hasOneUse() {
        return SDValue {};
    }
    let mut BrCond: *mut SDNode = operator(operator(Flag).user_begin());
    if BrCond.getOpcode() != BRCOND {
        return SDValue {};
    }
    let mut CondNo: u32 = 2;
    if BrCond.getConstantOperandVal(CondNo) as CondCode != COND_NE {
        return SDValue {};
    }
    let mut X: SDValue = SetCC.getOperand(1);
    if N.getOpcode() == SUB {
        X = DAG.getMergeValues([N.getOperand(0), X], N);
    }
    let mut CCN: SDValue = SetCC.getOperand(0);
    let mut CC: CondCode = operator(CCN).getAsAPIntVal().getSExtValue() as CondCode;
    let mut OppositeCC: CondCode = GetOppositeBranchCondition(CC);
    let mut Ops: SmallVector<SDValue> = BrCond.op_values();
    if isNullConstant(N.getOperand(1)) {
        Ops[CondNo] = CCN;
    } else if isOneConstant(N.getOperand(1)) {
        Ops[CondNo] = DAG.getTargetConstant(OppositeCC, BrCond, i8, false);
    } else {
        llvm_unreachable_internal("expect constant 0 or 1", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 53221);
    }
    let mut NewBrCond: SDValue = DAG.getNode(BRCOND, BrCond, BrCond.getValueType(0), Ops);
    if BrCond != NewBrCond.getNode() {
        DCI.CombineTo(BrCond, NewBrCond, true);
    }
    return X;
}

fn combineAndOrForCcmpCtest(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, ST: *X86Subtarget) -> SDValue {
    if !ST.hasCCMP() {
        return SDValue {};
    }
    let mut SetCC0: SDValue = N.getOperand(0);
    let mut SetCC1: SDValue = N.getOperand(1);
    if SetCC0.getOpcode() != SETCC || SetCC1.getOpcode() != SETCC {
        return SDValue {};
    }
    let mut GetCombineToOpc: Closure_204 = Closure_204 {};
    let mut NewOpc: u32 = 0;
    if !(NewOpc = GetCombineToOpc.call(SetCC1)) {
        swap(SetCC0, SetCC1);
        if !(NewOpc = GetCombineToOpc.call(SetCC1)) {
            return SDValue {};
        }
    }
    let mut CC0: CondCode = SetCC0.getConstantOperandVal(0) as CondCode;
    if CC0 == COND_P || CC0 == COND_NP {
        return SDValue {};
    }
    let mut IsOR: bool = N.getOpcode() == OR;
    let mut SrcCC: SDValue = if IsOR { DAG.getTargetConstant(GetOppositeBranchCondition(CC0), SetCC0.getOperand(0), i8, false) } else { SetCC0.getOperand(0) };
    let mut CC1N: SDValue = SetCC1.getOperand(0);
    let mut CC1: CondCode = operator(CC1N).getAsAPIntVal().getSExtValue() as CondCode;
    let mut OppositeCC1: CondCode = GetOppositeBranchCondition(CC1);
    let mut CFlagsCC: CondCode = if IsOR { CC1 } else { OppositeCC1 };
    let mut DL: SDLoc = N;
    let mut CFlags: SDValue = DAG.getTargetConstant(getCCMPCondFlagsFromCondCode(CFlagsCC), DL, i8, false);
    let mut Sub: SDValue = SetCC1.getOperand(1);
    let mut CCMP: SDValue = if (NewOpc == CCMP) { DAG.getNode(CCMP, DL, i32, [Sub.getOperand(0), Sub.getOperand(1), CFlags, SrcCC, SetCC0.getOperand(1)]) } else { DAG.getNode(CTEST, DL, i32, [Sub.getOperand(0), Sub.getOperand(0), CFlags, SrcCC, SetCC0.getOperand(1)]) };
    return DAG.getNode(SETCC, DL, i8, [CC1N, CCMP]);
}

fn combineAnd(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = N;
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if Subtarget.hasSSE1() && !Subtarget.hasSSE2() && VT == v4i32 {
        return DAG.getBitcast(v4i32, DAG.getNode(FAND, dl, v4f32, DAG.getBitcast(v4f32, N0), DAG.getBitcast(v4f32, N1)));
    }
    if VT == i64 && Subtarget.is64Bit() && !isa(N1) {
        let mut HiMask: APInt = getHighBitsSet(64, 32);
        if DAG.MaskedValueIsZero(N1, HiMask, 0) || DAG.MaskedValueIsZero(N0, HiMask, 0) {
            let mut LHS: SDValue = DAG.getNode(TRUNCATE, dl, i32, N0);
            let mut RHS: SDValue = DAG.getNode(TRUNCATE, dl, i32, N1);
            return DAG.getNode(ZERO_EXTEND, dl, i64, DAG.getNode(AND, dl, i32, LHS, RHS));
        }
    }
    if VT == i1 {
        let mut SrcOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
        let mut SrcPartials: SmallVector<APInt, 2> = SmallVector<APInt, 2> {};
        if matchScalarReduction(SDValue { Node: N, ResNo: 0 }, AND, SrcOps, &mut SrcPartials) && SrcOps.len == 1 {
            let mut NumElts: u32 = SrcOps[0].getValueType().getVectorNumElements();
            let mut MaskVT: EVT = getIntegerVT(*DAG.getContext(), NumElts);
            let mut Mask: SDValue = combineBitcastvxi1(DAG, MaskVT, SrcOps[0], dl, Subtarget);
            if !Mask && TLI.isTypeLegal(SrcOps[0].getValueType()) {
                Mask = DAG.getBitcast(MaskVT, SrcOps[0]);
            }
            if Mask {
                assert!(SrcPartials[0].getBitWidth() == NumElts, "Unexpected partial reduction mask");
                let mut PartialBits: SDValue = DAG.getConstant(SrcPartials[0], dl, MaskVT, false, false);
                Mask = DAG.getNode(AND, dl, MaskVT, Mask, PartialBits);
                return DAG.getSetCC(dl, i1, Mask, PartialBits, SETEQ, SDValue {}, false, None);
            }
        }
    }
    if N0.getOpcode() == MUL && N0.hasOneUse() {
        let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, true, false);
        let mut N01C: *mut ConstantSDNode = isConstOrConstSplat(N0.getOperand(1), true, false);
        if N1C && N01C {
            let mut MulC: *APInt = N01C.getAPIntValue();
            let mut AndC: *APInt = N1C.getAPIntValue();
            let mut MulCLowBit: APInt = MulC & (operator(MulC));
            if MulC.uge(AndC) && !MulC.isPowerOf2() && (MulCLowBit + MulC).isPowerOf2() {
                let mut Neg: SDValue = DAG.getNegative(N0.getOperand(0), dl, VT);
                let mut MulCLowBitLog: i32 = MulCLowBit.exactLogBase2();
                assert!(MulCLowBitLog != -1, "Isolated lowbit is somehow not a power of 2!");
                let mut Shift: SDValue = DAG.getNode(SHL, dl, VT, Neg, DAG.getConstant(MulCLowBitLog, dl, VT, false, false));
                return DAG.getNode(AND, dl, VT, Shift, N1);
            }
        }
    }
    if combineAndOrForCcmpCtest(N, DAG, DCI, Subtarget) {
        SetCC;
    } else {
        return SetCC;
    }
    if combineScalarAndWithMaskSetcc(N, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if combineMaskBitOp(N, dl, DAG) {
        R;
    } else {
        return R;
    }
    if combineBitOpWithMOVMSK(N.getOpcode(), dl, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if combineBitOpWithShift(N.getOpcode(), dl, VT, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if combineBitOpWithPACK(N.getOpcode(), dl, VT, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if convertIntLogicToFPLogic(N.getOpcode(), dl, VT, N0, N1, DAG, DCI, Subtarget) {
        FPLogic;
    } else {
        return FPLogic;
    }
    if combineAndShuffleNot(N, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    if DCI.isBeforeLegalize() {
        if combineI8AndNotIntoI32AndNot(N, dl, DAG, Subtarget) {
            R;
        } else {
            return R;
        }
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if combineCompareEqual(N, DAG, DCI, Subtarget) {
        R;
    } else {
        return R;
    }
    if combineAndNotIntoANDNP(N, dl, DAG) {
        R;
    } else {
        return R;
    }
    if combineAndMaskToShift(N, dl, DAG, Subtarget) {
        ShiftRight;
    } else {
        return ShiftRight;
    }
    if combineAndNotOrIntoAndNotAnd(N, dl, DAG) {
        R;
    } else {
        return R;
    }
    if VT.isVector() && getTargetConstantFromNode(N1) {
        let mut Opc0: u32 = N0.getOpcode();
        if (Opc0 == MUL || Opc0 == MULHU || Opc0 == MULHS) && getTargetConstantFromNode(N0.getOperand(1)) && DAG.ComputeNumSignBits(N1, 0) == VT.getScalarSizeInBits() && operator(N0).hasOneUse() && operator(N0.getOperand(1)).hasOneUse() {
            let mut MaskMul: SDValue = DAG.getNode(AND, dl, VT, N0.getOperand(1), N1);
            return DAG.getNode(Opc0, dl, VT, N0.getOperand(0), MaskMul);
        }
    }
    if DCI.isAfterLegalizeDAG() && VT.isVector() {
        let mut X: SDValue = SDValue {};
        let mut Y: SDValue = SDValue {};
        let mut CondVT: EVT = VT.changeVectorElementType(*DAG.getContext(), i1);
        if TLI.isTypeLegal(VT) && TLI.isTypeLegal(CondVT) && (VT.is512BitVector() || Subtarget.hasVLX()) && (VT.getScalarSizeInBits() >= 32 || Subtarget.hasBWI()) && sd_match(N, m_And(m_Value(X), m_OneUse(m_SExt(m_Value(Y, m_SpecificVT(CondVT, m_SpecificOpc(SETCC))))))) {
            return DAG.getSelect(dl, VT, Y, X, getZeroVector(VT.getSimpleVT(), Subtarget, DAG, dl), SDNodeFlags { Flags: None });
        }
    }
    if isOneConstant(N1) && operator(N0).hasOneUse() {
        let mut Src: SDValue = N0;
        while (Src.getOpcode() == ZERO_EXTEND || Src.getOpcode() == TRUNCATE) && operator(Src.getOperand(0)).hasOneUse() {
            Src = Src.getOperand(0);
        }
        let mut ContainsNOT: bool = false;
        let mut X86CC: CondCode = COND_B;
        if isBitwiseNot(Src, false) {
            Src = Src.getOperand(0);
            X86CC = COND_AE;
            ContainsNOT = true;
        }
        if Src.getOpcode() == SRL && !isa(Src.getOperand(1)) {
            let mut BitNo: SDValue = Src.getOperand(1);
            Src = Src.getOperand(0);
            if isBitwiseNot(Src, false) {
                Src = Src.getOperand(0);
                X86CC = if X86CC == COND_AE { COND_B } else { COND_AE };
                ContainsNOT = true;
            }
            if !(Subtarget.hasBMI2() && !ContainsNOT && VT.getSizeInBits().operator unsigned long long() >= 32) {
                if getBT(Src, BitNo, dl, DAG) {
                    BT;
                } else {
                    return DAG.getZExtOrTrunc(getSETCC(X86CC, BT, dl, DAG), dl, VT);
                }
            }
        }
    }
    if VT.isVector() && (VT.getScalarSizeInBits() % 8) == 0 {
        let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
        if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
            Res;
        } else {
            return Res;
        }
        let mut GetDemandedMasks: Closure_205 = Closure_205 { VT: &mut VT };
        let mut Bits0: APInt = APInt {};
        let mut Elts0: APInt = APInt {};
        let mut Bits1: APInt = APInt {};
        let mut Elts1: APInt = APInt {};
        tie(Bits0, Elts0) = GetDemandedMasks.call(N1);
        tie(Bits1, Elts1) = GetDemandedMasks.call(N0);
        if TLI.SimplifyDemandedVectorElts(N0, Elts0, DCI) || TLI.SimplifyDemandedVectorElts(N1, Elts1, DCI) || TLI.SimplifyDemandedBits(N0, Bits0, Elts0, DCI) || TLI.SimplifyDemandedBits(N1, Bits1, Elts1, DCI) {
            if N.getOpcode() != DELETED_NODE {
                DCI.AddToWorklist(N);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
        let mut NewN0: SDValue = TLI.SimplifyMultipleUseDemandedBits(N0, Bits0, Elts0, DAG, 0);
        let mut NewN1: SDValue = TLI.SimplifyMultipleUseDemandedBits(N1, Bits1, Elts1, DAG, 0);
        if NewN0 || NewN1 {
            return DAG.getNode(AND, dl, VT, if NewN0 { NewN0 } else { N0 }, if NewN1 { NewN1 } else { N1 });
        }
    }
    if (VT.getScalarSizeInBits() % 8) == 0 && N0.getOpcode() == EXTRACT_VECTOR_ELT && isa(N0.getOperand(1)) && operator(N0).hasOneUse() {
        let mut BitMask: SDValue = N1;
        let mut SrcVec: SDValue = N0.getOperand(0);
        let mut SrcVecVT: EVT = SrcVec.getValueType();
        let mut UndefElts: APInt = APInt {};
        let mut EltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> {};
        if VT == SrcVecVT.getScalarType() && operator(N0).isOnlyUserOf(SrcVec.getNode()) && getTargetConstantBitsFromNode(BitMask, 8, UndefElts, EltBits, true, false) && all_of(EltBits, Closure_206 {}) {
            let mut NumElts: u32 = SrcVecVT.getVectorNumElements();
            let mut Scale: u32 = SrcVecVT.getScalarSizeInBits() / 8;
            let mut Idx: u32 = N0.getConstantOperandVal(1);
            let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> { NumElts * Scale, SM_SentinelUndef };
            for let mut i: u32 = 0; i != Scale; i += 1 {
                if UndefElts[i] {
                    continue;
                }
                let mut VecIdx: i32 = Scale * Idx + i;
                ShuffleMask[VecIdx] = if EltBits[i].isZero() { SM_SentinelZero } else { VecIdx };
            }
            if combineX86ShufflesRecursively([SrcVec], 0, SrcVec.getOpcode(), SrcVec.getSimpleValueType(), ShuffleMask, ArrayRef<const SDNode *> {}, 1, MaxShuffleCombineDepth, true, true, false, DAG, SrcVec, Subtarget) {
                Shuffle;
            } else {
                return DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT, Shuffle, N0.getOperand(1));
            }
        }
    }
    if combineBMILogicOp(N, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    if combineAndXorSubWithBMI(N, dl, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn canonicalizeBitSelect(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(N.getOpcode() == OR, "Unexpected Opcode");
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    if !VT.isVector() || (EltSizeInBits % 8) != 0 {
        return SDValue {};
    }
    let mut N0: SDValue = peekThroughBitcasts(N.getOperand(0));
    let mut N1: SDValue = peekThroughBitcasts(N.getOperand(1));
    if N0.getOpcode() != AND || N1.getOpcode() != AND {
        return SDValue {};
    }
    if !(Subtarget.hasXOP() || useVPTERNLOG(Subtarget, VT) || !N0.getOperand(1).hasOneUse() || !N1.getOperand(1).hasOneUse()) {
        return SDValue {};
    }
    let mut UndefElts0: APInt = APInt {};
    let mut UndefElts1: APInt = APInt {};
    let mut EltBits0: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
    let mut EltBits1: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
    if !getTargetConstantBitsFromNode(N0.getOperand(1), 8, UndefElts0, EltBits0, false, false) {
        return SDValue {};
    }
    if !getTargetConstantBitsFromNode(N1.getOperand(1), 8, UndefElts1, EltBits1, false, false) {
        return SDValue {};
    }
    for let mut i: u32 = 0;
let mut e: u32 = EltBits0.len; i != e; i += 1 {
        if UndefElts0[i] || UndefElts1[i] {
            return SDValue {};
        }
        if EltBits0[i] != operator(EltBits1[i]) {
            return SDValue {};
        }
    }
    if useVPTERNLOG(Subtarget, VT) {
        let mut OpSVT: MVT = if EltSizeInBits <= 32 { i32 } else { i64 };
        let mut OpVT: MVT = getVectorVT(OpSVT, VT.getSizeInBits().operator unsigned long long() / OpSVT.getSizeInBits().operator unsigned long long());
        let mut A: SDValue = DAG.getBitcast(OpVT, N0.getOperand(1));
        let mut B: SDValue = DAG.getBitcast(OpVT, N0.getOperand(0));
        let mut C: SDValue = DAG.getBitcast(OpVT, N1.getOperand(0));
        let mut Imm: SDValue = DAG.getTargetConstant(202, DL, i8, false);
        let mut Res: SDValue = getAVX512Node(VPTERNLOG, DL, OpVT, [A, B, C, Imm], DAG, Subtarget);
        return DAG.getBitcast(VT, Res);
    }
    let mut X: SDValue = N.getOperand(0);
    let mut Y: SDValue = DAG.getNode(ANDNP, DL, VT, DAG.getBitcast(VT, N0.getOperand(1)), DAG.getBitcast(VT, N1.getOperand(0)));
    return DAG.getNode(OR, DL, VT, X, Y);
}

fn matchLogicBlend(N: *mut SDNode, X: *mut SDValue, Y: *mut SDValue, Mask: *mut SDValue) -> bool {
    return sd_match(N, m_Or(m_BinOp(ANDNP, m_Value(Mask), m_Value(X), SDNodeFlags { Flags: None }), m_And(m_Deferred(Mask), m_Value(Y))));
}

fn combineLogicBlendIntoPBLENDV(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(N.getOpcode() == OR, "Unexpected Opcode");
    let mut VT: EVT = N.getValueType(0);
    if !((VT.is128BitVector() && Subtarget.hasSSE2()) || (VT.is256BitVector() && Subtarget.hasInt256())) {
        return SDValue {};
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut Mask: SDValue = SDValue {};
    if !matchLogicBlend(N, X, Y, Mask) {
        return SDValue {};
    }
    Mask = peekThroughBitcasts(Mask);
    X = peekThroughBitcasts(X);
    Y = peekThroughBitcasts(Y);
    let mut MaskVT: EVT = Mask.getValueType();
    let mut EltBits: u32 = MaskVT.getScalarSizeInBits();
    if !MaskVT.isInteger() || DAG.ComputeNumSignBits(Mask, 0) != EltBits {
        return SDValue {};
    }
    if combineLogicBlendIntoConditionalNegate(VT, Mask, X, Y, DL, DAG, Subtarget) {
        Res;
    } else {
        return Res;
    }
    if !Subtarget.hasSSE41() {
        return SDValue {};
    }
    if Subtarget.hasVLX() {
        return SDValue {};
    }
    let mut BlendVT: MVT = if VT.is256BitVector() { v32i8 } else { v16i8 };
    X = DAG.getBitcast(BlendVT, X);
    Y = DAG.getBitcast(BlendVT, Y);
    Mask = DAG.getBitcast(BlendVT, Mask);
    Mask = DAG.getSelect(DL, BlendVT, Mask, Y, X, SDNodeFlags { Flags: None });
    return DAG.getBitcast(VT, Mask);
}

fn lowerX86CmpEqZeroToCtlzSrl(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Cmp: SDValue = Op.getOperand(1);
    let mut VT: EVT = Cmp.getOperand(0).getValueType();
    let mut Log2b: u32 = Log2_32(VT.getSizeInBits().operator unsigned long long());
    let mut dl: SDLoc = Op;
    let mut Clz: SDValue = DAG.getNode(CTLZ, dl, VT, operator(Cmp).getOperand(0));
    let mut Trunc: SDValue = DAG.getZExtOrTrunc(Clz, dl, i32);
    let mut Scc: SDValue = DAG.getNode(SRL, dl, i32, Trunc, DAG.getConstant(Log2b, dl, i8, false, false));
    return Scc;
}

fn combineOrCmpEqZeroToCtlzSrl(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if DCI.isBeforeLegalize() || !Subtarget.getTargetLowering().isCtlzFast() {
        return SDValue {};
    }
    let mut isORCandidate: Closure_207 = Closure_207 {};
    if !N.hasOneUse() || !N.getSimpleValueType(0).bitsGE(i32) || !isORCandidate.call(N.getOperand(0)) {
        return SDValue {};
    }
    let mut isSetCCCandidate: Closure_208 = Closure_208 {};
    let mut OR: *mut SDNode = N.getOperand(0).getNode();
    let mut LHS: SDValue = OR.getOperand(0);
    let mut RHS: SDValue = OR.getOperand(1);
    let mut ORNodes: SmallVector<SDNode *, 2> = SmallVector<SDNode *, 2> {};
    while ((isORCandidate.call(LHS) && isSetCCCandidate.call(RHS)) || (isORCandidate.call(RHS) && isSetCCCandidate.call(LHS))) {
        ORNodes.push(OR);
        OR = if (operator(LHS).getOpcode() == OR) { LHS.getNode() } else { RHS.getNode() };
        LHS = OR.getOperand(0);
        RHS = OR.getOperand(1);
    }
    if !(isSetCCCandidate.call(LHS) && isSetCCCandidate.call(RHS)) || !isORCandidate.call(SDValue { Node: OR, ResNo: 0 }) {
        return SDValue {};
    }
    let mut NewLHS: SDValue = lowerX86CmpEqZeroToCtlzSrl(LHS, DAG);
    let mut Ret: SDValue = SDValue {};
    let mut NewRHS: SDValue = SDValue {};
    if NewLHS && (NewRHS = lowerX86CmpEqZeroToCtlzSrl(RHS, DAG)) {
        Ret = DAG.getNode(OR, OR, i32, NewLHS, NewRHS);
    }
    if !Ret {
        return SDValue {};
    }
    while !ORNodes.is_empty() {
        OR = ORNodes.pop_back_val();
        LHS = OR.getOperand(0);
        RHS = OR.getOperand(1);
        if operator(RHS).getOpcode() == OR {
            swap(LHS, RHS);
        }
        NewRHS = lowerX86CmpEqZeroToCtlzSrl(RHS, DAG);
        if !NewRHS {
            return SDValue {};
        }
        Ret = DAG.getNode(OR, OR, i32, Ret, NewRHS);
    }
    return DAG.getNode(ZERO_EXTEND, N, N.getValueType(0), Ret);
}

fn combineAddOrSubToADCOrSBB(IsSub: bool, DL: *SDLoc, VT: EVT, X: SDValue, Y: SDValue, DAG: *mut SelectionDAG, ZeroSecondOpOnly: bool, FlagsUsed: bool) -> SDValue {
    if !DAG.getTargetLoweringInfo().isTypeLegal(VT) {
        return SDValue {};
    }
    if Y.getOpcode() == ZERO_EXTEND && Y.hasOneUse() {
        Y = Y.getOperand(0);
    }
    let mut CC: CondCode = zeroed();
    let mut EFLAGS: SDValue = SDValue {};
    if Y.getOpcode() == SETCC && Y.hasOneUse() {
        CC = Y.getConstantOperandVal(0) as CondCode;
        EFLAGS = Y.getOperand(1);
    } else if Y.getOpcode() == AND && isOneConstant(Y.getOperand(1)) && Y.hasOneUse() {
        EFLAGS = LowerAndToBT(Y, SETNE, DL, DAG, CC);
    }
    if !EFLAGS {
        return SDValue {};
    }
    let mut ConstantX: *mut ConstantSDNode = dyn_cast(X);
    if ConstantX && !ZeroSecondOpOnly {
        if (!IsSub && CC == COND_AE && ConstantX.isAllOnes()) || (IsSub && CC == COND_B && ConstantX.isZero()) {
            return DAG.getNode(SETCC_CARRY, DL, VT, DAG.getTargetConstant(COND_B, DL, i8, false), EFLAGS);
        }
        if (!IsSub && CC == COND_BE && ConstantX.isAllOnes()) || (IsSub && CC == COND_A && ConstantX.isZero()) {
            if EFLAGS.getOpcode() == SUB && EFLAGS.hasOneUse() && EFLAGS.getValueType().isInteger() && !isa(EFLAGS.getOperand(1)) {
                let mut NewSub: SDValue = DAG.getNode(SUB, EFLAGS, EFLAGS.getNode().getVTList(), EFLAGS.getOperand(1), EFLAGS.getOperand(0));
                let mut NewEFLAGS: SDValue = SDValue { Node: NewSub.getNode(), ResNo: EFLAGS.getResNo() };
                return DAG.getNode(SETCC_CARRY, DL, VT, DAG.getTargetConstant(COND_B, DL, i8, false), NewEFLAGS);
            }
        }
    }
    if CC == COND_B {
        return DAG.getNode(if IsSub { SBB } else { ADC }, DL, DAG.getVTList(VT, i32), X, DAG.getConstant(0, DL, VT, false, false), EFLAGS);
    }
    if !IsSub && CC == COND_O && !FlagsUsed && (VT == i8 || VT == i16 || VT == i32 || VT == i64) && DAG.getSubtarget().hasADX() {
        let mut AdoxVT: EVT = if (VT == i8 || VT == i16) { i32 } else { VT };
        let mut AdoxX: SDValue = DAG.getAnyExtOrTrunc(X, DL, AdoxVT);
        let mut Adox: SDValue = DAG.getNode(ADOX, DL, DAG.getVTList(AdoxVT, i32), AdoxX, DAG.getConstant(0, DL, AdoxVT, false, false), EFLAGS);
        return DAG.getAnyExtOrTrunc(Adox, DL, VT);
    }
    if ZeroSecondOpOnly {
        return SDValue {};
    }
    if CC == COND_A {
        if EFLAGS.getOpcode() == CMP && EFLAGS.getValueType().isInteger() && X == EFLAGS.getOperand(0) {
            return DAG.getNode(if IsSub { SBB } else { ADC }, DL, DAG.getVTList(VT, i32), X, DAG.getConstant(0, DL, VT, false, false), EFLAGS);
        }
        if EFLAGS.getOpcode() == SUB && EFLAGS.getValueType().isInteger() && !isa(EFLAGS.getOperand(1)) {
            if EFLAGS.getNode().hasOneUse() {
                let mut NewSub: SDValue = DAG.getNode(SUB, EFLAGS, EFLAGS.getNode().getVTList(), EFLAGS.getOperand(1), EFLAGS.getOperand(0));
                let mut NewEFLAGS: SDValue = NewSub.getValue(EFLAGS.getResNo());
                return DAG.getNode(if IsSub { SBB } else { ADC }, DL, DAG.getVTList(VT, i32), X, DAG.getConstant(0, DL, VT, false, false), NewEFLAGS);
            }
            if IsSub && X == EFLAGS.getValue(0) {
                let mut NewSub: SDValue = DAG.getNode(SUB, EFLAGS, EFLAGS.getNode().getVTList(), EFLAGS.getOperand(1), EFLAGS.getOperand(0));
                let mut NewEFLAGS: SDValue = NewSub.getValue(EFLAGS.getResNo());
                return DAG.getNode(SBB, DL, DAG.getVTList(VT, i32), EFLAGS.getOperand(0), EFLAGS.getOperand(1), NewEFLAGS);
            }
        }
    }
    if CC == COND_AE {
        return DAG.getNode(if IsSub { ADC } else { SBB }, DL, DAG.getVTList(VT, i32), X, DAG.getAllOnesConstant(DL, VT, false, false), EFLAGS);
    }
    if CC == COND_BE {
        if EFLAGS.getOpcode() == SUB && EFLAGS.getNode().hasOneUse() && EFLAGS.getValueType().isInteger() && !isa(EFLAGS.getOperand(1)) {
            let mut NewSub: SDValue = DAG.getNode(SUB, EFLAGS, EFLAGS.getNode().getVTList(), EFLAGS.getOperand(1), EFLAGS.getOperand(0));
            let mut NewEFLAGS: SDValue = NewSub.getValue(EFLAGS.getResNo());
            return DAG.getNode(if IsSub { ADC } else { SBB }, DL, DAG.getVTList(VT, i32), X, DAG.getAllOnesConstant(DL, VT, false, false), NewEFLAGS);
        }
    }
    if CC != COND_E && CC != COND_NE {
        return SDValue {};
    }
    if EFLAGS.getOpcode() != CMP || !EFLAGS.hasOneUse() || !isZeroNode(EFLAGS.getOperand(1)) || !EFLAGS.getOperand(0).getValueType().isInteger() {
        return SDValue {};
    }
    let mut Z: SDValue = EFLAGS.getOperand(0);
    let mut ZVT: EVT = Z.getValueType();
    if ConstantX {
        if (IsSub && CC == COND_NE && ConstantX.isZero()) || (!IsSub && CC == COND_E && ConstantX.isAllOnes()) {
            let mut Zero: SDValue = DAG.getConstant(0, DL, ZVT, false, false);
            let mut X86SubVTs: SDVTList = DAG.getVTList(ZVT, i32);
            let mut Neg: SDValue = DAG.getNode(SUB, DL, X86SubVTs, Zero, Z);
            return DAG.getNode(SETCC_CARRY, DL, VT, DAG.getTargetConstant(COND_B, DL, i8, false), SDValue { Node: Neg.getNode(), ResNo: 1 });
        }
        if (IsSub && CC == COND_E && ConstantX.isZero()) || (!IsSub && CC == COND_NE && ConstantX.isAllOnes()) {
            let mut One: SDValue = DAG.getConstant(1, DL, ZVT, false, false);
            let mut X86SubVTs: SDVTList = DAG.getVTList(ZVT, i32);
            let mut Cmp1: SDValue = DAG.getNode(SUB, DL, X86SubVTs, Z, One);
            return DAG.getNode(SETCC_CARRY, DL, VT, DAG.getTargetConstant(COND_B, DL, i8, false), Cmp1.getValue(1));
        }
    }
    let mut One: SDValue = DAG.getConstant(1, DL, ZVT, false, false);
    let mut X86SubVTs: SDVTList = DAG.getVTList(ZVT, i32);
    let mut Cmp1: SDValue = DAG.getNode(SUB, DL, X86SubVTs, Z, One);
    let mut VTs: SDVTList = DAG.getVTList(VT, i32);
    if CC == COND_NE {
        return DAG.getNode(if IsSub { ADC } else { SBB }, DL, VTs, X, DAG.getAllOnesConstant(DL, VT, false, false), Cmp1.getValue(1));
    }
    return DAG.getNode(if IsSub { SBB } else { ADC }, DL, VTs, X, DAG.getConstant(0, DL, VT, false, false), Cmp1.getValue(1));
}

fn combineAddOrSubToADCOrSBB(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsSub: bool = N.getOpcode() == SUB;
    let mut X: SDValue = N.getOperand(0);
    let mut Y: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    if N.getOpcode() == OR && !N.getFlags().hasDisjoint() {
        return SDValue {};
    }
    if combineAddOrSubToADCOrSBB(IsSub, DL, VT, X, Y, DAG, false, false) {
        ADCOrSBB;
    } else {
        return ADCOrSBB;
    }
    if combineAddOrSubToADCOrSBB(IsSub, DL, VT, Y, X, DAG, false, false) {
        ADCOrSBB;
    } else {
        if IsSub {
            ADCOrSBB = DAG.getNegative(ADCOrSBB, DL, VT);
        }
        return ADCOrSBB;
    }
    return SDValue {};
}

fn combineOrWithGF2P8AFFINEQB(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, VT: EVT) -> SDValue {
    assert!(N.getOpcode() == OR, "Expected OR node");
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut X: SDValue = SDValue {};
    let mut Matrix: SDValue = SDValue {};
    let mut SplatOp: SDValue = SDValue {};
    let mut Imm: APInt = APInt {};
    if !sd_match(N, m_Or(m_OneUse(m_TernaryOp(GF2P8AFFINEQB, m_Value(X), m_Value(Matrix), m_ConstInt(Imm))), m_Value(SplatOp))) {
        return SDValue {};
    }
    let mut SplatVal: APInt = APInt {};
    if !isConstantSplat(SplatOp, SplatVal, false) {
        return SDValue {};
    }
    if N.getFlags().hasDisjoint() || DAG.haveNoCommonBitsSet(LHS, RHS) {
        let mut NewImm: u64 = (Imm.getZExtValue() ^ SplatVal.getZExtValue()) & 255;
        return DAG.getNode(GF2P8AFFINEQB, DL, VT, X, Matrix, DAG.getTargetConstant(NewImm, DL, i8, false));
    }
    let mut UndefElts: APInt = APInt {};
    let mut OldMatrix: SmallVector<APInt, 16> = SmallVector<APInt, 16> {};
    if !getTargetConstantBitsFromNode(Matrix, 8, UndefElts, OldMatrix, false, false) {
        return SDValue {};
    }
    let mut Mask8: u8 = SplatVal.getZExtValue() & 255;
    let mut NewImm: u8 = Imm.getZExtValue() | Mask8;
    let mut NewMatrixOps: SmallVector<SDValue, 64> = SmallVector<SDValue, 64> {};
    for let mut I: u32 = 0;
let mut E: u32 = VT.getVectorNumElements(); I != E; I += 1 {
        let mut OutBit: u32 = 7 - (I & 7);
        let mut OldRow: u8 = OldMatrix[I].getZExtValue();
        let mut NewRow: u8 = if ((Mask8 >> OutBit) & 1) { 0 } else { OldRow };
        NewMatrixOps.push(DAG.getConstant(NewRow, DL, i8, false, false));
    }
    let mut NewMatrix: SDValue = DAG.getBuildVector(VT, DL, NewMatrixOps);
    let mut NewGF: SDValue = DAG.getNode(GF2P8AFFINEQB, DL, VT, X, NewMatrix, DAG.getTargetConstant(NewImm, DL, i8, false));
    return NewGF;
}

fn combineOrXorWithSETCC(Opc: u32, DL: *SDLoc, VT: EVT, N0: SDValue, N1: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Opc == XOR || Opc == OR), "Unexpected opcode");
    if N0.getOpcode() == ZERO_EXTEND && N0.getOperand(0).getOpcode() == SETCC && N0.hasOneUse() {
        if dyn_cast(N1) {
            N1C;
        } else {
            let mut IsSub: bool = Opc == XOR;
            let mut N1COdd: bool = N1C.getZExtValue() & 1;
            if if IsSub { N1COdd } else { !N1COdd } {
                if combineAddOrSubToADCOrSBB(IsSub, DL, VT, N1, N0, DAG, false, false) {
                    R;
                } else {
                    return R;
                }
            }
        }
    }
    if Opc == XOR && N0.getOpcode() == PCMPEQ && N0.getOperand(0).getOpcode() == AND && isBuildVectorAllZeros(N0.getOperand(1).getNode()) && isBuildVectorAllOnes(N1.getNode()) && isConstantPowerOf2(N0.getOperand(0).getOperand(1), VT.getScalarSizeInBits(), true) {
        return DAG.getNode(PCMPEQ, DL, VT, N0.getOperand(0), N0.getOperand(0).getOperand(1));
    }
    return SDValue {};
}

fn combineOr(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = N;
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if Subtarget.hasSSE1() && !Subtarget.hasSSE2() && VT == v4i32 {
        return DAG.getBitcast(v4i32, DAG.getNode(FOR, dl, v4f32, DAG.getBitcast(v4f32, N0), DAG.getBitcast(v4f32, N1)));
    }
    if VT == i1 {
        let mut SrcOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
        let mut SrcPartials: SmallVector<APInt, 2> = SmallVector<APInt, 2> {};
        if matchScalarReduction(SDValue { Node: N, ResNo: 0 }, OR, SrcOps, &mut SrcPartials) && SrcOps.len == 1 {
            let mut NumElts: u32 = SrcOps[0].getValueType().getVectorNumElements();
            let mut MaskVT: EVT = getIntegerVT(*DAG.getContext(), NumElts);
            let mut Mask: SDValue = combineBitcastvxi1(DAG, MaskVT, SrcOps[0], dl, Subtarget);
            if !Mask && TLI.isTypeLegal(SrcOps[0].getValueType()) {
                Mask = DAG.getBitcast(MaskVT, SrcOps[0]);
            }
            if Mask {
                assert!(SrcPartials[0].getBitWidth() == NumElts, "Unexpected partial reduction mask");
                let mut ZeroBits: SDValue = DAG.getConstant(0, dl, MaskVT, false, false);
                let mut PartialBits: SDValue = DAG.getConstant(SrcPartials[0], dl, MaskVT, false, false);
                Mask = DAG.getNode(AND, dl, MaskVT, Mask, PartialBits);
                return DAG.getSetCC(dl, i1, Mask, ZeroBits, SETNE, SDValue {}, false, None);
            }
        }
    }
    if combineAndOrForCcmpCtest(N, DAG, DCI, Subtarget) {
        SetCC;
    } else {
        return SetCC;
    }
    if combineMaskBitOp(N, dl, DAG) {
        R;
    } else {
        return R;
    }
    if combineBitOpWithMOVMSK(N.getOpcode(), dl, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if combineBitOpWithShift(N.getOpcode(), dl, VT, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if combineBitOpWithPACK(N.getOpcode(), dl, VT, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if convertIntLogicToFPLogic(N.getOpcode(), dl, VT, N0, N1, DAG, DCI, Subtarget) {
        FPLogic;
    } else {
        return FPLogic;
    }
    if combineOrWithGF2P8AFFINEQB(N, dl, DAG, VT) {
        R;
    } else {
        return R;
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if combineCompareEqual(N, DAG, DCI, Subtarget) {
        R;
    } else {
        return R;
    }
    if canonicalizeBitSelect(N, dl, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    if combineLogicBlendIntoPBLENDV(N, dl, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    if (VT == i32 || VT == i64) && N0.hasOneUse() {
        if dyn_cast(N1) {
            CN;
        } else {
            let mut Val: u64 = CN.getZExtValue();
            if Val == 1 || Val == 2 || Val == 3 || Val == 4 || Val == 7 || Val == 8 {
                let mut NotCond: SDValue = SDValue {};
                if N0.getOpcode() == SETCC_CARRY && N0.getOperand(1).hasOneUse() {
                    let mut OldCC: CondCode = N0.getConstantOperandVal(0) as CondCode;
                    let mut NewCC: CondCode = GetOppositeBranchCondition(OldCC);
                    NotCond = getSETCC(NewCC, N0.getOperand(1), N0, DAG);
                } else if N0.getOpcode() == SUB && isNullConstant(N0.getOperand(0)) {
                    let mut Cond: SDValue = N0.getOperand(1);
                    if Cond.getOpcode() == ZERO_EXTEND && Cond.hasOneUse() {
                        Cond = Cond.getOperand(0);
                    }
                    if Cond.getOpcode() == SETCC && Cond.hasOneUse() {
                        let mut OldCC: CondCode = Cond.getConstantOperandVal(0) as CondCode;
                        let mut NewCC: CondCode = GetOppositeBranchCondition(OldCC);
                        NotCond = getSETCC(NewCC, Cond.getOperand(1), Cond, DAG);
                    }
                }
                if NotCond {
                    let mut R: SDValue = DAG.getZExtOrTrunc(NotCond, dl, VT);
                    R = DAG.getNode(MUL, dl, VT, R, DAG.getConstant(Val + 1, dl, VT, false, false));
                    R = DAG.getNode(SUB, dl, VT, R, DAG.getConstant(1, dl, VT, false, false));
                    return R;
                }
            }
        }
    }
    if N0.getOpcode() == KSHIFTL || N1.getOpcode() == KSHIFTL {
        let mut NumElts: u32 = VT.getVectorNumElements();
        let mut HalfElts: u32 = NumElts / 2;
        let mut X: SDValue = SDValue {};
        let mut Y: SDValue = SDValue {};
        if sd_match(N, m_Or(m_Value(X), m_BinOp(KSHIFTL, m_Value(Y), m_SpecificInt(HalfElts), SDNodeFlags { Flags: None }))) {
            let mut HalfVT: MVT = VT.getSimpleVT().getHalfNumVectorElementsVT();
            if sd_match(X, m_InsertSubvector(m_Zero(false), m_SpecificVT(HalfVT), m_Zero(false))) && sd_match(Y, m_InsertSubvector(m_Undef(), m_SpecificVT(HalfVT), m_Zero(false))) {
                if combineConcatVectorOps(dl, VT.getSimpleVT(), [X.getOperand(1), Y.getOperand(1)], DAG, Subtarget, 0) {
                    Concat;
                } else {
                    return Concat;
                }
            }
            let mut UpperElts: APInt = getHighBitsSet(NumElts, HalfElts);
            if NumElts >= 16 && DAG.MaskedVectorIsZero(X, UpperElts, 0) {
                return DAG.getNode(CONCAT_VECTORS, dl, VT, extractSubVector(X, 0, DAG, dl, HalfElts), extractSubVector(Y, 0, DAG, dl, HalfElts));
            }
        }
    }
    if VT.isVector() && (VT.getScalarSizeInBits() % 8) == 0 {
        let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
        if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
            Res;
        } else {
            return Res;
        }
        let mut UndefElts: APInt = APInt {};
        let mut EltBits: SmallVector<APInt> = SmallVector<APInt> {};
        let mut NumElts: i32 = VT.getVectorNumElements();
        let mut EltSizeInBits: i32 = VT.getScalarSizeInBits();
        if getTargetConstantBitsFromNode(N1, EltSizeInBits, UndefElts, EltBits, true, false) {
            let mut DemandedElts: APInt = getZero(NumElts);
            for let mut I: i32 = 0; I != NumElts; I += 1 {
                if !EltBits[I].isAllOnes() {
                    DemandedElts.setBit(I);
                }
            }
            if !DemandedElts.isAllOnes() && !DAG.isGuaranteedNotToBeUndefOrPoison(N0, DemandedElts, UndefOrPoison, 0) && TLI.SimplifyDemandedVectorElts(N0, DemandedElts, DCI) {
                let mut F0: SDValue = DAG.getFreeze(N.getOperand(0), operator(DemandedElts), UndefOrPoison);
                DAG.UpdateNodeOperands(N, F0, N.getOperand(1));
                return SDValue { Node: N, ResNo: 0 };
            }
        }
    }
    if combineOrXorWithSETCC(N.getOpcode(), dl, VT, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if combineOrWithGF2P8AFFINEQB(N, dl, DAG, VT) {
        R;
    } else {
        return R;
    }
    if combineAddOrSubToADCOrSBB(N, dl, DAG) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn foldXorTruncShiftIntoCmp(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut ResultType: EVT = N.getValueType(0);
    if ResultType != i8 && ResultType != i1 {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if N0.getOpcode() != TRUNCATE || !N0.hasOneUse() {
        return SDValue {};
    }
    if !isOneConstant(N1) {
        return SDValue {};
    }
    let mut Shift: SDValue = N0.getOperand(0);
    if Shift.getOpcode() != SRL || !Shift.hasOneUse() {
        return SDValue {};
    }
    let mut ShiftTy: EVT = Shift.getValueType();
    if ShiftTy != i16 && ShiftTy != i32 && ShiftTy != i64 {
        return SDValue {};
    }
    if !isa(Shift.getOperand(1)) || Shift.getConstantOperandAPInt(1) != (ShiftTy.getSizeInBits().operator unsigned long long() - 1) {
        return SDValue {};
    }
    let mut ShiftOp: SDValue = Shift.getOperand(0);
    let mut ShiftOpTy: EVT = ShiftOp.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut SetCCResultType: EVT = TLI.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), ResultType);
    let mut Cond: SDValue = DAG.getSetCC(DL, SetCCResultType, ShiftOp, DAG.getAllOnesConstant(DL, ShiftOpTy, false, false), SETGT, SDValue {}, false, None);
    if SetCCResultType != ResultType {
        Cond = DAG.getNode(ZERO_EXTEND, DL, ResultType, Cond);
    }
    return Cond;
}

fn foldVectorXorShiftIntoCmp(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isSimple() {
        return SDValue {};
    }
    match VT.getSimpleVT().SimpleTy {
        _ => {
            return SDValue {};
        },
        v16i8 => {
            v8i16;
        },
        v32i8 => {
            v16i16;
        },
    }
    let mut Shift: SDValue = N.getOperand(0);
    let mut Ones: SDValue = N.getOperand(1);
    if Shift.getOpcode() != SRA || !Shift.hasOneUse() || !isBuildVectorAllOnes(Ones.getNode()) {
        return SDValue {};
    }
    let mut ShiftAmt: *mut ConstantSDNode = isConstOrConstSplat(Shift.getOperand(1), true, false);
    if !ShiftAmt || ShiftAmt.getAPIntValue() != (Shift.getScalarValueSizeInBits() - 1) {
        return SDValue {};
    }
    return DAG.getSetCC(N, VT, Shift.getOperand(0), Ones, SETGT, SDValue {}, false, None);
}

fn detectUSatPattern(In: SDValue, VT: EVT, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    let mut InVT: EVT = In.getValueType();
    assert!(InVT.getScalarSizeInBits() > VT.getScalarSizeInBits(), "Unexpected types for truncate operation");
    let mut C1: APInt = APInt {};
    let mut C2: APInt = APInt {};
    let mut UMin: SDValue = SDValue {};
    let mut SMin: SDValue = SDValue {};
    let mut SMax: SDValue = SDValue {};
    if sd_match(In, m_UMin(m_Value(UMin), m_ConstInt(C2))) && C2.isMask(VT.getScalarSizeInBits()) {
        return UMin;
    }
    if sd_match(In, m_SMin(m_Value(SMin), m_ConstInt(C2))) && sd_match(SMin, m_SMax(m_Value(SMax), m_ConstInt(C1))) && C1.isNonNegative() && C2.isMask(VT.getScalarSizeInBits()) {
        return SMin;
    }
    if sd_match(In, m_SMax(m_Value(SMax), m_ConstInt(C1))) && sd_match(SMax, m_SMin(m_Value(SMin), m_ConstInt(C2))) && C1.isNonNegative() && C2.isMask(VT.getScalarSizeInBits()) && C2.uge(C1) {
        return DAG.getNode(SMAX, DL, InVT, SMin, In.getOperand(1));
    }
    return SDValue {};
}

fn detectSSatPattern(In: SDValue, VT: EVT, MatchPackUS: bool) -> SDValue {
    let mut NumDstBits: u32 = VT.getScalarSizeInBits();
    let mut NumSrcBits: u32 = In.getScalarValueSizeInBits();
    assert!(NumSrcBits > NumDstBits, "Unexpected types for truncate operation");
    let mut SignedMax: APInt = APInt {};
    let mut SignedMin: APInt = APInt {};
    if MatchPackUS {
        SignedMax = getAllOnes(NumDstBits).zext(NumSrcBits);
        SignedMin = getZero(NumSrcBits);
    } else {
        SignedMax = getSignedMaxValue(NumDstBits).sext(NumSrcBits);
        SignedMin = getSignedMinValue(NumDstBits).sext(NumSrcBits);
    }
    let mut SMin: SDValue = SDValue {};
    let mut SMax: SDValue = SDValue {};
    if sd_match(In, m_SMin(m_Value(SMin), m_SpecificInt(SignedMax))) && sd_match(SMin, m_SMax(m_Value(SMax), m_SpecificInt(SignedMin))) {
        return SMax;
    }
    if sd_match(In, m_SMax(m_Value(SMax), m_SpecificInt(SignedMin))) && sd_match(SMax, m_SMin(m_Value(SMin), m_SpecificInt(SignedMax))) {
        return SMin;
    }
    return SDValue {};
}

fn combineTruncateWithSat(In: SDValue, VT: EVT, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() || !VT.isVector() {
        return SDValue {};
    }
    let mut SVT: EVT = VT.getVectorElementType();
    let mut InVT: EVT = In.getValueType();
    let mut InSVT: EVT = InVT.getVectorElementType();
    if Subtarget.hasBWI() && !Subtarget.useAVX512Regs() && InVT == v16i32 && VT == v16i8 {
        if detectSSatPattern(In, VT, true) {
            USatVal;
        } else {
            let mut Mid: SDValue = truncateVectorWithPACK(PACKUS, v16i16, USatVal, DL, DAG, Subtarget);
            assert!(Mid, "Failed to pack!");
            return DAG.getNode(VTRUNCUS, DL, VT, Mid);
        }
    }
    let mut PreferAVX512: bool = ((Subtarget.hasAVX512() && InSVT == i32) || (Subtarget.hasBWI() && InSVT == i16)) && (InVT.getSizeInBits().operator unsigned long long() > 128) && (Subtarget.hasVLX() || InVT.getSizeInBits().operator unsigned long long() > 256) && !(!Subtarget.useAVX512Regs() && VT.getSizeInBits().operator unsigned long long() >= 256);
    if !PreferAVX512 && VT.getVectorNumElements() > 1 && isPowerOf2_32(VT.getVectorNumElements()) && (SVT == i8 || SVT == i16) && (InSVT == i16 || InSVT == i32) {
        if detectSSatPattern(In, VT, true) {
            USatVal;
        } else {
            if SVT == i8 && InSVT == i32 {
                let mut MidVT: EVT = VT.changeVectorElementType(*DAG.getContext(), i16);
                let mut Mid: SDValue = truncateVectorWithPACK(PACKSS, MidVT, USatVal, DL, DAG, Subtarget);
                assert!(Mid, "Failed to pack!");
                let mut V: SDValue = truncateVectorWithPACK(PACKUS, VT, Mid, DL, DAG, Subtarget);
                assert!(V, "Failed to pack!");
                return V;
            } else if SVT == i8 || Subtarget.hasSSE41() {
                return truncateVectorWithPACK(PACKUS, VT, USatVal, DL, DAG, Subtarget);
            }
        }
        if detectSSatPattern(In, VT, false) {
            SSatVal;
        } else {
            return truncateVectorWithPACK(PACKSS, VT, SSatVal, DL, DAG, Subtarget);
        }
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.isTypeLegal(InVT) && InVT.isVector() && SVT != i1 && Subtarget.hasAVX512() && (InSVT != i16 || Subtarget.hasBWI()) && (SVT == i32 || SVT == i16 || SVT == i8) {
        let mut TruncOpc: u32 = 0;
        let mut SatVal: SDValue = SDValue {};
        if detectSSatPattern(In, VT, false) {
            SSatVal;
        } else {
            SatVal = SSatVal;
            TruncOpc = VTRUNCS;
        }
        if SatVal {
            let mut ResElts: u32 = VT.getVectorNumElements();
            if !Subtarget.hasVLX() && !InVT.is512BitVector() {
                let mut NumConcats: u32 = 512 / InVT.getSizeInBits().operator unsigned long long();
                ResElts *= NumConcats;
                let mut ConcatOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumConcats, DAG.getUNDEF(InVT) };
                ConcatOps[0] = SatVal;
                InVT = getVectorVT(*DAG.getContext(), InSVT, NumConcats * InVT.getVectorNumElements(), false);
                SatVal = DAG.getNode(CONCAT_VECTORS, DL, InVT, ConcatOps);
            }
            if ResElts * SVT.getSizeInBits().operator unsigned long long() < 128 {
                ResElts = 128 / SVT.getSizeInBits().operator unsigned long long();
            }
            let mut TruncVT: EVT = getVectorVT(*DAG.getContext(), SVT, ResElts, false);
            let mut Res: SDValue = DAG.getNode(TruncOpc, DL, TruncVT, SatVal);
            return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Res, DAG.getVectorIdxConstant(0, DL, false));
        }
    }
    return SDValue {};
}

fn combineConstantPoolLoads(N: *mut SDNode, dl: *SDLoc, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Ld: *mut LoadSDNode = cast(N);
    let mut RegVT: EVT = Ld.getValueType(0);
    let mut Ptr: SDValue = Ld.getBasePtr();
    let mut Chain: SDValue = Ld.getChain();
    let mut Ext: LoadExtType = Ld.getExtensionType();
    if Ext != NON_EXTLOAD || !Subtarget.hasAVX() || !Ld.isSimple() {
        return SDValue {};
    }
    if !(RegVT.is128BitVector() || RegVT.is256BitVector()) {
        return SDValue {};
    }
    let mut LdC: *Constant = getTargetConstantFromBasePtr(Ptr);
    if !LdC {
        return SDValue {};
    }
    let mut MatchingBits: Closure_209 = Closure_209 {};
    for User in operator(Chain).users() {
        let mut UserLd: *mut MemSDNode = dyn_cast(User);
        if User != N && UserLd && (User.getOpcode() == SUBV_BROADCAST_LOAD || User.getOpcode() == VBROADCAST_LOAD || isNormalLoad(User)) && UserLd.getChain() == Chain && User.hasAnyUseOfValue(0) && User.getValueSizeInBits(0).getFixedValue() > RegVT.getFixedSizeInBits() {
            let mut UserVT: EVT = User.getValueType(0);
            let mut UserPtr: SDValue = UserLd.getBasePtr();
            let mut UserC: *Constant = getTargetConstantFromBasePtr(UserPtr);
            if UserC && UserPtr != Ptr {
                let mut LdSize: u32 = LdC.getType().getPrimitiveSizeInBits().operator unsigned long long();
                let mut UserSize: u32 = UserC.getType().getPrimitiveSizeInBits().operator unsigned long long();
                if LdSize < UserSize || !isNormalLoad(User) {
                    let mut Undefs: APInt = APInt {};
                    let mut UserUndefs: APInt = APInt {};
                    let mut Bits: SmallVector<APInt> = SmallVector<APInt> {};
                    let mut UserBits: SmallVector<APInt> = SmallVector<APInt> {};
                    let mut NumBits: u32 = if RegVT.getScalarSizeInBits() < UserVT.getScalarSizeInBits() { RegVT.getScalarSizeInBits() } else { UserVT.getScalarSizeInBits() };
                    if getTargetConstantBitsFromNode(SDValue { Node: N, ResNo: 0 }, NumBits, Undefs, Bits, true, false) && getTargetConstantBitsFromNode(SDValue { Node: User, ResNo: 0 }, NumBits, UserUndefs, UserBits, true, false) {
                        if MatchingBits.call(Undefs, UserUndefs, Bits, UserBits) {
                            DAG.makeEquivalentMemoryOrdering(SDValue { Node: N, ResNo: 1 }, SDValue { Node: User, ResNo: 1 });
                            let mut Extract: SDValue = extractSubVector(SDValue { Node: User, ResNo: 0 }, 0, DAG, dl, RegVT.getSizeInBits().operator unsigned long long());
                            Extract = DAG.getBitcast(RegVT, Extract);
                            return DCI.CombineTo(N, Extract, SDValue { Node: User, ResNo: 1 }, true);
                        }
                    }
                }
            }
        }
    }
    return SDValue {};
}

fn combineAtomicLoad(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut AN: *mut AtomicSDNode = cast(N);
    let mut VT: EVT = AN.getValueType(0);
    if !VT.getScalarType().isFloatingPoint() {
        return SDValue {};
    }
    let mut BitWidth: u32 = VT.getStoreSizeInBits().operator unsigned long long();
    if BitWidth != VT.getSizeInBits().operator unsigned long long() {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), BitWidth);
    let mut IntLoad: SDValue = DAG.getAtomic(ATOMIC_LOAD, DL, IntVT, DAG.getVTList(IntVT, Other), [AN.getChain(), AN.getBasePtr()], AN.getMemOperand(), NON_EXTLOAD);
    let mut Cast: SDValue = DAG.getBitcast(VT, IntLoad);
    return DAG.getMergeValues([Cast, IntLoad.getValue(1)], DL);
}

fn combineLoad(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Ld: *mut LoadSDNode = cast(N);
    let mut RegVT: EVT = Ld.getValueType(0);
    let mut MemVT: EVT = Ld.getMemoryVT();
    let mut dl: SDLoc = Ld;
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Ext: LoadExtType = Ld.getExtensionType();
    let mut Fast: u32 = 0;
    if RegVT.is256BitVector() && !DCI.isBeforeLegalizeOps() && Ext == NON_EXTLOAD && ((Ld.isNonTemporal() && !Subtarget.hasInt256() && Ld.getAlign() >= 16) || (TLI.allowsMemoryAccess(*DAG.getContext(), DAG.getDataLayout(), RegVT, *Ld.getMemOperand(), &mut Fast) && !Fast)) {
        let mut NumElems: u32 = RegVT.getVectorNumElements();
        if NumElems < 2 {
            return SDValue {};
        }
        let mut HalfOffset: u32 = 16;
        let mut Ptr1: SDValue = Ld.getBasePtr();
        let mut Ptr2: SDValue = DAG.getMemBasePlusOffset(Ptr1, getFixed(HalfOffset), dl, SDNodeFlags { Flags: None });
        let mut HalfVT: EVT = getVectorVT(*DAG.getContext(), MemVT.getScalarType(), NumElems / 2, false);
        let mut Load1: SDValue = DAG.getLoad(HalfVT, dl, Ld.getChain(), Ptr1, Ld.getPointerInfo(), Ld.getBaseAlign(), Ld.getMemOperand().getFlags(), MMOMetadata {});
        let mut Load2: SDValue = DAG.getLoad(HalfVT, dl, Ld.getChain(), Ptr2, Ld.getPointerInfo().getWithOffset(HalfOffset), Ld.getBaseAlign(), Ld.getMemOperand().getFlags(), MMOMetadata {});
        let mut TF: SDValue = DAG.getNode(TokenFactor, dl, Other, Load1.getValue(1), Load2.getValue(1));
        let mut NewVec: SDValue = DAG.getNode(CONCAT_VECTORS, dl, RegVT, Load1, Load2);
        return DCI.CombineTo(N, NewVec, TF, true);
    }
    if Ext == NON_EXTLOAD && !Subtarget.hasAVX512() && RegVT.isVector() && RegVT.getScalarType() == i1 && DCI.isBeforeLegalize() {
        let mut NumElts: u32 = RegVT.getVectorNumElements();
        let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), NumElts);
        if TLI.isTypeLegal(IntVT) {
            let mut IntLoad: SDValue = DAG.getLoad(IntVT, dl, Ld.getChain(), Ld.getBasePtr(), Ld.getPointerInfo(), Ld.getBaseAlign(), Ld.getMemOperand().getFlags(), MMOMetadata {});
            let mut BoolVec: SDValue = DAG.getBitcast(RegVT, IntLoad);
            return DCI.CombineTo(N, BoolVec, IntLoad.getValue(1), true);
        }
    }
    if Ext == NON_EXTLOAD && Subtarget.hasAVX() && Ld.isSimple() && (RegVT.is128BitVector() || RegVT.is256BitVector()) {
        let mut Ptr: SDValue = Ld.getBasePtr();
        let mut Chain: SDValue = Ld.getChain();
        for User in operator(Chain).users() {
            let mut UserLd: *mut MemSDNode = dyn_cast(User);
            if User != N && UserLd && User.getOpcode() == SUBV_BROADCAST_LOAD && UserLd.getChain() == Chain && UserLd.getBasePtr() == Ptr && UserLd.getMemoryVT().getSizeInBits() == MemVT.getSizeInBits() && User.hasAnyUseOfValue(0) && User.getValueSizeInBits(0).getFixedValue() > RegVT.getFixedSizeInBits() {
                DAG.makeEquivalentMemoryOrdering(SDValue { Node: N, ResNo: 1 }, SDValue { Node: User, ResNo: 1 });
                let mut Extract: SDValue = extractSubVector(SDValue { Node: User, ResNo: 0 }, 0, DAG, dl, RegVT.getSizeInBits().operator unsigned long long());
                Extract = DAG.getBitcast(RegVT, Extract);
                return DCI.CombineTo(N, Extract, SDValue { Node: User, ResNo: 1 }, true);
            }
        }
    }
    if combineConstantPoolLoads(Ld, dl, DAG, DCI, Subtarget) {
        V;
    } else {
        return V;
    }
    let mut AddrSpace: u32 = Ld.getAddressSpace();
    if AddrSpace == PTR64 || AddrSpace == PTR32_SPTR || AddrSpace == PTR32_UPTR {
        let mut PtrVT: MVT = TLI.getPointerTy(DAG.getDataLayout(), 0);
        if PtrVT != Ld.getBasePtr().getSimpleValueType() {
            let mut Cast: SDValue = DAG.getAddrSpaceCast(dl, PtrVT, Ld.getBasePtr(), AddrSpace, 0, SDNodeFlags { Flags: None });
            return DAG.getExtLoad(Ext, dl, RegVT, Ld.getChain(), Cast, Ld.getPointerInfo(), MemVT, Ld.getBaseAlign(), Ld.getMemOperand().getFlags(), MMOMetadata {});
        }
    }
    return SDValue {};
}

fn canonicalizeBoolMask(Opcode: u32, VT: EVT, Mask: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if !DCI.isBeforeLegalizeOps() || Mask.getOpcode() != BITCAST || Mask.getScalarValueSizeInBits() != 1 || Subtarget.hasAVX512() || !DAG.getTargetLoweringInfo().isOperationLegalOrCustom(Opcode, VT, false) {
        return SDValue {};
    }
    let mut MaskVT: EVT = Mask.getValueType();
    let mut ExtMaskVT: EVT = VT.changeVectorElementTypeToInteger();
    assert!(ExtMaskVT.bitsGT(MaskVT), "Unexpected extension type");
    if combineToExtendBoolVectorInReg(SIGN_EXTEND, DL, ExtMaskVT, Mask, DAG, DCI, Subtarget) {
        NewMask;
    } else {
        return DAG.getNode(TRUNCATE, DL, MaskVT, NewMask);
    }
    return SDValue {};
}

fn getOneTrueElt(V: SDValue) -> i32 {
    let mut BV: *mut BuildVectorSDNode = dyn_cast(V);
    if !BV || BV.getValueType(0).getVectorElementType() != i1 {
        return -1;
    }
    let mut TrueIndex: i32 = -1;
    let mut NumElts: u32 = BV.getValueType(0).getVectorNumElements();
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        let mut Op: *SDValue = BV.getOperand(i);
        if Op.isUndef() {
            continue;
        }
        let mut ConstNode: *mut ConstantSDNode = dyn_cast(Op);
        if !ConstNode {
            return -1;
        }
        if ConstNode.getAPIntValue().countr_one() >= 1 {
            if TrueIndex >= 0 {
                return -1;
            }
            TrueIndex = i;
        }
    }
    return TrueIndex;
}

fn getParamsForOneTrueMaskedElt(MaskedOp: *mut MaskedLoadStoreSDNode, DAG: *mut SelectionDAG, Addr: *mut SDValue, Index: *mut SDValue, Alignment: *mut Align, Offset: *mut u32) -> bool {
    let mut TrueMaskElt: i32 = getOneTrueElt(MaskedOp.getMask());
    if TrueMaskElt < 0 {
        return false;
    }
    let mut EltVT: EVT = MaskedOp.getMemoryVT().getVectorElementType();
    Offset = 0;
    Addr = MaskedOp.getBasePtr();
    if TrueMaskElt != 0 {
        Offset = TrueMaskElt * EltVT.getStoreSize().operator unsigned long long();
        Addr = DAG.getMemBasePlusOffset(Addr, getFixed(Offset), MaskedOp, SDNodeFlags { Flags: None });
    }
    Index = DAG.getIntPtrConstant(TrueMaskElt, MaskedOp, false);
    Alignment = commonAlignment(MaskedOp.getBaseAlign(), EltVT.getStoreSize().operator unsigned long long());
    return true;
}

fn reduceMaskedLoadToScalarLoad(ML: *mut MaskedLoadSDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    assert!(ML.isUnindexed(), "Unexpected indexed masked load!");
    let mut Addr: SDValue = SDValue {};
    let mut VecIndex: SDValue = SDValue {};
    let mut Alignment: Align = Align {};
    let mut Offset: u32 = 0;
    if !getParamsForOneTrueMaskedElt(ML, DAG, Addr, VecIndex, Alignment, Offset) {
        return SDValue {};
    }
    let mut DL: SDLoc = ML;
    let mut VT: EVT = ML.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut CastVT: EVT = VT;
    if EltVT == i64 && !Subtarget.is64Bit() {
        EltVT = f64;
        CastVT = VT.changeVectorElementType(*DAG.getContext(), EltVT);
    }
    let mut Load: SDValue = DAG.getLoad(EltVT, DL, ML.getChain(), Addr, ML.getPointerInfo().getWithOffset(Offset), Alignment, ML.getMemOperand().getFlags(), MMOMetadata {});
    let mut PassThru: SDValue = DAG.getBitcast(CastVT, ML.getPassThru());
    let mut Insert: SDValue = DAG.getNode(INSERT_VECTOR_ELT, DL, CastVT, PassThru, Load, VecIndex);
    Insert = DAG.getBitcast(VT, Insert);
    return DCI.CombineTo(ML, Insert, Load.getValue(1), true);
}

fn combineMaskedLoadConstantMask(ML: *mut MaskedLoadSDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    assert!(ML.isUnindexed(), "Unexpected indexed masked load!");
    if !isBuildVectorOfConstantSDNodes(ML.getMask().getNode()) {
        return SDValue {};
    }
    let mut DL: SDLoc = ML;
    let mut VT: EVT = ML.getValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut MaskBV: *mut BuildVectorSDNode = cast(ML.getMask());
    let mut LoadFirstElt: bool = !isNullConstant(MaskBV.getOperand(0));
    let mut LoadLastElt: bool = !isNullConstant(MaskBV.getOperand(NumElts - 1));
    if LoadFirstElt && LoadLastElt {
        let mut VecLd: SDValue = DAG.getLoad(VT, DL, ML.getChain(), ML.getBasePtr(), ML.getMemOperand());
        let mut Blend: SDValue = DAG.getSelect(DL, VT, ML.getMask(), VecLd, ML.getPassThru(), SDNodeFlags { Flags: None });
        return DCI.CombineTo(ML, Blend, VecLd.getValue(1), true);
    }
    if ML.getPassThru().isUndef() {
        return SDValue {};
    }
    if isBuildVectorAllZeros(ML.getPassThru().getNode()) {
        return SDValue {};
    }
    let mut NewML: SDValue = DAG.getMaskedLoad(VT, DL, ML.getChain(), ML.getBasePtr(), ML.getOffset(), ML.getMask(), DAG.getUNDEF(VT), ML.getMemoryVT(), ML.getMemOperand(), ML.getAddressingMode(), ML.getExtensionType(), false);
    let mut Blend: SDValue = DAG.getSelect(DL, VT, ML.getMask(), NewML, ML.getPassThru(), SDNodeFlags { Flags: None });
    return DCI.CombineTo(ML, Blend, NewML.getValue(1), true);
}

fn combineMaskedLoad(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Mld: *mut MaskedLoadSDNode = cast(N);
    if Mld.isExpandingLoad() {
        return SDValue {};
    }
    if Mld.getExtensionType() == NON_EXTLOAD {
        if reduceMaskedLoadToScalarLoad(Mld, DAG, DCI, Subtarget) {
            ScalarLoad;
        } else {
            return ScalarLoad;
        }
        if !Subtarget.hasAVX512() {
            if combineMaskedLoadConstantMask(Mld, DAG, DCI) {
                Blend;
            } else {
                return Blend;
            }
        }
    }
    let mut VT: EVT = Mld.getValueType(0);
    let mut Mask: SDValue = Mld.getMask();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = N;
    if canonicalizeBoolMask(MLOAD, VT, Mask, DL, DAG, DCI, Subtarget) {
        NewMask;
    } else {
        return DAG.getMaskedLoad(VT, DL, Mld.getChain(), Mld.getBasePtr(), Mld.getOffset(), NewMask, Mld.getPassThru(), Mld.getMemoryVT(), Mld.getMemOperand(), Mld.getAddressingMode(), Mld.getExtensionType(), false);
    }
    if Mask.getScalarValueSizeInBits() != 1 {
        let mut DemandedBits: APInt = getSignMask(VT.getScalarSizeInBits());
        if TLI.SimplifyDemandedBits(Mask, DemandedBits, DCI) {
            if N.getOpcode() != DELETED_NODE {
                DCI.AddToWorklist(N);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
        if TLI.SimplifyMultipleUseDemandedBits(Mask, DemandedBits, DAG, 0) {
            NewMask;
        } else {
            return DAG.getMaskedLoad(VT, DL, Mld.getChain(), Mld.getBasePtr(), Mld.getOffset(), NewMask, Mld.getPassThru(), Mld.getMemoryVT(), Mld.getMemOperand(), Mld.getAddressingMode(), Mld.getExtensionType(), false);
        }
    }
    return SDValue {};
}

fn reduceMaskedStoreToScalarStore(MS: *mut MaskedStoreSDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Addr: SDValue = SDValue {};
    let mut VecIndex: SDValue = SDValue {};
    let mut Alignment: Align = Align {};
    let mut Offset: u32 = 0;
    if !getParamsForOneTrueMaskedElt(MS, DAG, Addr, VecIndex, Alignment, Offset) {
        return SDValue {};
    }
    let mut DL: SDLoc = MS;
    let mut Value: SDValue = MS.getValue();
    let mut VT: EVT = Value.getValueType();
    let mut EltVT: EVT = VT.getVectorElementType();
    if EltVT == i64 && !Subtarget.is64Bit() {
        EltVT = f64;
        let mut CastVT: EVT = VT.changeVectorElementType(*DAG.getContext(), EltVT);
        Value = DAG.getBitcast(CastVT, Value);
    }
    let mut Extract: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, EltVT, Value, VecIndex);
    if MS.isTruncatingStore() {
        if EltVT.isFloatingPoint() {
            return SDValue {};
        }
        Extract = DAG.getNode(TRUNCATE, DL, MS.getMemoryVT().getVectorElementType(), Extract);
    }
    return DAG.getStore(MS.getChain(), DL, Extract, Addr, MS.getPointerInfo().getWithOffset(Offset), Alignment, MS.getMemOperand().getFlags(), MMOMetadata {});
}

fn combineMaskedStore(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Mst: *mut MaskedStoreSDNode = cast(N);
    if Mst.isCompressingStore() {
        return SDValue {};
    }
    if reduceMaskedStoreToScalarStore(Mst, DAG, Subtarget) {
        ScalarStore;
    } else {
        return ScalarStore;
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = N;
    let mut Mask: SDValue = Mst.getMask();
    let mut Value: SDValue = Mst.getValue();
    let mut MemVT: EVT = Mst.getMemoryVT();
    let mut VT: EVT = Value.getValueType();
    if Mst.isTruncatingStore() {
        if VT.isVector() && MemVT.isVector() && VT.getScalarType().isInteger() && MemVT.getScalarType().isInteger() && VT.getVectorNumElements() == MemVT.getVectorNumElements() && Subtarget.hasBWI() && (VT.getSizeInBits().operator unsigned long long() == 512 || Subtarget.hasVLX()) {
            let mut SatSrc: SDValue = SDValue {};
            let mut Opc: u32 = 0;
            if detectSSatPattern(Value, MemVT, false) {
                SVal;
            } else {
                SatSrc = SVal;
                Opc = VMTRUNCSTORES;
            }
            let mut VTs: SDVTList = DAG.getVTList(Other);
            let mut Ops: [4]SDValue = [Mst.getChain(), SatSrc, Mst.getBasePtr(), Mask];
            let mut MMO: *mut MachineMemOperand = Mst.getMemOperand();
            return DAG.getMemIntrinsicNode(Opc, DL, VTs, Ops, MemVT, MMO);
        }
        return SDValue {};
    }
    if canonicalizeBoolMask(MSTORE, VT, Mask, DL, DAG, DCI, Subtarget) {
        NewMask;
    } else {
        return DAG.getMaskedStore(Mst.getChain(), N, Mst.getValue(), Mst.getBasePtr(), Mst.getOffset(), NewMask, Mst.getMemoryVT(), Mst.getMemOperand(), Mst.getAddressingMode(), false, false);
    }
    if Mask.getScalarValueSizeInBits() != 1 {
        let mut DemandedBits: APInt = getSignMask(VT.getScalarSizeInBits());
        if TLI.SimplifyDemandedBits(Mask, DemandedBits, DCI) {
            if N.getOpcode() != DELETED_NODE {
                DCI.AddToWorklist(N);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
        if TLI.SimplifyMultipleUseDemandedBits(Mask, DemandedBits, DAG, 0) {
            NewMask;
        } else {
            return DAG.getMaskedStore(Mst.getChain(), N, Mst.getValue(), Mst.getBasePtr(), Mst.getOffset(), NewMask, Mst.getMemoryVT(), Mst.getMemOperand(), Mst.getAddressingMode(), false, false);
        }
    }
    if Value.getOpcode() == TRUNCATE && Value.getNode().hasOneUse() && TLI.isTruncStoreLegal(Value.getOperand(0).getValueType(), MemVT, Mst.getAlign(), Mst.getAddressSpace()) {
        return DAG.getMaskedStore(Mst.getChain(), DL, Value.getOperand(0), Mst.getBasePtr(), Mst.getOffset(), Mask, MemVT, Mst.getMemOperand(), Mst.getAddressingMode(), true, false);
    }
    return SDValue {};
}

fn narrowBitOpRMW(St: *mut StoreSDNode, DL: *SDLoc, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut StoredVal: SDValue = St.getValue();
    let mut VT: EVT = StoredVal.getValueType();
    if !isNormalStore(St) || !St.isSimple() || !VT.isScalarInteger() || VT.getSizeInBits().operator unsigned long long() <= (if Subtarget.is64Bit() { 64 } else { 32 }) {
        return SDValue {};
    }
    let mut SrcVal: SDValue = SDValue {};
    let mut InsertBit: SDValue = SDValue {};
    let mut ShAmt: SDValue = SDValue {};
    if !(sd_match(StoredVal, m_And(m_Value(SrcVal), m_Not(m_Shl(m_One(false), m_Value(ShAmt))))) || sd_match(StoredVal, m_Or(m_Value(SrcVal), m_Shl(m_One(false), m_Value(ShAmt)))) || sd_match(StoredVal, m_Xor(m_Value(SrcVal), m_Shl(m_One(false), m_Value(ShAmt)))) || sd_match(StoredVal, m_Or(m_And(m_Value(SrcVal), m_Not(m_Shl(m_One(false), m_Value(ShAmt)))), m_Shl(m_Value(InsertBit), m_Deferred(ShAmt))))) {
        return SDValue {};
    }
    let mut Ld: *mut LoadSDNode = dyn_cast(peekThroughBitcasts(SrcVal));
    if !Ld || !isNormalLoad(Ld) || !Ld.isSimple() || Ld.getBasePtr() != St.getBasePtr() || Ld.getOffset() != St.getOffset() || !St.getChain().reachesChainWithoutSideEffects(SDValue { Node: Ld, ResNo: 1 }, 2) {
        return SDValue {};
    }
    let mut KnownAmt: KnownBits = DAG.computeKnownBits(ShAmt, 0);
    if KnownAmt.getMaxValue().uge(VT.getSizeInBits().operator unsigned long long()) {
        return SDValue {};
    }
    if InsertBit {
        let mut KnownInsert: KnownBits = DAG.computeKnownBits(InsertBit, 0);
        if KnownInsert.countMinLeadingZeros() < (VT.getSizeInBits().operator unsigned long long() - 1) {
            return SDValue {};
        }
    }
    let mut AmtVT: EVT = ShAmt.getValueType();
    let mut AlignAmt: SDValue = DAG.getNode(AND, DL, AmtVT, ShAmt, DAG.getSignedConstant(-32, DL, AmtVT, false, false));
    let mut ModuloAmt: SDValue = DAG.getNode(AND, DL, AmtVT, ShAmt, DAG.getConstant(31, DL, AmtVT, false, false));
    ModuloAmt = DAG.getZExtOrTrunc(ModuloAmt, DL, i8);
    let mut PtrVT: EVT = St.getBasePtr().getValueType();
    let mut PtrBitOfs: SDValue = DAG.getZExtOrTrunc(AlignAmt, DL, PtrVT);
    let mut PtrByteOfs: SDValue = DAG.getNode(SRL, DL, PtrVT, PtrBitOfs, DAG.getShiftAmountConstant(3, PtrVT, DL));
    let mut NewPtr: SDValue = DAG.getMemBasePlusOffset(St.getBasePtr(), PtrByteOfs, DL, NoUnsignedWrap);
    let mut X: SDValue = DAG.getNode(SRL, DL, VT, SrcVal, AlignAmt);
    X = DAG.getNode(TRUNCATE, DL, i32, X);
    let mut Mask: SDValue = DAG.getNode(SHL, DL, i32, DAG.getConstant(1, DL, i32, false, false), ModuloAmt);
    let mut Res: SDValue = SDValue {};
    if InsertBit {
        let mut BitMask: SDValue = DAG.getNode(SHL, DL, i32, DAG.getZExtOrTrunc(InsertBit, DL, i32), ModuloAmt);
        Res = DAG.getNode(AND, DL, i32, X, DAG.getNOT(DL, Mask, i32));
        Res = DAG.getNode(OR, DL, i32, Res, BitMask);
    } else {
        if StoredVal.getOpcode() == AND {
            Mask = DAG.getNOT(DL, Mask, i32);
        }
        Res = DAG.getNode(StoredVal.getOpcode(), DL, i32, X, Mask);
    }
    let mut NewStore: SDValue = DAG.getStore(St.getChain(), DL, Res, NewPtr, MachinePointerInfo { St.getPointerInfo().getAddrSpace(), 0 }, Align {}, St.getMemOperand().getFlags(), MMOMetadata {});
    if !StoredVal.hasOneUse() {
        let mut NewLoad: SDValue = DAG.getLoad(VT, DL, NewStore, Ld.getBasePtr(), Ld.getMemOperand());
        for User in operator(StoredVal).users() {
            DCI.AddToWorklist(User);
        }
        DAG.ReplaceAllUsesWith(StoredVal, NewLoad);
    }
    return NewStore;
}

fn combineScalarMinMaxAbsStore(St: *mut StoreSDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !isNormalStore(St) {
        return SDValue {};
    }
    let mut StoredVal: SDValue = St.getValue();
    let mut Opc: u32 = StoredVal.getOpcode();
    let mut IsAbs: bool = isAbsOpcode(Opc);
    if (!IsAbs && !isMinMaxOpcode(Opc)) || !StoredVal.hasOneUse() {
        return SDValue {};
    }
    let mut VT: EVT = StoredVal.getValueType();
    let mut F: *Function = DAG.getMachineFunction().getFunction();
    if F.hasFnAttribute(NoImplicitFloat) || Subtarget.useSoftFloat() || F.hasOptSize() {
        return SDValue {};
    }
    let mut getVecVT: Closure_210 = Closure_210 { VT: &mut VT, Subtarget: &mut Subtarget, IsAbs: &mut IsAbs, Opc: &mut Opc, DAG: &mut DAG };
    let mut VecVTOpt: optional<MVT> = getVecVT.call();
    if !VecVTOpt {
        return SDValue {};
    }
    let mut VecVT: MVT = operator(VecVTOpt);
    let mut Op0: SDValue = StoredVal.getOperand(0);
    if !isNormalLoad(Op0.getNode()) {
        return SDValue {};
    }
    let mut Vec: SDValue = SDValue {};
    if IsAbs {
        if !Op0.hasOneUse() {
            return SDValue {};
        }
        Vec = DAG.getNode(ABS, DL, VecVT, DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, Op0));
    } else {
        let mut Op1: SDValue = StoredVal.getOperand(1);
        if !isNormalLoad(Op1.getNode()) {
            return SDValue {};
        }
        let mut checkLoadUses: Closure_211 = Closure_211 {};
        if !checkLoadUses.call(Op0) || !checkLoadUses.call(Op1) {
            return SDValue {};
        }
        Vec = DAG.getNode(Opc, DL, VecVT, DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, Op0), DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, Op1));
    }
    return DAG.getStore(St.getChain(), DL, DAG.getExtractVectorElt(DL, VT, Vec, 0), St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
}

fn combineStore(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut St: *mut StoreSDNode = cast(N);
    let mut StVT: EVT = St.getMemoryVT();
    let mut dl: SDLoc = St;
    let mut StoredVal: SDValue = St.getValue();
    let mut VT: EVT = StoredVal.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Src: SDValue = SDValue {};
    if !St.isTruncatingStore() && Subtarget.hasAVX512() {
        let mut SrcVT: EVT = EVT {};
        if sd_match(StoredVal, m_OneUse(m_Trunc(m_OneUse(m_Value(Src, m_VT(SrcVT)))))) && isNormalLoad(Src.getNode()) {
            if (SrcVT == v4i16 && VT == v4i8) || (SrcVT == v2i32 && VT == v2i8) || (SrcVT == v2i32 && VT == v2i16) || (SrcVT == v2i16 && VT == v2i8) {
                let mut ExtVT: MVT = if SrcVT == v4i16 { v4i32 } else { v2i64 };
                if TLI.isTruncStoreLegal(ExtVT, VT, St.getAlign(), St.getAddressSpace()) {
                    let mut Ext: SDValue = DAG.getNode(ANY_EXTEND, dl, ExtVT, Src);
                    return DAG.getTruncStore(St.getChain(), dl, Ext, St.getBasePtr(), VT, St.getMemOperand());
                }
            }
        }
    }
    if !Subtarget.hasAVX512() && VT == StVT && VT.isVector() && VT.getVectorElementType() == i1 {
        let mut NewVT: EVT = getIntegerVT(*DAG.getContext(), VT.getVectorNumElements());
        StoredVal = DAG.getBitcast(NewVT, StoredVal);
        return DAG.getStore(St.getChain(), dl, StoredVal, St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
    }
    if VT == v1i1 && VT == StVT && Subtarget.hasAVX512() && StoredVal.getOpcode() == SCALAR_TO_VECTOR && StoredVal.getOperand(0).getValueType() == i8 {
        let mut Val: SDValue = StoredVal.getOperand(0);
        Val = DAG.getZeroExtendInReg(Val, dl, i1);
        return DAG.getStore(St.getChain(), dl, Val, St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
    }
    if (VT == v1i1 || VT == v2i1 || VT == v4i1) && VT == StVT && Subtarget.hasAVX512() {
        let mut NumConcats: u32 = 8 / VT.getVectorNumElements();
        let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumConcats, DAG.getConstant(0, dl, VT, false, false) };
        Ops[0] = StoredVal;
        StoredVal = DAG.getNode(CONCAT_VECTORS, dl, v8i1, Ops);
        return DAG.getStore(St.getChain(), dl, StoredVal, St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
    }
    if (VT == v8i1 || VT == v16i1 || VT == v32i1 || VT == v64i1) && VT == StVT && TLI.isTypeLegal(VT) && isBuildVectorOfConstantSDNodes(StoredVal.getNode()) {
        if !DCI.isBeforeLegalize() && VT == v64i1 && !Subtarget.is64Bit() {
            let mut Lo: SDValue = DAG.getBuildVector(v32i1, dl, operator(StoredVal).ops().slice(0, 32));
            Lo = combinevXi1ConstantToInteger(Lo, DAG);
            let mut Hi: SDValue = DAG.getBuildVector(v32i1, dl, operator(StoredVal).ops().slice(32, 32));
            Hi = combinevXi1ConstantToInteger(Hi, DAG);
            let mut Ptr0: SDValue = St.getBasePtr();
            let mut Ptr1: SDValue = DAG.getMemBasePlusOffset(Ptr0, getFixed(4), dl, SDNodeFlags { Flags: None });
            let mut Ch0: SDValue = DAG.getStore(St.getChain(), dl, Lo, Ptr0, St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
            let mut Ch1: SDValue = DAG.getStore(St.getChain(), dl, Hi, Ptr1, St.getPointerInfo().getWithOffset(4), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
            return DAG.getNode(TokenFactor, dl, Other, Ch0, Ch1);
        }
        StoredVal = combinevXi1ConstantToInteger(StoredVal, DAG);
        return DAG.getStore(St.getChain(), dl, StoredVal, St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
    }
    if (VT == f16 || VT == bf16 || VT == f32 || VT == f64) && (StoredVal.getOpcode() == FABS || StoredVal.getOpcode() == FNEG) && isNormalLoad(StoredVal.getOperand(0).getNode()) && StoredVal.hasOneUse() && StoredVal.getOperand(0).hasOneUse() {
        let mut IntVT: MVT = VT.getSimpleVT().changeTypeToInteger();
        if TLI.isTypeLegal(IntVT) {
            let mut SignMask: APInt = getSignMask(VT.getScalarSizeInBits());
            let mut SignOp: u32 = XOR;
            if StoredVal.getOpcode() == FABS {
                SignMask = operator(SignMask);
                SignOp = AND;
            }
            let mut LogicOp: SDValue = DAG.getNode(SignOp, dl, IntVT, DAG.getBitcast(IntVT, StoredVal.getOperand(0)), DAG.getConstant(SignMask, dl, IntVT, false, false));
            return DAG.getStore(St.getChain(), dl, LogicOp, St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
        }
    }
    if combineScalarMinMaxAbsStore(St, dl, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    let mut Fast: u32 = 0;
    if VT.is256BitVector() && StVT == VT && TLI.allowsMemoryAccess(*DAG.getContext(), DAG.getDataLayout(), VT, *St.getMemOperand(), &mut Fast) && !Fast {
        let mut NumElems: u32 = VT.getVectorNumElements();
        if NumElems < 2 {
            return SDValue {};
        }
        return splitVectorStore(St, DAG);
    }
    if St.isNonTemporal() && StVT == VT && St.getAlign().value() < VT.getStoreSize().operator unsigned long long() {
        if VT.is256BitVector() || VT.is512BitVector() {
            let mut NumElems: u32 = VT.getVectorNumElements();
            if NumElems < 2 {
                return SDValue {};
            }
            return splitVectorStore(St, DAG);
        }
        if VT.is128BitVector() && Subtarget.hasSSE2() {
            let mut NTVT: MVT = if Subtarget.hasSSE4A() { v2f64 } else { (if TLI.isTypeLegal(i64) { v2i64 } else { v4i32 }) };
            return scalarizeVectorStore(St, NTVT, DAG);
        }
    }
    if !St.isTruncatingStore() && VT == v16i8 && !Subtarget.hasBWI() && St.getValue().getOpcode() == TRUNCATE && St.getValue().getOperand(0).getValueType() == v16i16 && TLI.isTruncStoreLegal(v16i32, v16i8, St.getAlign(), St.getAddressSpace()) && St.getValue().hasOneUse() && !DCI.isBeforeLegalizeOps() {
        let mut Ext: SDValue = DAG.getNode(ANY_EXTEND, dl, v16i32, St.getValue().getOperand(0));
        return DAG.getTruncStore(St.getChain(), dl, Ext, St.getBasePtr(), v16i8, St.getMemOperand());
    }
    if !St.isTruncatingStore() && (StoredVal.getOpcode() == VTRUNCUS || StoredVal.getOpcode() == VTRUNCS) && StoredVal.hasOneUse() && TLI.isTruncStoreLegal(StoredVal.getOperand(0).getValueType(), VT, St.getAlign(), St.getAddressSpace()) {
        let mut IsSigned: bool = StoredVal.getOpcode() == VTRUNCS;
        return EmitTruncSStore(IsSigned, St.getChain(), dl, StoredVal.getOperand(0), St.getBasePtr(), VT, St.getMemOperand(), DAG);
    }
    if !St.isTruncatingStore() && StoredVal.getOpcode() == VTRUNCSS && StoredVal.hasOneUse() && TLI.isTruncStoreLegal(StoredVal.getOperand(0).getValueType(), VT, St.getAlign(), St.getAddressSpace()) {
        let mut VTs: SDVTList = DAG.getVTList(Other);
        let mut Ops: [3]SDValue = [St.getChain(), StoredVal.getOperand(0), St.getBasePtr()];
        return DAG.getMemIntrinsicNode(VTRUNCSTORESS, dl, VTs, Ops, VT, St.getMemOperand());
    }
    if !St.isTruncatingStore() {
        let mut IsExtractedElement: Closure_213 = Closure_213 {};
        if IsExtractedElement.call(StoredVal) {
            Extract;
        } else {
            let mut Trunc: SDValue = peekThroughOneUseBitcasts(Extract);
            if Trunc.getOpcode() == VTRUNC {
                let mut Src: SDValue = Trunc.getOperand(0);
                let mut DstVT: MVT = Trunc.getSimpleValueType();
                let mut SrcVT: MVT = Src.getSimpleValueType();
                let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
                let mut NumTruncBits: u32 = DstVT.getScalarSizeInBits() * NumSrcElts;
                let mut TruncVT: MVT = getVectorVT(DstVT.getScalarType(), NumSrcElts);
                if NumTruncBits == VT.getSizeInBits().operator unsigned long long() && TLI.isTruncStoreLegal(SrcVT, TruncVT, St.getAlign(), St.getAddressSpace()) {
                    return DAG.getTruncStore(St.getChain(), dl, Src, St.getBasePtr(), TruncVT, St.getMemOperand());
                }
            }
        }
    }
    if St.isTruncatingStore() && VT.isVector() {
        if TLI.isTruncStoreLegal(VT, StVT, St.getAlign(), St.getAddressSpace()) {
            if detectSSatPattern(St.getValue(), St.getMemoryVT(), false) {
                Val;
            } else {
                return EmitTruncSStore(true, St.getChain(), dl, Val, St.getBasePtr(), St.getMemoryVT(), St.getMemOperand(), DAG);
            }
            if detectUSatPattern(St.getValue(), St.getMemoryVT(), DAG, dl) {
                Val;
            } else {
                return EmitTruncSStore(false, St.getChain(), dl, Val, St.getBasePtr(), St.getMemoryVT(), St.getMemOperand(), DAG);
            }
        }
        return SDValue {};
    }
    let mut AddrSpace: u32 = St.getAddressSpace();
    if AddrSpace == PTR64 || AddrSpace == PTR32_SPTR || AddrSpace == PTR32_UPTR {
        let mut PtrVT: MVT = TLI.getPointerTy(DAG.getDataLayout(), 0);
        if PtrVT != St.getBasePtr().getSimpleValueType() {
            let mut Cast: SDValue = DAG.getAddrSpaceCast(dl, PtrVT, St.getBasePtr(), AddrSpace, 0, SDNodeFlags { Flags: None });
            return DAG.getTruncStore(St.getChain(), dl, StoredVal, Cast, St.getPointerInfo(), StVT, St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata { AAInfo: St.getAAInfo(), Ranges: null, MemCacheHint: null });
        }
    }
    if narrowBitOpRMW(St, dl, DAG, DCI, Subtarget) {
        R;
    } else {
        return R;
    }
    if (VT == i16 || VT == i32 || VT == i64) && Subtarget.hasCF() && St.isSimple() {
        let mut Cmov: SDValue = SDValue {};
        if StoredVal.getOpcode() == CMOV {
            Cmov = StoredVal;
        } else if StoredVal.getOpcode() == TRUNCATE && StoredVal.getOperand(0).getOpcode() == CMOV {
            Cmov = StoredVal.getOperand(0);
        } else {
            return SDValue {};
        }
        let mut Ld: *mut LoadSDNode = dyn_cast(St.getChain());
        if !Ld || !Ld.isSimple() || Ld.getBasePtr() != St.getBasePtr() {
            return SDValue {};
        }
        let mut InvertCC: bool = false;
        let mut V: SDValue = SDValue { Node: Ld, ResNo: 0 };
        if V == Cmov.getOperand(1) {
            InvertCC = true;
        } else if V != Cmov.getOperand(0) {
            return SDValue {};
        }
        let mut Tys: SDVTList = DAG.getVTList(Other);
        let mut CC: SDValue = Cmov.getOperand(2);
        let mut Src: SDValue = DAG.getAnyExtOrTrunc(Cmov.getOperand(!InvertCC), dl, VT);
        if InvertCC {
            CC = DAG.getTargetConstant(GetOppositeBranchCondition(Cmov.getConstantOperandVal(2) as CondCode), dl, i8, false);
        }
        let mut Ops: [5]SDValue = [St.getChain(), Src, St.getBasePtr(), CC, Cmov.getOperand(3)];
        return DAG.getMemIntrinsicNode(CSTORE, dl, Tys, Ops, VT, St.getMemOperand());
    }
    let mut F: *Function = DAG.getMachineFunction().getFunction();
    let mut NoImplicitFloatOps: bool = F.hasFnAttribute(NoImplicitFloat);
    if Subtarget.useSoftFloat() || NoImplicitFloatOps {
        return SDValue {};
    }
    if VT == i256 || VT == i512 {
        let mut VecVT: MVT = getVectorVT(i64, VT.getSizeInBits().operator unsigned long long() / 64);
        if TLI.isTypeLegal(VecVT) && isNormalStore(St) && mayFoldIntoVector(StoredVal, DAG, Subtarget) {
            return DAG.getStore(St.getChain(), dl, DAG.getBitcast(VecVT, StoredVal), St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
        }
    }
    if VT.getSizeInBits().operator unsigned long long() != 64 {
        return SDValue {};
    }
    if !Subtarget.hasSSE2() || Subtarget.is64Bit() {
        return SDValue {};
    }
    if VT == i64 && isa(St.getValue()) && cast(St.getValue()).isSimple() && St.getChain().hasOneUse() && St.isSimple() {
        let mut Ld: *mut LoadSDNode = cast(St.getValue());
        if !isNormalLoad(Ld) {
            return SDValue {};
        }
        if !Ld.hasNUsesOfValue(1, 0) {
            return SDValue {};
        }
        let mut LdDL: SDLoc = Ld;
        let mut StDL: SDLoc = N;
        Ld.getMemOperand().clearRanges();
        let mut NewLd: SDValue = DAG.getLoad(f64, LdDL, Ld.getChain(), Ld.getBasePtr(), Ld.getMemOperand());
        DAG.makeEquivalentMemoryOrdering(Ld, NewLd);
        return DAG.getStore(St.getChain(), StDL, NewLd, St.getBasePtr(), St.getMemOperand());
    }
    if VT == i64 && St.getOperand(1).getOpcode() == EXTRACT_VECTOR_ELT {
        let mut OldExtract: SDValue = St.getOperand(1);
        let mut ExtOp0: SDValue = OldExtract.getOperand(0);
        let mut VecSize: u32 = ExtOp0.getValueSizeInBits().operator unsigned long long();
        let mut VecVT: EVT = getVectorVT(*DAG.getContext(), f64, VecSize / 64, false);
        let mut BitCast: SDValue = DAG.getBitcast(VecVT, ExtOp0);
        let mut NewExtract: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, dl, f64, BitCast, OldExtract.getOperand(1));
        return DAG.getStore(St.getChain(), dl, NewExtract, St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
    }
    return SDValue {};
}

fn combineVEXTRACT_STORE(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut St: *mut MemIntrinsicSDNode = cast(N);
    let mut StoredVal: SDValue = N.getOperand(1);
    let mut VT: MVT = StoredVal.getSimpleValueType();
    let mut MemVT: EVT = St.getMemoryVT();
    let mut StElts: u32 = MemVT.getSizeInBits().operator unsigned long long() / VT.getScalarSizeInBits();
    let mut DemandedElts: APInt = getLowBitsSet(VT.getVectorNumElements(), StElts);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.SimplifyDemandedVectorElts(StoredVal, DemandedElts, DCI) {
        if N.getOpcode() != DELETED_NODE {
            DCI.AddToWorklist(N);
        }
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn isHorizontalBinOp(HOpcode: u32, LHS: *mut SDValue, RHS: *mut SDValue, DAG: *SelectionDAG, Subtarget: *X86Subtarget, IsCommutative: bool, PostShuffleMask: *mut SmallVectorImpl<int>, ForceHorizOp: bool) -> bool {
    if LHS.isUndef() || RHS.isUndef() {
        return false;
    }
    let mut VT: MVT = LHS.getSimpleValueType();
    assert!((VT.is128BitVector() || VT.is256BitVector()), "Unsupported vector type for horizontal add/sub");
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut GetShuffle: Closure_214 = Closure_214 { DAG: &mut DAG, NumElts: &mut NumElts };
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    let mut LMask: SmallVector<int, 16> = SmallVector<int, 16> {};
    GetShuffle.call(LHS, A, B, LMask);
    let mut C: SDValue = SDValue {};
    let mut D: SDValue = SDValue {};
    let mut RMask: SmallVector<int, 16> = SmallVector<int, 16> {};
    GetShuffle.call(RHS, C, D, RMask);
    let mut NumShuffles: u32 = (if LMask.is_empty() { 0 } else { 1 }) + (if RMask.is_empty() { 0 } else { 1 });
    if NumShuffles == 0 {
        return false;
    }
    if LMask.is_empty() {
        A = LHS;
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            LMask.push(i);
        }
    }
    if RMask.is_empty() {
        C = RHS;
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            RMask.push(i);
        }
    }
    if isUndefOrInRange(LMask, 0, NumElts) {
        B = SDValue {};
    } else if isUndefOrInRange(LMask, NumElts, NumElts * 2) {
        A = SDValue {};
    }
    if isUndefOrInRange(RMask, 0, NumElts) {
        D = SDValue {};
    } else if isUndefOrInRange(RMask, NumElts, NumElts * 2) {
        C = SDValue {};
    }
    if A != C {
        swap(C, D);
        commuteMask(RMask);
    }
    if !(A == C && B == D) {
        return false;
    }
    PostShuffleMask.clear();
    PostShuffleMask.append(NumElts, SM_SentinelUndef);
    let mut Num128BitChunks: u32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumEltsPer128BitChunk: u32 = NumElts / Num128BitChunks;
    let mut NumEltsPer64BitChunk: u32 = NumEltsPer128BitChunk / 2;
    assert!((NumEltsPer128BitChunk % 2 == 0), "Vector type should have an even number of elements in each lane");
    for let mut j: u32 = 0; j != NumElts; j += NumEltsPer128BitChunk {
        for let mut i: u32 = 0; i != NumEltsPer128BitChunk; i += 1 {
            let mut LIdx: i32 = LMask[i + j];
            let mut RIdx: i32 = RMask[i + j];
            if LIdx < 0 || RIdx < 0 || (!A.getNode() && (LIdx < NumElts as i32 || RIdx < NumElts as i32)) || (!B.getNode() && (LIdx >= NumElts as i32 || RIdx >= NumElts as i32)) {
                continue;
            }
            if !((RIdx & 1) == 1 && (LIdx + 1) == RIdx) && !((LIdx & 1) == 1 && (RIdx + 1) == LIdx && IsCommutative) {
                return false;
            }
            let mut Base: i32 = LIdx & ~1;
            let mut Index: i32 = ((Base % NumEltsPer128BitChunk) / 2) + ((Base % NumElts) & ~(NumEltsPer128BitChunk - 1));
            if (B && Base >= NumElts as i32) || (!B && i >= NumEltsPer64BitChunk) {
                Index += NumEltsPer64BitChunk;
            }
            PostShuffleMask[i + j] = Index;
        }
    }
    let mut NewLHS: SDValue = if A.getNode() { A } else { B };
    let mut NewRHS: SDValue = if B.getNode() { B } else { A };
    let mut IsIdentityPostShuffle: bool = isSequentialOrUndefInRange(PostShuffleMask, 0, NumElts, 0, 1);
    if !IsIdentityPostShuffle && !Subtarget.hasAVX2() && VT.isFloatingPoint() && isMultiLaneShuffleMask(128, VT.getScalarSizeInBits(), PostShuffleMask) {
        return false;
    }
    let mut FoundHorizUser: Closure_216 = Closure_216 { HOpcode: &mut HOpcode, VT: &mut VT };
    ForceHorizOp = ForceHorizOp || (any_of(operator(NewLHS).users(), FoundHorizUser) && any_of(operator(NewRHS).users(), FoundHorizUser));
    if !ForceHorizOp && !shouldUseHorizontalOp(NewLHS == NewRHS && (NumShuffles < 2 || !IsIdentityPostShuffle), DAG, Subtarget) {
        return false;
    }
    LHS = NewLHS;
    RHS = NewRHS;
    return true;
}

fn combineToHorizontalAddSub(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Opcode: u32 = N.getOpcode();
    let mut IsAdd: bool = (Opcode == FADD) || (Opcode == ADD) || (Opcode == SADDSAT);
    let mut IsSat: bool = (Opcode == SADDSAT) || (Opcode == SSUBSAT);
    let mut PostShuffleMask: SmallVector<int, 8> = SmallVector<int, 8> {};
    let mut MergableHorizOp: Closure_217 = Closure_217 { N: N };
    let mut CanonicalizeHorizOps: Closure_218 = Closure_218 { PostShuffleMask: &mut PostShuffleMask, VT: &mut VT, DAG: &mut DAG };
    match Opcode {
        FADD => {
            FSUB;
        },
        ADD => {
            SUB;
        },
    }
    return SDValue {};
}

fn combineFMulcFCMulc(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut CombineOpcode: i32 = if N.getOpcode() == VFCMULC { VFMULC } else { VFCMULC };
    let mut combineConjugation: Closure_219 = Closure_219 { LHS: &mut LHS, DAG: &mut DAG, N: &mut N, VT: &mut VT, CombineOpcode: &mut CombineOpcode, RHS: &mut RHS };
    let mut Res: SDValue = SDValue {};
    if combineConjugation.call(Res) {
        return Res;
    }
    swap(LHS, RHS);
    if combineConjugation.call(Res) {
        return Res;
    }
    return Res;
}

fn isCFMulFromFMSUBADD(N: SDValue, DAG: *mut SelectionDAG, A: *mut SDValue, B: *mut SDValue) -> bool {
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut Op2: SDValue = N.getOperand(2);
    let mut matchShufflePattern: Closure_220 = Closure_220 { DAG: &mut DAG };
    let mut matchFMSUBADDPattern: Closure_221 = Closure_221 { B: &mut B, matchShufflePattern: &mut matchShufflePattern, A: &mut A, Op2: &mut Op2 };
    return Op2.getOpcode() == FMUL && (matchFMSUBADDPattern.call(Op0, Op1) || matchFMSUBADDPattern.call(Op1, Op0));
}

fn combineFaddCFmul(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut IsVectorAllNegativeZero: Closure_223 = Closure_223 { DAG: &mut DAG };
    if N.getOpcode() != FADD || !Subtarget.hasFP16() || !N.getFlags().hasAllowContract() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != v8f16 && VT != v16f16 && VT != v32f16 {
        return SDValue {};
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut IsConj: bool = false;
    let mut FAddOp1: SDValue = SDValue {};
    let mut MulOp0: SDValue = SDValue {};
    let mut MulOp1: SDValue = SDValue {};
    let mut CVT: MVT = getVectorVT(f32, VT.getVectorNumElements() / 2);
    let mut GetCFmulFrom: Closure_224 = Closure_224 { MulOp0: &mut MulOp0, MulOp1: &mut MulOp1, IsConj: &mut IsConj, IsVectorAllNegativeZero: &mut IsVectorAllNegativeZero };
    if GetCFmulFrom.call(LHS) {
        FAddOp1 = RHS;
    } else if GetCFmulFrom.call(RHS) {
        FAddOp1 = LHS;
    } else {
        return SDValue {};
    }
    FAddOp1 = DAG.getBitcast(CVT, FAddOp1);
    let mut NewOp: u32 = if IsConj { VFCMADDC } else { VFMADDC };
    let mut CFmul: SDValue = DAG.getNode(NewOp, N, CVT, MulOp0, MulOp1, FAddOp1, N.getFlags());
    return DAG.getBitcast(VT, CFmul);
}

fn combineFaddFsub(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if combineToHorizontalAddSub(N, DAG, Subtarget) {
        HOp;
    } else {
        return HOp;
    }
    if combineFaddCFmul(N, DAG, Subtarget) {
        COp;
    } else {
        return COp;
    }
    return SDValue {};
}

fn combineLRINT_LLRINT(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut DL: SDLoc = N;
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isTypeLegal(VT) {
        return SDValue {};
    }
    if (SrcVT.getScalarType() == f16 && !Subtarget.hasFP16()) || (SrcVT.getScalarType() == f32 && !Subtarget.hasDQI()) {
        return SDValue {};
    }
    if SrcVT == v2f16 {
        SrcVT = v4f16;
        Src = DAG.getNode(CONCAT_VECTORS, DL, SrcVT, Src, DAG.getUNDEF(v2f16));
    }
    if SrcVT == v4f16 {
        SrcVT = v8f16;
        Src = DAG.getNode(CONCAT_VECTORS, DL, SrcVT, Src, DAG.getUNDEF(v4f16));
    } else if SrcVT == v2f32 {
        SrcVT = v4f32;
        Src = DAG.getNode(CONCAT_VECTORS, DL, SrcVT, Src, DAG.getUNDEF(v2f32));
    } else {
        return SDValue {};
    }
    return DAG.getNode(CVTP2SI, DL, VT, Src);
}

fn combinei64TruncSrlConstant(N: SDValue, VT: EVT, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    assert!(N.getOpcode() == SRL, "Unknown shift opcode");
    let mut ValidSrlConst: optional<unsigned int> = DAG.getValidShiftAmount(N, 0);
    if !ValidSrlConst {
        return SDValue {};
    }
    let mut SrlConstVal: u32 = operator(ValidSrlConst);
    let mut Op: SDValue = N.getOperand(0);
    let mut Opcode: u32 = Op.getOpcode();
    assert!(VT == i32 && Op.getValueType() == i64, "Illegal truncation types");
    if (Opcode != ADD && Opcode != OR && Opcode != XOR) || !isa(Op.getOperand(1)) {
        return SDValue {};
    }
    let mut OpConst: *APInt = Op.getConstantOperandAPInt(1);
    if SrlConstVal <= 32 || (Opcode == ADD && OpConst.countr_zero() < SrlConstVal) {
        return SDValue {};
    }
    let mut OpLhsSrl: SDValue = DAG.getNode(SRL, DL, i64, Op.getOperand(0), N.getOperand(1));
    let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, VT, OpLhsSrl);
    let mut NewOpConstVal: APInt = OpConst.lshr(SrlConstVal).trunc(VT.getSizeInBits().operator unsigned long long());
    let mut NewOpConst: SDValue = DAG.getConstant(NewOpConstVal, DL, VT, false, false);
    let mut NewOpNode: SDValue = DAG.getNode(Opcode, DL, VT, Trunc, NewOpConst);
    if Opcode == ADD {
        let mut CleanUpVT: EVT = getIntegerVT(*DAG.getContext(), 64 - SrlConstVal);
        return DAG.getZeroExtendInReg(NewOpNode, DL, CleanUpVT);
    }
    return NewOpNode;
}

fn combineTruncatedArithmetic(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, DL: *SDLoc) -> SDValue {
    assert!(N.getOpcode() == TRUNCATE, "Wrong opcode");
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcOpcode: u32 = Src.getOpcode();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut IsFreeTruncation: Closure_225 = Closure_225 { cap_0: VT };
    let mut TruncateArithmetic: Closure_226 = Closure_226 { DAG: &mut DAG, DL: &mut DL, VT: &mut VT, SrcOpcode: &mut SrcOpcode };
    if !Src.hasOneUse() {
        return SDValue {};
    }
    if VT == i32 && SrcVT == i64 && SrcOpcode == SRL {
        return combinei64TruncSrlConstant(Src, VT, DAG, DL);
    }
    if !VT.isVector() {
        return SDValue {};
    }
    match SrcOpcode {
        MUL => {
            if SrcVT.getScalarType() == i64 && TLI.isOperationLegal(SrcOpcode, VT) && !TLI.isOperationLegal(SrcOpcode, SrcVT) {
                return TruncateArithmetic.call(Src.getOperand(0), Src.getOperand(1));
            }
        },
        AND => {
            XOR;
        },
    }
    return SDValue {};
}

fn combinePMULH(Src: SDValue, VT: EVT, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    if !VT.isVectorOf(i16) {
        return SDValue {};
    }
    let mut InVT: EVT = Src.getValueType();
    if InVT.getVectorElementType().getSizeInBits().operator unsigned long long() < 32 {
        return SDValue {};
    }
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    let mut ShiftAmt: APInt = APInt {};
    if !sd_match(Src, m_Srl(m_Mul(m_Value(LHS), m_Value(RHS)), m_ConstInt(ShiftAmt))) {
        return SDValue {};
    }
    if ShiftAmt.ult(16) || ShiftAmt.uge(32) {
        return SDValue {};
    }
    let mut AdditionalShift: u64 = ShiftAmt.getZExtValue() - 16;
    let mut IsSext: Closure_227 = Closure_227 { DAG: &mut DAG };
    let mut IsZext: Closure_228 = Closure_228 { DAG: &mut DAG };
    let mut IsSigned: bool = IsSext.call(LHS) && IsSext.call(RHS);
    let mut IsUnsigned: bool = IsZext.call(LHS) && IsZext.call(RHS);
    if !IsSigned && !IsUnsigned {
        return SDValue {};
    }
    let mut isOpTruncateFree: Closure_229 = Closure_229 {};
    let mut IsTruncateFree: bool = isOpTruncateFree.call(LHS) && isOpTruncateFree.call(RHS);
    let mut InSizeInBits: u32 = InVT.getSizeInBits().operator unsigned long long();
    if IsUnsigned && !IsTruncateFree && Subtarget.hasInt256() && !(Subtarget.hasAVX512() && !Subtarget.hasBWI() && VT.is256BitVector()) && (InSizeInBits % 16) == 0 {
        let mut BCVT: EVT = getVectorVT(*DAG.getContext(), i16, InVT.getSizeInBits().operator unsigned long long() / 16, false);
        let mut Res: SDValue = DAG.getNode(MULHU, DL, BCVT, DAG.getBitcast(BCVT, LHS), DAG.getBitcast(BCVT, RHS));
        Res = DAG.getNode(TRUNCATE, DL, VT, DAG.getBitcast(InVT, Res));
        return DAG.getNode(SRL, DL, VT, Res, DAG.getShiftAmountConstant(AdditionalShift, VT, DL));
    }
    LHS = DAG.getNode(TRUNCATE, DL, VT, LHS);
    RHS = DAG.getNode(TRUNCATE, DL, VT, RHS);
    let mut Opc: u32 = if IsSigned { MULHS } else { MULHU };
    let mut Res: SDValue = DAG.getNode(Opc, DL, VT, LHS, RHS);
    let mut ShiftOpc: u32 = SRL;
    if IsSigned && InVT.getScalarSizeInBits() > 32 {
        ShiftOpc = SRA;
    }
    return DAG.getNode(ShiftOpc, DL, VT, Res, DAG.getShiftAmountConstant(AdditionalShift, VT, DL));
}

fn detectPMADDUBSW(In: SDValue, VT: EVT, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, DL: *SDLoc) -> SDValue {
    if !VT.isVector() || !Subtarget.hasSSSE3() {
        return SDValue {};
    }
    let mut NumElems: u32 = VT.getVectorNumElements();
    let mut ScalarVT: EVT = VT.getVectorElementType();
    if ScalarVT != i16 || NumElems < 8 || !isPowerOf2_32(NumElems) {
        return SDValue {};
    }
    let mut SSatVal: SDValue = detectSSatPattern(In, VT, false);
    if !SSatVal {
        return SDValue {};
    }
    let mut N00: SDValue = SDValue {};
    let mut N01: SDValue = SDValue {};
    let mut N10: SDValue = SDValue {};
    let mut N11: SDValue = SDValue {};
    if !sd_match(SSatVal, m_Add(m_Mul(m_ZExt(m_Value(N00)), m_SExt(m_Value(N01))), m_Mul(m_ZExt(m_Value(N10)), m_SExt(m_Value(N11))))) {
        return SDValue {};
    }
    if N00.getValueType().getVectorElementType() != i8 || N01.getValueType().getVectorElementType() != i8 || N10.getValueType().getVectorElementType() != i8 || N11.getValueType().getVectorElementType() != i8 {
        return SDValue {};
    }
    if N00.getOpcode() != BUILD_VECTOR || N01.getOpcode() != BUILD_VECTOR || N10.getOpcode() != BUILD_VECTOR || N11.getOpcode() != BUILD_VECTOR {
        return SDValue {};
    }
    let mut ZExtIn: SDValue = SDValue {};
    let mut SExtIn: SDValue = SDValue {};
    for let mut i: u32 = 0; i != NumElems; i += 1 {
        let mut N00Elt: SDValue = N00.getOperand(i);
        let mut N01Elt: SDValue = N01.getOperand(i);
        let mut N10Elt: SDValue = N10.getOperand(i);
        let mut N11Elt: SDValue = N11.getOperand(i);
        if N00Elt.getOpcode() != EXTRACT_VECTOR_ELT || N01Elt.getOpcode() != EXTRACT_VECTOR_ELT || N10Elt.getOpcode() != EXTRACT_VECTOR_ELT || N11Elt.getOpcode() != EXTRACT_VECTOR_ELT {
            return SDValue {};
        }
        let mut ConstN00Elt: *mut ConstantSDNode = dyn_cast(N00Elt.getOperand(1));
        let mut ConstN01Elt: *mut ConstantSDNode = dyn_cast(N01Elt.getOperand(1));
        let mut ConstN10Elt: *mut ConstantSDNode = dyn_cast(N10Elt.getOperand(1));
        let mut ConstN11Elt: *mut ConstantSDNode = dyn_cast(N11Elt.getOperand(1));
        if !ConstN00Elt || !ConstN01Elt || !ConstN10Elt || !ConstN11Elt {
            return SDValue {};
        }
        let mut IdxN00: u32 = ConstN00Elt.getZExtValue();
        let mut IdxN01: u32 = ConstN01Elt.getZExtValue();
        let mut IdxN10: u32 = ConstN10Elt.getZExtValue();
        let mut IdxN11: u32 = ConstN11Elt.getZExtValue();
        if IdxN00 > IdxN10 {
            swap(IdxN00, IdxN10);
            swap(IdxN01, IdxN11);
        }
        if IdxN00 != 2 * i || IdxN10 != 2 * i + 1 || IdxN01 != 2 * i || IdxN11 != 2 * i + 1 {
            return SDValue {};
        }
        let mut N00In: SDValue = N00Elt.getOperand(0);
        let mut N01In: SDValue = N01Elt.getOperand(0);
        let mut N10In: SDValue = N10Elt.getOperand(0);
        let mut N11In: SDValue = N11Elt.getOperand(0);
        if !ZExtIn {
            ZExtIn = N00In;
            SExtIn = N01In;
        }
        if ZExtIn != N00In || SExtIn != N01In || ZExtIn != N10In || SExtIn != N11In {
            return SDValue {};
        }
    }
    let mut ExtractVec: Closure_230 = Closure_230 { DAG: &mut DAG, DL: &mut DL, NumElems: NumElems };
    ExtractVec.call(ZExtIn);
    ExtractVec.call(SExtIn);
    let mut PMADDBuilder: Closure_231 = Closure_231 {};
    return SplitOpsAndApply(DAG, Subtarget, DL, VT, [ZExtIn, SExtIn], PMADDBuilder, true, true);
}

fn combineTruncate(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut DL: SDLoc = N;
    if combineTruncatedArithmetic(N, DAG, Subtarget, DL) {
        V;
    } else {
        return V;
    }
    if detectPMADDUBSW(Src, VT, DAG, Subtarget, DL) {
        PMAdd;
    } else {
        return PMAdd;
    }
    if combineTruncateWithSat(Src, VT, DL, DAG, Subtarget) {
        Val;
    } else {
        return Val;
    }
    if combinePMULH(Src, VT, DL, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if SrcVT.isScalarInteger() && Src.getOpcode() == SRL && Src.hasOneUse() && isNormalLoad(Src.getOperand(0).getNode()) && (Src.getOperand(0).hasOneUse() || !DAG.getTargetLoweringInfo().isOperationLegal(LOAD, SrcVT)) {
        let mut Ld: *mut LoadSDNode = cast(Src.getOperand(0));
        if Ld.isSimple() && VT.isByteSized() && isPowerOf2_64(VT.getSizeInBits().operator unsigned long long()) {
            let mut ShAmt: SDValue = Src.getOperand(1);
            let mut KnownAmt: KnownBits = DAG.computeKnownBits(ShAmt, 0);
            if KnownAmt.countMinTrailingZeros() >= 3 && KnownAmt.getMaxValue().ule(SrcVT.getSizeInBits() - VT.getSizeInBits().operator unsigned long long()) && none_of(Ld.uses(), Closure_232 { ShAmt: &mut ShAmt }) {
                let mut PtrVT: EVT = Ld.getBasePtr().getValueType();
                let mut PtrBitOfs: SDValue = DAG.getZExtOrTrunc(ShAmt, DL, PtrVT);
                let mut PtrByteOfs: SDValue = DAG.getNode(SRL, DL, PtrVT, PtrBitOfs, DAG.getShiftAmountConstant(3, PtrVT, DL));
                let mut NewPtr: SDValue = DAG.getMemBasePlusOffset(Ld.getBasePtr(), PtrByteOfs, DL, NoUnsignedWrap);
                let mut NewLoad: SDValue = DAG.getLoad(VT, DL, Ld.getChain(), NewPtr, MachinePointerInfo { Ld.getPointerInfo().getAddrSpace(), 0 }, Align {}, Ld.getMemOperand().getFlags(), MMOMetadata {});
                DAG.makeEquivalentMemoryOrdering(Ld, NewLoad);
                return NewLoad;
            }
        }
    }
    if Src.getOpcode() == BITCAST && VT == i32 {
        let mut BCSrc: SDValue = Src.getOperand(0);
        if BCSrc.getValueType() == x86mmx {
            return DAG.getNode(MMX_MOVD2W, DL, i32, BCSrc);
        }
    }
    return SDValue {};
}

fn combineVTRUNC(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut In: SDValue = N.getOperand(0);
    let mut DL: SDLoc = N;
    if detectSSatPattern(In, VT, false) {
        SSatVal;
    } else {
        return DAG.getNode(VTRUNCS, DL, VT, SSatVal);
    }
    if detectUSatPattern(In, VT, DAG, DL) {
        USatVal;
    } else {
        return DAG.getNode(VTRUNCUS, DL, VT, USatVal);
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DemandedMask: APInt = getAllOnes(VT.getScalarSizeInBits());
    if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, DemandedMask, DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn combineVTRUNCSAT(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Opc: u32 = N.getOpcode();
    let mut VT: EVT = N.getValueType(0);
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    assert!((Opc == VTRUNCS || Opc == VTRUNCUS), "Unexpected VTRUNC node");
    assert!((VT.is128BitVector() || VT.is256BitVector()), "Unexpected VTRUNC node type");
    let mut Src: SDValue = SDValue {};
    if EltSizeInBits <= 16 && (sd_match(N, m_UnaryOp(VTRUNCS, m_Value(Src))) || sd_match(N, m_UnaryOp(VTRUNCUS, m_SMaxLike(m_Value(Src), m_Zero(false))))) && (EltSizeInBits * 2) == Src.getScalarValueSizeInBits() && isFreeToSplitVector(Src, DAG) {
        let mut DL: SDLoc = N;
        let mut LHS: SDValue = SDValue {};
        let mut RHS: SDValue = SDValue {};
        if Src.getValueSizeInBits() == VT.getSizeInBits() {
            assert!(VT.is128BitVector(), "128-bit VTRUNC source expected");
            LHS = Src;
            RHS = getZeroVector(Src.getSimpleValueType(), Subtarget, DAG, DL);
        } else {
            tie(LHS, RHS) = splitVector(Src, DAG, DL);
        }
        assert!(LHS.getValueSizeInBits() == VT.getSizeInBits() && RHS.getValueSizeInBits() == VT.getSizeInBits(), "PACK src/dst size mismatch");
        let mut PackOpc: u32 = if Opc == VTRUNCS { PACKSS } else { PACKUS };
        let mut Pack: SDValue = DAG.getNode(PackOpc, DL, VT, LHS, RHS);
        if VT.is128BitVector() {
            return Pack;
        }
        return DAG.getBitcast(VT, DAG.getNode(VPERMI, DL, v4i64, DAG.getBitcast(v4i64, Pack), getV4X86ShuffleImm8ForMask([0, 2, 1, 3], DL, DAG)));
    }
    return SDValue {};
}

fn isFNEG(DAG: *mut SelectionDAG, N: *mut SDNode, Depth: u32) -> SDValue {
    if N.getOpcode() == FNEG {
        return N.getOperand(0);
    }
    if Depth > MaxRecursionDepth {
        return SDValue {};
    }
    let mut ScalarSize: u32 = N.getValueType(0).getScalarSizeInBits();
    let mut Op: SDValue = peekThroughBitcasts(SDValue { Node: N, ResNo: 0 });
    let mut VT: EVT = operator(Op).getValueType(0);
    if VT.getScalarSizeInBits() != ScalarSize {
        return SDValue {};
    }
    let mut Opc: u32 = Op.getOpcode();
    match Opc {
        VECTOR_SHUFFLE => {
            if !Op.getOperand(1).isUndef() {
                return SDValue {};
            }
            if isFNEG(DAG, Op.getOperand(0).getNode(), Depth + 1) {
                NegOp0;
            } else if NegOp0.getValueType() == VT {
                return DAG.getVectorShuffle(VT, Op, NegOp0, DAG.getUNDEF(VT), cast(Op).getMask());
            }
            break;
        },
        CONCAT_VECTORS => {
            let mut SubOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
            if collectConcatOps(N, SubOps, DAG) && all_of(SubOps, Closure_233 {}) {
                for SubOp in SubOps {
                    SubOp = SubOp.getOperand(0);
                }
                return DAG.getNode(CONCAT_VECTORS, Op, VT, SubOps);
            }
            break;
        },
        INSERT_VECTOR_ELT => {
            let mut InsVector: SDValue = Op.getOperand(0);
            let mut InsVal: SDValue = Op.getOperand(1);
            if !InsVector.isUndef() {
                return SDValue {};
            }
            if isFNEG(DAG, InsVal.getNode(), Depth + 1) {
                NegInsVal;
            } else if NegInsVal.getValueType() == VT.getVectorElementType() {
                return DAG.getNode(INSERT_VECTOR_ELT, Op, VT, InsVector, NegInsVal, Op.getOperand(2));
            }
            break;
        },
        FSUB => {
            XOR;
        },
    }
    return SDValue {};
}

fn negateFMAOpcode(Opcode: u32, NegMul: bool, NegAcc: bool, NegRes: bool) -> u32 {
    if NegMul {
        match Opcode {
            _ => {
                llvm_unreachable_internal("Unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 56929);
            },
            FMA => {
                Opcode = FNMADD;
            },
            STRICT_FMA => {
                Opcode = STRICT_FNMADD;
            },
            FMADD_RND => {
                Opcode = FNMADD_RND;
            },
            FMSUB => {
                Opcode = FNMSUB;
            },
            STRICT_FMSUB => {
                Opcode = STRICT_FNMSUB;
            },
            FMSUB_RND => {
                Opcode = FNMSUB_RND;
            },
            FNMADD => {
                Opcode = FMA;
            },
            STRICT_FNMADD => {
                Opcode = STRICT_FMA;
            },
            FNMADD_RND => {
                Opcode = FMADD_RND;
            },
            FNMSUB => {
                Opcode = FMSUB;
            },
            STRICT_FNMSUB => {
                Opcode = STRICT_FMSUB;
            },
            FNMSUB_RND => {
                Opcode = FMSUB_RND;
            },
        }
    }
    if NegAcc {
        match Opcode {
            _ => {
                llvm_unreachable_internal("Unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 56949);
            },
            FMA => {
                Opcode = FMSUB;
            },
            STRICT_FMA => {
                Opcode = STRICT_FMSUB;
            },
            FMADD_RND => {
                Opcode = FMSUB_RND;
            },
            FMSUB => {
                Opcode = FMA;
            },
            STRICT_FMSUB => {
                Opcode = STRICT_FMA;
            },
            FMSUB_RND => {
                Opcode = FMADD_RND;
            },
            FNMADD => {
                Opcode = FNMSUB;
            },
            STRICT_FNMADD => {
                Opcode = STRICT_FNMSUB;
            },
            FNMADD_RND => {
                Opcode = FNMSUB_RND;
            },
            FNMSUB => {
                Opcode = FNMADD;
            },
            STRICT_FNMSUB => {
                Opcode = STRICT_FNMADD;
            },
            FNMSUB_RND => {
                Opcode = FNMADD_RND;
            },
            FMADDSUB => {
                Opcode = FMSUBADD;
            },
            FMADDSUB_RND => {
                Opcode = FMSUBADD_RND;
            },
            FMSUBADD => {
                Opcode = FMADDSUB;
            },
            FMSUBADD_RND => {
                Opcode = FMADDSUB_RND;
            },
        }
    }
    if NegRes {
        match Opcode {
            _ => {
                llvm_unreachable_internal("Unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 56974);
            },
            FMA => {
                Opcode = FNMSUB;
            },
            FMADD_RND => {
                Opcode = FNMSUB_RND;
            },
            FMSUB => {
                Opcode = FNMADD;
            },
            FMSUB_RND => {
                Opcode = FNMADD_RND;
            },
            FNMADD => {
                Opcode = FMSUB;
            },
            FNMADD_RND => {
                Opcode = FMSUB_RND;
            },
            FNMSUB => {
                Opcode = FMA;
            },
            FNMSUB_RND => {
                Opcode = FMADD_RND;
            },
        }
    }
    return Opcode;
}

fn combineFneg(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut OrigVT: EVT = N.getValueType(0);
    let mut Arg: SDValue = isFNEG(DAG, N, 0);
    if !Arg {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut VT: EVT = Arg.getValueType();
    let mut SVT: EVT = VT.getScalarType();
    let mut DL: SDLoc = N;
    if !TLI.isTypeLegal(VT) {
        return SDValue {};
    }
    if Arg.getOpcode() == FMUL && (SVT == f32 || SVT == f64) && operator(Arg).getFlags().hasNoSignedZeros() && Subtarget.hasAnyFMA() {
        let mut Zero: SDValue = DAG.getConstantFP(0.0, DL, VT, false);
        let mut NewNode: SDValue = DAG.getNode(FNMSUB, DL, VT, Arg.getOperand(0), Arg.getOperand(1), Zero);
        return DAG.getBitcast(OrigVT, NewNode);
    }
    let mut CodeSize: bool = DAG.getMachineFunction().getFunction().hasOptSize();
    let mut LegalOperations: bool = !DCI.isBeforeLegalizeOps();
    if TLI.getNegatedExpression(Arg, DAG, LegalOperations, CodeSize, 0) {
        NegArg;
    } else {
        return DAG.getBitcast(OrigVT, NegArg);
    }
    return SDValue {};
}

fn X86TargetLowering::getNegatedExpression(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, LegalOperations: bool, ForCodeSize: bool, Cost: *mut NegatibleCost, Depth: u32) -> SDValue {
    if isFNEG(DAG, Op.getNode(), Depth) {
        Arg;
    } else {
        Cost = Cheaper;
        return DAG.getBitcast(Op.getValueType(), Arg);
    }
    let mut VT: EVT = Op.getValueType();
    let mut SVT: EVT = VT.getScalarType();
    let mut Opc: u32 = Op.getOpcode();
    let mut Flags: SDNodeFlags = Op.getNode().getFlags();
    match Opc {
        FMA => {
            FMSUB;
        },
        FRCP => {
            if self.getNegatedExpression(Op.getOperand(0), DAG, LegalOperations, ForCodeSize, Cost, Depth + 1) {
                NegOp0;
            } else {
                return DAG.getNode(Opc, Op, VT, NegOp0);
            }
        },
    }
    return self.getNegatedExpression(Op, DAG, LegalOperations, ForCodeSize, Cost, Depth);
}

fn combineX86FPLogicOp(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut WillFold: bool = false;
    if DAG.getTargetLoweringInfo().isCommutativeBinOp(N.getOpcode()) {
        WillFold |= Op0.isUndef() || Op1.isUndef();
        WillFold |= Op0.getOpcode() == ConstantFP && Op1.getOpcode() == ConstantFP;
    }
    if !WillFold && (!VT.isVector() || !Subtarget.hasSSE2()) {
        return SDValue {};
    }
    let mut dl: SDLoc = N;
    let mut IntVT: MVT = VT.changeTypeToInteger();
    Op0 = DAG.getBitcast(IntVT, Op0);
    Op1 = DAG.getBitcast(IntVT, Op1);
    let mut IntOpcode: u32 = 0;
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected FP logic op", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 57128);
        },
        FOR => {
            IntOpcode = OR;
        },
        FXOR => {
            IntOpcode = XOR;
        },
        FAND => {
            IntOpcode = AND;
        },
        FANDN => {
            IntOpcode = ANDNP;
        },
    }
    let mut IntOp: SDValue = DAG.getNode(IntOpcode, dl, IntVT, Op0, Op1);
    return DAG.getBitcast(VT, IntOp);
}

fn foldXor1SetCC(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != XOR {
        return SDValue {};
    }
    let mut LHS: SDValue = N.getOperand(0);
    if !isOneConstant(N.getOperand(1)) || operator(LHS).getOpcode() != SETCC {
        return SDValue {};
    }
    let mut NewCC: CondCode = GetOppositeBranchCondition(operator(LHS).getConstantOperandVal(0));
    return getSETCC(NewCC, operator(LHS).getOperand(1), DL, DAG);
}

fn combineXorWithGF2P8AFFINEQB(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, VT: EVT) -> SDValue {
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut XorOp: SDValue = SDValue {};
    let mut Imm: APInt = APInt {};
    let mut ConstUndef: APInt = APInt {};
    if !sd_match(N, m_Xor(m_OneUse(m_TernaryOp(GF2P8AFFINEQB, m_Value(X), m_Value(Y), m_ConstInt(Imm))), m_Value(XorOp))) {
        return SDValue {};
    }
    assert!((VT == v16i8 || VT == v32i8 || VT == v64i8), "Unsupported GFNI type");
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut YEltBits: SmallVector<APInt> = SmallVector<APInt> {};
    if X == XorOp && getTargetConstantBitsFromNode(Y, 8, ConstUndef, YEltBits, false, false) {
        let mut IdentityMatrix: [8]u8 = [128, 64, 32, 16, 8, 4, 2, 1];
        let mut BuildMatrix: SmallVector<SDValue> = SmallVector<SDValue> {};
        for let mut I: u32 = 0; I != NumElts; I += 1 {
            let mut MatrixRow: APInt = YEltBits[I] ^ IdentityMatrix[I % 8];
            BuildMatrix.push(DAG.getConstant(MatrixRow, DL, i8, false, false));
        }
        let mut NewMatrix: SDValue = DAG.getBuildVector(VT, DL, BuildMatrix);
        return DAG.getNode(GF2P8AFFINEQB, DL, VT, X, NewMatrix, DAG.getTargetConstant(Imm, DL, i8, false));
    }
    let mut SplatVal: APInt = APInt {};
    if !isConstantSplat(XorOp, SplatVal, false) {
        return SDValue {};
    }
    let mut NewImm: u64 = Imm.getZExtValue() ^ SplatVal.getZExtValue();
    return DAG.getNode(GF2P8AFFINEQB, DL, VT, X, Y, DAG.getTargetConstant(NewImm, DL, i8, false));
}

fn combineXorWithTwoGF2P8AFFINEQB(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, VT: EVT) -> SDValue {
    let mut X0: SDValue = SDValue {};
    let mut X1: SDValue = SDValue {};
    let mut M0: SDValue = SDValue {};
    let mut M1: SDValue = SDValue {};
    let mut Imm0: APInt = APInt {};
    let mut Imm1: APInt = APInt {};
    if !sd_match(N, m_Xor(m_OneUse(m_TernaryOp(GF2P8AFFINEQB, m_Value(X0), m_Value(M0), m_ConstInt(Imm0))), m_OneUse(m_TernaryOp(GF2P8AFFINEQB, m_Value(X1), m_Value(M1), m_ConstInt(Imm1))))) {
        return SDValue {};
    }
    assert!((VT == v16i8 || VT == v32i8 || VT == v64i8), "Unsupported GFNI type");
    if M0 == M1 {
        let mut NewImm: u64 = Imm0.getZExtValue() ^ Imm1.getZExtValue();
        let mut NewSrc: SDValue = DAG.getNode(XOR, DL, VT, X0, X1);
        return DAG.getNode(GF2P8AFFINEQB, DL, VT, NewSrc, M0, DAG.getTargetConstant(NewImm, DL, i8, false));
    }
    if X0 != X1 {
        return SDValue {};
    }
    let mut NewImm: u64 = Imm0.getZExtValue() ^ Imm1.getZExtValue();
    let mut NewMatrix: SDValue = DAG.getNode(XOR, DL, VT, M0, M1);
    return DAG.getNode(GF2P8AFFINEQB, DL, VT, X0, NewMatrix, DAG.getTargetConstant(NewImm, DL, i8, false));
}

fn combineXorSubCTLZ(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!((N.getOpcode() == XOR || N.getOpcode() == SUB), "Invalid opcode for combing with CTLZ");
    if Subtarget.hasFastLZCNT() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != i8 && VT != i16 && VT != i32 && (VT != i64 || !Subtarget.is64Bit()) {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if N0.getOpcode() != CTLZ_ZERO_POISON && N1.getOpcode() != CTLZ_ZERO_POISON {
        return SDValue {};
    }
    let mut OpCTLZ: SDValue = SDValue {};
    let mut OpSizeTM1: SDValue = SDValue {};
    if N1.getOpcode() == CTLZ_ZERO_POISON {
        OpCTLZ = N1;
        OpSizeTM1 = N0;
    } else if N.getOpcode() == SUB {
        return SDValue {};
    } else {
        OpCTLZ = N0;
        OpSizeTM1 = N1;
    }
    if !OpCTLZ.hasOneUse() {
        return SDValue {};
    }
    let mut C: *mut ConstantSDNode = dyn_cast(OpSizeTM1);
    if !C {
        return SDValue {};
    }
    if C.getZExtValue() != OpCTLZ.getValueSizeInBits().operator unsigned long long() - 1 {
        return SDValue {};
    }
    let mut OpVT: EVT = VT;
    let mut Op: SDValue = OpCTLZ.getOperand(0);
    if VT == i8 {
        OpVT = i32;
        Op = DAG.getNode(ZERO_EXTEND, DL, OpVT, Op);
    }
    let mut VTs: SDVTList = DAG.getVTList(OpVT, i32);
    Op = DAG.getNode(BSR, DL, VTs, DAG.getUNDEF(OpVT), Op);
    if VT == i8 {
        Op = DAG.getNode(TRUNCATE, DL, i8, Op);
    }
    return Op;
}

fn combineXor(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    if Subtarget.hasSSE1() && !Subtarget.hasSSE2() && VT == v4i32 {
        return DAG.getBitcast(v4i32, DAG.getNode(FXOR, DL, v4f32, DAG.getBitcast(v4f32, N0), DAG.getBitcast(v4f32, N1)));
    }
    if foldVectorXorShiftIntoCmp(N, DAG, Subtarget) {
        Cmp;
    } else {
        return Cmp;
    }
    if combineMaskBitOp(N, DL, DAG) {
        R;
    } else {
        return R;
    }
    if combineBitOpWithMOVMSK(N.getOpcode(), DL, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if combineBitOpWithShift(N.getOpcode(), DL, VT, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if combineBitOpWithPACK(N.getOpcode(), DL, VT, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if convertIntLogicToFPLogic(N.getOpcode(), DL, VT, N0, N1, DAG, DCI, Subtarget) {
        FPLogic;
    } else {
        return FPLogic;
    }
    if combineXorSubCTLZ(N, DL, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if foldXor1SetCC(N, DL, DAG) {
        SetCC;
    } else {
        return SetCC;
    }
    if combineOrXorWithSETCC(N.getOpcode(), DL, VT, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    if foldXorTruncShiftIntoCmp(N, DL, DAG) {
        RV;
    } else {
        return RV;
    }
    if combineXorWithGF2P8AFFINEQB(N, DL, DAG, VT) {
        R;
    } else {
        return R;
    }
    if combineXorWithTwoGF2P8AFFINEQB(N, DL, DAG, VT) {
        R;
    } else {
        return R;
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if isAllOnesConstant(N1) && N0.getOpcode() == BITCAST && N0.getOperand(0).getValueType().isVector() && N0.getOperand(0).getValueType().getVectorElementType() == i1 && TLI.isTypeLegal(N0.getOperand(0).getValueType()) && N0.hasOneUse() {
        return DAG.getBitcast(VT, DAG.getNOT(DL, N0.getOperand(0), N0.getOperand(0).getValueType()));
    }
    if isBuildVectorAllOnes(N1.getNode()) && VT.isVector() && VT.getVectorElementType() == i1 && N0.getOpcode() == INSERT_SUBVECTOR && N0.getOperand(0).isUndef() && TLI.isTypeLegal(N0.getOperand(1).getValueType()) {
        return DAG.getNode(INSERT_SUBVECTOR, DL, VT, N0.getOperand(0), DAG.getNOT(DL, N0.getOperand(1), N0.getOperand(1).getValueType()), N0.getOperand(2));
    }
    if (N0.getOpcode() == TRUNCATE || N0.getOpcode() == ZERO_EXTEND) && N0.getOperand(0).getOpcode() == N.getOpcode() {
        let mut TruncExtSrc: SDValue = N0.getOperand(0);
        let mut N1C: *mut ConstantSDNode = dyn_cast(N1);
        let mut N001C: *mut ConstantSDNode = dyn_cast(TruncExtSrc.getOperand(1));
        if N1C && !N1C.isOpaque() && N001C && !N001C.isOpaque() {
            let mut LHS: SDValue = DAG.getZExtOrTrunc(TruncExtSrc.getOperand(0), DL, VT);
            let mut RHS: SDValue = DAG.getZExtOrTrunc(TruncExtSrc.getOperand(1), DL, VT);
            return DAG.getNode(XOR, DL, VT, LHS, DAG.getNode(XOR, DL, VT, RHS, N1));
        }
    }
    if combineBMILogicOp(N, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    return combineFneg(N, DAG, DCI, Subtarget);
}

fn combineBITREVERSE(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if VT.isInteger() && N0.getOpcode() == BITCAST && N0.hasOneUse() {
        let mut Src: SDValue = N0.getOperand(0);
        let mut SrcVT: EVT = Src.getValueType();
        if SrcVT.isVectorOf(i1) && (DCI.isBeforeLegalize() || DAG.getTargetLoweringInfo().isTypeLegal(SrcVT)) && Subtarget.hasSSSE3() {
            let mut NumElts: u32 = SrcVT.getVectorNumElements();
            let mut ReverseMask: SmallVector<int, 32> = NumElts;
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                ReverseMask[I] = (NumElts - 1) - I;
            }
            let mut Rev: SDValue = DAG.getVectorShuffle(SrcVT, N, Src, Src, ReverseMask);
            return DAG.getBitcast(VT, Rev);
        }
    }
    return SDValue {};
}

fn combineAVG(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut SVT: EVT = VT.getScalarType();
    let mut DL: SDLoc = N;
    if Opcode == AVGCEILS && VT.isVector() && SVT == i8 {
        let mut SignBit: APInt = getSignMask(VT.getScalarSizeInBits());
        let mut SignMask: SDValue = DAG.getConstant(SignBit, DL, VT, false, false);
        N0 = DAG.getNode(XOR, DL, VT, N0, SignMask);
        N1 = DAG.getNode(XOR, DL, VT, N1, SignMask);
        return DAG.getNode(XOR, DL, VT, DAG.getNode(AVGCEILU, DL, VT, N0, N1), SignMask);
    }
    return SDValue {};
}

fn isNullFPScalarOrVectorConst(V: SDValue) -> bool {
    return isNullFPConstant(V) || isBuildVectorAllZeros(V.getNode());
}

fn getNullFPConstForNullVal(V: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !isNullFPScalarOrVectorConst(V) {
        return SDValue {};
    }
    if V.getValueType().isVector() {
        return getZeroVector(V.getSimpleValueType(), Subtarget, DAG, V);
    }
    return V;
}

fn combineFAndFNotToFAndn(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    if !((VT == f32 && Subtarget.hasSSE1()) || (VT == f64 && Subtarget.hasSSE2()) || (VT == v4f32 && Subtarget.hasSSE1() && !Subtarget.hasSSE2())) {
        return SDValue {};
    }
    let mut isAllOnesConstantFP: Closure_234 = Closure_234 {};
    if N0.getOpcode() == FXOR && isAllOnesConstantFP.call(N0.getOperand(1)) {
        return DAG.getNode(FANDN, DL, VT, N0.getOperand(0), N1);
    }
    if N1.getOpcode() == FXOR && isAllOnesConstantFP.call(N1.getOperand(1)) {
        return DAG.getNode(FANDN, DL, VT, N1.getOperand(0), N0);
    }
    return SDValue {};
}

fn combineFAnd(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if getNullFPConstForNullVal(N.getOperand(0), DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if getNullFPConstForNullVal(N.getOperand(1), DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if combineFAndFNotToFAndn(N, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    return combineX86FPLogicOp(N, DAG, Subtarget);
}

fn combineFAndn(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if isNullFPScalarOrVectorConst(N.getOperand(0)) {
        return N.getOperand(1);
    }
    if getNullFPConstForNullVal(N.getOperand(1), DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    return combineX86FPLogicOp(N, DAG, Subtarget);
}

fn combineFOr(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    assert!(N.getOpcode() == FOR || N.getOpcode() == FXOR);
    if isNullFPScalarOrVectorConst(N.getOperand(0)) {
        return N.getOperand(1);
    }
    if isNullFPScalarOrVectorConst(N.getOperand(1)) {
        return N.getOperand(0);
    }
    if combineFneg(N, DAG, DCI, Subtarget) {
        NewVal;
    } else {
        return NewVal;
    }
    return combineX86FPLogicOp(N, DAG, Subtarget);
}

fn combineFMinFMax(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(N.getOpcode() == PSEUDO_FMIN || N.getOpcode() == PSEUDO_FMAX);
    if !N.getFlags().hasNoNaNs() || !N.getFlags().hasNoSignedZeros() {
        return SDValue {};
    }
    let mut NewOp: u32 = 0;
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("unknown opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 57573);
        },
        PSEUDO_FMIN => {
            NewOp = FMINC;
        },
        PSEUDO_FMAX => {
            NewOp = FMAXC;
        },
    }
    return DAG.getNode(NewOp, N, N.getValueType(0), N.getOperand(0), N.getOperand(1));
}

fn combineFMinNumFMaxNum(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if Subtarget.useSoftFloat() || isSoftF16(VT, Subtarget) {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut IsMinMaxLegal: Closure_235 = Closure_235 { TLI: &mut TLI, Subtarget: &mut Subtarget };
    if !((Subtarget.hasSSE1() && VT == f32) || (Subtarget.hasSSE2() && VT == f64) || (Subtarget.hasFP16() && VT == f16) || (VT.isVector() && IsMinMaxLegal.call(VT))) {
        return SDValue {};
    }
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut DL: SDLoc = N;
    let mut MinMaxOp: NodeType = if N.getOpcode() == FMAXNUM { PSEUDO_FMAX } else { PSEUDO_FMIN };
    if N.getFlags().hasNoNaNs() {
        return DAG.getNode(MinMaxOp, DL, VT, Op0, Op1, N.getFlags());
    }
    if DAG.isKnownNeverNaN(Op1, false, 0) {
        return DAG.getNode(MinMaxOp, DL, VT, Op0, Op1, N.getFlags());
    }
    if DAG.isKnownNeverNaN(Op0, false, 0) {
        return DAG.getNode(MinMaxOp, DL, VT, Op1, Op0, N.getFlags());
    }
    if !VT.isVector() && DAG.getMachineFunction().getFunction().hasMinSize() {
        return SDValue {};
    }
    let mut SetCCType: EVT = TLI.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut MinOrMax: SDValue = DAG.getNode(MinMaxOp, DL, VT, Op1, Op0);
    let mut IsOp0Nan: SDValue = DAG.getSetCC(DL, SetCCType, Op0, Op0, SETUO, SDValue {}, false, None);
    return DAG.getSelect(DL, VT, IsOp0Nan, Op1, MinOrMax, SDNodeFlags { Flags: None });
}

fn combineX86INT_TO_FP(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DemandedElts: APInt = getAllOnes(VT.getVectorNumElements());
    if TLI.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }, DemandedElts, DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    let mut In: SDValue = N.getOperand(0);
    let mut InVT: MVT = In.getSimpleValueType();
    if VT.getVectorNumElements() < InVT.getVectorNumElements() && isNormalLoad(In.getNode()) && In.hasOneUse() {
        assert!(InVT.is128BitVector(), "Expected 128-bit input vector");
        let mut LN: *mut LoadSDNode = cast(N.getOperand(0));
        let mut NumBits: u32 = InVT.getScalarSizeInBits() * VT.getVectorNumElements();
        let mut MemVT: MVT = getIntegerVT(NumBits);
        let mut LoadVT: MVT = getVectorVT(MemVT, 128 / NumBits);
        if narrowLoadToVZLoad(LN, MemVT, LoadVT, DAG) {
            VZLoad;
        } else {
            let mut dl: SDLoc = N;
            let mut Convert: SDValue = DAG.getNode(N.getOpcode(), dl, VT, DAG.getBitcast(InVT, VZLoad));
            DCI.CombineTo(N, Convert, true);
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, VZLoad.getValue(1));
            DCI.recursivelyDeleteUnusedNodes(LN);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    return SDValue {};
}

fn combineCVTP2I_CVTTP2I(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut TSI: *SelectionDAGTargetInfo = DAG.getSelectionDAGInfo();
    let mut IsStrict: bool = TSI.isTargetStrictFPOpcode(N.getOpcode());
    let mut VT: EVT = N.getValueType(0);
    let mut In: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut InVT: MVT = In.getSimpleValueType();
    if VT.getVectorNumElements() < InVT.getVectorNumElements() && isNormalLoad(In.getNode()) && In.hasOneUse() {
        assert!(InVT.is128BitVector(), "Expected 128-bit input vector");
        let mut LN: *mut LoadSDNode = cast(In);
        let mut NumBits: u32 = InVT.getScalarSizeInBits() * VT.getVectorNumElements();
        let mut MemVT: MVT = getFloatingPointVT(NumBits);
        let mut LoadVT: MVT = getVectorVT(MemVT, 128 / NumBits);
        if narrowLoadToVZLoad(LN, MemVT, LoadVT, DAG) {
            VZLoad;
        } else {
            let mut dl: SDLoc = N;
            if IsStrict {
                let mut Convert: SDValue = DAG.getNode(N.getOpcode(), dl, [VT, Other], [N.getOperand(0), DAG.getBitcast(InVT, VZLoad)]);
                DCI.CombineTo(N, Convert, Convert.getValue(1), true);
            } else {
                let mut Convert: SDValue = DAG.getNode(N.getOpcode(), dl, VT, DAG.getBitcast(InVT, VZLoad));
                DCI.CombineTo(N, Convert, true);
            }
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, VZLoad.getValue(1));
            DCI.recursivelyDeleteUnusedNodes(LN);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    return SDValue {};
}

fn combineAndnp(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = N;
    if N0.isUndef() || N1.isUndef() {
        return DAG.getConstant(0, DL, VT, false, false);
    }
    if isBuildVectorAllZeros(N0.getNode()) {
        return N1;
    }
    if isBuildVectorAllZeros(N1.getNode()) {
        return DAG.getConstant(0, DL, VT, false, false);
    }
    if isBuildVectorAllOnes(N1.getNode()) {
        return DAG.getNOT(DL, N0, VT);
    }
    if IsNOT(N0, DAG) {
        Not;
    } else {
        return DAG.getNode(AND, DL, VT, DAG.getBitcast(VT, Not), N1);
    }
    if DCI.isAfterLegalizeDAG() && N0.getOpcode() == SIGN_EXTEND {
        let mut Src: SDValue = N0.getOperand(0);
        let mut SrcVT: EVT = Src.getValueType();
        if Src.getOpcode() == SETCC && SrcVT.getScalarType() == i1 && (VT.is512BitVector() || Subtarget.hasVLX()) && (VT.getScalarSizeInBits() >= 32 || Subtarget.hasBWI()) && TLI.isTypeLegal(SrcVT) && N0.hasOneUse() && Src.hasOneUse() {
            return DAG.getSelect(DL, VT, DAG.getNOT(DL, Src, SrcVT), N1, getZeroVector(VT, Subtarget, DAG, DL), SDNodeFlags { Flags: None });
        }
    }
    let mut Undefs0: APInt = APInt {};
    let mut Undefs1: APInt = APInt {};
    let mut EltBits0: SmallVector<APInt> = SmallVector<APInt> {};
    let mut EltBits1: SmallVector<APInt> = SmallVector<APInt> {};
    if getTargetConstantBitsFromNode(N0, EltSizeInBits, Undefs0, EltBits0, true, true) {
        if getTargetConstantBitsFromNode(N1, EltSizeInBits, Undefs1, EltBits1, true, true) {
            let mut ResultBits: SmallVector<APInt> = SmallVector<APInt> {};
            for let mut I: i32 = 0; I != NumElts; I += 1 {
                ResultBits.push(operator(EltBits0[I]) & EltBits1[I]);
            }
            return getConstVector(ResultBits, VT, DAG, DL);
        }
        if operator(N0).hasOneUse() {
            let mut BC0: SDValue = peekThroughOneUseBitcasts(N0);
            if BC0.getOpcode() != BITCAST {
                for Elt in EltBits0 {
                    Elt = operator(Elt);
                }
                let mut Not: SDValue = getConstVector(EltBits0, VT, DAG, DL);
                return DAG.getNode(AND, DL, VT, Not, N1);
            }
        }
    }
    if VT.isVector() && (VT.getScalarSizeInBits() % 8) == 0 {
        let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
        if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
            Res;
        } else {
            return Res;
        }
        let mut GetDemandedMasks: Closure_236 = Closure_236 { EltSizeInBits: &mut EltSizeInBits, NumElts: &mut NumElts };
        let mut Bits0: APInt = APInt {};
        let mut Elts0: APInt = APInt {};
        let mut Bits1: APInt = APInt {};
        let mut Elts1: APInt = APInt {};
        tie(Bits0, Elts0) = GetDemandedMasks.call(N1, false);
        tie(Bits1, Elts1) = GetDemandedMasks.call(N0, true);
        if TLI.SimplifyDemandedVectorElts(N0, Elts0, DCI) || TLI.SimplifyDemandedVectorElts(N1, Elts1, DCI) || TLI.SimplifyDemandedBits(N0, Bits0, Elts0, DCI) || TLI.SimplifyDemandedBits(N1, Bits1, Elts1, DCI) {
            if N.getOpcode() != DELETED_NODE {
                DCI.AddToWorklist(N);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if operator(N1).hasOneUse() {
        if IsNOT(N1, DAG) {
            Not;
        } else {
            return DAG.getNOT(DL, DAG.getNode(OR, DL, VT, N0, DAG.getBitcast(VT, Not)), VT);
        }
        if DAG.ComputeNumSignBits(N0, 0) == EltSizeInBits {
            let mut BC1: SDValue = peekThroughOneUseBitcasts(N1);
            if BC1.getOpcode() == PSHUFB {
                let mut ShufVT: EVT = BC1.getValueType();
                let mut NewMask: SDValue = DAG.getNode(OR, DL, ShufVT, BC1.getOperand(1), DAG.getBitcast(ShufVT, N0));
                let mut NewShuf: SDValue = DAG.getNode(PSHUFB, DL, ShufVT, BC1.getOperand(0), NewMask);
                return DAG.getBitcast(VT, NewShuf);
            }
        }
    }
    return SDValue {};
}

fn peekThroughBitPosExtTrunc(V: SDValue, BW: u32) -> SDValue {
    assert!(V.getScalarValueSizeInBits() >= Log2_32(BW), "bit position type must cover the whole index range");
    let mut LowBits: APInt = getLowBitsSet(V.getScalarValueSizeInBits(), Log2_32(BW));
    for {
        let mut Op: u32 = V.getOpcode();
        if (Op == TRUNCATE || Op == ZERO_EXTEND || Op == ANY_EXTEND) && V.getOperand(0).getScalarValueSizeInBits() >= Log2_32(BW) {
            V = V.getOperand(0);
            LowBits = LowBits.zextOrTrunc(V.getScalarValueSizeInBits());
            continue;
        }
        if Op == AND {
            let mut C: *mut ConstantSDNode = dyn_cast(V.getOperand(1));
            if C && LowBits.isSubsetOf(C.getAPIntValue()) {
                V = V.getOperand(0);
                continue;
            }
        }
        return V;
    }
}

fn combineBTToBitOpFlag(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Src: SDValue = N.getOperand(0);
    let mut BitNo: SDValue = N.getOperand(1);
    let mut VT: EVT = Src.getValueType();
    let mut DL: SDLoc = N;
    assert!((VT == i32 || VT == i64), "X86ISD::BT is only emitted for i32/i64");
    let mut BW: u32 = VT.getScalarSizeInBits();
    let mut PeeledBitNo: SDValue = peekThroughBitPosExtTrunc(BitNo, BW);
    for User in operator(Src).users() {
        if User == N {
            continue;
        }
        let mut FlagOp: u32 = 0;
        let mut ShAmt: SDValue = SDValue {};
        if sd_match(User, m_And(m_Specific(Src), m_OneUse(m_Rotl(m_SpecificInt(getAllOnes(BW) - 1), m_Value(ShAmt))))) {
            FlagOp = BTR;
        } else if sd_match(User, m_Or(m_Specific(Src), m_OneUse(m_Shl(m_SpecificInt(1), m_Value(ShAmt))))) {
            FlagOp = BTS;
        } else if sd_match(User, m_Xor(m_Specific(Src), m_OneUse(m_Shl(m_SpecificInt(1), m_Value(ShAmt))))) {
            FlagOp = BTC;
        } else {
            continue;
        }
        if peekThroughBitPosExtTrunc(ShAmt, BW) != PeeledBitNo {
            continue;
        }
        assert!(BitNo.getValueType() == VT, "BT bit index must match Src type");
        let mut New: SDValue = DAG.getNode(FlagOp, DL, DAG.getVTList(VT, i32), Src, BitNo);
        DAG.ReplaceAllUsesOfValueWith(SDValue { Node: User, ResNo: 0 }, New.getValue(0));
        return New.getValue(1);
    }
    return SDValue {};
}

fn combineBT(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut N1: SDValue = N.getOperand(1);
    let mut BitWidth: u32 = N1.getValueSizeInBits().operator unsigned long long();
    let mut DemandedMask: APInt = getLowBitsSet(BitWidth, Log2_32(BitWidth));
    if DAG.getTargetLoweringInfo().SimplifyDemandedBits(N1, DemandedMask, DCI) {
        if N.getOpcode() != DELETED_NODE {
            DCI.AddToWorklist(N);
        }
        return SDValue { Node: N, ResNo: 0 };
    }
    if combineBTToBitOpFlag(N, DAG) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn combineCVTPH2PS(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut IsStrict: bool = N.getOpcode() == STRICT_CVTPH2PS;
    let mut Src: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    if N.getValueType(0) == v4f32 && Src.getValueType() == v8i16 {
        let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
        let mut DemandedElts: APInt = getLowBitsSet(8, 4);
        if TLI.SimplifyDemandedVectorElts(Src, DemandedElts, DCI) {
            if N.getOpcode() != DELETED_NODE {
                DCI.AddToWorklist(N);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
        if isNormalLoad(Src.getNode()) && Src.hasOneUse() {
            let mut LN: *mut LoadSDNode = cast(N.getOperand(if IsStrict { 1 } else { 0 }));
            if narrowLoadToVZLoad(LN, i64, v2i64, DAG) {
                VZLoad;
            } else {
                let mut dl: SDLoc = N;
                if IsStrict {
                    let mut Convert: SDValue = DAG.getNode(N.getOpcode(), dl, [v4f32, Other], [N.getOperand(0), DAG.getBitcast(v8i16, VZLoad)]);
                    DCI.CombineTo(N, Convert, Convert.getValue(1), true);
                } else {
                    let mut Convert: SDValue = DAG.getNode(N.getOpcode(), dl, v4f32, DAG.getBitcast(v8i16, VZLoad));
                    DCI.CombineTo(N, Convert, true);
                }
                DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, VZLoad.getValue(1));
                DCI.recursivelyDeleteUnusedNodes(LN);
                return SDValue { Node: N, ResNo: 0 };
            }
        }
    }
    return SDValue {};
}

fn combineSextInRegCmov(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(N.getOpcode() == SIGN_EXTEND_INREG);
    let mut DstVT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut ExtraVT: EVT = cast(N1).getVT();
    if ExtraVT != i8 && ExtraVT != i16 {
        return SDValue {};
    }
    let mut IntermediateBitwidthOp: SDValue = SDValue {};
    if (N0.getOpcode() == ANY_EXTEND || N0.getOpcode() == TRUNCATE) && N0.hasOneUse() {
        IntermediateBitwidthOp = N0;
        N0 = N0.getOperand(0);
    }
    if N0.getOpcode() != CMOV || !N0.hasOneUse() {
        return SDValue {};
    }
    let mut CMovOp0: SDValue = N0.getOperand(0);
    let mut CMovOp1: SDValue = N0.getOperand(1);
    if !isa(CMovOp0.getNode()) || !isa(CMovOp1.getNode()) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    if IntermediateBitwidthOp {
        let mut IntermediateOpc: u32 = IntermediateBitwidthOp.getOpcode();
        CMovOp0 = DAG.getNode(IntermediateOpc, DL, DstVT, CMovOp0);
        CMovOp1 = DAG.getNode(IntermediateOpc, DL, DstVT, CMovOp1);
    }
    CMovOp0 = DAG.getNode(SIGN_EXTEND_INREG, DL, DstVT, CMovOp0, N1);
    CMovOp1 = DAG.getNode(SIGN_EXTEND_INREG, DL, DstVT, CMovOp1, N1);
    let mut CMovVT: EVT = DstVT;
    if DstVT == i16 {
        CMovVT = i32;
        CMovOp0 = DAG.getNode(ZERO_EXTEND, DL, CMovVT, CMovOp0);
        CMovOp1 = DAG.getNode(ZERO_EXTEND, DL, CMovVT, CMovOp1);
    }
    let mut CMov: SDValue = DAG.getNode(CMOV, DL, CMovVT, CMovOp0, CMovOp1, N0.getOperand(2), N0.getOperand(3));
    if CMovVT != DstVT {
        CMov = DAG.getNode(TRUNCATE, DL, DstVT, CMov);
    }
    return CMov;
}

fn combineSignExtendInReg(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(N.getOpcode() == SIGN_EXTEND_INREG);
    if combineSextInRegCmov(N, DAG) {
        V;
    } else {
        return V;
    }
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut ExtraVT: EVT = cast(N1).getVT();
    let mut dl: SDLoc = N;
    if VT == v4i64 && (N0.getOpcode() == ANY_EXTEND || N0.getOpcode() == SIGN_EXTEND) {
        let mut N00: SDValue = N0.getOperand(0);
        if N00.getOpcode() == LOAD && Subtarget.hasInt256() {
            if !isNormalLoad(N00.getNode()) {
                return SDValue {};
            }
        }
        if PromoteMaskArithmetic(N0, dl, DAG, Subtarget) {
            Promote;
        } else {
            return DAG.getNode(SIGN_EXTEND_INREG, dl, VT, Promote, N1);
        }
        if N00.getValueType() == v4i32 && ExtraVT.getSizeInBits().operator unsigned long long() < 128 {
            let mut Tmp: SDValue = DAG.getNode(SIGN_EXTEND_INREG, dl, v4i32, N00, N1);
            return DAG.getNode(SIGN_EXTEND, dl, v4i64, Tmp);
        }
    }
    return SDValue {};
}

fn promoteExtBeforeAdd(Ext: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if Ext.getOpcode() != SIGN_EXTEND && Ext.getOpcode() != ZERO_EXTEND {
        return SDValue {};
    }
    let mut VT: EVT = Ext.getValueType(0);
    if VT != i64 {
        return SDValue {};
    }
    let mut Add: SDValue = Ext.getOperand(0);
    if Add.getOpcode() != ADD {
        return SDValue {};
    }
    let mut AddOp0: SDValue = Add.getOperand(0);
    let mut AddOp1: SDValue = Add.getOperand(1);
    let mut Sext: bool = Ext.getOpcode() == SIGN_EXTEND;
    let mut NSW: bool = operator(Add).getFlags().hasNoSignedWrap();
    let mut NUW: bool = operator(Add).getFlags().hasNoUnsignedWrap();
    NSW = NSW || (Sext && DAG.willNotOverflowAdd(true, AddOp0, AddOp1));
    NUW = NUW || (!Sext && DAG.willNotOverflowAdd(false, AddOp0, AddOp1));
    if (Sext && !NSW) || (!Sext && !NUW) {
        return SDValue {};
    }
    let mut AddOp1C: *mut ConstantSDNode = dyn_cast(AddOp1);
    if !AddOp1C {
        return SDValue {};
    }
    let mut HasLEAPotential: bool = false;
    for User in Ext.users() {
        if User.getOpcode() == ADD || User.getOpcode() == SHL {
            HasLEAPotential = true;
            break;
        }
    }
    if !HasLEAPotential {
        return SDValue {};
    }
    let mut AddC: i64 = if Sext { AddOp1C.getSExtValue() } else { AddOp1C.getZExtValue() };
    let mut NewExt: SDValue = DAG.getNode(Ext.getOpcode(), Ext, VT, AddOp0);
    let mut NewConstant: SDValue = DAG.getConstant(AddC, Add, VT, false, false);
    let mut Flags: SDNodeFlags = None;
    Flags.setNoSignedWrap(NSW);
    Flags.setNoUnsignedWrap(NUW);
    return DAG.getNode(ADD, Add, VT, NewExt, NewConstant, Flags);
}

fn combineToExtendCMOV(Extend: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut CMovN: SDValue = Extend.getOperand(0);
    if CMovN.getOpcode() != CMOV || !CMovN.hasOneUse() {
        return SDValue {};
    }
    let mut TargetVT: EVT = Extend.getValueType(0);
    let mut ExtendOpcode: u32 = Extend.getOpcode();
    let mut DL: SDLoc = Extend;
    let mut VT: EVT = CMovN.getValueType();
    let mut CMovOp0: SDValue = CMovN.getOperand(0);
    let mut CMovOp1: SDValue = CMovN.getOperand(1);
    if !isa(CMovOp0.getNode()) || !isa(CMovOp1.getNode()) {
        return SDValue {};
    }
    if TargetVT != i32 && TargetVT != i64 {
        return SDValue {};
    }
    if VT != i16 && !(ExtendOpcode == SIGN_EXTEND && VT == i32) {
        return SDValue {};
    }
    let mut ExtendVT: EVT = TargetVT;
    if TargetVT == i64 && ExtendOpcode != SIGN_EXTEND {
        ExtendVT = i32;
    }
    CMovOp0 = DAG.getNode(ExtendOpcode, DL, ExtendVT, CMovOp0);
    CMovOp1 = DAG.getNode(ExtendOpcode, DL, ExtendVT, CMovOp1);
    let mut Res: SDValue = DAG.getNode(CMOV, DL, ExtendVT, CMovOp0, CMovOp1, CMovN.getOperand(2), CMovN.getOperand(3));
    if ExtendVT != TargetVT {
        Res = DAG.getNode(ExtendOpcode, DL, TargetVT, Res);
    }
    return Res;
}

fn combineExtSetcc(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = N;
    if !Subtarget.hasAVX512() || !VT.isVector() || N0.getOpcode() != SETCC {
        return SDValue {};
    }
    let mut SVT: EVT = VT.getVectorElementType();
    if SVT != i8 && SVT != i16 && SVT != i32 && SVT != i64 && SVT != f32 && SVT != f64 {
        return SDValue {};
    }
    if N0.getOperand(0).getValueType().getVectorElementType() == f16 {
        return SDValue {};
    }
    let mut Size: u32 = VT.getSizeInBits().operator unsigned long long();
    if Size > 256 && Subtarget.useAVX512Regs() {
        return SDValue {};
    }
    let mut N00VT: EVT = N0.getOperand(0).getValueType();
    let mut CC: CondCode = cast(N0.getOperand(2)).get();
    if N00VT.isInteger() && isUnsignedIntSetCC(CC) {
        return SDValue {};
    }
    let mut MatchingVecType: EVT = N00VT.changeVectorElementTypeToInteger();
    if Size != MatchingVecType.getSizeInBits().operator unsigned long long() {
        return SDValue {};
    }
    let mut Res: SDValue = DAG.getSetCC(dl, VT, N0.getOperand(0), N0.getOperand(1), CC, SDValue {}, false, None);
    if N.getOpcode() == ZERO_EXTEND {
        Res = DAG.getZeroExtendInReg(Res, dl, N0.getValueType());
    }
    return Res;
}

fn combineSext(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    if !DCI.isBeforeLegalizeOps() && N0.getOpcode() == SETCC_CARRY {
        let mut Setcc: SDValue = DAG.getNode(SETCC_CARRY, DL, VT, operator(N0).getOperand(0), operator(N0).getOperand(1));
        let mut ReplaceOtherUses: bool = !N0.hasOneUse();
        DCI.CombineTo(N, Setcc, true);
        if ReplaceOtherUses {
            let mut Trunc: SDValue = DAG.getNode(TRUNCATE, N0, N0.getValueType(), Setcc);
            DCI.CombineTo(N0.getNode(), Trunc, true);
        }
        return SDValue { Node: N, ResNo: 0 };
    }
    if combineToExtendCMOV(N, DAG) {
        NewCMov;
    } else {
        return NewCMov;
    }
    if !DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if combineExtSetcc(N, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if combineToExtendBoolVectorInReg(N.getOpcode(), DL, VT, N0, DAG, DCI, Subtarget) {
        V;
    } else {
        return V;
    }
    if VT.isVector() {
        if PromoteMaskArithmetic(SDValue { Node: N, ResNo: 0 }, DL, DAG, Subtarget) {
            R;
        } else {
            return R;
        }
        if N0.getOpcode() == SIGN_EXTEND_VECTOR_INREG {
            return DAG.getNode(N0.getOpcode(), DL, VT, N0.getOperand(0));
        }
    }
    if promoteExtBeforeAdd(N, DAG, Subtarget) {
        NewAdd;
    } else {
        return NewAdd;
    }
    return SDValue {};
}

fn getInvertedVectorForFMA(V: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(isBuildVectorOfConstantFPSDNodes(V.getNode()), "ConstantFP build vector expected");
    let mut IsNotFMA: Closure_237 = Closure_237 {};
    if any_of(operator(V).users(), IsNotFMA) {
        return SDValue {};
    }
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut VT: EVT = V.getValueType();
    let mut EltVT: EVT = VT.getVectorElementType();
    for Op in operator(V).op_values() {
        if dyn_cast(Op) {
            Cst;
        } else {
            Ops.push(DAG.getConstantFP(operator(Cst.getValueAPF()), Op, EltVT, false));
        }
    }
    let mut NV: *mut SDNode = DAG.getNodeIfExists(BUILD_VECTOR, DAG.getVTList(VT), Ops, false);
    if !NV {
        return SDValue {};
    }
    if any_of(NV.users(), IsNotFMA) {
        return SDValue { Node: NV, ResNo: 0 };
    }
    for Op in operator(V).op_values() {
        if dyn_cast(Op) {
            Cst;
        } else {
            if Cst.isNegative() {
                return SDValue {};
            }
            break;
        }
    }
    return SDValue { Node: NV, ResNo: 0 };
}

fn combineFMA(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut dl: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut TSI: *SelectionDAGTargetInfo = DAG.getSelectionDAGInfo();
    let mut IsStrict: bool = if N.isTargetOpcode() { TSI.isTargetStrictFPOpcode(N.getOpcode()) } else { N.isStrictFPOpcode() };
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isTypeLegal(VT) {
        return SDValue {};
    }
    let mut A: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut B: SDValue = N.getOperand(if IsStrict { 2 } else { 1 });
    let mut C: SDValue = N.getOperand(if IsStrict { 3 } else { 2 });
    let mut Flags: SDNodeFlags = N.getFlags();
    if !IsStrict && Flags.hasAllowReassociation() && TLI.isOperationExpand(FMA, VT) {
        let mut Fmul: SDValue = DAG.getNode(FMUL, dl, VT, A, B, Flags);
        return DAG.getNode(FADD, dl, VT, Fmul, C, Flags);
    }
    let mut ScalarVT: EVT = VT.getScalarType();
    if ((ScalarVT != f32 && ScalarVT != f64) || !Subtarget.hasAnyFMA()) && !(ScalarVT == f16 && Subtarget.hasFP16()) && !(ScalarVT == bf16 && Subtarget.hasAVX10_2()) {
        return SDValue {};
    }
    let mut invertIfNegative: Closure_238 = Closure_238 { DAG: &mut DAG, TLI: &mut TLI, DCI: &mut DCI };
    let mut NegA: bool = invertIfNegative.call(A);
    let mut NegAHandle: HandleSDNode = A;
    let mut NegB: bool = invertIfNegative.call(B);
    let mut NegBHandle: HandleSDNode = B;
    let mut NegC: bool = invertIfNegative.call(C);
    if !NegA && !NegB && !NegC {
        return SDValue {};
    }
    let mut NewOpcode: u32 = negateFMAOpcode(N.getOpcode(), NegA != NegB, NegC, false);
    let mut FlagsInserter: FlagInserter = FlagInserter { DAG, Flags };
    if IsStrict {
        assert!(N.getNumOperands() == 4, "Shouldn't be greater than 4");
        return DAG.getNode(NewOpcode, dl, [VT, Other], [N.getOperand(0), A, B, C]);
    } else {
        if N.getNumOperands() == 4 {
            return DAG.getNode(NewOpcode, dl, VT, A, B, C, N.getOperand(3));
        }
        return DAG.getNode(NewOpcode, dl, VT, A, B, C);
    }
}

fn combineFMADDSUB(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut dl: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut N2: SDValue = N.getOperand(2);
    if N.getOpcode() == FMSUBADD && Subtarget.hasFP16() && N.hasOneUse() && (VT == v8f16 || VT == v16f16 || VT == v32f16) {
        let mut A: SDValue = SDValue {};
        let mut B: SDValue = SDValue {};
        if isCFMulFromFMSUBADD(SDValue { Node: N, ResNo: 0 }, DAG, A, B) {
            let mut CVT: MVT = getVectorVT(f32, VT.getVectorNumElements() / 2);
            let mut MulOp0: SDValue = DAG.getBitcast(CVT, A);
            let mut MulOp1: SDValue = DAG.getBitcast(CVT, B);
            let mut Fmulc: SDValue = DAG.getNode(VFCMULC, dl, CVT, MulOp0, MulOp1, operator(N2).getFlags());
            return DAG.getBitcast(VT, Fmulc);
        }
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut CodeSize: bool = DAG.getMachineFunction().getFunction().hasOptSize();
    let mut LegalOperations: bool = !DCI.isBeforeLegalizeOps();
    let mut NegN2: SDValue = TLI.getCheaperNegatedExpression(N2, DAG, LegalOperations, CodeSize, 0);
    if !NegN2 {
        return SDValue {};
    }
    let mut NewOpcode: u32 = negateFMAOpcode(N.getOpcode(), false, true, false);
    if N.getNumOperands() == 4 {
        return DAG.getNode(NewOpcode, dl, VT, N.getOperand(0), N.getOperand(1), NegN2, N.getOperand(3));
    }
    return DAG.getNode(NewOpcode, dl, VT, N.getOperand(0), N.getOperand(1), NegN2);
}

fn widenBuildVec(Extend: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if Extend.getOpcode() != ZERO_EXTEND {
        return SDValue {};
    }
    let mut ExtendVT: EVT = Extend.getValueType(0);
    let mut BV: SDValue = Extend.getOperand(0);
    if BV.getOpcode() != BUILD_VECTOR || !BV.hasOneUse() {
        return SDValue {};
    }
    if any_of(operator(BV).op_values(), Closure_239 {}) {
        return SDValue {};
    }
    if !all_of(operator(BV).op_values(), Closure_240 {}) {
        return SDValue {};
    }
    let mut dl: SDLoc = BV;
    let mut VT: EVT = BV.getValueType();
    let mut EltVT: EVT = BV.getOperand(0).getValueType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.getTypeAction(*DAG.getContext(), VT) != TypeWidenVector {
        return SDValue {};
    }
    let mut WidenVT: EVT = TLI.getTypeToTransformTo(*DAG.getContext(), VT);
    let mut WidenNumElts: u32 = WidenVT.getVectorNumElements();
    let mut NewOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { operator(BV).op_begin(), operator(BV).op_end() };
    assert!(WidenNumElts >= NumElts, "Shrinking vector instead of widening!");
    NewOps.append(WidenNumElts - NumElts, DAG.getConstant(0, dl, EltVT, false, false));
    let mut step: u32 = WidenNumElts / NumElts;
    if WidenVT.is128BitVector() {
        if step > 1 && Extend.getValueSizeInBits(0) == WidenVT.getSizeInBits() {
            for let mut i: i32 = NumElts - 1;
let mut j: i32 = WidenNumElts - step; i > 0; i -= 1 , j -= step {
                let mut temp: SDValue = NewOps[i];
                NewOps[i] = NewOps[j];
                NewOps[j] = temp;
            }
            let mut NewBV: SDValue = DAG.getBuildVector(WidenVT, dl, NewOps);
            let mut NewBVBitcast: SDValue = DAG.getBitcast(ExtendVT, NewBV);
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Extend, ResNo: 0 }, NewBVBitcast);
            return NewBV;
        }
    }
    return SDValue {};
}

fn combineZext(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut dl: SDLoc = N;
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if !DCI.isBeforeLegalizeOps() && N.getOpcode() == ANY_EXTEND && N0.getOpcode() == SETCC_CARRY {
        let mut Setcc: SDValue = DAG.getNode(SETCC_CARRY, dl, VT, operator(N0).getOperand(0), operator(N0).getOperand(1));
        let mut ReplaceOtherUses: bool = !N0.hasOneUse();
        DCI.CombineTo(N, Setcc, true);
        if ReplaceOtherUses {
            let mut Trunc: SDValue = DAG.getNode(TRUNCATE, N0, N0.getValueType(), Setcc);
            DCI.CombineTo(N0.getNode(), Trunc, true);
        }
        return SDValue { Node: N, ResNo: 0 };
    }
    if combineToExtendCMOV(N, DAG) {
        NewCMov;
    } else {
        return NewCMov;
    }
    if DCI.isBeforeLegalizeOps() {
        if combineExtSetcc(N, DAG, Subtarget) {
            V;
        } else {
            return V;
        }
    }
    if combineToExtendBoolVectorInReg(N.getOpcode(), dl, VT, N0, DAG, DCI, Subtarget) {
        V;
    } else {
        return V;
    }
    if VT.isVector() {
        if PromoteMaskArithmetic(SDValue { Node: N, ResNo: 0 }, dl, DAG, Subtarget) {
            R;
        } else {
            return R;
        }
    }
    if promoteExtBeforeAdd(N, DAG, Subtarget) {
        NewAdd;
    } else {
        return NewAdd;
    }
    if combineOrCmpEqZeroToCtlzSrl(N, DAG, DCI, Subtarget) {
        R;
    } else {
        return R;
    }
    if N0.getOpcode() == PACKUS && N0.getValueSizeInBits().operator unsigned long long() == 128 && VT.getScalarSizeInBits() == N0.getOperand(0).getScalarValueSizeInBits() {
        let mut N00: SDValue = N0.getOperand(0);
        let mut N01: SDValue = N0.getOperand(1);
        let mut NumSrcEltBits: u32 = N00.getScalarValueSizeInBits();
        let mut ZeroMask: APInt = getHighBitsSet(NumSrcEltBits, NumSrcEltBits / 2);
        if (N00.isUndef() || DAG.MaskedValueIsZero(N00, ZeroMask, 0)) && (N01.isUndef() || DAG.MaskedValueIsZero(N01, ZeroMask, 0)) {
            return concatSubVectors(N00, N01, DAG, dl);
        }
    }
    if widenBuildVec(N, DAG) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn truncateAVX512SetCCNoBWI(VT: EVT, OpVT: EVT, LHS: SDValue, RHS: SDValue, CC: CondCode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if Subtarget.hasAVX512() && !Subtarget.hasBWI() && VT.isVector() && VT.getVectorElementType() == i1 && (OpVT.getVectorElementType() == i8 || OpVT.getVectorElementType() == i16) {
        let mut Setcc: SDValue = DAG.getSetCC(DL, OpVT, LHS, RHS, CC, SDValue {}, false, None);
        return DAG.getNode(TRUNCATE, DL, VT, Setcc);
    }
    return SDValue {};
}

fn combineAVX512SetCCToKMOV(VT: EVT, Op0: SDValue, CC: CondCode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if CC != SETNE && CC != SETEQ {
        return SDValue {};
    }
    if !Subtarget.hasAVX512() {
        return SDValue {};
    }
    if Op0.getOpcode() != AND {
        return SDValue {};
    }
    let mut Broadcast: SDValue = Op0.getOperand(0);
    if Broadcast.getOpcode() != VBROADCAST && Broadcast.getOpcode() != VBROADCAST_LOAD {
        return SDValue {};
    }
    let mut Load: SDValue = Op0.getOperand(1);
    let mut LoadVT: EVT = Load.getSimpleValueType();
    let mut UndefElts: APInt = APInt {};
    let mut EltBits: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
    if !getTargetConstantBitsFromNode(Load, LoadVT.getScalarSizeInBits(), UndefElts, EltBits, true, false) || UndefElts[0] || !EltBits[0].isPowerOf2() || UndefElts.getBitWidth() > 16 {
        return SDValue {};
    }
    let mut N: u32 = EltBits[0].logBase2();
    let mut Len: u32 = UndefElts.getBitWidth();
    for let mut I: u32 = 1; I != Len; I += 1 {
        if UndefElts[I] {
            if I + 1 != Len && !UndefElts.extractBits(Len - (I + 1), I + 1).isAllOnes() {
                return SDValue {};
            }
            break;
        }
        if EltBits[I].getBitWidth() <= N + I || !EltBits[I].isOneBitSet(N + I) {
            return SDValue {};
        }
    }
    let mut BroadcastOpVT: MVT = Broadcast.getSimpleValueType().getVectorElementType();
    let mut BroadcastOp: SDValue = SDValue {};
    if Broadcast.getOpcode() != VBROADCAST {
        BroadcastOp = DAG.getNode(EXTRACT_VECTOR_ELT, DL, BroadcastOpVT, Broadcast, DAG.getVectorIdxConstant(0, DL, false));
    } else {
        BroadcastOp = Broadcast.getOperand(0);
        if BroadcastOp.getValueType().isVector() {
            return SDValue {};
        }
    }
    let mut Masked: SDValue = BroadcastOp;
    if N != 0 {
        let mut BroadcastOpBitWidth: u32 = BroadcastOpVT.getSizeInBits().operator unsigned long long();
        let mut NumDefinedElts: u32 = UndefElts.countTrailingZeros();
        if NumDefinedElts > BroadcastOpBitWidth {
            return SDValue {};
        }
        let mut Mask: APInt = getLowBitsSet(BroadcastOpBitWidth, NumDefinedElts);
        let mut ShiftedValue: SDValue = DAG.getNode(SRL, DL, BroadcastOpVT, BroadcastOp, DAG.getConstant(N, DL, BroadcastOpVT, false, false));
        Masked = DAG.getNode(AND, DL, BroadcastOpVT, ShiftedValue, DAG.getConstant(Mask, DL, BroadcastOpVT, false, false));
    }
    let mut Trunc: SDValue = DAG.getAnyExtOrTrunc(Masked, DL, i16);
    let mut Bitcast: SDValue = DAG.getNode(BITCAST, DL, v16i1, Trunc);
    if CC == SETEQ {
        Bitcast = DAG.getNOT(DL, Bitcast, v16i1);
    }
    if VT != v16i1 {
        return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Bitcast, DAG.getVectorIdxConstant(0, DL, false));
    }
    return Bitcast;
}

fn combineSetCC(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut CC: CondCode = cast(N.getOperand(2)).get();
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut OpVT: EVT = LHS.getValueType();
    let mut DL: SDLoc = N;
    if VT == i1 {
        let mut X86CC: CondCode = zeroed();
        if MatchVectorAllEqualTest(LHS, RHS, CC, DL, Subtarget, DAG, X86CC) {
            V;
        } else {
            return DAG.getNode(TRUNCATE, DL, VT, getSETCC(X86CC, V, DL, DAG));
        }
    }
    if (CC == SETNE || CC == SETEQ) && OpVT.isScalarInteger() {
        if isNullConstant(RHS) && OpVT.getScalarSizeInBits() > (if Subtarget.is64Bit() { 64 } else { 32 }) {
            let mut X: SDValue = SDValue {};
            let mut ShAmt: SDValue = SDValue {};
            if sd_match(LHS, m_OneUse(m_And(m_Value(X), m_Shl(m_One(false), m_Value(ShAmt))))) {
                let mut AmtVT: EVT = ShAmt.getValueType();
                let mut AlignAmt: SDValue = DAG.getNode(AND, DL, AmtVT, ShAmt, DAG.getSignedConstant(-32, DL, AmtVT, false, false));
                let mut ModuloAmt: SDValue = DAG.getNode(AND, DL, AmtVT, ShAmt, DAG.getConstant(31, DL, AmtVT, false, false));
                let mut Mask: SDValue = DAG.getNode(SHL, DL, i32, DAG.getConstant(1, DL, i32, false, false), DAG.getZExtOrTrunc(ModuloAmt, DL, i8));
                X = DAG.getNode(SRL, DL, OpVT, X, AlignAmt);
                X = DAG.getNode(TRUNCATE, DL, i32, X);
                X = DAG.getNode(AND, DL, i32, X, Mask);
                return DAG.getSetCC(DL, VT, X, DAG.getConstant(0, DL, i32, false, false), CC, SDValue {}, false, None);
            }
        }
        if LHS.getOpcode() == TRUNCATE && LHS.getOperand(0).getScalarValueSizeInBits() >= 32 && isa(RHS) && !DCI.isBeforeLegalize() {
            let mut SrcVT: EVT = LHS.getOperand(0).getValueType();
            let mut UpperBits: APInt = getBitsSetFrom(SrcVT.getScalarSizeInBits(), OpVT.getScalarSizeInBits());
            if DAG.MaskedValueIsZero(LHS.getOperand(0), UpperBits, 0) && TLI.isTypeLegal(LHS.getOperand(0).getValueType()) {
                return DAG.getSetCC(DL, VT, LHS.getOperand(0), DAG.getZExtOrTrunc(RHS, DL, SrcVT), CC, SDValue {}, false, None);
            }
        }
        if isAbsOpcode(LHS.getOpcode()) && LHS.hasOneUse() {
            if dyn_cast(RHS) {
                C;
            } else {
                let mut CInt: *APInt = C.getAPIntValue();
                if CInt.isPowerOf2() && !CInt.isMinSignedValue() {
                    let mut BaseOp: SDValue = LHS.getOperand(0);
                    let mut SETCC0: SDValue = DAG.getSetCC(DL, VT, BaseOp, RHS, CC, SDValue {}, false, None);
                    let mut SETCC1: SDValue = DAG.getSetCC(DL, VT, BaseOp, DAG.getConstant(operator(CInt), DL, OpVT, false, false), CC, SDValue {}, false, None);
                    return DAG.getNode(if CC == SETEQ { OR } else { AND }, DL, VT, SETCC0, SETCC1);
                }
            }
        }
        if combineVectorSizedSetCCEquality(VT, LHS, RHS, CC, DL, DAG, Subtarget) {
            V;
        } else {
            return V;
        }
    }
    if VT.isVectorOf(i1) && (CC == SETNE || CC == SETEQ || isSignedIntSetCC(CC)) {
        let mut Op0: SDValue = LHS;
        let mut Op1: SDValue = RHS;
        let mut TmpCC: CondCode = CC;
        if Op0.getOpcode() == BUILD_VECTOR {
            swap(Op0, Op1);
            TmpCC = getSetCCSwappedOperands(TmpCC);
        }
        let mut IsSEXT0: bool = (Op0.getOpcode() == SIGN_EXTEND) && (Op0.getOperand(0).getValueType().getVectorElementType() == i1);
        let mut IsVZero1: bool = isBuildVectorAllZeros(Op1.getNode());
        if IsSEXT0 && IsVZero1 {
            assert!(VT == Op0.getOperand(0).getValueType(), "Unexpected operand type");
            if TmpCC == SETGT {
                return DAG.getConstant(0, DL, VT, false, false);
            }
            if TmpCC == SETLE {
                return DAG.getConstant(1, DL, VT, false, false);
            }
            if TmpCC == SETEQ || TmpCC == SETGE {
                return DAG.getNOT(DL, Op0.getOperand(0), VT);
            }
            assert!((TmpCC == SETNE || TmpCC == SETLT), "Unexpected condition code!");
            return Op0.getOperand(0);
        }
        if IsVZero1 {
            if combineAVX512SetCCToKMOV(VT, Op0, TmpCC, DL, DAG, Subtarget) {
                V;
            } else {
                return V;
            }
        }
    }
    if VT.isVector() && OpVT.isVector() && OpVT.isInteger() {
        let mut CanMakeSigned: bool = false;
        if isUnsignedIntSetCC(CC) {
            let mut CmpKnown: KnownBits = DAG.computeKnownBits(LHS, 0).intersectWith(DAG.computeKnownBits(RHS, 0));
            CanMakeSigned = CmpKnown.Zero.isSignBitSet() || CmpKnown.One.isSignBitSet();
        }
        if CanMakeSigned || isSignedIntSetCC(CC) {
            let mut KeepZeroCmp: bool = Subtarget.hasAVX512() && VT.isVectorOf(i1);
            let mut LHSOut: SDValue = LHS;
            let mut RHSOut: SDValue = RHS;
            let mut NewCC: CondCode = CC;
            match CC {
                SETGE => {
                    SETUGE;
                },
                SETUGT => {
                    NewCC = SETGT;
                },
                SETLE => {
                    SETULE;
                },
                SETULT => {
                    NewCC = SETLT;
                },
                _ => {
                    break;
                },
            }
            if NewCC != CC {
                if truncateAVX512SetCCNoBWI(VT, OpVT, LHSOut, RHSOut, NewCC, DL, DAG, Subtarget) {
                    R;
                } else {
                    return R;
                }
                return DAG.getSetCC(DL, VT, LHSOut, RHSOut, NewCC, SDValue {}, false, None);
            }
        }
    }
    if truncateAVX512SetCCNoBWI(VT, OpVT, LHS, RHS, CC, DL, DAG, Subtarget) {
        R;
    } else {
        return R;
    }
    if VT.isVector() && OpVT.isVector() && OpVT.isInteger() && isUnsignedIntSetCC(CC) && LHS.getOpcode() == ADD && !Subtarget.hasAVX512() && (OpVT.getSizeInBits().operator unsigned long long() <= 128 || !Subtarget.hasAVX() || Subtarget.hasAVX2()) && LHS.hasOneUse() {
        let mut CmpC: APInt = APInt {};
        let mut AddC: SDValue = LHS.getOperand(1);
        if isConstantSplatVector(RHS.getNode(), CmpC) && DAG.isConstantIntBuildVectorOrConstantInt(AddC, true) {
            let mut C0: SDValue = SDValue {};
            let mut C1: SDValue = SDValue {};
            if isConstantSplatVectorAllOnes(AddC.getNode(), false) && TLI.isOperationLegal(UMIN, OpVT) {} else if (CC == SETULT && CmpC == 2) || (CC == SETULE && CmpC == 1) {
                C0 = DAG.getNegative(AddC, DL, OpVT);
                C1 = DAG.getNode(SUB, DL, OpVT, C0, DAG.getAllOnesConstant(DL, OpVT, false, false));
            } else if (CC == SETUGT && (operator(CmpC)) == 3) || (CC == SETUGE && (operator(CmpC)) == 2) {
                C0 = DAG.getNOT(DL, AddC, OpVT);
                C1 = DAG.getNode(ADD, DL, OpVT, C0, DAG.getAllOnesConstant(DL, OpVT, false, false));
            }
            if C0 && C1 {
                let mut NewLHS: SDValue = DAG.getSetCC(DL, VT, LHS.getOperand(0), C0, SETEQ, SDValue {}, false, None);
                let mut NewRHS: SDValue = DAG.getSetCC(DL, VT, LHS.getOperand(0), C1, SETEQ, SDValue {}, false, None);
                return DAG.getNode(OR, DL, VT, NewLHS, NewRHS);
            }
        }
    }
    if Subtarget.hasSSE1() && !Subtarget.hasSSE2() && VT == v4i32 && LHS.getValueType() == v4f32 {
        return LowerVSETCC(SDValue { Node: N, ResNo: 0 }, Subtarget, DAG);
    }
    if isNullFPScalarOrVectorConst(RHS) {
        let mut FNegVT: SDVTList = DAG.getVTList(OpVT);
        if DAG.getNodeIfExists(FNEG, FNegVT, [LHS], false) {
            FNeg;
        } else {
            return DAG.getSetCC(DL, VT, LHS, SDValue { Node: FNeg, ResNo: 0 }, CC, SDValue {}, false, None);
        }
    }
    return SDValue {};
}

fn combineMOVMSK(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut NumBits: u32 = VT.getScalarSizeInBits();
    let mut NumElts: u32 = SrcVT.getVectorNumElements();
    let mut NumBitsPerElt: u32 = SrcVT.getScalarSizeInBits();
    assert!(VT == i32 && NumElts <= NumBits, "Unexpected MOVMSK types");
    let mut DL: SDLoc = N;
    let mut UndefElts: APInt = APInt {};
    let mut EltBits: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
    if getTargetConstantBitsFromNode(Src, NumBitsPerElt, UndefElts, EltBits, true, true) {
        let mut Imm: APInt = APInt { 32, 0, false, false };
        for let mut Idx: u32 = 0; Idx != NumElts; Idx += 1 {
            if !UndefElts[Idx] && EltBits[Idx].isNegative() {
                Imm.setBit(Idx);
            }
        }
        return DAG.getConstant(Imm, DL, VT, false, false);
    }
    let mut EltWidth: u32 = SrcVT.getScalarSizeInBits();
    if Subtarget.hasSSE2() && Src.getOpcode() == BITCAST && Src.getOperand(0).getScalarValueSizeInBits() == EltWidth {
        return DAG.getNode(MOVMSK, DL, VT, Src.getOperand(0));
    }
    if IsNOT(Src, DAG) {
        NotSrc;
    } else {
        let mut NotMask: APInt = getLowBitsSet(NumBits, NumElts);
        NotSrc = DAG.getBitcast(SrcVT, NotSrc);
        return DAG.getNode(XOR, DL, VT, DAG.getNode(MOVMSK, DL, VT, NotSrc), DAG.getConstant(NotMask, DL, VT, false, false));
    }
    if Src.getOpcode() == PCMPGT && isBuildVectorAllOnes(Src.getOperand(1).getNode()) {
        let mut NotMask: APInt = getLowBitsSet(NumBits, NumElts);
        return DAG.getNode(XOR, DL, VT, DAG.getNode(MOVMSK, DL, VT, Src.getOperand(0)), DAG.getConstant(NotMask, DL, VT, false, false));
    }
    if Src.getOpcode() == PCMPEQ {
        let mut KnownLHS: KnownBits = DAG.computeKnownBits(Src.getOperand(0), 0);
        let mut KnownRHS: KnownBits = DAG.computeKnownBits(Src.getOperand(1), 0);
        let mut ShiftAmt: u32 = KnownLHS.countMinLeadingZeros();
        if KnownLHS.countMaxPopulation() == 1 && (KnownRHS.isZero() || (KnownRHS.countMaxPopulation() == 1 && ShiftAmt == KnownRHS.countMinLeadingZeros())) {
            let mut ShiftVT: MVT = SrcVT;
            let mut ShiftLHS: SDValue = Src.getOperand(0);
            let mut ShiftRHS: SDValue = Src.getOperand(1);
            if ShiftVT.getScalarType() == i8 {
                ShiftVT = getVectorVT(i16, NumElts / 2);
                ShiftLHS = DAG.getBitcast(ShiftVT, ShiftLHS);
                ShiftRHS = DAG.getBitcast(ShiftVT, ShiftRHS);
            }
            ShiftLHS = getTargetVShiftByConstNode(VSHLI, DL, ShiftVT, ShiftLHS, ShiftAmt, DAG);
            ShiftRHS = getTargetVShiftByConstNode(VSHLI, DL, ShiftVT, ShiftRHS, ShiftAmt, DAG);
            ShiftLHS = DAG.getBitcast(SrcVT, ShiftLHS);
            ShiftRHS = DAG.getBitcast(SrcVT, ShiftRHS);
            let mut Res: SDValue = DAG.getNode(XOR, DL, SrcVT, ShiftLHS, ShiftRHS);
            return DAG.getNode(MOVMSK, DL, VT, DAG.getNOT(DL, Res, SrcVT));
        }
    }
    if N.isOnlyUserOf(Src.getNode()) {
        let mut SrcBC: SDValue = peekThroughOneUseBitcasts(Src);
        if isBitwiseLogicOp(SrcBC.getOpcode()) {
            let mut UndefElts: APInt = APInt {};
            let mut EltBits: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
            if getTargetConstantBitsFromNode(SrcBC.getOperand(1), NumBitsPerElt, UndefElts, EltBits, true, false) {
                let mut Mask: APInt = getZero(NumBits);
                for let mut Idx: u32 = 0; Idx != NumElts; Idx += 1 {
                    if !UndefElts[Idx] && EltBits[Idx].isNegative() {
                        Mask.setBit(Idx);
                    }
                }
                let mut NewSrc: SDValue = DAG.getBitcast(SrcVT, SrcBC.getOperand(0));
                let mut NewMovMsk: SDValue = DAG.getNode(MOVMSK, DL, VT, NewSrc);
                return DAG.getNode(SrcBC.getOpcode(), DL, VT, NewMovMsk, DAG.getConstant(Mask, DL, VT, false, false));
            }
        }
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DemandedMask: APInt = getAllOnes(NumBits);
    if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, DemandedMask, DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn combineTESTP(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut NumBits: u32 = VT.getScalarSizeInBits();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DemandedMask: APInt = getAllOnes(NumBits);
    if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, DemandedMask, DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn combineX86GatherScatter(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut MemOp: *mut X86MaskedGatherScatterSDNode = cast(N);
    let mut Mask: SDValue = MemOp.getMask();
    if Mask.getScalarValueSizeInBits() != 1 {
        let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
        let mut DemandedMask: APInt = getSignMask(Mask.getScalarValueSizeInBits());
        if TLI.SimplifyDemandedBits(Mask, DemandedMask, DCI) {
            if N.getOpcode() != DELETED_NODE {
                DCI.AddToWorklist(N);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    return SDValue {};
}

fn rebuildGatherScatter(GorS: *mut MaskedGatherScatterSDNode, Index: SDValue, Base: SDValue, Mask: SDValue, Scale: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = GorS;
    if dyn_cast(GorS) {
        Gather;
    } else {
        let mut Ops: [6]SDValue = [Gather.getChain(), Gather.getPassThru(), Mask, Base, Index, Scale];
        return DAG.getMaskedGather(Gather.getVTList(), Gather.getMemoryVT(), DL, Ops, Gather.getMemOperand(), Gather.getIndexType(), Gather.getExtensionType());
    }
    let mut Scatter: *mut MaskedScatterSDNode = cast(GorS);
    let mut Ops: [6]SDValue = [Scatter.getChain(), Scatter.getValue(), Mask, Base, Index, Scale];
    return DAG.getMaskedScatter(Scatter.getVTList(), Scatter.getMemoryVT(), DL, Ops, Scatter.getMemOperand(), Scatter.getIndexType(), Scatter.isTruncatingStore());
}

fn combineGatherScatter(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = N;
    let mut GorS: *mut MaskedGatherScatterSDNode = cast(N);
    let mut Index: SDValue = GorS.getIndex();
    let mut Base: SDValue = GorS.getBasePtr();
    let mut Mask: SDValue = GorS.getMask();
    let mut Scale: SDValue = GorS.getScale();
    let mut IndexVT: EVT = Index.getValueType();
    let mut IndexSVT: EVT = IndexVT.getVectorElementType();
    let mut IndexWidth: u32 = Index.getScalarValueSizeInBits();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut PtrVT: EVT = TLI.getPointerTy(DAG.getDataLayout(), 0);
    if DCI.isBeforeLegalize() {
        if Index.getOpcode() == SHL && IndexSVT == PtrVT && isa(Scale) {
            let mut ScaleAmt: u32 = operator(Scale).getAsZExtVal();
            assert!(isPowerOf2_32(ScaleAmt), "Scale must be a power of 2");
            let mut Log2ScaleAmt: u32 = Log2_32(ScaleAmt);
            let mut MaskBits: u32 = IndexWidth - Log2ScaleAmt;
            let mut DemandedBits: APInt = getLowBitsSet(IndexWidth, MaskBits);
            if TLI.SimplifyDemandedBits(Index, DemandedBits, DCI) {
                if N.getOpcode() != DELETED_NODE {
                    DCI.AddToWorklist(N);
                }
                return SDValue { Node: N, ResNo: 0 };
            }
            if DAG.getValidMinimumShiftAmount(Index, 0) {
                MinShAmt;
            } else {
                if operator(MinShAmt) >= 1 && Log2ScaleAmt < 3 && DAG.ComputeNumSignBits(Index.getOperand(0), 0) > 1 {
                    let mut ShAmt: SDValue = Index.getOperand(1);
                    let mut NewShAmt: SDValue = DAG.getNode(SUB, DL, ShAmt.getValueType(), ShAmt, DAG.getConstant(1, DL, ShAmt.getValueType(), false, false));
                    let mut NewIndex: SDValue = DAG.getNode(SHL, DL, Index.getValueType(), Index.getOperand(0), NewShAmt);
                    let mut NewScale: SDValue = DAG.getConstant(ScaleAmt * 2, DL, Scale.getValueType(), false, false);
                    return rebuildGatherScatter(GorS, NewIndex, Base, Mask, NewScale, DAG);
                }
            }
        }
        if IndexWidth > 32 && DAG.ComputeNumSignBits(Index, 0) > (IndexWidth - 32) {
            let mut NewVT: EVT = IndexVT.changeVectorElementType(*DAG.getContext(), i32);
            if DAG.FoldConstantArithmetic(TRUNCATE, DL, NewVT, Index, SDNodeFlags { Flags: None }) {
                TruncIndex;
            } else {
                return rebuildGatherScatter(GorS, TruncIndex, Base, Mask, Scale, DAG);
            }
            if (Index.getOpcode() == SIGN_EXTEND || Index.getOpcode() == ZERO_EXTEND) && Index.getOperand(0).getScalarValueSizeInBits() <= 32 {
                Index = DAG.getNode(TRUNCATE, DL, NewVT, Index);
                return rebuildGatherScatter(GorS, Index, Base, Mask, Scale, DAG);
            }
            if !TLI.isTypeLegal(Index.getValueType()) && TLI.isTypeLegal(NewVT) {
                Index = DAG.getNode(TRUNCATE, DL, NewVT, Index);
                return rebuildGatherScatter(GorS, Index, Base, Mask, Scale, DAG);
            }
        }
    }
    if Index.getOpcode() == ADD && IndexSVT == PtrVT && isa(Scale) {
        let mut ScaleAmt: u64 = operator(Scale).getAsZExtVal();
        for let mut I: u32 = 0; I != 2; I += 1 {
            if dyn_cast(Index.getOperand(I)) {
                BV;
            } else {
                let mut UndefElts: BitVector = BitVector {};
                if BV.getSplatValue(&mut UndefElts) {
                    Splat;
                } else {
                    if UndefElts.none() {
                        if dyn_cast(Splat) {
                            C;
                        } else {
                            let mut Adder: APInt = C.getAPIntValue() * ScaleAmt;
                            let mut NewBase: SDValue = DAG.getNode(ADD, DL, PtrVT, Base, DAG.getConstant(Adder, DL, PtrVT, false, false));
                            let mut NewIndex: SDValue = Index.getOperand(1 - I);
                            return rebuildGatherScatter(GorS, NewIndex, NewBase, Mask, Scale, DAG);
                        }
                        if ScaleAmt == 1 {
                            let mut NewBase: SDValue = DAG.getNode(ADD, DL, PtrVT, Base, Splat);
                            let mut NewIndex: SDValue = Index.getOperand(1 - I);
                            return rebuildGatherScatter(GorS, NewIndex, NewBase, Mask, Scale, DAG);
                        }
                    }
                }
                if ScaleAmt == 1 && BV.isConstant() && isa(Base) {
                    let mut Splat: SDValue = DAG.getSplatBuildVector(IndexVT, DL, Base);
                    Splat = DAG.getNode(ADD, DL, IndexVT, Index.getOperand(I), Splat);
                    let mut NewIndex: SDValue = DAG.getNode(ADD, DL, IndexVT, Index.getOperand(1 - I), Splat);
                    let mut NewBase: SDValue = DAG.getConstant(0, DL, PtrVT, false, false);
                    return rebuildGatherScatter(GorS, NewIndex, NewBase, Mask, Scale, DAG);
                }
            }
        }
    }
    if DCI.isBeforeLegalizeOps() {
        if IndexWidth != 32 && IndexWidth != 64 {
            let mut EltVT: MVT = if IndexWidth > 32 { i64 } else { i32 };
            IndexVT = IndexVT.changeVectorElementType(*DAG.getContext(), EltVT);
            Index = DAG.getSExtOrTrunc(Index, DL, IndexVT);
            return rebuildGatherScatter(GorS, Index, Base, Mask, Scale, DAG);
        }
        if canonicalizeBoolMask(GorS.getOpcode(), N.getValueType(0), Mask, DL, DAG, DCI, Subtarget) {
            NewMask;
        } else {
            return rebuildGatherScatter(GorS, Index, Base, NewMask, Scale, DAG);
        }
    }
    if Mask.getScalarValueSizeInBits() != 1 {
        let mut DemandedMask: APInt = getSignMask(Mask.getScalarValueSizeInBits());
        if TLI.SimplifyDemandedBits(Mask, DemandedMask, DCI) {
            if N.getOpcode() != DELETED_NODE {
                DCI.AddToWorklist(N);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    return SDValue {};
}

fn combineX86SetCC(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = N;
    let mut CC: CondCode = N.getConstantOperandVal(0);
    let mut EFLAGS: SDValue = N.getOperand(1);
    if combineSetCCEFLAGS(EFLAGS, CC, DAG, Subtarget) {
        Flags;
    } else {
        return getSETCC(CC, Flags, DL, DAG);
    }
    return SDValue {};
}

fn combineBrCond(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = N;
    let mut EFLAGS: SDValue = N.getOperand(3);
    let mut CC: CondCode = N.getConstantOperandVal(2);
    if combineSetCCEFLAGS(EFLAGS, CC, DAG, Subtarget) {
        Flags;
    } else {
        let mut Cond: SDValue = DAG.getTargetConstant(CC, DL, i8, false);
        return DAG.getNode(BRCOND, DL, N.getVTList(), N.getOperand(0), N.getOperand(1), Cond, Flags);
    }
    return SDValue {};
}

fn combineVectorCompareAndMaskUnaryOp(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut NumEltBits: u32 = VT.getScalarSizeInBits();
    let mut Op0: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    if !VT.isVector() || Op0.getOpcode() != AND || DAG.ComputeNumSignBits(Op0.getOperand(0), 0) != NumEltBits || VT.getSizeInBits() != Op0.getValueSizeInBits() {
        return SDValue {};
    }
    if dyn_cast(Op0.getOperand(1)) {
        BV;
    } else {
        if !BV.isConstant() {
            return SDValue {};
        }
        let mut DL: SDLoc = N;
        let mut IntVT: EVT = BV.getValueType(0);
        let mut SourceConst: SDValue = SDValue {};
        if IsStrict {
            SourceConst = DAG.getNode(N.getOpcode(), DL, [VT, Other], [N.getOperand(0), SDValue { Node: BV, ResNo: 0 }]);
        } else {
            SourceConst = DAG.getNode(N.getOpcode(), DL, VT, SDValue { Node: BV, ResNo: 0 });
        }
        let mut MaskConst: SDValue = DAG.getBitcast(IntVT, SourceConst);
        let mut NewAnd: SDValue = DAG.getNode(AND, DL, IntVT, operator(Op0).getOperand(0), MaskConst);
        let mut Res: SDValue = DAG.getBitcast(VT, NewAnd);
        if IsStrict {
            return DAG.getMergeValues([Res, SourceConst.getValue(1)], DL);
        }
        return Res;
    }
    return SDValue {};
}

fn combineToFPTruncExtElt(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Trunc: SDValue = N.getOperand(0);
    if !Trunc.hasOneUse() || Trunc.getOpcode() != TRUNCATE {
        return SDValue {};
    }
    let mut ExtElt: SDValue = Trunc.getOperand(0);
    if !ExtElt.hasOneUse() || ExtElt.getOpcode() != EXTRACT_VECTOR_ELT || !isNullConstant(ExtElt.getOperand(1)) {
        return SDValue {};
    }
    let mut TruncVT: EVT = Trunc.getValueType();
    let mut SrcVT: EVT = ExtElt.getValueType();
    let mut DestWidth: u32 = TruncVT.getSizeInBits().operator unsigned long long();
    let mut SrcWidth: u32 = SrcVT.getSizeInBits().operator unsigned long long();
    if SrcWidth % DestWidth != 0 {
        return SDValue {};
    }
    let mut SrcVecVT: EVT = ExtElt.getOperand(0).getValueType();
    let mut VecWidth: u32 = SrcVecVT.getSizeInBits().operator unsigned long long();
    let mut NumElts: u32 = VecWidth / DestWidth;
    let mut BitcastVT: EVT = getVectorVT(*DAG.getContext(), TruncVT, NumElts, false);
    let mut BitcastVec: SDValue = DAG.getBitcast(BitcastVT, ExtElt.getOperand(0));
    let mut DL: SDLoc = N;
    let mut NewExtElt: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, TruncVT, BitcastVec, ExtElt.getOperand(1));
    return DAG.getNode(N.getOpcode(), DL, N.getValueType(0), NewExtElt);
}

fn combineUIntToFP(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Op0: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut VT: EVT = N.getValueType(0);
    let mut InVT: EVT = Op0.getValueType();
    if InVT.isVector() && VT.getVectorElementType() == f16 {
        let mut ScalarSize: u32 = InVT.getScalarSizeInBits();
        if (ScalarSize == 16 && Subtarget.hasFP16()) || ScalarSize == 32 || ScalarSize >= 64 {
            return SDValue {};
        }
        let mut dl: SDLoc = N;
        let mut DstVT: EVT = getVectorVT(*DAG.getContext(), if (Subtarget.hasFP16() && ScalarSize < 16) { i16 } else { if ScalarSize < 32 { i32 } else { i64 } }, InVT.getVectorNumElements(), false);
        let mut P: SDValue = DAG.getNode(ZERO_EXTEND, dl, DstVT, Op0);
        if IsStrict {
            return DAG.getNode(STRICT_SINT_TO_FP, dl, [VT, Other], [N.getOperand(0), P]);
        }
        return DAG.getNode(SINT_TO_FP, dl, VT, P);
    }
    if InVT.isVector() && InVT.getScalarSizeInBits() < 32 && VT.getScalarType() != f16 {
        let mut dl: SDLoc = N;
        let mut DstVT: EVT = InVT.changeVectorElementType(*DAG.getContext(), i32);
        let mut P: SDValue = DAG.getNode(ZERO_EXTEND, dl, DstVT, Op0);
        if IsStrict {
            return DAG.getNode(STRICT_SINT_TO_FP, dl, [VT, Other], [N.getOperand(0), P]);
        }
        return DAG.getNode(SINT_TO_FP, dl, VT, P);
    }
    let mut Flags: SDNodeFlags = N.getFlags();
    if Flags.hasNonNeg() || DAG.SignBitIsZero(Op0, 0) {
        if IsStrict {
            return DAG.getNode(STRICT_SINT_TO_FP, N, [VT, Other], [N.getOperand(0), Op0]);
        }
        return DAG.getNode(SINT_TO_FP, N, VT, Op0);
    }
    return SDValue {};
}

fn combineSIntToFP(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    if combineVectorCompareAndMaskUnaryOp(N, DAG) {
        Res;
    } else {
        return Res;
    }
    let mut Op0: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut VT: EVT = N.getValueType(0);
    let mut InVT: EVT = Op0.getValueType();
    if InVT.isVector() && VT.getVectorElementType() == f16 {
        let mut ScalarSize: u32 = InVT.getScalarSizeInBits();
        if (ScalarSize == 16 && Subtarget.hasFP16()) || ScalarSize == 32 || ScalarSize >= 64 {
            return SDValue {};
        }
        let mut dl: SDLoc = N;
        let mut DstVT: EVT = getVectorVT(*DAG.getContext(), if (Subtarget.hasFP16() && ScalarSize < 16) { i16 } else { if ScalarSize < 32 { i32 } else { i64 } }, InVT.getVectorNumElements(), false);
        let mut P: SDValue = DAG.getNode(SIGN_EXTEND, dl, DstVT, Op0);
        if IsStrict {
            return DAG.getNode(STRICT_SINT_TO_FP, dl, [VT, Other], [N.getOperand(0), P]);
        }
        return DAG.getNode(SINT_TO_FP, dl, VT, P);
    }
    if InVT.isVector() && InVT.getScalarSizeInBits() < 32 && VT.getScalarType() != f16 {
        let mut dl: SDLoc = N;
        let mut DstVT: EVT = InVT.changeVectorElementType(*DAG.getContext(), i32);
        let mut P: SDValue = DAG.getNode(SIGN_EXTEND, dl, DstVT, Op0);
        if IsStrict {
            return DAG.getNode(STRICT_SINT_TO_FP, dl, [VT, Other], [N.getOperand(0), P]);
        }
        return DAG.getNode(SINT_TO_FP, dl, VT, P);
    }
    if InVT.getScalarSizeInBits() > 32 && !Subtarget.hasDQI() {
        let mut BitWidth: u32 = InVT.getScalarSizeInBits();
        let mut NumSignBits: u32 = DAG.ComputeNumSignBits(Op0, 0);
        if NumSignBits >= (BitWidth - 31) {
            let mut TruncVT: EVT = i32;
            if InVT.isVector() {
                TruncVT = InVT.changeVectorElementType(*DAG.getContext(), TruncVT);
            }
            let mut dl: SDLoc = N;
            if DCI.isBeforeLegalize() || TruncVT != v2i32 {
                let mut Trunc: SDValue = DAG.getNode(TRUNCATE, dl, TruncVT, Op0);
                if IsStrict {
                    return DAG.getNode(STRICT_SINT_TO_FP, dl, [VT, Other], [N.getOperand(0), Trunc]);
                }
                return DAG.getNode(SINT_TO_FP, dl, VT, Trunc);
            }
            assert!(InVT == v2i64, "Unexpected VT!");
            let mut Cast: SDValue = DAG.getBitcast(v4i32, Op0);
            let mut Shuf: SDValue = DAG.getVectorShuffle(v4i32, dl, Cast, Cast, [0, 2, -1, -1]);
            if IsStrict {
                return DAG.getNode(STRICT_CVTSI2P, dl, [VT, Other], [N.getOperand(0), Shuf]);
            }
            return DAG.getNode(CVTSI2P, dl, VT, Shuf);
        }
    }
    if !Subtarget.useSoftFloat() && Subtarget.hasX87() && Op0.getOpcode() == LOAD {
        let mut Ld: *mut LoadSDNode = cast(Op0.getNode());
        if VT == f16 || VT == bf16 || VT == f128 {
            return SDValue {};
        }
        if Subtarget.hasDQI() && VT != f80 {
            return SDValue {};
        }
        if Ld.isSimple() && !VT.isVector() && isNormalLoad(Op0.getNode()) && Op0.hasOneUse() && !Subtarget.is64Bit() && InVT == i64 {
            let mut Tmp: pair<SDValue, SDValue> = Subtarget.getTargetLowering().BuildFILD(VT, InVT, N, Ld.getChain(), Ld.getBasePtr(), Ld.getPointerInfo(), Ld.getBaseAlign(), DAG);
            DAG.ReplaceAllUsesOfValueWith(Op0.getValue(1), Tmp.second);
            return Tmp.first;
        }
    }
    if IsStrict {
        return SDValue {};
    }
    if combineToFPTruncExtElt(N, DAG) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn combineFPToSInt(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Src: SDValue = N.getOperand(0);
    if Subtarget.hasSSE2() && Src.getOpcode() == FRINT && VT.getScalarType() == i32 && Src.hasOneUse() {
        return DAG.getNode(LRINT, N, VT, Src.getOperand(0));
    }
    return SDValue {};
}

fn combineFP_TO_xINT_SAT(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    assert!((Opcode == FP_TO_SINT_SAT || Opcode == FP_TO_UINT_SAT), "Unexpected opcode for combineFP_TO_xINT_SAT");
    if !Subtarget.hasAVX10_2() {
        return SDValue {};
    }
    let mut IsSigned: bool = Opcode == FP_TO_SINT_SAT;
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut DstVT: EVT = N.getValueType(0);
    let mut SatVT: EVT = cast(N.getOperand(1)).getVT();
    let mut DL: SDLoc = N;
    if SrcVT == v2f32 && DstVT == v2i64 && SatVT.getScalarSizeInBits() == 64 {
        let mut Undef: SDValue = DAG.getUNDEF(SrcVT);
        let mut NewSrc: SDValue = DAG.getNode(CONCAT_VECTORS, DL, v4f32, Src, Undef);
        if IsSigned {
            return DAG.getNode(FP_TO_SINT_SAT, DL, v2i64, NewSrc);
        }
        return DAG.getNode(FP_TO_UINT_SAT, DL, v2i64, NewSrc);
    }
    let mut IsVector: bool = SrcVT.isVector();
    if IsVector && !SrcVT.isFixedLengthVector() {
        return SDValue {};
    }
    let mut SrcEltVT: EVT = SrcVT.getScalarType();
    if SrcEltVT != f32 && SrcEltVT != f64 {
        return SDValue {};
    }
    let mut DstWidth: u32 = DstVT.getScalarSizeInBits();
    let mut SatWidth: u32 = SatVT.getScalarSizeInBits();
    if (DstWidth != 32 && DstWidth != 64) || SatWidth >= DstWidth {
        return SDValue {};
    }
    let mut FullSatVT: EVT = getIntegerVT(*DAG.getContext(), DstWidth);
    let mut FullSatTy: SDValue = DAG.getValueType(FullSatVT);
    let mut Full: SDValue = DAG.getNode(Opcode, DL, DstVT, Src, FullSatTy);
    if IsSigned {
        let mut Min: APInt = getSignedMinValue(SatWidth).sext(DstWidth);
        let mut Max: APInt = getSignedMaxValue(SatWidth).sext(DstWidth);
        let mut MinC: SDValue = DAG.getConstant(Min, DL, DstVT, false, false);
        let mut MaxC: SDValue = DAG.getConstant(Max, DL, DstVT, false, false);
        let mut ClampedMin: SDValue = DAG.getNode(SMAX, DL, DstVT, Full, MinC);
        return DAG.getNode(SMIN, DL, DstVT, ClampedMin, MaxC);
    }
    let mut Max: APInt = getMaxValue(SatWidth).zext(DstWidth);
    let mut MaxC: SDValue = DAG.getConstant(Max, DL, DstVT, false, false);
    return DAG.getNode(UMIN, DL, DstVT, Full, MaxC);
}

fn combineRotate(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Src: SDValue = N.getOperand(0);
    let mut Amt: SDValue = N.getOperand(1);
    let mut VT: EVT = Src.getValueType();
    if !VT.isVector() || !DCI.isAfterLegalizeDAG() || !DAG.getTargetLoweringInfo().isOperationLegal(N.getOpcode(), VT) {
        return SDValue {};
    }
    let mut RotateVal: APInt = APInt {};
    if !isConstantSplat(Amt, RotateVal, true) {
        return SDValue {};
    }
    let mut IsROTR: bool = N.getOpcode() == ROTR;
    let mut Opcode: u32 = if IsROTR { VROTRI } else { VROTLI };
    let mut ModAmt: u64 = RotateVal.urem(VT.getScalarSizeInBits());
    let mut Imm: SDValue = DAG.getTargetConstant(ModAmt, DL, i8, false);
    return DAG.getNode(Opcode, DL, VT, [Src, Imm]);
}

fn combineFunnelShift(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut Amt: SDValue = N.getOperand(2);
    let mut VT: EVT = Op0.getValueType();
    if !VT.isVector() {
        return SDValue {};
    }
    if !DAG.getTargetLoweringInfo().isOperationLegal(N.getOpcode(), VT) {
        return SDValue {};
    }
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    let mut ShiftVal: APInt = APInt {};
    if !isConstantSplat(Amt, ShiftVal, true) {
        return SDValue {};
    }
    let mut ModAmt: u64 = ShiftVal.urem(EltSize);
    let mut Imm: SDValue = DAG.getTargetConstant(ModAmt, DL, i8, false);
    let mut IsFSHR: bool = N.getOpcode() == FSHR;
    if IsFSHR {
        swap(Op0, Op1);
    }
    let mut Opcode: u32 = if IsFSHR { VSHRD } else { VSHLD };
    return DAG.getNode(Opcode, DL, VT, [Op0, Op1, Imm]);
}

fn needCarryOrOverflowFlag(Flags: SDValue) -> bool {
    assert!(Flags.getValueType() == i32, "Unexpected VT!");
    for Use in operator(Flags).uses() {
        if Use.getResNo() != Flags.getResNo() {
            continue;
        }
        let mut User: *SDNode = Use.getUser();
        let mut CC: CondCode = zeroed();
        match User.getOpcode() {
            _ => {
                return true;
            },
            SETCC => {
                SETCC_CARRY;
            },
            BRCOND => {
                CMOV;
            },
        }
        match CC {
            _ => {
                break;
            },
            COND_A => {
                COND_AE;
            },
        }
    }
    return false;
}

fn onlyZeroFlagUsed(Flags: SDValue) -> bool {
    assert!(Flags.getValueType() == i32, "Unexpected VT!");
    for Use in operator(Flags).uses() {
        if Use.getResNo() != Flags.getResNo() {
            continue;
        }
        let mut User: *SDNode = Use.getUser();
        let mut CCOpNo: u32 = 0;
        match User.getOpcode() {
            _ => {
                return false;
            },
            SETCC => {
                SETCC_CARRY;
            },
            BRCOND => {
                CMOV;
            },
        }
        let mut CC: CondCode = User.getConstantOperandVal(CCOpNo) as CondCode;
        if CC != COND_E && CC != COND_NE {
            return false;
        }
    }
    return true;
}

fn combineCMP(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if !isNullConstant(N.getOperand(1)) {
        return SDValue {};
    }
    let mut dl: SDLoc = N;
    let mut Op: SDValue = N.getOperand(0);
    let mut VT: EVT = Op.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if combineX86SubCmpForFlags(N, SDValue { Node: N, ResNo: 0 }, DAG, DCI, Subtarget) {
        CMP;
    } else {
        return CMP;
    }
    if (Op.getOpcode() == SRL || Op.getOpcode() == SHL) && Op.hasOneUse() && isa(Op.getOperand(1)) && onlyZeroFlagUsed(SDValue { Node: N, ResNo: 0 }) {
        let mut BitWidth: u32 = VT.getSizeInBits().operator unsigned long long();
        let mut ShAmt: *APInt = Op.getConstantOperandAPInt(1);
        if ShAmt.ult(BitWidth) {
            let mut MaskBits: u32 = BitWidth - ShAmt.getZExtValue();
            let mut Mask: APInt = if Op.getOpcode() == SRL { getHighBitsSet(BitWidth, MaskBits) } else { getLowBitsSet(BitWidth, MaskBits) };
            if Mask.isSignedIntN(32) {
                Op = DAG.getNode(AND, dl, VT, Op.getOperand(0), DAG.getConstant(Mask, dl, VT, false, false));
                return DAG.getNode(CMP, dl, i32, Op, DAG.getConstant(0, dl, VT, false, false));
            }
        }
    }
    if Op.getOpcode() == AND && isOneConstant(Op.getOperand(1)) && Op.hasOneUse() && onlyZeroFlagUsed(SDValue { Node: N, ResNo: 0 }) {
        let mut Src: SDValue = Op.getOperand(0);
        if Src.getOpcode() == EXTRACT_VECTOR_ELT && isNullConstant(Src.getOperand(1)) && Src.getOperand(0).getValueType().getScalarType() == i1 {
            let mut BoolVec: SDValue = Src.getOperand(0);
            let mut ShAmt: u32 = 0;
            if BoolVec.getOpcode() == KSHIFTR {
                ShAmt = BoolVec.getConstantOperandVal(1);
                BoolVec = BoolVec.getOperand(0);
            }
            BoolVec = widenMaskVector(BoolVec, false, Subtarget, DAG, dl);
            let mut VecVT: EVT = BoolVec.getValueType();
            let mut BitWidth: u32 = VecVT.getVectorNumElements();
            let mut BCVT: EVT = getIntegerVT(*DAG.getContext(), BitWidth);
            if TLI.isTypeLegal(VecVT) && TLI.isTypeLegal(BCVT) {
                let mut Mask: APInt = getOneBitSet(BitWidth, ShAmt);
                Op = DAG.getBitcast(BCVT, BoolVec);
                Op = DAG.getNode(AND, dl, BCVT, Op, DAG.getConstant(Mask, dl, BCVT, false, false));
                return DAG.getNode(CMP, dl, i32, Op, DAG.getConstant(0, dl, BCVT, false, false));
            }
        }
    }
    if Op.getOpcode() == ZERO_EXTEND && onlyZeroFlagUsed(SDValue { Node: N, ResNo: 0 }) {
        let mut Src: SDValue = Op.getOperand(0);
        let mut SrcVT: EVT = Src.getValueType();
        if SrcVT.getScalarSizeInBits() >= 8 && TLI.isTypeLegal(SrcVT) {
            return DAG.getNode(CMP, dl, i32, Src, DAG.getConstant(0, dl, SrcVT, false, false));
        }
    }
    if Op.getOpcode() != TRUNCATE {
        return SDValue {};
    }
    let mut Trunc: SDValue = Op;
    Op = Op.getOperand(0);
    let mut OpVT: EVT = Op.getValueType();
    let mut UpperBits: APInt = getBitsSetFrom(OpVT.getSizeInBits().operator unsigned long long(), VT.getSizeInBits().operator unsigned long long());
    if OpVT == i32 && DAG.MaskedValueIsZero(Op, UpperBits, 0) && onlyZeroFlagUsed(SDValue { Node: N, ResNo: 0 }) {
        return DAG.getNode(CMP, dl, i32, Op, DAG.getConstant(0, dl, OpVT, false, false));
    }
    if !Trunc.hasOneUse() || !Op.hasOneUse() {
        return SDValue {};
    }
    let mut NewOpc: u32 = 0;
    match Op.getOpcode() {
        _ => {
            return SDValue {};
        },
        AND => {
            if isa(Op.getOperand(1)) {
                return SDValue {};
            }
        },
        OR => {
            NewOpc = OR;
        },
        XOR => {
            NewOpc = XOR;
        },
        ADD => {
            if needCarryOrOverflowFlag(SDValue { Node: N, ResNo: 0 }) {
                return SDValue {};
            }
        },
        SUB => {
            if needCarryOrOverflowFlag(SDValue { Node: N, ResNo: 0 }) {
                return SDValue {};
            }
        },
    }
    let mut Op0: SDValue = DAG.getNode(TRUNCATE, dl, VT, Op.getOperand(0));
    let mut Op1: SDValue = DAG.getNode(TRUNCATE, dl, VT, Op.getOperand(1));
    let mut VTs: SDVTList = DAG.getVTList(VT, i32);
    Op = DAG.getNode(NewOpc, dl, VTs, Op0, Op1);
    if NewOpc == AND {
        return DAG.getNode(CMP, dl, i32, Op, DAG.getConstant(0, dl, VT, false, false));
    }
    return Op.getValue(1);
}

fn matchGenericOp(Opc: u32, N: *mut SDNode, N0: SDValue, N1: SDValue, DCI: *mut DAGCombinerInfo, Negate: bool) {
    let mut Ops: [2]SDValue = [N0, N1];
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut VTs: SDVTList = DAG.getVTList(N.getValueType(0));
    if DAG.getNodeIfExists(Opc, VTs, Ops, false) {
        Generic;
    } else {
        let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
        if Negate {
            if Generic.hasOneUse() && operator(Generic.user_begin()).isOnlyUserOf(N) {
                return;
            }
            Op = DAG.getNegative(Op, N, N.getValueType(0));
        }
        DCI.CombineTo(Generic, Op, true);
    }
}

fn combineX86AddSub(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, ST: *X86Subtarget) -> SDValue {
    assert!((ADD == N.getOpcode() || SUB == N.getOpcode()), "Expected X86ISD::ADD or X86ISD::SUB");
    let mut DL: SDLoc = N;
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut VT: MVT = LHS.getSimpleValueType();
    let mut IsSub: bool = SUB == N.getOpcode();
    let mut GenericOpc: u32 = if IsSub { SUB } else { ADD };
    if IsSub && isOneConstant(RHS) && !N.hasAnyUseOfValue(0) {
        if combineX86SubCmpForFlags(N, SDValue { Node: N, ResNo: 1 }, DAG, DCI, ST) {
            CMP;
        } else {
            return CMP;
        }
    }
    if !N.hasAnyUseOfValue(1) {
        let mut Res: SDValue = DAG.getNode(GenericOpc, DL, VT, LHS, RHS);
        return DAG.getMergeValues([Res, DAG.getConstant(0, DL, i32, false, false)], DL);
    }
    matchGenericOp(GenericOpc, N, LHS, RHS, DCI, false);
    matchGenericOp(GenericOpc, N, RHS, LHS, DCI, IsSub);
    if dyn_cast(RHS) {
        Const;
    } else {
        let mut NegC: SDValue = DAG.getConstant(operator(Const.getAPIntValue()), DL, VT, false, false);
        if IsSub {
            matchGenericOp(ADD, N, LHS, NegC, DCI, false);
        } else {
            matchGenericOp(SUB, N, NegC, LHS, DCI, true);
        }
    }
    if !IsSub && LHS.getOpcode() == ADC && LHS.hasOneUse() && !needCarryOrOverflowFlag(SDValue { Node: N, ResNo: 1 }) {
        let mut C1: *mut ConstantSDNode = dyn_cast(LHS.getOperand(1));
        let mut C2: *mut ConstantSDNode = dyn_cast(RHS);
        if C1 && C2 {
            let mut Sum: APInt = C1.getAPIntValue() + C2.getAPIntValue();
            return DAG.getNode(ADC, DL, N.getVTList(), LHS.getOperand(0), DAG.getConstant(Sum, DL, VT, false, false), LHS.getOperand(2));
        }
        if C1 && C1.isZero() {
            return DAG.getNode(ADC, DL, N.getVTList(), LHS.getOperand(0), RHS, LHS.getOperand(2));
        }
    }
    return combineAddOrSubToADCOrSBB(IsSub, DL, VT, LHS, RHS, DAG, true, true);
}

fn combineX86XOR(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    assert!(N.getOpcode() == XOR, "Expected X86ISD::XOR");
    let mut DL: SDLoc = N;
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut VT: MVT = LHS.getSimpleValueType();
    if !N.hasAnyUseOfValue(1) {
        let mut Res: SDValue = DAG.getNode(XOR, DL, VT, LHS, RHS);
        return DAG.getMergeValues([Res, DAG.getConstant(0, DL, i32, false, false)], DL);
    }
    matchGenericOp(XOR, N, LHS, RHS, DCI, false);
    matchGenericOp(XOR, N, RHS, LHS, DCI, false);
    return SDValue {};
}

fn combineSBB(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut BorrowIn: SDValue = N.getOperand(2);
    if combineCarryThroughADD(BorrowIn, DAG) {
        Flags;
    } else {
        let mut VT: MVT = N.getSimpleValueType(0);
        let mut VTs: SDVTList = DAG.getVTList(VT, i32);
        return DAG.getNode(SBB, N, VTs, LHS, RHS, Flags);
    }
    if LHS.getOpcode() == SUB && isNullConstant(RHS) && !N.hasAnyUseOfValue(1) {
        return DAG.getNode(SBB, N, N.getVTList(), LHS.getOperand(0), LHS.getOperand(1), BorrowIn);
    }
    return SDValue {};
}

fn combineADC(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut CarryIn: SDValue = N.getOperand(2);
    let mut LHSC: *mut ConstantSDNode = dyn_cast(LHS);
    let mut RHSC: *mut ConstantSDNode = dyn_cast(RHS);
    if LHSC && !RHSC {
        return DAG.getNode(ADC, N, N.getVTList(), RHS, LHS, CarryIn);
    }
    if LHSC && RHSC && LHSC.isZero() && RHSC.isZero() && SDValue { Node: N, ResNo: 1 }.use_empty() {
        let mut DL: SDLoc = N;
        let mut VT: EVT = N.getValueType(0);
        let mut CarryOut: SDValue = DAG.getConstant(0, DL, N.getValueType(1), false, false);
        let mut Res1: SDValue = DAG.getNode(AND, DL, VT, DAG.getNode(SETCC_CARRY, DL, VT, DAG.getTargetConstant(COND_B, DL, i8, false), CarryIn), DAG.getConstant(1, DL, VT, false, false));
        return DCI.CombineTo(N, Res1, CarryOut, true);
    }
    if LHSC && RHSC && !LHSC.isZero() {
        let mut UOF: bool = false;
        let mut SOF: bool = false;
        let mut Sum: APInt = LHSC.getAPIntValue().uadd_ov(RHSC.getAPIntValue(), UOF);
        LHSC.getAPIntValue().sadd_ov(RHSC.getAPIntValue(), SOF) as void;
        if !N.hasAnyUseOfValue(1) || (!UOF && !SOF) {
            let mut DL: SDLoc = N;
            return DAG.getNode(ADC, DL, N.getVTList(), DAG.getConstant(0, DL, LHS.getValueType(), false, false), DAG.getConstant(Sum, DL, LHS.getValueType(), false, false), CarryIn);
        }
    }
    if combineCarryThroughADD(CarryIn, DAG) {
        Flags;
    } else {
        let mut VT: MVT = N.getSimpleValueType(0);
        let mut VTs: SDVTList = DAG.getVTList(VT, i32);
        return DAG.getNode(ADC, N, VTs, LHS, RHS, Flags);
    }
    if LHS.getOpcode() == ADD && RHSC && RHSC.isZero() && !needCarryOrOverflowFlag(SDValue { Node: N, ResNo: 1 }) {
        return DAG.getNode(ADC, N, N.getVTList(), LHS.getOperand(0), LHS.getOperand(1), CarryIn);
    }
    if LHS.getOpcode() == SHL && isOneConstant(LHS.getOperand(1)) && RHSC && RHSC.isZero() && !needCarryOrOverflowFlag(SDValue { Node: N, ResNo: 1 }) {
        let mut X: SDValue = DAG.getFreeze(LHS.getOperand(0));
        return DAG.getNode(ADC, N, N.getVTList(), X, X, CarryIn);
    }
    return SDValue {};
}

fn combineADOX(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut CarryIn: SDValue = N.getOperand(2);
    let mut LHSC: *mut ConstantSDNode = dyn_cast(LHS);
    let mut RHSC: *mut ConstantSDNode = dyn_cast(RHS);
    if LHSC && !RHSC {
        return DAG.getNode(ADOX, N, N.getVTList(), RHS, LHS, CarryIn);
    }
    let mut AddOp: SDValue = LHS;
    if AddOp.getOpcode() == ANY_EXTEND || AddOp.getOpcode() == ZERO_EXTEND {
        AddOp = AddOp.getOperand(0);
    }
    if AddOp.getOpcode() == ADD && RHSC && RHSC.isZero() && !needCarryOrOverflowFlag(SDValue { Node: N, ResNo: 1 }) {
        if AddOp != LHS {
            let mut OrigBits: u32 = AddOp.getValueSizeInBits().operator unsigned long long();
            for Use in N.uses() {
                if Use.getResNo() == 0 {
                    let mut User: *mut SDNode = Use.getUser();
                    if User.getOpcode() != TRUNCATE || User.getValueSizeInBits(0).operator unsigned long long() > OrigBits {
                        return SDValue {};
                    }
                }
            }
        }
        let mut X: SDValue = AddOp.getOperand(0);
        let mut Y: SDValue = AddOp.getOperand(1);
        if AddOp != LHS {
            X = DAG.getNode(LHS.getOpcode(), N, LHS.getValueType(), X);
            Y = DAG.getNode(LHS.getOpcode(), N, LHS.getValueType(), Y);
        }
        return DAG.getNode(ADOX, N, N.getVTList(), X, Y, CarryIn);
    }
    return SDValue {};
}

fn matchPMADDWD(DAG: *mut SelectionDAG, N: *mut SDNode, DL: *SDLoc, VT: EVT, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    if !VT.isVectorOf(i32) || VT.getVectorNumElements() < 4 || !isPowerOf2_32(VT.getVectorNumElements()) {
        return SDValue {};
    }
    let mut Op0: SDValue = SDValue {};
    let mut Op1: SDValue = SDValue {};
    let mut Accum: SDValue = SDValue {};
    if !sd_match(N, m_Add(m_Value(Op0, m_SpecificOpc(BUILD_VECTOR)), m_Value(Op1, m_SpecificOpc(BUILD_VECTOR)))) && !sd_match(N, m_Add(m_Value(Op0, m_SpecificOpc(BUILD_VECTOR)), m_Add(m_Value(Accum), m_Value(Op1, m_SpecificOpc(BUILD_VECTOR))))) {
        return SDValue {};
    }
    let mut Mul: SDValue = SDValue {};
    for let mut i: u32 = 0;
let mut e: u32 = VT.getVectorNumElements(); i != e; i += 2 {
        let mut Op0L: SDValue = operator(Op0).getOperand(i);
        let mut Op1L: SDValue = operator(Op1).getOperand(i);
        let mut Op0H: SDValue = operator(Op0).getOperand(i + 1);
        let mut Op1H: SDValue = operator(Op1).getOperand(i + 1);
        let mut Idx0L: APInt = APInt {};
        let mut Idx0H: APInt = APInt {};
        let mut Idx1L: APInt = APInt {};
        let mut Idx1H: APInt = APInt {};
        let mut Vec0L: SDValue = SDValue {};
        let mut Vec0H: SDValue = SDValue {};
        let mut Vec1L: SDValue = SDValue {};
        let mut Vec1H: SDValue = SDValue {};
        if !sd_match(Op0L, m_ExtractElt(m_Value(Vec0L), m_ConstInt(Idx0L))) || !sd_match(Op0H, m_ExtractElt(m_Value(Vec0H), m_ConstInt(Idx0H))) || !sd_match(Op1L, m_ExtractElt(m_Value(Vec1L), m_ConstInt(Idx1L))) || !sd_match(Op1H, m_ExtractElt(m_Value(Vec1H), m_ConstInt(Idx1H))) {
            return SDValue {};
        }
        if Idx0L.getZExtValue() > Idx1L.getZExtValue() {
            swap(Idx0L, Idx1L);
        }
        if Idx0H.getZExtValue() > Idx1H.getZExtValue() {
            swap(Idx0H, Idx1H);
        }
        if Idx0L.getZExtValue() > Idx0H.getZExtValue() {
            swap(Idx0L, Idx0H);
            swap(Idx1L, Idx1H);
        }
        if Idx0L != 2 * i || Idx1L != 2 * i + 1 || Idx0H != 2 * i + 2 || Idx1H != 2 * i + 3 {
            return SDValue {};
        }
        if !Mul {
            Mul = Vec0L;
            if (Mul.getOpcode() != MUL && Mul.getOpcode() != SHL && Mul.getOpcode() != SIGN_EXTEND) || Mul.getValueType().getVectorNumElements() < (2 * e) {
                return SDValue {};
            }
        }
        if Mul != Vec0L || Mul != Vec1L || Mul != Vec0H || Mul != Vec1H {
            return SDValue {};
        }
    }
    let mut TruncVT: EVT = getVectorVT(*DAG.getContext(), i16, VT.getVectorNumElements() * 2, false);
    let mut MulVT: EVT = TruncVT.changeVectorElementType(*DAG.getContext(), i32);
    let mut N0: SDValue = SDValue {};
    let mut N1: SDValue = SDValue {};
    if Mul.getOpcode() == MUL {
        let mut Mode: ShrinkMode = zeroed();
        if !canReduceVMulWidth(Mul.getNode(), DAG, Mode) || Mode == MULU16 {
            return SDValue {};
        }
        N0 = DAG.getExtractSubvector(DL, MulVT, Mul.getOperand(0), 0);
        N1 = DAG.getExtractSubvector(DL, MulVT, Mul.getOperand(1), 0);
        N0 = DAG.getNode(TRUNCATE, DL, TruncVT, N0);
        N1 = DAG.getNode(TRUNCATE, DL, TruncVT, N1);
    } else if Mul.getOpcode() == SHL {
        let mut ShVal: SDValue = Mul.getOperand(0);
        if ShVal.getOpcode() != SIGN_EXTEND {
            return SDValue {};
        }
        N0 = ShVal.getOperand(0);
        if N0.getValueType().getScalarType() != i16 {
            return SDValue {};
        }
        if !matchUnaryPredicate(Mul.getOperand(1), Closure_241 {}, false, false) {
            return SDValue {};
        }
        N0 = DAG.getExtractSubvector(DL, TruncVT, N0, 0);
        N1 = DAG.getExtractSubvector(DL, MulVT, Mul.getOperand(1), 0);
        N1 = DAG.getNode(SHL, DL, TruncVT, DAG.getConstant(1, DL, TruncVT, false, false), DAG.getZExtOrTrunc(N1, DL, TruncVT));
    } else {
        assert!(Mul.getOpcode() == SIGN_EXTEND);
        if Mul.getOperand(0).getValueType().getScalarType() != i16 {
            return SDValue {};
        }
        N0 = DAG.getExtractSubvector(DL, TruncVT, Mul.getOperand(0), 0);
        N1 = DAG.getConstant(1, DL, TruncVT, false, false);
    }
    let mut PMADDBuilder: Closure_242 = Closure_242 {};
    let mut R: SDValue = SplitOpsAndApply(DAG, Subtarget, DL, VT, [N0, N1], PMADDBuilder, true, true);
    if Accum {
        R = DAG.getNode(ADD, DL, VT, R, Accum);
    }
    return R;
}

fn matchPMADDWD_2(DAG: *mut SelectionDAG, N: *mut SDNode, DL: *SDLoc, VT: EVT, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    if !VT.isVectorOf(i32) || VT.getVectorNumElements() < 4 || !isPowerOf2_32(VT.getVectorNumElements()) {
        return SDValue {};
    }
    let mut N00: SDValue = SDValue {};
    let mut N01: SDValue = SDValue {};
    let mut N10: SDValue = SDValue {};
    let mut N11: SDValue = SDValue {};
    if !sd_match(N, m_Add(m_Mul(m_SExt(m_Value(N00)), m_SExt(m_Value(N01))), m_Mul(m_SExt(m_Value(N10)), m_SExt(m_Value(N11))))) {
        return SDValue {};
    }
    let mut InVT: EVT = N00.getValueType();
    if InVT.getVectorElementType() != i16 || N01.getValueType() != InVT || N10.getValueType() != InVT || N11.getValueType() != InVT {
        return SDValue {};
    }
    if N00.getOpcode() != BUILD_VECTOR || N01.getOpcode() != BUILD_VECTOR || N10.getOpcode() != BUILD_VECTOR || N11.getOpcode() != BUILD_VECTOR {
        return SDValue {};
    }
    let mut In0: SDValue = SDValue {};
    let mut In1: SDValue = SDValue {};
    for let mut i: u32 = 0; i != N00.getNumOperands(); i += 1 {
        let mut N00Elt: SDValue = N00.getOperand(i);
        let mut N01Elt: SDValue = N01.getOperand(i);
        let mut N10Elt: SDValue = N10.getOperand(i);
        let mut N11Elt: SDValue = N11.getOperand(i);
        let mut N00In: SDValue = SDValue {};
        let mut N01In: SDValue = SDValue {};
        let mut N10In: SDValue = SDValue {};
        let mut N11In: SDValue = SDValue {};
        let mut IdxN00: APInt = APInt {};
        let mut IdxN01: APInt = APInt {};
        let mut IdxN10: APInt = APInt {};
        let mut IdxN11: APInt = APInt {};
        if !sd_match(N00Elt, m_ExtractElt(m_Value(N00In), m_ConstInt(IdxN00))) || !sd_match(N01Elt, m_ExtractElt(m_Value(N01In), m_ConstInt(IdxN01))) || !sd_match(N10Elt, m_ExtractElt(m_Value(N10In), m_ConstInt(IdxN10))) || !sd_match(N11Elt, m_ExtractElt(m_Value(N11In), m_ConstInt(IdxN11))) {
            return SDValue {};
        }
        if IdxN00.getZExtValue() > IdxN10.getZExtValue() {
            swap(IdxN00, IdxN10);
            swap(IdxN01, IdxN11);
        }
        if IdxN00 != 2 * i || IdxN10 != 2 * i + 1 || IdxN01 != 2 * i || IdxN11 != 2 * i + 1 {
            return SDValue {};
        }
        if !In0 {
            In0 = N00In;
            In1 = N01In;
            if In0.getValueSizeInBits().operator unsigned long long() < VT.getSizeInBits().operator unsigned long long() || In1.getValueSizeInBits().operator unsigned long long() < VT.getSizeInBits().operator unsigned long long() {
                return SDValue {};
            }
        }
        if In0 != N00In {
            swap(N00In, N01In);
        }
        if In0 != N10In {
            swap(N10In, N11In);
        }
        if In0 != N00In || In1 != N01In || In0 != N10In || In1 != N11In {
            return SDValue {};
        }
    }
    let mut PMADDBuilder: Closure_243 = Closure_243 {};
    let mut OutVT16: EVT = getVectorVT(*DAG.getContext(), i16, VT.getVectorNumElements() * 2, false);
    if OutVT16.bitsLT(In0.getValueType()) {
        In0 = DAG.getNode(EXTRACT_SUBVECTOR, DL, OutVT16, In0, DAG.getVectorIdxConstant(0, DL, false));
    }
    if OutVT16.bitsLT(In1.getValueType()) {
        In1 = DAG.getNode(EXTRACT_SUBVECTOR, DL, OutVT16, In1, DAG.getVectorIdxConstant(0, DL, false));
    }
    return SplitOpsAndApply(DAG, Subtarget, DL, VT, [In0, In1], PMADDBuilder, true, true);
}

fn combineAddOfPMADDWD(DAG: *mut SelectionDAG, N0: SDValue, N1: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    if N0.getOpcode() != N1.getOpcode() || N0.getOpcode() != VPMADDWD {
        return SDValue {};
    }
    if VT.getSizeInBits().operator unsigned long long() > 128 {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut OpVT: MVT = N0.getOperand(0).getSimpleValueType();
    let mut DemandedHiElts: APInt = getSplat(2 * NumElts, APInt { 2, 2, false, false });
    let mut Op0HiZero: bool = DAG.MaskedVectorIsZero(N0.getOperand(0), DemandedHiElts, 0) || DAG.MaskedVectorIsZero(N0.getOperand(1), DemandedHiElts, 0);
    let mut Op1HiZero: bool = DAG.MaskedVectorIsZero(N1.getOperand(0), DemandedHiElts, 0) || DAG.MaskedVectorIsZero(N1.getOperand(1), DemandedHiElts, 0);
    if !Op0HiZero || !Op1HiZero {
        return SDValue {};
    }
    let mut Mask: SmallVector<int> = SmallVector<int> {};
    for let mut i: i32 = 0; i != NumElts as i32; i += 1 {
        Mask.push(2 * i);
        Mask.push(2 * (i + NumElts));
    }
    let mut LHS: SDValue = DAG.getVectorShuffle(OpVT, DL, N0.getOperand(0), N1.getOperand(0), Mask);
    let mut RHS: SDValue = DAG.getVectorShuffle(OpVT, DL, N0.getOperand(1), N1.getOperand(1), Mask);
    return DAG.getNode(VPMADDWD, DL, VT, LHS, RHS);
}

fn pushAddIntoCmovOfConsts(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut isSuitableCmov: Closure_244 = Closure_244 {};
    let mut Cmov: SDValue = N.getOperand(0);
    let mut OtherOp: SDValue = N.getOperand(1);
    if !isSuitableCmov.call(Cmov) {
        swap(Cmov, OtherOp);
    }
    if !isSuitableCmov.call(Cmov) {
        return SDValue {};
    }
    if mayFoldLoad(OtherOp, Subtarget, false, false) {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut FalseOp: SDValue = Cmov.getOperand(0);
    let mut TrueOp: SDValue = Cmov.getOperand(1);
    if OtherOp.getOpcode() == ADD && OtherOp.hasOneUse() && !isa(OtherOp.getOperand(0)) && all_of(N.users(), Closure_245 { N: &mut N }) {
        let mut X: SDValue = OtherOp.getOperand(0);
        let mut Y: SDValue = OtherOp.getOperand(1);
        FalseOp = DAG.getNode(ADD, DL, VT, X, FalseOp);
        TrueOp = DAG.getNode(ADD, DL, VT, X, TrueOp);
        Cmov = DAG.getNode(CMOV, DL, VT, FalseOp, TrueOp, Cmov.getOperand(2), Cmov.getOperand(3));
        return DAG.getNode(ADD, DL, VT, Cmov, Y);
    }
    FalseOp = DAG.getNode(ADD, DL, VT, OtherOp, FalseOp);
    TrueOp = DAG.getNode(ADD, DL, VT, OtherOp, TrueOp);
    return DAG.getNode(CMOV, DL, VT, FalseOp, TrueOp, Cmov.getOperand(2), Cmov.getOperand(3));
}

fn matchVPMADD52(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, VT: EVT, Subtarget: *X86Subtarget) -> SDValue {
    if !VT.isVector() || VT.getScalarSizeInBits() != 64 || (!Subtarget.hasAVXIFMA() && !Subtarget.hasIFMA()) {
        return SDValue {};
    }
    let mut TotalSize: TypeSize = VT.getSizeInBits();
    if TotalSize.operator unsigned long long() < 128 || !isPowerOf2_64(TotalSize.operator unsigned long long()) {
        return SDValue {};
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut Acc: SDValue = SDValue {};
    if !sd_match(N, m_Add(m_Mul(m_Value(X), m_Value(Y)), m_Value(Acc))) {
        return SDValue {};
    }
    let mut KnownX: KnownBits = DAG.computeKnownBits(X, 0);
    if KnownX.countMinLeadingZeros() < 12 {
        return SDValue {};
    }
    let mut KnownY: KnownBits = DAG.computeKnownBits(Y, 0);
    if KnownY.countMinLeadingZeros() < 12 {
        return SDValue {};
    }
    let mut KnownMul: KnownBits = mul(KnownX, KnownY, false);
    if KnownMul.countMinLeadingZeros() < 12 {
        return SDValue {};
    }
    let mut VPMADD52Builder: Closure_246 = Closure_246 {};
    return SplitOpsAndApply(DAG, Subtarget, DL, VT, [Acc, X, Y], VPMADD52Builder, false, Subtarget.hasIFMA());
}

fn combineAdd(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut DL: SDLoc = N;
    if pushAddIntoCmovOfConsts(N, DL, DAG, Subtarget) {
        Select;
    } else {
        return Select;
    }
    if matchPMADDWD(DAG, N, DL, VT, Subtarget) {
        MAdd;
    } else {
        return MAdd;
    }
    if matchPMADDWD_2(DAG, N, DL, VT, Subtarget) {
        MAdd;
    } else {
        return MAdd;
    }
    if combineAddOfPMADDWD(DAG, Op0, Op1, DL, VT) {
        MAdd;
    } else {
        return MAdd;
    }
    if combineToHorizontalAddSub(N, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if Op0 == Op1 && supportedVectorShiftWithImm(VT, Subtarget, SHL) {
        if Subtarget.hasAVX() || N.isOnlyUserOf(Op0.getNode()) {
            return getTargetVShiftByConstNode(VSHLI, DL, VT.getSimpleVT(), Op0, 1, DAG);
        }
    }
    if VT == i32 || VT == i64 {
        let mut Y: SDValue = SDValue {};
        let mut Z: SDValue = SDValue {};
        let mut Shift: SDValue = SDValue {};
        let mut Amt: APInt = APInt {};
        if sd_match(N, m_Add(m_OneUse(m_Sub(m_Value(Shift, m_Shl(m_Value(), m_ConstInt(Amt))), m_Value(Y))), m_Value(Z))) && Amt.ult(4) && !isa(Z) {
            return DAG.getNode(SUB, DL, VT, DAG.getNode(ADD, DL, VT, Shift, Z), Y);
        }
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if sd_match(Op0, m_c_BinOp(PSADBW, m_Value(X), m_Zero(false), SDNodeFlags { Flags: None })) && sd_match(Op1, m_c_BinOp(PSADBW, m_Value(Y), m_Zero(false), SDNodeFlags { Flags: None })) && DAG.willNotOverflowAdd(false, X, Y) {
        let mut OpVT: MVT = X.getSimpleValueType();
        let mut Sum: SDValue = DAG.getNode(ADD, DL, OpVT, X, Y);
        return DAG.getNode(PSADBW, DL, VT, Sum, getZeroVector(OpVT, Subtarget, DAG, DL));
    }
    if VT.isVector() {
        let mut BoolVT: EVT = getVectorVT(*DAG.getContext(), i1, VT.getVectorElementCount());
        if DAG.getTargetLoweringInfo().isTypeLegal(BoolVT) && sd_match(N, m_Add(m_ZExt(m_Value(X, m_SpecificVT(BoolVT))), m_Value(Y))) {
            let mut SExt: SDValue = DAG.getNode(SIGN_EXTEND, DL, VT, X);
            return DAG.getNode(SUB, DL, VT, Y, SExt);
        }
        if VT.getScalarType() == i8 && sd_match(N, m_Add(m_Value(X), m_Srl(m_Value(Y), m_SpecificInt(7)))) {
            let mut Cmp: SDValue = DAG.getSetCC(DL, BoolVT, DAG.getConstant(0, DL, VT, false, false), Y, SETGT, SDValue {}, false, None);
            return DAG.getNode(SUB, DL, VT, X, DAG.getSExtOrTrunc(Cmp, DL, VT));
        }
    }
    if Op0.getOpcode() == ADC && operator(Op0).hasOneUse() && isZeroNode(Op0.getOperand(1)) {
        assert!(!operator(Op0).hasAnyUseOfValue(1), "Overflow bit in use");
        return DAG.getNode(ADC, Op0, operator(Op0).getVTList(), Op1, Op0.getOperand(0), Op0.getOperand(2));
    }
    let mut SBB: SDValue = Op0;
    let mut C: SDValue = Op1;
    if SBB.getOpcode() != SBB {
        swap(SBB, C);
    }
    if SBB.getOpcode() == SBB && operator(SBB).hasOneUse() && isZeroNode(SBB.getOperand(1)) && !operator(SBB).hasAnyUseOfValue(1) {
        let mut SBBLoc: SDLoc = SBB;
        return DAG.getNode(SBB, SBBLoc, operator(SBB).getVTList(), SBB.getOperand(0), DAG.getNegative(C, SBBLoc, VT), SBB.getOperand(2)).getValue(0);
    }
    if matchVPMADD52(N, DAG, DL, VT, Subtarget) {
        IFMA52;
    } else {
        return IFMA52;
    }
    return combineAddOrSubToADCOrSBB(N, DL, DAG);
}

fn combineSubABS(VT: EVT, DL: *SDLoc, N0: SDValue, N1: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if N1.getOpcode() != CMOV || !N1.hasOneUse() {
        return SDValue {};
    }
    let mut Cond: SDValue = N1.getOperand(3);
    if Cond.getOpcode() != SUB {
        return SDValue {};
    }
    assert!(Cond.getResNo() == 1, "Unexpected result number");
    let mut FalseOp: SDValue = N1.getOperand(0);
    let mut TrueOp: SDValue = N1.getOperand(1);
    let mut CC: CondCode = N1.getConstantOperandVal(2) as CondCode;
    if (CC == COND_S || CC == COND_NS) && isNullConstant(Cond.getOperand(0)) {
        let mut NegX: SDValue = Cond.getValue(0);
        let mut X: SDValue = Cond.getOperand(1);
        if !(TrueOp == X && FalseOp == NegX) && !(TrueOp == NegX && FalseOp == X) {
            return SDValue {};
        }
        let mut Cmov: SDValue = DAG.getNode(CMOV, DL, VT, TrueOp, FalseOp, N1.getOperand(2), Cond);
        return DAG.getNode(ADD, DL, VT, N0, Cmov);
    }
    if (CC == COND_L || CC == COND_B) && isNullConstant(N0) && (FalseOp == Cond.getValue(0) || TrueOp == Cond.getValue(0)) && (TrueOp.getOpcode() == SUB || TrueOp.getOpcode() == SUB) && (FalseOp.getOpcode() == SUB || FalseOp.getOpcode() == SUB) && (TrueOp.getOperand(0) == FalseOp.getOperand(1)) && (TrueOp.getOperand(1) == FalseOp.getOperand(0)) {
        return DAG.getNode(CMOV, DL, VT, TrueOp, FalseOp, N1.getOperand(2), Cond);
    }
    return SDValue {};
}

fn combineSubSetcc(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut Op0C: *mut ConstantSDNode = dyn_cast(Op0);
    if Op1.getOpcode() == ZERO_EXTEND && Op1.hasOneUse() && Op0C && !Op0C.isZero() && Op1.getOperand(0).getOpcode() == SETCC && Op1.getOperand(0).hasOneUse() {
        let mut SetCC: SDValue = Op1.getOperand(0);
        let mut CC: CondCode = SetCC.getConstantOperandVal(0) as CondCode;
        let mut NewCC: CondCode = GetOppositeBranchCondition(CC);
        let mut NewImm: APInt = Op0C.getAPIntValue() - 1;
        let mut DL: SDLoc = Op1;
        let mut NewSetCC: SDValue = getSETCC(NewCC, SetCC.getOperand(1), DL, DAG);
        NewSetCC = DAG.getNode(ZERO_EXTEND, DL, VT, NewSetCC);
        return DAG.getNode(ADD, DL, VT, NewSetCC, DAG.getConstant(NewImm, DL, VT, false, false));
    }
    return SDValue {};
}

fn combineX86CloadCstore(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getConstantOperandVal(3) != COND_NE {
        return SDValue {};
    }
    let mut Sub: SDValue = N.getOperand(4);
    if Sub.getOpcode() != SUB {
        return SDValue {};
    }
    let mut Op1: SDValue = Sub.getOperand(1);
    if !isZeroNode(Sub.getOperand(0)) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut Ops: SmallVector<SDValue, 5> = N.op_values();
    if Op1.getOpcode() == SETCC {
        Ops[3] = Op1.getOperand(0);
        Ops[4] = Op1.getOperand(1);
    } else if Op1.getOpcode() == AND && Sub.getValue(0).use_empty() {
        let mut Src: SDValue = Op1;
        let mut Op10: SDValue = Op1.getOperand(0);
        if Op10.getOpcode() == XOR && isAllOnesConstant(Op10.getOperand(1)) && isOneConstant(Op1.getOperand(1)) {
            Src = DAG.getNode(AND, DL, Op1.getValueType(), Op10.getOperand(0), Op1.getOperand(1));
            Ops[3] = DAG.getTargetConstant(COND_E, DL, i8, false);
        }
        Ops[4] = DAG.getNode(CMP, DL, i32, Src, Sub.getOperand(0));
    } else {
        return SDValue {};
    }
    return DAG.getMemIntrinsicNode(N.getOpcode(), DL, N.getVTList(), Ops, cast(N).getMemoryVT(), cast(N).getMemOperand());
}

fn combineSub(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut DL: SDLoc = N;
    let mut IsNonOpaqueConstant: Closure_247 = Closure_247 { DAG: &mut DAG };
    if Op1.getOpcode() == XOR && IsNonOpaqueConstant.call(Op0) && !isNullConstant(Op0) && IsNonOpaqueConstant.call(Op1.getOperand(1)) && operator(Op1).hasOneUse() {
        let mut NewXor: SDValue = DAG.getNode(XOR, Op1, VT, Op1.getOperand(0), DAG.getNOT(Op1, Op1.getOperand(1), VT));
        let mut NewAdd: SDValue = DAG.getNode(ADD, DL, VT, Op0, DAG.getConstant(1, DL, VT, false, false));
        return DAG.getNode(ADD, DL, VT, NewXor, NewAdd);
    }
    if combineSubABS(VT, DL, Op0, Op1, DAG) {
        V;
    } else {
        return V;
    }
    if combineToHorizontalAddSub(N, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if Op1.getOpcode() == ADC && operator(Op1).hasOneUse() && isZeroNode(Op1.getOperand(1)) {
        assert!(!operator(Op1).hasAnyUseOfValue(1), "Overflow bit in use");
        return DAG.getNode(SBB, Op1, operator(Op1).getVTList(), Op0, Op1.getOperand(0), Op1.getOperand(2));
    }
    if Op1.getOpcode() == SBB && operator(Op1).hasOneUse() && !(isZeroNode(Op0) && isZeroNode(Op1.getOperand(1))) {
        assert!(!operator(Op1).hasAnyUseOfValue(1), "Overflow bit in use");
        let mut ADC: SDValue = DAG.getNode(ADC, Op1, operator(Op1).getVTList(), Op0, Op1.getOperand(1), Op1.getOperand(2));
        return DAG.getNode(SUB, DL, VT, ADC.getValue(0), Op1.getOperand(0));
    }
    if isBitwiseNot(Op0, false) && Op0.hasOneUse() && isBitwiseNot(Op1, false) && Op1.hasOneUse() {
        return DAG.getNode(SUB, DL, VT, Op1.getOperand(0), Op0.getOperand(0));
    }
    if combineXorSubCTLZ(N, DL, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if combineAddOrSubToADCOrSBB(N, DL, DAG) {
        V;
    } else {
        return V;
    }
    return combineSubSetcc(N, DAG);
}

fn combineVectorCompare(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    assert!((Opcode == PCMPEQ || Opcode == PCMPGT), "Unknown PCMP opcode");
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut DL: SDLoc = N;
    if LHS == RHS {
        return if (Opcode == PCMPEQ) { DAG.getAllOnesConstant(DL, VT, false, false) } else { DAG.getConstant(0, DL, VT, false, false) };
    }
    let mut LHSUndefs: APInt = APInt {};
    let mut RHSUndefs: APInt = APInt {};
    let mut LHSBits: SmallVector<APInt> = SmallVector<APInt> {};
    let mut RHSBits: SmallVector<APInt> = SmallVector<APInt> {};
    if getTargetConstantBitsFromNode(LHS, EltBits, LHSUndefs, LHSBits, true, false) && getTargetConstantBitsFromNode(RHS, EltBits, RHSUndefs, RHSBits, true, false) {
        let mut Ones: APInt = getAllOnes(EltBits);
        let mut Zero: APInt = getZero(EltBits);
        let mut Results: SmallVector<APInt> = NumElts;
        for let mut I: u32 = 0; I != NumElts; I += 1 {
            if Opcode == PCMPEQ {
                Results[I] = if (LHSBits[I] == RHSBits[I]) { Ones } else { Zero };
            } else {
                let mut AnyUndef: bool = LHSUndefs[I] || RHSUndefs[I];
                Results[I] = if (!AnyUndef && LHSBits[I].sgt(RHSBits[I])) { Ones } else { Zero };
            }
        }
        if Opcode == PCMPEQ {
            return getConstVector(Results, LHSUndefs | RHSUndefs, VT, DAG, DL);
        }
        return getConstVector(Results, VT, DAG, DL);
    }
    return SDValue {};
}

fn CastIntSETCCtoFP(VT: MVT, CC: CondCode, NumSignificantBitsLHS: u32, NumSignificantBitsRHS: u32) -> optional<unsigned int> {
    let mut SVT: MVT = VT.getScalarType();
    assert!(SVT == f32, "Only tested for float so far");
    let mut Sem: *fltSemantics = SVT.getFltSemantics();
    assert!((CC == SETEQ || CC == SETGT), "Only PCMPEQ/PCMPGT currently supported");
    let mut FPPrec: u32 = semanticsPrecision(Sem);
    if FPPrec >= NumSignificantBitsLHS && FPPrec >= NumSignificantBitsRHS {
        return SINT_TO_FP;
    }
    return nullopt;
}

fn combineConcatVectorOps(DL: *SDLoc, VT: MVT, Ops: ArrayRef<SDValue>, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, Depth: u32) -> SDValue {
    assert!(Subtarget.hasAVX(), "AVX assumed for concat_vectors");
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    if all_of(Ops, Closure_248 {}) {
        return DAG.getUNDEF(VT);
    }
    if all_of(Ops, Closure_249 {}) {
        return getZeroVector(VT, Subtarget, DAG, DL);
    }
    if Depth >= MaxRecursionDepth {
        return SDValue {};
    }
    let mut Op0: SDValue = Ops[0];
    let mut IsSplat: bool = all_equal(Ops);
    let mut NumOps: u32 = Ops.len;
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    if IsSplat && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.hasAVX512())) {
        if Op0.getOpcode() == VBROADCAST {
            return DAG.getNode(Op0.getOpcode(), DL, VT, Op0.getOperand(0));
        }
        if Op0.getOpcode() == MOVDDUP && VT == v4f64 && (Subtarget.hasAVX2() || mayFoldLoadIntoBroadcastFromMem(Op0.getOperand(0), VT.getScalarType(), Subtarget, false)) {
            return DAG.getNode(VBROADCAST, DL, VT, DAG.getNode(EXTRACT_VECTOR_ELT, DL, f64, Op0.getOperand(0), DAG.getVectorIdxConstant(0, DL, false)));
        }
        if Op0.getOpcode() == SCALAR_TO_VECTOR && (Subtarget.hasAVX2() || (EltSizeInBits >= 32 && mayFoldLoad(Op0.getOperand(0), Subtarget, false, false))) && Op0.getOperand(0).getValueType() == VT.getScalarType() {
            return DAG.getNode(VBROADCAST, DL, VT, Op0.getOperand(0));
        }
        if Op0.getOpcode() == EXTRACT_SUBVECTOR && Op0.getOperand(0).getValueType() == VT {
            let mut SrcVec: SDValue = Op0.getOperand(0);
            if DAG.isSplatValue(SrcVec, false) {
                return SrcVec;
            }
            if SrcVec.getOpcode() == SUBV_BROADCAST_LOAD && Op0.getValueType() == cast(SrcVec).getMemoryVT() {
                return SrcVec;
            }
        }
        if Op0.getOpcode() == VPERMI && Subtarget.useAVX512Regs() && !mayFoldLoad(Op0.getOperand(0), Subtarget, false, false) {
            return DAG.getNode(Op0.getOpcode(), DL, VT, DAG.getNode(CONCAT_VECTORS, DL, VT, Op0.getOperand(0), Op0.getOperand(0)), Op0.getOperand(1));
        }
    }
    if NumOps == 2 {
        let mut Src0: SDValue = peekThroughBitcasts(Ops[0]);
        let mut Src1: SDValue = peekThroughBitcasts(Ops[1]);
        if Src0.getOpcode() == EXTRACT_SUBVECTOR && Src1.getOpcode() == EXTRACT_SUBVECTOR {
            let mut SrcVT0: EVT = Src0.getOperand(0).getValueType();
            let mut SrcVT1: EVT = Src1.getOperand(0).getValueType();
            let mut NumSrcElts0: u32 = SrcVT0.getVectorNumElements();
            let mut NumSrcElts1: u32 = SrcVT1.getVectorNumElements();
            let mut SrcIdx0: *APInt = Src0.getConstantOperandAPInt(1);
            let mut SrcIdx1: *APInt = Src1.getConstantOperandAPInt(1);
            if VT.is256BitVector() && SrcVT0.is256BitVector() && SrcVT1.is256BitVector() {
                assert!((SrcIdx0 == 0 || SrcIdx0 == (NumSrcElts0 / 2)) && (SrcIdx1 == 0 || SrcIdx1 == (NumSrcElts1 / 2)), "Bad subvector index");
                if (SrcIdx0 == (NumSrcElts0 / 2) && SrcIdx1 == (NumSrcElts1 / 2)) || (IsSplat && isNormalLoad(Src0.getOperand(0).getNode())) {
                    let mut Index: u32 = 0;
                    Index |= if SrcIdx0 == 0 { 0 } else { 1 };
                    Index |= if SrcIdx1 == 0 { 32 } else { 48 };
                    return DAG.getNode(VPERM2X128, DL, VT, DAG.getBitcast(VT, Src0.getOperand(0)), DAG.getBitcast(VT, Src1.getOperand(0)), DAG.getTargetConstant(Index, DL, i8, false));
                }
            }
            let mut NumSubElts0: u32 = Src0.getValueType().getVectorNumElements();
            if Src0.getOperand(0) == Src1.getOperand(0) && (SrcIdx0 == 0 || SrcIdx0 == (NumSrcElts0 / 2)) && SrcIdx1 == (SrcIdx0 + NumSubElts0) {
                return DAG.getBitcast(VT, extractSubVector(Src0.getOperand(0), Src0.getConstantOperandVal(1), DAG, DL, VT.getSizeInBits().operator unsigned long long()));
            }
        }
    }
    if all_of(Ops, Closure_250 { cap_0: Op0 }) {
        let mut ConcatSubOperand: Closure_251 = Closure_251 { DAG: &mut DAG, DL: &mut DL, Subtarget: &mut Subtarget, Depth: &mut Depth };
        let mut IsOpConstant: Closure_252 = Closure_252 {};
        let mut IsConcatFree: Closure_253 = Closure_253 { IsOpConstant: &mut IsOpConstant, DAG: &mut DAG };
        let mut CombineSubOperand: Closure_255 = Closure_255 { IsOpConstant: &mut IsOpConstant, DAG: &mut DAG, DL: &mut DL, Subtarget: &mut Subtarget, Depth: &mut Depth };
        let mut Opcode: u32 = Op0.getOpcode();
        match Opcode {
            BITCAST => {
                let mut SubOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
                for SubOp in Ops {
                    SubOps.push(peekThroughBitcasts(SubOp.getOperand(0)));
                }
                let mut InnerVT: EVT = SubOps[0].getValueType();
                let mut InnerSizeInBits: u32 = InnerVT.getScalarSizeInBits();
                if !IsSplat && InnerVT.isSimple() && InnerVT.isVector() && (Subtarget.hasBWI() || (EltSizeInBits >= 32 && InnerSizeInBits >= 32)) && ((VT.is256BitVector() && Subtarget.hasVLX()) || (VT.is512BitVector() && Subtarget.useAVX512Regs())) && all_of(SubOps, Closure_256 { cap_0: InnerVT }) {
                    let mut ConcatSVT: MVT = InnerVT.getScalarType().getSimpleVT();
                    let mut ConcatVT: MVT = getVectorVT(ConcatSVT, VT.getSizeInBits().operator unsigned long long() / ConcatSVT.getSizeInBits().operator unsigned long long());
                    if combineConcatVectorOps(DL, ConcatVT, SubOps, DAG, Subtarget, Depth + 1) {
                        ConcatSrc;
                    } else {
                        return DAG.getBitcast(VT, ConcatSrc);
                    }
                }
                break;
            },
            SCALAR_TO_VECTOR => {
                if !IsSplat && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.useAVX512Regs())) && all_of(Ops, Closure_257 { cap_0: Op0 }) {
                    let mut Subs: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
                    for SubOp in Ops {
                        Subs.push(SubOp.getOperand(0).getOperand(0));
                    }
                    if combineConcatVectorOps(DL, VT, Subs, DAG, Subtarget, Depth + 1) {
                        R;
                    } else {
                        return R;
                    }
                }
                break;
            },
            VECTOR_SHUFFLE => {
                if !IsSplat && NumOps == 2 && ((VT.is256BitVector() && (EltSizeInBits >= 32 || Subtarget.hasInt256())) || (VT.is512BitVector() && Subtarget.useAVX512Regs() && (EltSizeInBits >= 32 || Subtarget.useBWIRegs()))) {
                    let mut Concat0: SDValue = CombineSubOperand.call(VT, Ops, 0);
                    let mut Concat1: SDValue = CombineSubOperand.call(VT, Ops, 1);
                    if Concat0 || Concat1 || (Ops[0].getOperand(0) == Ops[1].getOperand(0) && Ops[0].getOperand(1) == Ops[1].getOperand(1) && Subtarget.hasVBMI()) {
                        let mut NumSubElts: i32 = Op0.getValueType().getVectorNumElements();
                        let mut NewMask: SmallVector<int> = SmallVector<int> {};
                        for M in cast(Ops[0]).getMask() {
                            M = if M >= NumSubElts { M + NumSubElts } else { M };
                            NewMask.push(M);
                        }
                        for M in cast(Ops[1]).getMask() {
                            if 0 <= M {
                                M = (if M >= NumSubElts { M + NumSubElts } else { M }) + NumSubElts;
                            }
                            NewMask.push(M);
                        }
                        Concat0 = if Concat0 { Concat0 } else { ConcatSubOperand.call(VT, Ops, 0) };
                        Concat1 = if Concat1 { Concat1 } else { ConcatSubOperand.call(VT, Ops, 1) };
                        return DAG.getVectorShuffle(VT, DL, Concat0, Concat1, NewMask);
                    }
                }
                if !IsSplat && NumOps == 4 && VT.is512BitVector() && Subtarget.useAVX512Regs() && (EltSizeInBits >= 32 || Subtarget.useBWIRegs()) {
                    let mut HalfVT: MVT = VT.getHalfNumVectorElementsVT();
                    let mut Concat0: SDValue = combineConcatVectorOps(DL, HalfVT, Ops.slice(0, 2), DAG, Subtarget, Depth + 1);
                    let mut Concat1: SDValue = combineConcatVectorOps(DL, HalfVT, Ops.slice(2, 2), DAG, Subtarget, Depth + 1);
                    if Concat0 || Concat1 {
                        Concat0 = if Concat0 { Concat0 } else { DAG.getNode(CONCAT_VECTORS, DL, HalfVT, Ops.slice(0, 2)) };
                        Concat1 = if Concat1 { Concat1 } else { DAG.getNode(CONCAT_VECTORS, DL, HalfVT, Ops.slice(2, 2)) };
                        return DAG.getNode(CONCAT_VECTORS, DL, VT, Concat0, Concat1);
                    }
                }
                break;
            },
            VBROADCAST => {
                if !IsSplat && all_of(Ops, Closure_258 {}) {
                    if VT == v4f64 || VT == v4i64 {
                        return DAG.getNode(UNPCKL, DL, VT, ConcatSubOperand.call(VT, Ops, 0), ConcatSubOperand.call(VT, Ops, 0));
                    }
                    if VT == v8f32 || (VT == v8i32 && Subtarget.hasInt256()) {
                        return DAG.getNode(if VT == v8f32 { VPERMILPI } else { PSHUFD }, DL, VT, ConcatSubOperand.call(VT, Ops, 0), getV4X86ShuffleImm8ForMask([0, 0, 0, 0], DL, DAG));
                    }
                }
                break;
            },
            MOVDDUP => {
                MOVSHDUP;
            },
            SHUFP => {
                if !IsSplat && (VT == v8f32 || (VT == v16f32 && Subtarget.useAVX512Regs())) && all_of(Ops, Closure_259 { cap_0: Op0 }) {
                    let mut Concat0: SDValue = CombineSubOperand.call(VT, Ops, 0);
                    let mut Concat1: SDValue = CombineSubOperand.call(VT, Ops, 1);
                    if Concat0 || Concat1 {
                        return DAG.getNode(Opcode, DL, VT, if Concat0 { Concat0 } else { ConcatSubOperand.call(VT, Ops, 0) }, if Concat1 { Concat1 } else { ConcatSubOperand.call(VT, Ops, 1) }, Op0.getOperand(2));
                    }
                }
                break;
            },
            UNPCKH => {
                UNPCKL;
            },
            PSHUFHW => {
                PSHUFLW;
            },
            VPERMILPI => {
                if !IsSplat && EltSizeInBits == 32 && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.useAVX512Regs())) && all_of(Ops, Closure_260 { Op0: &mut Op0 }) {
                    let mut FloatVT: MVT = VT.changeVectorElementType(f32);
                    let mut Res: SDValue = DAG.getBitcast(FloatVT, ConcatSubOperand.call(VT, Ops, 0));
                    Res = DAG.getNode(VPERMILPI, DL, FloatVT, Res, Op0.getOperand(1));
                    return DAG.getBitcast(VT, Res);
                }
            },
            VPERMILPV => {
                if !IsSplat && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.useAVX512Regs())) {
                    let mut IntVT: MVT = VT.changeVectorElementTypeToInteger();
                    let mut Concat0: SDValue = CombineSubOperand.call(VT, Ops, 0);
                    let mut Concat1: SDValue = CombineSubOperand.call(IntVT, Ops, 1);
                    if Concat0 || Concat1 {
                        return DAG.getNode(Opcode, DL, VT, if Concat0 { Concat0 } else { ConcatSubOperand.call(VT, Ops, 0) }, if Concat1 { Concat1 } else { ConcatSubOperand.call(IntVT, Ops, 1) });
                    }
                }
            },
            PSHUFB => {
                PSADBW;
            },
            VPERMV => {
                if !IsSplat && NumOps == 2 && (VT.is512BitVector() && Subtarget.useAVX512Regs()) {
                    let mut OpVT: MVT = Op0.getSimpleValueType();
                    let mut NumSrcElts: i32 = OpVT.getVectorNumElements();
                    let mut ConcatMask: SmallVector<int, 64> = SmallVector<int, 64> {};
                    for let mut i: u32 = 0; i != NumOps; i += 1 {
                        let mut SubMask: SmallVector<int, 64> = SmallVector<int, 64> {};
                        let mut SubOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
                        if !getTargetShuffleMask(Ops[i], false, SubOps, SubMask) {
                            break;
                        }
                        for M in SubMask {
                            if 0 <= M {
                                M += i * NumSrcElts;
                            }
                            ConcatMask.push(M);
                        }
                    }
                    if ConcatMask.len == (NumOps * NumSrcElts) {
                        return lowerShuffleWithPERMV(DL, VT, ConcatMask, ConcatSubOperand.call(VT, Ops, 1), DAG.getUNDEF(VT), Subtarget, DAG);
                    }
                }
            },
            VPERMV3 => {
                if !IsSplat && NumOps == 2 && (VT.is512BitVector() && Subtarget.useAVX512Regs()) {
                    let mut OpVT: MVT = Op0.getSimpleValueType();
                    let mut NumSrcElts: i32 = OpVT.getVectorNumElements();
                    let mut ConcatMask: SmallVector<int, 64> = SmallVector<int, 64> {};
                    for let mut i: u32 = 0; i != NumOps; i += 1 {
                        let mut SubMask: SmallVector<int, 64> = SmallVector<int, 64> {};
                        let mut SubOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
                        if !getTargetShuffleMask(Ops[i], false, SubOps, SubMask) {
                            break;
                        }
                        for M in SubMask {
                            if 0 <= M {
                                let mut Src: i32 = if M < NumSrcElts { 0 } else { 2 };
                                M += if M < NumSrcElts { 0 } else { NumSrcElts };
                                if Ops[0].getOperand(Src) != Ops[i].getOperand(Src) {
                                    M += i * NumSrcElts;
                                }
                            }
                            ConcatMask.push(M);
                        }
                    }
                    if ConcatMask.len == (NumOps * NumSrcElts) {
                        let mut Concat0: SDValue = CombineSubOperand.call(VT, Ops, 0);
                        let mut Concat1: SDValue = CombineSubOperand.call(VT, Ops, 2);
                        if Concat0 || Concat1 {
                            return lowerShuffleWithPERMV(DL, VT, ConcatMask, if Concat0 { Concat0 } else { ConcatSubOperand.call(VT, Ops, 0) }, if Concat1 { Concat1 } else { ConcatSubOperand.call(VT, Ops, 2) }, Subtarget, DAG);
                        }
                    }
                }
            },
            VPERM2X128 => {
                if !IsSplat && VT.is512BitVector() && Subtarget.useAVX512Regs() {
                    assert!(NumOps == 2, "Bad concat_vectors operands");
                    let mut Imm0: u32 = Ops[0].getConstantOperandVal(2);
                    let mut Imm1: u32 = Ops[1].getConstantOperandVal(2);
                    if (Imm0 & 136) == 0 && (Imm1 & 136) == 0 {
                        let mut Mask: [4]i32 = [(Imm0 & 3) as i32, ((Imm0 >> 4) & 3) as i32, (Imm1 & 3) as i32, ((Imm1 >> 4) & 3) as i32];
                        let mut ShuffleVT: MVT = if VT.isFloatingPoint() { v8f64 } else { v8i64 };
                        let mut LHS: SDValue = concatSubVectors(Ops[0].getOperand(0), Ops[0].getOperand(1), DAG, DL);
                        let mut RHS: SDValue = concatSubVectors(Ops[1].getOperand(0), Ops[1].getOperand(1), DAG, DL);
                        let mut Res: SDValue = DAG.getNode(SHUF128, DL, ShuffleVT, DAG.getBitcast(ShuffleVT, LHS), DAG.getBitcast(ShuffleVT, RHS), getV4X86ShuffleImm8ForMask(Mask, DL, DAG));
                        return DAG.getBitcast(VT, Res);
                    }
                }
                break;
            },
            SHUF128 => {
                if !IsSplat && NumOps == 2 && VT.is512BitVector() {
                    let mut Imm0: u32 = Ops[0].getConstantOperandVal(2);
                    let mut Imm1: u32 = Ops[1].getConstantOperandVal(2);
                    let mut Imm: u32 = ((Imm0 & 1) << 0) | ((Imm0 & 2) << 1) | 8 | ((Imm1 & 1) << 4) | ((Imm1 & 2) << 5) | 128;
                    let mut LHS: SDValue = concatSubVectors(Ops[0].getOperand(0), Ops[0].getOperand(1), DAG, DL);
                    let mut RHS: SDValue = concatSubVectors(Ops[1].getOperand(0), Ops[1].getOperand(1), DAG, DL);
                    return DAG.getNode(SHUF128, DL, VT, LHS, RHS, DAG.getTargetConstant(Imm, DL, i8, false));
                }
                break;
            },
            TRUNCATE => {
                if !IsSplat && NumOps == 2 && VT.is256BitVector() {
                    let mut SrcVT: EVT = Ops[0].getOperand(0).getValueType();
                    if SrcVT.is256BitVector() && SrcVT.isSimple() && SrcVT == Ops[1].getOperand(0).getValueType() && Subtarget.useAVX512Regs() && Subtarget.getPreferVectorWidth() >= 512 && (SrcVT.getScalarSizeInBits() > 16 || Subtarget.useBWIRegs()) {
                        let mut NewSrcVT: EVT = SrcVT.getDoubleNumVectorElementsVT(Ctx);
                        return DAG.getNode(TRUNCATE, DL, VT, ConcatSubOperand.call(NewSrcVT, Ops, 0));
                    }
                }
            },
            VTRUNCS => {
                VTRUNCUS;
            },
            ANY_EXTEND => {
                SIGN_EXTEND;
            },
            ANY_EXTEND_VECTOR_INREG => {
                SIGN_EXTEND_VECTOR_INREG;
            },
            VSHLI => {
                VSRLI;
            },
            VSRAI => {
                VSHL;
            },
            VSHLDQ => {
                VSRLDQ;
            },
            VROTLI => {
                VROTRI;
            },
            ROTL => {
                ROTR;
            },
            VPERMI => {
                if !IsSplat && NumOps == 2 && (VT.is512BitVector() && Subtarget.useAVX512Regs()) {
                    if Ops[0].getOperand(1) == Ops[1].getOperand(1) {
                        return DAG.getNode(Opcode, DL, VT, ConcatSubOperand.call(VT, Ops, 0), Op0.getOperand(1));
                    }
                    let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> {};
                    let mut HiMask: SmallVector<int, 8> = SmallVector<int, 8> {};
                    let mut NumElts: u32 = VT.getVectorNumElements();
                    DecodeVPERMMask(NumElts / 2, Ops[0].getConstantOperandVal(1), Mask);
                    DecodeVPERMMask(NumElts / 2, Ops[1].getConstantOperandVal(1), HiMask);
                    for M in HiMask {
                        Mask.push(NumElts + M);
                    }
                    return lowerShuffleWithPERMV(DL, VT, Mask, widenSubVector(VT, Ops[0].getOperand(0), false, Subtarget, DAG, DL), widenSubVector(VT, Ops[1].getOperand(0), false, Subtarget, DAG, DL), Subtarget, DAG);
                }
            },
            AND => {
                OR;
            },
            PCMPEQ => {
                PCMPGT;
            },
            SETCC => {
                CMPM;
            },
            CTPOP => {
                CTTZ;
            },
            GF2P8MULB => {
                if !IsSplat && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.useAVX512Regs())) {
                    let mut LHS: SDValue = CombineSubOperand.call(VT, Ops, 0);
                    let mut RHS: SDValue = CombineSubOperand.call(VT, Ops, 1);
                    if LHS || RHS {
                        return DAG.getNode(Opcode, DL, VT, if LHS { LHS } else { ConcatSubOperand.call(VT, Ops, 0) }, if RHS { RHS } else { ConcatSubOperand.call(VT, Ops, 1) });
                    }
                }
            },
            GF2P8AFFINEQB => {
                if !IsSplat && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.useAVX512Regs())) && all_of(Ops, Closure_261 { cap_0: Op0 }) {
                    return DAG.getNode(Opcode, DL, VT, ConcatSubOperand.call(VT, Ops, 0), ConcatSubOperand.call(VT, Ops, 1), Op0.getOperand(2));
                }
            },
            PCLMULQDQ => {
                if !IsSplat && Subtarget.hasVPCLMULQDQ() && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.useAVX512Regs())) && all_of(Ops, Closure_262 { cap_0: Op0 }) {
                    let mut LHS: SDValue = CombineSubOperand.call(VT, Ops, 0);
                    let mut RHS: SDValue = CombineSubOperand.call(VT, Ops, 1);
                    if LHS || RHS {
                        return DAG.getNode(Opcode, DL, VT, if LHS { LHS } else { ConcatSubOperand.call(VT, Ops, 0) }, if RHS { RHS } else { ConcatSubOperand.call(VT, Ops, 1) }, Op0.getOperand(2));
                    }
                }
            },
            ADD => {
                SUB;
            },
            SHL => {
                SRL;
            },
            FADD => {
                FSUB;
            },
            FDIV => {
                if !IsSplat && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.useAVX512Regs())) {
                    return DAG.getNode(Opcode, DL, VT, ConcatSubOperand.call(VT, Ops, 0), ConcatSubOperand.call(VT, Ops, 1));
                }
            },
            FMA => {
                FMSUB;
            },
            FNEG => {
                FSQRT;
            },
            FRCP => {
                FRSQRT;
            },
            VRNDSCALE => {
                if !IsSplat && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.useAVX512Regs())) && all_of(Ops, Closure_263 { cap_0: Op0 }) {
                    return DAG.getNode(Opcode, DL, VT, ConcatSubOperand.call(VT, Ops, 0), Op0.getOperand(1));
                }
            },
            SINT_TO_FP => {
                CVTP2SI;
            },
            CVTNEPS2BF16 => {
                if NumOps == 2 && (VT.is256BitVector() || VT.is512BitVector()) && all_of(Ops, Closure_264 { cap_0: VT }) {
                    return DAG.getNode(VFPROUND2, DL, VT, Ops[1].getOperand(0), Ops[0].getOperand(0));
                }
            },
            HADD => {
                HSUB;
            },
            PACKSS => {
                PACKUS;
            },
            VSHLD => {
                VSHRD;
            },
            BLENDI => {
                if VT.is256BitVector() && NumOps == 2 && (EltSizeInBits >= 32 || (Subtarget.hasInt256() && Ops[0].getOperand(2) == Ops[1].getOperand(2))) {
                    let mut Concat0: SDValue = CombineSubOperand.call(VT, Ops, 0);
                    let mut Concat1: SDValue = CombineSubOperand.call(VT, Ops, 1);
                    if Concat0 || Concat1 {
                        let mut NumElts: u32 = VT.getVectorNumElements();
                        let mut Mask: APInt = getBLENDIBlendMask(Ops[0]).zext(NumElts);
                        Mask.insertBits(getBLENDIBlendMask(Ops[1]), NumElts / 2);
                        Mask = Mask.zextOrTrunc(8);
                        return DAG.getNode(Opcode, DL, VT, if Concat0 { Concat0 } else { ConcatSubOperand.call(VT, Ops, 0) }, if Concat1 { Concat1 } else { ConcatSubOperand.call(VT, Ops, 1) }, DAG.getTargetConstant(Mask, DL, i8, false));
                    }
                }
            },
            VSELECT => {
                if !IsSplat && Subtarget.hasAVX512() && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.useAVX512Regs())) && (EltSizeInBits >= 32 || Subtarget.hasBWI()) {
                    let mut SelVT: EVT = Ops[0].getOperand(0).getValueType();
                    if SelVT.getVectorElementType() == i1 {
                        SelVT = getVectorVT(Ctx, i1, NumOps * SelVT.getVectorNumElements(), false);
                        if TLI.isTypeLegal(SelVT) {
                            return DAG.getNode(Opcode, DL, VT, ConcatSubOperand.call(SelVT.getSimpleVT(), Ops, 0), ConcatSubOperand.call(VT, Ops, 1), ConcatSubOperand.call(VT, Ops, 2));
                        }
                    }
                }
            },
            BLENDV => {
                if !IsSplat && VT.is256BitVector() && NumOps == 2 && (EltSizeInBits >= 32 || Subtarget.hasInt256()) && IsConcatFree.call(VT, Ops, 1) && IsConcatFree.call(VT, Ops, 2) {
                    let mut SelVT: EVT = Ops[0].getOperand(0).getValueType();
                    SelVT = SelVT.getDoubleNumVectorElementsVT(Ctx);
                    if TLI.isTypeLegal(SelVT) {
                        return DAG.getNode(Opcode, DL, VT, ConcatSubOperand.call(SelVT.getSimpleVT(), Ops, 0), ConcatSubOperand.call(VT, Ops, 1), ConcatSubOperand.call(VT, Ops, 2));
                    }
                }
            },
        }
    }
    if dyn_cast(peekThroughBitcasts(Op0)) {
        FirstLd;
    } else {
        let mut Fast: u32 = 0;
        let mut TLI: *X86TargetLowering = Subtarget.getTargetLowering();
        if TLI.allowsMemoryAccess(Ctx, DAG.getDataLayout(), VT, *FirstLd.getMemOperand(), &mut Fast) && Fast {
            if EltsFromConsecutiveLoads(VT, Ops, DL, DAG, Subtarget, false, Depth + 1) {
                Ld;
            } else {
                return Ld;
            }
        }
    }
    if all_of(Ops, Closure_265 {}) {
        let mut EltBits: SmallVector<APInt> = SmallVector<APInt> {};
        let mut UndefElts: APInt = getZero(VT.getVectorNumElements());
        for let mut I: u32 = 0; I != NumOps; I += 1 {
            let mut OpUndefElts: APInt = APInt {};
            let mut OpEltBits: SmallVector<APInt> = SmallVector<APInt> {};
            if !getTargetConstantBitsFromNode(Ops[I], EltSizeInBits, OpUndefElts, OpEltBits, true, false) {
                break;
            }
            EltBits.append(OpEltBits);
            UndefElts.insertBits(OpUndefElts, I * OpUndefElts.getBitWidth());
        }
        if EltBits.len == VT.getVectorNumElements() {
            let mut C: *mut Constant = getConstantVector(VT, EltBits, UndefElts, Ctx);
            let mut PVT: MVT = TLI.getPointerTy(DAG.getDataLayout(), 0);
            let mut CV: SDValue = DAG.getConstantPool(C, PVT, nullopt, 0, false, 0);
            let mut MF: *mut MachineFunction = DAG.getMachineFunction();
            let mut MPI: MachinePointerInfo = getConstantPool(MF);
            let mut Ld: SDValue = DAG.getLoad(VT, DL, DAG.getEntryNode(), CV, MPI, MaybeAlign {}, MONone, MMOMetadata {});
            let mut Sub: SDValue = extractSubVector(Ld, 0, DAG, DL, Op0.getValueSizeInBits().operator unsigned long long());
            DAG.ReplaceAllUsesOfValueWith(Op0, Sub);
            return Ld;
        }
    }
    if IsSplat && (VT.is256BitVector() || (VT.is512BitVector() && Subtarget.hasAVX512())) {
        if isNormalLoad(Op0.getNode()) || Op0.getOpcode() == VBROADCAST_LOAD || Op0.getOpcode() == SUBV_BROADCAST_LOAD {
            let mut Mem: *mut MemSDNode = cast(Op0);
            let mut Opc: u32 = if Op0.getOpcode() == VBROADCAST_LOAD { VBROADCAST_LOAD } else { SUBV_BROADCAST_LOAD };
            if getBROADCAST_LOAD(Opc, DL, VT, Mem.getMemoryVT(), Mem, 0, DAG) {
                BcastLd;
            } else {
                let mut BcastSrc: SDValue = extractSubVector(BcastLd, 0, DAG, DL, Op0.getValueSizeInBits().operator unsigned long long());
                DAG.ReplaceAllUsesOfValueWith(Op0, BcastSrc);
                return BcastLd;
            }
        }
    }
    if IsSplat && NumOps == 4 && VT.is512BitVector() && Subtarget.useAVX512Regs() {
        let mut ShuffleVT: MVT = if VT.isFloatingPoint() { v8f64 } else { v8i64 };
        let mut Res: SDValue = widenSubVector(Op0, false, Subtarget, DAG, DL, 512);
        Res = DAG.getBitcast(ShuffleVT, Res);
        Res = DAG.getNode(SHUF128, DL, ShuffleVT, Res, Res, getV4X86ShuffleImm8ForMask([0, 0, 0, 0], DL, DAG));
        return DAG.getBitcast(VT, Res);
    }
    if !IsSplat && ((NumOps == 2 && VT == v4f64) || (NumOps == 4 && VT == v8f64 && Subtarget.useAVX512Regs())) && all_of(Ops, Closure_266 {}) {
        let mut OpVT: MVT = Ops[0].getSimpleValueType();
        let mut NumOpElts: u32 = OpVT.getVectorNumElements();
        let mut SrcOps: SmallVector<SmallVector<SDValue, 2>, 4> = NumOps;
        let mut SrcMasks: SmallVector<SmallVector<int, 8>, 4> = NumOps;
        if all_of(seq(NumOps), Closure_267 { Ops: &mut Ops, SrcOps: &mut SrcOps, SrcMasks: &mut SrcMasks, DAG: &mut DAG, Depth: &mut Depth, OpVT: &mut OpVT, NumOpElts: &mut NumOpElts }) {
            let mut Unary: bool = true;
            let mut SHUFPDMask: u32 = 0;
            let mut LHS: SmallVector<SDValue, 4> = NumOps;
            let mut RHS: SmallVector<SDValue, 4> = NumOps;
            for let mut I: u32 = 0; I != NumOps; I += 1 {
                LHS[I] = SrcOps[I][SrcMasks[I][0] / NumOpElts];
                RHS[I] = SrcOps[I][SrcMasks[I][1] / NumOpElts];
                Unary &= LHS[I] == RHS[I];
                for let mut J: u32 = 0; J != NumOpElts; J += 1 {
                    SHUFPDMask |= (SrcMasks[I][J] & 1) << ((I * NumOpElts) + J);
                }
            }
            let mut Concat0: SDValue = combineConcatVectorOps(DL, VT, LHS, DAG, Subtarget, Depth + 1);
            let mut Concat1: SDValue = combineConcatVectorOps(DL, VT, RHS, DAG, Subtarget, Depth + 1);
            if Unary || Concat0 || Concat1 {
                Concat0 = if Concat0 { Concat0 } else { DAG.getNode(CONCAT_VECTORS, DL, VT, LHS) };
                Concat1 = if Concat1 { Concat1 } else { DAG.getNode(CONCAT_VECTORS, DL, VT, RHS) };
                return DAG.getNode(SHUFP, DL, VT, Concat0, Concat1, DAG.getTargetConstant(SHUFPDMask, DL, i8, false));
            }
        }
    }
    return SDValue {};
}

fn combineCONCAT_VECTORS(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = N.getOperand(0).getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Ops: SmallVector<SDValue, 4> = N.ops();
    if VT.getVectorElementType() == i1 {
        let mut SubSizeInBits: u32 = SrcVT.getSizeInBits().operator unsigned long long();
        let mut Constant: APInt = getZero(VT.getSizeInBits().operator unsigned long long());
        for let mut I: u32 = 0;
let mut E: u32 = Ops.len; I != E; I += 1 {
            let mut C: *mut ConstantSDNode = dyn_cast(peekThroughBitcasts(Ops[I]));
            if !C {
                break;
            }
            Constant.insertBits(C.getAPIntValue(), I * SubSizeInBits);
            if I == (E - 1) {
                let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), VT.getSizeInBits().operator unsigned long long());
                if TLI.isTypeLegal(IntVT) {
                    return DAG.getBitcast(VT, DAG.getConstant(Constant, N, IntVT, false, false));
                }
            }
        }
        if TLI.isTypeLegal(VT) && (all_of(Ops, Closure_269 {}) || all_of(Ops, Closure_270 {}) || all_of(Ops, Closure_271 {})) {
            if combineConcatVectorOps(N, VT.getSimpleVT(), Ops, DAG, Subtarget, 0) {
                R;
            } else {
                return R;
            }
        }
        return SDValue {};
    }
    if Subtarget.hasAVX() && TLI.isTypeLegal(VT) && TLI.isTypeLegal(SrcVT) {
        if combineConcatVectorOps(N, VT.getSimpleVT(), Ops, DAG, Subtarget, 0) {
            R;
        } else {
            return R;
        }
    }
    return SDValue {};
}

fn combineINSERT_SUBVECTOR(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut OpVT: MVT = N.getSimpleValueType(0);
    let mut IsI1Vector: bool = OpVT.getVectorElementType() == i1;
    let mut dl: SDLoc = N;
    let mut Vec: SDValue = N.getOperand(0);
    let mut SubVec: SDValue = N.getOperand(1);
    let mut IdxVal: u64 = N.getConstantOperandVal(2);
    let mut SubVecVT: MVT = SubVec.getSimpleValueType();
    let mut VecNumElts: i32 = OpVT.getVectorNumElements();
    let mut SubVecNumElts: i32 = SubVecVT.getVectorNumElements();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if Vec.isUndef() && SubVec.isUndef() {
        return DAG.getUNDEF(OpVT);
    }
    if (Vec.isUndef() || isBuildVectorAllZeros(Vec.getNode())) && (SubVec.isUndef() || isBuildVectorAllZeros(SubVec.getNode())) {
        return getZeroVector(OpVT, Subtarget, DAG, dl);
    }
    if isBuildVectorAllZeros(Vec.getNode()) {
        if SubVec.getOpcode() == INSERT_SUBVECTOR && isBuildVectorAllZeros(SubVec.getOperand(0).getNode()) {
            let mut Idx2Val: u64 = SubVec.getConstantOperandVal(2);
            return DAG.getNode(INSERT_SUBVECTOR, dl, OpVT, getZeroVector(OpVT, Subtarget, DAG, dl), SubVec.getOperand(1), DAG.getVectorIdxConstant(IdxVal + Idx2Val, dl, false));
        }
        if SubVec.getOpcode() == EXTRACT_SUBVECTOR && IdxVal == 0 && isNullConstant(SubVec.getOperand(1)) && SubVec.getOperand(0).getOpcode() == INSERT_SUBVECTOR {
            let mut Ins: SDValue = SubVec.getOperand(0);
            if isNullConstant(Ins.getOperand(2)) && isBuildVectorAllZeros(Ins.getOperand(0).getNode()) && Ins.getOperand(1).getValueSizeInBits().getFixedValue() <= SubVecVT.getFixedSizeInBits() {
                return DAG.getNode(INSERT_SUBVECTOR, dl, OpVT, getZeroVector(OpVT, Subtarget, DAG, dl), Ins.getOperand(1), N.getOperand(2));
            }
        }
        if IsI1Vector && TLI.isTypeLegal(OpVT) && SubVec.hasOneUse() {
            let mut SubInt: SDValue = peekThroughOneUseBitcasts(SubVec);
            let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), VecNumElts);
            if TLI.isTypeLegal(IntVT) && SubInt.getValueType().isScalarInteger() {
                SubInt = DAG.getNode(ZERO_EXTEND, dl, IntVT, SubInt);
                SubInt = DAG.getNode(SHL, dl, IntVT, SubInt, DAG.getShiftAmountConstant(IdxVal, IntVT, dl));
                return DAG.getBitcast(OpVT, SubInt);
            }
        }
    }
    if IsI1Vector {
        return SDValue {};
    }
    if SubVec.getOpcode() == INSERT_SUBVECTOR && SubVec.getOperand(0).isUndef() && isNullConstant(SubVec.getOperand(2)) {
        return DAG.getNode(INSERT_SUBVECTOR, dl, OpVT, Vec, SubVec.getOperand(1), N.getOperand(2));
    }
    if SubVec.getOpcode() == EXTRACT_SUBVECTOR && SubVec.getOperand(0).getSimpleValueType() == OpVT && (IdxVal != 0 || !(Vec.isUndef() || isBuildVectorAllZeros(Vec.getNode()))) {
        let mut ExtSrc: SDValue = SubVec.getOperand(0);
        let mut ExtIdxVal: i32 = SubVec.getConstantOperandVal(1);
        let mut Mask: SmallVector<int, 64> = VecNumElts;
        iota(Mask.begin(), Mask.end(), 0);
        iota(Mask.begin() + IdxVal, Mask.begin() + IdxVal + SubVecNumElts, ExtIdxVal + VecNumElts);
        if ExtIdxVal != 0 {
            return DAG.getVectorShuffle(OpVT, dl, Vec, ExtSrc, Mask);
        }
        let mut BlendMask: SmallVector<int, 64> = VecNumElts;
        iota(BlendMask.begin(), BlendMask.end(), 0);
        iota(BlendMask.begin() + IdxVal, BlendMask.begin() + IdxVal + SubVecNumElts, VecNumElts + IdxVal);
        if isShuffleEquivalent(Mask, BlendMask, Vec, ExtSrc) && VecNumElts == (2 * SubVecNumElts) {
            assert!((IdxVal % SubVecNumElts) == 0, "Unaligned subvector insertion");
            if OpVT.is256BitVector() && SubVecVT.is128BitVector() {
                let mut Blend: SDValue = DAG.getNode(BLENDI, dl, v8f32, DAG.getBitcast(v8f32, Vec), DAG.getBitcast(v8f32, ExtSrc), DAG.getTargetConstant(if IdxVal == 0 { 15 } else { 240 }, dl, i8, false));
                return DAG.getBitcast(OpVT, Blend);
            } else if OpVT.is512BitVector() && SubVecVT.is256BitVector() {
                let mut ShufVT: MVT = if OpVT.isInteger() { v8i64 } else { v8f64 };
                let mut Lo: SDValue = DAG.getBitcast(ShufVT, if IdxVal == 0 { ExtSrc } else { Vec });
                let mut Hi: SDValue = DAG.getBitcast(ShufVT, if IdxVal == 0 { Vec } else { ExtSrc });
                let mut Shuffle: SDValue = DAG.getNode(SHUF128, dl, ShufVT, Lo, Hi, getV4X86ShuffleImm8ForMask([0, 1, 2, 3], dl, DAG));
                return DAG.getBitcast(OpVT, Shuffle);
            }
        }
    }
    let mut SubVectorOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    if collectConcatOps(N, SubVectorOps, DAG) {
        if combineConcatVectorOps(dl, OpVT, SubVectorOps, DAG, Subtarget, 0) {
            Fold;
        } else {
            return Fold;
        }
        if SubVectorOps.len == 2 && isBuildVectorAllZeros(SubVectorOps[1].getNode()) {
            return DAG.getNode(INSERT_SUBVECTOR, dl, OpVT, getZeroVector(OpVT, Subtarget, DAG, dl), SubVectorOps[0], DAG.getVectorIdxConstant(0, dl, false));
        }
        if all_of(SubVectorOps, isFoldableAsShuffle) {
            let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
            if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
                Res;
            } else {
                return Res;
            }
        }
    }
    if Vec.isUndef() && IdxVal != 0 && SubVec.getOpcode() == VBROADCAST {
        return DAG.getNode(VBROADCAST, dl, OpVT, SubVec.getOperand(0));
    }
    if Vec.isUndef() && IdxVal != 0 && SubVec.hasOneUse() && SubVec.getOpcode() == VBROADCAST_LOAD {
        let mut MemIntr: *mut MemIntrinsicSDNode = cast(SubVec);
        return getBROADCAST_LOAD(VBROADCAST_LOAD, dl, OpVT, MemIntr.getMemoryVT(), MemIntr, 0, DAG);
    }
    if IdxVal as i32 == (VecNumElts / 2) && Vec.getValueSizeInBits() == (2 * SubVec.getValueSizeInBits()) {
        let mut VecLd: *mut LoadSDNode = dyn_cast(Vec);
        let mut SubLd: *mut LoadSDNode = dyn_cast(SubVec);
        if VecLd && SubLd && DAG.areNonVolatileConsecutiveLoads(SubLd, VecLd, SubVec.getValueSizeInBits().operator unsigned long long() / 8, 0) {
            let mut BcastLd: SDValue = getBROADCAST_LOAD(SUBV_BROADCAST_LOAD, dl, OpVT, SubVecVT, SubLd, 0, DAG);
            let mut NewSubVec: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, dl, SubVecVT, BcastLd, DAG.getVectorIdxConstant(0, dl, false));
            DCI.CombineTo(SubLd, NewSubVec, BcastLd.getValue(1), true);
            return BcastLd;
        }
    }
    if !Vec.isUndef() && !isBuildVectorAllZeros(Vec.getNode()) {
        let mut EltSizeInBits: u32 = OpVT.getScalarSizeInBits();
        let mut VecUndefElts: APInt = APInt {};
        let mut SubUndefElts: APInt = APInt {};
        let mut VecEltBits: SmallVector<APInt, 16> = SmallVector<APInt, 16> {};
        let mut SubEltBits: SmallVector<APInt, 16> = SmallVector<APInt, 16> {};
        if getTargetConstantBitsFromNode(Vec, EltSizeInBits, VecUndefElts, VecEltBits, true, false) && getTargetConstantBitsFromNode(SubVec, EltSizeInBits, SubUndefElts, SubEltBits, true, false) {
            VecUndefElts.insertBits(SubUndefElts, IdxVal);
            copy(SubEltBits, VecEltBits.begin() + IdxVal);
            return getConstVector(VecEltBits, VecUndefElts, OpVT, DAG, dl);
        }
    }
    if isFoldableAsShuffle(Vec) && isFoldableAsShuffle(SubVec) {
        let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
        if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
            Res;
        } else {
            return Res;
        }
    }
    if (IdxVal % SubVecNumElts) == 0 && isNormalLoad(Vec.getNode()) && isNormalLoad(SubVec.getNode()) && DAG.areNonVolatileConsecutiveLoads(cast(SubVec), cast(Vec), SubVec.getValueSizeInBits().operator unsigned long long() / 8, IdxVal / SubVecNumElts) {
        return Vec;
    }
    return SDValue {};
}

fn narrowExtractedVectorSelect(Ext: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut Sel: SDValue = Ext.getOperand(0);
    if Sel.getOpcode() != VSELECT || !isFreeToSplitVector(Sel.getOperand(0), DAG) {
        return SDValue {};
    }
    let mut VT: MVT = Ext.getSimpleValueType(0);
    if !VT.is128BitVector() {
        return SDValue {};
    }
    let mut SelCondVT: MVT = Sel.getOperand(0).getSimpleValueType();
    if !SelCondVT.is256BitVector() && !SelCondVT.is512BitVector() {
        return SDValue {};
    }
    let mut WideVT: MVT = Ext.getOperand(0).getSimpleValueType();
    let mut SelVT: MVT = Sel.getSimpleValueType();
    assert!((SelVT.is256BitVector() || SelVT.is512BitVector()), "Unexpected vector type with legal operations");
    let mut SelElts: u32 = SelVT.getVectorNumElements();
    let mut CastedElts: u32 = WideVT.getVectorNumElements();
    let mut ExtIdx: u32 = Ext.getConstantOperandVal(1);
    if SelElts % CastedElts == 0 {
        ExtIdx *= (SelElts / CastedElts);
    } else if CastedElts % SelElts == 0 {
        let mut IndexDivisor: u32 = CastedElts / SelElts;
        if ExtIdx % IndexDivisor != 0 {
            return SDValue {};
        }
        ExtIdx /= IndexDivisor;
    } else {
        llvm_unreachable_internal("Element count of simple vector types are not divisible?", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 62702);
    }
    let mut NarrowingFactor: u32 = WideVT.getSizeInBits().operator unsigned long long() / VT.getSizeInBits().operator unsigned long long();
    let mut NarrowElts: u32 = SelElts / NarrowingFactor;
    let mut NarrowSelVT: MVT = getVectorVT(SelVT.getVectorElementType(), NarrowElts);
    let mut ExtCond: SDValue = extract128BitVector(Sel.getOperand(0), ExtIdx, DAG, DL);
    let mut ExtT: SDValue = extract128BitVector(Sel.getOperand(1), ExtIdx, DAG, DL);
    let mut ExtF: SDValue = extract128BitVector(Sel.getOperand(2), ExtIdx, DAG, DL);
    let mut NarrowSel: SDValue = DAG.getSelect(DL, NarrowSelVT, ExtCond, ExtT, ExtF, SDNodeFlags { Flags: None });
    return DAG.getBitcast(VT, NarrowSel);
}

fn combineEXTRACT_SUBVECTOR(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if !N.getValueType(0).isSimple() {
        return SDValue {};
    }
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut InVec: SDValue = N.getOperand(0);
    let mut IdxVal: u32 = N.getConstantOperandVal(1);
    let mut InVecVT: EVT = InVec.getValueType();
    let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut InSizeInBits: u32 = InVecVT.getSizeInBits().operator unsigned long long();
    let mut NumSubElts: u32 = VT.getVectorNumElements();
    let mut NumInElts: u32 = InVecVT.getVectorNumElements();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = N;
    if Subtarget.hasAVX() && !Subtarget.hasAVX2() && TLI.isTypeLegal(InVecVT) && InSizeInBits == 256 && InVec.getOpcode() == AND {
        let mut isConcatenatedNot: Closure_272 = Closure_272 {};
        if isConcatenatedNot.call(InVec.getOperand(0)) || isConcatenatedNot.call(InVec.getOperand(1)) {
            return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, splitVectorIntBinary(InVec, DAG, DL), N.getOperand(1));
        }
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if narrowExtractedVectorSelect(N, DL, DAG) {
        V;
    } else {
        return V;
    }
    if isBuildVectorAllZeros(InVec.getNode()) {
        return getZeroVector(VT, Subtarget, DAG, DL);
    }
    if isBuildVectorAllOnes(InVec.getNode()) {
        if VT.getScalarType() == i1 {
            return DAG.getConstant(1, DL, VT, false, false);
        }
        return getOnesVector(VT, DAG, DL);
    }
    if InVec.getOpcode() == BUILD_VECTOR {
        return DAG.getBuildVector(VT, DL, operator(InVec).ops().slice(IdxVal, NumSubElts));
    }
    if VT.getVectorElementType() != i1 && TLI.isTypeLegal(VT) && InVec.getOpcode() == INSERT_SUBVECTOR && InVec.hasOneUse() {
        let mut Src: SDValue = InVec.getOperand(0);
        let mut Sub: SDValue = InVec.getOperand(1);
        let mut SubVT: EVT = Sub.getValueType();
        let mut InsIdx: u64 = InVec.getConstantOperandVal(2);
        if IdxVal <= InsIdx && (IdxVal + NumSubElts) >= (InsIdx + SubVT.getVectorNumElements()) {
            let mut NewSrc: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Src, DAG.getVectorIdxConstant(IdxVal, DL, false));
            return DAG.getNode(INSERT_SUBVECTOR, DL, VT, NewSrc, Sub, DAG.getVectorIdxConstant(InsIdx - IdxVal, DL, false));
        }
    }
    if IdxVal != 0 {
        let mut AllEquiv: bool = all_of(seq(NumSubElts), Closure_273 { NumInElts: &mut NumInElts, InVec: &mut InVec, IdxVal: &mut IdxVal });
        if AllEquiv {
            return extractSubVector(InVec, 0, DAG, DL, SizeInBits);
        }
    }
    if InVec.getOpcode() == SUBV_BROADCAST_LOAD {
        let mut MemIntr: *mut MemIntrinsicSDNode = cast(InVec);
        let mut MemVT: EVT = MemIntr.getMemoryVT();
        if MemVT == VT {
            if InVec.hasOneUse() {
                let mut Ld: SDValue = DAG.getLoad(MemVT, DL, MemIntr.getChain(), MemIntr.getBasePtr(), MemIntr.getMemOperand());
                DAG.makeEquivalentMemoryOrdering(SDValue { Node: MemIntr, ResNo: 1 }, Ld.getValue(1));
                return Ld;
            }
        }
    }
    if (InSizeInBits % SizeInBits) == 0 && (IdxVal % NumSubElts) == 0 {
        let mut ShuffleMask: SmallVector<int, 32> = SmallVector<int, 32> {};
        let mut ScaledMask: SmallVector<int, 32> = SmallVector<int, 32> {};
        let mut ShuffleInputs: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
        let mut NumSubVecs: u32 = InSizeInBits / SizeInBits;
        if getTargetShuffleInputs(InVec, ShuffleInputs, ShuffleMask, DAG, 0, true) && scaleShuffleElements(ShuffleMask, NumSubVecs, ScaledMask) {
            let mut SubVecIdx: u32 = IdxVal / NumSubElts;
            if ScaledMask[SubVecIdx] == SM_SentinelUndef {
                return DAG.getUNDEF(VT);
            }
            if ScaledMask[SubVecIdx] == SM_SentinelZero {
                return getZeroVector(VT, Subtarget, DAG, DL);
            }
            let mut Src: SDValue = ShuffleInputs[ScaledMask[SubVecIdx] / NumSubVecs];
            if Src.getValueSizeInBits().operator unsigned long long() == InSizeInBits {
                let mut SrcSubVecIdx: u32 = ScaledMask[SubVecIdx] % NumSubVecs;
                let mut SrcEltIdx: u32 = SrcSubVecIdx * NumSubElts;
                return extractSubVector(DAG.getBitcast(InVecVT, Src), SrcEltIdx, DAG, DL, SizeInBits);
            }
        }
    }
    let mut IsExtractFree: Closure_274 = Closure_274 {};
    let mut InOpcode: u32 = InVec.getOpcode();
    if InVec.hasOneUse() {
        if IdxVal == 0 && VT == v2f64 && InVecVT == v4f64 {
            if InOpcode == SINT_TO_FP && InVec.getOperand(0).getValueType() == v4i32 {
                return DAG.getNode(CVTSI2P, DL, VT, InVec.getOperand(0));
            }
            if InOpcode == UINT_TO_FP && Subtarget.hasVLX() && InVec.getOperand(0).getValueType() == v4i32 {
                return DAG.getNode(CVTUI2P, DL, VT, InVec.getOperand(0));
            }
            if InOpcode == FP_EXTEND && InVec.getOperand(0).getValueType() == v4f32 {
                return DAG.getNode(VFPEXT, DL, VT, InVec.getOperand(0));
            }
        }
        if (InOpcode == FP_TO_SINT || InOpcode == SINT_TO_FP || ((InOpcode == FP_TO_UINT || InOpcode == UINT_TO_FP) && Subtarget.hasVLX())) && (VT == v4i32 || VT == v4f32) {
            let mut Src: SDValue = InVec.getOperand(0);
            if Src.getValueType().getScalarSizeInBits() == 32 {
                return DAG.getNode(InOpcode, DL, VT, extractSubVector(Src, IdxVal, DAG, DL, SizeInBits));
            }
        }
        if IdxVal == 0 && (isExtOpcode(InOpcode) || isExtVecInRegOpcode(InOpcode)) && (SizeInBits == 128 || SizeInBits == 256) && InVec.getOperand(0).getValueSizeInBits().operator unsigned long long() >= SizeInBits {
            let mut Ext: SDValue = InVec.getOperand(0);
            if Ext.getValueSizeInBits().operator unsigned long long() > SizeInBits {
                Ext = extractSubVector(Ext, 0, DAG, DL, SizeInBits);
            }
            let mut ExtOp: u32 = DAG.getOpcode_EXTEND_VECTOR_INREG(InOpcode);
            return DAG.getNode(ExtOp, DL, VT, Ext);
        }
        if IdxVal == 0 && InOpcode == VSELECT && InVec.getOperand(0).getValueType().is256BitVector() && InVec.getOperand(1).getValueType().is256BitVector() && InVec.getOperand(2).getValueType().is256BitVector() {
            let mut Ext0: SDValue = extractSubVector(InVec.getOperand(0), 0, DAG, DL, 128);
            let mut Ext1: SDValue = extractSubVector(InVec.getOperand(1), 0, DAG, DL, 128);
            let mut Ext2: SDValue = extractSubVector(InVec.getOperand(2), 0, DAG, DL, 128);
            return DAG.getNode(InOpcode, DL, VT, Ext0, Ext1, Ext2);
        }
        if IdxVal == 0 && InOpcode == TRUNCATE && Subtarget.hasVLX() && (SizeInBits == 128 || SizeInBits == 256) {
            let mut InVecSrc: SDValue = InVec.getOperand(0);
            let mut Scale: u32 = InVecSrc.getValueSizeInBits().operator unsigned long long() / InSizeInBits;
            let mut Ext: SDValue = extractSubVector(InVecSrc, 0, DAG, DL, Scale * SizeInBits);
            return DAG.getNode(InOpcode, DL, VT, Ext);
        }
        if SizeInBits == 128 || SizeInBits == 256 {
            match InOpcode {
                MOVDDUP => {
                    return DAG.getNode(InOpcode, DL, VT, extractSubVector(InVec.getOperand(0), IdxVal, DAG, DL, SizeInBits));
                },
                PSHUFD => {
                    VPERMILPI;
                },
                PCMPEQ => {
                    PCMPGT;
                },
                CMPP => {
                    if IsExtractFree.call(InVec.getOperand(0)) || IsExtractFree.call(InVec.getOperand(1)) {
                        return DAG.getNode(InOpcode, DL, VT, extractSubVector(InVec.getOperand(0), IdxVal, DAG, DL, SizeInBits), extractSubVector(InVec.getOperand(1), IdxVal, DAG, DL, SizeInBits), InVec.getOperand(2));
                    }
                },
                BLENDI => {
                    if IsExtractFree.call(InVec.getOperand(0)) || IsExtractFree.call(InVec.getOperand(1)) {
                        let mut M: u64 = InVec.getConstantOperandVal(2) & 255;
                        M = if VT.getScalarType() == i16 { M } else { (M >> IdxVal) };
                        return DAG.getNode(InOpcode, DL, VT, extractSubVector(InVec.getOperand(0), IdxVal, DAG, DL, SizeInBits), extractSubVector(InVec.getOperand(1), IdxVal, DAG, DL, SizeInBits), DAG.getTargetConstant(M, DL, i8, false));
                    }
                },
                VPERMV => {
                    if IdxVal != 0 {
                        let mut Mask: SDValue = InVec.getOperand(0);
                        let mut Src: SDValue = InVec.getOperand(1);
                        Mask = extractSubVector(Mask, IdxVal, DAG, DL, SizeInBits);
                        Mask = widenSubVector(Mask, false, Subtarget, DAG, DL, InSizeInBits);
                        let mut Shuffle: SDValue = DAG.getNode(InOpcode, DL, InVecVT, Mask, Src);
                        return extractSubVector(Shuffle, 0, DAG, DL, SizeInBits);
                    }
                },
                VPERMV3 => {
                    if IdxVal != 0 {
                        let mut Src0: SDValue = InVec.getOperand(0);
                        let mut Mask: SDValue = InVec.getOperand(1);
                        let mut Src1: SDValue = InVec.getOperand(2);
                        Mask = extractSubVector(Mask, IdxVal, DAG, DL, SizeInBits);
                        Mask = widenSubVector(Mask, false, Subtarget, DAG, DL, InSizeInBits);
                        let mut Shuffle: SDValue = DAG.getNode(InOpcode, DL, InVecVT, Src0, Mask, Src1);
                        return extractSubVector(Shuffle, 0, DAG, DL, SizeInBits);
                    }
                },
            }
        }
    }
    if (InOpcode == VSHLI || InOpcode == VSRLI) && InVecVT.getScalarSizeInBits() == 64 && InVec.getConstantOperandAPInt(1) == 32 {
        let mut Ext: SDValue = extractSubVector(InVec.getOperand(0), IdxVal, DAG, DL, SizeInBits);
        return DAG.getNode(InOpcode, DL, VT, Ext, InVec.getOperand(1));
    }
    return SDValue {};
}

fn combineSCALAR_TO_VECTOR(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Src: SDValue = N.getOperand(0);
    let mut DL: SDLoc = N;
    if VT == v1i1 && Src.getOpcode() == AND && Src.hasOneUse() && isOneConstant(Src.getOperand(1)) {
        return DAG.getNode(SCALAR_TO_VECTOR, DL, v1i1, Src.getOperand(0));
    }
    if VT == v1i1 && Src.getOpcode() == EXTRACT_VECTOR_ELT && Src.hasOneUse() && Src.getOperand(0).getValueType().isVector() && Src.getOperand(0).getValueType().getVectorElementType() == i1 && isNullConstant(Src.getOperand(1)) {
        return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Src.getOperand(0), Src.getOperand(1));
    }
    if (VT == v2i64 || VT == v2f64) && Src.hasOneUse() {
        let mut IsExt64: Closure_275 = Closure_275 { DAG: &mut DAG };
        if IsExt64.call(peekThroughOneUseBitcasts(Src), false) {
            AnyExt;
        } else {
            return DAG.getBitcast(VT, DAG.getNode(SCALAR_TO_VECTOR, DL, v4i32, DAG.getAnyExtOrTrunc(AnyExt, DL, i32)));
        }
        if IsExt64.call(peekThroughOneUseBitcasts(Src), true) {
            ZeroExt;
        } else {
            return DAG.getBitcast(VT, DAG.getNode(VZEXT_MOVL, DL, v4i32, DAG.getNode(SCALAR_TO_VECTOR, DL, v4i32, DAG.getZExtOrTrunc(ZeroExt, DL, i32))));
        }
    }
    if Src.getOpcode() == BITCAST {
        let mut SrcOp: SDValue = Src.getOperand(0);
        if VT == v4i32 && SrcOp.getValueType() == f32 {
            return DAG.getBitcast(VT, DAG.getNode(SCALAR_TO_VECTOR, DL, v4f32, SrcOp));
        }
        if VT == v2i64 && SrcOp.getValueType() == f64 {
            return DAG.getBitcast(VT, DAG.getNode(SCALAR_TO_VECTOR, DL, v2f64, SrcOp));
        }
        if VT == v2i64 && SrcOp.getValueType() == x86mmx {
            return DAG.getNode(MOVQ2DQ, DL, VT, SrcOp);
        }
        if VT == v8i16 && Subtarget.hasFP16() {
            if SrcOp.getValueType() == f16 {
                return DAG.getBitcast(VT, DAG.getNode(SCALAR_TO_VECTOR, DL, v8f16, SrcOp));
            }
            if SrcOp.getValueType() == bf16 {
                return DAG.getBitcast(VT, DAG.getNode(SCALAR_TO_VECTOR, DL, v8bf16, SrcOp));
            }
        }
    }
    if VT == v4i32 {
        let mut HalfSrc: SDValue = SDValue {};
        if sd_match(Src, m_AnyExt(m_BitCast(m_Value(HalfSrc, m_SpecificVT(f16))))) {
            return DAG.getBitcast(VT, DAG.getNode(SCALAR_TO_VECTOR, DL, v8f16, HalfSrc));
        }
    }
    if VT.getScalarType() == Src.getValueType() {
        for User in operator(Src).users() {
            if User.getOpcode() == VBROADCAST && Src == User.getOperand(0) {
                let mut SizeInBits: u32 = VT.getFixedSizeInBits();
                let mut BroadcastSizeInBits: u32 = User.getValueSizeInBits(0).getFixedValue();
                if BroadcastSizeInBits == SizeInBits {
                    return SDValue { Node: User, ResNo: 0 };
                }
                if BroadcastSizeInBits > SizeInBits {
                    return extractSubVector(SDValue { Node: User, ResNo: 0 }, 0, DAG, DL, SizeInBits);
                }
            }
        }
    }
    match Src.getOpcode() {
        SHL => {
            SRL;
        },
        FSHL => {
            FSHR;
        },
    }
    return SDValue {};
}

fn combinePMULDQ(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    if DAG.isConstantIntBuildVectorOrConstantInt(LHS, true) && !DAG.isConstantIntBuildVectorOrConstantInt(RHS, true) {
        return DAG.getNode(N.getOpcode(), N, N.getValueType(0), RHS, LHS);
    }
    if isBuildVectorAllZeros(RHS.getNode()) {
        return DAG.getConstant(0, N, N.getValueType(0), false, false);
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, getAllOnes(64), DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if N.getValueType(0) == v2i64 && LHS.hasOneUse() && (LHS.getOpcode() == ZERO_EXTEND_VECTOR_INREG || LHS.getOpcode() == SIGN_EXTEND_VECTOR_INREG) && LHS.getOperand(0).getValueType() == v4i32 {
        let mut dl: SDLoc = N;
        LHS = DAG.getVectorShuffle(v4i32, dl, LHS.getOperand(0), LHS.getOperand(0), [0, -1, 1, -1]);
        LHS = DAG.getBitcast(v2i64, LHS);
        return DAG.getNode(N.getOpcode(), dl, v2i64, LHS, RHS);
    }
    if N.getValueType(0) == v2i64 && RHS.hasOneUse() && (RHS.getOpcode() == ZERO_EXTEND_VECTOR_INREG || RHS.getOpcode() == SIGN_EXTEND_VECTOR_INREG) && RHS.getOperand(0).getValueType() == v4i32 {
        let mut dl: SDLoc = N;
        RHS = DAG.getVectorShuffle(v4i32, dl, RHS.getOperand(0), RHS.getOperand(0), [0, -1, 1, -1]);
        RHS = DAG.getBitcast(v2i64, RHS);
        return DAG.getNode(N.getOpcode(), dl, v2i64, LHS, RHS);
    }
    return SDValue {};
}

fn combineVPMADD(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Opc: u32 = N.getOpcode();
    let mut IsPMADDWD: bool = Opc == VPMADDWD;
    assert!((Opc == VPMADDWD || Opc == VPMADDUBSW), "Unexpected PMADD opcode");
    if isBuildVectorAllZeros(LHS.getNode()) || isBuildVectorAllZeros(RHS.getNode()) {
        return DAG.getConstant(0, N, VT, false, false);
    }
    let mut LHSUndefs: APInt = APInt {};
    let mut RHSUndefs: APInt = APInt {};
    let mut LHSBits: SmallVector<APInt> = SmallVector<APInt> {};
    let mut RHSBits: SmallVector<APInt> = SmallVector<APInt> {};
    let mut SrcEltBits: u32 = LHS.getScalarValueSizeInBits();
    let mut DstEltBits: u32 = VT.getScalarSizeInBits();
    if getTargetConstantBitsFromNode(LHS, SrcEltBits, LHSUndefs, LHSBits, true, false) && getTargetConstantBitsFromNode(RHS, SrcEltBits, RHSUndefs, RHSBits, true, false) {
        let mut Result: SmallVector<APInt> = SmallVector<APInt> {};
        for let mut I: u32 = 0;
let mut E: u32 = LHSBits.len; I != E; I += 2 {
            let mut LHSLo: APInt = LHSBits[I + 0];
            let mut LHSHi: APInt = LHSBits[I + 1];
            let mut RHSLo: APInt = RHSBits[I + 0];
            let mut RHSHi: APInt = RHSBits[I + 1];
            LHSLo = if IsPMADDWD { LHSLo.sext(DstEltBits) } else { LHSLo.zext(DstEltBits) };
            LHSHi = if IsPMADDWD { LHSHi.sext(DstEltBits) } else { LHSHi.zext(DstEltBits) };
            let mut Lo: APInt = LHSLo * RHSLo.sext(DstEltBits);
            let mut Hi: APInt = LHSHi * RHSHi.sext(DstEltBits);
            let mut Res: APInt = if IsPMADDWD { (Lo + Hi) } else { Lo.sadd_sat(Hi) };
            Result.push(Res);
        }
        return getConstVector(Result, VT, DAG, N);
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DemandedElts: APInt = getAllOnes(VT.getVectorNumElements());
    if TLI.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }, DemandedElts, DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn combineVPMADD52LH(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut AddLow: bool = N.getOpcode() == VPMADD52L;
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut Op2: SDValue = N.getOperand(2);
    let mut DL: SDLoc = N;
    let mut C0: APInt = APInt {};
    let mut C1: APInt = APInt {};
    let mut HasC0: bool = isConstantSplat(Op0, C0, true);
    let mut HasC1: bool = isConstantSplat(Op1, C1, true);
    if HasC0 && !HasC1 {
        return DAG.getNode(N.getOpcode(), DL, VT, Op1, Op0, Op2);
    }
    if AddLow && HasC1 && C1.trunc(52).isOne() {
        let mut KnownOp0: KnownBits = DAG.computeKnownBits(Op0, 0);
        if KnownOp0.countMinLeadingZeros() >= 12 {
            return DAG.getNode(ADD, DL, VT, Op0, Op2);
        }
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut NumEltBits: u32 = VT.getScalarSizeInBits();
    if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, getAllOnes(NumEltBits), DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn combineEXTEND_VECTOR_INREG(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut In: SDValue = N.getOperand(0);
    let mut Opcode: u32 = N.getOpcode();
    let mut InOpcode: u32 = In.getOpcode();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = N;
    if !DCI.isBeforeLegalizeOps() && isNormalLoad(In.getNode()) && In.hasOneUse() {
        let mut Ld: *mut LoadSDNode = cast(In);
        if Ld.isSimple() {
            let mut SVT: MVT = In.getSimpleValueType().getVectorElementType();
            let mut Ext: LoadExtType = if Opcode == SIGN_EXTEND_VECTOR_INREG { SEXTLOAD } else { ZEXTLOAD };
            let mut MemVT: EVT = VT.changeVectorElementType(*DAG.getContext(), SVT);
            if TLI.isLoadLegal(VT, MemVT, Ld.getAlign(), Ld.getAddressSpace(), Ext, false) {
                let mut Load: SDValue = DAG.getExtLoad(Ext, DL, VT, Ld.getChain(), Ld.getBasePtr(), Ld.getPointerInfo(), MemVT, Ld.getBaseAlign(), Ld.getMemOperand().getFlags(), MMOMetadata {});
                DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Ld, ResNo: 1 }, Load.getValue(1));
                return Load;
            }
        }
    }
    if Opcode == InOpcode {
        return DAG.getNode(Opcode, DL, VT, In.getOperand(0));
    }
    if InOpcode == EXTRACT_SUBVECTOR && In.getConstantOperandVal(1) == 0 && In.getOperand(0).getOpcode() == DAG.getOpcode_EXTEND(Opcode) && In.getOperand(0).getOperand(0).getValueSizeInBits() == In.getValueSizeInBits() {
        return DAG.getNode(Opcode, DL, VT, In.getOperand(0).getOperand(0));
    }
    if !DCI.isBeforeLegalizeOps() && Opcode == ZERO_EXTEND_VECTOR_INREG && In.getOpcode() == BUILD_VECTOR && In.hasOneUse() && In.getValueSizeInBits() == VT.getSizeInBits() {
        let mut NumElts: u32 = VT.getVectorNumElements();
        let mut Scale: u32 = VT.getScalarSizeInBits() / In.getScalarValueSizeInBits();
        let mut EltVT: EVT = In.getOperand(0).getValueType();
        let mut Elts: SmallVector<SDValue> = SmallVector<SDValue> { Scale * NumElts, DAG.getConstant(0, DL, EltVT, false, false) };
        for let mut I: u32 = 0; I != NumElts; I += 1 {
            Elts[I * Scale] = In.getOperand(I);
        }
        return DAG.getBitcast(VT, DAG.getBuildVector(In.getValueType(), DL, Elts));
    }
    if Subtarget.hasSSE41() {
        let mut Op: SDValue = SDValue { Node: N, ResNo: 0 };
        if TLI.isTypeLegal(VT) && TLI.isTypeLegal(In.getValueType()) {
            if combineX86ShufflesRecursively(Op, DAG, Subtarget) {
                Res;
            } else {
                return Res;
            }
        }
    }
    return SDValue {};
}

fn combineKSHIFT(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Src: SDValue = N.getOperand(0);
    let mut Amt: u64 = N.getConstantOperandVal(1);
    let mut Opcode: u32 = N.getOpcode();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = N;
    if isBuildVectorAllZeros(Src.getNode()) {
        return DAG.getConstant(0, DL, VT, false, false);
    }
    if dyn_cast(peekThroughBitcasts(Src)) {
        SrcC;
    } else {
        let mut NewCst: APInt = if Opcode == KSHIFTR { SrcC.getAPIntValue().lshr(Amt) } else { SrcC.getAPIntValue().shl(Amt) };
        return DAG.getBitcast(VT, DAG.getConstant(NewCst, DL, SrcC.getValueType(0), false, false));
    }
    if Opcode == KSHIFTR {
        if Src.getOpcode() == EXTRACT_SUBVECTOR || Src.getOpcode() == KSHIFTR {
            let mut Inner: SDValue = Src.getOperand(0);
            let mut InnerVT: EVT = Inner.getValueType();
            let mut NewAmt: u64 = Amt + Src.getConstantOperandVal(1);
            if TLI.isTypeLegal(InnerVT) && NewAmt < InnerVT.getVectorNumElements() {
                let mut Shift: SDValue = DAG.getNode(KSHIFTR, DL, InnerVT, Inner, DAG.getTargetConstant(NewAmt, DL, i8, false));
                return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Shift, DAG.getVectorIdxConstant(0, DL, false));
            }
        }
        if Src.getOpcode() == CONCAT_VECTORS && (Amt % Src.getOperand(0).getValueType().getVectorNumElements()) == 0 {
            let mut NumSubs: u32 = Src.getNumOperands();
            let mut SubVT: EVT = Src.getOperand(0).getValueType();
            let mut Ofs: u32 = Amt / SubVT.getVectorNumElements();
            let mut SubOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumSubs, DAG.getConstant(0, DL, SubVT, false, false) };
            for let mut I: u32 = Ofs; I != NumSubs; I += 1 {
                SubOps[I - Ofs] = Src.getOperand(I);
            }
            return DAG.getNode(CONCAT_VECTORS, DL, VT, SubOps);
        }
    }
    if isBitwiseLogicOp(Src.getOpcode()) && isa(peekThroughBitcasts(Src.getOperand(1))) {
        let mut LHS: SDValue = DAG.getNode(Opcode, DL, VT, Src.getOperand(0), N.getOperand(1));
        let mut RHS: SDValue = DAG.getNode(Opcode, DL, VT, Src.getOperand(1), N.getOperand(1));
        return DAG.getNode(Src.getOpcode(), DL, VT, LHS, RHS);
    }
    let mut DemandedElts: APInt = getAllOnes(VT.getVectorNumElements());
    if TLI.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }, DemandedElts, DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn combineAndOnGF2P8AFFINEQBOperand(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, VT: EVT) -> SDValue {
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut AndOp: SDValue = SDValue {};
    let mut SplatOp: SDValue = SDValue {};
    let mut Imm: APInt = APInt {};
    let mut SplatVal: APInt = APInt {};
    let mut ConstUndef: APInt = APInt {};
    let mut ConstEltBits: SmallVector<APInt> = SmallVector<APInt> {};
    if sd_match(N, m_TernaryOp(GF2P8AFFINEQB, m_Value(AndOp), m_Value(Y), m_ConstInt(Imm))) && sd_match(AndOp, m_And(m_Value(X), m_Value(SplatOp))) && getTargetConstantBitsFromNode(Y, Y.getScalarValueSizeInBits(), ConstUndef, ConstEltBits, false, false) {
        let mut SplatIsConst: bool = isConstantSplat(SplatOp, SplatVal, false);
        if !operator(AndOp).hasOneUse() && !SplatIsConst {
            return SDValue {};
        }
        if !(SplatIsConst || DAG.isSplatValue(SplatOp, false)) || SplatOp.getScalarValueSizeInBits() != 8 {
            return SDValue {};
        }
        let mut NewMatrix: SDValue = SDValue {};
        if !SplatIsConst {
            NewMatrix = DAG.getNode(AND, DL, VT, SplatOp, Y);
        } else {
            let mut FoldedAnd: SmallVector<SDValue> = SmallVector<SDValue> {};
            for Elt in ConstEltBits {
                FoldedAnd.push(DAG.getConstant(SplatVal & Elt, DL, i8, false, false));
            }
            NewMatrix = DAG.getBuildVector(VT, DL, FoldedAnd);
        }
        return DAG.getNode(GF2P8AFFINEQB, DL, VT, X, NewMatrix, DAG.getTargetConstant(Imm, DL, i8, false));
    }
    return SDValue {};
}

fn combineNestedGF2P8AFFINEQB(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, VT: EVT) -> SDValue {
    let mut VecWidth: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltWidth: u32 = VT.getScalarSizeInBits();
    let mut X: SDValue = SDValue {};
    let mut YSub: SDValue = SDValue {};
    let mut YSup: SDValue = SDValue {};
    let mut ImmSub: APInt = APInt {};
    let mut ImmSup: APInt = APInt {};
    let mut ConstUndef: APInt = APInt {};
    let mut YSubEltBits: SmallVector<APInt> = SmallVector<APInt> {};
    let mut YSupEltBits: SmallVector<APInt> = SmallVector<APInt> {};
    if !(sd_match(N, m_TernaryOp(GF2P8AFFINEQB, m_TernaryOp(GF2P8AFFINEQB, m_Value(X), m_Value(YSub), m_ConstInt(ImmSub)), m_Value(YSup), m_ConstInt(ImmSup))) && getTargetConstantBitsFromNode(YSub, EltWidth, ConstUndef, YSubEltBits, false, false) && getTargetConstantBitsFromNode(YSup, EltWidth, ConstUndef, YSupEltBits, false, false)) {
        return SDValue {};
    }
    let mut SubM: APInt = APInt { VecWidth, 0, false, false };
    let mut SupM: APInt = APInt { VecWidth, 0, false, false };
    for let mut I: u32 = 0; I != NumElts; I += 1 {
        SubM.insertBits(YSubEltBits[I], I * EltWidth);
        SupM.insertBits(YSupEltBits[I], I * EltWidth);
    }
    let mut FoldedImm: APInt = APInt {};
    if SupM.isSplat(64) {
        FoldedImm = getGFNIByteAffine(ImmSub, SupM.trunc(64), ImmSup);
    } else {
        if ImmSub != 0 {
            return SDValue {};
        }
        FoldedImm = ImmSup;
    }
    let mut FoldedMatrix: APInt = APInt { VecWidth, 0, false, false };
    let mut LeastRowMask: APInt = getSplat(VecWidth, APInt { 64, 255, false, false });
    let mut LeastBitInByte: APInt = getSplat(VecWidth, APInt { 8, 1, false, false });
    let mut RowSplatter: APInt = APInt { VecWidth, 72340172838076673, false, false };
    for let mut Row: u32 = 0; Row != 8; Row += 1 {
        let mut RowSplat: APInt = (SubM & LeastRowMask) * RowSplatter;
        SubM = SubM.lshr(EltWidth);
        let mut ByteMaskIfSet: APInt = (SupM.lshr(7 - Row)) & LeastBitInByte;
        operator(ByteMaskIfSet, 255);
        operator(FoldedMatrix, RowSplat & ByteMaskIfSet);
    }
    let mut FoldedVector: SmallVector<SDValue> = SmallVector<SDValue> {};
    for let mut I: u32 = 0; I < NumElts; I += 1 {
        let mut FoldedElt: APInt = FoldedMatrix.extractBits(EltWidth, I * EltWidth);
        FoldedVector.push(DAG.getConstant(FoldedElt, DL, i8, false, false));
    }
    let mut NewMatrix: SDValue = DAG.getBuildVector(VT, DL, FoldedVector);
    return DAG.getNode(GF2P8AFFINEQB, DL, VT, X, NewMatrix, DAG.getTargetConstant(FoldedImm, DL, i8, false));
}

fn combineXorOnGF2P8AFFINEQBOperand(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, VT: EVT) -> SDValue {
    let mut MatrixWidth: u32 = 64;
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut SplatOp: SDValue = SDValue {};
    let mut Imm: APInt = APInt {};
    let mut SplatVal: APInt = APInt {};
    let mut ConstUndef: APInt = APInt {};
    let mut MatEltBits: SmallVector<APInt> = SmallVector<APInt> {};
    if sd_match(N, m_TernaryOp(GF2P8AFFINEQB, m_Xor(m_Value(X), m_Value(SplatOp)), m_Value(Y), m_ConstInt(Imm))) && isConstantSplat(SplatOp, SplatVal, false) && getTargetConstantBitsFromNode(Y, MatrixWidth, ConstUndef, MatEltBits, false, false) {
        if !all_equal(MatEltBits) {
            return SDValue {};
        }
        let mut NewImm: APInt = getGFNIByteAffine(SplatVal, MatEltBits[0], Imm);
        return DAG.getNode(GF2P8AFFINEQB, DL, VT, X, Y, DAG.getTargetConstant(NewImm, DL, i8, false));
    }
    return SDValue {};
}

fn combineGF2P8AFFINEQB(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = N;
    if combineAndOnGF2P8AFFINEQBOperand(N, dl, DAG, VT) {
        R;
    } else {
        return R;
    }
    if combineXorOnGF2P8AFFINEQBOperand(N, dl, DAG, VT) {
        R;
    } else {
        return R;
    }
    if combineNestedGF2P8AFFINEQB(N, dl, DAG, VT) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn combineFP16_TO_FP(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if Subtarget.useSoftFloat() || !Subtarget.hasF16C() {
        return SDValue {};
    }
    if N.getOperand(0).getOpcode() != FP_TO_FP16 {
        return SDValue {};
    }
    if N.getValueType(0) != f32 || N.getOperand(0).getOperand(0).getValueType() != f32 {
        return SDValue {};
    }
    let mut dl: SDLoc = N;
    let mut Res: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, v4f32, N.getOperand(0).getOperand(0));
    Res = DAG.getNode(CVTPS2PH, dl, v8i16, Res, DAG.getTargetConstant(CUR_DIRECTION, dl, i32, false));
    Res = DAG.getNode(CVTPH2PS, dl, v4f32, Res);
    return DAG.getNode(EXTRACT_VECTOR_ELT, dl, f32, Res, DAG.getVectorIdxConstant(0, dl, false));
}

fn combineFP_EXTEND(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Src: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut SrcVT: EVT = Src.getValueType();
    let mut dl: SDLoc = N;
    if SrcVT.getScalarType() == bf16 {
        if DCI.isAfterLegalizeDAG() && Src.getOpcode() == FP_ROUND && !IsStrict && Src.getOperand(0).getValueType() == VT {
            return Src.getOperand(0);
        }
        if !SrcVT.isVector() {
            return SDValue {};
        }
        assert!(!IsStrict, "Strict FP doesn't support BF16");
        if VT.getVectorElementType() == f64 {
            let mut TmpVT: EVT = VT.changeVectorElementType(*DAG.getContext(), f32);
            return DAG.getNode(FP_EXTEND, dl, VT, DAG.getNode(FP_EXTEND, dl, TmpVT, Src));
        }
        assert!(VT.getVectorElementType() == f32, "Unexpected fpext");
        let mut NVT: EVT = SrcVT.changeVectorElementType(*DAG.getContext(), i32);
        Src = DAG.getBitcast(SrcVT.changeTypeToInteger(), Src);
        Src = DAG.getNode(ZERO_EXTEND, dl, NVT, Src);
        Src = DAG.getNode(SHL, dl, NVT, Src, DAG.getConstant(16, dl, NVT, false, false));
        return DAG.getBitcast(VT, Src);
    }
    if !Subtarget.hasF16C() || Subtarget.useSoftFloat() {
        return SDValue {};
    }
    if Subtarget.hasFP16() {
        return SDValue {};
    }
    if !SrcVT.isVectorOf(f16) {
        return SDValue {};
    }
    if VT.getVectorElementType() != f32 && VT.getVectorElementType() != f64 {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    if NumElts == 1 || !isPowerOf2_32(NumElts) {
        return SDValue {};
    }
    let mut IntVT: EVT = SrcVT.changeVectorElementTypeToInteger();
    Src = DAG.getBitcast(IntVT, Src);
    if NumElts < 8 {
        let mut NumConcats: u32 = 8 / NumElts;
        let mut Fill: SDValue = if NumElts == 4 { DAG.getUNDEF(IntVT) } else { DAG.getConstant(0, dl, IntVT, false, false) };
        let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumConcats, Fill };
        Ops[0] = Src;
        Src = DAG.getNode(CONCAT_VECTORS, dl, v8i16, Ops);
    }
    let mut CvtVT: EVT = getVectorVT(*DAG.getContext(), f32, if 4 > NumElts { 4 } else { NumElts }, false);
    let mut Cvt: SDValue = SDValue {};
    let mut Chain: SDValue = SDValue {};
    if IsStrict {
        Cvt = DAG.getNode(STRICT_CVTPH2PS, dl, [CvtVT, Other], [N.getOperand(0), Src]);
        Chain = Cvt.getValue(1);
    } else {
        Cvt = DAG.getNode(CVTPH2PS, dl, CvtVT, Src);
    }
    if NumElts < 4 {
        assert!(NumElts == 2, "Unexpected size");
        Cvt = DAG.getNode(EXTRACT_SUBVECTOR, dl, v2f32, Cvt, DAG.getVectorIdxConstant(0, dl, false));
    }
    if IsStrict {
        if Cvt.getValueType() != VT {
            Cvt = DAG.getNode(STRICT_FP_EXTEND, dl, [VT, Other], [Chain, Cvt]);
            Chain = Cvt.getValue(1);
        }
        return DAG.getMergeValues([Cvt, Chain], dl);
    }
    return DAG.getNode(FP_EXTEND, dl, VT, Cvt);
}

fn combineBROADCAST_LOAD(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    assert!((N.getOpcode() == VBROADCAST_LOAD || N.getOpcode() == SUBV_BROADCAST_LOAD), "Unknown broadcast load type");
    let mut MemIntrin: *mut MemIntrinsicSDNode = cast(N);
    let mut Ptr: SDValue = MemIntrin.getBasePtr();
    let mut Chain: SDValue = MemIntrin.getChain();
    let mut VT: EVT = N.getSimpleValueType(0);
    let mut MemVT: EVT = MemIntrin.getMemoryVT();
    for User in operator(Ptr).users() {
        if User != N && User.getOpcode() == N.getOpcode() && cast(User).getBasePtr() == Ptr && cast(User).getChain() == Chain && cast(User).getMemoryVT().getSizeInBits() == MemVT.getSizeInBits() && User.getValueSizeInBits(0).getFixedValue() > VT.getFixedSizeInBits() {
            assert!(cast(User).isSimple() && MemIntrin.isSimple(), "Illegal broadcast load type");
            DAG.makeEquivalentMemoryOrdering(SDValue { Node: N, ResNo: 1 }, SDValue { Node: User, ResNo: 1 });
            let mut Extract: SDValue = extractSubVector(SDValue { Node: User, ResNo: 0 }, 0, DAG, N, VT.getSizeInBits().operator unsigned long long());
            Extract = DAG.getBitcast(VT, Extract);
            Extract = DCI.CombineTo(N, Extract, SDValue { Node: User, ResNo: 1 }, true);
            return Extract;
        }
    }
    return SDValue {};
}

fn combineFP_ROUND(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut VT: EVT = N.getValueType(0);
    let mut Src: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut dl: SDLoc = N;
    if !IsStrict && VT == f16 && (Src.getOpcode() == FNEG || Src.getOpcode() == FABS) {
        let mut Inner: SDValue = Src.getOperand(0);
        if Inner.getOpcode() == FP_EXTEND && Inner.getOperand(0).getValueType() == f16 {
            return DAG.getNode(Src.getOpcode(), dl, f16, Inner.getOperand(0));
        }
    }
    if !Subtarget.hasF16C() || Subtarget.useSoftFloat() {
        return SDValue {};
    }
    let mut SrcVT: EVT = Src.getValueType();
    if !VT.isVectorOf(f16) || SrcVT.getVectorElementType() != f32 {
        return SDValue {};
    }
    let mut Cvt: SDValue = SDValue {};
    let mut Chain: SDValue = SDValue {};
    let mut NumElts: u32 = VT.getVectorNumElements();
    if Subtarget.hasFP16() {
        if NumElts == 8 && Src.getOpcode() == CONCAT_VECTORS && Src.getNumOperands() == 2 {
            let mut Cvt0: SDValue = SDValue {};
            let mut Cvt1: SDValue = SDValue {};
            let mut Op0: SDValue = Src.getOperand(0);
            let mut Op1: SDValue = Src.getOperand(1);
            let mut IsOp0Strict: bool = operator(Op0).isStrictFPOpcode();
            if Op0.getOpcode() != Op1.getOpcode() || Op0.getOperand(if IsOp0Strict { 1 } else { 0 }).getValueType() != v4i64 || Op1.getOperand(if IsOp0Strict { 1 } else { 0 }).getValueType() != v4i64 {
                return SDValue {};
            }
            let mut Mask: [8]i32 = [0, 1, 2, 3, 8, 9, 10, 11];
            if IsStrict {
                assert!(IsOp0Strict, "Op0 must be strict node");
                let mut Opc: u32 = if Op0.getOpcode() == STRICT_SINT_TO_FP { STRICT_CVTSI2P } else { STRICT_CVTUI2P };
                Cvt0 = DAG.getNode(Opc, dl, [v8f16, Other], [Op0.getOperand(0), Op0.getOperand(1)]);
                Cvt1 = DAG.getNode(Opc, dl, [v8f16, Other], [Op1.getOperand(0), Op1.getOperand(1)]);
                Cvt = DAG.getVectorShuffle(v8f16, dl, Cvt0, Cvt1, Mask);
                return DAG.getMergeValues([Cvt, Cvt0.getValue(1)], dl);
            }
            let mut Opc: u32 = if Op0.getOpcode() == SINT_TO_FP { CVTSI2P } else { CVTUI2P };
            Cvt0 = DAG.getNode(Opc, dl, v8f16, Op0.getOperand(0));
            Cvt1 = DAG.getNode(Opc, dl, v8f16, Op1.getOperand(0));
            return Cvt = DAG.getVectorShuffle(v8f16, dl, Cvt0, Cvt1, Mask);
        }
        return SDValue {};
    }
    if NumElts == 1 || !isPowerOf2_32(NumElts) {
        return SDValue {};
    }
    if NumElts < 4 {
        Src = DAG.getNode(CONCAT_VECTORS, dl, v4f32, Src, DAG.getConstantFP(0.0, dl, SrcVT, false));
    }
    let mut CvtVT: EVT = getVectorVT(*DAG.getContext(), i16, if 8 > NumElts { 8 } else { NumElts }, false);
    let mut Rnd: SDValue = DAG.getTargetConstant(CUR_DIRECTION, dl, i32, false);
    if IsStrict {
        Cvt = DAG.getNode(STRICT_CVTPS2PH, dl, [CvtVT, Other], [N.getOperand(0), Src, Rnd]);
        Chain = Cvt.getValue(1);
    } else {
        Cvt = DAG.getNode(CVTPS2PH, dl, CvtVT, Src, Rnd);
    }
    if NumElts < 8 {
        let mut IntVT: EVT = VT.changeVectorElementTypeToInteger();
        Cvt = DAG.getNode(EXTRACT_SUBVECTOR, dl, IntVT, Cvt, DAG.getVectorIdxConstant(0, dl, false));
    }
    Cvt = DAG.getBitcast(VT, Cvt);
    if IsStrict {
        return DAG.getMergeValues([Cvt, Chain], dl);
    }
    return Cvt;
}

fn combineMOVDQ2Q(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Src: SDValue = N.getOperand(0);
    if isNormalLoad(Src.getNode()) && Src.hasOneUse() {
        let mut LN: *mut LoadSDNode = cast(Src.getNode());
        if LN.isSimple() {
            let mut NewLd: SDValue = DAG.getLoad(x86mmx, N, LN.getChain(), LN.getBasePtr(), LN.getPointerInfo(), LN.getBaseAlign(), LN.getMemOperand().getFlags(), MMOMetadata {});
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, NewLd.getValue(1));
            return NewLd;
        }
    }
    return SDValue {};
}

fn combineBMI(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut NumBits: u32 = N.getSimpleValueType(0).getSizeInBits().operator unsigned long long();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, getAllOnes(NumBits), DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn combinePCLMULQDQ(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!(VT.getVectorElementType() == i64, "vXi64 type expected");
    let mut SimplifyOperand: Closure_276 = Closure_276 { DAG: &mut DAG, VT: &mut VT, NumElts: &mut NumElts };
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut Mask: u64 = N.getConstantOperandVal(2);
    let mut M0: u64 = Mask & 1;
    let mut M1: u64 = (Mask & 16) >> 4;
    let mut Simplify0: bool = SimplifyOperand.call(N0, M0);
    let mut Simplify1: bool = SimplifyOperand.call(N1, M1);
    if Simplify0 || Simplify1 {
        let mut DL: SDLoc = N;
        return DAG.getNode(PCLMULQDQ, DL, VT, N0, N1, DAG.getTargetConstant((M1 << 4) | M0, DL, i8, false));
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }, getAllOnes(NumElts), DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn FixupMMXIntrinsicTypes(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = N;
    let mut MadeChange: bool = false;
    let mut CastReturnVal: bool = false;
    let mut Args: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for Arg in N.op_values() {
        if Arg.getValueType() == v1i64 {
            MadeChange = true;
            Args.push(DAG.getBitcast(x86mmx, Arg));
        } else {
            Args.push(Arg);
        }
    }
    let mut VTs: SDVTList = N.getVTList();
    let mut NewVTs: SDVTList = VTs;
    if VTs.NumVTs > 0 && VTs.VTs[0] == v1i64 {
        let mut NewVTArr: SmallVector<EVT> = ArrayRef<EVT> { VTs.VTs, VTs.NumVTs };
        NewVTArr[0] = x86mmx;
        NewVTs = DAG.getVTList(NewVTArr);
        MadeChange = true;
        CastReturnVal = true;
    }
    if MadeChange {
        let mut Result: SDValue = DAG.getNode(N.getOpcode(), dl, NewVTs, Args);
        if CastReturnVal {
            let mut Returns: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
            for let mut i: u32 = 0;
let mut e: u32 = operator(Result).getNumValues(); i != e; i += 1 {
                Returns.push(Result.getValue(i));
            }
            Returns[0] = DAG.getBitcast(v1i64, Returns[0]);
            return DAG.getMergeValues(Returns, dl);
        }
        return Result;
    }
    return SDValue {};
}

fn combineINTRINSIC_WO_CHAIN(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut IntNo: u32 = N.getConstantOperandVal(0);
    let mut IntrData: *IntrinsicData = getIntrinsicWithoutChain(IntNo);
    if IntrData && IntrData.Type == INTR_TYPE_CAST_MMX {
        return FixupMMXIntrinsicTypes(N, DAG);
    }
    return SDValue {};
}

fn combineINTRINSIC_W_CHAIN(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut IntNo: u32 = N.getConstantOperandVal(1);
    let mut IntrData: *IntrinsicData = getIntrinsicWithChain(IntNo);
    if IntrData && IntrData.Type == INTR_TYPE_CAST_MMX {
        return FixupMMXIntrinsicTypes(N, DAG);
    }
    return SDValue {};
}

fn combineINTRINSIC_VOID(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut IntNo: u32 = N.getConstantOperandVal(1);
    let mut IntrData: *IntrinsicData = getIntrinsicWithChain(IntNo);
    if IntrData && IntrData.Type == INTR_TYPE_CAST_MMX {
        return FixupMMXIntrinsicTypes(N, DAG);
    }
    return SDValue {};
}

fn X86TargetLowering::PerformDAGCombine(self: *X86TargetLowering, N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    match N.getOpcode() {
        _ => {
            break;
        },
        SCALAR_TO_VECTOR => {
            return combineSCALAR_TO_VECTOR(N, DAG, self.Subtarget);
        },
        EXTRACT_VECTOR_ELT => {
            PEXTRW;
        },
        CONCAT_VECTORS => {
            return combineCONCAT_VECTORS(N, DAG, DCI, self.Subtarget);
        },
        INSERT_SUBVECTOR => {
            return combineINSERT_SUBVECTOR(N, DAG, DCI, self.Subtarget);
        },
        EXTRACT_SUBVECTOR => {
            return combineEXTRACT_SUBVECTOR(N, DAG, DCI, self.Subtarget);
        },
        VSELECT => {
            SELECT;
        },
        BITCAST => {
            return combineBitcast(N, DAG, DCI, self.Subtarget);
        },
        CMOV => {
            return combineCMov(N, DAG, DCI, self.Subtarget);
        },
        CMP => {
            return combineCMP(N, DAG, DCI, self.Subtarget);
        },
        ADD => {
            return combineAdd(N, DAG, DCI, self.Subtarget);
        },
        SUB => {
            return combineSub(N, DAG, DCI, self.Subtarget);
        },
        ADD => {
            SUB;
        },
        XOR => {
            return combineX86XOR(N, DAG, DCI);
        },
        SADDSAT => {
            SSUBSAT;
        },
        CLOAD => {
            CSTORE;
        },
        SBB => {
            return combineSBB(N, DAG);
        },
        ADOX => {
            return combineADOX(N, DAG);
        },
        ADC => {
            return combineADC(N, DAG, DCI);
        },
        MUL => {
            return combineMul(N, DAG, DCI, self.Subtarget);
        },
        UDIV => {
            SDIV;
        },
        SHL => {
            return combineShiftLeft(N, DAG, self.Subtarget);
        },
        SRA => {
            return combineShiftRightArithmetic(N, DAG, self.Subtarget);
        },
        SRL => {
            return combineShiftRightLogical(N, DAG, DCI, self.Subtarget);
        },
        AND => {
            return combineAnd(N, DAG, DCI, self.Subtarget);
        },
        OR => {
            return combineOr(N, DAG, DCI, self.Subtarget);
        },
        XOR => {
            return combineXor(N, DAG, DCI, self.Subtarget);
        },
        BITREVERSE => {
            return combineBITREVERSE(N, DAG, DCI, self.Subtarget);
        },
        ROTL => {
            ROTR;
        },
        AVGCEILS => {
            AVGCEILU;
        },
        ATOMIC_LOAD => {
            return combineAtomicLoad(N, DAG, DCI);
        },
        LOAD => {
            return combineLoad(N, DAG, DCI, self.Subtarget);
        },
        MLOAD => {
            return combineMaskedLoad(N, DAG, DCI, self.Subtarget);
        },
        STORE => {
            return combineStore(N, DAG, DCI, self.Subtarget);
        },
        MSTORE => {
            return combineMaskedStore(N, DAG, DCI, self.Subtarget);
        },
        VEXTRACT_STORE => {
            return combineVEXTRACT_STORE(N, DAG, DCI, self.Subtarget);
        },
        SINT_TO_FP => {
            STRICT_SINT_TO_FP;
        },
        UINT_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        FP_TO_SINT => {
            return combineFPToSInt(N, DAG, self.Subtarget);
        },
        LRINT => {
            LLRINT;
        },
        FADD => {
            FSUB;
        },
        VFCMULC => {
            VFMULC;
        },
        FNEG => {
            return combineFneg(N, DAG, DCI, self.Subtarget);
        },
        VECREDUCE_AND => {
            VECREDUCE_OR;
        },
        VECREDUCE_MUL => {
            return combineVECREDUCE_MUL(N, DAG, self.Subtarget);
        },
        TRUNCATE => {
            return combineTruncate(N, DAG, self.Subtarget);
        },
        VTRUNC => {
            return combineVTRUNC(N, DAG, DCI);
        },
        VTRUNCS => {
            VTRUNCUS;
        },
        ANDNP => {
            return combineAndnp(N, DAG, DCI, self.Subtarget);
        },
        FAND => {
            return combineFAnd(N, DAG, self.Subtarget);
        },
        FANDN => {
            return combineFAndn(N, DAG, self.Subtarget);
        },
        FXOR => {
            FOR;
        },
        PSEUDO_FMIN => {
            PSEUDO_FMAX;
        },
        FMINNUM => {
            FMAXNUM;
        },
        CVTSI2P => {
            CVTUI2P;
        },
        CVTP2SI => {
            CVTP2UI;
        },
        STRICT_CVTPH2PS => {
            CVTPH2PS;
        },
        BT => {
            return combineBT(N, DAG, DCI);
        },
        ANY_EXTEND => {
            ZERO_EXTEND;
        },
        SIGN_EXTEND => {
            return combineSext(N, DAG, DCI, self.Subtarget);
        },
        SIGN_EXTEND_INREG => {
            return combineSignExtendInReg(N, DAG, self.Subtarget);
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        SETCC => {
            return combineSetCC(N, DAG, DCI, self.Subtarget);
        },
        SETCC => {
            return combineX86SetCC(N, DAG, self.Subtarget);
        },
        BRCOND => {
            return combineBrCond(N, DAG, self.Subtarget);
        },
        PACKSS => {
            PACKUS;
        },
        HADD => {
            HSUB;
        },
        VSHL => {
            VSRA;
        },
        VSHLI => {
            VSRAI;
        },
        INSERT_VECTOR_ELT => {
            PINSRB;
        },
        SHUFP => {
            INSERTPS;
        },
        FMADD_RND => {
            FMSUB;
        },
        FMADDSUB_RND => {
            FMSUBADD_RND;
        },
        MOVMSK => {
            return combineMOVMSK(N, DAG, DCI, self.Subtarget);
        },
        TESTP => {
            return combineTESTP(N, DAG, DCI, self.Subtarget);
        },
        MGATHER => {
            MSCATTER;
        },
        MGATHER => {
            MSCATTER;
        },
        PCMPEQ => {
            PCMPGT;
        },
        PMULDQ => {
            PMULUDQ;
        },
        VPMADDUBSW => {
            VPMADDWD;
        },
        VPMADD52L => {
            VPMADD52H;
        },
        KSHIFTL => {
            KSHIFTR;
        },
        GF2P8AFFINEQB => {
            return combineGF2P8AFFINEQB(N, DAG);
        },
        FP16_TO_FP => {
            return combineFP16_TO_FP(N, DAG, self.Subtarget);
        },
        STRICT_FP_EXTEND => {
            FP_EXTEND;
        },
        STRICT_FP_ROUND => {
            FP_ROUND;
        },
        VBROADCAST_LOAD => {
            SUBV_BROADCAST_LOAD;
        },
        MOVDQ2Q => {
            return combineMOVDQ2Q(N, DAG);
        },
        BEXTR => {
            BEXTRI;
        },
        PCLMULQDQ => {
            return combinePCLMULQDQ(N, DAG, DCI);
        },
        INTRINSIC_WO_CHAIN => {
            return combineINTRINSIC_WO_CHAIN(N, DAG, DCI);
        },
        INTRINSIC_W_CHAIN => {
            return combineINTRINSIC_W_CHAIN(N, DAG, DCI);
        },
        INTRINSIC_VOID => {
            return combineINTRINSIC_VOID(N, DAG, DCI);
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        FSHL => {
            FSHR;
        },
    }
    return SDValue {};
}

fn X86TargetLowering::preferABDSToABSWithNSW(self: *X86TargetLowering, VT: EVT) -> bool {
    return self.Subtarget.canUseCMOV() && (VT == i32 || VT == i64);
}

fn X86TargetLowering::preferSextInRegOfTruncate(self: *X86TargetLowering, TruncVT: EVT, VT: EVT, ExtVT: EVT) -> bool {
    return self.Subtarget.hasAVX512() || !VT.isVector();
}

fn X86TargetLowering::isTypeDesirableForOp(self: *X86TargetLowering, Opc: u32, VT: EVT) -> bool {
    if !self.isTypeLegal(VT) {
        return false;
    }
    if Opc == MSTORE && self.Subtarget.isVecMaskStoreSlow() {
        return false;
    }
    if Opc == SHL && VT.isVectorOf(i8) {
        return false;
    }
    if (Opc == MUL || Opc == SHL) && VT == i8 {
        return false;
    }
    if VT == i16 {
        match Opc {
            _ => {
                break;
            },
            LOAD => {
                SIGN_EXTEND;
            },
            SHL => {
                SRA;
            },
        }
    }
    return true;
}

fn X86TargetLowering::expandIndirectJTBranch(self: *X86TargetLowering, dl: *SDLoc, Value: SDValue, Addr: SDValue, JTI: i32, DAG: *mut SelectionDAG) -> SDValue {
    let mut M: *Module = DAG.getMachineFunction().getFunction().getParent();
    let mut IsCFProtectionSupported: *mut Metadata = M.getModuleFlag("cf-protection-branch");
    if IsCFProtectionSupported {
        let mut Chain: SDValue = Value;
        if M.getTargetTriple().isOSBinFormatCOFF() {
            Chain = DAG.getJumpTableDebugInfo(JTI, Chain, dl);
        }
        return DAG.getNode(NT_BRIND, dl, Other, Chain, Addr);
    }
    return self.expandIndirectJTBranch(dl, Value, Addr, JTI, DAG);
}

fn X86TargetLowering::isDesirableToCombineLogicOpOfSETCC(self: *X86TargetLowering, LogicOp: *SDNode, SETCC0: *SDNode, SETCC1: *SDNode) -> AndOrSETCCFoldKind {
    let mut VT: EVT = LogicOp.getValueType(0);
    let mut OpVT: EVT = SETCC0.getOperand(0).getValueType();
    if !VT.isInteger() {
        return None;
    }
    if VT.isVector() {
        return NotAnd | (if self.isOperationLegal(ABS, OpVT) { ABS } else { None });
    }
    return AddAnd;
}

fn X86TargetLowering::IsDesirableToPromoteOp(self: *X86TargetLowering, Op: SDValue, PVT: *mut EVT) -> bool {
    let mut VT: EVT = Op.getValueType();
    let mut Is8BitMulByConstant: bool = VT == i8 && Op.getOpcode() == MUL && isa(Op.getOperand(1));
    if VT != i16 && !Is8BitMulByConstant {
        return false;
    }
    let mut IsFoldableRMW: Closure_277 = Closure_277 {};
    let mut IsFoldableAtomicRMW: Closure_278 = Closure_278 {};
    let mut IsFoldableZext: Closure_279 = Closure_279 {};
    let mut Commute: bool = false;
    match Op.getOpcode() {
        _ => {
            return false;
        },
        SIGN_EXTEND => {
            ZERO_EXTEND;
        },
        SHL => {
            SRA;
        },
        MUL => {
            if self.Subtarget.hasZU() && IsFoldableZext.call(Op) && (isa(Op.getOperand(0)) || isa(Op.getOperand(1))) {
                return false;
            }
        },
        ADD => {
            AND;
        },
        SUB => {
            let mut N0: SDValue = Op.getOperand(0);
            let mut N1: SDValue = Op.getOperand(1);
            if mayFoldLoad(N1, self.Subtarget, false, false) && (!Commute || !isa(N0) || (Op.getOpcode() != MUL && IsFoldableRMW.call(N1, Op))) {
                return false;
            }
            if mayFoldLoad(N0, self.Subtarget, false, false) && ((Commute && !isa(N1)) || (Op.getOpcode() != MUL && IsFoldableRMW.call(N0, Op))) {
                return false;
            }
            if IsFoldableAtomicRMW.call(N0, Op) || (Commute && IsFoldableAtomicRMW.call(N1, Op)) {
                return false;
            }
        },
    }
    PVT = i32;
    return true;
}

fn parseConstraintCode(Constraint: str) -> CondCode {
    let mut Cond: CondCode = Constraint.Case("{@cca}", COND_A).Case("{@ccae}", COND_AE).Case("{@ccb}", COND_B).Case("{@ccbe}", COND_BE).Case("{@ccc}", COND_B).Case("{@cce}", COND_E).Case("{@ccz}", COND_E).Case("{@ccg}", COND_G).Case("{@ccge}", COND_GE).Case("{@ccl}", COND_L).Case("{@ccle}", COND_LE).Case("{@ccna}", COND_BE).Case("{@ccnae}", COND_B).Case("{@ccnb}", COND_AE).Case("{@ccnbe}", COND_A).Case("{@ccnc}", COND_AE).Case("{@ccne}", COND_NE).Case("{@ccnz}", COND_NE).Case("{@ccng}", COND_LE).Case("{@ccnge}", COND_L).Case("{@ccnl}", COND_GE).Case("{@ccnle}", COND_G).Case("{@ccno}", COND_NO).Case("{@ccnp}", COND_NP).Case("{@ccns}", COND_NS).Case("{@cco}", COND_O).Case("{@ccp}", COND_P).Case("{@ccs}", COND_S).Default(COND_INVALID);
    return Cond;
}

fn X86TargetLowering::getConstraintType(self: *X86TargetLowering, Constraint: str) -> ConstraintType {
    if Constraint.len == 1 {
        match Constraint[0] {
            'R' => {
                'q';
            },
            'a' => {
                'b';
            },
            'I' => {
                'J';
            },
            'C' => {
                'e';
            },
            _ => {
                break;
            },
        }
    } else if Constraint.len == 2 {
        match Constraint[0] {
            _ => {
                break;
            },
            'W' => {
                if Constraint[1] != 's' {
                    break;
                }
            },
            'Y' => {
                match Constraint[1] {
                    _ => {
                        break;
                    },
                    'z' => {
                        return C_Register;
                    },
                    'i' => {
                        'm';
                    },
                }
            },
            'j' => {
                match Constraint[1] {
                    _ => {
                        break;
                    },
                    'r' => {
                        'R';
                    },
                }
            },
        }
    } else if parseConstraintCode(Constraint) != COND_INVALID {
        return C_Other;
    }
    return self.getConstraintType(Constraint);
}

fn X86TargetLowering::getSingleConstraintMatchWeight(self: *X86TargetLowering, Info: *mut AsmOperandInfo, Constraint: *u8) -> ConstraintWeight {
    let mut Wt: ConstraintWeight = CW_Invalid;
    let mut CallOperandVal: *mut Value = Info.CallOperandVal;
    if !CallOperandVal {
        return CW_Default;
    }
    let mut Ty: *mut Type = CallOperandVal.getType();
    match *Constraint {
        _ => {
            Wt = self.getSingleConstraintMatchWeight(Info, Constraint);
        },
        'R' => {
            'q';
        },
        'f' => {
            't';
        },
        'y' => {
            if Ty.getPrimitiveSizeInBits().operator unsigned long long() == 64 && self.Subtarget.hasMMX() {
                Wt = CW_SpecificReg;
            }
        },
        'Y' => {
            if Constraint.len != 2 {
                break;
            }
        },
        'j' => {
            if Constraint.len != 2 {
                break;
            }
        },
        'v' => {
            if (Ty.getPrimitiveSizeInBits().operator unsigned long long() == 512) && self.Subtarget.hasAVX512() {
                Wt = CW_Register;
            }
        },
        'x' => {
            if ((Ty.getPrimitiveSizeInBits().operator unsigned long long() == 128) && self.Subtarget.hasSSE1()) || ((Ty.getPrimitiveSizeInBits().operator unsigned long long() == 256) && self.Subtarget.hasAVX()) {
                Wt = CW_Register;
            }
        },
        'k' => {
            if (Ty.getPrimitiveSizeInBits().operator unsigned long long() == 64) && self.Subtarget.hasAVX512() {
                Wt = CW_Register;
            }
        },
        'I' => {
            if dyn_cast(Info.CallOperandVal) {
                C;
            } else if C.getZExtValue() <= 31 {
                Wt = CW_Constant;
            }
        },
        'J' => {
            if dyn_cast(CallOperandVal) {
                C;
            } else if C.getZExtValue() <= 63 {
                Wt = CW_Constant;
            }
        },
        'K' => {
            if dyn_cast(CallOperandVal) {
                C;
            } else if (C.getSExtValue() >= -128) && (C.getSExtValue() <= 127) {
                Wt = CW_Constant;
            }
        },
        'L' => {
            if dyn_cast(CallOperandVal) {
                C;
            } else if (C.getZExtValue() == 255) || (C.getZExtValue() == 65535) {
                Wt = CW_Constant;
            }
        },
        'M' => {
            if dyn_cast(CallOperandVal) {
                C;
            } else if C.getZExtValue() <= 3 {
                Wt = CW_Constant;
            }
        },
        'N' => {
            if dyn_cast(CallOperandVal) {
                C;
            } else if C.getZExtValue() <= 255 {
                Wt = CW_Constant;
            }
        },
        'G' => {
            'C';
        },
        'e' => {
            if dyn_cast(CallOperandVal) {
                C;
            } else if (C.getSExtValue() >= -2147483648) && (C.getSExtValue() <= 2147483647) {
                Wt = CW_Constant;
            }
        },
        'Z' => {
            if dyn_cast(CallOperandVal) {
                C;
            } else if C.getZExtValue() <= 4294967295 {
                Wt = CW_Constant;
            }
        },
    }
    return Wt;
}

fn X86TargetLowering::LowerXConstraint(self: *X86TargetLowering, ConstraintVT: EVT) -> *u8 {
    if ConstraintVT.isFloatingPoint() {
        if self.Subtarget.hasSSE1() {
            return "x";
        }
    }
    return self.LowerXConstraint(ConstraintVT);
}

fn X86TargetLowering::LowerAsmOutputForConstraint(self: *X86TargetLowering, Chain: *mut SDValue, Glue: *mut SDValue, DL: *SDLoc, OpInfo: *AsmOperandInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut Cond: CondCode = parseConstraintCode(OpInfo.ConstraintCode);
    if Cond == COND_INVALID {
        return SDValue {};
    }
    if OpInfo.ConstraintVT.isVector() || !OpInfo.ConstraintVT.isInteger() || OpInfo.ConstraintVT.getSizeInBits().operator unsigned long long() < 8 {
        report_fatal_error("Glue output operand is of invalid type", true);
    }
    if Glue.getNode() {
        Glue = DAG.getCopyFromReg(Chain, DL, EFLAGS, i32, Glue);
        Chain = Glue.getValue(1);
    } else {
        Glue = DAG.getCopyFromReg(Chain, DL, EFLAGS, i32);
    }
    let mut CC: SDValue = getSETCC(Cond, Glue, DL, DAG);
    let mut Result: SDValue = DAG.getNode(ZERO_EXTEND, DL, OpInfo.ConstraintVT, CC);
    return Result;
}

fn X86TargetLowering::LowerAsmOperandForConstraint(self: *X86TargetLowering, Op: SDValue, Constraint: str, Ops: *mut []SDValue, DAG: *mut SelectionDAG) {
    let mut Result: SDValue = SDValue {};
    let mut ConstraintLetter: i8 = Constraint[0];
    match ConstraintLetter {
        _ => {
            break;
        },
        'I' => {
            if dyn_cast(Op) {
                C;
            } else {
                if C.getZExtValue() <= 31 {
                    Result = DAG.getTargetConstant(C.getZExtValue(), Op, Op.getValueType(), false);
                    break;
                }
            }
        },
        'J' => {
            if dyn_cast(Op) {
                C;
            } else {
                if C.getZExtValue() <= 63 {
                    Result = DAG.getTargetConstant(C.getZExtValue(), Op, Op.getValueType(), false);
                    break;
                }
            }
        },
        'K' => {
            if dyn_cast(Op) {
                C;
            } else {
                if isInt(C.getSExtValue()) {
                    Result = DAG.getTargetConstant(C.getZExtValue(), Op, Op.getValueType(), false);
                    break;
                }
            }
        },
        'L' => {
            if dyn_cast(Op) {
                C;
            } else {
                if C.getZExtValue() == 255 || C.getZExtValue() == 65535 || (self.Subtarget.is64Bit() && C.getZExtValue() == 4294967295) {
                    Result = DAG.getSignedTargetConstant(C.getSExtValue(), Op, Op.getValueType(), false);
                    break;
                }
            }
        },
        'M' => {
            if dyn_cast(Op) {
                C;
            } else {
                if C.getZExtValue() <= 3 {
                    Result = DAG.getTargetConstant(C.getZExtValue(), Op, Op.getValueType(), false);
                    break;
                }
            }
        },
        'N' => {
            if dyn_cast(Op) {
                C;
            } else {
                if C.getZExtValue() <= 255 {
                    Result = DAG.getTargetConstant(C.getZExtValue(), Op, Op.getValueType(), false);
                    break;
                }
            }
        },
        'O' => {
            if dyn_cast(Op) {
                C;
            } else {
                if C.getZExtValue() <= 127 {
                    Result = DAG.getTargetConstant(C.getZExtValue(), Op, Op.getValueType(), false);
                    break;
                }
            }
        },
        'e' => {
            if dyn_cast(Op) {
                C;
            } else {
                if isValueValidForType(getInt32Ty(*DAG.getContext()), C.getSExtValue()) {
                    Result = DAG.getSignedTargetConstant(C.getSExtValue(), Op, i64, false);
                    break;
                }
            }
            return;
        },
        'W' => {
            assert!(Constraint[1] == 's');
            if dyn_cast(Op) {
                BA;
            } else {
                Ops.push(DAG.getTargetBlockAddress(BA.getBlockAddress(), BA.getValueType(0), 0, 0));
            }
            return;
        },
        'Z' => {
            if dyn_cast(Op) {
                C;
            } else {
                if isValueValidForType(getInt32Ty(*DAG.getContext()), C.getZExtValue()) {
                    Result = DAG.getTargetConstant(C.getZExtValue(), Op, Op.getValueType(), false);
                    break;
                }
            }
            return;
        },
        'i' => {
            if dyn_cast(Op) {
                CST;
            } else {
                let mut IsBool: bool = CST.getConstantIntValue().getBitWidth() == 1;
                let mut BCont: BooleanContent = self.getBooleanContents(i64);
                let mut ExtOpc: NodeType = if IsBool { getExtendForContent(BCont) } else { SIGN_EXTEND };
                let mut DL: SDLoc = Op;
                Result = if ExtOpc == ZERO_EXTEND { DAG.getTargetConstant(CST.getZExtValue(), DL, i64, false) } else { DAG.getSignedTargetConstant(CST.getSExtValue(), DL, i64, false) };
                break;
            }
            if (self.Subtarget.isPICStyleGOT() || self.Subtarget.isPICStyleStubPIC()) && !(isa(Op) || isa(Op)) {
                return;
            }
            if dyn_cast(Op) {
                GA;
            } else if isGlobalStubReference(self.Subtarget.classifyGlobalReference(GA.getGlobal())) {
                return;
            }
            break;
        },
    }
    if Result.getNode() {
        Ops.push(Result);
        return;
    }
    return self.LowerAsmOperandForConstraint(Op, Constraint, Ops, DAG);
}

fn isGRClass(RC: *TargetRegisterClass) -> bool {
    return RC.hasSuperClassEq(&mut GR8RegClass) || RC.hasSuperClassEq(&mut GR16RegClass) || RC.hasSuperClassEq(&mut GR32RegClass) || RC.hasSuperClassEq(&mut GR64RegClass) || RC.hasSuperClassEq(&mut LOW32_ADDR_ACCESS_RBPRegClass);
}

fn isFRClass(RC: *TargetRegisterClass) -> bool {
    return RC.hasSuperClassEq(&mut FR16XRegClass) || RC.hasSuperClassEq(&mut FR32XRegClass) || RC.hasSuperClassEq(&mut FR64XRegClass) || RC.hasSuperClassEq(&mut VR128XRegClass) || RC.hasSuperClassEq(&mut VR256XRegClass) || RC.hasSuperClassEq(&mut VR512RegClass);
}

fn isVKClass(RC: *TargetRegisterClass) -> bool {
    return RC.hasSuperClassEq(&mut VK1RegClass) || RC.hasSuperClassEq(&mut VK2RegClass) || RC.hasSuperClassEq(&mut VK4RegClass) || RC.hasSuperClassEq(&mut VK8RegClass) || RC.hasSuperClassEq(&mut VK16RegClass) || RC.hasSuperClassEq(&mut VK32RegClass) || RC.hasSuperClassEq(&mut VK64RegClass);
}

fn useEGPRInlineAsm(Subtarget: *X86Subtarget) -> bool {
    return Subtarget.hasEGPR() && Subtarget.useInlineAsmGPR32();
}

fn X86TargetLowering::getRegForInlineAsmConstraint(self: *X86TargetLowering, TRI: *TargetRegisterInfo, Constraint: str, VT: MVT) -> pair<unsigned int, const TargetRegisterClass *> {
    if Constraint.len == 1 {
        match Constraint[0] {
            _ => {
                break;
            },
            'A' => {
                if self.Subtarget.is64Bit() {
                    return make_pair(RAX, &mut GR64_ADRegClass);
                }
            },
            'k' => {
                if self.Subtarget.hasAVX512() {
                    if VT == v1i1 || VT == i1 {
                        return make_pair(0, &mut VK1RegClass);
                    }
                    if VT == v8i1 || VT == i8 {
                        return make_pair(0, &mut VK8RegClass);
                    }
                    if VT == v16i1 || VT == i16 {
                        return make_pair(0, &mut VK16RegClass);
                    }
                }
            },
            'q' => {
                if self.Subtarget.is64Bit() {
                    if VT == i8 || VT == i1 {
                        return make_pair(0, if useEGPRInlineAsm(self.Subtarget) { &mut GR8RegClass } else { &mut GR8_NOREX2RegClass });
                    }
                    if VT == i16 {
                        return make_pair(0, if useEGPRInlineAsm(self.Subtarget) { &mut GR16RegClass } else { &mut GR16_NOREX2RegClass });
                    }
                    if VT == i32 || VT == f32 {
                        return make_pair(0, if useEGPRInlineAsm(self.Subtarget) { &mut GR32RegClass } else { &mut GR32_NOREX2RegClass });
                    }
                    if VT != f80 && !VT.isVector() && VT != Other {
                        return make_pair(0, if useEGPRInlineAsm(self.Subtarget) { &mut GR64RegClass } else { &mut GR64_NOREX2RegClass });
                    }
                    break;
                }
            },
            'Q' => {
                if VT == i8 || VT == i1 {
                    return make_pair(0, &mut GR8_ABCD_LRegClass);
                }
            },
            'r' => {
                'l';
            },
            'R' => {
                if VT == i8 || VT == i1 {
                    return make_pair(0, &mut GR8_NOREXRegClass);
                }
            },
            'f' => {
                if VT == f32 && !self.isScalarFPTypeInSSEReg(VT) {
                    return make_pair(0, &mut RFP32RegClass);
                }
            },
            'y' => {
                if !self.Subtarget.hasMMX() {
                    break;
                }
            },
            'v' => {
                'x';
            },
        }
    } else if Constraint.len == 2 && Constraint[0] == 'Y' {
        match Constraint[1] {
            _ => {
                break;
            },
            'i' => {
                't';
            },
            'm' => {
                if !self.Subtarget.hasMMX() {
                    break;
                }
            },
            'z' => {
                if !self.Subtarget.hasSSE1() {
                    break;
                }
            },
            'k' => {
                if self.Subtarget.hasAVX512() {
                    if VT == v1i1 || VT == i1 {
                        return make_pair(0, &mut VK1WMRegClass);
                    }
                    if VT == v8i1 || VT == i8 {
                        return make_pair(0, &mut VK8WMRegClass);
                    }
                    if VT == v16i1 || VT == i16 {
                        return make_pair(0, &mut VK16WMRegClass);
                    }
                }
            },
        }
    } else if Constraint.len == 2 && Constraint[0] == 'j' {
        match Constraint[1] {
            _ => {
                break;
            },
            'r' => {
                if VT == i8 || VT == i1 {
                    return make_pair(0, &mut GR8_NOREX2RegClass);
                }
            },
            'R' => {
                if VT == i8 || VT == i1 {
                    return make_pair(0, &mut GR8RegClass);
                }
            },
        }
    }
    if parseConstraintCode(Constraint) != COND_INVALID {
        return make_pair(0, &mut GR32RegClass);
    }
    let mut Res: pair<Register, const TargetRegisterClass *> = pair<Register, const TargetRegisterClass *> {};
    Res = self.getRegForInlineAsmConstraint(TRI, Constraint, VT);
    if !Res.second {
        if VT == Other || VT == f32 || VT == f64 || VT == f80 {
            if Constraint.len == 7 && Constraint[0] == '{' && tolower(Constraint[1]) == 's' && tolower(Constraint[2]) == 't' && Constraint[3] == '(' && (Constraint[4] >= '0' && Constraint[4] <= '7') && Constraint[5] == ')' && Constraint[6] == '}' {
                if Constraint[4] == '7' {
                    return make_pair(FP7, &mut RFP80_7RegClass);
                }
                return make_pair(FP0 + Constraint[4] - '0', &mut RFP80RegClass);
            }
            if "{st}".equals_insensitive(Constraint) {
                return make_pair(FP0, &mut RFP80RegClass);
            }
        }
        if "{flags}".equals_insensitive(Constraint) {
            return make_pair(EFLAGS, &mut CCRRegClass);
        }
        if "{dirflag}".equals_insensitive(Constraint) && VT == Other {
            return make_pair(DF, &mut DFCCRRegClass);
        }
        if "{fpsr}".equals_insensitive(Constraint) && VT == Other {
            return make_pair(FPSW, &mut FPCCRRegClass);
        }
        return Res;
    }
    if !self.Subtarget.is64Bit() && (isFRClass(*Res.second) || isGRClass(*Res.second)) && TRI.getEncodingValue(Res.first.operator MCRegister()) >= 8 {
        return make_pair(0, null);
    }
    if !self.Subtarget.hasAVX512() && isFRClass(*Res.second) && TRI.getEncodingValue(Res.first.operator MCRegister()) & 16 {
        return make_pair(0, null);
    }
    if TRI.isTypeLegalForClass(*Res.second, VT) || VT == Other {
        return Res;
    }
    let mut Class: *TargetRegisterClass = Res.second;
    if isGRClass(*Class) {
        let mut Size: u32 = VT.getSizeInBits().operator unsigned long long();
        if Size == 1 {
            Size = 8;
        }
        if Size != 8 && Size != 16 && Size != 32 && Size != 64 {
            return make_pair(0, null);
        }
        let mut DestReg: Register = getX86SubSuperRegister(Res.first.operator MCRegister(), Size, false);
        if DestReg.isValid() {
            let mut is64Bit: bool = self.Subtarget.is64Bit();
            let mut RC: *TargetRegisterClass = if Size == 8 { (if is64Bit { &mut GR8RegClass } else { &mut GR8_NOREXRegClass }) } else { if Size == 16 { (if is64Bit { &mut GR16RegClass } else { &mut GR16_NOREXRegClass }) } else { if Size == 32 { (if is64Bit { &mut GR32RegClass } else { &mut GR32_NOREXRegClass }) } else { (if is64Bit { &mut GR64RegClass } else { null }) } } };
            if Size == 64 && !is64Bit {
                match DestReg.operator unsigned int() {
                    RAX => {
                        return make_pair(EAX, &mut GR32_ADRegClass);
                    },
                    RDX => {
                        return make_pair(EDX, &mut GR32_DCRegClass);
                    },
                    RCX => {
                        return make_pair(ECX, &mut GR32_CBRegClass);
                    },
                    RBX => {
                        return make_pair(EBX, &mut GR32_BSIRegClass);
                    },
                    RSI => {
                        return make_pair(ESI, &mut GR32_SIDIRegClass);
                    },
                    RDI => {
                        return make_pair(EDI, &mut GR32_DIBPRegClass);
                    },
                    RBP => {
                        return make_pair(EBP, &mut GR32_BPSPRegClass);
                    },
                    _ => {
                        return make_pair(0, null);
                    },
                }
            }
            if RC && RC.contains(DestReg.operator MCRegister()) {
                return make_pair(DestReg, RC);
            }
            return Res;
        }
        return make_pair(0, null);
    } else if isFRClass(*Class) {
        if VT == f16 {
            Res.second = &mut FR16XRegClass;
        } else if VT == f32 || VT == i32 {
            Res.second = &mut FR32XRegClass;
        } else if VT == f64 || VT == i64 {
            Res.second = &mut FR64XRegClass;
        } else if TRI.isTypeLegalForClass(VR128XRegClass, VT) {
            Res.second = &mut VR128XRegClass;
        } else if TRI.isTypeLegalForClass(VR256XRegClass, VT) {
            Res.second = &mut VR256XRegClass;
        } else if TRI.isTypeLegalForClass(VR512RegClass, VT) {
            Res.second = &mut VR512RegClass;
        } else {
            Res.first = 0;
            Res.second = null;
        }
    } else if isVKClass(*Class) {
        if VT == v1i1 || VT == i1 {
            Res.second = &mut VK1RegClass;
        } else if VT == v8i1 || VT == i8 {
            Res.second = &mut VK8RegClass;
        } else if VT == v16i1 || VT == i16 {
            Res.second = &mut VK16RegClass;
        } else if VT == v32i1 || VT == i32 {
            Res.second = &mut VK32RegClass;
        } else if VT == v64i1 || VT == i64 {
            Res.second = &mut VK64RegClass;
        } else {
            Res.first = 0;
            Res.second = null;
        }
    }
    return Res;
}

fn X86TargetLowering::isIntDivCheap(self: *X86TargetLowering, VT: EVT, Attr: AttributeList) -> bool {
    let mut OptSize: bool = Attr.hasFnAttr(MinSize);
    return OptSize && !VT.isVector();
}

fn X86TargetLowering::initializeSplitCSR(self: *X86TargetLowering, Entry: *mut MachineBasicBlock) {
    if !self.Subtarget.is64Bit() {
        return;
    }
    let mut AFI: *mut X86MachineFunctionInfo = Entry.getParent().getInfo();
    AFI.setIsSplitCSR(true);
}

fn X86TargetLowering::insertCopiesSplitCSR(self: *X86TargetLowering, Entry: *mut MachineBasicBlock, Exits: *SmallVectorImpl<MachineBasicBlock *>) {
    let mut TRI: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut IStart: *MCPhysReg = TRI.getCalleeSavedRegsViaCopy(Entry.getParent());
    if !IStart {
        return;
    }
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MRI: *mut MachineRegisterInfo = &mut Entry.getParent().getRegInfo();
    let mut MBBI: iterator = Entry.begin();
    for let mut I: *MCPhysReg = IStart; *I; I += 1 {
        let mut RC: *TargetRegisterClass = null;
        if GR64RegClass.contains(*I) {
            RC = &mut GR64RegClass;
        } else {
            llvm_unreachable_internal("Unexpected register class in CSRsViaCopy!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 65499);
        }
        let mut NewVR: Register = MRI.createVirtualRegister(RC, "");
        assert!(Entry.getParent().getFunction().hasFnAttribute(NoUnwind), "Function should be nounwind in insertCopiesSplitCSR!");
        Entry.addLiveIn(*I, getAll());
        BuildMI(*Entry, MBBI, MIMetadata {}, TII.get(COPY), NewVR).addReg(*I, RegState {}, 0);
        for Exit in Exits {
            BuildMI(*Exit, Exit.getFirstTerminator(), MIMetadata {}, TII.get(COPY), *I).addReg(NewVR, RegState {}, 0);
        }
    }
}

fn X86TargetLowering::supportSwiftError(self: *X86TargetLowering) -> bool {
    return self.Subtarget.is64Bit();
}

fn X86TargetLowering::EmitKCFICheck(self: *X86TargetLowering, MBB: *mut MachineBasicBlock, MBBI: *mut instr_iterator, TII: *TargetInstrInfo) -> *mut MachineInstr {
    assert!(operator(MBBI).isCall(AnyInBundle) && operator(MBBI).getCFIType(), "Invalid call instruction for a KCFI check");
    let mut MF: *mut MachineFunction = *MBB.getParent();
    match operator(MBBI).getOpcode() {
        CALL64m => {
            CALL64m_NT;
        },
        _ => {
            break;
        },
    }
    let mut Target: *mut MachineOperand = operator(MBBI).getOperand(0);
    let mut TargetReg: Register = 0;
    match operator(MBBI).getOpcode() {
        CALL64r => {
            CALL64r_ImpCall;
        },
        CALL64pcrel32 => {
            TAILJMPd64;
        },
        _ => {
            llvm_unreachable_internal("Unexpected CFI call opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 65582);
        },
    }
    return BuildMI(MBB, MBBI, operator(MBBI), TII.get(KCFI_CHECK)).addReg(TargetReg, RegState {}, 0).addImm(operator(MBBI).getCFIType()).getInstr();
}

fn X86TargetLowering::hasStackProbeSymbol(self: *X86TargetLowering, MF: *MachineFunction) -> bool {
    return !self.getStackProbeSymbolName(MF).is_empty();
}

fn X86TargetLowering::hasInlineStackProbe(self: *X86TargetLowering, MF: *MachineFunction) -> bool {
    if self.Subtarget.isOSWindowsOrUEFI() || MF.getFunction().hasFnAttribute("no-stack-arg-probe") {
        return false;
    }
    if MF.getFunction().hasFnAttribute("probe-stack") {
        return MF.getFunction().getFnAttribute("probe-stack").getValueAsString() == "inline-asm";
    }
    return false;
}

fn X86TargetLowering::getStackProbeSymbolName(self: *X86TargetLowering, MF: *MachineFunction) -> str {
    if self.hasInlineStackProbe(MF) {
        return "";
    }
    if MF.getFunction().hasFnAttribute("probe-stack") {
        return MF.getFunction().getFnAttribute("probe-stack").getValueAsString();
    }
    if !self.Subtarget.isOSWindowsOrUEFI() || self.Subtarget.isTargetMachO() || MF.getFunction().hasFnAttribute("no-stack-arg-probe") {
        return "";
    }
    let mut StackProbeImpl: LibcallImpl = self.getLibcallImpl(STACK_PROBE);
    if StackProbeImpl == Unsupported {
        return "";
    }
    return getLibcallImplName(StackProbeImpl);
}

fn X86TargetLowering::getStackProbeSize(self: *X86TargetLowering, MF: *MachineFunction) -> u32 {
    return MF.getFunction().getFnAttributeAsParsedInteger("stack-probe-size", 4096);
}

fn X86TargetLowering::getPrefLoopAlignment(self: *X86TargetLowering, ML: *mut MachineLoop, BlockToAlign: *MachineBasicBlock) -> Align {
    if ML && ML.isInnermost() && ExperimentalPrefInnermostLoopAlignment.getNumOccurrences() {
        return 1 << ExperimentalPrefInnermostLoopAlignment.operator int();
    }
    return self.getPrefLoopAlignment(null, null);
}

