    for let mut CSI: u32 = 1; CSI <= MaxCSNum; CSI += 1 {}
    (((operator!(operator!((operator!() && "No landing pad destinations for the dispatch jump table!")))) || (_wassert(L"!LPadList.empty() && \"No landing pad destinations for the dispatch jump table!\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (38815) as u32) , 0)) as void);
    let mut DispatchBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(null, nullopt());
    DispatchBB.setIsEHPad(true);
