}

unsafe fn Closure_114::call(self: *mut Closure_114) -> bool {
            match (*self.RHS).getOpcode() {
                _ => {
                    break;
                },
                OR => {
                    XOR;
                },
                SHL => {
                    SRA;
                },
            }
            return false;
        }

struct Closure_115 {
