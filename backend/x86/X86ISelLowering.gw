}

unsafe fn Closure_113::call(self: *mut Closure_113, SplatVT: EVT) -> SDValue {
            let mut Neg: SDValue = (*self.CmpVal);
            if (*self.CmpVT).bitsGT(SplatVT) {
                Neg = (*self.DAG).getNode(TRUNCATE, (*self.DL), SplatVT, (*self.CmpVal));
            } else if (*self.CmpVT).bitsLT(SplatVT) {
                Neg = (*self.DAG).getNode(AND, (*self.DL), SplatVT, (*self.DAG).getNode(ANY_EXTEND, (*self.DL), SplatVT, (*self.CmpVal).getOperand(0)), (*self.DAG).getConstant(1, (*self.DL), SplatVT, false, false));
            }
            return (*self.DAG).getNegative(Neg, (*self.DL), SplatVT);
        }

struct Closure_114 {
