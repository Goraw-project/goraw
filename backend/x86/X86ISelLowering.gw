fn lowerShuffleAsPermuteAndUnpack(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
