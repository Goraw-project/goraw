fn getAVX512Node(Opcode: u32, DL: *SDLoc, VT: MVT, Ops: ArrayRef<SDValue>, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(Subtarget.hasAVX512(), "AVX512 target expected");
    let mut SVT: MVT = VT.getScalarType();
    let mut MakeBroadcastOp: Closure_13 = Closure_13 { DAG: &mut DAG, SVT: &mut SVT, DL: &mut DL };
    let mut Widen: bool = !(Subtarget.hasVLX() || VT.is512BitVector());
    let mut DstVT: MVT = VT;
    if Widen {
        DstVT = getVectorVT(SVT, 512 / SVT.getSizeInBits().operator unsigned long long());
    }
    let mut SrcOps: SmallVector<SDValue> = Ops;
    for Op in SrcOps {
        let mut OpVT: MVT = Op.getSimpleValueType();
        if !OpVT.isVector() {
            continue;
        }
        assert!(OpVT == VT, "Vector type mismatch");
        if MakeBroadcastOp.call(Op, OpVT, DstVT) {
            BroadcastOp;
        } else {
            Op = BroadcastOp;
            continue;
        }
        if Widen {
            Op = widenSubVector(Op, false, Subtarget, DAG, DL, 512);
        }
    }
    let mut Res: SDValue = DAG.getNode(Opcode, DL, DstVT, SrcOps);
    if Widen {
        Res = extractSubVector(Res, 0, DAG, DL, VT.getSizeInBits().operator unsigned long long());
    }
    return Res;
}

fn insert1BitVector(Op: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut dl: SDLoc = Op;
    let mut Vec: SDValue = Op.getOperand(0);
    let mut SubVec: SDValue = Op.getOperand(1);
    let mut Idx: SDValue = Op.getOperand(2);
    let mut IdxVal: u32 = Op.getConstantOperandVal(2);
    if SubVec.isUndef() {
        return Vec;
    }
    if IdxVal == 0 && Vec.isUndef() {
        return Op;
    }
    let mut OpVT: MVT = Op.getSimpleValueType();
    let mut NumElems: u32 = OpVT.getVectorNumElements();
    let mut ZeroIdx: SDValue = DAG.getVectorIdxConstant(0, dl, false);
    let mut WideOpVT: MVT = widenMaskVectorType(OpVT, Subtarget);
    if IdxVal == 0 && isBuildVectorAllZeros(Vec.getNode()) {
        Op = DAG.getNode(INSERT_SUBVECTOR, dl, WideOpVT, DAG.getConstant(0, dl, WideOpVT, false, false), SubVec, Idx);
        return DAG.getNode(EXTRACT_SUBVECTOR, dl, OpVT, Op, ZeroIdx);
    }
    let mut SubVecVT: MVT = SubVec.getSimpleValueType();
    let mut SubVecNumElems: u32 = SubVecVT.getVectorNumElements();
    assert!(IdxVal + SubVecNumElems <= NumElems && IdxVal % SubVecVT.getSizeInBits().operator unsigned long long() == 0, "Unexpected index value in INSERT_SUBVECTOR");
    let mut Undef: SDValue = DAG.getUNDEF(WideOpVT);
    if IdxVal == 0 {
        let mut ShiftBits: SDValue = DAG.getTargetConstant(SubVecNumElems, dl, i8, false);
        Vec = DAG.getNode(INSERT_SUBVECTOR, dl, WideOpVT, Undef, Vec, ZeroIdx);
        Vec = DAG.getNode(KSHIFTR, dl, WideOpVT, Vec, ShiftBits);
        Vec = DAG.getNode(KSHIFTL, dl, WideOpVT, Vec, ShiftBits);
        SubVec = DAG.getNode(INSERT_SUBVECTOR, dl, WideOpVT, DAG.getConstant(0, dl, WideOpVT, false, false), SubVec, ZeroIdx);
        Op = DAG.getNode(OR, dl, WideOpVT, Vec, SubVec);
        return DAG.getNode(EXTRACT_SUBVECTOR, dl, OpVT, Op, ZeroIdx);
    }
    SubVec = DAG.getNode(INSERT_SUBVECTOR, dl, WideOpVT, Undef, SubVec, ZeroIdx);
    if Vec.isUndef() {
        assert!(IdxVal != 0, "Unexpected index");
        SubVec = DAG.getNode(KSHIFTL, dl, WideOpVT, SubVec, DAG.getTargetConstant(IdxVal, dl, i8, false));
        return DAG.getNode(EXTRACT_SUBVECTOR, dl, OpVT, SubVec, ZeroIdx);
    }
    if isBuildVectorAllZeros(Vec.getNode()) {
        assert!(IdxVal != 0, "Unexpected index");
        if all_of(operator(Vec).ops().slice(IdxVal + SubVecNumElems), Closure_14 {}) {
            SubVec = DAG.getNode(KSHIFTL, dl, WideOpVT, SubVec, DAG.getTargetConstant(IdxVal, dl, i8, false));
        } else {
            NumElems = WideOpVT.getVectorNumElements();
            let mut ShiftLeft: u32 = NumElems - SubVecNumElems;
            let mut ShiftRight: u32 = NumElems - SubVecNumElems - IdxVal;
            SubVec = DAG.getNode(KSHIFTL, dl, WideOpVT, SubVec, DAG.getTargetConstant(ShiftLeft, dl, i8, false));
            if ShiftRight != 0 {
                SubVec = DAG.getNode(KSHIFTR, dl, WideOpVT, SubVec, DAG.getTargetConstant(ShiftRight, dl, i8, false));
            }
        }
        return DAG.getNode(EXTRACT_SUBVECTOR, dl, OpVT, SubVec, ZeroIdx);
    }
    if IdxVal + SubVecNumElems == NumElems {
        SubVec = DAG.getNode(KSHIFTL, dl, WideOpVT, SubVec, DAG.getTargetConstant(IdxVal, dl, i8, false));
        if SubVecNumElems * 2 == NumElems {
            Vec = DAG.getNode(EXTRACT_SUBVECTOR, dl, SubVecVT, Vec, ZeroIdx);
            Vec = DAG.getNode(INSERT_SUBVECTOR, dl, WideOpVT, DAG.getConstant(0, dl, WideOpVT, false, false), Vec, ZeroIdx);
        } else {
            Vec = DAG.getNode(INSERT_SUBVECTOR, dl, WideOpVT, Undef, Vec, ZeroIdx);
            NumElems = WideOpVT.getVectorNumElements();
            let mut ShiftBits: SDValue = DAG.getTargetConstant(NumElems - IdxVal, dl, i8, false);
            Vec = DAG.getNode(KSHIFTL, dl, WideOpVT, Vec, ShiftBits);
            Vec = DAG.getNode(KSHIFTR, dl, WideOpVT, Vec, ShiftBits);
        }
        Op = DAG.getNode(OR, dl, WideOpVT, Vec, SubVec);
        return DAG.getNode(EXTRACT_SUBVECTOR, dl, OpVT, Op, ZeroIdx);
    }
    NumElems = WideOpVT.getVectorNumElements();
    Vec = DAG.getNode(INSERT_SUBVECTOR, dl, WideOpVT, Undef, Vec, ZeroIdx);
    let mut ShiftLeft: u32 = NumElems - SubVecNumElems;
    let mut ShiftRight: u32 = NumElems - SubVecNumElems - IdxVal;
    if WideOpVT != v64i1 || Subtarget.is64Bit() {
        let mut Mask0: APInt = getBitsSet(NumElems, IdxVal, IdxVal + SubVecNumElems);
        Mask0.flipAllBits();
        let mut CMask0: SDValue = DAG.getConstant(Mask0, dl, getIntegerVT(NumElems), false, false);
        let mut VMask0: SDValue = DAG.getNode(BITCAST, dl, WideOpVT, CMask0);
        Vec = DAG.getNode(AND, dl, WideOpVT, Vec, VMask0);
        SubVec = DAG.getNode(KSHIFTL, dl, WideOpVT, SubVec, DAG.getTargetConstant(ShiftLeft, dl, i8, false));
        SubVec = DAG.getNode(KSHIFTR, dl, WideOpVT, SubVec, DAG.getTargetConstant(ShiftRight, dl, i8, false));
        Op = DAG.getNode(OR, dl, WideOpVT, Vec, SubVec);
        return DAG.getNode(EXTRACT_SUBVECTOR, dl, OpVT, Op, ZeroIdx);
    }
    SubVec = DAG.getNode(KSHIFTL, dl, WideOpVT, SubVec, DAG.getTargetConstant(ShiftLeft, dl, i8, false));
    SubVec = DAG.getNode(KSHIFTR, dl, WideOpVT, SubVec, DAG.getTargetConstant(ShiftRight, dl, i8, false));
    let mut LowShift: u32 = NumElems - IdxVal;
    let mut Low: SDValue = DAG.getNode(KSHIFTL, dl, WideOpVT, Vec, DAG.getTargetConstant(LowShift, dl, i8, false));
    Low = DAG.getNode(KSHIFTR, dl, WideOpVT, Low, DAG.getTargetConstant(LowShift, dl, i8, false));
    let mut HighShift: u32 = IdxVal + SubVecNumElems;
    let mut High: SDValue = DAG.getNode(KSHIFTR, dl, WideOpVT, Vec, DAG.getTargetConstant(HighShift, dl, i8, false));
    High = DAG.getNode(KSHIFTL, dl, WideOpVT, High, DAG.getTargetConstant(HighShift, dl, i8, false));
    Vec = DAG.getNode(OR, dl, WideOpVT, Low, High);
    SubVec = DAG.getNode(OR, dl, WideOpVT, SubVec, Vec);
    return DAG.getNode(EXTRACT_SUBVECTOR, dl, OpVT, SubVec, ZeroIdx);
}

fn concatSubVectors(V1: SDValue, V2: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!(V1.getValueType() == V2.getValueType(), "subvector type mismatch");
    let mut SubVT: EVT = V1.getValueType();
    let mut SubSVT: EVT = SubVT.getScalarType();
    let mut SubNumElts: u32 = SubVT.getVectorNumElements();
    let mut SubVectorWidth: u32 = SubVT.getSizeInBits().operator unsigned long long();
    let mut VT: EVT = getVectorVT(*DAG.getContext(), SubSVT, 2 * SubNumElts, false);
    let mut V: SDValue = insertSubVector(DAG.getUNDEF(VT), V1, 0, DAG, dl, SubVectorWidth);
    return insertSubVector(V, V2, SubNumElts, DAG, dl, SubVectorWidth);
}

fn getOnesVector(VT: EVT, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!((VT.is128BitVector() || VT.is256BitVector() || VT.is512BitVector()), "Expected a 128/256/512-bit vector type");
    let mut NumElts: u32 = VT.getSizeInBits().operator unsigned long long() / 32;
    let mut Vec: SDValue = DAG.getAllOnesConstant(dl, getVectorVT(i32, NumElts), false, false);
    return DAG.getBitcast(VT, Vec);
}

fn getTargetVShiftUniformOpcode(Opc: u32, IsVariable: bool) -> u32 {
    match Opc {
        SHL => {
            VSHL;
        },
        SRL => {
            VSRL;
        },
        SRA => {
            VSRA;
        },
    }
    llvm_unreachable_internal("Unknown target vector shift node", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 5100);
}

fn getTargetVShiftByConstNode(Opc: u32, dl: *SDLoc, VT: MVT, SrcOp: SDValue, ShiftAmt: u64, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Opc == VSHLI || Opc == VSRLI || Opc == VSRAI), "Unknown target vector shift-by-constant node");
    SrcOp = DAG.getBitcast(VT, SrcOp);
    if ShiftAmt == 0 {
        return SrcOp;
    }
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    if ShiftAmt >= EltSizeInBits {
        if Opc == VSRAI {
            ShiftAmt = EltSizeInBits - 1;
        } else {
            return DAG.getConstant(0, dl, VT, false, false);
        }
    }
    if isBuildVectorOfConstantSDNodes(SrcOp.getNode()) {
        let mut ShiftOpc: u32 = 0;
        match Opc {
            _ => {
                llvm_unreachable_internal("Unknown opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 5135);
            },
            VSHLI => {
                ShiftOpc = SHL;
            },
            VSRLI => {
                ShiftOpc = SRL;
            },
            VSRAI => {
                ShiftOpc = SRA;
            },
        }
        let mut Amt: SDValue = DAG.getConstant(ShiftAmt, dl, VT, false, false);
        if DAG.FoldConstantArithmetic(ShiftOpc, dl, VT, [SrcOp, Amt], SDNodeFlags { Flags: None }) {
            C;
        } else {
            return C;
        }
    }
    return DAG.getNode(Opc, dl, VT, SrcOp, DAG.getTargetConstant(ShiftAmt, dl, i8, false));
}

fn getTargetVShiftNode(Opc: u32, dl: *SDLoc, VT: MVT, SrcOp: SDValue, ShAmt: SDValue, ShAmtIdx: i32, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut AmtVT: MVT = ShAmt.getSimpleValueType();
    assert!(AmtVT.isVector(), "Vector shift type mismatch");
    assert!(0 <= ShAmtIdx && ShAmtIdx < AmtVT.getVectorNumElements() as i32, "Illegal vector splat index");
    if ShAmtIdx != 0 {
        let mut Mask: SmallVector<int> = SmallVector<int> { AmtVT.getVectorNumElements(), -1 };
        Mask[0] = ShAmtIdx;
        ShAmt = DAG.getVectorShuffle(AmtVT, dl, ShAmt, DAG.getUNDEF(AmtVT), Mask);
    }
    if AmtVT.getScalarSizeInBits() == 64 && (ShAmt.getOpcode() == ZERO_EXTEND || ShAmt.getOpcode() == ZERO_EXTEND_VECTOR_INREG) && ShAmt.getOperand(0).getValueType().isSimple() && ShAmt.getOperand(0).getValueType().is128BitVector() {
        ShAmt = ShAmt.getOperand(0);
        AmtVT = ShAmt.getSimpleValueType();
    }
    let mut IsMasked: bool = false;
    if AmtVT.getScalarSizeInBits() < 64 {
        if ShAmt.getOpcode() == BUILD_VECTOR || ShAmt.getOpcode() == SCALAR_TO_VECTOR {
            ShAmt = DAG.getZExtOrTrunc(ShAmt.getOperand(0), dl, i32);
            ShAmt = DAG.getNode(SCALAR_TO_VECTOR, dl, v4i32, ShAmt);
            ShAmt = DAG.getNode(VZEXT_MOVL, dl, v4i32, ShAmt);
            AmtVT = v4i32;
            IsMasked = true;
        } else if ShAmt.getOpcode() == AND {
            let mut MaskElts: SmallVector<SDValue> = SmallVector<SDValue> { AmtVT.getVectorNumElements(), DAG.getConstant(0, dl, AmtVT.getScalarType(), false, false) };
            MaskElts[0] = DAG.getAllOnesConstant(dl, AmtVT.getScalarType(), false, false);
            let mut Mask: SDValue = DAG.getBuildVector(AmtVT, dl, MaskElts);
            if (Mask = DAG.FoldConstantArithmetic(AND, dl, AmtVT, [ShAmt.getOperand(1), Mask], SDNodeFlags { Flags: None })) {
                ShAmt = DAG.getNode(AND, dl, AmtVT, ShAmt.getOperand(0), Mask);
                IsMasked = true;
            }
        }
    }
    if AmtVT.getSizeInBits().operator unsigned long long() > 128 {
        ShAmt = extract128BitVector(ShAmt, 0, DAG, dl);
        AmtVT = ShAmt.getSimpleValueType();
    }
    if !IsMasked && AmtVT.getScalarSizeInBits() < 64 {
        if AmtVT == v4i32 && (ShAmt.getOpcode() == VBROADCAST || ShAmt.getOpcode() == VBROADCAST_LOAD) {
            ShAmt = DAG.getNode(VZEXT_MOVL, ShAmt, v4i32, ShAmt);
        } else if Subtarget.hasSSE41() {
            ShAmt = DAG.getNode(ZERO_EXTEND_VECTOR_INREG, ShAmt, v2i64, ShAmt);
        } else {
            let mut ByteShift: SDValue = DAG.getTargetConstant((128 - AmtVT.getScalarSizeInBits()) / 8, ShAmt, i8, false);
            ShAmt = DAG.getBitcast(v16i8, ShAmt);
            ShAmt = DAG.getNode(VSHLDQ, ShAmt, v16i8, ShAmt, ByteShift);
            ShAmt = DAG.getNode(VSRLDQ, ShAmt, v16i8, ShAmt, ByteShift);
        }
    }
    Opc = getTargetVShiftUniformOpcode(Opc, true);
    let mut EltVT: MVT = VT.getVectorElementType();
    let mut ShVT: MVT = getVectorVT(EltVT, 128 / EltVT.getSizeInBits().operator unsigned long long());
    ShAmt = DAG.getBitcast(ShVT, ShAmt);
    return DAG.getNode(Opc, dl, VT, SrcOp, ShAmt);
}

fn getEXTEND_VECTOR_INREG(Opcode: u32, DL: *SDLoc, VT: EVT, In: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut InVT: EVT = In.getValueType();
    assert!(VT.isVector() && InVT.isVector(), "Expected vector VTs.");
    match Opcode {
        ANY_EXTEND => {
            ANY_EXTEND_VECTOR_INREG;
        },
        SIGN_EXTEND => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        ZERO_EXTEND => {
            ZERO_EXTEND_VECTOR_INREG;
        },
        _ => {
            llvm_unreachable_internal("Unknown extension opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 5272);
        },
    }
    if InVT.getSizeInBits().operator unsigned long long() > 128 {
        assert!(VT.getSizeInBits() == InVT.getSizeInBits(), "Expected VTs to be the same size!");
        let mut Scale: u32 = VT.getScalarSizeInBits() / InVT.getScalarSizeInBits();
        In = extractSubVector(In, 0, DAG, DL, if 128 > VT.getSizeInBits().operator unsigned long long() as u32 / Scale { 128 } else { VT.getSizeInBits().operator unsigned long long() as u32 / Scale });
        InVT = In.getValueType();
    }
    if VT.getVectorNumElements() != InVT.getVectorNumElements() {
        Opcode = DAG.getOpcode_EXTEND_VECTOR_INREG(Opcode);
    }
    return DAG.getNode(Opcode, DL, VT, In);
}

fn getBitSelect(DL: *SDLoc, VT: MVT, LHS: SDValue, RHS: SDValue, Mask: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    LHS = DAG.getNode(AND, DL, VT, LHS, Mask);
    RHS = DAG.getNode(ANDNP, DL, VT, Mask, RHS);
    return DAG.getNode(OR, DL, VT, LHS, RHS);
}

fn createUnpackShuffleMask(VT: EVT, Mask: *mut SmallVectorImpl<int>, Lo: bool, Unary: bool) {
    assert!(VT.getScalarType().isSimple() && (VT.getSizeInBits().operator unsigned long long() % 128) == 0, "Illegal vector type to unpack");
    assert!(Mask.is_empty(), "Expected an empty shuffle mask vector");
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut NumEltsInLane: i32 = 128 / VT.getScalarSizeInBits();
    for let mut i: i32 = 0; i < NumElts; i += 1 {
        let mut LaneStart: u32 = (i / NumEltsInLane) * NumEltsInLane;
        let mut Pos: i32 = (i % NumEltsInLane) / 2 + LaneStart;
        Pos += (if Unary { 0 } else { NumElts * (i % 2) });
        Pos += (if Lo { 0 } else { NumEltsInLane / 2 });
        Mask.push(Pos);
    }
}

fn createSplat2ShuffleMask(VT: MVT, Mask: *mut SmallVectorImpl<int>, Lo: bool) {
    assert!(Mask.is_empty(), "Expected an empty shuffle mask vector");
    let mut NumElts: i32 = VT.getVectorNumElements();
    for let mut i: i32 = 0; i < NumElts; i += 1 {
        let mut Pos: i32 = i / 2;
        Pos += (if Lo { 0 } else { NumElts / 2 });
        Mask.push(Pos);
    }
}

fn getVectorShuffle(DAG: *mut SelectionDAG, VT: EVT, dl: *SDLoc, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>) -> SDValue {
    if (isBuildVectorOfConstantSDNodes(V1.getNode()) || V1.isUndef()) && (isBuildVectorOfConstantSDNodes(V2.getNode()) || V2.isUndef()) {
        let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> { Mask.len, DAG.getUNDEF(VT.getScalarType()) };
        for let mut I: i32 = 0;
let mut NumElts: i32 = Mask.len; I != NumElts; I += 1 {
            let mut M: i32 = Mask[I];
            if M < 0 {
                continue;
            }
            let mut V: SDValue = if (M < NumElts) { V1 } else { V2 };
            if V.isUndef() {
                continue;
            }
            Ops[I] = V.getOperand(M % NumElts);
        }
        return DAG.getBuildVector(VT, dl, Ops);
    }
    return DAG.getVectorShuffle(VT, dl, V1, V2, Mask);
}

fn getUnpack(DAG: *mut SelectionDAG, dl: *SDLoc, VT: EVT, V1: SDValue, V2: SDValue, UnpackHiHalf: bool) -> SDValue {
    let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> {};
    createUnpackShuffleMask(VT, Mask, !UnpackHiHalf, false);
    return getVectorShuffle(DAG, VT, dl, V1, V2, Mask);
}

fn getUnpackl(DAG: *mut SelectionDAG, dl: *SDLoc, VT: EVT, V1: SDValue, V2: SDValue) -> SDValue {
    return getUnpack(DAG, dl, VT, V1, V2, false);
}

fn getUnpackh(DAG: *mut SelectionDAG, dl: *SDLoc, VT: EVT, V1: SDValue, V2: SDValue) -> SDValue {
    return getUnpack(DAG, dl, VT, V1, V2, true);
}

fn getPack(DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, dl: *SDLoc, VT: MVT, LHS: SDValue, RHS: SDValue, PackHiHalf: bool) -> SDValue {
    let mut OpVT: MVT = LHS.getSimpleValueType();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut UsePackUS: bool = Subtarget.hasSSE41() || EltSizeInBits == 8;
    assert!(OpVT == RHS.getSimpleValueType() && VT.getSizeInBits() == OpVT.getSizeInBits() && (EltSizeInBits * 2) == OpVT.getScalarSizeInBits(), "Unexpected PACK operand types");
    assert!((EltSizeInBits == 8 || EltSizeInBits == 16 || EltSizeInBits == 32), "Unexpected PACK result type");
    if EltSizeInBits == 32 {
        let mut PackMask: SmallVector<int> = SmallVector<int> {};
        let mut Offset: i32 = if PackHiHalf { 1 } else { 0 };
        let mut NumElts: i32 = VT.getVectorNumElements();
        for let mut I: i32 = 0; I != NumElts; I += 4 {
            PackMask.push(I + Offset);
            PackMask.push(I + Offset + 2);
            PackMask.push(I + Offset + NumElts);
            PackMask.push(I + Offset + NumElts + 2);
        }
        return DAG.getVectorShuffle(VT, dl, DAG.getBitcast(VT, LHS), DAG.getBitcast(VT, RHS), PackMask);
    }
    if !PackHiHalf {
        if UsePackUS && DAG.computeKnownBits(LHS, 0).countMaxActiveBits() <= EltSizeInBits && DAG.computeKnownBits(RHS, 0).countMaxActiveBits() <= EltSizeInBits {
            return DAG.getNode(PACKUS, dl, VT, LHS, RHS);
        }
        if DAG.ComputeMaxSignificantBits(LHS, 0) <= EltSizeInBits && DAG.ComputeMaxSignificantBits(RHS, 0) <= EltSizeInBits {
            return DAG.getNode(PACKSS, dl, VT, LHS, RHS);
        }
    }
    let mut Amt: SDValue = DAG.getTargetConstant(EltSizeInBits, dl, i8, false);
    if UsePackUS {
        if PackHiHalf {
            LHS = DAG.getNode(VSRLI, dl, OpVT, LHS, Amt);
            RHS = DAG.getNode(VSRLI, dl, OpVT, RHS, Amt);
        } else {
            let mut Mask: SDValue = DAG.getConstant((1 << EltSizeInBits) - 1, dl, OpVT, false, false);
            LHS = DAG.getNode(AND, dl, OpVT, LHS, Mask);
            RHS = DAG.getNode(AND, dl, OpVT, RHS, Mask);
        }
        return DAG.getNode(PACKUS, dl, VT, LHS, RHS);
    }
    if !PackHiHalf {
        LHS = DAG.getNode(VSHLI, dl, OpVT, LHS, Amt);
        RHS = DAG.getNode(VSHLI, dl, OpVT, RHS, Amt);
    }
    LHS = DAG.getNode(VSRAI, dl, OpVT, LHS, Amt);
    RHS = DAG.getNode(VSRAI, dl, OpVT, RHS, Amt);
    return DAG.getNode(PACKSS, dl, VT, LHS, RHS);
}

fn getShuffleVectorZeroOrUndef(V2: SDValue, Idx: i32, IsZero: bool, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = V2.getSimpleValueType();
    let mut V1: SDValue = if IsZero { getZeroVector(VT, Subtarget, DAG, V2) } else { DAG.getUNDEF(VT) };
    let mut NumElems: i32 = VT.getVectorNumElements();
    let mut MaskVec: SmallVector<int, 16> = NumElems;
    for let mut i: i32 = 0; i != NumElems; i += 1 {
        MaskVec[i] = if (i == Idx) { NumElems } else { i };
    }
    return DAG.getVectorShuffle(VT, V2, V1, V2, MaskVec);
}

fn getTargetConstantPoolFromBasePtr(Ptr: SDValue) -> *mut ConstantPoolSDNode {
    if Ptr.getOpcode() == Wrapper || Ptr.getOpcode() == WrapperRIP {
        Ptr = Ptr.getOperand(0);
    }
    return dyn_cast(Ptr);
}

fn getTargetConstantFromBasePtr(Ptr: SDValue) -> *Constant {
    let mut CNode: *mut ConstantPoolSDNode = getTargetConstantPoolFromBasePtr(Ptr);
    if !CNode || CNode.isMachineConstantPoolEntry() || CNode.getOffset() != 0 {
        return null;
    }
    return CNode.getConstVal();
}

fn getTargetConstantFromNode(Load: *mut LoadSDNode) -> *Constant {
    if !Load || !isNormalLoad(Load) {
        return null;
    }
    return getTargetConstantFromBasePtr(Load.getBasePtr());
}

fn getTargetConstantFromNode(Op: SDValue) -> *Constant {
    Op = peekThroughBitcasts(Op);
    return getTargetConstantFromNode(dyn_cast(Op));
}

fn X86TargetLowering::getTargetConstantFromLoad(self: *X86TargetLowering, LD: *mut LoadSDNode) -> *Constant {
    assert!(LD, "Unexpected null LoadSDNode");
    return getTargetConstantFromNode(LD);
}

fn X86TargetLowering::isTargetCanonicalSelect(self: *X86TargetLowering, N: *mut SDNode) -> bool {
    let mut Cond: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(2);
    let mut CondVT: EVT = Cond.getValueType();
    return N.getOpcode() == VSELECT && self.Subtarget.hasAVX512() && CondVT.getVectorElementType() == i1 && isBuildVectorAllZeros(RHS.getNode());
}

fn getTargetConstantBitsFromNode(Op: SDValue, EltSizeInBits: u32, UndefElts: *mut APInt, EltBits: *mut SmallVectorImpl<APInt>, AllowWholeUndefs: bool, AllowPartialUndefs: bool) -> bool {
    assert!(EltBits.is_empty(), "Expected an empty EltBits vector");
    Op = peekThroughBitcasts(Op);
    let mut VT: EVT = Op.getValueType();
    let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut NumElts: u32 = SizeInBits / EltSizeInBits;
    if (SizeInBits % EltSizeInBits) != 0 {
        return false;
    }
    let mut CastBitData: Closure_15 = Closure_15 { SizeInBits: &mut SizeInBits, AllowWholeUndefs: &mut AllowWholeUndefs, AllowPartialUndefs: &mut AllowPartialUndefs, NumElts: &mut NumElts, UndefElts: &mut UndefElts, EltBits: &mut EltBits, EltSizeInBits: &mut EltSizeInBits };
    let mut CollectConstantBits: Closure_16 = Closure_16 {};
    if Op.isUndef() {
        let mut UndefSrcElts: APInt = getAllOnes(NumElts);
        let mut SrcEltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> { NumElts, APInt { EltSizeInBits, 0, false, false } };
        return CastBitData.call(UndefSrcElts, SrcEltBits);
    }
    if dyn_cast(Op) {
        Cst;
    } else {
        let mut UndefSrcElts: APInt = getZero(1);
        let mut SrcEltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> { 1, Cst.getAPIntValue() };
        return CastBitData.call(UndefSrcElts, SrcEltBits);
    }
    if dyn_cast(Op) {
        Cst;
    } else {
        let mut UndefSrcElts: APInt = getZero(1);
        let mut RawBits: APInt = Cst.getValueAPF().bitcastToAPInt();
        let mut SrcEltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> { 1, RawBits };
        return CastBitData.call(UndefSrcElts, SrcEltBits);
    }
    if dyn_cast(Op) {
        BV;
    } else {
        let mut Undefs: BitVector = BitVector {};
        let mut SrcEltBits: SmallVector<APInt> = SmallVector<APInt> {};
        let mut SrcEltSizeInBits: u32 = VT.getScalarSizeInBits();
        if BV.getConstantRawBits(true, SrcEltSizeInBits, SrcEltBits, Undefs) {
            let mut UndefSrcElts: APInt = getZero(SrcEltBits.len);
            for let mut I: u32 = 0;
let mut E: u32 = SrcEltBits.len; I != E; I += 1 {
                if Undefs[I] {
                    UndefSrcElts.setBit(I);
                }
            }
            return CastBitData.call(UndefSrcElts, SrcEltBits);
        }
    }
    if getTargetConstantFromNode(Op) {
        Cst;
    } else {
        let mut CstTy: *mut Type = Cst.getType();
        let mut CstSizeInBits: u32 = CstTy.getPrimitiveSizeInBits().operator unsigned long long();
        if !CstTy.isVectorTy() || (CstSizeInBits % SizeInBits) != 0 {
            return false;
        }
        let mut SrcEltSizeInBits: u32 = CstTy.getScalarSizeInBits();
        let mut NumSrcElts: u32 = SizeInBits / SrcEltSizeInBits;
        if (SizeInBits % SrcEltSizeInBits) != 0 {
            return false;
        }
        let mut UndefSrcElts: APInt = APInt { NumSrcElts, 0, false, false };
        let mut SrcEltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> { NumSrcElts, APInt { SrcEltSizeInBits, 0, false, false } };
        for let mut i: u32 = 0; i != NumSrcElts; i += 1 {
            if !CollectConstantBits.call(Cst.getAggregateElement(i), SrcEltBits[i], UndefSrcElts, i) {
                return false;
            }
        }
        return CastBitData.call(UndefSrcElts, SrcEltBits);
    }
    if Op.getOpcode() == VBROADCAST_LOAD && EltSizeInBits <= VT.getScalarSizeInBits() {
        let mut MemIntr: *mut MemIntrinsicSDNode = cast(Op);
        if MemIntr.getMemoryVT().getStoreSizeInBits().operator unsigned long long() != VT.getScalarSizeInBits() {
            return false;
        }
        let mut Ptr: SDValue = MemIntr.getBasePtr();
        if getTargetConstantFromBasePtr(Ptr) {
            C;
        } else {
            let mut SrcEltSizeInBits: u32 = VT.getScalarSizeInBits();
            let mut NumSrcElts: u32 = SizeInBits / SrcEltSizeInBits;
            let mut UndefSrcElts: APInt = APInt { NumSrcElts, 0, false, false };
            let mut SrcEltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> { 1, APInt { SrcEltSizeInBits, 0, false, false } };
            if CollectConstantBits.call(C, SrcEltBits[0], UndefSrcElts, 0) {
                if UndefSrcElts[0] {
                    UndefSrcElts.setBits(0, NumSrcElts);
                }
                if SrcEltBits[0].getBitWidth() != SrcEltSizeInBits {
                    SrcEltBits[0] = SrcEltBits[0].trunc(SrcEltSizeInBits);
                }
                SrcEltBits.append(NumSrcElts - 1, SrcEltBits[0]);
                return CastBitData.call(UndefSrcElts, SrcEltBits);
            }
        }
    }
    if Op.getOpcode() == SUBV_BROADCAST_LOAD {
        let mut MemIntr: *mut MemIntrinsicSDNode = cast(Op);
        let mut Ptr: SDValue = MemIntr.getBasePtr();
        if getTargetConstantFromBasePtr(Ptr) {
            Cst;
        } else {
            let mut CstTy: *mut Type = Cst.getType();
            let mut CstSizeInBits: u32 = CstTy.getPrimitiveSizeInBits().operator unsigned long long();
            let mut SubVecSizeInBits: u32 = MemIntr.getMemoryVT().getStoreSizeInBits().operator unsigned long long();
            if !CstTy.isVectorTy() || (CstSizeInBits % SubVecSizeInBits) != 0 || (SizeInBits % SubVecSizeInBits) != 0 {
                return false;
            }
            let mut CstEltSizeInBits: u32 = CstTy.getScalarSizeInBits();
            let mut NumSubElts: u32 = SubVecSizeInBits / CstEltSizeInBits;
            let mut NumSubVecs: u32 = SizeInBits / SubVecSizeInBits;
            let mut UndefSubElts: APInt = APInt { NumSubElts, 0, false, false };
            let mut SubEltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> { NumSubElts * NumSubVecs, APInt { CstEltSizeInBits, 0, false, false } };
            for let mut i: u32 = 0; i != NumSubElts; i += 1 {
                if !CollectConstantBits.call(Cst.getAggregateElement(i), SubEltBits[i], UndefSubElts, i) {
                    return false;
                }
                for let mut j: u32 = 1; j != NumSubVecs; j += 1 {
                    SubEltBits[i + (j * NumSubElts)] = SubEltBits[i];
                }
            }
            UndefSubElts = getSplat(NumSubVecs * UndefSubElts.getBitWidth(), UndefSubElts);
            return CastBitData.call(UndefSubElts, SubEltBits);
        }
    }
    if Op.getOpcode() == VZEXT_MOVL && Op.getOperand(0).getOpcode() == SCALAR_TO_VECTOR && isa(Op.getOperand(0).getOperand(0)) {
        let mut SrcEltSizeInBits: u32 = VT.getScalarSizeInBits();
        let mut NumSrcElts: u32 = SizeInBits / SrcEltSizeInBits;
        let mut UndefSrcElts: APInt = APInt { NumSrcElts, 0, false, false };
        let mut SrcEltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> {};
        let mut C: *APInt = Op.getOperand(0).getConstantOperandAPInt(0);
        SrcEltBits.push(C.zextOrTrunc(SrcEltSizeInBits));
        SrcEltBits.append(NumSrcElts - 1, APInt { SrcEltSizeInBits, 0, false, false });
        return CastBitData.call(UndefSrcElts, SrcEltBits);
    }
    if Op.getOpcode() == INSERT_SUBVECTOR {
        let mut SrcEltSizeInBits: u32 = VT.getScalarSizeInBits();
        let mut AllowUndefs: bool = EltSizeInBits >= SrcEltSizeInBits;
        let mut UndefSrcElts: APInt = APInt {};
        let mut UndefSubElts: APInt = APInt {};
        let mut EltSrcBits: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
        let mut EltSubBits: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
        if getTargetConstantBitsFromNode(Op.getOperand(1), SrcEltSizeInBits, UndefSubElts, EltSubBits, AllowWholeUndefs && AllowUndefs, AllowPartialUndefs && AllowUndefs) && getTargetConstantBitsFromNode(Op.getOperand(0), SrcEltSizeInBits, UndefSrcElts, EltSrcBits, AllowWholeUndefs && AllowUndefs, AllowPartialUndefs && AllowUndefs) {
            let mut BaseIdx: u32 = Op.getConstantOperandVal(2);
            UndefSrcElts.insertBits(UndefSubElts, BaseIdx);
            for let mut i: u32 = 0;
let mut e: u32 = EltSubBits.len; i != e; i += 1 {
                EltSrcBits[BaseIdx + i] = EltSubBits[i];
            }
            return CastBitData.call(UndefSrcElts, EltSrcBits);
        }
    }
    if Op.getOpcode() == EXTRACT_SUBVECTOR && getTargetConstantBitsFromNode(Op.getOperand(0), EltSizeInBits, UndefElts, EltBits, AllowWholeUndefs, AllowPartialUndefs) {
        let mut SrcVT: EVT = Op.getOperand(0).getValueType();
        let mut NumSrcElts: u32 = SrcVT.getSizeInBits().operator unsigned long long() / EltSizeInBits;
        let mut NumSubElts: u32 = VT.getSizeInBits().operator unsigned long long() / EltSizeInBits;
        let mut BaseOfs: u32 = Op.getConstantOperandVal(1) * VT.getScalarSizeInBits();
        let mut BaseIdx: u32 = BaseOfs / EltSizeInBits;
        assert!((SrcVT.getSizeInBits().operator unsigned long long() % EltSizeInBits) == 0 && (VT.getSizeInBits().operator unsigned long long() % EltSizeInBits) == 0 && (BaseOfs % EltSizeInBits) == 0, "Bad subvector index");
        UndefElts = UndefElts.extractBits(NumSubElts, BaseIdx);
        if (BaseIdx + NumSubElts) != NumSrcElts {
            EltBits.erase(EltBits.begin() + BaseIdx + NumSubElts, EltBits.end());
        }
        if BaseIdx != 0 {
            EltBits.erase(EltBits.begin(), EltBits.begin() + BaseIdx);
        }
        return true;
    }
    if dyn_cast(Op) {
        SVN;
    } else {
        if EltSizeInBits != VT.getScalarSizeInBits() {
            return false;
        }
        let mut Mask: ArrayRef<int> = SVN.getMask();
        if (!AllowWholeUndefs || !AllowPartialUndefs) && any_of(Mask, Closure_17 {}) {
            return false;
        }
        let mut UndefElts0: APInt = APInt {};
        let mut UndefElts1: APInt = APInt {};
        let mut EltBits0: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
        let mut EltBits1: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
        if isAnyInRange(Mask, 0, NumElts) && !getTargetConstantBitsFromNode(Op.getOperand(0), EltSizeInBits, UndefElts0, EltBits0, AllowWholeUndefs, AllowPartialUndefs) {
            return false;
        }
        if isAnyInRange(Mask, NumElts, 2 * NumElts) && !getTargetConstantBitsFromNode(Op.getOperand(1), EltSizeInBits, UndefElts1, EltBits1, AllowWholeUndefs, AllowPartialUndefs) {
            return false;
        }
        UndefElts = getZero(NumElts);
        for let mut i: i32 = 0; i != NumElts as i32; i += 1 {
            let mut M: i32 = Mask[i];
            if M < 0 {
                UndefElts.setBit(i);
                EltBits.push(getZero(EltSizeInBits));
            } else if M < NumElts as i32 {
                if UndefElts0[M] {
                    UndefElts.setBit(i);
                }
                EltBits.push(EltBits0[M]);
            } else {
                if UndefElts1[M - NumElts] {
                    UndefElts.setBit(i);
                }
                EltBits.push(EltBits1[M - NumElts]);
            }
        }
        return true;
    }
    return false;
}

fn isConstantSplat(Op: SDValue, SplatVal: *mut APInt, AllowPartialUndefs: bool) -> bool {
    let mut UndefElts: APInt = APInt {};
    let mut EltBits: SmallVector<APInt, 16> = SmallVector<APInt, 16> {};
    if getTargetConstantBitsFromNode(Op, Op.getScalarValueSizeInBits(), UndefElts, EltBits, true, AllowPartialUndefs) {
        let mut SplatIndex: i32 = -1;
        for let mut i: i32 = 0;
let mut e: i32 = EltBits.len; i != e; i += 1 {
            if UndefElts[i] {
                continue;
            }
            if 0 <= SplatIndex && EltBits[i] != EltBits[SplatIndex] {
                SplatIndex = -1;
                break;
            }
            SplatIndex = i;
        }
        if 0 <= SplatIndex {
            SplatVal = EltBits[SplatIndex];
            return true;
        }
    }
    return false;
}

fn getRoundingModeX86(RM: u32) -> i32 {
    match RM as RoundingMode {
        NearestTiesToEven => {
            return rmToNearest;
        },
        TowardNegative => {
            return rmDownward;
        },
        TowardPositive => {
            return rmUpward;
        },
        TowardZero => {
            return rmTowardZero;
        },
        _ => {
            return rmInvalid;
        },
    }
}

fn getTargetShuffleMaskIndices(MaskNode: SDValue, MaskEltSizeInBits: u32, RawMask: *mut SmallVectorImpl<uint64_t>, UndefElts: *mut APInt) -> bool {
    let mut EltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> {};
    if !getTargetConstantBitsFromNode(MaskNode, MaskEltSizeInBits, UndefElts, EltBits, true, false) {
        return false;
    }
    for Elt in EltBits {
        RawMask.push(Elt.getZExtValue());
    }
    return true;
}

fn isConstantPowerOf2(V: SDValue, EltSizeInBIts: u32, AllowUndefs: bool) -> bool {
    let mut UndefElts: APInt = APInt {};
    let mut EltBits: SmallVector<APInt, 64> = SmallVector<APInt, 64> {};
    if !getTargetConstantBitsFromNode(V, EltSizeInBIts, UndefElts, EltBits, AllowUndefs, false) {
        return false;
    }
    let mut IsPow2OrUndef: bool = true;
    for let mut I: u32 = 0;
let mut E: u32 = EltBits.len; I != E; I += 1 {
        IsPow2OrUndef &= UndefElts[I] || EltBits[I].isPowerOf2();
    }
    return IsPow2OrUndef;
}

fn IsNOT(V: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    V = peekThroughBitcasts(V);
    let mut VT: EVT = V.getValueType();
    if V.getOpcode() == XOR && (isBuildVectorAllOnes(V.getOperand(1).getNode()) || isAllOnesConstant(V.getOperand(1))) {
        return V.getOperand(0);
    }
    if V.getOpcode() == EXTRACT_SUBVECTOR && (isNullConstant(V.getOperand(1)) || V.getOperand(0).hasOneUse()) {
        if IsNOT(V.getOperand(0), DAG) {
            Not;
        } else {
            Not = DAG.getBitcast(V.getOperand(0).getValueType(), Not);
            return DAG.getNode(EXTRACT_SUBVECTOR, Not, VT, Not, V.getOperand(1));
        }
    }
    if V.getOpcode() == PCMPGT && !isBuildVectorAllZeros(V.getOperand(0).getNode()) && !isBuildVectorAllOnes(V.getOperand(0).getNode()) && V.getOperand(0).hasOneUse() {
        let mut UndefElts: APInt = APInt {};
        let mut EltBits: SmallVector<APInt> = SmallVector<APInt> {};
        if getTargetConstantBitsFromNode(V.getOperand(0), V.getScalarValueSizeInBits(), UndefElts, EltBits, true, false) && !isBuildVectorOfConstantSDNodes(V.getOperand(1).getNode()) {
            let mut MinSigned: bool = false;
            for Elt in EltBits {
                MinSigned |= Elt.isMinSignedValue();
                operator(Elt, 1);
            }
            if !MinSigned {
                let mut DL: SDLoc = V;
                let mut VT: MVT = V.getSimpleValueType();
                return DAG.getNode(PCMPGT, DL, VT, V.getOperand(1), getConstVector(EltBits, UndefElts, VT, DAG, DL));
            }
        }
    }
    let mut CatOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    if collectConcatOps(V.getNode(), CatOps, DAG) {
        for CatOp in CatOps {
            let mut NotCat: SDValue = IsNOT(CatOp, DAG);
            if !NotCat {
                return SDValue {};
            }
            CatOp = DAG.getBitcast(CatOp.getValueType(), NotCat);
        }
        return DAG.getNode(CONCAT_VECTORS, V, VT, CatOps);
    }
    if V.getOpcode() == OR && DAG.getTargetLoweringInfo().isTypeLegal(VT) && V.getOperand(0).hasOneUse() && V.getOperand(1).hasOneUse() {
        if IsNOT(V.getOperand(1), DAG) {
            Op1;
        } else if IsNOT(V.getOperand(0), DAG) {
            Op0;
        } else {
            return DAG.getNode(AND, V, VT, DAG.getBitcast(VT, Op0), DAG.getBitcast(VT, Op1));
        }
    }
    return SDValue {};
}

fn createPackShuffleMask(VT: MVT, Mask: *mut SmallVectorImpl<int>, Unary: bool, NumStages: u32) {
    assert!(Mask.is_empty(), "Expected an empty shuffle mask vector");
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut NumLanes: u32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumEltsPerLane: u32 = 128 / VT.getScalarSizeInBits();
    let mut Offset: u32 = if Unary { 0 } else { NumElts };
    let mut Repetitions: u32 = 1 << (NumStages - 1);
    let mut Increment: u32 = 1 << NumStages;
    assert!((NumEltsPerLane >> NumStages) > 0, "Illegal packing compaction");
    for let mut Lane: u32 = 0; Lane != NumLanes; Lane += 1 {
        for let mut Stage: u32 = 0; Stage != Repetitions; Stage += 1 {
            for let mut Elt: u32 = 0; Elt != NumEltsPerLane; Elt += Increment {
                Mask.push(Elt + (Lane * NumEltsPerLane));
            }
            for let mut Elt: u32 = 0; Elt != NumEltsPerLane; Elt += Increment {
                Mask.push(Elt + (Lane * NumEltsPerLane) + Offset);
            }
        }
    }
}

fn getPackDemandedElts(VT: EVT, DemandedElts: *APInt, DemandedLHS: *mut APInt, DemandedRHS: *mut APInt) {
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumElts: i32 = DemandedElts.getBitWidth();
    let mut NumInnerElts: i32 = NumElts / 2;
    let mut NumEltsPerLane: i32 = NumElts / NumLanes;
    let mut NumInnerEltsPerLane: i32 = NumInnerElts / NumLanes;
    DemandedLHS = getZero(NumInnerElts);
    DemandedRHS = getZero(NumInnerElts);
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        for let mut Elt: i32 = 0; Elt != NumInnerEltsPerLane; Elt += 1 {
            let mut OuterIdx: i32 = (Lane * NumEltsPerLane) + Elt;
            let mut InnerIdx: i32 = (Lane * NumInnerEltsPerLane) + Elt;
            if DemandedElts[OuterIdx] {
                DemandedLHS.setBit(InnerIdx);
            }
            if DemandedElts[OuterIdx + NumInnerEltsPerLane] {
                DemandedRHS.setBit(InnerIdx);
            }
        }
    }
}

fn getHorizDemandedElts(VT: EVT, DemandedElts: *APInt, DemandedLHS: *mut APInt, DemandedRHS: *mut APInt) {
    getHorizDemandedEltsForFirstOperand(VT.getSizeInBits().operator unsigned long long(), DemandedElts, DemandedLHS, DemandedRHS);
    operator(DemandedLHS, DemandedLHS << 1);
    operator(DemandedRHS, DemandedRHS << 1);
}

fn getTargetShuffleMask(N: SDValue, AllowSentinelZero: bool, Ops: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>, IsUnary: *mut bool) -> bool {
    if !isTargetShuffle(N.getOpcode()) {
        return false;
    }
    let mut VT: MVT = N.getSimpleValueType();
    let mut NumElems: u32 = VT.getVectorNumElements();
    let mut MaskEltSize: u32 = VT.getScalarSizeInBits();
    let mut RawMask: SmallVector<uint64_t, 32> = SmallVector<uint64_t, 32> {};
    let mut RawUndefs: APInt = APInt {};
    let mut ImmN: u64 = 0;
    assert!(Mask.is_empty(), "getTargetShuffleMask expects an empty Mask vector");
    assert!(Ops.is_empty(), "getTargetShuffleMask expects an empty Ops vector");
    IsUnary = false;
    let mut IsFakeUnary: bool = false;
    match N.getOpcode() {
        BLENDI => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        SHUFP => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        INSERTPS => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        EXTRQI => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        INSERTQI => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        UNPCKH => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        UNPCKL => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        MOVHLPS => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        MOVLHPS => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        VALIGN => {
            assert!((VT.getScalarType() == i32 || VT.getScalarType() == i64), "Only 32-bit and 64-bit elements are supported!");
        },
        PALIGNR => {
            assert!(VT.getScalarType() == i8, "Byte vector expected");
        },
        VSHLDQ => {
            assert!(VT.getScalarType() == i8, "Byte vector expected");
        },
        VSRLDQ => {
            assert!(VT.getScalarType() == i8, "Byte vector expected");
        },
        PSHUFD => {
            VPERMILPI;
        },
        PSHUFHW => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        PSHUFLW => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        VZEXT_MOVL => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        VBROADCAST => {
            if N.getOperand(0).getValueType() == VT {
                DecodeVectorBroadcast(NumElems, Mask);
                IsUnary = true;
                break;
            }
        },
        VPERMILPV => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
            IsUnary = true;
            let mut MaskNode: SDValue = N.getOperand(1);
            if getTargetShuffleMaskIndices(MaskNode, MaskEltSize, RawMask, RawUndefs) {
                DecodeVPERMILPMask(NumElems, MaskEltSize, RawMask, RawUndefs, Mask);
                break;
            }
            return false;
        },
        PSHUFB => {
            assert!(VT.getScalarType() == i8, "Byte vector expected");
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
            assert!(N.getOperand(1).getValueType() == VT, "Unexpected value type");
            IsUnary = true;
            let mut MaskNode: SDValue = N.getOperand(1);
            if getTargetShuffleMaskIndices(MaskNode, 8, RawMask, RawUndefs) {
                DecodePSHUFBMask(RawMask, RawUndefs, Mask);
                break;
            }
            return false;
        },
        VPERMI => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        MOVSS => {
            MOVSD;
        },
        VPERM2X128 => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        SHUF128 => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        MOVSLDUP => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        MOVSHDUP => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        MOVDDUP => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
        },
        VPERMIL2 => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
            assert!(N.getOperand(1).getValueType() == VT, "Unexpected value type");
            IsUnary = IsFakeUnary = N.getOperand(0) == N.getOperand(1);
            let mut MaskNode: SDValue = N.getOperand(2);
            let mut CtrlNode: SDValue = N.getOperand(3);
            if dyn_cast(CtrlNode) {
                CtrlOp;
            } else {
                let mut CtrlImm: u32 = CtrlOp.getZExtValue();
                if getTargetShuffleMaskIndices(MaskNode, MaskEltSize, RawMask, RawUndefs) {
                    DecodeVPERMIL2PMask(NumElems, MaskEltSize, CtrlImm, RawMask, RawUndefs, Mask);
                    break;
                }
            }
            return false;
        },
        VPPERM => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
            assert!(N.getOperand(1).getValueType() == VT, "Unexpected value type");
            IsUnary = IsFakeUnary = N.getOperand(0) == N.getOperand(1);
            let mut MaskNode: SDValue = N.getOperand(2);
            if getTargetShuffleMaskIndices(MaskNode, 8, RawMask, RawUndefs) {
                DecodeVPPERMMask(RawMask, RawUndefs, Mask);
                break;
            }
            return false;
        },
        VPERMV => {
            assert!(N.getOperand(1).getValueType() == VT, "Unexpected value type");
            IsUnary = true;
            Ops.push(N.getOperand(1));
            let mut MaskNode: SDValue = N.getOperand(0);
            if getTargetShuffleMaskIndices(MaskNode, MaskEltSize, RawMask, RawUndefs) {
                DecodeVPERMVMask(RawMask, RawUndefs, Mask);
                break;
            }
            return false;
        },
        VPERMV3 => {
            assert!(N.getOperand(0).getValueType() == VT, "Unexpected value type");
            assert!(N.getOperand(2).getValueType() == VT, "Unexpected value type");
            IsUnary = IsFakeUnary = N.getOperand(0) == N.getOperand(2);
            Ops.push(N.getOperand(0));
            Ops.push(N.getOperand(2));
            let mut MaskNode: SDValue = N.getOperand(1);
            if getTargetShuffleMaskIndices(MaskNode, MaskEltSize, RawMask, RawUndefs) {
                DecodeVPERMV3Mask(RawMask, RawUndefs, Mask);
                break;
            }
            return false;
        },
        COMPRESS => {
            let mut CmpVec: SDValue = N.getOperand(0);
            let mut PassThru: SDValue = N.getOperand(1);
            let mut CmpMask: SDValue = N.getOperand(2);
            let mut UndefElts: APInt = APInt {};
            let mut EltBits: SmallVector<APInt> = SmallVector<APInt> {};
            if !getTargetConstantBitsFromNode(CmpMask, 1, UndefElts, EltBits, true, false) {
                return false;
            }
            assert!(UndefElts.getBitWidth() == NumElems && EltBits.len == NumElems, "Illegal compression mask");
            for let mut I: u32 = 0; I != NumElems; I += 1 {
                if !EltBits[I].isZero() {
                    Mask.push(I);
                }
            }
            while Mask.len != NumElems {
                Mask.push(NumElems + Mask.len);
            }
            Ops.push(CmpVec);
            Ops.push(PassThru);
            return true;
        },
        EXPAND => {
            let mut ExpVec: SDValue = N.getOperand(0);
            let mut PassThru: SDValue = N.getOperand(1);
            let mut ExpMask: SDValue = N.getOperand(2);
            let mut UndefElts: APInt = APInt {};
            let mut EltBits: SmallVector<APInt> = SmallVector<APInt> {};
            if !getTargetConstantBitsFromNode(ExpMask, 1, UndefElts, EltBits, true, false) {
                return false;
            }
            assert!(UndefElts.getBitWidth() == NumElems && EltBits.len == NumElems, "Illegal expansion mask");
            let mut ExpIndex: u32 = 0;
            for let mut I: u32 = 0; I != NumElems; I += 1 {
                if EltBits[I].isZero() {
                    Mask.push(I + NumElems);
                } else {
                    Mask.push(ExpIndex += 1);
                }
            }
            Ops.push(ExpVec);
            Ops.push(PassThru);
            return true;
        },
        _ => {
            llvm_unreachable_internal("unknown target shuffle node", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 6367);
        },
    }
    if Mask.is_empty() {
        return false;
    }
    if !AllowSentinelZero && isAnyZero(Mask) {
        return false;
    }
    if IsFakeUnary {
        for M in Mask {
            if M >= Mask.len as i32 {
                M -= Mask.len;
            }
        }
    }
    if Ops.is_empty() {
        Ops.push(N.getOperand(0));
        if !IsUnary || IsFakeUnary {
            Ops.push(N.getOperand(1));
        }
    }
    return true;
}

fn getTargetShuffleMask(N: SDValue, AllowSentinelZero: bool, Ops: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>) -> bool {
    let mut IsUnary: bool = false;
    return getTargetShuffleMask(N, AllowSentinelZero, Ops, Mask, IsUnary);
}

fn computeZeroableShuffleElements(Mask: ArrayRef<int>, V1: SDValue, V2: SDValue, KnownUndef: *mut APInt, KnownZero: *mut APInt) {
    let mut Size: i32 = Mask.len;
    KnownUndef = KnownZero = getZero(Size);
    V1 = peekThroughBitcasts(V1);
    V2 = peekThroughBitcasts(V2);
    let mut V1IsZero: bool = isBuildVectorAllZeros(V1.getNode());
    let mut V2IsZero: bool = isBuildVectorAllZeros(V2.getNode());
    let mut VectorSizeInBits: i32 = V1.getValueSizeInBits().operator unsigned long long();
    let mut ScalarSizeInBits: i32 = VectorSizeInBits / Size;
    assert!(!(VectorSizeInBits % ScalarSizeInBits), "Illegal shuffle mask size");
    for let mut i: i32 = 0; i < Size; i += 1 {
        let mut M: i32 = Mask[i];
        if M < 0 {
            KnownUndef.setBit(i);
            continue;
        }
        if (M >= 0 && M < Size && V1IsZero) || (M >= Size && V2IsZero) {
            KnownZero.setBit(i);
            continue;
        }
        let mut V: SDValue = if M < Size { V1 } else { V2 };
        M %= Size;
        if V.getOpcode() != BUILD_VECTOR {
            continue;
        }
        if (Size % V.getNumOperands()) == 0 {
            let mut Scale: i32 = Size / operator(V).getNumOperands();
            let mut Op: SDValue = V.getOperand(M / Scale);
            if Op.isUndef() {
                KnownUndef.setBit(i);
            }
            if isZeroNode(Op) {
                KnownZero.setBit(i);
            } else if dyn_cast(Op) {
                Cst;
            } else {
                let mut Val: APInt = Cst.getAPIntValue();
                Val = Val.extractBits(ScalarSizeInBits, (M % Scale) * ScalarSizeInBits);
                if Val == 0 {
                    KnownZero.setBit(i);
                }
            }
            continue;
        }
        if (V.getNumOperands() % Size) == 0 {
            let mut Scale: i32 = operator(V).getNumOperands() / Size;
            let mut AllUndef: bool = true;
            let mut AllZero: bool = true;
            for let mut j: i32 = 0; j < Scale; j += 1 {
                let mut Op: SDValue = V.getOperand((M * Scale) + j);
                AllUndef &= Op.isUndef();
                AllZero &= isZeroNode(Op);
            }
            if AllUndef {
                KnownUndef.setBit(i);
            }
            if AllZero {
                KnownZero.setBit(i);
            }
            continue;
        }
    }
}

fn getTargetShuffleAndZeroables(N: SDValue, Mask: *mut SmallVectorImpl<int>, Ops: *mut SmallVectorImpl<SDValue>, KnownUndef: *mut APInt, KnownZero: *mut APInt) -> bool {
    let mut IsUnary: bool = false;
    if !isTargetShuffle(N.getOpcode()) {
        return false;
    }
    let mut VT: MVT = N.getSimpleValueType();
    if !getTargetShuffleMask(N, true, Ops, Mask, IsUnary) {
        return false;
    }
    let mut Size: i32 = Mask.len;
    let mut V1: SDValue = Ops[0];
    let mut V2: SDValue = if IsUnary { V1 } else { Ops[1] };
    KnownUndef = KnownZero = getZero(Size);
    V1 = peekThroughBitcasts(V1);
    V2 = peekThroughBitcasts(V2);
    assert!((VT.getSizeInBits().operator unsigned long long() % Size) == 0, "Illegal split of shuffle value type");
    let mut EltSizeInBits: u32 = VT.getSizeInBits().operator unsigned long long() / Size;
    let mut UndefSrcElts: [2]APInt = [2]APInt {};
    let mut SrcEltBits: [2]SmallVector<APInt, 32> = [2]SmallVector<APInt, 32> {};
    let mut IsSrcConstant: [2]bool = [getTargetConstantBitsFromNode(V1, EltSizeInBits, UndefSrcElts[0], SrcEltBits[0], true, false), getTargetConstantBitsFromNode(V2, EltSizeInBits, UndefSrcElts[1], SrcEltBits[1], true, false)];
    for let mut i: i32 = 0; i < Size; i += 1 {
        let mut M: i32 = Mask[i];
        if M < 0 {
            assert!(isUndefOrZero(M), "Unknown shuffle sentinel value!");
            if SM_SentinelUndef == M {
                KnownUndef.setBit(i);
            }
            if SM_SentinelZero == M {
                KnownZero.setBit(i);
            }
            continue;
        }
        let mut SrcIdx: u32 = M / Size;
        let mut V: SDValue = if M < Size { V1 } else { V2 };
        M %= Size;
        if V.isUndef() {
            KnownUndef.setBit(i);
            continue;
        }
        if V.getOpcode() == SCALAR_TO_VECTOR && (Size % V.getValueType().getVectorNumElements()) == 0 {
            let mut Scale: i32 = Size / V.getValueType().getVectorNumElements();
            let mut Idx: i32 = M / Scale;
            if Idx != 0 && !VT.isFloatingPoint() {
                KnownUndef.setBit(i);
            } else if Idx == 0 && isZeroNode(V.getOperand(0)) {
                KnownZero.setBit(i);
            }
            continue;
        }
        if V.getOpcode() == INSERT_SUBVECTOR {
            let mut Vec: SDValue = V.getOperand(0);
            let mut NumVecElts: i32 = Vec.getValueType().getVectorNumElements();
            if Vec.isUndef() && Size == NumVecElts {
                let mut Idx: i32 = V.getConstantOperandVal(2);
                let mut NumSubElts: i32 = V.getOperand(1).getValueType().getVectorNumElements();
                if M < Idx || (Idx + NumSubElts) <= M {
                    KnownUndef.setBit(i);
                }
            }
            continue;
        }
        if IsSrcConstant[SrcIdx] {
            if UndefSrcElts[SrcIdx][M] {
                KnownUndef.setBit(i);
            } else if SrcEltBits[SrcIdx][M] == 0 {
                KnownZero.setBit(i);
            }
        }
    }
    assert!(VT.getVectorNumElements() == Size as u32, "Different mask size from vector size!");
    return true;
}

fn resolveTargetShuffleFromZeroables(Mask: *mut SmallVectorImpl<int>, KnownUndef: *APInt, KnownZero: *APInt, ResolveKnownZeros: bool) {
    let mut NumElts: u32 = Mask.len;
    assert!(KnownUndef.getBitWidth() == NumElts && KnownZero.getBitWidth() == NumElts, "Shuffle mask size mismatch");
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        if KnownUndef[i] {
            Mask[i] = SM_SentinelUndef;
        } else if ResolveKnownZeros && KnownZero[i] {
            Mask[i] = SM_SentinelZero;
        }
    }
}

fn resolveZeroablesFromTargetShuffle(Mask: *SmallVectorImpl<int>, KnownUndef: *mut APInt, KnownZero: *mut APInt) {
    let mut NumElts: u32 = Mask.len;
    KnownUndef = KnownZero = getZero(NumElts);
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut M: i32 = Mask[i];
        if SM_SentinelUndef == M {
            KnownUndef.setBit(i);
        }
        if SM_SentinelZero == M {
            KnownZero.setBit(i);
        }
    }
}

fn createShuffleMaskFromVSELECT(Mask: *mut SmallVectorImpl<int>, Cond: SDValue, IsBLENDV: bool) -> bool {
    let mut CondVT: EVT = Cond.getValueType();
    let mut EltSizeInBits: u32 = CondVT.getScalarSizeInBits();
    let mut NumElts: u32 = CondVT.getVectorNumElements();
    let mut UndefElts: APInt = APInt {};
    let mut EltBits: SmallVector<APInt, 32> = SmallVector<APInt, 32> {};
    if !getTargetConstantBitsFromNode(Cond, EltSizeInBits, UndefElts, EltBits, true, false) {
        return false;
    }
    Mask.resize(NumElts, SM_SentinelUndef);
    for let mut i: i32 = 0; i != NumElts as i32; i += 1 {
        Mask[i] = i;
        if UndefElts[i] || (!IsBLENDV && EltBits[i].isZero()) || (IsBLENDV && EltBits[i].isNonNegative()) {
            Mask[i] += NumElts;
        }
    }
    return true;
}

fn getFauxShuffleMask(N: SDValue, DemandedElts: *APInt, Mask: *mut SmallVectorImpl<int>, Ops: *mut SmallVectorImpl<SDValue>, DAG: *SelectionDAG, Depth: u32, ResolveKnownElts: bool) -> bool {
    Mask.clear();
    Ops.clear();
    let mut VT: MVT = N.getSimpleValueType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut NumSizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut NumBitsPerElt: u32 = VT.getScalarSizeInBits();
    if (NumBitsPerElt % 8) != 0 || (NumSizeInBits % 8) != 0 {
        return false;
    }
    assert!(NumElts == DemandedElts.getBitWidth(), "Unexpected vector size");
    let mut NumSizeInBytes: u32 = NumSizeInBits / 8;
    let mut NumBytesPerElt: u32 = NumBitsPerElt / 8;
    let mut Opcode: u32 = N.getOpcode();
    match Opcode {
        VECTOR_SHUFFLE => {
            let mut ShuffleMask: ArrayRef<int> = cast(N).getMask();
            if isUndefOrInRange(ShuffleMask, 0, 2 * NumElts) {
                Mask.append(ShuffleMask.begin(), ShuffleMask.end());
                Ops.push(N.getOperand(0));
                Ops.push(N.getOperand(1));
                return true;
            }
            return false;
        },
        AND => {
            ANDNP;
        },
        OR => {
            let mut N0: SDValue = peekThroughBitcasts(N.getOperand(0));
            let mut N1: SDValue = peekThroughBitcasts(N.getOperand(1));
            if !N0.getValueType().isVector() || !N1.getValueType().isVector() {
                return false;
            }
            let mut SrcMask0: SmallVector<int, 64> = SmallVector<int, 64> {};
            let mut SrcMask1: SmallVector<int, 64> = SmallVector<int, 64> {};
            let mut SrcInputs0: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
            let mut SrcInputs1: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
            let mut Demand0: APInt = getAllOnes(N0.getValueType().getVectorNumElements());
            let mut Demand1: APInt = getAllOnes(N1.getValueType().getVectorNumElements());
            if !getTargetShuffleInputs(N0, Demand0, SrcInputs0, SrcMask0, DAG, Depth + 1, true) || !getTargetShuffleInputs(N1, Demand1, SrcInputs1, SrcMask1, DAG, Depth + 1, true) {
                return false;
            }
            let mut MaskSize: u64 = if SrcMask0.len > SrcMask1.len { SrcMask0.len } else { SrcMask1.len };
            let mut Mask0: SmallVector<int, 64> = SmallVector<int, 64> {};
            let mut Mask1: SmallVector<int, 64> = SmallVector<int, 64> {};
            narrowShuffleMaskElts(MaskSize / SrcMask0.len, SrcMask0, Mask0);
            narrowShuffleMaskElts(MaskSize / SrcMask1.len, SrcMask1, Mask1);
            for let mut i: i32 = 0; i != MaskSize as i32; i += 1 {
                if Mask0[i] == SM_SentinelZero && Mask1[i] == SM_SentinelZero {
                    Mask.push(SM_SentinelZero);
                } else if Mask1[i] == SM_SentinelZero {
                    Mask.push(i);
                } else if Mask0[i] == SM_SentinelZero {
                    Mask.push(i + MaskSize);
                } else if MaskSize == NumElts && !DemandedElts[i] {
                    Mask.push(SM_SentinelUndef);
                } else {
                    return false;
                }
            }
            Ops.push(N.getOperand(0));
            Ops.push(N.getOperand(1));
            return true;
        },
        CONCAT_VECTORS => {
            let mut NumSubElts: u32 = N.getOperand(0).getValueType().getVectorNumElements();
            if NumBitsPerElt == 64 {
                for let mut I: u32 = 0;
let mut E: u32 = N.getNumOperands(); I != E; I += 1 {
                    for let mut M: u32 = 0; M != NumSubElts; M += 1 {
                        Mask.push((I * NumElts) + M);
                    }
                    Ops.push(N.getOperand(I));
                }
                return true;
            }
            return false;
        },
        INSERT_SUBVECTOR => {
            let mut Src: SDValue = N.getOperand(0);
            let mut Sub: SDValue = N.getOperand(1);
            let mut SubVT: EVT = Sub.getValueType();
            let mut NumSubElts: u32 = SubVT.getVectorNumElements();
            let mut InsertIdx: u64 = N.getConstantOperandVal(2);
            if DemandedElts.extractBits(NumSubElts, InsertIdx) == 0 {
                Mask.resize(NumElts);
                iota(Mask.begin(), Mask.end(), 0);
                Ops.push(Src);
                return true;
            }
            if Depth > 0 && InsertIdx == NumSubElts && NumElts == (2 * NumSubElts) && Src.getOpcode() == INSERT_SUBVECTOR && Src.getOperand(0).isUndef() && Src.getOperand(1).getValueType() == SubVT && Src.getConstantOperandVal(2) == 0 && (NumBitsPerElt == 64 || Src.getOperand(1) == Sub) && areOnlyUsersOf([N.getNode(), Src.getNode()], Sub.getNode()) {
                Mask.resize(NumElts);
                iota(Mask.begin(), Mask.begin() + NumSubElts, 0);
                iota(Mask.begin() + NumSubElts, Mask.end(), NumElts);
                Ops.push(Src.getOperand(1));
                Ops.push(Sub);
                return true;
            }
            if InsertIdx != 0 && Src.isUndef() && peekThroughBitcasts(Sub).getOpcode() != EXTRACT_SUBVECTOR {
                Mask.assign(NumElts, SM_SentinelUndef);
                iota(Mask.begin() + InsertIdx, Mask.begin() + InsertIdx + NumSubElts, 0);
                Ops.push(Sub);
                return true;
            }
            if !operator(N).isOnlyUserOf(Sub.getNode()) {
                return false;
            }
            let mut SubMask: SmallVector<int, 64> = SmallVector<int, 64> {};
            let mut SubInputs: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
            let mut SubSrc: SDValue = peekThroughOneUseBitcasts(Sub);
            let mut SubSrcVT: EVT = SubSrc.getValueType();
            if !SubSrcVT.isVector() {
                return false;
            }
            if SubSrc.getOpcode() == EXTRACT_SUBVECTOR && SubSrc.getOperand(0).getValueSizeInBits().operator unsigned long long() == NumSizeInBits {
                let mut ExtractIdx: u64 = SubSrc.getConstantOperandVal(1);
                let mut SubSrcSrc: SDValue = SubSrc.getOperand(0);
                let mut NumSubSrcSrcElts: u32 = SubSrcSrc.getValueType().getVectorNumElements();
                let mut MaxElts: u32 = if NumElts > NumSubSrcSrcElts { NumElts } else { NumSubSrcSrcElts };
                assert!((MaxElts % NumElts) == 0 && (MaxElts % NumSubSrcSrcElts) == 0, "Subvector valuetype mismatch");
                InsertIdx *= (MaxElts / NumElts);
                ExtractIdx *= (MaxElts / NumSubSrcSrcElts);
                NumSubElts *= (MaxElts / NumElts);
                let mut SrcIsUndef: bool = Src.isUndef();
                for let mut i: i32 = 0; i != MaxElts as i32; i += 1 {
                    Mask.push(if SrcIsUndef { SM_SentinelUndef } else { i });
                }
                for let mut i: i32 = 0; i != NumSubElts as i32; i += 1 {
                    Mask[InsertIdx + i] = (if SrcIsUndef { 0 } else { MaxElts }) + ExtractIdx + i;
                }
                if !SrcIsUndef {
                    Ops.push(Src);
                }
                Ops.push(SubSrcSrc);
                return true;
            }
            let mut SubDemand: APInt = getAllOnes(SubSrcVT.getVectorNumElements());
            if !getTargetShuffleInputs(SubSrc, SubDemand, SubInputs, SubMask, DAG, Depth + 1, ResolveKnownElts) {
                return false;
            }
            if any_of(SubInputs, Closure_18 { cap_0: SubVT }) {
                return false;
            }
            if SubMask.len != NumSubElts {
                assert!(((SubMask.len % NumSubElts) == 0 || (NumSubElts % SubMask.len) == 0), "Illegal submask scale");
                if (NumSubElts % SubMask.len) == 0 {
                    let mut Scale: i32 = NumSubElts / SubMask.len;
                    let mut ScaledSubMask: SmallVector<int, 64> = SmallVector<int, 64> {};
                    narrowShuffleMaskElts(Scale, SubMask, ScaledSubMask);
                    SubMask = ScaledSubMask;
                } else {
                    let mut Scale: i32 = SubMask.len / NumSubElts;
                    NumSubElts = SubMask.len;
                    NumElts *= Scale;
                    InsertIdx *= Scale;
                }
            }
            Ops.push(Src);
            Ops.append(SubInputs.begin(), SubInputs.end());
            if isBuildVectorAllZeros(Src.getNode()) {
                Mask.append(NumElts, SM_SentinelZero);
            } else {
                for let mut i: i32 = 0; i != NumElts as i32; i += 1 {
                    Mask.push(i);
                }
            }
            for let mut i: i32 = 0; i != NumSubElts as i32; i += 1 {
                let mut M: i32 = SubMask[i];
                if 0 <= M {
                    let mut InputIdx: i32 = M / NumSubElts;
                    M = (NumElts * (1 + InputIdx)) + (M % NumSubElts);
                }
                Mask[i + InsertIdx] = M;
            }
            return true;
        },
        PINSRB => {
            PINSRW;
        },
        PACKSS => {
            PACKUS;
        },
        VSELECT => {
            BLENDV;
        },
        VTRUNC => {
            let mut Src: SDValue = N.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            if SrcVT.getSizeInBits().operator unsigned long long() != NumSizeInBits {
                return false;
            }
            let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
            let mut NumBitsPerSrcElt: u32 = SrcVT.getScalarSizeInBits();
            let mut Scale: u32 = NumBitsPerSrcElt / NumBitsPerElt;
            assert!((NumBitsPerSrcElt % NumBitsPerElt) == 0, "Illegal truncation");
            for let mut i: u32 = 0; i != NumSrcElts; i += 1 {
                Mask.push(i * Scale);
            }
            Mask.append(NumElts - NumSrcElts, SM_SentinelZero);
            Ops.push(Src);
            return true;
        },
        SHL => {
            SRL;
        },
        VSHLI => {
            VSRLI;
        },
        ROTL => {
            ROTR;
        },
        VROTLI => {
            VROTRI;
        },
        VSHLD => {
            VSHRD;
        },
        VBROADCAST => {
            let mut Src: SDValue = N.getOperand(0);
            if !Src.getSimpleValueType().isVector() {
                if Src.getOpcode() != EXTRACT_VECTOR_ELT || !isNullConstant(Src.getOperand(1)) || Src.getOperand(0).getValueType().getScalarType() != VT.getScalarType() {
                    return false;
                }
                Src = Src.getOperand(0);
            }
            Ops.push(Src);
            Mask.append(NumElts, 0);
            return true;
        },
        SIGN_EXTEND_VECTOR_INREG => {
            let mut Src: SDValue = N.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            let mut NumBitsPerSrcElt: u32 = SrcVT.getScalarSizeInBits();
            if !SrcVT.isSimple() || (SrcVT.getSizeInBits().operator unsigned long long() % 128) != 0 || (NumBitsPerSrcElt % 8) != 0 {
                return false;
            }
            let mut DemandedSrcElts: APInt = DemandedElts.zextOrTrunc(SrcVT.getVectorNumElements());
            if DAG.ComputeNumSignBits(Src, DemandedSrcElts, 0) != NumBitsPerSrcElt {
                return false;
            }
            assert!((NumBitsPerElt % NumBitsPerSrcElt) == 0, "Unexpected extension");
            let mut Scale: u32 = NumBitsPerElt / NumBitsPerSrcElt;
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                Mask.append(Scale, I);
            }
            Ops.push(Src);
            return true;
        },
        ZERO_EXTEND => {
            ANY_EXTEND;
        },
    }
    return false;
}

fn resolveTargetShuffleInputsAndMask(Inputs: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>) {
    let mut MaskWidth: i32 = Mask.len;
    let mut UsedInputs: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    for let mut i: i32 = 0;
let mut e: i32 = Inputs.len; i < e; i += 1 {
        let mut lo: i32 = UsedInputs.len * MaskWidth;
        let mut hi: i32 = lo + MaskWidth;
        if Inputs[i].isUndef() {
            for M in Mask {
                if (lo <= M) && (M < hi) {
                    M = SM_SentinelUndef;
                }
            }
        }
        if none_of(Mask, Closure_19 { lo: lo, hi: hi }) {
            for M in Mask {
                if lo <= M {
                    M -= MaskWidth;
                }
            }
            continue;
        }
        let mut IsRepeat: bool = false;
        for let mut j: i32 = 0;
let mut ue: i32 = UsedInputs.len; j != ue; j += 1 {
            if peekThroughBitcasts(UsedInputs[j]) != peekThroughBitcasts(Inputs[i]) {
                continue;
            }
            for M in Mask {
                if lo <= M {
                    M = if (M < hi) { ((M - lo) + (j * MaskWidth)) } else { (M - MaskWidth) };
                }
            }
            IsRepeat = true;
            break;
        }
        if IsRepeat {
            continue;
        }
        UsedInputs.push(Inputs[i]);
    }
    Inputs = move(UsedInputs);
}

fn getTargetShuffleInputs(Op: SDValue, DemandedElts: *APInt, Inputs: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>, KnownUndef: *mut APInt, KnownZero: *mut APInt, DAG: *SelectionDAG, Depth: u32, ResolveKnownElts: bool) -> bool {
    if Depth >= MaxRecursionDepth {
        return false;
    }
    let mut VT: EVT = Op.getValueType();
    if !VT.isSimple() || !VT.isVector() {
        return false;
    }
    if getTargetShuffleAndZeroables(Op, Mask, Inputs, KnownUndef, KnownZero) {
        if ResolveKnownElts {
            resolveTargetShuffleFromZeroables(Mask, KnownUndef, KnownZero, true);
        }
        return true;
    }
    if getFauxShuffleMask(Op, DemandedElts, Mask, Inputs, DAG, Depth, ResolveKnownElts) {
        resolveZeroablesFromTargetShuffle(Mask, KnownUndef, KnownZero);
        return true;
    }
    return false;
}

fn getTargetShuffleInputs(Op: SDValue, DemandedElts: *APInt, Inputs: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>, DAG: *SelectionDAG, Depth: u32, ResolveKnownElts: bool) -> bool {
    let mut KnownUndef: APInt = APInt {};
    let mut KnownZero: APInt = APInt {};
    return getTargetShuffleInputs(Op, DemandedElts, Inputs, Mask, KnownUndef, KnownZero, DAG, Depth, ResolveKnownElts);
}

fn getTargetShuffleInputs(Op: SDValue, Inputs: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>, DAG: *SelectionDAG, Depth: u32, ResolveKnownElts: bool) -> bool {
    let mut VT: EVT = Op.getValueType();
    if !VT.isSimple() || !VT.isVector() {
        return false;
    }
    let mut NumElts: u32 = Op.getValueType().getVectorNumElements();
    let mut DemandedElts: APInt = getAllOnes(NumElts);
    return getTargetShuffleInputs(Op, DemandedElts, Inputs, Mask, DAG, Depth, ResolveKnownElts);
}

fn getBROADCAST_LOAD(Opcode: u32, DL: *SDLoc, VT: EVT, MemVT: EVT, Mem: *mut MemSDNode, Offset: u32, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Opcode == VBROADCAST_LOAD || Opcode == SUBV_BROADCAST_LOAD), "Unknown broadcast load type");
    if !Mem || !Mem.readMem() || !Mem.isSimple() || Mem.isNonTemporal() {
        return SDValue {};
    }
    let mut Ptr: SDValue = DAG.getMemBasePlusOffset(Mem.getBasePtr(), getFixed(Offset), DL, SDNodeFlags { Flags: None });
    let mut Tys: SDVTList = DAG.getVTList(VT, Other);
    let mut Ops: [2]SDValue = [Mem.getChain(), Ptr];
    let mut BcstLd: SDValue = DAG.getMemIntrinsicNode(Opcode, DL, Tys, Ops, MemVT, DAG.getMachineFunction().getMachineMemOperand(Mem.getMemOperand(), Offset, MemVT.getStoreSize()));
    DAG.makeEquivalentMemoryOrdering(SDValue { Node: Mem, ResNo: 1 }, BcstLd.getValue(1));
    return BcstLd;
}

fn getShuffleScalarElt(Op: SDValue, Index: u32, DAG: *mut SelectionDAG, Depth: u32) -> SDValue {
    if Depth >= MaxRecursionDepth {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    let mut Opcode: u32 = Op.getOpcode();
    let mut NumElems: u32 = VT.getVectorNumElements();
    if dyn_cast(Op) {
        SV;
    } else {
        let mut Elt: i32 = SV.getMaskElt(Index);
        if Elt < 0 {
            return DAG.getUNDEF(VT.getVectorElementType());
        }
        let mut Src: SDValue = if (Elt < NumElems as i32) { SV.getOperand(0) } else { SV.getOperand(1) };
        return getShuffleScalarElt(Src, Elt % NumElems, DAG, Depth + 1);
    }
    if isTargetShuffle(Opcode) {
        let mut ShufVT: MVT = VT.getSimpleVT();
        let mut ShufSVT: MVT = ShufVT.getVectorElementType();
        let mut NumElems: i32 = ShufVT.getVectorNumElements() as i32;
        let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        let mut ShuffleOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        if !getTargetShuffleMask(Op, true, ShuffleOps, ShuffleMask) {
            return SDValue {};
        }
        let mut Elt: i32 = ShuffleMask[Index];
        if Elt == SM_SentinelZero {
            return if ShufSVT.isInteger() { DAG.getConstant(0, Op, ShufSVT, false, false) } else { DAG.getConstantFP(0.0, Op, ShufSVT, false) };
        }
        if Elt == SM_SentinelUndef {
            return DAG.getUNDEF(ShufSVT);
        }
        assert!(0 <= Elt && Elt < (2 * NumElems), "Shuffle index out of range");
        let mut Src: SDValue = if (Elt < NumElems) { ShuffleOps[0] } else { ShuffleOps[1] };
        return getShuffleScalarElt(Src, Elt % NumElems, DAG, Depth + 1);
    }
    if Opcode == INSERT_SUBVECTOR {
        let mut Vec: SDValue = Op.getOperand(0);
        let mut Sub: SDValue = Op.getOperand(1);
        let mut SubIdx: u64 = Op.getConstantOperandVal(2);
        let mut NumSubElts: u32 = Sub.getValueType().getVectorNumElements();
        if SubIdx <= Index && Index < (SubIdx + NumSubElts) {
            return getShuffleScalarElt(Sub, Index - SubIdx, DAG, Depth + 1);
        }
        return getShuffleScalarElt(Vec, Index, DAG, Depth + 1);
    }
    if Opcode == CONCAT_VECTORS {
        let mut SubVT: EVT = Op.getOperand(0).getValueType();
        let mut NumSubElts: u32 = SubVT.getVectorNumElements();
        let mut SubIdx: u64 = Index / NumSubElts;
        let mut SubElt: u64 = Index % NumSubElts;
        return getShuffleScalarElt(Op.getOperand(SubIdx), SubElt, DAG, Depth + 1);
    }
    if Opcode == EXTRACT_SUBVECTOR {
        let mut Src: SDValue = Op.getOperand(0);
        let mut SrcIdx: u64 = Op.getConstantOperandVal(1);
        return getShuffleScalarElt(Src, Index + SrcIdx, DAG, Depth + 1);
    }
    if Opcode == BITCAST {
        let mut Src: SDValue = Op.getOperand(0);
        let mut SrcVT: EVT = Src.getValueType();
        if SrcVT.isVector() && SrcVT.getVectorNumElements() == NumElems {
            return getShuffleScalarElt(Src, Index, DAG, Depth + 1);
        }
        return SDValue {};
    }
    if Opcode == INSERT_VECTOR_ELT && isa(Op.getOperand(2)) {
        if Op.getConstantOperandAPInt(2) == Index {
            return Op.getOperand(1);
        }
        return getShuffleScalarElt(Op.getOperand(0), Index, DAG, Depth + 1);
    }
    if Opcode == SCALAR_TO_VECTOR {
        return if (Index == 0) { Op.getOperand(0) } else { DAG.getUNDEF(VT.getVectorElementType()) };
    }
    if Opcode == BUILD_VECTOR {
        return Op.getOperand(Index);
    }
    return SDValue {};
}

fn LowerBuildVectorAsInsert(Op: SDValue, DL: *SDLoc, NonZeroMask: *APInt, NumNonZero: u32, NumZero: u32, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!(((VT == v8i16 && Subtarget.hasSSE2()) || ((VT == v16i8 || VT == v4i32) && Subtarget.hasSSE41())), "Illegal vector insertion");
    let mut V: SDValue = SDValue {};
    let mut First: bool = true;
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        let mut IsNonZero: bool = NonZeroMask[i];
        if !IsNonZero {
            continue;
        }
        if First {
            First = false;
            if NumZero || 0 != i {
                V = getZeroVector(VT, Subtarget, DAG, DL);
            } else {
                assert!(0 == i, "Expected insertion into zero-index");
                V = DAG.getAnyExtOrTrunc(Op.getOperand(i), DL, i32);
                V = DAG.getNode(SCALAR_TO_VECTOR, DL, v4i32, V);
                V = DAG.getBitcast(VT, V);
                continue;
            }
        }
        V = DAG.getNode(INSERT_VECTOR_ELT, DL, VT, V, Op.getOperand(i), DAG.getVectorIdxConstant(i, DL, false));
    }
    return V;
}

fn LowerBuildVectorv16i8(Op: SDValue, DL: *SDLoc, NonZeroMask: *APInt, NumNonZero: u32, NumZero: u32, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if NumNonZero > 8 && !Subtarget.hasSSE41() {
        return SDValue {};
    }
    if Subtarget.hasSSE41() {
        return LowerBuildVectorAsInsert(Op, DL, NonZeroMask, NumNonZero, NumZero, DAG, Subtarget);
    }
    let mut V: SDValue = SDValue {};
    if !NonZeroMask.extractBits(2, 0).isZero() && !NonZeroMask.extractBits(2, 2).isZero() {
        for let mut I: u32 = 0; I != 4; I += 1 {
            if !NonZeroMask[I] {
                continue;
            }
            let mut Elt: SDValue = DAG.getZExtOrTrunc(Op.getOperand(I), DL, i32);
            if I != 0 {
                Elt = DAG.getNode(SHL, DL, i32, Elt, DAG.getConstant(I * 8, DL, i8, false, false));
            }
            V = if V { DAG.getNode(OR, DL, i32, V, Elt) } else { Elt };
        }
        assert!(V, "Failed to fold v16i8 vector to zero");
        V = DAG.getNode(SCALAR_TO_VECTOR, DL, v4i32, V);
        V = DAG.getNode(VZEXT_MOVL, DL, v4i32, V);
        V = DAG.getBitcast(v8i16, V);
    }
    for let mut i: u32 = if V { 4 } else { 0 }; i < 16; i += 2 {
        let mut ThisIsNonZero: bool = NonZeroMask[i];
        let mut NextIsNonZero: bool = NonZeroMask[i + 1];
        if !ThisIsNonZero && !NextIsNonZero {
            continue;
        }
        let mut Elt: SDValue = SDValue {};
        if ThisIsNonZero {
            if NumZero || NextIsNonZero {
                Elt = DAG.getZExtOrTrunc(Op.getOperand(i), DL, i32);
            } else {
                Elt = DAG.getAnyExtOrTrunc(Op.getOperand(i), DL, i32);
            }
        }
        if NextIsNonZero {
            let mut NextElt: SDValue = Op.getOperand(i + 1);
            if i == 0 && NumZero {
                NextElt = DAG.getZExtOrTrunc(NextElt, DL, i32);
            } else {
                NextElt = DAG.getAnyExtOrTrunc(NextElt, DL, i32);
            }
            NextElt = DAG.getNode(SHL, DL, i32, NextElt, DAG.getConstant(8, DL, i8, false, false));
            if ThisIsNonZero {
                Elt = DAG.getNode(OR, DL, i32, NextElt, Elt);
            } else {
                Elt = NextElt;
            }
        }
        if !V {
            if i != 0 || NumZero {
                V = getZeroVector(v8i16, Subtarget, DAG, DL);
            } else {
                V = DAG.getNode(SCALAR_TO_VECTOR, DL, v4i32, Elt);
                V = DAG.getBitcast(v8i16, V);
                continue;
            }
        }
        Elt = DAG.getNode(TRUNCATE, DL, i16, Elt);
        V = DAG.getNode(INSERT_VECTOR_ELT, DL, v8i16, V, Elt, DAG.getVectorIdxConstant(i / 2, DL, false));
    }
    return DAG.getBitcast(v16i8, V);
}

fn LowerBuildVectorv8i16(Op: SDValue, DL: *SDLoc, NonZeroMask: *APInt, NumNonZero: u32, NumZero: u32, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if NumNonZero > 4 && !Subtarget.hasSSE41() {
        return SDValue {};
    }
    return LowerBuildVectorAsInsert(Op, DL, NonZeroMask, NumNonZero, NumZero, DAG, Subtarget);
}

fn LowerBuildVectorv4x32(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if Subtarget.hasSSE3() && !Subtarget.hasXOP() && Op.getOperand(0) == Op.getOperand(2) && Op.getOperand(1) == Op.getOperand(3) && Op.getOperand(0) != Op.getOperand(1) {
        let mut VT: MVT = Op.getSimpleValueType();
        let mut EltVT: MVT = VT.getVectorElementType();
        let mut Ops: [4]SDValue = [Op.getOperand(0), Op.getOperand(1), DAG.getUNDEF(EltVT), DAG.getUNDEF(EltVT)];
        let mut NewBV: SDValue = DAG.getBitcast(v2f64, DAG.getBuildVector(VT, DL, Ops));
        let mut Dup: SDValue = DAG.getNode(MOVDDUP, DL, v2f64, NewBV);
        return DAG.getBitcast(VT, Dup);
    }
    let mut Zeroable: bitset<4> = bitset<4> {};
    let mut Undefs: bitset<4> = bitset<4> {};
    for let mut i: i32 = 0; i < 4; i += 1 {
        let mut Elt: SDValue = Op.getOperand(i);
        Undefs[i] = Elt.isUndef();
        Zeroable[i] = (Elt.isUndef() || isZeroNode(Elt));
    }
    assert!(Zeroable.len - Zeroable.count() > 1, "We expect at least two non-zero elements!");
    let mut FirstNonZero: SDValue = SDValue {};
    let mut FirstNonZeroIdx: u32 = 0;
    for let mut i: u32 = 0; i < 4; i += 1 {
        if Zeroable[i] {
            continue;
        }
        let mut Elt: SDValue = Op.getOperand(i);
        if Elt.getOpcode() != EXTRACT_VECTOR_ELT || !isa(Elt.getOperand(1)) {
            return SDValue {};
        }
        let mut VT: MVT = Elt.getOperand(0).getSimpleValueType();
        if !VT.is128BitVector() {
            return SDValue {};
        }
        if !FirstNonZero.getNode() {
            FirstNonZero = Elt;
            FirstNonZeroIdx = i;
        }
    }
    assert!(FirstNonZero.getNode(), "Unexpected build vector of all zeros!");
    let mut V1: SDValue = FirstNonZero.getOperand(0);
    let mut VT: MVT = V1.getSimpleValueType();
    let mut Elt: SDValue = SDValue {};
    let mut EltMaskIdx: u32 = 0;
    let mut EltIdx: u32 = 0;
    let mut Mask: [4]i32 = zeroed();
    for EltIdx = 0; EltIdx < 4; EltIdx += 1 {
        if Zeroable[EltIdx] {
            Mask[EltIdx] = EltIdx + 4;
            continue;
        }
        Elt = operator(Op).getOperand(EltIdx);
        EltMaskIdx = Elt.getConstantOperandVal(1);
        if Elt.getOperand(0) != V1 || EltMaskIdx != EltIdx {
            break;
        }
        Mask[EltIdx] = EltIdx;
    }
    if EltIdx == 4 {
        let mut VZeroOrUndef: SDValue = if (Zeroable == Undefs) { DAG.getUNDEF(VT) } else { getZeroVector(VT, Subtarget, DAG, DL) };
        if V1.getSimpleValueType() != VT {
            V1 = DAG.getBitcast(VT, V1);
        }
        return DAG.getVectorShuffle(VT, V1, V1, VZeroOrUndef, Mask);
    }
    if !Subtarget.hasSSE41() {
        return SDValue {};
    }
    let mut V2: SDValue = Elt.getOperand(0);
    if Elt == FirstNonZero && EltIdx == FirstNonZeroIdx {
        V1 = SDValue {};
    }
    let mut CanFold: bool = true;
    for let mut i: u32 = EltIdx + 1; i < 4 && CanFold; i += 1 {
        if Zeroable[i] {
            continue;
        }
        let mut Current: SDValue = operator(Op).getOperand(i);
        let mut SrcVector: SDValue = operator(Current).getOperand(0);
        if !V1.getNode() {
            V1 = SrcVector;
        }
        CanFold = (SrcVector == V1) && (Current.getConstantOperandAPInt(1) == i);
    }
    if !CanFold {
        return SDValue {};
    }
    assert!(V1.getNode(), "Expected at least two non-zero elements!");
    if V1.getSimpleValueType() != v4f32 {
        V1 = DAG.getBitcast(v4f32, V1);
    }
    if V2.getSimpleValueType() != v4f32 {
        V2 = DAG.getBitcast(v4f32, V2);
    }
    let mut ZMask: u32 = Zeroable.to_ulong();
    let mut InsertPSMask: u32 = EltMaskIdx << 6 | EltIdx << 4 | ZMask;
    assert!((InsertPSMask & ~255) == 0, "Invalid mask!");
    let mut Result: SDValue = DAG.getNode(INSERTPS, DL, v4f32, V1, V2, DAG.getTargetConstant(InsertPSMask, DL, i8, false));
    return DAG.getBitcast(VT, Result);
}

fn getVShift(isLeft: bool, VT: EVT, SrcOp: SDValue, NumBits: u32, DAG: *mut SelectionDAG, TLI: *TargetLowering, dl: *SDLoc) -> SDValue {
    assert!(VT.is128BitVector(), "Unknown type for VShift");
    let mut ShVT: MVT = v16i8;
    let mut Opc: u32 = if isLeft { VSHLDQ } else { VSRLDQ };
    SrcOp = DAG.getBitcast(ShVT, SrcOp);
    assert!(NumBits % 8 == 0, "Only support byte sized shifts");
    let mut ShiftVal: SDValue = DAG.getTargetConstant(NumBits / 8, dl, i8, false);
    return DAG.getBitcast(VT, DAG.getNode(Opc, dl, ShVT, SrcOp, ShiftVal));
}

fn LowerAsSplatVectorLoad(SrcOp: SDValue, VT: MVT, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if dyn_cast(SrcOp) {
        LD;
    } else {
        let mut Ptr: SDValue = LD.getBasePtr();
        if !isNormalLoad(LD) || !LD.isSimple() {
            return SDValue {};
        }
        let mut PVT: EVT = LD.getValueType(0);
        if PVT != i32 && PVT != f32 {
            return SDValue {};
        }
        let mut FI: i32 = -1;
        let mut Offset: i64 = 0;
        if dyn_cast(Ptr) {
            FINode;
        } else {
            FI = FINode.getIndex();
            Offset = 0;
        }
        let mut RequiredAlign: Align = VT.getSizeInBits().operator unsigned long long() / 8;
        let mut Chain: SDValue = LD.getChain();
        let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
        let mut InferredAlign: MaybeAlign = DAG.InferPtrAlign(Ptr);
        if !InferredAlign || operator(InferredAlign) < RequiredAlign {
            if MFI.isFixedObjectIndex(FI) {
                return SDValue {};
            } else {
                MFI.setObjectAlignment(FI, RequiredAlign);
            }
        }
        if Offset < 0 {
            return SDValue {};
        }
        if (Offset % RequiredAlign.value()) & 3 {
            return SDValue {};
        }
        let mut StartOffset: i64 = Offset & ~RequiredAlign.value() - 1;
        if StartOffset {
            let mut DL: SDLoc = Ptr;
            Ptr = DAG.getNode(ADD, DL, Ptr.getValueType(), Ptr, DAG.getConstant(StartOffset, DL, Ptr.getValueType(), false, false));
        }
        let mut EltNo: i32 = (Offset - StartOffset) >> 2;
        let mut NumElems: u32 = VT.getVectorNumElements();
        let mut NVT: EVT = getVectorVT(*DAG.getContext(), PVT, NumElems, false);
        let mut V1: SDValue = DAG.getLoad(NVT, dl, Chain, Ptr, LD.getPointerInfo().getWithOffset(StartOffset), MaybeAlign {}, MONone, MMOMetadata {});
        let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> { NumElems, EltNo };
        return DAG.getVectorShuffle(NVT, dl, V1, DAG.getUNDEF(NVT), Mask);
    }
    return SDValue {};
}

fn findEltLoadSrc(Elt: SDValue, Ld: *mut *mut LoadSDNode, ByteOffset: *mut i64) -> bool {
    if isNON_EXTLoad(Elt.getNode()) {
        let mut BaseLd: *mut LoadSDNode = cast(Elt);
        if !BaseLd.isSimple() {
            return false;
        }
        Ld = BaseLd;
        ByteOffset = 0;
        return true;
    }
    match Elt.getOpcode() {
        BITCAST => {
            TRUNCATE;
        },
        SRL => {
            if dyn_cast(Elt.getOperand(1)) {
                AmtC;
            } else {
                let mut Amt: u64 = AmtC.getZExtValue();
                if (Amt % 8) == 0 && findEltLoadSrc(Elt.getOperand(0), Ld, ByteOffset) {
                    ByteOffset += Amt / 8;
                    return true;
                }
            }
        },
        EXTRACT_VECTOR_ELT => {
            if dyn_cast(Elt.getOperand(1)) {
                IdxC;
            } else {
                let mut Src: SDValue = Elt.getOperand(0);
                let mut SrcSizeInBits: u32 = Src.getScalarValueSizeInBits();
                let mut DstSizeInBits: u32 = Elt.getScalarValueSizeInBits();
                if DstSizeInBits == SrcSizeInBits && (SrcSizeInBits % 8) == 0 && findEltLoadSrc(Src, Ld, ByteOffset) {
                    let mut Idx: u64 = IdxC.getZExtValue();
                    ByteOffset += Idx * (SrcSizeInBits / 8);
                    return true;
                }
            }
        },
    }
    return false;
}

fn EltsFromConsecutiveLoads(VT: EVT, Elts: ArrayRef<SDValue>, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, IsAfterLegalize: bool, Depth: u32) -> SDValue {
    if Depth >= MaxRecursionDepth {
        return SDValue {};
    }
    if (VT.getScalarSizeInBits() % 8) != 0 {
        return SDValue {};
    }
    if all_of(Elts, Closure_20 {}) {
        let mut SrcElts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        for Elt in Elts {
            SrcElts.push(peekThroughFreeze(Elt));
        }
        if EltsFromConsecutiveLoads(VT, SrcElts, DL, DAG, Subtarget, IsAfterLegalize, Depth + 1) {
            LD;
        } else {
            return DAG.getFreeze(LD);
        }
        return SDValue {};
    }
    let mut NumElems: u32 = Elts.len;
    let mut LastLoadedElt: i32 = -1;
    let mut LoadMask: APInt = getZero(NumElems);
    let mut ZeroMask: APInt = getZero(NumElems);
    let mut UndefMask: APInt = getZero(NumElems);
    let mut Loads: SmallVector<LoadSDNode *, 8> = SmallVector<LoadSDNode *, 8> { NumElems, null };
    let mut ByteOffsets: SmallVector<int64_t, 8> = SmallVector<int64_t, 8> { NumElems, 0 };
    for let mut i: u32 = 0; i < NumElems; i += 1 {
        let mut Elt: SDValue = peekThroughBitcasts(Elts[i]);
        if !Elt.getNode() {
            return SDValue {};
        }
        if Elt.isUndef() {
            UndefMask.setBit(i);
            continue;
        }
        if isZeroNode(Elt) || isBuildVectorAllZeros(Elt.getNode()) {
            ZeroMask.setBit(i);
            continue;
        }
        let mut EltSizeInBits: u32 = Elt.getValueSizeInBits().operator unsigned long long();
        if (NumElems * EltSizeInBits) != VT.getSizeInBits().operator unsigned long long() {
            return SDValue {};
        }
        if !findEltLoadSrc(Elt, Loads[i], ByteOffsets[i]) || ByteOffsets[i] < 0 {
            return SDValue {};
        }
        let mut LoadSizeInBits: u32 = Loads[i].getValueSizeInBits(0).operator unsigned long long();
        if ((ByteOffsets[i] * 8) + EltSizeInBits) > LoadSizeInBits {
            return SDValue {};
        }
        LoadMask.setBit(i);
        LastLoadedElt = i;
    }
    assert!((ZeroMask.popcount() + UndefMask.popcount() + LoadMask.popcount()) == NumElems, "Incomplete element masks");
    if UndefMask.popcount() == NumElems {
        return DAG.getUNDEF(VT);
    }
    if (ZeroMask.popcount() + UndefMask.popcount()) == NumElems {
        return if VT.isInteger() { DAG.getConstant(0, DL, VT, false, false) } else { DAG.getConstantFP(0.0, DL, VT, false) };
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut FirstLoadedElt: i32 = LoadMask.countr_zero();
    let mut EltBase: SDValue = peekThroughBitcasts(Elts[FirstLoadedElt]);
    let mut EltBaseVT: EVT = EltBase.getValueType();
    assert!(EltBaseVT.getSizeInBits() == EltBaseVT.getStoreSizeInBits(), "Register/Memory size mismatch");
    let mut LDBase: *mut LoadSDNode = Loads[FirstLoadedElt];
    assert!(LDBase, "Did not find base load for merging consecutive loads");
    let mut BaseSizeInBits: u32 = EltBaseVT.getStoreSizeInBits().operator unsigned long long();
    let mut BaseSizeInBytes: u32 = BaseSizeInBits / 8;
    let mut NumLoadedElts: i32 = (1 + LastLoadedElt - FirstLoadedElt);
    let mut LoadSizeInBits: i32 = NumLoadedElts * BaseSizeInBits;
    assert!((BaseSizeInBits % 8) == 0, "Sub-byte element loads detected");
    if ByteOffsets[FirstLoadedElt] != 0 {
        return SDValue {};
    }
    let mut CheckConsecutiveLoad: Closure_21 = Closure_21 { Loads: &mut Loads, ByteOffsets: &mut ByteOffsets, BaseSizeInBytes: &mut BaseSizeInBytes, NumElems: &mut NumElems, LoadMask: &mut LoadMask, FirstLoadedElt: &mut FirstLoadedElt, DAG: &mut DAG, BaseSizeInBits: &mut BaseSizeInBits };
    let mut IsConsecutiveLoad: bool = true;
    let mut IsConsecutiveLoadWithZeros: bool = true;
    for let mut i: i32 = FirstLoadedElt + 1; i <= LastLoadedElt; i += 1 {
        if LoadMask[i] {
            if !CheckConsecutiveLoad.call(LDBase, i) {
                IsConsecutiveLoad = false;
                IsConsecutiveLoadWithZeros = false;
                break;
            }
        } else if ZeroMask[i] {
            IsConsecutiveLoad = false;
        }
    }
    let mut CreateLoad: Closure_22 = Closure_22 { DAG: &mut DAG, DL: &mut DL, Loads: &mut Loads };
    let mut IsDereferenceable: bool = LDBase.getPointerInfo().isDereferenceable(VT.getSizeInBits().operator unsigned long long() / 8, *DAG.getContext(), DAG.getDataLayout());
    if FirstLoadedElt == 0 && (NumLoadedElts == NumElems as i32 || IsDereferenceable) && (IsConsecutiveLoad || IsConsecutiveLoadWithZeros) {
        if IsAfterLegalize && !TLI.isOperationLegal(LOAD, VT) {
            return SDValue {};
        }
        if LDBase.isNonTemporal() && LDBase.getAlign() >= 32 && VT.is256BitVector() && !Subtarget.hasInt256() {
            return SDValue {};
        }
        if NumElems == 1 {
            return DAG.getBitcast(VT, Elts[FirstLoadedElt]);
        }
        if operator(ZeroMask) {
            return CreateLoad.call(VT, LDBase);
        }
        if !IsAfterLegalize && VT.isVector() {
            let mut NumMaskElts: u32 = VT.getVectorNumElements();
            if (NumMaskElts % NumElems) == 0 {
                let mut Scale: u32 = NumMaskElts / NumElems;
                let mut ClearMask: SmallVector<int, 4> = SmallVector<int, 4> { NumMaskElts, -1 };
                for let mut i: u32 = 0; i < NumElems; i += 1 {
                    if UndefMask[i] {
                        continue;
                    }
                    let mut Offset: i32 = if ZeroMask[i] { NumMaskElts } else { 0 };
                    for let mut j: u32 = 0; j != Scale; j += 1 {
                        ClearMask[(i * Scale) + j] = (i * Scale) + j + Offset;
                    }
                }
                let mut V: SDValue = CreateLoad.call(VT, LDBase);
                let mut Z: SDValue = if VT.isInteger() { DAG.getConstant(0, DL, VT, false, false) } else { DAG.getConstantFP(0.0, DL, VT, false) };
                return DAG.getVectorShuffle(VT, DL, V, Z, ClearMask);
            }
        }
    }
    if VT.is256BitVector() || VT.is512BitVector() {
        let mut HalfNumElems: u32 = NumElems / 2;
        if UndefMask.extractBits(HalfNumElems, HalfNumElems).isAllOnes() {
            let mut HalfVT: EVT = getVectorVT(*DAG.getContext(), VT.getScalarType(), HalfNumElems, false);
            let mut HalfLD: SDValue = EltsFromConsecutiveLoads(HalfVT, Elts.drop_back(HalfNumElems), DL, DAG, Subtarget, IsAfterLegalize, Depth + 1);
            if HalfLD {
                return DAG.getNode(INSERT_SUBVECTOR, DL, VT, DAG.getUNDEF(VT), HalfLD, DAG.getVectorIdxConstant(0, DL, false));
            }
        }
    }
    if IsConsecutiveLoad && FirstLoadedElt == 0 && ((LoadSizeInBits == 16 && Subtarget.hasFP16()) || LoadSizeInBits == 32 || LoadSizeInBits == 64) && ((VT.is128BitVector() || VT.is256BitVector() || VT.is512BitVector())) {
        let mut VecSVT: MVT = if VT.isFloatingPoint() { getFloatingPointVT(LoadSizeInBits) } else { getIntegerVT(LoadSizeInBits) };
        let mut VecVT: MVT = getVectorVT(VecSVT, VT.getSizeInBits().operator unsigned long long() / LoadSizeInBits);
        if !Subtarget.hasSSE2() && VT == v4f32 {
            VecVT = v4f32;
        }
        if TLI.isTypeLegal(VecVT) {
            let mut Tys: SDVTList = DAG.getVTList(VecVT, Other);
            let mut Ops: [2]SDValue = [LDBase.getChain(), LDBase.getBasePtr()];
            let mut ResNode: SDValue = DAG.getMemIntrinsicNode(VZEXT_LOAD, DL, Tys, Ops, VecSVT, LDBase.getPointerInfo(), LDBase.getBaseAlign(), MOLoad, precise(0), AAMDNodes {});
            for LD in Loads {
                if LD {
                    DAG.makeEquivalentMemoryOrdering(LD, ResNode);
                }
            }
            return DAG.getBitcast(VT, ResNode);
        }
    }
    if ZeroMask.isZero() && isPowerOf2_32(NumElems) && Subtarget.hasAVX() && (VT.is128BitVector() || VT.is256BitVector() || VT.is512BitVector()) {
        for let mut SubElems: u32 = 1; SubElems < NumElems; SubElems *= 2 {
            let mut RepeatSize: u32 = SubElems * BaseSizeInBits;
            let mut ScalarSize: u32 = if RepeatSize < 64 { RepeatSize } else { 64 };
            if !Subtarget.hasAVX2() && ScalarSize < 32 {
                continue;
            }
            if RepeatSize > ScalarSize && SubElems == 1 {
                continue;
            }
            let mut Match: bool = true;
            let mut RepeatedLoads: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { SubElems, DAG.getUNDEF(EltBaseVT) };
            for let mut i: u32 = 0; i != NumElems && Match; i += 1 {
                if !LoadMask[i] {
                    continue;
                }
                let mut Elt: SDValue = peekThroughBitcasts(Elts[i]);
                if RepeatedLoads[i % SubElems].isUndef() {
                    RepeatedLoads[i % SubElems] = Elt;
                } else {
                    Match &= (RepeatedLoads[i % SubElems] == Elt);
                }
            }
            Match &= !RepeatedLoads.front().isUndef();
            Match &= !RepeatedLoads.back().isUndef();
            if !Match {
                continue;
            }
            let mut RepeatVT: EVT = if VT.isInteger() && (RepeatSize != 64 || TLI.isTypeLegal(i64)) { getIntegerVT(*DAG.getContext(), ScalarSize) } else { getFloatingPointVT(ScalarSize) };
            if RepeatSize > ScalarSize {
                RepeatVT = getVectorVT(*DAG.getContext(), RepeatVT, RepeatSize / ScalarSize, false);
            }
            let mut BroadcastVT: EVT = getVectorVT(*DAG.getContext(), RepeatVT.getScalarType(), VT.getSizeInBits().operator unsigned long long() / ScalarSize, false);
            if TLI.isTypeLegal(BroadcastVT) {
                if EltsFromConsecutiveLoads(RepeatVT, RepeatedLoads, DL, DAG, Subtarget, IsAfterLegalize, Depth + 1) {
                    RepeatLoad;
                } else {
                    let mut Broadcast: SDValue = RepeatLoad;
                    if RepeatSize > ScalarSize {
                        while Broadcast.getValueSizeInBits().operator unsigned long long() < VT.getSizeInBits().operator unsigned long long() {
                            Broadcast = concatSubVectors(Broadcast, Broadcast, DAG, DL);
                        }
                    } else {
                        if !Subtarget.hasAVX2() && !mayFoldLoadIntoBroadcastFromMem(RepeatLoad, RepeatVT.getScalarType().getSimpleVT(), Subtarget, true) {
                            return SDValue {};
                        }
                        Broadcast = DAG.getNode(VBROADCAST, DL, BroadcastVT, RepeatLoad);
                    }
                    return DAG.getBitcast(VT, Broadcast);
                }
            }
        }
    }
    if Depth <= 1 && Subtarget.hasAVX2() && !IsConsecutiveLoad && LoadMask.isAllOnes() && isPowerOf2_32(NumElems) && BaseSizeInBits <= 32 && VT.getSizeInBits().operator unsigned long long() >= 128 {
        let mut WideEltBits: u32 = 0;
        for Trial in [16, 32, 64] {
            if Trial <= BaseSizeInBits || Trial % BaseSizeInBits != 0 {
                continue;
            }
            let mut LaneStride: u32 = Trial / BaseSizeInBits;
            let mut AllMatch: bool = true;
            for let mut K: u32 = 1; K < NumElems && AllMatch; K += 1 {
                AllMatch = AllMatch && ByteOffsets[K] == 0 && DAG.areNonVolatileConsecutiveLoads(Loads[K], LDBase, BaseSizeInBytes, K * LaneStride);
            }
            if AllMatch {
                WideEltBits = Trial;
                break;
            }
        }
        if WideEltBits != 0 {
            let mut WideEltVT: MVT = getIntegerVT(WideEltBits);
            let mut SrcEltVT: MVT = getIntegerVT(BaseSizeInBits);
            let mut StrideBytes: u32 = WideEltBits / 8;
            let mut RangeSafe: bool = LDBase.getBaseAlign() >= StrideBytes || LDBase.getPointerInfo().isDereferenceable(NumElems * StrideBytes, *DAG.getContext(), DAG.getDataLayout());
            for WideRegBits in [512, 256, 128] {
                let mut LanesPerWideLoad: u32 = WideRegBits / WideEltBits;
                if LanesPerWideLoad < 2 || NumElems % LanesPerWideLoad != 0 {
                    continue;
                }
                let mut PieceEltBits: u32 = if BaseSizeInBits > 128 / LanesPerWideLoad { BaseSizeInBits } else { 128 / LanesPerWideLoad };
                let mut PieceEltVT: MVT = getIntegerVT(PieceEltBits);
                let mut WideVT: MVT = getVectorVT(WideEltVT, LanesPerWideLoad);
                let mut PieceVT: MVT = getVectorVT(PieceEltVT, LanesPerWideLoad);
                let mut TruncVT: MVT = getVectorVT(SrcEltVT, NumElems);
                let mut ConcatVT: MVT = getVectorVT(PieceEltVT, NumElems);
                if !TLI.isTypeLegal(WideVT) || !TLI.isTypeLegal(PieceVT) || !TLI.isTypeLegal(ConcatVT) || !TLI.isTypeLegal(TruncVT) {
                    continue;
                }
                let mut NumWideLoads: u32 = NumElems / LanesPerWideLoad;
                let mut BytesPerWideLoad: u32 = WideRegBits / 8;
                let mut CanShift: bool = NumWideLoads >= 2;
                if !RangeSafe && !CanShift {
                    continue;
                }
                let mut TailBits: u32 = WideEltBits - BaseSizeInBits;
                let mut MMOFlags: Flags = LDBase.getMemOperand().getFlags();
                let mut BasePtr: SDValue = LDBase.getBasePtr();
                let mut Pieces: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
                for let mut K: u32 = 0; K != NumWideLoads; K += 1 {
                    let mut ShiftLast: bool = !RangeSafe && K == NumWideLoads - 1;
                    let mut Offset: u32 = K * BytesPerWideLoad;
                    if ShiftLast {
                        Offset -= TailBits / 8;
                    }
                    let mut Ptr: SDValue = DAG.getMemBasePlusOffset(BasePtr, getFixed(Offset), DL, SDNodeFlags { Flags: None });
                    let mut LdAlign: Align = commonAlignment(LDBase.getBaseAlign(), Offset);
                    let mut Ld: SDValue = DAG.getLoad(WideVT, DL, LDBase.getChain(), Ptr, LDBase.getPointerInfo().getWithOffset(Offset), LdAlign, MMOFlags, MMOMetadata {});
                    for LD in Loads {
                        if LD {
                            DAG.makeEquivalentMemoryOrdering(LD, Ld);
                        }
                    }
                    if ShiftLast {
                        Ld = DAG.getNode(SRL, DL, WideVT, Ld, DAG.getShiftAmountConstant(TailBits, WideVT, DL));
                    }
                    Pieces.push(DAG.getNode(TRUNCATE, DL, PieceVT, Ld));
                }
                let mut Result: SDValue = DAG.getNode(CONCAT_VECTORS, DL, ConcatVT, Pieces);
                Result = DAG.getNode(TRUNCATE, DL, TruncVT, Result);
                return DAG.getBitcast(VT, Result);
            }
        }
    }
    if Depth == 0 && ZeroMask.isZero() && UndefMask.isZero() && TLI.isTypeLegal(VT) && VT.isVector() && NumElems == VT.getVectorNumElements() {
        let mut ReverseElts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { Elts.rbegin(), Elts.rend() };
        if EltsFromConsecutiveLoads(VT, ReverseElts, DL, DAG, Subtarget, IsAfterLegalize, Depth + 1) {
            RevLd;
        } else {
            let mut ReverseMask: SmallVector<int, 16> = NumElems;
            iota(ReverseMask.rbegin(), ReverseMask.rend(), 0);
            return DAG.getVectorShuffle(VT, DL, RevLd, DAG.getUNDEF(VT), ReverseMask);
        }
    }
    return SDValue {};
}

fn combineToConsecutiveLoads(VT: EVT, Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, IsAfterLegalize: bool) -> SDValue {
    let mut Elts: SmallVector<SDValue, 64> = SmallVector<SDValue, 64> {};
    for let mut i: u32 = 0;
let mut e: u32 = VT.getVectorNumElements(); i != e; i += 1 {
        if getShuffleScalarElt(Op, i, DAG, 0) {
            Elt;
        } else {
            Elts.push(Elt);
            continue;
        }
        return SDValue {};
    }
    assert!(Elts.len == VT.getVectorNumElements();
    return EltsFromConsecutiveLoads(VT, Elts, DL, DAG, Subtarget, IsAfterLegalize, 0);
}

fn getConstantVector(VT: MVT, Bits: ArrayRef<APInt>, Undefs: *APInt, C: *mut LLVMContext) -> *mut Constant {
    let mut ScalarSize: u32 = VT.getScalarSizeInBits();
    let mut Ty: *mut Type = VT.getScalarType().getTypeForEVT(C);
    let mut getConstantScalar: Closure_23 = Closure_23 { VT: &mut VT, ScalarSize: &mut ScalarSize, C: &mut C, Ty: &mut Ty };
    let mut ConstantVec: SmallVector<Constant *, 32> = SmallVector<Constant *, 32> {};
    for let mut I: u32 = 0;
let mut E: u32 = Bits.len; I != E; I += 1 {
        ConstantVec.push(if Undefs[I] { get(Ty) } else { getConstantScalar.call(Bits[I]) });
    }
    return get(ConstantVec);
}

fn getConstantVector(VT: MVT, SplatValue: *APInt, SplatBitSize: u32, C: *mut LLVMContext) -> *mut Constant {
    let mut ScalarSize: u32 = VT.getScalarSizeInBits();
    let mut getConstantScalar: Closure_24 = Closure_24 { VT: &mut VT, ScalarSize: &mut ScalarSize, C: &mut C };
    if ScalarSize == SplatBitSize {
        return getConstantScalar.call(SplatValue);
    }
    let mut NumElm: u32 = SplatBitSize / ScalarSize;
    let mut ConstantVec: SmallVector<Constant *, 32> = SmallVector<Constant *, 32> {};
    for let mut I: u32 = 0; I != NumElm; I += 1 {
        let mut Val: APInt = SplatValue.extractBits(ScalarSize, ScalarSize * I);
        ConstantVec.push(getConstantScalar.call(Val));
    }
    return get(ConstantVec);
}

fn isFoldableUseOfShuffle(N: *mut SDNode) -> bool {
    for U in N.users() {
        let mut Opc: u32 = U.getOpcode();
        if Opc == VPERMV && U.getOperand(0).getNode() == N {
            return false;
        }
        if Opc == VPERMV3 && U.getOperand(1).getNode() == N {
            return false;
        }
        if isTargetShuffle(Opc) {
            return true;
        }
        if Opc == BITCAST {
            return isFoldableUseOfShuffle(U);
        }
        if N.hasOneUse() {
            if Opc == VPDPBUSD && U.getOperand(2).getNode() != N {
                return false;
            }
            return true;
        }
    }
    return false;
}

fn isFoldableAsShuffle(V: SDValue) -> bool {
    while V.getOpcode() == BITCAST || V.getOpcode() == EXTRACT_SUBVECTOR {
        V = V.getOperand(0);
    }
    return isTargetShuffle(V.getOpcode());
}

fn isMaskableNode(V: SDValue, Subtarget: *X86Subtarget) -> bool {
    let mut SizeInBits: u32 = V.getValueSizeInBits().operator unsigned long long();
    if (SizeInBits == 512 && Subtarget.hasAVX512()) || (SizeInBits >= 128 && Subtarget.hasVLX()) {
        if V.hasOneUse() && operator(operator(V).user_begin()).getOpcode() == VSELECT && operator(operator(V).user_begin()).getOperand(0).getScalarValueSizeInBits() == 1 {
            return true;
        }
    }
    return false;
}

fn lowerBuildVectorAsBroadcast(BVOp: *mut BuildVectorSDNode, dl: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if !Subtarget.hasAVX() {
        return SDValue {};
    }
    let mut VT: MVT = BVOp.getSimpleValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    assert!((VT.is128BitVector() || VT.is256BitVector() || VT.is512BitVector()), "Unsupported vector type for broadcast.");
    let mut Ld: SDValue = SDValue {};
    let mut UndefElements: BitVector = BitVector {};
    let mut Sequence: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    if BVOp.getRepeatedSequence(Sequence, &mut UndefElements) {
        assert!((NumElts % Sequence.len) == 0, "Sequence doesn't fit.");
        if Sequence.len == 1 {
            Ld = Sequence[0];
        }
    }
    if !Sequence.is_empty() && Subtarget.hasCDI() {
        let mut SeqLen: u32 = Sequence.len;
        let mut UpperZeroOrUndef: bool = SeqLen == 1 || all_of(Sequence.drop_front(1), Closure_25 {});
        let mut Op0: SDValue = Sequence[0];
        if UpperZeroOrUndef && ((Op0.getOpcode() == BITCAST) || (Op0.getOpcode() == ZERO_EXTEND && Op0.getOperand(0).getOpcode() == BITCAST)) {
            let mut BOperand: SDValue = if Op0.getOpcode() == BITCAST { Op0.getOperand(0) } else { Op0.getOperand(0).getOperand(0) };
            let mut MaskVT: MVT = BOperand.getSimpleValueType();
            let mut EltType: MVT = getIntegerVT(VT.getScalarSizeInBits() * SeqLen);
            if (EltType == i64 && MaskVT == v8i1) || (EltType == i32 && MaskVT == v16i1) {
                let mut BcstVT: MVT = getVectorVT(EltType, NumElts / SeqLen);
                if !VT.is512BitVector() && !Subtarget.hasVLX() {
                    let mut Scale: u32 = 512 / VT.getSizeInBits().operator unsigned long long();
                    BcstVT = getVectorVT(EltType, Scale * (NumElts / SeqLen));
                }
                let mut Bcst: SDValue = DAG.getNode(VBROADCASTM, dl, BcstVT, BOperand);
                if BcstVT.getSizeInBits() != VT.getSizeInBits() {
                    Bcst = extractSubVector(Bcst, 0, DAG, dl, VT.getSizeInBits().operator unsigned long long());
                }
                return DAG.getBitcast(VT, Bcst);
            }
        }
    }
    let mut NumUndefElts: u32 = UndefElements.count();
    if !Ld || (NumElts - NumUndefElts) <= 1 {
        let mut SplatValue: APInt = APInt {};
        let mut Undef: APInt = APInt {};
        let mut SplatBitSize: u32 = 0;
        let mut HasUndef: bool = false;
        if BVOp.isConstantSplat(SplatValue, Undef, SplatBitSize, HasUndef, 0, false) && SplatBitSize > VT.getScalarSizeInBits() && SplatBitSize < VT.getSizeInBits().operator unsigned long long() {
            if isFoldableUseOfShuffle(BVOp) {
                return SDValue {};
            }
            let mut Ctx: *mut LLVMContext = DAG.getContext();
            let mut PVT: MVT = TLI.getPointerTy(DAG.getDataLayout(), 0);
            if SplatBitSize == 32 || SplatBitSize == 64 || (SplatBitSize < 32 && Subtarget.hasAVX2()) {
                let mut CVT: MVT = getIntegerVT(SplatBitSize);
                let mut C: *mut Constant = getConstantVector(VT, SplatValue, SplatBitSize, *Ctx);
                let mut CP: SDValue = DAG.getConstantPool(C, PVT, nullopt, 0, false, 0);
                let mut Repeat: u32 = VT.getSizeInBits().operator unsigned long long() / SplatBitSize;
                let mut Alignment: Align = cast(CP).getAlign();
                let mut Tys: SDVTList = DAG.getVTList(getVectorVT(CVT, Repeat), Other);
                let mut Ops: [2]SDValue = [DAG.getEntryNode(), CP];
                let mut MPI: MachinePointerInfo = getConstantPool(DAG.getMachineFunction());
                let mut Brdcst: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, dl, Tys, Ops, CVT, MPI, Alignment, MOLoad, precise(0), AAMDNodes {});
                return DAG.getBitcast(VT, Brdcst);
            }
            if SplatBitSize > 64 {
                let mut VecC: *mut Constant = getConstantVector(VT, SplatValue, SplatBitSize, *Ctx);
                let mut VCP: SDValue = DAG.getConstantPool(VecC, PVT, nullopt, 0, false, 0);
                let mut NumElm: u32 = SplatBitSize / VT.getScalarSizeInBits();
                let mut VVT: MVT = getVectorVT(VT.getScalarType(), NumElm);
                let mut Alignment: Align = cast(VCP).getAlign();
                let mut Tys: SDVTList = DAG.getVTList(VT, Other);
                let mut Ops: [2]SDValue = [DAG.getEntryNode(), VCP];
                let mut MPI: MachinePointerInfo = getConstantPool(DAG.getMachineFunction());
                return DAG.getMemIntrinsicNode(SUBV_BROADCAST_LOAD, dl, Tys, Ops, VVT, MPI, Alignment, MOLoad, precise(0), AAMDNodes {});
            }
        }
        if !Ld || NumElts - NumUndefElts != 1 {
            return SDValue {};
        }
        let mut ScalarSize: u32 = Ld.getValueSizeInBits().operator unsigned long long();
        if !(UndefElements[0] || (ScalarSize != 32 && ScalarSize != 64)) {
            return SDValue {};
        }
    }
    let mut ConstSplatVal: bool = (Ld.getOpcode() == Constant || Ld.getOpcode() == ConstantFP);
    let mut IsLoad: bool = isNormalLoad(Ld.getNode());
    if !ConstSplatVal && !IsLoad && !BVOp.isOnlyUserOf(Ld.getNode()) {
        return SDValue {};
    }
    let mut ScalarSize: u32 = Ld.getValueSizeInBits().operator unsigned long long();
    let mut IsGE256: bool = (VT.getSizeInBits().operator unsigned long long() >= 256);
    let mut OptForSize: bool = DAG.shouldOptForSize();
    if ConstSplatVal && (Subtarget.hasAVX2() || OptForSize) {
        let mut CVT: EVT = Ld.getValueType();
        assert!(!CVT.isVector(), "Must not broadcast a vector type");
        if ScalarSize == 32 || (ScalarSize == 64 && (IsGE256 || Subtarget.hasVLX())) || (CVT == f16 && Subtarget.hasAVX2()) || (OptForSize && (ScalarSize == 64 || Subtarget.hasAVX2())) {
            let mut C: *Constant = null;
            if dyn_cast(Ld) {
                CI;
            } else {
                C = CI.getConstantIntValue();
            }
            assert!(C, "Invalid constant type");
            let mut CP: SDValue = DAG.getConstantPool(C, TLI.getPointerTy(DAG.getDataLayout(), 0), nullopt, 0, false, 0);
            let mut Alignment: Align = cast(CP).getAlign();
            let mut Tys: SDVTList = DAG.getVTList(VT, Other);
            let mut Ops: [2]SDValue = [DAG.getEntryNode(), CP];
            let mut MPI: MachinePointerInfo = getConstantPool(DAG.getMachineFunction());
            return DAG.getMemIntrinsicNode(VBROADCAST_LOAD, dl, Tys, Ops, CVT, MPI, Alignment, MOLoad, precise(0), AAMDNodes {});
        }
    }
    if !IsLoad && Subtarget.hasInt256() && (ScalarSize == 32 || (IsGE256 && ScalarSize == 64)) {
        return DAG.getNode(VBROADCAST, dl, VT, Ld);
    }
    if !IsLoad {
        return SDValue {};
    }
    if !operator(Ld).hasNUsesOfValue(NumElts - NumUndefElts, 0) {
        return SDValue {};
    }
    if ScalarSize == 32 || (IsGE256 && ScalarSize == 64) || (Subtarget.hasVLX() && ScalarSize == 64) {
        let mut LN: *mut LoadSDNode = cast(Ld);
        let mut Tys: SDVTList = DAG.getVTList(VT, Other);
        let mut Ops: [2]SDValue = [LN.getChain(), LN.getBasePtr()];
        let mut BCast: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, dl, Tys, Ops, LN.getMemoryVT(), LN.getMemOperand());
        DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, BCast.getValue(1));
        return BCast;
    }
    if Subtarget.hasInt256() && Ld.getValueType().isInteger() && (ScalarSize == 8 || ScalarSize == 16 || ScalarSize == 64) {
        let mut LN: *mut LoadSDNode = cast(Ld);
        let mut Tys: SDVTList = DAG.getVTList(VT, Other);
        let mut Ops: [2]SDValue = [LN.getChain(), LN.getBasePtr()];
        let mut BCast: SDValue = DAG.getMemIntrinsicNode(VBROADCAST_LOAD, dl, Tys, Ops, LN.getMemoryVT(), LN.getMemOperand());
        DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN, ResNo: 1 }, BCast.getValue(1));
        return BCast;
    }
    if ScalarSize == 16 && Subtarget.hasFP16() && IsGE256 {
        return DAG.getNode(VBROADCAST, dl, VT, Ld);
    }
    return SDValue {};
}

fn getUnderlyingExtractedFromVec(ExtractedFromVec: *mut SDValue, ExtIdx: SDValue) -> i32 {
    let mut Idx: i32 = operator(ExtIdx).getAsZExtVal();
    if !isa(ExtractedFromVec) {
        return Idx;
    }
    let mut SVOp: *mut ShuffleVectorSDNode = cast(ExtractedFromVec);
    let mut ShuffleVec: SDValue = SVOp.getOperand(0);
    let mut ShuffleVecVT: MVT = ShuffleVec.getSimpleValueType();
    assert!(ShuffleVecVT.getVectorElementType() == ExtractedFromVec.getSimpleValueType().getVectorElementType();
    let mut ShuffleIdx: i32 = SVOp.getMaskElt(Idx);
    if isUndefOrInRange(ShuffleIdx, 0, ShuffleVecVT.getVectorNumElements()) {
        ExtractedFromVec = ShuffleVec;
        return ShuffleIdx;
    }
    return Idx;
}

fn buildFromShuffleMostly(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isOperationLegalOrCustom(INSERT_VECTOR_ELT, VT, false) {
        return SDValue {};
    }
    let mut NumElems: u32 = Op.getNumOperands();
    let mut VecIn1: SDValue = SDValue {};
    let mut VecIn2: SDValue = SDValue {};
    let mut InsertIndices: SmallVector<unsigned int, 4> = SmallVector<unsigned int, 4> {};
    let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> { NumElems, -1 };
    for let mut i: u32 = 0; i != NumElems; i += 1 {
        let mut Opc: u32 = Op.getOperand(i).getOpcode();
        if Opc == POISON || Opc == UNDEF {
            continue;
        }
        if Opc != EXTRACT_VECTOR_ELT {
            if InsertIndices.len > 1 {
                return SDValue {};
            }
            InsertIndices.push(i);
            continue;
        }
        let mut ExtractedFromVec: SDValue = Op.getOperand(i).getOperand(0);
        let mut ExtIdx: SDValue = Op.getOperand(i).getOperand(1);
        if !isa(ExtIdx) {
            return SDValue {};
        }
        let mut Idx: i32 = getUnderlyingExtractedFromVec(ExtractedFromVec, ExtIdx);
        if ExtractedFromVec.getValueType() != VT {
            return SDValue {};
        }
        if !VecIn1.getNode() {
            VecIn1 = ExtractedFromVec;
        } else if VecIn1 != ExtractedFromVec {
            if !VecIn2.getNode() {
                VecIn2 = ExtractedFromVec;
            } else if VecIn2 != ExtractedFromVec {
                return SDValue {};
            }
        }
        if ExtractedFromVec == VecIn1 {
            Mask[i] = Idx;
        } else if ExtractedFromVec == VecIn2 {
            Mask[i] = Idx + NumElems;
        }
    }
    if !VecIn1.getNode() {
        return SDValue {};
    }
    VecIn2 = if VecIn2.getNode() { VecIn2 } else { DAG.getPOISON(VT) };
    let mut NV: SDValue = DAG.getVectorShuffle(VT, DL, VecIn1, VecIn2, Mask);
    for Idx in InsertIndices {
        NV = DAG.getNode(INSERT_VECTOR_ELT, DL, VT, NV, Op.getOperand(Idx), DAG.getVectorIdxConstant(Idx, DL, false));
    }
    return NV;
}

fn LowerBUILD_VECTORvXbf16(Op: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut SVT: MVT = if Subtarget.hasFP16() { f16 } else { i16 };
    let mut IVT: MVT = VT.changeVectorElementType(SVT);
    let mut NewOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    for let mut I: u32 = 0;
let mut E: u32 = Op.getNumOperands(); I != E; I += 1 {
        NewOps.push(DAG.getBitcast(SVT, Op.getOperand(I)));
    }
    let mut Res: SDValue = DAG.getNode(BUILD_VECTOR, SDLoc {}, IVT, NewOps);
    return DAG.getBitcast(VT, Res);
}

fn LowerBUILD_VECTORvXi1(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    assert!((VT.getVectorElementType() == i1), "Unexpected type in LowerBUILD_VECTORvXi1!");
    if isBuildVectorAllZeros(Op.getNode()) || isBuildVectorAllOnes(Op.getNode()) {
        return Op;
    }
    let mut Undefs: u64 = 0;
    let mut Immediate: u64 = 0;
    let mut NonConstMask: u64 = 0;
    let mut NonConstElts: SmallSet<SDValue, 16> = SmallSet<SDValue, 16> {};
    let mut HasConstElts: bool = false;
    for let mut idx: u32 = 0;
let mut e: u32 = Op.getNumOperands(); idx < e; idx += 1 {
        let mut In: SDValue = Op.getOperand(idx);
        if In.isUndef() {
            Undefs |= 1 << idx;
            continue;
        }
        if dyn_cast(In) {
            InC;
        } else {
            Immediate |= (InC.getZExtValue() & 1) << idx;
            HasConstElts = true;
        }
    }
    if NonConstElts.len == 1 {
        let mut Cond: SDValue = operator(NonConstElts.begin());
        assert!(Cond.getValueType() == i8, "Unexpected VT!");
        if Cond.getOpcode() != SETCC {
            Cond = DAG.getNode(AND, dl, i8, Cond, DAG.getConstant(1, dl, i8, false, false));
        }
        let mut TrueImm: u64 = NonConstMask | Immediate;
        let mut FalseImm: u64 = Immediate;
        if VT == v64i1 && !Subtarget.is64Bit() {
            let mut TrueLo: u64 = TrueImm as u32;
            let mut TrueHi: u64 = TrueImm >> 32;
            let mut FalseLo: u64 = FalseImm as u32;
            let mut FalseHi: u64 = FalseImm >> 32;
            let mut Lo: SDValue = DAG.getSelect(dl, i32, Cond, DAG.getConstant(TrueLo, dl, i32, false, false), DAG.getConstant(FalseLo, dl, i32, false, false), SDNodeFlags { Flags: None });
            let mut Hi: SDValue = DAG.getSelect(dl, i32, Cond, DAG.getConstant(TrueHi, dl, i32, false, false), DAG.getConstant(FalseHi, dl, i32, false, false), SDNodeFlags { Flags: None });
            Lo = DAG.getBitcast(v32i1, Lo);
            Hi = DAG.getBitcast(v32i1, Hi);
            return DAG.getNode(CONCAT_VECTORS, dl, v64i1, Lo, Hi);
        } else {
            let mut ImmVT: MVT = getIntegerVT(if VT.getSizeInBits().operator unsigned long long() as u32 > 8 { VT.getSizeInBits().operator unsigned long long() as u32 } else { 8 });
            if (TrueImm | Undefs) == (~0 >> (64 - VT.getSizeInBits().operator unsigned long long())) {
                TrueImm = ~0 >> (64 - ImmVT.getSizeInBits().operator unsigned long long());
            }
            let mut Select: SDValue = DAG.getSelect(dl, ImmVT, Cond, DAG.getConstant(TrueImm, dl, ImmVT, false, false), DAG.getConstant(FalseImm, dl, ImmVT, false, false), SDNodeFlags { Flags: None });
            let mut VecVT: MVT = if VT.getSizeInBits().operator unsigned long long() >= 8 { VT } else { v8i1 };
            Select = DAG.getBitcast(VecVT, Select);
            return DAG.getNode(EXTRACT_SUBVECTOR, dl, VT, Select, DAG.getVectorIdxConstant(0, dl, false));
        }
    }
    let mut OpVT: MVT = Op.getOperand(0).getSimpleValueType();
    if OpVT == i8 && NonConstMask != 0 {
        let mut ByteVT: MVT = VT.changeVectorElementType(i8);
        let mut WideSVT: MVT = if Subtarget.hasBWI() { i8 } else { i32 };
        if ByteVT.getSizeInBits().operator unsigned long long() < 128 {
            WideSVT = if ByteVT == v4i8 { i32 } else { i64 };
            ByteVT = v16i8;
        }
        let mut WideVT: MVT = VT.changeVectorElementType(WideSVT);
        if DAG.getTargetLoweringInfo().isTypeLegal(ByteVT) && DAG.getTargetLoweringInfo().isTypeLegal(WideVT) {
            let mut Elts: SmallVector<SDValue, 16> = operator(Op).op_values();
            Elts.append(ByteVT.getVectorNumElements() - Elts.len, DAG.getPOISON(OpVT));
            let mut ByteBV: SDValue = DAG.getBuildVector(ByteVT, dl, Elts);
            let mut WideBV: SDValue = getEXTEND_VECTOR_INREG(ANY_EXTEND, dl, WideVT, ByteBV, DAG);
            WideBV = DAG.getNode(AND, dl, WideVT, WideBV, DAG.getConstant(1, dl, WideVT, false, false));
            return DAG.getSetCC(dl, VT, WideBV, DAG.getConstant(0, dl, WideVT, false, false), SETNE, SDValue {}, false, None);
        }
    }
    let mut DstVec: SDValue = SDValue {};
    if HasConstElts {
        if VT == v64i1 && !Subtarget.is64Bit() {
            let mut ImmL: SDValue = DAG.getConstant(Lo_32(Immediate), dl, i32, false, false);
            let mut ImmH: SDValue = DAG.getConstant(Hi_32(Immediate), dl, i32, false, false);
            ImmL = DAG.getBitcast(v32i1, ImmL);
            ImmH = DAG.getBitcast(v32i1, ImmH);
            DstVec = DAG.getNode(CONCAT_VECTORS, dl, v64i1, ImmL, ImmH);
        } else {
            let mut ImmVT: MVT = getIntegerVT(if VT.getSizeInBits().operator unsigned long long() as u32 > 8 { VT.getSizeInBits().operator unsigned long long() as u32 } else { 8 });
            let mut Imm: SDValue = DAG.getConstant(Immediate, dl, ImmVT, false, false);
            let mut VecVT: MVT = if VT.getSizeInBits().operator unsigned long long() >= 8 { VT } else { v8i1 };
            DstVec = DAG.getBitcast(VecVT, Imm);
            DstVec = DAG.getNode(EXTRACT_SUBVECTOR, dl, VT, DstVec, DAG.getVectorIdxConstant(0, dl, false));
        }
    } else {
        DstVec = DAG.getUNDEF(VT);
    }
    for let mut Idx: u32 = 0;
let mut E: u32 = Op.getNumOperands(); Idx != E; Idx += 1 {
        if NonConstMask & (1 << Idx) {
            DstVec = DAG.getInsertVectorElt(dl, DstVec, Op.getOperand(Idx), Idx);
        }
    }
    return DstVec;
}

fn isHorizOp(Opcode: u32) -> bool {
    match Opcode {
        PACKSS => {
            PACKUS;
        },
    }
    return false;
}

fn isFMAddSubOrFMSubAdd(Subtarget: *X86Subtarget, Opnd0: *mut SDValue, Opnd1: *mut SDValue, Opnd2: *mut SDValue, ExpectedUses: u32, AllowSubAddOrAddSubContract: bool) -> bool {
    if Opnd0.getOpcode() != FMUL || !operator(Opnd0).hasNUsesOfValue(ExpectedUses, 0) || !Subtarget.hasAnyFMA() {
        return false;
    }
    let mut AllowFusion: bool = (AllowSubAddOrAddSubContract && operator(Opnd0).getFlags().hasAllowContract());
    if !AllowFusion {
        return false;
    }
    Opnd2 = Opnd1;
    Opnd1 = Opnd0.getOperand(1);
    Opnd0 = Opnd0.getOperand(0);
    return true;
}

fn lowerBuildVectorToBitOp(Op: *mut BuildVectorSDNode, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType(0);
    let mut NumElems: u32 = VT.getVectorNumElements();
    let mut ElemSize: u32 = VT.getScalarSizeInBits();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Opcode: u32 = Op.getOperand(0).getOpcode();
    for let mut i: u32 = 1; i < NumElems; i += 1 {
        if Opcode != Op.getOperand(i).getOpcode() {
            return SDValue {};
        }
    }
    let mut IsShift: bool = false;
    match Opcode {
        _ => {
            return SDValue {};
        },
        SHL => {
            SRL;
        },
        AND => {
            XOR;
        },
    }
    let mut RHSAllConst: bool = true;
    let mut LHSElts: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut RHSElts: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for Elt in Op.ops() {
        let mut LHS: SDValue = Elt.getOperand(0);
        let mut RHS: SDValue = Elt.getOperand(1);
        RHSAllConst &= isa(RHS);
        LHSElts.push(LHS);
        RHSElts.push(RHS);
    }
    if IsShift {
        if !RHSAllConst {
            return SDValue {};
        }
        for Op1 in RHSElts {
            if Op1.getValueSizeInBits().operator unsigned long long() != ElemSize {
                Op1 = DAG.getZExtOrTrunc(Op1, DL, VT.getScalarType());
            }
        }
        if any_of(RHSElts, Closure_26 { RHSElts: &mut RHSElts }) {
            return SDValue {};
        }
    }
    assert!(all_of(concat(LHSElts, RHSElts), Closure_27 { ElemSize: ElemSize }), "Element size mismatch");
    let mut LHS: SDValue = EltsFromConsecutiveLoads(VT, LHSElts, DL, DAG, Subtarget, true, 0);
    let mut RHS: SDValue = EltsFromConsecutiveLoads(VT, RHSElts, DL, DAG, Subtarget, true, 0);
    if !LHS && !RHS && !RHSAllConst {
        return SDValue {};
    }
    if !LHS {
        LHS = DAG.getBuildVector(VT, DL, LHSElts);
    }
    if !RHS {
        RHS = DAG.getBuildVector(VT, DL, RHSElts);
    }
    let mut Res: SDValue = DAG.getNode(Opcode, DL, VT, LHS, RHS);
    if !IsShift {
        return Res;
    }
    return LowerShift(Res, Subtarget, DAG);
}

fn lowerBuildVectorAsBlend(BVOp: *mut BuildVectorSDNode, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = BVOp.getSimpleValueType(0);
    if VT != v4f64 {
        return SDValue {};
    }
    let mut UniqueOps: SmallSet<SDValue, 16U> = SmallSet<SDValue, 16U> {};
    for Op in BVOp.ops() {
        if isIntOrFPConstant(Op) || Op.isUndef() {
            return SDValue {};
        }
        UniqueOps.insert(Op);
    }
    if UniqueOps.len != 2 {
        return SDValue {};
    }
    let mut Op0: SDValue = BVOp.getOperand(0);
    UniqueOps.erase(Op0);
    let mut Op1: SDValue = operator(UniqueOps.begin());
    if Subtarget.hasAVX2() || isShuffleFoldableLoad(Op0) || isShuffleFoldableLoad(Op1) {
        let mut NumElems: u32 = VT.getVectorNumElements();
        let mut Mask: SmallVector<int, 16U> = NumElems;
        for let mut I: u32 = 0; I < NumElems; I += 1 {
            let mut Op: SDValue = BVOp.getOperand(I);
            Mask[I] = if Op == Op0 { I } else { I + NumElems };
        }
        let mut NewOp0: SDValue = DAG.getSplatBuildVector(VT, DL, Op0);
        let mut NewOp1: SDValue = DAG.getSplatBuildVector(VT, DL, Op1);
        return DAG.getVectorShuffle(VT, DL, NewOp0, NewOp1, Mask);
    }
    return SDValue {};
}

fn widenBuildVector(BVOp: *mut BuildVectorSDNode, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = BVOp.getSimpleValueType(0);
    let mut SVT: MVT = VT.getScalarType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltBits: u32 = SVT.getSizeInBits().operator unsigned long long();
    if SVT != i8 && SVT != i16 && SVT != i32 {
        return SDValue {};
    }
    let mut WideBits: u32 = 2 * EltBits;
    let mut WideSVT: MVT = getIntegerVT(WideBits);
    let mut WideVT: MVT = getVectorVT(WideSVT, NumElts / 2);
    if !DAG.getTargetLoweringInfo().isTypeLegal(WideSVT) {
        return SDValue {};
    }
    let mut WideOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for let mut I: u32 = 0; I != NumElts; I += 2 {
        let mut Op0: SDValue = BVOp.getOperand(I + 0);
        let mut Op1: SDValue = BVOp.getOperand(I + 1);
        if Op0.isUndef() && Op1.isUndef() {
            WideOps.push(DAG.getUNDEF(WideSVT));
            continue;
        }
        let mut X: SDValue = SDValue {};
        let mut Y: SDValue = SDValue {};
        if sd_match(Op0, m_Trunc(m_Value(X))) && sd_match(Op1, m_Trunc(m_Srl(m_Value(Y), m_SpecificInt(EltBits)))) && peekThroughTruncates(X) == peekThroughTruncates(Y) && X.getValueType().bitsGE(WideSVT) {
            if X.getValueType().bitsGT(WideSVT) {
                X = DAG.getNode(TRUNCATE, DL, WideSVT, X);
            }
            WideOps.push(X);
            continue;
        }
        return SDValue {};
    }
    assert!(WideOps.len == (NumElts / 2), "Failed to widen build vector");
    return DAG.getBitcast(VT, DAG.getBuildVector(WideVT, DL, WideOps));
}

fn materializeVectorConstant(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    if isBuildVectorAllZeros(Op.getNode()) {
        return Op;
    }
    if Subtarget.hasSSE2() && isBuildVectorAllOnes(Op.getNode()) {
        if VT == v4i32 || VT == v8i32 || VT == v16i32 {
            return Op;
        }
        return getOnesVector(VT, DAG, DL);
    }
    return SDValue {};
}

fn createVariablePermute(VT: MVT, SrcVec: SDValue, IndicesVec: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut ShuffleVT: MVT = VT;
    let mut IndicesVT: EVT = VT.changeVectorElementTypeToInteger();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    assert!(IndicesVec.getValueType().getVectorNumElements() >= NumElts, "Illegal variable permute mask size");
    if IndicesVec.getValueType().getVectorNumElements() > NumElts {
        if IndicesVec.getValueSizeInBits().operator unsigned long long() > SizeInBits {
            IndicesVec = extractSubVector(IndicesVec, 0, DAG, IndicesVec, NumElts * VT.getScalarSizeInBits());
        } else if IndicesVec.getValueSizeInBits().operator unsigned long long() < SizeInBits {
            IndicesVec = widenSubVector(IndicesVec, false, Subtarget, DAG, IndicesVec, SizeInBits);
        }
        if IndicesVec.getValueType().getVectorNumElements() > NumElts {
            IndicesVec = DAG.getNode(ZERO_EXTEND_VECTOR_INREG, IndicesVec, IndicesVT, IndicesVec);
        }
    }
    IndicesVec = DAG.getZExtOrTrunc(IndicesVec, IndicesVec, IndicesVT);
    if SrcVec.getValueSizeInBits().operator unsigned long long() != SizeInBits {
        if (SrcVec.getValueSizeInBits().operator unsigned long long() % SizeInBits) == 0 {
            let mut Scale: u32 = SrcVec.getValueSizeInBits().operator unsigned long long() / SizeInBits;
            VT = getVectorVT(VT.getScalarType(), Scale * NumElts);
            IndicesVT = VT.changeVectorElementTypeToInteger();
            IndicesVec = widenSubVector(IndicesVT.getSimpleVT(), IndicesVec, false, Subtarget, DAG, IndicesVec);
            let mut NewSrcVec: SDValue = createVariablePermute(VT, SrcVec, IndicesVec, DL, DAG, Subtarget);
            if NewSrcVec {
                return extractSubVector(NewSrcVec, 0, DAG, DL, SizeInBits);
            }
            return SDValue {};
        } else if SrcVec.getValueSizeInBits().operator unsigned long long() < SizeInBits {
            SrcVec = widenSubVector(VT, SrcVec, false, Subtarget, DAG, SrcVec);
        } else {
            return SDValue {};
        }
    }
    let mut ScaleIndices: Closure_28 = Closure_28 { DAG: &mut DAG };
    let mut Opcode: u32 = 0;
    match VT.SimpleTy {
        _ => {
            break;
        },
        v16i8 => {
            if Subtarget.hasSSSE3() {
                Opcode = PSHUFB;
            }
        },
        v8i16 => {
            if Subtarget.hasVLX() && Subtarget.hasBWI() {
                Opcode = VPERMV;
            } else if Subtarget.hasSSSE3() {
                Opcode = PSHUFB;
                ShuffleVT = v16i8;
            }
        },
        v4f32 => {
            v4i32;
        },
        v2f64 => {
            v2i64;
        },
        v32i8 => {
            if Subtarget.hasVLX() && Subtarget.hasVBMI() {
                Opcode = VPERMV;
            } else if Subtarget.hasXOP() {
                let mut LoSrc: SDValue = extract128BitVector(SrcVec, 0, DAG, DL);
                let mut HiSrc: SDValue = extract128BitVector(SrcVec, 16, DAG, DL);
                let mut LoIdx: SDValue = extract128BitVector(IndicesVec, 0, DAG, DL);
                let mut HiIdx: SDValue = extract128BitVector(IndicesVec, 16, DAG, DL);
                return DAG.getNode(CONCAT_VECTORS, DL, VT, DAG.getNode(VPPERM, DL, v16i8, LoSrc, HiSrc, LoIdx), DAG.getNode(VPPERM, DL, v16i8, LoSrc, HiSrc, HiIdx));
            } else if Subtarget.hasAVX() {
                let mut Lo: SDValue = extract128BitVector(SrcVec, 0, DAG, DL);
                let mut Hi: SDValue = extract128BitVector(SrcVec, 16, DAG, DL);
                let mut LoLo: SDValue = DAG.getNode(CONCAT_VECTORS, DL, VT, Lo, Lo);
                let mut HiHi: SDValue = DAG.getNode(CONCAT_VECTORS, DL, VT, Hi, Hi);
                let mut PSHUFBBuilder: Closure_29 = Closure_29 {};
                let mut Ops: [3]SDValue = [LoLo, HiHi, IndicesVec];
                return SplitOpsAndApply(DAG, Subtarget, DL, v32i8, Ops, PSHUFBBuilder, true, true);
            }
        },
        v16i16 => {
            if Subtarget.hasVLX() && Subtarget.hasBWI() {
                Opcode = VPERMV;
            } else if Subtarget.hasAVX() {
                IndicesVec = ScaleIndices.call(IndicesVec, 2);
                return DAG.getBitcast(VT, createVariablePermute(v32i8, DAG.getBitcast(v32i8, SrcVec), DAG.getBitcast(v32i8, IndicesVec), DL, DAG, Subtarget));
            }
        },
        v8f32 => {
            v8i32;
        },
        v4i64 => {
            v4f64;
        },
        v64i8 => {
            if Subtarget.hasVBMI() {
                Opcode = VPERMV;
            }
        },
        v32i16 => {
            if Subtarget.hasBWI() {
                Opcode = VPERMV;
            }
        },
        v16f32 => {
            v16i32;
        },
    }
    if !Opcode {
        return SDValue {};
    }
    assert!((VT.getSizeInBits() == ShuffleVT.getSizeInBits()) && (VT.getScalarSizeInBits() % ShuffleVT.getScalarSizeInBits()) == 0, "Illegal variable permute shuffle type");
    let mut Scale: u64 = VT.getScalarSizeInBits() / ShuffleVT.getScalarSizeInBits();
    if Scale > 1 {
        IndicesVec = ScaleIndices.call(IndicesVec, Scale);
    }
    let mut ShuffleIdxVT: EVT = ShuffleVT.changeVectorElementTypeToInteger();
    IndicesVec = DAG.getBitcast(ShuffleIdxVT, IndicesVec);
    SrcVec = DAG.getBitcast(ShuffleVT, SrcVec);
    let mut Res: SDValue = if Opcode == VPERMV { DAG.getNode(Opcode, DL, ShuffleVT, IndicesVec, SrcVec) } else { DAG.getNode(Opcode, DL, ShuffleVT, SrcVec, IndicesVec) };
    return DAG.getBitcast(VT, Res);
}

fn LowerBUILD_VECTORAsVariablePermute(V: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut SrcVec: SDValue = SDValue {};
    let mut IndicesVec: SDValue = SDValue {};
    for let mut Idx: u32 = 0;
let mut E: u32 = V.getNumOperands(); Idx != E; Idx += 1 {
        let mut Op: SDValue = peekThroughOneUseFreeze(V.getOperand(Idx));
        if Op.getOpcode() != EXTRACT_VECTOR_ELT {
            return SDValue {};
        }
        if !SrcVec {
            SrcVec = Op.getOperand(0);
        } else if SrcVec != Op.getOperand(0) {
            return SDValue {};
        }
        let mut ExtractedIndex: SDValue = operator(Op).getOperand(1);
        if ExtractedIndex.getOpcode() == ZERO_EXTEND || ExtractedIndex.getOpcode() == SIGN_EXTEND {
            ExtractedIndex = ExtractedIndex.getOperand(0);
        }
        if ExtractedIndex.getOpcode() != EXTRACT_VECTOR_ELT {
            return SDValue {};
        }
        if !IndicesVec {
            IndicesVec = ExtractedIndex.getOperand(0);
        } else if IndicesVec != ExtractedIndex.getOperand(0) {
            return SDValue {};
        }
        let mut PermIdx: *mut ConstantSDNode = dyn_cast(ExtractedIndex.getOperand(1));
        if !PermIdx || PermIdx.getAPIntValue() != Idx {
            return SDValue {};
        }
    }
    let mut VT: MVT = V.getSimpleValueType();
    return createVariablePermute(VT, SrcVec, IndicesVec, DL, DAG, Subtarget);
}

fn X86TargetLowering::LowerBUILD_VECTOR(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    let mut EltVT: MVT = VT.getVectorElementType();
    let mut OpEltVT: MVT = Op.getOperand(0).getSimpleValueType();
    let mut NumElems: u32 = Op.getNumOperands();
    if VT.getVectorElementType() == i1 && self.Subtarget.hasAVX512() {
        return LowerBUILD_VECTORvXi1(Op, dl, DAG, self.Subtarget);
    }
    if VT.getVectorElementType() == bf16 && (self.Subtarget.hasAVXNECONVERT() || self.Subtarget.hasBF16()) {
        return LowerBUILD_VECTORvXbf16(Op, DAG, self.Subtarget);
    }
    if materializeVectorConstant(Op, dl, DAG, self.Subtarget) {
        VectorCst;
    } else {
        return VectorCst;
    }
    let mut EVTBits: u32 = EltVT.getSizeInBits().operator unsigned long long();
    let mut UndefMask: APInt = getZero(NumElems);
    let mut FrozenUndefMask: APInt = getZero(NumElems);
    let mut ZeroMask: APInt = getZero(NumElems);
    let mut NonZeroMask: APInt = getZero(NumElems);
    let mut IsAllConstants: bool = true;
    let mut OneUseFrozenUndefs: bool = true;
    let mut Values: SmallSet<SDValue, 8> = SmallSet<SDValue, 8> {};
    let mut NumConstants: u32 = NumElems;
    for let mut i: u32 = 0; i < NumElems; i += 1 {
        let mut Elt: SDValue = Op.getOperand(i);
        if Elt.isUndef() {
            UndefMask.setBit(i);
            continue;
        }
        if isFreezeUndef(Elt.getNode()) {
            OneUseFrozenUndefs = OneUseFrozenUndefs && operator(Elt).hasOneUse();
            FrozenUndefMask.setBit(i);
            continue;
        }
        Values.insert(Elt);
        if !isIntOrFPConstant(Elt) {
            IsAllConstants = false;
            NumConstants -= 1;
        }
        if isZeroNode(Elt) {
            ZeroMask.setBit(i);
        } else {
            NonZeroMask.setBit(i);
        }
    }
    if UndefMask.isAllOnes() {
        return DAG.getUNDEF(VT);
    }
    if OneUseFrozenUndefs && (UndefMask | FrozenUndefMask).isAllOnes() {
        return DAG.getFreeze(DAG.getUNDEF(VT));
    }
    if (UndefMask | FrozenUndefMask | ZeroMask).isAllOnes() {
        return getZeroVector(VT, self.Subtarget, DAG, dl);
    }
    let mut NumFrozenUndefElts: u32 = FrozenUndefMask.popcount();
    if NumFrozenUndefElts >= 2 && NumFrozenUndefElts < NumElems {
        let mut BlendMask: SmallVector<int, 16> = SmallVector<int, 16> { NumElems, -1 };
        let mut Elts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumElems, DAG.getUNDEF(OpEltVT) };
        for let mut i: u32 = 0; i < NumElems; i += 1 {
            if UndefMask[i] {
                BlendMask[i] = -1;
                continue;
            }
            BlendMask[i] = i;
            if !FrozenUndefMask[i] {
                Elts[i] = Op.getOperand(i);
            } else {
                BlendMask[i] += NumElems;
            }
        }
        let mut EltsBV: SDValue = DAG.getBuildVector(VT, dl, Elts);
        let mut FrozenUndefElt: SDValue = DAG.getFreeze(DAG.getUNDEF(OpEltVT));
        let mut FrozenUndefBV: SDValue = DAG.getSplatBuildVector(VT, dl, FrozenUndefElt);
        return DAG.getVectorShuffle(VT, dl, EltsBV, FrozenUndefBV, BlendMask);
    }
    let mut BV: *mut BuildVectorSDNode = cast(Op.getNode());
    if (VT.is256BitVector() || VT.is512BitVector()) && !isFoldableUseOfShuffle(BV) {
        let mut UpperElems: u32 = NumElems / 2;
        let mut UndefOrZeroMask: APInt = FrozenUndefMask | UndefMask | ZeroMask;
        let mut NumUpperUndefsOrZeros: u32 = UndefOrZeroMask.countl_one();
        if NumUpperUndefsOrZeros >= UpperElems {
            if VT.is512BitVector() && NumUpperUndefsOrZeros >= (NumElems - (NumElems / 4)) {
                UpperElems = NumElems - (NumElems / 4);
            }
            let mut UndefUpper: bool = UndefMask.countl_one() >= UpperElems;
            let mut LowerVT: MVT = getVectorVT(EltVT, NumElems - UpperElems);
            let mut NewBV: SDValue = DAG.getBuildVector(LowerVT, dl, operator(Op).ops().drop_back(UpperElems));
            return widenSubVector(VT, NewBV, !UndefUpper, self.Subtarget, DAG, dl);
        }
    }
    if lowerBuildVectorAsBroadcast(BV, dl, self.Subtarget, DAG) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if lowerBuildVectorToBitOp(BV, dl, self.Subtarget, DAG) {
        BitOp;
    } else {
        return BitOp;
    }
    if lowerBuildVectorAsBlend(BV, dl, self.Subtarget, DAG) {
        Blend;
    } else {
        return Blend;
    }
    if widenBuildVector(BV, dl, self.Subtarget, DAG) {
        WideBV;
    } else {
        return WideBV;
    }
    let mut NumZero: u32 = ZeroMask.popcount();
    let mut NumNonZero: u32 = NonZeroMask.popcount();
    if NumConstants == NumElems - 1 && NumNonZero != 1 && FrozenUndefMask.isZero() && (self.isOperationLegalOrCustom(INSERT_VECTOR_ELT, VT, false) || self.isOperationLegalOrCustom(VECTOR_SHUFFLE, VT, false)) {
        let mut Context: *mut LLVMContext = *DAG.getContext();
        let mut EltType: *mut Type = Op.getValueType().getScalarType().getTypeForEVT(Context);
        let mut ConstVecOps: SmallVector<Constant *, 16> = SmallVector<Constant *, 16> { NumElems, get(EltType) };
        let mut VarElt: SDValue = SDValue {};
        let mut InsIndex: SDValue = SDValue {};
        for let mut i: u32 = 0; i != NumElems; i += 1 {
            let mut Elt: SDValue = Op.getOperand(i);
            if dyn_cast(Elt) {
                C;
            } else {
                ConstVecOps[i] = get(Context, C.getAPIntValue());
            }
        }
        let mut CV: *mut Constant = get(ConstVecOps);
        let mut DAGConstVec: SDValue = DAG.getConstantPool(CV, VT, nullopt, 0, false, 0);
        let mut LegalDAGConstVec: SDValue = self.LowerConstantPool(DAGConstVec, DAG);
        let mut MF: *mut MachineFunction = DAG.getMachineFunction();
        let mut MPI: MachinePointerInfo = getConstantPool(MF);
        let mut Ld: SDValue = DAG.getLoad(VT, dl, DAG.getEntryNode(), LegalDAGConstVec, MPI, MaybeAlign {}, MONone, MMOMetadata {});
        let mut InsertC: u32 = operator(InsIndex).getAsZExtVal();
        let mut NumEltsInLow128Bits: u32 = 128 / VT.getScalarSizeInBits();
        if InsertC < NumEltsInLow128Bits {
            return DAG.getNode(INSERT_VECTOR_ELT, dl, VT, Ld, VarElt, InsIndex);
        }
        assert!(VT.getSizeInBits().operator unsigned long long() > 128, "Invalid insertion index?");
        assert!(self.Subtarget.hasAVX(), "Must have AVX with >16-byte vector");
        let mut ShuffleMask: SmallVector<int, 8> = SmallVector<int, 8> {};
        let mut NumElts: u32 = VT.getVectorNumElements();
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            ShuffleMask.push(if i == InsertC { NumElts } else { i });
        }
        let mut S2V: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, VarElt);
        return DAG.getVectorShuffle(VT, dl, Ld, S2V, ShuffleMask);
    }
    if NumNonZero == 1 {
        let mut Idx: u32 = NonZeroMask.countr_zero();
        let mut Item: SDValue = Op.getOperand(Idx);
        if Idx == 0 {
            if NumZero == 0 {
                return DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Item);
            }
            if EltVT == i32 || EltVT == f16 || EltVT == f32 || EltVT == f64 || (EltVT == i64 && self.Subtarget.is64Bit()) || (EltVT == i16 && self.Subtarget.hasFP16()) {
                assert!((VT.is128BitVector() || VT.is256BitVector() || VT.is512BitVector()), "Expected an SSE value type!");
                Item = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Item);
                return getShuffleVectorZeroOrUndef(Item, 0, true, self.Subtarget, DAG);
            }
            if EltVT == i16 || EltVT == i8 {
                Item = DAG.getNode(ZERO_EXTEND, dl, i32, Item);
                let mut ShufVT: MVT = getVectorVT(i32, VT.getSizeInBits().operator unsigned long long() / 32);
                Item = DAG.getNode(SCALAR_TO_VECTOR, dl, ShufVT, Item);
                Item = getShuffleVectorZeroOrUndef(Item, 0, true, self.Subtarget, DAG);
                return DAG.getBitcast(VT, Item);
            }
        }
        if NumElems == 2 && Idx == 1 && isZeroNode(Op.getOperand(0)) && !isZeroNode(Op.getOperand(1)) {
            let mut NumBits: u32 = VT.getSizeInBits().operator unsigned long long();
            return getVShift(true, VT, DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Op.getOperand(1)), NumBits / 2, DAG, *self, dl);
        }
        if IsAllConstants {
            return SDValue {};
        }
        if EVTBits == 32 {
            Item = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Item);
            return getShuffleVectorZeroOrUndef(Item, Idx, NumZero > 0, self.Subtarget, DAG);
        }
    }
    if Values.len == 1 {
        if EVTBits == 32 {
            let mut Idx: u32 = NonZeroMask.countr_zero();
            let mut Item: SDValue = Op.getOperand(Idx);
            if Op.getNode().isOnlyUserOf(Item.getNode()) {
                return LowerAsSplatVectorLoad(Item, VT, dl, DAG);
            }
        }
        return SDValue {};
    }
    if IsAllConstants {
        return SDValue {};
    }
    if LowerBUILD_VECTORAsVariablePermute(Op, dl, DAG, self.Subtarget) {
        V;
    } else {
        return V;
    }
    {
        let mut Ops: SmallVector<SDValue, 64> = operator(Op).ops().take_front(NumElems);
        if EltsFromConsecutiveLoads(VT, Ops, dl, DAG, self.Subtarget, false, 0) {
            LD;
        } else {
            return LD;
        }
    }
    if self.Subtarget.hasAVX2() && EVTBits == 32 && Values.len == 2 {
        let mut Ops: [4]SDValue = [Op.getOperand(0), Op.getOperand(1), DAG.getUNDEF(EltVT), DAG.getUNDEF(EltVT)];
        let mut CanSplat: Closure_30 = Closure_30 {};
        if CanSplat.call(Op, NumElems, Ops) {
            let mut WideEltVT: MVT = if VT.isFloatingPoint() { f64 } else { i64 };
            let mut NarrowVT: MVT = getVectorVT(EltVT, 4);
            let mut NewBV: SDValue = DAG.getBitcast(getVectorVT(WideEltVT, 2), DAG.getBuildVector(NarrowVT, dl, Ops));
            let mut BcastVT: MVT = getVectorVT(WideEltVT, NumElems / 2);
            return DAG.getBitcast(VT, DAG.getNode(VBROADCAST, dl, BcastVT, NewBV));
        }
    }
    if VT.getSizeInBits().operator unsigned long long() > 128 {
        let mut HVT: MVT = getVectorVT(EltVT, NumElems / 2);
        let mut Lower: SDValue = DAG.getBuildVector(HVT, dl, operator(Op).ops().slice(0, NumElems / 2));
        let mut Upper: SDValue = DAG.getBuildVector(HVT, dl, operator(Op).ops().slice(NumElems / 2, NumElems / 2));
        return concatSubVectors(Lower, Upper, DAG, dl);
    }
    if EVTBits == 64 {
        if NumNonZero == 1 {
            let mut Idx: u32 = NonZeroMask.countr_zero();
            let mut V2: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Op.getOperand(Idx));
            return getShuffleVectorZeroOrUndef(V2, Idx, true, self.Subtarget, DAG);
        }
        return SDValue {};
    }
    if EVTBits == 8 && NumElems == 16 {
        if LowerBuildVectorv16i8(Op, dl, NonZeroMask, NumNonZero, NumZero, DAG, self.Subtarget) {
            V;
        } else {
            return V;
        }
    }
    if EltVT == i16 && NumElems == 8 {
        if LowerBuildVectorv8i16(Op, dl, NonZeroMask, NumNonZero, NumZero, DAG, self.Subtarget) {
            V;
        } else {
            return V;
        }
    }
    if EVTBits == 32 && NumElems == 4 {
        if LowerBuildVectorv4x32(Op, dl, DAG, self.Subtarget) {
            V;
        } else {
            return V;
        }
    }
    if NumElems == 4 && NumZero > 0 {
        let mut Ops: SmallVector<SDValue, 8> = NumElems;
        for let mut i: u32 = 0; i < 4; i += 1 {
            let mut isZero: bool = !NonZeroMask[i];
            if isZero {
                Ops[i] = getZeroVector(VT, self.Subtarget, DAG, dl);
            } else {
                Ops[i] = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Op.getOperand(i));
            }
        }
        for let mut i: u32 = 0; i < 2; i += 1 {
            match NonZeroMask.extractBitsAsZExtValue(2, i * 2) {
                _ => {
                    llvm_unreachable_internal("Unexpected NonZero count", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 9865);
                },
                0 => {
                    Ops[i] = Ops[i * 2];
                },
                1 => {
                    Ops[i] = self.getMOVL(DAG, dl, VT, Ops[i * 2 + 1], Ops[i * 2]);
                },
                2 => {
                    Ops[i] = self.getMOVL(DAG, dl, VT, Ops[i * 2], Ops[i * 2 + 1]);
                },
                3 => {
                    Ops[i] = getUnpackl(DAG, dl, VT, Ops[i * 2], Ops[i * 2 + 1]);
                },
            }
        }
        let mut Reverse1: bool = NonZeroMask.extractBitsAsZExtValue(2, 0) == 2;
        let mut Reverse2: bool = NonZeroMask.extractBitsAsZExtValue(2, 2) == 2;
        let mut MaskVec: [4]i32 = [if Reverse1 { 1 } else { 0 }, if Reverse1 { 0 } else { 1 }, if Reverse2 { NumElems + 1 } else { NumElems } as i32, if Reverse2 { NumElems } else { NumElems + 1 } as i32];
        return DAG.getVectorShuffle(VT, dl, Ops[0], Ops[1], MaskVec);
    }
    assert!(Values.len > 1, "Expected non-undef and non-splat vector");
    if buildFromShuffleMostly(Op, dl, DAG) {
        Sh;
    } else {
        return Sh;
    }
    if self.Subtarget.hasSSE41() && EltVT != f16 {
        let mut Result: SDValue = SDValue {};
        if !Op.getOperand(0).isUndef() {
            Result = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Op.getOperand(0));
        } else {
            Result = DAG.getUNDEF(VT);
        }
        for let mut i: u32 = 1; i < NumElems; i += 1 {
            if Op.getOperand(i).isUndef() {
                continue;
            }
            Result = DAG.getNode(INSERT_VECTOR_ELT, dl, VT, Result, Op.getOperand(i), DAG.getVectorIdxConstant(i, dl, false));
        }
        return Result;
    }
    let mut Ops: SmallVector<SDValue, 8> = NumElems;
    for let mut i: u32 = 0; i < NumElems; i += 1 {
        if !Op.getOperand(i).isUndef() {
            Ops[i] = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Op.getOperand(i));
        } else {
            Ops[i] = DAG.getUNDEF(VT);
        }
    }
    for let mut Scale: u32 = 1; Scale < NumElems; Scale *= 2 {
        let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
        for let mut i: u32 = 0; i != Scale; i += 1 {
            Mask.push(i);
        }
        for let mut i: u32 = 0; i != Scale; i += 1 {
            Mask.push(NumElems + i);
        }
        Mask.append(NumElems - Mask.len, SM_SentinelUndef);
        for let mut i: u32 = 0;
let mut e: u32 = NumElems / (2 * Scale); i != e; i += 1 {
            Ops[i] = DAG.getVectorShuffle(VT, dl, Ops[2 * i], Ops[(2 * i) + 1], Mask);
        }
    }
    return Ops[0];
}

fn LowerAVXCONCAT_VECTORS(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut ResVT: MVT = Op.getSimpleValueType();
    assert!((ResVT.is256BitVector() || ResVT.is512BitVector()), "Value type must be 256-/512-bit wide");
    let mut Ops: SmallVector<SDValue, 4> = operator(Op).ops();
    let mut NumSubElems: u32 = Ops[0].getSimpleValueType().getVectorNumElements();
    let mut NumOperands: u32 = Op.getNumOperands();
    let mut NumFreezeUndef: u32 = 0;
    let mut NumZero: u32 = 0;
    let mut NumNonZero: u32 = 0;
    let mut NonZeros: u32 = 0;
    let mut Undefs: SmallSet<SDValue, 4> = SmallSet<SDValue, 4> {};
    for x in enumerate(Ops) {
        if SubVec.isUndef() {
            continue;
        }
        if isFreezeUndef(SubVec.getNode()) {
            if SubVec.hasOneUse() {
                NumFreezeUndef += 1;
            } else {
                NumZero += 1;
                Undefs.insert(SubVec);
            }
        } else if isBuildVectorAllZeros(SubVec.getNode()) {
            NumZero += 1;
        } else {
            assert!(I < (NonZeros) * 8);
            NonZeros |= 1 << I;
            NumNonZero += 1;
        }
    }
    if NumNonZero > 2 {
        let mut HalfVT: MVT = ResVT.getHalfNumVectorElementsVT();
        let mut Lo: SDValue = DAG.getNode(CONCAT_VECTORS, dl, HalfVT, Ops.slice(0, NumOperands / 2));
        let mut Hi: SDValue = DAG.getNode(CONCAT_VECTORS, dl, HalfVT, Ops.slice(NumOperands / 2));
        return DAG.getNode(CONCAT_VECTORS, dl, ResVT, Lo, Hi);
    }
    let mut Vec: SDValue = if NumZero { getZeroVector(ResVT, Subtarget, DAG, dl) } else { (if NumFreezeUndef { DAG.getFreeze(DAG.getUNDEF(ResVT)) } else { DAG.getUNDEF(ResVT) }) };
    for U in Undefs {
        DAG.ReplaceAllUsesWith(U, getZeroVector(U.getSimpleValueType(), Subtarget, DAG, dl));
    }
    for x in enumerate(Ops) {
        if (NonZeros & (1 << I)) == 0 {
            continue;
        }
        Vec = DAG.getNode(INSERT_SUBVECTOR, dl, ResVT, Vec, SubVec, DAG.getVectorIdxConstant(I * NumSubElems, dl, false));
    }
    return Vec;
}

fn LowerCONCAT_VECTORSvXi1(Op: SDValue, dl: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut ResVT: MVT = Op.getSimpleValueType();
    let mut NumOperands: u32 = Op.getNumOperands();
    assert!(NumOperands > 1 && isPowerOf2_32(NumOperands), "Unexpected number of operands in CONCAT_VECTORS");
    let mut Zeros: u64 = 0;
    let mut NonZeros: u64 = 0;
    for let mut i: u32 = 0; i != NumOperands; i += 1 {
        let mut SubVec: SDValue = Op.getOperand(i);
        if SubVec.isUndef() {
            continue;
        }
        assert!(i < (NonZeros) * 8);
        if isBuildVectorAllZeros(SubVec.getNode()) {
            Zeros |= 1 as u64 << i;
        } else {
            NonZeros |= 1 as u64 << i;
        }
    }
    let mut NumElems: u32 = ResVT.getVectorNumElements();
    if isPowerOf2_64(NonZeros) && Zeros != 0 && NonZeros > Zeros && Log2_64(NonZeros) != NumOperands - 1 {
        let mut Idx: u32 = Log2_64(NonZeros);
        let mut SubVec: SDValue = Op.getOperand(Idx);
        let mut SubVecNumElts: u32 = SubVec.getSimpleValueType().getVectorNumElements();
        let mut ShiftVT: MVT = widenMaskVectorType(ResVT, Subtarget);
        Op = widenSubVector(ShiftVT, SubVec, false, Subtarget, DAG, dl);
        Op = DAG.getNode(KSHIFTL, dl, ShiftVT, Op, DAG.getTargetConstant(Idx * SubVecNumElts, dl, i8, false));
        return DAG.getNode(EXTRACT_SUBVECTOR, dl, ResVT, Op, DAG.getVectorIdxConstant(0, dl, false));
    }
    if NonZeros == 0 || isPowerOf2_64(NonZeros) {
        let mut Vec: SDValue = if Zeros { DAG.getConstant(0, dl, ResVT, false, false) } else { DAG.getUNDEF(ResVT) };
        if !NonZeros {
            return Vec;
        }
        let mut Idx: u32 = Log2_64(NonZeros);
        let mut SubVec: SDValue = Op.getOperand(Idx);
        let mut SubVecNumElts: u32 = SubVec.getSimpleValueType().getVectorNumElements();
        return DAG.getNode(INSERT_SUBVECTOR, dl, ResVT, Vec, SubVec, DAG.getVectorIdxConstant(Idx * SubVecNumElts, dl, false));
    }
    if NumOperands > 2 {
        let mut HalfVT: MVT = ResVT.getHalfNumVectorElementsVT();
        let mut Ops: ArrayRef<SDUse> = operator(Op).ops();
        let mut Lo: SDValue = DAG.getNode(CONCAT_VECTORS, dl, HalfVT, Ops.slice(0, NumOperands / 2));
        let mut Hi: SDValue = DAG.getNode(CONCAT_VECTORS, dl, HalfVT, Ops.slice(NumOperands / 2));
        return DAG.getNode(CONCAT_VECTORS, dl, ResVT, Lo, Hi);
    }
    assert!(popcount(NonZeros) == 2, "Simple cases not handled?");
    if ResVT.getVectorNumElements() >= 16 {
        return Op;
    }
    let mut Vec: SDValue = DAG.getNode(INSERT_SUBVECTOR, dl, ResVT, DAG.getUNDEF(ResVT), Op.getOperand(0), DAG.getVectorIdxConstant(0, dl, false));
    return DAG.getNode(INSERT_SUBVECTOR, dl, ResVT, Vec, Op.getOperand(1), DAG.getVectorIdxConstant(NumElems / 2, dl, false));
}

fn LowerCONCAT_VECTORS(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    if VT.getVectorElementType() == i1 {
        return LowerCONCAT_VECTORSvXi1(Op, DL, Subtarget, DAG);
    }
    assert!((VT.is256BitVector() && Op.getNumOperands() == 2) || (VT.is512BitVector() && (Op.getNumOperands() == 2 || Op.getNumOperands() == 4);
    return LowerAVXCONCAT_VECTORS(Op, DL, DAG, Subtarget);
}

fn IsElementEquivalent(MaskSize: i32, Op: SDValue, ExpectedOp: SDValue, Idx: i32, ExpectedIdx: i32) -> bool {
    assert!(0 <= Idx && Idx < MaskSize && 0 <= ExpectedIdx && ExpectedIdx < MaskSize, "Out of range element index");
    if !Op || !ExpectedOp || Op.getOpcode() != ExpectedOp.getOpcode() {
        return false;
    }
    let mut VT: EVT = Op.getValueType();
    let mut ExpectedVT: EVT = ExpectedOp.getValueType();
    if !VT.isVector() || !ExpectedVT.isVector() || VT.getVectorNumElements() as i32 != MaskSize || ExpectedVT.getVectorNumElements() as i32 != MaskSize {
        return false;
    }
    if Idx == ExpectedIdx && Op == ExpectedOp {
        return true;
    }
    match Op.getOpcode() {
        BUILD_VECTOR => {
            return Op.getOperand(Idx) == ExpectedOp.getOperand(ExpectedIdx);
        },
        BITCAST => {
            let mut Src: SDValue = peekThroughBitcasts(Op);
            let mut SrcVT: EVT = Src.getValueType();
            if Op == ExpectedOp && SrcVT.isVector() {
                if (SrcVT.getScalarSizeInBits() % VT.getScalarSizeInBits()) == 0 {
                    let mut Scale: u32 = SrcVT.getScalarSizeInBits() / VT.getScalarSizeInBits();
                    return (Idx % Scale) == (ExpectedIdx % Scale) && IsElementEquivalent(SrcVT.getVectorNumElements(), Src, Src, Idx / Scale, ExpectedIdx / Scale);
                }
                if (VT.getScalarSizeInBits() % SrcVT.getScalarSizeInBits()) == 0 {
                    let mut Scale: u32 = VT.getScalarSizeInBits() / SrcVT.getScalarSizeInBits();
                    for let mut I: u32 = 0; I != Scale; I += 1 {
                        if !IsElementEquivalent(SrcVT.getVectorNumElements(), Src, Src, (Idx * Scale) + I, (ExpectedIdx * Scale) + I) {
                            return false;
                        }
                    }
                    return true;
                }
            }
            break;
        },
        VECTOR_SHUFFLE => {
            let mut SVN: *mut ShuffleVectorSDNode = cast(Op);
            return Op == ExpectedOp && SVN.getMaskElt(Idx) == SVN.getMaskElt(ExpectedIdx);
        },
        VBROADCAST => {
            VBROADCAST_LOAD;
        },
        SUBV_BROADCAST_LOAD => {
            if Op == ExpectedOp {
                let mut MemOp: *mut MemSDNode = cast(Op);
                let mut NumMemElts: u32 = MemOp.getMemoryVT().getVectorNumElements();
                return (Idx % NumMemElts) == (ExpectedIdx % NumMemElts);
            }
        },
        VPERMI => {
            if Op == ExpectedOp {
                let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> {};
                DecodeVPERMMask(MaskSize, Op.getConstantOperandVal(1), Mask);
                let mut Src: SDValue = Op.getOperand(0);
                return IsElementEquivalent(MaskSize, Src, Src, Mask[Idx], Mask[ExpectedIdx]);
            }
            break;
        },
        HADD => {
            HSUB;
        },
    }
    return false;
}

fn isNoopShuffleMask(Mask: ArrayRef<int>) -> bool {
    for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
        assert!(Mask[i] >= -1, "Out of bound mask element!");
        if Mask[i] >= 0 && Mask[i] != i {
            return false;
        }
    }
    return true;
}

fn isLaneCrossingShuffleMask(LaneSizeInBits: u32, ScalarSizeInBits: u32, Mask: ArrayRef<int>) -> bool {
    assert!(LaneSizeInBits && ScalarSizeInBits && (LaneSizeInBits % ScalarSizeInBits) == 0, "Illegal shuffle lane size");
    let mut LaneSize: i32 = LaneSizeInBits / ScalarSizeInBits;
    let mut Size: i32 = Mask.len;
    for let mut i: i32 = 0; i < Size; i += 1 {
        if Mask[i] >= 0 && (Mask[i] % Size) / LaneSize != i / LaneSize {
            return true;
        }
    }
    return false;
}

fn is128BitLaneCrossingShuffleMask(VT: MVT, Mask: ArrayRef<int>) -> bool {
    return isLaneCrossingShuffleMask(128, VT.getScalarSizeInBits(), Mask);
}

fn isMultiLaneShuffleMask(LaneSizeInBits: u32, ScalarSizeInBits: u32, Mask: ArrayRef<int>) -> bool {
    assert!(LaneSizeInBits && ScalarSizeInBits && (LaneSizeInBits % ScalarSizeInBits) == 0, "Illegal shuffle lane size");
    let mut NumElts: i32 = Mask.len;
    let mut NumEltsPerLane: i32 = LaneSizeInBits / ScalarSizeInBits;
    let mut NumLanes: i32 = NumElts / NumEltsPerLane;
    if NumLanes > 1 {
        for let mut i: i32 = 0; i != NumLanes; i += 1 {
            let mut SrcLane: i32 = -1;
            for let mut j: i32 = 0; j != NumEltsPerLane; j += 1 {
                let mut M: i32 = Mask[(i * NumEltsPerLane) + j];
                if M < 0 {
                    continue;
                }
                let mut Lane: i32 = (M % NumElts) / NumEltsPerLane;
                if SrcLane >= 0 && SrcLane != Lane {
                    return true;
                }
                SrcLane = Lane;
            }
        }
    }
    return false;
}

fn isRepeatedShuffleMask(LaneSizeInBits: u32, VT: MVT, Mask: ArrayRef<int>, RepeatedMask: *mut SmallVectorImpl<int>) -> bool {
    let mut LaneSize: u64 = LaneSizeInBits / VT.getScalarSizeInBits();
    RepeatedMask.assign(LaneSize, -1);
    let mut Size: i32 = Mask.len;
    for let mut i: i32 = 0; i < Size; i += 1 {
        assert!(Mask[i] == SM_SentinelUndef || Mask[i] >= 0);
        if Mask[i] < 0 {
            continue;
        }
        if (Mask[i] % Size) / LaneSize != i / LaneSize {
            return false;
        }
        let mut LocalM: i32 = if Mask[i] < Size { Mask[i] % LaneSize } else { Mask[i] % LaneSize + LaneSize };
        if RepeatedMask[i % LaneSize] < 0 {
            RepeatedMask[i % LaneSize] = LocalM;
        } else if RepeatedMask[i % LaneSize] != LocalM {
            return false;
        }
    }
    return true;
}

fn is128BitLaneRepeatedShuffleMask(VT: MVT, Mask: ArrayRef<int>, RepeatedMask: *mut SmallVectorImpl<int>) -> bool {
    return isRepeatedShuffleMask(128, VT, Mask, RepeatedMask);
}

fn is128BitLaneRepeatedShuffleMask(VT: MVT, Mask: ArrayRef<int>) -> bool {
    let mut RepeatedMask: SmallVector<int, 32> = SmallVector<int, 32> {};
    return isRepeatedShuffleMask(128, VT, Mask, RepeatedMask);
}

fn is256BitLaneRepeatedShuffleMask(VT: MVT, Mask: ArrayRef<int>, RepeatedMask: *mut SmallVectorImpl<int>) -> bool {
    return isRepeatedShuffleMask(256, VT, Mask, RepeatedMask);
}

fn isRepeatedTargetShuffleMask(LaneSizeInBits: u32, EltSizeInBits: u32, Mask: ArrayRef<int>, RepeatedMask: *mut SmallVectorImpl<int>) -> bool {
    let mut LaneSize: i32 = LaneSizeInBits / EltSizeInBits;
    RepeatedMask.assign(LaneSize, SM_SentinelUndef);
    let mut Size: i32 = Mask.len;
    for let mut i: i32 = 0; i < Size; i += 1 {
        assert!(isUndefOrZero(Mask[i]) || (Mask[i] >= 0);
        if Mask[i] == SM_SentinelUndef {
            continue;
        }
        if Mask[i] == SM_SentinelZero {
            if !isUndefOrZero(RepeatedMask[i % LaneSize]) {
                return false;
            }
            RepeatedMask[i % LaneSize] = SM_SentinelZero;
            continue;
        }
        if (Mask[i] % Size) / LaneSize != i / LaneSize {
            return false;
        }
        let mut LaneM: i32 = Mask[i] / Size;
        let mut LocalM: i32 = (Mask[i] % LaneSize) + (LaneM * LaneSize);
        if RepeatedMask[i % LaneSize] == SM_SentinelUndef {
            RepeatedMask[i % LaneSize] = LocalM;
        } else if RepeatedMask[i % LaneSize] != LocalM {
            return false;
        }
    }
    return true;
}

fn isRepeatedTargetShuffleMask(LaneSizeInBits: u32, VT: MVT, Mask: ArrayRef<int>, RepeatedMask: *mut SmallVectorImpl<int>) -> bool {
    return isRepeatedTargetShuffleMask(LaneSizeInBits, VT.getScalarSizeInBits(), Mask, RepeatedMask);
}

fn isShuffleEquivalent(Mask: ArrayRef<int>, ExpectedMask: ArrayRef<int>, V1: SDValue, V2: SDValue) -> bool {
    let mut Size: i32 = Mask.len;
    if Size != ExpectedMask.len as i32 {
        return false;
    }
    for let mut i: i32 = 0; i < Size; i += 1 {
        assert!(Mask[i] >= -1, "Out of bound mask element!");
        let mut MaskIdx: i32 = Mask[i];
        let mut ExpectedIdx: i32 = ExpectedMask[i];
        if 0 <= MaskIdx && MaskIdx != ExpectedIdx {
            let mut MaskV: SDValue = if MaskIdx < Size { V1 } else { V2 };
            let mut ExpectedV: SDValue = if ExpectedIdx < Size { V1 } else { V2 };
            MaskIdx = if MaskIdx < Size { MaskIdx } else { (MaskIdx - Size) };
            ExpectedIdx = if ExpectedIdx < Size { ExpectedIdx } else { (ExpectedIdx - Size) };
            if !IsElementEquivalent(Size, MaskV, ExpectedV, MaskIdx, ExpectedIdx) {
                return false;
            }
        }
    }
    return true;
}

fn isTargetShuffleEquivalent(VT: MVT, Mask: ArrayRef<int>, ExpectedMask: ArrayRef<int>, DAG: *SelectionDAG, V1: SDValue, V2: SDValue) -> bool {
    let mut Size: i32 = Mask.len;
    if Size != ExpectedMask.len as i32 {
        return false;
    }
    assert!(all_of(ExpectedMask, Closure_31 { Size: Size }), "Illegal target shuffle mask");
    if !isUndefOrZeroOrInRange(Mask, 0, 2 * Size) {
        return false;
    }
    if V1 && (V1.getValueSizeInBits() != VT.getSizeInBits() || !V1.getValueType().isVector()) {
        V1 = SDValue {};
    }
    if V2 && (V2.getValueSizeInBits() != VT.getSizeInBits() || !V2.getValueType().isVector()) {
        V2 = SDValue {};
    }
    let mut ZeroV1: APInt = getZero(Size);
    let mut ZeroV2: APInt = getZero(Size);
    for let mut i: i32 = 0; i < Size; i += 1 {
        let mut MaskIdx: i32 = Mask[i];
        let mut ExpectedIdx: i32 = ExpectedMask[i];
        if MaskIdx == SM_SentinelUndef || MaskIdx == ExpectedIdx {
            continue;
        }
        if ExpectedIdx < 0 {
            return false;
        }
        if MaskIdx == SM_SentinelZero {
            let mut ExpectedV: SDValue = if ExpectedIdx < Size { V1 } else { V2 };
            if ExpectedV && Size == ExpectedV.getValueType().getVectorNumElements() as i32 {
                let mut BitIdx: i32 = if ExpectedIdx < Size { ExpectedIdx } else { (ExpectedIdx - Size) };
                let mut ZeroMask: *mut APInt = if ExpectedIdx < Size { ZeroV1 } else { ZeroV2 };
                ZeroMask.setBit(BitIdx);
                continue;
            }
        }
        if MaskIdx >= 0 {
            let mut MaskV: SDValue = if MaskIdx < Size { V1 } else { V2 };
            let mut ExpectedV: SDValue = if ExpectedIdx < Size { V1 } else { V2 };
            MaskIdx = if MaskIdx < Size { MaskIdx } else { (MaskIdx - Size) };
            ExpectedIdx = if ExpectedIdx < Size { ExpectedIdx } else { (ExpectedIdx - Size) };
            if IsElementEquivalent(Size, MaskV, ExpectedV, MaskIdx, ExpectedIdx) {
                continue;
            }
        }
        return false;
    }
    return (ZeroV1.isZero() || (DAG.MaskedVectorIsZero(V1, ZeroV1, 0) && DAG.isGuaranteedNotToBeUndefOrPoison(V1, ZeroV1, UndefOrPoison, 0))) && (ZeroV2.isZero() || (DAG.MaskedVectorIsZero(V2, ZeroV2, 0) && DAG.isGuaranteedNotToBeUndefOrPoison(V2, ZeroV2, UndefOrPoison, 0)));
}

fn isUnpackWdShuffleMask(Mask: ArrayRef<int>, VT: MVT, DAG: *SelectionDAG) -> bool {
    if VT != v8i32 && VT != v8f32 {
        return false;
    }
    let mut Unpcklwd: SmallVector<int, 8> = SmallVector<int, 8> {};
    createUnpackShuffleMask(v8i16, Unpcklwd, true, false);
    let mut Unpckhwd: SmallVector<int, 8> = SmallVector<int, 8> {};
    createUnpackShuffleMask(v8i16, Unpckhwd, false, false);
    let mut IsUnpackwdMask: bool = (isTargetShuffleEquivalent(VT, Mask, Unpcklwd, DAG, SDValue {}, SDValue {}) || isTargetShuffleEquivalent(VT, Mask, Unpckhwd, DAG, SDValue {}, SDValue {}));
    return IsUnpackwdMask;
}

fn is128BitUnpackShuffleMask(Mask: ArrayRef<int>, DAG: *SelectionDAG) -> bool {
    let mut EltVT: MVT = getIntegerVT(128 / Mask.len);
    let mut VT: MVT = getVectorVT(EltVT, Mask.len);
    let mut CommutedMask: SmallVector<int, 4> = Mask;
    commuteMask(CommutedMask);
    for let mut i: u32 = 0; i != 4; i += 1 {
        let mut UnpackMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        createUnpackShuffleMask(VT, UnpackMask, (i >> 1) % 2, i % 2);
        if isTargetShuffleEquivalent(VT, Mask, UnpackMask, DAG, SDValue {}, SDValue {}) || isTargetShuffleEquivalent(VT, CommutedMask, UnpackMask, DAG, SDValue {}, SDValue {}) {
            return true;
        }
    }
    return false;
}

fn hasIdenticalHalvesShuffleMask(Mask: ArrayRef<int>) -> bool {
    assert!(Mask.len % 2 == 0, "Expecting even number of elements in mask");
    let mut HalfSize: u32 = Mask.len / 2;
    for let mut i: u32 = 0; i != HalfSize; i += 1 {
        if Mask[i] != Mask[i + HalfSize] {
            return false;
        }
    }
    return true;
}

fn getV4X86ShuffleImm(Mask: ArrayRef<int>) -> u32 {
    assert!(Mask.len == 4, "Only 4-lane shuffle masks");
    assert!(Mask[0] >= -1 && Mask[0] < 4, "Out of bound mask element!");
    assert!(Mask[1] >= -1 && Mask[1] < 4, "Out of bound mask element!");
    assert!(Mask[2] >= -1 && Mask[2] < 4, "Out of bound mask element!");
    assert!(Mask[3] >= -1 && Mask[3] < 4, "Out of bound mask element!");
    let mut FirstIndex: i32 = find_if(Mask, Closure_32 {}) - Mask.begin();
    assert!(0 <= FirstIndex && FirstIndex < 4, "All undef shuffle mask");
    let mut FirstElt: i32 = Mask[FirstIndex];
    if all_of(Mask, Closure_33 { FirstElt: FirstElt }) {
        return (FirstElt << 6) | (FirstElt << 4) | (FirstElt << 2) | FirstElt;
    }
    let mut Imm: u32 = 0;
    Imm |= (if Mask[0] < 0 { 0 } else { Mask[0] }) << 0;
    Imm |= (if Mask[1] < 0 { 1 } else { Mask[1] }) << 2;
    Imm |= (if Mask[2] < 0 { 2 } else { Mask[2] }) << 4;
    Imm |= (if Mask[3] < 0 { 3 } else { Mask[3] }) << 6;
    return Imm;
}

fn getV4X86ShuffleImm8ForMask(Mask: ArrayRef<int>, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    return DAG.getTargetConstant(getV4X86ShuffleImm(Mask), DL, i8, false);
}

fn getSHUFPDImm(Mask: ArrayRef<int>) -> u32 {
    assert!((Mask.len == 2 || Mask.len == 4 || Mask.len == 8), "Unexpected SHUFPD mask size");
    assert!(all_of(Mask, Closure_34 {}), "Unexpected SHUFPD mask elements");
    let mut FirstIndex: i32 = find_if(Mask, Closure_35 {}) - Mask.begin();
    assert!(0 <= FirstIndex && FirstIndex < Mask.len as i32, "All undef shuffle mask");
    let mut FirstElt: i32 = Mask[FirstIndex];
    if all_of(Mask, Closure_36 { FirstElt: FirstElt }) && count_if(Mask, Closure_37 { FirstElt: FirstElt }) > 1 {
        let mut Imm: u32 = 0;
        for let mut I: u32 = 0;
let mut E: u32 = Mask.len; I != E; I += 1 {
            Imm |= FirstElt << I;
        }
        return Imm;
    }
    let mut Imm: u32 = 0;
    for let mut I: u32 = 0;
let mut E: u32 = Mask.len; I != E; I += 1 {
        Imm |= (if Mask[I] < 0 { (I & 1) } else { Mask[I] }) << I;
    }
    return Imm;
}

fn getSHUFPDImmForMask(Mask: ArrayRef<int>, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    return DAG.getTargetConstant(getSHUFPDImm(Mask), DL, i8, false);
}

fn isNonZeroElementsInOrder(Zeroable: *APInt, Mask: ArrayRef<int>, VectorType: *EVT, IsZeroSideLeft: *mut bool) -> bool {
    let mut NextElement: i32 = -1;
    for let mut i: i32 = 0;
let mut e: i32 = Mask.len; i < e; i += 1 {
        assert!(Mask[i] >= -1, "Out of bound mask element!");
        if Mask[i] < 0 {
            return false;
        }
        if Zeroable[i] {
            continue;
        }
        if NextElement < 0 {
            NextElement = if Mask[i] != 0 { VectorType.getVectorNumElements() } else { 0 };
            IsZeroSideLeft = NextElement != 0;
        }
        if NextElement != Mask[i] {
            return false;
        }
        NextElement += 1;
    }
    return true;
}

fn lowerShuffleWithPSHUFB(DL: *SDLoc, VT: MVT, Mask: ArrayRef<int>, V1: SDValue, V2: SDValue, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut Size: i32 = Mask.len;
    let mut LaneSize: i32 = 128 / VT.getScalarSizeInBits();
    let mut NumBytes: i32 = VT.getSizeInBits().operator unsigned long long() / 8;
    let mut NumEltBytes: i32 = VT.getScalarSizeInBits() / 8;
    assert!((Subtarget.hasSSSE3() && VT.is128BitVector()) || (Subtarget.hasAVX2() && VT.is256BitVector()) || (Subtarget.hasBWI() && VT.is512BitVector();
    let mut PSHUFBMask: SmallVector<int, 64> = SmallVector<int, 64> { NumBytes, -1 };
    let mut V: SDValue = SDValue {};
    for let mut i: i32 = 0; i < NumBytes; i += 1 {
        let mut M: i32 = Mask[i / NumEltBytes];
        if M < 0 {
            continue;
        }
        if Zeroable[i / NumEltBytes] {
            PSHUFBMask[i] = 128;
            continue;
        }
        let mut SrcV: SDValue = (if M >= Size { V2 } else { V1 });
        if V && V != SrcV {
            return SDValue {};
        }
        V = SrcV;
        M %= Size;
        if (M / LaneSize) != ((i / NumEltBytes) / LaneSize) {
            return SDValue {};
        }
        M = M % LaneSize;
        M = M * NumEltBytes + (i % NumEltBytes);
        PSHUFBMask[i] = M;
    }
    assert!(V, "Failed to find a source input");
    let mut I8VT: MVT = getVectorVT(i8, NumBytes);
    let mut R: SDValue = getConstVector(PSHUFBMask, I8VT, DAG, DL, true);
    R = DAG.getNode(PSHUFB, DL, I8VT, DAG.getBitcast(I8VT, V), R);
    return DAG.getBitcast(VT, R);
}

fn getMaskNode(Mask: SDValue, MaskVT: MVT, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut SrcVT: MVT = Mask.getSimpleValueType();
    assert!(SrcVT.isScalarInteger(), "Expected scalar integer mask source!");
    assert!(MaskVT.bitsLE(SrcVT), "Unexpected mask size!");
    assert!(MaskVT.getVectorElementType() == i1, "Bool vector expected!");
    if isAllOnesConstant(Mask) {
        return DAG.getConstant(1, dl, MaskVT, false, false);
    }
    if isZeroNode(Mask) {
        return DAG.getConstant(0, dl, MaskVT, false, false);
    }
    if SrcVT.getSizeInBits().operator unsigned long long() > MaskVT.getVectorNumElements() {
        SrcVT = getIntegerVT(if MaskVT.getVectorNumElements() as i32 > 8 { MaskVT.getVectorNumElements() as i32 } else { 8 });
        Mask = DAG.getNode(TRUNCATE, dl, SrcVT, Mask);
    }
    if SrcVT == i64 && Subtarget.is32Bit() {
        assert!(MaskVT == v64i1, "Expected v64i1 mask!");
        assert!(Subtarget.hasBWI(), "Expected AVX512BW target!");
        let mut Lo: SDValue = SDValue {};
        let mut Hi: SDValue = SDValue {};
        tie(Lo, Hi) = DAG.SplitScalar(Mask, dl, i32, i32);
        Lo = DAG.getBitcast(v32i1, Lo);
        Hi = DAG.getBitcast(v32i1, Hi);
        return DAG.getNode(CONCAT_VECTORS, dl, v64i1, Lo, Hi);
    }
    let mut BitcastVT: MVT = getVectorVT(i1, SrcVT.getSizeInBits().operator unsigned long long());
    return DAG.getNode(EXTRACT_SUBVECTOR, dl, MaskVT, DAG.getBitcast(BitcastVT, Mask), DAG.getVectorIdxConstant(0, dl, false));
}

fn lowerShuffleWithEXPAND(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsLeftZeroSide: bool = true;
    if !isNonZeroElementsInOrder(Zeroable, Mask, V1.getValueType(), IsLeftZeroSide) {
        return SDValue {};
    }
    let mut VEXPANDMask: u32 = (operator(Zeroable)).getZExtValue();
    let mut IntegerType: MVT = getIntegerVT(if VT.getVectorNumElements() as i32 > 8 { VT.getVectorNumElements() as i32 } else { 8 });
    let mut MaskNode: SDValue = DAG.getConstant(VEXPANDMask, DL, IntegerType, false, false);
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!((NumElts == 4 || NumElts == 8 || NumElts == 16), "Unexpected number of vector elements");
    let mut VMask: SDValue = getMaskNode(MaskNode, getVectorVT(i1, NumElts), Subtarget, DAG, DL);
    let mut ZeroVector: SDValue = getZeroVector(VT, Subtarget, DAG, DL);
    let mut ExpandedVector: SDValue = if IsLeftZeroSide { V2 } else { V1 };
    return DAG.getNode(EXPAND, DL, VT, ExpandedVector, ZeroVector, VMask);
}

fn matchShuffleWithUNPCK(VT: MVT, V1: *mut SDValue, V2: *mut SDValue, UnpackOpcode: *mut u32, IsUnary: bool, TargetMask: ArrayRef<int>, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> bool {
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut Undef1: bool = true;
    let mut Undef2: bool = true;
    let mut Zero1: bool = true;
    let mut Zero2: bool = true;
    for let mut i: i32 = 0; i != NumElts; i += 2 {
        let mut M1: i32 = TargetMask[i + 0];
        let mut M2: i32 = TargetMask[i + 1];
        Undef1 &= (SM_SentinelUndef == M1);
        Undef2 &= (SM_SentinelUndef == M2);
        Zero1 &= isUndefOrZero(M1);
        Zero2 &= isUndefOrZero(M2);
    }
    assert!(!((Undef1 || Zero1) && (Undef2 || Zero2)), "Zeroable shuffle detected");
    let mut Unpckl: SmallVector<int, 64> = SmallVector<int, 64> {};
    let mut Unpckh: SmallVector<int, 64> = SmallVector<int, 64> {};
    createUnpackShuffleMask(VT, Unpckl, true, IsUnary);
    if isTargetShuffleEquivalent(VT, TargetMask, Unpckl, DAG, V1, (if IsUnary { V1 } else { V2 })) {
        UnpackOpcode = UNPCKL;
        V2 = (if Undef2 { DAG.getUNDEF(VT) } else { (if IsUnary { V1 } else { V2 }) });
        V1 = (if Undef1 { DAG.getUNDEF(VT) } else { V1 });
        return true;
    }
    createUnpackShuffleMask(VT, Unpckh, false, IsUnary);
    if isTargetShuffleEquivalent(VT, TargetMask, Unpckh, DAG, V1, (if IsUnary { V1 } else { V2 })) {
        UnpackOpcode = UNPCKH;
        V2 = (if Undef2 { DAG.getUNDEF(VT) } else { (if IsUnary { V1 } else { V2 }) });
        V1 = (if Undef1 { DAG.getUNDEF(VT) } else { V1 });
        return true;
    }
    if IsUnary && (Zero1 || Zero2) {
        if (Subtarget.hasSSE41() || VT == v2i64 || VT == v2f64) && isSequentialOrUndefOrZeroInRange(TargetMask, 0, NumElts, 0, 1) {
            return false;
        }
        let mut MatchLo: bool = true;
        let mut MatchHi: bool = true;
        for let mut i: i32 = 0; (i != NumElts) && (MatchLo || MatchHi); i += 1 {
            let mut M: i32 = TargetMask[i];
            if (((i & 1) == 0) && Zero1) || (((i & 1) == 1) && Zero2) || (M == SM_SentinelUndef) {
                continue;
            }
            MatchLo &= (M == Unpckl[i]);
            MatchHi &= (M == Unpckh[i]);
        }
        if MatchLo || MatchHi {
            UnpackOpcode = if MatchLo { UNPCKL } else { UNPCKH };
            V2 = if Zero2 { getZeroVector(VT, Subtarget, DAG, DL) } else { V1 };
            V1 = if Zero1 { getZeroVector(VT, Subtarget, DAG, DL) } else { V1 };
            return true;
        }
    }
    if !IsUnary {
        commuteMask(Unpckl);
        if isTargetShuffleEquivalent(VT, TargetMask, Unpckl, DAG, SDValue {}, SDValue {}) {
            UnpackOpcode = UNPCKL;
            swap(V1, V2);
            return true;
        }
        commuteMask(Unpckh);
        if isTargetShuffleEquivalent(VT, TargetMask, Unpckh, DAG, SDValue {}, SDValue {}) {
            UnpackOpcode = UNPCKH;
            swap(V1, V2);
            return true;
        }
    }
    return false;
}

fn lowerShuffleWithUNPCK(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    let mut Unpckl: SmallVector<int, 8> = SmallVector<int, 8> {};
    createUnpackShuffleMask(VT, Unpckl, true, false);
    if isShuffleEquivalent(Mask, Unpckl, V1, V2) {
        return DAG.getNode(UNPCKL, DL, VT, V1, V2);
    }
    let mut Unpckh: SmallVector<int, 8> = SmallVector<int, 8> {};
    createUnpackShuffleMask(VT, Unpckh, false, false);
    if isShuffleEquivalent(Mask, Unpckh, V1, V2) {
        return DAG.getNode(UNPCKH, DL, VT, V1, V2);
    }
    commuteMask(Unpckl);
    if isShuffleEquivalent(Mask, Unpckl, V1, V2) {
        return DAG.getNode(UNPCKL, DL, VT, V2, V1);
    }
    commuteMask(Unpckh);
    if isShuffleEquivalent(Mask, Unpckh, V1, V2) {
        return DAG.getNode(UNPCKH, DL, VT, V2, V1);
    }
    return SDValue {};
}

fn lowerShuffleWithUNPCK256(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    let mut Unpckl: SmallVector<int, 32> = SmallVector<int, 32> {};
    let mut Unpckh: SmallVector<int, 32> = SmallVector<int, 32> {};
    createSplat2ShuffleMask(VT, Unpckl, true);
    createSplat2ShuffleMask(VT, Unpckh, false);
    let mut UnpackOpcode: u32 = 0;
    if isShuffleEquivalent(Mask, Unpckl, V1, V2) {
        UnpackOpcode = UNPCKL;
    } else if isShuffleEquivalent(Mask, Unpckh, V1, V2) {
        UnpackOpcode = UNPCKH;
    } else {
        return SDValue {};
    }
    V1 = DAG.getVectorShuffle(v4f64, DL, DAG.getBitcast(v4f64, V1), DAG.getUNDEF(v4f64), [0, 2, 1, 3]);
    V1 = DAG.getBitcast(VT, V1);
    return DAG.getNode(UnpackOpcode, DL, VT, V1, V1);
}

fn matchShuffleAsVTRUNC(SrcVT: *mut MVT, DstVT: *mut MVT, VT: MVT, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget) -> bool {
    if !VT.is512BitVector() && !Subtarget.hasVLX() {
        return false;
    }
    let mut NumElts: u32 = Mask.len;
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut MaxScale: u32 = 64 / EltSizeInBits;
    for let mut Scale: u32 = 2; Scale <= MaxScale; Scale += Scale {
        let mut SrcEltBits: u32 = EltSizeInBits * Scale;
        if SrcEltBits < 32 && !Subtarget.hasBWI() {
            continue;
        }
        let mut NumSrcElts: u32 = NumElts / Scale;
        if !isSequentialOrUndefInRange(Mask, 0, NumSrcElts, 0, Scale) {
            continue;
        }
        let mut UpperElts: u32 = NumElts - NumSrcElts;
        if !Zeroable.extractBits(UpperElts, NumSrcElts).isAllOnes() {
            continue;
        }
        SrcVT = getIntegerVT(EltSizeInBits * Scale);
        SrcVT = getVectorVT(SrcVT, NumSrcElts);
        DstVT = getIntegerVT(EltSizeInBits);
        if (NumSrcElts * EltSizeInBits) >= 128 {
            DstVT = getVectorVT(DstVT, NumSrcElts);
        } else {
            DstVT = getVectorVT(DstVT, 128 / EltSizeInBits);
        }
        return true;
    }
    return false;
}

fn getAVX512TruncNode(DL: *SDLoc, DstVT: MVT, Src: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, ZeroUppers: bool) -> SDValue {
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut DstSVT: MVT = DstVT.getScalarType();
    let mut NumDstElts: u32 = DstVT.getVectorNumElements();
    let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
    let mut DstEltSizeInBits: u32 = DstVT.getScalarSizeInBits();
    if !DAG.getTargetLoweringInfo().isTypeLegal(SrcVT) {
        return SDValue {};
    }
    if NumSrcElts == NumDstElts {
        return DAG.getNode(TRUNCATE, DL, DstVT, Src);
    }
    if NumSrcElts > NumDstElts {
        let mut TruncVT: MVT = getVectorVT(DstSVT, NumSrcElts);
        let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, TruncVT, Src);
        return extractSubVector(Trunc, 0, DAG, DL, DstVT.getSizeInBits().operator unsigned long long());
    }
    if (NumSrcElts * DstEltSizeInBits) >= 128 {
        let mut TruncVT: MVT = getVectorVT(DstSVT, NumSrcElts);
        let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, TruncVT, Src);
        return widenSubVector(Trunc, ZeroUppers, Subtarget, DAG, DL, DstVT.getSizeInBits().operator unsigned long long());
    }
    if !Subtarget.hasVLX() && !SrcVT.is512BitVector() {
        let mut NewSrc: SDValue = widenSubVector(Src, ZeroUppers, Subtarget, DAG, DL, 512);
        return getAVX512TruncNode(DL, DstVT, NewSrc, Subtarget, DAG, ZeroUppers);
    }
    let mut TruncVT: MVT = getVectorVT(DstSVT, 128 / DstEltSizeInBits);
    let mut Trunc: SDValue = DAG.getNode(VTRUNC, DL, TruncVT, Src);
    if DstVT != TruncVT {
        Trunc = widenSubVector(Trunc, ZeroUppers, Subtarget, DAG, DL, DstVT.getSizeInBits().operator unsigned long long());
    }
    return Trunc;
}

fn lowerShuffleWithVPMOV(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!((VT == v16i8 || VT == v8i16), "Unexpected VTRUNC type");
    if !Subtarget.hasAVX512() {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut MaxScale: u32 = 64 / EltSizeInBits;
    for let mut Scale: u32 = 2; Scale <= MaxScale; Scale += Scale {
        let mut SrcEltBits: u32 = EltSizeInBits * Scale;
        let mut NumSrcElts: u32 = NumElts / Scale;
        let mut UpperElts: u32 = NumElts - NumSrcElts;
        if !isSequentialOrUndefInRange(Mask, 0, NumSrcElts, 0, Scale) || !Zeroable.extractBits(UpperElts, NumSrcElts).isAllOnes() {
            continue;
        }
        let mut Src: SDValue = peekThroughBitcasts(V1);
        if Src.getOpcode() == TRUNCATE && Src.getScalarValueSizeInBits() == SrcEltBits {
            Src = Src.getOperand(0);
        } else if Subtarget.hasVLX() {
            let mut SrcSVT: MVT = getIntegerVT(SrcEltBits);
            let mut SrcVT: MVT = getVectorVT(SrcSVT, NumSrcElts);
            Src = DAG.getBitcast(SrcVT, Src);
            if Scale == 2 && ((DAG.ComputeNumSignBits(Src, 0) > EltSizeInBits) || (DAG.computeKnownBits(Src, 0).countMinLeadingZeros() >= EltSizeInBits)) {
                return SDValue {};
            }
        } else {
            return SDValue {};
        }
        if !Subtarget.hasBWI() && Src.getScalarValueSizeInBits() < 32 {
            return SDValue {};
        }
        let mut UndefUppers: bool = isUndefInRange(Mask, NumSrcElts, UpperElts);
        return getAVX512TruncNode(DL, VT, Src, Subtarget, DAG, !UndefUppers);
    }
    return SDValue {};
}

fn lowerShuffleAsVTRUNC(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!((VT.is128BitVector() || VT.is256BitVector()), "Unexpected VTRUNC type");
    if !Subtarget.hasAVX512() || (VT.is256BitVector() && !Subtarget.useAVX512Regs()) {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut MaxScale: u32 = 64 / EltSizeInBits;
    for let mut Scale: u32 = 2; Scale <= MaxScale; Scale += Scale {
        let mut SrcEltBits: u32 = EltSizeInBits * Scale;
        if SrcEltBits < 32 && !Subtarget.hasBWI() {
            continue;
        }
        let mut NumHalfSrcElts: u32 = NumElts / Scale;
        let mut NumSrcElts: u32 = 2 * NumHalfSrcElts;
        for let mut Offset: u32 = 0; Offset != Scale; Offset += 1 {
            if !isSequentialOrUndefInRange(Mask, 0, NumSrcElts, Offset, Scale) || isUndefInRange(Mask, NumHalfSrcElts, NumHalfSrcElts) {
                continue;
            }
            let mut UpperElts: u32 = NumElts - NumSrcElts;
            if UpperElts > 0 && !Zeroable.extractBits(UpperElts, NumSrcElts).isAllOnes() {
                continue;
            }
            let mut UndefUppers: bool = UpperElts > 0 && isUndefInRange(Mask, NumSrcElts, UpperElts);
            let mut ConcatVT: MVT = VT.getDoubleNumVectorElementsVT();
            let mut Src: SDValue = combineConcatVectorOps(DL, ConcatVT, [V1, V2], DAG, Subtarget, 0);
            if !Src {
                if Offset {
                    continue;
                }
                Src = DAG.getNode(CONCAT_VECTORS, DL, ConcatVT, V1, V2);
            }
            let mut SrcSVT: MVT = getIntegerVT(SrcEltBits);
            let mut SrcVT: MVT = getVectorVT(SrcSVT, NumSrcElts);
            Src = getTargetVShiftByConstNode(VSRLI, DL, SrcVT, Src, Offset * EltSizeInBits, DAG);
            return getAVX512TruncNode(DL, VT, Src, Subtarget, DAG, !UndefUppers);
        }
    }
    return SDValue {};
}

fn canLowerByDroppingElements(Mask: ArrayRef<int>, MatchEven: bool, IsSingleInput: bool) -> i32 {
    let mut ShuffleModulus: i32 = Mask.len * (if IsSingleInput { 1 } else { 2 });
    assert!(isPowerOf2_32(ShuffleModulus as u32), "We should only be called with masks with a power-of-2 size!");
    let mut ModMask: u64 = ShuffleModulus as u64 - 1;
    let mut Offset: i32 = if MatchEven { 0 } else { 1 };
    let mut ViableForN: [3]bool = [true, true, true];
    for let mut i: i32 = 0;
let mut e: i32 = Mask.len; i < e; i += 1 {
        if Mask[i] < 0 {
            continue;
        }
        let mut IsAnyViable: bool = false;
        for let mut j: u32 = 0; j != size(ViableForN); j += 1 {
            if ViableForN[j] {
                let mut N: u64 = j + 1;
                if (Mask[i] - Offset) as u64 == ((i as u64 << N) & ModMask) {
                    IsAnyViable = true;
                } else {
                    ViableForN[j] = false;
                }
            }
        }
        if !IsAnyViable {
            break;
        }
    }
    for let mut j: u32 = 0; j != size(ViableForN); j += 1 {
        if ViableForN[j] {
            return j + 1;
        }
    }
    return 0;
}

fn matchShuffleWithPACK(VT: MVT, SrcVT: *mut MVT, V1: *mut SDValue, V2: *mut SDValue, PackOpcode: *mut u32, TargetMask: ArrayRef<int>, DAG: *SelectionDAG, Subtarget: *X86Subtarget, MaxStages: u32) -> bool {
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut BitSize: u32 = VT.getScalarSizeInBits();
    assert!(0 < MaxStages && MaxStages <= 3 && (BitSize << MaxStages) <= 64, "Illegal maximum compaction");
    let mut MatchPACK: Closure_38 = Closure_38 { BitSize: &mut BitSize, Subtarget: &mut Subtarget, DAG: &mut DAG, V1: &mut V1, V2: &mut V2, SrcVT: &mut SrcVT, PackOpcode: &mut PackOpcode };
    for let mut NumStages: u32 = 1; NumStages <= MaxStages; NumStages += 1 {
        let mut PackSVT: MVT = getIntegerVT(BitSize << NumStages);
        let mut PackVT: MVT = getVectorVT(PackSVT, NumElts >> NumStages);
        let mut BinaryMask: SmallVector<int, 32> = SmallVector<int, 32> {};
        createPackShuffleMask(VT, BinaryMask, false, NumStages);
        if isTargetShuffleEquivalent(VT, TargetMask, BinaryMask, DAG, V1, V2) {
            if MatchPACK.call(V1, V2, PackVT) {
                return true;
            }
        }
        let mut UnaryMask: SmallVector<int, 32> = SmallVector<int, 32> {};
        createPackShuffleMask(VT, UnaryMask, true, NumStages);
        if isTargetShuffleEquivalent(VT, TargetMask, UnaryMask, DAG, V1, SDValue {}) {
            if MatchPACK.call(V1, V1, PackVT) {
                return true;
            }
        }
    }
    return false;
}

fn lowerShuffleWithPACK(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut PackVT: MVT = MVT {};
    let mut PackOpcode: u32 = 0;
    let mut SizeBits: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    let mut MaxStages: u32 = Log2_32(64 / EltBits);
    if !matchShuffleWithPACK(VT, PackVT, V1, V2, PackOpcode, Mask, DAG, Subtarget, MaxStages) {
        return SDValue {};
    }
    let mut CurrentEltBits: u32 = PackVT.getScalarSizeInBits();
    let mut NumStages: u32 = Log2_32(CurrentEltBits / EltBits);
    if NumStages != 1 && SizeBits == 128 && Subtarget.hasVLX() {
        return SDValue {};
    }
    let mut MaxPackBits: u32 = 16;
    if CurrentEltBits > 16 && (PackOpcode == PACKSS || Subtarget.hasSSE41()) {
        MaxPackBits = 32;
    }
    let mut Res: SDValue = SDValue {};
    for let mut i: u32 = 0; i != NumStages; i += 1 {
        let mut SrcEltBits: u32 = if MaxPackBits < CurrentEltBits { MaxPackBits } else { CurrentEltBits };
        let mut NumSrcElts: u32 = SizeBits / SrcEltBits;
        let mut SrcSVT: MVT = getIntegerVT(SrcEltBits);
        let mut DstSVT: MVT = getIntegerVT(SrcEltBits / 2);
        let mut SrcVT: MVT = getVectorVT(SrcSVT, NumSrcElts);
        let mut DstVT: MVT = getVectorVT(DstSVT, NumSrcElts * 2);
        Res = DAG.getNode(PackOpcode, DL, DstVT, DAG.getBitcast(SrcVT, V1), DAG.getBitcast(SrcVT, V2));
        V1 = V2 = Res;
        CurrentEltBits /= 2;
    }
    assert!(Res && Res.getValueType() == VT, "Failed to lower compaction shuffle");
    return Res;
}

fn lowerShuffleAsBitMask(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, DAG: *mut SelectionDAG) -> SDValue {
    let mut EltSizeInBIts: u32 = VT.getScalarSizeInBits();
    let mut Zero: APInt = getZero(EltSizeInBIts);
    let mut AllOnes: APInt = getAllOnes(EltSizeInBIts);
    let mut VMaskOps: SmallVector<APInt, 16> = SmallVector<APInt, 16> { Mask.len, Zero };
    let mut V: SDValue = SDValue {};
    for let mut I: i32 = 0;
let mut Size: i32 = Mask.len; I != Size; I += 1 {
        if Zeroable[I] {
            continue;
        }
        if Mask[I] % Size != I {
            return SDValue {};
        }
        if !V {
            V = if Mask[I] < Size { V1 } else { V2 };
        } else if V != (if Mask[I] < Size { V1 } else { V2 }) {
            return SDValue {};
        }
        VMaskOps[I] = AllOnes;
    }
    if !V {
        return SDValue {};
    }
    let mut LogicVT: MVT = VT.changeTypeToInteger();
    let mut VMask: SDValue = getConstVector(VMaskOps, LogicVT, DAG, DL);
    V = DAG.getBitcast(LogicVT, V);
    let mut And: SDValue = DAG.getNode(AND, DL, LogicVT, V, VMask);
    return DAG.getBitcast(VT, And);
}

fn lowerShuffleAsBitBlend(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT.isInteger(), "Only supports integer vector types!");
    let mut EltSizeInBIts: u32 = VT.getScalarSizeInBits();
    let mut Zero: APInt = getZero(EltSizeInBIts);
    let mut AllOnes: APInt = getAllOnes(EltSizeInBIts);
    let mut MaskOps: SmallVector<APInt, 16> = SmallVector<APInt, 16> {};
    for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
        if Mask[i] >= 0 && Mask[i] != i && Mask[i] != i + Size {
            return SDValue {};
        }
        MaskOps.push(if Mask[i] < Size { AllOnes } else { Zero });
    }
    let mut V1Mask: SDValue = getConstVector(MaskOps, VT, DAG, DL);
    return getBitSelect(DL, VT, V1, V2, V1Mask, DAG);
}

fn matchShuffleAsBlend(VT: MVT, V1: SDValue, V2: SDValue, Mask: MutableArrayRef<int>, Zeroable: *APInt, ForceV1Zero: *mut bool, ForceV2Zero: *mut bool, BlendMask: *mut u64) -> bool {
    let mut V1IsZeroOrUndef: bool = V1.isUndef() || isBuildVectorAllZeros(V1.getNode());
    let mut V2IsZeroOrUndef: bool = V2.isUndef() || isBuildVectorAllZeros(V2.getNode());
    BlendMask = 0;
    ForceV1Zero = false , ForceV2Zero = false;
    assert!(Mask.len <= 64, "Shuffle mask too big for blend mask");
    let mut NumElts: i32 = Mask.len;
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumEltsPerLane: i32 = NumElts / NumLanes;
    assert!((NumLanes * NumEltsPerLane) == NumElts, "Value type mismatch");
    let mut ForceWholeLaneMasks: bool = VT.is256BitVector() && VT.getScalarSizeInBits() >= 32;
    for let mut Lane: i32 = 0; Lane != NumLanes; Lane += 1 {
        let mut LaneV1InUse: bool = false;
        let mut LaneV2InUse: bool = false;
        let mut LaneBlendMask: u64 = 0;
        for let mut LaneElt: i32 = 0; LaneElt != NumEltsPerLane; LaneElt += 1 {
            let mut Elt: i32 = (Lane * NumEltsPerLane) + LaneElt;
            let mut M: i32 = Mask[Elt];
            if M == SM_SentinelUndef {
                continue;
            }
            if M == Elt || (0 <= M && M < NumElts && IsElementEquivalent(NumElts, V1, V1, M, Elt)) {
                Mask[Elt] = Elt;
                LaneV1InUse = true;
                continue;
            }
            if M == (Elt + NumElts) || (NumElts <= M && IsElementEquivalent(NumElts, V2, V2, M - NumElts, Elt)) {
                LaneBlendMask |= 1 << LaneElt;
                Mask[Elt] = Elt + NumElts;
                LaneV2InUse = true;
                continue;
            }
            if Zeroable[Elt] {
                if V1IsZeroOrUndef {
                    ForceV1Zero = true;
                    Mask[Elt] = Elt;
                    LaneV1InUse = true;
                    continue;
                }
                if V2IsZeroOrUndef {
                    ForceV2Zero = true;
                    LaneBlendMask |= 1 << LaneElt;
                    Mask[Elt] = Elt + NumElts;
                    LaneV2InUse = true;
                    continue;
                }
            }
            return false;
        }
        if ForceWholeLaneMasks && LaneV2InUse && !LaneV1InUse {
            LaneBlendMask = (1 << NumEltsPerLane) - 1;
        }
        BlendMask |= LaneBlendMask << (Lane * NumEltsPerLane);
    }
    return true;
}

fn lowerShuffleAsBlend(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Original: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut BlendMask: u64 = 0;
    let mut ForceV1Zero: bool = false;
    let mut ForceV2Zero: bool = false;
    let mut Mask: SmallVector<int, 64> = Original;
    if !matchShuffleAsBlend(VT, V1, V2, Mask, Zeroable, ForceV1Zero, ForceV2Zero, BlendMask) {
        return SDValue {};
    }
    if ForceV1Zero {
        V1 = getZeroVector(VT, Subtarget, DAG, DL);
    }
    if ForceV2Zero {
        V2 = getZeroVector(VT, Subtarget, DAG, DL);
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    match VT.SimpleTy {
        v4i64 => {
            v8i32;
        },
        v4f64 => {
            v8f32;
        },
        v2f64 => {
            v2i64;
        },
        v16i16 => {
            assert!(Subtarget.hasAVX2(), "v16i16 blends require AVX2!");
            let mut RepeatedMask: SmallVector<int, 8> = SmallVector<int, 8> {};
            if is128BitLaneRepeatedShuffleMask(v16i16, Mask, RepeatedMask) {
                assert!(RepeatedMask.len == 8, "Repeated mask size doesn't match!");
                BlendMask = 0;
                for let mut i: i32 = 0; i < 8; i += 1 {
                    if RepeatedMask[i] >= 8 {
                        BlendMask |= 1 << i;
                    }
                }
                return DAG.getNode(BLENDI, DL, v16i16, V1, V2, DAG.getTargetConstant(BlendMask, DL, i8, false));
            }
            let mut LoMask: u64 = BlendMask & 255;
            let mut HiMask: u64 = (BlendMask >> 8) & 255;
            if LoMask == 0 || LoMask == 255 || HiMask == 0 || HiMask == 255 {
                let mut Lo: SDValue = DAG.getNode(BLENDI, DL, v16i16, V1, V2, DAG.getTargetConstant(LoMask, DL, i8, false));
                let mut Hi: SDValue = DAG.getNode(BLENDI, DL, v16i16, V1, V2, DAG.getTargetConstant(HiMask, DL, i8, false));
                return DAG.getVectorShuffle(v16i16, DL, Lo, Hi, [0, 1, 2, 3, 4, 5, 6, 7, 24, 25, 26, 27, 28, 29, 30, 31]);
            }
        },
        v32i8 => {
            assert!(Subtarget.hasAVX2(), "256-bit byte-blends require AVX2!");
        },
        v16i8 => {
            assert!(Subtarget.hasSSE41(), "128-bit byte-blends require SSE41!");
            if lowerShuffleAsBitMask(DL, VT, V1, V2, Mask, Zeroable, DAG) {
                Masked;
            } else {
                return Masked;
            }
            if Subtarget.hasBWI() && Subtarget.hasVLX() {
                let mut IntegerType: MVT = getIntegerVT(if NumElts > 8 { NumElts } else { 8 });
                let mut MaskNode: SDValue = DAG.getConstant(BlendMask, DL, IntegerType, false, false);
                return getVectorMaskingNode(V2, MaskNode, V1, Subtarget, DAG);
            }
            if Subtarget.hasVLX() {
                if lowerShuffleAsBitBlend(DL, VT, V1, V2, Mask, DAG) {
                    BitBlend;
                } else {
                    return BitBlend;
                }
            }
            let mut Scale: i32 = VT.getScalarSizeInBits() / 8;
            let mut BlendVT: MVT = getVectorVT(i8, VT.getSizeInBits().operator unsigned long long() / 8);
            if !isNormalLoad(V1.getNode()) && isNormalLoad(V2.getNode()) {
                commuteMask(Mask);
                swap(V1, V2);
            }
            let mut VSELECTMask: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
            for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
                for let mut j: i32 = 0; j < Scale; j += 1 {
                    VSELECTMask.push(if Mask[i] < 0 { DAG.getUNDEF(i8) } else { DAG.getSignedConstant(if Mask[i] < Size { -1 } else { 0 }, DL, i8, false, false) });
                }
            }
            V1 = DAG.getBitcast(BlendVT, V1);
            V2 = DAG.getBitcast(BlendVT, V2);
            return DAG.getBitcast(VT, DAG.getSelect(DL, BlendVT, DAG.getBuildVector(BlendVT, DL, VSELECTMask), V1, V2, SDNodeFlags { Flags: None }));
        },
        v16f32 => {
            v8f64;
        },
        _ => {
            llvm_unreachable_internal("Not a supported integer vector type!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 11625);
        },
    }
}

fn lowerShuffleAsBlendAndPermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG, ImmBlends: bool) -> SDValue {
    let mut BlendMask: SmallVector<int, 32> = SmallVector<int, 32> { Mask.len, -1 };
    let mut PermuteMask: SmallVector<int, 32> = SmallVector<int, 32> { Mask.len, -1 };
    for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 1 {
        if Mask[i] < 0 {
            continue;
        }
        assert!(Mask[i] < Size * 2, "Shuffle input is out of bounds.");
        if BlendMask[Mask[i] % Size] < 0 {
            BlendMask[Mask[i] % Size] = Mask[i];
        } else if BlendMask[Mask[i] % Size] != Mask[i] {
            return SDValue {};
        }
        PermuteMask[i] = Mask[i] % Size;
    }
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    if ImmBlends && EltSize == 8 && !canWidenShuffleElements(BlendMask) {
        return SDValue {};
    }
    let mut V: SDValue = DAG.getVectorShuffle(VT, DL, V1, V2, BlendMask);
    return DAG.getVectorShuffle(VT, DL, V, DAG.getUNDEF(VT), PermuteMask);
}

fn lowerShuffleAsUNPCKAndPermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    let mut NumElts: i32 = Mask.len;
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumLaneElts: i32 = NumElts / NumLanes;
    let mut NumHalfLaneElts: i32 = NumLaneElts / 2;
    let mut MatchLo: bool = true;
    let mut MatchHi: bool = true;
    let mut Ops: [2]SDValue = [DAG.getUNDEF(VT), DAG.getUNDEF(VT)];
    for let mut Elt: i32 = 0; Elt != NumElts; Elt += 1 {
        let mut M: i32 = Mask[Elt];
        if M < 0 {
            continue;
        }
        let mut NormM: i32 = M;
        let mut Op: *mut SDValue = Ops[Elt & 1];
        if M < NumElts && (Op.isUndef() || Op == V1) {
            Op = V1;
        } else if NumElts <= M && (Op.isUndef() || Op == V2) {
            Op = V2;
            NormM -= NumElts;
        } else {
            return SDValue {};
        }
        let mut MatchLoAnyLane: bool = false;
        let mut MatchHiAnyLane: bool = false;
        for let mut Lane: i32 = 0; Lane != NumElts; Lane += NumLaneElts {
            let mut Lo: i32 = Lane;
            let mut Mid: i32 = Lane + NumHalfLaneElts;
            let mut Hi: i32 = Lane + NumLaneElts;
            MatchLoAnyLane |= isUndefOrInRange(NormM, Lo, Mid);
            MatchHiAnyLane |= isUndefOrInRange(NormM, Mid, Hi);
            if MatchLoAnyLane || MatchHiAnyLane {
                assert!((MatchLoAnyLane ^ MatchHiAnyLane), "Failed to match UNPCKLO/UNPCKHI");
                break;
            }
        }
        MatchLo &= MatchLoAnyLane;
        MatchHi &= MatchHiAnyLane;
        if !MatchLo && !MatchHi {
            return SDValue {};
        }
    }
    assert!((MatchLo ^ MatchHi), "Failed to match UNPCKLO/UNPCKHI");
    let mut PermuteMask: SmallVector<int, 32> = SmallVector<int, 32> { NumElts, -1 };
    for let mut Elt: i32 = 0; Elt != NumElts; Elt += 1 {
        let mut M: i32 = Mask[Elt];
        if M < 0 {
            continue;
        }
        let mut NormM: i32 = M;
        if NumElts <= M {
            NormM -= NumElts;
        }
        let mut IsFirstOp: bool = M < NumElts;
        let mut BaseMaskElt: i32 = NumLaneElts * (NormM / NumLaneElts) + (2 * (NormM % NumHalfLaneElts));
        if (IsFirstOp && V1 == Ops[0]) || (!IsFirstOp && V2 == Ops[0]) {
            PermuteMask[Elt] = BaseMaskElt;
        } else if (IsFirstOp && V1 == Ops[1]) || (!IsFirstOp && V2 == Ops[1]) {
            PermuteMask[Elt] = BaseMaskElt + 1;
        }
        assert!(PermuteMask[Elt] != -1, "Input mask element is defined but failed to assign permute mask");
    }
    let mut UnpckOp: u32 = if MatchLo { UNPCKL } else { UNPCKH };
    let mut Unpck: SDValue = DAG.getNode(UnpckOp, DL, VT, Ops);
    return DAG.getVectorShuffle(VT, DL, Unpck, DAG.getUNDEF(VT), PermuteMask);
}

fn lowerShuffleAsPermuteAndUnpack(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut Size: i32 = Mask.len;
    assert!(Mask.len >= 2, "Single element masks are invalid.");
    if VT.isFloatingPoint() || !VT.is128BitVector() || V2.isUndef() {
        return SDValue {};
    }
    let mut NumLoInputs: i32 = count_if(Mask, Closure_39 { Size: Size });
    let mut NumHiInputs: i32 = count_if(Mask, Closure_40 { Size: Size });
    let mut UnpackLo: bool = NumLoInputs >= NumHiInputs;
    let mut TryUnpack: Closure_41 = Closure_41 { Size: &mut Size, Mask: &mut Mask, UnpackLo: &mut UnpackLo, NumLoInputs: &mut NumLoInputs, NumHiInputs: &mut NumHiInputs, V1: &mut V1, DAG: &mut DAG, VT: &mut VT, DL: &mut DL, V2: &mut V2 };
    let mut OrigScalarSize: i32 = VT.getScalarSizeInBits();
    for let mut ScalarSize: i32 = 64; ScalarSize >= OrigScalarSize; ScalarSize /= 2 {
        if TryUnpack.call(ScalarSize, ScalarSize / OrigScalarSize) {
            Unpack;
        } else {
            return Unpack;
        }
    }
    if isBuildVectorAllZeros(V1.getNode()) || isBuildVectorAllZeros(V2.getNode()) {
        return SDValue {};
    }
    if NumLoInputs == 0 || NumHiInputs == 0 {
        assert!((NumLoInputs > 0 || NumHiInputs > 0), "We have to have *some* inputs!");
        let mut HalfOffset: i32 = if NumLoInputs == 0 { Size / 2 } else { 0 };
        let mut PermMask: SmallVector<int, 32> = SmallVector<int, 32> { Size as u32, -1 };
        for let mut i: i32 = 0; i < Size; i += 1 {
            if Mask[i] < 0 {
                continue;
            }
            assert!(Mask[i] % Size >= HalfOffset, "Found input from wrong half!");
            PermMask[i] = 2 * ((Mask[i] % Size) - HalfOffset) + (if Mask[i] < Size { 0 } else { 1 });
        }
        return DAG.getVectorShuffle(VT, DL, DAG.getNode(if NumLoInputs == 0 { UNPCKH } else { UNPCKL }, DL, VT, V1, V2), DAG.getUNDEF(VT), PermMask);
    }
    return SDValue {};
}

fn lowerShuffleAsByteRotateAndPermute(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if (VT.is128BitVector() && !Subtarget.hasSSSE3()) || (VT.is256BitVector() && !Subtarget.hasAVX2()) || (VT.is512BitVector() && !Subtarget.hasBWI()) {
        return SDValue {};
    }
    if is128BitLaneCrossingShuffleMask(VT, Mask) {
        return SDValue {};
    }
    let mut Scale: i32 = VT.getScalarSizeInBits() / 8;
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut NumEltsPerLane: i32 = NumElts / NumLanes;
    let mut Blend1: bool = true;
    let mut Blend2: bool = true;
    let mut Range1: pair<int, int> = make_pair(2147483647, (-2147483647 - 1));
    let mut Range2: pair<int, int> = make_pair(2147483647, (-2147483647 - 1));
    for let mut Lane: i32 = 0; Lane != NumElts; Lane += NumEltsPerLane {
        for let mut Elt: i32 = 0; Elt != NumEltsPerLane; Elt += 1 {
            let mut M: i32 = Mask[Lane + Elt];
            if M < 0 {
                continue;
            }
            if M < NumElts {
                Blend1 &= (M == (Lane + Elt));
                assert!(Lane <= M && M < (Lane + NumEltsPerLane), "Out of range mask");
                M = M % NumEltsPerLane;
                Range1.first = if Range1.first < M { Range1.first } else { M };
                Range1.second = if Range1.second > M { Range1.second } else { M };
            } else {
                M -= NumElts;
                Blend2 &= (M == (Lane + Elt));
                assert!(Lane <= M && M < (Lane + NumEltsPerLane), "Out of range mask");
                M = M % NumEltsPerLane;
                Range2.first = if Range2.first < M { Range2.first } else { M };
                Range2.second = if Range2.second > M { Range2.second } else { M };
            }
        }
    }
    if !(0 <= Range1.first && Range1.second < NumEltsPerLane) || !(0 <= Range2.first && Range2.second < NumEltsPerLane) {
        return SDValue {};
    }
    if VT.getSizeInBits().operator unsigned long long() > 128 && (Blend1 || Blend2) {
        return SDValue {};
    }
    let mut RotateAndPermute: Closure_42 = Closure_42 { VT: &mut VT, DAG: &mut DAG, DL: &mut DL, Scale: &mut Scale, NumElts: &mut NumElts, NumEltsPerLane: &mut NumEltsPerLane, Mask: &mut Mask };
    if Range2.second < Range1.first {
        return RotateAndPermute.call(V1, V2, Range1.first, 0);
    }
    if Range1.second < Range2.first {
        return RotateAndPermute.call(V2, V1, Range2.first, NumElts);
    }
    return SDValue {};
}

fn isBroadcastShuffleMask(Mask: ArrayRef<int>) -> bool {
    return isUndefOrEqual(Mask, 0);
}

fn isNoopOrBroadcastShuffleMask(Mask: ArrayRef<int>) -> bool {
    return isNoopShuffleMask(Mask) || isBroadcastShuffleMask(Mask);
}

fn isSingleElementRepeatedMask(Mask: ArrayRef<int>) -> bool {
    let mut NumUndefs: u64 = 0;
    let mut UniqueElt: optional<int> = optional<int> {};
    for Elt in Mask {
        if Elt == SM_SentinelUndef {
            NumUndefs += 1;
            continue;
        }
        if UniqueElt.has_value() && UniqueElt.value() != Elt {
            return false;
        }
        UniqueElt = Elt;
    }
    return NumUndefs <= Mask.len / 2 && UniqueElt.has_value();
}

fn lowerShuffleAsDecomposedShuffleMerge(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut NumElts: i32 = Mask.len;
    let mut NumLanes: i32 = VT.getSizeInBits().operator unsigned long long() / 128;
    let mut NumEltsPerLane: i32 = NumElts / NumLanes;
    let mut EltSizeInBits: i32 = VT.getScalarSizeInBits();
    let mut IsAlternating: bool = true;
    let mut V1Zero: bool = true;
    let mut V2Zero: bool = true;
    let mut V1Mask: SmallVector<int, 32> = SmallVector<int, 32> { NumElts, -1 };
    let mut V2Mask: SmallVector<int, 32> = SmallVector<int, 32> { NumElts, -1 };
    let mut FinalMask: SmallVector<int, 32> = SmallVector<int, 32> { NumElts, -1 };
    for let mut i: i32 = 0; i < NumElts; i += 1 {
        let mut M: i32 = Mask[i];
        if M >= 0 && M < NumElts {
            V1Mask[i] = M;
            FinalMask[i] = i;
            V1Zero &= Zeroable[i];
            IsAlternating &= (i & 1) == 0;
        } else if M >= NumElts {
            V2Mask[i] = M - NumElts;
            FinalMask[i] = i + NumElts;
            V2Zero &= Zeroable[i];
            IsAlternating &= (i & 1) == 1;
        }
    }
    let mut canonicalizeBroadcastableInput: Closure_43 = Closure_43 { cap_0: DL, cap_1: VT, Subtarget: &mut Subtarget, DAG: &mut DAG };
    if isNoopOrBroadcastShuffleMask(V1Mask) && isNoopOrBroadcastShuffleMask(V2Mask) {
        canonicalizeBroadcastableInput.call(V1, V1Mask);
        canonicalizeBroadcastableInput.call(V2, V2Mask);
    }
    let mut V1Noop: bool = isNoopShuffleMask(V1Mask);
    let mut V2Noop: bool = isNoopShuffleMask(V2Mask);
    if !V1Noop && !V2Noop {
        if !Subtarget.hasSSE41() && VT.is128BitVector() && (is128BitUnpackShuffleMask(V1Mask, DAG) || is128BitUnpackShuffleMask(V2Mask, DAG)) {
            if lowerShuffleAsPermuteAndUnpack(DL, VT, V1, V2, Mask, Subtarget, DAG) {
                PermUnpack;
            } else {
                return PermUnpack;
            }
        }
        if lowerShuffleAsBlendAndPermute(DL, VT, V1, V2, Mask, DAG, true) {
            BlendPerm;
        } else {
            return BlendPerm;
        }
        if !V1Zero && !V2Zero && !isSingleElementRepeatedMask(V1Mask) && !isSingleElementRepeatedMask(V2Mask) {
            if lowerShuffleAsUNPCKAndPermute(DL, VT, V1, V2, Mask, DAG) {
                UnpackPerm;
            } else {
                return UnpackPerm;
            }
        }
        if lowerShuffleAsByteRotateAndPermute(DL, VT, V1, V2, Mask, Subtarget, DAG) {
            RotatePerm;
        } else {
            return RotatePerm;
        }
        if lowerShuffleAsBlendAndPermute(DL, VT, V1, V2, Mask, DAG, false) {
            BlendPerm;
        } else {
            return BlendPerm;
        }
        if EltSizeInBits >= 32 {
            if lowerShuffleAsPermuteAndUnpack(DL, VT, V1, V2, Mask, Subtarget, DAG) {
                PermUnpack;
            } else {
                return PermUnpack;
            }
        }
    }
    let mut PreferBlend: bool = EltSizeInBits == 16 && (V1Noop || V2Noop) && Subtarget.hasSSE41() && is128BitLaneRepeatedShuffleMask(VT, FinalMask);
    if !PreferBlend && IsAlternating && EltSizeInBits < 32 {
        V1Mask.assign(NumElts, -1);
        V2Mask.assign(NumElts, -1);
        FinalMask.assign(NumElts, -1);
        for let mut i: i32 = 0; i != NumElts; i += NumEltsPerLane {
            for let mut j: i32 = 0; j != NumEltsPerLane; j += 1 {
                let mut M: i32 = Mask[i + j];
                if M >= 0 && M < NumElts {
                    V1Mask[i + (j / 2)] = M;
                    FinalMask[i + j] = i + (j / 2);
                } else if M >= NumElts {
                    V2Mask[i + (j / 2)] = M - NumElts;
                    FinalMask[i + j] = i + (j / 2) + NumElts;
                }
            }
        }
    }
    V1 = DAG.getVectorShuffle(VT, DL, V1, DAG.getUNDEF(VT), V1Mask);
    V2 = DAG.getVectorShuffle(VT, DL, V2, DAG.getUNDEF(VT), V2Mask);
    return DAG.getVectorShuffle(VT, DL, V1, V2, FinalMask);
}

fn matchShuffleAsBitRotate(RotateVT: *mut MVT, EltSizeInBits: i32, Subtarget: *X86Subtarget, Mask: ArrayRef<int>) -> i32 {
    assert!(!isNoopShuffleMask(Mask), "We shouldn't lower no-op shuffles!");
    assert!(EltSizeInBits < 64, "Can't rotate 64-bit integers");
    let mut MinSubElts: i32 = if Subtarget.hasAVX512() { if 32 / EltSizeInBits > 2 { 32 / EltSizeInBits } else { 2 } } else { 2 };
    let mut MaxSubElts: i32 = 64 / EltSizeInBits;
    let mut RotateAmt: u32 = 0;
    let mut NumSubElts: u32 = 0;
    if !isBitRotateMask(Mask, EltSizeInBits, MinSubElts, MaxSubElts, NumSubElts, RotateAmt) {
        return -1;
    }
    let mut NumElts: u32 = Mask.len;
    let mut RotateSVT: MVT = getIntegerVT(EltSizeInBits * NumSubElts);
    RotateVT = getVectorVT(RotateSVT, NumElts / NumSubElts);
    return RotateAmt;
}

fn lowerShuffleAsBitRotate(DL: *SDLoc, VT: MVT, V1: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsLegal: bool = (VT.is128BitVector() && Subtarget.hasXOP()) || Subtarget.hasAVX512();
    if !IsLegal && Subtarget.hasSSE3() {
        return SDValue {};
    }
    let mut RotateVT: MVT = MVT {};
    let mut RotateAmt: i32 = matchShuffleAsBitRotate(RotateVT, VT.getScalarSizeInBits(), Subtarget, Mask);
    if RotateAmt < 0 {
        return SDValue {};
    }
    if !IsLegal {
        if (RotateAmt % 16) == 0 {
            return SDValue {};
        }
        let mut ShlAmt: u32 = RotateAmt;
        let mut SrlAmt: u32 = RotateVT.getScalarSizeInBits() - RotateAmt;
        let mut SHL: SDValue = getTargetVShiftByConstNode(VSHLI, DL, RotateVT, V1, ShlAmt, DAG);
        let mut SRL: SDValue = getTargetVShiftByConstNode(VSRLI, DL, RotateVT, V1, SrlAmt, DAG);
        let mut Rot: SDValue = DAG.getNode(OR, DL, RotateVT, SHL, SRL);
        return DAG.getBitcast(VT, Rot);
    }
    let mut Rot: SDValue = DAG.getNode(VROTLI, DL, RotateVT, DAG.getBitcast(RotateVT, V1), DAG.getTargetConstant(RotateAmt, DL, i8, false));
    return DAG.getBitcast(VT, Rot);
}

fn matchShuffleAsElementRotate(V1: *mut SDValue, V2: *mut SDValue, Mask: ArrayRef<int>) -> i32 {
    let mut NumElts: i32 = Mask.len;
    let mut Rotation: i32 = 0;
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    for let mut i: i32 = 0; i < NumElts; i += 1 {
        let mut M: i32 = Mask[i];
        assert!((M == SM_SentinelUndef || (0 <= M && M < (2 * NumElts))), "Unexpected mask index.");
        if M < 0 {
            continue;
        }
        let mut StartIdx: i32 = i - (M % NumElts);
        if StartIdx == 0 {
            return -1;
        }
        let mut CandidateRotation: i32 = if StartIdx < 0 { -StartIdx } else { NumElts - StartIdx };
        if Rotation == 0 {
            Rotation = CandidateRotation;
        } else if Rotation != CandidateRotation {
            return -1;
        }
        let mut MaskV: SDValue = if M < NumElts { V1 } else { V2 };
        let mut TargetV: *mut SDValue = if StartIdx < 0 { Hi } else { Lo };
        if !TargetV {
            TargetV = MaskV;
        } else if TargetV != MaskV {
            return -1;
        }
    }
    assert!(Rotation != 0, "Failed to locate a viable rotation!");
    assert!((Lo || Hi), "Failed to find a rotated input vector!");
    if !Lo {
        Lo = Hi;
    } else if !Hi {
        Hi = Lo;
    }
    V1 = Lo;
    V2 = Hi;
    return Rotation;
}

fn matchShuffleAsByteRotate(VT: MVT, V1: *mut SDValue, V2: *mut SDValue, Mask: ArrayRef<int>) -> i32 {
    if isAnyZero(Mask) {
        return -1;
    }
    let mut RepeatedMask: SmallVector<int, 16> = SmallVector<int, 16> {};
    if !is128BitLaneRepeatedShuffleMask(VT, Mask, RepeatedMask) {
        return -1;
    }
    let mut Rotation: i32 = matchShuffleAsElementRotate(V1, V2, RepeatedMask);
    if Rotation <= 0 {
        return -1;
    }
    let mut NumElts: i32 = RepeatedMask.len;
    let mut Scale: i32 = 16 / NumElts;
    return Rotation * Scale;
}

fn lowerShuffleAsByteRotate(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(!isNoopShuffleMask(Mask), "We shouldn't lower no-op shuffles!");
    let mut Lo: SDValue = V1;
    let mut Hi: SDValue = V2;
    let mut ByteRotation: i32 = matchShuffleAsByteRotate(VT, Lo, Hi, Mask);
    if ByteRotation <= 0 {
        return SDValue {};
    }
    let mut ByteVT: MVT = getVectorVT(i8, VT.getSizeInBits().operator unsigned long long() / 8);
    Lo = DAG.getBitcast(ByteVT, Lo);
    Hi = DAG.getBitcast(ByteVT, Hi);
    if Subtarget.hasSSSE3() {
        assert!((!VT.is512BitVector() || Subtarget.hasBWI()), "512-bit PALIGNR requires BWI instructions");
        return DAG.getBitcast(VT, DAG.getNode(PALIGNR, DL, ByteVT, Lo, Hi, DAG.getTargetConstant(ByteRotation, DL, i8, false)));
    }
    assert!(VT.is128BitVector(), "Rotate-based lowering only supports 128-bit lowering!");
    assert!(Mask.len <= 16, "Can shuffle at most 16 bytes in a 128-bit vector!");
    assert!(ByteVT == v16i8, "SSE2 rotate lowering only needed for v16i8!");
    let mut LoByteShift: i32 = 16 - ByteRotation;
    let mut HiByteShift: i32 = ByteRotation;
    let mut LoShift: SDValue = DAG.getNode(VSHLDQ, DL, v16i8, Lo, DAG.getTargetConstant(LoByteShift, DL, i8, false));
    let mut HiShift: SDValue = DAG.getNode(VSRLDQ, DL, v16i8, Hi, DAG.getTargetConstant(HiByteShift, DL, i8, false));
    return DAG.getBitcast(VT, DAG.getNode(OR, DL, v16i8, LoShift, HiShift));
}

fn lowerShuffleAsVALIGN(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    if EltBits != 32 && EltBits != 64 {
        return SDValue {};
    }
    let mut AlignVT: MVT = VT.changeVectorElementTypeToInteger();
    assert!((Subtarget.hasVLX() || (!AlignVT.is128BitVector() && !AlignVT.is256BitVector())), "VLX required for 128/256-bit vectors");
    let mut emitVALIGN: Closure_44 = Closure_44 { VT: &mut VT, DAG: &mut DAG, AlignVT: &mut AlignVT, DL: &mut DL };
    let mut Lo: SDValue = V1;
    let mut Hi: SDValue = V2;
    let mut Rotation: i32 = matchShuffleAsElementRotate(Lo, Hi, Mask);
    if 0 < Rotation {
        return emitVALIGN.call(Lo, Hi, Rotation);
    }
    let mut NumElts: u32 = Mask.len;
    let mut ZeroLo: u32 = Zeroable.countr_one();
    let mut ZeroHi: u32 = Zeroable.countl_one();
    assert!((ZeroLo + ZeroHi) < NumElts, "Zeroable shuffle detected");
    if !ZeroLo && !ZeroHi {
        return SDValue {};
    }
    if ZeroLo {
        let mut Src: SDValue = if Mask[ZeroLo] < NumElts as i32 { V1 } else { V2 };
        let mut Low: i32 = if Mask[ZeroLo] < NumElts as i32 { 0 } else { NumElts };
        if isSequentialOrUndefInRange(Mask, ZeroLo, NumElts - ZeroLo, Low, 1) {
            return emitVALIGN.call(Src, getZeroVector(AlignVT, Subtarget, DAG, DL), NumElts - ZeroLo);
        }
    }
    if ZeroHi {
        let mut Src: SDValue = if Mask[0] < NumElts as i32 { V1 } else { V2 };
        let mut Low: i32 = if Mask[0] < NumElts as i32 { 0 } else { NumElts };
        if isSequentialOrUndefInRange(Mask, 0, NumElts - ZeroHi, Low + ZeroHi, 1) {
            return emitVALIGN.call(getZeroVector(AlignVT, Subtarget, DAG, DL), Src, ZeroHi);
        }
    }
    return SDValue {};
}

fn lowerShuffleAsByteShiftMask(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(!isNoopShuffleMask(Mask), "We shouldn't lower no-op shuffles!");
    assert!(VT.is128BitVector(), "Only 128-bit vectors supported");
    let mut ZeroLo: u32 = Zeroable.countr_one();
    let mut ZeroHi: u32 = Zeroable.countl_one();
    if !ZeroLo && !ZeroHi {
        return SDValue {};
    }
    let mut NumElts: u32 = Mask.len;
    let mut Len: u32 = NumElts - (ZeroLo + ZeroHi);
    if !isSequentialOrUndefInRange(Mask, ZeroLo, Len, Mask[ZeroLo], 1) {
        return SDValue {};
    }
    let mut Scale: u32 = VT.getScalarSizeInBits() / 8;
    let mut StubMask: ArrayRef<int> = Mask.slice(ZeroLo, Len);
    if !isUndefOrInRange(StubMask, 0, NumElts) && !isUndefOrInRange(StubMask, NumElts, 2 * NumElts) {
        return SDValue {};
    }
    let mut Res: SDValue = if Mask[ZeroLo] < NumElts as i32 { V1 } else { V2 };
    Res = DAG.getBitcast(v16i8, Res);
    if ZeroLo == 0 {
        let mut Shift: u32 = (NumElts - 1) - (Mask[ZeroLo + Len - 1] % NumElts);
        Res = DAG.getNode(VSHLDQ, DL, v16i8, Res, DAG.getTargetConstant(Scale * Shift, DL, i8, false));
        Res = DAG.getNode(VSRLDQ, DL, v16i8, Res, DAG.getTargetConstant(Scale * ZeroHi, DL, i8, false));
    } else if ZeroHi == 0 {
        let mut Shift: u32 = Mask[ZeroLo] % NumElts;
        Res = DAG.getNode(VSRLDQ, DL, v16i8, Res, DAG.getTargetConstant(Scale * Shift, DL, i8, false));
        Res = DAG.getNode(VSHLDQ, DL, v16i8, Res, DAG.getTargetConstant(Scale * ZeroLo, DL, i8, false));
    } else if !Subtarget.hasSSSE3() {
        let mut Shift: u32 = (NumElts - 1) - (Mask[ZeroLo + Len - 1] % NumElts);
        Res = DAG.getNode(VSHLDQ, DL, v16i8, Res, DAG.getTargetConstant(Scale * Shift, DL, i8, false));
        Shift += Mask[ZeroLo] % NumElts;
        Res = DAG.getNode(VSRLDQ, DL, v16i8, Res, DAG.getTargetConstant(Scale * Shift, DL, i8, false));
        Res = DAG.getNode(VSHLDQ, DL, v16i8, Res, DAG.getTargetConstant(Scale * ZeroLo, DL, i8, false));
    } else {
        return SDValue {};
    }
    return DAG.getBitcast(VT, Res);
}

fn matchShuffleAsShift(ShiftVT: *mut MVT, Opcode: *mut u32, ScalarSizeInBits: u32, Mask: ArrayRef<int>, MaskOffset: i32, Zeroable: *APInt, Subtarget: *X86Subtarget) -> i32 {
    let mut Size: i32 = Mask.len;
    let mut SizeInBits: u32 = Size * ScalarSizeInBits;
    let mut CheckZeros: Closure_45 = Closure_45 { Size: &mut Size, Zeroable: &mut Zeroable };
    let mut MatchShift: Closure_46 = Closure_46 { Size: &mut Size, Mask: &mut Mask, MaskOffset: &mut MaskOffset, ScalarSizeInBits: &mut ScalarSizeInBits, Opcode: &mut Opcode, ShiftVT: &mut ShiftVT, SizeInBits: &mut SizeInBits };
    let mut MaxWidth: u32 = (if (SizeInBits == 512) && !Subtarget.hasBWI() { 64 } else { 128 });
    for let mut Scale: i32 = 2; Scale * ScalarSizeInBits <= MaxWidth; Scale *= 2 {
        for let mut Shift: i32 = 1; Shift != Scale; Shift += 1 {
            for Left in [true, false] {
                if CheckZeros.call(Shift, Scale, Left) {
                    let mut ShiftAmt: i32 = MatchShift.call(Shift, Scale, Left);
                    if 0 < ShiftAmt {
                        return ShiftAmt;
                    }
                }
            }
        }
    }
    return -1;
}

fn lowerShuffleAsShift(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, BitwiseOnly: bool) -> SDValue {
    let mut Size: i32 = Mask.len;
    assert!(Size == VT.getVectorNumElements() as i32, "Unexpected mask size");
    let mut ShiftVT: MVT = MVT {};
    let mut V: SDValue = V1;
    let mut Opcode: u32 = 0;
    let mut ShiftAmt: i32 = matchShuffleAsShift(ShiftVT, Opcode, VT.getScalarSizeInBits(), Mask, 0, Zeroable, Subtarget);
    if ShiftAmt < 0 {
        ShiftAmt = matchShuffleAsShift(ShiftVT, Opcode, VT.getScalarSizeInBits(), Mask, Size, Zeroable, Subtarget);
        V = V2;
    }
    if ShiftAmt < 0 {
        return SDValue {};
    }
    if BitwiseOnly && (Opcode == VSHLDQ || Opcode == VSRLDQ) {
        return SDValue {};
    }
    assert!(DAG.getTargetLoweringInfo().isTypeLegal(ShiftVT), "Illegal integer vector type");
    V = DAG.getBitcast(ShiftVT, V);
    V = DAG.getNode(Opcode, DL, ShiftVT, V, DAG.getTargetConstant(ShiftAmt, DL, i8, false));
    return DAG.getBitcast(VT, V);
}

fn matchShuffleAsVSHLD(ShiftVT: *mut MVT, V1: *mut SDValue, V2: *mut SDValue, ScalarSizeInBits: u32, Mask: ArrayRef<int>) -> i32 {
    assert!(isPowerOf2_32(ScalarSizeInBits) && ScalarSizeInBits >= 8, "Unexpected element size");
    let mut Size: i32 = Mask.len;
    if is_contained(Mask, SM_SentinelZero) {
        return -1;
    }
    let mut FunnelMask: SmallVector<int, 32> = Size;
    for let mut Scale: i32 = 2; (Scale * ScalarSizeInBits) <= 64; Scale *= 2 {
        for let mut Shift: i32 = 1; Shift != Scale; Shift += 1 {
            for let mut Elt: i32 = 0; Elt != Size; Elt += Scale {
                iota(FunnelMask.begin() + Elt, FunnelMask.begin() + Elt + Shift, Elt + Size + (Scale - Shift));
                iota(FunnelMask.begin() + Elt + Shift, FunnelMask.begin() + Elt + Scale, Elt);
            }
            if isShuffleEquivalent(Mask, FunnelMask, SDValue {}, SDValue {}) {
                let mut ShiftSVT: MVT = getIntegerVT(ScalarSizeInBits * Scale);
                ShiftVT = getVectorVT(ShiftSVT, Size / Scale);
                return Shift * ScalarSizeInBits;
            }
            commuteMask(FunnelMask);
            if isShuffleEquivalent(Mask, FunnelMask, SDValue {}, SDValue {}) {
                let mut ShiftSVT: MVT = getIntegerVT(ScalarSizeInBits * Scale);
                ShiftVT = getVectorVT(ShiftSVT, Size / Scale);
                swap(V1, V2);
                return Shift * ScalarSizeInBits;
            }
        }
    }
    return -1;
}

fn matchShuffleAsEXTRQ(VT: MVT, V1: *mut SDValue, V2: *mut SDValue, Mask: ArrayRef<int>, BitLen: *mut u64, BitIdx: *mut u64, Zeroable: *APInt) -> bool {
    let mut Size: i32 = Mask.len;
    let mut HalfSize: i32 = Size / 2;
    assert!(Size == VT.getVectorNumElements() as i32, "Unexpected mask size");
    assert!(!Zeroable.isAllOnes(), "Fully zeroable shuffle mask");
    if !isUndefUpperHalf(Mask) {
        return false;
    }
    let mut Len: i32 = HalfSize;
    for ; Len > 0; Len -= 1 {
        if !Zeroable[Len - 1] {
            break;
        }
    }
    assert!(Len > 0, "Zeroable shuffle mask");
    let mut Src: SDValue = SDValue {};
    let mut Idx: i32 = -1;
    for let mut i: i32 = 0; i != Len; i += 1 {
        let mut M: i32 = Mask[i];
        if M == SM_SentinelUndef {
            continue;
        }
        let mut V: *mut SDValue = (if M < Size { V1 } else { V2 });
        M = M % Size;
        if i > M || M >= HalfSize {
            return false;
        }
        if Idx < 0 || (Src == V && Idx == (M - i)) {
            Src = V;
            Idx = M - i;
            continue;
        }
        return false;
    }
    if !Src || Idx < 0 {
        return false;
    }
    assert!((Idx + Len) <= HalfSize, "Illegal extraction mask");
    BitLen = (Len * VT.getScalarSizeInBits()) & 63;
    BitIdx = (Idx * VT.getScalarSizeInBits()) & 63;
    V1 = Src;
    return true;
}

fn matchShuffleAsINSERTQ(VT: MVT, V1: *mut SDValue, V2: *mut SDValue, Mask: ArrayRef<int>, BitLen: *mut u64, BitIdx: *mut u64) -> bool {
    let mut Size: i32 = Mask.len;
    let mut HalfSize: i32 = Size / 2;
    assert!(Size == VT.getVectorNumElements() as i32, "Unexpected mask size");
    if !isUndefUpperHalf(Mask) {
        return false;
    }
    for let mut Idx: i32 = 0; Idx != HalfSize; Idx += 1 {
        let mut Base: SDValue = SDValue {};
        if isUndefInRange(Mask, 0, Idx) {} else if isSequentialOrUndefInRange(Mask, 0, Idx, 0, 1) {
            Base = V1;
        } else if isSequentialOrUndefInRange(Mask, 0, Idx, Size, 1) {
            Base = V2;
        } else {
            continue;
        }
        for let mut Hi: i32 = Idx + 1; Hi <= HalfSize; Hi += 1 {
            let mut Insert: SDValue = SDValue {};
            let mut Len: i32 = Hi - Idx;
            if isSequentialOrUndefInRange(Mask, Idx, Len, 0, 1) {
                Insert = V1;
            } else if isSequentialOrUndefInRange(Mask, Idx, Len, Size, 1) {
                Insert = V2;
            } else {
                continue;
            }
            if isUndefInRange(Mask, Hi, HalfSize - Hi) {} else if (!Base || (Base == V1)) && isSequentialOrUndefInRange(Mask, Hi, HalfSize - Hi, Hi, 1) {
                Base = V1;
            } else if (!Base || (Base == V2)) && isSequentialOrUndefInRange(Mask, Hi, HalfSize - Hi, Size + Hi, 1) {
                Base = V2;
            } else {
                continue;
            }
            BitLen = (Len * VT.getScalarSizeInBits()) & 63;
            BitIdx = (Idx * VT.getScalarSizeInBits()) & 63;
            V1 = Base;
            V2 = Insert;
            return true;
        }
    }
    return false;
}

fn lowerShuffleWithSSE4A(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, DAG: *mut SelectionDAG) -> SDValue {
    let mut BitLen: u64 = 0;
    let mut BitIdx: u64 = 0;
    if matchShuffleAsEXTRQ(VT, V1, V2, Mask, BitLen, BitIdx, Zeroable) {
        return DAG.getNode(EXTRQI, DL, VT, V1, DAG.getTargetConstant(BitLen, DL, i8, false), DAG.getTargetConstant(BitIdx, DL, i8, false));
    }
    if matchShuffleAsINSERTQ(VT, V1, V2, Mask, BitLen, BitIdx) {
        return DAG.getNode(INSERTQI, DL, VT, if V1 { V1 } else { DAG.getUNDEF(VT) }, if V2 { V2 } else { DAG.getUNDEF(VT) }, DAG.getTargetConstant(BitLen, DL, i8, false), DAG.getTargetConstant(BitIdx, DL, i8, false));
    }
    return SDValue {};
}

fn lowerShuffleAsSpecificExtension(DL: *SDLoc, VT: MVT, Scale: i32, Offset: i32, ExtOpc: u32, InputV: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Scale > 1, "Need a scale to extend.");
    assert!(isExtOpcode(ExtOpc), "Unsupported extension");
    let mut EltBits: i32 = VT.getScalarSizeInBits();
    let mut NumElements: i32 = VT.getVectorNumElements();
    let mut NumEltsPerLane: i32 = 128 / EltBits;
    let mut OffsetLane: i32 = Offset / NumEltsPerLane;
    assert!((EltBits == 8 || EltBits == 16 || EltBits == 32), "Only 8, 16, and 32 bit elements can be extended.");
    assert!(Scale * EltBits <= 64, "Cannot zero extend past 64 bits.");
    assert!(0 <= Offset, "Extension offset must be positive.");
    assert!((Offset < NumEltsPerLane || Offset % NumEltsPerLane == 0), "Extension offset must be in the first lane or start an upper lane.");
    let mut SafeOffset: Closure_47 = Closure_47 { OffsetLane: &mut OffsetLane, NumEltsPerLane: &mut NumEltsPerLane };
    let mut ShuffleOffset: Closure_48 = Closure_48 { Offset: &mut Offset, NumElements: &mut NumElements, Scale: &mut Scale, SafeOffset: &mut SafeOffset, DAG: &mut DAG, VT: &mut VT, DL: &mut DL };
    if Subtarget.hasSSE41() {
        if Offset && Scale == 2 && VT.is128BitVector() {
            return SDValue {};
        }
        let mut ExtVT: MVT = getVectorVT(getIntegerVT(EltBits * Scale), NumElements / Scale);
        InputV = DAG.getBitcast(VT, InputV);
        InputV = ShuffleOffset.call(InputV);
        InputV = getEXTEND_VECTOR_INREG(ExtOpc, DL, ExtVT, InputV, DAG);
        return DAG.getBitcast(VT, InputV);
    }
    assert!(VT.is128BitVector(), "Only 128-bit vectors can be extended.");
    InputV = DAG.getBitcast(VT, InputV);
    let mut AnyExt: bool = ExtOpc == ANY_EXTEND;
    if ExtOpc == SIGN_EXTEND {
        return SDValue {};
    }
    if AnyExt && EltBits == 32 {
        let mut PSHUFDMask: [4]i32 = [Offset, -1, if SafeOffset.call(Offset + 1) { Offset + 1 } else { -1 }, -1];
        return DAG.getBitcast(VT, DAG.getNode(PSHUFD, DL, v4i32, DAG.getBitcast(v4i32, InputV), getV4X86ShuffleImm8ForMask(PSHUFDMask, DL, DAG)));
    }
    if AnyExt && EltBits == 16 && Scale > 2 {
        let mut PSHUFDMask: [4]i32 = [Offset / 2, -1, if SafeOffset.call(Offset + 1) { (Offset + 1) / 2 } else { -1 }, -1];
        InputV = DAG.getNode(PSHUFD, DL, v4i32, DAG.getBitcast(v4i32, InputV), getV4X86ShuffleImm8ForMask(PSHUFDMask, DL, DAG));
        let mut PSHUFWMask: [4]i32 = [1, -1, -1, -1];
        let mut OddEvenOp: u32 = if (Offset & 1) { PSHUFLW } else { PSHUFHW };
        return DAG.getBitcast(VT, DAG.getNode(OddEvenOp, DL, v8i16, DAG.getBitcast(v8i16, InputV), getV4X86ShuffleImm8ForMask(PSHUFWMask, DL, DAG)));
    }
    if (Scale * EltBits) == 64 && EltBits < 32 && Subtarget.hasSSE4A() {
        assert!(NumElements == Mask.len as i32, "Unexpected shuffle mask size!");
        assert!(VT.is128BitVector(), "Unexpected vector width!");
        let mut LoIdx: i32 = Offset * EltBits;
        let mut Lo: SDValue = DAG.getBitcast(v2i64, DAG.getNode(EXTRQI, DL, VT, InputV, DAG.getTargetConstant(EltBits, DL, i8, false), DAG.getTargetConstant(LoIdx, DL, i8, false)));
        if isUndefUpperHalf(Mask) || !SafeOffset.call(Offset + 1) {
            return DAG.getBitcast(VT, Lo);
        }
        let mut HiIdx: i32 = (Offset + 1) * EltBits;
        let mut Hi: SDValue = DAG.getBitcast(v2i64, DAG.getNode(EXTRQI, DL, VT, InputV, DAG.getTargetConstant(EltBits, DL, i8, false), DAG.getTargetConstant(HiIdx, DL, i8, false)));
        return DAG.getBitcast(VT, DAG.getNode(UNPCKL, DL, v2i64, Lo, Hi));
    }
    if Scale > 4 && EltBits == 8 && Subtarget.hasSSSE3() {
        assert!(NumElements == 16, "Unexpected byte vector width!");
        let mut PSHUFBMask: [16]SDValue = [16]SDValue {};
        for let mut i: i32 = 0; i < 16; i += 1 {
            let mut Idx: i32 = Offset + (i / Scale);
            if (i % Scale == 0 && SafeOffset.call(Idx)) {
                PSHUFBMask[i] = DAG.getConstant(Idx, DL, i8, false, false);
                continue;
            }
            PSHUFBMask[i] = if AnyExt { DAG.getUNDEF(i8) } else { DAG.getConstant(128, DL, i8, false, false) };
        }
        InputV = DAG.getBitcast(v16i8, InputV);
        return DAG.getBitcast(VT, DAG.getNode(PSHUFB, DL, v16i8, InputV, DAG.getBuildVector(v16i8, DL, PSHUFBMask)));
    }
    let mut AlignToUnpack: i32 = Offset % (NumElements / Scale);
    if AlignToUnpack {
        let mut ShMask: SmallVector<int, 8> = SmallVector<int, 8> { NumElements as u32, -1 };
        for let mut i: i32 = AlignToUnpack; i < NumElements; i += 1 {
            ShMask[i - AlignToUnpack] = i;
        }
        InputV = DAG.getVectorShuffle(VT, DL, InputV, DAG.getUNDEF(VT), ShMask);
        Offset -= AlignToUnpack;
    }
    while true {
        {
        let mut UnpackLoHi: u32 = UNPCKL;
        if Offset >= (NumElements / 2) {
            UnpackLoHi = UNPCKH;
            Offset -= (NumElements / 2);
        }
        let mut InputVT: MVT = getVectorVT(getIntegerVT(EltBits), NumElements);
        let mut Ext: SDValue = if AnyExt { DAG.getUNDEF(InputVT) } else { getZeroVector(InputVT, Subtarget, DAG, DL) };
        InputV = DAG.getBitcast(InputVT, InputV);
        InputV = DAG.getNode(UnpackLoHi, DL, InputVT, InputV, Ext);
        Scale /= 2;
        EltBits *= 2;
        NumElements /= 2;
    }
        if !(Scale > 1) { break; }
    }
    return DAG.getBitcast(VT, InputV);
}

fn lowerShuffleAsZeroOrAnyExtend(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut Bits: i32 = VT.getSizeInBits().operator unsigned long long();
    let mut NumLanes: i32 = Bits / 128;
    let mut NumElements: i32 = VT.getVectorNumElements();
    let mut NumEltsPerLane: i32 = NumElements / NumLanes;
    assert!(VT.getScalarSizeInBits() <= 32, "Exceeds 32-bit integer zero extension limit");
    assert!(Mask.len as i32 == NumElements, "Unexpected shuffle mask size");
    let mut Lower: Closure_49 = Closure_49 { NumElements: &mut NumElements, Mask: &mut Mask, Zeroable: &mut Zeroable, V1: &mut V1, V2: &mut V2, NumEltsPerLane: &mut NumEltsPerLane, DL: &mut DL, VT: &mut VT, Subtarget: &mut Subtarget, DAG: &mut DAG };
    if VT == v4i32 && (V1.getOpcode() == SCALAR_TO_VECTOR || isa(V1)) && Mask[0] == 0 && (NumElements - 1) == Zeroable.countLeadingOnes() as i32 {
        return DAG.getNode(VZEXT_MOVL, DL, VT, V1);
    }
    assert!(Bits % 64 == 0, "The number of bits in a vector must be divisible by 64 on x86!");
    let mut NumExtElements: i32 = Bits / 64;
    for ; NumExtElements < NumElements; NumExtElements *= 2 {
        assert!(NumElements % NumExtElements == 0, "The input vector size must be divisible by the extended size.");
        if Lower.call(NumElements / NumExtElements) {
            V;
        } else {
            return V;
        }
    }
    if Bits != 128 {
        return SDValue {};
    }
    let mut CanZExtLowHalf: Closure_50 = Closure_50 { NumElements: &mut NumElements, Zeroable: &mut Zeroable, Mask: &mut Mask, V1: &mut V1, V2: &mut V2 };
    if CanZExtLowHalf.call() {
        V;
    } else {
        V = DAG.getBitcast(v2i64, V);
        V = DAG.getNode(VZEXT_MOVL, DL, v2i64, V);
        return DAG.getBitcast(VT, V);
    }
    return SDValue {};
}

fn getScalarValueForVectorElement(V: SDValue, Idx: i32, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = V.getSimpleValueType();
    let mut EltVT: MVT = VT.getVectorElementType();
    V = peekThroughBitcasts(V);
    let mut NewVT: MVT = V.getSimpleValueType();
    if !NewVT.isVector() || NewVT.getScalarSizeInBits() != VT.getScalarSizeInBits() {
        return SDValue {};
    }
    if V.getOpcode() == BUILD_VECTOR || (Idx == 0 && V.getOpcode() == SCALAR_TO_VECTOR) {
        let mut S: SDValue = V.getOperand(Idx);
        if EltVT.getSizeInBits() == S.getSimpleValueType().getSizeInBits() {
            return DAG.getBitcast(EltVT, S);
        }
    }
    return SDValue {};
}

fn isShuffleFoldableLoad(V: SDValue) -> bool {
    return V.hasOneUse() && isNON_EXTLoad(peekThroughOneUseBitcasts(V).getNode());
}

