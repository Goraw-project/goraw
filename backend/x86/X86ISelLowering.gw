        let mut RepeatedMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        if operator!(getTargetShuffleInputs(peekThroughBitcasts(Op), Mask, (*self.DAG))) || () != 1 || [0]() != (*self.VT).getSizeInBits() || !scaleShuffleMaskElts((*self.NumElts), Mask, ScaledMask) || !isRepeatedTargetShuffleMask(128, (*self.VT), ScaledMask, RepeatedMask) || !isInRange(RepeatedMask[M & 1], 0, 2) {
