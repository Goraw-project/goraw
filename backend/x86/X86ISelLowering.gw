struct Closure_15 {
    SizeInBits: *mut u32,
    AllowWholeUndefs: *mut bool,
    AllowPartialUndefs: *mut bool,
    NumElts: *mut u32,
    UndefElts: *mut APInt,
    EltBits: *mut SmallVectorImpl<APInt>,
    EltSizeInBits: *mut u32,
}

unsafe fn Closure_15::call(self: *mut Closure_15, UndefSrcElts: *mut APInt, SrcEltBits: ArrayRef<APInt>) -> bool {
        let mut NumSrcElts: u32 = UndefSrcElts.getBitWidth();
        let mut SrcEltSizeInBits: u32 = SrcEltBits[0].getBitWidth();
        assert!((NumSrcElts * SrcEltSizeInBits) == (*self.SizeInBits), "Constant bit sizes don't match");
        let mut AllowUndefs: bool = (*self.AllowWholeUndefs) || (*self.AllowPartialUndefs);
        if UndefSrcElts.getBoolValue() && !AllowUndefs {
            return false;
        }
        if NumSrcElts == (*self.NumElts) {
            (*self.UndefElts) = UndefSrcElts;
            (*self.EltBits).assign(SrcEltBits.begin(), SrcEltBits.end());
            return true;
        }
        let mut UndefBits: APInt = APInt { (*self.SizeInBits), 0, false, false };
        let mut MaskBits: APInt = APInt { (*self.SizeInBits), 0, false, false };
        for let mut i: u32 = 0; i != NumSrcElts; i += 1 {
            let mut BitOffset: u32 = i * SrcEltSizeInBits;
            if UndefSrcElts[i] {
                UndefBits.setBits(BitOffset, BitOffset + SrcEltSizeInBits);
            }
            MaskBits.insertBits(SrcEltBits[i], BitOffset);
        }
        (*self.UndefElts) = APInt { (*self.NumElts), 0, false, false };
        (*self.EltBits).resize((*self.NumElts), APInt { (*self.EltSizeInBits), 0, false, false });
        for let mut i: u32 = 0; i != (*self.NumElts); i += 1 {
            let mut BitOffset: u32 = i * (*self.EltSizeInBits);
            let mut UndefEltBits: APInt = UndefBits.extractBits((*self.EltSizeInBits), BitOffset);
            if UndefEltBits.isAllOnes() {
                if !(*self.AllowWholeUndefs) {
                    return false;
                }
                (*self.UndefElts).setBit(i);
                continue;
            }
            if UndefEltBits.getBoolValue() && !(*self.AllowPartialUndefs) {
                return false;
            }
            (*self.EltBits)[i] = MaskBits.extractBits((*self.EltSizeInBits), BitOffset);
        }
        return true;
    }

struct Closure_16 {}

fn Closure_16::call(self: *Closure_16, Cst: *Constant, Mask: *mut APInt, Undefs: *mut APInt, UndefBitIndex: u32) -> bool {
        if !Cst {
            return false;
        }
        if isa(Cst) {
            Undefs.setBit(UndefBitIndex);
            return true;
        }
        if dyn_cast(Cst) {
            CInt;
        } else {
            Mask = getSplat(CInt.getType().getPrimitiveSizeInBits().operator unsigned long long(), CInt.getValue());
            return true;
        }
        if dyn_cast(Cst) {
            CFP;
        } else {
            Mask = getSplat(CFP.getType().getPrimitiveSizeInBits().operator unsigned long long(), CFP.getValueAPF().bitcastToAPInt());
            return true;
        }
        if dyn_cast(Cst) {
            CDS;
        } else {
            let mut Ty: *mut Type = CDS.getType();
            if Ty.isVectorTy() {
                Mask = getZero(Ty.getPrimitiveSizeInBits().operator unsigned long long());
                let mut EltTy: *mut Type = CDS.getElementType();
                let mut IsInteger: bool = EltTy.isIntegerTy();
                let mut IsFP: bool = EltTy.isHalfTy() || EltTy.isFloatTy() || EltTy.isDoubleTy();
                if !IsInteger && !IsFP {
                    return false;
                }
                let mut EltBits: u32 = EltTy.getPrimitiveSizeInBits().operator unsigned long long();
                for let mut I: u32 = 0;
let mut E: u32 = CDS.getNumElements(); I != E; I += 1 {
                    if IsInteger {
                        Mask.insertBits(CDS.getElementAsAPInt(I), I * EltBits);
                    } else {
                        Mask.insertBits(CDS.getElementAsAPFloat(I).bitcastToAPInt(), I * EltBits);
                    }
                }
                return true;
            }
        }
        return false;
    }

