        return SDValue {};
    }
    if !operator(Ld).hasNUsesOfValue(NumElts - NumUndefElts, 0) {
        return SDValue {};
    }
    if ScalarSize == 32 || (IsGE256 && ScalarSize == 64) || (Subtarget()() && ScalarSize == 64) {
        let mut LN: *mut auto = cast(Ld);
        let mut Tys: SDVTList = DAG.getVTList(EVT { VT }, EVT { Other });
        let mut Ops: []SDValue = void { (), () };
        let mut BCast: SDValue = DAG;
        DAG.ReplaceAllUsesOfValueWith(BCast.getValue(1));
        return BCast;
    }
    if Subtarget.hasInt256() && Ld.getValueType().isInteger() && (ScalarSize == 8 || ScalarSize == 16 || ScalarSize == 64) {
        let mut LN: *mut auto = cast(Ld);
        let mut Tys: SDVTList = DAG.getVTList(EVT { VT }, EVT { Other });
        let mut Ops: []SDValue = void { (), () };
        let mut BCast: SDValue = DAG;
        DAG.ReplaceAllUsesOfValueWith(BCast.getValue(1));
        return BCast;
    }
    if ScalarSize == 16 && Subtarget()() && IsGE256 {
        return DAG;
    }
    return SDValue {};
}

fn getUnderlyingExtractedFromVec(ExtractedFromVec: *mut SDValue, ExtIdx: SDValue) -> i32 {
    let mut Idx: i32 = operator(ExtIdx).getAsZExtVal();
    if !isa(ExtractedFromVec) {
        return Idx;
    }
    let mut SVOp: *mut ShuffleVectorSDNode = cast(ExtractedFromVec);
    let mut ShuffleVec: SDValue = SVOp.getOperand(0);
    let mut ShuffleVecVT: MVT = ShuffleVec.getSimpleValueType();
    assert!(ShuffleVecVT.getVectorElementType() == ExtractedFromVec.getSimpleValueType().getVectorElementType();
    let mut ShuffleIdx: i32 = SVOp.getMaskElt(Idx);
    if isUndefOrInRange(ShuffleIdx, 0, ShuffleVecVT.getVectorNumElements()) {
        ExtractedFromVec = ShuffleVec;
        return ShuffleIdx;
    }
    return Idx;
}

fn buildFromShuffleMostly(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if operator!(TLI.isOperationLegalOrCustom) {
        return SDValue {};
    }
    let mut NumElems: u32 = Op.getNumOperands();
    let mut VecIn1: SDValue = SDValue {};
    let mut VecIn2: SDValue = SDValue {};
    let mut InsertIndices: SmallVector<unsigned int, 4> = SmallVector<unsigned int, 4> {};
    let mut Mask: SmallVector<int, 8> = zeroed();
    for let mut i: u32 = 0; i != NumElems; i += 1 {
        let mut Opc: u32 = Op.getOperand(i).getOpcode();
        if Opc == POISON || Opc == UNDEF {
            continue;
        }
        if Opc != EXTRACT_VECTOR_ELT {
            if InsertIndices.len > 1 {
                return SDValue {};
            }
            InsertIndices.push(i);
            continue;
        }
        let mut ExtractedFromVec: SDValue = Op.getOperand(i).getOperand(0);
        let mut ExtIdx: SDValue = Op.getOperand(i).getOperand(1);
        if !isa(ExtIdx) {
            return SDValue {};
        }
        let mut Idx: i32 = getUnderlyingExtractedFromVec(ExtractedFromVec, ExtIdx);
        if ExtractedFromVec.getValueType() != EVT { VT } {
            return SDValue {};
        }
        if !VecIn1.getNode() {
            VecIn1 = ExtractedFromVec;
        } else if VecIn1 != ExtractedFromVec {
            if !VecIn2.getNode() {
                VecIn2 = ExtractedFromVec;
            } else if VecIn2 != ExtractedFromVec {
                return SDValue {};
            }
        }
        if ExtractedFromVec == VecIn1 {
            Mask()[i] = Idx;
        } else if ExtractedFromVec == VecIn2 {
            Mask()[i] = Idx + NumElems;
        }
    }
    if !VecIn1.getNode() {
        return SDValue {};
    }
    VecIn2 = if VecIn2.getNode() { VecIn2 } else { DAG.getPOISON(EVT { VT }) };
    let mut NV: SDValue = DAG.getVectorShuffle(VT, DL, VecIn1, VecIn2);
    for Idx in InsertIndices {
        NV = DAG.getNode(INSERT_VECTOR_ELT, DL, EVT { VT }, NV, Op.getOperand(Idx), DAG.getVectorIdxConstant(Idx, DL, false));
    }
    return NV;
}

fn LowerBUILD_VECTORvXbf16(Op: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut SVT: MVT = if Subtarget()() { f16 } else { i16 };
    let mut IVT: MVT = VT.changeVectorElementType(SVT);
    let mut NewOps: SmallVector<SDValue, 16> = zeroed();
    for let mut I: u32 = 0;
let mut E: u32 = Op.getNumOperands(); I != E; I += 1 {
        NewOps()(DAG.getBitcast(EVT { SVT }, Op.getOperand(I)));
    }
    let mut Res: SDValue = DAG(BUILD_VECTOR, SDLoc {}, IVT);
    return DAG.getBitcast(EVT { VT }, Res);
}

fn LowerBUILD_VECTORvXi1(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    assert!((VT.getVectorElementType() == i1), "Unexpected type in LowerBUILD_VECTORvXi1!");
    if isBuildVectorAllZeros(Op.getNode()) || isBuildVectorAllOnes(Op.getNode()) {
        return Op;
    }
    let mut Undefs: u64 = 0;
    let mut Immediate: u64 = 0;
    let mut NonConstMask: u64 = 0;
    let mut NonConstElts: i32 = 0;
    let mut HasConstElts: bool = false;
    for let mut idx: u32 = 0;
let mut e: u32 = Op.getNumOperands(); idx < e; idx += 1 {
        let mut In: SDValue = Op.getOperand(idx);
        if In.isUndef() {
            Undefs |= 1 << idx;
            continue;
        }
        if  {
            operator|=(Immediate, (InC()() & 1) << idx);
            HasConstElts = true;
        } else {
            NonConstMask |= 1 << idx;
            NonConstElts()(In);
        }
    }
    if NonConstElts()() == 1 {
        let mut Cond: SDValue = operator*();
        assert!(Cond.getValueType() == EVT { i8 }, "Unexpected VT!");
        if Cond.getOpcode() != SETCC {
            Cond = DAG.getNode(AND, dl, EVT { i8 }, Cond, DAG.getConstant(1, dl, EVT { i8 }, false, false));
        }
        let mut TrueImm: u64 = NonConstMask | Immediate;
        let mut FalseImm: u64 = Immediate;
        if VT == v64i1 && operator!(Subtarget()()) {
            let mut TrueLo: u64 = TrueImm as u32;
            let mut TrueHi: u64 = TrueImm >> 32;
            let mut FalseLo: u64 = FalseImm as u32;
            let mut FalseHi: u64 = FalseImm >> 32;
            let mut Lo: SDValue = DAG.getSelect(dl, EVT { i32 }, Cond, DAG.getConstant(TrueLo, dl, EVT { i32 }, false, false), DAG.getConstant(FalseLo, dl, EVT { i32 }, false, false), SDNodeFlags { Flags: None });
            let mut Hi: SDValue = DAG.getSelect(dl, EVT { i32 }, Cond, DAG.getConstant(TrueHi, dl, EVT { i32 }, false, false), DAG.getConstant(FalseHi, dl, EVT { i32 }, false, false), SDNodeFlags { Flags: None });
            Lo = DAG.getBitcast(EVT { v32i1 }, Lo);
            Hi = DAG.getBitcast(EVT { v32i1 }, Hi);
            return DAG.getNode(CONCAT_VECTORS, dl, EVT { v64i1 }, Lo, Hi);
        } else {
            let mut ImmVT: MVT = getIntegerVT(max(VT.getSizeInBits().operator unsigned long long() as u32, 8));
            if (TrueImm | Undefs) == (~0 >> (64 - VT.getSizeInBits().operator unsigned long long())) {
                TrueImm = ~0 >> (64 - ImmVT.getSizeInBits().operator unsigned long long());
            }
            let mut Select: SDValue = DAG.getSelect(dl, EVT { ImmVT }, Cond, DAG.getConstant(TrueImm, dl, EVT { ImmVT }, false, false), DAG.getConstant(FalseImm, dl, EVT { ImmVT }, false, false), SDNodeFlags { Flags: None });
            let mut VecVT: MVT = if VT.getSizeInBits().operator unsigned long long() >= 8 { VT } else { MVT { SimpleTy: v8i1 } };
            Select = DAG.getBitcast(EVT { VecVT }, Select);
            return DAG.getNode(EXTRACT_SUBVECTOR, dl, EVT { VT }, Select, DAG.getVectorIdxConstant(0, dl, false));
        }
    }
    let mut OpVT: MVT = Op.getOperand(0).getSimpleValueType();
    if OpVT == i8 && NonConstMask != 0 {
        let mut ByteVT: MVT = VT.changeVectorElementType(MVT { SimpleTy: i8 });
        let mut WideSVT: MVT = if Subtarget()() { i8 } else { i32 };
        if ByteVT.getSizeInBits().operator unsigned long long() < 128 {
            WideSVT = MVT { SimpleTy: if ByteVT == v4i8 { i32 } else { i64 } };
            ByteVT = MVT { SimpleTy: v16i8 };
        }
        let mut WideVT: MVT = VT.changeVectorElementType(WideSVT);
        if DAG.getTargetLoweringInfo().isTypeLegal && DAG.getTargetLoweringInfo().isTypeLegal {
            let mut Elts: SmallVector<SDValue, 16> = zeroed();
            Elts()(ByteVT.getVectorNumElements() - (), DAG.getPOISON(EVT { OpVT }));
            let mut ByteBV: SDValue = DAG(ByteVT, dl);
            let mut WideBV: SDValue = getEXTEND_VECTOR_INREG(ANY_EXTEND, dl, EVT { WideVT }, ByteBV, DAG);
            WideBV = DAG.getNode(AND, dl, EVT { WideVT }, WideBV, DAG.getConstant(1, dl, EVT { WideVT }, false, false));
            return DAG.getSetCC(dl, EVT { VT }, WideBV, DAG.getConstant(0, dl, EVT { WideVT }, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    let mut DstVec: SDValue = SDValue {};
    if HasConstElts {
        if VT == v64i1 && operator!(Subtarget()()) {
            let mut ImmL: SDValue = DAG.getConstant(Lo_32(Immediate), dl, EVT { i32 }, false, false);
            let mut ImmH: SDValue = DAG.getConstant(Hi_32(Immediate), dl, EVT { i32 }, false, false);
            ImmL = DAG.getBitcast(EVT { v32i1 }, ImmL);
            ImmH = DAG.getBitcast(EVT { v32i1 }, ImmH);
            DstVec = DAG.getNode(CONCAT_VECTORS, dl, EVT { v64i1 }, ImmL, ImmH);
        } else {
            let mut ImmVT: MVT = getIntegerVT(max(VT.getSizeInBits().operator unsigned long long() as u32, 8));
            let mut Imm: SDValue = DAG.getConstant(Immediate, dl, EVT { ImmVT }, false, false);
            let mut VecVT: MVT = if VT.getSizeInBits().operator unsigned long long() >= 8 { VT } else { MVT { SimpleTy: v8i1 } };
            DstVec = DAG.getBitcast(EVT { VecVT }, Imm);
            DstVec = DAG.getNode(EXTRACT_SUBVECTOR, dl, EVT { VT }, DstVec, DAG.getVectorIdxConstant(0, dl, false));
        }
    } else {
        DstVec = DAG.getUNDEF(EVT { VT });
    }
    for let mut Idx: u32 = 0;
let mut E: u32 = Op.getNumOperands(); Idx != E; Idx += 1 {
        if NonConstMask & (1 << Idx) {
            DstVec = DAG.getInsertVectorElt(dl, DstVec, Op.getOperand(Idx), Idx);
        }
    }
    return DstVec;
}

