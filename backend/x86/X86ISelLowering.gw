    BuildMI(TrapBB, MIMD, TII());
    DispatchBB.addSuccessor(TrapBB, getUnknown());
    let mut DispContBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(null, nullopt());
    DispatchBB.addSuccessor(DispContBB, getUnknown());
    MF.push(DispatchBB);
    MF.push(DispContBB);
    MF.push(TrapBB);
    self.SetupEntryBlockForSjLj(MI, BB, DispatchBB, FI);
    let mut JTE: u32 = self.getJumpTableEncoding();
    let mut JTI: *mut MachineJumpTableInfo = MF.getOrCreateJumpTableInfo(JTE);
    let mut MJTI: u32 = JTI()();
    let mut RI: *X86RegisterInfo = TII.getRegisterInfo();
    if RI.hasBasePointer(*MF) {
        let mut FPIs64Bit: bool = self.Subtarget.isTarget64BitLP64();
        let mut MFI: *mut X86MachineFunctionInfo = MF;
        MFI.setRestoreBasePointer(MF);
        let mut FP: Register = RI.getFrameRegister(*MF);
        let mut BP: Register = RI.getBaseRegister();
        let mut Op: u32 = 0;
        addRegOffset(BuildMI(DispatchBB, MIMD, TII()(Op), BP), FP, true, MFI.getRestoreBasePointerOffset())(RI.getNoPreservedMask());
    } else {
        BuildMI(DispatchBB, MIMD, TII())(RI.getNoPreservedMask());
    }
    let mut IReg: Register = MRI;
    addFrameReference(BuildMI(DispatchBB, MIMD, TII(), IReg), FI, if self.Subtarget() { 8 } else { 4 });
    BuildMI(DispatchBB, MIMD, TII())(IReg)();
