    }
    MIB = BuildMI(*thisMBB, MI, MIMD, TII.get, FP);
    for let mut i: u32 = 0; i < AddrNumOperands; i += 1 {
        let mut MO: *MachineOperand = MI.getOperand(i);
        if MO.isReg() {
            MIB()(MO.getReg());
        } else {
            MIB()(MO);
        }
    }
    operator(MIB).setMemRefs();
    MIB()(FrameDestroy);
    MIB = BuildMI(*thisMBB, MI, MIMD, TII.get, Tmp);
    for let mut i: u32 = 0; i < AddrNumOperands; i += 1 {
        let mut MO: *MachineOperand = MI.getOperand(i);
        if i == AddrDisp {
            MIB()(MO, LabelOffset);
        } else if MO.isReg() {
            MIB()(MO.getReg());
        } else {
            MIB()(MO);
        }
    }
    operator(MIB).setMemRefs();
    MIB = BuildMI(*thisMBB, MI, MIMD, TII.get, SP);
    for let mut i: u32 = 0; i < AddrNumOperands; i += 1 {
        if i == AddrDisp {
            MIB()(MI.getOperand(i), SPOffset);
        } else {
            MIB()(MI.getOperand(i));
        }
    }
    operator(MIB).setMemRefs();
    MIB()(FrameDestroy);
    BuildMI(*thisMBB, MI, MIMD, TII.get)(Tmp);
    MI()();
    return thisMBB;
