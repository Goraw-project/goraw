}

fn getBLENDIBlendMask(V: SDValue) -> APInt {
    let mut NumElts: u32 = V.getSimpleValueType().getVectorNumElements();
    let mut Mask: APInt = V.getConstantOperandAPInt(2);
    if Mask.getBitWidth() > NumElts {
        Mask = Mask.trunc(NumElts);
    }
    if NumElts == 16 {
        assert!(Mask.getBitWidth() == 8, "Unexpected v16i16 blend mask width");
        Mask = getSplat(16, Mask);
    }
    assert!(Mask.getBitWidth() == NumElts, "Unexpected blend mask width");
    return Mask;
}

fn combineRedundantDWordShuffle(N: SDValue, Mask: MutableArrayRef<int>, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
