    Src2: *mut SDValue,
}

unsafe fn Closure_115::call(self: *mut Closure_115) -> bool {
            match (*self.LHS).getOpcode() {
                _ => {
                    break;
                },
                AND => {
                    if (*self.LHS).getOperand(0) == (*self.RHS) || (*self.LHS).getOperand(1) == (*self.RHS) {
                        (*self.Src1) = (*self.LHS).getOperand(if (*self.LHS).getOperand(0) == (*self.RHS) { 1 } else { 0 });
                        (*self.Src2) = (*self.RHS);
                        return true;
                    }
                },
            }
            return false;
        }

