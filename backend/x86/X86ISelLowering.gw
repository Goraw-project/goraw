        let mut BReg: Register = MRI;
        let mut IReg64: Register = MRI;
        BuildMI(DispContBB, MIMD, TII(), BReg)(1)(0)(MJTI)(0);
        BuildMI(DispContBB, MIMD, TII()(SUBREG_TO_REG), IReg64)(IReg);
        match JTE {
            EK_BlockAddress => {
                BuildMI(DispContBB, MIMD, TII())(BReg)(8)(IReg64)(0)(0);
            },
            EK_LabelDifference32 => {
                let mut OReg: Register = MRI;
                let mut OReg64: Register = MRI;
                let mut TReg: Register = MRI;
                BuildMI(DispContBB, MIMD, TII(), OReg)(BReg)(4)(IReg64)(0)(0);
                BuildMI(DispContBB, MIMD, TII(), OReg64)(OReg);
                BuildMI(DispContBB, MIMD, TII(), TReg)(OReg64)(BReg);
                BuildMI(DispContBB, MIMD, TII())(TReg);
                break;
            },
            _ => {
                llvm_unreachable_internal("Unexpected jump table encoding", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 38924);
            },
        }
    } else {
        BuildMI(DispContBB, MIMD, TII())(0)(4)(IReg)(MJTI)(0);
    }
    let mut SeenMBBs: SmallPtrSet<MachineBasicBlock *, 8> = zeroed();
    let mut MBBLPads: SmallVector<MachineBasicBlock *, 64> = zeroed();
    let mut SavedRegs: *MCPhysReg = MF.getRegInfo().getCalleeSavedRegs();
    MI()();
    return BB;
}

fn X86TargetLowering::emitPatchableEventCall(self: *X86TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut TII: *TargetInstrInfo = *self.Subtarget.getInstrInfo();
    let mut MIMD: MIMetadata = MIMetadata { MI };
    let mut MF: *mut MachineFunction = *BB.getParent();
    MF.getFrameInfo().setAdjustsStack(true);
    let mut AdjStackDown: u32 = TII.getCallFrameSetupOpcode();
    let mut CallseqStart: MachineInstrBuilder = BuildMI(MF, MIMD, TII.get)(0)(0)(0);
    BB();
    let mut AdjStackUp: u32 = TII.getCallFrameDestroyOpcode();
    let mut CallseqEnd: MachineInstrBuilder = BuildMI(MF, MIMD, TII.get)(0)(0);
    BB();
    return BB;
}

fn X86TargetLowering::EmitInstrWithCustomInserter(self: *X86TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = BB.getParent();
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
