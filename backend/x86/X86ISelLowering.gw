unsafe fn Closure_100::call(self: *mut Closure_100, Shift: i32, Left: bool) -> bool {
        let mut Pos: u32 = if Left { Shift } else { 0 };
        let mut Low: u32 = if Left { 0 } else { Shift };
        let mut Len: u32 = (*self.Size) - Shift;
        return isSequentialOrUndefInRange((*self.Mask), Pos, Len, Low + (*self.MaskOffset), 1);
    }

