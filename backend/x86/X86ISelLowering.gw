fn combineX86ShufflesRecursively(Op: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    return combineX86ShufflesRecursively(void { Op }, 0, Op.getOpcode(), Op.getSimpleValueType(), void { 0 }, void {}, 0, MaxShuffleCombineDepth, true, true, isMaskableNode(Op, Subtarget), DAG, SDLoc { Op }, Subtarget);
}

fn getPSHUFShuffleMask(N: SDValue) -> SmallVector<int, 4> {
    let mut Mask: SmallVector<int, 4> = SmallVector<int, 4> {};
    match N.getOpcode() {
        _ => {
