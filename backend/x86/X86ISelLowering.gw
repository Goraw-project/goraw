                if (NumSubElts % ()) == 0 {
                    let mut Scale: i32 = NumSubElts / ();
                    let mut ScaledSubMask: SmallVector<int, 64> = zeroed();
                    narrowShuffleMaskElts(Scale);
                    SubMask() = ;
                } else {
                    let mut Scale: i32 = () / NumSubElts;
                    NumSubElts = ();
                    NumElts *= Scale;
                    InsertIdx *= Scale;
                }
            }
            Ops()(Src);
            Ops()();
            if isBuildVectorAllZeros(Src.getNode()) {
                Mask.append(NumElts, SM_SentinelZero);
            } else {
                for let mut i: i32 = 0; i != NumElts as i32; i += 1 {
                    Mask.push(i);
                }
            }
            for let mut i: i32 = 0; i != NumSubElts as i32; i += 1 {
                let mut M: i32 = [i];
                if 0 <= M {
                    let mut InputIdx: i32 = M / NumSubElts;
                    M = (NumElts * (1 + InputIdx)) + (M % NumSubElts);
                }
                Mask[i + InsertIdx] = M;
            }
            return true;
        },
        SCALAR_TO_VECTOR => {
            INSERT_VECTOR_ELT;
        },
        VSELECT => {
            let mut Cond: SDValue = N.getOperand(0);
            if createShuffleMaskFromVSELECT(Mask, Cond) {
                Ops()(N.getOperand(1));
                Ops()(N.getOperand(2));
                return true;
            }
            return false;
        },
        SHL => {
            SRL;
        },
        ROTL => {
            ROTR;
        },
        SIGN_EXTEND_VECTOR_INREG => {
            let mut Src: SDValue = N.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            let mut NumBitsPerSrcElt: u32 = SrcVT.getScalarSizeInBits();
            if !SrcVT.isSimple() || (SrcVT.getSizeInBits().operator unsigned long long() % 128) != 0 || (NumBitsPerSrcElt % 8) != 0 {
                return false;
            }
            let mut DemandedSrcElts: APInt = DemandedElts.zextOrTrunc(SrcVT.getVectorNumElements());
            if DAG.ComputeNumSignBits(Src, DemandedSrcElts, 0) != NumBitsPerSrcElt {
                return false;
            }
            assert!((NumBitsPerElt % NumBitsPerSrcElt) == 0, "Unexpected extension");
            let mut Scale: u32 = NumBitsPerElt / NumBitsPerSrcElt;
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                Mask.append(Scale, I);
            }
            Ops()(Src);
            return true;
        },
        ZERO_EXTEND => {
            ANY_EXTEND;
        },
    }
    return false;
}

fn resolveTargetShuffleInputsAndMask(Inputs: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>) {
    let mut MaskWidth: i32 = Mask.len;
    let mut UsedInputs: SmallVector<SDValue, 16> = zeroed();
    for let mut i: i32 = 0;
let mut e: i32 = Inputs()(); i < e; i += 1 {
        let mut lo: i32 = () * MaskWidth;
        let mut hi: i32 = lo + MaskWidth;
        if  {
            for M in Mask {
                if (lo <= M) && (M < hi) {
                    M = SM_SentinelUndef;
                }
            }
        }
        if none_of(Mask, Closure_19 { lo: lo, hi: hi }) {
            for M in Mask {
                if lo <= M {
                    M -= MaskWidth;
                }
            }
            continue;
        }
        let mut IsRepeat: bool = false;
        for let mut j: i32 = 0;
let mut ue: i32 = (); j != ue; j += 1 {
            if peekThroughBitcasts([j]) != peekThroughBitcasts() {
                continue;
            }
            for M in Mask {
                if lo <= M {
                    M = if (M < hi) { ((M - lo) + (j * MaskWidth)) } else { (M - MaskWidth) };
                }
            }
            IsRepeat = true;
            break;
        }
        if IsRepeat {
            continue;
        }
        UsedInputs();
    }
    Inputs = move();
}

fn getTargetShuffleInputs(Op: SDValue, DemandedElts: *APInt, Inputs: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>, KnownUndef: *mut APInt, KnownZero: *mut APInt, DAG: *SelectionDAG, Depth: u32, ResolveKnownElts: bool) -> bool {
    if Depth >= MaxRecursionDepth {
        return false;
    }
    let mut VT: EVT = Op.getValueType();
    if !VT.isSimple() || !VT.isVector() {
        return false;
    }
    if getTargetShuffleAndZeroables(Op, Mask, Inputs, KnownUndef, KnownZero) {
        if ResolveKnownElts {
            resolveTargetShuffleFromZeroables(Mask, KnownUndef, KnownZero, true);
        }
        return true;
    }
    if getFauxShuffleMask(Op, DemandedElts, Mask, Inputs, DAG, Depth, ResolveKnownElts) {
        resolveZeroablesFromTargetShuffle(Mask, KnownUndef, KnownZero);
        return true;
    }
    return false;
}

fn getTargetShuffleInputs(Op: SDValue, DemandedElts: *APInt, Inputs: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>, DAG: *SelectionDAG, Depth: u32, ResolveKnownElts: bool) -> bool {
    let mut KnownUndef: APInt = APInt {};
    let mut KnownZero: APInt = APInt {};
    return getTargetShuffleInputs(Op, DemandedElts, Inputs, Mask, KnownUndef, KnownZero, DAG, Depth, ResolveKnownElts);
}

fn getTargetShuffleInputs(Op: SDValue, Inputs: *mut SmallVectorImpl<SDValue>, Mask: *mut SmallVectorImpl<int>, DAG: *SelectionDAG, Depth: u32, ResolveKnownElts: bool) -> bool {
    let mut VT: EVT = Op.getValueType();
    if !VT.isSimple() || !VT.isVector() {
        return false;
    }
    let mut NumElts: u32 = Op.getValueType().getVectorNumElements();
    let mut DemandedElts: APInt = getAllOnes(NumElts);
    return getTargetShuffleInputs(Op, DemandedElts, Inputs, Mask, DAG, Depth, ResolveKnownElts);
}

fn getBROADCAST_LOAD(Opcode: u32, DL: *SDLoc, VT: EVT, MemVT: EVT, Mem: *mut MemSDNode, Offset: u32, DAG: *mut SelectionDAG) -> SDValue {
    if !Mem || !Mem.readMem() || !Mem.isSimple() || Mem.isNonTemporal() {
        return SDValue {};
    }
    let mut Ptr: SDValue = DAG.getMemBasePlusOffset(Mem.getBasePtr(), getFixed(Offset), DL, SDNodeFlags { Flags: None });
    let mut Tys: SDVTList = DAG.getVTList(VT, EVT { Other });
    let mut Ops: [2]SDValue = [Mem.getChain(), Ptr];
    let mut BcstLd: SDValue = DAG;
    DAG.makeEquivalentMemoryOrdering(SDValue { Node: Mem, ResNo: 1 }, BcstLd.getValue(1));
    return BcstLd;
}

fn getShuffleScalarElt(Op: SDValue, Index: u32, DAG: *mut SelectionDAG, Depth: u32) -> SDValue {
    if Depth >= MaxRecursionDepth {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    let mut Opcode: u32 = Op.getOpcode();
    let mut NumElems: u32 = VT.getVectorNumElements();
    if  {
        let mut Elt: i32 = (Index);
        if Elt < 0 {
            return DAG.getUNDEF(VT.getVectorElementType());
        }
        let mut Src: SDValue = if (Elt < NumElems as i32) { (0) } else { (1) };
        return getShuffleScalarElt(Src, Elt % NumElems, DAG, Depth + 1);
    }
    if isTargetShuffle(Opcode) {
        let mut ShufVT: MVT = VT.getSimpleVT();
        let mut ShufSVT: MVT = ShufVT.getVectorElementType();
        let mut NumElems: i32 = ShufVT.getVectorNumElements() as i32;
        let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        let mut ShuffleOps: SmallVector<SDValue, 16> = zeroed();
        if operator!(getTargetShuffleMask(Op, true, ShuffleMask)) {
            return SDValue {};
        }
        let mut Elt: i32 = ShuffleMask[Index];
        if Elt == SM_SentinelZero {
            return if ShufSVT.isInteger() { DAG.getConstant(0, SDLoc { Op }, EVT { ShufSVT }, false, false) } else { DAG.getConstantFP(0.0, SDLoc { Op }, EVT { ShufSVT }, false) };
        }
        if Elt == SM_SentinelUndef {
            return DAG.getUNDEF(EVT { ShufSVT });
        }
        assert!(0 <= Elt && Elt < (2 * NumElems), "Shuffle index out of range");
        let mut Src: SDValue = if (Elt < NumElems) { [0] } else { [1] };
        return getShuffleScalarElt(Src, Elt % NumElems, DAG, Depth + 1);
    }
    if Opcode == INSERT_SUBVECTOR {
        let mut Vec: SDValue = Op.getOperand(0);
        let mut Sub: SDValue = Op.getOperand(1);
        let mut SubIdx: u64 = Op.getConstantOperandVal(2);
        let mut NumSubElts: u32 = Sub.getValueType().getVectorNumElements();
        if SubIdx <= Index && Index < (SubIdx + NumSubElts) {
            return getShuffleScalarElt(Sub, Index - SubIdx, DAG, Depth + 1);
        }
        return getShuffleScalarElt(Vec, Index, DAG, Depth + 1);
    }
    if Opcode == CONCAT_VECTORS {
        let mut SubVT: EVT = Op.getOperand(0).getValueType();
        let mut NumSubElts: u32 = SubVT.getVectorNumElements();
        let mut SubIdx: u64 = Index / NumSubElts;
        let mut SubElt: u64 = Index % NumSubElts;
        return getShuffleScalarElt(Op.getOperand(SubIdx), SubElt, DAG, Depth + 1);
    }
    if Opcode == EXTRACT_SUBVECTOR {
        let mut Src: SDValue = Op.getOperand(0);
        let mut SrcIdx: u64 = Op.getConstantOperandVal(1);
        return getShuffleScalarElt(Src, Index + SrcIdx, DAG, Depth + 1);
    }
    if Opcode == BITCAST {
        let mut Src: SDValue = Op.getOperand(0);
        let mut SrcVT: EVT = Src.getValueType();
        if SrcVT.isVector() && SrcVT.getVectorNumElements() == NumElems {
            return getShuffleScalarElt(Src, Index, DAG, Depth + 1);
        }
        return SDValue {};
    }
    if Opcode == INSERT_VECTOR_ELT && isa(Op.getOperand(2)) {
        if Op.getConstantOperandAPInt(2) == Index {
            return Op.getOperand(1);
        }
        return getShuffleScalarElt(Op.getOperand(0), Index, DAG, Depth + 1);
    }
    if Opcode == SCALAR_TO_VECTOR {
        return if (Index == 0) { Op.getOperand(0) } else { DAG.getUNDEF(VT.getVectorElementType()) };
    }
    if Opcode == BUILD_VECTOR {
        return Op.getOperand(Index);
    }
    return SDValue {};
}

fn LowerBuildVectorAsInsert(Op: SDValue, DL: *SDLoc, NonZeroMask: *APInt, NumNonZero: u32, NumZero: u32, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!(((VT == v8i16 && Subtarget.hasSSE2()) || ((VT == v16i8 || VT == v4i32) && Subtarget.hasSSE41())), "Illegal vector insertion");
    let mut V: SDValue = SDValue {};
    let mut First: bool = true;
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        let mut IsNonZero: bool = NonZeroMask[i];
        if !IsNonZero {
            continue;
        }
        if First {
            First = false;
            if NumZero || 0 != i {
                V = getZeroVector(VT, Subtarget, DAG, DL);
            } else {
                assert!(0 == i, "Expected insertion into zero-index");
                V = DAG.getAnyExtOrTrunc(Op.getOperand(i), DL, EVT { i32 });
                V = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v4i32 }, V);
                V = DAG.getBitcast(EVT { VT }, V);
                continue;
            }
        }
        V = DAG.getNode(INSERT_VECTOR_ELT, DL, EVT { VT }, V, Op.getOperand(i), DAG.getVectorIdxConstant(i, DL, false));
    }
    return V;
}

fn LowerBuildVectorv16i8(Op: SDValue, DL: *SDLoc, NonZeroMask: *APInt, NumNonZero: u32, NumZero: u32, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if NumNonZero > 8 && !Subtarget.hasSSE41() {
        return SDValue {};
    }
    if Subtarget.hasSSE41() {
        return LowerBuildVectorAsInsert(Op, DL, NonZeroMask, NumNonZero, NumZero, DAG, Subtarget);
    }
    let mut V: SDValue = SDValue {};
    if !NonZeroMask.extractBits(2, 0).isZero() && !NonZeroMask.extractBits(2, 2).isZero() {
        for let mut I: u32 = 0; I != 4; I += 1 {
            if !NonZeroMask[I] {
                continue;
            }
            let mut Elt: SDValue = DAG.getZExtOrTrunc(Op.getOperand(I), DL, EVT { i32 });
            if I != 0 {
                Elt = DAG.getNode(SHL, DL, EVT { i32 }, Elt, DAG.getConstant(I * 8, DL, EVT { i8 }, false, false));
            }
            V = if V { DAG.getNode(OR, DL, EVT { i32 }, V, Elt) } else { Elt };
        }
        assert!(V, "Failed to fold v16i8 vector to zero");
        V = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v4i32 }, V);
        V = DAG;
        V = DAG.getBitcast(EVT { v8i16 }, V);
    }
    for let mut i: u32 = if V { 4 } else { 0 }; i < 16; i += 2 {
        let mut ThisIsNonZero: bool = NonZeroMask[i];
        let mut NextIsNonZero: bool = NonZeroMask[i + 1];
        if !ThisIsNonZero && !NextIsNonZero {
            continue;
        }
        let mut Elt: SDValue = SDValue {};
        if ThisIsNonZero {
            if NumZero || NextIsNonZero {
                Elt = DAG.getZExtOrTrunc(Op.getOperand(i), DL, EVT { i32 });
            } else {
                Elt = DAG.getAnyExtOrTrunc(Op.getOperand(i), DL, EVT { i32 });
            }
        }
        if NextIsNonZero {
            let mut NextElt: SDValue = Op.getOperand(i + 1);
            if i == 0 && NumZero {
                NextElt = DAG.getZExtOrTrunc(NextElt, DL, EVT { i32 });
            } else {
                NextElt = DAG.getAnyExtOrTrunc(NextElt, DL, EVT { i32 });
            }
            NextElt = DAG.getNode(SHL, DL, EVT { i32 }, NextElt, DAG.getConstant(8, DL, EVT { i8 }, false, false));
            if ThisIsNonZero {
                Elt = DAG.getNode(OR, DL, EVT { i32 }, NextElt, Elt);
            } else {
                Elt = NextElt;
            }
        }
        if !V {
            if i != 0 || NumZero {
                V = getZeroVector(MVT { SimpleTy: v8i16 }, Subtarget, DAG, DL);
            } else {
                V = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v4i32 }, Elt);
                V = DAG.getBitcast(EVT { v8i16 }, V);
                continue;
            }
        }
        Elt = DAG.getNode(TRUNCATE, DL, EVT { i16 }, Elt);
        V = DAG.getNode(INSERT_VECTOR_ELT, DL, EVT { v8i16 }, V, Elt, DAG.getVectorIdxConstant(i / 2, DL, false));
    }
    return DAG.getBitcast(EVT { v16i8 }, V);
}

fn LowerBuildVectorv8i16(Op: SDValue, DL: *SDLoc, NonZeroMask: *APInt, NumNonZero: u32, NumZero: u32, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if NumNonZero > 4 && !Subtarget.hasSSE41() {
        return SDValue {};
    }
    return LowerBuildVectorAsInsert(Op, DL, NonZeroMask, NumNonZero, NumZero, DAG, Subtarget);
}

fn LowerBuildVectorv4x32(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if Subtarget.hasSSE3() && operator!(Subtarget()()) && Op.getOperand(0) == Op.getOperand(2) && Op.getOperand(1) == Op.getOperand(3) && Op.getOperand(0) != Op.getOperand(1) {
        let mut VT: MVT = Op.getSimpleValueType();
        let mut EltVT: MVT = VT.getVectorElementType();
        let mut Ops: [4]SDValue = [Op.getOperand(0), Op.getOperand(1), DAG.getUNDEF(EVT { EltVT }), DAG.getUNDEF(EVT { EltVT })];
        let mut NewBV: SDValue = DAG.getBitcast(EVT { v2f64 }, DAG);
        let mut Dup: SDValue = DAG;
        return DAG.getBitcast(EVT { VT }, Dup);
    }
    let mut Zeroable: bitset<4> = zeroed();
    let mut Undefs: bitset<4> = zeroed();
    for let mut i: i32 = 0; i < 4; i += 1 {
        let mut Elt: SDValue = Op.getOperand(i);
        Undefs()[i] = Elt.isUndef();
        Zeroable()[i] = (Elt.isUndef() || isZeroNode(Elt));
    }
    (((operator!(operator!((Zeroable()() - () > 1 && "We expect at least two non-zero elements!")))) || (_wassert(L"Zeroable.size() - Zeroable.count() > 1 && \"We expect at least two non-zero elements!\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (7648) as u32) , 0)) as void);
    let mut FirstNonZero: SDValue = SDValue {};
    let mut FirstNonZeroIdx: u32 = 0;
    for let mut i: u32 = 0; i < 4; i += 1 {
        if Zeroable()[i] {
            continue;
        }
        let mut Elt: SDValue = Op.getOperand(i);
        if Elt.getOpcode() != EXTRACT_VECTOR_ELT || !isa(Elt.getOperand(1)) {
            return SDValue {};
        }
        let mut VT: MVT = Elt.getOperand(0).getSimpleValueType();
        if !VT.is128BitVector() {
            return SDValue {};
        }
        if !FirstNonZero.getNode() {
            FirstNonZero = Elt;
            FirstNonZeroIdx = i;
        }
    }
    assert!(FirstNonZero.getNode(), "Unexpected build vector of all zeros!");
    let mut V1: SDValue = FirstNonZero.getOperand(0);
    let mut VT: MVT = V1.getSimpleValueType();
    let mut Elt: SDValue = SDValue {};
    let mut EltMaskIdx: u32 = 0;
    let mut EltIdx: u32 = 0;
    let mut Mask: [4]i32 = zeroed();
    for EltIdx = 0; EltIdx < 4; EltIdx += 1 {
        if Zeroable()[EltIdx] {
            Mask[EltIdx] = EltIdx + 4;
            continue;
        }
        Elt = operator(Op).getOperand(EltIdx);
        EltMaskIdx = Elt.getConstantOperandVal(1);
        if Elt.getOperand(0) != V1 || EltMaskIdx != EltIdx {
            break;
        }
        Mask[EltIdx] = EltIdx;
    }
    if EltIdx == 4 {
        let mut VZeroOrUndef: SDValue = if (Zeroable() == ) { DAG.getUNDEF(EVT { VT }) } else { getZeroVector(VT, Subtarget, DAG, DL) };
        if V1.getSimpleValueType() != VT {
            V1 = DAG.getBitcast(EVT { VT }, V1);
        }
        return DAG.getVectorShuffle;
    }
    if !Subtarget.hasSSE41() {
        return SDValue {};
    }
    let mut V2: SDValue = Elt.getOperand(0);
    if Elt == FirstNonZero && EltIdx == FirstNonZeroIdx {
        V1 = SDValue {};
    }
    let mut CanFold: bool = true;
    for let mut i: u32 = EltIdx + 1; i < 4 && CanFold; i += 1 {
        if Zeroable()[i] {
            continue;
        }
        let mut Current: SDValue = operator(Op).getOperand(i);
        let mut SrcVector: SDValue = operator(Current).getOperand(0);
        if !V1.getNode() {
            V1 = SrcVector;
        }
        CanFold = (SrcVector == V1) && (Current.getConstantOperandAPInt(1) == i);
    }
    if !CanFold {
        return SDValue {};
    }
    assert!(V1.getNode(), "Expected at least two non-zero elements!");
    if V1.getSimpleValueType() != v4f32 {
        V1 = DAG.getBitcast(EVT { v4f32 }, V1);
    }
    if V2.getSimpleValueType() != v4f32 {
        V2 = DAG.getBitcast(EVT { v4f32 }, V2);
    }
    let mut ZMask: u32 = ();
    let mut InsertPSMask: u32 = EltMaskIdx << 6 | EltIdx << 4 | ZMask;
    assert!((InsertPSMask & ~255) == 0, "Invalid mask!");
    let mut Result: SDValue = DAG;
    return DAG.getBitcast(EVT { VT }, Result);
}

fn getVShift(isLeft: bool, VT: EVT, SrcOp: SDValue, NumBits: u32, DAG: *mut SelectionDAG, TLI: *TargetLowering, dl: *SDLoc) -> SDValue {
    assert!(VT.is128BitVector(), "Unknown type for VShift");
    let mut ShVT: MVT = MVT { SimpleTy: v16i8 };
    let mut Opc: u32 = 0;
    SrcOp = DAG.getBitcast(EVT { ShVT }, SrcOp);
    assert!(NumBits % 8 == 0, "Only support byte sized shifts");
    let mut ShiftVal: SDValue = DAG.getTargetConstant(NumBits / 8, dl, EVT { i8 }, false);
    return DAG.getBitcast(VT, DAG.getNode(Opc, dl, EVT { ShVT }, SrcOp, ShiftVal));
}

fn LowerAsSplatVectorLoad(SrcOp: SDValue, VT: MVT, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if dyn_cast(SrcOp) {
        LD;
    } else {
        let mut Ptr: SDValue = LD.getBasePtr();
        if !isNormalLoad(LD) || !LD.isSimple() {
            return SDValue {};
        }
        let mut PVT: EVT = LD.getValueType(0);
        if PVT != EVT { i32 } && PVT != EVT { f32 } {
            return SDValue {};
        }
        let mut FI: i32 = -1;
        let mut Offset: i64 = 0;
        if dyn_cast(Ptr) {
            FINode;
        } else {
            FI = FINode.getIndex();
            Offset = 0;
        }
        let mut RequiredAlign: Align = Align { ShiftValue: VT.getSizeInBits().operator unsigned long long() / 8 };
        let mut Chain: SDValue = LD.getChain();
        let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
        let mut InferredAlign: MaybeAlign = DAG.InferPtrAlign(Ptr);
        if !InferredAlign || operator(InferredAlign) < RequiredAlign {
            if MFI.isFixedObjectIndex(FI) {
                return SDValue {};
            } else {
                MFI.setObjectAlignment(FI, RequiredAlign);
            }
        }
        if Offset < 0 {
            return SDValue {};
        }
        if (Offset % RequiredAlign.value()) & 3 {
            return SDValue {};
        }
        let mut StartOffset: i64 = Offset & ~RequiredAlign.value() - 1;
        if StartOffset {
            let mut DL: SDLoc = SDLoc { Ptr };
            Ptr = DAG.getNode(ADD, DL, Ptr.getValueType(), Ptr, DAG.getConstant(StartOffset, DL, Ptr.getValueType(), false, false));
        }
        let mut EltNo: i32 = (Offset - StartOffset) >> 2;
        let mut NumElems: u32 = VT.getVectorNumElements();
        let mut NVT: EVT = getVectorVT(*DAG.getContext(), PVT, NumElems, false);
        let mut V1: SDValue = DAG.getLoad(NVT, dl, Chain, Ptr, LD.getPointerInfo().getWithOffset(StartOffset), MaybeAlign {}, MONone, MMOMetadata {});
        let mut Mask: SmallVector<int, 8> = zeroed();
        return DAG.getVectorShuffle(NVT, dl, V1, DAG.getUNDEF(NVT));
    }
    return SDValue {};
}

fn findEltLoadSrc(Elt: SDValue, Ld: *mut *mut LoadSDNode, ByteOffset: *mut i64) -> bool {
    if isNON_EXTLoad(Elt.getNode()) {
        let mut BaseLd: *mut auto = cast(Elt);
        if operator!() {
            return false;
        }
        Ld = ;
        ByteOffset = 0;
        return true;
    }
    match Elt.getOpcode() {
        BITCAST => {
            TRUNCATE;
        },
        SRL => {
            if  {
                let mut Amt: u64 = ();
                if (Amt % 8) == 0 && findEltLoadSrc(Elt.getOperand(0), Ld, ByteOffset) {
                    ByteOffset += Amt / 8;
                    return true;
                }
            }
        },
        EXTRACT_VECTOR_ELT => {
            if  {
                let mut Src: SDValue = Elt.getOperand(0);
                let mut SrcSizeInBits: u32 = Src.getScalarValueSizeInBits();
                let mut DstSizeInBits: u32 = Elt.getScalarValueSizeInBits();
                if DstSizeInBits == SrcSizeInBits && (SrcSizeInBits % 8) == 0 && findEltLoadSrc(Src, Ld, ByteOffset) {
                    let mut Idx: u64 = ();
                    ByteOffset += Idx * (SrcSizeInBits / 8);
                    return true;
                }
            }
        },
    }
    return false;
}

