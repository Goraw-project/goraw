struct Closure_91 {
    NumLanes: *mut i32,
    NumLaneElts: *mut i32,
    Mask: *mut ArrayRef<int>,
    NumElts: *mut i32,
    DAG: *mut SelectionDAG,
    VT: *mut MVT,
    DL: *mut SDLoc,
    V1: *mut SDValue,
    V2: *mut SDValue,
}

unsafe fn Closure_91::call(self: *mut Closure_91, SubLaneScale: i32) -> SDValue {
        let mut NumSubLanes: i32 = (*self.NumLanes) * SubLaneScale;
        let mut NumSubLaneElts: i32 = (*self.NumLaneElts) / SubLaneScale;
        let mut TopSrcSubLane: i32 = -1;
        let mut Dst2SrcSubLanes: SmallVector<int, 8> = SmallVector<int, 8> { NumSubLanes as u32, -1 };
        let mut RepeatedSubLaneMasks: SmallVector<SmallVector<int, 8>> = SmallVector<SmallVector<int, 8>> { SubLaneScale, SmallVector<int, 8> { NumSubLaneElts as u32, SM_SentinelUndef } };
        for let mut DstSubLane: i32 = 0; DstSubLane != NumSubLanes; DstSubLane += 1 {
            let mut SrcLane: i32 = -1;
            let mut SubLaneMask: SmallVector<int, 8> = SmallVector<int, 8> { NumSubLaneElts as u32, -1 };
            for let mut Elt: i32 = 0; Elt != NumSubLaneElts; Elt += 1 {
                let mut M: i32 = (*self.Mask)[(DstSubLane * NumSubLaneElts) + Elt];
                if M < 0 {
                    continue;
                }
                let mut Lane: i32 = (M % (*self.NumElts)) / (*self.NumLaneElts);
                if (0 <= SrcLane) && (SrcLane != Lane) {
                    return SDValue {};
                }
                SrcLane = Lane;
                let mut LocalM: i32 = (M % (*self.NumLaneElts)) + (if M < (*self.NumElts) { 0 } else { (*self.NumElts) });
                SubLaneMask[Elt] = LocalM;
            }
            if SrcLane < 0 {
                continue;
            }
            for let mut SubLane: i32 = 0; SubLane != SubLaneScale; SubLane += 1 {
                let mut MatchMasks: Closure_92 = Closure_92 { NumSubLaneElts: NumSubLaneElts };
                let mut RepeatedSubLaneMask: *mut SmallVector<int, 8> = RepeatedSubLaneMasks[SubLane];
                if !MatchMasks.call(SubLaneMask, RepeatedSubLaneMask) {
                    continue;
                }
                for let mut i: i32 = 0; i != NumSubLaneElts; i += 1 {
                    let mut M: i32 = SubLaneMask[i];
                    if M < 0 {
                        continue;
                    }
                    assert!((RepeatedSubLaneMask[i] < 0 || RepeatedSubLaneMask[i] == M), "Unexpected mask element");
                    RepeatedSubLaneMask[i] = M;
                }
                let mut SrcSubLane: i32 = (SrcLane * SubLaneScale) + SubLane;
                TopSrcSubLane = if TopSrcSubLane > SrcSubLane { TopSrcSubLane } else { SrcSubLane };
                Dst2SrcSubLanes[DstSubLane] = SrcSubLane;
                break;
            }
            if Dst2SrcSubLanes[DstSubLane] < 0 {
                return SDValue {};
            }
        }
        assert!(0 <= TopSrcSubLane && TopSrcSubLane < NumSubLanes, "Unexpected source lane");
        let mut RepeatedMask: SmallVector<int, 8> = SmallVector<int, 8> { (*self.NumElts) as u32, -1 };
        for let mut SubLane: i32 = 0; SubLane <= TopSrcSubLane; SubLane += 1 {
            let mut Lane: i32 = SubLane / SubLaneScale;
            let mut RepeatedSubLaneMask: *mut SmallVector<int, 8> = RepeatedSubLaneMasks[SubLane % SubLaneScale];
            for let mut Elt: i32 = 0; Elt != NumSubLaneElts; Elt += 1 {
                let mut M: i32 = RepeatedSubLaneMask[Elt];
                if M < 0 {
                    continue;
                }
                let mut Idx: i32 = (SubLane * NumSubLaneElts) + Elt;
                RepeatedMask[Idx] = M + (Lane * (*self.NumLaneElts));
            }
        }
        let mut SubLaneMask: SmallVector<int, 8> = SmallVector<int, 8> { (*self.NumElts) as u32, -1 };
        for let mut i: i32 = 0; i != (*self.NumElts); i += NumSubLaneElts {
            let mut SrcSubLane: i32 = Dst2SrcSubLanes[i / NumSubLaneElts];
            if SrcSubLane < 0 {
                continue;
            }
            for let mut j: i32 = 0; j != NumSubLaneElts; j += 1 {
                SubLaneMask[i + j] = j + (SrcSubLane * NumSubLaneElts);
            }
        }
        if RepeatedMask == (*self.Mask) || SubLaneMask == (*self.Mask) {
            return SDValue {};
        }
        let mut RepeatedShuffle: SDValue = (*self.DAG).getVectorShuffle((*self.VT), (*self.DL), (*self.V1), (*self.V2), RepeatedMask);
        return (*self.DAG).getVectorShuffle((*self.VT), (*self.DL), RepeatedShuffle, (*self.DAG).getUNDEF((*self.VT)), SubLaneMask);
    }

struct Closure_93 {}

fn Closure_93::call(self: *Closure_93, Mask: ArrayRef<int>, Begin0: u32, Begin1: u32) -> bool {
        let mut Size: u64 = Mask.len;
        assert!(Size % 2 == 0, "Expected even mask size");
        for let mut I: u32 = 0; I < Size; I += 2 {
            if Mask[I] != (Begin0 + I / 2) as i32 || Mask[I + 1] != (Begin1 + I / 2) as i32 {
                return false;
            }
        }
        return true;
    }

