        let mut Rotate: SDValue = (*self.DAG).getBitcast((*self.VT), (*self.DAG).getNode(PALIGNR, (*self.DL), ByteVT, (*self.DAG).getBitcast(ByteVT, Hi), (*self.DAG).getBitcast(ByteVT, Lo), (*self.DAG).getTargetConstant((*self.Scale) * RotAmt, (*self.DL), i8, false)));
