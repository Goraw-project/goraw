        Extract;
    } else {
        return Extract;
    }
    if lowerFPToIntToFP(Op, dl, DAG, self.Subtarget) {
        R;
    } else {
        return R;
    }
    if SrcVT.isVector() {
        if SrcVT == v2i32 && VT == v2f64 {
            if IsStrict {
                return DAG;
            }
            return DAG;
        }
        if SrcVT == v2i64 || SrcVT == v4i64 {
            return lowerINT_TO_FP_vXi64(Op, dl, DAG, self.Subtarget);
        }
        return SDValue {};
    }
    assert!(SrcVT <= MVT { SimpleTy: i64 } && SrcVT >= MVT { SimpleTy: i16 }, "Unknown SINT_TO_FP to lower!");
    let mut UseSSEReg: bool = self.isScalarFPTypeInSSEReg(EVT { VT });
    if SrcVT == i32 && UseSSEReg {
        return Op;
    }
    if SrcVT == i64 && UseSSEReg && self.Subtarget() {
        return Op;
    }
    if LowerI64IntToFP_AVX512DQ(Op, dl, DAG, self.Subtarget) {
        V;
    } else {
        return V;
    }
    if LowerI64IntToFP16(Op, dl, DAG, self.Subtarget) {
        V;
    } else {
        return V;
    }
    if SrcVT == i16 && (UseSSEReg || VT == f128) {
        let mut Ext: SDValue = DAG.getNode(SIGN_EXTEND, dl, EVT { i32 }, Src);
        if IsStrict {
            return DAG;
        }
        return DAG.getNode(SINT_TO_FP, dl, EVT { VT }, Ext);
    }
    if VT == f128 || operator!(self.Subtarget()) {
        return SDValue {};
    }
    let mut ValueToStore: SDValue = Src;
    if SrcVT == i64 && self.Subtarget.hasSSE2() && operator!(self.Subtarget()) {
        ValueToStore = DAG.getBitcast(EVT { f64 }, ValueToStore);
    }
    let mut Size: u32 = SrcVT.getStoreSize().operator unsigned long long();
    let mut Alignment: Align = Align { ShiftValue: Size };
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut PtrVT: auto = self.getPointerTy;
    let mut SSFI: i32 = MF.getFrameInfo().CreateStackObject(Size, Alignment, false, null, 0);
    let mut MPI: MachinePointerInfo = getFixedStack(DAG.getMachineFunction(), SSFI, 0);
    let mut StackSlot: SDValue = DAG.getFrameIndex(SSFI);
    Chain = DAG.getStore(Chain, dl, ValueToStore, StackSlot, MPI, Alignment, MONone, MMOMetadata {});
    let mut Tmp: pair<SDValue, SDValue> = self.BuildFILD(EVT { VT }, EVT { SrcVT }, dl, Chain, StackSlot, MPI, Alignment, DAG);
    if IsStrict {
        return DAG.getMergeValues;
