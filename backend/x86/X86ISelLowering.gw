struct Closure_274 {}

fn Closure_274::call(self: *Closure_274, V: SDValue) -> bool {
        if V.hasOneUse() {
            V = peekThroughOneUseBitcasts(V);
            if V.getOpcode() == LOAD {
                return true;
            }
        }
        V = peekThroughBitcasts(V);
        if isBuildVectorOfConstantSDNodes(V.getNode()) {
            return true;
        }
        if isBuildVectorOfConstantFPSDNodes(V.getNode()) {
            return true;
        }
        return V.isUndef();
    }

struct Closure_275 {
    DAG: *mut SelectionDAG,
}

unsafe fn Closure_275::call(self: *mut Closure_275, Op: SDValue, IsZeroExt: bool) -> SDValue {
            if Op.getValueType() != i64 {
                return SDValue {};
            }
            let mut Opc: u32 = if IsZeroExt { ZERO_EXTEND } else { ANY_EXTEND };
            if Op.getOpcode() == Opc && Op.getOperand(0).getScalarValueSizeInBits() <= 32 {
                return Op.getOperand(0);
            }
            let mut Ext: u32 = if IsZeroExt { ZEXTLOAD } else { EXTLOAD };
            if dyn_cast(Op) {
                Ld;
            } else if Ld.getExtensionType() == Ext && Ld.getMemoryVT().getScalarSizeInBits() <= 32 {
                return Op;
            }
            if IsZeroExt {
                let mut Known: KnownBits = (*self.DAG).computeKnownBits(Op, 0);
                if !Known.isConstant() && Known.countMinLeadingZeros() >= 32 {
                    return Op;
                }
            }
            return SDValue {};
        }

struct Closure_276 {
    DAG: *mut SelectionDAG,
    VT: *mut MVT,
    NumElts: *mut u32,
}

unsafe fn Closure_276::call(self: *mut Closure_276, Op: *mut SDValue, M: *mut u64) -> bool {
        let mut Src: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
        let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
        let mut ScaledMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        let mut RepeatedMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        if !getTargetShuffleInputs(peekThroughBitcasts(Op), Src, Mask, (*self.DAG), 0, true) || Src.len != 1 || Src[0].getValueSizeInBits() != (*self.VT).getSizeInBits() || !scaleShuffleMaskElts((*self.NumElts), Mask, ScaledMask) || !isRepeatedTargetShuffleMask(128, (*self.VT), ScaledMask, RepeatedMask) || !isInRange(RepeatedMask[M & 1], 0, 2) {
            return false;
        }
        Op = (*self.DAG).getBitcast((*self.VT), Src[0]);
        M = RepeatedMask[M & 1];
        return true;
    }

struct Closure_277 {}

fn Closure_277::call(self: *Closure_277, Load: SDValue, Op: SDValue) -> bool {
        if !Op.hasOneUse() {
            return false;
        }
        let mut User: *mut SDNode = operator(operator(Op).user_begin());
        if !isNormalStore(User) {
            return false;
        }
        let mut Ld: *mut LoadSDNode = cast(Load);
        let mut St: *mut StoreSDNode = cast(User);
        return Ld.getBasePtr() == St.getBasePtr();
    }

struct Closure_278 {}

fn Closure_278::call(self: *Closure_278, Load: SDValue, Op: SDValue) -> bool {
        if !Load.hasOneUse() || Load.getOpcode() != ATOMIC_LOAD {
            return false;
        }
        if !Op.hasOneUse() {
            return false;
        }
        let mut User: *mut SDNode = operator(operator(Op).user_begin());
        if User.getOpcode() != ATOMIC_STORE {
            return false;
        }
        let mut Ld: *mut AtomicSDNode = cast(Load);
        let mut St: *mut AtomicSDNode = cast(User);
        return Ld.getBasePtr() == St.getBasePtr();
    }

struct Closure_279 {}

fn Closure_279::call(self: *Closure_279, Op: SDValue) -> bool {
        if !Op.hasOneUse() {
            return false;
        }
        let mut User: *mut SDNode = operator(operator(Op).user_begin());
        let mut VT: EVT = User.getValueType(0);
        return (User.getOpcode() == ZERO_EXTEND && (VT == i32 || VT == i64));
    }
