fn X86TargetLowering::emitEHSjLjLongJmp(self: *X86TargetLowering, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MIMD: MIMetadata = MIMetadata { MI };
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut MMOs: SmallVector<MachineMemOperand *, 2> = zeroed();
    let mut PVT: MVT = self.getPointerTy;
    assert!((PVT == i64 || PVT == i32), "Invalid Pointer Size!");
