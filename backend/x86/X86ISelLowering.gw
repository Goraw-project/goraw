    let mut Op: BinOp = AI.getOperation();
    match Op {
        Xchg => {
            return None;
        },
        Add => {
            Sub;
        },
        Or => {
            And;
        },
        Nand => {
            Max;
        },
    }
}

fn X86TargetLowering::lowerIdempotentRMWIntoFencedLoad(self: *X86TargetLowering, AI: *mut AtomicRMWInst) -> *mut LoadInst {
    let mut NativeWidth: u32 = if self.Subtarget() { 64 } else { 32 };
    let mut MemType: *mut Type = AI.getType();
    if MemType.getPrimitiveSizeInBits().operator unsigned long long() > NativeWidth {
        return null;
