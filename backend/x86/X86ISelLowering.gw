    let mut Zero: SDValue = DAG.getTargetConstant(0, DL, EVT { i32 }, false);
    let mut Ops: []SDValue = void { DAG.getRegister, DAG.getTargetConstant(1, DL, EVT { i8 }, false), DAG.getRegister(Register { Reg: 0 }, EVT { i32 }), DAG.getTargetConstant(SPOffset, DL, EVT { i32 }, false), DAG.getRegister(Register { Reg: 0 }, EVT { i16 }), Zero, Chain };
    let mut Res: *mut SDNode = DAG;
    return SDValue { Node: Res, ResNo: 1 };
}

fn LowerATOMIC_FENCE(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Op };
    let mut FenceOrdering: AtomicOrdering = Op.getConstantOperandVal(1) as AtomicOrdering;
    let mut FenceSSID: ID = Op.getConstantOperandVal(2) as ID;
    if FenceOrdering == SequentiallyConsistent && FenceSSID == System {
        if !Subtarget.avoidMFence() && Subtarget.hasMFence() {
            return DAG;
