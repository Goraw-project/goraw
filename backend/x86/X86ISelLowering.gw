    let mut NumElts: u32 = Mask.len;
    let mut RotateSVT: MVT = getIntegerVT(EltSizeInBits * NumSubElts);
    RotateVT = getVectorVT(RotateSVT, NumElts / NumSubElts);
    return RotateAmt;
}

fn lowerShuffleAsBitRotate(DL: *SDLoc, VT: MVT, V1: SDValue, Mask: ArrayRef<int>, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsLegal: bool = (VT.is128BitVector() && Subtarget()()) || Subtarget.hasAVX512();
