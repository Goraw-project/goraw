        },
        STATEPOINT => {
            return self.emitPatchPoint;
        },
        STACKMAP => {
            PATCHPOINT;
        },
        PATCHABLE_EVENT_CALL => {
            PATCHABLE_TYPED_EVENT_CALL;
        },
        PREALLOCATED_SETUP => {
            (((operator!(operator!((self.Subtarget() && "preallocated only used in 32-bit")))) || (_wassert(L"Subtarget.is32Bit() && \"preallocated only used in 32-bit\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (39376) as u32) , 0)) as void);
            let mut MFI: *mut auto = MF;
            MFI()(true);
            let mut PreallocatedId: i64 = MI.getOperand(0).getImm();
            let mut StackAdjustment: u64 = (PreallocatedId);
            assert!(StackAdjustment != 0, "0 stack adjustment");
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-isel", 1) {
                    dbgs() << "PREALLOCATED_SETUP stack adjustment " << StackAdjustment << "\n";
                }
            }
                if !(false) { break; }
            }
            BuildMI(*BB, MI, MIMD, TII.get)(StackAdjustment);
            MI()();
            return BB;
        },
        PREALLOCATED_ARG => {
            (((operator!(operator!((self.Subtarget() && "preallocated calls only used in 32-bit")))) || (_wassert(L"Subtarget.is32Bit() && \"preallocated calls only used in 32-bit\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (39391) as u32) , 0)) as void);
            let mut PreallocatedId: i64 = MI.getOperand(1).getImm();
            let mut ArgIdx: i64 = MI.getOperand(2).getImm();
            let mut MFI: *mut auto = MF;
            let mut ArgOffset: u64 = (PreallocatedId)[ArgIdx];
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-isel", 1) {
                    dbgs() << "PREALLOCATED_ARG arg index " << ArgIdx << ", arg offset " << ArgOffset << "\n";
                }
            }
                if !(false) { break; }
            }
            addRegOffset(BuildMI(*BB, MI, MIMD, TII.get, MI.getOperand(0).getReg()), false, ArgOffset);
            MI()();
            return BB;
        },
    }
}

fn X86TargetLowering::targetShrinkDemandedConstant(self: *X86TargetLowering, Op: SDValue, DemandedBits: *APInt, DemandedElts: *APInt, TLO: *mut TargetLoweringOpt) -> bool {
    let mut VT: EVT = Op.getValueType();
    let mut Opcode: u32 = Op.getOpcode();
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    if VT.isVector() {
        let mut NeedsSignExtension: Closure_129 = Closure_129 { DemandedElts: &mut DemandedElts };
        let mut ActiveBits: u32 = DemandedBits.getActiveBits();
        if  {
            let mut ExtSVT: EVT = getIntegerVT(*TLO.DAG.getContext(), ActiveBits);
            let mut ExtVT: EVT = getVectorVT(*TLO.DAG.getContext(), ExtSVT, VT.getVectorNumElements(), false);
            let mut NewC: SDValue = TLO.DAG.getNode(SIGN_EXTEND_INREG, SDLoc { Op }, VT, Op.getOperand(1), TLO.DAG.getValueType(ExtVT));
            let mut NewOp: SDValue = TLO.DAG.getNode(Opcode, SDLoc { Op }, VT, Op.getOperand(0), NewC);
            return TLO.CombineTo(Op, NewOp);
        }
        return false;
    }
    if Opcode != AND {
        return false;
    }
    let mut C: *mut ConstantSDNode = dyn_cast(Op.getOperand(1));
    if !C {
        return false;
    }
    let mut Mask: *APInt = C.getAPIntValue();
    let mut ShrunkMask: APInt = Mask & DemandedBits;
    let mut Width: u32 = ShrunkMask.getActiveBits();
    if Width == 0 {
        return false;
    }
    Width = bit_ceil(max(Width, 8));
    Width = min(Width, EltSize);
    let mut ZeroExtendMask: APInt = getLowBitsSet(EltSize, Width);
    if ZeroExtendMask == Mask {
        return true;
    }
    if !ZeroExtendMask.isSubsetOf(Mask | operator(DemandedBits)) {
        return false;
    }
    let mut DL: SDLoc = SDLoc { Op };
    let mut NewC: SDValue = TLO.DAG.getConstant(ZeroExtendMask, DL, VT, false, false);
    let mut NewOp: SDValue = TLO.DAG.getNode(AND, DL, VT, Op.getOperand(0), NewC);
    return TLO.CombineTo(Op, NewOp);
}

fn computeKnownBitsForPSADBW(LHS: SDValue, RHS: SDValue, Known: *mut KnownBits, DemandedElts: *APInt, DAG: *SelectionDAG, Depth: u32) {
    let mut Known2: KnownBits = KnownBits {};
    let mut NumSrcElts: u32 = LHS.getValueType().getVectorNumElements();
    let mut DemandedSrcElts: APInt = ScaleBitMask(DemandedElts, NumSrcElts, false);
    Known = DAG.computeKnownBits(RHS, DemandedSrcElts, Depth + 1);
    Known2 = DAG.computeKnownBits(LHS, DemandedSrcElts, Depth + 1);
    Known = abdu(Known, Known2).zext(16);
    Known = add(Known, Known, true, true, false);
    Known = add(Known, Known, true, true, false);
    Known = add(Known, Known, true, true, false);
    Known = Known.zext(64);
}

fn computeKnownBitsForPMADDWD(LHS: SDValue, RHS: SDValue, Known: *mut KnownBits, DemandedElts: *APInt, DAG: *SelectionDAG, Depth: u32) {
    let mut NumSrcElts: u32 = LHS.getValueType().getVectorNumElements();
    let mut DemandedSrcElts: APInt = ScaleBitMask(DemandedElts, NumSrcElts, false);
    let mut DemandedLoElts: APInt = DemandedSrcElts & getSplat(NumSrcElts, APInt { 2, 1, false, false });
    let mut DemandedHiElts: APInt = DemandedSrcElts & getSplat(NumSrcElts, APInt { 2, 2, false, false });
    let mut LHSLo: KnownBits = DAG.computeKnownBits(LHS, DemandedLoElts, Depth + 1);
    let mut LHSHi: KnownBits = DAG.computeKnownBits(LHS, DemandedHiElts, Depth + 1);
    let mut RHSLo: KnownBits = DAG.computeKnownBits(RHS, DemandedLoElts, Depth + 1);
    let mut RHSHi: KnownBits = DAG.computeKnownBits(RHS, DemandedHiElts, Depth + 1);
    let mut Lo: KnownBits = mul(LHSLo.sext(32), RHSLo.sext(32), false);
    let mut Hi: KnownBits = mul(LHSHi.sext(32), RHSHi.sext(32), false);
    Known = add(Lo, Hi, false, false, false);
}

fn computeKnownBitsForPMADDUBSW(LHS: SDValue, RHS: SDValue, Known: *mut KnownBits, DemandedElts: *APInt, DAG: *SelectionDAG, Depth: u32) {
    let mut NumSrcElts: u32 = LHS.getValueType().getVectorNumElements();
    let mut DemandedSrcElts: APInt = ScaleBitMask(DemandedElts, NumSrcElts, false);
    let mut DemandedLoElts: APInt = DemandedSrcElts & getSplat(NumSrcElts, APInt { 2, 1, false, false });
    let mut DemandedHiElts: APInt = DemandedSrcElts & getSplat(NumSrcElts, APInt { 2, 2, false, false });
    let mut LHSLo: KnownBits = DAG.computeKnownBits(LHS, DemandedLoElts, Depth + 1);
    let mut LHSHi: KnownBits = DAG.computeKnownBits(LHS, DemandedHiElts, Depth + 1);
    let mut RHSLo: KnownBits = DAG.computeKnownBits(RHS, DemandedLoElts, Depth + 1);
    let mut RHSHi: KnownBits = DAG.computeKnownBits(RHS, DemandedHiElts, Depth + 1);
    let mut Lo: KnownBits = mul(LHSLo.zext(16), RHSLo.sext(16), false);
    let mut Hi: KnownBits = mul(LHSHi.zext(16), RHSHi.sext(16), false);
    Known = sadd_sat(Lo, Hi);
}

fn computeKnownBitsForHorizontalOperation(Op: SDValue, DemandedElts: *APInt, Depth: u32, DAG: *SelectionDAG, KnownBitsFunc: function_ref<KnownBits (const KnownBits &, const KnownBits &)>) -> KnownBits {
    let mut DemandedEltsLHS: APInt = APInt {};
    let mut DemandedEltsRHS: APInt = APInt {};
    getHorizDemandedEltsForFirstOperand(Op.getValueType().getSizeInBits().operator unsigned long long(), DemandedElts, DemandedEltsLHS, DemandedEltsRHS);
    let mut ComputeForSingleOpFunc: Closure_130 = Closure_130 { DAG: &mut DAG, Depth: Depth };
    if DemandedEltsRHS.isZero() {
        return ComputeForSingleOpFunc(Op.getOperand(0), DemandedEltsLHS);
    }
    if DemandedEltsLHS.isZero() {
        return ComputeForSingleOpFunc(Op.getOperand(1), DemandedEltsRHS);
    }
    return ComputeForSingleOpFunc(Op.getOperand(0), DemandedEltsLHS)(ComputeForSingleOpFunc(Op.getOperand(1), DemandedEltsRHS));
}

fn X86TargetLowering::computeKnownBitsForTargetNode(self: *X86TargetLowering, Op: SDValue, Known: *mut KnownBits, DemandedElts: *APInt, DAG: *SelectionDAG, Depth: u32) {
    let mut BitWidth: u32 = Known.getBitWidth();
    let mut NumElts: u32 = DemandedElts.getBitWidth();
    let mut Opc: u32 = Op.getOpcode();
    let mut VT: EVT = Op.getValueType();
    assert!((Opc >= BUILTIN_OP_END || Opc == INTRINSIC_WO_CHAIN || Opc == INTRINSIC_W_CHAIN || Opc == INTRINSIC_VOID), "Should use MaskedValueIsZero if you don't know whether Op is a target node!");
    Known.resetAll();
    match Opc {
        _ => {
            break;
        },
        INTRINSIC_WO_CHAIN => {
            match operator(Op).getConstantOperandVal(0) {

            }
            break;
        },
    }
    if isTargetShuffle(Opc) {
        let mut Mask: SmallVector<int, 64> = zeroed();
        let mut Ops: SmallVector<SDValue, 2> = zeroed();
        if getTargetShuffleMask(Op, true) {
            let mut NumOps: u32 = ();
            let mut NumElts: u32 = VT.getVectorNumElements();
            if Mask()() == NumElts {
                let mut DemandedOps: SmallVector<APInt, 2> = zeroed();
                Known.Zero.setAllBits();
                Known.One.setAllBits();
                for let mut i: u32 = 0; i != NumElts; i += 1 {
                    if !DemandedElts[i] {
                        continue;
                    }
                    let mut M: i32 = [i];
                    if M == SM_SentinelUndef {
                        Known.resetAll();
                        break;
                    }
                    if M == SM_SentinelZero {
                        Known.One.clearAllBits();
                        continue;
                    }
                    assert!(0 <= M && M as u32 < (NumOps * NumElts), "Shuffle index out of range");
                    let mut OpIdx: u32 = M as u32 / NumElts;
                    let mut EltIdx: u32 = M as u32 % NumElts;
                    if Ops()[OpIdx]() != VT {
                        Known.resetAll();
                        break;
                    }
                    DemandedOps()[OpIdx](EltIdx);
                }
                for let mut i: u32 = 0; i != NumOps && !Known.isUnknown(); i += 1 {
                    if operator!([i]) {
                        continue;
                    }
                    let mut Known2: KnownBits = DAG([i], [i], Depth + 1);
                    Known = Known.intersectWith(Known2);
                }
            }
        }
    }
}

fn X86TargetLowering::ComputeNumSignBitsForTargetNode(self: *X86TargetLowering, Op: SDValue, DemandedElts: *APInt, DAG: *SelectionDAG, Depth: u32) -> u32 {
    let mut VT: EVT = Op.getValueType();
    let mut VTBits: u32 = VT.getScalarSizeInBits();
    let mut Opcode: u32 = Op.getOpcode();
    match Opcode {

    }
    if isTargetShuffle(Opcode) {
        let mut Mask: SmallVector<int, 64> = zeroed();
        let mut Ops: SmallVector<SDValue, 2> = zeroed();
        if getTargetShuffleMask(Op, true) {
            let mut NumOps: u32 = ();
            let mut NumElts: u32 = VT.getVectorNumElements();
            if Mask()() == NumElts {
                let mut DemandedOps: SmallVector<APInt, 2> = zeroed();
                for let mut i: u32 = 0; i != NumElts; i += 1 {
                    if !DemandedElts[i] {
                        continue;
                    }
                    let mut M: i32 = [i];
                    if M == SM_SentinelUndef {
                        return 1;
                    } else if M == SM_SentinelZero {
                        continue;
                    }
                    assert!(0 <= M && M as u32 < (NumOps * NumElts), "Shuffle index out of range");
                    let mut OpIdx: u32 = M as u32 / NumElts;
                    let mut EltIdx: u32 = M as u32 % NumElts;
                    if Ops()[OpIdx]() != VT {
                        return 1;
                    }
                    DemandedOps()[OpIdx](EltIdx);
                }
                let mut Tmp0: u32 = VTBits;
                for let mut i: u32 = 0; i != NumOps && Tmp0 > 1; i += 1 {
                    if operator!([i]) {
                        continue;
                    }
                    let mut Tmp1: u32 = DAG([i], [i], Depth + 1);
                    Tmp0 = min(Tmp0, Tmp1);
                }
                return Tmp0;
            }
        }
    }
    return 1;
}

fn X86TargetLowering::unwrapAddress(self: *X86TargetLowering, N: SDValue) -> SDValue {
    if  {
        return operator(N).getOperand(0);
    }
    return N;
}

fn narrowLoadToVZLoad(LN: *mut LoadSDNode, MemVT: MVT, VT: MVT, DAG: *mut SelectionDAG) -> SDValue {
    if !LN.isSimple() {
        return SDValue {};
    }
    let mut Tys: SDVTList = DAG.getVTList(EVT { VT }, EVT { Other });
    let mut Ops: [2]SDValue = [LN.getChain(), LN.getBasePtr()];
    return DAG;
}

fn matchUnaryShuffle(MaskVT: MVT, Mask: ArrayRef<int>, AllowFloatDomain: bool, AllowIntDomain: bool, V1: SDValue, DAG: *SelectionDAG, Subtarget: *X86Subtarget, Shuffle: *mut u32, SrcVT: *mut MVT, DstVT: *mut MVT) -> bool {
    let mut NumMaskElts: u32 = Mask.len;
    let mut MaskEltSize: u32 = MaskVT.getScalarSizeInBits();
    if (MaskEltSize == 32 || (MaskEltSize == 16 && Subtarget()())) && (V1.getOpcode() == SCALAR_TO_VECTOR || isa(V1)) && Mask[0] == 0 && isUndefOrZeroInRange(Mask, 1, NumMaskElts - 1) {
        if MaskEltSize == 16 {
            SrcVT = DstVT = MaskVT.changeVectorElementType(MVT { SimpleTy: f16 });
        } else {
            SrcVT = DstVT = if !Subtarget.hasSSE2() { MVT { SimpleTy: v4f32 } } else { MaskVT };
        }
        return true;
    }
    if AllowIntDomain && ((MaskVT.is128BitVector() && Subtarget.hasSSE41()) || (MaskVT.is256BitVector() && Subtarget.hasInt256()) || (MaskVT.is512BitVector() && Subtarget.useAVX512Regs())) {
        let mut MaxScale: u32 = 64 / MaskEltSize;
        let mut UseSign: bool = V1.getScalarValueSizeInBits() == MaskEltSize && DAG.ComputeNumSignBits(V1, 0) == MaskEltSize;
        for let mut Scale: u32 = 2; Scale <= MaxScale; Scale *= 2 {
            if Scale == 2 && MaskVT == v64i8 && !Subtarget.useBWIRegs() {
                continue;
            }
            let mut MatchAny: bool = true;
            let mut MatchZero: bool = true;
            let mut MatchSign: bool = UseSign;
            let mut NumDstElts: u32 = NumMaskElts / Scale;
            for let mut i: u32 = 0; i != NumDstElts && (MatchAny || MatchSign || MatchZero); i += 1 {
                if !isUndefOrEqual(Mask[i * Scale], i as i32) {
                    MatchAny = MatchSign = MatchZero = false;
                    break;
                }
                let mut Pos: u32 = (i * Scale) + 1;
                let mut Len: u32 = Scale - 1;
                MatchAny &= isUndefInRange(Mask, Pos, Len);
                MatchZero &= isUndefOrZeroInRange(Mask, Pos, Len);
                MatchSign &= isUndefOrEqualInRange(Mask, i as i32, Pos, Len);
            }
            if MatchAny || MatchSign || MatchZero {
                assert!((MatchSign || MatchZero), "Failed to match sext/zext but matched aext?");
                let mut SrcSize: u32 = max(128, NumDstElts * MaskEltSize);
                let mut ScalarTy: MVT = if MaskVT.isInteger() { MaskVT.getScalarType() } else { getIntegerVT(MaskEltSize) };
                SrcVT = getVectorVT(ScalarTy, SrcSize / MaskEltSize);
                Shuffle = if MatchAny { ANY_EXTEND } else { (if MatchSign { SIGN_EXTEND } else { ZERO_EXTEND }) };
                if SrcVT.getVectorNumElements() != NumDstElts {
                    Shuffle = DAG.getOpcode_EXTEND_VECTOR_INREG(Shuffle);
                }
                DstVT = getIntegerVT(Scale * MaskEltSize);
                DstVT = getVectorVT(DstVT, NumDstElts);
                return true;
            }
        }
    }
    if ((MaskEltSize == 32) || (MaskEltSize == 64 && Subtarget.hasSSE2()) || (MaskEltSize == 16 && Subtarget()())) && Mask[0] == 0 && isUndefOrZeroInRange(Mask, 1, NumMaskElts - 1) {
        if MaskEltSize == 16 {
            SrcVT = DstVT = MaskVT.changeVectorElementType(MVT { SimpleTy: f16 });
        } else {
            SrcVT = DstVT = if !Subtarget.hasSSE2() { MVT { SimpleTy: v4f32 } } else { MaskVT };
        }
        return true;
    }
    if MaskVT.is128BitVector() && Subtarget.hasSSE3() && AllowFloatDomain {
        if isTargetShuffleEquivalent(MaskVT, Mask, ArrayRef<int> { [0, 0] }, DAG, V1, SDValue {}) {
            SrcVT = DstVT = MVT { SimpleTy: v2f64 };
            return true;
        }
        if isTargetShuffleEquivalent(MaskVT, Mask, ArrayRef<int> { [0, 0, 2, 2] }, DAG, V1, SDValue {}) {
            SrcVT = DstVT = MVT { SimpleTy: v4f32 };
            return true;
        }
        if isTargetShuffleEquivalent(MaskVT, Mask, ArrayRef<int> { [1, 1, 3, 3] }, DAG, V1, SDValue {}) {
            SrcVT = DstVT = MVT { SimpleTy: v4f32 };
            return true;
        }
    }
    if MaskVT.is256BitVector() && AllowFloatDomain {
        assert!(Subtarget.hasAVX(), "AVX required for 256-bit vector shuffles");
        if isTargetShuffleEquivalent(MaskVT, Mask, ArrayRef<int> { [0, 0, 2, 2] }, DAG, V1, SDValue {}) {
            SrcVT = DstVT = MVT { SimpleTy: v4f64 };
            return true;
        }
        if isTargetShuffleEquivalent(MaskVT, Mask, ArrayRef<int> { [0, 0, 2, 2, 4, 4, 6, 6] }, DAG, V1, SDValue {}) {
            SrcVT = DstVT = MVT { SimpleTy: v8f32 };
            return true;
        }
        if isTargetShuffleEquivalent(MaskVT, Mask, ArrayRef<int> { [1, 1, 3, 3, 5, 5, 7, 7] }, DAG, V1, SDValue {}) {
            SrcVT = DstVT = MVT { SimpleTy: v8f32 };
            return true;
        }
    }
    if MaskVT.is512BitVector() && AllowFloatDomain {
        assert!(Subtarget.hasAVX512(), "AVX512 required for 512-bit vector shuffles");
        if isTargetShuffleEquivalent(MaskVT, Mask, ArrayRef<int> { [0, 0, 2, 2, 4, 4, 6, 6] }, DAG, V1, SDValue {}) {
            SrcVT = DstVT = MVT { SimpleTy: v8f64 };
            return true;
        }
        if isTargetShuffleEquivalent(MaskVT, Mask, ArrayRef<int> { [0, 0, 2, 2, 4, 4, 6, 6, 8, 8, 10, 10, 12, 12, 14, 14] }, DAG, V1, SDValue {}) {
            SrcVT = DstVT = MVT { SimpleTy: v16f32 };
            return true;
        }
        if isTargetShuffleEquivalent(MaskVT, Mask, ArrayRef<int> { [1, 1, 3, 3, 5, 5, 7, 7, 9, 9, 11, 11, 13, 13, 15, 15] }, DAG, V1, SDValue {}) {
            SrcVT = DstVT = MVT { SimpleTy: v16f32 };
            return true;
        }
    }
    return false;
}

fn matchUnaryPermuteShuffle(MaskVT: MVT, Mask: ArrayRef<int>, Zeroable: *APInt, AllowFloatDomain: bool, AllowIntDomain: bool, DAG: *SelectionDAG, Subtarget: *X86Subtarget, Shuffle: *mut u32, ShuffleVT: *mut MVT, PermuteImm: *mut u32) -> bool {
    let mut NumMaskElts: u32 = Mask.len;
    let mut InputSizeInBits: u32 = MaskVT.getSizeInBits().operator unsigned long long();
    let mut MaskScalarSizeInBits: u32 = InputSizeInBits / NumMaskElts;
    let mut MaskEltVT: MVT = getIntegerVT(MaskScalarSizeInBits);
    let mut ContainsZeros: bool = isAnyZero(Mask);
    if !ContainsZeros && MaskScalarSizeInBits == 64 {
        if is128BitLaneCrossingShuffleMask(MaskEltVT, Mask) {
            if Subtarget.hasAVX2() && MaskVT.is256BitVector() {
                ShuffleVT = MVT { SimpleTy: (if AllowFloatDomain { v4f64 } else { v4i64 }) };
                PermuteImm = getV4X86ShuffleImm(Mask);
                return true;
            }
            if Subtarget.hasAVX512() && MaskVT.is512BitVector() {
                let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
                if is256BitLaneRepeatedShuffleMask(MVT { SimpleTy: v8f64 }, Mask, RepeatedMask) {
                    ShuffleVT = MVT { SimpleTy: (if AllowFloatDomain { v8f64 } else { v8i64 }) };
                    PermuteImm = getV4X86ShuffleImm(RepeatedMask);
                    return true;
                }
            }
        } else if AllowFloatDomain && Subtarget.hasAVX() {
            ShuffleVT = getVectorVT(MVT { SimpleTy: f64 }, Mask.len);
            PermuteImm = 0;
            for let mut i: i32 = 0;
let mut e: i32 = Mask.len; i != e; i += 1 {
                let mut M: i32 = Mask[i];
                if M == SM_SentinelUndef {
                    continue;
                }
                assert!(((M / 2) == (i / 2)), "Out of range shuffle mask index");
                PermuteImm |= (M & 1) << i;
            }
            return true;
        }
    }
    for let mut Order: u32 = 0; Order < 2; Order += 1 {
        if if Subtarget()() { (Order == 1) } else { (Order == 0) } {
            if (MaskScalarSizeInBits == 64 || MaskScalarSizeInBits == 32) && !ContainsZeros && (AllowIntDomain || Subtarget.hasAVX()) {
                let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
                if is128BitLaneRepeatedShuffleMask(MaskEltVT, Mask, RepeatedMask) {
                    let mut WordMask: SmallVector<int, 4> = RepeatedMask;
                    if MaskScalarSizeInBits == 64 {
                        narrowShuffleMaskElts(2, RepeatedMask, WordMask);
                    }
                    ShuffleVT = MVT { SimpleTy: (if AllowIntDomain { i32 } else { f32 }) };
                    ShuffleVT = getVectorVT(ShuffleVT, InputSizeInBits / 32);
                    PermuteImm = getV4X86ShuffleImm(WordMask);
                    return true;
                }
            }
            if !ContainsZeros && AllowIntDomain && MaskScalarSizeInBits == 16 && ((MaskVT.is128BitVector() && Subtarget.hasSSE2()) || (MaskVT.is256BitVector() && Subtarget.hasAVX2()) || (MaskVT.is512BitVector() && Subtarget()())) {
                let mut RepeatedMask: SmallVector<int, 4> = SmallVector<int, 4> {};
                if is128BitLaneRepeatedShuffleMask(MaskEltVT, Mask, RepeatedMask) {
                    let mut LoMask: ArrayRef<int> = ArrayRef<int> { RepeatedMask.ptr + 0, 4 };
                    let mut HiMask: ArrayRef<int> = ArrayRef<int> { RepeatedMask.ptr + 4, 4 };
                    if isUndefOrInRange(LoMask, 0, 4) && isSequentialOrUndefInRange(HiMask, 0, 4, 4, 1) {
                        ShuffleVT = getVectorVT(MVT { SimpleTy: i16 }, InputSizeInBits / 16);
                        PermuteImm = getV4X86ShuffleImm(LoMask);
                        return true;
                    }
                    if isUndefOrInRange(HiMask, 4, 8) && isSequentialOrUndefInRange(LoMask, 0, 4, 0, 1) {
                        let mut OffsetHiMask: [4]i32 = zeroed();
                        for let mut i: i32 = 0; i != 4; i += 1 {
                            OffsetHiMask[i] = (if HiMask[i] < 0 { HiMask[i] } else { HiMask[i] - 4 });
                        }
                        ShuffleVT = getVectorVT(MVT { SimpleTy: i16 }, InputSizeInBits / 16);
                        PermuteImm = getV4X86ShuffleImm(OffsetHiMask);
                        return true;
                    }
                }
            }
        } else {
            if !ContainsZeros && AllowIntDomain && MaskScalarSizeInBits < 64 && ((MaskVT.is128BitVector() && Subtarget()()) || Subtarget.hasAVX512()) {
                let mut RotateAmt: i32 = matchShuffleAsBitRotate(ShuffleVT, MaskScalarSizeInBits, Subtarget, Mask);
                if 0 < RotateAmt {
                    PermuteImm = RotateAmt as u32;
                    return true;
                }
            }
        }
        if AllowIntDomain && ((MaskVT.is128BitVector() && Subtarget.hasSSE2()) || (MaskVT.is256BitVector() && Subtarget.hasAVX2()) || (MaskVT.is512BitVector() && Subtarget.hasAVX512())) {
            let mut ShiftAmt: i32 = matchShuffleAsShift(ShuffleVT, Shuffle, MaskScalarSizeInBits, Mask, 0, Zeroable, Subtarget);
            if 0 < ShiftAmt && (!ShuffleVT.is512BitVector() || Subtarget()() || 32 <= ShuffleVT.getScalarSizeInBits()) {
                if  {
                    continue;
                }
                PermuteImm = ShiftAmt as u32;
                return true;
            }
        }
    }
    return false;
}

