                break;
            }
            SplatIndex = i;
        }
        if 0 <= SplatIndex {
            SplatVal = [SplatIndex];
            return true;
        }
    }
    return false;
}

fn getRoundingModeX86(RM: u32) -> i32 {
    match RM as RoundingMode {
        NearestTiesToEven => {
            return rmToNearest;
        },
        TowardNegative => {
            return rmDownward;
        },
        TowardPositive => {
            return rmUpward;
        },
        TowardZero => {
            return rmTowardZero;
        },
        _ => {
            return rmInvalid;
        },
    }
}

fn getTargetShuffleMaskIndices(MaskNode: SDValue, MaskEltSizeInBits: u32, RawMask: *mut SmallVectorImpl<uint64_t>, UndefElts: *mut APInt) -> bool {
    let mut EltBits: SmallVector<APInt, 64> = zeroed();
    if operator!(getTargetConstantBitsFromNode(MaskNode, MaskEltSizeInBits, UndefElts, true, false)) {
        return false;
    }
    return true;
}

fn isConstantPowerOf2(V: SDValue, EltSizeInBIts: u32, AllowUndefs: bool) -> bool {
    let mut UndefElts: APInt = APInt {};
    let mut EltBits: SmallVector<APInt, 64> = zeroed();
    if operator!(getTargetConstantBitsFromNode(V, EltSizeInBIts, UndefElts, AllowUndefs, false)) {
        return false;
