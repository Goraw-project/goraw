        Chain = if IsStrict { Op.getOperand(0) } else { DAG.getEntryNode() };
        let mut Args: i32 = 0;
        let mut Entry: ArgListEntry = ArgListEntry { In, EVT { SVT }.getTypeForEVT(*DAG.getContext()) };
        Entry.IsSExt = false;
        Entry.IsZExt = true;
        Args()(Entry);
        let mut FPRoundImpl: LibcallImpl = DAG.getLibcalls().getLibcallImpl(if SVT == f64 { FPROUND_F64_F16 } else { FPROUND_F32_F16 });
        if FPRoundImpl == Unsupported {
            return SDValue {};
        }
        let mut CC: ID = DAG.getLibcalls().getLibcallImplCallingConv(FPRoundImpl);
        let mut Callee: SDValue = DAG(FPRoundImpl, self.getPointerTy);
        CLI.setDebugLoc(DL).setChain(Chain)(CC, EVT { i16 }.getTypeForEVT(*DAG.getContext()), Callee, move());
        let mut Res: SDValue = SDValue {};
        tie(Res, Chain) = self.LowerCallTo;
        Res = DAG.getBitcast(EVT { f16 }, Res);
        if IsStrict {
            Res = DAG.getMergeValues;
        }
        return Res;
    }
    if VT.getScalarType() == bf16 {
        if SVT.getScalarType() == f32 && ((self.Subtarget() && self.Subtarget()) || self.Subtarget()) {
            return Op;
        }
        return SDValue {};
    }
    if VT.getScalarType() == f16 && operator!(self.Subtarget()) {
        if operator!(self.Subtarget()) || SVT.getScalarType() != f32 {
            return SDValue {};
        }
        if VT.isVector() {
            return Op;
        }
        let mut Res: SDValue = SDValue {};
        let mut Rnd: SDValue = DAG.getTargetConstant(CUR_DIRECTION, DL, EVT { i32 }, false);
        if IsStrict {
            Res = DAG.getNode(INSERT_VECTOR_ELT, DL, EVT { v4f32 }, DAG.getConstantFP(0, DL, EVT { v4f32 }, false), In, DAG.getVectorIdxConstant(0, DL, false));
            Res = DAG;
            Chain = Res.getValue(1);
        } else {
            Res = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v4f32 }, In);
            Res = DAG;
        }
        Res = DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { i16 }, Res, DAG.getVectorIdxConstant(0, DL, false));
        Res = DAG.getBitcast(EVT { f16 }, Res);
        if IsStrict {
            return DAG.getMergeValues;
        }
        return Res;
    }
    return Op;
}

fn LowerFP16_TO_FP(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut Src: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    assert!(Src.getValueType() == EVT { i16 } && Op.getValueType() == EVT { f32 }, "Unexpected VT!");
    let mut dl: SDLoc = SDLoc { Op };
    let mut Res: SDValue = DAG.getNode(INSERT_VECTOR_ELT, dl, EVT { v8i16 }, DAG.getConstant(0, dl, EVT { v8i16 }, false, false), Src, DAG.getVectorIdxConstant(0, dl, false));
    let mut Chain: SDValue = SDValue {};
    if IsStrict {
        Res = DAG;
        Chain = Res.getValue(1);
    } else {
        Res = DAG;
    }
    Res = DAG.getNode(EXTRACT_VECTOR_ELT, dl, EVT { f32 }, Res, DAG.getVectorIdxConstant(0, dl, false));
    if IsStrict {
        return DAG.getMergeValues;
    }
    return Res;
}

fn LowerFP_TO_FP16(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut Src: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    assert!(Src.getValueType() == EVT { f32 } && Op.getValueType() == EVT { i16 }, "Unexpected VT!");
    let mut dl: SDLoc = SDLoc { Op };
    let mut Res: SDValue = SDValue {};
    let mut Chain: SDValue = SDValue {};
    if IsStrict {
        Res = DAG.getNode(INSERT_VECTOR_ELT, dl, EVT { v4f32 }, DAG.getConstantFP(0, dl, EVT { v4f32 }, false), Src, DAG.getVectorIdxConstant(0, dl, false));
        Res = DAG;
        Chain = Res.getValue(1);
    } else {
        Res = DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { v4f32 }, Src);
        Res = DAG;
    }
    Res = DAG.getNode(EXTRACT_VECTOR_ELT, dl, EVT { i16 }, Res, DAG.getVectorIdxConstant(0, dl, false));
    if IsStrict {
        return DAG.getMergeValues;
    }
    return Res;
}

fn X86TargetLowering::LowerBF16_TO_FP(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Op };
    let mut Src: SDValue = DAG.getBitcast(EVT { i16 }, Op.getOperand(0));
    let mut Res: SDValue = SDValue {};
    if operator!(self.Subtarget()) && isNormalLoad(Src.getNode()) {
        let mut Wide: SDValue = DAG.getZExtOrTrunc(Src, DL, EVT { i32 });
        Wide = DAG.getNode(SHL, DL, EVT { i32 }, Wide, DAG.getShiftAmountConstant(16, EVT { i32 }, DL));
        Res = DAG.getBitcast(EVT { f32 }, Wide);
    } else {
        let mut Vec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v8i16 }, Src);
        Vec = DAG.getBitcast(EVT { v4i32 }, Vec);
        Vec = getTargetVShiftByConstNode(DL, v4i32, Vec, 16, DAG);
        Vec = DAG.getBitcast(EVT { v4f32 }, Vec);
        Res = DAG.getExtractVectorElt(DL, EVT { f32 }, Vec, 0);
    }
    let mut DstVT: EVT = Op.getValueType();
    if DstVT != EVT { f32 } {
        Res = DAG.getNode(FP_EXTEND, DL, DstVT, Res);
    }
    return Res;
}

fn X86TargetLowering::LowerFP_TO_BF16(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Op };
    let mut SVT: MVT = Op.getOperand(0).getSimpleValueType();
    if SVT == f32 && ((self.Subtarget() && self.Subtarget()) || self.Subtarget()) {
        let mut Res: SDValue = SDValue {};
        Res = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v4f32 }, Op.getOperand(0));
        Res = DAG;
        Res = DAG.getBitcast(EVT { v8i16 }, Res);
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { i16 }, Res, DAG.getVectorIdxConstant(0, DL, false));
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut LC: Libcall = getFPROUND(EVT { SVT }, EVT { bf16 });
    let mut Res: SDValue = ;
    return DAG.getBitcast(EVT { i16 }, Res);
}

fn lowerAddSubToHorizontalOp(Op: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    if !LHS.hasOneUse() && !RHS.hasOneUse() {
        return Op;
    }
    let mut IsFP: bool = Op.getSimpleValueType().isFloatingPoint();
    if IsFP && !Subtarget.hasSSE3() {
        return Op;
    }
    if !IsFP && !Subtarget.hasSSSE3() {
        return Op;
    }
    if LHS.getOpcode() != EXTRACT_VECTOR_ELT || RHS.getOpcode() != EXTRACT_VECTOR_ELT || LHS.getOperand(0) != RHS.getOperand(0) || !isa(LHS.getOperand(1)) || !isa(RHS.getOperand(1)) || !shouldUseHorizontalOp(true, DAG, Subtarget) {
        return Op;
    }
    let mut HOpcode: u32 = 0;
    match Op.getOpcode() {
        ADD => {
            
        },
        SUB => {
            
        },
        FADD => {
            
        },
        FSUB => {
            
        },
        _ => {
            llvm_unreachable_internal("Trying to lower unsupported opcode to horizontal op", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 23136);
        },
    }
    let mut LExtIndex: u32 = LHS.getConstantOperandVal(1);
    let mut RExtIndex: u32 = RHS.getConstantOperandVal(1);
    if  {
        swap(LExtIndex, RExtIndex);
    }
    if (LExtIndex & 1) != 0 || RExtIndex != (LExtIndex + 1) {
        return Op;
    }
    let mut X: SDValue = LHS.getOperand(0);
    let mut VecVT: EVT = X.getValueType();
    let mut BitWidth: u32 = VecVT.getSizeInBits().operator unsigned long long();
    let mut NumLanes: u32 = BitWidth / 128;
    let mut NumEltsPerLane: u32 = VecVT.getVectorNumElements() / NumLanes;
    assert!((BitWidth == 128 || BitWidth == 256 || BitWidth == 512), "Not expecting illegal vector widths here");
    if BitWidth == 256 || BitWidth == 512 {
        let mut LaneIdx: u32 = LExtIndex / NumEltsPerLane;
        X = extract128BitVector(X, LaneIdx * NumEltsPerLane, DAG, DL);
        LExtIndex %= NumEltsPerLane;
    }
    let mut HOp: SDValue = DAG.getNode(HOpcode, DL, X.getValueType(), X, X);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { Op.getSimpleValueType() }, HOp, DAG.getVectorIdxConstant(LExtIndex / 2, DL, false));
}

fn X86TargetLowering::lowerFaddFsub(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Op.getValueType() == EVT { f32 } || Op.getValueType() == EVT { f64 }), "Only expecting float/double");
    return lowerAddSubToHorizontalOp(Op, SDLoc { Op }, DAG, self.Subtarget);
}

fn LowerFROUND(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut N0: SDValue = Op.getOperand(0);
    let mut dl: SDLoc = SDLoc { Op };
    let mut VT: MVT = Op.getSimpleValueType();
    let mut Sem: *fltSemantics = VT.getFltSemantics();
    let mut Ignored: bool = false;
    let mut Point5Pred: APFloat = APFloat { U: 0.5 };
    Point5Pred.convert(Sem, rmNearestTiesToEven, &mut Ignored);
    Point5Pred.next(true);
    let mut Adder: SDValue = DAG.getNode(FCOPYSIGN, dl, EVT { VT }, DAG.getConstantFP(Point5Pred, dl, EVT { VT }, false), N0);
    N0 = DAG.getNode(FADD, dl, EVT { VT }, N0, Adder);
    return DAG.getNode(FTRUNC, dl, EVT { VT }, N0);
}

fn LowerFABSorFNEG(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Op.getOpcode() == FABS || Op.getOpcode() == FNEG), "Wrong opcode for lowering FABS or FNEG.");
    let mut IsFABS: bool = (Op.getOpcode() == FABS);
    if IsFABS {
        for User in operator(Op).users() {
            if User.getOpcode() == FNEG {
                return Op;
            }
        }
    }
    let mut dl: SDLoc = SDLoc { Op };
    let mut VT: MVT = Op.getSimpleValueType();
    let mut IsF128: bool = (VT == f128);
    (((operator!(operator!((VT.isFloatingPoint() && VT != f80 && DAG.getTargetLoweringInfo().isTypeLegal && "Unexpected type in LowerFABSorFNEG")))) || (_wassert(L"VT.isFloatingPoint() && VT != MVT::f80 && DAG.getTargetLoweringInfo().isTypeLegal(VT) && \"Unexpected type in LowerFABSorFNEG\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (23226) as u32) , 0)) as void);
    let mut IsFakeVector: bool = !VT.isVector() && !IsF128;
    let mut LogicVT: MVT = VT;
    if IsFakeVector {
        LogicVT = MVT { SimpleTy: if (VT == f64) { v2f64 } else { if (VT == f32) { v4f32 } else { v8f16 } } };
    }
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    let mut MaskElt: APInt = if IsFABS { getSignedMaxValue(EltBits) } else { getSignMask(EltBits) };
    let mut Sem: *fltSemantics = VT.getFltSemantics();
    let mut Mask: SDValue = DAG.getConstantFP(APFloat { Sem, MaskElt }, dl, EVT { LogicVT }, false);
    let mut Op0: SDValue = Op.getOperand(0);
    let mut IsFNABS: bool = !IsFABS && (Op0.getOpcode() == FABS);
    let mut LogicOp: u32 = 0;
    let mut Operand: SDValue = if IsFNABS { Op0.getOperand(0) } else { Op0 };
    if VT.isVector() || IsF128 {
        return DAG.getNode(LogicOp, dl, EVT { LogicVT }, Operand, Mask);
    }
    Operand = DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { LogicVT }, Operand);
    let mut LogicNode: SDValue = DAG.getNode(LogicOp, dl, EVT { LogicVT }, Operand, Mask);
    return DAG.getNode(EXTRACT_VECTOR_ELT, dl, EVT { VT }, LogicNode, DAG.getVectorIdxConstant(0, dl, false));
}

fn LowerFCOPYSIGN(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Mag: SDValue = Op.getOperand(0);
    let mut Sign: SDValue = Op.getOperand(1);
    let mut dl: SDLoc = SDLoc { Op };
    let mut VT: MVT = Op.getSimpleValueType();
    if Sign.getSimpleValueType().bitsLT(VT) {
        Sign = DAG.getNode(FP_EXTEND, dl, EVT { VT }, Sign);
    }
    if Sign.getSimpleValueType().bitsGT(VT) {
        Sign = DAG.getNode(FP_ROUND, dl, EVT { VT }, Sign, DAG.getIntPtrConstant(0, dl, true));
    }
    let mut IsF128: bool = (VT == f128);
    (((operator!(operator!((VT.isFloatingPoint() && VT != f80 && DAG.getTargetLoweringInfo().isTypeLegal && "Unexpected type in LowerFCOPYSIGN")))) || (_wassert(L"VT.isFloatingPoint() && VT != MVT::f80 && DAG.getTargetLoweringInfo().isTypeLegal(VT) && \"Unexpected type in LowerFCOPYSIGN\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (23288) as u32) , 0)) as void);
    let mut Sem: *fltSemantics = VT.getFltSemantics();
    let mut IsFakeVector: bool = !VT.isVector() && !IsF128;
    let mut LogicVT: MVT = VT;
    if IsFakeVector {
        LogicVT = MVT { SimpleTy: if (VT == f64) { v2f64 } else { if (VT == f32) { v4f32 } else { v8f16 } } };
    }
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut SignMask: SDValue = DAG.getConstantFP(APFloat { Sem, getSignMask(EltSizeInBits) }, dl, EVT { LogicVT }, false);
    let mut MagMask: SDValue = DAG.getConstantFP(APFloat { Sem, getSignedMaxValue(EltSizeInBits) }, dl, EVT { LogicVT }, false);
    if IsFakeVector {
        Sign = DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { LogicVT }, Sign);
    }
    let mut SignBit: SDValue = DAG;
    let mut MagBits: SDValue = SDValue {};
    if isConstOrConstSplatFP(Mag, false) {
        Op0CN;
    } else {
        let mut APF: APFloat = Op0CN.getValueAPF();
        APF.clearSign();
        MagBits = DAG.getConstantFP(APF, dl, EVT { LogicVT }, false);
    }
    let mut Or: SDValue = DAG;
    return if !IsFakeVector { Or } else { DAG.getNode(EXTRACT_VECTOR_ELT, dl, EVT { VT }, Or, DAG.getVectorIdxConstant(0, dl, false)) };
}

fn LowerFGETSIGN(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut N0: SDValue = Op.getOperand(0);
    let mut dl: SDLoc = SDLoc { Op };
    let mut VT: MVT = Op.getSimpleValueType();
    let mut OpVT: MVT = N0.getSimpleValueType();
    assert!((OpVT == f32 || OpVT == f64), "Unexpected type for FGETSIGN");
    let mut VecVT: MVT = MVT { SimpleTy: (if OpVT == f32 { v4f32 } else { v2f64 }) };
    let mut Res: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { VecVT }, N0);
    Res = DAG;
    Res = DAG.getZExtOrTrunc(Res, dl, EVT { VT });
    Res = DAG.getNode(AND, dl, EVT { VT }, Res, DAG.getConstant(1, dl, EVT { VT }, false, false));
    return Res;
}

fn getBT(Src: SDValue, BitNo: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if Src.getValueType().getScalarSizeInBits() < 32 {
        Src = DAG.getNode(ANY_EXTEND, DL, EVT { i32 }, Src);
    }
    if operator!(DAG.getTargetLoweringInfo().isTypeLegal) {
        return SDValue {};
    }
    if Src.getValueType() == EVT { i64 } && DAG.MaskedValueIsZero(BitNo, APInt { BitNo.getValueSizeInBits().operator unsigned long long(), 32, false, false }, 0) {
        Src = DAG.getNode(TRUNCATE, DL, EVT { i32 }, Src);
    }
    if Src.getValueType() != BitNo.getValueType() {
        if BitNo.getOpcode() == AND && operator(BitNo).hasOneUse() {
            BitNo = DAG.getNode(AND, DL, Src.getValueType(), DAG.getAnyExtOrTrunc(BitNo.getOperand(0), DL, Src.getValueType()), DAG.getAnyExtOrTrunc(BitNo.getOperand(1), DL, Src.getValueType()));
        } else {
            BitNo = DAG.getAnyExtOrTrunc(BitNo, DL, Src.getValueType());
        }
    }
    return DAG;
}

fn getSETCC(Cond: CondCode, EFLAGS: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    return DAG;
}

fn isOrXorXorTree(X: SDValue, Root: bool) -> bool {
    if X.getOpcode() == OR {
        return isOrXorXorTree(X.getOperand(0), false) && isOrXorXorTree(X.getOperand(1), false);
    }
    if Root {
        return false;
    }
    return X.getOpcode() == XOR;
}

