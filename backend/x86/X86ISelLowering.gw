unsafe fn Closure_21::call(self: *mut Closure_21, Base: *mut LoadSDNode, EltIdx: i32) -> bool {
        let mut Ld: *mut LoadSDNode = (*self.Loads)[EltIdx];
        let mut ByteOffset: i64 = (*self.ByteOffsets)[EltIdx];
        if ByteOffset && (ByteOffset % (*self.BaseSizeInBytes)) == 0 {
            let mut BaseIdx: i64 = EltIdx - (ByteOffset / (*self.BaseSizeInBytes));
            return (0 <= BaseIdx && BaseIdx < (*self.NumElems) as i32 && (*self.LoadMask)[BaseIdx] && (*self.Loads)[BaseIdx] == Ld && (*self.ByteOffsets)[BaseIdx] == 0);
        }
        let mut Stride: i32 = EltIdx - (*self.FirstLoadedElt);
        if (*self.DAG).areNonVolatileConsecutiveLoads(Ld, Base, (*self.BaseSizeInBytes), Stride) {
            return true;
        }
        let mut BaseMemSizeInBits: u32 = Base.getMemoryVT().getSizeInBits().operator unsigned long long();
        if ((Stride * (*self.BaseSizeInBits)) % BaseMemSizeInBits) == 0 && (BaseMemSizeInBits % (*self.BaseSizeInBits)) == 0 {
            let mut Scale: u32 = BaseMemSizeInBits / (*self.BaseSizeInBits);
            return (*self.DAG).areNonVolatileConsecutiveLoads(Ld, Base, BaseMemSizeInBits / 8, Stride / Scale);
        }
        return false;
    }

