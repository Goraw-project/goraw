        if ShiftAmt >= 32 {
            let mut Upper: SDValue = getTargetVShiftByConstNode(VSRAI, (*self.dl), ExVT, Ex, 31, (*self.DAG));
            let mut Lower: SDValue = getTargetVShiftByConstNode(VSRAI, (*self.dl), ExVT, Ex, ShiftAmt - 32, (*self.DAG));
            if (*self.VT) == v2i64 {
                Ex = (*self.DAG).getVectorShuffle(ExVT, (*self.dl), Upper, Lower, [5, 1, 7, 3]);
            }
            if (*self.VT) == v4i64 {
                Ex = (*self.DAG).getVectorShuffle(ExVT, (*self.dl), Upper, Lower, [9, 1, 11, 3, 13, 5, 15, 7]);
            }
        } else {
            let mut Upper: SDValue = getTargetVShiftByConstNode(VSRAI, (*self.dl), ExVT, Ex, ShiftAmt, (*self.DAG));
            let mut Lower: SDValue = getTargetVShiftByConstNode(VSRLI, (*self.dl), (*self.VT), (*self.R), ShiftAmt, (*self.DAG));
            Lower = (*self.DAG).getBitcast(ExVT, Lower);
            if (*self.VT) == v2i64 {
                Ex = (*self.DAG).getVectorShuffle(ExVT, (*self.dl), Upper, Lower, [4, 1, 6, 3]);
            }
            if (*self.VT) == v4i64 {
                Ex = (*self.DAG).getVectorShuffle(ExVT, (*self.dl), Upper, Lower, [8, 1, 10, 3, 12, 5, 14, 7]);
            }
        }
        return (*self.DAG).getBitcast((*self.VT), Ex);
