        (((operator!(operator!((operator!(self.Subtarget()) && !(MF.getFunction().hasFnAttribute(NoImplicitFloat)) && self.Subtarget.hasSSE1())))) || (_wassert(L"!Subtarget.useSoftFloat() && !(MF.getFunction().hasFnAttribute(Attribute::NoImplicitFloat)) && Subtarget.hasSSE1()", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (26918) as u32) , 0)) as void);
    }
    let mut InstOps: [5]SDValue = [Chain, SrcPtr, DAG.getTargetConstant(ArgSize, dl, EVT { i32 }, false), DAG.getTargetConstant(ArgMode, dl, EVT { i8 }, false), DAG.getTargetConstant(Align, dl, EVT { i32 }, false)];
    let mut VTs: SDVTList = DAG.getVTList(SrcPtr.getValueType(), EVT { Other });
    let mut VAARG: SDValue = DAG;
    Chain = VAARG.getValue(1);
    return DAG.getLoad(ArgVT, dl, Chain, VAARG, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
}

fn LowerVACOPY(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    (((operator!(operator!((Subtarget()() && "This code only handles 64-bit va_copy!")))) || (_wassert(L"Subtarget.is64Bit() && \"This code only handles 64-bit va_copy!\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (26943) as u32) , 0)) as void);
    if Subtarget.isCallingConvWin64(DAG.getMachineFunction().getFunction().getCallingConv()) {
        return DAG.expandVACopy(Op.getNode());
    }
    let mut Chain: SDValue = Op.getOperand(0);
    let mut DstPtr: SDValue = Op.getOperand(1);
    let mut SrcPtr: SDValue = Op.getOperand(2);
    let mut DstSV: *Value = cast(Op.getOperand(3))();
    let mut SrcSV: *Value = cast(Op.getOperand(4))();
    let mut DL: SDLoc = SDLoc { Op };
    let mut Alignment: Align = Align { ShiftValue: if Subtarget.isTarget64BitLP64() { 8 } else { 4 } };
    return DAG.getMemcpy(Chain, DL, DstPtr, SrcPtr, DAG.getIntPtrConstant(if Subtarget.isTarget64BitLP64() { 24 } else { 16 }, DL, false), Alignment, Alignment, false, false, null, optional<bool> { nullopt }, MachinePointerInfo { DstSV, 0, 0 }, MachinePointerInfo { SrcSV, 0, 0 }, AAMDNodes {}, null);
}

fn getVectorMaskingNode(Op: SDValue, Mask: SDValue, PreservedSrc: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut MaskVT: MVT = VT.changeElementType(MVT { SimpleTy: i1 });
    let mut OpcodeSelect: u32 = VSELECT;
    let mut dl: SDLoc = SDLoc { Op };
    if isAllOnesConstant(Mask) {
        return Op;
    }
    let mut VMask: SDValue = getMaskNode(Mask, MaskVT, Subtarget, DAG, dl);
    if PreservedSrc.isUndef() {
        PreservedSrc = getZeroVector(VT, Subtarget, DAG, dl);
    }
    return DAG.getNode(OpcodeSelect, dl, EVT { VT }, VMask, Op, PreservedSrc);
}

fn getScalarMaskingNode(Op: SDValue, Mask: SDValue, PreservedSrc: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, UpperEltOpSrc: u32) -> SDValue {
    let mut MaskConst: *mut auto = dyn_cast(Mask);
    if MaskConst() && (MaskConst()() & 1) {
        return Op;
    }
    let mut VT: MVT = Op.getSimpleValueType();
    let mut dl: SDLoc = SDLoc { Op };
    assert!(Mask.getValueType() == EVT { i8 }, "Unexpect type");
    let mut IMask: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, dl, EVT { v1i1 }, DAG.getBitcast(EVT { v8i1 }, Mask), DAG.getVectorIdxConstant(0, dl, false));
    if  {
        return DAG.getNode(AND, dl, EVT { VT }, Op, IMask);
    }
    if PreservedSrc.isUndef() {
        PreservedSrc = getZeroVector(VT, Subtarget, DAG, dl);
    }
    if MaskConst() {
        (((operator!(operator!(((MaskConst()() & 1) == 0 && "Expected false mask")))) || (_wassert(L"(MaskConst->getZExtValue() & 0x1) == 0 && \"Expected false mask\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (27019) as u32) , 0)) as void);
        let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> { VT.getVectorNumElements() };
        iota(ShuffleMask.begin(), ShuffleMask.end(), 0);
        ShuffleMask[0] = VT.getVectorNumElements();
        return DAG.getVectorShuffle;
    }
    return DAG;
}

fn getSEHRegistrationNodeSize(Fn: *Function) -> i32 {
    if !Fn.hasPersonalityFn() {
        report_fatal_error("querying registration node size for function without personality", true);
    }
    match classifyEHPersonality(Fn.getPersonalityFn()) {
        MSVC_X86SEH => {
            return 24;
        },
        MSVC_CXX => {
            return 16;
        },
        _ => {
            break;
        },
    }
    report_fatal_error("can only recover FP for 32-bit MSVC EH personality functions", true);
}

fn recoverFramePointer(DAG: *mut SelectionDAG, Fn: *Function, EntryEBP: SDValue) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut dl: SDLoc = SDLoc {};
    if !Fn.hasPersonalityFn() {
        return EntryEBP;
    }
    let mut OffsetSym: *mut MCSymbol = MF.getContext().getOrCreateParentFrameOffsetSymbol(dropLLVMManglingEscape(Fn.getName()));
    let mut PtrVT: MVT = EntryEBP.getValueType().getSimpleVT();
    let mut OffsetSymVal: SDValue = DAG.getMCSymbol(OffsetSym, EVT { PtrVT });
    let mut ParentFrameOffset: SDValue = DAG.getNode(LOCAL_RECOVER, dl, EVT { PtrVT }, OffsetSymVal);
    let mut Subtarget: *X86Subtarget = DAG;
    if Subtarget()() {
        return DAG.getNode(ADD, dl, EVT { PtrVT }, EntryEBP, ParentFrameOffset);
    }
    let mut RegNodeSize: i32 = getSEHRegistrationNodeSize(Fn);
    let mut RegNodeBase: SDValue = DAG.getNode(SUB, dl, EVT { PtrVT }, EntryEBP, DAG.getConstant(RegNodeSize, dl, EVT { PtrVT }, false, false));
    return DAG.getNode(SUB, dl, EVT { PtrVT }, RegNodeBase, ParentFrameOffset);
}

fn X86TargetLowering::LowerINTRINSIC_WO_CHAIN(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut isRoundModeCurDirection: Closure_118 = Closure_118 {};
    let mut isRoundModeSAE: Closure_119 = Closure_119 {};
    let mut isRoundModeSAEToX: Closure_120 = Closure_120 {};
    let mut dl: SDLoc = SDLoc { Op };
    let mut IntNo: u32 = Op.getConstantOperandVal(0);
    let mut VT: MVT = Op.getSimpleValueType();
    let mut IntrData: *IntrinsicData = getIntrinsicWithoutChain(IntNo);
    let mut FlagsInserter: FlagInserter = FlagInserter { DAG, operator(Op).getFlags() };
    if IntrData {
        match IntrData.Type {
            INTR_TYPE_1OP => {
                let mut IntrWithRoundingModeOpcode: u32 = IntrData.Opc1;
                if IntrWithRoundingModeOpcode != 0 {
                    let mut Rnd: SDValue = Op.getOperand(2);
                    let mut RC: u32 = 0;
                    if isRoundModeSAEToX.call(Rnd, RC) {
                        return DAG.getNode(IntrWithRoundingModeOpcode, dl, Op.getValueType(), Op.getOperand(1), DAG.getTargetConstant(RC, dl, EVT { i32 }, false));
                    }
                    if operator!(isRoundModeCurDirection(Rnd)) {
                        return SDValue {};
                    }
                }
                return DAG.getNode(IntrData.Opc0, dl, Op.getValueType(), Op.getOperand(1));
            },
            INTR_TYPE_1OP_SAE => {
                let mut Sae: SDValue = Op.getOperand(2);
                let mut Opc: u32 = 0;
                if isRoundModeCurDirection(Sae) {
                    Opc = IntrData.Opc0;
                } else if isRoundModeSAE(Sae) {
                    Opc = IntrData.Opc1;
                } else {
                    return SDValue {};
                }
                return DAG.getNode(Opc, dl, Op.getValueType(), Op.getOperand(1));
            },
            INTR_TYPE_2OP => {
                let mut Src2: SDValue = Op.getOperand(2);
                let mut IntrWithRoundingModeOpcode: u32 = IntrData.Opc1;
                if IntrWithRoundingModeOpcode != 0 {
                    let mut Rnd: SDValue = Op.getOperand(3);
                    let mut RC: u32 = 0;
                    if isRoundModeSAEToX.call(Rnd, RC) {
                        return DAG.getNode(IntrWithRoundingModeOpcode, dl, Op.getValueType(), Op.getOperand(1), Src2, DAG.getTargetConstant(RC, dl, EVT { i32 }, false));
                    }
                    if operator!(isRoundModeCurDirection(Rnd)) {
                        return SDValue {};
                    }
                }
                return DAG.getNode(IntrData.Opc0, dl, Op.getValueType(), Op.getOperand(1), Src2);
            },
            INTR_TYPE_2OP_SAE => {
                let mut Sae: SDValue = Op.getOperand(3);
                let mut Opc: u32 = 0;
                if isRoundModeCurDirection(Sae) {
                    Opc = IntrData.Opc0;
                } else if isRoundModeSAE(Sae) {
                    Opc = IntrData.Opc1;
                } else {
                    return SDValue {};
                }
                return DAG.getNode(Opc, dl, Op.getValueType(), Op.getOperand(1), Op.getOperand(2));
            },
            INTR_TYPE_3OP => {
                INTR_TYPE_3OP_IMM8;
            },
            INTR_TYPE_4OP_IMM8 => {
                assert!(operator(Op.getOperand(4)).getOpcode() == TargetConstant);
                let mut Src4: SDValue = Op.getOperand(4);
                if Src4.getValueType() != EVT { i8 } {
                    Src4 = DAG.getTargetConstant(operator(Src4).getAsZExtVal() & 255, dl, EVT { i8 }, false);
                }
                return DAG.getNode(IntrData.Opc0, dl, Op.getValueType(), Op.getOperand(1), Op.getOperand(2), Op.getOperand(3), Src4);
            },
            INTR_TYPE_1OP_MASK => {
                let mut Src: SDValue = Op.getOperand(1);
                let mut PassThru: SDValue = Op.getOperand(2);
                let mut Mask: SDValue = Op.getOperand(3);
                let mut IntrWithRoundingModeOpcode: u32 = IntrData.Opc1;
                if IntrWithRoundingModeOpcode != 0 {
                    let mut Rnd: SDValue = Op.getOperand(4);
                    let mut RC: u32 = 0;
                    if isRoundModeSAEToX.call(Rnd, RC) {
                        return getVectorMaskingNode(DAG.getNode(IntrWithRoundingModeOpcode, dl, Op.getValueType(), Src, DAG.getTargetConstant(RC, dl, EVT { i32 }, false)), Mask, PassThru, self.Subtarget, DAG);
                    }
                    if operator!(isRoundModeCurDirection(Rnd)) {
                        return SDValue {};
                    }
                }
