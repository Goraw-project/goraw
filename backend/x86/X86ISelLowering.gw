        assert!(LDBase.isSimple(), "Cannot merge volatile or atomic loads.");
        let mut NewLd: SDValue = (*self.DAG).getLoad(VT, (*self.DL), LDBase.getChain(), LDBase.getBasePtr(), LDBase.getPointerInfo(), LDBase.getBaseAlign(), MMOFlags, MMOMetadata {});
        for LD in (*self.Loads) {
            if LD {
                (*self.DAG).makeEquivalentMemoryOrdering(LD, NewLd);
            }
        }
        return NewLd;
    }

struct Closure_23 {
