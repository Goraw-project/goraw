    if self.Subtarget.isCallingConvWin64(MF.getFunction().getCallingConv()) {
        return DAG.expandVAArg(Op.getNode());
    }
    let mut Chain: SDValue = Op.getOperand(0);
    let mut SrcPtr: SDValue = Op.getOperand(1);
    let mut SV: *Value = cast(Op.getOperand(2))();
    let mut Align: u32 = Op.getConstantOperandVal(3);
    let mut dl: SDLoc = SDLoc { Op };
    let mut ArgVT: EVT = Op.getNode().getValueType(0);
    let mut ArgTy: *mut Type = ArgVT.getTypeForEVT(*DAG.getContext());
    let mut ArgSize: u32 = DAG.getDataLayout().getTypeAllocSize(ArgTy).operator unsigned long long();
    let mut ArgMode: u8 = 0;
    assert!(ArgVT != EVT { f80 }, "va_arg for f80 not yet implemented");
    if ArgVT.isFloatingPoint() && ArgSize <= 16 {
        ArgMode = 2;
    } else {
        assert!(ArgVT.isInteger() && ArgSize <= 32, "Unhandled argument type in LowerVAARG");
        ArgMode = 1;
    }
