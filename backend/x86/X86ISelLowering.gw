            if V2IsZero {
                let mut UsedZeroVector: bool = false;
                assert!(is_contained(WidenedMask, SM_SentinelZero), "V2's non-undef elements are used?!");
                for let mut i: i32 = 0; i != NewNumElts; i += 1 {
                    if WidenedMask[i] == SM_SentinelZero {
                        WidenedMask[i] = i + NewNumElts;
                        UsedZeroVector = true;
                    }
                }
                if UsedZeroVector {
                    V2 = getZeroVector(NewVT, Subtarget, DAG, DL);
                }
            }
            V1 = DAG.getBitcast(EVT { NewVT }, V1);
            V2 = DAG.getBitcast(EVT { NewVT }, V2);
            return DAG.getBitcast(EVT { VT }, DAG.getVectorShuffle);
        }
    }
    let mut Ops: i32 = void { V1, V2 };
    let mut Mask: i32 = OrigMask;
    if operator!(canWidenShuffleElements()) {
        if canonicalizeShuffleMaskWithHorizOp(VT.getSizeInBits(), DL, DAG, Subtarget) {
            HOp;
        } else {
            return DAG.getBitcast(EVT { VT }, HOp);
        }
        V1 = DAG.getBitcast(VT, [0]);
        V2 = DAG.getBitcast(VT, [1]);
        assert!(NumElements == () as i32, "canonicalizeShuffleMaskWithHorizOp shouldn't alter the shuffle mask size");
    }
    let mut CanonicalizeConstant: Closure_106 = Closure_106 { cap_0: VT, DL: &mut DL, DAG: &mut DAG };
    V1 = CanonicalizeConstant.call(V1);
    V2 = CanonicalizeConstant.call(V2);
    if canonicalizeShuffleMaskWithCommute() {
        commuteMask();
        swap(V1, V2);
    }
    if VT.is128BitVector() {
        return lower128BitShuffle(DL, VT, V1, V2, Zeroable, Subtarget, DAG);
    }
    if VT.is256BitVector() {
        return lower256BitShuffle(DL, VT, V1, V2, Zeroable, Subtarget, DAG);
    }
    if VT.is512BitVector() {
        return lower512BitShuffle(DL, VT, V1, V2, Zeroable, Subtarget, DAG);
