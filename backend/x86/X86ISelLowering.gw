struct Closure_253 {
    IsOpConstant: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86ISelLowering.cpp:61268:25),
    DAG: *mut SelectionDAG,
}

unsafe fn Closure_253::call(self: *mut Closure_253, VT: MVT, SubOps: ArrayRef<SDValue>, Op: u32) -> bool {
            let mut AllConstants: bool = true;
            let mut AllSubs: bool = true;
            let mut VecSize: u32 = VT.getSizeInBits().operator unsigned long long();
            let mut SubOp0: SDValue = SubOps[0].getOperand(Op);
            if all_of(SubOps, Closure_254 { SubOp0: &mut SubOp0, Op: &mut Op }) {
                let mut Src: SDValue = SubOp0;
                while Src.getOpcode() == BITCAST || Src.getOpcode() == EXTRACT_SUBVECTOR {
                    Src = Src.getOperand(0);
                }
                if isNormalLoad(Src.getNode()) || Src.getOpcode() == VBROADCAST_LOAD || Src.getOpcode() == SUBV_BROADCAST_LOAD {
                    return true;
                }
            }
            let mut Subs: SmallVector<SDValue> = SmallVector<SDValue> {};
            for let mut I: u32 = 0;
let mut E: u32 = SubOps.len; I != E; I += 1 {
                Subs.push(SubOps[I].getOperand(Op));
                let mut BC: SDValue = peekThroughBitcasts(SubOps[I].getOperand(Op));
                let mut SubSize: u32 = BC.getValueSizeInBits().operator unsigned long long();
                let mut EltSize: u32 = BC.getScalarValueSizeInBits();
                AllConstants &= (*self.IsOpConstant).call(BC);
                AllSubs &= BC.getOpcode() == EXTRACT_SUBVECTOR && BC.getOperand(0).getValueSizeInBits().operator unsigned long long() == VecSize && (BC.getConstantOperandVal(1) * EltSize) == (I * SubSize);
            }
            return AllConstants || AllSubs || (*self.DAG).doesNodeExist(CONCAT_VECTORS, (*self.DAG).getVTList(VT), Subs);
        }

struct Closure_255 {
    IsOpConstant: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86ISelLowering.cpp:61268:25),
    DAG: *mut SelectionDAG,
    DL: *mut SDLoc,
    Subtarget: *mut X86Subtarget,
    Depth: *mut u32,
}

unsafe fn Closure_255::call(self: *mut Closure_255, VT: MVT, SubOps: ArrayRef<SDValue>, I: u32) -> SDValue {
            let mut AllConstants: bool = true;
            let mut Subs: SmallVector<SDValue> = SmallVector<SDValue> {};
            for SubOp in SubOps {
                AllConstants &= (*self.IsOpConstant).call(peekThroughBitcasts(SubOp.getOperand(I)));
                Subs.push(SubOp.getOperand(I));
            }
            if AllConstants || (*self.DAG).doesNodeExist(CONCAT_VECTORS, (*self.DAG).getVTList(VT), Subs) {
                return (*self.DAG).getNode(CONCAT_VECTORS, (*self.DL), VT, Subs);
            }
            return combineConcatVectorOps((*self.DL), VT, Subs, (*self.DAG), (*self.Subtarget), (*self.Depth) + 1);
        }

