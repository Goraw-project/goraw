            IsROTL = true;
        }
        let mut BuildRotate: Closure_127 = Closure_127 { DAG: &mut DAG, IsROTL: &mut IsROTL, DL: &mut DL, VT: &mut VT };
        Amt = DAG.getBitcast(EVT { ExtVT }, Amt);
        Amt = DAG.getNode(SHL, DL, EVT { ExtVT }, Amt, DAG.getConstant(5, DL, EVT { ExtVT }, false, false));
        Amt = DAG.getBitcast(EVT { VT }, Amt);
