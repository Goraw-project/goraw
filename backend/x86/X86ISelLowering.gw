fn matchSignedNewValueCC(I: *Instruction) -> CondCode {
    if match(I.user_back(), m_SpecificICmp(ICMP_SLT, m_Value())) {
        return COND_S;
    }
    if match(I.user_back(), m_SpecificICmp(ICMP_SGT, m_Value())) {
        return COND_NS;
    }
    return COND_INVALID;
}

fn matchAddCC(AI: *AtomicRMWInst, I: *Instruction) -> CondCode {
    let mut Op: *mut Value = AI.getOperand(1);
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(I, m_c_ICmp(Pred, m_Neg(m_Specific(Op)), m_Value())) {
        if Pred == ICMP_EQ {
            return COND_E;
        }
        if Pred == ICMP_NE {
            return COND_NE;
        }
    }
    if match(I, m_OneUse(m_c_Add(m_Specific(Op), m_Value()))) {
        return matchSignedNewValueCC(I);
    }
    return COND_INVALID;
}

fn matchSubCC(AI: *AtomicRMWInst, I: *Instruction) -> CondCode {
    let mut Op: *mut Value = AI.getOperand(1);
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(I, m_c_ICmp(Pred, m_Specific(Op), m_Value())) {
        if Pred == ICMP_EQ {
            return COND_E;
        }
        if Pred == ICMP_NE {
            return COND_NE;
        }
    }
    if match(I, m_OneUse(m_Sub(m_Value(), m_Specific(Op)))) {
        return matchSignedNewValueCC(I);
    }
    return COND_INVALID;
}

fn matchOrCC(AI: *AtomicRMWInst, I: *Instruction) -> CondCode {
    let mut Op: *mut Value = AI.getOperand(1);
    let mut Pred: CmpPredicate = CmpPredicate {};
    if operator!(match(I, m_OneUse(m_c_Or(m_Specific(Op), m_Value())))) {
        return COND_INVALID;
    }
    if match(I.user_back(), m_ICmp(Pred, m_Value())) {
        if Pred == ICMP_EQ {
            return COND_E;
        }
        if Pred == ICMP_NE {
            return COND_NE;
        }
        if Pred == ICMP_SLT {
            return COND_S;
        }
    }
    if match(I.user_back(), m_SpecificICmp(ICMP_SGT, m_Value())) {
        return COND_NS;
    }
    return COND_INVALID;
}

fn matchAndCC(AI: *AtomicRMWInst, I: *Instruction) -> CondCode {
    let mut Op: *mut Value = AI.getOperand(1);
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(I, m_OneUse(m_c_And(m_Specific(Op), m_Value()))) {
        if match(I.user_back(), m_ICmp(Pred, m_Value())) {
            if Pred == ICMP_EQ {
                return COND_E;
            }
            if Pred == ICMP_NE {
                return COND_NE;
            }
            if Pred == ICMP_SLT {
                return COND_S;
            }
        }
        if match(I.user_back(), m_SpecificICmp(ICMP_SGT, m_Value())) {
            return COND_NS;
        }
        return COND_INVALID;
    }
    let mut CI: *mut auto = dyn_cast(Op);
    if operator!() {
        return COND_INVALID;
    }
    let mut C: *APInt = ();
    let mut K: *APInt = null;
    if !(operator(C)).isPowerOf2() || operator!(match(I, m_c_ICmp(Pred, m_Specific(AI)))) {
        return COND_INVALID;
    }
    if Pred == ICMP_ULT && *K == operator(C) {
        return COND_E;
    }
    if Pred == ICMP_UGT && *K == operator(C) {
        return COND_NE;
    }
    return COND_INVALID;
}

fn matchXorCC(AI: *AtomicRMWInst, I: *Instruction) -> CondCode {
    let mut Op: *mut Value = AI.getOperand(1);
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(I, m_c_ICmp(Pred, m_Specific(Op), m_Value())) {
        if Pred == ICMP_EQ {
            return COND_E;
        }
        if Pred == ICMP_NE {
            return COND_NE;
        }
    }
    if match(I, m_OneUse(m_c_Xor(m_Specific(Op), m_Value()))) {
        return matchSignedNewValueCC(I);
    }
    return COND_INVALID;
}

fn getCmpArithCC(AI: *AtomicRMWInst) -> CondCode {
    if !AI.hasOneUse() {
        return COND_INVALID;
    }
    let mut I: *Instruction = AI.user_back();
    match AI.getOperation() {
        Add => {
            return matchAddCC(AI, I);
        },
        Sub => {
            return matchSubCC(AI, I);
        },
        Or => {
            return matchOrCC(AI, I);
        },
        And => {
            return matchAndCC(AI, I);
        },
        Xor => {
            return matchXorCC(AI, I);
        },
        _ => {
            return COND_INVALID;
        },
    }
}

fn shouldExpandCmpArithRMWInIR(AI: *AtomicRMWInst) -> bool {
    return getCmpArithCC(AI) != COND_INVALID;
}

