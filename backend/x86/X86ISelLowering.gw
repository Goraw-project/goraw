    let mut V2: SDValue = [1];
    if (V1.getOpcode() != FADD && V1.getOpcode() != FSUB) || (V2.getOpcode() != FADD && V2.getOpcode() != FSUB) || V1.getOpcode() == V2.getOpcode() {
