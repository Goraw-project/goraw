struct Closure_106 {
    cap_0: MVT,
    DL: *mut SDLoc,
    DAG: *mut SelectionDAG,
}

unsafe fn Closure_106::call(self: *mut Closure_106, V: SDValue) -> SDValue {
        if dyn_cast(V) {
            BV;
        } else {
            let mut Undefs: BitVector = BitVector {};
            if BV.getSplatValue(&mut Undefs) {
                Splat;
            } else {
                if Undefs.any() && (isNullConstant(Splat) || isAllOnesConstant(Splat) || isa(Splat)) {
                    V = (*self.DAG).getBitcast(VT, (*self.DAG).getSplat(BV.getValueType(0), (*self.DL), Splat));
                }
            }
        }
        return V;
    }

struct Closure_107 {
    CastVT: *mut EVT,
    OpSize: *mut u32,
    NeedsAVX512FCast: *mut bool,
    DAG: *mut SelectionDAG,
    NeedZExt: *mut bool,
    DL: *mut SDLoc,
    VecVT: *mut EVT,
}

unsafe fn Closure_107::call(self: *mut Closure_107, X: SDValue) -> auto {
            let mut TmpZext: bool = false;
            let mut TmpCastVT: EVT = (*self.CastVT);
            if X.getOpcode() == ZERO_EXTEND {
                let mut OrigX: SDValue = X.getOperand(0);
                let mut OrigSize: u32 = OrigX.getScalarValueSizeInBits();
                if OrigSize < (*self.OpSize) {
                    if OrigSize == 128 {
                        TmpCastVT = if (*self.NeedsAVX512FCast) { v4i32 } else { v16i8 };
                        X = OrigX;
                        TmpZext = true;
                    } else if OrigSize == 256 {
                        TmpCastVT = if (*self.NeedsAVX512FCast) { v8i32 } else { v32i8 };
                        X = OrigX;
                        TmpZext = true;
                    }
                }
            }
            X = (*self.DAG).getBitcast(TmpCastVT, X);
            if !(*self.NeedZExt) && !TmpZext {
                return X;
            }
            return (*self.DAG).getNode(INSERT_SUBVECTOR, (*self.DL), (*self.VecVT), (*self.DAG).getConstant(0, (*self.DL), (*self.VecVT), false, false), X, (*self.DAG).getVectorIdxConstant(0, (*self.DL), false));
        }

struct Closure_108 {
    Mask: *mut APInt,
    DAG: *mut SelectionDAG,
    DL: *mut SDLoc,
}

unsafe fn Closure_108::call(self: *mut Closure_108, Src: SDValue) -> SDValue {
        if (*self.Mask).isAllOnes() {
            return Src;
        }
        let mut SrcVT: EVT = Src.getValueType();
        let mut MaskValue: SDValue = (*self.DAG).getConstant((*self.Mask), (*self.DL), SrcVT, false, false);
        return (*self.DAG).getNode(AND, (*self.DL), SrcVT, Src, MaskValue);
    }

