                    UndefElts.setBit(i);
                }
                EltBits()([M]);
            } else {
                if UndefElts1[M - NumElts] {
                    UndefElts.setBit(i);
                }
                EltBits()([M - NumElts]);
            }
        }
        return true;
    }
    return false;
}

fn isConstantSplat(Op: SDValue, SplatVal: *mut APInt, AllowPartialUndefs: bool) -> bool {
    let mut UndefElts: APInt = APInt {};
    let mut EltBits: SmallVector<APInt, 16> = zeroed();
    if getTargetConstantBitsFromNode(Op, Op.getScalarValueSizeInBits(), UndefElts, true, AllowPartialUndefs) {
        let mut SplatIndex: i32 = -1;
        for let mut i: i32 = 0;
let mut e: i32 = (); i != e; i += 1 {
            if UndefElts[i] {
                continue;
            }
            if 0 <= SplatIndex && [i] != [SplatIndex] {
