    }
    if Op.getOpcode() == INSERT_SUBVECTOR {
        let mut SrcEltSizeInBits: u32 = VT.getScalarSizeInBits();
        let mut AllowUndefs: bool = EltSizeInBits >= SrcEltSizeInBits;
        let mut UndefSrcElts: APInt = APInt {};
        let mut UndefSubElts: APInt = APInt {};
        let mut EltSrcBits: SmallVector<APInt, 32> = zeroed();
        let mut EltSubBits: SmallVector<APInt, 32> = zeroed();
        if getTargetConstantBitsFromNode(Op.getOperand(1), SrcEltSizeInBits, UndefSubElts, AllowWholeUndefs && AllowUndefs, AllowPartialUndefs && AllowUndefs) && getTargetConstantBitsFromNode(Op.getOperand(0), SrcEltSizeInBits, UndefSrcElts, AllowWholeUndefs && AllowUndefs, AllowPartialUndefs && AllowUndefs) {
