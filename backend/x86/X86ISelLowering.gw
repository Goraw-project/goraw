        Amt = DAG.getNode(ADD, DL, EVT { VT }, Amt, Amt);
        R = SignBitSelect(VT, Amt, BuildRotate.call(R, 2), R);
        Amt = DAG.getNode(ADD, DL, EVT { VT }, Amt, Amt);
        return SignBitSelect(VT, Amt, BuildRotate.call(R, 1), R);
    }
    let mut IsSplatAmt: bool = DAG.isSplatValue(Amt, false);
    let mut LegalVarShifts: bool = supportedVectorVarShift(EVT { VT }, Subtarget, SHL) && supportedVectorVarShift(EVT { VT }, Subtarget, SRL);
    if IsSplatAmt || LegalVarShifts || (Subtarget.hasAVX2() && !ConstantAmt) {
