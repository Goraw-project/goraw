struct Closure_272 {}

fn Closure_272::call(self: *Closure_272, V: SDValue) -> bool {
            V = peekThroughBitcasts(V);
            if !isBitwiseNot(V, false) {
                return false;
            }
            let mut NotOp: SDValue = operator(V).getOperand(0);
            return peekThroughBitcasts(NotOp).getOpcode() == CONCAT_VECTORS;
        }

