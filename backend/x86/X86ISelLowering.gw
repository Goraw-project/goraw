fn combineCarryThroughADD(EFLAGS: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if  {
        if isAllOnesConstant(EFLAGS.getOperand(1)) {
            let mut FoundAndLSB: bool = false;
            let mut Carry: SDValue = EFLAGS.getOperand(0);
            while Carry.getOpcode() == TRUNCATE || Carry.getOpcode() == ZERO_EXTEND || (Carry.getOpcode() == AND && isOneConstant(Carry.getOperand(1))) {
                FoundAndLSB |= Carry.getOpcode() == AND;
                Carry = Carry.getOperand(0);
            }
            if  {
                let mut CarryCC: u64 = Carry.getConstantOperandVal(0);
                let mut CarryOp1: SDValue = Carry.getOperand(1);
                if CarryCC == COND_B {
                    return CarryOp1;
                }
                if CarryCC == COND_A {
                    if  {
                        let mut SubCommute: SDValue = DAG;
                        return SDValue { Node: SubCommute.getNode(), ResNo: CarryOp1.getResNo() };
                    }
                }
                if  {
                    return CarryOp1;
                }
            } else if FoundAndLSB {
                let mut DL: SDLoc = SDLoc { Carry };
                let mut BitNo: SDValue = DAG.getConstant(0, DL, Carry.getValueType(), false, false);
                if Carry.getOpcode() == SRL {
                    BitNo = Carry.getOperand(1);
                    Carry = Carry.getOperand(0);
                }
                return getBT(Carry, BitNo, DL, DAG);
            }
        }
    }
    return SDValue {};
}

fn combinePTESTCC(EFLAGS: SDValue, CC: *mut CondCode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
