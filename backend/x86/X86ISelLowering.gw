unsafe fn Closure_117::call(self: *mut Closure_117, CC: SDValue, EFLAGS: SDValue) -> SDValue {
        if (*self.Op).getOpcode() == BRCOND {
            return (*self.DAG).getNode(BRCOND, (*self.dl), Other, (*self.Chain), (*self.Dest), CC, EFLAGS, operator((*self.Op)).getFlags());
        }
        return (*self.DAG).getNode(BRCOND_SELF, (*self.dl), Other, (*self.Chain), CC, EFLAGS, operator((*self.Op)).getFlags());
    }

struct Closure_118 {}

fn Closure_118::call(self: *Closure_118, Rnd: SDValue) -> bool {
        if dyn_cast(Rnd) {
            C;
        } else {
            return C.getAPIntValue() == CUR_DIRECTION;
        }
        return false;
    }

struct Closure_119 {}

fn Closure_119::call(self: *Closure_119, Rnd: SDValue) -> bool {
        if dyn_cast(Rnd) {
            C;
        } else {
            let mut RC: u32 = C.getZExtValue();
            if RC & NO_EXC {
                RC ^= NO_EXC;
                return RC == 0 || RC == CUR_DIRECTION;
            }
        }
        return false;
    }

struct Closure_120 {}

fn Closure_120::call(self: *Closure_120, Rnd: SDValue, RC: *mut u32) -> bool {
        if dyn_cast(Rnd) {
            C;
        } else {
            RC = C.getZExtValue();
            if RC & NO_EXC {
                RC ^= NO_EXC;
                return RC == TO_NEAREST_INT || RC == TO_NEG_INF || RC == TO_POS_INF || RC == TO_ZERO;
            }
        }
        return false;
    }

struct Closure_121 {}

fn Closure_121::call(self: *Closure_121, Op: SDValue, Zero: APInt) -> bool {
        Op = peekThroughBitcasts(Op);
        if dyn_cast(Op) {
            CstOp;
        } else {
            return CstOp.getValueAPF().bitcastToAPInt() == Zero;
        }
        if dyn_cast(Op) {
            CstOp;
        } else {
            return CstOp.getAPIntValue() == Zero;
        }
        if operator(Op).getOpcode() == BUILD_VECTOR || operator(Op).getOpcode() == SPLAT_VECTOR {
            for OpVal in operator(Op).op_values() {
                if OpVal.isUndef() {
                    continue;
                }
                let mut CstOp: *mut ConstantFPSDNode = dyn_cast(OpVal);
                if !CstOp {
                    return false;
                }
                if !CstOp.getValueAPF().isZero() {
                    continue;
                }
                if CstOp.getValueAPF().bitcastToAPInt() != Zero {
                    return false;
                }
            }
            return true;
        }
        return false;
    }

struct Closure_122 {
    VT: *mut MVT,
    DAG: *mut SelectionDAG,
    R: *mut SDValue,
    Subtarget: *mut X86Subtarget,
    dl: *mut SDLoc,
}

unsafe fn Closure_122::call(self: *mut Closure_122, ShiftAmt: u64) -> SDValue {
        assert!(((*self.VT) == v2i64 || (*self.VT) == v4i64), "Unexpected SRA type");
