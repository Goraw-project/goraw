fn combineVectorSizedSetCCEquality(VT: EVT, X: SDValue, Y: SDValue, CC: CondCode, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!((CC == SETNE || CC == SETEQ), "Bad comparison predicate");
    let mut OpVT: EVT = X.getValueType();
    let mut OpSize: u32 = OpVT.getSizeInBits().operator unsigned long long();
    if !OpVT.isScalarInteger() || OpSize < 128 {
        return SDValue {};
    }
    let mut NoImplicitFloatOps: bool = DAG.getMachineFunction().getFunction().hasFnAttribute(NoImplicitFloat);
    if Subtarget()() || NoImplicitFloatOps {
        return SDValue {};
    }
    let mut IsOrXorXorTreeCCZero: bool = isNullConstant(Y) && isOrXorXorTree(X, true);
    if isNullConstant(Y) && OpSize == 128 && !IsOrXorXorTreeCCZero {
        return SDValue {};
    }
    if (!mayFoldIntoVector(X, DAG, Subtarget) || !mayFoldIntoVector(Y, DAG, Subtarget)) && !IsOrXorXorTreeCCZero {
        return SDValue {};
    }
    if (OpSize == 128 && Subtarget.hasSSE2()) || (OpSize == 256 && Subtarget.hasAVX()) || (OpSize == 512 && Subtarget.useAVX512Regs()) {
        let mut HasPT: bool = Subtarget.hasSSE41();
        let mut PreferKOT: bool = Subtarget()();
        let mut NeedZExt: bool = PreferKOT && operator!(Subtarget()()) && OpSize != 512;
        let mut VecVT: EVT = EVT { v16i8 };
        let mut CmpVT: EVT = if PreferKOT { EVT { v16i1 } } else { VecVT };
        if OpSize == 256 {
            VecVT = EVT { v32i8 };
            CmpVT = if PreferKOT { EVT { v32i1 } } else { VecVT };
        }
        let mut CastVT: EVT = VecVT;
        let mut NeedsAVX512FCast: bool = false;
        if OpSize == 512 || NeedZExt {
            if Subtarget()() {
                VecVT = EVT { v64i8 };
                CmpVT = EVT { v64i1 };
                if OpSize == 512 {
                    CastVT = VecVT;
                }
            } else {
                VecVT = EVT { v16i32 };
                CmpVT = EVT { v16i1 };
                CastVT = if OpSize == 512 { VecVT } else { EVT { if OpSize == 256 { v8i32 } else { v4i32 } } };
                NeedsAVX512FCast = true;
            }
        }
        let mut ScalarToVector: Closure_107 = Closure_107 { CastVT: &mut CastVT, OpSize: &mut OpSize, NeedsAVX512FCast: &mut NeedsAVX512FCast, DAG: &mut DAG, NeedZExt: &mut NeedZExt, DL: &mut DL, VecVT: &mut VecVT };
        let mut Cmp: SDValue = SDValue {};
        if IsOrXorXorTreeCCZero {
            Cmp = emitOrXorXorTree(X, DL, DAG, VecVT, CmpVT, HasPT, ScalarToVector);
        } else {
            let mut VecX: SDValue = ScalarToVector.call(X);
            let mut VecY: SDValue = ScalarToVector.call(Y);
            if VecVT != CmpVT {
                Cmp = DAG.getSetCC(DL, CmpVT, VecX, VecY, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
            } else if HasPT {
                Cmp = DAG.getNode(XOR, DL, VecVT, VecX, VecY);
            } else {
                Cmp = DAG.getSetCC(DL, CmpVT, VecX, VecY, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
            }
        }
        if VecVT != CmpVT {
            let mut KRegVT: EVT = EVT { if CmpVT == EVT { v64i1 } { i64 } else { if CmpVT == EVT { v32i1 } { i32 } else { i16 } } };
            return DAG.getSetCC(DL, VT, DAG.getBitcast(KRegVT, Cmp), DAG.getConstant(0, DL, KRegVT, false, false), CC, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        if HasPT {
            let mut BCCmp: SDValue = DAG.getBitcast(EVT { if OpSize == 256 { v4i64 } else { v2i64 } }, Cmp);
            let mut PT: SDValue = DAG;
            let mut X86CC: CondCode = if CC == SETEQ { COND_E } else { COND_NE };
            let mut X86SetCC: SDValue = getSETCC(X86CC, PT, DL, DAG);
            return DAG.getNode(TRUNCATE, DL, VT, X86SetCC.getValue(0));
        }
        assert!(Cmp.getValueType() == EVT { v16i8 }, "Non 128-bit vector on pre-SSE41 target");
        let mut MovMsk: SDValue = DAG;
        let mut FFFFs: SDValue = DAG.getConstant(65535, DL, EVT { i32 }, false, false);
        return DAG.getSetCC(DL, VT, MovMsk, FFFFs, CC, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    return SDValue {};
}

fn matchScalarReduction(Op: SDValue, BinOp: NodeType, SrcOps: *mut SmallVectorImpl<SDValue>, SrcMask: *mut SmallVectorImpl<APInt>) -> bool {
    let mut Opnds: SmallVector<SDValue, 8> = zeroed();
    let mut SrcOpMap: i32 = 0;
    let mut VT: EVT = EVT { Other };
    assert!(Op.getOpcode() == BinOp, "Unexpected bit reduction opcode");
    Opnds()(Op.getOperand(0));
    Opnds()(Op.getOperand(1));
    for let mut Slot: u32 = 0;
let mut e: u32 = (); Slot < e; Slot += 1 {
        if  {
            Opnds();
            Opnds();
            e += 2;
            continue;
        }
        if  {
            return false;
        }
        let mut Idx: *mut auto = dyn_cast();
        if operator!() {
            return false;
        }
        let mut Src: SDValue = zeroed();
        let mut M: auto = (Src);
        if M() == () {
            VT = Src.getValueType();
            if operator!() && VT != ()() {
                return false;
            }
            let mut NumElts: u32 = VT.getVectorNumElements();
            let mut EltCount: APInt = getZero(NumElts);
            M() = (make_pair(Src, EltCount));
            SrcOps()(Src);
        }
        let mut CIdx: u32 = ();
        if M()[CIdx] {
            return false;
        }
        M()(CIdx);
    }
    if SrcMask {} else {}
    return true;
}

fn LowerVectorAllEqual(DL: *SDLoc, LHS: SDValue, RHS: SDValue, CC: CondCode, OriginalMask: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, X86CC: *mut CondCode) -> SDValue {
    let mut VT: EVT = LHS.getValueType();
    let mut ScalarSize: u32 = VT.getScalarSizeInBits();
    if OriginalMask.getBitWidth() != ScalarSize {
        assert!(ScalarSize == 1, "Element Mask vs Vector bitwidth mismatch");
        return SDValue {};
    }
    if !has_single_bit(VT.getSizeInBits()) {
        return SDValue {};
    }
    if VT.isFloatingPoint() {
        return SDValue {};
    }
    assert!((CC == SETEQ || CC == SETNE), "Unsupported ISD::CondCode");
    X86CC = (if CC == SETEQ { COND_E } else { COND_NE });
    let mut Mask: APInt = OriginalMask;
    let mut MaskBits: Closure_108 = Closure_108 { Mask: &mut Mask, DAG: &mut DAG, DL: &mut DL };
    if VT.getSizeInBits().operator unsigned long long() < 128 {
        let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), VT.getSizeInBits().operator unsigned long long());
        if operator!(DAG.getTargetLoweringInfo().isTypeLegal) {
            if IntVT != EVT { i64 } {
                return SDValue {};
            }
            let mut SplitLHS: pair<SDValue, SDValue> = DAG.SplitScalar(DAG.getBitcast(IntVT, MaskBits.call(LHS)), DL, EVT { i32 }, EVT { i32 });
            let mut SplitRHS: pair<SDValue, SDValue> = DAG.SplitScalar(DAG.getBitcast(IntVT, MaskBits.call(RHS)), DL, EVT { i32 }, EVT { i32 });
            let mut Lo: SDValue = DAG.getNode(XOR, DL, EVT { i32 }, SplitLHS.first, SplitRHS.first);
            let mut Hi: SDValue = DAG.getNode(XOR, DL, EVT { i32 }, SplitLHS.second, SplitRHS.second);
            return DAG;
        }
        return DAG;
    }
    let mut UseKORTEST: bool = Subtarget.useAVX512Regs();
    let mut UsePTEST: bool = Subtarget.hasSSE41();
    if !UsePTEST && !Mask.isAllOnes() && ScalarSize > 32 {
        return SDValue {};
    }
    let mut TestSize: u32 = if UseKORTEST { 512 } else { (if Subtarget.hasAVX() { 256 } else { 128 }) };
    if ScalarSize > TestSize {
        if !Mask.isAllOnes() {
            return SDValue {};
        }
        VT = getVectorVT(*DAG.getContext(), EVT { i64 }, VT.getSizeInBits().operator unsigned long long() / 64, false);
        LHS = DAG.getBitcast(VT, LHS);
        RHS = DAG.getBitcast(VT, RHS);
        Mask = getAllOnes(64);
    }
    if VT.getSizeInBits().operator unsigned long long() > TestSize {
        let mut KnownRHS: KnownBits = DAG.computeKnownBits(RHS, 0);
        if KnownRHS.isConstant() && KnownRHS.getConstant() == Mask {
            while VT.getSizeInBits().operator unsigned long long() > TestSize {
                let mut Split: pair<SDValue, SDValue> = DAG.SplitVector(LHS, DL);
                VT = Split.first.getValueType();
                LHS = DAG.getNode(AND, DL, VT, Split.first, Split.second);
            }
            RHS = DAG.getAllOnesConstant(DL, VT, false, false);
        } else if !UsePTEST && !KnownRHS.isZero() {
            let mut SVT: MVT = MVT { SimpleTy: if ScalarSize >= 32 { i32 } else { i8 } };
            VT = EVT { getVectorVT(SVT, VT.getSizeInBits().operator unsigned long long() / SVT.getSizeInBits().operator unsigned long long()) };
            LHS = DAG.getBitcast(VT, MaskBits.call(LHS));
            RHS = DAG.getBitcast(VT, MaskBits.call(RHS));
            let mut BoolVT: EVT = VT.changeVectorElementType(*DAG.getContext(), EVT { i1 });
            let mut V: SDValue = DAG.getSetCC(DL, BoolVT, LHS, RHS, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
            V = DAG.getSExtOrTrunc(V, DL, VT);
            while VT.getSizeInBits().operator unsigned long long() > TestSize {
                let mut Split: pair<SDValue, SDValue> = DAG.SplitVector(V, DL);
                VT = Split.first.getValueType();
                V = DAG.getNode(AND, DL, VT, Split.first, Split.second);
            }
            V = DAG.getNOT(DL, V, VT);
            V = DAG;
            return DAG;
        } else {
            let mut V: SDValue = DAG.getNode(XOR, DL, VT, LHS, RHS);
            while VT.getSizeInBits().operator unsigned long long() > TestSize {
                let mut Split: pair<SDValue, SDValue> = DAG.SplitVector(V, DL);
                VT = Split.first.getValueType();
                V = DAG.getNode(OR, DL, VT, Split.first, Split.second);
            }
            LHS = V;
            RHS = DAG.getConstant(0, DL, VT, false, false);
        }
    }
    if UseKORTEST && VT.is512BitVector() {
        let mut TestVT: MVT = getVectorVT(MVT { SimpleTy: i32 }, VT.getSizeInBits().operator unsigned long long() / 32);
        let mut BoolVT: MVT = TestVT.changeVectorElementType(MVT { SimpleTy: i1 });
        LHS = DAG.getBitcast(EVT { TestVT }, MaskBits.call(LHS));
        RHS = DAG.getBitcast(EVT { TestVT }, MaskBits.call(RHS));
        let mut V: SDValue = DAG.getSetCC(DL, EVT { BoolVT }, LHS, RHS, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        return DAG;
    }
    if UsePTEST {
        let mut TestVT: MVT = getVectorVT(MVT { SimpleTy: i64 }, VT.getSizeInBits().operator unsigned long long() / 64);
        LHS = DAG.getBitcast(EVT { TestVT }, MaskBits.call(LHS));
        RHS = DAG.getBitcast(EVT { TestVT }, MaskBits.call(RHS));
        let mut V: SDValue = DAG.getNode(XOR, DL, EVT { TestVT }, LHS, RHS);
        return DAG;
    }
    assert!(VT.getSizeInBits().operator unsigned long long() == 128, "Failure to split to 128-bits");
    let mut MaskVT: MVT = MVT { SimpleTy: if ScalarSize >= 32 { v4i32 } else { v16i8 } };
    LHS = DAG.getBitcast(EVT { MaskVT }, MaskBits.call(LHS));
    RHS = DAG.getBitcast(EVT { MaskVT }, MaskBits.call(RHS));
    let mut V: SDValue = DAG;
    V = DAG.getNOT(DL, V, EVT { MaskVT });
    V = DAG;
    return DAG;
}

fn MatchVectorAllEqualTest(OrigLHS: SDValue, OrigRHS: SDValue, CC: CondCode, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, X86CC: *mut CondCode) -> SDValue {
    let mut Op: SDValue = OrigLHS;
    let mut CmpNull: bool = false;
    let mut Mask: APInt = APInt {};
    if CC == SETEQ || CC == SETNE {
        CmpNull = isNullConstant(OrigRHS);
        if !CmpNull && !isAllOnesConstant(OrigRHS) {
            return SDValue {};
        }
        if !Subtarget.hasSSE2() || !operator(Op).hasOneUse() {
            return SDValue {};
        }
        Mask = getAllOnes(Op.getScalarValueSizeInBits());
        if CmpNull {
            match Op.getOpcode() {
                TRUNCATE => {
                    let mut Src: SDValue = Op.getOperand(0);
                    Mask = getLowBitsSet(Src.getScalarValueSizeInBits(), Op.getScalarValueSizeInBits());
                    Op = Src;
                    break;
                },
                AND => {
                    if  {
                        Mask = ();
                        Op = Op.getOperand(0);
                    }
                    break;
                },
            }
        }
    } else if CC == SETGT && isAllOnesConstant(OrigRHS) {
        CC = SETEQ;
        CmpNull = true;
        Mask = getSignMask(Op.getScalarValueSizeInBits());
    } else {
        return SDValue {};
    }
    let mut LogicOp: NodeType = if CmpNull { OR } else { AND };
    let mut VecIns: SmallVector<SDValue, 8> = zeroed();
    if Op.getOpcode() == LogicOp && matchScalarReduction(Op, LogicOp) {
        let mut VT: EVT = [0]();
        (((operator!(operator!((all_of(Closure_109 { cap_0: VT }) && "Reduction source vector mismatch")))) || (_wassert(L"llvm::all_of(VecIns, [VT](SDValue V) { return VT == V.getValueType(); }) && \"Reduction source vector mismatch\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (23867) as u32) , 0)) as void);
        if !has_single_bit(VT.getSizeInBits()) {
            return SDValue {};
        }
        for let mut Slot: u32 = 0;
let mut e: u32 = (); e - Slot > 1; Slot += 2 , e += 1 {
            let mut LHS: SDValue = [Slot];
            let mut RHS: SDValue = [Slot + 1];
            VecIns()(DAG.getNode(LogicOp, DL, VT, LHS, RHS));
        }
        return LowerVectorAllEqual(DL, if CmpNull { DAG.getConstant(0, DL, VT, false, false) } else { DAG.getAllOnesConstant(DL, VT, false, false) }, CC, Mask, Subtarget, DAG, X86CC);
    }
    if Op.getOpcode() == (if CmpNull { VECREDUCE_OR } else { VECREDUCE_AND }) {
        let mut Match: SDValue = Op.getOperand(0);
        let mut MatchVT: EVT = Match.getValueType();
        return LowerVectorAllEqual(DL, Match, if CmpNull { DAG.getConstant(0, DL, MatchVT, false, false) } else { DAG.getAllOnesConstant(DL, MatchVT, false, false) }, CC, Mask, Subtarget, DAG, X86CC);
    }
    if Mask.isAllOnes() {
        assert!(!Op.getValueType().isVector(), "Illegal vector type for reduction pattern");
        let mut Src: SDValue = peekThroughBitcasts(Op);
        if Src.getValueType().isFixedLengthVector() && Src.getValueType().getScalarType() == EVT { i1 } {
            if Src.getOpcode() == SETCC {
                let mut LHS: SDValue = Src.getOperand(0);
                let mut RHS: SDValue = Src.getOperand(1);
                let mut LHSVT: EVT = LHS.getValueType();
                let mut SrcCC: CondCode = cast(Src.getOperand(2))();
                if SrcCC == (if CmpNull { SETNE } else { SETEQ }) && has_single_bit(LHSVT.getSizeInBits()) {
                    let mut SrcMask: APInt = getAllOnes(LHSVT.getScalarSizeInBits());
                    return LowerVectorAllEqual(DL, LHS, RHS, CC, SrcMask, Subtarget, DAG, X86CC);
                }
            }
            if Src.getOpcode() == TRUNCATE {
                let mut Inner: SDValue = Src.getOperand(0);
                let mut InnerVT: EVT = Inner.getValueType();
                if has_single_bit(InnerVT.getSizeInBits()) {
                    let mut BW: u32 = InnerVT.getScalarSizeInBits();
                    let mut SrcMask: APInt = APInt { BW, 1, false, false };
                    let mut Cmp: APInt = if CmpNull { getZero(BW) } else { SrcMask };
                    return LowerVectorAllEqual(DL, Inner, DAG.getConstant(Cmp, DL, InnerVT, false, false), CC, SrcMask, Subtarget, DAG, X86CC);
                }
            }
        }
    }
    return SDValue {};
}

fn hasNonFlagsUse(Op: SDValue) -> bool {
    for Use in operator(Op).uses() {
        let mut User: *mut SDNode = Use.getUser();
        let mut UOpNo: u32 = Use.getOperandNo();
        if User.getOpcode() == TRUNCATE && User.hasOneUse() {
            UOpNo = operator(User.use_begin()).getOperandNo();
            User = operator(User.use_begin()).getUser();
        }
        if User.getOpcode() != BRCOND && User.getOpcode() != SETCC && !(User.getOpcode() == SELECT && UOpNo == 0) {
            return true;
        }
    }
    return false;
}

fn isProfitableToUseFlagOp(Op: SDValue) -> bool {
    for U in operator(Op).users() {
        if U.getOpcode() != CopyToReg && U.getOpcode() != SETCC && U.getOpcode() != STORE {
            return false;
        }
    }
    return true;
}

fn EmitTest(Op: SDValue, X86CC: CondCode, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut NeedCF: bool = false;
    let mut NeedOF: bool = false;
    match X86CC {
        _ => {
            break;
        },
        COND_A => {
            COND_AE;
        },
        COND_G => {
            COND_GE;
        },
    }
    if Op.getResNo() != 0 || NeedOF || NeedCF {
        return DAG;
    }
    let mut Opcode: u32 = 0;
    let mut NumOperands: u32 = 0;
    let mut ArithOp: SDValue = Op;
    match ArithOp.getOpcode() {
        AND => {
            if !hasNonFlagsUse(Op) {
                break;
            }
        },
        ADD => {
            SUB;
        },
        SSUBO => {
            USUBO;
        },
        _ => {
            break;
        },
    }
    if Opcode == 0 {
        return DAG;
    }
    let mut VTs: SDVTList = DAG.getVTList(Op.getValueType(), EVT { i32 });
    let mut Ops: SmallVector<SDValue, 4> = zeroed();
    let mut New: SDValue = DAG(Opcode, dl, VTs);
    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Op.getNode(), ResNo: 0 }, New);
    return SDValue { Node: New.getNode(), ResNo: 1 };
}

fn EmitCmp(Op0: SDValue, Op1: SDValue, X86CC: CondCode, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if isNullConstant(Op1) {
        return EmitTest(Op0, X86CC, dl, DAG, Subtarget);
    }
    let mut CmpVT: EVT = Op0.getValueType();
    assert!((CmpVT == EVT { i8 } || CmpVT == EVT { i16 } || CmpVT == EVT { i32 } || CmpVT == EVT { i64 }), "Unexpected VT!");
    let mut IsFoldableAtomicLoad: Closure_110 = Closure_110 {};
    if IsFoldableAtomicLoad(Op0) || IsFoldableAtomicLoad(Op1) {
        return DAG;
    }
    if CmpVT == EVT { i16 } && operator!(Subtarget()()) && !mayFoldLoad(Op0, Subtarget, false, false) && !mayFoldLoad(Op1, Subtarget, false, false) && !DAG.getMachineFunction().getFunction().hasMinSize() {
        let mut COp0: *mut auto = dyn_cast(Op0);
        let mut COp1: *mut auto = dyn_cast(Op1);
        if (COp0() && operator!(()(8))) || (COp1() && operator!(()(8))) {
            let mut ExtendOp: u32 = if isX86CCSigned(X86CC) { SIGN_EXTEND } else { ZERO_EXTEND };
            if X86CC == COND_E || X86CC == COND_NE {
                if Op0.getOpcode() == TRUNCATE {
                    if DAG.ComputeMaxSignificantBits(Op0.getOperand(0), 0) <= 16 {
                        ExtendOp = SIGN_EXTEND;
                    }
                } else if Op1.getOpcode() == TRUNCATE {
                    if DAG.ComputeMaxSignificantBits(Op1.getOperand(0), 0) <= 16 {
                        ExtendOp = SIGN_EXTEND;
                    }
                }
            }
            CmpVT = EVT { i32 };
            Op0 = DAG.getNode(ExtendOp, dl, CmpVT, Op0);
            Op1 = DAG.getNode(ExtendOp, dl, CmpVT, Op1);
        }
    }
    if CmpVT == EVT { i64 } && !isX86CCSigned(X86CC) && Op0.hasOneUse() && DAG.MaskedValueIsZero(Op1, getHighBitsSet(64, 32), 0) && DAG.MaskedValueIsZero(Op0, getHighBitsSet(64, 32), 0) {
        CmpVT = EVT { i32 };
        Op0 = DAG.getNode(TRUNCATE, dl, CmpVT, Op0);
        Op1 = DAG.getNode(TRUNCATE, dl, CmpVT, Op1);
    }
    if CmpVT == EVT { i64 } && Op0.hasOneUse() && DAG.ComputeNumSignBits(Op1, 0) > 32 && DAG.ComputeNumSignBits(Op0, 0) > 32 {
        CmpVT = EVT { i32 };
        Op0 = DAG.getNode(TRUNCATE, dl, CmpVT, Op0);
        Op1 = DAG.getNode(TRUNCATE, dl, CmpVT, Op1);
    }
    if CmpVT == EVT { i32 } && !isX86CCSigned(X86CC) && Op0.hasOneUse() && !isa(Op0) && !isa(Op1) {
        let mut BothOpsFit: Closure_111 = Closure_111 { DAG: &mut DAG, Op0: &mut Op0, Op1: &mut Op1 };
        let mut IsI16Eliminable: Closure_112 = Closure_112 {};
        if BothOpsFit.call(8) {
            CmpVT = EVT { i8 };
        } else if BothOpsFit.call(16) && (IsI16Eliminable(Op0) || IsI16Eliminable(Op1)) {
            CmpVT = EVT { i16 };
        }
        if CmpVT != EVT { i32 } {
            Op0 = DAG.getNode(TRUNCATE, dl, CmpVT, Op0);
            Op1 = DAG.getNode(TRUNCATE, dl, CmpVT, Op1);
        }
    }
    if Op0.getOpcode() == SUB && isNullConstant(Op0.getOperand(0)) && Op0.hasOneUse() && (X86CC == COND_E || X86CC == COND_NE) {
        let mut VTs: SDVTList = DAG.getVTList(CmpVT, EVT { i32 });
        let mut Add: SDValue = DAG;
        return Add.getValue(1);
    }
    if Op1.getOpcode() == SUB && isNullConstant(Op1.getOperand(0)) && Op1.hasOneUse() && (X86CC == COND_E || X86CC == COND_NE) {
        let mut VTs: SDVTList = DAG.getVTList(CmpVT, EVT { i32 });
        let mut Add: SDValue = DAG;
        return Add.getValue(1);
    }
    let mut X86Opc: u32 = 0;
    let mut VTs: SDVTList = DAG.getVTList(CmpVT, EVT { i32 });
    let mut CmpOp: SDValue = DAG.getNode(X86Opc, dl, VTs, Op0, Op1);
    return CmpOp.getValue(1);
}

fn X86TargetLowering::isXAndYEqZeroPreferableToXAndYEqY(self: *X86TargetLowering, Cond: CondCode, VT: EVT) -> bool {
    return !VT.isVector() || Cond != SETEQ;
}

fn X86TargetLowering::optimizeFMulOrFDivAsShiftAddBitcast(self: *X86TargetLowering, N: *mut SDNode, arg: SDValue, IntPow2: SDValue) -> bool {
    if N.getOpcode() == FDIV {
        return true;
    }
    let mut FPVT: EVT = N.getValueType(0);
    let mut IntVT: EVT = IntPow2.getValueType();
    if FPVT.isVector() && FPVT.getScalarSizeInBits() != IntVT.getScalarSizeInBits() {
        return false;
    }
    return true;
}

fn X86TargetLowering::isFsqrtCheap(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut VT: EVT = Op.getValueType();
    if VT.getScalarType() == EVT { f16 } {
        return true;
    }
    if DAG.doesNodeExist {
        return false;
    }
    if VT.isVector() {
        return self.Subtarget();
    }
    return self.Subtarget();
}

fn X86TargetLowering::getSqrtEstimate(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, Enabled: i32, RefinementSteps: *mut i32, UseOneConstNR: *mut bool, Reciprocal: bool) -> SDValue {
    let mut DL: SDLoc = SDLoc { Op };
    let mut VT: EVT = Op.getValueType();
    if self.isTypeLegal && ((VT == EVT { f32 } && self.Subtarget.hasSSE1()) || (VT == EVT { v4f32 } && self.Subtarget.hasSSE1() && Reciprocal) || (VT == EVT { v4f32 } && self.Subtarget.hasSSE2() && !Reciprocal) || (VT == EVT { v8f32 } && self.Subtarget.hasAVX()) || (VT == EVT { v16f32 } && self.Subtarget.useAVX512Regs())) {
        if RefinementSteps == Unspecified {
            RefinementSteps = 1;
        }
        UseOneConstNR = false;
        let mut Opcode: u32 = 0;
        let mut Estimate: SDValue = DAG.getNode(Opcode, DL, VT, Op);
        if RefinementSteps == 0 && !Reciprocal {
            Estimate = DAG.getNode(FMUL, DL, VT, Op, Estimate);
        }
        return Estimate;
    }
    if VT.getScalarType() == EVT { f16 } && self.isTypeLegal && self.Subtarget() {
        assert!(Reciprocal, "Don't replace SQRT with RSQRT for half type");
        if RefinementSteps == Unspecified {
            RefinementSteps = 0;
        }
        if VT == EVT { f16 } {
            let mut Zero: SDValue = DAG.getVectorIdxConstant(0, DL, false);
            let mut Undef: SDValue = DAG.getUNDEF(EVT { v8f16 });
            Op = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v8f16 }, Op);
            Op = DAG;
            return DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { f16 }, Op, Zero);
        }
        return DAG;
    }
    return SDValue {};
}

fn X86TargetLowering::getRecipEstimate(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, Enabled: i32, RefinementSteps: *mut i32) -> SDValue {
    let mut DL: SDLoc = SDLoc { Op };
    let mut VT: EVT = Op.getValueType();
    if self.isTypeLegal && ((VT == EVT { f32 } && self.Subtarget.hasSSE1()) || (VT == EVT { v4f32 } && self.Subtarget.hasSSE1()) || (VT == EVT { v8f32 } && self.Subtarget.hasAVX()) || (VT == EVT { v16f32 } && self.Subtarget.useAVX512Regs())) {
        if VT == EVT { f32 } && Enabled == Unspecified {
            return SDValue {};
        }
        if RefinementSteps == Unspecified {
            RefinementSteps = 1;
        }
        let mut Opcode: u32 = 0;
        return DAG.getNode(Opcode, DL, VT, Op);
    }
    if VT.getScalarType() == EVT { f16 } && self.isTypeLegal && self.Subtarget() {
        if RefinementSteps == Unspecified {
            RefinementSteps = 0;
        }
        if VT == EVT { f16 } {
            let mut Zero: SDValue = DAG.getVectorIdxConstant(0, DL, false);
            let mut Undef: SDValue = DAG.getUNDEF(EVT { v8f16 });
            Op = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v8f16 }, Op);
            Op = DAG;
            return DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { f16 }, Op, Zero);
        }
        return DAG;
    }
    return SDValue {};
}

fn X86TargetLowering::combineRepeatedFPDivisors(self: *X86TargetLowering) -> u32 {
    return 2;
}

fn X86TargetLowering::BuildSDIVPow2(self: *X86TargetLowering, N: *mut SDNode, Divisor: *APInt, DAG: *mut SelectionDAG, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut Attr: AttributeList = DAG.getMachineFunction().getFunction().getAttributes();
    if self.isIntDivCheap(N.getValueType(0), Attr) {
        return SDValue { Node: N, ResNo: 0 };
    }
    assert!((Divisor.isPowerOf2() || Divisor.isNegatedPowerOf2()), "Unexpected divisor!");
    if !self.Subtarget.canUseCMOV() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != EVT { i16 } && VT != EVT { i32 } && operator!((self.Subtarget() && VT == EVT { i64 })) {
        return SDValue {};
    }
    if Divisor == 2 || Divisor == APInt { Divisor.getBitWidth(), -2, true, false } {
        return SDValue {};
    }
    return self.buildSDIVPow2WithCMov;
}

fn LowerAndToBT(And: SDValue, CC: CondCode, dl: *SDLoc, DAG: *mut SelectionDAG, X86CC: *mut CondCode) -> SDValue {
    assert!(And.getOpcode() == AND, "Expected AND node!");
    assert!(And.getValueType().isScalarInteger(), "Scalar type expected");
    let mut AndRHSVal: APInt = APInt {};
    let mut Shl: SDValue = SDValue {};
    let mut Src: SDValue = SDValue {};
    let mut Mask: SDValue = SDValue {};
    let mut BitNo: SDValue = SDValue {};
    if sd_match(And, m_And(m_TruncOrSelf(m_Value(Src)), m_TruncOrSelf(m_Value(Shl, m_Shl(m_One(false), m_Value(BitNo)))))) {
        let mut BitWidth: u32 = Shl.getValueSizeInBits().operator unsigned long long();
        let mut AndBitWidth: u32 = And.getValueSizeInBits().operator unsigned long long();
        if BitWidth > AndBitWidth {
            let mut Known: KnownBits = DAG.computeKnownBits(Shl, 0);
            if Known.countMinLeadingZeros() < (BitWidth - AndBitWidth) {
                return SDValue {};
            }
        }
    } else if sd_match(And, m_ReassociatableAnd(m_Value(Src), m_Value(Mask), m_Shl(m_One(false), m_Value(BitNo)))) {} else if sd_match(And, m_And(m_TruncOrSelf(m_Srl(m_Value(Src), m_Value(BitNo))), m_One(false))) {} else if sd_match(And, m_And(m_TruncOrSelf(m_Value(Src)), m_ConstInt(AndRHSVal))) {
        let mut OptForSize: bool = DAG.shouldOptForSize();
        if !AndRHSVal.isPowerOf2() || AndRHSVal.isIntN(if OptForSize { 8 } else { 32 }) {
            return SDValue {};
        }
        BitNo = DAG.getConstant(AndRHSVal.ceilLogBase2(), dl, Src.getValueType(), false, false);
    } else {
        return SDValue {};
    }
    if Mask {
        Src = DAG.getNode(AND, dl, Src.getValueType(), Src, Mask);
    }
    if isBitwiseNot(Src, false) {
        Src = Src.getOperand(0);
        CC = if CC == SETEQ { SETNE } else { SETEQ };
    }
    if getBT(Src, BitNo, dl, DAG) {
        BT;
    } else {
        X86CC = if CC == SETEQ { COND_AE } else { COND_B };
        return BT;
    }
    return SDValue {};
}

fn cheapX86FSETCC_SSE(SetCCOpcode: CondCode) -> bool {
    return (SetCCOpcode != SETONE) && (SetCCOpcode != SETUEQ);
}

fn translateX86FSETCC(SetCCOpcode: CondCode, Op0: *mut SDValue, Op1: *mut SDValue, IsAlwaysSignaling: *mut bool) -> u32 {
    let mut SSECC: u32 = 0;
    let mut Swap: bool = false;
    match SetCCOpcode {
        _ => {
            llvm_unreachable_internal("Unexpected SETCC condition", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 24489);
        },
        SETOEQ => {
            SETEQ;
        },
        SETOGT => {
            SETGT;
        },
        SETLT => {
            SETOLT;
        },
        SETOGE => {
            SETGE;
        },
        SETLE => {
            SETOLE;
        },
        SETUO => {
            SSECC = 3;
        },
        SETUNE => {
            SETNE;
        },
        SETULE => {
            Swap = true;
        },
        SETUGE => {
            SSECC = 5;
        },
        SETULT => {
            Swap = true;
        },
        SETUGT => {
            SSECC = 6;
        },
        SETO => {
            SSECC = 7;
        },
        SETUEQ => {
            SSECC = 8;
        },
        SETONE => {
            SSECC = 12;
        },
    }
    if Swap {
        swap(Op0, Op1);
    }
    match SetCCOpcode {
        _ => {
            IsAlwaysSignaling = true;
        },
        SETEQ => {
            SETOEQ;
        },
    }
    return SSECC;
}

fn splitVSETCC(VT: EVT, LHS: SDValue, RHS: SDValue, Cond: CondCode, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!(VT.isInteger() && LHS.getValueType() == RHS.getValueType(), "Unsupported VTs!");
    let mut CC: SDValue = DAG.getCondCode(Cond);
    let mut LHS1: SDValue = SDValue {};
    let mut LHS2: SDValue = SDValue {};
    tie(LHS1, LHS2) = splitVector(LHS, DAG, dl);
    let mut RHS1: SDValue = SDValue {};
    let mut RHS2: SDValue = SDValue {};
    tie(RHS1, RHS2) = splitVector(RHS, DAG, dl);
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = DAG.GetSplitDestVTs;
    return DAG.getNode(CONCAT_VECTORS, dl, VT, DAG.getNode(SETCC, dl, LoVT, LHS1, RHS1, CC), DAG.getNode(SETCC, dl, HiVT, LHS2, RHS2, CC));
}

fn LowerIntVSETCC_AVX512(Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut Op0: SDValue = Op.getOperand(0);
    let mut Op1: SDValue = Op.getOperand(1);
    let mut CC: SDValue = Op.getOperand(2);
    let mut VT: MVT = Op.getSimpleValueType();
    assert!(VT.getVectorElementType() == i1, "Cannot set masked compare for this operation");
    let mut SetCCOpcode: CondCode = cast(CC)();
    let mut OpVT: EVT = Op0.getValueType();
    let mut C: APInt = APInt {};
    if SetCCOpcode == SETLT && isConstantSplatVector(Op1.getNode(), C) && C.isOne() {
        SetCCOpcode = SETLE;
        Op1 = DAG.getConstant(0, dl, OpVT, false, false);
    } else if SetCCOpcode == SETGT && isConstantSplatVector(Op0.getNode(), C) && C.isOne() {
        SetCCOpcode = SETLE;
        Op0 = Op1;
        Op1 = DAG.getConstant(0, dl, OpVT, false, false);
    } else if SetCCOpcode == SETGT && isConstantSplatVector(Op1.getNode(), C) && C.isAllOnes() {
        SetCCOpcode = SETGE;
        Op1 = DAG.getConstant(0, dl, OpVT, false, false);
    } else if SetCCOpcode == SETLT && isConstantSplatVector(Op0.getNode(), C) && C.isAllOnes() {
        SetCCOpcode = SETGE;
        Op0 = Op1;
        Op1 = DAG.getConstant(0, dl, OpVT, false, false);
    }
    if SetCCOpcode == SETLT {
        SetCCOpcode = getSetCCSwappedOperands(SetCCOpcode);
        swap(Op0, Op1);
    }
    return DAG.getSetCC(dl, EVT { VT }, Op0, Op1, SetCCOpcode, SDValue {}, false, SDNodeFlags { Flags: None });
}

fn incDecVectorConstant(V: SDValue, DAG: *mut SelectionDAG, IsInc: bool, NSW: bool) -> SDValue {
    let mut BV: *mut auto = dyn_cast(V.getNode());
    if operator!() || !V.getValueType().isSimple() {
        return SDValue {};
    }
    let mut VT: MVT = V.getSimpleValueType();
    let mut EltVT: MVT = VT.getVectorElementType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut NewVecC: SmallVector<APInt, 8> = zeroed();
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        let mut Elt: *mut auto = dyn_cast((i));
        if operator!() || () || (0) != EltVT {
            return SDValue {};
        }
        let mut EltC: *APInt = ();
        if (IsInc && EltC.isMaxValue()) || (!IsInc && EltC.isZero()) {
            return SDValue {};
        }
        if NSW && ((IsInc && EltC.isMaxSignedValue()) || (!IsInc && EltC.isMinSignedValue())) {
            return SDValue {};
        }
        NewVecC()(EltC + (if IsInc { 1 } else { -1 }));
    }
    return getConstVector(VT, DAG, SDLoc { V });
}

fn LowerVSETCCWithSUBUS(Op0: SDValue, Op1: SDValue, VT: MVT, Cond: CondCode, dl: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut VET: MVT = VT.getVectorElementType();
    if VET != i8 && VET != i16 {
        return SDValue {};
    }
    match Cond {
        _ => {
            return SDValue {};
        },
        SETULT => {
            if Subtarget.hasAVX() {
                return SDValue {};
            }
            let mut ULEOp1: SDValue = incDecVectorConstant(Op1, DAG, false, false);
            if !ULEOp1 {
                return SDValue {};
            }
            Op1 = ULEOp1;
            break;
        },
        SETUGT => {
            let mut UGEOp1: SDValue = incDecVectorConstant(Op1, DAG, true, false);
            if !UGEOp1 {
                return SDValue {};
            }
            Op1 = Op0;
            Op0 = UGEOp1;
            break;
        },
        SETUGE => {
            swap(Op0, Op1);
        },
        SETULE => {
            break;
        },
    }
    let mut Result: SDValue = DAG.getNode(USUBSAT, dl, EVT { VT }, Op0, Op1);
    return DAG;
}

fn LowerVSETCC(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = Op.getOpcode() == STRICT_FSETCC || Op.getOpcode() == STRICT_FSETCCS;
    let mut Op0: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut Op1: SDValue = Op.getOperand(if IsStrict { 2 } else { 1 });
    let mut CC: SDValue = Op.getOperand(if IsStrict { 3 } else { 2 });
    let mut VT: MVT = operator(Op).getSimpleValueType(0);
    let mut Cond: CondCode = cast(CC)();
    let mut OpVT: MVT = Op0.getSimpleValueType();
    let mut dl: SDLoc = SDLoc { Op };
    if OpVT.isFloatingPoint() {
        let mut EltVT: MVT = OpVT.getVectorElementType();
        assert!(EltVT == bf16 || EltVT == f16 || EltVT == f32 || EltVT == f64);
        let mut Chain: SDValue = if IsStrict { Op.getOperand(0) } else { SDValue {} };
        if isSoftF16(EltVT, Subtarget) {
            if Subtarget.hasAVX512() && operator!(Subtarget()()) {
                return SDValue {};
            }
            if OpVT.is256BitVector() && !Subtarget.useAVX512Regs() {
                return splitVSETCC(EVT { VT }, Op0, Op1, Cond, DAG, dl);
            }
            if OpVT.is512BitVector() {
                return splitVSETCC(EVT { VT }, Op0, Op1, Cond, DAG, dl);
            }
            let mut NVT: MVT = OpVT.changeVectorElementType(MVT { SimpleTy: f32 });
            if IsStrict {
                Op0 = DAG;
                Op1 = DAG;
                return DAG;
            }
            let mut DVT: MVT = if VT.getVectorElementType() == i16 { VT.changeVectorElementType(MVT { SimpleTy: i32 }) } else { VT };
            let mut Cmp: SDValue = DAG.getNode(Op.getOpcode(), dl, EVT { DVT }, DAG.getNode(FP_EXTEND, dl, EVT { NVT }, Op0), DAG.getNode(FP_EXTEND, dl, EVT { NVT }, Op1), CC);
            return if DVT == VT { Cmp } else { DAG.getNode(TRUNCATE, dl, EVT { VT }, Cmp) };
        }
        let mut IsSignaling: bool = Op.getOpcode() == STRICT_FSETCCS;
        let mut Opc: u32 = 0;
        if Subtarget.hasAVX512() && VT.getVectorElementType() == i1 && (!IsStrict || Subtarget()() || Op0.getSimpleValueType().is512BitVector()) {
            let mut Num: u32 = VT.getVectorNumElements();
            assert!(Num <= 16 || (Num == 32 && (EltVT == f16 || EltVT == bf16);
        } else {
            VT = Op0.getSimpleValueType();
        }
        let mut Cmp: SDValue = SDValue {};
        let mut IsAlwaysSignaling: bool = false;
        let mut SSECC: u32 = translateX86FSETCC(Cond, Op0, Op1, IsAlwaysSignaling);
        if (Cond == SETO || Cond == SETUO) && Op0 != Op1 {
            if DAG.isKnownNeverNaN(Op1, false, 0) {
                Op1 = Op0;
            } else if DAG.isKnownNeverNaN(Op0, false, 0) {
                Op0 = Op1;
            }
        }
        if !Subtarget.hasAVX() {
            if IsStrict && IsAlwaysSignaling && !IsSignaling {
                return SDValue {};
            }
            if IsStrict && !IsAlwaysSignaling && IsSignaling {
                let mut SignalCmp: SDValue = DAG;
                operator(SignalCmp).setFlags(operator(Op).getFlags());
                Chain = SignalCmp.getValue(1);
            }
            if !cheapX86FSETCC_SSE(Cond) {
                let mut CC0: u32 = 0;
                let mut CC1: u32 = 0;
                let mut CombineOpc: u32 = 0;
                if Cond == SETUEQ {
                    CC0 = 3;
                    CC1 = 0;
                } else {
                    assert!(Cond == SETONE);
                    CC0 = 7;
                    CC1 = 4;
                }
                let mut Cmp0: SDValue = SDValue {};
                let mut Cmp1: SDValue = SDValue {};
                if IsStrict {
                    Cmp0 = DAG;
                    Cmp1 = DAG;
                    Chain = DAG.getNode(TokenFactor, dl, EVT { Other }, Cmp0.getValue(1), Cmp1.getValue(1));
                } else {
                    Cmp0 = DAG.getNode(Opc, dl, EVT { VT }, Op0, Op1, DAG.getTargetConstant(CC0, dl, EVT { i8 }, false));
                    Cmp1 = DAG.getNode(Opc, dl, EVT { VT }, Op0, Op1, DAG.getTargetConstant(CC1, dl, EVT { i8 }, false));
                }
                Cmp = DAG.getNode(CombineOpc, dl, EVT { VT }, Cmp0, Cmp1);
            } else {
                if IsStrict {
                    Cmp = DAG;
                    Chain = Cmp.getValue(1);
                } else {
                    Cmp = DAG.getNode(Opc, dl, EVT { VT }, Op0, Op1, DAG.getTargetConstant(SSECC, dl, EVT { i8 }, false));
                }
            }
        } else {
            if IsStrict {
                SSECC |= (IsAlwaysSignaling ^ IsSignaling) << 4;
                Cmp = DAG;
                Chain = Cmp.getValue(1);
            } else {
                Cmp = DAG.getNode(Opc, dl, EVT { VT }, Op0, Op1, DAG.getTargetConstant(SSECC, dl, EVT { i8 }, false));
            }
        }
        if VT.getFixedSizeInBits() > Op.getSimpleValueType().getFixedSizeInBits() {
            let mut CastVT: EVT = EVT { VT }.changeVectorElementTypeToInteger();
            Cmp = DAG.getBitcast(CastVT, Cmp);
            Cmp = DAG.getSetCC(dl, EVT { Op.getSimpleValueType() }, Cmp, DAG.getConstant(0, dl, CastVT, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        } else {
            Cmp = DAG.getBitcast(EVT { Op.getSimpleValueType() }, Cmp);
        }
        if IsStrict {
            return DAG.getMergeValues;
        }
        return Cmp;
    }
    assert!(!IsStrict, "Strict SETCC only handles FP operands.");
    let mut VTOp0: MVT = Op0.getSimpleValueType();
    assert!(VTOp0 == Op1.getSimpleValueType(), "Expected operands with same type!");
    assert!(VT.getVectorNumElements() == VTOp0.getVectorNumElements(), "Invalid number of packed elements for source and destination!");
    assert!((Subtarget.hasAVX512() || (VT == VTOp0)), "Value types for source and destination must be the same!");
    if VT.getVectorElementType() == i1 {
        (((operator!(operator!(((VTOp0.getScalarSizeInBits() >= 32 || Subtarget()()) && "Unexpected operand type")))) || (_wassert(L"(VTOp0.getScalarSizeInBits() >= 32 || Subtarget.hasBWI()) && \"Unexpected operand type\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (24895) as u32) , 0)) as void);
        return LowerIntVSETCC_AVX512(Op, dl, DAG);
    }
    if VT.is128BitVector() && Subtarget()() {
        let mut CmpMode: u32 = 0;
        match Cond {
            _ => {
                llvm_unreachable_internal("Unexpected SETCC condition", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 24905);
            },
            SETULT => {
                SETLT;
            },
            SETULE => {
                SETLE;
            },
            SETUGT => {
                SETGT;
            },
            SETUGE => {
                SETGE;
            },
            SETEQ => {
                CmpMode = 4;
            },
            SETNE => {
                CmpMode = 5;
            },
        }
        let mut Opc: u32 = 0;
        return DAG.getNode(Opc, dl, EVT { VT }, Op0, Op1, DAG.getTargetConstant(CmpMode, dl, EVT { i8 }, false));
    }
    if Cond == SETNE && isBuildVectorAllZeros(Op1.getNode()) {
        let mut BC0: SDValue = peekThroughBitcasts(Op0);
        if BC0.getOpcode() == AND && isConstantPowerOf2(BC0.getOperand(1), VT.getScalarSizeInBits(), false) {
            Cond = SETEQ;
            Op1 = DAG.getBitcast(EVT { VT }, BC0.getOperand(1));
        }
    }
    if Cond == SETEQ && Op0.getOpcode() == AND && Op0.getOperand(1) == Op1 && Op0.hasOneUse() {
        let mut C1: *mut ConstantSDNode = isConstOrConstSplat(Op1, false, false);
        if C1 && C1.getAPIntValue().isPowerOf2() {
            let mut BitWidth: u32 = VT.getScalarSizeInBits();
            let mut ShiftAmt: u32 = C1.getAPIntValue().countl_zero();
            let mut Result: SDValue = Op0.getOperand(0);
            Result = DAG.getNode(SHL, dl, EVT { VT }, Result, DAG.getConstant(ShiftAmt, dl, EVT { VT }, false, false));
            Result = DAG.getNode(SRA, dl, EVT { VT }, Result, DAG.getConstant(BitWidth - 1, dl, EVT { VT }, false, false));
            return Result;
        }
    }
    if VT.is256BitVector() && !Subtarget.hasInt256() {
        return splitVSETCC(EVT { VT }, Op0, Op1, Cond, DAG, dl);
    }
    if VT.is512BitVector() {
        return splitVSETCC(EVT { VT }, Op0, Op1, Cond, DAG, dl);
    }
    let mut ConstValue: APInt = APInt {};
    if Cond == SETNE && isConstantSplatVector(Op1.getNode(), ConstValue) {
        if ConstValue.isMinSignedValue() {
            Cond = SETGT;
        } else if ConstValue.isMaxSignedValue() {
            Cond = SETLT;
        } else if ConstValue.isZero() && DAG.SignBitIsZero(Op0, 0) {
            Cond = SETGT;
        }
    }
    let mut FlipSigns: bool = isUnsignedIntSetCC(Cond) && !(DAG.SignBitIsZero(Op0, 0) && DAG.SignBitIsZero(Op1, 0));
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if isUnsignedIntSetCC(Cond) && (FlipSigns || isTrueWhenEqual(Cond)) && TLI.isOperationLegal {
        if Cond == SETUGT {
            if incDecVectorConstant(Op1, DAG, true, false) {
                UGTOp1;
            } else {
                Op1 = UGTOp1;
                Cond = SETUGE;
            }
        }
        if Cond == SETULT {
            if incDecVectorConstant(Op1, DAG, false, false) {
                ULTOp1;
            } else {
                Op1 = ULTOp1;
                Cond = SETULE;
            }
        }
        let mut Invert: bool = false;
        let mut Opc: u32 = 0;
        match Cond {
            _ => {
                llvm_unreachable_internal("Unexpected condition code", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 25015);
            },
            SETUGT => {
                Invert = true;
            },
            SETULE => {
                Opc = UMIN;
            },
            SETULT => {
                Invert = true;
            },
            SETUGE => {
                Opc = UMAX;
            },
        }
        let mut Result: SDValue = DAG.getNode(Opc, dl, EVT { VT }, Op0, Op1);
        Result = DAG;
        if Invert {
            Result = DAG.getNOT(dl, Result, EVT { VT });
        }
        return Result;
    }
    if FlipSigns {
        if LowerVSETCCWithSUBUS(Op0, Op1, VT, Cond, dl, Subtarget, DAG) {
            V;
        } else {
            return V;
        }
    }
    let mut Opc: u32 = 0;
    let mut Swap: bool = Cond == SETLT || Cond == SETULT || Cond == SETGE || Cond == SETUGE;
    let mut Invert: bool = Cond == SETNE || (Cond != SETEQ && isTrueWhenEqual(Cond));
    if Swap {
        swap(Op0, Op1);
    }
    if VT == v2i64 {
        if  {
            assert!(Subtarget.hasSSE2(), "Don't know how to lower!");
            if !FlipSigns && !Invert && isBuildVectorAllZeros(Op0.getNode()) {
                Op0 = DAG.getConstant(0, dl, EVT { v4i32 }, false, false);
                Op1 = DAG.getBitcast(EVT { v4i32 }, Op1);
                let mut GT: SDValue = DAG;
                let mut MaskHi: [4]i32 = [1, 1, 3, 3];
                let mut Result: SDValue = DAG.getVectorShuffle;
                return DAG.getBitcast(EVT { VT }, Result);
            }
            if !FlipSigns && !Invert && isBuildVectorAllOnes(Op1.getNode()) {
                Op0 = DAG.getBitcast(EVT { v4i32 }, Op0);
                Op1 = DAG.getAllOnesConstant(dl, EVT { v4i32 }, false, false);
                let mut GT: SDValue = DAG;
                let mut MaskHi: [4]i32 = [1, 1, 3, 3];
                let mut Result: SDValue = DAG.getVectorShuffle;
                return DAG.getBitcast(EVT { VT }, Result);
            }
            if !FlipSigns && !Invert && DAG.ComputeNumSignBits(Op0, 0) > 32 && DAG.ComputeNumSignBits(Op1, 0) > 32 {
                Op0 = DAG.getBitcast(EVT { v4i32 }, Op0);
                Op1 = DAG.getBitcast(EVT { v4i32 }, Op1);
                let mut GT: SDValue = DAG;
                let mut MaskLo: [4]i32 = [0, 0, 2, 2];
                let mut Result: SDValue = DAG.getVectorShuffle;
                return DAG.getBitcast(EVT { VT }, Result);
            }
            let mut SB: SDValue = DAG.getConstant(if FlipSigns { 9223372039002259456 } else { 2147483648 }, dl, EVT { v2i64 }, false, false);
            Op0 = DAG.getNode(XOR, dl, EVT { v2i64 }, Op0, SB);
            Op1 = DAG.getNode(XOR, dl, EVT { v2i64 }, Op1, SB);
            Op0 = DAG.getBitcast(EVT { v4i32 }, Op0);
            Op1 = DAG.getBitcast(EVT { v4i32 }, Op1);
            let mut GT: SDValue = DAG;
            let mut EQ: SDValue = DAG;
            let mut MaskHi: [4]i32 = [1, 1, 3, 3];
            let mut MaskLo: [4]i32 = [0, 0, 2, 2];
            let mut EQHi: SDValue = DAG.getVectorShuffle;
            let mut GTLo: SDValue = DAG.getVectorShuffle;
            let mut GTHi: SDValue = DAG.getVectorShuffle;
            let mut Result: SDValue = DAG.getNode(AND, dl, EVT { v4i32 }, EQHi, GTLo);
            Result = DAG.getNode(OR, dl, EVT { v4i32 }, Result, GTHi);
            if Invert {
                Result = DAG.getNOT(dl, Result, EVT { v4i32 });
            }
            return DAG.getBitcast(EVT { VT }, Result);
        }
        if  {
            assert!(Subtarget.hasSSE2() && !FlipSigns, "Don't know how to lower!");
            Op0 = DAG.getBitcast(EVT { v4i32 }, Op0);
            Op1 = DAG.getBitcast(EVT { v4i32 }, Op1);
            let mut Result: SDValue = DAG.getNode(Opc, dl, EVT { v4i32 }, Op0, Op1);
            let mut Mask: [4]i32 = [1, 0, 3, 2];
            let mut Shuf: SDValue = DAG.getVectorShuffle;
            Result = DAG.getNode(AND, dl, EVT { v4i32 }, Result, Shuf);
            if Invert {
                Result = DAG.getNOT(dl, Result, EVT { v4i32 });
            }
            return DAG.getBitcast(EVT { VT }, Result);
        }
    }
    if FlipSigns {
        let mut EltVT: MVT = VT.getVectorElementType();
        let mut SM: SDValue = DAG.getConstant(getSignMask(EltVT.getSizeInBits().operator unsigned long long()), dl, EVT { VT }, false, false);
        Op0 = DAG.getNode(XOR, dl, EVT { VT }, Op0, SM);
        Op1 = DAG.getNode(XOR, dl, EVT { VT }, Op1, SM);
    }
    let mut Result: SDValue = DAG.getNode(Opc, dl, EVT { VT }, Op0, Op1);
    if Invert {
        Result = DAG.getNOT(dl, Result, EVT { VT });
    }
    return Result;
}

fn EmitAVX512Test(Op0: SDValue, Op1: SDValue, CC: CondCode, dl: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, X86CC: *mut SDValue) -> SDValue {
    assert!((CC == SETEQ || CC == SETNE), "Unsupported ISD::CondCode");
    if Op0.getOpcode() != BITCAST {
        return SDValue {};
    }
    Op0 = Op0.getOperand(0);
    let mut VT: MVT = Op0.getSimpleValueType();
    if !(Subtarget.hasAVX512() && VT == v16i1) && operator!((Subtarget()() && VT == v8i1)) && operator!((Subtarget()() && (VT == v32i1 || VT == v64i1))) {
        return SDValue {};
    }
    let mut X86Cond: CondCode = zeroed();
    if isNullConstant(Op1) {
        X86Cond = if CC == SETEQ { COND_E } else { COND_NE };
    } else if isAllOnesConstant(Op1) {
        X86Cond = if CC == SETEQ { COND_B } else { COND_AE };
    } else {
        return SDValue {};
    }
    let mut KTestable: bool = false;
    if Subtarget()() && (VT == v8i1 || VT == v16i1) {
        KTestable = true;
    }
    if Subtarget()() && (VT == v32i1 || VT == v64i1) {
        KTestable = true;
    }
    if !isNullConstant(Op1) {
        KTestable = false;
    }
    if KTestable && Op0.getOpcode() == AND && Op0.hasOneUse() {
        let mut LHS: SDValue = Op0.getOperand(0);
        let mut RHS: SDValue = Op0.getOperand(1);
        X86CC = DAG.getTargetConstant(X86Cond, dl, EVT { i8 }, false);
        return DAG;
    }
    let mut LHS: SDValue = Op0;
    let mut RHS: SDValue = Op0;
    if Op0.getOpcode() == OR && Op0.hasOneUse() {
        LHS = Op0.getOperand(0);
        RHS = Op0.getOperand(1);
    }
    X86CC = DAG.getTargetConstant(X86Cond, dl, EVT { i8 }, false);
    return DAG;
}

fn X86TargetLowering::emitFlagsForSetcc(self: *X86TargetLowering, Op0: SDValue, Op1: SDValue, CC: CondCode, dl: *SDLoc, DAG: *mut SelectionDAG, X86CC: *mut SDValue) -> SDValue {
    if CC == SETEQ || CC == SETNE {
        let mut X86CondCode: CondCode = zeroed();
        if Op0.getOpcode() == AND && Op0.hasOneUse() && isNullConstant(Op1) {
            if LowerAndToBT(Op0, CC, dl, DAG, X86CondCode) {
                BT;
            } else {
                X86CC = DAG.getTargetConstant(X86CondCode, dl, EVT { i8 }, false);
                return BT;
            }
        }
        if MatchVectorAllEqualTest(Op0, Op1, CC, dl, self.Subtarget, DAG, X86CondCode) {
            CmpZ;
        } else {
            X86CC = DAG.getTargetConstant(X86CondCode, dl, EVT { i8 }, false);
            return CmpZ;
        }
        if EmitAVX512Test(Op0, Op1, CC, dl, DAG, self.Subtarget, X86CC) {
            Test;
        } else {
            return Test;
        }
        if isOneConstant(Op1) || isNullConstant(Op1) {
            if  {
                let mut Invert: bool = (CC == SETNE) ^ isNullConstant(Op1);
                X86CC = Op0.getOperand(0);
                if Invert {
                    X86CondCode = Op0.getConstantOperandVal(0) as CondCode;
                    X86CondCode = GetOppositeBranchCondition(X86CondCode);
                    X86CC = DAG.getTargetConstant(X86CondCode, dl, EVT { i8 }, false);
                }
                return Op0.getOperand(1);
            }
        }
        if isMinSignedConstant(Op1) {
            let mut VT: EVT = Op0.getValueType();
            if VT == EVT { i32 } || VT == EVT { i64 } || operator(Op0).hasOneUse() {
                let mut CmpVTs: SDVTList = DAG.getVTList(VT, EVT { i32 });
                let mut CondCode: CondCode = if CC == SETEQ { COND_O } else { COND_NO };
                X86CC = DAG.getTargetConstant(CondCode, dl, EVT { i8 }, false);
                let mut Neg: SDValue = DAG;
                return SDValue { Node: Neg.getNode(), ResNo: 1 };
            }
        }
        if isAllOnesConstant(Op1) && Op0.getOpcode() == ADD && Op0.getOperand(1) == Op1 {
            if isProfitableToUseFlagOp(Op0) {
                let mut VTs: SDVTList = DAG.getVTList(Op0.getValueType(), EVT { i32 });
                let mut New: SDValue = DAG;
                DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Op0.getNode(), ResNo: 0 }, New);
                X86CondCode = if CC == SETEQ { COND_AE } else { COND_B };
                X86CC = DAG.getTargetConstant(X86CondCode, dl, EVT { i8 }, false);
                return SDValue { Node: New.getNode(), ResNo: 1 };
            }
        }
    }
    let mut CondCode: CondCode = TranslateX86CC(CC, dl, false, Op0, Op1, DAG);
    assert!(CondCode != COND_INVALID, "Unexpected condition code!");
    let mut EFLAGS: SDValue = EmitCmp(Op0, Op1, CondCode, dl, DAG, self.Subtarget);
    X86CC = DAG.getTargetConstant(CondCode, dl, EVT { i8 }, false);
    return EFLAGS;
}

fn X86TargetLowering::LowerSETCC(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = Op.getOpcode() == STRICT_FSETCC || Op.getOpcode() == STRICT_FSETCCS;
    let mut VT: MVT = operator(Op).getSimpleValueType(0);
    if VT.isVector() {
        return LowerVSETCC(Op, self.Subtarget, DAG);
    }
    assert!(VT == i8, "SetCC type must be 8-bit integer");
    let mut Chain: SDValue = if IsStrict { Op.getOperand(0) } else { SDValue {} };
    let mut Op0: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut Op1: SDValue = Op.getOperand(if IsStrict { 2 } else { 1 });
    let mut dl: SDLoc = SDLoc { Op };
    let mut CC: CondCode = cast(Op.getOperand(if IsStrict { 3 } else { 2 }))();
    if isSoftF16(Op0.getValueType(), self.Subtarget) {
        return SDValue {};
    }
    if Op0.getValueType() == EVT { f128 } {
        if !Op1.getNode() {
            assert!(Op0.getValueType() == Op.getValueType(), "Unexpected setcc expansion!");
            if IsStrict {
                return DAG.getMergeValues;
            }
            return Op0;
        }
    }
    if Op0.getSimpleValueType().isInteger() {
        if  {
            let mut Op1Val: *APInt = ();
            if !Op1Val.isZero() {
                if (CC == SETGT && !Op1Val.isMaxSignedValue()) || (CC == SETUGT && !Op1Val.isMaxValue()) {
                    let mut Op1ValPlusOne: APInt = Op1Val + 1;
                    if Op1ValPlusOne.isSignedIntN(32) && (!Op1Val.isSignedIntN(8) || Op1ValPlusOne.isSignedIntN(8)) {
                        Op1 = DAG.getConstant(Op1ValPlusOne, dl, Op0.getValueType(), false, false);
                        CC = if CC == SETGT { SETGE } else { SETUGE };
                    }
                }
            }
        }
        let mut X86CC: SDValue = SDValue {};
        let mut EFLAGS: SDValue = self.emitFlagsForSetcc(Op0, Op1, CC, dl, DAG, X86CC);
        let mut Res: SDValue = DAG;
        return if IsStrict { DAG.getMergeValues } else { Res };
    }
    if self.Subtarget() {
        if CC == SETOEQ || CC == SETUNE {
            let mut NewCC: auto = if (CC == SETOEQ) { COND_E } else { (COND_NE) };
            assert!(Op0.getSimpleValueType() != bf16, "Unsupported Type");
            if Op0.getSimpleValueType() != f80 {
                let mut Res: SDValue = getSETCC(DAG, dl, DAG);
                return if IsStrict { DAG.getMergeValues } else { Res };
            }
        }
    }
    let mut CondCode: CondCode = TranslateX86CC(CC, dl, true, Op0, Op1, DAG);
    if CondCode == COND_INVALID {
        return SDValue {};
    }
    let mut EFLAGS: SDValue = SDValue {};
    if IsStrict {
        let mut IsSignaling: bool = Op.getOpcode() == STRICT_FSETCCS;
        EFLAGS = DAG;
        Chain = EFLAGS.getValue(1);
    } else {
        EFLAGS = DAG;
    }
    let mut X86CC: SDValue = DAG.getTargetConstant(CondCode, dl, EVT { i8 }, false);
    let mut Res: SDValue = DAG;
    return if IsStrict { DAG.getMergeValues } else { Res };
}

fn X86TargetLowering::LowerSETCCCARRY(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    let mut Carry: SDValue = Op.getOperand(2);
    let mut Cond: SDValue = Op.getOperand(3);
    let mut DL: SDLoc = SDLoc { Op };
    assert!(LHS.getSimpleValueType().isInteger(), "SETCCCARRY is integer only.");
    let mut CC: CondCode = TranslateIntegerX86CC(cast(Cond)());
    let mut CarryVT: EVT = Carry.getValueType();
    Carry = DAG;
    let mut VTs: SDVTList = DAG.getVTList(LHS.getValueType(), EVT { i32 });
    let mut Cmp: SDValue = DAG;
    return getSETCC(CC, Cmp.getValue(1), DL, DAG);
}

fn getX86XALUOOp(Cond: *mut CondCode, Op: SDValue, DAG: *mut SelectionDAG) -> pair<SDValue, SDValue> {
    assert!(Op.getResNo() == 0, "Unexpected result number!");
    let mut Value: SDValue = SDValue {};
    let mut Overflow: SDValue = SDValue {};
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    let mut BaseOp: u32 = 0;
    let mut DL: SDLoc = SDLoc { Op };
    match Op.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unknown ovf instruction!", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 25452);
        },
        SADDO => {
            
        },
        UADDO => {
            
        },
        SSUBO => {
            
        },
        USUBO => {
            
        },
        SMULO => {
            
        },
        UMULO => {
            
        },
    }
    if BaseOp {
        let mut VTs: SDVTList = DAG.getVTList(Op.getValueType(), EVT { i32 });
        Value = DAG.getNode(BaseOp, DL, VTs, LHS, RHS);
        Overflow = Value.getValue(1);
    }
    return make_pair(Value, Overflow);
}

fn LowerXALUO(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Op };
    let mut Cond: CondCode = zeroed();
    let mut Value: SDValue = SDValue {};
    let mut Overflow: SDValue = SDValue {};
    tie(Value, Overflow) = getX86XALUOOp(Cond, Op, DAG);
    let mut SetCC: SDValue = getSETCC(Cond, Overflow, DL, DAG);
    assert!(operator(Op).getValueType(1) == EVT { i8 }, "Unexpected VT!");
    return DAG.getNode(MERGE_VALUES, DL, operator(Op).getVTList(), Value, SetCC);
}

fn isX86LogicalCmp(Op: SDValue) -> bool {
    let mut Opc: u32 = Op.getOpcode();
    if  {
        return true;
    }
    if  {
        return true;
    }
    return false;
}

fn isTruncWithZeroHighBitsInput(V: SDValue, DAG: *mut SelectionDAG) -> bool {
    if V.getOpcode() != TRUNCATE {
        return false;
    }
    let mut VOp0: SDValue = V.getOperand(0);
    let mut InBits: u32 = VOp0.getValueSizeInBits().operator unsigned long long();
    let mut Bits: u32 = V.getValueSizeInBits().operator unsigned long long();
    return DAG.MaskedValueIsZero(VOp0, getHighBitsSet(InBits, InBits - Bits), 0);
}

fn LowerSELECTWithCmpZero(CmpVal: SDValue, LHS: SDValue, RHS: SDValue, X86CC: u32, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut CmpVT: EVT = CmpVal.getValueType();
    let mut VT: EVT = LHS.getValueType();
    if !CmpVT.isScalarInteger() || !VT.isScalarInteger() {
        return SDValue {};
    }
    if X86CC == COND_E && CmpVal.getOpcode() == AND && isOneConstant(CmpVal.getOperand(1)) {
        let mut SplatLSB: Closure_113 = Closure_113 { CmpVal: &mut CmpVal, CmpVT: &mut CmpVT, DAG: &mut DAG, DL: &mut DL };
        if isNullConstant(LHS) && isAllOnesConstant(RHS) {
            return SplatLSB.call(VT);
        }
        if !Subtarget.canUseCMOV() && isa(LHS) && isa(RHS) {
            let mut Mask: SDValue = SplatLSB.call(VT);
            let mut Diff: SDValue = DAG.getNode(XOR, DL, VT, LHS, RHS);
            let mut Flip: SDValue = DAG.getNode(AND, DL, VT, Mask, Diff);
            return DAG.getNode(XOR, DL, VT, LHS, Flip);
        }
        let mut Src1: SDValue = SDValue {};
        let mut Src2: SDValue = SDValue {};
        let mut isIdentityPatternZero: Closure_114 = Closure_114 { RHS: &mut RHS, LHS: &mut LHS, Src1: &mut Src1, Src2: &mut Src2 };
        let mut isIdentityPatternOnes: Closure_115 = Closure_115 { LHS: &mut LHS, RHS: &mut RHS, Src1: &mut Src1, Src2: &mut Src2 };
        if !Subtarget.canUseCMOV() && isIdentityPatternZero.call() {
            let mut Mask: SDValue = SplatLSB.call(Src1.getValueType());
            let mut And: SDValue = DAG.getNode(AND, DL, Src1.getValueType(), Mask, Src1);
            return DAG.getNode(RHS.getOpcode(), DL, VT, Src2, And);
        }
        if !Subtarget.canUseCMOV() && isIdentityPatternOnes.call() {
            let mut Mask: SDValue = SplatLSB.call(VT);
            let mut Or: SDValue = DAG.getNode(OR, DL, VT, Mask, Src1);
            return DAG.getNode(LHS.getOpcode(), DL, VT, Src2, Or);
        }
    }
    if (X86CC == COND_E || X86CC == COND_NE) && (isAllOnesConstant(LHS) || isAllOnesConstant(RHS)) {
        let mut Y: SDValue = if isAllOnesConstant(RHS) { LHS } else { RHS };
        let mut CmpVTs: SDVTList = DAG.getVTList(CmpVT, EVT { i32 });
        let mut Sub: SDValue = SDValue {};
        if isAllOnesConstant(LHS) == (X86CC == COND_NE) {
            let mut Zero: SDValue = DAG.getConstant(0, DL, CmpVT, false, false);
            Sub = DAG;
        } else {
            let mut One: SDValue = DAG.getConstant(1, DL, CmpVT, false, false);
            Sub = DAG;
        }
        let mut SBB: SDValue = DAG;
        return DAG.getNode(OR, DL, VT, SBB, Y);
    }
    return SDValue {};
}

fn canEmitConjunctionForCCMP(DAG: *mut SelectionDAG, Val: SDValue, CanNegate: *mut bool, MustBeFirst: *mut bool, PreferFirst: *mut bool, WillNegate: bool, Depth: u32) -> bool {
    if !Val.hasOneUse() {
        return false;
    }
    let mut Opcode: u32 = Val.getOpcode();
    if Opcode == SETCC {
        let mut VT: EVT = Val.getOperand(0).getValueType();
        if !VT.isInteger() {
            return false;
        }
        CanNegate = true;
        MustBeFirst = false;
        PreferFirst = DAG.doesNodeExist;
        return true;
    }
    if Depth > 6 {
        return false;
    }
    if Opcode == AND || Opcode == OR {
        let mut IsOR: bool = Opcode == OR;
        let mut O0: SDValue = Val.getOperand(0);
        let mut O1: SDValue = Val.getOperand(1);
        let mut CanNegateL: bool = false;
        let mut MustBeFirstL: bool = false;
        let mut PreferFirstL: bool = false;
        if !canEmitConjunctionForCCMP(DAG, O0, CanNegateL, MustBeFirstL, PreferFirstL, IsOR, Depth + 1) {
            return false;
        }
        let mut CanNegateR: bool = false;
        let mut MustBeFirstR: bool = false;
        let mut PreferFirstR: bool = false;
        if !canEmitConjunctionForCCMP(DAG, O1, CanNegateR, MustBeFirstR, PreferFirstR, IsOR, Depth + 1) {
            return false;
        }
        if MustBeFirstL && MustBeFirstR {
            return false;
        }
        if IsOR {
            if !CanNegateL && !CanNegateR {
                return false;
            }
            CanNegate = WillNegate && CanNegateL && CanNegateR;
            MustBeFirst = !CanNegate;
        } else {
            assert!(Opcode == AND, "Must be OR or AND");
            CanNegate = false;
            MustBeFirst = MustBeFirstL || MustBeFirstR;
        }
        PreferFirst = PreferFirstL || PreferFirstR;
        return true;
    }
    return false;
}

fn emitConjunctionForCCMPRec(Val: SDValue, OutCC: *mut CondCode, Negate: bool, CCOp: SDValue, Predicate: CondCode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = SDLoc { Val };
    let mut Opcode: u32 = Val.getOpcode();
    if Opcode == SETCC {
        let mut LHS: SDValue = Val.getOperand(0);
        let mut RHS: SDValue = Val.getOperand(1);
        let mut CC: CondCode = cast(Val.getOperand(2))();
        if Negate {
            CC = getSetCCInverse(CC, LHS.getValueType());
        }
        let mut X86CC: CondCode = TranslateX86CC(CC, DL, false, LHS, RHS, DAG);
        assert!(X86CC != COND_INVALID);
        OutCC = X86CC;
        if !CCOp {
            return EmitCmp(LHS, RHS, X86CC, DL, DAG, Subtarget);
        }
        let mut DCFCode: CondCode = GetOppositeBranchCondition(X86CC);
        let mut CFlags: SDValue = DAG.getTargetConstant(getCCMPCondFlagsFromCondCode(DCFCode), DL, EVT { i8 }, false);
        let mut SrcCC: SDValue = DAG.getTargetConstant(Predicate, DL, EVT { i8 }, false);
        if isNullConstant(RHS) {
            let mut Op0: SDValue = LHS;
            let mut Op1: SDValue = LHS;
            if LHS.getOpcode() == AND {
                Op0 = LHS.getOperand(0);
                Op1 = LHS.getOperand(1);
            }
            return DAG;
        }
        if X86CC == COND_E || X86CC == COND_NE {
            let mut XorVTs: SDVTList = DAG.getVTList(LHS.getValueType());
            let mut Xor: *mut SDNode = DAG;
            if !Xor {
                Xor = DAG;
            }
            if Xor && Xor.hasAnyUseOfValue(0) {
                let mut XorVal: SDValue = SDValue { Node: Xor, ResNo: 0 };
                return DAG;
            }
        }
        return DAG;
    }
    assert!(Val.hasOneUse(), "Valid conjunction/disjunction tree");
    let mut IsOR: bool = Opcode == OR;
    let mut LHS: SDValue = Val.getOperand(0);
    let mut CanNegateL: bool = false;
    let mut MustBeFirstL: bool = false;
    let mut PreferFirstL: bool = false;
    let mut ValidL: bool = canEmitConjunctionForCCMP(DAG, LHS, CanNegateL, MustBeFirstL, PreferFirstL, IsOR, 0);
    assert!(ValidL, "Valid conjunction/disjunction tree");
    ValidL as void;
    let mut RHS: SDValue = Val.getOperand(1);
    let mut CanNegateR: bool = false;
    let mut MustBeFirstR: bool = false;
    let mut PreferFirstR: bool = false;
    let mut ValidR: bool = canEmitConjunctionForCCMP(DAG, RHS, CanNegateR, MustBeFirstR, PreferFirstR, IsOR, 0);
    assert!(ValidR, "Valid conjunction/disjunction tree");
    ValidR as void;
    let mut ShouldFirstL: bool = PreferFirstL && !PreferFirstR && !MustBeFirstR;
    if MustBeFirstL || ShouldFirstL {
        assert!(!MustBeFirstR, "Valid conjunction/disjunction tree");
        swap(LHS, RHS);
        swap(CanNegateL, CanNegateR);
        swap(MustBeFirstL, MustBeFirstR);
    }
    let mut NegateR: bool = false;
    let mut NegateAfterR: bool = false;
    let mut NegateL: bool = false;
    let mut NegateAfterAll: bool = false;
    if IsOR {
        if !CanNegateL {
            assert!(CanNegateR, "at least one side must be negatable");
            assert!(!MustBeFirstR, "invalid conjunction/disjunction tree");
            assert!(!Negate);
            swap(LHS, RHS);
            NegateR = false;
            NegateAfterR = true;
        } else {
            NegateR = CanNegateR;
            NegateAfterR = !CanNegateR;
        }
        NegateL = true;
        NegateAfterAll = !Negate;
    } else {
        assert!(Opcode == AND, "Valid conjunction/disjunction tree");
        assert!(!Negate, "Valid conjunction/disjunction tree");
        NegateL = false;
        NegateR = false;
        NegateAfterR = false;
        NegateAfterAll = false;
    }
    let mut RHSCC: CondCode = zeroed();
    let mut CmpR: SDValue = emitConjunctionForCCMPRec(RHS, RHSCC, NegateR, CCOp, Predicate, DAG, Subtarget);
    if NegateAfterR {
        RHSCC = GetOppositeBranchCondition(RHSCC);
    }
    let mut CmpL: SDValue = emitConjunctionForCCMPRec(LHS, OutCC, NegateL, CmpR, RHSCC, DAG, Subtarget);
    if NegateAfterAll {
        OutCC = GetOppositeBranchCondition(OutCC);
    }
    return CmpL;
}

fn emitConjunctionForCCMP(Val: SDValue, OutCC: *mut CondCode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut DummyCanNegate: bool = false;
    let mut DummyMustBeFirst: bool = false;
    let mut DummyPreferFirst: bool = false;
    if !canEmitConjunctionForCCMP(DAG, Val, DummyCanNegate, DummyMustBeFirst, DummyPreferFirst, false, 0) {
        return SDValue {};
    }
    return emitConjunctionForCCMPRec(Val, OutCC, false, SDValue {}, COND_INVALID, DAG, Subtarget);
}

fn X86TargetLowering::LowerSELECT(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut AddTest: bool = true;
    let mut Cond: SDValue = Op.getOperand(0);
    let mut Op1: SDValue = Op.getOperand(1);
    let mut Op2: SDValue = Op.getOperand(2);
    let mut DL: SDLoc = SDLoc { Op };
    let mut VT: MVT = Op1.getSimpleValueType();
    let mut CC: SDValue = SDValue {};
    if isBF16orSoftF16(VT, self.Subtarget) {
        let mut NVT: MVT = VT.changeTypeToInteger();
        return DAG.getBitcast(EVT { VT }, DAG.getNode(SELECT, DL, EVT { NVT }, Cond, DAG.getBitcast(EVT { NVT }, Op1), DAG.getBitcast(EVT { NVT }, Op2)));
    }
    if Cond.getOpcode() == SETCC && self.isScalarFPTypeInSSEReg(EVT { VT }) && VT == Cond.getOperand(0).getSimpleValueType() && operator(Cond).hasOneUse() {
        let mut CondOp0: SDValue = Cond.getOperand(0);
        let mut CondOp1: SDValue = Cond.getOperand(1);
        let mut IsAlwaysSignaling: bool = false;
        let mut SSECC: u32 = translateX86FSETCC(cast(Cond.getOperand(2))(), CondOp0, CondOp1, IsAlwaysSignaling);
        if self.Subtarget.hasAVX512() {
            let mut Cmp: SDValue = DAG;
            assert!(!VT.isVector(), "Not a scalar type?");
            return DAG;
        }
        if SSECC < 8 || self.Subtarget.hasAVX() {
            let mut Cmp: SDValue = DAG;
            if self.Subtarget.hasSSE41() && !isNullFPConstant(Op1) && !isNullFPConstant(Op2) {
                let mut VecVT: MVT = MVT { SimpleTy: if VT == f32 { v4f32 } else { v2f64 } };
                let mut VOp1: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { VecVT }, Op1);
                let mut VOp2: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { VecVT }, Op2);
                let mut VCmp: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { VecVT }, Cmp);
                let mut VCmpVT: MVT = MVT { SimpleTy: if VT == f32 { v4i32 } else { v2i64 } };
                VCmp = DAG.getBitcast(EVT { VCmpVT }, VCmp);
                let mut VSel: SDValue = DAG.getSelect(DL, EVT { VecVT }, VCmp, VOp1, VOp2, SDNodeFlags { Flags: None });
                return DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { VT }, VSel, DAG.getVectorIdxConstant(0, DL, false));
            }
            let mut AndN: SDValue = DAG;
            let mut And: SDValue = DAG;
            return DAG;
        }
    }
    if self.isScalarFPTypeInSSEReg(EVT { VT }) && self.Subtarget.hasAVX512() {
        let mut Cmp: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v1i1 }, Cond);
        return DAG;
    }
    if self.Subtarget() && !VT.isVector() && (Cond.getOpcode() == AND || Cond.getOpcode() == OR) {
        let mut CCMPOutCC: CondCode = zeroed();
        if emitConjunctionForCCMP(Cond, CCMPOutCC, DAG, self.Subtarget) {
            Flags;
        } else {
            let mut X86CC: SDValue = DAG.getTargetConstant(CCMPOutCC, DL, EVT { i8 }, false);
            Cond = DAG;
            AddTest = false;
        }
    }
    if Cond.getOpcode() == SETCC && !isSoftF16(Cond.getOperand(0).getSimpleValueType(), self.Subtarget) {
        if self.LowerSETCC(Cond, DAG) {
            NewCond;
        } else {
            Cond = NewCond;
            Op1 = Op.getOperand(1);
            Op2 = Op.getOperand(2);
        }
    }
    if  {
        let mut Cmp: SDValue = Cond.getOperand(1);
        let mut CmpOp0: SDValue = Cmp.getOperand(0);
        let mut CondCode: u32 = Cond.getConstantOperandVal(0);
        let mut MatchFFSMinus1: Closure_116 = Closure_116 { CmpOp0: &mut CmpOp0 };
        if self.Subtarget.canUseCMOV() && (VT == i32 || VT == i64) && ((CondCode == COND_NE && MatchFFSMinus1.call(Op1, Op2)) || (CondCode == COND_E && MatchFFSMinus1.call(Op2, Op1))) {} else if LowerSELECTWithCmpZero(CmpOp0, Op1, Op2, CondCode, DL, DAG, self.Subtarget) {
            R;
        } else {
            return R;
        }
    }
    if  {
        Cond = Cond.getOperand(0);
    }
    if Cond.getOpcode() == AND && isOneConstant(Cond.getOperand(1)) {
        if LowerSELECTWithCmpZero(Cond, Op2, Op1, COND_E, DL, DAG, self.Subtarget) {
            R;
        } else {
            return R;
        }
    }
    let mut CondOpcode: u32 = Cond.getOpcode();
    if  {
        CC = Cond.getOperand(0);
        let mut Cmp: SDValue = Cond.getOperand(1);
        let mut IllegalFPCMov: bool = false;
        if VT.isFloatingPoint() && !VT.isVector() && !self.isScalarFPTypeInSSEReg(EVT { VT }) && self.Subtarget.canUseCMOV() {
            IllegalFPCMov = operator!(hasFPCMov(cast(CC)()));
        }
        if  {
            Cond = Cmp;
            AddTest = false;
        }
    } else if CondOpcode == USUBO || CondOpcode == SSUBO || CondOpcode == UADDO || CondOpcode == SADDO || CondOpcode == UMULO || CondOpcode == SMULO {
        let mut Value: SDValue = SDValue {};
        let mut X86Cond: CondCode = zeroed();
        tie(Value, Cond) = getX86XALUOOp(X86Cond, Cond.getValue(0), DAG);
        CC = DAG.getTargetConstant(X86Cond, DL, EVT { i8 }, false);
        AddTest = false;
    }
    if AddTest {
        if isTruncWithZeroHighBitsInput(Cond, DAG) {
            Cond = Cond.getOperand(0);
        }
        if Cond.getOpcode() == AND && Cond.hasOneUse() {
            let mut X86CondCode: CondCode = zeroed();
            if LowerAndToBT(Cond, SETNE, DL, DAG, X86CondCode) {
                BT;
            } else {
                CC = DAG.getTargetConstant(X86CondCode, DL, EVT { i8 }, false);
                Cond = BT;
                AddTest = false;
            }
        }
    }
    if AddTest {
        CC = DAG.getTargetConstant(COND_NE, DL, EVT { i8 }, false);
        Cond = EmitTest(Cond, COND_NE, DL, DAG, self.Subtarget);
    }
    if  {
        let mut CondCode: u32 = operator(CC).getAsZExtVal();
        if (CondCode == COND_AE || CondCode == COND_B) && (isAllOnesConstant(Op1) || isAllOnesConstant(Op2)) && (isNullConstant(Op1) || isNullConstant(Op2)) {
            let mut Res: SDValue = DAG;
            if isAllOnesConstant(Op1) != (CondCode == COND_B) {
                return DAG.getNOT(DL, Res, Res.getValueType());
            }
            return Res;
        }
    }
    if Op.getValueType() == EVT { i8 } && Op1.getOpcode() == TRUNCATE && Op2.getOpcode() == TRUNCATE {
        let mut T1: SDValue = Op1.getOperand(0);
        let mut T2: SDValue = Op2.getOperand(0);
        if T1.getValueType() == T2.getValueType() && T1.getOpcode() != CopyFromReg && T2.getOpcode() != CopyFromReg {
            let mut Cmov: SDValue = DAG;
            return DAG.getNode(TRUNCATE, DL, Op.getValueType(), Cmov);
        }
    }
    if (Op.getValueType() == EVT { i8 } && self.Subtarget.canUseCMOV()) || (Op.getValueType() == EVT { i16 } && !mayFoldLoad(Op1, self.Subtarget, false, false) && !mayFoldLoad(Op2, self.Subtarget, false, false)) {
        Op1 = DAG.getNode(ANY_EXTEND, DL, EVT { i32 }, Op1);
        Op2 = DAG.getNode(ANY_EXTEND, DL, EVT { i32 }, Op2);
        let mut Ops: [4]SDValue = [Op2, Op1, CC, Cond];
        let mut Cmov: SDValue = DAG;
        return DAG.getNode(TRUNCATE, DL, Op.getValueType(), Cmov);
    }
    let mut Ops: [4]SDValue = [Op2, Op1, CC, Cond];
    return DAG;
}

fn LowerSIGN_EXTEND_Mask(Op: SDValue, dl: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = operator(Op).getSimpleValueType(0);
    let mut In: SDValue = operator(Op).getOperand(0);
    let mut InVT: MVT = In.getSimpleValueType();
    assert!(InVT.getVectorElementType() == i1, "Unexpected input type!");
    let mut VTElt: MVT = VT.getVectorElementType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut ExtVT: MVT = VT;
    if operator!(Subtarget()()) && VTElt.getSizeInBits().operator unsigned long long() <= 16 {
        if NumElts == 16 && !Subtarget.canExtendTo512DQ() {
            return SplitAndExtendv16i1(Op.getOpcode(), VT, In, dl, DAG);
        }
        ExtVT = getVectorVT(MVT { SimpleTy: i32 }, NumElts);
    }
    let mut WideVT: MVT = ExtVT;
    if !ExtVT.is512BitVector() && operator!(Subtarget()()) {
        NumElts *= 512 / ExtVT.getSizeInBits().operator unsigned long long();
        InVT = getVectorVT(MVT { SimpleTy: i1 }, NumElts);
        In = DAG.getNode(INSERT_SUBVECTOR, dl, EVT { InVT }, DAG.getUNDEF(EVT { InVT }), In, DAG.getVectorIdxConstant(0, dl, false));
        WideVT = getVectorVT(ExtVT.getVectorElementType(), NumElts);
    }
    let mut V: SDValue = SDValue {};
    let mut WideEltVT: MVT = WideVT.getVectorElementType();
    if (Subtarget()() && WideEltVT.getSizeInBits().operator unsigned long long() >= 32) || (Subtarget()() && WideEltVT.getSizeInBits().operator unsigned long long() <= 16) {
        V = DAG.getNode(Op.getOpcode(), dl, EVT { WideVT }, In);
    } else {
        let mut NegOne: SDValue = DAG.getAllOnesConstant(dl, EVT { WideVT }, false, false);
        let mut Zero: SDValue = DAG.getConstant(0, dl, EVT { WideVT }, false, false);
        V = DAG.getSelect(dl, EVT { WideVT }, In, NegOne, Zero, SDNodeFlags { Flags: None });
    }
    if VT != ExtVT {
        WideVT = getVectorVT(VTElt, NumElts);
        V = DAG.getNode(TRUNCATE, dl, EVT { WideVT }, V);
    }
    if WideVT != VT {
        V = DAG.getNode(EXTRACT_SUBVECTOR, dl, EVT { VT }, V, DAG.getVectorIdxConstant(0, dl, false));
    }
    return V;
}

fn LowerANY_EXTEND(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut In: SDValue = operator(Op).getOperand(0);
    let mut InVT: MVT = In.getSimpleValueType();
    let mut DL: SDLoc = SDLoc { Op };
    if InVT.getVectorElementType() == i1 {
        return LowerSIGN_EXTEND_Mask(Op, DL, Subtarget, DAG);
    }
    assert!(Subtarget.hasAVX(), "Expected AVX support");
    return LowerAVXExtend(Op, DL, DAG, Subtarget);
}

fn LowerEXTEND_VECTOR_INREG(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut In: SDValue = operator(Op).getOperand(0);
    let mut VT: MVT = operator(Op).getSimpleValueType(0);
    let mut InVT: MVT = In.getSimpleValueType();
    let mut SVT: MVT = VT.getVectorElementType();
    let mut InSVT: MVT = InVT.getVectorElementType();
    assert!(SVT.getFixedSizeInBits() > InSVT.getFixedSizeInBits();
    if SVT != i64 && SVT != i32 && SVT != i16 {
        return SDValue {};
    }
    if InSVT != i32 && InSVT != i16 && InSVT != i8 {
        return SDValue {};
    }
    if !(VT.is128BitVector() && Subtarget.hasSSE2()) && !(VT.is256BitVector() && Subtarget.hasAVX()) && !(VT.is512BitVector() && Subtarget.hasAVX512()) {
        return SDValue {};
    }
    let mut dl: SDLoc = SDLoc { Op };
    let mut Opc: u32 = Op.getOpcode();
    let mut NumElts: u32 = VT.getVectorNumElements();
    if InVT.getSizeInBits().operator unsigned long long() > 128 {
        let mut InSize: i32 = InSVT.getSizeInBits() * NumElts.operator unsigned long long();
        In = extractSubVector(In, 0, DAG, dl, max(InSize, 128));
        InVT = In.getSimpleValueType();
    }
    if Subtarget.hasInt256() {
        assert!(VT.getSizeInBits().operator unsigned long long() > 128, "Unexpected 128-bit vector extension");
        if InVT.getVectorNumElements() != NumElts {
            return DAG.getNode(Op.getOpcode(), dl, EVT { VT }, In);
        }
        let mut ExtOpc: u32 = if Opc == SIGN_EXTEND_VECTOR_INREG { SIGN_EXTEND } else { ZERO_EXTEND };
        return DAG.getNode(ExtOpc, dl, EVT { VT }, In);
    }
    if Subtarget.hasAVX() {
        assert!(VT.is256BitVector(), "256-bit vector expected");
        let mut HalfVT: MVT = VT.getHalfNumVectorElementsVT();
        let mut HalfNumElts: i32 = HalfVT.getVectorNumElements();
        let mut NumSrcElts: u32 = InVT.getVectorNumElements();
        let mut HiMask: SmallVector<int, 16> = SmallVector<int, 16> { NumSrcElts, SM_SentinelUndef };
        for let mut i: i32 = 0; i != HalfNumElts; i += 1 {
            HiMask[i] = HalfNumElts + i;
        }
        let mut Lo: SDValue = DAG.getNode(Opc, dl, EVT { HalfVT }, In);
        let mut Hi: SDValue = DAG.getVectorShuffle;
        Hi = DAG.getNode(Opc, dl, EVT { HalfVT }, Hi);
        return DAG.getNode(CONCAT_VECTORS, dl, EVT { VT }, Lo, Hi);
    }
    assert!(Opc == SIGN_EXTEND_VECTOR_INREG, "Unexpected opcode!");
    assert!(VT.is128BitVector() && InVT.is128BitVector(), "Unexpected VTs");
    let mut InNumElts: u32 = InVT.getVectorNumElements();
    let mut DemandedElts: APInt = getLowBitsSet(InNumElts, NumElts);
    if DAG.ComputeNumSignBits(In, DemandedElts, 0) == InVT.getScalarSizeInBits() {
        let mut Scale: u32 = InNumElts / NumElts;
        let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        for let mut I: u32 = 0; I != NumElts; I += 1 {
            ShuffleMask.append(Scale, I);
        }
        return DAG.getBitcast(EVT { VT }, DAG.getVectorShuffle);
    }
    let mut Curr: SDValue = In;
    let mut SignExt: SDValue = Curr;
    if InVT != v4i32 {
        let mut DestVT: MVT = if VT == v2i64 { MVT { SimpleTy: v4i32 } } else { VT };
        let mut DestWidth: u32 = DestVT.getScalarSizeInBits();
        let mut Scale: u32 = DestWidth / InSVT.getSizeInBits().operator unsigned long long();
        let mut DestElts: u32 = DestVT.getVectorNumElements();
        let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { InNumElts, SM_SentinelUndef };
        for let mut i: u32 = 0; i != DestElts; i += 1 {
            Mask[i * Scale + (Scale - 1)] = i;
        }
        Curr = DAG.getVectorShuffle;
        Curr = DAG.getBitcast(EVT { DestVT }, Curr);
        let mut SignExtShift: u32 = DestWidth - InSVT.getSizeInBits().operator unsigned long long();
        SignExt = getTargetVShiftByConstNode(dl, DestVT, Curr, SignExtShift, DAG);
    }
    if VT == v2i64 {
        assert!(Curr.getValueType() == EVT { v4i32 }, "Unexpected input VT");
        let mut Zero: SDValue = DAG.getConstant(0, dl, EVT { v4i32 }, false, false);
        let mut Sign: SDValue = DAG.getSetCC(dl, EVT { v4i32 }, Zero, Curr, SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
        SignExt = DAG.getVectorShuffle(EVT { v4i32 }, dl, SignExt, Sign, ArrayRef<int> { [0, 4, 1, 5] });
        SignExt = DAG.getBitcast(EVT { VT }, SignExt);
    }
    return SignExt;
}

fn LowerSIGN_EXTEND(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = operator(Op).getSimpleValueType(0);
    let mut In: SDValue = operator(Op).getOperand(0);
    let mut InVT: MVT = In.getSimpleValueType();
    let mut dl: SDLoc = SDLoc { Op };
    if InVT.getVectorElementType() == i1 {
        return LowerSIGN_EXTEND_Mask(Op, dl, Subtarget, DAG);
    }
    assert!(VT.isVector() && InVT.isVector(), "Expected vector type");
    assert!(VT.getVectorNumElements() == InVT.getVectorNumElements(), "Expected same number of elements");
    assert!((VT.getVectorElementType() == i16 || VT.getVectorElementType() == i32 || VT.getVectorElementType() == i64), "Unexpected element type");
    assert!((InVT.getVectorElementType() == i8 || InVT.getVectorElementType() == i16 || InVT.getVectorElementType() == i32), "Unexpected element type");
    if VT == v32i16 && operator!(Subtarget()()) {
        assert!(InVT == v32i8, "Unexpected VT!");
        return splitVectorIntUnary(Op, DAG, dl);
    }
    if Subtarget.hasInt256() {
        return Op;
    }
    let mut HalfVT: MVT = VT.getHalfNumVectorElementsVT();
    let mut OpLo: SDValue = DAG.getNode(SIGN_EXTEND_VECTOR_INREG, dl, EVT { HalfVT }, In);
    let mut NumElems: u32 = InVT.getVectorNumElements();
    let mut ShufMask: SmallVector<int, 8> = zeroed();
    for let mut i: u32 = 0; i != NumElems / 2; i += 1 {
        ShufMask()[i] = i + NumElems / 2;
    }
    let mut OpHi: SDValue = DAG.getVectorShuffle(InVT, dl, In, In);
    OpHi = DAG.getNode(SIGN_EXTEND_VECTOR_INREG, dl, EVT { HalfVT }, OpHi);
    return DAG.getNode(CONCAT_VECTORS, dl, EVT { VT }, OpLo, OpHi);
}

fn splitVectorStore(Store: *mut StoreSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut StoredVal: SDValue = Store.getValue();
    assert!((StoredVal.getValueType().is256BitVector() || StoredVal.getValueType().is512BitVector()), "Expecting 256/512-bit op");
    if !Store.isSimple() {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Store };
    let mut Value0: SDValue = SDValue {};
    let mut Value1: SDValue = SDValue {};
    tie(Value0, Value1) = splitVector(StoredVal, DAG, DL);
    let mut HalfOffset: u32 = Value0.getValueType().getStoreSize().operator unsigned long long();
    let mut Ptr0: SDValue = Store.getBasePtr();
    let mut Ptr1: SDValue = DAG.getMemBasePlusOffset(Ptr0, getFixed(HalfOffset), DL, SDNodeFlags { Flags: None });
    let mut Ch0: SDValue = DAG.getStore(Store.getChain(), DL, Value0, Ptr0, Store.getPointerInfo(), Store.getBaseAlign(), Store.getMemOperand().getFlags(), MMOMetadata {});
    let mut Ch1: SDValue = DAG.getStore(Store.getChain(), DL, Value1, Ptr1, Store.getPointerInfo().getWithOffset(HalfOffset), Store.getBaseAlign(), Store.getMemOperand().getFlags(), MMOMetadata {});
    return DAG.getNode(TokenFactor, DL, EVT { Other }, Ch0, Ch1);
}

fn scalarizeVectorStore(Store: *mut StoreSDNode, StoreVT: MVT, DAG: *mut SelectionDAG) -> SDValue {
    let mut StoredVal: SDValue = Store.getValue();
    assert!(StoreVT.is128BitVector() && StoredVal.getValueType().is128BitVector(), "Expecting 128-bit op");
    StoredVal = DAG.getBitcast(EVT { StoreVT }, StoredVal);
    if !Store.isSimple() {
        return SDValue {};
    }
    let mut StoreSVT: MVT = StoreVT.getScalarType();
    let mut NumElems: u32 = StoreVT.getVectorNumElements();
    let mut ScalarSize: u32 = StoreSVT.getStoreSize().operator unsigned long long();
    let mut DL: SDLoc = SDLoc { Store };
    let mut Stores: SmallVector<SDValue, 4> = zeroed();
    for let mut i: u32 = 0; i != NumElems; i += 1 {
        let mut Offset: u32 = i * ScalarSize;
        let mut Ptr: SDValue = DAG.getMemBasePlusOffset(Store.getBasePtr(), getFixed(Offset), DL, SDNodeFlags { Flags: None });
        let mut Scl: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { StoreSVT }, StoredVal, DAG.getVectorIdxConstant(i, DL, false));
        let mut Ch: SDValue = DAG.getStore(Store.getChain(), DL, Scl, Ptr, Store.getPointerInfo().getWithOffset(Offset), Store.getBaseAlign(), Store.getMemOperand().getFlags(), MMOMetadata {});
        Stores()(Ch);
    }
    return DAG(TokenFactor, DL, Other);
}

fn LowerStore(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut St: *mut StoreSDNode = cast(Op.getNode());
    let mut dl: SDLoc = SDLoc { St };
    let mut StoredVal: SDValue = St.getValue();
    if StoredVal.getValueType().isVector() && StoredVal.getValueType().getVectorElementType() == EVT { i1 } {
        let mut NumElts: u32 = StoredVal.getValueType().getVectorNumElements();
        assert!(NumElts <= 8, "Unexpected VT");
        assert!(!St.isTruncatingStore(), "Expected non-truncating store");
        (((operator!(operator!((Subtarget.hasAVX512() && operator!(Subtarget()()) && "Expected AVX512F without AVX512DQI")))) || (_wassert(L"Subtarget.hasAVX512() && !Subtarget.hasDQI() && \"Expected AVX512F without AVX512DQI\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (26489) as u32) , 0)) as void);
        StoredVal = DAG.getNode(INSERT_SUBVECTOR, dl, EVT { v16i1 }, DAG.getUNDEF(EVT { v16i1 }), StoredVal, DAG.getVectorIdxConstant(0, dl, false));
        StoredVal = DAG.getBitcast(EVT { i16 }, StoredVal);
        StoredVal = DAG.getNode(TRUNCATE, dl, EVT { i8 }, StoredVal);
        if NumElts < 8 {
            StoredVal = DAG.getZeroExtendInReg(StoredVal, dl, getIntegerVT(*DAG.getContext(), NumElts));
        }
        return DAG.getStore(St.getChain(), dl, StoredVal, St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
    }
    if St.isTruncatingStore() {
        return SDValue {};
    }
    let mut StoreVT: MVT = StoredVal.getSimpleValueType();
    if StoreVT.is256BitVector() || StoreVT.is512BitVector() {
        if StoredVal.hasOneUse() && isFreeToSplitVector(peekThroughOneUseBitcasts(StoredVal), DAG) {
            return splitVectorStore(St, DAG);
        }
        return SDValue {};
    }
    if StoreVT.is32BitVector() {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    assert!(StoreVT.is64BitVector(), "Unexpected VT");
    assert!(TLI == TypeWidenVector, "Unexpected type action!");
    let mut WideVT: EVT = TLI.getTypeToTransformTo;
    StoredVal = DAG.getNode(CONCAT_VECTORS, dl, WideVT, StoredVal, DAG.getUNDEF(EVT { StoreVT }));
    if Subtarget.hasSSE2() {
        let mut StVT: MVT = if Subtarget()() && StoreVT.isInteger() { i64 } else { f64 };
        let mut CastVT: MVT = getVectorVT(StVT, 2);
        StoredVal = DAG.getBitcast(EVT { CastVT }, StoredVal);
        StoredVal = DAG.getNode(EXTRACT_VECTOR_ELT, dl, EVT { StVT }, StoredVal, DAG.getVectorIdxConstant(0, dl, false));
        return DAG.getStore(St.getChain(), dl, StoredVal, St.getBasePtr(), St.getPointerInfo(), St.getBaseAlign(), St.getMemOperand().getFlags(), MMOMetadata {});
    }
    assert!(Subtarget.hasSSE1(), "Expected SSE");
    let mut Tys: SDVTList = DAG.getVTList(EVT { Other });
    let mut Ops: [3]SDValue = [St.getChain(), StoredVal, St.getBasePtr()];
    return DAG;
}

fn LowerLoad(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut RegVT: MVT = Op.getSimpleValueType();
    assert!(RegVT.isVector(), "We only custom lower vector loads.");
    assert!(RegVT.isInteger(), "We only custom lower integer vector loads.");
    let mut Ld: *mut LoadSDNode = cast(Op.getNode());
    let mut dl: SDLoc = SDLoc { Ld };
    if RegVT.getVectorElementType() == i1 {
        assert!(EVT { RegVT } == Ld.getMemoryVT(), "Expected non-extending load");
        assert!(RegVT.getVectorNumElements() <= 8, "Unexpected VT");
        (((operator!(operator!((Subtarget.hasAVX512() && operator!(Subtarget()()) && "Expected AVX512F without AVX512DQI")))) || (_wassert(L"Subtarget.hasAVX512() && !Subtarget.hasDQI() && \"Expected AVX512F without AVX512DQI\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (26577) as u32) , 0)) as void);
        let mut NewLd: SDValue = DAG.getLoad(EVT { i8 }, dl, Ld.getChain(), Ld.getBasePtr(), Ld.getPointerInfo(), MaybeAlign { Ld.getBaseAlign() }, Ld.getMemOperand().getFlags(), MMOMetadata {});
        assert!(operator(NewLd).getNumValues() == 2, "Loads must carry a chain!");
        let mut Val: SDValue = DAG.getNode(ANY_EXTEND, dl, EVT { i16 }, NewLd);
        Val = DAG.getNode(EXTRACT_SUBVECTOR, dl, EVT { RegVT }, DAG.getBitcast(EVT { v16i1 }, Val), DAG.getVectorIdxConstant(0, dl, false));
        return DAG.getMergeValues;
    }
    return SDValue {};
}

fn isAndOrOfSetCCs(Op: SDValue, Opc: *mut u32) -> bool {
    Opc = Op.getOpcode();
    if Opc != OR && Opc != AND {
        return false;
    }
}

fn X86TargetLowering::LowerConditionalBranch(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Chain: SDValue = Op.getOperand(0);
    let mut Cond: SDValue = Op.getOperand(1);
    let mut Dest: SDValue = SDValue {};
    if Op.getOpcode() == BRCOND {
        Dest = Op.getOperand(2);
    }
    let mut dl: SDLoc = SDLoc { Op };
    let mut GetLoweredBranch: Closure_117 = Closure_117 { Op: &mut Op, DAG: &mut DAG, dl: &mut dl, Chain: &mut Chain, Dest: &mut Dest };
    if Cond.getOpcode() == SETCC && Cond.getOperand(0).getValueType() != EVT { f128 } && !isSoftF16(Cond.getOperand(0).getValueType(), self.Subtarget) {
        let mut LHS: SDValue = Cond.getOperand(0);
        let mut RHS: SDValue = Cond.getOperand(1);
        let mut CC: CondCode = cast(Cond.getOperand(2))();
        if isOverflowIntrOpRes(LHS) && (CC == SETEQ || CC == SETNE) && (isNullConstant(RHS) || isOneConstant(RHS)) {
            let mut Value: SDValue = SDValue {};
            let mut Overflow: SDValue = SDValue {};
            let mut X86Cond: CondCode = zeroed();
            tie(Value, Overflow) = getX86XALUOOp(X86Cond, LHS.getValue(0), DAG);
            if (CC == SETEQ) == isNullConstant(RHS) {
                X86Cond = GetOppositeBranchCondition(X86Cond);
            }
            let mut CCVal: SDValue = DAG.getTargetConstant(X86Cond, dl, EVT { i8 }, false);
            return GetLoweredBranch(CCVal, Overflow);
        }
        if LHS.getSimpleValueType().isInteger() {
            let mut CCVal: SDValue = SDValue {};
            let mut EFLAGS: SDValue = self.emitFlagsForSetcc(LHS, RHS, CC, SDLoc { Cond }, DAG, CCVal);
            return GetLoweredBranch(CCVal, EFLAGS);
        }
        if CC == SETOEQ {
            if Op.getOpcode() == BRCOND && Op.getNode().hasOneUse() {
                let mut User: *mut SDNode = operator(Op.getNode().user_begin());
                if User.getOpcode() == BR {
                    let mut FalseBB: SDValue = User.getOperand(1);
                    let mut NewBR: *mut SDNode = DAG.UpdateNodeOperands(User, User.getOperand(0), Dest);
                    assert!(NewBR == User);
                    NewBR as void;
                    Dest = FalseBB;
                    let mut Cmp: SDValue = DAG;
                    let mut CCVal: SDValue = DAG.getTargetConstant(COND_NE, dl, EVT { i8 }, false);
                    Chain = GetLoweredBranch(CCVal, Cmp);
                    CCVal = DAG.getTargetConstant(COND_P, dl, EVT { i8 }, false);
                    return GetLoweredBranch(CCVal, Cmp);
                }
            }
        } else if CC == SETUNE {
            let mut Cmp: SDValue = DAG;
            let mut CCVal: SDValue = DAG.getTargetConstant(COND_NE, dl, EVT { i8 }, false);
            Chain = GetLoweredBranch(CCVal, Cmp);
            CCVal = DAG.getTargetConstant(COND_P, dl, EVT { i8 }, false);
            return GetLoweredBranch(CCVal, Cmp);
        } else {
            let mut X86Cond: CondCode = TranslateX86CC(CC, dl, true, LHS, RHS, DAG);
            let mut Cmp: SDValue = DAG;
            let mut CCVal: SDValue = DAG.getTargetConstant(X86Cond, dl, EVT { i8 }, false);
            return GetLoweredBranch(CCVal, Cmp);
        }
    }
    if isOverflowIntrOpRes(Cond) {
        let mut Value: SDValue = SDValue {};
        let mut Overflow: SDValue = SDValue {};
        let mut X86Cond: CondCode = zeroed();
        tie(Value, Overflow) = getX86XALUOOp(X86Cond, Cond.getValue(0), DAG);
        let mut CCVal: SDValue = DAG.getTargetConstant(X86Cond, dl, EVT { i8 }, false);
        return GetLoweredBranch(CCVal, Overflow);
    }
    if isTruncWithZeroHighBitsInput(Cond, DAG) {
        Cond = Cond.getOperand(0);
    }
    let mut CondVT: EVT = Cond.getValueType();
    if !(Cond.getOpcode() == AND && isOneConstant(Cond.getOperand(1))) {
        Cond = DAG.getNode(AND, dl, CondVT, Cond, DAG.getConstant(1, dl, CondVT, false, false));
    }
    let mut LHS: SDValue = Cond;
    let mut RHS: SDValue = DAG.getConstant(0, dl, CondVT, false, false);
    let mut CCVal: SDValue = SDValue {};
    let mut EFLAGS: SDValue = self.emitFlagsForSetcc(LHS, RHS, SETNE, dl, DAG, CCVal);
    return GetLoweredBranch(CCVal, EFLAGS);
}

fn X86TargetLowering::LowerDYNAMIC_STACKALLOC(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut SplitStack: bool = MF.shouldSplitStack();
    let mut EmitStackProbeCall: bool = self.hasStackProbeSymbol(MF);
    let mut Lower: bool = (self.Subtarget.isOSWindows() && !self.Subtarget.isTargetMachO()) || SplitStack || EmitStackProbeCall;
    let mut dl: SDLoc = SDLoc { Op };
    let mut Node: *mut SDNode = Op.getNode();
    let mut Chain: SDValue = Op.getOperand(0);
    let mut Size: SDValue = Op.getOperand(1);
    let mut Alignment: MaybeAlign = MaybeAlign { Op.getConstantOperandVal(2) };
    let mut VT: EVT = Node.getValueType(0);
    Chain = DAG.getCALLSEQ_START(Chain, 0, 0, dl);
    let mut Is64Bit: bool = self.Subtarget();
    let mut SPTy: MVT = Op.getValueType().getSimpleVT();
    let mut Result: SDValue = SDValue {};
    if !Lower {
        let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
        let mut SPReg: Register = TLI.getStackPointerRegisterToSaveRestore;
        assert!(SPReg.operator unsigned int(), "Target cannot require DYNAMIC_STACKALLOC expansion and not tell us which reg is the stack pointer!");
        let mut TFI: *TargetFrameLowering = *self.Subtarget.getFrameLowering();
        let mut StackAlign: Align = TFI.getStackAlign();
        if self.hasInlineStackProbe(MF) {
            Result = DAG;
            Chain = Result.getValue(1);
        } else {
            let mut SP: SDValue = DAG.getCopyFromReg(Chain, dl, SPReg, VT);
            Chain = SP.getValue(1);
            Result = DAG.getNode(SUB, dl, VT, SP, Size);
        }
        if Alignment && operator(Alignment) > StackAlign {
            Result = DAG.getNode(AND, dl, VT, Result, DAG.getSignedConstant(~(operator(Alignment).value() - 1), dl, VT, false, false));
        }
        Chain = DAG.getCopyToReg(Chain, dl, SPReg, Result);
    } else if SplitStack {
        if Is64Bit {
            let mut F: *Function = MF.getFunction();
            for A in F.args() {
                if A.hasNestAttr() {
                    report_fatal_error("Cannot use segmented stacks with functions that have nested arguments.", true);
                }
            }
        }
        Result = DAG;
        Chain = Result.getValue(1);
    } else {
        let mut NodeTys: SDVTList = DAG.getVTList(EVT { Other }, EVT { Glue });
        Chain = DAG;
        MF(true);
        let mut RegInfo: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
        let mut SPReg: Register = RegInfo.getStackRegister();
        let mut SP: SDValue = DAG.getCopyFromReg(Chain, dl, SPReg, EVT { SPTy });
        Chain = SP.getValue(1);
        if Alignment {
            SP = DAG.getNode(AND, dl, VT, SP.getValue(0), DAG.getSignedConstant(~(operator(Alignment).value() - 1), dl, VT, false, false));
            Chain = DAG.getCopyToReg(Chain, dl, SPReg, SP);
        }
        Result = SP;
    }
    Chain = DAG.getCALLSEQ_END(Chain, 0, 0, SDValue {}, dl);
    let mut Ops: [2]SDValue = [Result, Chain];
    return DAG.getMergeValues;
}

fn X86TargetLowering::LowerVASTART(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut Ptr: SDValue = Op.getOperand(1);
    let mut PtrVT: EVT = Ptr.getValueType();
    let mut FuncInfo: *mut X86MachineFunctionInfo = MF;
    let mut SV: *Value = cast(Op.getOperand(2))();
    let mut DL: SDLoc = SDLoc { Op };
    if operator!(self.Subtarget()) || self.Subtarget.isCallingConvWin64(MF.getFunction().getCallingConv()) {
        let mut FR: SDValue = DAG.getFrameIndex(FuncInfo.getVarArgsFrameIndex(), PtrVT, false);
        return DAG.getStore(Op.getOperand(0), DL, FR, Ptr, MachinePointerInfo { SV, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    }
    let mut MemOps: SmallVector<SDValue, 8> = zeroed();
    let mut FIN: SDValue = Op.getOperand(1);
    let mut Store: SDValue = DAG.getStore(Op.getOperand(0), DL, DAG.getConstant(FuncInfo.getVarArgsGPOffset(), DL, EVT { i32 }, false, false), FIN, MachinePointerInfo { SV, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    MemOps()(Store);
    FIN = DAG.getMemBasePlusOffset(FIN, getFixed(4), DL, SDNodeFlags { Flags: None });
    Store = DAG.getStore(Op.getOperand(0), DL, DAG.getConstant(FuncInfo.getVarArgsFPOffset(), DL, EVT { i32 }, false, false), FIN, MachinePointerInfo { SV, 4, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    MemOps()(Store);
    FIN = DAG.getNode(ADD, DL, PtrVT, FIN, DAG.getIntPtrConstant(4, DL, false));
    let mut OVFIN: SDValue = DAG.getFrameIndex(FuncInfo.getVarArgsFrameIndex(), PtrVT, false);
    Store = DAG.getStore(Op.getOperand(0), DL, OVFIN, FIN, MachinePointerInfo { SV, 8, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    MemOps()(Store);
    FIN = DAG.getNode(ADD, DL, PtrVT, FIN, DAG.getIntPtrConstant(if self.Subtarget.isTarget64BitLP64() { 8 } else { 4 }, DL, false));
    let mut RSFIN: SDValue = DAG.getFrameIndex(FuncInfo.getRegSaveFrameIndex(), PtrVT, false);
    Store = DAG.getStore(Op.getOperand(0), DL, RSFIN, FIN, MachinePointerInfo { SV, if self.Subtarget.isTarget64BitLP64() { 16 } else { 12 }, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    MemOps()(Store);
    return DAG(TokenFactor, DL, Other);
}

fn X86TargetLowering::LowerVAARG(self: *X86TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    (((operator!(operator!((self.Subtarget() && "LowerVAARG only handles 64-bit va_arg!")))) || (_wassert(L"Subtarget.is64Bit() && \"LowerVAARG only handles 64-bit va_arg!\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (26883) as u32) , 0)) as void);
    assert!(Op.getNumOperands() == 4);
