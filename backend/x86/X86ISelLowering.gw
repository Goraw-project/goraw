unsafe fn Closure_85::call(self: *mut Closure_85, NumSublanes: i32, SameMask: *mut bool) -> auto {
        let mut NumSublanesPerLane: i32 = NumSublanes / (*self.NumLanes);
        let mut NumEltsPerSublane: i32 = (*self.NumElts) / NumSublanes;
        let mut CrossLaneMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        let mut InLaneMask: SmallVector<int, 16> = SmallVector<int, 16> { (*self.NumElts), SM_SentinelUndef };
        let mut CrossLaneMaskLarge: SmallVector<int, 16> = SmallVector<int, 16> { NumSublanes, SM_SentinelUndef };
        let mut DemandedCrossLane: APInt = getZero((*self.NumElts));
        for let mut i: i32 = 0; i != (*self.NumElts); i += 1 {
            let mut M: i32 = (*self.Mask)[i];
            if M < 0 {
                continue;
            }
            let mut SrcSublane: i32 = M / NumEltsPerSublane;
            let mut DstLane: i32 = i / (*self.NumEltsPerLane);
            let mut Found: bool = false;
            let mut DstSubStart: i32 = DstLane * NumSublanesPerLane;
            let mut DstSubEnd: i32 = DstSubStart + NumSublanesPerLane;
            for let mut DstSublane: i32 = DstSubStart; DstSublane < DstSubEnd; DstSublane += 1 {
                if !isUndefOrEqual(CrossLaneMaskLarge[DstSublane], SrcSublane) {
                    continue;
                }
                Found = true;
                CrossLaneMaskLarge[DstSublane] = SrcSublane;
                let mut DstSublaneOffset: i32 = DstSublane * NumEltsPerSublane;
                InLaneMask[i] = DstSublaneOffset + M % NumEltsPerSublane;
                DemandedCrossLane.setBit(InLaneMask[i]);
                break;
            }
            if !Found {
                return SDValue {};
            }
        }
        narrowShuffleMaskElts(NumEltsPerSublane, CrossLaneMaskLarge, CrossLaneMask);
        if !(*self.CanUseSublanes) {
            let mut NumIdentityLanes: i32 = 0;
            let mut OnlyShuffleLowestLane: bool = true;
            for let mut i: i32 = 0; i != (*self.NumLanes); i += 1 {
                let mut LaneOffset: i32 = i * (*self.NumEltsPerLane);
                if isSequentialOrUndefInRange(InLaneMask, LaneOffset, (*self.NumEltsPerLane), i * (*self.NumEltsPerLane), 1) {
                    NumIdentityLanes += 1;
                } else if CrossLaneMask[LaneOffset] != 0 {
                    OnlyShuffleLowestLane = false;
                }
            }
            if OnlyShuffleLowestLane && NumIdentityLanes == ((*self.NumLanes) - 1) {
                return SDValue {};
            }
        }
        if (*self.V1).hasOneUse() {
            for let mut i: i32 = 0; i != (*self.NumElts); i += 1 {
                if !DemandedCrossLane[i] {
                    CrossLaneMask[i] = SM_SentinelUndef;
                }
            }
        }
        if CrossLaneMask == (*self.Mask) {
            SameMask = true;
            return SDValue {};
        }
        if InLaneMask == (*self.Mask) {
            return SDValue {};
        }
        let mut CrossLane: SDValue = (*self.DAG).getVectorShuffle((*self.VT), (*self.DL), (*self.V1), (*self.V2), CrossLaneMask);
        return (*self.DAG).getVectorShuffle((*self.VT), (*self.DL), CrossLane, (*self.DAG).getUNDEF((*self.VT)), InLaneMask);
    }

