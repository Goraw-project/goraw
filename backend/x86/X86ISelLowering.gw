fn combineSetCCAtomicArith(Cmp: SDValue, CC: *mut CondCode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if  {
        return SDValue {};
    }
    if !Cmp.hasOneUse() {
        return SDValue {};
    }
    let mut CmpLHS: SDValue = Cmp.getOperand(0);
    let mut CmpRHS: SDValue = Cmp.getOperand(1);
