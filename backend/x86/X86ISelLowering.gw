fn getMOVMSK(DL: *SDLoc, V: SDValue, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut InVT: MVT = V.getSimpleValueType();
    if InVT == v64i8 {
        let mut Lo: SDValue = SDValue {};
        let mut Hi: SDValue = SDValue {};
        tie(Lo, Hi) = DAG.SplitVector(V, DL);
        Lo = getMOVMSK(DL, Lo, DAG, Subtarget);
        Hi = getMOVMSK(DL, Hi, DAG, Subtarget);
        Lo = DAG.getNode(ZERO_EXTEND, DL, EVT { i64 }, Lo);
        Hi = DAG.getNode(ANY_EXTEND, DL, EVT { i64 }, Hi);
        Hi = DAG.getNode(SHL, DL, EVT { i64 }, Hi, DAG.getConstant(32, DL, EVT { i8 }, false, false));
        return DAG.getNode(OR, DL, EVT { i64 }, Lo, Hi);
    }
    if InVT == v32i8 && !Subtarget.hasInt256() {
        let mut Lo: SDValue = SDValue {};
        let mut Hi: SDValue = SDValue {};
        tie(Lo, Hi) = DAG.SplitVector(V, DL);
        Lo = DAG;
        Hi = DAG;
        Hi = DAG.getNode(SHL, DL, EVT { i32 }, Hi, DAG.getConstant(16, DL, EVT { i8 }, false, false));
        return DAG.getNode(OR, DL, EVT { i32 }, Lo, Hi);
    }
    assert!(((InVT == v16i8 || InVT == v4i32 || InVT == v2i64 || InVT == v4f32 || InVT == v2f64) || (Subtarget.hasAVX() && (InVT == v8i32 || InVT == v4i64 || InVT == v8f32 || InVT == v4f64)) || (Subtarget.hasInt256() && InVT == v32i8)), "Unexpected MOVMSK type");
    return DAG;
}

fn LowerBITCAST(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut Src: SDValue = Op.getOperand(0);
    let mut SrcVT: MVT = Src.getSimpleValueType();
    let mut DstVT: MVT = Op.getSimpleValueType();
    if SrcVT == i64 && DstVT == v64i1 {
        (((operator!(operator!((operator!(Subtarget()()) && "Expected 32-bit mode")))) || (_wassert(L"!Subtarget.is64Bit() && \"Expected 32-bit mode\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (33493) as u32) , 0)) as void);
        (((operator!(operator!((Subtarget()() && "Expected BWI target")))) || (_wassert(L"Subtarget.hasBWI() && \"Expected BWI target\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (33494) as u32) , 0)) as void);
        let mut dl: SDLoc = SDLoc { Op };
        let mut Lo: SDValue = SDValue {};
        let mut Hi: SDValue = SDValue {};
        tie(Lo, Hi) = DAG.SplitScalar(Src, dl, EVT { i32 }, EVT { i32 });
        Lo = DAG.getBitcast(EVT { v32i1 }, Lo);
        Hi = DAG.getBitcast(EVT { v32i1 }, Hi);
        return DAG.getNode(CONCAT_VECTORS, dl, EVT { v64i1 }, Lo, Hi);
    }
    if (SrcVT == v16i1 || SrcVT == v32i1) && DstVT.isScalarInteger() {
        assert!(!Subtarget.hasAVX512(), "Should use K-registers with AVX512");
        let mut SExtVT: MVT = MVT { SimpleTy: if SrcVT == v16i1 { v16i8 } else { v32i8 } };
        let mut DL: SDLoc = SDLoc { Op };
        let mut V: SDValue = DAG.getSExtOrTrunc(Src, DL, EVT { SExtVT });
        V = getMOVMSK(DL, V, DAG, Subtarget);
        return DAG.getZExtOrTrunc(V, DL, EVT { DstVT });
    }
    assert!((SrcVT == v2i32 || SrcVT == v4i16 || SrcVT == v8i8 || SrcVT == i64), "Unexpected VT!");
    assert!(Subtarget.hasSSE2(), "Requires at least SSE2!");
    if !(DstVT == f64 && SrcVT == i64) && !(DstVT == x86mmx && SrcVT.isVector()) {
        return SDValue {};
    }
    let mut dl: SDLoc = SDLoc { Op };
    if SrcVT.isVector() {
        let mut NewVT: MVT = getVectorVT(SrcVT.getVectorElementType(), SrcVT.getVectorNumElements() * 2);
        Src = DAG.getNode(CONCAT_VECTORS, dl, EVT { NewVT }, Src, DAG.getUNDEF(EVT { SrcVT }));
    } else {
        (((operator!(operator!((SrcVT == i64 && operator!(Subtarget()()) && "Unexpected source type in LowerBITCAST")))) || (_wassert(L"SrcVT == MVT::i64 && !Subtarget.is64Bit() && \"Unexpected source type in LowerBITCAST\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (33532) as u32) , 0)) as void);
        Src = DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { v2i64 }, Src);
    }
    let mut V2X64VT: MVT = MVT { SimpleTy: if DstVT == f64 { v2f64 } else { v2i64 } };
    Src = DAG.getNode(BITCAST, dl, EVT { V2X64VT }, Src);
    if DstVT == x86mmx {
        return DAG;
    }
    return DAG.getNode(EXTRACT_VECTOR_ELT, dl, EVT { DstVT }, Src, DAG.getVectorIdxConstant(0, dl, false));
}

fn LowerHorizontalByteSum(V: SDValue, VT: MVT, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { V };
    let mut ByteVecVT: MVT = V.getSimpleValueType();
    let mut EltVT: MVT = VT.getVectorElementType();
    assert!(ByteVecVT.getVectorElementType() == i8, "Expected value to have byte element type.");
    assert!(EltVT != i8, "Horizontal byte sum only makes sense for wider elements!");
    let mut VecSize: u32 = VT.getSizeInBits().operator unsigned long long();
    assert!(ByteVecVT.getSizeInBits().operator unsigned long long() == VecSize, "Cannot change vector size!");
    if EltVT == i64 {
        let mut Zeros: SDValue = DAG.getConstant(0, DL, EVT { ByteVecVT }, false, false);
        let mut SadVecVT: MVT = getVectorVT(MVT { SimpleTy: i64 }, VecSize / 64);
        V = DAG;
        return DAG.getBitcast(EVT { VT }, V);
    }
    if EltVT == i32 {
        let mut Zeros: SDValue = DAG.getConstant(0, DL, EVT { VT }, false, false);
        let mut V32: SDValue = DAG.getBitcast(EVT { VT }, V);
        let mut Low: SDValue = getUnpackl(DAG, DL, EVT { VT }, V32, Zeros);
        let mut High: SDValue = getUnpackh(DAG, DL, EVT { VT }, V32, Zeros);
        Zeros = DAG.getConstant(0, DL, EVT { ByteVecVT }, false, false);
        let mut SadVecVT: MVT = getVectorVT(MVT { SimpleTy: i64 }, VecSize / 64);
        Low = DAG;
        High = DAG;
        let mut ShortVecVT: MVT = getVectorVT(MVT { SimpleTy: i16 }, VecSize / 16);
        V = DAG;
        return DAG.getBitcast(EVT { VT }, V);
    }
    assert!(EltVT == i16, "Unknown how to handle type");
    let mut ShifterV: SDValue = DAG.getConstant(8, DL, EVT { VT }, false, false);
    let mut Shl: SDValue = DAG.getNode(SHL, DL, EVT { VT }, DAG.getBitcast(EVT { VT }, V), ShifterV);
    V = DAG.getNode(ADD, DL, EVT { ByteVecVT }, DAG.getBitcast(EVT { ByteVecVT }, Shl), DAG.getBitcast(EVT { ByteVecVT }, V));
    return DAG.getNode(SRL, DL, EVT { VT }, DAG.getBitcast(EVT { VT }, V), ShifterV);
}

fn LowerVectorCTPOPInRegLUT(Op: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut EltVT: MVT = VT.getVectorElementType();
    let mut NumElts: i32 = VT.getVectorNumElements();
    EltVT as void;
    assert!(EltVT == i8, "Only vXi8 vector CTPOP lowering supported.");
    let mut LUT: [16]i32 = [0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4];
    let mut LUTVec: SmallVector<SDValue, 64> = zeroed();
    for let mut i: i32 = 0; i < NumElts; i += 1 {
        LUTVec()(DAG.getConstant(LUT[i % 16], DL, EVT { i8 }, false, false));
    }
    let mut InRegLUT: SDValue = DAG(VT, DL);
    let mut M0F: SDValue = DAG.getConstant(15, DL, EVT { VT }, false, false);
    let mut FourV: SDValue = DAG.getConstant(4, DL, EVT { VT }, false, false);
    let mut HiNibbles: SDValue = DAG.getNode(SRL, DL, EVT { VT }, Op, FourV);
    let mut LoNibbles: SDValue = DAG.getNode(AND, DL, EVT { VT }, Op, M0F);
    let mut HiPopCnt: SDValue = DAG;
    let mut LoPopCnt: SDValue = DAG;
    return DAG.getNode(ADD, DL, EVT { VT }, HiPopCnt, LoPopCnt);
}

fn LowerVectorCTPOP(Op: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    assert!((VT.is512BitVector() || VT.is256BitVector() || VT.is128BitVector()), "Unknown CTPOP type to handle");
    let mut Op0: SDValue = Op.getOperand(0);
    if Subtarget()() {
        let mut NumElems: u32 = VT.getVectorNumElements();
        assert!((VT.getVectorElementType() == i8 || VT.getVectorElementType() == i16), "Unexpected type");
        if NumElems < 16 || (NumElems == 16 && Subtarget.canExtendTo512DQ()) {
            let mut NewVT: MVT = getVectorVT(MVT { SimpleTy: i32 }, NumElems);
            Op = DAG.getNode(ZERO_EXTEND, DL, EVT { NewVT }, Op0);
            Op = DAG.getNode(CTPOP, DL, EVT { NewVT }, Op);
            return DAG.getNode(TRUNCATE, DL, EVT { VT }, Op);
        }
    }
    if VT.is256BitVector() && !Subtarget.hasInt256() {
        return splitVectorIntUnary(Op, DAG, DL);
    }
    if VT.is512BitVector() && operator!(Subtarget()()) {
        return splitVectorIntUnary(Op, DAG, DL);
    }
    if VT.getScalarType() != i8 {
        let mut ByteVT: MVT = getVectorVT(MVT { SimpleTy: i8 }, VT.getSizeInBits().operator unsigned long long() / 8);
        let mut ByteOp: SDValue = DAG.getBitcast(EVT { ByteVT }, Op0);
        let mut PopCnt8: SDValue = DAG.getNode(CTPOP, DL, EVT { ByteVT }, ByteOp);
        return LowerHorizontalByteSum(PopCnt8, VT, Subtarget, DAG);
    }
    if !Subtarget.hasSSSE3() {
        return SDValue {};
    }
    return LowerVectorCTPOPInRegLUT(Op0, DL, Subtarget, DAG);
}

fn LowerCTPOP(N: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = N.getSimpleValueType();
    let mut Op: SDValue = N.getOperand(0);
    let mut DL: SDLoc = SDLoc { N };
    if VT.isScalarInteger() {
        let mut Known: KnownBits = DAG.computeKnownBits(Op, 0);
        if Known.isConstant() {
            return DAG.getConstant(Known.getConstant().popcount(), DL, EVT { VT }, false, false);
        }
        let mut LZ: u32 = Known.countMinLeadingZeros();
        let mut TZ: u32 = Known.countMinTrailingZeros();
        assert!((LZ + TZ) < Known.getBitWidth(), "Illegal shifted mask");
        let mut ActiveBits: u32 = Known.getBitWidth() - LZ;
        let mut ShiftedActiveBits: u32 = Known.getBitWidth() - (LZ + TZ);
        if ShiftedActiveBits <= 2 {
            if ActiveBits > 2 {
                Op = DAG.getNode(SRL, DL, EVT { VT }, Op, DAG.getShiftAmountConstant(TZ, EVT { VT }, DL));
            }
            Op = DAG.getZExtOrTrunc(Op, DL, EVT { i32 });
            Op = DAG.getNode(SUB, DL, EVT { i32 }, Op, DAG.getNode(SRL, DL, EVT { i32 }, Op, DAG.getShiftAmountConstant(1, EVT { VT }, DL)));
            return DAG.getZExtOrTrunc(Op, DL, EVT { VT });
        }
        if ShiftedActiveBits <= 3 {
            if ActiveBits > 3 {
                Op = DAG.getNode(SRL, DL, EVT { VT }, Op, DAG.getShiftAmountConstant(TZ, EVT { VT }, DL));
            }
            Op = DAG.getZExtOrTrunc(Op, DL, EVT { i32 });
            Op = DAG.getNode(SHL, DL, EVT { i32 }, Op, DAG.getShiftAmountConstant(1, EVT { VT }, DL));
            Op = DAG.getNode(SRL, DL, EVT { i32 }, DAG.getConstant(59796, DL, EVT { i32 }, false, false), Op);
            Op = DAG.getNode(AND, DL, EVT { i32 }, Op, DAG.getConstant(3, DL, EVT { i32 }, false, false));
            return DAG.getZExtOrTrunc(Op, DL, EVT { VT });
        }
        if ShiftedActiveBits <= 4 && DAG.getTargetLoweringInfo().isTypeLegal {
            let mut LUT: SDValue = DAG.getConstant(4841987667533046032, DL, EVT { i64 }, false, false);
            if ActiveBits > 4 {
                Op = DAG.getNode(SRL, DL, EVT { VT }, Op, DAG.getShiftAmountConstant(TZ, EVT { VT }, DL));
            }
            Op = DAG.getZExtOrTrunc(Op, DL, EVT { i32 });
            Op = DAG.getNode(MUL, DL, EVT { i32 }, Op, DAG.getConstant(4, DL, EVT { i32 }, false, false));
            Op = DAG.getNode(SRL, DL, EVT { i64 }, LUT, DAG.getShiftAmountOperand(EVT { i64 }, Op));
            Op = DAG.getNode(AND, DL, EVT { i64 }, Op, DAG.getConstant(7, DL, EVT { i64 }, false, false));
            return DAG.getZExtOrTrunc(Op, DL, EVT { VT });
        }
        if ShiftedActiveBits <= 8 {
            let mut Mask11: SDValue = DAG.getConstant(286331153, DL, EVT { i32 }, false, false);
            if ActiveBits > 8 {
                Op = DAG.getNode(SRL, DL, EVT { VT }, Op, DAG.getShiftAmountConstant(TZ, EVT { VT }, DL));
            }
            Op = DAG.getZExtOrTrunc(Op, DL, EVT { i32 });
            Op = DAG.getNode(MUL, DL, EVT { i32 }, Op, DAG.getConstant(134480385, DL, EVT { i32 }, false, false));
            Op = DAG.getNode(SRL, DL, EVT { i32 }, Op, DAG.getShiftAmountConstant(3, EVT { i32 }, DL));
            Op = DAG.getNode(AND, DL, EVT { i32 }, Op, Mask11);
            Op = DAG.getNode(MUL, DL, EVT { i32 }, Op, Mask11);
            Op = DAG.getNode(SRL, DL, EVT { i32 }, Op, DAG.getShiftAmountConstant(28, EVT { i32 }, DL));
            return DAG.getZExtOrTrunc(Op, DL, EVT { VT });
        }
        return SDValue {};
    }
    assert!(VT.isVector(), "We only do custom lowering for vector population count.");
    return LowerVectorCTPOP(N, DL, Subtarget, DAG);
}

fn LowerBITREVERSE_XOP(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    let mut In: SDValue = Op.getOperand(0);
    let mut DL: SDLoc = SDLoc { Op };
    if !VT.isVector() {
        let mut VecVT: MVT = getVectorVT(VT, 128 / VT.getSizeInBits().operator unsigned long long());
        let mut Res: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { VecVT }, In);
        Res = DAG.getNode(BITREVERSE, DL, EVT { VecVT }, Res);
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { VT }, Res, DAG.getVectorIdxConstant(0, DL, false));
    }
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut ScalarSizeInBytes: i32 = VT.getScalarSizeInBits() / 8;
    if VT.is256BitVector() {
        return splitVectorIntUnary(Op, DAG, DL);
    }
    assert!(VT.is128BitVector(), "Only 128-bit vector bitreverse lowering supported.");
    let mut MaskElts: SmallVector<SDValue, 16> = zeroed();
    for let mut i: i32 = 0; i != NumElts; i += 1 {
        for let mut j: i32 = ScalarSizeInBytes - 1; j >= 0; j -= 1 {
            let mut SourceByte: i32 = 16 + (i * ScalarSizeInBytes) + j;
            let mut PermuteByte: i32 = SourceByte | (2 << 5);
            MaskElts()(DAG.getConstant(PermuteByte, DL, EVT { i8 }, false, false));
        }
    }
    let mut Mask: SDValue = DAG(v16i8, DL);
    let mut Res: SDValue = DAG.getBitcast(EVT { v16i8 }, In);
    Res = DAG;
    return DAG.getBitcast(EVT { VT }, Res);
}

fn LowerBITREVERSE(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    if Subtarget()() && !VT.is512BitVector() {
        return LowerBITREVERSE_XOP(Op, DAG);
    }
    (((operator!(operator!(((Subtarget.hasSSSE3() || Subtarget()() || Subtarget()()) && "SSSE3, GFNI, or BMM required for BITREVERSE")))) || (_wassert(L"(Subtarget.hasSSSE3() || Subtarget.hasGFNI() || Subtarget.hasBMM()) && \"SSSE3, GFNI, or BMM required for BITREVERSE\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (33849) as u32) , 0)) as void);
    let mut In: SDValue = Op.getOperand(0);
    let mut DL: SDLoc = SDLoc { Op };
    if VT.is512BitVector() && operator!(Subtarget()()) {
        return splitVectorIntUnary(Op, DAG, DL);
    }
    if VT.is256BitVector() && !Subtarget.hasInt256() {
        return splitVectorIntUnary(Op, DAG, DL);
    }
    if !VT.isVector() {
        assert!((VT == i32 || VT == i64 || VT == i16 || VT == i8), "Only tested for i8/i16/i32/i64");
        let mut VecVT: MVT = getVectorVT(VT, 128 / VT.getSizeInBits().operator unsigned long long());
        let mut Res: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { VecVT }, In);
        Res = DAG.getNode(BITREVERSE, DL, EVT { v16i8 }, DAG.getBitcast(EVT { v16i8 }, Res));
        Res = DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { VT }, DAG.getBitcast(EVT { VecVT }, Res), DAG.getVectorIdxConstant(0, DL, false));
        return if (VT == i8) { Res } else { DAG.getNode(BSWAP, DL, EVT { VT }, Res) };
    }
    assert!(VT.isVector() && VT.getSizeInBits().operator unsigned long long() >= 128);
    if VT.getScalarType() != i8 {
        let mut ByteVT: MVT = getVectorVT(MVT { SimpleTy: i8 }, VT.getSizeInBits().operator unsigned long long() / 8);
        let mut Res: SDValue = DAG.getNode(BSWAP, DL, EVT { VT }, In);
        Res = DAG.getBitcast(EVT { ByteVT }, Res);
        Res = DAG.getNode(BITREVERSE, DL, EVT { ByteVT }, Res);
        return DAG.getBitcast(EVT { VT }, Res);
    }
    assert!(VT.isVectorOf(MVT { SimpleTy: i8 }), "Only byte vector BITREVERSE supported");
    let mut NumElts: u32 = VT.getVectorNumElements();
    (((operator!(operator!((operator!(Subtarget()()) && "BMM should use Legal operation action")))) || (_wassert(L"!Subtarget.hasBMM() && \"BMM should use Legal operation action\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (33894) as u32) , 0)) as void);
    if Subtarget()() {
        let mut Matrix: SDValue = getGFNICtrlMask(BITREVERSE, DAG, DL, VT, 0);
        return DAG;
    }
    let mut NibbleMask: SDValue = DAG.getConstant(15, DL, EVT { VT }, false, false);
    let mut Lo: SDValue = DAG.getNode(AND, DL, EVT { VT }, In, NibbleMask);
    let mut Hi: SDValue = DAG.getNode(SRL, DL, EVT { VT }, In, DAG.getConstant(4, DL, EVT { VT }, false, false));
    let mut LoLUT: [16]i32 = [0, 128, 64, 192, 32, 160, 96, 224, 16, 144, 80, 208, 48, 176, 112, 240];
    let mut HiLUT: [16]i32 = [0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15];
    let mut LoMaskElts: SmallVector<SDValue, 16> = zeroed();
    let mut HiMaskElts: SmallVector<SDValue, 16> = zeroed();
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        LoMaskElts()(DAG.getConstant(LoLUT[i % 16], DL, EVT { i8 }, false, false));
        HiMaskElts()(DAG.getConstant(HiLUT[i % 16], DL, EVT { i8 }, false, false));
    }
    let mut LoMask: SDValue = DAG(VT, DL);
    let mut HiMask: SDValue = DAG(VT, DL);
    Lo = DAG;
    Hi = DAG;
    return DAG.getNode(OR, DL, EVT { VT }, Lo, Hi);
}

fn LowerCLMUL(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
