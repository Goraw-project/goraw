        Src = DAG.getNode(INSERT_SUBVECTOR, DL, EVT { v8i64 }, Tmp, Src, DAG.getVectorIdxConstant(0, DL, false));
        let mut Res: SDValue = SDValue {};
        let mut Chain: SDValue = SDValue {};
        if IsStrict {
            Res = DAG;
            Chain = Res.getValue(1);
        } else {
            Res = DAG.getNode(Op.getOpcode(), DL, EVT { WideVT }, Src);
        }
        Res = DAG.getNode(EXTRACT_SUBVECTOR, DL, EVT { VT }, Res, DAG.getVectorIdxConstant(0, DL, false));
        if IsStrict {
            return DAG.getMergeValues;
        }
        return Res;
    }
    let mut IsSigned: bool = operator(Op).getOpcode() == SINT_TO_FP || operator(Op).getOpcode() == STRICT_SINT_TO_FP;
    if VT != v4f32 || IsSigned {
        return SDValue {};
    }
    let mut Zero: SDValue = DAG.getConstant(0, DL, EVT { v4i64 }, false, false);
    let mut One: SDValue = DAG.getConstant(1, DL, EVT { v4i64 }, false, false);
    let mut Sign: SDValue = DAG.getNode(OR, DL, EVT { v4i64 }, DAG.getNode(SRL, DL, EVT { v4i64 }, Src, One), DAG.getNode(AND, DL, EVT { v4i64 }, Src, One));
    let mut IsNeg: SDValue = DAG.getSetCC(DL, EVT { v4i64 }, Src, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut SignSrc: SDValue = DAG.getSelect(DL, EVT { v4i64 }, IsNeg, Sign, Src, SDNodeFlags { Flags: None });
    let mut SignCvts: SmallVector<SDValue, 4> = zeroed();
    let mut Chains: SmallVector<SDValue, 4> = zeroed();
    for let mut i: i32 = 0; i != 4; i += 1 {
        let mut Elt: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, EVT { i64 }, SignSrc, DAG.getVectorIdxConstant(i, DL, false));
        if IsStrict {
            SignCvts()[i] = DAG;
            Chains()[i] = [i](1);
        } else {
            SignCvts()[i] = DAG.getNode(SINT_TO_FP, DL, EVT { f32 }, Elt);
        }
    }
    let mut SignCvt: SDValue = DAG(VT, DL);
    let mut Slow: SDValue = SDValue {};
    let mut Chain: SDValue = SDValue {};
    if IsStrict {
        Chain = DAG(TokenFactor, DL, Other);
        Slow = DAG;
        Chain = Slow.getValue(1);
    } else {
        Slow = DAG.getNode(FADD, DL, EVT { v4f32 }, SignCvt, SignCvt);
    }
    IsNeg = DAG.getNode(TRUNCATE, DL, EVT { v4i32 }, IsNeg);
