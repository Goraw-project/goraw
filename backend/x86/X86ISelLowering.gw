        self.setOperationAction(STRICT_FREM, f16, Promote);
        self.setOperationAction(SELECT_CC, f16, Expand);
        self.setOperationAction(BR_CC, f16, Expand);
        self.setOperationAction(STRICT_FROUND, f16, Promote);
        self.setOperationAction(FROUNDEVEN, f16, Legal);
        self.setOperationAction(STRICT_FROUNDEVEN, f16, Legal);
        self.setOperationAction(FP_ROUND, f16, Custom);
        self.setOperationAction(STRICT_FP_ROUND, f16, Custom);
        self.setOperationAction(FP_EXTEND, f32, Legal);
        self.setOperationAction(STRICT_FP_EXTEND, f32, Legal);
        self.setOperationAction(LRINT, f16, Legal);
        self.setOperationAction(LLRINT, f16, Legal);
        self.setCondCodeAction(SETOEQ, f16, Expand);
        self.setCondCodeAction(SETUNE, f16, Expand);
        if self.Subtarget.useAVX512Regs() {
            setGroup.call(v32f16);
            self.setOperationAction(SCALAR_TO_VECTOR, v32f16, Custom);
            self.setOperationAction(SINT_TO_FP, v32i16, Legal);
            self.setOperationAction(STRICT_SINT_TO_FP, v32i16, Legal);
            self.setOperationAction(UINT_TO_FP, v32i16, Legal);
            self.setOperationAction(STRICT_UINT_TO_FP, v32i16, Legal);
            self.setOperationAction(FP_ROUND, v16f16, Legal);
            self.setOperationAction(STRICT_FP_ROUND, v16f16, Legal);
            self.setOperationAction(FP_EXTEND, v16f32, Custom);
            self.setOperationAction(STRICT_FP_EXTEND, v16f32, Legal);
            self.setOperationAction(FP_EXTEND, v8f64, Custom);
            self.setOperationAction(STRICT_FP_EXTEND, v8f64, Legal);
            self.setOperationAction(INSERT_VECTOR_ELT, v32f16, Custom);
            self.setOperationAction(FP_TO_SINT, v32i16, Custom);
            self.setOperationAction(STRICT_FP_TO_SINT, v32i16, Custom);
            self.setOperationAction(FP_TO_UINT, v32i16, Custom);
            self.setOperationAction(STRICT_FP_TO_UINT, v32i16, Custom);
            self.setOperationPromotedToType(FP_TO_SINT, v32i8, v32i16);
            self.setOperationPromotedToType(STRICT_FP_TO_SINT, v32i8, v32i16);
            self.setOperationPromotedToType(FP_TO_UINT, v32i8, v32i16);
            self.setOperationPromotedToType(STRICT_FP_TO_UINT, v32i8, v32i16);
            self.setOperationPromotedToType(FP_TO_SINT, v32i1, v32i16);
            self.setOperationPromotedToType(STRICT_FP_TO_SINT, v32i1, v32i16);
            self.setOperationPromotedToType(FP_TO_UINT, v32i1, v32i16);
            self.setOperationPromotedToType(STRICT_FP_TO_UINT, v32i1, v32i16);
            self.setOperationAction(EXTRACT_SUBVECTOR, v16f16, Legal);
            self.setOperationAction(INSERT_SUBVECTOR, v32f16, Legal);
            self.setOperationAction(CONCAT_VECTORS, v32f16, Custom);
            self.setLoadExtAction(EXTLOAD, v8f64, v8f16, Legal);
            self.setLoadExtAction(EXTLOAD, v16f32, v16f16, Legal);
            SetFPMinMaxAction.call(v32f16);
            self.setOperationAction(LRINT, v32f16, Legal);
            self.setOperationAction(LLRINT, v8f16, Legal);
        }
        self.setOperationAction(FP_TO_SINT, v8i16, Custom);
        self.setOperationAction(STRICT_FP_TO_SINT, v8i16, Custom);
        self.setOperationAction(FP_TO_UINT, v8i16, Custom);
        self.setOperationAction(STRICT_FP_TO_UINT, v8i16, Custom);
        if self.Subtarget.hasVLX() {
            setGroup.call(v8f16);
            setGroup.call(v16f16);
            self.setOperationAction(SCALAR_TO_VECTOR, v8f16, Legal);
            self.setOperationAction(SCALAR_TO_VECTOR, v16f16, Custom);
            self.setOperationAction(SINT_TO_FP, v16i16, Legal);
            self.setOperationAction(STRICT_SINT_TO_FP, v16i16, Legal);
            self.setOperationAction(SINT_TO_FP, v8i16, Legal);
            self.setOperationAction(STRICT_SINT_TO_FP, v8i16, Legal);
            self.setOperationAction(UINT_TO_FP, v16i16, Legal);
            self.setOperationAction(STRICT_UINT_TO_FP, v16i16, Legal);
            self.setOperationAction(UINT_TO_FP, v8i16, Legal);
            self.setOperationAction(STRICT_UINT_TO_FP, v8i16, Legal);
            self.setOperationAction(FP_ROUND, v8f16, Legal);
            self.setOperationAction(STRICT_FP_ROUND, v8f16, Legal);
            self.setOperationAction(FP_EXTEND, v8f32, Custom);
            self.setOperationAction(STRICT_FP_EXTEND, v8f32, Legal);
            self.setOperationAction(FP_EXTEND, v4f64, Custom);
            self.setOperationAction(STRICT_FP_EXTEND, v4f64, Legal);
            self.setOperationAction(INSERT_VECTOR_ELT, v8f16, Custom);
            self.setOperationAction(INSERT_VECTOR_ELT, v16f16, Custom);
            self.setOperationAction(EXTRACT_SUBVECTOR, v8f16, Legal);
            self.setOperationAction(INSERT_SUBVECTOR, v16f16, Legal);
            self.setOperationAction(CONCAT_VECTORS, v16f16, Custom);
            self.setLoadExtAction(EXTLOAD, v4f64, v4f16, Legal);
            self.setLoadExtAction(EXTLOAD, v2f64, v2f16, Legal);
            self.setLoadExtAction(EXTLOAD, v8f32, v8f16, Legal);
            self.setLoadExtAction(EXTLOAD, v4f32, v4f16, Legal);
            self.setOperationAction(LOAD, v4f16, Custom);
            self.setOperationAction(STORE, v4f16, Custom);
            SetFPMinMaxAction.call(v8f16);
            SetFPMinMaxAction.call(v16f16);
            self.setOperationAction(LRINT, v8f16, Legal);
            self.setOperationAction(LRINT, v16f16, Legal);
        }
    }
    if !self.Subtarget.useSoftFloat() && (self.Subtarget.hasAVXNECONVERT() || self.Subtarget.hasBF16()) {
        self.addRegisterClass(v8bf16, if self.Subtarget.hasAVX512() { &mut VR128XRegClass } else { &mut VR128RegClass });
        self.addRegisterClass(v16bf16, if self.Subtarget.hasAVX512() { &mut VR256XRegClass } else { &mut VR256RegClass });
        self.setOperationAction(BUILD_VECTOR, bf16, Custom);
        for VT in [v8bf16, v16bf16] {
            setF16Action.call(VT, Expand);
            if !self.Subtarget.hasBF16() {
                self.setOperationAction(VSELECT, VT, Custom);
            }
            self.setOperationAction(BUILD_VECTOR, VT, Custom);
            self.setOperationAction(VECTOR_SHUFFLE, VT, Custom);
            self.setOperationAction(EXTRACT_SUBVECTOR, VT, Legal);
            self.setOperationAction(INSERT_SUBVECTOR, VT, Legal);
            self.setOperationAction(CONCAT_VECTORS, VT, Custom);
        }
        for Opc in [FADD, FSUB, FMUL, FDIV, FFLOOR, FCEIL, FTRUNC, FRINT, FNEARBYINT, FROUNDEVEN, FROUND] {
            self.setOperationPromotedToType(Opc, v8bf16, v8f32);
            self.setOperationPromotedToType(Opc, v16bf16, v16f32);
        }
        self.setOperationAction(SETCC, v8bf16, Custom);
        self.setOperationAction(SETCC, v16bf16, Custom);
        self.setOperationAction(FP_ROUND, v8bf16, Custom);
        self.addLegalFPImmediate(getZero(BFloat(), false));
    }
    if !self.Subtarget.useSoftFloat() && self.Subtarget.hasBF16() && self.Subtarget.useAVX512Regs() {
        self.addRegisterClass(v32bf16, &mut VR512RegClass);
        setF16Action.call(v32bf16, Expand);
        for Opc in [FADD, FSUB, FMUL, FDIV, FFLOOR, FCEIL, FTRUNC, FRINT, FNEARBYINT, FROUNDEVEN, FROUND] {
            self.setOperationPromotedToType(Opc, v32bf16, v32f32);
        }
        self.setOperationAction(SETCC, v32bf16, Custom);
        self.setOperationAction(BUILD_VECTOR, v32bf16, Custom);
        self.setOperationAction(FP_ROUND, v16bf16, Custom);
        self.setOperationAction(VECTOR_SHUFFLE, v32bf16, Custom);
        self.setOperationAction(INSERT_SUBVECTOR, v32bf16, Legal);
        self.setOperationAction(CONCAT_VECTORS, v32bf16, Custom);
    }
    if !self.Subtarget.useSoftFloat() && self.Subtarget.hasAVX10_2() {
        for VT in [v8i8, v16i8, v32i8] {
            self.setOperationAction(FP_TO_UINT_SAT, VT, Custom);
            self.setOperationAction(FP_TO_SINT_SAT, VT, Custom);
        }
        self.setOperationAction(FP_TO_UINT_SAT, v2i32, Custom);
        self.setOperationAction(FP_TO_SINT_SAT, v2i32, Custom);
        self.setOperationAction(FP_TO_UINT_SAT, v8i64, Legal);
        self.setOperationAction(FP_TO_SINT_SAT, v8i64, Legal);
        for VT in [i32, i64, v4i32, v8i32, v16i32, v2i64, v4i64] {
            if VT == i64 && !self.Subtarget.is64Bit() {
                continue;
            }
            self.setOperationAction(FP_TO_UINT_SAT, VT, Legal);
            self.setOperationAction(FP_TO_SINT_SAT, VT, Legal);
        }
        self.setOperationAction(FADD, bf16, Custom);
        self.setOperationAction(FSUB, bf16, Custom);
        self.setOperationAction(FMUL, bf16, Custom);
        self.setOperationAction(FDIV, bf16, Custom);
        self.setOperationAction(FSQRT, bf16, Custom);
        self.setOperationAction(FMA, bf16, Custom);
        self.setOperationAction(FROUNDEVEN, bf16, Custom);
        if self.Subtarget.useAVX512Regs() {
            self.setOperationAction(FADD, v32bf16, Legal);
            self.setOperationAction(FSUB, v32bf16, Legal);
            self.setOperationAction(FMUL, v32bf16, Legal);
            self.setOperationAction(FDIV, v32bf16, Legal);
            self.setOperationAction(FSQRT, v32bf16, Legal);
            self.setOperationAction(FMA, v32bf16, Legal);
            self.setOperationAction(SETCC, v32bf16, Custom);
            SetFPMinMaxAction.call(v32bf16);
            self.setOperationAction(FROUNDEVEN, v32bf16, Legal);
        }
        for VT in [v8bf16, v16bf16] {
            self.setOperationAction(FADD, VT, Legal);
            self.setOperationAction(FSUB, VT, Legal);
            self.setOperationAction(FMUL, VT, Legal);
            self.setOperationAction(FDIV, VT, Legal);
            self.setOperationAction(FSQRT, VT, Legal);
            self.setOperationAction(FMA, VT, Legal);
            self.setOperationAction(SETCC, VT, Custom);
            self.setOperationAction(FROUNDEVEN, VT, Legal);
            SetFPMinMaxAction.call(VT);
        }
        for VT in [f16, f32, f64] {
            self.setCondCodeAction(SETOEQ, VT, Custom);
            self.setCondCodeAction(SETUNE, VT, Custom);
        }
    }
    if !self.Subtarget.useSoftFloat() {
        let mut HasVNNI: bool = self.Subtarget.hasVNNI() || self.Subtarget.hasAVXVNNI();
        let mut HasVNNIINT8: bool = self.Subtarget.hasAVXVNNIINT8() || self.Subtarget.hasAVX10_2();
        let mut HasVNNIINT16: bool = self.Subtarget.hasAVXVNNIINT16() || self.Subtarget.hasAVX10_2();
        for AccVT in [v4i32, v8i32, v16i32] {
            if AccVT == v16i32 && !self.Subtarget.useAVX512Regs() {
                break;
            }
            let mut NumElts: u32 = AccVT.getVectorNumElements();
            let mut I8VT: MVT = getVectorVT(i8, NumElts * 4);
            let mut I16VT: MVT = getVectorVT(i16, NumElts * 2);
            let mut F32VT: MVT = getVectorVT(f32, NumElts);
            if HasVNNI {
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, AccVT, I8VT, Custom);
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_SMLA, AccVT, I16VT, Custom);
            }
            if HasVNNIINT8 {
                self.setPartialReduceMLAAction([PARTIAL_REDUCE_SMLA, PARTIAL_REDUCE_UMLA], AccVT, I8VT, Custom);
            }
            if HasVNNIINT16 {
                self.setPartialReduceMLAAction([PARTIAL_REDUCE_SUMLA, PARTIAL_REDUCE_UMLA], AccVT, I16VT, Custom);
            }
            if self.Subtarget.hasBF16() {
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, F32VT, getVectorVT(bf16, NumElts * 2), Custom);
            }
            if self.Subtarget.hasAVX10_2() {
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, F32VT, getVectorVT(f16, NumElts * 2), Custom);
            }
        }
    }
    if !self.Subtarget.useSoftFloat() && self.Subtarget.hasVLX() {
        self.setTruncStoreAction(v4i64, v4i8, Legal);
        self.setTruncStoreAction(v4i64, v4i16, Legal);
        self.setTruncStoreAction(v4i64, v4i32, Legal);
        self.setTruncStoreAction(v8i32, v8i8, Legal);
        self.setTruncStoreAction(v8i32, v8i16, Legal);
        self.setTruncStoreAction(v2i64, v2i8, Legal);
        self.setTruncStoreAction(v2i64, v2i16, Legal);
        self.setTruncStoreAction(v2i64, v2i32, Legal);
        self.setTruncStoreAction(v4i32, v4i8, Legal);
        self.setTruncStoreAction(v4i32, v4i16, Legal);
        if self.Subtarget.hasBWI() {
            self.setTruncStoreAction(v16i16, v16i8, Legal);
            self.setTruncStoreAction(v8i16, v8i8, Legal);
        }
        if self.Subtarget.hasFP16() {
            self.setOperationAction(FP_TO_SINT, v2f16, Custom);
            self.setOperationAction(STRICT_FP_TO_SINT, v2f16, Custom);
            self.setOperationAction(FP_TO_UINT, v2f16, Custom);
            self.setOperationAction(STRICT_FP_TO_UINT, v2f16, Custom);
            self.setOperationAction(FP_TO_SINT, v4f16, Custom);
            self.setOperationAction(STRICT_FP_TO_SINT, v4f16, Custom);
            self.setOperationAction(FP_TO_UINT, v4f16, Custom);
            self.setOperationAction(STRICT_FP_TO_UINT, v4f16, Custom);
            self.setOperationAction(SINT_TO_FP, v2f16, Custom);
            self.setOperationAction(STRICT_SINT_TO_FP, v2f16, Custom);
            self.setOperationAction(UINT_TO_FP, v2f16, Custom);
            self.setOperationAction(STRICT_UINT_TO_FP, v2f16, Custom);
            self.setOperationAction(SINT_TO_FP, v4f16, Custom);
            self.setOperationAction(STRICT_SINT_TO_FP, v4f16, Custom);
            self.setOperationAction(UINT_TO_FP, v4f16, Custom);
            self.setOperationAction(STRICT_UINT_TO_FP, v4f16, Custom);
            self.setOperationAction(FP_ROUND, v2f16, Custom);
            self.setOperationAction(STRICT_FP_ROUND, v2f16, Custom);
            self.setOperationAction(FP_ROUND, v4f16, Custom);
            self.setOperationAction(STRICT_FP_ROUND, v4f16, Custom);
            self.setOperationAction(FP_EXTEND, v2f16, Custom);
            self.setOperationAction(STRICT_FP_EXTEND, v2f16, Custom);
            self.setOperationAction(FP_EXTEND, v4f16, Custom);
            self.setOperationAction(STRICT_FP_EXTEND, v4f16, Custom);
        }
    }
    if !self.Subtarget.useSoftFloat() && self.Subtarget.hasAMXTILE() {
        self.addRegisterClass(x86amx, &mut TILERegClass);
    }
    self.setOperationAction(INTRINSIC_WO_CHAIN, Other, Custom);
    self.setOperationAction(INTRINSIC_W_CHAIN, Other, Custom);
    self.setOperationAction(INTRINSIC_VOID, Other, Custom);
    if !self.Subtarget.is64Bit() {
        self.setOperationAction(INTRINSIC_W_CHAIN, i64, Custom);
    }
    for VT in [i8, i16, i32, i64] {
        if VT == i64 && !self.Subtarget.is64Bit() {
            continue;
        }
        self.setOperationAction(SADDO, VT, Custom);
        self.setOperationAction(UADDO, VT, Custom);
        self.setOperationAction(SSUBO, VT, Custom);
        self.setOperationAction(USUBO, VT, Custom);
        self.setOperationAction(SMULO, VT, Custom);
        self.setOperationAction(UMULO, VT, Custom);
        self.setOperationAction(UADDO_CARRY, VT, Custom);
        self.setOperationAction(USUBO_CARRY, VT, Custom);
        self.setOperationAction(SETCCCARRY, VT, Custom);
        self.setOperationAction(SADDO_CARRY, VT, Custom);
        self.setOperationAction(SSUBO_CARRY, VT, Custom);
    }
    self.setOperationAction(FSINCOS, f64, Expand);
    self.setOperationAction(FSINCOS, f32, Expand);
    if self.Subtarget.isTargetWin64() {
        self.setOperationAction(SDIV, i128, Custom);
        self.setOperationAction(UDIV, i128, Custom);
        self.setOperationAction(SREM, i128, Custom);
        self.setOperationAction(UREM, i128, Custom);
        self.setOperationAction(FP_TO_SINT, i128, Custom);
        self.setOperationAction(FP_TO_UINT, i128, Custom);
        self.setOperationAction(SINT_TO_FP, i128, Custom);
        self.setOperationAction(UINT_TO_FP, i128, Custom);
        self.setOperationAction(STRICT_FP_TO_SINT, i128, Custom);
        self.setOperationAction(STRICT_FP_TO_UINT, i128, Custom);
        self.setOperationAction(STRICT_SINT_TO_FP, i128, Custom);
        self.setOperationAction(STRICT_UINT_TO_FP, i128, Custom);
    }
    if self.Subtarget.is32Bit() && (self.Subtarget.isTargetWindowsMSVC() || self.Subtarget.isTargetWindowsItanium()) {
        for Op in [FACOS, STRICT_FACOS, FASIN, STRICT_FASIN, FATAN, STRICT_FATAN, FATAN2, STRICT_FATAN2, FCEIL, STRICT_FCEIL, FCOS, STRICT_FCOS, FCOSH, STRICT_FCOSH, FEXP, STRICT_FEXP, FFLOOR, STRICT_FFLOOR, FREM, STRICT_FREM, FLOG, STRICT_FLOG, FLOG10, STRICT_FLOG10, FPOW, STRICT_FPOW, FSIN, STRICT_FSIN, FSINH, STRICT_FSINH, FTAN, STRICT_FTAN, FTANH, STRICT_FTANH, FMODF] {
            if self.isOperationExpandOrLibCall(Op, f32) {
                self.setOperationAction(Op, f32, Promote);
            }
        }
    }
    if self.Subtarget.isOSWindows() {
        for Op in [FLDEXP, STRICT_FLDEXP, FFREXP] {
            if self.isOperationExpand(Op, f32) {
                self.setOperationAction(Op, f32, Promote);
            }
        }
    }
    self.setOperationPromotedToType(ATOMIC_LOAD, f16, i16);
    self.setOperationPromotedToType(ATOMIC_LOAD, f32, i32);
    self.setOperationPromotedToType(ATOMIC_LOAD, f64, i64);
    self.setOperationPromotedToType(ATOMIC_STORE, f16, i16);
    self.setOperationPromotedToType(ATOMIC_STORE, f32, i32);
    self.setOperationPromotedToType(ATOMIC_STORE, f64, i64);
    self.setTargetDAGCombine([VECTOR_SHUFFLE, SCALAR_TO_VECTOR, INSERT_VECTOR_ELT, EXTRACT_VECTOR_ELT, CONCAT_VECTORS, INSERT_SUBVECTOR, EXTRACT_SUBVECTOR, BITCAST, VSELECT, SELECT, SHL, SRA, SRL, OR, AND, AVGCEILS, AVGCEILU, AVGFLOORS, AVGFLOORU, BITREVERSE, ADD, SADDSAT, SSUBSAT, FADD, FSUB, FNEG, FMA, STRICT_FMA, FMINNUM, FMAXNUM, PSEUDO_FMIN, PSEUDO_FMAX, SUB, ATOMIC_LOAD, LOAD, LRINT, LLRINT, MLOAD, STORE, MSTORE, TRUNCATE, ZERO_EXTEND, ANY_EXTEND, SIGN_EXTEND, SIGN_EXTEND_INREG, ANY_EXTEND_VECTOR_INREG, SIGN_EXTEND_VECTOR_INREG, ZERO_EXTEND_VECTOR_INREG, VECREDUCE_AND, VECREDUCE_OR, VECREDUCE_XOR, VECREDUCE_MUL, SINT_TO_FP, UINT_TO_FP, FP_TO_SINT, STRICT_SINT_TO_FP, STRICT_UINT_TO_FP, FP_TO_SINT_SAT, FP_TO_UINT_SAT, SETCC, MUL, UDIV, SDIV, UREM, SREM, MASKED_UDIV, MASKED_SDIV, MASKED_UREM, MASKED_SREM, XOR, MSCATTER, MGATHER, FP16_TO_FP, FP_EXTEND, STRICT_FP_EXTEND, FP_ROUND, STRICT_FP_ROUND, ROTL, ROTR, FSHL, FSHR, INTRINSIC_VOID, INTRINSIC_WO_CHAIN, INTRINSIC_W_CHAIN]);
    self.computeRegisterProperties(self.Subtarget.getRegisterInfo());
    self.MaxStoresPerMemset = 16;
    self.MaxStoresPerMemsetOptSize = 8;
    self.MaxStoresPerMemcpy = 8;
    self.MaxStoresPerMemcpyOptSize = 4;
    self.MaxStoresPerMemmove = 8;
    self.MaxStoresPerMemmoveOptSize = 4;
    self.MaxLoadsPerMemcmp = 2;
    self.MaxLoadsPerMemcmpOptSize = 2;
    self.setPrefLoopAlignment(16);
    self.PredictableSelectIsExpensive = self.Subtarget.getSchedModel().isOutOfOrder();
    self.EnableExtLdPromotion = true;
    self.setPrefFunctionAlignment(16);
    verifyIntrinsicTables();
    self.IsStrictFPEnabled = true;
}

fn X86TargetLowering::useLoadStackGuardNode(self: *X86TargetLowering, M: *Module) -> bool {
    return self.Subtarget.isTargetMachO() && self.Subtarget.is64Bit();
}

fn X86TargetLowering::useStackGuardMixFP(self: *X86TargetLowering) -> bool {
    return self.Subtarget.getTargetTriple().isOSMSVCRT() && !self.Subtarget.isTargetMachO();
}

fn X86TargetLowering::emitStackGuardMixFP(self: *X86TargetLowering, DAG: *mut SelectionDAG, Val: SDValue, DL: *SDLoc) -> SDValue {
    let mut PtrTy: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut XorOp: u32 = if self.Subtarget.is64Bit() { XOR64_FP } else { XOR32_FP };
    let mut Node: *mut MachineSDNode = DAG.getMachineNode(XorOp, DL, PtrTy, Val);
    return SDValue { Node: Node, ResNo: 0 };
}

fn X86TargetLowering::getPreferredVectorAction(self: *X86TargetLowering, VT: MVT) -> LegalizeTypeAction {
    if (VT == v32i1 || VT == v64i1) && self.Subtarget.hasAVX512() && !self.Subtarget.hasBWI() {
        return TypeSplitVector;
    }
    if !VT.isScalableVector() && VT.getVectorNumElements() != 1 && VT.getVectorNumElements() <= 4 && !self.Subtarget.hasF16C() && VT.getVectorElementType() == f16 {
        return TypeSplitVector;
    }
    if !VT.isScalableVector() && VT.getVectorNumElements() != 1 && VT.getVectorElementType() != i1 {
        return TypeWidenVector;
    }
    return self.getPreferredVectorAction(VT);
}

fn X86TargetLowering::createFastISel(self: *X86TargetLowering, funcInfo: *mut FunctionLoweringInfo, libInfo: *TargetLibraryInfo, libcallLowering: *LibcallLoweringInfo) -> *mut FastISel {
    return createFastISel(funcInfo, libInfo, libcallLowering);
}

fn mayFoldLoad(Op: SDValue, Subtarget: *X86Subtarget, AssumeSingleUse: bool, IgnoreAlignment: bool) -> bool {
    if !AssumeSingleUse && !Op.hasOneUse() {
        return false;
    }
    if !isNormalLoad(Op.getNode()) {
        return false;
    }
    let mut Ld: *mut LoadSDNode = cast(Op.getNode());
    if !IgnoreAlignment && !Subtarget.hasAVX() && !Subtarget.hasSSEUnalignedMem() && Ld.getValueSizeInBits(0).operator unsigned long long() == 128 && Ld.getAlign() < 16 {
        return false;
    }
    return true;
}

fn mayFoldLoadIntoBroadcastFromMem(Op: SDValue, EltVT: MVT, Subtarget: *X86Subtarget, AssumeSingleUse: bool) -> bool {
    assert!(Subtarget.hasAVX(), "Expected AVX for broadcast from memory");
    if !mayFoldLoad(Op, Subtarget, AssumeSingleUse, false) {
        return false;
    }
    let mut Ld: *mut LoadSDNode = cast(Op.getNode());
    return !Ld.isVolatile() || Ld.getValueSizeInBits(0).operator unsigned long long() == EltVT.getScalarSizeInBits();
}

fn mayFoldIntoStore(Op: SDValue) -> bool {
    if !Op.hasOneUse() {
        return false;
    }
    let mut User: *mut SDNode = operator(operator(Op).user_begin());
    while User.getOpcode() == BITCAST {
        if !User.hasOneUse() {
            return false;
        }
        User = operator(User.user_begin());
    }
    return isNormalStore(User) || User.getOpcode() == ATOMIC_STORE;
}

fn mayFoldIntoZeroExtend(Op: SDValue) -> bool {
    if Op.hasOneUse() {
        let mut Opcode: u32 = operator(Op.getNode().user_begin()).getOpcode();
        return (ZERO_EXTEND == Opcode);
    }
    return false;
}

fn mayFoldIntoVector(Op: SDValue, DAG: *SelectionDAG, Subtarget: *X86Subtarget) -> bool {
    if peekThroughBitcasts(Op).getValueType().isVector() {
        return true;
    }
    if isa(Op) || isa(Op) {
        return true;
    }
    let mut VT: EVT = Op.getValueType();
    let mut Opcode: u32 = Op.getOpcode();
    if (VT == i128 || VT == i256 || VT == i512) && DAG.getTargetLoweringInfo().getOperationAction(Opcode, VT) == Custom {
        match Opcode {
            BITREVERSE => {
                return true;
            },
            SHL => {
                SRL;
            },
            AND => {
                OR;
            },
            SELECT => {
                return mayFoldIntoVector(Op.getOperand(1), DAG, Subtarget) && mayFoldIntoVector(Op.getOperand(2), DAG, Subtarget);
            },
        }
    }
    return mayFoldLoad(Op, Subtarget, true, true);
}

fn isLogicOp(Opcode: u32) -> bool {
    return isBitwiseLogicOp(Opcode) || ANDNP == Opcode;
}

fn isTargetShuffle(Opcode: u32) -> bool {
    match Opcode {
        _ => {
            return false;
        },
        BLENDI => {
            PSHUFB;
        },
    }
}

fn isTargetShuffleVariableMask(Opcode: u32) -> bool {
    match Opcode {
        _ => {
            return false;
        },
        PSHUFB => {
            VPERMILPV;
        },
        OR => {
            AND;
        },
    }
}

fn X86TargetLowering::getReturnAddressFrameIndex(self: *X86TargetLowering, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut RegInfo: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut FuncInfo: *mut X86MachineFunctionInfo = MF.getInfo();
    let mut ReturnAddrIndex: i32 = FuncInfo.getRAIndex();
    if ReturnAddrIndex == 0 {
        let mut SlotSize: u32 = RegInfo.getSlotSize();
        ReturnAddrIndex = MF.getFrameInfo().CreateFixedObject(SlotSize, -SlotSize as i64, false, false);
        FuncInfo.setRAIndex(ReturnAddrIndex);
    }
    return DAG.getFrameIndex(ReturnAddrIndex, self.getPointerTy(DAG.getDataLayout(), 0), false);
}

fn isOffsetSuitableForCodeModel(Offset: i64, CM: Model, HasSymbolicDisplacement: bool) -> bool {
    if !isInt(Offset) {
        return false;
    }
    if !HasSymbolicDisplacement {
        return true;
    }
    if CM == Large {
        return true;
    }
    if CM == Kernel {
        return Offset >= 0;
    }
    return Offset < 16 * 1024 * 1024;
}

fn isX86CCSigned(X86CC: CondCode) -> bool {
    match X86CC {
        _ => {
            llvm_unreachable_internal("Invalid integer condition!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 3224);
        },
        COND_E => {
            COND_NE;
        },
        COND_G => {
            COND_GE;
        },
    }
}

fn TranslateIntegerX86CC(SetCCOpcode: CondCode) -> CondCode {
    match SetCCOpcode {
        _ => {
            llvm_unreachable_internal("Invalid integer condition!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 3243);
        },
        SETEQ => {
            return COND_E;
        },
        SETGT => {
            return COND_G;
        },
        SETGE => {
            return COND_GE;
        },
        SETLT => {
            return COND_L;
        },
        SETLE => {
            return COND_LE;
        },
        SETNE => {
            return COND_NE;
        },
        SETULT => {
            return COND_B;
        },
        SETUGT => {
            return COND_A;
        },
        SETULE => {
            return COND_BE;
        },
        SETUGE => {
            return COND_AE;
        },
    }
}

fn TranslateX86CC(SetCCOpcode: CondCode, DL: *SDLoc, isFP: bool, LHS: *mut SDValue, RHS: *mut SDValue, DAG: *mut SelectionDAG) -> CondCode {
    if !isFP {
        if dyn_cast(RHS) {
            RHSC;
        } else {
            if SetCCOpcode == SETGT && RHSC.isAllOnes() {
                RHS = DAG.getConstant(0, DL, RHS.getValueType(), false, false);
                return COND_NS;
            }
            if SetCCOpcode == SETLT && RHSC.isZero() {
                return COND_S;
            }
            if SetCCOpcode == SETGE && RHSC.isZero() {
                return COND_NS;
            }
            if SetCCOpcode == SETLT && RHSC.isOne() {
                RHS = DAG.getConstant(0, DL, RHS.getValueType(), false, false);
                return COND_LE;
            }
        }
        return TranslateIntegerX86CC(SetCCOpcode);
    }
    if isNON_EXTLoad(LHS.getNode()) && !isNON_EXTLoad(RHS.getNode()) {
        SetCCOpcode = getSetCCSwappedOperands(SetCCOpcode);
        swap(LHS, RHS);
    }
    match SetCCOpcode {
        _ => {
            break;
        },
        SETOLT => {
            SETOLE;
        },
    }
    match SetCCOpcode {
        _ => {
            llvm_unreachable_internal("Condcode should be pre-legalized away", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLowering.cpp", 3316);
        },
        SETUEQ => {
            SETEQ;
        },
        SETOLT => {
            SETOGT;
        },
        SETOLE => {
            SETOGE;
        },
        SETUGT => {
            SETULT;
        },
        SETUGE => {
            SETULE;
        },
        SETONE => {
            SETNE;
        },
        SETUO => {
            return COND_P;
        },
        SETO => {
            return COND_NP;
        },
        SETOEQ => {
            SETUNE;
        },
    }
}

fn hasFPCMov(X86CC: u32) -> bool {
    match X86CC {
        _ => {
            return false;
        },
        COND_B => {
            COND_BE;
        },
    }
}

fn useVPTERNLOG(Subtarget: *X86Subtarget, VT: MVT) -> bool {
    return Subtarget.hasVLX() || Subtarget.canExtendTo512DQ() || VT.is512BitVector();
}

fn X86TargetLowering::getTgtMemIntrinsic(self: *X86TargetLowering, Infos: *mut SmallVectorImpl<IntrinsicInfo>, I: *CallBase, MF: *mut MachineFunction, Intrinsic: u32) {
    let mut Info: IntrinsicInfo = IntrinsicInfo {};
    Info.flags = MONone;
    Info.offset = 0;
    let mut IntrData: *IntrinsicData = getIntrinsicWithChain(Intrinsic);
    if !IntrData {
        match Intrinsic {
            x86_aesenc128kl => {
                x86_aesdec128kl;
            },
            x86_aesenc256kl => {
                x86_aesdec256kl;
            },
            x86_aesencwide128kl => {
                x86_aesdecwide128kl;
            },
            x86_aesencwide256kl => {
                x86_aesdecwide256kl;
            },
            x86_cmpccxadd32 => {
                x86_cmpccxadd64;
            },
            x86_atomic_bts_rm => {
                x86_atomic_btc_rm;
            },
            x86_aadd32 => {
                x86_aadd64;
            },
        }
        return;
    }
    match IntrData.Type {
        TRUNCATE_TO_MEM_VI8 => {
            TRUNCATE_TO_MEM_VI16;
        },
        GATHER => {
            GATHER_AVX2;
        },
        SCATTER => {
            Info.opc = INTRINSIC_VOID;
            Info.ptrVal = null;
            let mut DataVT: MVT = getVT(I.getArgOperand(3).getType(), false);
            let mut IndexVT: MVT = getVT(I.getArgOperand(2).getType(), false);
            let mut NumElts: u32 = if DataVT.getVectorNumElements() < IndexVT.getVectorNumElements() { DataVT.getVectorNumElements() } else { IndexVT.getVectorNumElements() };
            Info.memVT = getVectorVT(DataVT.getVectorElementType(), NumElts);
            Info.align = 1;
            operator(Info.flags, MOStore);
            Infos.push(Info);
            return;
        },
        _ => {
            return;
        },
    }
}

fn X86TargetLowering::isFPImmLegal(self: *X86TargetLowering, Imm: *APFloat, VT: EVT, ForCodeSize: bool) -> bool {
    for FPImm in self.LegalFPImmediates {
        if Imm.bitwiseIsEqual(FPImm) {
            return true;
        }
    }
    return false;
}

fn X86TargetLowering::shouldReduceLoadWidth(self: *X86TargetLowering, Load: *mut SDNode, ExtTy: LoadExtType, NewVT: EVT, ByteOffset: optional<unsigned int>) -> bool {
    assert!(cast(Load).isSimple(), "illegal to narrow");
    let mut PeekThroughOneUserBitcasts: Closure_4 = Closure_4 {};
    let mut BasePtr: SDValue = cast(Load).getBasePtr();
    if BasePtr.getOpcode() == WrapperRIP {
        if dyn_cast(BasePtr.getOperand(0)) {
            GA;
        } else {
            return GA.getTargetFlags() != MO_GOTTPOFF;
        }
    }
    let mut VT: EVT = Load.getValueType(0);
    if VT.is128BitVector() || VT.is256BitVector() || VT.is512BitVector() {
        let mut FullWidthUse: bool = false;
        let mut AllExtractStores: bool = (VT.is256BitVector() || VT.is512BitVector()) && !SDValue { Node: Load, ResNo: 0 }.hasOneUse();
        for Use in Load.uses() {
            if Use.getResNo() != 0 {
                continue;
            }
            let mut User: *SDNode = PeekThroughOneUserBitcasts.call(Use.getUser());
            if AllExtractStores && User.getOpcode() == EXTRACT_SUBVECTOR && all_of(User.uses(), Closure_5 { PeekThroughOneUserBitcasts: &mut PeekThroughOneUserBitcasts }) {
                continue;
            }
            AllExtractStores = false;
            if self.isBinOp(User.getOpcode()) && (self.isOperationLegal(User.getOpcode(), User.getValueType(0)) || User.getOpcode() > BUILTIN_OP_END) {
                FullWidthUse = true;
            }
        }
        if AllExtractStores {
            return false;
        }
        if FullWidthUse {
            return (ByteOffset.value_or(0) > 0) || NewVT.isScalarInteger();
        }
    }
    return true;
}

fn X86TargetLowering::shouldConvertConstantLoadToIntImm(self: *X86TargetLowering, Imm: *APInt, Ty: *mut Type) -> bool {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 || BitSize > 64 {
        return false;
    }
    return true;
}

fn X86TargetLowering::reduceSelectOfFPConstantLoads(self: *X86TargetLowering, CmpOpVT: EVT) -> bool {
    let mut IsFPSetCC: bool = CmpOpVT.isFloatingPoint() && CmpOpVT != f128;
    return !IsFPSetCC || !self.Subtarget.isTarget64BitLP64() || !self.Subtarget.hasAVX();
}

fn X86TargetLowering::convertSelectOfConstantsToMath(self: *X86TargetLowering, VT: EVT) -> bool {
    if VT.isVector() && self.Subtarget.hasAVX512() {
        return false;
    }
    return true;
}

fn X86TargetLowering::shouldNormalizeToSelectSequence(self: *X86TargetLowering, arg: *mut LLVMContext, VT: EVT, arg: EVT) -> bool {
    return !(self.Subtarget.hasCCMP() && VT.isScalarInteger());
}

fn X86TargetLowering::decomposeMulByConstant(self: *X86TargetLowering, Context: *mut LLVMContext, VT: EVT, C: SDValue) -> bool {
    let mut MulC: APInt = APInt {};
    if !isConstantSplatVector(C.getNode(), MulC) {
        return false;
    }
    if VT.isVector() && VT.getScalarSizeInBits() == 8 {
        let mut ShiftedMulC: APInt = MulC.abs();
        let mut TZeros: u32 = if ShiftedMulC == 2 { 0 } else { ShiftedMulC.countr_zero() };
        ShiftedMulC.lshrInPlace(TZeros);
        if (ShiftedMulC - 1).isPowerOf2() || (ShiftedMulC + 1).isPowerOf2() {
            return true;
        }
    }
    while self.getTypeAction(Context, VT) != TypeLegal {
        VT = self.getTypeToTransformTo(Context, VT);
    }
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    if self.isOperationLegal(MUL, VT) && EltSizeInBits <= 32 && (EltSizeInBits != 32 || !self.Subtarget.isPMULLDSlow()) {
        return false;
    }
    return (MulC + 1).isPowerOf2() || (MulC - 1).isPowerOf2() || (1 - MulC).isPowerOf2() || (operator((MulC + 1))).isPowerOf2();
}

fn X86TargetLowering::getExtractSubvectorCost(self: *X86TargetLowering, ResVT: EVT, SrcVT: EVT, Index: u32) -> ExtractSubvectorCost {
    if !self.isOperationLegalOrCustom(EXTRACT_SUBVECTOR, ResVT, false) {
        return Expensive;
    }
    if ResVT.getVectorElementType() == i1 {
        if Index == 0 || ((ResVT.getSizeInBits() * 2 == SrcVT.getSizeInBits()) && (Index == ResVT.getVectorNumElements())) {
            return Free;
        }
        return Expensive;
    }
    if Index == 0 {
        return Free;
    } else if (Index % ResVT.getVectorNumElements()) == 0 {
        return Cheap;
    }
    return Expensive;
}

fn X86TargetLowering::shouldScalarizeBinop(self: *X86TargetLowering, VecOp: SDValue) -> bool {
    let mut Opc: u32 = VecOp.getOpcode();
    if Opc >= BUILTIN_OP_END || !self.isBinOp(Opc) {
        return false;
    }
    let mut VecVT: EVT = VecOp.getValueType();
    if !self.isOperationLegalOrCustomOrPromote(Opc, VecVT, false) {
        return true;
    }
    let mut ScalarVT: EVT = VecVT.getScalarType();
    return self.isOperationLegalOrCustomOrPromote(Opc, ScalarVT, false);
}

fn X86TargetLowering::shouldFormOverflowOp(self: *X86TargetLowering, Opcode: u32, VT: EVT, arg: bool) -> bool {
    if VT.isVector() {
        return false;
    }
    return VT.isSimple() || !self.isOperationExpand(Opcode, VT);
}

fn X86TargetLowering::isCheapToSpeculateCttz(self: *X86TargetLowering, Ty: *mut Type) -> bool {
    return self.Subtarget.hasBMI() || self.Subtarget.canUseCMOV() || self.Subtarget.hasBitScanPassThrough() || (!Ty.isVectorTy() && Ty.getScalarSizeInBits() < (if self.Subtarget.is64Bit() { 64 } else { 32 }));
}

fn X86TargetLowering::isCheapToSpeculateCtlz(self: *X86TargetLowering, Ty: *mut Type) -> bool {
    return self.Subtarget.hasLZCNT() || self.Subtarget.canUseCMOV() || self.Subtarget.hasBitScanPassThrough();
}

fn X86TargetLowering::ShouldShrinkFPConstant(self: *X86TargetLowering, VT: EVT) -> bool {
    return !self.Subtarget.hasSSE2() || VT == f80;
}

fn X86TargetLowering::isScalarFPTypeInSSEReg(self: *X86TargetLowering, VT: EVT) -> bool {
    return (VT == f64 && self.Subtarget.hasSSE2()) || (VT == f32 && self.Subtarget.hasSSE1()) || VT == f16;
}

fn X86TargetLowering::isLoadBitCastBeneficial(self: *X86TargetLowering, LoadVT: EVT, BitcastVT: EVT, DAG: *SelectionDAG, MMO: *MachineMemOperand) -> bool {
    if !self.Subtarget.hasAVX512() && !LoadVT.isVector() && BitcastVT.isVector() && BitcastVT.getVectorElementType() == i1 {
        return false;
    }
    if !self.Subtarget.hasDQI() && BitcastVT == v8i1 && LoadVT == i8 {
        return false;
    }
    if LoadVT.isVector() && BitcastVT.isVector() {
        if self.isTypeLegal(LoadVT) {
            return self.isTypeLegal(BitcastVT);
        }
    }
    if LoadVT.isVector() && !BitcastVT.isVector() && LoadVT.isInteger() && BitcastVT.isInteger() && (LoadVT.getSizeInBits().operator unsigned long long() % 128) == 0 {
        return false;
    }
    return self.isLoadBitCastBeneficial(LoadVT, BitcastVT, DAG, MMO);
}

fn X86TargetLowering::canMergeStoresTo(self: *X86TargetLowering, AddressSpace: u32, MemVT: EVT, MF: *MachineFunction) -> bool {
    let mut NoFloat: bool = MF.getFunction().hasFnAttribute(NoImplicitFloat);
    if NoFloat {
        let mut MaxIntSize: u32 = if self.Subtarget.is64Bit() { 64 } else { 32 };
        return (MemVT.getSizeInBits().operator unsigned long long() <= MaxIntSize);
    }
    if MemVT.getSizeInBits().operator unsigned long long() > self.Subtarget.getPreferVectorWidth() {
        return false;
    }
    return true;
}

fn X86TargetLowering::isCtlzFast(self: *X86TargetLowering) -> bool {
    return self.Subtarget.hasFastLZCNT();
}

fn X86TargetLowering::preferZeroCompareBranch(self: *X86TargetLowering) -> bool {
    return true;
}

fn X86TargetLowering::isMaskAndCmp0FoldingBeneficial(self: *X86TargetLowering, AndI: *Instruction) -> bool {
    return true;
}

fn X86TargetLowering::hasAndNotCompare(self: *X86TargetLowering, Y: SDValue) -> bool {
    return Y.getValueType().isScalarInteger();
}

fn X86TargetLowering::hasAndNot(self: *X86TargetLowering, Y: SDValue) -> bool {
    let mut VT: EVT = Y.getValueType();
    if !VT.isVector() {
        if !self.Subtarget.hasBMI() {
            return false;
        }
        if VT != i32 && VT != i64 {
            return false;
        }
        return !isa(Y) || cast(Y).isOpaque();
    }
    if !self.Subtarget.hasSSE1() || VT.getSizeInBits().operator unsigned long long() < 128 {
        return false;
    }
    if VT == v4i32 {
        return true;
    }
    return self.Subtarget.hasSSE2();
}

fn X86TargetLowering::hasBitTest(self: *X86TargetLowering, X: SDValue, Y: SDValue) -> bool {
    return X.getValueType().isScalarInteger();
}

fn X86TargetLowering::shouldProduceAndByConstByHoistingConstFromShiftsLHSOfAnd(self: *X86TargetLowering, X: SDValue, XC: *mut ConstantSDNode, CC: *mut ConstantSDNode, Y: SDValue, OldShiftOpcode: u32, NewShiftOpcode: u32, DAG: *mut SelectionDAG) -> bool {
    if !self.shouldProduceAndByConstByHoistingConstFromShiftsLHSOfAnd(X, XC, CC, Y, OldShiftOpcode, NewShiftOpcode, DAG) {
        return false;
    }
    if X.getValueType().isScalarInteger() {
        return true;
    }
    if DAG.isSplatValue(Y, true) {
        return true;
    }
    if self.Subtarget.hasAVX2() {
        return true;
    }
    return NewShiftOpcode == SHL;
}

fn X86TargetLowering::preferedOpcodeForCmpEqPiecesOfOperand(self: *X86TargetLowering, VT: EVT, ShiftOpc: u32, MayTransformRotate: bool, ShiftOrRotateAmt: *APInt, AndMask: *optional<APInt>) -> u32 {
    if !VT.isInteger() {
        return ShiftOpc;
    }
    let mut PreferRotate: bool = false;
    if VT.isVector() {
        PreferRotate = self.Subtarget.hasAVX512() && (VT.getScalarType() == i32 || VT.getScalarType() == i64);
    } else if self.isTypeLegal(VT) {
        PreferRotate = self.Subtarget.hasBMI2();
        if !PreferRotate {
            let mut MaskBits: u32 = VT.getScalarSizeInBits() - ShiftOrRotateAmt.getZExtValue();
            PreferRotate = (MaskBits != 8) && (MaskBits != 16) && (MaskBits != 32);
        }
    }
    if ShiftOpc == SHL || ShiftOpc == SRL {
        assert!(AndMask.has_value(), "Null andmask when querying about shift+and");
        if PreferRotate && MayTransformRotate {
            return ROTL;
        }
        if VT.isVector() {
            return ShiftOpc;
        }
        if ShiftOpc == SHL {
            if VT == i64 {
                return if operator(AndMask).getSignificantBits() > 32 { SRL as u32 } else { ShiftOpc };
            }
            return if ShiftOrRotateAmt.uge(7) { SRL as u32 } else { ShiftOpc };
        }
        if VT == i64 {
            return if operator(AndMask).getSignificantBits() > 33 { SHL as u32 } else { ShiftOpc };
        }
        return if ShiftOrRotateAmt.ult(7) { SHL as u32 } else { ShiftOpc };
    }
    if PreferRotate || !MayTransformRotate || VT.isVector() {
        return ShiftOpc;
    }
    return SRL;
}

fn X86TargetLowering::preferIncOfAddToSubOfNot(self: *X86TargetLowering, VT: EVT) -> bool {
    return VT.isScalarInteger() || (VT.isVector() && VT.getVectorElementCount().isScalar());
}

fn X86TargetLowering::getJumpConditionMergingParams(self: *X86TargetLowering, Opc: BinaryOps, Lhs: *Value, Rhs: *Value, arg: *Function) -> CondMergingParams {
    let mut BaseCost: i32 = BrMergingBaseCostThresh.getValue();
    if BaseCost >= 0 && self.Subtarget.hasCCMP() {
        BaseCost += BrMergingCcmpBias.operator int();
    }
    if BaseCost >= 0 && Opc == And && match(Lhs, m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Value(), m_Value())) && match(Rhs, m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Value(), m_Value())) {
        BaseCost += 1;
    }
    if BaseCost >= 0 && !self.Subtarget.hasCCMP() && Opc == Or && match(Lhs, m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Value(), m_Value())) && match(Rhs, m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Value(), m_Value())) {
        return CondMergingParams { -1, -1, -1 };
    }
    return CondMergingParams { BaseCost, BrMergingLikelyBias.getValue(), BrMergingUnlikelyBias.getValue() };
}

fn X86TargetLowering::preferScalarizeSplat(self: *X86TargetLowering, N: *mut SDNode) -> bool {
    return N.getOpcode() != FP_EXTEND;
}

fn X86TargetLowering::shouldFoldConstantShiftPairToMask(self: *X86TargetLowering, N: *SDNode) -> bool {
    assert!(((N.getOpcode() == SHL && N.getOperand(0).getOpcode() == SRL) || (N.getOpcode() == SRL && N.getOperand(0).getOpcode() == SHL)), "Expected shift-shift mask");
    let mut VT: EVT = N.getValueType(0);
    if (self.Subtarget.hasFastVectorShiftMasks() && VT.isVector()) || (self.Subtarget.hasFastScalarShiftMasks() && !VT.isVector()) {
        return N.getOperand(1) == N.getOperand(0).getOperand(1);
    }
    return self.shouldFoldConstantShiftPairToMask(N);
}

fn X86TargetLowering::shouldFoldMaskToVariableShiftPair(self: *X86TargetLowering, Y: SDValue) -> bool {
    let mut VT: EVT = Y.getValueType();
    if VT.isVector() {
        return false;
    }
    let mut MaxWidth: u32 = if self.Subtarget.is64Bit() { 64 } else { 32 };
    return VT.getScalarSizeInBits() <= MaxWidth;
}

fn X86TargetLowering::preferredShiftLegalizationStrategy(self: *X86TargetLowering, DAG: *mut SelectionDAG, N: *mut SDNode, ExpansionFactor: u32) -> ShiftLegalizationStrategy {
    if DAG.getMachineFunction().getFunction().hasMinSize() && !self.Subtarget.isOSWindows() {
        return LowerToLibcall;
    }
    return self.preferredShiftLegalizationStrategy(DAG, N, ExpansionFactor);
}

fn X86TargetLowering::shouldSplatInsEltVarIndex(self: *X86TargetLowering, VT: EVT) -> bool {
    return self.isTypeLegal(VT);
}

fn X86TargetLowering::hasFastEqualityCompare(self: *X86TargetLowering, NumBits: u32) -> MVT {
    let mut VT: MVT = getIntegerVT(NumBits);
    if self.isTypeLegal(VT) {
        return VT;
    }
    if NumBits == 128 && self.isTypeLegal(v16i8) {
        return v16i8;
    }
    if NumBits == 256 && self.isTypeLegal(v32i8) {
        return v32i8;
    }
    return INVALID_SIMPLE_VALUE_TYPE;
}

fn isUndefOrEqual(Val: i32, CmpVal: i32) -> bool {
    return ((Val == SM_SentinelUndef) || (Val == CmpVal));
}

fn isUndefOrEqual(Mask: ArrayRef<int>, CmpVal: i32) -> bool {
    return all_of(Mask, Closure_6 { CmpVal: CmpVal });
}

fn isUndefOrEqualInRange(Mask: ArrayRef<int>, CmpVal: i32, Pos: u32, Size: u32) -> bool {
    return all_of(Mask.slice(Pos, Size), Closure_7 { CmpVal: CmpVal });
}

fn isUndefOrZero(Val: i32) -> bool {
    return ((Val == SM_SentinelUndef) || (Val == SM_SentinelZero));
}

fn isUndefInRange(Mask: ArrayRef<int>, Pos: u32, Size: u32) -> bool {
    return all_of(Mask.slice(Pos, Size), equal_to(SM_SentinelUndef));
}

fn isUndefLowerHalf(Mask: ArrayRef<int>) -> bool {
    let mut NumElts: u32 = Mask.len;
    return isUndefInRange(Mask, 0, NumElts / 2);
}

fn isUndefUpperHalf(Mask: ArrayRef<int>) -> bool {
    let mut NumElts: u32 = Mask.len;
    return isUndefInRange(Mask, NumElts / 2, NumElts / 2);
}

fn isInRange(Val: i32, Low: i32, Hi: i32) -> bool {
    return (Val >= Low && Val < Hi);
}

fn isAnyInRange(Mask: ArrayRef<int>, Low: i32, Hi: i32) -> bool {
    return any_of(Mask, Closure_8 { Low: Low, Hi: Hi });
}

fn isAnyZero(Mask: ArrayRef<int>) -> bool {
    return any_of(Mask, equal_to(SM_SentinelZero));
}

fn isUndefOrInRange(Val: i32, Low: i32, Hi: i32) -> bool {
    return (Val == SM_SentinelUndef) || isInRange(Val, Low, Hi);
}

fn isUndefOrInRange(Mask: ArrayRef<int>, Low: i32, Hi: i32) -> bool {
    return all_of(Mask, Closure_9 { Low: Low, Hi: Hi });
}

fn isUndefOrZeroOrInRange(Val: i32, Low: i32, Hi: i32) -> bool {
    return isUndefOrZero(Val) || isInRange(Val, Low, Hi);
}

fn isUndefOrZeroOrInRange(Mask: ArrayRef<int>, Low: i32, Hi: i32) -> bool {
    return all_of(Mask, Closure_10 { Low: Low, Hi: Hi });
}

fn isBlendOrUndef(Mask: ArrayRef<int>) -> bool {
    let mut NumElts: u32 = Mask.len;
    for x in enumerate(Mask) {
        if !isUndefOrEqual(M, I) && !isUndefOrEqual(M, I + NumElts) {
            return false;
        }
    }
    return true;
}

fn isSequentialOrUndefInRange(Mask: ArrayRef<int>, Pos: u32, Size: u32, Low: i32, Step: i32) -> bool {
    for let mut i: u32 = Pos;
let mut e: u32 = Pos + Size; i != e; i += 1 , Low += Step {
        if !isUndefOrEqual(Mask[i], Low) {
            return false;
        }
    }
    return true;
}

fn isSequentialOrUndefOrZeroInRange(Mask: ArrayRef<int>, Pos: u32, Size: u32, Low: i32, Step: i32) -> bool {
    for let mut i: u32 = Pos;
let mut e: u32 = Pos + Size; i != e; i += 1 , Low += Step {
        if !isUndefOrZero(Mask[i]) && Mask[i] != Low {
            return false;
        }
    }
    return true;
}

fn isUndefOrZeroInRange(Mask: ArrayRef<int>, Pos: u32, Size: u32) -> bool {
    return all_of(Mask.slice(Pos, Size), isUndefOrZero);
}

fn isCompletePermute(Mask: ArrayRef<int>) -> bool {
    let mut NumElts: u32 = Mask.len;
    let mut DemandedElts: APInt = getZero(NumElts);
    for M in Mask {
        if isInRange(M, 0, NumElts) {
            DemandedElts.setBit(M);
        }
    }
    return DemandedElts.isAllOnes();
}

fn canWidenShuffleElements(Mask: ArrayRef<int>, WidenedMask: *mut SmallVectorImpl<int>) -> bool {
    WidenedMask.assign(Mask.len / 2, 0);
    for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 2 {
        let mut M0: i32 = Mask[i];
        let mut M1: i32 = Mask[i + 1];
        if M0 == SM_SentinelUndef && M1 == SM_SentinelUndef {
            WidenedMask[i / 2] = SM_SentinelUndef;
            continue;
        }
        if M0 == SM_SentinelUndef && M1 >= 0 && (M1 % 2) == 1 {
            WidenedMask[i / 2] = M1 / 2;
            continue;
        }
        if M1 == SM_SentinelUndef && M0 >= 0 && (M0 % 2) == 0 {
            WidenedMask[i / 2] = M0 / 2;
            continue;
        }
        if M0 == SM_SentinelZero || M1 == SM_SentinelZero {
            if (M0 == SM_SentinelZero || M0 == SM_SentinelUndef) && (M1 == SM_SentinelZero || M1 == SM_SentinelUndef) {
                WidenedMask[i / 2] = SM_SentinelZero;
                continue;
            }
            return false;
        }
        if M0 != SM_SentinelUndef && (M0 % 2) == 0 && (M0 + 1) == M1 {
            WidenedMask[i / 2] = M0 / 2;
            continue;
        }
        return false;
    }
    assert!(WidenedMask.len == Mask.len / 2, "Incorrect size of mask after widening the elements!");
    return true;
}

fn canWidenShuffleElements(Mask: ArrayRef<int>, Zeroable: *APInt, V2IsZero: bool, WidenedMask: *mut SmallVectorImpl<int>) -> bool {
    let mut ZeroableMask: SmallVector<int, 64> = Mask;
    if V2IsZero {
        assert!(!Zeroable.isZero(), "V2's non-undef elements are used?!");
        for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i != Size; i += 1 {
            if Mask[i] != SM_SentinelUndef && Zeroable[i] {
                ZeroableMask[i] = SM_SentinelZero;
            }
        }
    }
    return canWidenShuffleElements(ZeroableMask, WidenedMask);
}

fn canWidenShuffleElements(Mask: ArrayRef<int>) -> bool {
    let mut WidenedMask: SmallVector<int, 32> = SmallVector<int, 32> {};
    return canWidenShuffleElements(Mask, WidenedMask);
}

fn scaleShuffleElements(Mask: ArrayRef<int>, NumDstElts: u32, ScaledMask: *mut SmallVectorImpl<int>) -> bool {
    let mut NumSrcElts: u32 = Mask.len;
    assert!(((NumSrcElts % NumDstElts) == 0 || (NumDstElts % NumSrcElts) == 0), "Illegal shuffle scale factor");
    if NumDstElts >= NumSrcElts {
        let mut Scale: i32 = NumDstElts / NumSrcElts;
        narrowShuffleMaskElts(Scale, Mask, ScaledMask);
        return true;
    }
    if canWidenShuffleElements(Mask, ScaledMask) {
        while ScaledMask.len > NumDstElts {
            let mut WidenedMask: SmallVector<int, 16> = SmallVector<int, 16> {};
            if !canWidenShuffleElements(ScaledMask, WidenedMask) {
                return false;
            }
            ScaledMask = move(WidenedMask);
        }
        return true;
    }
    return false;
}

fn canScaleShuffleElements(Mask: ArrayRef<int>, NumDstElts: u32) -> bool {
    let mut ScaledMask: SmallVector<int, 32> = SmallVector<int, 32> {};
    return scaleShuffleElements(Mask, NumDstElts, ScaledMask);
}

fn growShuffleMask(SrcMask: ArrayRef<int>, DstMask: *mut SmallVectorImpl<int>, SrcSizeInBits: u32, DstSizeInBits: u32) {
    assert!(DstMask.is_empty(), "Expected an empty shuffle mas");
    assert!((DstSizeInBits % SrcSizeInBits) == 0, "Illegal shuffle scale");
    let mut Scale: u32 = DstSizeInBits / SrcSizeInBits;
    let mut NumSrcElts: u32 = SrcMask.len;
    DstMask.assign(SrcMask.begin(), SrcMask.end());
    for M in DstMask {
        if M < 0 {
            continue;
        }
        M = (M % NumSrcElts) + ((M / NumSrcElts) * Scale * NumSrcElts);
    }
    DstMask.append((Scale - 1) * NumSrcElts, SM_SentinelUndef);
}

fn isZeroNode(Elt: SDValue) -> bool {
    return isNullConstant(Elt) || isNullFPConstant(Elt);
}

fn getConstVector(Values: ArrayRef<int>, VT: MVT, DAG: *mut SelectionDAG, dl: *SDLoc, IsMask: bool) -> SDValue {
    let mut Ops: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    let mut Split: bool = false;
    let mut ConstVecVT: MVT = VT;
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut In64BitMode: bool = DAG.getTargetLoweringInfo().isTypeLegal(i64);
    if !In64BitMode && VT.getVectorElementType() == i64 {
        ConstVecVT = getVectorVT(i32, NumElts * 2);
        Split = true;
    }
    let mut EltVT: MVT = ConstVecVT.getVectorElementType();
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        let mut IsUndef: bool = Values[i] < 0 && IsMask;
        let mut OpNode: SDValue = if IsUndef { DAG.getUNDEF(EltVT) } else { DAG.getConstant(Values[i], dl, EltVT, false, false) };
        Ops.push(OpNode);
        if Split {
            Ops.push(if IsUndef { DAG.getUNDEF(EltVT) } else { DAG.getConstant(0, dl, EltVT, false, false) });
        }
    }
    let mut ConstsNode: SDValue = DAG.getBuildVector(ConstVecVT, dl, Ops);
    if Split {
        ConstsNode = DAG.getBitcast(VT, ConstsNode);
    }
    return ConstsNode;
}

fn getConstVector(Bits: ArrayRef<APInt>, Undefs: *APInt, VT: MVT, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!(Bits.len == Undefs.getBitWidth(), "Unequal constant and undef arrays");
    let mut Ops: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    let mut Split: bool = false;
    let mut ConstVecVT: MVT = VT;
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut In64BitMode: bool = DAG.getTargetLoweringInfo().isTypeLegal(i64);
    if !In64BitMode && VT.getVectorElementType() == i64 {
        ConstVecVT = getVectorVT(i32, NumElts * 2);
        Split = true;
    }
    let mut EltVT: MVT = ConstVecVT.getVectorElementType();
    let mut EltIntVT: MVT = EltVT.changeTypeToInteger();
    for let mut i: u32 = 0;
let mut e: u32 = Bits.len; i != e; i += 1 {
        if Undefs[i] {
            Ops.append(if Split { 2 } else { 1 }, DAG.getUNDEF(EltVT));
            continue;
        }
        let mut V: *APInt = Bits[i];
        assert!(V.getBitWidth() == VT.getScalarSizeInBits(), "Unexpected sizes");
        if Split {
            Ops.push(DAG.getConstant(V.extractBits(32, 0), dl, EltVT, false, false));
            Ops.push(DAG.getConstant(V.extractBits(32, 32), dl, EltVT, false, false));
        } else {
            Ops.push(DAG.getBitcast(EltVT, DAG.getConstant(V, dl, EltIntVT, false, false)));
        }
    }
    let mut ConstsNode: SDValue = DAG.getBuildVector(ConstVecVT, dl, Ops);
    return DAG.getBitcast(VT, ConstsNode);
}

fn getConstVector(Bits: ArrayRef<APInt>, VT: MVT, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut Undefs: APInt = getZero(Bits.len);
    return getConstVector(Bits, Undefs, VT, DAG, dl);
}

fn getZeroVector(VT: MVT, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!((VT.is128BitVector() || VT.is256BitVector() || VT.is512BitVector() || VT.getVectorElementType() == i1), "Unexpected vector type");
    let mut Vec: SDValue = SDValue {};
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !Subtarget.hasSSE2() && VT.is128BitVector() {
        Vec = DAG.getConstantFP(0.0, dl, v4f32, false);
    } else if VT.isFloatingPoint() && TLI.isTypeLegal(VT.getVectorElementType()) {
        Vec = DAG.getConstantFP(0.0, dl, VT, false);
    } else if VT.getVectorElementType() == i1 {
        assert!((Subtarget.hasBWI() || VT.getVectorNumElements() <= 16), "Unexpected vector type");
        Vec = DAG.getConstant(0, dl, VT, false, false);
    } else {
        let mut Num32BitElts: u32 = VT.getSizeInBits().operator unsigned long long() / 32;
        Vec = DAG.getConstant(0, dl, getVectorVT(i32, Num32BitElts), false, false);
    }
    return DAG.getBitcast(VT, Vec);
}

fn getSplitVectorSrc(LHS: SDValue, RHS: SDValue, AllowCommute: bool) -> SDValue {
    if LHS.getOpcode() != EXTRACT_SUBVECTOR || RHS.getOpcode() != EXTRACT_SUBVECTOR || LHS.getValueType() != RHS.getValueType() || LHS.getOperand(0) != RHS.getOperand(0) {
        return SDValue {};
    }
    let mut Src: SDValue = LHS.getOperand(0);
    if Src.getValueSizeInBits() != (LHS.getValueSizeInBits() * 2) {
        return SDValue {};
    }
    let mut NumElts: u32 = LHS.getValueType().getVectorNumElements();
    if (LHS.getConstantOperandAPInt(1) == 0 && RHS.getConstantOperandAPInt(1) == NumElts) || (AllowCommute && RHS.getConstantOperandAPInt(1) == 0 && LHS.getConstantOperandAPInt(1) == NumElts) {
        return Src;
    }
    return SDValue {};
}

fn extractSubVector(Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc, vectorWidth: u32) -> SDValue {
    let mut VT: EVT = Vec.getValueType();
    let mut ElVT: EVT = VT.getVectorElementType();
    let mut ResultNumElts: u32 = (VT.getVectorNumElements() * vectorWidth) / VT.getSizeInBits().operator unsigned long long();
    let mut ResultVT: EVT = getVectorVT(*DAG.getContext(), ElVT, ResultNumElts, false);
    assert!(ResultVT.getSizeInBits().operator unsigned long long() == vectorWidth, "Illegal subvector extraction");
    let mut ElemsPerChunk: u32 = vectorWidth / ElVT.getSizeInBits().operator unsigned long long();
    assert!(isPowerOf2_32(ElemsPerChunk), "Elements per chunk not power of 2");
    IdxVal &= ~(ElemsPerChunk - 1);
    if Vec.getOpcode() == BUILD_VECTOR {
        return DAG.getBuildVector(ResultVT, dl, operator(Vec).ops().slice(IdxVal, ElemsPerChunk));
    }
    if Vec.getOpcode() == INSERT_SUBVECTOR && Vec.getOperand(0).isUndef() && Vec.getOperand(1).getValueType().getVectorNumElements() <= IdxVal && isNullConstant(Vec.getOperand(2)) {
        return DAG.getUNDEF(ResultVT);
    }
    return DAG.getExtractSubvector(dl, ResultVT, Vec, IdxVal);
}

fn extract128BitVector(Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!((Vec.getValueType().is256BitVector() || Vec.getValueType().is512BitVector()), "Unexpected vector size!");
    return extractSubVector(Vec, IdxVal, DAG, dl, 128);
}

fn extract256BitVector(Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!(Vec.getValueType().is512BitVector(), "Unexpected vector size!");
    return extractSubVector(Vec, IdxVal, DAG, dl, 256);
}

fn insertSubVector(Result: SDValue, Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc, vectorWidth: u32) -> SDValue {
    assert!((vectorWidth == 128 || vectorWidth == 256), "Unsupported vector width");
    if Vec.isUndef() {
        return Result;
    }
    let mut VT: EVT = Vec.getValueType();
    let mut ElemsPerChunk: u32 = vectorWidth / VT.getScalarSizeInBits();
    assert!(isPowerOf2_32(ElemsPerChunk), "Elements per chunk not power of 2");
    IdxVal &= ~(ElemsPerChunk - 1);
    return DAG.getInsertSubvector(dl, Result, Vec, IdxVal);
}

fn insert128BitVector(Result: SDValue, Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!(Vec.getValueType().is128BitVector(), "Unexpected vector size!");
    return insertSubVector(Result, Vec, IdxVal, DAG, dl, 128);
}

fn widenSubVector(VT: MVT, Vec: SDValue, ZeroNewElements: bool, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut VecVT: EVT = Vec.getValueType();
    assert!(VecVT.getFixedSizeInBits() <= VT.getFixedSizeInBits() && VecVT.getScalarType() == VT.getScalarType(), "Unsupported vector widening type");
    if Vec.getOpcode() == BUILD_VECTOR && VecVT.is256BitVector() {
        let mut NumSrcElts: u32 = VecVT.getVectorNumElements();
        let mut Hi: ArrayRef<SDUse> = operator(Vec).ops().drop_front(NumSrcElts / 2);
        if all_of(Hi, Closure_11 { ZeroNewElements: &mut ZeroNewElements }) {
            Vec = extract128BitVector(Vec, 0, DAG, dl);
        }
    }
    let mut Res: SDValue = if ZeroNewElements { getZeroVector(VT, Subtarget, DAG, dl) } else { DAG.getUNDEF(VT) };
    return DAG.getInsertSubvector(dl, Res, Vec, 0);
}

fn widenSubVector(Vec: SDValue, ZeroNewElements: bool, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc, WideSizeInBits: u32) -> SDValue {
    assert!(Vec.getValueSizeInBits().operator unsigned long long() <= WideSizeInBits && (WideSizeInBits % Vec.getScalarValueSizeInBits()) == 0, "Unsupported vector widening type");
    let mut WideNumElts: u32 = WideSizeInBits / Vec.getScalarValueSizeInBits();
    let mut SVT: MVT = Vec.getSimpleValueType().getScalarType();
    let mut VT: MVT = getVectorVT(SVT, WideNumElts);
    return widenSubVector(VT, Vec, ZeroNewElements, Subtarget, DAG, dl);
}

fn widenMaskVectorType(VT: MVT, Subtarget: *X86Subtarget) -> MVT {
    assert!(VT.getVectorElementType() == i1, "Expected bool vector");
    let mut NumElts: u32 = VT.getVectorNumElements();
    if (!Subtarget.hasDQI() && NumElts == 8) || NumElts < 8 {
        return if Subtarget.hasDQI() { v8i1 } else { v16i1 };
    }
    return VT;
}

fn widenMaskVector(Vec: SDValue, ZeroNewElements: bool, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut VT: MVT = widenMaskVectorType(Vec.getSimpleValueType(), Subtarget);
    return widenSubVector(VT, Vec, ZeroNewElements, Subtarget, DAG, dl);
}

fn collectConcatOps(N: *mut SDNode, Ops: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) -> bool {
    assert!(Ops.is_empty(), "Expected an empty ops vector");
    if N.getOpcode() == CONCAT_VECTORS {
        Ops.append(N.op_begin(), N.op_end());
        return true;
    }
    if N.getOpcode() == INSERT_SUBVECTOR {
        let mut Src: SDValue = N.getOperand(0);
        let mut Sub: SDValue = N.getOperand(1);
        let mut Idx: *APInt = N.getConstantOperandAPInt(2);
        let mut VT: EVT = Src.getValueType();
        let mut SubVT: EVT = Sub.getValueType();
        if VT.getSizeInBits() == (SubVT.getSizeInBits() * 2) {
            if Idx == 0 && Src.isUndef() {
                Ops.push(Sub);
                Ops.push(DAG.getUNDEF(SubVT));
                return true;
            }
            if Idx == (VT.getVectorNumElements() / 2) {
                if Src.getOpcode() == INSERT_SUBVECTOR && Src.getOperand(1).getValueType() == SubVT && isNullConstant(Src.getOperand(2)) {
                    let mut Lo: SDValue = Src.getOperand(1);
                    let mut Hi: SDValue = Sub;
                    let mut LoOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
                    let mut HiOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
                    if collectConcatOps(Lo.getNode(), LoOps, DAG) && collectConcatOps(Hi.getNode(), HiOps, DAG) && LoOps.len == HiOps.len {
                        Ops.append(LoOps);
                        Ops.append(HiOps);
                        return true;
                    }
                    Ops.push(Lo);
                    Ops.push(Hi);
                    return true;
                }
                if Sub.getOpcode() == EXTRACT_SUBVECTOR && Sub.getOperand(0) == Src && isNullConstant(Sub.getOperand(1)) {
                    Ops.append(2, Sub);
                    return true;
                }
                if Src.isUndef() {
                    Ops.push(DAG.getUNDEF(SubVT));
                    Ops.push(Sub);
                    return true;
                }
            }
        }
    }
    if N.getOpcode() == EXTRACT_SUBVECTOR {
        let mut VT: EVT = N.getValueType(0);
        let mut Src: SDValue = N.getOperand(0);
        let mut Idx: u64 = N.getConstantOperandVal(1);
        let mut SrcOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
        if collectConcatOps(Src.getNode(), SrcOps, DAG) && VT.getSizeInBits().operator unsigned long long() > SrcOps[0].getValueSizeInBits().operator unsigned long long() && (VT.getSizeInBits().operator unsigned long long() % SrcOps[0].getValueSizeInBits().operator unsigned long long()) == 0 && (Idx % SrcOps[0].getValueType().getVectorNumElements()) == 0 {
            let mut SubIdx: u32 = Idx / SrcOps[0].getValueType().getVectorNumElements();
            let mut NumSubs: u32 = VT.getSizeInBits().operator unsigned long long() / SrcOps[0].getValueSizeInBits().operator unsigned long long();
            Ops.append(SrcOps.begin() + SubIdx, SrcOps.begin() + SubIdx + NumSubs);
            return true;
        }
    }
    assert!(Ops.is_empty(), "Expected an empty ops vector");
    return false;
}

fn isUpperSubvectorUndef(V: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut SubOps: SmallVector<SDValue> = SmallVector<SDValue> {};
    if !collectConcatOps(V.getNode(), SubOps, DAG) {
        return SDValue {};
    }
    let mut NumSubOps: u32 = SubOps.len;
    let mut HalfNumSubOps: u32 = NumSubOps / 2;
    assert!((NumSubOps % 2) == 0, "Unexpected number of subvectors");
    let mut UpperOps: ArrayRef<SDValue> = ArrayRef<SDValue> { SubOps.begin() + HalfNumSubOps, SubOps.end() };
    if any_of(UpperOps, Closure_12 {}) {
        return SDValue {};
    }
    let mut HalfVT: EVT = V.getValueType().getHalfNumVectorElementsVT(*DAG.getContext());
    let mut LowerOps: ArrayRef<SDValue> = ArrayRef<SDValue> { SubOps.begin(), SubOps.begin() + HalfNumSubOps };
    return DAG.getNode(CONCAT_VECTORS, DL, HalfVT, LowerOps);
}

fn isFreeToSplitVector(V: SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> {};
    return collectConcatOps(V.getNode(), Ops, DAG);
}

fn splitVector(Op: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc) -> pair<SDValue, SDValue> {
    let mut VT: EVT = Op.getValueType();
    let mut NumElems: u32 = VT.getVectorNumElements();
    let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    assert!((NumElems % 2) == 0 && (SizeInBits % 2) == 0, "Can't split odd sized vector");
    let mut SubOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    if collectConcatOps(Op.getNode(), SubOps, DAG) {
        assert!((SubOps.len % 2) == 0, "Can't split odd sized vector concat");
        let mut HalfOps: u32 = SubOps.len / 2;
        let mut HalfVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
        let mut LoOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> { SubOps.begin(), SubOps.begin() + HalfOps };
        let mut HiOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> { SubOps.begin() + HalfOps, SubOps.end() };
        let mut Lo: SDValue = DAG.getNode(CONCAT_VECTORS, dl, HalfVT, LoOps);
        let mut Hi: SDValue = DAG.getNode(CONCAT_VECTORS, dl, HalfVT, HiOps);
        return make_pair(Lo, Hi);
    }
    let mut Lo: SDValue = extractSubVector(Op, 0, DAG, dl, SizeInBits / 2);
    if DAG.isSplatValue(Op, false) {
        return make_pair(Lo, Lo);
    }
    let mut Hi: SDValue = extractSubVector(Op, NumElems / 2, DAG, dl, SizeInBits / 2);
    return make_pair(Lo, Hi);
}

fn splitVectorOp(Op: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut NumOps: u32 = Op.getNumOperands();
    let mut VT: EVT = Op.getValueType();
    let mut LoOps: SmallVector<SDValue> = SmallVector<SDValue> { NumOps, SDValue {} };
    let mut HiOps: SmallVector<SDValue> = SmallVector<SDValue> { NumOps, SDValue {} };
    for let mut I: u32 = 0; I != NumOps; I += 1 {
        let mut SrcOp: SDValue = Op.getOperand(I);
        if !SrcOp.getValueType().isVector() {
            LoOps[I] = HiOps[I] = SrcOp;
            continue;
        }
        tie(LoOps[I], HiOps[I]) = splitVector(SrcOp, DAG, dl);
    }
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = DAG.GetSplitDestVTs(VT);
    return DAG.getNode(CONCAT_VECTORS, dl, VT, DAG.getNode(Op.getOpcode(), dl, LoVT, LoOps), DAG.getNode(Op.getOpcode(), dl, HiVT, HiOps));
}

fn splitVectorIntUnary(Op: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!((Op.getOperand(0).getValueType().is256BitVector() || Op.getOperand(0).getValueType().is512BitVector()) && (VT.is256BitVector() || VT.is512BitVector()), "Unsupported VT!");
    assert!(Op.getOperand(0).getValueType().getVectorNumElements() == VT.getVectorNumElements(), "Unexpected VTs!");
    return splitVectorOp(Op, DAG, dl);
}

fn splitVectorIntBinary(Op: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(Op.getOperand(0).getValueType() == VT && Op.getOperand(1).getValueType() == VT, "Unexpected VTs!");
    assert!((VT.is256BitVector() || VT.is512BitVector()), "Unsupported VT!");
    return splitVectorOp(Op, DAG, dl);
}

