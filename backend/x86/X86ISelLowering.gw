    }
    let mut Builder: IRBuilder<ConstantFolder, IRBuilderCallbackInserter> = zeroed();
    Builder()(AI);
    let mut SSID: ID = AI.getSyncScopeID();
    let mut Order: AtomicOrdering = getStrongestFailureOrdering(AI.getOrdering());
    Builder()(SequentiallyConsistent, SSID);
    let mut Loaded: *mut LoadInst = (AI.getType(), AI.getPointerOperand(), AI.getAlign());
    Loaded.setAtomic(Order, SSID);
    AI.replaceAllUsesWith(Loaded);
    AI.eraseFromParent();
    return Loaded;
}

fn emitLockedStackOp(DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, Chain: SDValue, DL: *SDLoc) -> SDValue {
