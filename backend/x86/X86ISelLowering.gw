            if BV.isConstantSplat(SplatValue, SplatUndef, SplatBitSize, HasAnyUndefs, OpEltSizeInBits, false) && !HasAnyUndefs && SplatValue.getBitWidth() == OpEltSizeInBits {
                return (*self.DAG).getConstant(SplatValue, (*self.DL), DstVT, false, false);
