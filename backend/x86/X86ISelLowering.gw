            let mut User: *SDNode = PeekThroughOneUserBitcasts.call(Use.getUser());
            if AllExtractStores && User.getOpcode() == EXTRACT_SUBVECTOR && all_of(User.uses(), Closure_5 { PeekThroughOneUserBitcasts: &mut PeekThroughOneUserBitcasts }) {
                continue;
            }
            AllExtractStores = false;
            if self.isBinOp(User.getOpcode()) && (self.isOperationLegal || User.getOpcode() > BUILTIN_OP_END) {
                FullWidthUse = true;
            }
        }
        if AllExtractStores {
            return false;
        }
        if FullWidthUse {
            return (ByteOffset()(0) > 0) || NewVT.isScalarInteger();
        }
    }
    return true;
}

fn X86TargetLowering::shouldConvertConstantLoadToIntImm(self: *X86TargetLowering, Imm: *APInt, Ty: *mut Type) -> bool {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 || BitSize > 64 {
        return false;
    }
    return true;
}

fn X86TargetLowering::reduceSelectOfFPConstantLoads(self: *X86TargetLowering, CmpOpVT: EVT) -> bool {
    let mut IsFPSetCC: bool = CmpOpVT.isFloatingPoint() && CmpOpVT != EVT { f128 };
    return !IsFPSetCC || !self.Subtarget.isTarget64BitLP64() || !self.Subtarget.hasAVX();
}

fn X86TargetLowering::convertSelectOfConstantsToMath(self: *X86TargetLowering, VT: EVT) -> bool {
    if VT.isVector() && self.Subtarget.hasAVX512() {
        return false;
    }
    return true;
}

fn X86TargetLowering::shouldNormalizeToSelectSequence(self: *X86TargetLowering, arg: *mut LLVMContext, VT: EVT, arg: EVT) -> bool {
    return operator!((self.Subtarget() && VT.isScalarInteger()));
}

fn X86TargetLowering::decomposeMulByConstant(self: *X86TargetLowering, Context: *mut LLVMContext, VT: EVT, C: SDValue) -> bool {
    let mut MulC: APInt = APInt {};
    if !isConstantSplatVector(C.getNode(), MulC) {
        return false;
    }
    if VT.isVector() && VT.getScalarSizeInBits() == 8 {
        let mut ShiftedMulC: APInt = MulC.abs();
        let mut TZeros: u32 = if ShiftedMulC == 2 { 0 } else { ShiftedMulC.countr_zero() };
        ShiftedMulC.lshrInPlace(TZeros);
        if (ShiftedMulC - 1).isPowerOf2() || (ShiftedMulC + 1).isPowerOf2() {
            return true;
        }
    }
    while  != TypeLegal {
        VT = self.getTypeToTransformTo(Context, VT);
    }
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    if self.isOperationLegal && EltSizeInBits <= 32 && (EltSizeInBits != 32 || operator!(self.Subtarget())) {
        return false;
    }
    return (MulC + 1).isPowerOf2() || (MulC - 1).isPowerOf2() || (1 - MulC).isPowerOf2() || (operator((MulC + 1))).isPowerOf2();
}

fn X86TargetLowering::getExtractSubvectorCost(self: *X86TargetLowering, ResVT: EVT, SrcVT: EVT, Index: u32) -> ExtractSubvectorCost {
    if operator!(self.isOperationLegalOrCustom) {
        return Expensive;
    }
    if ResVT.getVectorElementType() == EVT { i1 } {
        if Index == 0 || ((ResVT.getSizeInBits() * 2 == SrcVT.getSizeInBits()) && (Index == ResVT.getVectorNumElements())) {
            return Free;
        }
        return Expensive;
    }
    if Index == 0 {
        return Free;
    } else if (Index % ResVT.getVectorNumElements()) == 0 {
        return Cheap;
    }
    return Expensive;
}

fn X86TargetLowering::shouldScalarizeBinop(self: *X86TargetLowering, VecOp: SDValue) -> bool {
    let mut Opc: u32 = VecOp.getOpcode();
    if Opc >= BUILTIN_OP_END || !self.isBinOp(Opc) {
        return false;
    }
    let mut VecVT: EVT = VecOp.getValueType();
    if operator!(self.isOperationLegalOrCustomOrPromote) {
        return true;
    }
    let mut ScalarVT: EVT = VecVT.getScalarType();
    return self.isOperationLegalOrCustomOrPromote;
}

fn X86TargetLowering::shouldFormOverflowOp(self: *X86TargetLowering, Opcode: u32, VT: EVT, arg: bool) -> bool {
    if VT.isVector() {
        return false;
    }
    return VT.isSimple() || operator!(self.isOperationExpand);
}

fn X86TargetLowering::isCheapToSpeculateCttz(self: *X86TargetLowering, Ty: *mut Type) -> bool {
    return self.Subtarget() || self.Subtarget.canUseCMOV() || self.Subtarget.hasBitScanPassThrough() || (!Ty.isVectorTy() && Ty.getScalarSizeInBits() < (if self.Subtarget() { 64 } else { 32 }));
}

fn X86TargetLowering::isCheapToSpeculateCtlz(self: *X86TargetLowering, Ty: *mut Type) -> bool {
    return self.Subtarget() || self.Subtarget.canUseCMOV() || self.Subtarget.hasBitScanPassThrough();
}

fn X86TargetLowering::ShouldShrinkFPConstant(self: *X86TargetLowering, VT: EVT) -> bool {
    return !self.Subtarget.hasSSE2() || VT == EVT { f80 };
}

fn X86TargetLowering::isScalarFPTypeInSSEReg(self: *X86TargetLowering, VT: EVT) -> bool {
    return (VT == EVT { f64 } && self.Subtarget.hasSSE2()) || (VT == EVT { f32 } && self.Subtarget.hasSSE1()) || VT == EVT { f16 };
}

fn X86TargetLowering::isLoadBitCastBeneficial(self: *X86TargetLowering, LoadVT: EVT, BitcastVT: EVT, DAG: *SelectionDAG, MMO: *MachineMemOperand) -> bool {
    if !self.Subtarget.hasAVX512() && !LoadVT.isVector() && BitcastVT.isVector() && BitcastVT.getVectorElementType() == EVT { i1 } {
        return false;
    }
    if operator!(self.Subtarget()) && BitcastVT == EVT { v8i1 } && LoadVT == EVT { i8 } {
        return false;
    }
    if LoadVT.isVector() && BitcastVT.isVector() {
        if self.isTypeLegal {
            return self.isTypeLegal;
        }
    }
    if LoadVT.isVector() && !BitcastVT.isVector() && LoadVT.isInteger() && BitcastVT.isInteger() && (LoadVT.getSizeInBits().operator unsigned long long() % 128) == 0 {
        return false;
    }
    return self.isLoadBitCastBeneficial;
}

fn X86TargetLowering::canMergeStoresTo(self: *X86TargetLowering, AddressSpace: u32, MemVT: EVT, MF: *MachineFunction) -> bool {
    let mut NoFloat: bool = MF.getFunction().hasFnAttribute(NoImplicitFloat);
    if NoFloat {
        let mut MaxIntSize: u32 = if self.Subtarget() { 64 } else { 32 };
        return (MemVT.getSizeInBits().operator unsigned long long() <= MaxIntSize);
    }
    if MemVT.getSizeInBits().operator unsigned long long() > self.Subtarget.getPreferVectorWidth() {
        return false;
    }
    return true;
}

fn X86TargetLowering::isCtlzFast(self: *X86TargetLowering) -> bool {
    return self.Subtarget();
}

fn X86TargetLowering::preferZeroCompareBranch(self: *X86TargetLowering) -> bool {
    return true;
}

fn X86TargetLowering::isMaskAndCmp0FoldingBeneficial(self: *X86TargetLowering, AndI: *Instruction) -> bool {
    return true;
}

fn X86TargetLowering::hasAndNotCompare(self: *X86TargetLowering, Y: SDValue) -> bool {
    return Y.getValueType().isScalarInteger();
}

fn X86TargetLowering::hasAndNot(self: *X86TargetLowering, Y: SDValue) -> bool {
    let mut VT: EVT = Y.getValueType();
    if !VT.isVector() {
        if operator!(self.Subtarget()) {
            return false;
        }
        if VT != EVT { i32 } && VT != EVT { i64 } {
            return false;
        }
        return !isa(Y) || cast(Y)();
    }
    if !self.Subtarget.hasSSE1() || VT.getSizeInBits().operator unsigned long long() < 128 {
        return false;
    }
    if VT == EVT { v4i32 } {
        return true;
    }
    return self.Subtarget.hasSSE2();
}

fn X86TargetLowering::hasBitTest(self: *X86TargetLowering, X: SDValue, Y: SDValue) -> bool {
    return X.getValueType().isScalarInteger();
}

fn X86TargetLowering::shouldProduceAndByConstByHoistingConstFromShiftsLHSOfAnd(self: *X86TargetLowering, X: SDValue, XC: *mut ConstantSDNode, CC: *mut ConstantSDNode, Y: SDValue, OldShiftOpcode: u32, NewShiftOpcode: u32, DAG: *mut SelectionDAG) -> bool {
    if operator!(self.shouldProduceAndByConstByHoistingConstFromShiftsLHSOfAnd) {
        return false;
    }
    if X.getValueType().isScalarInteger() {
        return true;
    }
    if DAG.isSplatValue(Y, true) {
        return true;
    }
    if self.Subtarget.hasAVX2() {
        return true;
    }
    return NewShiftOpcode == SHL;
}

fn X86TargetLowering::preferedOpcodeForCmpEqPiecesOfOperand(self: *X86TargetLowering, VT: EVT, ShiftOpc: u32, MayTransformRotate: bool, ShiftOrRotateAmt: *APInt, AndMask: *optional<APInt>) -> u32 {
    if !VT.isInteger() {
        return ShiftOpc;
    }
    let mut PreferRotate: bool = false;
    if VT.isVector() {
        PreferRotate = self.Subtarget.hasAVX512() && (VT.getScalarType() == EVT { i32 } || VT.getScalarType() == EVT { i64 });
    } else if self.isTypeLegal {
        PreferRotate = self.Subtarget();
        if !PreferRotate {
            let mut MaskBits: u32 = VT.getScalarSizeInBits() - ShiftOrRotateAmt.getZExtValue();
            PreferRotate = (MaskBits != 8) && (MaskBits != 16) && (MaskBits != 32);
        }
    }
    if ShiftOpc == SHL || ShiftOpc == SRL {
        assert!(AndMask.has_value(), "Null andmask when querying about shift+and");
        if PreferRotate && MayTransformRotate {
            return ROTL;
        }
        if VT.isVector() {
            return ShiftOpc;
        }
        if ShiftOpc == SHL {
            if VT == EVT { i64 } {
                return if operator(AndMask).getSignificantBits() > 32 { SRL as u32 } else { ShiftOpc };
            }
            return if ShiftOrRotateAmt.uge(7) { SRL as u32 } else { ShiftOpc };
        }
        if VT == EVT { i64 } {
            return if operator(AndMask).getSignificantBits() > 33 { SHL as u32 } else { ShiftOpc };
        }
        return if ShiftOrRotateAmt.ult(7) { SHL as u32 } else { ShiftOpc };
    }
    if PreferRotate || !MayTransformRotate || VT.isVector() {
        return ShiftOpc;
    }
    return SRL;
}

fn X86TargetLowering::preferIncOfAddToSubOfNot(self: *X86TargetLowering, VT: EVT) -> bool {
    return VT.isScalarInteger() || (VT.isVector() && VT.getVectorElementCount().isScalar());
}

fn X86TargetLowering::getJumpConditionMergingParams(self: *X86TargetLowering, Opc: BinaryOps, Lhs: *Value, Rhs: *Value, arg: *Function) -> CondMergingParams {
    let mut BaseCost: i32 = ();
    if BaseCost >= 0 && self.Subtarget() {
        operator+=(BaseCost);
    }
    if BaseCost >= 0 && Opc == And && match(Lhs, m_SpecificICmp(ICMP_EQ, m_Value(), m_Value())) && match(Rhs, m_SpecificICmp(ICMP_EQ, m_Value(), m_Value())) {
        BaseCost += 1;
    }
    if BaseCost >= 0 && operator!(self.Subtarget()) && Opc == Or && match(Lhs, m_SpecificICmp(ICMP_EQ, m_Value(), m_Value())) && match(Rhs, m_SpecificICmp(ICMP_EQ, m_Value(), m_Value())) {
        return CondMergingParams { -1, -1, -1 };
    }
    return void { BaseCost, () };
}

fn X86TargetLowering::preferScalarizeSplat(self: *X86TargetLowering, N: *mut SDNode) -> bool {
    return N.getOpcode() != FP_EXTEND;
}

fn X86TargetLowering::shouldFoldConstantShiftPairToMask(self: *X86TargetLowering, N: *SDNode) -> bool {
    assert!(((N.getOpcode() == SHL && N.getOperand(0).getOpcode() == SRL) || (N.getOpcode() == SRL && N.getOperand(0).getOpcode() == SHL)), "Expected shift-shift mask");
    let mut VT: EVT = N.getValueType(0);
    if (self.Subtarget() && VT.isVector()) || (self.Subtarget() && !VT.isVector()) {
        return N.getOperand(1) == N.getOperand(0).getOperand(1);
    }
    return self.shouldFoldConstantShiftPairToMask;
}

fn X86TargetLowering::shouldFoldMaskToVariableShiftPair(self: *X86TargetLowering, Y: SDValue) -> bool {
    let mut VT: EVT = Y.getValueType();
    if VT.isVector() {
        return false;
    }
    let mut MaxWidth: u32 = if self.Subtarget() { 64 } else { 32 };
    return VT.getScalarSizeInBits() <= MaxWidth;
}

fn X86TargetLowering::preferredShiftLegalizationStrategy(self: *X86TargetLowering, DAG: *mut SelectionDAG, N: *mut SDNode, ExpansionFactor: u32) -> ShiftLegalizationStrategy {
    if DAG.getMachineFunction().getFunction().hasMinSize() && !self.Subtarget.isOSWindows() {
        return LowerToLibcall;
    }
    return self.preferredShiftLegalizationStrategy;
}

fn X86TargetLowering::shouldSplatInsEltVarIndex(self: *X86TargetLowering, VT: EVT) -> bool {
    return self.isTypeLegal;
}

fn X86TargetLowering::hasFastEqualityCompare(self: *X86TargetLowering, NumBits: u32) -> MVT {
    let mut VT: MVT = getIntegerVT(NumBits);
    if self.isTypeLegal {
        return VT;
    }
    if NumBits == 128 && self.isTypeLegal {
        return MVT { SimpleTy: v16i8 };
    }
    if NumBits == 256 && self.isTypeLegal {
        return MVT { SimpleTy: v32i8 };
    }
    return MVT { SimpleTy: INVALID_SIMPLE_VALUE_TYPE };
}

fn isUndefOrEqual(Val: i32, CmpVal: i32) -> bool {
    return ((Val == SM_SentinelUndef) || (Val == CmpVal));
}

fn isUndefOrEqual(Mask: ArrayRef<int>, CmpVal: i32) -> bool {
    return all_of(Mask, Closure_6 { CmpVal: CmpVal });
}

fn isUndefOrEqualInRange(Mask: ArrayRef<int>, CmpVal: i32, Pos: u32, Size: u32) -> bool {
    return all_of(Mask.slice(Pos, Size), Closure_7 { CmpVal: CmpVal });
}

fn isUndefOrZero(Val: i32) -> bool {
    return ((Val == SM_SentinelUndef) || (Val == SM_SentinelZero));
}

fn isUndefInRange(Mask: ArrayRef<int>, Pos: u32, Size: u32) -> bool {
    return all_of(Mask.slice(Pos, Size), equal_to(SM_SentinelUndef));
}

fn isUndefLowerHalf(Mask: ArrayRef<int>) -> bool {
    let mut NumElts: u32 = Mask.len;
    return isUndefInRange(Mask, 0, NumElts / 2);
}

fn isUndefUpperHalf(Mask: ArrayRef<int>) -> bool {
    let mut NumElts: u32 = Mask.len;
    return isUndefInRange(Mask, NumElts / 2, NumElts / 2);
}

fn isInRange(Val: i32, Low: i32, Hi: i32) -> bool {
    return (Val >= Low && Val < Hi);
}

fn isAnyInRange(Mask: ArrayRef<int>, Low: i32, Hi: i32) -> bool {
    return any_of(Mask, Closure_8 { Low: Low, Hi: Hi });
}

fn isAnyZero(Mask: ArrayRef<int>) -> bool {
    return any_of(Mask, equal_to(SM_SentinelZero));
}

fn isUndefOrInRange(Val: i32, Low: i32, Hi: i32) -> bool {
    return (Val == SM_SentinelUndef) || isInRange(Val, Low, Hi);
}

fn isUndefOrInRange(Mask: ArrayRef<int>, Low: i32, Hi: i32) -> bool {
    return all_of(Mask, Closure_9 { Low: Low, Hi: Hi });
}

fn isUndefOrZeroOrInRange(Val: i32, Low: i32, Hi: i32) -> bool {
    return isUndefOrZero(Val) || isInRange(Val, Low, Hi);
}

fn isUndefOrZeroOrInRange(Mask: ArrayRef<int>, Low: i32, Hi: i32) -> bool {
    return all_of(Mask, Closure_10 { Low: Low, Hi: Hi });
}

fn isBlendOrUndef(Mask: ArrayRef<int>) -> bool {
    let mut NumElts: u32 = Mask.len;
    return true;
}

fn isSequentialOrUndefInRange(Mask: ArrayRef<int>, Pos: u32, Size: u32, Low: i32, Step: i32) -> bool {
    for let mut i: u32 = Pos;
let mut e: u32 = Pos + Size; i != e; i += 1 , Low += Step {
        if !isUndefOrEqual(Mask[i], Low) {
            return false;
        }
    }
    return true;
}

fn isSequentialOrUndefOrZeroInRange(Mask: ArrayRef<int>, Pos: u32, Size: u32, Low: i32, Step: i32) -> bool {
    for let mut i: u32 = Pos;
let mut e: u32 = Pos + Size; i != e; i += 1 , Low += Step {
        if !isUndefOrZero(Mask[i]) && Mask[i] != Low {
            return false;
        }
    }
    return true;
}

fn isUndefOrZeroInRange(Mask: ArrayRef<int>, Pos: u32, Size: u32) -> bool {
    return all_of(Mask.slice(Pos, Size), isUndefOrZero);
}

fn isCompletePermute(Mask: ArrayRef<int>) -> bool {
    let mut NumElts: u32 = Mask.len;
    let mut DemandedElts: APInt = getZero(NumElts);
    for M in Mask {
        if isInRange(M, 0, NumElts) {
            DemandedElts.setBit(M);
        }
    }
    return DemandedElts.isAllOnes();
}

fn canWidenShuffleElements(Mask: ArrayRef<int>, WidenedMask: *mut SmallVectorImpl<int>) -> bool {
    WidenedMask.assign(Mask.len / 2, 0);
    for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i < Size; i += 2 {
        let mut M0: i32 = Mask[i];
        let mut M1: i32 = Mask[i + 1];
        if M0 == SM_SentinelUndef && M1 == SM_SentinelUndef {
            WidenedMask[i / 2] = SM_SentinelUndef;
            continue;
        }
        if M0 == SM_SentinelUndef && M1 >= 0 && (M1 % 2) == 1 {
            WidenedMask[i / 2] = M1 / 2;
            continue;
        }
        if M1 == SM_SentinelUndef && M0 >= 0 && (M0 % 2) == 0 {
            WidenedMask[i / 2] = M0 / 2;
            continue;
        }
        if M0 == SM_SentinelZero || M1 == SM_SentinelZero {
            if (M0 == SM_SentinelZero || M0 == SM_SentinelUndef) && (M1 == SM_SentinelZero || M1 == SM_SentinelUndef) {
                WidenedMask[i / 2] = SM_SentinelZero;
                continue;
            }
            return false;
        }
        if M0 != SM_SentinelUndef && (M0 % 2) == 0 && (M0 + 1) == M1 {
            WidenedMask[i / 2] = M0 / 2;
            continue;
        }
        return false;
    }
    assert!(WidenedMask.len == Mask.len / 2, "Incorrect size of mask after widening the elements!");
    return true;
}

fn canWidenShuffleElements(Mask: ArrayRef<int>, Zeroable: *APInt, V2IsZero: bool, WidenedMask: *mut SmallVectorImpl<int>) -> bool {
    let mut ZeroableMask: SmallVector<int, 64> = zeroed();
    if V2IsZero {
        assert!(!Zeroable.isZero(), "V2's non-undef elements are used?!");
        for let mut i: i32 = 0;
let mut Size: i32 = Mask.len; i != Size; i += 1 {
            if Mask[i] != SM_SentinelUndef && Zeroable[i] {
                ZeroableMask()[i] = SM_SentinelZero;
            }
        }
    }
    return canWidenShuffleElements(WidenedMask);
}

fn canWidenShuffleElements(Mask: ArrayRef<int>) -> bool {
    let mut WidenedMask: SmallVector<int, 32> = zeroed();
    return canWidenShuffleElements(Mask);
}

fn scaleShuffleElements(Mask: ArrayRef<int>, NumDstElts: u32, ScaledMask: *mut SmallVectorImpl<int>) -> bool {
    let mut NumSrcElts: u32 = Mask.len;
    assert!(((NumSrcElts % NumDstElts) == 0 || (NumDstElts % NumSrcElts) == 0), "Illegal shuffle scale factor");
    if NumDstElts >= NumSrcElts {
        let mut Scale: i32 = NumDstElts / NumSrcElts;
        narrowShuffleMaskElts(Scale, Mask, ScaledMask);
        return true;
    }
    if canWidenShuffleElements(Mask, ScaledMask) {
        while ScaledMask.len > NumDstElts {
            let mut WidenedMask: SmallVector<int, 16> = SmallVector<int, 16> {};
            if !canWidenShuffleElements(ScaledMask, WidenedMask) {
                return false;
            }
            ScaledMask = move(WidenedMask);
        }
        return true;
    }
    return false;
}

fn canScaleShuffleElements(Mask: ArrayRef<int>, NumDstElts: u32) -> bool {
    let mut ScaledMask: SmallVector<int, 32> = zeroed();
    return scaleShuffleElements(Mask, NumDstElts);
}

fn growShuffleMask(SrcMask: ArrayRef<int>, DstMask: *mut SmallVectorImpl<int>, SrcSizeInBits: u32, DstSizeInBits: u32) {
    assert!(DstMask.is_empty(), "Expected an empty shuffle mas");
    assert!((DstSizeInBits % SrcSizeInBits) == 0, "Illegal shuffle scale");
    let mut Scale: u32 = DstSizeInBits / SrcSizeInBits;
    let mut NumSrcElts: u32 = SrcMask.len;
    DstMask;
    for M in DstMask {
        if M < 0 {
            continue;
        }
        M = (M % NumSrcElts) + ((M / NumSrcElts) * Scale * NumSrcElts);
    }
    DstMask.append((Scale - 1) * NumSrcElts, SM_SentinelUndef);
}

fn isZeroNode(Elt: SDValue) -> bool {
    return isNullConstant(Elt) || isNullFPConstant(Elt);
}

fn getConstVector(Values: ArrayRef<int>, VT: MVT, DAG: *mut SelectionDAG, dl: *SDLoc, IsMask: bool) -> SDValue {
    let mut Ops: SmallVector<SDValue, 32> = zeroed();
    let mut Split: bool = false;
    let mut ConstVecVT: MVT = VT;
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut In64BitMode: bool = DAG.getTargetLoweringInfo().isTypeLegal;
    if !In64BitMode && VT.getVectorElementType() == i64 {
        ConstVecVT = getVectorVT(MVT { SimpleTy: i32 }, NumElts * 2);
        Split = true;
    }
    let mut EltVT: MVT = ConstVecVT.getVectorElementType();
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        let mut IsUndef: bool = Values[i] < 0 && IsMask;
        let mut OpNode: SDValue = if IsUndef { DAG.getUNDEF(EVT { EltVT }) } else { DAG.getConstant(Values[i], dl, EVT { EltVT }, false, false) };
        Ops()(OpNode);
        if Split {
            Ops()(if IsUndef { DAG.getUNDEF(EVT { EltVT }) } else { DAG.getConstant(0, dl, EVT { EltVT }, false, false) });
        }
    }
    let mut ConstsNode: SDValue = DAG(ConstVecVT, dl);
    if Split {
        ConstsNode = DAG.getBitcast(EVT { VT }, ConstsNode);
    }
    return ConstsNode;
}

fn getConstVector(Bits: ArrayRef<APInt>, Undefs: *APInt, VT: MVT, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    (((operator!(operator!((Bits()() == Undefs.getBitWidth() && "Unequal constant and undef arrays")))) || (_wassert(L"Bits.size() == Undefs.getBitWidth() && \"Unequal constant and undef arrays\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (4353) as u32) , 0)) as void);
    let mut Ops: SmallVector<SDValue, 32> = zeroed();
    let mut Split: bool = false;
    let mut ConstVecVT: MVT = VT;
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut In64BitMode: bool = DAG.getTargetLoweringInfo().isTypeLegal;
    if !In64BitMode && VT.getVectorElementType() == i64 {
        ConstVecVT = getVectorVT(MVT { SimpleTy: i32 }, NumElts * 2);
        Split = true;
    }
    let mut EltVT: MVT = ConstVecVT.getVectorElementType();
    let mut EltIntVT: MVT = EltVT.changeTypeToInteger();
    for let mut i: u32 = 0;
let mut e: u32 = (); i != e; i += 1 {
        if Undefs[i] {
            Ops()(if Split { 2 } else { 1 }, DAG.getUNDEF(EVT { EltVT }));
            continue;
        }
        let mut V: *APInt = [i];
        assert!(V.getBitWidth() == VT.getScalarSizeInBits(), "Unexpected sizes");
        if Split {
            Ops()(DAG.getConstant(V.extractBits(32, 0), dl, EVT { EltVT }, false, false));
            Ops()(DAG.getConstant(V.extractBits(32, 32), dl, EVT { EltVT }, false, false));
        } else {
            Ops()(DAG.getBitcast(EVT { EltVT }, DAG.getConstant(V, dl, EVT { EltIntVT }, false, false)));
        }
    }
    let mut ConstsNode: SDValue = DAG(ConstVecVT, dl);
    return DAG.getBitcast(EVT { VT }, ConstsNode);
}

fn getConstVector(Bits: ArrayRef<APInt>, VT: MVT, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut Undefs: APInt = getZero();
    return getConstVector(Undefs, VT, DAG, dl);
}

fn getZeroVector(VT: MVT, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!((VT.is128BitVector() || VT.is256BitVector() || VT.is512BitVector() || VT.getVectorElementType() == i1), "Unexpected vector type");
    let mut Vec: SDValue = SDValue {};
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !Subtarget.hasSSE2() && VT.is128BitVector() {
        Vec = DAG.getConstantFP(0.0, dl, EVT { v4f32 }, false);
    } else if VT.isFloatingPoint() && TLI.isTypeLegal {
        Vec = DAG.getConstantFP(0.0, dl, EVT { VT }, false);
    } else if VT.getVectorElementType() == i1 {
        (((operator!(operator!(((Subtarget()() || VT.getVectorNumElements() <= 16) && "Unexpected vector type")))) || (_wassert(L"(Subtarget.hasBWI() || VT.getVectorNumElements() <= 16) && \"Unexpected vector type\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (4411) as u32) , 0)) as void);
        Vec = DAG.getConstant(0, dl, EVT { VT }, false, false);
    } else {
        let mut Num32BitElts: u32 = VT.getSizeInBits().operator unsigned long long() / 32;
        Vec = DAG.getConstant(0, dl, EVT { getVectorVT(MVT { SimpleTy: i32 }, Num32BitElts) }, false, false);
    }
    return DAG.getBitcast(EVT { VT }, Vec);
}

fn getSplitVectorSrc(LHS: SDValue, RHS: SDValue, AllowCommute: bool) -> SDValue {
    if LHS.getOpcode() != EXTRACT_SUBVECTOR || RHS.getOpcode() != EXTRACT_SUBVECTOR || LHS.getValueType() != RHS.getValueType() || LHS.getOperand(0) != RHS.getOperand(0) {
        return SDValue {};
    }
    let mut Src: SDValue = LHS.getOperand(0);
    if Src.getValueSizeInBits() != (LHS.getValueSizeInBits() * 2) {
        return SDValue {};
    }
    let mut NumElts: u32 = LHS.getValueType().getVectorNumElements();
    if (LHS.getConstantOperandAPInt(1) == 0 && RHS.getConstantOperandAPInt(1) == NumElts) || (AllowCommute && RHS.getConstantOperandAPInt(1) == 0 && LHS.getConstantOperandAPInt(1) == NumElts) {
        return Src;
    }
    return SDValue {};
}

fn extractSubVector(Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc, vectorWidth: u32) -> SDValue {
    let mut VT: EVT = Vec.getValueType();
    let mut ElVT: EVT = VT.getVectorElementType();
    let mut ResultNumElts: u32 = (VT.getVectorNumElements() * vectorWidth) / VT.getSizeInBits().operator unsigned long long();
    let mut ResultVT: EVT = getVectorVT(*DAG.getContext(), ElVT, ResultNumElts, false);
    assert!(ResultVT.getSizeInBits().operator unsigned long long() == vectorWidth, "Illegal subvector extraction");
    let mut ElemsPerChunk: u32 = vectorWidth / ElVT.getSizeInBits().operator unsigned long long();
    assert!(isPowerOf2_32(ElemsPerChunk), "Elements per chunk not power of 2");
    IdxVal &= ~(ElemsPerChunk - 1);
    if Vec.getOpcode() == BUILD_VECTOR {
        return DAG.getBuildVector(ResultVT, dl, operator(Vec).ops().slice(IdxVal, ElemsPerChunk));
    }
    if Vec.getOpcode() == INSERT_SUBVECTOR && Vec.getOperand(0).isUndef() && Vec.getOperand(1).getValueType().getVectorNumElements() <= IdxVal && isNullConstant(Vec.getOperand(2)) {
        return DAG.getUNDEF(ResultVT);
    }
    return DAG.getExtractSubvector(dl, ResultVT, Vec, IdxVal);
}

fn extract128BitVector(Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!((Vec.getValueType().is256BitVector() || Vec.getValueType().is512BitVector()), "Unexpected vector size!");
    return extractSubVector(Vec, IdxVal, DAG, dl, 128);
}

fn extract256BitVector(Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!(Vec.getValueType().is512BitVector(), "Unexpected vector size!");
    return extractSubVector(Vec, IdxVal, DAG, dl, 256);
}

fn insertSubVector(Result: SDValue, Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc, vectorWidth: u32) -> SDValue {
    assert!((vectorWidth == 128 || vectorWidth == 256), "Unsupported vector width");
    if Vec.isUndef() {
        return Result;
    }
    let mut VT: EVT = Vec.getValueType();
    let mut ElemsPerChunk: u32 = vectorWidth / VT.getScalarSizeInBits();
    assert!(isPowerOf2_32(ElemsPerChunk), "Elements per chunk not power of 2");
    IdxVal &= ~(ElemsPerChunk - 1);
    return DAG.getInsertSubvector(dl, Result, Vec, IdxVal);
}

fn insert128BitVector(Result: SDValue, Vec: SDValue, IdxVal: u32, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!(Vec.getValueType().is128BitVector(), "Unexpected vector size!");
    return insertSubVector(Result, Vec, IdxVal, DAG, dl, 128);
}

fn widenSubVector(VT: MVT, Vec: SDValue, ZeroNewElements: bool, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut VecVT: EVT = Vec.getValueType();
    assert!(VecVT.getFixedSizeInBits() <= VT.getFixedSizeInBits() && VecVT.getScalarType() == EVT { VT.getScalarType() }, "Unsupported vector widening type");
    if Vec.getOpcode() == BUILD_VECTOR && VecVT.is256BitVector() {
        let mut NumSrcElts: u32 = VecVT.getVectorNumElements();
        let mut Hi: ArrayRef<SDUse> = operator(Vec).ops().drop_front(NumSrcElts / 2);
        if all_of(Hi, Closure_11 { ZeroNewElements: &mut ZeroNewElements }) {
            Vec = extract128BitVector(Vec, 0, DAG, dl);
        }
    }
    let mut Res: SDValue = if ZeroNewElements { getZeroVector(VT, Subtarget, DAG, dl) } else { DAG.getUNDEF(EVT { VT }) };
    return DAG.getInsertSubvector(dl, Res, Vec, 0);
}

fn widenSubVector(Vec: SDValue, ZeroNewElements: bool, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc, WideSizeInBits: u32) -> SDValue {
    assert!(Vec.getValueSizeInBits().operator unsigned long long() <= WideSizeInBits && (WideSizeInBits % Vec.getScalarValueSizeInBits()) == 0, "Unsupported vector widening type");
    let mut WideNumElts: u32 = WideSizeInBits / Vec.getScalarValueSizeInBits();
    let mut SVT: MVT = Vec.getSimpleValueType().getScalarType();
    let mut VT: MVT = getVectorVT(SVT, WideNumElts);
    return widenSubVector(VT, Vec, ZeroNewElements, Subtarget, DAG, dl);
}

fn widenMaskVectorType(VT: MVT, Subtarget: *X86Subtarget) -> MVT {
    assert!(VT.getVectorElementType() == i1, "Expected bool vector");
    let mut NumElts: u32 = VT.getVectorNumElements();
    if (operator!(Subtarget()()) && NumElts == 8) || NumElts < 8 {
        return if Subtarget()() { v8i1 } else { v16i1 };
    }
    return VT;
}

fn widenMaskVector(Vec: SDValue, ZeroNewElements: bool, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut VT: MVT = widenMaskVectorType(Vec.getSimpleValueType(), Subtarget);
    return widenSubVector(VT, Vec, ZeroNewElements, Subtarget, DAG, dl);
}

fn collectConcatOps(N: *mut SDNode, Ops: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) -> bool {
    (((operator!(operator!((Ops()() && "Expected an empty ops vector")))) || (_wassert(L"Ops.empty() && \"Expected an empty ops vector\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (4591) as u32) , 0)) as void);
    if N.getOpcode() == CONCAT_VECTORS {
        Ops()(N.op_begin(), N.op_end());
        return true;
    }
    if N.getOpcode() == INSERT_SUBVECTOR {
        let mut Src: SDValue = N.getOperand(0);
        let mut Sub: SDValue = N.getOperand(1);
        let mut Idx: *APInt = N.getConstantOperandAPInt(2);
        let mut VT: EVT = Src.getValueType();
        let mut SubVT: EVT = Sub.getValueType();
        if VT.getSizeInBits() == (SubVT.getSizeInBits() * 2) {
            if Idx == 0 && Src.isUndef() {
                Ops()(Sub);
                Ops()(DAG.getUNDEF(SubVT));
                return true;
            }
            if Idx == (VT.getVectorNumElements() / 2) {
                if Src.getOpcode() == INSERT_SUBVECTOR && Src.getOperand(1).getValueType() == SubVT && isNullConstant(Src.getOperand(2)) {
                    let mut Lo: SDValue = Src.getOperand(1);
                    let mut Hi: SDValue = Sub;
                    let mut LoOps: SmallVector<SDValue, 2> = zeroed();
                    let mut HiOps: SmallVector<SDValue, 2> = zeroed();
                    if collectConcatOps(Lo.getNode(), DAG) && collectConcatOps(Hi.getNode(), DAG) && () == () {
                        Ops()();
                        Ops()();
                        return true;
                    }
                    Ops()(Lo);
                    Ops()(Hi);
                    return true;
                }
                if Sub.getOpcode() == EXTRACT_SUBVECTOR && Sub.getOperand(0) == Src && isNullConstant(Sub.getOperand(1)) {
                    Ops()(2, Sub);
                    return true;
                }
                if Src.isUndef() {
                    Ops()(DAG.getUNDEF(SubVT));
                    Ops()(Sub);
                    return true;
                }
            }
        }
    }
    if N.getOpcode() == EXTRACT_SUBVECTOR {
        let mut VT: EVT = N.getValueType(0);
        let mut Src: SDValue = N.getOperand(0);
        let mut Idx: u64 = N.getConstantOperandVal(1);
        let mut SrcOps: SmallVector<SDValue, 4> = zeroed();
        if collectConcatOps(Src.getNode(), DAG) && VT.getSizeInBits() > [0]() && (VT.getSizeInBits() % [0]()) == 0 && (Idx % [0]()()) == 0 {
            let mut SubIdx: u32 = Idx / [0]()();
            let mut NumSubs: u32 = VT.getSizeInBits() / [0]();
            Ops()(() + SubIdx, () + SubIdx + NumSubs);
            return true;
        }
    }
    (((operator!(operator!((Ops()() && "Expected an empty ops vector")))) || (_wassert(L"Ops.empty() && \"Expected an empty ops vector\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (4667) as u32) , 0)) as void);
    return false;
}

fn isUpperSubvectorUndef(V: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut SubOps: i32 = 0;
    if operator!(collectConcatOps(V.getNode(), DAG)) {
        return SDValue {};
    }
    let mut NumSubOps: u32 = ();
    let mut HalfNumSubOps: u32 = NumSubOps / 2;
    assert!((NumSubOps % 2) == 0, "Unexpected number of subvectors");
    let mut UpperOps: ArrayRef<SDValue> = zeroed();
    if any_of(Closure_12 {}) {
        return SDValue {};
    }
    let mut HalfVT: EVT = V.getValueType().getHalfNumVectorElementsVT(*DAG.getContext());
    let mut LowerOps: ArrayRef<SDValue> = zeroed();
    return DAG(CONCAT_VECTORS, DL, HalfVT);
}

fn isFreeToSplitVector(V: SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut Ops: i32 = 0;
    return collectConcatOps(V.getNode(), DAG);
}

fn splitVector(Op: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc) -> pair<SDValue, SDValue> {
    let mut VT: EVT = Op.getValueType();
    let mut NumElems: u32 = VT.getVectorNumElements();
    let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    assert!((NumElems % 2) == 0 && (SizeInBits % 2) == 0, "Can't split odd sized vector");
    let mut SubOps: SmallVector<SDValue, 4> = zeroed();
    if collectConcatOps(Op.getNode(), DAG) {
        (((operator!(operator!(((SubOps()() % 2) == 0 && "Can't split odd sized vector concat")))) || (_wassert(L"(SubOps.size() % 2) == 0 && \"Can't split odd sized vector concat\"", L"llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", (4709) as u32) , 0)) as void);
        let mut HalfOps: u32 = () / 2;
        let mut HalfVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
        let mut LoOps: SmallVector<SDValue, 2> = zeroed();
        let mut HiOps: SmallVector<SDValue, 2> = zeroed();
        let mut Lo: SDValue = DAG(CONCAT_VECTORS, dl, HalfVT);
        let mut Hi: SDValue = DAG(CONCAT_VECTORS, dl, HalfVT);
        return make_pair(Lo, Hi);
    }
    let mut Lo: SDValue = extractSubVector(Op, 0, DAG, dl, SizeInBits / 2);
    if DAG.isSplatValue(Op, false) {
        return make_pair(Lo, Lo);
    }
    let mut Hi: SDValue = extractSubVector(Op, NumElems / 2, DAG, dl, SizeInBits / 2);
    return make_pair(Lo, Hi);
}

fn splitVectorOp(Op: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut NumOps: u32 = Op.getNumOperands();
    let mut VT: EVT = Op.getValueType();
    let mut LoOps: i32 = NumOps;
    let mut HiOps: i32 = NumOps;
    for let mut I: u32 = 0; I != NumOps; I += 1 {
        let mut SrcOp: SDValue = Op.getOperand(I);
        if !SrcOp.getValueType().isVector() {
            LoOps()[I] = [I] = SrcOp;
            continue;
        }
        tie([I], [I]) = splitVector(SrcOp, DAG, dl);
    }
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = DAG.GetSplitDestVTs;
    return DAG(CONCAT_VECTORS, dl, VT, DAG(Op.getOpcode(), dl, LoVT), DAG(Op.getOpcode(), dl, HiVT));
}

fn splitVectorIntUnary(Op: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!((Op.getOperand(0).getValueType().is256BitVector() || Op.getOperand(0).getValueType().is512BitVector()) && (VT.is256BitVector() || VT.is512BitVector()), "Unsupported VT!");
    assert!(Op.getOperand(0).getValueType().getVectorNumElements() == VT.getVectorNumElements(), "Unexpected VTs!");
    return splitVectorOp(Op, DAG, dl);
}

fn splitVectorIntBinary(Op: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(Op.getOperand(0).getValueType() == VT && Op.getOperand(1).getValueType() == VT, "Unexpected VTs!");
    assert!((VT.is256BitVector() || VT.is512BitVector()), "Unsupported VT!");
    return splitVectorOp(Op, DAG, dl);
}

