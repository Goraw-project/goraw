fn checkBitcastSrcVectorSize(Src: SDValue, Size: u32, AllowTruncate: bool, Depth: u32) -> bool {
    if Depth >= MaxRecursionDepth {
        return false;
    }
    match Src.getOpcode() {
        TRUNCATE => {
            if !AllowTruncate {
                return false;
            }
        },
        SETCC => {
            return Src.getOperand(0).getValueSizeInBits().operator unsigned long long() == Size;
        },
        FREEZE => {
            return checkBitcastSrcVectorSize(Src.getOperand(0), Size, AllowTruncate, Depth + 1);
        },
        AND => {
            XOR;
        },
        SELECT => {
            VSELECT;
        },
        BUILD_VECTOR => {
            return isBuildVectorAllZeros(Src.getNode()) || isBuildVectorAllOnes(Src.getNode());
        },
    }
    return false;
}

