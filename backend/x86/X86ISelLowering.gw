    DL: *mut SDLoc,
    Subtarget: *mut X86Subtarget,
    Depth: *mut u32,
}

unsafe fn Closure_251::call(self: *mut Closure_251, VT: EVT, SubOps: ArrayRef<SDValue>, I: u32) -> SDValue {
            let mut Subs: SmallVector<SDValue> = SmallVector<SDValue> {};
            for SubOp in SubOps {
                Subs.push(SubOp.getOperand(I));
            }
            let mut SubVT: EVT = peekThroughBitcasts(Subs[0]).getValueType();
            if SubVT.isSimple() && SubVT.isVector() {
                let mut ConcatVT: EVT = getVectorVT(*(*self.DAG).getContext(), SubVT.getSimpleVT().getScalarType(), SubVT.getVectorElementCount() * Subs.len);
                if ConcatVT.isSimple() {
                    for Sub in Subs {
                        Sub = (*self.DAG).getBitcast(SubVT, Sub);
                    }
                    if combineConcatVectorOps((*self.DL), ConcatVT.getSimpleVT(), Subs, (*self.DAG), (*self.Subtarget), (*self.Depth) + 1) {
                        ConcatSrc;
                    } else {
                        return (*self.DAG).getBitcast(VT, ConcatSrc);
                    }
                    return (*self.DAG).getBitcast(VT, (*self.DAG).getNode(CONCAT_VECTORS, (*self.DL), ConcatVT, Subs));
                }
            }
            return (*self.DAG).getNode(CONCAT_VECTORS, (*self.DL), VT, Subs);
        }

