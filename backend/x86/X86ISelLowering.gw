fn X86TargetLowering::useLoadStackGuardNode(self: *X86TargetLowering, M: *Module) -> bool {
    return self.Subtarget.isTargetMachO() && self.Subtarget();
}

fn X86TargetLowering::useStackGuardMixFP(self: *X86TargetLowering) -> bool {
    return self.Subtarget.getTargetTriple().isOSMSVCRT() && !self.Subtarget.isTargetMachO();
}

fn X86TargetLowering::emitStackGuardMixFP(self: *X86TargetLowering, DAG: *mut SelectionDAG, Val: SDValue, DL: *SDLoc) -> SDValue {
    let mut PtrTy: EVT = self.getPointerTy;
    let mut XorOp: u32 = 0;
    let mut Node: *mut MachineSDNode = DAG.getMachineNode(XorOp, DL, PtrTy, Val);
    return SDValue { Node: Node, ResNo: 0 };
}

fn X86TargetLowering::getPreferredVectorAction(self: *X86TargetLowering, VT: MVT) -> LegalizeTypeAction {
    if (VT == v32i1 || VT == v64i1) && self.Subtarget.hasAVX512() && operator!(self.Subtarget()) {
        return TypeSplitVector;
    }
    if !VT.isScalableVector() && VT.getVectorNumElements() != 1 && VT.getVectorNumElements() <= 4 && operator!(self.Subtarget()) && VT.getVectorElementType() == f16 {
        return TypeSplitVector;
    }
    if !VT.isScalableVector() && VT.getVectorNumElements() != 1 && VT.getVectorElementType() != i1 {
        return TypeWidenVector;
    }
    return self.getPreferredVectorAction;
}

fn X86TargetLowering::createFastISel(self: *X86TargetLowering, funcInfo: *mut FunctionLoweringInfo, libInfo: *TargetLibraryInfo, libcallLowering: *LibcallLoweringInfo) -> *mut FastISel {
    return createFastISel(funcInfo, libInfo, libcallLowering);
}

fn mayFoldLoad(Op: SDValue, Subtarget: *X86Subtarget, AssumeSingleUse: bool, IgnoreAlignment: bool) -> bool {
    if !AssumeSingleUse && !Op.hasOneUse() {
        return false;
    }
    if !isNormalLoad(Op.getNode()) {
        return false;
    }
    let mut Ld: *mut auto = cast(Op.getNode());
    if !IgnoreAlignment && !Subtarget.hasAVX() && operator!(Subtarget()()) && (0) == 128 && () < Align { ShiftValue: 16 } {
        return false;
    }
    return true;
}

fn mayFoldLoadIntoBroadcastFromMem(Op: SDValue, EltVT: MVT, Subtarget: *X86Subtarget, AssumeSingleUse: bool) -> bool {
    assert!(Subtarget.hasAVX(), "Expected AVX for broadcast from memory");
    if !mayFoldLoad(Op, Subtarget, AssumeSingleUse, false) {
        return false;
    }
    let mut Ld: *mut auto = cast(Op.getNode());
    return operator!() || (0) == EltVT.getScalarSizeInBits();
}

fn mayFoldIntoStore(Op: SDValue) -> bool {
    if !Op.hasOneUse() {
        return false;
    }
    let mut User: *mut SDNode = operator(operator(Op).user_begin());
    while User.getOpcode() == BITCAST {
        if !User.hasOneUse() {
            return false;
        }
        User = operator(User.user_begin());
    }
    return isNormalStore(User) || User.getOpcode() == ATOMIC_STORE;
}

fn mayFoldIntoZeroExtend(Op: SDValue) -> bool {
    if Op.hasOneUse() {
        let mut Opcode: u32 = operator(Op.getNode().user_begin()).getOpcode();
        return (ZERO_EXTEND == Opcode);
    }
    return false;
}

fn mayFoldIntoVector(Op: SDValue, DAG: *SelectionDAG, Subtarget: *X86Subtarget) -> bool {
    if peekThroughBitcasts(Op).getValueType().isVector() {
        return true;
    }
    if isa(Op) || isa(Op) {
        return true;
    }
    let mut VT: EVT = Op.getValueType();
    let mut Opcode: u32 = Op.getOpcode();
    if (VT == EVT { i128 } || VT == EVT { i256 } || VT == EVT { i512 }) && DAG.getTargetLoweringInfo().getOperationAction == Custom {
        match Opcode {
            BITREVERSE => {
                return true;
            },
            SHL => {
                SRL;
            },
            AND => {
                OR;
            },
            SELECT => {
                return mayFoldIntoVector(Op.getOperand(1), DAG, Subtarget) && mayFoldIntoVector(Op.getOperand(2), DAG, Subtarget);
            },
        }
    }
    return mayFoldLoad(Op, Subtarget, true, true);
}

