fn isAddSubOrSubAddMask(Mask: ArrayRef<int>, Op0Even: *mut bool) -> bool {
    let mut ParitySrc: [2]i32 = [-1, -1];
    let mut Size: u32 = Mask.len;
    for let mut i: u32 = 0; i != Size; i += 1 {
        let mut M: i32 = Mask[i];
        if M < 0 {
            continue;
        }
        if (M % Size) != i {
            return false;
        }
        let mut Src: i32 = M / Size;
        if ParitySrc[i % 2] >= 0 && ParitySrc[i % 2] != Src {
            return false;
        }
        ParitySrc[i % 2] = Src;
    }
    if ParitySrc[0] < 0 || ParitySrc[1] < 0 || ParitySrc[0] == ParitySrc[1] {
        return false;
    }
    Op0Even = ParitySrc[0] == 0;
    return true;
}

fn isAddSubOrSubAdd(N: *mut SDNode, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG, Opnd0: *mut SDValue, Opnd1: *mut SDValue, IsSubAdd: *mut bool, HasAllowContract: *mut bool) -> bool {
