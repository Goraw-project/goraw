        }
        UniqueElt() = Elt;
    }
    return NumUndefs <= Mask.len / 2 && ();
}

fn lowerShuffleAsDecomposedShuffleMerge(DL: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue, Mask: ArrayRef<int>, Zeroable: *APInt, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
