                    return Op0.getOperand(0);
                }
            }
        },
        AND => {
            XOR;
        },
    }
    return SDValue {};
}

fn signExtendBitcastSrcVector(DAG: *mut SelectionDAG, SExtVT: EVT, Src: SDValue, DL: *SDLoc) -> SDValue {
    match Src.getOpcode() {
        SETCC => {
            FREEZE;
        },
        AND => {
            XOR;
        },
        SELECT => {
            VSELECT;
        },
    }
    llvm_unreachable_internal("Unexpected node type for vXi1 sign extension", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 46769);
}

fn combineBitcastvxi1(DAG: *mut SelectionDAG, VT: EVT, Src: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut SrcVT: EVT = Src.getValueType();
    if Subtarget()() || !SrcVT.isSimple() || SrcVT.getScalarType() != EVT { i1 } {
        return SDValue {};
    }
    if Subtarget.hasSSE1() && !Subtarget.hasSSE2() {
        if adjustBitcastSrcVectorSSE1(DAG, Src, DL) {
            V;
        } else {
            V = DAG;
            return DAG.getZExtOrTrunc(V, DL, VT);
        }
    }
    let mut PreferMovMsk: bool = Src.getOpcode() == TRUNCATE && Src.hasOneUse() && (Src.getOperand(0).getValueType() == EVT { v16i8 } || Src.getOperand(0).getValueType() == EVT { v32i8 } || Src.getOperand(0).getValueType() == EVT { v64i8 });
    if Src.getOpcode() == SETCC && Src.hasOneUse() && cast(Src.getOperand(2))() == SETLT && isBuildVectorAllZeros(Src.getOperand(1).getNode()) {
        let mut CmpVT: EVT = Src.getOperand(0).getValueType();
        let mut EltVT: EVT = CmpVT.getVectorElementType();
        if CmpVT.getSizeInBits().operator unsigned long long() <= 256 && (EltVT == EVT { i8 } || EltVT == EVT { i32 } || EltVT == EVT { i64 }) {
            PreferMovMsk = true;
        }
    }
    if !Subtarget.hasSSE2() || (Subtarget.hasAVX512() && !PreferMovMsk) {
        return SDValue {};
    }
    let mut SubSrcOps: SmallVector<SDValue, 4> = zeroed();
    if collectConcatOps(Src.getNode(), DAG) && () >= 2 {
        let mut LowerOp: SDValue = [0];
        let mut UpperOps: ArrayRef<SDValue> = zeroed();
        if LowerOp.getOpcode() == SETCC && all_of(Closure_158 {}) {
            let mut SubVT: EVT = VT.getIntegerVT(*DAG.getContext(), LowerOp.getValueType().getVectorMinNumElements());
            if combineBitcastvxi1(DAG, SubVT, LowerOp, DL, Subtarget) {
                V;
            } else {
                let mut IntVT: EVT = VT.getIntegerVT(*DAG.getContext(), VT.getSizeInBits().operator unsigned long long());
                return DAG.getBitcast(VT, DAG.getNode(ANY_EXTEND, DL, IntVT, V));
            }
        }
    }
    let mut SExtVT: MVT = MVT {};
    let mut PropagateSExt: bool = false;
    match SrcVT.getSimpleVT().SimpleTy {
        _ => {
            return SDValue {};
        },
        v2i1 => {
            SExtVT = MVT { SimpleTy: v2i64 };
        },
        v4i1 => {
            SExtVT = MVT { SimpleTy: v4i32 };
        },
        v8i1 => {
            SExtVT = MVT { SimpleTy: v8i16 };
        },
        v16i1 => {
            SExtVT = MVT { SimpleTy: v16i8 };
        },
        v32i1 => {
            SExtVT = MVT { SimpleTy: v32i8 };
        },
        v64i1 => {
            if Subtarget.hasAVX512() {
                if Subtarget()() {
                    return SDValue {};
                }
                SExtVT = MVT { SimpleTy: v64i8 };
                break;
            }
        },
    }
    let mut V: SDValue = if PropagateSExt { signExtendBitcastSrcVector(DAG, EVT { SExtVT }, Src, DL) } else { DAG.getNode(SIGN_EXTEND, DL, EVT { SExtVT }, Src) };
    if SExtVT == v16i8 || SExtVT == v32i8 || SExtVT == v64i8 {
        V = getMOVMSK(DL, V, DAG, Subtarget);
    } else {
        if SExtVT == v8i16 {
            V = widenSubVector(V, false, Subtarget, DAG, DL, 256);
            V = DAG.getNode(TRUNCATE, DL, EVT { v16i8 }, V);
        }
        V = DAG;
    }
    let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), SrcVT.getVectorNumElements());
    V = DAG.getZExtOrTrunc(V, DL, IntVT);
    return DAG.getBitcast(VT, V);
}

fn combinevXi1ConstantToInteger(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut SrcVT: EVT = Op.getValueType();
    assert!(SrcVT.getVectorElementType() == EVT { i1 }, "Expected a vXi1 vector");
    assert!(isBuildVectorOfConstantSDNodes(Op.getNode()), "Expected a constant build vector");
    let mut Imm: APInt = APInt { SrcVT.getVectorNumElements(), 0, false, false };
    for let mut Idx: u32 = 0;
let mut e: u32 = Op.getNumOperands(); Idx < e; Idx += 1 {
        let mut In: SDValue = Op.getOperand(Idx);
        if !In.isUndef() && (operator(In).getAsZExtVal() & 1) {
            Imm.setBit(Idx);
        }
    }
    let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), Imm.getBitWidth());
    return DAG.getConstant(Imm, SDLoc { Op }, IntVT, false, false);
}

fn combineCastedMaskArithmetic(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    assert!(N.getOpcode() == BITCAST, "Expected a bitcast");
    if !DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if !Subtarget.hasAVX512() {
        return SDValue {};
    }
    let mut DstVT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Op.getValueType();
    if !(SrcVT.isVectorOf(EVT { i1 }) && DstVT.isScalarInteger()) && !(DstVT.isVectorOf(EVT { i1 }) && SrcVT.isScalarInteger()) {
        return SDValue {};
    }
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if operator!(sd_match(Op, m_OneUse(m_BitwiseLogic(m_Value(LHS), m_Value(RHS))))) {
        return SDValue {};
    }
    if sd_match(LHS, m_OneUse(m_BitCast(m_SpecificVT(DstVT)))) || sd_match(RHS, m_OneUse(m_BitCast(m_SpecificVT(DstVT)))) {
        return DAG.getNode(Op.getOpcode(), SDLoc { N }, DstVT, DAG.getBitcast(DstVT, LHS), DAG.getBitcast(DstVT, RHS));
    }
    if isBuildVectorOfConstantSDNodes(RHS.getNode()) {
        RHS = combinevXi1ConstantToInteger(RHS, DAG);
        return DAG.getNode(Op.getOpcode(), SDLoc { N }, DstVT, DAG.getBitcast(DstVT, LHS), RHS);
    }
    return SDValue {};
}

fn createMMXBuildVector(BV: *mut BuildVectorSDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = SDLoc { BV };
    let mut NumElts: u32 = BV.getNumOperands();
    let mut Splat: SDValue = BV.getSplatValue(null);
    let mut CreateMMXElement: Closure_159 = Closure_159 { DAG: &mut DAG, Subtarget: &mut Subtarget, DL: &mut DL };
    let mut Ops: SmallVector<SDValue, 8> = zeroed();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if Splat {
        if Splat.isUndef() {
            return DAG.getUNDEF(EVT { x86mmx });
        }
        Splat = CreateMMXElement(Splat);
        if Subtarget.hasSSE1() {
            if NumElts == 8 {
                Splat = DAG(INTRINSIC_WO_CHAIN, DL, x86mmx, DAG, Splat, Splat);
            }
            let mut ShufMask: u32 = (if NumElts > 2 { 0 } else { 68 });
            return DAG(INTRINSIC_WO_CHAIN, DL, x86mmx, DAG, Splat, DAG.getTargetConstant(ShufMask, DL, EVT { i8 }, false));
        }
        Ops()(NumElts, Splat);
    } else {
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            Ops()(CreateMMXElement(BV.getOperand(i)));
        }
    }
    while Ops()() > 1 {
        let mut NumOps: u32 = ();
        let mut IntrinOp: u32 = 0;
        let mut Intrin: SDValue = DAG(IntrinOp, DL, TLI.getPointerTy);
        for let mut i: u32 = 0; i != NumOps; i += 2 {
            Ops()[i / 2] = DAG(INTRINSIC_WO_CHAIN, DL, x86mmx, Intrin, [i], [i + 1]);
        }
        Ops()(NumOps / 2);
    }
    return [0];
}

fn combineBitcastToBoolVector(VT: EVT, V: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, Depth: u32) -> SDValue {
    if Depth >= MaxRecursionDepth {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Opc: u32 = V.getOpcode();
    match Opc {
        BITCAST => {
            let mut Src: SDValue = V.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            if SrcVT.isVector() || SrcVT.isFloatingPoint() {
                return DAG.getBitcast(VT, Src);
            }
            break;
        },
        Constant => {
            let mut C: *mut auto = cast(V);
            if C()() {
                return DAG.getConstant(0, DL, VT, false, false);
            }
            if C()() {
                return DAG.getAllOnesConstant(DL, VT, false, false);
            }
            break;
        },
        TRUNCATE => {
            let mut Src: SDValue = V.getOperand(0);
            let mut NewSrcVT: EVT = getVectorVT(*DAG.getContext(), EVT { i1 }, Src.getValueSizeInBits().operator unsigned long long(), false);
            if TLI.isTypeLegal {
                if combineBitcastToBoolVector(NewSrcVT, Src, DL, DAG, Subtarget, Depth + 1) {
                    N0;
                } else {
                    return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, N0, DAG.getVectorIdxConstant(0, DL, false));
                }
            }
            break;
        },
        ANY_EXTEND => {
            ZERO_EXTEND;
        },
        OR => {
            XOR;
        },
        SHL => {
            let mut Src0: SDValue = V.getOperand(0);
            if (VT == EVT { v8i1 } && operator!(Subtarget()())) || ((VT == EVT { v32i1 } || VT == EVT { v64i1 }) && operator!(Subtarget()())) {
                break;
            }
            if  {
                if combineBitcastToBoolVector(VT, Src0, DL, DAG, Subtarget, Depth + 1) {
                    N0;
                } else {
                    return DAG;
                }
            }
            break;
        },
    }
    if Depth > 0 {
        if DAG {
            Alt;
        } else {
            return SDValue { Node: Alt, ResNo: 0 };
        }
    }
    return SDValue {};
}

fn combineBitcast(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = N0.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if DCI.isBeforeLegalize() {
        let mut dl: SDLoc = SDLoc { N };
        if combineBitcastvxi1(DAG, VT, N0, dl, Subtarget) {
            V;
        } else {
            return V;
        }
        if (VT == EVT { v4i1 } || VT == EVT { v2i1 }) && SrcVT.isScalarInteger() && Subtarget.hasAVX512() {
            N0 = DAG.getNode(ANY_EXTEND, dl, EVT { i8 }, N0);
            N0 = DAG.getBitcast(EVT { v8i1 }, N0);
            return DAG.getNode(EXTRACT_SUBVECTOR, dl, VT, N0, DAG.getVectorIdxConstant(0, dl, false));
        }
        if (SrcVT == EVT { v4i1 } || SrcVT == EVT { v2i1 }) && VT.isScalarInteger() && Subtarget.hasAVX512() {
            if N0.getOpcode() == CONCAT_VECTORS {
                let mut LastOp: SDValue = N0.getOperand(N0.getNumOperands() - 1);
                if isBuildVectorAllZeros(LastOp.getNode()) {
                    SrcVT = LastOp.getValueType();
                    let mut NumConcats: u32 = 8 / SrcVT.getVectorNumElements();
                    let mut Ops: SmallVector<SDValue, 4> = zeroed();
                    Ops()(NumConcats, DAG.getConstant(0, dl, SrcVT, false, false));
                    N0 = DAG(CONCAT_VECTORS, dl, v8i1);
                    N0 = DAG.getBitcast(EVT { i8 }, N0);
                    return DAG.getNode(TRUNCATE, dl, VT, N0);
                }
            }
            let mut NumConcats: u32 = 8 / SrcVT.getVectorNumElements();
            let mut Ops: SmallVector<SDValue, 4> = zeroed();
            Ops()[0] = N0;
            N0 = DAG(CONCAT_VECTORS, dl, v8i1);
            N0 = DAG.getBitcast(EVT { i8 }, N0);
            return DAG.getNode(TRUNCATE, dl, VT, N0);
        }
    } else if DCI.isAfterLegalizeDAG() {
        if VT.isVectorOf(EVT { i1 }) && SrcVT.isScalarInteger() && TLI.isTypeLegal {
            if combineBitcastToBoolVector(VT, N0, SDLoc { N }, DAG, Subtarget, 0) {
                V;
            } else {
                return V;
            }
        }
    }
    if VT == EVT { i8 } && SrcVT == EVT { v8i1 } && Subtarget.hasAVX512() && operator!(Subtarget()()) && N0.getOpcode() == EXTRACT_SUBVECTOR && N0.getOperand(0).getValueType() == EVT { v16i1 } && isNullConstant(N0.getOperand(1)) {
        return DAG.getNode(TRUNCATE, SDLoc { N }, VT, DAG.getBitcast(EVT { i16 }, N0.getOperand(0)));
    }
    if  {
        let mut BCast: *mut auto = cast(N0);
        let mut SrcVTSize: u32 = SrcVT.getScalarSizeInBits();
        let mut MemSize: u32 = ()();
        if MemSize >= 32 {
            let mut MemVT: MVT = if VT.isFloatingPoint() { getFloatingPointVT(MemSize) } else { getIntegerVT(MemSize) };
            let mut LoadVT: MVT = if VT.isFloatingPoint() { getFloatingPointVT(SrcVTSize) } else { getIntegerVT(SrcVTSize) };
            LoadVT = getVectorVT(LoadVT, SrcVT.getVectorNumElements());
            let mut Tys: SDVTList = DAG.getVTList(EVT { LoadVT }, EVT { Other });
            let mut Ops: []SDValue = void { (), () };
            let mut ResNode: SDValue = DAG;
            DAG.ReplaceAllUsesOfValueWith(ResNode.getValue(1));
            return DAG.getBitcast(VT, ResNode);
        }
    }
    if VT == EVT { f16 } && SrcVT == EVT { i16 } {
        let mut Src: SDValue = peekThroughTruncates(N0);
        if Src.getOpcode() == EXTRACT_VECTOR_ELT && Src.getOperand(0).getValueSizeInBits().operator unsigned long long() == 128 && isNullConstant(Src.getOperand(1)) {
            let mut DL: SDLoc = SDLoc { N };
            return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, DAG.getBitcast(EVT { v8f16 }, Src.getOperand(0)), DAG.getVectorIdxConstant(0, DL, false));
        }
    }
    if VT == EVT { x86mmx } {
        let mut UndefElts: APInt = APInt {};
        let mut EltBits: SmallVector<APInt, 1> = zeroed();
        if getTargetConstantBitsFromNode(N0, 64, UndefElts, true, true) {
            let mut DL: SDLoc = SDLoc { N0 };
            if EltBits()[0]() >= 32 {
                return DAG;
            }
            let mut F64: APFloat = IEEEdouble();
            return DAG.getBitcast(VT, DAG.getConstantFP(F64, DL, EVT { f64 }, false));
        }
        if N0.getOpcode() == BUILD_VECTOR && (SrcVT == EVT { v2i32 } || SrcVT == EVT { v4i16 } || SrcVT == EVT { v8i8 }) && N0.getOperand(0).getValueType() == SrcVT.getScalarType() {
            let mut LowUndef: bool = true;
            let mut AllUndefOrZero: bool = true;
            for let mut i: u32 = 1;
let mut e: u32 = SrcVT.getVectorNumElements(); i != e; i += 1 {
                let mut Op: SDValue = N0.getOperand(i);
                LowUndef &= Op.isUndef() || (i >= e / 2);
                AllUndefOrZero &= isNullConstantOrUndef(Op);
            }
            if AllUndefOrZero {
                let mut N00: SDValue = N0.getOperand(0);
                let mut dl: SDLoc = SDLoc { N00 };
                N00 = if LowUndef { DAG.getAnyExtOrTrunc(N00, dl, EVT { i32 }) } else { DAG.getZExtOrTrunc(N00, dl, EVT { i32 }) };
                return DAG;
            }
        }
        if N0.getOpcode() == BUILD_VECTOR && (SrcVT == EVT { v2f32 } || SrcVT == EVT { v2i32 } || SrcVT == EVT { v4i16 } || SrcVT == EVT { v8i8 }) {
            return createMMXBuildVector(cast(N0), DAG, Subtarget);
        }
        if (N0.getOpcode() == EXTRACT_VECTOR_ELT || N0.getOpcode() == EXTRACT_SUBVECTOR) && isNullConstant(N0.getOperand(1)) {
            let mut N00: SDValue = N0.getOperand(0);
            if N00.getValueType().is128BitVector() {
                return DAG;
            }
        }
        if SrcVT == EVT { v2i32 } && N0.getOpcode() == FP_TO_SINT {
            let mut DL: SDLoc = SDLoc { N0 };
            let mut Res: SDValue = DAG.getNode(CONCAT_VECTORS, DL, EVT { v4i32 }, N0, DAG.getUNDEF(EVT { v2i32 }));
            return DAG;
        }
    }
    if Subtarget.hasAVX512() && VT.isScalarInteger() && SrcVT.isVectorOf(EVT { i1 }) && isBuildVectorOfConstantSDNodes(N0.getNode()) {
        return combinevXi1ConstantToInteger(N0, DAG);
    }
    if Subtarget.hasAVX512() && SrcVT.isScalarInteger() && VT.isVector() && VT.getVectorElementType() == EVT { i1 } {
        if  {
            if C()() {
                return DAG.getConstant(1, SDLoc { N0 }, VT, false, false);
            }
            if C()() {
                return DAG.getConstant(0, SDLoc { N0 }, VT, false, false);
            }
        }
    }
    if Subtarget.hasAVX512() && SrcVT.isScalarInteger() && VT.isVectorOf(EVT { i1 }) && isPowerOf2_32(VT.getVectorNumElements()) {
        let mut NumElts: u32 = VT.getVectorNumElements();
        let mut Src: SDValue = N0;
        if N0.getOpcode() == TRUNCATE && N0.hasOneUse() {
            Src = N0.getOperand(0);
        }
        if  {
            let mut MovmskIn: SDValue = Src.getOperand(0);
            let mut MovmskVT: MVT = MovmskIn.getSimpleValueType();
            let mut MovMskElts: u32 = MovmskVT.getVectorNumElements();
            if MovMskElts <= NumElts && (Subtarget()() || MovmskVT.getVectorElementType() != i8) {
                let mut IntVT: EVT = EVT { MovmskVT }.changeVectorElementTypeToInteger();
                MovmskIn = DAG.getBitcast(IntVT, MovmskIn);
                let mut dl: SDLoc = SDLoc { N };
                let mut CmpVT: MVT = getVectorVT(MVT { SimpleTy: i1 }, MovMskElts);
                let mut Cmp: SDValue = DAG.getSetCC(dl, EVT { CmpVT }, MovmskIn, DAG.getConstant(0, dl, IntVT, false, false), SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
                if EVT { CmpVT } == VT {
                    return Cmp;
                }
                let mut NumConcats: u32 = NumElts / MovMskElts;
                let mut Ops: SmallVector<SDValue, 4> = zeroed();
                Ops()[0] = Cmp;
                return DAG(CONCAT_VECTORS, dl, VT);
            }
        }
    }
    if combineCastedMaskArithmetic(N, DAG, DCI, Subtarget) {
        V;
    } else {
        return V;
    }
    if N0.getOpcode() == INSERT_VECTOR_ELT && SrcVT.getScalarType() == VT && SrcVT.getVectorNumElements() == 1 {
        return N0.getOperand(1);
    }
    let mut FPOpcode: u32 = 0;
    match N0.getOpcode() {
        AND => {
            
        },
        OR => {
            
        },
        XOR => {
            
        },
        _ => {
            return SDValue {};
        },
    }
    if operator!(((Subtarget.hasSSE1() && VT == EVT { f32 }) || (Subtarget.hasSSE2() && VT == EVT { f64 }) || (Subtarget()() && VT == EVT { f16 }) || (Subtarget.hasSSE2() && VT.isInteger() && VT.isVector() && TLI.isTypeLegal))) {
        return SDValue {};
    }
    let mut LogicOp0: SDValue = N0.getOperand(0);
    let mut LogicOp1: SDValue = N0.getOperand(1);
    let mut DL0: SDLoc = SDLoc { N0 };
    if N0.hasOneUse() && LogicOp0.getOpcode() == BITCAST && LogicOp0.hasOneUse() && LogicOp0.getOperand(0).hasOneUse() && LogicOp0.getOperand(0).getValueType() == VT && !isa(LogicOp0.getOperand(0)) {
        let mut CastedOp1: SDValue = DAG.getBitcast(VT, LogicOp1);
        let mut Opcode: u32 = if VT.isFloatingPoint() { FPOpcode } else { N0.getOpcode() };
        return DAG.getNode(Opcode, DL0, VT, LogicOp0.getOperand(0), CastedOp1);
    }
    if N0.hasOneUse() && LogicOp1.getOpcode() == BITCAST && LogicOp1.hasOneUse() && LogicOp1.getOperand(0).hasOneUse() && LogicOp1.getOperand(0).getValueType() == VT && !isa(LogicOp1.getOperand(0)) {
        let mut CastedOp0: SDValue = DAG.getBitcast(VT, LogicOp0);
        let mut Opcode: u32 = if VT.isFloatingPoint() { FPOpcode } else { N0.getOpcode() };
        return DAG.getNode(Opcode, DL0, VT, LogicOp1.getOperand(0), CastedOp0);
    }
    return SDValue {};
}

fn detectExtMul(DAG: *mut SelectionDAG, Mul: *SDValue, Op0: *mut SDValue, Op1: *mut SDValue) -> bool {
    Op0 = Mul.getOperand(0);
    Op1 = Mul.getOperand(1);
    if Op0.getOpcode() == SIGN_EXTEND {
        swap(Op0, Op1);
    }
    let mut IsFreeTruncation: Closure_160 = Closure_160 {};
    if (IsFreeTruncation.call(Op0) && DAG.computeKnownBits(Op0, 0).countMaxActiveBits() <= 8) && (IsFreeTruncation.call(Op1) && DAG.ComputeMaxSignificantBits(Op1, 0) <= 8) {
        return true;
    }
    return false;
}

fn createVPDPBUSD(DAG: *mut SelectionDAG, LHS: SDValue, RHS: SDValue, LogBias: *mut u32, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut Vi8VT: MVT = getVectorVT(MVT { SimpleTy: i8 }, LHS.getValueType().getVectorElementCount());
    LHS = DAG.getZExtOrTrunc(LHS, DL, EVT { Vi8VT });
    RHS = DAG.getSExtOrTrunc(RHS, DL, EVT { Vi8VT });
    LogBias = 2;
    let mut RegSize: u32 = max(128, Vi8VT.getSizeInBits().operator unsigned long long() as u32);
    if Subtarget()() && operator!(Subtarget()()) {
        RegSize = max(512, RegSize);
    }
    let mut NumConcat: u32 = RegSize / Vi8VT.getSizeInBits().operator unsigned long long();
    let mut Ops: SmallVector<SDValue, 16> = zeroed();
    Ops()[0] = LHS;
    let mut ExtendedVT: MVT = getVectorVT(MVT { SimpleTy: i8 }, RegSize / 8);
    let mut DpOp0: SDValue = DAG(CONCAT_VECTORS, DL, ExtendedVT);
    Ops()[0] = RHS;
    let mut DpOp1: SDValue = DAG(CONCAT_VECTORS, DL, ExtendedVT);
    let mut DpBuilder: Closure_161 = Closure_161 {};
    let mut DpVT: MVT = getVectorVT(MVT { SimpleTy: i32 }, RegSize / 32);
    let mut Zero: SDValue = DAG.getConstant(0, DL, EVT { DpVT }, false, false);
    return SplitOpsAndApply(DAG, Subtarget, DL, DpVT, void { Zero, DpOp0, DpOp1 }, DpBuilder, false, Subtarget()());
}

fn createPSADBW(DAG: *mut SelectionDAG, N0: SDValue, N1: SDValue, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut DstVT: EVT = N0.getValueType();
    let mut SrcVT: EVT = getVectorVT(*DAG.getContext(), EVT { i8 }, DstVT.getVectorElementCount());
    let mut RegSize: u32 = max(128, SrcVT.getSizeInBits().operator unsigned long long() as u32);
    let mut NumConcat: u32 = RegSize / SrcVT.getSizeInBits().operator unsigned long long();
    let mut Ops: SmallVector<SDValue, 16> = zeroed();
    Ops()[0] = DAG.getZExtOrTrunc(N0, DL, SrcVT);
    let mut ExtendedVT: MVT = getVectorVT(MVT { SimpleTy: i8 }, RegSize / 8);
    let mut SadOp0: SDValue = DAG(CONCAT_VECTORS, DL, ExtendedVT);
    Ops()[0] = DAG.getZExtOrTrunc(N1, DL, SrcVT);
    let mut SadOp1: SDValue = DAG(CONCAT_VECTORS, DL, ExtendedVT);
    let mut PSADBWBuilder: Closure_162 = Closure_162 {};
    let mut SadVT: MVT = getVectorVT(MVT { SimpleTy: i64 }, RegSize / 64);
    return SplitOpsAndApply(DAG, Subtarget, DL, SadVT, void { SadOp0, SadOp1 }, PSADBWBuilder);
}

fn combineVECREDUCE_LOGIC(Reduce: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    if Reduce.getOpcode() != VECREDUCE_AND && Reduce.getOpcode() != VECREDUCE_OR && Reduce.getOpcode() != VECREDUCE_XOR {
        return SDValue {};
    }
    let mut BinOp: NodeType = getVecReduceBaseOpcode(Reduce.getOpcode());
    let mut Match: SDValue = Reduce.getOperand(0);
    let mut ExtractVT: EVT = Reduce.getValueType(0);
    let mut BitWidth: u32 = ExtractVT.getSizeInBits().operator unsigned long long();
    if ExtractVT != EVT { i64 } && ExtractVT != EVT { i32 } && ExtractVT != EVT { i16 } && ExtractVT != EVT { i8 } && ExtractVT != EVT { i1 } {
        return SDValue {};
    }
    if Match.getScalarValueSizeInBits() != BitWidth {
        return SDValue {};
    }
    let mut Movmsk: SDValue = SDValue {};
    let mut DL: SDLoc = SDLoc { Reduce };
    let mut MatchVT: EVT = Match.getValueType();
    let mut NumElts: u32 = MatchVT.getVectorNumElements();
    let mut MaxElts: u32 = if Subtarget.hasInt256() { 32 } else { 16 };
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    if ExtractVT == EVT { i1 } {
        if NumElts > 64 || !isPowerOf2_32(NumElts) {
            return SDValue {};
        }
        if Match.getOpcode() == SETCC {
            let mut CC: CondCode = cast(Match.getOperand(2))();
            if (BinOp == AND && CC == SETEQ) || (BinOp == OR && CC == SETNE) {
                let mut X86CC: CondCode = zeroed();
                let mut LHS: SDValue = DAG.getFreeze(Match.getOperand(0));
                let mut RHS: SDValue = DAG.getFreeze(Match.getOperand(1));
                let mut Mask: APInt = getAllOnes(LHS.getScalarValueSizeInBits());
                if LowerVectorAllEqual(DL, LHS, RHS, CC, Mask, Subtarget, DAG, X86CC) {
                    V;
                } else {
                    return DAG.getNode(TRUNCATE, DL, ExtractVT, getSETCC(X86CC, V, DL, DAG));
                }
            }
        }
        if TLI.isTypeLegal {
            let mut MovmskVT: EVT = getIntegerVT(Ctx, NumElts);
            Movmsk = DAG.getBitcast(MovmskVT, Match);
        } else {
            while NumElts > MaxElts {
                let mut Lo: SDValue = SDValue {};
                let mut Hi: SDValue = SDValue {};
                tie(Lo, Hi) = DAG.SplitVector(Match, DL);
                Match = DAG.getNode(BinOp, DL, Lo.getValueType(), Lo, Hi);
                NumElts /= 2;
            }
            let mut MovmskVT: EVT = getIntegerVT(Ctx, NumElts);
            Movmsk = combineBitcastvxi1(DAG, MovmskVT, Match, DL, Subtarget);
        }
        if !Movmsk {
            return SDValue {};
        }
        Movmsk = DAG.getZExtOrTrunc(Movmsk, DL, EVT { if NumElts > 32 { i64 } else { i32 } });
    } else {
        let mut MatchSizeInBits: u32 = Match.getValueSizeInBits().operator unsigned long long();
        if !(MatchSizeInBits == 128 || (MatchSizeInBits == 256 && Subtarget.hasAVX())) {
            return SDValue {};
        }
        if Match.getValueType().getVectorNumElements() < 2 {
            return SDValue {};
        }
        if DAG.ComputeNumSignBits(Match, 0) != BitWidth {
            return SDValue {};
        }
        if MatchSizeInBits == 256 && BitWidth < 32 && !Subtarget.hasInt256() {
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = DAG.SplitVector(Match, DL);
            Match = DAG.getNode(BinOp, DL, Lo.getValueType(), Lo, Hi);
            MatchSizeInBits = Match.getValueSizeInBits().operator unsigned long long();
        }
        let mut MaskSrcVT: MVT = MVT {};
        if 64 == BitWidth || 32 == BitWidth {
            MaskSrcVT = getVectorVT(getFloatingPointVT(BitWidth), MatchSizeInBits / BitWidth);
        } else {
            if BinOp == XOR && BitWidth != 8 {
                return SDValue {};
            }
            MaskSrcVT = getVectorVT(MVT { SimpleTy: i8 }, MatchSizeInBits / 8);
        }
        let mut BitcastLogicOp: SDValue = DAG.getBitcast(EVT { MaskSrcVT }, Match);
        Movmsk = getMOVMSK(DL, BitcastLogicOp, DAG, Subtarget);
        NumElts = MaskSrcVT.getVectorNumElements();
    }
    assert!((NumElts <= 32 || NumElts == 64), "Not expecting more than 64 elements");
    let mut Result: SDValue = SDValue {};
    let mut CmpVT: MVT = MVT { SimpleTy: if NumElts == 64 { i64 } else { i32 } };
    if BinOp == XOR {
        Result = DAG.getNode(PARITY, DL, EVT { CmpVT }, Movmsk);
    } else {
        let mut CmpC: SDValue = SDValue {};
        let mut CondCode: CondCode = zeroed();
        if BinOp == OR {
            CmpC = DAG.getConstant(0, DL, EVT { CmpVT }, false, false);
            CondCode = SETNE;
        } else {
            CmpC = DAG.getConstant(getLowBitsSet(CmpVT.getSizeInBits().operator unsigned long long(), NumElts), DL, EVT { CmpVT }, false, false);
            CondCode = SETEQ;
        }
        let mut SetccVT: EVT = TLI.getSetCCResultType;
        Result = DAG.getSetCC(DL, SetccVT, Movmsk, CmpC, CondCode, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    Result = DAG.getZExtOrTrunc(Result, DL, ExtractVT);
    return DAG.getNegative(Result, DL, ExtractVT);
}

fn combineVPDPBUSDPattern(Extract: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if operator!(Subtarget()()) && operator!(Subtarget()()) {
        return SDValue {};
    }
    let mut ExtractVT: EVT = Extract.getValueType(0);
    if ExtractVT != EVT { i32 } {
        return SDValue {};
    }
    let mut VT: EVT = Extract.getOperand(0).getValueType();
    if !isPowerOf2_32(VT.getVectorNumElements()) {
        return SDValue {};
    }
    let mut BinOp: NodeType = zeroed();
    let mut Root: SDValue = DAG.matchBinOpReduction;
    if !Root || Root.getOpcode() != MUL {
        return SDValue {};
    }
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if !detectExtMul(DAG, Root, LHS, RHS) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Extract };
    let mut StageBias: u32 = 0;
    let mut DP: SDValue = createVPDPBUSD(DAG, LHS, RHS, StageBias, DL, Subtarget);
    let mut Stages: u32 = Log2_32(VT.getVectorNumElements());
    let mut DpVT: EVT = DP.getValueType();
    if Stages > StageBias {
        let mut DpElems: u32 = DpVT.getVectorNumElements();
        for let mut i: u32 = Stages - StageBias; i > 0; i -= 1 {
            let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { DpElems, -1 };
            for let mut j: u32 = 0;
let mut MaskEnd: u32 = 1 << (i - 1); j < MaskEnd; j += 1 {
                Mask[j] = MaskEnd + j;
            }
            let mut Shuffle: SDValue = DAG.getVectorShuffle;
            DP = DAG.getNode(ADD, DL, DpVT, DP, Shuffle);
        }
    }
    let mut ResVT: EVT = getVectorVT(*DAG.getContext(), ExtractVT, DpVT.getSizeInBits().operator unsigned long long() / ExtractVT.getSizeInBits().operator unsigned long long(), false);
    DP = DAG.getBitcast(ResVT, DP);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, ExtractVT, DP, Extract.getOperand(1));
}

fn combineBasicSADPattern(Extract: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut ExtractVT: EVT = Extract.getValueType(0);
    if ExtractVT != EVT { i8 } && ExtractVT != EVT { i16 } && ExtractVT != EVT { i32 } && ExtractVT != EVT { i64 } {
        return SDValue {};
    }
    let mut VT: EVT = Extract.getOperand(0).getValueType();
    if !isPowerOf2_32(VT.getVectorNumElements()) {
        return SDValue {};
    }
    let mut BinOp: NodeType = zeroed();
    let mut Root: SDValue = DAG.matchBinOpReduction;
    if !Root {
        return SDValue {};
    }
    if Root.getOpcode() == SIGN_EXTEND || Root.getOpcode() == ZERO_EXTEND || Root.getOpcode() == ANY_EXTEND {
        Root = Root.getOperand(0);
    }
    let mut Src0: SDValue = SDValue {};
    let mut Src1: SDValue = SDValue {};
    if operator!(sd_match(Root, m_AnyOf(m_SpecificVectorElementVT(i8, m_c_BinOp(ABDU, m_Value(Src0), m_Value(Src1))), m_SpecificVectorElementVT(i8, m_Sub(m_UMax(m_Value(Src0), m_Value(Src1)), m_UMin(m_Deferred(Src0), m_Deferred(Src1)))), m_Abs(m_Sub(m_Value(Src0, m_ZExt(m_SpecificVectorElementVT(i8))), m_Value(Src1, m_ZExt(m_SpecificVectorElementVT(i8)))))))) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Extract };
    let mut SAD: SDValue = createPSADBW(DAG, Src0, Src1, DL, Subtarget);
    let mut Stages: u32 = Log2_32(VT.getVectorNumElements());
    let mut SadVT: EVT = SAD.getValueType();
    if Stages > 3 {
        let mut SadElems: u32 = SadVT.getVectorNumElements();
        for let mut i: u32 = Stages - 3; i > 0; i -= 1 {
            let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { SadElems, -1 };
            for let mut j: u32 = 0;
let mut MaskEnd: u32 = 1 << (i - 1); j < MaskEnd; j += 1 {
                Mask[j] = MaskEnd + j;
            }
            let mut Shuffle: SDValue = DAG.getVectorShuffle;
            SAD = DAG.getNode(ADD, DL, SadVT, SAD, Shuffle);
        }
    }
    let mut ExtractSizeInBits: u32 = ExtractVT.getSizeInBits().operator unsigned long long();
    let mut ResVT: EVT = getVectorVT(*DAG.getContext(), ExtractVT, SadVT.getSizeInBits().operator unsigned long long() / ExtractSizeInBits, false);
    SAD = DAG.getBitcast(ResVT, SAD);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, ExtractVT, SAD, Extract.getOperand(1));
}

fn combineExtractFromVectorLoad(N: *mut SDNode, VecVT: EVT, SrcVec: SDValue, Idx: u64, dl: *SDLoc, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    assert!(N.getOpcode() == EXTRACT_VECTOR_ELT, "Only EXTRACT_VECTOR_ELT supported so far");
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut VT: EVT = N.getValueType(0);
    let mut LikelyUsedAsVector: bool = any_of(N.users(), Closure_163 {});
    let mut LoadVec: *mut auto = dyn_cast(SrcVec);
    if LoadVec() && isNormalLoad() && VT.isInteger() && VecVT.getVectorElementType() == VT && VecVT.getSizeInBits() == SrcVec.getValueSizeInBits() && DCI.isAfterLegalizeDAG() && !LikelyUsedAsVector && () {
        let mut NewPtr: SDValue = TLI.getVectorElementPointer(DAG, VecVT, DAG.getVectorIdxConstant(Idx, dl, false));
        let mut PtrOff: u32 = VT.getSizeInBits() * Idx.operator unsigned long long() / 8;
        let mut MPI: MachinePointerInfo = ()(PtrOff);
        let mut Alignment: Align = commonAlignment(PtrOff);
        let mut Load: SDValue = DAG(VT, dl, NewPtr, MPI, Alignment, ()());
        DAG(Load);
        return Load;
    }
    return SDValue {};
}

fn combineExtractWithShuffle(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut dl: SDLoc = SDLoc { N };
    let mut Src: SDValue = N.getOperand(0);
    let mut Idx: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut SrcSVT: EVT = SrcVT.getVectorElementType();
    let mut SrcEltBits: u32 = SrcSVT.getSizeInBits().operator unsigned long long();
    let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
    if SrcSVT == EVT { i1 } || !isa(Idx) {
        return SDValue {};
    }
    let mut IdxC: *APInt = N.getConstantOperandAPInt(1);
    if IdxC.uge(NumSrcElts) {
        return SDValue {};
    }
    let mut SrcBC: SDValue = peekThroughBitcasts(Src);
    if  {
        let mut SrcOp: SDValue = SrcBC.getOperand(0);
        let mut SrcOpVT: EVT = SrcOp.getValueType();
        if SrcOpVT.isScalarInteger() && VT.isInteger() && (SrcOpVT.getSizeInBits().operator unsigned long long() % SrcEltBits) == 0 {
            let mut Scale: u32 = SrcOpVT.getSizeInBits().operator unsigned long long() / SrcEltBits;
            let mut Offset: u32 = IdxC.urem(Scale) * SrcEltBits;
            if Offset == 0 {
                SrcOp = DAG.getZExtOrTrunc(SrcOp, dl, SrcVT.getScalarType());
                SrcOp = DAG.getZExtOrTrunc(SrcOp, dl, VT);
                return SrcOp;
            }
        }
    }
    if  {
        let mut MemIntr: *mut auto = cast(SrcBC);
        let mut SrcBCWidth: u32 = SrcBC.getScalarValueSizeInBits();
        if MemIntr()()() == SrcBCWidth && VT.getSizeInBits().operator unsigned long long() == SrcBCWidth && SrcEltBits == SrcBCWidth {
            let mut Load: SDValue = DAG(VT, dl, ()());
            DAG.ReplaceAllUsesOfValueWith(Load.getValue(1));
            return Load;
        }
    }
    if SrcBC.getOpcode() == SCALAR_TO_VECTOR && VT.isInteger() && SrcBC.getValueType().isInteger() && (SrcBC.getScalarValueSizeInBits() % SrcEltBits) == 0 && SrcBC.getScalarValueSizeInBits() == SrcBC.getOperand(0).getValueSizeInBits().operator unsigned long long() {
        let mut Scale: u32 = SrcBC.getScalarValueSizeInBits() / SrcEltBits;
        if IdxC.ult(Scale) {
            let mut Offset: u32 = IdxC.getZExtValue() * SrcVT.getScalarSizeInBits();
            let mut Scl: SDValue = SrcBC.getOperand(0);
            let mut SclVT: EVT = Scl.getValueType();
            if Offset {
                Scl = DAG.getNode(SRL, dl, SclVT, Scl, DAG.getShiftAmountConstant(Offset, SclVT, dl));
            }
            Scl = DAG.getZExtOrTrunc(Scl, dl, SrcVT.getScalarType());
            Scl = DAG.getZExtOrTrunc(Scl, dl, VT);
            return Scl;
        }
    }
    if TRUNCATE == Src.getOpcode() && IdxC == 0 && (SrcVT.getSizeInBits().operator unsigned long long() % 128) == 0 {
        Src = extract128BitVector(Src.getOperand(0), 0, DAG, dl);
        let mut ExtractVT: MVT = getVectorVT(SrcSVT.getSimpleVT(), 128 / SrcEltBits);
        return DAG.getNode(N.getOpcode(), dl, VT, DAG.getBitcast(EVT { ExtractVT }, Src), Idx);
    }
    let mut GetLegalExtract: Closure_164 = Closure_164 { Subtarget: &mut Subtarget, DAG: &mut DAG, dl: &mut dl };
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
    let mut Ops: SmallVector<SDValue, 2> = zeroed();
    if operator!(getTargetShuffleInputs(SrcBC, Mask, DAG)) {
        return SDValue {};
    }
    if any_of(Closure_165 { cap_0: SrcVT }) {
        return SDValue {};
    }
    if Mask.len != NumSrcElts {
        if (NumSrcElts % Mask.len) == 0 {
            let mut ScaledMask: SmallVector<int, 16> = SmallVector<int, 16> {};
            let mut Scale: i32 = NumSrcElts / Mask.len;
            narrowShuffleMaskElts(Scale, Mask, ScaledMask);
            Mask = move(ScaledMask);
        } else if (Mask.len % NumSrcElts) == 0 {
            let mut ExtractIdx: i32 = IdxC.getZExtValue() as i32;
            let mut Scale: i32 = Mask.len / NumSrcElts;
            let mut Lo: i32 = Scale * ExtractIdx;
            let mut Hi: i32 = Scale * (ExtractIdx + 1);
            for let mut i: i32 = 0;
let mut e: i32 = Mask.len as i32; i != e; i += 1 {
                if i < Lo || Hi <= i {
                    Mask[i] = SM_SentinelUndef;
                }
            }
            let mut WidenedMask: SmallVector<int, 16> = SmallVector<int, 16> {};
            while Mask.len > NumSrcElts && canWidenShuffleElements(Mask, WidenedMask) {
                Mask = move(WidenedMask);
            }
        }
    }
    let mut ExtractIdx: i32 = 0;
    let mut ExtractVT: EVT = EVT {};
    if Mask.len == NumSrcElts {
        ExtractIdx = Mask[IdxC.getZExtValue()];
        ExtractVT = SrcVT;
    } else {
        let mut Scale: u32 = Mask.len / NumSrcElts;
        if (Mask.len % NumSrcElts) != 0 || SrcVT.isFloatingPoint() {
            return SDValue {};
        }
        let mut ScaledIdx: u32 = Scale * IdxC.getZExtValue();
        if !isUndefOrZeroInRange(Mask, ScaledIdx + 1, Scale - 1) {
            return SDValue {};
        }
        ExtractIdx = Mask[ScaledIdx];
        let mut ExtractSVT: EVT = getIntegerVT(*DAG.getContext(), SrcEltBits / Scale);
        ExtractVT = getVectorVT(*DAG.getContext(), ExtractSVT, Mask.len, false);
        assert!(SrcVT.getSizeInBits() == ExtractVT.getSizeInBits(), "Failed to widen vector type");
    }
    if ExtractIdx == SM_SentinelUndef {
        return DAG.getUNDEF(VT);
    }
    if ExtractIdx == SM_SentinelZero {
        return if VT.isFloatingPoint() { DAG.getConstantFP(0.0, dl, VT, false) } else { DAG.getConstant(0, dl, VT, false, false) };
    }
    let mut SrcOp: SDValue = [ExtractIdx / Mask.len];
    ExtractIdx = ExtractIdx % Mask.len;
    if GetLegalExtract.call(SrcOp, ExtractVT, ExtractIdx) {
        V;
    } else {
        return DAG.getZExtOrTrunc(V, dl, VT);
    }
    if N.getOpcode() == EXTRACT_VECTOR_ELT && ExtractVT == SrcVT {
        if combineExtractFromVectorLoad(N, SrcVT, peekThroughBitcasts(SrcOp), ExtractIdx, dl, DAG, DCI) {
            V;
        } else {
            return V;
        }
    }
    return SDValue {};
}

fn scalarizeExtEltFP(ExtElt: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget, DCI: *mut DAGCombinerInfo) -> SDValue {
    assert!(ExtElt.getOpcode() == EXTRACT_VECTOR_ELT, "Expected extract");
    let mut Vec: SDValue = ExtElt.getOperand(0);
    let mut Index: SDValue = ExtElt.getOperand(1);
    let mut VT: EVT = ExtElt.getValueType(0);
    let mut VecVT: EVT = Vec.getValueType();
    if !Vec.hasOneUse() || !isNullConstant(Index) || VecVT.getScalarType() != VT {
        return SDValue {};
    }
    if Vec.getOpcode() == SETCC && VT == EVT { i1 } {
        let mut OpVT: EVT = Vec.getOperand(0).getValueType().getScalarType();
        if OpVT != EVT { f32 } && OpVT != EVT { f64 } {
            return SDValue {};
        }
        let mut DL: SDLoc = SDLoc { ExtElt };
        let mut Ext0: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, OpVT, Vec.getOperand(0), Index);
        let mut Ext1: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, OpVT, Vec.getOperand(1), Index);
        return DAG.getNode(Vec.getOpcode(), DL, VT, Ext0, Ext1, Vec.getOperand(2));
    }
    if operator!((VT == EVT { f16 } && Subtarget()())) && VT != EVT { f32 } && VT != EVT { f64 } {
        return SDValue {};
    }
    if DCI.isBeforeLegalize() && Vec.getOpcode() == VSELECT && Vec.getOperand(0).getOpcode() == SETCC && Vec.getOperand(0).getOperand(0).getValueType() == VecVT && Vec.getOperand(0).getValueType().getScalarType() == EVT { i1 } {
        let mut DL: SDLoc = SDLoc { ExtElt };
        let mut Ext0: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, Vec.getOperand(0).getValueType().getScalarType(), Vec.getOperand(0), Index);
        let mut Ext1: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Vec.getOperand(1), Index);
        let mut Ext2: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Vec.getOperand(2), Index);
        return DAG.getNode(SELECT, DL, VT, Ext0, Ext1, Ext2);
    }
    match Vec.getOpcode() {
        FMA => {
            FMAD;
        },
        _ => {
            return SDValue {};
        },
    }
    llvm_unreachable_internal("All opcodes should return within switch", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 48219);
}

fn combineArithReduction(ExtElt: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    assert!(ExtElt.getOpcode() == EXTRACT_VECTOR_ELT, "Unexpected caller");
    if !Subtarget.hasSSE2() {
        return SDValue {};
    }
    let mut Opc: NodeType = zeroed();
    let mut Rdx: SDValue = DAG.matchBinOpReduction;
    if !Rdx {
        return SDValue {};
    }
    let mut Index: SDValue = ExtElt.getOperand(1);
    assert!(isNullConstant(Index), "Reduction doesn't end in an extract from index 0");
    let mut VT: EVT = ExtElt.getValueType(0);
    let mut VecVT: EVT = Rdx.getValueType();
    if VecVT.getScalarType() != VT {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { ExtElt };
    let mut NumElts: u32 = VecVT.getVectorNumElements();
    let mut EltSizeInBits: u32 = VecVT.getScalarSizeInBits();
    let mut WidenToV16I8: Closure_166 = Closure_166 { Subtarget: &mut Subtarget, DAG: &mut DAG, DL: &mut DL };
    if VecVT == EVT { v4i8 } || VecVT == EVT { v8i8 } {
        Rdx = WidenToV16I8.call(Rdx);
        Rdx = DAG;
        Rdx = DAG.getBitcast(EVT { v16i8 }, Rdx);
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Rdx, Index);
    }
    if (VecVT.getSizeInBits().operator unsigned long long() % 128) != 0 || !isPowerOf2_32(NumElts) {
        return SDValue {};
    }
    if VT == EVT { i8 } {
        while Rdx.getValueSizeInBits().operator unsigned long long() > 128 {
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = splitVector(Rdx, DAG, DL);
            VecVT = Lo.getValueType();
            Rdx = DAG.getNode(ADD, DL, VecVT, Lo, Hi);
        }
        assert!(VecVT == EVT { v16i8 }, "v16i8 reduction expected");
        let mut Hi: SDValue = DAG.getVectorShuffle(EVT { v16i8 }, DL, Rdx, Rdx, ArrayRef<int> { [8, 9, 10, 11, 12, 13, 14, 15, -1, -1, -1, -1, -1, -1, -1, -1] });
        Rdx = DAG.getNode(ADD, DL, EVT { v16i8 }, Rdx, Hi);
        Rdx = DAG;
        Rdx = DAG.getBitcast(EVT { v16i8 }, Rdx);
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Rdx, Index);
    }
    if Opc == ADD && NumElts >= 4 && EltSizeInBits >= 16 && EltSizeInBits <= 64 && DAG.computeKnownBits(Rdx, 0).getMaxValue().ule(255) && (EltSizeInBits == 16 || Rdx.getOpcode() == ZERO_EXTEND || Subtarget.hasAVX512()) {
        if Rdx.getValueType() == EVT { v8i16 } {
            Rdx = DAG;
        } else if NumElts == 4 {
            Rdx = DAG.getNode(TRUNCATE, DL, EVT { v4i16 }, Rdx);
            Rdx = DAG.getBitcast(EVT { v8i8 }, Rdx);
            Rdx = WidenToV16I8.call(Rdx);
        } else {
            let mut ByteVT: EVT = VecVT.changeVectorElementType(*DAG.getContext(), EVT { i8 });
            Rdx = DAG.getNode(TRUNCATE, DL, ByteVT, Rdx);
            if ByteVT.getSizeInBits().operator unsigned long long() < 128 {
                Rdx = WidenToV16I8.call(Rdx);
            }
        }
        let mut PSADBWBuilder: Closure_167 = Closure_167 {};
        let mut SadVT: MVT = getVectorVT(MVT { SimpleTy: i64 }, Rdx.getValueSizeInBits().operator unsigned long long() / 64);
        Rdx = SplitOpsAndApply(DAG, Subtarget, DL, SadVT, void { Rdx }, PSADBWBuilder);
        while Rdx.getValueSizeInBits().operator unsigned long long() > 128 {
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = splitVector(Rdx, DAG, DL);
            VecVT = Lo.getValueType();
            Rdx = DAG.getNode(ADD, DL, VecVT, Lo, Hi);
        }
        assert!(Rdx.getValueType() == EVT { v2i64 }, "v2i64 reduction expected");
        if NumElts > 8 {
            let mut RdxHi: SDValue = DAG.getVectorShuffle(EVT { v2i64 }, DL, Rdx, Rdx, ArrayRef<int> { [1, -1] });
            Rdx = DAG.getNode(ADD, DL, EVT { v2i64 }, Rdx, RdxHi);
        }
        VecVT = EVT { getVectorVT(VT.getSimpleVT(), 128 / VT.getSizeInBits().operator unsigned long long()) };
        Rdx = DAG.getBitcast(VecVT, Rdx);
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Rdx, Index);
    }
    if !shouldUseHorizontalOp(true, DAG, Subtarget) {
        return SDValue {};
    }
    let mut HorizOpcode: u32 = 0;
    if ((VecVT == EVT { v16i16 } || VecVT == EVT { v8i32 }) && Subtarget.hasSSSE3()) || ((VecVT == EVT { v8f32 } || VecVT == EVT { v4f64 }) && Subtarget.hasSSE3()) {
        let mut NumElts: u32 = VecVT.getVectorNumElements();
        let mut Hi: SDValue = extract128BitVector(Rdx, NumElts / 2, DAG, DL);
        let mut Lo: SDValue = extract128BitVector(Rdx, 0, DAG, DL);
        Rdx = DAG.getNode(HorizOpcode, DL, Lo.getValueType(), Hi, Lo);
        VecVT = Rdx.getValueType();
    }
    if !((VecVT == EVT { v8i16 } || VecVT == EVT { v4i32 }) && Subtarget.hasSSSE3()) && !((VecVT == EVT { v4f32 } || VecVT == EVT { v2f64 }) && Subtarget.hasSSE3()) {
        return SDValue {};
    }
    let mut ReductionSteps: u32 = Log2_32(VecVT.getVectorNumElements());
    for let mut i: u32 = 0; i != ReductionSteps; i += 1 {
        Rdx = DAG.getNode(HorizOpcode, DL, VecVT, Rdx, Rdx);
    }
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Rdx, Index);
}

fn combineExtractVectorElt(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if combineExtractWithShuffle(N, DAG, DCI, Subtarget) {
        NewOp;
    } else {
        return NewOp;
    }
    let mut InputVector: SDValue = N.getOperand(0);
    let mut EltIdx: SDValue = N.getOperand(1);
    let mut CIdx: *mut auto = dyn_cast(EltIdx);
    let mut SrcVT: EVT = InputVector.getValueType();
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { InputVector };
    let mut IsPextr: bool = N.getOpcode() != EXTRACT_VECTOR_ELT;
    let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
    let mut NumEltBits: u32 = VT.getScalarSizeInBits();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if CIdx() && ()(NumSrcElts) {
        return if IsPextr { DAG.getConstant(0, dl, VT, false, false) } else { DAG.getUNDEF(VT) };
    }
    if CIdx() && VT.isInteger() {
        let mut UndefVecElts: APInt = APInt {};
        let mut EltBits: SmallVector<APInt, 16> = zeroed();
        let mut VecEltBitWidth: u32 = SrcVT.getScalarSizeInBits();
        if getTargetConstantBitsFromNode(InputVector, VecEltBitWidth, UndefVecElts, true, false) {
            let mut Idx: u64 = ();
            if UndefVecElts[Idx] {
                return if IsPextr { DAG.getConstant(0, dl, VT, false, false) } else { DAG.getUNDEF(VT) };
            }
            return DAG([Idx](NumEltBits), dl, VT);
        }
        if InputVector.getOpcode() == BITCAST && (NumEltBits % 8) == 0 {
            let mut Src: SDValue = peekThroughBitcasts(InputVector);
            if Src.getValueType().getScalarType() == EVT { i1 } && TLI.isTypeLegal {
                let mut SubVT: MVT = getVectorVT(MVT { SimpleTy: i1 }, NumEltBits);
                let mut Sub: SDValue = DAG(EXTRACT_SUBVECTOR, dl, SubVT, Src, DAG.getVectorIdxConstant(() * NumEltBits, dl));
                return DAG.getBitcast(VT, Sub);
            }
        }
    }
    if IsPextr {
        if TLI.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, getAllOnes(NumEltBits), DCI) {
            return SDValue { Node: N, ResNo: 0 };
        }
        if  {
            assert!(SrcVT == InputVector.getOperand(0).getValueType(), "Vector type mismatch");
            let mut Scl: SDValue = InputVector.getOperand(1);
            Scl = DAG.getNode(TRUNCATE, dl, SrcVT.getScalarType(), Scl);
            return DAG.getZExtOrTrunc(Scl, dl, VT);
        }
        return SDValue {};
    }
    if CIdx() && isBitwiseLogicOp(InputVector.getOpcode()) {
        let mut Idx: u32 = ();
        let mut DemandedElts: APInt = getOneBitSet(NumSrcElts, Idx);
        if TLI.SimplifyMultipleUseDemandedVectorElts(InputVector, DemandedElts, DAG, 0) {
            NewVector;
        } else if NewVector.getOpcode() == BUILD_VECTOR {
            return DAG.getNode(N.getOpcode(), dl, VT, NewVector, EltIdx);
        }
    }
    if VT == EVT { i64 } && SrcVT == EVT { v1i64 } && InputVector.getOpcode() == BITCAST && InputVector.getOperand(0).getValueType() == EVT { x86mmx } && isNullConstant(EltIdx) && InputVector.hasOneUse() {
        return DAG.getBitcast(VT, InputVector);
    }
    if VT == EVT { i32 } && SrcVT == EVT { v2i32 } && InputVector.getOpcode() == BITCAST && InputVector.getOperand(0).getValueType() == EVT { x86mmx } && isNullConstant(EltIdx) && InputVector.hasOneUse() {
        return DAG;
    }
    if combineBasicSADPattern(N, DAG, Subtarget) {
        SAD;
    } else {
        return SAD;
    }
    if combineVPDPBUSDPattern(N, DAG, Subtarget) {
        VPDPBUSD;
    } else {
        return VPDPBUSD;
    }
    if combineArithReduction(N, DAG, Subtarget) {
        V;
    } else {
        return V;
    }
    if scalarizeExtEltFP(N, DAG, Subtarget, DCI) {
        V;
    } else {
        return V;
    }
    if CIdx() {
        if combineExtractFromVectorLoad(N, InputVector.getValueType(), InputVector, dl, DAG, DCI) {
            V;
        } else {
            return V;
        }
    }
    if InputVector.getOpcode() == FSHL || InputVector.getOpcode() == FSHR {
        if CIdx() && InputVector.hasOneUse() && TLI.isOperationLegal {
            let mut LHS: SDValue = DAG.getExtractVectorElt(dl, VT, InputVector.getOperand(0));
            let mut RHS: SDValue = DAG.getExtractVectorElt(dl, VT, InputVector.getOperand(1));
            let mut Amt: SDValue = DAG.getExtractVectorElt(dl, VT, InputVector.getOperand(2));
            Amt = DAG.getShiftAmountOperand(VT, Amt);
            return DAG.getNode(InputVector.getOpcode(), dl, VT, LHS, RHS, Amt);
        }
    }
    if SrcVT.getScalarType() == EVT { i1 } {
        let mut IsVar: bool = operator!();
        let mut BoolExtracts: SmallVector<SDNode *, 16> = zeroed();
        let mut ResNo: u32 = InputVector.getResNo();
        let mut IsBoolExtract: Closure_168 = Closure_168 { ResNo: &mut ResNo, IsVar: &mut IsVar };
        if all_of(operator(InputVector).users(), IsBoolExtract) && (IsVar || () > 1) {
            let mut BCVT: EVT = getIntegerVT(*DAG.getContext(), NumSrcElts);
            if combineBitcastvxi1(DAG, BCVT, InputVector, dl, Subtarget) {
                BC;
            } else {
                return SDValue { Node: N, ResNo: 0 };
            }
        }
    }
    if CIdx() && InputVector.getOpcode() == TRUNCATE {
        let mut TruncSrc: SDValue = InputVector.getOperand(0);
        let mut TruncSVT: EVT = TruncSrc.getValueType().getScalarType();
        if DCI.isBeforeLegalize() && TLI.isTypeLegal {
            let mut NewExt: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, dl, TruncSVT, TruncSrc, EltIdx);
            return DAG.getAnyExtOrTrunc(NewExt, dl, VT);
        }
    }
    return SDValue {};
}

fn combineVECREDUCE_MUL(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut NumElts: u32 = SrcVT.getVectorNumElements();
    let mut DL: SDLoc = SDLoc { N };
    if !isPowerOf2_32(NumElts) || SrcVT.getScalarType() != EVT { i8 } {
        return SDValue {};
    }
    if NumElts == 2 {
        let mut Hi: SDValue = DAG.getVectorShuffle(SrcVT, DL, Src, Src, ArrayRef<int> { [1, -1] });
        let mut Rdx: SDValue = DAG.getNode(MUL, DL, SrcVT, Src, Hi);
        return DAG.getExtractVectorElt(DL, N.getValueType(0), Rdx, 0);
    }
    if SrcVT.getSizeInBits().operator unsigned long long() >= 128 {
        let mut WideVT: EVT = getVectorVT(*DAG.getContext(), EVT { i16 }, NumElts / 2, false);
        let mut Lo: SDValue = getUnpackl(DAG, DL, SrcVT, Src, DAG.getUNDEF(SrcVT));
        let mut Hi: SDValue = getUnpackh(DAG, DL, SrcVT, Src, DAG.getUNDEF(SrcVT));
        Src = DAG.getNode(MUL, DL, WideVT, DAG.getBitcast(WideVT, Lo), DAG.getBitcast(WideVT, Hi));
    } else {
        let mut ExtVT: EVT = SrcVT.changeVectorElementType(*DAG.getContext(), EVT { i16 });
        Src = DAG.getNode(ANY_EXTEND, DL, ExtVT, Src);
    }
    Src = DAG.getNode(VECREDUCE_MUL, DL, EVT { i16 }, Src);
    return DAG.getZExtOrTrunc(Src, DL, N.getValueType(0));
}

fn combineToExtendBoolVectorInReg(Opcode: u32, DL: *SDLoc, VT: EVT, N0: SDValue, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    if Opcode != SIGN_EXTEND && Opcode != ZERO_EXTEND && Opcode != ANY_EXTEND {
        return SDValue {};
    }
    if !DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if !Subtarget.hasSSE2() || Subtarget.hasAVX512() {
        return SDValue {};
    }
    let mut SVT: EVT = VT.getScalarType();
    let mut InSVT: EVT = N0.getValueType().getScalarType();
    let mut EltSizeInBits: u32 = SVT.getSizeInBits().operator unsigned long long();
    if !VT.isVector() {
        return SDValue {};
    }
    if SVT != EVT { i64 } && SVT != EVT { i32 } && SVT != EVT { i16 } && SVT != EVT { i8 } {
        return SDValue {};
    }
    if InSVT != EVT { i1 } || N0.getOpcode() != BITCAST {
        return SDValue {};
    }
    let mut N00: SDValue = N0.getOperand(0);
    let mut SclVT: EVT = N00.getValueType();
    if !SclVT.isScalarInteger() {
        return SDValue {};
    }
    let mut Vec: SDValue = SDValue {};
    let mut ShuffleMask: i32 = 0;
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!(NumElts == SclVT.getSizeInBits().operator unsigned long long(), "Unexpected bool vector size");
    if NumElts > EltSizeInBits {
        assert!((NumElts % EltSizeInBits) == 0, "Unexpected integer scale");
        let mut Scale: u32 = NumElts / EltSizeInBits;
        let mut BroadcastVT: EVT = getVectorVT(*DAG.getContext(), SclVT, EltSizeInBits, false);
        let mut UseBroadcast: bool = Subtarget.hasInt256() && (!BroadcastVT.is128BitVector() || isa(N00));
        Vec = if UseBroadcast { DAG.getSplat(BroadcastVT, DL, N00) } else { DAG.getNode(SCALAR_TO_VECTOR, DL, BroadcastVT, N00) };
        Vec = DAG.getBitcast(VT, Vec);
        for let mut i: u32 = 0; i != Scale; i += 1 {
            let mut Offset: i32 = if UseBroadcast { (i * EltSizeInBits) } else { 0 };
            ShuffleMask()(EltSizeInBits, i + Offset);
        }
        Vec = DAG.getVectorShuffle(VT, DL, Vec, Vec);
    } else if Subtarget.hasAVX2() && NumElts < EltSizeInBits && (SclVT == EVT { i8 } || SclVT == EVT { i16 } || SclVT == EVT { i32 }) {
        assert!((EltSizeInBits % NumElts) == 0, "Unexpected integer scale");
        let mut BroadcastVT: EVT = getVectorVT(*DAG.getContext(), SclVT, (NumElts * EltSizeInBits) / NumElts, false);
        Vec = DAG.getBitcast(VT, DAG.getSplat(BroadcastVT, DL, N00));
    } else {
        Vec = DAG.getSplat(VT, DL, DAG.getAnyExtOrTrunc(N00, DL, SVT));
    }
    let mut Bits: SmallVector<SDValue, 32> = zeroed();
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut BitIdx: i32 = (i % EltSizeInBits);
        let mut Bit: APInt = getBitsSet(EltSizeInBits, BitIdx, BitIdx + 1);
        Bits()(DAG.getConstant(Bit, DL, SVT, false, false));
    }
    let mut BitMask: SDValue = DAG(VT, DL);
    Vec = DAG.getNode(AND, DL, VT, Vec, BitMask);
    let mut CCVT: EVT = getVectorVT(*DAG.getContext(), EVT { i1 }, NumElts, false);
    Vec = DAG.getSetCC(DL, CCVT, Vec, BitMask, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    Vec = DAG.getSExtOrTrunc(Vec, DL, VT);
    if Opcode == SIGN_EXTEND {
        return Vec;
    }
    return DAG.getNode(SRL, DL, VT, Vec, DAG.getConstant(EltSizeInBits - 1, DL, VT, false, false));
}

fn narrowVectorSelect(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    if  {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !VT.is256BitVector() {
        return SDValue {};
    }
    let mut Cond: SDValue = N.getOperand(0);
    let mut TVal: SDValue = N.getOperand(1);
    let mut FVal: SDValue = N.getOperand(2);
    if !TVal.hasOneUse() || !FVal.hasOneUse() || !isFreeToSplitVector(TVal, DAG) || !isFreeToSplitVector(FVal, DAG) {
        return SDValue {};
    }
    let mut makeBlend: Closure_169 = Closure_169 { Opcode: Opcode };
    return SplitOpsAndApply(DAG, Subtarget, DL, VT, void { Cond, TVal, FVal }, makeBlend, false);
}

fn combineSelectOfTwoConstants(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    let mut Cond: SDValue = N.getOperand(0);
    let mut LHS: SDValue = N.getOperand(1);
    let mut RHS: SDValue = N.getOperand(2);
    let mut TrueC: *mut auto = dyn_cast(LHS);
    let mut FalseC: *mut auto = dyn_cast(RHS);
    if operator!() || operator!() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if operator!(DAG.getTargetLoweringInfo().isTypeLegal) {
        return SDValue {};
    }
    if Cond.getValueType() != EVT { i1 } {
        return SDValue {};
    }
    let mut TrueVal: *APInt = ();
    let mut FalseVal: *APInt = ();
    if (TrueVal.isAllOnes() || FalseVal.isAllOnes()) && Cond.getOpcode() == SETCC && isNullConstant(Cond.getOperand(1)) {
        let mut CC: CondCode = cast(Cond.getOperand(2))();
        if CC == SETEQ || CC == SETNE {
            return SDValue {};
        }
    }
    let mut OV: bool = false;
    let mut Diff: APInt = TrueVal.ssub_ov(FalseVal, OV);
    if OV {
        return SDValue {};
    }
    let mut AbsDiff: APInt = Diff.abs();
    if AbsDiff.isPowerOf2() || ((VT == EVT { i32 } || VT == EVT { i64 }) && (AbsDiff == 3 || AbsDiff == 5 || AbsDiff == 9)) {
        if TrueVal.slt(FalseVal) {
            Cond = DAG.getNOT(DL, Cond, EVT { i1 });
            swap();
        }
        let mut R: SDValue = DAG.getNode(ZERO_EXTEND, DL, VT, Cond);
        if !AbsDiff.isOne() {
            R = DAG.getNode(MUL, DL, VT, R, DAG.getConstant(AbsDiff, DL, VT, false, false));
        }
        if operator!() {
            R = DAG.getNode(ADD, DL, VT, R);
        }
        return R;
    }
    return SDValue {};
}

fn combineVSelectToBLENDV(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut Cond: SDValue = N.getOperand(0);
    if  {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut BitWidth: u32 = Cond.getScalarValueSizeInBits();
    let mut VT: EVT = N.getValueType(0);
    if operator!(TLI.isOperationLegalOrCustom) {
        return SDValue {};
    }
    if VT.getVectorElementType() == EVT { i16 } {
        return SDValue {};
    }
    if VT.is128BitVector() && !Subtarget.hasSSE41() {
        return SDValue {};
    }
    if VT == EVT { v32i8 } && !Subtarget.hasAVX2() {
        return SDValue {};
    }
    if VT.is512BitVector() {
        return SDValue {};
    }
    if BitWidth < 8 || BitWidth > 64 {
        return SDValue {};
    }
    let mut OnlyUsedAsSelectCond: Closure_170 = Closure_170 {};
    let mut DemandedBits: APInt = getSignMask(BitWidth);
    if OnlyUsedAsSelectCond.call(Cond) {
        let mut Known: KnownBits = KnownBits {};
        let mut TLO: TargetLoweringOpt = TargetLoweringOpt { DAG, !DCI.isBeforeLegalize(), !DCI.isBeforeLegalizeOps() };
        if !TLI.SimplifyDemandedBits(Cond, DemandedBits, Known, TLO, 0, true) {
            return SDValue {};
        }
        for U in operator(Cond).users() {
            if  {
                continue;
            }
            let mut SB: SDValue = DAG;
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: U, ResNo: 0 }, SB);
            DCI.AddToWorklist(U);
        }
        DCI.CommitTargetLoweringOpt(TLO);
        return SDValue { Node: N, ResNo: 0 };
    }
    if TLI.SimplifyMultipleUseDemandedBits(Cond, DemandedBits, DAG, 0) {
        V;
    } else {
        return DAG;
    }
    return SDValue {};
}

fn combineLogicBlendIntoConditionalNegate(VT: EVT, Mask: SDValue, X: SDValue, Y: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Subtarget: *X86Subtarget) -> SDValue {
    let mut MaskVT: EVT = Mask.getValueType();
    assert!(MaskVT.isInteger() && DAG.ComputeNumSignBits(Mask, 0) == MaskVT.getScalarSizeInBits(), "Mask must be zero/all-bits");
    if X.getValueType() != MaskVT || Y.getValueType() != MaskVT || operator!(DAG.getTargetLoweringInfo().isOperationLegal) {
        return SDValue {};
    }
    let mut V: SDValue = SDValue {};
    if operator!(sd_match(Y, m_Neg(m_Value(V, m_Specific(X))))) && operator!(sd_match(X, m_Neg(m_Value(V, m_Specific(Y))))) {
        return SDValue {};
    }
    let mut SubOp1: SDValue = DAG.getNode(XOR, DL, MaskVT, V, Mask);
    let mut SubOp2: SDValue = Mask;
    if V == Y {
        swap(SubOp1, SubOp2);
    }
    let mut Res: SDValue = DAG.getNode(SUB, DL, MaskVT, SubOp1, SubOp2);
    return DAG.getBitcast(VT, Res);
}

fn commuteSelect(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget) -> SDValue {
    if !Subtarget.hasAVX512() {
        return SDValue {};
    }
    let mut CC: CondCode = zeroed();
    let mut Cond: SDValue = SDValue {};
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if operator!(sd_match(N, m_VSelect(m_Value(Cond, m_SetCC(CC, m_Value(X), m_Value(Y))), m_Value(LHS), m_Value(RHS)))) {
        return SDValue {};
    }
    if canCombineAsMaskOperation(LHS, Subtarget) || !canCombineAsMaskOperation(RHS, Subtarget) {
        return SDValue {};
    }
    if !Cond.hasOneUse() {
        if !all_of(operator(Cond).users(), Closure_171 { Cond: &mut Cond, Subtarget: &mut Subtarget }) {
            return SDValue {};
        }
    }
    let mut NewCC: CondCode = getSetCCInverse(CC, X.getValueType());
    let mut NewCond: SDValue = DAG.getSetCC(SDLoc { Cond }, Cond.getValueType(), X, Y, NewCC, SDValue {}, false, SDNodeFlags { Flags: None });
    return DAG.getSelect(DL, LHS.getValueType(), NewCond, RHS, LHS, SDNodeFlags { Flags: None });
}

fn combineSelect(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *X86Subtarget) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Cond: SDValue = N.getOperand(0);
    let mut LHS: SDValue = N.getOperand(1);
    let mut RHS: SDValue = N.getOperand(2);
    if DAG.simplifySelect(Cond, LHS, RHS) {
        V;
    } else {
        return V;
    }
    if commuteSelect(N, DAG, DL, Subtarget) {
        V;
    } else {
        return V;
    }
    let mut VT: EVT = LHS.getValueType();
    let mut CondVT: EVT = Cond.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut CondConstantVector: bool = isBuildVectorOfConstantSDNodes(Cond.getNode());
    let mut EltBitWidth: u32 = VT.getScalarSizeInBits();
    if CondVT.isVector() && CondVT.isInteger() && CondVT.getScalarSizeInBits() == VT.getScalarSizeInBits() && (!CondConstantVector || CondVT.getScalarType() == EVT { i8 }) && DAG.ComputeNumSignBits(Cond, 0) == CondVT.getScalarSizeInBits() {
        if combineLogicBlendIntoConditionalNegate(VT, Cond, RHS, LHS, DL, DAG, Subtarget) {
            V;
        } else {
            return V;
        }
    }
    if  {
        let mut KnownCond: KnownBits = DAG.computeKnownBits(Cond, 0);
        if KnownCond.isNegative() {
            return LHS;
        }
        if KnownCond.isNonNegative() {
            return RHS;
        }
    }
    if  {
        let mut CondMask: SmallVector<int, 64> = zeroed();
        if createShuffleMaskFromVSELECT(Cond) {
            if DCI.isBeforeLegalizeOps() {
                return DAG.getVectorShuffle(VT, DL, LHS, RHS);
            }
