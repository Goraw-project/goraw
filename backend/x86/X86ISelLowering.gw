            return DAG.getNode(TRUNCATE, dl, EVT { DstVT }, FpToInt);
        }
        let mut MinClamped: SDValue = DAG.getNode(PSEUDO_FMAX, dl, EVT { SrcVT }, Src, MinFloatNode);
        let mut BothClamped: SDValue = DAG;
        let mut FpToInt: SDValue = DAG.getNode(FpToIntOpcode, dl, EVT { DstVT }, BothClamped);
        if !IsSigned {
            return FpToInt;
        }
        let mut ZeroInt: SDValue = DAG.getConstant(0, dl, EVT { DstVT }, false, false);
        return DAG.getSelectCC(dl, Src, Src, ZeroInt, FpToInt, SETUO, SDNodeFlags { Flags: None });
    }
    let mut MinIntNode: SDValue = DAG.getConstant(MinInt, dl, EVT { DstVT }, false, false);
    let mut MaxIntNode: SDValue = DAG.getConstant(MaxInt, dl, EVT { DstVT }, false, false);
    let mut FpToInt: SDValue = DAG.getNode(FpToIntOpcode, dl, EVT { TmpVT }, Src);
