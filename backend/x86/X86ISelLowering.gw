    }
}

fn X86TargetLowering::isLegalAddressingMode(self: *X86TargetLowering, DL: *DataLayout, AM: *AddrMode, Ty: *mut Type, AS: u32, I: *mut Instruction) -> bool {
    let mut M: Model = self.getTargetMachine();
    if !isOffsetSuitableForCodeModel(AM.BaseOffs, M, AM.BaseGV != null) {
        return false;
    }
    if AM.BaseGV {
        let mut GVFlags: u32 = self.Subtarget.classifyGlobalReference(AM.BaseGV);
        if isGlobalStubReference(GVFlags) {
            return false;
        }
        if AM.HasBaseReg && isGlobalRelativeToPICBase(GVFlags) {
            return false;
        }
        if (M != Small || self.isPositionIndependent) && self.Subtarget() && (AM.BaseOffs || AM.Scale > 1) {
            return false;
        }
    }
    match AM.Scale {
        0 => {
            1;
        },
        3 => {
            5;
        },
        _ => {
            return false;
        },
    }
    return true;
}

fn X86TargetLowering::isBinOp(self: *X86TargetLowering, Opcode: u32) -> bool {
    match Opcode {

    }
    return self.isBinOp;
}

fn X86TargetLowering::isCommutativeBinOp(self: *X86TargetLowering, Opcode: u32) -> bool {
    match Opcode {

    }
    return self.isCommutativeBinOp;
}

fn X86TargetLowering::isTruncateFree(self: *X86TargetLowering, Ty1: *mut Type, Ty2: *mut Type) -> bool {
    if !Ty1.isIntegerTy() || !Ty2.isIntegerTy() {
        return false;
    }
    let mut NumBits1: u32 = Ty1.getPrimitiveSizeInBits().operator unsigned long long();
    let mut NumBits2: u32 = Ty2.getPrimitiveSizeInBits().operator unsigned long long();
    return NumBits1 > NumBits2;
}

fn X86TargetLowering::allowTruncateForTailCall(self: *X86TargetLowering, Ty1: *mut Type, Ty2: *mut Type) -> bool {
    if !Ty1.isIntegerTy() || !Ty2.isIntegerTy() {
        return false;
    }
    if operator!(self.isTypeLegal) {
        return false;
    }
    assert!(Ty1.getPrimitiveSizeInBits().operator unsigned long long() <= 64, "i128 is probably not a noop");
    return true;
}

fn X86TargetLowering::isLegalICmpImmediate(self: *X86TargetLowering, Imm: i64) -> bool {
    return isInt(Imm);
}

fn X86TargetLowering::isLegalAddImmediate(self: *X86TargetLowering, Imm: i64) -> bool {
    return isInt(Imm);
}

fn X86TargetLowering::isLegalStoreImmediate(self: *X86TargetLowering, Imm: i64) -> bool {
    return isInt(Imm);
}

fn X86TargetLowering::isTruncateFree(self: *X86TargetLowering, VT1: EVT, VT2: EVT) -> bool {
    if !VT1.isScalarInteger() || !VT2.isScalarInteger() {
        return false;
    }
    let mut NumBits1: u32 = VT1.getSizeInBits().operator unsigned long long();
    let mut NumBits2: u32 = VT2.getSizeInBits().operator unsigned long long();
    return NumBits1 > NumBits2;
}

fn X86TargetLowering::isZExtFree(self: *X86TargetLowering, Ty1: *mut Type, Ty2: *mut Type) -> bool {
    return Ty1.isIntegerTy(32) && Ty2.isIntegerTy(64) && self.Subtarget();
}

fn X86TargetLowering::isZExtFree(self: *X86TargetLowering, VT1: EVT, VT2: EVT) -> bool {
    return VT1 == EVT { i32 } && VT2 == EVT { i64 } && self.Subtarget();
}

fn X86TargetLowering::isZExtFree(self: *X86TargetLowering, Val: SDValue, VT2: EVT) -> bool {
    let mut VT1: EVT = Val.getValueType();
    if self.isZExtFree(VT1, VT2) {
        return true;
    }
    if Val.getOpcode() != LOAD {
        return false;
    }
    if !VT1.isSimple() || !VT1.isInteger() || !VT2.isSimple() || !VT2.isInteger() {
        return false;
    }
    match VT1.getSimpleVT().SimpleTy {
        _ => {
            break;
        },
        i8 => {
            i16;
        },
    }
    return false;
}

fn X86TargetLowering::shouldConvertPhiType(self: *X86TargetLowering, From: *mut Type, To: *mut Type) -> bool {
    if operator!(self.Subtarget()) {
        return false;
    }
    return self.shouldConvertPhiType;
}

fn X86TargetLowering::isVectorLoadExtDesirable(self: *X86TargetLowering, ExtVal: SDValue) -> bool {
    if isa(ExtVal.getOperand(0)) {
        return false;
    }
    let mut SrcVT: EVT = ExtVal.getOperand(0).getValueType();
    if SrcVT.getScalarType() == EVT { i1 } {
        return false;
    }
    return true;
}

fn X86TargetLowering::isFMAFasterThanFMulAndFAdd(self: *X86TargetLowering, MF: *MachineFunction, VT: EVT) -> bool {
    if self.Subtarget() {
        return false;
    }
    if !self.Subtarget.hasAnyFMA() {
        return false;
    }
    let mut IsVector: bool = VT.isVector();
    VT = VT.getScalarType();
    if !VT.isSimple() {
        return false;
    }
    match VT.getSimpleVT().SimpleTy {
        f16 => {
            return self.Subtarget();
        },
        bf16 => {
            return (!IsVector && (self.Subtarget() || self.Subtarget())) || self.Subtarget();
        },
        f32 => {
            f64;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn X86TargetLowering::isNarrowingProfitable(self: *X86TargetLowering, N: *mut SDNode, SrcVT: EVT, DestVT: EVT) -> bool {
    return !(SrcVT == EVT { i32 } && DestVT == EVT { i16 });
}

fn X86TargetLowering::shouldFoldSelectWithIdentityConstant(self: *X86TargetLowering, BinOpcode: u32, VT: EVT, SelectOpcode: u32, X: SDValue, Y: SDValue) -> bool {
    if SelectOpcode == SELECT {
        if VT.isVector() {
            return false;
        }
        if operator!(self.Subtarget()) || (VT != EVT { i32 } && VT != EVT { i64 }) {
            return false;
        }
        if BinOpcode == AND && (sd_match(Y, m_Neg(m_Specific(X))) || sd_match(X, m_Neg(m_Specific(Y)))) {
            return true;
        }
        if BinOpcode == AND && (sd_match(Y, m_Add(m_Specific(X), m_AllOnes(false))) || sd_match(X, m_Add(m_Specific(Y), m_AllOnes(false)))) {
            return true;
        }
        if BinOpcode == XOR && (sd_match(Y, m_Add(m_Specific(X), m_AllOnes(false))) || sd_match(X, m_Add(m_Specific(Y), m_AllOnes(false)))) {
            return true;
        }
        return false;
    }
    if !self.Subtarget.hasAVX512() {
        return false;
    }
    if operator!(self.Subtarget()) && !VT.is512BitVector() {
        return false;
    }
    if !VT.isVector() || VT.getScalarType() == EVT { i1 } {
        return false;
    }
    return true;
}

fn X86TargetLowering::isShuffleMaskLegal(self: *X86TargetLowering, Mask: ArrayRef<int>, VT: EVT) -> bool {
    if !VT.isSimple() {
        return false;
    }
    if VT.getSimpleVT().getScalarType() == i1 {
        return false;
    }
    if VT.getSimpleVT().getSizeInBits().operator unsigned long long() == 64 {
        return false;
    }
    return self.isTypeLegal;
}

fn X86TargetLowering::isVectorClearMaskLegal(self: *X86TargetLowering, Mask: ArrayRef<int>, VT: EVT) -> bool {
    if !self.Subtarget.hasAVX2() {
        if VT == EVT { v32i8 } || VT == EVT { v16i16 } {
            return false;
        }
    }
    return self.isShuffleMaskLegal(Mask, VT);
}

fn X86TargetLowering::areJTsAllowed(self: *X86TargetLowering, Fn: *Function) -> bool {
    if self.Subtarget.useIndirectThunkBranches() {
        return false;
    }
    return self.areJTsAllowed;
}

fn X86TargetLowering::getPreferredSwitchConditionType(self: *X86TargetLowering, Context: *mut LLVMContext, ConditionVT: EVT) -> MVT {
    if ConditionVT.getSizeInBits().operator unsigned long long() < 32 {
        return MVT { SimpleTy: i32 };
    }
    return self.getPreferredSwitchConditionType;
}

fn emitXBegin(MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, TII: *TargetInstrInfo) -> *mut MachineBasicBlock {
    let mut MIMD: MIMetadata = MIMetadata { MI };
    let mut BB: *BasicBlock = MBB.getBasicBlock();
    let mut I: i32 = MBB()() += 1;
    let mut thisMBB: *mut MachineBasicBlock = MBB;
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut mainMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(BB, nullopt());
    let mut fallMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(BB, nullopt());
    let mut sinkMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(BB, nullopt());
    MF()(mainMBB);
    MF()(fallMBB);
    MF()(sinkMBB);
    if isPhysRegUsedAfter(MI) {
        mainMBB;
        fallMBB;
        sinkMBB;
    }
    sinkMBB()(sinkMBB()(), MBB, next(), MBB()());
    sinkMBB.transferSuccessorsAndUpdatePHIs(MBB);
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut DstReg: Register = MI.getOperand(0).getReg();
    let mut RC: *TargetRegisterClass = MRI.getRegClass(DstReg);
    let mut mainDstReg: Register = MRI.createVirtualRegister(RC, "");
    let mut fallDstReg: Register = MRI.createVirtualRegister(RC, "");
    BuildMI(thisMBB, MIMD, TII.get)(fallMBB);
    thisMBB.addSuccessor(mainMBB, getUnknown());
    thisMBB.addSuccessor(fallMBB, getUnknown());
    BuildMI(mainMBB, MIMD, TII.get, mainDstReg)(-1);
    BuildMI(mainMBB, MIMD, TII.get)(sinkMBB);
    mainMBB.addSuccessor(sinkMBB, getUnknown());
    BuildMI(fallMBB, MIMD, TII.get);
    BuildMI(fallMBB, MIMD, TII.get, fallDstReg);
    fallMBB.addSuccessor(sinkMBB, getUnknown());
    BuildMI(*sinkMBB, sinkMBB()(), MIMD, TII.get, DstReg)(mainDstReg)(mainMBB)(fallDstReg)(fallMBB);
    MI()();
    return sinkMBB;
}

fn X86TargetLowering::EmitVAARGWithCustomInserter(self: *X86TargetLowering, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    assert!(MI.getNumOperands() == 10, "VAARG should have 10 operands!");
    let mut DestReg: Register = MI.getOperand(0).getReg();
    let mut Base: *mut MachineOperand = MI.getOperand(1);
    let mut Scale: *mut MachineOperand = MI.getOperand(2);
    let mut Index: *mut MachineOperand = MI.getOperand(3);
    let mut Disp: *mut MachineOperand = MI.getOperand(4);
    let mut Segment: *mut MachineOperand = MI.getOperand(5);
    let mut ArgSize: u32 = MI.getOperand(6).getImm();
    let mut ArgMode: u32 = MI.getOperand(7).getImm();
    let mut Alignment: Align = Align { ShiftValue: MI.getOperand(8).getImm() };
    let mut MF: *mut MachineFunction = MBB.getParent();
    assert!(MI.hasOneMemOperand(), "Expected VAARG to have one memoperand");
    let mut OldMMO: *mut MachineMemOperand = MI.memoperands().front();
    let mut LoadOnlyMMO: *mut MachineMemOperand = MF;
    let mut StoreOnlyMMO: *mut MachineMemOperand = MF;
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut AddrRegClass: *TargetRegisterClass = self.getRegClassFor(self.getPointerTy);
    let mut OffsetRegClass: *TargetRegisterClass = self.getRegClassFor;
    let mut MIMD: MIMetadata = MIMetadata { MI };
    let mut TotalNumIntRegs: u32 = 6;
    let mut TotalNumXMMRegs: u32 = 8;
    let mut UseGPOffset: bool = (ArgMode == 1);
    let mut UseFPOffset: bool = (ArgMode == 2);
    let mut MaxOffset: u32 = TotalNumIntRegs * 8 + (if UseFPOffset { TotalNumXMMRegs * 16 } else { 0 });
    let mut ArgSizeA8: u32 = (ArgSize + 7) & ~7;
    let mut NeedsAlign: bool = (Alignment > 8);
    let mut thisMBB: *mut MachineBasicBlock = MBB;
    let mut overflowMBB: *mut MachineBasicBlock = null;
    let mut offsetMBB: *mut MachineBasicBlock = null;
    let mut endMBB: *mut MachineBasicBlock = null;
    let mut OffsetDestReg: Register = Register { Reg: 0 };
    let mut OverflowDestReg: Register = Register { Reg: 0 };
    let mut OffsetReg: Register = Register { Reg: 0 };
    if !UseGPOffset && !UseFPOffset {
        OffsetDestReg = Register { Reg: 0 };
        OverflowDestReg = DestReg;
        offsetMBB = null;
        overflowMBB = thisMBB;
        endMBB = thisMBB;
    } else {
        OffsetDestReg = MRI.createVirtualRegister(AddrRegClass, "");
        OverflowDestReg = MRI.createVirtualRegister(AddrRegClass, "");
        let mut LLVM_BB: *BasicBlock = MBB.getBasicBlock();
        overflowMBB = MF.CreateMachineBasicBlock(LLVM_BB, nullopt());
        offsetMBB = MF.CreateMachineBasicBlock(LLVM_BB, nullopt());
        endMBB = MF.CreateMachineBasicBlock(LLVM_BB, nullopt());
        let mut MBBIter: i32 = MBB()() += 1;
        MF()(offsetMBB);
        MF()(overflowMBB);
        MF()(endMBB);
        endMBB()(endMBB()(), thisMBB, next(), thisMBB()());
        endMBB.transferSuccessorsAndUpdatePHIs(thisMBB);
        thisMBB.addSuccessor(offsetMBB, getUnknown());
        thisMBB.addSuccessor(overflowMBB, getUnknown());
        offsetMBB.addSuccessor(endMBB, getUnknown());
        overflowMBB.addSuccessor(endMBB, getUnknown());
        OffsetReg = MRI.createVirtualRegister(OffsetRegClass, "");
        BuildMI(thisMBB, MIMD, TII.get, OffsetReg)(Base)(Scale)(Index)(Disp, if UseFPOffset { 4 } else { 0 })(Segment)(LoadOnlyMMO);
        BuildMI(thisMBB, MIMD, TII.get)(OffsetReg)(MaxOffset + 8 - ArgSizeA8);
        BuildMI(thisMBB, MIMD, TII.get)(overflowMBB)(COND_AE);
    }
    if offsetMBB {
        assert!(OffsetReg != 0);
        let mut RegSaveReg: Register = MRI.createVirtualRegister(AddrRegClass, "");
        BuildMI(offsetMBB, MIMD, TII.get, RegSaveReg)(Base)(Scale)(Index)(Disp, if self.Subtarget.isTarget64BitLP64() { 16 } else { 12 })(Segment)(LoadOnlyMMO);
        if self.Subtarget.isTarget64BitLP64() {
            let mut OffsetReg64: Register = MRI.createVirtualRegister(AddrRegClass, "");
            BuildMI(offsetMBB, MIMD, TII.get, OffsetReg64)(OffsetReg);
            BuildMI(offsetMBB, MIMD, TII.get, OffsetDestReg)(OffsetReg64)(RegSaveReg)(3);
        } else {
            BuildMI(offsetMBB, MIMD, TII.get, OffsetDestReg)(OffsetReg)(RegSaveReg)(3);
        }
        let mut NextOffsetReg: Register = MRI.createVirtualRegister(OffsetRegClass, "");
        BuildMI(offsetMBB, MIMD, TII.get, NextOffsetReg)(OffsetReg)(if UseFPOffset { 16 } else { 8 })(3);
        BuildMI(offsetMBB, MIMD, TII.get)(Base)(Scale)(Index)(Disp, if UseFPOffset { 4 } else { 0 })(Segment)(NextOffsetReg)(StoreOnlyMMO);
        BuildMI(offsetMBB, MIMD, TII.get)(endMBB);
    }
    let mut OverflowAddrReg: Register = MRI.createVirtualRegister(AddrRegClass, "");
    BuildMI(overflowMBB, MIMD, TII.get, OverflowAddrReg)(Base)(Scale)(Index)(Disp, 8)(Segment)(LoadOnlyMMO);
    if NeedsAlign {
        let mut TmpReg: Register = MRI.createVirtualRegister(AddrRegClass, "");
        BuildMI(overflowMBB, MIMD, TII.get, TmpReg)(OverflowAddrReg)(Alignment.value() - 1)(3);
        BuildMI(overflowMBB, MIMD, TII.get, OverflowDestReg)(TmpReg)(~(Alignment.value() - 1) as u64)(3);
    } else {
        BuildMI(overflowMBB, MIMD, TII.get, OverflowDestReg)(OverflowAddrReg);
    }
    let mut NextAddrReg: Register = MRI.createVirtualRegister(AddrRegClass, "");
    BuildMI(overflowMBB, MIMD, TII.get, NextAddrReg)(OverflowDestReg)(ArgSizeA8)(3);
    BuildMI(overflowMBB, MIMD, TII.get)(Base)(Scale)(Index)(Disp, 8)(Segment)(NextAddrReg)(StoreOnlyMMO);
    if offsetMBB {
        BuildMI(*endMBB, endMBB()(), MIMD, TII.get, DestReg)(OffsetDestReg)(offsetMBB)(OverflowDestReg)(overflowMBB);
    }
    MI()();
    return endMBB;
}

fn checkAndUpdateEFLAGSKill(SelectItr: i32, BB: *mut MachineBasicBlock, TRI: *TargetRegisterInfo) -> bool {
    if isPhysRegUsedAfter() {
        return false;
    }
    SelectItr();
    return true;
}

fn isCMOVPseudo(MI: *mut MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
    }
}

fn createPHIsForCMOVsInSinkBB(MIItBegin: i32, MIItEnd: i32, TrueMBB: *mut MachineBasicBlock, FalseMBB: *mut MachineBasicBlock, SinkMBB: *mut MachineBasicBlock) -> MachineInstrBuilder {
    let mut MF: *mut MachineFunction = TrueMBB.getParent();
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    let mut MIMD: MIMetadata = operator*();
    let mut CC: CondCode = (3)();
    let mut OppCC: CondCode = GetOppositeBranchCondition(CC);
    let mut SinkInsertionPoint: i32 = SinkMBB()();
    let mut RegRewriteTable: i32 = 0;
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    for let mut MIIt: i32 = ; MIIt() != ;  += 1 {
        let mut DestReg: Register = (0)();
        let mut Op1Reg: Register = (1)();
        let mut Op2Reg: Register = (2)();
        if MIIt()(3)() == OppCC {
            swap(Op1Reg, Op2Reg);
        }
        let mut It: auto = (Op1Reg);
        if It() != () {
            Op1Reg = ;
        }
        let mut It: auto = (Op2Reg);
        if It() != () {
            Op2Reg = ;
        }
        MIB = BuildMI(*SinkMBB, MIMD, TII.get, DestReg)(Op1Reg)(FalseMBB)(Op2Reg)(TrueMBB);
        RegRewriteTable()[DestReg] = make_pair(Op1Reg, Op2Reg);
    }
    return MIB;
}

fn X86TargetLowering::EmitLoweredCascadedSelect(self: *X86TargetLowering, FirstCMOV: *mut MachineInstr, SecondCascadedCMOV: *mut MachineInstr, ThisMBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MIMD: MIMetadata = MIMetadata { FirstCMOV };
    let mut LLVM_BB: *BasicBlock = ThisMBB.getBasicBlock();
    let mut F: *mut MachineFunction = ThisMBB.getParent();
    let mut FirstInsertedMBB: *mut MachineBasicBlock = F.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut SecondInsertedMBB: *mut MachineBasicBlock = F.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut SinkMBB: *mut MachineBasicBlock = F.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut It: i32 = ThisMBB()() += 1;
    F()(FirstInsertedMBB);
    F()(SecondInsertedMBB);
    F()(SinkMBB);
    FirstInsertedMBB;
    let mut TRI: *TargetRegisterInfo = self.Subtarget.getRegisterInfo();
    if  {
        SecondInsertedMBB;
        SinkMBB;
    }
    SinkMBB()(SinkMBB()(), ThisMBB, next(), ThisMBB()());
    SinkMBB.transferSuccessorsAndUpdatePHIs(ThisMBB);
    ThisMBB.addSuccessor(FirstInsertedMBB, getUnknown());
    ThisMBB.addSuccessor(SinkMBB, getUnknown());
    FirstInsertedMBB.addSuccessor(SecondInsertedMBB, getUnknown());
    FirstInsertedMBB.addSuccessor(SinkMBB, getUnknown());
    SecondInsertedMBB.addSuccessor(SinkMBB, getUnknown());
    let mut FirstCC: CondCode = FirstCMOV.getOperand(3).getImm();
    BuildMI(ThisMBB, MIMD, TII.get)(SinkMBB)(FirstCC);
    let mut SecondCC: CondCode = SecondCascadedCMOV.getOperand(3).getImm();
    BuildMI(FirstInsertedMBB, MIMD, TII.get)(SinkMBB)(SecondCC);
    let mut DestReg: Register = SecondCascadedCMOV.getOperand(0).getReg();
    let mut Op1Reg: Register = FirstCMOV.getOperand(1).getReg();
    let mut Op2Reg: Register = FirstCMOV.getOperand(2).getReg();
    let mut MIB: MachineInstrBuilder = BuildMI(*SinkMBB, SinkMBB()(), MIMD, TII.get, DestReg)(Op1Reg)(SecondInsertedMBB)(Op2Reg)(ThisMBB);
    MIB()(FirstCMOV.getOperand(2).getReg())(FirstInsertedMBB);
    FirstCMOV()();
    SecondCascadedCMOV()();
    return SinkMBB;
}

fn X86TargetLowering::EmitLoweredSelect(self: *X86TargetLowering, MI: *mut MachineInstr, ThisMBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MIMD: MIMetadata = MIMetadata { MI };
    let mut CC: CondCode = MI.getOperand(3).getImm();
    let mut OppCC: CondCode = GetOppositeBranchCondition(CC);
    let mut LastCMOV: *mut MachineInstr = &mut MI;
    let mut NextMIIt: i32 = 0;
    if isCMOVPseudo(MI) {
        while NextMIIt() != ThisMBB()() && isCMOVPseudo(operator*()) && (NextMIIt()(3)() == CC || (3)() == OppCC) {
            LastCMOV = operator&(operator*());
            NextMIIt() = next_nodbg(ThisMBB()());
        }
    }
    if LastCMOV == &mut MI &&  != ThisMBB()() && () == MI.getOpcode() && (2)() == MI.getOperand(2).getReg() && (1)() == MI.getOperand(0).getReg() && (1)() {
        return self.EmitLoweredCascadedSelect(MI, operator*(), ThisMBB);
    }
    let mut LLVM_BB: *BasicBlock = ThisMBB.getBasicBlock();
    let mut F: *mut MachineFunction = ThisMBB.getParent();
    let mut FalseMBB: *mut MachineBasicBlock = F.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut SinkMBB: *mut MachineBasicBlock = F.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut It: i32 = ThisMBB()() += 1;
    F()(FalseMBB);
    F()(SinkMBB);
    let mut CallFrameSize: u32 = TII.getCallFrameSizeAt(MI);
    FalseMBB.setCallFrameSize(CallFrameSize);
    SinkMBB.setCallFrameSize(CallFrameSize);
    let mut TRI: *TargetRegisterInfo = self.Subtarget.getRegisterInfo();
    if  {
        FalseMBB;
        SinkMBB;
    }
    let mut DbgRange: auto = make_range();
    SinkMBB()(SinkMBB()(), ThisMBB, next(), ThisMBB()());
    SinkMBB.transferSuccessorsAndUpdatePHIs(ThisMBB);
    ThisMBB.addSuccessor(FalseMBB, getUnknown());
    ThisMBB.addSuccessor(SinkMBB, getUnknown());
    FalseMBB.addSuccessor(SinkMBB, getUnknown());
    BuildMI(ThisMBB, MIMD, TII.get)(SinkMBB)(CC);
    let mut MIItBegin: i32 = 0;
    let mut MIItEnd: i32 = next();
    createPHIsForCMOVsInSinkBB(ThisMBB, FalseMBB, SinkMBB);
    ThisMBB()();
    return SinkMBB;
}

fn getSUBriOpcode(IsLP64: bool) -> u32 {}

fn X86TargetLowering::EmitLoweredProbedAlloca(self: *X86TargetLowering, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut TFI: *X86FrameLowering = *self.Subtarget.getFrameLowering();
    let mut MIMD: MIMetadata = MIMetadata { MI };
    let mut LLVM_BB: *BasicBlock = MBB.getBasicBlock();
    let mut ProbeSize: u32 = self.getStackProbeSize(*MF);
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut testMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut tailMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut blockMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut MBBIter: i32 = MBB()() += 1;
    MF()(testMBB);
    MF()(blockMBB);
    MF()(tailMBB);
    let mut sizeVReg: Register = MI.getOperand(1).getReg();
    let mut physSPReg: Register = zeroed();
    let mut TmpStackPtr: Register = MRI;
    let mut FinalStackPtr: Register = MRI;
    BuildMI(*MBB, void { MI }, MIMD, TII.get, TmpStackPtr)(physSPReg);
    {
        let mut Opc: u32 = 0;
        BuildMI(*MBB, void { MI }, MIMD, TII.get, FinalStackPtr)(TmpStackPtr)(sizeVReg);
    }
    BuildMI(testMBB, MIMD, TII.get)(FinalStackPtr)(physSPReg);
    BuildMI(testMBB, MIMD, TII.get)(tailMBB)(COND_AE);
    testMBB.addSuccessor(blockMBB, getUnknown());
    testMBB.addSuccessor(tailMBB, getUnknown());
    let mut XORMIOpc: u32 = 0;
    addRegOffset(BuildMI(blockMBB, MIMD, TII.get), physSPReg, false, 0)(0);
    BuildMI(blockMBB, MIMD, TII.get, physSPReg)(physSPReg)(ProbeSize);
    BuildMI(blockMBB, MIMD, TII.get)(testMBB);
    blockMBB.addSuccessor(testMBB, getUnknown());
    BuildMI(tailMBB, MIMD, TII.get, MI.getOperand(0).getReg())(FinalStackPtr);
    tailMBB()(tailMBB()(), MBB, next(), MBB()());
    tailMBB.transferSuccessorsAndUpdatePHIs(MBB);
    MBB.addSuccessor(testMBB, getUnknown());
    MI()();
    return tailMBB;
}

fn X86TargetLowering::EmitLoweredSegAlloca(self: *X86TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = BB.getParent();
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MIMD: MIMetadata = MIMetadata { MI };
    let mut LLVM_BB: *BasicBlock = BB.getBasicBlock();
    assert!(MF.shouldSplitStack();
    let mut Is64Bit: bool = self.Subtarget();
    let mut IsLP64: bool = self.Subtarget.isTarget64BitLP64();
    let mut TlsReg: u32 = 0;
    let mut TlsOffset: u32 = if IsLP64 { 112 } else { if Is64Bit { 64 } else { 48 } };
    let mut mallocMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut bumpMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut continueMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt());
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut AddrRegClass: *TargetRegisterClass = self.getRegClassFor(self.getPointerTy);
    let mut mallocPtrVReg: Register = MRI.createVirtualRegister(AddrRegClass, "");
    let mut bumpSPPtrVReg: Register = MRI.createVirtualRegister(AddrRegClass, "");
    let mut tmpSPVReg: Register = MRI.createVirtualRegister(AddrRegClass, "");
    let mut SPLimitVReg: Register = MRI.createVirtualRegister(AddrRegClass, "");
    let mut sizeVReg: Register = MI.getOperand(1).getReg();
    let mut physSPReg: Register = zeroed();
    let mut MBBIter: i32 = BB()() += 1;
    MF()(bumpMBB);
    MF()(mallocMBB);
    MF()(continueMBB);
    continueMBB()(continueMBB()(), BB, next(), BB()());
    continueMBB.transferSuccessorsAndUpdatePHIs(BB);
    BuildMI(BB, MIMD, TII.get, tmpSPVReg)(physSPReg);
    BuildMI(BB, MIMD, TII.get, SPLimitVReg)(tmpSPVReg)(sizeVReg);
    BuildMI(BB, MIMD, TII.get)(0)(1)(0)(TlsOffset)(TlsReg)(SPLimitVReg);
    BuildMI(BB, MIMD, TII.get)(mallocMBB)(COND_G);
    BuildMI(bumpMBB, MIMD, TII.get, physSPReg)(SPLimitVReg);
    BuildMI(bumpMBB, MIMD, TII.get, bumpSPPtrVReg)(SPLimitVReg);
    BuildMI(bumpMBB, MIMD, TII.get)(continueMBB);
    let mut RegMask: *u32 = self.Subtarget.getRegisterInfo().getCallPreservedMask(*MF, C);
    if IsLP64 {
        BuildMI(mallocMBB, MIMD, TII.get)(sizeVReg);
        BuildMI(mallocMBB, MIMD, TII.get)("__morestack_allocate_stack_space")(RegMask);
    } else if Is64Bit {
        BuildMI(mallocMBB, MIMD, TII.get)(sizeVReg);
        BuildMI(mallocMBB, MIMD, TII.get)("__morestack_allocate_stack_space")(RegMask);
    } else {
        BuildMI(mallocMBB, MIMD, TII.get, physSPReg)(physSPReg)(12);
        BuildMI(mallocMBB, MIMD, TII.get)(sizeVReg);
        BuildMI(mallocMBB, MIMD, TII.get)("__morestack_allocate_stack_space")(RegMask);
    }
    if !Is64Bit {
        BuildMI(mallocMBB, MIMD, TII.get, physSPReg)(physSPReg)(16);
    }
    BuildMI(mallocMBB, MIMD, TII.get, mallocPtrVReg);
    BuildMI(mallocMBB, MIMD, TII.get)(continueMBB);
    BB.addSuccessor(bumpMBB, getUnknown());
    BB.addSuccessor(mallocMBB, getUnknown());
    mallocMBB.addSuccessor(continueMBB, getUnknown());
    bumpMBB.addSuccessor(continueMBB, getUnknown());
    BuildMI(*continueMBB, continueMBB()(), MIMD, TII.get, MI.getOperand(0).getReg())(mallocPtrVReg)(mallocMBB)(bumpSPPtrVReg)(bumpMBB);
    MI()();
    return continueMBB;
}

fn X86TargetLowering::EmitLoweredCatchRet(self: *X86TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = BB.getParent();
    let mut TII: *TargetInstrInfo = *self.Subtarget.getInstrInfo();
    let mut TargetMBB: *mut MachineBasicBlock = MI.getOperand(0).getMBB();
    let mut MIMD: MIMetadata = MIMetadata { MI };
    assert!(!isAsynchronousEHPersonality(classifyEHPersonality(MF.getFunction().getPersonalityFn())), "SEH does not use catchret!");
    if operator!(self.Subtarget()) {
        return BB;
    }
    let mut RestoreMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(BB.getBasicBlock(), nullopt());
    assert!(BB.succ_size() == 1);
    MF()(next(BB()()), RestoreMBB);
    RestoreMBB.transferSuccessorsAndUpdatePHIs(BB);
    BB.addSuccessor(RestoreMBB, getUnknown());
    MI.getOperand(0).setMBB(RestoreMBB);
    RestoreMBB.setIsEHPad(true);
    let mut RestoreMBBI: auto = RestoreMBB()();
    BuildMI(*RestoreMBB, MIMD, TII.get)(TargetMBB);
    return BB;
}

fn X86TargetLowering::EmitLoweredTLSCall(self: *X86TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut F: *mut MachineFunction = BB.getParent();
    let mut TII: *X86InstrInfo = self.Subtarget.getInstrInfo();
    let mut MIMD: MIMetadata = MIMetadata { MI };
    assert!(self.Subtarget.isTargetDarwin(), "Darwin only instr emitted?");
    assert!(MI.getOperand(3).isGlobal(), "This should be a global");
    let mut RegMask: *u32 = if self.Subtarget() { self.Subtarget.getRegisterInfo().getDarwinTLSCallPreservedMask() } else { self.Subtarget.getRegisterInfo().getCallPreservedMask(*F, C) };
    if self.Subtarget() {
        let mut MIB: MachineInstrBuilder = BuildMI(*BB, MI, MIMD, TII())(0)(0)(MI.getOperand(3).getGlobal(), 0, MI.getOperand(3).getTargetFlags())(0);
        MIB = BuildMI(*BB, MI, MIMD, TII());
        addDirectMem(MIB);
        MIB()(RegMask);
    } else if operator!(self.isPositionIndependent) {
        let mut MIB: MachineInstrBuilder = BuildMI(*BB, MI, MIMD, TII())(0)(0)(0)(MI.getOperand(3).getGlobal(), 0, MI.getOperand(3).getTargetFlags())(0);
        MIB = BuildMI(*BB, MI, MIMD, TII());
        addDirectMem(MIB);
        MIB()(RegMask);
    } else {
