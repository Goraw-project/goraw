        let mut Chain: SDValue = Op.getOperand(0);
        return emitLockedStackOp(DAG, Subtarget, Chain, dl);
    }
    return DAG.getNode(MEMBARRIER, dl, EVT { Other }, Op.getOperand(0));
}

