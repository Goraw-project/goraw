}

unsafe fn Closure_89::call(self: *mut Closure_89, HalfIdx: i32) -> SDValue {
        if HalfIdx < 0 {
            return (*self.DAG).getUNDEF((*self.HalfVT));
        }
        let mut V: SDValue = (if HalfIdx < 2 { (*self.V1) } else { (*self.V2) });
        HalfIdx = (HalfIdx % 2) * (*self.HalfNumElts);
        return (*self.DAG).getNode(EXTRACT_SUBVECTOR, (*self.DL), (*self.HalfVT), V, (*self.DAG).getVectorIdxConstant(HalfIdx, (*self.DL), false));
    }

