    if ConstantAmt && (Opc == SRA || Opc == SRL) && (VT == v16i8 || (VT == v32i8 && Subtarget.hasInt256()) || (VT == v64i8 && Subtarget()())) && operator!(Subtarget()()) {
        let mut VT16: MVT = getVectorVT(MVT { SimpleTy: i16 }, NumElts / 2);
        let mut Cst8: SDValue = DAG.getTargetConstant(8, dl, EVT { i8 }, false);
        let mut ExVT: MVT = getVectorVT(MVT { SimpleTy: i16 }, NumElts);
        Amt = DAG.getZExtOrTrunc(Amt, dl, EVT { ExVT });
        Amt = DAG.getNode(SUB, dl, EVT { ExVT }, DAG.getConstant(8, dl, EVT { ExVT }, false, false), Amt);
        Amt = DAG.getNode(SHL, dl, EVT { ExVT }, DAG.getConstant(1, dl, EVT { ExVT }, false, false), Amt);
        assert!(isBuildVectorOfConstantSDNodes(Amt.getNode()), "Constant build vector expected");
        if VT == v16i8 && Subtarget.hasInt256() {
            let mut IsSigned: bool = Opc == SRA;
            R = DAG.getExtOrTrunc(IsSigned, R, dl, EVT { ExVT });
            R = DAG.getNode(MUL, dl, EVT { ExVT }, R, Amt);
            R = DAG;
            return DAG.getZExtOrTrunc(R, dl, EVT { VT });
        }
        let mut LoAmt: SmallVector<SDValue, 16> = zeroed();
        let mut HiAmt: SmallVector<SDValue, 16> = zeroed();
        for let mut i: u32 = 0; i != NumElts; i += 16 {
            for let mut j: i32 = 0; j != 8; j += 1 {
                LoAmt()(Amt.getOperand(i + j));
                HiAmt()(Amt.getOperand(i + j + 8));
            }
        }
        let mut LoA: SDValue = DAG(VT16, dl);
        let mut HiA: SDValue = DAG(VT16, dl);
        let mut LoR: SDValue = DAG.getBitcast(EVT { VT16 }, getUnpackl(DAG, dl, EVT { VT }, R, R));
        let mut HiR: SDValue = DAG.getBitcast(EVT { VT16 }, getUnpackh(DAG, dl, EVT { VT }, R, R));
        LoR = DAG.getNode(X86OpcI, dl, EVT { VT16 }, LoR, Cst8);
        HiR = DAG.getNode(X86OpcI, dl, EVT { VT16 }, HiR, Cst8);
        LoR = DAG.getNode(MUL, dl, EVT { VT16 }, LoR, LoA);
        HiR = DAG.getNode(MUL, dl, EVT { VT16 }, HiR, HiA);
        LoR = DAG;
        HiR = DAG;
        return DAG;
    }
    if VT == v64i8 && Subtarget.canExtendTo512BW() {
        let mut ExtVT: MVT = MVT { SimpleTy: v32i16 };
        let mut RLo: SDValue = SDValue {};
        let mut RHi: SDValue = SDValue {};
        let mut AmtLo: SDValue = DAG.getNode(AND, dl, EVT { ExtVT }, DAG.getBitcast(EVT { ExtVT }, Amt), DAG.getConstant(255, dl, EVT { ExtVT }, false, false));
        let mut AmtHi: SDValue = getTargetVShiftByConstNode(dl, ExtVT, DAG.getBitcast(EVT { ExtVT }, Amt), 8, DAG);
        match Opc {
            SHL => {
                RLo = DAG.getBitcast(EVT { ExtVT }, R);
            },
            SRL => {
                RHi = DAG.getBitcast(EVT { ExtVT }, R);
            },
            SRA => {
                RHi = DAG.getBitcast(EVT { ExtVT }, R);
            },
            _ => {
                llvm_unreachable_internal("Unexpected Shift Op", "llvm\\lib\\Target\\X86\\X86ISelLowering.cpp", 32021);
            },
        }
        let mut ShiftedLo: SDValue = DAG.getBitcast(EVT { VT }, DAG.getNode(Opc, dl, EVT { ExtVT }, RLo, AmtLo));
        let mut ShiftedHi: SDValue = DAG.getBitcast(EVT { VT }, DAG.getNode(Opc, dl, EVT { ExtVT }, RHi, AmtHi));
        let mut SelectMask: SDValue = DAG.getBitcast(EVT { v64i1 }, DAG.getConstant(6148914691236517205, dl, EVT { i64 }, false, false));
        return DAG.getSelect(dl, EVT { VT }, SelectMask, ShiftedLo, ShiftedHi, SDNodeFlags { Flags: None });
    }
    if VT == v16i8 || (VT == v32i8 && Subtarget.hasInt256() && operator!(Subtarget()())) || (VT == v64i8 && Subtarget()()) {
        let mut ExtVT: MVT = getVectorVT(MVT { SimpleTy: i16 }, NumElts / 2);
        let mut SignBitSelect: Closure_124 = Closure_124 { VT: &mut VT, NumElts: &mut NumElts, DAG: &mut DAG, dl: &mut dl, Subtarget: &mut Subtarget };
        let mut KnownAmt: KnownBits = DAG.computeKnownBits(Amt, 0).trunc(3);
        if KnownAmt.isZero() {
            return R;
        }
        let mut MinLZ: u32 = KnownAmt.countMinLeadingZeros();
        assert!(MinLZ <= 2, "Illegal shift amount");
        Amt = DAG.getBitcast(EVT { ExtVT }, Amt);
        Amt = getTargetVShiftByConstNode(dl, ExtVT, Amt, 5 + MinLZ, DAG);
        Amt = DAG.getBitcast(EVT { VT }, Amt);
        if Opc == SHL || Opc == SRL {
            if MinLZ < 1 {
                let mut M: SDValue = DAG.getNode(Opc, dl, EVT { VT }, R, DAG.getConstant(4, dl, EVT { VT }, false, false));
                R = SignBitSelect(VT, Amt, M, R);
                Amt = DAG.getNode(ADD, dl, EVT { VT }, Amt, Amt);
            }
            if MinLZ < 2 {
                let mut M: SDValue = DAG.getNode(Opc, dl, EVT { VT }, R, DAG.getConstant(2, dl, EVT { VT }, false, false));
                R = SignBitSelect(VT, Amt, M, R);
                Amt = DAG.getNode(ADD, dl, EVT { VT }, Amt, Amt);
            }
            let mut M: SDValue = DAG.getNode(Opc, dl, EVT { VT }, R, DAG.getConstant(1, dl, EVT { VT }, false, false));
            R = SignBitSelect(VT, Amt, M, R);
            return R;
        }
        if Opc == SRA {
            let mut ALo: SDValue = getUnpackl(DAG, dl, EVT { VT }, DAG.getUNDEF(EVT { VT }), Amt);
            let mut AHi: SDValue = getUnpackh(DAG, dl, EVT { VT }, DAG.getUNDEF(EVT { VT }), Amt);
            let mut RLo: SDValue = getUnpackl(DAG, dl, EVT { VT }, DAG.getUNDEF(EVT { VT }), R);
            let mut RHi: SDValue = getUnpackh(DAG, dl, EVT { VT }, DAG.getUNDEF(EVT { VT }), R);
            ALo = DAG.getBitcast(EVT { ExtVT }, ALo);
            AHi = DAG.getBitcast(EVT { ExtVT }, AHi);
            RLo = DAG.getBitcast(EVT { ExtVT }, RLo);
            RHi = DAG.getBitcast(EVT { ExtVT }, RHi);
            let mut MLo: SDValue = SDValue {};
            let mut MHi: SDValue = SDValue {};
            if MinLZ < 1 {
                MLo = getTargetVShiftByConstNode(X86OpcI, dl, ExtVT, RLo, 4, DAG);
                MHi = getTargetVShiftByConstNode(X86OpcI, dl, ExtVT, RHi, 4, DAG);
                RLo = SignBitSelect(ExtVT, ALo, MLo, RLo);
                RHi = SignBitSelect(ExtVT, AHi, MHi, RHi);
                ALo = DAG.getNode(ADD, dl, EVT { ExtVT }, ALo, ALo);
                AHi = DAG.getNode(ADD, dl, EVT { ExtVT }, AHi, AHi);
            }
            if MinLZ < 2 {
                MLo = getTargetVShiftByConstNode(X86OpcI, dl, ExtVT, RLo, 2, DAG);
                MHi = getTargetVShiftByConstNode(X86OpcI, dl, ExtVT, RHi, 2, DAG);
                RLo = SignBitSelect(ExtVT, ALo, MLo, RLo);
                RHi = SignBitSelect(ExtVT, AHi, MHi, RHi);
                ALo = DAG.getNode(ADD, dl, EVT { ExtVT }, ALo, ALo);
                AHi = DAG.getNode(ADD, dl, EVT { ExtVT }, AHi, AHi);
            }
            MLo = getTargetVShiftByConstNode(X86OpcI, dl, ExtVT, RLo, 1, DAG);
            MHi = getTargetVShiftByConstNode(X86OpcI, dl, ExtVT, RHi, 1, DAG);
            RLo = SignBitSelect(ExtVT, ALo, MLo, RLo);
            RHi = SignBitSelect(ExtVT, AHi, MHi, RHi);
            RLo = getTargetVShiftByConstNode(dl, ExtVT, RLo, 8, DAG);
            RHi = getTargetVShiftByConstNode(dl, ExtVT, RHi, 8, DAG);
            return DAG;
        }
    }
    if Subtarget.hasInt256() && operator!(Subtarget()()) && VT == v16i16 {
        let mut ExtVT: MVT = MVT { SimpleTy: v8i32 };
        let mut Z: SDValue = DAG.getConstant(0, dl, EVT { VT }, false, false);
        let mut ALo: SDValue = getUnpackl(DAG, dl, EVT { VT }, Amt, Z);
        let mut AHi: SDValue = getUnpackh(DAG, dl, EVT { VT }, Amt, Z);
        let mut RLo: SDValue = getUnpackl(DAG, dl, EVT { VT }, Z, R);
        let mut RHi: SDValue = getUnpackh(DAG, dl, EVT { VT }, Z, R);
        ALo = DAG.getBitcast(EVT { ExtVT }, ALo);
        AHi = DAG.getBitcast(EVT { ExtVT }, AHi);
        RLo = DAG.getBitcast(EVT { ExtVT }, RLo);
        RHi = DAG.getBitcast(EVT { ExtVT }, RHi);
        let mut Lo: SDValue = DAG.getNode(Opc, dl, EVT { ExtVT }, RLo, ALo);
        let mut Hi: SDValue = DAG.getNode(Opc, dl, EVT { ExtVT }, RHi, AHi);
        Lo = getTargetVShiftByConstNode(dl, ExtVT, Lo, 16, DAG);
        Hi = getTargetVShiftByConstNode(dl, ExtVT, Hi, 16, DAG);
        return DAG;
    }
    if VT == v8i16 {
        let mut UseSSE41: bool = Subtarget.hasSSE41() && !isBuildVectorOfConstantSDNodes(Amt.getNode());
        let mut SignBitSelect: Closure_125 = Closure_125 { UseSSE41: &mut UseSSE41, NumElts: &mut NumElts, DAG: &mut DAG, VT: &mut VT, dl: &mut dl };
        if UseSSE41 {
            Amt = DAG(OR, dl, VT, getTargetVShiftByConstNode(dl, VT, Amt, 4, DAG), getTargetVShiftByConstNode(dl, VT, Amt, 12, DAG));
        } else {
            Amt = getTargetVShiftByConstNode(dl, VT, Amt, 12, DAG);
        }
        let mut M: SDValue = getTargetVShiftByConstNode(X86OpcI, dl, VT, R, 8, DAG);
        R = SignBitSelect(Amt, M, R);
        Amt = DAG.getNode(ADD, dl, EVT { VT }, Amt, Amt);
        M = getTargetVShiftByConstNode(X86OpcI, dl, VT, R, 4, DAG);
        R = SignBitSelect(Amt, M, R);
        Amt = DAG.getNode(ADD, dl, EVT { VT }, Amt, Amt);
        M = getTargetVShiftByConstNode(X86OpcI, dl, VT, R, 2, DAG);
        R = SignBitSelect(Amt, M, R);
        Amt = DAG.getNode(ADD, dl, EVT { VT }, Amt, Amt);
        M = getTargetVShiftByConstNode(X86OpcI, dl, VT, R, 1, DAG);
        R = SignBitSelect(Amt, M, R);
        return R;
    }
    if VT.is256BitVector() {
        return splitVectorIntBinary(Op, DAG, dl);
    }
    if VT == v32i16 || VT == v64i8 {
        return splitVectorIntBinary(Op, DAG, dl);
    }
    return SDValue {};
}

fn LowerFunnelShift(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    assert!((Op.getOpcode() == FSHL || Op.getOpcode() == FSHR), "Unexpected funnel shift opcode!");
    let mut DL: SDLoc = SDLoc { Op };
    let mut Op0: SDValue = Op.getOperand(0);
    let mut Op1: SDValue = Op.getOperand(1);
    let mut Amt: SDValue = Op.getOperand(2);
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut IsFSHR: bool = Op.getOpcode() == FSHR;
    if VT.isVector() {
        let mut APIntShiftAmt: APInt = APInt {};
        let mut IsCstSplat: bool = isConstantSplat(Amt, APIntShiftAmt, true);
        let mut NumElts: u32 = VT.getVectorNumElements();
        assert!((VT == v16i8 || VT == v32i8 || VT == v64i8 || VT == v8i16 || VT == v16i16 || VT == v32i16 || VT == v4i32 || VT == v8i32 || VT == v16i32), "Unexpected funnel shift type!");
        if IsCstSplat {
            let mut ShiftAmt: u64 = APIntShiftAmt.urem(EltSizeInBits);
            let mut ShXAmt: u64 = if IsFSHR { (EltSizeInBits - ShiftAmt) } else { ShiftAmt };
            let mut ShYAmt: u64 = if IsFSHR { ShiftAmt } else { (EltSizeInBits - ShiftAmt) };
            assert!((ShXAmt + ShYAmt) == EltSizeInBits, "Illegal funnel shift");
            let mut WideVT: MVT = getVectorVT(MVT { SimpleTy: i16 }, NumElts / 2);
            if EltSizeInBits == 8 && (Subtarget()() || (useVPTERNLOG(Subtarget, VT) && supportedVectorShiftWithImm(EVT { WideVT }, Subtarget, SHL))) {
                let mut MaskX: APInt = getHighBitsSet(8, 8 - ShXAmt);
                let mut MaskY: APInt = getLowBitsSet(8, 8 - ShYAmt);
                let mut ShX: SDValue = DAG.getNode(SHL, DL, EVT { WideVT }, DAG.getBitcast(EVT { WideVT }, Op0), DAG.getShiftAmountConstant(ShXAmt, EVT { WideVT }, DL));
                let mut ShY: SDValue = DAG.getNode(SRL, DL, EVT { WideVT }, DAG.getBitcast(EVT { WideVT }, Op1), DAG.getShiftAmountConstant(ShYAmt, EVT { WideVT }, DL));
                ShX = DAG.getNode(AND, DL, EVT { VT }, DAG.getBitcast(EVT { VT }, ShX), DAG.getConstant(MaskX, DL, EVT { VT }, false, false));
                ShY = DAG.getNode(AND, DL, EVT { VT }, DAG.getBitcast(EVT { VT }, ShY), DAG.getConstant(MaskY, DL, EVT { VT }, false, false));
                return DAG.getNode(OR, DL, EVT { VT }, ShX, ShY);
            }
            let mut ShX: SDValue = DAG.getNode(SHL, DL, EVT { VT }, Op0, DAG.getShiftAmountConstant(ShXAmt, EVT { VT }, DL));
            let mut ShY: SDValue = DAG.getNode(SRL, DL, EVT { VT }, Op1, DAG.getShiftAmountConstant(ShYAmt, EVT { VT }, DL));
            return DAG.getNode(OR, DL, EVT { VT }, ShX, ShY);
        }
        let mut AmtMask: SDValue = DAG.getConstant(EltSizeInBits - 1, DL, EVT { VT }, false, false);
        let mut AmtMod: SDValue = DAG.getNode(AND, DL, EVT { VT }, Amt, AmtMask);
        let mut IsCst: bool = isBuildVectorOfConstantSDNodes(AmtMod.getNode());
        if IsCst && EltSizeInBits == 16 {
            return SDValue {};
        }
        let mut ShiftOpc: u32 = if IsFSHR { SRL } else { SHL };
        let mut ExtSVT: MVT = getIntegerVT(2 * EltSizeInBits);
        let mut ExtVT: MVT = getVectorVT(ExtSVT, NumElts / 2);
        if (VT.is256BitVector() && ((Subtarget()() && EltSizeInBits < 16) || !Subtarget.hasAVX2())) || (VT.is512BitVector() && !Subtarget.useBWIRegs() && EltSizeInBits < 32) {
            Op = DAG.getNode(Op.getOpcode(), DL, EVT { VT }, Op0, Op1, AmtMod);
            return splitVectorOp(Op, DAG, DL);
        }
        if supportedVectorShiftWithBaseAmnt(EVT { ExtVT }, Subtarget, ShiftOpc) {
            let mut ScalarAmtIdx: i32 = -1;
            if DAG.getSplatSourceVector(AmtMod, ScalarAmtIdx) {
                ScalarAmt;
            } else {
                if EltSizeInBits == 16 {
                    return SDValue {};
                }
                let mut Lo: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackl(DAG, DL, EVT { VT }, Op1, Op0));
                let mut Hi: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackh(DAG, DL, EVT { VT }, Op1, Op0));
                Lo = getTargetVShiftNode(ShiftOpc, DL, ExtVT, Lo, ScalarAmt, ScalarAmtIdx, Subtarget, DAG);
                Hi = getTargetVShiftNode(ShiftOpc, DL, ExtVT, Hi, ScalarAmt, ScalarAmtIdx, Subtarget, DAG);
                return getPack(DAG, Subtarget, DL, VT, Lo, Hi, !IsFSHR);
            }
        }
        let mut WideSVT: MVT = getIntegerVT(if EltSizeInBits * 2 < if Subtarget()() { 16 } else { 32 } { EltSizeInBits * 2 } else { if Subtarget()() { 16 } else { 32 } });
        let mut WideVT: MVT = getVectorVT(WideSVT, NumElts);
        if supportedVectorVarShift(EVT { VT }, Subtarget, ShiftOpc) || Subtarget()() {
            return SDValue {};
        }
        if supportedVectorVarShift(EVT { WideVT }, Subtarget, ShiftOpc) && supportedVectorShiftWithImm(EVT { WideVT }, Subtarget, ShiftOpc) {
            Op0 = DAG.getNode(ANY_EXTEND, DL, EVT { WideVT }, Op0);
            Op1 = DAG.getNode(ZERO_EXTEND, DL, EVT { WideVT }, Op1);
            AmtMod = DAG.getNode(ZERO_EXTEND, DL, EVT { WideVT }, AmtMod);
            Op0 = getTargetVShiftByConstNode(DL, WideVT, Op0, EltSizeInBits, DAG);
            let mut Res: SDValue = DAG.getNode(OR, DL, EVT { WideVT }, Op0, Op1);
            Res = DAG.getNode(ShiftOpc, DL, EVT { WideVT }, Res, AmtMod);
            if !IsFSHR {
                Res = getTargetVShiftByConstNode(DL, WideVT, Res, EltSizeInBits, DAG);
            }
            return DAG.getNode(TRUNCATE, DL, EVT { VT }, Res);
        }
        if ((IsCst || !Subtarget.hasAVX512()) && !IsFSHR && EltSizeInBits <= 16) || supportedVectorVarShift(EVT { ExtVT }, Subtarget, ShiftOpc) {
            let mut Z: SDValue = DAG.getConstant(0, DL, EVT { VT }, false, false);
            let mut RLo: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackl(DAG, DL, EVT { VT }, Op1, Op0));
            let mut RHi: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackh(DAG, DL, EVT { VT }, Op1, Op0));
            let mut ALo: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackl(DAG, DL, EVT { VT }, AmtMod, Z));
            let mut AHi: SDValue = DAG.getBitcast(EVT { ExtVT }, getUnpackh(DAG, DL, EVT { VT }, AmtMod, Z));
            let mut Lo: SDValue = DAG.getNode(ShiftOpc, DL, EVT { ExtVT }, RLo, ALo);
            let mut Hi: SDValue = DAG.getNode(ShiftOpc, DL, EVT { ExtVT }, RHi, AHi);
            return getPack(DAG, Subtarget, DL, VT, Lo, Hi, !IsFSHR);
        }
        return SDValue {};
    }
    assert!((VT == i8 || VT == i16 || VT == i32 || VT == i64), "Unexpected funnel shift type!");
    let mut OptForSize: bool = DAG.shouldOptForSize();
    let mut ExpandFunnel: bool = !OptForSize && Subtarget()();
    if (VT == i8 || (ExpandFunnel && VT == i16)) && !isa(Amt) {
        let mut Mask: SDValue = DAG.getConstant(EltSizeInBits - 1, DL, Amt.getValueType(), false, false);
        let mut HiShift: SDValue = DAG.getConstant(EltSizeInBits, DL, Amt.getValueType(), false, false);
        Op0 = DAG.getAnyExtOrTrunc(Op0, DL, EVT { i32 });
        Op1 = DAG.getZExtOrTrunc(Op1, DL, EVT { i32 });
        Amt = DAG.getNode(AND, DL, Amt.getValueType(), Amt, Mask);
        let mut Res: SDValue = DAG.getNode(SHL, DL, EVT { i32 }, Op0, HiShift);
        Res = DAG.getNode(OR, DL, EVT { i32 }, Res, Op1);
        if IsFSHR {
            Res = DAG.getNode(SRL, DL, EVT { i32 }, Res, Amt);
        } else {
            Res = DAG.getNode(SHL, DL, EVT { i32 }, Res, Amt);
            Res = DAG.getNode(SRL, DL, EVT { i32 }, Res, HiShift);
        }
        return DAG.getZExtOrTrunc(Res, DL, EVT { VT });
    }
    if VT == i8 || ExpandFunnel {
        return SDValue {};
    }
    if VT == i16 {
        Amt = DAG.getNode(AND, DL, Amt.getValueType(), Amt, DAG.getConstant(15, DL, Amt.getValueType(), false, false));
        let mut FSHOp: u32 = 0;
        return DAG.getNode(FSHOp, DL, EVT { VT }, Op0, Op1, Amt);
    }
    return Op;
}

fn LowerRotate(Op: SDValue, Subtarget: *X86Subtarget, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    assert!(VT.isVector(), "Custom lowering only for vector rotates!");
    let mut DL: SDLoc = SDLoc { Op };
    let mut R: SDValue = Op.getOperand(0);
    let mut Amt: SDValue = Op.getOperand(1);
    let mut Opcode: u32 = Op.getOpcode();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut IsROTL: bool = Opcode == ROTL;
    let mut CstSplatValue: APInt = APInt {};
    let mut IsCstSplat: bool = isConstantSplat(Amt, CstSplatValue, true);
    if IsCstSplat && CstSplatValue.urem(EltSizeInBits) == 0 {
        return R;
    }
    let mut Z: SDValue = DAG.getConstant(0, DL, EVT { VT }, false, false);
    if !IsROTL {
        if DAG.FoldConstantArithmetic {
            NegAmt;
        } else {
            return DAG.getNode(ROTL, DL, EVT { VT }, R, NegAmt);
        }
        if Subtarget()() {
            return DAG.getNode(ROTL, DL, EVT { VT }, R, DAG.getNode(SUB, DL, EVT { VT }, Z, Amt));
        }
    }
    if IsCstSplat && Subtarget()() && VT.getScalarType() == i8 && DAG.getTargetLoweringInfo().isTypeLegal {
        let mut RotAmt: u64 = CstSplatValue.urem(EltSizeInBits);
        let mut Mask: SDValue = getGFNICtrlMask(Opcode, DAG, DL, VT, RotAmt);
        return DAG;
    }
    if VT.is256BitVector() && (Subtarget()() || !Subtarget.hasAVX2()) {
        return splitVectorIntBinary(Op, DAG, DL);
    }
    if EltSizeInBits == 8 && IsCstSplat && CstSplatValue.urem(EltSizeInBits) == 7 && IsROTL && !Subtarget.hasAVX512() {
        let mut One: SDValue = DAG.getConstant(1, DL, EVT { VT }, false, false);
        let mut LSB: SDValue = DAG.getNode(AND, DL, EVT { VT }, R, One);
        let mut Neg: SDValue = DAG.getNegative(LSB, DL, EVT { VT });
        return DAG.getNode(AVGCEILU, DL, EVT { VT }, R, Neg);
    }
    if IsROTL && EltSizeInBits == 8 && IsCstSplat && CstSplatValue.urem(EltSizeInBits) == 1 && !Subtarget.hasAVX512() {
        let mut Double: SDValue = DAG.getNode(ADD, DL, EVT { VT }, R, R);
        let mut Zero: SDValue = DAG.getConstant(0, DL, EVT { VT }, false, false);
        let mut CmpNeg: SDValue = DAG.getSetCC(DL, EVT { VT }, R, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        return DAG.getNode(SUB, DL, EVT { VT }, Double, CmpNeg);
    }
    if IsCstSplat {
        let mut RotAmt: u64 = CstSplatValue.urem(EltSizeInBits);
        let mut ShlAmt: u64 = if IsROTL { RotAmt } else { (EltSizeInBits - RotAmt) };
        let mut SrlAmt: u64 = if IsROTL { (EltSizeInBits - RotAmt) } else { RotAmt };
        let mut Shl: SDValue = DAG.getNode(SHL, DL, EVT { VT }, R, DAG.getShiftAmountConstant(ShlAmt, EVT { VT }, DL));
        let mut Srl: SDValue = DAG.getNode(SRL, DL, EVT { VT }, R, DAG.getShiftAmountConstant(SrlAmt, EVT { VT }, DL));
        return DAG.getNode(OR, DL, EVT { VT }, Shl, Srl);
    }
    if VT.is512BitVector() && !Subtarget.useBWIRegs() {
        return splitVectorIntBinary(Op, DAG, DL);
    }
    assert!((VT == v4i32 || VT == v8i16 || VT == v16i8 || ((VT == v8i32 || VT == v16i16 || VT == v32i8) && Subtarget.hasAVX2()) || ((VT == v32i16 || VT == v64i8) && Subtarget.useBWIRegs())), "Only vXi32/vXi16/vXi8 vector rotates supported");
    let mut ExtSVT: MVT = getIntegerVT(2 * EltSizeInBits);
    let mut ExtVT: MVT = getVectorVT(ExtSVT, NumElts / 2);
    let mut AmtMask: SDValue = DAG.getConstant(EltSizeInBits - 1, DL, EVT { VT }, false, false);
    let mut AmtMod: SDValue = DAG.getNode(AND, DL, EVT { VT }, Amt, AmtMask);
