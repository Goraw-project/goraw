    let mut Big: SDValue = DAG;
    if VT == v8i32 && !Subtarget.hasAVX2() {
        let mut Overflow: SDValue = DAG.getNode(OR, dl, EVT { VT }, Small, Big);
        return DAG;
    }
    let mut IsOverflown: SDValue = getTargetVShiftByConstNode(dl, VT, Small, DstBits - 1, DAG);
    return DAG.getNode(OR, dl, EVT { VT }, Small, DAG.getNode(AND, dl, EVT { VT }, Big, IsOverflown));
}

