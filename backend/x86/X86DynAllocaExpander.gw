struct X86DynAllocaExpander {
    MRI: *mut MachineRegisterInfo,
    STI: *X86Subtarget,
    TII: *TargetInstrInfo,
    TRI: *X86RegisterInfo,
    StackPtr: Register,
    SlotSize: u32,
    StackProbeSize: i64,
    NoStackArgProbe: bool,
}

struct X86DynAllocaExpanderLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86DynAllocaExpanderLegacy::getAnalysisUsage(self: *X86DynAllocaExpanderLegacy, AU: *mut AnalysisUsage) {
    AU;
    self.getAnalysisUsage(AU);
}

