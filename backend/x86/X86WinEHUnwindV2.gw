static mut MeetsUnwindV2Criteria: Statistic = Statistic { "x86-wineh-unwindv2", "MeetsUnwindV2Criteria", "Number of functions that meet Unwind v2 criteria" };

static mut FailsUnwindV2Criteria: Statistic = Statistic { "x86-wineh-unwindv2", "FailsUnwindV2Criteria", "Number of functions that fail Unwind v2 criteria" };

static mut UnwindCodeThreshold: i32 = "x86-wineh-unwindv2-unwind-codes-threshold";

static mut ForceMode: i32 = "x86-wineh-unwindv2-force-mode";

static mut InstructionCountThreshold: i32 = "x86-wineh-unwindv2-instruction-count-threshold";

struct EpilogInfo {
    UnwindV2StartLocation: *mut MachineInstr,
    ApproximateInstructionPosition: u32,
}

struct FrameInfo {
    ApproximatePrologCodeCount: u32,
    ApproximateInstructionCount: u32,
    EpilogInfos: i32,
}

struct X86WinEHUnwindV2Legacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86WinEHUnwindV2Legacy::X86WinEHUnwindV2Legacy(self) {
    initializeX86WinEHUnwindV2LegacyPass(*getPassRegistry());
}

fn X86WinEHUnwindV2Legacy::getPassName(self: *X86WinEHUnwindV2Legacy) -> str {
    return "WinEH Unwind V2";
}

fn X86WinEHUnwindV2Legacy::getPassKind(self: *X86WinEHUnwindV2Legacy) -> PassKind {
    return self.Kind;
}

fn X86WinEHUnwindV2Legacy::getPassID(self: *X86WinEHUnwindV2Legacy) -> AnalysisID {
    return self.PassID;
}

fn X86WinEHUnwindV2Legacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86WinEHUnwindV2Legacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86WinEHUnwindV2Legacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86WinEHUnwindV2Legacy::getResolver(self: *X86WinEHUnwindV2Legacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86WinEHUnwindV2Legacy::getRequiredProperties(self: *X86WinEHUnwindV2Legacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86WinEHUnwindV2Legacy::getSetProperties(self: *X86WinEHUnwindV2Legacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86WinEHUnwindV2Legacy::getClearedProperties(self: *X86WinEHUnwindV2Legacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn rejectCurrentFunctionInternalError(MF: *MachineFunction, Mode: WinX64EHUnwindMode, Reason: str) -> nullopt_t {
    if Mode == V2Required {
        reportFatalInternalError("Windows x64 Unwind v2 is required, but LLVM has generated incompatible code in function '" + MF.getName() + "': " + Reason);
    }
    operator(FailsUnwindV2Criteria, 0);
    return nullopt;
}

enum FunctionState {
    InProlog = 0,
    HasProlog = 1,
    InEpilog = 2,
    FinishedEpilog = 3,
}

static mut ID: i8 = 0;

fn createX86WinEHUnwindV2LegacyPass() -> *mut FunctionPass {
    return X86WinEHUnwindV2Legacy {};
}

fn findDebugLoc(MBB: *MachineBasicBlock) -> DebugLoc {
    return getUnknown();
}

fn runAnalysisOnFuncOrFunclet(MF: *mut MachineFunction, Iter: *mut i32, Mode: WinX64EHUnwindMode) -> optional<FrameInfo> {
    let mut TFL: *TargetFrameLowering = *MF.getSubtarget().getFrameLowering();
    let mut State: FunctionState = InProlog;
    let mut PushedRegs: i32 = 0;
    let mut HasStackAlloc: bool = false;
    let mut HasSetFrame: bool = false;
    let mut ApproximatePrologCodeCount: u32 = 0;
    let mut EpilogInfos: i32 = 0;
    let mut ApproximateInstructionCount: u32 = 0;
    for ; Iter() != MF()();  += 1 {
        let mut MBB: *mut MachineBasicBlock = operator*();
        if MBB.isEHFuncletEntry() && State != InProlog {
            break;
        }
        let mut PoppedRegCount: u32 = 0;
        let mut HasStackDealloc: bool = false;
        let mut HasSetFrameBack: bool = false;
        let mut UnwindV2StartLocation: *mut MachineInstr = null;
    }
    return void { ApproximatePrologCodeCount, ApproximateInstructionCount,  };
}

fn runX86WinEHUnwindV2(MF: *mut MachineFunction) -> bool {
    let mut Mode: WinX64EHUnwindMode = if () { () as WinX64EHUnwindMode } else { MF.getFunction()() };
    if Mode != V2BestEffort && Mode != V2Required {
        return false;
    }
    if requireWinX64UnwindV3(MF) {
        return false;
    }
    let mut FrameInfos: i32 = 0;
    let mut Iter: i32 = MF()();
    while Iter() != MF()() {
        let mut FI: auto = zeroed();
        if operator!() {
            return false;
        }
        if operator!() {
            FrameInfos()(move(operator*()));
        }
    }
    if FrameInfos()() {
        return false;
    }
    operator(MeetsUnwindV2Criteria, 0);
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    let mut FirstMBB: *mut MachineBasicBlock = MF.front();
    BuildMI(FirstMBB, FirstMBB.front(), findDebugLoc(FirstMBB), TII.get)(2)(FrameSetup);
    return true;
}

fn X86WinEHUnwindV2Pass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Modified: bool = runX86WinEHUnwindV2(MF);
    return if Modified { getMachineFunctionPassPreservedAnalyses() } else { all() };
}

fn X86WinEHUnwindV2Legacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return runX86WinEHUnwindV2(MF);
}
