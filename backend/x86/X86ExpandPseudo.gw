struct X86ExpandPseudoImpl {
    STI: *X86Subtarget,
    TII: *X86InstrInfo,
    TRI: *X86RegisterInfo,
    X86FI: *X86MachineFunctionInfo,
    X86FL: *X86FrameLowering,
}

struct X86ExpandPseudoLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
    STI: *X86Subtarget,
    TII: *X86InstrInfo,
    TRI: *X86RegisterInfo,
    X86FI: *X86MachineFunctionInfo,
    X86FL: *X86FrameLowering,
}

fn X86ExpandPseudoLegacy::getAnalysisUsage(self: *X86ExpandPseudoLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage(AU);
}

fn X86ExpandPseudoLegacy::getRequiredProperties(self: *X86ExpandPseudoLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn X86ExpandPseudoLegacy::getPassName(self: *X86ExpandPseudoLegacy) -> str {
    return "X86 pseudo instruction expansion pass";
}

fn X86ExpandPseudoLegacy::getPassKind(self: *X86ExpandPseudoLegacy) -> PassKind {
    return self.Kind;
}

fn X86ExpandPseudoLegacy::getPassID(self: *X86ExpandPseudoLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86ExpandPseudoLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86ExpandPseudoLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86ExpandPseudoLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86ExpandPseudoLegacy::getResolver(self: *X86ExpandPseudoLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86ExpandPseudoLegacy::getSetProperties(self: *X86ExpandPseudoLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86ExpandPseudoLegacy::getClearedProperties(self: *X86ExpandPseudoLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn X86ExpandPseudoImpl::expandICallBranchFunnel(self, MBB: *mut MachineBasicBlock, MBBI: iterator) {
    let mut JTMBB: *mut MachineBasicBlock = MBB;
    let mut JTInst: *mut MachineInstr = &mut operator(MBBI);
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut BB: *BasicBlock = MBB.getBasicBlock();
    let mut InsPt: iterator = MBB;
    operator(InsPt);
    let mut TargetMBBs: []pair<MachineBasicBlock *, unsigned int> = []pair<MachineBasicBlock *, unsigned int> {};
    let mut DL: *DebugLoc = JTInst.getDebugLoc();
    let mut Selector: MachineOperand = JTInst.getOperand(0);
    let mut CombinedGlobal: *GlobalValue = JTInst.getOperand(1).getGlobal();
    let mut CmpTarget: Closure_1 = Closure_1 { Selector: &mut Selector, MBB: &mut MBB, MBBI: &mut MBBI, DL: &mut DL, cap_4: self, CombinedGlobal: &mut CombinedGlobal, JTInst: &mut JTInst };
    let mut CreateMBB: Closure_2 = Closure_2 { MF: &mut MF, BB: &mut BB, MBB: &mut MBB };
    let mut EmitCondJump: Closure_3 = Closure_3 { MBB: &mut MBB, MBBI: &mut MBBI, DL: &mut DL, cap_3: self, CreateMBB: &mut CreateMBB, MF: &mut MF, InsPt: &mut InsPt };
    let mut EmitCondJumpTarget: Closure_4 = Closure_4 { CreateMBB: &mut CreateMBB, TargetMBBs: &mut TargetMBBs, EmitCondJump: &mut EmitCondJump };
    let mut EmitTailCall: Closure_5 = Closure_5 { MBB: &mut MBB, MBBI: &mut MBBI, DL: &mut DL, cap_3: self, JTInst: &mut JTInst };
    let mut EmitBranchFunnel: function<void (unsigned int, unsigned int)> = Closure_6 { EmitTailCall: &mut EmitTailCall, CmpTarget: &mut CmpTarget, EmitCondJumpTarget: &mut EmitCondJumpTarget, EmitBranchFunnel: &mut EmitBranchFunnel, CreateMBB: &mut CreateMBB, EmitCondJump: &mut EmitCondJump, MF: &mut MF, InsPt: &mut InsPt, MBB: &mut MBB, MBBI: &mut MBBI };
    EmitBranchFunnel.call(0, (JTInst.getNumOperands() - 2) / 2);
    for P in TargetMBBs {
        MF.insert(InsPt, P.first);
        BuildMI(P.first, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(TAILJMPd64)).add(JTInst.getOperand(3 + 2 * P.second));
    }
    JTMBB.erase(JTInst);
}

fn X86ExpandPseudoImpl::expandCALL_RVMARKER(self, MBB: *mut MachineBasicBlock, MBBI: iterator) {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut OriginalCall: *mut MachineInstr = null;
    assert!((MI.getOperand(1).isGlobal() || MI.getOperand(1).isReg()), "invalid operand for regular call");
    let mut Opc: u32 = -1;
    if MI.getOpcode() == CALL64m_RVMARKER {
        Opc = CALL64m;
    } else if MI.getOpcode() == CALL64r_RVMARKER {
        Opc = CALL64r;
    } else if MI.getOpcode() == CALL64pcrel32_RVMARKER {
        Opc = CALL64pcrel32;
    } else {
        llvm_unreachable_internal("unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ExpandPseudo.cpp", 218);
    }
    OriginalCall = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Opc)).getInstr();
    let mut RAXImplicitDead: bool = false;
    for Op in drop_begin(MI.operands(), 1) {
        if Op.isReg() && Op.isImplicit() && Op.isDead() && self.TRI.regsOverlap(Op.getReg(), RAX) {
            Op.setIsDead(false);
            Op.setIsDef(true);
            RAXImplicitDead = true;
        }
        OriginalCall.addOperand(Op);
    }
    let mut TargetReg: (unnamed enum at P:\llvm-build\lib\Target\X86\X86GenRegisterInfoEnums.inc:15:1) = if self.STI.getTargetTriple().isOSWindows() { RCX } else { RDI };
    let mut Marker: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MOV64rr)).addReg(TargetReg, Define, 0).addReg(RAX, RegState {}, 0).getInstr();
    if MI.shouldUpdateAdditionalCallInfo() {
        MBB.getParent().moveAdditionalCallInfo(&mut MI, Marker);
    }
    let mut RegMask: *u32 = self.TRI.getCallPreservedMask(*MBB.getParent(), C);
    let mut RtCall: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CALL64pcrel32)).addGlobalAddress(MI.getOperand(0).getGlobal(), 0, 0).addRegMask(RegMask).addReg(RAX, Implicit | (if RAXImplicitDead { (Dead | Define) } else { Define }), 0).getInstr();
    MI.eraseFromParent();
    let mut TM: *TargetMachine = MBB.getParent().getTarget();
    if TM.getTargetTriple().isOSDarwin() {
        finalizeBundle(MBB, OriginalCall.getIterator(), next(RtCall.getIterator(), 1));
    }
}

fn X86ExpandPseudoImpl::expandMI(self, MBB: *mut MachineBasicBlock, MBBI: iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut Opcode: u32 = MI.getOpcode();
    let mut DL: *DebugLoc = operator(MBBI).getDebugLoc();
    match Opcode {
        _ => {
            return false;
        },
        TCRETURNdi => {
            TCRETURNdicc;
        },
        EH_RETURN => {
            EH_RETURN64;
        },
        IRET => {
            let mut StackAdj: i64 = operator(MBBI).getOperand(0).getImm();
            self.X86FL.emitSPUpdate(MBB, MBBI, DL, StackAdj, true);
            let mut RetOp: u32 = if self.STI.is64Bit() { IRET64 } else { IRET32 };
            if self.STI.is64Bit() && self.STI.hasUINTR() && MBB.getParent().getTarget().getCodeModel() != Kernel {
                RetOp = UIRET;
            }
            BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(RetOp));
            MBB.erase(MBBI);
            return true;
        },
        RET => {
            let mut StackAdj: i64 = operator(MBBI).getOperand(0).getImm();
            let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
            if StackAdj == 0 {
                MIB = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if self.STI.is64Bit() { RET64 } else { RET32 }));
            } else if isUInt(StackAdj) {
                MIB = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if self.STI.is64Bit() { RETI64 } else { RETI32 })).addImm(StackAdj);
            } else {
                assert!(!self.STI.is64Bit(), "shouldn't need to do this for x86_64 targets!");
                BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(POP32r)).addReg(ECX, Define, 0);
                self.X86FL.emitSPUpdate(MBB, MBBI, DL, StackAdj, true);
                BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(PUSH32r)).addReg(ECX, RegState {}, 0);
                MIB = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(RET32));
            }
            for let mut I: u32 = 1;
let mut E: u32 = operator(MBBI).getNumOperands(); I != E; I += 1 {
                MIB.add(operator(MBBI).getOperand(I));
            }
            MBB.erase(MBBI);
            return true;
        },
        LCMPXCHG16B_SAVE_RBX => {
            let mut InArg: *MachineOperand = operator(MBBI).getOperand(6);
            let mut SaveRbx: Register = operator(MBBI).getOperand(7).getReg();
            self.TII.copyPhysReg(MBB, MBBI, DL, RBX, InArg.getReg(), false, false, false);
            let mut NewInstr: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LCMPXCHG16B)).operator llvm::MachineInstr *();
            let mut Base: *MachineOperand = operator(MBBI).getOperand(1);
            if Base.getReg() == RBX || Base.getReg() == EBX {
                NewInstr.addOperand(CreateReg(if Base.getReg() == RBX { SaveRbx } else { self.TRI.getSubReg(SaveRbx.operator MCRegister(), sub_32bit) }, false, false, false, false, false, false, 0, false, false, false));
            } else {
                NewInstr.addOperand(Base);
            }
            for let mut Idx: u32 = 1 + 1; Idx < 1 + AddrNumOperands; Idx += 1 {
                NewInstr.addOperand(operator(MBBI).getOperand(Idx));
            }
            NewInstr.getOperand(7).setIsDead(operator(MBBI).getOperand(11).isDead());
            self.TII.copyPhysReg(MBB, MBBI, DL, RBX, SaveRbx, true, false, false);
            operator(MBBI).eraseFromParent();
            return true;
        },
        MASKPAIR16LOAD => {
            let mut Disp: i64 = operator(MBBI).getOperand(1 + AddrDisp).getImm();
            assert!(Disp >= 0 && Disp <= 2147483647 - 2, "Unexpected displacement");
            let mut Reg: Register = operator(MBBI).getOperand(0).getReg();
            let mut DstIsDead: bool = operator(MBBI).getOperand(0).isDead();
            let mut Reg0: Register = self.TRI.getSubReg(Reg.operator MCRegister(), sub_mask_0);
            let mut Reg1: Register = self.TRI.getSubReg(Reg.operator MCRegister(), sub_mask_1);
            let mut MIBLo: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get((if self.STI.hasEGPR() { KMOVWkm_EVEX } else { KMOVWkm }))).addReg(Reg0, Define | getDeadRegState(DstIsDead), 0);
            let mut MIBHi: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get((if self.STI.hasEGPR() { KMOVWkm_EVEX } else { KMOVWkm }))).addReg(Reg1, Define | getDeadRegState(DstIsDead), 0);
            for let mut i: i32 = 0; i < AddrNumOperands; i += 1 {
                MIBLo.add(operator(MBBI).getOperand(1 + i));
                if i == AddrDisp {
                    MIBHi.addImm(Disp + 2);
                } else {
                    MIBHi.add(operator(MBBI).getOperand(1 + i));
                }
            }
            let mut OldMMO: *mut MachineMemOperand = operator(MBBI).memoperands().front();
            let mut MF: *mut MachineFunction = MBB.getParent();
            let mut MMOLo: *mut MachineMemOperand = MF.getMachineMemOperand(OldMMO, 0, 2);
            let mut MMOHi: *mut MachineMemOperand = MF.getMachineMemOperand(OldMMO, 2, 2);
            MIBLo.setMemRefs(MMOLo);
            MIBHi.setMemRefs(MMOHi);
            MBB.erase(MBBI);
            return true;
        },
        MASKPAIR16STORE => {
            let mut Disp: i64 = operator(MBBI).getOperand(AddrDisp).getImm();
            assert!(Disp >= 0 && Disp <= 2147483647 - 2, "Unexpected displacement");
            let mut Reg: Register = operator(MBBI).getOperand(AddrNumOperands).getReg();
            let mut SrcIsKill: bool = operator(MBBI).getOperand(AddrNumOperands).isKill();
            let mut Reg0: Register = self.TRI.getSubReg(Reg.operator MCRegister(), sub_mask_0);
            let mut Reg1: Register = self.TRI.getSubReg(Reg.operator MCRegister(), sub_mask_1);
            let mut MIBLo: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get((if self.STI.hasEGPR() { KMOVWmk_EVEX } else { KMOVWmk })));
            let mut MIBHi: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get((if self.STI.hasEGPR() { KMOVWmk_EVEX } else { KMOVWmk })));
            for let mut i: i32 = 0; i < AddrNumOperands; i += 1 {
                MIBLo.add(operator(MBBI).getOperand(i));
                if i == AddrDisp {
                    MIBHi.addImm(Disp + 2);
                } else {
                    MIBHi.add(operator(MBBI).getOperand(i));
                }
            }
            MIBLo.addReg(Reg0, getKillRegState(SrcIsKill), 0);
            MIBHi.addReg(Reg1, getKillRegState(SrcIsKill), 0);
            let mut OldMMO: *mut MachineMemOperand = operator(MBBI).memoperands().front();
            let mut MF: *mut MachineFunction = MBB.getParent();
            let mut MMOLo: *mut MachineMemOperand = MF.getMachineMemOperand(OldMMO, 0, 2);
            let mut MMOHi: *mut MachineMemOperand = MF.getMachineMemOperand(OldMMO, 2, 2);
            MIBLo.setMemRefs(MMOLo);
            MIBHi.setMemRefs(MMOHi);
            MBB.erase(MBBI);
            return true;
        },
        MWAITX_SAVE_RBX => {
            let mut InArg: *MachineOperand = operator(MBBI).getOperand(1);
            self.TII.copyPhysReg(MBB, MBBI, DL, EBX, InArg.getReg(), InArg.isKill(), false, false);
            BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MWAITXrrr));
            let mut SaveRbx: Register = operator(MBBI).getOperand(2).getReg();
            self.TII.copyPhysReg(MBB, MBBI, DL, RBX, SaveRbx, true, false, false);
            operator(MBBI).eraseFromParent();
            return true;
        },
        ICALL_BRANCH_FUNNEL => {
            self.expandICallBranchFunnel(&mut MBB, MBBI);
        },
        PLDTILECFGV => {
            MI.setDesc(self.TII.get((if self.STI.hasEGPR() { LDTILECFG_EVEX } else { LDTILECFG })));
            return true;
        },
        PTILELOADDV => {
            PTILELOADDT1V;
        },
        PTCMMIMFP16PSV => {
            PTCMMRLFP16PSV;
        },
        PTILESTOREDV => {
            for let mut i: i32 = 1; i >= 0; i -= 1 {
                MI.removeOperand(i);
            }
            MI.setDesc(self.TII.get((if self.STI.hasEGPR() { TILESTORED_EVEX } else { TILESTORED })));
            return true;
        },
        PTILEZEROV => {
            for let mut i: i32 = 2; i > 0; i -= 1 {
                MI.removeOperand(i);
            }
            MI.setDesc(self.TII.get(TILEZERO));
            return true;
        },
        CALL64pcrel32_RVMARKER => {
            CALL64r_RVMARKER;
        },
        CALL64r_ImpCall => {
            MI.setDesc(self.TII.get(CALL64r));
        },
        ADD32mi_ND => {
            ADD64mi32_ND;
        },
    }
    llvm_unreachable_internal("Previous switch has a fallthrough?", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ExpandPseudo.cpp", 822);
}

fn X86ExpandPseudoImpl::expandVastartSaveXmmRegs(self: *X86ExpandPseudoImpl, EntryBlk: *mut MachineBasicBlock, VAStartPseudoInstr: iterator) {
    assert!(operator(VAStartPseudoInstr).getOpcode() == VASTART_SAVE_XMM_REGS);
    let mut Func: *mut MachineFunction = EntryBlk.getParent();
    let mut TII: *TargetInstrInfo = self.STI.getInstrInfo();
    let mut DL: *DebugLoc = operator(VAStartPseudoInstr).getDebugLoc();
    let mut CountReg: Register = operator(VAStartPseudoInstr).getOperand(0).getReg();
    let mut LiveRegs: LivePhysRegs = *self.STI.getRegisterInfo();
    let mut Clobbers: pair<MCPhysReg, const MachineOperand *>, 8> = pair<MCPhysReg, const MachineOperand *>, 8> {};
    LiveRegs.addLiveIns(*EntryBlk);
    for MI in EntryBlk.instrs() {
        if MI.getOpcode() == operator(VAStartPseudoInstr).getOpcode() {
            break;
        }
        LiveRegs.stepForward(MI, Clobbers);
    }
    let mut LLVMBlk: *BasicBlock = EntryBlk.getBasicBlock();
    let mut EntryBlkIter: iterator = operator(EntryBlk.getIterator());
    let mut GuardedRegsBlk: *mut MachineBasicBlock = Func.CreateMachineBasicBlock(LLVMBlk, nullopt);
    let mut TailBlk: *mut MachineBasicBlock = Func.CreateMachineBasicBlock(LLVMBlk, nullopt);
    Func.insert(EntryBlkIter, GuardedRegsBlk);
    Func.insert(EntryBlkIter, TailBlk);
    TailBlk.splice(TailBlk.begin(), EntryBlk, next(VAStartPseudoInstr, 1), EntryBlk.end());
    TailBlk.transferSuccessorsAndUpdatePHIs(EntryBlk);
    let mut FrameOffset: u64 = operator(VAStartPseudoInstr).getOperand(4).getImm();
    let mut VarArgsRegsOffset: u64 = operator(VAStartPseudoInstr).getOperand(6).getImm();
    let mut MOVOpc: u32 = if self.STI.hasAVX() { VMOVAPSmr } else { MOVAPSmr };
    for let mut OpndIdx: i64 = 7;
let mut RegIdx: i64 = 0; OpndIdx < operator(VAStartPseudoInstr).getNumOperands() - 1; OpndIdx += 1 , RegIdx += 1 {
        let mut NewMI: MachineInstrBuilder = BuildMI(GuardedRegsBlk, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOVOpc));
        for let mut i: i32 = 0; i < AddrNumOperands; i += 1 {
            if i == AddrDisp {
                NewMI.addImm(FrameOffset + VarArgsRegsOffset + RegIdx * 16);
            } else {
                NewMI.add(operator(VAStartPseudoInstr).getOperand(i + 1));
            }
        }
        NewMI.addReg(operator(VAStartPseudoInstr).getOperand(OpndIdx).getReg(), RegState {}, 0);
        assert!(operator(VAStartPseudoInstr).getOperand(OpndIdx).getReg().isPhysical();
    }
    EntryBlk.addSuccessor(GuardedRegsBlk, getUnknown());
    GuardedRegsBlk.addSuccessor(TailBlk, getUnknown());
    if !self.STI.isCallingConvWin64(Func.getFunction().getCallingConv()) {
        BuildMI(EntryBlk, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(TEST8rr)).addReg(CountReg, RegState {}, 0).addReg(CountReg, RegState {}, 0);
        BuildMI(EntryBlk, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(JCC_1)).addMBB(TailBlk, 0).addImm(COND_E);
        EntryBlk.addSuccessor(TailBlk, getUnknown());
    }
    addLiveIns(*GuardedRegsBlk, LiveRegs);
    addLiveIns(*TailBlk, LiveRegs);
    operator(VAStartPseudoInstr).eraseFromParent();
}

fn X86ExpandPseudoImpl::expandMBB(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Modified: bool = false;
    let mut MBBI: iterator = MBB.begin();
    let mut E: iterator = MBB.end();
    while MBBI != E {
        let mut NMBBI: iterator = next(MBBI, 1);
        Modified |= self.expandMI(MBB, MBBI);
        MBBI = NMBBI;
    }
    return Modified;
}

fn X86ExpandPseudoImpl::expandPseudosWhichAffectControlFlow(self, MF: *mut MachineFunction) -> bool {
    for Instr in MF.front().instrs() {
        if Instr.getOpcode() == VASTART_SAVE_XMM_REGS {
            self.expandVastartSaveXmmRegs(&mut (MF.front()), Instr);
            return true;
        }
    }
    return false;
}

fn X86ExpandPseudoImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    self.STI = &mut MF.getSubtarget();
    self.TII = self.STI.getInstrInfo();
    self.TRI = self.STI.getRegisterInfo();
    self.X86FI = MF.getInfo();
    self.X86FL = self.STI.getFrameLowering();
    let mut Modified: bool = self.expandPseudosWhichAffectControlFlow(MF);
    for MBB in MF {
        Modified |= self.expandMBB(MBB);
    }
    return Modified;
}

fn createX86ExpandPseudoLegacyPass() -> *mut FunctionPass {
    return X86ExpandPseudoLegacy {};
}

fn X86ExpandPseudoLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut Impl: X86ExpandPseudoImpl = X86ExpandPseudoImpl {};
    return Impl.runOnMachineFunction(MF);
}

fn X86ExpandPseudoPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86ExpandPseudoImpl = X86ExpandPseudoImpl {};
    let mut Changed: bool = Impl.runOnMachineFunction(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

struct Closure_1 {
    Selector: *mut MachineOperand,
    MBB: *mut *mut MachineBasicBlock,
    MBBI: *mut iterator,
    DL: *mut DebugLoc,
    cap_4: *mut X86ExpandPseudoImpl,
    CombinedGlobal: *mut *GlobalValue,
    JTInst: *mut *mut MachineInstr,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Target: u32) {
        if (*self.Selector).isReg() {
            (*self.MBB).addLiveIn((*self.Selector).getReg().operator MCRegister(), getAll());
        }
        BuildMI(*(*self.MBB), (*self.MBBI), MIMetadata { DL: (*self.DL), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LEA64r), R11).addReg(RIP, RegState {}, 0).addImm(1).addReg(0, RegState {}, 0).addGlobalAddress((*self.CombinedGlobal), (*self.JTInst).getOperand(2 + 2 * Target).getImm(), 0).addReg(0, RegState {}, 0);
        BuildMI(*(*self.MBB), (*self.MBBI), MIMetadata { DL: (*self.DL), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CMP64rr)).add((*self.Selector)).addReg(R11, RegState {}, 0);
    }

struct Closure_2 {
    MF: *mut *mut MachineFunction,
    BB: *mut *BasicBlock,
    MBB: *mut *mut MachineBasicBlock,
}

unsafe fn Closure_2::call(self: *mut Closure_2) -> *mut MachineBasicBlock {
        let mut NewMBB: *mut MachineBasicBlock = (*self.MF).CreateMachineBasicBlock((*self.BB), nullopt);
        (*self.MBB).addSuccessor(NewMBB, getUnknown());
        if !(*self.MBB).isLiveIn(EFLAGS, getAll()) {
            (*self.MBB).addLiveIn(EFLAGS, getAll());
        }
        return NewMBB;
    }

struct Closure_3 {
