struct X86InsertX87WaitLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86InsertX87WaitLegacy::getPassName(self: *X86InsertX87WaitLegacy) -> str {
    return "X86 insert wait instruction";
}

fn X86InsertX87WaitLegacy::getPassKind(self: *X86InsertX87WaitLegacy) -> PassKind {
    return self.Kind;
}

fn X86InsertX87WaitLegacy::getPassID(self: *X86InsertX87WaitLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86InsertX87WaitLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86InsertX87WaitLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86InsertX87WaitLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86InsertX87WaitLegacy::getResolver(self: *X86InsertX87WaitLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86InsertX87WaitLegacy::getRequiredProperties(self: *X86InsertX87WaitLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86InsertX87WaitLegacy::getSetProperties(self: *X86InsertX87WaitLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86InsertX87WaitLegacy::getClearedProperties(self: *X86InsertX87WaitLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86InsertX87WaitLegacyPass() -> *mut FunctionPass {
    return X86InsertX87WaitLegacy {};
}

enum X87ControlKind {
    NotControl = 0,
    Waiting = 1,
    NonWaiting = 2,
}

fn classifyX87ControlInstruction(Opcode: u32) -> X87ControlKind {
    match Opcode {
        _ => {
            return NotControl;
        },
    }
}

fn insertWaitInstruction(MF: *mut MachineFunction) -> bool {
    if !MF.getFunction().hasFnAttribute(StrictFP) {
        return false;
    }
    let mut ST: *X86Subtarget = MF;
    let mut TII: *X86InstrInfo = ST.getInstrInfo();
    let mut Changed: bool = false;
    for MBB in MF {
        for let mut MI: iterator = MBB.begin(); MI != MBB.end(); operator(MI) {
            if !isX87Instruction(operator(MI)) {
                continue;
            }
            if !(operator(MI).mayRaiseFPException() || operator(MI).mayLoadOrStore(AnyInBundle)) || classifyX87ControlInstruction(operator(MI).getOpcode()) != NotControl {
                continue;
            }
            let mut AfterMI: iterator = next(MI);
            let mut NextMI: iterator = iterator { AfterMI };
            while NextMI != MBB.end() && operator(NextMI).isMetaInstruction(IgnoreBundle) {
                operator(NextMI);
            }
            if NextMI != MBB.end() && !operator(NextMI).isReturn(AnyInBundle) && isX87Instruction(operator(NextMI)) && classifyX87ControlInstruction(operator(NextMI).getOpcode()) != NonWaiting {
                continue;
            }
            BuildMI(MBB, AfterMI, operator(MI).getDebugLoc(), TII());
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-insert-x87-wait", 1) {
                    dbgs() << "\nInsert wait after:\t" << operator(MI);
                }
            }
                if !(false) { break; }
            }
            operator(MI);
            Changed = true;
        }
    }
    return Changed;
}

fn X86InsertX87WaitLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return insertWaitInstruction(MF);
}

fn X86InsertX87WaitPass::run(self, MF: *mut MachineFunction, arg: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if insertWaitInstruction(MF) { getMachineFunctionPassPreservedAnalyses() } else { all() };
}
