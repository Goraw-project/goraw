    NumOperands: *mut u32,
    cap_3: *mut X86FixupInstTuningImpl,
}

unsafe fn Closure_5::call(self: *mut Closure_5, NewOpc: u32) -> auto {
        if !(*self.NewOpcPreferable).call(NewOpc, true) {
            return false;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-inst-tuning", 1) {
                dbgs() << "Replacing: " << (*self.MI);
            }
        }
            if !(false) { break; }
        }
        {
            let mut MaskImm: u32 = (*self.MI).getOperand((*self.NumOperands) - 1).getImm();
            (*self.MI).removeOperand((*self.NumOperands) - 1);
            (*self.MI).addOperand((*self.MI).getOperand((*self.NumOperands) - 2));
            (*self.MI).setDesc(self.TII(NewOpc));
            (*self.MI).addOperand(CreateImm(MaskImm));
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-inst-tuning", 1) {
                dbgs() << "     With: " << (*self.MI);
            }
        }
            if !(false) { break; }
        }
        return true;
    }

