fn X86FixupInstTuningImpl::processInstruction(self, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, I: *mut iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(I);
    let mut Opc: u32 = MI.getOpcode();
    let mut NumOperands: u32 = MI.getDesc().getNumOperands();
    let mut OptSize: bool = MF.getFunction().hasOptSize();
    let mut GetInstTput: Closure_1 = Closure_1 { cap_0: self };
    let mut GetInstLat: Closure_2 = Closure_2 { cap_0: self };
    let mut GetInstSize: Closure_3 = Closure_3 { cap_0: self };
    let mut NewOpcPreferable: Closure_4 = Closure_4 { cap_0: self, GetInstTput: &mut GetInstTput, Opc: &mut Opc, GetInstLat: &mut GetInstLat, GetInstSize: &mut GetInstSize };
    let mut ProcessVPERMILPDri: Closure_5 = Closure_5 { NewOpcPreferable: &mut NewOpcPreferable, MI: &mut MI, NumOperands: &mut NumOperands, cap_3: self };
    let mut ProcessVPERMILPSri: Closure_6 = Closure_6 { NewOpcPreferable: &mut NewOpcPreferable, MI: &mut MI, NumOperands: &mut NumOperands, cap_3: self };
    let mut ProcessVPERMILPSmi: Closure_7 = Closure_7 { cap_0: self, NewOpcPreferable: &mut NewOpcPreferable, MI: &mut MI };
    let mut ProcessUNPCK: Closure_8 = Closure_8 { NewOpcPreferable: &mut NewOpcPreferable, MI: &mut MI, cap_2: self };
    let mut ProcessUNPCKToIntDomain: Closure_9 = Closure_9 { cap_0: self, NewOpcPreferable: &mut NewOpcPreferable, MI: &mut MI };
    let mut ProcessUNPCKLPDrr: Closure_10 = Closure_10 { ProcessUNPCKToIntDomain: &mut ProcessUNPCKToIntDomain, ProcessUNPCK: &mut ProcessUNPCK };
    let mut ProcessUNPCKHPDrr: Closure_11 = Closure_11 { ProcessUNPCKToIntDomain: &mut ProcessUNPCKToIntDomain, ProcessUNPCK: &mut ProcessUNPCK };
    let mut ProcessUNPCKPDrm: Closure_12 = Closure_12 { ProcessUNPCKToIntDomain: &mut ProcessUNPCKToIntDomain };
    let mut ProcessUNPCKPS: Closure_13 = Closure_13 { ProcessUNPCKToIntDomain: &mut ProcessUNPCKToIntDomain };
    let mut ProcessMOVPDToMOVPS: Closure_14 = Closure_14 { NewOpcPreferable: &mut NewOpcPreferable, cap_1: self, MF: &mut MF, MI: &mut MI };
    let mut ProcessVPERM2x128ToVINSERT128: Closure_15 = Closure_15 { MI: &mut MI, NumOperands: &mut NumOperands, NewOpcPreferable: &mut NewOpcPreferable, cap_3: self };
    let mut ProcessBLENDWToBLENDD: Closure_16 = Closure_16 { cap_0: self, NewOpcPreferable: &mut NewOpcPreferable, MI: &mut MI, NumOperands: &mut NumOperands };
    let mut ProcessBLENDToMOV: Closure_17 = Closure_17 { MI: &mut MI, NumOperands: &mut NumOperands, OptSize: &mut OptSize, NewOpcPreferable: &mut NewOpcPreferable, cap_4: self };
    let mut ProcessShiftLeftToAdd: Closure_18 = Closure_18 { MI: &mut MI, NumOperands: &mut NumOperands, NewOpcPreferable: &mut NewOpcPreferable, cap_3: self };
    let mut ProcessVPERMQToVINSERT128: Closure_19 = Closure_19 { MI: &mut MI, NumOperands: &mut NumOperands, NewOpcPreferable: &mut NewOpcPreferable, cap_3: self };
    match Opc {
        BLENDPDrri => {
            return ProcessBLENDToMOV.call(MOVSDrr, 3, 1);
        },
        VBLENDPDrri => {
            return ProcessBLENDToMOV.call(VMOVSDrr, 3, 1);
        },
        BLENDPSrri => {
            return ProcessBLENDToMOV.call(MOVSSrr, 15, 1) || ProcessBLENDToMOV.call(MOVSDrr, 15, 3);
        },
        VBLENDPSrri => {
            return ProcessBLENDToMOV.call(VMOVSSrr, 15, 1) || ProcessBLENDToMOV.call(VMOVSDrr, 15, 3);
        },
        VPBLENDWrri => {
            return ProcessBLENDWToBLENDD.call(VPBLENDDrri, 4);
        },
        VPERM2F128rri => {
            return ProcessVPERM2x128ToVINSERT128.call(VINSERTF128rri);
        },
        VPERM2I128rri => {
            return ProcessVPERM2x128ToVINSERT128.call(VINSERTI128rri);
        },
        VPERMILPDri => {
            return ProcessVPERMILPDri.call(VSHUFPDrri);
        },
        VPERMILPDYri => {
            return ProcessVPERMILPDri.call(VSHUFPDYrri);
        },
        VPERMILPDZ128ri => {
            return ProcessVPERMILPDri.call(VSHUFPDZ128rri);
        },
        VPERMILPDZ256ri => {
            return ProcessVPERMILPDri.call(VSHUFPDZ256rri);
        },
        VPERMILPDZri => {
            return ProcessVPERMILPDri.call(VSHUFPDZrri);
        },
        VPERMILPDZ128rikz => {
            return ProcessVPERMILPDri.call(VSHUFPDZ128rrikz);
        },
        VPERMILPDZ256rikz => {
            return ProcessVPERMILPDri.call(VSHUFPDZ256rrikz);
        },
        VPERMILPDZrikz => {
            return ProcessVPERMILPDri.call(VSHUFPDZrrikz);
        },
        VPERMILPDZ128rik => {
            return ProcessVPERMILPDri.call(VSHUFPDZ128rrik);
        },
        VPERMILPDZ256rik => {
            return ProcessVPERMILPDri.call(VSHUFPDZ256rrik);
        },
        VPERMILPDZrik => {
            return ProcessVPERMILPDri.call(VSHUFPDZrrik);
        },
        VPERMILPSri => {
            return ProcessVPERMILPSri.call(VSHUFPSrri);
        },
        VPERMILPSYri => {
            return ProcessVPERMILPSri.call(VSHUFPSYrri);
        },
        VPERMILPSZ128ri => {
            return ProcessVPERMILPSri.call(VSHUFPSZ128rri);
        },
        VPERMILPSZ256ri => {
            return ProcessVPERMILPSri.call(VSHUFPSZ256rri);
        },
        VPERMILPSZri => {
            return ProcessVPERMILPSri.call(VSHUFPSZrri);
        },
        VPERMILPSZ128rikz => {
            return ProcessVPERMILPSri.call(VSHUFPSZ128rrikz);
        },
        VPERMILPSZ256rikz => {
            return ProcessVPERMILPSri.call(VSHUFPSZ256rrikz);
        },
        VPERMILPSZrikz => {
            return ProcessVPERMILPSri.call(VSHUFPSZrrikz);
        },
        VPERMILPSZ128rik => {
            return ProcessVPERMILPSri.call(VSHUFPSZ128rrik);
        },
        VPERMILPSZ256rik => {
            return ProcessVPERMILPSri.call(VSHUFPSZ256rrik);
        },
        VPERMILPSZrik => {
            return ProcessVPERMILPSri.call(VSHUFPSZrrik);
        },
        VPERMILPSmi => {
            return ProcessVPERMILPSmi.call(VPSHUFDmi);
        },
        VPERMILPSYmi => {
            return if self.ST.hasAVX2() { ProcessVPERMILPSmi.call(VPSHUFDYmi) } else { false };
        },
        VPERMILPSZ128mi => {
            return ProcessVPERMILPSmi.call(VPSHUFDZ128mi);
        },
        VPERMILPSZ256mi => {
            return ProcessVPERMILPSmi.call(VPSHUFDZ256mi);
        },
        VPERMILPSZmi => {
            return ProcessVPERMILPSmi.call(VPSHUFDZmi);
        },
        VPERMILPSZ128mikz => {
            return ProcessVPERMILPSmi.call(VPSHUFDZ128mikz);
        },
        VPERMILPSZ256mikz => {
            return ProcessVPERMILPSmi.call(VPSHUFDZ256mikz);
        },
        VPERMILPSZmikz => {
            return ProcessVPERMILPSmi.call(VPSHUFDZmikz);
        },
        VPERMILPSZ128mik => {
            return ProcessVPERMILPSmi.call(VPSHUFDZ128mik);
        },
        VPERMILPSZ256mik => {
            return ProcessVPERMILPSmi.call(VPSHUFDZ256mik);
        },
        VPERMILPSZmik => {
            return ProcessVPERMILPSmi.call(VPSHUFDZmik);
        },
        VPERMQYri => {
            return ProcessVPERMQToVINSERT128.call(VINSERTI128rri);
        },
        VPERMPDYri => {
            return ProcessVPERMQToVINSERT128.call(VINSERTF128rri);
        },
        MOVLHPSrr => {
            UNPCKLPDrr;
        },
        VMOVLHPSrr => {
            VUNPCKLPDrr;
        },
        VUNPCKLPDYrr => {
            return ProcessUNPCKLPDrr.call(VPUNPCKLQDQYrr, VSHUFPDYrri);
        },
        VMOVLHPSZrr => {
            VUNPCKLPDZ128rr;
        },
        VUNPCKLPDZ256rr => {
            return ProcessUNPCKLPDrr.call(VPUNPCKLQDQZ256rr, VSHUFPDZ256rri);
        },
        VUNPCKLPDZrr => {
            return ProcessUNPCKLPDrr.call(VPUNPCKLQDQZrr, VSHUFPDZrri);
        },
        VUNPCKLPDZ128rrk => {
            return ProcessUNPCKLPDrr.call(VPUNPCKLQDQZ128rrk, VSHUFPDZ128rrik);
        },
        VUNPCKLPDZ256rrk => {
            return ProcessUNPCKLPDrr.call(VPUNPCKLQDQZ256rrk, VSHUFPDZ256rrik);
        },
        VUNPCKLPDZrrk => {
            return ProcessUNPCKLPDrr.call(VPUNPCKLQDQZrrk, VSHUFPDZrrik);
        },
        VUNPCKLPDZ128rrkz => {
            return ProcessUNPCKLPDrr.call(VPUNPCKLQDQZ128rrkz, VSHUFPDZ128rrikz);
        },
        VUNPCKLPDZ256rrkz => {
            return ProcessUNPCKLPDrr.call(VPUNPCKLQDQZ256rrkz, VSHUFPDZ256rrikz);
        },
        VUNPCKLPDZrrkz => {
            return ProcessUNPCKLPDrr.call(VPUNPCKLQDQZrrkz, VSHUFPDZrrikz);
        },
        UNPCKHPDrr => {
            return ProcessUNPCKHPDrr.call(PUNPCKHQDQrr, SHUFPDrri);
        },
        VUNPCKHPDrr => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQrr, VSHUFPDrri);
        },
        VUNPCKHPDYrr => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQYrr, VSHUFPDYrri);
        },
        VUNPCKHPDZ128rr => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQZ128rr, VSHUFPDZ128rri);
        },
        VUNPCKHPDZ256rr => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQZ256rr, VSHUFPDZ256rri);
        },
        VUNPCKHPDZrr => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQZrr, VSHUFPDZrri);
        },
        VUNPCKHPDZ128rrk => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQZ128rrk, VSHUFPDZ128rrik);
        },
        VUNPCKHPDZ256rrk => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQZ256rrk, VSHUFPDZ256rrik);
        },
        VUNPCKHPDZrrk => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQZrrk, VSHUFPDZrrik);
        },
        VUNPCKHPDZ128rrkz => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQZ128rrkz, VSHUFPDZ128rrikz);
        },
        VUNPCKHPDZ256rrkz => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQZ256rrkz, VSHUFPDZ256rrikz);
        },
        VUNPCKHPDZrrkz => {
            return ProcessUNPCKHPDrr.call(VPUNPCKHQDQZrrkz, VSHUFPDZrrikz);
        },
        UNPCKLPDrm => {
            return ProcessUNPCKPDrm.call(PUNPCKLQDQrm);
        },
