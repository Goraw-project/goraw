struct Closure_4 {
    cap_0: *mut X86FixupInstTuningImpl,
    GetInstTput: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86FixupInstTuning.cpp:97:22),
    Opc: *mut u32,
    GetInstLat: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86FixupInstTuning.cpp:103:21),
    GetInstSize: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86FixupInstTuning.cpp:109:22),
}

unsafe fn Closure_4::call(self: *mut Closure_4, NewOpc: u32, ReplaceInTie: bool) -> auto {
        let mut Res: optional<bool> = optional<bool> {};
        if self.SM.hasInstrSchedModel() {
            Res = CmpOptionals((*self.GetInstTput)(NewOpc), (*self.GetInstTput)((*self.Opc)));
            if Res.has_value() {
                return operator(Res);
            }
            Res = CmpOptionals((*self.GetInstLat)(NewOpc), (*self.GetInstLat)((*self.Opc)));
            if Res.has_value() {
                return operator(Res);
            }
        }
        Res = CmpOptionals((*self.GetInstSize).call((*self.Opc)), (*self.GetInstSize).call(NewOpc));
        if Res.has_value() {
            return operator(Res);
        }
        return ReplaceInTie;
    }

struct Closure_5 {
    NewOpcPreferable: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86FixupInstTuning.cpp:116:27),
