        },
        MOVUPDrr => {
            return ProcessMOVPDToMOVPS.call(MOVUPSrr);
        },
        MOVUPDrm => {
            return ProcessMOVPDToMOVPS.call(MOVUPSrm);
        },
        MOVUPDmr => {
            return ProcessMOVPDToMOVPS.call(MOVUPSmr);
        },
        MOVAPDrr => {
            return ProcessMOVPDToMOVPS.call(MOVAPSrr);
        },
        MOVAPDrm => {
            return ProcessMOVPDToMOVPS.call(MOVAPSrm);
        },
        MOVAPDmr => {
            return ProcessMOVPDToMOVPS.call(MOVAPSmr);
        },
        _ => {
            return false;
        },
    }
}

fn X86FixupInstTuningImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-inst-tuning", 1) {
            dbgs() << "Start X86FixupInstTuning\n";
        }
    }
        if !(false) { break; }
    }
    let mut Changed: bool = false;
    self.ST = &mut MF.getSubtarget();
    self.TII = self.ST.getInstrInfo();
    self.TRI = self.ST.getRegisterInfo();
    self.SM = &mut self.ST.getSchedModel();
    for MBB in MF {
        for let mut I: iterator = MBB.begin(); I != MBB.end(); operator(I) {
            if self.processInstruction(MF, MBB, I) {
                operator(NumInstChanges);
                Changed = true;
            }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-inst-tuning", 1) {
            dbgs() << "End X86FixupInstTuning\n";
        }
    }
        if !(false) { break; }
    }
    return Changed;
}

fn X86FixupInstTuningLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut Impl: X86FixupInstTuningImpl = X86FixupInstTuningImpl {};
    return Impl.runOnMachineFunction(MF);
}

fn X86FixupInstTuningPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86FixupInstTuningImpl = X86FixupInstTuningImpl {};
    return if Impl.runOnMachineFunction(MF) { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}

