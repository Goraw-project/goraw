unsafe fn Closure_4::call(self: *mut Closure_4, NewOpc: u32, ReplaceInTie: bool) -> auto {
        let mut Res: optional<bool> = optional<bool> {};
        if self.SM.hasInstrSchedModel() {
            Res = CmpOptionals((*self.GetInstTput).call(NewOpc), (*self.GetInstTput).call((*self.Opc)));
            if Res.has_value() {
                return operator(Res);
            }
            Res = CmpOptionals((*self.GetInstLat).call(NewOpc), (*self.GetInstLat).call((*self.Opc)));
            if Res.has_value() {
                return operator(Res);
            }
        }
        Res = CmpOptionals((*self.GetInstSize).call((*self.Opc)), (*self.GetInstSize).call(NewOpc));
        if Res.has_value() {
            return operator(Res);
        }
        return ReplaceInTie;
    }

