        },
        VUNPCKLPDZ256rm => {
            return ProcessUNPCKPDrm.call(VPUNPCKLQDQZ256rm);
        },
        VUNPCKLPDZrm => {
            return ProcessUNPCKPDrm.call(VPUNPCKLQDQZrm);
        },
        VUNPCKLPDZ128rmk => {
            return ProcessUNPCKPDrm.call(VPUNPCKLQDQZ128rmk);
        },
        VUNPCKLPDZ256rmk => {
            return ProcessUNPCKPDrm.call(VPUNPCKLQDQZ256rmk);
        },
        VUNPCKLPDZrmk => {
            return ProcessUNPCKPDrm.call(VPUNPCKLQDQZrmk);
        },
        VUNPCKLPDZ128rmkz => {
            return ProcessUNPCKPDrm.call(VPUNPCKLQDQZ128rmkz);
        },
        VUNPCKLPDZ256rmkz => {
            return ProcessUNPCKPDrm.call(VPUNPCKLQDQZ256rmkz);
