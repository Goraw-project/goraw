        {
            (*self.MI).setDesc(self.TII(InsertOpc));
            (*self.MI).removeOperand((*self.NumOperands) - 1);
            (*self.MI).removeOperand((*self.NumOperands) - 2);
            (*self.MI).addOperand(CreateReg(RHSRegXMM, false, false, false, false, false, false, 0, false, false, false));
            (*self.MI).addOperand(CreateImm(1));
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-inst-tuning", 1) {
                dbgs() << "     With: " << (*self.MI);
            }
        }
            if !(false) { break; }
        }
        return true;
    }

