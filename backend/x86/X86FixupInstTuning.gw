static mut NumInstChanges: Statistic = Statistic { "x86-fixup-inst-tuning", "NumInstChanges", "Number of instructions changes" };

struct X86FixupInstTuningImpl {
    TII: *X86InstrInfo,
    ST: *X86Subtarget,
    SM: *MCSchedModel,
    TRI: *X86RegisterInfo,
}

struct X86FixupInstTuningLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86FixupInstTuningLegacy::getPassName(self: *X86FixupInstTuningLegacy) -> str {
    return "X86 Fixup Inst Tuning";
}

fn X86FixupInstTuningLegacy::getRequiredProperties(self: *X86FixupInstTuningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn X86FixupInstTuningLegacy::getPassKind(self: *X86FixupInstTuningLegacy) -> PassKind {
    return self.Kind;
}

fn X86FixupInstTuningLegacy::getPassID(self: *X86FixupInstTuningLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86FixupInstTuningLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FixupInstTuningLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FixupInstTuningLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86FixupInstTuningLegacy::getResolver(self: *X86FixupInstTuningLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86FixupInstTuningLegacy::getSetProperties(self: *X86FixupInstTuningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86FixupInstTuningLegacy::getClearedProperties(self: *X86FixupInstTuningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86FixupInstTuningLegacyPass() -> *mut FunctionPass {
    return X86FixupInstTuningLegacy {};
}

