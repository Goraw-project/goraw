    NumOperands: *mut u32,
    NewOpcPreferable: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86FixupInstTuning.cpp:116:27),
    cap_3: *mut X86FixupInstTuningImpl,
}

unsafe fn Closure_19::call(self: *mut Closure_19, NewOpc: u32) -> auto {
        if (*self.MI).getOperand((*self.NumOperands) - 1).getImm() != 68 {
            return false;
        }
        if !(*self.NewOpcPreferable).call(NewOpc, false) {
            return false;
        }
        let mut SrcReg: Register = (*self.MI).getOperand(1).getReg();
        let mut XmmReg: Register = self.TRI;
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-inst-tuning", 1) {
                dbgs() << "Replacing: " << (*self.MI);
            }
        }
            if !(false) { break; }
        }
        {
            (*self.MI).setDesc(self.TII(NewOpc));
            (*self.MI).removeOperand((*self.NumOperands) - 1);
            (*self.MI).addOperand(CreateReg(XmmReg, false, false, false, false, false, false, 0, false, false, false));
            (*self.MI).addOperand(CreateImm(1));
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-inst-tuning", 1) {
                dbgs() << "     With: " << (*self.MI);
            }
        }
            if !(false) { break; }
        }
        return true;
    }
