fn X86OptimizeLEAsImpl::calcInstrDist(self, First: *MachineInstr, Last: *MachineInstr) -> i32 {
    assert!(Last.getParent() == First.getParent(), "Instructions are in different basic blocks");
    assert!(self.InstrPos.contains(&mut First) && self.InstrPos.contains(&mut Last), "Instructions' positions are undefined");
    return self.InstrPos[&mut Last] - self.InstrPos[&mut First];
}

fn X86OptimizeLEAsImpl::chooseBestLEA(self, List: *SmallVectorImpl<MachineInstr *>, MI: *MachineInstr, BestLEA: *mut *mut MachineInstr, AddrDispShift: *mut i64, Dist: *mut i32) -> bool {
    let mut Desc: *MCInstrDesc = MI.getDesc();
    let mut MemOpNo: i32 = getMemoryOperandIdx(Desc);
    assert!(MemOpNo >= 0, "Expected a memory operand");
    BestLEA = null;
    for DefMI in List {
        let mut AddrDispShiftTemp: i64 = self.getAddrDispShift(MI, MemOpNo, *DefMI, 1);
        if !isInt(AddrDispShiftTemp) {
            continue;
        }
        if self.TII.getRegClass(Desc, MemOpNo + AddrBaseReg) != self.MRI.getRegClass(DefMI.getOperand(0).getReg()) {
            continue;
        }
        let mut DistTemp: i32 = self.calcInstrDist(*DefMI, MI);
        assert!(DistTemp != 0, "The distance between two different instructions cannot be zero");
        if DistTemp > 0 || BestLEA == null {
            if BestLEA != null && !isInt(AddrDispShiftTemp) && isInt(AddrDispShift) {
                continue;
            }
            BestLEA = DefMI;
            AddrDispShift = AddrDispShiftTemp;
            Dist = DistTemp;
        }
        if DistTemp < 0 {
            break;
        }
    }
    return BestLEA != null;
}

fn X86OptimizeLEAsImpl::getAddrDispShift(self: *X86OptimizeLEAsImpl, MI1: *MachineInstr, N1: u32, MI2: *MachineInstr, N2: u32) -> i64 {
    let mut Op1: *MachineOperand = MI1.getOperand(N1 + AddrDisp);
    let mut Op2: *MachineOperand = MI2.getOperand(N2 + AddrDisp);
    assert!(isSimilarDispOp(Op1, Op2), "Address displacement operands are not compatible");
    if Op1.isJTI() {
        return 0;
    }
    return if Op1.isImm() { Op1.getImm() - Op2.getImm() } else { Op1.getOffset() - Op2.getOffset() };
}

fn X86OptimizeLEAsImpl::isReplaceable(self: *X86OptimizeLEAsImpl, First: *MachineInstr, Last: *MachineInstr, AddrDispShift: *mut i64) -> bool {
    assert!(isLEA(First) && isLEA(Last), "The function works only with LEA instructions");
    if self.MRI.getRegClass(First.getOperand(0).getReg()) != self.MRI.getRegClass(Last.getOperand(0).getReg()) {
        return false;
    }
    AddrDispShift = self.getAddrDispShift(Last, 1, First, 1);
    for MO in self.MRI.use_nodbg_operands(Last.getOperand(0).getReg()) {
        let mut MI: *mut MachineInstr = *MO.getParent();
        let mut MemOpNo: i32 = getMemoryOperandIdx(MI.getDesc());
        if MemOpNo < 0 {
            return false;
        }
        if !isIdenticalOp(MI.getOperand(MemOpNo + AddrBaseReg), MO) {
            return false;
        }
        for let mut i: u32 = 0; i < MI.getNumOperands(); i += 1 {
            if i != (MemOpNo + AddrBaseReg) as u32 && isIdenticalOp(MI.getOperand(i), MO) {
                return false;
            }
        }
        if MI.getOperand(MemOpNo + AddrDisp).isImm() && !isInt(MI.getOperand(MemOpNo + AddrDisp).getImm() + AddrDispShift) {
            return false;
        }
    }
    return true;
}

fn X86OptimizeLEAsImpl::findLEAs(self, MBB: *MachineBasicBlock, LEAs: *mut MemOpMap) {
    let mut Pos: u32 = 0;
    for MI in MBB {
        self.InstrPos[&mut MI] = Pos += 2;
        if isLEA(MI) {
            LEAs[getMemOpKey(MI, 1)].push(&mut MI);
        }
    }
}

fn X86OptimizeLEAsImpl::removeRedundantAddrCalc(self, LEAs: *mut MemOpMap) -> bool {
    let mut Changed: bool = false;
    assert!(!LEAs.is_empty();
    let mut MBB: *mut MachineBasicBlock = (*operator(LEAs.begin()).second.begin()).getParent();
    for MI in make_early_inc_range(*MBB) {
        if !MI.mayLoadOrStore(AnyInBundle) {
            continue;
        }
        let mut MemOpNo: i32 = getMemoryOperandIdx(MI.getDesc());
        if MemOpNo < 0 {
            continue;
        }
        let mut Insns: iterator = LEAs.find(getMemOpKey(MI, MemOpNo));
        if Insns == LEAs.end() {
            continue;
        }
        let mut DefMI: *mut MachineInstr = null;
        let mut AddrDispShift: i64 = 0;
        let mut Dist: i32 = 0;
        if !self.chooseBestLEA(operator(Insns).second, MI, DefMI, AddrDispShift, Dist) {
            continue;
        }
        if Dist < 0 {
            DefMI.removeFromParent();
            MBB.insert(&mut MI, DefMI);
            self.InstrPos[DefMI] = self.InstrPos[&mut MI] - 1;
            assert!(((self.InstrPos[DefMI] == 1 && DefMI == MBB.begin()) || self.InstrPos[DefMI] > self.InstrPos[&mut operator(prev(DefMI, 1))]), "Instruction positioning is broken");
        }
        self.MRI.clearKillFlags(DefMI.getOperand(0).getReg());
        operator(NumSubstLEAs);
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-optimize-leas", 1) {
                dbgs() << "OptimizeLEAs: Candidate to replace: ";
                MI.dump();
            }
        }
            if !(false) { break; }
        }
        MI.getOperand(MemOpNo + AddrBaseReg).ChangeToRegister(DefMI.getOperand(0).getReg(), false, false, false, false, false, false);
        MI.getOperand(MemOpNo + AddrScaleAmt).ChangeToImmediate(1, 0);
        MI.getOperand(MemOpNo + AddrIndexReg).ChangeToRegister(NoRegister, false, false, false, false, false, false);
        MI.getOperand(MemOpNo + AddrDisp).ChangeToImmediate(AddrDispShift, 0);
        MI.getOperand(MemOpNo + AddrSegmentReg).ChangeToRegister(NoRegister, false, false, false, false, false, false);
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-optimize-leas", 1) {
                dbgs() << "OptimizeLEAs: Replaced by: ";
                MI.dump();
            }
        }
            if !(false) { break; }
        }
        Changed = true;
    }
    return Changed;
}

fn X86OptimizeLEAsImpl::replaceDebugValue(self, MI: *mut MachineInstr, OldReg: Register, NewReg: Register, AddrDispShift: i64) -> *mut MachineInstr {
    let mut Expr: *DIExpression = MI.getDebugExpression();
    if AddrDispShift != 0 {
        if MI.isNonListDebugValue() {
            Expr = prepend(Expr, StackValue, AddrDispShift);
        } else {
            let mut Ops: SmallVector<uint64_t, 3> = SmallVector<uint64_t, 3> {};
            appendOffset(Ops, AddrDispShift);
            for Op in MI.getDebugOperandsForReg(OldReg) {
                let mut OpIdx: u32 = MI.getDebugOperandIndex(&mut Op);
                Expr = appendOpsToArg(Expr, Ops, OpIdx, false);
            }
        }
    }
    let mut MBB: *mut MachineBasicBlock = MI.getParent();
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut IsIndirect: bool = MI.isIndirectDebugValue();
    let mut Var: *MDNode = MI.getDebugVariable();
    let mut Opcode: u32 = if MI.isNonListDebugValue() { DBG_VALUE } else { DBG_VALUE_LIST };
    if IsIndirect {
        assert!(MI.getDebugOffset().getImm() == 0, "DBG_VALUE with nonzero offset");
    }
    let mut NewOps: SmallVector<MachineOperand, 4> = SmallVector<MachineOperand, 4> {};
    let mut replaceOldReg: Closure_1 = Closure_1 { cap_0: OldReg, cap_1: NewReg };
    for Op in MI.debug_operands() {
        NewOps.push(replaceOldReg.call(Op));
    }
    return BuildMI(*MBB, MBB.erase(&mut MI), DL, self.TII.get(Opcode), IsIndirect, NewOps, Var, Expr).operator llvm::MachineInstr *();
}

fn X86OptimizeLEAsImpl::removeRedundantLEAs(self, LEAs: *mut MemOpMap) -> bool {
    let mut Changed: bool = false;
    for E in LEAs {
        let mut List: *mut MachineInstr *, 16> = E.second;
        let mut I1: iterator = List.begin();
        while I1 != List.end() {
            let mut First: *mut MachineInstr = **I1;
            let mut I2: *mut *mut MachineInstr = next(I1, 1);
            while I2 != List.end() {
                let mut Last: *mut MachineInstr = **I2;
                let mut AddrDispShift: i64 = 0;
                assert!(self.calcInstrDist(First, Last) > 0, "LEAs must be in occurrence order in the list");
                if !self.isReplaceable(First, Last, AddrDispShift) {
                    I2 += 1;
                    continue;
                }
                let mut FirstVReg: Register = First.getOperand(0).getReg();
                let mut LastVReg: Register = Last.getOperand(0).getReg();
                while !self.MRI.use_empty(LastVReg) {
                    let mut MO: *mut MachineOperand = operator(self.MRI.use_begin(LastVReg));
                    let mut MI: *mut MachineInstr = *MO.getParent();
                    if MI.isDebugValue() {
                        self.replaceDebugValue(MI, LastVReg, FirstVReg, AddrDispShift);
                        continue;
                    }
                    let mut MemOpNo: i32 = getMemoryOperandIdx(MI.getDesc());
                    assert!(MemOpNo >= 0, "Expected a memory operand");
                    MO.setReg(FirstVReg);
                    let mut Op: *mut MachineOperand = MI.getOperand(MemOpNo + AddrDisp);
                    if Op.isImm() {
                        Op.setImm(Op.getImm() + AddrDispShift);
                    } else if !Op.isJTI() {
                        Op.setOffset(Op.getOffset() + AddrDispShift);
                    }
                }
                self.MRI.clearKillFlags(FirstVReg);
                operator(NumRedundantLEAs);
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-optimize-leas", 1) {
                        dbgs() << "OptimizeLEAs: Remove redundant LEA: ";
                        Last.dump();
                    }
                }
                    if !(false) { break; }
                }
                assert!(self.MRI.use_empty(LastVReg), "The LEA's def register must have no uses");
                Last.eraseFromParent();
                I2 = List.erase(I2);
                Changed = true;
            }
            I1 += 1;
        }
    }
    return Changed;
}

fn X86OptimizeLEAsImpl::runOnMachineFunction(self, MF: *mut MachineFunction, PSI: *mut ProfileSummaryInfo, MBFI: *mut MachineBlockFrequencyInfo) -> bool {
    let mut Changed: bool = false;
    if DisableX86LEAOpt {
        return false;
    }
    self.MRI = &mut MF.getRegInfo();
    self.TII = MF.getSubtarget().getInstrInfo();
    self.TRI = MF.getSubtarget().getRegisterInfo();
    for MBB in MF {
        let mut LEAs: MemOpMap = MemOpMap {};
        self.InstrPos.clear();
        self.findLEAs(MBB, LEAs);
        if LEAs.is_empty() {
            continue;
        }
        Changed |= self.removeRedundantLEAs(LEAs);
        if shouldOptimizeForSize(&mut MBB, PSI, MBFI, Other) {
            Changed |= self.removeRedundantAddrCalc(LEAs);
        }
    }
    return Changed;
}

fn X86OptimizeLEAsLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut PSI: *mut ProfileSummaryInfo = &mut self.getAnalysis().getPSI();
    let mut MBFI: *mut MachineBlockFrequencyInfo = if (PSI && PSI.hasProfileSummary()) { &mut self.getAnalysis().getBFI() } else { null };
    let mut PassImpl: X86OptimizeLEAsImpl = X86OptimizeLEAsImpl {};
    return PassImpl.runOnMachineFunction(MF, PSI, MBFI);
}

fn X86OptimizeLEAsPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut PSI: *mut ProfileSummaryInfo = MFAM.getResult(MF).getCachedResult(*MF.getFunction().getParent());
    let mut MBFI: *mut MachineBlockFrequencyInfo = if (PSI && PSI.hasProfileSummary()) { &mut MFAM.getResult(MF) } else { null };
    let mut PassImpl: X86OptimizeLEAsImpl = X86OptimizeLEAsImpl {};
    let mut Changed: bool = PassImpl.runOnMachineFunction(MF, PSI, MBFI);
    if !Changed {
        return all();
    }
    return getMachineFunctionPassPreservedAnalyses().preserveSet();
}

struct Closure_1 {
    cap_0: Register,
    cap_1: Register,
}

fn Closure_1::call(self: *Closure_1, Op: *MachineOperand) -> MachineOperand {
        if Op.isReg() && Op.getReg() == OldReg {
            return CreateReg(NewReg, false, false, false, false, false, false, false, false, false, true);
        }
        return Op;
    }
