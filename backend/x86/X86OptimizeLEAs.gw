static mut DisableX86LEAOpt: opt<bool> = opt<bool> { "disable-x86-lea-opt", Hidden, "X86: Disable LEA optimizations.", init(false) };

static mut NumSubstLEAs: Statistic = Statistic { "x86-optimize-leas", "NumSubstLEAs", "Number of LEA instruction substitutions" };

static mut NumRedundantLEAs: Statistic = Statistic { "x86-optimize-leas", "NumRedundantLEAs", "Number of redundant LEA instructions removed" };

struct MemOpKey {
    Operands: [4]*mut MachineOperand,
    Disp: *MachineOperand,
}

fn MemOpKey::MemOpKey(self, Base: *MachineOperand, Scale: *MachineOperand, Index: *MachineOperand, Segment: *MachineOperand, Disp: *MachineOperand) {
    self.Operands[0] = Base;
    self.Operands[1] = Scale;
    self.Operands[2] = Index;
    self.Operands[3] = Segment;
}

fn MemOpKey::operator==(self: *MemOpKey, Other: *MemOpKey) -> bool {
    for let mut i: i32 = 0; i < 4; i += 1 {
        if !isIdenticalOp(*self.Operands[i], *Other.Operands[i]) {
            return false;
        }
    }
    return isSimilarDispOp(*self.Disp, *Other.Disp);
}

fn getMemOpKey(MI: *MachineInstr, N: u32) -> MemOpKey {
    assert!((isLEA(MI) || MI.mayLoadOrStore(AnyInBundle)), "The instruction must be a LEA, a load or a store");
    return MemOpKey { &mut MI.getOperand(N + AddrBaseReg), &mut MI.getOperand(N + AddrScaleAmt), &mut MI.getOperand(N + AddrIndexReg), &mut MI.getOperand(N + AddrSegmentReg), &mut MI.getOperand(N + AddrDisp) };
}

fn isIdenticalOp(MO1: *MachineOperand, MO2: *MachineOperand) -> bool {
    return MO1.isIdenticalTo(MO2) && (!MO1.isReg() || !MO1.getReg().isPhysical());
}

fn isValidDispOp(MO: *MachineOperand) -> bool {
    return MO.isImm() || MO.isCPI() || MO.isJTI() || MO.isSymbol() || MO.isGlobal() || MO.isBlockAddress() || MO.isMCSymbol() || MO.isMBB();
}

fn isSimilarDispOp(MO1: *MachineOperand, MO2: *MachineOperand) -> bool {
    assert!(isValidDispOp(MO1) && isValidDispOp(MO2), "Address displacement operand is not valid");
    return (MO1.isImm() && MO2.isImm()) || (MO1.isCPI() && MO2.isCPI() && MO1.getIndex() == MO2.getIndex()) || (MO1.isJTI() && MO2.isJTI() && MO1.getIndex() == MO2.getIndex()) || (MO1.isSymbol() && MO2.isSymbol() && MO1.getSymbolName() == MO2.getSymbolName()) || (MO1.isGlobal() && MO2.isGlobal() && MO1.getGlobal() == MO2.getGlobal()) || (MO1.isBlockAddress() && MO2.isBlockAddress() && MO1.getBlockAddress() == MO2.getBlockAddress()) || (MO1.isMCSymbol() && MO2.isMCSymbol() && MO1.getMCSymbol() == MO2.getMCSymbol()) || (MO1.isMBB() && MO2.isMBB() && MO1.getMBB() == MO2.getMBB());
}

fn isLEA(MI: *MachineInstr) -> bool {
    let mut Opcode: u32 = MI.getOpcode();
    return Opcode == LEA16r || Opcode == LEA32r || Opcode == LEA64r || Opcode == LEA64_32r;
}

struct X86OptimizeLEAsImpl {
    InstrPos: DenseMap<const MachineInstr *, unsigned int>,
    MRI: *mut MachineRegisterInfo,
    TII: *X86InstrInfo,
    TRI: *X86RegisterInfo,
}

