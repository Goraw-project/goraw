const RetpolineNamePrefix: [18]i8 = "__llvm_retpoline_";

const R11RetpolineName: [21]i8 = "__llvm_retpoline_r11";

const EAXRetpolineName: [21]i8 = "__llvm_retpoline_eax";

const ECXRetpolineName: [21]i8 = "__llvm_retpoline_ecx";

const EDXRetpolineName: [21]i8 = "__llvm_retpoline_edx";

const EDIRetpolineName: [21]i8 = "__llvm_retpoline_edi";

const LVIThunkNamePrefix: [18]i8 = "__llvm_lvi_thunk_";

const R11LVIThunkName: [21]i8 = "__llvm_lvi_thunk_r11";

struct RetpolineThunkInserter {
}

fn RetpolineThunkInserter::getThunkPrefix(self) -> *u8 {
    return RetpolineNamePrefix;
}

fn RetpolineThunkInserter::mayUseThunk(self, MF: *MachineFunction) -> bool {
    let mut STI: *auto = MF;
    return (STI()() || ()) && operator!();
}

struct LVIThunkInserter {
}

fn LVIThunkInserter::getThunkPrefix(self) -> *u8 {
    return LVIThunkNamePrefix;
}

fn LVIThunkInserter::mayUseThunk(self, MF: *MachineFunction) -> bool {
    return MF();
}

fn LVIThunkInserter::insertThunks(self, MMI: *mut MachineModuleInfo, MF: *mut MachineFunction, ExistingThunks: bool) -> bool {
    if ExistingThunks {
        return false;
    }
    createThunkFunction(MMI, R11LVIThunkName);
    return true;
}

fn LVIThunkInserter::populateThunk(self, MF: *mut MachineFunction) {
    assert!(MF.len == 1);
    let mut Entry: *mut MachineBasicBlock = &mut MF.front();
    Entry.clear();
    let mut TII: *TargetInstrInfo = MF();
    BuildMI(&mut MF.front(), DebugLoc { Loc: null }, TII.get);
    BuildMI(&mut MF.front(), DebugLoc { Loc: null }, TII.get);
    MF.front();
}

struct X86IndirectThunks {
}

fn X86IndirectThunks::getPassName(self: *X86IndirectThunks) -> str {
    return "X86 Indirect Thunks";
}

fn RetpolineThunkInserter::insertThunks(self, MMI: *mut MachineModuleInfo, MF: *mut MachineFunction, ExistingThunks: bool) -> bool {
    if ExistingThunks {
        return false;
    }
    if MMI.getTarget().getTargetTriple().isX86_64() {
        createThunkFunction(MMI, R11RetpolineName);
    } else {
        
    }
    return true;
}

fn RetpolineThunkInserter::populateThunk(self, MF: *mut MachineFunction) {
    let mut Is64Bit: bool = MF.getTarget().getTargetTriple().isX86_64();
    let mut ThunkReg: Register = Register { Reg: 0 };
    if Is64Bit {
        assert!(MF.getName() == "__llvm_retpoline_r11", "Should only have an r11 thunk on 64-bit targets");
    } else {
        if MF.getName() == EAXRetpolineName {
            
        } else if MF.getName() == ECXRetpolineName {
            
        } else if MF.getName() == EDXRetpolineName {
            
        } else if MF.getName() == EDIRetpolineName {
            
        } else {
            llvm_unreachable_internal("Invalid thunk name on x86-32!", "llvm\\lib\\Target\\X86\\X86IndirectThunks.cpp", 182);
        }
    }
    let mut TII: *TargetInstrInfo = MF();
    assert!(MF.len == 1);
    let mut Entry: *mut MachineBasicBlock = &mut MF.front();
    Entry.clear();
    let mut CaptureSpec: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(Entry.getBasicBlock(), optional<UniqueBBID> { nullopt });
    let mut CallTarget: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(Entry.getBasicBlock(), optional<UniqueBBID> { nullopt });
    let mut TargetSym: *mut MCSymbol = MF.getContext().createTempSymbol();
    MF.push(CaptureSpec);
    MF.push(CallTarget);
    let mut CallOpc: u32 = 0;
    let mut RetOpc: u32 = 0;
    Entry.addLiveIn(ThunkReg.operator MCRegister(), getAll());
    BuildMI(Entry, DebugLoc { Loc: null }, TII.get)(TargetSym);
    Entry.addSuccessor(CaptureSpec, getUnknown());
    BuildMI(CaptureSpec, DebugLoc { Loc: null }, TII.get);
    BuildMI(CaptureSpec, DebugLoc { Loc: null }, TII.get);
    BuildMI(CaptureSpec, DebugLoc { Loc: null }, TII.get)(CaptureSpec);
    CaptureSpec.setMachineBlockAddressTaken();
    CaptureSpec.addSuccessor(CaptureSpec, getUnknown());
    CallTarget.addLiveIn(ThunkReg.operator MCRegister(), getAll());
    CallTarget.setMachineBlockAddressTaken();
    CallTarget.setAlignment(Align { ShiftValue: 16 });
    let mut MovOpc: u32 = 0;
    let mut SPReg: Register = zeroed();
    addRegOffset(BuildMI(CallTarget, DebugLoc { Loc: null }, TII.get), SPReg, false, 0)(ThunkReg);
    CallTarget.back().setPreInstrSymbol(MF, TargetSym);
    BuildMI(CallTarget, DebugLoc { Loc: null }, TII.get);
}

fn createX86IndirectThunksPass() -> *mut FunctionPass {
    return X86IndirectThunks {};
}

static mut ID: i8 = 0;
