fn X86TTIImpl::getIntImmCost(self: *X86TTIImpl, Val: i64) -> InstructionCost {
    if Val == 0 {
        return InstructionCost { TCC_Free };
    }
    if isInt(Val) {
        return InstructionCost { TCC_Basic };
    }
    return InstructionCost { 2 * TCC_Basic };
}

fn X86TTIImpl::getIntImmCost(self: *X86TTIImpl, Imm: *APInt, Ty: *mut Type, CostKind: TargetCostKind) -> InstructionCost {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 {
        return InstructionCost { ~0 };
    }
    if BitSize > 128 {
        return InstructionCost { TCC_Free };
    }
    if Imm == 0 {
        return InstructionCost { TCC_Free };
    }
    let mut ImmVal: APInt = Imm;
    if BitSize % 64 != 0 {
        ImmVal = Imm.sext(alignTo(BitSize, 64));
    }
    let mut Cost: InstructionCost = InstructionCost { 0 };
    for let mut ShiftVal: u32 = 0; ShiftVal < BitSize; ShiftVal += 64 {
        let mut Tmp: APInt = ImmVal.ashr(ShiftVal).sextOrTrunc(64);
        let mut Val: i64 = Tmp.getSExtValue();
        operator(Cost, self.getIntImmCost(Val));
    }
    return max(1, Cost);
}

fn X86TTIImpl::getIntImmCostInst(self: *X86TTIImpl, Opcode: u32, Idx: u32, Imm: *APInt, Ty: *mut Type, CostKind: TargetCostKind, Inst: *mut Instruction) -> InstructionCost {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    let mut ImmBitWidth: u32 = Imm.getBitWidth();
    if BitSize == 0 {
        return InstructionCost { TCC_Free };
    }
    let mut ImmIdx: u32 = ~0;
    match Opcode {
        _ => {
            return InstructionCost { TCC_Free };
        },
        GetElementPtr => {
            if Idx == 0 {
                return InstructionCost { 2 * TCC_Basic };
            }
        },
        Store => {
            ImmIdx = 0;
        },
        ICmp => {
            if Idx == 1 && ImmBitWidth == 64 {
                let mut ImmVal: u64 = Imm.getZExtValue();
                if ImmVal == 4294967296 || ImmVal == 4294967295 {
                    return InstructionCost { TCC_Free };
                }
                if  {
                    if Cmp()() {
                        let mut Known: KnownBits = computeKnownBits((0));
                        if Known.countMinTrailingZeros() >= 32 {
                            return InstructionCost { TCC_Free };
                        }
                    }
                }
            }
        },
        And => {
            if Idx == 1 && ImmBitWidth == 64 && Imm.isIntN(32) {
                return InstructionCost { TCC_Free };
            }
        },
        Add => {
            Sub;
        },
        UDiv => {
            SDiv;
        },
        Mul => {
            Or;
        },
        Shl => {
            LShr;
        },
        Trunc => {
            ZExt;
        },
    }
    if Idx == ImmIdx {
        let mut NumConstants: u64 = divideCeil(BitSize, 64);
        let mut Cost: InstructionCost = self.getIntImmCost(Imm, Ty, CostKind);
        return if (Cost <= NumConstants * TCC_Basic) { InstructionCost { TCC_Free as i32 } } else { Cost };
    }
    return self.getIntImmCost(Imm, Ty, CostKind);
}

fn X86TTIImpl::getIntImmCostIntrin(self: *X86TTIImpl, IID: ID, Idx: u32, Imm: *APInt, Ty: *mut Type, CostKind: TargetCostKind) -> InstructionCost {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 {
        return InstructionCost { TCC_Free };
    }
    match IID {
        _ => {
            return InstructionCost { TCC_Free };
        },
        sadd_with_overflow => {
            uadd_with_overflow;
        },
        experimental_stackmap => {
            if (Idx < 2) || (Imm.getBitWidth() <= 64 && Imm.isSignedIntN(64)) {
                return InstructionCost { TCC_Free };
            }
        },
        experimental_patchpoint_void => {
            experimental_patchpoint;
        },
    }
    return self.getIntImmCost(Imm, Ty, CostKind);
}

fn X86TTIImpl::getCFInstrCost(self: *X86TTIImpl, Opcode: u32, CostKind: TargetCostKind, I: *Instruction) -> InstructionCost {
    if CostKind != TCK_RecipThroughput {
        return InstructionCost { if Opcode == PHI { TCC_Free } else { TCC_Basic } };
    }
    return InstructionCost { TCC_Free };
}

fn X86TTIImpl::getGatherOverhead(self: *X86TTIImpl) -> i32 {
    if self.ST.hasAVX512() || (self.ST.hasAVX2() && self.ST()) {
        return 2;
    }
    return 1024;
}

fn X86TTIImpl::getScatterOverhead(self: *X86TTIImpl) -> i32 {
    if self.ST.hasAVX512() {
        return 2;
    }
    return 1024;
}

fn X86TTIImpl::getGSVectorCost(self: *X86TTIImpl, Opcode: u32, CostKind: TargetCostKind, SrcVTy: *mut Type, Ptr: *Value, Alignment: Align, AddressSpace: u32) -> InstructionCost {
    assert!(isa(SrcVTy), "Unexpected type in getGSVectorCost");
    let mut VF: u32 = cast(SrcVTy)();
    let mut getIndexSizeInBits: Closure_20 = Closure_20 {};
    let mut IndexSize: u32 = 0;
    let mut IndexVTy: *mut auto = get(get(SrcVTy.getContext(), IndexSize), VF);
    let mut IdxsLT: pair<InstructionCost, MVT> = zeroed();
    let mut SrcLT: pair<InstructionCost, MVT> = zeroed();
    let mut SplitFactor: CostType = if  >  {  } else {  }();
    if SplitFactor > 1 {
        let mut SplitSrcTy: *mut auto = get(SrcVTy.getScalarType(), VF / SplitFactor);
        return SplitFactor * self.getGSVectorCost(Opcode, CostKind, Ptr, Alignment, AddressSpace);
    }
    if CostKind == TCK_CodeSize {
        return InstructionCost { 1 };
    }
    let mut GSOverhead: i32 = if (Opcode == Load) { self.getGatherOverhead() } else { self.getScatterOverhead() };
    return InstructionCost { GSOverhead } + InstructionCost { VF } * self.getMemoryOpCost(Opcode, SrcVTy.getScalarType(), Alignment, AddressSpace, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
}

fn X86TTIImpl::getGatherScatterOpCost(self: *X86TTIImpl, MICA: *MemIntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    let mut IsLoad: bool = MICA.getID() == masked_gather || MICA.getID() == vp_gather;
    let mut Opcode: u32 = if IsLoad { Load } else { Store };
    let mut SrcVTy: *mut Type = MICA.getDataType();
    let mut Ptr: *Value = MICA.getPointer();
    let mut Alignment: Align = MICA.getAlignment();
    assert!(SrcVTy.isVectorTy(), "Unexpected data type for Gather/Scatter");
    let mut AddressSpace: u32 = MICA.getAddressSpace();
    return self.getGSVectorCost(Opcode, CostKind, SrcVTy, Ptr, Alignment, AddressSpace);
}

fn X86TTIImpl::isLSRCostLess(self: *X86TTIImpl, C1: *LSRCost, C2: *LSRCost) -> bool {
    return tie(C1.Insns, C1.NumRegs, C1.AddRecCost, C1.NumIVMuls, C1.NumBaseAdds, C1.ScaleCost, C1.ImmCost, C1.SetupCost) < tie(C2.Insns, C2.NumRegs, C2.AddRecCost, C2.NumIVMuls, C2.NumBaseAdds, C2.ScaleCost, C2.ImmCost, C2.SetupCost);
}

fn X86TTIImpl::canMacroFuseCmp(self: *X86TTIImpl) -> bool {
    return self.ST() || self.ST();
}

fn isLegalMaskedLoadStore(ScalarTy: *mut Type, ST: *X86Subtarget) -> bool {
    if !ST.hasAVX() {
        return false;
    }
    if ScalarTy.isPointerTy() {
        return true;
    }
    if ScalarTy.isFloatTy() || ScalarTy.isDoubleTy() {
        return true;
    }
    if ScalarTy.isHalfTy() && ST()() {
        return true;
    }
    if ScalarTy.isBFloatTy() && ST()() {
        return true;
    }
    if !ScalarTy.isIntegerTy() {
        return false;
    }
    let mut IntWidth: u32 = ScalarTy.getIntegerBitWidth();
    return IntWidth == 32 || IntWidth == 64 || ((IntWidth == 8 || IntWidth == 16) && ST()());
}

fn X86TTIImpl::isLegalMaskedLoad(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align, AddressSpace: u32, MaskKind: MaskKind) -> bool {
    let mut ScalarTy: *mut Type = DataTy.getScalarType();
    if isa(DataTy) && cast(DataTy)() == 1 {
        return self.ST() && self.hasConditionalLoadStoreForType(ScalarTy, false);
    }
    return isLegalMaskedLoadStore(ScalarTy, self.ST);
}

fn X86TTIImpl::isLegalMaskedStore(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align, AddressSpace: u32, MaskKind: MaskKind) -> bool {
    let mut ScalarTy: *mut Type = DataTy.getScalarType();
    if isa(DataTy) && cast(DataTy)() == 1 {
        return self.ST() && self.hasConditionalLoadStoreForType(ScalarTy, true);
    }
    return isLegalMaskedLoadStore(ScalarTy, self.ST);
}

fn X86TTIImpl::isLegalNTLoad(self: *X86TTIImpl, DataType: *mut Type, Alignment: Align) -> bool {
    let mut DataSize: u32 = 0;
    if Alignment >= DataSize && (DataSize == 16 || DataSize == 32) {
        return if DataSize == 16 { self.ST.hasSSE1() } else { self.ST.hasAVX2() };
    }
    return false;
}

fn X86TTIImpl::isLegalNTStore(self: *X86TTIImpl, DataType: *mut Type, Alignment: Align) -> bool {
    let mut DataSize: u32 = 0;
    if self.ST() && (DataType.isFloatTy() || DataType.isDoubleTy()) {
        return true;
    }
    if Alignment < DataSize || DataSize < 4 || DataSize > 32 || !isPowerOf2_32(DataSize) {
        return false;
    }
    if DataSize == 32 {
        return self.ST.hasAVX();
    }
    if DataSize == 16 {
        return self.ST.hasSSE1();
    }
    return true;
}

fn X86TTIImpl::isLegalBroadcastLoad(self: *X86TTIImpl, ElementTy: *mut Type, NumElements: ElementCount) -> bool {
    return self.ST.hasSSE3() && !NumElements.isScalable() && NumElements.getFixedValue() == 2 && ElementTy == getDoubleTy(ElementTy.getContext());
}

fn X86TTIImpl::isLegalMaskedExpandLoad(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    if !isa(DataTy) {
        return false;
    }
    if !self.ST.hasAVX512() {
        return false;
    }
    if cast(DataTy)() == 1 {
        return false;
    }
    let mut ScalarTy: *mut Type = cast(DataTy)();
    if ScalarTy.isFloatTy() || ScalarTy.isDoubleTy() {
        return true;
    }
    if !ScalarTy.isIntegerTy() {
        return false;
    }
    let mut IntWidth: u32 = ScalarTy.getIntegerBitWidth();
    return IntWidth == 32 || IntWidth == 64 || ((IntWidth == 8 || IntWidth == 16) && self.ST());
}

fn X86TTIImpl::isLegalMaskedCompressStore(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    return self.isLegalMaskedExpandLoad(DataTy, Alignment);
}

fn X86TTIImpl::supportsGather(self: *X86TTIImpl) -> bool {
    return self.ST.hasAVX512() || (self.ST() && self.ST.hasAVX2());
}

fn X86TTIImpl::forceScalarizeMaskedGather(self: *X86TTIImpl, VTy: *mut VectorType, Alignment: Align) -> bool {
    let mut NumElts: u32 = cast(VTy)();
    return NumElts == 1 || (self.ST.hasAVX512() && (NumElts == 2 || (NumElts == 4 && operator!(self.ST()))));
}

fn X86TTIImpl::isLegalMaskedGatherScatter(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    let mut ScalarTy: *mut Type = DataTy.getScalarType();
    if ScalarTy.isPointerTy() {
        return true;
    }
    if ScalarTy.isFloatTy() || ScalarTy.isDoubleTy() {
        return true;
    }
    if !ScalarTy.isIntegerTy() {
        return false;
    }
    let mut IntWidth: u32 = ScalarTy.getIntegerBitWidth();
    return IntWidth == 32 || IntWidth == 64;
}

fn X86TTIImpl::isLegalMaskedGather(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    if !self.supportsGather() || operator!(self.ST()) {
        return false;
    }
    return self.isLegalMaskedGatherScatter(DataTy, Alignment);
}

fn X86TTIImpl::isLegalAltInstr(self: *X86TTIImpl, VecTy: *mut VectorType, Opcode0: u32, Opcode1: u32, OpcodeMask: *SmallBitVector) -> bool {
    let mut NumElements: u32 = cast(VecTy)();
    assert!(OpcodeMask.len == NumElements, "Mask and VecTy are incompatible");
    if !isPowerOf2_32(NumElements) {
        return false;
    }
    let mut ElemTy: *mut Type = cast(VecTy)();
    if ElemTy.isFloatTy() {
        return self.ST.hasSSE3() && NumElements % 4 == 0;
    }
    if ElemTy.isDoubleTy() {
        return self.ST.hasSSE3() && NumElements % 2 == 0;
    }
    return false;
}

fn X86TTIImpl::isLegalMaskedScatter(self: *X86TTIImpl, DataType: *mut Type, Alignment: Align) -> bool {
    if !self.ST.hasAVX512() || operator!(self.ST()) {
        return false;
    }
    return self.isLegalMaskedGatherScatter(DataType, Alignment);
}

fn X86TTIImpl::hasDivRemOp(self: *X86TTIImpl, DataType: *mut Type, IsSigned: bool) -> bool {
    let mut VT: EVT = self.TLI.getValueType;
    return self.TLI.isOperationLegal;
}

fn X86TTIImpl::isExpensiveToSpeculativelyExecute(self: *X86TTIImpl, I: *Instruction) -> bool {
    if I.getOpcode() == FDiv {
        return true;
    }
}

fn X86TTIImpl::isFCmpOrdCheaperThanFCmpZero(self: *X86TTIImpl, Ty: *mut Type) -> bool {
    return false;
}

fn X86TTIImpl::areInlineCompatible(self: *X86TTIImpl, Caller: *Function, Callee: *Function) -> bool {
    let mut TM: *TargetMachine = self.getTLI().getTargetMachine;
    let mut CallerSubtarget: *X86Subtarget = TM;
    let mut CalleeSubtarget: *X86Subtarget = TM;
    let mut CallerBits: *FeatureBitset = CallerSubtarget()();
    let mut CalleeBits: *FeatureBitset = CalleeSubtarget()();
    let mut InlineIgnoreFeatures: *FeatureBitset = CallerSubtarget()();
    let mut RealCallerBits: FeatureBitset = CallerBits & operator(InlineIgnoreFeatures);
    let mut RealCalleeBits: FeatureBitset = CalleeBits & operator(InlineIgnoreFeatures);
    if (RealCallerBits & RealCalleeBits) != RealCalleeBits {
        return false;
    }
    if RealCallerBits == RealCalleeBits && CallerSubtarget.useAVX512Regs() == CalleeSubtarget.useAVX512Regs() {
        return true;
    }
    return true;
}

fn X86TTIImpl::areTypesABICompatible(self: *X86TTIImpl, Caller: *Function, Callee: *Function, Types: ArrayRef<Type *>) -> bool {
    let mut TM: *TargetMachine = self.getTLI().getTargetMachine;
    let mut CallerTLI: *TargetLowering = TM.getSubtargetImpl(*Caller).getTargetLowering();
    let mut CalleeTLI: *TargetLowering = TM.getSubtargetImpl(*Callee).getTargetLowering();
    let mut Ctx: *mut LLVMContext = Caller.getContext();
    let mut DL: *DataLayout = Caller.getDataLayout();
    let mut CC: ID = Callee.getCallingConv();
    return all_of(Types, Closure_21 { CallerTLI: &mut CallerTLI, DL: &mut DL, Ctx: &mut Ctx, CC: &mut CC, CalleeTLI: &mut CalleeTLI });
}

fn X86TTIImpl::enableMemCmpExpansion(self: *X86TTIImpl, OptSize: bool, IsZeroCmp: bool) -> MemCmpExpansionOptions {
    let mut Options: MemCmpExpansionOptions = MemCmpExpansionOptions {};
    Options.MaxNumLoads = self.TLI.getMaxExpandSizeMemcmp;
    Options.NumLoadsPerBlock = if IsZeroCmp { 2 } else { 1 };
    Options.AllowOverlappingLoads = true;
    if IsZeroCmp {
        let mut PreferredWidth: u32 = self.ST.getPreferVectorWidth();
        if PreferredWidth >= 512 && self.ST.hasAVX512() {
            Options.LoadSizes.push(64);
        }
        if PreferredWidth >= 256 && self.ST.hasAVX() {
            Options.LoadSizes.push(32);
        }
        if PreferredWidth >= 128 && self.ST.hasSSE2() {
            Options.LoadSizes.push(16);
        }
    }
    if self.ST() {
        Options.LoadSizes.push(8);
    }
    Options.LoadSizes.push(4);
    Options.LoadSizes.push(2);
    Options.LoadSizes.push(1);
    return Options;
}

fn X86TTIImpl::prefersVectorizedAddressing(self: *X86TTIImpl) -> bool {
    return self.supportsGather();
}

fn X86TTIImpl::supportsEfficientVectorElementLoadStore(self: *X86TTIImpl) -> bool {
    return false;
