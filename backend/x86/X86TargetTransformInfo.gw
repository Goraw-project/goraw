fn X86TTIImpl::getVectorInstrCost(self: *X86TTIImpl, Opcode: u32, Val: *mut Type, CostKind: TargetCostKind, Index: u32, Op0: *Value, Op1: *Value, VIC: VectorInstrContext) -> InstructionCost {
    let mut SLMCostTbl: []CostTblEntry = zeroed();
    assert!(Val.isVectorTy(), "This must be a vector type");
    let mut VT: *mut auto = cast(Val);
    if VT()() {
        return getInvalid(0);
    }
    let mut ScalarType: *mut Type = Val.getScalarType();
    let mut RegisterFileMoveCost: InstructionCost = InstructionCost { 0 };
    if Index == -1 && (Opcode == ExtractElement || Opcode == InsertElement) {
        assert!(isa(Val), "Fixed vector type expected");
        let mut VecAlign: Align = zeroed();
        let mut SclAlign: Align = zeroed();
        if Opcode == ExtractElement {
            return self.getMemoryOpCost(Store, Val, VecAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null) + self.getMemoryOpCost(Load, ScalarType, SclAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
        }
        if Opcode == InsertElement {
            return self.getMemoryOpCost(Store, Val, VecAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null) + self.getMemoryOpCost(Store, ScalarType, SclAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null) + self.getMemoryOpCost(Load, Val, VecAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
        }
    }
    if Index != -1 && (Opcode == ExtractElement || Opcode == InsertElement) {
        if Opcode == ExtractElement && ScalarType.getScalarSizeInBits() == 1 && cast(Val)() > 1 {
            return InstructionCost { 1 };
        }
        let mut LT: pair<InstructionCost, MVT> = zeroed();
        if operator!() {
            return InstructionCost { TCC_Free };
        }
        let mut SizeInBits: u32 = ();
        let mut NumElts: u32 = ();
        let mut SubNumElts: u32 = NumElts;
        Index = Index % NumElts;
        if SizeInBits > 128 {
            assert!((SizeInBits % 128) == 0, "Illegal vector");
            let mut NumSubVecs: u32 = SizeInBits / 128;
            SubNumElts = NumElts / NumSubVecs;
            if SubNumElts <= Index {
                operator(RegisterFileMoveCost, (if Opcode == InsertElement { 2 } else { 1 }));
                Index %= SubNumElts;
            }
        }
        let mut MScalarTy: MVT = ();
        let mut IsCheapPInsrPExtrInsertPS: Closure_15 = Closure_15 { MScalarTy: &mut MScalarTy, cap_1: self, Index: &mut Index, Opcode: &mut Opcode };
        if Index == 0 {
            if ScalarType.isFloatingPointTy() && (Opcode != InsertElement || !Op0 || isa(Op0)) {
                return RegisterFileMoveCost;
            }
            if Opcode == InsertElement && isa_and_nonnull(Op0) {
                if isa_and_nonnull(Op1) {
                    return RegisterFileMoveCost;
                }
                if operator!(IsCheapPInsrPExtrInsertPS()) {
                    if isa_and_nonnull(Op1) && Op1.getType().isIntegerTy() {
                        return InstructionCost { 2 } + RegisterFileMoveCost;
                    }
                    return InstructionCost { 1 } + RegisterFileMoveCost;
                }
            }
            if ScalarType.isIntegerTy() && Opcode == ExtractElement {
                return InstructionCost { 1 } + RegisterFileMoveCost;
            }
        }
        let mut ISD: i32 = self.TLI.InstructionOpcodeToISD;
        assert!(ISD, "Unexpected vector opcode");
        if self.ST() {
            if  {
                return  + RegisterFileMoveCost;
            }
        }
        if IsCheapPInsrPExtrInsertPS() {
            return InstructionCost { 1 } + RegisterFileMoveCost;
        }
        let mut ShuffleCost: InstructionCost = InstructionCost { 1 };
        if Opcode == InsertElement {
            let mut SubTy: *mut auto = cast(Val);
            let mut VT: EVT = self.TLI.getValueType;
            if VT.getScalarType() != EVT { MScalarTy } || VT.getSizeInBits().operator unsigned long long() >= 128 {
                SubTy() = get(ScalarType, SubNumElts);
            }
            ShuffleCost = self.getShuffleCost(SK_PermuteTwoSrc, CostKind, void {}, 0);
        }
        let mut IntOrFpCost: i32 = if ScalarType.isFloatingPointTy() { 0 } else { 1 };
        return ShuffleCost + InstructionCost { IntOrFpCost } + RegisterFileMoveCost;
    }
}

fn X86TTIImpl::getScalarizationOverhead(self: *X86TTIImpl, Ty: *mut VectorType, DemandedElts: *APInt, Insert: bool, Extract: bool, CostKind: TargetCostKind, ForPoisonSrc: bool, VL: ArrayRef<Value *>, VIC: VectorInstrContext) -> InstructionCost {
    (((operator!(operator!((DemandedElts.getBitWidth() == cast(Ty)() && "Vector size mismatch")))) || (_wassert(L"DemandedElts.getBitWidth() == cast<FixedVectorType>(Ty)->getNumElements() && \"Vector size mismatch\"", L"llvm\\lib\\Target\\X86\\X86TargetTransformInfo.cpp", (5523) as u32) , 0)) as void);
    let mut LT: pair<InstructionCost, MVT> = zeroed();
    let mut MScalarTy: MVT = ();
    let mut LegalVectorBitWidth: u32 = ();
    let mut Cost: InstructionCost = InstructionCost { 0 };
    let mut LaneBitWidth: u32 = 128;
    assert!((LegalVectorBitWidth < LaneBitWidth || (LegalVectorBitWidth % LaneBitWidth) == 0), "Illegal vector");
    let mut NumLegalVectors: i32 = ();
    assert!(NumLegalVectors >= 0, "Negative cost!");
    if Insert && !ForPoisonSrc {
        return Cost;
    }
    if Insert {
        if (MScalarTy == i16 && self.ST.hasSSE2()) || (MScalarTy.isInteger() && self.ST.hasSSE41()) || (MScalarTy == f32 && self.ST.hasSSE41()) {
            if LegalVectorBitWidth <= LaneBitWidth {} else {
                assert!((LegalVectorBitWidth % LaneBitWidth) == 0, "Illegal vector");
                let mut NumLegalLanes: u32 = LegalVectorBitWidth / LaneBitWidth;
                let mut NumLanesTotal: u32 = NumLegalLanes * NumLegalVectors;
                let mut NumLegalElts: u32 = () * NumLegalVectors;
                assert!(NumLegalElts >= DemandedElts.getBitWidth(), "Vector has been legalized to smaller element count");
                assert!((NumLegalElts % NumLanesTotal) == 0, "Unexpected elts per lane");
                let mut NumEltsPerLane: u32 = NumLegalElts / NumLanesTotal;
                let mut WidenedDemandedElts: APInt = DemandedElts.zext(NumLegalElts);
                let mut LaneTy: *mut auto = get(Ty.getElementType(), NumEltsPerLane);
                for let mut I: u32 = 0; I != NumLanesTotal; I += 1 {
                    let mut LaneEltMask: APInt = WidenedDemandedElts.extractBits(NumEltsPerLane, NumEltsPerLane * I);
                    if LaneEltMask.isZero() {
                        continue;
                    }
                    if !LaneEltMask.isAllOnes() {
                        operator+=(Cost, self.getShuffleCost(SK_ExtractSubvector, Ty, Ty, CostKind, void {}, I * NumEltsPerLane));
                    }
                }
                let mut AffectedLanes: APInt = ScaleBitMask(WidenedDemandedElts, NumLanesTotal, false);
                let mut FullyAffectedLegalVectors: APInt = ScaleBitMask(AffectedLanes, NumLegalVectors, true);
                for let mut LegalVec: i32 = 0; LegalVec != NumLegalVectors; LegalVec += 1 {
                    for let mut Lane: u32 = 0; Lane != NumLegalLanes; Lane += 1 {
                        let mut I: u32 = NumLegalLanes * LegalVec + Lane;
                        if !AffectedLanes[I] || (Lane == 0 && FullyAffectedLegalVectors[LegalVec]) {
                            continue;
                        }
                        operator+=(Cost, self.getShuffleCost(SK_InsertSubvector, Ty, Ty, CostKind, void {}, I * NumEltsPerLane));
                    }
                }
            }
        } else if LT()() {
            if Ty.isIntOrIntVectorTy() {
                operator(Cost, DemandedElts.popcount());
            }
            let mut NumElts: u32 = ();
            let mut Pow2Elts: u32 = PowerOf2Ceil(cast(Ty)());
            operator+=(Cost, (min(NumElts, Pow2Elts) - 1) * );
        }
    }
    if Extract {
        if !Insert && Ty.getScalarSizeInBits() == 1 && !self.ST.hasAVX512() {
            let mut NumElts: u32 = cast(Ty)();
            let mut MaxElts: u32 = if self.ST.hasAVX2() { 32 } else { 16 };
            let mut MOVMSKCost: u32 = (NumElts + MaxElts - 1) / MaxElts;
            return InstructionCost { MOVMSKCost };
        }
        if LT()() {
            let mut NumLegalElts: u32 = () * NumLegalVectors;
            assert!(NumLegalElts >= DemandedElts.getBitWidth(), "Vector has been legalized to smaller element count");
            if LegalVectorBitWidth > LaneBitWidth {
                let mut NumLegalLanes: u32 = LegalVectorBitWidth / LaneBitWidth;
                let mut NumLanesTotal: u32 = NumLegalLanes * NumLegalVectors;
                assert!((NumLegalElts % NumLanesTotal) == 0, "Unexpected elts per lane");
                let mut NumEltsPerLane: u32 = NumLegalElts / NumLanesTotal;
                let mut WidenedDemandedElts: APInt = DemandedElts.zext(NumLegalElts);
                let mut LaneTy: *mut auto = get(Ty.getElementType(), NumEltsPerLane);
                for let mut I: u32 = 0; I != NumLanesTotal; I += 1 {
                    let mut LaneEltMask: APInt = WidenedDemandedElts.extractBits(NumEltsPerLane, I * NumEltsPerLane);
                    if LaneEltMask.isZero() {
                        continue;
                    }
                    operator+=(Cost, self.getShuffleCost(SK_ExtractSubvector, Ty, Ty, CostKind, void {}, I * NumEltsPerLane));
                }
                return Cost;
            }
        }
    }
    return Cost;
}

fn X86TTIImpl::getReplicationShuffleCost(self: *X86TTIImpl, EltTy: *mut Type, ReplicationFactor: i32, VF: i32, DemandedDstElts: *APInt, CostKind: TargetCostKind) -> InstructionCost {
    let mut EltTyBits: u32 = 0;
    EltTy = getIntNTy(EltTy.getContext(), EltTyBits);
    let mut bailout: Closure_16 = Closure_16 { EltTy: &mut EltTy, ReplicationFactor: &mut ReplicationFactor, VF: &mut VF, DemandedDstElts: &mut DemandedDstElts, CostKind: &mut CostKind };
    if !self.ST.hasAVX512() {
        return bailout.call();
    }
    let mut PromEltTyBits: u32 = EltTyBits;
    match EltTyBits {
        32 => {
            64;
        },
        16 => {
            if operator!(self.ST()) {
                PromEltTyBits = 32;
            }
        },
        8 => {
            if operator!(self.ST()) {
                PromEltTyBits = 32;
            }
        },
        1 => {
            if self.ST() {
                if self.ST() {
                    PromEltTyBits = 8;
                } else {
                    PromEltTyBits = 16;
                }
                break;
            }
        },
        _ => {
            return bailout.call();
        },
    }
    let mut PromEltTy: *mut IntegerType = getIntNTy(EltTy.getContext(), PromEltTyBits);
    let mut SrcVecTy: *mut FixedVectorType = get(EltTy, VF);
    let mut PromSrcVecTy: *mut FixedVectorType = get(PromEltTy, VF);
    let mut NumDstElements: i32 = VF * ReplicationFactor;
    let mut PromDstVecTy: *mut FixedVectorType = get(PromEltTy, NumDstElements);
    let mut DstVecTy: *mut FixedVectorType = get(EltTy, NumDstElements);
    let mut LegalSrcVecTy: MVT = getTypeLegalizationCost(SrcVecTy);
    let mut LegalPromSrcVecTy: MVT = getTypeLegalizationCost(PromSrcVecTy);
    let mut LegalPromDstVecTy: MVT = getTypeLegalizationCost(PromDstVecTy);
    let mut LegalDstVecTy: MVT = getTypeLegalizationCost(DstVecTy);
    if !LegalSrcVecTy.isVector() || !LegalPromSrcVecTy.isVector() || !LegalPromDstVecTy.isVector() || !LegalDstVecTy.isVector() {
        return bailout.call();
    }
    if PromEltTyBits != EltTyBits {
        let mut PromotionCost: InstructionCost = InstructionCost {};
        operator(PromotionCost, self.getCastInstrCost(SExt, PromSrcVecTy, SrcVecTy, None, CostKind, null));
        operator(PromotionCost, self.getCastInstrCost(Trunc, DstVecTy, PromDstVecTy, None, CostKind, null));
        return PromotionCost + self.getReplicationShuffleCost(PromEltTy, ReplicationFactor, VF, DemandedDstElts, CostKind);
    }
    assert!(LegalSrcVecTy.getScalarSizeInBits() == EltTyBits && LegalSrcVecTy.getScalarType() == LegalDstVecTy.getScalarType(), "We expect that the legalization doesn't affect the element width, doesn't coalesce/split elements.");
    let mut NumEltsPerDstVec: u32 = LegalDstVecTy.getVectorNumElements();
    let mut NumDstVectors: u32 = divideCeil(DstVecTy.getNumElements(), NumEltsPerDstVec);
    let mut SingleDstVecTy: *mut auto = get(EltTy, NumEltsPerDstVec);
    let mut DemandedDstVectors: APInt = ScaleBitMask(DemandedDstElts.zext(NumDstVectors * NumEltsPerDstVec), NumDstVectors, false);
    let mut NumDstVectorsDemanded: u32 = DemandedDstVectors.popcount();
    let mut SingleShuffleCost: InstructionCost = self.getShuffleCost(SK_PermuteSingleSrc, CostKind, void {}, 0, null);
    return InstructionCost { NumDstVectorsDemanded } * SingleShuffleCost;
}

fn X86TTIImpl::getMemoryOpCost(self: *X86TTIImpl, Opcode: u32, Src: *mut Type, Alignment: Align, AddressSpace: u32, CostKind: TargetCostKind, OpInfo: OperandValueInfo, I: *Instruction) -> InstructionCost {
    if CostKind != TCK_RecipThroughput {
