fn Closure_20::call(self: *Closure_20, Ptr: *Value, DL: *DataLayout) -> u32 {
        let mut IndexSize: u32 = DL.getPointerSizeInBits(0);
        let mut GEP: *GetElementPtrInst = dyn_cast_or_null(Ptr);
        if IndexSize < 64 || !GEP {
            return IndexSize;
        }
        let mut NumOfVarIndices: u32 = 0;
        let mut Ptrs: *Value = GEP.getPointerOperand();
        if Ptrs.getType().isVectorTy() && !getSplatValue(Ptrs) {
            return IndexSize;
        }
        for let mut I: u32 = 1;
let mut E: u32 = GEP.getNumOperands(); I != E; I += 1 {
            if isa(GEP.getOperand(I)) {
                continue;
            }
            let mut IndxTy: *mut Type = GEP.getOperand(I).getType();
            if dyn_cast(IndxTy) {
                IndexVTy;
            } else {
                IndxTy = IndexVTy.getElementType();
            }
            if (IndxTy.getPrimitiveSizeInBits().operator unsigned long long() == 64 && !isa(GEP.getOperand(I))) || NumOfVarIndices += 1 > 1 {
                return IndexSize;
            }
        }
        return 32 as u32;
    }

