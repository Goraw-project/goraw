fn X86TTIImpl::isProfitableToSinkOperands(self: *X86TTIImpl, I: *mut Instruction, Ops: *mut SmallVectorImpl<Use *>) -> bool {
    if I.getOpcode() == And && (self.ST() || (I.getType().isVectorTy() && self.ST.hasSSE2())) {
        for Op in I.operands() {
            if match(Op.get(), m_Not(m_Value())) && !I.getType().isIntegerTy(8) {
                Ops()(&mut Op);
                return true;
            }
            if match(Op.get(), m_Shuffle(m_InsertElt(m_Value(), m_Not(m_Value())), m_Value(), m_ZeroMask {})) {
                let mut InsertElt: *mut Use = cast(Op)(0);
                let mut Not: *mut Use = cast(InsertElt)(1);
                Ops()(&mut Not);
                Ops()(&mut InsertElt);
                Ops()(&mut Op);
                return true;
            }
        }
    }
    let mut VTy: *mut FixedVectorType = dyn_cast(I.getType());
    if !VTy {
        return false;
    }
    if I.getOpcode() == Mul && VTy.getElementType().isIntegerTy(64) {
        for Op in I.operands() {
            if any_of(Ops, Closure_24 { Op: &mut Op }) {
                continue;
            }
            if self.ST.hasSSE41() && match(Op.get(), m_AShr(m_Shl(m_Value()))) {
                Ops()(operator&(cast(Op)(0)));
                Ops()(&mut Op);
            } else if self.ST.hasSSE2() && match(Op.get(), m_And(m_Value())) {
                Ops()(&mut Op);
            }
        }
        return operator!(Ops()());
    }
    let mut ShiftAmountOpNum: i32 = -1;
    if I.isShift() {
        ShiftAmountOpNum = 1;
    } else if  {
        if II()() == fshl || () == fshr {
            ShiftAmountOpNum = 2;
        }
    }
    if ShiftAmountOpNum == -1 {
        return false;
    }
    let mut Shuf: *mut auto = dyn_cast(I.getOperand(ShiftAmountOpNum));
    if Shuf() && getSplatIndex() >= 0 && self.isVectorShiftByScalarCheap(I.getType()) {
        Ops()(&mut I.getOperandUse(ShiftAmountOpNum));
        return true;
    }
    return false;
}

fn X86TTIImpl::useFastCCForInternalCall(self: *X86TTIImpl, F: *mut Function) -> bool {
    let mut HasEGPR: bool = self.ST();
    let mut TM: *TargetMachine = self.getTLI().getTargetMachine;
    for U in F.users() {
        let mut CB: *mut CallBase = dyn_cast(U);
        if !CB || CB.getCalledOperand() != &mut F {
            continue;
        }
        let mut CallerFunc: *mut Function = CB.getFunction();
        if TM() != HasEGPR {
            return false;
        }
    }
    return true;
}

