    let mut SSE41CostTable: [12]CostKindTblEntry = [CostKindTblEntry { SHL, v16i8, 15, 24, 17, 22 }, CostKindTblEntry { SHL, v8i16, 11, 14, 11, 11 }, CostKindTblEntry { SHL, v4i32, 14, 20, 4, 10 }, CostKindTblEntry { SRL, v16i8, 16, 27, 18, 24 }, CostKindTblEntry { SRL, v8i16, 22, 26, 23, 27 }, CostKindTblEntry { SRL, v4i32, 16, 17, 15, 19 }, CostKindTblEntry { SRL, v2i64, 4, 6, 5, 7 }, CostKindTblEntry { SRA, v16i8, 38, 41, 30, 36 }, CostKindTblEntry { SRA, v8i16, 22, 26, 23, 27 }, CostKindTblEntry { SRA, v4i32, 16, 17, 15, 19 }, CostKindTblEntry { SRA, v2i64, 8, 17, 5, 7 }, CostKindTblEntry { MUL, v4i32, 2, 11, 1, 1 }];
    if self.ST.hasSSE41() {
