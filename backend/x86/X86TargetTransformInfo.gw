        }
        operator+=(ReductionCost, self.getArithmeticInstrCost(Opcode, CostKind));
    }
    return ReductionCost + self.getVectorInstrCost(ExtractElement, CostKind, 0, null, null, None);
}

fn X86TTIImpl::getMinMaxCost(self: *X86TTIImpl, IID: ID, Ty: *mut Type, CostKind: TargetCostKind, FMF: FastMathFlags) -> InstructionCost {
