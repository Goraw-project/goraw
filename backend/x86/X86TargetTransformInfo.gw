    let mut AVX512VBMI2CostTbl: [18]CostKindTblEntry = [CostKindTblEntry { FSHL, v8i64, 1, 1, 1, 1 }, CostKindTblEntry { FSHL, v4i64, 1, 1, 1, 1 }, CostKindTblEntry { FSHL, v2i64, 1, 1, 1, 1 }, CostKindTblEntry { FSHL, v16i32, 1, 1, 1, 1 }, CostKindTblEntry { FSHL, v8i32, 1, 1, 1, 1 }, CostKindTblEntry { FSHL, v4i32, 1, 1, 1, 1 }, CostKindTblEntry { FSHL, v32i16, 1, 1, 1, 1 }, CostKindTblEntry { FSHL, v16i16, 1, 1, 1, 1 }, CostKindTblEntry { FSHL, v8i16, 1, 1, 1, 1 }, CostKindTblEntry { ROTL, v32i16, 1, 1, 1, 1 }, CostKindTblEntry { ROTL, v16i16, 1, 1, 1, 1 }, CostKindTblEntry { ROTL, v8i16, 1, 1, 1, 1 }, CostKindTblEntry { ROTR, v32i16, 1, 1, 1, 1 }, CostKindTblEntry { ROTR, v16i16, 1, 1, 1, 1 }, CostKindTblEntry { ROTR, v8i16, 1, 1, 1, 1 }, CostKindTblEntry { VROTLI, v32i16, 1, 1, 1, 1 }, CostKindTblEntry { VROTLI, v16i16, 1, 1, 1, 1 }, CostKindTblEntry { VROTLI, v8i16, 1, 1, 1, 1 }];
