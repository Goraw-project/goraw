    let mut AVX2InterleavedLoadTbl: []CostTblEntry = zeroed();
    let mut SSSE3InterleavedLoadTbl: []CostTblEntry = zeroed();
    let mut SSE2InterleavedLoadTbl: []CostTblEntry = zeroed();
    let mut AVX2InterleavedStoreTbl: []CostTblEntry = zeroed();
    let mut SSE2InterleavedStoreTbl: []CostTblEntry = zeroed();
    if Opcode == Load {
        let mut GetDiscountedCost: Closure_23 = Closure_23 { Factor: Factor, cap_1: Indices.len, cap_2: MemOpCosts };
        if self.ST.hasAVX2() {
            if  {
                return GetDiscountedCost();
            }
        }
        if self.ST.hasSSSE3() {
            if  {
                return GetDiscountedCost();
            }
        }
        if self.ST.hasSSE2() {
            if  {
                return GetDiscountedCost();
            }
        }
    } else {
        assert!(Opcode == Store, "Expected Store Instruction at this point");
        assert!((!Indices.len || Indices.len == Factor), "Interleaved store only supports fully-interleaved groups.");
        if self.ST.hasAVX2() {
            if  {
                return MemOpCosts + ;
            }
        }
        if self.ST.hasSSE2() {
            if  {
                return MemOpCosts + ;
            }
        }
    }
}

fn X86TTIImpl::getScalingFactorCost(self: *X86TTIImpl, Ty: *mut Type, BaseGV: *mut GlobalValue, BaseOffset: StackOffset, HasBaseReg: bool, Scale: i64, AddrSpace: u32) -> InstructionCost {
    let mut AM: AddrMode = AddrMode {};
    AM.BaseGV = BaseGV;
    AM.BaseOffs = BaseOffset.getFixed();
    AM.HasBaseReg = HasBaseReg;
    AM.Scale = Scale;
    AM.ScalableOffset = BaseOffset.getScalable();
    if self.getTLI().isLegalAddressingMode {
        return InstructionCost { AM.Scale != 0 };
    }
    return getInvalid(0);
}

