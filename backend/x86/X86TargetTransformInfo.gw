        return LT.first * operator(KindCost);
    }
    if CostKind == TCK_RecipThroughput && LT.second.isVector() && (ISD == SDIV || ISD == SREM || ISD == UDIV || ISD == UREM) {
        let mut ScalarCost: InstructionCost = self.getArithmeticInstrCost(Opcode, Ty.getScalarType(), CostKind, Op1Info.getNoProps(), Op2Info.getNoProps(), ArrayRef<const Value *> {}, null);
        return 20 * LT.first * LT.second.getVectorNumElements() * ScalarCost;
    }
    if CostKind == TCK_CodeSize {
        match ISD {
            FADD => {
                FSUB;
            },
        }
    }
    return self.getArithmeticInstrCost(Opcode, Ty, CostKind, Op1Info, Op2Info, Args, CtxI);
