    let mut Ty: *mut auto = ;
    let mut MinMaxCost: InstructionCost = InstructionCost { 0 };
    if LT() != 1 && MTy.isVector() && MTy.getVectorNumElements() < () {
        Ty() = get(MTy.getVectorNumElements());
