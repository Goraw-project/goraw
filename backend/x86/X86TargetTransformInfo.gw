fn X86TTIImpl::enableInterleavedAccessVectorization(self: *X86TTIImpl) -> bool {
    return operator!((self.ST()));
}

fn X86TTIImpl::shouldExpandReduction(self: *X86TTIImpl, II: *IntrinsicInst) -> bool {
    match II.getIntrinsicID() {
        _ => {
            return true;
        },
        vector_reduce_and => {
            vector_reduce_or;
        },
    }
}

fn X86TTIImpl::getInterleavedMemoryOpCostAVX512(self: *X86TTIImpl, Opcode: u32, VecTy: *mut FixedVectorType, Factor: u32, Indices: ArrayRef<unsigned int>, Alignment: Align, AddressSpace: u32, CostKind: TargetCostKind, UseMaskForCond: bool, UseMaskForGaps: bool) -> InstructionCost {
    let mut LegalVT: MVT = getTypeLegalizationCost(VecTy);
    let mut VecTySize: u32 = 0;
    let mut LegalVTSize: u32 = LegalVT.getStoreSize().operator unsigned long long();
    let mut NumOfMemOps: u32 = (VecTySize + LegalVTSize - 1) / LegalVTSize;
    let mut SingleMemOpTy: *mut auto = get(VecTy.getElementType(), LegalVT.getVectorNumElements());
    let mut MemOpCost: InstructionCost = InstructionCost {};
    let mut UseMaskedMemOp: bool = UseMaskForCond || UseMaskForGaps;
    if UseMaskedMemOp {
        let mut IID: u32 = if Opcode == Load { masked_load } else { masked_store };
        MemOpCost = self.getMaskedMemoryOpCost(void { IID, Alignment, AddressSpace }, CostKind);
    } else {
        MemOpCost = self.getMemoryOpCost(Opcode, Alignment, AddressSpace, CostKind);
    }
    let mut VF: u32 = VecTy.getNumElements() / Factor;
    let mut VT: MVT = getVectorVT(self.TLI.getSimpleValueType, VF);
    let mut MaskCost: InstructionCost = InstructionCost {};
    if UseMaskedMemOp {
        let mut DemandedLoadStoreElts: APInt = getZero(VecTy.getNumElements());
        for Index in Indices {
            assert!(Index < Factor, "Invalid index for interleaved memory op");
            for let mut Elm: u32 = 0; Elm < VF; Elm += 1 {
                DemandedLoadStoreElts.setBit(Index + Elm * Factor);
            }
        }
        let mut I1Type: *mut Type = getInt1Ty(VecTy.getContext());
        MaskCost = self.getReplicationShuffleCost(I1Type, Factor, VF, if UseMaskForGaps { DemandedLoadStoreElts } else { getAllOnes(VecTy.getNumElements()) }, CostKind);
        if UseMaskForGaps {
            let mut MaskVT: *mut FixedVectorType = get(I1Type, VecTy.getNumElements());
            operator(MaskCost, self.getArithmeticInstrCost(And, MaskVT, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, void {}, null));
        }
    }
    if Opcode == Load {
        let mut AVX512InterleavedLoadTbl: []CostTblEntry = zeroed();
        if  {
            return MaskCost + InstructionCost { NumOfMemOps } * MemOpCost + ;
        }
        let mut ShuffleKind: ShuffleKind = if (NumOfMemOps > 1) { SK_PermuteTwoSrc } else { SK_PermuteSingleSrc };
        let mut ShuffleCost: InstructionCost = self.getShuffleCost(ShuffleKind, CostKind, void {}, 0, null);
        let mut NumOfLoadsInInterleaveGrp: u32 = if Indices.len { Indices.len } else { Factor };
        let mut ResultTy: *mut FixedVectorType = get(VecTy.getElementType(), VecTy.getNumElements() / Factor);
        let mut NumOfResults: InstructionCost = getTypeLegalizationCost(ResultTy) * NumOfLoadsInInterleaveGrp;
        let mut NumOfUnfoldedLoads: u32 = if UseMaskedMemOp || NumOfResults > 1 { NumOfMemOps } else { NumOfMemOps / 2 };
        let mut NumOfShufflesPerResult: u32 = max(1 as u32, (NumOfMemOps - 1) as u32);
        let mut NumOfMoves: InstructionCost = InstructionCost { 0 };
        if NumOfResults > 1 && ShuffleKind == SK_PermuteTwoSrc {
            NumOfMoves = NumOfResults * InstructionCost { NumOfShufflesPerResult } / InstructionCost { 2 };
        }
        let mut Cost: InstructionCost = NumOfResults * InstructionCost { NumOfShufflesPerResult } * ShuffleCost + MaskCost + InstructionCost { NumOfUnfoldedLoads } * MemOpCost + NumOfMoves;
        return Cost;
    }
    assert!(Opcode == Store, "Expected Store Instruction at this  point");
    let mut AVX512InterleavedStoreTbl: []CostTblEntry = zeroed();
    if  {
        return MaskCost + InstructionCost { NumOfMemOps } * MemOpCost + ;
    }
    let mut NumOfSources: u32 = Factor;
    let mut ShuffleCost: InstructionCost = self.getShuffleCost(SK_PermuteTwoSrc, CostKind, void {}, 0, null);
    let mut NumOfShufflesPerStore: u32 = NumOfSources - 1;
    let mut NumOfMoves: u32 = NumOfMemOps * NumOfShufflesPerStore / 2;
    let mut Cost: InstructionCost = MaskCost + InstructionCost { NumOfMemOps } * (MemOpCost + InstructionCost { NumOfShufflesPerStore } * ShuffleCost) + InstructionCost { NumOfMoves };
    return Cost;
}

fn X86TTIImpl::getInterleavedMemoryOpCost(self: *X86TTIImpl, Opcode: u32, BaseTy: *mut Type, Factor: u32, Indices: ArrayRef<unsigned int>, Alignment: Align, AddressSpace: u32, CostKind: TargetCostKind, UseMaskForCond: bool, UseMaskForGaps: bool) -> InstructionCost {
