fn X86TTIImpl::getScalingFactorCost(self: *X86TTIImpl, Ty: *mut Type, BaseGV: *mut GlobalValue, BaseOffset: StackOffset, HasBaseReg: bool, Scale: i64, AddrSpace: u32) -> InstructionCost {
    let mut AM: AddrMode = AddrMode {};
    AM.BaseGV = BaseGV;
    AM.BaseOffs = BaseOffset.getFixed();
    AM.HasBaseReg = HasBaseReg;
    AM.Scale = Scale;
    AM.ScalableOffset = BaseOffset.getScalable();
    if self.getTLI().isLegalAddressingMode(self.DL, AM, Ty, AddrSpace, null) {
        return AM.Scale != 0;
    }
    return getInvalid(0);
}

fn X86TTIImpl::getBranchMispredictPenalty(self: *X86TTIImpl) -> InstructionCost {
    return 14;
}

fn X86TTIImpl::isVectorShiftByScalarCheap(self: *X86TTIImpl, Ty: *mut Type) -> bool {
    let mut Bits: u32 = Ty.getScalarSizeInBits();
    if self.ST.hasXOP() && (Bits == 8 || Bits == 16 || Bits == 32 || Bits == 64) {
        return false;
    }
    if self.ST.hasAVX2() && (Bits == 32 || Bits == 64) {
        return false;
    }
    if self.ST.hasBWI() && Bits == 16 {
        return false;
    }
    return true;
}

fn X86TTIImpl::getStoreMinimumVF(self: *X86TTIImpl, VF: u32, ScalarMemTy: *mut Type, ScalarValTy: *mut Type, Alignment: Align, AddrSpace: u32) -> u32 {
    if self.ST.hasF16C() && ScalarMemTy.isHalfTy() {
        return 4;
    }
    return self.getStoreMinimumVF(VF, ScalarMemTy, ScalarValTy, Alignment, AddrSpace);
}

fn X86TTIImpl::isProfitableToSinkOperands(self: *X86TTIImpl, I: *mut Instruction, Ops: *mut SmallVectorImpl<Use *>) -> bool {
    if I.getOpcode() == And && (self.ST.hasBMI() || (I.getType().isVectorTy() && self.ST.hasSSE2())) {
        for Op in I.operands() {
            if match(Op.get(), m_Not(m_Value())) && !I.getType().isIntegerTy(8) {
                Ops.push(&mut Op);
                return true;
            }
            if match(Op.get(), m_Shuffle(m_InsertElt(m_Value(), m_Not(m_Value()), m_ZeroInt()), m_Value(), m_ZeroMask {})) {
                let mut InsertElt: *mut Use = cast(Op).getOperandUse(0);
                let mut Not: *mut Use = cast(InsertElt).getOperandUse(1);
                Ops.push(&mut Not);
                Ops.push(&mut InsertElt);
                Ops.push(&mut Op);
                return true;
            }
        }
    }
    let mut VTy: *mut FixedVectorType = dyn_cast(I.getType());
    if !VTy {
        return false;
    }
    if I.getOpcode() == Mul && VTy.getElementType().isIntegerTy(64) {
        for Op in I.operands() {
            if any_of(Ops, Closure_26 { Op: &mut Op }) {
                continue;
            }
            if self.ST.hasSSE41() && match(Op.get(), m_AShr(m_Shl(m_Value(), m_SpecificInt(32)), m_SpecificInt(32))) {
                Ops.push(&mut cast(Op).getOperandUse(0));
                Ops.push(&mut Op);
            } else if self.ST.hasSSE2() && match(Op.get(), m_And(m_Value(), m_SpecificInt((4294967295)))) {
                Ops.push(&mut Op);
            }
        }
        return !Ops.is_empty();
    }
    let mut ShiftAmountOpNum: i32 = -1;
    if I.isShift() {
        ShiftAmountOpNum = 1;
    } else if dyn_cast(I) {
        II;
    } else {
        if II.getIntrinsicID() == fshl || II.getIntrinsicID() == fshr {
            ShiftAmountOpNum = 2;
        }
    }
    if ShiftAmountOpNum == -1 {
        return false;
    }
    let mut Shuf: *mut ShuffleVectorInst = dyn_cast(I.getOperand(ShiftAmountOpNum));
    if Shuf && getSplatIndex(Shuf.getShuffleMask()) >= 0 && self.isVectorShiftByScalarCheap(I.getType()) {
        Ops.push(&mut I.getOperandUse(ShiftAmountOpNum));
        return true;
    }
    return false;
}

fn X86TTIImpl::useFastCCForInternalCall(self: *X86TTIImpl, F: *mut Function) -> bool {
    let mut HasEGPR: bool = self.ST.hasEGPR();
    let mut TM: *TargetMachine = self.getTLI().getTargetMachine();
    for U in F.users() {
        let mut CB: *mut CallBase = dyn_cast(U);
        if !CB || CB.getCalledOperand() != &mut F {
            continue;
        }
        let mut CallerFunc: *mut Function = CB.getFunction();
        if TM.getSubtarget(*CallerFunc).hasEGPR() != HasEGPR {
            return false;
        }
    }
    return true;
}

