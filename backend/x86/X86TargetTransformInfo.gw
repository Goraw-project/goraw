fn X86TTIImpl::getAltInstrCost(self: *X86TTIImpl, VecTy: *mut VectorType, Opcode0: u32, Opcode1: u32, OpcodeMask: *SmallBitVector, CostKind: TargetCostKind) -> InstructionCost {
    if self.isLegalAltInstr(VecTy, Opcode0, Opcode1, OpcodeMask) {
        return TCC_Basic;
    }
    return getInvalid(0);
}

fn X86TTIImpl::getShuffleCost(self: *X86TTIImpl, Kind: ShuffleKind, DstTy: *mut VectorType, SrcTy: *mut VectorType, CostKind: TargetCostKind, Mask: ArrayRef<int>, Index: i32, SubTp: *mut VectorType, Args: ArrayRef<const Value *>, CtxI: *Instruction, VIC: VectorInstrContext) -> InstructionCost {
    assert!((Mask.is_empty() || DstTy.isScalableTy() || Mask.len == DstTy.getElementCount().getKnownMinValue()), "Expected the Mask to match the return size if given");
    assert!(SrcTy.getScalarType() == DstTy.getScalarType(), "Expected the same scalar types");
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(SrcTy);
    Kind = self.improveShuffleKindFromMask(Kind, Mask, SrcTy, Index, SubTp);
    if !Args.is_empty() && all_of(Args, Closure_3 {}) {
        return TCC_Free;
    }
    if Kind == SK_PermuteTwoSrc && Mask.len == (2 * SrcTy.getElementCount().getKnownMinValue()) && isIdentityMask(Mask, Mask.len) {
        return self.getShuffleCost(SK_InsertSubvector, getDoubleElementsVectorType(SrcTy), getDoubleElementsVectorType(SrcTy), CostKind, Mask, Mask.len / 2, SrcTy, ArrayRef<const Value *> {}, null, None);
    }
    if Kind == SK_Transpose {
        if LT.second != v4f64 && LT.second != v4i64 {
            Kind = SK_PermuteTwoSrc;
        }
    }
    if Kind == SK_Broadcast {
        LT.first = 1;
        let mut IsBroadcastLoadFoldUser: Closure_4 = Closure_4 { Args: &mut Args };
        let mut IsFoldableSLPBroadcastLoad: Closure_5 = Closure_5 { Args: &mut Args, DstTy: &mut DstTy, IsBroadcastLoadFoldUser: &mut IsBroadcastLoadFoldUser };
        if !Args.is_empty() && (match(Args[0], m_OneUse(m_Load(m_Value()))) || IsFoldableSLPBroadcastLoad.call()) && (self.ST.hasAVX2() || (self.ST.hasAVX() && LT.second.getScalarSizeInBits() >= 32)) {
            return TCC_Free;
        }
    }
    let mut IsInLaneShuffle: bool = false;
    let mut IsSingleElementMask: bool = false;
    if SrcTy.getPrimitiveSizeInBits().operator unsigned long long() > 0 && (SrcTy.getPrimitiveSizeInBits().operator unsigned long long() % 128) == 0 && SrcTy.getScalarSizeInBits() == LT.second.getScalarSizeInBits() && Mask.len == SrcTy.getElementCount().getKnownMinValue() {
        let mut NumLanes: u32 = SrcTy.getPrimitiveSizeInBits().operator unsigned long long() / 128;
        let mut NumEltsPerLane: u32 = Mask.len / NumLanes;
        if (Mask.len % NumLanes) == 0 {
            IsInLaneShuffle = all_of(enumerate(Mask), Closure_6 { Mask: &mut Mask, NumEltsPerLane: &mut NumEltsPerLane });
            IsSingleElementMask = (Mask.len - 1) == count_if(Mask, Closure_7 {}) as u32;
        }
    }
    if LT.second.isVectorOf(bf16) {
        LT.second = LT.second.changeVectorElementType(f16);
    }
    if Kind == SK_ExtractSubvector && LT.second.isVector() {
        let mut NumElts: i32 = LT.second.getVectorNumElements();
        if (Index % NumElts) == 0 {
            return TCC_Free;
        }
        let mut SubLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(SubTp);
        if SubLT.second.isVector() {
            let mut NumSubElts: i32 = SubLT.second.getVectorNumElements();
            if (Index % NumSubElts) == 0 && (NumElts % NumSubElts) == 0 {
                return SubLT.first;
            }
            let mut OrigSubElts: i32 = cast(SubTp).getNumElements();
            if NumSubElts > OrigSubElts && (Index % OrigSubElts) == 0 && (NumSubElts % OrigSubElts) == 0 && LT.second.getVectorElementType() == SubLT.second.getVectorElementType() && LT.second.getVectorElementType().getSizeInBits() == SrcTy.getElementType().getPrimitiveSizeInBits() {
                assert!(NumElts >= NumSubElts && NumElts > OrigSubElts, "Unexpected number of elements!");
                let mut VecTy: *mut FixedVectorType = get(SrcTy.getElementType(), LT.second.getVectorNumElements());
                let mut SubTy: *mut FixedVectorType = get(SrcTy.getElementType(), SubLT.second.getVectorNumElements());
                let mut ExtractIndex: i32 = alignDown((Index % NumElts), NumSubElts, 0);
                let mut ExtractCost: InstructionCost = self.getShuffleCost(SK_ExtractSubvector, VecTy, VecTy, CostKind, ArrayRef<int> {}, ExtractIndex, SubTy, ArrayRef<const Value *> {}, null, None);
                if SubTp.getPrimitiveSizeInBits().operator unsigned long long() >= 32 || self.ST.hasSSSE3() {
                    return ExtractCost + 1;
                }
                assert!(SubTp.getPrimitiveSizeInBits().operator unsigned long long() == 16, "Unexpected vector size");
                return ExtractCost + 2;
            }
        }
        Kind = SK_PermuteSingleSrc;
    }
    if Kind == SK_InsertSubvector && LT.second.isVector() {
        let mut DstLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(DstTy);
        let mut NumElts: i32 = DstLT.second.getVectorNumElements();
        let mut SubLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(SubTp);
        if SubLT.second.isVector() {
