        let mut CurrNumEltPerOp: i32 = (8 * CurrOpSizeBytes) / EltTyBits;
        assert!(CurrOpSizeBytes > 0 && CurrNumEltPerOp > 0, "How'd we get here?");
        assert!((((NumEltRemaining * EltTyBits) < (2 * 8 * CurrOpSizeBytes)) || (CurrOpSizeBytes == MaxLegalOpSizeBytes)), "Unless we haven't halved the op size yet, we have less than two op's sized units of work left.");
        let mut CurrVecTy: *mut auto = if CurrNumEltPerOp > NumEltPerXMM { get(EltTy, CurrNumEltPerOp) } else {  };
        (((operator!(operator!((CurrVecTy()() % CurrNumEltPerOp == 0 && "After halving sizes, the vector elt count is no longer a multiple of number of elements per operation?")))) || (_wassert(L"CurrVecTy->getNumElements() % CurrNumEltPerOp == 0 && \"After halving sizes, the vector elt count is no longer a multiple \" \"of number of elements per operation?\"", L"llvm\\lib\\Target\\X86\\X86TargetTransformInfo.cpp", (5903) as u32) , 0)) as void);
        let mut CoalescedVecTy: *mut auto = if CurrNumEltPerOp == 1 {  } else { get(get(Src.getContext(), EltTyBits * CurrNumEltPerOp), () / CurrNumEltPerOp) };
        while NumEltRemaining > 0 {
            assert!(SubVecEltsLeft >= 0, "Subreg element count overconsumtion?");
            if NumEltRemaining < CurrNumEltPerOp && (!IsLoad || Alignment < CurrOpSizeBytes) && CurrOpSizeBytes != 1 {
                break;
            }
            let mut Is0thSubVec: bool = (NumEltDone() % ()) == 0;
            let mut FoldedInLaneInsert: bool = IsLoad && !Is0thSubVec && ((CurrOpSizeBytes == 1 && self.ST.hasSSE41()) || (CurrOpSizeBytes == 2 && self.ST.hasSSE2()) || (CurrOpSizeBytes == 4 && self.ST.hasSSE41()));
            if CurrOpSizeBytes == 32 && self.ST() {
                operator(Cost, 2);
            } else if CurrOpSizeBytes < 4 && !FoldedInLaneInsert {
