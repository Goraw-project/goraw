            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * operator(KindCost);
        }
    }
    let mut X86CostTbl: [14]CostKindTblEntry = [CostKindTblEntry { ADD, i8, 1, ~0, ~0, ~0 }, CostKindTblEntry { ADD, i16, 1, ~0, ~0, ~0 }, CostKindTblEntry { ADD, i32, 1, ~0, ~0, ~0 }, CostKindTblEntry { SUB, i8, 1, ~0, ~0, ~0 }, CostKindTblEntry { SUB, i16, 1, ~0, ~0, ~0 }, CostKindTblEntry { SUB, i32, 1, ~0, ~0, ~0 }, CostKindTblEntry { MUL, i8, 3, 4, 1, 1 }, CostKindTblEntry { MUL, i16, 2, 4, 1, 1 }, CostKindTblEntry { MUL, i32, 1, 4, 1, 1 }, CostKindTblEntry { FNEG, f64, 2, 2, 1, 3 }, CostKindTblEntry { FADD, f64, 2, 3, 1, 1 }, CostKindTblEntry { FSUB, f64, 2, 3, 1, 1 }, CostKindTblEntry { FMUL, f64, 2, 5, 1, 1 }, CostKindTblEntry { FDIV, f64, 38, 38, 1, 1 }];
    if CostTableLookup(X86CostTbl, ISD, LT.second) {
        Entry;
    } else if Entry.Cost[CostKind] {
        KindCost;
