        if  {
            if  {
                return  * operator*();
            }
        }
    }
    if self.ST.hasAVX512() {
        if  {
            if  {
                return  * operator*();
            }
        }
    }
}

fn X86TTIImpl::getMaskedMemoryOpCost(self: *X86TTIImpl, MICA: *MemIntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    let mut Opcode: u32 = if MICA.getID() == masked_load { Load } else { Store };
    let mut SrcTy: *mut Type = MICA.getDataType();
    let mut Alignment: Align = MICA.getAlignment();
    let mut AddressSpace: u32 = MICA.getAddressSpace();
    let mut IsLoad: bool = (Load == Opcode);
    let mut IsStore: bool = (Store == Opcode);
    let mut SrcVTy: *mut auto = dyn_cast(SrcTy);
    if operator!() {
        return self.getMemoryOpCost(Opcode, SrcTy, Alignment, AddressSpace, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
