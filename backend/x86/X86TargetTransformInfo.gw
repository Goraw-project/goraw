struct CostKindCosts {
    RecipThroughputCost: u32,
    LatencyCost: u32,
    CodeSizeCost: u32,
    SizeAndLatencyCost: u32,
}

fn CostKindCosts::operator[](self: *CostKindCosts, Kind: TargetCostKind) -> optional<unsigned int> {
    let mut Cost: u32 = ~0;
    match Kind {
        TCK_RecipThroughput => {
            Cost = self.RecipThroughputCost;
        },
        TCK_Latency => {
            Cost = self.LatencyCost;
        },
        TCK_CodeSize => {
            Cost = self.CodeSizeCost;
        },
        TCK_SizeAndLatency => {
            Cost = self.SizeAndLatencyCost;
        },
    }
    if Cost == ~0 {
        return nullopt;
    }
    return Cost;
}

fn X86TTIImpl::getPopcntSupport(self: *X86TTIImpl, TyWidth: u32) -> PopcntSupportKind {
    assert!(isPowerOf2_32(TyWidth), "Ty width must be power of 2");
    return if self.ST.hasPOPCNT() { PSK_FastHardware } else { PSK_Software };
}

fn X86TTIImpl::getCacheSize(self: *X86TTIImpl, Level: CacheLevel) -> optional<unsigned int> {
    match Level {
        L1D => {
            return 32 * 1024;
        },
        L2D => {
            return 256 * 1024;
        },
    }
    llvm_unreachable_internal("Unknown TargetTransformInfo::CacheLevel", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86TargetTransformInfo.cpp", 141);
}

fn X86TTIImpl::getCacheAssociativity(self: *X86TTIImpl, Level: CacheLevel) -> optional<unsigned int> {
    match Level {
        L1D => {
            
        },
        L2D => {
            return 8;
        },
    }
    llvm_unreachable_internal("Unknown TargetTransformInfo::CacheLevel", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86TargetTransformInfo.cpp", 162);
}

enum ClassIDEnum {
    GPRClass = 0,
    VectorClass = 1,
    ScalarFPClass = 2,
}

fn X86TTIImpl::getRegisterClassForType(self: *X86TTIImpl, Vector: bool, Ty: *mut Type) -> u32 {
    return if Vector { VectorClass } else { if Ty && Ty.isFloatingPointTy() { ScalarFPClass } else { GPRClass } };
}

fn X86TTIImpl::getNumberOfRegisters(self: *X86TTIImpl, ClassID: u32) -> u32 {
    if ClassID == VectorClass && !self.ST.hasSSE1() {
        return 0;
    }
    if !self.ST.is64Bit() {
        return 8;
    }
    if (ClassID == GPRClass && self.ST.hasEGPR()) || (ClassID != GPRClass && self.ST.hasAVX512()) {
        return 32;
    }
    return 16;
}

fn X86TTIImpl::hasConditionalLoadStoreForType(self: *X86TTIImpl, Ty: *mut Type, IsStore: bool) -> bool {
    if !self.ST.hasCF() {
        return false;
    }
    if !Ty {
        return true;
    }
    let mut VTy: *mut FixedVectorType = dyn_cast(Ty);
    if !Ty.isIntegerTy() && (!VTy || VTy.getNumElements() != 1) {
        return false;
    }
    let mut ScalarTy: *mut Type = Ty.getScalarType();
    match cast(ScalarTy).getBitWidth() {
        _ => {
            return false;
        },
        16 => {
            32;
        },
    }
}

fn X86TTIImpl::getRegisterBitWidth(self: *X86TTIImpl, K: RegisterKind) -> TypeSize {
    let mut PreferVectorWidth: u32 = self.ST.getPreferVectorWidth();
    match K {
        RGK_Scalar => {
            return getFixed(if self.ST.is64Bit() { 64 } else { 32 });
        },
        RGK_FixedWidthVector => {
            if self.ST.hasAVX512() && PreferVectorWidth >= 512 {
                return getFixed(512);
            }
        },
        RGK_ScalableVector => {
            return getScalable(0);
        },
    }
    llvm_unreachable_internal("Unsupported register kind", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86TargetTransformInfo.cpp", 228);
}

fn X86TTIImpl::getLoadStoreVecRegBitWidth(self: *X86TTIImpl, arg: u32) -> u32 {
    return self.getRegisterBitWidth(RGK_FixedWidthVector).getFixedValue();
}

fn X86TTIImpl::getMaxInterleaveFactor(self: *X86TTIImpl, VF: ElementCount, HasUnorderedReductions: bool) -> u32 {
    if VF.isScalar() {
        return 1;
    }
    if self.ST.isAtom() {
        return 1;
    }
    if self.ST.hasAVX() {
        return 4;
    }
    return 2;
}

fn X86TTIImpl::getArithmeticInstrCost(self: *X86TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Op1Info: OperandValueInfo, Op2Info: OperandValueInfo, Args: ArrayRef<const Value *>, CtxI: *Instruction) -> InstructionCost {
    if Opcode == Mul && Ty.isVectorTy() && Ty.getPrimitiveSizeInBits().operator unsigned long long() <= 64 && Ty.getScalarSizeInBits() == 8 {
        let mut WideVecTy: *mut Type = getExtendedElementVectorType(cast(Ty));
        return self.getCastInstrCost(ZExt, WideVecTy, Ty, None, CostKind, null) + self.getCastInstrCost(Trunc, Ty, WideVecTy, None, CostKind, null) + self.getArithmeticInstrCost(Opcode, WideVecTy, CostKind, Op1Info, Op2Info, ArrayRef<const Value *> {}, null);
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Ty);
    let mut ISD: i32 = self.TLI.InstructionOpcodeToISD(Opcode);
    assert!(ISD, "Invalid opcode");
    if ISD == MUL && Args.len == 2 && LT.second.isVector() && (LT.second.getScalarType() == i32 || LT.second.getScalarType() == i64) {
        let mut Op1Signed: bool = false;
        let mut Op2Signed: bool = false;
        let mut Op1MinSize: u32 = self.minRequiredElementSize(Args[0], Op1Signed);
        let mut Op2MinSize: u32 = self.minRequiredElementSize(Args[1], Op2Signed);
        let mut OpMinSize: u32 = if Op1MinSize > Op2MinSize { Op1MinSize } else { Op2MinSize };
        let mut SignedMode: bool = Op1Signed || Op2Signed;
        if OpMinSize <= 15 && !self.ST.isPMADDWDSlow() && LT.second.getScalarType() == i32 {
            let mut Op1Constant: bool = isa(Args[0]) || isa(Args[0]);
            let mut Op2Constant: bool = isa(Args[1]) || isa(Args[1]);
            let mut Op1Sext: bool = isa(Args[0]) && (Op1MinSize == 15 || (Op1MinSize < 15 && !self.ST.hasSSE41()));
            let mut Op2Sext: bool = isa(Args[1]) && (Op2MinSize == 15 || (Op2MinSize < 15 && !self.ST.hasSSE41()));
            let mut IsZeroExtended: bool = !Op1Signed || !Op2Signed;
            let mut IsConstant: bool = Op1Constant || Op2Constant;
            let mut IsSext: bool = Op1Sext || Op2Sext;
            if IsConstant || IsZeroExtended || IsSext {
                LT.second = getVectorVT(i16, 2 * LT.second.getVectorNumElements());
            }
        }
        if self.ST.useSLMArithCosts() && LT.second == v4i32 {
            if OpMinSize <= 7 {
                return LT.first * 3;
            }
            if !SignedMode && OpMinSize <= 8 {
                return LT.first * 3;
            }
            if OpMinSize <= 15 {
                return LT.first * 5;
            }
            if !SignedMode && OpMinSize <= 16 {
                return LT.first * 5;
            }
        }
        if !SignedMode && OpMinSize <= 32 && LT.second.getScalarType() == i64 {
            ISD = PMULUDQ;
        }
    }
    if ISD == MUL && Op2Info.isConstant() && (Op2Info.isPowerOf2() || Op2Info.isNegatedPowerOf2()) {
        let mut Cost: InstructionCost = self.getArithmeticInstrCost(Shl, Ty, CostKind, Op1Info.getNoProps(), Op2Info.getNoProps(), ArrayRef<const Value *> {}, null);
        if Op2Info.isNegatedPowerOf2() {
            operator(Cost, self.getArithmeticInstrCost(Sub, Ty, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null));
        }
        return Cost;
    }
    if (ISD == SDIV || ISD == SREM) && Op2Info.isConstant() && Op2Info.isPowerOf2() {
        let mut Cost: InstructionCost = 2 * self.getArithmeticInstrCost(AShr, Ty, CostKind, Op1Info.getNoProps(), Op2Info.getNoProps(), ArrayRef<const Value *> {}, null);
        operator(Cost, self.getArithmeticInstrCost(LShr, Ty, CostKind, Op1Info.getNoProps(), Op2Info.getNoProps(), ArrayRef<const Value *> {}, null));
        operator(Cost, self.getArithmeticInstrCost(Add, Ty, CostKind, Op1Info.getNoProps(), Op2Info.getNoProps(), ArrayRef<const Value *> {}, null));
        if ISD == SREM {
            operator(Cost, self.getArithmeticInstrCost(Mul, Ty, CostKind, Op1Info.getNoProps(), Op2Info.getNoProps(), ArrayRef<const Value *> {}, null));
            operator(Cost, self.getArithmeticInstrCost(Sub, Ty, CostKind, Op1Info.getNoProps(), Op2Info.getNoProps(), ArrayRef<const Value *> {}, null));
        }
        return Cost;
    }
    if (ISD == UDIV || ISD == UREM) && Op2Info.isConstant() && Op2Info.isPowerOf2() {
        if ISD == UDIV {
            return self.getArithmeticInstrCost(LShr, Ty, CostKind, Op1Info.getNoProps(), Op2Info.getNoProps(), ArrayRef<const Value *> {}, null);
        }
        return self.getArithmeticInstrCost(And, Ty, CostKind, Op1Info.getNoProps(), Op2Info.getNoProps(), ArrayRef<const Value *> {}, null);
    }
    if !Ty.isVectorTy() && Op2Info.isConstant() && !Op2Info.isNegatedPowerOf2() && (ISD == UDIV || ISD == SDIV || ISD == UREM || ISD == SREM) {
        let mut Cost: u32 = if ISD == UREM || ISD == SREM { 6 } else { 5 };
        if CostKind == TCK_CodeSize || CostKind == TCK_SizeAndLatency {
            Cost += 2;
        }
        return LT.first * Cost;
    }
    let mut GFNIUniformConstCostTable: [9]CostKindTblEntry = [CostKindTblEntry { SHL, v16i8, 1, 6, 1, 2 }, CostKindTblEntry { SRL, v16i8, 1, 6, 1, 2 }, CostKindTblEntry { SRA, v16i8, 1, 6, 1, 2 }, CostKindTblEntry { SHL, v32i8, 1, 6, 1, 2 }, CostKindTblEntry { SRL, v32i8, 1, 6, 1, 2 }, CostKindTblEntry { SRA, v32i8, 1, 6, 1, 2 }, CostKindTblEntry { SHL, v64i8, 1, 6, 1, 2 }, CostKindTblEntry { SRL, v64i8, 1, 6, 1, 2 }, CostKindTblEntry { SRA, v64i8, 1, 6, 1, 2 }];
    if Op2Info.isUniform() && Op2Info.isConstant() && self.ST.hasGFNI() {
        if CostTableLookup(GFNIUniformConstCostTable, ISD, LT.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * operator(KindCost);
        }
    }
    let mut AVX512BWUniformConstCostTable: [15]CostKindTblEntry = [CostKindTblEntry { SHL, v16i8, 1, 7, 2, 3 }, CostKindTblEntry { SRL, v16i8, 1, 7, 2, 3 }, CostKindTblEntry { SRA, v16i8, 1, 8, 4, 5 }, CostKindTblEntry { SHL, v32i8, 1, 8, 2, 3 }, CostKindTblEntry { SRL, v32i8, 1, 8, 2, 3 }, CostKindTblEntry { SRA, v32i8, 1, 9, 4, 5 }, CostKindTblEntry { SHL, v64i8, 1, 8, 2, 3 }, CostKindTblEntry { SRL, v64i8, 1, 8, 2, 3 }, CostKindTblEntry { SRA, v64i8, 1, 9, 4, 6 }, CostKindTblEntry { SHL, v16i16, 1, 1, 1, 1 }, CostKindTblEntry { SRL, v16i16, 1, 1, 1, 1 }, CostKindTblEntry { SRA, v16i16, 1, 1, 1, 1 }, CostKindTblEntry { SHL, v32i16, 1, 1, 1, 1 }, CostKindTblEntry { SRL, v32i16, 1, 1, 1, 1 }, CostKindTblEntry { SRA, v32i16, 1, 1, 1, 1 }];
