fn X86TTIImpl::getPartialReductionCost(self: *X86TTIImpl, Opcode: u32, InputTypeA: *mut Type, InputTypeB: *mut Type, AccumType: *mut Type, VF: ElementCount, OpAExtend: PartialReductionExtendKind, OpBExtend: PartialReductionExtendKind, BinOp: optional<unsigned int>, CostKind: TargetCostKind, FMF: optional<FastMathFlags>) -> InstructionCost {
    let mut ExpandCost: Closure_19 = Closure_19 { Opcode: &mut Opcode, InputTypeA: &mut InputTypeA, InputTypeB: &mut InputTypeB, AccumType: &mut AccumType, VF: &mut VF, OpAExtend: &mut OpAExtend, OpBExtend: &mut OpBExtend, BinOp: &mut BinOp, CostKind: &mut CostKind };
    if VF.isScalable() || !BinOp || OpAExtend == PR_None || OpBExtend == PR_None || InputTypeA != InputTypeB {
        return ExpandCost.call();
    }
    let mut Opc: u32 = 0;
    if Opcode == Add && operator(BinOp) == Mul && AccumType.isIntegerTy(32) && (InputTypeA.isIntegerTy(8) || InputTypeA.isIntegerTy(16)) {
        if OpAExtend != OpBExtend {
            Opc = PARTIAL_REDUCE_SUMLA;
        } else if OpAExtend == PR_SignExtend {
            Opc = PARTIAL_REDUCE_SMLA;
        } else {
            Opc = PARTIAL_REDUCE_UMLA;
        }
    } else if Opcode == FAdd && operator(BinOp) == FMul && AccumType.isFloatTy() && (InputTypeA.isBFloatTy() || InputTypeA.isHalfTy()) {
        if operator!() || operator!() || operator!() {
            return getInvalid(0);
        }
        Opc = PARTIAL_REDUCE_FMLA;
    } else {
        return ExpandCost.call();
    }
    let mut Ratio: u32 = AccumType.getScalarSizeInBits() / InputTypeA.getScalarSizeInBits();
    if !VF.isKnownMultipleOf(Ratio) {
        return ExpandCost.call();
    }
    let mut AccVecTy: *mut VectorType = get(AccumType, VF.divideCoefficientBy(Ratio));
    let mut InputVecTy: *mut VectorType = get(InputTypeA, VF);
    let mut AccLT: pair<InstructionCost, MVT> = zeroed();
    let mut InputLT: pair<InstructionCost, MVT> = zeroed();
    if AccLT()() > AccVecTy.getPrimitiveSizeInBits().getFixedValue() || operator!(self.TLI.isPartialReduceMLALegalOrCustom(Opc)) {
        return ExpandCost.call();
    }
    return ;
}

