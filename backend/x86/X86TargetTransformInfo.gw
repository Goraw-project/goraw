    let mut NumElem: u32 = ();
    let mut MaskTy: *mut auto = get(getInt8Ty(), NumElem);
    if (IsLoad && operator!(self.isLegalMaskedLoad(Alignment, AddressSpace))) || (IsStore && operator!(self.isLegalMaskedStore(Alignment, AddressSpace))) {
        let mut DemandedElts: APInt = getAllOnes(NumElem);
        let mut MaskSplitCost: InstructionCost = self.getScalarizationOverhead(DemandedElts, false, true, CostKind);
        let mut ScalarCompareCost: InstructionCost = self.getCmpSelInstrCost(ICmp, getInt8Ty(), null, BAD_ICMP_PREDICATE, CostKind);
        let mut BranchCost: InstructionCost = self.getCFInstrCost(CondBr, CostKind, null);
        let mut MaskCmpCost: InstructionCost = InstructionCost { NumElem } * (BranchCost + ScalarCompareCost);
        let mut ValueSplitCost: InstructionCost = self.getScalarizationOverhead(DemandedElts, IsLoad, IsStore, CostKind);
        let mut MemopCost: InstructionCost = zeroed();
        return MemopCost + ValueSplitCost + MaskSplitCost + MaskCmpCost;
    }
    let mut LT: pair<InstructionCost, MVT> = zeroed();
    let mut VT: auto = self.TLI.getValueType;
    let mut Cost: InstructionCost = InstructionCost { 0 };
    let mut Ty: MVT = ;
    if Ty == i16 || Ty == i32 || Ty == i64 {
        return Cost + ;
    }
    if VT()() && Ty != () && () == NumElem {
        operator+=(Cost, self.getShuffleCost(SK_PermuteTwoSrc, CostKind, void {}, 0, null) + self.getShuffleCost(SK_PermuteTwoSrc, CostKind, void {}, 0, null));
    } else if LT() * Ty.getVectorNumElements() > NumElem {
        let mut NewMaskTy: *mut auto = get(() as u32 * Ty.getVectorNumElements());
        operator+=(Cost, self.getShuffleCost(SK_InsertSubvector, CostKind, void {}, 0));
    }
    if !self.ST.hasAVX512() {
        return Cost +  * (if IsLoad { 2 } else { 8 });
    }
    return Cost + ;
}

