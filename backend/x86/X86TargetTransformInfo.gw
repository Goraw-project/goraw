    let mut AVX2UniformConstCostTable: [30]CostKindTblEntry = [CostKindTblEntry { SHL, v16i8, 1, 8, 2, 3 }, CostKindTblEntry { SRL, v16i8, 1, 8, 2, 3 }, CostKindTblEntry { SRA, v16i8, 2, 10, 5, 6 }, CostKindTblEntry { SHL, v32i8, 2, 8, 2, 4 }, CostKindTblEntry { SRL, v32i8, 2, 8, 2, 4 }, CostKindTblEntry { SRA, v32i8, 3, 10, 5, 9 }, CostKindTblEntry { SHL, v8i16, 1, 1, 1, 1 }, CostKindTblEntry { SRL, v8i16, 1, 1, 1, 1 }, CostKindTblEntry { SRA, v8i16, 1, 1, 1, 1 }, CostKindTblEntry { SHL, v16i16, 2, 2, 1, 2 }, CostKindTblEntry { SRL, v16i16, 2, 2, 1, 2 }, CostKindTblEntry { SRA, v16i16, 2, 2, 1, 2 }, CostKindTblEntry { SHL, v4i32, 1, 1, 1, 1 }, CostKindTblEntry { SRL, v4i32, 1, 1, 1, 1 }, CostKindTblEntry { SRA, v4i32, 1, 1, 1, 1 }, CostKindTblEntry { SHL, v8i32, 2, 2, 1, 2 }, CostKindTblEntry { SRL, v8i32, 2, 2, 1, 2 }, CostKindTblEntry { SRA, v8i32, 2, 2, 1, 2 }, CostKindTblEntry { SHL, v2i64, 1, 1, 1, 1 }, CostKindTblEntry { SRL, v2i64, 1, 1, 1, 1 }, CostKindTblEntry { SRA, v2i64, 2, 3, 3, 3 }, CostKindTblEntry { SHL, v4i64, 2, 2, 1, 2 }, CostKindTblEntry { SRL, v4i64, 2, 2, 1, 2 }, CostKindTblEntry { SRA, v4i64, 4, 4, 3, 6 }, CostKindTblEntry { SDIV, v8i32, 6, ~0, ~0, ~0 }, CostKindTblEntry { SREM, v8i32, 8, ~0, ~0, ~0 }, CostKindTblEntry { UDIV, v8i32, 5, ~0, ~0, ~0 }, CostKindTblEntry { UREM, v8i32, 7, ~0, ~0, ~0 }, CostKindTblEntry { UDIV, v4i64, 15, ~0, ~0, ~0 }, CostKindTblEntry { UREM, v4i64, 21, ~0, ~0, ~0 }];
