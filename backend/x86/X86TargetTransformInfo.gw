            }
        }
        if self.ST.hasSSE41() {
            if CostTableLookup(SSE41CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
            }
        }
        if self.ST.hasSSSE3() {
            if CostTableLookup(SSSE3CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
            }
        }
        if self.ST.hasSSE2() {
            if CostTableLookup(SSE2CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
            }
        }
        if self.ST.hasSSE1() {
            if CostTableLookup(SSE1CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
            }
        }
        if self.ST.hasBMI() {
            if self.ST.is64Bit() {
                if CostTableLookup(BMI64CostTbl, ISD, MTy) {
                    Entry;
                } else if Entry.Cost[CostKind] {
                    KindCost;
                } else {
                    return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
                }
            }
            if CostTableLookup(BMI32CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
            }
        }
        if self.ST.hasLZCNT() {
            if self.ST.is64Bit() {
                if CostTableLookup(LZCNT64CostTbl, ISD, MTy) {
                    Entry;
                } else if Entry.Cost[CostKind] {
                    KindCost;
                } else {
                    return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
                }
            }
            if CostTableLookup(LZCNT32CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
            }
        }
        if self.ST.hasPOPCNT() {
            if self.ST.is64Bit() {
                if CostTableLookup(POPCNT64CostTbl, ISD, MTy) {
                    Entry;
                } else if Entry.Cost[CostKind] {
                    KindCost;
                } else {
                    return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
                }
            }
            if CostTableLookup(POPCNT32CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
            }
        }
        if self.ST.hasPCLMUL() {
            if CostTableLookup(PCLMULCostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
            }
        }
        if self.ST.is64Bit() {
            if CostTableLookup(X64CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
            }
        }
        if CostTableLookup(X86CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return adjustTableCost.call(Entry.ISD, operator(KindCost), LT, ICA.getFlags());
        }
        if ICA.isTypeBasedOnly() && (IID == fshl || IID == fshr) {
            let mut CondTy: *mut Type = RetTy.getWithNewBitWidth(1);
            let mut Cost: InstructionCost = 0;
            operator(Cost, self.getArithmeticInstrCost(Or, RetTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null));
            operator(Cost, self.getArithmeticInstrCost(Sub, RetTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null));
            operator(Cost, self.getArithmeticInstrCost(Shl, RetTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null));
            operator(Cost, self.getArithmeticInstrCost(LShr, RetTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null));
            operator(Cost, self.getArithmeticInstrCost(And, RetTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null));
            operator(Cost, self.getCmpSelInstrCost(ICmp, RetTy, CondTy, ICMP_EQ, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, null));
            operator(Cost, self.getCmpSelInstrCost(Select, RetTy, CondTy, ICMP_EQ, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, null));
            return Cost;
        }
    }
    return self.getIntrinsicInstrCost(ICA, CostKind);
}

fn X86TTIImpl::getVectorInstrCost(self: *X86TTIImpl, Opcode: u32, Val: *mut Type, CostKind: TargetCostKind, Index: u32, Op0: *Value, Op1: *Value, VIC: VectorInstrContext) -> InstructionCost {
    let mut SLMCostTbl: [4]CostTblEntry = [CostTblEntry { EXTRACT_VECTOR_ELT, i8, 4 }, CostTblEntry { EXTRACT_VECTOR_ELT, i16, 4 }, CostTblEntry { EXTRACT_VECTOR_ELT, i32, 4 }, CostTblEntry { EXTRACT_VECTOR_ELT, i64, 7 }];
    assert!(Val.isVectorTy(), "This must be a vector type");
    let mut VT: *mut VectorType = cast(Val);
    if VT.isScalableTy() {
        return getInvalid(0);
    }
    let mut ScalarType: *mut Type = Val.getScalarType();
    let mut RegisterFileMoveCost: InstructionCost = 0;
    if Index == -1 && (Opcode == ExtractElement || Opcode == InsertElement) {
        assert!(isa(Val), "Fixed vector type expected");
        let mut VecAlign: Align = self.DL.getPrefTypeAlign(Val);
        let mut SclAlign: Align = self.DL.getPrefTypeAlign(ScalarType);
        if Opcode == ExtractElement {
            return self.getMemoryOpCost(Store, Val, VecAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null) + self.getMemoryOpCost(Load, ScalarType, SclAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
        }
        if Opcode == InsertElement {
            return self.getMemoryOpCost(Store, Val, VecAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null) + self.getMemoryOpCost(Store, ScalarType, SclAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null) + self.getMemoryOpCost(Load, Val, VecAlign, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
        }
    }
    if Index != -1 && (Opcode == ExtractElement || Opcode == InsertElement) {
        if Opcode == ExtractElement && ScalarType.getScalarSizeInBits() == 1 && cast(Val).getNumElements() > 1 {
            return 1;
        }
        let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Val);
        if !LT.second.isVector() {
            return TCC_Free;
        }
        let mut SizeInBits: u32 = LT.second.getSizeInBits().operator unsigned long long();
        let mut NumElts: u32 = LT.second.getVectorNumElements();
        let mut SubNumElts: u32 = NumElts;
        Index = Index % NumElts;
        if SizeInBits > 128 {
            assert!((SizeInBits % 128) == 0, "Illegal vector");
            let mut NumSubVecs: u32 = SizeInBits / 128;
            SubNumElts = NumElts / NumSubVecs;
            if SubNumElts <= Index {
                operator(RegisterFileMoveCost, (if Opcode == InsertElement { 2 } else { 1 }));
                Index %= SubNumElts;
            }
        }
        let mut MScalarTy: MVT = LT.second.getScalarType();
        let mut IsCheapPInsrPExtrInsertPS: Closure_15 = Closure_15 { MScalarTy: &mut MScalarTy, cap_1: self, Index: &mut Index, Opcode: &mut Opcode };
        if Index == 0 {
            if ScalarType.isFloatingPointTy() && (Opcode != InsertElement || !Op0 || isa(Op0)) {
                return RegisterFileMoveCost;
            }
            if Opcode == InsertElement && isa_and_nonnull(Op0) {
                if isa_and_nonnull(Op1) {
                    return RegisterFileMoveCost;
                }
                if !IsCheapPInsrPExtrInsertPS.call() {
                    if isa_and_nonnull(Op1) && Op1.getType().isIntegerTy() {
                        return 2 + RegisterFileMoveCost;
                    }
                    return 1 + RegisterFileMoveCost;
                }
            }
            if ScalarType.isIntegerTy() && Opcode == ExtractElement {
                return 1 + RegisterFileMoveCost;
            }
        }
        let mut ISD: i32 = self.TLI.InstructionOpcodeToISD(Opcode);
        assert!(ISD, "Unexpected vector opcode");
        if self.ST.useSLMArithCosts() {
            if CostTableLookup(SLMCostTbl, ISD, MScalarTy) {
                Entry;
            } else {
                return Entry.Cost + RegisterFileMoveCost;
            }
        }
        if IsCheapPInsrPExtrInsertPS.call() {
            return 1 + RegisterFileMoveCost;
        }
        let mut ShuffleCost: InstructionCost = 1;
        if Opcode == InsertElement {
            let mut SubTy: *mut VectorType = cast(Val);
            let mut VT: EVT = self.TLI.getValueType(self.DL, Val, false);
            if VT.getScalarType() != MScalarTy || VT.getSizeInBits().operator unsigned long long() >= 128 {
                SubTy = get(ScalarType, SubNumElts);
            }
            ShuffleCost = self.getShuffleCost(SK_PermuteTwoSrc, SubTy, SubTy, CostKind, ArrayRef<int> {}, 0, SubTy, ArrayRef<const Value *> {}, null, None);
        }
        let mut IntOrFpCost: i32 = if ScalarType.isFloatingPointTy() { 0 } else { 1 };
        return ShuffleCost + IntOrFpCost + RegisterFileMoveCost;
    }
    return self.getVectorInstrCost(Opcode, Val, CostKind, Index, Op0, Op1, VIC) + RegisterFileMoveCost;
}

fn X86TTIImpl::getScalarizationOverhead(self: *X86TTIImpl, Ty: *mut VectorType, DemandedElts: *APInt, Insert: bool, Extract: bool, CostKind: TargetCostKind, ForPoisonSrc: bool, VL: ArrayRef<Value *>, VIC: VectorInstrContext) -> InstructionCost {
    assert!(DemandedElts.getBitWidth() == cast(Ty).getNumElements(), "Vector size mismatch");
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Ty);
    let mut MScalarTy: MVT = LT.second.getScalarType();
    let mut LegalVectorBitWidth: u32 = LT.second.getSizeInBits().operator unsigned long long();
    let mut Cost: InstructionCost = 0;
    let mut LaneBitWidth: u32 = 128;
    assert!((LegalVectorBitWidth < LaneBitWidth || (LegalVectorBitWidth % LaneBitWidth) == 0), "Illegal vector");
    let mut NumLegalVectors: i32 = LT.first.getValue();
    assert!(NumLegalVectors >= 0, "Negative cost!");
    if Insert && !ForPoisonSrc {
        for I in seq(DemandedElts.getBitWidth()) {
            if !DemandedElts[I] {
                continue;
            }
            operator(Cost, self.getVectorInstrCost(InsertElement, Ty, CostKind, I, getNullValue(Ty), if VL.is_empty() { null } else { VL[I] }, None));
        }
        return Cost;
    }
    if Insert {
        if (MScalarTy == i16 && self.ST.hasSSE2()) || (MScalarTy.isInteger() && self.ST.hasSSE41()) || (MScalarTy == f32 && self.ST.hasSSE41()) {
            if LegalVectorBitWidth <= LaneBitWidth {
                operator(Cost, self.getScalarizationOverhead(Ty, DemandedElts, Insert, false, CostKind, true, ArrayRef<Value *> {}, None));
            } else {
                assert!((LegalVectorBitWidth % LaneBitWidth) == 0, "Illegal vector");
                let mut NumLegalLanes: u32 = LegalVectorBitWidth / LaneBitWidth;
                let mut NumLanesTotal: u32 = NumLegalLanes * NumLegalVectors;
                let mut NumLegalElts: u32 = LT.second.getVectorNumElements() * NumLegalVectors;
                assert!(NumLegalElts >= DemandedElts.getBitWidth(), "Vector has been legalized to smaller element count");
                assert!((NumLegalElts % NumLanesTotal) == 0, "Unexpected elts per lane");
                let mut NumEltsPerLane: u32 = NumLegalElts / NumLanesTotal;
                let mut WidenedDemandedElts: APInt = DemandedElts.zext(NumLegalElts);
                let mut LaneTy: *mut FixedVectorType = get(Ty.getElementType(), NumEltsPerLane);
                for let mut I: u32 = 0; I != NumLanesTotal; I += 1 {
                    let mut LaneEltMask: APInt = WidenedDemandedElts.extractBits(NumEltsPerLane, NumEltsPerLane * I);
                    if LaneEltMask.isZero() {
                        continue;
                    }
                    if !LaneEltMask.isAllOnes() {
                        operator(Cost, self.getShuffleCost(SK_ExtractSubvector, Ty, Ty, CostKind, ArrayRef<int> {}, I * NumEltsPerLane, LaneTy, ArrayRef<const Value *> {}, null, None));
                    }
                    operator(Cost, self.getScalarizationOverhead(LaneTy, LaneEltMask, Insert, false, CostKind, true, ArrayRef<Value *> {}, None));
                }
                let mut AffectedLanes: APInt = ScaleBitMask(WidenedDemandedElts, NumLanesTotal, false);
                let mut FullyAffectedLegalVectors: APInt = ScaleBitMask(AffectedLanes, NumLegalVectors, true);
                for let mut LegalVec: i32 = 0; LegalVec != NumLegalVectors; LegalVec += 1 {
                    for let mut Lane: u32 = 0; Lane != NumLegalLanes; Lane += 1 {
                        let mut I: u32 = NumLegalLanes * LegalVec + Lane;
                        if !AffectedLanes[I] || (Lane == 0 && FullyAffectedLegalVectors[LegalVec]) {
                            continue;
                        }
                        operator(Cost, self.getShuffleCost(SK_InsertSubvector, Ty, Ty, CostKind, ArrayRef<int> {}, I * NumEltsPerLane, LaneTy, ArrayRef<const Value *> {}, null, None));
                    }
                }
            }
        } else if LT.second.isVector() {
            if Ty.isIntOrIntVectorTy() {
                operator(Cost, DemandedElts.popcount());
            }
            let mut NumElts: u32 = LT.second.getVectorNumElements();
            let mut Pow2Elts: u32 = PowerOf2Ceil(cast(Ty).getNumElements());
            operator(Cost, (if NumElts < Pow2Elts { NumElts } else { Pow2Elts } - 1) * LT.first);
        }
    }
    if Extract {
        if !Insert && Ty.getScalarSizeInBits() == 1 && !self.ST.hasAVX512() {
            let mut NumElts: u32 = cast(Ty).getNumElements();
            let mut MaxElts: u32 = if self.ST.hasAVX2() { 32 } else { 16 };
            let mut MOVMSKCost: u32 = (NumElts + MaxElts - 1) / MaxElts;
            return MOVMSKCost;
        }
        if LT.second.isVector() {
            let mut NumLegalElts: u32 = LT.second.getVectorNumElements() * NumLegalVectors;
            assert!(NumLegalElts >= DemandedElts.getBitWidth(), "Vector has been legalized to smaller element count");
            if LegalVectorBitWidth > LaneBitWidth {
                let mut NumLegalLanes: u32 = LegalVectorBitWidth / LaneBitWidth;
                let mut NumLanesTotal: u32 = NumLegalLanes * NumLegalVectors;
                assert!((NumLegalElts % NumLanesTotal) == 0, "Unexpected elts per lane");
                let mut NumEltsPerLane: u32 = NumLegalElts / NumLanesTotal;
                let mut WidenedDemandedElts: APInt = DemandedElts.zext(NumLegalElts);
                let mut LaneTy: *mut FixedVectorType = get(Ty.getElementType(), NumEltsPerLane);
                for let mut I: u32 = 0; I != NumLanesTotal; I += 1 {
                    let mut LaneEltMask: APInt = WidenedDemandedElts.extractBits(NumEltsPerLane, I * NumEltsPerLane);
                    if LaneEltMask.isZero() {
                        continue;
                    }
                    operator(Cost, self.getShuffleCost(SK_ExtractSubvector, Ty, Ty, CostKind, ArrayRef<int> {}, I * NumEltsPerLane, LaneTy, ArrayRef<const Value *> {}, null, None));
                    operator(Cost, self.getScalarizationOverhead(LaneTy, LaneEltMask, false, Extract, CostKind, true, ArrayRef<Value *> {}, None));
                }
                return Cost;
            }
        }
        operator(Cost, self.getScalarizationOverhead(Ty, DemandedElts, false, Extract, CostKind, true, ArrayRef<Value *> {}, None));
    }
    return Cost;
}

fn X86TTIImpl::getReplicationShuffleCost(self: *X86TTIImpl, EltTy: *mut Type, ReplicationFactor: i32, VF: i32, DemandedDstElts: *APInt, CostKind: TargetCostKind) -> InstructionCost {
    let mut EltTyBits: u32 = self.DL.getTypeSizeInBits(EltTy).operator unsigned long long();
    EltTy = getIntNTy(EltTy.getContext(), EltTyBits);
    let mut bailout: Closure_16 = Closure_16 { cap_0: self, EltTy: &mut EltTy, ReplicationFactor: &mut ReplicationFactor, VF: &mut VF, DemandedDstElts: &mut DemandedDstElts, CostKind: &mut CostKind };
    if !self.ST.hasAVX512() {
        return bailout.call();
    }
    let mut PromEltTyBits: u32 = EltTyBits;
    match EltTyBits {
        32 => {
            64;
        },
        16 => {
            if !self.ST.hasBWI() {
                PromEltTyBits = 32;
            }
        },
        8 => {
            if !self.ST.hasVBMI() {
                PromEltTyBits = 32;
            }
        },
        1 => {
            if self.ST.hasBWI() {
                if self.ST.hasVBMI() {
                    PromEltTyBits = 8;
                } else {
                    PromEltTyBits = 16;
                }
                break;
            }
        },
        _ => {
            return bailout.call();
        },
    }
    let mut PromEltTy: *mut IntegerType = getIntNTy(EltTy.getContext(), PromEltTyBits);
    let mut SrcVecTy: *mut FixedVectorType = get(EltTy, VF);
    let mut PromSrcVecTy: *mut FixedVectorType = get(PromEltTy, VF);
    let mut NumDstElements: i32 = VF * ReplicationFactor;
    let mut PromDstVecTy: *mut FixedVectorType = get(PromEltTy, NumDstElements);
    let mut DstVecTy: *mut FixedVectorType = get(EltTy, NumDstElements);
    let mut LegalSrcVecTy: MVT = self.getTypeLegalizationCost(SrcVecTy).second;
    let mut LegalPromSrcVecTy: MVT = self.getTypeLegalizationCost(PromSrcVecTy).second;
    let mut LegalPromDstVecTy: MVT = self.getTypeLegalizationCost(PromDstVecTy).second;
    let mut LegalDstVecTy: MVT = self.getTypeLegalizationCost(DstVecTy).second;
    if !LegalSrcVecTy.isVector() || !LegalPromSrcVecTy.isVector() || !LegalPromDstVecTy.isVector() || !LegalDstVecTy.isVector() {
        return bailout.call();
    }
    if PromEltTyBits != EltTyBits {
        let mut PromotionCost: InstructionCost = InstructionCost {};
        operator(PromotionCost, self.getCastInstrCost(SExt, PromSrcVecTy, SrcVecTy, None, CostKind, null));
        operator(PromotionCost, self.getCastInstrCost(Trunc, DstVecTy, PromDstVecTy, None, CostKind, null));
        return PromotionCost + self.getReplicationShuffleCost(PromEltTy, ReplicationFactor, VF, DemandedDstElts, CostKind);
    }
    assert!(LegalSrcVecTy.getScalarSizeInBits() == EltTyBits && LegalSrcVecTy.getScalarType() == LegalDstVecTy.getScalarType(), "We expect that the legalization doesn't affect the element width, doesn't coalesce/split elements.");
    let mut NumEltsPerDstVec: u32 = LegalDstVecTy.getVectorNumElements();
    let mut NumDstVectors: u32 = divideCeil(DstVecTy.getNumElements(), NumEltsPerDstVec);
    let mut SingleDstVecTy: *mut FixedVectorType = get(EltTy, NumEltsPerDstVec);
    let mut DemandedDstVectors: APInt = ScaleBitMask(DemandedDstElts.zext(NumDstVectors * NumEltsPerDstVec), NumDstVectors, false);
    let mut NumDstVectorsDemanded: u32 = DemandedDstVectors.popcount();
    let mut SingleShuffleCost: InstructionCost = self.getShuffleCost(SK_PermuteSingleSrc, SingleDstVecTy, SingleDstVecTy, CostKind, ArrayRef<int> {}, 0, null, ArrayRef<const Value *> {}, null, None);
    return NumDstVectorsDemanded * SingleShuffleCost;
}

fn X86TTIImpl::getMemoryOpCost(self: *X86TTIImpl, Opcode: u32, Src: *mut Type, Alignment: Align, AddressSpace: u32, CostKind: TargetCostKind, OpInfo: OperandValueInfo, I: *Instruction) -> InstructionCost {
    if Opcode == Load && CostKind == TCK_Latency {
        return self.getMemoryOpCost(Opcode, Src, Alignment, AddressSpace, CostKind, OpInfo, I);
    }
    if CostKind != TCK_RecipThroughput {
        if dyn_cast_or_null(I) {
            SI;
        } else {
            if dyn_cast(SI.getPointerOperand()) {
                GEP;
            } else {
                if !all_of(GEP.indices(), Closure_17 {}) {
                    return TCC_Basic * 2;
                }
            }
        }
        return TCC_Basic;
    }
    assert!((Opcode == Load || Opcode == Store), "Invalid Opcode");
    if self.TLI.getValueType(self.DL, Src, true) == Other {
        return self.getMemoryOpCost(Opcode, Src, Alignment, AddressSpace, CostKind, OpInfo, I);
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Src);
    let mut VTy: *mut FixedVectorType = dyn_cast(Src);
    let mut Cost: InstructionCost = 0;
    if Opcode == Store && OpInfo.isConstant() {
        operator(Cost, self.getMemoryOpCost(Load, Src, self.DL.getABITypeAlign(Src), 0, CostKind, OpInfo, null));
    }
    if !VTy || !LT.second.isVector() {
        return (if LT.second.isFloatingPoint() { Cost } else { 0 }) + LT.first * 1;
    }
    let mut IsLoad: bool = Opcode == Load;
    let mut EltTy: *mut Type = VTy.getElementType();
    let mut EltTyBits: i32 = self.DL.getTypeSizeInBits(EltTy).operator unsigned long long();
    let mut SrcNumElt: u32 = VTy.getNumElements();
    let mut NumEltRemaining: i32 = SrcNumElt;
    let mut NumEltDone: Closure_18 = Closure_18 { SrcNumElt: &mut SrcNumElt, NumEltRemaining: &mut NumEltRemaining };
    let mut MaxLegalOpSizeBytes: i32 = divideCeil(LT.second.getSizeInBits().operator unsigned long long(), 8);
    let mut XMMBits: u32 = 128;
    if XMMBits % EltTyBits != 0 {
        return self.getMemoryOpCost(Opcode, Src, Alignment, AddressSpace, CostKind, OpInfo, I);
    }
    let mut NumEltPerXMM: i32 = XMMBits / EltTyBits;
    let mut XMMVecTy: *mut FixedVectorType = get(EltTy, NumEltPerXMM);
    for let mut CurrOpSizeBytes: i32 = MaxLegalOpSizeBytes;
let mut SubVecEltsLeft: i32 = 0; NumEltRemaining > 0; CurrOpSizeBytes /= 2 {
        if (8 * CurrOpSizeBytes) % EltTyBits != 0 {
            return self.getMemoryOpCost(Opcode, Src, Alignment, AddressSpace, CostKind, OpInfo, I);
        }
        let mut CurrNumEltPerOp: i32 = (8 * CurrOpSizeBytes) / EltTyBits;
        assert!(CurrOpSizeBytes > 0 && CurrNumEltPerOp > 0, "How'd we get here?");
        assert!((((NumEltRemaining * EltTyBits) < (2 * 8 * CurrOpSizeBytes)) || (CurrOpSizeBytes == MaxLegalOpSizeBytes)), "Unless we haven't halved the op size yet, we have less than two op's sized units of work left.");
        let mut CurrVecTy: *mut FixedVectorType = if CurrNumEltPerOp > NumEltPerXMM { get(EltTy, CurrNumEltPerOp) } else { XMMVecTy };
        assert!(CurrVecTy.getNumElements() % CurrNumEltPerOp == 0, "After halving sizes, the vector elt count is no longer a multiple of number of elements per operation?");
        let mut CoalescedVecTy: *mut FixedVectorType = if CurrNumEltPerOp == 1 { CurrVecTy } else { get(get(Src.getContext(), EltTyBits * CurrNumEltPerOp), CurrVecTy.getNumElements() / CurrNumEltPerOp) };
        assert!(self.DL.getTypeSizeInBits(CoalescedVecTy) == self.DL.getTypeSizeInBits(CurrVecTy), "coalesciing elements doesn't change vector width.");
        while NumEltRemaining > 0 {
            assert!(SubVecEltsLeft >= 0, "Subreg element count overconsumtion?");
            if NumEltRemaining < CurrNumEltPerOp && (!IsLoad || Alignment < CurrOpSizeBytes) && CurrOpSizeBytes != 1 {
                break;
            }
            let mut Is0thSubVec: bool = (NumEltDone.call() % LT.second.getVectorNumElements()) == 0;
            let mut FoldedInLaneInsert: bool = IsLoad && !Is0thSubVec && ((CurrOpSizeBytes == 1 && self.ST.hasSSE41()) || (CurrOpSizeBytes == 2 && self.ST.hasSSE2()) || (CurrOpSizeBytes == 4 && self.ST.hasSSE41()));
            if CurrOpSizeBytes == 32 && self.ST.isUnalignedMem32Slow() {
                operator(Cost, 2);
            } else if CurrOpSizeBytes < 4 && !FoldedInLaneInsert {
                operator(Cost, 2);
            } else {
                operator(Cost, 1);
            }
            if IsLoad && OpInfo.isUniform() {
                return Cost;
            }
            if SubVecEltsLeft == 0 {
                SubVecEltsLeft += CurrVecTy.getNumElements();
                if !Is0thSubVec {
                    operator(Cost, self.getShuffleCost(if IsLoad { SK_InsertSubvector } else { SK_ExtractSubvector }, VTy, VTy, CostKind, ArrayRef<int> {}, NumEltDone.call(), CurrVecTy, ArrayRef<const Value *> {}, null, None));
                }
            }
            if CurrOpSizeBytes <= 32 / 8 && !Is0thSubVec && !FoldedInLaneInsert {
                let mut NumEltDoneInCurrXMM: i32 = NumEltDone.call() % NumEltPerXMM;
                assert!(NumEltDoneInCurrXMM % CurrNumEltPerOp == 0, "");
                let mut CoalescedVecEltIdx: i32 = NumEltDoneInCurrXMM / CurrNumEltPerOp;
                let mut DemandedElts: APInt = getBitsSet(CoalescedVecTy.getNumElements(), CoalescedVecEltIdx, CoalescedVecEltIdx + 1);
                assert!(DemandedElts.popcount() == 1, "Inserting single value");
                operator(Cost, self.getScalarizationOverhead(CoalescedVecTy, DemandedElts, IsLoad, !IsLoad, CostKind, true, ArrayRef<Value *> {}, None));
            }
            SubVecEltsLeft -= CurrNumEltPerOp;
            NumEltRemaining -= CurrNumEltPerOp;
            Alignment = commonAlignment(Alignment, CurrOpSizeBytes);
        }
    }
    assert!(NumEltRemaining <= 0, "Should have processed all the elements.");
    return Cost;
}

fn X86TTIImpl::getMemIntrinsicInstrCost(self: *X86TTIImpl, MICA: *MemIntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    match MICA.getID() {
        masked_scatter => {
            masked_gather;
        },
        masked_load => {
            masked_store;
        },
    }
    let mut AVX512VBMI2CostTable: [6]CostKindTblEntry = [CostKindTblEntry { masked_expandload, v16i8, 2, 7, 1, 3 }, CostKindTblEntry { masked_expandload, v32i8, 2, 8, 1, 3 }, CostKindTblEntry { masked_expandload, v64i8, 2, 9, 1, 3 }, CostKindTblEntry { masked_expandload, v8i16, 2, 7, 1, 3 }, CostKindTblEntry { masked_expandload, v16i16, 2, 8, 1, 3 }, CostKindTblEntry { masked_expandload, v32i16, 2, 9, 1, 3 }];
    let mut AVX512CostTable: [12]CostKindTblEntry = [CostKindTblEntry { masked_expandload, v4i32, 2, 7, 1, 3 }, CostKindTblEntry { masked_expandload, v4f32, 2, 7, 1, 3 }, CostKindTblEntry { masked_expandload, v8i32, 2, 8, 1, 3 }, CostKindTblEntry { masked_expandload, v8f32, 2, 8, 1, 3 }, CostKindTblEntry { masked_expandload, v16i32, 2, 9, 1, 3 }, CostKindTblEntry { masked_expandload, v16f32, 2, 9, 1, 3 }, CostKindTblEntry { masked_expandload, v2i64, 2, 7, 1, 3 }, CostKindTblEntry { masked_expandload, v2f64, 2, 7, 1, 3 }, CostKindTblEntry { masked_expandload, v4i64, 2, 8, 1, 3 }, CostKindTblEntry { masked_expandload, v4f64, 2, 8, 1, 3 }, CostKindTblEntry { masked_expandload, v8i64, 2, 9, 1, 3 }, CostKindTblEntry { masked_expandload, v8f64, 2, 9, 1, 3 }];
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(MICA.getDataType());
    if self.ST.hasVBMI2() {
        if CostTableLookup(AVX512VBMI2CostTable, MICA.getID(), LT.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * operator(KindCost);
        }
    }
    if self.ST.hasAVX512() {
        if CostTableLookup(AVX512CostTable, MICA.getID(), LT.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * operator(KindCost);
        }
    }
    return self.getMemIntrinsicInstrCost(MICA, CostKind);
}

fn X86TTIImpl::getMaskedMemoryOpCost(self: *X86TTIImpl, MICA: *MemIntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    let mut Opcode: u32 = if MICA.getID() == masked_load { Load } else { Store };
    let mut SrcTy: *mut Type = MICA.getDataType();
    let mut Alignment: Align = MICA.getAlignment();
    let mut AddressSpace: u32 = MICA.getAddressSpace();
    let mut IsLoad: bool = (Load == Opcode);
    let mut IsStore: bool = (Store == Opcode);
    let mut SrcVTy: *mut FixedVectorType = dyn_cast(SrcTy);
    if !SrcVTy {
        return self.getMemoryOpCost(Opcode, SrcTy, Alignment, AddressSpace, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
    }
    let mut NumElem: u32 = SrcVTy.getNumElements();
    let mut MaskTy: *mut FixedVectorType = get(getInt8Ty(SrcVTy.getContext()), NumElem);
    if (IsLoad && !self.isLegalMaskedLoad(SrcVTy, Alignment, AddressSpace, VariableOrConstantMask)) || (IsStore && !self.isLegalMaskedStore(SrcVTy, Alignment, AddressSpace, VariableOrConstantMask)) {
        let mut DemandedElts: APInt = getAllOnes(NumElem);
        let mut MaskSplitCost: InstructionCost = self.getScalarizationOverhead(MaskTy, DemandedElts, false, true, CostKind, true, ArrayRef<Value *> {}, None);
        let mut ScalarCompareCost: InstructionCost = self.getCmpSelInstrCost(ICmp, getInt8Ty(SrcVTy.getContext()), null, BAD_ICMP_PREDICATE, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, null);
        let mut BranchCost: InstructionCost = self.getCFInstrCost(CondBr, CostKind, null);
        let mut MaskCmpCost: InstructionCost = NumElem * (BranchCost + ScalarCompareCost);
        let mut ValueSplitCost: InstructionCost = self.getScalarizationOverhead(SrcVTy, DemandedElts, IsLoad, IsStore, CostKind, true, ArrayRef<Value *> {}, None);
        let mut MemopCost: InstructionCost = NumElem * self.getMemoryOpCost(Opcode, SrcVTy.getScalarType(), Alignment, AddressSpace, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
        return MemopCost + ValueSplitCost + MaskSplitCost + MaskCmpCost;
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(SrcVTy);
    let mut VT: EVT = self.TLI.getValueType(self.DL, SrcVTy, false);
    let mut Cost: InstructionCost = 0;
    let mut Ty: MVT = LT.second;
    if Ty == i16 || Ty == i32 || Ty == i64 {
        return Cost + LT.first;
    }
    if VT.isSimple() && Ty != VT.getSimpleVT() && LT.second.getVectorNumElements() == NumElem {
        operator(Cost, self.getShuffleCost(SK_PermuteTwoSrc, SrcVTy, SrcVTy, CostKind, ArrayRef<int> {}, 0, null, ArrayRef<const Value *> {}, null, None) + self.getShuffleCost(SK_PermuteTwoSrc, MaskTy, MaskTy, CostKind, ArrayRef<int> {}, 0, null, ArrayRef<const Value *> {}, null, None));
    } else if LT.first * Ty.getVectorNumElements() > NumElem {
        let mut NewMaskTy: *mut FixedVectorType = get(MaskTy.getElementType(), LT.first.getValue() as u32 * Ty.getVectorNumElements());
        operator(Cost, self.getShuffleCost(SK_InsertSubvector, NewMaskTy, NewMaskTy, CostKind, ArrayRef<int> {}, 0, MaskTy, ArrayRef<const Value *> {}, null, None));
    }
    if !self.ST.hasAVX512() {
        return Cost + LT.first * (if IsLoad { 2 } else { 8 });
    }
    return Cost + LT.first;
}

fn X86TTIImpl::getPointersChainCost(self: *X86TTIImpl, Ptrs: ArrayRef<const Value *>, Base: *Value, Info: *PointersChainInfo, AccessTy: *mut Type, CostKind: TargetCostKind) -> InstructionCost {
    if Info.isSameBase() && Info.isKnownStride() {
        if dyn_cast(Base) {
            BaseGEP;
        } else {
            let mut Indices: SmallVector<const Value *> = BaseGEP.indices();
            return self.getGEPCost(BaseGEP.getSourceElementType(), BaseGEP.getPointerOperand(), Indices, CostKind, null);
        }
        return TCC_Free;
    }
    return self.getPointersChainCost(Ptrs, Base, Info, AccessTy, CostKind);
}

fn X86TTIImpl::getAddressComputationCost(self: *X86TTIImpl, PtrTy: *mut Type, SE: *mut ScalarEvolution, Ptr: *SCEV, CostKind: TargetCostKind) -> InstructionCost {
    let mut NumVectorInstToHideOverhead: u32 = 10;
    if PtrTy.isVectorTy() && SE {
        if self.isStridedAccess(Ptr) && !self.getConstantStrideStep(SE, Ptr) {
            return 1;
        }
        if !self.ST.hasAVX2() {
            if !self.isStridedAccess(Ptr) {
                return NumVectorInstToHideOverhead;
            }
        }
    }
    return self.getAddressComputationCost(PtrTy, SE, Ptr, CostKind);
}

fn X86TTIImpl::getPartialReductionCost(self: *X86TTIImpl, Opcode: u32, InputTypeA: *mut Type, InputTypeB: *mut Type, AccumType: *mut Type, VF: ElementCount, OpAExtend: PartialReductionExtendKind, OpBExtend: PartialReductionExtendKind, BinOp: optional<unsigned int>, CostKind: TargetCostKind, FMF: optional<FastMathFlags>) -> InstructionCost {
    let mut ExpandCost: Closure_19 = Closure_19 { cap_0: self, Opcode: &mut Opcode, InputTypeA: &mut InputTypeA, InputTypeB: &mut InputTypeB, AccumType: &mut AccumType, VF: &mut VF, OpAExtend: &mut OpAExtend, OpBExtend: &mut OpBExtend, BinOp: &mut BinOp, CostKind: &mut CostKind, FMF: &mut FMF };
    if VF.isScalable() || !BinOp || OpAExtend == PR_None || OpBExtend == PR_None || InputTypeA != InputTypeB {
        return ExpandCost.call();
    }
    let mut Opc: u32 = 0;
    if Opcode == Add && operator(BinOp) == Mul && AccumType.isIntegerTy(32) && (InputTypeA.isIntegerTy(8) || InputTypeA.isIntegerTy(16)) {
        if OpAExtend != OpBExtend {
            Opc = PARTIAL_REDUCE_SUMLA;
        } else if OpAExtend == PR_SignExtend {
            Opc = PARTIAL_REDUCE_SMLA;
        } else {
            Opc = PARTIAL_REDUCE_UMLA;
        }
    } else if Opcode == FAdd && operator(BinOp) == FMul && AccumType.isFloatTy() && (InputTypeA.isBFloatTy() || InputTypeA.isHalfTy()) {
        if !FMF || !operator(FMF).allowReassoc() || !operator(FMF).allowContract() {
            return getInvalid(0);
        }
        Opc = PARTIAL_REDUCE_FMLA;
    } else {
        return ExpandCost.call();
    }
    let mut Ratio: u32 = AccumType.getScalarSizeInBits() / InputTypeA.getScalarSizeInBits();
    if !VF.isKnownMultipleOf(Ratio) {
        return ExpandCost.call();
    }
    let mut AccVecTy: *mut VectorType = get(AccumType, VF.divideCoefficientBy(Ratio));
    let mut InputVecTy: *mut VectorType = get(InputTypeA, VF);
    let mut AccLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(AccVecTy);
    let mut InputLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(InputVecTy);
    if AccLT.second.getFixedSizeInBits() > AccVecTy.getPrimitiveSizeInBits().getFixedValue() || !self.TLI.isPartialReduceMLALegalOrCustom(Opc, AccLT.second, InputLT.second) {
        return ExpandCost.call();
    }
    return AccLT.first;
}

fn X86TTIImpl::getArithmeticReductionCost(self: *X86TTIImpl, Opcode: u32, ValTy: *mut VectorType, FMF: optional<FastMathFlags>, CostKind: TargetCostKind) -> InstructionCost {
    if requiresOrderedReduction(FMF) {
        return self.getArithmeticReductionCost(Opcode, ValTy, FMF, CostKind);
    }
    let mut SLMCostTbl: [2]CostKindTblEntry = [CostKindTblEntry { FADD, v2f64, 3, 3, 3, 3 }, CostKindTblEntry { ADD, v2i64, 5, 5, 5, 5 }];
    let mut SSE2CostTbl: [25]CostKindTblEntry = [CostKindTblEntry { FADD, v2f64, 2, 2, 2, 2 }, CostKindTblEntry { FADD, v2f32, 2, 2, 2, 2 }, CostKindTblEntry { FADD, v4f32, 4, 4, 4, 4 }, CostKindTblEntry { ADD, v2i64, 2, 2, 2, 2 }, CostKindTblEntry { ADD, v2i32, 2, 2, 2, 2 }, CostKindTblEntry { ADD, v4i32, 3, 3, 3, 3 }, CostKindTblEntry { ADD, v2i16, 2, 2, 2, 2 }, CostKindTblEntry { ADD, v4i16, 3, 3, 3, 3 }, CostKindTblEntry { ADD, v8i16, 4, 4, 4, 4 }, CostKindTblEntry { ADD, v2i8, 2, 2, 2, 2 }, CostKindTblEntry { ADD, v4i8, 2, 2, 2, 2 }, CostKindTblEntry { ADD, v8i8, 2, 2, 2, 2 }, CostKindTblEntry { ADD, v16i8, 3, 3, 3, 3 }, CostKindTblEntry { AND, v2i64, 2, 2, 3, 3 }, CostKindTblEntry { AND, v4i32, 3, 4, 5, 5 }, CostKindTblEntry { AND, v8i16, 4, 7, 8, 8 }, CostKindTblEntry { AND, v16i8, 6, 10, 11, 11 }, CostKindTblEntry { OR, v2i64, 2, 2, 3, 3 }, CostKindTblEntry { OR, v4i32, 3, 4, 5, 5 }, CostKindTblEntry { OR, v8i16, 4, 7, 8, 8 }, CostKindTblEntry { OR, v16i8, 6, 10, 11, 11 }, CostKindTblEntry { XOR, v2i64, 2, 2, 3, 3 }, CostKindTblEntry { XOR, v4i32, 3, 4, 5, 5 }, CostKindTblEntry { XOR, v8i16, 4, 7, 8, 8 }, CostKindTblEntry { XOR, v16i8, 6, 10, 11, 11 }];
    let mut AVX1CostTbl: [26]CostKindTblEntry = [CostKindTblEntry { FADD, v4f64, 3, 3, 3, 3 }, CostKindTblEntry { FADD, v4f32, 3, 3, 3, 3 }, CostKindTblEntry { FADD, v8f32, 4, 4, 4, 4 }, CostKindTblEntry { ADD, v2i64, 1, 1, 1, 1 }, CostKindTblEntry { ADD, v4i64, 3, 3, 3, 3 }, CostKindTblEntry { ADD, v8i32, 5, 5, 5, 5 }, CostKindTblEntry { ADD, v16i16, 5, 5, 5, 5 }, CostKindTblEntry { ADD, v32i8, 4, 4, 4, 4 }, CostKindTblEntry { AND, v4i64, 3, 7, 5, 5 }, CostKindTblEntry { AND, v8i32, 4, 9, 7, 7 }, CostKindTblEntry { AND, v16i16, 5, 11, 9, 9 }, CostKindTblEntry { AND, v8i16, 4, 7, 7, 7 }, CostKindTblEntry { AND, v32i8, 6, 13, 11, 11 }, CostKindTblEntry { AND, v16i8, 5, 10, 9, 9 }, CostKindTblEntry { OR, v4i64, 3, 7, 5, 5 }, CostKindTblEntry { OR, v8i32, 4, 9, 7, 7 }, CostKindTblEntry { OR, v16i16, 5, 11, 9, 9 }, CostKindTblEntry { OR, v8i16, 4, 7, 7, 7 }, CostKindTblEntry { OR, v32i8, 6, 13, 11, 11 }, CostKindTblEntry { OR, v16i8, 5, 10, 9, 9 }, CostKindTblEntry { XOR, v4i64, 3, 7, 5, 5 }, CostKindTblEntry { XOR, v8i32, 4, 9, 7, 7 }, CostKindTblEntry { XOR, v16i16, 5, 11, 9, 9 }, CostKindTblEntry { XOR, v8i16, 4, 7, 7, 7 }, CostKindTblEntry { XOR, v32i8, 6, 13, 11, 11 }, CostKindTblEntry { XOR, v16i8, 5, 10, 9, 9 }];
    let mut AVX2CostTbl: [24]CostKindTblEntry = [CostKindTblEntry { AND, v4i64, 2, 7, 5, 5 }, CostKindTblEntry { AND, v2i64, 1, 2, 3, 3 }, CostKindTblEntry { AND, v8i32, 3, 9, 7, 7 }, CostKindTblEntry { AND, v4i32, 2, 4, 5, 5 }, CostKindTblEntry { AND, v16i16, 3, 11, 9, 9 }, CostKindTblEntry { AND, v8i16, 2, 6, 7, 7 }, CostKindTblEntry { AND, v32i8, 3, 13, 11, 11 }, CostKindTblEntry { AND, v16i8, 3, 8, 9, 9 }, CostKindTblEntry { OR, v4i64, 2, 7, 5, 5 }, CostKindTblEntry { OR, v2i64, 1, 2, 3, 3 }, CostKindTblEntry { OR, v8i32, 3, 9, 7, 7 }, CostKindTblEntry { OR, v4i32, 2, 4, 5, 5 }, CostKindTblEntry { OR, v16i16, 3, 11, 9, 9 }, CostKindTblEntry { OR, v8i16, 2, 6, 7, 7 }, CostKindTblEntry { OR, v32i8, 3, 13, 11, 11 }, CostKindTblEntry { OR, v16i8, 3, 8, 9, 9 }, CostKindTblEntry { XOR, v4i64, 2, 7, 5, 5 }, CostKindTblEntry { XOR, v2i64, 1, 2, 3, 3 }, CostKindTblEntry { XOR, v8i32, 3, 9, 7, 7 }, CostKindTblEntry { XOR, v4i32, 2, 4, 5, 5 }, CostKindTblEntry { XOR, v16i16, 3, 11, 9, 9 }, CostKindTblEntry { XOR, v8i16, 2, 6, 7, 7 }, CostKindTblEntry { XOR, v32i8, 3, 13, 11, 11 }, CostKindTblEntry { XOR, v16i8, 3, 8, 9, 9 }];
    let mut AVX512FCostTbl: [19]CostKindTblEntry = [CostKindTblEntry { FADD, v8f64, 4, 4, 4, 4 }, CostKindTblEntry { FADD, v16f32, 5, 5, 5, 5 }, CostKindTblEntry { ADD, v8i64, 4, 4, 4, 4 }, CostKindTblEntry { ADD, v16i32, 6, 6, 6, 6 }, CostKindTblEntry { AND, v8i64, 3, 10, 7, 7 }, CostKindTblEntry { AND, v16i32, 4, 12, 9, 9 }, CostKindTblEntry { AND, v32i16, 4, 14, 11, 11 }, CostKindTblEntry { AND, v64i8, 4, 16, 13, 13 }, CostKindTblEntry { AND, v16i8, 2, 8, 9, 9 }, CostKindTblEntry { OR, v8i64, 3, 10, 7, 7 }, CostKindTblEntry { OR, v16i32, 4, 12, 9, 9 }, CostKindTblEntry { OR, v32i16, 4, 14, 11, 11 }, CostKindTblEntry { OR, v64i8, 4, 16, 13, 13 }, CostKindTblEntry { OR, v16i8, 2, 8, 9, 9 }, CostKindTblEntry { XOR, v8i64, 3, 10, 7, 7 }, CostKindTblEntry { XOR, v16i32, 4, 12, 9, 9 }, CostKindTblEntry { XOR, v32i16, 4, 14, 11, 11 }, CostKindTblEntry { XOR, v64i8, 4, 16, 13, 13 }, CostKindTblEntry { XOR, v16i8, 2, 8, 9, 9 }];
    let mut AVX512BWCostTbl: [2]CostKindTblEntry = [CostKindTblEntry { ADD, v32i16, 7, 7, 7, 7 }, CostKindTblEntry { ADD, v64i8, 4, 4, 4, 4 }];
    let mut ISD: i32 = self.TLI.InstructionOpcodeToISD(Opcode);
    assert!(ISD, "Invalid opcode");
    let mut VT: EVT = self.TLI.getValueType(self.DL, ValTy, false);
    if VT.isSimple() {
        let mut MTy: MVT = VT.getSimpleVT();
        if self.ST.useSLMArithCosts() {
            if CostTableLookup(SLMCostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasBWI() {
            if CostTableLookup(AVX512BWCostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasAVX512() {
            if CostTableLookup(AVX512FCostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasAVX2() {
            if CostTableLookup(AVX2CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasAVX() {
            if CostTableLookup(AVX1CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasSSE2() {
            if CostTableLookup(SSE2CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(ValTy);
    let mut MTy: MVT = LT.second;
    let mut ValVTy: *mut FixedVectorType = cast(ValTy);
    let mut ArithmeticCost: InstructionCost = 0;
    if LT.first != 1 && MTy.isVector() && MTy.getVectorNumElements() < ValVTy.getNumElements() {
        let mut SingleOpTy: *mut FixedVectorType = get(ValVTy.getElementType(), MTy.getVectorNumElements());
        ArithmeticCost = self.getArithmeticInstrCost(Opcode, SingleOpTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null);
        operator(ArithmeticCost, LT.first - 1);
    }
    let mut AVX512BoolReduction: [12]CostKindTblEntry = [CostKindTblEntry { AND, v2i1, 3, 3, 3, 3 }, CostKindTblEntry { AND, v4i1, 5, 5, 5, 5 }, CostKindTblEntry { AND, v8i1, 7, 7, 7, 7 }, CostKindTblEntry { AND, v16i1, 9, 9, 9, 9 }, CostKindTblEntry { AND, v32i1, 11, 11, 11, 11 }, CostKindTblEntry { AND, v64i1, 13, 13, 13, 13 }, CostKindTblEntry { OR, v2i1, 3, 3, 3, 3 }, CostKindTblEntry { OR, v4i1, 5, 5, 5, 5 }, CostKindTblEntry { OR, v8i1, 7, 7, 7, 7 }, CostKindTblEntry { OR, v16i1, 9, 9, 9, 9 }, CostKindTblEntry { OR, v32i1, 11, 11, 11, 11 }, CostKindTblEntry { OR, v64i1, 13, 13, 13, 13 }];
    let mut AVX2BoolReduction: [4]CostKindTblEntry = [CostKindTblEntry { AND, v16i16, 2, 2, 2, 2 }, CostKindTblEntry { AND, v32i8, 2, 2, 2, 2 }, CostKindTblEntry { OR, v16i16, 2, 2, 2, 2 }, CostKindTblEntry { OR, v32i8, 2, 2, 2, 2 }];
    let mut AVX1BoolReduction: [8]CostKindTblEntry = [CostKindTblEntry { AND, v4i64, 2, 2, 2, 2 }, CostKindTblEntry { AND, v8i32, 2, 2, 2, 2 }, CostKindTblEntry { AND, v16i16, 4, 4, 4, 4 }, CostKindTblEntry { AND, v32i8, 4, 4, 4, 4 }, CostKindTblEntry { OR, v4i64, 2, 2, 2, 2 }, CostKindTblEntry { OR, v8i32, 2, 2, 2, 2 }, CostKindTblEntry { OR, v16i16, 4, 4, 4, 4 }, CostKindTblEntry { OR, v32i8, 4, 4, 4, 4 }];
    let mut SSE2BoolReduction: [8]CostKindTblEntry = [CostKindTblEntry { AND, v2i64, 2, 2, 2, 2 }, CostKindTblEntry { AND, v4i32, 2, 2, 2, 2 }, CostKindTblEntry { AND, v8i16, 2, 2, 2, 2 }, CostKindTblEntry { AND, v16i8, 2, 2, 2, 2 }, CostKindTblEntry { OR, v2i64, 2, 2, 2, 2 }, CostKindTblEntry { OR, v4i32, 2, 2, 2, 2 }, CostKindTblEntry { OR, v8i16, 2, 2, 2, 2 }, CostKindTblEntry { OR, v16i8, 2, 2, 2, 2 }];
    if ValVTy.getElementType().isIntegerTy(1) {
        if ISD == ADD {
            let mut IntTy: *mut IntegerType = getIntNTy(ValVTy.getContext(), ValVTy.getNumElements());
            let mut ICA: IntrinsicCostAttributes = IntrinsicCostAttributes { ctpop, IntTy, [IntTy], FastMathFlags {}, null, getInvalid(0) };
            return self.getCastInstrCost(BitCast, IntTy, ValVTy, None, CostKind, null) + self.getIntrinsicInstrCost(ICA, CostKind);
        }
        if self.ST.hasAVX512() {
            if CostTableLookup(AVX512BoolReduction, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return ArithmeticCost + operator(KindCost);
            }
        }
        if self.ST.hasAVX2() {
            if CostTableLookup(AVX2BoolReduction, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return ArithmeticCost + operator(KindCost);
            }
        }
        if self.ST.hasAVX() {
            if CostTableLookup(AVX1BoolReduction, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return ArithmeticCost + operator(KindCost);
            }
        }
        if self.ST.hasSSE2() {
            if CostTableLookup(SSE2BoolReduction, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return ArithmeticCost + operator(KindCost);
            }
        }
        return self.getArithmeticReductionCost(Opcode, ValVTy, FMF, CostKind);
    }
    if ISD == MUL && MTy.getScalarType() == i8 {
        let mut WideSclTy: *mut IntegerType = get(ValVTy.getContext(), 16);
        let mut WideVecTy: *mut FixedVectorType = get(WideSclTy, ValVTy.getNumElements());
        return self.getCastInstrCost(ZExt, WideVecTy, ValTy, None, CostKind, null) + self.getArithmeticReductionCost(Opcode, WideVecTy, FMF, CostKind);
    }
    if self.ST.useSLMArithCosts() {
        if CostTableLookup(SLMCostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return ArithmeticCost + operator(KindCost);
        }
    }
    if self.ST.hasBWI() {
        if CostTableLookup(AVX512BWCostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return ArithmeticCost + operator(KindCost);
        }
    }
    if self.ST.hasAVX512() {
        if CostTableLookup(AVX512FCostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return ArithmeticCost + operator(KindCost);
        }
    }
    if self.ST.hasAVX2() {
        if CostTableLookup(AVX2CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return ArithmeticCost + operator(KindCost);
        }
    }
    if self.ST.hasAVX() {
        if CostTableLookup(AVX1CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return ArithmeticCost + operator(KindCost);
        }
    }
    if self.ST.hasSSE2() {
        if CostTableLookup(SSE2CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return ArithmeticCost + operator(KindCost);
        }
    }
    let mut NumVecElts: u32 = ValVTy.getNumElements();
    let mut ScalarSize: u32 = ValVTy.getScalarSizeInBits();
    if !isPowerOf2_32(NumVecElts) || ScalarSize != MTy.getScalarSizeInBits() {
        return self.getArithmeticReductionCost(Opcode, ValVTy, FMF, CostKind);
    }
    let mut ReductionCost: InstructionCost = 0;
    let mut Ty: *mut FixedVectorType = ValVTy;
    if LT.first != 1 && MTy.isVector() && MTy.getVectorNumElements() < ValVTy.getNumElements() {
        Ty = get(ValVTy.getElementType(), MTy.getVectorNumElements());
        ReductionCost = self.getArithmeticInstrCost(Opcode, Ty, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null);
        operator(ReductionCost, LT.first - 1);
        NumVecElts = MTy.getVectorNumElements();
    }
    while NumVecElts > 1 {
        let mut Size: u32 = NumVecElts * ScalarSize;
        NumVecElts /= 2;
        if Size > 128 {
            let mut SubTy: *mut FixedVectorType = get(ValVTy.getElementType(), NumVecElts);
            operator(ReductionCost, self.getShuffleCost(SK_ExtractSubvector, Ty, Ty, CostKind, ArrayRef<int> {}, NumVecElts, SubTy, ArrayRef<const Value *> {}, null, None));
            Ty = SubTy;
        } else if Size == 128 {
            let mut ShufTy: *mut FixedVectorType = null;
            if ValVTy.isFloatingPointTy() {
                ShufTy = get(getDoubleTy(ValVTy.getContext()), 2);
            } else {
                ShufTy = get(getInt64Ty(ValVTy.getContext()), 2);
            }
            operator(ReductionCost, self.getShuffleCost(SK_PermuteSingleSrc, ShufTy, ShufTy, CostKind, ArrayRef<int> {}, 0, null, ArrayRef<const Value *> {}, null, None));
        } else if Size == 64 {
            let mut ShufTy: *mut FixedVectorType = null;
            if ValVTy.isFloatingPointTy() {
                ShufTy = get(getFloatTy(ValVTy.getContext()), 4);
            } else {
                ShufTy = get(getInt32Ty(ValVTy.getContext()), 4);
            }
            operator(ReductionCost, self.getShuffleCost(SK_PermuteSingleSrc, ShufTy, ShufTy, CostKind, ArrayRef<int> {}, 0, null, ArrayRef<const Value *> {}, null, None));
        } else {
            let mut ShiftTy: *mut FixedVectorType = get(getIntNTy(ValVTy.getContext(), Size), 128 / Size);
            operator(ReductionCost, self.getArithmeticInstrCost(LShr, ShiftTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_UniformConstantValue, OP_None }, ArrayRef<const Value *> {}, null));
        }
        operator(ReductionCost, self.getArithmeticInstrCost(Opcode, Ty, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null));
    }
    return ReductionCost + self.getVectorInstrCost(ExtractElement, Ty, CostKind, 0, null, null, None);
}

fn X86TTIImpl::getMinMaxCost(self: *X86TTIImpl, IID: ID, Ty: *mut Type, CostKind: TargetCostKind, FMF: FastMathFlags) -> InstructionCost {
    let mut ICA: IntrinsicCostAttributes = IntrinsicCostAttributes { IID, Ty, [Ty, Ty], FMF, null, getInvalid(0) };
    return self.getIntrinsicInstrCost(ICA, CostKind);
}

fn X86TTIImpl::getMinMaxReductionCost(self: *X86TTIImpl, IID: ID, ValTy: *mut VectorType, FMF: FastMathFlags, CostKind: TargetCostKind) -> InstructionCost {
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(ValTy);
    let mut MTy: MVT = LT.second;
    let mut ISD: NodeType = zeroed();
    if ValTy.isIntOrIntVectorTy() {
        ISD = if (IID == umin || IID == umax) { UMIN } else { SMIN };
    } else {
        assert!(ValTy.isFPOrFPVectorTy(), "Expected float point or integer vector type.");
        ISD = if (IID == minnum || IID == maxnum) { FMINNUM } else { FMINIMUM };
    }
    let mut SSE2CostTbl: [20]CostKindTblEntry = [CostKindTblEntry { SMIN, v2i64, 3, 4, 5, 6 }, CostKindTblEntry { UMIN, v2i64, 3, 4, 5, 6 }, CostKindTblEntry { SMIN, v2i32, 2, 2, 5, 6 }, CostKindTblEntry { UMIN, v2i32, 2, 2, 5, 6 }, CostKindTblEntry { SMIN, v4i32, 3, 7, 11, 12 }, CostKindTblEntry { UMIN, v4i32, 4, 7, 14, 15 }, CostKindTblEntry { SMIN, v2i16, 2, 3, 4, 4 }, CostKindTblEntry { UMIN, v2i16, 2, 3, 4, 6 }, CostKindTblEntry { SMIN, v4i16, 3, 5, 6, 6 }, CostKindTblEntry { UMIN, v4i16, 3, 5, 8, 10 }, CostKindTblEntry { SMIN, v8i16, 3, 8, 8, 8 }, CostKindTblEntry { UMIN, v8i16, 4, 8, 12, 14 }, CostKindTblEntry { SMIN, v2i8, 2, 3, 5, 6 }, CostKindTblEntry { UMIN, v2i8, 2, 3, 4, 4 }, CostKindTblEntry { SMIN, v4i8, 4, 6, 12, 13 }, CostKindTblEntry { UMIN, v4i8, 3, 6, 7, 7 }, CostKindTblEntry { SMIN, v8i8, 5, 9, 18, 19 }, CostKindTblEntry { UMIN, v8i8, 4, 8, 9, 9 }, CostKindTblEntry { SMIN, v16i8, 7, 13, 24, 25 }, CostKindTblEntry { UMIN, v16i8, 3, 10, 11, 11 }];
    let mut SSE41CostTbl: [16]CostKindTblEntry = [CostKindTblEntry { SMIN, v2i64, 3, 4, 4, 6 }, CostKindTblEntry { UMIN, v2i64, 3, 4, 4, 6 }, CostKindTblEntry { SMIN, v2i32, 2, 2, 3, 3 }, CostKindTblEntry { UMIN, v2i32, 2, 2, 3, 3 }, CostKindTblEntry { SMIN, v4i32, 3, 4, 5, 5 }, CostKindTblEntry { UMIN, v4i32, 3, 4, 5, 5 }, CostKindTblEntry { UMIN, v2i16, 2, 3, 4, 4 }, CostKindTblEntry { SMIN, v4i16, 3, 5, 6, 6 }, CostKindTblEntry { UMIN, v4i16, 3, 5, 6, 6 }, CostKindTblEntry { SMIN, v8i16, 2, 8, 4, 5 }, CostKindTblEntry { UMIN, v8i16, 2, 5, 2, 2 }, CostKindTblEntry { SMIN, v2i8, 2, 3, 4, 4 }, CostKindTblEntry { SMIN, v4i8, 3, 6, 7, 7 }, CostKindTblEntry { SMIN, v8i8, 4, 8, 9, 9 }, CostKindTblEntry { SMIN, v16i8, 3, 10, 7, 8 }, CostKindTblEntry { UMIN, v16i8, 3, 8, 5, 5 }];
    let mut AVX1CostTbl: [8]CostKindTblEntry = [CostKindTblEntry { SMIN, v4i64, 5, 11, 7, 10 }, CostKindTblEntry { UMIN, v4i64, 6, 12, 10, 13 }, CostKindTblEntry { SMIN, v8i32, 4, 9, 7, 7 }, CostKindTblEntry { UMIN, v8i32, 4, 9, 7, 7 }, CostKindTblEntry { SMIN, v16i16, 3, 15, 6, 7 }, CostKindTblEntry { UMIN, v16i16, 2, 9, 4, 4 }, CostKindTblEntry { SMIN, v32i8, 4, 17, 8, 9 }, CostKindTblEntry { UMIN, v32i8, 3, 11, 6, 6 }];
    let mut AVX2CostTbl: [14]CostKindTblEntry = [CostKindTblEntry { SMIN, v4i64, 4, 11, 7, 10 }, CostKindTblEntry { UMIN, v4i64, 4, 12, 10, 13 }, CostKindTblEntry { SMIN, v2i32, 1, 2, 3, 3 }, CostKindTblEntry { UMIN, v2i32, 1, 2, 3, 3 }, CostKindTblEntry { UMIN, v4i32, 2, 4, 5, 5 }, CostKindTblEntry { SMIN, v4i32, 2, 4, 5, 5 }, CostKindTblEntry { SMIN, v8i32, 3, 9, 7, 7 }, CostKindTblEntry { UMIN, v8i32, 3, 9, 7, 7 }, CostKindTblEntry { SMIN, v4i16, 2, 4, 5, 5 }, CostKindTblEntry { UMIN, v4i16, 2, 4, 5, 5 }, CostKindTblEntry { SMIN, v16i16, 2, 15, 6, 7 }, CostKindTblEntry { SMIN, v8i8, 3, 6, 7, 7 }, CostKindTblEntry { UMIN, v8i8, 3, 6, 7, 7 }, CostKindTblEntry { SMIN, v32i8, 3, 17, 8, 9 }];
    let mut AVX512FCostTbl: [8]CostKindTblEntry = [CostKindTblEntry { SMIN, v2i64, 2, 4, 3, 3 }, CostKindTblEntry { UMIN, v2i64, 2, 4, 3, 3 }, CostKindTblEntry { SMIN, v4i64, 3, 10, 5, 5 }, CostKindTblEntry { UMIN, v4i64, 3, 10, 5, 5 }, CostKindTblEntry { SMIN, v8i64, 5, 16, 7, 7 }, CostKindTblEntry { UMIN, v8i64, 5, 16, 7, 7 }, CostKindTblEntry { SMIN, v16i32, 4, 12, 9, 9 }, CostKindTblEntry { UMIN, v16i32, 4, 12, 9, 9 }];
    let mut AVX512BWCostTbl: [14]CostKindTblEntry = [CostKindTblEntry { SMIN, v2i16, 1, 2, 3, 3 }, CostKindTblEntry { UMIN, v2i16, 1, 2, 3, 3 }, CostKindTblEntry { SMIN, v32i16, 2, 19, 8, 9 }, CostKindTblEntry { UMIN, v32i16, 2, 12, 6, 6 }, CostKindTblEntry { SMIN, v2i8, 1, 2, 3, 3 }, CostKindTblEntry { UMIN, v2i8, 1, 2, 3, 3 }, CostKindTblEntry { SMIN, v4i8, 2, 4, 5, 5 }, CostKindTblEntry { UMIN, v4i8, 2, 4, 5, 5 }, CostKindTblEntry { SMIN, v16i8, 2, 10, 6, 7 }, CostKindTblEntry { UMIN, v16i8, 2, 6, 4, 4 }, CostKindTblEntry { SMIN, v32i8, 2, 17, 8, 9 }, CostKindTblEntry { UMIN, v32i8, 2, 10, 6, 6 }, CostKindTblEntry { SMIN, v64i8, 2, 21, 10, 11 }, CostKindTblEntry { UMIN, v64i8, 2, 14, 8, 8 }];
    let mut VT: EVT = self.TLI.getValueType(self.DL, ValTy, false);
    if VT.isSimple() {
        let mut MTy: MVT = VT.getSimpleVT();
        if self.ST.hasBWI() {
            if CostTableLookup(AVX512BWCostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasAVX512() {
            if CostTableLookup(AVX512FCostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasAVX2() {
            if CostTableLookup(AVX2CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasAVX() {
            if CostTableLookup(AVX1CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasSSE41() {
            if CostTableLookup(SSE41CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
        if self.ST.hasSSE2() {
            if CostTableLookup(SSE2CostTbl, ISD, MTy) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return operator(KindCost);
            }
        }
    }
    let mut ValVTy: *mut FixedVectorType = cast(ValTy);
    let mut NumVecElts: u32 = ValVTy.getNumElements();
    let mut Ty: *mut FixedVectorType = ValVTy;
    let mut MinMaxCost: InstructionCost = 0;
    if LT.first != 1 && MTy.isVector() && MTy.getVectorNumElements() < ValVTy.getNumElements() {
        Ty = get(ValVTy.getElementType(), MTy.getVectorNumElements());
        MinMaxCost = self.getMinMaxCost(IID, Ty, CostKind, FMF);
        operator(MinMaxCost, LT.first - 1);
        NumVecElts = MTy.getVectorNumElements();
    }
    if self.ST.hasBWI() {
        if CostTableLookup(AVX512BWCostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return MinMaxCost + operator(KindCost);
        }
    }
    if self.ST.hasAVX512() {
        if CostTableLookup(AVX512FCostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return MinMaxCost + operator(KindCost);
        }
    }
    if self.ST.hasAVX2() {
        if CostTableLookup(AVX2CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return MinMaxCost + operator(KindCost);
        }
    }
    if self.ST.hasAVX() {
        if CostTableLookup(AVX1CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return MinMaxCost + operator(KindCost);
        }
    }
    if self.ST.hasSSE41() {
        if CostTableLookup(SSE41CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return MinMaxCost + operator(KindCost);
        }
    }
    if self.ST.hasSSE2() {
        if CostTableLookup(SSE2CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return MinMaxCost + operator(KindCost);
        }
    }
    let mut ScalarSize: u32 = ValTy.getScalarSizeInBits();
    if !isPowerOf2_32(ValVTy.getNumElements()) || ScalarSize != MTy.getScalarSizeInBits() {
        return self.getMinMaxReductionCost(IID, ValTy, FMF, CostKind);
    }
    while NumVecElts > 1 {
        let mut Size: u32 = NumVecElts * ScalarSize;
        NumVecElts /= 2;
        if Size > 128 {
            let mut SubTy: *mut FixedVectorType = get(ValVTy.getElementType(), NumVecElts);
            operator(MinMaxCost, self.getShuffleCost(SK_ExtractSubvector, Ty, Ty, CostKind, ArrayRef<int> {}, NumVecElts, SubTy, ArrayRef<const Value *> {}, null, None));
            Ty = SubTy;
        } else if Size == 128 {
            let mut ShufTy: *mut VectorType = null;
            if ValTy.isFloatingPointTy() {
                ShufTy = get(getDoubleTy(ValTy.getContext()), 2);
            } else {
                ShufTy = get(getInt64Ty(ValTy.getContext()), 2);
            }
            operator(MinMaxCost, self.getShuffleCost(SK_PermuteSingleSrc, ShufTy, ShufTy, CostKind, ArrayRef<int> {}, 0, null, ArrayRef<const Value *> {}, null, None));
        } else if Size == 64 {
            let mut ShufTy: *mut FixedVectorType = null;
            if ValTy.isFloatingPointTy() {
                ShufTy = get(getFloatTy(ValTy.getContext()), 4);
            } else {
                ShufTy = get(getInt32Ty(ValTy.getContext()), 4);
            }
            operator(MinMaxCost, self.getShuffleCost(SK_PermuteSingleSrc, ShufTy, ShufTy, CostKind, ArrayRef<int> {}, 0, null, ArrayRef<const Value *> {}, null, None));
        } else {
            let mut ShiftTy: *mut FixedVectorType = get(getIntNTy(ValTy.getContext(), Size), 128 / Size);
            operator(MinMaxCost, self.getArithmeticInstrCost(LShr, ShiftTy, TCK_RecipThroughput, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_UniformConstantValue, OP_None }, ArrayRef<const Value *> {}, null));
        }
        operator(MinMaxCost, self.getMinMaxCost(IID, Ty, CostKind, FMF));
    }
    return MinMaxCost + self.getVectorInstrCost(ExtractElement, Ty, CostKind, 0, null, null, None);
}

fn X86TTIImpl::getIntImmCost(self: *X86TTIImpl, Val: i64) -> InstructionCost {
    if Val == 0 {
        return TCC_Free;
    }
    if isInt(Val) {
        return TCC_Basic;
    }
    return 2 * TCC_Basic;
}

fn X86TTIImpl::getIntImmCost(self: *X86TTIImpl, Imm: *APInt, Ty: *mut Type, CostKind: TargetCostKind) -> InstructionCost {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 {
        return ~0;
    }
    if BitSize > 128 {
        return TCC_Free;
    }
    if Imm == 0 {
        return TCC_Free;
    }
    let mut ImmVal: APInt = Imm;
    if BitSize % 64 != 0 {
        ImmVal = Imm.sext(alignTo(BitSize, 64));
    }
    let mut Cost: InstructionCost = 0;
    for let mut ShiftVal: u32 = 0; ShiftVal < BitSize; ShiftVal += 64 {
        let mut Tmp: APInt = ImmVal.ashr(ShiftVal).sextOrTrunc(64);
        let mut Val: i64 = Tmp.getSExtValue();
        operator(Cost, self.getIntImmCost(Val));
    }
    return if 1 > Cost { 1 } else { Cost };
}

fn X86TTIImpl::getIntImmCostInst(self: *X86TTIImpl, Opcode: u32, Idx: u32, Imm: *APInt, Ty: *mut Type, CostKind: TargetCostKind, Inst: *mut Instruction) -> InstructionCost {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    let mut ImmBitWidth: u32 = Imm.getBitWidth();
    if BitSize == 0 {
        return TCC_Free;
    }
    let mut ImmIdx: u32 = ~0;
    match Opcode {
        _ => {
            return TCC_Free;
        },
        GetElementPtr => {
            if Idx == 0 {
                return 2 * TCC_Basic;
            }
        },
        Store => {
            ImmIdx = 0;
        },
        ICmp => {
            if Idx == 1 && ImmBitWidth == 64 {
                let mut ImmVal: u64 = Imm.getZExtValue();
                if ImmVal == 4294967296 || ImmVal == 4294967295 {
                    return TCC_Free;
                }
                if dyn_cast_or_null(Inst) {
                    Cmp;
                } else {
                    if Cmp.isEquality() {
                        let mut Known: KnownBits = computeKnownBits(Cmp.getOperand(0), self.DL, null, null, null, true, 0);
                        if Known.countMinTrailingZeros() >= 32 {
                            return TCC_Free;
                        }
                    }
                }
            }
        },
        And => {
            if Idx == 1 && ImmBitWidth == 64 && Imm.isIntN(32) {
                return TCC_Free;
            }
        },
        Add => {
            Sub;
        },
        UDiv => {
            SDiv;
        },
        Mul => {
            Or;
        },
        Shl => {
            LShr;
        },
        Trunc => {
            ZExt;
        },
    }
    if Idx == ImmIdx {
        let mut NumConstants: u64 = divideCeil(BitSize, 64);
        let mut Cost: InstructionCost = self.getIntImmCost(Imm, Ty, CostKind);
        return if (Cost <= NumConstants * TCC_Basic) { TCC_Free as i32 } else { Cost };
    }
    return self.getIntImmCost(Imm, Ty, CostKind);
}

fn X86TTIImpl::getIntImmCostIntrin(self: *X86TTIImpl, IID: ID, Idx: u32, Imm: *APInt, Ty: *mut Type, CostKind: TargetCostKind) -> InstructionCost {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 {
        return TCC_Free;
    }
    match IID {
        _ => {
            return TCC_Free;
        },
        sadd_with_overflow => {
            uadd_with_overflow;
        },
        experimental_stackmap => {
            if (Idx < 2) || (Imm.getBitWidth() <= 64 && Imm.isSignedIntN(64)) {
                return TCC_Free;
            }
        },
        experimental_patchpoint_void => {
            experimental_patchpoint;
        },
    }
    return self.getIntImmCost(Imm, Ty, CostKind);
}

fn X86TTIImpl::getCFInstrCost(self: *X86TTIImpl, Opcode: u32, CostKind: TargetCostKind, I: *Instruction) -> InstructionCost {
    if CostKind != TCK_RecipThroughput {
        return if Opcode == PHI { TCC_Free } else { TCC_Basic };
    }
    return TCC_Free;
}

fn X86TTIImpl::getGatherOverhead(self: *X86TTIImpl) -> i32 {
    if self.ST.hasAVX512() || (self.ST.hasAVX2() && self.ST.hasFastGather()) {
        return 2;
    }
    return 1024;
}

fn X86TTIImpl::getScatterOverhead(self: *X86TTIImpl) -> i32 {
    if self.ST.hasAVX512() {
        return 2;
    }
    return 1024;
}

fn X86TTIImpl::getGSVectorCost(self: *X86TTIImpl, Opcode: u32, CostKind: TargetCostKind, SrcVTy: *mut Type, Ptr: *Value, Alignment: Align, AddressSpace: u32) -> InstructionCost {
    assert!(isa(SrcVTy), "Unexpected type in getGSVectorCost");
    let mut VF: u32 = cast(SrcVTy).getNumElements();
    let mut getIndexSizeInBits: Closure_20 = Closure_20 {};
    let mut IndexSize: u32 = if (self.ST.hasAVX512() && VF >= 16) { getIndexSizeInBits.call(Ptr, self.DL) } else { self.DL.getPointerSizeInBits(0) };
    let mut IndexVTy: *mut FixedVectorType = get(get(SrcVTy.getContext(), IndexSize), VF);
    let mut IdxsLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(IndexVTy);
    let mut SrcLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(SrcVTy);
    let mut SplitFactor: CostType = if IdxsLT.first > SrcLT.first { IdxsLT.first } else { SrcLT.first }.getValue();
    if SplitFactor > 1 {
        let mut SplitSrcTy: *mut FixedVectorType = get(SrcVTy.getScalarType(), VF / SplitFactor);
        return SplitFactor * self.getGSVectorCost(Opcode, CostKind, SplitSrcTy, Ptr, Alignment, AddressSpace);
    }
    if CostKind == TCK_CodeSize {
        return 1;
    }
    let mut GSOverhead: i32 = if (Opcode == Load) { self.getGatherOverhead() } else { self.getScatterOverhead() };
    return GSOverhead + VF * self.getMemoryOpCost(Opcode, SrcVTy.getScalarType(), Alignment, AddressSpace, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
}

fn X86TTIImpl::getGatherScatterOpCost(self: *X86TTIImpl, MICA: *MemIntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    let mut IsLoad: bool = MICA.getID() == masked_gather || MICA.getID() == vp_gather;
    let mut Opcode: u32 = if IsLoad { Load } else { Store };
    let mut SrcVTy: *mut Type = MICA.getDataType();
    let mut Ptr: *Value = MICA.getPointer();
    let mut Alignment: Align = MICA.getAlignment();
    if (Opcode == Load && (!self.isLegalMaskedGather(SrcVTy, Alignment) || self.forceScalarizeMaskedGather(cast(SrcVTy), Alignment))) || (Opcode == Store && (!self.isLegalMaskedScatter(SrcVTy, Alignment) || self.forceScalarizeMaskedScatter(cast(SrcVTy), Alignment))) {
        return self.getMemIntrinsicInstrCost(MICA, CostKind);
    }
    assert!(SrcVTy.isVectorTy(), "Unexpected data type for Gather/Scatter");
    let mut AddressSpace: u32 = MICA.getAddressSpace();
    return self.getGSVectorCost(Opcode, CostKind, SrcVTy, Ptr, Alignment, AddressSpace);
}

fn X86TTIImpl::isLSRCostLess(self: *X86TTIImpl, C1: *LSRCost, C2: *LSRCost) -> bool {
    return operator(tie(C1.Insns, C1.NumRegs, C1.AddRecCost, C1.NumIVMuls, C1.NumBaseAdds, C1.ScaleCost, C1.ImmCost, C1.SetupCost), tie(C2.Insns, C2.NumRegs, C2.AddRecCost, C2.NumIVMuls, C2.NumBaseAdds, C2.ScaleCost, C2.ImmCost, C2.SetupCost)) < 0;
}

fn X86TTIImpl::canMacroFuseCmp(self: *X86TTIImpl) -> bool {
    return self.ST.hasMacroFusion() || self.ST.hasBranchFusion();
}

fn isLegalMaskedLoadStore(ScalarTy: *mut Type, ST: *X86Subtarget) -> bool {
    if !ST.hasAVX() {
        return false;
    }
    if ScalarTy.isPointerTy() {
        return true;
    }
    if ScalarTy.isFloatTy() || ScalarTy.isDoubleTy() {
        return true;
    }
    if ScalarTy.isHalfTy() && ST.hasBWI() {
        return true;
    }
    if ScalarTy.isBFloatTy() && ST.hasBF16() {
        return true;
    }
    if !ScalarTy.isIntegerTy() {
        return false;
    }
    let mut IntWidth: u32 = ScalarTy.getIntegerBitWidth();
    return IntWidth == 32 || IntWidth == 64 || ((IntWidth == 8 || IntWidth == 16) && ST.hasBWI());
}

fn X86TTIImpl::isLegalMaskedLoad(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align, AddressSpace: u32, MaskKind: MaskKind) -> bool {
    let mut ScalarTy: *mut Type = DataTy.getScalarType();
    if isa(DataTy) && cast(DataTy).getNumElements() == 1 {
        return self.ST.hasCF() && self.hasConditionalLoadStoreForType(ScalarTy, false);
    }
    return isLegalMaskedLoadStore(ScalarTy, self.ST);
}

fn X86TTIImpl::isLegalMaskedStore(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align, AddressSpace: u32, MaskKind: MaskKind) -> bool {
    let mut ScalarTy: *mut Type = DataTy.getScalarType();
    if isa(DataTy) && cast(DataTy).getNumElements() == 1 {
        return self.ST.hasCF() && self.hasConditionalLoadStoreForType(ScalarTy, true);
    }
    return isLegalMaskedLoadStore(ScalarTy, self.ST);
}

fn X86TTIImpl::isLegalNTLoad(self: *X86TTIImpl, DataType: *mut Type, Alignment: Align) -> bool {
    let mut DataSize: u32 = self.DL.getTypeStoreSize(DataType).operator unsigned long long();
    if Alignment >= DataSize && (DataSize == 16 || DataSize == 32) {
        return if DataSize == 16 { self.ST.hasSSE1() } else { self.ST.hasAVX2() };
    }
    return false;
}

fn X86TTIImpl::isLegalNTStore(self: *X86TTIImpl, DataType: *mut Type, Alignment: Align) -> bool {
    let mut DataSize: u32 = self.DL.getTypeStoreSize(DataType).operator unsigned long long();
    if self.ST.hasSSE4A() && (DataType.isFloatTy() || DataType.isDoubleTy()) {
        return true;
    }
    if Alignment < DataSize || DataSize < 4 || DataSize > 32 || !isPowerOf2_32(DataSize) {
        return false;
    }
    if DataSize == 32 {
        return self.ST.hasAVX();
    }
    if DataSize == 16 {
        return self.ST.hasSSE1();
    }
    return true;
}

fn X86TTIImpl::isLegalBroadcastLoad(self: *X86TTIImpl, ElementTy: *mut Type, NumElements: ElementCount) -> bool {
    return self.ST.hasSSE3() && !NumElements.isScalable() && NumElements.getFixedValue() == 2 && ElementTy == getDoubleTy(ElementTy.getContext());
}

fn X86TTIImpl::isLegalMaskedExpandLoad(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    if !isa(DataTy) {
        return false;
    }
    if !self.ST.hasAVX512() {
        return false;
    }
    if cast(DataTy).getNumElements() == 1 {
        return false;
    }
    let mut ScalarTy: *mut Type = cast(DataTy).getElementType();
    if ScalarTy.isFloatTy() || ScalarTy.isDoubleTy() {
        return true;
    }
    if !ScalarTy.isIntegerTy() {
        return false;
    }
    let mut IntWidth: u32 = ScalarTy.getIntegerBitWidth();
    return IntWidth == 32 || IntWidth == 64 || ((IntWidth == 8 || IntWidth == 16) && self.ST.hasVBMI2());
}

fn X86TTIImpl::isLegalMaskedCompressStore(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    return self.isLegalMaskedExpandLoad(DataTy, Alignment);
}

fn X86TTIImpl::supportsGather(self: *X86TTIImpl) -> bool {
    return self.ST.hasAVX512() || (self.ST.hasFastGather() && self.ST.hasAVX2());
}

fn X86TTIImpl::forceScalarizeMaskedGather(self: *X86TTIImpl, VTy: *mut VectorType, Alignment: Align) -> bool {
    let mut NumElts: u32 = cast(VTy).getNumElements();
    return NumElts == 1 || (self.ST.hasAVX512() && (NumElts == 2 || (NumElts == 4 && !self.ST.hasVLX())));
}

fn X86TTIImpl::isLegalMaskedGatherScatter(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    let mut ScalarTy: *mut Type = DataTy.getScalarType();
    if ScalarTy.isPointerTy() {
        return true;
    }
    if ScalarTy.isFloatTy() || ScalarTy.isDoubleTy() {
        return true;
    }
    if !ScalarTy.isIntegerTy() {
        return false;
    }
    let mut IntWidth: u32 = ScalarTy.getIntegerBitWidth();
    return IntWidth == 32 || IntWidth == 64;
}

fn X86TTIImpl::isLegalMaskedGather(self: *X86TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    if !self.supportsGather() || !self.ST.preferGather() {
        return false;
    }
    return self.isLegalMaskedGatherScatter(DataTy, Alignment);
}

fn X86TTIImpl::isLegalAltInstr(self: *X86TTIImpl, VecTy: *mut VectorType, Opcode0: u32, Opcode1: u32, OpcodeMask: *SmallBitVector) -> bool {
    let mut NumElements: u32 = cast(VecTy).getNumElements();
    assert!(OpcodeMask.len == NumElements, "Mask and VecTy are incompatible");
    if !isPowerOf2_32(NumElements) {
        return false;
    }
    for Lane in seq(0, NumElements) {
        let mut Opc: u32 = if OpcodeMask.test(Lane) { Opcode1 } else { Opcode0 };
        if Lane % 2 == 0 && Opc != FSub {
            return false;
        }
        if Lane % 2 == 1 && Opc != FAdd {
            return false;
        }
    }
    let mut ElemTy: *mut Type = cast(VecTy).getElementType();
    if ElemTy.isFloatTy() {
        return self.ST.hasSSE3() && NumElements % 4 == 0;
    }
    if ElemTy.isDoubleTy() {
        return self.ST.hasSSE3() && NumElements % 2 == 0;
    }
    return false;
}

fn X86TTIImpl::isLegalMaskedScatter(self: *X86TTIImpl, DataType: *mut Type, Alignment: Align) -> bool {
    if !self.ST.hasAVX512() || !self.ST.preferScatter() {
        return false;
    }
    return self.isLegalMaskedGatherScatter(DataType, Alignment);
}

fn X86TTIImpl::hasDivRemOp(self: *X86TTIImpl, DataType: *mut Type, IsSigned: bool) -> bool {
    let mut VT: EVT = self.TLI.getValueType(self.DL, DataType, false);
    return self.TLI.isOperationLegal(if IsSigned { SDIVREM } else { UDIVREM }, VT);
}

fn X86TTIImpl::isExpensiveToSpeculativelyExecute(self: *X86TTIImpl, I: *Instruction) -> bool {
    if I.getOpcode() == FDiv {
        return true;
    }
    return self.isExpensiveToSpeculativelyExecute(I);
}

fn X86TTIImpl::isFCmpOrdCheaperThanFCmpZero(self: *X86TTIImpl, Ty: *mut Type) -> bool {
    return false;
}

fn X86TTIImpl::areInlineCompatible(self: *X86TTIImpl, Caller: *Function, Callee: *Function) -> bool {
    let mut TM: *TargetMachine = self.getTLI().getTargetMachine();
    let mut CallerSubtarget: *X86Subtarget = TM.getSubtarget(*Caller);
    let mut CalleeSubtarget: *X86Subtarget = TM.getSubtarget(*Callee);
    let mut CallerBits: *FeatureBitset = CallerSubtarget.getFeatureBits();
    let mut CalleeBits: *FeatureBitset = CalleeSubtarget.getFeatureBits();
    let mut InlineIgnoreFeatures: *FeatureBitset = CallerSubtarget.getInlineIgnoreFeatures();
    let mut RealCallerBits: FeatureBitset = CallerBits & operator(InlineIgnoreFeatures);
    let mut RealCalleeBits: FeatureBitset = CalleeBits & operator(InlineIgnoreFeatures);
    if (RealCallerBits & RealCalleeBits) != RealCalleeBits {
        return false;
    }
    if RealCallerBits == RealCalleeBits && CallerSubtarget.useAVX512Regs() == CalleeSubtarget.useAVX512Regs() {
        return true;
    }
    for I in instructions(Callee) {
        if dyn_cast(&mut I) {
            CB;
        } else {
            if CB.isInlineAsm() || CB.getIntrinsicID() != not_intrinsic {
                continue;
            }
            let mut Types: SmallVector<Type *, 8> = SmallVector<Type *, 8> {};
            for Arg in CB.args() {
                Types.push(Arg.getType());
            }
            if !CB.getType().isVoidTy() {
                Types.push(CB.getType());
            }
            let mut IsSimpleTy: Closure_21 = Closure_21 {};
            if all_of(Types, IsSimpleTy) {
                continue;
            }
            if !self.areTypesABICompatible(Caller, Callee, Types) {
                return false;
            }
        }
    }
    return true;
}

fn X86TTIImpl::areTypesABICompatible(self: *X86TTIImpl, Caller: *Function, Callee: *Function, Types: ArrayRef<Type *>) -> bool {
    let mut TM: *TargetMachine = self.getTLI().getTargetMachine();
    let mut CallerTLI: *TargetLowering = TM.getSubtargetImpl(*Caller).getTargetLowering();
    let mut CalleeTLI: *TargetLowering = TM.getSubtargetImpl(*Callee).getTargetLowering();
    let mut Ctx: *mut LLVMContext = Caller.getContext();
    let mut DL: *DataLayout = Caller.getDataLayout();
    let mut CC: ID = Callee.getCallingConv();
    return all_of(Types, Closure_22 { CallerTLI: &mut CallerTLI, DL: &mut DL, Ctx: &mut Ctx, CC: &mut CC, CalleeTLI: &mut CalleeTLI });
}

fn X86TTIImpl::enableMemCmpExpansion(self: *X86TTIImpl, OptSize: bool, IsZeroCmp: bool) -> MemCmpExpansionOptions {
    let mut Options: MemCmpExpansionOptions = MemCmpExpansionOptions {};
    Options.MaxNumLoads = self.TLI.getMaxExpandSizeMemcmp(OptSize);
    Options.NumLoadsPerBlock = if IsZeroCmp { 2 } else { 1 };
    Options.AllowOverlappingLoads = true;
    if IsZeroCmp {
        let mut PreferredWidth: u32 = self.ST.getPreferVectorWidth();
        if PreferredWidth >= 512 && self.ST.hasAVX512() {
            Options.LoadSizes.push(64);
        }
        if PreferredWidth >= 256 && self.ST.hasAVX() {
            Options.LoadSizes.push(32);
        }
        if PreferredWidth >= 128 && self.ST.hasSSE2() {
            Options.LoadSizes.push(16);
        }
    }
    if self.ST.is64Bit() {
        Options.LoadSizes.push(8);
    }
    Options.LoadSizes.push(4);
    Options.LoadSizes.push(2);
    Options.LoadSizes.push(1);
    return Options;
}

fn X86TTIImpl::prefersVectorizedAddressing(self: *X86TTIImpl) -> bool {
    return self.supportsGather();
}

fn X86TTIImpl::supportsEfficientVectorElementLoadStore(self: *X86TTIImpl) -> bool {
    return false;
}

fn X86TTIImpl::enableInterleavedAccessVectorization(self: *X86TTIImpl) -> bool {
    return !(self.ST.isAtom());
}

fn X86TTIImpl::shouldExpandReduction(self: *X86TTIImpl, II: *IntrinsicInst) -> bool {
    match II.getIntrinsicID() {
        _ => {
            return true;
        },
        vector_reduce_and => {
            vector_reduce_or;
        },
    }
}

fn X86TTIImpl::getInterleavedMemoryOpCostAVX512(self: *X86TTIImpl, Opcode: u32, VecTy: *mut FixedVectorType, Factor: u32, Indices: ArrayRef<unsigned int>, Alignment: Align, AddressSpace: u32, CostKind: TargetCostKind, UseMaskForCond: bool, UseMaskForGaps: bool) -> InstructionCost {
    let mut LegalVT: MVT = self.getTypeLegalizationCost(VecTy).second;
    let mut VecTySize: u32 = self.DL.getTypeStoreSize(VecTy).operator unsigned long long();
    let mut LegalVTSize: u32 = LegalVT.getStoreSize().operator unsigned long long();
    let mut NumOfMemOps: u32 = (VecTySize + LegalVTSize - 1) / LegalVTSize;
    let mut SingleMemOpTy: *mut FixedVectorType = get(VecTy.getElementType(), LegalVT.getVectorNumElements());
    let mut MemOpCost: InstructionCost = InstructionCost {};
    let mut UseMaskedMemOp: bool = UseMaskForCond || UseMaskForGaps;
    if UseMaskedMemOp {
        let mut IID: u32 = if Opcode == Load { masked_load } else { masked_store };
        MemOpCost = self.getMaskedMemoryOpCost(MemIntrinsicCostAttributes { IID, SingleMemOpTy, Alignment, AddressSpace, null }, CostKind);
    } else {
        MemOpCost = self.getMemoryOpCost(Opcode, SingleMemOpTy, Alignment, AddressSpace, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
    }
    let mut VF: u32 = VecTy.getNumElements() / Factor;
    let mut VT: MVT = getVectorVT(self.TLI.getSimpleValueType(self.DL, VecTy.getScalarType(), false), VF);
    let mut MaskCost: InstructionCost = InstructionCost {};
    if UseMaskedMemOp {
        let mut DemandedLoadStoreElts: APInt = getZero(VecTy.getNumElements());
        for Index in Indices {
            assert!(Index < Factor, "Invalid index for interleaved memory op");
            for let mut Elm: u32 = 0; Elm < VF; Elm += 1 {
                DemandedLoadStoreElts.setBit(Index + Elm * Factor);
            }
        }
        let mut I1Type: *mut Type = getInt1Ty(VecTy.getContext());
        MaskCost = self.getReplicationShuffleCost(I1Type, Factor, VF, if UseMaskForGaps { DemandedLoadStoreElts } else { getAllOnes(VecTy.getNumElements()) }, CostKind);
        if UseMaskForGaps {
            let mut MaskVT: *mut FixedVectorType = get(I1Type, VecTy.getNumElements());
            operator(MaskCost, self.getArithmeticInstrCost(And, MaskVT, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null));
        }
    }
    if Opcode == Load {
        let mut AVX512InterleavedLoadTbl: [3]CostTblEntry = [CostTblEntry { 3, v16i8, 12 }, CostTblEntry { 3, v32i8, 14 }, CostTblEntry { 3, v64i8, 22 }];
        if CostTableLookup(AVX512InterleavedLoadTbl, Factor, VT) {
            Entry;
        } else {
            return MaskCost + NumOfMemOps * MemOpCost + Entry.Cost;
        }
        let mut ShuffleKind: ShuffleKind = if (NumOfMemOps > 1) { SK_PermuteTwoSrc } else { SK_PermuteSingleSrc };
        let mut ShuffleCost: InstructionCost = self.getShuffleCost(ShuffleKind, SingleMemOpTy, SingleMemOpTy, CostKind, ArrayRef<int> {}, 0, null, ArrayRef<const Value *> {}, null, None);
        let mut NumOfLoadsInInterleaveGrp: u32 = if Indices.len { Indices.len } else { Factor };
        let mut ResultTy: *mut FixedVectorType = get(VecTy.getElementType(), VecTy.getNumElements() / Factor);
        let mut NumOfResults: InstructionCost = self.getTypeLegalizationCost(ResultTy).first * NumOfLoadsInInterleaveGrp;
        let mut NumOfUnfoldedLoads: u32 = if UseMaskedMemOp || NumOfResults > 1 { NumOfMemOps } else { NumOfMemOps / 2 };
        let mut NumOfShufflesPerResult: u32 = if 1 as u32 > (NumOfMemOps - 1) as u32 { 1 as u32 } else { (NumOfMemOps - 1) as u32 };
        let mut NumOfMoves: InstructionCost = 0;
        if NumOfResults > 1 && ShuffleKind == SK_PermuteTwoSrc {
            NumOfMoves = NumOfResults * NumOfShufflesPerResult / 2;
        }
        let mut Cost: InstructionCost = NumOfResults * NumOfShufflesPerResult * ShuffleCost + MaskCost + NumOfUnfoldedLoads * MemOpCost + NumOfMoves;
        return Cost;
    }
    assert!(Opcode == Store, "Expected Store Instruction at this  point");
    let mut AVX512InterleavedStoreTbl: [7]CostTblEntry = [CostTblEntry { 3, v16i8, 12 }, CostTblEntry { 3, v32i8, 14 }, CostTblEntry { 3, v64i8, 26 }, CostTblEntry { 4, v8i8, 10 }, CostTblEntry { 4, v16i8, 11 }, CostTblEntry { 4, v32i8, 14 }, CostTblEntry { 4, v64i8, 24 }];
    if CostTableLookup(AVX512InterleavedStoreTbl, Factor, VT) {
        Entry;
    } else {
        return MaskCost + NumOfMemOps * MemOpCost + Entry.Cost;
    }
    let mut NumOfSources: u32 = Factor;
    let mut ShuffleCost: InstructionCost = self.getShuffleCost(SK_PermuteTwoSrc, SingleMemOpTy, SingleMemOpTy, CostKind, ArrayRef<int> {}, 0, null, ArrayRef<const Value *> {}, null, None);
    let mut NumOfShufflesPerStore: u32 = NumOfSources - 1;
    let mut NumOfMoves: u32 = NumOfMemOps * NumOfShufflesPerStore / 2;
    let mut Cost: InstructionCost = MaskCost + NumOfMemOps * (MemOpCost + NumOfShufflesPerStore * ShuffleCost) + NumOfMoves;
    return Cost;
}

fn X86TTIImpl::getInterleavedMemoryOpCost(self: *X86TTIImpl, Opcode: u32, BaseTy: *mut Type, Factor: u32, Indices: ArrayRef<unsigned int>, Alignment: Align, AddressSpace: u32, CostKind: TargetCostKind, UseMaskForCond: bool, UseMaskForGaps: bool) -> InstructionCost {
    let mut VecTy: *mut FixedVectorType = cast(BaseTy);
    let mut isSupportedOnAVX512: Closure_24 = Closure_24 { cap_0: self };
    if self.ST.hasAVX512() && isSupportedOnAVX512.call(VecTy) {
        return self.getInterleavedMemoryOpCostAVX512(Opcode, VecTy, Factor, Indices, Alignment, AddressSpace, CostKind, UseMaskForCond, UseMaskForGaps);
    }
    if UseMaskForCond || UseMaskForGaps {
        return self.getInterleavedMemoryOpCost(Opcode, VecTy, Factor, Indices, Alignment, AddressSpace, CostKind, UseMaskForCond, UseMaskForGaps);
    }
    let mut LegalVT: MVT = self.getTypeLegalizationCost(VecTy).second;
    if !LegalVT.isVector() {
        return self.getInterleavedMemoryOpCost(Opcode, VecTy, Factor, Indices, Alignment, AddressSpace, CostKind, false, false);
    }
    let mut VF: u32 = VecTy.getNumElements() / Factor;
    let mut ScalarTy: *mut Type = VecTy.getElementType();
    if !ScalarTy.isIntegerTy() {
        ScalarTy = getIntNTy(ScalarTy.getContext(), self.DL.getTypeSizeInBits(ScalarTy).operator unsigned long long());
    }
    let mut MemOpCosts: InstructionCost = self.getMemoryOpCost(Opcode, VecTy, Alignment, AddressSpace, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
    let mut VT: *mut FixedVectorType = get(ScalarTy, VF);
    let mut ETy: EVT = self.TLI.getValueType(self.DL, VT, false);
    if !ETy.isSimple() {
        return self.getInterleavedMemoryOpCost(Opcode, VecTy, Factor, Indices, Alignment, AddressSpace, CostKind, false, false);
    }
    let mut AVX2InterleavedLoadTbl: [71]CostTblEntry = [CostTblEntry { 2, v2i8, 2 }, CostTblEntry { 2, v4i8, 2 }, CostTblEntry { 2, v8i8, 2 }, CostTblEntry { 2, v16i8, 4 }, CostTblEntry { 2, v32i8, 6 }, CostTblEntry { 2, v8i16, 6 }, CostTblEntry { 2, v16i16, 9 }, CostTblEntry { 2, v32i16, 18 }, CostTblEntry { 2, v8i32, 4 }, CostTblEntry { 2, v16i32, 8 }, CostTblEntry { 2, v32i32, 16 }, CostTblEntry { 2, v4i64, 4 }, CostTblEntry { 2, v8i64, 8 }, CostTblEntry { 2, v16i64, 16 }, CostTblEntry { 2, v32i64, 32 }, CostTblEntry { 3, v2i8, 3 }, CostTblEntry { 3, v4i8, 3 }, CostTblEntry { 3, v8i8, 6 }, CostTblEntry { 3, v16i8, 11 }, CostTblEntry { 3, v32i8, 14 }, CostTblEntry { 3, v2i16, 5 }, CostTblEntry { 3, v4i16, 7 }, CostTblEntry { 3, v8i16, 9 }, CostTblEntry { 3, v16i16, 28 }, CostTblEntry { 3, v32i16, 56 }, CostTblEntry { 3, v2i32, 3 }, CostTblEntry { 3, v4i32, 3 }, CostTblEntry { 3, v8i32, 7 }, CostTblEntry { 3, v16i32, 14 }, CostTblEntry { 3, v32i32, 32 }, CostTblEntry { 3, v2i64, 1 }, CostTblEntry { 3, v4i64, 5 }, CostTblEntry { 3, v8i64, 10 }, CostTblEntry { 3, v16i64, 20 }, CostTblEntry { 4, v2i8, 4 }, CostTblEntry { 4, v4i8, 4 }, CostTblEntry { 4, v8i8, 12 }, CostTblEntry { 4, v16i8, 24 }, CostTblEntry { 4, v32i8, 56 }, CostTblEntry { 4, v2i16, 6 }, CostTblEntry { 4, v4i16, 17 }, CostTblEntry { 4, v8i16, 33 }, CostTblEntry { 4, v16i16, 75 }, CostTblEntry { 4, v32i16, 150 }, CostTblEntry { 4, v2i32, 4 }, CostTblEntry { 4, v4i32, 8 }, CostTblEntry { 4, v8i32, 16 }, CostTblEntry { 4, v16i32, 32 }, CostTblEntry { 4, v32i32, 68 }, CostTblEntry { 4, v2i64, 6 }, CostTblEntry { 4, v4i64, 8 }, CostTblEntry { 4, v8i64, 20 }, CostTblEntry { 4, v16i64, 40 }, CostTblEntry { 6, v2i8, 6 }, CostTblEntry { 6, v4i8, 14 }, CostTblEntry { 6, v8i8, 18 }, CostTblEntry { 6, v16i8, 43 }, CostTblEntry { 6, v32i8, 82 }, CostTblEntry { 6, v2i16, 13 }, CostTblEntry { 6, v4i16, 9 }, CostTblEntry { 6, v8i16, 39 }, CostTblEntry { 6, v16i16, 106 }, CostTblEntry { 6, v32i16, 212 }, CostTblEntry { 6, v2i32, 6 }, CostTblEntry { 6, v4i32, 15 }, CostTblEntry { 6, v8i32, 31 }, CostTblEntry { 6, v16i32, 64 }, CostTblEntry { 6, v2i64, 6 }, CostTblEntry { 6, v4i64, 18 }, CostTblEntry { 6, v8i64, 36 }, CostTblEntry { 8, v8i32, 40 }];
    let mut SSSE3InterleavedLoadTbl: [1]CostTblEntry = [CostTblEntry { 2, v4i16, 2 }];
    let mut SSE2InterleavedLoadTbl: [5]CostTblEntry = [CostTblEntry { 2, v2i16, 2 }, CostTblEntry { 2, v4i16, 7 }, CostTblEntry { 2, v2i32, 2 }, CostTblEntry { 2, v4i32, 2 }, CostTblEntry { 2, v2i64, 2 }];
