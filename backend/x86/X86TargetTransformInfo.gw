        return TCC_Free;
    }
    if self.ST.useAVX512Regs() {
        if self.ST.hasBWI() {
            if ConvertCostTableLookup(AVX512BWConversionTbl, ISD, LTDest.second, LTSrc.second) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
            }
        }
        if self.ST.hasDQI() {
            if ConvertCostTableLookup(AVX512DQConversionTbl, ISD, LTDest.second, LTSrc.second) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
            }
        }
        if self.ST.hasAVX512() {
            if ConvertCostTableLookup(AVX512FConversionTbl, ISD, LTDest.second, LTSrc.second) {
                Entry;
            } else if Entry.Cost[CostKind] {
                KindCost;
            } else {
                return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
            }
        }
    }
    if self.ST.hasBWI() {
        if ConvertCostTableLookup(AVX512BWVLConversionTbl, ISD, LTDest.second, LTSrc.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
        }
    }
    if self.ST.hasDQI() {
        if ConvertCostTableLookup(AVX512DQVLConversionTbl, ISD, LTDest.second, LTSrc.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
        }
    }
    if self.ST.hasAVX512() {
        if ConvertCostTableLookup(AVX512VLConversionTbl, ISD, LTDest.second, LTSrc.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
        }
    }
    if self.ST.hasAVX2() {
        if ConvertCostTableLookup(AVX2ConversionTbl, ISD, LTDest.second, LTSrc.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
        }
    }
    if self.ST.hasAVX() {
        if ConvertCostTableLookup(AVXConversionTbl, ISD, LTDest.second, LTSrc.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
        }
    }
    if self.ST.hasF16C() {
        if ConvertCostTableLookup(F16ConversionTbl, ISD, LTDest.second, LTSrc.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
        }
    }
    if self.ST.hasSSE41() {
        if ConvertCostTableLookup(SSE41ConversionTbl, ISD, LTDest.second, LTSrc.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
        }
    }
    if self.ST.hasSSE2() {
        if ConvertCostTableLookup(SSE2ConversionTbl, ISD, LTDest.second, LTSrc.second) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return if LTSrc.first > LTDest.first { LTSrc.first } else { LTDest.first } * operator(KindCost);
        }
    }
    if (ISD == SINT_TO_FP || ISD == UINT_TO_FP) && 1 < Src.getScalarSizeInBits() && Src.getScalarSizeInBits() < 32 {
        let mut ExtSrc: *mut Type = Src.getWithNewBitWidth(32);
        let mut ExtOpc: u32 = if (ISD == SINT_TO_FP) { SExt } else { ZExt };
        let mut ExtCost: InstructionCost = 0;
        if !(Src.isIntegerTy() && I && isa(I.getOperand(0))) {
            ExtCost = self.getCastInstrCost(ExtOpc, ExtSrc, Src, CCH, CostKind, null);
        }
        return ExtCost + self.getCastInstrCost(SIToFP, Dst, ExtSrc, None, CostKind, null);
    }
    if (ISD == FP_TO_SINT || ISD == FP_TO_UINT) && 1 < Dst.getScalarSizeInBits() && Dst.getScalarSizeInBits() < 32 {
        let mut TruncDst: *mut Type = Dst.getWithNewBitWidth(32);
        return self.getCastInstrCost(FPToSI, TruncDst, Src, CCH, CostKind, null) + self.getCastInstrCost(Trunc, Dst, TruncDst, None, CostKind, null);
    }
    let mut AdjustCost: Closure_13 = Closure_13 { CostKind: &mut CostKind };
    return AdjustCost.call(self.getCastInstrCost(Opcode, Dst, Src, CCH, CostKind, I), 1);
}

fn X86TTIImpl::getCmpSelInstrCost(self: *X86TTIImpl, Opcode: u32, ValTy: *mut Type, CondTy: *mut Type, VecPred: Predicate, CostKind: TargetCostKind, Op1Info: OperandValueInfo, Op2Info: OperandValueInfo, I: *Instruction) -> InstructionCost {
    if !(ValTy.isIntOrIntVectorTy() || ValTy.isFPOrFPVectorTy()) {
        return self.getCmpSelInstrCost(Opcode, ValTy, CondTy, VecPred, CostKind, Op1Info, Op2Info, I);
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(ValTy);
    let mut MTy: MVT = LT.second;
    let mut ISD: i32 = self.TLI.InstructionOpcodeToISD(Opcode);
    assert!(ISD, "Invalid opcode");
    let mut ExtraCost: InstructionCost = 0;
    if Opcode == ICmp || Opcode == FCmp {
        if MTy.isVector() && !((self.ST.hasXOP() && (!self.ST.hasAVX2() || MTy.is128BitVector())) || (self.ST.hasAVX512() && 32 <= MTy.getScalarSizeInBits()) || self.ST.hasBWI()) {
            let mut Pred: Predicate = VecPred;
            if I && (Pred == BAD_ICMP_PREDICATE || Pred == BAD_FCMP_PREDICATE) {
                Pred = cast(I).getPredicate();
            }
            let mut CmpWithConstant: bool = false;
            if dyn_cast_or_null(I) {
                CmpInstr;
            } else {
                CmpWithConstant = isa(CmpInstr.getOperand(1));
            }
            match Pred {
                ICMP_NE => {
                    ExtraCost = if CmpWithConstant { 0 } else { 1 };
                },
                ICMP_SGE => {
                    ICMP_SLE;
                },
                ICMP_ULT => {
                    ICMP_UGT;
                },
                ICMP_ULE => {
                    ICMP_UGE;
                },
                FCMP_ONE => {
                    FCMP_UEQ;
                },
                BAD_ICMP_PREDICATE => {
                    BAD_FCMP_PREDICATE;
                },
                _ => {
                    break;
                },
            }
        }
    }
    let mut SLMCostTbl: [7]CostKindTblEntry = [CostKindTblEntry { SETCC, v2i64, 2, 5, 1, 2 }, CostKindTblEntry { SELECT, v2f64, 4, 4, 1, 3 }, CostKindTblEntry { SELECT, v4f32, 4, 4, 1, 3 }, CostKindTblEntry { SELECT, v2i64, 4, 4, 1, 3 }, CostKindTblEntry { SELECT, v8i32, 4, 4, 1, 3 }, CostKindTblEntry { SELECT, v8i16, 4, 4, 1, 3 }, CostKindTblEntry { SELECT, v16i8, 4, 4, 1, 3 }];
    let mut AVX512BWCostTbl: [6]CostKindTblEntry = [CostKindTblEntry { SETCC, v32i16, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v16i16, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v64i8, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v32i8, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v32i16, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v64i8, 1, 1, 1, 1 }];
    let mut AVX512CostTbl: [31]CostKindTblEntry = [CostKindTblEntry { SETCC, v8f64, 1, 4, 1, 1 }, CostKindTblEntry { SETCC, v4f64, 1, 4, 1, 1 }, CostKindTblEntry { SETCC, v16f32, 1, 4, 1, 1 }, CostKindTblEntry { SETCC, v8f32, 1, 4, 1, 1 }, CostKindTblEntry { SETCC, v8i64, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v4i64, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v2i64, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v16i32, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v8i32, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v32i16, 3, 7, 5, 5 }, CostKindTblEntry { SETCC, v64i8, 3, 7, 5, 5 }, CostKindTblEntry { SELECT, v8i64, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v4i64, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v2i64, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v16i32, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v8i32, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v4i32, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v8f64, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v4f64, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v2f64, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, f64, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v16f32, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v8f32, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v4f32, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, f32, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v32i16, 2, 2, 4, 4 }, CostKindTblEntry { SELECT, v16i16, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v8i16, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v64i8, 2, 2, 4, 4 }, CostKindTblEntry { SELECT, v32i8, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v16i8, 1, 1, 1, 1 }];
    let mut AVX2CostTbl: [16]CostKindTblEntry = [CostKindTblEntry { SETCC, v4f64, 1, 4, 1, 2 }, CostKindTblEntry { SETCC, v2f64, 1, 4, 1, 1 }, CostKindTblEntry { SETCC, f64, 1, 4, 1, 1 }, CostKindTblEntry { SETCC, v8f32, 1, 4, 1, 2 }, CostKindTblEntry { SETCC, v4f32, 1, 4, 1, 1 }, CostKindTblEntry { SETCC, f32, 1, 4, 1, 1 }, CostKindTblEntry { SETCC, v4i64, 1, 1, 1, 2 }, CostKindTblEntry { SETCC, v8i32, 1, 1, 1, 2 }, CostKindTblEntry { SETCC, v16i16, 1, 1, 1, 2 }, CostKindTblEntry { SETCC, v32i8, 1, 1, 1, 2 }, CostKindTblEntry { SELECT, v4f64, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v8f32, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v4i64, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v8i32, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v16i16, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v32i8, 2, 2, 1, 2 }];
    let mut XOPCostTbl: [2]CostKindTblEntry = [CostKindTblEntry { SETCC, v4i64, 4, 2, 5, 6 }, CostKindTblEntry { SETCC, v2i64, 1, 1, 1, 1 }];
    let mut AVX1CostTbl: [16]CostKindTblEntry = [CostKindTblEntry { SETCC, v4f64, 2, 3, 1, 2 }, CostKindTblEntry { SETCC, v2f64, 1, 3, 1, 1 }, CostKindTblEntry { SETCC, f64, 1, 3, 1, 1 }, CostKindTblEntry { SETCC, v8f32, 2, 3, 1, 2 }, CostKindTblEntry { SETCC, v4f32, 1, 3, 1, 1 }, CostKindTblEntry { SETCC, f32, 1, 3, 1, 1 }, CostKindTblEntry { SETCC, v4i64, 4, 2, 5, 6 }, CostKindTblEntry { SETCC, v8i32, 4, 2, 5, 6 }, CostKindTblEntry { SETCC, v16i16, 4, 2, 5, 6 }, CostKindTblEntry { SETCC, v32i8, 4, 2, 5, 6 }, CostKindTblEntry { SELECT, v4f64, 3, 3, 1, 2 }, CostKindTblEntry { SELECT, v8f32, 3, 3, 1, 2 }, CostKindTblEntry { SELECT, v4i64, 3, 3, 1, 2 }, CostKindTblEntry { SELECT, v8i32, 3, 3, 1, 2 }, CostKindTblEntry { SELECT, v16i16, 3, 3, 3, 3 }, CostKindTblEntry { SELECT, v32i8, 3, 3, 3, 3 }];
    let mut SSE42CostTbl: [1]CostKindTblEntry = [CostKindTblEntry { SETCC, v2i64, 1, 2, 1, 2 }];
    let mut SSE41CostTbl: [10]CostKindTblEntry = [CostKindTblEntry { SETCC, v2f64, 1, 5, 1, 1 }, CostKindTblEntry { SETCC, v4f32, 1, 5, 1, 1 }, CostKindTblEntry { SELECT, v2f64, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, f64, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v4f32, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, f32, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v2i64, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v4i32, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v8i16, 2, 2, 1, 2 }, CostKindTblEntry { SELECT, v16i8, 2, 2, 1, 2 }];
    let mut SSE2CostTbl: [12]CostKindTblEntry = [CostKindTblEntry { SETCC, v2f64, 2, 5, 1, 1 }, CostKindTblEntry { SETCC, f64, 1, 5, 1, 1 }, CostKindTblEntry { SETCC, v2i64, 5, 4, 5, 5 }, CostKindTblEntry { SETCC, v4i32, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v8i16, 1, 1, 1, 1 }, CostKindTblEntry { SETCC, v16i8, 1, 1, 1, 1 }, CostKindTblEntry { SELECT, v2f64, 2, 2, 3, 3 }, CostKindTblEntry { SELECT, f64, 2, 2, 3, 3 }, CostKindTblEntry { SELECT, v2i64, 2, 2, 3, 3 }, CostKindTblEntry { SELECT, v4i32, 2, 2, 3, 3 }, CostKindTblEntry { SELECT, v8i16, 2, 2, 3, 3 }, CostKindTblEntry { SELECT, v16i8, 2, 2, 3, 3 }];
    let mut SSE1CostTbl: [4]CostKindTblEntry = [CostKindTblEntry { SETCC, v4f32, 2, 5, 1, 1 }, CostKindTblEntry { SETCC, f32, 1, 5, 1, 1 }, CostKindTblEntry { SELECT, v4f32, 2, 2, 3, 3 }, CostKindTblEntry { SELECT, f32, 2, 2, 3, 3 }];
    if self.ST.useSLMArithCosts() {
        if CostTableLookup(SLMCostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if self.ST.hasBWI() {
        if CostTableLookup(AVX512BWCostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if self.ST.hasAVX512() {
        if CostTableLookup(AVX512CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if self.ST.hasAVX2() {
        if CostTableLookup(AVX2CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if self.ST.hasXOP() {
        if CostTableLookup(XOPCostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if self.ST.hasAVX() {
        if CostTableLookup(AVX1CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if self.ST.hasSSE42() {
        if CostTableLookup(SSE42CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if self.ST.hasSSE41() {
        if CostTableLookup(SSE41CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if self.ST.hasSSE2() {
        if CostTableLookup(SSE2CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if self.ST.hasSSE1() {
        if CostTableLookup(SSE1CostTbl, ISD, MTy) {
            Entry;
        } else if Entry.Cost[CostKind] {
            KindCost;
        } else {
            return LT.first * (ExtraCost + operator(KindCost));
        }
    }
    if CostKind == TCK_Latency && Opcode == Select {
        if ValTy.getScalarType().isFloatingPointTy() {
            return 3;
        }
    }
    return self.getCmpSelInstrCost(Opcode, ValTy, CondTy, VecPred, CostKind, Op1Info, Op2Info, I);
}

fn X86TTIImpl::getAtomicMemIntrinsicMaxElementSize(self: *X86TTIImpl) -> u32 {
    return 16;
}

