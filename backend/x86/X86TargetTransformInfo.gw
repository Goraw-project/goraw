    let mut SSE42CostTable: [17]CostKindTblEntry = [CostKindTblEntry { FADD, f64, 1, 3, 1, 1 }, CostKindTblEntry { FADD, f32, 1, 3, 1, 1 }, CostKindTblEntry { FADD, v2f64, 1, 3, 1, 1 }, CostKindTblEntry { FADD, v4f32, 1, 3, 1, 1 }, CostKindTblEntry { FSUB, f64, 1, 3, 1, 1 }, CostKindTblEntry { FSUB, f32, 1, 3, 1, 1 }, CostKindTblEntry { FSUB, v2f64, 1, 3, 1, 1 }, CostKindTblEntry { FSUB, v4f32, 1, 3, 1, 1 }, CostKindTblEntry { FMUL, f64, 1, 5, 1, 1 }, CostKindTblEntry { FMUL, f32, 1, 5, 1, 1 }, CostKindTblEntry { FMUL, v2f64, 1, 5, 1, 1 }, CostKindTblEntry { FMUL, v4f32, 1, 5, 1, 1 }, CostKindTblEntry { FDIV, f32, 14, 14, 1, 1 }, CostKindTblEntry { FDIV, v4f32, 14, 14, 1, 1 }, CostKindTblEntry { FDIV, f64, 22, 22, 1, 1 }, CostKindTblEntry { FDIV, v2f64, 22, 22, 1, 1 }, CostKindTblEntry { MUL, v2i64, 6, 10, 10, 10 }];
    if self.ST.hasSSE42() {
