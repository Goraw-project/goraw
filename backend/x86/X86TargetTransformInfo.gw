    let mut SSE1CostTable: [10]CostKindTblEntry = [CostKindTblEntry { FDIV, f32, 17, 18, 1, 1 }, CostKindTblEntry { FDIV, v4f32, 34, 48, 1, 1 }, CostKindTblEntry { FNEG, f32, 2, 2, 1, 2 }, CostKindTblEntry { FNEG, v4f32, 2, 2, 1, 2 }, CostKindTblEntry { FADD, f32, 1, 3, 1, 1 }, CostKindTblEntry { FADD, v4f32, 2, 3, 1, 1 }, CostKindTblEntry { FSUB, f32, 1, 3, 1, 1 }, CostKindTblEntry { FSUB, v4f32, 2, 3, 1, 1 }, CostKindTblEntry { FMUL, f32, 2, 5, 1, 1 }, CostKindTblEntry { FMUL, v4f32, 2, 5, 1, 1 }];
