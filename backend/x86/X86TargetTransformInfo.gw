dTblEntry { FSUB, f32, 2, 3, 1, 1 }, CostKindTblEntry { FSUB, f64, 2, 3, 1, 1 }, CostKindTblEntry { FSUB, v2f64, 2, 3, 1, 1 }, CostKindTblEntry { FMUL, f64, 2, 5, 1, 1 }, CostKindTblEntry { FMUL, v2f64, 2, 5, 1, 1 }];
    if self.ST.hasSSE2() {
