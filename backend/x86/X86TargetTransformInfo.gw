            NumEltRemaining -= CurrNumEltPerOp;
            Alignment = commonAlignment(Alignment, CurrOpSizeBytes);
        }
    }
    assert!(NumEltRemaining <= 0, "Should have processed all the elements.");
    return Cost;
}

fn X86TTIImpl::getMemIntrinsicInstrCost(self: *X86TTIImpl, MICA: *MemIntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    match MICA.getID() {
