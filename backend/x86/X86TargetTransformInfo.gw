    let mut X64CostTbl: [3]CostKindTblEntry = [CostKindTblEntry { ADD, i64, 1, ~0, ~0, ~0 }, CostKindTblEntry { SUB, i64, 1, ~0, ~0, ~0 }, CostKindTblEntry { MUL, i64, 2, 6, 1, 2 }];
    if self.ST.is64Bit() {
