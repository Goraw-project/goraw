struct CostKindCosts {
    RecipThroughputCost: u32,
    LatencyCost: u32,
    CodeSizeCost: u32,
    SizeAndLatencyCost: u32,
}

fn CostKindCosts::operator[](self: *CostKindCosts, Kind: TargetCostKind) -> optional<unsigned int> {
    let mut Cost: u32 = ~0;
    match Kind {
        TCK_RecipThroughput => {
            Cost = self.RecipThroughputCost;
        },
        TCK_Latency => {
            Cost = self.LatencyCost;
        },
        TCK_CodeSize => {
            Cost = self.CodeSizeCost;
        },
        TCK_SizeAndLatency => {
            Cost = self.SizeAndLatencyCost;
        },
    }
    if Cost == ~0 {
        return optional<unsigned int> { nullopt };
    }
    return Cost;
}

fn X86TTIImpl::getPopcntSupport(self: *X86TTIImpl, TyWidth: u32) -> PopcntSupportKind {
    assert!(isPowerOf2_32(TyWidth), "Ty width must be power of 2");
    return if self.ST() { PSK_FastHardware } else { PSK_Software };
}

fn X86TTIImpl::getCacheSize(self: *X86TTIImpl, Level: CacheLevel) -> optional<unsigned int> {
    match Level {
        L1D => {
            return 32 * 1024;
        },
        L2D => {
            return 256 * 1024;
        },
    }
    llvm_unreachable_internal("Unknown TargetTransformInfo::CacheLevel", "llvm\\lib\\Target\\X86\\X86TargetTransformInfo.cpp", 141);
}

fn X86TTIImpl::getCacheAssociativity(self: *X86TTIImpl, Level: CacheLevel) -> optional<unsigned int> {
    match Level {
        L1D => {
            
        },
        L2D => {
            return 8;
        },
    }
    llvm_unreachable_internal("Unknown TargetTransformInfo::CacheLevel", "llvm\\lib\\Target\\X86\\X86TargetTransformInfo.cpp", 162);
}

enum ClassIDEnum {
    GPRClass = 0,
    VectorClass = 1,
    ScalarFPClass = 2,
}

fn X86TTIImpl::getRegisterClassForType(self: *X86TTIImpl, Vector: bool, Ty: *mut Type) -> u32 {
    return if Vector { VectorClass } else { if Ty && Ty.isFloatingPointTy() { ScalarFPClass } else { GPRClass } };
}

fn X86TTIImpl::getNumberOfRegisters(self: *X86TTIImpl, ClassID: u32) -> u32 {
    if ClassID == VectorClass && !self.ST.hasSSE1() {
        return 0;
    }
    if operator!(self.ST()) {
        return 8;
    }
    if (ClassID == GPRClass && self.ST()) || (ClassID != GPRClass && self.ST.hasAVX512()) {
        return 32;
    }
    return 16;
}

fn X86TTIImpl::hasConditionalLoadStoreForType(self: *X86TTIImpl, Ty: *mut Type, IsStore: bool) -> bool {
    if operator!(self.ST()) {
        return false;
    }
    if !Ty {
        return true;
    }
    let mut VTy: *mut auto = dyn_cast(Ty);
    if !Ty.isIntegerTy() && (operator!() || () != 1) {
        return false;
    }
    let mut ScalarTy: *mut Type = Ty.getScalarType();
    match cast(ScalarTy)() {
        _ => {
            return false;
        },
        16 => {
            32;
        },
    }
}

fn X86TTIImpl::getRegisterBitWidth(self: *X86TTIImpl, K: RegisterKind) -> TypeSize {
    let mut PreferVectorWidth: u32 = self.ST.getPreferVectorWidth();
    match K {
        RGK_Scalar => {
            return getFixed(if self.ST() { 64 } else { 32 });
        },
        RGK_FixedWidthVector => {
            if self.ST.hasAVX512() && PreferVectorWidth >= 512 {
                return getFixed(512);
            }
        },
        RGK_ScalableVector => {
            return getScalable(0);
        },
    }
    llvm_unreachable_internal("Unsupported register kind", "llvm\\lib\\Target\\X86\\X86TargetTransformInfo.cpp", 228);
}

fn X86TTIImpl::getLoadStoreVecRegBitWidth(self: *X86TTIImpl, arg: u32) -> u32 {
    return self.getRegisterBitWidth(RGK_FixedWidthVector).getFixedValue();
}

fn X86TTIImpl::getMaxInterleaveFactor(self: *X86TTIImpl, VF: ElementCount, HasUnorderedReductions: bool) -> u32 {
    if VF.isScalar() {
        return 1;
    }
    if self.ST() {
        return 1;
    }
    if self.ST.hasAVX() {
        return 4;
    }
    return 2;
}

fn X86TTIImpl::getArithmeticInstrCost(self: *X86TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Op1Info: OperandValueInfo, Op2Info: OperandValueInfo, Args: ArrayRef<const Value *>, CtxI: *Instruction) -> InstructionCost {
