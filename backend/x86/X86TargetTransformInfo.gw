    let mut SSE2InterleavedStoreTbl: [6]CostTblEntry = [CostTblEntry { 2, v2i8, 1 }, CostTblEntry { 2, v4i8, 1 }, CostTblEntry { 2, v8i8, 1 }, CostTblEntry { 2, v2i16, 1 }, CostTblEntry { 2, v4i16, 1 }, CostTblEntry { 2, v2i32, 1 }];
    if Opcode == Load {
        let mut GetDiscountedCost: Closure_25 = Closure_25 { Factor: Factor, cap_1: Indices.len, cap_2: MemOpCosts };
        if self.ST.hasAVX2() {
            if CostTableLookup(AVX2InterleavedLoadTbl, Factor, ETy.getSimpleVT()) {
                Entry;
            } else {
                return GetDiscountedCost.call(Entry);
            }
        }
        if self.ST.hasSSSE3() {
            if CostTableLookup(SSSE3InterleavedLoadTbl, Factor, ETy.getSimpleVT()) {
                Entry;
            } else {
                return GetDiscountedCost.call(Entry);
