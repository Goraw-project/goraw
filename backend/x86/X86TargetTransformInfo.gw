                }
            }
            if CurrOpSizeBytes <= 32 / 8 && !Is0thSubVec && !FoldedInLaneInsert {
                let mut NumEltDoneInCurrXMM: i32 = NumEltDone() % NumEltPerXMM;
                assert!(NumEltDoneInCurrXMM % CurrNumEltPerOp == 0, "");
                let mut CoalescedVecEltIdx: i32 = NumEltDoneInCurrXMM / CurrNumEltPerOp;
                let mut DemandedElts: APInt = getBitsSet(CoalescedVecEltIdx, CoalescedVecEltIdx + 1);
