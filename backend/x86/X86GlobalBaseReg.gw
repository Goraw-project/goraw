struct X86GlobalBaseRegLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86GlobalBaseRegLegacy::getPassName(self: *X86GlobalBaseRegLegacy) -> str {
    return "X86 PIC Global Base Reg Initialization";
}

fn X86GlobalBaseRegLegacy::getAnalysisUsage(self: *X86GlobalBaseRegLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage(AU);
}

fn X86GlobalBaseRegLegacy::getPassKind(self: *X86GlobalBaseRegLegacy) -> PassKind {
    return self.Kind;
}

fn X86GlobalBaseRegLegacy::getPassID(self: *X86GlobalBaseRegLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86GlobalBaseRegLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86GlobalBaseRegLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86GlobalBaseRegLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86GlobalBaseRegLegacy::getResolver(self: *X86GlobalBaseRegLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86GlobalBaseRegLegacy::getRequiredProperties(self: *X86GlobalBaseRegLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86GlobalBaseRegLegacy::getSetProperties(self: *X86GlobalBaseRegLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86GlobalBaseRegLegacy::getClearedProperties(self: *X86GlobalBaseRegLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86GlobalBaseRegLegacyPass() -> *mut FunctionPass {
    return X86GlobalBaseRegLegacy {};
}

fn initGlobalBaseReg(MF: *mut MachineFunction) -> bool {
    let mut TM: *X86TargetMachine = &mut MF.getTarget() as *X86TargetMachine;
    let mut STI: *X86Subtarget = MF.getSubtarget();
    if !TM.isPositionIndependent() {
        return false;
    }
    let mut X86FI: *mut X86MachineFunctionInfo = MF.getInfo();
    let mut GlobalBaseReg: Register = X86FI.getGlobalBaseReg();
    if GlobalBaseReg == 0 {
        return false;
    }
    let mut FirstMBB: *mut MachineBasicBlock = MF.front();
    let mut MBBI: iterator = FirstMBB.begin();
    let mut DL: DebugLoc = FirstMBB.findDebugLoc(MBBI);
    let mut RegInfo: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut TII: *X86InstrInfo = STI.getInstrInfo();
    let mut PC: Register = 0;
    if STI.isPICStyleGOT() {
        PC = RegInfo.createVirtualRegister(&mut GR32RegClass, "");
    } else {
        PC = GlobalBaseReg;
    }
    if STI.is64Bit() {
        if TM.getCodeModel() == Large {
            let mut PBReg: Register = RegInfo.createVirtualRegister(&mut GR64RegClass, "");
            let mut GOTReg: Register = RegInfo.createVirtualRegister(&mut GR64RegClass, "");
            BuildMI(FirstMBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LEA64r), PBReg).addReg(RIP, RegState {}, 0).addImm(0).addReg(0, RegState {}, 0).addSym(MF.getPICBaseSymbol(), 0).addReg(0, RegState {}, 0);
            operator(prev(MBBI, 1)).setPreInstrSymbol(MF, MF.getPICBaseSymbol());
            BuildMI(FirstMBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOV64ri), GOTReg).addExternalSymbol("_GLOBAL_OFFSET_TABLE_", MO_PIC_BASE_OFFSET);
            BuildMI(FirstMBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(ADD64rr), PC).addReg(PBReg, Kill, 0).addReg(GOTReg, Kill, 0);
        } else {
            BuildMI(FirstMBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LEA64r), PC).addReg(RIP, RegState {}, 0).addImm(0).addReg(0, RegState {}, 0).addExternalSymbol("_GLOBAL_OFFSET_TABLE_", 0).addReg(0, RegState {}, 0);
        }
    } else {
        BuildMI(FirstMBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOVPC32r), PC).addImm(0);
        if STI.isPICStyleGOT() {
            BuildMI(FirstMBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(ADD32ri), GlobalBaseReg).addReg(PC, RegState {}, 0).addExternalSymbol("_GLOBAL_OFFSET_TABLE_", MO_GOT_ABSOLUTE_ADDRESS);
        }
    }
    return true;
}

fn X86GlobalBaseRegLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return initGlobalBaseReg(MF);
}

fn X86GlobalBaseRegPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if initGlobalBaseReg(MF) { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}
