struct X86ArgumentStackSlotLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86ArgumentStackSlotLegacy::getAnalysisUsage(self: *X86ArgumentStackSlotLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage(AU);
}

fn X86ArgumentStackSlotLegacy::getPassKind(self: *X86ArgumentStackSlotLegacy) -> PassKind {
    return self.Kind;
}

fn X86ArgumentStackSlotLegacy::getPassID(self: *X86ArgumentStackSlotLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86ArgumentStackSlotLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86ArgumentStackSlotLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86ArgumentStackSlotLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86ArgumentStackSlotLegacy::getResolver(self: *X86ArgumentStackSlotLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86ArgumentStackSlotLegacy::getRequiredProperties(self: *X86ArgumentStackSlotLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86ArgumentStackSlotLegacy::getSetProperties(self: *X86ArgumentStackSlotLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86ArgumentStackSlotLegacy::getClearedProperties(self: *X86ArgumentStackSlotLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86ArgumentStackSlotLegacyPass() -> *mut FunctionPass {
    return X86ArgumentStackSlotLegacy {};
}

fn getArgBaseReg(MF: *mut MachineFunction) -> Register {
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut STI: *X86Subtarget = MF;
    let mut F: *Function = MF.getFunction();
    let mut CC: ID = F.getCallingConv();
    let mut NoReg: Register = Register { Reg: 0 };
    let mut RC: *TargetRegisterClass = null;
    match CC {
        C => {
            
        },
        X86_RegCall => {
            
        },
        _ => {
            break;
        },
    }
    if RC {
        return MRI.createVirtualRegister(RC, "");
    } else {
        return NoReg;
    }
}

fn argumentStackSlotRebase(MF: *mut MachineFunction) -> bool {
    let mut F: *Function = MF.getFunction();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut STI: *X86Subtarget = MF;
    let mut TRI: *X86RegisterInfo = STI.getRegisterInfo();
    let mut TII: *X86InstrInfo = STI.getInstrInfo();
    let mut X86FI: *mut X86MachineFunctionInfo = MF;
    let mut Changed: bool = false;
    if F.hasFnAttribute(Naked) {
        return false;
    }
    if !STI.isTargetLinux() && !STI.isTargetELF() {
        return false;
    }
    if !TRI.hasBasePointer(MF) {
        return false;
    }
    if STI.isTarget64BitILP32() {
        return false;
    }
    let mut BasePtr: Register = TRI.getBaseRegister();
    let mut IsBaseRegisterClobbered: Closure_1 = Closure_1 { MF: &mut MF, TRI: &mut TRI, BasePtr: &mut BasePtr };
    if !IsBaseRegisterClobbered.call() {
        return false;
    }
    let mut ArgBaseReg: Register = getArgBaseReg(MF);
    if !ArgBaseReg.isValid() {
        return false;
    }
    let mut MBB: *mut MachineBasicBlock = MF.front();
    let mut MBBI: iterator = MBB.begin();
    let mut DL: DebugLoc = DebugLoc { Loc: null };
    let mut SlotSize: u32 = TRI.getSlotSize();
    let mut FI: i32 = MFI.CreateSpillStackObject(SlotSize, Align { ShiftValue: SlotSize }, Default);
    let mut LEA: *mut MachineInstr = BuildMI(MBB, MBBI, DL, TII(), ArgBaseReg)(FI)(1)(SlotSize)(FrameSetup);
    X86FI.setStackPtrSaveMI(LEA);
    for MBB in MF {
        for MI in MBB {
            let mut I: i32 = 0;
            for MO in MI.operands() {
                if MO.isFI() {
                    let mut Idx: i32 = MO.getIndex();
                    if !MFI.isFixedObjectIndex(Idx) {
                        continue;
                    }
                    let mut Offset: i64 = MFI.getObjectOffset(Idx);
                    if Offset < 0 {
                        continue;
                    }
                    if MI.isDebugInstr() {
                        continue;
                    }
                    TRI.eliminateFrameIndex(iterator { MI.getIterator() }, I, ArgBaseReg, Offset);
                    Changed = true;
                }
                I += 1;
            }
        }
    }
    return Changed;
}

fn X86ArgumentStackSlotLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return argumentStackSlotRebase(MF);
}

fn X86ArgumentStackSlotPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if argumentStackSlotRebase(MF) { getMachineFunctionPassPreservedAnalyses() } else { all() };
}

struct Closure_1 {
    MF: *mut MachineFunction,
    TRI: *mut *X86RegisterInfo,
    BasePtr: *mut Register,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> bool {
        for MBB in (*self.MF) {
            for MI in MBB {
                if !MI.isInlineAsm() {
                    continue;
                }
                for MO in MI.operands() {
                    if !MO.isReg() {
                        continue;
                    }
                    let mut Reg: Register = MO.getReg();
                    if !Reg.isPhysical() {
                        continue;
                    }
                    if (*self.TRI)()((*self.BasePtr), Reg) {
                        return true;
                    }
                }
            }
        }
        return false;
    }
