fn X86FixupSetCCLegacy::getClearedProperties(self: *X86FixupSetCCLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86FixupSetCCLegacyPass() -> *mut FunctionPass {
    return X86FixupSetCCLegacy {};
}

fn fixupSetCC(MF: *mut MachineFunction) -> bool {
    let mut Changed: bool = false;
    let mut MRI: *mut MachineRegisterInfo = &mut MF.getRegInfo();
    let mut ST: *X86Subtarget = operator&(MF);
    let mut TII: *X86InstrInfo = ST.getInstrInfo();
    let mut ToErase: SmallVector<MachineInstr *, 4> = zeroed();
    for MBB in MF {
        let mut FlagsDefMI: *mut MachineInstr = null;
        for MI in MBB {
            if MI.definesRegister {
                FlagsDefMI = &mut MI;
            }
            if  {
                continue;
            }
            let mut ZExt: *mut MachineInstr = null;
            let mut Reg0: Register = MI.getOperand(0).getReg();
            if !ZExt {
                continue;
            }
            if !FlagsDefMI {
                continue;
            }
            let mut UseSetZUCC: bool = ST()() && operator!(ST()());
            if !UseSetZUCC && FlagsDefMI.readsRegister {
                continue;
            }
            let mut RC: *TargetRegisterClass = null;
            if !MRI.constrainRegClass(ZExt.getOperand(0).getReg(), RC, 0) {
                continue;
            }
            operator(NumSubstZexts);
            Changed = true;
            let mut ZeroReg: Register = MRI.createVirtualRegister(RC, "");
            if UseSetZUCC {
                MI.setDesc(TII());
                BuildMI(*ZExt.getParent(), ZExt, ZExt.getDebugLoc(), TII()(IMPLICIT_DEF), ZeroReg);
            } else {
                BuildMI(MBB, FlagsDefMI, MI.getDebugLoc(), TII(), ZeroReg)(1);
            }
            BuildMI(*ZExt.getParent(), ZExt, ZExt.getDebugLoc(), TII(), ZExt.getOperand(0).getReg())(ZeroReg)(Reg0);
            if ZExt.peekDebugInstrNum() {
                InstrNum;
            } else {
                MF.makeDebugValueSubstitution;
            }
            ToErase()(ZExt);
        }
    }
    return Changed;
}

fn X86FixupSetCCLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return fixupSetCC(MF);
}

fn X86FixupSetCCPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if fixupSetCC(MF) { getMachineFunctionPassPreservedAnalyses() } else { all() };
}
