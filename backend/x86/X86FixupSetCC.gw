static mut NumSubstZexts: Statistic = Statistic { "x86-fixup-setcc", "NumSubstZexts", "Number of setcc + zext pairs substituted" };

struct X86FixupSetCCLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86FixupSetCCLegacy::getPassName(self: *X86FixupSetCCLegacy) -> str {
    return "X86 Fixup SetCC";
}

fn X86FixupSetCCLegacy::getAnalysisUsage(self: *X86FixupSetCCLegacy, AU: *mut AnalysisUsage) {
    AU.addPreserved();
    self.getAnalysisUsage(AU);
}

fn X86FixupSetCCLegacy::getPassKind(self: *X86FixupSetCCLegacy) -> PassKind {
    return self.Kind;
}

fn X86FixupSetCCLegacy::getPassID(self: *X86FixupSetCCLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86FixupSetCCLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FixupSetCCLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FixupSetCCLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86FixupSetCCLegacy::getResolver(self: *X86FixupSetCCLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86FixupSetCCLegacy::getRequiredProperties(self: *X86FixupSetCCLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86FixupSetCCLegacy::getSetProperties(self: *X86FixupSetCCLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86FixupSetCCLegacy::getClearedProperties(self: *X86FixupSetCCLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createX86FixupSetCCLegacyPass() -> *mut FunctionPass {
    return X86FixupSetCCLegacy {};
}

fn fixupSetCC(MF: *mut MachineFunction) -> bool {
    let mut Changed: bool = false;
    let mut MRI: *mut MachineRegisterInfo = &mut MF.getRegInfo();
    let mut ST: *X86Subtarget = &mut MF.getSubtarget();
    let mut TII: *X86InstrInfo = ST.getInstrInfo();
    let mut ToErase: SmallVector<MachineInstr *, 4> = SmallVector<MachineInstr *, 4> {};
    for MBB in MF {
        let mut FlagsDefMI: *mut MachineInstr = null;
        for MI in MBB {
            if MI.definesRegister(EFLAGS, null) {
                FlagsDefMI = &mut MI;
            }
            if MI.getOpcode() != SETCCr && MI.getOpcode() != SETZUCCr {
                continue;
            }
            let mut ZExt: *mut MachineInstr = null;
            let mut Reg0: Register = MI.getOperand(0).getReg();
            for Use in MRI.use_instructions(Reg0) {
                if Use.getOpcode() == MOVZX32rr8 {
                    ZExt = &mut Use;
                }
            }
            if !ZExt {
                continue;
            }
            if !FlagsDefMI {
                continue;
            }
            let mut UseSetZUCC: bool = ST.hasZU() && !ST.preferLegacySetCC();
            if !UseSetZUCC && FlagsDefMI.readsRegister(EFLAGS, null) {
                continue;
            }
            let mut RC: *TargetRegisterClass = if ST.is64Bit() { &mut GR32RegClass } else { &mut GR32_ABCDRegClass };
            if !MRI.constrainRegClass(ZExt.getOperand(0).getReg(), RC, 0) {
                continue;
            }
            operator(NumSubstZexts);
            Changed = true;
            let mut ZeroReg: Register = MRI.createVirtualRegister(RC, "");
            if UseSetZUCC {
                MI.setDesc(TII.get(SETZUCCr));
                BuildMI(*ZExt.getParent(), ZExt, MIMetadata { DL: ZExt.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(IMPLICIT_DEF), ZeroReg);
            } else {
                BuildMI(MBB, FlagsDefMI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOV32r0), ZeroReg).setOperandDead(1);
            }
            BuildMI(*ZExt.getParent(), ZExt, MIMetadata { DL: ZExt.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(INSERT_SUBREG), ZExt.getOperand(0).getReg()).addReg(ZeroReg, RegState {}, 0).addReg(Reg0, RegState {}, 0).addImm(sub_8bit);
            if ZExt.peekDebugInstrNum() {
                InstrNum;
            } else {
                MF.makeDebugValueSubstitution(DebugInstrOperandPair { InstrNum, 0 }, DebugInstrOperandPair { MI.getDebugInstrNum(), 0 }, 0);
            }
            ToErase.push(ZExt);
        }
    }
    for I in ToErase {
        I.eraseFromParent();
    }
    return Changed;
}

fn X86FixupSetCCLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return fixupSetCC(MF);
}

fn X86FixupSetCCPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if fixupSetCC(MF) { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}
