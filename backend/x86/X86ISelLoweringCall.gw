fn CreateCopyOfByValArgument(Src: SDValue, Dst: SDValue, Chain: SDValue, Flags: ArgFlagsTy, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    let mut SizeNode: SDValue = DAG.getIntPtrConstant(Flags.getByValSize(), dl, false);
    let mut Alignment: Align = Flags.getNonZeroByValAlign();
    return DAG.getMemcpy(Chain, dl, Dst, Src, SizeNode, Alignment, Alignment, false, true, null, nullopt, MachinePointerInfo { 0, 0 }, MachinePointerInfo { 0, 0 }, AAMDNodes {}, null);
}

fn canGuaranteeTCO(CC: ID) -> bool {
    return (CC == Fast || CC == GHC || CC == X86_RegCall || CC == HiPE || CC == Tail || CC == SwiftTail);
}

fn mayTailCallThisCC(CC: ID) -> bool {
    match CC {
        C => {
            Win64;
        },
        _ => {
            return canGuaranteeTCO(CC);
        },
    }
}

fn shouldGuaranteeTCO(CC: ID, GuaranteedTailCallOpt: bool) -> bool {
    return (GuaranteedTailCallOpt && canGuaranteeTCO(CC)) || CC == Tail || CC == SwiftTail;
}

fn X86TargetLowering::mayBeEmittedAsTailCall(self: *X86TargetLowering, CI: *CallInst) -> bool {
    if !CI.isTailCall() {
        return false;
    }
    let mut CalleeCC: ID = CI.getCallingConv();
    if !mayTailCallThisCC(CalleeCC) {
        return false;
    }
    return true;
}

fn X86TargetLowering::LowerMemArgument(self: *X86TargetLowering, Chain: SDValue, CallConv: ID, Ins: *InputArg>, dl: *SDLoc, DAG: *mut SelectionDAG, VA: *CCValAssign, MFI: *mut MachineFrameInfo, i: u32) -> SDValue {
    let mut Flags: ArgFlagsTy = Ins[i].Flags;
    let mut AlwaysUseMutable: bool = shouldGuaranteeTCO(CallConv, DAG.getTarget().Options.GuaranteedTailCallOpt);
    let mut isImmutable: bool = !AlwaysUseMutable && !Flags.isByVal();
    let mut ValVT: EVT = EVT {};
    let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut ExtendedInMem: bool = VA.isExtInLoc() && VA.getValVT().getScalarType() == i1 && VA.getValVT().getSizeInBits() != VA.getLocVT().getSizeInBits();
    if VA.getLocInfo() == Indirect || ExtendedInMem {
        ValVT = VA.getLocVT();
    } else {
        ValVT = VA.getValVT();
    }
    if Flags.isByVal() {
        let mut Bytes: u32 = Flags.getByValSize();
        if Bytes == 0 {
            Bytes = 1;
        }
        let mut FI: i32 = MFI.CreateFixedObject(Bytes, VA.getLocMemOffset(), isImmutable, true);
        return DAG.getFrameIndex(FI, PtrVT, false);
    }
    let mut ArgVT: EVT = Ins[i].ArgVT;
    let mut ScalarizedVector: bool = ArgVT.isVector() && !VA.getLocVT().isVector();
    if Flags.isCopyElisionCandidate() && VA.getLocInfo() != Indirect && !ExtendedInMem && !ScalarizedVector {
        let mut PartAddr: SDValue = SDValue {};
        if Ins[i].PartOffset == 0 {
            let mut FI: i32 = MFI.CreateFixedObject(ArgVT.getStoreSize().operator unsigned long long(), VA.getLocMemOffset(), false, false);
            PartAddr = DAG.getFrameIndex(FI, PtrVT, false);
            return DAG.getLoad(ValVT, dl, Chain, PartAddr, getFixedStack(DAG.getMachineFunction(), FI, 0), MaybeAlign {}, MONone, MMOMetadata {});
        }
        let mut PartBegin: i64 = VA.getLocMemOffset();
        let mut PartEnd: i64 = PartBegin + ValVT.getSizeInBits().operator unsigned long long() / 8;
        let mut FI: i32 = MFI.getObjectIndexBegin();
        for ; MFI.isFixedObjectIndex(FI); FI += 1 {
            let mut ObjBegin: i64 = MFI.getObjectOffset(FI);
            let mut ObjEnd: i64 = ObjBegin + MFI.getObjectSize(FI);
            if ObjBegin <= PartBegin && PartEnd <= ObjEnd {
                break;
            }
        }
        if MFI.isFixedObjectIndex(FI) {
            let mut Addr: SDValue = DAG.getNode(ADD, dl, PtrVT, DAG.getFrameIndex(FI, PtrVT, false), DAG.getIntPtrConstant(Ins[i].PartOffset, dl, false));
            return DAG.getLoad(ValVT, dl, Chain, Addr, getFixedStack(DAG.getMachineFunction(), FI, Ins[i].PartOffset), MaybeAlign {}, MONone, MMOMetadata {});
        }
    }
    let mut FI: i32 = MFI.CreateFixedObject(ValVT.getSizeInBits().operator unsigned long long() / 8, VA.getLocMemOffset(), isImmutable, false);
    if VA.getLocInfo() == ZExt {
        MFI.setObjectZExt(FI, true);
    } else if VA.getLocInfo() == SExt {
        MFI.setObjectSExt(FI, true);
    }
    let mut Alignment: MaybeAlign = MaybeAlign {};
    if self.Subtarget.isTargetWindowsMSVC() && !self.Subtarget.is64Bit() && ValVT != f80 {
        Alignment = 4;
    }
    let mut FIN: SDValue = DAG.getFrameIndex(FI, PtrVT, false);
    let mut Val: SDValue = DAG.getLoad(ValVT, dl, Chain, FIN, getFixedStack(DAG.getMachineFunction(), FI, 0), Alignment, MONone, MMOMetadata {});
    return if ExtendedInMem { (if VA.getValVT().isVector() { DAG.getNode(SCALAR_TO_VECTOR, dl, VA.getValVT(), Val) } else { DAG.getNode(TRUNCATE, dl, VA.getValVT(), Val) }) } else { Val };
}

fn get64BitArgumentGPRs(CallConv: ID, Subtarget: *X86Subtarget) -> ArrayRef<MCPhysReg> {
    assert!(Subtarget.is64Bit();
    if Subtarget.isCallingConvWin64(CallConv) {
        let mut GPR64ArgRegsWin64: [4]MCPhysReg = [RCX, RDX, R8, R9];
        return GPR64ArgRegsWin64;
    }
    let mut GPR64ArgRegs64Bit: [6]MCPhysReg = [RDI, RSI, RDX, RCX, R8, R9];
    return GPR64ArgRegs64Bit;
}

fn get64BitArgumentXMMs(MF: *mut MachineFunction, CallConv: ID, Subtarget: *X86Subtarget) -> ArrayRef<MCPhysReg> {
    assert!(Subtarget.is64Bit();
    if Subtarget.isCallingConvWin64(CallConv) {
        return ArrayRef<MCPhysReg> {};
    }
    let mut isSoftFloat: bool = Subtarget.useSoftFloat();
    if isSoftFloat || !Subtarget.hasSSE1() {
        return ArrayRef<MCPhysReg> {};
    }
    let mut XMMArgRegs64Bit: [8]MCPhysReg = [XMM0, XMM1, XMM2, XMM3, XMM4, XMM5, XMM6, XMM7];
    return XMMArgRegs64Bit;
}

fn isSortedByValueNo(ArgLocs: ArrayRef<CCValAssign>) -> bool {
    return is_sorted(ArgLocs, Closure_3 {});
}

struct VarArgsLoweringHelper {
    FuncInfo: *mut X86MachineFunctionInfo,
    DL: *SDLoc,
    DAG: *mut SelectionDAG,
    Subtarget: *X86Subtarget,
    TheMachineFunction: *mut MachineFunction,
    TheFunction: *Function,
    FrameInfo: *mut MachineFrameInfo,
    FrameLowering: *TargetFrameLowering,
    TargLowering: *TargetLowering,
    CallConv: ID,
    CCInfo: *mut CCState,
}

fn VarArgsLoweringHelper::is64Bit(self: *VarArgsLoweringHelper) -> bool {
    return self.Subtarget.is64Bit();
}

fn VarArgsLoweringHelper::isWin64(self: *VarArgsLoweringHelper) -> bool {
    return self.Subtarget.isCallingConvWin64(self.CallConv);
}

fn VarArgsLoweringHelper::createVarArgAreaAndStoreRegisters(self, Chain: *mut SDValue, StackSize: u32) {
    if self.is64Bit() || (self.CallConv != X86_FastCall && self.CallConv != X86_ThisCall) {
        self.FuncInfo.setVarArgsFrameIndex(self.FrameInfo.CreateFixedObject(1, StackSize, true, false));
    }
    if self.is64Bit() {
        let mut ArgGPRs: ArrayRef<MCPhysReg> = get64BitArgumentGPRs(self.CallConv, self.Subtarget);
        let mut ArgXMMs: ArrayRef<MCPhysReg> = get64BitArgumentXMMs(self.TheMachineFunction, self.CallConv, self.Subtarget);
        let mut NumIntRegs: u32 = self.CCInfo.getFirstUnallocated(ArgGPRs);
        let mut NumXMMRegs: u32 = self.CCInfo.getFirstUnallocated(ArgXMMs);
        assert!(!(NumXMMRegs && !self.Subtarget.hasSSE1()), "SSE register cannot be used when SSE is disabled!");
        if self.isWin64() {
            let mut HomeOffset: i32 = self.FrameLowering.getOffsetOfLocalArea() + 8;
            self.FuncInfo.setRegSaveFrameIndex(self.FrameInfo.CreateFixedObject(1, NumIntRegs * 8 + HomeOffset, false, false));
            if NumIntRegs < 4 {
                self.FuncInfo.setVarArgsFrameIndex(self.FuncInfo.getRegSaveFrameIndex());
            }
        } else {
            self.FuncInfo.setVarArgsGPOffset(NumIntRegs * 8);
            self.FuncInfo.setVarArgsFPOffset(ArgGPRs.len * 8 + NumXMMRegs * 16);
            self.FuncInfo.setRegSaveFrameIndex(self.FrameInfo.CreateStackObject(ArgGPRs.len * 8 + ArgXMMs.len * 16, 16, false, null, 0));
        }
        let mut LiveGPRs: SmallVector<SDValue, 6> = SmallVector<SDValue, 6> {};
        let mut LiveXMMRegs: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        let mut ALVal: SDValue = SDValue {};
        for Reg in ArgGPRs.slice(NumIntRegs) {
            let mut GPR: Register = self.TheMachineFunction.addLiveIn(Reg, &mut GR64RegClass);
            LiveGPRs.push(self.DAG.getCopyFromReg(Chain, self.DL, GPR, i64));
        }
        let mut AvailableXmms: *ArrayRef<unsigned short> = ArgXMMs.slice(NumXMMRegs);
        if !AvailableXmms.is_empty() {
            let mut AL: Register = self.TheMachineFunction.addLiveIn(AL, &mut GR8RegClass);
            ALVal = self.DAG.getCopyFromReg(Chain, self.DL, AL, i8);
            for Reg in AvailableXmms {
                self.TheMachineFunction.getRegInfo().addLiveIn(Reg, Register { Reg: 0 });
                LiveXMMRegs.push(self.DAG.getRegister(Reg, v4f32));
            }
        }
        let mut MemOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        let mut RSFIN: SDValue = self.DAG.getFrameIndex(self.FuncInfo.getRegSaveFrameIndex(), self.TargLowering.getPointerTy(self.DAG.getDataLayout(), 0), false);
        let mut Offset: u32 = self.FuncInfo.getVarArgsGPOffset();
        for Val in LiveGPRs {
            let mut FIN: SDValue = self.DAG.getNode(ADD, self.DL, self.TargLowering.getPointerTy(self.DAG.getDataLayout(), 0), RSFIN, self.DAG.getIntPtrConstant(Offset, self.DL, false));
            let mut Store: SDValue = self.DAG.getStore(Val.getValue(1), self.DL, Val, FIN, getFixedStack(self.DAG.getMachineFunction(), self.FuncInfo.getRegSaveFrameIndex(), Offset), MaybeAlign {}, MONone, MMOMetadata {});
            MemOps.push(Store);
            Offset += 8;
        }
        if !LiveXMMRegs.is_empty() {
            let mut SaveXMMOps: SmallVector<SDValue, 12> = SmallVector<SDValue, 12> {};
            SaveXMMOps.push(Chain);
            SaveXMMOps.push(ALVal);
            SaveXMMOps.push(RSFIN);
            SaveXMMOps.push(self.DAG.getTargetConstant(self.FuncInfo.getVarArgsFPOffset(), self.DL, i32, false));
            append_range(SaveXMMOps, LiveXMMRegs);
            let mut StoreMMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(getFixedStack(self.DAG.getMachineFunction(), self.FuncInfo.getRegSaveFrameIndex(), Offset), MOStore, 128, 16, MMOMetadata {}, System, NotAtomic, NotAtomic);
            MemOps.push(self.DAG.getMemIntrinsicNode(VASTART_SAVE_XMM_REGS, self.DL, self.DAG.getVTList(Other), SaveXMMOps, i8, StoreMMO));
        }
        if !MemOps.is_empty() {
            Chain = self.DAG.getNode(TokenFactor, self.DL, Other, MemOps);
        }
    }
}

fn VarArgsLoweringHelper::forwardMustTailParameters(self, Chain: *mut SDValue) {
    let mut VecVT: MVT = Other;
    if self.Subtarget.useAVX512Regs() && (self.is64Bit() || (self.CallConv == X86_VectorCall || self.CallConv == Intel_OCL_BI)) {
        VecVT = v16f32;
    } else if self.Subtarget.hasAVX() {
        VecVT = v8f32;
    } else if self.Subtarget.hasSSE2() {
        VecVT = v4f32;
    }
    let mut RegParmTypes: SmallVector<MVT, 2> = SmallVector<MVT, 2> {};
    let mut IntVT: MVT = if self.is64Bit() { i64 } else { i32 };
    RegParmTypes.push(IntVT);
    if VecVT != Other {
        RegParmTypes.push(VecVT);
    }
    let mut Forwards: *mut SmallVectorImpl<ForwardedRegister> = self.FuncInfo.getForwardedMustTailRegParms();
    self.CCInfo.analyzeMustTailForwardedRegisters(Forwards, RegParmTypes, CC_X86);
    if self.is64Bit() && !self.isWin64() && !self.CCInfo.isAllocated(AL) {
        let mut ALVReg: Register = self.TheMachineFunction.addLiveIn(AL, &mut GR8RegClass);
        Forwards.push(ForwardedRegister { VReg: ALVReg, PReg: AL, VT: i8 });
    }
    for FR in Forwards {
        let mut RegVal: SDValue = self.DAG.getCopyFromReg(Chain, self.DL, FR.VReg, FR.VT);
        FR.VReg = self.TheMachineFunction.getRegInfo().createVirtualRegister(self.TargLowering.getRegClassFor(FR.VT, false), "");
        Chain = self.DAG.getCopyToReg(Chain, self.DL, FR.VReg, RegVal);
    }
}

fn VarArgsLoweringHelper::lowerVarArgsParameters(self, Chain: *mut SDValue, StackSize: u32) {
    self.FuncInfo.setVarArgsFrameIndex(178956970);
    self.FuncInfo.setRegSaveFrameIndex(178956970);
    if self.FrameInfo.hasVAStart() {
        self.createVarArgAreaAndStoreRegisters(Chain, StackSize);
    }
    if self.FrameInfo.hasMustTailInVarArgFunc() {
        self.forwardMustTailParameters(Chain);
    }
}

fn X86TargetLowering::LowerFormalArguments(self: *X86TargetLowering, Chain: SDValue, CallConv: ID, IsVarArg: bool, Ins: *InputArg>, dl: *SDLoc, DAG: *mut SelectionDAG, InVals: *mut SmallVectorImpl<SDValue>) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut X86MachineFunctionInfo = MF.getInfo();
    let mut F: *Function = MF.getFunction();
    if F.hasExternalLinkage() && self.Subtarget.isTargetCygMing() && F.getName() == "main" {
        FuncInfo.setForceFramePointer(true);
    }
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut Is64Bit: bool = self.Subtarget.is64Bit();
    let mut IsWin64: bool = self.Subtarget.isCallingConvWin64(CallConv);
    if Is64Bit && !self.Subtarget.hasX87() {
        if F.getReturnType().isX86_FP80Ty() || any_of(F.args(), Closure_4 {}) {
            reportFatalUsageError("cannot use x86_fp80 type with x87 disabled on x86_64 target");
        }
    }
    assert!(!(IsVarArg && canGuaranteeTCO(CallConv)), "Var args not supported with calling conv' regcall, fastcc, ghc or hipe");
    let mut ArgLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CallConv, IsVarArg, MF, ArgLocs, *DAG.getContext(), false };
    if IsWin64 {
        CCInfo.AllocateStack(32, 8);
    }
    CCInfo.AnalyzeArguments(Ins, CC_X86);
    if X86_VectorCall == CallConv {
        CCInfo.AnalyzeArgumentsSecondPass(Ins, CC_X86);
    }
    assert!(isSortedByValueNo(ArgLocs), "Argument Location list must be sorted before lowering");
    let mut ArgValue: SDValue = SDValue {};
    for let mut I: u32 = 0;
let mut InsIndex: u32 = 0;
let mut E: u32 = ArgLocs.len; I != E; I += 1 , InsIndex += 1 {
        assert!(InsIndex < Ins.len, "Invalid Ins index");
        let mut VA: *mut CCValAssign = ArgLocs[I];
        if VA.isRegLoc() {
            let mut RegVT: EVT = VA.getLocVT();
            if VA.needsCustom() {
                assert!(VA.getValVT() == v64i1, "Currently the only custom case is when we split v64i1 to 2 regs");
                ArgValue = getv64i1Argument(VA, ArgLocs[I += 1], Chain, DAG, dl, self.Subtarget, null);
            } else {
                let mut RC: *TargetRegisterClass = null;
                if RegVT == i8 {
                    RC = &mut GR8RegClass;
                } else if RegVT == i16 {
                    RC = &mut GR16RegClass;
                } else if RegVT == i32 {
                    RC = &mut GR32RegClass;
                } else if Is64Bit && RegVT == i64 {
                    RC = &mut GR64RegClass;
                } else if RegVT == f16 {
                    RC = if self.Subtarget.hasAVX512() { &mut FR16XRegClass } else { &mut FR16RegClass };
                } else if RegVT == f32 {
                    RC = if self.Subtarget.hasAVX512() { &mut FR32XRegClass } else { &mut FR32RegClass };
                } else if RegVT == f64 {
                    RC = if self.Subtarget.hasAVX512() { &mut FR64XRegClass } else { &mut FR64RegClass };
                } else if RegVT == f80 {
                    RC = &mut RFP80RegClass;
                } else if RegVT == f128 {
                    RC = &mut VR128RegClass;
                } else if RegVT.is512BitVector() {
                    RC = &mut VR512RegClass;
                } else if RegVT.is256BitVector() {
                    RC = if self.Subtarget.hasVLX() { &mut VR256XRegClass } else { &mut VR256RegClass };
                } else if RegVT.is128BitVector() {
                    RC = if self.Subtarget.hasVLX() { &mut VR128XRegClass } else { &mut VR128RegClass };
                } else if RegVT == x86mmx {
                    RC = &mut VR64RegClass;
                } else if RegVT == v1i1 {
                    RC = &mut VK1RegClass;
                } else if RegVT == v8i1 {
                    RC = &mut VK8RegClass;
                } else if RegVT == v16i1 {
                    RC = &mut VK16RegClass;
                } else if RegVT == v32i1 {
                    RC = &mut VK32RegClass;
                } else if RegVT == v64i1 {
                    RC = &mut VK64RegClass;
                } else {
                    llvm_unreachable_internal("Unknown argument type!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLoweringCall.cpp", 1820);
                }
                let mut Reg: Register = MF.addLiveIn(VA.getLocReg().operator MCRegister(), RC);
                ArgValue = DAG.getCopyFromReg(Chain, dl, Reg, RegVT);
            }
            if VA.getLocInfo() == SExt {
                ArgValue = DAG.getNode(AssertSext, dl, RegVT, ArgValue, DAG.getValueType(VA.getValVT()));
            } else if VA.getLocInfo() == ZExt {
                ArgValue = DAG.getNode(AssertZext, dl, RegVT, ArgValue, DAG.getValueType(VA.getValVT()));
            } else if VA.getLocInfo() == BCvt {
                ArgValue = DAG.getBitcast(VA.getValVT(), ArgValue);
            }
            if VA.isExtInLoc() {
                if RegVT.isVector() && VA.getValVT().getScalarType() != i1 {
                    ArgValue = DAG.getNode(MOVDQ2Q, dl, VA.getValVT(), ArgValue);
                } else if VA.getValVT().isVector() && VA.getValVT().getScalarType() == i1 && ((VA.getLocVT() == i64) || (VA.getLocVT() == i32) || (VA.getLocVT() == i16) || (VA.getLocVT() == i8)) {
                    ArgValue = lowerRegToMasks(ArgValue, VA.getValVT(), RegVT, dl, DAG);
                } else {
                    ArgValue = DAG.getNode(TRUNCATE, dl, VA.getValVT(), ArgValue);
                }
            }
        } else {
            assert!(VA.isMemLoc();
            ArgValue = self.LowerMemArgument(Chain, CallConv, Ins, dl, DAG, VA, MFI, InsIndex);
        }
        if VA.getLocInfo() == Indirect && !(Ins[I].Flags.isByVal() && VA.isRegLoc()) {
            ArgValue = DAG.getLoad(VA.getValVT(), dl, Chain, ArgValue, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
        }
        InVals.push(ArgValue);
    }
    for let mut I: u32 = 0;
let mut E: u32 = Ins.len; I != E; I += 1 {
        if Ins[I].Flags.isSwiftAsync() {
            let mut X86FI: *mut X86MachineFunctionInfo = MF.getInfo();
            if isExtendedSwiftAsyncFrameSupported(self.Subtarget, MF) {
                X86FI.setHasSwiftAsyncContext(true);
            } else {
                let mut PtrSize: i32 = if self.Subtarget.is64Bit() { 8 } else { 4 };
                let mut FI: i32 = MF.getFrameInfo().CreateStackObject(PtrSize, PtrSize, false, null, 0);
                X86FI.setSwiftAsyncContextFrameIdx(FI);
                let mut St: SDValue = DAG.getStore(DAG.getEntryNode(), dl, InVals[I], DAG.getFrameIndex(FI, if PtrSize == 8 { i64 } else { i32 }, false), getFixedStack(MF, FI, 0), MaybeAlign {}, MONone, MMOMetadata {});
                Chain = DAG.getNode(TokenFactor, dl, Other, St, Chain);
            }
        }
        if CallConv == Swift || CallConv == SwiftTail {
            continue;
        }
        if Ins[I].Flags.isSRet() {
            assert!(!FuncInfo.getSRetReturnReg().operator unsigned int(), "SRet return has already been set");
            let mut PtrTy: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
            let mut Reg: Register = MF.getRegInfo().createVirtualRegister(self.getRegClassFor(PtrTy, false), "");
            FuncInfo.setSRetReturnReg(Reg);
            let mut Copy: SDValue = DAG.getCopyToReg(DAG.getEntryNode(), dl, Reg, InVals[I]);
            Chain = DAG.getNode(TokenFactor, dl, Other, Copy, Chain);
            break;
        }
    }
    let mut StackSize: u32 = CCInfo.getStackSize();
    if shouldGuaranteeTCO(CallConv, MF.getTarget().Options.GuaranteedTailCallOpt) {
        StackSize = self.GetAlignedArgumentStackSize(StackSize, DAG);
    }
    if IsVarArg {
        VarArgsLoweringHelper { FuncInfo, dl, DAG, self.Subtarget, CallConv, CCInfo }.lowerVarArgsParameters(Chain, StackSize);
    }
    if isCalleePop(CallConv, Is64Bit, IsVarArg, MF.getTarget().Options.GuaranteedTailCallOpt) {
        FuncInfo.setBytesToPopOnReturn(StackSize);
    } else if CallConv == X86_INTR && Ins.len == 2 {
        FuncInfo.setBytesToPopOnReturn(if Is64Bit { 16 } else { 4 });
    } else {
        FuncInfo.setBytesToPopOnReturn(0);
        if hasCalleePopSRet(Ins, ArgLocs, self.Subtarget) {
            FuncInfo.setBytesToPopOnReturn(4);
        }
    }
    if !Is64Bit {
        FuncInfo.setRegSaveFrameIndex(178956970);
    }
    FuncInfo.setArgumentStackSize(StackSize);
    if MF.getWinEHFuncInfo() {
        EHInfo;
    } else {
        let mut Personality: EHPersonality = classifyEHPersonality(F.getPersonalityFn());
        if Personality == CoreCLR {
            assert!(Is64Bit);
            let mut PSPSymFI: i32 = MFI.CreateStackObject(8, 8, false, null, 0);
            EHInfo.PSPSymFrameIdx = PSPSymFI;
        }
    }
    if shouldDisableArgRegFromCSR(CallConv) || F.hasFnAttribute("no_caller_saved_registers") {
        let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
        for Pair in MRI.liveins() {
            MRI.disableCalleeSavedRegister(Pair.first);
        }
    }
    if PreserveNone == CallConv {
        for In in Ins {
            if In.Flags.isSwiftSelf() || In.Flags.isSwiftAsync() || In.Flags.isSwiftError() {
                errorUnsupported(DAG, dl, "Swift attributes can't be used with preserve_none");
                break;
            }
        }
    }
    return Chain;
}

fn X86TargetLowering::LowerMemOpCallTo(self: *X86TargetLowering, Chain: SDValue, StackPtr: SDValue, Arg: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG, VA: *CCValAssign, Flags: ArgFlagsTy, isByVal: bool) -> SDValue {
    let mut LocMemOffset: u32 = VA.getLocMemOffset();
    let mut PtrOff: SDValue = DAG.getIntPtrConstant(LocMemOffset, dl, false);
    PtrOff = DAG.getNode(ADD, dl, self.getPointerTy(DAG.getDataLayout(), 0), StackPtr, PtrOff);
    if isByVal {
        return CreateCopyOfByValArgument(Arg, PtrOff, Chain, Flags, DAG, dl);
    }
    let mut Alignment: MaybeAlign = MaybeAlign {};
    if self.Subtarget.isTargetWindowsMSVC() && !self.Subtarget.is64Bit() && Arg.getSimpleValueType() != f80 {
        Alignment = 4;
    }
    return DAG.getStore(Chain, dl, Arg, PtrOff, getStack(DAG.getMachineFunction(), LocMemOffset, 0), Alignment, MONone, MMOMetadata {});
}

fn X86TargetLowering::EmitTailCallLoadRetAddr(self: *X86TargetLowering, DAG: *mut SelectionDAG, OutRetAddr: *mut SDValue, Chain: SDValue, IsTailCall: bool, Is64Bit: bool, FPDiff: i32, dl: *SDLoc) -> SDValue {
    let mut VT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
    OutRetAddr = self.getReturnAddressFrameIndex(DAG);
    OutRetAddr = DAG.getLoad(VT, dl, Chain, OutRetAddr, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    return SDValue { Node: OutRetAddr.getNode(), ResNo: 1 };
}

fn EmitTailCallStoreRetAddr(DAG: *mut SelectionDAG, MF: *mut MachineFunction, Chain: SDValue, RetAddrFrIdx: SDValue, PtrVT: EVT, SlotSize: u32, FPDiff: i32, dl: *SDLoc) -> SDValue {
    if !FPDiff {
        return Chain;
    }
    let mut NewReturnAddrFI: i32 = MF.getFrameInfo().CreateFixedObject(SlotSize, FPDiff as i64 - SlotSize, false, false);
    let mut NewRetAddrFrIdx: SDValue = DAG.getFrameIndex(NewReturnAddrFI, PtrVT, false);
    Chain = DAG.getStore(Chain, dl, RetAddrFrIdx, NewRetAddrFrIdx, getFixedStack(DAG.getMachineFunction(), NewReturnAddrFI, 0), MaybeAlign {}, MONone, MMOMetadata {});
    return Chain;
}

fn X86TargetLowering::getMOVL(self: *X86TargetLowering, DAG: *mut SelectionDAG, dl: *SDLoc, VT: MVT, V1: SDValue, V2: SDValue) -> SDValue {
    let mut NumElems: u32 = VT.getVectorNumElements();
    let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> {};
    Mask.push(NumElems);
    for let mut i: u32 = 1; i != NumElems; i += 1 {
        Mask.push(i);
    }
    return DAG.getVectorShuffle(VT, dl, V1, V2, Mask);
}

fn X86TargetLowering::ByValNeedsCopyForTailCall(self: *X86TargetLowering, DAG: *mut SelectionDAG, Src: SDValue, Dst: SDValue, Flags: ArgFlagsTy) -> ByValCopyKind {
    let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
    if isa(Src) || isa(Src) {
        return CopyOnce;
    }
    let mut SrcFrameIdxNode: *mut FrameIndexSDNode = dyn_cast(Src);
    let mut DstFrameIdxNode: *mut FrameIndexSDNode = dyn_cast(Dst);
    if !SrcFrameIdxNode || !DstFrameIdxNode {
        return CopyViaTemp;
    }
    let mut SrcFI: i32 = SrcFrameIdxNode.getIndex();
    let mut DstFI: i32 = DstFrameIdxNode.getIndex();
    assert!(MFI.isFixedObjectIndex(DstFI), "byval passed in non-fixed stack slot");
    let mut SrcOffset: i64 = MFI.getObjectOffset(SrcFI);
    let mut DstOffset: i64 = MFI.getObjectOffset(DstFI);
    let mut FixedSrc: bool = MFI.isFixedObjectIndex(SrcFI);
    if !FixedSrc || (FixedSrc && SrcOffset < 0) {
        return CopyOnce;
    }
    if SrcOffset == DstOffset {
        return NoCopy;
    } else {
        return CopyViaTemp;
    }
}

fn X86TargetLowering::LowerCall(self: *X86TargetLowering, CLI: *mut CallLoweringInfo, InVals: *mut SmallVectorImpl<SDValue>) -> SDValue {
    let mut DAG: *mut SelectionDAG = CLI.DAG;
    let mut dl: *mut SDLoc = CLI.DL;
    let mut Outs: *mut OutputArg> = CLI.Outs;
    let mut OutVals: *mut SmallVectorImpl<SDValue> = CLI.OutVals;
    let mut Ins: *mut InputArg> = CLI.Ins;
    let mut Chain: SDValue = CLI.Chain;
    let mut Callee: SDValue = CLI.Callee;
    let mut CallConv: ID = CLI.CallConv;
    let mut isTailCall: *mut bool = CLI.IsTailCall;
    let mut isVarArg: bool = CLI.IsVarArg;
    let mut CB: *CallBase = CLI.CB;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut Is64Bit: bool = self.Subtarget.is64Bit();
    let mut IsWin64: bool = self.Subtarget.isCallingConvWin64(CallConv);
    let mut ShouldGuaranteeTCO: bool = shouldGuaranteeTCO(CallConv, MF.getTarget().Options.GuaranteedTailCallOpt);
    let mut X86Info: *mut X86MachineFunctionInfo = MF.getInfo();
    let mut HasNCSR: bool = (CB && isa(CB) && CB.hasFnAttr("no_caller_saved_registers"));
    let mut IsIndirectCall: bool = (CB && isa(CB) && CB.isIndirectCall());
    let mut IsCFICall: bool = IsIndirectCall && CLI.CFIType;
    let mut M: *Module = MF.getFunction().getParent();
    let mut IsNoTrackIndirectCall: bool = IsIndirectCall && CB.doesNoCfCheck() && M.getModuleFlag("cf-protection-branch");
    if IsNoTrackIndirectCall {
        isTailCall = false;
    }
    let mut CSInfo: CallSiteInfo = CallSiteInfo {};
    if CallConv == X86_INTR {
        report_fatal_error("X86 interrupts may not be called directly", true);
    }
    self.setTypeIdForCallsiteInfo(CB, MF, CSInfo);
    if IsIndirectCall && !IsWin64 && M.getModuleFlag("import-call-optimization") {
        errorUnsupported(DAG, dl, "Indirect calls must have a normal calling convention if Import Call Optimization is enabled");
    }
    let mut ArgLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CallConv, isVarArg, MF, ArgLocs, *DAG.getContext(), false };
    if IsWin64 {
        CCInfo.AllocateStack(32, 8);
    }
    CCInfo.AnalyzeArguments(Outs, CC_X86);
    if X86_VectorCall == CallConv {
        CCInfo.AnalyzeArgumentsSecondPass(Outs, CC_X86);
    }
    if isTailCall && ShouldGuaranteeTCO {
        let mut CallerCC: ID = MF.getFunction().getCallingConv();
        isTailCall = (CallConv == CallerCC);
    }
    let mut IsMustTail: bool = CLI.CB && CLI.CB.isMustTailCall();
    let mut IsSibcall: bool = false;
    if isTailCall {
        IsSibcall = self.isEligibleForSiblingCallOpt(CLI, CCInfo, ArgLocs);
        isTailCall = IsSibcall || IsMustTail || ShouldGuaranteeTCO;
    }
    if isTailCall {
        operator(NumTailCalls);
    }
    if IsMustTail && !isTailCall {
        report_fatal_error("failed to perform tail call elimination on a call site marked musttail", true);
    }
    assert!(!(isVarArg && canGuaranteeTCO(CallConv)), "Var args not supported with calling convention fastcc, ghc or hipe");
    let mut NumBytes: u32 = CCInfo.getAlignedCallFrameSize();
    if IsSibcall {
        NumBytes = 0;
    } else if ShouldGuaranteeTCO && canGuaranteeTCO(CallConv) {
        NumBytes = self.GetAlignedArgumentStackSize(NumBytes, DAG);
    }
    let mut FPDiff: i32 = 0;
    if isTailCall && ShouldGuaranteeTCO && !IsSibcall {
        let mut NumBytesCallerPushed: u32 = X86Info.getBytesToPopOnReturn();
        FPDiff = NumBytesCallerPushed - NumBytes;
        if FPDiff < X86Info.getTCReturnAddrDelta() {
            X86Info.setTCReturnAddrDelta(FPDiff);
        }
    }
    let mut NumBytesToPush: u32 = NumBytes;
    let mut NumBytesToPop: u32 = NumBytes;
    let mut StackPtr: SDValue = SDValue {};
    let mut RegInfo: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut ByValTemporaries: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut ByValTempChain: SDValue = SDValue {};
    if isTailCall {
        ByValTemporaries.assign(OutVals.len, SDValue {});
        let mut ByValCopyChains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        for VA in ArgLocs {
            let mut ArgIdx: u32 = VA.getValNo();
            let mut Src: SDValue = OutVals[ArgIdx];
            let mut Flags: ArgFlagsTy = Outs[ArgIdx].Flags;
            if !Flags.isByVal() {
                continue;
            }
            let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
            if !StackPtr.getNode() {
                StackPtr = DAG.getCopyFromReg(Chain, dl, RegInfo.getStackRegister(), PtrVT);
            }
            let mut Offset: i64 = VA.getLocMemOffset() + FPDiff;
            let mut Size: u64 = VA.getLocVT().getFixedSizeInBits() / 8;
            let mut FI: i32 = MF.getFrameInfo().CreateFixedObject(Size, Offset, true, false);
            let mut Dst: SDValue = DAG.getFrameIndex(FI, PtrVT, false);
            let mut Copy: ByValCopyKind = self.ByValNeedsCopyForTailCall(DAG, Src, Dst, Flags);
            if Copy == NoCopy {
                continue;
            } else if Copy == CopyOnce {
                ByValTemporaries[ArgIdx] = Src;
            } else {
                assert!(Copy == CopyViaTemp, "unexpected enum value");
                let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
                let mut TempFrameIdx: i32 = MFI.CreateStackObject(Flags.getByValSize(), Flags.getNonZeroByValAlign(), false, null, 0);
                let mut Temp: SDValue = DAG.getFrameIndex(TempFrameIdx, self.getPointerTy(DAG.getDataLayout(), 0), false);
                let mut CopyChain: SDValue = CreateCopyOfByValArgument(Src, Temp, Chain, Flags, DAG, dl);
                ByValCopyChains.push(CopyChain);
                ByValTemporaries[ArgIdx] = Temp;
            }
        }
        if !ByValCopyChains.is_empty() {
            ByValTempChain = DAG.getNode(TokenFactor, dl, Other, ByValCopyChains);
        }
    }
    if !Outs.is_empty() && Outs.back().Flags.isInAlloca() {
        NumBytesToPush = 0;
        if !ArgLocs.back().isMemLoc() {
            report_fatal_error("cannot use inalloca attribute on a register parameter", true);
        }
        if ArgLocs.back().getLocMemOffset() != 0 {
            report_fatal_error("any parameter with the inalloca attribute must be the only memory argument", true);
        }
    } else if CLI.IsPreallocated {
        assert!(ArgLocs.back().isMemLoc(), "cannot use preallocated attribute on a register parameter");
        let mut PreallocatedOffsets: SmallVector<size_t, 4> = SmallVector<size_t, 4> {};
        for let mut i: u64 = 0; i < CLI.OutVals.len; i += 1 {
            if CLI.CB.paramHasAttr(i, Preallocated) {
                PreallocatedOffsets.push(ArgLocs[i].getLocMemOffset());
            }
        }
        let mut MFI: *mut X86MachineFunctionInfo = DAG.getMachineFunction().getInfo();
        let mut PreallocatedId: u64 = MFI.getPreallocatedIdForCallSite(CLI.CB);
        MFI.setPreallocatedStackSize(PreallocatedId, NumBytes);
        MFI.setPreallocatedArgOffsets(PreallocatedId, PreallocatedOffsets);
        NumBytesToPush = 0;
    }
    if !IsSibcall && !IsMustTail {
        Chain = DAG.getCALLSEQ_START(Chain, NumBytesToPush, NumBytes - NumBytesToPush, dl);
    }
    let mut RetAddrFrIdx: SDValue = SDValue {};
    if isTailCall && FPDiff {
        Chain = self.EmitTailCallLoadRetAddr(DAG, RetAddrFrIdx, Chain, isTailCall, Is64Bit, FPDiff, dl);
    }
    let mut RegsToPass: pair<Register, SDValue>, 8> = pair<Register, SDValue>, 8> {};
    let mut MemOpChains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    assert!(isSortedByValueNo(ArgLocs), "Argument Location list must be sorted before lowering");
    for let mut I: u32 = 0;
let mut OutIndex: u32 = 0;
let mut E: u32 = ArgLocs.len; I != E; I += 1 , OutIndex += 1 {
        assert!(OutIndex < Outs.len, "Invalid Out index");
        let mut Flags: ArgFlagsTy = Outs[OutIndex].Flags;
        if Flags.isInAlloca() || Flags.isPreallocated() {
            continue;
        }
        let mut VA: *mut CCValAssign = ArgLocs[I];
        let mut RegVT: EVT = VA.getLocVT();
        let mut Arg: SDValue = OutVals[OutIndex];
        let mut isByVal: bool = Flags.isByVal();
        match VA.getLocInfo() {
            _ => {
                llvm_unreachable_internal("Unknown loc info!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelLoweringCall.cpp", 2343);
            },
            Full => {
                break;
            },
            SExt => {
                Arg = DAG.getNode(SIGN_EXTEND, dl, RegVT, Arg);
            },
            ZExt => {
                Arg = DAG.getNode(ZERO_EXTEND, dl, RegVT, Arg);
            },
            AExt => {
                if Arg.getValueType().isVector() && Arg.getValueType().getVectorElementType() == i1 {
                    Arg = lowerMasksToReg(Arg, RegVT, dl, DAG);
                } else if RegVT.is128BitVector() {
                    Arg = DAG.getBitcast(i64, Arg);
                    Arg = DAG.getNode(SCALAR_TO_VECTOR, dl, v2i64, Arg);
                    Arg = self.getMOVL(DAG, dl, v2i64, DAG.getUNDEF(v2i64), Arg);
                } else {
                    Arg = DAG.getNode(ANY_EXTEND, dl, RegVT, Arg);
                }
            },
            BCvt => {
                Arg = DAG.getBitcast(RegVT, Arg);
            },
            Indirect => {
                if isByVal {
                    let mut FrameIdx: i32 = MF.getFrameInfo().CreateStackObject(Flags.getByValSize(), if 16 > Flags.getNonZeroByValAlign() { 16 } else { Flags.getNonZeroByValAlign() }, false, null, 0);
                    let mut StackSlot: SDValue = DAG.getFrameIndex(FrameIdx, self.getPointerTy(DAG.getDataLayout(), 0), false);
                    Chain = CreateCopyOfByValArgument(Arg, StackSlot, Chain, Flags, DAG, dl);
                    Arg = StackSlot;
                    isByVal = false;
                } else {
                    let mut SpillSlot: SDValue = DAG.CreateStackTemporary(VA.getValVT(), 1);
                    let mut FI: i32 = cast(SpillSlot).getIndex();
                    Chain = DAG.getStore(Chain, dl, Arg, SpillSlot, getFixedStack(DAG.getMachineFunction(), FI, 0), MaybeAlign {}, MONone, MMOMetadata {});
                    Arg = SpillSlot;
                }
                break;
            },
        }
        if VA.needsCustom() {
            assert!(VA.getValVT() == v64i1, "Currently the only custom case is when we split v64i1 to 2 regs");
            Passv64i1ArgInRegs(dl, DAG, Arg, RegsToPass, VA, ArgLocs[I += 1], self.Subtarget);
        } else if VA.isRegLoc() {
            RegsToPass.push(make_pair(VA.getLocReg(), Arg));
            let mut Options: *TargetOptions = DAG.getTarget().Options;
            if Options.EmitCallSiteInfo {
                CSInfo.ArgRegPairs.push(VA.getLocReg(), I);
            }
            if isVarArg && IsWin64 {
                let mut ShadowReg: Register = 0;
                match VA.getLocReg().operator unsigned int() {
                    XMM0 => {
                        ShadowReg = RCX;
                    },
                    XMM1 => {
                        ShadowReg = RDX;
                    },
                    XMM2 => {
                        ShadowReg = R8;
                    },
                    XMM3 => {
                        ShadowReg = R9;
                    },
                }
                if ShadowReg.operator unsigned int() {
                    RegsToPass.push(make_pair(ShadowReg, Arg));
                }
            }
        } else if !IsSibcall && (!isTailCall || (isByVal && !IsMustTail)) {
            assert!(VA.isMemLoc();
            if !StackPtr.getNode() {
                StackPtr = DAG.getCopyFromReg(Chain, dl, RegInfo.getStackRegister(), self.getPointerTy(DAG.getDataLayout(), 0));
            }
            MemOpChains.push(self.LowerMemOpCallTo(Chain, StackPtr, Arg, dl, DAG, VA, Flags, isByVal));
        }
    }
    if !MemOpChains.is_empty() {
        Chain = DAG.getNode(TokenFactor, dl, Other, MemOpChains);
    }
    if self.Subtarget.isPICStyleGOT() {
        if !isTailCall {
            if (operator(Callee).getOpcode() == GlobalAddress || operator(Callee).getOpcode() == ExternalSymbol) {
                RegsToPass.push(make_pair(EBX, DAG.getNode(GlobalBaseReg, SDLoc {}, self.getPointerTy(DAG.getDataLayout(), 0))));
            }
        } else {
            let mut G: *mut GlobalAddressSDNode = dyn_cast(Callee);
            if G && !G.getGlobal().hasLocalLinkage() && G.getGlobal().hasDefaultVisibility() {
                Callee = self.LowerGlobalAddress(Callee, DAG);
            } else if isa(Callee) {
                Callee = self.LowerExternalSymbol(Callee, DAG);
            }
        }
    }
    if Is64Bit && isVarArg && !IsWin64 && !IsMustTail && (self.Subtarget.hasSSE1() || !M.getModuleFlag("SkipRaxSetup")) {
        let mut XMMArgRegs: [8]MCPhysReg = [XMM0, XMM1, XMM2, XMM3, XMM4, XMM5, XMM6, XMM7];
        let mut NumXMMRegs: u32 = CCInfo.getFirstUnallocated(XMMArgRegs);
        assert!((self.Subtarget.hasSSE1() || !NumXMMRegs), "SSE registers cannot be used when SSE is disabled");
        RegsToPass.push(make_pair(AL, DAG.getConstant(NumXMMRegs, dl, i8, false, false)));
    }
    if isVarArg && IsMustTail {
        let mut Forwards: *SmallVectorImpl<ForwardedRegister> = X86Info.getForwardedMustTailRegParms();
        for F in Forwards {
            let mut Val: SDValue = DAG.getCopyFromReg(Chain, dl, F.VReg, F.VT);
            RegsToPass.push(make_pair(F.PReg, Val));
        }
    }
    if isTailCall && !IsSibcall {
        Chain = DAG.getStackArgumentTokenFactor(Chain);
        if ByValTempChain {
            Chain = DAG.getNode(TokenFactor, dl, Other, Chain, ByValTempChain);
        }
        let mut MemOpChains2: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        let mut FIN: SDValue = SDValue {};
        let mut FI: i32 = 0;
        for let mut I: u32 = 0;
let mut OutsIndex: u32 = 0;
let mut E: u32 = ArgLocs.len; I != E; I += 1 , OutsIndex += 1 {
            let mut VA: *mut CCValAssign = ArgLocs[I];
            if VA.isRegLoc() {
                if VA.needsCustom() {
                    assert!((CallConv == X86_RegCall), "Expecting custom case only in regcall calling convention");
                    I += 1;
                }
                continue;
            }
            assert!(VA.isMemLoc();
            let mut Arg: SDValue = OutVals[OutsIndex];
            let mut Flags: ArgFlagsTy = Outs[OutsIndex].Flags;
            if Flags.isInAlloca() || Flags.isPreallocated() {
                continue;
            }
            let mut Offset: i32 = VA.getLocMemOffset() + FPDiff;
            let mut OpSize: u32 = (VA.getLocVT().getSizeInBits().operator unsigned long long() + 7) / 8;
            FI = MF.getFrameInfo().CreateFixedObject(OpSize, Offset, true, false);
            FIN = DAG.getFrameIndex(FI, self.getPointerTy(DAG.getDataLayout(), 0), false);
            if Flags.isByVal() {
                if ByValTemporaries[OutsIndex] {
                    ByValSrc;
                } else {
                    let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
                    let mut DstAddr: SDValue = DAG.getFrameIndex(FI, PtrVT, false);
                    MemOpChains2.push(CreateCopyOfByValArgument(ByValSrc, DstAddr, Chain, Flags, DAG, dl));
                }
            } else {
                MemOpChains2.push(DAG.getStore(Chain, dl, Arg, FIN, getFixedStack(DAG.getMachineFunction(), FI, 0), MaybeAlign {}, MONone, MMOMetadata {}));
            }
        }
        if !MemOpChains2.is_empty() {
            Chain = DAG.getNode(TokenFactor, dl, Other, MemOpChains2);
        }
        Chain = EmitTailCallStoreRetAddr(DAG, MF, Chain, RetAddrFrIdx, self.getPointerTy(DAG.getDataLayout(), 0), RegInfo.getSlotSize(), FPDiff, dl);
    }
    let mut InGlue: SDValue = SDValue {};
    for x in RegsToPass {
        Chain = DAG.getCopyToReg(Chain, dl, Reg, N, InGlue);
        InGlue = Chain.getValue(1);
    }
    let mut IsImpCall: bool = false;
    let mut IsCFGuardCall: bool = false;
    if DAG.getTarget().getCodeModel() == Large {
        assert!(Is64Bit, "Large code model is only legal in 64-bit mode.");
    } else if operator(Callee).getOpcode() == GlobalAddress || operator(Callee).getOpcode() == ExternalSymbol {
        Callee = self.LowerGlobalOrExternal(Callee, DAG, true, &mut IsImpCall);
    } else if self.Subtarget.isTarget64BitILP32() && Callee.getValueType() == i32 {
        Callee = DAG.getNode(ZERO_EXTEND, dl, i64, Callee);
    } else if Is64Bit && CB && isCFGuardCall(CB) {
        IsCFGuardCall = true;
        let mut LoadNode: *mut LoadSDNode = cast(Callee);
        let mut GA: *mut GlobalAddressSDNode = cast(self.unwrapAddress(LoadNode.getBasePtr()));
        assert!(isCFGuardFunction(GA.getGlobal()), "CFG Call should be to a guard function");
        assert!(operator(LoadNode.getOffset()).isUndef(), "CFG Function load should not have an offset");
        Callee = DAG.getTargetGlobalAddress(GA.getGlobal(), dl, GA.getValueType(0), 0, MO_NO_FLAG);
    }
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    if !IsSibcall && isTailCall && !IsMustTail {
        Chain = DAG.getCALLSEQ_END(Chain, NumBytesToPop, 0, InGlue, dl);
        InGlue = Chain.getValue(1);
    }
    Ops.push(Chain);
    Ops.push(Callee);
    if isTailCall {
        Ops.push(DAG.getSignedTargetConstant(FPDiff, dl, i32, false));
    }
    for x in RegsToPass {
        Ops.push(DAG.getRegister(Reg, N.getValueType()));
    }
    let mut Mask: *u32 = Closure_5 { CallConv: &mut CallConv, HasNCSR: &mut HasNCSR, CB: &mut CB, RegInfo: &mut RegInfo, MF: &mut MF }.call();
    assert!(Mask, "Missing call preserved mask for calling convention");
    if clobbersPhysReg(Mask, RegInfo.getFramePtr().operator MCRegister()) {
        X86Info.setFPClobberedByCall(true);
        if CLI.CB && isa(CLI.CB) {
            X86Info.setFPClobberedByInvoke(true);
        }
    }
    if clobbersPhysReg(Mask, RegInfo.getBaseRegister().operator MCRegister()) {
        X86Info.setBPClobberedByCall(true);
        if CLI.CB && isa(CLI.CB) {
            X86Info.setBPClobberedByInvoke(true);
        }
    }
    if !Is64Bit && CLI.CB && isa(CLI.CB) {
        let mut CallerFn: *Function = MF.getFunction();
        let mut Pers: EHPersonality = if CallerFn.hasPersonalityFn() { classifyEHPersonality(CallerFn.getPersonalityFn()) } else { Unknown };
        if isFuncletEHPersonality(Pers) {
            Mask = RegInfo.getNoPreservedMask();
        }
    }
    let mut RegMask: *mut u32 = null;
    let mut ShouldDisableArgRegs: bool = shouldDisableArgRegFromCSR(CallConv) || HasNCSR;
    if ShouldDisableArgRegs || shouldDisableRetRegFromCSR(CallConv) {
        let mut TRI: *TargetRegisterInfo = self.Subtarget.getRegisterInfo();
        RegMask = MF.allocateRegMask();
        let mut RegMaskSize: u32 = getRegMaskSize(TRI.getNumRegs());
        memcpy(RegMask, Mask, (RegMask[0]) * RegMaskSize);
        if ShouldDisableArgRegs {
            for RegPair in RegsToPass {
                for SubReg in TRI.subregs_inclusive(RegPair.first.operator MCRegister()) {
                    RegMask[SubReg / 32] &= ~(1 << (SubReg % 32));
                }
            }
        }
        Ops.push(DAG.getRegisterMask(RegMask));
    } else {
        Ops.push(DAG.getRegisterMask(Mask));
    }
    if InGlue.getNode() {
        Ops.push(InGlue);
    }
    if isTailCall {
        MF.getFrameInfo().setHasTailCall(true);
        let mut Opcode: GenNodeType = if IsCFGuardCall { TC_RETURN_GLOBALADDR } else { TC_RETURN };
        let mut Ret: SDValue = DAG.getNode(Opcode, dl, Other, Ops);
        if IsCFICall {
            Ret.getNode().setCFIType(CLI.CFIType.getZExtValue());
        }
        DAG.addNoMergeSiteInfo(Ret.getNode(), CLI.NoMerge);
        DAG.addCallSiteInfo(Ret.getNode(), move(CSInfo));
        return Ret;
    }
    let mut NodeTys: SDVTList = DAG.getVTList(Other, Glue);
    if IsImpCall {
        Chain = DAG.getNode(IMP_CALL, dl, NodeTys, Ops);
    } else if IsNoTrackIndirectCall {
        Chain = DAG.getNode(NT_CALL, dl, NodeTys, Ops);
    } else if IsCFGuardCall {
        Chain = DAG.getNode(CALL_GLOBALADDR, dl, NodeTys, Ops);
    } else if CLI.CB && hasAttachedCallOpBundle(CLI.CB) {
        assert!(!isTailCall, "tail calls cannot be marked with clang.arc.attachedcall");
        assert!(Is64Bit, "clang.arc.attachedcall is only supported in 64bit mode");
        let mut ARCFn: *mut Function = operator(getAttachedARCFunction(CLI.CB));
        let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
        let mut GA: SDValue = DAG.getTargetGlobalAddress(ARCFn, dl, PtrVT, 0, 0);
        Ops.insert(Ops.begin() + 1, GA);
        Chain = DAG.getNode(CALL_RVMARKER, dl, NodeTys, Ops);
    } else {
        Chain = DAG.getNode(CALL, dl, NodeTys, Ops);
    }
    if IsCFICall {
        Chain.getNode().setCFIType(CLI.CFIType.getZExtValue());
    }
    InGlue = Chain.getValue(1);
    DAG.addNoMergeSiteInfo(Chain.getNode(), CLI.NoMerge);
    DAG.addCallSiteInfo(Chain.getNode(), move(CSInfo));
    if CLI.CB {
        if CLI.CB.getMetadata("heapallocsite") {
            HeapAlloc;
        } else {
            DAG.addHeapAllocSite(Chain.getNode(), HeapAlloc);
        }
    }
    let mut NumBytesForCalleeToPop: u32 = 0;
    if isCalleePop(CallConv, Is64Bit, isVarArg, DAG.getTarget().Options.GuaranteedTailCallOpt) {
        NumBytesForCalleeToPop = NumBytes;
    } else if hasCalleePopSRet(Outs, ArgLocs, self.Subtarget) {
        NumBytesForCalleeToPop = 4;
    }
    if !IsSibcall {
        Chain = DAG.getCALLSEQ_END(Chain, NumBytesToPop, NumBytesForCalleeToPop, InGlue, dl);
        InGlue = Chain.getValue(1);
    }
    if PreserveNone == CallConv {
        for Out in Outs {
            if Out.Flags.isSwiftSelf() || Out.Flags.isSwiftAsync() || Out.Flags.isSwiftError() {
                errorUnsupported(DAG, dl, "Swift attributes can't be used with preserve_none");
                break;
            }
        }
    }
    return self.LowerCallResult(Chain, InGlue, CallConv, isVarArg, Ins, dl, DAG, InVals, RegMask);
}

fn X86TargetLowering::GetAlignedArgumentStackSize(self: *X86TargetLowering, StackSize: u32, DAG: *mut SelectionDAG) -> u32 {
    let mut StackAlignment: Align = self.Subtarget.getFrameLowering().getStackAlign();
    let mut SlotSize: u64 = self.Subtarget.getRegisterInfo().getSlotSize();
    assert!(StackSize % SlotSize == 0, "StackSize must be a multiple of SlotSize");
    return alignTo(StackSize + SlotSize, StackAlignment) - SlotSize;
}

fn MatchingStackOffset(Arg: SDValue, Offset: u32, Flags: ArgFlagsTy, MFI: *mut MachineFrameInfo, MRI: *MachineRegisterInfo, TII: *X86InstrInfo, VA: *CCValAssign) -> bool {
    let mut Bytes: u32 = Arg.getValueSizeInBits().operator unsigned long long() / 8;
    for {
        let mut Op: u32 = Arg.getOpcode();
        if Op == ZERO_EXTEND || Op == ANY_EXTEND || Op == BITCAST || Op == AssertZext {
            Arg = Arg.getOperand(0);
            continue;
        }
        if Op == TRUNCATE {
            let mut TruncInput: *SDValue = Arg.getOperand(0);
            if TruncInput.getOpcode() == AssertZext && cast(TruncInput.getOperand(1)).getVT() == Arg.getValueType() {
                Arg = TruncInput.getOperand(0);
                continue;
            }
        }
        break;
    }
    let mut FI: i32 = 2147483647;
    if Arg.getOpcode() == CopyFromReg {
        let mut VR: Register = cast(Arg.getOperand(1)).getReg();
        if !VR.isVirtual() {
            return false;
        }
        let mut Def: *mut MachineInstr = MRI.getVRegDef(VR);
        if !Def {
            return false;
        }
        if !Flags.isByVal() {
            if !TII.isLoadFromStackSlot(*Def, FI).operator unsigned int() {
                return false;
            }
        } else {
            let mut Opcode: u32 = Def.getOpcode();
            if (Opcode == LEA32r || Opcode == LEA64r || Opcode == LEA64_32r) && Def.getOperand(1).isFI() {
                FI = Def.getOperand(1).getIndex();
                Bytes = Flags.getByValSize();
            } else {
                return false;
            }
        }
    } else if dyn_cast(Arg) {
        Ld;
    } else {
        if Flags.isByVal() {
            return false;
        }
        let mut Ptr: SDValue = Ld.getBasePtr();
        let mut FINode: *mut FrameIndexSDNode = dyn_cast(Ptr);
        if !FINode {
            return false;
        }
        FI = FINode.getIndex();
    }
    assert!(FI != 2147483647);
    if !MFI.isFixedObjectIndex(FI) {
        return false;
    }
    if Offset != MFI.getObjectOffset(FI) {
        return false;
    }
    if !Flags.isByVal() && !MFI.isImmutableObjectIndex(FI) {
        return false;
    }
    if VA.getLocVT().getFixedSizeInBits() > Arg.getValueSizeInBits().getFixedValue() {
        if Flags.isZExt() != MFI.isObjectZExt(FI) || Flags.isSExt() != MFI.isObjectSExt(FI) {
            return false;
        }
    }
    return Bytes == MFI.getObjectSize(FI);
}

fn mayBeSRetTailCallCompatible(CLI: *CallLoweringInfo, CallerSRetReg: Register) -> bool {
    let mut Outs: *OutputArg, 32> = CLI.Outs;
    let mut OutVals: *SmallVector<SDValue, 32> = CLI.OutVals;
    let mut Pos: u32 = 0;
    for let mut E: u32 = Outs.len; Pos != E; Pos += 1 {
        if Outs[Pos].Flags.isSRet() {
            break;
        }
    }
    if Pos == Outs.len {
        return false;
    }
    let mut SRetArgVal: SDValue = OutVals[Pos];
    for User in operator(SRetArgVal).users() {
        if User.getOpcode() != CopyToReg {
            continue;
        }
        let mut Reg: Register = cast(User.getOperand(1)).getReg();
        if Reg == CallerSRetReg && User.getOperand(2) == SRetArgVal {
            return true;
        }
    }
    return false;
}

fn X86TargetLowering::isEligibleForSiblingCallOpt(self: *X86TargetLowering, CLI: *mut CallLoweringInfo, CCInfo: *mut CCState, ArgLocs: *mut SmallVectorImpl<CCValAssign>) -> bool {
    let mut DAG: *mut SelectionDAG = CLI.DAG;
    let mut Outs: *OutputArg> = CLI.Outs;
    let mut OutVals: *SmallVectorImpl<SDValue> = CLI.OutVals;
    let mut Ins: *InputArg> = CLI.Ins;
    let mut Callee: SDValue = CLI.Callee;
    let mut CalleeCC: ID = CLI.CallConv;
    let mut isVarArg: bool = CLI.IsVarArg;
    if !mayTailCallThisCC(CalleeCC) {
        return false;
    }
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut X86MachineFunctionInfo = MF.getInfo();
    let mut CallerF: *Function = MF.getFunction();
    if CallerF.getReturnType().isX86_FP80Ty() && !CLI.RetTy.isX86_FP80Ty() {
        return false;
    }
    let mut CallerCC: ID = CallerF.getCallingConv();
    let mut IsCalleeWin64: bool = self.Subtarget.isCallingConvWin64(CalleeCC);
    let mut IsCallerWin64: bool = self.Subtarget.isCallingConvWin64(CallerCC);
    if IsCalleeWin64 != IsCallerWin64 {
        return false;
    }
    if self.Subtarget.isLFI() && ArgLocs.len > 5 {
        return false;
    }
    if self.Subtarget.isPICStyleGOT() {
        if isa(Callee) {
            return false;
        }
        if dyn_cast(Callee) {
            G;
        } else {
            if !G.getGlobal().hasLocalLinkage() && G.getGlobal().hasDefaultVisibility() {
                return false;
            }
        }
    }
    let mut RegInfo: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    if RegInfo.hasStackRealignment(MF) {
        return false;
    }
    if FuncInfo.getSRetReturnReg() {
        SRetReg.operator unsigned int();
    } else {
        if !mayBeSRetTailCallCompatible(CLI, SRetReg) {
            return false;
        }
    }
    let mut C: *mut LLVMContext = *DAG.getContext();
    if isVarArg && !Outs.is_empty() {
        if IsCalleeWin64 || IsCallerWin64 {
            return false;
        }
        for VA in ArgLocs {
            if !VA.isRegLoc() {
                return false;
            }
        }
    }
    let mut Unused: bool = false;
    for In in Ins {
        if !In.Used {
            Unused = true;
            break;
        }
    }
    if Unused {
        let mut RVLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
        let mut RVCCInfo: CCState = CCState { CalleeCC, false, MF, RVLocs, C, false };
        RVCCInfo.AnalyzeCallResult(Ins, RetCC_X86);
        for VA in RVLocs {
            if VA.getLocReg() == FP0 || VA.getLocReg() == FP1 {
                return false;
            }
        }
    }
    if !resultsCompatible(CalleeCC, CallerCC, MF, C, Ins, RetCC_X86, RetCC_X86) {
        return false;
    }
    let mut TRI: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut CallerPreserved: *u32 = TRI.getCallPreservedMask(MF, CallerCC);
    if CallerCC != CalleeCC {
        let mut CalleePreserved: *u32 = TRI.getCallPreservedMask(MF, CalleeCC);
        if !TRI.regmaskSubsetEqual(CallerPreserved, CalleePreserved) {
            return false;
        }
    }
    if CallerF.hasFnAttribute("no_caller_saved_registers") {
        return false;
    }
    let mut StackArgsSize: u32 = CCInfo.getStackSize();
    if !Outs.is_empty() {
        if StackArgsSize > 0 {
            let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
            let mut MRI: *MachineRegisterInfo = &mut MF.getRegInfo();
            let mut TII: *X86InstrInfo = self.Subtarget.getInstrInfo();
            for let mut I: u32 = 0;
let mut E: u32 = ArgLocs.len; I != E; I += 1 {
                let mut VA: *CCValAssign = ArgLocs[I];
                let mut Arg: SDValue = OutVals[I];
                let mut Flags: ArgFlagsTy = Outs[I].Flags;
                if VA.getLocInfo() == Indirect {
                    return false;
                }
                if !VA.isRegLoc() {
                    if !MatchingStackOffset(Arg, VA.getLocMemOffset(), Flags, MFI, MRI, TII, VA) {
                        return false;
                    }
                }
            }
        }
        let mut PositionIndependent: bool = self.isPositionIndependent();
        if !self.Subtarget.is64Bit() && ((!isa(Callee) && !isa(Callee)) || PositionIndependent) {
            let mut NumInRegs: u32 = 0;
            let mut MaxInRegs: u32 = if PositionIndependent { 2 } else { 3 };
            for VA in ArgLocs {
                if !VA.isRegLoc() {
                    continue;
                }
                let mut Reg: Register = VA.getLocReg();
                match Reg.operator unsigned int() {
                    _ => {
                        break;
                    },
                    EAX => {
                        EDX;
                    },
                }
            }
        }
        let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
        if !self.parametersInCSRMatch(MRI, CallerPreserved, ArgLocs, OutVals) {
            return false;
        }
    }
    let mut CalleeWillPop: bool = isCalleePop(CalleeCC, self.Subtarget.is64Bit(), isVarArg, MF.getTarget().Options.GuaranteedTailCallOpt);
    if FuncInfo.getBytesToPopOnReturn() {
        BytesToPop;
    } else {
        let mut CalleePopMatches: bool = CalleeWillPop && BytesToPop == StackArgsSize;
        if !CalleePopMatches {
            return false;
        }
    }
    return true;
}

fn isCalleePop(CallingConv: ID, is64Bit: bool, IsVarArg: bool, GuaranteeTCO: bool) -> bool {
    if !IsVarArg && shouldGuaranteeTCO(CallingConv, GuaranteeTCO) {
        return true;
    }
    match CallingConv {
        _ => {
            return false;
        },
        X86_StdCall => {
            X86_FastCall;
        },
    }
}

struct Closure_1 {
    cap_0: *X86TargetLowering,
}

fn Closure_1::call(self: *mut Closure_1, CC: ID) -> auto {
        match CC {
            Win64 => {
                return true;
            },
            C => {
                return self.Subtarget.isOSWindowsOrUEFI();
            },
            _ => {
                return false;
            },
        }
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, Out: *OutputArg) -> bool {
        return Out.VT == f128;
    }

struct Closure_3 {}

fn Closure_3::call(self: *mut Closure_3, A: *CCValAssign, B: *CCValAssign) -> auto {
        return A.getValNo() < B.getValNo();
    }

struct Closure_4 {}

fn Closure_4::call(self: *Closure_4, Arg: *Argument) -> bool {
            return Arg.getType().isX86_FP80Ty();
        }

struct Closure_5 {
    CallConv: *mut ID,
    HasNCSR: *mut bool,
    CB: *mut *CallBase,
    RegInfo: *mut *X86RegisterInfo,
    MF: *mut MachineFunction,
}

unsafe fn Closure_5::call(self: *mut Closure_5) -> *u32 {
        let mut AdaptedCC: ID = (*self.CallConv);
        if (*self.HasNCSR) {
            AdaptedCC = X86_INTR as ID;
        }
        if (*self.CB) && (*self.CB).hasFnAttr("no_callee_saved_registers") {
            AdaptedCC = GHC as ID;
        }
        return (*self.RegInfo).getCallPreservedMask((*self.MF), AdaptedCC);
    }
