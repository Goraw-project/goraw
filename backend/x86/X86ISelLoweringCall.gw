// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

static mut NumTailCalls: Statistic = Statistic { "x86-isel", "NumTailCalls", "Number of tail calls" };

fn errorUnsupported(DAG: *mut SelectionDAG, dl: *SDLoc, Msg: *u8) {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    DAG.getContext().diagnose(DiagnosticInfoUnsupported { MF.getFunction(), Msg, DiagnosticLocation { dl.getDebugLoc() }, DS_Error });
}

fn shouldDisableRetRegFromCSR(CC: ID) -> bool {
    match CC {
        _ => {
            return false;
        },
        X86_RegCall => {
            PreserveMost;
        },
    }
}

fn shouldDisableArgRegFromCSR(CC: ID) -> bool {
    return CC == X86_RegCall;
}

fn handleMaskRegisterForCallingConv(NumElts: u32, CC: ID, Subtarget: *X86Subtarget) -> pair<MVT, unsigned int> {
    if NumElts == 2 {
        return void { v2i64, 1 };
    }
    if NumElts == 4 {
        return void { v4i32, 1 };
    }
    if NumElts == 8 && CC != X86_RegCall && CC != Intel_OCL_BI {
        return void { v8i16, 1 };
    }
    if NumElts == 16 && CC != X86_RegCall && CC != Intel_OCL_BI {
        return void { v16i8, 1 };
    }
    if NumElts == 32 && (operator!(Subtarget()()) || CC != X86_RegCall) {
        return void { v32i8, 1 };
    }
    if NumElts == 64 && Subtarget()() && CC != X86_RegCall {
        if Subtarget.useAVX512Regs() {
            return void { v64i8, 1 };
        }
        return void { v32i8, 2 };
    }
    if !isPowerOf2_32(NumElts) || (NumElts == 64 && operator!(Subtarget()())) || NumElts > 64 {
        return void { i8, NumElts };
    }
    return void { INVALID_SIMPLE_VALUE_TYPE, 0 };
}

fn X86TargetLowering::getRegisterTypeForCallingConv(self: *X86TargetLowering, Context: *mut LLVMContext, CC: ID, VT: EVT) -> MVT {
    if VT.isVector() {
        if VT.getVectorElementType() == EVT { i1 } && self.Subtarget.hasAVX512() {
            let mut NumElts: u32 = VT.getVectorNumElements();
            let mut RegisterVT: MVT = MVT {};
            let mut NumRegisters: u32 = 0;
            if RegisterVT != INVALID_SIMPLE_VALUE_TYPE {
                return RegisterVT;
            }
        }
        if VT.getVectorElementType() == EVT { f16 } && VT.getVectorNumElements() < 8 {
            return MVT { SimpleTy: v8f16 };
        }
    }
    if (VT == EVT { f64 } || VT == EVT { f80 }) && operator!(self.Subtarget()) && operator!(self.Subtarget()) {
        return MVT { SimpleTy: i32 };
    }
    if self.isTypeLegal {
        if VT.isVectorOf(EVT { bf16 }) {
            return self.getRegisterTypeForCallingConv(Context, CC, VT.changeVectorElementType(Context, EVT { f16 }));
        }
        if VT == EVT { bf16 } {
            return MVT { SimpleTy: f16 };
        }
    }
    return self.getRegisterTypeForCallingConv;
}

fn X86TargetLowering::getNumRegistersForCallingConv(self: *X86TargetLowering, Context: *mut LLVMContext, CC: ID, VT: EVT) -> u32 {
    if VT.isVector() {
        if VT.getVectorElementType() == EVT { i1 } && self.Subtarget.hasAVX512() {
            let mut NumElts: u32 = VT.getVectorNumElements();
            let mut RegisterVT: MVT = MVT {};
            let mut NumRegisters: u32 = 0;
            if RegisterVT != INVALID_SIMPLE_VALUE_TYPE {
                return NumRegisters;
            }
        }
        if VT.getVectorElementType() == EVT { f16 } && VT.getVectorNumElements() < 8 {
            return 1;
        }
    }
    if operator!(self.Subtarget()) && operator!(self.Subtarget()) {
        if VT == EVT { f64 } {
            return 2;
        }
        if VT == EVT { f80 } {
            return 3;
        }
    }
    if VT.isVectorOf(EVT { bf16 }) && self.isTypeLegal {
        return self.getNumRegistersForCallingConv(Context, CC, VT.changeVectorElementType(Context, EVT { f16 }));
    }
    return self.getNumRegistersForCallingConv;
}

fn X86TargetLowering::getVectorTypeBreakdownForCallingConv(self: *X86TargetLowering, Context: *mut LLVMContext, CC: ID, VT: EVT, IntermediateVT: *mut EVT, NumIntermediates: *mut u32, RegisterVT: *mut MVT) -> u32 {
    if VT.isVectorOf(EVT { i1 }) && self.Subtarget.hasAVX512() && (!isPowerOf2_32(VT.getVectorNumElements()) || (VT.getVectorNumElements() == 64 && operator!(self.Subtarget())) || VT.getVectorNumElements() > 64) {
        RegisterVT = MVT { SimpleTy: i8 };
        IntermediateVT = EVT { i1 };
        NumIntermediates = VT.getVectorNumElements();
        return NumIntermediates;
    }
    if VT == EVT { v64i1 } && self.Subtarget() && !self.Subtarget.useAVX512Regs() && CC != X86_RegCall {
        RegisterVT = MVT { SimpleTy: v32i8 };
        IntermediateVT = EVT { v32i1 };
        NumIntermediates = 2;
        return 2;
    }
    if VT.isVectorOf(EVT { bf16 }) && self.isTypeLegal {
        VT = VT.changeVectorElementType(Context, EVT { f16 });
    }
    return self.getVectorTypeBreakdownForCallingConv;
}

fn X86TargetLowering::getSetCCResultType(self: *X86TargetLowering, DL: *DataLayout, Context: *mut LLVMContext, VT: EVT) -> EVT {
    if !VT.isVector() {
        return EVT { i8 };
    }
    if self.Subtarget.hasAVX512() {
        let mut LegalVT: EVT = VT;
        while  != TypeLegal {
            LegalVT = self.getTypeToTransformTo(Context, LegalVT);
        }
        if LegalVT.getSimpleVT().is512BitVector() {
            return getVectorVT(Context, EVT { i1 }, VT.getVectorElementCount());
        }
        if LegalVT.getSimpleVT().isVector() && self.Subtarget() {
            let mut EltVT: MVT = LegalVT.getSimpleVT().getVectorElementType();
            if self.Subtarget() || EltVT.getSizeInBits().operator unsigned long long() >= 32 {
                return getVectorVT(Context, EVT { i1 }, VT.getVectorElementCount());
            }
        }
    }
    return VT.changeVectorElementTypeToInteger();
}

fn X86TargetLowering::functionArgumentNeedsConsecutiveRegisters(self: *X86TargetLowering, Ty: *mut Type, CallConv: ID, isVarArg: bool, DL: *DataLayout) -> bool {
    if Ty.isIntegerTy(128) {
        return true;
    }
    if self.Subtarget() && Ty.isFP128Ty() {
        return true;
    }
    return false;
}

fn getMaxByValAlign(Ty: *mut Type, MaxAlign: *mut Align) {
    if MaxAlign == 16 {
        return;
    }
    if dyn_cast(Ty) {
        VTy;
    } else {
        if VTy.getPrimitiveSizeInBits().getFixedValue() == 128 {
            MaxAlign = Align { ShiftValue: 16 };
        }
    }
}

fn X86TargetLowering::getByValTypeAlignment(self: *X86TargetLowering, Ty: *mut Type, DL: *DataLayout) -> Align {
    if self.Subtarget() {
        return max(DL.getABITypeAlign(Ty), Constant());
    }
    let mut Alignment: Align = Align { ShiftValue: 4 };
    if self.Subtarget.hasSSE1() {
        getMaxByValAlign(Ty, Alignment);
    }
    return Alignment;
}

fn X86TargetLowering::getOptimalMemOpType(self: *X86TargetLowering, Context: *mut LLVMContext, Op: *MemOp, FuncAttributes: *AttributeList) -> EVT {
    if !FuncAttributes.hasFnAttr(NoImplicitFloat) {
        if Op.len >= 16 && (operator!(self.Subtarget()) || Op.isAligned(Align { ShiftValue: 16 })) {
            if Op.len >= 64 && self.Subtarget.hasAVX512() && (self.Subtarget.getPreferVectorWidth() >= 512) {
                return if self.Subtarget() { v64i8 } else { v16i32 };
            }
            if Op.len >= 32 && self.Subtarget.hasAVX() && self.Subtarget.useLight256BitInstructions() {
                return EVT { v32i8 };
            }
            if self.Subtarget.hasSSE2() && (self.Subtarget.getPreferVectorWidth() >= 128) {
                return EVT { v16i8 };
            }
            if self.Subtarget.hasSSE1() && (self.Subtarget() || self.Subtarget()) && (self.Subtarget.getPreferVectorWidth() >= 128) {
                return EVT { v4f32 };
            }
        } else if ((Op.isMemcpyOrMemmove() && !Op.isMemcpyStrSrc()) || Op.isZeroMemset()) && Op.len >= 8 && operator!(self.Subtarget()) && self.Subtarget.hasSSE2() {
            return EVT { f64 };
        }
    }
    if self.Subtarget() && Op.len >= 8 {
        return EVT { i64 };
    }
    return EVT { i32 };
}

fn X86TargetLowering::isSafeMemOpType(self: *X86TargetLowering, VT: MVT) -> bool {
    if VT == f32 {
        return self.Subtarget.hasSSE1();
    }
    if VT == f64 {
        return self.Subtarget.hasSSE2();
    }
    return true;
}

fn isBitAligned(Alignment: Align, SizeInBits: u64) -> bool {
    return (8 * Alignment.value()) % SizeInBits == 0;
}

fn X86TargetLowering::isMemoryAccessFast(self: *X86TargetLowering, VT: EVT, Alignment: Align) -> bool {
    if isBitAligned(Alignment, VT.getSizeInBits().operator unsigned long long()) {
        return true;
    }
    match VT.getSizeInBits().operator unsigned long long() {
        _ => {
            return true;
        },
        128 => {
            return operator!(self.Subtarget());
        },
        256 => {
            return operator!(self.Subtarget());
        },
    }
}

fn X86TargetLowering::allowsMisalignedMemoryAccesses(self: *X86TargetLowering, VT: EVT, arg: u32, Alignment: Align, Flags: Flags, Fast: *mut u32) -> bool {
    if Fast {
        *Fast = self.isMemoryAccessFast(VT, Alignment);
    }
    if !!(Flags & MONonTemporal) && VT.isVector() {
        if !!(Flags & MOLoad) {
            return (Alignment < 16 || !self.Subtarget.hasSSE41());
        }
        return false;
    }
    return true;
}

fn X86TargetLowering::allowsMemoryAccess(self: *X86TargetLowering, Context: *mut LLVMContext, DL: *DataLayout, VT: EVT, AddrSpace: u32, Alignment: Align, Flags: Flags, Fast: *mut u32) -> bool {
    if Fast {
        *Fast = self.isMemoryAccessFast(VT, Alignment);
    }
    if !!(Flags & MONonTemporal) && VT.isVector() {
        if self.allowsMisalignedMemoryAccesses(VT, AddrSpace, Alignment, Flags, null) {
            return true;
        }
        if !isBitAligned(Alignment, VT.getSizeInBits().operator unsigned long long()) {
            return false;
        }
        match VT.getSizeInBits().operator unsigned long long() {
            128 => {
                if !!(Flags & MOLoad) && self.Subtarget.hasSSE41() {
                    return true;
                }
            },
            256 => {
                if !!(Flags & MOLoad) && self.Subtarget.hasAVX2() {
                    return true;
                }
            },
            512 => {
                if self.Subtarget.hasAVX512() {
                    return true;
                }
            },
            _ => {
                return false;
            },
        }
    }
    return true;
}

fn X86TargetLowering::getJumpTableEncoding(self: *X86TargetLowering) -> u32 {
    if self.isPositionIndependent && self.Subtarget.isPICStyleGOT() {
        return EK_Custom32;
    }
    if self.isPositionIndependent && self.getTargetMachine() == Large && !self.Subtarget.isTargetCOFF() {
        return EK_LabelDifference64;
    }
    return self.getJumpTableEncoding;
}

fn X86TargetLowering::useSoftFloat(self: *X86TargetLowering) -> bool {
    return self.Subtarget();
}

fn X86TargetLowering::markLibCallAttributes(self: *X86TargetLowering, MF: *mut MachineFunction, CC: u32, Args: *mut i32) {
    if self.Subtarget() {
        return;
    }
    if CC != C && CC != X86_StdCall {
        return;
    }
    let mut ParamRegs: u32 = 0;
    if MF.getFunction().getParent() {
        M;
    } else {
        ParamRegs = M.getNumberRegisterParameters();
    }
}

fn X86TargetLowering::LowerCustomJumpTableEntry(self: *X86TargetLowering, MJTI: *MachineJumpTableInfo, MBB: *MachineBasicBlock, uid: u32, Ctx: *mut MCContext) -> *MCExpr {
    (((operator!(operator!((self.isPositionIndependent && self.Subtarget.isPICStyleGOT())))) || (_wassert(L"isPositionIndependent() && Subtarget.isPICStyleGOT()", L"llvm\\lib\\Target\\X86\\X86ISelLoweringCall.cpp", (481) as u32) , 0)) as void);
    return create(MBB.getSymbol(), S_GOTOFF, Ctx, SMLoc {});
}

fn X86TargetLowering::getPICJumpTableRelocBase(self: *X86TargetLowering, Table: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if operator!(self.Subtarget()) {
        return DAG(GlobalBaseReg, SDLoc {}, self.getPointerTy);
    }
    return Table;
}

fn X86TargetLowering::getPICJumpTableRelocBaseExpr(self: *X86TargetLowering, MF: *MachineFunction, JTI: u32, Ctx: *mut MCContext) -> *MCExpr {
    if self.Subtarget.isPICStyleRIPRel() || (self.Subtarget() && self.getTargetMachine() == Large) {
        return self.getPICJumpTableRelocBaseExpr;
    }
    return create(MF.getPICBaseSymbol(), Ctx, SMLoc {});
}

fn X86TargetLowering::findRepresentativeClass(self: *X86TargetLowering, TRI: *TargetRegisterInfo, VT: MVT) -> pair<const TargetRegisterClass *, uint8_t> {
    let mut RRC: *TargetRegisterClass = null;
    let mut Cost: u8 = 1;
    match VT.SimpleTy {
        _ => {
            return self.findRepresentativeClass;
        },
        i8 => {
            i16;
        },
        x86mmx => {
            
        },
        f32 => {
            f64;
        },
    }
    return make_pair(RRC, Cost);
}

fn X86TargetLowering::getAddressSpace(self: *X86TargetLowering) -> u32 {
    if self.Subtarget() {
        return if (self.getTargetMachine() == Kernel) { GS } else { FS };
    }
    return GS;
}

fn hasStackGuardSlotTLS(TargetTriple: *Triple) -> bool {
    return TargetTriple.isOSGlibc() || TargetTriple.isMusl() || TargetTriple.isOSFuchsia() || TargetTriple.isAndroid();
}

fn SegmentOffset(IRB: *mut IRBuilderBase, Offset: i32, AddressSpace: u32) -> *mut Constant {
    return getIntToPtr(getSigned(getInt32Ty(IRB.getContext()), Offset, false), IRB.getPtrTy(AddressSpace), false);
}

fn X86TargetLowering::getIRStackGuard(self: *X86TargetLowering, IRB: *mut IRBuilderBase, Libcalls: *LibcallLoweringInfo) -> *mut Value {
    if hasStackGuardSlotTLS(self.Subtarget.getTargetTriple()) {
        let mut AddressSpace: u32 = self.getAddressSpace();
        if self.Subtarget.isTargetFuchsia() {
            return SegmentOffset(IRB, 16, AddressSpace);
        }
        let mut M: *mut Module = IRB.GetInsertBlock().getParent().getParent();
        let mut Offset: i32 = M.getStackProtectorGuardOffset();
        if Offset == 2147483647 {
            Offset = if (self.Subtarget()) { 40 } else { 20 };
        }
        let mut GuardReg: str = M.getStackProtectorGuardReg();
        if GuardReg == "fs" {
            AddressSpace = FS;
        } else if GuardReg == "gs" {
            AddressSpace = GS;
        }
        let mut GuardSymb: str = M.getStackProtectorGuardSymbol();
        if !GuardSymb.is_empty() {
            let mut GV: *mut GlobalVariable = M.getGlobalVariable(GuardSymb, false);
            if !GV {
                let mut Ty: *mut Type = if self.Subtarget() { getInt64Ty(M.getContext()) } else { getInt32Ty(M.getContext()) };
                if !self.Subtarget.isTargetDarwin() {
                    GV.setDSOLocal(M.getDirectAccessExternalData());
                }
            }
            return GV;
        }
        return SegmentOffset(IRB, Offset, AddressSpace);
    }
    return self.getIRStackGuard;
}

fn X86TargetLowering::insertSSPDeclarations(self: *X86TargetLowering, M: *mut Module, Libcalls: *LibcallLoweringInfo) {
    let mut SecurityCheckCookieLibcall: LibcallImpl = Libcalls.getLibcallImpl(SECURITY_CHECK_COOKIE);
    let mut SecurityCookieVar: LibcallImpl = Libcalls.getLibcallImpl(STACK_CHECK_GUARD);
    if SecurityCheckCookieLibcall != Unsupported && SecurityCookieVar != Unsupported {
        M.getOrInsertGlobal(getLibcallImplName(SecurityCookieVar), getUnqual(M.getContext()));
        let mut SecurityCheckCookie: FunctionCallee = M;
        if dyn_cast(SecurityCheckCookie.getCallee()) {
            F;
        } else {
            F.setCallingConv(X86_FastCall);
            F.addParamAttr(0, InReg);
        }
        return;
    }
    let mut GuardMode: str = M.getStackProtectorGuard();
    if (GuardMode == "tls" || GuardMode.len == 0) && hasStackGuardSlotTLS(self.Subtarget.getTargetTriple()) {
        return;
    }
    self.insertSSPDeclarations;
}

fn X86TargetLowering::getSafeStackPointerLocation(self: *X86TargetLowering, IRB: *mut IRBuilderBase, Libcalls: *LibcallLoweringInfo) -> *mut Value {
    if self.Subtarget.isTargetAndroid() {
        let mut Offset: i32 = if (self.Subtarget()) { 72 } else { 36 };
        return SegmentOffset(IRB, Offset, self.getAddressSpace());
    }
    if self.Subtarget.isTargetFuchsia() {
        return SegmentOffset(IRB, 24, self.getAddressSpace());
    }
    return self.getSafeStackPointerLocation;
}

fn X86TargetLowering::CanLowerReturn(self: *X86TargetLowering, CallConv: ID, MF: *mut MachineFunction, isVarArg: bool, Outs: *OutputArg>, Context: *mut LLVMContext, RetTy: *Type) -> bool {
    let mut IsWin64F128StackCC: Closure_1 = Closure_1 { cap_0: self };
    if IsWin64F128StackCC.call(CallConv) && any_of(Outs, Closure_2 {}) {
        return false;
    }
    let mut RVLocs: SmallVector<CCValAssign, 16> = zeroed();
    let mut CCInfo: CCState = CallConv;
    return CCInfo.CheckReturn(Outs, RetCC_X86);
}

fn X86TargetLowering::getScratchRegisters(self: *X86TargetLowering, arg: ID) -> *MCPhysReg {
    let mut ScratchRegs: []MCPhysReg = zeroed();
    return ScratchRegs;
}

fn X86TargetLowering::getRoundingControlRegisters(self: *X86TargetLowering) -> ArrayRef<MCPhysReg> {
    let mut RCRegs: []MCPhysReg = zeroed();
    return RCRegs();
}

fn lowerMasksToReg(ValArg: *SDValue, ValLoc: *EVT, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut ValVT: EVT = ValArg.getValueType();
    if ValVT == EVT { v1i1 } {
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, ValLoc, ValArg, DAG.getIntPtrConstant(0, DL, false));
    }
    if (ValVT == EVT { v8i1 } && (ValLoc == EVT { i8 } || ValLoc == EVT { i32 })) || (ValVT == EVT { v16i1 } && (ValLoc == EVT { i16 } || ValLoc == EVT { i32 })) {
        let mut TempValLoc: EVT = EVT { if ValVT == EVT { v8i1 } { i8 } else { i16 } };
        let mut ValToCopy: SDValue = DAG.getBitcast(TempValLoc, ValArg);
        if ValLoc == EVT { i32 } {
            ValToCopy = DAG.getNode(ANY_EXTEND, DL, ValLoc, ValToCopy);
        }
        return ValToCopy;
    }
    if (ValVT == EVT { v32i1 } && ValLoc == EVT { i32 }) || (ValVT == EVT { v64i1 } && ValLoc == EVT { i64 }) {
        return DAG.getBitcast(ValLoc, ValArg);
    }
    return DAG.getNode(ANY_EXTEND, DL, ValLoc, ValArg);
}

fn Passv64i1ArgInRegs(DL: *SDLoc, DAG: *mut SelectionDAG, Arg: *mut SDValue, RegsToPass: *mut pair<Register, SDValue>>, VA: *mut CCValAssign, NextVA: *mut CCValAssign, Subtarget: *X86Subtarget) {
    (((operator!(operator!((Subtarget()() && "Expected AVX512BW target!")))) || (_wassert(L"Subtarget.hasBWI() && \"Expected AVX512BW target!\"", L"llvm\\lib\\Target\\X86\\X86ISelLoweringCall.cpp", (763) as u32) , 0)) as void);
    (((operator!(operator!((Subtarget()() && "Expecting 32 bit target")))) || (_wassert(L"Subtarget.is32Bit() && \"Expecting 32 bit target\"", L"llvm\\lib\\Target\\X86\\X86ISelLoweringCall.cpp", (764) as u32) , 0)) as void);
    assert!(Arg.getValueType() == EVT { i64 }, "Expecting 64 bit value");
    assert!(VA.isRegLoc() && NextVA.isRegLoc(), "The value should reside in two registers");
    Arg = DAG.getBitcast(EVT { i64 }, Arg);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    tie(Lo, Hi) = DAG.SplitScalar(Arg, DL, EVT { i32 }, EVT { i32 });
    RegsToPass()(make_pair(VA.getLocReg(), Lo));
    RegsToPass()(make_pair(NextVA.getLocReg(), Hi));
}

fn X86TargetLowering::LowerReturn(self: *X86TargetLowering, Chain: SDValue, CallConv: ID, isVarArg: bool, Outs: *OutputArg>, OutVals: *SmallVectorImpl<SDValue>, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut X86MachineFunctionInfo = MF;
    let mut ShouldDisableCalleeSavedRegister: bool = shouldDisableRetRegFromCSR(CallConv) || MF.getFunction().hasFnAttribute("no_caller_saved_registers");
    if CallConv == X86_INTR && operator!(Outs()()) {
        report_fatal_error("X86 interrupts may not return any value", true);
    }
    let mut RVLocs: SmallVector<CCValAssign, 16> = zeroed();
    let mut CCInfo: CCState = CallConv;
    CCInfo.AnalyzeReturn(Outs, RetCC_X86);
    let mut RetVals: pair<Register, SDValue>, 4> = zeroed();
    for let mut I: u32 = 0;
let mut OutsIndex: u32 = 0;
let mut E: u32 = (); I != E; I += 1 , OutsIndex += 1 {
        let mut VA: *mut CCValAssign = [I];
        assert!(VA.isRegLoc(), "Can only return in registers!");
        if ShouldDisableCalleeSavedRegister {
            MF.getRegInfo().disableCalleeSavedRegister(VA.getLocReg().operator MCRegister());
        }
        let mut ValToCopy: SDValue = OutVals[OutsIndex];
        let mut ValVT: EVT = ValToCopy.getValueType();
        if VA.getLocInfo() == SExt {
            ValToCopy = DAG.getNode(SIGN_EXTEND, dl, EVT { VA.getLocVT() }, ValToCopy);
        } else if VA.getLocInfo() == ZExt {
            ValToCopy = DAG.getNode(ZERO_EXTEND, dl, EVT { VA.getLocVT() }, ValToCopy);
        } else if VA.getLocInfo() == AExt {
            if ValVT.isVectorOf(EVT { i1 }) {
                ValToCopy = lowerMasksToReg(ValToCopy, EVT { VA.getLocVT() }, dl, DAG);
            } else {
                ValToCopy = DAG.getNode(ANY_EXTEND, dl, EVT { VA.getLocVT() }, ValToCopy);
            }
        } else if VA.getLocInfo() == BCvt {
            ValToCopy = DAG.getBitcast(EVT { VA.getLocVT() }, ValToCopy);
        }
        assert!(VA.getLocInfo() != FPExt, "Unexpected FP-extend for return value.");
        if  {
            errorUnsupported(DAG, dl, "SSE register return with SSE disabled");
            VA.convertToReg;
        } else if  {
            errorUnsupported(DAG, dl, "SSE2 register return with SSE2 disabled");
            VA.convertToReg;
        }
        if  {
            if self.isScalarFPTypeInSSEReg(EVT { VA.getValVT() }) {
                ValToCopy = DAG.getNode(FP_EXTEND, dl, EVT { f80 }, ValToCopy);
            }
            RetVals()(make_pair(VA.getLocReg(), ValToCopy));
            continue;
        }
        if self.Subtarget() {
            if ValVT == EVT { x86mmx } {
                if  {
                    ValToCopy = DAG.getBitcast(EVT { i64 }, ValToCopy);
                    ValToCopy = DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { v2i64 }, ValToCopy);
                    if !self.Subtarget.hasSSE2() {
                        ValToCopy = DAG.getBitcast(EVT { v4f32 }, ValToCopy);
                    }
                }
            }
        }
        if VA.needsCustom() {
            assert!(VA.getValVT() == v64i1, "Currently the only custom case is when we split v64i1 to 2 regs");
            Passv64i1ArgInRegs(dl, DAG, ValToCopy, VA, [I += 1], self.Subtarget);
            if ShouldDisableCalleeSavedRegister {
                MF.getRegInfo().disableCalleeSavedRegister([I]());
            }
        } else {
            RetVals()(make_pair(VA.getLocReg(), ValToCopy));
        }
    }
    let mut Glue: SDValue = SDValue {};
    let mut RetOps: SmallVector<SDValue, 6> = zeroed();
    RetOps()(Chain);
    RetOps()(DAG.getTargetConstant(FuncInfo.getBytesToPopOnReturn(), dl, EVT { i32 }, false));
    if FuncInfo.getSRetReturnReg() {
        SRetReg.operator unsigned int();
    } else {
        let mut Val: SDValue = DAG([0], dl, SRetReg, self.getPointerTy);
        let mut RetValReg: Register = zeroed();
        Chain = DAG.getCopyToReg(Chain, dl, RetValReg, Val, Glue);
        Glue = Chain.getValue(1);
        RetOps()(DAG.getRegister(RetValReg, self.getPointerTy));
        if ShouldDisableCalleeSavedRegister && CallConv != PreserveAll && CallConv != PreserveMost {
            MF.getRegInfo().disableCalleeSavedRegister(RetValReg.operator MCRegister());
        }
    }
    let mut TRI: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut I: *MCPhysReg = TRI.getCalleeSavedRegsViaCopy(&mut DAG.getMachineFunction());
    if I {
        for ; *I; I += 1 {
            if  {
                RetOps()(DAG.getRegister(Register { Reg: *I }, EVT { i64 }));
            } else {
                llvm_unreachable_internal("Unexpected register class in CSRsViaCopy!", "llvm\\lib\\Target\\X86\\X86ISelLoweringCall.cpp", 974);
            }
        }
    }
    RetOps()[0] = Chain;
    if Glue.getNode() {
        RetOps()(Glue);
    }
    let mut RetOpcode: u32 = 0;
    return DAG(RetOpcode, dl, Other);
}

fn X86TargetLowering::isUsedByReturnOnly(self: *X86TargetLowering, N: *mut SDNode, Chain: *mut SDValue) -> bool {
    if N.getNumValues() != 1 || !N.hasNUsesOfValue(1, 0) {
        return false;
    }
    let mut TCChain: SDValue = Chain;
    let mut Copy: *mut SDNode = operator(N.user_begin());
    if Copy.getOpcode() == CopyToReg {
        if Copy.getOperand(Copy.getNumOperands() - 1).getValueType() == EVT { Glue } {
            return false;
        }
        TCChain = Copy.getOperand(0);
    } else if Copy.getOpcode() != FP_EXTEND {
        return false;
    }
    let mut HasRet: bool = false;
    for U in Copy.users() {
        if  {
            return false;
        }
        if U.getNumOperands() > 4 {
            return false;
        }
        if U.getNumOperands() == 4 && U.getOperand(U.getNumOperands() - 1).getValueType() != EVT { Glue } {
            return false;
        }
        HasRet = true;
    }
    if !HasRet {
        return false;
    }
    Chain = TCChain;
    return true;
}

fn X86TargetLowering::getTypeForExtReturn(self: *X86TargetLowering, Context: *mut LLVMContext, VT: EVT, ExtendKind: NodeType) -> EVT {
    let mut ReturnMVT: MVT = MVT { SimpleTy: i32 };
    let mut Darwin: bool = self.Subtarget.getTargetTriple().isOSDarwin();
    if VT == EVT { i1 } || (!Darwin && (VT == EVT { i8 } || VT == EVT { i16 })) {
        ReturnMVT = MVT { SimpleTy: i8 };
    }
    let mut MinVT: EVT = self.getRegisterType;
    return if VT.bitsLT(MinVT) { MinVT } else { VT };
}

fn getv64i1Argument(VA: *mut CCValAssign, NextVA: *mut CCValAssign, Root: *mut SDValue, DAG: *mut SelectionDAG, DL: *SDLoc, Subtarget: *X86Subtarget, InGlue: *mut SDValue) -> SDValue {
    (((operator!(operator!(((Subtarget()()) && "Expected AVX512BW target!")))) || (_wassert(L"(Subtarget.hasBWI()) && \"Expected AVX512BW target!\"", L"llvm\\lib\\Target\\X86\\X86ISelLoweringCall.cpp", (1057) as u32) , 0)) as void);
    (((operator!(operator!((Subtarget()() && "Expecting 32 bit target")))) || (_wassert(L"Subtarget.is32Bit() && \"Expecting 32 bit target\"", L"llvm\\lib\\Target\\X86\\X86ISelLoweringCall.cpp", (1058) as u32) , 0)) as void);
    assert!(VA.getValVT() == v64i1, "Expecting first location of 64 bit width type");
    assert!(NextVA.getValVT() == VA.getValVT(), "The locations should have the same type");
    assert!(VA.isRegLoc() && NextVA.isRegLoc(), "The values should reside in two registers");
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut ArgValueLo: SDValue = SDValue {};
    let mut ArgValueHi: SDValue = SDValue {};
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut RC: *TargetRegisterClass = null;
    if null == InGlue {
        let mut Reg: Register = MF.addLiveIn(VA.getLocReg().operator MCRegister(), RC);
        ArgValueLo = DAG.getCopyFromReg(Root, DL, Reg, EVT { i32 });
        Reg = MF.addLiveIn(NextVA.getLocReg().operator MCRegister(), RC);
        ArgValueHi = DAG.getCopyFromReg(Root, DL, Reg, EVT { i32 });
    } else {
        ArgValueLo = DAG.getCopyFromReg(Root, DL, VA.getLocReg(), EVT { i32 }, *InGlue);
        *InGlue = ArgValueLo.getValue(2);
        ArgValueHi = DAG.getCopyFromReg(Root, DL, NextVA.getLocReg(), EVT { i32 }, *InGlue);
        *InGlue = ArgValueHi.getValue(2);
    }
    Lo = DAG.getBitcast(EVT { v32i1 }, ArgValueLo);
    Hi = DAG.getBitcast(EVT { v32i1 }, ArgValueHi);
    return DAG.getNode(CONCAT_VECTORS, DL, EVT { v64i1 }, Lo, Hi);
}

fn lowerRegToMasks(ValArg: *SDValue, ValVT: *EVT, ValLoc: *EVT, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut ValReturned: SDValue = ValArg;
    if ValVT == EVT { v1i1 } {
        return DAG.getNode(SCALAR_TO_VECTOR, DL, EVT { v1i1 }, ValReturned);
    }
    if ValVT == EVT { v64i1 } {
        assert!(ValLoc == EVT { i64 }, "Expecting only i64 locations");
    } else {
        let mut MaskLenVT: MVT = MVT {};
        match ValVT.getSimpleVT().SimpleTy {
            v8i1 => {
                MaskLenVT = MVT { SimpleTy: i8 };
            },
            v16i1 => {
                MaskLenVT = MVT { SimpleTy: i16 };
            },
            v32i1 => {
                MaskLenVT = MVT { SimpleTy: i32 };
            },
            _ => {
                llvm_unreachable_internal("Expecting a vector of i1 types", "llvm\\lib\\Target\\X86\\X86ISelLoweringCall.cpp", 1129);
            },
        }
        ValReturned = DAG.getNode(TRUNCATE, DL, EVT { MaskLenVT }, ValReturned);
    }
    return DAG.getBitcast(ValVT, ValReturned);
}

fn getPopFromX87Reg(DAG: *mut SelectionDAG, Chain: SDValue, dl: *SDLoc, Reg: Register, VT: EVT, Glue: SDValue) -> SDValue {
    let mut VTs: SDVTList = DAG.getVTList(VT, EVT { Other }, EVT { Glue });
    let mut Ops: [3]SDValue = [Chain, DAG.getRegister(Reg, VT), Glue];
    return DAG(POP_FROM_X87_REG, dl, VTs, Ops(if Glue.getNode() { 3 } else { 2 }));
}

fn X86TargetLowering::LowerCallResult(self: *X86TargetLowering, Chain: SDValue, InGlue: SDValue, CallConv: ID, isVarArg: bool, Ins: *InputArg>, dl: *SDLoc, DAG: *mut SelectionDAG, InVals: *mut SmallVectorImpl<SDValue>, RegMask: *mut u32) -> SDValue {
    let mut TRI: *TargetRegisterInfo = self.Subtarget.getRegisterInfo();
    let mut RVLocs: SmallVector<CCValAssign, 16> = zeroed();
    let mut CCInfo: CCState = CallConv;
    CCInfo.AnalyzeCallResult(Ins, RetCC_X86);
    for let mut I: u32 = 0;
let mut E: u32 = (); I != E; I += 1 {
        let mut VA: *mut CCValAssign = [I];
        let mut CopyVT: EVT = EVT { VA.getLocVT() };
        if RegMask {}
        if  {
            errorUnsupported(DAG, dl, "SSE register return with SSE disabled");
            if  {
                VA.convertToReg;
            } else {
                VA.convertToReg;
            }
        } else if  {
            errorUnsupported(DAG, dl, "SSE2 register return with SSE2 disabled");
            if  {
                VA.convertToReg;
            } else {
                VA.convertToReg;
            }
        }
        let mut RoundAfterCopy: bool = false;
        let mut X87Result: bool = false;
        if X87Result && self.isScalarFPTypeInSSEReg(EVT { VA.getValVT() }) {
            if operator!(self.Subtarget()) {
                report_fatal_error("X87 register return with X87 disabled", true);
            }
            CopyVT = EVT { f80 };
            RoundAfterCopy = (CopyVT != EVT { VA.getLocVT() });
        }
        let mut Val: SDValue = SDValue {};
        if VA.needsCustom() {
            assert!(VA.getValVT() == v64i1, "Currently the only custom case is when we split v64i1 to 2 regs");
            Val = getv64i1Argument(VA, [I += 1], Chain, DAG, dl, self.Subtarget, &mut InGlue);
        } else {
            Chain = if X87Result { getPopFromX87Reg(DAG, Chain, dl, VA.getLocReg(), CopyVT, InGlue).getValue(1) } else { DAG.getCopyFromReg(Chain, dl, VA.getLocReg(), CopyVT, InGlue).getValue(1) };
            Val = Chain.getValue(0);
            InGlue = Chain.getValue(2);
        }
        if RoundAfterCopy {
            Val = DAG.getNode(FP_ROUND, dl, EVT { VA.getValVT() }, Val, DAG.getIntPtrConstant(1, dl, true));
        }
        if VA.isExtInLoc() {
            if VA.getValVT().isVector() && VA.getValVT().getScalarType() == i1 && ((VA.getLocVT() == i64) || (VA.getLocVT() == i32) || (VA.getLocVT() == i16) || (VA.getLocVT() == i8)) {
                Val = lowerRegToMasks(Val, EVT { VA.getValVT() }, EVT { VA.getLocVT() }, dl, DAG);
            } else {
                Val = DAG.getNode(TRUNCATE, dl, EVT { VA.getValVT() }, Val);
            }
        }
        if VA.getLocInfo() == BCvt {
            Val = DAG.getBitcast(EVT { VA.getValVT() }, Val);
        }
        InVals.push(ValueParamT { Val });
    }
    return Chain;
}

