static mut NumLEAs: Statistic = Statistic { "x86-fixup-leas", "NumLEAs", "Number of LEA instructions created" };

struct FixupLEAsImpl {
    TSM: TargetSchedModel,
    TII: *X86InstrInfo,
    TRI: *X86RegisterInfo,
    PSI: *mut ProfileSummaryInfo,
    MBFI: *mut MachineBlockFrequencyInfo,
}

struct FixupLEAsLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn FixupLEAsLegacy::getPassName(self: *FixupLEAsLegacy) -> str {
    return "X86 LEA Fixup";
}

fn FixupLEAsLegacy::getRequiredProperties(self: *FixupLEAsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn FixupLEAsLegacy::getAnalysisUsage(self: *FixupLEAsLegacy, AU: *mut AnalysisUsage) {
    AU.addRequired();
    AU.addRequired();
    self.getAnalysisUsage(AU);
}

fn FixupLEAsLegacy::getPassKind(self: *FixupLEAsLegacy) -> PassKind {
    return self.Kind;
}

fn FixupLEAsLegacy::getPassID(self: *FixupLEAsLegacy) -> AnalysisID {
    return self.PassID;
}

fn FixupLEAsLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn FixupLEAsLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn FixupLEAsLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn FixupLEAsLegacy::getResolver(self: *FixupLEAsLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn FixupLEAsLegacy::getSetProperties(self: *FixupLEAsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn FixupLEAsLegacy::getClearedProperties(self: *FixupLEAsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn FixupLEAsImpl::postRAConvertToLEA(self: *FixupLEAsImpl, MBB: *mut MachineBasicBlock, MBBI: *mut iterator) -> *mut MachineInstr {
    let mut MI: *mut MachineInstr = operator(MBBI);
    match MI.getOpcode() {
        MOV32rr => {
            MOV64rr;
        },
    }
    if !MI.isConvertibleTo3Addr(IgnoreBundle) {
        return null;
    }
    match MI.getOpcode() {
        _ => {
            return null;
        },
        ADD64ri32 => {
            ADD64ri32_DB;
        },
        SHL64ri => {
            SHL32ri;
        },
    }
    return self.TII.convertToThreeAddress(MI, null);
}

fn createX86FixupLEAsLegacyPass() -> *mut FunctionPass {
    return FixupLEAsLegacy {};
}

fn isLEA(Opcode: u32) -> bool {
    return Opcode == LEA32r || Opcode == LEA64r || Opcode == LEA64_32r;
}

fn FixupLEAsImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut ST: *X86Subtarget = MF.getSubtarget();
    let mut IsSlowLEA: bool = ST.slowLEA();
    let mut IsSlow3OpsLEA: bool = ST.slow3OpsLEA();
    let mut LEAUsesAG: bool = ST.leaUsesAG();
    let mut OptIncDec: bool = !ST.slowIncDec() || MF.getFunction().hasOptSize();
    let mut UseLEAForSP: bool = ST.useLeaForSP();
    self.TSM.init(&mut ST, true, true);
    self.TII = ST.getInstrInfo();
    self.TRI = ST.getRegisterInfo();
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
            dbgs() << "Start X86FixupLEAs\n";
        }
    }
        if !(false) { break; }
    }
    for MBB in MF {
        let mut OptIncDecPerBB: bool = OptIncDec || shouldOptimizeForSize(&mut MBB, self.PSI, self.MBFI, Other);
        for let mut I: iterator = MBB.begin(); I != MBB.end(); operator(I) {
            if !isLEA(operator(I).getOpcode()) {
                continue;
            }
            if self.optTwoAddrLEA(I, MBB, OptIncDecPerBB, UseLEAForSP) {
                continue;
            }
            if IsSlowLEA {
                self.processInstructionForSlowLEA(I, MBB);
            } else if IsSlow3OpsLEA {
                self.processInstrForSlow3OpLEA(I, MBB, OptIncDecPerBB);
            }
        }
        if LEAUsesAG {
            for let mut I: iterator = MBB.begin(); I != MBB.end(); operator(I) {
                self.processInstruction(I, MBB);
            }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
            dbgs() << "End X86FixupLEAs\n";
        }
    }
        if !(false) { break; }
    }
    return true;
}

fn FixupLEAsImpl::usesRegister(self, p: *mut MachineOperand, I: iterator) -> RegUsageState {
    let mut RegUsage: RegUsageState = RU_NotUsed;
    let mut MI: *mut MachineInstr = operator(I);
    for MO in MI.operands() {
        if MO.isReg() && MO.getReg() == p.getReg() {
            if MO.isDef() {
                return RU_Write;
            }
            RegUsage = RU_Read;
        }
    }
    return RegUsage;
}

fn getPreviousInstr(I: *mut iterator, MBB: *mut MachineBasicBlock) -> bool {
    if I == MBB.begin() {
        if MBB.isPredecessor(&mut MBB) {
            I = operator(MBB.end());
            return true;
        } else {
            return false;
        }
    }
    operator(I);
    return true;
}

fn FixupLEAsImpl::searchBackwards(self, p: *mut MachineOperand, I: *mut iterator, MBB: *mut MachineBasicBlock) -> iterator {
    let mut InstrDistance: i32 = 1;
    let mut CurInst: iterator = iterator {};
    let mut INSTR_DISTANCE_THRESHOLD: i32 = 5;
    CurInst = I;
    let mut Found: bool = false;
    Found = getPreviousInstr(CurInst, MBB);
    while Found && I != CurInst {
        if operator(CurInst).isCall(AnyInBundle) || operator(CurInst).isInlineAsm() {
            break;
        }
        if InstrDistance > INSTR_DISTANCE_THRESHOLD {
            break;
        }
        if self.usesRegister(p, CurInst) == RU_Write {
            return CurInst;
        }
        InstrDistance += self.TSM.computeInstrLatency(&mut operator(CurInst), true);
        Found = getPreviousInstr(CurInst, MBB);
    }
    return iterator {};
}

fn isInefficientLEAReg(Reg: Register) -> bool {
    return Reg == EBP || Reg == RBP || Reg == R13D || Reg == R13;
}

fn hasInefficientLEABaseReg(Base: *MachineOperand, Index: *MachineOperand) -> bool {
    return Base.isReg() && isInefficientLEAReg(Base.getReg()) && Index.isReg() && Index.getReg().isValid();
}

fn mayHaveOffset(Offset: *MachineOperand) -> bool {
    return !(Offset.isImm() && Offset.getImm() == 0);
}

fn getADDrrFromLEA(LEAOpcode: u32) -> u32 {
    match LEAOpcode {
        _ => {
            llvm_unreachable_internal("Unexpected LEA instruction", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FixupLEAs.cpp", 354);
        },
        LEA32r => {
            LEA64_32r;
        },
        LEA64r => {
            return ADD64rr;
        },
    }
}

fn getSUBrrFromLEA(LEAOpcode: u32) -> u32 {
    match LEAOpcode {
        _ => {
            llvm_unreachable_internal("Unexpected LEA instruction", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FixupLEAs.cpp", 366);
        },
        LEA32r => {
            LEA64_32r;
        },
        LEA64r => {
            return SUB64rr;
        },
    }
}

fn getADDriFromLEA(LEAOpcode: u32, Offset: *MachineOperand) -> u32 {
    match LEAOpcode {
        _ => {
            llvm_unreachable_internal("Unexpected LEA instruction", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FixupLEAs.cpp", 379);
        },
        LEA32r => {
            LEA64_32r;
        },
        LEA64r => {
            return ADD64ri32;
        },
    }
}

fn getSUBriFromLEA(LEAOpcode: u32) -> u32 {
    match LEAOpcode {
        _ => {
            llvm_unreachable_internal("Unexpected LEA instruction", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FixupLEAs.cpp", 391);
        },
        LEA32r => {
            LEA64_32r;
        },
        LEA64r => {
            return SUB64ri32;
        },
    }
}

fn getINCDECFromLEA(LEAOpcode: u32, IsINC: bool) -> u32 {
    match LEAOpcode {
        _ => {
            llvm_unreachable_internal("Unexpected LEA instruction", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FixupLEAs.cpp", 403);
        },
        LEA32r => {
            LEA64_32r;
        },
        LEA64r => {
            return if IsINC { INC64r } else { DEC64r };
        },
    }
}

fn FixupLEAsImpl::searchALUInst(self: *FixupLEAsImpl, I: *mut iterator, MBB: *mut MachineBasicBlock) -> iterator {
    let mut InstrDistanceThreshold: i32 = 5;
    let mut InstrDistance: i32 = 1;
    let mut CurInst: iterator = next(I, 1);
    let mut LEAOpcode: u32 = operator(I).getOpcode();
    let mut AddOpcode: u32 = getADDrrFromLEA(LEAOpcode);
    let mut SubOpcode: u32 = getSUBrrFromLEA(LEAOpcode);
    let mut DestReg: Register = operator(I).getOperand(0).getReg();
    while CurInst != MBB.end() {
        if operator(CurInst).isCall(AnyInBundle) || operator(CurInst).isInlineAsm() {
            break;
        }
        if InstrDistance > InstrDistanceThreshold {
            break;
        }
        for let mut I: u32 = 0;
let mut E: u32 = operator(CurInst).getNumOperands(); I != E; I += 1 {
            let mut Opnd: *mut MachineOperand = operator(CurInst).getOperand(I);
            if Opnd.isReg() {
                if Opnd.getReg() == DestReg {
                    if Opnd.isDef() || !Opnd.isKill() {
                        return iterator {};
                    }
                    let mut AluOpcode: u32 = operator(CurInst).getOpcode();
                    if AluOpcode != AddOpcode && AluOpcode != SubOpcode {
                        return iterator {};
                    }
                    let mut Opnd2: *mut MachineOperand = operator(CurInst).getOperand(3 - I);
                    let mut AluDest: MachineOperand = operator(CurInst).getOperand(0);
                    if Opnd2.getReg() != AluDest.getReg() {
                        return iterator {};
                    }
                    if !operator(CurInst).registerDefIsDead(EFLAGS, self.TRI) {
                        return iterator {};
                    }
                    return CurInst;
                }
                if self.TRI.regsOverlap(DestReg, Opnd.getReg()) {
                    return iterator {};
                }
            }
        }
        InstrDistance += 1;
        operator(CurInst);
    }
    return iterator {};
}

fn FixupLEAsImpl::checkRegUsage(self: *FixupLEAsImpl, LeaI: *mut iterator, AluI: *mut iterator, BaseIndexDef: *mut bool, AluDestRef: *mut bool, KilledBase: *mut *mut MachineOperand, KilledIndex: *mut *mut MachineOperand) {
    BaseIndexDef = AluDestRef = false;
    *KilledBase = *KilledIndex = null;
    let mut BaseReg: Register = operator(LeaI).getOperand(1 + AddrBaseReg).getReg();
    let mut IndexReg: Register = operator(LeaI).getOperand(1 + AddrIndexReg).getReg();
    let mut AluDestReg: Register = operator(AluI).getOperand(0).getReg();
    for CurInst in make_range(next(LeaI, 1), AluI) {
        for Opnd in CurInst.operands() {
            if !Opnd.isReg() {
                continue;
            }
            let mut Reg: Register = Opnd.getReg();
            if self.TRI.regsOverlap(Reg, AluDestReg) {
                AluDestRef = true;
            }
            if self.TRI.regsOverlap(Reg, BaseReg) {
                if Opnd.isDef() {
                    BaseIndexDef = true;
                } else if Opnd.isKill() {
                    *KilledBase = &mut Opnd;
                }
            }
            if self.TRI.regsOverlap(Reg, IndexReg) {
                if Opnd.isDef() {
                    BaseIndexDef = true;
                } else if Opnd.isKill() {
                    *KilledIndex = &mut Opnd;
                }
            }
        }
    }
}

fn FixupLEAsImpl::optLEAALU(self: *FixupLEAsImpl, I: *mut iterator, MBB: *mut MachineBasicBlock) -> bool {
    let mut AluI: iterator = self.searchALUInst(I, MBB);
    if AluI == iterator {} {
        return false;
    }
    let mut BaseIndexDef: bool = false;
    let mut AluDestRef: bool = false;
    let mut KilledBase: *mut MachineOperand = null;
    let mut KilledIndex: *mut MachineOperand = null;
    self.checkRegUsage(I, AluI, BaseIndexDef, AluDestRef, &mut KilledBase, &mut KilledIndex);
    let mut InsertPos: iterator = AluI;
    if BaseIndexDef {
        if AluDestRef {
            return false;
        }
        InsertPos = I;
        KilledBase = KilledIndex = null;
    }
    let mut AluDestReg: Register = operator(AluI).getOperand(0).getReg();
    let mut BaseReg: Register = operator(I).getOperand(1 + AddrBaseReg).getReg();
    let mut IndexReg: Register = operator(I).getOperand(1 + AddrIndexReg).getReg();
    if operator(I).getOpcode() == LEA64_32r {
        BaseReg = self.TRI.getSubReg(BaseReg.operator MCRegister(), sub_32bit);
        IndexReg = self.TRI.getSubReg(IndexReg.operator MCRegister(), sub_32bit);
    }
    if AluDestReg == IndexReg {
        if BaseReg == IndexReg {
            return false;
        }
        swap(BaseReg, IndexReg);
        swap(KilledBase, KilledIndex);
    }
    if BaseReg == IndexReg {
        KilledBase = null;
    }
    let mut NewMI1: *mut MachineInstr = null;
    let mut NewMI2: *mut MachineInstr = null;
    let mut NewOpcode: u32 = operator(AluI).getOpcode();
    NewMI1 = BuildMI(MBB, InsertPos, MIMetadata { DL: operator(AluI).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpcode), AluDestReg).addReg(AluDestReg, Kill, 0).addReg(BaseReg, getKillRegState(KilledBase), 0).operator llvm::MachineInstr *();
    NewMI1.addRegisterDead(EFLAGS, self.TRI, false);
    NewMI2 = BuildMI(MBB, InsertPos, MIMetadata { DL: operator(AluI).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpcode), AluDestReg).addReg(AluDestReg, Kill, 0).addReg(IndexReg, getKillRegState(KilledIndex), 0).operator llvm::MachineInstr *();
    NewMI2.addRegisterDead(EFLAGS, self.TRI, false);
    if KilledBase {
        KilledBase.setIsKill(false);
    }
    if KilledIndex {
        KilledIndex.setIsKill(false);
    }
    MBB.getParent().substituteDebugValuesForInst(operator(AluI), *NewMI2, 1);
    MBB.erase(I);
    MBB.erase(AluI);
    I = NewMI1;
    return true;
}

fn FixupLEAsImpl::optTwoAddrLEA(self: *FixupLEAsImpl, I: *mut iterator, MBB: *mut MachineBasicBlock, OptIncDec: bool, UseLEAForSP: bool) -> bool {
    let mut MI: *mut MachineInstr = operator(I);
    let mut Base: *MachineOperand = MI.getOperand(1 + AddrBaseReg);
    let mut Scale: *MachineOperand = MI.getOperand(1 + AddrScaleAmt);
    let mut Index: *MachineOperand = MI.getOperand(1 + AddrIndexReg);
    let mut Disp: *MachineOperand = MI.getOperand(1 + AddrDisp);
    let mut Segment: *MachineOperand = MI.getOperand(1 + AddrSegmentReg);
    if Segment.getReg().isValid() || !Disp.isImm() || Scale.getImm() > 1 || MBB.computeRegisterLiveness(self.TRI, EFLAGS, const_iterator { I, null }, 10) != LQR_Dead {
        return false;
    }
    let mut DestReg: Register = MI.getOperand(0).getReg();
    let mut BaseReg: Register = Base.getReg();
    let mut IndexReg: Register = Index.getReg();
    if UseLEAForSP && (DestReg == ESP || DestReg == RSP) {
        return false;
    }
    if MI.getOpcode() == LEA64_32r {
        if BaseReg.operator unsigned int() {
            BaseReg = self.TRI.getSubReg(BaseReg.operator MCRegister(), sub_32bit);
        }
        if IndexReg.operator unsigned int() {
            IndexReg = self.TRI.getSubReg(IndexReg.operator MCRegister(), sub_32bit);
        }
    }
    let mut NewMI: *mut MachineInstr = null;
    if BaseReg.isValid() && IndexReg.isValid() && Disp.getImm() == 0 && (DestReg == BaseReg || DestReg == IndexReg) {
        let mut NewOpcode: u32 = getADDrrFromLEA(MI.getOpcode());
        if DestReg != BaseReg {
            swap(BaseReg, IndexReg);
        }
        if MI.getOpcode() == LEA64_32r {
            NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpcode), DestReg).addReg(BaseReg, RegState {}, 0).addReg(IndexReg, RegState {}, 0).addReg(Base.getReg(), Implicit, 0).addReg(Index.getReg(), Implicit, 0).operator llvm::MachineInstr *();
        } else {
            NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpcode), DestReg).addReg(BaseReg, RegState {}, 0).addReg(IndexReg, RegState {}, 0).operator llvm::MachineInstr *();
        }
    } else if DestReg == BaseReg && !IndexReg.operator unsigned int() {
        if OptIncDec && (Disp.getImm() == 1 || Disp.getImm() == -1) {
            let mut IsINC: bool = Disp.getImm() == 1;
            let mut NewOpcode: u32 = getINCDECFromLEA(MI.getOpcode(), IsINC);
            if MI.getOpcode() == LEA64_32r {
                NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpcode), DestReg).addReg(BaseReg, RegState {}, 0).addReg(Base.getReg(), Implicit, 0).operator llvm::MachineInstr *();
            } else {
                NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpcode), DestReg).addReg(BaseReg, RegState {}, 0).operator llvm::MachineInstr *();
            }
        } else {
            let mut NewOpcode: u32 = getADDriFromLEA(MI.getOpcode(), Disp);
            if MI.getOpcode() == LEA64_32r {
                NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpcode), DestReg).addReg(BaseReg, RegState {}, 0).addImm(Disp.getImm()).addReg(Base.getReg(), Implicit, 0).operator llvm::MachineInstr *();
            } else {
                NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpcode), DestReg).addReg(BaseReg, RegState {}, 0).addImm(Disp.getImm()).operator llvm::MachineInstr *();
            }
        }
    } else if BaseReg.isValid() && IndexReg.isValid() && Disp.getImm() == 0 {
        return self.optLEAALU(I, MBB);
    } else {
        return false;
    }
    MBB.getParent().substituteDebugValuesForInst(operator(I), *NewMI, 1);
    MBB.erase(I);
    I = NewMI;
    return true;
}

fn FixupLEAsImpl::processInstruction(self, I: *mut iterator, MBB: *mut MachineBasicBlock) {
    let mut MI: *mut MachineInstr = operator(I);
    let mut AddrOffset: i32 = getMemoryOperandIdx(MI.getDesc());
    if AddrOffset >= 0 {
        let mut p: *mut MachineOperand = MI.getOperand(AddrOffset + AddrBaseReg);
        if p.isReg() && p.getReg() != ESP {
            self.seekLEAFixup(p, I, MBB);
        }
        let mut q: *mut MachineOperand = MI.getOperand(AddrOffset + AddrIndexReg);
        if q.isReg() && q.getReg() != ESP {
            self.seekLEAFixup(q, I, MBB);
        }
    }
}

fn FixupLEAsImpl::seekLEAFixup(self, p: *mut MachineOperand, I: *mut iterator, MBB: *mut MachineBasicBlock) {
    let mut MBI: iterator = self.searchBackwards(p, I, MBB);
    if MBI != iterator {} {
        let mut NewMI: *mut MachineInstr = self.postRAConvertToLEA(MBB, MBI);
        if NewMI {
            operator(NumLEAs);
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                    dbgs() << "FixLEA: Candidate to replace:";
                    operator(MBI).dump();
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                    dbgs() << "FixLEA: Replaced by: ";
                    NewMI.dump();
                }
            }
                if !(false) { break; }
            }
            MBB.getParent().substituteDebugValuesForInst(operator(MBI), *NewMI, 1);
            MBB.erase(MBI);
            let mut J: iterator = NewMI as iterator;
            self.processInstruction(J, MBB);
        }
    }
}

fn FixupLEAsImpl::processInstructionForSlowLEA(self, I: *mut iterator, MBB: *mut MachineBasicBlock) {
    let mut MI: *mut MachineInstr = operator(I);
    let mut Opcode: u32 = MI.getOpcode();
    let mut Dst: *MachineOperand = MI.getOperand(0);
    let mut Base: *MachineOperand = MI.getOperand(1 + AddrBaseReg);
    let mut Scale: *MachineOperand = MI.getOperand(1 + AddrScaleAmt);
    let mut Index: *MachineOperand = MI.getOperand(1 + AddrIndexReg);
    let mut Offset: *MachineOperand = MI.getOperand(1 + AddrDisp);
    let mut Segment: *MachineOperand = MI.getOperand(1 + AddrSegmentReg);
    if Segment.getReg().isValid() || !Offset.isImm() || MBB.computeRegisterLiveness(self.TRI, EFLAGS, const_iterator { I, null }, 4) != LQR_Dead {
        return;
    }
    let mut DstR: Register = Dst.getReg();
    let mut SrcR1: Register = Base.getReg();
    let mut SrcR2: Register = Index.getReg();
    if (!SrcR1.operator unsigned int() || SrcR1 != DstR) && (!SrcR2.operator unsigned int() || SrcR2 != DstR) {
        return;
    }
    if Scale.getImm() > 1 {
        return;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
            dbgs() << "FixLEA: Candidate to replace:";
            operator(I).dump();
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
            dbgs() << "FixLEA: Replaced by: ";
        }
    }
        if !(false) { break; }
    }
    let mut NewMI: *mut MachineInstr = null;
    if SrcR1.operator unsigned int() && SrcR2.operator unsigned int() {
        let mut ADDrr: *MCInstrDesc = self.TII.get(getADDrrFromLEA(Opcode));
        let mut Src: *MachineOperand = if SrcR1 == DstR { Index } else { Base };
        NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, ADDrr, DstR).addReg(DstR, RegState {}, 0).add(Src).operator llvm::MachineInstr *();
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                NewMI.dump();
            }
        }
            if !(false) { break; }
        }
    }
    if Offset.getImm() != 0 {
        let mut ADDri: *MCInstrDesc = self.TII.get(getADDriFromLEA(Opcode, Offset));
        let mut SrcR: *MachineOperand = if SrcR1 == DstR { Base } else { Index };
        NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, ADDri, DstR).add(SrcR).addImm(Offset.getImm()).operator llvm::MachineInstr *();
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                NewMI.dump();
            }
        }
            if !(false) { break; }
        }
    }
    if NewMI {
        MBB.getParent().substituteDebugValuesForInst(operator(I), *NewMI, 1);
        MBB.erase(I);
        I = NewMI;
    }
}

fn FixupLEAsImpl::processInstrForSlow3OpLEA(self, I: *mut iterator, MBB: *mut MachineBasicBlock, OptIncDec: bool) {
    let mut MI: *mut MachineInstr = operator(I);
    let mut LEAOpcode: u32 = MI.getOpcode();
    let mut Dest: *MachineOperand = MI.getOperand(0);
    let mut Base: *MachineOperand = MI.getOperand(1 + AddrBaseReg);
    let mut Scale: *MachineOperand = MI.getOperand(1 + AddrScaleAmt);
    let mut Index: *MachineOperand = MI.getOperand(1 + AddrIndexReg);
    let mut Offset: *MachineOperand = MI.getOperand(1 + AddrDisp);
    let mut Segment: *MachineOperand = MI.getOperand(1 + AddrSegmentReg);
    if !(self.TII.isThreeOperandsLEA(MI) || hasInefficientLEABaseReg(Base, Index)) || MBB.computeRegisterLiveness(self.TRI, EFLAGS, const_iterator { I, null }, 4) != LQR_Dead || Segment.getReg().isValid() {
        return;
    }
    let mut DestReg: Register = Dest.getReg();
    let mut BaseReg: Register = Base.getReg();
    let mut IndexReg: Register = Index.getReg();
    if MI.getOpcode() == LEA64_32r {
        if BaseReg.operator unsigned int() {
            BaseReg = self.TRI.getSubReg(BaseReg.operator MCRegister(), sub_32bit);
        }
        if IndexReg.operator unsigned int() {
            IndexReg = self.TRI.getSubReg(IndexReg.operator MCRegister(), sub_32bit);
        }
    }
    let mut IsScale1: bool = Scale.getImm() == 1;
    let mut IsInefficientBase: bool = isInefficientLEAReg(BaseReg);
    let mut IsInefficientIndex: bool = isInefficientLEAReg(IndexReg);
    if IsInefficientBase && DestReg == BaseReg && !IsScale1 {
        return;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
            dbgs() << "FixLEA: Candidate to replace:";
            MI.dump();
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
            dbgs() << "FixLEA: Replaced by: ";
        }
    }
        if !(false) { break; }
    }
    let mut NewMI: *mut MachineInstr = null;
    let mut BaseOrIndexIsDst: bool = DestReg == BaseReg || DestReg == IndexReg;
    if IsScale1 && BaseReg == IndexReg && (mayHaveOffset(Offset) || (IsInefficientBase && !BaseOrIndexIsDst)) {
        NewMI = BuildMI(MBB, MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LEAOpcode)).add(Dest).addReg(0, RegState {}, 0).addImm(2).add(Index).add(Offset).add(Segment).operator llvm::MachineInstr *();
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                NewMI.dump();
            }
        }
            if !(false) { break; }
        }
        MBB.getParent().substituteDebugValuesForInst(operator(I), *NewMI, 1);
        MBB.erase(I);
        I = NewMI;
        return;
    } else if IsScale1 && BaseOrIndexIsDst {
        let mut NewOpc: u32 = getADDrrFromLEA(MI.getOpcode());
        if DestReg != BaseReg {
            swap(BaseReg, IndexReg);
        }
        if MI.getOpcode() == LEA64_32r {
            NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc), DestReg).addReg(BaseReg, RegState {}, 0).addReg(IndexReg, RegState {}, 0).addReg(Base.getReg(), Implicit, 0).addReg(Index.getReg(), Implicit, 0).operator llvm::MachineInstr *();
        } else {
            NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc), DestReg).addReg(BaseReg, RegState {}, 0).addReg(IndexReg, RegState {}, 0).operator llvm::MachineInstr *();
        }
    } else if !IsInefficientBase || (!IsInefficientIndex && IsScale1) {
        NewMI = BuildMI(MBB, MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LEAOpcode)).add(Dest).add(if IsInefficientBase { Index } else { Base }).add(Scale).add(if IsInefficientBase { Base } else { Index }).addImm(0).add(Segment).operator llvm::MachineInstr *();
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                NewMI.dump();
            }
        }
            if !(false) { break; }
        }
    }
    if NewMI {
        if mayHaveOffset(Offset) {
            if OptIncDec && Offset.isImm() && (Offset.getImm() == 1 || Offset.getImm() == -1) {
                let mut NewOpc: u32 = getINCDECFromLEA(MI.getOpcode(), Offset.getImm() == 1);
                NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc), DestReg).addReg(DestReg, RegState {}, 0).operator llvm::MachineInstr *();
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                        NewMI.dump();
                    }
                }
                    if !(false) { break; }
                }
            } else if Offset.isImm() && Offset.getImm() == 128 {
                let mut NewOpc: u32 = getSUBriFromLEA(MI.getOpcode());
                NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc), DestReg).addReg(DestReg, RegState {}, 0).addImm(-128).operator llvm::MachineInstr *();
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                        NewMI.dump();
                    }
                }
                    if !(false) { break; }
                }
            } else {
                let mut NewOpc: u32 = getADDriFromLEA(MI.getOpcode(), Offset);
                NewMI = BuildMI(MBB, I, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc), DestReg).addReg(DestReg, RegState {}, 0).add(Offset).operator llvm::MachineInstr *();
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                        NewMI.dump();
                    }
                }
                    if !(false) { break; }
                }
            }
        }
        MBB.getParent().substituteDebugValuesForInst(operator(I), *NewMI, 1);
        MBB.erase(I);
        I = NewMI;
        return;
    }
    assert!(DestReg != BaseReg, "DestReg == BaseReg should be handled already!");
    assert!(IsInefficientBase, "efficient base should be handled already!");
    if LEAOpcode == LEA64_32r {
        return;
    }
    if IsScale1 && !mayHaveOffset(Offset) {
        let mut BIK: bool = Base.isKill() && BaseReg != IndexReg;
        self.TII.copyPhysReg(MBB, MI, MI.getDebugLoc(), DestReg, BaseReg, BIK, false, false);
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                MI.getPrevNode().dump();
            }
        }
            if !(false) { break; }
        }
        let mut NewOpc: u32 = getADDrrFromLEA(MI.getOpcode());
        NewMI = BuildMI(MBB, MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc), DestReg).addReg(DestReg, RegState {}, 0).add(Index).operator llvm::MachineInstr *();
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
                NewMI.dump();
            }
        }
            if !(false) { break; }
        }
        MBB.getParent().substituteDebugValuesForInst(operator(I), *NewMI, 1);
        MBB.erase(I);
        I = NewMI;
        return;
    }
    NewMI = BuildMI(MBB, MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LEAOpcode)).add(Dest).addReg(0, RegState {}, 0).add(Scale).add(Index).add(Offset).add(Segment).operator llvm::MachineInstr *();
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
            NewMI.dump();
        }
    }
        if !(false) { break; }
    }
    let mut NewOpc: u32 = getADDrrFromLEA(MI.getOpcode());
    NewMI = BuildMI(MBB, MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc), DestReg).addReg(DestReg, RegState {}, 0).add(Base).operator llvm::MachineInstr *();
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-leas", 1) {
            NewMI.dump();
        }
    }
        if !(false) { break; }
    }
    MBB.getParent().substituteDebugValuesForInst(operator(I), *NewMI, 1);
    MBB.erase(I);
    I = NewMI;
}

fn FixupLEAsLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut PSI: *mut ProfileSummaryInfo = &mut self.getAnalysis().getPSI();
    let mut MBFI: *mut MachineBlockFrequencyInfo = if (PSI && PSI.hasProfileSummary()) { &mut self.getAnalysis().getBFI() } else { null };
    let mut PassImpl: FixupLEAsImpl = FixupLEAsImpl { PSI, MBFI };
    return PassImpl.runOnMachineFunction(MF);
}

fn X86FixupLEAsPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut PSI: *mut ProfileSummaryInfo = MFAM.getResult(MF).getCachedResult(*MF.getFunction().getParent());
    if !PSI {
        report_fatal_error("x86-fixup-leas requires ProfileSummaryAnalysis", false);
    }
    let mut MBFI: *mut MachineBlockFrequencyInfo = &mut MFAM.getResult(MF);
    let mut PassImpl: FixupLEAsImpl = FixupLEAsImpl { PSI, MBFI };
    let mut Changed: bool = PassImpl.runOnMachineFunction(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}
