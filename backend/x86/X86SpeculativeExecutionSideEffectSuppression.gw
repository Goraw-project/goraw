static mut NumLFENCEsInserted: Statistic = Statistic { "x86-seses", "NumLFENCEsInserted", "Number of lfence instructions inserted" };

static mut EnableSpeculativeExecutionSideEffectSuppression: opt<bool> = opt<bool> { "x86-seses-enable-without-lvi-cfi", "Force enable speculative execution side effect suppression. (Note: User must pass -mlvi-cfi in order to mitigate indirect branches and returns.)", init(false), Hidden };

static mut OneLFENCEPerBasicBlock: opt<bool> = opt<bool> { "x86-seses-one-lfence-per-bb", "Omit all lfences other than the first to be placed in a basic block.", init(false), Hidden };

static mut OnlyLFENCENonConst: opt<bool> = opt<bool> { "x86-seses-only-lfence-non-const", "Only lfence before groups of terminators where at least one branch instruction has an input to the addressing mode that is a register other than %rip.", init(false), Hidden };

static mut OmitBranchLFENCEs: opt<bool> = opt<bool> { "x86-seses-omit-branch-lfences", "Omit all lfences before branch instructions.", init(false), Hidden };

const X86SESESPassName: str = "X86 Speculative Execution Side Effect Suppression";

struct X86SpeculativeExecutionSideEffectSuppressionLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::getPassName(self: *X86SpeculativeExecutionSideEffectSuppressionLegacy) -> str {
    return X86SESESPassName;
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::getPassKind(self: *X86SpeculativeExecutionSideEffectSuppressionLegacy) -> PassKind {
    return self.Kind;
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::getPassID(self: *X86SpeculativeExecutionSideEffectSuppressionLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::getResolver(self: *X86SpeculativeExecutionSideEffectSuppressionLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::getRequiredProperties(self: *X86SpeculativeExecutionSideEffectSuppressionLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::getSetProperties(self: *X86SpeculativeExecutionSideEffectSuppressionLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::getClearedProperties(self: *X86SpeculativeExecutionSideEffectSuppressionLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn hasConstantAddressingMode(MI: *MachineInstr) -> bool {
    for MO in MI.uses() {
        if MO.isReg() && RIP != MO.getReg().operator unsigned int() {
            return false;
        }
    }
    return true;
}

fn runX86SpeculativeExecutionSideEffectSuppression(MF: *mut MachineFunction) -> bool {
    let mut OptLevel: *CodeGenOptLevel = MF.getTarget().getOptLevel();
    let mut Subtarget: *X86Subtarget = MF.getSubtarget();
    if !EnableSpeculativeExecutionSideEffectSuppression && !(Subtarget.useLVILoadHardening() && OptLevel == None) && !Subtarget.useSpeculativeExecutionSideEffectSuppression() {
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-seses", 1) {
            dbgs() << "********** " << X86SESESPassName << " : " << MF.getName() << " **********\n";
        }
    }
        if !(false) { break; }
    }
    let mut Modified: bool = false;
    let mut TII: *X86InstrInfo = Subtarget.getInstrInfo();
    for MBB in MF {
        let mut FirstTerminator: *mut MachineInstr = null;
        let mut PrevInstIsLFENCE: bool = false;
        for MI in MBB {
            if MI.getOpcode() == LFENCE {
                PrevInstIsLFENCE = true;
                continue;
            }
            if MI.mayLoadOrStore(AnyInBundle) && !MI.isTerminator(AnyInBundle) {
                if !PrevInstIsLFENCE {
                    BuildMI(MBB, MI, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LFENCE));
                    operator(NumLFENCEsInserted, 0);
                    Modified = true;
                }
                if OneLFENCEPerBasicBlock {
                    break;
                }
            }
            if MI.isTerminator(AnyInBundle) && FirstTerminator == null {
                FirstTerminator = &mut MI;
            }
            if !MI.isBranch(AnyInBundle) || OmitBranchLFENCEs {
                PrevInstIsLFENCE = false;
                continue;
            }
            if OnlyLFENCENonConst && hasConstantAddressingMode(MI) {
                PrevInstIsLFENCE = false;
                continue;
            }
            if !PrevInstIsLFENCE {
                assert!(FirstTerminator, "Unknown terminator instruction");
                BuildMI(MBB, FirstTerminator, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LFENCE));
                operator(NumLFENCEsInserted, 0);
                Modified = true;
            }
            break;
        }
    }
    return Modified;
}

fn X86SpeculativeExecutionSideEffectSuppressionLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return runX86SpeculativeExecutionSideEffectSuppression(MF);
}

fn X86SpeculativeExecutionSideEffectSuppressionPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if runX86SpeculativeExecutionSideEffectSuppression(MF) { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}

fn createX86SpeculativeExecutionSideEffectSuppressionLegacyPass() -> *mut FunctionPass {
    return X86SpeculativeExecutionSideEffectSuppressionLegacy {};
}
