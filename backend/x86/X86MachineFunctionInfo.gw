fn X86MachineFunctionInfo::mappingImpl(self, YamlIO: *mut IO) {
    mapping(YamlIO, *self);
}

fn X86MachineFunctionInfo::clone(self: *X86MachineFunctionInfo, Allocator: *mut BumpPtrAllocator, DestMF: *mut MachineFunction, Src2DstMBB: i32) -> *mut MachineFunctionInfo {
    return DestMF;
}

fn X86MachineFunctionInfo::initializeBaseYamlFields(self, YamlMFI: *X86MachineFunctionInfo) {
    self.AMXProgModel = YamlMFI.AMXProgModel;
}

fn X86MachineFunctionInfo::anchor(self) {}

fn X86MachineFunctionInfo::setRestoreBasePointer(self, MF: *MachineFunction) {
    if !self.RestoreBasePointerOffset {
        let mut RegInfo: *X86RegisterInfo = null;
        let mut SlotSize: u32 = RegInfo.getSlotSize();
        for let mut CSR: *MCPhysReg = MF.getRegInfo().getCalleeSavedRegs(); Reg; CSR += 1 {
            if  {
                self.RestoreBasePointerOffset -= SlotSize;
            }
        }
    }
}
