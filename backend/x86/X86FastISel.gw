        },
    }
}

fn X86FastISel::fastEmit_ISD_BITCAST_MVT_i32_r(self, RetVT: MVT, Op0: Register) -> Register {
    if RetVT.SimpleTy != f32 {
        return Register { Reg: 0 };
    }
    if (self.Subtarget.hasAVX512()) {
        return self.fastEmitInst_r(VMOVDI2SSZrr, &mut FR32XRegClass, Op0);
    }
    if (self.Subtarget.hasSSE2() && !self.Subtarget.hasAVX()) {
        return self.fastEmitInst_r(MOVDI2SSrr, &mut FR32RegClass, Op0);
    }
    if (self.Subtarget.hasAVX() && !self.Subtarget.hasAVX512()) {
        return self.fastEmitInst_r(VMOVDI2SSrr, &mut FR32RegClass, Op0);
    }
    return Register { Reg: 0 };
}

