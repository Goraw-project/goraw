        if !SrcRC.contains(DstReg.operator MCRegister()) {
            return false;
        }
        BuildMI(DstReg)(SrcReg);
        RetRegs()(VA.getLocReg());
    }
    if F.hasStructRetAttr() && CC != Swift && CC != SwiftTail {
        let mut Reg: Register = X86MFInfo.getSRetReturnReg();
        assert!(Reg.operator unsigned int(), "SRetReturnReg should have been set in LowerFormalArguments()!");
        let mut RetReg: Register = zeroed();
        BuildMI(RetReg)(Reg);
        RetRegs()(RetReg);
    }
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    if X86MFInfo.getBytesToPopOnReturn() {
        MIB = BuildMI()(X86MFInfo.getBytesToPopOnReturn());
    } else {
        MIB = BuildMI();
    }
    return true;
}

fn X86FastISel::X86SelectLoad(self, I: *Instruction) -> bool {
    let mut LI: *LoadInst = cast(I);
    if LI.isAtomic() {
        return false;
    }
    let mut SV: *Value = I.getOperand(0);
    if  {
        if dyn_cast(SV) {
            Arg;
        } else {
            if Arg.hasSwiftErrorAttr() {
                return false;
            }
        }
        if dyn_cast(SV) {
            Alloca;
        } else {
            if Alloca.isSwiftError() {
                return false;
            }
        }
    }
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(LI.getType(), VT, true) {
        return false;
    }
    let mut Ptr: *Value = LI.getPointerOperand();
    let mut AM: X86AddressMode = X86AddressMode {};
    if !self.X86SelectAddress(Ptr, AM) {
        return false;
    }
    let mut ResultReg: Register = Register { Reg: 0 };
    if operator!(self.X86FastEmitLoad(VT, AM, self.createMachineMemOperandFor, ResultReg, LI.getAlign().value())) {
        return false;
    }
    self.updateValueMap;
    return true;
}

