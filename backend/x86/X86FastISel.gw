fn X86FastISel::fastEmit_ISD_ADD_MVT_i8_rr(self, RetVT: MVT, Op0: Register, Op1: Register) -> Register {
    if RetVT.SimpleTy != i8 {
        return Register { Reg: 0 };
    }
    if (self.Subtarget.hasNDD()) {
        return self.fastEmitInst_rr(ADD8rr_ND, &mut GR8RegClass, Op0, Op1);
    }
    if (!self.Subtarget.hasNDD()) {
        return self.fastEmitInst_rr(ADD8rr, &mut GR8RegClass, Op0, Op1);
    }
    return Register { Reg: 0 };
}

fn X86FastISel::fastEmit_ISD_ADD_MVT_i16_rr(self, RetVT: MVT, Op0: Register, Op1: Register) -> Register {
