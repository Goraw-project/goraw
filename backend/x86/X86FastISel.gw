    } else if I.getType().isIntegerTy(64) {
        match I.getOpcode() {
            _ => {
                llvm_unreachable_internal("Unexpected shift opcode", "llvm\\lib\\Target\\X86\\X86FastISel.cpp", 1946);
            },
            LShr => {
                
            },
            AShr => {
                
            },
            Shl => {
                
            },
        }
    } else {
        return false;
    }
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), VT, false) {
        return false;
    }
    let mut Op0Reg: Register = self.getRegForValue;
    if !Op0Reg.operator unsigned int() {
        return false;
    }
    let mut Op1Reg: Register = self.getRegForValue;
    if !Op1Reg.operator unsigned int() {
        return false;
    }
    BuildMI(CReg)(Op1Reg);
    if  {
        BuildMI()(CReg, Kill);
    }
    let mut ResultReg: Register = self.createResultReg;
    BuildMI(ResultReg)(Op0Reg)(2);
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86SelectMul(self, I: *Instruction) -> bool {
