    return ResultReg;
}

fn X86FastISel::X86FastEmitLiveEFLAGS_ri(self, Opc: u32, RC: *TargetRegisterClass, Op0: Register, Imm: u64) -> Register {
    let mut II: *MCInstrDesc = null;
    assert!(II.getNumDefs() >= 1, "instruction must define the result");
    let mut ResultReg: Register = self.createResultReg;
    Op0 = self.constrainOperandRegClass;
    BuildMI(II, ResultReg)(Op0)(Imm);
