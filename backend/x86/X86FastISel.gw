struct X86FastISel {
    LocalValueMap: i32,
    FuncInfo: *mut FunctionLoweringInfo,
    MF: *mut MachineFunction,
    MRI: *mut MachineRegisterInfo,
    MFI: *mut MachineFrameInfo,
    MCP: *mut MachineConstantPool,
    MIMD: MIMetadata,
    TM: *TargetMachine,
    DL: *DataLayout,
    TII: *TargetInstrInfo,
    TLI: *TargetLowering,
    TRI: *TargetRegisterInfo,
    LibInfo: *TargetLibraryInfo,
    LibcallLowering: *LibcallLoweringInfo,
    SkipTargetIndependentISel: bool,
    LastLocalValue: *mut MachineInstr,
    EmitStartPt: *mut MachineInstr,
    SavedInsertPt: iterator,
    Subtarget: *X86Subtarget,
}

fn X86FastISel::X86FastISel(self, funcInfo: *mut FunctionLoweringInfo, libInfo: *TargetLibraryInfo, libcallLowering: *LibcallLoweringInfo) {
    self.Subtarget = operator&(funcInfo.MF);
}

fn X86FastISel::getInstrInfo(self: *X86FastISel) -> *X86InstrInfo {
    return self.Subtarget.getInstrInfo();
}

fn X86FastISel::getTargetMachine(self: *X86FastISel) -> *X86TargetMachine {}

fn X86FastISel::isScalarFPTypeInSSEReg(self: *X86FastISel, VT: EVT) -> bool {
    return (VT == EVT { f64 } && self.Subtarget.hasSSE2()) || (VT == EVT { f32 } && self.Subtarget.hasSSE1()) || VT == EVT { f16 };
}

fn X86FastISel::getLastLocalValue(self) -> *mut MachineInstr {
    return self.LastLocalValue;
}

fn X86FastISel::setLastLocalValue(self, I: *mut MachineInstr) {
    self.EmitStartPt = I;
    self.LastLocalValue = I;
}

fn X86FastISel::getCurDebugLoc(self: *X86FastISel) -> DebugLoc {
    return self.MIMD.getDL();
}

fn X86FastISel::shouldOptForSize(self: *X86FastISel, MF: *MachineFunction) -> bool {
    return MF.getFunction().hasOptSize();
}

fn getX86SSEConditionCode(Predicate: Predicate) -> pair<unsigned int, bool> {
    let mut CC: u32 = 0;
    let mut NeedSwap: bool = false;
    match Predicate {
        _ => {
            llvm_unreachable_internal("Unexpected predicate", "llvm\\lib\\Target\\X86\\X86FastISel.cpp", 227);
        },
        FCMP_OEQ => {
            CC = 0;
        },
        FCMP_OGT => {
            NeedSwap = true;
        },
        FCMP_OLT => {
            CC = 1;
        },
        FCMP_OGE => {
            NeedSwap = true;
        },
        FCMP_OLE => {
            CC = 2;
        },
        FCMP_UNO => {
            CC = 3;
        },
        FCMP_UNE => {
            CC = 4;
        },
        FCMP_ULE => {
            NeedSwap = true;
        },
        FCMP_UGE => {
            CC = 5;
        },
        FCMP_ULT => {
            NeedSwap = true;
        },
        FCMP_UGT => {
            CC = 6;
        },
        FCMP_ORD => {
            CC = 7;
        },
        FCMP_UEQ => {
            CC = 8;
        },
        FCMP_ONE => {
            CC = 12;
        },
    }
    return make_pair(CC, NeedSwap);
}

fn X86FastISel::addFullAddress(self, MIB: *MachineInstrBuilder, AM: *mut X86AddressMode) -> *MachineInstrBuilder {
    AM.IndexReg = self.constrainOperandRegClass;
    return addFullAddress(MIB, AM);
}

fn X86FastISel::foldX86XALUIntrinsic(self, CC: *mut CondCode, I: *Instruction, Cond: *Value) -> bool {
    if !isa(Cond) {
        return false;
    }
    let mut EV: *auto = cast(Cond);
    if operator!(isa()) {
        return false;
    }
    let mut II: *auto = cast();
    let mut RetVT: MVT = MVT {};
    let mut Callee: *Function = ();
    let mut RetTy: *mut Type = cast(Callee.getReturnType())(0);
    if !self.isTypeLegal(RetTy, RetVT, false) {
        return false;
    }
    if RetVT != i32 && RetVT != i64 {
        return false;
    }
    let mut TmpCC: CondCode = zeroed();
    match II()() {
        _ => {
            return false;
        },
        sadd_with_overflow => {
            ssub_with_overflow;
        },
        smul_with_overflow => {
            umul_with_overflow;
        },
    }
    if II()() != I.getParent() {
        return false;
    }
    let mut Start: const_iterator = const_iterator { I };
    let mut End: const_iterator = II();
    for let mut Itr: auto = prev(Start); Itr() != End;  -= 1 {
        if operator!(isa()) {
            return false;
        }
        let mut EVI: *auto = cast();
        if EVI()() !=  {
            return false;
        }
    }
    let mut HasPhis: Closure_1 = Closure_1 {};
    if I.isTerminator() && any_of(successors(I), HasPhis) {
        return false;
    }
    if any_of(I.operands(), Closure_2 {}) {
        return false;
    }
    CC = TmpCC;
    return true;
}

fn X86FastISel::isTypeLegal(self, Ty: *mut Type, VT: *mut MVT, AllowI1: bool) -> bool {
    let mut evt: EVT = zeroed();
    if evt == EVT { Other } || !evt.isSimple() {
        return false;
    }
    VT = evt.getSimpleVT();
    if VT == f64 && !self.Subtarget.hasSSE2() {
        return false;
    }
    if VT == f32 && !self.Subtarget.hasSSE1() {
        return false;
    }
    if VT == f80 {
        return false;
    }
}

