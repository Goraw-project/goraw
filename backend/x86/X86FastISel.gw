    let mut HasSSE2: bool = Subtarget.hasSSE2();
    match VT.getSimpleVT().SimpleTy {
        _ => {
            return 0;
        },
        i8 => {
            
        },
        i16 => {
            
        },
        i32 => {
            
        },
        i64 => {
            
        },
        f32 => {
            
        },
        f64 => {
            
        },
    }
}

