    if (self.Subtarget.hasAVX512()) {
        return self.fastEmitInst_r(VMOV64toSDZrr, &mut FR64XRegClass, Op0);
    }
    if (self.Subtarget.hasSSE2() && !self.Subtarget.hasAVX()) {
        return self.fastEmitInst_r(MOV64toSDrr, &mut FR64RegClass, Op0);
    }
    if (self.Subtarget.hasAVX() && !self.Subtarget.hasAVX512()) {
        return self.fastEmitInst_r(VMOV64toSDrr, &mut FR64RegClass, Op0);
    }
    return Register { Reg: 0 };
}

