    if RetVT.SimpleTy != i32 {
        return Register { Reg: 0 };
    }
    if (self.Subtarget.hasMOVBE()) && (self.Subtarget.hasNDD()) && (self.Subtarget.is64Bit()) {
        return self.fastEmitInst_r(MOVBE32rr, &mut GR32RegClass, Op0);
    }
    if (!self.Subtarget.hasNDD() || !self.Subtarget.hasMOVBE()) {
        return self.fastEmitInst_r(BSWAP32r, &mut GR32RegClass, Op0);
    }
    return Register { Reg: 0 };
}

