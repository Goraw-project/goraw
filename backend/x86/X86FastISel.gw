struct X86FastISel {
    LocalValueMap: DenseMap<const Value *, Register>,
    FuncInfo: *mut FunctionLoweringInfo,
    MF: *mut MachineFunction,
    MRI: *mut MachineRegisterInfo,
    MFI: *mut MachineFrameInfo,
    MCP: *mut MachineConstantPool,
    MIMD: MIMetadata,
    TM: *TargetMachine,
    DL: *DataLayout,
    TII: *TargetInstrInfo,
    TLI: *TargetLowering,
    TRI: *TargetRegisterInfo,
    LibInfo: *TargetLibraryInfo,
    LibcallLowering: *LibcallLoweringInfo,
    SkipTargetIndependentISel: bool,
    LastLocalValue: *mut MachineInstr,
    EmitStartPt: *mut MachineInstr,
    SavedInsertPt: iterator,
    Subtarget: *X86Subtarget,
}

fn X86FastISel::X86FastISel(self, funcInfo: *mut FunctionLoweringInfo, libInfo: *TargetLibraryInfo, libcallLowering: *LibcallLoweringInfo) {
    self.Subtarget = &mut funcInfo.MF.getSubtarget();
}

fn X86FastISel::Predicate_AndMask64(self, Imm: i64) -> bool {
    return isMask_64(Imm) && !isUInt(Imm);
}

fn X86FastISel::Predicate_BTRMask64(self, Imm: i64) -> bool {
    return !isUInt(Imm) && !isInt(Imm) && isPowerOf2_64(~Imm);
}

fn X86FastISel::Predicate_BTCBTSMask64(self, Imm: i64) -> bool {
    return !isInt(Imm) && isPowerOf2_64(Imm);
}

fn X86FastISel::Predicate_i64immSExt32(self, Imm: i64) -> bool {
    return isInt(Imm);
}

fn X86FastISel::fastEmit_ISD_ABS_MVT_v16i8_r(self, RetVT: MVT, Op0: Register) -> Register {
    if RetVT.SimpleTy != v16i8 {
        return Register { Reg: 0 };
    }
    if (self.Subtarget.hasBWI()) && (self.Subtarget.hasVLX()) {
        return self.fastEmitInst_r(VPABSBZ128rr, &mut VR128XRegClass, Op0);
    }
    if (self.Subtarget.hasSSSE3() && !self.Subtarget.hasAVX()) {
        return self.fastEmitInst_r(PABSBrr, &mut VR128RegClass, Op0);
    }
    if (self.Subtarget.hasAVX()) && (!self.Subtarget.hasVLX() || !self.Subtarget.hasBWI()) {
        return self.fastEmitInst_r(VPABSBrr, &mut VR128RegClass, Op0);
    }
    return Register { Reg: 0 };
}

fn X86FastISel::fastEmit_ISD_ABS_MVT_v32i8_r(self, RetVT: MVT, Op0: Register) -> Register {
    if RetVT.SimpleTy != v32i8 {
        return Register { Reg: 0 };
    }
    if (self.Subtarget.hasBWI()) && (self.Subtarget.hasVLX()) {
        return self.fastEmitInst_r(VPABSBZ256rr, &mut VR256XRegClass, Op0);
    }
    if (self.Subtarget.hasAVX2()) && (!self.Subtarget.hasVLX() || !self.Subtarget.hasBWI()) {
        return self.fastEmitInst_r(VPABSBYrr, &mut VR256RegClass, Op0);
    }
    return Register { Reg: 0 };
}

