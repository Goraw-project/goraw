}

fn X86FastISel::X86FastEmitMul(self, Opc: u32, VT: MVT, AccReg: MCRegister, LHSReg: Register, RHSReg: Register, LiveEFLAGS: bool) -> Register {
    BuildMI(AccReg)(LHSReg);
    let mut II: *MCInstrDesc = null;
    let mut ResultReg: Register = self.createResultReg;
    RHSReg = self.constrainOperandRegClass;
    let mut MIB: MachineInstrBuilder = BuildMI(II)(RHSReg);
    assert!(operator(MIB).getOperand(1).getReg() == AccReg, "unexpected operand order");
    if VT == i8 {
        if !LiveEFLAGS {
            MIB.setOperandDead(2);
        }
    } else {
        MIB.setOperandDead(2);
        if !LiveEFLAGS {
            MIB.setOperandDead(3);
        }
    }
    BuildMI(ResultReg)(AccReg);
    return ResultReg;
}

