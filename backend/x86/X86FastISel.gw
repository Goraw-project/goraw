fn X86FastISel::X86FastEmitCompare(self, Op0: *Value, Op1: *Value, VT: EVT, CurMIMD: *DebugLoc) -> bool {
    let mut Op0Reg: Register = self.getRegForValue;
    if !Op0Reg.operator unsigned int() {
        return false;
    }
    if isa(Op1) {
        Op1 = getNullValue();
    }
    if dyn_cast(Op1) {
        Op1C;
    } else {
        if X86ChooseCmpImmediateOpcode(VT, Op1C) {
            CompareImmOpc;
        } else {
            BuildMI(CurMIMD)(Op0Reg)(Op1C.getSExtValue());
            return true;
        }
    }
    let mut CompareOpc: u32 = X86ChooseCmpOpcode(VT, self.Subtarget);
    if CompareOpc == 0 {
        return false;
    }
    let mut Op1Reg: Register = self.getRegForValue;
    if !Op1Reg.operator unsigned int() {
        return false;
    }
    BuildMI(CurMIMD)(Op0Reg)(Op1Reg);
    return true;
}

fn X86FastISel::X86SelectCmp(self, I: *Instruction) -> bool {
    let mut CI: *CmpInst = cast(I);
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(I.getOperand(0).getType(), VT, false) {
        return false;
    }
    if VT.isVector() {
        return false;
    }
    let mut Predicate: Predicate = self.optimizeCmpPredicate;
    let mut ResultReg: Register = Register { Reg: 0 };
    match Predicate {
        _ => {
            break;
        },
        FCMP_FALSE => {
            ResultReg = self.emitMOV32r0();
            ResultReg = self.fastEmitInst_extractsubreg;
            if !ResultReg.operator unsigned int() {
                return false;
            }
            break;
        },
        FCMP_TRUE => {
            ResultReg = self.createResultReg;
            BuildMI(ResultReg)(1);
            break;
        },
    }
    if ResultReg.operator unsigned int() {
        self.updateValueMap;
        return true;
    }
    let mut LHS: *Value = CI.getOperand(0);
    let mut RHS: *Value = CI.getOperand(1);
    if Predicate == FCMP_ORD || Predicate == FCMP_UNO {
        let mut RHSC: *auto = dyn_cast(RHS);
        if RHSC() && () {
            RHS = LHS;
        }
    }
    let mut SETFOpcTable: [2]u16 = zeroed();
    let mut SETFOpc: *u16 = null;
    match Predicate {
        _ => {
            break;
        },
        FCMP_OEQ => {
            SETFOpc = &mut SETFOpcTable[0][0];
        },
        FCMP_UNE => {
            SETFOpc = &mut SETFOpcTable[1][0];
        },
    }
    ResultReg = self.createResultReg;
    if SETFOpc {
        if !self.X86FastEmitCompare(LHS, RHS, EVT { VT }, I.getDebugLoc()) {
            return false;
        }
        let mut FlagReg1: Register = self.createResultReg;
        let mut FlagReg2: Register = self.createResultReg;
        BuildMI(FlagReg1)(SETFOpc[0]);
        BuildMI(FlagReg2)(SETFOpc[1]);
        BuildMI(ResultReg)(FlagReg1)(FlagReg2)(3);
        self.updateValueMap;
        return true;
    }
    let mut CC: CondCode = zeroed();
    let mut SwapArgs: bool = false;
    tie(CC, SwapArgs) = getX86ConditionCode(Predicate);
    assert!(CC <= LAST_VALID_COND, "Unexpected condition code.");
    if SwapArgs {
        swap(LHS, RHS);
    }
    if !self.X86FastEmitCompare(LHS, RHS, EVT { VT }, I.getDebugLoc()) {
        return false;
    }
    BuildMI(ResultReg)(CC);
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86SelectZExt(self, I: *Instruction) -> bool {
    let mut DstVT: EVT = zeroed();
    if  {
        return false;
    }
    let mut ResultReg: Register = self.getRegForValue;
    if !ResultReg.operator unsigned int() {
        return false;
    }
    let mut SrcVT: MVT = zeroed();
    if SrcVT == i1 {
        ResultReg = self.fastEmitZExtFromI1;
        SrcVT = MVT { SimpleTy: i8 };
        if !ResultReg.operator unsigned int() {
            return false;
        }
    }
    if DstVT == EVT { i64 } {
        let mut MovInst: u32 = 0;
        match SrcVT.SimpleTy {
            i8 => {
                
            },
            i16 => {
                
            },
            i32 => {
                
            },
            _ => {
                llvm_unreachable_internal("Unexpected zext to i64 source type", "llvm\\lib\\Target\\X86\\X86FastISel.cpp", 1678);
            },
        }
        let mut Result32: Register = self.createResultReg;
        BuildMI(Result32)(ResultReg);
        ResultReg = self.createResultReg;
        BuildMI(ResultReg)(Result32);
    } else if DstVT == EVT { i16 } {
        let mut Result32: Register = self.createResultReg;
        BuildMI(Result32)(ResultReg);
        ResultReg = self.fastEmitInst_extractsubreg;
    } else if DstVT != EVT { i8 } {
        ResultReg = self.fastEmit_r;
        if !ResultReg.operator unsigned int() {
            return false;
        }
    }
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86SelectSExt(self, I: *Instruction) -> bool {
    let mut DstVT: EVT = zeroed();
    if  {
        return false;
    }
    let mut ResultReg: Register = self.getRegForValue;
    if !ResultReg.operator unsigned int() {
        return false;
    }
    let mut SrcVT: MVT = zeroed();
    if SrcVT == i1 {
        let mut ZExtReg: Register = self.fastEmitZExtFromI1;
        if !ZExtReg.operator unsigned int() {
            return false;
        }
        ResultReg = self.createResultReg;
        BuildMI(ResultReg)(ZExtReg)(2);
        SrcVT = MVT { SimpleTy: i8 };
    }
    if DstVT == EVT { i16 } {
        let mut Result32: Register = self.createResultReg;
        BuildMI(Result32)(ResultReg);
        ResultReg = self.fastEmitInst_extractsubreg;
    } else if DstVT != EVT { i8 } {
        ResultReg = self.fastEmit_r;
        if !ResultReg.operator unsigned int() {
            return false;
        }
    }
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86SelectBranch(self, I: *Instruction) -> bool {
    let mut BI: *CondBrInst = cast(I);
    let mut TrueMBB: *mut MachineBasicBlock = null;
    let mut FalseMBB: *mut MachineBasicBlock = null;
    let mut CC: CondCode = zeroed();
    if dyn_cast(BI.getCondition()) {
        CI;
    } else {
        if CI.hasOneUse() && CI.getParent() == I.getParent() {
            let mut VT: EVT = zeroed();
            let mut Predicate: Predicate = self.optimizeCmpPredicate;
            match Predicate {
                _ => {
                    break;
                },
                FCMP_FALSE => {
                    self.fastEmitBranch;
                },
                FCMP_TRUE => {
                    self.fastEmitBranch;
                },
            }
            let mut CmpLHS: *Value = CI.getOperand(0);
            let mut CmpRHS: *Value = CI.getOperand(1);
            if Predicate == FCMP_ORD || Predicate == FCMP_UNO {
                let mut CmpRHSC: *auto = dyn_cast(CmpRHS);
                if CmpRHSC() && () {
                    CmpRHS = CmpLHS;
                }
            }
            if  {
                swap(TrueMBB, FalseMBB);
                Predicate = getInversePredicate(Predicate);
            }
            let mut NeedExtraBranch: bool = false;
            match Predicate {
                _ => {
                    break;
                },
                FCMP_OEQ => {
                    swap(TrueMBB, FalseMBB);
                },
                FCMP_UNE => {
                    NeedExtraBranch = true;
                },
            }
            let mut SwapArgs: bool = false;
            tie(CC, SwapArgs) = getX86ConditionCode(Predicate);
            assert!(CC <= LAST_VALID_COND, "Unexpected condition code.");
            if SwapArgs {
                swap(CmpLHS, CmpRHS);
            }
            if !self.X86FastEmitCompare(CmpLHS, CmpRHS, VT, CI.getDebugLoc()) {
                return false;
            }
            BuildMI()(TrueMBB)(CC);
            if NeedExtraBranch {
                BuildMI()(TrueMBB)(COND_P);
            }
            self.finishCondBranch;
            return true;
        }
    }
    let mut OpReg: Register = self.getRegForValue;
    if !OpReg.operator unsigned int() {
        return false;
    }
    if  {
        let mut KOpReg: Register = OpReg;
        OpReg = self.createResultReg;
        BuildMI(OpReg)(KOpReg);
        OpReg = self.fastEmitInst_extractsubreg;
    }
    BuildMI()(OpReg)(1);
    BuildMI()(TrueMBB)(COND_NE);
    self.finishCondBranch;
    return true;
}

