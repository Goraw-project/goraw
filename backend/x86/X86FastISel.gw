    if (self.Subtarget.hasNDD()) {
        return self.fastEmitInst_rr(ADD16rr_ND, &mut GR16RegClass, Op0, Op1);
    }
    if (!self.Subtarget.hasNDD()) {
        return self.fastEmitInst_rr(ADD16rr, &mut GR16RegClass, Op0, Op1);
    }
    return Register { Reg: 0 };
}

