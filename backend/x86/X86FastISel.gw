    if RetVT.SimpleTy != i8 {
        return Register { Reg: 0 };
    }
    if (self.Subtarget.hasNDD()) && (self.Subtarget.is64Bit()) {
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), CL).addReg(Op1, RegState {}, 0);
        return self.fastEmitInst_r(ROL8rCL_ND, &mut GR8RegClass, Op0);
    }
    if (!self.Subtarget.hasNDD()) {
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), CL).addReg(Op1, RegState {}, 0);
        return self.fastEmitInst_r(ROL8rCL, &mut GR8RegClass, Op0);
    }
    return Register { Reg: 0 };
}

