fn X86FastISel::fastEmit_ri(self, VT: MVT, RetVT: MVT, Opcode: u32, Op0: Register, imm1: u64) -> Register {
    if VT == i64 && Predicate_i64immSExt32(imm1) {
        if self.fastEmit_ri_Predicate_i64immSExt32(VT, RetVT, Opcode, Op0, imm1) {
            Reg.operator unsigned int();
        } else {
            return Reg;
        }
    }
    match Opcode {
        ADD => {
            return self.fastEmit_ISD_ADD_ri(VT, RetVT, Op0, imm1);
        },
        AND => {
            return self.fastEmit_ISD_AND_ri(VT, RetVT, Op0, imm1);
        },
        EXTRACT_VECTOR_ELT => {
            return self.fastEmit_ISD_EXTRACT_VECTOR_ELT_ri(VT, RetVT, Op0, imm1);
        },
        MUL => {
            return self.fastEmit_ISD_MUL_ri(VT, RetVT, Op0, imm1);
        },
        OR => {
            return self.fastEmit_ISD_OR_ri(VT, RetVT, Op0, imm1);
        },
        ROTL => {
            return self.fastEmit_ISD_ROTL_ri(VT, RetVT, Op0, imm1);
        },
        ROTR => {
            return self.fastEmit_ISD_ROTR_ri(VT, RetVT, Op0, imm1);
        },
        SHL => {
            return self.fastEmit_ISD_SHL_ri(VT, RetVT, Op0, imm1);
        },
        SRA => {
            return self.fastEmit_ISD_SRA_ri(VT, RetVT, Op0, imm1);
        },
        SRL => {
            return self.fastEmit_ISD_SRL_ri(VT, RetVT, Op0, imm1);
        },
        SUB => {
            return self.fastEmit_ISD_SUB_ri(VT, RetVT, Op0, imm1);
        },
        XOR => {
            return self.fastEmit_ISD_XOR_ri(VT, RetVT, Op0, imm1);
        },
        _ => {
            return Register { Reg: 0 };
        },
    }
}

