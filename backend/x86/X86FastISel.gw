    }
    MIB.addRegMask;
    if self.Subtarget.isPICStyleGOT() {
        MIB.addReg;
    }
    if Is64Bit && IsVarArg && !IsWin64 {
        MIB.addReg;
    }
    let mut NumBytesForCalleeToPop: u32 = if isCalleePop(CC, self.Subtarget(), IsVarArg) { NumBytes } else { computeBytesPoppedByCalleeForSRet(self.Subtarget, CC, CLI.CB) };
    let mut AdjStackUp: u32 = 0;
    BuildMI()(NumBytes)(NumBytesForCalleeToPop)(3);
    let mut RVLocs: SmallVector<CCValAssign, 16> = zeroed();
    let mut CCRetInfo: CCState = zeroed();
    CCRetInfo(RetCC_X86);
    let mut ResultReg: Register = zeroed();
    for let mut i: u32 = 0; i != (); i += 1 {
        let mut VA: *mut CCValAssign = [i];
        let mut CopyVT: EVT = EVT { VA.getValVT() };
        let mut CopyReg: Register = Register { Reg: ResultReg.operator unsigned int() + i };
        let mut SrcReg: Register = VA.getLocReg();
        if (CopyVT == EVT { f32 } || CopyVT == EVT { f64 }) && ((Is64Bit || [i]()) && !self.Subtarget.hasSSE1()) {
            report_fatal_error("SSE register return with SSE disabled", true);
        }
        if  {
            CopyVT = EVT { f80 };
            CopyReg = self.createResultReg;
        }
        BuildMI(CopyReg)(SrcReg);
        InRegs()(VA.getLocReg());
        if CopyVT != EVT { VA.getValVT() } {
            let mut ResVT: EVT = EVT { VA.getValVT() };
            let mut Opc: u32 = 0;
            let mut MemSize: u32 = ResVT.getSizeInBits().operator unsigned long long() / 8;
            let mut FI: i32 = 0;
            addFrameReference(BuildMI(), FI)(CopyReg);
            addFrameReference(BuildMI(ResultReg.operator unsigned int() + i), FI);
        }
    }
    CLI.ResultReg = ResultReg;
    CLI.NumResultRegs = ();
    CLI.Call = MIB.operator llvm::MachineInstr *();
    if  {
        let mut CSInfo: CallSiteInfo = CallSiteInfo { *CB };
    }
    return true;
}

fn X86FastISel::fastSelectInstruction(self, I: *Instruction) -> bool {
    match I.getOpcode() {
        _ => {
            break;
        },
        Load => {
            return self.X86SelectLoad(I);
        },
        Store => {
            return self.X86SelectStore(I);
        },
        Ret => {
            return self.X86SelectRet(I);
        },
        ICmp => {
            FCmp;
        },
        ZExt => {
            return self.X86SelectZExt(I);
        },
        SExt => {
            return self.X86SelectSExt(I);
        },
        CondBr => {
            return self.X86SelectBranch(I);
        },
        LShr => {
            AShr;
        },
        Mul => {
            return self.X86SelectMul(I);
        },
        SDiv => {
            UDiv;
        },
        Select => {
            return self.X86SelectSelect(I);
        },
        Trunc => {
            return self.X86SelectTrunc(I);
        },
        FPExt => {
            return self.X86SelectFPExt(I);
        },
        FPTrunc => {
            return self.X86SelectFPTrunc(I);
        },
        SIToFP => {
            return self.X86SelectSIToFP(I);
        },
        UIToFP => {
            return self.X86SelectUIToFP(I);
        },
        IntToPtr => {
            PtrToInt;
        },
        BitCast => {
            return self.X86SelectBitCast(I);
        },
    }
    return false;
}

fn X86FastISel::emitMOV32r0(self) -> Register {
    let mut ResultReg: Register = self.createResultReg;
    BuildMI(ResultReg)(1);
    return ResultReg;
}

fn X86FastISel::X86MaterializeInt(self, CI: *ConstantInt, VT: MVT) -> Register {
    if VT > MVT { SimpleTy: i64 } {
        return Register { Reg: 0 };
    }
    let mut Imm: u64 = CI.getZExtValue();
    if Imm == 0 {
        let mut SrcReg: Register = self.emitMOV32r0();
        match VT.SimpleTy {
            _ => {
                llvm_unreachable_internal("Unexpected value type", "llvm\\lib\\Target\\X86\\X86FastISel.cpp", 3911);
            },
            i1 => {
                i8;
            },
            i16 => {
                return self.fastEmitInst_extractsubreg;
            },
            i32 => {
                return SrcReg;
            },
            i64 => {
                let mut ResultReg: Register = self.createResultReg;
                BuildMI(ResultReg)(SrcReg);
                return ResultReg;
            },
        }
    }
    let mut Opc: u32 = 0;
    match VT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected value type", "llvm\\lib\\Target\\X86\\X86FastISel.cpp", 3932);
        },
        i1 => {
            VT = MVT { SimpleTy: i8 };
        },
        i8 => {
            
        },
        i16 => {
            
        },
        i32 => {
            
        },
        i64 => {
            Opc = getMOVriOpcode(true, Imm);
        },
    }
    return self.fastEmitInst_i;
}

fn X86FastISel::X86MaterializeFP(self, CFP: *ConstantFP, VT: MVT) -> Register {
    if CFP.isNullValue() {
        return self.fastMaterializeFloatZero(CFP);
    }
    let mut CM: Model = zeroed();
    if CM != Small && CM != Medium && CM != Large {
        return Register { Reg: 0 };
    }
    let mut Opc: u32 = 0;
    let mut HasSSE1: bool = self.Subtarget.hasSSE1();
    let mut HasSSE2: bool = self.Subtarget.hasSSE2();
    let mut HasAVX: bool = self.Subtarget.hasAVX();
    let mut HasAVX512: bool = self.Subtarget.hasAVX512();
    match VT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        f32 => {
            
        },
        f64 => {
            
        },
        f80 => {
            return Register { Reg: 0 };
        },
    }
    let mut Alignment: Align = zeroed();
    let mut PICBase: Register = Register { Reg: 0 };
    let mut OpFlag: u8 = self.Subtarget.classifyLocalReference(null);
    if OpFlag == MO_PIC_BASE_OFFSET {
        PICBase = self.getInstrInfo().getGlobalBaseReg;
    } else if OpFlag == MO_GOTOFF {
        PICBase = self.getInstrInfo().getGlobalBaseReg;
    } else {
        
    }
    let mut CPI: u32 = 0;
    let mut ResultReg: Register = self.createResultReg;
    if self.Subtarget() && CM == Large {
        let mut AddrReg: Register = self.createResultReg;
        BuildMI(AddrReg)(CPI, 0, OpFlag);
        let mut MIB: MachineInstrBuilder = BuildMI(ResultReg);
        addRegReg(MIB, AddrReg, false, PICBase, false);
        let mut MMO: *mut MachineMemOperand = null;
        operator(MIB).addMemOperand;
        return ResultReg;
    }
    addConstantPoolReference(BuildMI(ResultReg), CPI, PICBase, OpFlag);
    return ResultReg;
}

fn X86FastISel::X86MaterializeGV(self, GV: *GlobalValue, VT: MVT) -> Register {
    if  {
        return Register { Reg: 0 };
    }
    if  {
        return Register { Reg: 0 };
    }
    let mut AM: X86AddressMode = X86AddressMode {};
    if self.X86SelectAddress(GV, AM) {
        if AM.BaseType == RegBase && AM.IndexReg == 0 && AM.Disp == 0 && AM.GV == null {
            return AM.Base.Reg;
        }
        let mut ResultReg: Register = self.createResultReg;
        if  {
            BuildMI(ResultReg)(GV);
        } else {
            let mut Opc: u32 = 0;
            self.addFullAddress(BuildMI(ResultReg), AM);
        }
        return ResultReg;
    }
    return Register { Reg: 0 };
}

fn X86FastISel::fastMaterializeConstant(self, C: *Constant) -> Register {
    let mut CEVT: EVT = zeroed();
    if !CEVT.isSimple() {
        return Register { Reg: 0 };
    }
    let mut VT: MVT = CEVT.getSimpleVT();
    if  {
        return self.X86MaterializeInt(VT);
    }
    if  {
        return self.X86MaterializeFP(VT);
    }
    if  {
        return self.X86MaterializeGV(VT);
    }
    if isa(C) {
        let mut Opc: u32 = 0;
        match VT.SimpleTy {
            _ => {
                break;
            },
            f32 => {
                
            },
            f64 => {
                
            },
            f80 => {
                
            },
        }
        if Opc {
            let mut ResultReg: Register = self.createResultReg;
            BuildMI(ResultReg);
            return ResultReg;
        }
    }
    return Register { Reg: 0 };
}

fn X86FastISel::fastMaterializeAlloca(self, C: *AllocaInst) -> Register {
    if  {
        return Register { Reg: 0 };
    }
    assert!(C.isStaticAlloca(), "dynamic alloca in the static alloca map?");
    let mut AM: X86AddressMode = X86AddressMode {};
    if !self.X86SelectAddress(C, AM) {
        return Register { Reg: 0 };
    }
    let mut Opc: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    let mut ResultReg: Register = self.createResultReg;
    self.addFullAddress(BuildMI(ResultReg), AM);
    return ResultReg;
}

fn X86FastISel::fastMaterializeFloatZero(self, CF: *ConstantFP) -> Register {
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(CF.getType(), VT, false) {
        return Register { Reg: 0 };
    }
    let mut HasSSE1: bool = self.Subtarget.hasSSE1();
    let mut HasSSE2: bool = self.Subtarget.hasSSE2();
    let mut HasAVX512: bool = self.Subtarget.hasAVX512();
    let mut Opc: u32 = 0;
    match VT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        f16 => {
            
        },
        f32 => {
            
        },
        f64 => {
            
        },
        f80 => {
            return Register { Reg: 0 };
        },
    }
    let mut ResultReg: Register = self.createResultReg;
    BuildMI(ResultReg);
    return ResultReg;
}

fn X86FastISel::tryToFoldLoadIntoMI(self, MI: *mut MachineInstr, OpNo: u32, LI: *LoadInst) -> bool {
    let mut Ptr: *Value = LI.getPointerOperand();
    let mut AM: X86AddressMode = X86AddressMode {};
    if !self.X86SelectAddress(Ptr, AM) {
        return false;
    }
    let mut XII: *X86InstrInfo = null;
    let mut Size: u32 = 0;
    let mut AddrOps: SmallVector<MachineOperand, 8> = zeroed();
    AM.getFullAddress();
    let mut CopyMI: *mut MachineInstr = null;
    let mut Result: *mut MachineInstr = XII;
    if !Result {
        return false;
    }
    let mut OperandNo: u32 = 0;
    for let mut I: mop_iterator = Result.operands_begin();
let mut E: mop_iterator = Result.operands_end(); I != E; I += 1 , OperandNo += 1 {
        let mut MO: *mut MachineOperand = *I;
        if !MO.isReg() || MO.isDef() || MO.getReg() != AM.IndexReg {
            continue;
        }
        let mut IndexReg: Register = self.constrainOperandRegClass;
        if IndexReg == MO.getReg() {
            continue;
        }
        MO.setReg(IndexReg);
    }
    Result.addMemOperand;
    Result.cloneInstrSymbols;
    let mut I: iterator = iterator { MI };
    self.removeDeadCode(I, next(I));
    return true;
}

fn X86FastISel::fastEmitInst_rrrr(self, MachineInstOpcode: u32, RC: *TargetRegisterClass, Op0: Register, Op1: Register, Op2: Register, Op3: Register) -> Register {
    let mut II: *MCInstrDesc = null;
    let mut ResultReg: Register = self.createResultReg;
    Op0 = self.constrainOperandRegClass;
    Op1 = self.constrainOperandRegClass;
    Op2 = self.constrainOperandRegClass;
    Op3 = self.constrainOperandRegClass;
    assert!(II.getNumDefs() >= 1, "instruction must define the result");
    BuildMI(II, ResultReg)(Op0)(Op1)(Op2)(Op3);
    return ResultReg;
}

fn createFastISel(funcInfo: *mut FunctionLoweringInfo, libInfo: *TargetLibraryInfo, libcallLowering: *LibcallLoweringInfo) -> *mut FastISel {
    return X86FastISel { funcInfo, libInfo, libcallLowering };
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Succ: *BasicBlock) -> bool {
        return !Succ.phis().is_empty();
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, V: *mut Value) -> auto {}

struct Closure_3 {
    cap_0: *mut X86FastISel,
}

fn Closure_3::call(self: *Closure_3, V: *Value) -> auto {
            let mut Reg: Register = self.getRegForValue;
            if Reg.operator unsigned int() && self.Subtarget.isTarget64BitILP32() {
                let mut CopyReg: Register = self.createResultReg;
                BuildMI(CopyReg)(Reg);
                let mut ExtReg: Register = self.createResultReg;
                BuildMI(ExtReg)(CopyReg);
                Reg = ExtReg;
            }
        }
