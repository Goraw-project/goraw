    if !LHSReg.operator unsigned int() {
        return false;
    }
    let mut RHSReg: Register = self.getRegForValue;
    if !RHSReg.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = self.X86FastEmitMul;
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86SelectDivRem(self, I: *Instruction) -> bool {
    let mut NumTypes: u32 = 4;
    let mut NumOps: u32 = 4;
    let mut S: bool = true;
    let mut U: bool = false;
    let mut Copy: u32 = COPY;
    let mut OpTable: [4]DivRemEntry = zeroed();
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), VT, false) {
        return false;
    }
    let mut TypeIndex: u32 = 0;
    let mut OpIndex: u32 = 0;
    match VT.SimpleTy {
        _ => {
            return false;
        },
        i8 => {
            TypeIndex = 0;
        },
        i16 => {
            TypeIndex = 1;
        },
        i32 => {
            TypeIndex = 2;
        },
        i64 => {
            TypeIndex = 3;
        },
    }
    match I.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected div/rem opcode", "llvm\\lib\\Target\\X86\\X86FastISel.cpp", 2080);
        },
        SDiv => {
            OpIndex = 0;
        },
        SRem => {
            OpIndex = 1;
        },
        UDiv => {
            OpIndex = 2;
        },
        URem => {
            OpIndex = 3;
        },
    }
    let mut TypeEntry: *DivRemEntry = OpTable[TypeIndex];
    let mut OpEntry: *DivRemResult = TypeEntry.ResultTable[OpIndex];
    let mut Op0Reg: Register = self.getRegForValue;
    if !Op0Reg.operator unsigned int() {
        return false;
    }
    let mut Op1Reg: Register = self.getRegForValue;
    if !Op1Reg.operator unsigned int() {
        return false;
    }
    BuildMI(TypeEntry.LowInReg)(Op0Reg);
    if OpEntry.OpSignExtend {
        if OpEntry.IsOpSigned {
            BuildMI();
        } else {
            let mut Zero32: Register = self.emitMOV32r0();
            if VT == i16 {
                BuildMI(TypeEntry.HighInReg);
            } else if VT == i32 {
                BuildMI(TypeEntry.HighInReg)(Zero32);
            } else if VT == i64 {
                BuildMI(TypeEntry.HighInReg)(Zero32);
            }
        }
    }
    let mut UseAXForRem: bool = false;
    let mut UsedReg: Register = zeroed();
    BuildMI()(Op1Reg);
    let mut ResultReg: Register = Register { Reg: 0 };
    if UseAXForRem {
        let mut SourceSuperReg: Register = self.createResultReg;
        let mut ResultSuperReg: Register = self.createResultReg;
        BuildMI(SourceSuperReg);
        BuildMI(ResultSuperReg)(SourceSuperReg)(8)(3);
        ResultReg = self.fastEmitInst_extractsubreg;
    }
    if !ResultReg.operator unsigned int() {
        ResultReg = self.createResultReg;
        BuildMI(ResultReg)(OpEntry.DivRemResultReg);
    }
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86FastEmitCMoveSelect(self, RetVT: MVT, I: *Instruction) -> bool {
    if !self.Subtarget.canUseCMOV() {
        return false;
    }
    if RetVT < MVT { SimpleTy: i16 } || RetVT > MVT { SimpleTy: i64 } {
        return false;
    }
    let mut Cond: *Value = I.getOperand(0);
    let mut RC: *TargetRegisterClass = null;
    let mut NeedTest: bool = true;
    let mut CC: CondCode = COND_NE;
    let mut CI: *auto = dyn_cast(Cond);
    if CI() && (CI()() == I.getParent()) {
        let mut Predicate: Predicate = self.optimizeCmpPredicate();
        let mut SETFOpcTable: [2]u16 = zeroed();
        let mut SETFOpc: *u16 = null;
        match Predicate {
            _ => {
                break;
            },
            FCMP_OEQ => {
                SETFOpc = &mut SETFOpcTable[0][0];
            },
            FCMP_UNE => {
                SETFOpc = &mut SETFOpcTable[1][0];
            },
        }
        let mut NeedSwap: bool = false;
        tie(CC, NeedSwap) = getX86ConditionCode(Predicate);
        assert!(CC <= LAST_VALID_COND, "Unexpected condition code.");
        let mut CmpLHS: *Value = (0);
        let mut CmpRHS: *Value = (1);
        if NeedSwap {
            swap(CmpLHS, CmpRHS);
        }
        let mut CmpVT: EVT = zeroed();
        if operator!(self.X86FastEmitCompare(CmpLHS, CmpRHS, CmpVT)) {
            return false;
        }
        if SETFOpc {
            let mut FlagReg1: Register = self.createResultReg;
            let mut FlagReg2: Register = self.createResultReg;
            BuildMI(FlagReg1)(SETFOpc[0]);
            BuildMI(FlagReg2)(SETFOpc[1]);
            let mut II: *auto = null;
            if II()() {
                let mut TmpReg: Register = self.createResultReg;
                BuildMI(TmpReg)(FlagReg2)(FlagReg1);
            } else {
                BuildMI()(FlagReg2)(FlagReg1);
            }
        }
        NeedTest = false;
    } else if self.foldX86XALUIntrinsic(CC, I, Cond) {
        let mut TmpReg: Register = self.getRegForValue;
        if !TmpReg.operator unsigned int() {
            return false;
        }
        NeedTest = false;
    }
    if NeedTest {
        let mut CondReg: Register = self.getRegForValue;
        if !CondReg.operator unsigned int() {
            return false;
        }
        if  {
            let mut KCondReg: Register = CondReg;
            CondReg = self.createResultReg;
            BuildMI(CondReg)(KCondReg);
            CondReg = self.fastEmitInst_extractsubreg;
        }
        BuildMI()(CondReg)(1);
    }
    let mut LHS: *Value = I.getOperand(1);
    let mut RHS: *Value = I.getOperand(2);
    let mut RHSReg: Register = self.getRegForValue;
    let mut LHSReg: Register = self.getRegForValue;
    if !LHSReg.operator unsigned int() || !RHSReg.operator unsigned int() {
        return false;
    }
    let mut TRI: *TargetRegisterInfo = *self.Subtarget.getRegisterInfo();
    let mut Opc: u32 = getCMovOpcode(TRI.getRegSizeInBits(*RC).operator unsigned long long() / 8, false, self.Subtarget());
    let mut ResultReg: Register = self.fastEmitInst_rri;
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86FastEmitSSESelect(self, RetVT: MVT, I: *Instruction) -> bool {
    let mut CI: *auto = dyn_cast(I.getOperand(0));
    if operator!() || (CI()() != I.getParent()) {
        return false;
    }
    if I.getType() != (0)() || !((self.Subtarget.hasSSE1() && RetVT == f32) || (self.Subtarget.hasSSE2() && RetVT == f64)) {
        return false;
    }
    let mut CmpLHS: *Value = (0);
    let mut CmpRHS: *Value = (1);
    let mut Predicate: Predicate = self.optimizeCmpPredicate();
    if Predicate == FCMP_ORD || Predicate == FCMP_UNO {
        let mut CmpRHSC: *auto = dyn_cast(CmpRHS);
        if CmpRHSC() && () {
            CmpRHS = CmpLHS;
        }
    }
    let mut CC: u32 = 0;
    let mut NeedSwap: bool = false;
    if CC > 7 && !self.Subtarget.hasAVX() {
        return false;
    }
    if NeedSwap {
        swap(CmpLHS, CmpRHS);
    }
    let mut LHS: *Value = I.getOperand(1);
    let mut RHS: *Value = I.getOperand(2);
    let mut LHSReg: Register = self.getRegForValue;
    let mut RHSReg: Register = self.getRegForValue;
    let mut CmpLHSReg: Register = self.getRegForValue;
    let mut CmpRHSReg: Register = self.getRegForValue;
    if !LHSReg.operator unsigned int() || !RHSReg.operator unsigned int() || !CmpLHSReg.operator unsigned int() || !CmpRHSReg.operator unsigned int() {
        return false;
    }
    let mut RC: *TargetRegisterClass = null;
    let mut ResultReg: Register = Register { Reg: 0 };
    if self.Subtarget.hasAVX512() {
        let mut VR128X: *TargetRegisterClass = null;
        let mut VK1: *TargetRegisterClass = null;
        let mut CmpOpcode: u32 = 0;
        let mut CmpReg: Register = self.fastEmitInst_rri;
        let mut ImplicitDefReg: Register = self.createResultReg;
        BuildMI(ImplicitDefReg);
        let mut MovOpcode: u32 = 0;
        let mut MovReg: Register = self.fastEmitInst_rrrr(MovOpcode, VR128X, RHSReg, CmpReg, ImplicitDefReg, LHSReg);
        ResultReg = self.createResultReg;
        BuildMI(ResultReg)(MovReg);
    } else if self.Subtarget.hasAVX() {
        let mut VR128: *TargetRegisterClass = null;
        let mut CmpOpcode: u32 = 0;
        let mut BlendOpcode: u32 = 0;
        let mut CmpReg: Register = self.fastEmitInst_rri;
        let mut VBlendReg: Register = self.fastEmitInst_rrr;
        ResultReg = self.createResultReg;
        BuildMI(ResultReg)(VBlendReg);
    } else {
        let mut OpcTable: [2]u16 = zeroed();
        let mut Opc: *u16 = null;
        match RetVT.SimpleTy {
            _ => {
                return false;
            },
            f32 => {
                Opc = &mut OpcTable[0][0];
            },
            f64 => {
                Opc = &mut OpcTable[1][0];
            },
        }
        let mut VR128: *TargetRegisterClass = null;
        let mut CmpReg: Register = self.fastEmitInst_rri;
        let mut AndReg: Register = self.fastEmitInst_rr;
        let mut AndNReg: Register = self.fastEmitInst_rr;
        let mut OrReg: Register = self.fastEmitInst_rr;
        ResultReg = self.createResultReg;
        BuildMI(ResultReg)(OrReg);
    }
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86FastEmitPseudoSelect(self, RetVT: MVT, I: *Instruction) -> bool {
    let mut Opc: u32 = 0;
    match RetVT.SimpleTy {
        _ => {
            return false;
        },
        i8 => {
            
        },
        i16 => {
            
        },
        i32 => {
            
        },
        f16 => {
            
        },
        f32 => {
            
        },
        f64 => {
            
        },
    }
    let mut Cond: *Value = I.getOperand(0);
    let mut CC: CondCode = COND_NE;
    let mut CI: *auto = dyn_cast(Cond);
    if CI() && (CI()() == I.getParent()) {
        let mut NeedSwap: bool = false;
        tie(CC, NeedSwap) = getX86ConditionCode();
        if CC > LAST_VALID_COND {
            return false;
        }
        let mut CmpLHS: *Value = (0);
        let mut CmpRHS: *Value = (1);
        if NeedSwap {
            swap(CmpLHS, CmpRHS);
        }
        let mut CmpVT: EVT = zeroed();
        if operator!(self.X86FastEmitCompare(CmpLHS, CmpRHS, CmpVT)) {
            return false;
        }
    } else {
        let mut CondReg: Register = self.getRegForValue;
        if !CondReg.operator unsigned int() {
            return false;
        }
        if  {
            let mut KCondReg: Register = CondReg;
            CondReg = self.createResultReg;
            BuildMI(CondReg)(KCondReg);
            CondReg = self.fastEmitInst_extractsubreg;
        }
        BuildMI()(CondReg)(1);
    }
    let mut LHS: *Value = I.getOperand(1);
    let mut RHS: *Value = I.getOperand(2);
    let mut LHSReg: Register = self.getRegForValue;
    let mut RHSReg: Register = self.getRegForValue;
    if !LHSReg.operator unsigned int() || !RHSReg.operator unsigned int() {
        return false;
    }
    let mut RC: *TargetRegisterClass = null;
    let mut ResultReg: Register = self.fastEmitInst_rri;
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86SelectSelect(self, I: *Instruction) -> bool {
    let mut RetVT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), RetVT, false) {
        return false;
    }
    if  {
        let mut Predicate: Predicate = self.optimizeCmpPredicate();
        let mut Opnd: *Value = null;
        match Predicate {
            _ => {
                break;
            },
            FCMP_FALSE => {
                Opnd = I.getOperand(2);
            },
            FCMP_TRUE => {
                Opnd = I.getOperand(1);
            },
        }
        if Opnd {
            let mut OpReg: Register = self.getRegForValue;
            if !OpReg.operator unsigned int() {
                return false;
            }
            let mut RC: *TargetRegisterClass = null;
            let mut ResultReg: Register = self.createResultReg;
            BuildMI(ResultReg)(OpReg);
            self.updateValueMap;
            return true;
        }
    }
    if self.X86FastEmitCMoveSelect(RetVT, I) {
        return true;
    }
    if self.X86FastEmitSSESelect(RetVT, I) {
        return true;
    }
    if self.X86FastEmitPseudoSelect(RetVT, I) {
        return true;
    }
    return false;
}

fn X86FastISel::X86SelectIntToFP(self, I: *Instruction, IsSigned: bool) -> bool {
    let mut HasAVX512: bool = self.Subtarget.hasAVX512();
    if !self.Subtarget.hasAVX() || (!IsSigned && !HasAVX512) {
        return false;
    }
    let mut SrcVT: EVT = zeroed();
    if SrcVT != EVT { i32 } && SrcVT != EVT { i64 } {
        return false;
    }
    let mut OpReg: Register = self.getRegForValue;
    if !OpReg.operator unsigned int() {
        return false;
    }
    let mut Opcode: u32 = 0;
    let mut SCvtOpc: [2]u16 = zeroed();
    let mut UCvtOpc: [2]u16 = zeroed();
    let mut Is64Bit: bool = SrcVT == EVT { i64 };
    if I.getType().isDoubleTy() {
        Opcode = if IsSigned { SCvtOpc[HasAVX512][1][Is64Bit] } else { UCvtOpc[1][Is64Bit] };
    } else if I.getType().isFloatTy() {
        Opcode = if IsSigned { SCvtOpc[HasAVX512][0][Is64Bit] } else { UCvtOpc[0][Is64Bit] };
    } else {
        return false;
    }
    let mut DstVT: MVT = zeroed();
    let mut RC: *TargetRegisterClass = null;
    let mut ImplicitDefReg: Register = self.createResultReg;
    BuildMI(ImplicitDefReg);
    let mut ResultReg: Register = self.fastEmitInst_rr;
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86SelectSIToFP(self, I: *Instruction) -> bool {
    return self.X86SelectIntToFP(I, true);
}

fn X86FastISel::X86SelectUIToFP(self, I: *Instruction) -> bool {
    return self.X86SelectIntToFP(I, false);
}

fn X86FastISel::X86SelectFPExtOrFPTrunc(self, I: *Instruction, TargetOpc: u32, RC: *TargetRegisterClass) -> bool {
    assert!((I.getOpcode() == FPExt || I.getOpcode() == FPTrunc), "Instruction must be an FPExt or FPTrunc!");
    let mut HasAVX: bool = self.Subtarget.hasAVX();
    let mut OpReg: Register = self.getRegForValue;
    if !OpReg.operator unsigned int() {
        return false;
    }
    let mut ImplicitDefReg: Register = Register { Reg: 0 };
    if HasAVX {
        ImplicitDefReg = self.createResultReg;
        BuildMI(ImplicitDefReg);
    }
    let mut ResultReg: Register = self.createResultReg;
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    MIB = BuildMI(ResultReg);
    if HasAVX {
        MIB.addReg(ImplicitDefReg, RegState {}, 0);
    }
    MIB.addReg(OpReg, RegState {}, 0);
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86SelectFPExt(self, I: *Instruction) -> bool {
    if self.Subtarget.hasSSE2() && I.getType().isDoubleTy() && I.getOperand(0).getType().isFloatTy() {
        let mut HasAVX512: bool = self.Subtarget.hasAVX512();
        let mut Opc: u32 = 0;
        return self.X86SelectFPExtOrFPTrunc;
    }
    return false;
}

fn X86FastISel::X86SelectFPTrunc(self, I: *Instruction) -> bool {
    if self.Subtarget.hasSSE2() && I.getType().isFloatTy() && I.getOperand(0).getType().isDoubleTy() {
        let mut HasAVX512: bool = self.Subtarget.hasAVX512();
        let mut Opc: u32 = 0;
        return self.X86SelectFPExtOrFPTrunc;
    }
    return false;
}

fn X86FastISel::X86SelectTrunc(self, I: *Instruction) -> bool {
    let mut SrcVT: EVT = zeroed();
    let mut DstVT: EVT = zeroed();
    if DstVT != EVT { i8 } && DstVT != EVT { i1 } {
        return false;
    }
    if  {
        return false;
    }
    let mut InputReg: Register = self.getRegForValue;
    if !InputReg.operator unsigned int() {
        return false;
    }
    if SrcVT == EVT { i8 } {
        self.updateValueMap;
        return true;
    }
    let mut ResultReg: Register = self.fastEmitInst_extractsubreg;
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap;
    return true;
}

fn X86FastISel::X86SelectBitCast(self, I: *Instruction) -> bool {
    let mut SrcVT: MVT = MVT {};
    let mut DstVT: MVT = MVT {};
    if !self.Subtarget.hasSSE2() || !self.isTypeLegal(I.getOperand(0).getType(), SrcVT, false) || !self.isTypeLegal(I.getType(), DstVT, false) {
        return false;
    }
    if !SrcVT.isVector() || !DstVT.isVector() || SrcVT.getVectorElementType() == i1 || DstVT.getVectorElementType() == i1 {
        return false;
    }
    let mut Reg: Register = self.getRegForValue;
    if !Reg.operator unsigned int() {
        return false;
    }
    let mut DstClass: *TargetRegisterClass = null;
    let mut ResultReg: Register = self.createResultReg;
    BuildMI(ResultReg)(Reg);
    self.updateValueMap;
    return true;
}

fn X86FastISel::IsMemcpySmall(self, Len: u64) -> bool {
    return Len <= (if self.Subtarget() { 32 } else { 16 });
}

fn X86FastISel::TryEmitSmallMemcpy(self, DestAM: X86AddressMode, SrcAM: X86AddressMode, Len: u64) -> bool {
    if !self.IsMemcpySmall(Len) {
        return false;
    }
    let mut i64Legal: bool = self.Subtarget();
    while Len {
        let mut VT: MVT = MVT {};
        if Len >= 8 && i64Legal {
            VT = MVT { SimpleTy: i64 };
        } else if Len >= 4 {
            VT = MVT { SimpleTy: i32 };
        } else if Len >= 2 {
            VT = MVT { SimpleTy: i16 };
        } else {
            VT = MVT { SimpleTy: i8 };
        }
        let mut Reg: Register = Register { Reg: 0 };
        let mut RV: bool = self.X86FastEmitLoad(VT, SrcAM, null, Reg, 1);
        RV &= self.X86FastEmitStore(EVT { VT }, Reg, DestAM, null, false);
        assert!(RV, "Failed to emit load or store??");
        RV as void;
        let mut Size: u32 = VT.getSizeInBits().operator unsigned long long() / 8;
        Len -= Size;
        DestAM.Disp += Size;
        SrcAM.Disp += Size;
    }
    return true;
}

fn X86FastISel::X86FastEmitAddSub_rr(self, BaseOpc: u32, VT: MVT, LHSReg: Register, RHSReg: Register) -> Register {
    let mut Opc: [2]u16 = zeroed();
    let mut IsSub: bool = BaseOpc == SUB;
    let mut TypeIdx: u32 = VT.SimpleTy - i8;
    return self.X86FastEmitLiveEFLAGS_rr;
}

fn X86FastISel::X86FastEmitAddSub_ri(self, BaseOpc: u32, VT: MVT, LHSReg: Register, CI: *ConstantInt, CondCode: u32) -> Register {
    let mut IsSub: bool = BaseOpc == SUB;
    let mut TypeIdx: u32 = VT.SimpleTy - i8;
    if CI.isOne() && CondCode == COND_O {
        let mut IncDecOpc: [2]u16 = zeroed();
        let mut ResultReg: Register = self.createResultReg;
        BuildMI(ResultReg)(LHSReg);
        return ResultReg;
    }
    if VT == i64 && !isInt(CI.getSExtValue()) {
        return Register { Reg: 0 };
    }
    let mut Opc: [2]u16 = zeroed();
    return self.X86FastEmitLiveEFLAGS_ri;
}

fn X86FastISel::fastLowerIntrinsicCall(self, II: *IntrinsicInst) -> bool {
    match II.getIntrinsicID() {
        _ => {
            return false;
        },
        frameaddress => {
            let mut MF: *mut MachineFunction = null;
            if MF.getTarget().getMCAsmInfo().usesWindowsCFI() {
                return false;
            }
            let mut RetTy: *mut Type = II.getCalledFunction().getReturnType();
            let mut VT: MVT = MVT {};
            if !self.isTypeLegal(RetTy, VT, false) {
                return false;
            }
            let mut Opc: u32 = 0;
            let mut RC: *TargetRegisterClass = null;
            match VT.SimpleTy {
                _ => {
                    llvm_unreachable_internal("Invalid result type for frameaddress.", "llvm\\lib\\Target\\X86\\X86FastISel.cpp", 2837);
                },
                i32 => {
                    
                },
                i64 => {
                    
                },
            }
            let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
            MFI.setFrameAddressIsTaken(true);
            let mut RegInfo: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
            let mut FrameReg: Register = RegInfo.getPtrSizedFrameRegister(*MF);
            let mut SrcReg: Register = self.createResultReg;
            BuildMI(SrcReg)(FrameReg);
            let mut Depth: u32 = cast(II.getOperand(0))();
            while Depth -= 1 {
                let mut DestReg: Register = self.createResultReg;
                addDirectMem(BuildMI(DestReg), SrcReg);
                SrcReg = DestReg;
            }
            self.updateValueMap;
            return true;
        },
        memcpy => {
            let mut MCI: *MemCpyInst = cast(II);
            if MCI()() {
                return false;
            }
            if isa(MCI()()) {
                let mut Len: u64 = cast(MCI()())();
                if self.IsMemcpySmall(Len) {
                    let mut DestAM: X86AddressMode = X86AddressMode {};
                    let mut SrcAM: X86AddressMode = X86AddressMode {};
                    if operator!(self.X86SelectAddress(MCI()(), DestAM)) || operator!(self.X86SelectAddress(MCI()(), SrcAM)) {
                        return false;
                    }
                    self.TryEmitSmallMemcpy(DestAM, SrcAM, Len);
                    return true;
                }
            }
            let mut SizeWidth: u32 = if self.Subtarget() { 64 } else { 32 };
            if operator!(MCI()()()(SizeWidth)) {
                return false;
            }
            if MCI()() > 255 || MCI()() > 255 {
                return false;
            }
            return ;
        },
        memset => {
            let mut MSI: *MemSetInst = cast(II);
            if MSI()() {
                return false;
            }
            let mut SizeWidth: u32 = if self.Subtarget() { 64 } else { 32 };
            if operator!(MSI()()()(SizeWidth)) {
                return false;
            }
            if MSI()() > 255 {
                return false;
            }
            return ;
        },
        stackprotector => {
            let mut PtrTy: EVT = zeroed();
            let mut Op1: *Value = II.getArgOperand(0);
            let mut Slot: *AllocaInst = cast(II.getArgOperand(1));
            let mut AM: X86AddressMode = X86AddressMode {};
            if !self.X86SelectAddress(Slot, AM) {
                return false;
            }
            if !self.X86FastEmitStore(PtrTy, Op1, AM, null, false) {
                return false;
            }
            return true;
        },
        dbg_declare => {
            let mut DI: *DbgDeclareInst = cast(II);
            let mut AM: X86AddressMode = X86AddressMode {};
            assert!(DI.getAddress(), "Null address should be checked earlier!");
            if !self.X86SelectAddress(DI.getAddress(), AM) {
                return false;
            }
            let mut II: *MCInstrDesc = null;
            (((operator!(operator!((DI.getVariable().isValidLocationForIntrinsic && "Expected inlined-at fields to agree")))) || (_wassert(L"DI->getVariable()->isValidLocationForIntrinsic(MIMD.getDL()) && \"Expected inlined-at fields to agree\"", L"llvm\\lib\\Target\\X86\\X86FastISel.cpp", (2943) as u32) , 0)) as void);
            self.addFullAddress(BuildMI(II), AM)(0)(DI.getVariable())(DI.getExpression());
            return true;
        },
        trap => {
            BuildMI();
            return true;
        },
        sqrt => {
            if !self.Subtarget.hasSSE1() {
                return false;
            }
            let mut RetTy: *mut Type = II.getCalledFunction().getReturnType();
            let mut VT: MVT = MVT {};
            if !self.isTypeLegal(RetTy, VT, false) {
                return false;
            }
            let mut SqrtOpc: [3]u16 = zeroed();
            let mut AVXLevel: u32 = if self.Subtarget.hasAVX512() { 2 } else { if self.Subtarget.hasAVX() { 1 } else { 0 } };
            let mut Opc: u32 = 0;
            match VT.SimpleTy {
                _ => {
                    return false;
                },
                f32 => {
                    Opc = SqrtOpc[AVXLevel][0];
                },
                f64 => {
                    Opc = SqrtOpc[AVXLevel][1];
                },
            }
            let mut SrcVal: *Value = II.getArgOperand(0);
            let mut SrcReg: Register = self.getRegForValue;
            if !SrcReg.operator unsigned int() {
                return false;
            }
            let mut RC: *TargetRegisterClass = null;
            let mut ImplicitDefReg: Register = Register { Reg: 0 };
            if AVXLevel > 0 {
                ImplicitDefReg = self.createResultReg;
                BuildMI(ImplicitDefReg);
            }
            let mut ResultReg: Register = self.createResultReg;
            let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
            MIB = BuildMI(ResultReg);
            if ImplicitDefReg.operator unsigned int() {
                MIB.addReg(ImplicitDefReg, RegState {}, 0);
            }
            MIB.addReg(SrcReg, RegState {}, 0);
            self.updateValueMap;
            return true;
        },
        sadd_with_overflow => {
            uadd_with_overflow;
        },
    }
}

fn X86FastISel::fastLowerArguments(self) -> bool {
    if  {
        return false;
    }
    let mut F: *Function = null;
    if F.isVarArg() {
        return false;
    }
    let mut CC: ID = F.getCallingConv();
    if CC != C {
        return false;
    }
    if self.Subtarget.isCallingConvWin64(CC) {
        return false;
    }
    if operator!(self.Subtarget()) {
        return false;
    }
    if self.Subtarget() {
        return false;
    }
    let mut GPRCnt: u32 = 0;
    let mut FPRCnt: u32 = 0;
    for Arg in F.args() {
        if Arg.hasAttribute(ByVal) || Arg.hasAttribute(InReg) || Arg.hasAttribute(StructRet) || Arg.hasAttribute(SwiftSelf) || Arg.hasAttribute(SwiftAsync) || Arg.hasAttribute(SwiftError) || Arg.hasAttribute(Nest) {
            return false;
        }
        let mut ArgTy: *mut Type = Arg.getType();
        if ArgTy.isStructTy() || ArgTy.isArrayTy() || ArgTy.isVectorTy() {
            return false;
        }
        let mut ArgVT: EVT = zeroed();
        if !ArgVT.isSimple() {
            return false;
        }
        match ArgVT.getSimpleVT().SimpleTy {
            _ => {
                return false;
            },
            i32 => {
                i64;
            },
            f32 => {
                f64;
            },
        }
        if GPRCnt > 6 {
            return false;
        }
        if FPRCnt > 8 {
            return false;
        }
    }
    let mut GPR32ArgRegs: []MCPhysReg = zeroed();
    let mut GPR64ArgRegs: []MCPhysReg = zeroed();
    let mut XMMArgRegs: []MCPhysReg = zeroed();
    let mut GPRIdx: u32 = 0;
    let mut FPRIdx: u32 = 0;
    for Arg in F.args() {
        let mut VT: MVT = zeroed();
        let mut RC: *TargetRegisterClass = null;
        let mut SrcReg: MCRegister = MCRegister { Reg: 0 };
        match VT.SimpleTy {
            _ => {
                llvm_unreachable_internal("Unexpected value type.", "llvm\\lib\\Target\\X86\\X86FastISel.cpp", 3319);
            },
            i32 => {
                SrcReg = MCRegister { Reg: GPR32ArgRegs[GPRIdx += 1] };
            },
            i64 => {
                SrcReg = MCRegister { Reg: GPR64ArgRegs[GPRIdx += 1] };
            },
            f32 => {
                
            },
            f64 => {
                SrcReg = MCRegister { Reg: XMMArgRegs[FPRIdx += 1] };
            },
        }
        let mut DstReg: Register = zeroed();
        let mut ResultReg: Register = self.createResultReg;
        BuildMI(ResultReg)(DstReg, getKillRegState(true));
        self.updateValueMap;
    }
    return true;
}

fn computeBytesPoppedByCalleeForSRet(Subtarget: *X86Subtarget, CC: ID, CB: *CallBase) -> u32 {
    if Subtarget()() {
        return 0;
    }
    if Subtarget.getTargetTriple().isOSMSVCRT() {
        return 0;
    }
    if CC == Fast || CC == GHC || CC == HiPE || CC == Tail || CC == SwiftTail {
        return 0;
    }
    if CB {
        if CB.arg_empty() || !CB.paramHasAttr(0, StructRet) || CB.paramHasAttr(0, InReg) || Subtarget.isTargetMCU() {
            return 0;
        }
    }
    return 4;
}

