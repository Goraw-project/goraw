fn X86FastISel::fastEmit_X86ISD_VSRL_MVT_v8i16_rr(self, RetVT: MVT, Op0: Register, Op1: Register) -> Register {
    if RetVT.SimpleTy != v8i16 {
        return Register { Reg: 0 };
    }
    if (self.Subtarget.hasBWI()) && (self.Subtarget.hasVLX()) {
        return self.fastEmitInst_rr(VPSRLWZ128rr, &mut VR128XRegClass, Op0, Op1);
    }
    if (self.Subtarget.hasSSE2() && !self.Subtarget.hasAVX()) {
        return self.fastEmitInst_rr(PSRLWrr, &mut VR128RegClass, Op0, Op1);
    }
    if (self.Subtarget.hasAVX()) && (!self.Subtarget.hasVLX() || !self.Subtarget.hasBWI()) {
        return self.fastEmitInst_rr(VPSRLWrr, &mut VR128RegClass, Op0, Op1);
    }
    return Register { Reg: 0 };
}

