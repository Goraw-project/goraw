        return self.fastEmitInst_r(PABSDrr, &mut VR128RegClass, Op0);
    }
    if (self.Subtarget.hasAVX()) && (!self.Subtarget.hasVLX()) {
        return self.fastEmitInst_r(VPABSDrr, &mut VR128RegClass, Op0);
