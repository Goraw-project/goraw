fn X86FastISel::getInstrInfo(self: *X86FastISel) -> *X86InstrInfo {
    return self.Subtarget.getInstrInfo();
}

fn X86FastISel::getTargetMachine(self: *X86FastISel) -> *X86TargetMachine {
    return &mut self.TM as *X86TargetMachine;
}

fn X86FastISel::isScalarFPTypeInSSEReg(self: *X86FastISel, VT: EVT) -> bool {
    return (VT == f64 && self.Subtarget.hasSSE2()) || (VT == f32 && self.Subtarget.hasSSE1()) || VT == f16;
}

fn X86FastISel::getLastLocalValue(self) -> *mut MachineInstr {
    return self.LastLocalValue;
}

fn X86FastISel::setLastLocalValue(self, I: *mut MachineInstr) {
    self.EmitStartPt = I;
    self.LastLocalValue = I;
}

fn X86FastISel::getCurDebugLoc(self: *X86FastISel) -> DebugLoc {
    return self.MIMD.getDL();
}

fn X86FastISel::shouldOptForSize(self: *X86FastISel, MF: *MachineFunction) -> bool {
    return MF.getFunction().hasOptSize();
}

fn getX86SSEConditionCode(Predicate: Predicate) -> pair<unsigned int, bool> {
    let mut CC: u32 = 0;
    let mut NeedSwap: bool = false;
    match Predicate {
        _ => {
            llvm_unreachable_internal("Unexpected predicate", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 227);
        },
        FCMP_OEQ => {
            CC = 0;
        },
        FCMP_OGT => {
            NeedSwap = true;
        },
        FCMP_OLT => {
            CC = 1;
        },
        FCMP_OGE => {
            NeedSwap = true;
        },
        FCMP_OLE => {
            CC = 2;
        },
        FCMP_UNO => {
            CC = 3;
        },
        FCMP_UNE => {
            CC = 4;
        },
        FCMP_ULE => {
            NeedSwap = true;
        },
        FCMP_UGE => {
            CC = 5;
        },
        FCMP_ULT => {
            NeedSwap = true;
        },
        FCMP_UGT => {
            CC = 6;
        },
        FCMP_ORD => {
            CC = 7;
        },
        FCMP_UEQ => {
            CC = 8;
        },
        FCMP_ONE => {
            CC = 12;
        },
    }
    return make_pair(CC, NeedSwap);
}

fn X86FastISel::addFullAddress(self, MIB: *MachineInstrBuilder, AM: *mut X86AddressMode) -> *MachineInstrBuilder {
    AM.IndexReg = self.constrainOperandRegClass(operator(MIB).getDesc(), AM.IndexReg, operator(MIB).getNumOperands() + AddrIndexReg);
    return addFullAddress(MIB, AM);
}

fn X86FastISel::foldX86XALUIntrinsic(self, CC: *mut CondCode, I: *Instruction, Cond: *Value) -> bool {
    if !isa(Cond) {
        return false;
    }
    let mut EV: *ExtractValueInst const = cast(Cond);
    if !isa(EV.getAggregateOperand()) {
        return false;
    }
    let mut II: *IntrinsicInst const = cast(EV.getAggregateOperand());
    let mut RetVT: MVT = MVT {};
    let mut Callee: *Function = II.getCalledFunction();
    let mut RetTy: *mut Type = cast(Callee.getReturnType()).getTypeAtIndex(0);
    if !self.isTypeLegal(RetTy, RetVT, false) {
        return false;
    }
    if RetVT != i32 && RetVT != i64 {
        return false;
    }
    let mut TmpCC: CondCode = zeroed();
    match II.getIntrinsicID() {
        _ => {
            return false;
        },
        sadd_with_overflow => {
            ssub_with_overflow;
        },
        smul_with_overflow => {
            umul_with_overflow;
        },
    }
    if II.getParent() != I.getParent() {
        return false;
    }
    let mut Start: const_iterator = I;
    let mut End: const_iterator = II;
    for let mut Itr: BasicBlock>, false, true> = prev(Start, 1); Itr != End; operator(Itr) {
        if !isa(Itr) {
            return false;
        }
        let mut EVI: *ExtractValueInst const = cast(Itr);
        if EVI.getAggregateOperand() != II {
            return false;
        }
    }
    let mut HasPhis: Closure_1 = Closure_1 {};
    if I.isTerminator() && any_of(successors(I), HasPhis) {
        return false;
    }
    if any_of(I.operands(), Closure_2 {}) {
        return false;
    }
    CC = TmpCC;
    return true;
}

fn X86FastISel::isTypeLegal(self, Ty: *mut Type, VT: *mut MVT, AllowI1: bool) -> bool {
    let mut evt: EVT = self.TLI.getValueType(self.DL, Ty, true);
    if evt == Other || !evt.isSimple() {
        return false;
    }
    VT = evt.getSimpleVT();
    if VT == f64 && !self.Subtarget.hasSSE2() {
        return false;
    }
    if VT == f32 && !self.Subtarget.hasSSE1() {
        return false;
    }
    if VT == f80 {
        return false;
    }
    return (AllowI1 && VT == i1) || self.TLI.isTypeLegal(VT);
}

fn X86FastISel::X86FastEmitLoad(self, VT: MVT, AM: *mut X86AddressMode, MMO: *mut MachineMemOperand, ResultReg: *mut Register, Alignment: u32) -> bool {
    let mut HasSSE1: bool = self.Subtarget.hasSSE1();
    let mut HasSSE2: bool = self.Subtarget.hasSSE2();
    let mut HasSSE41: bool = self.Subtarget.hasSSE41();
    let mut HasAVX: bool = self.Subtarget.hasAVX();
    let mut HasAVX2: bool = self.Subtarget.hasAVX2();
    let mut HasAVX512: bool = self.Subtarget.hasAVX512();
    let mut HasVLX: bool = self.Subtarget.hasVLX();
    let mut IsNonTemporal: bool = MMO && MMO.isNonTemporal();
    if VT == i1 {
        VT = i8;
    }
    let mut Opc: u32 = 0;
    match VT.SimpleTy {
        _ => {
            return false;
        },
        i8 => {
            Opc = MOV8rm;
        },
        i16 => {
            Opc = MOV16rm;
        },
        i32 => {
            Opc = MOV32rm;
        },
        i64 => {
            Opc = MOV64rm;
        },
        f32 => {
            Opc = if HasAVX512 { VMOVSSZrm_alt } else { if HasAVX { VMOVSSrm_alt } else { if HasSSE1 { MOVSSrm_alt } else { LD_Fp32m } } };
        },
        f64 => {
            Opc = if HasAVX512 { VMOVSDZrm_alt } else { if HasAVX { VMOVSDrm_alt } else { if HasSSE2 { MOVSDrm_alt } else { LD_Fp64m } } };
        },
        f80 => {
            return false;
        },
        v4f32 => {
            if IsNonTemporal && Alignment >= 16 && HasSSE41 {
                Opc = if HasVLX { VMOVNTDQAZ128rm } else { if HasAVX { VMOVNTDQArm } else { MOVNTDQArm } };
            } else if Alignment >= 16 {
                Opc = if HasVLX { VMOVAPSZ128rm } else { if HasAVX { VMOVAPSrm } else { MOVAPSrm } };
            } else {
                Opc = if HasVLX { VMOVUPSZ128rm } else { if HasAVX { VMOVUPSrm } else { MOVUPSrm } };
            }
        },
        v2f64 => {
            if IsNonTemporal && Alignment >= 16 && HasSSE41 {
                Opc = if HasVLX { VMOVNTDQAZ128rm } else { if HasAVX { VMOVNTDQArm } else { MOVNTDQArm } };
            } else if Alignment >= 16 {
                Opc = if HasVLX { VMOVAPDZ128rm } else { if HasAVX { VMOVAPDrm } else { MOVAPDrm } };
            } else {
                Opc = if HasVLX { VMOVUPDZ128rm } else { if HasAVX { VMOVUPDrm } else { MOVUPDrm } };
            }
        },
        v4i32 => {
            v2i64;
        },
        v8f32 => {
            assert!(HasAVX);
        },
        v4f64 => {
            assert!(HasAVX);
        },
        v8i32 => {
            v4i64;
        },
        v16f32 => {
            assert!(HasAVX512);
        },
        v8f64 => {
            assert!(HasAVX512);
        },
        v8i64 => {
            v16i32;
        },
    }
    let mut RC: *TargetRegisterClass = self.TLI.getRegClassFor(VT, false);
    ResultReg = self.createResultReg(RC);
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg);
    self.addFullAddress(MIB, AM);
    if MMO {
        operator(MIB).addMemOperand(*self.FuncInfo.MF, MMO);
    }
    return true;
}

fn X86FastISel::X86FastEmitStore(self, VT: EVT, ValReg: Register, AM: *mut X86AddressMode, MMO: *mut MachineMemOperand, Aligned: bool) -> bool {
    let mut HasSSE1: bool = self.Subtarget.hasSSE1();
    let mut HasSSE2: bool = self.Subtarget.hasSSE2();
    let mut HasSSE4A: bool = self.Subtarget.hasSSE4A();
    let mut HasAVX: bool = self.Subtarget.hasAVX();
    let mut HasAVX512: bool = self.Subtarget.hasAVX512();
    let mut HasVLX: bool = self.Subtarget.hasVLX();
    let mut IsNonTemporal: bool = MMO && MMO.isNonTemporal();
    let mut Opc: u32 = 0;
    match VT.getSimpleVT().SimpleTy {
        f80 => {
            false;
        },
        i1 => {
            let mut AndResult: Register = self.createResultReg(&mut GR8RegClass);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(AND8ri), AndResult).addReg(ValReg, RegState {}, 0).addImm(1).setOperandDead(3);
            ValReg = AndResult;
        },
        i8 => {
            Opc = MOV8mr;
        },
        i16 => {
            Opc = MOV16mr;
        },
        i32 => {
            Opc = if (IsNonTemporal && HasSSE2) { MOVNTImr } else { MOV32mr };
        },
        i64 => {
            Opc = if (IsNonTemporal && HasSSE2) { MOVNTI_64mr } else { MOV64mr };
        },
        f32 => {
            if HasSSE1 {
                if IsNonTemporal && HasSSE4A {
                    Opc = MOVNTSS;
                } else {
                    Opc = if HasAVX512 { VMOVSSZmr } else { if HasAVX { VMOVSSmr } else { MOVSSmr } };
                }
            } else {
                Opc = ST_Fp32m;
            }
        },
        f64 => {
            if HasSSE2 {
                if IsNonTemporal && HasSSE4A {
                    Opc = MOVNTSD;
                } else {
                    Opc = if HasAVX512 { VMOVSDZmr } else { if HasAVX { VMOVSDmr } else { MOVSDmr } };
                }
            } else {
                Opc = ST_Fp64m;
            }
        },
        x86mmx => {
            Opc = if (IsNonTemporal && HasSSE1) { MMX_MOVNTQmr } else { MMX_MOVQ64mr };
        },
        v4f32 => {
            if Aligned {
                if IsNonTemporal {
                    Opc = if HasVLX { VMOVNTPSZ128mr } else { if HasAVX { VMOVNTPSmr } else { MOVNTPSmr } };
                } else {
                    Opc = if HasVLX { VMOVAPSZ128mr } else { if HasAVX { VMOVAPSmr } else { MOVAPSmr } };
                }
            } else {
                Opc = if HasVLX { VMOVUPSZ128mr } else { if HasAVX { VMOVUPSmr } else { MOVUPSmr } };
            }
        },
        v2f64 => {
            if Aligned {
                if IsNonTemporal {
                    Opc = if HasVLX { VMOVNTPDZ128mr } else { if HasAVX { VMOVNTPDmr } else { MOVNTPDmr } };
                } else {
                    Opc = if HasVLX { VMOVAPDZ128mr } else { if HasAVX { VMOVAPDmr } else { MOVAPDmr } };
                }
            } else {
                Opc = if HasVLX { VMOVUPDZ128mr } else { if HasAVX { VMOVUPDmr } else { MOVUPDmr } };
            }
        },
        v4i32 => {
            v2i64;
        },
        v8f32 => {
            assert!(HasAVX);
        },
        v4f64 => {
            assert!(HasAVX);
        },
        v8i32 => {
            v4i64;
        },
        v16f32 => {
            assert!(HasAVX512);
        },
        v8f64 => {
            assert!(HasAVX512);
        },
        v8i64 => {
            v16i32;
        },
    }
    let mut Desc: *MCInstrDesc = self.TII.get(Opc);
    ValReg = self.constrainOperandRegClass(Desc, ValReg, Desc.getNumOperands() - 1);
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, Desc);
    self.addFullAddress(MIB, AM).addReg(ValReg, RegState {}, 0);
    if MMO {
        operator(MIB).addMemOperand(*self.FuncInfo.MF, MMO);
    }
    return true;
}

fn X86FastISel::X86FastEmitStore(self, VT: EVT, Val: *Value, AM: *mut X86AddressMode, MMO: *mut MachineMemOperand, Aligned: bool) -> bool {
    if isa(Val) {
        Val = getNullValue(self.DL.getIntPtrType(Val.getContext(), 0));
    }
    if dyn_cast(Val) {
        CI;
    } else {
        let mut Opc: u32 = 0;
        let mut Signed: bool = true;
        match VT.getSimpleVT().SimpleTy {
            _ => {
                break;
            },
            i1 => {
                Signed = false;
            },
            i8 => {
                Opc = MOV8mi;
            },
            i16 => {
                Opc = MOV16mi;
            },
            i32 => {
                Opc = MOV32mi;
            },
            i64 => {
                if isInt(CI.getSExtValue()) {
                    Opc = MOV64mi32;
                }
            },
        }
        if Opc {
            let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc));
            self.addFullAddress(MIB, AM).addImm(if Signed { CI.getSExtValue() as u64 } else { CI.getZExtValue() });
            if MMO {
                operator(MIB).addMemOperand(*self.FuncInfo.MF, MMO);
            }
            return true;
        }
    }
    let mut ValReg: Register = self.getRegForValue(Val);
    if !ValReg.operator unsigned int() {
        return false;
    }
    return self.X86FastEmitStore(VT, ValReg, AM, MMO, Aligned);
}

fn X86FastISel::X86FastEmitExtend(self, Opc: NodeType, DstVT: EVT, Src: Register, SrcVT: EVT, ResultReg: *mut Register) -> bool {
    let mut RR: Register = self.fastEmit_r(SrcVT.getSimpleVT(), DstVT.getSimpleVT(), Opc, Src);
    if !RR.operator unsigned int() {
        return false;
    }
    ResultReg = RR;
    return true;
}

fn X86FastISel::X86FastEmitLiveEFLAGS_rr(self, Opc: u32, RC: *TargetRegisterClass, Op0: Register, Op1: Register) -> Register {
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    assert!(II.getNumDefs() >= 1, "instruction must define the result");
    assert!(II.implicit_defs().len == 1 && II.implicit_defs()[0] == EFLAGS, "unexpected implicit def");
    let mut ResultReg: Register = self.createResultReg(RC);
    Op0 = self.constrainOperandRegClass(II, Op0, II.getNumDefs());
    Op1 = self.constrainOperandRegClass(II, Op1, II.getNumDefs() + 1);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II, ResultReg).addReg(Op0, RegState {}, 0).addReg(Op1, RegState {}, 0);
    return ResultReg;
}

fn X86FastISel::X86FastEmitLiveEFLAGS_ri(self, Opc: u32, RC: *TargetRegisterClass, Op0: Register, Imm: u64) -> Register {
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    assert!(II.getNumDefs() >= 1, "instruction must define the result");
    assert!(II.implicit_defs().len == 1 && II.implicit_defs()[0] == EFLAGS, "unexpected implicit def");
    let mut ResultReg: Register = self.createResultReg(RC);
    Op0 = self.constrainOperandRegClass(II, Op0, II.getNumDefs());
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II, ResultReg).addReg(Op0, RegState {}, 0).addImm(Imm);
    return ResultReg;
}

fn X86FastISel::X86FastEmitMul(self, Opc: u32, VT: MVT, AccReg: MCRegister, LHSReg: Register, RHSReg: Register, LiveEFLAGS: bool) -> Register {
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), AccReg).addReg(LHSReg, RegState {}, 0);
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(VT, false));
    RHSReg = self.constrainOperandRegClass(II, RHSReg, II.getNumDefs());
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II).addReg(RHSReg, RegState {}, 0);
    assert!(operator(MIB).getOperand(1).getReg() == AccReg, "unexpected operand order");
    if VT == i8 {
        assert!(operator(MIB).getOperand(2).getReg() == EFLAGS, "unexpected operand order");
        if !LiveEFLAGS {
            MIB.setOperandDead(2);
        }
    } else {
        assert!(operator(MIB).getOperand(3).getReg() == EFLAGS, "unexpected operand order");
        MIB.setOperandDead(2);
        if !LiveEFLAGS {
            MIB.setOperandDead(3);
        }
    }
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(AccReg, RegState {}, 0);
    return ResultReg;
}

fn X86FastISel::handleConstantAddresses(self, V: *Value, AM: *mut X86AddressMode) -> bool {
    if dyn_cast(V) {
        GV;
    } else {
        if self.TM.getCodeModel() != Small && self.TM.getCodeModel() != Medium {
            return false;
        }
        if self.TM.isLargeGlobalValue(GV) {
            return false;
        }
        if GV.isThreadLocal() {
            return false;
        }
        if GV.isAbsoluteSymbolRef() {
            return false;
        }
        if !self.Subtarget.isPICStyleRIPRel() || (AM.Base.Reg == 0 && AM.IndexReg == 0) {
            AM.GV = GV;
            let mut GVFlags: u8 = self.Subtarget.classifyGlobalReference(GV);
            if isGlobalRelativeToPICBase(GVFlags) {
                AM.Base.Reg = self.getInstrInfo().getGlobalBaseReg(self.FuncInfo.MF);
            }
            if !isGlobalStubReference(GVFlags) {
                if self.Subtarget.isPICStyleRIPRel() {
                    assert!(AM.Base.Reg == 0 && AM.IndexReg == 0);
                    AM.Base.Reg = RIP;
                }
                AM.GVOpFlags = GVFlags;
                return true;
            }
            let mut I: iterator = self.LocalValueMap.find(V);
            let mut LoadReg: Register = 0;
            if I != self.LocalValueMap.end() && operator(I).second.operator unsigned int() {
                LoadReg = operator(I).second;
            } else {
                let mut Opc: u32 = 0;
                let mut RC: *TargetRegisterClass = null;
                let mut StubAM: X86AddressMode = X86AddressMode {};
                StubAM.Base.Reg = AM.Base.Reg;
                StubAM.GV = GV;
                StubAM.GVOpFlags = GVFlags;
                let mut SaveInsertPt: SavePoint = self.enterLocalValueArea();
                if self.TLI.getPointerTy(self.DL, 0) == i64 {
                    Opc = MOV64rm;
                    RC = &mut GR64RegClass;
                } else {
                    Opc = MOV32rm;
                    RC = &mut GR32RegClass;
                }
                if self.Subtarget.isPICStyleRIPRel() || GVFlags == MO_GOTPCREL || GVFlags == MO_GOTPCREL_NORELAX {
                    StubAM.Base.Reg = RIP;
                }
                LoadReg = self.createResultReg(RC);
                let mut LoadMI: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), LoadReg);
                self.addFullAddress(LoadMI, StubAM);
                self.leaveLocalValueArea(SaveInsertPt);
                self.LocalValueMap[V] = LoadReg;
            }
            AM.Base.Reg = LoadReg;
            AM.GV = null;
            return true;
        }
    }
    if !AM.GV || !self.Subtarget.isPICStyleRIPRel() {
        if AM.Base.Reg == 0 {
            AM.Base.Reg = self.getRegForValue(V);
            return AM.Base.Reg != 0;
        }
        if AM.IndexReg == 0 {
            assert!(AM.Scale == 1, "Scale with no index!");
            AM.IndexReg = self.getRegForValue(V);
            return AM.IndexReg != 0;
        }
    }
    return false;
}

fn X86FastISel::X86SelectAddress(self, V: *Value, AM: *mut X86AddressMode) -> bool {
    let mut GEPs: SmallVector<const Value *, 32> = SmallVector<const Value *, 32> {};
    null;
    let mut Opcode: u32 = UserOp1;
    if dyn_cast(V) {
        I;
    } else {
        if self.FuncInfo.StaticAllocaMap.count(V as *AllocaInst) || self.FuncInfo.getMBB(I.getParent()) == self.FuncInfo.MBB {
            Opcode = I.getOpcode();
            U = I;
        }
    }
    if dyn_cast(V.getType()) {
        Ty;
    } else if Ty.getAddressSpace() > 255 {
        return false;
    }
    match Opcode {
        _ => {
            break;
        },
        BitCast => {
            return self.X86SelectAddress(U.getOperand(0), AM);
        },
        IntToPtr => {
            if self.TLI.getValueType(self.DL, U.getOperand(0).getType(), false) == self.TLI.getPointerTy(self.DL, 0) {
                return self.X86SelectAddress(U.getOperand(0), AM);
            }
        },
        PtrToInt => {
            if self.TLI.getValueType(self.DL, U.getType(), false) == self.TLI.getPointerTy(self.DL, 0) {
                return self.X86SelectAddress(U.getOperand(0), AM);
            }
        },
        Alloca => {
            let mut A: *AllocaInst = cast(V);
            let mut SI: iterator = self.FuncInfo.StaticAllocaMap.find(A);
            if SI != self.FuncInfo.StaticAllocaMap.end() {
                AM.BaseType = FrameIndexBase;
                AM.Base.FrameIndex = operator(SI).second;
                return true;
            }
            break;
        },
        Add => {
            if dyn_cast(U.getOperand(1)) {
                CI;
            } else {
                let mut Disp: u64 = AM.Disp as i32 + CI.getSExtValue() as u64;
                if isInt(Disp) {
                    AM.Disp = Disp as u32;
                    return self.X86SelectAddress(U.getOperand(0), AM);
                }
            }
            break;
        },
        GetElementPtr => {
            let mut SavedAM: X86AddressMode = AM;
            let mut Disp: u64 = AM.Disp as i32;
            let mut IndexReg: Register = AM.IndexReg;
            let mut Scale: u32 = AM.Scale;
            let mut PtrVT: MVT = self.TLI.getValueType(self.DL, U.getType(), false).getSimpleVT();
            let mut GTI: gep_type_iterator = gep_type_begin(U);
            for let mut i: const_op_iterator = U.op_begin() + 1;
let mut e: const_op_iterator = U.op_end(); i != e; i += 1 , operator(GTI) {
                let mut Op: *Value = *i.operator llvm::Value *();
                if GTI.getStructTypeOrNull() {
                    STy;
                } else {
                    let mut SL: *StructLayout = self.DL.getStructLayout(STy);
                    Disp += SL.getElementOffset(cast(Op).getZExtValue()).operator unsigned long long();
                    continue;
                }
                let mut S: u64 = GTI.getSequentialElementStride(self.DL).operator unsigned long long();
                for {
                    if dyn_cast(Op) {
                        CI;
                    } else {
                        Disp += CI.getValue().sextOrTrunc(64).getSExtValue() * S;
                        break;
                    }
                    if self.canFoldAddIntoGEP(U, Op) {
                        let mut CI: *mut ConstantInt = cast(cast(Op).getOperand(1));
                        Disp += CI.getSExtValue() * S;
                        Op = cast(Op).getOperand(0);
                        continue;
                    }
                    if !IndexReg.operator unsigned int() && (!AM.GV || !self.Subtarget.isPICStyleRIPRel()) && (S == 1 || S == 2 || S == 4 || S == 8) {
                        Scale = S;
                        IndexReg = self.getRegForGEPIndex(PtrVT, Op);
                        if !IndexReg.operator unsigned int() {
                            return false;
                        }
                        break;
                    }
                }
            }
            if !isInt(Disp) {
                break;
            }
            AM.IndexReg = IndexReg;
            AM.Scale = Scale;
            AM.Disp = Disp as u32;
            GEPs.push(V);
            if dyn_cast(U.getOperand(0)) {
                GEP;
            } else {
                V = GEP;
            }
            AM = SavedAM;
            for I in reverse(GEPs) {
                if self.handleConstantAddresses(I, AM) {
                    return true;
                }
            }
            return false;
        },
    }
    return self.handleConstantAddresses(V, AM);
}

fn X86FastISel::X86SelectCallAddress(self, V: *Value, AM: *mut X86AddressMode) -> bool {
    let mut U: *User = null;
    let mut Opcode: u32 = UserOp1;
    let mut I: *Instruction = dyn_cast(V);
    let mut InMBB: bool = true;
    if I {
        Opcode = I.getOpcode();
        U = I;
        InMBB = I.getParent() == self.FuncInfo.MBB.getBasicBlock();
    } else if dyn_cast(V) {
        C;
    } else {
        Opcode = C.getOpcode();
        U = C;
    }
    match Opcode {
        _ => {
            break;
        },
        BitCast => {
            if InMBB {
                return self.X86SelectCallAddress(U.getOperand(0), AM);
            }
        },
        IntToPtr => {
            if InMBB && self.TLI.getValueType(self.DL, U.getOperand(0).getType(), false) == self.TLI.getPointerTy(self.DL, 0) {
                return self.X86SelectCallAddress(U.getOperand(0), AM);
            }
        },
        PtrToInt => {
            if InMBB && self.TLI.getValueType(self.DL, U.getType(), false) == self.TLI.getPointerTy(self.DL, 0) {
                return self.X86SelectCallAddress(U.getOperand(0), AM);
            }
        },
    }
    if dyn_cast(V) {
        GV;
    } else {
        if self.TM.getCodeModel() != Small && self.TM.getCodeModel() != Medium {
            return false;
        }
        if self.Subtarget.isPICStyleRIPRel() && (AM.Base.Reg != 0 || AM.IndexReg != 0) {
            return false;
        }
        if dyn_cast(GV) {
            GVar;
        } else if GVar.isThreadLocal() {
            return false;
        }
        AM.GV = GV;
        if self.Subtarget.isPICStyleRIPRel() {
            assert!(AM.Base.Reg == 0 && AM.IndexReg == 0);
            AM.Base.Reg = RIP;
        } else {
            AM.GVOpFlags = self.Subtarget.classifyLocalReference(null);
        }
        return true;
    }
    if !AM.GV || !self.Subtarget.isPICStyleRIPRel() {
        let mut GetCallRegForValue: Closure_3 = Closure_3 { cap_0: self };
        if AM.Base.Reg == 0 {
            AM.Base.Reg = GetCallRegForValue.call(V);
            return AM.Base.Reg != 0;
        }
        if AM.IndexReg == 0 {
            assert!(AM.Scale == 1, "Scale with no index!");
            AM.IndexReg = GetCallRegForValue.call(V);
            return AM.IndexReg != 0;
        }
    }
    return false;
}

fn X86FastISel::X86SelectStore(self, I: *Instruction) -> bool {
    let mut S: *StoreInst = cast(I);
    if S.isAtomic() {
        return false;
    }
    let mut PtrV: *Value = I.getOperand(1);
    if self.TLI.supportSwiftError() {
        if dyn_cast(PtrV) {
            Arg;
        } else {
            if Arg.hasSwiftErrorAttr() {
                return false;
            }
        }
        if dyn_cast(PtrV) {
            Alloca;
        } else {
            if Alloca.isSwiftError() {
                return false;
            }
        }
    }
    let mut Val: *Value = S.getValueOperand();
    let mut Ptr: *Value = S.getPointerOperand();
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(Val.getType(), VT, true) {
        return false;
    }
    let mut Alignment: Align = S.getAlign();
    let mut ABIAlignment: Align = self.DL.getABITypeAlign(Val.getType());
    let mut Aligned: bool = Alignment >= ABIAlignment;
    let mut AM: X86AddressMode = X86AddressMode {};
    if !self.X86SelectAddress(Ptr, AM) {
        return false;
    }
    return self.X86FastEmitStore(VT, Val, AM, self.createMachineMemOperandFor(I), Aligned);
}

fn X86FastISel::X86SelectRet(self, I: *Instruction) -> bool {
    let mut Ret: *ReturnInst = cast(I);
    let mut F: *Function = *I.getParent().getParent();
    let mut X86MFInfo: *X86MachineFunctionInfo = self.FuncInfo.MF.getInfo();
    if !self.FuncInfo.CanLowerReturn {
        return false;
    }
    if self.TLI.supportSwiftError() && F.getAttributes().hasAttrSomewhere(SwiftError, null) {
        return false;
    }
    if self.TLI.supportSplitCSR(self.FuncInfo.MF) {
        return false;
    }
    let mut CC: ID = F.getCallingConv();
    if CC != C && CC != Fast && CC != Tail && CC != SwiftTail && CC != X86_FastCall && CC != X86_StdCall && CC != X86_ThisCall && CC != X86_64_SysV && CC != Win64 {
        return false;
    }
    if !isUInt(X86MFInfo.getBytesToPopOnReturn()) {
        return false;
    }
    if (CC == Fast && self.TM.Options.GuaranteedTailCallOpt) || CC == Tail || CC == SwiftTail {
        return false;
    }
    if F.isVarArg() {
        return false;
    }
    let mut RetRegs: SmallVector<Register, 4> = SmallVector<Register, 4> {};
    if Ret.getNumOperands() > 0 {
        let mut Outs: OutputArg, 4> = OutputArg, 4> {};
        GetReturnInfo(CC, F.getReturnType(), F.getAttributes(), Outs, self.TLI, self.DL);
        let mut ValLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
        let mut CCInfo: CCState = CCState { CC, F.isVarArg(), *self.FuncInfo.MF, ValLocs, I.getContext(), false };
        CCInfo.AnalyzeReturn(Outs, RetCC_X86);
        let mut RV: *Value = Ret.getOperand(0);
        let mut Reg: Register = self.getRegForValue(RV);
        if !Reg.operator unsigned int() {
            return false;
        }
        if ValLocs.len != 1 {
            return false;
        }
        let mut VA: *mut CCValAssign = ValLocs[0];
        if VA.getLocInfo() != Full {
            return false;
        }
        if !VA.isRegLoc() {
            return false;
        }
        if VA.getLocReg() == FP0 || VA.getLocReg() == FP1 {
            return false;
        }
        let mut SrcReg: Register = Reg.operator unsigned int() + VA.getValNo();
        let mut SrcVT: EVT = self.TLI.getValueType(self.DL, RV.getType(), false);
        let mut DstVT: EVT = VA.getValVT();
        if SrcVT != DstVT {
            if SrcVT != i1 && SrcVT != i8 && SrcVT != i16 {
                return false;
            }
            if !Outs[0].Flags.isZExt() && !Outs[0].Flags.isSExt() {
                return false;
            }
            if SrcVT == i1 {
                if Outs[0].Flags.isSExt() {
                    return false;
                }
                SrcReg = self.fastEmitZExtFromI1(i8, SrcReg);
                SrcVT = i8;
            }
            if SrcVT != DstVT {
                let mut Op: u32 = if Outs[0].Flags.isZExt() { ZERO_EXTEND } else { SIGN_EXTEND };
                SrcReg = self.fastEmit_r(SrcVT.getSimpleVT(), DstVT.getSimpleVT(), Op, SrcReg);
            }
        }
        let mut DstReg: Register = VA.getLocReg();
        let mut SrcRC: *TargetRegisterClass = self.MRI.getRegClass(SrcReg);
        if !SrcRC.contains(DstReg.operator MCRegister()) {
            return false;
        }
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), DstReg).addReg(SrcReg, RegState {}, 0);
        RetRegs.push(VA.getLocReg());
    }
    if F.hasStructRetAttr() && CC != Swift && CC != SwiftTail {
        let mut Reg: Register = X86MFInfo.getSRetReturnReg();
        assert!(Reg.operator unsigned int(), "SRetReturnReg should have been set in LowerFormalArguments()!");
        let mut RetReg: Register = if self.Subtarget.isTarget64BitLP64() { RAX } else { EAX };
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), RetReg).addReg(Reg, RegState {}, 0);
        RetRegs.push(RetReg);
    }
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    if X86MFInfo.getBytesToPopOnReturn() {
        MIB = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(if self.Subtarget.is64Bit() { RETI64 } else { RETI32 })).addImm(X86MFInfo.getBytesToPopOnReturn());
    } else {
        MIB = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(if self.Subtarget.is64Bit() { RET64 } else { RET32 }));
    }
    for Reg in RetRegs {
        MIB.addReg(Reg, Implicit, 0);
    }
    return true;
}

fn X86FastISel::X86SelectLoad(self, I: *Instruction) -> bool {
    let mut LI: *LoadInst = cast(I);
    if LI.isAtomic() {
        return false;
    }
    let mut SV: *Value = I.getOperand(0);
    if self.TLI.supportSwiftError() {
        if dyn_cast(SV) {
            Arg;
        } else {
            if Arg.hasSwiftErrorAttr() {
                return false;
            }
        }
        if dyn_cast(SV) {
            Alloca;
        } else {
            if Alloca.isSwiftError() {
                return false;
            }
        }
    }
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(LI.getType(), VT, true) {
        return false;
    }
    let mut Ptr: *Value = LI.getPointerOperand();
    let mut AM: X86AddressMode = X86AddressMode {};
    if !self.X86SelectAddress(Ptr, AM) {
        return false;
    }
    let mut ResultReg: Register = 0;
    if !self.X86FastEmitLoad(VT, AM, self.createMachineMemOperandFor(LI), ResultReg, LI.getAlign().value()) {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86ChooseCmpOpcode(VT: EVT, Subtarget: *X86Subtarget) -> u32 {
    let mut HasAVX512: bool = Subtarget.hasAVX512();
    let mut HasAVX: bool = Subtarget.hasAVX();
    let mut HasSSE1: bool = Subtarget.hasSSE1();
    let mut HasSSE2: bool = Subtarget.hasSSE2();
    match VT.getSimpleVT().SimpleTy {
        _ => {
            return 0;
        },
        i8 => {
            return CMP8rr;
        },
        i16 => {
            return CMP16rr;
        },
        i32 => {
            return CMP32rr;
        },
        i64 => {
            return CMP64rr;
        },
        f32 => {
            return if HasAVX512 { VUCOMISSZrr } else { if HasAVX { VUCOMISSrr } else { if HasSSE1 { UCOMISSrr } else { 0 } } };
        },
        f64 => {
            return if HasAVX512 { VUCOMISDZrr } else { if HasAVX { VUCOMISDrr } else { if HasSSE2 { UCOMISDrr } else { 0 } } };
        },
    }
}

fn X86ChooseCmpImmediateOpcode(VT: EVT, RHSC: *ConstantInt) -> u32 {
    match VT.getSimpleVT().SimpleTy {
        _ => {
            return 0;
        },
        i8 => {
            return CMP8ri;
        },
        i16 => {
            return CMP16ri;
        },
        i32 => {
            return CMP32ri;
        },
        i64 => {
            return if isInt(RHSC.getSExtValue()) { CMP64ri32 } else { 0 };
        },
    }
}

fn X86FastISel::X86FastEmitCompare(self, Op0: *Value, Op1: *Value, VT: EVT, CurMIMD: *DebugLoc) -> bool {
    let mut Op0Reg: Register = self.getRegForValue(Op0);
    if !Op0Reg.operator unsigned int() {
        return false;
    }
    if isa(Op1) {
        Op1 = getNullValue(self.DL.getIntPtrType(Op0.getContext(), 0));
    }
    if dyn_cast(Op1) {
        Op1C;
    } else {
        if X86ChooseCmpImmediateOpcode(VT, Op1C) {
            CompareImmOpc;
        } else {
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, MIMetadata { DL: CurMIMD, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CompareImmOpc)).addReg(Op0Reg, RegState {}, 0).addImm(Op1C.getSExtValue());
            return true;
        }
    }
    let mut CompareOpc: u32 = X86ChooseCmpOpcode(VT, self.Subtarget);
    if CompareOpc == 0 {
        return false;
    }
    let mut Op1Reg: Register = self.getRegForValue(Op1);
    if !Op1Reg.operator unsigned int() {
        return false;
    }
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, MIMetadata { DL: CurMIMD, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CompareOpc)).addReg(Op0Reg, RegState {}, 0).addReg(Op1Reg, RegState {}, 0);
    return true;
}

fn X86FastISel::X86SelectCmp(self, I: *Instruction) -> bool {
    let mut CI: *CmpInst = cast(I);
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(I.getOperand(0).getType(), VT, false) {
        return false;
    }
    if VT.isVector() {
        return false;
    }
    let mut Predicate: Predicate = self.optimizeCmpPredicate(CI);
    let mut ResultReg: Register = 0;
    match Predicate {
        _ => {
            break;
        },
        FCMP_FALSE => {
            ResultReg = self.emitMOV32r0();
            ResultReg = self.fastEmitInst_extractsubreg(i8, ResultReg, sub_8bit);
            if !ResultReg.operator unsigned int() {
                return false;
            }
            break;
        },
        FCMP_TRUE => {
            ResultReg = self.createResultReg(&mut GR8RegClass);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MOV8ri), ResultReg).addImm(1);
            break;
        },
    }
    if ResultReg.operator unsigned int() {
        self.updateValueMap(I, ResultReg, 1);
        return true;
    }
    let mut LHS: *Value = CI.getOperand(0);
    let mut RHS: *Value = CI.getOperand(1);
    if Predicate == FCMP_ORD || Predicate == FCMP_UNO {
        let mut RHSC: *ConstantFP const = dyn_cast(RHS);
        if RHSC && RHSC.isNullValue() {
            RHS = LHS;
        }
    }
    let mut SETFOpcTable: [2]u16 = [[COND_E, COND_NP, AND8rr], [COND_NE, COND_P, OR8rr]];
    let mut SETFOpc: *u16 = null;
    match Predicate {
        _ => {
            break;
        },
        FCMP_OEQ => {
            SETFOpc = &mut SETFOpcTable[0][0];
        },
        FCMP_UNE => {
            SETFOpc = &mut SETFOpcTable[1][0];
        },
    }
    ResultReg = self.createResultReg(&mut GR8RegClass);
    if SETFOpc {
        if !self.X86FastEmitCompare(LHS, RHS, VT, I.getDebugLoc()) {
            return false;
        }
        let mut FlagReg1: Register = self.createResultReg(&mut GR8RegClass);
        let mut FlagReg2: Register = self.createResultReg(&mut GR8RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get((if (!self.Subtarget.hasZU() || self.Subtarget.preferLegacySetCC()) { SETCCr } else { SETZUCCr })), FlagReg1).addImm(SETFOpc[0]);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get((if (!self.Subtarget.hasZU() || self.Subtarget.preferLegacySetCC()) { SETCCr } else { SETZUCCr })), FlagReg2).addImm(SETFOpc[1]);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SETFOpc[2]), ResultReg).addReg(FlagReg1, RegState {}, 0).addReg(FlagReg2, RegState {}, 0).setOperandDead(3);
        self.updateValueMap(I, ResultReg, 1);
        return true;
    }
    let mut CC: CondCode = zeroed();
    let mut SwapArgs: bool = false;
    tie(CC, SwapArgs) = getX86ConditionCode(Predicate);
    assert!(CC <= LAST_VALID_COND, "Unexpected condition code.");
    if SwapArgs {
        swap(LHS, RHS);
    }
    if !self.X86FastEmitCompare(LHS, RHS, VT, I.getDebugLoc()) {
        return false;
    }
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get((if (!self.Subtarget.hasZU() || self.Subtarget.preferLegacySetCC()) { SETCCr } else { SETZUCCr })), ResultReg).addImm(CC);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86SelectZExt(self, I: *Instruction) -> bool {
    let mut DstVT: EVT = self.TLI.getValueType(self.DL, I.getType(), false);
    if !self.TLI.isTypeLegal(DstVT) {
        return false;
    }
    let mut ResultReg: Register = self.getRegForValue(I.getOperand(0));
    if !ResultReg.operator unsigned int() {
        return false;
    }
    let mut SrcVT: MVT = self.TLI.getSimpleValueType(self.DL, I.getOperand(0).getType(), false);
    if SrcVT == i1 {
        ResultReg = self.fastEmitZExtFromI1(i8, ResultReg);
        SrcVT = i8;
        if !ResultReg.operator unsigned int() {
            return false;
        }
    }
    if DstVT == i64 {
        let mut MovInst: u32 = 0;
        match SrcVT.SimpleTy {
            i8 => {
                MovInst = MOVZX32rr8;
            },
            i16 => {
                MovInst = MOVZX32rr16;
            },
            i32 => {
                MovInst = MOV32rr;
            },
            _ => {
                llvm_unreachable_internal("Unexpected zext to i64 source type", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 1678);
            },
        }
        let mut Result32: Register = self.createResultReg(&mut GR32RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MovInst), Result32).addReg(ResultReg, RegState {}, 0);
        ResultReg = self.createResultReg(&mut GR64RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), ResultReg).addReg(Result32, RegState {}, 0).addImm(sub_32bit);
    } else if DstVT == i16 {
        let mut Result32: Register = self.createResultReg(&mut GR32RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MOVZX32rr8), Result32).addReg(ResultReg, RegState {}, 0);
        ResultReg = self.fastEmitInst_extractsubreg(i16, Result32, sub_16bit);
    } else if DstVT != i8 {
        ResultReg = self.fastEmit_r(i8, DstVT.getSimpleVT(), ZERO_EXTEND, ResultReg);
        if !ResultReg.operator unsigned int() {
            return false;
        }
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86SelectSExt(self, I: *Instruction) -> bool {
    let mut DstVT: EVT = self.TLI.getValueType(self.DL, I.getType(), false);
    if !self.TLI.isTypeLegal(DstVT) {
        return false;
    }
    let mut ResultReg: Register = self.getRegForValue(I.getOperand(0));
    if !ResultReg.operator unsigned int() {
        return false;
    }
    let mut SrcVT: MVT = self.TLI.getSimpleValueType(self.DL, I.getOperand(0).getType(), false);
    if SrcVT == i1 {
        let mut ZExtReg: Register = self.fastEmitZExtFromI1(i8, ResultReg);
        if !ZExtReg.operator unsigned int() {
            return false;
        }
        ResultReg = self.createResultReg(&mut GR8RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(NEG8r), ResultReg).addReg(ZExtReg, RegState {}, 0).setOperandDead(2);
        SrcVT = i8;
    }
    if DstVT == i16 {
        let mut Result32: Register = self.createResultReg(&mut GR32RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MOVSX32rr8), Result32).addReg(ResultReg, RegState {}, 0);
        ResultReg = self.fastEmitInst_extractsubreg(i16, Result32, sub_16bit);
    } else if DstVT != i8 {
        ResultReg = self.fastEmit_r(i8, DstVT.getSimpleVT(), SIGN_EXTEND, ResultReg);
        if !ResultReg.operator unsigned int() {
            return false;
        }
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86SelectBranch(self, I: *Instruction) -> bool {
    let mut BI: *CondBrInst = cast(I);
    let mut TrueMBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(BI.getSuccessor(0));
    let mut FalseMBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(BI.getSuccessor(1));
    let mut CC: CondCode = zeroed();
    if dyn_cast(BI.getCondition()) {
        CI;
    } else {
        if CI.hasOneUse() && CI.getParent() == I.getParent() {
            let mut VT: EVT = self.TLI.getValueType(self.DL, CI.getOperand(0).getType(), false);
            let mut Predicate: Predicate = self.optimizeCmpPredicate(CI);
            match Predicate {
                _ => {
                    break;
                },
                FCMP_FALSE => {
                    self.fastEmitBranch(FalseMBB, self.MIMD.getDL());
                },
                FCMP_TRUE => {
                    self.fastEmitBranch(TrueMBB, self.MIMD.getDL());
                },
            }
            let mut CmpLHS: *Value = CI.getOperand(0);
            let mut CmpRHS: *Value = CI.getOperand(1);
            if Predicate == FCMP_ORD || Predicate == FCMP_UNO {
                let mut CmpRHSC: *ConstantFP const = dyn_cast(CmpRHS);
                if CmpRHSC && CmpRHSC.isNullValue() {
                    CmpRHS = CmpLHS;
                }
            }
            if self.FuncInfo.MBB.isLayoutSuccessor(TrueMBB) {
                swap(TrueMBB, FalseMBB);
                Predicate = getInversePredicate(Predicate);
            }
            let mut NeedExtraBranch: bool = false;
            match Predicate {
                _ => {
                    break;
                },
                FCMP_OEQ => {
                    swap(TrueMBB, FalseMBB);
                },
                FCMP_UNE => {
                    NeedExtraBranch = true;
                },
            }
            let mut SwapArgs: bool = false;
            tie(CC, SwapArgs) = getX86ConditionCode(Predicate);
            assert!(CC <= LAST_VALID_COND, "Unexpected condition code.");
            if SwapArgs {
                swap(CmpLHS, CmpRHS);
            }
            if !self.X86FastEmitCompare(CmpLHS, CmpRHS, VT, CI.getDebugLoc()) {
                return false;
            }
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(JCC_1)).addMBB(TrueMBB, 0).addImm(CC);
            if NeedExtraBranch {
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(JCC_1)).addMBB(TrueMBB, 0).addImm(COND_P);
            }
            self.finishCondBranch(BI.getParent(), TrueMBB, FalseMBB);
            return true;
        }
    }
    let mut OpReg: Register = self.getRegForValue(BI.getCondition());
    if !OpReg.operator unsigned int() {
        return false;
    }
    if self.MRI.getRegClass(OpReg) == &mut VK1RegClass {
        let mut KOpReg: Register = OpReg;
        OpReg = self.createResultReg(&mut GR32RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), OpReg).addReg(KOpReg, RegState {}, 0);
        OpReg = self.fastEmitInst_extractsubreg(i8, OpReg, sub_8bit);
    }
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(TEST8ri)).addReg(OpReg, RegState {}, 0).addImm(1);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(JCC_1)).addMBB(TrueMBB, 0).addImm(COND_NE);
    self.finishCondBranch(BI.getParent(), TrueMBB, FalseMBB);
    return true;
}

fn X86FastISel::X86SelectShift(self, I: *Instruction) -> bool {
    let mut CReg: Register = 0;
    let mut OpReg: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    if I.getType().isIntegerTy(8) {
        CReg = CL;
        RC = &mut GR8RegClass;
        match I.getOpcode() {
            LShr => {
                OpReg = SHR8rCL;
            },
            AShr => {
                OpReg = SAR8rCL;
            },
            Shl => {
                OpReg = SHL8rCL;
            },
            _ => {
                return false;
            },
        }
    } else if I.getType().isIntegerTy(16) {
        CReg = CX;
        RC = &mut GR16RegClass;
        match I.getOpcode() {
            _ => {
                llvm_unreachable_internal("Unexpected shift opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 1928);
            },
            LShr => {
                OpReg = SHR16rCL;
            },
            AShr => {
                OpReg = SAR16rCL;
            },
            Shl => {
                OpReg = SHL16rCL;
            },
        }
    } else if I.getType().isIntegerTy(32) {
        CReg = ECX;
        RC = &mut GR32RegClass;
        match I.getOpcode() {
            _ => {
                llvm_unreachable_internal("Unexpected shift opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 1937);
            },
            LShr => {
                OpReg = SHR32rCL;
            },
            AShr => {
                OpReg = SAR32rCL;
            },
            Shl => {
                OpReg = SHL32rCL;
            },
        }
    } else if I.getType().isIntegerTy(64) {
        CReg = RCX;
        RC = &mut GR64RegClass;
        match I.getOpcode() {
            _ => {
                llvm_unreachable_internal("Unexpected shift opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 1946);
            },
            LShr => {
                OpReg = SHR64rCL;
            },
            AShr => {
                OpReg = SAR64rCL;
            },
            Shl => {
                OpReg = SHL64rCL;
            },
        }
    } else {
        return false;
    }
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), VT, false) {
        return false;
    }
    let mut Op0Reg: Register = self.getRegForValue(I.getOperand(0));
    if !Op0Reg.operator unsigned int() {
        return false;
    }
    let mut Op1Reg: Register = self.getRegForValue(I.getOperand(1));
    if !Op1Reg.operator unsigned int() {
        return false;
    }
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), CReg).addReg(Op1Reg, RegState {}, 0);
    if CReg != CL {
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(KILL), CL).addReg(CReg, Kill, 0);
    }
    let mut ResultReg: Register = self.createResultReg(RC);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(OpReg), ResultReg).addReg(Op0Reg, RegState {}, 0).setOperandDead(2);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86SelectMul(self, I: *Instruction) -> bool {
    if !I.getType().isIntegerTy(8) {
        return false;
    }
    let mut LHSReg: Register = self.getRegForValue(I.getOperand(0));
    if !LHSReg.operator unsigned int() {
        return false;
    }
    let mut RHSReg: Register = self.getRegForValue(I.getOperand(1));
    if !RHSReg.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = self.X86FastEmitMul(MUL8r, i8, AL, LHSReg, RHSReg, false);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86SelectDivRem(self, I: *Instruction) -> bool {
    let mut NumTypes: u32 = 4;
    let mut NumOps: u32 = 4;
    let mut S: bool = true;
    let mut U: bool = false;
    let mut Copy: u32 = COPY;
    let mut OpTable: [4]DivRemEntry = [DivRemEntry { &mut GR8RegClass, AX, 0, [DivRemResult { IDIV8r, 0, MOVSX16rr8, AL, S }, DivRemResult { IDIV8r, 0, MOVSX16rr8, AH, S }, DivRemResult { DIV8r, 0, MOVZX16rr8, AL, U }, DivRemResult { DIV8r, 0, MOVZX16rr8, AH, U }] }, DivRemEntry { &mut GR16RegClass, AX, DX, [DivRemResult { IDIV16r, CWD, Copy, AX, S }, DivRemResult { IDIV16r, CWD, Copy, DX, S }, DivRemResult { DIV16r, MOV32r0, Copy, AX, U }, DivRemResult { DIV16r, MOV32r0, Copy, DX, U }] }, DivRemEntry { &mut GR32RegClass, EAX, EDX, [DivRemResult { IDIV32r, CDQ, Copy, EAX, S }, DivRemResult { IDIV32r, CDQ, Copy, EDX, S }, DivRemResult { DIV32r, MOV32r0, Copy, EAX, U }, DivRemResult { DIV32r, MOV32r0, Copy, EDX, U }] }, DivRemEntry { &mut GR64RegClass, RAX, RDX, [DivRemResult { IDIV64r, CQO, Copy, RAX, S }, DivRemResult { IDIV64r, CQO, Copy, RDX, S }, DivRemResult { DIV64r, MOV32r0, Copy, RAX, U }, DivRemResult { DIV64r, MOV32r0, Copy, RDX, U }] }];
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), VT, false) {
        return false;
    }
    let mut TypeIndex: u32 = 0;
    let mut OpIndex: u32 = 0;
    match VT.SimpleTy {
        _ => {
            return false;
        },
        i8 => {
            TypeIndex = 0;
        },
        i16 => {
            TypeIndex = 1;
        },
        i32 => {
            TypeIndex = 2;
        },
        i64 => {
            TypeIndex = 3;
        },
    }
    match I.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected div/rem opcode", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 2080);
        },
        SDiv => {
            OpIndex = 0;
        },
        SRem => {
            OpIndex = 1;
        },
        UDiv => {
            OpIndex = 2;
        },
        URem => {
            OpIndex = 3;
        },
    }
    let mut TypeEntry: *DivRemEntry = OpTable[TypeIndex];
    let mut OpEntry: *DivRemResult = TypeEntry.ResultTable[OpIndex];
    let mut Op0Reg: Register = self.getRegForValue(I.getOperand(0));
    if !Op0Reg.operator unsigned int() {
        return false;
    }
    let mut Op1Reg: Register = self.getRegForValue(I.getOperand(1));
    if !Op1Reg.operator unsigned int() {
        return false;
    }
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(OpEntry.OpCopy), TypeEntry.LowInReg).addReg(Op0Reg, RegState {}, 0);
    if OpEntry.OpSignExtend {
        if OpEntry.IsOpSigned {
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(OpEntry.OpSignExtend));
        } else {
            let mut Zero32: Register = self.emitMOV32r0();
            if VT == i16 {
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Copy), TypeEntry.HighInReg).addReg(Zero32, RegState {}, sub_16bit);
            } else if VT == i32 {
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Copy), TypeEntry.HighInReg).addReg(Zero32, RegState {}, 0);
            } else if VT == i64 {
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), TypeEntry.HighInReg).addReg(Zero32, RegState {}, 0).addImm(sub_32bit);
            }
        }
    }
    let mut UseAXForRem: bool = (I.getOpcode() == SRem || I.getOpcode() == URem) && OpEntry.DivRemResultReg == AH && self.Subtarget.is64Bit();
    let mut UsedReg: Register = if UseAXForRem { AX } else { OpEntry.DivRemResultReg };
    operator(BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(OpEntry.OpDivRem)).addReg(Op1Reg, RegState {}, 0)).setPhysRegsDeadExcept(UsedReg, self.TRI);
    let mut ResultReg: Register = 0;
    if UseAXForRem {
        let mut SourceSuperReg: Register = self.createResultReg(&mut GR16RegClass);
        let mut ResultSuperReg: Register = self.createResultReg(&mut GR16RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Copy), SourceSuperReg).addReg(AX, RegState {}, 0);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SHR16ri), ResultSuperReg).addReg(SourceSuperReg, RegState {}, 0).addImm(8).setOperandDead(3);
        ResultReg = self.fastEmitInst_extractsubreg(i8, ResultSuperReg, sub_8bit);
    }
    if !ResultReg.operator unsigned int() {
        ResultReg = self.createResultReg(TypeEntry.RC);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Copy), ResultReg).addReg(OpEntry.DivRemResultReg, RegState {}, 0);
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86FastEmitCMoveSelect(self, RetVT: MVT, I: *Instruction) -> bool {
    if !self.Subtarget.canUseCMOV() {
        return false;
    }
    if RetVT < i16 || RetVT > i64 {
        return false;
    }
    let mut Cond: *Value = I.getOperand(0);
    let mut RC: *TargetRegisterClass = self.TLI.getRegClassFor(RetVT, false);
    let mut NeedTest: bool = true;
    let mut CC: CondCode = COND_NE;
    let mut CI: *CmpInst const = dyn_cast(Cond);
    if CI && (CI.getParent() == I.getParent()) {
        let mut Predicate: Predicate = self.optimizeCmpPredicate(CI);
        let mut SETFOpcTable: [2]u16 = [[COND_NP, COND_E, TEST8rr], [COND_P, COND_NE, OR8rr]];
        let mut SETFOpc: *u16 = null;
        match Predicate {
            _ => {
                break;
            },
            FCMP_OEQ => {
                SETFOpc = &mut SETFOpcTable[0][0];
            },
            FCMP_UNE => {
                SETFOpc = &mut SETFOpcTable[1][0];
            },
        }
        let mut NeedSwap: bool = false;
        tie(CC, NeedSwap) = getX86ConditionCode(Predicate);
        assert!(CC <= LAST_VALID_COND, "Unexpected condition code.");
        let mut CmpLHS: *Value = CI.getOperand(0);
        let mut CmpRHS: *Value = CI.getOperand(1);
        if NeedSwap {
            swap(CmpLHS, CmpRHS);
        }
        let mut CmpVT: EVT = self.TLI.getValueType(self.DL, CmpLHS.getType(), false);
        if !self.X86FastEmitCompare(CmpLHS, CmpRHS, CmpVT, CI.getDebugLoc()) {
            return false;
        }
        if SETFOpc {
            let mut FlagReg1: Register = self.createResultReg(&mut GR8RegClass);
            let mut FlagReg2: Register = self.createResultReg(&mut GR8RegClass);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get((if (!self.Subtarget.hasZU() || self.Subtarget.preferLegacySetCC()) { SETCCr } else { SETZUCCr })), FlagReg1).addImm(SETFOpc[0]);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get((if (!self.Subtarget.hasZU() || self.Subtarget.preferLegacySetCC()) { SETCCr } else { SETZUCCr })), FlagReg2).addImm(SETFOpc[1]);
            let mut II: *MCInstrDesc = self.TII.get(SETFOpc[2]);
            if II.getNumDefs() {
                let mut TmpReg: Register = self.createResultReg(&mut GR8RegClass);
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II, TmpReg).addReg(FlagReg2, RegState {}, 0).addReg(FlagReg1, RegState {}, 0);
            } else {
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II).addReg(FlagReg2, RegState {}, 0).addReg(FlagReg1, RegState {}, 0);
            }
        }
        NeedTest = false;
    } else if self.foldX86XALUIntrinsic(CC, I, Cond) {
        let mut TmpReg: Register = self.getRegForValue(Cond);
        if !TmpReg.operator unsigned int() {
            return false;
        }
        NeedTest = false;
    }
    if NeedTest {
        let mut CondReg: Register = self.getRegForValue(Cond);
        if !CondReg.operator unsigned int() {
            return false;
        }
        if self.MRI.getRegClass(CondReg) == &mut VK1RegClass {
            let mut KCondReg: Register = CondReg;
            CondReg = self.createResultReg(&mut GR32RegClass);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), CondReg).addReg(KCondReg, RegState {}, 0);
            CondReg = self.fastEmitInst_extractsubreg(i8, CondReg, sub_8bit);
        }
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(TEST8ri)).addReg(CondReg, RegState {}, 0).addImm(1);
    }
    let mut LHS: *Value = I.getOperand(1);
    let mut RHS: *Value = I.getOperand(2);
    let mut RHSReg: Register = self.getRegForValue(RHS);
    let mut LHSReg: Register = self.getRegForValue(LHS);
    if !LHSReg.operator unsigned int() || !RHSReg.operator unsigned int() {
        return false;
    }
    let mut TRI: *TargetRegisterInfo = *self.Subtarget.getRegisterInfo();
    let mut Opc: u32 = getCMovOpcode(TRI.getRegSizeInBits(*RC).operator unsigned long long() / 8, false, self.Subtarget.hasNDD());
    let mut ResultReg: Register = self.fastEmitInst_rri(Opc, RC, RHSReg, LHSReg, CC);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86FastEmitSSESelect(self, RetVT: MVT, I: *Instruction) -> bool {
    let mut CI: *FCmpInst const = dyn_cast(I.getOperand(0));
    if !CI || (CI.getParent() != I.getParent()) {
        return false;
    }
    if I.getType() != CI.getOperand(0).getType() || !((self.Subtarget.hasSSE1() && RetVT == f32) || (self.Subtarget.hasSSE2() && RetVT == f64)) {
        return false;
    }
    let mut CmpLHS: *Value = CI.getOperand(0);
    let mut CmpRHS: *Value = CI.getOperand(1);
    let mut Predicate: Predicate = self.optimizeCmpPredicate(CI);
    if Predicate == FCMP_ORD || Predicate == FCMP_UNO {
        let mut CmpRHSC: *ConstantFP const = dyn_cast(CmpRHS);
        if CmpRHSC && CmpRHSC.isNullValue() {
            CmpRHS = CmpLHS;
        }
    }
    let mut CC: u32 = 0;
    let mut NeedSwap: bool = false;
    tie(CC, NeedSwap) = getX86SSEConditionCode(Predicate);
    if CC > 7 && !self.Subtarget.hasAVX() {
        return false;
    }
    if NeedSwap {
        swap(CmpLHS, CmpRHS);
    }
    let mut LHS: *Value = I.getOperand(1);
    let mut RHS: *Value = I.getOperand(2);
    let mut LHSReg: Register = self.getRegForValue(LHS);
    let mut RHSReg: Register = self.getRegForValue(RHS);
    let mut CmpLHSReg: Register = self.getRegForValue(CmpLHS);
    let mut CmpRHSReg: Register = self.getRegForValue(CmpRHS);
    if !LHSReg.operator unsigned int() || !RHSReg.operator unsigned int() || !CmpLHSReg.operator unsigned int() || !CmpRHSReg.operator unsigned int() {
        return false;
    }
    let mut RC: *TargetRegisterClass = self.TLI.getRegClassFor(RetVT, false);
    let mut ResultReg: Register = 0;
    if self.Subtarget.hasAVX512() {
        let mut VR128X: *TargetRegisterClass = &mut VR128XRegClass;
        let mut VK1: *TargetRegisterClass = &mut VK1RegClass;
        let mut CmpOpcode: u32 = if (RetVT == f32) { VCMPSSZrri } else { VCMPSDZrri };
        let mut CmpReg: Register = self.fastEmitInst_rri(CmpOpcode, VK1, CmpLHSReg, CmpRHSReg, CC);
        let mut ImplicitDefReg: Register = self.createResultReg(VR128X);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(IMPLICIT_DEF), ImplicitDefReg);
        let mut MovOpcode: u32 = if (RetVT == f32) { VMOVSSZrrk } else { VMOVSDZrrk };
        let mut MovReg: Register = self.fastEmitInst_rrrr(MovOpcode, VR128X, RHSReg, CmpReg, ImplicitDefReg, LHSReg);
        ResultReg = self.createResultReg(RC);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(MovReg, RegState {}, 0);
    } else if self.Subtarget.hasAVX() {
        let mut VR128: *TargetRegisterClass = &mut VR128RegClass;
        let mut CmpOpcode: u32 = if (RetVT == f32) { VCMPSSrri } else { VCMPSDrri };
        let mut BlendOpcode: u32 = if (RetVT == f32) { VBLENDVPSrrr } else { VBLENDVPDrrr };
        let mut CmpReg: Register = self.fastEmitInst_rri(CmpOpcode, RC, CmpLHSReg, CmpRHSReg, CC);
        let mut VBlendReg: Register = self.fastEmitInst_rrr(BlendOpcode, VR128, RHSReg, LHSReg, CmpReg);
        ResultReg = self.createResultReg(RC);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(VBlendReg, RegState {}, 0);
    } else {
        let mut OpcTable: [2]u16 = [[CMPSSrri, ANDPSrr, ANDNPSrr, ORPSrr], [CMPSDrri, ANDPDrr, ANDNPDrr, ORPDrr]];
        let mut Opc: *u16 = null;
        match RetVT.SimpleTy {
            _ => {
                return false;
            },
            f32 => {
                Opc = &mut OpcTable[0][0];
            },
            f64 => {
                Opc = &mut OpcTable[1][0];
            },
        }
        let mut VR128: *TargetRegisterClass = &mut VR128RegClass;
        let mut CmpReg: Register = self.fastEmitInst_rri(Opc[0], RC, CmpLHSReg, CmpRHSReg, CC);
        let mut AndReg: Register = self.fastEmitInst_rr(Opc[1], VR128, CmpReg, LHSReg);
        let mut AndNReg: Register = self.fastEmitInst_rr(Opc[2], VR128, CmpReg, RHSReg);
        let mut OrReg: Register = self.fastEmitInst_rr(Opc[3], VR128, AndNReg, AndReg);
        ResultReg = self.createResultReg(RC);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(OrReg, RegState {}, 0);
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86FastEmitPseudoSelect(self, RetVT: MVT, I: *Instruction) -> bool {
    let mut Opc: u32 = 0;
    match RetVT.SimpleTy {
        _ => {
            return false;
        },
        i8 => {
            Opc = CMOV_GR8;
        },
        i16 => {
            Opc = CMOV_GR16;
        },
        i32 => {
            Opc = CMOV_GR32;
        },
        f16 => {
            Opc = if self.Subtarget.hasAVX512() { CMOV_FR16X } else { CMOV_FR16 };
        },
        f32 => {
            Opc = if self.Subtarget.hasAVX512() { CMOV_FR32X } else { CMOV_FR32 };
        },
        f64 => {
            Opc = if self.Subtarget.hasAVX512() { CMOV_FR64X } else { CMOV_FR64 };
        },
    }
    let mut Cond: *Value = I.getOperand(0);
    let mut CC: CondCode = COND_NE;
    let mut CI: *CmpInst const = dyn_cast(Cond);
    if CI && (CI.getParent() == I.getParent()) {
        let mut NeedSwap: bool = false;
        tie(CC, NeedSwap) = getX86ConditionCode(CI.getPredicate());
        if CC > LAST_VALID_COND {
            return false;
        }
        let mut CmpLHS: *Value = CI.getOperand(0);
        let mut CmpRHS: *Value = CI.getOperand(1);
        if NeedSwap {
            swap(CmpLHS, CmpRHS);
        }
        let mut CmpVT: EVT = self.TLI.getValueType(self.DL, CmpLHS.getType(), false);
        if !self.X86FastEmitCompare(CmpLHS, CmpRHS, CmpVT, CI.getDebugLoc()) {
            return false;
        }
    } else {
        let mut CondReg: Register = self.getRegForValue(Cond);
        if !CondReg.operator unsigned int() {
            return false;
        }
        if self.MRI.getRegClass(CondReg) == &mut VK1RegClass {
            let mut KCondReg: Register = CondReg;
            CondReg = self.createResultReg(&mut GR32RegClass);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), CondReg).addReg(KCondReg, RegState {}, 0);
            CondReg = self.fastEmitInst_extractsubreg(i8, CondReg, sub_8bit);
        }
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(TEST8ri)).addReg(CondReg, RegState {}, 0).addImm(1);
    }
    let mut LHS: *Value = I.getOperand(1);
    let mut RHS: *Value = I.getOperand(2);
    let mut LHSReg: Register = self.getRegForValue(LHS);
    let mut RHSReg: Register = self.getRegForValue(RHS);
    if !LHSReg.operator unsigned int() || !RHSReg.operator unsigned int() {
        return false;
    }
    let mut RC: *TargetRegisterClass = self.TLI.getRegClassFor(RetVT, false);
    let mut ResultReg: Register = self.fastEmitInst_rri(Opc, RC, RHSReg, LHSReg, CC);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86SelectSelect(self, I: *Instruction) -> bool {
    let mut RetVT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), RetVT, false) {
        return false;
    }
    if dyn_cast(I.getOperand(0)) {
        CI;
    } else {
        let mut Predicate: Predicate = self.optimizeCmpPredicate(CI);
        let mut Opnd: *Value = null;
        match Predicate {
            _ => {
                break;
            },
            FCMP_FALSE => {
                Opnd = I.getOperand(2);
            },
            FCMP_TRUE => {
                Opnd = I.getOperand(1);
            },
        }
        if Opnd {
            let mut OpReg: Register = self.getRegForValue(Opnd);
            if !OpReg.operator unsigned int() {
                return false;
            }
            let mut RC: *TargetRegisterClass = self.TLI.getRegClassFor(RetVT, false);
            let mut ResultReg: Register = self.createResultReg(RC);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(OpReg, RegState {}, 0);
            self.updateValueMap(I, ResultReg, 1);
            return true;
        }
    }
    if self.X86FastEmitCMoveSelect(RetVT, I) {
        return true;
    }
    if self.X86FastEmitSSESelect(RetVT, I) {
        return true;
    }
    if self.X86FastEmitPseudoSelect(RetVT, I) {
        return true;
    }
    return false;
}

fn X86FastISel::X86SelectIntToFP(self, I: *Instruction, IsSigned: bool) -> bool {
    let mut HasAVX512: bool = self.Subtarget.hasAVX512();
    if !self.Subtarget.hasAVX() || (!IsSigned && !HasAVX512) {
        return false;
    }
    let mut SrcVT: EVT = self.TLI.getValueType(self.DL, I.getOperand(0).getType(), false);
    if SrcVT != i32 && SrcVT != i64 {
        return false;
    }
    let mut OpReg: Register = self.getRegForValue(I.getOperand(0));
    if !OpReg.operator unsigned int() {
        return false;
    }
    let mut Opcode: u32 = 0;
    let mut SCvtOpc: [2]u16 = [[[VCVTSI2SSrr, VCVTSI642SSrr], [VCVTSI2SDrr, VCVTSI642SDrr]], [[VCVTSI2SSZrr, VCVTSI642SSZrr], [VCVTSI2SDZrr, VCVTSI642SDZrr]]];
    let mut UCvtOpc: [2]u16 = [[VCVTUSI2SSZrr, VCVTUSI642SSZrr], [VCVTUSI2SDZrr, VCVTUSI642SDZrr]];
    let mut Is64Bit: bool = SrcVT == i64;
    if I.getType().isDoubleTy() {
        Opcode = if IsSigned { SCvtOpc[HasAVX512][1][Is64Bit] } else { UCvtOpc[1][Is64Bit] };
    } else if I.getType().isFloatTy() {
        Opcode = if IsSigned { SCvtOpc[HasAVX512][0][Is64Bit] } else { UCvtOpc[0][Is64Bit] };
    } else {
        return false;
    }
    let mut DstVT: MVT = self.TLI.getValueType(self.DL, I.getType(), false).getSimpleVT();
    let mut RC: *TargetRegisterClass = self.TLI.getRegClassFor(DstVT, false);
    let mut ImplicitDefReg: Register = self.createResultReg(RC);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(IMPLICIT_DEF), ImplicitDefReg);
    let mut ResultReg: Register = self.fastEmitInst_rr(Opcode, RC, ImplicitDefReg, OpReg);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86SelectSIToFP(self, I: *Instruction) -> bool {
    return self.X86SelectIntToFP(I, true);
}

fn X86FastISel::X86SelectUIToFP(self, I: *Instruction) -> bool {
    return self.X86SelectIntToFP(I, false);
}

fn X86FastISel::X86SelectFPExtOrFPTrunc(self, I: *Instruction, TargetOpc: u32, RC: *TargetRegisterClass) -> bool {
    assert!((I.getOpcode() == FPExt || I.getOpcode() == FPTrunc), "Instruction must be an FPExt or FPTrunc!");
    let mut HasAVX: bool = self.Subtarget.hasAVX();
    let mut OpReg: Register = self.getRegForValue(I.getOperand(0));
    if !OpReg.operator unsigned int() {
        return false;
    }
    let mut ImplicitDefReg: Register = 0;
    if HasAVX {
        ImplicitDefReg = self.createResultReg(RC);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(IMPLICIT_DEF), ImplicitDefReg);
    }
    let mut ResultReg: Register = self.createResultReg(RC);
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    MIB = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(TargetOpc), ResultReg);
    if HasAVX {
        MIB.addReg(ImplicitDefReg, RegState {}, 0);
    }
    MIB.addReg(OpReg, RegState {}, 0);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86SelectFPExt(self, I: *Instruction) -> bool {
    if self.Subtarget.hasSSE2() && I.getType().isDoubleTy() && I.getOperand(0).getType().isFloatTy() {
        let mut HasAVX512: bool = self.Subtarget.hasAVX512();
        let mut Opc: u32 = if HasAVX512 { VCVTSS2SDZrr } else { if self.Subtarget.hasAVX() { VCVTSS2SDrr } else { CVTSS2SDrr } };
        return self.X86SelectFPExtOrFPTrunc(I, Opc, self.TLI.getRegClassFor(f64, false));
    }
    return false;
}

fn X86FastISel::X86SelectFPTrunc(self, I: *Instruction) -> bool {
    if self.Subtarget.hasSSE2() && I.getType().isFloatTy() && I.getOperand(0).getType().isDoubleTy() {
        let mut HasAVX512: bool = self.Subtarget.hasAVX512();
        let mut Opc: u32 = if HasAVX512 { VCVTSD2SSZrr } else { if self.Subtarget.hasAVX() { VCVTSD2SSrr } else { CVTSD2SSrr } };
        return self.X86SelectFPExtOrFPTrunc(I, Opc, self.TLI.getRegClassFor(f32, false));
    }
    return false;
}

fn X86FastISel::X86SelectTrunc(self, I: *Instruction) -> bool {
    let mut SrcVT: EVT = self.TLI.getValueType(self.DL, I.getOperand(0).getType(), false);
    let mut DstVT: EVT = self.TLI.getValueType(self.DL, I.getType(), false);
    if DstVT != i8 && DstVT != i1 {
        return false;
    }
    if !self.TLI.isTypeLegal(SrcVT) {
        return false;
    }
    let mut InputReg: Register = self.getRegForValue(I.getOperand(0));
    if !InputReg.operator unsigned int() {
        return false;
    }
    if SrcVT == i8 {
        self.updateValueMap(I, InputReg, 1);
        return true;
    }
    let mut ResultReg: Register = self.fastEmitInst_extractsubreg(i8, InputReg, sub_8bit);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::X86SelectBitCast(self, I: *Instruction) -> bool {
    let mut SrcVT: MVT = MVT {};
    let mut DstVT: MVT = MVT {};
    if !self.Subtarget.hasSSE2() || !self.isTypeLegal(I.getOperand(0).getType(), SrcVT, false) || !self.isTypeLegal(I.getType(), DstVT, false) {
        return false;
    }
    if !SrcVT.isVector() || !DstVT.isVector() || SrcVT.getVectorElementType() == i1 || DstVT.getVectorElementType() == i1 {
        return false;
    }
    let mut Reg: Register = self.getRegForValue(I.getOperand(0));
    if !Reg.operator unsigned int() {
        return false;
    }
    let mut DstClass: *TargetRegisterClass = self.TLI.getRegClassFor(DstVT, false);
    let mut ResultReg: Register = self.createResultReg(DstClass);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(Reg, RegState {}, 0);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn X86FastISel::IsMemcpySmall(self, Len: u64) -> bool {
    return Len <= (if self.Subtarget.is64Bit() { 32 } else { 16 });
}

fn X86FastISel::TryEmitSmallMemcpy(self, DestAM: X86AddressMode, SrcAM: X86AddressMode, Len: u64) -> bool {
    if !self.IsMemcpySmall(Len) {
        return false;
    }
    let mut i64Legal: bool = self.Subtarget.is64Bit();
    while Len {
        let mut VT: MVT = MVT {};
        if Len >= 8 && i64Legal {
            VT = i64;
        } else if Len >= 4 {
            VT = i32;
        } else if Len >= 2 {
            VT = i16;
        } else {
            VT = i8;
        }
        let mut Reg: Register = 0;
        let mut RV: bool = self.X86FastEmitLoad(VT, SrcAM, null, Reg, 1);
        RV &= self.X86FastEmitStore(VT, Reg, DestAM, null, false);
        assert!(RV, "Failed to emit load or store??");
        RV as void;
        let mut Size: u32 = VT.getSizeInBits().operator unsigned long long() / 8;
        Len -= Size;
        DestAM.Disp += Size;
        SrcAM.Disp += Size;
    }
    return true;
}

fn X86FastISel::X86FastEmitAddSub_rr(self, BaseOpc: u32, VT: MVT, LHSReg: Register, RHSReg: Register) -> Register {
    let mut Opc: [2]u16 = [[[ADD8rr, ADD16rr, ADD32rr, ADD64rr], [ADD8rr_ND, ADD16rr_ND, ADD32rr_ND, ADD64rr_ND]], [[SUB8rr, SUB16rr, SUB32rr, SUB64rr], [SUB8rr_ND, SUB16rr_ND, SUB32rr_ND, SUB64rr_ND]]];
    let mut IsSub: bool = BaseOpc == SUB;
    let mut TypeIdx: u32 = VT.SimpleTy - i8;
    return self.X86FastEmitLiveEFLAGS_rr(Opc[IsSub][self.Subtarget.hasNDD()][TypeIdx], self.TLI.getRegClassFor(VT, false), LHSReg, RHSReg);
}

fn X86FastISel::X86FastEmitAddSub_ri(self, BaseOpc: u32, VT: MVT, LHSReg: Register, CI: *ConstantInt, CondCode: u32) -> Register {
    let mut IsSub: bool = BaseOpc == SUB;
    let mut TypeIdx: u32 = VT.SimpleTy - i8;
    if CI.isOne() && CondCode == COND_O {
        let mut IncDecOpc: [2]u16 = [[INC8r, INC16r, INC32r, INC64r], [DEC8r, DEC16r, DEC32r, DEC64r]];
        let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(VT, false));
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(IncDecOpc[IsSub][TypeIdx]), ResultReg).addReg(LHSReg, RegState {}, 0);
        return ResultReg;
    }
    if VT == i64 && !isInt(CI.getSExtValue()) {
        return Register { Reg: 0 };
    }
    let mut Opc: [2]u16 = [[[ADD8ri, ADD16ri, ADD32ri, ADD64ri32], [ADD8ri_ND, ADD16ri_ND, ADD32ri_ND, ADD64ri32_ND]], [[SUB8ri, SUB16ri, SUB32ri, SUB64ri32], [SUB8ri_ND, SUB16ri_ND, SUB32ri_ND, SUB64ri32_ND]]];
    return self.X86FastEmitLiveEFLAGS_ri(Opc[IsSub][self.Subtarget.hasNDD()][TypeIdx], self.TLI.getRegClassFor(VT, false), LHSReg, CI.getZExtValue());
}

fn X86FastISel::fastLowerIntrinsicCall(self, II: *IntrinsicInst) -> bool {
    match II.getIntrinsicID() {
        _ => {
            return false;
        },
        frameaddress => {
            let mut MF: *mut MachineFunction = self.FuncInfo.MF;
            if MF.getTarget().getMCAsmInfo().usesWindowsCFI() {
                return false;
            }
            let mut RetTy: *mut Type = II.getCalledFunction().getReturnType();
            let mut VT: MVT = MVT {};
            if !self.isTypeLegal(RetTy, VT, false) {
                return false;
            }
            let mut Opc: u32 = 0;
            let mut RC: *TargetRegisterClass = null;
            match VT.SimpleTy {
                _ => {
                    llvm_unreachable_internal("Invalid result type for frameaddress.", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 2837);
                },
                i32 => {
                    Opc = MOV32rm;
                },
                i64 => {
                    Opc = MOV64rm;
                },
            }
            let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
            MFI.setFrameAddressIsTaken(true);
            let mut RegInfo: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
            let mut FrameReg: Register = RegInfo.getPtrSizedFrameRegister(*MF);
            assert!(((FrameReg == RBP && VT == i64) || (FrameReg == EBP && VT == i32)), "Invalid Frame Register!");
            let mut SrcReg: Register = self.createResultReg(RC);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), SrcReg).addReg(FrameReg, RegState {}, 0);
            let mut Depth: u32 = cast(II.getOperand(0)).getZExtValue();
            while Depth -= 1 {
                let mut DestReg: Register = self.createResultReg(RC);
                addDirectMem(BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), DestReg), SrcReg);
                SrcReg = DestReg;
            }
            self.updateValueMap(II, SrcReg, 1);
            return true;
        },
        memcpy => {
            let mut MCI: *MemCpyInst = cast(II);
            if MCI.isVolatile() {
                return false;
            }
            if isa(MCI.getLength()) {
                let mut Len: u64 = cast(MCI.getLength()).getZExtValue();
                if self.IsMemcpySmall(Len) {
                    let mut DestAM: X86AddressMode = X86AddressMode {};
                    let mut SrcAM: X86AddressMode = X86AddressMode {};
                    if !self.X86SelectAddress(MCI.getRawDest(), DestAM) || !self.X86SelectAddress(MCI.getRawSource(), SrcAM) {
                        return false;
                    }
                    self.TryEmitSmallMemcpy(DestAM, SrcAM, Len);
                    return true;
                }
            }
            let mut SizeWidth: u32 = if self.Subtarget.is64Bit() { 64 } else { 32 };
            if !MCI.getLength().getType().isIntegerTy(SizeWidth) {
                return false;
            }
            if MCI.getSourceAddressSpace() > 255 || MCI.getDestAddressSpace() > 255 {
                return false;
            }
            return self.lowerCallTo(II, "memcpy", II.arg_size() - 1);
        },
        memset => {
            let mut MSI: *MemSetInst = cast(II);
            if MSI.isVolatile() {
                return false;
            }
            let mut SizeWidth: u32 = if self.Subtarget.is64Bit() { 64 } else { 32 };
            if !MSI.getLength().getType().isIntegerTy(SizeWidth) {
                return false;
            }
            if MSI.getDestAddressSpace() > 255 {
                return false;
            }
            return self.lowerCallTo(II, "memset", II.arg_size() - 1);
        },
        stackprotector => {
            let mut PtrTy: EVT = self.TLI.getPointerTy(self.DL, 0);
            let mut Op1: *Value = II.getArgOperand(0);
            let mut Slot: *AllocaInst = cast(II.getArgOperand(1));
            self.MFI.setStackProtectorIndex(self.FuncInfo.StaticAllocaMap[Slot]);
            let mut AM: X86AddressMode = X86AddressMode {};
            if !self.X86SelectAddress(Slot, AM) {
                return false;
            }
            if !self.X86FastEmitStore(PtrTy, Op1, AM, null, false) {
                return false;
            }
            return true;
        },
        dbg_declare => {
            let mut DI: *DbgDeclareInst = cast(II);
            let mut AM: X86AddressMode = X86AddressMode {};
            assert!(DI.getAddress(), "Null address should be checked earlier!");
            if !self.X86SelectAddress(DI.getAddress(), AM) {
                return false;
            }
            let mut II: *MCInstrDesc = self.TII.get(DBG_VALUE);
            assert!(DI.getVariable().isValidLocationForIntrinsic(self.MIMD.getDL().operator llvm::DILocation *()), "Expected inlined-at fields to agree");
            self.addFullAddress(BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II), AM).addImm(0).addMetadata(DI.getVariable()).addMetadata(DI.getExpression());
            return true;
        },
        trap => {
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(TRAP));
            return true;
        },
        sqrt => {
            if !self.Subtarget.hasSSE1() {
                return false;
            }
            let mut RetTy: *mut Type = II.getCalledFunction().getReturnType();
            let mut VT: MVT = MVT {};
            if !self.isTypeLegal(RetTy, VT, false) {
                return false;
            }
            let mut SqrtOpc: [3]u16 = [[SQRTSSr, SQRTSDr], [VSQRTSSr, VSQRTSDr], [VSQRTSSZr, VSQRTSDZr]];
            let mut AVXLevel: u32 = if self.Subtarget.hasAVX512() { 2 } else { if self.Subtarget.hasAVX() { 1 } else { 0 } };
            let mut Opc: u32 = 0;
            match VT.SimpleTy {
                _ => {
                    return false;
                },
                f32 => {
                    Opc = SqrtOpc[AVXLevel][0];
                },
                f64 => {
                    Opc = SqrtOpc[AVXLevel][1];
                },
            }
            let mut SrcVal: *Value = II.getArgOperand(0);
            let mut SrcReg: Register = self.getRegForValue(SrcVal);
            if !SrcReg.operator unsigned int() {
                return false;
            }
            let mut RC: *TargetRegisterClass = self.TLI.getRegClassFor(VT, false);
            let mut ImplicitDefReg: Register = 0;
            if AVXLevel > 0 {
                ImplicitDefReg = self.createResultReg(RC);
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(IMPLICIT_DEF), ImplicitDefReg);
            }
            let mut ResultReg: Register = self.createResultReg(RC);
            let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
            MIB = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg);
            if ImplicitDefReg.operator unsigned int() {
                MIB.addReg(ImplicitDefReg, RegState {}, 0);
            }
            MIB.addReg(SrcReg, RegState {}, 0);
            self.updateValueMap(II, ResultReg, 1);
            return true;
        },
        sadd_with_overflow => {
            uadd_with_overflow;
        },
        x86_sse_cvttss2si => {
            x86_sse_cvttss2si64;
        },
        x86_sse42_crc32_32_8 => {
            x86_sse42_crc32_32_16;
        },
    }
}

fn X86FastISel::fastLowerArguments(self) -> bool {
    if !self.FuncInfo.CanLowerReturn {
        return false;
    }
    let mut F: *Function = self.FuncInfo.Fn;
    if F.isVarArg() {
        return false;
    }
    let mut CC: ID = F.getCallingConv();
    if CC != C {
        return false;
    }
    if self.Subtarget.isCallingConvWin64(CC) {
        return false;
    }
    if !self.Subtarget.is64Bit() {
        return false;
    }
    if self.Subtarget.useSoftFloat() {
        return false;
    }
    let mut GPRCnt: u32 = 0;
    let mut FPRCnt: u32 = 0;
    for Arg in F.args() {
        if Arg.hasAttribute(ByVal) || Arg.hasAttribute(InReg) || Arg.hasAttribute(StructRet) || Arg.hasAttribute(SwiftSelf) || Arg.hasAttribute(SwiftAsync) || Arg.hasAttribute(SwiftError) || Arg.hasAttribute(Nest) {
            return false;
        }
        let mut ArgTy: *mut Type = Arg.getType();
        if ArgTy.isStructTy() || ArgTy.isArrayTy() || ArgTy.isVectorTy() {
            return false;
        }
        let mut ArgVT: EVT = self.TLI.getValueType(self.DL, ArgTy, false);
        if !ArgVT.isSimple() {
            return false;
        }
        match ArgVT.getSimpleVT().SimpleTy {
            _ => {
                return false;
            },
            i32 => {
                i64;
            },
            f32 => {
                f64;
            },
        }
        if GPRCnt > 6 {
            return false;
        }
        if FPRCnt > 8 {
            return false;
        }
    }
    let mut GPR32ArgRegs: [6]MCPhysReg = [EDI, ESI, EDX, ECX, R8D, R9D];
    let mut GPR64ArgRegs: [6]MCPhysReg = [RDI, RSI, RDX, RCX, R8, R9];
    let mut XMMArgRegs: [8]MCPhysReg = [XMM0, XMM1, XMM2, XMM3, XMM4, XMM5, XMM6, XMM7];
    let mut GPRIdx: u32 = 0;
    let mut FPRIdx: u32 = 0;
    for Arg in F.args() {
        let mut VT: MVT = self.TLI.getSimpleValueType(self.DL, Arg.getType(), false);
        let mut RC: *TargetRegisterClass = self.TLI.getRegClassFor(VT, false);
        let mut SrcReg: MCRegister = 0;
        match VT.SimpleTy {
            _ => {
                llvm_unreachable_internal("Unexpected value type.", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 3319);
            },
            i32 => {
                SrcReg = GPR32ArgRegs[GPRIdx += 1];
            },
            i64 => {
                SrcReg = GPR64ArgRegs[GPRIdx += 1];
            },
            f32 => {
                
            },
            f64 => {
                SrcReg = XMMArgRegs[FPRIdx += 1];
            },
        }
        let mut DstReg: Register = self.FuncInfo.MF.addLiveIn(SrcReg, RC);
        let mut ResultReg: Register = self.createResultReg(RC);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(DstReg, getKillRegState(true), 0);
        self.updateValueMap(&mut Arg, ResultReg, 1);
    }
    return true;
}

fn computeBytesPoppedByCalleeForSRet(Subtarget: *X86Subtarget, CC: ID, CB: *CallBase) -> u32 {
    if Subtarget.is64Bit() {
        return 0;
    }
    if Subtarget.getTargetTriple().isOSMSVCRT() {
        return 0;
    }
    if CC == Fast || CC == GHC || CC == HiPE || CC == Tail || CC == SwiftTail {
        return 0;
    }
    if CB {
        if CB.arg_empty() || !CB.paramHasAttr(0, StructRet) || CB.paramHasAttr(0, InReg) || Subtarget.isTargetMCU() {
            return 0;
        }
    }
    return 4;
}

fn X86FastISel::fastLowerCall(self, CLI: *mut CallLoweringInfo) -> bool {
    let mut OutVals: *mut SmallVector<Value *, 16> = CLI.OutVals;
    let mut OutFlags: *mut ArgFlagsTy, 16> = CLI.OutFlags;
    let mut OutRegs: *mut SmallVector<Register, 16> = CLI.OutRegs;
    let mut Ins: *mut InputArg, 4> = CLI.Ins;
    let mut InRegs: *mut SmallVector<Register, 4> = CLI.InRegs;
    let mut CC: ID = CLI.CallConv;
    let mut IsTailCall: *mut bool = CLI.IsTailCall;
    let mut IsVarArg: bool = CLI.IsVarArg;
    let mut Callee: *Value = CLI.Callee;
    let mut Symbol: *mut MCSymbol = CLI.Symbol;
    let mut CB: *CallBase = CLI.CB;
    let mut Is64Bit: bool = self.Subtarget.is64Bit();
    let mut IsWin64: bool = self.Subtarget.isCallingConvWin64(CC);
    let mut RetTys: SmallVector<Type *> = SmallVector<Type *> {};
    ComputeValueTypes(self.DL, CLI.RetTy, RetTys, null, getZero());
    for RetTy in RetTys {
        let mut RetVT: MVT = Other;
        if !self.isTypeLegal(RetTy, RetVT, false) {
            if RetVT == Other {
                return false;
            }
            let mut ABIVT: MVT = self.TLI.getRegisterTypeForCallingConv(CLI.RetTy.getContext(), CLI.CallConv, RetVT);
            let mut RegVT: MVT = self.TLI.getRegisterType(CLI.RetTy.getContext(), RetVT);
            if ABIVT != RegVT {
                return false;
            }
        }
    }
    if CB && CB.doesNoCfCheck() {
        return false;
    }
    if (CB && isa(CB) && CB.hasFnAttr("no_caller_saved_registers")) {
        return false;
    }
    if (CB && CB.hasFnAttr("no_callee_saved_registers")) {
        return false;
    }
    if CB && CB.isIndirectCall() && CB.getOperandBundle(OB_kcfi) {
        return false;
    }
    if self.Subtarget.useIndirectThunkCalls() {
        return false;
    }
    match CC {
        _ => {
            return false;
        },
        C => {
            Fast;
        },
    }
    if IsTailCall {
        return false;
    }
    if (CC == Fast && self.TM.Options.GuaranteedTailCallOpt) || CC == Tail || CC == SwiftTail {
        return false;
    }
    if IsVarArg && IsWin64 {
        return false;
    }
    if CLI.CB && CLI.CB.hasInAllocaArgument() {
        return false;
    }
    for Flag in CLI.OutFlags {
        if Flag.isSwiftError() || Flag.isPreallocated() {
            return false;
        }
    }
    if Is64Bit && self.MF.getFunction().getParent().getModuleFlag("import-call-optimization") {
        return false;
    }
    let mut OutVTs: SmallVector<MVT, 16> = SmallVector<MVT, 16> {};
    let mut ArgTys: SmallVector<Type *, 16> = SmallVector<Type *, 16> {};
    let mut ArgRegs: SmallVector<Register, 16> = SmallVector<Register, 16> {};
    for let mut i: i32 = 0;
let mut e: i32 = OutVals.len; i != e; i += 1 {
        let mut Val: *mut *mut Value = OutVals[i];
        let mut Flags: ArgFlagsTy = OutFlags[i];
        if dyn_cast(Val) {
            CI;
        } else {
            if CI.getBitWidth() < 32 {
                if Flags.isSExt() {
                    Val = get(CI.getContext(), CI.getValue().sext(32));
                } else {
                    Val = get(CI.getContext(), CI.getValue().zext(32));
                }
            }
        }
        let mut VT: MVT = MVT {};
        let mut TI: *mut TruncInst = dyn_cast(Val);
        let mut ResultReg: Register = 0;
        if TI && TI.getType().isIntegerTy(1) && CLI.CB && (TI.getParent() == CLI.CB.getParent()) && TI.hasOneUse() {
            let mut PrevVal: *mut Value = TI.getOperand(0);
            ResultReg = self.getRegForValue(PrevVal);
            if !ResultReg.operator unsigned int() {
                return false;
            }
            if !self.isTypeLegal(PrevVal.getType(), VT, false) {
                return false;
            }
            ResultReg = self.fastEmit_ri(VT, VT, AND, ResultReg, 1);
        } else {
            if !self.isTypeLegal(Val.getType(), VT, false) || VT.isVectorOf(i1) {
                return false;
            }
            ResultReg = self.getRegForValue(Val);
        }
        if !ResultReg.operator unsigned int() {
            return false;
        }
        ArgRegs.push(ResultReg);
        OutVTs.push(VT);
        ArgTys.push(Val.getType());
    }
    let mut ArgLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CC, IsVarArg, *self.FuncInfo.MF, ArgLocs, CLI.RetTy.getContext(), false };
    if IsWin64 {
        CCInfo.AllocateStack(32, 8);
    }
    CCInfo.AnalyzeCallOperands(OutVTs, OutFlags, ArgTys, CC_X86);
    let mut NumBytes: u32 = CCInfo.getAlignedCallFrameSize();
    let mut AdjStackDown: u32 = self.TII.getCallFrameSetupOpcode();
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(AdjStackDown)).addImm(NumBytes).addImm(0).addImm(0).setOperandDead(4);
    let mut RegInfo: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    for VA in ArgLocs {
        let mut ArgVal: *Value = OutVals[VA.getValNo()];
        let mut ArgVT: MVT = OutVTs[VA.getValNo()];
        if ArgVT == x86mmx {
            return false;
        }
        let mut ArgReg: Register = ArgRegs[VA.getValNo()];
        match VA.getLocInfo() {
            Full => {
                break;
            },
            SExt => {
                assert!(VA.getLocVT().isInteger() && !VA.getLocVT().isVector(), "Unexpected extend");
                if ArgVT == i1 {
                    return false;
                }
                let mut Emitted: bool = self.X86FastEmitExtend(SIGN_EXTEND, VA.getLocVT(), ArgReg, ArgVT, ArgReg);
                assert!(Emitted, "Failed to emit a sext!");
                Emitted as void;
                ArgVT = VA.getLocVT();
                break;
            },
            ZExt => {
                assert!(VA.getLocVT().isInteger() && !VA.getLocVT().isVector(), "Unexpected extend");
                if ArgVT == i1 {
                    ArgReg = self.fastEmitZExtFromI1(i8, ArgReg);
                    ArgVT = i8;
                    if !ArgReg.operator unsigned int() {
                        return false;
                    }
                }
                let mut Emitted: bool = self.X86FastEmitExtend(ZERO_EXTEND, VA.getLocVT(), ArgReg, ArgVT, ArgReg);
                assert!(Emitted, "Failed to emit a zext!");
                Emitted as void;
                ArgVT = VA.getLocVT();
                break;
            },
            AExt => {
                assert!(VA.getLocVT().isInteger() && !VA.getLocVT().isVector(), "Unexpected extend");
                let mut Emitted: bool = self.X86FastEmitExtend(ANY_EXTEND, VA.getLocVT(), ArgReg, ArgVT, ArgReg);
                if !Emitted {
                    Emitted = self.X86FastEmitExtend(ZERO_EXTEND, VA.getLocVT(), ArgReg, ArgVT, ArgReg);
                }
                if !Emitted {
                    Emitted = self.X86FastEmitExtend(SIGN_EXTEND, VA.getLocVT(), ArgReg, ArgVT, ArgReg);
                }
                assert!(Emitted, "Failed to emit a aext!");
                Emitted as void;
                ArgVT = VA.getLocVT();
                break;
            },
            BCvt => {
                ArgReg = self.fastEmit_r(ArgVT, VA.getLocVT(), BITCAST, ArgReg);
                assert!(ArgReg.operator unsigned int(), "Failed to emit a bitcast!");
                ArgVT = VA.getLocVT();
                break;
            },
            VExt => {
                return false;
            },
            AExtUpper => {
                SExtUpper;
            },
            Indirect => {
                return false;
            },
        }
        if VA.isRegLoc() {
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), VA.getLocReg()).addReg(ArgReg, RegState {}, 0);
            OutRegs.push(VA.getLocReg());
        } else {
            assert!(VA.isMemLoc(), "Unknown value location!");
            if isa(ArgVal) {
                continue;
            }
            let mut LocMemOffset: u32 = VA.getLocMemOffset();
            let mut AM: X86AddressMode = X86AddressMode {};
            AM.Base.Reg = RegInfo.getStackRegister();
            AM.Disp = LocMemOffset;
            let mut Flags: ArgFlagsTy = OutFlags[VA.getValNo()];
            let mut Alignment: Align = self.DL.getABITypeAlign(ArgVal.getType());
            let mut MMO: *mut MachineMemOperand = self.FuncInfo.MF.getMachineMemOperand(getStack(*self.FuncInfo.MF, LocMemOffset, 0), MOStore, ArgVT.getStoreSize(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
            if Flags.isByVal() {
                let mut SrcAM: X86AddressMode = X86AddressMode {};
                SrcAM.Base.Reg = ArgReg;
                if !self.TryEmitSmallMemcpy(AM, SrcAM, Flags.getByValSize()) {
                    return false;
                }
            } else if isa(ArgVal) || isa(ArgVal) {
                if !self.X86FastEmitStore(ArgVT, ArgVal, AM, MMO, false) {
                    return false;
                }
            } else {
                if !self.X86FastEmitStore(ArgVT, ArgReg, AM, MMO, false) {
                    return false;
                }
            }
        }
    }
    if self.Subtarget.isPICStyleGOT() {
        let mut Base: Register = self.getInstrInfo().getGlobalBaseReg(self.FuncInfo.MF);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), EBX).addReg(Base, RegState {}, 0);
    }
    if Is64Bit && IsVarArg && !IsWin64 {
        let mut XMMArgRegs: [8]MCPhysReg = [XMM0, XMM1, XMM2, XMM3, XMM4, XMM5, XMM6, XMM7];
        let mut NumXMMRegs: u32 = CCInfo.getFirstUnallocated(XMMArgRegs);
        assert!((self.Subtarget.hasSSE1() || !NumXMMRegs), "SSE registers cannot be used when SSE is disabled");
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MOV8ri), AL).addImm(NumXMMRegs);
    }
    let mut CalleeAM: X86AddressMode = X86AddressMode {};
    if !self.X86SelectCallAddress(Callee, CalleeAM) {
        return false;
    }
    let mut CalleeOp: Register = 0;
    let mut GV: *GlobalValue = null;
    if CalleeAM.GV != null {
        GV = CalleeAM.GV;
    } else if CalleeAM.Base.Reg.operator unsigned int() {
        CalleeOp = CalleeAM.Base.Reg;
    } else {
        return false;
    }
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    if CalleeOp.operator unsigned int() {
        let mut CallOpc: u32 = if Is64Bit { CALL64r } else { CALL32r };
        MIB = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(CallOpc)).addReg(CalleeOp, RegState {}, 0);
    } else {
        assert!(GV, "Not a direct call");
        let mut OpFlags: u8 = self.Subtarget.classifyGlobalFunctionReference(GV);
        if OpFlags == MO_PLT && !Is64Bit && self.TM.getRelocationModel() == Static && isa(GV) && cast(GV).isIntrinsic() {
            OpFlags = MO_NO_FLAG;
        }
        let mut NeedLoad: bool = OpFlags == MO_DLLIMPORT || OpFlags == MO_GOTPCREL || OpFlags == MO_GOTPCREL_NORELAX || OpFlags == MO_COFFSTUB;
        let mut CallOpc: u32 = if NeedLoad { (if Is64Bit { CALL64m } else { CALL32m }) } else { (if Is64Bit { CALL64pcrel32 } else { CALLpcrel32 }) };
        MIB = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(CallOpc));
        if NeedLoad {
            MIB.addReg(if Is64Bit { RIP } else { NoRegister }, RegState {}, 0).addImm(1).addReg(0, RegState {}, 0);
        }
        if Symbol {
            MIB.addSym(Symbol, OpFlags);
        } else {
            MIB.addGlobalAddress(GV, 0, OpFlags);
        }
        if NeedLoad {
            MIB.addReg(0, RegState {}, 0);
        }
    }
    MIB.addRegMask(self.TRI.getCallPreservedMask(*self.FuncInfo.MF, CC));
    if self.Subtarget.isPICStyleGOT() {
        MIB.addReg(EBX, Implicit, 0);
    }
    if Is64Bit && IsVarArg && !IsWin64 {
        MIB.addReg(AL, Implicit, 0);
    }
    for Reg in OutRegs {
        MIB.addReg(Reg, Implicit, 0);
    }
    let mut NumBytesForCalleeToPop: u32 = if isCalleePop(CC, self.Subtarget.is64Bit(), IsVarArg, self.TM.Options.GuaranteedTailCallOpt) { NumBytes } else { computeBytesPoppedByCalleeForSRet(self.Subtarget, CC, CLI.CB) };
    let mut AdjStackUp: u32 = self.TII.getCallFrameDestroyOpcode();
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(AdjStackUp)).addImm(NumBytes).addImm(NumBytesForCalleeToPop).setOperandDead(3);
    let mut RVLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCRetInfo: CCState = CCState { CC, IsVarArg, *self.FuncInfo.MF, RVLocs, CLI.RetTy.getContext(), false };
    CCRetInfo.AnalyzeCallResult(Ins, RetCC_X86);
    let mut ResultReg: Register = self.FuncInfo.CreateRegs(CLI.RetTy, false);
    for let mut i: u32 = 0; i != RVLocs.len; i += 1 {
        let mut VA: *mut CCValAssign = RVLocs[i];
        let mut CopyVT: EVT = VA.getValVT();
        let mut CopyReg: Register = ResultReg.operator unsigned int() + i;
        let mut SrcReg: Register = VA.getLocReg();
        if (CopyVT == f32 || CopyVT == f64) && ((Is64Bit || Ins[i].Flags.isInReg()) && !self.Subtarget.hasSSE1()) {
            report_fatal_error("SSE register return with SSE disabled", true);
        }
        if (SrcReg == FP0 || SrcReg == FP1) && self.isScalarFPTypeInSSEReg(VA.getValVT()) {
            CopyVT = f80;
            CopyReg = self.createResultReg(&mut RFP80RegClass);
        }
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), CopyReg).addReg(SrcReg, RegState {}, 0);
        InRegs.push(VA.getLocReg());
        if CopyVT != VA.getValVT() {
            let mut ResVT: EVT = VA.getValVT();
            let mut Opc: u32 = if ResVT == f32 { ST_Fp80m32 } else { ST_Fp80m64 };
            let mut MemSize: u32 = ResVT.getSizeInBits().operator unsigned long long() / 8;
            let mut FI: i32 = self.MFI.CreateStackObject(MemSize, MemSize, false, null, 0);
            addFrameReference(BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc)), FI, 0).addReg(CopyReg, RegState {}, 0);
            Opc = if ResVT == f32 { MOVSSrm_alt } else { MOVSDrm_alt };
            addFrameReference(BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg.operator unsigned int() + i), FI, 0);
        }
    }
    CLI.ResultReg = ResultReg;
    CLI.NumResultRegs = RVLocs.len;
    CLI.Call = MIB.operator llvm::MachineInstr *();
    if self.TM.Options.EmitCallGraphSection && CB && CB.isIndirectCall() {
        let mut CSInfo: CallSiteInfo = *CB;
        self.MF.addCallSiteInfo(CLI.Call, move(CSInfo));
    }
    return true;
}

fn X86FastISel::fastSelectInstruction(self, I: *Instruction) -> bool {
    match I.getOpcode() {
        _ => {
            break;
        },
        Load => {
            return self.X86SelectLoad(I);
        },
        Store => {
            return self.X86SelectStore(I);
        },
        Ret => {
            return self.X86SelectRet(I);
        },
        ICmp => {
            FCmp;
        },
        ZExt => {
            return self.X86SelectZExt(I);
        },
        SExt => {
            return self.X86SelectSExt(I);
        },
        CondBr => {
            return self.X86SelectBranch(I);
        },
        LShr => {
            AShr;
        },
        Mul => {
            return self.X86SelectMul(I);
        },
        SDiv => {
            UDiv;
        },
        Select => {
            return self.X86SelectSelect(I);
        },
        Trunc => {
            return self.X86SelectTrunc(I);
        },
        FPExt => {
            return self.X86SelectFPExt(I);
        },
        FPTrunc => {
            return self.X86SelectFPTrunc(I);
        },
        SIToFP => {
            return self.X86SelectSIToFP(I);
        },
        UIToFP => {
            return self.X86SelectUIToFP(I);
        },
        IntToPtr => {
            PtrToInt;
        },
        BitCast => {
            return self.X86SelectBitCast(I);
        },
    }
    return false;
}

fn X86FastISel::emitMOV32r0(self) -> Register {
    let mut ResultReg: Register = self.createResultReg(&mut GR32RegClass);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MOV32r0), ResultReg).setOperandDead(1);
    return ResultReg;
}

fn X86FastISel::X86MaterializeInt(self, CI: *ConstantInt, VT: MVT) -> Register {
    if VT > i64 {
        return Register { Reg: 0 };
    }
    let mut Imm: u64 = CI.getZExtValue();
    if Imm == 0 {
        let mut SrcReg: Register = self.emitMOV32r0();
        match VT.SimpleTy {
            _ => {
                llvm_unreachable_internal("Unexpected value type", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 3911);
            },
            i1 => {
                i8;
            },
            i16 => {
                return self.fastEmitInst_extractsubreg(i16, SrcReg, sub_16bit);
            },
            i32 => {
                return SrcReg;
            },
            i64 => {
                let mut ResultReg: Register = self.createResultReg(&mut GR64RegClass);
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), ResultReg).addReg(SrcReg, RegState {}, 0).addImm(sub_32bit);
                return ResultReg;
            },
        }
    }
    let mut Opc: u32 = 0;
    match VT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected value type", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86FastISel.cpp", 3932);
        },
        i1 => {
            VT = i8;
        },
        i8 => {
            Opc = MOV8ri;
        },
        i16 => {
            Opc = MOV16ri;
        },
        i32 => {
            Opc = MOV32ri;
        },
        i64 => {
            Opc = getMOVriOpcode(true, Imm);
        },
    }
    return self.fastEmitInst_i(Opc, self.TLI.getRegClassFor(VT, false), Imm);
}

fn X86FastISel::X86MaterializeFP(self, CFP: *ConstantFP, VT: MVT) -> Register {
    if CFP.isNullValue() {
        return self.fastMaterializeFloatZero(CFP);
    }
    let mut CM: Model = self.TM.getCodeModel();
    if CM != Small && CM != Medium && CM != Large {
        return Register { Reg: 0 };
    }
    let mut Opc: u32 = 0;
    let mut HasSSE1: bool = self.Subtarget.hasSSE1();
    let mut HasSSE2: bool = self.Subtarget.hasSSE2();
    let mut HasAVX: bool = self.Subtarget.hasAVX();
    let mut HasAVX512: bool = self.Subtarget.hasAVX512();
    match VT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        f32 => {
            Opc = if HasAVX512 { VMOVSSZrm_alt } else { if HasAVX { VMOVSSrm_alt } else { if HasSSE1 { MOVSSrm_alt } else { LD_Fp32m } } };
        },
        f64 => {
            Opc = if HasAVX512 { VMOVSDZrm_alt } else { if HasAVX { VMOVSDrm_alt } else { if HasSSE2 { MOVSDrm_alt } else { LD_Fp64m } } };
        },
        f80 => {
            return Register { Reg: 0 };
        },
    }
    let mut Alignment: Align = self.DL.getPrefTypeAlign(CFP.getType());
    let mut PICBase: Register = 0;
    let mut OpFlag: u8 = self.Subtarget.classifyLocalReference(null);
    if OpFlag == MO_PIC_BASE_OFFSET {
        PICBase = self.getInstrInfo().getGlobalBaseReg(self.FuncInfo.MF);
    } else if OpFlag == MO_GOTOFF {
        PICBase = self.getInstrInfo().getGlobalBaseReg(self.FuncInfo.MF);
    } else if self.Subtarget.is64Bit() && self.TM.getCodeModel() != Large {
        PICBase = RIP;
    }
    let mut CPI: u32 = self.MCP.getConstantPoolIndex(CFP, Alignment);
    let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(VT.SimpleTy, false));
    if self.Subtarget.is64Bit() && CM == Large {
        let mut AddrReg: Register = self.createResultReg(&mut GR64RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MOV64ri), AddrReg).addConstantPoolIndex(CPI, 0, OpFlag);
        let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg);
        addRegReg(MIB, AddrReg, false, NoSubRegister, PICBase, false, NoSubRegister);
        let mut MMO: *mut MachineMemOperand = self.FuncInfo.MF.getMachineMemOperand(getConstantPool(*self.FuncInfo.MF), MOLoad, self.DL.getPointerSize(0), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
        operator(MIB).addMemOperand(*self.FuncInfo.MF, MMO);
        return ResultReg;
    }
    addConstantPoolReference(BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg), CPI, PICBase, OpFlag);
    return ResultReg;
}

fn X86FastISel::X86MaterializeGV(self, GV: *GlobalValue, VT: MVT) -> Register {
    if self.TM.getCodeModel() != Small && self.TM.getCodeModel() != Medium {
        return Register { Reg: 0 };
    }
    if self.TM.isLargeGlobalValue(GV) {
        return Register { Reg: 0 };
    }
    let mut AM: X86AddressMode = X86AddressMode {};
    if self.X86SelectAddress(GV, AM) {
        if AM.BaseType == RegBase && AM.IndexReg == 0 && AM.Disp == 0 && AM.GV == null {
            return AM.Base.Reg;
        }
        let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(VT, false));
        if self.TM.getRelocationModel() == Static && self.TLI.getPointerTy(self.DL, 0) == i64 {
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MOV64ri), ResultReg).addGlobalAddress(GV, 0, 0);
        } else {
            let mut Opc: u32 = if self.TLI.getPointerTy(self.DL, 0) == i32 { (if self.Subtarget.isTarget64BitILP32() { LEA64_32r } else { LEA32r }) } else { LEA64r };
            self.addFullAddress(BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg), AM);
        }
        return ResultReg;
    }
    return Register { Reg: 0 };
}

fn X86FastISel::fastMaterializeConstant(self, C: *Constant) -> Register {
    let mut CEVT: EVT = self.TLI.getValueType(self.DL, C.getType(), true);
    if !CEVT.isSimple() {
        return Register { Reg: 0 };
    }
    let mut VT: MVT = CEVT.getSimpleVT();
    if dyn_cast(C) {
        CI;
    } else {
        return self.X86MaterializeInt(CI, VT);
    }
    if dyn_cast(C) {
        CFP;
    } else {
        return self.X86MaterializeFP(CFP, VT);
    }
    if dyn_cast(C) {
        GV;
    } else {
        return self.X86MaterializeGV(GV, VT);
    }
    if isa(C) {
        let mut Opc: u32 = 0;
        match VT.SimpleTy {
            _ => {
                break;
            },
            f32 => {
                if !self.Subtarget.hasSSE1() {
                    Opc = LD_Fp032;
                }
            },
            f64 => {
                if !self.Subtarget.hasSSE2() {
                    Opc = LD_Fp064;
                }
            },
            f80 => {
                Opc = LD_Fp080;
            },
        }
        if Opc {
            let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(VT, false));
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg);
            return ResultReg;
        }
    }
    return Register { Reg: 0 };
}

fn X86FastISel::fastMaterializeAlloca(self, C: *AllocaInst) -> Register {
    if !self.FuncInfo.StaticAllocaMap.count(C) {
        return Register { Reg: 0 };
    }
    assert!(C.isStaticAlloca(), "dynamic alloca in the static alloca map?");
    let mut AM: X86AddressMode = X86AddressMode {};
    if !self.X86SelectAddress(C, AM) {
        return Register { Reg: 0 };
    }
    let mut Opc: u32 = if self.TLI.getPointerTy(self.DL, 0) == i32 { (if self.Subtarget.isTarget64BitILP32() { LEA64_32r } else { LEA32r }) } else { LEA64r };
    let mut RC: *TargetRegisterClass = self.TLI.getRegClassFor(self.TLI.getPointerTy(self.DL, 0), false);
    let mut ResultReg: Register = self.createResultReg(RC);
    self.addFullAddress(BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg), AM);
    return ResultReg;
}

fn X86FastISel::fastMaterializeFloatZero(self, CF: *ConstantFP) -> Register {
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(CF.getType(), VT, false) {
        return Register { Reg: 0 };
    }
    let mut HasSSE1: bool = self.Subtarget.hasSSE1();
    let mut HasSSE2: bool = self.Subtarget.hasSSE2();
    let mut HasAVX512: bool = self.Subtarget.hasAVX512();
    let mut Opc: u32 = 0;
    match VT.SimpleTy {
        _ => {
            return 0;
        },
        f16 => {
            Opc = if HasAVX512 { AVX512_FsFLD0SH } else { FsFLD0SH };
        },
        f32 => {
            Opc = if HasAVX512 { AVX512_FsFLD0SS } else { if HasSSE1 { FsFLD0SS } else { LD_Fp032 } };
        },
        f64 => {
            Opc = if HasAVX512 { AVX512_FsFLD0SD } else { if HasSSE2 { FsFLD0SD } else { LD_Fp064 } };
        },
        f80 => {
            return Register { Reg: 0 };
        },
    }
    let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(VT, false));
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg);
    return ResultReg;
}

fn X86FastISel::tryToFoldLoadIntoMI(self, MI: *mut MachineInstr, OpNo: u32, LI: *LoadInst) -> bool {
    let mut Ptr: *Value = LI.getPointerOperand();
    let mut AM: X86AddressMode = X86AddressMode {};
    if !self.X86SelectAddress(Ptr, AM) {
        return false;
    }
    let mut XII: *X86InstrInfo = self.TII as X86InstrInfo;
    let mut Size: u32 = self.DL.getTypeAllocSize(LI.getType()).operator unsigned long long();
    let mut AddrOps: SmallVector<MachineOperand, 8> = SmallVector<MachineOperand, 8> {};
    AM.getFullAddress(AddrOps);
    let mut CopyMI: *mut MachineInstr = null;
    let mut Result: *mut MachineInstr = XII.foldMemoryOperandImpl(*self.FuncInfo.MF, *MI, OpNo, AddrOps, self.FuncInfo.InsertPt, Size, LI.getAlign(), true, CopyMI, null);
    if !Result {
        return false;
    }
    let mut OperandNo: u32 = 0;
    for let mut I: mop_iterator = Result.operands_begin();
let mut E: mop_iterator = Result.operands_end(); I != E; I += 1 , OperandNo += 1 {
        let mut MO: *mut MachineOperand = *I;
        if !MO.isReg() || MO.isDef() || MO.getReg() != AM.IndexReg {
            continue;
        }
        let mut IndexReg: Register = self.constrainOperandRegClass(Result.getDesc(), MO.getReg(), OperandNo);
        if IndexReg == MO.getReg() {
            continue;
        }
        MO.setReg(IndexReg);
    }
    if MI.isCall(AnyInBundle) {
        self.FuncInfo.MF.moveAdditionalCallInfo(MI, Result);
    }
    Result.addMemOperand(*self.FuncInfo.MF, self.createMachineMemOperandFor(LI));
    Result.cloneInstrSymbols(*self.FuncInfo.MF, *MI);
    let mut I: iterator = MI;
    self.removeDeadCode(I, next(I, 1));
    return true;
}

fn X86FastISel::fastEmitInst_rrrr(self, MachineInstOpcode: u32, RC: *TargetRegisterClass, Op0: Register, Op1: Register, Op2: Register, Op3: Register) -> Register {
    let mut II: *MCInstrDesc = self.TII.get(MachineInstOpcode);
    let mut ResultReg: Register = self.createResultReg(RC);
    Op0 = self.constrainOperandRegClass(II, Op0, II.getNumDefs());
    Op1 = self.constrainOperandRegClass(II, Op1, II.getNumDefs() + 1);
    Op2 = self.constrainOperandRegClass(II, Op2, II.getNumDefs() + 2);
    Op3 = self.constrainOperandRegClass(II, Op3, II.getNumDefs() + 3);
    assert!(II.getNumDefs() >= 1, "instruction must define the result");
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II, ResultReg).addReg(Op0, RegState {}, 0).addReg(Op1, RegState {}, 0).addReg(Op2, RegState {}, 0).addReg(Op3, RegState {}, 0);
    return ResultReg;
}

fn createFastISel(funcInfo: *mut FunctionLoweringInfo, libInfo: *TargetLibraryInfo, libcallLowering: *LibcallLoweringInfo) -> *mut FastISel {
    return X86FastISel { funcInfo, libInfo, libcallLowering };
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Succ: *BasicBlock) -> bool {
        return !Succ.phis().is_empty();
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, V: *mut Value) -> bool {
        return isa(V);
    }

struct Closure_3 {
    cap_0: *mut X86FastISel,
}

fn Closure_3::call(self: *Closure_3, V: *Value) -> Register {
            let mut Reg: Register = self.getRegForValue(V);
            if Reg.operator unsigned int() && self.Subtarget.isTarget64BitILP32() {
                let mut CopyReg: Register = self.createResultReg(&mut GR32RegClass);
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MOV32rr), CopyReg).addReg(Reg, RegState {}, 0);
                let mut ExtReg: Register = self.createResultReg(&mut GR64RegClass);
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), ExtReg).addReg(CopyReg, RegState {}, 0).addImm(sub_32bit);
                Reg = ExtReg;
            }
            return Reg;
        }
