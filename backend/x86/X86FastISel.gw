fn X86FastISel::fastEmit_ISD_ABS_r(self, VT: MVT, RetVT: MVT, Op0: Register) -> Register {
    match VT.SimpleTy {
        v16i8 => {
            return self.fastEmit_ISD_ABS_MVT_v16i8_r(RetVT, Op0);
        },
        v32i8 => {
            return self.fastEmit_ISD_ABS_MVT_v32i8_r(RetVT, Op0);
        },
        v64i8 => {
            return self.fastEmit_ISD_ABS_MVT_v64i8_r(RetVT, Op0);
        },
        v8i16 => {
            return self.fastEmit_ISD_ABS_MVT_v8i16_r(RetVT, Op0);
        },
        v16i16 => {
            return self.fastEmit_ISD_ABS_MVT_v16i16_r(RetVT, Op0);
        },
        v32i16 => {
            return self.fastEmit_ISD_ABS_MVT_v32i16_r(RetVT, Op0);
        },
        v4i32 => {
            return self.fastEmit_ISD_ABS_MVT_v4i32_r(RetVT, Op0);
        },
        v8i32 => {
            return self.fastEmit_ISD_ABS_MVT_v8i32_r(RetVT, Op0);
        },
        v16i32 => {
            return self.fastEmit_ISD_ABS_MVT_v16i32_r(RetVT, Op0);
        },
        v2i64 => {
            return self.fastEmit_ISD_ABS_MVT_v2i64_r(RetVT, Op0);
        },
        v4i64 => {
            return self.fastEmit_ISD_ABS_MVT_v4i64_r(RetVT, Op0);
        },
        v8i64 => {
            return self.fastEmit_ISD_ABS_MVT_v8i64_r(RetVT, Op0);
        },
        _ => {
            return Register { Reg: 0 };
        },
    }
}

fn X86FastISel::fastEmit_ISD_ANY_EXTEND_MVT_i8_r(self, RetVT: MVT, Op0: Register) -> Register {
    if RetVT.SimpleTy != i32 {
        return Register { Reg: 0 };
    }
    return self.fastEmitInst_r(MOVZX32rr8, &mut GR32RegClass, Op0);
}

fn X86FastISel::fastEmit_ISD_ANY_EXTEND_r(self, VT: MVT, RetVT: MVT, Op0: Register) -> Register {
    match VT.SimpleTy {
        i8 => {
