    MRI: *mut MachineRegisterInfo,
    TII: *X86InstrInfo,
    TRI: *X86RegisterInfo,
    BlockedLoadsStoresPairs: pair<MachineInstr *, MachineInstr *>, 2>,
    ForRemoval: SmallVector<MachineInstr *, 2>,
    AA: *mut AliasAnalysis,
}

