static mut ID: i8 = 0;

fn createX86AvoidStoreForwardingBlocksLegacyPass() -> *mut FunctionPass {
    return X86AvoidSFBLegacy {};
}

fn isXMMLoadOpcode(Opcode: u32) -> bool {}

fn isYMMLoadOpcode(Opcode: u32) -> bool {}

fn isPotentialBlockedMemCpyLd(Opcode: u32) -> bool {
    return isXMMLoadOpcode(Opcode) || isYMMLoadOpcode(Opcode);
}

fn isPotentialBlockedMemCpyPair(LdOpcode: u32, StOpcode: u32) -> bool {
    match LdOpcode {
        _ => {
            return false;
        },
    }
}

fn isPotentialBlockingStoreInst(Opcode: u32, LoadOpcode: u32) -> bool {
    let mut PBlock: bool = false;
    return PBlock;
}

const MOV128SZ: i32 = 16;

const MOV64SZ: i32 = 8;

const MOV32SZ: i32 = 4;

const MOV16SZ: i32 = 2;

const MOV8SZ: i32 = 1;

fn getYMMtoXMMLoadOpcode(LoadOpcode: u32) -> u32 {
    match LoadOpcode {
        _ => {
            llvm_unreachable_internal("Unexpected Load Instruction Opcode", "llvm\\lib\\Target\\X86\\X86AvoidStoreForwardingBlocks.cpp", 262);
        },
    }
    return 0;
}

fn getYMMtoXMMStoreOpcode(StoreOpcode: u32) -> u32 {
    match StoreOpcode {
        _ => {
            llvm_unreachable_internal("Unexpected Load Instruction Opcode", "llvm\\lib\\Target\\X86\\X86AvoidStoreForwardingBlocks.cpp", 291);
        },
    }
    return 0;
}

fn getAddrOffset(MI: *MachineInstr) -> i32 {
    let mut AddrOffset: i32 = getMemoryOperandIdx(MI.getDesc());
    assert!(AddrOffset >= 0, "Expected a memory operand");
    return AddrOffset;
}

fn getBaseOperand(MI: *mut MachineInstr) -> *mut MachineOperand {
    let mut AddrOffset: i32 = getAddrOffset(MI);
    return MI.getOperand(AddrOffset + AddrBaseReg);
}

fn getDispOperand(MI: *mut MachineInstr) -> *mut MachineOperand {
    let mut AddrOffset: i32 = getAddrOffset(MI);
    return MI.getOperand(AddrOffset + AddrDisp);
}

fn isRelevantAddressingMode(MI: *mut MachineInstr) -> bool {
    let mut AddrOffset: i32 = getAddrOffset(MI);
    let mut Base: *MachineOperand = getBaseOperand(MI);
    let mut Disp: *MachineOperand = getDispOperand(MI);
    let mut Scale: *MachineOperand = MI.getOperand(AddrOffset + AddrScaleAmt);
    let mut Index: *MachineOperand = MI.getOperand(AddrOffset + AddrIndexReg);
    let mut Segment: *MachineOperand = MI.getOperand(AddrOffset + AddrSegmentReg);
    if  {
        return false;
    }
    if !Disp.isImm() {
        return false;
    }
    if Scale.getImm() != 1 {
        return false;
    }
    if  {
        return false;
    }
    if  {
        return false;
    }
    return true;
}

fn findPotentialBlockers(LoadInst: *mut MachineInstr) -> SmallVector<MachineInstr *, 2> {
    let mut PotentialBlockers: SmallVector<MachineInstr *, 2> = zeroed();
    let mut BlockCount: u32 = 0;
    let mut InspectionLimit: u32 = ;
    for let mut PBInst: auto = next(reverse_iterator { LoadInst });
let mut E: reverse_iterator = LoadInst.getParent().rend(); PBInst() != E;  += 1 {
        if PBInst()() {
            continue;
        }
        BlockCount += 1;
        if BlockCount >= InspectionLimit {
            break;
        }
        let mut MI: *mut MachineInstr = operator*();
        if MI.getDesc().isCall() {
            return ;
        }
        PotentialBlockers()(&mut MI);
    }
    if BlockCount < InspectionLimit {
        let mut MBB: *mut MachineBasicBlock = LoadInst.getParent();
        let mut LimitLeft: i32 = InspectionLimit - BlockCount;
        for PMBB in MBB.predecessors() {
            let mut PredCount: i32 = 0;
        }
    }
    return ;
}

fn X86AvoidSFBImpl::buildCopy(self, LoadInst: *mut MachineInstr, NLoadOpcode: u32, LoadDisp: i64, StoreInst: *mut MachineInstr, NStoreOpcode: u32, StoreDisp: i64, Size: u32, Offset: i64) {
    let mut LoadBase: *mut MachineOperand = getBaseOperand(LoadInst);
    let mut StoreBase: *mut MachineOperand = getBaseOperand(StoreInst);
    let mut MBB: *mut MachineBasicBlock = LoadInst.getParent();
    let mut LMMO: *mut MachineMemOperand = *LoadInst.memoperands_begin();
    let mut SMMO: *mut MachineMemOperand = *StoreInst.memoperands_begin();
    let mut Reg1: Register = self.MRI(self.TII.getRegClass(self.TII(NLoadOpcode), 0));
    let mut NewLoad: *mut MachineInstr = BuildMI(*MBB, LoadInst, LoadInst.getDebugLoc(), self.TII(NLoadOpcode), Reg1)(LoadBase)(1)(LoadDisp)(MBB.getParent().getMachineMemOperand(LMMO, Offset, Size));
    if LoadBase.isReg() {
        getBaseOperand(NewLoad).setIsKill(false);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-avoid-sfb", 1) {
            NewLoad.dump();
        }
    }
        if !(false) { break; }
    }
    let mut StInst: *mut MachineInstr = StoreInst;
    let mut PrevInstrIt: auto = prev_nodbg(instr_iterator { StoreInst }, MBB.instr_begin());
    if PrevInstrIt()() == LoadInst {
        StInst = LoadInst;
    }
    let mut NewStore: *mut MachineInstr = BuildMI(*MBB, StInst, StInst.getDebugLoc(), self.TII(NStoreOpcode))(StoreBase)(1)(StoreDisp)(Reg1)(MBB.getParent().getMachineMemOperand(SMMO, Offset, Size));
    if StoreBase.isReg() {
        getBaseOperand(NewStore).setIsKill(false);
    }
    let mut StoreSrcVReg: *mut MachineOperand = StoreInst.getOperand(AddrNumOperands);
    assert!(StoreSrcVReg.isReg(), "Expected virtual register");
    NewStore.getOperand(AddrNumOperands).setIsKill(StoreSrcVReg.isKill());
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-avoid-sfb", 1) {
            NewStore.dump();
        }
    }
        if !(false) { break; }
    }
}

fn X86AvoidSFBImpl::buildCopies(self, Size: i32, LoadInst: *mut MachineInstr, LdDispImm: i64, StoreInst: *mut MachineInstr, StDispImm: i64, Offset: i64) {
    let mut LdDisp: i32 = LdDispImm;
    let mut StDisp: i32 = StDispImm;
    while Size > 0 {
        if (Size - MOV128SZ >= 0) && isYMMLoadOpcode(LoadInst.getOpcode()) {
            Size = Size - MOV128SZ;
            self.buildCopy(LoadInst, getYMMtoXMMLoadOpcode(LoadInst.getOpcode()), LdDisp, StoreInst, getYMMtoXMMStoreOpcode(StoreInst.getOpcode()), StDisp, MOV128SZ, Offset);
            LdDisp += MOV128SZ;
            StDisp += MOV128SZ;
            Offset += MOV128SZ;
            continue;
        }
        if Size - MOV64SZ >= 0 {
            Size = Size - MOV64SZ;
            self.buildCopy;
            LdDisp += MOV64SZ;
            StDisp += MOV64SZ;
            Offset += MOV64SZ;
            continue;
        }
        if Size - MOV32SZ >= 0 {
            Size = Size - MOV32SZ;
            self.buildCopy;
            LdDisp += MOV32SZ;
            StDisp += MOV32SZ;
            Offset += MOV32SZ;
            continue;
        }
        if Size - MOV16SZ >= 0 {
            Size = Size - MOV16SZ;
            self.buildCopy;
            LdDisp += MOV16SZ;
            StDisp += MOV16SZ;
            Offset += MOV16SZ;
            continue;
        }
        if Size - MOV8SZ >= 0 {
            Size = Size - MOV8SZ;
            self.buildCopy;
            LdDisp += MOV8SZ;
            StDisp += MOV8SZ;
            Offset += MOV8SZ;
            continue;
        }
    }
    assert!(Size == 0, "Wrong size division");
}

fn updateKillStatus(LoadInst: *mut MachineInstr, StoreInst: *mut MachineInstr) {
    let mut LoadBase: *mut MachineOperand = getBaseOperand(LoadInst);
    let mut StoreBase: *mut MachineOperand = getBaseOperand(StoreInst);
    let mut StorePrevNonDbgInstr: *mut auto = prev_nodbg(instr_iterator { StoreInst }, LoadInst.getParent().instr_begin())();
    if LoadBase.isReg() {
        let mut LastLoad: *mut MachineInstr = LoadInst.getPrevNode();
        if StorePrevNonDbgInstr() == LoadInst {
            LastLoad = LoadInst.getPrevNode().getPrevNode();
        }
        getBaseOperand(LastLoad).setIsKill(LoadBase.isKill());
    }
    if StoreBase.isReg() {
        let mut StInst: *mut MachineInstr = StoreInst;
        if StorePrevNonDbgInstr() == LoadInst {
            StInst = LoadInst;
        }
        getBaseOperand(StInst.getPrevNode()).setIsKill(StoreBase.isKill());
    }
}

fn X86AvoidSFBImpl::alias(self: *X86AvoidSFBImpl, Op1: *MachineMemOperand, Op2: *MachineMemOperand) -> bool {
    if !Op1.getValue() || !Op2.getValue() {
        return true;
    }
    let mut MinOffset: i64 = min(Op1.getOffset(), Op2.getOffset());
    let mut Overlapa: i64 = Op1.getSize().getValue().operator unsigned long long() + Op1.getOffset() - MinOffset;
    let mut Overlapb: i64 = Op2.getSize().getValue().operator unsigned long long() + Op2.getOffset() - MinOffset;
    return !self.AA.isNoAlias(MemoryLocation { Ptr: Op1.getValue(), Size: Overlapa, AATags: Op1.getAAInfo() }, MemoryLocation { Ptr: Op2.getValue(), Size: Overlapb, AATags: Op2.getAAInfo() });
}

fn X86AvoidSFBImpl::findPotentiallylBlockedCopies(self, MF: *mut MachineFunction) {
    for MBB in MF {
        for MI in MBB {
            if !isPotentialBlockedMemCpyLd(MI.getOpcode()) {
                continue;
            }
            let mut DefVR: Register = MI.getOperand(0).getReg();
            if !self.MRI.hasOneNonDBGUse(DefVR) {
                continue;
            }
        }
    }
}

fn X86AvoidSFBImpl::getRegSizeInBytes(self, LoadInst: *mut MachineInstr) -> u32 {
    let mut TRC: *auto = self.TII.getRegClass(self.TII(LoadInst.getOpcode()), 0);
    return self.TRI(operator*()) / 8;
}

fn X86AvoidSFBImpl::breakBlockedCopies(self, LoadInst: *mut MachineInstr, StoreInst: *mut MachineInstr, BlockingStoresDispSizeMap: i32) {
    let mut LdDispImm: i64 = getDispOperand(LoadInst).getImm();
    let mut StDispImm: i64 = getDispOperand(StoreInst).getImm();
    let mut Offset: i64 = 0;
    let mut LdDisp1: i64 = LdDispImm;
    let mut LdDisp2: i64 = 0;
    let mut StDisp1: i64 = StDispImm;
    let mut StDisp2: i64 = 0;
    let mut Size1: u32 = 0;
    let mut Size2: u32 = 0;
    let mut LdStDelta: i64 = StDispImm - LdDispImm;
    let mut Size3: u32 = (LdDispImm + self.getRegSizeInBytes(LoadInst)) - LdDisp1;
    self.buildCopies(Size3, LoadInst, LdDisp1, StoreInst, StDisp1, Offset);
}

fn hasSameBaseOpValue(LoadInst: *mut MachineInstr, StoreInst: *mut MachineInstr) -> bool {
    let mut LoadBase: *MachineOperand = getBaseOperand(LoadInst);
    let mut StoreBase: *MachineOperand = getBaseOperand(StoreInst);
    if LoadBase.isReg() != StoreBase.isReg() {
        return false;
    }
    if LoadBase.isReg() {
        return LoadBase.getReg() == StoreBase.getReg();
    }
    return LoadBase.getIndex() == StoreBase.getIndex();
}

fn isBlockingStore(LoadDispImm: i64, LoadSize: u32, StoreDispImm: i64, StoreSize: u32) -> bool {
    return ((StoreDispImm >= LoadDispImm) && (StoreDispImm <= LoadDispImm + (LoadSize - StoreSize)));
}

fn updateBlockingStoresDispSizeMap(BlockingStoresDispSizeMap: *mut i32, DispImm: i64, Size: u32) {}

fn removeRedundantBlockingStores(BlockingStoresDispSizeMap: *mut i32) {
    if BlockingStoresDispSizeMap()() <= 1 {
        return;
    }
    let mut DispSizeStack: pair<int64_t, unsigned int>, 0> = zeroed();
    BlockingStoresDispSizeMap()();
}

fn X86AvoidSFBImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut Changed: bool = false;
    if DisableX86AvoidStoreForwardBlocks() || operator!(MF()) {
        return false;
    }
    self.MRI = &mut MF.getRegInfo();
    assert!(self.MRI.isSSA(), "Expected MIR to be in SSA form");
    self.TII = MF();
    self.TRI = MF();
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-avoid-sfb", 1) {
            dbgs() << "Start X86AvoidStoreForwardBlocks\n";
        }
    }
        if !(false) { break; }
    }
    self.findPotentiallylBlockedCopies(MF);
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-avoid-sfb", 1) {
            dbgs() << "End X86AvoidStoreForwardBlocks\n";
        }
    }
        if !(false) { break; }
    }
    return Changed;
}

fn X86AvoidSFBLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut AA: *mut AliasAnalysis = operator&();
    let mut Impl: X86AvoidSFBImpl = X86AvoidSFBImpl { AA };
    return Impl.runOnMachineFunction(MF);
}

fn X86AvoidStoreForwardingBlocksPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut AA: *mut AliasAnalysis = operator&(MFAM()(MF.getFunction()));
    let mut Impl: X86AvoidSFBImpl = X86AvoidSFBImpl { AA };
    let mut Changed: bool = Impl.runOnMachineFunction(MF);
    return if Changed { getMachineFunctionPassPreservedAnalyses() } else { all() };
}
