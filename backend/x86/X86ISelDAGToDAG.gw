fn X86DAGToDAGISel::tryShrinkShlLogicImm(self, N: *mut SDNode) -> bool {
    let mut NVT: MVT = N.getSimpleValueType(0);
    let mut Opcode: u32 = N.getOpcode();
    let mut dl: SDLoc = SDLoc { N };
    let mut Shift: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut Cst: *mut auto = dyn_cast(N1);
    if operator!() {
        return false;
    }
    let mut Val: i64 = ();
    let mut FoundAnyExtend: bool = false;
    if Shift.getOpcode() == ANY_EXTEND && Shift.hasOneUse() && Shift.getOperand(0).getSimpleValueType() == i32 && isUInt(Val) {
        FoundAnyExtend = true;
        Shift = Shift.getOperand(0);
    }
    if Shift.getOpcode() != SHL || !Shift.hasOneUse() {
        return false;
    }
    if NVT != i32 && NVT != i64 {
        return false;
    }
    let mut ShlCst: *mut auto = dyn_cast(Shift.getOperand(1));
    if operator!() {
        return false;
    }
    let mut ShAmt: u64 = ();
    let mut RemovedBitsMask: u64 = (1 << ShAmt) - 1;
    if Opcode != AND && (Val & RemovedBitsMask) != 0 {
        return false;
    }
    let mut CanShrinkImmediate: Closure_18 = Closure_18 { Opcode: &mut Opcode, Val: &mut Val, ShAmt: &mut ShAmt, NVT: &mut NVT };
    let mut ShiftedVal: i64 = 0;
    if !CanShrinkImmediate.call(ShiftedVal) {
        return false;
    }
    if Opcode == AND {
        let mut ZExtWidth: u32 = ()();
        ZExtWidth = bit_ceil(max(ZExtWidth, 8));
        let mut NeededMask: APInt = getLowBitsSet(NVT.getSizeInBits().operator unsigned long long(), ZExtWidth);
        operator&=(NeededMask, operator~());
        if self.CurDAG.MaskedValueIsZero(N.getOperand(0), NeededMask, 0) {
            return false;
        }
    }
    let mut X: SDValue = Shift.getOperand(0);
    if FoundAnyExtend {
        let mut NewX: SDValue = self.CurDAG.getNode(ANY_EXTEND, dl, EVT { NVT }, X);
        insertDAGNode(*self.CurDAG, SDValue { Node: N, ResNo: 0 }, NewX);
        X = NewX;
    }
    let mut NewCst: SDValue = self.CurDAG.getSignedConstant(ShiftedVal, dl, EVT { NVT }, false, false);
    insertDAGNode(*self.CurDAG, SDValue { Node: N, ResNo: 0 }, NewCst);
    let mut NewBinOp: SDValue = self.CurDAG.getNode(Opcode, dl, EVT { NVT }, X, NewCst);
    insertDAGNode(*self.CurDAG, SDValue { Node: N, ResNo: 0 }, NewBinOp);
    let mut NewSHL: SDValue = self.CurDAG.getNode(SHL, dl, EVT { NVT }, NewBinOp, Shift.getOperand(1));
    self.ReplaceNode(N, NewSHL.getNode());
    SelectCode(NewSHL.getNode());
    return true;
}

fn X86DAGToDAGISel::matchVPTERNLOG(self, Root: *mut SDNode, ParentA: *mut SDNode, ParentB: *mut SDNode, ParentC: *mut SDNode, A: SDValue, B: SDValue, C: SDValue, Imm: u8) -> bool {
