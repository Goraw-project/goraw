struct X86ISelAddressMode {
    BaseType: (unnamed at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86ISelDAGToDAG.cpp:62:5),
    Base_Reg: SDValue,
    Base_FrameIndex: i32,
    Scale: u32,
    IndexReg: SDValue,
    Disp: i32,
    Segment: SDValue,
    GV: *GlobalValue,
    CP: *Constant,
    BlockAddr: *BlockAddress,
    ES: *u8,
    MCSym: *mut MCSymbol,
    JT: i32,
    Alignment: Align,
    SymbolFlags: u8,
    NegateIndex: bool,
    IsForLEA: bool,
}

fn X86ISelAddressMode::hasSymbolicDisplacement(self: *X86ISelAddressMode) -> bool {
    return self.GV != null || self.CP != null || self.ES != null || self.MCSym != null || self.JT != -1 || self.BlockAddr != null;
}

fn X86ISelAddressMode::hasBaseOrIndexReg(self: *X86ISelAddressMode) -> bool {
    return self.BaseType == FrameIndexBase || self.IndexReg.getNode() != null || self.Base_Reg.getNode() != null;
}

fn X86ISelAddressMode::isRIPRelative(self: *X86ISelAddressMode) -> bool {
    if self.BaseType != RegBase {
        return false;
    }
    return false;
}

fn X86ISelAddressMode::setBaseReg(self, Reg: SDValue) {
    self.BaseType = RegBase;
    self.Base_Reg = Reg;
}

fn X86ISelAddressMode::dump(self, DAG: *mut SelectionDAG) {
    dbgs() << "X86ISelAddressMode " << self << 10;
    dbgs() << "Base_Reg ";
    if self.Base_Reg.getNode() {
        self.Base_Reg.getNode().dump(DAG);
    } else {
        dbgs() << "nul\n";
    }
    if self.BaseType == FrameIndexBase {
        dbgs() << " Base.FrameIndex " << self.Base_FrameIndex << 10;
    }
    dbgs() << " Scale " << self.Scale << 10 << "IndexReg ";
    if self.NegateIndex {
        dbgs() << "negate ";
    }
    if self.IndexReg.getNode() {
        self.IndexReg.getNode().dump(DAG);
    } else {
        dbgs() << "nul\n";
    }
    dbgs() << " Disp " << self.Disp << 10 << "GV ";
    if self.GV {
        self.GV.dump();
    } else {
        dbgs() << "nul";
    }
    dbgs() << " CP ";
    if self.CP {
        self.CP.dump();
    } else {
        dbgs() << "nul";
    }
    dbgs() << 10 << "ES ";
    if self.ES {
        dbgs() << self.ES;
    } else {
        dbgs() << "nul";
    }
    dbgs() << " MCSym ";
    if self.MCSym {
        dbgs() << self.MCSym;
    } else {
        dbgs() << "nul";
    }
    dbgs() << " JT" << self.JT << " Align" << self.Alignment.value() << 10;
}

fn X86ISelAddressMode::operator=(self, arg: *X86ISelAddressMode) -> *mut X86ISelAddressMode {
    self.BaseType = .BaseType;
    self.Base_Reg.operator=(.Base_Reg);
    self.Base_FrameIndex = .Base_FrameIndex;
    self.Scale = .Scale;
    self.IndexReg.operator=(.IndexReg);
    self.Disp = .Disp;
    self.Segment.operator=(.Segment);
    self.GV = .GV;
    self.CP = .CP;
    self.BlockAddr = .BlockAddr;
    self.ES = .ES;
    self.MCSym = .MCSym;
    self.JT = .JT;
    self.Alignment.operator=(.Alignment);
    self.SymbolFlags = .SymbolFlags;
    self.NegateIndex = .NegateIndex;
    self.IsForLEA = .IsForLEA;
    return *self;
}

struct X86DAGToDAGISel {
    TM: *mut TargetMachine,
    LibInfo: *TargetLibraryInfo,
    LibcallLowering: *LibcallLoweringInfo,
    FuncInfo: unique_ptr<FunctionLoweringInfo>,
    SwiftError: unique_ptr<SwiftErrorValueTracking>,
    MF: *mut MachineFunction,
    RegInfo: *mut MachineRegisterInfo,
    CurDAG: *mut SelectionDAG,
    SDB: unique_ptr<SelectionDAGBuilder>,
    BatchAA: optional<BatchAAResults>,
    AC: *mut AssumptionCache,
    GFI: *mut GCFunctionInfo,
    SP: *mut SSPLayoutInfo,
    TTI: *TargetTransformInfo,
    OptLevel: CodeGenOptLevel,
    TII: *TargetInstrInfo,
    TLI: *TargetLowering,
    FastISelFailed: bool,
    ElidedArgCopyInstrs: SmallPtrSet<const Instruction *, 4>,
    ORE: unique_ptr<OptimizationRemarkEmitter>,
    MatchFilterFuncName: bool,
    FuncName: str,
    HwMode: u32,
    DAGSize: u32,
    OpcodeOffset: []u32,
    Subtarget: *X86Subtarget,
    OptForMinSize: bool,
    IndirectTlsSegRefs: bool,
}

fn X86DAGToDAGISel::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    self.Subtarget = operator&(MF);
    self.IndirectTlsSegRefs = MF.getFunction().hasFnAttribute("indirect-tls-seg-refs");
    self.OptForMinSize = MF.getFunction().hasMinSize();
    return self.runOnMachineFunction(MF);
}

fn X86DAGToDAGISel::tryFoldLoad(self, P: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    return self.tryFoldLoad(P, P, N, Base, Scale, Index, Disp, Segment);
}

fn X86DAGToDAGISel::getAddressOperands(self, AM: *mut X86ISelAddressMode, DL: *SDLoc, VT: MVT, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) {
    if AM.BaseType == FrameIndexBase {
        Base = self.CurDAG.getTargetFrameIndex(AM.Base_FrameIndex, self.TLI.getPointerTy);
    } else if AM.Base_Reg.getNode() {
        Base = AM.Base_Reg;
    } else {
        Base = self.CurDAG.getRegister(Register { Reg: 0 }, EVT { VT });
    }
    Scale = self.getI8Imm(AM.Scale, DL);
    if AM.NegateIndex {
        let mut NegOpc: u32 = 0;
        match VT.SimpleTy {
            _ => {
                llvm_unreachable_internal("Unsupported VT!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 292);
            },
            i64 => {
                
            },
            i32 => {
                
            },
            i16 => {
                
            },
            i8 => {
                
            },
        }
        let mut Neg: SDValue = SDValue { Node: self.CurDAG.getMachineNode(NegOpc, DL, EVT { VT }, EVT { i32 }, ArrayRef<SDValue> { AM.IndexReg }), ResNo: 0 };
        AM.IndexReg = Neg;
    }
    if AM.IndexReg.getNode() {
        Index = AM.IndexReg;
    } else {
        Index = self.CurDAG.getRegister(Register { Reg: 0 }, EVT { VT });
    }
    if AM.GV {
        Disp = self.CurDAG.getTargetGlobalAddress(AM.GV, SDLoc {}, EVT { i32 }, AM.Disp, AM.SymbolFlags);
    } else if AM.CP {
        Disp = self.CurDAG.getTargetConstantPool(AM.CP, EVT { i32 }, MaybeAlign { AM.Alignment }, AM.Disp, AM.SymbolFlags);
    } else if AM.ES {
        assert!(!AM.Disp, "Non-zero displacement is ignored with ES.");
        Disp = self.CurDAG.getTargetExternalSymbol(AM.ES, EVT { i32 }, AM.SymbolFlags);
    } else if AM.MCSym {
        assert!(!AM.Disp, "Non-zero displacement is ignored with MCSym.");
        assert!(AM.SymbolFlags == 0, "oo");
        Disp = self.CurDAG.getMCSymbol(AM.MCSym, EVT { i32 });
    } else if AM.JT != -1 {
        assert!(!AM.Disp, "Non-zero displacement is ignored with JT.");
        Disp = self.CurDAG.getTargetJumpTable(AM.JT, EVT { i32 }, AM.SymbolFlags);
    } else if AM.BlockAddr {
        Disp = self.CurDAG.getTargetBlockAddress(AM.BlockAddr, EVT { i32 }, AM.Disp, AM.SymbolFlags);
    } else {
        Disp = self.CurDAG.getSignedTargetConstant(AM.Disp, DL, EVT { i32 }, false);
    }
    if AM.Segment.getNode() {
        Segment = AM.Segment;
    } else {
        Segment = self.CurDAG.getRegister(Register { Reg: 0 }, EVT { i16 });
    }
}

fn X86DAGToDAGISel::isAMXSDNode(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    for let mut Idx: u32 = 0;
let mut E: u32 = N.getNumValues(); Idx != E; Idx += 1 {
        if N.getValueType(Idx) == EVT { x86amx } {
            return true;
        }
    }
    for let mut Idx: u32 = 0;
let mut E: u32 = N.getNumOperands(); Idx != E; Idx += 1 {
        let mut Op: SDValue = N.getOperand(Idx);
        if Op.getValueType() == EVT { x86amx } {
            return true;
        }
    }
    return false;
}

fn X86DAGToDAGISel::shouldAvoidImmediateInstFormsForSize(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    let mut UseCount: u32 = 0;
    if !self.CurDAG.shouldOptForSize() {
        return false;
    }
    for User in N.users() {
        if UseCount >= 2 {
            break;
        }
        if User.isMachineOpcode() {
            UseCount += 1;
            continue;
        }
        if User.getOpcode() == STORE && User.getOperand(1).getNode() == N {
            UseCount += 1;
            continue;
        }
        if User.getNumOperands() != 2 {
            continue;
        }
        let mut C: *mut auto = dyn_cast(N);
        if C() && isInt() {
            continue;
        }
        if  {
            let mut OtherOp: SDValue = User.getOperand(0);
            if OtherOp.getNode() == N {
                OtherOp = User.getOperand(1);
            }
            let mut RegNode: *mut RegisterSDNode = null;
            if operator(OtherOp).getOpcode() == CopyFromReg && (RegNode = dyn_cast_or_null(operator(OtherOp).getOperand(1).getNode())) {
                if  {
                    continue;
                }
            }
        }
        UseCount += 1;
    }
    return (UseCount > 1);
}

fn X86DAGToDAGISel::getI8Imm(self, Imm: u32, DL: *SDLoc) -> SDValue {
    return self.CurDAG.getTargetConstant(Imm, DL, EVT { i8 }, false);
}

fn X86DAGToDAGISel::getI32Imm(self, Imm: u32, DL: *SDLoc) -> SDValue {
