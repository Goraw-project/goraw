                assert!(MaskVT == ValueVT.changeVectorElementTypeToInteger(), "Unexpected mask VT!");
                if IndexVT == v4i32 && NumElts == 4 && EltSize == 32 {
                    Opc = if IsFP { VGATHERDPSrm } else { VPGATHERDDrm };
                } else if IndexVT == v8i32 && NumElts == 8 && EltSize == 32 {
                    Opc = if IsFP { VGATHERDPSYrm } else { VPGATHERDDYrm };
                } else if IndexVT == v4i32 && NumElts == 2 && EltSize == 64 {
                    Opc = if IsFP { VGATHERDPDrm } else { VPGATHERDQrm };
                } else if IndexVT == v4i32 && NumElts == 4 && EltSize == 64 {
                    Opc = if IsFP { VGATHERDPDYrm } else { VPGATHERDQYrm };
                } else if IndexVT == v2i64 && NumElts == 4 && EltSize == 32 {
                    Opc = if IsFP { VGATHERQPSrm } else { VPGATHERQDrm };
                } else if IndexVT == v4i64 && NumElts == 4 && EltSize == 32 {
                    Opc = if IsFP { VGATHERQPSYrm } else { VPGATHERQDYrm };
                } else if IndexVT == v2i64 && NumElts == 2 && EltSize == 64 {
                    Opc = if IsFP { VGATHERQPDrm } else { VPGATHERQQrm };
                } else if IndexVT == v4i64 && NumElts == 4 && EltSize == 64 {
                    Opc = if IsFP { VGATHERQPDYrm } else { VPGATHERQQYrm };
                }
            }
            if !Opc {
                break;
            }
            let mut Base: SDValue = SDValue {};
            let mut Scale: SDValue = SDValue {};
            let mut Index: SDValue = SDValue {};
            let mut Disp: SDValue = SDValue {};
            let mut Segment: SDValue = SDValue {};
            if !self.selectVectorAddr(Mgt, Mgt.getBasePtr(), IndexOp, Mgt.getScale(), Base, Scale, Index, Disp, Segment) {
                break;
            }
            let mut PassThru: SDValue = Mgt.getPassThru();
            let mut Chain: SDValue = Mgt.getChain();
            let mut VTs: SDVTList = self.CurDAG.getVTList(ValueVT, MaskVT, Other);
            let mut NewNode: *mut MachineSDNode = null;
            if AVX512Gather {
                let mut Ops: [8]SDValue = [PassThru, Mask, Base, Scale, Index, Disp, Segment, Chain];
                NewNode = self.CurDAG.getMachineNode(Opc, dl, VTs, Ops);
            } else {
                let mut Ops: [8]SDValue = [PassThru, Base, Scale, Index, Disp, Segment, Mask, Chain];
                NewNode = self.CurDAG.getMachineNode(Opc, dl, VTs, Ops);
            }
            self.CurDAG.setNodeMemRefs(NewNode, [Mgt.getMemOperand()]);
            self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: NewNode, ResNo: 0 });
            self.ReplaceUses(SDValue { Node: Node, ResNo: 1 }, SDValue { Node: NewNode, ResNo: 2 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        MSCATTER => {
            let mut Sc: *mut X86MaskedScatterSDNode = cast(Node);
            let mut Value: SDValue = Sc.getValue();
            let mut IndexOp: SDValue = Sc.getIndex();
            let mut IndexVT: MVT = IndexOp.getSimpleValueType();
            let mut ValueVT: MVT = Value.getSimpleValueType();
            if !ValueVT.isVector() {
                break;
            }
            let mut NumElts: u32 = ValueVT.getVectorNumElements();
            let mut ValueSVT: MVT = ValueVT.getVectorElementType();
            let mut IsFP: bool = ValueSVT.isFloatingPoint();
            let mut EltSize: u32 = ValueSVT.getSizeInBits().operator unsigned long long();
            let mut Opc: u32 = 0;
            if IndexVT == v4i32 && NumElts == 4 && EltSize == 32 {
                Opc = if IsFP { VSCATTERDPSZ128mr } else { VPSCATTERDDZ128mr };
            } else if IndexVT == v8i32 && NumElts == 8 && EltSize == 32 {
                Opc = if IsFP { VSCATTERDPSZ256mr } else { VPSCATTERDDZ256mr };
            } else if IndexVT == v16i32 && NumElts == 16 && EltSize == 32 {
                Opc = if IsFP { VSCATTERDPSZmr } else { VPSCATTERDDZmr };
            } else if IndexVT == v4i32 && NumElts == 2 && EltSize == 64 {
                Opc = if IsFP { VSCATTERDPDZ128mr } else { VPSCATTERDQZ128mr };
            } else if IndexVT == v4i32 && NumElts == 4 && EltSize == 64 {
                Opc = if IsFP { VSCATTERDPDZ256mr } else { VPSCATTERDQZ256mr };
