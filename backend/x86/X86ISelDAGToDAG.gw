fn X86DAGToDAGISel::tryVPTERNLOG(self, N: *mut SDNode) -> bool {
    let mut NVT: MVT = N.getSimpleValueType(0);
    if !NVT.isVector() || !self.Subtarget.hasAVX512() || NVT.getVectorElementType() == i1 {
        return false;
    }
    if operator!((self.Subtarget() || NVT.is512BitVector())) {
        return false;
    }
    let mut getFoldableLogicOp: Closure_20 = Closure_20 {};
    let mut N0: SDValue = SDValue {};
    let mut N1: SDValue = SDValue {};
    let mut A: SDValue = SDValue {};
    let mut FoldableOp: SDValue = SDValue {};
    let mut tryPeelOuterNotWrappingLogic: Closure_21 = Closure_21 { getFoldableLogicOp: &mut getFoldableLogicOp, N0: &mut N0, N1: &mut N1, FoldableOp: &mut FoldableOp, A: &mut A };
    let mut PeeledOuterNot: bool = false;
    let mut OriN: *mut SDNode = N;
    if tryPeelOuterNotWrappingLogic.call(N) {
        InnerOp;
    } else {
        PeeledOuterNot = true;
        N = InnerOp.getNode();
    }
    let mut B: SDValue = FoldableOp.getOperand(0);
    let mut C: SDValue = FoldableOp.getOperand(1);
    let mut ParentA: *mut SDNode = N;
    let mut ParentB: *mut SDNode = FoldableOp.getNode();
    let mut ParentC: *mut SDNode = FoldableOp.getNode();
    let mut TernlogMagicA: u8 = 240;
    let mut TernlogMagicB: u8 = 204;
    let mut TernlogMagicC: u8 = 170;
    let mut PeekThroughNot: Closure_22 = Closure_22 {};
    PeekThroughNot.call(A, ParentA, TernlogMagicA);
    PeekThroughNot.call(B, ParentB, TernlogMagicB);
    PeekThroughNot.call(C, ParentC, TernlogMagicC);
    let mut Imm: u8 = 0;
    match FoldableOp.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 5130);
        },
        AND => {
            Imm = TernlogMagicB & TernlogMagicC;
        },
        OR => {
            Imm = TernlogMagicB | TernlogMagicC;
        },
        XOR => {
            Imm = TernlogMagicB ^ TernlogMagicC;
        },
    }
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 5138);
        },
        AND => {
            Imm &= TernlogMagicA;
        },
        OR => {
            Imm |= TernlogMagicA;
        },
        XOR => {
            Imm ^= TernlogMagicA;
        },
    }
    if PeeledOuterNot {
        Imm = ~Imm;
    }
    return self.matchVPTERNLOG(OriN, ParentA, ParentB, ParentC, A, B, C, Imm);
}

fn X86DAGToDAGISel::shrinkAndImmediate(self, And: *mut SDNode) -> bool {
    let mut VT: MVT = And.getSimpleValueType(0);
    if VT != i32 && VT != i64 {
        return false;
    }
    let mut And1C: *mut auto = dyn_cast(And.getOperand(1));
    if operator!() {
        return false;
    }
    let mut MaskVal: APInt = ();
    let mut MaskLZ: u32 = MaskVal.countl_zero();
    if !MaskLZ || (VT == i64 && MaskLZ == 32) {
        return false;
    }
    if VT == i64 && MaskLZ >= 32 {
        MaskLZ -= 32;
        MaskVal = MaskVal.trunc(32);
    }
    let mut And0: SDValue = And.getOperand(0);
    let mut HighZeros: APInt = getHighBitsSet(MaskVal.getBitWidth(), MaskLZ);
    let mut NegMaskVal: APInt = MaskVal | HighZeros;
    let mut MinWidth: u32 = NegMaskVal.getSignificantBits();
    if MinWidth > 32 || (MinWidth > 8 && MaskVal.getSignificantBits() <= 32) {
        return false;
    }
    if VT == i64 && MaskVal.getBitWidth() < 64 {
        NegMaskVal = NegMaskVal.zext(64);
        HighZeros = HighZeros.zext(64);
    }
    let mut Known0: KnownBits = self.CurDAG.computeKnownBits(And0, 0);
    if Known0.isConstant() || !HighZeros.isSubsetOf(Known0.Zero) {
        return false;
    }
    if NegMaskVal.isAllOnes() {
        if VT == i32 && !self.isDef32(And0.getNode()) {
            return false;
        }
        self.ReplaceNode(And, And0.getNode());
        return true;
    }
    let mut NewMask: SDValue = self.CurDAG.getConstant(NegMaskVal, SDLoc { And }, EVT { VT }, false, false);
    insertDAGNode(*self.CurDAG, SDValue { Node: And, ResNo: 0 }, NewMask);
    let mut NewAnd: SDValue = self.CurDAG.getNode(AND, SDLoc { And }, EVT { VT }, And0, NewMask);
    self.ReplaceNode(And, NewAnd.getNode());
    SelectCode(NewAnd.getNode());
    return true;
}

