        NewNode = self.CurDAG.getMachineNode(NewOpc, dl, EVT { NVT }, SDValue { Node: NewNode, ResNo: 0 }, ShAmt);
    }
    return NewNode;
}

fn X86DAGToDAGISel::emitPCMPISTR(self, ROpc: u32, MOpc: u32, MayFoldLoad: bool, dl: *SDLoc, VT: MVT, Node: *mut SDNode) -> *mut MachineSDNode {
    let mut N0: SDValue = Node.getOperand(0);
    let mut N1: SDValue = Node.getOperand(1);
    let mut Imm: SDValue = Node.getOperand(2);
    let mut Val: *mut auto = cast(Imm)();
    Imm = self.CurDAG(operator*(), SDLoc { Node }, Imm.getValueType());
    let mut Tmp0: SDValue = SDValue {};
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    if MayFoldLoad && self.tryFoldLoad(Node, N1, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
        let mut Ops: [8]SDValue = [N0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Imm, N1.getOperand(0)];
        let mut VTs: SDVTList = self.CurDAG.getVTList(EVT { VT }, EVT { i32 }, EVT { Other });
        let mut CNode: *mut MachineSDNode = self.CurDAG;
        self.ReplaceUses(N1.getValue(1), SDValue { Node: CNode, ResNo: 2 });
        self.CurDAG.setNodeMemRefs(CNode, void { cast(N1)() });
        return CNode;
    }
    let mut Ops: [3]SDValue = [N0, N1, Imm];
    let mut VTs: SDVTList = self.CurDAG.getVTList(EVT { VT }, EVT { i32 });
    let mut CNode: *mut MachineSDNode = self.CurDAG;
    return CNode;
}

fn X86DAGToDAGISel::emitPCMPESTR(self, ROpc: u32, MOpc: u32, MayFoldLoad: bool, dl: *SDLoc, VT: MVT, Node: *mut SDNode, InGlue: *mut SDValue) -> *mut MachineSDNode {
    let mut N0: SDValue = Node.getOperand(0);
    let mut N2: SDValue = Node.getOperand(2);
    let mut Imm: SDValue = Node.getOperand(4);
    let mut Val: *mut auto = cast(Imm)();
    Imm = self.CurDAG(operator*(), SDLoc { Node }, Imm.getValueType());
    let mut Tmp0: SDValue = SDValue {};
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    if MayFoldLoad && self.tryFoldLoad(Node, N2, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
        let mut Ops: [9]SDValue = [N0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Imm, N2.getOperand(0), InGlue];
        let mut VTs: SDVTList = self.CurDAG.getVTList(EVT { VT }, EVT { i32 }, EVT { Other }, EVT { Glue });
        let mut CNode: *mut MachineSDNode = self.CurDAG;
        InGlue = SDValue { Node: CNode, ResNo: 3 };
        self.ReplaceUses(N2.getValue(1), SDValue { Node: CNode, ResNo: 2 });
        self.CurDAG.setNodeMemRefs(CNode, void { cast(N2)() });
        return CNode;
    }
    let mut Ops: [4]SDValue = [N0, N2, Imm, InGlue];
    let mut VTs: SDVTList = self.CurDAG.getVTList(EVT { VT }, EVT { i32 }, EVT { Glue });
    let mut CNode: *mut MachineSDNode = self.CurDAG;
    InGlue = SDValue { Node: CNode, ResNo: 2 };
    return CNode;
}

fn X86DAGToDAGISel::tryShiftAmountMod(self, N: *mut SDNode) -> bool {
    let mut VT: EVT = N.getValueType(0);
    if VT.isVector() {
        return false;
    }
    let mut Size: u32 = if VT == EVT { i64 } { 64 } else { 32 };
    let mut OrigShiftAmt: SDValue = N.getOperand(1);
    let mut ShiftAmt: SDValue = OrigShiftAmt;
    let mut DL: SDLoc = SDLoc { N };
    if operator(ShiftAmt).getOpcode() == TRUNCATE {
        ShiftAmt = operator(ShiftAmt).getOperand(0);
    }
    let mut NewShiftAmt: SDValue = SDValue {};
    if operator(ShiftAmt).getOpcode() == ADD || operator(ShiftAmt).getOpcode() == SUB || operator(ShiftAmt).getOpcode() == XOR {
        let mut Add0: SDValue = operator(ShiftAmt).getOperand(0);
        let mut Add1: SDValue = operator(ShiftAmt).getOperand(1);
        let mut Add0C: *mut auto = dyn_cast(Add0);
        let mut Add1C: *mut auto = dyn_cast(Add1);
        if Add1C() && ()(Size) == 0 {
            NewShiftAmt = Add0;
        } else if operator(ShiftAmt).getOpcode() != ADD && ShiftAmt.hasOneUse() && ((Add0C() && ()(Size) == Size - 1) || (Add1C() && ()(Size) == Size - 1)) {
            (((operator!(operator!((Add0C() == null ||  == null)))) || (_wassert(L"Add0C == nullptr || Add1C == nullptr", L"llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", (4704) as u32) , 0)) as void);
            if operator(ShiftAmt).getOpcode() == SUB &&  == null {
                return false;
            }
            let mut OpVT: EVT = ShiftAmt.getValueType();
            let mut AllOnes: SDValue = self.CurDAG.getAllOnesConstant(DL, OpVT, false, false);
            NewShiftAmt = self.CurDAG(XOR, DL, OpVT, if  == null { Add0 } else { Add1 }, AllOnes);
            insertDAGNode(*self.CurDAG, OrigShiftAmt, AllOnes);
            insertDAGNode(*self.CurDAG, OrigShiftAmt, NewShiftAmt);
        } else if operator(ShiftAmt).getOpcode() == SUB &&  && () != 0 {
            let mut SubVT: EVT = ShiftAmt.getValueType();
            let mut X: SDValue = SDValue {};
            if Add0C()() % Size == 0 {
                X = Add1;
            } else if ShiftAmt.hasOneUse() && Size == 64 && () % 32 == 0 {
                if Add1.getOpcode() == TRUNCATE {
                    Add1 = Add1.getOperand(0);
                    SubVT = Add1.getValueType();
                }
                if Add0.getValueType() != SubVT {
                    Add0 = self.CurDAG.getZExtOrTrunc(Add0, DL, SubVT);
                    insertDAGNode(*self.CurDAG, OrigShiftAmt, Add0);
                }
                X = self.CurDAG.getNode(ADD, DL, SubVT, Add1, Add0);
                insertDAGNode(*self.CurDAG, OrigShiftAmt, X);
            } else {
                return false;
            }
            let mut Zero: SDValue = self.CurDAG.getConstant(0, DL, SubVT, false, false);
            let mut Neg: SDValue = self.CurDAG.getNode(SUB, DL, SubVT, Zero, X);
            NewShiftAmt = Neg;
            insertDAGNode(*self.CurDAG, OrigShiftAmt, Zero);
            insertDAGNode(*self.CurDAG, OrigShiftAmt, Neg);
        } else {
            return false;
        }
    } else {
        return false;
    }
    if NewShiftAmt.getValueType() != EVT { i8 } {
        NewShiftAmt = self.CurDAG.getNode(TRUNCATE, DL, EVT { i8 }, NewShiftAmt);
        insertDAGNode(*self.CurDAG, OrigShiftAmt, NewShiftAmt);
