        if (*self.IsAddOrAddLike).call(Op) {
            return (*self.IsAddOrAddLike).call(Op.getOperand(0)) || (*self.IsAddOrAddLike).call(Op.getOperand(1));
        }
        if Op.getOpcode() == SHL {
            if dyn_cast(Op.getOperand(1)) {
                C;
            } else {
                return C.getZExtValue() >= 1 && C.getZExtValue() <= 3 && (*self.IsAddOrAddLike).call(Op.getOperand(0));
            }
        }
        return false;
    }

