}

fn X86DAGToDAGISel::getNumFixedFromVariadicInfo(self, Flags: u32) -> i32 {
    return ((Flags & OPFL_VariadicInfo) >> 4) - 1;
}

fn X86DAGToDAGISel::ReplaceUses(self, F: SDValue, T: SDValue) {
    self.CurDAG.ReplaceAllUsesOfValueWith(F, T);
    EnforceNodeIdInvariant(T.getNode());
}

fn X86DAGToDAGISel::ReplaceNode(self, F: *mut SDNode, T: *mut SDNode) {
    self.CurDAG.ReplaceAllUsesWith(F, T);
    EnforceNodeIdInvariant(T);
    self.CurDAG.RemoveDeadNode(F);
}

