        },
        PREALLOCATED_SETUP => {
            let mut MFI: *mut X86MachineFunctionInfo = self.CurDAG.getMachineFunction().getInfo();
            let mut CallId: u64 = MFI.getPreallocatedIdForCallSite(cast(Node.getOperand(1)).getValue());
            let mut Chain: SDValue = Node.getOperand(0);
            let mut CallIdValue: SDValue = self.CurDAG.getTargetConstant(CallId, dl, i32, false);
            let mut New: *mut MachineSDNode = self.CurDAG.getMachineNode(PREALLOCATED_SETUP, dl, Other, CallIdValue, Chain);
            self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: New, ResNo: 0 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        PREALLOCATED_ARG => {
            let mut MFI: *mut X86MachineFunctionInfo = self.CurDAG.getMachineFunction().getInfo();
            let mut CallId: u64 = MFI.getPreallocatedIdForCallSite(cast(Node.getOperand(1)).getValue());
            let mut Chain: SDValue = Node.getOperand(0);
            let mut CallIdValue: SDValue = self.CurDAG.getTargetConstant(CallId, dl, i32, false);
            let mut ArgIndex: SDValue = Node.getOperand(2);
            let mut Ops: [3]SDValue = [3]SDValue {};
            Ops[0] = CallIdValue;
            Ops[1] = ArgIndex;
            Ops[2] = Chain;
            let mut New: *mut MachineSDNode = self.CurDAG.getMachineNode(PREALLOCATED_ARG, dl, self.CurDAG.getVTList(self.TLI.getPointerTy(self.CurDAG.getDataLayout(), 0), Other), Ops);
            self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: New, ResNo: 0 });
            self.ReplaceUses(SDValue { Node: Node, ResNo: 1 }, SDValue { Node: New, ResNo: 1 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        AESENCWIDE128KL => {
            AESDECWIDE128KL;
        },
        POP_FROM_X87_REG => {
            let mut Chain: SDValue = Node.getOperand(0);
            let mut Reg: Register = cast(Node.getOperand(1)).getReg();
            let mut Glue: SDValue = SDValue {};
            if Node.getNumValues() == 3 {
                Glue = Node.getOperand(2);
            }
            let mut Copy: SDValue = self.CurDAG.getCopyFromReg(Chain, dl, Reg, Node.getValueType(0), Glue);
            self.ReplaceNode(Node, Copy.getNode());
            return;
        },
    }
    self.SelectCode(Node);
}

fn X86DAGToDAGISel::SelectInlineAsmMemoryOperand(self, Op: *SDValue, ConstraintID: ConstraintCode, OutOps: *mut []SDValue) -> bool {
    let mut Op0: SDValue = SDValue {};
    let mut Op1: SDValue = SDValue {};
    let mut Op2: SDValue = SDValue {};
    let mut Op3: SDValue = SDValue {};
    let mut Op4: SDValue = SDValue {};
    match ConstraintID {
        _ => {
            llvm_unreachable_internal("Unexpected asm memory constraint", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 7097);
        },
        o => {
            v;
        },
    }
    OutOps.push(Op0);
    OutOps.push(Op1);
    OutOps.push(Op2);
    OutOps.push(Op3);
    OutOps.push(Op4);
    return false;
}

fn createX86ISelDag(TM: *mut X86TargetMachine, OptLevel: CodeGenOptLevel) -> *mut FunctionPass {
    return X86DAGToDAGISelLegacy { TM, OptLevel };
}

