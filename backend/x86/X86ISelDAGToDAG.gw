            let mut Scale: SDValue = SDValue {};
            let mut Index: SDValue = SDValue {};
            let mut Disp: SDValue = SDValue {};
            let mut Segment: SDValue = SDValue {};
            if !self.selectVectorAddr(Sc, Sc.getBasePtr(), IndexOp, Sc.getScale(), Base, Scale, Index, Disp, Segment) {
                break;
            }
            let mut Mask: SDValue = Sc.getMask();
            let mut Chain: SDValue = Sc.getChain();
            let mut VTs: SDVTList = self.CurDAG.getVTList(Mask.getValueType(), Other);
            let mut Ops: [8]SDValue = [Base, Scale, Index, Disp, Segment, Mask, Value, Chain];
            let mut NewNode: *mut MachineSDNode = self.CurDAG.getMachineNode(Opc, dl, VTs, Ops);
            self.CurDAG.setNodeMemRefs(NewNode, [Sc.getMemOperand()]);
            self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: NewNode, ResNo: 1 });
            self.CurDAG.RemoveDeadNode(Node);
