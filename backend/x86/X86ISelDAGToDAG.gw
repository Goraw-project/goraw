                if IndexVT == v4i32 && NumElts == 4 && EltSize == 32 {
                    Opc = if IsFP { VGATHERDPSZ128rm } else { VPGATHERDDZ128rm };
                } else if IndexVT == v8i32 && NumElts == 8 && EltSize == 32 {
                    Opc = if IsFP { VGATHERDPSZ256rm } else { VPGATHERDDZ256rm };
                } else if IndexVT == v16i32 && NumElts == 16 && EltSize == 32 {
                    Opc = if IsFP { VGATHERDPSZrm } else { VPGATHERDDZrm };
                } else if IndexVT == v4i32 && NumElts == 2 && EltSize == 64 {
                    Opc = if IsFP { VGATHERDPDZ128rm } else { VPGATHERDQZ128rm };
                } else if IndexVT == v4i32 && NumElts == 4 && EltSize == 64 {
                    Opc = if IsFP { VGATHERDPDZ256rm } else { VPGATHERDQZ256rm };
                } else if IndexVT == v8i32 && NumElts == 8 && EltSize == 64 {
                    Opc = if IsFP { VGATHERDPDZrm } else { VPGATHERDQZrm };
                } else if IndexVT == v2i64 && NumElts == 4 && EltSize == 32 {
                    Opc = if IsFP { VGATHERQPSZ128rm } else { VPGATHERQDZ128rm };
                } else if IndexVT == v4i64 && NumElts == 4 && EltSize == 32 {
                    Opc = if IsFP { VGATHERQPSZ256rm } else { VPGATHERQDZ256rm };
                } else if IndexVT == v8i64 && NumElts == 8 && EltSize == 32 {
                    Opc = if IsFP { VGATHERQPSZrm } else { VPGATHERQDZrm };
                } else if IndexVT == v2i64 && NumElts == 2 && EltSize == 64 {
                    Opc = if IsFP { VGATHERQPDZ128rm } else { VPGATHERQQZ128rm };
                } else if IndexVT == v4i64 && NumElts == 4 && EltSize == 64 {
                    Opc = if IsFP { VGATHERQPDZ256rm } else { VPGATHERQQZ256rm };
                } else if IndexVT == v8i64 && NumElts == 8 && EltSize == 64 {
                    Opc = if IsFP { VGATHERQPDZrm } else { VPGATHERQQZrm };
                }
