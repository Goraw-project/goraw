}

fn X86DAGToDAGISel::getExtractVEXTRACTImmediate(self, N: *mut SDNode, VecWidth: u32, DL: *SDLoc) -> SDValue {
    assert!((VecWidth == 128 || VecWidth == 256), "Unexpected vector width");
    let mut Index: u64 = N.getConstantOperandVal(1);
    let mut VecVT: MVT = N.getOperand(0).getSimpleValueType();
    return self.getI8Imm((Index * VecVT.getScalarSizeInBits()) / VecWidth, DL);
}

fn X86DAGToDAGISel::getInsertVINSERTImmediate(self, N: *mut SDNode, VecWidth: u32, DL: *SDLoc) -> SDValue {
    assert!((VecWidth == 128 || VecWidth == 256), "Unexpected vector width");
    let mut Index: u64 = N.getConstantOperandVal(2);
    let mut VecVT: MVT = N.getSimpleValueType(0);
    return self.getI8Imm((Index * VecVT.getScalarSizeInBits()) / VecWidth, DL);
}

fn X86DAGToDAGISel::getPermuteVINSERTCommutedImmediate(self, N: *mut SDNode, VecWidth: u32, DL: *SDLoc) -> SDValue {
    assert!(VecWidth == 128, "Unexpected vector width");
    let mut Index: u64 = N.getConstantOperandVal(2);
    let mut VecVT: MVT = N.getSimpleValueType(0);
    let mut InsertIdx: u64 = (Index * VecVT.getScalarSizeInBits()) / VecWidth;
    assert!((InsertIdx == 0 || InsertIdx == 1), "Bad insertf128 index");
    return self.getI8Imm(if InsertIdx { 2 } else { 48 }, DL);
}

fn X86DAGToDAGISel::getSBBZero(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut VTs: SDVTList = self.CurDAG.getVTList(EVT { i32 }, EVT { i32 });
    let mut Zero: SDValue = self.CurDAG;
    if VT == i64 {
        Zero = self.CurDAG(SUBREG_TO_REG, dl, i64, Zero, self.CurDAG);
    }
    let mut Opcode: u32 = N.getOpcode();
    let mut FlagOpIndex: u32 = 0;
    let mut EFLAGS: SDValue = self.CurDAG;
    let mut Opc: u32 = 0;
    let mut SBBVT: MVT = MVT { SimpleTy: if VT == i64 {} else { i32 } };
    VTs = self.CurDAG.getVTList(EVT { SBBVT }, EVT { i32 });
    return SDValue { Node: self.CurDAG.getMachineNode(Opc, dl, VTs, ArrayRef<SDValue> { [Zero, Zero, EFLAGS, EFLAGS.getValue(1)] }), ResNo: 0 };
}

fn X86DAGToDAGISel::isUnneededShiftMask(self: *X86DAGToDAGISel, N: *mut SDNode, Width: u32) -> bool {
    assert!(N.getOpcode() == AND, "Unexpected opcode");
    let mut Val: *APInt = N.getConstantOperandAPInt(1);
    if Val.countr_one() >= Width {
        return true;
    }
    let mut Mask: APInt = Val | self.CurDAG.computeKnownBits(N.getOperand(0), 0).Zero;
    return Mask.countr_one() >= Width;
}

