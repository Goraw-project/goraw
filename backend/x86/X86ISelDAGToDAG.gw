static mut ID: i8 = 0;

fn isLegalMaskCompare(N: *mut SDNode, Subtarget: *X86Subtarget) -> bool {
    let mut Opcode: u32 = N.getOpcode();
    if  {
        let mut OpVT: EVT = N.getOperand(0).getValueType();
        if  {
            OpVT = N.getOperand(1).getValueType();
        }
        if OpVT.is256BitVector() || OpVT.is128BitVector() {
            return Subtarget()();
        }
        return true;
    }
    if  {
        return true;
    }
    return false;
}

fn X86DAGToDAGISel::isMaskZeroExtended(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    if N.getOpcode() == AND {
        return isLegalMaskCompare(N.getOperand(0).getNode(), self.Subtarget) || isLegalMaskCompare(N.getOperand(1).getNode(), self.Subtarget);
    }
    return isLegalMaskCompare(N, self.Subtarget);
}

fn X86DAGToDAGISel::IsProfitableToFold(self: *X86DAGToDAGISel, N: SDValue, U: *mut SDNode, Root: *mut SDNode) -> bool {
    if self.OptLevel == None {
        return false;
    }
    if !N.hasOneUse() {
        return false;
    }
    if N.getOpcode() != LOAD {
        return true;
    }
    if self.useNonTemporalLoad(cast(N)) {
        return false;
    }
    if U == Root {
        match U.getOpcode() {
            _ => {
                break;
            },
            ADD => {
                UADDO_CARRY;
            },
            SHL => {
                SRA;
            },
        }
    }
    if Root.getOpcode() == INSERT_SUBVECTOR && isNullConstant(Root.getOperand(2)) && (Root.getOperand(0).isUndef() || isBuildVectorAllZeros(Root.getOperand(0).getNode())) {
        return false;
    }
    return true;
}

fn X86DAGToDAGISel::isProfitableToFormMaskedOp(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    return N.getOperand(1).hasOneUse();
}

fn moveBelowOrigChain(CurDAG: *mut SelectionDAG, Load: SDValue, Call: SDValue, OrigChain: SDValue) {
    let mut Ops: SmallVector<SDValue, 8> = zeroed();
    let mut Chain: SDValue = OrigChain.getOperand(0);
    if Chain.getNode() == Load.getNode() {
        Ops()(Load.getOperand(0));
    } else {
        assert!(Chain.getOpcode() == TokenFactor, "Unexpected chain operand");
        for let mut i: u32 = 0;
let mut e: u32 = Chain.getNumOperands(); i != e; i += 1 {
            if Chain.getOperand(i).getNode() == Load.getNode() {
                Ops()(Load.getOperand(0));
            } else {
                Ops()(Chain.getOperand(i));
            }
        }
        let mut NewChain: SDValue = CurDAG(TokenFactor, SDLoc { Load }, Other);
        Ops()();
        Ops()(NewChain);
    }
    Ops()(operator(OrigChain).op_begin() + 1, operator(OrigChain).op_end());
    CurDAG(OrigChain.getNode());
    CurDAG.UpdateNodeOperands(Load.getNode(), Call.getOperand(0), Load.getOperand(1), Load.getOperand(2));
    Ops()();
    Ops()(SDValue { Node: Load.getNode(), ResNo: 1 });
    Ops()(operator(Call).op_begin() + 1, operator(Call).op_end());
    CurDAG(Call.getNode());
}

fn isCalleeLoad(Callee: SDValue, Chain: *mut SDValue, HasCallSeq: bool) -> bool {
    if Callee.getNode() == Chain.getNode() || !Callee.hasOneUse() {
        return false;
    }
    let mut LD: *mut auto = dyn_cast(Callee.getNode());
    if operator!() || operator!() || () != UNINDEXED || () != NON_EXTLOAD {
        return false;
    }
    if !Callee.getValue(1).hasOneUse() {
        return false;
    }
    while HasCallSeq && Chain.getOpcode() != CALLSEQ_START {
        if !Chain.hasOneUse() {
            return false;
        }
        Chain = Chain.getOperand(0);
    }
    while true {
        if !Chain.getNumOperands() {
            return false;
        }
        match Chain.getNode().getOpcode() {
            CALLSEQ_START => {
                CopyToReg;
            },
            _ => {
                return false;
            },
        }
        if Chain.getOperand(0).getNode() == Callee.getNode() {
            return true;
        }
        if Chain.getOperand(0).getOpcode() == TokenFactor && Chain.getOperand(0).getValue(0).hasOneUse() && Callee.getValue(1).isOperandOf(Chain.getOperand(0).getNode()) && Callee.getValue(1).hasOneUse() {
            return true;
        }
        if Chain.getOperand(0).getOpcode() == CopyToReg && Chain.getOperand(0).getValue(0).hasOneUse() {
            Chain = Chain.getOperand(0);
            continue;
        }
        return false;
    }
}

fn isEndbrImm(Imm: u64, BitWidth: u32) -> bool {
    if BitWidth > 64 || BitWidth % 8 != 0 {
        return false;
    }
    let mut NumBytes: u32 = BitWidth / 8;
    if NumBytes < 4 {
        return false;
    }
    let mut OptionalPrefixBytes: [10]u8 = [38, 46, 54, 62, 100, 101, 102, 103, 240, 242];
    let mut Bytes: [8]u8 = zeroed();
    for let mut I: u32 = 0; I != NumBytes; I += 1 {
        Bytes[I] = (Imm >> (I * 8)) & 255;
    }
    for let mut I: u32 = 0; I + 3 < NumBytes; I += 1 {
        if Bytes[I] != 243 {
            continue;
        }
        let mut J: u32 = I + 1;
        while J < NumBytes && is_contained(OptionalPrefixBytes, Bytes[J]) {
            J += 1;
        }
        if J + 2 < NumBytes && Bytes[J] == 15 && Bytes[J + 1] == 30 && (Bytes[J + 2] == 250 || Bytes[J + 2] == 251) {
            return true;
        }
    }
    return false;
}

fn needBWI(VT: MVT) -> bool {
    return (VT == v32i16 || VT == v32f16 || VT == v64i8);
}

fn X86DAGToDAGISel::PreprocessISelDAG(self) {
    let mut MadeChange: bool = false;
    for let mut I: allnodes_iterator = self.CurDAG.allnodes_begin();
let mut E: allnodes_iterator = self.CurDAG.allnodes_end(); I != E;  {
        let mut N: *mut SDNode = &mut operator(operator(I, 0));
        if N.getOpcode() == Constant {
            let mut VT: MVT = N.getSimpleValueType(0);
            assert!(VT.isScalarInteger(), "ISD::Constant must have a scalar integer type");
            if !VT.isScalarInteger() || VT.getSizeInBits().operator unsigned long long() > 64 {
                continue;
            }
            let mut Imm: u64 = cast(N)();
            if isEndbrImm(Imm, VT.getSizeInBits().operator unsigned long long()) {
                let mut CFProtectionBranch: *mut Metadata = self.MF.getFunction().getParent().getModuleFlag("cf-protection-branch");
                if CFProtectionBranch ||  {
                    let mut dl: SDLoc = SDLoc { N };
                    let mut ComplementImm: u64 = (~Imm) & maskTrailingOnes(VT.getSizeInBits());
                    let mut Complement: SDValue = self.CurDAG.getConstant(ComplementImm, dl, EVT { VT }, false, true);
                    Complement = self.CurDAG.getNOT(dl, Complement, EVT { VT });
                    operator(I);
                    self.CurDAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Complement);
                    operator(I);
                    MadeChange = true;
                    continue;
                }
            }
        }
        if  {
            let mut Res: SDValue = self.CurDAG.getNode(AND, SDLoc { N }, N.getValueType(0), N.getOperand(0), N.getOperand(1));
            operator(I);
            self.CurDAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Res);
            operator(I);
            MadeChange = true;
            continue;
        }
        let mut mayPreventLoadFold: Closure_1 = Closure_1 { N: &mut N, cap_1: self };
        if (N.getOpcode() == ADD || N.getOpcode() == SUB) && N.getSimpleValueType(0).isVector() && !mayPreventLoadFold.call() {
            let mut SplatVal: APInt = APInt {};
            if !isBuildVectorOfConstantSDNodes(peekThroughBitcasts(N.getOperand(0)).getNode()) && isConstantSplat(N.getOperand(1), SplatVal, true) && SplatVal.isOne() {
                let mut DL: SDLoc = SDLoc { N };
                let mut VT: MVT = N.getSimpleValueType(0);
                let mut NumElts: u32 = VT.getSizeInBits().operator unsigned long long() / 32;
                let mut AllOnes: SDValue = self.CurDAG.getAllOnesConstant(DL, EVT { getVectorVT(MVT { SimpleTy: i32 }, NumElts) }, false, false);
                AllOnes = self.CurDAG.getBitcast(EVT { VT }, AllOnes);
                let mut NewOpcode: u32 = if N.getOpcode() == ADD { SUB } else { ADD };
                let mut Res: SDValue = self.CurDAG.getNode(NewOpcode, DL, EVT { VT }, N.getOperand(0), AllOnes);
                operator(I);
                self.CurDAG.ReplaceAllUsesWith(N, Res.getNode());
                operator(I);
                MadeChange = true;
                continue;
            }
        }
        match N.getOpcode() {
            LOAD => {
                let mut Ld: *mut auto = cast(N);
                let mut VT: MVT = N.getSimpleValueType(0);
                if operator!(isNormalLoad()) || operator!() || !(VT.is128BitVector() || VT.is256BitVector()) {
                    break;
                }
                let mut MaxVT: MVT = VT;
                let mut MaxLd: *mut SDNode = null;
                let mut Ptr: SDValue = ();
                let mut Chain: SDValue = ();
                if MaxLd {
                    let mut dl: SDLoc = SDLoc { N };
                    let mut NumSubElts: u32 = VT.getSizeInBits().operator unsigned long long() / MaxVT.getScalarSizeInBits();
                    let mut SubVT: MVT = getVectorVT(MaxVT.getScalarType(), NumSubElts);
                    let mut Extract: SDValue = self.CurDAG.getNode(EXTRACT_SUBVECTOR, dl, EVT { SubVT }, SDValue { Node: MaxLd, ResNo: 0 }, self.CurDAG.getIntPtrConstant(0, dl, false));
                    let mut Res: SDValue = self.CurDAG.getBitcast(EVT { VT }, Extract);
                    operator(I);
                    let mut To: [2]SDValue = [Res, SDValue { Node: MaxLd, ResNo: 1 }];
                    self.CurDAG.ReplaceAllUsesWith(N, To);
                    operator(I);
                    MadeChange = true;
                    continue;
                }
                break;
            },
            VSELECT => {
                let mut EleVT: EVT = N.getOperand(0).getValueType().getVectorElementType();
                if EleVT == EVT { i1 } {
                    break;
                }
                assert!(self.Subtarget.hasSSE41(), "Expected SSE4.1 support!");
                assert!(N.getValueType(0).getVectorElementType() != EVT { i16 }, "We can't replace VSELECT with BLENDV in vXi16!");
                let mut R: SDValue = SDValue {};
                if self.Subtarget() && self.CurDAG.ComputeNumSignBits(N.getOperand(0), 0) == EleVT.getSizeInBits().operator unsigned long long() {
                    R = self.CurDAG;
                } else {
                    R = self.CurDAG;
                }
                operator(I);
                self.CurDAG.ReplaceAllUsesWith(N, R.getNode());
                operator(I);
                MadeChange = true;
                continue;
            },
            FP_ROUND => {
                STRICT_FP_ROUND;
            },
            SHL => {
                SRA;
            },
            ANY_EXTEND => {
                ANY_EXTEND_VECTOR_INREG;
            },
            FCEIL => {
                STRICT_FCEIL;
            },
        }
        if  {
            let mut HasCallSeq: bool = ;
            let mut Chain: SDValue = N.getOperand(0);
            let mut Load: SDValue = N.getOperand(1);
            if !isCalleeLoad(Load, Chain, HasCallSeq) {
                continue;
            }
            if  {
                continue;
            }
            moveBelowOrigChain(self.CurDAG, Load, SDValue { Node: N, ResNo: 0 }, Chain);
            operator(NumLoadMoved);
            MadeChange = true;
            continue;
        }
        match N.getOpcode() {
            _ => {
                continue;
            },
            FP_ROUND => {
                FP_EXTEND;
            },
            STRICT_FP_ROUND => {
                STRICT_FP_EXTEND;
            },
        }
        operator(I);
        MadeChange = true;
    }
    if MadeChange {
        self.CurDAG.RemoveDeadNodes();
    }
}

fn X86DAGToDAGISel::tryOptimizeRem8Extend(self, N: *mut SDNode) -> bool {
    let mut Opc: u32 = N.getMachineOpcode();
    if  {
        return false;
    }
    let mut N0: SDValue = N.getOperand(0);
    if  {
        return false;
    }
    let mut ExpectedOpc: u32 = 0;
    let mut N00: SDValue = N0.getOperand(0);
    if !N00.isMachineOpcode() || N00.getMachineOpcode() != ExpectedOpc {
        return false;
    }
    if  {
        let mut Extend: *mut MachineSDNode = self.CurDAG;
        self.ReplaceUses(N, Extend);
    } else {
        self.ReplaceUses(N, N00.getNode());
    }
    return true;
}

fn X86DAGToDAGISel::PostprocessISelDAG(self) {
    if self.TM.getOptLevel() == None {
        return;
    }
    let mut Position: allnodes_iterator = self.CurDAG.allnodes_end();
    let mut MadeChange: bool = false;
    while Position != self.CurDAG.allnodes_begin() {
        let mut N: *mut SDNode = &mut operator(operator(Position));
        if N.use_empty() || !N.isMachineOpcode() {
            continue;
        }
        if self.tryOptimizeRem8Extend(N) {
            MadeChange = true;
            continue;
        }
        let mut Opc: u32 = N.getMachineOpcode();
        match Opc {
            _ => {
                continue;
            },
            SUBREG_TO_REG => {
                let mut SubRegIdx: u32 = N.getConstantOperandVal(1);
                if  {
                    continue;
                }
                let mut Move: SDValue = N.getOperand(0);
                if !Move.isMachineOpcode() {
                    continue;
                }
                match Move.getMachineOpcode() {
                    _ => {
                        continue;
                    },
                }
                let mut In: SDValue = Move.getOperand(0);
                if !In.isMachineOpcode() || In.getMachineOpcode() <= GENERIC_OP_END {
                    continue;
                }
                let mut TSFlags: u64 = self.getInstrInfo()(In.getMachineOpcode());
                if (TSFlags & EncodingMask) != VEX && (TSFlags & EncodingMask) != EVEX && (TSFlags & EncodingMask) != XOP {
                    continue;
                }
                self.CurDAG.UpdateNodeOperands(N, In, N.getOperand(1));
                MadeChange = true;
            },
        }
    }
    if MadeChange {
        self.CurDAG.RemoveDeadNodes();
    }
}

fn X86DAGToDAGISel::emitSpecialCodeForMain(self) {
    if self.Subtarget.isTargetCygMing() {
        let mut Args: i32 = 0;
        let mut DL: *DataLayout = self.CurDAG.getDataLayout();
        let mut CLI: CallLoweringInfo = CallLoweringInfo { *self.CurDAG };
        CLI.setChain(self.CurDAG.getRoot())(C, getVoidTy(*self.CurDAG.getContext()), self.CurDAG("__main", self.TLI.getPointerTy), move());
        let mut TLI: *TargetLowering = self.CurDAG.getTargetLoweringInfo();
        let mut Result: pair<SDValue, SDValue> = TLI.LowerCallTo(CLI);
        self.CurDAG.setRoot(Result.second);
    }
}

fn X86DAGToDAGISel::emitFunctionEntryCode(self) {
    let mut F: *Function = self.MF.getFunction();
    if F.hasExternalLinkage() && F.getName() == "main" {
        self.emitSpecialCodeForMain();
    }
}

fn isDispSafeForFrameIndexOrRegBase(Val: i64) -> bool {
    return isInt(Val);
}

fn X86DAGToDAGISel::foldOffsetIntoAddress(self, Offset: u64, AM: *mut X86ISelAddressMode) -> bool {
    let mut Val: i64 = AM.Disp + Offset;
    if Val != 0 && (AM.ES || AM.MCSym) {
        return true;
    }
    let mut M: Model = self.TM.getCodeModel();
    if self.Subtarget() {
        if Val != 0 && !isOffsetSuitableForCodeModel(Val, M, AM.hasSymbolicDisplacement()) {
            return true;
        }
        if AM.BaseType == FrameIndexBase && !isDispSafeForFrameIndexOrRegBase(Val) {
            return true;
        }
        if self.Subtarget.isTarget64BitILP32() && !isDispSafeForFrameIndexOrRegBase(Val as u32) && !AM.hasBaseOrIndexReg() {
            return true;
        }
    } else if self.Subtarget() {
        if Val < -65535 as i64 || Val > 65535 as i64 {
            return true;
        }
    } else if AM.hasBaseOrIndexReg() && !isDispSafeForFrameIndexOrRegBase(Val) {
        return true;
    }
    AM.Disp = Val;
    return false;
}

fn X86DAGToDAGISel::matchLoadInAddress(self, N: *mut LoadSDNode, AM: *mut X86ISelAddressMode, AllowSegmentRegForX32: bool) -> bool {
    let mut Address: SDValue = N.getOperand(1);
    if isNullConstant(Address) && AM.Segment.getNode() == null && !self.IndirectTlsSegRefs && (self.Subtarget.isTargetGlibc() || self.Subtarget.isTargetMusl() || self.Subtarget.isTargetAndroid() || self.Subtarget.isTargetFuchsia()) {
        if self.Subtarget.isTarget64BitILP32() && !AllowSegmentRegForX32 {
            return true;
        }
        match N.getPointerInfo().getAddrSpace() {
            GS => {
                AM.Segment = self.CurDAG.getRegister;
            },
            FS => {
                AM.Segment = self.CurDAG.getRegister;
            },
        }
    }
    return true;
}

fn X86DAGToDAGISel::matchWrapper(self, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if AM.hasSymbolicDisplacement() {
        return true;
    }
    let mut IsRIPRelTLS: bool = false;
    let mut IsRIPRel: bool = false;
    if IsRIPRel {
        let mut Val: SDValue = N.getOperand(0);
        if Val.getOpcode() == TargetGlobalTLSAddress {
            IsRIPRelTLS = true;
        }
    }
    let mut M: Model = self.TM.getCodeModel();
    if self.Subtarget() && M == Large && !IsRIPRelTLS {
        return true;
    }
    if IsRIPRel && AM.hasBaseOrIndexReg() {
        return true;
    }
    let mut Backup: X86ISelAddressMode = AM;
    let mut Offset: i64 = 0;
    let mut N0: SDValue = N.getOperand(0);
    if  {
        AM.GV = ();
        AM.SymbolFlags = ();
        Offset = ();
    } else if  {
        AM.CP = ();
        AM.Alignment = ();
        AM.SymbolFlags = ();
        Offset = ();
    } else if  {
        AM.ES = ();
        AM.SymbolFlags = ();
    } else if  {
        AM.MCSym = ();
    } else if  {
        AM.JT = ();
        AM.SymbolFlags = ();
    } else if  {
        AM.BlockAddr = ();
        AM.SymbolFlags = ();
        Offset = ();
    } else {
        llvm_unreachable_internal("Unhandled symbol reference node.", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 2030);
    }
    if self.Subtarget() && !IsRIPRel && AM.GV && self.TM.isLargeGlobalValue(AM.GV) {
        AM = Backup;
        return true;
    }
    if self.foldOffsetIntoAddress(Offset, AM) {
        AM = Backup;
        return true;
    }
    if IsRIPRel {
        AM.setBaseReg(self.CurDAG.getRegister);
    }
    return false;
}

fn X86DAGToDAGISel::matchAddress(self, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if self.matchAddressRecursively(N, AM, 0) {
        return true;
    }
    if self.Subtarget.isTarget64BitILP32() && AM.BaseType == RegBase && AM.Base_Reg.getNode() != null && AM.IndexReg.getNode() == null {
        let mut Save_Base_Reg: SDValue = AM.Base_Reg;
        if  {
            AM.Base_Reg = SDValue {};
            if self.matchLoadInAddress(AM, true) {
                AM.Base_Reg = Save_Base_Reg;
            }
        }
    }
    if AM.Scale == 2 && !AM.NegateIndex && AM.BaseType == RegBase && AM.Base_Reg.getNode() == null {
        AM.Base_Reg = AM.IndexReg;
        AM.Scale = 1;
    }
    if self.TM.getCodeModel() != Large && (!AM.GV || !self.TM.isLargeGlobalValue(AM.GV)) && self.Subtarget() && AM.Scale == 1 && AM.BaseType == RegBase && AM.Base_Reg.getNode() == null && AM.IndexReg.getNode() == null && AM.SymbolFlags == MO_NO_FLAG && AM.hasSymbolicDisplacement() {
        if isa_and_nonnull(AM.GV) && AM.Disp < -16 * 1024 * 1024 {
            return true;
        }
        AM.Base_Reg = self.CurDAG.getRegister;
    }
    return false;
}

fn X86DAGToDAGISel::hasMaterializingUse(self: *X86DAGToDAGISel, V: SDValue) -> bool {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    for U in operator(V).uses() {
        if U.getResNo() != V.getResNo() {
            continue;
        }
        let mut User: *mut SDNode = U.getUser();
        if User.getOpcode() == CopyToReg {
            return true;
        }
        if  {
            if St()() == V {
                return true;
            }
            continue;
        }
        if !User.isMachineOpcode() {
            continue;
        }
        let mut Desc: *MCInstrDesc = TII.get;
        if !Desc.mayStore() {
            continue;
        }
        let mut MemRefBegin: i32 = getMemoryOperandNo(Desc.TSFlags);
        if MemRefBegin < 0 {
            continue;
        }
        let mut MemRefEnd: u32 = MemRefBegin + AddrNumOperands;
        for let mut I: u32 = 0;
let mut E: u32 = User.getNumOperands(); I != E; I += 1 {
            if I >= MemRefBegin as u32 && I < MemRefEnd {
                continue;
            }
            let mut Opnd: SDValue = User.getOperand(I);
            if Opnd.getValueType() == EVT { Other } || Opnd.getValueType() == EVT { Glue } {
                continue;
            }
            if Opnd == V {
                return true;
            }
        }
    }
    return false;
}

fn X86DAGToDAGISel::matchAdd(self, N: *mut SDValue, AM: *mut X86ISelAddressMode, Depth: u32) -> bool {
    let mut Handle: HandleSDNode = HandleSDNode { N };
    let mut IsAddOrAddLike: Closure_2 = Closure_2 { cap_0: self };
    let mut SplitsMaterializedValue: Closure_3 = Closure_3 { AM: &mut AM, cap_1: self, IsAddOrAddLike: &mut IsAddOrAddLike };
    let mut MatchOperand: Closure_4 = Closure_4 { SplitsMaterializedValue: &mut SplitsMaterializedValue, AM: &mut AM, cap_2: self, Depth: &mut Depth };
    let mut Backup: X86ISelAddressMode = AM;
    if !MatchOperand.call(N.getOperand(0)) && !MatchOperand.call(Handle.getValue().getOperand(1)) {
        return false;
    }
    AM = Backup;
    if !MatchOperand.call(Handle.getValue().getOperand(1)) && !MatchOperand.call(Handle.getValue().getOperand(0)) {
        return false;
    }
    AM = Backup;
    if AM.BaseType == RegBase && !AM.Base_Reg.getNode() && !AM.IndexReg.getNode() {
        N = Handle.getValue();
        AM.Base_Reg = N.getOperand(0);
        AM.IndexReg = N.getOperand(1);
        AM.Scale = 1;
        return false;
    }
    N = Handle.getValue();
    return true;
}

fn insertDAGNode(DAG: *mut SelectionDAG, Pos: SDValue, N: SDValue) {
    if operator(N).getNodeId() == -1 || (getUninvalidatedNodeId(N.getNode()) > getUninvalidatedNodeId(Pos.getNode())) {
        DAG.RepositionNode(operator(Pos).getIterator(), N.getNode());
        operator(N).setNodeId(operator(Pos).getNodeId());
        InvalidateNodeId(N.getNode());
    }
}

fn foldMaskAndShiftToExtract(DAG: *mut SelectionDAG, N: SDValue, Mask: u64, Shift: SDValue, X: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if Shift.getOpcode() != SRL || !isa(Shift.getOperand(1)) || !Shift.hasOneUse() {
        return true;
    }
    let mut ScaleLog: i32 = 8 - Shift.getConstantOperandVal(1);
    if ScaleLog <= 0 || ScaleLog >= 4 || Mask != (255 << ScaleLog) {
        return true;
    }
    let mut XVT: MVT = X.getSimpleValueType();
    let mut VT: MVT = N.getSimpleValueType();
    let mut DL: SDLoc = SDLoc { N };
    let mut Eight: SDValue = DAG.getConstant(8, DL, EVT { i8 }, false, false);
    let mut NewMask: SDValue = DAG.getConstant(255, DL, EVT { XVT }, false, false);
    let mut Srl: SDValue = DAG.getNode(SRL, DL, EVT { XVT }, X, Eight);
    let mut And: SDValue = DAG.getNode(AND, DL, EVT { XVT }, Srl, NewMask);
    let mut Ext: SDValue = DAG.getZExtOrTrunc(And, DL, EVT { VT });
    let mut ShlCount: SDValue = DAG.getConstant(ScaleLog, DL, EVT { i8 }, false, false);
    let mut Shl: SDValue = DAG.getNode(SHL, DL, EVT { VT }, Ext, ShlCount);
    insertDAGNode(DAG, N, Eight);
    insertDAGNode(DAG, N, NewMask);
    insertDAGNode(DAG, N, Srl);
    insertDAGNode(DAG, N, And);
    insertDAGNode(DAG, N, Ext);
    insertDAGNode(DAG, N, ShlCount);
    insertDAGNode(DAG, N, Shl);
    DAG.ReplaceAllUsesWith(N, Shl);
    DAG.RemoveDeadNode(N.getNode());
    AM.IndexReg = Ext;
    AM.Scale = (1 << ScaleLog);
    return false;
}

fn foldMaskedShiftToScaledMask(DAG: *mut SelectionDAG, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    let mut Shift: SDValue = N.getOperand(0);
    let mut Mask: i64 = cast(operator(N).getOperand(1))();
    let mut FoundAnyExtend: bool = false;
    if Shift.getOpcode() == ANY_EXTEND && Shift.hasOneUse() && Shift.getOperand(0).getSimpleValueType() == i32 && isUInt(Mask) {
        FoundAnyExtend = true;
        Shift = Shift.getOperand(0);
    }
    if Shift.getOpcode() != SHL || !isa(Shift.getOperand(1)) {
        return true;
    }
    let mut X: SDValue = Shift.getOperand(0);
    if !N.hasOneUse() || !Shift.hasOneUse() {
        return true;
    }
    let mut ShiftAmt: u32 = Shift.getConstantOperandVal(1);
    if ShiftAmt != 1 && ShiftAmt != 2 && ShiftAmt != 3 {
        return true;
    }
    let mut VT: MVT = N.getSimpleValueType();
    let mut DL: SDLoc = SDLoc { N };
    if FoundAnyExtend {
        let mut NewX: SDValue = DAG.getNode(ANY_EXTEND, DL, EVT { VT }, X);
        insertDAGNode(DAG, N, NewX);
        X = NewX;
    }
    let mut NewMask: SDValue = DAG.getSignedConstant(Mask >> ShiftAmt, DL, EVT { VT }, false, false);
    let mut NewAnd: SDValue = DAG.getNode(AND, DL, EVT { VT }, X, NewMask);
    let mut NewShift: SDValue = DAG.getNode(SHL, DL, EVT { VT }, NewAnd, Shift.getOperand(1));
    insertDAGNode(DAG, N, NewMask);
    insertDAGNode(DAG, N, NewAnd);
    insertDAGNode(DAG, N, NewShift);
    DAG.ReplaceAllUsesWith(N, NewShift);
    DAG.RemoveDeadNode(N.getNode());
    AM.Scale = 1 << ShiftAmt;
    AM.IndexReg = NewAnd;
    return false;
}

fn foldMaskAndShiftToScale(DAG: *mut SelectionDAG, N: SDValue, Mask: u64, Shift: SDValue, X: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if Shift.getOpcode() != SRL || !Shift.hasOneUse() || !isa(Shift.getOperand(1)) {
        return true;
    }
    let mut MaskIdx: u32 = 0;
    let mut MaskLen: u32 = 0;
    if !isShiftedMask_64(Mask, MaskIdx, MaskLen) {
        return true;
    }
    let mut MaskLZ: u32 = 64 - (MaskIdx + MaskLen);
    let mut ShiftAmt: u32 = Shift.getConstantOperandVal(1);
    let mut AMShiftAmt: u32 = MaskIdx;
    if AMShiftAmt == 0 || AMShiftAmt > 3 {
        return true;
    }
    let mut ScaleDown: u32 = (64 - X.getSimpleValueType().getSizeInBits().operator unsigned long long()) + ShiftAmt;
    if MaskLZ < ScaleDown {
        return true;
    }
    MaskLZ -= ScaleDown;
    let mut ReplacingAnyExtend: bool = false;
    if X.getOpcode() == ANY_EXTEND {
        let mut ExtendBits: u32 = X.getSimpleValueType().getSizeInBits() - X.getOperand(0).getSimpleValueType().getSizeInBits().operator unsigned long long();
        X = X.getOperand(0);
        MaskLZ = if ExtendBits > MaskLZ { 0 } else { MaskLZ - ExtendBits };
        ReplacingAnyExtend = true;
    }
    let mut MaskedHighBits: APInt = getHighBitsSet(X.getSimpleValueType().getSizeInBits().operator unsigned long long(), MaskLZ);
    if !DAG.MaskedValueIsZero(X, MaskedHighBits, 0) {
        return true;
    }
    let mut VT: MVT = N.getSimpleValueType();
    if ReplacingAnyExtend {
        assert!(X.getValueType() != EVT { VT });
        let mut NewX: SDValue = DAG.getNode(ZERO_EXTEND, SDLoc { X }, EVT { VT }, X);
        insertDAGNode(DAG, N, NewX);
        X = NewX;
    }
    let mut XVT: MVT = X.getSimpleValueType();
    let mut DL: SDLoc = SDLoc { N };
    let mut NewSRLAmt: SDValue = DAG.getConstant(ShiftAmt + AMShiftAmt, DL, EVT { i8 }, false, false);
    let mut NewSRL: SDValue = DAG.getNode(SRL, DL, EVT { XVT }, X, NewSRLAmt);
    let mut NewExt: SDValue = DAG.getZExtOrTrunc(NewSRL, DL, EVT { VT });
    let mut NewSHLAmt: SDValue = DAG.getConstant(AMShiftAmt, DL, EVT { i8 }, false, false);
    let mut NewSHL: SDValue = DAG.getNode(SHL, DL, EVT { VT }, NewExt, NewSHLAmt);
    insertDAGNode(DAG, N, NewSRLAmt);
    insertDAGNode(DAG, N, NewSRL);
    insertDAGNode(DAG, N, NewExt);
    insertDAGNode(DAG, N, NewSHLAmt);
    insertDAGNode(DAG, N, NewSHL);
    DAG.ReplaceAllUsesWith(N, NewSHL);
    DAG.RemoveDeadNode(N.getNode());
    AM.Scale = 1 << AMShiftAmt;
    AM.IndexReg = NewExt;
    return false;
}

fn foldMaskedShiftToBEXTR(DAG: *mut SelectionDAG, N: SDValue, Mask: u64, Shift: SDValue, X: SDValue, AM: *mut X86ISelAddressMode, Subtarget: *X86Subtarget) -> bool {
    if Shift.getOpcode() != SRL || !isa(Shift.getOperand(1)) || !Shift.hasOneUse() || !N.hasOneUse() {
        return true;
    }
    if operator!(Subtarget()()) && operator!((Subtarget()() && Subtarget()())) {
        return true;
    }
    let mut MaskIdx: u32 = 0;
    let mut MaskLen: u32 = 0;
    if !isShiftedMask_64(Mask, MaskIdx, MaskLen) {
        return true;
    }
    let mut ShiftAmt: u32 = Shift.getConstantOperandVal(1);
    let mut AMShiftAmt: u32 = MaskIdx;
    if AMShiftAmt == 0 || AMShiftAmt > 3 {
        return true;
    }
    let mut XVT: MVT = X.getSimpleValueType();
    let mut VT: MVT = N.getSimpleValueType();
    let mut DL: SDLoc = SDLoc { N };
    let mut NewSRLAmt: SDValue = DAG.getConstant(ShiftAmt + AMShiftAmt, DL, EVT { i8 }, false, false);
    let mut NewSRL: SDValue = DAG.getNode(SRL, DL, EVT { XVT }, X, NewSRLAmt);
    let mut NewMask: SDValue = DAG.getConstant(Mask >> AMShiftAmt, DL, EVT { XVT }, false, false);
    let mut NewAnd: SDValue = DAG.getNode(AND, DL, EVT { XVT }, NewSRL, NewMask);
    let mut NewExt: SDValue = DAG.getZExtOrTrunc(NewAnd, DL, EVT { VT });
    let mut NewSHLAmt: SDValue = DAG.getConstant(AMShiftAmt, DL, EVT { i8 }, false, false);
    let mut NewSHL: SDValue = DAG.getNode(SHL, DL, EVT { VT }, NewExt, NewSHLAmt);
    insertDAGNode(DAG, N, NewSRLAmt);
    insertDAGNode(DAG, N, NewSRL);
    insertDAGNode(DAG, N, NewMask);
    insertDAGNode(DAG, N, NewAnd);
    insertDAGNode(DAG, N, NewExt);
    insertDAGNode(DAG, N, NewSHLAmt);
    insertDAGNode(DAG, N, NewSHL);
    DAG.ReplaceAllUsesWith(N, NewSHL);
    DAG.RemoveDeadNode(N.getNode());
    AM.Scale = 1 << AMShiftAmt;
    AM.IndexReg = NewExt;
    return false;
}

fn X86DAGToDAGISel::matchIndexRecursively(self, N: SDValue, AM: *mut X86ISelAddressMode, Depth: u32) -> SDValue {
    assert!(AM.IndexReg.getNode() == null, "IndexReg already matched");
    assert!((AM.Scale == 1 || AM.Scale == 2 || AM.Scale == 4 || AM.Scale == 8), "Illegal index scale");
    if Depth >= MaxRecursionDepth {
        return N;
    }
    let mut VT: EVT = N.getValueType();
    let mut Opc: u32 = N.getOpcode();
    if self.CurDAG.isBaseWithConstantOffset(N) {
        let mut AddVal: *mut auto = cast(N.getOperand(1));
        let mut Offset: u64 = () as u64 * AM.Scale;
        if !self.foldOffsetIntoAddress(Offset, AM) {
            return self.matchIndexRecursively(N.getOperand(0), AM, Depth + 1);
        }
    }
    if Opc == ADD && N.getOperand(0) == N.getOperand(1) {
        if AM.Scale <= 4 {
            AM.Scale *= 2;
            return self.matchIndexRecursively(N.getOperand(0), AM, Depth + 1);
        }
    }
    if  {
        let mut ShiftAmt: u64 = N.getConstantOperandVal(1);
        let mut ScaleAmt: u64 = 1 << ShiftAmt;
        if (AM.Scale * ScaleAmt) <= 8 {
            AM.Scale *= ScaleAmt;
            return self.matchIndexRecursively(N.getOperand(0), AM, Depth + 1);
        }
    }
    if Opc == SIGN_EXTEND && !VT.isVector() && N.hasOneUse() {
        let mut Src: SDValue = N.getOperand(0);
        if Src.getOpcode() == ADD && operator(Src).getFlags().hasNoSignedWrap() && Src.hasOneUse() {
            if self.CurDAG.isBaseWithConstantOffset(Src) {
                let mut AddSrc: SDValue = Src.getOperand(0);
                let mut AddVal: *mut auto = cast(Src.getOperand(1));
                let mut Offset: i64 = ();
                if !self.foldOffsetIntoAddress(Offset as u64 * AM.Scale, AM) {
                    let mut DL: SDLoc = SDLoc { N };
                    let mut ExtSrc: SDValue = self.CurDAG.getNode(Opc, DL, VT, AddSrc);
                    let mut ExtVal: SDValue = self.CurDAG.getSignedConstant(Offset, DL, VT, false, false);
                    let mut ExtAdd: SDValue = self.CurDAG.getNode(ADD, DL, VT, ExtSrc, ExtVal);
                    insertDAGNode(*self.CurDAG, N, ExtSrc);
                    insertDAGNode(*self.CurDAG, N, ExtVal);
                    insertDAGNode(*self.CurDAG, N, ExtAdd);
                    self.CurDAG.ReplaceAllUsesWith(N, ExtAdd);
                    self.CurDAG.RemoveDeadNode(N.getNode());
                    return ExtSrc;
                }
            }
        }
    }
    if Opc == ZERO_EXTEND && !VT.isVector() && N.hasOneUse() {
        let mut Src: SDValue = N.getOperand(0);
        let mut SrcOpc: u32 = Src.getOpcode();
        if ((SrcOpc == ADD && operator(Src).getFlags().hasNoUnsignedWrap()) || self.CurDAG.isADDLike(Src, true)) && Src.hasOneUse() {
            if self.CurDAG.isBaseWithConstantOffset(Src) {
                let mut AddSrc: SDValue = Src.getOperand(0);
                let mut Offset: u64 = Src.getConstantOperandVal(1);
                if !self.foldOffsetIntoAddress(Offset * AM.Scale, AM) {
                    let mut DL: SDLoc = SDLoc { N };
                    let mut Res: SDValue = SDValue {};
                    if AddSrc.getOpcode() == SHL && isa(AddSrc.getOperand(1)) {
                        let mut ShVal: SDValue = AddSrc.getOperand(0);
                        let mut ShAmt: u64 = AddSrc.getConstantOperandVal(1);
                        let mut HiBits: APInt = getHighBitsSet(AddSrc.getScalarValueSizeInBits(), ShAmt);
                        let mut ScaleAmt: u64 = 1 << ShAmt;
                        if (AM.Scale * ScaleAmt) <= 8 && (operator(AddSrc).getFlags().hasNoUnsignedWrap() || self.CurDAG.MaskedValueIsZero(ShVal, HiBits, 0)) {
                            AM.Scale *= ScaleAmt;
                            let mut ExtShVal: SDValue = self.CurDAG.getNode(Opc, DL, VT, ShVal);
                            let mut ExtShift: SDValue = self.CurDAG.getNode(SHL, DL, VT, ExtShVal, AddSrc.getOperand(1));
                            insertDAGNode(*self.CurDAG, N, ExtShVal);
                            insertDAGNode(*self.CurDAG, N, ExtShift);
                            AddSrc = ExtShift;
                            Res = ExtShVal;
                        }
                    }
                    let mut ExtSrc: SDValue = self.CurDAG.getNode(Opc, DL, VT, AddSrc);
                    let mut ExtVal: SDValue = self.CurDAG.getConstant(Offset, DL, VT, false, false);
                    let mut ExtAdd: SDValue = self.CurDAG.getNode(SrcOpc, DL, VT, ExtSrc, ExtVal);
                    insertDAGNode(*self.CurDAG, N, ExtSrc);
                    insertDAGNode(*self.CurDAG, N, ExtVal);
                    insertDAGNode(*self.CurDAG, N, ExtAdd);
                    self.CurDAG.ReplaceAllUsesWith(N, ExtAdd);
                    self.CurDAG.RemoveDeadNode(N.getNode());
                    return if Res {} else { ExtSrc };
                }
            }
        }
    }
    return N;
}

fn X86DAGToDAGISel::matchAddressRecursively(self, N: SDValue, AM: *mut X86ISelAddressMode, Depth: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-isel", 1) {
            {
                dbgs() << "MatchAddress: ";
                AM.dump(self.CurDAG);
            }
        }
    }
        if !(false) { break; }
    }
    if Depth >= MaxRecursionDepth {
        return self.matchAddressBase(N, AM);
    }
    if AM.isRIPRelative() {
        if !(AM.ES || AM.MCSym) && AM.JT != -1 {
            return true;
        }
        if  {
            if operator!(self.foldOffsetIntoAddress(AM)) {
                return false;
            }
        }
        return true;
    }
    match N.getOpcode() {
        _ => {
            break;
        },
        LOCAL_RECOVER => {
            if !AM.hasSymbolicDisplacement() && AM.Disp == 0 {
                if  {
                    AM.MCSym = ();
                    return false;
                }
            }
            break;
        },
        Constant => {
            let mut Val: u64 = cast(N)();
            if !self.foldOffsetIntoAddress(Val, AM) {
                return false;
            }
            break;
        },
        LOAD => {
            if operator!(self.matchLoadInAddress(cast(N), AM)) {
                return false;
            }
        },
        FrameIndex => {
            if AM.BaseType == RegBase && AM.Base_Reg.getNode() == null && (operator!(self.Subtarget()) || isDispSafeForFrameIndexOrRegBase(AM.Disp)) {
                AM.BaseType = FrameIndexBase;
                AM.Base_FrameIndex = cast(N)();
                return false;
            }
        },
        SHL => {
            if AM.IndexReg.getNode() != null || AM.Scale != 1 {
                break;
            }
        },
        SRL => {
            if AM.IndexReg.getNode() != null || AM.Scale != 1 {
                break;
            }
            assert!(N.getSimpleValueType().getSizeInBits().operator unsigned long long() <= 64, "Unexpected value size!");
            let mut And: SDValue = N.getOperand(0);
            if And.getOpcode() != AND {
                break;
            }
            let mut X: SDValue = And.getOperand(0);
            if !isa(N.getOperand(1)) || !isa(And.getOperand(1)) {
                break;
            }
            let mut Mask: u64 = And.getConstantOperandVal(1) >> N.getConstantOperandVal(1);
            if !foldMaskAndShiftToScale(*self.CurDAG, N, Mask, N, X, AM) {
                return false;
            }
            break;
        },
        SMUL_LOHI => {
            UMUL_LOHI;
        },
        MUL => {
            if AM.BaseType == RegBase && AM.Base_Reg.getNode() == null && AM.IndexReg.getNode() == null {
                if  {
                    if CN()() == 3 || () == 5 || () == 9 {
                        AM.Scale = () - 1;
                        let mut MulVal: SDValue = N.getOperand(0);
                        let mut Reg: SDValue = SDValue {};
                        if MulVal.getNode().getOpcode() == ADD && MulVal.hasOneUse() && isa(MulVal.getOperand(1)) {
                            Reg = MulVal.getOperand(0);
                            let mut AddVal: *mut auto = cast(MulVal.getOperand(1));
                            let mut Disp: u64 = () * ();
                            if self.foldOffsetIntoAddress(Disp, AM) {
                                Reg = N.getOperand(0);
                            }
                        } else {
                            Reg = N.getOperand(0);
                        }
                        AM.IndexReg = AM.Base_Reg = Reg;
                        return false;
                    }
                }
            }
        },
        SUB => {
            let mut Handle: HandleSDNode = HandleSDNode { N };
            let mut Backup: X86ISelAddressMode = AM;
            if self.matchAddressRecursively(N.getOperand(0), AM, Depth + 1) {
                N = Handle.getValue();
                AM = Backup;
                break;
            }
            N = Handle.getValue();
            if AM.IndexReg.getNode() || AM.isRIPRelative() {
                AM = Backup;
                break;
            }
            let mut Cost: i32 = 0;
            let mut RHS: SDValue = N.getOperand(1);
            let mut NegScale: optional<unsigned int> = optional<unsigned int> {};
            if RHS.getOpcode() == SHL && RHS.hasOneUse() {
                if  {
                    let mut ShVal: u64 = ();
                    if ShVal >= 1 && ShVal <= 3 {
                        NegScale(1 << ShVal);
                        RHS = RHS.getOperand(0);
                        Cost -= 1;
                    }
                }
            }
            if !RHS.getNode().hasOneUse() || (!NegScale && RHS.getNode().getOpcode() == CopyFromReg) || RHS.getNode().getOpcode() == TRUNCATE || RHS.getNode().getOpcode() == ANY_EXTEND || (RHS.getNode().getOpcode() == ZERO_EXTEND && RHS.getOperand(0).getValueType() == EVT { i32 }) {
                Cost += 1;
            }
            let mut BaseIsNegatedValue: bool = NegScale && AM.BaseType == RegBase && AM.Base_Reg == RHS;
            if ((AM.BaseType == RegBase && AM.Base_Reg.getNode() && !AM.Base_Reg.getNode().hasOneUse()) || AM.BaseType == FrameIndexBase) && !BaseIsNegatedValue {
                Cost -= 1;
            }
            if (AM.hasSymbolicDisplacement() && !Backup.hasSymbolicDisplacement()) + ((AM.Disp != 0) && (Backup.Disp == 0)) + (AM.Segment.getNode() && !Backup.Segment.getNode()) >= 2 {
                Cost -= 1;
            }
            if Cost >= 0 {
                AM = Backup;
                break;
            }
            AM.IndexReg = RHS;
            AM.NegateIndex = true;
            AM.Scale = NegScale;
            return false;
        },
        OR => {
            XOR;
        },
        ADD => {
            if !self.matchAdd(N, AM, Depth) {
                return false;
            }
        },
        AND => {
            if AM.IndexReg.getNode() != null || AM.Scale != 1 {
                break;
            }
            assert!(N.getSimpleValueType().getSizeInBits().operator unsigned long long() <= 64, "Unexpected value size!");
            if !isa(N.getOperand(1)) {
                break;
            }
            if N.getOperand(0).getOpcode() == SRL {
                let mut Shift: SDValue = N.getOperand(0);
                let mut X: SDValue = Shift.getOperand(0);
                let mut Mask: u64 = N.getConstantOperandVal(1);
                if !foldMaskAndShiftToExtract(*self.CurDAG, N, Mask, Shift, X, AM) {
                    return false;
                }
                if !foldMaskAndShiftToScale(*self.CurDAG, N, Mask, Shift, X, AM) {
                    return false;
                }
                if !foldMaskedShiftToBEXTR(*self.CurDAG, N, Mask, Shift, X, AM, *self.Subtarget) {
                    return false;
                }
            }
            if !foldMaskedShiftToScaledMask(*self.CurDAG, N, AM) {
                return false;
            }
            break;
        },
        ZERO_EXTEND => {
            if AM.IndexReg.getNode() != null || AM.Scale != 1 {
                break;
            }
            let mut Src: SDValue = N.getOperand(0);
            if Src.getOpcode() == ADD || Src.getOpcode() == OR {
                if self.matchIndexRecursively(N, AM, Depth + 1) {
                    Index;
                } else if Index != N {
                    AM.IndexReg = Index;
                    return false;
                }
            }
            let mut Mask: APInt = getAllOnes(Src.getScalarValueSizeInBits());
            if Src.getOpcode() == AND && Src.hasOneUse() {
                if  {
                    Mask = ();
                    Src = Src.getOperand(0);
                }
            }
            if Src.getOpcode() == SHL && Src.hasOneUse() && operator(N).hasOneUse() {
                let mut ShlSrc: SDValue = Src.getOperand(0);
                let mut ShlAmt: SDValue = Src.getOperand(1);
                let mut ShAmtC: *mut auto = dyn_cast(ShlAmt);
                if operator!() {
                    break;
                }
                let mut ShAmtV: u32 = ();
                if ShAmtV > 3 {
                    break;
                }
                let mut HighZeros: APInt = getHighBitsSet(ShlSrc.getValueSizeInBits().operator unsigned long long(), ShAmtV);
                if !operator(Src).getFlags().hasNoUnsignedWrap() && !self.CurDAG.MaskedValueIsZero(ShlSrc, HighZeros & Mask, 0) {
                    break;
                }
                let mut SrcVT: MVT = ShlSrc.getSimpleValueType();
                let mut VT: MVT = N.getSimpleValueType();
                let mut DL: SDLoc = SDLoc { N };
                let mut Res: SDValue = ShlSrc;
                if !Mask.isAllOnes() {
                    Res = self.CurDAG.getConstant(Mask.lshr(ShAmtV), DL, EVT { SrcVT }, false, false);
                    insertDAGNode(*self.CurDAG, N, Res);
                    Res = self.CurDAG.getNode(AND, DL, EVT { SrcVT }, ShlSrc, Res);
                    insertDAGNode(*self.CurDAG, N, Res);
                }
                let mut Zext: SDValue = self.CurDAG.getNode(ZERO_EXTEND, DL, EVT { VT }, Res);
                insertDAGNode(*self.CurDAG, N, Zext);
                let mut NewShl: SDValue = self.CurDAG.getNode(SHL, DL, EVT { VT }, Zext, ShlAmt);
                insertDAGNode(*self.CurDAG, N, NewShl);
                self.CurDAG.ReplaceAllUsesWith(N, NewShl);
                self.CurDAG.RemoveDeadNode(N.getNode());
                AM.Scale = 1 << ShAmtV;
                AM.IndexReg = self.matchIndexRecursively(Zext, AM, Depth + 1);
                return false;
            }
            if Src.getOpcode() == SRL && !Mask.isAllOnes() {
                if !foldMaskAndShiftToExtract(*self.CurDAG, N, Mask.getZExtValue(), Src, Src.getOperand(0), AM) {
                    return false;
                }
                if !foldMaskAndShiftToScale(*self.CurDAG, N, Mask.getZExtValue(), Src, Src.getOperand(0), AM) {
                    return false;
                }
                if !foldMaskedShiftToBEXTR(*self.CurDAG, N, Mask.getZExtValue(), Src, Src.getOperand(0), AM, *self.Subtarget) {
                    return false;
                }
            }
            break;
        },
    }
    return self.matchAddressBase(N, AM);
}

fn X86DAGToDAGISel::matchAddressBase(self, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if AM.BaseType != RegBase || AM.Base_Reg.getNode() {
        if !AM.IndexReg.getNode() {
            AM.IndexReg = N;
            AM.Scale = 1;
            return false;
        }
        return true;
    }
    AM.BaseType = RegBase;
    AM.Base_Reg = N;
    return false;
}

fn X86DAGToDAGISel::matchVectorAddressRecursively(self, N: SDValue, AM: *mut X86ISelAddressMode, Depth: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-isel", 1) {
            {
                dbgs() << "MatchVectorAddress: ";
                AM.dump(self.CurDAG);
            }
        }
    }
        if !(false) { break; }
    }
    if Depth >= MaxRecursionDepth {
        return self.matchAddressBase(N, AM);
    }
    match N.getOpcode() {
        Constant => {
            let mut Val: u64 = cast(N)();
            if !self.foldOffsetIntoAddress(Val, AM) {
                return false;
            }
            break;
        },
        ADD => {
            let mut Handle: HandleSDNode = HandleSDNode { N };
            let mut Backup: X86ISelAddressMode = AM;
            if !self.matchVectorAddressRecursively(N.getOperand(0), AM, Depth + 1) && !self.matchVectorAddressRecursively(Handle.getValue().getOperand(1), AM, Depth + 1) {
                return false;
            }
            AM = Backup;
            if !self.matchVectorAddressRecursively(Handle.getValue().getOperand(1), AM, Depth + 1) && !self.matchVectorAddressRecursively(Handle.getValue().getOperand(0), AM, Depth + 1) {
                return false;
            }
            AM = Backup;
            N = Handle.getValue();
            break;
        },
    }
    return self.matchAddressBase(N, AM);
}

fn X86DAGToDAGISel::matchVectorAddress(self, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    return self.matchVectorAddressRecursively(N, AM, 0);
}

fn X86DAGToDAGISel::selectVectorAddr(self, Parent: *mut MemSDNode, BasePtr: SDValue, IndexOp: SDValue, ScaleOp: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    let mut AM: X86ISelAddressMode = X86ISelAddressMode {};
    AM.Scale = operator(ScaleOp).getAsZExtVal();
    if IndexOp.getScalarValueSizeInBits() == BasePtr.getScalarValueSizeInBits() {
        AM.IndexReg = self.matchIndexRecursively(IndexOp, AM, 0);
    } else {
        AM.IndexReg = IndexOp;
    }
    let mut AddrSpace: u32 = Parent.getPointerInfo().getAddrSpace();
    if AddrSpace == GS {
        AM.Segment = self.CurDAG.getRegister;
    }
    if AddrSpace == FS {
        AM.Segment = self.CurDAG.getRegister;
    }
    if AddrSpace == SS {
        AM.Segment = self.CurDAG.getRegister;
    }
    let mut DL: SDLoc = SDLoc { BasePtr };
    let mut VT: MVT = BasePtr.getSimpleValueType();
    if self.matchVectorAddress(BasePtr, AM) {
        return false;
    }
    self.getAddressOperands(AM, DL, VT, Base, Scale, Index, Disp, Segment);
    return true;
}

fn X86DAGToDAGISel::selectAddr(self, Parent: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue, HasNDDM: bool) -> bool {
    let mut AM: X86ISelAddressMode = X86ISelAddressMode {};
    if  {
        let mut AddrSpace: u32 = cast(Parent)()();
        if AddrSpace == GS {
            AM.Segment = self.CurDAG.getRegister;
        }
        if AddrSpace == FS {
            AM.Segment = self.CurDAG.getRegister;
        }
        if AddrSpace == SS {
            AM.Segment = self.CurDAG.getRegister;
        }
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: MVT = N.getSimpleValueType();
    if self.matchAddress(N, AM) {
        return false;
    }
    if !HasNDDM && !AM.isRIPRelative() {
        return false;
    }
    self.getAddressOperands(AM, DL, VT, Base, Scale, Index, Disp, Segment);
    return true;
}

fn X86DAGToDAGISel::selectNDDAddr(self, Parent: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    return self.selectAddr(Parent, N, Base, Scale, Index, Disp, Segment, self.Subtarget());
}

fn X86DAGToDAGISel::selectMOV64Imm32(self, N: SDValue, Imm: *mut SDValue) -> bool {
    if self.TM.getCodeModel() == Kernel || self.TM.getCodeModel() == Large {
        return false;
    }
    if  {
        return false;
    }
    N = N.getOperand(0);
    if operator(N).getOpcode() == TargetGlobalTLSAddress {
        return false;
    }
    Imm = N;
    if operator(N).getOpcode() != TargetGlobalAddress {
        return self.TM.getCodeModel() == Small || self.TM.getCodeModel() == Medium;
    }
    let mut GV: *GlobalValue = cast(N)();
    if GV.getAbsoluteSymbolRange() {
        CR;
    } else {
        return operator(CR).getUnsignedMax().ult(1 << 32);
    }
    return !self.TM.isLargeGlobalValue(GV);
}

fn X86DAGToDAGISel::selectLEA64_Addr(self, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    let mut DL: SDLoc = SDLoc { N };
    if !self.selectLEAAddr(N, Base, Scale, Index, Disp, Segment) {
        return false;
    }
    let mut BaseType: EVT = Base.getValueType();
    let mut SubReg: u32 = 0;
    let mut RN: *mut auto = dyn_cast(Base);
    if RN() && () == 0 {
        Base = self.CurDAG.getRegister(Register { Reg: 0 }, EVT { i64 });
    } else if (BaseType == EVT { i8 } || BaseType == EVT { i16 } || BaseType == EVT { i32 }) && !isa(Base) {
        let mut ImplDef: SDValue = self.CurDAG;
        Base = self.CurDAG.getTargetInsertSubreg(SubReg, DL, EVT { i64 }, ImplDef, Base);
    }
    let mut IndexType: EVT = Index.getValueType();
    RN() = dyn_cast(Index);
    if RN() && () == 0 {
        Index = self.CurDAG.getRegister(Register { Reg: 0 }, EVT { i64 });
    } else {
        assert!((IndexType == BaseType), "Expect to be extending 8/16/32-bit registers for use in LEA");
        let mut ImplDef: SDValue = self.CurDAG;
        Index = self.CurDAG.getTargetInsertSubreg(SubReg, DL, EVT { i64 }, ImplDef, Index);
    }
    return true;
}

fn X86DAGToDAGISel::selectLEAAddr(self, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    let mut AM: X86ISelAddressMode = X86ISelAddressMode {};
    AM.IsForLEA = true;
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: MVT = N.getSimpleValueType();
    let mut Copy: SDValue = AM.Segment;
    let mut T: SDValue = self.CurDAG.getRegister(Register { Reg: 0 }, EVT { i32 });
    AM.Segment = T;
    if self.matchAddress(N, AM) {
        return false;
    }
    assert!(T == AM.Segment);
    AM.Segment = Copy;
    let mut Complexity: u32 = 0;
    if AM.BaseType == RegBase && AM.Base_Reg.getNode() {
        Complexity = 1;
    } else if AM.BaseType == FrameIndexBase {
        Complexity = 4;
    }
    if AM.IndexReg.getNode() {
        Complexity += 1;
    }
    if AM.Scale > 1 {
        Complexity += 1;
    }
    if AM.hasSymbolicDisplacement() {
        if self.Subtarget() {
            Complexity = 4;
        } else {
            Complexity += 2;
        }
    }
    if N.getOpcode() == ADD {
        let mut isMathWithFlags: Closure_5 = Closure_5 {};
        if isMathWithFlags.call(N.getOperand(0)) || isMathWithFlags.call(N.getOperand(1)) {
            Complexity += 1;
        }
    }
    if AM.Disp {
        Complexity += 1;
    }
    if Complexity <= 2 {
        return false;
    }
    self.getAddressOperands(AM, DL, VT, Base, Scale, Index, Disp, Segment);
    return true;
}

fn X86DAGToDAGISel::selectTLSADDRAddr(self, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    assert!(N.getOpcode() == TargetGlobalTLSAddress || N.getOpcode() == TargetExternalSymbol);
    let mut AM: X86ISelAddressMode = X86ISelAddressMode {};
    if  {
        AM.GV = ();
        operator+=(AM.Disp);
        AM.SymbolFlags = ();
    } else {
        let mut SA: *mut auto = cast(N);
        AM.ES = ();
        AM.SymbolFlags = ();
    }
    if self.Subtarget() {
        AM.Scale = 1;
        AM.IndexReg = self.CurDAG.getRegister;
    }
    let mut VT: MVT = N.getSimpleValueType();
    self.getAddressOperands(AM, SDLoc { N }, VT, Base, Scale, Index, Disp, Segment);
    return true;
}

fn X86DAGToDAGISel::selectRelocImm(self, N: SDValue, Op: *mut SDValue) -> bool {
    let mut VT: EVT = N.getValueType();
    let mut WasTruncated: bool = false;
    if N.getOpcode() == TRUNCATE {
        WasTruncated = true;
        N = N.getOperand(0);
    }
    if  {
        return false;
    }
    let mut Opc: u32 = operator(N.getOperand(0)).getOpcode();
    if Opc != TargetGlobalAddress || !WasTruncated {
        Op = N.getOperand(0);
        return !WasTruncated;
    }
    let mut GA: *mut auto = cast(N.getOperand(0));
    let mut CR: optional<ConstantRange> = ()();
    if !CR || operator(CR).getUnsignedMax().uge(1 << VT.getSizeInBits().operator unsigned long long()) {
        return false;
    }
    Op = self.CurDAG.getTargetGlobalAddress(SDLoc { N }, VT);
    return true;
}

fn X86DAGToDAGISel::tryFoldLoad(self, Root: *mut SDNode, P: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    assert!(Root && P, "Unknown root/parent nodes");
    if !isNON_EXTLoad(N.getNode()) || !self.IsProfitableToFold(N, P, Root) || !IsLegalToFold(N, P, Root, self.OptLevel, false) {
        return false;
    }
    return self.selectAddr(N.getNode(), N.getOperand(1), Base, Scale, Index, Disp, Segment, true);
}

fn X86DAGToDAGISel::tryFoldBroadcast(self, Root: *mut SDNode, P: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    assert!(Root && P, "Unknown root/parent nodes");
    if  {
        return false;
    }
    return self.selectAddr(N.getNode(), N.getOperand(1), Base, Scale, Index, Disp, Segment, true);
}

fn X86DAGToDAGISel::getGlobalBaseReg(self) -> *mut SDNode {
    let mut GlobalBaseReg: Register = self.getInstrInfo().getGlobalBaseReg(self.MF);
    let mut DL: *DataLayout = self.MF.getDataLayout();
    return self.CurDAG.getRegister(GlobalBaseReg, self.TLI.getPointerTy)();
}

fn X86DAGToDAGISel::isSExtAbsoluteSymbolRef(self: *X86DAGToDAGISel, Width: u32, N: *mut SDNode) -> bool {
    if N.getOpcode() == TRUNCATE {
        N = N.getOperand(0).getNode();
    }
    if  {
        return false;
    }
    let mut GA: *mut auto = dyn_cast(N.getOperand(0));
    if operator!() {
        return false;
    }
    let mut GV: *mut auto = ();
    let mut CR: optional<ConstantRange> = ();
    if CR {
        return operator(CR).getSignedMin().sge(-1 << Width) && operator(CR).getSignedMax().slt(1 << Width);
    }
    return self.TM.getCodeModel() != Large && Width == 32 && operator!(self.TM.isLargeGlobalValue());
}

fn X86DAGToDAGISel::getCondFromNode(self: *X86DAGToDAGISel, N: *mut SDNode) -> CondCode {
    assert!(N.isMachineOpcode(), "Unexpected node");
    let mut Opc: u32 = N.getMachineOpcode();
    let mut MCID: *MCInstrDesc = self.getInstrInfo()(Opc);
    let mut CondNo: i32 = getCondSrcNoFromDesc(MCID);
    if CondNo < 0 {
        return COND_INVALID;
    }
    return N.getConstantOperandVal(CondNo) as CondCode;
}

fn X86DAGToDAGISel::onlyUsesZeroFlag(self: *X86DAGToDAGISel, Flags: SDValue) -> bool {
    for Use in operator(Flags).uses() {
        if Use.getResNo() != Flags.getResNo() {
            continue;
        }
        let mut User: *mut SDNode = Use.getUser();
        if  {
            return false;
        }
        for FlagUse in User.uses() {
            if FlagUse.getResNo() != 1 {
                continue;
            }
            if !FlagUse.getUser().isMachineOpcode() {
                return false;
            }
            let mut CC: CondCode = self.getCondFromNode(FlagUse.getUser());
            match CC {
                COND_E => {
                    COND_NE;
                },
                _ => {
                    return false;
                },
            }
        }
    }
    return true;
}

fn X86DAGToDAGISel::hasNoSignFlagUses(self: *X86DAGToDAGISel, Flags: SDValue) -> bool {
    for Use in operator(Flags).uses() {
        if Use.getResNo() != Flags.getResNo() {
            continue;
        }
        let mut User: *mut SDNode = Use.getUser();
        if  {
            return false;
        }
        for FlagUse in User.uses() {
            if FlagUse.getResNo() != 1 {
                continue;
            }
            if !FlagUse.getUser().isMachineOpcode() {
                return false;
            }
            let mut CC: CondCode = self.getCondFromNode(FlagUse.getUser());
            match CC {
                COND_A => {
                    COND_AE;
                },
                _ => {
                    return false;
                },
            }
        }
    }
    return true;
}

fn mayUseCarryFlag(CC: CondCode) -> bool {
    match CC {
        COND_O => {
            COND_NO;
        },
        _ => {
            return true;
        },
    }
}

fn X86DAGToDAGISel::hasNoCarryFlagUses(self: *X86DAGToDAGISel, Flags: SDValue) -> bool {
    for Use in operator(Flags).uses() {
        if Use.getResNo() != Flags.getResNo() {
            continue;
        }
        let mut User: *mut SDNode = Use.getUser();
        let mut UserOpc: u32 = User.getOpcode();
        if UserOpc == CopyToReg {
            if  {
                return false;
            }
            for FlagUse in User.uses() {
                if FlagUse.getResNo() != 1 {
                    continue;
                }
                if !FlagUse.getUser().isMachineOpcode() {
                    return false;
                }
                let mut CC: CondCode = self.getCondFromNode(FlagUse.getUser());
                if mayUseCarryFlag(CC) {
                    return false;
                }
            }
            continue;
        }
        let mut CCOpNo: u32 = 0;
        match UserOpc {
            _ => {
                return false;
            },
        }
        let mut CC: CondCode = User.getConstantOperandVal(CCOpNo) as CondCode;
        if mayUseCarryFlag(CC) {
            return false;
        }
    }
    return true;
}

fn addrMayUseNonFixedFrameIndex(Addr: SDValue, MFI: *MachineFrameInfo, Depth: u32) -> bool {
    if  {
        return operator!(MFI.isFixedObjectIndex());
    }
    if Depth >= MaxRecursionDepth {
        return true;
    }
    match Addr.getOpcode() {
        ADD => {
            OR;
        },
        SUB => {
            return addrMayUseNonFixedFrameIndex(Addr.getOperand(0), MFI, Depth + 1);
        },
        _ => {
            return false;
        },
    }
}

fn X86DAGToDAGISel::checkTCRetEnoughRegs(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    let mut BasePtr: *SDValue = cast(N.getOperand(1))();
    if addrMayUseNonFixedFrameIndex(BasePtr, self.MF.getFrameInfo(), 0) {
        return false;
    }
    let mut RI: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut AvailGPRs: u32 = 0;
    if self.Subtarget() {
        let mut TCGPRs: *TargetRegisterClass = null;
        (((operator!(operator!((TCGPRs)))) || (_wassert(L"TCGPRs->contains(X86::RSP)", L"llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", (3749) as u32) , 0)) as void);
        (((operator!(operator!((TCGPRs)))) || (_wassert(L"TCGPRs->contains(X86::RIP)", L"llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", (3750) as u32) , 0)) as void);
        AvailGPRs = TCGPRs.getNumRegs() - 2;
    } else {
        let mut TCGPRs: *TargetRegisterClass = null;
        (((operator!(operator!((TCGPRs)))) || (_wassert(L"TCGPRs->contains(X86::ESP)", L"llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", (3758) as u32) , 0)) as void);
        AvailGPRs = TCGPRs.getNumRegs() - 1;
    }
    let mut LoadGPRs: u32 = 2;
    if self.Subtarget() {
        if isa(BasePtr) {
            LoadGPRs -= 2;
        } else if  {
            if self.getTargetMachine().isPositionIndependent {
                return false;
            }
            LoadGPRs -= 1;
        }
    }
    let mut ArgGPRs: u32 = 0;
    for let mut I: u32 = 3;
let mut E: u32 = N.getNumOperands(); I != E; I += 1 {
        if  {
            if operator!(RI()(*self.MF)) {
                continue;
            }
            if ArgGPRs += 1 + LoadGPRs > AvailGPRs {
                return false;
            }
        }
    }
    return true;
}

fn isFusableLoadOpStorePattern(StoreNode: *mut StoreSDNode, StoredVal: SDValue, CurDAG: *mut SelectionDAG, LoadOpNo: u32, LoadNode: *mut *mut LoadSDNode, InputChain: *mut SDValue) -> bool {
    if StoredVal.getResNo() != 0 {
        return false;
    }
    if !StoredVal.getNode().hasNUsesOfValue(1, 0) {
        return false;
    }
    if !isNormalStore(StoreNode) || StoreNode.isNonTemporal() {
        return false;
    }
    let mut Load: SDValue = operator(StoredVal).getOperand(LoadOpNo);
    if !isNormalLoad(Load.getNode()) {
        return false;
    }
    LoadNode = cast(Load);
    if !Load.hasOneUse() {
        return false;
    }
    if LoadNode.getBasePtr() != StoreNode.getBasePtr() || LoadNode.getOffset() != StoreNode.getOffset() {
        return false;
    }
    let mut FoundLoad: bool = false;
    let mut ChainOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut LoopWorklist: SmallVector<const SDNode *, 4> = zeroed();
    let mut Visited: SmallPtrSet<const SDNode *, 16> = zeroed();
    let mut Max: u32 = 1024;
    let mut Chain: SDValue = StoreNode.getChain();
    if Chain == Load.getValue(1) {
        FoundLoad = true;
        ChainOps.push(ValueParamT { Load.getOperand(0) });
    } else if Chain.getOpcode() == TokenFactor {
        for let mut i: u32 = 0;
let mut e: u32 = Chain.getNumOperands(); i != e; i += 1 {
            let mut Op: SDValue = Chain.getOperand(i);
            if Op == Load.getValue(1) {
                FoundLoad = true;
                ChainOps.push(ValueParamT { Load.getOperand(0) });
                continue;
            }
            LoopWorklist()(Op.getNode());
            ChainOps.push(ValueParamT { Op });
        }
    }
    if !FoundLoad {
        return false;
    }
    for Op in operator(StoredVal).ops() {
        if Op.getNode() != LoadNode {
            LoopWorklist()(Op.getNode());
        }
    }
    if hasPredecessorHelper(Load.getNode(), Max, true) {
        return false;
    }
    InputChain = CurDAG;
    return true;
}

fn X86DAGToDAGISel::foldLoadStoreIntoMemOperand(self, Node: *mut SDNode) -> bool {
    let mut StoreNode: *mut auto = cast(Node);
    let mut StoredVal: SDValue = (1);
    let mut Opc: u32 = operator(StoredVal).getOpcode();
    let mut MemVT: EVT = ();
    if MemVT != EVT { i64 } && MemVT != EVT { i32 } && MemVT != EVT { i16 } && MemVT != EVT { i8 } {
        return false;
    }
    let mut IsCommutable: bool = false;
    let mut IsNegate: bool = false;
    match Opc {
        _ => {
            return false;
        },
    }
    let mut LoadOpNo: u32 = if IsNegate { 1 } else { 0 };
    let mut LoadNode: *mut LoadSDNode = null;
    let mut InputChain: SDValue = SDValue {};
    if operator!(isFusableLoadOpStorePattern(StoredVal, self.CurDAG, LoadOpNo, LoadNode, InputChain)) {
        if !IsCommutable {
            return false;
        }
        LoadOpNo = 1;
        if operator!(isFusableLoadOpStorePattern(StoredVal, self.CurDAG, LoadOpNo, LoadNode, InputChain)) {
            return false;
        }
    }
    let mut Base: SDValue = SDValue {};
    let mut Scale: SDValue = SDValue {};
    let mut Index: SDValue = SDValue {};
    let mut Disp: SDValue = SDValue {};
    let mut Segment: SDValue = SDValue {};
    if !self.selectAddr(LoadNode, LoadNode.getBasePtr(), Base, Scale, Index, Disp, Segment, true) {
        return false;
    }
    let mut SelectOpcode: Closure_6 = Closure_6 { MemVT: &mut MemVT };
    let mut Result: *mut MachineSDNode = null;
    match Opc {
        _ => {
            llvm_unreachable_internal("Invalid opcode!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 4127);
        },
    }
    let mut MemOps: []*mut MachineMemOperand = void { (), LoadNode.getMemOperand() };
    self.CurDAG.setNodeMemRefs(Result, MemOps);
    self.ReplaceUses(SDValue { Node: LoadNode, ResNo: 1 }, SDValue { Node: Result, ResNo: 1 });
    self.ReplaceUses(SDValue { Node: Result, ResNo: 1 });
    self.ReplaceUses(SDValue { Node: StoredVal.getNode(), ResNo: 1 }, SDValue { Node: Result, ResNo: 0 });
    self.CurDAG.RemoveDeadNode(Node);
    return true;
}

fn X86DAGToDAGISel::matchBitExtract(self, Node: *mut SDNode) -> bool {
    assert!((Node.getOpcode() == ADD || Node.getOpcode() == AND || Node.getOpcode() == XOR || Node.getOpcode() == SRL), "Should be either an and-mask, a standalone low-bits mask, or right-shift after clearing high bits.");
    if operator!(self.Subtarget()) && operator!(self.Subtarget()) {
        return false;
    }
    let mut NVT: MVT = Node.getSimpleValueType(0);
    if NVT != i32 && NVT != i64 {
        return false;
    }
    let mut NBits: SDValue = SDValue {};
    let mut NegateNBits: bool = false;
    let mut AllowExtraUsesByDefault: bool = self.Subtarget();
    let mut checkUses: Closure_7 = Closure_7 { AllowExtraUsesByDefault: AllowExtraUsesByDefault };
    let mut checkOneUse: Closure_8 = Closure_8 { cap_0: checkUses };
    let mut checkTwoUse: Closure_9 = Closure_9 { cap_0: checkUses };
    let mut peekThroughOneUseTruncation: Closure_10 = Closure_10 { cap_0: checkOneUse };
    let mut matchPatternA: Closure_11 = Closure_11 { cap_0: checkOneUse, cap_1: peekThroughOneUseTruncation, NBits: &mut NBits, NegateNBits: &mut NegateNBits };
    let mut isAllOnes: Closure_12 = Closure_12 { cap_0: self, cap_1: peekThroughOneUseTruncation, cap_2: NVT };
    let mut matchPatternB: Closure_13 = Closure_13 { cap_0: checkOneUse, cap_1: isAllOnes, cap_2: peekThroughOneUseTruncation, NBits: &mut NBits, NegateNBits: &mut NegateNBits };
    let mut canonicalizeShiftAmt: Closure_14 = Closure_14 { NBits: &mut NBits, NegateNBits: &mut NegateNBits };
    let mut matchPatternC: Closure_15 = Closure_15 { cap_0: checkOneUse, cap_1: peekThroughOneUseTruncation, NegateNBits: &mut NegateNBits, cap_3: canonicalizeShiftAmt };
    let mut X: SDValue = SDValue {};
    let mut matchPatternD: Closure_16 = Closure_16 { cap_0: checkOneUse, cap_1: checkTwoUse, cap_2: canonicalizeShiftAmt, AllowExtraUsesByDefault: AllowExtraUsesByDefault, NegateNBits: &mut NegateNBits, X: &mut X };
    let mut matchLowBitMask: Closure_17 = Closure_17 { cap_0: matchPatternA, cap_1: matchPatternB, cap_2: matchPatternC };
    if Node.getOpcode() == AND {
        X = Node.getOperand(0);
        let mut Mask: SDValue = Node.getOperand(1);
        if matchLowBitMask.call(Mask) {} else {
            swap(X, Mask);
            if !matchLowBitMask.call(Mask) {
                return false;
            }
        }
    } else if matchLowBitMask.call(SDValue { Node: Node, ResNo: 0 }) {
        X = self.CurDAG.getAllOnesConstant(SDLoc { Node }, EVT { NVT }, false, false);
    } else if !matchPatternD.call(Node) {
        return false;
    }
    if NegateNBits && operator!(self.Subtarget()) {
        return false;
    }
    let mut DL: SDLoc = SDLoc { Node };
    if NBits.getSimpleValueType() != i8 {
        NBits = self.CurDAG.getNode(TRUNCATE, DL, EVT { i8 }, NBits);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
    }
    let mut Imm: *mut ConstantSDNode = null;
    if operator(NBits).getOpcode() == AND {
        if (Imm = dyn_cast(operator(NBits).getOperand(1))) {
            NBits = operator(NBits).getOperand(0);
        }
    }
    let mut ImplDef: SDValue = SDValue { Node: self.CurDAG.getMachineNode(IMPLICIT_DEF, DL, EVT { i32 }), ResNo: 0 };
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, ImplDef);
    let mut SRIdxVal: SDValue = self.CurDAG;
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, SRIdxVal);
    NBits = SDValue { Node: self.CurDAG.getMachineNode(INSERT_SUBREG, DL, EVT { i32 }, ImplDef, NBits, SRIdxVal), ResNo: 0 };
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
    if Imm {
        NBits = self.CurDAG.getNode(AND, DL, EVT { i32 }, NBits, self.CurDAG.getConstant(Imm.getZExtValue(), DL, EVT { i32 }, false, false));
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
    }
    if NegateNBits {
        let mut BitWidthC: SDValue = self.CurDAG.getConstant(NVT.getSizeInBits().operator unsigned long long(), DL, EVT { i32 }, false, false);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, BitWidthC);
        NBits = self.CurDAG.getNode(SUB, DL, EVT { i32 }, BitWidthC, NBits);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
    }
    if self.Subtarget() {
        if NVT != i32 {
            NBits = self.CurDAG.getNode(ANY_EXTEND, DL, EVT { NVT }, NBits);
            insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
        }
        let mut Extract: SDValue = self.CurDAG;
        self.ReplaceNode(Node, Extract.getNode());
        SelectCode(Extract.getNode());
        return true;
    }
    {
        let mut RealX: SDValue = peekThroughOneUseTruncation.call(X);
        if RealX != X && RealX.getOpcode() == SRL {
            X = RealX;
        }
    }
    let mut XVT: MVT = X.getSimpleValueType();
    let mut C8: SDValue = self.CurDAG.getConstant(8, DL, EVT { i8 }, false, false);
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, C8);
    let mut Control: SDValue = self.CurDAG.getNode(SHL, DL, EVT { i32 }, NBits, C8);
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, Control);
    if X.getOpcode() == SRL {
        let mut ShiftAmt: SDValue = X.getOperand(1);
        X = X.getOperand(0);
        assert!(ShiftAmt.getValueType() == EVT { i8 }, "Expected shift amount to be i8");
        let mut OrigShiftAmt: SDValue = ShiftAmt;
        ShiftAmt = self.CurDAG.getNode(ZERO_EXTEND, DL, EVT { i32 }, ShiftAmt);
        insertDAGNode(*self.CurDAG, OrigShiftAmt, ShiftAmt);
        Control = self.CurDAG.getNode(OR, DL, EVT { i32 }, Control, ShiftAmt);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, Control);
    }
    if XVT != i32 {
        Control = self.CurDAG.getNode(ANY_EXTEND, DL, EVT { XVT }, Control);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, Control);
    }
    let mut Extract: SDValue = self.CurDAG;
    if XVT != NVT {
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, Extract);
        Extract = self.CurDAG.getNode(TRUNCATE, DL, EVT { NVT }, Extract);
    }
    self.ReplaceNode(Node, Extract.getNode());
    SelectCode(Extract.getNode());
    return true;
}

fn X86DAGToDAGISel::matchBEXTRFromAndImm(self, Node: *mut SDNode) -> *mut MachineSDNode {
    let mut NVT: MVT = Node.getSimpleValueType(0);
    let mut dl: SDLoc = SDLoc { Node };
    let mut N0: SDValue = Node.getOperand(0);
    let mut N1: SDValue = Node.getOperand(1);
    let mut PreferBEXTR: bool = self.Subtarget() || (self.Subtarget() && self.Subtarget());
    if !PreferBEXTR && operator!(self.Subtarget()) {
        return null;
    }
    if operator(N0).getOpcode() != SRL && operator(N0).getOpcode() != SRA {
        return null;
    }
    if !operator(N0).hasOneUse() {
        return null;
    }
    if NVT != i32 && NVT != i64 {
        return null;
    }
    let mut MaskCst: *mut auto = dyn_cast(N1);
    let mut ShiftCst: *mut auto = dyn_cast(operator(N0).getOperand(1));
    if operator!() || operator!() {
        return null;
    }
    let mut Mask: u64 = ();
    if !isMask_64(Mask) {
        return null;
    }
