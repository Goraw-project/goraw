fn X86DAGToDAGISel::CheckComplexPattern(self, Root: *mut SDNode, Parent: *mut SDNode, N: SDValue, PatternNo: u32, Result: *mut pair<SDValue, SDNode *>>) -> bool {
    let mut NextRes: u32 = Result.len;
    match PatternNo {
        _ => {
            llvm_unreachable_internal("Invalid pattern # in table?", "P:/llvm-build/lib/Target/X86\\X86GenDAGISel.inc", 329100);
        },
        0 => {
            Result.resize(NextRes + 5);
        },
        1 => {
            Result.resize(NextRes + 5);
        },
        2 => {
            Result.resize(NextRes + 1);
        },
        3 => {
            Result.resize(NextRes + 5);
        },
        4 => {
            Result.resize(NextRes + 5);
        },
        5 => {
            Result.resize(NextRes + 5);
        },
        6 => {
            Result.resize(NextRes + 5);
        },
        7 => {
            Result.resize(NextRes + 5);
        },
        8 => {
            Result.resize(NextRes + 5);
        },
        9 => {
            Result.resize(NextRes + 5);
        },
        10 => {
            Result.resize(NextRes + 1);
        },
    }
}

fn X86DAGToDAGISel::RunSDNodeXForm(self, V: SDValue, XFormNo: u32) -> SDValue {
    match XFormNo {
        _ => {
            llvm_unreachable_internal("Invalid xform # in table?", "P:/llvm-build/lib/Target/X86\\X86GenDAGISel.inc", 329148);
        },
        0 => {
            let mut N: *mut SDNode = V.getNode();
            return self.getExtractVEXTRACTImmediate(N, 128, N);
        },
        1 => {
            let mut N: *mut SDNode = V.getNode();
            return self.getExtractVEXTRACTImmediate(N, 256, N);
        },
        2 => {
            let mut N: *mut ConstantSDNode = cast(V.getNode());
            return self.getI64Imm(N.getAPIntValue().countr_zero() as u8, N);
        },
        3 => {
            let mut N: *mut ConstantSDNode = cast(V.getNode());
            return self.getI8Imm(32 - N.getZExtValue(), N);
        },
        4 => {
            let mut N: *mut ConstantSDNode = cast(V.getNode());
            return self.getI8Imm(64 - N.getZExtValue(), N);
        },
        5 => {
            let mut N: *mut ConstantSDNode = cast(V.getNode());
            return self.getI32Imm(N.getZExtValue() as u32, N);
        },
        6 => {
            let mut N: *mut ConstantSDNode = cast(V.getNode());
            let mut Length: u32 = countr_one(N.getZExtValue());
            return self.getI32Imm(Length << 8, N);
        },
        7 => {
            let mut N: *mut ConstantSDNode = cast(V.getNode());
            return self.getI8Imm(countr_one(N.getZExtValue()), N);
        },
        8 => {
            let mut N: *mut ConstantSDNode = cast(V.getNode());
            return self.getI64Imm(N.getAPIntValue().countr_one() as u8, N);
        },
        9 => {
            let mut N: *mut ConstantSDNode = cast(V.getNode());
            let mut Imm: u8 = getSwappedVCMPImm(N.getZExtValue() & 31);
            return self.getI8Imm(Imm, N);
        },
        10 => {
            let mut N: *mut SDNode = V.getNode();
            let mut CC: CondCode = cast(N.getOperand(2)).get();
            let mut SSECC: u8 = getVPCMPImmForCond(CC);
            return self.getI8Imm(SSECC, N);
        },
        11 => {
            let mut N: *mut SDNode = V.getNode();
            let mut CC: CondCode = cast(N.getOperand(2)).get();
            let mut SSECC: u8 = getVPCMPImmForCond(CC);
            SSECC = getSwappedVPCMPImm(SSECC);
