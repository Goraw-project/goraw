            Imm |= 32;
        }
    }
    let mut DL: SDLoc = SDLoc { Root };
    let mut TImm: SDValue = self.CurDAG.getTargetConstant(Imm, DL, EVT { i8 }, false);
    let mut NVT: MVT = Root.getSimpleValueType(0);
    let mut MNode: *mut MachineSDNode = null;
    if FoldedLoad {
        let mut VTs: SDVTList = self.CurDAG.getVTList(EVT { NVT }, EVT { Other });
        let mut Opc: u32 = 0;
        if  {
            let mut MemIntr: *mut auto = cast(C);
            let mut EltSize: u32 = ()();
            assert!((EltSize == 32 || EltSize == 64), "Unexpected broadcast size!");
            let mut UseD: bool = EltSize == 32;
            if NVT.is128BitVector() {
                
            } else if NVT.is256BitVector() {
                
            } else if NVT.is512BitVector() {
                
            } else {
                llvm_unreachable_internal("Unexpected vector size!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 4988);
            }
