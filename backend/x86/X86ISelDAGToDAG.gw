            let mut NewOpc: u32 = 0;
            Control = SDValue { Node: self.CurDAG.getMachineNode(NewOpc, dl, EVT { NVT }, Control), ResNo: 0 };
        }
    }
    let mut NewNode: *mut MachineSDNode = null;
    let mut Input: SDValue = operator(N0).getOperand(0);
    let mut Tmp0: SDValue = SDValue {};
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    if self.tryFoldLoad(Node, N0.getNode(), Input, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
