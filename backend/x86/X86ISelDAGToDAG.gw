fn X86DAGToDAGISel::getValueTypeForHwMode(self: *X86DAGToDAGISel, Index: u32) -> MVT {
    match Index {
        _ => {
            llvm_unreachable_internal("Unexpected index", "P:/llvm-build/lib/Target/X86\\X86GenDAGISel.inc", 329480);
        },
        1 => {
            match self.HwMode {
                _ => {
                    return i32;
                },
                1 => {
                    return i64;
                },
                2 => {
                    return i32;
                },
            }
        },
        0 => {
            match self.HwMode {
                _ => {
                    return i32;
                },
                1 => {
                    return i64;
                },
                2 => {
                    return i64;
                },
            }
        },
    }
}

fn X86DAGToDAGISel::tryFoldLoad(self, P: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    return self.tryFoldLoad(P, P, N, Base, Scale, Index, Disp, Segment);
}

fn X86DAGToDAGISel::getAddressOperands(self, AM: *mut X86ISelAddressMode, DL: *SDLoc, VT: MVT, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) {
    if AM.BaseType == FrameIndexBase {
        Base = self.CurDAG.getTargetFrameIndex(AM.Base_FrameIndex, self.TLI.getPointerTy(self.CurDAG.getDataLayout(), 0));
    } else if AM.Base_Reg.getNode() {
        Base = AM.Base_Reg;
    } else {
        Base = self.CurDAG.getRegister(0, VT);
    }
    Scale = self.getI8Imm(AM.Scale, DL);
    if AM.NegateIndex {
        let mut NegOpc: u32 = 0;
        match VT.SimpleTy {
            _ => {
                llvm_unreachable_internal("Unsupported VT!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 292);
            },
            i64 => {
                NegOpc = (if self.Subtarget.hasNDD() { NEG64r_ND } else { NEG64r });
            },
            i32 => {
                NegOpc = (if self.Subtarget.hasNDD() { NEG32r_ND } else { NEG32r });
            },
            i16 => {
                NegOpc = (if self.Subtarget.hasNDD() { NEG16r_ND } else { NEG16r });
            },
            i8 => {
                NegOpc = (if self.Subtarget.hasNDD() { NEG8r_ND } else { NEG8r });
            },
        }
        let mut Neg: SDValue = SDValue { Node: self.CurDAG.getMachineNode(NegOpc, DL, VT, i32, AM.IndexReg), ResNo: 0 };
        AM.IndexReg = Neg;
    }
    if AM.IndexReg.getNode() {
        Index = AM.IndexReg;
    } else {
        Index = self.CurDAG.getRegister(0, VT);
    }
    if AM.GV {
        Disp = self.CurDAG.getTargetGlobalAddress(AM.GV, SDLoc {}, i32, AM.Disp, AM.SymbolFlags);
    } else if AM.CP {
        Disp = self.CurDAG.getTargetConstantPool(AM.CP, i32, AM.Alignment, AM.Disp, AM.SymbolFlags);
    } else if AM.ES {
        assert!(!AM.Disp, "Non-zero displacement is ignored with ES.");
        Disp = self.CurDAG.getTargetExternalSymbol(AM.ES, i32, AM.SymbolFlags);
    } else if AM.MCSym {
        assert!(!AM.Disp, "Non-zero displacement is ignored with MCSym.");
        assert!(AM.SymbolFlags == 0, "oo");
        Disp = self.CurDAG.getMCSymbol(AM.MCSym, i32);
    } else if AM.JT != -1 {
        assert!(!AM.Disp, "Non-zero displacement is ignored with JT.");
        Disp = self.CurDAG.getTargetJumpTable(AM.JT, i32, AM.SymbolFlags);
    } else if AM.BlockAddr {
        Disp = self.CurDAG.getTargetBlockAddress(AM.BlockAddr, i32, AM.Disp, AM.SymbolFlags);
    } else {
        Disp = self.CurDAG.getSignedTargetConstant(AM.Disp, DL, i32, false);
    }
    if AM.Segment.getNode() {
        Segment = AM.Segment;
    } else {
        Segment = self.CurDAG.getRegister(0, i16);
    }
}

fn X86DAGToDAGISel::isAMXSDNode(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    for let mut Idx: u32 = 0;
let mut E: u32 = N.getNumValues(); Idx != E; Idx += 1 {
        if N.getValueType(Idx) == x86amx {
            return true;
        }
    }
    for let mut Idx: u32 = 0;
let mut E: u32 = N.getNumOperands(); Idx != E; Idx += 1 {
        let mut Op: SDValue = N.getOperand(Idx);
        if Op.getValueType() == x86amx {
            return true;
        }
    }
    return false;
}

fn X86DAGToDAGISel::shouldAvoidImmediateInstFormsForSize(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    let mut UseCount: u32 = 0;
    if !self.CurDAG.shouldOptForSize() {
        return false;
    }
    for User in N.users() {
        if UseCount >= 2 {
            break;
        }
        if User.isMachineOpcode() {
            UseCount += 1;
            continue;
        }
        if User.getOpcode() == STORE && User.getOperand(1).getNode() == N {
            UseCount += 1;
            continue;
        }
        if User.getNumOperands() != 2 {
            continue;
        }
        let mut C: *mut ConstantSDNode = dyn_cast(N);
        if C && isInt(C.getSExtValue()) {
            continue;
        }
        if User.getOpcode() == ADD || User.getOpcode() == ADD || User.getOpcode() == SUB || User.getOpcode() == SUB {
            let mut OtherOp: SDValue = User.getOperand(0);
            if OtherOp.getNode() == N {
                OtherOp = User.getOperand(1);
            }
            let mut RegNode: *mut RegisterSDNode = null;
            if operator(OtherOp).getOpcode() == CopyFromReg && (RegNode = dyn_cast_or_null(operator(OtherOp).getOperand(1).getNode())) {
                if (RegNode.getReg() == ESP) || (RegNode.getReg() == RSP) {
                    continue;
                }
            }
        }
        UseCount += 1;
    }
    return (UseCount > 1);
}

fn X86DAGToDAGISel::getI8Imm(self, Imm: u32, DL: *SDLoc) -> SDValue {
    return self.CurDAG.getTargetConstant(Imm, DL, i8, false);
}

fn X86DAGToDAGISel::getI32Imm(self, Imm: u32, DL: *SDLoc) -> SDValue {
    return self.CurDAG.getTargetConstant(Imm, DL, i32, false);
}

fn X86DAGToDAGISel::getI64Imm(self, Imm: u64, DL: *SDLoc) -> SDValue {
    return self.CurDAG.getTargetConstant(Imm, DL, i64, false);
}

fn X86DAGToDAGISel::getExtractVEXTRACTImmediate(self, N: *mut SDNode, VecWidth: u32, DL: *SDLoc) -> SDValue {
    assert!((VecWidth == 128 || VecWidth == 256), "Unexpected vector width");
    let mut Index: u64 = N.getConstantOperandVal(1);
    let mut VecVT: MVT = N.getOperand(0).getSimpleValueType();
    return self.getI8Imm((Index * VecVT.getScalarSizeInBits()) / VecWidth, DL);
}

fn X86DAGToDAGISel::getInsertVINSERTImmediate(self, N: *mut SDNode, VecWidth: u32, DL: *SDLoc) -> SDValue {
    assert!((VecWidth == 128 || VecWidth == 256), "Unexpected vector width");
    let mut Index: u64 = N.getConstantOperandVal(2);
    let mut VecVT: MVT = N.getSimpleValueType(0);
    return self.getI8Imm((Index * VecVT.getScalarSizeInBits()) / VecWidth, DL);
}

fn X86DAGToDAGISel::getPermuteVINSERTCommutedImmediate(self, N: *mut SDNode, VecWidth: u32, DL: *SDLoc) -> SDValue {
    assert!(VecWidth == 128, "Unexpected vector width");
    let mut Index: u64 = N.getConstantOperandVal(2);
    let mut VecVT: MVT = N.getSimpleValueType(0);
    let mut InsertIdx: u64 = (Index * VecVT.getScalarSizeInBits()) / VecWidth;
    assert!((InsertIdx == 0 || InsertIdx == 1), "Bad insertf128 index");
    return self.getI8Imm(if InsertIdx { 2 } else { 48 }, DL);
}

fn X86DAGToDAGISel::getSBBZero(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = N;
    let mut VT: MVT = N.getSimpleValueType(0);
    let mut VTs: SDVTList = self.CurDAG.getVTList(i32, i32);
    let mut Zero: SDValue = SDValue { Node: self.CurDAG.getMachineNode(MOV32r0, dl, VTs, ArrayRef<SDValue> {}), ResNo: 0 };
    if VT == i64 {
        Zero = SDValue { Node: self.CurDAG.getMachineNode(SUBREG_TO_REG, dl, i64, Zero, self.CurDAG.getTargetConstant(sub_32bit, dl, i32, false)), ResNo: 0 };
    }
    let mut Opcode: u32 = N.getOpcode();
    assert!((Opcode == SBB || Opcode == SETCC_CARRY), "Unexpected opcode for SBB materialization");
    let mut FlagOpIndex: u32 = if Opcode == SBB { 2 } else { 1 };
    let mut EFLAGS: SDValue = self.CurDAG.getCopyToReg(self.CurDAG.getEntryNode(), dl, EFLAGS, N.getOperand(FlagOpIndex), SDValue {});
    let mut Opc: u32 = if VT == i64 { SBB64rr } else { SBB32rr };
    let mut SBBVT: MVT = if VT == i64 { i64 } else { i32 };
    VTs = self.CurDAG.getVTList(SBBVT, i32);
    return SDValue { Node: self.CurDAG.getMachineNode(Opc, dl, VTs, [Zero, Zero, EFLAGS, EFLAGS.getValue(1)]), ResNo: 0 };
}

fn X86DAGToDAGISel::isUnneededShiftMask(self: *X86DAGToDAGISel, N: *mut SDNode, Width: u32) -> bool {
    assert!(N.getOpcode() == AND, "Unexpected opcode");
    let mut Val: *APInt = N.getConstantOperandAPInt(1);
    if Val.countr_one() >= Width {
        return true;
    }
    let mut Mask: APInt = Val | self.CurDAG.computeKnownBits(N.getOperand(0), 0).Zero;
    return Mask.countr_one() >= Width;
}

fn X86DAGToDAGISel::isDef32(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    let mut Opc: u32 = N.getOpcode();
    return Opc != TRUNCATE && Opc != EXTRACT_SUBREG && Opc != CopyFromReg && Opc != AssertSext && Opc != AssertZext && Opc != AssertAlign && Opc != FREEZE && !((Opc == BSF || Opc == BSR) && !N.getOperand(0).isUndef() && !isa(N.getOperand(0)));
}

fn X86DAGToDAGISel::getTargetMachine(self: *X86DAGToDAGISel) -> *X86TargetMachine {
    return self.TM as X86TargetMachine;
}

fn X86DAGToDAGISel::getInstrInfo(self: *X86DAGToDAGISel) -> *X86InstrInfo {
    return self.Subtarget.getInstrInfo();
}

fn X86DAGToDAGISel::ComplexPatternFuncMutatesDAG(self: *X86DAGToDAGISel) -> bool {
    return true;
}

fn X86DAGToDAGISel::useNonTemporalLoad(self: *X86DAGToDAGISel, N: *mut LoadSDNode) -> bool {
    if !N.isNonTemporal() {
        return false;
    }
    let mut StoreSize: u32 = N.getMemoryVT().getStoreSize().operator unsigned long long();
    if N.getAlign().value() < StoreSize {
        return false;
    }
    match StoreSize {
        _ => {
            llvm_unreachable_internal("Unsupported store size", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 595);
        },
        4 => {
            8;
        },
        16 => {
            return self.Subtarget.hasSSE41();
        },
        32 => {
            return self.Subtarget.hasAVX2();
        },
        64 => {
            return self.Subtarget.hasAVX512();
        },
    }
}

fn X86DAGToDAGISel::getBatchAA(self: *X86DAGToDAGISel) -> *mut BatchAAResults {
    if self.BatchAA.has_value() {
        return &mut self.BatchAA.value();
    }
    return null;
}

fn X86DAGToDAGISel::getTargetLowering(self: *X86DAGToDAGISel) -> *TargetLowering {
