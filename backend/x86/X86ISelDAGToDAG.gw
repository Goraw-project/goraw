static mut ID: i8 = 0;

fn isLegalMaskCompare(N: *mut SDNode, Subtarget: *X86Subtarget) -> bool {
    let mut Opcode: u32 = N.getOpcode();
    if Opcode == CMPM || Opcode == CMPMM || Opcode == STRICT_CMPM || Opcode == SETCC || Opcode == CMPMM_SAE || Opcode == VFPCLASS {
        let mut OpVT: EVT = N.getOperand(0).getValueType();
        if Opcode == STRICT_CMPM {
            OpVT = N.getOperand(1).getValueType();
        }
        if OpVT.is256BitVector() || OpVT.is128BitVector() {
            return Subtarget.hasVLX();
        }
        return true;
    }
    if Opcode == VFPCLASSS || Opcode == FSETCCM || Opcode == FSETCCM_SAE {
        return true;
    }
    return false;
}

fn X86DAGToDAGISel::isMaskZeroExtended(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    if N.getOpcode() == AND {
        return isLegalMaskCompare(N.getOperand(0).getNode(), self.Subtarget) || isLegalMaskCompare(N.getOperand(1).getNode(), self.Subtarget);
    }
    return isLegalMaskCompare(N, self.Subtarget);
}

fn X86DAGToDAGISel::IsProfitableToFold(self: *X86DAGToDAGISel, N: SDValue, U: *mut SDNode, Root: *mut SDNode) -> bool {
    if self.OptLevel == None {
        return false;
    }
    if !N.hasOneUse() {
        return false;
    }
    if N.getOpcode() != LOAD {
        return true;
    }
    if self.useNonTemporalLoad(cast(N)) {
        return false;
    }
    if U == Root {
        match U.getOpcode() {
            _ => {
                break;
            },
            ADD => {
                ADC;
            },
            SHL => {
                SRA;
            },
        }
    }
    if Root.getOpcode() == INSERT_SUBVECTOR && isNullConstant(Root.getOperand(2)) && (Root.getOperand(0).isUndef() || isBuildVectorAllZeros(Root.getOperand(0).getNode())) {
        return false;
    }
    return true;
}

fn X86DAGToDAGISel::isProfitableToFormMaskedOp(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    assert!((N.getOpcode() == VSELECT || N.getOpcode() == SELECTS), "Unexpected opcode!");
    return N.getOperand(1).hasOneUse();
}

fn moveBelowOrigChain(CurDAG: *mut SelectionDAG, Load: SDValue, Call: SDValue, OrigChain: SDValue) {
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut Chain: SDValue = OrigChain.getOperand(0);
    if Chain.getNode() == Load.getNode() {
        Ops.push(Load.getOperand(0));
    } else {
        assert!(Chain.getOpcode() == TokenFactor, "Unexpected chain operand");
        for let mut i: u32 = 0;
let mut e: u32 = Chain.getNumOperands(); i != e; i += 1 {
            if Chain.getOperand(i).getNode() == Load.getNode() {
                Ops.push(Load.getOperand(0));
            } else {
                Ops.push(Chain.getOperand(i));
            }
        }
        let mut NewChain: SDValue = CurDAG.getNode(TokenFactor, Load, Other, Ops);
        Ops.clear();
        Ops.push(NewChain);
    }
    Ops.append(operator(OrigChain).op_begin() + 1, operator(OrigChain).op_end());
    CurDAG.UpdateNodeOperands(OrigChain.getNode(), Ops);
    CurDAG.UpdateNodeOperands(Load.getNode(), Call.getOperand(0), Load.getOperand(1), Load.getOperand(2));
    Ops.clear();
    Ops.push(SDValue { Node: Load.getNode(), ResNo: 1 });
    Ops.append(operator(Call).op_begin() + 1, operator(Call).op_end());
    CurDAG.UpdateNodeOperands(Call.getNode(), Ops);
}

fn isCalleeLoad(Callee: SDValue, Chain: *mut SDValue, HasCallSeq: bool) -> bool {
    if Callee.getNode() == Chain.getNode() || !Callee.hasOneUse() {
        return false;
    }
    let mut LD: *mut LoadSDNode = dyn_cast(Callee.getNode());
    if !LD || !LD.isSimple() || LD.getAddressingMode() != UNINDEXED || LD.getExtensionType() != NON_EXTLOAD {
        return false;
    }
    if !Callee.getValue(1).hasOneUse() {
        return false;
    }
    while HasCallSeq && Chain.getOpcode() != CALLSEQ_START {
        if !Chain.hasOneUse() {
            return false;
        }
        Chain = Chain.getOperand(0);
    }
    while true {
        if !Chain.getNumOperands() {
            return false;
        }
        match Chain.getNode().getOpcode() {
            CALLSEQ_START => {
                CopyToReg;
            },
            _ => {
                return false;
            },
        }
        if Chain.getOperand(0).getNode() == Callee.getNode() {
            return true;
        }
        if Chain.getOperand(0).getOpcode() == TokenFactor && Chain.getOperand(0).getValue(0).hasOneUse() && Callee.getValue(1).isOperandOf(Chain.getOperand(0).getNode()) && Callee.getValue(1).hasOneUse() {
            return true;
        }
        if Chain.getOperand(0).getOpcode() == CopyToReg && Chain.getOperand(0).getValue(0).hasOneUse() {
            Chain = Chain.getOperand(0);
            continue;
        }
        return false;
    }
}

fn isEndbrImm(Imm: u64, BitWidth: u32) -> bool {
    if BitWidth > 64 || BitWidth % 8 != 0 {
        return false;
    }
    let mut NumBytes: u32 = BitWidth / 8;
    if NumBytes < 4 {
        return false;
    }
    let mut OptionalPrefixBytes: [10]u8 = [38, 46, 54, 62, 100, 101, 102, 103, 240, 242];
    let mut Bytes: [8]u8 = zeroed();
    for let mut I: u32 = 0; I != NumBytes; I += 1 {
        Bytes[I] = (Imm >> (I * 8)) & 255;
    }
    for let mut I: u32 = 0; I + 3 < NumBytes; I += 1 {
        if Bytes[I] != 243 {
            continue;
        }
        let mut J: u32 = I + 1;
        while J < NumBytes && is_contained(OptionalPrefixBytes, Bytes[J]) {
            J += 1;
        }
        if J + 2 < NumBytes && Bytes[J] == 15 && Bytes[J + 1] == 30 && (Bytes[J + 2] == 250 || Bytes[J + 2] == 251) {
            return true;
        }
    }
    return false;
}

fn needBWI(VT: MVT) -> bool {
    return (VT == v32i16 || VT == v32f16 || VT == v64i8);
}

fn X86DAGToDAGISel::PreprocessISelDAG(self) {
    let mut MadeChange: bool = false;
    for let mut I: allnodes_iterator = self.CurDAG.allnodes_begin();
let mut E: allnodes_iterator = self.CurDAG.allnodes_end(); I != E;  {
        let mut N: *mut SDNode = &mut operator(operator(I, 0));
        if N.getOpcode() == Constant {
            let mut VT: MVT = N.getSimpleValueType(0);
            assert!(VT.isScalarInteger(), "ISD::Constant must have a scalar integer type");
            if !VT.isScalarInteger() || VT.getSizeInBits().operator unsigned long long() > 64 {
                continue;
            }
            let mut Imm: u64 = cast(N).getZExtValue();
            if isEndbrImm(Imm, VT.getSizeInBits().operator unsigned long long()) {
                let mut CFProtectionBranch: *mut Metadata = self.MF.getFunction().getParent().getModuleFlag("cf-protection-branch");
                if CFProtectionBranch || IndirectBranchTracking {
                    let mut dl: SDLoc = N;
                    let mut ComplementImm: u64 = (~Imm) & maskTrailingOnes(VT.getSizeInBits().operator unsigned long long());
                    let mut Complement: SDValue = self.CurDAG.getConstant(ComplementImm, dl, VT, false, true);
                    Complement = self.CurDAG.getNOT(dl, Complement, VT);
                    operator(I);
                    self.CurDAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Complement);
                    operator(I);
                    MadeChange = true;
                    continue;
                }
            }
        }
        if N.getOpcode() == AND && !N.hasAnyUseOfValue(1) {
            let mut Res: SDValue = self.CurDAG.getNode(AND, N, N.getValueType(0), N.getOperand(0), N.getOperand(1));
            operator(I);
            self.CurDAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Res);
            operator(I);
            MadeChange = true;
            continue;
        }
        let mut mayPreventLoadFold: Closure_1 = Closure_1 { N: &mut N, cap_1: self };
        if (N.getOpcode() == ADD || N.getOpcode() == SUB) && N.getSimpleValueType(0).isVector() && !mayPreventLoadFold.call() {
            let mut SplatVal: APInt = APInt {};
            if !isBuildVectorOfConstantSDNodes(peekThroughBitcasts(N.getOperand(0)).getNode()) && isConstantSplat(N.getOperand(1), SplatVal, true) && SplatVal.isOne() {
                let mut DL: SDLoc = N;
                let mut VT: MVT = N.getSimpleValueType(0);
                let mut NumElts: u32 = VT.getSizeInBits().operator unsigned long long() / 32;
                let mut AllOnes: SDValue = self.CurDAG.getAllOnesConstant(DL, getVectorVT(i32, NumElts), false, false);
                AllOnes = self.CurDAG.getBitcast(VT, AllOnes);
                let mut NewOpcode: u32 = if N.getOpcode() == ADD { SUB } else { ADD };
                let mut Res: SDValue = self.CurDAG.getNode(NewOpcode, DL, VT, N.getOperand(0), AllOnes);
                operator(I);
                self.CurDAG.ReplaceAllUsesWith(N, Res.getNode());
                operator(I);
                MadeChange = true;
                continue;
            }
        }
        match N.getOpcode() {
            VBROADCAST => {
                let mut VT: MVT = N.getSimpleValueType(0);
                if !self.Subtarget.hasBWI() && needBWI(VT) {
                    let mut NarrowVT: MVT = VT.getHalfNumVectorElementsVT();
                    let mut dl: SDLoc = N;
                    let mut NarrowBCast: SDValue = self.CurDAG.getNode(VBROADCAST, dl, NarrowVT, N.getOperand(0));
                    let mut Res: SDValue = self.CurDAG.getNode(INSERT_SUBVECTOR, dl, VT, self.CurDAG.getUNDEF(VT), NarrowBCast, self.CurDAG.getIntPtrConstant(0, dl, false));
                    let mut Index: u32 = NarrowVT.getVectorMinNumElements();
                    Res = self.CurDAG.getNode(INSERT_SUBVECTOR, dl, VT, Res, NarrowBCast, self.CurDAG.getIntPtrConstant(Index, dl, false));
                    operator(I);
                    self.CurDAG.ReplaceAllUsesWith(N, Res.getNode());
                    operator(I);
                    MadeChange = true;
                    continue;
                }
                break;
            },
            VBROADCAST_LOAD => {
                let mut VT: MVT = N.getSimpleValueType(0);
                if !self.Subtarget.hasBWI() && needBWI(VT) {
                    let mut NarrowVT: MVT = VT.getHalfNumVectorElementsVT();
                    let mut MemNode: *mut MemSDNode = cast(N);
                    let mut dl: SDLoc = N;
                    let mut VTs: SDVTList = self.CurDAG.getVTList(NarrowVT, Other);
                    let mut Ops: [2]SDValue = [MemNode.getChain(), MemNode.getBasePtr()];
                    let mut NarrowBCast: SDValue = self.CurDAG.getMemIntrinsicNode(VBROADCAST_LOAD, dl, VTs, Ops, MemNode.getMemoryVT(), MemNode.getMemOperand());
                    let mut Res: SDValue = self.CurDAG.getNode(INSERT_SUBVECTOR, dl, VT, self.CurDAG.getUNDEF(VT), NarrowBCast, self.CurDAG.getIntPtrConstant(0, dl, false));
                    let mut Index: u32 = NarrowVT.getVectorMinNumElements();
                    Res = self.CurDAG.getNode(INSERT_SUBVECTOR, dl, VT, Res, NarrowBCast, self.CurDAG.getIntPtrConstant(Index, dl, false));
                    operator(I);
                    let mut To: [2]SDValue = [Res, NarrowBCast.getValue(1)];
                    self.CurDAG.ReplaceAllUsesWith(N, To);
                    operator(I);
                    MadeChange = true;
                    continue;
                }
                break;
            },
            LOAD => {
                let mut Ld: *mut LoadSDNode = cast(N);
                let mut VT: MVT = N.getSimpleValueType(0);
                if !isNormalLoad(Ld) || !Ld.isSimple() || !(VT.is128BitVector() || VT.is256BitVector()) {
                    break;
                }
                let mut MaxVT: MVT = VT;
                let mut MaxLd: *mut SDNode = null;
                let mut Ptr: SDValue = Ld.getBasePtr();
                let mut Chain: SDValue = Ld.getChain();
                for User in operator(Ptr).users() {
                    let mut UserLd: *mut LoadSDNode = dyn_cast(User);
                    let mut UserVT: MVT = User.getSimpleValueType(0);
                    if User != N && UserLd && isNormalLoad(User) && UserLd.getBasePtr() == Ptr && UserLd.getChain() == Chain && !User.hasAnyUseOfValue(1) && (UserVT.is256BitVector() || UserVT.is512BitVector()) && UserVT.getSizeInBits().operator unsigned long long() > VT.getSizeInBits().operator unsigned long long() && (!MaxLd || UserVT.getSizeInBits().operator unsigned long long() > MaxVT.getSizeInBits().operator unsigned long long()) {
                        MaxLd = User;
                        MaxVT = UserVT;
                    }
                }
                if MaxLd {
                    let mut dl: SDLoc = N;
                    let mut NumSubElts: u32 = VT.getSizeInBits().operator unsigned long long() / MaxVT.getScalarSizeInBits();
                    let mut SubVT: MVT = getVectorVT(MaxVT.getScalarType(), NumSubElts);
                    let mut Extract: SDValue = self.CurDAG.getNode(EXTRACT_SUBVECTOR, dl, SubVT, SDValue { Node: MaxLd, ResNo: 0 }, self.CurDAG.getIntPtrConstant(0, dl, false));
                    let mut Res: SDValue = self.CurDAG.getBitcast(VT, Extract);
                    operator(I);
                    let mut To: [2]SDValue = [Res, SDValue { Node: MaxLd, ResNo: 1 }];
                    self.CurDAG.ReplaceAllUsesWith(N, To);
                    operator(I);
                    MadeChange = true;
                    continue;
                }
                break;
            },
            VSELECT => {
                let mut EleVT: EVT = N.getOperand(0).getValueType().getVectorElementType();
                if EleVT == i1 {
                    break;
                }
                assert!(self.Subtarget.hasSSE41(), "Expected SSE4.1 support!");
                assert!(N.getValueType(0).getVectorElementType() != i16, "We can't replace VSELECT with BLENDV in vXi16!");
                let mut R: SDValue = SDValue {};
                if self.Subtarget.hasVLX() && self.CurDAG.ComputeNumSignBits(N.getOperand(0), 0) == EleVT.getSizeInBits().operator unsigned long long() {
                    R = self.CurDAG.getNode(VPTERNLOG, N, N.getValueType(0), N.getOperand(0), N.getOperand(1), N.getOperand(2), self.CurDAG.getTargetConstant(202, N, i8, false));
                } else {
                    R = self.CurDAG.getNode(BLENDV, N, N.getValueType(0), N.getOperand(0), N.getOperand(1), N.getOperand(2));
                }
                operator(I);
                self.CurDAG.ReplaceAllUsesWith(N, R.getNode());
                operator(I);
                MadeChange = true;
                continue;
            },
            FP_ROUND => {
                STRICT_FP_ROUND;
            },
            SHL => {
                SRA;
            },
            ANY_EXTEND => {
                ANY_EXTEND_VECTOR_INREG;
            },
            FCEIL => {
                STRICT_FCEIL;
            },
            FANDN => {
                FAND;
            },
        }
        if self.OptLevel != None && !self.Subtarget.useIndirectThunkCalls() && ((N.getOpcode() == CALL && !self.Subtarget.slowTwoMemOps() && !self.Subtarget.slowIndirectCall()) || (N.getOpcode() == TC_RETURN && (self.Subtarget.is64Bit() || !self.getTargetMachine().isPositionIndependent()))) {
            let mut HasCallSeq: bool = N.getOpcode() == CALL;
            let mut Chain: SDValue = N.getOperand(0);
            let mut Load: SDValue = N.getOperand(1);
            if !isCalleeLoad(Load, Chain, HasCallSeq) {
                continue;
            }
            if N.getOpcode() == TC_RETURN && !self.checkTCRetEnoughRegs(N) {
                continue;
            }
            moveBelowOrigChain(self.CurDAG, Load, SDValue { Node: N, ResNo: 0 }, Chain);
            operator(NumLoadMoved);
            MadeChange = true;
            continue;
        }
        match N.getOpcode() {
            _ => {
                continue;
            },
            FP_ROUND => {
                FP_EXTEND;
            },
            STRICT_FP_ROUND => {
                STRICT_FP_EXTEND;
            },
        }
        operator(I);
        MadeChange = true;
    }
    if MadeChange {
        self.CurDAG.RemoveDeadNodes();
    }
}

fn X86DAGToDAGISel::tryOptimizeRem8Extend(self, N: *mut SDNode) -> bool {
    let mut Opc: u32 = N.getMachineOpcode();
    if Opc != MOVZX32rr8 && Opc != MOVSX32rr8 && Opc != MOVSX64rr8 {
        return false;
    }
    let mut N0: SDValue = N.getOperand(0);
    if !N0.isMachineOpcode() || N0.getMachineOpcode() != EXTRACT_SUBREG || N0.getConstantOperandVal(1) != sub_8bit {
        return false;
    }
    let mut ExpectedOpc: u32 = if Opc == MOVZX32rr8 { MOVZX32rr8_NOREX } else { MOVSX32rr8_NOREX };
    let mut N00: SDValue = N0.getOperand(0);
    if !N00.isMachineOpcode() || N00.getMachineOpcode() != ExpectedOpc {
        return false;
    }
    if Opc == MOVSX64rr8 {
        let mut Extend: *mut MachineSDNode = self.CurDAG.getMachineNode(MOVSX64rr32, N, i64, N00);
        self.ReplaceUses(N, Extend);
    } else {
        self.ReplaceUses(N, N00.getNode());
    }
    return true;
}

fn X86DAGToDAGISel::PostprocessISelDAG(self) {
    if self.TM.getOptLevel() == None {
        return;
    }
    let mut Position: allnodes_iterator = self.CurDAG.allnodes_end();
    let mut MadeChange: bool = false;
    while Position != self.CurDAG.allnodes_begin() {
        let mut N: *mut SDNode = &mut operator(operator(Position));
        if N.use_empty() || !N.isMachineOpcode() {
            continue;
        }
        if self.tryOptimizeRem8Extend(N) {
            MadeChange = true;
            continue;
        }
        let mut Opc: u32 = N.getMachineOpcode();
        match Opc {
            _ => {
                continue;
            },
            TEST8rr => {
                TEST16rr;
            },
            KORTESTBkk => {
                KORTESTWkk;
            },
            SUBREG_TO_REG => {
                let mut SubRegIdx: u32 = N.getConstantOperandVal(1);
                if SubRegIdx != sub_xmm && SubRegIdx != sub_ymm {
                    continue;
                }
                let mut Move: SDValue = N.getOperand(0);
                if !Move.isMachineOpcode() {
                    continue;
                }
                match Move.getMachineOpcode() {
                    _ => {
                        continue;
                    },
                    VMOVAPDrr => {
                        break;
                    },
                    VMOVUPDrr => {
                        break;
                    },
                    VMOVAPSrr => {
                        break;
                    },
                    VMOVUPSrr => {
                        break;
                    },
                    VMOVDQArr => {
                        break;
                    },
                    VMOVDQUrr => {
                        break;
                    },
                    VMOVAPDYrr => {
                        break;
                    },
                    VMOVUPDYrr => {
                        break;
                    },
                    VMOVAPSYrr => {
                        break;
                    },
                    VMOVUPSYrr => {
                        break;
                    },
                    VMOVDQAYrr => {
                        break;
                    },
                    VMOVDQUYrr => {
                        break;
                    },
                    VMOVAPDZ128rr => {
                        break;
                    },
                    VMOVUPDZ128rr => {
                        break;
                    },
                    VMOVAPSZ128rr => {
                        break;
                    },
                    VMOVUPSZ128rr => {
                        break;
                    },
                    VMOVDQA32Z128rr => {
                        break;
                    },
                    VMOVDQU32Z128rr => {
                        break;
                    },
                    VMOVDQA64Z128rr => {
                        break;
                    },
                    VMOVDQU64Z128rr => {
                        break;
                    },
                    VMOVAPDZ256rr => {
                        break;
                    },
                    VMOVUPDZ256rr => {
                        break;
                    },
                    VMOVAPSZ256rr => {
                        break;
                    },
                    VMOVUPSZ256rr => {
                        break;
                    },
                    VMOVDQA32Z256rr => {
                        break;
                    },
                    VMOVDQU32Z256rr => {
                        break;
                    },
                    VMOVDQA64Z256rr => {
                        break;
                    },
                    VMOVDQU64Z256rr => {
                        break;
                    },
                }
                let mut In: SDValue = Move.getOperand(0);
                if !In.isMachineOpcode() || In.getMachineOpcode() <= GENERIC_OP_END {
                    continue;
                }
                let mut TSFlags: u64 = self.getInstrInfo().get(In.getMachineOpcode()).TSFlags;
                if (TSFlags & EncodingMask) != VEX && (TSFlags & EncodingMask) != EVEX && (TSFlags & EncodingMask) != XOP {
                    continue;
                }
                self.CurDAG.UpdateNodeOperands(N, In, N.getOperand(1));
                MadeChange = true;
            },
        }
    }
    if MadeChange {
        self.CurDAG.RemoveDeadNodes();
    }
}

fn X86DAGToDAGISel::emitSpecialCodeForMain(self) {
    if self.Subtarget.isTargetCygMing() {
        let mut Args: ArgListTy = ArgListTy {};
        let mut DL: *DataLayout = self.CurDAG.getDataLayout();
        let mut CLI: CallLoweringInfo = *self.CurDAG;
        CLI.setChain(self.CurDAG.getRoot()).setCallee(C, getVoidTy(*self.CurDAG.getContext()), self.CurDAG.getExternalSymbol("__main", self.TLI.getPointerTy(DL, 0)), move(Args), AttributeSet {});
        let mut TLI: *TargetLowering = self.CurDAG.getTargetLoweringInfo();
        let mut Result: pair<SDValue, SDValue> = TLI.LowerCallTo(CLI);
        self.CurDAG.setRoot(Result.second);
    }
}

fn X86DAGToDAGISel::emitFunctionEntryCode(self) {
    let mut F: *Function = self.MF.getFunction();
    if F.hasExternalLinkage() && F.getName() == "main" {
        self.emitSpecialCodeForMain();
    }
}

fn isDispSafeForFrameIndexOrRegBase(Val: i64) -> bool {
    return isInt(Val);
}

fn X86DAGToDAGISel::foldOffsetIntoAddress(self, Offset: u64, AM: *mut X86ISelAddressMode) -> bool {
    let mut Val: i64 = AM.Disp + Offset;
    if Val != 0 && (AM.ES || AM.MCSym) {
        return true;
    }
    let mut M: Model = self.TM.getCodeModel();
    if self.Subtarget.is64Bit() {
        if Val != 0 && !isOffsetSuitableForCodeModel(Val, M, AM.hasSymbolicDisplacement()) {
            return true;
        }
        if AM.BaseType == FrameIndexBase && !isDispSafeForFrameIndexOrRegBase(Val) {
            return true;
        }
        if self.Subtarget.isTarget64BitILP32() && !isDispSafeForFrameIndexOrRegBase(Val as u32) && !AM.hasBaseOrIndexReg() {
            return true;
        }
    } else if self.Subtarget.is16Bit() {
        if Val < -65535 as i64 || Val > 65535 as i64 {
            return true;
        }
    } else if AM.hasBaseOrIndexReg() && !isDispSafeForFrameIndexOrRegBase(Val) {
        return true;
    }
    AM.Disp = Val;
    return false;
}

fn X86DAGToDAGISel::matchLoadInAddress(self, N: *mut LoadSDNode, AM: *mut X86ISelAddressMode, AllowSegmentRegForX32: bool) -> bool {
    let mut Address: SDValue = N.getOperand(1);
    if isNullConstant(Address) && AM.Segment.getNode() == null && !self.IndirectTlsSegRefs && (self.Subtarget.isTargetGlibc() || self.Subtarget.isTargetMusl() || self.Subtarget.isTargetAndroid() || self.Subtarget.isTargetFuchsia()) {
        if self.Subtarget.isTarget64BitILP32() && !AllowSegmentRegForX32 {
            return true;
        }
        match N.getPointerInfo().getAddrSpace() {
            GS => {
                AM.Segment = self.CurDAG.getRegister(GS, i16);
            },
            FS => {
                AM.Segment = self.CurDAG.getRegister(FS, i16);
            },
        }
    }
    return true;
}

fn X86DAGToDAGISel::matchWrapper(self, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if AM.hasSymbolicDisplacement() {
        return true;
    }
    let mut IsRIPRelTLS: bool = false;
    let mut IsRIPRel: bool = N.getOpcode() == WrapperRIP;
    if IsRIPRel {
        let mut Val: SDValue = N.getOperand(0);
        if Val.getOpcode() == TargetGlobalTLSAddress {
            IsRIPRelTLS = true;
        }
    }
    let mut M: Model = self.TM.getCodeModel();
    if self.Subtarget.is64Bit() && M == Large && !IsRIPRelTLS {
        return true;
    }
    if IsRIPRel && AM.hasBaseOrIndexReg() {
        return true;
    }
    let mut Backup: X86ISelAddressMode = AM;
    let mut Offset: i64 = 0;
    let mut N0: SDValue = N.getOperand(0);
    if dyn_cast(N0) {
        G;
    } else {
        AM.GV = G.getGlobal();
        AM.SymbolFlags = G.getTargetFlags();
        Offset = G.getOffset();
    }
    if self.Subtarget.is64Bit() && !IsRIPRel && AM.GV && self.TM.isLargeGlobalValue(AM.GV) {
        AM = Backup;
        return true;
    }
    if self.foldOffsetIntoAddress(Offset, AM) {
        AM = Backup;
        return true;
    }
    if IsRIPRel {
        AM.setBaseReg(self.CurDAG.getRegister(RIP, i64));
    }
    return false;
}

fn X86DAGToDAGISel::matchAddress(self, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if self.matchAddressRecursively(N, AM, 0) {
        return true;
    }
    if self.Subtarget.isTarget64BitILP32() && AM.BaseType == RegBase && AM.Base_Reg.getNode() != null && AM.IndexReg.getNode() == null {
        let mut Save_Base_Reg: SDValue = AM.Base_Reg;
        if dyn_cast(Save_Base_Reg) {
            LoadN;
        } else {
            AM.Base_Reg = SDValue {};
            if self.matchLoadInAddress(LoadN, AM, true) {
                AM.Base_Reg = Save_Base_Reg;
            }
        }
    }
    if AM.Scale == 2 && !AM.NegateIndex && AM.BaseType == RegBase && AM.Base_Reg.getNode() == null {
        AM.Base_Reg = AM.IndexReg;
        AM.Scale = 1;
    }
    if self.TM.getCodeModel() != Large && (!AM.GV || !self.TM.isLargeGlobalValue(AM.GV)) && self.Subtarget.is64Bit() && AM.Scale == 1 && AM.BaseType == RegBase && AM.Base_Reg.getNode() == null && AM.IndexReg.getNode() == null && AM.SymbolFlags == MO_NO_FLAG && AM.hasSymbolicDisplacement() {
        if isa_and_nonnull(AM.GV) && AM.Disp < -16 * 1024 * 1024 {
            return true;
        }
        AM.Base_Reg = self.CurDAG.getRegister(RIP, i64);
    }
    return false;
}

fn X86DAGToDAGISel::hasMaterializingUse(self: *X86DAGToDAGISel, V: SDValue) -> bool {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    for U in operator(V).uses() {
        if U.getResNo() != V.getResNo() {
            continue;
        }
        let mut User: *mut SDNode = U.getUser();
        if User.getOpcode() == CopyToReg {
            return true;
        }
        if dyn_cast(User) {
            St;
        } else {
            if St.getValue() == V {
                return true;
            }
            continue;
        }
        if !User.isMachineOpcode() {
            continue;
        }
        let mut Desc: *MCInstrDesc = TII.get(User.getMachineOpcode());
        if !Desc.mayStore() {
            continue;
        }
        let mut MemRefBegin: i32 = getMemoryOperandNo(Desc.TSFlags);
        if MemRefBegin < 0 {
            continue;
        }
        let mut MemRefEnd: u32 = MemRefBegin + AddrNumOperands;
        for let mut I: u32 = 0;
let mut E: u32 = User.getNumOperands(); I != E; I += 1 {
            if I >= MemRefBegin as u32 && I < MemRefEnd {
                continue;
            }
            let mut Opnd: SDValue = User.getOperand(I);
            if Opnd.getValueType() == Other || Opnd.getValueType() == Glue {
                continue;
            }
            if Opnd == V {
                return true;
            }
        }
    }
    return false;
}

fn X86DAGToDAGISel::matchAdd(self, N: *mut SDValue, AM: *mut X86ISelAddressMode, Depth: u32) -> bool {
    let mut Handle: HandleSDNode = N;
    let mut IsAddOrAddLike: Closure_2 = Closure_2 { cap_0: self };
    let mut SplitsMaterializedValue: Closure_3 = Closure_3 { AM: &mut AM, cap_1: self, IsAddOrAddLike: &mut IsAddOrAddLike };
    let mut MatchOperand: Closure_4 = Closure_4 { SplitsMaterializedValue: &mut SplitsMaterializedValue, AM: &mut AM, cap_2: self, Depth: &mut Depth };
    let mut Backup: X86ISelAddressMode = AM;
    if !MatchOperand.call(N.getOperand(0)) && !MatchOperand.call(Handle.getValue().getOperand(1)) {
        return false;
    }
    AM = Backup;
    if !MatchOperand.call(Handle.getValue().getOperand(1)) && !MatchOperand.call(Handle.getValue().getOperand(0)) {
        return false;
    }
    AM = Backup;
    if AM.BaseType == RegBase && !AM.Base_Reg.getNode() && !AM.IndexReg.getNode() {
        N = Handle.getValue();
        AM.Base_Reg = N.getOperand(0);
        AM.IndexReg = N.getOperand(1);
        AM.Scale = 1;
        return false;
    }
    N = Handle.getValue();
    return true;
}

fn insertDAGNode(DAG: *mut SelectionDAG, Pos: SDValue, N: SDValue) {
    if operator(N).getNodeId() == -1 || (getUninvalidatedNodeId(N.getNode()) > getUninvalidatedNodeId(Pos.getNode())) {
        DAG.RepositionNode(operator(Pos).getIterator(), N.getNode());
        operator(N).setNodeId(operator(Pos).getNodeId());
        InvalidateNodeId(N.getNode());
    }
}

fn foldMaskAndShiftToExtract(DAG: *mut SelectionDAG, N: SDValue, Mask: u64, Shift: SDValue, X: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if Shift.getOpcode() != SRL || !isa(Shift.getOperand(1)) || !Shift.hasOneUse() {
        return true;
    }
    let mut ScaleLog: i32 = 8 - Shift.getConstantOperandVal(1);
    if ScaleLog <= 0 || ScaleLog >= 4 || Mask != (255 << ScaleLog) {
        return true;
    }
    let mut XVT: MVT = X.getSimpleValueType();
    let mut VT: MVT = N.getSimpleValueType();
    let mut DL: SDLoc = N;
    let mut Eight: SDValue = DAG.getConstant(8, DL, i8, false, false);
    let mut NewMask: SDValue = DAG.getConstant(255, DL, XVT, false, false);
    let mut Srl: SDValue = DAG.getNode(SRL, DL, XVT, X, Eight);
    let mut And: SDValue = DAG.getNode(AND, DL, XVT, Srl, NewMask);
    let mut Ext: SDValue = DAG.getZExtOrTrunc(And, DL, VT);
    let mut ShlCount: SDValue = DAG.getConstant(ScaleLog, DL, i8, false, false);
    let mut Shl: SDValue = DAG.getNode(SHL, DL, VT, Ext, ShlCount);
    insertDAGNode(DAG, N, Eight);
    insertDAGNode(DAG, N, NewMask);
    insertDAGNode(DAG, N, Srl);
    insertDAGNode(DAG, N, And);
    insertDAGNode(DAG, N, Ext);
    insertDAGNode(DAG, N, ShlCount);
    insertDAGNode(DAG, N, Shl);
    DAG.ReplaceAllUsesWith(N, Shl);
    DAG.RemoveDeadNode(N.getNode());
    AM.IndexReg = Ext;
    AM.Scale = (1 << ScaleLog);
    return false;
}

fn foldMaskedShiftToScaledMask(DAG: *mut SelectionDAG, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    let mut Shift: SDValue = N.getOperand(0);
    let mut Mask: i64 = cast(operator(N).getOperand(1)).getSExtValue();
    let mut FoundAnyExtend: bool = false;
    if Shift.getOpcode() == ANY_EXTEND && Shift.hasOneUse() && Shift.getOperand(0).getSimpleValueType() == i32 && isUInt(Mask) {
        FoundAnyExtend = true;
        Shift = Shift.getOperand(0);
    }
    if Shift.getOpcode() != SHL || !isa(Shift.getOperand(1)) {
        return true;
    }
    let mut X: SDValue = Shift.getOperand(0);
    if !N.hasOneUse() || !Shift.hasOneUse() {
        return true;
    }
    let mut ShiftAmt: u32 = Shift.getConstantOperandVal(1);
    if ShiftAmt != 1 && ShiftAmt != 2 && ShiftAmt != 3 {
        return true;
    }
    let mut VT: MVT = N.getSimpleValueType();
    let mut DL: SDLoc = N;
    if FoundAnyExtend {
        let mut NewX: SDValue = DAG.getNode(ANY_EXTEND, DL, VT, X);
        insertDAGNode(DAG, N, NewX);
        X = NewX;
    }
    let mut NewMask: SDValue = DAG.getSignedConstant(Mask >> ShiftAmt, DL, VT, false, false);
    let mut NewAnd: SDValue = DAG.getNode(AND, DL, VT, X, NewMask);
    let mut NewShift: SDValue = DAG.getNode(SHL, DL, VT, NewAnd, Shift.getOperand(1));
    insertDAGNode(DAG, N, NewMask);
    insertDAGNode(DAG, N, NewAnd);
    insertDAGNode(DAG, N, NewShift);
    DAG.ReplaceAllUsesWith(N, NewShift);
    DAG.RemoveDeadNode(N.getNode());
    AM.Scale = 1 << ShiftAmt;
    AM.IndexReg = NewAnd;
    return false;
}

fn foldMaskAndShiftToScale(DAG: *mut SelectionDAG, N: SDValue, Mask: u64, Shift: SDValue, X: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if Shift.getOpcode() != SRL || !Shift.hasOneUse() || !isa(Shift.getOperand(1)) {
        return true;
    }
    let mut MaskIdx: u32 = 0;
    let mut MaskLen: u32 = 0;
    if !isShiftedMask_64(Mask, MaskIdx, MaskLen) {
        return true;
    }
    let mut MaskLZ: u32 = 64 - (MaskIdx + MaskLen);
    let mut ShiftAmt: u32 = Shift.getConstantOperandVal(1);
    let mut AMShiftAmt: u32 = MaskIdx;
    if AMShiftAmt == 0 || AMShiftAmt > 3 {
        return true;
    }
    let mut ScaleDown: u32 = (64 - X.getSimpleValueType().getSizeInBits().operator unsigned long long()) + ShiftAmt;
    if MaskLZ < ScaleDown {
        return true;
    }
    MaskLZ -= ScaleDown;
    let mut ReplacingAnyExtend: bool = false;
    if X.getOpcode() == ANY_EXTEND {
        let mut ExtendBits: u32 = X.getSimpleValueType().getSizeInBits() - X.getOperand(0).getSimpleValueType().getSizeInBits().operator unsigned long long();
        X = X.getOperand(0);
        MaskLZ = if ExtendBits > MaskLZ { 0 } else { MaskLZ - ExtendBits };
        ReplacingAnyExtend = true;
    }
    let mut MaskedHighBits: APInt = getHighBitsSet(X.getSimpleValueType().getSizeInBits().operator unsigned long long(), MaskLZ);
    if !DAG.MaskedValueIsZero(X, MaskedHighBits, 0) {
        return true;
    }
    let mut VT: MVT = N.getSimpleValueType();
    if ReplacingAnyExtend {
        assert!(X.getValueType() != VT);
        let mut NewX: SDValue = DAG.getNode(ZERO_EXTEND, X, VT, X);
        insertDAGNode(DAG, N, NewX);
        X = NewX;
    }
    let mut XVT: MVT = X.getSimpleValueType();
    let mut DL: SDLoc = N;
    let mut NewSRLAmt: SDValue = DAG.getConstant(ShiftAmt + AMShiftAmt, DL, i8, false, false);
    let mut NewSRL: SDValue = DAG.getNode(SRL, DL, XVT, X, NewSRLAmt);
    let mut NewExt: SDValue = DAG.getZExtOrTrunc(NewSRL, DL, VT);
    let mut NewSHLAmt: SDValue = DAG.getConstant(AMShiftAmt, DL, i8, false, false);
    let mut NewSHL: SDValue = DAG.getNode(SHL, DL, VT, NewExt, NewSHLAmt);
    insertDAGNode(DAG, N, NewSRLAmt);
    insertDAGNode(DAG, N, NewSRL);
    insertDAGNode(DAG, N, NewExt);
    insertDAGNode(DAG, N, NewSHLAmt);
    insertDAGNode(DAG, N, NewSHL);
    DAG.ReplaceAllUsesWith(N, NewSHL);
    DAG.RemoveDeadNode(N.getNode());
    AM.Scale = 1 << AMShiftAmt;
    AM.IndexReg = NewExt;
    return false;
}

fn foldMaskedShiftToBEXTR(DAG: *mut SelectionDAG, N: SDValue, Mask: u64, Shift: SDValue, X: SDValue, AM: *mut X86ISelAddressMode, Subtarget: *X86Subtarget) -> bool {
    if Shift.getOpcode() != SRL || !isa(Shift.getOperand(1)) || !Shift.hasOneUse() || !N.hasOneUse() {
        return true;
    }
    if !Subtarget.hasTBM() && !(Subtarget.hasBMI() && Subtarget.hasFastBEXTR()) {
        return true;
    }
    let mut MaskIdx: u32 = 0;
    let mut MaskLen: u32 = 0;
    if !isShiftedMask_64(Mask, MaskIdx, MaskLen) {
        return true;
    }
    let mut ShiftAmt: u32 = Shift.getConstantOperandVal(1);
    let mut AMShiftAmt: u32 = MaskIdx;
    if AMShiftAmt == 0 || AMShiftAmt > 3 {
        return true;
    }
    let mut XVT: MVT = X.getSimpleValueType();
    let mut VT: MVT = N.getSimpleValueType();
    let mut DL: SDLoc = N;
    let mut NewSRLAmt: SDValue = DAG.getConstant(ShiftAmt + AMShiftAmt, DL, i8, false, false);
    let mut NewSRL: SDValue = DAG.getNode(SRL, DL, XVT, X, NewSRLAmt);
    let mut NewMask: SDValue = DAG.getConstant(Mask >> AMShiftAmt, DL, XVT, false, false);
    let mut NewAnd: SDValue = DAG.getNode(AND, DL, XVT, NewSRL, NewMask);
    let mut NewExt: SDValue = DAG.getZExtOrTrunc(NewAnd, DL, VT);
    let mut NewSHLAmt: SDValue = DAG.getConstant(AMShiftAmt, DL, i8, false, false);
    let mut NewSHL: SDValue = DAG.getNode(SHL, DL, VT, NewExt, NewSHLAmt);
    insertDAGNode(DAG, N, NewSRLAmt);
    insertDAGNode(DAG, N, NewSRL);
    insertDAGNode(DAG, N, NewMask);
    insertDAGNode(DAG, N, NewAnd);
    insertDAGNode(DAG, N, NewExt);
    insertDAGNode(DAG, N, NewSHLAmt);
    insertDAGNode(DAG, N, NewSHL);
    DAG.ReplaceAllUsesWith(N, NewSHL);
    DAG.RemoveDeadNode(N.getNode());
    AM.Scale = 1 << AMShiftAmt;
    AM.IndexReg = NewExt;
    return false;
}

fn X86DAGToDAGISel::matchIndexRecursively(self, N: SDValue, AM: *mut X86ISelAddressMode, Depth: u32) -> SDValue {
    assert!(AM.IndexReg.getNode() == null, "IndexReg already matched");
    assert!((AM.Scale == 1 || AM.Scale == 2 || AM.Scale == 4 || AM.Scale == 8), "Illegal index scale");
    if Depth >= MaxRecursionDepth {
        return N;
    }
    let mut VT: EVT = N.getValueType();
    let mut Opc: u32 = N.getOpcode();
    if self.CurDAG.isBaseWithConstantOffset(N) {
        let mut AddVal: *mut ConstantSDNode = cast(N.getOperand(1));
        let mut Offset: u64 = AddVal.getSExtValue() as u64 * AM.Scale;
        if !self.foldOffsetIntoAddress(Offset, AM) {
            return self.matchIndexRecursively(N.getOperand(0), AM, Depth + 1);
        }
    }
    if Opc == ADD && N.getOperand(0) == N.getOperand(1) {
        if AM.Scale <= 4 {
            AM.Scale *= 2;
            return self.matchIndexRecursively(N.getOperand(0), AM, Depth + 1);
        }
    }
    if Opc == VSHLI {
        let mut ShiftAmt: u64 = N.getConstantOperandVal(1);
        let mut ScaleAmt: u64 = 1 << ShiftAmt;
        if (AM.Scale * ScaleAmt) <= 8 {
            AM.Scale *= ScaleAmt;
            return self.matchIndexRecursively(N.getOperand(0), AM, Depth + 1);
        }
    }
    if Opc == SIGN_EXTEND && !VT.isVector() && N.hasOneUse() {
        let mut Src: SDValue = N.getOperand(0);
        if Src.getOpcode() == ADD && operator(Src).getFlags().hasNoSignedWrap() && Src.hasOneUse() {
            if self.CurDAG.isBaseWithConstantOffset(Src) {
                let mut AddSrc: SDValue = Src.getOperand(0);
                let mut AddVal: *mut ConstantSDNode = cast(Src.getOperand(1));
                let mut Offset: i64 = AddVal.getSExtValue();
                if !self.foldOffsetIntoAddress(Offset as u64 * AM.Scale, AM) {
                    let mut DL: SDLoc = N;
                    let mut ExtSrc: SDValue = self.CurDAG.getNode(Opc, DL, VT, AddSrc);
                    let mut ExtVal: SDValue = self.CurDAG.getSignedConstant(Offset, DL, VT, false, false);
                    let mut ExtAdd: SDValue = self.CurDAG.getNode(ADD, DL, VT, ExtSrc, ExtVal);
                    insertDAGNode(*self.CurDAG, N, ExtSrc);
                    insertDAGNode(*self.CurDAG, N, ExtVal);
                    insertDAGNode(*self.CurDAG, N, ExtAdd);
                    self.CurDAG.ReplaceAllUsesWith(N, ExtAdd);
                    self.CurDAG.RemoveDeadNode(N.getNode());
                    return ExtSrc;
                }
            }
        }
    }
    if Opc == ZERO_EXTEND && !VT.isVector() && N.hasOneUse() {
        let mut Src: SDValue = N.getOperand(0);
        let mut SrcOpc: u32 = Src.getOpcode();
        if ((SrcOpc == ADD && operator(Src).getFlags().hasNoUnsignedWrap()) || self.CurDAG.isADDLike(Src, true)) && Src.hasOneUse() {
            if self.CurDAG.isBaseWithConstantOffset(Src) {
                let mut AddSrc: SDValue = Src.getOperand(0);
                let mut Offset: u64 = Src.getConstantOperandVal(1);
                if !self.foldOffsetIntoAddress(Offset * AM.Scale, AM) {
                    let mut DL: SDLoc = N;
                    let mut Res: SDValue = SDValue {};
                    if AddSrc.getOpcode() == SHL && isa(AddSrc.getOperand(1)) {
                        let mut ShVal: SDValue = AddSrc.getOperand(0);
                        let mut ShAmt: u64 = AddSrc.getConstantOperandVal(1);
                        let mut HiBits: APInt = getHighBitsSet(AddSrc.getScalarValueSizeInBits(), ShAmt);
                        let mut ScaleAmt: u64 = 1 << ShAmt;
                        if (AM.Scale * ScaleAmt) <= 8 && (operator(AddSrc).getFlags().hasNoUnsignedWrap() || self.CurDAG.MaskedValueIsZero(ShVal, HiBits, 0)) {
                            AM.Scale *= ScaleAmt;
                            let mut ExtShVal: SDValue = self.CurDAG.getNode(Opc, DL, VT, ShVal);
                            let mut ExtShift: SDValue = self.CurDAG.getNode(SHL, DL, VT, ExtShVal, AddSrc.getOperand(1));
                            insertDAGNode(*self.CurDAG, N, ExtShVal);
                            insertDAGNode(*self.CurDAG, N, ExtShift);
                            AddSrc = ExtShift;
                            Res = ExtShVal;
                        }
                    }
                    let mut ExtSrc: SDValue = self.CurDAG.getNode(Opc, DL, VT, AddSrc);
                    let mut ExtVal: SDValue = self.CurDAG.getConstant(Offset, DL, VT, false, false);
                    let mut ExtAdd: SDValue = self.CurDAG.getNode(SrcOpc, DL, VT, ExtSrc, ExtVal);
                    insertDAGNode(*self.CurDAG, N, ExtSrc);
                    insertDAGNode(*self.CurDAG, N, ExtVal);
                    insertDAGNode(*self.CurDAG, N, ExtAdd);
                    self.CurDAG.ReplaceAllUsesWith(N, ExtAdd);
                    self.CurDAG.RemoveDeadNode(N.getNode());
                    return if Res { Res } else { ExtSrc };
                }
            }
        }
    }
    return N;
}

fn X86DAGToDAGISel::matchAddressRecursively(self, N: SDValue, AM: *mut X86ISelAddressMode, Depth: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-isel", 1) {
            {
                dbgs() << "MatchAddress: ";
                AM.dump(self.CurDAG);
            }
        }
    }
        if !(false) { break; }
    }
    if Depth >= MaxRecursionDepth {
        return self.matchAddressBase(N, AM);
    }
    if AM.isRIPRelative() {
        if !(AM.ES || AM.MCSym) && AM.JT != -1 {
            return true;
        }
        if dyn_cast(N) {
            Cst;
        } else if !self.foldOffsetIntoAddress(Cst.getSExtValue(), AM) {
            return false;
        }
        return true;
    }
    match N.getOpcode() {
        _ => {
            break;
        },
        LOCAL_RECOVER => {
            if !AM.hasSymbolicDisplacement() && AM.Disp == 0 {
                if dyn_cast(N.getOperand(0)) {
                    ESNode;
                } else {
                    AM.MCSym = ESNode.getMCSymbol();
                    return false;
                }
            }
            break;
        },
        Constant => {
            let mut Val: u64 = cast(N).getSExtValue();
            if !self.foldOffsetIntoAddress(Val, AM) {
                return false;
            }
            break;
        },
        Wrapper => {
            WrapperRIP;
        },
        LOAD => {
            if !self.matchLoadInAddress(cast(N), AM, false) {
                return false;
            }
        },
        FrameIndex => {
            if AM.BaseType == RegBase && AM.Base_Reg.getNode() == null && (!self.Subtarget.is64Bit() || isDispSafeForFrameIndexOrRegBase(AM.Disp)) {
                AM.BaseType = FrameIndexBase;
                AM.Base_FrameIndex = cast(N).getIndex();
                return false;
            }
        },
        SHL => {
            if AM.IndexReg.getNode() != null || AM.Scale != 1 {
                break;
            }
        },
        SRL => {
            if AM.IndexReg.getNode() != null || AM.Scale != 1 {
                break;
            }
            assert!(N.getSimpleValueType().getSizeInBits().operator unsigned long long() <= 64, "Unexpected value size!");
            let mut And: SDValue = N.getOperand(0);
            if And.getOpcode() != AND {
                break;
            }
            let mut X: SDValue = And.getOperand(0);
            if !isa(N.getOperand(1)) || !isa(And.getOperand(1)) {
                break;
            }
            let mut Mask: u64 = And.getConstantOperandVal(1) >> N.getConstantOperandVal(1);
            if !foldMaskAndShiftToScale(*self.CurDAG, N, Mask, N, X, AM) {
                return false;
            }
            break;
        },
        SMUL_LOHI => {
            UMUL_LOHI;
        },
        MUL => {
            MUL_IMM;
        },
        SUB => {
            let mut Handle: HandleSDNode = N;
            let mut Backup: X86ISelAddressMode = AM;
            if self.matchAddressRecursively(N.getOperand(0), AM, Depth + 1) {
                N = Handle.getValue();
                AM = Backup;
                break;
            }
            N = Handle.getValue();
            if AM.IndexReg.getNode() || AM.isRIPRelative() {
                AM = Backup;
                break;
            }
            let mut Cost: i32 = 0;
            let mut RHS: SDValue = N.getOperand(1);
            let mut NegScale: optional<unsigned int> = optional<unsigned int> {};
            if RHS.getOpcode() == SHL && RHS.hasOneUse() {
                if dyn_cast(RHS.getOperand(1)) {
                    ShAmt;
                } else {
                    let mut ShVal: u64 = ShAmt.getZExtValue();
                    if ShVal >= 1 && ShVal <= 3 {
                        NegScale = 1 << ShVal;
                        RHS = RHS.getOperand(0);
                        Cost -= 1;
                    }
                }
            }
            if !RHS.getNode().hasOneUse() || (!NegScale && RHS.getNode().getOpcode() == CopyFromReg) || RHS.getNode().getOpcode() == TRUNCATE || RHS.getNode().getOpcode() == ANY_EXTEND || (RHS.getNode().getOpcode() == ZERO_EXTEND && RHS.getOperand(0).getValueType() == i32) {
                Cost += 1;
            }
            let mut BaseIsNegatedValue: bool = NegScale && AM.BaseType == RegBase && AM.Base_Reg == RHS;
            if ((AM.BaseType == RegBase && AM.Base_Reg.getNode() && !AM.Base_Reg.getNode().hasOneUse()) || AM.BaseType == FrameIndexBase) && !BaseIsNegatedValue {
                Cost -= 1;
            }
            if (AM.hasSymbolicDisplacement() && !Backup.hasSymbolicDisplacement()) + ((AM.Disp != 0) && (Backup.Disp == 0)) + (AM.Segment.getNode() && !Backup.Segment.getNode()) >= 2 {
                Cost -= 1;
            }
            if Cost >= 0 {
                AM = Backup;
                break;
            }
            AM.IndexReg = RHS;
            AM.NegateIndex = true;
            AM.Scale = NegScale.value_or(1);
            return false;
        },
        OR => {
            XOR;
        },
        ADD => {
            if !self.matchAdd(N, AM, Depth) {
                return false;
            }
        },
        AND => {
            if AM.IndexReg.getNode() != null || AM.Scale != 1 {
                break;
            }
            assert!(N.getSimpleValueType().getSizeInBits().operator unsigned long long() <= 64, "Unexpected value size!");
            if !isa(N.getOperand(1)) {
                break;
            }
            if N.getOperand(0).getOpcode() == SRL {
                let mut Shift: SDValue = N.getOperand(0);
                let mut X: SDValue = Shift.getOperand(0);
                let mut Mask: u64 = N.getConstantOperandVal(1);
                if !foldMaskAndShiftToExtract(*self.CurDAG, N, Mask, Shift, X, AM) {
                    return false;
                }
                if !foldMaskAndShiftToScale(*self.CurDAG, N, Mask, Shift, X, AM) {
                    return false;
                }
                if !foldMaskedShiftToBEXTR(*self.CurDAG, N, Mask, Shift, X, AM, *self.Subtarget) {
                    return false;
                }
            }
            if !foldMaskedShiftToScaledMask(*self.CurDAG, N, AM) {
                return false;
            }
            break;
        },
        ZERO_EXTEND => {
            if AM.IndexReg.getNode() != null || AM.Scale != 1 {
                break;
            }
            let mut Src: SDValue = N.getOperand(0);
            if Src.getOpcode() == ADD || Src.getOpcode() == OR {
                if self.matchIndexRecursively(N, AM, Depth + 1) {
                    Index;
                } else if Index != N {
                    AM.IndexReg = Index;
                    return false;
                }
            }
            let mut Mask: APInt = getAllOnes(Src.getScalarValueSizeInBits());
            if Src.getOpcode() == AND && Src.hasOneUse() {
                if dyn_cast(Src.getOperand(1)) {
                    MaskC;
                } else {
                    Mask = MaskC.getAPIntValue();
                    Src = Src.getOperand(0);
                }
            }
            if Src.getOpcode() == SHL && Src.hasOneUse() && operator(N).hasOneUse() {
                let mut ShlSrc: SDValue = Src.getOperand(0);
                let mut ShlAmt: SDValue = Src.getOperand(1);
                let mut ShAmtC: *mut ConstantSDNode = dyn_cast(ShlAmt);
                if !ShAmtC {
                    break;
                }
                let mut ShAmtV: u32 = ShAmtC.getZExtValue();
                if ShAmtV > 3 {
                    break;
                }
                let mut HighZeros: APInt = getHighBitsSet(ShlSrc.getValueSizeInBits().operator unsigned long long(), ShAmtV);
                if !operator(Src).getFlags().hasNoUnsignedWrap() && !self.CurDAG.MaskedValueIsZero(ShlSrc, HighZeros & Mask, 0) {
                    break;
                }
                let mut SrcVT: MVT = ShlSrc.getSimpleValueType();
                let mut VT: MVT = N.getSimpleValueType();
                let mut DL: SDLoc = N;
                let mut Res: SDValue = ShlSrc;
                if !Mask.isAllOnes() {
                    Res = self.CurDAG.getConstant(Mask.lshr(ShAmtV), DL, SrcVT, false, false);
                    insertDAGNode(*self.CurDAG, N, Res);
                    Res = self.CurDAG.getNode(AND, DL, SrcVT, ShlSrc, Res);
                    insertDAGNode(*self.CurDAG, N, Res);
                }
                let mut Zext: SDValue = self.CurDAG.getNode(ZERO_EXTEND, DL, VT, Res);
                insertDAGNode(*self.CurDAG, N, Zext);
                let mut NewShl: SDValue = self.CurDAG.getNode(SHL, DL, VT, Zext, ShlAmt);
                insertDAGNode(*self.CurDAG, N, NewShl);
                self.CurDAG.ReplaceAllUsesWith(N, NewShl);
                self.CurDAG.RemoveDeadNode(N.getNode());
                AM.Scale = 1 << ShAmtV;
                AM.IndexReg = self.matchIndexRecursively(Zext, AM, Depth + 1);
                return false;
            }
            if Src.getOpcode() == SRL && !Mask.isAllOnes() {
                if !foldMaskAndShiftToExtract(*self.CurDAG, N, Mask.getZExtValue(), Src, Src.getOperand(0), AM) {
                    return false;
                }
                if !foldMaskAndShiftToScale(*self.CurDAG, N, Mask.getZExtValue(), Src, Src.getOperand(0), AM) {
                    return false;
                }
                if !foldMaskedShiftToBEXTR(*self.CurDAG, N, Mask.getZExtValue(), Src, Src.getOperand(0), AM, *self.Subtarget) {
                    return false;
                }
            }
            break;
        },
    }
    return self.matchAddressBase(N, AM);
}

fn X86DAGToDAGISel::matchAddressBase(self, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    if AM.BaseType != RegBase || AM.Base_Reg.getNode() {
        if !AM.IndexReg.getNode() {
            AM.IndexReg = N;
            AM.Scale = 1;
            return false;
        }
        return true;
    }
    AM.BaseType = RegBase;
    AM.Base_Reg = N;
    return false;
}

fn X86DAGToDAGISel::matchVectorAddressRecursively(self, N: SDValue, AM: *mut X86ISelAddressMode, Depth: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-isel", 1) {
            {
                dbgs() << "MatchVectorAddress: ";
                AM.dump(self.CurDAG);
            }
        }
    }
        if !(false) { break; }
    }
    if Depth >= MaxRecursionDepth {
        return self.matchAddressBase(N, AM);
    }
    match N.getOpcode() {
        Constant => {
            let mut Val: u64 = cast(N).getSExtValue();
            if !self.foldOffsetIntoAddress(Val, AM) {
                return false;
            }
            break;
        },
        Wrapper => {
            if !self.matchWrapper(N, AM) {
                return false;
            }
        },
        ADD => {
            let mut Handle: HandleSDNode = N;
            let mut Backup: X86ISelAddressMode = AM;
            if !self.matchVectorAddressRecursively(N.getOperand(0), AM, Depth + 1) && !self.matchVectorAddressRecursively(Handle.getValue().getOperand(1), AM, Depth + 1) {
                return false;
            }
            AM = Backup;
            if !self.matchVectorAddressRecursively(Handle.getValue().getOperand(1), AM, Depth + 1) && !self.matchVectorAddressRecursively(Handle.getValue().getOperand(0), AM, Depth + 1) {
                return false;
            }
            AM = Backup;
            N = Handle.getValue();
            break;
        },
    }
    return self.matchAddressBase(N, AM);
}

fn X86DAGToDAGISel::matchVectorAddress(self, N: SDValue, AM: *mut X86ISelAddressMode) -> bool {
    return self.matchVectorAddressRecursively(N, AM, 0);
}

fn X86DAGToDAGISel::selectVectorAddr(self, Parent: *mut MemSDNode, BasePtr: SDValue, IndexOp: SDValue, ScaleOp: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    let mut AM: X86ISelAddressMode = X86ISelAddressMode {};
    AM.Scale = operator(ScaleOp).getAsZExtVal();
    if IndexOp.getScalarValueSizeInBits() == BasePtr.getScalarValueSizeInBits() {
        AM.IndexReg = self.matchIndexRecursively(IndexOp, AM, 0);
    } else {
        AM.IndexReg = IndexOp;
    }
    let mut AddrSpace: u32 = Parent.getPointerInfo().getAddrSpace();
    if AddrSpace == GS {
        AM.Segment = self.CurDAG.getRegister(GS, i16);
    }
    if AddrSpace == FS {
        AM.Segment = self.CurDAG.getRegister(FS, i16);
    }
    if AddrSpace == SS {
        AM.Segment = self.CurDAG.getRegister(SS, i16);
    }
    let mut DL: SDLoc = BasePtr;
    let mut VT: MVT = BasePtr.getSimpleValueType();
    if self.matchVectorAddress(BasePtr, AM) {
        return false;
    }
    self.getAddressOperands(AM, DL, VT, Base, Scale, Index, Disp, Segment);
    return true;
}

fn X86DAGToDAGISel::selectAddr(self, Parent: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue, HasNDDM: bool) -> bool {
    let mut AM: X86ISelAddressMode = X86ISelAddressMode {};
    if Parent && Parent.getOpcode() != INTRINSIC_W_CHAIN && Parent.getOpcode() != INTRINSIC_VOID && Parent.getOpcode() != TLSCALL && Parent.getOpcode() != ENQCMD && Parent.getOpcode() != ENQCMDS && Parent.getOpcode() != EH_SJLJ_SETJMP && Parent.getOpcode() != EH_SJLJ_LONGJMP {
        let mut AddrSpace: u32 = cast(Parent).getPointerInfo().getAddrSpace();
        if AddrSpace == GS {
            AM.Segment = self.CurDAG.getRegister(GS, i16);
        }
        if AddrSpace == FS {
            AM.Segment = self.CurDAG.getRegister(FS, i16);
        }
        if AddrSpace == SS {
            AM.Segment = self.CurDAG.getRegister(SS, i16);
        }
    }
    let mut DL: SDLoc = N;
    let mut VT: MVT = N.getSimpleValueType();
    if self.matchAddress(N, AM) {
        return false;
    }
    if !HasNDDM && !AM.isRIPRelative() {
        return false;
    }
    self.getAddressOperands(AM, DL, VT, Base, Scale, Index, Disp, Segment);
    return true;
}

fn X86DAGToDAGISel::selectNDDAddr(self, Parent: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    return self.selectAddr(Parent, N, Base, Scale, Index, Disp, Segment, self.Subtarget.hasNDDM());
}

fn X86DAGToDAGISel::selectMOV64Imm32(self, N: SDValue, Imm: *mut SDValue) -> bool {
    if self.TM.getCodeModel() == Kernel || self.TM.getCodeModel() == Large {
        return false;
    }
    if operator(N).getOpcode() != Wrapper {
        return false;
    }
    N = N.getOperand(0);
    if operator(N).getOpcode() == TargetGlobalTLSAddress {
        return false;
    }
    Imm = N;
    if operator(N).getOpcode() != TargetGlobalAddress {
        return self.TM.getCodeModel() == Small || self.TM.getCodeModel() == Medium;
    }
    let mut GV: *GlobalValue = cast(N).getGlobal();
    if GV.getAbsoluteSymbolRange() {
        CR;
    } else {
        return operator(CR).getUnsignedMax().ult(1 << 32);
    }
    return !self.TM.isLargeGlobalValue(GV);
}

fn X86DAGToDAGISel::selectLEA64_Addr(self, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    let mut DL: SDLoc = N;
    if !self.selectLEAAddr(N, Base, Scale, Index, Disp, Segment) {
        return false;
    }
    let mut BaseType: EVT = Base.getValueType();
    let mut SubReg: u32 = 0;
    if BaseType == i8 {
        SubReg = sub_8bit;
    } else if BaseType == i16 {
        SubReg = sub_16bit;
    } else {
        SubReg = sub_32bit;
    }
    let mut RN: *mut RegisterSDNode = dyn_cast(Base);
    if RN && RN.getReg() == 0 {
        Base = self.CurDAG.getRegister(0, i64);
    } else if (BaseType == i8 || BaseType == i16 || BaseType == i32) && !isa(Base) {
        let mut ImplDef: SDValue = SDValue { Node: self.CurDAG.getMachineNode(IMPLICIT_DEF, DL, i64), ResNo: 0 };
        Base = self.CurDAG.getTargetInsertSubreg(SubReg, DL, i64, ImplDef, Base);
    }
    let mut IndexType: EVT = Index.getValueType();
    RN = dyn_cast(Index);
    if RN && RN.getReg() == 0 {
        Index = self.CurDAG.getRegister(0, i64);
    } else {
        assert!((IndexType == BaseType), "Expect to be extending 8/16/32-bit registers for use in LEA");
        let mut ImplDef: SDValue = SDValue { Node: self.CurDAG.getMachineNode(IMPLICIT_DEF, DL, i64), ResNo: 0 };
        Index = self.CurDAG.getTargetInsertSubreg(SubReg, DL, i64, ImplDef, Index);
    }
    return true;
}

fn X86DAGToDAGISel::selectLEAAddr(self, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    let mut AM: X86ISelAddressMode = X86ISelAddressMode {};
    AM.IsForLEA = true;
    let mut DL: SDLoc = N;
    let mut VT: MVT = N.getSimpleValueType();
    let mut Copy: SDValue = AM.Segment;
    let mut T: SDValue = self.CurDAG.getRegister(0, i32);
    AM.Segment = T;
    if self.matchAddress(N, AM) {
        return false;
    }
    assert!(T == AM.Segment);
    AM.Segment = Copy;
    let mut Complexity: u32 = 0;
    if AM.BaseType == RegBase && AM.Base_Reg.getNode() {
        Complexity = 1;
    } else if AM.BaseType == FrameIndexBase {
        Complexity = 4;
    }
    if AM.IndexReg.getNode() {
        Complexity += 1;
    }
    if AM.Scale > 1 {
        Complexity += 1;
    }
    if AM.hasSymbolicDisplacement() {
        if self.Subtarget.is64Bit() {
            Complexity = 4;
        } else {
            Complexity += 2;
        }
    }
    if N.getOpcode() == ADD {
        let mut isMathWithFlags: Closure_5 = Closure_5 {};
        if isMathWithFlags.call(N.getOperand(0)) || isMathWithFlags.call(N.getOperand(1)) {
            Complexity += 1;
        }
    }
    if AM.Disp {
        Complexity += 1;
    }
    if Complexity <= 2 {
        return false;
    }
    self.getAddressOperands(AM, DL, VT, Base, Scale, Index, Disp, Segment);
    return true;
}

fn X86DAGToDAGISel::selectTLSADDRAddr(self, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    assert!(N.getOpcode() == TargetGlobalTLSAddress || N.getOpcode() == TargetExternalSymbol);
    let mut AM: X86ISelAddressMode = X86ISelAddressMode {};
    if dyn_cast(N) {
        GA;
    } else {
        AM.GV = GA.getGlobal();
        AM.Disp += GA.getOffset();
        AM.SymbolFlags = GA.getTargetFlags();
    }
    if self.Subtarget.is32Bit() {
        AM.Scale = 1;
        AM.IndexReg = self.CurDAG.getRegister(EBX, i32);
    }
    let mut VT: MVT = N.getSimpleValueType();
    self.getAddressOperands(AM, N, VT, Base, Scale, Index, Disp, Segment);
    return true;
}

fn X86DAGToDAGISel::selectRelocImm(self, N: SDValue, Op: *mut SDValue) -> bool {
    let mut VT: EVT = N.getValueType();
    let mut WasTruncated: bool = false;
    if N.getOpcode() == TRUNCATE {
        WasTruncated = true;
        N = N.getOperand(0);
    }
    if N.getOpcode() != Wrapper {
        return false;
    }
    let mut Opc: u32 = operator(N.getOperand(0)).getOpcode();
    if Opc != TargetGlobalAddress || !WasTruncated {
        Op = N.getOperand(0);
        return !WasTruncated;
    }
    let mut GA: *mut GlobalAddressSDNode = cast(N.getOperand(0));
    let mut CR: optional<ConstantRange> = GA.getGlobal().getAbsoluteSymbolRange();
    if !CR || operator(CR).getUnsignedMax().uge(1 << VT.getSizeInBits().operator unsigned long long()) {
        return false;
    }
    Op = self.CurDAG.getTargetGlobalAddress(GA.getGlobal(), N, VT, GA.getOffset(), GA.getTargetFlags());
    return true;
}

fn X86DAGToDAGISel::tryFoldLoad(self, Root: *mut SDNode, P: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    assert!(Root && P, "Unknown root/parent nodes");
    if !isNON_EXTLoad(N.getNode()) || !self.IsProfitableToFold(N, P, Root) || !IsLegalToFold(N, P, Root, self.OptLevel, false) {
        return false;
    }
    return self.selectAddr(N.getNode(), N.getOperand(1), Base, Scale, Index, Disp, Segment, true);
}

fn X86DAGToDAGISel::tryFoldBroadcast(self, Root: *mut SDNode, P: *mut SDNode, N: SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
    assert!(Root && P, "Unknown root/parent nodes");
    if operator(N).getOpcode() != VBROADCAST_LOAD || !self.IsProfitableToFold(N, P, Root) || !IsLegalToFold(N, P, Root, self.OptLevel, false) {
        return false;
    }
    return self.selectAddr(N.getNode(), N.getOperand(1), Base, Scale, Index, Disp, Segment, true);
}

fn X86DAGToDAGISel::getGlobalBaseReg(self) -> *mut SDNode {
    let mut GlobalBaseReg: Register = self.getInstrInfo().getGlobalBaseReg(self.MF);
    let mut DL: *DataLayout = self.MF.getDataLayout();
    return self.CurDAG.getRegister(GlobalBaseReg, self.TLI.getPointerTy(DL, 0)).getNode();
}

fn X86DAGToDAGISel::isSExtAbsoluteSymbolRef(self: *X86DAGToDAGISel, Width: u32, N: *mut SDNode) -> bool {
    if N.getOpcode() == TRUNCATE {
        N = N.getOperand(0).getNode();
    }
    if N.getOpcode() != Wrapper {
        return false;
    }
    let mut GA: *mut GlobalAddressSDNode = dyn_cast(N.getOperand(0));
    if !GA {
        return false;
    }
    let mut GV: *GlobalValue = GA.getGlobal();
    let mut CR: optional<ConstantRange> = GV.getAbsoluteSymbolRange();
    if CR {
        return operator(CR).getSignedMin().sge(-1 << Width) && operator(CR).getSignedMax().slt(1 << Width);
    }
    return self.TM.getCodeModel() != Large && Width == 32 && !self.TM.isLargeGlobalValue(GV);
}

fn X86DAGToDAGISel::getCondFromNode(self: *X86DAGToDAGISel, N: *mut SDNode) -> CondCode {
    assert!(N.isMachineOpcode(), "Unexpected node");
    let mut Opc: u32 = N.getMachineOpcode();
    let mut MCID: *MCInstrDesc = self.getInstrInfo().get(Opc);
    let mut CondNo: i32 = getCondSrcNoFromDesc(MCID);
    if CondNo < 0 {
        return COND_INVALID;
    }
    return N.getConstantOperandVal(CondNo) as CondCode;
}

fn X86DAGToDAGISel::onlyUsesZeroFlag(self: *X86DAGToDAGISel, Flags: SDValue) -> bool {
    for Use in operator(Flags).uses() {
        if Use.getResNo() != Flags.getResNo() {
            continue;
        }
        let mut User: *mut SDNode = Use.getUser();
        if User.getOpcode() != CopyToReg || cast(User.getOperand(1)).getReg() != EFLAGS {
            return false;
        }
        for FlagUse in User.uses() {
            if FlagUse.getResNo() != 1 {
                continue;
            }
            if !FlagUse.getUser().isMachineOpcode() {
                return false;
            }
            let mut CC: CondCode = self.getCondFromNode(FlagUse.getUser());
            match CC {
                COND_E => {
                    COND_NE;
                },
                _ => {
                    return false;
                },
            }
        }
    }
    return true;
}

fn X86DAGToDAGISel::hasNoSignFlagUses(self: *X86DAGToDAGISel, Flags: SDValue) -> bool {
    for Use in operator(Flags).uses() {
        if Use.getResNo() != Flags.getResNo() {
            continue;
        }
        let mut User: *mut SDNode = Use.getUser();
        if User.getOpcode() != CopyToReg || cast(User.getOperand(1)).getReg() != EFLAGS {
            return false;
        }
        for FlagUse in User.uses() {
            if FlagUse.getResNo() != 1 {
                continue;
            }
            if !FlagUse.getUser().isMachineOpcode() {
                return false;
            }
            let mut CC: CondCode = self.getCondFromNode(FlagUse.getUser());
            match CC {
                COND_A => {
                    COND_AE;
                },
                _ => {
                    return false;
                },
            }
        }
    }
    return true;
}

fn mayUseCarryFlag(CC: CondCode) -> bool {
    match CC {
        COND_O => {
            COND_NO;
        },
        _ => {
            return true;
        },
    }
}

fn X86DAGToDAGISel::hasNoCarryFlagUses(self: *X86DAGToDAGISel, Flags: SDValue) -> bool {
    for Use in operator(Flags).uses() {
        if Use.getResNo() != Flags.getResNo() {
            continue;
        }
        let mut User: *mut SDNode = Use.getUser();
        let mut UserOpc: u32 = User.getOpcode();
        if UserOpc == CopyToReg {
            if cast(User.getOperand(1)).getReg() != EFLAGS {
                return false;
            }
            for FlagUse in User.uses() {
                if FlagUse.getResNo() != 1 {
                    continue;
                }
                if !FlagUse.getUser().isMachineOpcode() {
                    return false;
                }
                let mut CC: CondCode = self.getCondFromNode(FlagUse.getUser());
                if mayUseCarryFlag(CC) {
                    return false;
                }
            }
            continue;
        }
        let mut CCOpNo: u32 = 0;
        match UserOpc {
            _ => {
                return false;
            },
            SETCC => {
                CCOpNo = 0;
            },
            SETCC_CARRY => {
                CCOpNo = 0;
            },
            CMOV => {
                CCOpNo = 2;
            },
            BRCOND => {
                CCOpNo = 2;
            },
        }
        let mut CC: CondCode = User.getConstantOperandVal(CCOpNo) as CondCode;
        if mayUseCarryFlag(CC) {
            return false;
        }
    }
    return true;
}

fn addrMayUseNonFixedFrameIndex(Addr: SDValue, MFI: *MachineFrameInfo, Depth: u32) -> bool {
    if dyn_cast(Addr) {
        FI;
    } else {
        return !MFI.isFixedObjectIndex(FI.getIndex());
    }
    if Depth >= MaxRecursionDepth {
        return true;
    }
    match Addr.getOpcode() {
        ADD => {
            OR;
        },
        SUB => {
            return addrMayUseNonFixedFrameIndex(Addr.getOperand(0), MFI, Depth + 1);
        },
        _ => {
            return false;
        },
    }
}

fn X86DAGToDAGISel::checkTCRetEnoughRegs(self: *X86DAGToDAGISel, N: *mut SDNode) -> bool {
    assert!(N.getOpcode() == TC_RETURN);
    let mut BasePtr: *SDValue = cast(N.getOperand(1)).getBasePtr();
    if addrMayUseNonFixedFrameIndex(BasePtr, self.MF.getFrameInfo(), 0) {
        return false;
    }
    let mut RI: *X86RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut AvailGPRs: u32 = 0;
    if self.Subtarget.is64Bit() {
        let mut TCGPRs: *TargetRegisterClass = if self.Subtarget.isCallingConvWin64(self.MF.getFunction().getCallingConv()) { &mut GR64_TCW64RegClass } else { &mut GR64_TCRegClass };
        assert!(TCGPRs.contains(RSP);
        assert!(TCGPRs.contains(RIP);
        AvailGPRs = TCGPRs.getNumRegs() - 2;
    } else {
        let mut TCGPRs: *TargetRegisterClass = if self.MF.getFunction().getCallingConv() == HiPE { &mut GR32RegClass } else { &mut GR32_TCRegClass };
        assert!(TCGPRs.contains(ESP);
        AvailGPRs = TCGPRs.getNumRegs() - 1;
    }
    let mut LoadGPRs: u32 = 2;
    if self.Subtarget.is32Bit() {
        if isa(BasePtr) {
            LoadGPRs -= 2;
        } else if BasePtr.getOpcode() == Wrapper && isa(operator(BasePtr).getOperand(0)) {
            if self.getTargetMachine().isPositionIndependent() {
                return false;
            }
            LoadGPRs -= 1;
        }
    }
    let mut ArgGPRs: u32 = 0;
    for let mut I: u32 = 3;
let mut E: u32 = N.getNumOperands(); I != E; I += 1 {
        if dyn_cast(N.getOperand(I)) {
            RN;
        } else {
            if !RI.isGeneralPurposeRegister(*self.MF, RN.getReg().operator MCRegister()) {
                continue;
            }
            if ArgGPRs += 1 + LoadGPRs > AvailGPRs {
                return false;
            }
        }
    }
    return true;
}

fn isFusableLoadOpStorePattern(StoreNode: *mut StoreSDNode, StoredVal: SDValue, CurDAG: *mut SelectionDAG, LoadOpNo: u32, LoadNode: *mut *mut LoadSDNode, InputChain: *mut SDValue) -> bool {
    if StoredVal.getResNo() != 0 {
        return false;
    }
    if !StoredVal.getNode().hasNUsesOfValue(1, 0) {
        return false;
    }
    if !isNormalStore(StoreNode) || StoreNode.isNonTemporal() {
        return false;
    }
    let mut Load: SDValue = operator(StoredVal).getOperand(LoadOpNo);
    if !isNormalLoad(Load.getNode()) {
        return false;
    }
    LoadNode = cast(Load);
    if !Load.hasOneUse() {
        return false;
    }
    if LoadNode.getBasePtr() != StoreNode.getBasePtr() || LoadNode.getOffset() != StoreNode.getOffset() {
        return false;
    }
    let mut FoundLoad: bool = false;
    let mut ChainOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut LoopWorklist: SmallVector<const SDNode *, 4> = SmallVector<const SDNode *, 4> {};
    let mut Visited: SmallPtrSet<const SDNode *, 16> = SmallPtrSet<const SDNode *, 16> {};
    let mut Max: u32 = 1024;
    let mut Chain: SDValue = StoreNode.getChain();
    if Chain == Load.getValue(1) {
        FoundLoad = true;
        ChainOps.push(Load.getOperand(0));
    } else if Chain.getOpcode() == TokenFactor {
        for let mut i: u32 = 0;
let mut e: u32 = Chain.getNumOperands(); i != e; i += 1 {
            let mut Op: SDValue = Chain.getOperand(i);
            if Op == Load.getValue(1) {
                FoundLoad = true;
                ChainOps.push(Load.getOperand(0));
                continue;
            }
            LoopWorklist.push(Op.getNode());
            ChainOps.push(Op);
        }
    }
    if !FoundLoad {
        return false;
    }
    for Op in operator(StoredVal).ops() {
        if Op.getNode() != LoadNode {
            LoopWorklist.push(Op.getNode());
        }
    }
    if hasPredecessorHelper(Load.getNode(), Visited, LoopWorklist, Max, true) {
        return false;
    }
    InputChain = CurDAG.getNode(TokenFactor, Chain, Other, ChainOps);
    return true;
}

fn X86DAGToDAGISel::foldLoadStoreIntoMemOperand(self, Node: *mut SDNode) -> bool {
    let mut StoreNode: *mut StoreSDNode = cast(Node);
    let mut StoredVal: SDValue = StoreNode.getOperand(1);
    let mut Opc: u32 = operator(StoredVal).getOpcode();
    let mut MemVT: EVT = StoreNode.getMemoryVT();
    if MemVT != i64 && MemVT != i32 && MemVT != i16 && MemVT != i8 {
        return false;
    }
    let mut IsCommutable: bool = false;
    let mut IsNegate: bool = false;
    match Opc {
        _ => {
            return false;
        },
        SUB => {
            IsNegate = isNullConstant(StoredVal.getOperand(0));
        },
        SBB => {
            break;
        },
        ADD => {
            ADC;
        },
    }
    let mut LoadOpNo: u32 = if IsNegate { 1 } else { 0 };
    let mut LoadNode: *mut LoadSDNode = null;
    let mut InputChain: SDValue = SDValue {};
    if !isFusableLoadOpStorePattern(StoreNode, StoredVal, self.CurDAG, LoadOpNo, LoadNode, InputChain) {
        if !IsCommutable {
            return false;
        }
        LoadOpNo = 1;
        if !isFusableLoadOpStorePattern(StoreNode, StoredVal, self.CurDAG, LoadOpNo, LoadNode, InputChain) {
            return false;
        }
    }
    let mut Base: SDValue = SDValue {};
    let mut Scale: SDValue = SDValue {};
    let mut Index: SDValue = SDValue {};
    let mut Disp: SDValue = SDValue {};
    let mut Segment: SDValue = SDValue {};
    if !self.selectAddr(LoadNode, LoadNode.getBasePtr(), Base, Scale, Index, Disp, Segment, true) {
        return false;
    }
    let mut SelectOpcode: Closure_6 = Closure_6 { MemVT: &mut MemVT };
    let mut Result: *mut MachineSDNode = null;
    match Opc {
        SUB => {
            if IsNegate {
                let mut NewOpc: u32 = SelectOpcode.call(NEG64m, NEG32m, NEG16m, NEG8m);
                let mut Ops: [6]SDValue = [Base, Scale, Index, Disp, Segment, InputChain];
                Result = self.CurDAG.getMachineNode(NewOpc, Node, i32, Other, Ops);
                break;
            }
        },
        ADD => {
            if !self.Subtarget.slowIncDec() || self.CurDAG.shouldOptForSize() {
                let mut IsOne: bool = isOneConstant(StoredVal.getOperand(1));
                let mut IsNegOne: bool = isAllOnesConstant(StoredVal.getOperand(1));
                if (IsOne || IsNegOne) && self.hasNoCarryFlagUses(StoredVal.getValue(1)) {
                    let mut NewOpc: u32 = if ((Opc == ADD) == IsOne) { SelectOpcode.call(INC64m, INC32m, INC16m, INC8m) } else { SelectOpcode.call(DEC64m, DEC32m, DEC16m, DEC8m) };
                    let mut Ops: [6]SDValue = [Base, Scale, Index, Disp, Segment, InputChain];
                    Result = self.CurDAG.getMachineNode(NewOpc, Node, i32, Other, Ops);
                    break;
                }
            }
        },
        ADC => {
            SBB;
        },
        _ => {
            llvm_unreachable_internal("Invalid opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 4127);
        },
    }
    let mut MemOps: [2]*mut MachineMemOperand = [StoreNode.getMemOperand(), LoadNode.getMemOperand()];
    self.CurDAG.setNodeMemRefs(Result, MemOps);
    self.ReplaceUses(SDValue { Node: LoadNode, ResNo: 1 }, SDValue { Node: Result, ResNo: 1 });
    self.ReplaceUses(SDValue { Node: StoreNode, ResNo: 0 }, SDValue { Node: Result, ResNo: 1 });
    self.ReplaceUses(SDValue { Node: StoredVal.getNode(), ResNo: 1 }, SDValue { Node: Result, ResNo: 0 });
    self.CurDAG.RemoveDeadNode(Node);
    return true;
}

fn X86DAGToDAGISel::matchBitExtract(self, Node: *mut SDNode) -> bool {
    assert!((Node.getOpcode() == ADD || Node.getOpcode() == AND || Node.getOpcode() == XOR || Node.getOpcode() == SRL), "Should be either an and-mask, a standalone low-bits mask, or right-shift after clearing high bits.");
    if !self.Subtarget.hasBMI() && !self.Subtarget.hasBMI2() {
        return false;
    }
    let mut NVT: MVT = Node.getSimpleValueType(0);
    if NVT != i32 && NVT != i64 {
        return false;
    }
    let mut NBits: SDValue = SDValue {};
    let mut NegateNBits: bool = false;
    let mut AllowExtraUsesByDefault: bool = self.Subtarget.hasBMI2();
    let mut checkUses: Closure_7 = Closure_7 { AllowExtraUsesByDefault: AllowExtraUsesByDefault };
    let mut checkOneUse: Closure_8 = Closure_8 { cap_0: checkUses };
    let mut checkTwoUse: Closure_9 = Closure_9 { cap_0: checkUses };
    let mut peekThroughOneUseTruncation: Closure_10 = Closure_10 { cap_0: checkOneUse };
    let mut matchPatternA: Closure_11 = Closure_11 { cap_0: checkOneUse, cap_1: peekThroughOneUseTruncation, NBits: &mut NBits, NegateNBits: &mut NegateNBits };
    let mut isAllOnes: Closure_12 = Closure_12 { cap_0: self, cap_1: peekThroughOneUseTruncation, cap_2: NVT };
    let mut matchPatternB: Closure_13 = Closure_13 { cap_0: checkOneUse, cap_1: isAllOnes, cap_2: peekThroughOneUseTruncation, NBits: &mut NBits, NegateNBits: &mut NegateNBits };
    let mut canonicalizeShiftAmt: Closure_14 = Closure_14 { NBits: &mut NBits, NegateNBits: &mut NegateNBits };
    let mut matchPatternC: Closure_15 = Closure_15 { cap_0: checkOneUse, cap_1: peekThroughOneUseTruncation, NegateNBits: &mut NegateNBits, cap_3: canonicalizeShiftAmt };
    let mut X: SDValue = SDValue {};
    let mut matchPatternD: Closure_16 = Closure_16 { cap_0: checkOneUse, cap_1: checkTwoUse, cap_2: canonicalizeShiftAmt, AllowExtraUsesByDefault: AllowExtraUsesByDefault, NegateNBits: &mut NegateNBits, X: &mut X };
    let mut matchLowBitMask: Closure_17 = Closure_17 { cap_0: matchPatternA, cap_1: matchPatternB, cap_2: matchPatternC };
    if Node.getOpcode() == AND {
        X = Node.getOperand(0);
        let mut Mask: SDValue = Node.getOperand(1);
        if matchLowBitMask.call(Mask) {} else {
            swap(X, Mask);
            if !matchLowBitMask.call(Mask) {
                return false;
            }
        }
    } else if matchLowBitMask.call(SDValue { Node: Node, ResNo: 0 }) {
        X = self.CurDAG.getAllOnesConstant(Node, NVT, false, false);
    } else if !matchPatternD.call(Node) {
        return false;
    }
    if NegateNBits && !self.Subtarget.hasBMI2() {
        return false;
    }
    let mut DL: SDLoc = Node;
    if NBits.getSimpleValueType() != i8 {
        NBits = self.CurDAG.getNode(TRUNCATE, DL, i8, NBits);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
    }
    let mut Imm: *mut ConstantSDNode = null;
    if operator(NBits).getOpcode() == AND {
        if (Imm = dyn_cast(operator(NBits).getOperand(1))) {
            NBits = operator(NBits).getOperand(0);
        }
    }
    let mut ImplDef: SDValue = SDValue { Node: self.CurDAG.getMachineNode(IMPLICIT_DEF, DL, i32), ResNo: 0 };
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, ImplDef);
    let mut SRIdxVal: SDValue = self.CurDAG.getTargetConstant(sub_8bit, DL, i32, false);
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, SRIdxVal);
    NBits = SDValue { Node: self.CurDAG.getMachineNode(INSERT_SUBREG, DL, i32, ImplDef, NBits, SRIdxVal), ResNo: 0 };
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
    if Imm {
        NBits = self.CurDAG.getNode(AND, DL, i32, NBits, self.CurDAG.getConstant(Imm.getZExtValue(), DL, i32, false, false));
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
    }
    if NegateNBits {
        let mut BitWidthC: SDValue = self.CurDAG.getConstant(NVT.getSizeInBits().operator unsigned long long(), DL, i32, false, false);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, BitWidthC);
        NBits = self.CurDAG.getNode(SUB, DL, i32, BitWidthC, NBits);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
    }
    if self.Subtarget.hasBMI2() {
        if NVT != i32 {
            NBits = self.CurDAG.getNode(ANY_EXTEND, DL, NVT, NBits);
            insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, NBits);
        }
        let mut Extract: SDValue = self.CurDAG.getNode(BZHI, DL, NVT, X, NBits);
        self.ReplaceNode(Node, Extract.getNode());
        self.SelectCode(Extract.getNode());
        return true;
    }
    {
        let mut RealX: SDValue = peekThroughOneUseTruncation.call(X);
        if RealX != X && RealX.getOpcode() == SRL {
            X = RealX;
        }
    }
    let mut XVT: MVT = X.getSimpleValueType();
    let mut C8: SDValue = self.CurDAG.getConstant(8, DL, i8, false, false);
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, C8);
    let mut Control: SDValue = self.CurDAG.getNode(SHL, DL, i32, NBits, C8);
    insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, Control);
    if X.getOpcode() == SRL {
        let mut ShiftAmt: SDValue = X.getOperand(1);
        X = X.getOperand(0);
        assert!(ShiftAmt.getValueType() == i8, "Expected shift amount to be i8");
        let mut OrigShiftAmt: SDValue = ShiftAmt;
        ShiftAmt = self.CurDAG.getNode(ZERO_EXTEND, DL, i32, ShiftAmt);
        insertDAGNode(*self.CurDAG, OrigShiftAmt, ShiftAmt);
        Control = self.CurDAG.getNode(OR, DL, i32, Control, ShiftAmt);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, Control);
    }
    if XVT != i32 {
        Control = self.CurDAG.getNode(ANY_EXTEND, DL, XVT, Control);
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, Control);
    }
    let mut Extract: SDValue = self.CurDAG.getNode(BEXTR, DL, XVT, X, Control);
    if XVT != NVT {
        insertDAGNode(*self.CurDAG, SDValue { Node: Node, ResNo: 0 }, Extract);
        Extract = self.CurDAG.getNode(TRUNCATE, DL, NVT, Extract);
    }
    self.ReplaceNode(Node, Extract.getNode());
    self.SelectCode(Extract.getNode());
    return true;
}

fn X86DAGToDAGISel::matchBEXTRFromAndImm(self, Node: *mut SDNode) -> *mut MachineSDNode {
    let mut NVT: MVT = Node.getSimpleValueType(0);
    let mut dl: SDLoc = Node;
    let mut N0: SDValue = Node.getOperand(0);
    let mut N1: SDValue = Node.getOperand(1);
    let mut PreferBEXTR: bool = self.Subtarget.hasTBM() || (self.Subtarget.hasBMI() && self.Subtarget.hasFastBEXTR());
    if !PreferBEXTR && !self.Subtarget.hasBMI2() {
        return null;
    }
    if operator(N0).getOpcode() != SRL && operator(N0).getOpcode() != SRA {
        return null;
    }
    if !operator(N0).hasOneUse() {
        return null;
    }
    if NVT != i32 && NVT != i64 {
        return null;
    }
    let mut MaskCst: *mut ConstantSDNode = dyn_cast(N1);
    let mut ShiftCst: *mut ConstantSDNode = dyn_cast(operator(N0).getOperand(1));
    if !MaskCst || !ShiftCst {
        return null;
    }
    let mut Mask: u64 = MaskCst.getZExtValue();
    if !isMask_64(Mask) {
        return null;
    }
    let mut Shift: u64 = ShiftCst.getZExtValue();
    let mut MaskSize: u64 = popcount(Mask);
    if Shift == 8 && MaskSize == 8 {
        return null;
    }
    if Shift + MaskSize > NVT.getSizeInBits().operator unsigned long long() {
        return null;
    }
    if !PreferBEXTR && MaskSize <= 32 {
        return null;
    }
    let mut Control: SDValue = SDValue {};
    let mut ROpc: u32 = 0;
    let mut MOpc: u32 = 0;
    if !PreferBEXTR {
        assert!(self.Subtarget.hasBMI2(), "We must have BMI2's BZHI then.");
        Control = self.CurDAG.getTargetConstant(Shift + MaskSize, dl, NVT, false);
        ROpc = if NVT == i64 { (if self.Subtarget.hasEGPR() { BZHI64rr_EVEX } else { BZHI64rr }) } else { (if self.Subtarget.hasEGPR() { BZHI32rr_EVEX } else { BZHI32rr }) };
        MOpc = if NVT == i64 { (if self.Subtarget.hasEGPR() { BZHI64rm_EVEX } else { BZHI64rm }) } else { (if self.Subtarget.hasEGPR() { BZHI32rm_EVEX } else { BZHI32rm }) };
        let mut NewOpc: u32 = if NVT == i64 { MOV32ri64 } else { MOV32ri };
        Control = SDValue { Node: self.CurDAG.getMachineNode(NewOpc, dl, NVT, Control), ResNo: 0 };
    } else {
        Control = self.CurDAG.getTargetConstant(Shift | (MaskSize << 8), dl, NVT, false);
        if self.Subtarget.hasTBM() {
            ROpc = if NVT == i64 { BEXTRI64ri } else { BEXTRI32ri };
            MOpc = if NVT == i64 { BEXTRI64mi } else { BEXTRI32mi };
        } else {
            assert!(self.Subtarget.hasBMI(), "We must have BMI1's BEXTR then.");
            ROpc = if NVT == i64 { (if self.Subtarget.hasEGPR() { BEXTR64rr_EVEX } else { BEXTR64rr }) } else { (if self.Subtarget.hasEGPR() { BEXTR32rr_EVEX } else { BEXTR32rr }) };
            MOpc = if NVT == i64 { (if self.Subtarget.hasEGPR() { BEXTR64rm_EVEX } else { BEXTR64rm }) } else { (if self.Subtarget.hasEGPR() { BEXTR32rm_EVEX } else { BEXTR32rm }) };
            let mut NewOpc: u32 = if NVT == i64 { MOV32ri64 } else { MOV32ri };
            Control = SDValue { Node: self.CurDAG.getMachineNode(NewOpc, dl, NVT, Control), ResNo: 0 };
        }
    }
    let mut NewNode: *mut MachineSDNode = null;
    let mut Input: SDValue = operator(N0).getOperand(0);
    let mut Tmp0: SDValue = SDValue {};
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    if self.tryFoldLoad(Node, N0.getNode(), Input, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
        let mut Ops: [7]SDValue = [Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Control, Input.getOperand(0)];
        let mut VTs: SDVTList = self.CurDAG.getVTList(NVT, i32, Other);
        NewNode = self.CurDAG.getMachineNode(MOpc, dl, VTs, Ops);
        self.ReplaceUses(Input.getValue(1), SDValue { Node: NewNode, ResNo: 2 });
        self.CurDAG.setNodeMemRefs(NewNode, [cast(Input).getMemOperand()]);
    } else {
        NewNode = self.CurDAG.getMachineNode(ROpc, dl, NVT, i32, Input, Control);
    }
    if !PreferBEXTR {
        let mut ShAmt: SDValue = self.CurDAG.getTargetConstant(Shift, dl, NVT, false);
        let mut NewOpc: u32 = if NVT == i64 { (if self.Subtarget.hasNDD() { SHR64ri_ND } else { SHR64ri }) } else { (if self.Subtarget.hasNDD() { SHR32ri_ND } else { SHR32ri }) };
        NewNode = self.CurDAG.getMachineNode(NewOpc, dl, NVT, SDValue { Node: NewNode, ResNo: 0 }, ShAmt);
    }
    return NewNode;
}

fn X86DAGToDAGISel::emitPCMPISTR(self, ROpc: u32, MOpc: u32, MayFoldLoad: bool, dl: *SDLoc, VT: MVT, Node: *mut SDNode) -> *mut MachineSDNode {
    let mut N0: SDValue = Node.getOperand(0);
    let mut N1: SDValue = Node.getOperand(1);
    let mut Imm: SDValue = Node.getOperand(2);
    let mut Val: *ConstantInt = cast(Imm).getConstantIntValue();
    Imm = self.CurDAG.getTargetConstant(*Val, Node, Imm.getValueType(), false);
    let mut Tmp0: SDValue = SDValue {};
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    if MayFoldLoad && self.tryFoldLoad(Node, N1, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
        let mut Ops: [8]SDValue = [N0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Imm, N1.getOperand(0)];
        let mut VTs: SDVTList = self.CurDAG.getVTList(VT, i32, Other);
        let mut CNode: *mut MachineSDNode = self.CurDAG.getMachineNode(MOpc, dl, VTs, Ops);
        self.ReplaceUses(N1.getValue(1), SDValue { Node: CNode, ResNo: 2 });
        self.CurDAG.setNodeMemRefs(CNode, [cast(N1).getMemOperand()]);
        return CNode;
    }
    let mut Ops: [3]SDValue = [N0, N1, Imm];
    let mut VTs: SDVTList = self.CurDAG.getVTList(VT, i32);
    let mut CNode: *mut MachineSDNode = self.CurDAG.getMachineNode(ROpc, dl, VTs, Ops);
    return CNode;
}

fn X86DAGToDAGISel::emitPCMPESTR(self, ROpc: u32, MOpc: u32, MayFoldLoad: bool, dl: *SDLoc, VT: MVT, Node: *mut SDNode, InGlue: *mut SDValue) -> *mut MachineSDNode {
    let mut N0: SDValue = Node.getOperand(0);
    let mut N2: SDValue = Node.getOperand(2);
    let mut Imm: SDValue = Node.getOperand(4);
    let mut Val: *ConstantInt = cast(Imm).getConstantIntValue();
    Imm = self.CurDAG.getTargetConstant(*Val, Node, Imm.getValueType(), false);
    let mut Tmp0: SDValue = SDValue {};
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    if MayFoldLoad && self.tryFoldLoad(Node, N2, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
        let mut Ops: [9]SDValue = [N0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Imm, N2.getOperand(0), InGlue];
        let mut VTs: SDVTList = self.CurDAG.getVTList(VT, i32, Other, Glue);
        let mut CNode: *mut MachineSDNode = self.CurDAG.getMachineNode(MOpc, dl, VTs, Ops);
        InGlue = SDValue { Node: CNode, ResNo: 3 };
        self.ReplaceUses(N2.getValue(1), SDValue { Node: CNode, ResNo: 2 });
        self.CurDAG.setNodeMemRefs(CNode, [cast(N2).getMemOperand()]);
        return CNode;
    }
    let mut Ops: [4]SDValue = [N0, N2, Imm, InGlue];
    let mut VTs: SDVTList = self.CurDAG.getVTList(VT, i32, Glue);
    let mut CNode: *mut MachineSDNode = self.CurDAG.getMachineNode(ROpc, dl, VTs, Ops);
    InGlue = SDValue { Node: CNode, ResNo: 2 };
    return CNode;
}

fn X86DAGToDAGISel::tryShiftAmountMod(self, N: *mut SDNode) -> bool {
    let mut VT: EVT = N.getValueType(0);
    if VT.isVector() {
        return false;
    }
    let mut Size: u32 = if VT == i64 { 64 } else { 32 };
    let mut OrigShiftAmt: SDValue = N.getOperand(1);
    let mut ShiftAmt: SDValue = OrigShiftAmt;
    let mut DL: SDLoc = N;
    if operator(ShiftAmt).getOpcode() == TRUNCATE {
        ShiftAmt = operator(ShiftAmt).getOperand(0);
    }
    let mut NewShiftAmt: SDValue = SDValue {};
    if operator(ShiftAmt).getOpcode() == ADD || operator(ShiftAmt).getOpcode() == SUB || operator(ShiftAmt).getOpcode() == XOR {
        let mut Add0: SDValue = operator(ShiftAmt).getOperand(0);
        let mut Add1: SDValue = operator(ShiftAmt).getOperand(1);
        let mut Add0C: *mut ConstantSDNode = dyn_cast(Add0);
        let mut Add1C: *mut ConstantSDNode = dyn_cast(Add1);
        if Add1C && Add1C.getAPIntValue().urem(Size) == 0 {
            NewShiftAmt = Add0;
        } else if operator(ShiftAmt).getOpcode() != ADD && ShiftAmt.hasOneUse() && ((Add0C && Add0C.getAPIntValue().urem(Size) == Size - 1) || (Add1C && Add1C.getAPIntValue().urem(Size) == Size - 1)) {
            assert!(Add0C == null || Add1C == null);
            if operator(ShiftAmt).getOpcode() == SUB && Add0C == null {
                return false;
            }
            let mut OpVT: EVT = ShiftAmt.getValueType();
            let mut AllOnes: SDValue = self.CurDAG.getAllOnesConstant(DL, OpVT, false, false);
            NewShiftAmt = self.CurDAG.getNode(XOR, DL, OpVT, if Add0C == null { Add0 } else { Add1 }, AllOnes);
            insertDAGNode(*self.CurDAG, OrigShiftAmt, AllOnes);
            insertDAGNode(*self.CurDAG, OrigShiftAmt, NewShiftAmt);
        } else if operator(ShiftAmt).getOpcode() == SUB && Add0C && Add0C.getZExtValue() != 0 {
            let mut SubVT: EVT = ShiftAmt.getValueType();
            let mut X: SDValue = SDValue {};
            if Add0C.getZExtValue() % Size == 0 {
                X = Add1;
            } else if ShiftAmt.hasOneUse() && Size == 64 && Add0C.getZExtValue() % 32 == 0 {
                if Add1.getOpcode() == TRUNCATE {
                    Add1 = Add1.getOperand(0);
                    SubVT = Add1.getValueType();
                }
                if Add0.getValueType() != SubVT {
                    Add0 = self.CurDAG.getZExtOrTrunc(Add0, DL, SubVT);
                    insertDAGNode(*self.CurDAG, OrigShiftAmt, Add0);
                }
                X = self.CurDAG.getNode(ADD, DL, SubVT, Add1, Add0);
                insertDAGNode(*self.CurDAG, OrigShiftAmt, X);
            } else {
                return false;
            }
            let mut Zero: SDValue = self.CurDAG.getConstant(0, DL, SubVT, false, false);
            let mut Neg: SDValue = self.CurDAG.getNode(SUB, DL, SubVT, Zero, X);
            NewShiftAmt = Neg;
            insertDAGNode(*self.CurDAG, OrigShiftAmt, Zero);
            insertDAGNode(*self.CurDAG, OrigShiftAmt, Neg);
        } else {
            return false;
        }
    } else {
        return false;
    }
    if NewShiftAmt.getValueType() != i8 {
        NewShiftAmt = self.CurDAG.getNode(TRUNCATE, DL, i8, NewShiftAmt);
        insertDAGNode(*self.CurDAG, OrigShiftAmt, NewShiftAmt);
    }
    NewShiftAmt = self.CurDAG.getNode(AND, DL, i8, NewShiftAmt, self.CurDAG.getConstant(Size - 1, DL, i8, false, false));
    insertDAGNode(*self.CurDAG, OrigShiftAmt, NewShiftAmt);
    let mut UpdatedNode: *mut SDNode = self.CurDAG.UpdateNodeOperands(N, N.getOperand(0), NewShiftAmt);
    if UpdatedNode != N {
        self.ReplaceNode(N, UpdatedNode);
        return true;
    }
    if OrigShiftAmt.getNode().use_empty() {
        self.CurDAG.RemoveDeadNode(OrigShiftAmt.getNode());
    }
    self.SelectCode(N);
    return true;
}

fn X86DAGToDAGISel::tryShrinkShlLogicImm(self, N: *mut SDNode) -> bool {
    let mut NVT: MVT = N.getSimpleValueType(0);
    let mut Opcode: u32 = N.getOpcode();
    let mut dl: SDLoc = N;
    let mut Shift: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut Cst: *mut ConstantSDNode = dyn_cast(N1);
    if !Cst {
        return false;
    }
    let mut Val: i64 = Cst.getSExtValue();
    let mut FoundAnyExtend: bool = false;
    if Shift.getOpcode() == ANY_EXTEND && Shift.hasOneUse() && Shift.getOperand(0).getSimpleValueType() == i32 && isUInt(Val) {
        FoundAnyExtend = true;
        Shift = Shift.getOperand(0);
    }
    if Shift.getOpcode() != SHL || !Shift.hasOneUse() {
        return false;
    }
    if NVT != i32 && NVT != i64 {
        return false;
    }
    let mut ShlCst: *mut ConstantSDNode = dyn_cast(Shift.getOperand(1));
    if !ShlCst {
        return false;
    }
    let mut ShAmt: u64 = ShlCst.getZExtValue();
    let mut RemovedBitsMask: u64 = (1 << ShAmt) - 1;
    if Opcode != AND && (Val & RemovedBitsMask) != 0 {
        return false;
    }
    let mut CanShrinkImmediate: Closure_18 = Closure_18 { Opcode: &mut Opcode, Val: &mut Val, ShAmt: &mut ShAmt, NVT: &mut NVT };
    let mut ShiftedVal: i64 = 0;
    if !CanShrinkImmediate.call(ShiftedVal) {
        return false;
    }
    if Opcode == AND {
        let mut ZExtWidth: u32 = Cst.getAPIntValue().getActiveBits();
        ZExtWidth = bit_ceil(if ZExtWidth > 8 { ZExtWidth } else { 8 });
        let mut NeededMask: APInt = getLowBitsSet(NVT.getSizeInBits().operator unsigned long long(), ZExtWidth);
        operator(NeededMask, operator(Cst.getAPIntValue()));
        if self.CurDAG.MaskedValueIsZero(N.getOperand(0), NeededMask, 0) {
            return false;
        }
    }
    let mut X: SDValue = Shift.getOperand(0);
    if FoundAnyExtend {
        let mut NewX: SDValue = self.CurDAG.getNode(ANY_EXTEND, dl, NVT, X);
        insertDAGNode(*self.CurDAG, SDValue { Node: N, ResNo: 0 }, NewX);
        X = NewX;
    }
    let mut NewCst: SDValue = self.CurDAG.getSignedConstant(ShiftedVal, dl, NVT, false, false);
    insertDAGNode(*self.CurDAG, SDValue { Node: N, ResNo: 0 }, NewCst);
    let mut NewBinOp: SDValue = self.CurDAG.getNode(Opcode, dl, NVT, X, NewCst);
    insertDAGNode(*self.CurDAG, SDValue { Node: N, ResNo: 0 }, NewBinOp);
    let mut NewSHL: SDValue = self.CurDAG.getNode(SHL, dl, NVT, NewBinOp, Shift.getOperand(1));
    self.ReplaceNode(N, NewSHL.getNode());
    self.SelectCode(NewSHL.getNode());
    return true;
}

fn X86DAGToDAGISel::matchVPTERNLOG(self, Root: *mut SDNode, ParentA: *mut SDNode, ParentB: *mut SDNode, ParentC: *mut SDNode, A: SDValue, B: SDValue, C: SDValue, Imm: u8) -> bool {
    assert!(A.isOperandOf(ParentA) && B.isOperandOf(ParentB) && C.isOperandOf(ParentC), "Incorrect parent node");
    let mut tryFoldLoadOrBCast: Closure_19 = Closure_19 { cap_0: self };
    let mut FoldedLoad: bool = false;
    let mut Tmp0: SDValue = SDValue {};
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    if tryFoldLoadOrBCast.call(Root, ParentC, C, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
        FoldedLoad = true;
    } else if tryFoldLoadOrBCast.call(Root, ParentA, A, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
        FoldedLoad = true;
        swap(A, C);
        let mut OldImm: u8 = Imm;
        Imm = OldImm & 165;
        if OldImm & 2 {
            Imm |= 16;
        }
        if OldImm & 16 {
            Imm |= 2;
        }
        if OldImm & 8 {
            Imm |= 64;
        }
        if OldImm & 64 {
            Imm |= 8;
        }
    } else if tryFoldLoadOrBCast.call(Root, ParentB, B, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
        FoldedLoad = true;
        swap(B, C);
        let mut OldImm: u8 = Imm;
        Imm = OldImm & 153;
        if OldImm & 2 {
            Imm |= 4;
        }
        if OldImm & 4 {
            Imm |= 2;
        }
        if OldImm & 32 {
            Imm |= 64;
        }
        if OldImm & 64 {
            Imm |= 32;
        }
    }
    let mut DL: SDLoc = Root;
    let mut TImm: SDValue = self.CurDAG.getTargetConstant(Imm, DL, i8, false);
    let mut NVT: MVT = Root.getSimpleValueType(0);
    let mut MNode: *mut MachineSDNode = null;
    if FoldedLoad {
        let mut VTs: SDVTList = self.CurDAG.getVTList(NVT, Other);
        let mut Opc: u32 = 0;
        if C.getOpcode() == VBROADCAST_LOAD {
            let mut MemIntr: *mut MemIntrinsicSDNode = cast(C);
            let mut EltSize: u32 = MemIntr.getMemoryVT().getSizeInBits().operator unsigned long long();
            assert!((EltSize == 32 || EltSize == 64), "Unexpected broadcast size!");
            let mut UseD: bool = EltSize == 32;
            if NVT.is128BitVector() {
                Opc = if UseD { VPTERNLOGDZ128rmbi } else { VPTERNLOGQZ128rmbi };
            } else if NVT.is256BitVector() {
                Opc = if UseD { VPTERNLOGDZ256rmbi } else { VPTERNLOGQZ256rmbi };
            } else if NVT.is512BitVector() {
                Opc = if UseD { VPTERNLOGDZrmbi } else { VPTERNLOGQZrmbi };
            } else {
                llvm_unreachable_internal("Unexpected vector size!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 4988);
            }
        } else {
            let mut UseD: bool = NVT.getVectorElementType() == i32;
            if NVT.is128BitVector() {
                Opc = if UseD { VPTERNLOGDZ128rmi } else { VPTERNLOGQZ128rmi };
            } else if NVT.is256BitVector() {
                Opc = if UseD { VPTERNLOGDZ256rmi } else { VPTERNLOGQZ256rmi };
            } else if NVT.is512BitVector() {
                Opc = if UseD { VPTERNLOGDZrmi } else { VPTERNLOGQZrmi };
            } else {
                llvm_unreachable_internal("Unexpected vector size!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 4998);
            }
        }
        let mut Ops: [9]SDValue = [A, B, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, TImm, C.getOperand(0)];
        MNode = self.CurDAG.getMachineNode(Opc, DL, VTs, Ops);
        self.ReplaceUses(C.getValue(1), SDValue { Node: MNode, ResNo: 1 });
        self.CurDAG.setNodeMemRefs(MNode, [cast(C).getMemOperand()]);
    } else {
        let mut UseD: bool = NVT.getVectorElementType() == i32;
        let mut Opc: u32 = 0;
        if NVT.is128BitVector() {
            Opc = if UseD { VPTERNLOGDZ128rri } else { VPTERNLOGQZ128rri };
        } else if NVT.is256BitVector() {
            Opc = if UseD { VPTERNLOGDZ256rri } else { VPTERNLOGQZ256rri };
        } else if NVT.is512BitVector() {
            Opc = if UseD { VPTERNLOGDZrri } else { VPTERNLOGQZrri };
        } else {
            llvm_unreachable_internal("Unexpected vector size!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5018);
        }
        MNode = self.CurDAG.getMachineNode(Opc, DL, NVT, [A, B, C, TImm]);
    }
    self.ReplaceUses(SDValue { Node: Root, ResNo: 0 }, SDValue { Node: MNode, ResNo: 0 });
    self.CurDAG.RemoveDeadNode(Root);
    return true;
}

fn X86DAGToDAGISel::tryVPTERNLOG(self, N: *mut SDNode) -> bool {
    let mut NVT: MVT = N.getSimpleValueType(0);
    if !NVT.isVector() || !self.Subtarget.hasAVX512() || NVT.getVectorElementType() == i1 {
        return false;
    }
    if !(self.Subtarget.hasVLX() || NVT.is512BitVector()) {
        return false;
    }
    let mut getFoldableLogicOp: Closure_20 = Closure_20 {};
    let mut N0: SDValue = SDValue {};
    let mut N1: SDValue = SDValue {};
    let mut A: SDValue = SDValue {};
    let mut FoldableOp: SDValue = SDValue {};
    let mut tryPeelOuterNotWrappingLogic: Closure_21 = Closure_21 { getFoldableLogicOp: &mut getFoldableLogicOp, N0: &mut N0, N1: &mut N1, FoldableOp: &mut FoldableOp, A: &mut A };
    let mut PeeledOuterNot: bool = false;
    let mut OriN: *mut SDNode = N;
    if tryPeelOuterNotWrappingLogic.call(N) {
        InnerOp;
    } else {
        PeeledOuterNot = true;
        N = InnerOp.getNode();
    }
    let mut B: SDValue = FoldableOp.getOperand(0);
    let mut C: SDValue = FoldableOp.getOperand(1);
    let mut ParentA: *mut SDNode = N;
    let mut ParentB: *mut SDNode = FoldableOp.getNode();
    let mut ParentC: *mut SDNode = FoldableOp.getNode();
    let mut TernlogMagicA: u8 = 240;
    let mut TernlogMagicB: u8 = 204;
    let mut TernlogMagicC: u8 = 170;
    let mut PeekThroughNot: Closure_22 = Closure_22 {};
    PeekThroughNot.call(A, ParentA, TernlogMagicA);
    PeekThroughNot.call(B, ParentB, TernlogMagicB);
    PeekThroughNot.call(C, ParentC, TernlogMagicC);
    let mut Imm: u8 = 0;
    match FoldableOp.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5130);
        },
        AND => {
            Imm = TernlogMagicB & TernlogMagicC;
        },
        OR => {
            Imm = TernlogMagicB | TernlogMagicC;
        },
        XOR => {
            Imm = TernlogMagicB ^ TernlogMagicC;
        },
        ANDNP => {
            Imm = ~(TernlogMagicB) & TernlogMagicC;
        },
    }
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5138);
        },
        ANDNP => {
            if A == N0 {
                Imm &= ~TernlogMagicA;
            } else {
                Imm = ~(Imm) & TernlogMagicA;
            }
        },
        AND => {
            Imm &= TernlogMagicA;
        },
        OR => {
            Imm |= TernlogMagicA;
        },
        XOR => {
            Imm ^= TernlogMagicA;
        },
    }
    if PeeledOuterNot {
        Imm = ~Imm;
    }
    return self.matchVPTERNLOG(OriN, ParentA, ParentB, ParentC, A, B, C, Imm);
}

fn X86DAGToDAGISel::shrinkAndImmediate(self, And: *mut SDNode) -> bool {
    let mut VT: MVT = And.getSimpleValueType(0);
    if VT != i32 && VT != i64 {
        return false;
    }
    let mut And1C: *mut ConstantSDNode = dyn_cast(And.getOperand(1));
    if !And1C {
        return false;
    }
    let mut MaskVal: APInt = And1C.getAPIntValue();
    let mut MaskLZ: u32 = MaskVal.countl_zero();
    if !MaskLZ || (VT == i64 && MaskLZ == 32) {
        return false;
    }
    if VT == i64 && MaskLZ >= 32 {
        MaskLZ -= 32;
        MaskVal = MaskVal.trunc(32);
    }
    let mut And0: SDValue = And.getOperand(0);
    let mut HighZeros: APInt = getHighBitsSet(MaskVal.getBitWidth(), MaskLZ);
    let mut NegMaskVal: APInt = MaskVal | HighZeros;
    let mut MinWidth: u32 = NegMaskVal.getSignificantBits();
    if MinWidth > 32 || (MinWidth > 8 && MaskVal.getSignificantBits() <= 32) {
        return false;
    }
    if VT == i64 && MaskVal.getBitWidth() < 64 {
        NegMaskVal = NegMaskVal.zext(64);
        HighZeros = HighZeros.zext(64);
    }
    let mut Known0: KnownBits = self.CurDAG.computeKnownBits(And0, 0);
    if Known0.isConstant() || !HighZeros.isSubsetOf(Known0.Zero) {
        return false;
    }
    if NegMaskVal.isAllOnes() {
        if VT == i32 && !self.isDef32(And0.getNode()) {
            return false;
        }
        self.ReplaceNode(And, And0.getNode());
        return true;
    }
    let mut NewMask: SDValue = self.CurDAG.getConstant(NegMaskVal, And, VT, false, false);
    insertDAGNode(*self.CurDAG, SDValue { Node: And, ResNo: 0 }, NewMask);
    let mut NewAnd: SDValue = self.CurDAG.getNode(AND, And, VT, And0, NewMask);
    self.ReplaceNode(And, NewAnd.getNode());
    self.SelectCode(NewAnd.getNode());
    return true;
}

fn getVPTESTMOpc(TestVT: MVT, IsTestN: bool, FoldedLoad: bool, FoldedBCast: bool, Masked: bool) -> u32 {
    if FoldedBCast {
        match TestVT.SimpleTy {
            _ => {
                llvm_unreachable_internal("Unexpected VT!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5262);
            },
            v4i32 => {
                if Masked {
                    return if IsTestN { VPTESTNMDZ128rmbk } else { VPTESTMDZ128rmbk };
                }
            },
            v2i64 => {
                if Masked {
                    return if IsTestN { VPTESTNMQZ128rmbk } else { VPTESTMQZ128rmbk };
                }
            },
            v8i32 => {
                if Masked {
                    return if IsTestN { VPTESTNMDZ256rmbk } else { VPTESTMDZ256rmbk };
                }
            },
            v4i64 => {
                if Masked {
                    return if IsTestN { VPTESTNMQZ256rmbk } else { VPTESTMQZ256rmbk };
                }
            },
            v16i32 => {
                if Masked {
                    return if IsTestN { VPTESTNMDZrmbk } else { VPTESTMDZrmbk };
                }
            },
            v8i64 => {
                if Masked {
                    return if IsTestN { VPTESTNMQZrmbk } else { VPTESTMQZrmbk };
                }
            },
        }
    }
    if FoldedLoad {
        match TestVT.SimpleTy {
            _ => {
                llvm_unreachable_internal("Unexpected VT!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5268);
            },
            v4i32 => {
                if Masked {
                    return if IsTestN { VPTESTNMDZ128rmk } else { VPTESTMDZ128rmk };
                }
            },
            v2i64 => {
                if Masked {
                    return if IsTestN { VPTESTNMQZ128rmk } else { VPTESTMQZ128rmk };
                }
            },
            v8i32 => {
                if Masked {
                    return if IsTestN { VPTESTNMDZ256rmk } else { VPTESTMDZ256rmk };
                }
            },
            v4i64 => {
                if Masked {
                    return if IsTestN { VPTESTNMQZ256rmk } else { VPTESTMQZ256rmk };
                }
            },
            v16i32 => {
                if Masked {
                    return if IsTestN { VPTESTNMDZrmk } else { VPTESTMDZrmk };
                }
            },
            v8i64 => {
                if Masked {
                    return if IsTestN { VPTESTNMQZrmk } else { VPTESTMQZrmk };
                }
            },
            v16i8 => {
                if Masked {
                    return if IsTestN { VPTESTNMBZ128rmk } else { VPTESTMBZ128rmk };
                }
            },
            v8i16 => {
                if Masked {
                    return if IsTestN { VPTESTNMWZ128rmk } else { VPTESTMWZ128rmk };
                }
            },
            v32i8 => {
                if Masked {
                    return if IsTestN { VPTESTNMBZ256rmk } else { VPTESTMBZ256rmk };
                }
            },
            v16i16 => {
                if Masked {
                    return if IsTestN { VPTESTNMWZ256rmk } else { VPTESTMWZ256rmk };
                }
            },
            v64i8 => {
                if Masked {
                    return if IsTestN { VPTESTNMBZrmk } else { VPTESTMBZrmk };
                }
            },
            v32i16 => {
                if Masked {
                    return if IsTestN { VPTESTNMWZrmk } else { VPTESTMWZrmk };
                }
            },
        }
    }
    match TestVT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected VT!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5273);
        },
        v4i32 => {
            if Masked {
                return if IsTestN { VPTESTNMDZ128rrk } else { VPTESTMDZ128rrk };
            }
        },
        v2i64 => {
            if Masked {
                return if IsTestN { VPTESTNMQZ128rrk } else { VPTESTMQZ128rrk };
            }
        },
        v8i32 => {
            if Masked {
                return if IsTestN { VPTESTNMDZ256rrk } else { VPTESTMDZ256rrk };
            }
        },
        v4i64 => {
            if Masked {
                return if IsTestN { VPTESTNMQZ256rrk } else { VPTESTMQZ256rrk };
            }
        },
        v16i32 => {
            if Masked {
                return if IsTestN { VPTESTNMDZrrk } else { VPTESTMDZrrk };
            }
        },
        v8i64 => {
            if Masked {
                return if IsTestN { VPTESTNMQZrrk } else { VPTESTMQZrrk };
            }
        },
        v16i8 => {
            if Masked {
                return if IsTestN { VPTESTNMBZ128rrk } else { VPTESTMBZ128rrk };
            }
        },
        v8i16 => {
            if Masked {
                return if IsTestN { VPTESTNMWZ128rrk } else { VPTESTMWZ128rrk };
            }
        },
        v32i8 => {
            if Masked {
                return if IsTestN { VPTESTNMBZ256rrk } else { VPTESTMBZ256rrk };
            }
        },
        v16i16 => {
            if Masked {
                return if IsTestN { VPTESTNMWZ256rrk } else { VPTESTMWZ256rrk };
            }
        },
        v64i8 => {
            if Masked {
                return if IsTestN { VPTESTNMBZrrk } else { VPTESTMBZrrk };
            }
        },
        v32i16 => {
            if Masked {
                return if IsTestN { VPTESTNMWZrrk } else { VPTESTMWZrrk };
            }
        },
    }
}

fn orderRegForMul(N0: *mut SDValue, N1: *mut SDValue, LoReg: u32, MRI: *MachineRegisterInfo) {
    let mut GetPhysReg: Closure_23 = Closure_23 { MRI: &mut MRI };
    if GetPhysReg.call(N1) == LoReg && GetPhysReg.call(N0) != LoReg {
        swap(N0, N1);
    }
}

fn X86DAGToDAGISel::tryVPTESTM(self, Root: *mut SDNode, Setcc: SDValue, InMask: SDValue) -> bool {
    assert!(self.Subtarget.hasAVX512(), "Expected AVX512!");
    assert!(Setcc.getSimpleValueType().getVectorElementType() == i1, "Unexpected VT!");
    let mut CC: CondCode = cast(Setcc.getOperand(2)).get();
    if CC != SETEQ && CC != SETNE {
        return false;
    }
    let mut SetccOp0: SDValue = Setcc.getOperand(0);
    let mut SetccOp1: SDValue = Setcc.getOperand(1);
    if isBuildVectorAllZeros(SetccOp0.getNode()) {
        swap(SetccOp0, SetccOp1);
    }
    if !isBuildVectorAllZeros(SetccOp1.getNode()) {
        return false;
    }
    let mut N0: SDValue = SetccOp0;
    let mut CmpVT: MVT = N0.getSimpleValueType();
    let mut CmpSVT: MVT = CmpVT.getVectorElementType();
    let mut Src0: SDValue = N0;
    let mut Src1: SDValue = N0;
    {
        let mut N0Temp: SDValue = N0;
        if N0Temp.getOpcode() == BITCAST && N0Temp.hasOneUse() {
            N0Temp = N0.getOperand(0);
        }
        if N0Temp.getOpcode() == AND && N0Temp.hasOneUse() {
            Src0 = N0Temp.getOperand(0);
            Src1 = N0Temp.getOperand(1);
        }
    }
    let mut Widen: bool = !self.Subtarget.hasVLX() && !CmpVT.is512BitVector();
    let mut tryFoldLoadOrBCast: Closure_24 = Closure_24 { Widen: &mut Widen, cap_1: self, CmpSVT: &mut CmpSVT };
    let mut CanFoldLoads: bool = Src0 != Src1;
    let mut FoldedLoad: bool = false;
    let mut Tmp0: SDValue = SDValue {};
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    if CanFoldLoads {
        FoldedLoad = tryFoldLoadOrBCast.call(Root, N0.getNode(), Src1, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4);
        if !FoldedLoad {
            FoldedLoad = tryFoldLoadOrBCast.call(Root, N0.getNode(), Src0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4);
            if FoldedLoad {
                swap(Src0, Src1);
            }
        }
    }
    let mut FoldedBCast: bool = FoldedLoad && Src1.getOpcode() == VBROADCAST_LOAD;
    let mut IsMasked: bool = InMask.getNode() != null;
    let mut dl: SDLoc = Root;
    let mut ResVT: MVT = Setcc.getSimpleValueType();
    let mut MaskVT: MVT = ResVT;
    if Widen {
        let mut Scale: u32 = if CmpVT.is128BitVector() { 4 } else { 2 };
        let mut SubReg: u32 = if CmpVT.is128BitVector() { sub_xmm } else { sub_ymm };
        let mut NumElts: u32 = CmpVT.getVectorNumElements() * Scale;
        CmpVT = getVectorVT(CmpSVT, NumElts);
        MaskVT = getVectorVT(i1, NumElts);
        let mut ImplDef: SDValue = SDValue { Node: self.CurDAG.getMachineNode(IMPLICIT_DEF, dl, CmpVT), ResNo: 0 };
        Src0 = self.CurDAG.getTargetInsertSubreg(SubReg, dl, CmpVT, ImplDef, Src0);
        if !FoldedBCast {
            Src1 = self.CurDAG.getTargetInsertSubreg(SubReg, dl, CmpVT, ImplDef, Src1);
        }
        if IsMasked {
            let mut RegClass: u32 = self.TLI.getRegClassFor(MaskVT, false).getID();
            let mut RC: SDValue = self.CurDAG.getTargetConstant(RegClass, dl, i32, false);
            InMask = SDValue { Node: self.CurDAG.getMachineNode(COPY_TO_REGCLASS, dl, MaskVT, InMask, RC), ResNo: 0 };
        }
    }
    let mut IsTestN: bool = CC == SETEQ;
    let mut Opc: u32 = getVPTESTMOpc(CmpVT, IsTestN, FoldedLoad, FoldedBCast, IsMasked);
    let mut CNode: *mut MachineSDNode = null;
    if FoldedLoad {
        let mut VTs: SDVTList = self.CurDAG.getVTList(MaskVT, Other);
        if IsMasked {
            let mut Ops: [8]SDValue = [InMask, Src0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Src1.getOperand(0)];
            CNode = self.CurDAG.getMachineNode(Opc, dl, VTs, Ops);
        } else {
            let mut Ops: [7]SDValue = [Src0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Src1.getOperand(0)];
            CNode = self.CurDAG.getMachineNode(Opc, dl, VTs, Ops);
        }
        self.ReplaceUses(Src1.getValue(1), SDValue { Node: CNode, ResNo: 1 });
        self.CurDAG.setNodeMemRefs(CNode, [cast(Src1).getMemOperand()]);
    } else {
        if IsMasked {
            CNode = self.CurDAG.getMachineNode(Opc, dl, MaskVT, InMask, Src0, Src1);
        } else {
            CNode = self.CurDAG.getMachineNode(Opc, dl, MaskVT, Src0, Src1);
        }
    }
    if Widen {
        let mut RegClass: u32 = self.TLI.getRegClassFor(ResVT, false).getID();
        let mut RC: SDValue = self.CurDAG.getTargetConstant(RegClass, dl, i32, false);
        CNode = self.CurDAG.getMachineNode(COPY_TO_REGCLASS, dl, ResVT, SDValue { Node: CNode, ResNo: 0 }, RC);
    }
    self.ReplaceUses(SDValue { Node: Root, ResNo: 0 }, SDValue { Node: CNode, ResNo: 0 });
    self.CurDAG.RemoveDeadNode(Root);
    return true;
}

fn X86DAGToDAGISel::tryMatchBitSelect(self, N: *mut SDNode) -> bool {
    assert!(N.getOpcode() == OR, "Unexpected opcode!");
    let mut NVT: MVT = N.getSimpleValueType(0);
    if !NVT.isVector() || !self.Subtarget.hasAVX512() {
        return false;
    }
    if !(self.Subtarget.hasVLX() || NVT.is512BitVector()) {
        return false;
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if N1.getOpcode() == AND {
        swap(N0, N1);
    }
    if N0.getOpcode() != AND || N1.getOpcode() != ANDNP || !N0.hasOneUse() || !N1.hasOneUse() {
        return false;
    }
    let mut A: SDValue = N1.getOperand(0);
    let mut C: SDValue = N1.getOperand(1);
    let mut B: SDValue = SDValue {};
    if N0.getOperand(0) == A {
        B = N0.getOperand(1);
    } else if N0.getOperand(1) == A {
        B = N0.getOperand(0);
    } else {
        return false;
    }
    let mut dl: SDLoc = N;
    let mut Imm: SDValue = self.CurDAG.getTargetConstant(202, dl, i8, false);
    let mut Ternlog: SDValue = self.CurDAG.getNode(VPTERNLOG, dl, NVT, A, B, C, Imm);
    self.ReplaceNode(N, Ternlog.getNode());
    return self.matchVPTERNLOG(Ternlog.getNode(), Ternlog.getNode(), Ternlog.getNode(), Ternlog.getNode(), A, B, C, 202);
}

fn X86DAGToDAGISel::Select(self, Node: *mut SDNode) {
    let mut NVT: MVT = Node.getSimpleValueType(0);
    let mut Opcode: u32 = Node.getOpcode();
    let mut dl: SDLoc = Node;
    if Node.isMachineOpcode() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-isel", 1) {
                dbgs() << "== ";
                Node.dump(self.CurDAG);
                dbgs() << 10;
            }
        }
            if !(false) { break; }
        }
        Node.setNodeId(-1);
        return;
    }
    match Opcode {
        _ => {
            break;
        },
        INTRINSIC_W_CHAIN => {
            let mut IntNo: u32 = Node.getConstantOperandVal(1);
            match IntNo {
                _ => {
                    break;
                },
                x86_encodekey128 => {
                    x86_encodekey256;
                },
                x86_tileloaddrs64_internal => {
                    x86_tileloaddrst164_internal;
                },
                x86_tileloadd64_internal => {
                    x86_tileloaddt164_internal;
                },
            }
            break;
        },
        INTRINSIC_VOID => {
            let mut IntNo: u32 = Node.getConstantOperandVal(1);
            match IntNo {
                _ => {
                    break;
                },
                x86_sse3_monitor => {
                    x86_monitorx;
                },
                x86_tilestored64_internal => {
                    let mut MFI: *mut X86MachineFunctionInfo = self.CurDAG.getMachineFunction().getInfo();
                    MFI.setAMXProgModel(ManagedRA);
                    let mut Opc: u32 = PTILESTOREDV;
                    let mut Base: SDValue = Node.getOperand(4);
                    let mut Scale: SDValue = self.getI8Imm(1, dl);
                    let mut Index: SDValue = Node.getOperand(5);
                    let mut Disp: SDValue = self.CurDAG.getTargetConstant(0, dl, i32, false);
                    let mut Segment: SDValue = self.CurDAG.getRegister(0, i16);
                    let mut Chain: SDValue = Node.getOperand(0);
                    let mut CNode: *mut MachineSDNode = null;
                    let mut Ops: [9]SDValue = [Node.getOperand(2), Node.getOperand(3), Base, Scale, Index, Disp, Segment, Node.getOperand(6), Chain];
                    CNode = self.CurDAG.getMachineNode(Opc, dl, Other, Ops);
                    self.ReplaceNode(Node, CNode);
                    return;
                },
                x86_tileloaddrs64 => {
                    x86_tileloaddrst164;
                },
                x86_tileloadd64 => {
                    x86_tileloaddt164;
                },
            }
            break;
        },
        BRIND => {
            NT_BRIND;
        },
        GlobalBaseReg => {
            self.ReplaceNode(Node, self.getGlobalBaseReg());
        },
        BITCAST => {
            if NVT.is512BitVector() || NVT.is256BitVector() || NVT.is128BitVector() || NVT == f128 {
                self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, Node.getOperand(0));
                self.CurDAG.RemoveDeadNode(Node);
                return;
            }
        },
        SRL => {
            if self.matchBitExtract(Node) {
                return;
            }
        },
        SRA => {
            SHL;
        },
        VPTERNLOG => {
            let mut Imm: u8 = Node.getConstantOperandVal(3);
            if self.matchVPTERNLOG(Node, Node, Node, Node, Node.getOperand(0), Node.getOperand(1), Node.getOperand(2), Imm) {
                return;
            }
            break;
        },
        ANDNP => {
            if self.tryVPTERNLOG(Node) {
                return;
            }
        },
        AND => {
            if NVT.isVectorOf(i1) {
                let mut N0: SDValue = Node.getOperand(0);
                let mut N1: SDValue = Node.getOperand(1);
                if N0.getOpcode() == SETCC && N0.hasOneUse() && self.tryVPTESTM(Node, N0, N1) {
                    return;
                }
                if N1.getOpcode() == SETCC && N1.hasOneUse() && self.tryVPTESTM(Node, N1, N0) {
                    return;
                }
            }
        },
        XOR => {
            if Opcode == XOR && self.Subtarget.hasBMI2() && self.matchBitExtract(Node) {
                return;
            }
        },
        OR => {
            if self.tryShrinkShlLogicImm(Node) {
                return;
            }
        },
        ADD => {
            if Opcode == ADD && self.matchBitExtract(Node) {
                return;
            }
        },
        SUB => {
            if !self.CurDAG.shouldOptForSize() {
                break;
            }
            if NVT != i8 && NVT != i16 && NVT != i32 && NVT != i64 {
                break;
            }
            let mut N0: SDValue = Node.getOperand(0);
            let mut N1: SDValue = Node.getOperand(1);
            let mut Cst: *mut ConstantSDNode = dyn_cast(N1);
            if !Cst {
                break;
            }
            let mut Val: i64 = Cst.getSExtValue();
            if !isInt(Val) && !isInt(Val) {
                break;
            }
            if Opcode == ADD && (Val == 1 || Val == -1) {
                break;
            }
            if !self.shouldAvoidImmediateInstFormsForSize(N1.getNode()) {
                break;
            }
            let mut ROpc: u32 = 0;
            let mut MOpc: u32 = 0;
            match NVT.SimpleTy {
                _ => {
                    llvm_unreachable_internal("Unexpected VT!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5878);
                },
                i8 => {
                    match Opcode {
                        _ => {
                            llvm_unreachable_internal("Unexpected opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5881);
                        },
                        ADD => {
                            ROpc = (if self.Subtarget.hasNDD() { ADD8rr_ND } else { ADD8rr });
                        },
                        SUB => {
                            ROpc = (if self.Subtarget.hasNDD() { SUB8rr_ND } else { SUB8rr });
                        },
                        AND => {
                            ROpc = (if self.Subtarget.hasNDD() { AND8rr_ND } else { AND8rr });
                        },
                        OR => {
                            ROpc = (if self.Subtarget.hasNDD() { OR8rr_ND } else { OR8rr });
                        },
                        XOR => {
                            ROpc = (if self.Subtarget.hasNDD() { XOR8rr_ND } else { XOR8rr });
                        },
                    }
                },
                i16 => {
                    match Opcode {
                        _ => {
                            llvm_unreachable_internal("Unexpected opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5906);
                        },
                        ADD => {
                            ROpc = (if self.Subtarget.hasNDD() { ADD16rr_ND } else { ADD16rr });
                        },
                        SUB => {
                            ROpc = (if self.Subtarget.hasNDD() { SUB16rr_ND } else { SUB16rr });
                        },
                        AND => {
                            ROpc = (if self.Subtarget.hasNDD() { AND16rr_ND } else { AND16rr });
                        },
                        OR => {
                            ROpc = (if self.Subtarget.hasNDD() { OR16rr_ND } else { OR16rr });
                        },
                        XOR => {
                            ROpc = (if self.Subtarget.hasNDD() { XOR16rr_ND } else { XOR16rr });
                        },
                    }
                },
                i32 => {
                    match Opcode {
                        _ => {
                            llvm_unreachable_internal("Unexpected opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5931);
                        },
                        ADD => {
                            ROpc = (if self.Subtarget.hasNDD() { ADD32rr_ND } else { ADD32rr });
                        },
                        SUB => {
                            ROpc = (if self.Subtarget.hasNDD() { SUB32rr_ND } else { SUB32rr });
                        },
                        AND => {
                            ROpc = (if self.Subtarget.hasNDD() { AND32rr_ND } else { AND32rr });
                        },
                        OR => {
                            ROpc = (if self.Subtarget.hasNDD() { OR32rr_ND } else { OR32rr });
                        },
                        XOR => {
                            ROpc = (if self.Subtarget.hasNDD() { XOR32rr_ND } else { XOR32rr });
                        },
                    }
                },
                i64 => {
                    match Opcode {
                        _ => {
                            llvm_unreachable_internal("Unexpected opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 5956);
                        },
                        ADD => {
                            ROpc = (if self.Subtarget.hasNDD() { ADD64rr_ND } else { ADD64rr });
                        },
                        SUB => {
                            ROpc = (if self.Subtarget.hasNDD() { SUB64rr_ND } else { SUB64rr });
                        },
                        AND => {
                            ROpc = (if self.Subtarget.hasNDD() { AND64rr_ND } else { AND64rr });
                        },
                        OR => {
                            ROpc = (if self.Subtarget.hasNDD() { OR64rr_ND } else { OR64rr });
                        },
                        XOR => {
                            ROpc = (if self.Subtarget.hasNDD() { XOR64rr_ND } else { XOR64rr });
                        },
                    }
                },
            }
            if Opcode != SUB {
                let mut Tmp0: SDValue = SDValue {};
                let mut Tmp1: SDValue = SDValue {};
                let mut Tmp2: SDValue = SDValue {};
                let mut Tmp3: SDValue = SDValue {};
                let mut Tmp4: SDValue = SDValue {};
                if self.tryFoldLoad(Node, N0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
                    let mut Ops: [7]SDValue = [N1, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, N0.getOperand(0)];
                    let mut VTs: SDVTList = self.CurDAG.getVTList(NVT, i32, Other);
                    let mut CNode: *mut MachineSDNode = self.CurDAG.getMachineNode(MOpc, dl, VTs, Ops);
                    self.ReplaceUses(N0.getValue(1), SDValue { Node: CNode, ResNo: 2 });
                    self.CurDAG.setNodeMemRefs(CNode, [cast(N0).getMemOperand()]);
                    self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: CNode, ResNo: 0 });
                    self.CurDAG.RemoveDeadNode(Node);
                    return;
                }
            }
            self.CurDAG.SelectNodeTo(Node, ROpc, NVT, i32, N0, N1);
            return;
        },
        SMUL => {
            if NVT != i8 {
                break;
            }
        },
        UMUL => {
            let mut N0: SDValue = Node.getOperand(0);
            let mut N1: SDValue = Node.getOperand(1);
            let mut LoReg: u32 = 0;
            let mut ROpc: u32 = 0;
            let mut MOpc: u32 = 0;
            match NVT.SimpleTy {
                _ => {
                    llvm_unreachable_internal("Unsupported VT!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86ISelDAGToDAG.cpp", 6015);
                },
                i8 => {
                    LoReg = AL;
                },
                i16 => {
                    LoReg = AX;
                },
                i32 => {
                    LoReg = EAX;
                },
                i64 => {
                    LoReg = RAX;
                },
            }
            let mut Tmp0: SDValue = SDValue {};
            let mut Tmp1: SDValue = SDValue {};
            let mut Tmp2: SDValue = SDValue {};
            let mut Tmp3: SDValue = SDValue {};
            let mut Tmp4: SDValue = SDValue {};
            let mut FoldedLoad: bool = self.tryFoldLoad(Node, N1, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4);
            if !FoldedLoad {
                FoldedLoad = self.tryFoldLoad(Node, N0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4);
                if FoldedLoad {
                    swap(N0, N1);
                }
            }
            if !FoldedLoad {
                orderRegForMul(N0, N1, LoReg, self.CurDAG.getMachineFunction().getRegInfo());
            }
            let mut InGlue: SDValue = self.CurDAG.getCopyToReg(self.CurDAG.getEntryNode(), dl, LoReg, N0, SDValue {}).getValue(1);
            let mut CNode: *mut MachineSDNode = null;
            if FoldedLoad {
                let mut VTs: SDVTList = SDVTList {};
                if NVT == i8 {
                    VTs = self.CurDAG.getVTList(NVT, i32, Other);
                } else {
                    VTs = self.CurDAG.getVTList(NVT, NVT, i32, Other);
                }
                let mut Ops: [7]SDValue = [Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, N1.getOperand(0), InGlue];
                CNode = self.CurDAG.getMachineNode(MOpc, dl, VTs, Ops);
                self.ReplaceUses(N1.getValue(1), SDValue { Node: CNode, ResNo: if NVT == i8 { 2 } else { 3 } });
                self.CurDAG.setNodeMemRefs(CNode, [cast(N1).getMemOperand()]);
            } else {
                let mut VTs: SDVTList = SDVTList {};
                if NVT == i8 {
                    VTs = self.CurDAG.getVTList(NVT, i32);
                } else {
                    VTs = self.CurDAG.getVTList(NVT, NVT, i32);
                }
                CNode = self.CurDAG.getMachineNode(ROpc, dl, VTs, [N1, InGlue]);
            }
            self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: CNode, ResNo: 0 });
            self.ReplaceUses(SDValue { Node: Node, ResNo: 1 }, SDValue { Node: CNode, ResNo: if NVT == i8 { 1 } else { 2 } });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        SMUL_LOHI => {
            UMUL_LOHI;
        },
        SDIVREM => {
            UDIVREM;
        },
        FCMP => {
            STRICT_FCMP;
        },
        CMP => {
            let mut N0: SDValue = Node.getOperand(0);
            let mut N1: SDValue = Node.getOperand(1);
            if !isNullConstant(N1) {
                break;
            }
            let mut CmpVT: MVT = N0.getSimpleValueType();
            if N0.getOpcode() == AND && N0.hasOneUse() {
                if self.matchBEXTRFromAndImm(N0.getNode()) {
                    NewNode;
                } else {
                    let mut TestOpc: u32 = if CmpVT == i64 { TEST64rr } else { TEST32rr };
                    let mut BEXTR: SDValue = SDValue { Node: NewNode, ResNo: 0 };
                    NewNode = self.CurDAG.getMachineNode(TestOpc, dl, i32, BEXTR, BEXTR);
                    self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: NewNode, ResNo: 0 });
                    self.CurDAG.RemoveDeadNode(Node);
                    return;
                }
            }
            if N0.getOpcode() == TRUNCATE && N0.hasOneUse() {
                N0 = N0.getOperand(0);
            }
            if N0.getOpcode() == AND && N0.getNode().hasOneUse() && N0.getValueType() != i8 {
                let mut MaskC: *mut ConstantSDNode = dyn_cast(N0.getOperand(1));
                if !MaskC {
                    break;
                }
                let mut Mask: u64 = MaskC.getZExtValue();
                Mask &= maskTrailingOnes(CmpVT.getScalarSizeInBits());
                if CmpVT == i64 && !isInt(Mask) && isShiftedMask_64(Mask) && self.onlyUsesZeroFlag(SDValue { Node: Node, ResNo: 0 }) {
                    let mut ShiftOpcode: u32 = DELETED_NODE;
                    let mut ShiftAmt: u32 = 0;
                    let mut SubRegIdx: u32 = 0;
                    let mut SubRegVT: MVT = MVT {};
                    let mut TestOpcode: u32 = 0;
                    let mut LeadingZeros: u32 = countl_zero(Mask);
                    let mut TrailingZeros: u32 = countr_zero(Mask);
                    let mut SavesBytes: bool = !isInt(Mask) || N0.getOperand(0).hasOneUse();
                    if LeadingZeros == 0 && SavesBytes {
                        ShiftOpcode = (if self.Subtarget.hasNDD() { SHR64ri_ND } else { SHR64ri });
                        ShiftAmt = TrailingZeros;
                        SubRegIdx = 0;
                        TestOpcode = TEST64rr;
                    } else if TrailingZeros == 0 && SavesBytes {
                        if LeadingZeros == 1 {
                            let mut Add: *mut MachineSDNode = self.CurDAG.getMachineNode((if self.Subtarget.hasNDD() { ADD64rr_ND } else { ADD64rr }), dl, i64, i32, N0.getOperand(0), N0.getOperand(0));
                            let mut Test: *mut MachineSDNode = self.CurDAG.getMachineNode(TEST64rr, dl, i32, SDValue { Node: Add, ResNo: 0 }, SDValue { Node: Add, ResNo: 0 });
                            self.ReplaceNode(Node, Test);
                            return;
                        }
                        ShiftOpcode = (if self.Subtarget.hasNDD() { SHL64ri_ND } else { SHL64ri });
                        ShiftAmt = LeadingZeros;
                        SubRegIdx = 0;
                        TestOpcode = TEST64rr;
                    } else if MaskC.hasOneUse() && !isInt(Mask) {
                        let mut PopCount: u32 = 64 - LeadingZeros - TrailingZeros;
                        if PopCount == 8 {
                            ShiftOpcode = (if self.Subtarget.hasNDD() { SHR64ri_ND } else { SHR64ri });
                            ShiftAmt = TrailingZeros;
                            SubRegIdx = sub_8bit;
                            SubRegVT = i8;
                            TestOpcode = TEST8rr;
                        } else if PopCount == 16 {
                            ShiftOpcode = (if self.Subtarget.hasNDD() { SHR64ri_ND } else { SHR64ri });
                            ShiftAmt = TrailingZeros;
                            SubRegIdx = sub_16bit;
                            SubRegVT = i16;
                            TestOpcode = TEST16rr;
                        } else if PopCount == 32 {
                            ShiftOpcode = (if self.Subtarget.hasNDD() { SHR64ri_ND } else { SHR64ri });
                            ShiftAmt = TrailingZeros;
                            SubRegIdx = sub_32bit;
                            SubRegVT = i32;
                            TestOpcode = TEST32rr;
                        }
                    }
                    if ShiftOpcode != DELETED_NODE {
                        let mut ShiftC: SDValue = self.CurDAG.getTargetConstant(ShiftAmt, dl, i64, false);
                        let mut Shift: SDValue = SDValue { Node: self.CurDAG.getMachineNode(ShiftOpcode, dl, i64, i32, N0.getOperand(0), ShiftC), ResNo: 0 };
                        if SubRegIdx != 0 {
                            Shift = self.CurDAG.getTargetExtractSubreg(SubRegIdx, dl, SubRegVT, Shift);
                        }
                        let mut Test: *mut MachineSDNode = self.CurDAG.getMachineNode(TestOpcode, dl, i32, Shift, Shift);
                        self.ReplaceNode(Node, Test);
                        return;
                    }
                }
                let mut VT: MVT = MVT {};
                let mut SubRegOp: i32 = 0;
                let mut ROpc: u32 = 0;
                let mut MOpc: u32 = 0;
                if isUInt(Mask) && (!(Mask & 128) || CmpVT == i8 || self.hasNoSignFlagUses(SDValue { Node: Node, ResNo: 0 })) {
                    VT = i8;
                    SubRegOp = sub_8bit;
                    ROpc = TEST8ri;
                    MOpc = TEST8mi;
                } else if self.OptForMinSize && isUInt(Mask) && (!(Mask & 32768) || CmpVT == i16 || self.hasNoSignFlagUses(SDValue { Node: Node, ResNo: 0 })) {
                    VT = i16;
                    SubRegOp = sub_16bit;
                    ROpc = TEST16ri;
                    MOpc = TEST16mi;
                } else if isUInt(Mask) && N0.getValueType() != i16 && ((!(Mask & 2147483648) && (CmpVT != i16 || !(Mask & 32768))) || CmpVT == i32 || self.hasNoSignFlagUses(SDValue { Node: Node, ResNo: 0 })) {
                    VT = i32;
                    SubRegOp = sub_32bit;
                    ROpc = TEST32ri;
                    MOpc = TEST32mi;
                } else {
                    break;
                }
                let mut Imm: SDValue = self.CurDAG.getTargetConstant(Mask, dl, VT, false);
                let mut Reg: SDValue = N0.getOperand(0);
                let mut NewNode: *mut MachineSDNode = null;
                let mut Tmp0: SDValue = SDValue {};
                let mut Tmp1: SDValue = SDValue {};
                let mut Tmp2: SDValue = SDValue {};
                let mut Tmp3: SDValue = SDValue {};
                let mut Tmp4: SDValue = SDValue {};
                if self.tryFoldLoad(Node, N0.getNode(), Reg, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
                    if dyn_cast(N0.getOperand(0).getNode()) {
                        LoadN;
                    } else {
                        if !LoadN.isSimple() {
                            let mut NumVolBits: u32 = LoadN.getValueType(0).getSizeInBits().operator unsigned long long();
                            if (MOpc == TEST8mi && NumVolBits != 8) || (MOpc == TEST16mi && NumVolBits != 16) || (MOpc == TEST32mi && NumVolBits != 32) {
                                break;
                            }
                        }
                    }
                    let mut Ops: [7]SDValue = [Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Imm, Reg.getOperand(0)];
                    NewNode = self.CurDAG.getMachineNode(MOpc, dl, i32, Other, Ops);
                    self.ReplaceUses(Reg.getValue(1), SDValue { Node: NewNode, ResNo: 1 });
                    self.CurDAG.setNodeMemRefs(NewNode, [cast(Reg).getMemOperand()]);
                } else {
                    if N0.getValueType() != VT {
                        Reg = self.CurDAG.getTargetExtractSubreg(SubRegOp, dl, VT, Reg);
                    }
                    NewNode = self.CurDAG.getMachineNode(ROpc, dl, i32, Reg, Imm);
                }
                self.ReplaceNode(Node, NewNode);
                return;
            }
            break;
        },
        PCMPISTR => {
            if !self.Subtarget.hasSSE42() {
                break;
            }
            let mut NeedIndex: bool = !SDValue { Node: Node, ResNo: 0 }.use_empty();
            let mut NeedMask: bool = !SDValue { Node: Node, ResNo: 1 }.use_empty();
            let mut MayFoldLoad: bool = !NeedIndex || !NeedMask;
            let mut CNode: *mut MachineSDNode = null;
            if NeedMask {
                let mut ROpc: u32 = if self.Subtarget.hasAVX() { VPCMPISTRMrri } else { PCMPISTRMrri };
                let mut MOpc: u32 = if self.Subtarget.hasAVX() { VPCMPISTRMrmi } else { PCMPISTRMrmi };
                CNode = self.emitPCMPISTR(ROpc, MOpc, MayFoldLoad, dl, v16i8, Node);
                self.ReplaceUses(SDValue { Node: Node, ResNo: 1 }, SDValue { Node: CNode, ResNo: 0 });
            }
            if NeedIndex || !NeedMask {
                let mut ROpc: u32 = if self.Subtarget.hasAVX() { VPCMPISTRIrri } else { PCMPISTRIrri };
                let mut MOpc: u32 = if self.Subtarget.hasAVX() { VPCMPISTRIrmi } else { PCMPISTRIrmi };
                CNode = self.emitPCMPISTR(ROpc, MOpc, MayFoldLoad, dl, i32, Node);
                self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: CNode, ResNo: 0 });
            }
            self.ReplaceUses(SDValue { Node: Node, ResNo: 2 }, SDValue { Node: CNode, ResNo: 1 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        PCMPESTR => {
            if !self.Subtarget.hasSSE42() {
                break;
            }
            let mut InGlue: SDValue = self.CurDAG.getCopyToReg(self.CurDAG.getEntryNode(), dl, EAX, Node.getOperand(1), SDValue {}).getValue(1);
            InGlue = self.CurDAG.getCopyToReg(self.CurDAG.getEntryNode(), dl, EDX, Node.getOperand(3), InGlue).getValue(1);
            let mut NeedIndex: bool = !SDValue { Node: Node, ResNo: 0 }.use_empty();
            let mut NeedMask: bool = !SDValue { Node: Node, ResNo: 1 }.use_empty();
            let mut MayFoldLoad: bool = !NeedIndex || !NeedMask;
            let mut CNode: *mut MachineSDNode = null;
            if NeedMask {
                let mut ROpc: u32 = if self.Subtarget.hasAVX() { VPCMPESTRMrri } else { PCMPESTRMrri };
                let mut MOpc: u32 = if self.Subtarget.hasAVX() { VPCMPESTRMrmi } else { PCMPESTRMrmi };
                CNode = self.emitPCMPESTR(ROpc, MOpc, MayFoldLoad, dl, v16i8, Node, InGlue);
                self.ReplaceUses(SDValue { Node: Node, ResNo: 1 }, SDValue { Node: CNode, ResNo: 0 });
            }
            if NeedIndex || !NeedMask {
                let mut ROpc: u32 = if self.Subtarget.hasAVX() { VPCMPESTRIrri } else { PCMPESTRIrri };
