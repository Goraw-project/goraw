            } else if NVT.is256BitVector() {
                
            } else if NVT.is512BitVector() {
                
            } else {
                llvm_unreachable_internal("Unexpected vector size!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 4998);
            }
        }
        let mut Ops: [9]SDValue = [A, B, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, TImm, C.getOperand(0)];
        MNode = self.CurDAG;
        self.ReplaceUses(C.getValue(1), SDValue { Node: MNode, ResNo: 1 });
        self.CurDAG.setNodeMemRefs(MNode, void { cast(C)() });
