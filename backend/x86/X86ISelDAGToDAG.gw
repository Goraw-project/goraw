                Opc = if IsFP { VSCATTERQPSZ128mr } else { VPSCATTERQDZ128mr };
            } else if IndexVT == v4i64 && NumElts == 4 && EltSize == 32 {
                Opc = if IsFP { VSCATTERQPSZ256mr } else { VPSCATTERQDZ256mr };
            } else if IndexVT == v8i64 && NumElts == 8 && EltSize == 32 {
                Opc = if IsFP { VSCATTERQPSZmr } else { VPSCATTERQDZmr };
