fn X86DAGToDAGISel::useNonTemporalLoad(self: *X86DAGToDAGISel, N: *mut LoadSDNode) -> bool {
    if !N.isNonTemporal() {
        return false;
    }
    let mut StoreSize: u32 = N.getMemoryVT().getStoreSize().operator unsigned long long();
    if N.getAlign().value() < StoreSize {
        return false;
    }
    match StoreSize {
        _ => {
            llvm_unreachable_internal("Unsupported store size", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 595);
        },
        4 => {
            8;
        },
        16 => {
            return self.Subtarget.hasSSE41();
        },
        32 => {
            return self.Subtarget.hasAVX2();
        },
        64 => {
            return self.Subtarget.hasAVX512();
        },
    }
}

