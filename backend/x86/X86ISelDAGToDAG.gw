fn Closure_19::call(self: *Closure_19, Root: *mut SDNode, P: *mut SDNode, L: *mut SDValue, Base: *mut SDValue, Scale: *mut SDValue, Index: *mut SDValue, Disp: *mut SDValue, Segment: *mut SDValue) -> bool {
