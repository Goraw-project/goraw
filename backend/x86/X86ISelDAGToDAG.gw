fn orderRegForMul(N0: *mut SDValue, N1: *mut SDValue, LoReg: u32, MRI: *MachineRegisterInfo) {
    let mut GetPhysReg: Closure_23 = Closure_23 { MRI: &mut MRI };
    if GetPhysReg.call(N1) == LoReg && GetPhysReg.call(N0) != LoReg {
        swap(N0, N1);
    }
}

fn X86DAGToDAGISel::tryVPTESTM(self, Root: *mut SDNode, Setcc: SDValue, InMask: SDValue) -> bool {
    assert!(self.Subtarget.hasAVX512(), "Expected AVX512!");
    assert!(Setcc.getSimpleValueType().getVectorElementType() == i1, "Unexpected VT!");
    let mut CC: CondCode = cast(Setcc.getOperand(2))();
    if CC != SETEQ && CC != SETNE {
        return false;
    }
    let mut SetccOp0: SDValue = Setcc.getOperand(0);
    let mut SetccOp1: SDValue = Setcc.getOperand(1);
    if isBuildVectorAllZeros(SetccOp0.getNode()) {
        swap(SetccOp0, SetccOp1);
    }
    if !isBuildVectorAllZeros(SetccOp1.getNode()) {
        return false;
    }
    let mut N0: SDValue = SetccOp0;
    let mut CmpVT: MVT = N0.getSimpleValueType();
    let mut CmpSVT: MVT = CmpVT.getVectorElementType();
    let mut Src0: SDValue = N0;
    let mut Src1: SDValue = N0;
    {
        let mut N0Temp: SDValue = N0;
        if N0Temp.getOpcode() == BITCAST && N0Temp.hasOneUse() {
            N0Temp = N0.getOperand(0);
        }
        if N0Temp.getOpcode() == AND && N0Temp.hasOneUse() {
            Src0 = N0Temp.getOperand(0);
            Src1 = N0Temp.getOperand(1);
        }
    }
    let mut Widen: bool = operator!(self.Subtarget()) && !CmpVT.is512BitVector();
    let mut tryFoldLoadOrBCast: Closure_24 = Closure_24 { Widen: &mut Widen, cap_1: self, CmpSVT: &mut CmpSVT };
    let mut CanFoldLoads: bool = Src0 != Src1;
    let mut FoldedLoad: bool = false;
    let mut Tmp0: SDValue = SDValue {};
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    if CanFoldLoads {
        FoldedLoad = tryFoldLoadOrBCast.call(Root, N0.getNode(), Src1, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4);
        if !FoldedLoad {
            FoldedLoad = tryFoldLoadOrBCast.call(Root, N0.getNode(), Src0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4);
            if FoldedLoad {
                swap(Src0, Src1);
            }
        }
    }
    let mut FoldedBCast: bool = false;
    let mut IsMasked: bool = InMask.getNode() != null;
    let mut dl: SDLoc = SDLoc { Root };
    let mut ResVT: MVT = Setcc.getSimpleValueType();
    let mut MaskVT: MVT = ResVT;
    if Widen {
        let mut Scale: u32 = if CmpVT.is128BitVector() { 4 } else { 2 };
        let mut SubReg: u32 = 0;
        let mut NumElts: u32 = CmpVT.getVectorNumElements() * Scale;
        CmpVT = getVectorVT(CmpSVT, NumElts);
        MaskVT = getVectorVT(MVT { SimpleTy: i1 }, NumElts);
        let mut ImplDef: SDValue = self.CurDAG;
        Src0 = self.CurDAG.getTargetInsertSubreg(SubReg, dl, EVT { CmpVT }, ImplDef, Src0);
        if !FoldedBCast {
            Src1 = self.CurDAG.getTargetInsertSubreg(SubReg, dl, EVT { CmpVT }, ImplDef, Src1);
        }
        if IsMasked {
            let mut RegClass: u32 = self.TLI.getRegClassFor();
            let mut RC: SDValue = self.CurDAG.getTargetConstant(RegClass, dl, EVT { i32 }, false);
            InMask = SDValue { Node: self.CurDAG.getMachineNode(COPY_TO_REGCLASS, dl, EVT { MaskVT }, InMask, RC), ResNo: 0 };
        }
    }
    let mut IsTestN: bool = CC == SETEQ;
    let mut Opc: u32 = getVPTESTMOpc(CmpVT, IsTestN, FoldedLoad, FoldedBCast, IsMasked);
    let mut CNode: *mut MachineSDNode = null;
    if FoldedLoad {
        let mut VTs: SDVTList = self.CurDAG.getVTList(EVT { MaskVT }, EVT { Other });
        if IsMasked {
            let mut Ops: [8]SDValue = [InMask, Src0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Src1.getOperand(0)];
            CNode = self.CurDAG;
        } else {
            let mut Ops: [7]SDValue = [Src0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, Src1.getOperand(0)];
            CNode = self.CurDAG;
        }
        self.ReplaceUses(Src1.getValue(1), SDValue { Node: CNode, ResNo: 1 });
        self.CurDAG.setNodeMemRefs(CNode, void { cast(Src1)() });
    } else {
        if IsMasked {
            CNode = self.CurDAG.getMachineNode(Opc, dl, EVT { MaskVT }, InMask, Src0, Src1);
        } else {
            CNode = self.CurDAG.getMachineNode(Opc, dl, EVT { MaskVT }, Src0, Src1);
        }
    }
    if Widen {
        let mut RegClass: u32 = self.TLI.getRegClassFor();
        let mut RC: SDValue = self.CurDAG.getTargetConstant(RegClass, dl, EVT { i32 }, false);
        CNode = self.CurDAG.getMachineNode(COPY_TO_REGCLASS, dl, EVT { ResVT }, SDValue { Node: CNode, ResNo: 0 }, RC);
    }
    self.ReplaceUses(SDValue { Node: Root, ResNo: 0 }, SDValue { Node: CNode, ResNo: 0 });
    self.CurDAG.RemoveDeadNode(Root);
    return true;
}

fn X86DAGToDAGISel::tryMatchBitSelect(self, N: *mut SDNode) -> bool {
    assert!(N.getOpcode() == OR, "Unexpected opcode!");
    let mut NVT: MVT = N.getSimpleValueType(0);
    if !NVT.isVector() || !self.Subtarget.hasAVX512() {
        return false;
    }
    if operator!((self.Subtarget() || NVT.is512BitVector())) {
        return false;
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if N1.getOpcode() == AND {
        swap(N0, N1);
    }
    if  {
        return false;
    }
    let mut A: SDValue = N1.getOperand(0);
    let mut C: SDValue = N1.getOperand(1);
    let mut B: SDValue = SDValue {};
    if N0.getOperand(0) == A {
        B = N0.getOperand(1);
    } else if N0.getOperand(1) == A {
        B = N0.getOperand(0);
    } else {
        return false;
    }
    let mut dl: SDLoc = SDLoc { N };
    let mut Imm: SDValue = self.CurDAG.getTargetConstant(202, dl, EVT { i8 }, false);
    let mut Ternlog: SDValue = self.CurDAG;
    self.ReplaceNode(N, Ternlog.getNode());
    return self.matchVPTERNLOG(Ternlog.getNode(), Ternlog.getNode(), Ternlog.getNode(), Ternlog.getNode(), A, B, C, 202);
}

fn X86DAGToDAGISel::Select(self, Node: *mut SDNode) {
    let mut NVT: MVT = Node.getSimpleValueType(0);
    let mut Opcode: u32 = Node.getOpcode();
    let mut dl: SDLoc = SDLoc { Node };
    if Node.isMachineOpcode() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("x86-isel", 1) {
                dbgs() << "== ";
                Node.dump(self.CurDAG);
                dbgs() << 10;
            }
        }
            if !(false) { break; }
        }
        Node.setNodeId(-1);
        return;
    }
    match Opcode {
        _ => {
            break;
        },
        INTRINSIC_W_CHAIN => {
            let mut IntNo: u32 = Node.getConstantOperandVal(1);
            match IntNo {
                _ => {
                    break;
                },
            }
            break;
        },
        INTRINSIC_VOID => {
            let mut IntNo: u32 = Node.getConstantOperandVal(1);
            match IntNo {
                _ => {
                    break;
                },
            }
            break;
        },
        BRIND => {
            if self.Subtarget.isTarget64BitILP32() {
                let mut Target: SDValue = Node.getOperand(1);
                assert!(Target.getValueType() == EVT { i32 }, "Unexpected VT!");
                let mut ZextTarget: SDValue = self.CurDAG.getZExtOrTrunc(Target, dl, EVT { i64 });
                let mut Brind: SDValue = self.CurDAG.getNode(Opcode, dl, EVT { Other }, Node.getOperand(0), ZextTarget);
                self.ReplaceNode(Node, Brind.getNode());
                SelectCode(ZextTarget.getNode());
                SelectCode(Brind.getNode());
                return;
            }
            break;
        },
        GlobalBaseReg => {
            self.ReplaceNode(Node, self.getGlobalBaseReg());
        },
        BITCAST => {
            if NVT.is512BitVector() || NVT.is256BitVector() || NVT.is128BitVector() || NVT == f128 {
                self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, Node.getOperand(0));
                self.CurDAG.RemoveDeadNode(Node);
                return;
            }
        },
        SRL => {
            if self.matchBitExtract(Node) {
                return;
            }
        },
        SRA => {
            SHL;
        },
        AND => {
            if NVT.isVectorOf(MVT { SimpleTy: i1 }) {
                let mut N0: SDValue = Node.getOperand(0);
                let mut N1: SDValue = Node.getOperand(1);
                if N0.getOpcode() == SETCC && N0.hasOneUse() && self.tryVPTESTM(Node, N0, N1) {
                    return;
                }
                if N1.getOpcode() == SETCC && N1.hasOneUse() && self.tryVPTESTM(Node, N1, N0) {
                    return;
                }
            }
        },
        XOR => {
            if Opcode == XOR && self.Subtarget() && self.matchBitExtract(Node) {
                return;
            }
        },
        OR => {
            if self.tryShrinkShlLogicImm(Node) {
                return;
            }
        },
        ADD => {
            if Opcode == ADD && self.matchBitExtract(Node) {
                return;
            }
        },
        SUB => {
            if !self.CurDAG.shouldOptForSize() {
                break;
            }
            if NVT != i8 && NVT != i16 && NVT != i32 && NVT != i64 {
                break;
            }
            let mut N0: SDValue = Node.getOperand(0);
            let mut N1: SDValue = Node.getOperand(1);
            let mut Cst: *mut auto = dyn_cast(N1);
            if operator!() {
                break;
            }
            let mut Val: i64 = ();
            if !isInt(Val) && !isInt(Val) {
                break;
            }
            if Opcode == ADD && (Val == 1 || Val == -1) {
                break;
            }
            if !self.shouldAvoidImmediateInstFormsForSize(N1.getNode()) {
                break;
            }
            let mut ROpc: u32 = 0;
            let mut MOpc: u32 = 0;
            match NVT.SimpleTy {
                _ => {
                    llvm_unreachable_internal("Unexpected VT!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 5878);
                },
                i8 => {
                    match Opcode {
                        _ => {
                            llvm_unreachable_internal("Unexpected opcode!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 5881);
                        },
                        ADD => {
                            
                        },
                        SUB => {
                            
                        },
                        AND => {
                            
                        },
                        OR => {
                            
                        },
                        XOR => {
                            
                        },
                    }
                },
                i16 => {
                    match Opcode {
                        _ => {
                            llvm_unreachable_internal("Unexpected opcode!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 5906);
                        },
                        ADD => {
                            
                        },
                        SUB => {
                            
                        },
                        AND => {
                            
                        },
                        OR => {
                            
                        },
                        XOR => {
                            
                        },
                    }
                },
                i32 => {
                    match Opcode {
                        _ => {
                            llvm_unreachable_internal("Unexpected opcode!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 5931);
                        },
                        ADD => {
                            
                        },
                        SUB => {
                            
                        },
                        AND => {
                            
                        },
                        OR => {
                            
                        },
                        XOR => {
                            
                        },
                    }
                },
                i64 => {
                    match Opcode {
                        _ => {
                            llvm_unreachable_internal("Unexpected opcode!", "llvm\\lib\\Target\\X86\\X86ISelDAGToDAG.cpp", 5956);
                        },
                        ADD => {
                            
                        },
                        SUB => {
                            
                        },
                        AND => {
                            
                        },
                        OR => {
                            
                        },
                        XOR => {
                            
                        },
                    }
                },
            }
            if Opcode != SUB {
                let mut Tmp0: SDValue = SDValue {};
                let mut Tmp1: SDValue = SDValue {};
                let mut Tmp2: SDValue = SDValue {};
                let mut Tmp3: SDValue = SDValue {};
                let mut Tmp4: SDValue = SDValue {};
                if self.tryFoldLoad(Node, N0, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4) {
                    let mut Ops: [7]SDValue = [N1, Tmp0, Tmp1, Tmp2, Tmp3, Tmp4, N0.getOperand(0)];
                    let mut VTs: SDVTList = self.CurDAG.getVTList(EVT { NVT }, EVT { i32 }, EVT { Other });
                    let mut CNode: *mut MachineSDNode = self.CurDAG;
                    self.ReplaceUses(N0.getValue(1), SDValue { Node: CNode, ResNo: 2 });
                    self.CurDAG.setNodeMemRefs(CNode, void { cast(N0)() });
                    self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: CNode, ResNo: 0 });
                    self.CurDAG.RemoveDeadNode(Node);
                    return;
                }
            }
            self.CurDAG.SelectNodeTo(Node, ROpc, EVT { NVT }, EVT { i32 }, N0, N1);
            return;
        },
        SMUL_LOHI => {
            UMUL_LOHI;
        },
        SDIVREM => {
            UDIVREM;
        },
        PCMPISTR => {
            if !self.Subtarget.hasSSE42() {
                break;
            }
            let mut NeedIndex: bool = !SDValue { Node: Node, ResNo: 0 }.use_empty();
            let mut NeedMask: bool = !SDValue { Node: Node, ResNo: 1 }.use_empty();
            let mut MayFoldLoad: bool = !NeedIndex || !NeedMask;
            let mut CNode: *mut MachineSDNode = null;
            if NeedMask {
                let mut ROpc: u32 = 0;
                let mut MOpc: u32 = 0;
                CNode = self.emitPCMPISTR(ROpc, MOpc, MayFoldLoad, dl, MVT { SimpleTy: v16i8 }, Node);
                self.ReplaceUses(SDValue { Node: Node, ResNo: 1 }, SDValue { Node: CNode, ResNo: 0 });
            }
            if NeedIndex || !NeedMask {
                let mut ROpc: u32 = 0;
                let mut MOpc: u32 = 0;
                CNode = self.emitPCMPISTR(ROpc, MOpc, MayFoldLoad, dl, MVT { SimpleTy: i32 }, Node);
                self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: CNode, ResNo: 0 });
            }
            self.ReplaceUses(SDValue { Node: Node, ResNo: 2 }, SDValue { Node: CNode, ResNo: 1 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        PCMPESTR => {
            if !self.Subtarget.hasSSE42() {
                break;
            }
            let mut InGlue: SDValue = self.CurDAG(1);
            InGlue = self.CurDAG(1);
            let mut NeedIndex: bool = !SDValue { Node: Node, ResNo: 0 }.use_empty();
            let mut NeedMask: bool = !SDValue { Node: Node, ResNo: 1 }.use_empty();
            let mut MayFoldLoad: bool = !NeedIndex || !NeedMask;
            let mut CNode: *mut MachineSDNode = null;
            if NeedMask {
                let mut ROpc: u32 = 0;
                let mut MOpc: u32 = 0;
                CNode = self.emitPCMPESTR(ROpc, MOpc, MayFoldLoad, dl, MVT { SimpleTy: v16i8 }, Node, InGlue);
                self.ReplaceUses(SDValue { Node: Node, ResNo: 1 }, SDValue { Node: CNode, ResNo: 0 });
            }
            if NeedIndex || !NeedMask {
                let mut ROpc: u32 = 0;
                let mut MOpc: u32 = 0;
                CNode = self.emitPCMPESTR(ROpc, MOpc, MayFoldLoad, dl, MVT { SimpleTy: i32 }, Node, InGlue);
                self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: CNode, ResNo: 0 });
            }
            self.ReplaceUses(SDValue { Node: Node, ResNo: 2 }, SDValue { Node: CNode, ResNo: 1 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        SETCC => {
            if NVT.isVector() && self.tryVPTESTM(Node, SDValue { Node: Node, ResNo: 0 }, SDValue {}) {
                return;
            }
            break;
        },
        STORE => {
            if self.foldLoadStoreIntoMemOperand(Node) {
                return;
            }
        },
        MGATHER => {
            let mut Mgt: *mut auto = cast(Node);
            let mut IndexOp: SDValue = ();
            let mut Mask: SDValue = ();
            let mut IndexVT: MVT = IndexOp.getSimpleValueType();
            let mut ValueVT: MVT = Node.getSimpleValueType(0);
            let mut MaskVT: MVT = Mask.getSimpleValueType();
            if !ValueVT.isVector() || !MaskVT.isVector() {
                break;
            }
            let mut NumElts: u32 = ValueVT.getVectorNumElements();
            let mut ValueSVT: MVT = ValueVT.getVectorElementType();
            let mut IsFP: bool = ValueSVT.isFloatingPoint();
            let mut EltSize: u32 = ValueSVT.getSizeInBits().operator unsigned long long();
            let mut Opc: u32 = 0;
            let mut AVX512Gather: bool = MaskVT.getVectorElementType() == i1;
            if AVX512Gather {} else {
                assert!(EVT { MaskVT } == EVT { ValueVT }.changeVectorElementTypeToInteger(), "Unexpected mask VT!");
            }
            if !Opc {
                break;
            }
            let mut Base: SDValue = SDValue {};
            let mut Scale: SDValue = SDValue {};
            let mut Index: SDValue = SDValue {};
            let mut Disp: SDValue = SDValue {};
            let mut Segment: SDValue = SDValue {};
            if operator!(self.selectVectorAddr(IndexOp, Base, Scale, Index, Disp, Segment)) {
                break;
            }
            let mut PassThru: SDValue = ();
            let mut Chain: SDValue = ();
            let mut VTs: SDVTList = self.CurDAG.getVTList(EVT { ValueVT }, EVT { MaskVT }, EVT { Other });
            let mut NewNode: *mut MachineSDNode = null;
            if AVX512Gather {
                let mut Ops: [8]SDValue = [PassThru, Mask, Base, Scale, Index, Disp, Segment, Chain];
                NewNode = self.CurDAG;
            } else {
                let mut Ops: [8]SDValue = [PassThru, Base, Scale, Index, Disp, Segment, Mask, Chain];
                NewNode = self.CurDAG;
            }
            self.CurDAG.setNodeMemRefs(NewNode, void { () });
            self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: NewNode, ResNo: 0 });
            self.ReplaceUses(SDValue { Node: Node, ResNo: 1 }, SDValue { Node: NewNode, ResNo: 2 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        MSCATTER => {
            let mut Sc: *mut auto = cast(Node);
            let mut Value: SDValue = ();
            let mut IndexOp: SDValue = ();
            let mut IndexVT: MVT = IndexOp.getSimpleValueType();
            let mut ValueVT: MVT = Value.getSimpleValueType();
            if !ValueVT.isVector() {
                break;
            }
            let mut NumElts: u32 = ValueVT.getVectorNumElements();
            let mut ValueSVT: MVT = ValueVT.getVectorElementType();
            let mut IsFP: bool = ValueSVT.isFloatingPoint();
            let mut EltSize: u32 = ValueSVT.getSizeInBits().operator unsigned long long();
            let mut Opc: u32 = 0;
            if IndexVT == v4i32 && NumElts == 4 && EltSize == 32 {
                
            } else if IndexVT == v8i32 && NumElts == 8 && EltSize == 32 {
                
            } else if IndexVT == v16i32 && NumElts == 16 && EltSize == 32 {
                
            } else if IndexVT == v4i32 && NumElts == 2 && EltSize == 64 {
                
            } else if IndexVT == v4i32 && NumElts == 4 && EltSize == 64 {
                
            } else if IndexVT == v8i32 && NumElts == 8 && EltSize == 64 {
                
            } else if IndexVT == v2i64 && NumElts == 4 && EltSize == 32 {
                
            } else if IndexVT == v4i64 && NumElts == 4 && EltSize == 32 {
                
            } else if IndexVT == v8i64 && NumElts == 8 && EltSize == 32 {
                
            } else if IndexVT == v2i64 && NumElts == 2 && EltSize == 64 {
                
            } else if IndexVT == v4i64 && NumElts == 4 && EltSize == 64 {
                
            } else if IndexVT == v8i64 && NumElts == 8 && EltSize == 64 {
                
            } else {
                break;
            }
            let mut Base: SDValue = SDValue {};
            let mut Scale: SDValue = SDValue {};
            let mut Index: SDValue = SDValue {};
            let mut Disp: SDValue = SDValue {};
            let mut Segment: SDValue = SDValue {};
            if operator!(self.selectVectorAddr(IndexOp, Base, Scale, Index, Disp, Segment)) {
                break;
            }
            let mut Mask: SDValue = ();
            let mut Chain: SDValue = ();
            let mut VTs: SDVTList = self.CurDAG.getVTList(Mask.getValueType(), EVT { Other });
            let mut Ops: [8]SDValue = [Base, Scale, Index, Disp, Segment, Mask, Value, Chain];
            let mut NewNode: *mut MachineSDNode = self.CurDAG;
            self.CurDAG.setNodeMemRefs(NewNode, void { () });
            self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: NewNode, ResNo: 1 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        PREALLOCATED_SETUP => {
            let mut MFI: *mut auto = self.CurDAG.getMachineFunction();
            let mut CallId: auto = (cast(Node.getOperand(1))());
            let mut Chain: SDValue = Node.getOperand(0);
            let mut CallIdValue: SDValue = self.CurDAG(dl, i32);
            let mut New: *mut MachineSDNode = self.CurDAG.getMachineNode(PREALLOCATED_SETUP, dl, EVT { Other }, CallIdValue, Chain);
            self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: New, ResNo: 0 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        PREALLOCATED_ARG => {
            let mut MFI: *mut auto = self.CurDAG.getMachineFunction();
            let mut CallId: auto = (cast(Node.getOperand(1))());
            let mut Chain: SDValue = Node.getOperand(0);
            let mut CallIdValue: SDValue = self.CurDAG(dl, i32);
            let mut ArgIndex: SDValue = Node.getOperand(2);
            let mut Ops: [3]SDValue = [3]SDValue {};
            Ops[0] = CallIdValue;
            Ops[1] = ArgIndex;
            Ops[2] = Chain;
            let mut New: *mut MachineSDNode = self.CurDAG(PREALLOCATED_ARG, dl, self.CurDAG(self.TLI.getPointerTy, Other), Ops);
            self.ReplaceUses(SDValue { Node: Node, ResNo: 0 }, SDValue { Node: New, ResNo: 0 });
            self.ReplaceUses(SDValue { Node: Node, ResNo: 1 }, SDValue { Node: New, ResNo: 1 });
            self.CurDAG.RemoveDeadNode(Node);
            return;
        },
        AESENCWIDE128KL => {
            AESDECWIDE128KL;
        },
        POP_FROM_X87_REG => {
            let mut Chain: SDValue = Node.getOperand(0);
            let mut Reg: Register = cast(Node.getOperand(1))();
            let mut Glue: SDValue = SDValue {};
            if Node.getNumValues() == 3 {
                Glue = Node.getOperand(2);
            }
            let mut Copy: SDValue = self.CurDAG.getCopyFromReg(Chain, dl, Reg, Node.getValueType(0), Glue);
            self.ReplaceNode(Node, Copy.getNode());
            return;
        },
    }
    SelectCode(Node);
}

fn X86DAGToDAGISel::SelectInlineAsmMemoryOperand(self, Op: *SDValue, ConstraintID: ConstraintCode, OutOps: *mut i32) -> bool {
    let mut Op0: SDValue = SDValue {};
    let mut Op1: SDValue = SDValue {};
    let mut Op2: SDValue = SDValue {};
