static mut NumFences: Statistic = Statistic { "x86-lvi-ret", "NumFences", "Number of LFENCEs inserted for LVI mitigation" };

static mut NumFunctionsConsidered: Statistic = Statistic { "x86-lvi-ret", "NumFunctionsConsidered", "Number of functions analyzed" };

static mut NumFunctionsMitigated: Statistic = Statistic { "x86-lvi-ret", "NumFunctionsMitigated", "Number of functions for which mitigations were deployed" };

const X86LVIRetPassName: str = "X86 Load Value Injection (LVI) Ret-Hardening";

struct X86LoadValueInjectionRetHardeningLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn X86LoadValueInjectionRetHardeningLegacy::getPassName(self: *X86LoadValueInjectionRetHardeningLegacy) -> str {
    return X86LVIRetPassName;
}

fn X86LoadValueInjectionRetHardeningLegacy::getPassKind(self: *X86LoadValueInjectionRetHardeningLegacy) -> PassKind {
    return self.Kind;
}

fn X86LoadValueInjectionRetHardeningLegacy::getPassID(self: *X86LoadValueInjectionRetHardeningLegacy) -> AnalysisID {
    return self.PassID;
}

fn X86LoadValueInjectionRetHardeningLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LoadValueInjectionRetHardeningLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86LoadValueInjectionRetHardeningLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86LoadValueInjectionRetHardeningLegacy::getResolver(self: *X86LoadValueInjectionRetHardeningLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86LoadValueInjectionRetHardeningLegacy::getRequiredProperties(self: *X86LoadValueInjectionRetHardeningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86LoadValueInjectionRetHardeningLegacy::getSetProperties(self: *X86LoadValueInjectionRetHardeningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn X86LoadValueInjectionRetHardeningLegacy::getClearedProperties(self: *X86LoadValueInjectionRetHardeningLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn runX86LoadValueInjectionRetHardening(MF: *mut MachineFunction) -> bool {
    let mut Subtarget: *X86Subtarget = &mut MF.getSubtarget();
    if !Subtarget.useLVIControlFlowIntegrity() || !Subtarget.is64Bit() {
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-lvi-ret", 1) {
            dbgs() << "***** " << X86LVIRetPassName << " : " << MF.getName() << " *****\n";
        }
    }
        if !(false) { break; }
    }
    operator(NumFunctionsConsidered);
    let mut TRI: *X86RegisterInfo = Subtarget.getRegisterInfo();
    let mut TII: *X86InstrInfo = Subtarget.getInstrInfo();
    let mut Modified: bool = false;
    for MBB in MF {
        for let mut MBBI: iterator = MBB.begin(); MBBI != MBB.end(); operator(MBBI) {
            if operator(MBBI).getOpcode() != RET64 {
                continue;
            }
            let mut ClobberReg: u32 = TRI.findDeadCallerSavedReg(MBB, MBBI);
            if ClobberReg != NoRegister {
                BuildMI(MBB, MBBI, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(POP64r)).addReg(ClobberReg, Define, 0).setMIFlag(FrameDestroy);
                BuildMI(MBB, MBBI, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LFENCE));
                BuildMI(MBB, MBBI, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(JMP64r)).addReg(ClobberReg, RegState {}, 0);
                MBB.erase(MBBI);
            } else {
                let mut Fence: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LFENCE)).operator llvm::MachineInstr *();
                operator(addRegOffset(BuildMI(MBB, Fence, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SHL64mi)), RSP, false, 0).addImm(0)).addRegisterDead(EFLAGS, TRI, false);
            }
            operator(NumFences);
            Modified = true;
            break;
        }
    }
    if Modified {
        operator(NumFunctionsMitigated);
    }
    return Modified;
}

fn X86LoadValueInjectionRetHardeningLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut F: *Function = MF.getFunction();
    if !F.hasOptNone() && self.skipFunction(F) {
        return false;
    }
    return runX86LoadValueInjectionRetHardening(MF);
}

fn X86LoadValueInjectionRetHardeningPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if runX86LoadValueInjectionRetHardening(MF) { getMachineFunctionPassPreservedAnalyses().preserveSet() } else { all() };
}

fn createX86LoadValueInjectionRetHardeningLegacyPass() -> *mut FunctionPass {
    return X86LoadValueInjectionRetHardeningLegacy {};
}
