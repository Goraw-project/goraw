fn getSplatValueAllowUndef(C: *ConstantVector) -> *mut Constant {
    let mut Res: *mut Constant = null;
    for Op in C.operands() {
        let mut OpC: *mut Constant = cast(Op);
        if isa(OpC) {
            continue;
        }
        if !Res {
            Res = OpC;
        } else if Res != OpC {
            return null;
        }
    }
    return Res;
}

fn extractConstantBits(C: *Constant) -> optional<APInt> {
    let mut NumBits: u32 = C.getType().getPrimitiveSizeInBits().operator unsigned long long();
    if isa(C) {
        return getZero(NumBits);
    }
    if  {
        if isa() {
            return getSplat(NumBits);
        }
        return ();
    }
    if  {
        if isa() {
            return getSplat(NumBits, ()());
        }
        return ()();
    }
    if  {
        if  {
            if extractConstantBits() {
                Bits;
            } else {
                assert!((NumBits % operator(Bits).getBitWidth()) == 0, "Illegal splat");
                return getSplat(NumBits, operator(Bits));
            }
        }
        let mut Bits: APInt = getZero(NumBits);
        for let mut I: u32 = 0;
let mut E: u32 = (); I != E; I += 1 {
            let mut Elt: *mut Constant = (I);
            let mut SubBits: optional<APInt> = extractConstantBits(Elt);
            if !SubBits {
                return optional<APInt> { nullopt };
            }
            assert!(NumBits == (E * operator(SubBits).getBitWidth()), "Illegal vector element size");
            Bits.insertBits(operator(SubBits), I * operator(SubBits).getBitWidth());
        }
        return Bits;
    }
    if  {
        let mut IsInteger: bool = ()();
        let mut IsFloat: bool = ()() || ()() || ()() || ()();
        if IsInteger || IsFloat {
            let mut Bits: APInt = getZero(NumBits);
            let mut EltBits: u32 = ()();
            for let mut I: u32 = 0;
let mut E: u32 = (); I != E; I += 1 {
                if IsInteger {
                    Bits((I), I * EltBits);
                } else {
                    Bits((I)(), I * EltBits);
                }
            }
            return Bits;
        }
    }
    return optional<APInt> { nullopt };
}

fn extractConstantBits(C: *Constant, NumBits: u32) -> optional<APInt> {
    if extractConstantBits(C) {
        Bits;
    } else {
        return operator(Bits).zextOrTrunc(NumBits);
    }
    return optional<APInt> { nullopt };
}

fn getSplatableConstant(C: *Constant, SplatBitWidth: u32) -> optional<APInt> {
    let mut Ty: *Type = C.getType();
    assert!((Ty.getPrimitiveSizeInBits().operator unsigned long long() % SplatBitWidth) == 0, "Illegal splat width");
    if extractConstantBits(C) {
        Bits;
    } else if operator(Bits).isSplat(SplatBitWidth) {
        return operator(Bits).trunc(SplatBitWidth);
    }
    if  {
        let mut NumOps: u32 = ();
        let mut NumEltsBits: u32 = Ty.getScalarSizeInBits();
        let mut NumScaleOps: u32 = SplatBitWidth / NumEltsBits;
        if (SplatBitWidth % NumEltsBits) == 0 {
            let mut Sequence: SmallVector<Constant *, 16> = zeroed();
            for let mut Idx: u32 = 0; Idx != NumOps; Idx += 1 {
                if (Idx) {
                    Elt;
                } else {
                    if isa(Elt) {
                        continue;
                    }
                    let mut SplatIdx: u32 = Idx % NumScaleOps;
                    if operator!([SplatIdx]) || [SplatIdx] == Elt {
                        Sequence()[SplatIdx] = Elt;
                        continue;
                    }
                }
                return optional<APInt> { nullopt };
            }
            let mut SplatBits: APInt = getZero(SplatBitWidth);
            for let mut I: u32 = 0; I != NumScaleOps; I += 1 {
                if operator!([I]) {
                    continue;
                }
                if extractConstantBits([I]) {
                    Bits;
                } else {
                    SplatBits.insertBits(operator(Bits), I * operator(Bits).getBitWidth());
                    continue;
                }
                return optional<APInt> { nullopt };
            }
            return SplatBits;
        }
    }
    return optional<APInt> { nullopt };
}

fn rebuildConstant(Ctx: *mut LLVMContext, SclTy: *mut Type, Bits: *APInt, NumSclBits: u32) -> *mut Constant {
    let mut BitWidth: u32 = Bits.getBitWidth();
    if NumSclBits == 8 {
        let mut RawBits: i32 = 0;
        for let mut I: u32 = 0; I != BitWidth; I += 8 {
            RawBits()(Bits.extractBits(8, I).getZExtValue());
        }
        return get(Ctx);
    }
    if NumSclBits == 16 {
        let mut RawBits: i32 = 0;
        for let mut I: u32 = 0; I != BitWidth; I += 16 {
            RawBits()(Bits.extractBits(16, I).getZExtValue());
        }
        if SclTy.is16bitFPTy() {
            return getFP(SclTy);
        }
        return get(Ctx);
    }
    if NumSclBits == 32 {
        let mut RawBits: i32 = 0;
        for let mut I: u32 = 0; I != BitWidth; I += 32 {
            RawBits()(Bits.extractBits(32, I).getZExtValue());
        }
        if SclTy.isFloatTy() {
            return getFP(SclTy);
        }
        return get(Ctx);
    }
    assert!(NumSclBits == 64, "Unhandled vector element width");
    let mut RawBits: i32 = 0;
    for let mut I: u32 = 0; I != BitWidth; I += 64 {
        RawBits()(Bits.extractBits(64, I).getZExtValue());
    }
    if SclTy.isDoubleTy() {
        return getFP(SclTy);
    }
    return get(Ctx);
}

fn rebuildSplatCst(C: *Constant, arg: u32, arg: u32, SplatBitWidth: u32) -> *mut Constant {
    let mut Splat: optional<APInt> = getSplatableConstant(C, SplatBitWidth);
    if !Splat {
        return null;
    }
    let mut SclTy: *mut Type = C.getType().getScalarType();
    let mut NumSclBits: u32 = SclTy.getPrimitiveSizeInBits().operator unsigned long long();
    NumSclBits = min(NumSclBits, SplatBitWidth);
    NumSclBits = if (NumSclBits == 8 || NumSclBits == 16 || NumSclBits == 32) { NumSclBits } else { 64 };
    return rebuildConstant(C.getContext(), SclTy, operator(Splat), NumSclBits);
}

fn rebuildZeroUpperCst(C: *Constant, NumBits: u32, arg: u32, ScalarBitWidth: u32) -> *mut Constant {
    let mut SclTy: *mut Type = C.getType().getScalarType();
    let mut NumSclBits: u32 = SclTy.getPrimitiveSizeInBits().operator unsigned long long();
    let mut Ctx: *mut LLVMContext = C.getContext();
    if NumBits > ScalarBitWidth {
        if extractConstantBits(C, NumBits) {
            Bits;
        } else {
            if operator(Bits).countLeadingZeros() >= (NumBits - ScalarBitWidth) {
                if ScalarBitWidth > NumSclBits && (ScalarBitWidth % NumSclBits) == 0 {
                    return rebuildConstant(Ctx, SclTy, operator(Bits), NumSclBits);
                }
                let mut RawBits: APInt = operator(Bits).zextOrTrunc(ScalarBitWidth);
                return get(Ctx, RawBits);
            }
        }
    }
    return null;
}

fn rebuildExtCst(C: *Constant, IsSExt: bool, NumBits: u32, NumElts: u32, SrcEltBitWidth: u32) -> *mut Constant {
    let mut DstEltBitWidth: u32 = NumBits / NumElts;
    assert!((NumBits % NumElts) == 0 && (NumBits % SrcEltBitWidth) == 0 && (DstEltBitWidth % SrcEltBitWidth) == 0 && (DstEltBitWidth > SrcEltBitWidth), "Illegal extension width");
    if extractConstantBits(C, NumBits) {
        Bits;
    } else {
        assert!((operator(Bits).getBitWidth() / DstEltBitWidth) == NumElts && (operator(Bits).getBitWidth() % DstEltBitWidth) == 0, "Unexpected constant extension");
        let mut TruncBits: APInt = getZero(NumElts * SrcEltBitWidth);
        for let mut I: u32 = 0; I != NumElts; I += 1 {
            let mut Elt: APInt = operator(Bits).extractBits(DstEltBitWidth, I * DstEltBitWidth);
            if (IsSExt && Elt.getSignificantBits() > SrcEltBitWidth) || (!IsSExt && Elt.getActiveBits() > SrcEltBitWidth) {
                return null;
            }
            TruncBits.insertBits(Elt.trunc(SrcEltBitWidth), I * SrcEltBitWidth);
        }
        let mut Ty: *mut Type = C.getType();
        return rebuildConstant(Ty.getContext(), Ty.getScalarType(), TruncBits, SrcEltBitWidth);
    }
    return null;
}

fn rebuildSExtCst(C: *Constant, NumBits: u32, NumElts: u32, SrcEltBitWidth: u32) -> *mut Constant {
    return rebuildExtCst(C, true, NumBits, NumElts, SrcEltBitWidth);
}

fn rebuildZExtCst(C: *Constant, NumBits: u32, NumElts: u32, SrcEltBitWidth: u32) -> *mut Constant {
    return rebuildExtCst(C, false, NumBits, NumElts, SrcEltBitWidth);
}

fn X86FixupVectorConstantsImpl::processInstruction(self, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, MI: *mut MachineInstr) -> bool {
    let mut Opc: u32 = MI.getOpcode();
    let mut CP: *mut MachineConstantPool = MI.getParent().getParent().getConstantPool();
    let mut HasSSE2: bool = self.ST.hasSSE2();
    let mut HasSSE41: bool = self.ST.hasSSE41();
    let mut HasAVX2: bool = self.ST.hasAVX2();
    let mut HasDQI: bool = self.ST();
    let mut HasBWI: bool = self.ST();
    let mut HasVLX: bool = self.ST();
    let mut MultiDomain: bool = self.ST.hasAVX512() || self.ST.hasNoDomainDelayMov();
    let mut OptSize: bool = MF.getFunction().hasOptSize();
    let mut NewOpcPreferable: Closure_1 = Closure_1 { cap_0: self, Opc: &mut Opc };
    let mut FixupConstant: Closure_2 = Closure_2 { MI: &mut MI, OptSize: &mut OptSize, NewOpcPreferable: &mut NewOpcPreferable, CP: &mut CP, cap_4: self };
    match Opc {

    }
    let mut ConvertToBroadcast: Closure_3 = Closure_3 { FixupConstant: &mut FixupConstant };
    if (MI.getDesc().TSFlags & EncodingMask) == EVEX {
        return ConvertToBroadcast(Opc, 32) || ConvertToBroadcast(Opc, 64);
    }
    if HasVLX && !HasDQI {
        let mut OpSrc32: u32 = 0;
        let mut OpSrc64: u32 = 0;
        match Opc {

        }
        if OpSrc32 || OpSrc64 {
            return ConvertToBroadcast(OpSrc32, 32) || ConvertToBroadcast(OpSrc64, 64);
        }
    }
    return false;
}

fn X86FixupVectorConstantsImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-vector-constants", 1) {
            dbgs() << "Start X86FixupVectorConstants\n";
        }
    }
        if !(false) { break; }
    }
    let mut Changed: bool = false;
    self.ST = operator&(MF);
    self.TII = self.ST.getInstrInfo();
    self.SM = operator&(self.ST());
    for MBB in MF {
        for MI in MBB {
            if self.processInstruction(MF, MBB, MI) {
                operator(NumInstChanges);
                Changed = true;
            }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-fixup-vector-constants", 1) {
            dbgs() << "End X86FixupVectorConstants\n";
        }
    }
        if !(false) { break; }
    }
    return Changed;
}

fn X86FixupVectorConstantsLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut Impl: X86FixupVectorConstantsImpl = X86FixupVectorConstantsImpl {};
    return Impl.runOnMachineFunction(MF);
}

fn X86FixupVectorConstantsPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: X86FixupVectorConstantsImpl = X86FixupVectorConstantsImpl {};
    return if Impl.runOnMachineFunction(MF) { getMachineFunctionPassPreservedAnalyses() } else { all() };
}

struct Closure_1 {
    cap_0: *mut X86FixupVectorConstantsImpl,
    Opc: *mut u32,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Fixup: *FixupEntry, RegBitWidth: u32) -> auto {
        if self.SM.hasInstrSchedModel() {
            let mut NewOpc: u32 = Fixup.Op;
            let mut OldDesc: *mut auto = self.SM.getSchedClassDesc(self.TII((*self.Opc))());
            let mut NewDesc: *mut auto = self.SM.getSchedClassDesc(self.TII(NewOpc)());
            let mut BitsSaved: u32 = RegBitWidth - (Fixup.NumCstElts * Fixup.MemBitWidth);
            let mut OldTput: f64 = (*self.ST, operator*());
            let mut NewTput: f64 = (*self.ST, operator*());
            if OldTput != NewTput {
                return NewTput < OldTput;
            }
            let mut LatTol: i32 = (BitsSaved + 127) / 128;
            let mut OldLat: i32 = (*self.ST, operator*());
            let mut NewLat: i32 = (*self.ST, operator*());
            if OldLat != NewLat {
                return NewLat < (OldLat + LatTol);
            }
        }
        return true;
    }

struct Closure_2 {
    MI: *mut MachineInstr,
    OptSize: *mut bool,
    NewOpcPreferable: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86FixupVectorConstants.cpp:367:27),
    CP: *mut *mut MachineConstantPool,
    cap_4: *mut X86FixupVectorConstantsImpl,
}

unsafe fn Closure_2::call(self: *mut Closure_2, Fixups: ArrayRef<FixupEntry>, RegBitWidth: u32, OperandNo: u32) -> bool {
        assert!((*self.MI).getNumOperands() >= (OperandNo + AddrNumOperands), "Unexpected number of operands!");
        if getConstantFromPool((*self.MI), OperandNo) {
            C;
        } else {
            let mut CstBitWidth: u32 = C.getType().getPrimitiveSizeInBits().operator unsigned long long();
            RegBitWidth = if RegBitWidth {} else { CstBitWidth };
        }
        return false;
    }

struct Closure_3 {
    FixupConstant: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\X86\X86FixupVectorConstants.cpp:396:24),
}

unsafe fn Closure_3::call(self: *mut Closure_3, OpSrc: u32, BW: i32) -> auto {
        if OpSrc {
            if lookupBroadcastFoldTableBySize(OpSrc, BW) {
                Mem2Bcst;
            } else {
                let mut OpBcst: u32 = Mem2Bcst.DstOp;
                let mut OpNoBcst: u32 = Mem2Bcst.Flags & TB_INDEX_MASK;
                let mut Fixups: []FixupEntry = [FixupEntry { OpBcst as i32, 1, BW, rebuildSplatCst }];
            }
        }
    }
