static mut ID: i8 = 0;

fn createX86SuppressAPXForRelocationLegacyPass() -> *mut FunctionPass {
    return X86SuppressAPXForRelocationLegacy {};
}

fn suppressEGPRRegClass(MRI: *mut MachineRegisterInfo, MI: *mut MachineInstr, ST: *X86Subtarget, OpNum: u32) {
    let mut Reg: Register = MI.getOperand(OpNum).getReg();
    if !Reg.isVirtual() {
        assert!(!isApxExtendedReg(Reg.operator MCRegister()), "APX EGPR is used unexpectedly.");
        return;
    }
    let mut RC: *TargetRegisterClass = MRI.getRegClass(Reg);
    let mut RI: *X86RegisterInfo = ST.getRegisterInfo();
    let mut NewRC: *TargetRegisterClass = RI.constrainRegClassToNonRex2(RC);
    MRI.setRegClass(Reg, NewRC);
}

fn suppressEGPRRegClassInRegAndUses(MRI: *mut MachineRegisterInfo, MI: *mut MachineInstr, ST: *X86Subtarget, OpNum: u32) {
    suppressEGPRRegClass(MRI, MI, ST, OpNum);
    let mut Reg: Register = MI.getOperand(OpNum).getReg();
}

fn handleInstructionWithEGPR(MF: *mut MachineFunction, ST: *X86Subtarget) -> bool {
    if operator!(ST()()) {
        return false;
    }
    let mut MRI: *mut MachineRegisterInfo = &mut MF.getRegInfo();
    let mut suppressEGPRInInstrWithReloc: Closure_1 = Closure_1 { MRI: &mut MRI, ST: &mut ST };
    for MBB in MF {
        for MI in MBB {
            let mut Opcode: u32 = MI.getOpcode();
            match Opcode {

            }
        }
    }
    return true;
}

fn handleNDDOrNFInstructions(MF: *mut MachineFunction, ST: *X86Subtarget) -> bool {
    if operator!(ST()()) && operator!(ST()()) {
        return false;
    }
    let mut TII: *X86InstrInfo = ST.getInstrInfo();
    let mut MRI: *mut MachineRegisterInfo = &mut MF.getRegInfo();
    for MBB in MF {}
    return true;
}

fn suppressAPXForRelocation(MF: *mut MachineFunction) -> bool {
    if X86EnableAPXForRelocation() {
        return false;
    }
    let mut ST: *X86Subtarget = MF;
    let mut Changed: bool = handleInstructionWithEGPR(MF, ST);
    Changed |= handleNDDOrNFInstructions(MF, ST);
    return Changed;
}

fn X86SuppressAPXForRelocationLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return suppressAPXForRelocation(MF);
}

fn X86SuppressAPXForRelocationPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    return if suppressAPXForRelocation(MF) { getMachineFunctionPassPreservedAnalyses() } else { all() };
}

struct Closure_1 {
    MRI: *mut *mut MachineRegisterInfo,
    ST: *mut X86Subtarget,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MI: *mut MachineInstr, OpNoArray: ArrayRef<unsigned int>) {
        let mut MemOpNo: i32 = getMemoryOperandIdx(MI.getDesc());
        assert!(MemOpNo >= 0, "Expected a memory operand");
        let mut MO: *MachineOperand = MI.getOperand(AddrDisp + MemOpNo);
        if MO.getTargetFlags() == MO_GOTTPOFF || MO.getTargetFlags() == MO_GOTPCREL {
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-suppress-apx-for-relocation", 1) {
                    dbgs() << "Transform instruction with relocation type:\n  " << MI;
                }
            }
                if !(false) { break; }
            }
            for OpNo in OpNoArray {
                suppressEGPRRegClassInRegAndUses((*self.MRI), MI, (*self.ST), OpNo);
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("x86-suppress-apx-for-relocation", 1) {
                    dbgs() << "to:\n  " << MI << "\n";
                }
            }
                if !(false) { break; }
            }
        }
    }
