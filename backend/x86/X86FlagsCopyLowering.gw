static mut ID: i8 = 0;

fn X86FlagsCopyLoweringLegacy::getAnalysisUsage(self: *X86FlagsCopyLoweringLegacy, AU: *mut AnalysisUsage) {
    AU.addUsedIfAvailable();
    AU.addPreserved();
    self.getAnalysisUsage(AU);
