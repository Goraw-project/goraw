    return false;
}

fn X86FlagsCopyLoweringLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn X86FlagsCopyLoweringLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn X86FlagsCopyLoweringLegacy::getResolver(self: *X86FlagsCopyLoweringLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86FlagsCopyLoweringLegacy::getRequiredProperties(self: *X86FlagsCopyLoweringLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
