static mut NumCopiesEliminated: Statistic = Statistic { "x86-flags-copy-lowering", "NumCopiesEliminated", "Number of copies of EFLAGS eliminated" };

static mut NumSetCCsInserted: Statistic = Statistic { "x86-flags-copy-lowering", "NumSetCCsInserted", "Number of setCC instructions inserted" };

static mut NumTestsInserted: Statistic = Statistic { "x86-flags-copy-lowering", "NumTestsInserted", "Number of test instructions inserted" };

static mut NumAddsInserted: Statistic = Statistic { "x86-flags-copy-lowering", "NumAddsInserted", "Number of adds instructions inserted" };

static mut NumNFsConvertedTo: Statistic = Statistic { "x86-flags-copy-lowering", "NumNFsConvertedTo", "Number of NF instructions converted to" };

struct X86FlagsCopyLoweringImpl {
    MRI: *mut MachineRegisterInfo,
    Subtarget: *X86Subtarget,
    TII: *X86InstrInfo,
    TRI: *TargetRegisterInfo,
    PromoteRC: *TargetRegisterClass,
    MDT: *mut MachineDominatorTree,
}

struct X86FlagsCopyLoweringLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

