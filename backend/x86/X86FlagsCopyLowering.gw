fn isArithmeticOp(Opc: u32) -> bool {}

fn splitBlock(MBB: *mut MachineBasicBlock, SplitI: *mut MachineInstr, TII: *X86InstrInfo) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    assert!(SplitI.getParent() == &mut MBB, "Split instruction must be in the split block!");
    assert!(SplitI.isBranch(AnyInBundle), "Only designed to split a tail of branch instructions!");
    assert!(getCondFromBranch(SplitI) != COND_INVALID, "Must split on an actual jCC instruction!");
    let mut PrevI: *mut MachineInstr = operator*(prev(SplitI.getIterator()));
    assert!(PrevI.isBranch(AnyInBundle), "Must split after a branch!");
    assert!(getCondFromBranch(PrevI) != COND_INVALID, "Must split after an actual jCC instruction!");
    (((operator!(operator!((operator!(prev(PrevI.getIterator())()) && "Must only have this one terminator prior to the split!")))) || (_wassert(L"!std::prev(PrevI.getIterator())->isTerminator() && \"Must only have this one terminator prior to the split!\"", L"llvm\\lib\\Target\\X86\\X86FlagsCopyLowering.cpp", (167) as u32) , 0)) as void);
    let mut UnsplitSucc: *mut MachineBasicBlock = *PrevI.getOperand(0).getMBB();
    let mut IsEdgeSplit: bool = any_of(SplitI.getIterator(), MBB.instr_end(), Closure_1 { UnsplitSucc: &mut UnsplitSucc }) || MBB.getFallThrough(true) == &mut UnsplitSucc;
    let mut NewMBB: *mut MachineBasicBlock = *MF.CreateMachineBasicBlock(null, optional<UniqueBBID> { nullopt });
    MF.insert(next(iterator { &mut MBB }), &mut NewMBB);
    NewMBB.splice(NewMBB.end(), &mut MBB, iterator { SplitI.getIterator() }, MBB.end());
    for let mut SI: succ_iterator = MBB.succ_begin();
let mut SE: succ_iterator = MBB.succ_end(); SI != SE; SI += 1 {
        if IsEdgeSplit || *SI != &mut UnsplitSucc {
            NewMBB.copySuccessor(&mut MBB, SI);
        }
    }
    if !IsEdgeSplit {
        NewMBB.normalizeSuccProbs();
    }
    for Succ in NewMBB.successors() {
        if Succ != &mut UnsplitSucc {
            MBB.replaceSuccessor(Succ, &mut NewMBB);
        }
    }
    assert!(MBB.isSuccessor(&mut NewMBB), "Failed to make the new block a successor!");
    for Succ in NewMBB.successors() {
        for MI in *Succ {
            if !MI.isPHI() {
                break;
            }
            for let mut OpIdx: i32 = 1;
let mut NumOps: i32 = MI.getNumOperands(); OpIdx < NumOps; OpIdx += 2 {
                let mut OpV: *mut MachineOperand = MI.getOperand(OpIdx);
                let mut OpMBB: *mut MachineOperand = MI.getOperand(OpIdx + 1);
                assert!(OpMBB.isMBB(), "Block operand to a PHI is not a block!");
                if OpMBB.getMBB() != &mut MBB {
                    continue;
                }
                if !IsEdgeSplit || Succ != &mut UnsplitSucc {
                    OpMBB.setMBB(&mut NewMBB);
                    continue;
                }
                MI.addOperand(MF, OpV);
                MI.addOperand(MF, CreateMBB(&mut NewMBB, 0));
                break;
            }
        }
    }
    return NewMBB;
}

enum EFLAGSClobber {
    NoClobber = 0,
    EvitableClobber = 1,
    InevitableClobber = 2,
}

fn getClobberType(MI: *MachineInstr) -> EFLAGSClobber {
    let mut FlagDef: *MachineOperand = MI;
    if !FlagDef {
        return NoClobber;
    }
    if getNFVariantIfClobberRemovable(MI, null) {
        return EvitableClobber;
    }
    return InevitableClobber;
}

fn X86FlagsCopyLoweringImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-flags-copy-lowering", 1) {
            dbgs() << "********** " << "x86-flags-copy-lowering" << " : " << MF.getName() << " **********\n";
        }
    }
        if !(false) { break; }
    }
    self.Subtarget = operator&(MF);
    self.MRI = &mut MF.getRegInfo();
    self.TII = self.Subtarget.getInstrInfo();
    self.TRI;
    if MF.len == 0 {
        return false;
    }
    if none_of(self.MRI, Closure_2 {}) {
        return false;
    }
    let mut OwnedMDT: i32 = 0;
    if !self.MDT {
        OwnedMDT() = make_unique(MF);
        self.MDT = ();
    }
    let mut Copies: SmallSetVector<MachineInstr *, 4> = zeroed();
    let mut RPOT: i32 = &mut MF;
    if self.Subtarget() {
        let mut RemovedCopies: SmallSetVector<MachineInstr *, 4> = zeroed();
        let mut CopyIIt: auto = ();
        let mut CopyIEnd: auto = ();
        while CopyIIt() !=  {
            let mut NCopyIIt: auto = next();
            let mut EvitableClobbers: SmallSetVector<MachineInstr *, 4> = zeroed();
            let mut CopyI: *mut MachineInstr = operator*();
            let mut VOp: *mut MachineOperand = CopyI.getOperand(1);
            let mut CopyDefI: *mut MachineInstr = self.MRI.getVRegDef(VOp.getReg());
            let mut CopyIMBB: *mut MachineBasicBlock = CopyI.getParent();
            let mut CopyDefIMBB: *mut MachineBasicBlock = CopyDefI.getParent();
            for let mut BI: auto = idf_begin(CopyIMBB);
let mut BE: auto = idf_end(CopyDefIMBB); BI() != ;  += 1 {
                let mut MBB: *mut MachineBasicBlock = operator*();
                for let mut I: auto = if (MBB != CopyDefIMBB) { MBB.begin() } else { next(iterator { CopyDefI }) };
let mut E: auto = if (MBB != CopyIMBB) { MBB.end() } else { iterator { CopyI } }; I() != ;  += 1 {
                    let mut MI: *mut MachineInstr = operator*();
                    let mut ClobberType: EFLAGSClobber = getClobberType(MI);
                    if ClobberType == NoClobber {
                        continue;
                    }
                    if ClobberType == InevitableClobber {
                        
                    }
                    assert!(ClobberType == EvitableClobber, "unexpected workflow");
                    EvitableClobbers()(&mut MI);
                }
            }
            RemovedCopies()(CopyI);
            CopyI.eraseFromParent();
            if self.MRI.use_nodbg_empty(CopyDefI.getOperand(0).getReg()) {
                RemovedCopies()(CopyDefI);
                CopyDefI.eraseFromParent();
            }
            operator(NumCopiesEliminated);
            for let mut BI: auto = idf_begin(CopyIMBB);
let mut BE: auto = idf_end(CopyDefIMBB); BI() != ;  += 1 {
                if operator*() != CopyDefIMBB {
                    BI();
                }
            }
            CopyIIt() = ;
        }
        Copies()();
    }
    return true;
}

fn X86FlagsCopyLoweringImpl::collectCondsInRegs(self, MBB: *mut MachineBasicBlock, TestPos: iterator) -> CondRegArray {
    let mut CondRegs: CondRegArray = zeroed();
    return ;
}

fn X86FlagsCopyLoweringImpl::promoteCondToReg(self, TestMBB: *mut MachineBasicBlock, TestPos: iterator, TestLoc: *DebugLoc, Cond: CondCode) -> Register {
    let mut Reg: Register = self.MRI.createVirtualRegister(self.PromoteRC, "");
    let mut SetI: auto = BuildMI(TestMBB, TestPos, TestLoc, self.TII, Reg)(Cond);
     as void;
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-flags-copy-lowering", 1) {
            dbgs() << "    save cond: ";
            SetI()();
        }
    }
        if !(false) { break; }
    }
    operator(NumSetCCsInserted);
    return Reg;
}

fn X86FlagsCopyLoweringImpl::getCondOrInverseInReg(self, TestMBB: *mut MachineBasicBlock, TestPos: iterator, TestLoc: *DebugLoc, Cond: CondCode, CondRegs: *mut CondRegArray) -> pair<Register, bool> {
    let mut CondReg: *mut Register = null;
    let mut InvCondReg: *mut Register = null;
    if !CondReg.operator unsigned int() && !InvCondReg.operator unsigned int() {
        CondReg = self.promoteCondToReg(TestMBB, iterator { TestPos }, TestLoc, Cond);
    }
    if CondReg.operator unsigned int() {
        return void { CondReg, false };
    } else {
        return void { InvCondReg, true };
    }
}

fn X86FlagsCopyLoweringImpl::insertTest(self, MBB: *mut MachineBasicBlock, Pos: iterator, Loc: *DebugLoc, Reg: Register) {
    let mut TestI: auto = BuildMI(MBB, Pos, Loc, self.TII)(Reg)(Reg);
     as void;
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-flags-copy-lowering", 1) {
            dbgs() << "    test cond: ";
            TestI()();
        }
    }
        if !(false) { break; }
    }
    operator(NumTestsInserted);
}

fn X86FlagsCopyLoweringImpl::rewriteSetCC(self, MBB: *mut MachineBasicBlock, Pos: iterator, Loc: *DebugLoc, MI: *mut MachineInstr, CondRegs: *mut CondRegArray) {
    let mut Cond: CondCode = getCondFromSETCC(MI);
    let mut CondReg: *mut Register = null;
    if !CondReg.operator unsigned int() {
        CondReg = self.promoteCondToReg(MBB, iterator { Pos }, Loc, Cond);
    }
    if !MI.mayStore(AnyInBundle) {
        assert!(MI.getOperand(0).isReg(), "Cannot have a non-register defined operand to SETcc!");
        let mut OldReg: Register = MI.getOperand(0).getReg();
        self.MRI.clearKillFlags(OldReg);
        self.MRI.replaceRegWith(OldReg, CondReg);
        MI.eraseFromParent();
        return;
    }
    let mut MIB: auto = BuildMI(*MI.getParent(), MI.getIterator(), MI.getDebugLoc(), self.TII);
    for let mut i: i32 = 0; i < AddrNumOperands; i += 1 {
        MIB()(MI.getOperand(i));
    }
    MIB()(CondReg);
    MIB()(MI.memoperands());
    MI.eraseFromParent();
}

fn X86FlagsCopyLoweringImpl::rewriteArithmetic(self, MBB: *mut MachineBasicBlock, Pos: iterator, Loc: *DebugLoc, MI: *mut MachineInstr, CondRegs: *mut CondRegArray) {
    let mut Cond: CondCode = COND_B;
    let mut Addend: i32 = 255;
    let mut CondReg: *mut Register = null;
    if !CondReg.operator unsigned int() {
        CondReg = self.promoteCondToReg(MBB, iterator { Pos }, Loc, Cond);
    }
    let mut TmpReg: Register = self.MRI.createVirtualRegister(self.PromoteRC, "");
    let mut AddI: auto = BuildMI(*MI.getParent(), MI.getIterator(), MI.getDebugLoc(), self.TII)(TmpReg, Dead)(CondReg)(Addend);
     as void;
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-flags-copy-lowering", 1) {
            dbgs() << "    add cond: ";
            AddI()();
        }
    }
        if !(false) { break; }
    }
    operator(NumAddsInserted);
    MI(true);
}

fn getImplicitCondFromMI(Opc: u32) -> CondCode {
    match Opc {
        _ => {
            return COND_INVALID;
        },
    }
}

fn getOpcodeWithCC(Opc: u32, CC: CondCode) -> u32 {
    assert!((CC == COND_E || CC == COND_NE), "Unexpected CC");
    match Opc {
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "llvm\\lib\\Target\\X86\\X86FlagsCopyLowering.cpp", 891);
        },
    }
}

fn X86FlagsCopyLoweringImpl::rewriteMI(self, MBB: *mut MachineBasicBlock, Pos: iterator, Loc: *DebugLoc, MI: *mut MachineInstr, CondRegs: *mut CondRegArray) {
    let mut IsImplicitCC: bool = false;
    let mut CC: CondCode = getCondFromMI(MI);
    if CC == COND_INVALID {
        CC = getImplicitCondFromMI(MI.getOpcode());
        IsImplicitCC = true;
    }
    assert!(CC != COND_INVALID, "Unknown EFLAG user!");
    let mut CondReg: Register = Register { Reg: 0 };
    let mut Inverted: bool = false;
    self.insertTest(*MI.getParent(), iterator { MI.getIterator() }, MI.getDebugLoc(), CondReg);
    let mut NewCC: CondCode = if Inverted { COND_E } else { COND_NE };
    if IsImplicitCC {
        MI.setDesc(self.TII(getOpcodeWithCC(MI.getOpcode(), NewCC)));
    } else {
        MI.getOperand(MI.getDesc().getNumOperands() - 1).setImm(NewCC);
    }
    MI(true);
    while true {
        {
        if DebugFlag && isCurrentDebugType("x86-flags-copy-lowering", 1) {
            dbgs() << "    fixed instruction: ";
            MI.dump();
        }
    }
        if !(false) { break; }
    }
}

fn X86FlagsCopyLoweringLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut MDTWrapper: *mut auto = ;
    let mut MDT: *mut MachineDominatorTree = if  { operator&() } else { null };
    return X86FlagsCopyLoweringImpl { MDT }.runOnMachineFunction(MF);
}

fn X86FlagsCopyLoweringPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut MDT: *mut MachineDominatorTree = MFAM;
    let mut Changed: bool = X86FlagsCopyLoweringImpl { MDT }.runOnMachineFunction(MF);
    return if Changed { all() } else { getMachineFunctionPassPreservedAnalyses() };
}

struct Closure_1 {
    UnsplitSucc: *mut MachineBasicBlock,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MI: *mut MachineInstr) -> auto {
        assert!(MI.isTerminator(AnyInBundle), "Should only have spliced terminators!");
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, MI: *MachineInstr) -> bool {
        return MI.getOpcode() == COPY;
    }
