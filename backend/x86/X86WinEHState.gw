const OverdefinedState: i32 = (-2147483647 - 1);

const X86WinEHStatePassName: str = "Windows 32-bit x86 EH state insertion";

struct WinEHStateFnPassImpl {
    TheModule: *mut Module,
    EHLinkRegistrationTy: *mut StructType,
    CXXEHRegistrationTy: *mut StructType,
    SEHRegistrationTy: *mut StructType,
    SetJmp3: FunctionCallee,
    CxxLongjmpUnwind: FunctionCallee,
    Personality: EHPersonality,
    PersonalityFn: *mut Function,
    UseStackGuard: bool,
    ParentBaseState: i32,
    SehLongjmpUnwind: FunctionCallee,
    Cookie: *mut Constant,
    RegNode: *mut AllocaInst,
    RegNodeTy: *mut Type,
    EHGuardNode: *mut AllocaInst,
    StateFieldIndex: i32,
    Link: *mut Value,
}

struct WinEHStateLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    Impl: WinEHStateFnPassImpl,
}

fn WinEHStateLegacy::runOnFunction(self, Fn: *mut Function) -> bool {
    return self.Impl.runOnFunction(Fn);
}

fn WinEHStateLegacy::doInitialization(self, M: *mut Module) -> bool {
    return self.Impl.initialize(M);
}

fn WinEHStateLegacy::doFinalization(self, M: *mut Module) -> bool {
    return self.Impl.finalize(M);
}

fn WinEHStateLegacy::getPassName(self: *WinEHStateLegacy) -> str {
    return X86WinEHStatePassName;
}

fn WinEHStateLegacy::getPassKind(self: *WinEHStateLegacy) -> PassKind {
    return self.Kind;
}

fn WinEHStateLegacy::getPassID(self: *WinEHStateLegacy) -> AnalysisID {
    return self.PassID;
}

fn WinEHStateLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn WinEHStateLegacy::getResolver(self: *WinEHStateLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn X86WinEHStatePass::run(self, M: *mut Module, MAM: *mut ModuleAnalysisManager) -> PreservedAnalyses {
    let mut Impl: WinEHStateFnPassImpl = WinEHStateFnPassImpl {};
    Impl.initialize(M);
    let mut Changed: bool = false;
    for F in M {
        let mut ModifiedForFn: bool = Impl.runOnFunction(F);
        Changed = Changed || ModifiedForFn;
    }
    Impl.finalize(M);
    return if Changed { none().preserveSet() } else { all() };
}

fn createX86WinEHStateLegacyPass() -> *mut FunctionPass {
    return WinEHStateLegacy {};
}

static mut ID: i8 = 0;

fn WinEHStateFnPassImpl::initialize(self, M: *mut Module) -> bool {
    self.TheModule = &mut M;
    return false;
}

fn WinEHStateFnPassImpl::finalize(self, M: *mut Module) -> bool {
    assert!(self.TheModule == &mut M);
    self.TheModule = null;
    self.EHLinkRegistrationTy = null;
    self.CXXEHRegistrationTy = null;
    self.SEHRegistrationTy = null;
    self.SetJmp3 = null;
    self.CxxLongjmpUnwind = null;
    self.SehLongjmpUnwind = null;
    self.Cookie = null;
    return false;
}

fn WinEHStateLegacy::getAnalysisUsage(self: *WinEHStateLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
}

fn WinEHStateFnPassImpl::runOnFunction(self, F: *mut Function) -> bool {
    if F.hasAvailableExternallyLinkage() {
        return false;
    }
    if !F.hasPersonalityFn() {
        return false;
    }
    self.PersonalityFn = dyn_cast(F.getPersonalityFn().stripPointerCasts());
    if !self.PersonalityFn {
        return false;
    }
    self.Personality = classifyEHPersonality(self.PersonalityFn);
    if !isFuncletEHPersonality(self.Personality) {
        return false;
    }
    let mut HasPads: bool = false;
    for BB in F {
        if BB.isEHPad() {
            HasPads = true;
            break;
        }
    }
    if !HasPads {
        return false;
    }
    let mut Int8PtrType: *mut Type = getUnqual(self.TheModule.getContext());
    self.SetJmp3 = self.TheModule.getOrInsertFunction("_setjmp3", get(getInt32Ty(self.TheModule.getContext()), [Int8PtrType, getInt32Ty(self.TheModule.getContext())], true));
    self.emitExceptionRegistrationRecord(&mut F);
    let mut FuncInfo: WinEHFuncInfo = WinEHFuncInfo {};
    self.addStateStores(F, FuncInfo);
    self.updateEspForInAllocas(F);
    self.PersonalityFn = null;
    self.Personality = Unknown;
    self.UseStackGuard = false;
    self.RegNodeTy = null;
    self.RegNode = null;
    self.EHGuardNode = null;
    return true;
}

fn WinEHStateFnPassImpl::getEHLinkRegistrationType(self) -> *mut Type {
    if self.EHLinkRegistrationTy {
        return self.EHLinkRegistrationTy;
    }
    let mut Context: *mut LLVMContext = self.TheModule.getContext();
    let mut FieldTys: [2]*mut Type = [getUnqual(Context), getUnqual(Context)];
    self.EHLinkRegistrationTy = create(FieldTys, "EHRegistrationNode", false);
    return self.EHLinkRegistrationTy;
}

fn WinEHStateFnPassImpl::getCXXEHRegistrationType(self) -> *mut Type {
    if self.CXXEHRegistrationTy {
        return self.CXXEHRegistrationTy;
    }
    let mut Context: *mut LLVMContext = self.TheModule.getContext();
    let mut FieldTys: [3]*mut Type = [getUnqual(Context), self.getEHLinkRegistrationType(), getInt32Ty(Context)];
    self.CXXEHRegistrationTy = create(FieldTys, "CXXExceptionRegistration", false);
    return self.CXXEHRegistrationTy;
}

fn WinEHStateFnPassImpl::getSEHRegistrationType(self) -> *mut Type {
    if self.SEHRegistrationTy {
        return self.SEHRegistrationTy;
    }
    let mut Context: *mut LLVMContext = self.TheModule.getContext();
    let mut FieldTys: [5]*mut Type = [getUnqual(Context), getUnqual(Context), self.getEHLinkRegistrationType(), getInt32Ty(Context), getInt32Ty(Context)];
    self.SEHRegistrationTy = create(FieldTys, "SEHExceptionRegistration", false);
    return self.SEHRegistrationTy;
}

fn WinEHStateFnPassImpl::emitExceptionRegistrationRecord(self, F: *mut Function) {
    assert!(self.Personality == MSVC_CXX || self.Personality == MSVC_X86SEH);
    let mut Builder: IRBuilder<> = IRBuilder<> { &mut F.getEntryBlock(), F.getEntryBlock().begin() };
    let mut Int8PtrType: *mut Type = Builder.getPtrTy(0);
    let mut Int32Ty: *mut Type = Builder.getInt32Ty();
    let mut VoidTy: *mut Type = Builder.getVoidTy();
    if self.Personality == MSVC_CXX {
        self.RegNodeTy = self.getCXXEHRegistrationType();
        self.RegNode = Builder.CreateAlloca(self.RegNodeTy, null, "");
        let mut SP: *mut Value = Builder.CreateStackSave("");
        Builder.CreateStore(SP, Builder.CreateStructGEP(self.RegNodeTy, self.RegNode, 0, ""), false);
        self.StateFieldIndex = 2;
        self.ParentBaseState = -1;
        self.insertStateNumberStore(&mut operator(Builder.GetInsertPoint()), self.ParentBaseState);
        let mut Trampoline: *mut Function = self.generateLSDAInEAXThunk(F);
        self.Link = Builder.CreateStructGEP(self.RegNodeTy, self.RegNode, 1, "");
        self.linkExceptionRegistration(Builder, Trampoline);
        self.CxxLongjmpUnwind = self.TheModule.getOrInsertFunction("__CxxLongjmpUnwind", get(VoidTy, Int8PtrType, false));
        cast(self.CxxLongjmpUnwind.getCallee().stripPointerCasts()).setCallingConv(X86_StdCall);
    } else if self.Personality == MSVC_X86SEH {
        let mut PersonalityName: str = self.PersonalityFn.getName();
        self.UseStackGuard = (PersonalityName == "_except_handler4");
        self.RegNodeTy = self.getSEHRegistrationType();
        self.RegNode = Builder.CreateAlloca(self.RegNodeTy, null, "");
        if self.UseStackGuard {
            self.EHGuardNode = Builder.CreateAlloca(Int32Ty, null, "");
        }
        let mut SP: *mut Value = Builder.CreateStackSave("");
        Builder.CreateStore(SP, Builder.CreateStructGEP(self.RegNodeTy, self.RegNode, 0, ""), false);
        self.StateFieldIndex = 4;
        self.ParentBaseState = if self.UseStackGuard { -2 } else { -1 };
        self.insertStateNumberStore(&mut operator(Builder.GetInsertPoint()), self.ParentBaseState);
        let mut LSDA: *mut Value = self.emitEHLSDA(Builder, F);
        LSDA = Builder.CreatePtrToInt(LSDA, Int32Ty, "");
        if self.UseStackGuard {
            self.Cookie = self.TheModule.getOrInsertGlobal("__security_cookie", Int32Ty);
            let mut Val: *mut Value = Builder.CreateLoad(Int32Ty, self.Cookie, "cookie");
            LSDA = Builder.CreateXor(LSDA, Val, "");
        }
        Builder.CreateStore(LSDA, Builder.CreateStructGEP(self.RegNodeTy, self.RegNode, 3, ""), false);
        if self.UseStackGuard {
            let mut Val: *mut Value = Builder.CreateLoad(Int32Ty, self.Cookie, "");
            let mut FrameAddr: *mut Value = Builder.CreateIntrinsic(frameaddress, Builder.getPtrTy(self.TheModule.getDataLayout().getAllocaAddrSpace()), Builder.getInt32(0), null, "frameaddr", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_1 {}, null, null });
            let mut FrameAddrI32: *mut Value = Builder.CreatePtrToInt(FrameAddr, Int32Ty, "");
            FrameAddrI32 = Builder.CreateXor(FrameAddrI32, Val, "");
            Builder.CreateStore(FrameAddrI32, self.EHGuardNode, false);
        }
        self.Link = Builder.CreateStructGEP(self.RegNodeTy, self.RegNode, 2, "");
        self.linkExceptionRegistration(Builder, self.PersonalityFn);
        self.SehLongjmpUnwind = self.TheModule.getOrInsertFunction(if self.UseStackGuard { "_seh_longjmp_unwind4" } else { "_seh_longjmp_unwind" }, get(getVoidTy(self.TheModule.getContext()), Int8PtrType, false));
        cast(self.SehLongjmpUnwind.getCallee().stripPointerCasts()).setCallingConv(X86_StdCall);
    } else {
        llvm_unreachable_internal("unexpected personality function", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86WinEHState.cpp", 395);
    }
    for BB in *F {
        let mut T: *mut Instruction = BB.getTerminator();
        if !isa(T) {
            continue;
        }
        if BB.getTerminatingMustTailCall() {
            CI;
        } else {
            T = CI;
        }
        Builder.SetInsertPoint(T);
        self.unlinkExceptionRegistration(Builder);
    }
}

fn WinEHStateFnPassImpl::emitEHLSDA(self, Builder: *mut IRBuilder<>, F: *mut Function) -> *mut Value {
    return Builder.CreateIntrinsic(x86_seh_lsda, F, FMFSource {}, "", function_ref<void (CallInst *)> { Closure_2 {}, null, null });
}

fn WinEHStateFnPassImpl::generateLSDAInEAXThunk(self, ParentFunc: *mut Function) -> *mut Function {
    let mut Context: *mut LLVMContext = ParentFunc.getContext();
    let mut Int32Ty: *mut Type = getInt32Ty(Context);
    let mut Int8PtrType: *mut Type = getUnqual(Context);
    let mut ArgTys: [5]*mut Type = [Int8PtrType, Int8PtrType, Int8PtrType, Int8PtrType, Int8PtrType];
    let mut TrampolineTy: *mut FunctionType = get(Int32Ty, Type *> { &mut ArgTys[0], 4 }, false);
    let mut TargetFuncTy: *mut FunctionType = get(Int32Ty, Type *> { &mut ArgTys[0], 5 }, false);
    let mut Trampoline: *mut Function = Create(TrampolineTy, InternalLinkage, "__ehhandler$" + dropLLVMManglingEscape(ParentFunc.getName()), self.TheModule);
    if ParentFunc.getComdat() {
        C;
    } else {
        Trampoline.setComdat(C);
    }
    let mut EntryBB: *mut BasicBlock = Create(Context, "entry", Trampoline, null);
    let mut Builder: IRBuilder<> = EntryBB;
    let mut LSDA: *mut Value = self.emitEHLSDA(Builder, ParentFunc);
    let mut AI: arg_iterator = Trampoline.arg_begin();
    let mut Args: [5]*mut Value = [LSDA, &mut *AI += 1, &mut *AI += 1, &mut *AI += 1, &mut *AI += 1];
    let mut Call: *mut CallInst = Builder.CreateCall(TargetFuncTy, self.PersonalityFn, Args, "", null);
    Call.setTailCall(true);
    Call.addParamAttr(0, InReg);
    Builder.CreateRet(Call);
    return Trampoline;
}

fn WinEHStateFnPassImpl::linkExceptionRegistration(self, Builder: *mut IRBuilder<>, Handler: *mut Function) {
    Handler.addFnAttr("safeseh", "");
    let mut C: *mut LLVMContext = Builder.getContext();
    let mut LinkTy: *mut Type = self.getEHLinkRegistrationType();
    Builder.CreateStore(Handler, Builder.CreateStructGEP(LinkTy, self.Link, 1, ""), false);
    let mut FSZero: *mut Constant = getNullValue(get(C, FS));
    let mut Next: *mut Value = Builder.CreateLoad(getUnqual(C), FSZero, "");
    Builder.CreateStore(Next, Builder.CreateStructGEP(LinkTy, self.Link, 0, ""), false);
    Builder.CreateStore(self.Link, FSZero, false);
}

fn WinEHStateFnPassImpl::unlinkExceptionRegistration(self, Builder: *mut IRBuilder<>) {
    if dyn_cast(self.Link) {
        GEP;
    } else {
        GEP = cast(GEP.clone());
        Builder.Insert(GEP, "");
        self.Link = GEP;
    }
    let mut C: *mut LLVMContext = Builder.getContext();
    let mut LinkTy: *mut Type = self.getEHLinkRegistrationType();
    let mut Next: *mut Value = Builder.CreateLoad(getUnqual(C), Builder.CreateStructGEP(LinkTy, self.Link, 0, ""), "");
    let mut FSZero: *mut Constant = getNullValue(get(C, FS));
    Builder.CreateStore(Next, FSZero, false);
}

fn WinEHStateFnPassImpl::rewriteSetJmpCall(self, Builder: *mut IRBuilder<>, F: *mut Function, Call: *mut CallBase, State: *mut Value) {
    if Call.arg_size() != 2 {
        return;
    }
    let mut OpBundles: SmallVector<OperandBundleDef, 1> = SmallVector<OperandBundleDef, 1> {};
    Call.getOperandBundlesAsDefs(OpBundles);
    let mut OptionalArgs: SmallVector<Value *, 3> = SmallVector<Value *, 3> {};
    if self.Personality == MSVC_CXX {
        OptionalArgs.push(self.CxxLongjmpUnwind.getCallee());
        OptionalArgs.push(State);
        OptionalArgs.push(self.emitEHLSDA(Builder, &mut F));
    } else if self.Personality == MSVC_X86SEH {
        OptionalArgs.push(self.SehLongjmpUnwind.getCallee());
        OptionalArgs.push(State);
        if self.UseStackGuard {
            OptionalArgs.push(self.Cookie);
        }
    } else {
        llvm_unreachable_internal("unhandled personality!", "P:/Goraw/llvm-project/llvm/lib/Target/X86/X86WinEHState.cpp", 515);
    }
    let mut Args: SmallVector<Value *, 5> = SmallVector<Value *, 5> {};
    Args.push(Builder.CreateBitCast(Call.getArgOperand(0), Builder.getPtrTy(0), ""));
    Args.push(Builder.getInt32(OptionalArgs.len));
    Args.append(OptionalArgs.begin(), OptionalArgs.end());
    let mut NewCall: *mut CallBase = null;
    if dyn_cast(&mut Call) {
        CI;
    } else {
        let mut NewCI: *mut CallInst = Builder.CreateCall(self.SetJmp3, Args, OpBundles, "", null);
        NewCI.setTailCallKind(CI.getTailCallKind());
        NewCall = NewCI;
    }
    NewCall.setCallingConv(Call.getCallingConv());
    NewCall.setAttributes(Call.getAttributes());
    NewCall.setDebugLoc(Call.getDebugLoc());
    NewCall.takeName(&mut Call);
    Call.replaceAllUsesWith(NewCall);
    Call.eraseFromParent();
}

fn WinEHStateFnPassImpl::getBaseStateForBB(self, BlockColors: *mut DenseMap<BasicBlock *, ColorVector>, FuncInfo: *mut WinEHFuncInfo, BB: *mut BasicBlock) -> i32 {
    let mut BaseState: i32 = self.ParentBaseState;
    let mut BBColors: *mut BasicBlock *> = BlockColors[BB];
    assert!(BBColors.len == 1, "multi-color BB not removed by preparation");
    let mut FuncletEntryBB: *mut BasicBlock = BBColors.front();
    if dyn_cast(FuncletEntryBB.getFirstNonPHIIt()) {
        FuncletPad;
    } else {
        let mut BaseStateI: iterator = FuncInfo.FuncletBaseStateMap.find(FuncletPad);
        if BaseStateI != FuncInfo.FuncletBaseStateMap.end() {
            BaseState = operator(BaseStateI).second;
        }
    }
    return BaseState;
}

fn isIntrinsic(Call: *CallBase, ID: ID) -> bool {
    let mut CF: *Function = Call.getCalledFunction();
    return CF && CF.isIntrinsic() && CF.getIntrinsicID() == ID;
}

fn isSehScopeEnd(Call: *CallBase) -> bool {
    return isIntrinsic(Call, seh_scope_end);
}

fn isSehScopeBegin(Call: *CallBase) -> bool {
    return isIntrinsic(Call, seh_scope_begin);
}

fn WinEHStateFnPassImpl::getStateForCall(self, BlockColors: *mut DenseMap<BasicBlock *, ColorVector>, FuncInfo: *mut WinEHFuncInfo, Call: *mut CallBase) -> i32 {
    if dyn_cast(&mut Call) {
        II;
    } else {
        if isSehScopeEnd(*II) {
            return self.getBaseStateForBB(BlockColors, FuncInfo, II.getNormalDest());
        }
        assert!(FuncInfo.InvokeStateMap.count(II), "invoke has no state!");
        return FuncInfo.InvokeStateMap[II];
    }
    return self.getBaseStateForBB(BlockColors, FuncInfo, Call.getParent());
}

fn getPredState(FinalStates: *mut DenseMap<BasicBlock *, int>, F: *mut Function, ParentBaseState: i32, BB: *mut BasicBlock) -> i32 {
    if &mut F.getEntryBlock() == BB {
        return ParentBaseState;
    }
    if BB.isEHPad() {
        return OverdefinedState;
    }
    let mut CommonState: i32 = OverdefinedState;
    for PredBB in predecessors(BB) {
        let mut PredEndState: iterator = FinalStates.find(PredBB);
        if PredEndState == FinalStates.end() {
            return OverdefinedState;
        }
        if isa(PredBB.getTerminator()) {
            return OverdefinedState;
        }
        let mut PredState: i32 = operator(PredEndState).second;
        assert!(PredState != OverdefinedState, "overdefined BBs shouldn't be in FinalStates");
        if CommonState == OverdefinedState {
            CommonState = PredState;
        }
        if CommonState != PredState {
            return OverdefinedState;
        }
    }
    return CommonState;
}

fn getSuccState(InitialStates: *mut DenseMap<BasicBlock *, int>, F: *mut Function, ParentBaseState: i32, BB: *mut BasicBlock) -> i32 {
    if isa(BB.getTerminator()) {
        return OverdefinedState;
    }
    let mut CommonState: i32 = OverdefinedState;
    for SuccBB in successors(BB) {
        let mut SuccStartState: iterator = InitialStates.find(SuccBB);
        if SuccStartState == InitialStates.end() {
            return OverdefinedState;
        }
        if SuccBB.isEHPad() {
            return OverdefinedState;
        }
        let mut SuccState: i32 = operator(SuccStartState).second;
        assert!(SuccState != OverdefinedState, "overdefined BBs shouldn't be in FinalStates");
        if CommonState == OverdefinedState {
            CommonState = SuccState;
        }
        if CommonState != SuccState {
            return OverdefinedState;
        }
    }
    return CommonState;
}

fn WinEHStateFnPassImpl::isStateStoreNeeded(self, Personality: EHPersonality, Call: *mut CallBase) -> bool {
    if isSehScopeBegin(Call) || isSehScopeEnd(Call) {
        return true;
    }
    if isAsynchronousEHPersonality(Personality) {
        return !Call.doesNotAccessMemory();
    }
    return !Call.doesNotThrow();
}

fn WinEHStateFnPassImpl::addStateStores(self, F: *mut Function, FuncInfo: *mut WinEHFuncInfo) {
    let mut Builder: IRBuilder<> = self.RegNode.getNextNode();
    let mut RegNodeI8: *mut Value = Builder.CreateBitCast(self.RegNode, Builder.getPtrTy(0), "");
    Builder.CreateIntrinsic(x86_seh_ehregnode, [RegNodeI8], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_3 {}, null, null });
    if self.EHGuardNode {
        let mut Builder: IRBuilder<> = self.EHGuardNode.getNextNode();
        let mut EHGuardNodeI8: *mut Value = Builder.CreateBitCast(self.EHGuardNode, Builder.getPtrTy(0), "");
        Builder.CreateIntrinsic(x86_seh_ehguard, [EHGuardNodeI8], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_4 {}, null, null });
    }
    if isAsynchronousEHPersonality(self.Personality) {
        calculateSEHStateNumbers(&mut F, FuncInfo);
    } else {
        calculateWinCXXEHStateNumbers(&mut F, FuncInfo);
    }
    let mut BlockColors: DenseMap<BasicBlock *, ColorVector> = colorEHFunclets(F);
    let mut RPOT: ReversePostOrderTraversal<Function *> = &mut F;
    let mut InitialStates: DenseMap<BasicBlock *, int> = DenseMap<BasicBlock *, int> {};
    let mut FinalStates: DenseMap<BasicBlock *, int> = DenseMap<BasicBlock *, int> {};
    let mut Worklist: deque<BasicBlock *> = deque<BasicBlock *> {};
    for BB in RPOT {
        let mut InitialState: i32 = OverdefinedState;
        let mut FinalState: i32 = 0;
        if &mut F.getEntryBlock() == BB {
            InitialState = FinalState = self.ParentBaseState;
        }
        for I in *BB {
            let mut Call: *mut CallBase = dyn_cast(&mut I);
            if !Call || !self.isStateStoreNeeded(self.Personality, *Call) {
                continue;
            }
            let mut State: i32 = self.getStateForCall(BlockColors, FuncInfo, *Call);
            if InitialState == OverdefinedState {
                InitialState = State;
            }
            FinalState = State;
        }
        if InitialState == OverdefinedState {
            Worklist.push(BB);
            continue;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("winehstate", 1) {
                dbgs() << "X86WinEHState: " << BB.getName() << " InitialState=" << InitialState << 10;
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("winehstate", 1) {
                dbgs() << "X86WinEHState: " << BB.getName() << " FinalState=" << FinalState << 10;
            }
        }
            if !(false) { break; }
        }
        InitialStates.insert(BasicBlock *, int> { BB, InitialState });
        FinalStates.insert(BasicBlock *, int> { BB, FinalState });
    }
    while !Worklist.is_empty() {
        let mut BB: *mut BasicBlock = Worklist.front();
        Worklist.pop_front();
        if InitialStates.count(BB) != 0 {
            continue;
        }
        let mut PredState: i32 = getPredState(FinalStates, F, self.ParentBaseState, BB);
        if PredState == OverdefinedState {
            continue;
        }
        InitialStates.insert(BasicBlock *, int> { BB, PredState });
        FinalStates.insert(BasicBlock *, int> { BB, PredState });
        for SuccBB in successors(BB) {
            Worklist.push(SuccBB);
        }
    }
    for BB in RPOT {
        let mut SuccState: i32 = getSuccState(InitialStates, F, self.ParentBaseState, BB);
        if SuccState == OverdefinedState {
            continue;
        }
        FinalStates.insert(BasicBlock *, int> { BB, SuccState });
    }
    for BB in RPOT {
        let mut BBColors: *mut BasicBlock *> = BlockColors[BB];
        let mut FuncletEntryBB: *mut BasicBlock = BBColors.front();
        if isa(FuncletEntryBB.getFirstNonPHIIt()) {
            continue;
        }
        let mut PrevState: i32 = getPredState(FinalStates, F, self.ParentBaseState, BB);
        while true {
            {
            if DebugFlag && isCurrentDebugType("winehstate", 1) {
                dbgs() << "X86WinEHState: " << BB.getName() << " PrevState=" << PrevState << 10;
            }
        }
            if !(false) { break; }
        }
        for I in *BB {
            let mut Call: *mut CallBase = dyn_cast(&mut I);
            if !Call || !self.isStateStoreNeeded(self.Personality, *Call) {
                continue;
            }
            let mut State: i32 = self.getStateForCall(BlockColors, FuncInfo, *Call);
            if State != PrevState {
                self.insertStateNumberStore(&mut I, State);
            }
            PrevState = State;
        }
        let mut EndState: iterator = FinalStates.find(BB);
        if EndState != FinalStates.end() {
            if operator(EndState).second != PrevState {
                self.insertStateNumberStore(BB.getTerminator(), operator(EndState).second);
            }
        }
    }
    let mut SetJmp3Calls: SmallVector<CallBase *, 1> = SmallVector<CallBase *, 1> {};
    for BB in RPOT {
        for I in *BB {
            let mut Call: *mut CallBase = dyn_cast(&mut I);
            if !Call {
                continue;
            }
            if Call.getCalledOperand().stripPointerCasts() != self.SetJmp3.getCallee().stripPointerCasts() {
                continue;
            }
            SetJmp3Calls.push(Call);
        }
    }
    for Call in SetJmp3Calls {
        let mut BBColors: *mut BasicBlock *> = BlockColors[Call.getParent()];
        let mut FuncletEntryBB: *mut BasicBlock = BBColors.front();
        let mut InCleanup: bool = isa(FuncletEntryBB.getFirstNonPHIIt());
        let mut Builder: IRBuilder<> = Call;
        let mut State: *mut Value = null;
        if InCleanup {
            let mut StateField: *mut Value = Builder.CreateStructGEP(self.RegNodeTy, self.RegNode, self.StateFieldIndex, "");
            State = Builder.CreateLoad(Builder.getInt32Ty(), StateField, "");
        } else {
            State = Builder.getInt32(self.getStateForCall(BlockColors, FuncInfo, *Call));
        }
        self.rewriteSetJmpCall(Builder, F, *Call, State);
    }
}

fn WinEHStateFnPassImpl::insertStateNumberStore(self, IP: *mut Instruction, State: i32) {
    let mut Builder: IRBuilder<> = IP;
    let mut StateField: *mut Value = Builder.CreateStructGEP(self.RegNodeTy, self.RegNode, self.StateFieldIndex, "");
    Builder.CreateStore(Builder.getInt32(State), StateField, false);
}

fn WinEHStateFnPassImpl::updateEspForInAllocas(self, F: *mut Function) {
    for BB in F {
        for I in BB {
            if dyn_cast(&mut I) {
                Alloca;
            } else {
                if Alloca.isStaticAlloca() {
                    continue;
                }
                let mut Builder: IRBuilder<> = Alloca.getNextNode();
                let mut SP: *mut Value = Builder.CreateStackSave("");
                Builder.CreateStore(SP, Builder.CreateStructGEP(self.RegNodeTy, self.RegNode, 0, ""), false);
            }
            if dyn_cast(&mut I) {
                II;
            } else {
                if II.getIntrinsicID() != stackrestore {
                    continue;
                }
                let mut Builder: IRBuilder<> = II.getNextNode();
                let mut SP: *mut Value = Builder.CreateStackSave("");
                Builder.CreateStore(SP, Builder.CreateStructGEP(self.RegNodeTy, self.RegNode, 0, ""), false);
            }
        }
    }
}

