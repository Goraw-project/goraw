static mut EnableEarlyIfConvert: i32 = "aarch64-early-ifcvt";

static mut UseAddressTopByteIgnored: i32 = "aarch64-use-tbi";

static mut MachOUseNonLazyBind: i32 = "aarch64-macho-enable-nonlazybind";

static mut UseAA: i32 = "aarch64-use-aa";

static mut OverrideVectorInsertExtractBaseCost: i32 = "aarch64-insert-extract-base-cost";

static mut ReservedRegsForRA: i32 = "reserve-regs-for-regalloc";

static mut AuthenticatedLRCheckMethod: i32 = "aarch64-authenticated-lr-check-method";

static mut AArch64MinimumJumpTableEntries: i32 = "aarch64-min-jump-table-entries";

static mut AArch64StreamingHazardSize: i32 = "aarch64-streaming-hazard-size";

static mut AArch64StreamingStackHazardSize: alias = "aarch64-stack-hazard-size";

static mut VScaleForTuningOpt: i32 = "sve-vscale-for-tuning";

static mut EnableSubregLivenessTracking: i32 = "aarch64-enable-subreg-liveness-tracking";

static mut UseScalarIncVL: i32 = "sve-use-scalar-inc-vl";

fn AArch64Subtarget::getVectorInsertExtractBaseCost(self: *AArch64Subtarget) -> u32 {
    if OverrideVectorInsertExtractBaseCost()() > 0 {
        return ;
    }
    return self.VectorInsertExtractBaseCost;
}

fn AArch64Subtarget::initializeSubtargetDependencies(self, FS: str, CPUString: str, TuneCPUString: str, HasMinSize: bool) -> *mut AArch64Subtarget {
    if CPUString.is_empty() {
        CPUString = "generic";
    }
    if TuneCPUString.is_empty() {
        TuneCPUString = CPUString;
    }
    self.ParseSubtargetFeatures(CPUString, TuneCPUString, FS);
    self.initializeProperties(HasMinSize);
    return *self;
}

fn AArch64Subtarget::initializeProperties(self, HasMinSize: bool) {
    match self.ARMProcFamily {
        Generic => {
            
        },
    }
    if AArch64MinimumJumpTableEntries()() > 0 || !HasMinSize {
        self.MinimumJumpTableEntries = ;
    }
    if VScaleForTuningOpt()() > 0 {
        self.VScaleForTuning = ;
    }
}

fn AArch64Subtarget::AArch64Subtarget(self, TT: *Triple, CPU: str, TuneCPU: str, FS: str, TM: *TargetMachine, LittleEndian: bool, MinSVEVectorSizeInBitsOverride: u32, MaxSVEVectorSizeInBitsOverride: u32, IsStreaming: bool, IsStreamingCompatible: bool, HasMinSize: bool, EnableSRLTSubregToRegMitigation: bool) {
    if isX18ReservedByDefault(TT) {
        self.ReserveXRegister.set(18);
    }
    let mut RBI: *mut auto = null;
    let mut TRI: *AArch64RegisterInfo = self.getRegisterInfo();
    let mut ReservedRegNames: i32 = from_range;
    for let mut i: u32 = 0; i < 29; i += 1 {
        if ReservedRegNames()(TRI()) {
            self.ReserveXRegisterForRA.set(i);
        }
    }
    if ReservedRegNames()("X30") || ("LR") {
        self.ReserveXRegisterForRA.set(30);
    }
    if ReservedRegNames()("X29") || ("FP") {
        self.ReserveXRegisterForRA.set(29);
    }
}

