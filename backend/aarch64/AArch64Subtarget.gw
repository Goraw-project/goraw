static mut EnableEarlyIfConvert: opt<bool> = opt<bool> { "aarch64-early-ifcvt", "Enable the early if converter pass", init(true), Hidden };

static mut UseAddressTopByteIgnored: opt<bool> = opt<bool> { "aarch64-use-tbi", "Assume that top byte of an address is ignored", init(false), Hidden };

static mut MachOUseNonLazyBind: opt<bool> = opt<bool> { "aarch64-macho-enable-nonlazybind", "Call nonlazybind functions via direct GOT load for Mach-O", Hidden };

static mut UseAA: opt<bool> = opt<bool> { "aarch64-use-aa", init(true), "Enable the use of AA during codegen." };

static mut OverrideVectorInsertExtractBaseCost: opt<unsigned int> = opt<unsigned int> { "aarch64-insert-extract-base-cost", "Base cost of vector insert/extract element", Hidden };

static mut ReservedRegsForRA: string> = string> { "reserve-regs-for-regalloc", "Reserve physical registers, so they can't be used by register allocator. Should only be used for testing register allocator.", CommaSeparated, Hidden };

static mut AuthenticatedLRCheckMethod: AuthCheckMethod> = AuthCheckMethod> { "aarch64-authenticated-lr-check-method", Hidden, "Override the variant of check applied to authenticated LR during tail call", values(OptionEnumValue { Name: "none", Value: None, Description: "Do not check authenticated address" }, OptionEnumValue { Name: "load", Value: DummyLoad, Description: "Perform dummy load from authenticated address" }, OptionEnumValue { Name: "high-bits-notbi", Value: HighBitsNoTBI, Description: "Compare bits 62 and 61 of address (TBI should be disabled)" }, OptionEnumValue { Name: "xpac", Value: XPAC, Description: "Compare with the result of XPAC (requires Armv8.3-a)" }, OptionEnumValue { Name: "xpac-hint", Value: XPACHint, Description: "Compare with the result of XPACLRI" }) };

static mut AArch64MinimumJumpTableEntries: opt<unsigned int> = opt<unsigned int> { "aarch64-min-jump-table-entries", init(10), Hidden, "Set minimum number of entries to use a jump table on AArch64" };

static mut AArch64StreamingHazardSize: opt<unsigned int> = opt<unsigned int> { "aarch64-streaming-hazard-size", "Hazard size for streaming mode memory accesses. 0 = disabled.", init(0), Hidden };

static mut AArch64StreamingStackHazardSize: alias = alias { "aarch64-stack-hazard-size", "alias for -aarch64-streaming-hazard-size", AArch64StreamingHazardSize };

static mut VScaleForTuningOpt: opt<unsigned int> = opt<unsigned int> { "sve-vscale-for-tuning", Hidden, "Force a vscale for tuning factor for SVE" };

static mut EnableSubregLivenessTracking: opt<bool> = opt<bool> { "aarch64-enable-subreg-liveness-tracking", init(false), Hidden, "Enable subreg liveness tracking" };

static mut UseScalarIncVL: opt<bool> = opt<bool> { "sve-use-scalar-inc-vl", init(false), Hidden, "Prefer add+cnt over addvl/inc/dec" };

fn AArch64Subtarget::getVectorInsertExtractBaseCost(self: *AArch64Subtarget) -> u32 {
    if OverrideVectorInsertExtractBaseCost.getNumOccurrences() > 0 {
        return OverrideVectorInsertExtractBaseCost.operator unsigned int();
    }
    return self.VectorInsertExtractBaseCost;
}

fn AArch64Subtarget::initializeSubtargetDependencies(self, FS: str, CPUString: str, TuneCPUString: str, HasMinSize: bool) -> *mut AArch64Subtarget {
    if CPUString.is_empty() {
        CPUString = "generic";
    }
    if TuneCPUString.is_empty() {
        TuneCPUString = CPUString;
    }
    self.ParseSubtargetFeatures(CPUString, TuneCPUString, FS);
    self.initializeProperties(HasMinSize);
    return *self;
}

fn AArch64Subtarget::initializeProperties(self, HasMinSize: bool) {
    match self.ARMProcFamily {
        Generic => {
            if self.hasV8_4aOps() && !self.hasV8_8aOps() {
                self.AvoidLDAPUR = true;
            }
        },
        Carmel => {
            break;
        },
        CortexA35 => {
            CortexA53;
        },
        CortexA57 => {
            self.PrefFunctionAlignment = 16;
        },
        CortexA65 => {
            self.PrefFunctionAlignment = 8;
        },
        CortexA72 => {
            CortexA73;
        },
        CortexA76 => {
            CortexA77;
        },
        CortexA320 => {
            CortexA510;
        },
        CortexA710 => {
            CortexA715;
        },
        A64FX => {
            self.CacheLineSize = 256;
        },
        MONAKA => {
            self.VScaleForTuning = 2;
        },
        AppleA7 => {
            AppleA10;
        },
        ExynosM3 => {
            self.MaxJumpTableSize = 20;
        },
        Falkor => {
            self.MinVectorRegisterBitWidth = 128;
        },
        Kryo => {
            self.VectorInsertExtractBaseCost = 2;
        },
        NeoverseE1 => {
            self.PrefFunctionAlignment = 8;
        },
        NeoverseN1 => {
            self.PrefFunctionAlignment = 16;
        },
        NeoverseV2 => {
            NeoverseV3;
        },
        NeoverseN2 => {
            NeoverseN3;
        },
        NeoverseV1 => {
            self.PrefFunctionAlignment = 16;
        },
        Neoverse512TVB => {
            self.PrefFunctionAlignment = 16;
        },
        Saphira => {
            self.MinVectorRegisterBitWidth = 128;
        },
        ThunderX2T99 => {
            self.PrefFunctionAlignment = 8;
        },
        ThunderX => {
            ThunderXT88;
        },
        TSV110 => {
            self.PrefFunctionAlignment = 16;
        },
        HIP12 => {
            self.PrefFunctionAlignment = 16;
        },
        ThunderX3T110 => {
            self.PrefFunctionAlignment = 16;
        },
        Ampere1 => {
            Ampere1A;
        },
        Oryon => {
            self.PrefFunctionAlignment = 16;
        },
        Olympus => {
            self.EpilogueVectorizationMinVF = 8;
        },
    }
    if AArch64MinimumJumpTableEntries.getNumOccurrences() > 0 || !HasMinSize {
        self.MinimumJumpTableEntries = AArch64MinimumJumpTableEntries.operator unsigned int();
    }
    if VScaleForTuningOpt.getNumOccurrences() > 0 {
        self.VScaleForTuning = VScaleForTuningOpt.operator unsigned int();
    }
}

fn AArch64Subtarget::AArch64Subtarget(self, TT: *Triple, CPU: str, TuneCPU: str, FS: str, TM: *TargetMachine, LittleEndian: bool, MinSVEVectorSizeInBitsOverride: u32, MaxSVEVectorSizeInBitsOverride: u32, IsStreaming: bool, IsStreamingCompatible: bool, HasMinSize: bool, EnableSRLTSubregToRegMitigation: bool) {
    if isX18ReservedByDefault(TT) {
        self.ReserveXRegister.set(18);
    }
    self.CallLoweringInfo.reset(*self.getTargetLowering());
    self.InlineAsmLoweringInfo.reset(self.getTargetLowering());
    self.Legalizer.reset(*self);
    let mut RBI: *mut AArch64RegisterBankInfo = *self.getRegisterInfo();
    self.InstSelector.reset(createAArch64InstructionSelector(*&mut TM as *AArch64TargetMachine, *self, *RBI));
    self.RegBankInfo.reset(RBI);
    let mut TRI: *AArch64RegisterInfo = self.getRegisterInfo();
    let mut ReservedRegNames: StringSet<> = StringSet<> { from_range, ReservedRegsForRA };
    for let mut i: u32 = 0; i < 29; i += 1 {
        if ReservedRegNames.count(TRI.getName(X0 + i)) {
            self.ReserveXRegisterForRA.set(i);
        }
    }
    if ReservedRegNames.count("X30") || ReservedRegNames.count("LR") {
        self.ReserveXRegisterForRA.set(30);
    }
    if ReservedRegNames.count("X29") || ReservedRegNames.count("FP") {
        self.ReserveXRegisterForRA.set(29);
    }
}

fn AArch64Subtarget::getCallLowering(self: *AArch64Subtarget) -> *CallLowering {
    return self.CallLoweringInfo.get();
}

fn AArch64Subtarget::getInlineAsmLowering(self: *AArch64Subtarget) -> *InlineAsmLowering {
    return self.InlineAsmLoweringInfo.get();
}

fn AArch64Subtarget::getInstructionSelector(self: *AArch64Subtarget) -> *mut InstructionSelector {
    return self.InstSelector.get();
}

fn AArch64Subtarget::getLegalizerInfo(self: *AArch64Subtarget) -> *LegalizerInfo {
    return self.Legalizer.get();
}

fn AArch64Subtarget::getRegBankInfo(self: *AArch64Subtarget) -> *RegisterBankInfo {
    return self.RegBankInfo.get();
}

fn AArch64Subtarget::ClassifyGlobalReference(self: *AArch64Subtarget, GV: *GlobalValue, TM: *TargetMachine) -> u32 {
    if TM.getCodeModel() == Large && self.isTargetMachO() {
        return MO_GOT;
    }
    if GV.isTagged() {
        return MO_GOT;
    }
    if !TM.shouldAssumeDSOLocal(GV) {
        if GV.hasDLLImportStorageClass() {
            return MO_GOT | MO_DLLIMPORT;
        }
        if self.getTargetTriple().isOSWindows() {
            return MO_GOT | MO_COFFSTUB;
        }
        return MO_GOT;
    }
    if (self.useSmallAddressing() || TM.getCodeModel() == Tiny) && GV.hasExternalWeakLinkage() {
        return MO_GOT;
    }
    if self.AllowTaggedGlobals && !isa(GV.getValueType()) {
        return MO_NC | MO_TAGGED;
    }
    return MO_NO_FLAG;
}

fn AArch64Subtarget::classifyGlobalFunctionReference(self: *AArch64Subtarget, GV: *GlobalValue, TM: *TargetMachine) -> u32 {
    if TM.getCodeModel() == Large && self.isTargetMachO() && !GV.hasInternalLinkage() {
        return MO_GOT;
    }
    let mut F: *Function = dyn_cast(GV);
    if (!self.isTargetMachO() || MachOUseNonLazyBind) && F && F.hasFnAttribute(NonLazyBind) && !TM.shouldAssumeDSOLocal(GV) {
        return MO_GOT;
    }
    if self.getTargetTriple().isOSWindows() {
        if self.isWindowsArm64EC() && GV.getValueType().isFunctionTy() {
            if GV.hasDLLImportStorageClass() {
                return MO_GOT | MO_DLLIMPORT | MO_ARM64EC_CALLMANGLE;
            }
            if GV.hasExternalLinkage() {
                return MO_ARM64EC_CALLMANGLE;
            }
        }
        return self.ClassifyGlobalReference(GV, TM);
    }
    return MO_NO_FLAG;
}

fn AArch64Subtarget::overrideSchedPolicy(self: *AArch64Subtarget, Policy: *mut MachineSchedPolicy, Region: *SchedRegion) {
    Policy.OnlyTopDown = false;
    Policy.OnlyBottomUp = false;
    Policy.DisableLatencyHeuristic = self.DisableLatencySchedHeuristic;
}

fn AArch64Subtarget::adjustSchedDependency(self: *AArch64Subtarget, Def: *mut SUnit, DefOpIdx: i32, Use: *mut SUnit, UseOpIdx: i32, Dep: *mut SDep, SchedModel: *TargetSchedModel) {
    if !SchedModel || Dep.getKind() != Data || !Dep.getReg().operator unsigned int() || !Def.isInstr() || !Use.isInstr() || (Def.getInstr().getOpcode() != BUNDLE && Use.getInstr().getOpcode() != BUNDLE) {
        return;
    }
    let mut DefMI: *MachineInstr = Def.getInstr();
    if DefMI.getOpcode() == BUNDLE {
        let mut Reg: Register = DefMI.getOperand(DefOpIdx).getReg();
        for Op in const_mi_bundle_ops(*DefMI) {
            if Op.isReg() && Op.isDef() && Op.getReg() == Reg {
                DefMI = Op.getParent();
                DefOpIdx = Op.getOperandNo();
            }
        }
    }
    let mut UseMI: *MachineInstr = Use.getInstr();
    if UseMI.getOpcode() == BUNDLE {
        let mut Reg: Register = UseMI.getOperand(UseOpIdx).getReg();
        for Op in const_mi_bundle_ops(*UseMI) {
            if Op.isReg() && Op.isUse() && Op.getReg() == Reg {
                UseMI = Op.getParent();
                UseOpIdx = Op.getOperandNo();
                break;
            }
        }
    }
    Dep.setLatency(SchedModel.computeOperandLatency(DefMI, DefOpIdx, UseMI, UseOpIdx));
}

fn AArch64Subtarget::enableEarlyIfConversion(self: *AArch64Subtarget) -> bool {
    return EnableEarlyIfConvert;
}

fn AArch64Subtarget::supportsAddressTopByteIgnored(self: *AArch64Subtarget) -> bool {
    if !UseAddressTopByteIgnored {
        return false;
    }
    if self.TargetTriple.isDriverKit() {
        return true;
    }
    if self.TargetTriple.isiOS() {
        return self.TargetTriple.getiOSVersion() >= 8;
    }
    return false;
}

fn AArch64Subtarget::getCustomPBQPConstraints(self: *AArch64Subtarget) -> unique_ptr<PBQPRAConstraint> {
    return if self.balanceFPOps() { make_unique() } else { null };
}

fn AArch64Subtarget::mirFileLoaded(self: *AArch64Subtarget, MF: *mut MachineFunction) {
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    if !MFI.isMaxCallFrameSizeComputed() {
        MFI.computeMaxCallFrameSize(MF, null);
    }
}

fn AArch64Subtarget::useAA(self: *AArch64Subtarget) -> bool {
    return UseAA;
}

fn AArch64Subtarget::useScalarIncVL(self: *AArch64Subtarget) -> bool {
    if UseScalarIncVL.getNumOccurrences() {
        return UseScalarIncVL;
    }
    return self.hasSVE2() || self.hasSME();
}

fn AArch64Subtarget::getAuthenticatedLRCheckMethod(self: *AArch64Subtarget, MF: *MachineFunction) -> AuthCheckMethod {
    if MF.getFunction().hasFnAttribute("ptrauth-returns") && MF.getFunction().hasFnAttribute("ptrauth-auth-traps") {
        return HighBitsNoTBI;
    }
    if AuthenticatedLRCheckMethod.getNumOccurrences() {
        return AuthenticatedLRCheckMethod.operator llvm::AArch64PAuth::AuthCheckMethod();
    }
    return None;
}

fn AArch64Subtarget::getPtrAuthBlockAddressDiscriminatorIfEnabled(self: *AArch64Subtarget, ParentFn: *Function) -> optional<uint16_t> {
    if !ParentFn.hasFnAttribute("ptrauth-indirect-gotos") {
        return nullopt;
    }
    return getPointerAuthStableSipHash((ParentFn.getName() + " blockaddress"));
}

fn AArch64Subtarget::isX16X17Safer(self: *AArch64Subtarget) -> bool {
    return self.isTargetDarwin();
}

fn AArch64Subtarget::enableMachinePipeliner(self: *AArch64Subtarget) -> bool {
    return self.getSchedModel().hasInstrSchedModel();
}

fn getMOVKShiftImm(MI: *MachineInstr) -> u32 {
    let mut Opc: u32 = MI.getOpcode();
    if Opc != MOVKWi && Opc != MOVKXi {
        return 0;
    }
    return MI.getOperand(3).getImm();
}

fn fusesMOVImmPairImpl(ST: *AArch64Subtarget, HasFirst: bool, FirstOpc: u32, FirstShift: u32, SecondOpc: u32, SecondShift: u32) -> bool {
    assert!(ST.hasFuseLiterals(), "the subtarget doesn't fuse move immediate");
    if (!HasFirst || FirstOpc == MOVZWi) && SecondOpc == MOVKWi && SecondShift == 16 {
        return true;
    }
    if (!HasFirst || FirstOpc == MOVZXi) && SecondOpc == MOVKXi && SecondShift == 16 {
        return true;
    }
    if (!HasFirst || (FirstOpc == MOVKXi && FirstShift == 32)) && SecondOpc == MOVKXi && SecondShift == 48 {
        return true;
    }
    return false;
}

fn AArch64Subtarget::fusesMOVImmPair(self: *AArch64Subtarget, FirstOpc: u32, FirstShift: u32, SecondOpc: u32, SecondShift: u32) -> bool {
    return fusesMOVImmPairImpl(*self, true, FirstOpc, FirstShift, SecondOpc, SecondShift);
}

fn AArch64Subtarget::fusesMOVImmPair(self: *AArch64Subtarget, FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    return fusesMOVImmPairImpl(*self, FirstMI != null, if FirstMI { FirstMI.getOpcode() } else { 0 }, if FirstMI { getMOVKShiftImm(*FirstMI) } else { 0 }, SecondMI.getOpcode(), getMOVKShiftImm(SecondMI));
}
