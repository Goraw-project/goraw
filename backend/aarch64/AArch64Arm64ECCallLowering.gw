static mut Arm64ECCallsLowered: Statistic = Statistic { "arm64eccalllowering", "Arm64ECCallsLowered", "Number of Arm64EC calls lowered" };

static mut LowerDirectToIndirect: i32 = "arm64ec-lower-direct-to-indirect";

static mut GenerateThunks: i32 = "arm64ec-generate-thunks";

enum ThunkArgTranslation {
    Direct = 0,
    Bitcast = 1,
    PointerIndirection = 2,
}

struct ThunkArgInfo {
    Arm64Ty: *mut Type,
    X64Ty: *mut Type,
    Translation: ThunkArgTranslation,
}

struct AArch64Arm64ECCallLowering {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    CFGuardModuleFlag: ControlFlowGuardMode,
    GuardFnType: *mut FunctionType,
    DispatchFnType: *mut FunctionType,
    GuardFnCFGlobal: *mut Constant,
    GuardFnGlobal: *mut Constant,
    DispatchFnGlobal: *mut Constant,
    M: *mut Module,
    PtrTy: *mut Type,
    I64Ty: *mut Type,
    VoidTy: *mut Type,
}

fn AArch64Arm64ECCallLowering::getPassKind(self: *AArch64Arm64ECCallLowering) -> PassKind {
    return self.Kind;
}

fn AArch64Arm64ECCallLowering::getPassID(self: *AArch64Arm64ECCallLowering) -> AnalysisID {
    return self.PassID;
}

fn AArch64Arm64ECCallLowering::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64Arm64ECCallLowering::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64Arm64ECCallLowering::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64Arm64ECCallLowering::getResolver(self: *AArch64Arm64ECCallLowering) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64Arm64ECCallLowering::getThunkType(self, FT: *mut FunctionType, AttrList: AttributeList, TT: Arm64ECThunkType, Out: *mut raw_ostream, Arm64Ty: *mut *mut FunctionType, X64Ty: *mut *mut FunctionType, ArgTranslations: *mut i32) {
    Out << (if TT == Entry { "$ientry_thunk$cdecl$" } else { "$iexit_thunk$cdecl$" });
    let mut Arm64RetTy: *mut Type = null;
    let mut X64RetTy: *mut Type = null;
    let mut Arm64ArgTypes: i32 = 0;
    let mut X64ArgTypes: i32 = 0;
    if TT == Exit {
        Arm64ArgTypes()(self.PtrTy);
    }
    X64ArgTypes()(self.PtrTy);
    let mut HasSretPtr: bool = false;
    self.getThunkArgTypes(FT, AttrList, TT, Out, HasSretPtr);
    Arm64Ty = get(Arm64RetTy, false);
    X64Ty = get(X64RetTy, false);
}

fn AArch64Arm64ECCallLowering::getThunkArgTypes(self, FT: *mut FunctionType, AttrList: AttributeList, TT: Arm64ECThunkType, Out: *mut raw_ostream, Arm64ArgTypes: *mut SmallVectorImpl<Type *>, X64ArgTypes: *mut SmallVectorImpl<Type *>, ArgTranslations: *mut SmallVectorImpl<ThunkArgTranslation>, HasSretPtr: bool) {
    Out << "$";
    if FT.isVarArg() {
        Out << "varargs";
        for let mut i: i32 = if HasSretPtr { 1 } else { 0 }; i < 4; i += 1 {
            Arm64ArgTypes()(self.I64Ty);
            X64ArgTypes()(self.I64Ty);
            ArgTranslations()(Direct);
        }
        Arm64ArgTypes()(self.PtrTy);
        X64ArgTypes()(self.PtrTy);
        ArgTranslations()(Direct);
        Arm64ArgTypes()(self.I64Ty);
        if TT != Entry {
            X64ArgTypes()(self.I64Ty);
            ArgTranslations()(Direct);
        }
        return;
    }
    let mut I: u32 = 0;
    if HasSretPtr {
        I += 1;
    }
    if I == FT.getNumParams() {
        Out << "v";
        return;
    }
    for let mut E: u32 = FT.getNumParams(); I != E; I += 1 {
        let mut ArgSizeBytes: u64 = 0;
        let mut ParamAlign: Align = Align {};
        Arm64ArgTypes()(Arm64Ty);
        X64ArgTypes()(X64Ty);
        ArgTranslations()(ArgTranslation);
    }
}

fn AArch64Arm64ECCallLowering::getThunkRetType(self, FT: *mut FunctionType, AttrList: AttributeList, Out: *mut raw_ostream, Arm64RetTy: *mut *mut Type, X64RetTy: *mut *mut Type, Arm64ArgTypes: *mut SmallVectorImpl<Type *>, X64ArgTypes: *mut SmallVectorImpl<Type *>, ArgTranslations: *mut i32, HasSretPtr: *mut bool) {
    let mut T: *mut Type = FT.getReturnType();
    let mut ArgSizeBytes: i64 = 0;
    if T.isVoidTy() {
        if FT.getNumParams() {
            let mut SRetAttr0: Attribute = AttrList.getParamAttr(0, StructRet);
            let mut InRegAttr0: Attribute = AttrList.getParamAttr(0, InReg);
            let mut SRetAttr1: Attribute = Attribute {};
            let mut InRegAttr1: Attribute = Attribute {};
            if FT.getNumParams() > 1 {
                SRetAttr1 = AttrList.getParamAttr(1, StructRet);
                InRegAttr1 = AttrList.getParamAttr(1, InReg);
            }
            if (SRetAttr0.isValid() && InRegAttr0.isValid()) || (SRetAttr1.isValid() && InRegAttr1.isValid()) {
                Out << "i8";
                Arm64RetTy = self.I64Ty;
                X64RetTy = self.I64Ty;
                return;
            }
            if SRetAttr0.isValid() {
                let mut SRetType: *mut Type = SRetAttr0.getValueAsType();
                let mut SRetAlign: Align = AttrList.getParamAlignment(0).valueOrOne();
                self.canonicalizeThunkType(SRetType, SRetAlign, true, ArgSizeBytes, Out);
                Arm64RetTy = self.VoidTy;
                X64RetTy = self.VoidTy;
                Arm64ArgTypes()(FT.getParamType(0));
                X64ArgTypes()(FT.getParamType(0));
                ArgTranslations()(Direct);
                HasSretPtr = true;
                return;
            }
        }
        Out << "v";
        Arm64RetTy = self.VoidTy;
        X64RetTy = self.VoidTy;
        return;
    }
    let mut info: ThunkArgInfo = self.canonicalizeThunkType(T, Align {}, true, ArgSizeBytes, Out);
    Arm64RetTy = info.Arm64Ty;
    X64RetTy = info.X64Ty;
    if X64RetTy.isPointerTy() {
        X64ArgTypes()(X64RetTy);
        X64RetTy = self.VoidTy;
    }
}

fn AArch64Arm64ECCallLowering::canonicalizeThunkType(self, T: *mut Type, Alignment: Align, Ret: bool, ArgSizeBytes: u64, Out: *mut raw_ostream) -> ThunkArgInfo {
    let mut direct: Closure_1 = Closure_1 {};
    let mut bitcast: Closure_2 = Closure_2 { cap_0: self };
    let mut pointerIndirection: Closure_3 = Closure_3 { cap_0: self };
    if T.isHalfTy() {
        Out << "__llvm_h__";
        return direct.call(T);
    }
    if T.isBFloatTy() {
        Out << "__llvm_bf16__";
        return direct.call(T);
    }
    if T.isFloatTy() {
        Out << "f";
        return direct.call(T);
    }
    if T.isDoubleTy() {
        Out << "d";
        return direct.call(T);
    }
    if T.isFP128Ty() {
        Out << "__llvm_q__";
        return pointerIndirection.call(T);
    }
    if T.isFloatingPointTy() {
        report_fatal_error("Only half, bfloat16, float, double, and fp128 are supported for ARM64EC thunks", true);
    }
    let mut DL: *DataLayout = self.M.getDataLayout();
    if  {
        if StructTy()() == 1 {
            T = (0);
        }
    }
    if T.isArrayTy() {
        let mut ElementTy: *mut Type = T.getArrayElementType();
        let mut ElementCnt: u64 = T.getArrayNumElements();
        let mut ElementSizePerBytes: u64 = DL.getTypeSizeInBits(ElementTy);
        let mut TotalSizeBytes: u64 = ElementCnt * ElementSizePerBytes;
        if ElementTy.isHalfTy() || ElementTy.isBFloatTy() || ElementTy.isFloatTy() || ElementTy.isDoubleTy() || ElementTy.isFP128Ty() {
            if ElementTy.isHalfTy() {
                Out << "__llvm_H__";
            } else if ElementTy.isBFloatTy() {
                Out << "__llvm_BF16__";
            } else if ElementTy.isFloatTy() {
                Out << "F";
            } else if ElementTy.isDoubleTy() {
                Out << "D";
            } else if ElementTy.isFP128Ty() {
                Out << "__llvm_Q__";
            }
            Out << TotalSizeBytes;
            if Alignment.value() >= 16 && !Ret {
                Out << "a" << Alignment.value();
            }
            if TotalSizeBytes <= 8 {
                return bitcast.call(T, TotalSizeBytes);
            } else {
                return pointerIndirection.call(T);
            }
        } else if ElementTy.isFloatingPointTy() {
            report_fatal_error("Only half, bfloat16, float, double, and fp128 are supported for ARM64EC thunks", true);
        }
    }
    if (T.isIntegerTy() || T.isPointerTy()) && DL.getTypeSizeInBits(T) {
        Out << "i8";
        return direct.call(self.I64Ty);
    }
    let mut TypeSize: u32 = ArgSizeBytes;
    if TypeSize == 0 {
        TypeSize = DL.getTypeSizeInBits(T);
    }
    Out << "m";
    if TypeSize != 4 {
        Out << TypeSize;
    }
    if Alignment.value() >= 16 && !Ret {
        Out << "a" << Alignment.value();
    }
    if TypeSize == 1 || TypeSize == 2 || TypeSize == 4 || TypeSize == 8 {
        return bitcast.call(T, TypeSize);
    } else {
        return pointerIndirection.call(T);
    }
}

fn AArch64Arm64ECCallLowering::buildExitThunk(self, FT: *mut FunctionType, Attrs: AttributeList) -> *mut Function {
    let mut ExitThunkName: str = zeroed();
    let mut ExitThunkStream: raw_svector_ostream = ExitThunkName();
    let mut Arm64Ty: *mut FunctionType = null;
    let mut X64Ty: *mut FunctionType = null;
    let mut ArgTranslations: i32 = 0;
    if self.M.getFunction() {
        F;
    } else {
        return F;
    }
    let mut F: *mut Function = Create(Arm64Ty, LinkOnceODRLinkage, 0, self.M);
    F.setCallingConv(ARM64EC_Thunk_Native);
    F.setSection;
    F.setComdat(self.M.getOrInsertComdat());
    F.addFnAttr("frame-pointer", "all");
    if FT.getNumParams() {
        let mut SRet: Attribute = Attrs.getParamAttr(0, StructRet);
        let mut InReg: Attribute = Attrs.getParamAttr(0, InReg);
        if SRet.isValid() && !InReg.isValid() {
            F.addParamAttr(1, SRet);
        }
    }
    let mut BB: *mut BasicBlock = Create(self.M.getContext(), "", F, null);
    let mut IRB: i32 = BB;
    let mut CalleePtr: *mut Value = self.M.getOrInsertGlobal("__os_arm64x_dispatch_call_no_redirect", self.PtrTy);
    let mut Callee: *mut Value = (self.PtrTy, CalleePtr);
    let mut DL: *DataLayout = self.M.getDataLayout();
    let mut Args: i32 = 0;
    let mut DispatcherCallTy: *mut FunctionType = X64Ty;
    if FT.isVarArg() {
        DispatcherCallTy = get(X64Ty.getReturnType(), X64Ty()(), true);
    }
    let mut X64TyOffset: i32 = 1;
    Args()(F.arg_begin());
    let mut RetTy: *mut Type = Arm64Ty.getReturnType();
    if RetTy != X64Ty.getReturnType() {
        if DL.getTypeStoreSize(RetTy) {
            Args()((RetTy));
            X64TyOffset += 1;
        }
    }
    let mut Call: *mut CallInst = (DispatcherCallTy, Callee);
    Call.setCallingConv;
    let mut RetVal: *mut Value = Call();
    if RetTy != X64Ty.getReturnType() {
        if DL.getTypeStoreSize(RetTy) {
            RetVal = (RetTy, [1]);
        } else {
            let mut CastAlloca: *mut Value = (RetTy);
            IRB()(Call, CastAlloca);
            RetVal = (RetTy, CastAlloca);
        }
    }
    if RetTy.isVoidTy() {
        IRB()();
    } else {
        IRB()(RetVal);
    }
    return F;
}

fn AArch64Arm64ECCallLowering::buildEntryThunk(self, F: *mut Function) -> *mut Function {
    let mut EntryThunkName: str = zeroed();
    let mut EntryThunkStream: raw_svector_ostream = EntryThunkName();
    let mut Arm64Ty: *mut FunctionType = null;
    let mut X64Ty: *mut FunctionType = null;
    let mut ArgTranslations: i32 = 0;
    if self.M.getFunction() {
        F;
    } else {
        return F;
    }
    let mut Thunk: *mut Function = Create(X64Ty, LinkOnceODRLinkage, 0, self.M);
    Thunk.setCallingConv(ARM64EC_Thunk_X64);
    Thunk.setSection;
    Thunk.setComdat(self.M.getOrInsertComdat());
    Thunk.addFnAttr("frame-pointer", "all");
    let mut BB: *mut BasicBlock = Create(self.M.getContext(), "", Thunk, null);
    let mut IRB: i32 = BB;
    let mut RetTy: *mut Type = Arm64Ty.getReturnType();
    let mut X64RetType: *mut Type = X64Ty.getReturnType();
    let mut TransformDirectToSRet: bool = X64RetType.isVoidTy() && !RetTy.isVoidTy();
    let mut ThunkArgOffset: u32 = if TransformDirectToSRet { 2 } else { 1 };
    let mut PassthroughArgSize: u32 = (if F.isVarArg() { 5 } else { Thunk.arg_size() }) - ThunkArgOffset;
    (((operator!(operator!((ArgTranslations()() == (if F.isVarArg() { 5 } else { PassthroughArgSize }))))) || (_wassert(L"ArgTranslations.size() == (F->isVarArg() ? 5 : PassthroughArgSize)", L"llvm\\lib\\Target\\AArch64\\AArch64Arm64ECCallLowering.cpp", (575) as u32) , 0)) as void);
    let mut Args: i32 = 0;
    for let mut i: u32 = 0; i != PassthroughArgSize; i += 1 {
        let mut Arg: *mut Value = Thunk.getArg(i + ThunkArgOffset);
        let mut ArgTy: *mut Type = Arm64Ty.getParamType(i);
        let mut ArgTranslation: ThunkArgTranslation = [i];
        if ArgTranslation != Direct {
            if ArgTranslation == Bitcast {
                let mut CastAlloca: *mut Value = (ArgTy);
                IRB()(Arg, CastAlloca);
                Arg = (ArgTy, CastAlloca);
            } else {
                assert!(ArgTranslation == PointerIndirection);
                Arg = (ArgTy, Arg);
            }
        }
        assert!(Arg.getType() == ArgTy);
        Args()(Arg);
    }
    if F.isVarArg() {
        Thunk.addParamAttr(5, InReg);
        let mut Arg: *mut Value = Thunk.getArg(5);
        Arg = (Arg, (32));
        Args()(Arg);
        Args()((0));
    }
    let mut Callee: *mut Value = Thunk.getArg(0);
    let mut Call: *mut CallInst = (Arm64Ty, Callee);
    let mut SRetAttr: Attribute = F.getAttributes().getParamAttr(0, StructRet);
    let mut InRegAttr: Attribute = F.getAttributes().getParamAttr(0, InReg);
    if SRetAttr.isValid() && !InRegAttr.isValid() {
        Thunk.addParamAttr(1, SRetAttr);
        Call;
    }
    let mut RetVal: *mut Value = Call();
    if TransformDirectToSRet {
        Thunk.addParamAttr(1, getWithStructRetType(self.M.getContext(), RetTy));
        IRB()(RetVal, Thunk.getArg(1));
    } else if X64RetType != RetTy {
        let mut CastAlloca: *mut Value = (X64RetType);
        IRB()(Call, CastAlloca);
        RetVal = (X64RetType, CastAlloca);
    }
    if X64RetType.isVoidTy() {
        IRB()();
    } else {
        IRB()(RetVal);
    }
    return Thunk;
}

fn getArm64ECMangledFunctionName(GV: *mut GlobalValue) -> string> {
    if !GV.hasName() {
        GV.setName("__unnamed");
    }
    return getArm64ECMangledFunctionName(GV.getName());
}

fn AArch64Arm64ECCallLowering::buildGuestExitThunk(self, F: *mut Function) -> *mut Function {
    let mut NullThunkName: raw_null_ostream = raw_null_ostream {};
    let mut Arm64Ty: *mut FunctionType = null;
    let mut X64Ty: *mut FunctionType = null;
    let mut ArgTranslations: i32 = 0;
    let mut MangledName: auto = getArm64ECMangledFunctionName(*F);
    (((operator!(operator!((MangledName() && "Can't guest exit to function that's already native")))) || (_wassert(L"MangledName && \"Can't guest exit to function that's already native\"", L"llvm\\lib\\Target\\AArch64\\AArch64Arm64ECCallLowering.cpp", (671) as u32) , 0)) as void);
    let mut ThunkName: str = operator*();
    if ThunkName[0] == '?' && ThunkName.find != npos {
        ThunkName.insert(ThunkName.find, "$exit_thunk");
    } else {
        ThunkName.append("$exit_thunk");
    }
    let mut GuestExit: *mut Function = Create(Arm64Ty, WeakODRLinkage, 0, ThunkName, self.M);
    GuestExit.setComdat;
    GuestExit.setSection;
    GuestExit("arm64ec_unmangled_name", operator*(get(self.M.getContext(), get(self.M.getContext(), F.getName))));
    GuestExit("arm64ec_ecmangled_name", get(self.M.getContext(), get(self.M.getContext(), operator*())));
    F("arm64ec_hasguestexit", get(self.M.getContext(), void {}));
    let mut BB: *mut BasicBlock = Create(self.M.getContext(), "", GuestExit, null);
    let mut B: i32 = BB;
    let mut GuardCheckLoad: *mut LoadInst = (self.PtrTy, self.GuardFnGlobal);
    let mut Thunk: *mut Function = self.buildExitThunk(F.getFunctionType(), F.getAttributes());
    let mut GuardCheck: *mut CallInst = (self.GuardFnType, GuardCheckLoad, void { F, Thunk });
    let mut GuardCheckDest: *mut Value = (GuardCheck, 0);
    let mut GuardFinalDest: *mut Value = (GuardCheck, 1);
    GuardCheck.setCallingConv;
    let mut Args: i32 = make_pointer_range(GuestExit()());
    let mut OB: OperandBundleDef = zeroed();
    let mut Call: *mut CallInst = (Arm64Ty, GuardCheckDest);
    Call.setTailCallKind(TCK_MustTail);
    if Call.getType() {
        B()();
    } else {
        B()(Call);
    }
    let mut SRetAttr: Attribute = F.getAttributes().getParamAttr(0, StructRet);
    let mut InRegAttr: Attribute = F.getAttributes().getParamAttr(0, InReg);
    if SRetAttr.isValid() && !InRegAttr.isValid() {
        GuestExit.addParamAttr(0, SRetAttr);
        Call;
    }
    return GuestExit;
}

fn AArch64Arm64ECCallLowering::buildPatchableThunk(self, UnmangledAlias: *mut GlobalAlias, MangledAlias: *mut GlobalAlias) -> *mut Function {
    let mut NullThunkName: raw_null_ostream = raw_null_ostream {};
    let mut Arm64Ty: *mut FunctionType = null;
    let mut X64Ty: *mut FunctionType = null;
    let mut F: *mut Function = cast(MangledAlias.getAliasee());
    let mut ArgTranslations: i32 = 0;
    let mut ThunkName: str = MangledAlias.getName;
    if ThunkName[0] == '?' && ThunkName.find != npos {
        ThunkName.insert(ThunkName.find, "$hybpatch_thunk");
    } else {
        ThunkName.append("$hybpatch_thunk");
    }
    let mut GuestExit: *mut Function = Create(Arm64Ty, WeakODRLinkage, 0, ThunkName, self.M);
    GuestExit.setComdat;
    GuestExit.setSection;
    let mut BB: *mut BasicBlock = Create(self.M.getContext(), "", GuestExit, null);
    let mut B: i32 = BB;
    let mut DispatchLoad: *mut LoadInst = (self.PtrTy, self.DispatchFnGlobal);
    let mut ExitThunk: *mut Function = self.buildExitThunk(F.getFunctionType(), F.getAttributes());
    let mut Dispatch: *mut CallInst = (self.DispatchFnType, DispatchLoad, void { UnmangledAlias, ExitThunk, UnmangledAlias.getAliasee() });
    Dispatch.setCallingConv;
    let mut Args: i32 = make_pointer_range(GuestExit()());
    let mut Call: *mut CallInst = (Arm64Ty, Dispatch);
    Call.setTailCallKind(TCK_MustTail);
    if Call.getType() {
        B()();
    } else {
        B()(Call);
    }
    let mut SRetAttr: auto = F.getAttributes().getParamAttr(0, StructRet);
    let mut InRegAttr: auto = F.getAttributes().getParamAttr(0, InReg);
    if SRetAttr()() && operator!() {
        GuestExit(0);
        Call(0);
    }
    MangledAlias.setAliasee;
    return GuestExit;
}

fn AArch64Arm64ECCallLowering::lowerCall(self, CB: *mut CallBase) {
    let mut B: i32 = CB;
    let mut CalledOperand: *mut Value = CB.getCalledOperand();
    let mut Bundles: OperandBundleDef, 1> = zeroed();
    if  {
        Bundles()(operator*());
    }
    let mut GuardFn: *mut Value = null;
    if (self.CFGuardModuleFlag == Enabled) && !CB.hasFnAttr("guard_nocf") {
        GuardFn = self.GuardFnCFGlobal;
    } else {
        GuardFn = self.GuardFnGlobal;
    }
    let mut GuardCheckLoad: *mut LoadInst = (self.PtrTy, GuardFn);
    let mut Thunk: *mut Function = self.buildExitThunk(CB.getFunctionType(), CB.getAttributes());
    let mut GuardCheck: *mut CallInst = (self.GuardFnType, GuardCheckLoad, void { CalledOperand, Thunk });
    let mut GuardCheckDest: *mut Value = (GuardCheck, 0);
    let mut GuardFinalDest: *mut Value = (GuardCheck, 1);
    GuardCheck.setCallingConv;
    CB.setCalledOperand(GuardCheckDest);
    let mut OB: OperandBundleDef = zeroed();
    let mut NewCall: *mut auto = addOperandBundle(CB, OB_cfguardtarget, CB()());
    NewCall()(*CB);
    CB.replaceAllUsesWith();
    CB()();
}

fn AArch64Arm64ECCallLowering::runOnModule(self, Mod: *mut Module) -> bool {
    if operator!() {
        return false;
    }
    self.M = &mut Mod;
    self.CFGuardModuleFlag = self.M.getControlFlowGuardMode();
    if self.CFGuardModuleFlag == Enabled {
        if  {
            let mut MechanismOverride: auto = () as ControlFlowGuardMechanism;
            if MechanismOverride() != Automatic &&  != Check {
                Mod.getContext().diagnose(DiagnosticInfoGeneric { "only the Check Control Flow Guard mechanism is supported for Arm64EC", DS_Warning });
            }
        }
    }
    self.PtrTy = getUnqual(self.M.getContext());
    self.I64Ty = getInt64Ty(self.M.getContext());
    self.VoidTy = getVoidTy(self.M.getContext());
    self.GuardFnType = get(get(self.PtrTy, self.PtrTy), void { self.PtrTy, self.PtrTy }, false);
    self.DispatchFnType = get(self.PtrTy, void { self.PtrTy, self.PtrTy, self.PtrTy }, false);
    self.GuardFnCFGlobal;
    self.GuardFnGlobal;
    self.DispatchFnGlobal;
    let mut FnsMap: i32 = 0;
    let mut PatchableFns: i32 = 0;
    let mut DirectCalledFns: i32 = 0;
    let mut ThunkMapping: i32 = 0;
    if operator!() {
        let mut ThunkMappingArrayElems: i32 = 0;
        let mut ThunkMappingArray: *mut Constant = get(get([0]()));
        GlobalVariable { Mod, ThunkMappingArray.getType(), false, ExternalLinkage, ThunkMappingArray, "llvm.arm64ec.symbolmap", null, NotThreadLocal, nullopt(), false };
    }
    return true;
}

fn AArch64Arm64ECCallLowering::processFunction(self, F: *mut Function, DirectCalledFns: *mut i32, FnsMap: *mut i32) -> bool {
    let mut IndirectCalls: SmallVector<CallBase *, 8> = zeroed();
    if operator!(F.hasLocalLinkage) || F.hasAddressTaken(null, false, true, false, false, false) {
        if  {
            F("arm64ec_unmangled_name", operator*(get(self.M.getContext(), get(self.M.getContext(), F.getName))));
            if F.hasComdat && F() == F.getName {
                let mut MangledComdat: *mut Comdat = self.M.getOrInsertComdat();
                let mut ComdatUsers: i32 = to_vector(F());
            }
            F.setName();
        }
    }
    if IndirectCalls()() {
        return false;
    }
    return true;
}

static mut ID: i8 = 0;

fn createAArch64Arm64ECCallLoweringPass() -> *mut ModulePass {
    return AArch64Arm64ECCallLowering {};
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, T: *mut Type) -> ThunkArgInfo {
        return ThunkArgInfo { Arm64Ty: T, X64Ty: T, Translation: Direct };
    }

struct Closure_2 {
    cap_0: *mut AArch64Arm64ECCallLowering,
}

fn Closure_2::call(self: *Closure_2, Arm64Ty: *mut Type, SizeInBytes: u64) -> ThunkArgInfo {
        return ThunkArgInfo { Arm64Ty: Arm64Ty, X64Ty: getIntNTy(self.M.getContext(), SizeInBytes * 8), Translation: Bitcast };
    }

struct Closure_3 {
    cap_0: *mut AArch64Arm64ECCallLowering,
}

fn Closure_3::call(self: *Closure_3, Arm64Ty: *mut Type) -> ThunkArgInfo {
        return ThunkArgInfo { Arm64Ty: Arm64Ty, X64Ty: self.PtrTy, Translation: PointerIndirection };
    }
