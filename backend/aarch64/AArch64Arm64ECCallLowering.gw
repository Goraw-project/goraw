static mut Arm64ECCallsLowered: Statistic = Statistic { "arm64eccalllowering", "Arm64ECCallsLowered", "Number of Arm64EC calls lowered" };

static mut LowerDirectToIndirect: opt<bool> = opt<bool> { "arm64ec-lower-direct-to-indirect", Hidden, init(true) };

static mut GenerateThunks: opt<bool> = opt<bool> { "arm64ec-generate-thunks", Hidden, init(true) };

enum ThunkArgTranslation {
    Direct = 0,
    Bitcast = 1,
    PointerIndirection = 2,
}

struct ThunkArgInfo {
    Arm64Ty: *mut Type,
    X64Ty: *mut Type,
    Translation: ThunkArgTranslation,
}

struct AArch64Arm64ECCallLowering {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    CFGuardModuleFlag: ControlFlowGuardMode,
    GuardFnType: *mut FunctionType,
    DispatchFnType: *mut FunctionType,
    GuardFnCFGlobal: *mut Constant,
    GuardFnGlobal: *mut Constant,
    DispatchFnGlobal: *mut Constant,
    M: *mut Module,
    PtrTy: *mut Type,
    I64Ty: *mut Type,
    VoidTy: *mut Type,
}

fn AArch64Arm64ECCallLowering::getPassKind(self: *AArch64Arm64ECCallLowering) -> PassKind {
    return self.Kind;
}

fn AArch64Arm64ECCallLowering::getPassID(self: *AArch64Arm64ECCallLowering) -> AnalysisID {
    return self.PassID;
}

fn AArch64Arm64ECCallLowering::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64Arm64ECCallLowering::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64Arm64ECCallLowering::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64Arm64ECCallLowering::getResolver(self: *AArch64Arm64ECCallLowering) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64Arm64ECCallLowering::getThunkType(self, FT: *mut FunctionType, AttrList: AttributeList, TT: Arm64ECThunkType, Out: *mut raw_ostream, Arm64Ty: *mut *mut FunctionType, X64Ty: *mut *mut FunctionType, ArgTranslations: *mut SmallVector<ThunkArgTranslation>) {
    Out << (if TT == Entry { "$ientry_thunk$cdecl$" } else { "$iexit_thunk$cdecl$" });
    let mut Arm64RetTy: *mut Type = null;
    let mut X64RetTy: *mut Type = null;
    let mut Arm64ArgTypes: SmallVector<Type *> = SmallVector<Type *> {};
    let mut X64ArgTypes: SmallVector<Type *> = SmallVector<Type *> {};
    if TT == Exit {
        Arm64ArgTypes.push(self.PtrTy);
    }
    X64ArgTypes.push(self.PtrTy);
    let mut HasSretPtr: bool = false;
    self.getThunkRetType(FT, AttrList, Out, Arm64RetTy, X64RetTy, Arm64ArgTypes, X64ArgTypes, ArgTranslations, HasSretPtr);
    self.getThunkArgTypes(FT, AttrList, TT, Out, Arm64ArgTypes, X64ArgTypes, ArgTranslations, HasSretPtr);
    Arm64Ty = get(Arm64RetTy, Arm64ArgTypes, false);
    X64Ty = get(X64RetTy, X64ArgTypes, false);
}

fn AArch64Arm64ECCallLowering::getThunkArgTypes(self, FT: *mut FunctionType, AttrList: AttributeList, TT: Arm64ECThunkType, Out: *mut raw_ostream, Arm64ArgTypes: *mut SmallVectorImpl<Type *>, X64ArgTypes: *mut SmallVectorImpl<Type *>, ArgTranslations: *mut SmallVectorImpl<ThunkArgTranslation>, HasSretPtr: bool) {
    Out << "$";
    if FT.isVarArg() {
        Out << "varargs";
        for let mut i: i32 = if HasSretPtr { 1 } else { 0 }; i < 4; i += 1 {
            Arm64ArgTypes.push(self.I64Ty);
            X64ArgTypes.push(self.I64Ty);
            ArgTranslations.push(Direct);
        }
        Arm64ArgTypes.push(self.PtrTy);
        X64ArgTypes.push(self.PtrTy);
        ArgTranslations.push(Direct);
        Arm64ArgTypes.push(self.I64Ty);
        if TT != Entry {
            X64ArgTypes.push(self.I64Ty);
            ArgTranslations.push(Direct);
        }
        return;
    }
    let mut I: u32 = 0;
    if HasSretPtr {
        I += 1;
    }
    if I == FT.getNumParams() {
        Out << "v";
        return;
    }
    for let mut E: u32 = FT.getNumParams(); I != E; I += 1 {
        let mut ArgSizeBytes: u64 = 0;
        let mut ParamAlign: Align = Align {};
        Arm64ArgTypes.push(Arm64Ty);
        X64ArgTypes.push(X64Ty);
        ArgTranslations.push(ArgTranslation);
    }
}

fn AArch64Arm64ECCallLowering::getThunkRetType(self, FT: *mut FunctionType, AttrList: AttributeList, Out: *mut raw_ostream, Arm64RetTy: *mut *mut Type, X64RetTy: *mut *mut Type, Arm64ArgTypes: *mut SmallVectorImpl<Type *>, X64ArgTypes: *mut SmallVectorImpl<Type *>, ArgTranslations: *mut SmallVector<ThunkArgTranslation>, HasSretPtr: *mut bool) {
    let mut T: *mut Type = FT.getReturnType();
    let mut ArgSizeBytes: i64 = 0;
    if T.isVoidTy() {
        if FT.getNumParams() {
            let mut SRetAttr0: Attribute = AttrList.getParamAttr(0, StructRet);
            let mut InRegAttr0: Attribute = AttrList.getParamAttr(0, InReg);
            let mut SRetAttr1: Attribute = Attribute {};
            let mut InRegAttr1: Attribute = Attribute {};
            if FT.getNumParams() > 1 {
                SRetAttr1 = AttrList.getParamAttr(1, StructRet);
                InRegAttr1 = AttrList.getParamAttr(1, InReg);
            }
            if (SRetAttr0.isValid() && InRegAttr0.isValid()) || (SRetAttr1.isValid() && InRegAttr1.isValid()) {
                Out << "i8";
                Arm64RetTy = self.I64Ty;
                X64RetTy = self.I64Ty;
                return;
            }
            if SRetAttr0.isValid() {
                let mut SRetType: *mut Type = SRetAttr0.getValueAsType();
                let mut SRetAlign: Align = AttrList.getParamAlignment(0).valueOrOne();
                self.canonicalizeThunkType(SRetType, SRetAlign, true, ArgSizeBytes, Out);
                Arm64RetTy = self.VoidTy;
                X64RetTy = self.VoidTy;
                Arm64ArgTypes.push(FT.getParamType(0));
                X64ArgTypes.push(FT.getParamType(0));
                ArgTranslations.push(Direct);
                HasSretPtr = true;
                return;
            }
        }
        Out << "v";
        Arm64RetTy = self.VoidTy;
        X64RetTy = self.VoidTy;
        return;
    }
    let mut info: ThunkArgInfo = self.canonicalizeThunkType(T, Align {}, true, ArgSizeBytes, Out);
    Arm64RetTy = info.Arm64Ty;
    X64RetTy = info.X64Ty;
    if X64RetTy.isPointerTy() {
        X64ArgTypes.push(X64RetTy);
        X64RetTy = self.VoidTy;
    }
}

fn AArch64Arm64ECCallLowering::canonicalizeThunkType(self, T: *mut Type, Alignment: Align, Ret: bool, ArgSizeBytes: u64, Out: *mut raw_ostream) -> ThunkArgInfo {
    let mut direct: Closure_1 = Closure_1 {};
    let mut bitcast: Closure_2 = Closure_2 { cap_0: self };
    let mut pointerIndirection: Closure_3 = Closure_3 { cap_0: self };
    if T.isHalfTy() {
        Out << "__llvm_h__";
        return direct.call(T);
    }
    if T.isBFloatTy() {
        Out << "__llvm_bf16__";
        return direct.call(T);
    }
    if T.isFloatTy() {
        Out << "f";
        return direct.call(T);
    }
    if T.isDoubleTy() {
        Out << "d";
        return direct.call(T);
    }
    if T.isFP128Ty() {
        Out << "__llvm_q__";
        return pointerIndirection.call(T);
    }
    if T.isFloatingPointTy() {
        report_fatal_error("Only half, bfloat16, float, double, and fp128 are supported for ARM64EC thunks", true);
    }
    let mut DL: *DataLayout = self.M.getDataLayout();
    if dyn_cast(T) {
        StructTy;
    } else if StructTy.getNumElements() == 1 {
        T = StructTy.getElementType(0);
    }
    if T.isArrayTy() {
        let mut ElementTy: *mut Type = T.getArrayElementType();
        let mut ElementCnt: u64 = T.getArrayNumElements();
        let mut ElementSizePerBytes: u64 = DL.getTypeSizeInBits(ElementTy).operator unsigned long long() / 8;
        let mut TotalSizeBytes: u64 = ElementCnt * ElementSizePerBytes;
        if ElementTy.isHalfTy() || ElementTy.isBFloatTy() || ElementTy.isFloatTy() || ElementTy.isDoubleTy() || ElementTy.isFP128Ty() {
            if ElementTy.isHalfTy() {
                Out << "__llvm_H__";
            } else if ElementTy.isBFloatTy() {
                Out << "__llvm_BF16__";
            } else if ElementTy.isFloatTy() {
                Out << "F";
            } else if ElementTy.isDoubleTy() {
                Out << "D";
            } else if ElementTy.isFP128Ty() {
                Out << "__llvm_Q__";
            }
            Out << TotalSizeBytes;
            if Alignment.value() >= 16 && !Ret {
                Out << "a" << Alignment.value();
            }
            if TotalSizeBytes <= 8 {
                return bitcast.call(T, TotalSizeBytes);
            } else {
                return pointerIndirection.call(T);
            }
        } else if ElementTy.isFloatingPointTy() {
            report_fatal_error("Only half, bfloat16, float, double, and fp128 are supported for ARM64EC thunks", true);
        }
    }
    if (T.isIntegerTy() || T.isPointerTy()) && DL.getTypeSizeInBits(T).operator unsigned long long() <= 64 {
        Out << "i8";
        return direct.call(self.I64Ty);
    }
    let mut TypeSize: u32 = ArgSizeBytes;
    if TypeSize == 0 {
        TypeSize = DL.getTypeSizeInBits(T).operator unsigned long long() / 8;
    }
    Out << "m";
    if TypeSize != 4 {
        Out << TypeSize;
    }
    if Alignment.value() >= 16 && !Ret {
        Out << "a" << Alignment.value();
    }
    if TypeSize == 1 || TypeSize == 2 || TypeSize == 4 || TypeSize == 8 {
        return bitcast.call(T, TypeSize);
    } else {
        return pointerIndirection.call(T);
    }
}

fn AArch64Arm64ECCallLowering::buildExitThunk(self, FT: *mut FunctionType, Attrs: AttributeList) -> *mut Function {
    let mut ExitThunkName: str = "";
    let mut ExitThunkStream: raw_svector_ostream = ExitThunkName;
    let mut Arm64Ty: *mut FunctionType = null;
    let mut X64Ty: *mut FunctionType = null;
    let mut ArgTranslations: SmallVector<ThunkArgTranslation> = SmallVector<ThunkArgTranslation> {};
    self.getThunkType(FT, Attrs, Exit, ExitThunkStream, Arm64Ty, X64Ty, ArgTranslations);
    if self.M.getFunction(ExitThunkName.operator StringRef()) {
        F;
    } else {
        return F;
    }
    let mut F: *mut Function = Create(Arm64Ty, LinkOnceODRLinkage, 0, ExitThunkName, self.M);
    F.setCallingConv(ARM64EC_Thunk_Native);
    F.setSection(".wowthk$aa");
    F.setComdat(self.M.getOrInsertComdat(ExitThunkName.operator StringRef()));
    F.addFnAttr("frame-pointer", "all");
    if FT.getNumParams() {
        let mut SRet: Attribute = Attrs.getParamAttr(0, StructRet);
        let mut InReg: Attribute = Attrs.getParamAttr(0, InReg);
        if SRet.isValid() && !InReg.isValid() {
            F.addParamAttr(1, SRet);
        }
    }
    let mut BB: *mut BasicBlock = Create(self.M.getContext(), "", F, null);
    let mut IRB: IRBuilder<> = BB;
    let mut CalleePtr: *mut Value = self.M.getOrInsertGlobal("__os_arm64x_dispatch_call_no_redirect", self.PtrTy);
    let mut Callee: *mut Value = IRB.CreateLoad(self.PtrTy, CalleePtr, "");
    let mut DL: *DataLayout = self.M.getDataLayout();
    let mut Args: SmallVector<Value *> = SmallVector<Value *> {};
    let mut DispatcherCallTy: *mut FunctionType = X64Ty;
    if FT.isVarArg() {
        DispatcherCallTy = get(X64Ty.getReturnType(), X64Ty.params(), true);
    }
    let mut X64TyOffset: i32 = 1;
    Args.push(F.arg_begin());
    let mut RetTy: *mut Type = Arm64Ty.getReturnType();
    if RetTy != X64Ty.getReturnType() {
        if DL.getTypeStoreSize(RetTy).operator unsigned long long() > 8 {
            Args.push(IRB.CreateAlloca(RetTy, null, ""));
            X64TyOffset += 1;
        }
    }
    for x in zip_equal(make_range(F.arg_begin() + 1, F.arg_end()), make_range(X64Ty.param_begin() + X64TyOffset, X64Ty.param_end()), ArgTranslations) {
        if ArgTranslation != Direct {
            let mut Mem: *mut Value = IRB.CreateAlloca(Arg.getType(), null, "");
            IRB.CreateStore(&mut Arg, Mem, false);
            if ArgTranslation == Bitcast {
                let mut IntTy: *mut Type = IRB.getIntNTy(DL.getTypeStoreSizeInBits(Arg.getType()).operator unsigned long long());
                Args.push(IRB.CreateLoad(IntTy, Mem, ""));
            } else {
                assert!(ArgTranslation == PointerIndirection);
                Args.push(Mem);
            }
        } else {
            Args.push(&mut Arg);
        }
        assert!(Args.back().getType() == X64ArgType);
    }
    let mut Call: *mut CallInst = IRB.CreateCall(DispatcherCallTy, Callee, Args, "", null);
    Call.setCallingConv(ARM64EC_Thunk_X64);
    let mut RetVal: *mut Value = Call;
    if RetTy != X64Ty.getReturnType() {
        if DL.getTypeStoreSize(RetTy).operator unsigned long long() > 8 {
            RetVal = IRB.CreateLoad(RetTy, Args[1], "");
        } else {
            let mut CastAlloca: *mut Value = IRB.CreateAlloca(RetTy, null, "");
            IRB.CreateStore(Call, CastAlloca, false);
            RetVal = IRB.CreateLoad(RetTy, CastAlloca, "");
        }
    }
    if RetTy.isVoidTy() {
        IRB.CreateRetVoid();
    } else {
        IRB.CreateRet(RetVal);
    }
    return F;
}

fn AArch64Arm64ECCallLowering::buildEntryThunk(self, F: *mut Function) -> *mut Function {
    let mut EntryThunkName: str = "";
    let mut EntryThunkStream: raw_svector_ostream = EntryThunkName;
    let mut Arm64Ty: *mut FunctionType = null;
    let mut X64Ty: *mut FunctionType = null;
    let mut ArgTranslations: SmallVector<ThunkArgTranslation> = SmallVector<ThunkArgTranslation> {};
    self.getThunkType(F.getFunctionType(), F.getAttributes(), Entry, EntryThunkStream, Arm64Ty, X64Ty, ArgTranslations);
    if self.M.getFunction(EntryThunkName.operator StringRef()) {
        F;
    } else {
        return F;
    }
    let mut Thunk: *mut Function = Create(X64Ty, LinkOnceODRLinkage, 0, EntryThunkName, self.M);
    Thunk.setCallingConv(ARM64EC_Thunk_X64);
    Thunk.setSection(".wowthk$aa");
    Thunk.setComdat(self.M.getOrInsertComdat(EntryThunkName.operator StringRef()));
    Thunk.addFnAttr("frame-pointer", "all");
    let mut BB: *mut BasicBlock = Create(self.M.getContext(), "", Thunk, null);
    let mut IRB: IRBuilder<> = BB;
    let mut RetTy: *mut Type = Arm64Ty.getReturnType();
    let mut X64RetType: *mut Type = X64Ty.getReturnType();
    let mut TransformDirectToSRet: bool = X64RetType.isVoidTy() && !RetTy.isVoidTy();
    let mut ThunkArgOffset: u32 = if TransformDirectToSRet { 2 } else { 1 };
    let mut PassthroughArgSize: u32 = (if F.isVarArg() { 5 } else { Thunk.arg_size() }) - ThunkArgOffset;
    assert!(ArgTranslations.len == (if F.isVarArg() { 5 } else { PassthroughArgSize });
    let mut Args: SmallVector<Value *> = SmallVector<Value *> {};
    for let mut i: u32 = 0; i != PassthroughArgSize; i += 1 {
        let mut Arg: *mut Value = Thunk.getArg(i + ThunkArgOffset);
        let mut ArgTy: *mut Type = Arm64Ty.getParamType(i);
        let mut ArgTranslation: ThunkArgTranslation = ArgTranslations[i];
        if ArgTranslation != Direct {
            if ArgTranslation == Bitcast {
                let mut CastAlloca: *mut Value = IRB.CreateAlloca(ArgTy, null, "");
                IRB.CreateStore(Arg, CastAlloca, false);
                Arg = IRB.CreateLoad(ArgTy, CastAlloca, "");
            } else {
                assert!(ArgTranslation == PointerIndirection);
                Arg = IRB.CreateLoad(ArgTy, Arg, "");
            }
        }
        assert!(Arg.getType() == ArgTy);
        Args.push(Arg);
    }
    if F.isVarArg() {
        Thunk.addParamAttr(5, InReg);
        let mut Arg: *mut Value = Thunk.getArg(5);
        Arg = IRB.CreatePtrAdd(Arg, IRB.getInt64(32), "", none());
        Args.push(Arg);
        Args.push(IRB.getInt64(0));
    }
    let mut Callee: *mut Value = Thunk.getArg(0);
    let mut Call: *mut CallInst = IRB.CreateCall(Arm64Ty, Callee, Args, "", null);
    let mut SRetAttr: Attribute = F.getAttributes().getParamAttr(0, StructRet);
    let mut InRegAttr: Attribute = F.getAttributes().getParamAttr(0, InReg);
    if SRetAttr.isValid() && !InRegAttr.isValid() {
        Thunk.addParamAttr(1, SRetAttr);
        Call.addParamAttr(0, SRetAttr);
    }
    let mut RetVal: *mut Value = Call;
    if TransformDirectToSRet {
        Thunk.addParamAttr(1, getWithStructRetType(self.M.getContext(), RetTy));
        IRB.CreateStore(RetVal, Thunk.getArg(1), false);
    } else if X64RetType != RetTy {
        let mut CastAlloca: *mut Value = IRB.CreateAlloca(X64RetType, null, "");
        IRB.CreateStore(Call, CastAlloca, false);
        RetVal = IRB.CreateLoad(X64RetType, CastAlloca, "");
    }
    if X64RetType.isVoidTy() {
        IRB.CreateRetVoid();
    } else {
        IRB.CreateRet(RetVal);
    }
    return Thunk;
}

fn getArm64ECMangledFunctionName(GV: *mut GlobalValue) -> string> {
    if !GV.hasName() {
        GV.setName("__unnamed");
    }
    return getArm64ECMangledFunctionName(GV.getName());
}

fn AArch64Arm64ECCallLowering::buildGuestExitThunk(self, F: *mut Function) -> *mut Function {
    let mut NullThunkName: raw_null_ostream = raw_null_ostream {};
    let mut Arm64Ty: *mut FunctionType = null;
    let mut X64Ty: *mut FunctionType = null;
    let mut ArgTranslations: SmallVector<ThunkArgTranslation> = SmallVector<ThunkArgTranslation> {};
    self.getThunkType(F.getFunctionType(), F.getAttributes(), GuestExit, NullThunkName, Arm64Ty, X64Ty, ArgTranslations);
    let mut MangledName: string> = getArm64ECMangledFunctionName(*F);
    assert!(MangledName, "Can't guest exit to function that's already native");
    let mut ThunkName: str = operator(MangledName);
    if ThunkName[0] == '?' && ThunkName.find("@", 0) != npos {
        ThunkName.insert(ThunkName.find("@", 0), "$exit_thunk");
    } else {
        ThunkName.append("$exit_thunk");
    }
    let mut GuestExit: *mut Function = Create(Arm64Ty, WeakODRLinkage, 0, ThunkName, self.M);
    GuestExit.setComdat(self.M.getOrInsertComdat(ThunkName));
    GuestExit.setSection(".wowthk$aa");
    GuestExit.addMetadata("arm64ec_unmangled_name", *get(self.M.getContext(), get(self.M.getContext(), F.getName())));
    GuestExit.setMetadata("arm64ec_ecmangled_name", get(self.M.getContext(), get(self.M.getContext(), operator(MangledName))));
    F.setMetadata("arm64ec_hasguestexit", get(self.M.getContext(), ArrayRef<Metadata *> {}));
    let mut BB: *mut BasicBlock = Create(self.M.getContext(), "", GuestExit, null);
    let mut B: IRBuilder<> = BB;
    let mut GuardCheckLoad: *mut LoadInst = B.CreateLoad(self.PtrTy, self.GuardFnGlobal, "");
    let mut Thunk: *mut Function = self.buildExitThunk(F.getFunctionType(), F.getAttributes());
    let mut GuardCheck: *mut CallInst = B.CreateCall(self.GuardFnType, GuardCheckLoad, [F, Thunk], "", null);
    let mut GuardCheckDest: *mut Value = B.CreateExtractValue(GuardCheck, 0, "");
    let mut GuardFinalDest: *mut Value = B.CreateExtractValue(GuardCheck, 1, "");
    GuardCheck.setCallingConv(CFGuard_Check);
    let mut Args: SmallVector<Value *> = make_pointer_range(GuestExit.args());
    let mut OB: OperandBundleDef = OperandBundleDef { "cfguardtarget", GuardFinalDest };
    let mut Call: *mut CallInst = B.CreateCall(Arm64Ty, GuardCheckDest, Args, OB, "", null);
    Call.setTailCallKind(TCK_MustTail);
    if Call.getType().isVoidTy() {
        B.CreateRetVoid();
    } else {
        B.CreateRet(Call);
    }
    let mut SRetAttr: Attribute = F.getAttributes().getParamAttr(0, StructRet);
    let mut InRegAttr: Attribute = F.getAttributes().getParamAttr(0, InReg);
    if SRetAttr.isValid() && !InRegAttr.isValid() {
        GuestExit.addParamAttr(0, SRetAttr);
        Call.addParamAttr(0, SRetAttr);
    }
    return GuestExit;
}

fn AArch64Arm64ECCallLowering::buildPatchableThunk(self, UnmangledAlias: *mut GlobalAlias, MangledAlias: *mut GlobalAlias) -> *mut Function {
    let mut NullThunkName: raw_null_ostream = raw_null_ostream {};
    let mut Arm64Ty: *mut FunctionType = null;
    let mut X64Ty: *mut FunctionType = null;
    let mut F: *mut Function = cast(MangledAlias.getAliasee());
    let mut ArgTranslations: SmallVector<ThunkArgTranslation> = SmallVector<ThunkArgTranslation> {};
    self.getThunkType(F.getFunctionType(), F.getAttributes(), GuestExit, NullThunkName, Arm64Ty, X64Ty, ArgTranslations);
    let mut ThunkName: str = MangledAlias.getName()[0..allocator<char> {}];
    if ThunkName[0] == '?' && ThunkName.find("@", 0) != npos {
        ThunkName.insert(ThunkName.find("@", 0), "$hybpatch_thunk");
    } else {
        ThunkName.append("$hybpatch_thunk");
    }
    let mut GuestExit: *mut Function = Create(Arm64Ty, WeakODRLinkage, 0, ThunkName, self.M);
    GuestExit.setComdat(self.M.getOrInsertComdat(ThunkName));
    GuestExit.setSection(".wowthk$aa");
    let mut BB: *mut BasicBlock = Create(self.M.getContext(), "", GuestExit, null);
    let mut B: IRBuilder<> = BB;
    let mut DispatchLoad: *mut LoadInst = B.CreateLoad(self.PtrTy, self.DispatchFnGlobal, "");
    let mut ExitThunk: *mut Function = self.buildExitThunk(F.getFunctionType(), F.getAttributes());
    let mut Dispatch: *mut CallInst = B.CreateCall(self.DispatchFnType, DispatchLoad, [UnmangledAlias, ExitThunk, UnmangledAlias.getAliasee()], "", null);
    Dispatch.setCallingConv(CFGuard_Check);
    let mut Args: SmallVector<Value *> = make_pointer_range(GuestExit.args());
    let mut Call: *mut CallInst = B.CreateCall(Arm64Ty, Dispatch, Args, "", null);
    Call.setTailCallKind(TCK_MustTail);
    if Call.getType().isVoidTy() {
        B.CreateRetVoid();
    } else {
        B.CreateRet(Call);
    }
    let mut SRetAttr: Attribute = F.getAttributes().getParamAttr(0, StructRet);
    let mut InRegAttr: Attribute = F.getAttributes().getParamAttr(0, InReg);
    if SRetAttr.isValid() && !InRegAttr.isValid() {
        GuestExit.addParamAttr(0, SRetAttr);
        Call.addParamAttr(0, SRetAttr);
    }
    MangledAlias.setAliasee(GuestExit);
    return GuestExit;
}

fn AArch64Arm64ECCallLowering::lowerCall(self, CB: *mut CallBase) {
    let mut B: IRBuilder<> = CB;
    let mut CalledOperand: *mut Value = CB.getCalledOperand();
    let mut Bundles: OperandBundleDef, 1> = OperandBundleDef, 1> {};
    if CB.getOperandBundle(OB_funclet) {
        Bundle;
    } else {
        Bundles.push(operator(Bundle));
    }
    let mut GuardFn: *mut Value = null;
    if (self.CFGuardModuleFlag == Enabled) && !CB.hasFnAttr("guard_nocf") {
        GuardFn = self.GuardFnCFGlobal;
    } else {
        GuardFn = self.GuardFnGlobal;
    }
    let mut GuardCheckLoad: *mut LoadInst = B.CreateLoad(self.PtrTy, GuardFn, "");
    let mut Thunk: *mut Function = self.buildExitThunk(CB.getFunctionType(), CB.getAttributes());
    let mut GuardCheck: *mut CallInst = B.CreateCall(self.GuardFnType, GuardCheckLoad, [CalledOperand, Thunk], Bundles, "", null);
    let mut GuardCheckDest: *mut Value = B.CreateExtractValue(GuardCheck, 0, "");
    let mut GuardFinalDest: *mut Value = B.CreateExtractValue(GuardCheck, 1, "");
    GuardCheck.setCallingConv(CFGuard_Check);
    CB.setCalledOperand(GuardCheckDest);
    let mut OB: OperandBundleDef = OperandBundleDef { "cfguardtarget", GuardFinalDest };
    let mut NewCall: *mut CallBase = addOperandBundle(CB, OB_cfguardtarget, OB, CB.getIterator());
    NewCall.copyMetadata(*CB, ArrayRef<unsigned int> {});
    CB.replaceAllUsesWith(NewCall);
    CB.eraseFromParent();
}

fn AArch64Arm64ECCallLowering::runOnModule(self, Mod: *mut Module) -> bool {
    if !GenerateThunks {
        return false;
    }
    self.M = &mut Mod;
    self.CFGuardModuleFlag = self.M.getControlFlowGuardMode();
    if self.CFGuardModuleFlag == Enabled {
        if dyn_extract_or_null(Mod.getModuleFlag("cfguard-mechanism")) {
            CI;
        } else {
            let mut MechanismOverride: ControlFlowGuardMechanism = CI.getZExtValue() as ControlFlowGuardMechanism;
            if MechanismOverride != Automatic && MechanismOverride != Check {
                Mod.getContext().diagnose(DiagnosticInfoGeneric { "only the Check Control Flow Guard mechanism is supported for Arm64EC", DS_Warning });
            }
        }
    }
    self.PtrTy = getUnqual(self.M.getContext());
    self.I64Ty = getInt64Ty(self.M.getContext());
    self.VoidTy = getVoidTy(self.M.getContext());
    self.GuardFnType = get(get(self.PtrTy, self.PtrTy), [self.PtrTy, self.PtrTy], false);
    self.DispatchFnType = get(self.PtrTy, [self.PtrTy, self.PtrTy, self.PtrTy], false);
    self.GuardFnCFGlobal = self.M.getOrInsertGlobal("__os_arm64x_check_icall_cfg", self.PtrTy);
    self.GuardFnGlobal = self.M.getOrInsertGlobal("__os_arm64x_check_icall", self.PtrTy);
    self.DispatchFnGlobal = self.M.getOrInsertGlobal("__os_arm64x_dispatch_call", self.PtrTy);
    for A in Mod.aliases() {
        let mut F: CastReturnType = dyn_cast_or_null(A.getAliaseeObject());
        if !F {
            continue;
        }
        if getArm64ECMangledFunctionName(A) {
            MangledName;
        } else {
            F.addMetadata("arm64ec_unmangled_name", *get(self.M.getContext(), get(self.M.getContext(), A.getName())));
            A.setName(MangledName.value());
        }
    }
    let mut FnsMap: DenseMap<GlobalAlias *, GlobalAlias *> = DenseMap<GlobalAlias *, GlobalAlias *> {};
    let mut PatchableFns: SetVector<GlobalAlias *> = SetVector<GlobalAlias *> {};
    for F in Mod {
        if F.hasPersonalityFn() {
            let mut PersFn: *mut GlobalValue = cast(F.getPersonalityFn().stripPointerCasts());
            if PersFn.getValueType() && PersFn.getValueType().isFunctionTy() {
                if getArm64ECMangledFunctionName(*PersFn) {
                    MangledName;
                } else {
                    PersFn.setName(MangledName.value());
                }
            }
        }
        if !F.hasFnAttribute(HybridPatchable) || F.isDeclarationForLinker() || F.hasLocalLinkage() || F.getName().ends_with(HybridPatchableTargetSuffix) {
            continue;
        }
        if getArm64ECMangledFunctionName(F) {
            MangledName;
        } else {
            let mut OrigName: str = F.getName()[0..allocator<char> {}];
            F.setName(MangledName.value() + HybridPatchableTargetSuffix);
            let mut A: *mut GlobalAlias = create(LinkOnceODRLinkage, OrigName, &mut F);
            let mut AM: *mut GlobalAlias = create(LinkOnceODRLinkage, MangledName.value(), &mut F);
            F.replaceUsesWithIf(AM, function_ref<bool (Use &)> { Closure_4 {}, null, null });
            F.replaceAllUsesWith(A);
            F.setMetadata("arm64ec_exp_name", get(self.M.getContext(), get(self.M.getContext(), "EXP+" + MangledName.value())));
            A.setAliasee(&mut F);
            AM.setAliasee(&mut F);
            if F.hasDLLExportStorageClass() {
                A.setDLLStorageClass(DLLExportStorageClass);
                F.setDLLStorageClass(DefaultStorageClass);
            }
            FnsMap[A] = AM;
            PatchableFns.insert(A);
        }
    }
    let mut DirectCalledFns: SetVector<GlobalValue *> = SetVector<GlobalValue *> {};
    for F in Mod {
        if !F.isDeclarationForLinker() && F.getCallingConv() != ARM64EC_Thunk_Native && F.getCallingConv() != ARM64EC_Thunk_X64 {
            self.processFunction(F, DirectCalledFns, FnsMap);
        }
    }
    let mut ThunkMapping: SmallVector<ThunkInfo> = SmallVector<ThunkInfo> {};
    for F in Mod {
        if !F.isDeclarationForLinker() && (!F.hasLocalLinkage() || F.hasAddressTaken(null, false, true, false, false, false)) && F.getCallingConv() != ARM64EC_Thunk_Native && F.getCallingConv() != ARM64EC_Thunk_X64 {
            if !F.hasComdat() {
                F.setComdat(Mod.getOrInsertComdat(F.getName()));
            }
            ThunkMapping.push(ThunkInfo { &mut F, self.buildEntryThunk(&mut F), Entry });
        }
    }
    for O in DirectCalledFns {
        let mut GA: CastReturnType = dyn_cast(O);
        let mut F: CastReturnType = dyn_cast(if GA { GA.getAliasee() } else { O });
        ThunkMapping.push(ThunkInfo { O, self.buildExitThunk(F.getFunctionType(), F.getAttributes()), Exit });
        if !GA && !F.hasDLLImportStorageClass() {
            ThunkMapping.push(ThunkInfo { self.buildGuestExitThunk(F), F, GuestExit });
        }
    }
    for A in PatchableFns {
        let mut Thunk: *mut Function = self.buildPatchableThunk(A, FnsMap[A]);
        ThunkMapping.push(ThunkInfo { Thunk, A, GuestExit });
    }
    if !ThunkMapping.is_empty() {
        let mut ThunkMappingArrayElems: SmallVector<Constant *> = SmallVector<Constant *> {};
        for Thunk in ThunkMapping {
            ThunkMappingArrayElems.push(getAnon([Thunk.Src, Thunk.Dst, get(self.M.getContext(), APInt { 32, Thunk.Kind, false, false })], false));
        }
        let mut ThunkMappingArray: *mut Constant = get(get(ThunkMappingArrayElems[0].getType(), ThunkMappingArrayElems.len), ThunkMappingArrayElems);
        GlobalVariable { Mod, ThunkMappingArray.getType(), false, ExternalLinkage, ThunkMappingArray, "llvm.arm64ec.symbolmap", null, NotThreadLocal, nullopt, false };
    }
    return true;
}

fn AArch64Arm64ECCallLowering::processFunction(self, F: *mut Function, DirectCalledFns: *mut SetVector<GlobalValue *>, FnsMap: *mut DenseMap<GlobalAlias *, GlobalAlias *>) -> bool {
    let mut IndirectCalls: SmallVector<CallBase *, 8> = SmallVector<CallBase *, 8> {};
    if !F.hasLocalLinkage() || F.hasAddressTaken(null, false, true, false, false, false) {
        if getArm64ECMangledFunctionName(F) {
            MangledName;
        } else {
            F.addMetadata("arm64ec_unmangled_name", *get(self.M.getContext(), get(self.M.getContext(), F.getName())));
            if F.hasComdat() && F.getComdat().getName() == F.getName() {
                let mut MangledComdat: *mut Comdat = self.M.getOrInsertComdat(MangledName.value());
                let mut ComdatUsers: SmallVector<GlobalObject *> = to_vector(F.getComdat().getUsers());
                for User in ComdatUsers {
                    User.setComdat(MangledComdat);
                }
            }
            F.setName(MangledName.value());
        }
    }
    for BB in F {
        for I in BB {
            let mut CB: *mut CallBase = dyn_cast(&mut I);
            if !CB || CB.getCallingConv() == ARM64EC_Thunk_X64 || CB.isInlineAsm() {
                continue;
            }
            if CB.getCalledFunction() {
                F;
            } else {
                if !LowerDirectToIndirect || F.hasLocalLinkage() || F.isIntrinsic() || !F.isDeclarationForLinker() {
                    continue;
                }
                DirectCalledFns.insert(F);
                continue;
            }
            if dyn_cast(CB.getCalledOperand()) {
                A;
            } else {
                let mut I: iterator = FnsMap.find(A);
                if I != FnsMap.end() {
                    CB.setCalledOperand(operator(I).second);
                    DirectCalledFns.insert(operator(I).first);
                    continue;
                }
            }
            IndirectCalls.push(CB);
            operator(Arm64ECCallsLowered);
        }
    }
    if IndirectCalls.is_empty() {
        return false;
    }
    for CB in IndirectCalls {
        self.lowerCall(CB);
    }
    return true;
}

static mut ID: i8 = 0;

fn createAArch64Arm64ECCallLoweringPass() -> *mut ModulePass {
    return AArch64Arm64ECCallLowering {};
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, T: *mut Type) -> ThunkArgInfo {
        return ThunkArgInfo { Arm64Ty: T, X64Ty: T, Translation: Direct };
    }

struct Closure_2 {
    cap_0: *mut AArch64Arm64ECCallLowering,
}

fn Closure_2::call(self: *Closure_2, Arm64Ty: *mut Type, SizeInBytes: u64) -> ThunkArgInfo {
        return ThunkArgInfo { Arm64Ty: Arm64Ty, X64Ty: getIntNTy(self.M.getContext(), SizeInBytes * 8), Translation: Bitcast };
    }

struct Closure_3 {
    cap_0: *mut AArch64Arm64ECCallLowering,
}

fn Closure_3::call(self: *Closure_3, Arm64Ty: *mut Type) -> ThunkArgInfo {
        return ThunkArgInfo { Arm64Ty: Arm64Ty, X64Ty: self.PtrTy, Translation: PointerIndirection };
    }

struct Closure_4 {}

fn Closure_4::call(self: *Closure_4, U: *mut Use) -> bool {
                return isa(U.getUser());
            }
