static mut NumStridedLoadsMarked: Statistic = Statistic { "aarch64-falkor-hwpf-fix", "NumStridedLoadsMarked", "Number of strided loads marked" };

static mut NumCollisionsAvoided: Statistic = Statistic { "aarch64-falkor-hwpf-fix", "NumCollisionsAvoided", "Number of HW prefetch tag collisions avoided" };

static mut NumCollisionsNotAvoided: Statistic = Statistic { "aarch64-falkor-hwpf-fix", "NumCollisionsNotAvoided", "Number of HW prefetch tag collisions not avoided due to lack of registers" };

static mut FixCounter: CounterInfo = CounterInfo { "falkor-hwpf", "Controls which tag collisions are avoided" };

struct FalkorMarkStridedAccesses {
    LI: *mut LoopInfo,
    SE: *mut ScalarEvolution,
}

struct FalkorMarkStridedAccessesLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
}

fn FalkorMarkStridedAccessesLegacy::getAnalysisUsage(self: *FalkorMarkStridedAccessesLegacy, AU: *mut AnalysisUsage) {
    AU.addRequired();
    AU.addPreserved();
    AU.addRequired();
    AU.addPreserved();
    AU.addRequired();
    AU.addPreserved();
}

fn FalkorMarkStridedAccessesLegacy::getPassKind(self: *FalkorMarkStridedAccessesLegacy) -> PassKind {
    return self.Kind;
}

fn FalkorMarkStridedAccessesLegacy::getPassID(self: *FalkorMarkStridedAccessesLegacy) -> AnalysisID {
    return self.PassID;
}

fn FalkorMarkStridedAccessesLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn FalkorMarkStridedAccessesLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn FalkorMarkStridedAccessesLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn FalkorMarkStridedAccessesLegacy::getResolver(self: *FalkorMarkStridedAccessesLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

static mut ID: i8 = 0;

fn createFalkorMarkStridedAccessesPass() -> *mut FunctionPass {
    return FalkorMarkStridedAccessesLegacy {};
}

fn FalkorMarkStridedAccessesLegacy::runOnFunction(self, F: *mut Function) -> bool {
    let mut TPC: *mut TargetPassConfig = self.getAnalysis();
    let mut ST: *AArch64Subtarget = TPC.getTM().getSubtargetImpl(F);
    if ST.getProcFamily() != Falkor {
        return false;
    }
    if self.skipFunction(F) {
        return false;
    }
    let mut LI: *mut LoopInfo = self.getAnalysis().getLoopInfo();
    let mut SE: *mut ScalarEvolution = self.getAnalysis().getSE();
    let mut LDP: FalkorMarkStridedAccesses = FalkorMarkStridedAccesses { LI: LI, SE: SE };
    return LDP.run();
}

fn FalkorMarkStridedAccesses::run(self) -> bool {
    let mut MadeChange: bool = false;
    for L in self.LI {
        for LIt in depth_first(L) {
            MadeChange |= self.runOnLoop(*LIt);
        }
    }
    return MadeChange;
}

fn FalkorMarkStridedAccesses::runOnLoop(self, L: *mut Loop) -> bool {
    if !L.isInnermost() {
        return false;
    }
    let mut MadeChange: bool = false;
    for BB in L.blocks() {
        for I in *BB {
            let mut LoadI: *mut LoadInst = dyn_cast(&mut I);
            if !LoadI {
                continue;
            }
            let mut PtrValue: *mut Value = LoadI.getPointerOperand();
            if L.isLoopInvariant(PtrValue) {
                continue;
            }
            let mut LSCEV: *SCEV = self.SE.getSCEV(PtrValue);
            let mut LSCEVAddRec: *SCEVAddRecExpr = dyn_cast(LSCEV);
            if !LSCEVAddRec || !LSCEVAddRec.isAffine() {
                continue;
            }
            LoadI.setMetadata("falkor.strided.access", get(LoadI.getContext(), ArrayRef<Metadata *> {}));
            operator(NumStridedLoadsMarked);
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-falkor-hwpf-fix", 1) {
                    dbgs() << "Load: " << I << " marked as strided\n";
                }
            }
                if !(false) { break; }
            }
            MadeChange = true;
        }
    }
    return MadeChange;
}

struct FalkorHWPFFix {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
    TII: *AArch64InstrInfo,
    TRI: *TargetRegisterInfo,
    TagMap: DenseMap<unsigned int, SmallVector<MachineInstr *, 4>>,
    Modified: bool,
}

fn FalkorHWPFFix::getAnalysisUsage(self: *FalkorHWPFFix, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU.addRequired();
    self.getAnalysisUsage(AU);
}

fn FalkorHWPFFix::getRequiredProperties(self: *FalkorHWPFFix) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn FalkorHWPFFix::getPassKind(self: *FalkorHWPFFix) -> PassKind {
    return self.Kind;
}

fn FalkorHWPFFix::getPassID(self: *FalkorHWPFFix) -> AnalysisID {
    return self.PassID;
}

fn FalkorHWPFFix::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn FalkorHWPFFix::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn FalkorHWPFFix::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn FalkorHWPFFix::getResolver(self: *FalkorHWPFFix) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn FalkorHWPFFix::getSetProperties(self: *FalkorHWPFFix) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn FalkorHWPFFix::getClearedProperties(self: *FalkorHWPFFix) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

struct LoadInfo {
    DestReg: Register,
    BaseReg: Register,
    BaseRegIdx: i32,
    OffsetOpnd: *MachineOperand,
    IsPrePost: bool,
}

static mut ID: i8 = 0;

fn makeTag(Dest: u32, Base: u32, Offset: u32) -> u32 {
    return (Dest & 15) | ((Base & 15) << 4) | ((Offset & 63) << 8);
}

fn getLoadInfo(MI: *MachineInstr) -> optional<LoadInfo> {
    let mut DestRegIdx: i32 = 0;
    let mut BaseRegIdx: i32 = 0;
    let mut OffsetIdx: i32 = 0;
    let mut IsPrePost: bool = false;
    match MI.getOpcode() {
        _ => {
            return nullopt;
        },
        LD1i64 => {
            LD2i64;
        },
        LD1i8 => {
            LD1i16;
        },
        LD1Onev1d => {
            LD1Onev2s;
        },
        LD1Twov1d => {
            LD1Twov2s;
        },
        LD1i64_POST => {
            LD2i64_POST;
        },
        LD1i8_POST => {
            LD1i16_POST;
        },
        LD1Onev1d_POST => {
            LD1Onev2s_POST;
        },
        LD1Twov1d_POST => {
            LD1Twov2s_POST;
        },
        LDRBBroW => {
            LDRBBroX;
        },
        LDRBBpost => {
            LDRBBpre;
        },
        LDNPDi => {
            LDNPQi;
        },
        LDPSWi => {
            LDPWi;
        },
        LDPQpost => {
            LDPQpre;
        },
        LDPSWpost => {
            LDPSWpre;
        },
    }
    let mut BaseReg: Register = MI.getOperand(BaseRegIdx).getReg();
    if BaseReg == SP || BaseReg == WSP {
        return nullopt;
    }
    let mut LI: LoadInfo = LoadInfo {};
    LI.DestReg = if DestRegIdx == -1 { Register { Reg: 0 } } else { MI.getOperand(DestRegIdx).getReg() };
    LI.BaseReg = BaseReg;
    LI.BaseRegIdx = BaseRegIdx;
    LI.OffsetOpnd = if OffsetIdx == -1 { null } else { &mut MI.getOperand(OffsetIdx) };
    LI.IsPrePost = IsPrePost;
    return LI;
}

fn getTag(TRI: *TargetRegisterInfo, MI: *MachineInstr, LI: *LoadInfo) -> optional<unsigned int> {
    let mut Dest: u32 = if LI.DestReg.operator unsigned int() { TRI.getEncodingValue(LI.DestReg.operator MCRegister()) } else { 0 };
    let mut Base: u32 = TRI.getEncodingValue(LI.BaseReg.operator MCRegister());
    let mut Off: u32 = 0;
    if LI.OffsetOpnd == null {
        Off = 0;
    } else if LI.OffsetOpnd.isGlobal() || LI.OffsetOpnd.isSymbol() || LI.OffsetOpnd.isCPI() {
        return nullopt;
    } else if LI.OffsetOpnd.isReg() {
        Off = (1 << 5) | TRI.getEncodingValue(LI.OffsetOpnd.getReg().operator MCRegister());
    } else {
        Off = LI.OffsetOpnd.getImm() >> 2;
    }
    return makeTag(Dest, Base, Off);
}

fn FalkorHWPFFix::runOnLoop(self, L: *mut MachineLoop, Fn: *mut MachineFunction) {
    self.TagMap.clear();
    for MBB in L.getBlocks() {
        for MI in *MBB {
            let mut LInfo: optional<LoadInfo> = getLoadInfo(MI);
            if !LInfo {
                continue;
            }
            let mut Tag: optional<unsigned int> = getTag(self.TRI, MI, operator(LInfo));
            if !Tag {
                continue;
            }
            self.TagMap[operator(Tag)].push(&mut MI);
        }
    }
    let mut AnyCollisions: bool = false;
    for P in self.TagMap {
        let mut Size: u64 = P.second.len;
        if Size > 1 {
            for MI in P.second {
                if self.TII.isStridedAccess(*MI) {
                    AnyCollisions = true;
                    break;
                }
            }
        }
        if AnyCollisions {
            break;
        }
    }
    if !AnyCollisions {
        return;
    }
    let mut MRI: *mut MachineRegisterInfo = Fn.getRegInfo();
    let mut LR: LiveRegUnits = *self.TRI;
    for MBB in L.getBlocks() {
        LR.clear();
        LR.addLiveOuts(*MBB);
        for let mut I: reverse_iterator = MBB.rbegin(); I != MBB.rend(); LR.stepBackward(operator(I)) , operator(I) {
            let mut MI: *mut MachineInstr = operator(I);
            if !self.TII.isStridedAccess(MI) {
                continue;
            }
            let mut OptLdI: optional<LoadInfo> = getLoadInfo(MI);
            if !OptLdI {
                continue;
            }
            let mut LdI: LoadInfo = operator(OptLdI);
            let mut OptOldTag: optional<unsigned int> = getTag(self.TRI, MI, LdI);
            if !OptOldTag {
                continue;
            }
            let mut OldCollisions: *mut MachineInstr *, 4> = self.TagMap[operator(OptOldTag)];
            if OldCollisions.len <= 1 {
                continue;
            }
            let mut Fixed: bool = false;
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-falkor-hwpf-fix", 1) {
                    dbgs() << "Attempting to fix tag collision: " << MI;
                }
            }
                if !(false) { break; }
            }
            if !shouldExecute(FixCounter) {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-falkor-hwpf-fix", 1) {
                        dbgs() << "Skipping fix due to debug counter:\n  " << MI;
                    }
                }
                    if !(false) { break; }
                }
                continue;
            }
            for let mut OpI: u32 = 0;
let mut OpE: u32 = MI.getNumOperands(); OpI < OpE; OpI += 1 {
                if OpI == LdI.BaseRegIdx as u32 {
                    continue;
                }
                let mut MO: *mut MachineOperand = MI.getOperand(OpI);
                if MO.isReg() && MO.readsReg() {
                    LR.addReg(MO.getReg().operator MCRegister());
                }
            }
            for ScratchReg in GPR64RegClass {
                if !LR.available(ScratchReg) || MRI.isReserved(ScratchReg) {
                    continue;
                }
                let mut NewLdI: LoadInfo = LdI;
                NewLdI.BaseReg = ScratchReg;
                let mut NewTag: u32 = operator(getTag(self.TRI, MI, NewLdI));
                if self.TagMap.count(NewTag) {
                    continue;
                }
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-falkor-hwpf-fix", 1) {
                        dbgs() << "Changing base reg to: " << printReg(ScratchReg, self.TRI, 0, null) << 10;
                    }
                }
                    if !(false) { break; }
                }
                let mut DL: DebugLoc = MI.getDebugLoc();
                BuildMI(*MBB, &mut MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ORRXrs), ScratchReg).addReg(XZR, RegState {}, 0).addReg(LdI.BaseReg, RegState {}, 0).addImm(0);
                let mut BaseOpnd: *mut MachineOperand = MI.getOperand(LdI.BaseRegIdx);
                BaseOpnd.setReg(ScratchReg);
                if LdI.IsPrePost {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("aarch64-falkor-hwpf-fix", 1) {
                            dbgs() << "Doing post MOV of incremented reg: " << printReg(ScratchReg, self.TRI, 0, null) << 10;
                        }
                    }
                        if !(false) { break; }
                    }
                    MI.getOperand(0).setReg(ScratchReg);
                    BuildMI(*MBB, next(MI, 1), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ORRXrs), LdI.BaseReg).addReg(XZR, RegState {}, 0).addReg(ScratchReg, RegState {}, 0).addImm(0);
                }
                for let mut I: i32 = 0;
let mut E: i32 = OldCollisions.len; I != E; I += 1 {
                    if OldCollisions[I] == &mut MI {
                        swap(OldCollisions[I], OldCollisions[E - 1]);
                        OldCollisions.pop();
                        break;
                    }
                }
                self.TagMap[NewTag].push(&mut MI);
                operator(NumCollisionsAvoided);
                Fixed = true;
                self.Modified = true;
                break;
            }
            if !Fixed {
                operator(NumCollisionsNotAvoided);
            }
        }
    }
}

fn FalkorHWPFFix::runOnMachineFunction(self, Fn: *mut MachineFunction) -> bool {
    let mut ST: *AArch64Subtarget = Fn.getSubtarget();
    if ST.getProcFamily() != Falkor {
        return false;
    }
    if self.skipFunction(Fn.getFunction()) {
        return false;
    }
    self.TII = ST.getInstrInfo();
    self.TRI = ST.getRegisterInfo();
    let mut LI: *mut MachineLoopInfo = self.getAnalysis().getLI();
    self.Modified = false;
    for I in LI {
        for L in depth_first(I) {
            if L.isInnermost() {
                self.runOnLoop(*L, Fn);
            }
        }
    }
    return self.Modified;
}

fn createFalkorHWPFFixPass() -> *mut FunctionPass {
    return FalkorHWPFFix {};
}
