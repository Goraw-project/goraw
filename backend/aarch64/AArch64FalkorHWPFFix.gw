struct LoadInfo {
    DestReg: Register,
    BaseReg: Register,
    BaseRegIdx: i32,
    OffsetOpnd: *MachineOperand,
    IsPrePost: bool,
}

static mut ID: i8 = 0;

fn makeTag(Dest: u32, Base: u32, Offset: u32) -> u32 {
    return (Dest & 15) | ((Base & 15) << 4) | ((Offset & 63) << 8);
}

fn getLoadInfo(MI: *MachineInstr) -> optional<LoadInfo> {
    let mut DestRegIdx: i32 = 0;
    let mut BaseRegIdx: i32 = 0;
    let mut OffsetIdx: i32 = 0;
    let mut IsPrePost: bool = false;
    match MI.getOpcode() {
        _ => {
            return nullopt();
        },
    }
    let mut BaseReg: Register = MI.getOperand(BaseRegIdx).getReg();
    if  {
        return nullopt();
    }
    let mut LI: LoadInfo = LoadInfo {};
    LI.DestReg = if DestRegIdx == -1 { Register { Reg: 0 } } else { MI.getOperand(DestRegIdx).getReg() };
    LI.BaseReg = BaseReg;
    LI.BaseRegIdx = BaseRegIdx;
    LI.OffsetOpnd = if OffsetIdx == -1 { null } else { &mut MI.getOperand(OffsetIdx) };
    LI.IsPrePost = IsPrePost;
    return LI;
}

fn getTag(TRI: *TargetRegisterInfo, MI: *MachineInstr, LI: *LoadInfo) -> optional<unsigned int> {
    let mut Dest: u32 = if LI.DestReg.operator unsigned int() { TRI.getEncodingValue } else { 0 };
    let mut Base: u32 = TRI.getEncodingValue;
    let mut Off: u32 = 0;
    if LI.OffsetOpnd == null {
        Off = 0;
    } else if LI.OffsetOpnd.isGlobal() || LI.OffsetOpnd.isSymbol() || LI.OffsetOpnd.isCPI() {
        return nullopt();
    } else if LI.OffsetOpnd.isReg() {
        Off = (1 << 5) | TRI.getEncodingValue;
    } else {
        Off = LI.OffsetOpnd.getImm() >> 2;
    }
    return makeTag(Dest, Base, Off);
}

fn FalkorHWPFFix::runOnLoop(self, L: *mut MachineLoop, Fn: *mut MachineFunction) {
    let mut AnyCollisions: bool = false;
    if !AnyCollisions {
        return;
    }
    let mut MRI: *mut MachineRegisterInfo = Fn.getRegInfo();
    let mut LR: LiveRegUnits = *self.TRI;
}

fn FalkorHWPFFix::runOnMachineFunction(self, Fn: *mut MachineFunction) -> bool {
    let mut ST: *mut auto = Fn;
    if  {
        return false;
    }
    if self.skipFunction {
        return false;
    }
    self.TII = ();
    self.TRI = ();
    let mut LI: *mut MachineLoopInfo = ();
    self.Modified = false;
    return self.Modified;
}

fn createFalkorHWPFFixPass() -> *mut FunctionPass {
    return FalkorHWPFFix {};
}
