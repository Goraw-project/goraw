    return false;
}

fn AArch64SpeculationHardening::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64SpeculationHardening::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

