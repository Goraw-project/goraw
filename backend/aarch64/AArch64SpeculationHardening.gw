static mut HardenLoads: i32 = "aarch64-slh-loads";

struct AArch64SpeculationHardening {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
    TII: *TargetInstrInfo,
    TRI: *TargetRegisterInfo,
    MisspeculatingTaintReg: u32,
    MisspeculatingTaintReg32Bit: u32,
    UseControlFlowSpeculationBarrier: bool,
    RegsNeedingCSDBBeforeUse: BitVector,
    RegsAlreadyMasked: BitVector,
}

