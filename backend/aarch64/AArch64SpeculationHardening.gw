static mut ID: i8 = 0;

fn AArch64SpeculationHardening::endsWithCondControlFlow(self: *AArch64SpeculationHardening, MBB: *mut MachineBasicBlock, TBB: *mut *mut MachineBasicBlock, FBB: *mut *mut MachineBasicBlock, CondCode: *mut CondCode) -> bool {
    let mut analyzeBranchCondCode: SmallVector<MachineOperand, 1> = zeroed();
    if self.TII(MBB, TBB, FBB, false) {
        return false;
    }
    if analyzeBranchCondCode()() {
        return false;
    }
    assert!(TBB != null);
    if FBB == null {
        FBB = MBB.getFallThrough(true);
    }
    if TBB == FBB {
        return false;
    }
    assert!(MBB.succ_size() == 2);
    (((operator!(operator!((analyzeBranchCondCode()() == 1 && "unknown Cond array format")))) || (_wassert(L"analyzeBranchCondCode.size() == 1 && \"unknown Cond array format\"", L"llvm\\lib\\Target\\AArch64\\AArch64SpeculationHardening.cpp", (207) as u32) , 0)) as void);
    CondCode = [0]();
    return true;
}

fn AArch64SpeculationHardening::insertFullSpeculationBarrier(self: *AArch64SpeculationHardening, MBB: *mut MachineBasicBlock, MBBI: iterator, DL: DebugLoc) {
    BuildMI(MBB, MBBI, DL, self.TII.get)(15);
    BuildMI(MBB, MBBI, DL, self.TII.get)(15);
}

fn AArch64SpeculationHardening::insertTrackingCode(self: *AArch64SpeculationHardening, SplitEdgeBB: *mut MachineBasicBlock, CondCode: *mut CondCode, DL: DebugLoc) {
    if self.UseControlFlowSpeculationBarrier {
        self.insertFullSpeculationBarrier(SplitEdgeBB, SplitEdgeBB.begin(), DL);
    } else {
        BuildMI(SplitEdgeBB, SplitEdgeBB.begin(), DL, self.TII.get)(self.MisspeculatingTaintReg)(self.MisspeculatingTaintReg)(CondCode);
        SplitEdgeBB;
    }
}

fn AArch64SpeculationHardening::instrumentControlFlow(self, MBB: *mut MachineBasicBlock, UsesFullSpeculationBarrier: *mut bool) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
            dbgs() << "Instrument control flow tracking on MBB: " << MBB;
        }
    }
        if !(false) { break; }
    }
    let mut Modified: bool = false;
    let mut TBB: *mut MachineBasicBlock = null;
    let mut FBB: *mut MachineBasicBlock = null;
    let mut CondCode: CondCode = zeroed();
    if !self.endsWithCondControlFlow(MBB, TBB, FBB, CondCode) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
                dbgs() << "... doesn't end with CondControlFlow\n";
            }
        }
            if !(false) { break; }
        }
    } else {
        let mut InvCondCode: CondCode = getInvertedCondCode(CondCode);
        let mut SplitEdgeTBB: *mut MachineBasicBlock = MBB.SplitCriticalEdge(TBB, *self, null, null);
        let mut SplitEdgeFBB: *mut MachineBasicBlock = MBB.SplitCriticalEdge(FBB, *self, null, null);
        assert!(SplitEdgeTBB != null);
        assert!(SplitEdgeFBB != null);
        let mut DL: DebugLoc = null;
        if MBB.instr_end() != MBB.instr_begin() {
            DL = operator((operator(MBB.instr_end()))).getDebugLoc();
        }
        self.insertTrackingCode(*SplitEdgeTBB, CondCode, DL);
        self.insertTrackingCode(*SplitEdgeFBB, InvCondCode, DL);
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
                dbgs() << "SplitEdgeTBB: " << *SplitEdgeTBB << "\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
                dbgs() << "SplitEdgeFBB: " << *SplitEdgeFBB << "\n";
            }
        }
            if !(false) { break; }
        }
        Modified = true;
    }
    let mut ReturnInstructions: pair<MachineInstr *, unsigned int>, 4> = zeroed();
    let mut CallInstructions: pair<MachineInstr *, unsigned int>, 4> = zeroed();
    let mut TmpRegisterNotAvailableEverywhere: bool = false;
    let mut RS: RegScavenger = RegScavenger {};
    RS.enterBasicBlockEnd(MBB);
    for let mut I: iterator = MBB.end(); I != MBB.begin();  {
        let mut MI: *mut MachineInstr = operator(operator(I));
        if !MI.isReturn(AnyInBundle) && !MI.isCall(AnyInBundle) {
            continue;
        }
        if I == MBB.begin() {
            RS.enterBasicBlock(MBB);
        } else {
            RS.backward(I);
        }
        let mut TmpReg: Register = RS.FindUnusedReg;
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
                dbgs() << "RS finds " << (if (TmpReg == 0) { "no register " } else { "register " });
                if TmpReg != 0 {
                    dbgs() << printReg(TmpReg, self.TRI, 0, null) << " ";
                }
                dbgs() << "to be available at MI " << MI;
            }
        }
            if !(false) { break; }
        }
        if TmpReg == 0 {
            TmpRegisterNotAvailableEverywhere = true;
        }
        if MI.isReturn(AnyInBundle) {
            ReturnInstructions()(void { &mut MI, TmpReg });
        } else if MI.isCall(AnyInBundle) {
            CallInstructions()(void { &mut MI, TmpReg });
        }
    }
    if TmpRegisterNotAvailableEverywhere {
        self.insertFullSpeculationBarrier(MBB, MBB.begin(), operator((MBB.begin())).getDebugLoc());
        UsesFullSpeculationBarrier = true;
        Modified = true;
    } else {}
    return Modified;
}

fn AArch64SpeculationHardening::insertSPToRegTaintPropagation(self: *AArch64SpeculationHardening, MBB: *mut MachineBasicBlock, MBBI: iterator) {
    if self.UseControlFlowSpeculationBarrier {
        self.insertFullSpeculationBarrier(MBB, MBBI, DebugLoc { Loc: null });
        return;
    }
    BuildMI(MBB, MBBI, DebugLoc { Loc: null }, self.TII.get)(0)(0);
    BuildMI(MBB, MBBI, DebugLoc { Loc: null }, self.TII.get)(self.MisspeculatingTaintReg)(EQ);
}

fn AArch64SpeculationHardening::insertRegToSPTaintPropagation(self: *AArch64SpeculationHardening, MBB: *mut MachineBasicBlock, MBBI: iterator, TmpReg: u32) {
    if self.UseControlFlowSpeculationBarrier {
        return;
    }
    BuildMI(MBB, MBBI, DebugLoc { Loc: null }, self.TII.get)(TmpReg)(0)(0);
    BuildMI(MBB, MBBI, DebugLoc { Loc: null }, self.TII.get)(TmpReg, Renamable)(TmpReg, Kill(Renamable))(self.MisspeculatingTaintReg, Kill)(0);
    BuildMI(MBB, MBBI, DebugLoc { Loc: null }, self.TII.get)(TmpReg, Kill)(0)(0);
}

fn AArch64SpeculationHardening::functionUsesHardeningRegister(self: *AArch64SpeculationHardening, MF: *mut MachineFunction) -> bool {
    for MBB in MF {
        for MI in MBB {
            if MI.isCall(AnyInBundle) {
                continue;
            }
            if MI.readsRegister(self.MisspeculatingTaintReg, self.TRI) || MI.modifiesRegister(self.MisspeculatingTaintReg, self.TRI) {
                return true;
            }
        }
    }
    return false;
}

fn AArch64SpeculationHardening::makeGPRSpeculationSafe(self, MBB: *mut MachineBasicBlock, MBBI: iterator, MI: *mut MachineInstr, Reg: u32) -> bool {
    if  {
        return false;
    }
    if self.RegsAlreadyMasked[Reg] {
        return false;
    }
    let mut Is64Bit: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
            dbgs() << "About to harden register : " << Reg << "\n";
        }
    }
        if !(false) { break; }
    }
    BuildMI(MBB, MBBI, MI.getDebugLoc(), self.TII.get)(Reg)(Reg);
    self.RegsAlreadyMasked.set(Reg);
    return true;
}

fn AArch64SpeculationHardening::slhLoads(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Modified: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
            dbgs() << "slhLoads running on MBB: " << MBB;
        }
    }
        if !(false) { break; }
    }
    self.RegsAlreadyMasked.reset();
    let mut MBBI: iterator = MBB.begin();
    let mut E: iterator = MBB.end();
    let mut NextMBBI: iterator = iterator {};
    for ; MBBI != E; MBBI = NextMBBI {
        let mut MI: *mut MachineInstr = operator(MBBI);
        NextMBBI = next(MBBI);
        if !MI.mayLoad(AnyInBundle) {
            continue;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
                dbgs() << "About to harden: " << MI;
            }
        }
            if !(false) { break; }
        }
        let mut AllDefsAreGPR: bool = all_of(MI.defs(), Closure_1 {});
        let mut HardenLoadedData: bool = AllDefsAreGPR;
        let mut HardenAddressLoadedFrom: bool = !HardenLoadedData;
        for Op in MI.defs() {
            for let mut AI: MCRegAliasIterator = MCRegAliasIterator { Op.getReg().operator MCRegister(), self.TRI, true }; AI.isValid(); operator(AI) {
                self.RegsAlreadyMasked.reset(operator(AI).operator unsigned int());
            }
        }
        if HardenLoadedData {
            for Def in MI.defs() {
                if Def.isDead() {
                    continue;
                }
                Modified |= self.makeGPRSpeculationSafe(MBB, NextMBBI, MI, Def.getReg().operator unsigned int());
            }
        }
        if HardenAddressLoadedFrom {
            for Use in MI.uses() {
                if !Use.isReg() {
                    continue;
                }
                let mut Reg: Register = Use.getReg();
                if  {
                    continue;
                }
                Modified |= self.makeGPRSpeculationSafe(MBB, MBBI, MI, Reg.operator unsigned int());
            }
        }
    }
    return Modified;
}

fn AArch64SpeculationHardening::expandSpeculationSafeValue(self, MBB: *mut MachineBasicBlock, MBBI: iterator, UsesFullSpeculationBarrier: bool) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut Opcode: u32 = MI.getOpcode();
    let mut Is64Bit: bool = true;
    match Opcode {
        _ => {
            break;
        },
    }
    return false;
}

fn AArch64SpeculationHardening::insertCSDB(self, MBB: *mut MachineBasicBlock, MBBI: iterator, DL: DebugLoc) -> bool {
    assert!(!self.UseControlFlowSpeculationBarrier, "No need to insert CSDBs when control flow miss-speculation is already blocked");
    BuildMI(MBB, MBBI, DL, self.TII.get)(20);
    self.RegsNeedingCSDBBeforeUse.reset();
    return true;
}

fn AArch64SpeculationHardening::lowerSpeculationSafeValuePseudos(self, MBB: *mut MachineBasicBlock, UsesFullSpeculationBarrier: bool) -> bool {
    let mut Modified: bool = false;
    self.RegsNeedingCSDBBeforeUse.reset();
    let mut MBBI: iterator = MBB.begin();
    let mut E: iterator = MBB.end();
    let mut DL: DebugLoc = null;
    while MBBI != E {
        let mut MI: *mut MachineInstr = operator(MBBI);
        DL = MI.getDebugLoc();
        let mut NMBBI: iterator = next(MBBI);
        let mut NeedToEmitBarrier: bool = false;
        if self.RegsNeedingCSDBBeforeUse.any() && (MI.isCall(AnyInBundle) || MI.isTerminator(AnyInBundle)) {
            NeedToEmitBarrier = true;
        }
        if !NeedToEmitBarrier {
            for Op in MI.uses() {
                if Op.isReg() && self.RegsNeedingCSDBBeforeUse[Op.getReg().operator unsigned int()] {
                    NeedToEmitBarrier = true;
                    break;
                }
            }
        }
        if NeedToEmitBarrier && !UsesFullSpeculationBarrier {
            Modified |= self.insertCSDB(MBB, MBBI, DL);
        }
        Modified |= self.expandSpeculationSafeValue(MBB, MBBI, UsesFullSpeculationBarrier);
        MBBI = NMBBI;
    }
    if self.RegsNeedingCSDBBeforeUse.any() && !UsesFullSpeculationBarrier {
        Modified |= self.insertCSDB(MBB, MBBI, DL);
    }
    return Modified;
}

fn AArch64SpeculationHardening::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if !MF.getFunction().hasFnAttribute(SpeculativeLoadHardening) {
        return false;
    }
    self.TII = MF.getSubtarget().getInstrInfo();
    self.TRI = MF.getSubtarget().getRegisterInfo();
    self.RegsNeedingCSDBBeforeUse.resize(self.TRI.getNumRegs(), false);
    self.RegsAlreadyMasked.resize(self.TRI.getNumRegs(), false);
    self.UseControlFlowSpeculationBarrier = self.functionUsesHardeningRegister(MF);
    let mut Modified: bool = false;
    if HardenLoads() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
                dbgs() << "***** AArch64SpeculationHardening - automatic insertion of SpeculationSafeValue intrinsics *****\n";
            }
        }
            if !(false) { break; }
        }
        for MBB in MF {
            Modified |= self.slhLoads(MBB);
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-speculation-hardening", 1) {
            dbgs() << "***** AArch64SpeculationHardening - track control flow *****\n";
        }
    }
        if !(false) { break; }
    }
    let mut EntryBlocks: SmallVector<MachineBasicBlock *, 2> = SmallVector<MachineBasicBlock *, 2> {};
    EntryBlocks.push(&mut MF.front());
    for Entry in EntryBlocks {
        self.insertSPToRegTaintPropagation(*Entry, Entry.SkipPHIsLabelsAndDebug(Entry.begin(), Register { Reg: 0 }, true));
    }
    for MBB in MF {
        let mut UsesFullSpeculationBarrier: bool = false;
        Modified |= self.instrumentControlFlow(MBB, UsesFullSpeculationBarrier);
        Modified |= self.lowerSpeculationSafeValuePseudos(MBB, UsesFullSpeculationBarrier);
    }
    return Modified;
}

fn createAArch64SpeculationHardeningPass() -> *mut FunctionPass {
    return AArch64SpeculationHardening {};
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Op: *mut MachineOperand) {}
