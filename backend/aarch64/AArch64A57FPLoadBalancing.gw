    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

struct Chain {
    StartInst: *mut MachineInstr,
    LastInst: *mut MachineInstr,
    KillInst: *mut MachineInstr,
    StartInstIdx: u32,
    LastInstIdx: u32,
    KillInstIdx: u32,
    Insts: set<MachineInstr *>,
    KillIsImmutable: bool,
    LastColor: Color,
}

fn Chain::Chain(self, MI: *mut MachineInstr, Idx: u32, C: Color) {
    self.Insts.insert(MI);
}

fn Chain::add(self, MI: *mut MachineInstr, Idx: u32, C: Color) {
    self.LastInst = MI;
    self.LastInstIdx = Idx;
    self.LastColor = C;
    assert!((self.KillInstIdx == 0 || self.LastInstIdx < self.KillInstIdx), "Chain: broken invariant. A Chain can only be killed after its last def");
    self.Insts.insert(MI);
}

fn Chain::contains(self, MI: *mut MachineInstr) -> bool {
    return self.Insts.count(&mut MI) > 0;
}

fn Chain::size(self: *Chain) -> u32 {
    return self.Insts.len;
}

fn Chain::setKill(self, MI: *mut MachineInstr, Idx: u32, Immutable: bool) {
    self.KillInst = MI;
    self.KillInstIdx = Idx;
    self.KillIsImmutable = Immutable;
    assert!((self.KillInstIdx == 0 || self.LastInstIdx < self.KillInstIdx), "Chain: broken invariant. A Chain can only be killed after its last def");
}

fn Chain::getStart(self: *Chain) -> *mut MachineInstr {
    return self.StartInst;
}

fn Chain::getLast(self: *Chain) -> *mut MachineInstr {
    return self.LastInst;
}

fn Chain::getKill(self: *Chain) -> *mut MachineInstr {
    return self.KillInst;
}

fn Chain::end(self: *Chain) -> iterator {
    return operator(if self.KillInst { self.KillInst } else { self.LastInst });
}

fn Chain::begin(self: *Chain) -> iterator {
    return self.getStart();
}

fn Chain::isKillImmutable(self: *Chain) -> bool {
    return self.KillIsImmutable;
}

fn Chain::getPreferredColor(self) -> Color {
    if OverrideBalance.operator unsigned int() != 0 {
        return if OverrideBalance.operator unsigned int() == 1 { Even } else { Odd };
    }
    return self.LastColor;
}

fn Chain::rangeOverlapsWith(self: *Chain, Other: *Chain) -> bool {
    let mut End: u32 = if self.KillInst { self.KillInstIdx } else { self.LastInstIdx };
    let mut OtherEnd: u32 = if Other.KillInst { Other.KillInstIdx } else { Other.LastInstIdx };
    return self.StartInstIdx <= OtherEnd && Other.StartInstIdx <= End;
}

fn Chain::startsBefore(self: *Chain, Other: *Chain) -> bool {
    return self.StartInstIdx < Other.StartInstIdx;
}

fn Chain::requiresFixup(self: *Chain) -> bool {
    return (self.getKill() && self.isKillImmutable()) || !self.getKill();
}

fn Chain::str(self: *Chain) -> str {
    let mut S: str = "";
    let mut OS: raw_string_ostream = S;
    OS << "{";
    self.StartInst.print(OS, true, false, false, true, null);
    OS << " -> ";
    self.LastInst.print(OS, true, false, false, true, null);
    if self.KillInst {
        OS << " (kill @ ";
        self.KillInst.print(OS, true, false, false, true, null);
        OS << ")";
    }
    OS << "}";
    return OS;
}

fn AArch64A57FPLoadBalancingImpl::run(self, MF: *mut MachineFunction) -> bool {
    if !MF.getSubtarget().balanceFPOps() {
        return false;
    }
    let mut Changed: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
            dbgs() << "***** AArch64A57FPLoadBalancing *****\n";
        }
    }
        if !(false) { break; }
    }
    self.MRI = &mut MF.getRegInfo();
    self.TRI = MF.getRegInfo().getTargetRegisterInfo();
    for MBB in MF {
        Changed |= self.runOnBasicBlock(MBB);
    }
    return Changed;
}

fn AArch64A57FPLoadBalancingLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut RCI: *mut RegisterClassInfo = &mut self.getAnalysis().getRCI();
    return RCI.run(MF);
}

fn AArch64A57FPLoadBalancingPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut RCI: *mut RegisterClassInfo = &mut MFAM.getResult(MF);
    if RCI.run(MF) {
        let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
        PA.preserveSet();
        return PA;
    }
    return all();
}

fn AArch64A57FPLoadBalancingImpl::runOnBasicBlock(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Changed: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
            dbgs() << "Running on MBB: " << MBB << " - scanning instructions...\n";
        }
    }
        if !(false) { break; }
    }
    let mut ActiveChains: map<unsigned int, Chain *> = map<unsigned int, Chain *> {};
    let mut AllChains: []unique_ptr<Chain> = []unique_ptr<Chain> {};
    let mut Idx: u32 = 0;
    for MI in MBB {
        self.scanInstruction(&mut MI, Idx += 1, ActiveChains, AllChains);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
            dbgs() << "Scan complete, " << AllChains.len << " chains created.\n";
        }
    }
        if !(false) { break; }
    }
    let mut EC: EquivalenceClasses<Chain *> = EquivalenceClasses<Chain *> {};
    for I in AllChains {
        EC.insert(I.get());
    }
    for I in AllChains {
        for J in AllChains {
            if !I == J && operator(I).rangeOverlapsWith(operator(J)) {
                EC.unionSets(I.get(), J.get());
            }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
            dbgs() << "Created " << EC.getNumClasses() << " disjoint sets.\n";
        }
    }
        if !(false) { break; }
    }
    let mut V: [][]*mut Chain = [][]*mut Chain {};
    for E in EC {
        if !E.isLeader() {
            continue;
        }
        let mut Cs: []*mut Chain = []*mut Chain { EC.member_begin(*E), EC.member_end(), Chain *> {} };
        if Cs.is_empty() {
            continue;
        }
        V.push(move(Cs));
    }
    sort(V, Closure_1 {});
    let mut Parity: i32 = 0;
    for I in V {
        Changed |= self.colorChainSet(move(I), MBB, Parity);
    }
    return Changed;
}

fn AArch64A57FPLoadBalancingImpl::getAndEraseNext(self, PreferredColor: Color, L: *mut []*mut Chain) -> *mut Chain {
    if L.is_empty() {
        return null;
    }
    let mut SizeFuzz: u32 = 1;
    let mut MinSize: u32 = L.front().len - SizeFuzz;
    for let mut I: iterator = L.begin();
let mut E: iterator = L.end(); !I == E; operator(I) {
        if (operator(I)).len <= MinSize {
            let mut Ch: *mut Chain = operator(operator(I));
            L.erase(I);
            return Ch;
        }
        if (operator(I)).getPreferredColor() == PreferredColor {
            let mut Ch: *mut Chain = operator(I);
            L.erase(I);
            return Ch;
        }
    }
    let mut Ch: *mut Chain = L.front();
    L.erase(L.begin());
    return Ch;
}

fn AArch64A57FPLoadBalancingImpl::colorChainSet(self, GV: []*mut Chain, MBB: *mut MachineBasicBlock, Parity: *mut i32) -> bool {
    let mut Changed: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
            dbgs() << "colorChainSet(): #sets=" << GV.len << "\n";
        }
    }
        if !(false) { break; }
    }
    sort(GV, Closure_2 {});
    let mut PreferredColor: Color = if Parity < 0 { Even } else { Odd };
    while self.getAndEraseNext(PreferredColor, GV) {
        G;
    }
    return Changed;
}

fn AArch64A57FPLoadBalancingImpl::scavengeRegister(self, G: *mut Chain, C: Color, MBB: *mut MachineBasicBlock) -> i32 {
    let mut Units: LiveRegUnits = *self.TRI;
    Units.addLiveOuts(MBB);
    let mut I: iterator = MBB.end();
    let mut ChainEnd: iterator = G.end();
    while I != ChainEnd {
        operator(I);
        if !operator(I).isDebugInstr() {
            Units.stepBackward(operator(I));
        }
    }
    let mut ChainBegin: iterator = G.begin();
    assert!(ChainBegin != ChainEnd, "Chain should contain instructions");
    while true {
        {
        operator(I);
        Units.accumulate(operator(I));
    }
        if !(I != ChainBegin) { break; }
    }
    let mut RegClassID: u32 = operator(ChainBegin).getDesc().operands()[0].RegClass;
    let mut Ord: ArrayRef<MCPhysReg> = self.RCI.getOrder(self.TRI.getRegClass(RegClassID));
    for Reg in Ord {
        if !Units.available(Reg) {
            continue;
        }
        if C == self.getColor(Reg) {
            return Reg;
        }
    }
    return -1;
}

fn AArch64A57FPLoadBalancingImpl::colorChain(self, G: *mut Chain, C: Color, MBB: *mut MachineBasicBlock) -> bool {
    let mut Changed: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
            dbgs() << " - colorChain(" << G << ", " << ColorNames[C as i32] << ")\n";
        }
    }
        if !(false) { break; }
    }
    let mut Reg: i32 = self.scavengeRegister(G, C, MBB);
    if Reg == -1 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                dbgs() << "Scavenging (thus coloring) failed!\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
            dbgs() << " - Scavenged register: " << printReg(Reg, self.TRI, 0, null) << "\n";
        }
    }
        if !(false) { break; }
    }
    let mut Substs: map<unsigned int, unsigned int> = map<unsigned int, unsigned int> {};
    for I in *G {
        if !G.contains(I) && (&mut I != G.getKill() || G.isKillImmutable()) {
            continue;
        }
        let mut ToErase: []u32 = []u32 {};
        for U in I.operands() {
            if U.isReg() && U.isUse() && !Substs.find(U.getReg().operator unsigned int()) == Substs.end() {
                let mut OrigReg: Register = U.getReg();
                U.setReg(Substs[OrigReg.operator unsigned int()]);
                if U.isKill() {
                    ToErase.push(OrigReg.operator unsigned int());
                }
            } else if U.isRegMask() {
                for J in Substs {
                    if U.clobbersPhysReg(J.first) {
                        ToErase.push(J.first);
                    }
                }
            }
        }
        for J in ToErase {
            Substs.erase(J);
        }
        if &mut I != G.getKill() {
            let mut MO: *mut MachineOperand = I.getOperand(0);
            let mut Change: bool = TransformAll || self.getColor(MO.getReg().operator unsigned int()) != C;
            if G.requiresFixup() && &mut I == G.getLast() {
                Change = false;
            }
            if Change {
                Substs[MO.getReg().operator unsigned int()] = Reg;
                MO.setReg(Reg);
                Changed = true;
            }
        }
    }
    assert!(Substs.len == 0, "No substitutions should be left active!");
    if G.getKill() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                dbgs() << " - Kill instruction seen.\n";
            }
        }
            if !(false) { break; }
        }
    } else {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                dbgs() << " - Destination register not changed.\n";
            }
        }
            if !(false) { break; }
        }
    }
    return Changed;
}

fn AArch64A57FPLoadBalancingImpl::scanInstruction(self, MI: *mut MachineInstr, Idx: u32, ActiveChains: *mut map<unsigned int, Chain *>, AllChains: *mut []unique_ptr<Chain>) {
    if isMul(MI) {
        for I in MI.uses() {
            self.maybeKillChain(*MI, I, Idx, ActiveChains);
        }
        for I in MI.defs() {
            self.maybeKillChain(*MI, I, Idx, ActiveChains);
        }
        let mut DestReg: Register = MI.getOperand(0).getReg();
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                dbgs() << "New chain started for register " << printReg(DestReg, self.TRI, 0, null) << " at " << *MI;
            }
        }
            if !(false) { break; }
        }
        let mut G: Chain> = make_unique(MI, Idx, self.getColor(DestReg.operator unsigned int()));
        ActiveChains[DestReg.operator unsigned int()] = G.get();
        AllChains.push(move(G));
    } else if isMla(MI) {
        let mut DestReg: Register = MI.getOperand(0).getReg();
        let mut AccumReg: Register = MI.getOperand(3).getReg();
        self.maybeKillChain(*MI, MI.getOperand(1), Idx, ActiveChains);
        self.maybeKillChain(*MI, MI.getOperand(2), Idx, ActiveChains);
        if DestReg != AccumReg {
            self.maybeKillChain(*MI, MI.getOperand(0), Idx, ActiveChains);
        }
        if !ActiveChains.find(AccumReg.operator unsigned int()) == ActiveChains.end() {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                    dbgs() << "Chain found for accumulator register " << printReg(AccumReg, self.TRI, 0, null) << " in MI " << *MI;
                }
            }
                if !(false) { break; }
            }
            if MI.getOperand(3).isKill() {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                        dbgs() << "Instruction was successfully added to chain.\n";
                    }
                }
                    if !(false) { break; }
                }
                ActiveChains[AccumReg.operator unsigned int()].add(MI, Idx, self.getColor(DestReg.operator unsigned int()));
                if DestReg != AccumReg {
                    ActiveChains[DestReg.operator unsigned int()] = ActiveChains[AccumReg.operator unsigned int()];
                    ActiveChains.erase(AccumReg.operator unsigned int());
                }
                return;
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                    dbgs() << "Cannot add to chain because accumulator operand wasn't " << "marked <kill>!\n";
                }
            }
                if !(false) { break; }
            }
            self.maybeKillChain(*MI, MI.getOperand(3), Idx, ActiveChains);
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                dbgs() << "Creating new chain for dest register " << printReg(DestReg, self.TRI, 0, null) << "\n";
            }
        }
            if !(false) { break; }
        }
        let mut G: Chain> = make_unique(MI, Idx, self.getColor(DestReg.operator unsigned int()));
        ActiveChains[DestReg.operator unsigned int()] = G.get();
        AllChains.push(move(G));
    } else {
        for I in MI.uses() {
            self.maybeKillChain(*MI, I, Idx, ActiveChains);
        }
        for I in MI.defs() {
            self.maybeKillChain(*MI, I, Idx, ActiveChains);
        }
    }
}

fn AArch64A57FPLoadBalancingImpl::maybeKillChain(self, MI: *mut MachineInstr, MO: *mut MachineOperand, Idx: u32, ActiveChains: *mut map<unsigned int, Chain *>) {
    if MO.isReg() {
        if MO.isKill() && !ActiveChains.find(MO.getReg().operator unsigned int()) == ActiveChains.end() {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                    dbgs() << "Kill seen for chain " << printReg(MO.getReg(), self.TRI, 0, null) << "\n";
                }
            }
                if !(false) { break; }
            }
            ActiveChains[MO.getReg().operator unsigned int()].setKill(&mut MI, Idx, MO.isTied());
        }
        ActiveChains.erase(MO.getReg().operator unsigned int());
    } else if MO.isRegMask() {
        for let mut I: iterator = ActiveChains.begin();
let mut E: iterator = ActiveChains.end(); !I == E;  {
            if MO.clobbersPhysReg(operator(I).first) {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-a57-fp-load-balancing", 1) {
                        dbgs() << "Kill (regmask) seen for chain " << printReg(operator(I).first, self.TRI, 0, null) << "\n";
                    }
                }
                    if !(false) { break; }
                }
                operator(I).second.setKill(&mut MI, Idx, true);
                ActiveChains.erase(operator(I, 0));
            } else {
                operator(I);
            }
        }
    }
}

fn AArch64A57FPLoadBalancingImpl::getColor(self, Reg: u32) -> Color {
    if (self.TRI.getEncodingValue(Reg) % 2) == 0 {
        return Even;
    } else {
        return Odd;
    }
}

fn createAArch64A57FPLoadBalancingLegacyPass() -> *mut FunctionPass {
    return AArch64A57FPLoadBalancingLegacy {};
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, A: *[]*mut Chain, B: *[]*mut Chain) -> bool {
        return A.front().startsBefore(B.front());
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, G1: *Chain, G2: *Chain) -> bool {
        if G1.len != G2.len {
            return G1.len > G2.len;
        }
        if G1.requiresFixup() != G2.requiresFixup() {
            return G1.requiresFixup() > G2.requiresFixup();
        }
        assert!((G1 == G2 || (G1.startsBefore(G2) ^ G2.startsBefore(G1))), "Starts before not total order!");
        return G1.startsBefore(G2);
    }
