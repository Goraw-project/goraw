static mut TransformAll: opt<bool> = opt<bool> { "aarch64-a57-fp-load-balancing-force-all", "Always modify dest registers regardless of color", init(false), Hidden };

static mut OverrideBalance: opt<unsigned int> = opt<unsigned int> { "aarch64-a57-fp-load-balancing-override", "Ignore balance information, always return (1: Even, 2: Odd).", init(0), Hidden };

fn isMul(MI: *mut MachineInstr) -> bool {
    match MI.getOpcode() {
        FMULSrr => {
            FNMULSrr;
        },
        _ => {
            return false;
        },
    }
}

fn isMla(MI: *mut MachineInstr) -> bool {
    match MI.getOpcode() {
        FMSUBSrrr => {
            FMADDSrrr;
        },
        _ => {
            return false;
        },
    }
}

enum Color {
    Even = 0,
    Odd = 1,
}

const ColorNames: [2]*mut u8 = ["Even", "Odd"];

struct AArch64A57FPLoadBalancingImpl {
    MRI: *mut MachineRegisterInfo,
    TRI: *TargetRegisterInfo,
    RCI: *mut RegisterClassInfo,
}

struct AArch64A57FPLoadBalancingLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64A57FPLoadBalancingLegacy::getRequiredProperties(self: *AArch64A57FPLoadBalancingLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn AArch64A57FPLoadBalancingLegacy::getPassName(self: *AArch64A57FPLoadBalancingLegacy) -> str {
    return "A57 FP Anti-dependency breaker";
}

fn AArch64A57FPLoadBalancingLegacy::getAnalysisUsage(self: *AArch64A57FPLoadBalancingLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU.addRequired();
    self.getAnalysisUsage(AU);
}

fn AArch64A57FPLoadBalancingLegacy::getPassKind(self: *AArch64A57FPLoadBalancingLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64A57FPLoadBalancingLegacy::getPassID(self: *AArch64A57FPLoadBalancingLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64A57FPLoadBalancingLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64A57FPLoadBalancingLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64A57FPLoadBalancingLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64A57FPLoadBalancingLegacy::getResolver(self: *AArch64A57FPLoadBalancingLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64A57FPLoadBalancingLegacy::getSetProperties(self: *AArch64A57FPLoadBalancingLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
