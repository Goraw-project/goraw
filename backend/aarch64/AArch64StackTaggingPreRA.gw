enum UncheckedLdStMode {
    UncheckedNever = 0,
    UncheckedSafe = 1,
    UncheckedAlways = 2,
}

static mut ClUncheckedLdSt: opt<UncheckedLdStMode> = opt<UncheckedLdStMode> { "stack-tagging-unchecked-ld-st", Hidden, init(UncheckedSafe), "Unconditionally apply unchecked-ld-st optimization (even for large stack frames, or in the presence of variable sized allocas).", values(OptionEnumValue { Name: "never", Value: UncheckedNever, Description: "never apply unchecked-ld-st" }, OptionEnumValue { Name: "safe", Value: UncheckedSafe, Description: "apply unchecked-ld-st when the target is definitely within range" }, OptionEnumValue { Name: "always", Value: UncheckedAlways, Description: "always apply unchecked-ld-st" }) };

static mut ClFirstSlot: opt<bool> = opt<bool> { "stack-tagging-first-slot-opt", Hidden, init(true), "Apply first slot optimization for stack tagging (eliminate ADDG Rt, Rn, 0, 0)." };

struct AArch64StackTaggingPreRAImpl {
    MF: *mut MachineFunction,
    AFI: *mut AArch64FunctionInfo,
    MFI: *mut MachineFrameInfo,
    MRI: *mut MachineRegisterInfo,
    TRI: *AArch64RegisterInfo,
    TII: *AArch64InstrInfo,
    ReTags: SmallVector<MachineInstr *, 16>,
}

struct AArch64StackTaggingPreRALegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64StackTaggingPreRALegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    return AArch64StackTaggingPreRAImpl {}.run(MF);
}

fn AArch64StackTaggingPreRALegacy::getPassName(self: *AArch64StackTaggingPreRALegacy) -> str {
    return "AArch64 Stack Tagging PreRA";
}

fn AArch64StackTaggingPreRALegacy::getAnalysisUsage(self: *AArch64StackTaggingPreRALegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage(AU);
}

fn AArch64StackTaggingPreRALegacy::getPassKind(self: *AArch64StackTaggingPreRALegacy) -> PassKind {
    return self.Kind;
}

fn AArch64StackTaggingPreRALegacy::getPassID(self: *AArch64StackTaggingPreRALegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64StackTaggingPreRALegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64StackTaggingPreRALegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64StackTaggingPreRALegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64StackTaggingPreRALegacy::getResolver(self: *AArch64StackTaggingPreRALegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64StackTaggingPreRALegacy::getRequiredProperties(self: *AArch64StackTaggingPreRALegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64StackTaggingPreRALegacy::getSetProperties(self: *AArch64StackTaggingPreRALegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64StackTaggingPreRALegacy::getClearedProperties(self: *AArch64StackTaggingPreRALegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createAArch64StackTaggingPreRALegacyPass() -> *mut FunctionPass {
    return AArch64StackTaggingPreRALegacy {};
}

fn AArch64StackTaggingPreRAPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    if AArch64StackTaggingPreRAImpl {}.run(MF) {
        let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
        PA.preserveSet();
        return PA;
    }
    return all();
}

fn isUncheckedLoadOrStoreOpcode(Opcode: u32) -> bool {
    match Opcode {
        LDRBBui => {
            LDRHHui;
        },
        _ => {
            return false;
        },
    }
}

fn AArch64StackTaggingPreRAImpl::mayUseUncheckedLoadStore(self) -> bool {
    if ClUncheckedLdSt.operator UncheckedLdStMode() == UncheckedNever {
        return false;
    } else if ClUncheckedLdSt.operator UncheckedLdStMode() == UncheckedAlways {
        return true;
    }
    let mut FrameSize: u32 = 0;
    for let mut i: u32 = 0;
let mut e: u32 = self.MFI.getObjectIndexEnd(); i != e; i += 1 {
        FrameSize += self.MFI.getObjectSize(i);
    }
    let mut EntireFrameReachableFromSP: bool = FrameSize < 3840;
    return !self.MFI.hasVarSizedObjects() && EntireFrameReachableFromSP;
}

fn AArch64StackTaggingPreRAImpl::uncheckUsesOf(self, TaggedReg: u32, FI: i32) {
    for UseI in make_early_inc_range(self.MRI.use_instructions(TaggedReg)) {
        if isUncheckedLoadOrStoreOpcode(UseI.getOpcode()) {
            let mut OpIdx: u32 = self.TII.getLoadStoreImmIdx(UseI.getOpcode()) - 1;
            if UseI.getOperand(OpIdx).isReg() && UseI.getOperand(OpIdx).getReg() == TaggedReg {
                UseI.getOperand(OpIdx).ChangeToFrameIndex(FI, 0);
                UseI.getOperand(OpIdx).setTargetFlags(MO_TAGGED);
            }
        } else if UseI.isCopy() && UseI.getOperand(0).getReg().isVirtual() {
            self.uncheckUsesOf(UseI.getOperand(0).getReg().operator unsigned int(), FI);
        }
    }
}

fn AArch64StackTaggingPreRAImpl::uncheckLoadsAndStores(self) {
    for I in self.ReTags {
        let mut TaggedReg: Register = I.getOperand(0).getReg();
        let mut FI: i32 = I.getOperand(1).getIndex();
        self.uncheckUsesOf(TaggedReg.operator unsigned int(), FI);
    }
}

struct SlotWithTag {
    FI: i32,
    Tag: i32,
}

fn SlotWithTag::operator==(self: *SlotWithTag, Other: *SlotWithTag) -> bool {
    return self.FI == Other.FI && self.Tag == Other.Tag;
}

fn SlotWithTag::operator=(self, arg: *SlotWithTag) -> *mut SlotWithTag {
    self.FI = .FI;
    self.Tag = .Tag;
    return *self;
}

fn isSlotPreAllocated(MFI: *mut MachineFrameInfo, FI: i32) -> bool {
    return MFI.getUseLocalStackAllocationBlock() && MFI.isObjectPreAllocated(FI);
}

fn AArch64StackTaggingPreRAImpl::findFirstSlotCandidate(self) -> optional<int> {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-stack-tagging-pre-ra", 1) {
            dbgs() << "AArch64StackTaggingPreRAImpl::findFirstSlotCandidate\n";
        }
    }
        if !(false) { break; }
    }
    if !ClFirstSlot {
        return nullopt;
    }
    let mut RetagScore: DenseMap<SlotWithTag, int> = DenseMap<SlotWithTag, int> {};
    let mut MaxScoreST: SlotWithTag = SlotWithTag { FI: -1, Tag: -1 };
    let mut MaxScore: i32 = -1;
    for I in self.ReTags {
        let mut ST: SlotWithTag = *I;
        if isSlotPreAllocated(self.MFI, ST.FI) {
            continue;
        }
        let mut RetagReg: Register = I.getOperand(0).getReg();
        if !RetagReg.isVirtual() {
            continue;
        }
        let mut Score: i32 = 0;
        let mut WorkList: SmallVector<Register, 8> = SmallVector<Register, 8> {};
        WorkList.push(RetagReg);
        while !WorkList.is_empty() {
            let mut UseReg: Register = WorkList.pop_back_val();
            for UseI in self.MRI.use_instructions(UseReg) {
                let mut Opcode: u32 = UseI.getOpcode();
                if Opcode == STGi || Opcode == ST2Gi || Opcode == STZGi || Opcode == STZ2Gi || Opcode == STGPi || Opcode == STGloop || Opcode == STZGloop || Opcode == STGloop_wback || Opcode == STZGloop_wback {
                    continue;
                }
                if UseI.isCopy() {
                    let mut DstReg: Register = UseI.getOperand(0).getReg();
                    if DstReg.isVirtual() {
                        WorkList.push(DstReg);
                    }
                    continue;
                }
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-stack-tagging-pre-ra", 1) {
                        dbgs() << "[" << ST.FI << ":" << ST.Tag << "] use of " << printReg(UseReg, null, 0, null) << " in " << UseI << "\n";
                    }
                }
                    if !(false) { break; }
                }
                Score += 1;
            }
        }
        let mut TotalScore: i32 = RetagScore[ST] += Score;
        if TotalScore > MaxScore || (TotalScore == MaxScore && ST.FI > MaxScoreST.FI) {
            MaxScore = TotalScore;
            MaxScoreST = ST;
        }
    }
    if MaxScoreST.FI < 0 {
        return nullopt;
    }
    if MaxScoreST.Tag == 0 {
        return MaxScoreST.FI;
    }
    let mut SwapST: SlotWithTag = SlotWithTag { FI: -1, Tag: -1 };
    for I in self.ReTags {
        let mut ST: SlotWithTag = *I;
        if ST.Tag == 0 {
            SwapST = ST;
            break;
        }
    }
    for I in self.ReTags {
        let mut ST: SlotWithTag = *I;
        let mut TagOp: *mut MachineOperand = I.getOperand(4);
        if ST == MaxScoreST {
            TagOp.setImm(0);
        } else if ST == SwapST {
            TagOp.setImm(MaxScoreST.Tag);
        }
    }
    return MaxScoreST.FI;
}

fn AArch64StackTaggingPreRAImpl::run(self, Func: *mut MachineFunction) -> bool {
    self.MF = &mut Func;
    self.MRI = &mut self.MF.getRegInfo();
    self.AFI = self.MF.getInfo();
    self.TII = self.MF.getSubtarget().getInstrInfo() as *AArch64InstrInfo;
    self.TRI = self.MF.getSubtarget().getRegisterInfo() as *AArch64RegisterInfo;
    self.MFI = &mut self.MF.getFrameInfo();
    self.ReTags.clear();
    assert!(self.MRI.isSSA();
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-stack-tagging-pre-ra", 1) {
            dbgs() << "********** AArch64 Stack Tagging PreRA **********\n" << "********** Function: " << self.MF.getName() << 10;
        }
    }
        if !(false) { break; }
    }
    let mut TaggedSlots: SmallSetVector<int, 8> = SmallSetVector<int, 8> {};
    for BB in *self.MF {
        for I in BB {
            if I.getOpcode() == TAGPstack {
                self.ReTags.push(&mut I);
                let mut FI: i32 = I.getOperand(1).getIndex();
                TaggedSlots.insert(FI);
                assert!(I.getOperand(2).getImm() == 0);
            }
        }
    }
    for FI in TaggedSlots {
        self.MFI.setObjectSSPLayout(FI, SSPLK_None);
    }
    if self.ReTags.is_empty() {
        return false;
    }
    if self.mayUseUncheckedLoadStore() {
        self.uncheckLoadsAndStores();
    }
    let mut BaseSlot: optional<int> = self.findFirstSlotCandidate();
    if BaseSlot {
        self.AFI.setTaggedBasePointerIndex(operator(BaseSlot));
    }
    for I in self.ReTags {
        let mut FI: i32 = I.getOperand(1).getIndex();
        let mut Tag: i32 = I.getOperand(4).getImm();
        let mut Base: Register = I.getOperand(3).getReg();
        if Tag == 0 && FI == BaseSlot {
            BuildMI(*I.getParent(), I, MIMetadata {}, self.TII.get(COPY), I.getOperand(0).getReg()).addReg(Base, RegState {}, 0);
            I.eraseFromParent();
        }
    }
    return true;
}
