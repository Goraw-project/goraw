    InsInstrs: *mut SmallVectorImpl<MachineInstr *>,
}

unsafe fn Closure_22::call(self: *mut Closure_22, OriginalInstr: *mut MachineInstr, SrcRegister: Register, Lane: u32, OffsetRegister: Register, OffsetRegisterKillState: bool) -> Register {
        let mut NewRegister: Register = (*self.MRI).createVirtualRegister((*self.FPR128RegClass), "");
        let mut LoadIndexIntoRegister: MachineInstrBuilder = BuildMI((*self.MF), *OriginalInstr, (*self.TII).get((*self.Root).getOpcode()), NewRegister).addReg(SrcRegister, RegState {}, 0).addImm(Lane).addReg(OffsetRegister, getKillRegState(OffsetRegisterKillState), 0).setMemRefs(OriginalInstr.memoperands());
        (*self.InstrIdxForVirtReg).insert(make_pair(NewRegister, (*self.InsInstrs).len));
        (*self.InsInstrs).push(LoadIndexIntoRegister.operator llvm::MachineInstr *());
        return NewRegister;
    }

struct Closure_23 {
    MF: *mut MachineFunction,
    Root: *mut MachineInstr,
    TII: *mut *TargetInstrInfo,
}

unsafe fn Closure_23::call(self: *mut Closure_23, NumLanes: u32, DestReg: Register, OffsetReg: Register, MMOs: ArrayRef<MachineMemOperand *>) -> auto {
        let mut Opcode: u32 = 0;
        match NumLanes {
            4 => {
                Opcode = LDRSui;
            },
            8 => {
                Opcode = LDRHui;
            },
            16 => {
                Opcode = LDRBui;
            },
            _ => {
                llvm_unreachable_internal("Got unsupported number of lanes in machine-combiner gather pattern", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 8657);
            },
        }
        return BuildMI((*self.MF), (*self.Root), (*self.TII).get(Opcode), DestReg).addReg(OffsetReg, RegState {}, 0).addImm(0).setMemRefs(MMOs);
    }

