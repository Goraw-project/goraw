    return () == G_PTR_ADD;
}

fn AArch64InstrInfo::getElementSizeForOpcode(self: *AArch64InstrInfo, Opc: u32) -> u64 {
    return get(Opc) & ElementSizeMask;
}

fn AArch64InstrInfo::isPTestLikeOpcode(self: *AArch64InstrInfo, Opc: u32) -> bool {
    return get(Opc) & InstrFlagIsPTestLike;
}

fn AArch64InstrInfo::isWhileOpcode(self: *AArch64InstrInfo, Opc: u32) -> bool {
    return get(Opc) & InstrFlagIsWhile;
}

fn AArch64InstrInfo::getTailDuplicateSize(self: *AArch64InstrInfo, OptLevel: CodeGenOptLevel) -> u32 {
    return if OptLevel >= Aggressive { 6 } else { 2 };
}

fn AArch64InstrInfo::isLegalAddressingMode(self: *AArch64InstrInfo, NumBytes: u32, Offset: i64, Scale: u32) -> bool {
    if Offset && Scale {
        return false;
    }
    if !Scale {
        if isInt(Offset) {
            return true;
        }
        let mut Shift: u32 = Log2_64(NumBytes);
        if NumBytes && Offset > 0 && (Offset / NumBytes) <= (1 << 12) - 1 && (Offset >> Shift) << Shift == Offset {
            return true;
        }
        return false;
    }
    return Scale == 1 || (Scale > 0 && Scale == NumBytes);
}

fn getBLRCallOpcode(MF: *MachineFunction) -> u32 {}

fn AArch64InstrInfo::createPauthEpilogueInstr(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, DL: DebugLoc) {
    let mut InsertPt: i32 = MBB()();
    let mut Builder: auto = BuildMI(MBB, DL, get())(FrameDestroy);
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut AFI: *auto = MF;
    let mut AFL: *AArch64FrameLowering = *MF.getSubtarget().getFrameLowering() as *AArch64FrameLowering;
    if AFL.getArgumentStackToRestore(MF, MBB) {
        Builder();
        Builder();
        if AFI()() {
            Builder();
        }
        return;
    }
    if AFI()() && operator!(self.Subtarget()) {
        Builder();
    }
}

fn AArch64InstrInfo::probedStackAlloc(self: *AArch64InstrInfo, MBBI: i32, TargetReg: Register, FrameSetup: bool) -> i32 {
    let mut MBB: *mut MachineBasicBlock = operator*();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut TII: *AArch64InstrInfo = MF();
    let mut ProbeSize: i64 = MF();
    let mut DL: DebugLoc = MBB()();
    let mut MBBInsertPoint: i32 = next(MBB()());
    let mut LoopTestMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    MF()(LoopTestMBB);
    let mut LoopBodyMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    MF()(LoopBodyMBB);
    let mut ExitMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    MF()(ExitMBB);
    let mut Flags: MIFlag = if FrameSetup {} else { NoFlags };
    emitFrameOffset(*LoopTestMBB, LoopTestMBB()(), DL, getFixed(-ProbeSize), TII, Flags);
    BuildMI(*LoopTestMBB, LoopTestMBB()(), DL, TII())(TargetReg)(getArithExtendImm(UXTX, 0))(Flags);
    BuildMI(*LoopTestMBB, LoopTestMBB()(), DL, TII())(LE)(ExitMBB)(Flags);
    BuildMI(*LoopBodyMBB, LoopBodyMBB()(), DL, TII())(0)(MF)(Flags);
    BuildMI(*LoopBodyMBB, LoopBodyMBB()(), DL, TII())(LoopTestMBB)(Flags);
    BuildMI(*ExitMBB, ExitMBB()(), DL, TII())(TargetReg)(0)(getShifterImm(LSL, 0))(Flags);
    BuildMI(*ExitMBB, ExitMBB()(), DL, TII())(0)(Flags);
    ExitMBB()(ExitMBB()(), &mut MBB, next(), MBB()());
    ExitMBB.transferSuccessorsAndUpdatePHIs(&mut MBB);
    LoopTestMBB.addSuccessor(ExitMBB, getUnknown());
    LoopTestMBB.addSuccessor(LoopBodyMBB, getUnknown());
    LoopBodyMBB.addSuccessor(LoopTestMBB, getUnknown());
    MBB.addSuccessor(LoopTestMBB, getUnknown());
    if MF.getRegInfo().reservedRegsFrozen() {
        fullyRecomputeLiveIns(void { ExitMBB, LoopBodyMBB, LoopTestMBB });
    }
    return ExitMBB()();
}

