    assert!(MI.getParent(), "Incomplete machine instruction\n");
    let mut MBB: *mut MachineBasicBlock = MI.getParent();
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut MRI: *mut MachineRegisterInfo = &mut MF.getRegInfo();
    let mut VReg: Register = MI.getOperand(0).getReg();
    if !VReg.isVirtual() {
        return false;
    }
    let mut DefMI: *mut MachineInstr = MRI.getVRegDef(VReg);
    if !DefMI {
        return false;
    }
    while DefMI.isCopy() {
        let mut CopyVReg: Register = DefMI.getOperand(1).getReg();
        if !CopyVReg.isVirtual() {
            return false;
        }
        if !MRI.hasOneNonDBGUse(CopyVReg) {
            return false;
        }
        DefMI = MRI.getVRegDef(CopyVReg);
        if !DefMI {
            return false;
        }
    }
    match DefMI.getOpcode() {
        _ => {
            return false;
        },
    }
}

