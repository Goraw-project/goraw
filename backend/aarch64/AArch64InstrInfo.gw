fn AArch64InstrInfo::isCandidateToMergeOrPair(self: *AArch64InstrInfo, MI: *MachineInstr) -> bool {
    let mut IsPreLdSt: bool = isPreLdSt(MI);
    if MI.hasOrderedMemoryRef() {
        return false;
    }
    assert!((MI.getOperand(if IsPreLdSt { 2 } else { 1 }).isReg() || MI.getOperand(if IsPreLdSt { 2 } else { 1 }).isFI()), "Expected a reg or frame index operand.");
    let mut IsImmPreLdSt: bool = IsPreLdSt && MI.getOperand(3).isImm();
    if !MI.getOperand(2).isImm() && !IsImmPreLdSt {
        return false;
    }
    if MI.getOperand(1).isReg() && !IsPreLdSt {
        let mut BaseReg: Register = MI.getOperand(1).getReg();
        let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
        if MI.modifiesRegister(BaseReg, TRI) {
            return false;
        }
    }
    match MI.getOpcode() {
        _ => {
            break;
        },
        LDR_ZXI => {
            STR_ZXI;
        },
    }
    if isLdStPairSuppressed(MI) {
        return false;
    }
    let mut MAI: *MCAsmInfo = MI.getMF().getTarget().getMCAsmInfo();
    let mut NeedsWinCFI: bool = MAI.usesWindowsCFI() && MI.getMF().getFunction().needsUnwindTableEntry();
    if NeedsWinCFI && (MI.getFlag(FrameSetup) || MI.getFlag(FrameDestroy)) {
        return false;
    }
    if self.Subtarget.isPaired128Slow() {
        match MI.getOpcode() {
            _ => {
                break;
            },
            LDURQi => {
                STURQi;
            },
        }
    }
    return true;
}

fn AArch64InstrInfo::getMemOperandsWithOffsetWidth(self: *AArch64InstrInfo, LdSt: *MachineInstr, BaseOps: *SmallVectorImpl<const MachineOperand *>, Offset: *mut i64, OffsetIsScalable: *mut bool, Width: *mut LocationSize, TRI: *TargetRegisterInfo) -> bool {
    if !LdSt.mayLoadOrStore(AnyInBundle) {
        return false;
    }
    let mut BaseOp: *MachineOperand = null;
    let mut WidthN: TypeSize = TypeSize { 0, false };
    if !self.getMemOperandWithOffsetWidth(LdSt, BaseOp, Offset, OffsetIsScalable, WidthN, TRI) {
        return false;
    }
    Width = precise(WidthN);
    BaseOps.push(BaseOp);
    return true;
}

fn AArch64InstrInfo::getAddrModeFromMemoryOp(self: *AArch64InstrInfo, MemI: *MachineInstr, TRI: *TargetRegisterInfo) -> optional<ExtAddrMode> {
    let mut Base: *MachineOperand = null;
    let mut Offset: i64 = 0;
    let mut OffsetIsScalable: bool = false;
    if !self.getMemOperandWithOffset(MemI, Base, Offset, OffsetIsScalable, TRI) {
        return nullopt;
    }
    if !Base.isReg() {
        return nullopt;
    }
    let mut AM: ExtAddrMode = ExtAddrMode {};
    AM.BaseReg = Base.getReg();
    AM.Displacement = Offset;
    AM.ScaledReg = 0;
    AM.Scale = 0;
    return AM;
}

fn AArch64InstrInfo::canFoldIntoAddrMode(self: *AArch64InstrInfo, MemI: *MachineInstr, Reg: Register, AddrI: *MachineInstr, AM: *mut ExtAddrMode) -> bool {
    let mut NumBytes: u32 = 0;
    let mut OffsetScale: i64 = 1;
    match MemI.getOpcode() {
        _ => {
            return false;
        },
        LDURQi => {
            STURQi;
        },
        LDURDi => {
            STURDi;
        },
        LDURWi => {
            LDURSWi;
        },
        LDURHi => {
            STURHi;
        },
        LDRBroX => {
            LDRBBroX;
        },
        LDRQroX => {
            STRQroX;
        },
        LDRDroX => {
            STRDroX;
        },
        LDRWroX => {
            LDRSWroX;
        },
        LDRHroX => {
            STRHroX;
        },
    }
    let mut BaseRegOp: *MachineOperand = MemI.getOperand(0);
    if BaseRegOp.isReg() && BaseRegOp.getReg() == Reg {
        return false;
    }
    if MemI.getOperand(2).isReg() {
        if MemI.getOperand(3).getImm() {
            return false;
        }
        if MemI.getOperand(4).getImm() == 0 {
            OffsetScale = 1;
        }
        if MemI.getOperand(1).getReg() == Reg && OffsetScale != 1 {
            return false;
        }
        match AddrI.getOpcode() {
            _ => {
                return false;
            },
            SBFMXri => {
                if AddrI.getOperand(2).getImm() != 0 || AddrI.getOperand(3).getImm() != 31 {
                    return false;
                }
            },
            SUBREG_TO_REG => {
                if AddrI.getOperand(2).getImm() != sub_32 {
                    return false;
                }
                let mut MRI: *MachineRegisterInfo = AddrI.getMF().getRegInfo();
                let mut OffsetReg: Register = AddrI.getOperand(1).getReg();
                if !OffsetReg.isVirtual() || !MRI.hasOneNonDBGUse(OffsetReg) {
                    return false;
                }
                let mut DefMI: *MachineInstr = *MRI.getVRegDef(OffsetReg);
                if DefMI.getOpcode() != ORRWrs || DefMI.getOperand(1).getReg() != WZR || DefMI.getOperand(3).getImm() != 0 {
                    return false;
                }
                AM.BaseReg = MemI.getOperand(1).getReg();
                if AM.BaseReg == Reg {
                    AM.BaseReg = MemI.getOperand(2).getReg();
                }
                AM.ScaledReg = DefMI.getOperand(2).getReg();
                AM.Scale = OffsetScale;
                AM.Displacement = 0;
                AM.Form = ZExtScaledReg;
                return true;
            },
        }
    }
    let mut validateOffsetForLDP: Closure_6 = Closure_6 {};
    let mut canFoldAddSubImmIntoAddrMode: Closure_7 = Closure_7 { MemI: &mut MemI, OffsetScale: &mut OffsetScale, cap_2: self, NumBytes: &mut NumBytes, validateOffsetForLDP: &mut validateOffsetForLDP, AM: &mut AM, AddrI: &mut AddrI };
    let mut canFoldAddRegIntoAddrMode: Closure_8 = Closure_8 { MemI: &mut MemI, cap_1: self, NumBytes: &mut NumBytes, AM: &mut AM, AddrI: &mut AddrI };
    let mut avoidSlowSTRQ: Closure_9 = Closure_9 { cap_0: self };
    let mut Disp: i64 = 0;
    let mut OptSize: bool = MemI.getMF().getFunction().hasOptSize();
    match AddrI.getOpcode() {
        _ => {
            return false;
        },
        ADDXri => {
            Disp = AddrI.getOperand(2).getImm() << AddrI.getOperand(3).getImm();
        },
        SUBXri => {
            Disp = AddrI.getOperand(2).getImm() << AddrI.getOperand(3).getImm();
        },
        ADDXrs => {
            let mut Shift: u32 = AddrI.getOperand(3).getImm() as u32;
            if getShiftType(Shift) != LSL {
                return false;
            }
            Shift = getShiftValue(Shift);
            if !OptSize {
                if Shift != 2 && Shift != 3 && self.Subtarget.hasAddrLSLSlow14() {
                    return false;
                }
                if avoidSlowSTRQ.call(MemI) {
                    return false;
                }
            }
            return canFoldAddRegIntoAddrMode.call(1 << Shift, Basic);
        },
        ADDXrr => {
            if !OptSize && avoidSlowSTRQ.call(MemI) {
                return false;
            }
        },
        ADDXrx => {
            if !OptSize && avoidSlowSTRQ.call(MemI) {
                return false;
            }
        },
    }
}

