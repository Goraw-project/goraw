static mut NumCopyInstrs: Statistic = Statistic { "AArch64InstrInfo", "NumCopyInstrs", "Number of COPY instructions expanded" };

static mut NumZCRegMoveInstrsGPR: Statistic = Statistic { "AArch64InstrInfo", "NumZCRegMoveInstrsGPR", "Number of zero-cycle GPR register move instructions expanded from canonical COPY" };

static mut NumZCRegMoveInstrsFPR: Statistic = Statistic { "AArch64InstrInfo", "NumZCRegMoveInstrsFPR", "Number of zero-cycle FPR register move instructions expanded from canonical COPY" };

static mut NumZCZeroingInstrsGPR: Statistic = Statistic { "AArch64InstrInfo", "NumZCZeroingInstrsGPR", "Number of zero-cycle GPR zeroing instructions expanded from canonical COPY" };

static mut CBDisplacementBits: opt<unsigned int> = opt<unsigned int> { "aarch64-cb-offset-bits", Hidden, init(9), "Restrict range of CB instructions (DEBUG)" };

static mut TBZDisplacementBits: opt<unsigned int> = opt<unsigned int> { "aarch64-tbz-offset-bits", Hidden, init(14), "Restrict range of TB[N]Z instructions (DEBUG)" };

static mut CBZDisplacementBits: opt<unsigned int> = opt<unsigned int> { "aarch64-cbz-offset-bits", Hidden, init(19), "Restrict range of CB[N]Z instructions (DEBUG)" };

static mut BCCDisplacementBits: opt<unsigned int> = opt<unsigned int> { "aarch64-bcc-offset-bits", Hidden, init(19), "Restrict range of Bcc instructions (DEBUG)" };

static mut BDisplacementBits: opt<unsigned int> = opt<unsigned int> { "aarch64-b-offset-bits", Hidden, init(26), "Restrict range of B instructions (DEBUG)" };

static mut GatherOptSearchLimit: opt<unsigned int> = opt<unsigned int> { "aarch64-search-limit", Hidden, init(2048), "Restrict range of instructions to search for the machine-combiner gather pattern optimization" };

static mut UseCompactUnwindFrameRecordForOutlinedFunctions: opt<bool> = opt<bool> { "aarch64-outliner-compact-unwind-frame", Hidden, init(true), "Use a frame record for Mach-O non-leaf outlined functions" };

fn getLFIInstSizeInBytes(MI: *MachineInstr) -> optional<unsigned int> {
    match MI.getOpcode() {
        SVC => {
            return 16;
        },
        BR => {
            BLR;
        },
        RET => {
            return 8;
        },
        RETAA => {
            RETAB;
        },
        BRAA => {
            BRAAZ;
        },
        AUTIASP => {
            AUTIBSP;
        },
        SYSxt => {
            if MI.getOperand(0).getImm() == 3 && MI.getOperand(1).getImm() == 7 && MI.getOperand(3).getImm() == 1 {
                return 8;
            }
        },
        _ => {
            break;
        },
    }
    let mut ModifiesLR: bool = false;
    let mut ModifiesSP: bool = false;
    for MO in MI.defs() {
        if !MO.isReg() {
            continue;
        }
        if MO.getReg() == LR {
            ModifiesLR = true;
        } else if MO.getReg() == SP {
            ModifiesSP = true;
        }
    }
    if MI.mayLoadOrStore(AnyInBundle) {
        let mut Size: u32 = if isLFIPrePostMemAccess(MI.getOpcode()) { 12 } else { 8 };
        if ModifiesLR {
            Size += 4;
        }
        return Size;
    }
    if ModifiesSP || ModifiesLR {
        return 8;
    }
    return nullopt;
}

fn AArch64InstrInfo::getInstSizeInBytes(self: *AArch64InstrInfo, MI: *MachineInstr) -> u32 {
    let mut Desc: *MCInstrDesc = MI.getDesc();
    if !Desc.isPseudo() && !self.Subtarget.isLFI() {
        assert!(Desc.getSize() == 4, "Unexpected instruction size");
        return 4;
    }
    let mut MBB: *MachineBasicBlock = *MI.getParent();
    let mut MF: *MachineFunction = MBB.getParent();
    let mut F: *Function = MF.getFunction();
    let mut MAI: *MCAsmInfo = MF.getTarget().getMCAsmInfo();
    {
        let mut Op: u32 = MI.getOpcode();
        if Op == INLINEASM || Op == INLINEASM_BR {
            return self.getInlineAsmLength(MI.getOperand(0).getSymbolName(), MAI, null);
        }
    }
    if MI.isMetaInstruction(IgnoreBundle) {
        return 0;
    }
    let mut NumBytes: u32 = 0;
    let mut STI: *AArch64Subtarget const = MF.getSubtarget();
    if STI.isLFI() {
        if getLFIInstSizeInBytes(MI) {
            Size;
        } else {
            return operator(Size);
        }
    }
    if !MI.isBundle() && isTailCallReturnInst(MI) {
        NumBytes = if Desc.getSize() { Desc.getSize() } else { 4 };
        let mut MFI: *AArch64FunctionInfo const = MF.getInfo();
        if !MFI.shouldSignReturnAddress(*MF) {
            return NumBytes;
        }
        let mut Method: AuthCheckMethod = STI.getAuthenticatedLRCheckMethod(*MF);
        NumBytes += getCheckerSizeInBytes(Method);
        return NumBytes;
    }
    match Desc.getOpcode() {
        _ => {
            if Desc.getSize() {
                return Desc.getSize();
            }
        },
        STACKMAP => {
            NumBytes = &mut MI.getNumPatchBytes();
        },
        PATCHPOINT => {
            NumBytes = &mut MI.getNumPatchBytes();
        },
        STATEPOINT => {
            NumBytes = &mut MI.getNumPatchBytes();
        },
        PATCHABLE_FUNCTION_ENTER => {
            NumBytes = F.getFnAttributeAsParsedInteger("patchable-function-entry", 9) * 4;
        },
        PATCHABLE_FUNCTION_EXIT => {
            PATCHABLE_TAIL_CALL;
        },
        PATCHABLE_EVENT_CALL => {
            NumBytes = 24;
        },
        SPACE => {
            NumBytes = MI.getOperand(1).getImm();
        },
        MOVaddr => {
            MOVaddrJT;
        },
        MOVi32imm => {
            MOVi64imm;
        },
        BUNDLE => {
            NumBytes = self.getInstBundleSize(MI);
        },
    }
    return NumBytes;
}

fn parseCondBranch(LastInst: *mut MachineInstr, Target: *mut *mut MachineBasicBlock, Cond: *mut SmallVectorImpl<MachineOperand>) {
    match LastInst.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unknown branch instruction?", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 338);
        },
        Bcc => {
            Target = LastInst.getOperand(1).getMBB();
        },
        CBZW => {
            CBZX;
        },
        TBZW => {
            TBZX;
        },
        CBWPri => {
            CBXPri;
        },
        CBBAssertExt => {
            CBHAssertExt;
        },
    }
}

fn getBranchDisplacementBits(Opc: u32) -> u32 {
    match Opc {
        _ => {
            llvm_unreachable_internal("unexpected opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 390);
        },
        B => {
            return BDisplacementBits.operator unsigned int();
        },
        TBNZW => {
            TBZW;
        },
        CBNZW => {
            CBZW;
        },
        Bcc => {
            return BCCDisplacementBits.operator unsigned int();
        },
        CBWPri => {
            CBXPri;
        },
    }
}

fn AArch64InstrInfo::isBranchOffsetInRange(self: *AArch64InstrInfo, BranchOp: u32, BrOffset: i64) -> bool {
    let mut Bits: u32 = getBranchDisplacementBits(BranchOp);
    assert!(Bits >= 3, "max branch displacement must be enough to jumpover conditional branch expansion");
    return isIntN(Bits, BrOffset / 4);
}

fn AArch64InstrInfo::getBranchDestBlock(self: *AArch64InstrInfo, MI: *MachineInstr) -> *mut MachineBasicBlock {
    match MI.getOpcode() {
        _ => {
            llvm_unreachable_internal("unexpected opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 427);
        },
        B => {
            return MI.getOperand(0).getMBB();
        },
        TBZW => {
            TBNZW;
        },
        CBZW => {
            CBNZW;
        },
        CBWPri => {
            CBXPri;
        },
    }
}

fn AArch64InstrInfo::insertIndirectBranch(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, NewDestBB: *mut MachineBasicBlock, RestoreBB: *mut MachineBasicBlock, DL: *DebugLoc, BrOffset: i64, RS: *mut RegScavenger) {
    assert!(RS, "RegScavenger required for long branching");
    assert!(MBB.is_empty(), "new block should be inserted for expanding unconditional branch");
    assert!(MBB.pred_size() == 1);
    assert!(RestoreBB.is_empty(), "restore block should be inserted for restoring clobbered registers");
    let mut buildIndirectBranch: Closure_1 = Closure_1 { BrOffset: &mut BrOffset, MBB: &mut MBB, DL: &mut DL, cap_3: self };
    RS.enterBasicBlockEnd(MBB);
    let mut Reg: Register = X16;
    if !RS.isRegUsed(Reg, true) {
        self.insertUnconditionalBranch(MBB, &mut NewDestBB, DL, null);
        RS.setRegUsed(Reg, getAll());
        return;
    }
    let mut AFI: *mut AArch64FunctionInfo = MBB.getParent().getInfo();
    let mut HasBTI: bool = AFI && AFI.branchTargetEnforcement();
    if MBB.getSectionID() == ColdSectionID && !HasBTI {
        let mut Scavenged: Register = RS.FindUnusedReg(&mut GPR64RegClass);
        if Scavenged.isValid() {
            buildIndirectBranch.call(Scavenged, NewDestBB);
            RS.setRegUsed(Scavenged, getAll());
            return;
        }
    }
    if !AFI || AFI.hasRedZone().value_or(true) {
        report_fatal_error("Unable to insert indirect branch inside function that has red zone", true);
    }
    BuildMI(MBB, MBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(STRXpre)).addReg(SP, Define, 0).addReg(Reg, RegState {}, 0).addReg(SP, RegState {}, 0).addImm(-16);
    BuildMI(MBB, MBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(B)).addMBB(&mut RestoreBB, 0);
    BuildMI(RestoreBB, RestoreBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRXpost)).addReg(SP, Define, 0).addReg(Reg, Define, 0).addReg(SP, RegState {}, 0).addImm(16);
}

fn AArch64InstrInfo::analyzeBranch(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, TBB: *mut *mut MachineBasicBlock, FBB: *mut *mut MachineBasicBlock, Cond: *mut SmallVectorImpl<MachineOperand>, AllowModify: bool) -> bool {
    let mut I: iterator = MBB.getLastNonDebugInstr(true);
    if I == MBB.end() {
        return false;
    }
    if operator(I).getOpcode() == SpeculationBarrierISBDSBEndBB || operator(I).getOpcode() == SpeculationBarrierSBEndBB {
        operator(I);
    }
    if !self.isUnpredicatedTerminator(operator(I)) {
        return false;
    }
    let mut LastInst: *mut MachineInstr = &mut operator(I);
    let mut LastOpc: u32 = LastInst.getOpcode();
    if I == MBB.begin() || !self.isUnpredicatedTerminator(operator(operator(I))) {
        if isUncondBranchOpcode(LastOpc) {
            TBB = LastInst.getOperand(0).getMBB();
            return false;
        }
        if isCondBranchOpcode(LastOpc) {
            parseCondBranch(LastInst, TBB, Cond);
            return false;
        }
        return true;
    }
    let mut SecondLastInst: *mut MachineInstr = &mut operator(I);
    let mut SecondLastOpc: u32 = SecondLastInst.getOpcode();
    if AllowModify && isUncondBranchOpcode(LastOpc) {
        while isUncondBranchOpcode(SecondLastOpc) {
            LastInst.eraseFromParent();
            LastInst = SecondLastInst;
            LastOpc = LastInst.getOpcode();
            if I == MBB.begin() || !self.isUnpredicatedTerminator(operator(operator(I))) {
                TBB = LastInst.getOperand(0).getMBB();
                return false;
            }
            SecondLastInst = &mut operator(I);
            SecondLastOpc = SecondLastInst.getOpcode();
        }
    }
    if AllowModify && isUncondBranchOpcode(LastOpc) && MBB.isLayoutSuccessor(self.getBranchDestBlock(*LastInst)) {
        LastInst.eraseFromParent();
        LastInst = SecondLastInst;
        LastOpc = LastInst.getOpcode();
        if I == MBB.begin() || !self.isUnpredicatedTerminator(operator(operator(I))) {
            assert!(!isUncondBranchOpcode(LastOpc), "unreachable unconditional branches removed above");
            if isCondBranchOpcode(LastOpc) {
                parseCondBranch(LastInst, TBB, Cond);
                return false;
            }
            return true;
        }
        SecondLastInst = &mut operator(I);
        SecondLastOpc = SecondLastInst.getOpcode();
    }
    if SecondLastInst && I != MBB.begin() && self.isUnpredicatedTerminator(operator(operator(I))) {
        return true;
    }
    if isCondBranchOpcode(SecondLastOpc) && isUncondBranchOpcode(LastOpc) {
        parseCondBranch(SecondLastInst, TBB, Cond);
        FBB = LastInst.getOperand(0).getMBB();
        return false;
    }
    if isUncondBranchOpcode(SecondLastOpc) && isUncondBranchOpcode(LastOpc) {
        TBB = SecondLastInst.getOperand(0).getMBB();
        I = LastInst;
        if AllowModify {
            operator(I).eraseFromParent();
        }
        return false;
    }
    if isIndirectBranchOpcode(SecondLastOpc) && isUncondBranchOpcode(LastOpc) {
        I = LastInst;
        if AllowModify {
            operator(I).eraseFromParent();
        }
        return true;
    }
    return true;
}

fn AArch64InstrInfo::analyzeBranchPredicate(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, MBP: *mut MachineBranchPredicate, AllowModify: bool) -> bool {
    let mut TBB: *mut MachineBasicBlock = null;
    let mut FBB: *mut MachineBasicBlock = null;
    let mut Cond: SmallVector<MachineOperand, 4> = SmallVector<MachineOperand, 4> {};
    if self.analyzeBranch(MBB, TBB, FBB, Cond, AllowModify) {
        return true;
    }
    if Cond.is_empty() {
        return true;
    }
    MBP.TrueDest = TBB;
    assert!(MBP.TrueDest, "expected!");
    MBP.FalseDest = if FBB { FBB } else { MBB.getNextNode() };
    MBP.ConditionDef = null;
    MBP.SingleUseCondition = false;
    let mut I: iterator = MBB.getLastNonDebugInstr(true);
    if I == MBB.end() {
        return true;
    }
    if isUncondBranchOpcode(operator(I).getOpcode()) {
        if I == MBB.begin() {
            return true;
        }
        operator(I);
    }
    let mut CondBranch: *mut MachineInstr = &mut operator(I);
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    match CondBranch.getOpcode() {
        _ => {
            return true;
        },
        Bcc => {
            for MI in drop_begin(reverse(MBB), 1) {
                if MI.modifiesRegister(NZCV, null) {
                    MBP.ConditionDef = &mut MI;
                    break;
                }
            }
        },
        CBZW => {
            CBZX;
        },
        TBZW => {
            TBZX;
        },
    }
}

fn AArch64InstrInfo::reverseBranchCondition(self: *AArch64InstrInfo, Cond: *mut SmallVectorImpl<MachineOperand>) -> bool {
    if Cond[0].getImm() != -1 {
        let mut CC: CondCode = Cond[0].getImm() as i32 as CondCode;
        Cond[0].setImm(getInvertedCondCode(CC));
    } else {
        match Cond[1].getImm() {
            _ => {
                llvm_unreachable_internal("Unknown conditional branch!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 732);
            },
            CBZW => {
                Cond[1].setImm(CBNZW);
            },
            CBNZW => {
                Cond[1].setImm(CBZW);
            },
            CBZX => {
                Cond[1].setImm(CBNZX);
            },
            CBNZX => {
                Cond[1].setImm(CBZX);
            },
            TBZW => {
                Cond[1].setImm(TBNZW);
            },
            TBNZW => {
                Cond[1].setImm(TBZW);
            },
            TBZX => {
                Cond[1].setImm(TBNZX);
            },
            TBNZX => {
                Cond[1].setImm(TBZX);
            },
            CBWPri => {
                CBXPri;
            },
        }
    }
    return false;
}

fn AArch64InstrInfo::removeBranch(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, BytesRemoved: *mut i32) -> u32 {
    let mut I: iterator = MBB.getLastNonDebugInstr(true);
    if I == MBB.end() {
        return 0;
    }
    if !isUncondBranchOpcode(operator(I).getOpcode()) && !isCondBranchOpcode(operator(I).getOpcode()) {
        return 0;
    }
    operator(I).eraseFromParent();
    I = MBB.end();
    if I == MBB.begin() {
        if BytesRemoved {
            *BytesRemoved = 4;
        }
        return 1;
    }
    operator(I);
    if !isCondBranchOpcode(operator(I).getOpcode()) {
        if BytesRemoved {
            *BytesRemoved = 4;
        }
        return 1;
    }
    operator(I).eraseFromParent();
    if BytesRemoved {
        *BytesRemoved = 8;
    }
    return 2;
}

fn AArch64InstrInfo::instantiateCondBranch(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, DL: *DebugLoc, TBB: *mut MachineBasicBlock, Cond: ArrayRef<MachineOperand>) {
    if Cond[0].getImm() != -1 {
        BuildMI(&mut MBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Bcc)).addImm(Cond[0].getImm()).addMBB(TBB, 0);
    } else {
        let mut MIB: MachineInstrBuilder = BuildMI(&mut MBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Cond[1].getImm())).add(Cond[2]);
        if Cond.len > 3 {
            MIB.add(Cond[3]);
        }
        if Cond.len > 4 {
            MIB.add(Cond[4]);
        }
        MIB.addMBB(TBB, 0);
        if Cond.len > 5 {
            MIB.addImm(Cond[5].getImm());
            MIB.addImm(Cond[6].getImm());
        }
    }
}

fn AArch64InstrInfo::insertBranch(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, TBB: *mut MachineBasicBlock, FBB: *mut MachineBasicBlock, Cond: ArrayRef<MachineOperand>, DL: *DebugLoc, BytesAdded: *mut i32) -> u32 {
    assert!(TBB, "insertBranch must not be told to insert a fallthrough");
    if !FBB {
        if Cond.is_empty() {
            BuildMI(&mut MBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(B)).addMBB(TBB, 0);
        } else {
            self.instantiateCondBranch(MBB, DL, TBB, Cond);
        }
        if BytesAdded {
            *BytesAdded = 4;
        }
        return 1;
    }
    self.instantiateCondBranch(MBB, DL, TBB, Cond);
    BuildMI(&mut MBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(B)).addMBB(FBB, 0);
    if BytesAdded {
        *BytesAdded = 8;
    }
    return 2;
}

fn isValidCBExtend(Opc: i64, Ext: ShiftExtendType) -> bool {
    match Ext {
        _ => {
            return false;
        },
        UXTB => {
            SXTB;
        },
        UXTH => {
            SXTH;
        },
    }
}

fn AArch64InstrInfo::insertCmpForCondBr(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, MI: iterator, DL: *DebugLoc, Cond: ArrayRef<MachineOperand>) -> CondCode {
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut CC: CondCode = zeroed();
    match Cond.len {
        _ => {
            llvm_unreachable_internal("Unknown condition opcode in Cond", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 895);
        },
        1 => {
            CC = Cond[0].getImm();
        },
        3 => {
            let mut Is64Bit: bool = false;
            match Cond[1].getImm() {
                _ => {
                    llvm_unreachable_internal("Unknown branch opcode in Cond", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 904);
                },
                CBZW => {
                    Is64Bit = false;
                },
                CBZX => {
                    Is64Bit = true;
                },
                CBNZW => {
                    Is64Bit = false;
                },
                CBNZX => {
                    Is64Bit = true;
                },
            }
            let mut SrcReg: Register = Cond[2].getReg();
            if Is64Bit {
                MRI.constrainRegClass(SrcReg, &mut GPR64spRegClass, 0);
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(SUBSXri), XZR).addReg(SrcReg, RegState {}, 0).addImm(0).addImm(0);
            } else {
                MRI.constrainRegClass(SrcReg, &mut GPR32spRegClass, 0);
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(SUBSWri), WZR).addReg(SrcReg, RegState {}, 0).addImm(0).addImm(0);
            }
        },
        4 => {
            match Cond[1].getImm() {
                _ => {
                    llvm_unreachable_internal("Unknown branch opcode in Cond", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 942);
                },
                TBZW => {
                    TBZX;
                },
                TBNZW => {
                    TBNZX;
                },
            }
            if Cond[1].getImm() == TBZW || Cond[1].getImm() == TBNZW {
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ANDSWri), WZR).addReg(Cond[2].getReg(), RegState {}, 0).addImm(encodeLogicalImmediate(1 << Cond[3].getImm(), 32));
            } else {
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ANDSXri), XZR).addReg(Cond[2].getReg(), RegState {}, 0).addImm(encodeLogicalImmediate(1 << Cond[3].getImm(), 64));
            }
        },
        5 => {
            let mut SubsOpc: u32 = 0;
            let mut SubsDestReg: u32 = 0;
            let mut IsImm: bool = false;
            CC = Cond[2].getImm() as CondCode;
            match Cond[1].getImm() {
                _ => {
                    llvm_unreachable_internal("Unknown branch opcode in Cond", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 973);
                },
                CBWPri => {
                    SubsOpc = SUBSWri;
                },
                CBXPri => {
                    SubsOpc = SUBSXri;
                },
                CBWPrr => {
                    SubsOpc = SUBSWrr;
                },
                CBXPrr => {
                    SubsOpc = SUBSXrr;
                },
            }
            if IsImm {
                MRI.constrainRegClass(Cond[3].getReg(), self.getRegClass(self.get(SubsOpc), 1), 0);
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(SubsOpc), SubsDestReg).addReg(Cond[3].getReg(), RegState {}, 0).addImm(Cond[4].getImm()).addImm(0);
            } else {
                MRI.constrainRegClass(Cond[3].getReg(), self.getRegClass(self.get(SubsOpc), 1), 0);
                MRI.constrainRegClass(Cond[4].getReg(), self.getRegClass(self.get(SubsOpc), 2), 0);
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(SubsOpc), SubsDestReg).addReg(Cond[3].getReg(), RegState {}, 0).addReg(Cond[4].getReg(), RegState {}, 0);
            }
        },
        7 => {
            let mut Reg: Register = Cond[3].getReg();
            if Cond[5].getImm() != InvalidShiftExtend {
                let mut ExtOpc: u32 = 0;
                let mut ExtBits: u32 = 0;
                let mut ExtendType: ShiftExtendType = getExtendType(Cond[5].getImm());
                assert!(isValidCBExtend(Cond[1].getImm(), ExtendType), "Unexpected compare-and-branch instruction for extend type");
                match ExtendType {
                    _ => {
                        llvm_unreachable_internal("Unknown shift-extend for CB instruction", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 1028);
                    },
                    SXTB => {
                        ExtOpc = SBFMWri;
                    },
                    SXTH => {
                        ExtOpc = SBFMWri;
                    },
                    UXTB => {
                        ExtOpc = ANDWri;
                    },
                    UXTH => {
                        ExtOpc = ANDWri;
                    },
                }
                Reg = MRI.createVirtualRegister(&mut GPR32commonRegClass, "");
                let mut MBBI: MachineInstrBuilder = BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ExtOpc), Reg).addReg(Cond[3].getReg(), RegState {}, 0);
                if ExtOpc != ANDWri {
                    MBBI.addImm(0);
                }
                MBBI.addImm(ExtBits);
            }
            if Cond[6].getImm() != InvalidShiftExtend {
                MRI.constrainRegClass(Reg, &mut GPR32commonRegClass, 0);
                let mut ExtendType: ShiftExtendType = getExtendType(Cond[6].getImm());
                assert!(isValidCBExtend(Cond[1].getImm(), ExtendType), "Unexpected compare-and-branch instruction for extend type");
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(SUBSWrx), WZR).addReg(Reg, RegState {}, 0).addReg(Cond[4].getReg(), RegState {}, 0).addImm(getArithExtendImm(ExtendType, 0));
            } else {
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(SUBSWrr), WZR).addReg(Reg, RegState {}, 0).addReg(Cond[4].getReg(), RegState {}, 0);
            }
            CC = Cond[2].getImm() as CondCode;
        },
    }
    return CC;
}

fn optimizeTerminators(MBB: *mut MachineBasicBlock, TII: *TargetInstrInfo) -> bool {
    for MI in MBB.terminators() {
        let mut Opc: u32 = MI.getOpcode();
        match Opc {
            CBZW => {
                CBZX;
            },
            CBNZW => {
                CBNZX;
            },
        }
    }
    return false;
}

fn removeCopies(MRI: *MachineRegisterInfo, VReg: u32) -> u32 {
    while isVirtualRegister(VReg) {
        let mut DefMI: *MachineInstr = MRI.getVRegDef(VReg);
        if !DefMI || !DefMI.isFullCopy() {
            return VReg;
        }
        VReg = DefMI.getOperand(1).getReg().operator unsigned int();
    }
    return VReg;
}

fn canFoldIntoCSel(MRI: *MachineRegisterInfo, VReg: u32, NewReg: *mut u32) -> u32 {
    VReg = removeCopies(MRI, VReg);
    if !isVirtualRegister(VReg) {
        return 0;
    }
    let mut Is64Bit: bool = GPR64allRegClass.hasSubClassEq(MRI.getRegClass(VReg));
    let mut DefMI: *MachineInstr = MRI.getVRegDef(VReg);
    if !DefMI {
        return 0;
    }
    let mut Opc: u32 = 0;
    let mut SrcReg: u32 = 0;
    match DefMI.getOpcode() {
        SUBREG_TO_REG => {
            if !DefMI.getOperand(1).isReg() {
                return 0;
            }
        },
        MOVi32imm => {
            MOVi64imm;
        },
        ADDSXri => {
            ADDSWri;
        },
        ADDXri => {
            ADDWri;
        },
        ORNXrr => {
            ORNWrr;
        },
        SUBSXrr => {
            SUBSWrr;
        },
        SUBXrr => {
            SUBWrr;
        },
        _ => {
            return 0;
        },
    }
    assert!(Opc && SrcReg, "Missing parameters");
    if NewReg {
        *NewReg = SrcReg;
    }
    return Opc;
}

fn AArch64InstrInfo::canInsertSelect(self: *AArch64InstrInfo, MBB: *MachineBasicBlock, Cond: ArrayRef<MachineOperand>, DstReg: Register, TrueReg: Register, FalseReg: Register, CondCycles: *mut i32, TrueCycles: *mut i32, FalseCycles: *mut i32) -> bool {
    let mut MRI: *MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut RC: *TargetRegisterClass = self.RI.getCommonSubClass(MRI.getRegClass(TrueReg), MRI.getRegClass(FalseReg));
    if !RC {
        return false;
    }
    if !self.RI.getCommonSubClass(RC, MRI.getRegClass(DstReg)) {
        return false;
    }
    let mut ExtraCondLat: u32 = Cond.len != 1;
    if GPR64allRegClass.hasSubClassEq(RC) || GPR32allRegClass.hasSubClassEq(RC) {
        CondCycles = 1 + ExtraCondLat;
        TrueCycles = FalseCycles = 1;
        if canFoldIntoCSel(MRI, TrueReg.operator unsigned int(), null) {
            TrueCycles = 0;
        } else if canFoldIntoCSel(MRI, FalseReg.operator unsigned int(), null) {
            FalseCycles = 0;
        }
        return true;
    }
    if FPR64RegClass.hasSubClassEq(RC) || FPR32RegClass.hasSubClassEq(RC) {
        CondCycles = 5 + ExtraCondLat;
        TrueCycles = FalseCycles = 2;
        return true;
    }
    if FPR128RegClass.hasSubClassEq(RC) && self.Subtarget.isNeonAvailable() && !MBB.getParent().getFunction().hasMinSize() {
        CondCycles = 8 + ExtraCondLat;
        TrueCycles = FalseCycles = 2;
        return true;
    }
    return false;
}

fn AArch64InstrInfo::insertSelect(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, I: iterator, DL: *DebugLoc, DstReg: Register, Cond: ArrayRef<MachineOperand>, TrueReg: Register, FalseReg: Register) {
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut CC: CondCode = self.insertCmpForCondBr(MBB, I, DL, Cond);
    if MRI.constrainRegClass(DstReg, &mut FPR128RegClass, 0) {
        assert!(self.Subtarget.isNeonAvailable(), "Expected NEON for a vector select");
        MRI.constrainRegClass(TrueReg, &mut FPR128RegClass, 0);
        MRI.constrainRegClass(FalseReg, &mut FPR128RegClass, 0);
        let mut CondSet: Register = MRI.createVirtualRegister(&mut GPR64RegClass, "");
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(CSINVXr), CondSet).addReg(XZR, RegState {}, 0).addReg(XZR, RegState {}, 0).addImm(getInvertedCondCode(CC));
        let mut Mask: Register = MRI.createVirtualRegister(&mut FPR128RegClass, "");
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(DUPv2i64gpr), Mask).addReg(CondSet, RegState {}, 0);
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(BSPv16i8), DstReg).addReg(Mask, RegState {}, 0).addReg(TrueReg, RegState {}, 0).addReg(FalseReg, RegState {}, 0);
        return;
    }
    let mut Opc: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    let mut TryFold: bool = false;
    if MRI.constrainRegClass(DstReg, &mut GPR64RegClass, 0) {
        RC = &mut GPR64RegClass;
        Opc = CSELXr;
        TryFold = true;
    } else if MRI.constrainRegClass(DstReg, &mut GPR32RegClass, 0) {
        RC = &mut GPR32RegClass;
        Opc = CSELWr;
        TryFold = true;
    } else if MRI.constrainRegClass(DstReg, &mut FPR64RegClass, 0) {
        RC = &mut FPR64RegClass;
        Opc = FCSELDrrr;
    } else if MRI.constrainRegClass(DstReg, &mut FPR32RegClass, 0) {
        RC = &mut FPR32RegClass;
        Opc = FCSELSrrr;
    }
    assert!(RC, "Unsupported regclass");
    if TryFold {
        let mut NewReg: u32 = 0;
        let mut FoldedOpc: u32 = canFoldIntoCSel(MRI, TrueReg.operator unsigned int(), &mut NewReg);
        if FoldedOpc {
            CC = getInvertedCondCode(CC);
            TrueReg = FalseReg;
        } else {
            FoldedOpc = canFoldIntoCSel(MRI, FalseReg.operator unsigned int(), &mut NewReg);
        }
        if FoldedOpc {
            FalseReg = NewReg;
            Opc = FoldedOpc;
            MRI.clearKillFlags(NewReg);
        }
    }
    MRI.constrainRegClass(TrueReg, RC, 0);
    assert!((FalseReg.isVirtual() || FalseReg == WZR || FalseReg == XZR), "FalseReg was folded into a non-virtual register other than WZR or XZR");
    if FalseReg.isVirtual() {
        MRI.constrainRegClass(FalseReg, RC, 0);
    }
    BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc), DstReg).addReg(TrueReg, RegState {}, 0).addReg(FalseReg, RegState {}, 0).addImm(CC);
}

fn isCheapImmediate(MI: *MachineInstr, BitSize: u32) -> bool {
    if BitSize == 32 {
        return true;
    }
    assert!(BitSize == 64, "Only bit sizes of 32 or 64 allowed");
    let mut Imm: u64 = MI.getOperand(1).getImm() as u64;
    let mut Is: ImmInsnModel, 4> = ImmInsnModel, 4> {};
    expandMOVImm(Imm, BitSize, Is);
    return Is.len <= 2;
}

fn isCheapCopy(MI: *MachineInstr, RI: *AArch64RegisterInfo) -> bool {
    assert!(MI.isCopy(), "Expected COPY instruction");
    let mut MRI: *MachineRegisterInfo = MI.getMF().getRegInfo();
    let mut GetRegClass: Closure_2 = Closure_2 { MRI: &mut MRI, RI: &mut RI };
    let mut DstRC: *TargetRegisterClass = GetRegClass.call(MI.getOperand(0).getReg());
    let mut SrcRC: *TargetRegisterClass = GetRegClass.call(MI.getOperand(1).getReg());
    if DstRC && SrcRC && !RI.getCommonSubClass(DstRC, SrcRC) {
        return false;
    }
    return MI.isAsCheapAsAMove(AllInBundle);
}

fn AArch64InstrInfo::isAsCheapAsAMove(self: *AArch64InstrInfo, MI: *MachineInstr) -> bool {
    if self.Subtarget.hasExynosCheapAsMoveHandling() {
        if isExynosCheapAsMove(MI) {
            return true;
        }
        return MI.isAsCheapAsAMove(AllInBundle);
    }
    match MI.getOpcode() {
        _ => {
            return MI.isAsCheapAsAMove(AllInBundle);
        },
        COPY => {
            return isCheapCopy(MI, self.RI);
        },
        ADDWrs => {
            ADDXrs;
        },
        MOVi32imm => {
            return isCheapImmediate(MI, 32);
        },
        MOVi64imm => {
            return isCheapImmediate(MI, 64);
        },
    }
}

fn AArch64InstrInfo::isFalkorShiftExtFast(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        ADDWrs => {
            ADDXrs;
        },
        ADDWrx => {
            ADDXrx;
        },
        SUBWrs => {
            SUBSWrs;
        },
        SUBXrs => {
            SUBSXrs;
        },
        SUBWrx => {
            SUBXrx;
        },
        LDRBBroW => {
            LDRBBroX;
        },
    }
}

fn AArch64InstrInfo::isSEHInstruction(self, MI: *MachineInstr) -> bool {
    let mut Opc: u32 = MI.getOpcode();
    match Opc {
        _ => {
            return false;
        },
        SEH_StackAlloc => {
            SEH_SaveFPLR;
        },
    }
}

fn AArch64InstrInfo::isCoalescableExtInstr(self: *AArch64InstrInfo, MI: *MachineInstr, SrcReg: *mut Register, DstReg: *mut Register, SubIdx: *mut u32) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        SBFMXri => {
            UBFMXri;
        },
    }
}

fn AArch64InstrInfo::areMemAccessesTriviallyDisjoint(self: *AArch64InstrInfo, MIa: *MachineInstr, MIb: *MachineInstr) -> bool {
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    let mut BaseOpA: *MachineOperand = null;
    let mut BaseOpB: *MachineOperand = null;
    let mut OffsetA: i64 = 0;
    let mut OffsetB: i64 = 0;
    let mut WidthA: TypeSize = TypeSize { 0, false };
    let mut WidthB: TypeSize = TypeSize { 0, false };
    let mut OffsetAIsScalable: bool = false;
    let mut OffsetBIsScalable: bool = false;
    assert!(MIa.mayLoadOrStore(AnyInBundle), "MIa must be a load or store.");
    assert!(MIb.mayLoadOrStore(AnyInBundle), "MIb must be a load or store.");
    if MIa.hasUnmodeledSideEffects() || MIb.hasUnmodeledSideEffects() || MIa.hasOrderedMemoryRef() || MIb.hasOrderedMemoryRef() {
        return false;
    }
    if self.getMemOperandWithOffsetWidth(MIa, BaseOpA, OffsetA, OffsetAIsScalable, WidthA, TRI) && self.getMemOperandWithOffsetWidth(MIb, BaseOpB, OffsetB, OffsetBIsScalable, WidthB, TRI) {
        if BaseOpA.isIdenticalTo(*BaseOpB) && OffsetAIsScalable == OffsetBIsScalable {
            let mut LowOffset: i32 = if OffsetA < OffsetB { OffsetA } else { OffsetB };
            let mut HighOffset: i32 = if OffsetA < OffsetB { OffsetB } else { OffsetA };
            let mut LowWidth: TypeSize = if (LowOffset == OffsetA) { WidthA } else { WidthB };
            if LowWidth.isScalable() == OffsetAIsScalable && LowOffset + LowWidth.getKnownMinValue() as i32 <= HighOffset {
                return true;
            }
        }
    }
    return false;
}

fn AArch64InstrInfo::isSchedulingBoundary(self: *AArch64InstrInfo, MI: *MachineInstr, MBB: *MachineBasicBlock, MF: *MachineFunction) -> bool {
    if self.isSchedulingBoundary(MI, MBB, MF) {
        return true;
    }
    if hasBTISemantics(MI) {
        return true;
    }
    match MI.getOpcode() {
        HINT => {
            if MI.getOperand(0).getImm() == 20 {
                return true;
            }
        },
        DSB => {
            ISB;
        },
        MSRpstatesvcrImm1 => {
            return true;
        },
        _ => {
            
        },
    }
    if isSEHInstruction(MI) {
        return true;
    }
    let mut Next: MachineInstr, true, true, void, false, void>, false, true> = next(MI.getIterator(), 1);
    return Next != MBB.end() && operator(Next).isCFIInstruction();
}

fn AArch64InstrInfo::analyzeCompare(self: *AArch64InstrInfo, MI: *MachineInstr, SrcReg: *mut Register, SrcReg2: *mut Register, CmpMask: *mut i64, CmpValue: *mut i64) -> bool {
    assert!(MI.getNumOperands() >= 2, "All AArch64 cmps should have 2 operands");
    if !MI.getOperand(1).isReg() || MI.getOperand(1).getSubReg() {
        return false;
    }
    match MI.getOpcode() {
        _ => {
            break;
        },
        PTEST_PP => {
            PTEST_PP_ANY;
        },
        SUBSWrr => {
            SUBSWrs;
        },
        SUBSWri => {
            ADDSWri;
        },
        ANDSWri => {
            ANDSXri;
        },
    }
    return false;
}

fn UpdateOperandRegClass(Instr: *mut MachineInstr) -> bool {
    let mut MBB: *mut MachineBasicBlock = Instr.getParent();
    assert!(MBB, "Can't get MachineBasicBlock here");
    let mut MF: *mut MachineFunction = MBB.getParent();
    assert!(MF, "Can't get MachineFunction here");
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
    let mut MRI: *mut MachineRegisterInfo = &mut MF.getRegInfo();
    for let mut OpIdx: u32 = 0;
let mut EndIdx: u32 = Instr.getNumOperands(); OpIdx < EndIdx; OpIdx += 1 {
        let mut MO: *mut MachineOperand = Instr.getOperand(OpIdx);
        let mut OpRegCstraints: *TargetRegisterClass = Instr.getRegClassConstraint(OpIdx, TII, TRI);
        if !OpRegCstraints {
            continue;
        }
        if MO.isFI() {
            continue;
        }
        assert!(MO.isReg(), "Operand has register constraints without being a register!");
        let mut Reg: Register = MO.getReg();
        if Reg.isPhysical() {
            if !OpRegCstraints.contains(Reg.operator MCRegister()) {
                return false;
            }
        } else if !OpRegCstraints.hasSubClassEq(MRI.getRegClass(Reg)) && !MRI.constrainRegClass(Reg, OpRegCstraints, 0) {
            return false;
        }
    }
    return true;
}

fn convertToNonFlagSettingOpc(MI: *MachineInstr) -> u32 {
    let mut MIDefinesZeroReg: bool = false;
    if MI.definesRegister(WZR, null) || MI.definesRegister(XZR, null) {
        MIDefinesZeroReg = true;
    }
    match MI.getOpcode() {
        _ => {
            return MI.getOpcode();
        },
        ADDSWrr => {
            return ADDWrr;
        },
        ADDSWri => {
            return if MIDefinesZeroReg { ADDSWri } else { ADDWri };
        },
        ADDSWrs => {
            return if MIDefinesZeroReg { ADDSWrs } else { ADDWrs };
        },
        ADDSWrx => {
            return ADDWrx;
        },
        ADDSXrr => {
            return ADDXrr;
        },
        ADDSXri => {
            return if MIDefinesZeroReg { ADDSXri } else { ADDXri };
        },
        ADDSXrs => {
            return if MIDefinesZeroReg { ADDSXrs } else { ADDXrs };
        },
        ADDSXrx => {
            return ADDXrx;
        },
        SUBSWrr => {
            return SUBWrr;
        },
        SUBSWri => {
            return if MIDefinesZeroReg { SUBSWri } else { SUBWri };
        },
        SUBSWrs => {
            return if MIDefinesZeroReg { SUBSWrs } else { SUBWrs };
        },
        SUBSWrx => {
            return SUBWrx;
        },
        SUBSXrr => {
            return SUBXrr;
        },
        SUBSXri => {
            return if MIDefinesZeroReg { SUBSXri } else { SUBXri };
        },
        SUBSXrs => {
            return if MIDefinesZeroReg { SUBSXrs } else { SUBXrs };
        },
        SUBSXrx => {
            return SUBXrx;
        },
    }
}

enum AccessKind {
    AK_Write = 0,
    AK_Read = 1,
    AK_All = 2,
}

fn areCFlagsAccessedBetweenInstrs(From: iterator, To: iterator, TRI: *TargetRegisterInfo, AccessToCheck: AccessKind) -> bool {
    if To == operator(To).getParent().begin() {
        return true;
    }
    if operator(To).getParent() != operator(From).getParent() {
        return true;
    }
    assert!(any_of(operator(To.getReverse()), operator(To).getParent().rend(), Closure_3 { cap_0: From });
    for Instr in instructionsWithoutDebug(operator(To.getReverse()), From.getReverse(), true) {
        if ((AccessToCheck & AK_Write) && Instr.modifiesRegister(NZCV, TRI)) || ((AccessToCheck & AK_Read) && Instr.readsRegister(NZCV, TRI)) {
            return true;
        }
    }
    return false;
}

fn AArch64InstrInfo::canRemovePTestInstr(self: *AArch64InstrInfo, PTest: *mut MachineInstr, Mask: *mut MachineInstr, Pred: *mut MachineInstr, MRI: *MachineRegisterInfo) -> optional<unsigned int> {
    let mut MaskOpcode: u32 = Mask.getOpcode();
    let mut PredOpcode: u32 = Pred.getOpcode();
    let mut PredIsPTestLike: bool = self.isPTestLikeOpcode(PredOpcode);
    let mut PredIsWhileLike: bool = self.isWhileOpcode(PredOpcode);
    if PredIsWhileLike {
        if (Mask == Pred) && PTest.getOpcode() == PTEST_PP_ANY {
            return PredOpcode;
        }
        if isPTrueOpcode(MaskOpcode) && Mask.getOperand(1).getImm() == 31 && self.getElementSizeForOpcode(MaskOpcode) == self.getElementSizeForOpcode(PredOpcode) {
            return PredOpcode;
        }
        if PTest.getOpcode() == PTEST_PP_FIRST && isPTrueOpcode(MaskOpcode) && Mask.getOperand(1).getImm() == 31 {
            return PredOpcode;
        }
        return optional<unsigned int> {};
    }
    if PredIsPTestLike {
        if (Mask == Pred) && PTest.getOpcode() == PTEST_PP_ANY {
            return PredOpcode;
        }
        let mut PTestLikeMask: *mut MachineInstr = MRI.getUniqueVRegDef(Pred.getOperand(1).getReg());
        if Mask != PTestLikeMask && PTestLikeMask.isFullCopy() && PTestLikeMask.getOperand(1).getReg().isVirtual() {
            PTestLikeMask = MRI.getUniqueVRegDef(PTestLikeMask.getOperand(1).getReg());
        }
        if isPTrueOpcode(MaskOpcode) && Mask.getOperand(1).getImm() == 31 && self.getElementSizeForOpcode(MaskOpcode) == self.getElementSizeForOpcode(PredOpcode) {
            if Mask == PTestLikeMask || PTest.getOpcode() == PTEST_PP_ANY {
                return PredOpcode;
            }
        }
        let mut PredElementSize: u64 = self.getElementSizeForOpcode(PredOpcode);
        if Mask == PTestLikeMask && (PredElementSize == ElementSizeB || PTest.getOpcode() == PTEST_PP_ANY) {
            return PredOpcode;
        }
        return optional<unsigned int> {};
    }
    match PredOpcode {
        AND_PPzPP => {
            BIC_PPzPP;
        },
        BRKN_PPzP => {
            if (MaskOpcode != PTRUE_B) || (Mask.getOperand(1).getImm() != 31) {
                return optional<unsigned int> {};
            }
            break;
        },
        PTRUE_B => {
            break;
        },
        _ => {
            return optional<unsigned int> {};
        },
    }
    return convertToFlagSettingOpc(PredOpcode);
}

fn AArch64InstrInfo::optimizePTestInstr(self: *AArch64InstrInfo, PTest: *mut MachineInstr, MaskReg: u32, PredReg: u32, MRI: *MachineRegisterInfo) -> bool {
    let mut Mask: *mut MachineInstr = MRI.getUniqueVRegDef(MaskReg);
    let mut Pred: *mut MachineInstr = MRI.getUniqueVRegDef(PredReg);
    if Pred.isCopy() && PTest.getOpcode() == PTEST_PP_FIRST {
        let mut Op: MachineOperand = Pred.getOperand(1);
        if Op.isReg() && Op.getReg().isVirtual() && Op.getSubReg() == psub0 {
            Pred = MRI.getUniqueVRegDef(Op.getReg());
        }
    }
    let mut PredOpcode: u32 = Pred.getOpcode();
    let mut NewOp: optional<unsigned int> = self.canRemovePTestInstr(PTest, Mask, Pred, MRI);
    if !NewOp {
        return false;
    }
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    if areCFlagsAccessedBetweenInstrs(Pred, PTest, TRI, AK_All) {
        return false;
    }
    PTest.eraseFromParent();
    if operator(NewOp) != PredOpcode {
        Pred.setDesc(self.get(operator(NewOp)));
        let mut succeeded: bool = UpdateOperandRegClass(*Pred);
        succeeded as void;
        assert!(succeeded, "Operands have incompatible register classes!");
        Pred.addRegisterDefined(NZCV, TRI);
    }
    if Pred.registerDefIsDead(NZCV, TRI) {
        let mut i: u32 = 0;
        let mut e: u32 = Pred.getNumOperands();
        for ; i != e; i += 1 {
            let mut MO: *mut MachineOperand = Pred.getOperand(i);
            if MO.isReg() && MO.isDef() && MO.getReg() == NZCV {
                MO.setIsDead(false);
                break;
            }
        }
    }
    return true;
}

fn AArch64InstrInfo::optimizeCompareInstr(self: *AArch64InstrInfo, CmpInstr: *mut MachineInstr, SrcReg: Register, SrcReg2: Register, CmpMask: i64, CmpValue: i64, MRI: *MachineRegisterInfo) -> bool {
    assert!(CmpInstr.getParent();
    assert!(MRI);
    let mut DeadNZCVIdx: i32 = CmpInstr.findRegisterDefOperandIdx(NZCV, null, true, false);
    if DeadNZCVIdx != -1 {
        if CmpInstr.definesRegister(WZR, null) || CmpInstr.definesRegister(XZR, null) {
            CmpInstr.eraseFromParent();
            return true;
        }
        let mut Opc: u32 = CmpInstr.getOpcode();
        let mut NewOpc: u32 = convertToNonFlagSettingOpc(CmpInstr);
        if NewOpc == Opc {
            return false;
        }
        let mut MCID: *MCInstrDesc = self.get(NewOpc);
        CmpInstr.setDesc(MCID);
        CmpInstr.removeOperand(DeadNZCVIdx);
        let mut succeeded: bool = UpdateOperandRegClass(CmpInstr);
        succeeded as void;
        assert!(succeeded, "Some operands reg class are incompatible!");
        return true;
    }
    if CmpInstr.getOpcode() == PTEST_PP || CmpInstr.getOpcode() == PTEST_PP_ANY || CmpInstr.getOpcode() == PTEST_PP_FIRST {
        return self.optimizePTestInstr(&mut CmpInstr, SrcReg.operator unsigned int(), SrcReg2.operator unsigned int(), MRI);
    }
    if SrcReg2 != 0 {
        return false;
    }
    if !MRI.use_nodbg_empty(CmpInstr.getOperand(0).getReg()) {
        return false;
    }
    if CmpValue == 0 && self.substituteCmpToZero(CmpInstr, SrcReg.operator unsigned int(), *MRI) {
        return true;
    }
    return (CmpValue == 0 || CmpValue == 1) && self.removeCmpToZeroOrOne(CmpInstr, SrcReg.operator unsigned int(), CmpValue, *MRI);
}

fn sForm(Instr: *mut MachineInstr) -> u32 {
    match Instr.getOpcode() {
        _ => {
            return INSTRUCTION_LIST_END;
        },
        ADDSWrr => {
            ADDSWri;
        },
        ADDWrr => {
            return ADDSWrr;
        },
        ADDWri => {
            return ADDSWri;
        },
        ADDXrr => {
            return ADDSXrr;
        },
        ADDXri => {
            return ADDSXri;
        },
        ADDWrx => {
            return ADDSWrx;
        },
        ADDXrx => {
            return ADDSXrx;
        },
        ADDWrs => {
            return ADDSWrs;
        },
        ADDXrs => {
            return ADDSXrs;
        },
        ADCWr => {
            return ADCSWr;
        },
        ADCXr => {
            return ADCSXr;
        },
        SUBWrr => {
            return SUBSWrr;
        },
        SUBWri => {
            return SUBSWri;
        },
        SUBXrr => {
            return SUBSXrr;
        },
        SUBXri => {
            return SUBSXri;
        },
        SUBWrx => {
            return SUBSWrx;
        },
        SUBXrx => {
            return SUBSXrx;
        },
        SUBWrs => {
            return SUBSWrs;
        },
        SUBXrs => {
            return SUBSXrs;
        },
        SBCWr => {
            return SBCSWr;
        },
        SBCXr => {
            return SBCSXr;
        },
        ANDWri => {
            return ANDSWri;
        },
        ANDXri => {
            return ANDSXri;
        },
        ANDWrr => {
            return ANDSWrr;
        },
        ANDWrs => {
            return ANDSWrs;
        },
        ANDXrr => {
            return ANDSXrr;
        },
        ANDXrs => {
            return ANDSXrs;
        },
        BICWrr => {
            return BICSWrr;
        },
        BICXrr => {
            return BICSXrr;
        },
        BICWrs => {
            return BICSWrs;
        },
        BICXrs => {
            return BICSXrs;
        },
    }
}

fn areCFlagsAliveInSuccessors(MBB: *MachineBasicBlock) -> bool {
    for BB in MBB.successors() {
        if BB.isLiveIn(NZCV, getAll()) {
            return true;
        }
    }
    return false;
}

fn AArch64InstrInfo::findCondCodeUseOperandIdxForBranchOrSelect(self, Instr: *MachineInstr) -> i32 {
    match Instr.getOpcode() {
        _ => {
            return -1;
        },
        Bcc => {
            let mut Idx: i32 = Instr.findRegisterUseOperandIdx(NZCV, null, false);
            assert!(Idx >= 2);
            return Idx - 2;
        },
        CSINVWr => {
            CSINVXr;
        },
    }
}

fn findCondCodeUsedByInstr(Instr: *MachineInstr) -> CondCode {
    let mut CCIdx: i32 = findCondCodeUseOperandIdxForBranchOrSelect(Instr);
    return if CCIdx >= 0 { Instr.getOperand(CCIdx).getImm() as CondCode } else { Invalid };
}

fn getUsedNZCV(CC: CondCode) -> UsedNZCV {
    assert!(CC != Invalid);
    let mut UsedFlags: UsedNZCV = UsedNZCV {};
    match CC {
        _ => {
            break;
        },
        EQ => {
            NE;
        },
        HI => {
            LS;
        },
        HS => {
            LO;
        },
        MI => {
            PL;
        },
        VS => {
            VC;
        },
        GT => {
            LE;
        },
        GE => {
            LT;
        },
    }
    return UsedFlags;
}

fn examineCFlagsUse(MI: *mut MachineInstr, CmpInstr: *mut MachineInstr, TRI: *TargetRegisterInfo, CCUseInstrs: *mut SmallVectorImpl<MachineInstr *>) -> optional<UsedNZCV> {
    let mut CmpParent: *mut MachineBasicBlock = CmpInstr.getParent();
    if MI.getParent() != CmpParent {
        return nullopt;
    }
    if areCFlagsAliveInSuccessors(CmpParent) {
        return nullopt;
    }
    let mut NZCVUsedAfterCmp: UsedNZCV = UsedNZCV {};
    for Instr in instructionsWithoutDebug(next(CmpInstr.getIterator(), 1), CmpParent.instr_end(), true) {
        if Instr.readsRegister(NZCV, &mut TRI) {
            let mut CC: CondCode = findCondCodeUsedByInstr(Instr);
            if CC == Invalid {
                return nullopt;
            }
            operator(NZCVUsedAfterCmp, getUsedNZCV(CC));
            if CCUseInstrs {
                CCUseInstrs.push(&mut Instr);
            }
        }
        if Instr.modifiesRegister(NZCV, &mut TRI) {
            break;
        }
    }
    return NZCVUsedAfterCmp;
}

fn isADDSRegImm(Opcode: u32) -> bool {
    return Opcode == ADDSWri || Opcode == ADDSXri;
}

fn isSUBSRegImm(Opcode: u32) -> bool {
    return Opcode == SUBSWri || Opcode == SUBSXri;
}

fn isANDOpcode(MI: *mut MachineInstr) -> bool {
    let mut Opc: u32 = sForm(MI);
    match Opc {
        ANDSWri => {
            ANDSWrr;
        },
        _ => {
            return false;
        },
    }
}

fn canInstrSubstituteCmpInstr(MI: *mut MachineInstr, CmpInstr: *mut MachineInstr, TRI: *TargetRegisterInfo) -> bool {
    assert!(sForm(MI) != INSTRUCTION_LIST_END);
    let mut CmpOpcode: u32 = CmpInstr.getOpcode();
    if !isADDSRegImm(CmpOpcode) && !isSUBSRegImm(CmpOpcode) {
        return false;
    }
    assert!((CmpInstr.getOperand(2).isImm() && CmpInstr.getOperand(2).getImm() == 0), "Caller guarantees that CmpInstr compares with constant 0");
    let mut NZVCUsed: optional<UsedNZCV> = examineCFlagsUse(MI, CmpInstr, TRI, null);
    if !NZVCUsed || operator(NZVCUsed).C {
        return false;
    }
    if operator(NZVCUsed).V && !MI.getFlag(NoSWrap) && !isANDOpcode(MI) {
        return false;
    }
    let mut AccessToCheck: AccessKind = AK_Write;
    if sForm(MI) != MI.getOpcode() {
        AccessToCheck = AK_All;
    }
    return !areCFlagsAccessedBetweenInstrs(&mut MI, &mut CmpInstr, &mut TRI, AccessToCheck);
}

fn AArch64InstrInfo::substituteCmpToZero(self: *AArch64InstrInfo, CmpInstr: *mut MachineInstr, SrcReg: u32, MRI: *MachineRegisterInfo) -> bool {
    let mut MI: *mut MachineInstr = MRI.getUniqueVRegDef(SrcReg);
    if !MI {
        return false;
    }
    let mut TRI: *TargetRegisterInfo = self.getRegisterInfo();
    let mut NewOpc: u32 = sForm(*MI);
    if NewOpc == INSTRUCTION_LIST_END {
        return false;
    }
    if !canInstrSubstituteCmpInstr(*MI, CmpInstr, TRI) {
        return false;
    }
    MI.setDesc(self.get(NewOpc));
    CmpInstr.eraseFromParent();
    let mut succeeded: bool = UpdateOperandRegClass(*MI);
    succeeded as void;
    assert!(succeeded, "Some operands reg class are incompatible!");
    MI.addRegisterDefined(NZCV, &mut TRI);
    return true;
}

fn canCmpInstrBeRemoved(MI: *mut MachineInstr, CmpInstr: *mut MachineInstr, CmpValue: i32, TRI: *TargetRegisterInfo, CCUseInstrs: *mut SmallVectorImpl<MachineInstr *>, IsInvertCC: *mut bool) -> bool {
    assert!((CmpValue == 0 || CmpValue == 1), "Only comparisons to 0 or 1 considered for removal!");
    let mut MIOpc: u32 = MI.getOpcode();
    if MIOpc == CSINCWr {
        if MI.getOperand(1).getReg() != WZR || MI.getOperand(2).getReg() != WZR {
            return false;
        }
    } else if MIOpc == CSINCXr {
        if MI.getOperand(1).getReg() != XZR || MI.getOperand(2).getReg() != XZR {
            return false;
        }
    } else {
        return false;
    }
    let mut MICC: CondCode = findCondCodeUsedByInstr(MI);
    if MICC == Invalid {
        return false;
    }
    if MI.findRegisterDefOperandIdx(NZCV, null, true, false) != -1 {
        return false;
    }
    let mut CmpOpcode: u32 = CmpInstr.getOpcode();
    let mut IsSubsRegImm: bool = isSUBSRegImm(CmpOpcode);
    if CmpValue && !IsSubsRegImm {
        return false;
    }
    if !CmpValue && !IsSubsRegImm && !isADDSRegImm(CmpOpcode) {
        return false;
    }
    let mut MIUsedNZCV: UsedNZCV = getUsedNZCV(MICC);
    if MIUsedNZCV.C || MIUsedNZCV.V {
        return false;
    }
    let mut NZCVUsedAfterCmp: optional<UsedNZCV> = examineCFlagsUse(MI, CmpInstr, TRI, &mut CCUseInstrs);
    if !NZCVUsedAfterCmp || operator(NZCVUsedAfterCmp).C || operator(NZCVUsedAfterCmp).V {
        return false;
    }
    if (MIUsedNZCV.Z && operator(NZCVUsedAfterCmp).N) || (MIUsedNZCV.N && operator(NZCVUsedAfterCmp).Z) {
        return false;
    }
    if MIUsedNZCV.N && !CmpValue {
        return false;
    }
    if areCFlagsAccessedBetweenInstrs(&mut MI, &mut CmpInstr, &mut TRI, AK_Write) {
        return false;
    }
    IsInvertCC = (CmpValue && (MICC == EQ || MICC == PL)) || (!CmpValue && MICC == NE);
    return true;
}

fn AArch64InstrInfo::removeCmpToZeroOrOne(self: *AArch64InstrInfo, CmpInstr: *mut MachineInstr, SrcReg: u32, CmpValue: i32, MRI: *MachineRegisterInfo) -> bool {
    let mut MI: *mut MachineInstr = MRI.getUniqueVRegDef(SrcReg);
    if !MI {
        return false;
    }
    let mut TRI: *TargetRegisterInfo = self.getRegisterInfo();
    let mut CCUseInstrs: SmallVector<MachineInstr *, 4> = SmallVector<MachineInstr *, 4> {};
    let mut IsInvertCC: bool = false;
    if !canCmpInstrBeRemoved(*MI, CmpInstr, CmpValue, TRI, CCUseInstrs, IsInvertCC) {
        return false;
    }
    CmpInstr.eraseFromParent();
    if IsInvertCC {
        for CCUseInstr in CCUseInstrs {
            let mut Idx: i32 = findCondCodeUseOperandIdxForBranchOrSelect(*CCUseInstr);
            assert!(Idx >= 0, "Unexpected instruction using CC.");
            let mut CCOperand: *mut MachineOperand = CCUseInstr.getOperand(Idx);
            let mut CCUse: CondCode = getInvertedCondCode(CCOperand.getImm() as CondCode);
            CCOperand.setImm(CCUse);
        }
    }
    return true;
}

fn AArch64InstrInfo::expandPostRAPseudo(self: *AArch64InstrInfo, MI: *mut MachineInstr) -> bool {
    if MI.getOpcode() != LOAD_STACK_GUARD && MI.getOpcode() != CATCHRET && MI.getOpcode() != STACK_GUARD_UNMIX {
        return false;
    }
    let mut MBB: *mut MachineBasicBlock = *MI.getParent();
    let mut Subtarget: *AArch64Subtarget = MBB.getParent().getSubtarget();
    let mut TRI: *AArch64RegisterInfo = Subtarget.getRegisterInfo();
    let mut DL: DebugLoc = MI.getDebugLoc();
    if MI.getOpcode() == STACK_GUARD_UNMIX {
        let mut DstReg: Register = MI.getOperand(0).getReg();
        let mut SrcReg: Register = MI.getOperand(1).getReg();
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(SUBXrr), DstReg).addReg(FP, RegState {}, 0).addReg(SrcReg, RegState {}, 0);
        MBB.erase(MI);
        return true;
    }
    if MI.getOpcode() == CATCHRET {
        let mut TII: *TargetInstrInfo = MBB.getParent().getSubtarget().getInstrInfo();
        let mut TargetMBB: *mut MachineBasicBlock = MI.getOperand(0).getMBB();
        let mut MBBI: iterator = MI;
        let mut FirstEpilogSEH: iterator = prev(MBBI, 1);
        while operator(FirstEpilogSEH).getFlag(FrameDestroy) && FirstEpilogSEH != MBB.begin() {
            FirstEpilogSEH = prev(FirstEpilogSEH, 1);
        }
        if FirstEpilogSEH != MBB.begin() {
            FirstEpilogSEH = next(FirstEpilogSEH, 1);
        }
        BuildMI(MBB, FirstEpilogSEH, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(ADRP)).addReg(X0, Define, 0).addMBB(TargetMBB, MO_PAGE);
        BuildMI(MBB, FirstEpilogSEH, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(ADDXri)).addReg(X0, Define, 0).addReg(X0, RegState {}, 0).addMBB(TargetMBB, MO_PAGEOFF | MO_NC).addImm(0);
        TargetMBB.setMachineBlockAddressTaken();
        return true;
    }
    let mut Reg: Register = MI.getOperand(0).getReg();
    let mut M: *mut Module = *MBB.getParent().getFunction().getParent();
    if M.getStackProtectorGuard() == "sysreg" {
        let mut SrcReg: *SysReg = lookupSysRegByName(M.getStackProtectorGuardReg());
        if !SrcReg {
            report_fatal_error("Unknown SysReg for Stack Protector Guard Register", true);
        }
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MRS)).addDef(Reg, Renamable, 0).addImm(SrcReg.Encoding);
        let mut Offset: i32 = M.getStackProtectorGuardOffset();
        if Offset >= 0 && Offset <= 32760 && Offset % 8 == 0 {
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRXui)).addDef(Reg, RegState {}, 0).addUse(Reg, Kill, 0).addImm(Offset / 8);
        } else if Offset >= -256 && Offset <= 255 {
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDURXi)).addDef(Reg, RegState {}, 0).addUse(Reg, Kill, 0).addImm(Offset);
        } else if Offset >= -4095 && Offset <= 4095 {
            if Offset > 0 {
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ADDXri)).addDef(Reg, RegState {}, 0).addUse(Reg, Kill, 0).addImm(Offset).addImm(0);
            } else {
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(SUBXri)).addDef(Reg, RegState {}, 0).addUse(Reg, Kill, 0).addImm(-Offset).addImm(0);
            }
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRXui)).addDef(Reg, RegState {}, 0).addUse(Reg, Kill, 0).addImm(0);
        } else {
            report_fatal_error("Unable to encode Stack Protector Guard Offset", true);
        }
        MBB.erase(MI);
        return true;
    }
    let mut GV: *GlobalValue = cast((*MI.memoperands_begin()).getValue());
    let mut TM: *TargetMachine = MBB.getParent().getTarget();
    let mut OpFlags: u32 = Subtarget.ClassifyGlobalReference(GV, TM);
    let mut MO_NC: u8 = MO_NC;
    let mut GuardWidth: u32 = M.getStackProtectorGuardValueWidth().value_or(if Subtarget.isTargetILP32() { 4 } else { 8 });
    if GuardWidth != 4 && GuardWidth != 8 {
        report_fatal_error("Unsupported stack protector value width", true);
    }
    if (OpFlags & MO_GOT) != 0 {
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LOADgot), Reg).addGlobalAddress(GV, 0, OpFlags);
        if GuardWidth == 4 {
            let mut Reg32: u32 = TRI.getSubReg(Reg.operator MCRegister(), sub_32).operator unsigned int();
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRWui)).addDef(Reg32, Dead, 0).addUse(Reg, Kill, 0).addImm(0).addMemOperand(*MI.memoperands_begin()).addDef(Reg, Implicit, 0);
        } else {
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRXui), Reg).addReg(Reg, Kill, 0).addImm(0).addMemOperand(*MI.memoperands_begin());
        }
    } else if TM.getCodeModel() == Large {
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOVZXi), Reg).addGlobalAddress(GV, 0, MO_G0 | MO_NC).addImm(0);
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOVKXi), Reg).addReg(Reg, Kill, 0).addGlobalAddress(GV, 0, MO_G1 | MO_NC).addImm(16);
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOVKXi), Reg).addReg(Reg, Kill, 0).addGlobalAddress(GV, 0, MO_G2 | MO_NC).addImm(32);
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOVKXi), Reg).addReg(Reg, Kill, 0).addGlobalAddress(GV, 0, MO_G3).addImm(48);
        if GuardWidth == 4 {
            let mut Reg32: u32 = TRI.getSubReg(Reg.operator MCRegister(), sub_32).operator unsigned int();
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRWui)).addDef(Reg32, Dead, 0).addUse(Reg, Kill, 0).addImm(0).addMemOperand(*MI.memoperands_begin()).addDef(Reg, Implicit, 0);
        } else {
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRXui), Reg).addReg(Reg, Kill, 0).addImm(0).addMemOperand(*MI.memoperands_begin());
        }
    } else {
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ADRP), Reg).addGlobalAddress(GV, 0, OpFlags | MO_PAGE);
        let mut LoFlags: u8 = OpFlags | MO_PAGEOFF | MO_NC;
        if GuardWidth == 4 {
            let mut Reg32: u32 = TRI.getSubReg(Reg.operator MCRegister(), sub_32).operator unsigned int();
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRWui)).addDef(Reg32, Dead, 0).addUse(Reg, Kill, 0).addGlobalAddress(GV, 0, LoFlags).addMemOperand(*MI.memoperands_begin()).addDef(Reg, Implicit, 0);
        } else {
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRXui), Reg).addReg(Reg, Kill, 0).addGlobalAddress(GV, 0, LoFlags).addMemOperand(*MI.memoperands_begin());
        }
    }
    if Subtarget.getTargetTriple().isOSMSVCRT() {
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(SUBXrr), Reg).addReg(FP, RegState {}, 0).addReg(Reg, Kill, 0);
    }
    MBB.erase(MI);
    return true;
}

fn AArch64InstrInfo::isGPRZero(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            break;
        },
        MOVZWi => {
            MOVZXi;
        },
        ANDWri => {
            return MI.getOperand(1).getReg() == WZR;
        },
        ANDXri => {
            return MI.getOperand(1).getReg() == XZR;
        },
        COPY => {
            return MI.getOperand(1).getReg() == WZR;
        },
    }
    return false;
}

fn AArch64InstrInfo::isGPRCopy(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            break;
        },
        COPY => {
            let mut DstReg: Register = MI.getOperand(0).getReg();
            return (GPR32RegClass.contains(DstReg.operator MCRegister()) || GPR64RegClass.contains(DstReg.operator MCRegister()));
        },
        ORRXrs => {
            if MI.getOperand(1).getReg() == XZR {
                assert!(MI.getDesc().getNumOperands() == 4 && MI.getOperand(3).getImm() == 0, "invalid ORRrs operands");
                return true;
            }
        },
        ADDXri => {
            if MI.getOperand(2).getImm() == 0 {
                assert!(MI.getDesc().getNumOperands() == 4 && MI.getOperand(3).getImm() == 0, "invalid ADDXri operands");
                return true;
            }
        },
    }
    return false;
}

fn AArch64InstrInfo::isFPRCopy(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            break;
        },
        COPY => {
            let mut DstReg: Register = MI.getOperand(0).getReg();
            return FPR128RegClass.contains(DstReg.operator MCRegister());
        },
        ORRv16i8 => {
            if MI.getOperand(1).getReg() == MI.getOperand(2).getReg() {
                assert!(MI.getDesc().getNumOperands() == 3 && MI.getOperand(0).isReg(), "invalid ORRv16i8 operands");
                return true;
            }
        },
    }
    return false;
}

fn isFrameLoadOpcode(Opcode: i32) -> bool {
    match Opcode {
        _ => {
            return false;
        },
        LDRWui => {
            LDRXui;
        },
    }
}

fn AArch64InstrInfo::isLoadFromStackSlot(self: *AArch64InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32) -> Register {
    if !isFrameLoadOpcode(MI.getOpcode()) {
        return Register { Reg: 0 };
    }
    if MI.getOperand(0).getSubReg() == 0 && MI.getOperand(1).isFI() && MI.getOperand(2).isImm() && MI.getOperand(2).getImm() == 0 {
        FrameIndex = MI.getOperand(1).getIndex();
        return MI.getOperand(0).getReg();
    }
    return Register { Reg: 0 };
}

fn isFrameStoreOpcode(Opcode: i32) -> bool {
    match Opcode {
        _ => {
            return false;
        },
        STRWui => {
            STRXui;
        },
    }
}

fn AArch64InstrInfo::isStoreToStackSlot(self: *AArch64InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32) -> Register {
    if !isFrameStoreOpcode(MI.getOpcode()) {
        return Register { Reg: 0 };
    }
    if MI.getOperand(0).getSubReg() == 0 && MI.getOperand(1).isFI() && MI.getOperand(2).isImm() && MI.getOperand(2).getImm() == 0 {
        FrameIndex = MI.getOperand(1).getIndex();
        return MI.getOperand(0).getReg();
    }
    return Register { Reg: 0 };
}

fn AArch64InstrInfo::isStoreToStackSlotPostFE(self: *AArch64InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32) -> Register {
    if !isFrameStoreOpcode(MI.getOpcode()) {
        return Register { Reg: 0 };
    }
    if self.isStoreToStackSlot(MI, FrameIndex) {
        Reg.operator unsigned int();
    } else {
        return Reg;
    }
    let mut Accesses: SmallVector<const MachineMemOperand *, 1> = SmallVector<const MachineMemOperand *, 1> {};
    if self.hasStoreToStackSlot(MI, Accesses) {
        if Accesses.len > 1 {
            return Register { Reg: 0 };
        }
        FrameIndex = cast(Accesses.front().getPseudoValue()).getFrameIndex();
        return MI.getOperand(0).getReg();
    }
    return Register { Reg: 0 };
}

fn AArch64InstrInfo::isLoadFromStackSlotPostFE(self: *AArch64InstrInfo, MI: *MachineInstr, FrameIndex: *mut i32) -> Register {
    if !isFrameLoadOpcode(MI.getOpcode()) {
        return Register { Reg: 0 };
    }
    if self.isLoadFromStackSlot(MI, FrameIndex) {
        Reg.operator unsigned int();
    } else {
        return Reg;
    }
    let mut Accesses: SmallVector<const MachineMemOperand *, 1> = SmallVector<const MachineMemOperand *, 1> {};
    if self.hasLoadFromStackSlot(MI, Accesses) {
        if Accesses.len > 1 {
            return Register { Reg: 0 };
        }
        FrameIndex = cast(Accesses.front().getPseudoValue()).getFrameIndex();
        return MI.getOperand(0).getReg();
    }
    return Register { Reg: 0 };
}

fn AArch64InstrInfo::isLdStPairSuppressed(self, MI: *MachineInstr) -> bool {
    return any_of(MI.memoperands(), Closure_4 {});
}

fn AArch64InstrInfo::suppressLdStPair(self, MI: *mut MachineInstr) {
    if MI.memoperands_empty() {
        return;
    }
    (*MI.memoperands_begin()).setFlags(MOSuppressPair);
}

fn AArch64InstrInfo::isStridedAccess(self, MI: *MachineInstr) -> bool {
    return any_of(MI.memoperands(), Closure_5 {});
}

fn AArch64InstrInfo::hasUnscaledLdStOffset(self, Opc: u32) -> bool {
    match Opc {
        _ => {
            return false;
        },
        STURSi => {
            STRSpre;
        },
    }
}

