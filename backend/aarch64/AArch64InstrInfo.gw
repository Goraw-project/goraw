fn cloneInstr(MI: *MachineInstr, ReplaceOprNum: u32, ReplaceReg: Register, MBB: *mut MachineBasicBlock, InsertTo: i32) -> Register {
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut TII: *TargetInstrInfo = MBB.getParent().getSubtarget().getInstrInfo();
    let mut NewMI: *mut MachineInstr = MBB.getParent().CloneMachineInstr(MI);
    let mut Result: Register = 0;
    for let mut I: u32 = 0; I < NewMI.getNumOperands(); I += 1 {
        if I == 0 && NewMI.getOperand(0).getReg().isVirtual() {
            Result = MRI.createVirtualRegister(MRI.getRegClass(NewMI.getOperand(0).getReg()), "");
            NewMI.getOperand(I).setReg(Result);
        } else if I == ReplaceOprNum {
            MRI.constrainRegClass(ReplaceReg, TII.getRegClass(NewMI.getDesc(), I), 0);
            NewMI.getOperand(I).setReg(ReplaceReg);
        }
    }
    MBB()(NewMI);
    return Result;
}

fn AArch64PipelinerLoopInfo::createRemainingIterationsGreaterCondition(self, TC: i32, MBB: *mut MachineBasicBlock, Cond: *mut SmallVectorImpl<MachineOperand>, LastStage0Insts: *mut i32) {
    let mut CC: CondCode = self.CondBranch.getOperand(0).getImm() as CondCode;
    if self.CondBranch.getOperand(1).getMBB() == self.LoopBB {
        CC = getInvertedCondCode(CC);
    }
    let mut AccCond: Register = zeroed();
    let mut AccumulateCond: Closure_41 = Closure_41 { cap_0: self, MBB: &mut MBB };
    if operator!() && [self.Comp]() == &mut MBB {
        let mut Counter: Register = 0;
        for let mut I: i32 = 0; I <= TC; I += 1 {
            let mut NextCounter: Register = 0;
            AccCond = AccumulateCond.call(AccCond, CC);
            if I != TC {
                if I == 0 {
                    if self.Update != self.Comp && self.IsUpdatePriorComp {
                        Counter = [self.Comp](self.CompCounterOprNum)();
                    } else {
                        NextCounter = [self.Update](0)();
                    }
                } else if self.Update != self.Comp {}
            }
            Counter = NextCounter;
        }
    } else {
        let mut Counter: Register = 0;
        if LastStage0Insts()() {
            Counter = self.Init;
        } else {
            Counter = [self.Comp](self.CompCounterOprNum)();
        }
        for let mut I: i32 = 0; I <= TC; I += 1 {
            let mut NextCounter: Register = 0;
            AccCond = AccumulateCond.call(AccCond, CC);
            Counter = NextCounter;
        }
    }
    BuildMI(MBB, MBB()(), self.Comp.getDebugLoc(), self.TII.get)(AccCond)(0)(0);
    Cond()();
    Cond()(CreateImm(EQ));
}

fn extractPhiReg(Phi: *MachineInstr, MBB: *MachineBasicBlock, RegMBB: *mut Register, RegOther: *mut Register) {
    assert!(Phi.getNumOperands() == 5);
    if Phi.getOperand(2).getMBB() == MBB {
        RegMBB = Phi.getOperand(1).getReg();
        RegOther = Phi.getOperand(3).getReg();
    } else {
        assert!(Phi.getOperand(4).getMBB() == MBB);
        RegMBB = Phi.getOperand(3).getReg();
        RegOther = Phi.getOperand(1).getReg();
    }
}

fn isDefinedOutside(Reg: Register, BB: *MachineBasicBlock) -> bool {
    if !Reg.isVirtual() {
        return false;
    }
    let mut MRI: *MachineRegisterInfo = BB.getParent().getRegInfo();
    return MRI.getDefBlock(Reg) != BB;
}

fn getIndVarInfo(Reg: Register, LoopBB: *MachineBasicBlock, UpdateInst: *mut *mut MachineInstr, UpdateCounterOprNum: *mut u32, InitReg: *mut Register, IsUpdatePriorComp: *mut bool) -> bool {
    if LoopBB.pred_size() != 2 {
        return false;
    }
    if !Reg.isVirtual() {
        return false;
    }
    let mut MRI: *MachineRegisterInfo = LoopBB.getParent().getRegInfo();
    UpdateInst = null;
    UpdateCounterOprNum = 0;
    InitReg = 0;
    IsUpdatePriorComp = true;
    let mut CurReg: Register = Reg;
    while true {
        let mut Def: *mut MachineInstr = MRI.getVRegDef(CurReg);
        if Def.getParent() != LoopBB {
            return false;
        }
        if Def.isCopy() {
            if Def.getOperand(0).getSubReg() || Def.getOperand(1).getSubReg() {
                return false;
            }
            CurReg = Def.getOperand(1).getReg();
        } else if Def.isPHI() {
            if InitReg != 0 {
                return false;
            }
            if !UpdateInst {
                IsUpdatePriorComp = false;
            }
            extractPhiReg(*Def, LoopBB, CurReg, InitReg);
        } else {
            if UpdateInst {
                return false;
            }
            match Def.getOpcode() {
                _ => {
                    return false;
                },
            }
            CurReg = Def.getOperand(UpdateCounterOprNum).getReg();
        }
        if !CurReg.isVirtual() {
            return false;
        }
        if Reg == CurReg {
            break;
        }
    }
    if !UpdateInst {
        return false;
    }
    return true;
}

fn AArch64InstrInfo::analyzeLoopForPipelining(self: *AArch64InstrInfo, LoopBB: *mut MachineBasicBlock) -> i32 {
    let mut TBB: *mut MachineBasicBlock = null;
    let mut FBB: *mut MachineBasicBlock = null;
    let mut Cond: SmallVector<MachineOperand, 4> = zeroed();
    if self.analyzeBranch(*LoopBB, TBB, FBB) {
        return null;
    }
    if TBB == LoopBB && FBB == LoopBB {
        return null;
    }
    if TBB != LoopBB && FBB == null {
        return null;
    }
    assert!((TBB == LoopBB || FBB == LoopBB), "The Loop must be a single-basic-block loop");
    let mut CondBranch: *mut MachineInstr = operator&(operator*(LoopBB()()));
    let mut TRI: *TargetRegisterInfo = self.getRegisterInfo();
    if  {
        return null;
    }
    if TBB == LoopBB {
        self.reverseBranchCondition();
    }
    let mut Comp: *mut MachineInstr = null;
    let mut CompCounterOprNum: u32 = 0;
    if !Comp {
        return null;
    }
    let mut Update: *mut MachineInstr = null;
    let mut Init: Register = 0;
    let mut IsUpdatePriorComp: bool = false;
    let mut UpdateCounterOprNum: u32 = 0;
    if !getIndVarInfo(Comp.getOperand(CompCounterOprNum).getReg(), LoopBB, Update, UpdateCounterOprNum, Init, IsUpdatePriorComp) {
        return null;
    }
    return make_unique(LoopBB, CondBranch, Comp, CompCounterOprNum, Update, UpdateCounterOprNum, Init, IsUpdatePriorComp);
}

fn AArch64InstrInfo::verifyInstruction(self: *AArch64InstrInfo, MI: *MachineInstr, ErrInfo: *mut str) -> bool {
    let mut Scale: TypeSize = 0;
    let mut Width: TypeSize = 0;
    let mut MinOffset: i64 = 0;
    let mut MaxOffset: i64 = 0;
    if getMemOpInfo(MI.getOpcode(), Scale, Width, MinOffset, MaxOffset) {
        let mut ImmIdx: u32 = getLoadStoreImmIdx(MI.getOpcode());
        if MI.getOperand(ImmIdx).isImm() && !MI.getOperand(ImmIdx - 1).isFI() {
            let mut Imm: i64 = MI.getOperand(ImmIdx).getImm();
            if Imm < MinOffset || Imm > MaxOffset {
                ErrInfo = "Unexpected immediate on load/store instruction";
                return false;
            }
        }
    }
    let mut MCID: *MCInstrDesc = MI.getDesc();
    for let mut Op: u32 = 0; Op < MCID.getNumOperands(); Op += 1 {
        let mut MO: *MachineOperand = MI.getOperand(Op);
        match MCID.operands()[Op].OperandType {
            OPERAND_IMPLICIT_IMM_0 => {
                if !MO.isImm() || MO.getImm() != 0 {
                    ErrInfo = "OPERAND_IMPLICIT_IMM_0 should be 0";
                    return false;
                }
            },
            OPERAND_SHIFT_MSL => {
                if !MO.isImm() || getShiftType(MO.getImm()) != MSL || (getShiftValue(MO.getImm()) != 8 && getShiftValue(MO.getImm()) != 16) {
                    ErrInfo = "OPERAND_SHIFT_MSL should be msl shift of 8 or 16";
                    return false;
                }
            },
            OPERAND_IMM_UINT1 => {
                if !MO.isImm() || (MO.getImm() != 0 && MO.getImm() != 1) {
                    ErrInfo = "OPERAND_IMM_UINT1 should be 0 or 1";
                    return false;
                }
            },
            OPERAND_IMM_UINT4plus1 => {
                if !MO.isImm() || MO.getImm() <= 0 || MO.getImm() > 16 {
                    ErrInfo = "OPERAND_IMM_UINT4plus1 should be in the range 1 to 16";
                    return false;
                }
            },
            OPERAND_IMM_UINT5 => {
                if !MO.isImm() || !isUInt(MO.getImm()) {
                    ErrInfo = "OPERAND_IMM_UINT5 should be in the range 0 to 31";
                    return false;
                }
            },
            OPERAND_IMM_UINT8 => {
                if !MO.isImm() || !isUInt(MO.getImm()) {
                    ErrInfo = "OPERAND_IMM_UINT8 should be in the range 0 to 255";
                    return false;
                }
            },
            _ => {
                break;
            },
        }
    }
    return true;
}

struct Closure_1 {
    BrOffset: *mut i64,
    MBB: *mut MachineBasicBlock,
    DL: *mut DebugLoc,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Reg: Register, DestBB: *mut MachineBasicBlock) {
        if !isInt((*self.BrOffset)) {
            report_fatal_error("Branch offsets outside of the signed 33-bit range not supported", true);
        }
        BuildMI((*self.MBB), (*self.MBB)()(), (*self.DL), get(), Reg)(DestBB.getSymbol(), MO_PAGE);
        BuildMI((*self.MBB), (*self.MBB)()(), (*self.DL), get(), Reg)(Reg)(DestBB.getSymbol(), MO_PAGEOFF | MO_NC)(0);
        BuildMI((*self.MBB), (*self.MBB)()(), (*self.DL), get())(Reg);
    }

