                LoadDst.setIsUndef(true);
                return &mut LoadMI;
            }
        }
    }
    return null;
}

fn isAArch64FrameOffsetLegal(MI: *MachineInstr, SOffset: *mut StackOffset, OutUseUnscaledOp: *mut bool, OutUnscaledOp: *mut u32, EmittableOffset: *mut i64) -> i32 {
    if EmittableOffset {
        *EmittableOffset = 0;
    }
    if OutUseUnscaledOp {
        *OutUseUnscaledOp = false;
    }
    if OutUnscaledOp {
        *OutUnscaledOp = 0;
    }
    match MI.getOpcode() {
        _ => {
            break;
        },
    }
    let mut ScaleValue: TypeSize = 0;
    let mut Width: TypeSize = 0;
    let mut MinOff: i64 = 0;
    let mut MaxOff: i64 = 0;
    if !getMemOpInfo(MI.getOpcode(), ScaleValue, Width, MinOff, MaxOff) {
        llvm_unreachable_internal("unhandled opcode in isAArch64FrameOffsetLegal", "llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", 7426);
    }
