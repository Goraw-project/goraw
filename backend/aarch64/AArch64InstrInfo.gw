        return;
    }
    if FPR32RegClass.contains(DestReg.operator MCRegister()) && FPR32RegClass.contains(SrcReg.operator MCRegister()) {
        if self.Subtarget.hasZeroCycleRegMoveFPR128() && !self.Subtarget.hasZeroCycleRegMoveFPR64() && !self.Subtarget.hasZeroCycleRegMoveFPR32() && self.Subtarget.isNeonAvailable() && !mustAvoidNeonAtMBBI(self.Subtarget, MBB, I) {
            let mut DestRegQ: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), ssub, &mut FPR128RegClass);
            let mut SrcRegQ: MCRegister = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), ssub, &mut FPR128RegClass);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRv16i8), DestRegQ).addReg(SrcRegQ, Undef, 0).addReg(SrcRegQ, Undef, 0).addReg(SrcReg, Implicit | getKillRegState(KillSrc), 0);
            operator(NumZCRegMoveInstrsFPR);
        } else if self.Subtarget.hasZeroCycleRegMoveFPR64() && !self.Subtarget.hasZeroCycleRegMoveFPR32() {
            let mut DestRegD: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), ssub, &mut FPR64RegClass);
            let mut SrcRegD: MCRegister = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), ssub, &mut FPR64RegClass);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVDr), DestRegD).addReg(SrcRegD, Undef, 0).addReg(SrcReg, Implicit | getKillRegState(KillSrc), 0);
            operator(NumZCRegMoveInstrsFPR);
        } else {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVSr), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0);
            if self.Subtarget.hasZeroCycleRegMoveFPR32() {
                operator(NumZCRegMoveInstrsFPR);
            }
        }
        return;
    }
    if FPR16RegClass.contains(DestReg.operator MCRegister()) && FPR16RegClass.contains(SrcReg.operator MCRegister()) {
        if self.Subtarget.hasZeroCycleRegMoveFPR128() && !self.Subtarget.hasZeroCycleRegMoveFPR64() && !self.Subtarget.hasZeroCycleRegMoveFPR32() && self.Subtarget.isNeonAvailable() && !mustAvoidNeonAtMBBI(self.Subtarget, MBB, I) {
            let mut DestRegQ: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), hsub, &mut FPR128RegClass);
            let mut SrcRegQ: MCRegister = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), hsub, &mut FPR128RegClass);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRv16i8), DestRegQ).addReg(SrcRegQ, Undef, 0).addReg(SrcRegQ, Undef, 0).addReg(SrcReg, Implicit | getKillRegState(KillSrc), 0);
        } else if self.Subtarget.hasZeroCycleRegMoveFPR64() && !self.Subtarget.hasZeroCycleRegMoveFPR32() {
            let mut DestRegD: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), hsub, &mut FPR64RegClass);
            let mut SrcRegD: MCRegister = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), hsub, &mut FPR64RegClass);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVDr), DestRegD).addReg(SrcRegD, Undef, 0).addReg(SrcReg, Implicit | getKillRegState(KillSrc), 0);
        } else {
            DestReg = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), hsub, &mut FPR32RegClass);
            SrcReg = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), hsub, &mut FPR32RegClass);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVSr), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0);
        }
        return;
    }
    if FPR8RegClass.contains(DestReg.operator MCRegister()) && FPR8RegClass.contains(SrcReg.operator MCRegister()) {
        if self.Subtarget.hasZeroCycleRegMoveFPR128() && !self.Subtarget.hasZeroCycleRegMoveFPR64() && !self.Subtarget.hasZeroCycleRegMoveFPR32() && self.Subtarget.isNeonAvailable() && !mustAvoidNeonAtMBBI(self.Subtarget, MBB, I) {
            let mut DestRegQ: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), bsub, &mut FPR128RegClass);
            let mut SrcRegQ: MCRegister = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), bsub, &mut FPR128RegClass);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRv16i8), DestRegQ).addReg(SrcRegQ, Undef, 0).addReg(SrcRegQ, Undef, 0).addReg(SrcReg, Implicit | getKillRegState(KillSrc), 0);
        } else if self.Subtarget.hasZeroCycleRegMoveFPR64() && !self.Subtarget.hasZeroCycleRegMoveFPR32() {
            let mut DestRegD: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), bsub, &mut FPR64RegClass);
            let mut SrcRegD: MCRegister = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), bsub, &mut FPR64RegClass);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVDr), DestRegD).addReg(SrcRegD, Undef, 0).addReg(SrcReg, Implicit | getKillRegState(KillSrc), 0);
        } else {
            DestReg = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), bsub, &mut FPR32RegClass);
            SrcReg = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), bsub, &mut FPR32RegClass);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVSr), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0);
