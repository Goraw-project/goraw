unsafe fn Closure_19::call(self: *mut Closure_19, Opcode: u32, Operand: i32, Pattern: u32) -> auto {
        let mut MRI: *mut MachineRegisterInfo = (*self.MBB).getParent().getRegInfo();
        let mut MO: *mut MachineOperand = (*self.Root).getOperand(Operand);
        let mut MI: *mut MachineInstr = null;
        if MO.isReg() && MO.getReg().isVirtual() {
            MI = MRI.getUniqueVRegDef(MO.getReg());
        }
        if MI && MI.getOpcode() == COPY && MI.getOperand(1).getReg().isVirtual() {
            MI = MRI.getUniqueVRegDef(MI.getOperand(1).getReg());
        }
        if MI && MI.getOpcode() == Opcode {
            (*self.Patterns)()(Pattern);
            return true;
        }
        return false;
    }

