        if DstMO.getSubReg() == 0 && SrcMO.getSubReg() == 0 {
            (((operator!(operator!((TRI.getRegSizeInBits(*getRegClass.call(DstReg.operator unsigned int())) && "Mismatched register size in non subreg COPY")))) || (_wassert(L"TRI.getRegSizeInBits(*getRegClass(DstReg)) == TRI.getRegSizeInBits(*getRegClass(SrcReg)) && \"Mismatched register size in non subreg COPY\"", L"llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", (7298) as u32) , 0)) as void);
            return operator&(operator*( -= 1));
        }
        if  {
            assert!(SrcMO.getSubReg() == 0, "Unexpected subreg on physical register");
            return operator&(operator*( -= 1));
        }
        if IsFill && SrcMO.getSubReg() == 0 && DstMO.isUndef() {
            let mut FillRC: *TargetRegisterClass = null;
            match DstMO.getSubReg() {
                _ => {
                    break;
