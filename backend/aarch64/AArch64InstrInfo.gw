    if operator!(canCmpInstrBeRemoved(*MI, CmpInstr, CmpValue, TRI, IsInvertCC)) {
        return false;
    }
    CmpInstr()();
    if IsInvertCC {}
    return true;
}

fn AArch64InstrInfo::expandPostRAPseudo(self: *AArch64InstrInfo, MI: *mut MachineInstr) -> bool {
    if  {
        return false;
    }
    let mut MBB: *mut MachineBasicBlock = *MI.getParent();
    let mut Subtarget: *mut auto = MBB.getParent();
    let mut TRI: auto = ();
    let mut DL: DebugLoc = MI.getDebugLoc();
    if  {
        let mut DstReg: Register = MI.getOperand(0).getReg();
        let mut SrcReg: Register = MI.getOperand(1).getReg();
        BuildMI(MBB, MI, DL, get(), DstReg)(SrcReg);
        MBB()(MI);
        return true;
    }
    if  {
        let mut TII: *TargetInstrInfo = MBB.getParent().getSubtarget().getInstrInfo();
        let mut TargetMBB: *mut MachineBasicBlock = MI.getOperand(0).getMBB();
        let mut MBBI: auto = zeroed();
        let mut FirstEpilogSEH: i32 = prev();
        while FirstEpilogSEH()(FrameDestroy) &&  != MBB()() {
            FirstEpilogSEH() = prev();
        }
        if FirstEpilogSEH() != MBB()() {
            FirstEpilogSEH() = next();
        }
        BuildMI(MBB, DL, TII.get)(TargetMBB, MO_PAGE);
        BuildMI(MBB, DL, TII.get)(TargetMBB, MO_PAGEOFF | MO_NC)(0);
        TargetMBB.setMachineBlockAddressTaken();
        return true;
    }
    let mut Reg: Register = MI.getOperand(0).getReg();
    let mut M: *mut Module = operator*(MBB.getParent().getFunction());
    if M.getStackProtectorGuard() == "sysreg" {
        let mut SrcReg: *SysReg = null;
        if !SrcReg {
            report_fatal_error("Unknown SysReg for Stack Protector Guard Register", true);
        }
        BuildMI(MBB, MI, DL, get())(Reg, Renamable)(SrcReg.Encoding);
        let mut Offset: i32 = M.getStackProtectorGuardOffset();
        if Offset >= 0 && Offset <= 32760 && Offset % 8 == 0 {
            BuildMI(MBB, MI, DL, get())(Reg)(Reg, Kill)(Offset / 8);
        } else if Offset >= -256 && Offset <= 255 {
            BuildMI(MBB, MI, DL, get())(Reg)(Reg, Kill)(Offset);
        } else if Offset >= -4095 && Offset <= 4095 {
            if Offset > 0 {
                BuildMI(MBB, MI, DL, get())(Reg)(Reg, Kill)(Offset)(0);
            } else {
                BuildMI(MBB, MI, DL, get())(Reg)(Reg, Kill)(-Offset)(0);
            }
            BuildMI(MBB, MI, DL, get())(Reg)(Reg, Kill)(0);
        } else {
            report_fatal_error("Unable to encode Stack Protector Guard Offset", true);
        }
        MBB()(MI);
        return true;
    }
    let mut GV: *GlobalValue = cast((operator*(MI()()))());
    let mut TM: *TargetMachine = MBB.getParent().getTarget();
    let mut OpFlags: u32 = (GV, TM);
    let mut MO_NC: u8 = MO_NC;
    let mut GuardWidth: u32 = M.getStackProtectorGuardValueWidth(if () { 4 } else { 8 });
    if GuardWidth != 4 && GuardWidth != 8 {
        report_fatal_error("Unsupported stack protector value width", true);
    }
    if (OpFlags & MO_GOT) != 0 {
        BuildMI(MBB, MI, DL, get(), Reg)(GV, 0, OpFlags);
        if GuardWidth == 4 {
            let mut Reg32: u32 = ;
            BuildMI(MBB, MI, DL, get())(Reg32, Dead)(Reg, Kill)(0)(operator*(MI()()))(Reg, Implicit);
        } else {
            BuildMI(MBB, MI, DL, get(), Reg)(Reg, Kill)(0)(operator*(MI()()));
        }
    } else if TM.getCodeModel() == Large {
        BuildMI(MBB, MI, DL, get(), Reg)(GV, 0, MO_G0 | MO_NC)(0);
        BuildMI(MBB, MI, DL, get(), Reg)(Reg, Kill)(GV, 0, MO_G1 | MO_NC)(16);
        BuildMI(MBB, MI, DL, get(), Reg)(Reg, Kill)(GV, 0, MO_G2 | MO_NC)(32);
        BuildMI(MBB, MI, DL, get(), Reg)(Reg, Kill)(GV, 0, MO_G3)(48);
        if GuardWidth == 4 {
            let mut Reg32: u32 = ;
            BuildMI(MBB, MI, DL, get())(Reg32, Dead)(Reg, Kill)(0)(operator*(MI()()))(Reg, Implicit);
        } else {
            BuildMI(MBB, MI, DL, get(), Reg)(Reg, Kill)(0)(operator*(MI()()));
        }
    } else {
        BuildMI(MBB, MI, DL, get(), Reg)(GV, 0, OpFlags | MO_PAGE);
        let mut LoFlags: u8 = OpFlags | MO_PAGEOFF | MO_NC;
        if GuardWidth == 4 {
            let mut Reg32: u32 = ;
            BuildMI(MBB, MI, DL, get())(Reg32, Dead)(Reg, Kill)(GV, 0, LoFlags)(operator*(MI()()))(Reg, Implicit);
        } else {
            BuildMI(MBB, MI, DL, get(), Reg)(Reg, Kill)(GV, 0, LoFlags)(operator*(MI()()));
        }
    }
    if Subtarget()()() {
        BuildMI(MBB, MI, DL, get(), Reg)(Reg, Kill);
    }
    MBB()(MI);
    return true;
}

