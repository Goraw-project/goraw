        return;
    }
    if FPR64RegClass.contains(DestReg.operator MCRegister()) && GPR64RegClass.contains(SrcReg.operator MCRegister()) {
        if XZR == SrcReg.operator unsigned int() {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVD0), DestReg);
        } else {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVXDr), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0);
        }
        return;
    }
    if GPR64RegClass.contains(DestReg.operator MCRegister()) && FPR64RegClass.contains(SrcReg.operator MCRegister()) {
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVDXr), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0);
        return;
    }
    if FPR32RegClass.contains(DestReg.operator MCRegister()) && GPR32RegClass.contains(SrcReg.operator MCRegister()) {
        if WZR == SrcReg.operator unsigned int() {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVS0), DestReg);
        } else {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVWSr), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0);
        }
        return;
    }
    if GPR32RegClass.contains(DestReg.operator MCRegister()) && FPR32RegClass.contains(SrcReg.operator MCRegister()) {
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVSWr), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0);
        return;
    }
    if DestReg == NZCV {
        assert!(GPR64RegClass.contains(SrcReg.operator MCRegister()), "Invalid NZCV copy");
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MSR)).addImm(NZCV).addReg(SrcReg, getKillRegState(KillSrc), 0).addReg(NZCV, Implicit | Define, 0);
        return;
    }
    if SrcReg == NZCV {
        assert!(GPR64RegClass.contains(DestReg.operator MCRegister()), "Invalid NZCV copy");
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MRS), DestReg).addImm(NZCV).addReg(NZCV, Implicit | getKillRegState(KillSrc), 0);
        return;
    }
    errs() << self.RI.getRegAsmName(DestReg.operator MCRegister()) << " = COPY " << self.RI.getRegAsmName(SrcReg.operator MCRegister()) << "\n";
    llvm_unreachable_internal("unimplemented reg-to-reg copy", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 6429);
}

fn AArch64InstrInfo::copyPhysReg(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, I: iterator, DL: *DebugLoc, DestReg: Register, SrcReg: Register, KillSrc: bool, RenamableDest: bool, RenamableSrc: bool) {
    operator(NumCopyInstrs);
    self.copyPhysRegImpl(MBB, I, DL, DestReg, SrcReg, KillSrc, RenamableDest, RenamableSrc);
    return;
}

fn storeRegPairToStackSlot(TRI: *TargetRegisterInfo, MBB: *mut MachineBasicBlock, InsertBefore: iterator, MCID: *MCInstrDesc, SrcReg: Register, IsKill: bool, SubIdx0: u32, SubIdx1: u32, FI: i32, MMO: *mut MachineMemOperand) {
    let mut SrcReg0: Register = SrcReg;
    let mut SrcReg1: Register = SrcReg;
    if SrcReg.isPhysical() {
        SrcReg0 = TRI.getSubReg(SrcReg.operator MCRegister(), SubIdx0);
        SubIdx0 = 0;
        SrcReg1 = TRI.getSubReg(SrcReg.operator MCRegister(), SubIdx1);
        SubIdx1 = 0;
    }
    BuildMI(MBB, InsertBefore, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, MCID).addReg(SrcReg0, getKillRegState(IsKill), SubIdx0).addReg(SrcReg1, getKillRegState(IsKill), SubIdx1).addFrameIndex(FI).addImm(0).addMemOperand(MMO);
}

fn AArch64InstrInfo::storeRegToStackSlot(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, MBBI: iterator, SrcReg: Register, isKill: bool, FI: i32, RC: *TargetRegisterClass, VReg: Register, Flags: MIFlag) {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FI, 0);
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MOStore, MFI.getObjectSize(FI), MFI.getObjectAlign(FI), MMOMetadata {}, System, NotAtomic, NotAtomic);
    let mut Opc: u32 = 0;
    let mut Offset: bool = true;
    let mut PNRReg: MCRegister = NoRegister;
    let mut StackID: u32 = Default;
    match self.RI.getSpillSize(*RC) {
        1 => {
            if FPR8RegClass.hasSubClassEq(RC) {
                Opc = STRBui;
            }
        },
        2 => {
            if FPR16RegClass.hasSubClassEq(RC) {
                Opc = STRHui;
            } else if PNRRegClass.hasSubClassEq(RC) || PPRRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register store without SVE store instructions");
                Opc = STR_PXI;
                StackID = ScalablePredicateVector;
            }
            break;
        },
        4 => {
            if GPR32allRegClass.hasSubClassEq(RC) {
                Opc = STRWui;
                if SrcReg.isVirtual() {
                    MF.getRegInfo().constrainRegClass(SrcReg, &mut GPR32RegClass, 0);
                } else {
                    assert!(SrcReg != WSP);
                }
            } else if FPR32RegClass.hasSubClassEq(RC) {
                Opc = STRSui;
            } else if PPR2RegClass.hasSubClassEq(RC) {
                Opc = STR_PPXI;
                StackID = ScalablePredicateVector;
            }
        },
        8 => {
            if GPR64allRegClass.hasSubClassEq(RC) {
                Opc = STRXui;
                if SrcReg.isVirtual() {
                    MF.getRegInfo().constrainRegClass(SrcReg, &mut GPR64RegClass, 0);
                } else {
                    assert!(SrcReg != SP);
                }
            } else if FPR64RegClass.hasSubClassEq(RC) {
                Opc = STRDui;
            } else if WSeqPairsClassRegClass.hasSubClassEq(RC) {
                storeRegPairToStackSlot(self.getRegisterInfo(), MBB, MBBI, self.get(STPWi), SrcReg, isKill, sube32, subo32, FI, MMO);
                return;
            }
        },
        16 => {
            if FPR128RegClass.hasSubClassEq(RC) {
                Opc = STRQui;
            } else if DDRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register store without NEON");
                Opc = ST1Twov1d;
                Offset = false;
            } else if XSeqPairsClassRegClass.hasSubClassEq(RC) {
                storeRegPairToStackSlot(self.getRegisterInfo(), MBB, MBBI, self.get(STPXi), SrcReg, isKill, sube64, subo64, FI, MMO);
                return;
            } else if ZPRRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register store without SVE store instructions");
                Opc = STR_ZXI;
                StackID = ScalableVector;
            }
        },
        24 => {
            if DDDRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register store without NEON");
                Opc = ST1Threev1d;
                Offset = false;
            }
        },
        32 => {
            if DDDDRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register store without NEON");
                Opc = ST1Fourv1d;
                Offset = false;
            } else if QQRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register store without NEON");
                Opc = ST1Twov2d;
                Offset = false;
            } else if ZPR2StridedOrContiguousRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register store without SVE store instructions");
                Opc = STR_ZZXI_STRIDED_CONTIGUOUS;
                StackID = ScalableVector;
            } else if ZPR2RegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register store without SVE store instructions");
                Opc = STR_ZZXI;
                StackID = ScalableVector;
            }
        },
        48 => {
            if QQQRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register store without NEON");
                Opc = ST1Threev2d;
                Offset = false;
            } else if ZPR3RegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register store without SVE store instructions");
                Opc = STR_ZZZXI;
                StackID = ScalableVector;
            }
        },
        64 => {
            if QQQQRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register store without NEON");
                Opc = ST1Fourv2d;
                Offset = false;
            } else if ZPR4StridedOrContiguousRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register store without SVE store instructions");
                Opc = STR_ZZZZXI_STRIDED_CONTIGUOUS;
                StackID = ScalableVector;
            } else if ZPR4RegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register store without SVE store instructions");
                Opc = STR_ZZZZXI;
                StackID = ScalableVector;
            }
        },
    }
    assert!(Opc, "Unknown register class");
    MFI.setStackID(FI, StackID);
    let mut MI: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc)).addReg(SrcReg, getKillRegState(isKill), 0).addFrameIndex(FI);
    if Offset {
        MI.addImm(0);
    }
    if PNRReg.isValid() {
        MI.addDef(PNRReg, Implicit, 0);
    }
    MI.addMemOperand(MMO);
}

fn loadRegPairFromStackSlot(TRI: *TargetRegisterInfo, MBB: *mut MachineBasicBlock, InsertBefore: iterator, MCID: *MCInstrDesc, DestReg: Register, SubIdx0: u32, SubIdx1: u32, FI: i32, MMO: *mut MachineMemOperand) {
    let mut DestReg0: Register = DestReg;
    let mut DestReg1: Register = DestReg;
    let mut IsUndef: bool = true;
    if DestReg.isPhysical() {
        DestReg0 = TRI.getSubReg(DestReg.operator MCRegister(), SubIdx0);
        SubIdx0 = 0;
        DestReg1 = TRI.getSubReg(DestReg.operator MCRegister(), SubIdx1);
        SubIdx1 = 0;
        IsUndef = false;
    }
    BuildMI(MBB, InsertBefore, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, MCID).addReg(DestReg0, Define | getUndefRegState(IsUndef), SubIdx0).addReg(DestReg1, Define | getUndefRegState(IsUndef), SubIdx1).addFrameIndex(FI).addImm(0).addMemOperand(MMO);
}

fn AArch64InstrInfo::loadRegFromStackSlot(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, MBBI: iterator, DestReg: Register, FI: i32, RC: *TargetRegisterClass, VReg: Register, SubReg: u32, Flags: MIFlag) {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FI, 0);
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MOLoad, MFI.getObjectSize(FI), MFI.getObjectAlign(FI), MMOMetadata {}, System, NotAtomic, NotAtomic);
    let mut Opc: u32 = 0;
    let mut Offset: bool = true;
    let mut StackID: u32 = Default;
    let mut PNRReg: Register = 0;
    match self.TRI.getSpillSize(*RC) {
        1 => {
            if FPR8RegClass.hasSubClassEq(RC) {
                Opc = LDRBui;
            }
        },
        2 => {
            let mut IsPNR: bool = PNRRegClass.hasSubClassEq(RC);
            if FPR16RegClass.hasSubClassEq(RC) {
                Opc = LDRHui;
            } else if IsPNR || PPRRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register load without SVE load instructions");
                if IsPNR {
                    PNRReg = DestReg;
                }
                Opc = LDR_PXI;
                StackID = ScalablePredicateVector;
            }
            break;
        },
        4 => {
            if GPR32allRegClass.hasSubClassEq(RC) {
                Opc = LDRWui;
                if DestReg.isVirtual() {
                    MF.getRegInfo().constrainRegClass(DestReg, &mut GPR32RegClass, 0);
                } else {
                    assert!(DestReg != WSP);
                }
            } else if FPR32RegClass.hasSubClassEq(RC) {
                Opc = LDRSui;
            } else if PPR2RegClass.hasSubClassEq(RC) {
                Opc = LDR_PPXI;
                StackID = ScalablePredicateVector;
            }
        },
        8 => {
            if GPR64allRegClass.hasSubClassEq(RC) {
                Opc = LDRXui;
                if DestReg.isVirtual() {
                    MF.getRegInfo().constrainRegClass(DestReg, &mut GPR64RegClass, 0);
                } else {
                    assert!(DestReg != SP);
                }
            } else if FPR64RegClass.hasSubClassEq(RC) {
                Opc = LDRDui;
            } else if WSeqPairsClassRegClass.hasSubClassEq(RC) {
                loadRegPairFromStackSlot(self.getRegisterInfo(), MBB, MBBI, self.get(LDPWi), DestReg, sube32, subo32, FI, MMO);
                return;
            }
        },
        16 => {
            if FPR128RegClass.hasSubClassEq(RC) {
                Opc = LDRQui;
            } else if DDRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register load without NEON");
                Opc = LD1Twov1d;
                Offset = false;
            } else if XSeqPairsClassRegClass.hasSubClassEq(RC) {
                loadRegPairFromStackSlot(self.getRegisterInfo(), MBB, MBBI, self.get(LDPXi), DestReg, sube64, subo64, FI, MMO);
                return;
            } else if ZPRRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register load without SVE load instructions");
                Opc = LDR_ZXI;
                StackID = ScalableVector;
            }
        },
        24 => {
            if DDDRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register load without NEON");
                Opc = LD1Threev1d;
                Offset = false;
            }
        },
        32 => {
            if DDDDRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register load without NEON");
                Opc = LD1Fourv1d;
                Offset = false;
            } else if QQRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register load without NEON");
                Opc = LD1Twov2d;
                Offset = false;
            } else if ZPR2StridedOrContiguousRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register load without SVE load instructions");
                Opc = LDR_ZZXI_STRIDED_CONTIGUOUS;
                StackID = ScalableVector;
            } else if ZPR2RegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register load without SVE load instructions");
                Opc = LDR_ZZXI;
                StackID = ScalableVector;
            }
        },
        48 => {
            if QQQRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register load without NEON");
                Opc = LD1Threev2d;
                Offset = false;
            } else if ZPR3RegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register load without SVE load instructions");
                Opc = LDR_ZZZXI;
                StackID = ScalableVector;
            }
        },
        64 => {
            if QQQQRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.hasNEON(), "Unexpected register load without NEON");
                Opc = LD1Fourv2d;
                Offset = false;
            } else if ZPR4StridedOrContiguousRegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register load without SVE load instructions");
                Opc = LDR_ZZZZXI_STRIDED_CONTIGUOUS;
                StackID = ScalableVector;
            } else if ZPR4RegClass.hasSubClassEq(RC) {
                assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected register load without SVE load instructions");
                Opc = LDR_ZZZZXI;
                StackID = ScalableVector;
            }
        },
    }
    assert!(Opc, "Unknown register class");
    MFI.setStackID(FI, StackID);
    let mut MI: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opc)).addReg(DestReg, getDefRegState(true), 0).addFrameIndex(FI);
    if Offset {
        MI.addImm(0);
    }
    if PNRReg.isValid() && !PNRReg.isVirtual() {
        MI.addDef(PNRReg, Implicit, 0);
    }
    MI.addMemOperand(MMO);
}

fn isNZCVTouchedInInstructionRange(DefMI: *MachineInstr, UseMI: *MachineInstr, TRI: *TargetRegisterInfo) -> bool {
    return any_of(instructionsWithoutDebug(next(DefMI.getIterator(), 1), UseMI.getIterator(), true), Closure_14 { TRI: TRI });
}

fn AArch64InstrInfo::decomposeStackOffsetForDwarfOffsets(self, Offset: *StackOffset, ByteSized: *mut i64, VGSized: *mut i64) {
    assert!(Offset.getScalable() % 2 == 0, "Invalid frame offset");
    ByteSized = Offset.getFixed();
    VGSized = Offset.getScalable() / 2;
}

fn AArch64InstrInfo::decomposeStackOffsetForFrameOffsets(self, Offset: *StackOffset, NumBytes: *mut i64, NumPredicateVectors: *mut i64, NumDataVectors: *mut i64) {
    assert!(Offset.getScalable() % 2 == 0, "Invalid frame offset");
    NumBytes = Offset.getFixed();
    NumDataVectors = 0;
    NumPredicateVectors = Offset.getScalable() / 2;
    if NumPredicateVectors % 8 == 0 || NumPredicateVectors < -64 || NumPredicateVectors > 62 {
        NumDataVectors = NumPredicateVectors / 8;
        NumPredicateVectors -= NumDataVectors * 8;
    }
}

fn appendConstantExpr(Expr: *mut SmallVectorImpl<char>, Constant: i64, Operation: LocationAtom) {
    if Operation == DW_OP_plus && Constant < 0 && -Constant <= 31 {
        Expr.push(DW_OP_lit0 - Constant);
        Operation = DW_OP_minus;
    } else if Constant >= 0 && Constant <= 31 {
        Expr.push(DW_OP_lit0 + Constant);
    } else {
        Expr.push(DW_OP_consts);
        appendLEB128(Expr, Constant);
    }
    return Expr.push(Operation);
}

fn appendReadRegExpr(Expr: *mut SmallVectorImpl<char>, RegNum: u32) {
    Expr.push(DW_OP_bregx as i8);
    appendLEB128(Expr, RegNum);
    Expr.push(0);
}

fn appendLoadRegExpr(Expr: *mut SmallVectorImpl<char>, OffsetFromDefCFA: i64) {
    Expr.push(DW_OP_dup);
    appendConstantExpr(Expr, OffsetFromDefCFA, DW_OP_plus);
    Expr.push(DW_OP_deref);
}

fn appendOffsetComment(NumBytes: i32, Comment: *mut raw_string_ostream, RegScale: str) {
    if NumBytes {
        Comment << (if NumBytes < 0 { " - " } else { " + " }) << if NumBytes < 0 { -NumBytes } else { NumBytes };
        if !RegScale.is_empty() {
            Comment << ' ' << RegScale;
        }
    }
}

fn createDefCFAExpression(TRI: *TargetRegisterInfo, Reg: u32, Offset: *StackOffset) -> MCCFIInstruction {
    let mut NumBytes: i64 = 0;
    let mut NumVGScaledBytes: i64 = 0;
    decomposeStackOffsetForDwarfOffsets(Offset, NumBytes, NumVGScaledBytes);
    let mut CommentBuffer: str = "";
    let mut Comment: raw_string_ostream = CommentBuffer;
    if Reg == SP {
        Comment << "sp";
    } else if Reg == FP {
        Comment << "fp";
    } else {
        Comment << printReg(Reg, &mut TRI, 0, null);
    }
    let mut Expr: str = "";
    let mut DwarfReg: u32 = TRI.getDwarfRegNum(Reg, true);
    assert!(DwarfReg <= 31, "DwarfReg out of bounds (0..31)");
    Expr.push(DW_OP_breg0 + DwarfReg);
    appendLEB128(Expr, NumBytes);
    appendOffsetComment(NumBytes, Comment, "");
    if NumVGScaledBytes {
        appendOffsetComment(NumVGScaledBytes, Comment, "* VG");
        appendReadRegExpr(Expr, TRI.getDwarfRegNum(VG, true));
        appendConstantExpr(Expr, NumVGScaledBytes, DW_OP_mul);
        Expr.push(DW_OP_plus);
    }
    let mut DefCfaExpr: str = "";
    DefCfaExpr.push(DW_CFA_def_cfa_expression);
    appendLEB128(DefCfaExpr, Expr.len);
    DefCfaExpr.append(Expr);
    return createEscape(null, DefCfaExpr, SMLoc {}, Comment);
}

fn createDefCFA(TRI: *TargetRegisterInfo, FrameReg: u32, Reg: u32, Offset: *StackOffset, LastAdjustmentWasScalable: bool) -> MCCFIInstruction {
    if Offset.getScalable() {
        return createDefCFAExpression(TRI, Reg, Offset);
    }
    if FrameReg == Reg && !LastAdjustmentWasScalable {
        return cfiDefCfaOffset(null, Offset.getFixed(), SMLoc {});
    }
    let mut DwarfReg: u32 = TRI.getDwarfRegNum(Reg, true);
    return cfiDefCfa(null, DwarfReg, Offset.getFixed() as i32, SMLoc {});
}

fn createCFAOffset(TRI: *TargetRegisterInfo, Reg: u32, OffsetFromDefCFA: *StackOffset, IncomingVGOffsetFromDefCFA: optional<int64_t>) -> MCCFIInstruction {
    let mut NumBytes: i64 = 0;
    let mut NumVGScaledBytes: i64 = 0;
    decomposeStackOffsetForDwarfOffsets(OffsetFromDefCFA, NumBytes, NumVGScaledBytes);
    let mut DwarfReg: u32 = TRI.getDwarfRegNum(Reg, true);
    if !NumVGScaledBytes {
        return createOffset(null, DwarfReg, NumBytes, SMLoc {});
    }
    let mut CommentBuffer: str = "";
    let mut Comment: raw_string_ostream = CommentBuffer;
    Comment << printReg(Reg, &mut TRI, 0, null) << "  @ cfa";
    assert!(NumVGScaledBytes, "Expected scalable offset");
    let mut OffsetExpr: str = "";
    let mut VGRegScale: str = "";
    if IncomingVGOffsetFromDefCFA {
        appendLoadRegExpr(OffsetExpr, operator(IncomingVGOffsetFromDefCFA));
        VGRegScale = "* IncomingVG";
    } else {
        appendReadRegExpr(OffsetExpr, TRI.getDwarfRegNum(VG, true));
        VGRegScale = "* VG";
    }
    appendConstantExpr(OffsetExpr, NumVGScaledBytes, DW_OP_mul);
    appendOffsetComment(NumVGScaledBytes, Comment, VGRegScale);
    OffsetExpr.push(DW_OP_plus);
    if NumBytes {
        appendOffsetComment(NumBytes, Comment, "");
        appendConstantExpr(OffsetExpr, NumBytes, DW_OP_plus);
    }
    let mut CfaExpr: str = "";
    CfaExpr.push(DW_CFA_expression);
    appendLEB128(CfaExpr, DwarfReg);
    appendLEB128(CfaExpr, OffsetExpr.len);
    CfaExpr.append(OffsetExpr);
    return createEscape(null, CfaExpr, SMLoc {}, Comment);
}

fn emitFrameOffsetAdj(MBB: *mut MachineBasicBlock, MBBI: iterator, DL: *DebugLoc, DestReg: u32, SrcReg: u32, Offset: i64, Opc: u32, TII: *TargetInstrInfo, Flag: MIFlag, NeedsWinCFI: bool, HasWinCFI: *mut bool, EmitCFAOffset: bool, CFAOffset: StackOffset, FrameReg: u32) {
    let mut Sign: i32 = 1;
    let mut MaxEncoding: u32 = 0;
    let mut ShiftSize: u32 = 0;
    match Opc {
        ADDXri => {
            ADDSXri;
        },
        ADDVL_XXI => {
            ADDPL_XXI;
        },
        _ => {
            llvm_unreachable_internal("Unsupported opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 7047);
        },
    }
    let mut VScale: i32 = 1;
    if Opc == ADDVL_XXI || Opc == ADDSVL_XXI {
        VScale = 16;
    } else if Opc == ADDPL_XXI || Opc == ADDSPL_XXI {
        VScale = 2;
    }
    let mut MaxEncodableValue: u32 = MaxEncoding << ShiftSize;
    let mut TmpReg: Register = DestReg;
    if TmpReg == XZR {
        TmpReg = MBB.getParent().getRegInfo().createVirtualRegister(&mut GPR64RegClass, "");
    }
    while true {
        {
        let mut ThisVal: u64 = if Offset < MaxEncodableValue { Offset } else { MaxEncodableValue };
        let mut LocalShiftSize: u32 = 0;
        if ThisVal > MaxEncoding {
            ThisVal = ThisVal >> ShiftSize;
            LocalShiftSize = ShiftSize;
        }
        assert!((ThisVal >> ShiftSize) <= MaxEncoding, "Encoding cannot handle value that big");
        Offset -= ThisVal << LocalShiftSize;
        if Offset == 0 {
            TmpReg = DestReg;
        }
        let mut MBI: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Opc), TmpReg).addReg(SrcReg, RegState {}, 0).addImm(Sign * ThisVal as i32);
        if ShiftSize {
            MBI = MBI.addImm(getShifterImm(LSL, LocalShiftSize));
        }
        MBI = MBI.setMIFlag(Flag);
        let mut Change: StackOffset = if VScale == 1 { getFixed(ThisVal << LocalShiftSize) } else { getScalable(VScale * (ThisVal << LocalShiftSize)) };
        if Sign == -1 || Opc == SUBXri || Opc == SUBSXri {
            operator(CFAOffset, Change);
        } else {
            operator(CFAOffset, Change);
        }
        if EmitCFAOffset && DestReg == TmpReg.operator unsigned int() {
            let mut MF: *mut MachineFunction = *MBB.getParent();
            let mut STI: *TargetSubtargetInfo = MF.getSubtarget();
            let mut TRI: *TargetRegisterInfo = *STI.getRegisterInfo();
            let mut CFIIndex: u32 = MF.addFrameInst(createDefCFA(TRI, FrameReg, DestReg, CFAOffset, VScale != 1));
            BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(CFI_INSTRUCTION)).addCFIIndex(CFIIndex).setMIFlags(Flag);
        }
        if NeedsWinCFI {
            let mut Imm: i32 = (ThisVal << LocalShiftSize) as i32;
            if VScale != 1 && DestReg == SP {
                if HasWinCFI {
                    *HasWinCFI = true;
                }
                BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_AllocZ)).addImm(ThisVal).setMIFlag(Flag);
            } else if (DestReg == FP && SrcReg == SP) || (SrcReg == FP && DestReg == SP) {
                assert!(VScale == 1, "Expected non-scalable operation");
                if HasWinCFI {
                    *HasWinCFI = true;
                }
                if Imm == 0 {
                    BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_SetFP)).setMIFlag(Flag);
                } else {
                    BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_AddFP)).addImm(Imm).setMIFlag(Flag);
                }
                assert!(Offset == 0, "Expected remaining offset to be zero to emit a single SEH directive");
            } else if DestReg == SP {
                assert!(VScale == 1, "Expected non-scalable operation");
                if HasWinCFI {
                    *HasWinCFI = true;
                }
                assert!(SrcReg == SP, "Unexpected SrcReg for SEH_StackAlloc");
                BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_StackAlloc)).addImm(Imm).setMIFlag(Flag);
            }
        }
        SrcReg = TmpReg.operator unsigned int();
    }
        if !(Offset) { break; }
    }
}

fn emitFrameOffset(MBB: *mut MachineBasicBlock, MBBI: iterator, DL: *DebugLoc, DestReg: u32, SrcReg: u32, Offset: StackOffset, TII: *TargetInstrInfo, Flag: MIFlag, SetNZCV: bool, NeedsWinCFI: bool, HasWinCFI: *mut bool, EmitCFAOffset: bool, CFAOffset: StackOffset, FrameReg: u32) {
    let mut F: *Function = MBB.getParent().getFunction();
    let mut UseSVL: bool = F.hasFnAttribute("aarch64_pstate_sm_body");
    let mut Bytes: i64 = 0;
    let mut NumPredicateVectors: i64 = 0;
    let mut NumDataVectors: i64 = 0;
    decomposeStackOffsetForFrameOffsets(Offset, Bytes, NumPredicateVectors, NumDataVectors);
    let mut NeedsFinalDefNZCV: bool = SetNZCV && (NumPredicateVectors || NumDataVectors);
    if NeedsFinalDefNZCV {
        SetNZCV = false;
    }
    if Bytes || (!Offset && SrcReg != DestReg) {
        assert!((DestReg != SP || Bytes % 8 == 0), "SP increment/decrement not 8-byte aligned");
        let mut Opc: u32 = if SetNZCV { ADDSXri } else { ADDXri };
        if Bytes < 0 {
            Bytes = -Bytes;
            Opc = if SetNZCV { SUBSXri } else { SUBXri };
        }
        emitFrameOffsetAdj(MBB, MBBI, DL, DestReg, SrcReg, Bytes, Opc, TII, Flag, NeedsWinCFI, HasWinCFI, EmitCFAOffset, CFAOffset, FrameReg);
        operator(CFAOffset, if (Opc == ADDXri || Opc == ADDSXri) { getFixed(-Bytes) } else { getFixed(Bytes) });
        SrcReg = DestReg;
        FrameReg = DestReg;
    }
    assert!(!(NeedsWinCFI && NumPredicateVectors), "WinCFI can't allocate fractions of an SVE data vector");
    if NumDataVectors {
        emitFrameOffsetAdj(MBB, MBBI, DL, DestReg, SrcReg, NumDataVectors, if UseSVL { ADDSVL_XXI } else { ADDVL_XXI }, TII, Flag, NeedsWinCFI, HasWinCFI, EmitCFAOffset, CFAOffset, FrameReg);
        operator(CFAOffset, getScalable(-NumDataVectors * 16));
        SrcReg = DestReg;
    }
    if NumPredicateVectors {
        assert!(DestReg != SP, "Unaligned access to SP");
        emitFrameOffsetAdj(MBB, MBBI, DL, DestReg, SrcReg, NumPredicateVectors, if UseSVL { ADDSPL_XXI } else { ADDPL_XXI }, TII, Flag, NeedsWinCFI, HasWinCFI, EmitCFAOffset, CFAOffset, FrameReg);
    }
    if NeedsFinalDefNZCV {
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(ADDSXri), DestReg).addReg(DestReg, RegState {}, 0).addImm(0).addImm(0);
    }
}

fn AArch64InstrInfo::foldMemoryOperandImpl(self: *AArch64InstrInfo, MF: *mut MachineFunction, MI: *mut MachineInstr, Ops: ArrayRef<unsigned int>, FrameIndex: i32, CopyMI: *mut *mut MachineInstr, LIS: *mut LiveIntervals, VRM: *mut VirtRegMap) -> *mut MachineInstr {
    let mut InsertPt: iterator = MI;
    if MI.isFullCopy() {
        let mut DstReg: Register = MI.getOperand(0).getReg();
        let mut SrcReg: Register = MI.getOperand(1).getReg();
        if SrcReg == SP && DstReg.isVirtual() {
            MF.getRegInfo().constrainRegClass(DstReg, &mut GPR64RegClass, 0);
            return null;
        }
        if DstReg == SP && SrcReg.isVirtual() {
            MF.getRegInfo().constrainRegClass(SrcReg, &mut GPR64RegClass, 0);
            return null;
        }
        if SrcReg == NZCV || DstReg == NZCV {
            return null;
        }
    }
    if MI.isCopy() && Ops.len == 1 && (Ops[0] == 0 || Ops[0] == 1) {
        let mut IsSpill: bool = Ops[0] == 0;
        let mut IsFill: bool = !IsSpill;
        let mut TRI: *TargetRegisterInfo = *MF.getSubtarget().getRegisterInfo();
        let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
        let mut MBB: *mut MachineBasicBlock = *MI.getParent();
        let mut DstMO: *MachineOperand = MI.getOperand(0);
        let mut SrcMO: *MachineOperand = MI.getOperand(1);
        let mut DstReg: Register = DstMO.getReg();
        let mut SrcReg: Register = SrcMO.getReg();
        let mut getRegClass: Closure_15 = Closure_15 { MRI: &mut MRI, TRI: &mut TRI };
        if DstMO.getSubReg() == 0 && SrcMO.getSubReg() == 0 {
            assert!(TRI.getRegSizeInBits(*getRegClass.call(DstReg.operator unsigned int())) == TRI.getRegSizeInBits(*getRegClass.call(SrcReg.operator unsigned int())), "Mismatched register size in non subreg COPY");
            if IsSpill {
                self.storeRegToStackSlot(MBB, InsertPt, SrcReg, SrcMO.isKill(), FrameIndex, getRegClass.call(SrcReg.operator unsigned int()), Register { Reg: 0 }, NoFlags);
            } else {
                self.loadRegFromStackSlot(MBB, InsertPt, DstReg, FrameIndex, getRegClass.call(DstReg.operator unsigned int()), Register { Reg: 0 }, 0, NoFlags);
            }
            return &mut operator(operator(InsertPt));
        }
        if IsSpill && DstMO.isUndef() && SrcReg == WZR && TRI.getRegSizeInBits(*getRegClass.call(DstReg.operator unsigned int())).operator unsigned long long() == 64 {
            assert!(SrcMO.getSubReg() == 0, "Unexpected subreg on physical register");
            self.storeRegToStackSlot(MBB, InsertPt, XZR, SrcMO.isKill(), FrameIndex, &mut GPR64RegClass, Register { Reg: 0 }, NoFlags);
            return &mut operator(operator(InsertPt));
        }
        if IsFill && SrcMO.getSubReg() == 0 && DstMO.isUndef() {
            let mut FillRC: *TargetRegisterClass = null;
            match DstMO.getSubReg() {
                _ => {
                    break;
                },
                sub_32 => {
                    if GPR64RegClass.hasSubClassEq(getRegClass.call(DstReg.operator unsigned int())) {
                        FillRC = &mut GPR32RegClass;
                    }
                },
                ssub => {
                    FillRC = &mut FPR32RegClass;
                },
                dsub => {
                    FillRC = &mut FPR64RegClass;
                },
            }
            if FillRC {
                assert!(TRI.getRegSizeInBits(*getRegClass.call(SrcReg.operator unsigned int())) == TRI.getRegSizeInBits(*FillRC), "Mismatched regclass size on folded subreg COPY");
                self.loadRegFromStackSlot(MBB, InsertPt, DstReg, FrameIndex, FillRC, Register { Reg: 0 }, 0, NoFlags);
                let mut LoadMI: *mut MachineInstr = operator(operator(InsertPt));
                let mut LoadDst: *mut MachineOperand = LoadMI.getOperand(0);
                assert!(LoadDst.getSubReg() == 0, "unexpected subreg on fill load");
                LoadDst.setSubReg(DstMO.getSubReg());
                LoadDst.setIsUndef(true);
                return &mut LoadMI;
            }
        }
    }
    return null;
}

fn isAArch64FrameOffsetLegal(MI: *MachineInstr, SOffset: *mut StackOffset, OutUseUnscaledOp: *mut bool, OutUnscaledOp: *mut u32, EmittableOffset: *mut i64) -> i32 {
    if EmittableOffset {
        *EmittableOffset = 0;
    }
    if OutUseUnscaledOp {
        *OutUseUnscaledOp = false;
    }
    if OutUnscaledOp {
        *OutUnscaledOp = 0;
    }
    match MI.getOpcode() {
        _ => {
            break;
        },
        LD1Rv1d => {
            LD1Rv2s;
        },
    }
    let mut ScaleValue: TypeSize = TypeSize { 0, false };
    let mut Width: TypeSize = TypeSize { 0, false };
    let mut MinOff: i64 = 0;
    let mut MaxOff: i64 = 0;
    if !getMemOpInfo(MI.getOpcode(), ScaleValue, Width, MinOff, MaxOff) {
        llvm_unreachable_internal("unhandled opcode in isAArch64FrameOffsetLegal", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 7426);
    }
    let mut IsMulVL: bool = ScaleValue.isScalable();
    let mut Scale: u32 = ScaleValue.getKnownMinValue();
    let mut Offset: i64 = if IsMulVL { SOffset.getScalable() } else { SOffset.getFixed() };
    let mut ImmOpnd: *MachineOperand = MI.getOperand(getLoadStoreImmIdx(MI.getOpcode()));
    Offset += ImmOpnd.getImm() * Scale;
    let mut UnscaledOp: optional<unsigned int> = getUnscaledLdSt(MI.getOpcode());
    let mut useUnscaledOp: bool = UnscaledOp && (Offset % Scale || Offset < 0);
    if useUnscaledOp && !getMemOpInfo(operator(UnscaledOp), ScaleValue, Width, MinOff, MaxOff) {
        llvm_unreachable_internal("unhandled opcode in isAArch64FrameOffsetLegal", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 7446);
    }
    Scale = ScaleValue.getKnownMinValue();
    assert!(IsMulVL == ScaleValue.isScalable(), "Unscaled opcode has different value for scalable");
    let mut Remainder: i64 = Offset % Scale;
    assert!(!(Remainder && useUnscaledOp), "Cannot have remainder when using unscaled op");
    assert!(MinOff < MaxOff, "Unexpected Min/Max offsets");
    let mut NewOffset: i64 = Offset / Scale;
    if MinOff <= NewOffset && NewOffset <= MaxOff {
        Offset = Remainder;
    } else {
        let mut HighPart: i64 = Offset & ~4095;
        let mut LowPart: i64 = Offset & 4095;
        let mut LowScaled: i64 = LowPart / Scale;
        if !IsMulVL && NewOffset >= 0 && LowPart % Scale == 0 && MinOff <= LowScaled && LowScaled <= MaxOff && isLegalArithImmed(HighPart) {
            NewOffset = LowScaled;
            Offset = HighPart;
        } else {
            NewOffset = if NewOffset < 0 { MinOff } else { MaxOff };
            Offset = Offset - (NewOffset * Scale);
        }
    }
    if EmittableOffset {
        *EmittableOffset = NewOffset;
    }
    if OutUseUnscaledOp {
        *OutUseUnscaledOp = useUnscaledOp;
    }
    if OutUnscaledOp && UnscaledOp {
        *OutUnscaledOp = operator(UnscaledOp);
    }
    if IsMulVL {
        SOffset = get(SOffset.getFixed(), Offset);
    } else {
        SOffset = get(Offset, SOffset.getScalable());
    }
    return AArch64FrameOffsetCanUpdate | (if SOffset { 0 } else { AArch64FrameOffsetIsLegal });
}

fn rewriteAArch64FrameIndex(MI: *mut MachineInstr, FrameRegIdx: u32, FrameReg: u32, Offset: *mut StackOffset, TII: *AArch64InstrInfo) -> bool {
    let mut Opcode: u32 = MI.getOpcode();
    let mut ImmIdx: u32 = FrameRegIdx + 1;
    if Opcode == ADDSXri || Opcode == ADDXri {
        operator(Offset, getFixed(MI.getOperand(ImmIdx).getImm()));
        emitFrameOffset(*MI.getParent(), MI, MI.getDebugLoc(), MI.getOperand(0).getReg().operator unsigned int(), FrameReg, Offset, TII, NoFlags, (Opcode == ADDSXri), false, null, false, StackOffset {}, SP);
        MI.eraseFromParent();
        Offset = StackOffset {};
        return true;
    }
    let mut NewOffset: i64 = 0;
    let mut UnscaledOp: u32 = 0;
    let mut UseUnscaledOp: bool = false;
    let mut Status: i32 = isAArch64FrameOffsetLegal(MI, Offset, &mut UseUnscaledOp, &mut UnscaledOp, &mut NewOffset);
    if Status & AArch64FrameOffsetCanUpdate {
        if Status & AArch64FrameOffsetIsLegal {
            MI.getOperand(FrameRegIdx).ChangeToRegister(FrameReg, false, false, false, false, false, false);
        }
        if UseUnscaledOp {
            MI.setDesc(TII.get(UnscaledOp));
        }
        MI.getOperand(ImmIdx).ChangeToImmediate(NewOffset, 0);
        return !Offset;
    }
    return false;
}

fn AArch64InstrInfo::insertNoop(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, MI: iterator) {
    let mut DL: DebugLoc = null;
    BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(NOP));
}

fn AArch64InstrInfo::getNop(self: *AArch64InstrInfo) -> MCInst {
    return NOP.operator llvm::MCInst &();
}

fn AArch64InstrInfo::useMachineCombiner(self: *AArch64InstrInfo) -> bool {
    return true;
}

fn isCombineInstrSettingFlag(Opc: u32) -> bool {
    match Opc {
        ADDSWrr => {
            ADDSWri;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn isCombineInstrCandidate32(Opc: u32) -> bool {
    match Opc {
        ADDWrr => {
            ADDWri;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn isCombineInstrCandidate64(Opc: u32) -> bool {
    match Opc {
        ADDXrr => {
            ADDXri;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn isCombineInstrCandidateFP(Inst: *MachineInstr) -> bool {
    match Inst.getOpcode() {
        _ => {
            break;
        },
        FADDHrr => {
            FADDSrr;
        },
    }
    return false;
}

fn isCombineInstrCandidate(Opc: u32) -> bool {
    return (isCombineInstrCandidate32(Opc) || isCombineInstrCandidate64(Opc));
}

fn canCombine(MBB: *mut MachineBasicBlock, MO: *mut MachineOperand, CombineOpc: u32, ZeroReg: u32, CheckZeroReg: bool) -> bool {
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut MI: *mut MachineInstr = null;
    if MO.isReg() && MO.getReg().isVirtual() {
        MI = MRI.getUniqueVRegDef(MO.getReg());
    }
    if !MI || MI.getParent() != &mut MBB || MI.getOpcode() != CombineOpc {
        return false;
    }
    if !MRI.hasOneNonDBGUse(MI.getOperand(0).getReg()) {
        return false;
    }
    if CheckZeroReg {
        assert!(MI.getNumOperands() >= 4 && MI.getOperand(0).isReg() && MI.getOperand(1).isReg() && MI.getOperand(2).isReg() && MI.getOperand(3).isReg(), "MAdd/MSub must have a least 4 regs");
        if MI.getOperand(3).getReg() != ZeroReg {
            return false;
        }
    }
    if isCombineInstrSettingFlag(CombineOpc) && MI.findRegisterDefOperandIdx(NZCV, null, true, false) == -1 {
        return false;
    }
    return true;
}

fn canCombineWithMUL(MBB: *mut MachineBasicBlock, MO: *mut MachineOperand, MulOpc: u32, ZeroReg: u32) -> bool {
    return canCombine(MBB, MO, MulOpc, ZeroReg, true);
}

fn canCombineWithFMUL(MBB: *mut MachineBasicBlock, MO: *mut MachineOperand, MulOpc: u32) -> bool {
    return canCombine(MBB, MO, MulOpc, 0, false);
}

fn AArch64InstrInfo::isAssociativeAndCommutative(self: *AArch64InstrInfo, Inst: *MachineInstr, Invert: bool) -> bool {
    if Invert {
        return false;
    }
    match Inst.getOpcode() {
        FADDHrr => {
            FADDSrr;
        },
        ADDWrr => {
            ADDXrr;
        },
        _ => {
            return false;
        },
    }
}

fn getMaddPatterns(Root: *mut MachineInstr, Patterns: *mut SmallVectorImpl<unsigned int>) -> bool {
    let mut Opc: u32 = Root.getOpcode();
    let mut MBB: *mut MachineBasicBlock = *Root.getParent();
    let mut Found: bool = false;
    if !isCombineInstrCandidate(Opc) {
        return false;
    }
    if isCombineInstrSettingFlag(Opc) {
        let mut Cmp_NZCV: i32 = Root.findRegisterDefOperandIdx(NZCV, null, true, false);
        if Cmp_NZCV == -1 {
            return false;
        }
        let mut NewOpc: u32 = convertToNonFlagSettingOpc(Root);
        if NewOpc == Opc {
            return false;
        }
        Opc = NewOpc;
    }
    let mut setFound: Closure_16 = Closure_16 { MBB: &mut MBB, Root: &mut Root, Patterns: &mut Patterns, Found: &mut Found };
    let mut setVFound: Closure_17 = Closure_17 { MBB: &mut MBB, Root: &mut Root, Patterns: &mut Patterns, Found: &mut Found };
    match Opc {
        _ => {
            break;
        },
        ADDWrr => {
            assert!(Root.getOperand(1).isReg() && Root.getOperand(2).isReg(), "ADDWrr does not have register operands");
        },
        ADDXrr => {
            setFound.call(MADDXrrr, 1, XZR, MULADDX_OP1);
        },
        SUBWrr => {
            setFound.call(MADDWrrr, 2, WZR, MULSUBW_OP2);
        },
        SUBXrr => {
            setFound.call(MADDXrrr, 2, XZR, MULSUBX_OP2);
        },
        ADDWri => {
            setFound.call(MADDWrrr, 1, WZR, MULADDWI_OP1);
        },
        ADDXri => {
            setFound.call(MADDXrrr, 1, XZR, MULADDXI_OP1);
        },
        SUBWri => {
            setFound.call(MADDWrrr, 1, WZR, MULSUBWI_OP1);
        },
        SUBXri => {
            setFound.call(MADDXrrr, 1, XZR, MULSUBXI_OP1);
        },
        ADDv8i8 => {
            setVFound.call(MULv8i8, 1, MULADDv8i8_OP1);
        },
        ADDv16i8 => {
            setVFound.call(MULv16i8, 1, MULADDv16i8_OP1);
        },
        ADDv4i16 => {
            setVFound.call(MULv4i16, 1, MULADDv4i16_OP1);
        },
        ADDv8i16 => {
            setVFound.call(MULv8i16, 1, MULADDv8i16_OP1);
        },
        ADDv2i32 => {
            setVFound.call(MULv2i32, 1, MULADDv2i32_OP1);
        },
        ADDv4i32 => {
            setVFound.call(MULv4i32, 1, MULADDv4i32_OP1);
        },
        SUBv8i8 => {
            setVFound.call(MULv8i8, 1, MULSUBv8i8_OP1);
        },
        SUBv16i8 => {
            setVFound.call(MULv16i8, 1, MULSUBv16i8_OP1);
        },
        SUBv4i16 => {
            setVFound.call(MULv4i16, 1, MULSUBv4i16_OP1);
        },
        SUBv8i16 => {
            setVFound.call(MULv8i16, 1, MULSUBv8i16_OP1);
        },
        SUBv2i32 => {
            setVFound.call(MULv2i32, 1, MULSUBv2i32_OP1);
        },
        SUBv4i32 => {
            setVFound.call(MULv4i32, 1, MULSUBv4i32_OP1);
        },
    }
    return Found;
}

fn AArch64InstrInfo::isAccumulationOpcode(self: *AArch64InstrInfo, Opcode: u32) -> bool {
    match Opcode {
        _ => {
            break;
        },
        UABALB_ZZZ_D => {
            UABALB_ZZZ_H;
        },
    }
    return false;
}

fn AArch64InstrInfo::getAccumulationStartOpcode(self: *AArch64InstrInfo, AccumulationOpcode: u32) -> u32 {
    match AccumulationOpcode {
        _ => {
            llvm_unreachable_internal("Unsupported accumulation Opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 7991);
        },
        UABALB_ZZZ_D => {
            return UABDLB_ZZZ_D;
        },
        UABALB_ZZZ_H => {
            return UABDLB_ZZZ_H;
        },
        UABALB_ZZZ_S => {
            return UABDLB_ZZZ_S;
        },
        UABALT_ZZZ_D => {
            return UABDLT_ZZZ_D;
        },
        UABALT_ZZZ_H => {
            return UABDLT_ZZZ_H;
        },
        UABALT_ZZZ_S => {
            return UABDLT_ZZZ_S;
        },
        UABALv16i8_v8i16 => {
            return UABDLv16i8_v8i16;
        },
        UABALv2i32_v2i64 => {
            return UABDLv2i32_v2i64;
        },
        UABALv4i16_v4i32 => {
            return UABDLv4i16_v4i32;
        },
        UABALv4i32_v2i64 => {
            return UABDLv4i32_v2i64;
        },
        UABALv8i16_v4i32 => {
            return UABDLv8i16_v4i32;
        },
        UABALv8i8_v8i16 => {
            return UABDLv8i8_v8i16;
        },
        UABAv16i8 => {
            return UABDv16i8;
        },
        UABAv2i32 => {
            return UABDv2i32;
        },
        UABAv4i16 => {
            return UABDv4i16;
        },
        UABAv4i32 => {
            return UABDv4i32;
        },
        UABAv8i16 => {
            return UABDv8i16;
        },
        UABAv8i8 => {
            return UABDv8i8;
        },
        SABALB_ZZZ_D => {
            return SABDLB_ZZZ_D;
        },
        SABALB_ZZZ_S => {
            return SABDLB_ZZZ_S;
        },
        SABALB_ZZZ_H => {
            return SABDLB_ZZZ_H;
        },
        SABALT_ZZZ_D => {
            return SABDLT_ZZZ_D;
        },
        SABALT_ZZZ_S => {
            return SABDLT_ZZZ_S;
        },
        SABALT_ZZZ_H => {
            return SABDLT_ZZZ_H;
        },
        SABALv16i8_v8i16 => {
            return SABDLv16i8_v8i16;
        },
        SABALv2i32_v2i64 => {
            return SABDLv2i32_v2i64;
        },
        SABALv4i16_v4i32 => {
            return SABDLv4i16_v4i32;
        },
        SABALv4i32_v2i64 => {
            return SABDLv4i32_v2i64;
        },
        SABALv8i16_v4i32 => {
            return SABDLv8i16_v4i32;
        },
        SABALv8i8_v8i16 => {
            return SABDLv8i8_v8i16;
        },
        SABAv16i8 => {
            return SABDv16i8;
        },
        SABAv2i32 => {
            return SABDv2i32;
        },
        SABAv4i16 => {
            return SABDv4i16;
        },
        SABAv4i32 => {
            return SABDv4i32;
        },
        SABAv8i16 => {
            return SABDv8i16;
        },
        SABAv8i8 => {
            return SABDv8i8;
        },
    }
}

fn getFMAPatterns(Root: *mut MachineInstr, Patterns: *mut SmallVectorImpl<unsigned int>) -> bool {
    if !isCombineInstrCandidateFP(Root) {
        return false;
    }
    let mut MBB: *mut MachineBasicBlock = *Root.getParent();
    let mut Found: bool = false;
    let mut Match: Closure_18 = Closure_18 { MBB: &mut MBB, Root: &mut Root, Patterns: &mut Patterns };
    match Root.getOpcode() {
        _ => {
            assert!(false, "Unsupported FP instruction in combiner\n");
        },
        FADDHrr => {
            assert!(Root.getOperand(1).isReg() && Root.getOperand(2).isReg(), "FADDHrr does not have register operands");
        },
        FADDSrr => {
            assert!(Root.getOperand(1).isReg() && Root.getOperand(2).isReg(), "FADDSrr does not have register operands");
        },
        FADDDrr => {
            Found |= Match.call(FMULDrr, 1, FMULADDD_OP1) || Match.call(FMULv1i64_indexed, 1, FMLAv1i64_indexed_OP1);
        },
        FADDv4f16 => {
            Found |= Match.call(FMULv4i16_indexed, 1, FMLAv4i16_indexed_OP1) || Match.call(FMULv4f16, 1, FMLAv4f16_OP1);
        },
        FADDv8f16 => {
            Found |= Match.call(FMULv8i16_indexed, 1, FMLAv8i16_indexed_OP1) || Match.call(FMULv8f16, 1, FMLAv8f16_OP1);
        },
        FADDv2f32 => {
            Found |= Match.call(FMULv2i32_indexed, 1, FMLAv2i32_indexed_OP1) || Match.call(FMULv2f32, 1, FMLAv2f32_OP1);
        },
        FADDv2f64 => {
            Found |= Match.call(FMULv2i64_indexed, 1, FMLAv2i64_indexed_OP1) || Match.call(FMULv2f64, 1, FMLAv2f64_OP1);
        },
        FADDv4f32 => {
            Found |= Match.call(FMULv4i32_indexed, 1, FMLAv4i32_indexed_OP1) || Match.call(FMULv4f32, 1, FMLAv4f32_OP1);
        },
        FSUBHrr => {
            Found = Match.call(FMULHrr, 1, FMULSUBH_OP1);
        },
        FSUBSrr => {
            Found = Match.call(FMULSrr, 1, FMULSUBS_OP1);
        },
        FSUBDrr => {
            Found = Match.call(FMULDrr, 1, FMULSUBD_OP1);
        },
        FSUBv4f16 => {
            Found |= Match.call(FMULv4i16_indexed, 2, FMLSv4i16_indexed_OP2) || Match.call(FMULv4f16, 2, FMLSv4f16_OP2);
        },
        FSUBv8f16 => {
            Found |= Match.call(FMULv8i16_indexed, 2, FMLSv8i16_indexed_OP2) || Match.call(FMULv8f16, 2, FMLSv8f16_OP2);
        },
        FSUBv2f32 => {
            Found |= Match.call(FMULv2i32_indexed, 2, FMLSv2i32_indexed_OP2) || Match.call(FMULv2f32, 2, FMLSv2f32_OP2);
        },
        FSUBv2f64 => {
            Found |= Match.call(FMULv2i64_indexed, 2, FMLSv2i64_indexed_OP2) || Match.call(FMULv2f64, 2, FMLSv2f64_OP2);
        },
        FSUBv4f32 => {
            Found |= Match.call(FMULv4i32_indexed, 2, FMLSv4i32_indexed_OP2) || Match.call(FMULv4f32, 2, FMLSv4f32_OP2);
        },
    }
    return Found;
}

fn getFMULPatterns(Root: *mut MachineInstr, Patterns: *mut SmallVectorImpl<unsigned int>) -> bool {
    let mut MBB: *mut MachineBasicBlock = *Root.getParent();
    let mut Found: bool = false;
    let mut Match: Closure_19 = Closure_19 { MBB: &mut MBB, Root: &mut Root, Patterns: &mut Patterns };
    match Root.getOpcode() {
        _ => {
            return false;
        },
        FMULv2f32 => {
            Found = Match.call(DUPv2i32lane, 1, FMULv2i32_indexed_OP1);
        },
        FMULv2f64 => {
            Found = Match.call(DUPv2i64lane, 1, FMULv2i64_indexed_OP1);
        },
        FMULv4f16 => {
            Found = Match.call(DUPv4i16lane, 1, FMULv4i16_indexed_OP1);
        },
        FMULv4f32 => {
            Found = Match.call(DUPv4i32lane, 1, FMULv4i32_indexed_OP1);
        },
        FMULv8f16 => {
            Found = Match.call(DUPv8i16lane, 1, FMULv8i16_indexed_OP1);
        },
    }
    return Found;
}

fn getFNEGPatterns(Root: *mut MachineInstr, Patterns: *mut SmallVectorImpl<unsigned int>) -> bool {
    let mut Opc: u32 = Root.getOpcode();
    let mut MBB: *mut MachineBasicBlock = *Root.getParent();
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut Match: Closure_20 = Closure_20 { Root: &mut Root, MRI: &mut MRI, Patterns: &mut Patterns };
    match Opc {
        _ => {
            break;
        },
        FNEGDr => {
            return Match.call(FMADDDrrr, FNMADD);
        },
        FNEGSr => {
            return Match.call(FMADDSrrr, FNMADD);
        },
    }
    return false;
}

fn AArch64InstrInfo::isThroughputPattern(self: *AArch64InstrInfo, Pattern: u32) -> bool {
    match Pattern {
        _ => {
            break;
        },
        FMULADDH_OP1 => {
            FMULADDH_OP2;
        },
    }
    return false;
}

fn getMiscPatterns(Root: *mut MachineInstr, Patterns: *mut SmallVectorImpl<unsigned int>) -> bool {
    let mut Opc: u32 = Root.getOpcode();
    let mut MBB: *mut MachineBasicBlock = *Root.getParent();
    match Opc {
        SUBWrr => {
            SUBSWrr;
        },
        _ => {
            return false;
        },
    }
    if isCombineInstrSettingFlag(Opc) && Root.findRegisterDefOperandIdx(NZCV, null, true, false) == -1 {
        return false;
    }
    if canCombine(MBB, Root.getOperand(2), ADDWrr, 0, false) || canCombine(MBB, Root.getOperand(2), ADDSWrr, 0, false) || canCombine(MBB, Root.getOperand(2), ADDXrr, 0, false) || canCombine(MBB, Root.getOperand(2), ADDSXrr, 0, false) {
        Patterns.push(SUBADD_OP1);
        Patterns.push(SUBADD_OP2);
        return true;
    }
    return false;
}

fn getGatherLanePattern(Root: *mut MachineInstr, Patterns: *mut SmallVectorImpl<unsigned int>, LoadLaneOpCode: u32, NumLanes: u32) -> bool {
    let mut MF: *MachineFunction = Root.getMF();
    if MF.getFunction().hasMinSize() {
        return false;
    }
    let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
    let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
    if Root.getOperand(2).getImm() != NumLanes - 1 {
        return false;
    }
    let mut CurrInstr: *mut MachineInstr = MRI.getUniqueVRegDef(Root.getOperand(1).getReg());
    let mut Range: iota_range<unsigned int> = seq(1, NumLanes - 1);
    let mut RemainingLanes: SmallSet<unsigned int, 16> = SmallSet<unsigned int, 16> { Range.begin(), Range.end() };
    let mut LoadInstrs: SmallVector<const MachineInstr *, 16> = SmallVector<const MachineInstr *, 16> {};
    while !RemainingLanes.is_empty() && CurrInstr && CurrInstr.getOpcode() == LoadLaneOpCode && MRI.hasOneNonDBGUse(CurrInstr.getOperand(0).getReg()) && CurrInstr.getNumOperands() == 4 {
        RemainingLanes.erase(CurrInstr.getOperand(2).getImm());
        LoadInstrs.push(CurrInstr);
        CurrInstr = MRI.getUniqueVRegDef(CurrInstr.getOperand(1).getReg());
    }
    if !RemainingLanes.is_empty() {
        return false;
    }
    if CurrInstr.getOpcode() != SUBREG_TO_REG {
        return false;
    }
    let mut Lane0LoadReg: Register = CurrInstr.getOperand(1).getReg();
    let mut SingleLaneSizeInBits: u32 = 128 / NumLanes;
    if TRI.getRegSizeInBits(Lane0LoadReg, MRI).operator unsigned long long() != SingleLaneSizeInBits {
        return false;
    }
    if !MRI.hasOneNonDBGUse(Lane0LoadReg) {
        return false;
    }
    LoadInstrs.push(MRI.getUniqueVRegDef(Lane0LoadReg));
    let mut MBBItr: self_iterator = Root.getIterator();
    let mut RemainingSteps: u32 = GatherOptSearchLimit.operator unsigned int();
    let mut RemainingLoadInstrs: SmallPtrSet<const MachineInstr *, 16> = SmallPtrSet<const MachineInstr *, 16> {};
    RemainingLoadInstrs.insert(LoadInstrs.begin(), LoadInstrs.end());
    let mut MBB: *MachineBasicBlock = Root.getParent();
    for ; MBBItr != MBB.begin() && RemainingSteps > 0 && !RemainingLoadInstrs.is_empty(); operator(MBBItr) , RemainingSteps -= 1 {
        let mut CurrInstr: *MachineInstr = operator(MBBItr);
        RemainingLoadInstrs.erase(&mut CurrInstr);
        if CurrInstr.isLoadFoldBarrier() {
            return false;
        }
    }
    if RemainingSteps == 0 && !RemainingLoadInstrs.is_empty() {
        return false;
    }
    match NumLanes {
        4 => {
            Patterns.push(GATHER_LANE_i32);
        },
        8 => {
            Patterns.push(GATHER_LANE_i16);
        },
        16 => {
            Patterns.push(GATHER_LANE_i8);
        },
        _ => {
            llvm_unreachable_internal("Got bad number of lanes for gather pattern.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 8562);
        },
    }
    return true;
}

fn getLoadPatterns(Root: *mut MachineInstr, Patterns: *mut SmallVectorImpl<unsigned int>) -> bool {
    match Root.getOpcode() {
        LD1i32 => {
            return getGatherLanePattern(Root, Patterns, Root.getOpcode(), 4);
        },
        LD1i16 => {
            return getGatherLanePattern(Root, Patterns, Root.getOpcode(), 8);
        },
        LD1i8 => {
            return getGatherLanePattern(Root, Patterns, Root.getOpcode(), 16);
        },
        _ => {
            return false;
        },
    }
}

fn generateGatherLanePattern(Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, DelInstrs: *mut SmallVectorImpl<MachineInstr *>, InstrIdxForVirtReg: *mut DenseMap<Register, unsigned int>, Pattern: u32, NumLanes: u32) {
    let mut MF: *mut MachineFunction = *Root.getParent().getParent();
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    let mut LoadToLaneInstrs: SmallVector<MachineInstr *, 16> = SmallVector<MachineInstr *, 16> {};
    let mut CurrInstr: *mut MachineInstr = &mut Root;
    for let mut i: u32 = 0; i < NumLanes - 1; i += 1 {
        LoadToLaneInstrs.push(CurrInstr);
        CurrInstr = MRI.getUniqueVRegDef(CurrInstr.getOperand(1).getReg());
    }
    sort(LoadToLaneInstrs, Closure_21 {});
    let mut SubregToReg: *mut MachineInstr = CurrInstr;
    LoadToLaneInstrs.push(MRI.getUniqueVRegDef(SubregToReg.getOperand(1).getReg()));
    let mut LoadToLaneInstrsAscending: MachineInstr **>> = reverse(LoadToLaneInstrs);
    let mut FPR128RegClass: *TargetRegisterClass = MRI.getRegClass(Root.getOperand(0).getReg());
    let mut CreateLD1Instruction: Closure_22 = Closure_22 { MRI: &mut MRI, FPR128RegClass: &mut FPR128RegClass, MF: &mut MF, TII: &mut TII, Root: &mut Root, InstrIdxForVirtReg: &mut InstrIdxForVirtReg, InsInstrs: &mut InsInstrs };
    let mut CreateLDRInstruction: Closure_23 = Closure_23 { MF: &mut MF, Root: &mut Root, TII: &mut TII };
    let mut LanesToLoadToReg0: MachineInstr **>> = make_range(LoadToLaneInstrsAscending.begin() + 1, LoadToLaneInstrsAscending.begin() + NumLanes / 2);
    let mut PrevReg: Register = SubregToReg.getOperand(0).getReg();
    for x in enumerate(LanesToLoadToReg0) {
        let mut OffsetRegOperand: *MachineOperand = LoadInstr.getOperand(3);
        PrevReg = CreateLD1Instruction.call(LoadInstr, PrevReg, Index + 1, OffsetRegOperand.getReg(), OffsetRegOperand.isKill());
        DelInstrs.push(LoadInstr);
    }
    let mut LastLoadReg0: Register = PrevReg;
    let mut Lane0Load: *mut MachineInstr = operator(LoadToLaneInstrsAscending.begin());
    let mut OriginalSplitLoad: *mut MachineInstr = operator(next(LoadToLaneInstrsAscending.begin(), NumLanes / 2));
    let mut DestRegForMiddleIndex: Register = MRI.createVirtualRegister(MRI.getRegClass(Lane0Load.getOperand(0).getReg()), "");
    let mut OriginalSplitToLoadOffsetOperand: *MachineOperand = OriginalSplitLoad.getOperand(3);
    let mut MiddleIndexLoadInstr: MachineInstrBuilder = CreateLDRInstruction.call(NumLanes, DestRegForMiddleIndex, OriginalSplitToLoadOffsetOperand.getReg(), OriginalSplitLoad.memoperands());
    InstrIdxForVirtReg.insert(make_pair(DestRegForMiddleIndex, InsInstrs.len));
    InsInstrs.push(MiddleIndexLoadInstr.operator llvm::MachineInstr *());
    DelInstrs.push(OriginalSplitLoad);
    let mut DestRegForSubregToReg: Register = MRI.createVirtualRegister(FPR128RegClass, "");
    let mut SubregType: u32 = 0;
    match NumLanes {
        4 => {
            SubregType = ssub;
        },
        8 => {
            SubregType = hsub;
        },
        16 => {
            SubregType = bsub;
        },
        _ => {
            llvm_unreachable_internal("Got invalid NumLanes for machine-combiner gather pattern", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 8715);
        },
    }
    let mut SubRegToRegInstr: MachineInstrBuilder = BuildMI(MF, Root, TII.get(SubregToReg.getOpcode()), DestRegForSubregToReg).addReg(DestRegForMiddleIndex, getKillRegState(true), 0).addImm(SubregType);
    InstrIdxForVirtReg.insert(make_pair(DestRegForSubregToReg, InsInstrs.len));
    InsInstrs.push(SubRegToRegInstr.operator llvm::MachineInstr *());
    let mut LanesToLoadToReg1: MachineInstr **>> = make_range(LoadToLaneInstrsAscending.begin() + NumLanes / 2 + 1, LoadToLaneInstrsAscending.end());
    PrevReg = operator(SubRegToRegInstr).getOperand(0).getReg();
    for x in enumerate(LanesToLoadToReg1) {
        let mut OffsetRegOperand: *MachineOperand = LoadInstr.getOperand(3);
        PrevReg = CreateLD1Instruction.call(LoadInstr, PrevReg, Index + 1, OffsetRegOperand.getReg(), OffsetRegOperand.isKill());
        if Index == NumLanes / 2 - 2 {
            break;
        }
        DelInstrs.push(LoadInstr);
    }
    let mut LastLoadReg1: Register = PrevReg;
    let mut ZipInstr: MachineInstrBuilder = BuildMI(MF, Root, TII.get(ZIP1v2i64), Root.getOperand(0).getReg()).addReg(LastLoadReg0, RegState {}, 0).addReg(LastLoadReg1, RegState {}, 0);
    InsInstrs.push(ZipInstr.operator llvm::MachineInstr *());
}

fn AArch64InstrInfo::getCombinerObjective(self: *AArch64InstrInfo, Pattern: u32) -> CombinerObjective {
    match Pattern {
        SUBADD_OP1 => {
            SUBADD_OP2;
        },
        _ => {
            return self.getCombinerObjective(Pattern);
        },
    }
}

fn AArch64InstrInfo::getMachineCombinerPatterns(self: *AArch64InstrInfo, Root: *mut MachineInstr, Patterns: *mut SmallVectorImpl<unsigned int>, DoRegPressureReduce: bool) -> bool {
    if getMaddPatterns(Root, Patterns) {
        return true;
    }
    if getFMULPatterns(Root, Patterns) {
        return true;
    }
    if getFMAPatterns(Root, Patterns) {
        return true;
    }
    if getFNEGPatterns(Root, Patterns) {
        return true;
    }
    if getMiscPatterns(Root, Patterns) {
        return true;
    }
    if getLoadPatterns(Root, Patterns) {
        return true;
    }
    return self.getMachineCombinerPatterns(Root, Patterns, DoRegPressureReduce);
}

enum FMAInstKind {
    Default = 0,
    Indexed = 1,
    Accumulator = 2,
}

fn genFusedMultiply(MF: *mut MachineFunction, MRI: *mut MachineRegisterInfo, TII: *TargetInstrInfo, Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, IdxMulOpd: u32, MaddOpc: u32, RC: *TargetRegisterClass, kind: FMAInstKind, ReplacedAddend: *Register) -> *mut MachineInstr {
    assert!(IdxMulOpd == 1 || IdxMulOpd == 2);
    let mut IdxOtherOpd: u32 = if IdxMulOpd == 1 { 2 } else { 1 };
    let mut MUL: *mut MachineInstr = MRI.getUniqueVRegDef(Root.getOperand(IdxMulOpd).getReg());
    let mut ResultReg: Register = Root.getOperand(0).getReg();
    let mut SrcReg0: Register = MUL.getOperand(1).getReg();
    let mut Src0IsKill: bool = MUL.getOperand(1).isKill();
    let mut SrcReg1: Register = MUL.getOperand(2).getReg();
    let mut Src1IsKill: bool = MUL.getOperand(2).isKill();
    let mut SrcReg2: Register = 0;
    let mut Src2IsKill: bool = false;
    if ReplacedAddend {
        SrcReg2 = *ReplacedAddend;
        Src2IsKill = true;
    } else {
        SrcReg2 = Root.getOperand(IdxOtherOpd).getReg();
        Src2IsKill = Root.getOperand(IdxOtherOpd).isKill();
    }
    if ResultReg.isVirtual() {
        MRI.constrainRegClass(ResultReg, RC, 0);
    }
    if SrcReg0.isVirtual() {
        MRI.constrainRegClass(SrcReg0, RC, 0);
    }
    if SrcReg1.isVirtual() {
        MRI.constrainRegClass(SrcReg1, RC, 0);
    }
    if SrcReg2.isVirtual() {
        MRI.constrainRegClass(SrcReg2, RC, 0);
    }
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    if kind == Default {
        MIB = BuildMI(MF, Root, TII.get(MaddOpc), ResultReg).addReg(SrcReg0, getKillRegState(Src0IsKill), 0).addReg(SrcReg1, getKillRegState(Src1IsKill), 0).addReg(SrcReg2, getKillRegState(Src2IsKill), 0);
    } else if kind == Indexed {
        MIB = BuildMI(MF, Root, TII.get(MaddOpc), ResultReg).addReg(SrcReg2, getKillRegState(Src2IsKill), 0).addReg(SrcReg0, getKillRegState(Src0IsKill), 0).addReg(SrcReg1, getKillRegState(Src1IsKill), 0).addImm(MUL.getOperand(3).getImm());
    } else if kind == Accumulator {
        MIB = BuildMI(MF, Root, TII.get(MaddOpc), ResultReg).addReg(SrcReg2, getKillRegState(Src2IsKill), 0).addReg(SrcReg0, getKillRegState(Src0IsKill), 0).addReg(SrcReg1, getKillRegState(Src1IsKill), 0);
    } else {
        assert!(false, "Invalid FMA instruction kind \n");
    }
    InsInstrs.push(MIB.operator llvm::MachineInstr *());
    return MUL;
}

fn genFNegatedMAD(MF: *mut MachineFunction, MRI: *mut MachineRegisterInfo, TII: *TargetInstrInfo, Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>) -> *mut MachineInstr {
    let mut MAD: *mut MachineInstr = MRI.getUniqueVRegDef(Root.getOperand(1).getReg());
    let mut Opc: u32 = 0;
    let mut RC: *TargetRegisterClass = MRI.getRegClass(MAD.getOperand(0).getReg());
    if FPR32RegClass.hasSubClassEq(RC) {
        Opc = FNMADDSrrr;
    } else if FPR64RegClass.hasSubClassEq(RC) {
        Opc = FNMADDDrrr;
    } else {
        return null;
    }
    let mut ResultReg: Register = Root.getOperand(0).getReg();
    let mut SrcReg0: Register = MAD.getOperand(1).getReg();
    let mut SrcReg1: Register = MAD.getOperand(2).getReg();
    let mut SrcReg2: Register = MAD.getOperand(3).getReg();
    let mut Src0IsKill: bool = MAD.getOperand(1).isKill();
    let mut Src1IsKill: bool = MAD.getOperand(2).isKill();
    let mut Src2IsKill: bool = MAD.getOperand(3).isKill();
    if ResultReg.isVirtual() {
        MRI.constrainRegClass(ResultReg, RC, 0);
    }
    if SrcReg0.isVirtual() {
        MRI.constrainRegClass(SrcReg0, RC, 0);
    }
    if SrcReg1.isVirtual() {
        MRI.constrainRegClass(SrcReg1, RC, 0);
    }
    if SrcReg2.isVirtual() {
        MRI.constrainRegClass(SrcReg2, RC, 0);
    }
    let mut MIB: MachineInstrBuilder = BuildMI(MF, Root, TII.get(Opc), ResultReg).addReg(SrcReg0, getKillRegState(Src0IsKill), 0).addReg(SrcReg1, getKillRegState(Src1IsKill), 0).addReg(SrcReg2, getKillRegState(Src2IsKill), 0);
    InsInstrs.push(MIB.operator llvm::MachineInstr *());
    return MAD;
}

fn genIndexedMultiply(Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, IdxDupOp: u32, MulOpc: u32, RC: *TargetRegisterClass, MRI: *mut MachineRegisterInfo) -> *mut MachineInstr {
    assert!(((IdxDupOp == 1) || (IdxDupOp == 2)), "Invalid index of FMUL operand");
    let mut MF: *mut MachineFunction = *Root.getMF();
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    let mut Dup: *mut MachineInstr = MF.getRegInfo().getUniqueVRegDef(Root.getOperand(IdxDupOp).getReg());
    if Dup.getOpcode() == COPY {
        Dup = MRI.getUniqueVRegDef(Dup.getOperand(1).getReg());
    }
    let mut DupSrcReg: Register = Dup.getOperand(1).getReg();
    MRI.clearKillFlags(DupSrcReg);
    MRI.constrainRegClass(DupSrcReg, RC, 0);
    let mut DupSrcLane: u32 = Dup.getOperand(2).getImm();
    let mut IdxMulOp: u32 = if IdxDupOp == 1 { 2 } else { 1 };
    let mut MulOp: *mut MachineOperand = Root.getOperand(IdxMulOp);
    let mut ResultReg: Register = Root.getOperand(0).getReg();
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    MIB = BuildMI(MF, Root, TII.get(MulOpc), ResultReg).add(MulOp).addReg(DupSrcReg, RegState {}, 0).addImm(DupSrcLane);
    InsInstrs.push(MIB.operator llvm::MachineInstr *());
    return &mut Root;
}

fn genFusedMultiplyAcc(MF: *mut MachineFunction, MRI: *mut MachineRegisterInfo, TII: *TargetInstrInfo, Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, IdxMulOpd: u32, MaddOpc: u32, RC: *TargetRegisterClass) -> *mut MachineInstr {
    return genFusedMultiply(MF, MRI, TII, Root, InsInstrs, IdxMulOpd, MaddOpc, RC, Accumulator, null);
}

fn genNeg(MF: *mut MachineFunction, MRI: *mut MachineRegisterInfo, TII: *TargetInstrInfo, Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, InstrIdxForVirtReg: *mut DenseMap<Register, unsigned int>, MnegOpc: u32, RC: *TargetRegisterClass) -> Register {
    let mut NewVR: Register = MRI.createVirtualRegister(RC, "");
    let mut MIB: MachineInstrBuilder = BuildMI(MF, Root, TII.get(MnegOpc), NewVR).add(Root.getOperand(2));
    InsInstrs.push(MIB.operator llvm::MachineInstr *());
    assert!(InstrIdxForVirtReg.is_empty();
    InstrIdxForVirtReg.insert(make_pair(NewVR, 0));
    return NewVR;
}

fn genFusedMultiplyAccNeg(MF: *mut MachineFunction, MRI: *mut MachineRegisterInfo, TII: *TargetInstrInfo, Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, InstrIdxForVirtReg: *mut DenseMap<Register, unsigned int>, IdxMulOpd: u32, MaddOpc: u32, MnegOpc: u32, RC: *TargetRegisterClass) -> *mut MachineInstr {
    assert!(IdxMulOpd == 1);
    let mut NewVR: Register = genNeg(MF, MRI, TII, Root, InsInstrs, InstrIdxForVirtReg, MnegOpc, RC);
    return genFusedMultiply(MF, MRI, TII, Root, InsInstrs, IdxMulOpd, MaddOpc, RC, Accumulator, &mut NewVR);
}

fn genFusedMultiplyIdx(MF: *mut MachineFunction, MRI: *mut MachineRegisterInfo, TII: *TargetInstrInfo, Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, IdxMulOpd: u32, MaddOpc: u32, RC: *TargetRegisterClass) -> *mut MachineInstr {
    return genFusedMultiply(MF, MRI, TII, Root, InsInstrs, IdxMulOpd, MaddOpc, RC, Indexed, null);
}

fn genFusedMultiplyIdxNeg(MF: *mut MachineFunction, MRI: *mut MachineRegisterInfo, TII: *TargetInstrInfo, Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, InstrIdxForVirtReg: *mut DenseMap<Register, unsigned int>, IdxMulOpd: u32, MaddOpc: u32, MnegOpc: u32, RC: *TargetRegisterClass) -> *mut MachineInstr {
    assert!(IdxMulOpd == 1);
    let mut NewVR: Register = genNeg(MF, MRI, TII, Root, InsInstrs, InstrIdxForVirtReg, MnegOpc, RC);
    return genFusedMultiply(MF, MRI, TII, Root, InsInstrs, IdxMulOpd, MaddOpc, RC, Indexed, &mut NewVR);
}

fn genMaddR(MF: *mut MachineFunction, MRI: *mut MachineRegisterInfo, TII: *TargetInstrInfo, Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, IdxMulOpd: u32, MaddOpc: u32, VR: u32, RC: *TargetRegisterClass) -> *mut MachineInstr {
    assert!(IdxMulOpd == 1 || IdxMulOpd == 2);
    let mut MUL: *mut MachineInstr = MRI.getUniqueVRegDef(Root.getOperand(IdxMulOpd).getReg());
    let mut ResultReg: Register = Root.getOperand(0).getReg();
    let mut SrcReg0: Register = MUL.getOperand(1).getReg();
    let mut Src0IsKill: bool = MUL.getOperand(1).isKill();
    let mut SrcReg1: Register = MUL.getOperand(2).getReg();
    let mut Src1IsKill: bool = MUL.getOperand(2).isKill();
    if ResultReg.isVirtual() {
        MRI.constrainRegClass(ResultReg, RC, 0);
    }
    if SrcReg0.isVirtual() {
        MRI.constrainRegClass(SrcReg0, RC, 0);
    }
    if SrcReg1.isVirtual() {
        MRI.constrainRegClass(SrcReg1, RC, 0);
    }
    if isVirtualRegister(VR) {
        MRI.constrainRegClass(VR, RC, 0);
    }
    let mut MIB: MachineInstrBuilder = BuildMI(MF, Root, TII.get(MaddOpc), ResultReg).addReg(SrcReg0, getKillRegState(Src0IsKill), 0).addReg(SrcReg1, getKillRegState(Src1IsKill), 0).addReg(VR, RegState {}, 0);
    InsInstrs.push(MIB.operator llvm::MachineInstr *());
    return MUL;
}

fn genSubAdd2SubSub(MF: *mut MachineFunction, MRI: *mut MachineRegisterInfo, TII: *TargetInstrInfo, Root: *mut MachineInstr, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, DelInstrs: *mut SmallVectorImpl<MachineInstr *>, IdxOpd1: u32, InstrIdxForVirtReg: *mut DenseMap<Register, unsigned int>) {
    assert!(IdxOpd1 == 1 || IdxOpd1 == 2);
    let mut IdxOtherOpd: u32 = if IdxOpd1 == 1 { 2 } else { 1 };
    let mut AddMI: *mut MachineInstr = MRI.getUniqueVRegDef(Root.getOperand(2).getReg());
    let mut ResultReg: Register = Root.getOperand(0).getReg();
    let mut RegA: Register = Root.getOperand(1).getReg();
    let mut RegAIsKill: bool = Root.getOperand(1).isKill();
    let mut RegB: Register = AddMI.getOperand(IdxOpd1).getReg();
    let mut RegBIsKill: bool = AddMI.getOperand(IdxOpd1).isKill();
    let mut RegC: Register = AddMI.getOperand(IdxOtherOpd).getReg();
    let mut RegCIsKill: bool = AddMI.getOperand(IdxOtherOpd).isKill();
    let mut NewVR: Register = MRI.createVirtualRegister(MRI.getRegClass(Root.getOperand(2).getReg()), "");
    let mut Opcode: u32 = Root.getOpcode();
    if Opcode == SUBSWrr {
        Opcode = SUBWrr;
    } else if Opcode == SUBSXrr {
        Opcode = SUBXrr;
    } else {
        assert!((Opcode == SUBWrr || Opcode == SUBXrr), "Unexpected instruction opcode.");
    }
    let mut Flags: u32 = Root.mergeFlagsWith(*AddMI);
    Flags &= ~NoSWrap;
    Flags &= ~NoUWrap;
    let mut MIB1: MachineInstrBuilder = BuildMI(MF, Root, TII.get(Opcode), NewVR).addReg(RegA, getKillRegState(RegAIsKill), 0).addReg(RegB, getKillRegState(RegBIsKill), 0).setMIFlags(Flags);
    let mut MIB2: MachineInstrBuilder = BuildMI(MF, Root, TII.get(Opcode), ResultReg).addReg(NewVR, getKillRegState(true), 0).addReg(RegC, getKillRegState(RegCIsKill), 0).setMIFlags(Flags);
    InstrIdxForVirtReg.insert(make_pair(NewVR, 0));
    InsInstrs.push(MIB1.operator llvm::MachineInstr *());
    InsInstrs.push(MIB2.operator llvm::MachineInstr *());
    DelInstrs.push(AddMI);
    DelInstrs.push(&mut Root);
}

fn AArch64InstrInfo::getReduceOpcodeForAccumulator(self: *AArch64InstrInfo, AccumulatorOpCode: u32) -> u32 {
    match AccumulatorOpCode {
        UABALB_ZZZ_D => {
            SABALB_ZZZ_D;
        },
        UABALB_ZZZ_H => {
            SABALB_ZZZ_H;
        },
        UABALB_ZZZ_S => {
            SABALB_ZZZ_S;
        },
        UABALv16i8_v8i16 => {
            SABALv8i8_v8i16;
        },
        SABALv2i32_v2i64 => {
            UABALv2i32_v2i64;
        },
        UABALv4i16_v4i32 => {
            SABALv4i16_v4i32;
        },
        UABALv4i32_v2i64 => {
            return ADDv2i64;
        },
        UABALv8i16_v4i32 => {
            return ADDv4i32;
        },
        UABALv8i8_v8i16 => {
            SABALv16i8_v8i16;
        },
        UABAv16i8 => {
            SABAv16i8;
        },
        UABAv4i16 => {
            SABAv4i16;
        },
        UABAv2i32 => {
            SABAv2i32;
        },
        UABAv8i8 => {
            SABAv8i8;
        },
        _ => {
            llvm_unreachable_internal("Unknown accumulator opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 9194);
        },
    }
}

fn AArch64InstrInfo::genAlternativeCodeSequence(self: *AArch64InstrInfo, Root: *mut MachineInstr, Pattern: u32, InsInstrs: *mut SmallVectorImpl<MachineInstr *>, DelInstrs: *mut SmallVectorImpl<MachineInstr *>, InstrIdxForVirtReg: *mut DenseMap<Register, unsigned int>) {
    let mut MBB: *mut MachineBasicBlock = *Root.getParent();
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    let mut MUL: *mut MachineInstr = null;
    let mut RC: *TargetRegisterClass = null;
    let mut Opc: u32 = 0;
    match Pattern {
        _ => {
            self.genAlternativeCodeSequence(Root, Pattern, InsInstrs, DelInstrs, InstrIdxForVirtReg);
        },
        SUBADD_OP1 => {
            genSubAdd2SubSub(MF, MRI, TII, Root, InsInstrs, DelInstrs, 1, InstrIdxForVirtReg);
        },
        SUBADD_OP2 => {
            genSubAdd2SubSub(MF, MRI, TII, Root, InsInstrs, DelInstrs, 2, InstrIdxForVirtReg);
        },
        MULADDW_OP1 => {
            MULADDX_OP1;
        },
        MULADDW_OP2 => {
            MULADDX_OP2;
        },
        MULADDWI_OP1 => {
            MULADDXI_OP1;
        },
        MULSUBW_OP1 => {
            MULSUBX_OP1;
        },
        MULSUBW_OP2 => {
            MULSUBX_OP2;
        },
        MULADDv8i8_OP1 => {
            Opc = MLAv8i8;
        },
        MULADDv8i8_OP2 => {
            Opc = MLAv8i8;
        },
        MULADDv16i8_OP1 => {
            Opc = MLAv16i8;
        },
        MULADDv16i8_OP2 => {
            Opc = MLAv16i8;
        },
        MULADDv4i16_OP1 => {
            Opc = MLAv4i16;
        },
        MULADDv4i16_OP2 => {
            Opc = MLAv4i16;
        },
        MULADDv8i16_OP1 => {
