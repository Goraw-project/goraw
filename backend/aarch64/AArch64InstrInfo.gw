struct Closure_37 {
    RangeLen: *mut u32,
    Ranges: *mut iterator>>,
    RangeBegin: *mut instr_iterator,
    RangeEnd: *mut instr_iterator,
}

unsafe fn Closure_37::call(self: *mut Closure_37) {
        if (*self.RangeLen) <= 1 {
            return;
        }
        if !(*self.RangeBegin).isEnd() && operator((*self.RangeBegin)).isBundledWithPred() {
            return;
        }
        if !(*self.RangeEnd).isEnd() && operator((*self.RangeEnd)).isBundledWithPred() {
            return;
        }
        (*self.Ranges).push((*self.RangeBegin), (*self.RangeEnd));
    }

