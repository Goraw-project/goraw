fn AArch64InstrInfo::isCandidateToMergeOrPair(self: *AArch64InstrInfo, MI: *MachineInstr) -> bool {
    let mut IsPreLdSt: bool = isPreLdSt(MI);
    if MI.hasOrderedMemoryRef() {
        return false;
    }
    assert!((MI.getOperand(if IsPreLdSt { 2 } else { 1 }).isReg() || MI.getOperand(if IsPreLdSt { 2 } else { 1 }).isFI()), "Expected a reg or frame index operand.");
    let mut IsImmPreLdSt: bool = IsPreLdSt && MI.getOperand(3).isImm();
    if !MI.getOperand(2).isImm() && !IsImmPreLdSt {
        return false;
    }
    if MI.getOperand(1).isReg() && !IsPreLdSt {
        let mut BaseReg: Register = MI.getOperand(1).getReg();
        let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
        if MI.modifiesRegister(BaseReg, TRI) {
            return false;
        }
    }
    match MI.getOpcode() {
        _ => {
            break;
        },
    }
    if isLdStPairSuppressed(MI) {
        return false;
    }
    let mut MAI: *MCAsmInfo = MI.getMF().getTarget().getMCAsmInfo();
    let mut NeedsWinCFI: bool = MAI.usesWindowsCFI() && MI.getMF().getFunction().needsUnwindTableEntry();
    if NeedsWinCFI && (MI.getFlag(FrameSetup) || MI.getFlag(FrameDestroy)) {
        return false;
    }
    if self.Subtarget() {
        match MI.getOpcode() {
            _ => {
                break;
            },
        }
    }
    return true;
}

