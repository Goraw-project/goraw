            parseCondBranch(LastInst, TBB, Cond);
            return false;
        }
        return true;
    }
    let mut SecondLastInst: *mut MachineInstr = operator&(operator*());
    let mut SecondLastOpc: u32 = SecondLastInst.getOpcode();
    if AllowModify && isUncondBranchOpcode(LastOpc) {
        while isUncondBranchOpcode(SecondLastOpc) {
            LastInst()();
            LastInst = SecondLastInst;
            LastOpc = LastInst.getOpcode();
            if I() == MBB()() || operator!(isUnpredicatedTerminator(operator*( -= 1))) {
                TBB = LastInst.getOperand(0).getMBB();
                return false;
            }
            SecondLastInst = operator&(operator*());
            SecondLastOpc = SecondLastInst.getOpcode();
        }
    }
    if AllowModify && isUncondBranchOpcode(LastOpc) && MBB.isLayoutSuccessor(self.getBranchDestBlock(*LastInst)) {
        LastInst()();
        LastInst = SecondLastInst;
        LastOpc = LastInst.getOpcode();
        if I() == MBB()() || operator!(isUnpredicatedTerminator(operator*( -= 1))) {
            assert!(!isUncondBranchOpcode(LastOpc), "unreachable unconditional branches removed above");
            if isCondBranchOpcode(LastOpc) {
                parseCondBranch(LastInst, TBB, Cond);
                return false;
            }
            return true;
        }
        SecondLastInst = operator&(operator*());
        SecondLastOpc = SecondLastInst.getOpcode();
    }
    if SecondLastInst &&  != MBB()() && isUnpredicatedTerminator(operator*( -= 1)) {
        return true;
    }
    if isCondBranchOpcode(SecondLastOpc) && isUncondBranchOpcode(LastOpc) {
        parseCondBranch(SecondLastInst, TBB, Cond);
        FBB = LastInst.getOperand(0).getMBB();
        return false;
    }
    if isUncondBranchOpcode(SecondLastOpc) && isUncondBranchOpcode(LastOpc) {
        TBB = SecondLastInst.getOperand(0).getMBB();
        I() = LastInst;
        if AllowModify {
            I()();
        }
        return false;
    }
    if isIndirectBranchOpcode(SecondLastOpc) && isUncondBranchOpcode(LastOpc) {
        I() = LastInst;
        if AllowModify {
            I()();
        }
        return true;
    }
    return true;
}

