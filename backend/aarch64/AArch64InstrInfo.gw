    RI: *mut AArch64RegisterInfo,
}

unsafe fn Closure_2::call(self: *mut Closure_2, Reg: Register) -> auto {
        if Reg.isVirtual() {
            return (*self.MRI).getRegClass(Reg);
        }
        if Reg.isPhysical() {
            return (*self.RI)()(Reg);
        }
        return null;
    }

