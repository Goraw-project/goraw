        } else {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVDr), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0);
            if self.Subtarget.hasZeroCycleRegMoveFPR64() {
                operator(NumZCRegMoveInstrsFPR);
