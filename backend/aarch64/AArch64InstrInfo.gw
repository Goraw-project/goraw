    let mut SrcEncoding: u16 = TRI.getEncodingValue;
    let mut NumRegs: u32 = ();
    let mut DestSubReg: MCRegister = TRI.getSubReg(DestReg, [0]);
    let mut MaxRegs: u32 = 0;
    let mut SubReg: i32 = 0;
    let mut End: i32 = NumRegs;
    let mut Incr: i32 = 1;
    if ((DestEncoding - SrcEncoding) & MaxRegs) < NumRegs {
        SubReg = NumRegs - 1;
        End = -1;
        Incr = -1;
    }
    for ; SubReg != End; SubReg += Incr {
        DestSubReg = TRI.getSubReg(DestReg, [SubReg]);
        let mut SrcSubReg: MCRegister = TRI.getSubReg(SrcReg, [SubReg]);
    }
}

fn AArch64InstrInfo::copyGPRRegTuple(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, I: i32, DL: *DebugLoc, DestReg: MCRegister, SrcReg: MCRegister, KillSrc: bool, Opcode: u32, ZeroReg: u32, Indices: ArrayRef<unsigned int>) {
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    let mut NumRegs: u32 = ();
    let mut DestEncoding: u16 = TRI.getEncodingValue;
    let mut SrcEncoding: u16 = TRI.getEncodingValue;
    assert!(DestEncoding % NumRegs == 0 && SrcEncoding % NumRegs == 0, "GPR reg sequences should not be able to overlap");
