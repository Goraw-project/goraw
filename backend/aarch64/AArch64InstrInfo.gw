struct Closure_30 {
    cap_0: *AArch64InstrInfo,
    TRI: *mut TargetRegisterInfo,
}

unsafe fn Closure_30::call(self: *mut Closure_30, MI: *mut MachineInstr) -> bool {
        if MI.isCall(AnyInBundle) {
            return true;
        }
        if !MI.modifiesRegister(SP, &mut (*self.TRI)) && !MI.readsRegister(SP, &mut (*self.TRI)) {
            return true;
        }
        if MI.modifiesRegister(SP, &mut (*self.TRI)) {
            return false;
        }
        if MI.mayLoadOrStore(AnyInBundle) {
            let mut Base: *MachineOperand = null;
            let mut Offset: i64 = 0;
            let mut OffsetIsScalable: bool = false;
            if !self.getMemOperandWithOffset(MI, Base, Offset, OffsetIsScalable, &mut (*self.TRI)) || !Base.isReg() || Base.getReg() != SP {
                return false;
            }
            if OffsetIsScalable {
                return false;
            }
            let mut MinOffset: i64 = 0;
            let mut MaxOffset: i64 = 0;
            let mut Scale: TypeSize = TypeSize { 0, false };
            let mut DummyWidth: TypeSize = TypeSize { 0, false };
            getMemOpInfo(MI.getOpcode(), Scale, DummyWidth, MinOffset, MaxOffset);
            Offset += 16;
            if Offset < MinOffset * Scale.getFixedValue() as i64 || Offset > MaxOffset * Scale.getFixedValue() as i64 {
                return false;
            }
            return true;
        }
        return false;
    }

