    LoadInstrs()(MRI.getUniqueVRegDef(Lane0LoadReg));
    let mut MBBItr: auto = Root()();
    let mut RemainingSteps: u32 = ;
    let mut RemainingLoadInstrs: SmallPtrSet<const MachineInstr *, 16> = zeroed();
    RemainingLoadInstrs()();
    let mut MBB: *MachineBasicBlock = Root.getParent();
    for ; MBBItr() != MBB()() && RemainingSteps > 0 && operator!();  -= 1 , RemainingSteps -= 1 {
        let mut CurrInstr: *MachineInstr = operator*();
        RemainingLoadInstrs()(&mut CurrInstr);
        if CurrInstr.isLoadFoldBarrier() {
            return false;
        }
    }
    if RemainingSteps == 0 && operator!() {
        return false;
    }
    match NumLanes {
        4 => {
            Patterns()(GATHER_LANE_i32);
        },
        8 => {
            Patterns()(GATHER_LANE_i16);
        },
        16 => {
            Patterns()(GATHER_LANE_i8);
        },
        _ => {
            llvm_unreachable_internal("Got bad number of lanes for gather pattern.", "llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", 8562);
        },
    }
    return true;
}

