        3 => {
            let mut Is64Bit: bool = false;
            match Cond()[1]() {
                _ => {
                    llvm_unreachable_internal("Unknown branch opcode in Cond", "llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", 904);
                },
            }
            let mut SrcReg: Register = [2]();
            if Is64Bit {
                MRI.constrainRegClass;
                BuildMI(MBB, DL, get())(SrcReg)(0)(0);
            } else {
                MRI.constrainRegClass;
                BuildMI(MBB, DL, get())(SrcReg)(0)(0);
            }
        },
        4 => {
            match Cond()[1]() {
                _ => {
                    llvm_unreachable_internal("Unknown branch opcode in Cond", "llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", 942);
                },
            }
            if  {
                BuildMI(MBB, DL, get())([2]())(encodeLogicalImmediate(1 << [3](), 32));
            } else {
                BuildMI(MBB, DL, get())([2]())(encodeLogicalImmediate(1 << [3](), 64));
            }
        },
        5 => {
            let mut SubsOpc: u32 = 0;
            let mut SubsDestReg: u32 = 0;
            let mut IsImm: bool = false;
            CC = [2]() as CondCode;
            match Cond()[1]() {
                _ => {
                    llvm_unreachable_internal("Unknown branch opcode in Cond", "llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", 973);
                },
            }
            if IsImm {
                MRI.constrainRegClass([3](), getRegClass(get(SubsOpc), 1));
                BuildMI(MBB, DL, get(SubsOpc), SubsDestReg)([3]())([4]())(0);
            } else {
                MRI.constrainRegClass([3](), getRegClass(get(SubsOpc), 1));
                MRI.constrainRegClass([4](), getRegClass(get(SubsOpc), 2));
                BuildMI(MBB, DL, get(SubsOpc), SubsDestReg)([3]())([4]());
            }
        },
        7 => {
            let mut Reg: Register = [3]();
            if Cond()[5]() != InvalidShiftExtend {
                let mut ExtOpc: u32 = 0;
                let mut ExtBits: u32 = 0;
                let mut ExtendType: ShiftExtendType = getExtendType([5]());
                (((operator!(operator!((isValidCBExtend([1](), ExtendType) && "Unexpected compare-and-branch instruction for extend type")))) || (_wassert(L"isValidCBExtend(Cond[1].getImm(), ExtendType) && \"Unexpected compare-and-branch instruction for extend type\"", L"llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", (1025) as u32) , 0)) as void);
                match ExtendType {
                    _ => {
                        llvm_unreachable_internal("Unknown shift-extend for CB instruction", "llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", 1028);
                    },
                    SXTB => {
                        
                    },
                    SXTH => {
                        
                    },
                    UXTB => {
                        
                    },
                    UXTH => {
                        
                    },
                }
                Reg = MRI;
                let mut MBBI: MachineInstrBuilder = BuildMI(MBB, DL, get(ExtOpc), Reg)([3]());
                if  {
                    MBBI()(0);
                }
                MBBI()(ExtBits);
            }
            if Cond()[6]() != InvalidShiftExtend {
                MRI.constrainRegClass;
                let mut ExtendType: ShiftExtendType = getExtendType([6]());
                (((operator!(operator!((isValidCBExtend([1](), ExtendType) && "Unexpected compare-and-branch instruction for extend type")))) || (_wassert(L"isValidCBExtend(Cond[1].getImm(), ExtendType) && \"Unexpected compare-and-branch instruction for extend type\"", L"llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", (1062) as u32) , 0)) as void);
                BuildMI(MBB, DL, get())(Reg)([4]())(getArithExtendImm(ExtendType, 0));
            } else {
                BuildMI(MBB, DL, get())(Reg)([4]());
            }
            CC = [2]() as CondCode;
        },
    }
    return CC;
}

