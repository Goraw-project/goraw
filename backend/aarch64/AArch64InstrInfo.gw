        MRI.constrainRegClass;
        let mut OffsetReg: Register = AM.ScaledReg;
        let mut RC: *TargetRegisterClass = MRI.getRegClass(OffsetReg);
        if RC.hasSuperClassEq {
            OffsetReg = MRI;
            BuildMI(MBB, MemI, DL, get(COPY), OffsetReg);
        }
        let mut B: auto = BuildMI(MBB, MemI, DL, get(Opcode))(MemI.getOperand(0).getReg(), getDefRegState(MemI.mayLoad(AnyInBundle)))(AM.BaseReg)(OffsetReg)(AM.Form == SExtScaledReg)(AM.Scale != 1)(MemI()())(MemI.getFlags());
