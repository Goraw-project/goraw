fn AArch64InstrInfo::emitLdStWithAddr(self: *AArch64InstrInfo, MemI: *mut MachineInstr, AM: *ExtAddrMode) -> *mut MachineInstr {
    let mut DL: *DebugLoc = MemI.getDebugLoc();
    let mut MBB: *mut MachineBasicBlock = *MemI.getParent();
    let mut MRI: *mut MachineRegisterInfo = MemI.getMF().getRegInfo();
    if AM.Form == Basic {
        if AM.ScaledReg.operator unsigned int() {
            let mut Opcode: u32 = regOffsetOpcode(MemI.getOpcode());
            MRI.constrainRegClass(AM.BaseReg, &mut GPR64spRegClass, 0);
            let mut B: MachineInstrBuilder = BuildMI(MBB, MemI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opcode)).addReg(MemI.getOperand(0).getReg(), getDefRegState(MemI.mayLoad(AnyInBundle)), 0).addReg(AM.BaseReg, RegState {}, 0).addReg(AM.ScaledReg, RegState {}, 0).addImm(0).addImm(AM.Scale > 1).setMemRefs(MemI.memoperands()).setMIFlags(MemI.getFlags());
            return B.getInstr();
        }
        assert!(AM.ScaledReg == 0 && AM.Scale == 0, "Addressing mode not supported for folding");
        let mut Scale: u32 = 1;
        let mut Opcode: u32 = MemI.getOpcode();
        if isInt(AM.Displacement) {
            Opcode = unscaledOffsetOpcode(Opcode);
        } else {
            Opcode = scaledOffsetOpcode(Opcode, Scale);
        }
        let mut B: MachineInstrBuilder = BuildMI(MBB, MemI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opcode)).addReg(MemI.getOperand(0).getReg(), getDefRegState(MemI.mayLoad(AnyInBundle)), 0).addReg(AM.BaseReg, RegState {}, 0).addImm(AM.Displacement / Scale).setMemRefs(MemI.memoperands()).setMIFlags(MemI.getFlags());
        return B.getInstr();
    }
    if AM.Form == SExtScaledReg || AM.Form == ZExtScaledReg {
        assert!(AM.ScaledReg.operator unsigned int() && !AM.Displacement, "Address offset can be a register or an immediate, but not both");
        let mut Opcode: u32 = offsetExtendOpcode(MemI.getOpcode());
        MRI.constrainRegClass(AM.BaseReg, &mut GPR64spRegClass, 0);
        let mut OffsetReg: Register = AM.ScaledReg;
        let mut RC: *TargetRegisterClass = MRI.getRegClass(OffsetReg);
        if RC.hasSuperClassEq(&mut GPR64RegClass) {
            OffsetReg = MRI.createVirtualRegister(&mut GPR32RegClass, "");
            BuildMI(MBB, MemI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(COPY), OffsetReg).addReg(AM.ScaledReg, RegState {}, sub_32);
        }
        let mut B: MachineInstrBuilder = BuildMI(MBB, MemI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opcode)).addReg(MemI.getOperand(0).getReg(), getDefRegState(MemI.mayLoad(AnyInBundle)), 0).addReg(AM.BaseReg, RegState {}, 0).addReg(OffsetReg, RegState {}, 0).addImm(AM.Form == SExtScaledReg).addImm(AM.Scale != 1).setMemRefs(MemI.memoperands()).setMIFlags(MemI.getFlags());
        return B.getInstr();
    }
    llvm_unreachable_internal("Function must not be called with an addressing mode it can't handle", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 4473);
}

fn isPostIndexLdStOpcode(Opcode: u32) -> bool {
    match Opcode {
        _ => {
            return false;
