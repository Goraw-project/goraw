    }
    if PPR2RegClass.contains(DestReg.operator MCRegister()) && PPR2RegClass.contains(SrcReg.operator MCRegister()) {
        assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected SVE predicate register.");
