struct Closure_6 {}

fn Closure_6::call(self: *mut Closure_6, NumBytes: u32, OldOffset: i64, NewOffset: i64) -> auto {
        let mut MinOffset: i64 = 0;
        let mut MaxOffset: i64 = 0;
        match NumBytes {
            _ => {
                return true;
            },
            4 => {
                MinOffset = -256;
            },
            8 => {
                MinOffset = -512;
            },
            16 => {
                MinOffset = -1024;
            },
        }
        return OldOffset < MinOffset || OldOffset > MaxOffset || (NewOffset >= MinOffset && NewOffset <= MaxOffset);
    }

struct Closure_7 {
    MemI: *mut MachineInstr,
    OffsetScale: *mut i64,
    cap_2: *AArch64InstrInfo,
    NumBytes: *mut u32,
    validateOffsetForLDP: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\AArch64\AArch64InstrInfo.cpp:3908:31),
    AM: *mut ExtAddrMode,
    AddrI: *mut MachineInstr,
}

unsafe fn Closure_7::call(self: *mut Closure_7, Disp: i64) -> auto {
        let mut OldOffset: i64 = (*self.MemI).getOperand(2).getImm() * (*self.OffsetScale);
        let mut NewOffset: i64 = OldOffset + Disp;
        if !self.isLegalAddressingMode((*self.NumBytes), NewOffset, 0) {
            return false;
        }
        if !(*self.validateOffsetForLDP).call((*self.NumBytes), OldOffset, NewOffset) {
            return false;
        }
        (*self.AM).BaseReg = (*self.AddrI).getOperand(1).getReg();
        (*self.AM).ScaledReg = 0;
        (*self.AM).Scale = 0;
        (*self.AM).Displacement = NewOffset;
        (*self.AM).Form = Basic;
        return true;
    }

struct Closure_8 {
    MemI: *mut MachineInstr,
    cap_1: *AArch64InstrInfo,
    NumBytes: *mut u32,
    AM: *mut ExtAddrMode,
    AddrI: *mut MachineInstr,
}

unsafe fn Closure_8::call(self: *mut Closure_8, Scale: i64, Form: Formula) -> auto {
        if (*self.MemI).getOperand(2).getImm() != 0 {
            return false;
        }
        if Scale as u32 != Scale {
            return false;
        }
        if !self.isLegalAddressingMode((*self.NumBytes), 0, Scale) {
            return false;
        }
        (*self.AM).BaseReg = (*self.AddrI).getOperand(1).getReg();
        (*self.AM).ScaledReg = (*self.AddrI).getOperand(2).getReg();
        (*self.AM).Scale = Scale;
        (*self.AM).Displacement = 0;
        (*self.AM).Form = Form;
        return true;
    }

