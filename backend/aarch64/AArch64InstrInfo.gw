unsafe fn Closure_27::call(self: *mut Closure_27, C: *mut Candidate) -> bool {
            let mut SPValue: i32 = 0;
            for MI in C {
                if MI.modifiesRegister(SP, &mut (*self.TRI)) {
                    match MI.getOpcode() {
                        ADDXri => {
                            ADDWri;
                        },
                        SUBXri => {
                            SUBWri;
                        },
                        _ => {
                            return true;
                        },
                    }
                }
            }
            if SPValue {
                return true;
            }
            return false;
        }

