fn removeCopies(MRI: *MachineRegisterInfo, VReg: u32) -> u32 {
    while isVirtualRegister(VReg) {
        let mut DefMI: *MachineInstr = MRI.getVRegDef(VReg);
        if !DefMI || !DefMI.isFullCopy() {
            return VReg;
        }
        VReg = DefMI.getOperand(1).getReg().operator unsigned int();
    }
    return VReg;
}

fn canFoldIntoCSel(MRI: *MachineRegisterInfo, VReg: u32, NewReg: *mut u32) -> u32 {
    VReg = removeCopies(MRI, VReg);
    if !isVirtualRegister(VReg) {
        return 0;
    }
    let mut Is64Bit: bool = false;
    let mut DefMI: *MachineInstr = MRI.getVRegDef(VReg);
    if !DefMI {
        return 0;
    }
    let mut Opc: u32 = 0;
    let mut SrcReg: u32 = 0;
    match DefMI.getOpcode() {
        _ => {
            return 0;
        },
    }
    assert!(Opc && SrcReg, "Missing parameters");
    if NewReg {
        *NewReg = SrcReg;
    }
    return Opc;
}

fn AArch64InstrInfo::canInsertSelect(self: *AArch64InstrInfo, MBB: *MachineBasicBlock, Cond: ArrayRef<MachineOperand>, DstReg: Register, TrueReg: Register, FalseReg: Register, CondCycles: *mut i32, TrueCycles: *mut i32, FalseCycles: *mut i32) -> bool {
    let mut MRI: *MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut RC: *TargetRegisterClass = self.RI(MRI.getRegClass(TrueReg), MRI.getRegClass(FalseReg));
    if !RC {
        return false;
    }
    if operator!(self.RI(RC, MRI.getRegClass(DstReg))) {
        return false;
    }
    let mut ExtraCondLat: u32 = () != 1;
    if  {
        CondCycles = 1 + ExtraCondLat;
        TrueCycles = FalseCycles = 1;
        if canFoldIntoCSel(MRI, TrueReg.operator unsigned int(), null) {
            TrueCycles = 0;
        } else if canFoldIntoCSel(MRI, FalseReg.operator unsigned int(), null) {
            FalseCycles = 0;
        }
        return true;
    }
    if  {
        CondCycles = 5 + ExtraCondLat;
        TrueCycles = FalseCycles = 2;
        return true;
    }
    if  {
        CondCycles = 8 + ExtraCondLat;
        TrueCycles = FalseCycles = 2;
        return true;
    }
    return false;
}

fn AArch64InstrInfo::insertSelect(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, I: i32, DL: *DebugLoc, DstReg: Register, Cond: ArrayRef<MachineOperand>, TrueReg: Register, FalseReg: Register) {
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut CC: CondCode = zeroed();
    if MRI.constrainRegClass {
        assert!(self.Subtarget.isNeonAvailable(), "Expected NEON for a vector select");
        MRI.constrainRegClass;
        MRI.constrainRegClass;
        let mut CondSet: Register = MRI;
        BuildMI(MBB, DL, get(), CondSet)(getInvertedCondCode(CC));
        let mut Mask: Register = MRI;
        BuildMI(MBB, DL, get(), Mask)(CondSet);
        BuildMI(MBB, DL, get(), DstReg)(Mask)(TrueReg)(FalseReg);
        return;
    }
    let mut Opc: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    let mut TryFold: bool = false;
    if MRI.constrainRegClass {
        TryFold = true;
    } else if MRI.constrainRegClass {
        TryFold = true;
    } else if MRI.constrainRegClass {} else if MRI.constrainRegClass {}
    assert!(RC, "Unsupported regclass");
    if TryFold {
        let mut NewReg: u32 = 0;
        let mut FoldedOpc: u32 = canFoldIntoCSel(MRI, TrueReg.operator unsigned int(), &mut NewReg);
        if FoldedOpc {
            CC = getInvertedCondCode(CC);
            TrueReg = FalseReg;
        } else {
            FoldedOpc = canFoldIntoCSel(MRI, FalseReg.operator unsigned int(), &mut NewReg);
        }
        if FoldedOpc {
            FalseReg = NewReg;
            Opc = FoldedOpc;
            MRI.clearKillFlags(NewReg);
        }
    }
    MRI.constrainRegClass(TrueReg, RC, 0);
    if FalseReg.isVirtual() {
        MRI.constrainRegClass(FalseReg, RC, 0);
    }
    BuildMI(MBB, DL, get(Opc), DstReg)(TrueReg)(FalseReg)(CC);
}

fn isCheapImmediate(MI: *MachineInstr, BitSize: u32) -> bool {
    if BitSize == 32 {
        return true;
    }
    assert!(BitSize == 64, "Only bit sizes of 32 or 64 allowed");
    let mut Imm: u64 = MI.getOperand(1).getImm() as u64;
    let mut Is: ImmInsnModel, 4> = zeroed();
    expandMOVImm(Imm, BitSize);
    return () <= 2;
}

fn isCheapCopy(MI: *MachineInstr, RI: *AArch64RegisterInfo) -> bool {
    assert!(MI.isCopy(), "Expected COPY instruction");
    let mut MRI: *MachineRegisterInfo = MI.getMF().getRegInfo();
    let mut GetRegClass: Closure_2 = Closure_2 { MRI: &mut MRI, RI: &mut RI };
    let mut DstRC: *TargetRegisterClass = GetRegClass.call(MI.getOperand(0).getReg());
    let mut SrcRC: *TargetRegisterClass = GetRegClass.call(MI.getOperand(1).getReg());
    if DstRC && SrcRC && operator!(RI()(DstRC, SrcRC)) {
        return false;
    }
    return MI.isAsCheapAsAMove(AllInBundle);
}

fn AArch64InstrInfo::isAsCheapAsAMove(self: *AArch64InstrInfo, MI: *MachineInstr) -> bool {
    if self.Subtarget() {
        if isExynosCheapAsMove(MI) {
            return true;
        }
        return MI.isAsCheapAsAMove(AllInBundle);
    }
    match MI.getOpcode() {
        _ => {
            return MI.isAsCheapAsAMove(AllInBundle);
        },
        COPY => {
            return isCheapCopy(MI, self.RI);
        },
    }
}

