        FMULSUBD_OP2 => {
            Opc = FMSUBDrrr;
        },
        FMLSv1i32_indexed_OP2 => {
            Opc = FMLSv1i32_indexed;
        },
        FMLSv1i64_indexed_OP2 => {
            Opc = FMLSv1i64_indexed;
        },
        FMLSv4f16_OP1 => {
            FMLSv4i16_indexed_OP1;
        },
        FMLSv4f16_OP2 => {
            RC = &mut FPR64RegClass;
        },
        FMLSv4i16_indexed_OP2 => {
            RC = &mut FPR64RegClass;
        },
        FMLSv2f32_OP2 => {
            FMLSv2i32_indexed_OP2;
        },
        FMLSv8f16_OP1 => {
            FMLSv8i16_indexed_OP1;
        },
        FMLSv8f16_OP2 => {
            RC = &mut FPR128RegClass;
        },
        FMLSv8i16_indexed_OP2 => {
            RC = &mut FPR128RegClass;
        },
        FMLSv2f64_OP2 => {
            FMLSv2i64_indexed_OP2;
        },
        FMLSv4f32_OP2 => {
            FMLSv4i32_indexed_OP2;
        },
        FMLSv2f32_OP1 => {
            FMLSv2i32_indexed_OP1;
        },
        FMLSv4f32_OP1 => {
            FMLSv4i32_indexed_OP1;
        },
        FMLSv2f64_OP1 => {
            FMLSv2i64_indexed_OP1;
        },
        FMULv2i32_indexed_OP1 => {
            FMULv2i32_indexed_OP2;
        },
        FMULv2i64_indexed_OP1 => {
            FMULv2i64_indexed_OP2;
        },
        FMULv4i16_indexed_OP1 => {
            FMULv4i16_indexed_OP2;
        },
        FMULv4i32_indexed_OP1 => {
            FMULv4i32_indexed_OP2;
        },
        FMULv8i16_indexed_OP1 => {
            FMULv8i16_indexed_OP2;
        },
        FNMADD => {
            MUL = genFNegatedMAD(MF, MRI, TII, Root, InsInstrs);
            break;
        },
        GATHER_LANE_i32 => {
            generateGatherLanePattern(Root, InsInstrs, DelInstrs, InstrIdxForVirtReg, Pattern, 4);
            break;
        },
        GATHER_LANE_i16 => {
            generateGatherLanePattern(Root, InsInstrs, DelInstrs, InstrIdxForVirtReg, Pattern, 8);
            break;
        },
        GATHER_LANE_i8 => {
            generateGatherLanePattern(Root, InsInstrs, DelInstrs, InstrIdxForVirtReg, Pattern, 16);
            break;
        },
    }
    if MUL {
        DelInstrs.push(MUL);
    }
    DelInstrs.push(&mut Root);
    let mut Flags: u32 = Root.getFlags();
    if MUL {
        Flags = Root.mergeFlagsWith(*MUL);
    }
    for MI in InsInstrs {
        MI.setFlags(Flags);
    }
}

fn AArch64InstrInfo::optimizeCondBranch(self: *AArch64InstrInfo, MI: *mut MachineInstr) -> bool {
    let mut IsNegativeBranch: bool = false;
    let mut IsTestAndBranch: bool = false;
    let mut TargetBBInMI: u32 = 0;
    match MI.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unknown branch instruction?", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 10125);
        },
        Bcc => {
            CBWPri;
        },
        CBZW => {
            CBZX;
        },
        CBNZW => {
            CBNZX;
        },
        TBZW => {
            TBZX;
        },
        TBNZW => {
            TBNZX;
        },
    }
    if IsTestAndBranch && MI.getOperand(1).getImm() {
        return false;
    }
    assert!(MI.getParent(), "Incomplete machine instruction\n");
    let mut MBB: *mut MachineBasicBlock = MI.getParent();
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut MRI: *mut MachineRegisterInfo = &mut MF.getRegInfo();
    let mut VReg: Register = MI.getOperand(0).getReg();
    if !VReg.isVirtual() {
        return false;
    }
    let mut DefMI: *mut MachineInstr = MRI.getVRegDef(VReg);
    if !DefMI {
        return false;
    }
    while DefMI.isCopy() {
        let mut CopyVReg: Register = DefMI.getOperand(1).getReg();
        if !CopyVReg.isVirtual() {
            return false;
        }
        if !MRI.hasOneNonDBGUse(CopyVReg) {
            return false;
        }
        DefMI = MRI.getVRegDef(CopyVReg);
        if !DefMI {
            return false;
        }
    }
    match DefMI.getOpcode() {
        _ => {
            return false;
        },
        ANDWri => {
            ANDXri;
        },
        CSINCWr => {
            CSINCXr;
        },
    }
}

fn AArch64InstrInfo::decomposeMachineOperandsTargetFlags(self: *AArch64InstrInfo, TF: u32) -> pair<unsigned int, unsigned int> {
    let mut Mask: u32 = MO_FRAGMENT;
    return make_pair(TF & Mask, TF & ~Mask);
}

fn AArch64InstrInfo::getSerializableDirectMachineOperandTargetFlags(self: *AArch64InstrInfo) -> pair<unsigned int, const char *>> {
    let mut TargetFlags: [7]pair<unsigned int, const char *> = [pair<unsigned int, const char *> { MO_PAGE, "aarch64-page" }, pair<unsigned int, const char *> { MO_PAGEOFF, "aarch64-pageoff" }, pair<unsigned int, const char *> { MO_G3, "aarch64-g3" }, pair<unsigned int, const char *> { MO_G2, "aarch64-g2" }, pair<unsigned int, const char *> { MO_G1, "aarch64-g1" }, pair<unsigned int, const char *> { MO_G0, "aarch64-g0" }, pair<unsigned int, const char *> { MO_HI12, "aarch64-hi12" }];
    return TargetFlags;
}

fn AArch64InstrInfo::getSerializableBitmaskMachineOperandTargetFlags(self: *AArch64InstrInfo) -> pair<unsigned int, const char *>> {
    let mut TargetFlags: [9]pair<unsigned int, const char *> = [pair<unsigned int, const char *> { MO_COFFSTUB, "aarch64-coffstub" }, pair<unsigned int, const char *> { MO_GOT, "aarch64-got" }, pair<unsigned int, const char *> { MO_NC, "aarch64-nc" }, pair<unsigned int, const char *> { MO_S, "aarch64-s" }, pair<unsigned int, const char *> { MO_TLS, "aarch64-tls" }, pair<unsigned int, const char *> { MO_DLLIMPORT, "aarch64-dllimport" }, pair<unsigned int, const char *> { MO_PREL, "aarch64-prel" }, pair<unsigned int, const char *> { MO_TAGGED, "aarch64-tagged" }, pair<unsigned int, const char *> { MO_ARM64EC_CALLMANGLE, "aarch64-arm64ec-callmangle" }];
    return TargetFlags;
}

fn AArch64InstrInfo::getSerializableMachineMemOperandTargetFlags(self: *AArch64InstrInfo) -> Flags, const char *>> {
    let mut TargetFlags: [2]Flags, const char *> = [Flags, const char *> { MOSuppressPair, "aarch64-suppress-pair" }, Flags, const char *> { MOStridedAccess, "aarch64-strided-access" }];
    return TargetFlags;
}

enum MachineOutlinerClass {
    MachineOutlinerDefault = 0,
    MachineOutlinerTailCall = 1,
    MachineOutlinerNoLRSave = 2,
    MachineOutlinerThunk = 3,
    MachineOutlinerRegSave = 4,
}

enum MachineOutlinerMBBFlags {
    LRUnavailableSomewhere = 0,
    HasCalls = 1,
    UnsafeRegsDead = 2,
}

fn isCompactUnwindFrameRecordEnabled(MF: *MachineFunction) -> bool {
    return UseCompactUnwindFrameRecordForOutlinedFunctions && MF.getTarget().getTargetTriple().isOSBinFormatMachO();
}

fn shouldUseCompactUnwindFrameRecordForOutlinedFunction(MBB: *MachineBasicBlock) -> bool {
    let mut MF: *MachineFunction = *MBB.getParent();
    if !isCompactUnwindFrameRecordEnabled(MF) || !MF.getInfo().needsDwarfUnwindInfo(MF) {
        return false;
    }
    let mut LRU: LiveRegUnits = *MF.getSubtarget().getRegisterInfo();
    for MI in MBB.instrs() {
        LRU.accumulate(MI);
    }
    return LRU.available(FP);
}

fn predictCompactUnwindFrameRecordForOutlinedFunction(RepeatedSequenceLocs: *mut []Candidate, TRI: *TargetRegisterInfo) -> bool {
    if !isCompactUnwindFrameRecordEnabled(*RepeatedSequenceLocs.front().getMF()) {
        return false;
    }
    if none_of(RepeatedSequenceLocs, Closure_24 {}) {
        return false;
    }
    return all_of(RepeatedSequenceLocs, Closure_25 { TRI: &mut TRI });
}

fn AArch64InstrInfo::findRegisterToSaveLRTo(self: *AArch64InstrInfo, C: *mut Candidate) -> Register {
    let mut MF: *mut MachineFunction = C.getMF();
    let mut TRI: *TargetRegisterInfo = *MF.getSubtarget().getRegisterInfo();
    let mut ARI: *AArch64RegisterInfo = &mut TRI as *AArch64RegisterInfo;
    for Reg in GPR64RegClass {
        if !ARI.isReservedReg(*MF, Reg) && Reg != LR && Reg != X16 && Reg != X17 && C.isAvailableAcrossAndOutOfSeq(Reg, TRI) && C.isAvailableInsideSeq(Reg, TRI) {
            return Reg;
        }
    }
    return Register { Reg: 0 };
}

fn outliningCandidatesSigningScopeConsensus(a: *Candidate, b: *Candidate) -> bool {
    let mut MFIa: *AArch64FunctionInfo *const = a.getMF().getInfo();
    let mut MFIb: *AArch64FunctionInfo *const = b.getMF().getInfo();
    return MFIa.getSignReturnAddressCondition() == MFIb.getSignReturnAddressCondition();
}

fn outliningCandidatesSigningKeyConsensus(a: *Candidate, b: *Candidate) -> bool {
    let mut MFIa: *AArch64FunctionInfo *const = a.getMF().getInfo();
    let mut MFIb: *AArch64FunctionInfo *const = b.getMF().getInfo();
    return MFIa.shouldSignWithBKey() == MFIb.shouldSignWithBKey();
}

fn outliningCandidatesV8_3OpsConsensus(a: *Candidate, b: *Candidate) -> bool {
    let mut SubtargetA: *AArch64Subtarget = a.getMF().getSubtarget();
    let mut SubtargetB: *AArch64Subtarget = b.getMF().getSubtarget();
    return SubtargetA.hasV8_3aOps() == SubtargetB.hasV8_3aOps();
}

fn AArch64InstrInfo::getOutliningCandidateInfo(self: *AArch64InstrInfo, MMI: *MachineModuleInfo, RepeatedSequenceLocs: *mut []Candidate, MinRepeats: u32) -> OutlinedFunction>> {
    let mut SequenceSize: u32 = 0;
    for MI in RepeatedSequenceLocs[0] {
        SequenceSize += self.getInstSizeInBytes(MI);
    }
    let mut NumBytesToCreateFrame: u32 = 0;
    let mut LastMI: *mut MachineInstr = RepeatedSequenceLocs[0].back();
    let mut FirstMI: *mut MachineInstr = RepeatedSequenceLocs[0].front();
    if LastMI.getOpcode() == ADRP && (LastMI.getOperand(1).getTargetFlags() & MO_PAGE) != 0 && (LastMI.getOperand(1).getTargetFlags() & MO_GOT) != 0 {
        return nullopt;
    }
    if (FirstMI.getOpcode() == ADDXri || FirstMI.getOpcode() == LDRXui) && (FirstMI.getOperand(2).getTargetFlags() & MO_PAGEOFF) != 0 && (FirstMI.getOperand(2).getTargetFlags() & MO_GOT) != 0 {
        return nullopt;
    }
    if !adjacent_find(RepeatedSequenceLocs.begin(), RepeatedSequenceLocs.end(), Closure_26 {}) == RepeatedSequenceLocs.end() {
        return nullopt;
    }
    let mut TRI: *TargetRegisterInfo = self.getRegisterInfo();
    let mut NumBytesToCheckLRInTCEpilogue: u32 = 0;
    let mut RASignCondition: SignReturnAddress = RepeatedSequenceLocs[0].getMF().getInfo().getSignReturnAddressCondition();
    if RASignCondition != None {
        NumBytesToCreateFrame += 8;
        let mut LRCheckMethod: AuthCheckMethod = self.Subtarget.getAuthenticatedLRCheckMethod(*RepeatedSequenceLocs[0].getMF());
        NumBytesToCheckLRInTCEpilogue = getCheckerSizeInBytes(LRCheckMethod);
        if isTailCallReturnInst(RepeatedSequenceLocs[0].back()) {
            SequenceSize += NumBytesToCheckLRInTCEpilogue;
        }
        let mut hasIllegalSPModification: Closure_27 = Closure_27 { TRI: &mut TRI };
        erase_if(RepeatedSequenceLocs, hasIllegalSPModification);
        if RepeatedSequenceLocs.len < MinRepeats {
            return nullopt;
        }
    }
    let mut FlagsSetInAll: u32 = 15;
    for C in RepeatedSequenceLocs {
        FlagsSetInAll &= C.Flags;
    }
    let mut LastInstrOpcode: u32 = RepeatedSequenceLocs[0].back().getOpcode();
    let mut SetCandidateCallInfo: Closure_28 = Closure_28 { RepeatedSequenceLocs: &mut RepeatedSequenceLocs };
    let mut FrameID: u32 = MachineOutlinerDefault;
    NumBytesToCreateFrame += 4;
    let mut HasBTI: bool = any_of(RepeatedSequenceLocs, Closure_29 {});
    let mut CFICount: u32 = 0;
    for I in RepeatedSequenceLocs[0] {
        if I.isCFIInstruction() {
            CFICount += 1;
        }
    }
    for C in RepeatedSequenceLocs {
        let mut CFIInstructions: []MCCFIInstruction = C.getMF().getFrameInstructions();
        if CFICount > 0 && CFICount != CFIInstructions.len {
            return nullopt;
        }
    }
    let mut IsSafeToFixup: Closure_30 = Closure_30 { cap_0: self, TRI: &mut TRI };
    let mut AllStackInstrsSafe: bool = all_of(RepeatedSequenceLocs[0], IsSafeToFixup);
    if RepeatedSequenceLocs[0].back().isTerminator(AnyInBundle) {
        FrameID = MachineOutlinerTailCall;
        NumBytesToCreateFrame = 0;
        let mut NumBytesForCall: u32 = 4 + NumBytesToCheckLRInTCEpilogue;
        SetCandidateCallInfo.call(MachineOutlinerTailCall, NumBytesForCall);
    } else if LastInstrOpcode == BL || ((LastInstrOpcode == BLR || LastInstrOpcode == BLRNoIP) && !HasBTI) {
        FrameID = MachineOutlinerThunk;
        NumBytesToCreateFrame = NumBytesToCheckLRInTCEpilogue;
        SetCandidateCallInfo.call(MachineOutlinerThunk, 4);
    } else {
        let mut NumBytesNoStackCalls: u32 = 0;
        let mut CandidatesWithoutStackFixups: []Candidate = []Candidate {};
        for C in RepeatedSequenceLocs {
            let mut LRAvailable: bool = if (C.Flags & LRUnavailableSomewhere) { C.isAvailableAcrossAndOutOfSeq(LR, TRI) } else { true };
            let mut IsNoReturn: bool = C.getMF().getFunction().hasFnAttribute(NoReturn);
            if LRAvailable && !IsNoReturn {
                NumBytesNoStackCalls += 4;
                C.setCallInfo(MachineOutlinerNoLRSave, 4);
                CandidatesWithoutStackFixups.push(C);
            } else if self.findRegisterToSaveLRTo(C).operator unsigned int() {
                NumBytesNoStackCalls += 12;
                C.setCallInfo(MachineOutlinerRegSave, 12);
                CandidatesWithoutStackFixups.push(C);
            } else if C.isAvailableInsideSeq(SP, TRI) {
                NumBytesNoStackCalls += 12;
                C.setCallInfo(MachineOutlinerDefault, 12);
                CandidatesWithoutStackFixups.push(C);
            } else {
                NumBytesNoStackCalls += SequenceSize;
            }
        }
        if !AllStackInstrsSafe || NumBytesNoStackCalls <= RepeatedSequenceLocs.len * 12 {
            RepeatedSequenceLocs = CandidatesWithoutStackFixups;
            FrameID = MachineOutlinerNoLRSave;
            if RepeatedSequenceLocs.len < MinRepeats {
                return nullopt;
            }
        } else {
            SetCandidateCallInfo.call(MachineOutlinerDefault, 12);
            if FlagsSetInAll & HasCalls {
                erase_if(RepeatedSequenceLocs, Closure_31 { cap_0: self, TRI: &mut TRI });
            }
        }
        if RepeatedSequenceLocs.len < MinRepeats {
            return nullopt;
        }
    }
    if FlagsSetInAll & HasCalls {
        let mut FirstCand: *mut Candidate = RepeatedSequenceLocs[0];
        let mut ModStackToSaveLR: bool = false;
        if any_of(drop_end(FirstCand, 1), Closure_33 {}) {
            ModStackToSaveLR = true;
        } else if FrameID != MachineOutlinerThunk && FrameID != MachineOutlinerTailCall && FirstCand.back().isCall(AnyInBundle) {
            ModStackToSaveLR = true;
        }
        if ModStackToSaveLR {
            if !AllStackInstrsSafe {
                return nullopt;
            }
            NumBytesToCreateFrame += 8;
            if predictCompactUnwindFrameRecordForOutlinedFunction(RepeatedSequenceLocs, TRI) {
                NumBytesToCreateFrame += 4;
            }
        }
    }
    if FrameID != MachineOutlinerTailCall && CFICount > 0 {
        return nullopt;
    }
    return make_unique(RepeatedSequenceLocs, SequenceSize, NumBytesToCreateFrame, FrameID);
}

fn AArch64InstrInfo::mergeOutliningCandidateAttributes(self: *AArch64InstrInfo, F: *mut Function, Candidates: *mut []Candidate) {
    let mut CFn: *Function = Candidates.front().getMF().getFunction();
    if CFn.hasFnAttribute("ptrauth-returns") {
        F.addFnAttr(CFn.getFnAttribute("ptrauth-returns"));
    }
    if CFn.hasFnAttribute("ptrauth-auth-traps") {
        F.addFnAttr(CFn.getFnAttribute("ptrauth-auth-traps"));
    }
    if CFn.hasFnAttribute("sign-return-address") {
        F.addFnAttr(CFn.getFnAttribute("sign-return-address"));
    }
    if CFn.hasFnAttribute("sign-return-address-key") {
        F.addFnAttr(CFn.getFnAttribute("sign-return-address-key"));
    }
    self.mergeOutliningCandidateAttributes(F, Candidates);
}

fn AArch64InstrInfo::isFunctionSafeToOutlineFrom(self: *AArch64InstrInfo, MF: *mut MachineFunction, OutlineFromLinkOnceODRs: bool) -> bool {
    let mut F: *Function = MF.getFunction();
    if !OutlineFromLinkOnceODRs && F.hasLinkOnceODRLinkage() {
        return false;
    }
    if F.hasSection() {
        return false;
    }
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    if !AFI || AFI.hasRedZone().value_or(true) {
        return false;
    }
    if AFI.hasStreamingModeChanges() {
        return false;
    }
    if MF.getTarget().getMCAsmInfo().usesWindowsCFI() {
        return false;
    }
    return true;
}

fn AArch64InstrInfo::getOutlinableRanges(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, Flags: *mut u32) -> iterator>> {
    assert!(MBB.getParent().getRegInfo().tracksLiveness(), "Must track liveness!");
    let mut Ranges: iterator>> = iterator>> {};
    let mut LRU: LiveRegUnits = self.getRegisterInfo();
    let mut AreAllUnsafeRegsDead: Closure_34 = Closure_34 { LRU: &mut LRU };
    let mut LRAvailableEverywhere: bool = true;
    LRU.addLiveOuts(MBB);
    let mut UpdateWholeMBBFlags: Closure_35 = Closure_35 { Flags: &mut Flags };
    let mut RangeBegin: instr_iterator = instr_iterator {};
    let mut RangeEnd: instr_iterator = instr_iterator {};
    let mut RangeLen: u32 = 0;
    let mut CreateNewRangeStartingAt: Closure_36 = Closure_36 { RangeBegin: &mut RangeBegin, RangeEnd: &mut RangeEnd, RangeLen: &mut RangeLen };
    let mut SaveRangeIfNonEmpty: Closure_37 = Closure_37 { RangeLen: &mut RangeLen, Ranges: &mut Ranges, RangeBegin: &mut RangeBegin, RangeEnd: &mut RangeEnd };
    let mut FirstPossibleEndPt: reverse_instr_iterator = MBB.instr_rbegin();
    for ; FirstPossibleEndPt != MBB.instr_rend(); operator(FirstPossibleEndPt) {
        if !operator(FirstPossibleEndPt).isDebugInstr() {
            LRU.stepBackward(operator(FirstPossibleEndPt));
        }
        UpdateWholeMBBFlags.call(operator(FirstPossibleEndPt));
        if AreAllUnsafeRegsDead.call() {
            break;
        }
    }
    if FirstPossibleEndPt == MBB.instr_rend() {
        return Ranges;
    }
    CreateNewRangeStartingAt.call(operator(FirstPossibleEndPt).getIterator());
    for MI in make_range(FirstPossibleEndPt, MBB.instr_rend()) {
        if !MI.isDebugInstr() {
            LRU.stepBackward(MI);
        }
        UpdateWholeMBBFlags.call(MI);
        if !AreAllUnsafeRegsDead.call() {
            SaveRangeIfNonEmpty.call();
            CreateNewRangeStartingAt.call(MI.getIterator());
            continue;
        }
        LRAvailableEverywhere &= LRU.available(LR);
        RangeBegin = MI.getIterator();
        if !MI.isDebugInstr() {
            RangeLen += 1;
        }
    }
    if AreAllUnsafeRegsDead.call() {
        SaveRangeIfNonEmpty.call();
    }
    if Ranges.is_empty() {
        return Ranges;
    }
    reverse(Ranges.begin(), Ranges.end());
    if !LRAvailableEverywhere {
        Flags |= LRUnavailableSomewhere;
    }
    return Ranges;
}

fn AArch64InstrInfo::getOutliningTypeImpl(self: *AArch64InstrInfo, MMI: *MachineModuleInfo, MIT: *mut iterator, Flags: u32) -> InstrType {
    let mut MI: *mut MachineInstr = operator(MIT);
    match MI.getOpcode() {
        PACM => {
            PACIASP;
        },
    }
    if MI.isCFIInstruction() {
        return Legal;
    }
    if MI.isTerminator(AnyInBundle) {
        return Legal;
    }
    for MOP in MI.operands() {
        assert!(!MOP.isCFIIndex();
        if MOP.isReg() && !MOP.isImplicit() && (MOP.getReg() == LR || MOP.getReg() == W30) {
            return Illegal;
        }
    }
    if MI.getOpcode() == ADRP {
        return Legal;
    }
    if MI.isCall(AnyInBundle) {
        let mut Callee: *Function = null;
        for MOP in MI.operands() {
            if MOP.isGlobal() {
                Callee = dyn_cast(MOP.getGlobal());
                break;
            }
        }
        if Callee && Callee.getName() == "\001_mcount" {
            return Illegal;
        }
        let mut UnknownCallOutlineType: InstrType = Illegal;
        if MI.getOpcode() == BLR || MI.getOpcode() == BLRNoIP || MI.getOpcode() == BL {
            UnknownCallOutlineType = LegalTerminator;
        }
        if !Callee {
            return UnknownCallOutlineType;
        }
        let mut CalleeMF: *mut MachineFunction = MMI.getMachineFunction(*Callee);
        if !CalleeMF {
            return UnknownCallOutlineType;
        }
        let mut MFI: *mut MachineFrameInfo = CalleeMF.getFrameInfo();
        if !MFI.isCalleeSavedInfoValid() || MFI.getStackSize() > 0 || MFI.getNumObjects() > 0 {
            return UnknownCallOutlineType;
        }
        return Legal;
    }
    if MI.readsRegister(W30, &mut self.getRegisterInfo()) || MI.modifiesRegister(W30, &mut self.getRegisterInfo()) {
        return Illegal;
    }
    if hasBTISemantics(MI) {
        return Illegal;
    }
    return Legal;
}

fn AArch64InstrInfo::fixupPostOutline(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock) {
    for MI in MBB {
        let mut Base: *MachineOperand = null;
        let mut Width: TypeSize = TypeSize { 0, false };
        let mut Offset: i64 = 0;
        let mut OffsetIsScalable: bool = false;
        if !MI.mayLoadOrStore(AnyInBundle) || !self.getMemOperandWithOffsetWidth(MI, Base, Offset, OffsetIsScalable, Width, &mut self.RI) || (Base.isReg() && Base.getReg() != SP) {
            continue;
        }
        let mut Scale: TypeSize = TypeSize { 0, false };
        let mut Dummy1: i64 = 0;
        let mut Dummy2: i64 = 0;
        let mut StackOffsetOperand: *mut MachineOperand = self.getMemOpBaseRegImmOfsOffsetOperand(MI);
        assert!(StackOffsetOperand.isImm(), "Stack offset wasn't immediate!");
        getMemOpInfo(MI.getOpcode(), Scale, Width, Dummy1, Dummy2);
        assert!(Scale.operator unsigned long long() != 0, "Unexpected opcode!");
        assert!(!OffsetIsScalable, "Expected offset to be a byte offset");
        let mut NewImm: i64 = (Offset + 16) / Scale.getFixedValue() as i64;
        StackOffsetOperand.setImm(NewImm);
    }
}

fn signOutlinedFunction(MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, TII: *AArch64InstrInfo, ShouldSignReturnAddr: bool) {
    if !ShouldSignReturnAddr {
        return;
    }
    BuildMI(MBB, MBB.begin(), MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(PAUTH_PROLOGUE)).setMIFlag(FrameSetup);
    TII.createPauthEpilogueInstr(MBB, DebugLoc { Loc: null });
}

fn AArch64InstrInfo::buildOutlinedFrame(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, MF: *mut MachineFunction, OF: *OutlinedFunction) {
    let mut FI: *mut AArch64FunctionInfo = MF.getInfo();
    if OF.FrameConstructionID == MachineOutlinerTailCall {
        FI.setOutliningStyle("Tail Call");
    } else if OF.FrameConstructionID == MachineOutlinerThunk {
        let mut Call: *mut MachineInstr = &mut operator(operator(MBB.instr_end()));
        let mut TailOpcode: u32 = 0;
        if Call.getOpcode() == BL {
            TailOpcode = TCRETURNdi;
        } else {
            assert!(Call.getOpcode() == BLR || Call.getOpcode() == BLRNoIP);
            TailOpcode = TCRETURNriALL;
        }
        let mut TC: *mut MachineInstr = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(TailOpcode)).add(Call.getOperand(0)).addImm(0).operator llvm::MachineInstr *();
        MBB.insert(MBB.end(), TC);
        Call.eraseFromParent();
        FI.setOutliningStyle("Thunk");
    }
    let mut IsLeafFunction: bool = true;
    let mut IsNonTailCall: Closure_38 = Closure_38 {};
    if any_of(MBB.instrs(), IsNonTailCall) {
        assert!(OF.FrameConstructionID != MachineOutlinerDefault, "Can only fix up stack references once");
        self.fixupPostOutline(MBB);
        IsLeafFunction = false;
        if !MBB.isLiveIn(LR, getAll()) {
            MBB.addLiveIn(LR, getAll());
        }
        let mut It: iterator = MBB.begin();
        let mut Et: iterator = MBB.end();
        if OF.FrameConstructionID == MachineOutlinerTailCall || OF.FrameConstructionID == MachineOutlinerThunk {
            Et = prev(MBB.end(), 1);
        }
        if shouldUseCompactUnwindFrameRecordForOutlinedFunction(MBB) {
            if !MBB.isLiveIn(FP, getAll()) {
                MBB.addLiveIn(FP, getAll());
            }
            let mut STPXpre: *mut MachineInstr = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(STPXpre)).addReg(SP, Define, 0).addReg(FP, RegState {}, 0).addReg(LR, RegState {}, 0).addReg(SP, RegState {}, 0).addImm(-2).operator llvm::MachineInstr *();
            It = MBB.insert(It, STPXpre);
            let mut SetFP: *mut MachineInstr = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ADDXri)).addReg(FP, Define, 0).addReg(SP, RegState {}, 0).addImm(0).addImm(0).operator llvm::MachineInstr *();
            MBB.insertAfter(It, SetFP);
            let mut CFIBuilder: CFIInstBuilder = CFIInstBuilder { MBB, next(SetFP.getIterator(), 1), FrameSetup, true };
            CFIBuilder.buildDefCFA(FP, 16);
            CFIBuilder.buildOffset(LR, -8);
            CFIBuilder.buildOffset(FP, -16);
            let mut LDPXpost: *mut MachineInstr = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDPXpost)).addReg(SP, Define, 0).addReg(FP, Define, 0).addReg(LR, Define, 0).addReg(SP, RegState {}, 0).addImm(2).operator llvm::MachineInstr *();
            Et = MBB.insert(Et, LDPXpost);
        } else {
            let mut STRXpre: *mut MachineInstr = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(STRXpre)).addReg(SP, Define, 0).addReg(LR, RegState {}, 0).addReg(SP, RegState {}, 0).addImm(-16).operator llvm::MachineInstr *();
            It = MBB.insert(It, STRXpre);
            if MF.getInfo().needsDwarfUnwindInfo(MF) {
                let mut CFIBuilder: CFIInstBuilder = CFIInstBuilder { MBB, It, FrameSetup, true };
                CFIBuilder.buildDefCFAOffset(16, null);
                CFIBuilder.buildOffset(LR, -16);
            }
            let mut LDRXpost: *mut MachineInstr = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRXpost)).addReg(SP, Define, 0).addReg(LR, Define, 0).addReg(SP, RegState {}, 0).addImm(16).operator llvm::MachineInstr *();
            Et = MBB.insert(Et, LDRXpost);
        }
    }
    let mut RASignCondition: SignReturnAddress = FI.getSignReturnAddressCondition();
    let mut ShouldSignReturnAddr: bool = shouldSignReturnAddress(RASignCondition, !IsLeafFunction);
    if OF.FrameConstructionID == MachineOutlinerTailCall || OF.FrameConstructionID == MachineOutlinerThunk {
        signOutlinedFunction(MF, MBB, self, ShouldSignReturnAddr);
        return;
    }
    if !MBB.isLiveIn(LR, getAll()) {
        MBB.addLiveIn(LR, getAll());
    }
    let mut ret: *mut MachineInstr = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(RET)).addReg(LR, RegState {}, 0).operator llvm::MachineInstr *();
    MBB.insert(MBB.end(), ret);
    signOutlinedFunction(MF, MBB, self, ShouldSignReturnAddr);
    FI.setOutliningStyle("Function");
    if OF.FrameConstructionID != MachineOutlinerDefault {
        return;
    }
    self.fixupPostOutline(MBB);
}

fn AArch64InstrInfo::insertOutlinedCall(self: *AArch64InstrInfo, M: *mut Module, MBB: *mut MachineBasicBlock, It: *mut iterator, MF: *mut MachineFunction, C: *mut Candidate) -> iterator {
    if C.CallConstructionID == MachineOutlinerTailCall {
        It = MBB.insert(It, BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(TCRETURNdi)).addGlobalAddress(M.getNamedValue(MF.getName()), 0, 0).addImm(0).operator llvm::MachineInstr *());
        return It;
    }
    if C.CallConstructionID == MachineOutlinerNoLRSave || C.CallConstructionID == MachineOutlinerThunk {
        It = MBB.insert(It, BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(BL)).addGlobalAddress(M.getNamedValue(MF.getName()), 0, 0).operator llvm::MachineInstr *());
        return It;
    }
    let mut CallPt: iterator = iterator {};
    let mut Save: *mut MachineInstr = null;
    let mut Restore: *mut MachineInstr = null;
    if C.CallConstructionID == MachineOutlinerRegSave {
        let mut Reg: Register = self.findRegisterToSaveLRTo(C);
        assert!(Reg.operator unsigned int(), "No callee-saved register available?");
        if !MBB.isLiveIn(LR, getAll()) {
            MBB.addLiveIn(LR, getAll());
        }
        Save = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRXrs), Reg).addReg(XZR, RegState {}, 0).addReg(LR, RegState {}, 0).addImm(0).operator llvm::MachineInstr *();
        Restore = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRXrs), LR).addReg(XZR, RegState {}, 0).addReg(Reg, RegState {}, 0).addImm(0).operator llvm::MachineInstr *();
    } else {
        Save = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(STRXpre)).addReg(SP, Define, 0).addReg(LR, RegState {}, 0).addReg(SP, RegState {}, 0).addImm(-16).operator llvm::MachineInstr *();
        Restore = BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRXpost)).addReg(SP, Define, 0).addReg(LR, Define, 0).addReg(SP, RegState {}, 0).addImm(16).operator llvm::MachineInstr *();
    }
    It = MBB.insert(It, Save);
    operator(It, 0);
    It = MBB.insert(It, BuildMI(MF, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(BL)).addGlobalAddress(M.getNamedValue(MF.getName()), 0, 0).operator llvm::MachineInstr *());
    CallPt = It;
    operator(It, 0);
    It = MBB.insert(It, Restore);
    return CallPt;
}

fn AArch64InstrInfo::shouldOutlineFromFunctionByDefault(self: *AArch64InstrInfo, MF: *mut MachineFunction) -> bool {
    return MF.getFunction().hasMinSize();
}

fn AArch64InstrInfo::buildClearRegister(self: *AArch64InstrInfo, Reg: Register, MBB: *mut MachineBasicBlock, Iter: iterator, DL: *mut DebugLoc, AllowSideEffects: bool) {
    let mut MF: *MachineFunction = *MBB.getParent();
    let mut STI: *AArch64Subtarget = MF.getSubtarget();
    let mut TRI: *AArch64RegisterInfo = *STI.getRegisterInfo();
    if TRI.isGeneralPurposeRegister(MF, Reg.operator MCRegister()) {
        BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOVZXi), Reg).addImm(0).addImm(0);
    } else if STI.isSVEorStreamingSVEAvailable() {
        BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(DUP_ZI_D), Reg).addImm(0).addImm(0);
    } else if STI.isNeonAvailable() {
        BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOVIv2d_ns), Reg).addImm(0);
    } else {
        assert!(STI.hasFPARMv8(), "Expected FP to be available.");
        let mut Reg64: Register = TRI.getSubReg(Reg.operator MCRegister(), dsub);
        BuildMI(MBB, Iter, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(FMOVD0), Reg64);
    }
}

fn AArch64InstrInfo::isCopyInstrImpl(self: *AArch64InstrInfo, MI: *MachineInstr) -> optional<DestSourcePair> {
    if (MI.getOpcode() == ORRWrs && MI.getOperand(1).getReg() == WZR && MI.getOperand(3).getImm() == 0) || (MI.getOpcode() == ORRWrr && MI.getOperand(1).getReg() == WZR) {
        if (MI.getOperand(0).getReg().isPhysical() && MI.findRegisterDefOperandIdx(getXRegFromWReg(MI.getOperand(0).getReg().operator MCRegister()), null, false, false) == -1) || (MI.getOperand(0).getReg().isVirtual() && !MI.getOperand(0).getSubReg()) {
            return DestSourcePair { Destination: MI.getOperand(0), Source: MI.getOperand(2) };
        }
    }
    if MI.getOpcode() == ORRXrs && MI.getOperand(1).getReg() == XZR && MI.getOperand(3).getImm() == 0 {
        return DestSourcePair { Destination: MI.getOperand(0), Source: MI.getOperand(2) };
    }
    return nullopt;
}

fn AArch64InstrInfo::isCopyLikeInstrImpl(self: *AArch64InstrInfo, MI: *MachineInstr) -> optional<DestSourcePair> {
    if (MI.getOpcode() == ORRWrs && MI.getOperand(1).getReg() == WZR && MI.getOperand(3).getImm() == 0) || (MI.getOpcode() == ORRWrr && MI.getOperand(1).getReg() == WZR) {
        return DestSourcePair { Destination: MI.getOperand(0), Source: MI.getOperand(2) };
    }
    return nullopt;
}

fn AArch64InstrInfo::isAddImmediate(self: *AArch64InstrInfo, MI: *MachineInstr, Reg: Register) -> optional<RegImmPair> {
    let mut Sign: i32 = 1;
    let mut Offset: i64 = 0;
    let mut Op0: *MachineOperand = MI.getOperand(0);
    if !Op0.isReg() || Reg != Op0.getReg() {
        return nullopt;
    }
    match MI.getOpcode() {
        _ => {
            return nullopt;
        },
        SUBWri => {
            SUBXri;
        },
        ADDSWri => {
            ADDSXri;
        },
    }
    return RegImmPair { Reg: MI.getOperand(1).getReg(), Imm: Offset };
}

fn describeORRLoadedValue(MI: *MachineInstr, DescribedReg: Register, TII: *TargetInstrInfo, TRI: *TargetRegisterInfo) -> optional<ParamLoadedValue> {
    let mut DestSrc: optional<DestSourcePair> = TII.isCopyLikeInstr(MI);
    if !DestSrc {
        return nullopt;
    }
    let mut DestReg: Register = operator(DestSrc).Destination.getReg();
    let mut SrcReg: Register = operator(DestSrc).Source.getReg();
    if !DestReg.isValid() || !SrcReg.isValid() {
        return nullopt;
    }
    let mut Expr: *mut DIExpression = get(MI.getMF().getFunction().getContext(), ArrayRef<uint64_t> {});
    if DestReg == DescribedReg {
        return ParamLoadedValue { CreateReg(SrcReg, false, false, false, false, false, false, 0, false, false, false), Expr };
    }
    if MI.getOpcode() == ORRWrs && TRI.isSuperRegister(DestReg.operator MCRegister(), DescribedReg.operator MCRegister()) {
        return ParamLoadedValue { CreateReg(SrcReg, false, false, false, false, false, false, 0, false, false, false), Expr };
    }
    if MI.getOpcode() == ORRXrs && TRI.isSubRegister(DestReg.operator MCRegister(), DescribedReg.operator MCRegister()) {
        let mut SrcSubReg: Register = TRI.getSubReg(SrcReg.operator MCRegister(), sub_32);
        return ParamLoadedValue { CreateReg(SrcSubReg, false, false, false, false, false, false, 0, false, false, false), Expr };
    }
    assert!(!TRI.isSuperOrSubRegisterEq(DestReg.operator MCRegister(), DescribedReg.operator MCRegister()), "Unhandled ORR[XW]rs copy case");
    return nullopt;
}

fn AArch64InstrInfo::isFunctionSafeToSplit(self: *AArch64InstrInfo, MF: *MachineFunction) -> bool {
    if MF.getInfo().hasRedZone().value_or(true) {
        return false;
    }
    return self.isFunctionSafeToSplit(MF);
}

fn AArch64InstrInfo::isMBBSafeToSplitToCold(self: *AArch64InstrInfo, MBB: *MachineBasicBlock) -> bool {
    let mut isAsmGoto: Closure_39 = Closure_39 {};
    if any_of(MBB, isAsmGoto) || MBB.isInlineAsmBrIndirectTarget() {
        return false;
    }
    let mut MJTI: *MachineJumpTableInfo = MBB.getParent().getJumpTableInfo();
    let mut containsMBB: Closure_40 = Closure_40 { MBB: &mut MBB };
    if MJTI != null && any_of(MJTI.getJumpTables(), containsMBB) {
        return false;
    }
    for MI in MBB {
        match MI.getOpcode() {
            G_BRJT => {
                JumpTableDest32;
            },
            _ => {
                continue;
            },
        }
    }
    return true;
}

fn AArch64InstrInfo::describeLoadedValue(self: *AArch64InstrInfo, MI: *MachineInstr, Reg: Register) -> optional<ParamLoadedValue> {
    let mut MF: *MachineFunction = MI.getMF();
    let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
    match MI.getOpcode() {
        MOVZWi => {
            MOVZXi;
        },
        ORRWrs => {
            ORRXrs;
        },
    }
    return self.describeLoadedValue(MI, Reg);
}

fn AArch64InstrInfo::isExtendLikelyToBeFolded(self: *AArch64InstrInfo, ExtMI: *mut MachineInstr, MRI: *mut MachineRegisterInfo) -> bool {
    assert!(ExtMI.getOpcode() == G_SEXT || ExtMI.getOpcode() == G_ZEXT || ExtMI.getOpcode() == G_ANYEXT);
    if ExtMI.getOpcode() == G_ANYEXT {
        return true;
    }
    let mut DefReg: Register = ExtMI.getOperand(0).getReg();
    if !MRI.hasOneNonDBGUse(DefReg) {
        return false;
    }
    let mut UserMI: *mut MachineInstr = &mut operator(MRI.use_instr_nodbg_begin(DefReg));
    return UserMI.getOpcode() == G_PTR_ADD;
}

fn AArch64InstrInfo::getElementSizeForOpcode(self: *AArch64InstrInfo, Opc: u32) -> u64 {
    return self.get(Opc).TSFlags & ElementSizeMask;
}

fn AArch64InstrInfo::isPTestLikeOpcode(self: *AArch64InstrInfo, Opc: u32) -> bool {
    return self.get(Opc).TSFlags & InstrFlagIsPTestLike;
}

fn AArch64InstrInfo::isWhileOpcode(self: *AArch64InstrInfo, Opc: u32) -> bool {
    return self.get(Opc).TSFlags & InstrFlagIsWhile;
}

fn AArch64InstrInfo::getTailDuplicateSize(self: *AArch64InstrInfo, OptLevel: CodeGenOptLevel) -> u32 {
    return if OptLevel >= Aggressive { 6 } else { 2 };
}

fn AArch64InstrInfo::isLegalAddressingMode(self: *AArch64InstrInfo, NumBytes: u32, Offset: i64, Scale: u32) -> bool {
    if Offset && Scale {
        return false;
    }
    if !Scale {
        if isInt(Offset) {
            return true;
        }
        let mut Shift: u32 = Log2_64(NumBytes);
        if NumBytes && Offset > 0 && (Offset / NumBytes) <= (1 << 12) - 1 && (Offset >> Shift) << Shift == Offset {
            return true;
        }
        return false;
    }
    return Scale == 1 || (Scale > 0 && Scale == NumBytes);
}

fn getBLRCallOpcode(MF: *MachineFunction) -> u32 {
    if MF.getSubtarget().hardenSlsBlr() {
        return BLRNoIP;
    } else {
        return BLR;
    }
}

fn AArch64InstrInfo::createPauthEpilogueInstr(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, DL: DebugLoc) {
    let mut InsertPt: iterator = MBB.getFirstTerminator();
    let mut Builder: MachineInstrBuilder = BuildMI(MBB, InsertPt, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(PAUTH_EPILOGUE)).setMIFlag(FrameDestroy);
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut AFI: *AArch64FunctionInfo const = MF.getInfo();
    let mut AFL: *AArch64FrameLowering = *MF.getSubtarget().getFrameLowering() as *AArch64FrameLowering;
    if AFL.getArgumentStackToRestore(MF, MBB) {
        Builder.addReg(X17, ImplicitDefine, 0);
        Builder.addReg(X16, ImplicitDefine, 0);
        if AFI.branchProtectionPAuthLR() {
            Builder.addReg(X15, ImplicitDefine, 0);
        }
        return;
    }
    if AFI.branchProtectionPAuthLR() && !self.Subtarget.hasPAuthLR() {
        Builder.addReg(X16, ImplicitDefine, 0);
    }
}

fn AArch64InstrInfo::probedStackAlloc(self: *AArch64InstrInfo, MBBI: iterator, TargetReg: Register, FrameSetup: bool) -> iterator {
    assert!(TargetReg != SP, "New top of stack cannot already be in SP");
    let mut MBB: *mut MachineBasicBlock = *operator(MBBI).getParent();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut TII: *AArch64InstrInfo = MF.getSubtarget().getInstrInfo();
    let mut ProbeSize: i64 = MF.getInfo().getStackProbeSize();
    let mut DL: DebugLoc = MBB.findDebugLoc(MBBI);
    let mut MBBInsertPoint: iterator = next(MBB.getIterator(), 1);
    let mut LoopTestMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(MBBInsertPoint, LoopTestMBB);
    let mut LoopBodyMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(MBBInsertPoint, LoopBodyMBB);
    let mut ExitMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(MBBInsertPoint, ExitMBB);
    let mut Flags: MIFlag = if FrameSetup { FrameSetup } else { NoFlags };
    emitFrameOffset(*LoopTestMBB, LoopTestMBB.end(), DL, SP, SP, getFixed(-ProbeSize), TII, Flags, false, false, null, false, StackOffset {}, SP);
    BuildMI(*LoopTestMBB, LoopTestMBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SUBSXrx64), XZR).addReg(SP, RegState {}, 0).addReg(TargetReg, RegState {}, 0).addImm(getArithExtendImm(UXTX, 0)).setMIFlags(Flags);
    BuildMI(*LoopTestMBB, LoopTestMBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Bcc)).addImm(LE).addMBB(ExitMBB, 0).setMIFlags(Flags);
    BuildMI(*LoopBodyMBB, LoopBodyMBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LDRXui)).addDef(XZR, RegState {}, 0).addReg(SP, RegState {}, 0).addImm(0).addMemOperand(MF.getMachineMemOperand(getUnknownStack(MF), MOLoad | MOVolatile, 8, 8, MMOMetadata {}, System, NotAtomic, NotAtomic)).setMIFlags(Flags);
    BuildMI(*LoopBodyMBB, LoopBodyMBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(B)).addMBB(LoopTestMBB, 0).setMIFlags(Flags);
    BuildMI(*ExitMBB, ExitMBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(ADDXri), SP).addReg(TargetReg, RegState {}, 0).addImm(0).addImm(getShifterImm(LSL, 0)).setMIFlags(Flags);
    BuildMI(*ExitMBB, ExitMBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LDRXui)).addReg(XZR, Define, 0).addReg(SP, RegState {}, 0).addImm(0).setMIFlags(Flags);
    ExitMBB.splice(ExitMBB.end(), &mut MBB, next(MBBI, 1), MBB.end());
    ExitMBB.transferSuccessorsAndUpdatePHIs(&mut MBB);
    LoopTestMBB.addSuccessor(ExitMBB, getUnknown());
    LoopTestMBB.addSuccessor(LoopBodyMBB, getUnknown());
    LoopBodyMBB.addSuccessor(LoopTestMBB, getUnknown());
    MBB.addSuccessor(LoopTestMBB, getUnknown());
    if MF.getRegInfo().reservedRegsFrozen() {
        fullyRecomputeLiveIns([ExitMBB, LoopBodyMBB, LoopTestMBB]);
    }
    return ExitMBB.begin();
}

struct AArch64PipelinerLoopInfo {
    MF: *mut MachineFunction,
    TII: *TargetInstrInfo,
    TRI: *TargetRegisterInfo,
    MRI: *mut MachineRegisterInfo,
    LoopBB: *mut MachineBasicBlock,
    CondBranch: *mut MachineInstr,
    Comp: *mut MachineInstr,
    CompCounterOprNum: u32,
    Update: *mut MachineInstr,
    UpdateCounterOprNum: u32,
    Init: Register,
    IsUpdatePriorComp: bool,
    Cond: SmallVector<MachineOperand, 4>,
}

fn AArch64PipelinerLoopInfo::shouldIgnoreForPipelining(self: *AArch64PipelinerLoopInfo, MI: *MachineInstr) -> bool {
    return MI == self.Comp;
}

fn AArch64PipelinerLoopInfo::createTripCountGreaterCondition(self, TC: i32, MBB: *mut MachineBasicBlock, CondParam: *mut SmallVectorImpl<MachineOperand>) -> optional<bool> {
    CondParam = self.Cond;
    return optional<bool> {};
}

fn AArch64PipelinerLoopInfo::setPreheader(self, NewPreheader: *mut MachineBasicBlock) {}

fn AArch64PipelinerLoopInfo::adjustTripCount(self, TripCountAdjust: i32) {}

fn AArch64PipelinerLoopInfo::isMVEExpanderSupported(self) -> bool {
    return true;
}

fn cloneInstr(MI: *MachineInstr, ReplaceOprNum: u32, ReplaceReg: Register, MBB: *mut MachineBasicBlock, InsertTo: iterator) -> Register {
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut TII: *TargetInstrInfo = MBB.getParent().getSubtarget().getInstrInfo();
    let mut NewMI: *mut MachineInstr = MBB.getParent().CloneMachineInstr(MI);
    let mut Result: Register = 0;
    for let mut I: u32 = 0; I < NewMI.getNumOperands(); I += 1 {
        if I == 0 && NewMI.getOperand(0).getReg().isVirtual() {
            Result = MRI.createVirtualRegister(MRI.getRegClass(NewMI.getOperand(0).getReg()), "");
            NewMI.getOperand(I).setReg(Result);
        } else if I == ReplaceOprNum {
            MRI.constrainRegClass(ReplaceReg, TII.getRegClass(NewMI.getDesc(), I), 0);
            NewMI.getOperand(I).setReg(ReplaceReg);
        }
    }
    MBB.insert(InsertTo, NewMI);
    return Result;
}

fn AArch64PipelinerLoopInfo::createRemainingIterationsGreaterCondition(self, TC: i32, MBB: *mut MachineBasicBlock, Cond: *mut SmallVectorImpl<MachineOperand>, LastStage0Insts: *mut DenseMap<MachineInstr *, MachineInstr *>) {
    assert!(self.CondBranch.getOpcode() == Bcc);
    let mut CC: CondCode = self.CondBranch.getOperand(0).getImm() as CondCode;
    if self.CondBranch.getOperand(1).getMBB() == self.LoopBB {
        CC = getInvertedCondCode(CC);
    }
    let mut AccCond: Register = XZR;
    let mut AccumulateCond: Closure_41 = Closure_41 { cap_0: self, MBB: &mut MBB };
    if !LastStage0Insts.is_empty() && LastStage0Insts[self.Comp].getParent() == &mut MBB {
        let mut Counter: Register = 0;
        for let mut I: i32 = 0; I <= TC; I += 1 {
            let mut NextCounter: Register = 0;
            if I != 0 {
                NextCounter = cloneInstr(self.Comp, self.CompCounterOprNum, Counter, MBB, MBB.end());
            }
            AccCond = AccumulateCond.call(AccCond, CC);
            if I != TC {
                if I == 0 {
                    if self.Update != self.Comp && self.IsUpdatePriorComp {
                        Counter = LastStage0Insts[self.Comp].getOperand(self.CompCounterOprNum).getReg();
                        NextCounter = cloneInstr(self.Update, self.UpdateCounterOprNum, Counter, MBB, MBB.end());
                    } else {
                        NextCounter = LastStage0Insts[self.Update].getOperand(0).getReg();
                    }
                } else if self.Update != self.Comp {
                    NextCounter = cloneInstr(self.Update, self.UpdateCounterOprNum, Counter, MBB, MBB.end());
                }
            }
            Counter = NextCounter;
        }
    } else {
        let mut Counter: Register = 0;
        if LastStage0Insts.is_empty() {
            Counter = self.Init;
            if self.IsUpdatePriorComp {
                Counter = cloneInstr(self.Update, self.UpdateCounterOprNum, Counter, MBB, MBB.end());
            }
        } else {
            Counter = LastStage0Insts[self.Comp].getOperand(self.CompCounterOprNum).getReg();
        }
        for let mut I: i32 = 0; I <= TC; I += 1 {
            let mut NextCounter: Register = 0;
            NextCounter = cloneInstr(self.Comp, self.CompCounterOprNum, Counter, MBB, MBB.end());
            AccCond = AccumulateCond.call(AccCond, CC);
            if I != TC && self.Update != self.Comp {
                NextCounter = cloneInstr(self.Update, self.UpdateCounterOprNum, Counter, MBB, MBB.end());
            }
            Counter = NextCounter;
        }
    }
    BuildMI(MBB, MBB.end(), MIMetadata { DL: self.Comp.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SUBSXri)).addReg(XZR, Define | Dead, 0).addReg(AccCond, RegState {}, 0).addImm(0).addImm(0);
    Cond.clear();
    Cond.push(CreateImm(EQ));
}

fn extractPhiReg(Phi: *MachineInstr, MBB: *MachineBasicBlock, RegMBB: *mut Register, RegOther: *mut Register) {
    assert!(Phi.getNumOperands() == 5);
    if Phi.getOperand(2).getMBB() == MBB {
        RegMBB = Phi.getOperand(1).getReg();
        RegOther = Phi.getOperand(3).getReg();
    } else {
        assert!(Phi.getOperand(4).getMBB() == MBB);
        RegMBB = Phi.getOperand(3).getReg();
        RegOther = Phi.getOperand(1).getReg();
    }
}

fn isDefinedOutside(Reg: Register, BB: *MachineBasicBlock) -> bool {
    if !Reg.isVirtual() {
        return false;
    }
    let mut MRI: *MachineRegisterInfo = BB.getParent().getRegInfo();
    return MRI.getDefBlock(Reg) != BB;
}

fn getIndVarInfo(Reg: Register, LoopBB: *MachineBasicBlock, UpdateInst: *mut *mut MachineInstr, UpdateCounterOprNum: *mut u32, InitReg: *mut Register, IsUpdatePriorComp: *mut bool) -> bool {
    if LoopBB.pred_size() != 2 {
        return false;
    }
    if !Reg.isVirtual() {
        return false;
    }
    let mut MRI: *MachineRegisterInfo = LoopBB.getParent().getRegInfo();
    UpdateInst = null;
    UpdateCounterOprNum = 0;
    InitReg = 0;
    IsUpdatePriorComp = true;
    let mut CurReg: Register = Reg;
    while true {
        let mut Def: *mut MachineInstr = MRI.getVRegDef(CurReg);
        if Def.getParent() != LoopBB {
            return false;
        }
        if Def.isCopy() {
            if Def.getOperand(0).getSubReg() || Def.getOperand(1).getSubReg() {
                return false;
            }
            CurReg = Def.getOperand(1).getReg();
        } else if Def.isPHI() {
            if InitReg != 0 {
                return false;
            }
            if !UpdateInst {
                IsUpdatePriorComp = false;
            }
            extractPhiReg(*Def, LoopBB, CurReg, InitReg);
        } else {
            if UpdateInst {
                return false;
            }
            match Def.getOpcode() {
                ADDSXri => {
                    ADDSWri;
                },
                ADDSXrr => {
                    ADDSWrr;
                },
                _ => {
                    return false;
                },
            }
            CurReg = Def.getOperand(UpdateCounterOprNum).getReg();
        }
        if !CurReg.isVirtual() {
            return false;
        }
        if Reg == CurReg {
            break;
        }
    }
    if !UpdateInst {
        return false;
    }
    return true;
}

fn AArch64InstrInfo::analyzeLoopForPipelining(self: *AArch64InstrInfo, LoopBB: *mut MachineBasicBlock) -> PipelinerLoopInfo> {
    for MI in *LoopBB {
        if MI.isCall(AnyInBundle) || MI.hasUnmodeledSideEffects() {
            return null;
        }
    }
    let mut TBB: *mut MachineBasicBlock = null;
    let mut FBB: *mut MachineBasicBlock = null;
    let mut Cond: SmallVector<MachineOperand, 4> = SmallVector<MachineOperand, 4> {};
    if self.analyzeBranch(*LoopBB, TBB, FBB, Cond, false) {
        return null;
    }
    if TBB == LoopBB && FBB == LoopBB {
        return null;
    }
    if TBB != LoopBB && FBB == null {
        return null;
    }
    assert!((TBB == LoopBB || FBB == LoopBB), "The Loop must be a single-basic-block loop");
    let mut CondBranch: *mut MachineInstr = &mut operator(LoopBB.getFirstTerminator());
    let mut TRI: *TargetRegisterInfo = self.getRegisterInfo();
    if CondBranch.getOpcode() != Bcc {
        return null;
    }
    if TBB == LoopBB {
        self.reverseBranchCondition(Cond);
    }
    let mut Comp: *mut MachineInstr = null;
    let mut CompCounterOprNum: u32 = 0;
    for MI in reverse(*LoopBB) {
        if MI.modifiesRegister(NZCV, &mut TRI) {
            match MI.getOpcode() {
                SUBSXri => {
                    SUBSWri;
                },
                ADDSWrr => {
                    ADDSXrr;
                },
                _ => {
                    if self.isWhileOpcode(MI.getOpcode()) {
                        Comp = &mut MI;
                        break;
                    }
                },
            }
            if CompCounterOprNum == 0 {
                if isDefinedOutside(Comp.getOperand(1).getReg(), LoopBB) {
                    CompCounterOprNum = 2;
                } else if isDefinedOutside(Comp.getOperand(2).getReg(), LoopBB) {
                    CompCounterOprNum = 1;
                } else {
                    return null;
                }
            }
            break;
        }
    }
    if !Comp {
        return null;
    }
    let mut Update: *mut MachineInstr = null;
    let mut Init: Register = 0;
    let mut IsUpdatePriorComp: bool = false;
    let mut UpdateCounterOprNum: u32 = 0;
    if !getIndVarInfo(Comp.getOperand(CompCounterOprNum).getReg(), LoopBB, Update, UpdateCounterOprNum, Init, IsUpdatePriorComp) {
        return null;
    }
    return make_unique(LoopBB, CondBranch, Comp, CompCounterOprNum, Update, UpdateCounterOprNum, Init, IsUpdatePriorComp, Cond);
}

fn AArch64InstrInfo::verifyInstruction(self: *AArch64InstrInfo, MI: *MachineInstr, ErrInfo: *mut str) -> bool {
    let mut Scale: TypeSize = TypeSize { 0, false };
    let mut Width: TypeSize = TypeSize { 0, false };
    let mut MinOffset: i64 = 0;
    let mut MaxOffset: i64 = 0;
    if getMemOpInfo(MI.getOpcode(), Scale, Width, MinOffset, MaxOffset) {
        let mut ImmIdx: u32 = getLoadStoreImmIdx(MI.getOpcode());
        if MI.getOperand(ImmIdx).isImm() && !MI.getOperand(ImmIdx - 1).isFI() {
            let mut Imm: i64 = MI.getOperand(ImmIdx).getImm();
            if Imm < MinOffset || Imm > MaxOffset {
                ErrInfo = "Unexpected immediate on load/store instruction";
                return false;
            }
        }
    }
    let mut MCID: *MCInstrDesc = MI.getDesc();
    for let mut Op: u32 = 0; Op < MCID.getNumOperands(); Op += 1 {
        let mut MO: *MachineOperand = MI.getOperand(Op);
        match MCID.operands()[Op].OperandType {
            OPERAND_IMPLICIT_IMM_0 => {
                if !MO.isImm() || MO.getImm() != 0 {
                    ErrInfo = "OPERAND_IMPLICIT_IMM_0 should be 0";
                    return false;
                }
            },
            OPERAND_SHIFT_MSL => {
                if !MO.isImm() || getShiftType(MO.getImm()) != MSL || (getShiftValue(MO.getImm()) != 8 && getShiftValue(MO.getImm()) != 16) {
                    ErrInfo = "OPERAND_SHIFT_MSL should be msl shift of 8 or 16";
                    return false;
                }
            },
            OPERAND_IMM_UINT1 => {
                if !MO.isImm() || (MO.getImm() != 0 && MO.getImm() != 1) {
                    ErrInfo = "OPERAND_IMM_UINT1 should be 0 or 1";
                    return false;
                }
            },
            OPERAND_IMM_UINT4plus1 => {
                if !MO.isImm() || MO.getImm() <= 0 || MO.getImm() > 16 {
                    ErrInfo = "OPERAND_IMM_UINT4plus1 should be in the range 1 to 16";
                    return false;
                }
            },
            OPERAND_IMM_UINT5 => {
                if !MO.isImm() || !isUInt(MO.getImm()) {
                    ErrInfo = "OPERAND_IMM_UINT5 should be in the range 0 to 31";
                    return false;
                }
            },
            OPERAND_IMM_UINT8 => {
                if !MO.isImm() || !isUInt(MO.getImm()) {
                    ErrInfo = "OPERAND_IMM_UINT8 should be in the range 0 to 255";
                    return false;
                }
            },
            _ => {
                break;
            },
        }
    }
    return true;
}

struct Closure_1 {
    BrOffset: *mut i64,
    MBB: *mut MachineBasicBlock,
    DL: *mut DebugLoc,
    cap_3: *AArch64InstrInfo,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Reg: Register, DestBB: *mut MachineBasicBlock) {
        if !isInt((*self.BrOffset)) {
            report_fatal_error("Branch offsets outside of the signed 33-bit range not supported", true);
        }
        BuildMI((*self.MBB), (*self.MBB).end(), MIMetadata { DL: (*self.DL), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ADRP), Reg).addSym(DestBB.getSymbol(), MO_PAGE);
        BuildMI((*self.MBB), (*self.MBB).end(), MIMetadata { DL: (*self.DL), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ADDXri), Reg).addReg(Reg, RegState {}, 0).addSym(DestBB.getSymbol(), MO_PAGEOFF | MO_NC).addImm(0);
        BuildMI((*self.MBB), (*self.MBB).end(), MIMetadata { DL: (*self.DL), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(BR)).addReg(Reg, RegState {}, 0);
    }

struct Closure_2 {
    MRI: *mut MachineRegisterInfo,
    RI: *mut AArch64RegisterInfo,
}

unsafe fn Closure_2::call(self: *mut Closure_2, Reg: Register) -> auto {
        if Reg.isVirtual() {
            return (*self.MRI).getRegClass(Reg);
        }
        if Reg.isPhysical() {
            return (*self.RI).getMinimalPhysRegClass(Reg.operator MCRegister());
        }
        return null;
    }

struct Closure_3 {
    cap_0: iterator,
}

fn Closure_3::call(self: *Closure_3, MI: *mut MachineInstr) -> bool {
        return MI.getIterator() == From;
    }

struct Closure_4 {}

fn Closure_4::call(self: *Closure_4, MMO: *mut MachineMemOperand) -> Flags {
        return MMO.getFlags() & MOSuppressPair;
    }

struct Closure_5 {}

fn Closure_5::call(self: *Closure_5, MMO: *mut MachineMemOperand) -> Flags {
        return MMO.getFlags() & MOStridedAccess;
    }

struct Closure_6 {}

fn Closure_6::call(self: *mut Closure_6, NumBytes: u32, OldOffset: i64, NewOffset: i64) -> auto {
        let mut MinOffset: i64 = 0;
        let mut MaxOffset: i64 = 0;
        match NumBytes {
            _ => {
                return true;
            },
            4 => {
                MinOffset = -256;
            },
            8 => {
                MinOffset = -512;
            },
            16 => {
                MinOffset = -1024;
            },
        }
        return OldOffset < MinOffset || OldOffset > MaxOffset || (NewOffset >= MinOffset && NewOffset <= MaxOffset);
    }

struct Closure_7 {
    MemI: *mut MachineInstr,
    OffsetScale: *mut i64,
    cap_2: *AArch64InstrInfo,
    NumBytes: *mut u32,
    validateOffsetForLDP: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Target\AArch64\AArch64InstrInfo.cpp:3908:31),
    AM: *mut ExtAddrMode,
    AddrI: *mut MachineInstr,
}

unsafe fn Closure_7::call(self: *mut Closure_7, Disp: i64) -> auto {
        let mut OldOffset: i64 = (*self.MemI).getOperand(2).getImm() * (*self.OffsetScale);
        let mut NewOffset: i64 = OldOffset + Disp;
        if !self.isLegalAddressingMode((*self.NumBytes), NewOffset, 0) {
            return false;
        }
        if !(*self.validateOffsetForLDP).call((*self.NumBytes), OldOffset, NewOffset) {
            return false;
        }
        (*self.AM).BaseReg = (*self.AddrI).getOperand(1).getReg();
        (*self.AM).ScaledReg = 0;
        (*self.AM).Scale = 0;
        (*self.AM).Displacement = NewOffset;
        (*self.AM).Form = Basic;
        return true;
    }

struct Closure_8 {
    MemI: *mut MachineInstr,
    cap_1: *AArch64InstrInfo,
    NumBytes: *mut u32,
    AM: *mut ExtAddrMode,
    AddrI: *mut MachineInstr,
}

unsafe fn Closure_8::call(self: *mut Closure_8, Scale: i64, Form: Formula) -> auto {
        if (*self.MemI).getOperand(2).getImm() != 0 {
            return false;
        }
        if Scale as u32 != Scale {
            return false;
        }
        if !self.isLegalAddressingMode((*self.NumBytes), 0, Scale) {
            return false;
        }
        (*self.AM).BaseReg = (*self.AddrI).getOperand(1).getReg();
        (*self.AM).ScaledReg = (*self.AddrI).getOperand(2).getReg();
        (*self.AM).Scale = Scale;
        (*self.AM).Displacement = 0;
        (*self.AM).Form = Form;
        return true;
    }

struct Closure_9 {
    cap_0: *AArch64InstrInfo,
}

fn Closure_9::call(self: *Closure_9, MemI: *MachineInstr) -> bool {
        let mut Opcode: u32 = MemI.getOpcode();
        return (Opcode == STURQi || Opcode == STRQui) && self.Subtarget.isSTRQroSlow();
    }

struct Closure_10 {
    MI: *mut MachineInstr,
}

unsafe fn Closure_10::call(self: *mut Closure_10, Op: *MachineOperand) -> bool {
        if !Op.isReg() {
            return false;
        }
        let mut Reg: Register = Op.getReg();
        if Reg.isPhysical() {
            return FPR16RegClass.contains(Reg.operator MCRegister());
        }
        let mut TRC: *TargetRegisterClass = getRegClass((*self.MI), Reg);
        return TRC == &mut FPR16RegClass || TRC == &mut FPR16_loRegClass;
    }

struct Closure_11 {
    MI: *mut MachineInstr,
}

unsafe fn Closure_11::call(self: *mut Closure_11, Op: *MachineOperand) -> bool {
        if !Op.isReg() {
            return false;
        }
        let mut Reg: Register = Op.getReg();
        if Reg.isPhysical() {
            return FPR128RegClass.contains(Reg.operator MCRegister());
        }
        let mut TRC: *TargetRegisterClass = getRegClass((*self.MI), Reg);
        return TRC == &mut FPR128RegClass || TRC == &mut FPR128_loRegClass;
    }

struct Closure_12 {
    MI: *mut MachineInstr,
}

unsafe fn Closure_12::call(self: *mut Closure_12, Op: *MachineOperand) -> bool {
        if !Op.isReg() {
            return false;
        }
        let mut Reg: Register = Op.getReg();
        if Reg.isPhysical() {
            return isFpOrNEON(Reg);
        }
        let mut TRC: *TargetRegisterClass = getRegClass((*self.MI), Reg);
        return TRC == &mut FPR128RegClass || TRC == &mut FPR128_loRegClass || TRC == &mut FPR64RegClass || TRC == &mut FPR64_loRegClass || TRC == &mut FPR32RegClass || TRC == &mut FPR16RegClass || TRC == &mut FPR8RegClass;
    }

struct Closure_13 {}

fn Closure_13::call(self: *mut Closure_13, R: MCRegister) -> auto {
            return (R.operator unsigned int() - PN0) + P0;
        }

struct Closure_14 {
    TRI: *TargetRegisterInfo,
}

fn Closure_14::call(self: *Closure_14, I: *MachineInstr) -> bool {
        return I.modifiesRegister(NZCV, self.TRI) || I.readsRegister(NZCV, self.TRI);
    }

struct Closure_15 {
    MRI: *mut MachineRegisterInfo,
    TRI: *mut TargetRegisterInfo,
}

unsafe fn Closure_15::call(self: *mut Closure_15, Reg: u32) -> *TargetRegisterClass {
            return if isVirtualRegister(Reg) { (*self.MRI).getRegClass(Reg) } else { (*self.TRI).getMinimalPhysRegClass(Reg) };
        }

struct Closure_16 {
    MBB: *mut MachineBasicBlock,
    Root: *mut MachineInstr,
    Patterns: *mut SmallVectorImpl<unsigned int>,
    Found: *mut bool,
}

unsafe fn Closure_16::call(self: *mut Closure_16, Opcode: i32, Operand: i32, ZeroReg: u32, Pattern: u32) {
        if canCombineWithMUL((*self.MBB), (*self.Root).getOperand(Operand), Opcode, ZeroReg) {
            (*self.Patterns).push(Pattern);
            (*self.Found) = true;
        }
    }

struct Closure_17 {
    MBB: *mut MachineBasicBlock,
    Root: *mut MachineInstr,
    Patterns: *mut SmallVectorImpl<unsigned int>,
    Found: *mut bool,
}

unsafe fn Closure_17::call(self: *mut Closure_17, Opcode: i32, Operand: i32, Pattern: u32) {
        if canCombine((*self.MBB), (*self.Root).getOperand(Operand), Opcode, 0, false) {
            (*self.Patterns).push(Pattern);
            (*self.Found) = true;
        }
    }

struct Closure_18 {
    MBB: *mut MachineBasicBlock,
    Root: *mut MachineInstr,
    Patterns: *mut SmallVectorImpl<unsigned int>,
}

unsafe fn Closure_18::call(self: *mut Closure_18, Opcode: i32, Operand: i32, Pattern: u32) -> auto {
        if canCombineWithFMUL((*self.MBB), (*self.Root).getOperand(Operand), Opcode) {
            (*self.Patterns).push(Pattern);
            return true;
        }
        return false;
    }

struct Closure_19 {
    MBB: *mut MachineBasicBlock,
    Root: *mut MachineInstr,
    Patterns: *mut SmallVectorImpl<unsigned int>,
}

unsafe fn Closure_19::call(self: *mut Closure_19, Opcode: u32, Operand: i32, Pattern: u32) -> auto {
        let mut MRI: *mut MachineRegisterInfo = (*self.MBB).getParent().getRegInfo();
        let mut MO: *mut MachineOperand = (*self.Root).getOperand(Operand);
        let mut MI: *mut MachineInstr = null;
        if MO.isReg() && MO.getReg().isVirtual() {
            MI = MRI.getUniqueVRegDef(MO.getReg());
        }
        if MI && MI.getOpcode() == COPY && MI.getOperand(1).getReg().isVirtual() {
            MI = MRI.getUniqueVRegDef(MI.getOperand(1).getReg());
        }
        if MI && MI.getOpcode() == Opcode {
            (*self.Patterns).push(Pattern);
            return true;
        }
        return false;
    }

