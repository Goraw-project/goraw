        LD1Fourv16b_POST => {
            LD1Fourv1d_POST;
        },
    }
}

fn AArch64InstrInfo::getMemOperandWithOffsetWidth(self: *AArch64InstrInfo, LdSt: *MachineInstr, BaseOp: **mut MachineOperand, Offset: *mut i64, OffsetIsScalable: *mut bool, Width: *mut TypeSize, TRI: *TargetRegisterInfo) -> bool {
    assert!(LdSt.mayLoadOrStore(AnyInBundle), "Expected a memory operation.");
    if LdSt.getNumExplicitOperands() == 3 {
        if (!LdSt.getOperand(1).isReg() && !LdSt.getOperand(1).isFI()) || !LdSt.getOperand(2).isImm() {
            return false;
        }
    } else if LdSt.getNumExplicitOperands() == 4 {
        if !LdSt.getOperand(1).isReg() || (!LdSt.getOperand(2).isReg() && !LdSt.getOperand(2).isFI()) || !LdSt.getOperand(3).isImm() {
            return false;
        }
    } else {
        return false;
    }
    let mut Scale: TypeSize = TypeSize { 0, false };
    let mut Dummy1: i64 = 0;
    let mut Dummy2: i64 = 0;
    if !getMemOpInfo(LdSt.getOpcode(), Scale, Width, Dummy1, Dummy2) {
        return false;
    }
    if isPostIndexLdStOpcode(LdSt.getOpcode()) {
        BaseOp = &mut LdSt.getOperand(2);
        Offset = 0;
    } else if LdSt.getNumExplicitOperands() == 3 {
        BaseOp = &mut LdSt.getOperand(1);
        Offset = LdSt.getOperand(2).getImm() * Scale.getKnownMinValue();
    } else {
        assert!(LdSt.getNumExplicitOperands() == 4, "invalid number of operands");
        BaseOp = &mut LdSt.getOperand(2);
        Offset = LdSt.getOperand(3).getImm() * Scale.getKnownMinValue();
    }
    OffsetIsScalable = Scale.isScalable();
    return BaseOp.isReg() || BaseOp.isFI();
}

fn AArch64InstrInfo::getMemOpBaseRegImmOfsOffsetOperand(self: *AArch64InstrInfo, LdSt: *mut MachineInstr) -> *mut MachineOperand {
    assert!(LdSt.mayLoadOrStore(AnyInBundle), "Expected a memory operation.");
    let mut OfsOp: *mut MachineOperand = LdSt.getOperand(LdSt.getNumExplicitOperands() - 1);
    assert!(OfsOp.isImm(), "Offset operand wasn't immediate.");
    return OfsOp;
}

fn AArch64InstrInfo::getMemOpInfo(self, Opcode: u32, Scale: *mut TypeSize, Width: *mut TypeSize, MinOffset: *mut i64, MaxOffset: *mut i64) -> bool {
    match Opcode {
        _ => {
            Scale = Width = getFixed(0);
        },
        LDRQui => {
            STRQui;
        },
        LDRXui => {
            LDRDui;
        },
        LDRWui => {
            LDRSui;
        },
        LDRHui => {
            LDRHHui;
        },
        LDRBui => {
            LDRBBui;
        },
        STRQpre => {
            LDRQpost;
        },
        LDRDpost => {
            LDRDpre;
        },
        STRWpost => {
            STRWpre;
        },
        LDRHpost => {
            LDRHpre;
        },
        LDRBpost => {
            LDRBpre;
        },
        LDURQi => {
            STURQi;
        },
        LDURXi => {
            LDURDi;
        },
        LDURWi => {
            LDURSi;
        },
        LDURHi => {
            LDURHHi;
        },
        LDURBi => {
            LDURBBi;
        },
        LDPQi => {
            LDNPQi;
        },
        LDPXi => {
            LDPDi;
        },
        LDPWi => {
            LDPSi;
        },
        StoreSwiftAsyncContext => {
            Scale = getFixed(1);
        },
        ADDG => {
            Scale = getFixed(16);
        },
        TAGPstack => {
            Scale = getFixed(16);
        },
        LDG => {
            STGi;
        },
        STR_ZZZZXI => {
            STR_ZZZZXI_STRIDED_CONTIGUOUS;
        },
        STR_ZZZXI => {
            LDR_ZZZXI;
        },
        STR_ZZXI => {
            STR_ZZXI_STRIDED_CONTIGUOUS;
        },
        LDR_PXI => {
            STR_PXI;
        },
        LDR_PPXI => {
            STR_PPXI;
        },
        LDR_ZXI => {
            STR_ZXI;
        },
        LD1B_IMM => {
            LD1H_IMM;
        },
        LD2B_IMM => {
            LD2H_IMM;
        },
        LD3B_IMM => {
            LD3H_IMM;
        },
        LD4B_IMM => {
            LD4H_IMM;
        },
        LD1B_H_IMM => {
            LD1SB_H_IMM;
        },
        LD1B_S_IMM => {
            LD1SB_S_IMM;
        },
        LD1B_D_IMM => {
            LD1SB_D_IMM;
        },
        ST2Gi => {
            ST2GPreIndex;
        },
        STGPi => {
            STGPpost;
        },
        LD1RB_IMM => {
            LD1RB_H_IMM;
        },
        LD1RH_IMM => {
            LD1RH_S_IMM;
        },
        LD1RW_IMM => {
            LD1RW_D_IMM;
        },
        LD1RD_IMM => {
            Scale = Width = getFixed(8);
        },
    }
    return true;
}

fn AArch64InstrInfo::getMemScale(self, Opc: u32) -> i32 {
    match Opc {
        _ => {
            llvm_unreachable_internal("Opcode has unknown scale!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 5340);
        },
        LDRBui => {
            LDRBBui;
        },
        LDRHui => {
            LDRHHui;
        },
        LDRSui => {
            LDURSi;
        },
        LDRDui => {
            LDURDi;
        },
        LDRQui => {
            LDURQi;
        },
    }
}

fn AArch64InstrInfo::isPreLd(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        LDRWpre => {
            LDRXpre;
        },
    }
}

fn AArch64InstrInfo::isPreSt(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        STRWpre => {
            STRXpre;
        },
    }
}

fn AArch64InstrInfo::isPreLdSt(self, MI: *MachineInstr) -> bool {
    return isPreLd(MI) || isPreSt(MI);
}

fn AArch64InstrInfo::isZExtLoad(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        LDURBBi => {
            LDURHHi;
        },
    }
}

fn AArch64InstrInfo::isSExtLoad(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        LDURSBWi => {
            LDURSHWi;
        },
    }
}

fn AArch64InstrInfo::isPairedLdSt(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        LDPSi => {
            LDPSWi;
        },
    }
}

fn AArch64InstrInfo::getLdStBaseOp(self, MI: *MachineInstr) -> *MachineOperand {
    assert!(MI.mayLoadOrStore(AnyInBundle), "Load or store instruction expected");
    let mut Idx: u32 = if isPairedLdSt(MI) || isPreLdSt(MI) { 2 } else { 1 };
    return MI.getOperand(Idx);
}

fn AArch64InstrInfo::getLdStOffsetOp(self, MI: *MachineInstr) -> *MachineOperand {
    assert!(MI.mayLoadOrStore(AnyInBundle), "Load or store instruction expected");
    let mut Idx: u32 = if isPairedLdSt(MI) || isPreLdSt(MI) { 3 } else { 2 };
    return MI.getOperand(Idx);
}

fn AArch64InstrInfo::getLdStAmountOp(self, MI: *MachineInstr) -> *MachineOperand {
    match MI.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64InstrInfo.cpp", 5534);
        },
        LDRBroX => {
            LDRBBroX;
        },
    }
}

fn getRegClass(MI: *MachineInstr, Reg: Register) -> *TargetRegisterClass {
    if MI.getParent() == null {
        return null;
    }
    let mut MF: *MachineFunction = MI.getParent().getParent();
    return if MF { MF.getRegInfo().getRegClassOrNull(Reg) } else { null };
}

fn AArch64InstrInfo::isHForm(self, MI: *MachineInstr) -> bool {
    let mut IsHFPR: Closure_10 = Closure_10 { MI: &mut MI };
    return any_of(MI.operands(), IsHFPR);
}

fn AArch64InstrInfo::isQForm(self, MI: *MachineInstr) -> bool {
    let mut IsQFPR: Closure_11 = Closure_11 { MI: &mut MI };
    return any_of(MI.operands(), IsQFPR);
}

fn AArch64InstrInfo::hasBTISemantics(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        BRK => {
            HLT;
        },
        PAUTH_PROLOGUE => {
            return true;
        },
        HINT => {
            let mut Imm: u32 = MI.getOperand(0).getImm();
            if Imm == 32 || Imm == 34 || Imm == 36 || Imm == 38 {
                return true;
            }
            if Imm == 25 || Imm == 27 {
                return true;
            }
            return false;
        },
        _ => {
            return false;
        },
    }
}

fn AArch64InstrInfo::isFpOrNEON(self, Reg: Register) -> bool {
    if Reg == 0 {
        return false;
    }
    assert!(Reg.isPhysical(), "Expected physical register in isFpOrNEON");
    return FPR128RegClass.contains(Reg.operator MCRegister()) || FPR64RegClass.contains(Reg.operator MCRegister()) || FPR32RegClass.contains(Reg.operator MCRegister()) || FPR16RegClass.contains(Reg.operator MCRegister()) || FPR8RegClass.contains(Reg.operator MCRegister());
}

fn AArch64InstrInfo::isFpOrNEON(self, MI: *MachineInstr) -> bool {
    let mut IsFPR: Closure_12 = Closure_12 { MI: &mut MI };
    return any_of(MI.operands(), IsFPR);
}

fn scaleOffset(Opc: u32, Offset: *mut i64) -> bool {
    let mut Scale: i32 = getMemScale(Opc);
    if Offset % Scale != 0 {
        return false;
    }
    Offset /= Scale;
    return true;
}

fn canPairLdStOpc(FirstOpc: u32, SecondOpc: u32) -> bool {
    if FirstOpc == SecondOpc {
        return true;
    }
    match FirstOpc {
        _ => {
            return false;
        },
        STRSui => {
            STURSi;
        },
        STRDui => {
            STURDi;
        },
        STRQui => {
            STURQi;
        },
        STRWui => {
            STURWi;
        },
        STRXui => {
            STURXi;
        },
        LDRSui => {
            LDURSi;
        },
        LDRDui => {
            LDURDi;
        },
        LDRQui => {
            LDURQi;
        },
        LDRWui => {
            LDURWi;
        },
        LDRSWui => {
            LDURSWi;
        },
        LDRXui => {
            LDURXi;
        },
    }
    return false;
}

fn shouldClusterFI(MFI: *MachineFrameInfo, FI1: i32, Offset1: i64, Opcode1: u32, FI2: i32, Offset2: i64, Opcode2: u32) -> bool {
    if MFI.isFixedObjectIndex(FI1) && MFI.isFixedObjectIndex(FI2) {
        let mut ObjectOffset1: i64 = MFI.getObjectOffset(FI1);
        let mut ObjectOffset2: i64 = MFI.getObjectOffset(FI2);
        assert!(ObjectOffset1 <= ObjectOffset2, "Object offsets are not ordered.");
        let mut Scale1: i32 = getMemScale(Opcode1);
        if ObjectOffset1 % Scale1 != 0 {
            return false;
        }
        ObjectOffset1 /= Scale1;
        let mut Scale2: i32 = getMemScale(Opcode2);
        if ObjectOffset2 % Scale2 != 0 {
            return false;
        }
        ObjectOffset2 /= Scale2;
        ObjectOffset1 += Offset1;
        ObjectOffset2 += Offset2;
        return ObjectOffset1 + 1 == ObjectOffset2;
    }
    return FI1 == FI2;
}

fn AArch64InstrInfo::shouldClusterMemOps(self: *AArch64InstrInfo, BaseOps1: ArrayRef<const MachineOperand *>, OpOffset1: i64, OffsetIsScalable1: bool, BaseOps2: ArrayRef<const MachineOperand *>, OpOffset2: i64, OffsetIsScalable2: bool, ClusterSize: u32, NumBytes: u32) -> bool {
    assert!(BaseOps1.len == 1 && BaseOps2.len == 1);
    let mut BaseOp1: *MachineOperand = *BaseOps1.front();
    let mut BaseOp2: *MachineOperand = *BaseOps2.front();
    let mut FirstLdSt: *MachineInstr = *BaseOp1.getParent();
    let mut SecondLdSt: *MachineInstr = *BaseOp2.getParent();
    if BaseOp1.getType() != BaseOp2.getType() {
        return false;
    }
    assert!((BaseOp1.isReg() || BaseOp1.isFI()), "Only base registers and frame indices are supported.");
    if BaseOp1.isReg() && BaseOp1.getReg() != BaseOp2.getReg() {
        return false;
    }
    if ClusterSize > 2 {
        return false;
    }
    if !isPairableLdStInst(FirstLdSt) || !isPairableLdStInst(SecondLdSt) {
        return false;
    }
    let mut FirstOpc: u32 = FirstLdSt.getOpcode();
    let mut SecondOpc: u32 = SecondLdSt.getOpcode();
    if !canPairLdStOpc(FirstOpc, SecondOpc) {
        return false;
    }
    if !self.isCandidateToMergeOrPair(FirstLdSt) || !self.isCandidateToMergeOrPair(SecondLdSt) {
        return false;
    }
    let mut Offset1: i64 = FirstLdSt.getOperand(2).getImm();
    if hasUnscaledLdStOffset(FirstOpc) && !scaleOffset(FirstOpc, Offset1) {
        return false;
    }
    let mut Offset2: i64 = SecondLdSt.getOperand(2).getImm();
    if hasUnscaledLdStOffset(SecondOpc) && !scaleOffset(SecondOpc, Offset2) {
        return false;
    }
    if Offset1 > 63 || Offset1 < -64 {
        return false;
    }
    if BaseOp1.isFI() {
        assert!((!BaseOp1.isIdenticalTo(BaseOp2) || Offset1 <= Offset2), "Caller should have ordered offsets.");
        let mut MFI: *MachineFrameInfo = FirstLdSt.getParent().getParent().getFrameInfo();
        return shouldClusterFI(MFI, BaseOp1.getIndex(), Offset1, FirstOpc, BaseOp2.getIndex(), Offset2, SecondOpc);
    }
    assert!(Offset1 <= Offset2, "Caller should have ordered offsets.");
    return Offset1 + 1 == Offset2;
}

fn AddSubReg(MIB: *MachineInstrBuilder, Reg: MCRegister, SubIdx: u32, State: RegState, TRI: *TargetRegisterInfo) -> *MachineInstrBuilder {
    if !SubIdx {
        return MIB.addReg(Reg, State, 0);
    }
    if Reg.isPhysical() {
        return MIB.addReg(TRI.getSubReg(Reg, SubIdx), State, 0);
    }
    return MIB.addReg(Reg, State, SubIdx);
}

fn AArch64InstrInfo::copyPhysRegTuple(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, I: iterator, DL: *DebugLoc, DestReg: MCRegister, SrcReg: MCRegister, KillSrc: bool, Indices: ArrayRef<unsigned int>) {
    assert!(self.Subtarget.hasNEON(), "Unexpected register copy without NEON");
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    let mut DestEncoding: u16 = TRI.getEncodingValue(DestReg);
    let mut SrcEncoding: u16 = TRI.getEncodingValue(SrcReg);
    let mut NumRegs: u32 = Indices.len;
    let mut DestSubReg: MCRegister = TRI.getSubReg(DestReg, Indices[0]);
    assert!(!PNRRegClass.contains(DestSubReg), "Unexpected predicate tuple copy");
    let mut MaxRegs: u32 = if PPRRegClass.contains(DestSubReg) { 15 } else { 31 };
    let mut SubReg: i32 = 0;
    let mut End: i32 = NumRegs;
    let mut Incr: i32 = 1;
    if ((DestEncoding - SrcEncoding) & MaxRegs) < NumRegs {
        SubReg = NumRegs - 1;
        End = -1;
        Incr = -1;
    }
    for ; SubReg != End; SubReg += Incr {
        DestSubReg = TRI.getSubReg(DestReg, Indices[SubReg]);
        let mut SrcSubReg: MCRegister = TRI.getSubReg(SrcReg, Indices[SubReg]);
        self.copyPhysRegImpl(MBB, I, DL, DestSubReg, SrcSubReg, KillSrc, false, false);
    }
}

fn AArch64InstrInfo::copyGPRRegTuple(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, I: iterator, DL: *DebugLoc, DestReg: MCRegister, SrcReg: MCRegister, KillSrc: bool, Opcode: u32, ZeroReg: u32, Indices: ArrayRef<unsigned int>) {
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    let mut NumRegs: u32 = Indices.len;
    let mut DestEncoding: u16 = TRI.getEncodingValue(DestReg);
    let mut SrcEncoding: u16 = TRI.getEncodingValue(SrcReg);
    assert!(DestEncoding % NumRegs == 0 && SrcEncoding % NumRegs == 0, "GPR reg sequences should not be able to overlap");
    for let mut SubReg: u32 = 0; SubReg != NumRegs; SubReg += 1 {
        let mut MIB: MachineInstrBuilder = BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(Opcode));
        AddSubReg(MIB, DestReg, Indices[SubReg], Define, TRI);
        MIB.addReg(ZeroReg, RegState {}, 0);
        AddSubReg(MIB, SrcReg, Indices[SubReg], getKillRegState(KillSrc), TRI);
        MIB.addImm(0);
    }
}

fn isInStreamingCallSiteRegion(MBB: *mut MachineBasicBlock, I: iterator) -> bool {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    if !AFI.hasStreamingModeChanges() {
        return false;
    }
    for MI in reverse(make_range(MBB.begin(), I)) {
        let mut Opc: u32 = MI.getOpcode();
        if Opc == MSRpstatesvcrImm1 || Opc == MSRpstatePseudo {
            let mut PState: i64 = MI.getOperand(0).getImm();
            if PState == SVCRSM || PState == SVCRSMZA {
                return MI.getOperand(1).getImm() == 1;
            }
        }
    }
    return false;
}

fn mustAvoidNeonAtMBBI(Subtarget: *AArch64Subtarget, MBB: *mut MachineBasicBlock, I: iterator) -> bool {
    return !Subtarget.hasSMEFA64() && isInStreamingCallSiteRegion(MBB, I);
}

fn AArch64InstrInfo::copyPhysRegImpl(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, I: iterator, DL: *DebugLoc, DestReg: Register, SrcReg: Register, KillSrc: bool, RenamableDest: bool, RenamableSrc: bool) {
    if GPR32spRegClass.contains(DestReg.operator MCRegister()) && GPR32spRegClass.contains(SrcReg.operator MCRegister()) {
        if DestReg == WSP || SrcReg == WSP {
            if self.Subtarget.hasZeroCycleRegMoveGPR64() && !self.Subtarget.hasZeroCycleRegMoveGPR32() {
                let mut DestRegX: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), sub_32, &mut GPR64spRegClass);
                let mut SrcRegX: MCRegister = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), sub_32, &mut GPR64spRegClass);
                BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ADDXri), DestRegX).addReg(SrcRegX, Undef, 0).addImm(0).addImm(getShifterImm(LSL, 0)).addReg(SrcReg, Implicit | getKillRegState(KillSrc), 0);
                operator(NumZCRegMoveInstrsGPR);
            } else {
                BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ADDWri), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0).addImm(0).addImm(getShifterImm(LSL, 0));
                if self.Subtarget.hasZeroCycleRegMoveGPR32() {
                    operator(NumZCRegMoveInstrsGPR);
                }
            }
        } else if self.Subtarget.hasZeroCycleRegMoveGPR64() && !self.Subtarget.hasZeroCycleRegMoveGPR32() {
            let mut DestRegX: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), sub_32, &mut GPR64spRegClass);
            assert!(DestRegX.isValid(), "Destination super-reg not valid");
            let mut SrcRegX: MCRegister = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), sub_32, &mut GPR64spRegClass);
            assert!(SrcRegX.isValid(), "Source super-reg not valid");
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRXrr), DestRegX).addReg(XZR, RegState {}, 0).addReg(SrcRegX, Undef, 0).addReg(SrcReg, Implicit | getKillRegState(KillSrc), 0);
            operator(NumZCRegMoveInstrsGPR);
        } else {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRWrr), DestReg).addReg(WZR, RegState {}, 0).addReg(SrcReg, getKillRegState(KillSrc), 0);
            if self.Subtarget.hasZeroCycleRegMoveGPR32() {
                operator(NumZCRegMoveInstrsGPR);
            }
        }
        return;
    }
    if GPR32spRegClass.contains(DestReg.operator MCRegister()) && SrcReg == WZR {
        if self.Subtarget.hasZeroCycleZeroingGPR64() && !self.Subtarget.hasZeroCycleZeroingGPR32() {
            let mut DestRegX: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), sub_32, &mut GPR64spRegClass);
            assert!(DestRegX.isValid(), "Destination super-reg not valid");
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOVZXi), DestRegX).addImm(0).addImm(getShifterImm(LSL, 0));
            operator(NumZCZeroingInstrsGPR);
        } else if self.Subtarget.hasZeroCycleZeroingGPR32() {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOVZWi), DestReg).addImm(0).addImm(getShifterImm(LSL, 0));
            operator(NumZCZeroingInstrsGPR);
        } else {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRWrr), DestReg).addReg(WZR, RegState {}, 0).addReg(WZR, RegState {}, 0);
        }
        return;
    }
    if GPR64spRegClass.contains(DestReg.operator MCRegister()) && GPR64spRegClass.contains(SrcReg.operator MCRegister()) {
        if DestReg == SP || SrcReg == SP {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ADDXri), DestReg).addReg(SrcReg, getKillRegState(KillSrc), 0).addImm(0).addImm(getShifterImm(LSL, 0));
            if self.Subtarget.hasZeroCycleRegMoveGPR64() {
                operator(NumZCRegMoveInstrsGPR);
            }
        } else {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRXrr), DestReg).addReg(XZR, RegState {}, 0).addReg(SrcReg, getKillRegState(KillSrc), 0);
            if self.Subtarget.hasZeroCycleRegMoveGPR64() {
                operator(NumZCRegMoveInstrsGPR);
            }
        }
        return;
    }
    if GPR64spRegClass.contains(DestReg.operator MCRegister()) && SrcReg == XZR {
        if self.Subtarget.hasZeroCycleZeroingGPR64() {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(MOVZXi), DestReg).addImm(0).addImm(getShifterImm(LSL, 0));
            operator(NumZCZeroingInstrsGPR);
        } else {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRXrr), DestReg).addReg(XZR, RegState {}, 0).addReg(XZR, RegState {}, 0);
        }
        return;
    }
    if PPRRegClass.contains(DestReg.operator MCRegister()) && PPRRegClass.contains(SrcReg.operator MCRegister()) {
        assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected SVE register.");
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORR_PPzPP), DestReg).addReg(SrcReg, RegState {}, 0).addReg(SrcReg, RegState {}, 0).addReg(SrcReg, getKillRegState(KillSrc), 0);
        return;
    }
    let mut DestIsPNR: bool = PNRRegClass.contains(DestReg.operator MCRegister());
    let mut SrcIsPNR: bool = PNRRegClass.contains(SrcReg.operator MCRegister());
    if DestIsPNR || SrcIsPNR {
        let mut ToPPR: Closure_13 = Closure_13 {};
        let mut PPRSrcReg: MCRegister = if SrcIsPNR { ToPPR.call(SrcReg.operator MCRegister()) } else { SrcReg.asMCReg() };
        let mut PPRDestReg: MCRegister = if DestIsPNR { ToPPR.call(DestReg.operator MCRegister()) } else { DestReg.asMCReg() };
        if PPRSrcReg != PPRDestReg {
            let mut NewMI: MachineInstrBuilder = BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORR_PPzPP), PPRDestReg).addReg(PPRSrcReg, RegState {}, 0).addReg(PPRSrcReg, RegState {}, 0).addReg(PPRSrcReg, getKillRegState(KillSrc), 0);
            if DestIsPNR {
                NewMI.addDef(DestReg, Implicit, 0);
