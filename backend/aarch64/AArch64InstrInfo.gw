fn AArch64InstrInfo::instantiateCondBranch(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, DL: *DebugLoc, TBB: *mut MachineBasicBlock, Cond: ArrayRef<MachineOperand>) {
    if Cond()[0]() != -1 {
        BuildMI(&mut MBB, DL, get())([0]())(TBB);
    } else {
        let mut MIB: MachineInstrBuilder = BuildMI(&mut MBB, DL, get([1]()))([2]);
        if Cond()() > 3 {
            MIB()([3]);
        }
        if Cond()() > 4 {
            MIB()([4]);
        }
        MIB()(TBB);
        if Cond()() > 5 {
            MIB()([5]());
            MIB()([6]());
        }
    }
}

fn AArch64InstrInfo::insertBranch(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, TBB: *mut MachineBasicBlock, FBB: *mut MachineBasicBlock, Cond: ArrayRef<MachineOperand>, DL: *DebugLoc, BytesAdded: *mut i32) -> u32 {
    assert!(TBB, "insertBranch must not be told to insert a fallthrough");
    if !FBB {
        if Cond()() {
            BuildMI(&mut MBB, DL, get())(TBB);
        } else {
            self.instantiateCondBranch(MBB, DL, TBB);
        }
        if BytesAdded {
            *BytesAdded = 4;
        }
        return 1;
    }
    self.instantiateCondBranch(MBB, DL, TBB);
    BuildMI(&mut MBB, DL, get())(FBB);
    if BytesAdded {
        *BytesAdded = 8;
    }
    return 2;
}

fn isValidCBExtend(Opc: i64, Ext: ShiftExtendType) -> bool {
    match Ext {
        _ => {
            return false;
        },
        UXTB => {
            SXTB;
        },
        UXTH => {
            SXTH;
        },
    }
}

fn AArch64InstrInfo::insertCmpForCondBr(self: *AArch64InstrInfo, MBB: *mut MachineBasicBlock, MI: i32, DL: *DebugLoc, Cond: ArrayRef<MachineOperand>) -> CondCode {
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut CC: CondCode = zeroed();
    match Cond()() {
        _ => {
            llvm_unreachable_internal("Unknown condition opcode in Cond", "llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", 895);
        },
        1 => {
            CC = [0]();
