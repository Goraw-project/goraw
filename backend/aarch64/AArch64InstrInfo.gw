    (((operator!(operator!((any_of(() += 1, ()(), Closure_3 {}))))) || (_wassert(L"std::any_of( ++To.getReverse(), To->getParent()->rend(), [From](MachineInstr &MI) { return MI.getIterator() == From; })", L"llvm\\lib\\Target\\AArch64\\AArch64InstrInfo.cpp", (1882) as u32) , 0)) as void);
    return false;
}

fn AArch64InstrInfo::canRemovePTestInstr(self: *AArch64InstrInfo, PTest: *mut MachineInstr, Mask: *mut MachineInstr, Pred: *mut MachineInstr, MRI: *MachineRegisterInfo) -> optional<unsigned int> {
    let mut MaskOpcode: u32 = Mask.getOpcode();
    let mut PredOpcode: u32 = Pred.getOpcode();
    let mut PredIsPTestLike: bool = self.isPTestLikeOpcode(PredOpcode);
    let mut PredIsWhileLike: bool = self.isWhileOpcode(PredOpcode);
    if PredIsWhileLike {
        if  {
            return PredOpcode;
        }
        if isPTrueOpcode(MaskOpcode) && Mask.getOperand(1).getImm() == 31 && self.getElementSizeForOpcode(MaskOpcode) == self.getElementSizeForOpcode(PredOpcode) {
            return PredOpcode;
        }
        if  {
            return PredOpcode;
        }
        return void {};
    }
    if PredIsPTestLike {
        if  {
            return PredOpcode;
        }
        let mut PTestLikeMask: *mut MachineInstr = MRI.getUniqueVRegDef(Pred.getOperand(1).getReg());
        if Mask != PTestLikeMask && PTestLikeMask.isFullCopy() && PTestLikeMask.getOperand(1).getReg().isVirtual() {
            PTestLikeMask = MRI.getUniqueVRegDef(PTestLikeMask.getOperand(1).getReg());
        }
        if isPTrueOpcode(MaskOpcode) && Mask.getOperand(1).getImm() == 31 && self.getElementSizeForOpcode(MaskOpcode) == self.getElementSizeForOpcode(PredOpcode) {
            if  {
                return PredOpcode;
            }
        }
        let mut PredElementSize: u64 = self.getElementSizeForOpcode(PredOpcode);
        if  {
            return PredOpcode;
        }
        return void {};
    }
    match PredOpcode {
        _ => {
            return void {};
        },
    }
    return convertToFlagSettingOpc(PredOpcode);
}

fn AArch64InstrInfo::optimizePTestInstr(self: *AArch64InstrInfo, PTest: *mut MachineInstr, MaskReg: u32, PredReg: u32, MRI: *MachineRegisterInfo) -> bool {
    let mut Mask: *mut MachineInstr = MRI.getUniqueVRegDef(MaskReg);
    let mut Pred: *mut MachineInstr = MRI.getUniqueVRegDef(PredReg);
    if  {
        let mut Op: MachineOperand = Pred.getOperand(1);
        if  {
            Pred = MRI.getUniqueVRegDef(Op.getReg());
        }
    }
    let mut PredOpcode: u32 = Pred.getOpcode();
    let mut NewOp: auto = zeroed();
    if operator!() {
        return false;
    }
    let mut TRI: *TargetRegisterInfo = &mut self.getRegisterInfo();
    if areCFlagsAccessedBetweenInstrs(Pred, PTest, TRI) {
        return false;
    }
    PTest()();
    if operator*() != PredOpcode {
        Pred.setDesc(get(operator*()));
        let mut succeeded: bool = UpdateOperandRegClass(*Pred);
        succeeded as void;
        assert!(succeeded, "Operands have incompatible register classes!");
        Pred.addRegisterDefined;
    }
    if Pred.registerDefIsDead {
        let mut i: u32 = 0;
        let mut e: u32 = Pred.getNumOperands();
        for ; i != e; i += 1 {
            let mut MO: *mut MachineOperand = Pred.getOperand(i);
            if  {
                MO.setIsDead(false);
                break;
            }
        }
    }
    return true;
}

fn AArch64InstrInfo::optimizeCompareInstr(self: *AArch64InstrInfo, CmpInstr: *mut MachineInstr, SrcReg: Register, SrcReg2: Register, CmpMask: i64, CmpValue: i64, MRI: *MachineRegisterInfo) -> bool {
    assert!(CmpInstr.getParent();
    assert!(MRI);
    let mut DeadNZCVIdx: i32 = CmpInstr.findRegisterDefOperandIdx;
    if DeadNZCVIdx != -1 {
        if CmpInstr.definesRegister || CmpInstr.definesRegister {
            CmpInstr()();
            return true;
        }
        let mut Opc: u32 = CmpInstr.getOpcode();
        let mut NewOpc: u32 = convertToNonFlagSettingOpc(CmpInstr);
        if NewOpc == Opc {
            return false;
        }
        let mut MCID: *MCInstrDesc = get(NewOpc);
        CmpInstr.setDesc(MCID);
        CmpInstr.removeOperand(DeadNZCVIdx);
        let mut succeeded: bool = UpdateOperandRegClass(CmpInstr);
        succeeded as void;
        assert!(succeeded, "Some operands reg class are incompatible!");
        return true;
    }
    if  {
        return self.optimizePTestInstr(&mut CmpInstr, SrcReg.operator unsigned int(), SrcReg2.operator unsigned int(), MRI);
    }
    if SrcReg2 != 0 {
        return false;
    }
    if !MRI.use_nodbg_empty(CmpInstr.getOperand(0).getReg()) {
        return false;
    }
    if CmpValue == 0 && self.substituteCmpToZero(CmpInstr, SrcReg.operator unsigned int(), *MRI) {
        return true;
    }
    return (CmpValue == 0 || CmpValue == 1) && self.removeCmpToZeroOrOne(CmpInstr, SrcReg.operator unsigned int(), CmpValue, *MRI);
}

