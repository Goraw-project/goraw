    }
    if ZPRRegClass.contains(DestReg.operator MCRegister()) && ZPRRegClass.contains(SrcReg.operator MCRegister()) {
        assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected SVE register.");
        BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORR_ZZZ), DestReg).addReg(SrcReg, RegState {}, 0).addReg(SrcReg, getKillRegState(KillSrc), 0);
        return;
    }
    if (ZPR2RegClass.contains(DestReg.operator MCRegister()) || ZPR2StridedOrContiguousRegClass.contains(DestReg.operator MCRegister())) && (ZPR2RegClass.contains(SrcReg.operator MCRegister()) || ZPR2StridedOrContiguousRegClass.contains(SrcReg.operator MCRegister())) {
        assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected SVE register.");
        let mut Indices: [2]u32 = [zsub0, zsub1];
        self.copyPhysRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, Indices);
        return;
    }
    if ZPR3RegClass.contains(DestReg.operator MCRegister()) && ZPR3RegClass.contains(SrcReg.operator MCRegister()) {
        assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected SVE register.");
        let mut Indices: [3]u32 = [zsub0, zsub1, zsub2];
        self.copyPhysRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, Indices);
        return;
    }
    if (ZPR4RegClass.contains(DestReg.operator MCRegister()) || ZPR4StridedOrContiguousRegClass.contains(DestReg.operator MCRegister())) && (ZPR4RegClass.contains(SrcReg.operator MCRegister()) || ZPR4StridedOrContiguousRegClass.contains(SrcReg.operator MCRegister())) {
        assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Unexpected SVE register.");
        let mut Indices: [4]u32 = [zsub0, zsub1, zsub2, zsub3];
        self.copyPhysRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, Indices);
        return;
    }
    if DDDDRegClass.contains(DestReg.operator MCRegister()) && DDDDRegClass.contains(SrcReg.operator MCRegister()) {
        let mut Indices: [4]u32 = [dsub0, dsub1, dsub2, dsub3];
        self.copyPhysRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, Indices);
        return;
    }
    if DDDRegClass.contains(DestReg.operator MCRegister()) && DDDRegClass.contains(SrcReg.operator MCRegister()) {
        let mut Indices: [3]u32 = [dsub0, dsub1, dsub2];
        self.copyPhysRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, Indices);
        return;
    }
    if DDRegClass.contains(DestReg.operator MCRegister()) && DDRegClass.contains(SrcReg.operator MCRegister()) {
        let mut Indices: [2]u32 = [dsub0, dsub1];
        self.copyPhysRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, Indices);
        return;
    }
    if QQQQRegClass.contains(DestReg.operator MCRegister()) && QQQQRegClass.contains(SrcReg.operator MCRegister()) {
        let mut Indices: [4]u32 = [qsub0, qsub1, qsub2, qsub3];
        self.copyPhysRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, Indices);
        return;
    }
    if QQQRegClass.contains(DestReg.operator MCRegister()) && QQQRegClass.contains(SrcReg.operator MCRegister()) {
        let mut Indices: [3]u32 = [qsub0, qsub1, qsub2];
        self.copyPhysRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, Indices);
        return;
    }
    if QQRegClass.contains(DestReg.operator MCRegister()) && QQRegClass.contains(SrcReg.operator MCRegister()) {
        let mut Indices: [2]u32 = [qsub0, qsub1];
        self.copyPhysRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, Indices);
        return;
    }
    if XSeqPairsClassRegClass.contains(DestReg.operator MCRegister()) && XSeqPairsClassRegClass.contains(SrcReg.operator MCRegister()) {
        let mut Indices: [2]u32 = [sube64, subo64];
        self.copyGPRRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, ORRXrs, XZR, Indices);
        return;
    }
    if WSeqPairsClassRegClass.contains(DestReg.operator MCRegister()) && WSeqPairsClassRegClass.contains(SrcReg.operator MCRegister()) {
        let mut Indices: [2]u32 = [sube32, subo32];
        self.copyGPRRegTuple(MBB, I, DL, DestReg.operator MCRegister(), SrcReg.operator MCRegister(), KillSrc, ORRWrs, WZR, Indices);
        return;
    }
    if FPR128RegClass.contains(DestReg.operator MCRegister()) && FPR128RegClass.contains(SrcReg.operator MCRegister()) {
        if (self.Subtarget.isSVEorStreamingSVEAvailable() && !self.Subtarget.isNeonAvailable()) || mustAvoidNeonAtMBBI(self.Subtarget, MBB, I) {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORR_ZZZ)).addReg(Z0 + (DestReg.operator unsigned int() - Q0), Define, 0).addReg(Z0 + (SrcReg.operator unsigned int() - Q0), RegState {}, 0).addReg(Z0 + (SrcReg.operator unsigned int() - Q0), RegState {}, 0);
        } else if self.Subtarget.isNeonAvailable() {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRv16i8), DestReg).addReg(SrcReg, RegState {}, 0).addReg(SrcReg, getKillRegState(KillSrc), 0);
            if self.Subtarget.hasZeroCycleRegMoveFPR128() {
                operator(NumZCRegMoveInstrsFPR);
            }
        } else {
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(STRQpre)).addReg(SP, Define, 0).addReg(SrcReg, getKillRegState(KillSrc), 0).addReg(SP, RegState {}, 0).addImm(-16);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(LDRQpost)).addReg(SP, Define, 0).addReg(DestReg, Define, 0).addReg(SP, RegState {}, 0).addImm(16);
        }
        return;
    }
    if FPR64RegClass.contains(DestReg.operator MCRegister()) && FPR64RegClass.contains(SrcReg.operator MCRegister()) {
        if self.Subtarget.hasZeroCycleRegMoveFPR128() && !self.Subtarget.hasZeroCycleRegMoveFPR64() && !self.Subtarget.hasZeroCycleRegMoveFPR32() && self.Subtarget.isNeonAvailable() && !mustAvoidNeonAtMBBI(self.Subtarget, MBB, I) {
            let mut DestRegQ: MCRegister = self.RI.getMatchingSuperReg(DestReg.operator MCRegister(), dsub, &mut FPR128RegClass);
            let mut SrcRegQ: MCRegister = self.RI.getMatchingSuperReg(SrcReg.operator MCRegister(), dsub, &mut FPR128RegClass);
            BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.get(ORRv16i8), DestRegQ).addReg(SrcRegQ, Undef, 0).addReg(SrcRegQ, Undef, 0).addReg(SrcReg, Implicit | getKillRegState(KillSrc), 0);
