        let mut MIB: MachineInstrBuilder = BuildMI(MBB, DL, get(Opcode));
        AddSubReg(MIB, DestReg, [SubReg], Define, TRI);
        MIB()(ZeroReg);
        AddSubReg(MIB, SrcReg, [SubReg], getKillRegState(KillSrc), TRI);
        MIB()(0);
    }
}

