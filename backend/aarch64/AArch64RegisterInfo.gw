fn AArch64RegisterInfo::useFPForScavengingIndex(self: *AArch64RegisterInfo, MF: *MachineFunction) -> bool {
    let mut TFI: *AArch64FrameLowering = operator*(getFrameLowering(MF));
    let mut AFI: *AArch64FunctionInfo = MF;
    (((operator!(operator!(((operator!(MF()) || AFI.hasCalculatedStackSizeSVE()) && "Expected SVE area to be calculated by this point")))) || (_wassert(L"(!MF.getSubtarget<AArch64Subtarget>().hasSVE() || AFI->hasCalculatedStackSizeSVE()) && \"Expected SVE area to be calculated by this point\"", L"llvm\\lib\\Target\\AArch64\\AArch64RegisterInfo.cpp", (776) as u32) , 0)) as void);
    return TFI.hasFP(MF) && operator!(hasStackRealignment(MF)) && !AFI.hasSVEStackSize() && !AFI.hasStackHazardSlotIndex();
}

