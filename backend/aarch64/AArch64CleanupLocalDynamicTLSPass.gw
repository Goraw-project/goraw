struct LDTLSCleanup {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn LDTLSCleanup::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction {
        return false;
    }
    let mut AFI: *mut AArch64FunctionInfo = MF;
    if AFI.getNumLocalDynamicTLSAccesses() < 2 {
        return false;
    }
    let mut DT: *mut MachineDominatorTree = operator&();
    return self.VisitNode(DT()(), 0);
}

fn LDTLSCleanup::VisitNode(self, Node: *mut MachineDomTreeNode, TLSBaseAddrReg: u32) -> bool {
    let mut BB: *mut MachineBasicBlock = Node()();
    let mut Changed: bool = false;
    for let mut I: i32 = BB()(); ;  {
        
    }
}

fn LDTLSCleanup::replaceTLSBaseAddrCall(self, I: *mut MachineInstr, TLSBaseAddrReg: u32) -> *mut MachineInstr {
    let mut MF: *mut MachineFunction = I.getParent().getParent();
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    let mut Copy: *mut MachineInstr = BuildMI(*I.getParent(), I, I.getDebugLoc(), TII.get)(TLSBaseAddrReg);
    if I.shouldUpdateAdditionalCallInfo() {
        I.getMF().eraseAdditionalCallInfo(&mut I);
    }
    I()();
    return Copy;
}

fn LDTLSCleanup::setRegister(self, I: *mut MachineInstr, TLSBaseAddrReg: *mut u32) -> *mut MachineInstr {
    let mut MF: *mut MachineFunction = I.getParent().getParent();
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    let mut RegInfo: *mut MachineRegisterInfo = MF.getRegInfo();
    *TLSBaseAddrReg = RegInfo;
    let mut Copy: *mut MachineInstr = BuildMI(*I.getParent(), I()() += 1, I.getDebugLoc(), TII.get, *TLSBaseAddrReg);
    return Copy;
}

fn LDTLSCleanup::getPassName(self: *LDTLSCleanup) -> str {
    return "AArch64 Local Dynamic TLS Access Clean-up";
}

fn LDTLSCleanup::getAnalysisUsage(self: *LDTLSCleanup, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU;
    self.getAnalysisUsage;
}

fn LDTLSCleanup::getPassKind(self: *LDTLSCleanup) -> PassKind {
    return self.Kind;
}

fn LDTLSCleanup::getPassID(self: *LDTLSCleanup) -> AnalysisID {
    return self.PassID;
}

fn LDTLSCleanup::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn LDTLSCleanup::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn LDTLSCleanup::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn LDTLSCleanup::getResolver(self: *LDTLSCleanup) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn LDTLSCleanup::getRequiredProperties(self: *LDTLSCleanup) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn LDTLSCleanup::getSetProperties(self: *LDTLSCleanup) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn LDTLSCleanup::getClearedProperties(self: *LDTLSCleanup) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createAArch64CleanupLocalDynamicTLSPass() -> *mut FunctionPass {
    return LDTLSCleanup {};
}
