fn AArch64StackTagging::collectInitializers(self, StartInst: *mut Instruction, StartPtr: *mut Value, Size: u64, IB: *mut InitializerBuilder) -> *mut Instruction {
    let mut AllocaLoc: MemoryLocation = MemoryLocation { Ptr: StartPtr, Size: Size, AATags: AAMDNodes {} };
    let mut LastInst: *mut Instruction = StartInst;
    let mut Count: u32 = 0;
    while  {
        Count += 1;
        if isNoModRef(self.AA) {
            continue;
        }
        if operator!(isa()) && operator!(isa()) {
            if  {
                break;
            }
            continue;
        }
        if dyn_cast() {
            NextStore;
        } else {
            if !NextStore.isSimple() {
                break;
            }
            let mut Offset: optional<int64_t> = zeroed();
            if operator!() {
                break;
            }
            if operator!(IB.addStore(operator*(), NextStore, self.DL)) {
                break;
            }
            LastInst(NextStore);
        }
    }
    return LastInst;
}

fn AArch64StackTagging::tagAlloca(self, AI: *mut AllocaInst, InsertBefore: *mut Instruction, Ptr: *mut Value, Size: u64) {
    let mut SetTagZeroFunc: auto = getOrInsertDeclaration(self.F);
    let mut StgpFunc: auto = getOrInsertDeclaration(self.F);
    let mut IB: InitializerBuilder = Size;
    let mut LittleEndian: bool = AI()();
    if self.MergeInit && !self.F.hasOptNone() && LittleEndian && Size < ClMergeInitSizeLimit() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-stack-tagging", 1) {
                dbgs() << "collecting initializers for " << ", size = " << Size << "\n";
            }
        }
            if !(false) { break; }
        }
        InsertBefore = self.collectInitializers(InsertBefore, Ptr, Size, IB);
    }
    let mut IRB: i32 = InsertBefore;
    IB()();
}

fn AArch64StackTagging::untagAlloca(self, AI: *mut AllocaInst, InsertBefore: *mut Instruction, Size: u64) {
    let mut IRB: i32 = InsertBefore;
    IRB()(self.SetTagFunc, void { (AI), get(Size) });
}

fn getSlotPtr(IRB: *mut i32, TargetTriple: *Triple, HasInstrumentedAllocas: bool) -> *mut Value {
    if !HasInstrumentedAllocas {
        return null;
    }
    if ClRecordStackHistory() == instr || (operator!() && TargetTriple.isOSDarwin()) {
        if TargetTriple.isAndroid() && TargetTriple.isAArch64() && !TargetTriple.isAndroidVersionLT(35) {
            return (-3);
        }
        if TargetTriple.isOSDarwin() && TargetTriple.isAArch64() && !TargetTriple.isSimulatorEnvironment() {
            return (231);
        }
    }
    return null;
}

fn AArch64StackTagging::insertBaseTaggedPointer(self, M: *Module, AllocasToInstrument: i32, DT: *DominatorTree) -> *mut Instruction {
    let mut PrologueBB: *mut BasicBlock = null;
    assert!(PrologueBB);
    let mut IRB: i32 = &mut PrologueBB.front();
    let mut Base: *mut Instruction = ;
    Base.setName;
    let mut TargetTriple: *Triple = M.getTargetTriple();
    if  {
        SlotPtr;
    } else {
        let mut TagMask: u64 = 15 << 56;
        let mut IntptrTy: *mut auto = (M.getDataLayout());
        let mut ThreadLong: *mut auto = (SlotPtr);
        let mut FP: *mut Value = ();
        let mut Tag: *mut Value = ((Base), TagMask);
        let mut TaggedFP: *mut Value = (FP, Tag);
        let mut PC: *mut Value = (TargetTriple);
        let mut RecordPtr: *mut Value = ((0));
        IRB()(PC, RecordPtr);
        IRB()(TaggedFP, (RecordPtr, 1));
        IRB()((16, TargetTriple.isOSDarwin()), SlotPtr);
    }
    return Base;
}

fn AArch64StackTagging::runOnFunction(self, Fn: *mut Function) -> bool {
    if !Fn.hasFnAttribute(SanitizeMemTag) {
        return false;
    }
    if self.UseStackSafety {
        self.SSI = operator&();
    }
    self.F = &mut Fn;
    self.DL = &mut Fn.getDataLayout();
    if self.MergeInit {
        self.AA = operator&();
    }
    let mut DeleteORE: i32 = 0;
    let mut ORE: *mut OptimizationRemarkEmitter = null;
    if  {
        ORE = operator&();
    }
    if ORE == null {
        DeleteORE() = make_unique(self.F);
        ORE = ();
    }
    let mut SIB: StackInfoBuilder = StackInfoBuilder { self.SSI, "aarch64-stack-tagging" };
    let mut SInfo: *mut StackInfo = SIB.get();
    if SInfo()() {
        return false;
    }
    let mut DeleteDT: i32 = 0;
    let mut DT: *mut DominatorTree = null;
    if  {
        DT = operator&();
    }
    if DT == null {
        DeleteDT() = make_unique(*self.F);
        DT = ();
    }
    let mut DeletePDT: i32 = 0;
    let mut PDT: *mut PostDominatorTree = null;
    if  {
        PDT = operator&();
    }
    if PDT == null {
        DeletePDT() = make_unique(*self.F);
        PDT = ();
    }
    let mut DeleteLI: i32 = 0;
    let mut LI: *mut LoopInfo = null;
    if  {
        LI = operator&();
    } else {
        DeleteLI() = make_unique(*DT);
        LI = ();
    }
    self.SetTagFunc = getOrInsertDeclaration(self.F);
    let mut Base: *mut Instruction = null;
    let mut NextTag: u32 = 0;
    return true;
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, LHS: *Range, RHS: u64) -> bool {
        return LHS.End <= RHS;
    }
