struct InitializerBuilder {
    Size: u64,
    DL: *DataLayout,
    BasePtr: *mut Value,
    SetTagFn: *mut Function,
    SetTagZeroFn: *mut Function,
    StgpFn: *mut Function,
    Ranges: SmallVector<Range, 4>,
    Out: i32,
}

fn InitializerBuilder::addRange(self, Start: u64, End: u64, Inst: *mut Instruction) -> bool {
    let mut I: auto = lower_bound(Start, Closure_1 {});
    if  {
        return false;
    }
    return true;
}

fn InitializerBuilder::addStore(self, Offset: u64, SI: *mut StoreInst, DL: *DataLayout) -> bool {
    let mut StoreSize: i64 = DL.getTypeStoreSize(SI.getOperand(0).getType());
    if !self.addRange {
        return false;
    }
    let mut IRB: i32 = SI;
    return true;
}

fn InitializerBuilder::addMemSet(self, Offset: u64, MSI: *mut MemSetInst) -> bool {
    let mut StoreSize: u64 = cast(MSI()())();
    if !self.addRange {
        return false;
    }
    let mut IRB: i32 = MSI;
    return true;
}

fn InitializerBuilder::applyMemSet(self, IRB: *mut i32, Start: i64, End: i64, V: *mut ConstantInt) {
    if V.isZero() {
        return;
    }
    for let mut Offset: i64 = Start - Start % 8; Offset < End; Offset += 8 {
        let mut Cst: u64 = 72340172838076673;
        let mut LowBits: i32 = if Offset < Start { (Start - Offset) * 8 } else { 0 };
        if LowBits {
            Cst = (Cst >> LowBits) << LowBits;
        }
        let mut HighBits: i32 = if End - Offset < 8 { (8 - (End - Offset)) * 8 } else { 0 };
        if HighBits {
            Cst = (Cst << HighBits) >> HighBits;
        }
        let mut C: *mut ConstantInt = get(Cst * V.getZExtValue());
        let mut CurrentV: *mut *mut Value = null;
        if !CurrentV {
            CurrentV = C;
        } else {
            CurrentV = (CurrentV, C);
        }
    }
}

fn InitializerBuilder::sliceValue(self, IRB: *mut i32, V: *mut Value, Offset: i64) -> *mut Value {
    if Offset > 0 {
        V = (V, Offset * 8);
        V = (V);
    } else if Offset < 0 {
        V = (V);
        V = (V, -Offset * 8);
    } else {
        V = (V);
    }
    return V;
}

fn InitializerBuilder::applyStore(self, IRB: *mut i32, Start: i64, End: i64, StoredValue: *mut Value) {
    for let mut Offset: i64 = Start - Start % 8; Offset < End; Offset += 8 {
        let mut V: *mut Value = null;
        let mut CurrentV: *mut *mut Value = null;
        if !CurrentV {
            CurrentV = V;
        } else {
            CurrentV = (CurrentV, V);
        }
    }
}

fn InitializerBuilder::generate(self, IRB: *mut i32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-stack-tagging", 1) {
            dbgs() << "Combined initializer\n";
        }
    }
        if !(false) { break; }
    }
    if  {
        return;
    }
    let mut LastOffset: u64 = 0;
    for let mut Offset: u64 = 0; Offset < self.Size; Offset += 16 {
        let mut I1: auto = zeroed();
        let mut I2: auto = zeroed();
        if  {
            continue;
        }
        let mut Store1: *mut Value = null;
        let mut Store2: *mut Value = null;
        LastOffset = Offset + 16;
    }
}

fn InitializerBuilder::emitZeroes(self, IRB: *mut i32, Offset: u64, Size: u64) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-stack-tagging", 1) {
            dbgs() << "  [" << Offset << ", " << Offset + Size << ") zero\n";
        }
    }
        if !(false) { break; }
    }
    let mut Ptr: *mut Value = self.BasePtr;
    if Offset {
        Ptr = (Ptr, Offset);
    }
    IRB()(self.SetTagZeroFn, void { Ptr, get(Size) });
}

fn InitializerBuilder::emitUndef(self, IRB: *mut i32, Offset: u64, Size: u64) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-stack-tagging", 1) {
            dbgs() << "  [" << Offset << ", " << Offset + Size << ") undef\n";
        }
    }
        if !(false) { break; }
    }
    let mut Ptr: *mut Value = self.BasePtr;
    if Offset {
        Ptr = (Ptr, Offset);
    }
    IRB()(self.SetTagFn, void { Ptr, get(Size) });
}

fn InitializerBuilder::emitPair(self, IRB: *mut i32, Offset: u64, A: *mut Value, B: *mut Value) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-stack-tagging", 1) {
            dbgs() << "  [" << Offset << ", " << Offset + 16 << "):\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-stack-tagging", 1) {
            dbgs() << "    " << *A << "\n    " << *B << "\n";
        }
    }
        if !(false) { break; }
    }
    let mut Ptr: *mut Value = self.BasePtr;
    if Offset {
        Ptr = (Ptr, Offset);
    }
    IRB()(self.StgpFn, void { Ptr, A, B });
}

fn InitializerBuilder::flatten(self, IRB: *mut i32, V: *mut Value) -> *mut Value {
    if V.getType().isIntegerTy() {
        return V;
    }
    if dyn_cast(V.getType()) {
        VecTy;
    } else {
        let mut Ctx: *mut LLVMContext = ();
        let mut EltTy: *mut Type = VecTy.getElementType();
        if EltTy.isPointerTy() {
            let mut EltSize: u32 = self.DL.getTypeSizeInBits(EltTy);
            let mut NewTy: *mut auto = get(get(Ctx, EltSize), cast(VecTy)());
            V = (V);
        }
    }
    return (V, (self.DL.getTypeStoreSize(V.getType())));
}

