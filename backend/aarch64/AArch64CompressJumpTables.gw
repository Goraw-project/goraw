static mut NumJT8: Statistic = Statistic { "aarch64-jump-tables", "NumJT8", "Number of jump-tables with 1-byte entries" };

static mut NumJT16: Statistic = Statistic { "aarch64-jump-tables", "NumJT16", "Number of jump-tables with 2-byte entries" };

static mut NumJT32: Statistic = Statistic { "aarch64-jump-tables", "NumJT32", "Number of jump-tables with 4-byte entries" };

struct AArch64CompressJumpTablesImpl {
    TII: *TargetInstrInfo,
    MF: *mut MachineFunction,
    BlockInfo: SmallVector<int, 8>,
}

struct AArch64CompressJumpTablesLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64CompressJumpTablesLegacy::getRequiredProperties(self: *AArch64CompressJumpTablesLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn AArch64CompressJumpTablesLegacy::getPassName(self: *AArch64CompressJumpTablesLegacy) -> str {
    return "AArch64 Compress Jump Tables";
}

fn AArch64CompressJumpTablesLegacy::getPassKind(self: *AArch64CompressJumpTablesLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64CompressJumpTablesLegacy::getPassID(self: *AArch64CompressJumpTablesLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64CompressJumpTablesLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64CompressJumpTablesLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64CompressJumpTablesLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64CompressJumpTablesLegacy::getResolver(self: *AArch64CompressJumpTablesLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64CompressJumpTablesLegacy::getSetProperties(self: *AArch64CompressJumpTablesLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64CompressJumpTablesLegacy::getClearedProperties(self: *AArch64CompressJumpTablesLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn AArch64CompressJumpTablesImpl::computeBlockSize(self, MBB: *mut MachineBasicBlock) -> optional<int> {
    let mut Size: i32 = 0;
    for MI in MBB {
        if MI.getOpcode() == INLINEASM || MI.getOpcode() == INLINEASM_BR {
            return nullopt;
        }
        Size += self.TII.getInstSizeInBytes(MI);
    }
    return Size;
}

fn AArch64CompressJumpTablesImpl::scanFunction(self) -> bool {
    self.BlockInfo.clear();
    self.BlockInfo.resize(self.MF.getNumBlockIDs());
    let mut Offset: u32 = 0;
    for MBB in *self.MF {
        let mut Alignment: Align = MBB.getAlignment();
        let mut OffsetAfterAlignment: u32 = Offset;
        if Alignment > 4 {
            OffsetAfterAlignment += Alignment.value() - 4;
        }
        self.BlockInfo[MBB.getNumber()] = OffsetAfterAlignment;
        let mut BlockSize: optional<int> = self.computeBlockSize(MBB);
        if !BlockSize {
            return false;
        }
        Offset = OffsetAfterAlignment + operator(BlockSize);
    }
    return true;
}

fn AArch64CompressJumpTablesImpl::compressJumpTable(self, MI: *mut MachineInstr, Offset: i32) -> bool {
    if MI.getOpcode() != JumpTableDest32 {
        return false;
    }
    let mut JTIdx: i32 = MI.getOperand(4).getIndex();
    let mut JTInfo: *mut MachineJumpTableInfo = *self.MF.getJumpTableInfo();
    let mut JT: *MachineJumpTableEntry = JTInfo.getJumpTables()[JTIdx];
    if JT.MBBs.is_empty() {
        return false;
    }
    let mut MaxOffset: i32 = min();
    let mut MinOffset: i32 = max();
    let mut MinBlock: *mut MachineBasicBlock = null;
    for Block in JT.MBBs {
        let mut BlockOffset: i32 = self.BlockInfo[Block.getNumber()];
        assert!(BlockOffset % 4 == 0, "misaligned basic block");
        MaxOffset = if MaxOffset > BlockOffset { MaxOffset } else { BlockOffset };
        if BlockOffset <= MinOffset {
            MinOffset = BlockOffset;
            MinBlock = Block;
        }
    }
    assert!(MinBlock, "Failed to find minimum offset block");
    if !isInt(MinOffset - Offset) {
        operator(NumJT32);
        return false;
    }
    let mut Span: i32 = MaxOffset - MinOffset;
    let mut AFI: *mut AArch64FunctionInfo = self.MF.getInfo();
    if isUInt(Span / 4) {
        AFI.setJumpTableEntryInfo(JTIdx, 1, MinBlock.getSymbol());
        MI.setDesc(self.TII.get(JumpTableDest8));
        operator(NumJT8);
        return true;
    }
    if isUInt(Span / 4) {
        AFI.setJumpTableEntryInfo(JTIdx, 2, MinBlock.getSymbol());
        MI.setDesc(self.TII.get(JumpTableDest16));
        operator(NumJT16);
        return true;
    }
    operator(NumJT32);
    return false;
}

fn AArch64CompressJumpTablesImpl::run(self, MFIn: *mut MachineFunction) -> bool {
    let mut Changed: bool = false;
    self.MF = &mut MFIn;
    let mut ST: *AArch64Subtarget const = self.MF.getSubtarget();
    self.TII = ST.getInstrInfo();
    if ST.force32BitJumpTables() && !self.MF.getFunction().hasMinSize() {
        return false;
    }
    if !self.scanFunction() {
        return false;
    }
    for MBB in *self.MF {
        let mut Offset: i32 = self.BlockInfo[MBB.getNumber()];
        for MI in MBB {
            Changed |= self.compressJumpTable(MI, Offset);
            Offset += self.TII.getInstSizeInBytes(MI);
        }
    }
    return Changed;
}

fn AArch64CompressJumpTablesLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return AArch64CompressJumpTablesImpl {}.run(MF);
}

fn AArch64CompressJumpTablesPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64CompressJumpTablesImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

fn createAArch64CompressJumpTablesPass() -> *mut FunctionPass {
    return AArch64CompressJumpTablesLegacy {};
}
