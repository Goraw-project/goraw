static mut NumModifiedInstr: Statistic = Statistic { "aarch64-simd-instr-opt", "NumModifiedInstr", "Number of SIMD instructions modified" };

const MaxNumRepl: u32 = 10;

struct AArch64SIMDInstrOptImpl {
    TII: *AArch64InstrInfo,
    MRI: *mut MachineRegisterInfo,
    SchedModel: TargetSchedModel,
    SIMDInstrTable: *mut SIMDInstrTableMap,
    InterlEarlyExit: *mut InterlEarlyExitMap,
}

struct AArch64SIMDInstrOptLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
    SIMDInstrTable: SIMDInstrTableMap,
    InterlEarlyExit: InterlEarlyExitMap,
}

fn AArch64SIMDInstrOptLegacy::getPassName(self: *AArch64SIMDInstrOptLegacy) -> str {
    return "AArch64 SIMD instructions optimization pass";
}

fn AArch64SIMDInstrOptLegacy::getAnalysisUsage(self: *AArch64SIMDInstrOptLegacy, AU: *mut AnalysisUsage) {
    AU.addPreserved();
    self.getAnalysisUsage(AU);
}

fn AArch64SIMDInstrOptLegacy::getPassKind(self: *AArch64SIMDInstrOptLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64SIMDInstrOptLegacy::getPassID(self: *AArch64SIMDInstrOptLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64SIMDInstrOptLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64SIMDInstrOptLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64SIMDInstrOptLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64SIMDInstrOptLegacy::getResolver(self: *AArch64SIMDInstrOptLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64SIMDInstrOptLegacy::getRequiredProperties(self: *AArch64SIMDInstrOptLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64SIMDInstrOptLegacy::getSetProperties(self: *AArch64SIMDInstrOptLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64SIMDInstrOptLegacy::getClearedProperties(self: *AArch64SIMDInstrOptLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

const IRT: [14]InstReplInfo = [InstReplInfo { ST2Twov2d, [10]u32 {}, 3, &mut FPR128RegClass }, InstReplInfo { ST2Twov4s, [10]u32 {}, 3, &mut FPR128RegClass }, InstReplInfo { ST2Twov2s, [10]u32 {}, 3, &mut FPR64RegClass }, InstReplInfo { ST2Twov8h, [10]u32 {}, 3, &mut FPR128RegClass }, InstReplInfo { ST2Twov4h, [10]u32 {}, 3, &mut FPR64RegClass }, InstReplInfo { ST2Twov16b, [10]u32 {}, 3, &mut FPR128RegClass }, InstReplInfo { ST2Twov8b, [10]u32 {}, 3, &mut FPR64RegClass }, InstReplInfo { ST4Fourv2d, [ZIP1v2i64, ZIP2v2i64, ZIP1v2i64, ZIP2v2i64, ZIP1v2i64, ZIP2v2i64, ZIP1v2i64, ZIP2v2i64, STPQi, STPQi], 10, &mut FPR128RegClass }, InstReplInfo { ST4Fourv4s, [ZIP1v4i32, ZIP2v4i32, ZIP1v4i32, ZIP2v4i32, ZIP1v4i32, ZIP2v4i32, ZIP1v4i32, ZIP2v4i32, STPQi, STPQi], 10, &mut FPR128RegClass }, InstReplInfo { ST4Fourv2s, [ZIP1v2i32, ZIP2v2i32, ZIP1v2i32, ZIP2v2i32, ZIP1v2i32, ZIP2v2i32, ZIP1v2i32, ZIP2v2i32, STPDi, STPDi], 10, &mut FPR64RegClass }, InstReplInfo { ST4Fourv8h, [ZIP1v8i16, ZIP2v8i16, ZIP1v8i16, ZIP2v8i16, ZIP1v8i16, ZIP2v8i16, ZIP1v8i16, ZIP2v8i16, STPQi, STPQi], 10, &mut FPR128RegClass }, InstReplInfo { ST4Fourv4h, [ZIP1v4i16, ZIP2v4i16, ZIP1v4i16, ZIP2v4i16, ZIP1v4i16, ZIP2v4i16, ZIP1v4i16, ZIP2v4i16, STPDi, STPDi], 10, &mut FPR64RegClass }, InstReplInfo { ST4Fourv16b, [ZIP1v16i8, ZIP2v16i8, ZIP1v16i8, ZIP2v16i8, ZIP1v16i8, ZIP2v16i8, ZIP1v16i8, ZIP2v16i8, STPQi, STPQi], 10, &mut FPR128RegClass }, InstReplInfo { ST4Fourv8b, [ZIP1v8i8, ZIP2v8i8, ZIP1v8i8, ZIP2v8i8, ZIP1v8i8, ZIP2v8i8, ZIP1v8i8, ZIP2v8i8, STPDi, STPDi], 10, &mut FPR64RegClass }];

fn AArch64SIMDInstrOptImpl::shouldReplaceInst(self, MF: *mut MachineFunction, InstDesc: *MCInstrDesc, InstDescRepl: *SmallVectorImpl<const MCInstrDesc *>) -> bool {
    let mut Subtarget: str = self.SchedModel.getSubtargetInfo().getCPU()[0..allocator<char> {}];
    let mut InstID: allocator<char>> &>> = make_pair(InstDesc.getOpcode(), Subtarget);
    let mut It: iterator = self.SIMDInstrTable.find(InstID);
    if !It == self.SIMDInstrTable.end() {
        return operator(It).second;
    }
    let mut SCIdx: u32 = InstDesc.getSchedClass();
    let mut SCDesc: *MCSchedClassDesc = self.SchedModel.getMCSchedModel().getSchedClassDesc(SCIdx);
    let mut SCDescRepl: *MCSchedClassDesc = null;
    if !SCDesc.isValid() || SCDesc.isVariant() {
        self.SIMDInstrTable[InstID] = false;
        return false;
    }
    for IDesc in InstDescRepl {
        SCDescRepl = self.SchedModel.getMCSchedModel().getSchedClassDesc(IDesc.getSchedClass());
        if !SCDescRepl.isValid() || SCDescRepl.isVariant() {
            self.SIMDInstrTable[InstID] = false;
            return false;
        }
    }
    let mut ReplCost: u32 = 0;
    for IDesc in InstDescRepl {
        ReplCost += self.SchedModel.computeInstrLatency(IDesc.getOpcode());
    }
    if self.SchedModel.computeInstrLatency(InstDesc.getOpcode()) > ReplCost {
        self.SIMDInstrTable[InstID] = true;
        return true;
    } else {
        self.SIMDInstrTable[InstID] = false;
        return false;
    }
}

fn AArch64SIMDInstrOptImpl::shouldExitEarly(self, MF: *mut MachineFunction, SP: Subpass) -> bool {
    let mut OriginalMCID: *MCInstrDesc = null;
    let mut ReplInstrMCID: SmallVector<const MCInstrDesc *, MaxNumRepl> = SmallVector<const MCInstrDesc *, MaxNumRepl> {};
    match SP {
        VectorElem => {
            OriginalMCID = &mut self.TII.get(FMLAv4i32_indexed);
        },
        Interleave => {
            let mut Subtarget: str = self.SchedModel.getSubtargetInfo().getCPU()[0..allocator<char> {}];
        },
    }
    return true;
}

fn AArch64SIMDInstrOptImpl::reuseDUP(self: *AArch64SIMDInstrOptImpl, MI: *mut MachineInstr, DupOpcode: u32, SrcReg: u32, LaneNumber: u32, DestReg: *mut u32) -> bool {
    for let mut MII: iterator = MI;
let mut MIE: iterator = MI.getParent().begin(); MII != MIE;  {
        operator(MII, 0);
        let mut CurrentMI: *mut MachineInstr = &mut operator(MII);
        if CurrentMI.getOpcode() == DupOpcode && CurrentMI.getNumOperands() == 3 && CurrentMI.getOperand(1).getReg() == SrcReg && CurrentMI.getOperand(2).getImm() == LaneNumber {
            *DestReg = CurrentMI.getOperand(0).getReg().operator unsigned int();
            return true;
        }
    }
    return false;
}

fn AArch64SIMDInstrOptImpl::optimizeVectElement(self, MI: *mut MachineInstr) -> bool {
    let mut MulMCID: *MCInstrDesc = null;
    let mut DupMCID: *MCInstrDesc = null;
    let mut RC: *TargetRegisterClass = &mut FPR128RegClass;
    match MI.getOpcode() {
        _ => {
            return false;
        },
        FMLAv4i32_indexed => {
            DupMCID = &mut self.TII.get(DUPv4i32lane);
        },
        FMLSv4i32_indexed => {
            DupMCID = &mut self.TII.get(DUPv4i32lane);
        },
        FMULXv4i32_indexed => {
            DupMCID = &mut self.TII.get(DUPv4i32lane);
        },
        FMULv4i32_indexed => {
            DupMCID = &mut self.TII.get(DUPv4i32lane);
        },
        FMLAv2i64_indexed => {
            DupMCID = &mut self.TII.get(DUPv2i64lane);
        },
        FMLSv2i64_indexed => {
            DupMCID = &mut self.TII.get(DUPv2i64lane);
        },
        FMULXv2i64_indexed => {
            DupMCID = &mut self.TII.get(DUPv2i64lane);
        },
        FMULv2i64_indexed => {
            DupMCID = &mut self.TII.get(DUPv2i64lane);
        },
        FMLAv2i32_indexed => {
            RC = &mut FPR64RegClass;
        },
        FMLSv2i32_indexed => {
            RC = &mut FPR64RegClass;
        },
        FMULXv2i32_indexed => {
            RC = &mut FPR64RegClass;
        },
        FMULv2i32_indexed => {
            RC = &mut FPR64RegClass;
        },
    }
    let mut ReplInstrMCID: SmallVector<const MCInstrDesc *, 2> = SmallVector<const MCInstrDesc *, 2> {};
    ReplInstrMCID.push(DupMCID);
    ReplInstrMCID.push(MulMCID);
    if !self.shouldReplaceInst(MI.getParent().getParent(), &mut self.TII.get(MI.getOpcode()), ReplInstrMCID) {
        return false;
    }
    let mut DL: *DebugLoc = MI.getDebugLoc();
    let mut MBB: *mut MachineBasicBlock = *MI.getParent();
    let mut MRI: *mut MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut MulDest: Register = MI.getOperand(0).getReg();
    let mut SrcReg0: Register = MI.getOperand(1).getReg();
    let mut Src0IsKill: RegState = getKillRegState(MI.getOperand(1).isKill());
    let mut SrcReg1: Register = MI.getOperand(2).getReg();
    let mut Src1IsKill: RegState = getKillRegState(MI.getOperand(2).isKill());
    let mut DupDest: u32 = 0;
    if MI.getNumOperands() == 5 {
        let mut SrcReg2: Register = MI.getOperand(3).getReg();
        let mut Src2IsKill: RegState = getKillRegState(MI.getOperand(3).isKill());
        let mut LaneNumber: u32 = MI.getOperand(4).getImm();
        if !self.reuseDUP(MI, DupMCID.getOpcode(), SrcReg2.operator unsigned int(), LaneNumber, &mut DupDest) {
            DupDest = MRI.createVirtualRegister(RC, "").operator unsigned int();
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, *DupMCID, DupDest).addReg(SrcReg2, Src2IsKill, 0).addImm(LaneNumber);
        }
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, *MulMCID, MulDest).addReg(SrcReg0, Src0IsKill, 0).addReg(SrcReg1, Src1IsKill, 0).addReg(DupDest, Src2IsKill, 0);
    } else if MI.getNumOperands() == 4 {
        let mut LaneNumber: u32 = MI.getOperand(3).getImm();
        if !self.reuseDUP(MI, DupMCID.getOpcode(), SrcReg1.operator unsigned int(), LaneNumber, &mut DupDest) {
            DupDest = MRI.createVirtualRegister(RC, "").operator unsigned int();
            BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, *DupMCID, DupDest).addReg(SrcReg1, Src1IsKill, 0).addImm(LaneNumber);
        }
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, *MulMCID, MulDest).addReg(SrcReg0, Src0IsKill, 0).addReg(DupDest, Src1IsKill, 0);
    } else {
        return false;
    }
    operator(NumModifiedInstr);
    return true;
}

fn AArch64SIMDInstrOptImpl::optimizeLdStInterleave(self, MI: *mut MachineInstr) -> bool {
    let mut SeqReg: u32 = 0;
    let mut AddrReg: u32 = 0;
    let mut StReg: [4]u32 = zeroed();
    let mut StRegKill: [4]RegState = zeroed();
    let mut DefiningMI: *mut MachineInstr = null;
    let mut DL: *DebugLoc = MI.getDebugLoc();
    let mut MBB: *mut MachineBasicBlock = *MI.getParent();
    let mut ZipDest: SmallVector<unsigned int, MaxNumRepl> = SmallVector<unsigned int, MaxNumRepl> {};
    let mut ReplInstrMCID: SmallVector<const MCInstrDesc *, MaxNumRepl> = SmallVector<const MCInstrDesc *, MaxNumRepl> {};
    let mut Match: bool = false;
    for I in IRT[..] {
        if MI.getOpcode() == I.OrigOpc {
            SeqReg = MI.getOperand(0).getReg().operator unsigned int();
            AddrReg = MI.getOperand(1).getReg().operator unsigned int();
            DefiningMI = self.MRI.getUniqueVRegDef(SeqReg);
            let mut NumReg: u32 = self.determineSrcReg(MI);
            if !self.processSeqRegInst(DefiningMI, StReg, StRegKill, NumReg) {
                return false;
            }
            for let mut J: u32 = 0; J < I.NumRepl; J += 1 {
                let mut Repl: u32 = I.ReplOpc[J];
                ReplInstrMCID.push(&mut self.TII.get(Repl));
                if Repl != STPQi && Repl != STPDi {
                    ZipDest.push(self.MRI.createVirtualRegister(I.RC, "").operator unsigned int());
                }
            }
            Match = true;
            break;
        }
    }
    if !Match {
        return false;
    }
    if !self.shouldReplaceInst(MI.getParent().getParent(), &mut self.TII.get(MI.getOpcode()), ReplInstrMCID) {
        return false;
    }
    match MI.getOpcode() {
        _ => {
            return false;
        },
        ST2Twov16b => {
            ST2Twov8b;
        },
        ST4Fourv16b => {
            ST4Fourv8b;
        },
    }
    operator(NumModifiedInstr);
    return true;
}

fn AArch64SIMDInstrOptImpl::processSeqRegInst(self: *AArch64SIMDInstrOptImpl, DefiningMI: *mut MachineInstr, StReg: *mut u32, StRegKill: *mut RegState, NumArg: u32) -> bool {
    assert!(DefiningMI != null);
    if DefiningMI.getOpcode() != REG_SEQUENCE {
        return false;
    }
    for let mut i: u32 = 0; i < NumArg; i += 1 {
        StReg[i] = DefiningMI.getOperand(2 * i + 1).getReg().operator unsigned int();
        StRegKill[i] = getKillRegState(DefiningMI.getOperand(2 * i + 1).isKill());
        if DefiningMI.getOperand(2 * i + 2).isImm() {
            match DefiningMI.getOperand(2 * i + 2).getImm() {
                _ => {
                    return false;
                },
                dsub0 => {
                    dsub1;
                },
            }
        } else {
            return false;
        }
    }
    return true;
}

fn AArch64SIMDInstrOptImpl::determineSrcReg(self: *AArch64SIMDInstrOptImpl, MI: *mut MachineInstr) -> u32 {
    match MI.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unsupported instruction for this pass", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64SIMDInstrOpt.cpp", 705);
        },
        ST2Twov16b => {
            ST2Twov8b;
        },
        ST4Fourv16b => {
            ST4Fourv8b;
        },
    }
}

fn AArch64SIMDInstrOptImpl::run(self, MF: *mut MachineFunction) -> bool {
    self.MRI = &mut MF.getRegInfo();
    let mut ST: *AArch64Subtarget = MF.getSubtarget();
    self.TII = ST.getInstrInfo();
    self.SchedModel.init(&mut ST, true, true);
    if !self.SchedModel.hasInstrSchedModel() {
        return false;
    }
    let mut Changed: bool = false;
    for OptimizationKind in [VectorElem, Interleave] {
        if !self.shouldExitEarly(&mut MF, OptimizationKind) {
            let mut RemoveMIs: SmallVector<MachineInstr *, 8> = SmallVector<MachineInstr *, 8> {};
            for MBB in MF {
                for MI in MBB {
                    let mut InstRewrite: bool = false;
                    if OptimizationKind == VectorElem {
                        InstRewrite = self.optimizeVectElement(MI);
                    } else {
                        InstRewrite = self.optimizeLdStInterleave(MI);
                    }
                    if InstRewrite {
                        RemoveMIs.push(&mut MI);
                        Changed = true;
                    }
                }
            }
            for MI in RemoveMIs {
                MI.eraseFromParent();
            }
        }
    }
    return Changed;
}

fn AArch64SIMDInstrOptLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    return AArch64SIMDInstrOptImpl { self.SIMDInstrTable, self.InterlEarlyExit }.run(MF);
}

fn AArch64SIMDInstrOptPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64SIMDInstrOptImpl { self.SIMDInstrTable, self.InterlEarlyExit }.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

fn createAArch64SIMDInstrOptPass() -> *mut FunctionPass {
    return AArch64SIMDInstrOptLegacy {};
}
