fn isPreLdStPairCandidate(FirstMI: *mut MachineInstr, MI: *mut MachineInstr) -> bool {
    let mut OpcA: u32 = FirstMI.getOpcode();
    let mut OpcB: u32 = MI.getOpcode();
    match OpcA {
        _ => {
            return false;
        },
        STRSpre => {
            return (OpcB == STRSui) || (OpcB == STURSi);
        },
        STRDpre => {
            return (OpcB == STRDui) || (OpcB == STURDi);
        },
        STRQpre => {
            return (OpcB == STRQui) || (OpcB == STURQi);
        },
        STRWpre => {
            return (OpcB == STRWui) || (OpcB == STURWi);
        },
        STRXpre => {
            return (OpcB == STRXui) || (OpcB == STURXi);
        },
        LDRSpre => {
            return (OpcB == LDRSui) || (OpcB == LDURSi);
        },
        LDRDpre => {
            return (OpcB == LDRDui) || (OpcB == LDURDi);
        },
        LDRQpre => {
            return (OpcB == LDRQui) || (OpcB == LDURQi);
        },
        LDRWpre => {
            return (OpcB == LDRWui) || (OpcB == LDURWi);
        },
        LDRXpre => {
            return (OpcB == LDRXui) || (OpcB == LDURXi);
        },
        LDRSWpre => {
            return (OpcB == LDRSWui) || (OpcB == LDURSWi);
        },
    }
}

fn getPrePostIndexedMemOpInfo(MI: *MachineInstr, Scale: *mut i32, MinOffset: *mut i32, MaxOffset: *mut i32) {
    let mut IsPaired: bool = isPairedLdSt(MI);
    let mut IsTagStore: bool = isTagStore(MI);
    Scale = if (IsTagStore || IsPaired) { getMemScale(MI) } else { 1 };
    if IsPaired {
        MinOffset = -64;
        MaxOffset = 63;
    } else {
        MinOffset = -256;
        MaxOffset = 255;
    }
}

fn getLdStRegOp(MI: *mut MachineInstr, PairedRegOp: u32) -> *mut MachineOperand {
    assert!(PairedRegOp < 2, "Unexpected register operand idx.");
    let mut IsPreLdSt: bool = isPreLdSt(MI);
    if IsPreLdSt {
        PairedRegOp += 1;
    }
    let mut Idx: u32 = if isPairedLdSt(MI) || IsPreLdSt { PairedRegOp } else { 0 };
    return MI.getOperand(Idx);
}

fn isLdOffsetInRangeOfSt(LoadInst: *mut MachineInstr, StoreInst: *mut MachineInstr, TII: *AArch64InstrInfo) -> bool {
    assert!(isMatchingStore(LoadInst, StoreInst), "Expect only matched ld/st.");
    let mut LoadSize: i32 = TII.getMemScale(LoadInst);
    let mut StoreSize: i32 = TII.getMemScale(StoreInst);
    let mut UnscaledStOffset: i32 = if TII.hasUnscaledLdStOffset(StoreInst) { getLdStOffsetOp(StoreInst).getImm() } else { getLdStOffsetOp(StoreInst).getImm() * StoreSize };
    let mut UnscaledLdOffset: i32 = if TII.hasUnscaledLdStOffset(LoadInst) { getLdStOffsetOp(LoadInst).getImm() } else { getLdStOffsetOp(LoadInst).getImm() * LoadSize };
    return (UnscaledStOffset <= UnscaledLdOffset) && (UnscaledLdOffset + LoadSize <= (UnscaledStOffset + StoreSize));
}

fn isPromotableZeroStoreInst(MI: *mut MachineInstr) -> bool {
    let mut Opc: u32 = MI.getOpcode();
    return (Opc == STRWui || Opc == STURWi || isNarrowStore(Opc)) && getLdStRegOp(MI, 0).getReg() == WZR;
}

fn isPromotableLoadFromStore(MI: *mut MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        LDRBBui => {
            LDRHHui;
        },
    }
}

fn isMergeableLdStUpdate(MI: *mut MachineInstr, AFI: *mut AArch64FunctionInfo) -> bool {
    let mut Opc: u32 = MI.getOpcode();
    match Opc {
        _ => {
            return false;
        },
        STRBui => {
            STRHui;
        },
    }
}

fn isMergeableIndexLdSt(MI: *mut MachineInstr, Scale: *mut i32) -> bool {
    let mut Opc: u32 = MI.getOpcode();
    match Opc {
        _ => {
            return false;
        },
        LDRBroX => {
            LDRBBroX;
        },
        LDRHroX => {
            LDRHHroX;
        },
        LDRWroX => {
            LDRSroX;
        },
        LDRDroX => {
            LDRXroX;
        },
        LDRQroX => {
            Scale = 16;
        },
    }
}

fn isRewritableImplicitDef(MI: *MachineInstr, MO: *MachineOperand) -> bool {
    match MI.getOpcode() {
        _ => {
            return MO.isRenamable();
        },
        ORRWrs => {
            ADDWri;
        },
    }
}

fn AArch64LoadStoreOpt::mergeNarrowZeroStores(self, I: iterator, MergeMI: iterator, Flags: *LdStPairFlags) -> iterator {
    assert!(isPromotableZeroStoreInst(operator(I)) && isPromotableZeroStoreInst(operator(MergeMI)), "Expected promotable zero stores.");
    let mut E: iterator = operator(I).getParent().end();
    let mut NextI: iterator = next_nodbg(I, E, true);
    if NextI == MergeMI {
        NextI = next_nodbg(NextI, E, true);
    }
    let mut Opc: u32 = operator(I).getOpcode();
    let mut MergeMIOpc: u32 = operator(MergeMI).getOpcode();
    let mut IsScaled: bool = !self.TII.hasUnscaledLdStOffset(Opc);
    let mut IsMergedMIScaled: bool = !self.TII.hasUnscaledLdStOffset(MergeMIOpc);
    let mut OffsetStride: i32 = if IsScaled { self.TII.getMemScale(operator(I)) } else { 1 };
    let mut MergeMIOffsetStride: i32 = if IsMergedMIScaled { self.TII.getMemScale(operator(MergeMI)) } else { 1 };
    let mut MergeForward: bool = Flags.getMergeForward();
    let mut InsertionPoint: iterator = if MergeForward { MergeMI } else { I };
    let mut BaseRegOp: *MachineOperand = if MergeForward { getLdStBaseOp(operator(MergeMI)) } else { getLdStBaseOp(operator(I)) };
    let mut IOffsetInBytes: i64 = getLdStOffsetOp(operator(I)).getImm() * OffsetStride;
    let mut MIOffsetInBytes: i64 = getLdStOffsetOp(operator(MergeMI)).getImm() * MergeMIOffsetStride;
    let mut OffsetImm: i64 = 0;
    if IOffsetInBytes > MIOffsetInBytes {
        OffsetImm = MIOffsetInBytes;
    } else {
        OffsetImm = IOffsetInBytes;
    }
    let mut NewOpcode: i32 = getMatchingWideOpcode(Opc);
    if !self.TII.hasUnscaledLdStOffset(NewOpcode) {
        let mut NewOffsetStride: i32 = self.TII.getMemScale(NewOpcode);
        assert!(((OffsetImm % NewOffsetStride) == 0), "Offset should be a multiple of the store memory scale");
        OffsetImm = OffsetImm / NewOffsetStride;
    }
    let mut DL: DebugLoc = operator(I).getDebugLoc();
    let mut MBB: *mut MachineBasicBlock = operator(I).getParent();
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    MIB = BuildMI(*MBB, InsertionPoint, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpcode)).addReg(if isNarrowStore(Opc) { WZR } else { XZR }, RegState {}, 0).add(BaseRegOp).addImm(OffsetImm).cloneMergedMemRefs([&mut operator(I), &mut operator(MergeMI)]).setMIFlags(operator(I).mergeFlagsWith(operator(MergeMI)));
    MIB as void;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "Creating wider store. Replacing instructions:\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(I).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(MergeMI).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "  with instruction:\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            (MIB.operator llvm::MachineInstr *() as *mut MachineInstr).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "\n";
        }
    }
        if !(false) { break; }
    }
    operator(I).eraseFromParent();
    operator(MergeMI).eraseFromParent();
    return NextI;
}

fn forAllMIsUntilDef(MI: *mut MachineInstr, DefReg: MCPhysReg, TRI: *TargetRegisterInfo, Limit: u32, Fn: *mut function<bool (MachineInstr &, bool)>) -> bool {
    let mut MBB: *mut MachineBasicBlock = MI.getParent();
    for I in instructionsWithoutDebug(MI.getReverseIterator(), MBB.instr_rend(), true) {
        if !Limit {
            return false;
        }
        Limit -= 1;
        let mut isDef: bool = any_of(I.operands(), Closure_1 { DefReg: DefReg, TRI: TRI });
        if !Fn.call(I, isDef) {
            return false;
        }
        if isDef {
            break;
        }
    }
    return true;
}

fn updateDefinedRegisters(MI: *mut MachineInstr, Units: *mut LiveRegUnits, TRI: *TargetRegisterInfo) {
    for MOP in phys_regs_and_masks(MI) {
        if MOP.isReg() && MOP.isKill() {
            Units.removeReg(MOP.getReg().operator MCRegister());
        }
    }
    for MOP in phys_regs_and_masks(MI) {
        if MOP.isReg() && !MOP.isKill() {
            Units.addReg(MOP.getReg().operator MCRegister());
        }
    }
}

fn addDebugSubstitutionsToTable(MF: *mut MachineFunction, InstrNumToSet: u32, OriginalInstr: *mut MachineInstr, MergedInstr: *mut MachineInstr) {
    let mut Reg: Register = OriginalInstr.getOperand(0).getReg();
    let mut OperandNo: u32 = 0;
    let mut RegFound: bool = false;
    for Op in MergedInstr.operands() {
        if Op.getReg() == Reg {
            RegFound = true;
            break;
        }
        OperandNo += 1;
    }
    if RegFound {
        MF.makeDebugValueSubstitution(DebugInstrOperandPair { OriginalInstr.peekDebugInstrNum(), 0 }, DebugInstrOperandPair { InstrNumToSet, OperandNo }, 0);
    }
}

fn AArch64LoadStoreOpt::mergePairedInsns(self, I: iterator, Paired: iterator, Flags: *LdStPairFlags) -> iterator {
    let mut E: iterator = operator(I).getParent().end();
    let mut NextI: iterator = next_nodbg(I, E, true);
    if NextI == Paired {
        NextI = next_nodbg(NextI, E, true);
    }
    let mut SExtIdx: i32 = Flags.getSExtIdx();
    let mut Opc: u32 = if SExtIdx == -1 { operator(I).getOpcode() } else { getMatchingNonSExtOpcode(operator(I).getOpcode(), null) };
    let mut IsUnscaled: bool = self.TII.hasUnscaledLdStOffset(Opc);
    let mut OffsetStride: i32 = if IsUnscaled { self.TII.getMemScale(operator(I)) } else { 1 };
    let mut MergeForward: bool = Flags.getMergeForward();
    let mut RenameReg: optional<MCPhysReg> = Flags.getRenameReg();
    if RenameReg {
        let mut RegToRename: MCRegister = getLdStRegOp(operator(I), 0).getReg().operator MCRegister();
        self.DefinedInBB.addReg(operator(RenameReg));
        let mut GetMatchingSubReg: Closure_2 = Closure_2 { cap_0: self, cap_1: RenameReg };
        let mut UpdateMIs: function<bool (MachineInstr &, bool)> = Closure_3 { cap_0: self, cap_1: RegToRename, cap_2: GetMatchingSubReg, MergeForward: MergeForward };
        forAllMIsUntilDef(if MergeForward { operator(I) } else { *operator(Paired).getPrevNode() }, RegToRename.operator unsigned int(), self.TRI, 4294967295, UpdateMIs);
        let mut RegToCheck: MCPhysReg = operator(RenameReg);
        if !MergeForward {
            RegToCheck = RegToRename.operator unsigned int();
        }
        for MI in MachineInstr>> { if MergeForward { next(I, 1) } else { I }, if MergeForward { next(Paired, 1) } else { Paired } } {
            assert!(all_of(MI.operands(), Closure_4 { cap_0: self, RegToCheck: RegToCheck }), "Rename register used between paired instruction, trashing the content");
        }
    }
    let mut InsertionPoint: iterator = if MergeForward { Paired } else { I };
    let mut BaseRegOp: *MachineOperand = if MergeForward { getLdStBaseOp(operator(Paired)) } else { getLdStBaseOp(operator(I)) };
    let mut Offset: i32 = getLdStOffsetOp(operator(I)).getImm();
    let mut PairedOffset: i32 = getLdStOffsetOp(operator(Paired)).getImm();
    let mut PairedIsUnscaled: bool = self.TII.hasUnscaledLdStOffset(operator(Paired).getOpcode());
    if IsUnscaled != PairedIsUnscaled {
        let mut MemSize: i32 = self.TII.getMemScale(operator(Paired));
        if PairedIsUnscaled {
            assert!(!(PairedOffset % self.TII.getMemScale(operator(Paired))), "Offset should be a multiple of the stride!");
            PairedOffset /= MemSize;
        } else {
            PairedOffset *= MemSize;
        }
    }
    let mut RtMI: *mut MachineInstr = null;
    let mut Rt2MI: *mut MachineInstr = null;
    if Offset == PairedOffset + OffsetStride && !isPreLdSt(operator(I)) {
        RtMI = &mut operator(Paired);
        Rt2MI = &mut operator(I);
        if SExtIdx != -1 {
            SExtIdx = (SExtIdx + 1) % 2;
        }
    } else {
        RtMI = &mut operator(I);
        Rt2MI = &mut operator(Paired);
    }
    let mut OffsetImm: i32 = getLdStOffsetOp(*RtMI).getImm();
    if self.TII.hasUnscaledLdStOffset(RtMI.getOpcode()) {
        assert!(!(OffsetImm % self.TII.getMemScale(*RtMI)), "Unscaled offset cannot be scaled.");
        OffsetImm /= self.TII.getMemScale(*RtMI);
    }
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    let mut DL: DebugLoc = operator(I).getDebugLoc();
    let mut MBB: *mut MachineBasicBlock = operator(I).getParent();
    let mut RegOp0: MachineOperand = getLdStRegOp(*RtMI, 0);
    let mut RegOp1: MachineOperand = getLdStRegOp(*Rt2MI, 0);
    let mut PairedRegOp: *mut MachineOperand = if RtMI == &mut operator(Paired) { RegOp0 } else { RegOp1 };
    if RegOp0.isUse() {
        if !MergeForward {
            for let mut It: MachineInstr> = next(I, 1); It != Paired && PairedRegOp.isKill(); operator(It) {
                if operator(It).readsRegister(PairedRegOp.getReg(), self.TRI) {
                    PairedRegOp.setIsKill(false);
                }
            }
        } else {
            let mut Reg: Register = getLdStRegOp(operator(I), 0).getReg();
            for MI in make_range(next(operator(I).getIterator(), 1), operator(Paired).getIterator()) {
                MI.clearRegisterKills(Reg, self.TRI);
            }
        }
    }
    let mut MatchPairOpcode: u32 = getMatchingPairOpcode(Opc);
    MIB = BuildMI(*MBB, InsertionPoint, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MatchPairOpcode));
    if isPreLdSt(*RtMI) {
        MIB.addReg(BaseRegOp.getReg(), Define, 0);
    }
    MIB.add(RegOp0).add(RegOp1).add(BaseRegOp).addImm(OffsetImm).cloneMergedMemRefs([&mut operator(I), &mut operator(Paired)]).setMIFlags(operator(I).mergeFlagsWith(operator(Paired)));
    MIB as void;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "Creating pair load/store. Replacing instructions:\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(I).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(Paired).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "  with instruction:\n    ";
        }
    }
        if !(false) { break; }
    }
    if SExtIdx != -1 {
        let mut DstMO: *mut MachineOperand = operator(MIB).getOperand(SExtIdx);
        let mut DstRegX: Register = DstMO.getReg();
        let mut DstRegW: Register = self.TRI.getSubReg(DstRegX.operator MCRegister(), sub_32);
        DstMO.setReg(DstRegW);
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                (MIB.operator llvm::MachineInstr *() as *mut MachineInstr).print(dbgs(), true, false, false, true, null);
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                dbgs() << "\n";
            }
        }
            if !(false) { break; }
        }
        let mut MIBKill: MachineInstrBuilder = BuildMI(*MBB, InsertionPoint, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(KILL), DstRegW).addReg(DstRegW, RegState {}, 0).addReg(DstRegX, Define, 0);
        operator(MIBKill).getOperand(2).setImplicit(true);
        let mut MIBSXTW: MachineInstrBuilder = BuildMI(*MBB, InsertionPoint, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SBFMXri), DstRegX).addReg(DstRegX, RegState {}, 0).addImm(0).addImm(31);
        MIBSXTW as void;
        if operator(I).peekDebugInstrNum() {
            let mut NewInstrNum: u32 = 0;
            if DstRegX == operator(I).getOperand(0).getReg() {
                NewInstrNum = operator(MIBSXTW).getDebugInstrNum();
                addDebugSubstitutionsToTable(MBB.getParent(), NewInstrNum, operator(I), *MIBSXTW.operator llvm::MachineInstr *());
            } else {
                NewInstrNum = operator(MIB).getDebugInstrNum();
                addDebugSubstitutionsToTable(MBB.getParent(), NewInstrNum, operator(I), *MIB.operator llvm::MachineInstr *());
            }
        }
        if operator(Paired).peekDebugInstrNum() {
            let mut NewInstrNum: u32 = 0;
            if DstRegX == operator(Paired).getOperand(0).getReg() {
                NewInstrNum = operator(MIBSXTW).getDebugInstrNum();
                addDebugSubstitutionsToTable(MBB.getParent(), NewInstrNum, operator(Paired), *MIBSXTW.operator llvm::MachineInstr *());
            } else {
                NewInstrNum = operator(MIB).getDebugInstrNum();
                addDebugSubstitutionsToTable(MBB.getParent(), NewInstrNum, operator(Paired), *MIB.operator llvm::MachineInstr *());
            }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                dbgs() << "  Extend operand:\n    ";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                (MIBSXTW.operator llvm::MachineInstr *() as *mut MachineInstr).print(dbgs(), true, false, false, true, null);
            }
        }
            if !(false) { break; }
        }
    } else if Opc == LDR_ZXI || Opc == STR_ZXI {
        let mut MOp0: *mut MachineOperand = operator(MIB).getOperand(0);
        let mut MOp1: *mut MachineOperand = operator(MIB).getOperand(1);
        assert!(ZPRRegClass.contains(MOp0.getReg().operator MCRegister()) && ZPRRegClass.contains(MOp1.getReg().operator MCRegister()), "Invalid register.");
        MOp0.setReg(Q0 + (MOp0.getReg().operator unsigned int() - Z0));
        MOp1.setReg(Q0 + (MOp1.getReg().operator unsigned int() - Z0));
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                (MIB.operator llvm::MachineInstr *() as *mut MachineInstr).print(dbgs(), true, false, false, true, null);
            }
        }
            if !(false) { break; }
        }
    } else {
        if operator(I).peekDebugInstrNum() {
            let mut NewDebugInstrNum: u32 = operator(MIB).getDebugInstrNum();
            addDebugSubstitutionsToTable(MBB.getParent(), NewDebugInstrNum, operator(I), *MIB.operator llvm::MachineInstr *());
        }
        if operator(Paired).peekDebugInstrNum() {
            let mut NewDebugInstrNum: u32 = operator(MIB).getDebugInstrNum();
            addDebugSubstitutionsToTable(MBB.getParent(), NewDebugInstrNum, operator(Paired), *MIB.operator llvm::MachineInstr *());
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                (MIB.operator llvm::MachineInstr *() as *mut MachineInstr).print(dbgs(), true, false, false, true, null);
            }
        }
            if !(false) { break; }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "\n";
        }
    }
        if !(false) { break; }
    }
    if MergeForward {
        for MOP in phys_regs_and_masks(operator(I)) {
            if MOP.isReg() && MOP.isKill() {
                self.DefinedInBB.addReg(MOP.getReg().operator MCRegister());
            }
        }
    }
    let mut CopyImplicitOps: Closure_5 = Closure_5 { MIB: &mut MIB };
    CopyImplicitOps.call(I, Paired);
    operator(I).eraseFromParent();
    operator(Paired).eraseFromParent();
    return NextI;
}

fn AArch64LoadStoreOpt::promoteLoadFromStore(self, LoadI: iterator, StoreI: iterator) -> iterator {
    let mut NextI: iterator = next_nodbg(LoadI, operator(LoadI).getParent().end(), true);
    let mut LoadSize: i32 = self.TII.getMemScale(operator(LoadI));
    let mut StoreSize: i32 = self.TII.getMemScale(operator(StoreI));
    let mut LdRt: Register = getLdStRegOp(operator(LoadI), 0).getReg();
    let mut StMO: *MachineOperand = getLdStRegOp(operator(StoreI), 0);
    let mut StRt: Register = getLdStRegOp(operator(StoreI), 0).getReg();
    let mut IsStoreXReg: bool = self.TRI.getRegClass(GPR64RegClassID).contains(StRt.operator MCRegister());
    assert!((IsStoreXReg || self.TRI.getRegClass(GPR32RegClassID).contains(StRt.operator MCRegister())), "Unexpected RegClass");
    let mut BitExtMI: *mut MachineInstr = null;
    if LoadSize == StoreSize && (LoadSize == 4 || LoadSize == 8) {
        if StRt == LdRt && LoadSize == 8 {
            for MI in make_range(operator(StoreI).getIterator(), operator(LoadI).getIterator()) {
                if MI.killsRegister(StRt, self.TRI) {
                    MI.clearRegisterKills(StRt, self.TRI);
                    break;
                }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "Remove load instruction:\n    ";
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    operator(LoadI).print(dbgs(), true, false, false, true, null);
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
            operator(LoadI).eraseFromParent();
            return NextI;
        }
        BitExtMI = BuildMI(*operator(LoadI).getParent(), LoadI, MIMetadata { DL: operator(LoadI).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if IsStoreXReg { ORRXrs } else { ORRWrs }), LdRt).addReg(if IsStoreXReg { XZR } else { WZR }, RegState {}, 0).add(StMO).addImm(getShifterImm(LSL, 0)).setMIFlags(operator(LoadI).getFlags()).operator llvm::MachineInstr *();
    } else {
        if !self.Subtarget.isLittleEndian() {
            return NextI;
        }
        let mut IsUnscaled: bool = self.TII.hasUnscaledLdStOffset(operator(LoadI));
        assert!(IsUnscaled == self.TII.hasUnscaledLdStOffset(operator(StoreI)), "Unsupported ld/st match");
        assert!(LoadSize <= StoreSize, "Invalid load size");
        let mut UnscaledLdOffset: i32 = if IsUnscaled { getLdStOffsetOp(operator(LoadI)).getImm() } else { getLdStOffsetOp(operator(LoadI)).getImm() * LoadSize };
        let mut UnscaledStOffset: i32 = if IsUnscaled { getLdStOffsetOp(operator(StoreI)).getImm() } else { getLdStOffsetOp(operator(StoreI)).getImm() * StoreSize };
        let mut Width: i32 = LoadSize * 8;
        let mut DestReg: Register = if IsStoreXReg { self.TRI.getMatchingSuperReg(LdRt.operator MCRegister(), sub_32, &mut GPR64RegClass) } else { LdRt };
        assert!((UnscaledLdOffset >= UnscaledStOffset && (UnscaledLdOffset + LoadSize) <= UnscaledStOffset + StoreSize), "Invalid offset");
        let mut Immr: i32 = 8 * (UnscaledLdOffset - UnscaledStOffset);
        let mut Imms: i32 = Immr + Width - 1;
        if UnscaledLdOffset == UnscaledStOffset {
            let mut AndMaskEncoded: u32 = ((if IsStoreXReg { 1 } else { 0 }) << 12) | ((Immr) << 6) | ((Imms) << 0);
            BitExtMI = BuildMI(*operator(LoadI).getParent(), LoadI, MIMetadata { DL: operator(LoadI).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if IsStoreXReg { ANDXri } else { ANDWri }), DestReg).add(StMO).addImm(AndMaskEncoded).setMIFlags(operator(LoadI).getFlags()).operator llvm::MachineInstr *();
        } else if IsStoreXReg && Imms == 31 {
            assert!(Immr <= Imms, "Expected LSR alias of UBFM");
            BitExtMI = BuildMI(*operator(LoadI).getParent(), LoadI, MIMetadata { DL: operator(LoadI).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(UBFMWri), self.TRI.getSubReg(DestReg.operator MCRegister(), sub_32)).addReg(self.TRI.getSubReg(StRt.operator MCRegister(), sub_32), RegState {}, 0).addImm(Immr).addImm(Imms).setMIFlags(operator(LoadI).getFlags()).operator llvm::MachineInstr *();
        } else {
            BitExtMI = BuildMI(*operator(LoadI).getParent(), LoadI, MIMetadata { DL: operator(LoadI).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if IsStoreXReg { UBFMXri } else { UBFMWri }), DestReg).add(StMO).addImm(Immr).addImm(Imms).setMIFlags(operator(LoadI).getFlags()).operator llvm::MachineInstr *();
        }
    }
    for MI in make_range(operator(StoreI).getIterator(), BitExtMI.getIterator()) {
        if MI.killsRegister(StRt, self.TRI) {
            MI.clearRegisterKills(StRt, self.TRI);
            break;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "Promoting load by replacing :\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(StoreI).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(LoadI).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "  with instructions:\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(StoreI).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            (BitExtMI).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "\n";
        }
    }
        if !(false) { break; }
    }
    operator(LoadI).eraseFromParent();
    return NextI;
}

fn inBoundsForPair(IsUnscaled: bool, Offset: i32, OffsetStride: i32) -> bool {
    if IsUnscaled {
        if Offset % OffsetStride {
            return false;
        }
        Offset /= OffsetStride;
    }
    return Offset <= 63 && Offset >= -64;
}

fn alignTo(Num: i32, PowOf2: i32) -> i32 {
    return (Num + PowOf2 - 1) & ~(PowOf2 - 1);
}

fn mayAlias(MIa: *mut MachineInstr, MemInsns: *mut SmallVectorImpl<MachineInstr *>, AA: *mut AliasAnalysis) -> bool {
    for MIb in MemInsns {
        if MIa.mayAlias(AA, *MIb, false) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "Aliasing with: ";
                    MIb.dump();
                }
            }
                if !(false) { break; }
            }
            return true;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "No aliases found\n";
        }
    }
        if !(false) { break; }
    }
    return false;
}

fn AArch64LoadStoreOpt::findMatchingStore(self, I: iterator, Limit: u32, StoreI: *mut iterator) -> bool {
    let mut B: iterator = operator(I).getParent().begin();
    let mut MBBI: iterator = I;
    let mut LoadMI: *mut MachineInstr = operator(I);
    let mut BaseReg: Register = getLdStBaseOp(LoadMI).getReg();
    if MBBI == B {
        return false;
    }
    self.ModifiedRegUnits.clear();
    self.UsedRegUnits.clear();
    let mut Count: u32 = 0;
    while true {
        {
        MBBI = prev_nodbg(MBBI, B, true);
        let mut MI: *mut MachineInstr = operator(MBBI);
        if !MI.isTransient() {
            Count += 1;
        }
        if MI.mayStore(AnyInBundle) && isMatchingStore(LoadMI, MI) && BaseReg == getLdStBaseOp(MI).getReg() && getLdStOffsetOp(MI).isImm() && isLdOffsetInRangeOfSt(LoadMI, MI, self.TII) && self.ModifiedRegUnits.available(getLdStRegOp(MI, 0).getReg().operator MCRegister()) {
            StoreI = MBBI;
            return true;
        }
        if MI.isCall(AnyInBundle) {
            return false;
        }
        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
        if !self.ModifiedRegUnits.available(BaseReg.operator MCRegister()) {
            return false;
        }
        if MI.mayStore(AnyInBundle) && LoadMI.mayAlias(self.AA, MI, false) {
            return false;
        }
    }
        if !(MBBI != B && Count < Limit) { break; }
    }
    return false;
}

fn needsWinCFI(MF: *MachineFunction) -> bool {
    return MF.getTarget().getMCAsmInfo().usesWindowsCFI() && MF.getFunction().needsUnwindTableEntry();
}

fn areCandidatesToMergeOrPair(FirstMI: *mut MachineInstr, MI: *mut MachineInstr, Flags: *mut LdStPairFlags, TII: *AArch64InstrInfo) -> bool {
    if MI.hasOrderedMemoryRef() || TII.isLdStPairSuppressed(MI) {
        return false;
    }
    assert!(!FirstMI.hasOrderedMemoryRef() && !TII.isLdStPairSuppressed(FirstMI), "FirstMI shouldn't get here if either of these checks are true.");
    if needsWinCFI(MI.getMF()) && (MI.getFlag(FrameSetup) || MI.getFlag(FrameDestroy)) {
        return false;
    }
    let mut OpcA: u32 = FirstMI.getOpcode();
    let mut OpcB: u32 = MI.getOpcode();
    if OpcA == OpcB {
        return !isPreLdSt(FirstMI);
    }
    if OpcA == LDR_ZXI || OpcA == STR_ZXI || OpcB == LDR_ZXI || OpcB == STR_ZXI {
        return false;
    }
    if isPreLdSt(FirstMI) && isPreLdSt(MI) {
        return false;
    }
    let mut IsValidLdStrOpc: bool = false;
    let mut PairIsValidLdStrOpc: bool = false;
    let mut NonSExtOpc: u32 = getMatchingNonSExtOpcode(OpcA, &mut IsValidLdStrOpc);
    assert!(IsValidLdStrOpc, "Given Opc should be a Load or Store with an immediate");
    if NonSExtOpc == getMatchingNonSExtOpcode(OpcB, &mut PairIsValidLdStrOpc) {
        Flags.setSExtIdx(if NonSExtOpc == OpcA { 1 } else { 0 });
        return true;
    }
    if !PairIsValidLdStrOpc {
        return false;
    }
    if isNarrowStore(OpcA) || isNarrowStore(OpcB) {
        return getLdStRegOp(FirstMI, 0).getReg() == WZR && getLdStRegOp(MI, 0).getReg() == WZR && TII.getMemScale(FirstMI) == TII.getMemScale(MI);
    }
    if isPreLdStPairCandidate(FirstMI, MI) {
        return true;
    }
    return TII.hasUnscaledLdStOffset(OpcA) != TII.hasUnscaledLdStOffset(OpcB) && getMatchingPairOpcode(OpcA) == getMatchingPairOpcode(OpcB);
}

fn canRenameMOP(MI: *MachineInstr, MOP: *MachineOperand, TRI: *TargetRegisterInfo) -> bool {
    if MOP.isReg() {
        let mut RegClass: *TargetRegisterClass = TRI.getMinimalPhysRegClass(MOP.getReg().operator MCRegister());
        if RegClass.HasDisjunctSubRegs && RegClass.CoveredBySubRegs && (TRI.getSubRegisterClass(RegClass, dsub0) || TRI.getSubRegisterClass(RegClass, qsub0) || TRI.getSubRegisterClass(RegClass, zsub0)) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "  Cannot rename operands with multiple disjunct subregisters (" << MOP << ")\n";
                }
            }
                if !(false) { break; }
            }
            return false;
        }
        if MOP.isImplicit() && MOP.isDef() {
            if !isRewritableImplicitDef(MI, MOP) {
                return false;
            }
            return TRI.isSuperOrSubRegisterEq(MI.getOperand(0).getReg().operator MCRegister(), MOP.getReg().operator MCRegister());
        }
    }
    return MOP.isImplicit() || (MOP.isRenamable() && !MOP.isEarlyClobber() && !MOP.isTied());
}

fn canRenameUpToDef(FirstMI: *mut MachineInstr, UsedInBetween: *mut LiveRegUnits, RequiredClasses: *SmallPtrSetImpl<const TargetRegisterClass *>, TRI: *TargetRegisterInfo) -> bool {
    if !FirstMI.mayStore(AnyInBundle) {
        return false;
    }
    let mut RegToRename: Register = getLdStRegOp(FirstMI, 0).getReg();
    if !getLdStRegOp(FirstMI, 0).isKill() && !any_of(FirstMI.operands(), Closure_6 { TRI: TRI, cap_1: RegToRename }) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                dbgs() << "  Operand not killed at " << FirstMI;
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut FoundDef: bool = false;
    let mut CheckMIs: function<bool (MachineInstr &, bool)> = Closure_7 { UsedInBetween: &mut UsedInBetween, FoundDef: &mut FoundDef, TRI: &mut TRI, RegToRename: &mut RegToRename, RequiredClasses: &mut RequiredClasses };
    if !forAllMIsUntilDef(FirstMI, RegToRename.operator unsigned int(), TRI, LdStLimit.operator unsigned int(), CheckMIs) {
        return false;
    }
    if !FoundDef {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                dbgs() << "  Did not find definition for register in BB\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    return true;
}

fn canRenameUntilSecondLoad(FirstLoad: *mut MachineInstr, SecondLoad: *mut MachineInstr, UsedInBetween: *mut LiveRegUnits, RequiredClasses: *SmallPtrSetImpl<const TargetRegisterClass *>, TRI: *TargetRegisterInfo) -> bool {
    if FirstLoad.isPseudo(IgnoreBundle) {
        return false;
    }
    UsedInBetween.accumulate(FirstLoad);
    let mut RegToRename: Register = getLdStRegOp(FirstLoad, 0).getReg();
    let mut Success: bool = all_of(FirstLoad.getIterator(), SecondLoad.getIterator(), Closure_8 { TRI: &mut TRI, RegToRename: &mut RegToRename, RequiredClasses: &mut RequiredClasses });
    return Success;
}

fn tryToFindRegisterToRename(MF: *MachineFunction, Reg: Register, DefinedInBB: *mut LiveRegUnits, UsedInBetween: *mut LiveRegUnits, RequiredClasses: *SmallPtrSetImpl<const TargetRegisterClass *>, TRI: *TargetRegisterInfo) -> optional<MCPhysReg> {
    let mut RegInfo: *MachineRegisterInfo = MF.getRegInfo();
    let mut AnySubOrSuperRegCalleePreserved: Closure_9 = Closure_9 { MF: &mut MF, TRI: TRI };
    let mut CanBeUsedForAllClasses: Closure_11 = Closure_11 { RequiredClasses: &mut RequiredClasses, TRI: TRI };
    let mut RegClass: *TargetRegisterClass = TRI.getMinimalPhysRegClass(Reg.operator MCRegister());
    for PR in *RegClass {
        if DefinedInBB.available(PR) && UsedInBetween.available(PR) && !RegInfo.isReserved(PR) && !AnySubOrSuperRegCalleePreserved.call(PR) && CanBeUsedForAllClasses.call(PR) {
            DefinedInBB.addReg(PR);
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "Found rename register " << printReg(PR, TRI, 0, null) << "\n";
                }
            }
                if !(false) { break; }
            }
            return PR;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "No rename register found from " << TRI.getRegClassName(RegClass) << "\n";
        }
    }
        if !(false) { break; }
    }
    return nullopt;
}

fn findRenameRegForSameLdStRegPair(MaybeCanRename: optional<bool>, FirstMI: *mut MachineInstr, MI: *mut MachineInstr, Reg: Register, DefinedInBB: *mut LiveRegUnits, UsedInBetween: *mut LiveRegUnits, RequiredClasses: *SmallPtrSetImpl<const TargetRegisterClass *>, TRI: *TargetRegisterInfo) -> optional<MCPhysReg> {
    let mut RenameReg: optional<MCPhysReg> = optional<MCPhysReg> {};
    if !shouldExecute(RegRenamingCounter) {
        return RenameReg;
    }
    let mut RegClass: *TargetRegisterClass = TRI.getMinimalPhysRegClass(getLdStRegOp(FirstMI, 0).getReg().operator MCRegister());
    let mut MF: *mut MachineFunction = *FirstMI.getParent().getParent();
    if !RegClass || !MF.getRegInfo().tracksLiveness() {
        return RenameReg;
    }
    let mut IsLoad: bool = FirstMI.mayLoad(AnyInBundle);
    if !MaybeCanRename {
        if IsLoad {
            MaybeCanRename = canRenameUntilSecondLoad(FirstMI, MI, UsedInBetween, RequiredClasses, TRI);
        } else {
            MaybeCanRename = canRenameUpToDef(FirstMI, UsedInBetween, RequiredClasses, TRI);
        }
    }
    if operator(MaybeCanRename) {
        RenameReg = tryToFindRegisterToRename(MF, Reg, DefinedInBB, UsedInBetween, RequiredClasses, TRI);
    }
    return RenameReg;
}

fn AArch64LoadStoreOpt::findMatchingInsn(self, I: iterator, Flags: *mut LdStPairFlags, Limit: u32, FindNarrowMerge: bool) -> iterator {
    let mut E: iterator = operator(I).getParent().end();
    let mut MBBI: iterator = I;
    let mut FirstMI: *mut MachineInstr = operator(I);
    MBBI = next_nodbg(MBBI, E, true);
    let mut MayLoad: bool = FirstMI.mayLoad(AnyInBundle);
    let mut IsUnscaled: bool = self.TII.hasUnscaledLdStOffset(FirstMI);
    let mut Reg: Register = getLdStRegOp(FirstMI, 0).getReg();
    let mut BaseReg: Register = getLdStBaseOp(FirstMI).getReg();
    let mut Offset: i32 = getLdStOffsetOp(FirstMI).getImm();
    let mut OffsetStride: i32 = if IsUnscaled { self.TII.getMemScale(FirstMI) } else { 1 };
    let mut IsPromotableZeroStore: bool = isPromotableZeroStoreInst(FirstMI);
    let mut MaybeCanRename: optional<bool> = optional<bool> {};
    if !EnableRenaming {
        MaybeCanRename = false;
    }
    let mut RequiredClasses: SmallPtrSet<const TargetRegisterClass *, 5> = SmallPtrSet<const TargetRegisterClass *, 5> {};
    let mut UsedInBetween: LiveRegUnits = LiveRegUnits {};
    UsedInBetween.init(*self.TRI);
    Flags.clearRenameReg();
    self.ModifiedRegUnits.clear();
    self.UsedRegUnits.clear();
    let mut MemInsns: SmallVector<MachineInstr *, 4> = SmallVector<MachineInstr *, 4> {};
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "Find match for: ";
            FirstMI.dump();
        }
    }
        if !(false) { break; }
    }
    for let mut Count: u32 = 0; MBBI != E && Count < Limit; MBBI = next_nodbg(MBBI, E, true) {
        let mut MI: *mut MachineInstr = operator(MBBI);
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                dbgs() << "Analysing 2nd insn: ";
                MI.dump();
            }
        }
            if !(false) { break; }
        }
        UsedInBetween.accumulate(MI);
        if !MI.isTransient() {
            Count += 1;
        }
        Flags.setSExtIdx(-1);
        if areCandidatesToMergeOrPair(FirstMI, MI, Flags, self.TII) && getLdStOffsetOp(MI).isImm() {
            assert!(MI.mayLoadOrStore(AnyInBundle), "Expected memory operation.");
            let mut MIBaseReg: Register = getLdStBaseOp(MI).getReg();
            let mut MIOffset: i32 = getLdStOffsetOp(MI).getImm();
            let mut MIIsUnscaled: bool = self.TII.hasUnscaledLdStOffset(MI);
            if IsUnscaled != MIIsUnscaled {
                let mut MemSize: i32 = self.TII.getMemScale(MI);
                if MIIsUnscaled {
                    if MIOffset % MemSize {
                        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
                        MemInsns.push(&mut MI);
                        continue;
                    }
                    MIOffset /= MemSize;
                } else {
                    MIOffset *= MemSize;
                }
            }
            let mut IsPreLdSt: bool = isPreLdStPairCandidate(FirstMI, MI);
            if BaseReg == MIBaseReg {
                if IsPreLdSt {
                    let mut IsOutOfBounds: bool = MIOffset != self.TII.getMemScale(MI);
                    let mut IsBaseRegUsed: bool = !self.UsedRegUnits.available(getLdStBaseOp(MI).getReg().operator MCRegister());
                    let mut IsBaseRegModified: bool = !self.ModifiedRegUnits.available(getLdStBaseOp(MI).getReg().operator MCRegister());
                    let mut IsMIRegTheSame: bool = self.TRI.regsOverlap(getLdStRegOp(MI, 0).getReg(), getLdStBaseOp(MI).getReg());
                    if IsOutOfBounds || IsBaseRegUsed || IsBaseRegModified || IsMIRegTheSame {
                        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
                        MemInsns.push(&mut MI);
                        continue;
                    }
                } else {
                    if (Offset != MIOffset + OffsetStride) && (Offset + OffsetStride != MIOffset) {
                        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
                        MemInsns.push(&mut MI);
                        continue;
                    }
                }
                let mut MinOffset: i32 = if Offset < MIOffset { Offset } else { MIOffset };
                if FindNarrowMerge {
                    if (!IsUnscaled && alignTo(MinOffset, 2) != MinOffset) || (IsPromotableZeroStore && Reg != getLdStRegOp(MI, 0).getReg()) {
                        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
                        MemInsns.push(&mut MI);
                        continue;
                    }
                } else {
                    if !inBoundsForPair(IsUnscaled, MinOffset, OffsetStride) {
                        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
                        MemInsns.push(&mut MI);
                        while true {
                            {
                            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                                dbgs() << "Offset doesn't fit in immediate, " << "keep looking.\n";
                            }
                        }
                            if !(false) { break; }
                        }
                        continue;
                    }
                    if IsUnscaled && (alignTo(MinOffset, OffsetStride) != MinOffset) {
                        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
                        MemInsns.push(&mut MI);
                        while true {
                            {
                            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                                dbgs() << "Offset doesn't fit due to alignment requirements, " << "keep looking.\n";
                            }
                        }
                            if !(false) { break; }
                        }
                        continue;
                    }
                }
                if !self.ModifiedRegUnits.available(BaseReg.operator MCRegister()) {
                    return E;
                }
                let mut SameLoadReg: bool = MayLoad && self.TRI.isSuperOrSubRegisterEq(Reg.operator MCRegister(), getLdStRegOp(MI, 0).getReg().operator MCRegister());
                let mut RtNotModified: bool = self.ModifiedRegUnits.available(getLdStRegOp(MI, 0).getReg().operator MCRegister());
                let mut RtNotUsed: bool = !(MI.mayLoad(AnyInBundle) && !SameLoadReg && !self.UsedRegUnits.available(getLdStRegOp(MI, 0).getReg().operator MCRegister()));
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                        dbgs() << "Checking, can combine 2nd into 1st insn:\n" << "Reg '" << getLdStRegOp(MI, 0) << "' not modified: " << (if RtNotModified { "true" } else { "false" }) << "\n" << "Reg '" << getLdStRegOp(MI, 0) << "' not used: " << (if RtNotUsed { "true" } else { "false" }) << "\n";
                    }
                }
                    if !(false) { break; }
                }
                if RtNotModified && RtNotUsed && !mayAlias(MI, MemInsns, self.AA) {
                    if SameLoadReg {
                        let mut RenameReg: optional<MCPhysReg> = findRenameRegForSameLdStRegPair(MaybeCanRename, FirstMI, MI, Reg, self.DefinedInBB, UsedInBetween, RequiredClasses, self.TRI);
                        if !RenameReg {
                            accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
                            MemInsns.push(&mut MI);
                            while true {
                                {
                                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                                    dbgs() << "Can't find reg for renaming, " << "keep looking.\n";
                                }
                            }
                                if !(false) { break; }
                            }
                            continue;
                        }
                        Flags.setRenameReg(operator(RenameReg));
                    }
                    Flags.setMergeForward(false);
                    if !SameLoadReg {
                        Flags.clearRenameReg();
                    }
                    return MBBI;
                }
                RtNotModified = !(MayLoad && !self.UsedRegUnits.available(getLdStRegOp(FirstMI, 0).getReg().operator MCRegister()));
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                        dbgs() << "Checking, can combine 1st into 2nd insn:\n" << "Reg '" << getLdStRegOp(FirstMI, 0) << "' not modified: " << (if RtNotModified { "true" } else { "false" }) << "\n";
                    }
                }
                    if !(false) { break; }
                }
                if RtNotModified && !mayAlias(FirstMI, MemInsns, self.AA) {
                    if self.ModifiedRegUnits.available(getLdStRegOp(FirstMI, 0).getReg().operator MCRegister()) {
                        Flags.setMergeForward(true);
                        Flags.clearRenameReg();
                        return MBBI;
                    }
                    let mut RenameReg: optional<MCPhysReg> = findRenameRegForSameLdStRegPair(MaybeCanRename, FirstMI, MI, Reg, self.DefinedInBB, UsedInBetween, RequiredClasses, self.TRI);
                    if RenameReg {
                        Flags.setMergeForward(true);
                        Flags.setRenameReg(operator(RenameReg));
                        return MBBI;
                    }
                }
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                        dbgs() << "Unable to combine these instructions due to " << "interference in between, keep looking.\n";
                    }
                }
                    if !(false) { break; }
                }
            }
        }
        if MI.isCall(AnyInBundle) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "Found a call, stop looking.\n";
                }
            }
                if !(false) { break; }
            }
            return E;
        }
        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
        if !self.ModifiedRegUnits.available(BaseReg.operator MCRegister()) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "Base reg is modified, stop looking.\n";
                }
            }
                if !(false) { break; }
            }
            return E;
        }
        if MI.mayLoadOrStore(AnyInBundle) {
            MemInsns.push(&mut MI);
        }
    }
    return E;
}

fn maybeMoveCFI(MI: *mut MachineInstr, MaybeCFI: iterator) -> iterator {
    assert!((MI.getOpcode() == SUBXri || MI.getOpcode() == ADDXri), "Expected a register update instruction");
    let mut End: iterator = MI.getParent().end();
    if MaybeCFI == End || operator(MaybeCFI).getOpcode() != CFI_INSTRUCTION || !(MI.getFlag(FrameSetup) || MI.getFlag(FrameDestroy)) || MI.getOperand(0).getReg() != SP {
        return End;
    }
    let mut MF: *MachineFunction = *MI.getParent().getParent();
    let mut CFIIndex: u32 = operator(MaybeCFI).getOperand(0).getCFIIndex();
    let mut CFI: *MCCFIInstruction = MF.getFrameInstructions()[CFIIndex];
    match CFI.getOperation() {
        OpDefCfa => {
            OpDefCfaOffset;
        },
        _ => {
            return End;
        },
    }
}

fn AArch64LoadStoreOpt::mergeUpdateInsn(self, I: iterator, Update: iterator, IsForward: bool, IsPreIdx: bool, MergeEither: bool) -> iterator> {
    assert!((operator(Update).getOpcode() == ADDXri || operator(Update).getOpcode() == SUBXri), "Unexpected base register update instruction to merge!");
    let mut E: iterator = operator(I).getParent().end();
    let mut NextI: iterator = next_nodbg(I, E, true);
    let mut InsertPt: iterator = I;
    if IsForward {
        assert!(IsPreIdx);
        let mut CFI: iterator = maybeMoveCFI(operator(Update), next_nodbg(Update, E, true));
        if CFI != E {
            if MergeEither {
                InsertPt = Update;
            } else {
                if any_of(next(CFI, 1), I, Closure_14 {}) {
                    return nullopt;
                }
                let mut MBB: *mut MachineBasicBlock = operator(InsertPt).getParent();
                MBB.splice(next(InsertPt, 1), MBB, CFI);
            }
        }
    }
    if NextI == Update {
        NextI = next_nodbg(NextI, E, true);
    }
    let mut Value: i32 = operator(Update).getOperand(2).getImm();
    assert!(getShiftValue(operator(Update).getOperand(3).getImm()) == 0, "Can't merge 1 << 12 offset into pre-/post-indexed load / store");
    if operator(Update).getOpcode() == SUBXri {
        Value = -Value;
    }
    let mut NewOpc: u32 = if IsPreIdx { getPreIndexedOpcode(operator(I).getOpcode()) } else { getPostIndexedOpcode(operator(I).getOpcode()) };
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    let mut Scale: i32 = 0;
    let mut MinOffset: i32 = 0;
    let mut MaxOffset: i32 = 0;
    getPrePostIndexedMemOpInfo(operator(I), Scale, MinOffset, MaxOffset);
    if !isPairedLdSt(operator(I)) {
        MIB = BuildMI(*operator(InsertPt).getParent(), InsertPt, MIMetadata { DL: operator(InsertPt).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc)).add(operator(Update).getOperand(0)).add(getLdStRegOp(operator(I), 0)).add(getLdStBaseOp(operator(I))).addImm(Value / Scale).setMemRefs(operator(I).memoperands()).setMIFlags(operator(I).mergeFlagsWith(operator(Update)));
    } else {
        MIB = BuildMI(*operator(InsertPt).getParent(), InsertPt, MIMetadata { DL: operator(InsertPt).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc)).add(operator(Update).getOperand(0)).add(getLdStRegOp(operator(I), 0)).add(getLdStRegOp(operator(I), 1)).add(getLdStBaseOp(operator(I))).addImm(Value / Scale).setMemRefs(operator(I).memoperands()).setMIFlags(operator(I).mergeFlagsWith(operator(Update)));
    }
    if IsPreIdx {
        operator(NumPreFolded);
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                dbgs() << "Creating pre-indexed load/store.";
            }
        }
            if !(false) { break; }
        }
    } else {
        operator(NumPostFolded);
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                dbgs() << "Creating post-indexed load/store.";
            }
        }
            if !(false) { break; }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    Replacing instructions:\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(I).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(Update).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "  with instruction:\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            (MIB.operator llvm::MachineInstr *() as *mut MachineInstr).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "\n";
        }
    }
        if !(false) { break; }
    }
    operator(I).eraseFromParent();
    operator(Update).eraseFromParent();
    return NextI;
}

fn AArch64LoadStoreOpt::mergeConstOffsetInsn(self, I: iterator, Update: iterator, Offset: u32, Scale: i32) -> iterator {
    assert!((operator(Update).getOpcode() == MOVKWi), "Unexpected const mov instruction to merge!");
    let mut E: iterator = operator(I).getParent().end();
    let mut NextI: iterator = next_nodbg(I, E, true);
    let mut PrevI: iterator = prev_nodbg(Update, E, true);
    let mut MemMI: *mut MachineInstr = operator(I);
    let mut Mask: u32 = (1 << 12) * Scale - 1;
    let mut Low: u32 = Offset & Mask;
    let mut High: u32 = Offset - Low;
    let mut BaseReg: Register = getLdStBaseOp(MemMI).getReg();
    let mut IndexReg: Register = getLdStOffsetOp(MemMI).getReg();
    let mut AddMIB: MachineInstrBuilder = MachineInstrBuilder {};
    let mut MemMIB: MachineInstrBuilder = MachineInstrBuilder {};
    AddMIB = BuildMI(*operator(I).getParent(), I, MIMetadata { DL: operator(I).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ADDXri)).addDef(IndexReg, RegState {}, 0).addUse(BaseReg, RegState {}, 0).addImm(High >> 12).addImm(12);
    AddMIB as void;
    let mut NewOpc: u32 = getBaseAddressOpcode(operator(I).getOpcode());
    MemMIB = BuildMI(*operator(I).getParent(), I, MIMetadata { DL: operator(I).getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc)).add(getLdStRegOp(MemMI, 0)).add(getLdStOffsetOp(MemMI)).addImm(Low / Scale).setMemRefs(operator(I).memoperands()).setMIFlags(operator(I).mergeFlagsWith(operator(Update)));
    MemMIB as void;
    operator(NumConstOffsetFolded);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "Creating base address load/store.\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    Replacing instructions:\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(PrevI).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(Update).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            operator(I).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "  with instruction:\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            (AddMIB.operator llvm::MachineInstr *() as *mut MachineInstr).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            (MemMIB.operator llvm::MachineInstr *() as *mut MachineInstr).print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "\n";
        }
    }
        if !(false) { break; }
    }
    operator(I).eraseFromParent();
    operator(PrevI).eraseFromParent();
    operator(Update).eraseFromParent();
    return NextI;
}

fn AArch64LoadStoreOpt::isMatchingUpdateInsn(self, MemMI: *mut MachineInstr, MI: *mut MachineInstr, BaseReg: u32, Offset: i32) -> bool {
    match MI.getOpcode() {
        _ => {
            break;
        },
        SUBXri => {
            ADDXri;
        },
    }
    return false;
}

fn AArch64LoadStoreOpt::isMatchingMovConstInsn(self, MemMI: *mut MachineInstr, MI: *mut MachineInstr, IndexReg: u32, Offset: *mut u32) -> bool {
    if MI.getOpcode() == MOVKWi && self.TRI.isSuperOrSubRegisterEq(IndexReg, MI.getOperand(1).getReg().operator MCRegister()) {
        let mut B: iterator = MI.getParent().begin();
        let mut MBBI: iterator = &mut MI;
        if MBBI == B {
            return false;
        }
        MBBI = prev_nodbg(MBBI, B, true);
        let mut MovzMI: *mut MachineInstr = operator(MBBI);
        if MovzMI.getOpcode() == MOVZWi && MovzMI.getOperand(0).getReg() == MI.getOperand(0).getReg() {
            let mut Low: u32 = MovzMI.getOperand(1).getImm();
            let mut High: u32 = MI.getOperand(2).getImm() << MI.getOperand(3).getImm();
            Offset = High + Low;
            return Offset >> 24 == 0;
        }
    }
    return false;
}

fn AArch64LoadStoreOpt::findMatchingUpdateInsnForward(self, I: iterator, UnscaledOffset: i32, Limit: u32) -> iterator {
    let mut E: iterator = operator(I).getParent().end();
    let mut MemMI: *mut MachineInstr = operator(I);
    let mut MBBI: iterator = I;
    let mut BaseReg: Register = getLdStBaseOp(MemMI).getReg();
    let mut MIUnscaledOffset: i32 = getLdStOffsetOp(MemMI).getImm() * self.TII.getMemScale(MemMI);
    if MIUnscaledOffset != UnscaledOffset {
        return E;
    }
    if !isTagStore(MemMI) && MemMI.getOpcode() != STGPi {
        let mut IsPairedInsn: bool = isPairedLdSt(MemMI);
        for let mut i: u32 = 0;
let mut e: u32 = if IsPairedInsn { 2 } else { 1 }; i != e; i += 1 {
            let mut DestReg: Register = getLdStRegOp(MemMI, i).getReg();
            if DestReg == BaseReg || self.TRI.isSubRegister(BaseReg.operator MCRegister(), DestReg.operator MCRegister()) {
                return E;
            }
        }
    }
    self.ModifiedRegUnits.clear();
    self.UsedRegUnits.clear();
    MBBI = next_nodbg(MBBI, E, true);
    let mut BaseRegSP: bool = BaseReg == SP;
    if BaseRegSP && needsWinCFI(operator(I).getMF()) {
        return E;
    }
    let mut Count: u32 = 0;
    let mut CurMBB: *mut MachineBasicBlock = operator(I).getParent();
    let mut VisitSucc: bool = CurMBB.getParent().getRegInfo().tracksLiveness();
    while true {
        for let mut CurEnd: iterator = CurMBB.end(); MBBI != CurEnd && Count < Limit; MBBI = next_nodbg(MBBI, CurEnd, true) {
            let mut MI: *mut MachineInstr = operator(MBBI);
            if !MI.isTransient() {
                Count += 1;
            }
            if self.isMatchingUpdateInsn(operator(I), MI, BaseReg.operator unsigned int(), UnscaledOffset) {
                return MBBI;
            }
            accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
            if !self.ModifiedRegUnits.available(BaseReg.operator MCRegister()) || !self.UsedRegUnits.available(BaseReg.operator MCRegister()) || (BaseRegSP && operator(MBBI).mayLoadOrStore(AnyInBundle)) {
                return E;
            }
        }
        if !VisitSucc || Limit <= Count {
            break;
        }
        let mut SuccToVisit: *mut MachineBasicBlock = null;
        let mut LiveSuccCount: u32 = 0;
        for Succ in CurMBB.successors() {
            for let mut AI: MCRegAliasIterator = MCRegAliasIterator { BaseReg.operator MCRegister(), self.TRI, true }; AI.isValid(); operator(AI) {
                if Succ.isLiveIn(operator(AI), getAll()) {
                    if LiveSuccCount += 1 {
                        return E;
                    }
                    if Succ.pred_size() == 1 {
                        SuccToVisit = Succ;
                    }
                    break;
                }
            }
        }
        if !SuccToVisit {
            break;
        }
        CurMBB = SuccToVisit;
        MBBI = CurMBB.begin();
    }
    return E;
}

fn AArch64LoadStoreOpt::findMatchingUpdateInsnBackward(self, I: iterator, Limit: u32, MergeEither: *mut bool) -> iterator {
    let mut B: iterator = operator(I).getParent().begin();
    let mut E: iterator = operator(I).getParent().end();
    let mut MemMI: *mut MachineInstr = operator(I);
    let mut MBBI: iterator = I;
    let mut MF: *mut MachineFunction = *MemMI.getMF();
    let mut BaseReg: Register = getLdStBaseOp(MemMI).getReg();
    let mut Offset: i32 = getLdStOffsetOp(MemMI).getImm();
    let mut IsPairedInsn: bool = isPairedLdSt(MemMI);
    let mut DestReg: [2]Register = [getLdStRegOp(MemMI, 0).getReg(), if IsPairedInsn { getLdStRegOp(MemMI, 1).getReg() } else { Register { Reg: 0 } }];
    if MBBI == B || Offset != 0 {
        return E;
    }
    if !isTagStore(MemMI) {
        for let mut i: u32 = 0;
let mut e: u32 = if IsPairedInsn { 2 } else { 1 }; i != e; i += 1 {
            if DestReg[i] == BaseReg || self.TRI.isSubRegister(BaseReg.operator MCRegister(), DestReg[i].operator MCRegister()) {
                return E;
            }
        }
    }
    let mut BaseRegSP: bool = BaseReg == SP;
    if BaseRegSP && needsWinCFI(operator(I).getMF()) {
        return E;
    }
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    let mut RedZoneSize: u32 = Subtarget.getTargetLowering().getRedZoneSize(MF.getFunction());
    self.ModifiedRegUnits.clear();
    self.UsedRegUnits.clear();
    let mut Count: u32 = 0;
    let mut MemAccessBeforeSPPreInc: bool = false;
    MergeEither = true;
    while true {
        {
        MBBI = prev_nodbg(MBBI, B, true);
        let mut MI: *mut MachineInstr = operator(MBBI);
        if !MI.isTransient() {
            Count += 1;
        }
        if self.isMatchingUpdateInsn(operator(I), MI, BaseReg.operator unsigned int(), Offset) {
            if MemAccessBeforeSPPreInc && operator(MBBI).getOperand(2).getImm() > RedZoneSize {
                return E;
            }
            return MBBI;
        }
        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
        if !self.ModifiedRegUnits.available(BaseReg.operator MCRegister()) || !self.UsedRegUnits.available(BaseReg.operator MCRegister()) {
            return E;
        }
        if MI.mayLoadOrStore(AnyInBundle) || MI.hasUnmodeledSideEffects() || (DestReg[0].isValid() && !(self.ModifiedRegUnits.available(DestReg[0].operator MCRegister()) && self.UsedRegUnits.available(DestReg[0].operator MCRegister()))) || (DestReg[1].isValid() && !(self.ModifiedRegUnits.available(DestReg[1].operator MCRegister()) && self.UsedRegUnits.available(DestReg[1].operator MCRegister()))) {
            MergeEither = false;
        }
        if BaseRegSP && operator(MBBI).mayLoadOrStore(AnyInBundle) {
            MemAccessBeforeSPPreInc = true;
        }
    }
        if !(MBBI != B && Count < Limit) { break; }
    }
    return E;
}

fn AArch64LoadStoreOpt::findMatchingConstOffsetBackward(self, I: iterator, Limit: u32, Offset: *mut u32) -> iterator {
    let mut B: iterator = operator(I).getParent().begin();
    let mut E: iterator = operator(I).getParent().end();
    let mut MemMI: *mut MachineInstr = operator(I);
    let mut MBBI: iterator = I;
    if MBBI == B {
        return E;
    }
    if !getLdStOffsetOp(MemMI).isKill() || !getLdStAmountOp(MemMI).isImm() || (getLdStAmountOp(MemMI).getImm() != 0) {
        return E;
    }
    let mut IndexReg: Register = getLdStOffsetOp(MemMI).getReg();
    self.ModifiedRegUnits.clear();
    self.UsedRegUnits.clear();
    let mut Count: u32 = 0;
    while true {
        {
        MBBI = prev_nodbg(MBBI, B, true);
        let mut MI: *mut MachineInstr = operator(MBBI);
        if !MI.isTransient() {
            Count += 1;
        }
        if self.isMatchingMovConstInsn(operator(I), MI, IndexReg.operator unsigned int(), Offset) {
            return MBBI;
        }
        accumulateUsedDefed(MI, self.ModifiedRegUnits, self.UsedRegUnits, self.TRI);
        if !self.ModifiedRegUnits.available(IndexReg.operator MCRegister()) || !self.UsedRegUnits.available(IndexReg.operator MCRegister()) {
            return E;
        }
    }
        if !(MBBI != B && Count < Limit) { break; }
    }
    return E;
}

fn AArch64LoadStoreOpt::tryToPromoteLoadFromStore(self, MBBI: *mut iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    if MI.hasOrderedMemoryRef() {
        return false;
    }
    if needsWinCFI(MI.getMF()) && MI.getFlag(FrameDestroy) {
        return false;
    }
    if !getLdStOffsetOp(MI).isImm() {
        return false;
    }
    let mut StoreI: iterator = iterator {};
    if self.findMatchingStore(MBBI, LdStLimit.operator unsigned int(), StoreI) {
        operator(NumLoadsFromStoresPromoted);
        MBBI = self.promoteLoadFromStore(MBBI, StoreI);
        return true;
    }
    return false;
}

fn AArch64LoadStoreOpt::tryToMergeZeroStInst(self, MBBI: *mut iterator) -> bool {
    assert!(isPromotableZeroStoreInst(operator(MBBI)), "Expected narrow store.");
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut E: iterator = MI.getParent().end();
    if !self.TII.isCandidateToMergeOrPair(MI) {
        return false;
    }
    let mut Flags: LdStPairFlags = LdStPairFlags {};
    let mut MergeMI: iterator = self.findMatchingInsn(MBBI, Flags, LdStLimit.operator unsigned int(), true);
    if MergeMI != E {
        operator(NumZeroStoresPromoted);
        MBBI = self.mergeNarrowZeroStores(MBBI, MergeMI, Flags);
        return true;
    }
    return false;
}

fn AArch64LoadStoreOpt::tryToPairLdStInst(self, MBBI: *mut iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut E: iterator = MI.getParent().end();
    if !self.TII.isCandidateToMergeOrPair(MI) {
        return false;
    }
    if MI.mayLoad(AnyInBundle) && self.Subtarget.hasDisableLdp() {
        return false;
    }
    if MI.mayStore(AnyInBundle) && self.Subtarget.hasDisableStp() {
        return false;
    }
    let mut IsUnscaled: bool = self.TII.hasUnscaledLdStOffset(MI);
    let mut Offset: i32 = getLdStOffsetOp(MI).getImm();
    let mut OffsetStride: i32 = if IsUnscaled { self.TII.getMemScale(MI) } else { 1 };
    if Offset > 0 {
        Offset -= OffsetStride;
    }
    if !inBoundsForPair(IsUnscaled, Offset, OffsetStride) {
        return false;
    }
    let mut Flags: LdStPairFlags = LdStPairFlags {};
    let mut Paired: iterator = self.findMatchingInsn(MBBI, Flags, LdStLimit.operator unsigned int(), false);
    if Paired == E {
        return false;
    }
    let mut Prev: MachineInstr> = prev(MBBI, 1);
    let mut MemOp: *mut MachineMemOperand = if MI.memoperands_empty() { null } else { MI.memoperands().front() };
    if (MI.mayLoad(AnyInBundle) && self.Subtarget.hasLdpAlignedOnly()) || (MI.mayStore(AnyInBundle) && self.Subtarget.hasStpAlignedOnly()) {
        if !MemOp || !MemOp.getMemoryType().isValid() {
            operator(NumFailedAlignmentCheck, 0);
            return false;
        }
        let mut MemAlignment: u64 = MemOp.getAlign().value();
        let mut TypeAlignment: u64 = MemOp.getSize().getValue().getKnownMinValue().value();
        if MemAlignment < 2 * TypeAlignment {
            operator(NumFailedAlignmentCheck, 0);
            return false;
        }
    }
    operator(NumPairCreated);
    if self.TII.hasUnscaledLdStOffset(MI) {
        operator(NumUnscaledPairCreated);
    }
    MBBI = self.mergePairedInsns(MBBI, Paired, Flags);
    for let mut I: MachineInstr> = next(Prev, 1); I != MBBI; operator(I, 0) {
        updateDefinedRegisters(operator(I), self.DefinedInBB, self.TRI);
    }
    return true;
}

fn AArch64LoadStoreOpt::tryToMergeLdStUpdate(self, MBBI: *mut iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut E: iterator = MI.getParent().end();
    let mut Update: iterator = iterator {};
    if operator(MBBI).hasOrderedMemoryRef() && getLdStBaseOp(MI).getReg() != SP && !isTagStore(MI) && MI.getOpcode() != STGPi {
        return false;
    }
    Update = self.findMatchingUpdateInsnForward(MBBI, 0, UpdateLimit.operator unsigned int());
    if Update != E {
        if self.mergeUpdateInsn(MBBI, Update, false, false, false) {
            NextI;
        } else {
            MBBI = operator(NextI);
            return true;
        }
    }
    if self.TII.hasUnscaledLdStOffset(MI.getOpcode()) {
        return false;
    }
    let mut MergeEither: bool = false;
    Update = self.findMatchingUpdateInsnBackward(MBBI, UpdateLimit.operator unsigned int(), MergeEither);
    if Update != E {
        if self.mergeUpdateInsn(MBBI, Update, true, true, MergeEither) {
            NextI;
        } else {
            MBBI = operator(NextI);
            return true;
        }
    }
    let mut UnscaledOffset: i32 = getLdStOffsetOp(MI).getImm() * self.TII.getMemScale(MI);
    Update = self.findMatchingUpdateInsnForward(MBBI, UnscaledOffset, UpdateLimit.operator unsigned int());
    if Update != E {
        if self.mergeUpdateInsn(MBBI, Update, false, true, false) {
            NextI;
        } else {
            MBBI = operator(NextI);
            return true;
        }
    }
    return false;
}

fn AArch64LoadStoreOpt::tryToMergeIndexLdSt(self, MBBI: *mut iterator, Scale: i32) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut E: iterator = MI.getParent().end();
    let mut Update: iterator = iterator {};
    if self.TII.hasUnscaledLdStOffset(MI.getOpcode()) {
        return false;
    }
    let mut Offset: u32 = 0;
    Update = self.findMatchingConstOffsetBackward(MBBI, LdStConstLimit.operator unsigned int(), Offset);
    if Update != E && (Offset & (Scale - 1)) == 0 {
        MBBI = self.mergeConstOffsetInsn(MBBI, Update, Offset, Scale);
        return true;
    }
    return false;
}

fn getGPRToFPRStoreOpcode(GPRStoreOpc: u32) -> u32 {
    match GPRStoreOpc {
        STRBBui => {
            return STRBui;
        },
        STRHHui => {
            return STRHui;
        },
        STRWui => {
            return STRSui;
        },
        STRXui => {
            return STRDui;
        },
        STURBBi => {
            return STURBi;
        },
        STURHHi => {
            return STURHi;
        },
        STURWi => {
            return STURSi;
        },
        STURXi => {
            return STURDi;
        },
        STRBBroW => {
            return STRBroW;
        },
        STRBBroX => {
            return STRBroX;
        },
        STRHHroW => {
            return STRHroW;
        },
        STRHHroX => {
            return STRHroX;
        },
        STRWroW => {
            return STRSroW;
        },
        STRWroX => {
            return STRSroX;
        },
        STRXroW => {
            return STRDroW;
        },
        STRXroX => {
            return STRDroX;
        },
        _ => {
            return 0;
        },
    }
}

fn getUMOVSubRegIdx(UMOVOpc: u32) -> u32 {
    match UMOVOpc {
        UMOVvi8_idx0 => {
            return bsub;
        },
        UMOVvi16_idx0 => {
            return hsub;
        },
        UMOVvi32_idx0 => {
            return ssub;
        },
        UMOVvi64_idx0 => {
            return dsub;
        },
        _ => {
            return 0;
        },
    }
}

fn AArch64LoadStoreOpt::tryToReplaceUMOVStore(self, MBBI: *mut iterator) -> bool {
    let mut StoreMI: *mut MachineInstr = operator(MBBI);
    let mut FPRStoreOpc: u32 = getGPRToFPRStoreOpcode(StoreMI.getOpcode());
    if !FPRStoreOpc {
        return false;
    }
    if StoreMI.hasOrderedMemoryRef() || StoreMI.memoperands().len != 1 {
        return false;
    }
    let mut MBB: *mut MachineBasicBlock = StoreMI.getParent();
    let mut StoreValReg: MCPhysReg = StoreMI.getOperand(0).getReg().operator unsigned int();
    if !StoreMI.getOperand(0).isKill() {
        return false;
    }
    for let mut I: u32 = 1;
let mut E: u32 = StoreMI.getNumExplicitOperands(); I < E; I += 1 {
        if StoreMI.getOperand(I).isReg() && self.TRI.regsOverlap(StoreMI.getOperand(I).getReg(), StoreValReg) {
            return false;
        }
    }
    let mut UMOVMI: *mut MachineInstr = null;
    let mut B: iterator = MBB.begin();
    let mut SubRegIdx: u32 = 0;
    let mut Count: u32 = 0;
    for let mut It: iterator = MBBI; It != B;  {
        let mut MI: *mut MachineInstr = operator(operator(It));
        if MI.isDebugInstr() {
            continue;
        }
        if Count += 1 > UMOVFoldLimit.operator unsigned int() {
            return false;
        }
        if MI.readsRegister(StoreValReg, self.TRI) {
            return false;
        }
        if MI.modifiesRegister(StoreValReg, self.TRI) {
            SubRegIdx = getUMOVSubRegIdx(MI.getOpcode());
            if !SubRegIdx {
                return false;
            }
            UMOVMI = &mut MI;
            break;
        }
    }
    if !UMOVMI {
        return false;
    }
    let mut VecReg: MCPhysReg = UMOVMI.getOperand(1).getReg().operator unsigned int();
    let mut FPRReg: MCPhysReg = self.TRI.getSubReg(VecReg, SubRegIdx).operator unsigned int();
    if (*StoreMI.memoperands_begin()).getSizeInBits() != self.TRI.getRegSizeInBits(*self.TRI.getMinimalPhysRegClass(FPRReg)) {
        return false;
    }
    let mut VecRegKilled: bool = UMOVMI.killsRegister(VecReg, self.TRI);
    for let mut It: MachineInstr, true, true, void, false, void>, false, false> = next(UMOVMI.getIterator(), 1); It != MBBI; operator(It) {
        if operator(It).modifiesRegister(VecReg, self.TRI) {
            return false;
        }
        if !VecRegKilled && operator(It).killsRegister(VecReg, self.TRI) {
            VecRegKilled = true;
        }
    }
    UMOVMI.clearRegisterKills(VecReg, self.TRI);
    for let mut It: MachineInstr, true, true, void, false, void>, false, false> = next(UMOVMI.getIterator(), 1); It != MBBI; operator(It) {
        operator(It).clearRegisterKills(VecReg, self.TRI);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
            dbgs() << "Folding UMOV + store: " << *UMOVMI << "  + " << StoreMI;
        }
    }
        if !(false) { break; }
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*MBB, MBBI, MIMetadata { DL: StoreMI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(FPRStoreOpc)).addReg(FPRReg, getKillRegState(VecRegKilled), 0);
    for let mut I: u32 = 1;
let mut E: u32 = StoreMI.getNumExplicitOperands(); I < E; I += 1 {
        MIB.add(StoreMI.getOperand(I));
    }
    MIB.setMemRefs(StoreMI.memoperands());
    MBBI = MBB.erase(MBBI);
    UMOVMI.eraseFromParent();
    operator(NumUMOVFoldedToFPRStore);
    return true;
}

fn AArch64LoadStoreOpt::optimizeBlock(self, MBB: *mut MachineBasicBlock, EnableNarrowZeroStOpt: bool) -> bool {
    let mut AFI: *mut AArch64FunctionInfo = *MBB.getParent().getInfo();
    let mut Modified: bool = false;
    for let mut MBBI: iterator = MBB.begin();
let mut E: iterator = MBB.end(); MBBI != E;  {
        if isPromotableLoadFromStore(operator(MBBI)) && self.tryToPromoteLoadFromStore(MBBI) {
            Modified = true;
        } else {
            operator(MBBI);
        }
    }
    if EnableNarrowZeroStOpt {
        for let mut MBBI: iterator = MBB.begin();
let mut E: iterator = MBB.end(); MBBI != E;  {
            if isPromotableZeroStoreInst(operator(MBBI)) && self.tryToMergeZeroStInst(MBBI) {
                Modified = true;
            } else {
                operator(MBBI);
            }
        }
    }
    if MBB.getParent().getRegInfo().tracksLiveness() {
        self.DefinedInBB.clear();
        self.DefinedInBB.addLiveIns(MBB);
    }
    for let mut MBBI: iterator = MBB.begin();
let mut E: iterator = MBB.end(); MBBI != E;  {
        updateDefinedRegisters(operator(MBBI), self.DefinedInBB, self.TRI);
        if self.TII.isPairableLdStInst(operator(MBBI)) && self.tryToPairLdStInst(MBBI) {
            Modified = true;
        } else {
            operator(MBBI);
        }
    }
    for let mut MBBI: iterator = MBB.begin();
let mut E: iterator = MBB.end(); MBBI != E;  {
        if isMergeableLdStUpdate(operator(MBBI), AFI) && self.tryToMergeLdStUpdate(MBBI) {
            Modified = true;
        } else {
            operator(MBBI);
        }
    }
    for let mut MBBI: iterator = MBB.begin();
let mut E: iterator = MBB.end(); MBBI != E;  {
        let mut Scale: i32 = 0;
        if isMergeableIndexLdSt(operator(MBBI), Scale) && self.tryToMergeIndexLdSt(MBBI, Scale) {
            Modified = true;
        } else {
            operator(MBBI);
        }
    }
    for let mut MBBI: iterator = MBB.begin();
let mut E: iterator = MBB.end(); MBBI != E;  {
        if self.tryToReplaceUMOVStore(MBBI) {
            Modified = true;
        } else {
            operator(MBBI);
        }
    }
    return Modified;
}

fn AArch64LoadStoreOpt::runOnMachineFunction(self, Fn: *mut MachineFunction) -> bool {
    self.Subtarget = &mut Fn.getSubtarget();
    self.TII = self.Subtarget.getInstrInfo();
    self.TRI = self.Subtarget.getRegisterInfo();
    self.ModifiedRegUnits.init(*self.TRI);
    self.UsedRegUnits.init(*self.TRI);
    self.DefinedInBB.init(*self.TRI);
    let mut Modified: bool = false;
    let mut enableNarrowZeroStOpt: bool = !self.Subtarget.requiresStrictAlign();
    for MBB in Fn {
        let mut M: bool = self.optimizeBlock(MBB, enableNarrowZeroStOpt);
        Modified |= M;
    }
    return Modified;
}

fn AArch64LoadStoreOptLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut Impl: AArch64LoadStoreOpt = AArch64LoadStoreOpt {};
    Impl.AA = &mut self.getAnalysis().getAAResults();
    return Impl.runOnMachineFunction(MF);
}

fn createAArch64LoadStoreOptLegacyPass() -> *mut FunctionPass {
    return AArch64LoadStoreOptLegacy {};
}

fn AArch64LoadStoreOptPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Impl: AArch64LoadStoreOpt = AArch64LoadStoreOpt {};
    Impl.AA = &mut MFAM.getResult(MF).getManager().getResult(MF.getFunction());
    let mut Changed: bool = Impl.runOnMachineFunction(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

struct Closure_1 {
    DefReg: MCPhysReg,
    TRI: *TargetRegisterInfo,
}

fn Closure_1::call(self: *Closure_1, MOP: *mut MachineOperand) -> bool {
            return MOP.isReg() && MOP.isDef() && !MOP.isDebug() && MOP.getReg().operator unsigned int() && self.TRI.regsOverlap(MOP.getReg(), self.DefReg);
        }

struct Closure_2 {
    cap_0: *mut AArch64LoadStoreOpt,
    cap_1: optional<MCPhysReg>,
}

fn Closure_2::call(self: *mut Closure_2, C: *TargetRegisterClass) -> auto {
            for SubOrSuper in self.TRI.sub_and_superregs_inclusive(operator(RenameReg)) {
                if C.contains(SubOrSuper) {
                    return SubOrSuper;
                }
            }
            llvm_unreachable_internal("Should have found matching sub or super register!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64LoadStoreOptimizer.cpp", 1062);
        }

struct Closure_3 {
    cap_0: *mut AArch64LoadStoreOpt,
    cap_1: MCRegister,
    cap_2: (lambda at P:\Goraw\llvm-project\llvm\lib\Target\AArch64\AArch64LoadStoreOptimizer.cpp:1056:9),
    MergeForward: bool,
}

fn Closure_3::call(self: *Closure_3, MI: *mut MachineInstr, IsDef: bool) -> bool {
            if IsDef {
                let mut SeenDef: bool = false;
                for let mut OpIdx: u32 = 0; OpIdx < MI.getNumOperands(); OpIdx += 1 {
                    let mut MOP: *mut MachineOperand = MI.getOperand(OpIdx);
                    if MOP.isReg() && !MOP.isDebug() && MOP.getReg().operator unsigned int() && (!self.MergeForward || !SeenDef || (MOP.isDef() && MOP.isImplicit())) && self.TRI.regsOverlap(MOP.getReg(), RegToRename) {
                        assert!((MOP.isImplicit() || (MOP.isRenamable() && !MOP.isEarlyClobber())), "Need renamable operands");
                        let mut MatchingReg: Register = 0;
                        if MI.getRegClassConstraint(OpIdx, self.TII, self.TRI) {
                            RC;
                        } else {
                            MatchingReg = GetMatchingSubReg.call(RC);
                        }
                        MOP.setReg(MatchingReg);
                        SeenDef = true;
                    }
                }
            } else {
                for let mut OpIdx: u32 = 0; OpIdx < MI.getNumOperands(); OpIdx += 1 {
                    let mut MOP: *mut MachineOperand = MI.getOperand(OpIdx);
                    if MOP.isReg() && !MOP.isDebug() && MOP.getReg().operator unsigned int() && self.TRI.regsOverlap(MOP.getReg(), RegToRename) {
                        assert!((MOP.isImplicit() || (MOP.isRenamable() && !MOP.isEarlyClobber())), "Need renamable operands");
                        let mut MatchingReg: Register = 0;
                        if MI.getRegClassConstraint(OpIdx, self.TII, self.TRI) {
                            RC;
                        } else {
                            MatchingReg = GetMatchingSubReg.call(RC);
                        }
                        assert!(MatchingReg.isValid(), "Cannot find matching regs for renaming");
                        MOP.setReg(MatchingReg);
                    }
                }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "Renamed " << MI;
                }
            }
                if !(false) { break; }
            }
            return true;
        }

struct Closure_4 {
    cap_0: *mut AArch64LoadStoreOpt,
    RegToCheck: MCPhysReg,
}

fn Closure_4::call(self: *Closure_4, MOP: *MachineOperand) -> bool {
                return !MOP.isReg() || MOP.isDebug() || !MOP.getReg().operator unsigned int() || MOP.isUndef() || !self.TRI.regsOverlap(MOP.getReg(), self.RegToCheck);
            }

struct Closure_5 {
    MIB: *mut MachineInstrBuilder,
}

unsafe fn Closure_5::call(self: *mut Closure_5, MI1: iterator, MI2: iterator) {
        let mut Ops: SmallSetVector<Register, 4> = SmallSetVector<Register, 4> {};
        for MO in drop_begin(operator(MI1).operands(), operator(MI1).getDesc().getNumOperands()) {
            if MO.isReg() && MO.isImplicit() && MO.isDef() {
                Ops.insert(MO.getReg());
            }
        }
        for MO in drop_begin(operator(MI2).operands(), operator(MI2).getDesc().getNumOperands()) {
            if MO.isReg() && MO.isImplicit() && MO.isDef() {
                Ops.insert(MO.getReg());
            }
        }
        for Op in Ops {
            (*self.MIB).addDef(Op, Implicit, 0);
        }
    }

struct Closure_6 {
    TRI: *TargetRegisterInfo,
    cap_1: Register,
}

fn Closure_6::call(self: *Closure_6, MOP: *MachineOperand) -> bool {
        return MOP.isReg() && !MOP.isDebug() && MOP.getReg().operator unsigned int() && MOP.isImplicit() && MOP.isKill() && self.TRI.regsOverlap(RegToRename, MOP.getReg());
    }

struct Closure_7 {
    UsedInBetween: *mut LiveRegUnits,
    FoundDef: *mut bool,
    TRI: *mut *TargetRegisterInfo,
    RegToRename: *mut Register,
    RequiredClasses: *mut SmallPtrSetImpl<const TargetRegisterClass *>,
}

unsafe fn Closure_7::call(self: *mut Closure_7, MI: *mut MachineInstr, IsDef: bool) -> bool {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                dbgs() << "Checking " << MI;
            }
        }
            if !(false) { break; }
        }
        if MI.getFlag(FrameSetup) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "  Cannot rename framesetup instructions " << "currently\n";
                }
            }
                if !(false) { break; }
            }
            return false;
        }
        (*self.UsedInBetween).accumulate(MI);
        (*self.FoundDef) = IsDef;
        if (*self.FoundDef) {
            if MI.isPseudo(IgnoreBundle) {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                        dbgs() << "  Cannot rename pseudo/bundle instruction\n";
                    }
                }
                    if !(false) { break; }
                }
                return false;
            }
            for MOP in MI.operands() {
                if !MOP.isReg() || !MOP.isDef() || MOP.isDebug() || !MOP.getReg().operator unsigned int() || !(*self.TRI).regsOverlap(MOP.getReg(), (*self.RegToRename)) {
                    continue;
                }
                if !canRenameMOP(MI, MOP, (*self.TRI)) {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                            dbgs() << "  Cannot rename " << MOP << " in " << MI;
                        }
                    }
                        if !(false) { break; }
                    }
                    return false;
                }
                (*self.RequiredClasses).insert((*self.TRI).getMinimalPhysRegClass(MOP.getReg().operator MCRegister()));
            }
            return true;
        } else {
            for MOP in MI.operands() {
                if !MOP.isReg() || MOP.isDebug() || !MOP.getReg().operator unsigned int() || !(*self.TRI).regsOverlap(MOP.getReg(), (*self.RegToRename)) {
                    continue;
                }
                if !canRenameMOP(MI, MOP, (*self.TRI)) {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                            dbgs() << "  Cannot rename " << MOP << " in " << MI;
                        }
                    }
                        if !(false) { break; }
                    }
                    return false;
                }
                (*self.RequiredClasses).insert((*self.TRI).getMinimalPhysRegClass(MOP.getReg().operator MCRegister()));
            }
        }
        return true;
    }

