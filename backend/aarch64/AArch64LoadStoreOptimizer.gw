}

fn AArch64LoadStoreOptLegacy::getAnalysisUsage(self: *AArch64LoadStoreOptLegacy, AU: *mut AnalysisUsage) {
    AU.addRequired();
    self.getAnalysisUsage(AU);
}

fn AArch64LoadStoreOptLegacy::getRequiredProperties(self: *AArch64LoadStoreOptLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn AArch64LoadStoreOptLegacy::getPassName(self: *AArch64LoadStoreOptLegacy) -> str {
    return "AArch64 load / store optimization pass";
}

fn AArch64LoadStoreOptLegacy::getPassKind(self: *AArch64LoadStoreOptLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64LoadStoreOptLegacy::getPassID(self: *AArch64LoadStoreOptLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64LoadStoreOptLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64LoadStoreOptLegacy::doFinalization(self, arg: *mut Module) -> bool {
