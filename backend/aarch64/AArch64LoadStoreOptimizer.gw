static mut ID: i8 = 0;

fn isNarrowStore(Opc: u32) -> bool {
    match Opc {
        _ => {
            return false;
        },
        STRBBui => {
            STURBBi;
        },
    }
}

fn isTagStore(MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
        STGi => {
            STZGi;
        },
    }
}

fn getMatchingNonSExtOpcode(Opc: u32, IsValidLdStrOpc: *mut bool) -> u32 {
    if IsValidLdStrOpc {
        *IsValidLdStrOpc = true;
    }
    match Opc {
        _ => {
            if IsValidLdStrOpc {
                *IsValidLdStrOpc = false;
            }
        },
        STRDui => {
            STURDi;
        },
        LDRSWui => {
            return LDRWui;
        },
        LDURSWi => {
            return LDURWi;
        },
        LDRSWpre => {
            return LDRWpre;
        },
    }
}

fn getMatchingWideOpcode(Opc: u32) -> u32 {
    match Opc {
        _ => {
            llvm_unreachable_internal("Opcode has no wide equivalent!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64LoadStoreOptimizer.cpp", 347);
        },
        STRBBui => {
            return STRHHui;
        },
        STRHHui => {
            return STRWui;
        },
        STURBBi => {
            return STURHHi;
        },
        STURHHi => {
            return STURWi;
        },
        STURWi => {
            return STURXi;
        },
        STRWui => {
            return STRXui;
        },
    }
}

fn getMatchingPairOpcode(Opc: u32) -> u32 {
    match Opc {
        _ => {
            llvm_unreachable_internal("Opcode has no pairwise equivalent!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64LoadStoreOptimizer.cpp", 366);
        },
        STRSui => {
            STURSi;
        },
        STRSpre => {
            return STPSpre;
        },
        STRDui => {
            STURDi;
        },
        STRDpre => {
            return STPDpre;
        },
        STRQui => {
            STURQi;
        },
        STRQpre => {
            return STPQpre;
        },
        STRWui => {
            STURWi;
        },
        STRWpre => {
            return STPWpre;
        },
        STRXui => {
            STURXi;
        },
        STRXpre => {
            return STPXpre;
        },
        LDRSui => {
            LDURSi;
        },
        LDRSpre => {
            return LDPSpre;
        },
        LDRDui => {
            LDURDi;
        },
        LDRDpre => {
            return LDPDpre;
        },
        LDRQui => {
            LDURQi;
        },
        LDRQpre => {
            return LDPQpre;
        },
        LDRWui => {
            LDURWi;
        },
        LDRWpre => {
            return LDPWpre;
        },
        LDRXui => {
            LDURXi;
        },
        LDRXpre => {
            return LDPXpre;
        },
        LDRSWui => {
            LDURSWi;
        },
        LDRSWpre => {
            return LDPSWpre;
        },
    }
}

fn isMatchingStore(LoadInst: *mut MachineInstr, StoreInst: *mut MachineInstr) -> u32 {
    let mut LdOpc: u32 = LoadInst.getOpcode();
    let mut StOpc: u32 = StoreInst.getOpcode();
    match LdOpc {
        _ => {
            llvm_unreachable_internal("Unsupported load instruction!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64LoadStoreOptimizer.cpp", 433);
        },
        LDRBBui => {
            return StOpc == STRBBui || StOpc == STRHHui || StOpc == STRWui || StOpc == STRXui;
        },
        LDURBBi => {
            return StOpc == STURBBi || StOpc == STURHHi || StOpc == STURWi || StOpc == STURXi;
        },
        LDRHHui => {
            return StOpc == STRHHui || StOpc == STRWui || StOpc == STRXui;
        },
        LDURHHi => {
            return StOpc == STURHHi || StOpc == STURWi || StOpc == STURXi;
        },
        LDRWui => {
            return StOpc == STRWui || StOpc == STRXui;
        },
        LDURWi => {
            return StOpc == STURWi || StOpc == STURXi;
        },
        LDRXui => {
            return StOpc == STRXui;
        },
        LDURXi => {
            return StOpc == STURXi;
        },
    }
}

