static mut NumPairCreated: Statistic = Statistic { "aarch64-ldst-opt", "NumPairCreated", "Number of load/store pair instructions generated" };

static mut NumPostFolded: Statistic = Statistic { "aarch64-ldst-opt", "NumPostFolded", "Number of post-index updates folded" };

static mut NumPreFolded: Statistic = Statistic { "aarch64-ldst-opt", "NumPreFolded", "Number of pre-index updates folded" };

static mut NumUnscaledPairCreated: Statistic = Statistic { "aarch64-ldst-opt", "NumUnscaledPairCreated", "Number of load/store from unscaled generated" };

static mut NumZeroStoresPromoted: Statistic = Statistic { "aarch64-ldst-opt", "NumZeroStoresPromoted", "Number of narrow zero stores promoted" };

static mut NumLoadsFromStoresPromoted: Statistic = Statistic { "aarch64-ldst-opt", "NumLoadsFromStoresPromoted", "Number of loads from stores promoted" };

static mut NumFailedAlignmentCheck: Statistic = Statistic { "aarch64-ldst-opt", "NumFailedAlignmentCheck", "Number of load/store pair transformation not passed the alignment check" };

static mut NumConstOffsetFolded: Statistic = Statistic { "aarch64-ldst-opt", "NumConstOffsetFolded", "Number of const offset of index address folded" };

static mut NumUMOVFoldedToFPRStore: Statistic = Statistic { "aarch64-ldst-opt", "NumUMOVFoldedToFPRStore", "Number of UMOV + GPR stores folded to FPR stores" };

static mut RegRenamingCounter: CounterInfo = CounterInfo { "aarch64-ldst-opt-reg-renaming", "Controls which pairs are considered for renaming" };

static mut LdStLimit: opt<unsigned int> = opt<unsigned int> { "aarch64-load-store-scan-limit", init(20), Hidden };

static mut UpdateLimit: opt<unsigned int> = opt<unsigned int> { "aarch64-update-scan-limit", init(100), Hidden };

static mut LdStConstLimit: opt<unsigned int> = opt<unsigned int> { "aarch64-load-store-const-scan-limit", init(10), Hidden };

static mut UMOVFoldLimit: opt<unsigned int> = opt<unsigned int> { "aarch64-umov-fold-scan-limit", init(16), Hidden };

static mut EnableRenaming: opt<bool> = opt<bool> { "aarch64-load-store-renaming", init(true), Hidden };

struct LdStPairFlags {
    MergeForward: bool,
    SExtIdx: i32,
    RenameReg: optional<MCPhysReg>,
}

fn LdStPairFlags::setMergeForward(self, V: bool) {
    self.MergeForward = V;
}

fn LdStPairFlags::getMergeForward(self: *LdStPairFlags) -> bool {
    return self.MergeForward;
}

fn LdStPairFlags::setSExtIdx(self, V: i32) {
    self.SExtIdx = V;
}

fn LdStPairFlags::getSExtIdx(self: *LdStPairFlags) -> i32 {
    return self.SExtIdx;
}

fn LdStPairFlags::setRenameReg(self, R: MCPhysReg) {
    self.RenameReg = R;
}

fn LdStPairFlags::clearRenameReg(self) {
    self.RenameReg = nullopt;
}

fn LdStPairFlags::getRenameReg(self: *LdStPairFlags) -> optional<MCPhysReg> {
    return self.RenameReg;
}

struct AArch64LoadStoreOpt {
    AA: *mut AliasAnalysis,
    TII: *AArch64InstrInfo,
    TRI: *TargetRegisterInfo,
    Subtarget: *AArch64Subtarget,
    ModifiedRegUnits: LiveRegUnits,
    UsedRegUnits: LiveRegUnits,
    DefinedInBB: LiveRegUnits,
}

