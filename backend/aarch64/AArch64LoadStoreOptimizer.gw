}

fn AArch64LoadStoreOptLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64LoadStoreOptLegacy::getResolver(self: *AArch64LoadStoreOptLegacy) -> *mut AnalysisResolver {
