fn Closure_3::call(self: *Closure_3, MOP: *MachineOperand) -> bool {
        return MOP.isReg() && !MOP.isDebug() && MOP.getReg().operator unsigned int() && MOP.isImplicit() && MOP.isKill() && self.TRI.regsOverlap(RegToRename, MOP.getReg());
    }

struct Closure_4 {
    TRI: *mut *TargetRegisterInfo,
    RegToRename: *mut Register,
    RequiredClasses: *mut SmallPtrSetImpl<const TargetRegisterClass *>,
}

unsafe fn Closure_4::call(self: *mut Closure_4, MI: *mut MachineInstr) -> bool {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                dbgs() << "Checking " << MI;
            }
        }
            if !(false) { break; }
        }
        if MI.getFlag(FrameSetup) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ldst-opt", 1) {
                    dbgs() << "  Cannot rename framesetup instructions " << "currently\n";
                }
            }
                if !(false) { break; }
            }
            return false;
        }
        return true;
    }

struct Closure_5 {
    MF: *mut MachineFunction,
    TRI: *TargetRegisterInfo,
}

unsafe fn Closure_5::call(self: *mut Closure_5, PR: MCPhysReg) -> auto {}

struct Closure_6 {
    RequiredClasses: *mut SmallPtrSetImpl<const TargetRegisterClass *>,
    TRI: *TargetRegisterInfo,
}

unsafe fn Closure_6::call(self: *mut Closure_6, PR: MCPhysReg) -> auto {}

struct Closure_7 {}

fn Closure_7::call(self: *Closure_7) {
                    return Insn() == CFI_INSTRUCTION;
                }
