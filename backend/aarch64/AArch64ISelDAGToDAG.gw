            if SubVT == i32 {} else {
                assert!(SubVT == i64);
            }
            let mut Zero: SDValue = zeroed();
            let mut Neg: *mut MachineSDNode = null;
            NewShiftAmt = Neg(0);
        } else if operator(ShiftAmt).getOpcode() == SUB && isIntImmediate(Add0, Add0Imm) && (Add0Imm % Size == Size - 1) {
            let mut NotOpc: u32 = 0;
            let mut ZeroReg: u32 = 0;
            let mut SubVT: EVT = operator(ShiftAmt).getValueType(0);
            if SubVT == i32 {} else {
