fn AArch64DAGToDAGISel::SelectExtractHigh(self, N: SDValue, Res: *mut SDValue) -> bool {
    if self.Subtarget.isLittleEndian() && operator(N).getOpcode() == BITCAST {
        N = operator(N).getOperand(0);
    }
    if operator(N).getOpcode() != EXTRACT_SUBVECTOR || !isa(operator(N).getOperand(1)) {
        return false;
    }
    let mut VT: EVT = operator(N).getValueType(0);
    let mut LVT: EVT = operator(N).getOperand(0).getValueType();
    let mut Index: u32 = operator(N).getConstantOperandVal(1);
    if !VT.is64BitVector() || !LVT.is128BitVector() || Index != VT.getVectorNumElements() {
        return false;
    }
    Res = operator(N).getOperand(0);
    return true;
}

fn AArch64DAGToDAGISel::SelectRoundingVLShr(self, N: SDValue, Res1: *mut SDValue, Res2: *mut SDValue) -> bool {
    if  {
        return false;
    }
    let mut Op: SDValue = operator(N).getOperand(0);
    let mut VT: EVT = Op.getValueType();
    let mut ShtAmt: u32 = operator(N).getConstantOperandVal(1);
    if ShtAmt > VT.getScalarSizeInBits() / 2 || Op.getOpcode() != ADD {
        return false;
    }
    let mut Imm: APInt = APInt {};
    if  {
        Imm = APInt { VT.getScalarSizeInBits(), Op.getOperand(1).getConstantOperandVal(0) << Op.getOperand(1).getConstantOperandVal(1), false, false };
    } else if  {
        Imm = APInt { VT.getScalarSizeInBits(), Op.getOperand(1).getConstantOperandVal(0), false, false };
    } else {
        return false;
    }
    if Imm != 1 << (ShtAmt - 1) {
        return false;
    }
    Res1 = Op.getOperand(0);
    return true;
}

fn AArch64DAGToDAGISel::SelectDupZeroOrUndef(self, N: SDValue) -> bool {
    match operator(N).getOpcode() {
        UNDEF => {
            POISON;
        },
        SPLAT_VECTOR => {
            let mut Opnd0: SDValue = operator(N).getOperand(0);
            if isNullConstant(Opnd0) {
                return true;
            }
            if isNullFPConstant(Opnd0) {
                return true;
            }
            break;
        },
        _ => {
            break;
        },
    }
    return false;
}

