static mut ID: i8 = 0;

fn addBitcastHints(DAG: *mut SelectionDAG, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = &mut N;
    let mut getFloatVT: Closure_1 = Closure_1 { DAG: &mut DAG };
    let mut NewOps: SmallVector<SDValue, 2> = zeroed();
    NewOps()(N.getNumOperands());
    for let mut I: u32 = 0;
let mut E: u32 = N.getNumOperands(); I < E; I += 1 {
        let mut bitcasted: SDValue = DAG.getBitcast(getFloatVT.call(N.getOperand(I).getValueType()), N.getOperand(I));
        NewOps()(bitcasted);
    }
    let mut OrigVT: EVT = N.getValueType(0);
    let mut OpNode: SDValue = DAG(N.getOpcode(), DL, getFloatVT.call(OrigVT));
    return DAG.getBitcast(OrigVT, OpNode);
}

fn isIntImmediate(N: *SDNode, Imm: *mut u64) -> bool {
    if dyn_cast(N) {
        C;
    } else {
        Imm = C.getZExtValue();
        return true;
    }
    return false;
}

fn isIntImmediate(N: SDValue, Imm: *mut u64) -> bool {
    return isIntImmediate(N.getNode(), Imm);
}

fn isOpcWithIntImmediate(N: *SDNode, Opc: u32, Imm: *mut u64) -> bool {
    return N.getOpcode() == Opc && isIntImmediate(N.getOperand(1).getNode(), Imm);
}

fn isIntImmediateEq(N: SDValue, ImmExpected: u64) -> bool {
    let mut Imm: u64 = 0;
    if !isIntImmediate(N.getNode(), Imm) {
        return false;
    }
    return Imm == ImmExpected;
}

fn DecodeFMOVImm(Imm: u64, RegWidth: u32) -> APInt {
    assert!(RegWidth == 32 || RegWidth == 64);
    if RegWidth == 32 {
        return APInt { RegWidth, decodeAdvSIMDModImmType11(Imm), false, false };
    }
    return APInt { RegWidth, decodeAdvSIMDModImmType12(Imm), false, false };
}

fn DecodeNEONSplat(N: SDValue, Subtarget: *AArch64Subtarget) -> optional<APInt> {
    assert!(N.getValueType().isInteger(), "Only integers are supported");
    if  {
        N = operator(N).getOperand(0);
    }
    let mut SplatWidth: u32 = N.getScalarValueSizeInBits();
    if  {
        return DecodeFMOVImm(N.getConstantOperandVal(0), SplatWidth);
    }
    if  {
        return APInt { SplatWidth, N.getConstantOperandVal(0), false, false };
    }
    if  {
        return APInt { SplatWidth, N.getConstantOperandVal(0) << N.getConstantOperandVal(1), false, false };
    }
    if  {
        return operator(APInt { SplatWidth, N.getConstantOperandVal(0) << N.getConstantOperandVal(1), false, false });
    }
    if  {
        return APInt { SplatWidth, decodeAdvSIMDModImmType10(N.getConstantOperandVal(0)), false, false };
    }
    if  {
        if  {
            return ()(SplatWidth);
        }
    }
    let mut SplatVal: APInt = APInt {};
    if isConstantSplatVector(N.getNode(), SplatVal) {
        return SplatVal.trunc(SplatWidth);
    }
    return nullopt();
}

fn GetNEONSplatValue(N: SDValue, Subtarget: *AArch64Subtarget) -> optional<APInt> {
    let mut SplatWidth: u32 = N.getScalarValueSizeInBits();
    if  {
        if SplatVal()() <= SplatWidth {
            return getSplat(SplatWidth, operator*());
        }
        if SplatVal()(SplatWidth) {
            return (SplatWidth);
        }
    }
    return nullopt();
}

fn AArch64DAGToDAGISel::SelectNEONSplatOfSVELogicalImm(self, N: SDValue, Imm: *mut SDValue) -> bool {
    let mut ImmVal: optional<APInt> = zeroed();
    if operator!() {
        return false;
    }
    let mut Encoding: u64 = 0;
    if operator!(isSVELogicalImm(N.getScalarValueSizeInBits(), Encoding)) {
        return false;
    }
    return true;
}

