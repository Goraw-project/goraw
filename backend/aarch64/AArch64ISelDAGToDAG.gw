        }
        return DataVT.changeVectorElementType(Ctx, MemVT.getVectorElementType());
    }
    let mut Opcode: u32 = Root.getOpcode();
    match Opcode {
        _ => {
            break;
        },
    }
    if Opcode != INTRINSIC_VOID && Opcode != INTRINSIC_W_CHAIN {
        return EVT {};
    }
    match Root.getConstantOperandVal(1) {
        _ => {
            return EVT {};
        },
    }
}

