fn AArch64DAGToDAGISel::decodeMemoryHintFlags(self: *AArch64DAGToDAGISel, MMO: *mut MachineMemOperand) -> AArch64MemoryHint {
    let mut MemoryHint: i32 = -1;
    let mut MemCacheHint: *MDNode = MMO.getMemCacheHint();
    if !MemCacheHint {
        return NONE;
    }
    for let mut I: u32 = 0; I + 1 < MemCacheHint.getNumOperands(); I += 2 {
        if MemCacheHint.getOperand(I).equalsStr("aarch64.mem_hint") {
            let mut Val: *Metadata = MemCacheHint.getOperand(I + 1).get();
            MemoryHint = cast(cast(Val)())();
        }
    }
    return toAArch64MemoryHint(MemoryHint);
}

fn AArch64DAGToDAGISel::isAtomicSTSHH_KEEP(self: *AArch64DAGToDAGISel, N: *mut SDNode) -> bool {
