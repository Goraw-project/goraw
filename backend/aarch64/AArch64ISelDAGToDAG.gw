fn AArch64DAGToDAGISel::ReplaceUses(self, F: SDValue, T: SDValue) {
    self.CurDAG.ReplaceAllUsesOfValueWith(F, T);
    EnforceNodeIdInvariant(T.getNode());
}

fn AArch64DAGToDAGISel::ReplaceNode(self, F: *mut SDNode, T: *mut SDNode) {
    self.CurDAG.ReplaceAllUsesWith(F, T);
    EnforceNodeIdInvariant(T);
    self.CurDAG.RemoveDeadNode(F);
}

