fn isBitfieldExtractOpFromAnd(CurDAG: *mut SelectionDAG, N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, LSB: *mut u32, MSB: *mut u32, NumberOfIgnoredLowBits: u32, BiggerPattern: bool) -> bool {
    assert!(N.getOpcode() == AND, "N must be a AND operation to call this function");
    let mut VT: EVT = N.getValueType(0);
    assert!((VT == i32 || VT == i64), "Type checking must have been done before calling this function");
    let mut AndImm: u64 = 0;
    if !isOpcWithIntImmediate(N, AND, AndImm) {
        return false;
    }
    let mut Op0: *SDNode = N.getOperand(0).getNode();
    operator|=(AndImm, maskTrailingOnes(NumberOfIgnoredLowBits));
    if AndImm & (AndImm + 1) {
        return false;
    }
    let mut ClampMSB: bool = false;
    let mut SrlImm: u64 = 0;
    if VT == i64 && Op0.getOpcode() == ANY_EXTEND && isOpcWithIntImmediate(Op0.getOperand(0).getNode(), SRL, SrlImm) {
        Opd0 = Widen(CurDAG, Op0.getOperand(0).getOperand(0));
        ClampMSB = true;
    } else if VT == i32 && Op0.getOpcode() == TRUNCATE && isOpcWithIntImmediate(Op0.getOperand(0).getNode(), SRL, SrlImm) {
        Opd0 = Op0.getOperand(0).getOperand(0);
        VT = operator(Opd0).getValueType(0);
    } else if isOpcWithIntImmediate(Op0, SRL, SrlImm) {
        Opd0 = Op0.getOperand(0);
        ClampMSB = (VT == i32);
    } else if BiggerPattern {
        Opd0 = N.getOperand(0);
    } else {
        return false;
    }
    if !BiggerPattern && (SrlImm <= 0 || SrlImm(VT.getSizeInBits())) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                (dbgs() << N << ": Found large shift immediate, this should not happen\n");
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    LSB = SrlImm;
    MSB = SrlImm + (if VT == i32 { countr_one(AndImm) } else { countr_one(AndImm) }) - 1;
    if ClampMSB {
        MSB = if MSB > 31 { 31 } else { MSB };
    }
    return true;
}

fn isBitfieldExtractOpFromSExtInReg(N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, Immr: *mut u32, Imms: *mut u32) -> bool {
    assert!(N.getOpcode() == SIGN_EXTEND_INREG);
    let mut VT: EVT = N.getValueType(0);
    let mut BitWidth: u32 = VT.getSizeInBits();
    assert!((VT == i32 || VT == i64), "Type checking must have been done before calling this function");
    let mut Op: SDValue = N.getOperand(0);
    if operator(Op).getOpcode() == TRUNCATE {
        Op = operator(Op).getOperand(0);
        VT = operator(Op).getValueType(0);
        BitWidth(VT.getSizeInBits());
    }
    let mut ShiftImm: u64 = 0;
    if !isOpcWithIntImmediate(Op.getNode(), SRL, ShiftImm) && !isOpcWithIntImmediate(Op.getNode(), SRA, ShiftImm) {
        return false;
    }
    let mut Width: u32 = cast(N.getOperand(1))()();
    if ShiftImm + Width > BitWidth {
        return false;
    }
    Opd0 = Op.getOperand(0);
    Immr = ShiftImm;
    Imms = ShiftImm + Width - 1;
    return true;
}

fn isSeveralBitsExtractOpFromShr(N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, LSB: *mut u32, MSB: *mut u32) -> bool {
    if N.getOpcode() != SRL {
        return false;
    }
    let mut AndMask: u64 = 0;
    if !isOpcWithIntImmediate(N.getOperand(0).getNode(), AND, AndMask) {
        return false;
    }
    Opd0 = N.getOperand(0).getOperand(0);
    let mut SrlImm: u64 = 0;
    if !isIntImmediate(N.getOperand(1), SrlImm) {
        return false;
    }
    if !isMask_64(AndMask >> SrlImm) {
        return false;
    }
    LSB = SrlImm;
    MSB = Log2_64(AndMask);
    return true;
}

fn isBitfieldExtractOpFromShr(N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, Immr: *mut u32, Imms: *mut u32, BiggerPattern: bool) -> bool {
    assert!((N.getOpcode() == SRA || N.getOpcode() == SRL), "N must be a SHR/SRA operation to call this function");
    let mut VT: EVT = N.getValueType(0);
    assert!((VT == i32 || VT == i64), "Type checking must have been done before calling this function");
    if isSeveralBitsExtractOpFromShr(N, Opc, Opd0, Immr, Imms) {
        return true;
    }
    let mut ShlImm: u64 = 0;
    let mut TruncBits: u64 = 0;
    if isOpcWithIntImmediate(N.getOperand(0).getNode(), SHL, ShlImm) {
        Opd0 = N.getOperand(0).getOperand(0);
    } else if VT == i32 && N.getOpcode() == SRL && N.getOperand(0).getNode().getOpcode() == TRUNCATE {
        Opd0 = N.getOperand(0).getOperand(0);
        TruncBits = operator(Opd0).getValueType(0).getSizeInBits();
        VT = Opd0.getValueType();
        assert!(VT == i64, "the promoted type should be i64");
    } else if BiggerPattern {
        Opd0 = N.getOperand(0);
    } else {
        return false;
    }
    if ShlImm(VT.getSizeInBits()) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                (dbgs() << N << ": Found large shift immediate, this should not happen\n");
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut SrlImm: u64 = 0;
    if !isIntImmediate(N.getOperand(1), SrlImm) {
        return false;
    }
    (((operator!(operator!((SrlImm > 0 && SrlImm(VT.getSizeInBits()) && "bad amount in shift node!")))) || (_wassert(L"SrlImm > 0 && SrlImm < VT.getSizeInBits() && \"bad amount in shift node!\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelDAGToDAG.cpp", (3115) as u32) , 0)) as void);
    let mut immr: i32 = SrlImm - ShlImm;
    Immr = if immr < 0 { immr(VT.getSizeInBits()) } else { immr };
    Imms = VT.getSizeInBits() - TruncBits - 1;
    return true;
}

fn AArch64DAGToDAGISel::tryBitfieldExtractOpFromSExt(self, N: *mut SDNode) -> bool {
    assert!(N.getOpcode() == SIGN_EXTEND);
    let mut VT: EVT = N.getValueType(0);
    let mut NarrowVT: EVT = operator(N.getOperand(0)).getValueType(0);
    if VT != i64 || NarrowVT != i32 {
        return false;
    }
    let mut ShiftImm: u64 = 0;
    let mut Op: SDValue = N.getOperand(0);
    if !isOpcWithIntImmediate(Op.getNode(), SRA, ShiftImm) {
        return false;
    }
    let mut dl: SDLoc = N;
    let mut Opd0: SDValue = Widen(Op.getOperand(0));
    let mut Immr: u32 = ShiftImm;
    let mut Imms: u32 = NarrowVT.getSizeInBits();
    let mut Ops: []SDValue = zeroed();
    return true;
}

fn isBitfieldExtractOp(CurDAG: *mut SelectionDAG, N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, Immr: *mut u32, Imms: *mut u32, NumberOfIgnoredLowBits: u32, BiggerPattern: bool) -> bool {
    if N.getValueType(0) != i32 && N.getValueType(0) != i64 {
        return false;
    }
    match N.getOpcode() {
        _ => {
            if !N.isMachineOpcode() {
                return false;
            }
        },
        AND => {
            return isBitfieldExtractOpFromAnd(CurDAG, N, Opc, Opd0, Immr, Imms, NumberOfIgnoredLowBits, BiggerPattern);
        },
        SRL => {
            SRA;
        },
        SIGN_EXTEND_INREG => {
            return isBitfieldExtractOpFromSExtInReg(N, Opc, Opd0, Immr, Imms);
        },
    }
    let mut NOpc: u32 = N.getMachineOpcode();
    match NOpc {
        _ => {
            return false;
        },
    }
    return false;
}

fn AArch64DAGToDAGISel::tryBitfieldExtractOp(self, N: *mut SDNode) -> bool {
    let mut Opc: u32 = 0;
    let mut Immr: u32 = 0;
    let mut Imms: u32 = 0;
    let mut Opd0: SDValue = SDValue {};
    if operator!(isBitfieldExtractOp(N, Opc, Opd0, Immr, Imms)) {
        return false;
    }
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = N;
    if  {
        let mut Ops64: []SDValue = zeroed();
        let mut BFM: *mut SDNode = null;
        let mut Inner: SDValue = zeroed();
        self.ReplaceNode;
        return true;
    }
    let mut Ops: []SDValue = zeroed();
    return true;
}

fn isBitfieldDstMask(DstMask: u64, BitsToBeInserted: *APInt, NumberOfIgnoredHighBits: u32, VT: EVT) -> bool {
    assert!((VT == i32 || VT == i64), "i32 or i64 mask type expected!");
    let mut BitWidth: u32 = VT.getSizeInBits();
    let mut SignificantDstMask: APInt = APInt { BitWidth, DstMask, false, true };
    let mut SignificantBitsToBeInserted: APInt = BitsToBeInserted.zextOrTrunc(BitWidth);
    return (SignificantDstMask & SignificantBitsToBeInserted) == 0 && (SignificantDstMask | SignificantBitsToBeInserted).isAllOnes();
}

fn getUsefulBitsFromAndWithImmediate(Op: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    let mut Imm: u64 = cast(Op.getOperand(1).getNode())();
    Imm = decodeLogicalImmediate(Imm, UsefulBits.getBitWidth());
    operator(UsefulBits, APInt { UsefulBits.getBitWidth(), Imm, false, false });
    getUsefulBits(Op, UsefulBits, Depth + 1);
}

fn getUsefulBitsFromBitfieldMoveOpd(Op: SDValue, UsefulBits: *mut APInt, Imm: u64, MSB: u64, Depth: u32) {
    let mut OpUsefulBits: APInt = UsefulBits;
    OpUsefulBits = 1;
    if MSB >= Imm {
        operator(OpUsefulBits, MSB - Imm + 1);
        operator(OpUsefulBits);
        getUsefulBits(Op, OpUsefulBits, Depth + 1);
        operator(OpUsefulBits, Imm);
    } else {
        operator(OpUsefulBits, MSB + 1);
        operator(OpUsefulBits);
        operator(OpUsefulBits, OpUsefulBits.getBitWidth() - Imm);
        getUsefulBits(Op, OpUsefulBits, Depth + 1);
        OpUsefulBits.lshrInPlace(OpUsefulBits.getBitWidth() - Imm);
    }
    operator(UsefulBits, OpUsefulBits);
}

fn getUsefulBitsFromUBFM(Op: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    let mut Imm: u64 = cast(Op.getOperand(1).getNode())();
    let mut MSB: u64 = cast(Op.getOperand(2).getNode())();
    getUsefulBitsFromBitfieldMoveOpd(Op, UsefulBits, Imm, MSB, Depth);
}

fn getUsefulBitsFromOrWithShiftedReg(Op: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    let mut ShiftTypeAndValue: u64 = cast(Op.getOperand(2).getNode())();
    let mut Mask: APInt = UsefulBits;
    Mask.clearAllBits();
    Mask.flipAllBits();
    if getShiftType(ShiftTypeAndValue) == LSL {
        let mut ShiftAmt: u64 = getShiftValue(ShiftTypeAndValue);
        operator(Mask, ShiftAmt);
        getUsefulBits(Op, Mask, Depth + 1);
        Mask.lshrInPlace(ShiftAmt);
    } else if getShiftType(ShiftTypeAndValue) == LSR {
        let mut ShiftAmt: u64 = getShiftValue(ShiftTypeAndValue);
        Mask.lshrInPlace(ShiftAmt);
        getUsefulBits(Op, Mask, Depth + 1);
        operator(Mask, ShiftAmt);
    } else {
        return;
    }
    operator(UsefulBits, Mask);
}

fn getUsefulBitsFromBFM(Op: SDValue, Orig: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    let mut Imm: u64 = cast(Op.getOperand(2).getNode())();
    let mut MSB: u64 = cast(Op.getOperand(3).getNode())();
    let mut OpUsefulBits: APInt = UsefulBits;
    OpUsefulBits = 1;
    let mut ResultUsefulBits: APInt = APInt { UsefulBits.getBitWidth(), 0, false, false };
    ResultUsefulBits.flipAllBits();
    let mut Mask: APInt = APInt { UsefulBits.getBitWidth(), 0, false, false };
    getUsefulBits(Op, ResultUsefulBits, Depth + 1);
    if MSB >= Imm {
        let mut Width: u64 = MSB - Imm + 1;
        let mut LSB: u64 = Imm;
        operator(OpUsefulBits, Width);
        operator(OpUsefulBits);
        if Op.getOperand(1) == Orig {
            Mask = ResultUsefulBits & OpUsefulBits;
            operator(Mask, LSB);
        }
        if Op.getOperand(0) == Orig {
            operator(Mask, (ResultUsefulBits & operator(OpUsefulBits)));
        }
    } else {
        let mut Width: u64 = MSB + 1;
        let mut LSB: u64 = UsefulBits.getBitWidth() - Imm;
        operator(OpUsefulBits, Width);
        operator(OpUsefulBits);
        operator(OpUsefulBits, LSB);
        if Op.getOperand(1) == Orig {
            Mask = ResultUsefulBits & OpUsefulBits;
            Mask.lshrInPlace(LSB);
        }
        if Op.getOperand(0) == Orig {
            operator(Mask, (ResultUsefulBits & operator(OpUsefulBits)));
        }
    }
    operator(UsefulBits, Mask);
}

fn getUsefulBitsForUse(UserNode: *mut SDNode, UsefulBits: *mut APInt, Orig: SDValue, Depth: u32) {
    if !UserNode.isMachineOpcode() {
        return;
    }
    match UserNode.getMachineOpcode() {
        _ => {
            return;
        },
    }
}

fn getUsefulBits(Op: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    if Depth >= MaxRecursionDepth {
        return;
    }
    if !Depth {
        let mut Bitwidth: u32 = Op.getScalarValueSizeInBits();
        UsefulBits = APInt { Bitwidth, 0, false, false };
        UsefulBits.flipAllBits();
    }
    let mut UsersUsefulBits: APInt = APInt { UsefulBits.getBitWidth(), 0, false, false };
    operator(UsefulBits, UsersUsefulBits);
}

fn getLeftShift(CurDAG: *mut SelectionDAG, Op: SDValue, ShlAmount: i32) -> SDValue {
    if ShlAmount == 0 {
        return Op;
    }
    let mut VT: EVT = Op.getValueType();
    let mut dl: SDLoc = Op;
    let mut BitWidth: u32 = VT.getSizeInBits();
    let mut UBFMOpc: u32 = 0;
    let mut ShiftNode: *mut SDNode = null;
    if ShlAmount > 0 {
        ShiftNode(CurDAG.getMachineNode(UBFMOpc, dl, VT, Op, CurDAG.getTargetConstant(BitWidth - ShlAmount, dl, VT, false), CurDAG.getTargetConstant(BitWidth - 1 - ShlAmount, dl, VT, false)));
    } else {
        assert!(ShlAmount < 0, "expected right shift");
        let mut ShrAmount: i32 = -ShlAmount;
        ShiftNode(CurDAG.getMachineNode(UBFMOpc, dl, VT, Op, CurDAG.getTargetConstant(ShrAmount, dl, VT, false), CurDAG.getTargetConstant(BitWidth - 1, dl, VT, false)));
    }
    return SDValue { Node: ShiftNode, ResNo: 0 };
}

fn isBitfieldPositioningOp(CurDAG: *mut SelectionDAG, Op: SDValue, BiggerPattern: bool, Src: *mut SDValue, DstLSB: *mut i32, Width: *mut i32) -> bool {
    let mut VT: EVT = Op.getValueType();
    let mut BitWidth: u32 = VT.getSizeInBits();
    BitWidth as void;
    assert!(BitWidth == 32 || BitWidth == 64);
    let mut Known: KnownBits = CurDAG.computeKnownBits(Op, 0);
    let mut NonZeroBits: u64 = (operator(Known.Zero)).getZExtValue();
    if !isShiftedMask_64(NonZeroBits) {
        return false;
    }
    match Op.getOpcode() {
        _ => {
            break;
        },
        AND => {
            return isBitfieldPositioningOpFromAnd(CurDAG, Op, BiggerPattern, NonZeroBits, Src, DstLSB, Width);
        },
        SHL => {
            return isBitfieldPositioningOpFromShl(CurDAG, Op, BiggerPattern, NonZeroBits, Src, DstLSB, Width);
        },
    }
    return false;
}

fn isBitfieldPositioningOpFromAnd(CurDAG: *mut SelectionDAG, Op: SDValue, BiggerPattern: bool, NonZeroBits: u64, Src: *mut SDValue, DstLSB: *mut i32, Width: *mut i32) -> bool {
    assert!(isShiftedMask_64(NonZeroBits), "Caller guaranteed");
    let mut VT: EVT = Op.getValueType();
    assert!((VT == i32 || VT == i64), "Caller guarantees VT is one of i32 or i64");
    VT as void;
    let mut AndImm: u64 = 0;
    if !isOpcWithIntImmediate(Op.getNode(), AND, AndImm) {
        return false;
    }
    assert!((~AndImm & NonZeroBits) == 0, "Something must be wrong (e.g., in SelectionDAG::computeKnownBits)");
    let mut AndOp0: SDValue = Op.getOperand(0);
    let mut ShlImm: u64 = 0;
    let mut ShlOp0: SDValue = SDValue {};
    if isOpcWithIntImmediate(AndOp0.getNode(), SHL, ShlImm) {
        ShlOp0 = AndOp0.getOperand(0);
    } else if VT == i64 && AndOp0.getOpcode() == ANY_EXTEND && isOpcWithIntImmediate(AndOp0.getOperand(0).getNode(), SHL, ShlImm) {
        let mut ShlVal: SDValue = AndOp0.getOperand(0);
        assert!((ShlVal.getValueType() == i32), "Expect VT to be MVT::i32.");
        ShlOp0 = Widen(CurDAG, ShlVal.getOperand(0));
    } else {
        return false;
    }
    if !BiggerPattern && !AndOp0.hasOneUse() {
        return false;
    }
    DstLSB = countr_zero(NonZeroBits);
    Width = countr_one(NonZeroBits >> DstLSB);
    if  {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                dbgs() << "Found large Width in bit-field-positioning -- this indicates no proper combining / constant folding was performed\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    if ShlImm != DstLSB && !BiggerPattern {
        return false;
    }
    Src = getLeftShift(CurDAG, ShlOp0, ShlImm - DstLSB);
    return true;
}

fn isSeveralBitsPositioningOpFromShl(ShlImm: u64, Op: SDValue, Src: *mut SDValue, DstLSB: *mut i32, Width: *mut i32) -> bool {
    assert!(Op.getOpcode() == SHL, "Op.getNode() should be a SHL node to call this function");
    assert!(isIntImmediateEq(Op.getOperand(1), ShlImm), "Op.getNode() should shift ShlImm to call this function");
    let mut AndImm: u64 = 0;
    let mut Op0: SDValue = Op.getOperand(0);
    if !isOpcWithIntImmediate(Op0.getNode(), AND, AndImm) {
        return false;
    }
    let mut ShiftedAndImm: u64 = ((AndImm << ShlImm) >> ShlImm);
    if isMask_64(ShiftedAndImm) {
        Width = countr_one(ShiftedAndImm);
        DstLSB = ShlImm;
        Src = Op0.getOperand(0);
        return true;
    }
    return false;
}

fn isBitfieldPositioningOpFromShl(CurDAG: *mut SelectionDAG, Op: SDValue, BiggerPattern: bool, NonZeroBits: u64, Src: *mut SDValue, DstLSB: *mut i32, Width: *mut i32) -> bool {
    assert!(isShiftedMask_64(NonZeroBits), "Caller guaranteed");
    let mut VT: EVT = Op.getValueType();
    assert!((VT == i32 || VT == i64), "Caller guarantees that type is i32 or i64");
    VT as void;
    let mut ShlImm: u64 = 0;
    if !isOpcWithIntImmediate(Op.getNode(), SHL, ShlImm) {
        return false;
    }
    if !BiggerPattern && !Op.hasOneUse() {
        return false;
    }
    if isSeveralBitsPositioningOpFromShl(ShlImm, Op, Src, DstLSB, Width) {
        return true;
    }
    DstLSB = countr_zero(NonZeroBits);
    Width = countr_one(NonZeroBits >> DstLSB);
    if ShlImm != DstLSB && !BiggerPattern {
        return false;
    }
    Src = getLeftShift(CurDAG, Op.getOperand(0), ShlImm - DstLSB);
    return true;
}

fn isShiftedMask(Mask: u64, VT: EVT) -> bool {
    assert!(VT == i32 || VT == i64);
    if VT == i32 {
        return isShiftedMask_32(Mask);
    }
    return isShiftedMask_64(Mask);
}

fn tryBitfieldInsertOpFromOrAndImm(N: *mut SDNode, CurDAG: *mut SelectionDAG) -> bool {
    assert!(N.getOpcode() == OR, "Expect a OR operation");
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return false;
    }
    let mut BitWidth: u32 = VT.getSizeInBits();
    let mut OrImm: u64 = 0;
    if !isOpcWithIntImmediate(N, OR, OrImm) {
        return false;
    }
    if isLogicalImmediate(OrImm, BitWidth) {
        return false;
    }
    let mut MaskImm: u64 = 0;
    let mut And: SDValue = N.getOperand(0);
    if !And.hasOneUse() || !isOpcWithIntImmediate(And.getNode(), AND, MaskImm) {
        return false;
    }
    let mut Known: KnownBits = CurDAG.computeKnownBits(And, 0);
    let mut NotKnownZero: u64 = (operator(Known.Zero)).getZExtValue();
    if !isShiftedMask(Known.Zero.getZExtValue(), VT) {
        return false;
    }
    if (OrImm & NotKnownZero) != 0 {
        return false;
    }
    let mut LSB: i32 = countr_one(NotKnownZero);
    let mut Width: i32 = BitWidth - APInt { BitWidth, NotKnownZero, false, false }.popcount();
    let mut ImmR: u32 = (BitWidth - LSB) % BitWidth;
    let mut ImmS: u32 = Width - 1;
    let mut IsBFI: bool = LSB != 0;
    let mut BFIImm: u64 = OrImm >> LSB;
    if IsBFI && !isLogicalImmediate(BFIImm, BitWidth) {
        let mut OrChunks: u32 = 0;
        let mut BFIChunks: u32 = 0;
        for let mut Shift: u32 = 0; Shift < BitWidth; Shift += 16 {
            if ((OrImm >> Shift) & 65535) != 0 {
                OrChunks += 1;
            }
            if ((BFIImm >> Shift) & 65535) != 0 {
                BFIChunks += 1;
            }
        }
        if BFIChunks > OrChunks {
            return false;
        }
    }
    let mut DL: SDLoc = N;
    let mut MOVIOpc: u32 = 0;
    let mut MOVI: *mut SDNode = CurDAG.getMachineNode(MOVIOpc, DL, VT, CurDAG.getTargetConstant(BFIImm, DL, VT, false));
    let mut Ops: [4]SDValue = [And.getOperand(0), SDValue { Node: MOVI, ResNo: 0 }, CurDAG.getTargetConstant(ImmR, DL, VT, false), CurDAG.getTargetConstant(ImmS, DL, VT, false)];
    let mut Opc: u32 = 0;
    CurDAG;
    return true;
}

fn isWorthFoldingIntoOrrWithShift(Dst: SDValue, CurDAG: *mut SelectionDAG, ShiftedOperand: *mut SDValue, EncodedShiftImm: *mut u64) -> bool {
    if !Dst.hasOneUse() {
        return false;
    }
    let mut VT: EVT = Dst.getValueType();
    assert!((VT == i32 || VT == i64), "Caller should guarantee that VT is one of i32 or i64");
    let mut SizeInBits: u32 = VT.getSizeInBits();
    let mut DL: SDLoc = Dst.getNode();
    let mut AndImm: u64 = 0;
    let mut ShlImm: u64 = 0;
    if isOpcWithIntImmediate(Dst.getNode(), AND, AndImm) && isShiftedMask_64(AndImm) {
        let mut DstOp0: SDValue = Dst.getOperand(0);
        if !DstOp0.hasOneUse() {
            return false;
        }
        let mut SrlImm: u64 = 0;
        if isOpcWithIntImmediate(DstOp0.getNode(), SRL, SrlImm) {
            let mut NumTrailingZeroInShiftedMask: u64 = countr_zero(AndImm);
            if (SrlImm + NumTrailingZeroInShiftedMask) < SizeInBits {
                let mut MaskWidth: u32 = countr_one(AndImm >> NumTrailingZeroInShiftedMask);
                let mut UBFMOpc: u32 = 0;
                let mut UBFMNode: *mut SDNode = CurDAG.getMachineNode(UBFMOpc, DL, VT, DstOp0.getOperand(0), CurDAG.getTargetConstant(SrlImm + NumTrailingZeroInShiftedMask, DL, VT, false), CurDAG.getTargetConstant(SrlImm + NumTrailingZeroInShiftedMask + MaskWidth - 1, DL, VT, false));
                ShiftedOperand = SDValue { Node: UBFMNode, ResNo: 0 };
                EncodedShiftImm = getShifterImm(LSL, NumTrailingZeroInShiftedMask);
                return true;
            }
        }
        return false;
    }
    if isOpcWithIntImmediate(Dst.getNode(), SHL, ShlImm) {
        ShiftedOperand = Dst.getOperand(0);
        EncodedShiftImm = getShifterImm(LSL, ShlImm);
        return true;
    }
    let mut SrlImm: u64 = 0;
    if isOpcWithIntImmediate(Dst.getNode(), SRL, SrlImm) {
        ShiftedOperand = Dst.getOperand(0);
        EncodedShiftImm = getShifterImm(LSR, SrlImm);
        return true;
    }
    return false;
}

fn tryOrrWithShift(N: *mut SDNode, OrOpd0: SDValue, OrOpd1: SDValue, Src: SDValue, Dst: SDValue, CurDAG: *mut SelectionDAG, BiggerPattern: bool) -> bool {
    let mut VT: EVT = N.getValueType(0);
    assert!(N.getOpcode() == OR, "Expect N to be an OR node");
    assert!(((N.getOperand(0) == OrOpd0 && N.getOperand(1) == OrOpd1) || (N.getOperand(1) == OrOpd0 && N.getOperand(0) == OrOpd1)), "Expect OrOpd0 and OrOpd1 to be operands of ISD::OR");
    assert!((VT == i32 || VT == i64), "Expect result type to be i32 or i64 since N is combinable to BFM");
    let mut DL: SDLoc = N;
    if OrOpd1 != Dst {
        return false;
    }
