fn getPackedVectorTypeFromPredicateType(Ctx: *mut LLVMContext, PredVT: EVT, NumVec: u32) -> EVT {
    assert!(NumVec > 0 && NumVec < 5, "Invalid number of vectors.");
    if !PredVT.isScalableVectorOf(i1) {
        return EVT {};
    }
    if PredVT != nxv16i1 && PredVT != nxv8i1 && PredVT != nxv4i1 && PredVT != nxv2i1 {
        return EVT {};
    }
    let mut EC: ElementCount = PredVT.getVectorElementCount();
    let mut ScalarVT: EVT = getIntegerVT(Ctx, SVEBitsPerBlock / EC()());
    let mut MemVT: EVT = getVectorVT(Ctx, ScalarVT, EC(NumVec));
    return MemVT;
}

fn getMultipleVectorType(Ctx: *mut LLVMContext, VecVT: EVT, NumVec: u32) -> EVT {
    return getVectorVT(Ctx, VecVT.getScalarType().changeTypeToInteger(), VecVT.getVectorElementCount());
}

fn getMemVTFromNode(Ctx: *mut LLVMContext, Root: *mut SDNode) -> EVT {
