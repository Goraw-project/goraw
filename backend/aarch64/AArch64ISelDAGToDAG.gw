static mut ID: i8 = 0;

fn addBitcastHints(DAG: *mut SelectionDAG, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = &mut N;
    let mut getFloatVT: Closure_1 = Closure_1 { DAG: &mut DAG };
    let mut NewOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    NewOps.reserve(N.getNumOperands());
    for let mut I: u32 = 0;
let mut E: u32 = N.getNumOperands(); I < E; I += 1 {
        let mut bitcasted: SDValue = DAG.getBitcast(getFloatVT.call(N.getOperand(I).getValueType()), N.getOperand(I));
        NewOps.push(bitcasted);
    }
    let mut OrigVT: EVT = N.getValueType(0);
    let mut OpNode: SDValue = DAG.getNode(N.getOpcode(), DL, getFloatVT.call(OrigVT), NewOps);
    return DAG.getBitcast(OrigVT, OpNode);
}

fn isIntImmediate(N: *SDNode, Imm: *mut u64) -> bool {
    if dyn_cast(N) {
        C;
    } else {
        Imm = C.getZExtValue();
        return true;
    }
    return false;
}

fn isIntImmediate(N: SDValue, Imm: *mut u64) -> bool {
    return isIntImmediate(N.getNode(), Imm);
}

fn isOpcWithIntImmediate(N: *SDNode, Opc: u32, Imm: *mut u64) -> bool {
    return N.getOpcode() == Opc && isIntImmediate(N.getOperand(1).getNode(), Imm);
}

fn isIntImmediateEq(N: SDValue, ImmExpected: u64) -> bool {
    let mut Imm: u64 = 0;
    if !isIntImmediate(N.getNode(), Imm) {
        return false;
    }
    return Imm == ImmExpected;
}

fn DecodeFMOVImm(Imm: u64, RegWidth: u32) -> APInt {
    assert!(RegWidth == 32 || RegWidth == 64);
    if RegWidth == 32 {
        return APInt { RegWidth, decodeAdvSIMDModImmType11(Imm), false, false };
    }
    return APInt { RegWidth, decodeAdvSIMDModImmType12(Imm), false, false };
}

fn DecodeNEONSplat(N: SDValue, Subtarget: *AArch64Subtarget) -> optional<APInt> {
    assert!(N.getValueType().isInteger(), "Only integers are supported");
    if operator(N).getOpcode() == NVCAST || (operator(N).getOpcode() == BITCAST && Subtarget.isLittleEndian()) {
        N = operator(N).getOperand(0);
    }
    let mut SplatWidth: u32 = N.getScalarValueSizeInBits();
    if N.getOpcode() == FMOV {
        return DecodeFMOVImm(N.getConstantOperandVal(0), SplatWidth);
    }
    if operator(N).getOpcode() == MOVI {
        return APInt { SplatWidth, N.getConstantOperandVal(0), false, false };
    }
    if operator(N).getOpcode() == MOVIshift {
        return APInt { SplatWidth, N.getConstantOperandVal(0) << N.getConstantOperandVal(1), false, false };
    }
    if operator(N).getOpcode() == MVNIshift {
        return operator(APInt { SplatWidth, N.getConstantOperandVal(0) << N.getConstantOperandVal(1), false, false });
    }
    if operator(N).getOpcode() == MOVIedit {
        return APInt { SplatWidth, decodeAdvSIMDModImmType10(N.getConstantOperandVal(0)), false, false };
    }
    if operator(N).getOpcode() == DUP {
        if dyn_cast(operator(N).getOperand(0)) {
            Const;
        } else {
            return Const.getAPIntValue().trunc(SplatWidth);
        }
    }
    let mut SplatVal: APInt = APInt {};
    if isConstantSplatVector(N.getNode(), SplatVal) {
        return SplatVal.trunc(SplatWidth);
    }
    return nullopt;
}

fn GetNEONSplatValue(N: SDValue, Subtarget: *AArch64Subtarget) -> optional<APInt> {
    let mut SplatWidth: u32 = N.getScalarValueSizeInBits();
    if DecodeNEONSplat(N, Subtarget) {
        SplatVal;
    } else {
        if operator(SplatVal).getBitWidth() <= SplatWidth {
            return getSplat(SplatWidth, operator(SplatVal));
        }
        if operator(SplatVal).isSplat(SplatWidth) {
            return operator(SplatVal).trunc(SplatWidth);
        }
    }
    return nullopt;
}

fn AArch64DAGToDAGISel::SelectNEONSplatOfSVELogicalImm(self, N: SDValue, Imm: *mut SDValue) -> bool {
    let mut ImmVal: optional<APInt> = GetNEONSplatValue(N, self.Subtarget);
    if !ImmVal {
        return false;
    }
    let mut Encoding: u64 = 0;
    if !isSVELogicalImm(N.getScalarValueSizeInBits(), operator(ImmVal).getZExtValue(), Encoding) {
        return false;
    }
    Imm = self.CurDAG.getTargetConstant(Encoding, N, i64, false);
    return true;
}

fn AArch64DAGToDAGISel::SelectNEONSplatOfSVEAddSubImm(self, N: SDValue, Imm: *mut SDValue, Shift: *mut SDValue) -> bool {
    if GetNEONSplatValue(N, self.Subtarget) {
        ImmVal;
    } else {
        return self.SelectSVEAddSubImm(N, operator(ImmVal), N.getValueType().getScalarType().getSimpleVT(), Imm, Shift, false);
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectNEONSplatOfSVEArithSImm(self, N: SDValue, Imm: *mut SDValue) -> bool {
    if GetNEONSplatValue(N, self.Subtarget) {
        ImmVal;
    } else {
        return self.SelectSVESignedArithImm(N, operator(ImmVal), Imm);
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectNEONSplatOfSImm8(self, N: SDValue, Imm: *mut SDValue) -> bool {
    let mut ImmAPIntVal: optional<APInt> = GetNEONSplatValue(N, self.Subtarget);
    if !ImmAPIntVal {
        return false;
    }
    let mut ImmVal: i64 = operator(ImmAPIntVal).getSExtValue();
    if ImmVal < -128 || ImmVal > 127 {
        return false;
    }
    Imm = self.CurDAG.getSignedTargetConstant(ImmVal, N, i32, false);
    return true;
}

fn AArch64DAGToDAGISel::SelectNEONSplatOfUImm8(self, N: SDValue, Imm: *mut SDValue) -> bool {
    let mut ImmAPIntVal: optional<APInt> = GetNEONSplatValue(N, self.Subtarget);
    if !ImmAPIntVal {
        return false;
    }
    let mut ImmVal: u64 = operator(ImmAPIntVal).getZExtValue();
    if ImmVal > 255 {
        return false;
    }
    Imm = self.CurDAG.getTargetConstant(ImmVal, N, i32, false);
    return true;
}

