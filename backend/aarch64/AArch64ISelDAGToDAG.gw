        NewShiftAmt = operator(ShiftAmt).getOperand(0);
    }
    if VT == i32 {
        NewShiftAmt = narrowIfNeeded(NewShiftAmt);
    } else if VT == i64 && operator(NewShiftAmt).getValueType(0) == i32 {
        let mut SubReg: SDValue = zeroed();
