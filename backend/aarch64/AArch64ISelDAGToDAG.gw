    let mut ImmR: u32 = (VT.getSizeInBits()) % VT.getSizeInBits();
    let mut ImmS: u32 = Width - 1;
    let mut DL: SDLoc = N;
    let mut Ops: []SDValue = zeroed();
    let mut Opc: u32 = 0;
    return true;
}

fn AArch64DAGToDAGISel::tryShiftAmountMod(self, N: *mut SDNode) -> bool {
    let mut VT: EVT = N.getValueType(0);
