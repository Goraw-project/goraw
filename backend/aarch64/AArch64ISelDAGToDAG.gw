fn AArch64DAGToDAGISel::SelectPExtPair(self, N: *mut SDNode, Opc: u32) {
    if dyn_cast(N.getOperand(2)) {
        Imm;
    } else if Imm.getZExtValue() > 1 {
        return;
    }
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Ops: [2]SDValue = [N.getOperand(1), N.getOperand(2)];
    let mut WhilePair: *mut SDNode = self.CurDAG.getMachineNode(Opc, DL, Untyped, Ops);
    let mut SuperReg: SDValue = SDValue { Node: WhilePair, ResNo: 0 };
    for let mut I: u32 = 0; I < 2; I += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: I }, self.CurDAG.getTargetExtractSubreg(psub0 + I, DL, VT, SuperReg));
    }
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectWhilePair(self, N: *mut SDNode, Opc: u32) {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Ops: [2]SDValue = [N.getOperand(1), N.getOperand(2)];
    let mut WhilePair: *mut SDNode = self.CurDAG.getMachineNode(Opc, DL, Untyped, Ops);
    let mut SuperReg: SDValue = SDValue { Node: WhilePair, ResNo: 0 };
    for let mut I: u32 = 0; I < 2; I += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: I }, self.CurDAG.getTargetExtractSubreg(psub0 + I, DL, VT, SuperReg));
    }
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectCVTIntrinsic(self, N: *mut SDNode, NumVecs: u32, Opcode: u32) {
    let mut VT: EVT = N.getValueType(0);
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(1, NumVecs);
    let mut Ops: SDValue = self.createZTuple(Regs);
    let mut DL: SDLoc = N;
    let mut Intrinsic: *mut SDNode = self.CurDAG.getMachineNode(Opcode, DL, Untyped, Ops);
    let mut SuperReg: SDValue = SDValue { Node: Intrinsic, ResNo: 0 };
    for let mut i: u32 = 0; i < NumVecs; i += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: i }, self.CurDAG.getTargetExtractSubreg(zsub0 + i, DL, VT, SuperReg));
    }
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectCVTIntrinsicFP8(self, N: *mut SDNode, NumVecs: u32, Opcode: u32) {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { N.op_begin() + 2, N.op_end() };
    Ops.push(N.getOperand(0));
    let mut Instruction: *mut SDNode = self.CurDAG.getMachineNode(Opcode, DL, [Untyped, Other], Ops);
    let mut SuperReg: SDValue = SDValue { Node: Instruction, ResNo: 0 };
    for let mut i: u32 = 0; i < NumVecs; i += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: i }, self.CurDAG.getTargetExtractSubreg(zsub0 + i, DL, VT, SuperReg));
    }
    let mut ChainIdx: u32 = NumVecs;
    self.ReplaceUses(SDValue { Node: N, ResNo: ChainIdx }, SDValue { Node: Instruction, ResNo: 1 });
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectDestructiveMultiIntrinsic(self, N: *mut SDNode, NumVecs: u32, IsZmMulti: bool, Opcode: u32, HasPred: bool) {
    assert!(Opcode != 0, "Unexpected opcode");
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut OpsIter: *mut SDUse = N.op_begin() + 1;
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut GetMultiVecOperand: Closure_3 = Closure_3 { OpsIter: &mut OpsIter, NumVecs: &mut NumVecs, cap_2: self };
    if HasPred {
        Ops.push(*OpsIter += 1.operator const llvm::SDValue &());
    }
    Ops.push(GetMultiVecOperand.call());
    if IsZmMulti {
        Ops.push(GetMultiVecOperand.call());
    } else {
        Ops.push(*OpsIter += 1.operator const llvm::SDValue &());
    }
    Ops.append(OpsIter, N.op_end());
    let mut Intrinsic: *mut SDNode = null;
    Intrinsic = self.CurDAG.getMachineNode(Opcode, DL, Untyped, Ops);
    let mut SuperReg: SDValue = SDValue { Node: Intrinsic, ResNo: 0 };
    for let mut i: u32 = 0; i < NumVecs; i += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: i }, self.CurDAG.getTargetExtractSubreg(zsub0 + i, DL, VT, SuperReg));
    }
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectPredicatedLoad(self, N: *mut SDNode, NumVecs: u32, Scale: u32, Opc_ri: u32, Opc_rr: u32, IsIntr: bool) {
    assert!(Scale < 5, "Invalid scaling value.");
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Chain: SDValue = N.getOperand(0);
    let mut Base: SDValue = SDValue {};
    let mut Offset: SDValue = SDValue {};
    let mut Opc: u32 = 0;
    tie(Opc, Base, Offset) = self.findAddrModeSVELoadStore(N, Opc_rr, Opc_ri, N.getOperand(if IsIntr { 3 } else { 2 }), self.CurDAG.getTargetConstant(0, DL, i64, false), Scale);
    let mut Ops: [4]SDValue = [N.getOperand(if IsIntr { 2 } else { 1 }), Base, Offset, Chain];
    let mut ResTys: [2]EVT = [Untyped, Other];
    let mut Load: *mut SDNode = self.CurDAG.getMachineNode(Opc, DL, ResTys, Ops);
    let mut SuperReg: SDValue = SDValue { Node: Load, ResNo: 0 };
    for let mut i: u32 = 0; i < NumVecs; i += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: i }, self.CurDAG.getTargetExtractSubreg(zsub0 + i, DL, VT, SuperReg));
    }
    let mut ChainIdx: u32 = NumVecs;
    self.ReplaceUses(SDValue { Node: N, ResNo: ChainIdx }, SDValue { Node: Load, ResNo: 1 });
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectContiguousMultiVectorLoad(self, N: *mut SDNode, NumVecs: u32, Scale: u32, Opc_ri: u32, Opc_rr: u32) {
    assert!(Scale < 4, "Invalid scaling value.");
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Chain: SDValue = N.getOperand(0);
    let mut PNg: SDValue = N.getOperand(2);
    let mut Base: SDValue = N.getOperand(3);
    let mut Offset: SDValue = self.CurDAG.getTargetConstant(0, DL, i64, false);
    let mut Opc: u32 = 0;
    tie(Opc, Base, Offset) = self.findAddrModeSVELoadStore(N, Opc_rr, Opc_ri, Base, Offset, Scale);
    let mut Ops: [4]SDValue = [PNg, Base, Offset, Chain];
    let mut ResTys: [2]EVT = [Untyped, Other];
    let mut Load: *mut SDNode = self.CurDAG.getMachineNode(Opc, DL, ResTys, Ops);
    let mut SuperReg: SDValue = SDValue { Node: Load, ResNo: 0 };
    for let mut i: u32 = 0; i < NumVecs; i += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: i }, self.CurDAG.getTargetExtractSubreg(zsub0 + i, DL, VT, SuperReg));
    }
    let mut ChainIdx: u32 = NumVecs;
    self.ReplaceUses(SDValue { Node: N, ResNo: ChainIdx }, SDValue { Node: Load, ResNo: 1 });
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectFrintFromVT(self, N: *mut SDNode, NumVecs: u32, Opcode: u32) {
    if N.getValueType(0) != nxv4f32 {
        return;
    }
    self.SelectUnaryMultiIntrinsic(N, NumVecs, true, Opcode);
}

fn AArch64DAGToDAGISel::SelectMultiVectorLutiLane(self, Node: *mut SDNode, NumOutVecs: u32, Opc: u32, MaxImm: u32) {
    if dyn_cast(Node.getOperand(4)) {
        Imm;
    } else if Imm.getZExtValue() > MaxImm {
        return;
    }
    let mut ZtValue: SDValue = SDValue {};
    if !self.ImmToReg(Node.getOperand(2), ZtValue) {
        return;
    }
    let mut Chain: SDValue = Node.getOperand(0);
    let mut Ops: [4]SDValue = [ZtValue, Node.getOperand(3), Node.getOperand(4), Chain];
    let mut DL: SDLoc = Node;
    let mut VT: EVT = Node.getValueType(0);
    let mut Instruction: *mut SDNode = self.CurDAG.getMachineNode(Opc, DL, [Untyped, Other], Ops);
    let mut SuperReg: SDValue = SDValue { Node: Instruction, ResNo: 0 };
    for let mut I: u32 = 0; I < NumOutVecs; I += 1 {
        self.ReplaceUses(SDValue { Node: Node, ResNo: I }, self.CurDAG.getTargetExtractSubreg(zsub0 + I, DL, VT, SuperReg));
    }
    let mut ChainIdx: u32 = NumOutVecs;
    self.ReplaceUses(SDValue { Node: Node, ResNo: ChainIdx }, SDValue { Node: Instruction, ResNo: 1 });
    self.CurDAG.RemoveDeadNode(Node);
}

fn AArch64DAGToDAGISel::SelectMultiVectorLuti6LaneX4(self, Node: *mut SDNode, NumIndexVecs: u32) {
    assert!((NumIndexVecs == 2 || NumIndexVecs == 3), "unexpected number of index vectors");
    let mut FirstIndexOp: u32 = 3;
    let mut ImmOp: u32 = FirstIndexOp + NumIndexVecs;
    let mut Imm: *mut ConstantSDNode = dyn_cast(Node.getOperand(ImmOp));
    if !Imm || Imm.getZExtValue() > 1 {
        return;
    }
    let mut Lane: u32 = Imm.getZExtValue();
    let mut IndexOp: u32 = FirstIndexOp;
    if NumIndexVecs == 3 {
        IndexOp += Lane;
    }
    let mut TableTuple: SDValue = self.createZTuple([Node.getOperand(1), Node.getOperand(2)]);
    let mut IndexTuple: SDValue = self.createZTuple([Node.getOperand(IndexOp), Node.getOperand(IndexOp + 1)]);
    let mut Ops: [3]SDValue = [TableTuple, IndexTuple, Node.getOperand(ImmOp)];
    let mut DL: SDLoc = Node;
    let mut VT: EVT = Node.getValueType(0);
    let mut Instruction: *mut SDNode = self.CurDAG.getMachineNode(LUTI6_4Z2Z2ZI, DL, Untyped, Ops);
    let mut SuperReg: SDValue = SDValue { Node: Instruction, ResNo: 0 };
    for let mut I: u32 = 0; I < 4; I += 1 {
        self.ReplaceUses(SDValue { Node: Node, ResNo: I }, self.CurDAG.getTargetExtractSubreg(zsub0 + I, DL, VT, SuperReg));
    }
    self.CurDAG.RemoveDeadNode(Node);
}

fn AArch64DAGToDAGISel::SelectMultiVectorLuti(self, Node: *mut SDNode, NumOutVecs: u32, Opc: u32, NumInVecs: u32) {
    assert!((NumInVecs == 2 || NumInVecs == 3), "unexpected number of input vectors");
    let mut ZtValue: SDValue = SDValue {};
    if !self.ImmToReg(Node.getOperand(2), ZtValue) {
        return;
    }
    let mut Regs: SmallVector<SDValue, 4> = Node.ops().slice(3, NumInVecs);
    let mut ZTuple: SDValue = if NumInVecs == 3 { self.createZTuple(Regs) } else { self.createZMulTuple(Regs) };
    let mut Ops: [3]SDValue = [ZtValue, ZTuple, Node.getOperand(0)];
    let mut DL: SDLoc = Node;
    let mut VT: EVT = Node.getValueType(0);
    let mut Instruction: *mut SDNode = self.CurDAG.getMachineNode(Opc, DL, [Untyped, Other], Ops);
    let mut SuperReg: SDValue = SDValue { Node: Instruction, ResNo: 0 };
    for let mut I: u32 = 0; I < NumOutVecs; I += 1 {
        self.ReplaceUses(SDValue { Node: Node, ResNo: I }, self.CurDAG.getTargetExtractSubreg(zsub0 + I, DL, VT, SuperReg));
    }
    self.ReplaceUses(SDValue { Node: Node, ResNo: NumOutVecs }, SDValue { Node: Instruction, ResNo: 1 });
    self.CurDAG.RemoveDeadNode(Node);
}

fn AArch64DAGToDAGISel::SelectClamp(self, N: *mut SDNode, NumVecs: u32, Op: u32) {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(1, NumVecs);
    let mut Zd: SDValue = self.createZMulTuple(Regs);
    let mut Zn: SDValue = N.getOperand(1 + NumVecs);
    let mut Zm: SDValue = N.getOperand(2 + NumVecs);
    let mut Ops: [3]SDValue = [Zd, Zn, Zm];
    let mut Intrinsic: *mut SDNode = self.CurDAG.getMachineNode(Op, DL, Untyped, Ops);
    let mut SuperReg: SDValue = SDValue { Node: Intrinsic, ResNo: 0 };
    for let mut i: u32 = 0; i < NumVecs; i += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: i }, self.CurDAG.getTargetExtractSubreg(zsub0 + i, DL, VT, SuperReg));
    }
    self.CurDAG.RemoveDeadNode(N);
}

fn SelectSMETile(BaseReg: *mut u32, TileNum: u32) -> bool {
    match BaseReg {
        _ => {
            return false;
        },
        ZA => {
            ZAB0;
        },
        ZAH0 => {
            if TileNum <= 1 {
                break;
            }
        },
        ZAS0 => {
            if TileNum <= 3 {
                break;
            }
        },
        ZAD0 => {
            if TileNum <= 7 {
                break;
            }
        },
    }
    BaseReg += TileNum;
    return true;
}

fn AArch64DAGToDAGISel::SelectMultiVectorMoveZ(self, N: *mut SDNode, NumVecs: u32, Op: u32, MaxIdx: u32, Scale: u32, BaseReg: u32) {
    let mut SliceBase: SDValue = N.getOperand(2);
    if BaseReg != ZA {
        SliceBase = N.getOperand(3);
    }
    let mut Base: SDValue = SDValue {};
    let mut Offset: SDValue = SDValue {};
    if !self.SelectSMETileSlice(SliceBase, MaxIdx, Base, Offset, Scale) {
        return;
    }
    let mut DL: SDLoc = N;
    let mut Ops: SmallVector<SDValue, 6> = SmallVector<SDValue, 6> {};
    if BaseReg != ZA {
        Ops.push(N.getOperand(2));
    }
    Ops.push(Base);
    Ops.push(Offset);
    Ops.push(N.getOperand(0));
    let mut Mov: *mut SDNode = self.CurDAG.getMachineNode(Op, DL, [Untyped, Other], Ops);
    let mut VT: EVT = N.getValueType(0);
    for let mut I: u32 = 0; I < NumVecs; I += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: I }, self.CurDAG.getTargetExtractSubreg(zsub0 + I, DL, VT, SDValue { Node: Mov, ResNo: 0 }));
    }
    let mut ChainIdx: u32 = NumVecs;
    self.ReplaceUses(SDValue { Node: N, ResNo: ChainIdx }, SDValue { Node: Mov, ResNo: 1 });
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectUnaryMultiIntrinsic(self, N: *mut SDNode, NumOutVecs: u32, IsTupleInput: bool, Opc: u32) {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut NumInVecs: u32 = N.getNumOperands() - 1;
    let mut Ops: SmallVector<SDValue, 6> = SmallVector<SDValue, 6> {};
    if IsTupleInput {
        assert!((NumInVecs == 2 || NumInVecs == 4), "Don't know how to handle multi-register input!");
        let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(1, NumInVecs);
        Ops.push(self.createZMulTuple(Regs));
    } else {
        for let mut I: u32 = 0; I < NumInVecs; I += 1 {
            Ops.push(N.getOperand(1 + I));
        }
    }
    let mut Res: *mut SDNode = self.CurDAG.getMachineNode(Opc, DL, Untyped, Ops);
    let mut SuperReg: SDValue = SDValue { Node: Res, ResNo: 0 };
    for let mut I: u32 = 0; I < NumOutVecs; I += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: I }, self.CurDAG.getTargetExtractSubreg(zsub0 + I, DL, VT, SuperReg));
    }
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectStore(self, N: *mut SDNode, NumVecs: u32, Opc: u32) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = operator(N.getOperand(2)).getValueType(0);
    let mut Is128Bit: bool = VT.getSizeInBits().operator unsigned long long() == 128;
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(2, NumVecs);
    let mut RegSeq: SDValue = if Is128Bit { self.createQTuple(Regs) } else { self.createDTuple(Regs) };
    let mut Ops: [3]SDValue = [RegSeq, N.getOperand(NumVecs + 2), N.getOperand(0)];
    let mut St: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, N.getValueType(0), Ops);
    let mut MemOp: *mut MachineMemOperand = cast(N).getMemOperand();
    self.CurDAG.setNodeMemRefs(cast(St), [MemOp]);
    self.ReplaceNode(N, St);
}

fn AArch64DAGToDAGISel::SelectPredicatedStore(self, N: *mut SDNode, NumVecs: u32, Scale: u32, Opc_rr: u32, Opc_ri: u32) {
    let mut dl: SDLoc = N;
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(2, NumVecs);
    let mut RegSeq: SDValue = self.createZTuple(Regs);
    let mut Opc: u32 = 0;
    let mut Offset: SDValue = SDValue {};
    let mut Base: SDValue = SDValue {};
    tie(Opc, Base, Offset) = self.findAddrModeSVELoadStore(N, Opc_rr, Opc_ri, N.getOperand(NumVecs + 3), self.CurDAG.getTargetConstant(0, dl, i64, false), Scale);
    let mut Ops: [5]SDValue = [RegSeq, N.getOperand(NumVecs + 2), Base, Offset, N.getOperand(0)];
    let mut St: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, N.getValueType(0), Ops);
    let mut MemOp: *mut MachineMemOperand = cast(N).getMemOperand();
    self.CurDAG.setNodeMemRefs(cast(St), [MemOp]);
    self.ReplaceNode(N, St);
}

fn AArch64DAGToDAGISel::SelectPostStore(self, N: *mut SDNode, NumVecs: u32, Opc: u32) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = operator(N.getOperand(2)).getValueType(0);
    let mut ResTys: [2]EVT = [i64, Other];
    let mut Is128Bit: bool = VT.getSizeInBits().operator unsigned long long() == 128;
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(1, NumVecs);
    let mut RegSeq: SDValue = if Is128Bit { self.createQTuple(Regs) } else { self.createDTuple(Regs) };
    let mut Ops: [4]SDValue = [RegSeq, N.getOperand(NumVecs + 1), N.getOperand(NumVecs + 2), N.getOperand(0)];
    let mut St: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, ResTys, Ops);
    let mut MemOp: *mut MachineMemOperand = cast(N).getMemOperand();
    self.CurDAG.setNodeMemRefs(cast(St), [MemOp]);
    self.ReplaceNode(N, St);
}

struct WidenVector {
    DAG: *mut SelectionDAG,
}

fn WidenVector::operator()(self, V64Reg: SDValue) -> SDValue {
    let mut VT: EVT = V64Reg.getValueType();
    let mut NarrowSize: u32 = VT.getVectorNumElements();
    let mut EltTy: MVT = VT.getVectorElementType().getSimpleVT();
    let mut WideTy: MVT = getVectorVT(EltTy, 2 * NarrowSize);
    let mut DL: SDLoc = V64Reg;
    let mut Undef: SDValue = SDValue { Node: self.DAG.getMachineNode(IMPLICIT_DEF, DL, WideTy), ResNo: 0 };
    return self.DAG.getTargetInsertSubreg(dsub, DL, WideTy, Undef, V64Reg);
}

fn NarrowVector(V128Reg: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = V128Reg.getValueType();
    let mut WideSize: u32 = VT.getVectorNumElements();
    let mut EltTy: MVT = VT.getVectorElementType().getSimpleVT();
    let mut NarrowTy: MVT = getVectorVT(EltTy, WideSize / 2);
    return DAG.getTargetExtractSubreg(dsub, V128Reg, NarrowTy, V128Reg);
}

fn AArch64DAGToDAGISel::SelectLoadLane(self, N: *mut SDNode, NumVecs: u32, Opc: u32) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Narrow: bool = VT.getSizeInBits().operator unsigned long long() == 64;
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(2, NumVecs);
    if Narrow {
        transform(Regs, Regs.begin(), *self.CurDAG);
    }
    let mut RegSeq: SDValue = self.createQTuple(Regs);
    let mut ResTys: [2]EVT = [Untyped, Other];
    let mut LaneNo: u32 = N.getConstantOperandVal(NumVecs + 2);
    let mut Ops: [4]SDValue = [RegSeq, self.CurDAG.getTargetConstant(LaneNo, dl, i64, false), N.getOperand(NumVecs + 3), N.getOperand(0)];
    let mut Ld: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, ResTys, Ops);
    let mut SuperReg: SDValue = SDValue { Node: Ld, ResNo: 0 };
    let mut WideVT: EVT = operator(RegSeq.getOperand(1)).getValueType(0);
    let mut QSubs: [4]u32 = [qsub0, qsub1, qsub2, qsub3];
    for let mut i: u32 = 0; i < NumVecs; i += 1 {
        let mut NV: SDValue = self.CurDAG.getTargetExtractSubreg(QSubs[i], dl, WideVT, SuperReg);
        if Narrow {
            NV = NarrowVector(NV, *self.CurDAG);
        }
        self.ReplaceUses(SDValue { Node: N, ResNo: i }, NV);
    }
    self.ReplaceUses(SDValue { Node: N, ResNo: NumVecs }, SDValue { Node: Ld, ResNo: 1 });
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectPostLoadLane(self, N: *mut SDNode, NumVecs: u32, Opc: u32) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Narrow: bool = VT.getSizeInBits().operator unsigned long long() == 64;
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(1, NumVecs);
    if Narrow {
        transform(Regs, Regs.begin(), *self.CurDAG);
    }
    let mut RegSeq: SDValue = self.createQTuple(Regs);
    let mut ResTys: [3]EVT = [i64, operator(RegSeq).getValueType(0), Other];
    let mut LaneNo: u32 = N.getConstantOperandVal(NumVecs + 1);
    let mut Ops: [5]SDValue = [RegSeq, self.CurDAG.getTargetConstant(LaneNo, dl, i64, false), N.getOperand(NumVecs + 2), N.getOperand(NumVecs + 3), N.getOperand(0)];
    let mut Ld: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, ResTys, Ops);
    self.ReplaceUses(SDValue { Node: N, ResNo: NumVecs }, SDValue { Node: Ld, ResNo: 0 });
    let mut SuperReg: SDValue = SDValue { Node: Ld, ResNo: 1 };
    if NumVecs == 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: 0 }, if Narrow { NarrowVector(SuperReg, *self.CurDAG) } else { SuperReg });
    } else {
        let mut WideVT: EVT = operator(RegSeq.getOperand(1)).getValueType(0);
        let mut QSubs: [4]u32 = [qsub0, qsub1, qsub2, qsub3];
        for let mut i: u32 = 0; i < NumVecs; i += 1 {
            let mut NV: SDValue = self.CurDAG.getTargetExtractSubreg(QSubs[i], dl, WideVT, SuperReg);
            if Narrow {
                NV = NarrowVector(NV, *self.CurDAG);
            }
            self.ReplaceUses(SDValue { Node: N, ResNo: i }, NV);
        }
    }
    self.ReplaceUses(SDValue { Node: N, ResNo: NumVecs + 1 }, SDValue { Node: Ld, ResNo: 2 });
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectStoreLane(self, N: *mut SDNode, NumVecs: u32, Opc: u32) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = operator(N.getOperand(2)).getValueType(0);
    let mut Narrow: bool = VT.getSizeInBits().operator unsigned long long() == 64;
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(2, NumVecs);
    if Narrow {
        transform(Regs, Regs.begin(), *self.CurDAG);
    }
    let mut RegSeq: SDValue = self.createQTuple(Regs);
    let mut LaneNo: u32 = N.getConstantOperandVal(NumVecs + 2);
    let mut Ops: [4]SDValue = [RegSeq, self.CurDAG.getTargetConstant(LaneNo, dl, i64, false), N.getOperand(NumVecs + 3), N.getOperand(0)];
    let mut St: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, Other, Ops);
    let mut MemOp: *mut MachineMemOperand = cast(N).getMemOperand();
    self.CurDAG.setNodeMemRefs(cast(St), [MemOp]);
    self.ReplaceNode(N, St);
}

fn AArch64DAGToDAGISel::SelectPostStoreLane(self, N: *mut SDNode, NumVecs: u32, Opc: u32) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = operator(N.getOperand(2)).getValueType(0);
    let mut Narrow: bool = VT.getSizeInBits().operator unsigned long long() == 64;
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(1, NumVecs);
    if Narrow {
        transform(Regs, Regs.begin(), *self.CurDAG);
    }
    let mut RegSeq: SDValue = self.createQTuple(Regs);
    let mut ResTys: [2]EVT = [i64, Other];
    let mut LaneNo: u32 = N.getConstantOperandVal(NumVecs + 1);
    let mut Ops: [5]SDValue = [RegSeq, self.CurDAG.getTargetConstant(LaneNo, dl, i64, false), N.getOperand(NumVecs + 2), N.getOperand(NumVecs + 3), N.getOperand(0)];
    let mut St: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, ResTys, Ops);
    let mut MemOp: *mut MachineMemOperand = cast(N).getMemOperand();
    self.CurDAG.setNodeMemRefs(cast(St), [MemOp]);
    self.ReplaceNode(N, St);
}

fn isBitfieldExtractOpFromAnd(CurDAG: *mut SelectionDAG, N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, LSB: *mut u32, MSB: *mut u32, NumberOfIgnoredLowBits: u32, BiggerPattern: bool) -> bool {
    assert!(N.getOpcode() == AND, "N must be a AND operation to call this function");
    let mut VT: EVT = N.getValueType(0);
    assert!((VT == i32 || VT == i64), "Type checking must have been done before calling this function");
    let mut AndImm: u64 = 0;
    if !isOpcWithIntImmediate(N, AND, AndImm) {
        return false;
    }
    let mut Op0: *SDNode = N.getOperand(0).getNode();
    AndImm |= maskTrailingOnes(NumberOfIgnoredLowBits);
    if AndImm & (AndImm + 1) {
        return false;
    }
    let mut ClampMSB: bool = false;
    let mut SrlImm: u64 = 0;
    if VT == i64 && Op0.getOpcode() == ANY_EXTEND && isOpcWithIntImmediate(Op0.getOperand(0).getNode(), SRL, SrlImm) {
        Opd0 = Widen(CurDAG, Op0.getOperand(0).getOperand(0));
        ClampMSB = true;
    } else if VT == i32 && Op0.getOpcode() == TRUNCATE && isOpcWithIntImmediate(Op0.getOperand(0).getNode(), SRL, SrlImm) {
        Opd0 = Op0.getOperand(0).getOperand(0);
        VT = operator(Opd0).getValueType(0);
    } else if isOpcWithIntImmediate(Op0, SRL, SrlImm) {
        Opd0 = Op0.getOperand(0);
        ClampMSB = (VT == i32);
    } else if BiggerPattern {
        Opd0 = N.getOperand(0);
    } else {
        return false;
    }
    if !BiggerPattern && (SrlImm <= 0 || SrlImm >= VT.getSizeInBits().operator unsigned long long()) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                (dbgs() << N << ": Found large shift immediate, this should not happen\n");
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    LSB = SrlImm;
    MSB = SrlImm + (if VT == i32 { countr_one(AndImm) } else { countr_one(AndImm) }) - 1;
    if ClampMSB {
        MSB = if MSB > 31 { 31 } else { MSB };
    }
    Opc = if VT == i32 { UBFMWri } else { UBFMXri };
    return true;
}

fn isBitfieldExtractOpFromSExtInReg(N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, Immr: *mut u32, Imms: *mut u32) -> bool {
    assert!(N.getOpcode() == SIGN_EXTEND_INREG);
    let mut VT: EVT = N.getValueType(0);
    let mut BitWidth: u32 = VT.getSizeInBits().operator unsigned long long();
    assert!((VT == i32 || VT == i64), "Type checking must have been done before calling this function");
    let mut Op: SDValue = N.getOperand(0);
    if operator(Op).getOpcode() == TRUNCATE {
        Op = operator(Op).getOperand(0);
        VT = operator(Op).getValueType(0);
        BitWidth = VT.getSizeInBits().operator unsigned long long();
    }
    let mut ShiftImm: u64 = 0;
    if !isOpcWithIntImmediate(Op.getNode(), SRL, ShiftImm) && !isOpcWithIntImmediate(Op.getNode(), SRA, ShiftImm) {
        return false;
    }
    let mut Width: u32 = cast(N.getOperand(1)).getVT().getSizeInBits().operator unsigned long long();
    if ShiftImm + Width > BitWidth {
        return false;
    }
    Opc = if (VT == i32) { SBFMWri } else { SBFMXri };
    Opd0 = Op.getOperand(0);
    Immr = ShiftImm;
    Imms = ShiftImm + Width - 1;
    return true;
}

fn isSeveralBitsExtractOpFromShr(N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, LSB: *mut u32, MSB: *mut u32) -> bool {
    if N.getOpcode() != SRL {
        return false;
    }
    let mut AndMask: u64 = 0;
    if !isOpcWithIntImmediate(N.getOperand(0).getNode(), AND, AndMask) {
        return false;
    }
    Opd0 = N.getOperand(0).getOperand(0);
    let mut SrlImm: u64 = 0;
    if !isIntImmediate(N.getOperand(1), SrlImm) {
        return false;
    }
    if !isMask_64(AndMask >> SrlImm) {
        return false;
    }
    Opc = if N.getValueType(0) == i32 { UBFMWri } else { UBFMXri };
    LSB = SrlImm;
    MSB = Log2_64(AndMask);
    return true;
}

fn isBitfieldExtractOpFromShr(N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, Immr: *mut u32, Imms: *mut u32, BiggerPattern: bool) -> bool {
    assert!((N.getOpcode() == SRA || N.getOpcode() == SRL), "N must be a SHR/SRA operation to call this function");
    let mut VT: EVT = N.getValueType(0);
    assert!((VT == i32 || VT == i64), "Type checking must have been done before calling this function");
    if isSeveralBitsExtractOpFromShr(N, Opc, Opd0, Immr, Imms) {
        return true;
    }
    let mut ShlImm: u64 = 0;
    let mut TruncBits: u64 = 0;
    if isOpcWithIntImmediate(N.getOperand(0).getNode(), SHL, ShlImm) {
        Opd0 = N.getOperand(0).getOperand(0);
    } else if VT == i32 && N.getOpcode() == SRL && N.getOperand(0).getNode().getOpcode() == TRUNCATE {
        Opd0 = N.getOperand(0).getOperand(0);
        TruncBits = operator(Opd0).getValueType(0).getSizeInBits() - VT.getSizeInBits().operator unsigned long long();
        VT = Opd0.getValueType();
        assert!(VT == i64, "the promoted type should be i64");
    } else if BiggerPattern {
        Opd0 = N.getOperand(0);
    } else {
        return false;
    }
    if ShlImm >= VT.getSizeInBits().operator unsigned long long() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                (dbgs() << N << ": Found large shift immediate, this should not happen\n");
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut SrlImm: u64 = 0;
    if !isIntImmediate(N.getOperand(1), SrlImm) {
        return false;
    }
    assert!(SrlImm > 0 && SrlImm < VT.getSizeInBits().operator unsigned long long(), "bad amount in shift node!");
    let mut immr: i32 = SrlImm - ShlImm;
    Immr = if immr < 0 { immr + VT.getSizeInBits().operator unsigned long long() } else { immr };
    Imms = VT.getSizeInBits().operator unsigned long long() - ShlImm - TruncBits - 1;
    if VT == i32 {
        Opc = if N.getOpcode() == SRA { SBFMWri } else { UBFMWri };
    } else {
        Opc = if N.getOpcode() == SRA { SBFMXri } else { UBFMXri };
    }
    return true;
}

fn AArch64DAGToDAGISel::tryBitfieldExtractOpFromSExt(self, N: *mut SDNode) -> bool {
    assert!(N.getOpcode() == SIGN_EXTEND);
    let mut VT: EVT = N.getValueType(0);
    let mut NarrowVT: EVT = operator(N.getOperand(0)).getValueType(0);
    if VT != i64 || NarrowVT != i32 {
        return false;
    }
    let mut ShiftImm: u64 = 0;
    let mut Op: SDValue = N.getOperand(0);
    if !isOpcWithIntImmediate(Op.getNode(), SRA, ShiftImm) {
        return false;
    }
    let mut dl: SDLoc = N;
    let mut Opd0: SDValue = Widen(self.CurDAG, Op.getOperand(0));
    let mut Immr: u32 = ShiftImm;
    let mut Imms: u32 = NarrowVT.getSizeInBits().operator unsigned long long() - 1;
    let mut Ops: [3]SDValue = [Opd0, self.CurDAG.getTargetConstant(Immr, dl, VT, false), self.CurDAG.getTargetConstant(Imms, dl, VT, false)];
    self.CurDAG.SelectNodeTo(N, SBFMXri, VT, Ops);
    return true;
}

fn isBitfieldExtractOp(CurDAG: *mut SelectionDAG, N: *mut SDNode, Opc: *mut u32, Opd0: *mut SDValue, Immr: *mut u32, Imms: *mut u32, NumberOfIgnoredLowBits: u32, BiggerPattern: bool) -> bool {
    if N.getValueType(0) != i32 && N.getValueType(0) != i64 {
        return false;
    }
    match N.getOpcode() {
        _ => {
            if !N.isMachineOpcode() {
                return false;
            }
        },
        AND => {
            return isBitfieldExtractOpFromAnd(CurDAG, N, Opc, Opd0, Immr, Imms, NumberOfIgnoredLowBits, BiggerPattern);
        },
        SRL => {
            SRA;
        },
        SIGN_EXTEND_INREG => {
            return isBitfieldExtractOpFromSExtInReg(N, Opc, Opd0, Immr, Imms);
        },
    }
    let mut NOpc: u32 = N.getMachineOpcode();
    match NOpc {
        _ => {
            return false;
        },
        SBFMWri => {
            UBFMWri;
        },
    }
    return false;
}

fn AArch64DAGToDAGISel::tryBitfieldExtractOp(self, N: *mut SDNode) -> bool {
    let mut Opc: u32 = 0;
    let mut Immr: u32 = 0;
    let mut Imms: u32 = 0;
    let mut Opd0: SDValue = SDValue {};
    if !isBitfieldExtractOp(self.CurDAG, N, Opc, Opd0, Immr, Imms, 0, false) {
        return false;
    }
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = N;
    if (Opc == SBFMXri || Opc == UBFMXri) && VT == i32 {
        let mut Ops64: [3]SDValue = [Opd0, self.CurDAG.getTargetConstant(Immr, dl, i64, false), self.CurDAG.getTargetConstant(Imms, dl, i64, false)];
        let mut BFM: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, i64, Ops64);
        let mut Inner: SDValue = self.CurDAG.getTargetExtractSubreg(sub_32, dl, i32, SDValue { Node: BFM, ResNo: 0 });
        self.ReplaceNode(N, Inner.getNode());
        return true;
    }
    let mut Ops: [3]SDValue = [Opd0, self.CurDAG.getTargetConstant(Immr, dl, VT, false), self.CurDAG.getTargetConstant(Imms, dl, VT, false)];
    self.CurDAG.SelectNodeTo(N, Opc, VT, Ops);
    return true;
}

fn isBitfieldDstMask(DstMask: u64, BitsToBeInserted: *APInt, NumberOfIgnoredHighBits: u32, VT: EVT) -> bool {
    assert!((VT == i32 || VT == i64), "i32 or i64 mask type expected!");
    let mut BitWidth: u32 = VT.getSizeInBits().operator unsigned long long() - NumberOfIgnoredHighBits;
    let mut SignificantDstMask: APInt = APInt { BitWidth, DstMask, false, true };
    let mut SignificantBitsToBeInserted: APInt = BitsToBeInserted.zextOrTrunc(BitWidth);
    return (SignificantDstMask & SignificantBitsToBeInserted) == 0 && (SignificantDstMask | SignificantBitsToBeInserted).isAllOnes();
}

fn getUsefulBitsFromAndWithImmediate(Op: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    let mut Imm: u64 = cast(Op.getOperand(1).getNode()).getZExtValue();
    Imm = decodeLogicalImmediate(Imm, UsefulBits.getBitWidth());
    operator(UsefulBits, APInt { UsefulBits.getBitWidth(), Imm, false, false });
    getUsefulBits(Op, UsefulBits, Depth + 1);
}

fn getUsefulBitsFromBitfieldMoveOpd(Op: SDValue, UsefulBits: *mut APInt, Imm: u64, MSB: u64, Depth: u32) {
    let mut OpUsefulBits: APInt = UsefulBits;
    OpUsefulBits = 1;
    if MSB >= Imm {
        operator(OpUsefulBits, MSB - Imm + 1);
        operator(OpUsefulBits);
        getUsefulBits(Op, OpUsefulBits, Depth + 1);
        operator(OpUsefulBits, Imm);
    } else {
        operator(OpUsefulBits, MSB + 1);
        operator(OpUsefulBits);
        operator(OpUsefulBits, OpUsefulBits.getBitWidth() - Imm);
        getUsefulBits(Op, OpUsefulBits, Depth + 1);
        OpUsefulBits.lshrInPlace(OpUsefulBits.getBitWidth() - Imm);
    }
    operator(UsefulBits, OpUsefulBits);
}

fn getUsefulBitsFromUBFM(Op: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    let mut Imm: u64 = cast(Op.getOperand(1).getNode()).getZExtValue();
    let mut MSB: u64 = cast(Op.getOperand(2).getNode()).getZExtValue();
    getUsefulBitsFromBitfieldMoveOpd(Op, UsefulBits, Imm, MSB, Depth);
}

fn getUsefulBitsFromOrWithShiftedReg(Op: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    let mut ShiftTypeAndValue: u64 = cast(Op.getOperand(2).getNode()).getZExtValue();
    let mut Mask: APInt = UsefulBits;
    Mask.clearAllBits();
    Mask.flipAllBits();
    if getShiftType(ShiftTypeAndValue) == LSL {
        let mut ShiftAmt: u64 = getShiftValue(ShiftTypeAndValue);
        operator(Mask, ShiftAmt);
        getUsefulBits(Op, Mask, Depth + 1);
        Mask.lshrInPlace(ShiftAmt);
    } else if getShiftType(ShiftTypeAndValue) == LSR {
        let mut ShiftAmt: u64 = getShiftValue(ShiftTypeAndValue);
        Mask.lshrInPlace(ShiftAmt);
        getUsefulBits(Op, Mask, Depth + 1);
        operator(Mask, ShiftAmt);
    } else {
        return;
    }
    operator(UsefulBits, Mask);
}

fn getUsefulBitsFromBFM(Op: SDValue, Orig: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    let mut Imm: u64 = cast(Op.getOperand(2).getNode()).getZExtValue();
    let mut MSB: u64 = cast(Op.getOperand(3).getNode()).getZExtValue();
    let mut OpUsefulBits: APInt = UsefulBits;
    OpUsefulBits = 1;
    let mut ResultUsefulBits: APInt = APInt { UsefulBits.getBitWidth(), 0, false, false };
    ResultUsefulBits.flipAllBits();
    let mut Mask: APInt = APInt { UsefulBits.getBitWidth(), 0, false, false };
    getUsefulBits(Op, ResultUsefulBits, Depth + 1);
    if MSB >= Imm {
        let mut Width: u64 = MSB - Imm + 1;
        let mut LSB: u64 = Imm;
        operator(OpUsefulBits, Width);
        operator(OpUsefulBits);
        if Op.getOperand(1) == Orig {
            Mask = ResultUsefulBits & OpUsefulBits;
            operator(Mask, LSB);
        }
        if Op.getOperand(0) == Orig {
            operator(Mask, (ResultUsefulBits & operator(OpUsefulBits)));
        }
    } else {
        let mut Width: u64 = MSB + 1;
        let mut LSB: u64 = UsefulBits.getBitWidth() - Imm;
        operator(OpUsefulBits, Width);
        operator(OpUsefulBits);
        operator(OpUsefulBits, LSB);
        if Op.getOperand(1) == Orig {
            Mask = ResultUsefulBits & OpUsefulBits;
            Mask.lshrInPlace(LSB);
        }
        if Op.getOperand(0) == Orig {
            operator(Mask, (ResultUsefulBits & operator(OpUsefulBits)));
        }
    }
    operator(UsefulBits, Mask);
}

fn getUsefulBitsForUse(UserNode: *mut SDNode, UsefulBits: *mut APInt, Orig: SDValue, Depth: u32) {
    if !UserNode.isMachineOpcode() {
        return;
    }
    match UserNode.getMachineOpcode() {
        _ => {
            return;
        },
        ANDSWri => {
            ANDSXri;
        },
        UBFMWri => {
            UBFMXri;
        },
        ORRWrs => {
            ORRXrs;
        },
        BFMWri => {
            BFMXri;
        },
        STRBBui => {
            STURBBi;
        },
        STRHHui => {
            STURHHi;
        },
    }
}

fn getUsefulBits(Op: SDValue, UsefulBits: *mut APInt, Depth: u32) {
    if Depth >= MaxRecursionDepth {
        return;
    }
    if !Depth {
        let mut Bitwidth: u32 = Op.getScalarValueSizeInBits();
        UsefulBits = APInt { Bitwidth, 0, false, false };
        UsefulBits.flipAllBits();
    }
    let mut UsersUsefulBits: APInt = APInt { UsefulBits.getBitWidth(), 0, false, false };
    for Node in Op.getNode().users() {
        let mut UsefulBitsForUse: APInt = UsefulBits;
        getUsefulBitsForUse(Node, UsefulBitsForUse, Op, Depth);
        operator(UsersUsefulBits, UsefulBitsForUse);
    }
    operator(UsefulBits, UsersUsefulBits);
}

fn getLeftShift(CurDAG: *mut SelectionDAG, Op: SDValue, ShlAmount: i32) -> SDValue {
    if ShlAmount == 0 {
        return Op;
    }
    let mut VT: EVT = Op.getValueType();
    let mut dl: SDLoc = Op;
    let mut BitWidth: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut UBFMOpc: u32 = if BitWidth == 32 { UBFMWri } else { UBFMXri };
    let mut ShiftNode: *mut SDNode = null;
    if ShlAmount > 0 {
        ShiftNode = CurDAG.getMachineNode(UBFMOpc, dl, VT, Op, CurDAG.getTargetConstant(BitWidth - ShlAmount, dl, VT, false), CurDAG.getTargetConstant(BitWidth - 1 - ShlAmount, dl, VT, false));
    } else {
        assert!(ShlAmount < 0, "expected right shift");
        let mut ShrAmount: i32 = -ShlAmount;
        ShiftNode = CurDAG.getMachineNode(UBFMOpc, dl, VT, Op, CurDAG.getTargetConstant(ShrAmount, dl, VT, false), CurDAG.getTargetConstant(BitWidth - 1, dl, VT, false));
    }
    return SDValue { Node: ShiftNode, ResNo: 0 };
}

fn isBitfieldPositioningOp(CurDAG: *mut SelectionDAG, Op: SDValue, BiggerPattern: bool, Src: *mut SDValue, DstLSB: *mut i32, Width: *mut i32) -> bool {
    let mut VT: EVT = Op.getValueType();
    let mut BitWidth: u32 = VT.getSizeInBits().operator unsigned long long();
    BitWidth as void;
    assert!(BitWidth == 32 || BitWidth == 64);
    let mut Known: KnownBits = CurDAG.computeKnownBits(Op, 0);
    let mut NonZeroBits: u64 = (operator(Known.Zero)).getZExtValue();
    if !isShiftedMask_64(NonZeroBits) {
        return false;
    }
    match Op.getOpcode() {
        _ => {
            break;
        },
        AND => {
            return isBitfieldPositioningOpFromAnd(CurDAG, Op, BiggerPattern, NonZeroBits, Src, DstLSB, Width);
        },
        SHL => {
            return isBitfieldPositioningOpFromShl(CurDAG, Op, BiggerPattern, NonZeroBits, Src, DstLSB, Width);
        },
    }
    return false;
}

fn isBitfieldPositioningOpFromAnd(CurDAG: *mut SelectionDAG, Op: SDValue, BiggerPattern: bool, NonZeroBits: u64, Src: *mut SDValue, DstLSB: *mut i32, Width: *mut i32) -> bool {
    assert!(isShiftedMask_64(NonZeroBits), "Caller guaranteed");
    let mut VT: EVT = Op.getValueType();
    assert!((VT == i32 || VT == i64), "Caller guarantees VT is one of i32 or i64");
    VT as void;
    let mut AndImm: u64 = 0;
    if !isOpcWithIntImmediate(Op.getNode(), AND, AndImm) {
        return false;
    }
    assert!((~AndImm & NonZeroBits) == 0, "Something must be wrong (e.g., in SelectionDAG::computeKnownBits)");
    let mut AndOp0: SDValue = Op.getOperand(0);
    let mut ShlImm: u64 = 0;
    let mut ShlOp0: SDValue = SDValue {};
    if isOpcWithIntImmediate(AndOp0.getNode(), SHL, ShlImm) {
        ShlOp0 = AndOp0.getOperand(0);
    } else if VT == i64 && AndOp0.getOpcode() == ANY_EXTEND && isOpcWithIntImmediate(AndOp0.getOperand(0).getNode(), SHL, ShlImm) {
        let mut ShlVal: SDValue = AndOp0.getOperand(0);
        assert!((ShlVal.getValueType() == i32), "Expect VT to be MVT::i32.");
        ShlOp0 = Widen(CurDAG, ShlVal.getOperand(0));
    } else {
        return false;
    }
    if !BiggerPattern && !AndOp0.hasOneUse() {
        return false;
    }
    DstLSB = countr_zero(NonZeroBits);
    Width = countr_one(NonZeroBits >> DstLSB);
    if Width >= VT.getSizeInBits().operator unsigned long long() as i32 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                dbgs() << "Found large Width in bit-field-positioning -- this indicates no proper combining / constant folding was performed\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    if ShlImm != DstLSB && !BiggerPattern {
        return false;
    }
    Src = getLeftShift(CurDAG, ShlOp0, ShlImm - DstLSB);
    return true;
}

fn isSeveralBitsPositioningOpFromShl(ShlImm: u64, Op: SDValue, Src: *mut SDValue, DstLSB: *mut i32, Width: *mut i32) -> bool {
    assert!(Op.getOpcode() == SHL, "Op.getNode() should be a SHL node to call this function");
    assert!(isIntImmediateEq(Op.getOperand(1), ShlImm), "Op.getNode() should shift ShlImm to call this function");
    let mut AndImm: u64 = 0;
    let mut Op0: SDValue = Op.getOperand(0);
    if !isOpcWithIntImmediate(Op0.getNode(), AND, AndImm) {
        return false;
    }
    let mut ShiftedAndImm: u64 = ((AndImm << ShlImm) >> ShlImm);
    if isMask_64(ShiftedAndImm) {
        Width = countr_one(ShiftedAndImm);
        DstLSB = ShlImm;
        Src = Op0.getOperand(0);
        return true;
    }
    return false;
}

fn isBitfieldPositioningOpFromShl(CurDAG: *mut SelectionDAG, Op: SDValue, BiggerPattern: bool, NonZeroBits: u64, Src: *mut SDValue, DstLSB: *mut i32, Width: *mut i32) -> bool {
    assert!(isShiftedMask_64(NonZeroBits), "Caller guaranteed");
    let mut VT: EVT = Op.getValueType();
    assert!((VT == i32 || VT == i64), "Caller guarantees that type is i32 or i64");
    VT as void;
    let mut ShlImm: u64 = 0;
    if !isOpcWithIntImmediate(Op.getNode(), SHL, ShlImm) {
        return false;
    }
    if !BiggerPattern && !Op.hasOneUse() {
        return false;
    }
    if isSeveralBitsPositioningOpFromShl(ShlImm, Op, Src, DstLSB, Width) {
        return true;
    }
    DstLSB = countr_zero(NonZeroBits);
    Width = countr_one(NonZeroBits >> DstLSB);
    if ShlImm != DstLSB && !BiggerPattern {
        return false;
    }
    Src = getLeftShift(CurDAG, Op.getOperand(0), ShlImm - DstLSB);
    return true;
}

fn isShiftedMask(Mask: u64, VT: EVT) -> bool {
    assert!(VT == i32 || VT == i64);
    if VT == i32 {
        return isShiftedMask_32(Mask);
    }
    return isShiftedMask_64(Mask);
}

fn tryBitfieldInsertOpFromOrAndImm(N: *mut SDNode, CurDAG: *mut SelectionDAG) -> bool {
    assert!(N.getOpcode() == OR, "Expect a OR operation");
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return false;
    }
    let mut BitWidth: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut OrImm: u64 = 0;
    if !isOpcWithIntImmediate(N, OR, OrImm) {
        return false;
    }
    if isLogicalImmediate(OrImm, BitWidth) {
        return false;
    }
    let mut MaskImm: u64 = 0;
    let mut And: SDValue = N.getOperand(0);
    if !And.hasOneUse() || !isOpcWithIntImmediate(And.getNode(), AND, MaskImm) {
        return false;
    }
    let mut Known: KnownBits = CurDAG.computeKnownBits(And, 0);
    let mut NotKnownZero: u64 = (operator(Known.Zero)).getZExtValue();
    if !isShiftedMask(Known.Zero.getZExtValue(), VT) {
        return false;
    }
    if (OrImm & NotKnownZero) != 0 {
        return false;
    }
    let mut LSB: i32 = countr_one(NotKnownZero);
    let mut Width: i32 = BitWidth - APInt { BitWidth, NotKnownZero, false, false }.popcount();
    let mut ImmR: u32 = (BitWidth - LSB) % BitWidth;
    let mut ImmS: u32 = Width - 1;
    let mut IsBFI: bool = LSB != 0;
    let mut BFIImm: u64 = OrImm >> LSB;
    if IsBFI && !isLogicalImmediate(BFIImm, BitWidth) {
        let mut OrChunks: u32 = 0;
        let mut BFIChunks: u32 = 0;
        for let mut Shift: u32 = 0; Shift < BitWidth; Shift += 16 {
            if ((OrImm >> Shift) & 65535) != 0 {
                OrChunks += 1;
            }
            if ((BFIImm >> Shift) & 65535) != 0 {
                BFIChunks += 1;
            }
        }
        if BFIChunks > OrChunks {
            return false;
        }
    }
    let mut DL: SDLoc = N;
    let mut MOVIOpc: u32 = if VT == i32 { MOVi32imm } else { MOVi64imm };
    let mut MOVI: *mut SDNode = CurDAG.getMachineNode(MOVIOpc, DL, VT, CurDAG.getTargetConstant(BFIImm, DL, VT, false));
    let mut Ops: [4]SDValue = [And.getOperand(0), SDValue { Node: MOVI, ResNo: 0 }, CurDAG.getTargetConstant(ImmR, DL, VT, false), CurDAG.getTargetConstant(ImmS, DL, VT, false)];
    let mut Opc: u32 = if (VT == i32) { BFMWri } else { BFMXri };
    CurDAG.SelectNodeTo(N, Opc, VT, Ops);
    return true;
}

fn isWorthFoldingIntoOrrWithShift(Dst: SDValue, CurDAG: *mut SelectionDAG, ShiftedOperand: *mut SDValue, EncodedShiftImm: *mut u64) -> bool {
    if !Dst.hasOneUse() {
        return false;
    }
    let mut VT: EVT = Dst.getValueType();
    assert!((VT == i32 || VT == i64), "Caller should guarantee that VT is one of i32 or i64");
    let mut SizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut DL: SDLoc = Dst.getNode();
    let mut AndImm: u64 = 0;
    let mut ShlImm: u64 = 0;
    if isOpcWithIntImmediate(Dst.getNode(), AND, AndImm) && isShiftedMask_64(AndImm) {
        let mut DstOp0: SDValue = Dst.getOperand(0);
        if !DstOp0.hasOneUse() {
            return false;
        }
        let mut SrlImm: u64 = 0;
        if isOpcWithIntImmediate(DstOp0.getNode(), SRL, SrlImm) {
            let mut NumTrailingZeroInShiftedMask: u64 = countr_zero(AndImm);
            if (SrlImm + NumTrailingZeroInShiftedMask) < SizeInBits {
                let mut MaskWidth: u32 = countr_one(AndImm >> NumTrailingZeroInShiftedMask);
                let mut UBFMOpc: u32 = if (VT == i32) { UBFMWri } else { UBFMXri };
                let mut UBFMNode: *mut SDNode = CurDAG.getMachineNode(UBFMOpc, DL, VT, DstOp0.getOperand(0), CurDAG.getTargetConstant(SrlImm + NumTrailingZeroInShiftedMask, DL, VT, false), CurDAG.getTargetConstant(SrlImm + NumTrailingZeroInShiftedMask + MaskWidth - 1, DL, VT, false));
                ShiftedOperand = SDValue { Node: UBFMNode, ResNo: 0 };
                EncodedShiftImm = getShifterImm(LSL, NumTrailingZeroInShiftedMask);
                return true;
            }
        }
        return false;
    }
    if isOpcWithIntImmediate(Dst.getNode(), SHL, ShlImm) {
        ShiftedOperand = Dst.getOperand(0);
        EncodedShiftImm = getShifterImm(LSL, ShlImm);
        return true;
    }
    let mut SrlImm: u64 = 0;
    if isOpcWithIntImmediate(Dst.getNode(), SRL, SrlImm) {
        ShiftedOperand = Dst.getOperand(0);
        EncodedShiftImm = getShifterImm(LSR, SrlImm);
        return true;
    }
    return false;
}

fn tryOrrWithShift(N: *mut SDNode, OrOpd0: SDValue, OrOpd1: SDValue, Src: SDValue, Dst: SDValue, CurDAG: *mut SelectionDAG, BiggerPattern: bool) -> bool {
    let mut VT: EVT = N.getValueType(0);
    assert!(N.getOpcode() == OR, "Expect N to be an OR node");
    assert!(((N.getOperand(0) == OrOpd0 && N.getOperand(1) == OrOpd1) || (N.getOperand(1) == OrOpd0 && N.getOperand(0) == OrOpd1)), "Expect OrOpd0 and OrOpd1 to be operands of ISD::OR");
    assert!((VT == i32 || VT == i64), "Expect result type to be i32 or i64 since N is combinable to BFM");
    let mut DL: SDLoc = N;
    if OrOpd1 != Dst {
        return false;
    }
    let mut OrrOpc: u32 = if (VT == i32) { ORRWrs } else { ORRXrs };
    if BiggerPattern {
        let mut SrcAndImm: u64 = 0;
        if isOpcWithIntImmediate(OrOpd0.getNode(), AND, SrcAndImm) && isMask_64(SrcAndImm) && OrOpd0.getOperand(0) == Src {
            let mut ShiftedOperand: SDValue = SDValue {};
            let mut EncodedShiftImm: u64 = 0;
            if isWorthFoldingIntoOrrWithShift(Dst, CurDAG, ShiftedOperand, EncodedShiftImm) {
                let mut Ops: [3]SDValue = [OrOpd0, ShiftedOperand, CurDAG.getTargetConstant(EncodedShiftImm, DL, VT, false)];
                CurDAG.SelectNodeTo(N, OrrOpc, VT, Ops);
                return true;
            }
        }
        return false;
    }
    assert!((!BiggerPattern), "BiggerPattern should be handled above");
    let mut ShlImm: u64 = 0;
    if isOpcWithIntImmediate(OrOpd0.getNode(), SHL, ShlImm) {
        if OrOpd0.getOperand(0) == Src && OrOpd0.hasOneUse() {
            let mut Ops: [3]SDValue = [Dst, Src, CurDAG.getTargetConstant(getShifterImm(LSL, ShlImm), DL, VT, false)];
            CurDAG.SelectNodeTo(N, OrrOpc, VT, Ops);
            return true;
        }
        if OrOpd0.getOperand(0) == OrOpd1 {
            let mut Ops: [3]SDValue = [OrOpd1, OrOpd1, CurDAG.getTargetConstant(getShifterImm(LSL, ShlImm), DL, VT, false)];
            CurDAG.SelectNodeTo(N, OrrOpc, VT, Ops);
            return true;
        }
    }
    let mut SrlImm: u64 = 0;
    if isOpcWithIntImmediate(OrOpd0.getNode(), SRL, SrlImm) {
        if OrOpd0.getOperand(0) == OrOpd1 {
            let mut Ops: [3]SDValue = [OrOpd1, OrOpd1, CurDAG.getTargetConstant(getShifterImm(LSR, SrlImm), DL, VT, false)];
            CurDAG.SelectNodeTo(N, OrrOpc, VT, Ops);
            return true;
        }
    }
    return false;
}

fn tryBitfieldInsertOpFromOr(N: *mut SDNode, UsefulBits: *APInt, CurDAG: *mut SelectionDAG) -> bool {
    assert!(N.getOpcode() == OR, "Expect a OR operation");
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return false;
    }
    let mut BitWidth: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut NumberOfIgnoredLowBits: u32 = UsefulBits.countr_zero();
    let mut NumberOfIgnoredHighBits: u32 = UsefulBits.countl_zero();
    for let mut I: i32 = 0; I < 4; I += 1 {
        let mut Dst: SDValue = SDValue {};
        let mut Src: SDValue = SDValue {};
        let mut ImmR: u32 = 0;
        let mut ImmS: u32 = 0;
        let mut BiggerPattern: bool = I / 2;
        let mut OrOpd0Val: SDValue = N.getOperand(I % 2);
        let mut OrOpd0: *mut SDNode = OrOpd0Val.getNode();
        let mut OrOpd1Val: SDValue = N.getOperand((I + 1) % 2);
        let mut OrOpd1: *mut SDNode = OrOpd1Val.getNode();
        let mut BFXOpc: u32 = 0;
        let mut DstLSB: i32 = 0;
        let mut Width: i32 = 0;
        if isBitfieldExtractOp(CurDAG, OrOpd0, BFXOpc, Src, ImmR, ImmS, NumberOfIgnoredLowBits, BiggerPattern) {
            if (BFXOpc != UBFMXri && VT == i64) || (BFXOpc != UBFMWri && VT == i32) {
                continue;
            }
            DstLSB = 0;
            Width = ImmS - ImmR + 1;
            if Width <= 0 {
                continue;
            }
        } else if isBitfieldPositioningOp(CurDAG, OrOpd0Val, BiggerPattern, Src, DstLSB, Width) {
            ImmR = (BitWidth - DstLSB) % BitWidth;
            ImmS = Width - 1;
        } else {
            continue;
        }
        let mut VT: EVT = OrOpd1Val.getValueType();
        assert!((VT == i32 || VT == i64), "unexpected OR operand");
        let mut Known: KnownBits = CurDAG.computeKnownBits(OrOpd1Val, 0);
        let mut BitsToBeInserted: APInt = getBitsSet(Known.getBitWidth(), DstLSB, DstLSB + Width);
        if (BitsToBeInserted & operator(Known.Zero)) != 0 {
            continue;
        }
        let mut Imm: u64 = 0;
        if isOpcWithIntImmediate(OrOpd1, AND, Imm) && isBitfieldDstMask(Imm, BitsToBeInserted, NumberOfIgnoredHighBits, VT) {
            Dst = OrOpd1.getOperand(0);
        } else {
            Dst = OrOpd1Val;
        }
        if tryOrrWithShift(N, OrOpd0Val, OrOpd1Val, Src, Dst, CurDAG, BiggerPattern) {
            return true;
        }
        let mut DL: SDLoc = N;
        let mut Ops: [4]SDValue = [Dst, Src, CurDAG.getTargetConstant(ImmR, DL, VT, false), CurDAG.getTargetConstant(ImmS, DL, VT, false)];
        let mut Opc: u32 = if (VT == i32) { BFMWri } else { BFMXri };
        CurDAG.SelectNodeTo(N, Opc, VT, Ops);
        return true;
    }
    let mut Mask0Imm: u64 = 0;
    let mut Mask1Imm: u64 = 0;
    let mut And0: SDValue = N.getOperand(0);
    let mut And1: SDValue = N.getOperand(1);
    if And0.hasOneUse() && And1.hasOneUse() && isOpcWithIntImmediate(And0.getNode(), AND, Mask0Imm) && isOpcWithIntImmediate(And1.getNode(), AND, Mask1Imm) && APInt { BitWidth, Mask0Imm, false, false } == operator(APInt { BitWidth, Mask1Imm, false, false }) && (isShiftedMask(Mask0Imm, VT) || isShiftedMask(Mask1Imm, VT)) {
        if isShiftedMask(Mask0Imm, VT) {
            swap(And0, And1);
            swap(Mask0Imm, Mask1Imm);
        }
        let mut Src: SDValue = operator(And1).getOperand(0);
        let mut Dst: SDValue = operator(And0).getOperand(0);
        let mut LSB: u32 = countr_zero(Mask1Imm);
        let mut Width: i32 = BitWidth - APInt { BitWidth, Mask0Imm, false, false }.popcount();
        let mut DL: SDLoc = N;
        let mut ShiftOpc: u32 = if (VT == i32) { UBFMWri } else { UBFMXri };
        let mut LsrImm: u64 = LSB;
        if operator(Src).hasOneUse() && isOpcWithIntImmediate(Src.getNode(), SRL, LsrImm) && (LsrImm + LSB) < BitWidth {
            Src = operator(Src).getOperand(0);
            LsrImm += LSB;
        }
        let mut LSR: *mut SDNode = CurDAG.getMachineNode(ShiftOpc, DL, VT, Src, CurDAG.getTargetConstant(LsrImm, DL, VT, false), CurDAG.getTargetConstant(BitWidth - 1, DL, VT, false));
        let mut ImmR: u32 = (BitWidth - LSB) % BitWidth;
        let mut ImmS: u32 = Width - 1;
        let mut Ops: [4]SDValue = [Dst, SDValue { Node: LSR, ResNo: 0 }, CurDAG.getTargetConstant(ImmR, DL, VT, false), CurDAG.getTargetConstant(ImmS, DL, VT, false)];
        let mut Opc: u32 = if (VT == i32) { BFMWri } else { BFMXri };
        CurDAG.SelectNodeTo(N, Opc, VT, Ops);
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::tryBitfieldInsertOp(self, N: *mut SDNode) -> bool {
    if N.getOpcode() != OR {
        return false;
    }
    let mut NUsefulBits: APInt = APInt {};
    getUsefulBits(SDValue { Node: N, ResNo: 0 }, NUsefulBits, 0);
    if operator(NUsefulBits) {
        self.CurDAG.SelectNodeTo(N, IMPLICIT_DEF, N.getValueType(0));
        return true;
    }
    if tryBitfieldInsertOpFromOr(N, NUsefulBits, self.CurDAG) {
        return true;
    }
    return tryBitfieldInsertOpFromOrAndImm(N, self.CurDAG);
}

fn AArch64DAGToDAGISel::tryBitfieldInsertInZeroOp(self, N: *mut SDNode) -> bool {
    if N.getOpcode() != AND {
        return false;
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return false;
    }
    let mut Op0: SDValue = SDValue {};
    let mut DstLSB: i32 = 0;
    let mut Width: i32 = 0;
    if !isBitfieldPositioningOp(self.CurDAG, SDValue { Node: N, ResNo: 0 }, false, Op0, DstLSB, Width) {
        return false;
    }
    let mut ImmR: u32 = (VT.getSizeInBits().operator unsigned long long() - DstLSB) % VT.getSizeInBits().operator unsigned long long();
    let mut ImmS: u32 = Width - 1;
    let mut DL: SDLoc = N;
    let mut Ops: [3]SDValue = [Op0, self.CurDAG.getTargetConstant(ImmR, DL, VT, false), self.CurDAG.getTargetConstant(ImmS, DL, VT, false)];
    let mut Opc: u32 = if (VT == i32) { UBFMWri } else { UBFMXri };
    self.CurDAG.SelectNodeTo(N, Opc, VT, Ops);
    return true;
}

fn AArch64DAGToDAGISel::tryShiftAmountMod(self, N: *mut SDNode) -> bool {
    let mut VT: EVT = N.getValueType(0);
    let mut Opc: u32 = 0;
    match N.getOpcode() {
        ROTR => {
            Opc = if (VT == i32) { RORVWr } else { RORVXr };
        },
        SHL => {
            Opc = if (VT == i32) { LSLVWr } else { LSLVXr };
        },
        SRL => {
            Opc = if (VT == i32) { LSRVWr } else { LSRVXr };
        },
        SRA => {
            Opc = if (VT == i32) { ASRVWr } else { ASRVXr };
        },
        _ => {
            return false;
        },
    }
    let mut Size: u64 = 0;
    let mut Bits: u64 = 0;
    if VT == i32 {
        Bits = 5;
        Size = 32;
    } else if VT == i64 {
        Bits = 6;
        Size = 64;
    } else {
        return false;
    }
    let mut ShiftAmt: SDValue = N.getOperand(1);
    let mut DL: SDLoc = N;
    let mut NewShiftAmt: SDValue = SDValue {};
    if operator(ShiftAmt).getOpcode() == ZERO_EXTEND || operator(ShiftAmt).getOpcode() == ANY_EXTEND {
        ShiftAmt = operator(ShiftAmt).getOperand(0);
    }
    if operator(ShiftAmt).getOpcode() == ADD || operator(ShiftAmt).getOpcode() == SUB {
        let mut Add0: SDValue = operator(ShiftAmt).getOperand(0);
        let mut Add1: SDValue = operator(ShiftAmt).getOperand(1);
        let mut Add0Imm: u64 = 0;
        let mut Add1Imm: u64 = 0;
        if isIntImmediate(Add1, Add1Imm) && (Add1Imm % Size == 0) {
            NewShiftAmt = Add0;
        } else if operator(ShiftAmt).getOpcode() == SUB && isIntImmediate(Add0, Add0Imm) && Add0Imm != 0 && (Add0Imm % Size == 0) {
            let mut NegOpc: u32 = 0;
            let mut ZeroReg: u32 = 0;
            let mut SubVT: EVT = operator(ShiftAmt).getValueType(0);
            if SubVT == i32 {
                NegOpc = SUBWrr;
                ZeroReg = WZR;
            } else {
                assert!(SubVT == i64);
                NegOpc = SUBXrr;
                ZeroReg = XZR;
            }
            let mut Zero: SDValue = self.CurDAG.getCopyFromReg(self.CurDAG.getEntryNode(), DL, ZeroReg, SubVT);
            let mut Neg: *mut MachineSDNode = self.CurDAG.getMachineNode(NegOpc, DL, SubVT, Zero, Add1);
            NewShiftAmt = SDValue { Node: Neg, ResNo: 0 };
        } else if operator(ShiftAmt).getOpcode() == SUB && isIntImmediate(Add0, Add0Imm) && (Add0Imm % Size == Size - 1) {
            let mut NotOpc: u32 = 0;
            let mut ZeroReg: u32 = 0;
            let mut SubVT: EVT = operator(ShiftAmt).getValueType(0);
            if SubVT == i32 {
                NotOpc = ORNWrr;
                ZeroReg = WZR;
            } else {
                assert!(SubVT == i64);
                NotOpc = ORNXrr;
                ZeroReg = XZR;
            }
            let mut Zero: SDValue = self.CurDAG.getCopyFromReg(self.CurDAG.getEntryNode(), DL, ZeroReg, SubVT);
            let mut Not: *mut MachineSDNode = self.CurDAG.getMachineNode(NotOpc, DL, SubVT, Zero, Add1);
            NewShiftAmt = SDValue { Node: Not, ResNo: 0 };
        } else {
            return false;
        }
    } else {
        let mut MaskImm: u64 = 0;
        if !isOpcWithIntImmediate(ShiftAmt.getNode(), AND, MaskImm) && !isOpcWithIntImmediate(ShiftAmt.getNode(), ANDS, MaskImm) {
            return false;
        }
        if countr_one(MaskImm) as u32 < Bits {
            return false;
        }
        NewShiftAmt = operator(ShiftAmt).getOperand(0);
    }
    if VT == i32 {
        NewShiftAmt = narrowIfNeeded(self.CurDAG, NewShiftAmt);
    } else if VT == i64 && operator(NewShiftAmt).getValueType(0) == i32 {
        let mut SubReg: SDValue = self.CurDAG.getTargetConstant(sub_32, DL, i32, false);
        let mut Ext: *mut MachineSDNode = self.CurDAG.getMachineNode(SUBREG_TO_REG, DL, VT, NewShiftAmt, SubReg);
        NewShiftAmt = SDValue { Node: Ext, ResNo: 0 };
    }
    let mut Ops: [2]SDValue = [N.getOperand(0), NewShiftAmt];
    self.CurDAG.SelectNodeTo(N, Opc, VT, Ops);
    return true;
}

fn checkCVTFixedPointOperandWithFBits(CurDAG: *mut SelectionDAG, N: SDValue, FixedPos: *mut SDValue, RegWidth: u32, isReciprocal: bool) -> bool {
    let mut FVal: APFloat = 0.0;
    if dyn_cast(N) {
        CN;
    } else {
        FVal = CN.getValueAPF();
    }
    if CheckFixedPointOperandConstant(FVal, RegWidth, isReciprocal) {
        FBits;
    } else {
        FixedPos = CurDAG.getTargetConstant(FBits, N, i32, false);
        return true;
    }
    return false;
}

fn checkCVTFixedPointOperandWithFBitsForVectors(CurDAG: *mut SelectionDAG, N: SDValue, FixedPos: *mut SDValue, RegWidth: u32, isReciprocal: bool) -> bool {
    if (N.getOpcode() == NVCAST || N.getOpcode() == BITCAST) && N.getValueType().getScalarSizeInBits() == N.getOperand(0).getValueType().getScalarSizeInBits() {
        N = N.getOperand(0);
    }
    let mut ImmToFloat: Closure_4 = Closure_4 { RegWidth: RegWidth };
    let mut FVal: APFloat = 0.0;
    match operator(N).getOpcode() {
        MOVIshift => {
            FVal = ImmToFloat.call(APInt { RegWidth, N.getConstantOperandVal(0) << N.getConstantOperandVal(1), false, false });
        },
        FMOV => {
            FVal = ImmToFloat.call(DecodeFMOVImm(N.getConstantOperandVal(0), RegWidth));
        },
        DUP => {
            if isa(N.getOperand(0)) {
                FVal = ImmToFloat.call(N.getConstantOperandAPInt(0).trunc(RegWidth));
            } else {
                return false;
            }
        },
        _ => {
            return false;
        },
    }
    if CheckFixedPointOperandConstant(FVal, RegWidth, isReciprocal) {
        FBits;
    } else {
        FixedPos = CurDAG.getTargetConstant(FBits, N, i32, false);
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectCVTFixedPosOperand(self, N: SDValue, FixedPos: *mut SDValue, RegWidth: u32) -> bool {
    return checkCVTFixedPointOperandWithFBits(self.CurDAG, N, FixedPos, RegWidth, false);
}

fn AArch64DAGToDAGISel::SelectCVTFixedPointVec(self, N: SDValue, FixedPos: *mut SDValue, RegWidth: u32) -> bool {
    return checkCVTFixedPointOperandWithFBitsForVectors(self.CurDAG, N, FixedPos, RegWidth, false);
}

fn AArch64DAGToDAGISel::SelectCVTFixedPosRecipOperandVec(self, N: SDValue, FixedPos: *mut SDValue, RegWidth: u32) -> bool {
    return checkCVTFixedPointOperandWithFBitsForVectors(self.CurDAG, N, FixedPos, RegWidth, true);
}

fn AArch64DAGToDAGISel::SelectCVTFixedPosRecipOperand(self, N: SDValue, FixedPos: *mut SDValue, RegWidth: u32) -> bool {
    return checkCVTFixedPointOperandWithFBits(self.CurDAG, N, FixedPos, RegWidth, true);
}

fn getIntOperandFromRegisterString(RegString: str) -> i32 {
    let mut Fields: SmallVector<StringRef, 5> = SmallVector<StringRef, 5> {};
    RegString.split(Fields, ':', -1, true);
    if Fields.len == 1 {
        return -1;
    }
    assert!(Fields.len == 5, "Invalid number of fields in read register string");
    let mut Ops: SmallVector<int, 5> = SmallVector<int, 5> {};
    let mut AllIntFields: bool = true;
    for Field in Fields {
        let mut IntField: u32 = 0;
        AllIntFields &= !Field.getAsInteger(10, IntField);
        Ops.push(IntField);
    }
    assert!(AllIntFields, "Unexpected non-integer value in special register string.");
    AllIntFields as void;
    return (Ops[0] << 14) | (Ops[1] << 11) | (Ops[2] << 7) | (Ops[3] << 3) | (Ops[4]);
}

fn AArch64DAGToDAGISel::tryReadRegister(self, N: *mut SDNode) -> bool {
    let mut MD: *MDNodeSDNode const = cast(N.getOperand(1));
    let mut RegString: *MDString const = cast(MD.getMD().getOperand(0));
    let mut DL: SDLoc = N;
    let mut ReadIs128Bit: bool = N.getOpcode() == MRRS;
    let mut Opcode64Bit: u32 = MRS;
    let mut Imm: i32 = getIntOperandFromRegisterString(RegString.getString());
    if Imm == -1 {
        let mut TheReg: *SysReg = lookupSysRegByName(RegString.getString());
        if TheReg && TheReg.Readable && TheReg.haveFeatures(self.Subtarget.getFeatureBits()) {
            Imm = TheReg.Encoding;
        } else {
            Imm = parseGenericRegister(RegString.getString());
        }
        if Imm == -1 {
            if !ReadIs128Bit && RegString.getString() == "pc" {
                Opcode64Bit = ADR;
                Imm = 0;
            } else {
                let mut PReg: Register = self.Subtarget.getTargetLowering().matchRegisterName(RegString.getString());
                let mut PseudoOp: u32 = 0;
                if GPR64RegClass.contains(PReg.operator MCRegister()) {
                    PseudoOp = READ_REGISTER_GPR64;
                } else if FPR64RegClass.contains(PReg.operator MCRegister()) {
                    PseudoOp = READ_REGISTER_FPR64;
                }
                if !ReadIs128Bit && PseudoOp && N.getValueType(0) == i64 {
                    self.CurDAG.SelectNodeTo(N, PseudoOp, i64, Other, [self.CurDAG.getTargetConstant(PReg.operator unsigned int(), DL, i32, false), N.getOperand(0)]);
                    return true;
                }
                return false;
            }
        }
    }
    let mut InChain: SDValue = N.getOperand(0);
    let mut SysRegImm: SDValue = self.CurDAG.getTargetConstant(Imm, DL, i32, false);
    if !ReadIs128Bit {
        self.CurDAG.SelectNodeTo(N, Opcode64Bit, i64, Other, [SysRegImm, InChain]);
    } else {
        let mut MRRS: *mut SDNode = self.CurDAG.getMachineNode(MRRS, DL, [Untyped, Other], [SysRegImm, InChain]);
        let mut Lo: SDValue = self.CurDAG.getTargetExtractSubreg(sube64, DL, i64, SDValue { Node: MRRS, ResNo: 0 });
        let mut Hi: SDValue = self.CurDAG.getTargetExtractSubreg(subo64, DL, i64, SDValue { Node: MRRS, ResNo: 0 });
        let mut OutChain: SDValue = SDValue { Node: MRRS, ResNo: 1 };
        self.ReplaceUses(SDValue { Node: N, ResNo: 0 }, Lo);
        self.ReplaceUses(SDValue { Node: N, ResNo: 1 }, Hi);
        self.ReplaceUses(SDValue { Node: N, ResNo: 2 }, OutChain);
    }
    return true;
}

fn AArch64DAGToDAGISel::tryWriteRegister(self, N: *mut SDNode) -> bool {
    let mut MD: *MDNodeSDNode const = cast(N.getOperand(1));
    let mut RegString: *MDString const = cast(MD.getMD().getOperand(0));
    let mut DL: SDLoc = N;
    let mut WriteIs128Bit: bool = N.getOpcode() == MSRR;
    if !WriteIs128Bit {
        let mut trySelectPState: Closure_5 = Closure_5 { N: &mut N, cap_1: self, DL: &mut DL };
        if trySelectPState.call(lookupPStateImm0_15ByName(RegString.getString()), MSRpstateImm4) {
            return true;
        }
        if trySelectPState.call(lookupPStateImm0_1ByName(RegString.getString()), MSRpstateImm1) {
            return true;
        }
    }
    let mut Imm: i32 = getIntOperandFromRegisterString(RegString.getString());
    if Imm == -1 {
        let mut TheReg: *SysReg = lookupSysRegByName(RegString.getString());
        if TheReg && TheReg.Writeable && TheReg.haveFeatures(self.Subtarget.getFeatureBits()) {
            Imm = TheReg.Encoding;
        } else {
            Imm = parseGenericRegister(RegString.getString());
        }
        if Imm == -1 {
            let mut PReg: Register = self.Subtarget.getTargetLowering().matchRegisterName(RegString.getString());
            let mut IsGPR: bool = GPR64RegClass.contains(PReg.operator MCRegister());
            let mut IsFPR: bool = FPR64RegClass.contains(PReg.operator MCRegister());
            if !WriteIs128Bit && (IsGPR || IsFPR) && N.getOperand(2).getValueType() == i64 {
                let mut Copy: SDValue = self.CurDAG.getCopyToReg(N.getOperand(0), DL, PReg, N.getOperand(2));
                let mut RegOp: SDValue = self.CurDAG.getRegister(PReg, i64);
                let mut FakeUse: *mut SDNode = self.CurDAG.getMachineNode(FAKE_USE, DL, Other, [RegOp, Copy]);
                self.ReplaceUses(SDValue { Node: N, ResNo: 0 }, SDValue { Node: FakeUse, ResNo: 0 });
                self.CurDAG.RemoveDeadNode(N);
                return true;
            }
            return false;
        }
    }
    let mut InChain: SDValue = N.getOperand(0);
    if !WriteIs128Bit {
        self.CurDAG.SelectNodeTo(N, MSR, Other, self.CurDAG.getTargetConstant(Imm, DL, i32, false), N.getOperand(2), InChain);
    } else {
        let mut Pair: *mut SDNode = self.CurDAG.getMachineNode(REG_SEQUENCE, DL, Untyped, [self.CurDAG.getTargetConstant(XSeqPairsClassRegClass.getID(), DL, i32, false), N.getOperand(2), self.CurDAG.getTargetConstant(sube64, DL, i32, false), N.getOperand(3), self.CurDAG.getTargetConstant(subo64, DL, i32, false)]);
        self.CurDAG.SelectNodeTo(N, MSRR, Other, self.CurDAG.getTargetConstant(Imm, DL, i32, false), SDValue { Node: Pair, ResNo: 0 }, InChain);
    }
    return true;
}

fn AArch64DAGToDAGISel::SelectCMP_SWAP(self, N: *mut SDNode) -> bool {
    let mut Opcode: u32 = 0;
    let mut MemTy: EVT = cast(N).getMemoryVT();
    if self.Subtarget.hasLSE() {
        return false;
    }
    if MemTy == i8 {
        Opcode = CMP_SWAP_8;
    } else if MemTy == i16 {
        Opcode = CMP_SWAP_16;
    } else if MemTy == i32 {
        Opcode = CMP_SWAP_32;
    } else if MemTy == i64 {
        Opcode = CMP_SWAP_64;
    } else {
        llvm_unreachable_internal("Unknown AtomicCmpSwap type", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ISelDAGToDAG.cpp", 4643);
    }
    let mut RegTy: MVT = if MemTy == i64 { i64 } else { i32 };
    let mut Ops: [4]SDValue = [N.getOperand(1), N.getOperand(2), N.getOperand(3), N.getOperand(0)];
    let mut CmpSwap: *mut SDNode = self.CurDAG.getMachineNode(Opcode, N, self.CurDAG.getVTList(RegTy, i32, Other), Ops);
    let mut MemOp: *mut MachineMemOperand = cast(N).getMemOperand();
    self.CurDAG.setNodeMemRefs(cast(CmpSwap), [MemOp]);
    self.ReplaceUses(SDValue { Node: N, ResNo: 0 }, SDValue { Node: CmpSwap, ResNo: 0 });
    self.ReplaceUses(SDValue { Node: N, ResNo: 1 }, SDValue { Node: CmpSwap, ResNo: 2 });
    self.CurDAG.RemoveDeadNode(N);
    return true;
}

fn AArch64DAGToDAGISel::decodeMemoryHintFlags(self: *AArch64DAGToDAGISel, MMO: *mut MachineMemOperand) -> AArch64MemoryHint {
    let mut MemoryHint: i32 = -1;
    let mut MemCacheHint: *MDNode = MMO.getMemCacheHint();
    if !MemCacheHint {
        return NONE;
    }
    for let mut I: u32 = 0; I + 1 < MemCacheHint.getNumOperands(); I += 2 {
        if MemCacheHint.getOperand(I).equalsStr("aarch64.mem_hint") {
            let mut Val: *Metadata = MemCacheHint.getOperand(I + 1).get();
            MemoryHint = cast(cast(Val).getValue()).getZExtValue();
        }
    }
    return toAArch64MemoryHint(MemoryHint);
}

fn AArch64DAGToDAGISel::isAtomicSTSHH_KEEP(self: *AArch64DAGToDAGISel, N: *mut SDNode) -> bool {
    return self.decodeMemoryHintFlags(cast(N).getMemOperand()) == STSHH_KEEP;
}

fn AArch64DAGToDAGISel::isAtomicSTSHH_STRM(self: *AArch64DAGToDAGISel, N: *mut SDNode) -> bool {
    return self.decodeMemoryHintFlags(cast(N).getMemOperand()) == STSHH_STRM;
}

fn AArch64DAGToDAGISel::SelectSVEAddSubImm(self, N: SDValue, VT: MVT, Imm: *mut SDValue, Shift: *mut SDValue, Negate: bool) -> bool {
    if !isa(N) {
        return false;
    }
    let mut Val: APInt = cast(N).getAPIntValue().trunc(VT.getFixedSizeInBits());
    return self.SelectSVEAddSubImm(N, Val, VT, Imm, Shift, Negate);
}

fn AArch64DAGToDAGISel::SelectSVEAddSubImm(self, DL: SDLoc, Val: APInt, VT: MVT, Imm: *mut SDValue, Shift: *mut SDValue, Negate: bool) -> bool {
    if Negate {
        Val = operator(Val);
    }
    match VT.SimpleTy {
        i8 => {
            Shift = self.CurDAG.getTargetConstant(0, DL, i32, false);
        },
        i16 => {
            i32;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectSVEAddSubSSatImm(self, N: SDValue, VT: MVT, Imm: *mut SDValue, Shift: *mut SDValue, Negate: bool) -> bool {
    if !isa(N) {
        return false;
    }
    let mut DL: SDLoc = N;
    let mut Val: i64 = cast(N).getAPIntValue().trunc(VT.getFixedSizeInBits()).getSExtValue();
    if Negate {
        Val = -Val;
    }
    if Val < 0 {
        return false;
    }
    match VT.SimpleTy {
        i8 => {
            Shift = self.CurDAG.getTargetConstant(0, DL, i32, false);
        },
        i16 => {
            i32;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectSVECpyDupImm(self, N: SDValue, VT: MVT, Imm: *mut SDValue, Shift: *mut SDValue) -> bool {
    if !isa(N) {
        return false;
    }
    let mut DL: SDLoc = N;
    let mut Val: i64 = cast(N).getAPIntValue().trunc(VT.getFixedSizeInBits()).getSExtValue();
    let mut ImmVal: i32 = 0;
    let mut ShiftVal: i32 = 0;
    if !isSVECpyDupImm(VT.getScalarSizeInBits(), Val, ImmVal, ShiftVal) {
        return false;
    }
    Shift = self.CurDAG.getTargetConstant(ShiftVal, DL, i32, false);
    Imm = self.CurDAG.getTargetConstant(ImmVal, DL, i32, false);
    return true;
}

fn AArch64DAGToDAGISel::SelectSVESignedArithImm(self, N: SDValue, Imm: *mut SDValue) -> bool {
    if dyn_cast(N) {
        CNode;
    } else {
        return self.SelectSVESignedArithImm(N, CNode.getAPIntValue(), Imm);
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectSVESignedArithImm(self, DL: SDLoc, Val: APInt, Imm: *mut SDValue) -> bool {
    let mut ImmVal: i64 = Val.getSExtValue();
    if ImmVal >= -128 && ImmVal < 128 {
        Imm = self.CurDAG.getSignedTargetConstant(ImmVal, DL, i32, false);
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectSVEArithImm(self, N: SDValue, VT: MVT, Imm: *mut SDValue) -> bool {
    if dyn_cast(N) {
        CNode;
    } else {
        let mut ImmVal: u64 = CNode.getZExtValue();
        match VT.SimpleTy {
            i8 => {
                ImmVal &= 255;
            },
            i16 => {
                ImmVal &= 65535;
            },
            i32 => {
                ImmVal &= 4294967295;
            },
            i64 => {
                break;
            },
            _ => {
                llvm_unreachable_internal("Unexpected type", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ISelDAGToDAG.cpp", 4839);
            },
        }
        if ImmVal < 256 {
            Imm = self.CurDAG.getTargetConstant(ImmVal, N, i32, false);
            return true;
        }
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectSVELogicalImm(self, N: SDValue, VT: MVT, Imm: *mut SDValue, Invert: bool) -> bool {
    let mut ImmVal: u64 = 0;
    if dyn_cast(N) {
        CI;
    } else {
        ImmVal = CI.getZExtValue();
    }
    if Invert {
        ImmVal = ~ImmVal;
    }
    let mut encoding: u64 = 0;
    if !isSVELogicalImm(VT.getScalarSizeInBits(), ImmVal, encoding) {
        return false;
    }
    Imm = self.CurDAG.getTargetConstant(encoding, N, i64, false);
    return true;
}

fn AArch64DAGToDAGISel::SelectSVEShiftImm(self, N: SDValue, Low: u64, High: u64, AllowSaturation: bool, Imm: *mut SDValue) -> bool {
    if dyn_cast(N) {
        CN;
    } else {
        let mut ImmVal: u64 = CN.getZExtValue();
        if ImmVal < Low {
            return false;
        }
        if ImmVal > High {
            if !AllowSaturation {
                return false;
            }
            ImmVal = High;
        }
        Imm = self.CurDAG.getTargetConstant(ImmVal, N, i32, false);
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::trySelectStackSlotTagP(self, N: *mut SDNode) -> bool {
    if !(isa(N.getOperand(1))) {
        return false;
    }
    let mut IRG_SP: SDValue = N.getOperand(2);
    if operator(IRG_SP).getOpcode() != INTRINSIC_W_CHAIN || operator(IRG_SP).getConstantOperandVal(1) != aarch64_irg_sp {
        return false;
    }
    let mut TLI: *TargetLowering = self.getTargetLowering();
    let mut DL: SDLoc = N;
    let mut FI: i32 = cast(N.getOperand(1)).getIndex();
    let mut FiOp: SDValue = self.CurDAG.getTargetFrameIndex(FI, TLI.getPointerTy(self.CurDAG.getDataLayout(), 0));
    let mut TagOffset: i32 = N.getConstantOperandVal(3);
    let mut Out: *mut SDNode = self.CurDAG.getMachineNode(TAGPstack, DL, i64, [FiOp, self.CurDAG.getTargetConstant(0, DL, i64, false), N.getOperand(2), self.CurDAG.getTargetConstant(TagOffset, DL, i64, false)]);
    self.ReplaceNode(N, Out);
    return true;
}

fn AArch64DAGToDAGISel::SelectTagP(self, N: *mut SDNode) {
    assert!(isa(N.getOperand(3)), "llvm.aarch64.tagp third argument must be an immediate");
    if self.trySelectStackSlotTagP(N) {
        return;
    }
    let mut DL: SDLoc = N;
    let mut TagOffset: i32 = N.getConstantOperandVal(3);
    let mut N1: *mut SDNode = self.CurDAG.getMachineNode(SUBP, DL, i64, [N.getOperand(1), N.getOperand(2)]);
    let mut N2: *mut SDNode = self.CurDAG.getMachineNode(ADDXrr, DL, i64, [SDValue { Node: N1, ResNo: 0 }, N.getOperand(2)]);
    let mut N3: *mut SDNode = self.CurDAG.getMachineNode(ADDG, DL, i64, [SDValue { Node: N2, ResNo: 0 }, self.CurDAG.getTargetConstant(0, DL, i64, false), self.CurDAG.getTargetConstant(TagOffset, DL, i64, false)]);
    self.ReplaceNode(N, N3);
}

fn AArch64DAGToDAGISel::trySelectCastFixedLengthToScalableVector(self, N: *mut SDNode) -> bool {
    assert!(N.getOpcode() == INSERT_SUBVECTOR, "Invalid Node!");
    if N.getConstantOperandVal(2) != 0 {
        return false;
    }
    if !N.getOperand(0).isUndef() {
        return false;
    }
    let mut VT: EVT = N.getValueType(0);
    let mut InVT: EVT = N.getOperand(1).getValueType();
    if VT.isFixedLengthVector() || InVT.isScalableVector() {
        return false;
    }
    if InVT.getSizeInBits().operator unsigned long long() <= 128 {
        return false;
    }
    assert!(VT.getSizeInBits().getKnownMinValue() == SVEBitsPerBlock, "Expected to insert into a packed scalable vector!");
    let mut DL: SDLoc = N;
    let mut RC: SDValue = self.CurDAG.getTargetConstant(ZPRRegClassID, DL, i64, false);
    self.ReplaceNode(N, self.CurDAG.getMachineNode(COPY_TO_REGCLASS, DL, VT, N.getOperand(1), RC));
    return true;
}

fn AArch64DAGToDAGISel::trySelectCastScalableToFixedLengthVector(self, N: *mut SDNode) -> bool {
    assert!(N.getOpcode() == EXTRACT_SUBVECTOR, "Invalid Node!");
    if N.getConstantOperandVal(1) != 0 {
        return false;
    }
    let mut VT: EVT = N.getValueType(0);
    let mut InVT: EVT = N.getOperand(0).getValueType();
    if VT.isScalableVector() || InVT.isFixedLengthVector() {
        return false;
    }
    if VT.getSizeInBits().operator unsigned long long() <= 128 {
        return false;
    }
    assert!(InVT.getSizeInBits().getKnownMinValue() == SVEBitsPerBlock, "Expected to extract from a packed scalable vector!");
    let mut DL: SDLoc = N;
    let mut RC: SDValue = self.CurDAG.getTargetConstant(ZPRRegClassID, DL, i64, false);
    self.ReplaceNode(N, self.CurDAG.getMachineNode(COPY_TO_REGCLASS, DL, VT, N.getOperand(0), RC));
    return true;
}

fn AArch64DAGToDAGISel::trySelectXAR(self, N: *mut SDNode) -> bool {
    assert!(N.getOpcode() == OR, "Expected OR instruction");
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    if VT.isScalableVector() && (self.Subtarget.hasSVE2() || (self.Subtarget.hasSME() && self.Subtarget.isStreaming())) {
        if N0.getOpcode() != SHL_PRED || N1.getOpcode() != SRL_PRED {
            swap(N0, N1);
        }
        if N0.getOpcode() != SHL_PRED || N1.getOpcode() != SRL_PRED {
            return false;
        }
        let mut TLI: *AArch64TargetLowering = self.getTargetLowering() as *AArch64TargetLowering;
        if !TLI.isAllActivePredicate(*self.CurDAG, N0.getOperand(0)) || !TLI.isAllActivePredicate(*self.CurDAG, N1.getOperand(0)) {
            return false;
        }
        if N0.getOperand(1) != N1.getOperand(1) {
            return false;
        }
        let mut R1: SDValue = SDValue {};
        let mut R2: SDValue = SDValue {};
        let mut IsXOROperand: bool = true;
        if N0.getOperand(1).getOpcode() != XOR {
            IsXOROperand = false;
        } else {
            R1 = N0.getOperand(1).getOperand(0);
            R2 = N1.getOperand(1).getOperand(1);
        }
        let mut ShlAmt: APInt = APInt {};
        let mut ShrAmt: APInt = APInt {};
        if !isConstantSplatVector(N0.getOperand(2).getNode(), ShlAmt) || !isConstantSplatVector(N1.getOperand(2).getNode(), ShrAmt) {
            return false;
        }
        if ShlAmt + ShrAmt != VT.getScalarSizeInBits() {
            return false;
        }
        if !IsXOROperand {
            let mut Zero: SDValue = self.CurDAG.getTargetConstant(0, DL, i64, false);
            let mut MOV: *mut SDNode = self.CurDAG.getMachineNode(MOVIv2d_ns, DL, VT, Zero);
            let mut MOVIV: SDValue = SDValue { Node: MOV, ResNo: 0 };
            let mut ZSub: SDValue = self.CurDAG.getTargetConstant(zsub, DL, i32, false);
            let mut SubRegToReg: *mut SDNode = self.CurDAG.getMachineNode(SUBREG_TO_REG, DL, VT, MOVIV, ZSub);
            R1 = operator(N1).getOperand(1);
            R2 = SDValue { Node: SubRegToReg, ResNo: 0 };
        }
        let mut Imm: SDValue = self.CurDAG.getTargetConstant(ShrAmt.getZExtValue(), DL, i32, false);
        let mut Ops: [3]SDValue = [R1, R2, Imm];
        if SelectOpcodeFromVT(VT, [XAR_ZZZI_B, XAR_ZZZI_H, XAR_ZZZI_S, XAR_ZZZI_D]) {
            Opc;
        } else {
            self.CurDAG.SelectNodeTo(N, Opc, VT, Ops);
            return true;
        }
        return false;
    }
    let mut SVT: EVT = EVT {};
    match VT.getSimpleVT().SimpleTy {
        v4i32 => {
            v2i32;
        },
        v8i16 => {
            v4i16;
        },
        v16i8 => {
            v8i8;
        },
        v2i64 => {
            v1i64;
        },
        _ => {
            return false;
        },
    }
    if (!SVT.isScalableVector() && !self.Subtarget.hasSHA3()) || (SVT.isScalableVector() && !self.Subtarget.hasSVE2()) {
        return false;
    }
    if operator(N0).getOpcode() != VSHL || operator(N1).getOpcode() != VLSHR {
        return false;
    }
    if operator(N0).getOperand(0) != operator(N1).getOperand(0) {
        return false;
    }
    let mut R1: SDValue = SDValue {};
    let mut R2: SDValue = SDValue {};
    let mut IsXOROperand: bool = true;
    if operator(operator(N1).getOperand(0)).getOpcode() != XOR {
        IsXOROperand = false;
    } else {
        let mut XOR: SDValue = N0.getOperand(0);
        R1 = XOR.getOperand(0);
        R2 = XOR.getOperand(1);
    }
    let mut HsAmt: u32 = N0.getConstantOperandVal(1);
    let mut ShAmt: u32 = N1.getConstantOperandVal(1);
    let mut Imm: SDValue = self.CurDAG.getTargetConstant(ShAmt, DL, N0.getOperand(1).getValueType(), false);
    let mut VTSizeInBits: u32 = VT.getScalarSizeInBits();
    if ShAmt + HsAmt != VTSizeInBits {
        return false;
    }
    if !IsXOROperand {
        let mut Zero: SDValue = self.CurDAG.getTargetConstant(0, DL, i64, false);
        let mut MOV: *mut SDNode = self.CurDAG.getMachineNode(MOVIv2d_ns, DL, v2i64, Zero);
        let mut MOVIV: SDValue = SDValue { Node: MOV, ResNo: 0 };
        R1 = operator(N1).getOperand(0);
        R2 = MOVIV;
    }
    if SVT != VT {
        let mut Undef: SDValue = SDValue { Node: self.CurDAG.getMachineNode(IMPLICIT_DEF, DL, SVT), ResNo: 0 };
        if SVT.isScalableVector() && VT.is64BitVector() {
            let mut QVT: EVT = VT.getDoubleNumVectorElementsVT(*self.CurDAG.getContext());
            let mut UndefQ: SDValue = SDValue { Node: self.CurDAG.getMachineNode(IMPLICIT_DEF, DL, QVT), ResNo: 0 };
            let mut DSub: SDValue = self.CurDAG.getTargetConstant(dsub, DL, i32, false);
            R1 = SDValue { Node: self.CurDAG.getMachineNode(INSERT_SUBREG, DL, QVT, UndefQ, R1, DSub), ResNo: 0 };
            if R2.getValueType() == VT {
                R2 = SDValue { Node: self.CurDAG.getMachineNode(INSERT_SUBREG, DL, QVT, UndefQ, R2, DSub), ResNo: 0 };
            }
        }
        let mut SubReg: SDValue = self.CurDAG.getTargetConstant((if SVT.isScalableVector() { zsub } else { dsub }), DL, i32, false);
        R1 = SDValue { Node: self.CurDAG.getMachineNode(INSERT_SUBREG, DL, SVT, Undef, R1, SubReg), ResNo: 0 };
        if SVT.isScalableVector() || R2.getValueType() != SVT {
            R2 = SDValue { Node: self.CurDAG.getMachineNode(INSERT_SUBREG, DL, SVT, Undef, R2, SubReg), ResNo: 0 };
        }
    }
    let mut Ops: [3]SDValue = [R1, R2, Imm];
    let mut XAR: *mut SDNode = null;
    if SVT.isScalableVector() {
        if SelectOpcodeFromVT(SVT, [XAR_ZZZI_B, XAR_ZZZI_H, XAR_ZZZI_S, XAR_ZZZI_D]) {
            Opc;
        } else {
            XAR = self.CurDAG.getMachineNode(Opc, DL, SVT, Ops);
        }
    } else {
        XAR = self.CurDAG.getMachineNode(XAR, DL, SVT, Ops);
    }
    assert!(XAR, "Unexpected NULL value for XAR instruction in DAG");
    if SVT != VT {
        if VT.is64BitVector() && SVT.isScalableVector() {
            let mut QVT: EVT = VT.getDoubleNumVectorElementsVT(*self.CurDAG.getContext());
            let mut ZSub: SDValue = self.CurDAG.getTargetConstant(zsub, DL, i32, false);
            let mut Q: *mut SDNode = self.CurDAG.getMachineNode(EXTRACT_SUBREG, DL, QVT, SDValue { Node: XAR, ResNo: 0 }, ZSub);
            let mut DSub: SDValue = self.CurDAG.getTargetConstant(dsub, DL, i32, false);
            XAR = self.CurDAG.getMachineNode(EXTRACT_SUBREG, DL, VT, SDValue { Node: Q, ResNo: 0 }, DSub);
        } else {
            let mut SubReg: SDValue = self.CurDAG.getTargetConstant((if SVT.isScalableVector() { zsub } else { dsub }), DL, i32, false);
            XAR = self.CurDAG.getMachineNode(EXTRACT_SUBREG, DL, VT, SDValue { Node: XAR, ResNo: 0 }, SubReg);
        }
    }
    self.ReplaceNode(N, XAR);
    return true;
}

fn getZeroRegister(DAG: *mut SelectionDAG, DL: SDLoc, VT: EVT) -> SDValue {
    assert!(VT == i32 || VT == i64);
    return DAG.getCopyFromReg(DAG.getEntryNode(), DL, if VT == i32 { WZR } else { XZR }, VT);
}

fn AArch64DAGToDAGISel::Select(self, Node: *mut SDNode) {
    if Node.isMachineOpcode() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                errs() << "== ";
                Node.dump(self.CurDAG);
                errs() << "\n";
            }
        }
            if !(false) { break; }
        }
        Node.setNodeId(-1);
        return;
    }
    let mut VT: EVT = Node.getValueType(0);
    match Node.getOpcode() {
        _ => {
            break;
        },
        ATOMIC_CMP_SWAP => {
            if self.SelectCMP_SWAP(Node) {
                return;
            }
        },
        READ_REGISTER => {
            MRRS;
        },
        WRITE_REGISTER => {
            MSRR;
        },
        LOAD => {
            if self.tryIndexedLoad(Node) {
                return;
            }
            break;
        },
        SRL => {
            AND;
        },
        ROTR => {
            SHL;
        },
        SIGN_EXTEND => {
            if self.tryBitfieldExtractOpFromSExt(Node) {
                return;
            }
        },
        OR => {
            if self.tryBitfieldInsertOp(Node) {
                return;
            }
        },
        EXTRACT_SUBVECTOR => {
            if self.trySelectCastScalableToFixedLengthVector(Node) {
                return;
            }
            break;
        },
        INSERT_SUBVECTOR => {
            if self.trySelectCastFixedLengthToScalableVector(Node) {
                return;
            }
            break;
        },
        CSEL => {
            if self.tryFoldCselToFMaxMin(Node) {
                return;
            }
        },
        Constant => {
            let mut ConstNode: *mut ConstantSDNode = cast(Node);
            if ConstNode.isZero() && (VT == i32 || VT == i64) {
                self.ReplaceNode(Node, getZeroRegister(*self.CurDAG, Node, VT).getNode());
                return;
            }
            break;
        },
        FrameIndex => {
            let mut FI: i32 = cast(Node).getIndex();
            let mut Shifter: u32 = getShifterImm(LSL, 0);
            let mut TLI: *TargetLowering = self.getTargetLowering();
            let mut TFI: SDValue = self.CurDAG.getTargetFrameIndex(FI, TLI.getPointerTy(self.CurDAG.getDataLayout(), 0));
            let mut DL: SDLoc = Node;
            let mut Ops: [3]SDValue = [TFI, self.CurDAG.getTargetConstant(0, DL, i32, false), self.CurDAG.getTargetConstant(Shifter, DL, i32, false)];
            self.CurDAG.SelectNodeTo(Node, ADDXri, i64, Ops);
            return;
        },
        INTRINSIC_W_CHAIN => {
            let mut IntNo: u32 = Node.getConstantOperandVal(1);
            match IntNo {
                _ => {
                    break;
                },
                aarch64_gcsss => {
                    let mut DL: SDLoc = Node;
                    let mut Chain: SDValue = Node.getOperand(0);
                    let mut Val: SDValue = Node.getOperand(2);
                    let mut Zero: SDValue = self.CurDAG.getCopyFromReg(Chain, DL, XZR, i64);
                    let mut SS1: *mut SDNode = self.CurDAG.getMachineNode(GCSSS1, DL, Other, Val, Chain);
                    let mut SS2: *mut SDNode = self.CurDAG.getMachineNode(GCSSS2, DL, i64, Other, Zero, SDValue { Node: SS1, ResNo: 0 });
                    self.ReplaceNode(Node, SS2);
                    return;
                },
                aarch64_ldaxp => {
                    aarch64_ldxp;
                },
                aarch64_stlxp => {
                    aarch64_stxp;
                },
                aarch64_neon_ld1x2 => {
                    if VT == v8i8 {
                        self.SelectLoad(Node, 2, LD1Twov8b, dsub0);
                        return;
                    } else if VT == v16i8 {
                        self.SelectLoad(Node, 2, LD1Twov16b, qsub0);
                        return;
                    } else if VT == v4i16 || VT == v4f16 || VT == v4bf16 {
                        self.SelectLoad(Node, 2, LD1Twov4h, dsub0);
                        return;
                    } else if VT == v8i16 || VT == v8f16 || VT == v8bf16 {
                        self.SelectLoad(Node, 2, LD1Twov8h, qsub0);
                        return;
                    } else if VT == v2i32 || VT == v2f32 {
                        self.SelectLoad(Node, 2, LD1Twov2s, dsub0);
                        return;
                    } else if VT == v4i32 || VT == v4f32 {
                        self.SelectLoad(Node, 2, LD1Twov4s, qsub0);
                        return;
                    } else if VT == v1i64 || VT == v1f64 {
                        self.SelectLoad(Node, 2, LD1Twov1d, dsub0);
                        return;
                    } else if VT == v2i64 || VT == v2f64 {
                        self.SelectLoad(Node, 2, LD1Twov2d, qsub0);
                        return;
                    }
                },
                aarch64_neon_ld1x3 => {
                    if VT == v8i8 {
                        self.SelectLoad(Node, 3, LD1Threev8b, dsub0);
                        return;
                    } else if VT == v16i8 {
                        self.SelectLoad(Node, 3, LD1Threev16b, qsub0);
                        return;
                    } else if VT == v4i16 || VT == v4f16 || VT == v4bf16 {
                        self.SelectLoad(Node, 3, LD1Threev4h, dsub0);
                        return;
                    } else if VT == v8i16 || VT == v8f16 || VT == v8bf16 {
                        self.SelectLoad(Node, 3, LD1Threev8h, qsub0);
                        return;
                    } else if VT == v2i32 || VT == v2f32 {
                        self.SelectLoad(Node, 3, LD1Threev2s, dsub0);
                        return;
                    } else if VT == v4i32 || VT == v4f32 {
                        self.SelectLoad(Node, 3, LD1Threev4s, qsub0);
                        return;
                    } else if VT == v1i64 || VT == v1f64 {
                        self.SelectLoad(Node, 3, LD1Threev1d, dsub0);
                        return;
                    } else if VT == v2i64 || VT == v2f64 {
                        self.SelectLoad(Node, 3, LD1Threev2d, qsub0);
                        return;
                    }
                },
                aarch64_neon_ld1x4 => {
                    if VT == v8i8 {
                        self.SelectLoad(Node, 4, LD1Fourv8b, dsub0);
                        return;
                    } else if VT == v16i8 {
                        self.SelectLoad(Node, 4, LD1Fourv16b, qsub0);
                        return;
                    } else if VT == v4i16 || VT == v4f16 || VT == v4bf16 {
                        self.SelectLoad(Node, 4, LD1Fourv4h, dsub0);
