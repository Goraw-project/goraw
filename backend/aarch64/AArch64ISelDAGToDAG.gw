            return true;
        }
    }
    return false;
}

fn tryBitfieldInsertOpFromOr(N: *mut SDNode, UsefulBits: *APInt, CurDAG: *mut SelectionDAG) -> bool {
    assert!(N.getOpcode() == OR, "Expect a OR operation");
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return false;
    }
    let mut BitWidth: u32 = VT.getSizeInBits();
    let mut NumberOfIgnoredLowBits: u32 = UsefulBits.countr_zero();
    let mut NumberOfIgnoredHighBits: u32 = UsefulBits.countl_zero();
    for let mut I: i32 = 0; I < 4; I += 1 {
        let mut Dst: SDValue = SDValue {};
        let mut Src: SDValue = SDValue {};
        let mut ImmR: u32 = 0;
        let mut ImmS: u32 = 0;
        let mut BiggerPattern: bool = I / 2;
        let mut OrOpd0Val: SDValue = N.getOperand(I % 2);
        let mut OrOpd0: *mut SDNode = OrOpd0Val.getNode();
        let mut OrOpd1Val: SDValue = N.getOperand((I + 1) % 2);
        let mut OrOpd1: *mut SDNode = OrOpd1Val.getNode();
        let mut BFXOpc: u32 = 0;
        let mut DstLSB: i32 = 0;
        let mut Width: i32 = 0;
        if isBitfieldExtractOp(CurDAG, OrOpd0, BFXOpc, Src, ImmR, ImmS, NumberOfIgnoredLowBits, BiggerPattern) {
            if  {
                continue;
            }
            DstLSB = 0;
            Width = ImmS - ImmR + 1;
            if Width <= 0 {
                continue;
            }
        } else if isBitfieldPositioningOp(CurDAG, OrOpd0Val, BiggerPattern, Src, DstLSB, Width) {
            ImmR = (BitWidth - DstLSB) % BitWidth;
            ImmS = Width - 1;
        } else {
            continue;
        }
        let mut VT: EVT = OrOpd1Val.getValueType();
        assert!((VT == i32 || VT == i64), "unexpected OR operand");
        let mut Known: KnownBits = CurDAG.computeKnownBits(OrOpd1Val, 0);
        let mut BitsToBeInserted: APInt = getBitsSet(Known.getBitWidth(), DstLSB, DstLSB + Width);
        if (BitsToBeInserted & operator(Known.Zero)) != 0 {
            continue;
        }
        let mut Imm: u64 = 0;
        if isOpcWithIntImmediate(OrOpd1, AND, Imm) && isBitfieldDstMask(Imm, BitsToBeInserted, NumberOfIgnoredHighBits, VT) {
            Dst = OrOpd1.getOperand(0);
        } else {
            Dst = OrOpd1Val;
        }
        if tryOrrWithShift(N, OrOpd0Val, OrOpd1Val, Src, Dst, CurDAG, BiggerPattern) {
            return true;
        }
        let mut DL: SDLoc = N;
        let mut Ops: [4]SDValue = [Dst, Src, CurDAG.getTargetConstant(ImmR, DL, VT, false), CurDAG.getTargetConstant(ImmS, DL, VT, false)];
        let mut Opc: u32 = 0;
        CurDAG;
        return true;
    }
    let mut Mask0Imm: u64 = 0;
    let mut Mask1Imm: u64 = 0;
    let mut And0: SDValue = N.getOperand(0);
    let mut And1: SDValue = N.getOperand(1);
    if And0.hasOneUse() && And1.hasOneUse() && isOpcWithIntImmediate(And0.getNode(), AND, Mask0Imm) && isOpcWithIntImmediate(And1.getNode(), AND, Mask1Imm) && APInt { BitWidth, Mask0Imm, false, false } == operator(APInt { BitWidth, Mask1Imm, false, false }) && (isShiftedMask(Mask0Imm, VT) || isShiftedMask(Mask1Imm, VT)) {
        if isShiftedMask(Mask0Imm, VT) {
            swap(And0, And1);
            swap(Mask0Imm, Mask1Imm);
        }
        let mut Src: SDValue = operator(And1).getOperand(0);
        let mut Dst: SDValue = operator(And0).getOperand(0);
        let mut LSB: u32 = countr_zero(Mask1Imm);
        let mut Width: i32 = BitWidth - APInt { BitWidth, Mask0Imm, false, false }.popcount();
        let mut DL: SDLoc = N;
        let mut ShiftOpc: u32 = 0;
        let mut LsrImm: u64 = LSB;
        if operator(Src).hasOneUse() && isOpcWithIntImmediate(Src.getNode(), SRL, LsrImm) && (LsrImm + LSB) < BitWidth {
            Src = operator(Src).getOperand(0);
            LsrImm += LSB;
        }
        let mut LSR: *mut SDNode = CurDAG.getMachineNode(ShiftOpc, DL, VT, Src, CurDAG.getTargetConstant(LsrImm, DL, VT, false), CurDAG.getTargetConstant(BitWidth - 1, DL, VT, false));
        let mut ImmR: u32 = (BitWidth - LSB) % BitWidth;
        let mut ImmS: u32 = Width - 1;
        let mut Ops: [4]SDValue = [Dst, SDValue { Node: LSR, ResNo: 0 }, CurDAG.getTargetConstant(ImmR, DL, VT, false), CurDAG.getTargetConstant(ImmS, DL, VT, false)];
        let mut Opc: u32 = 0;
        CurDAG;
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::tryBitfieldInsertOp(self, N: *mut SDNode) -> bool {
    if N.getOpcode() != OR {
        return false;
    }
    let mut NUsefulBits: APInt = APInt {};
    getUsefulBits(SDValue { Node: N, ResNo: 0 }, NUsefulBits, 0);
    if operator(NUsefulBits) {
        return true;
    }
    if tryBitfieldInsertOpFromOr(N, NUsefulBits) {
        return true;
    }
    return tryBitfieldInsertOpFromOrAndImm(N);
}

