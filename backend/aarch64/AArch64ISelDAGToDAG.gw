}

fn AArch64DAGToDAGISel::SelectDupZero(self, N: SDValue) -> bool {
    match operator(N).getOpcode() {
        SPLAT_VECTOR => {
            let mut Opnd0: SDValue = operator(N).getOperand(0);
            if isNullConstant(Opnd0) {
                return true;
            }
            if isNullFPConstant(Opnd0) {
                return true;
            }
            break;
        },
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectSVEShiftSplatImmR(self, N: SDValue, Imm: *mut SDValue) -> bool {
    if operator(N).getOpcode() != SPLAT_VECTOR {
        return false;
    }
    let mut EltVT: EVT = operator(N).getValueType(0).getVectorElementType();
    return self.SelectSVEShiftImm(operator(N).getOperand(0), 1, EltVT.getFixedSizeInBits(), true, Imm);
}

