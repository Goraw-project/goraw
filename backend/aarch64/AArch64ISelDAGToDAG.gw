                self.SelectPostLoad(Node, 4, LD4Rv4s_POST, qsub0);
                return;
            } else if VT == v1i64 || VT == v1f64 {
                self.SelectPostLoad(Node, 4, LD4Rv1d_POST, dsub0);
                return;
            } else if VT == v2i64 || VT == v2f64 {
                self.SelectPostLoad(Node, 4, LD4Rv2d_POST, qsub0);
                return;
            }
            break;
        },
        LD1LANEpost => {
            if VT == v16i8 || VT == v8i8 {
                self.SelectPostLoadLane(Node, 1, LD1i8_POST);
                return;
            } else if VT == v8i16 || VT == v4i16 || VT == v4f16 || VT == v8f16 || VT == v4bf16 || VT == v8bf16 {
                self.SelectPostLoadLane(Node, 1, LD1i16_POST);
                return;
            } else if VT == v4i32 || VT == v2i32 || VT == v4f32 || VT == v2f32 {
                self.SelectPostLoadLane(Node, 1, LD1i32_POST);
                return;
            } else if VT == v2i64 || VT == v1i64 || VT == v2f64 || VT == v1f64 {
                self.SelectPostLoadLane(Node, 1, LD1i64_POST);
                return;
            }
            break;
        },
        LD2LANEpost => {
            if VT == v16i8 || VT == v8i8 {
                self.SelectPostLoadLane(Node, 2, LD2i8_POST);
                return;
            } else if VT == v8i16 || VT == v4i16 || VT == v4f16 || VT == v8f16 || VT == v4bf16 || VT == v8bf16 {
                self.SelectPostLoadLane(Node, 2, LD2i16_POST);
                return;
            } else if VT == v4i32 || VT == v2i32 || VT == v4f32 || VT == v2f32 {
                self.SelectPostLoadLane(Node, 2, LD2i32_POST);
                return;
            } else if VT == v2i64 || VT == v1i64 || VT == v2f64 || VT == v1f64 {
                self.SelectPostLoadLane(Node, 2, LD2i64_POST);
                return;
            }
            break;
        },
        LD3LANEpost => {
            if VT == v16i8 || VT == v8i8 {
                self.SelectPostLoadLane(Node, 3, LD3i8_POST);
                return;
            } else if VT == v8i16 || VT == v4i16 || VT == v4f16 || VT == v8f16 || VT == v4bf16 || VT == v8bf16 {
                self.SelectPostLoadLane(Node, 3, LD3i16_POST);
                return;
            } else if VT == v4i32 || VT == v2i32 || VT == v4f32 || VT == v2f32 {
                self.SelectPostLoadLane(Node, 3, LD3i32_POST);
                return;
            } else if VT == v2i64 || VT == v1i64 || VT == v2f64 || VT == v1f64 {
                self.SelectPostLoadLane(Node, 3, LD3i64_POST);
                return;
            }
            break;
        },
        LD4LANEpost => {
            if VT == v16i8 || VT == v8i8 {
                self.SelectPostLoadLane(Node, 4, LD4i8_POST);
                return;
            } else if VT == v8i16 || VT == v4i16 || VT == v4f16 || VT == v8f16 || VT == v4bf16 || VT == v8bf16 {
                self.SelectPostLoadLane(Node, 4, LD4i16_POST);
                return;
            } else if VT == v4i32 || VT == v2i32 || VT == v4f32 || VT == v2f32 {
                self.SelectPostLoadLane(Node, 4, LD4i32_POST);
                return;
            } else if VT == v2i64 || VT == v1i64 || VT == v2f64 || VT == v1f64 {
                self.SelectPostLoadLane(Node, 4, LD4i64_POST);
                return;
            }
            break;
        },
        ST2post => {
            VT = Node.getOperand(1).getValueType();
            if VT == v8i8 {
                self.SelectPostStore(Node, 2, ST2Twov8b_POST);
                return;
            } else if VT == v16i8 {
                self.SelectPostStore(Node, 2, ST2Twov16b_POST);
                return;
            } else if VT == v4i16 || VT == v4f16 || VT == v4bf16 {
                self.SelectPostStore(Node, 2, ST2Twov4h_POST);
                return;
            } else if VT == v8i16 || VT == v8f16 || VT == v8bf16 {
                self.SelectPostStore(Node, 2, ST2Twov8h_POST);
                return;
            } else if VT == v2i32 || VT == v2f32 {
                self.SelectPostStore(Node, 2, ST2Twov2s_POST);
                return;
            } else if VT == v4i32 || VT == v4f32 {
                self.SelectPostStore(Node, 2, ST2Twov4s_POST);
                return;
            } else if VT == v2i64 || VT == v2f64 {
                self.SelectPostStore(Node, 2, ST2Twov2d_POST);
                return;
            } else if VT == v1i64 || VT == v1f64 {
                self.SelectPostStore(Node, 2, ST1Twov1d_POST);
                return;
            }
            break;
        },
        ST3post => {
            VT = Node.getOperand(1).getValueType();
            if VT == v8i8 {
                self.SelectPostStore(Node, 3, ST3Threev8b_POST);
                return;
            } else if VT == v16i8 {
                self.SelectPostStore(Node, 3, ST3Threev16b_POST);
                return;
            } else if VT == v4i16 || VT == v4f16 || VT == v4bf16 {
                self.SelectPostStore(Node, 3, ST3Threev4h_POST);
                return;
            } else if VT == v8i16 || VT == v8f16 || VT == v8bf16 {
                self.SelectPostStore(Node, 3, ST3Threev8h_POST);
                return;
            } else if VT == v2i32 || VT == v2f32 {
                self.SelectPostStore(Node, 3, ST3Threev2s_POST);
                return;
            } else if VT == v4i32 || VT == v4f32 {
                self.SelectPostStore(Node, 3, ST3Threev4s_POST);
                return;
            } else if VT == v2i64 || VT == v2f64 {
                self.SelectPostStore(Node, 3, ST3Threev2d_POST);
                return;
            } else if VT == v1i64 || VT == v1f64 {
                self.SelectPostStore(Node, 3, ST1Threev1d_POST);
                return;
            }
            break;
        },
        ST4post => {
            VT = Node.getOperand(1).getValueType();
            if VT == v8i8 {
                self.SelectPostStore(Node, 4, ST4Fourv8b_POST);
                return;
            } else if VT == v16i8 {
                self.SelectPostStore(Node, 4, ST4Fourv16b_POST);
                return;
            } else if VT == v4i16 || VT == v4f16 || VT == v4bf16 {
                self.SelectPostStore(Node, 4, ST4Fourv4h_POST);
                return;
            } else if VT == v8i16 || VT == v8f16 || VT == v8bf16 {
                self.SelectPostStore(Node, 4, ST4Fourv8h_POST);
                return;
            } else if VT == v2i32 || VT == v2f32 {
                self.SelectPostStore(Node, 4, ST4Fourv2s_POST);
                return;
            } else if VT == v4i32 || VT == v4f32 {
                self.SelectPostStore(Node, 4, ST4Fourv4s_POST);
                return;
            } else if VT == v2i64 || VT == v2f64 {
                self.SelectPostStore(Node, 4, ST4Fourv2d_POST);
                return;
            } else if VT == v1i64 || VT == v1f64 {
                self.SelectPostStore(Node, 4, ST1Fourv1d_POST);
                return;
            }
            break;
        },
        ST1x2post => {
            VT = Node.getOperand(1).getValueType();
            if VT == v8i8 {
                self.SelectPostStore(Node, 2, ST1Twov8b_POST);
                return;
            } else if VT == v16i8 {
                self.SelectPostStore(Node, 2, ST1Twov16b_POST);
                return;
            } else if VT == v4i16 || VT == v4f16 || VT == v4bf16 {
                self.SelectPostStore(Node, 2, ST1Twov4h_POST);
                return;
            } else if VT == v8i16 || VT == v8f16 || VT == v8bf16 {
                self.SelectPostStore(Node, 2, ST1Twov8h_POST);
                return;
            } else if VT == v2i32 || VT == v2f32 {
                self.SelectPostStore(Node, 2, ST1Twov2s_POST);
                return;
            } else if VT == v4i32 || VT == v4f32 {
                self.SelectPostStore(Node, 2, ST1Twov4s_POST);
                return;
            } else if VT == v1i64 || VT == v1f64 {
                self.SelectPostStore(Node, 2, ST1Twov1d_POST);
                return;
            } else if VT == v2i64 || VT == v2f64 {
                self.SelectPostStore(Node, 2, ST1Twov2d_POST);
                return;
            }
            break;
        },
        ST1x3post => {
            VT = Node.getOperand(1).getValueType();
            if VT == v8i8 {
                self.SelectPostStore(Node, 3, ST1Threev8b_POST);
                return;
            } else if VT == v16i8 {
                self.SelectPostStore(Node, 3, ST1Threev16b_POST);
                return;
            } else if VT == v4i16 || VT == v4f16 || VT == v4bf16 {
                self.SelectPostStore(Node, 3, ST1Threev4h_POST);
                return;
            } else if VT == v8i16 || VT == v8f16 || VT == v8bf16 {
                self.SelectPostStore(Node, 3, ST1Threev8h_POST);
                return;
            } else if VT == v2i32 || VT == v2f32 {
                self.SelectPostStore(Node, 3, ST1Threev2s_POST);
                return;
            } else if VT == v4i32 || VT == v4f32 {
                self.SelectPostStore(Node, 3, ST1Threev4s_POST);
                return;
            } else if VT == v1i64 || VT == v1f64 {
                self.SelectPostStore(Node, 3, ST1Threev1d_POST);
                return;
            } else if VT == v2i64 || VT == v2f64 {
                self.SelectPostStore(Node, 3, ST1Threev2d_POST);
                return;
            }
            break;
        },
        ST1x4post => {
            VT = Node.getOperand(1).getValueType();
            if VT == v8i8 {
                self.SelectPostStore(Node, 4, ST1Fourv8b_POST);
                return;
            } else if VT == v16i8 {
                self.SelectPostStore(Node, 4, ST1Fourv16b_POST);
                return;
            } else if VT == v4i16 || VT == v4f16 || VT == v4bf16 {
                self.SelectPostStore(Node, 4, ST1Fourv4h_POST);
                return;
            } else if VT == v8i16 || VT == v8f16 || VT == v8bf16 {
                self.SelectPostStore(Node, 4, ST1Fourv8h_POST);
                return;
            } else if VT == v2i32 || VT == v2f32 {
                self.SelectPostStore(Node, 4, ST1Fourv2s_POST);
                return;
            } else if VT == v4i32 || VT == v4f32 {
                self.SelectPostStore(Node, 4, ST1Fourv4s_POST);
                return;
            } else if VT == v1i64 || VT == v1f64 {
                self.SelectPostStore(Node, 4, ST1Fourv1d_POST);
                return;
            } else if VT == v2i64 || VT == v2f64 {
                self.SelectPostStore(Node, 4, ST1Fourv2d_POST);
                return;
            }
            break;
        },
        ST2LANEpost => {
            VT = Node.getOperand(1).getValueType();
            if VT == v16i8 || VT == v8i8 {
                self.SelectPostStoreLane(Node, 2, ST2i8_POST);
                return;
            } else if VT == v8i16 || VT == v4i16 || VT == v4f16 || VT == v8f16 || VT == v4bf16 || VT == v8bf16 {
                self.SelectPostStoreLane(Node, 2, ST2i16_POST);
                return;
            } else if VT == v4i32 || VT == v2i32 || VT == v4f32 || VT == v2f32 {
                self.SelectPostStoreLane(Node, 2, ST2i32_POST);
                return;
            } else if VT == v2i64 || VT == v1i64 || VT == v2f64 || VT == v1f64 {
                self.SelectPostStoreLane(Node, 2, ST2i64_POST);
                return;
            }
            break;
        },
        ST3LANEpost => {
            VT = Node.getOperand(1).getValueType();
            if VT == v16i8 || VT == v8i8 {
                self.SelectPostStoreLane(Node, 3, ST3i8_POST);
                return;
            } else if VT == v8i16 || VT == v4i16 || VT == v4f16 || VT == v8f16 || VT == v4bf16 || VT == v8bf16 {
                self.SelectPostStoreLane(Node, 3, ST3i16_POST);
                return;
            } else if VT == v4i32 || VT == v2i32 || VT == v4f32 || VT == v2f32 {
                self.SelectPostStoreLane(Node, 3, ST3i32_POST);
                return;
            } else if VT == v2i64 || VT == v1i64 || VT == v2f64 || VT == v1f64 {
                self.SelectPostStoreLane(Node, 3, ST3i64_POST);
                return;
            }
            break;
        },
        ST4LANEpost => {
            VT = Node.getOperand(1).getValueType();
            if VT == v16i8 || VT == v8i8 {
                self.SelectPostStoreLane(Node, 4, ST4i8_POST);
                return;
            } else if VT == v8i16 || VT == v4i16 || VT == v4f16 || VT == v8f16 || VT == v4bf16 || VT == v8bf16 {
                self.SelectPostStoreLane(Node, 4, ST4i16_POST);
                return;
            } else if VT == v4i32 || VT == v2i32 || VT == v4f32 || VT == v2f32 {
                self.SelectPostStoreLane(Node, 4, ST4i32_POST);
                return;
            } else if VT == v2i64 || VT == v1i64 || VT == v2f64 || VT == v1f64 {
                self.SelectPostStoreLane(Node, 4, ST4i64_POST);
                return;
            }
            break;
        },
    }
    self.SelectCode(Node);
}

fn createAArch64ISelDag(TM: *mut AArch64TargetMachine, OptLevel: CodeGenOptLevel) -> *mut FunctionPass {
    return AArch64DAGToDAGISelLegacy { TM, OptLevel };
}

fn getPackedVectorTypeFromPredicateType(Ctx: *mut LLVMContext, PredVT: EVT, NumVec: u32) -> EVT {
    assert!(NumVec > 0 && NumVec < 5, "Invalid number of vectors.");
    if !PredVT.isScalableVectorOf(i1) {
        return EVT {};
    }
    if PredVT != nxv16i1 && PredVT != nxv8i1 && PredVT != nxv4i1 && PredVT != nxv2i1 {
        return EVT {};
    }
    let mut EC: ElementCount = PredVT.getVectorElementCount();
    let mut ScalarVT: EVT = getIntegerVT(Ctx, SVEBitsPerBlock / EC.getKnownMinValue());
    let mut MemVT: EVT = getVectorVT(Ctx, ScalarVT, EC * NumVec);
    return MemVT;
}

fn getMultipleVectorType(Ctx: *mut LLVMContext, VecVT: EVT, NumVec: u32) -> EVT {
    return getVectorVT(Ctx, VecVT.getScalarType().changeTypeToInteger(), VecVT.getVectorElementCount() * NumVec);
}

fn getMemVTFromNode(Ctx: *mut LLVMContext, Root: *mut SDNode) -> EVT {
    if dyn_cast(Root) {
        MemIntr;
    } else {
        return MemIntr.getMemoryVT();
    }
    if isa(Root) {
        let mut MemVT: EVT = cast(Root).getMemoryVT();
        let mut DataVT: EVT = EVT {};
        if dyn_cast(Root) {
            Load;
        } else {
            DataVT = Load.getValueType(0);
        }
        return DataVT.changeVectorElementType(Ctx, MemVT.getVectorElementType());
    }
    let mut Opcode: u32 = Root.getOpcode();
    match Opcode {
        LD1_MERGE_ZERO => {
            LD1S_MERGE_ZERO;
        },
        ST1_PRED => {
            return cast(Root.getOperand(4)).getVT();
        },
        _ => {
            break;
        },
    }
    if Opcode != INTRINSIC_VOID && Opcode != INTRINSIC_W_CHAIN {
        return EVT {};
    }
    match Root.getConstantOperandVal(1) {
        _ => {
            return EVT {};
        },
        aarch64_sme_ldr => {
            aarch64_sme_str;
        },
        aarch64_sve_prf => {
            return getPackedVectorTypeFromPredicateType(Ctx, operator(Root.getOperand(2)).getValueType(0), 1);
        },
        aarch64_sve_ld2_sret => {
            aarch64_sve_ld2q_sret;
        },
        aarch64_sve_st2q => {
            return getPackedVectorTypeFromPredicateType(Ctx, operator(Root.getOperand(4)).getValueType(0), 2);
        },
        aarch64_sve_ld3_sret => {
            aarch64_sve_ld3q_sret;
        },
        aarch64_sve_st3q => {
            return getPackedVectorTypeFromPredicateType(Ctx, operator(Root.getOperand(5)).getValueType(0), 3);
        },
        aarch64_sve_ld4_sret => {
            aarch64_sve_ld4q_sret;
        },
        aarch64_sve_st4q => {
            return getPackedVectorTypeFromPredicateType(Ctx, operator(Root.getOperand(6)).getValueType(0), 4);
        },
        aarch64_sve_ld1_pn_x2 => {
            aarch64_sve_ldnt1_pn_x2;
        },
        aarch64_sve_ld1_pn_x4 => {
            aarch64_sve_ldnt1_pn_x4;
        },
        aarch64_sve_st1_pn_x2 => {
            aarch64_sve_stnt1_pn_x2;
        },
        aarch64_sve_st1_pn_x4 => {
            aarch64_sve_stnt1_pn_x4;
        },
        aarch64_sve_ld1udq => {
            aarch64_sve_st1dq;
        },
        aarch64_sve_ld1uwq => {
            aarch64_sve_st1wq;
        },
    }
}

fn AArch64DAGToDAGISel::SelectSVERegRegAddrMode(self, N: SDValue, Scale: u32, Base: *mut SDValue, Offset: *mut SDValue) -> bool {
    if N.getOpcode() != ADD {
        return false;
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    if Scale == 0 {
        Base = LHS;
        Offset = RHS;
        return true;
    }
    if dyn_cast(RHS) {
        C;
    } else {
        let mut ImmOff: i64 = C.getSExtValue();
        let mut Size: u32 = 1 << Scale;
        if ImmOff % Size {
            return false;
        }
        let mut DL: SDLoc = N;
        Base = LHS;
        Offset = self.CurDAG.getTargetConstant(ImmOff >> Scale, DL, i64, false);
        let mut Ops: [1]SDValue = [Offset];
        let mut MI: *mut SDNode = self.CurDAG.getMachineNode(MOVi64imm, DL, i64, Ops);
        Offset = SDValue { Node: MI, ResNo: 0 };
        return true;
    }
    if RHS.getOpcode() != SHL {
        return false;
    }
    let mut ShiftRHS: SDValue = RHS.getOperand(1);
    if dyn_cast(ShiftRHS) {
        C;
    } else if C.getZExtValue() == Scale {
        Base = LHS;
        Offset = RHS.getOperand(0);
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectAllActivePredicate(self, N: SDValue) -> bool {
    let mut TLI: *AArch64TargetLowering = self.getTargetLowering() as *AArch64TargetLowering;
    return TLI.isAllActivePredicate(*self.CurDAG, N);
}

fn AArch64DAGToDAGISel::SelectAnyPredicate(self, N: SDValue) -> bool {
    return N.getValueType().isScalableVectorOf(i1);
}

fn AArch64DAGToDAGISel::SelectSMETileSlice(self, N: SDValue, MaxSize: u32, Base: *mut SDValue, Offset: *mut SDValue, Scale: u32) -> bool {
    let mut MatchConstantOffset: Closure_6 = Closure_6 { MaxSize: &mut MaxSize, Scale: &mut Scale, cap_2: self, N: &mut N };
    if MatchConstantOffset.call(N) {
        C;
    } else {
        Base = getZeroRegister(*self.CurDAG, N, i32);
        Offset = C;
        return true;
    }
    if self.CurDAG.isBaseWithConstantOffset(N) {
        if MatchConstantOffset.call(N.getOperand(1)) {
            C;
        } else {
            Base = N.getOperand(0);
            Offset = C;
            return true;
        }
    }
    Base = N;
    Offset = self.CurDAG.getTargetConstant(0, N, i64, false);
    return true;
}

fn AArch64DAGToDAGISel::SelectCmpBranchUImm6Operand(self, P: *mut SDNode, N: SDValue, Imm: *mut SDValue) -> bool {
    let mut CC: CondCode = P.getConstantOperandVal(1) as CondCode;
    if dyn_cast(N) {
        CN;
    } else {
        let mut LowerBound: u64 = 0;
        let mut UpperBound: u64 = 64;
        match CC {
            GE => {
                HS;
            },
            LE => {
                LS;
            },
            _ => {
                break;
            },
        }
        if CN.getAPIntValue().uge(LowerBound) && CN.getAPIntValue().ult(UpperBound) {
            let mut DL: SDLoc = N;
            Imm = self.CurDAG.getTargetConstant(CN.getZExtValue(), DL, N.getValueType(), false);
            return true;
        }
    }
    return false;
}

fn AArch64DAGToDAGISel::tryFoldCselToFMaxMin(self, N: *mut SDNode) -> bool {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isFloatingPoint() || VT.isVector() {
        return false;
    }
    let mut TVal: SDValue = N.getOperand(0);
    let mut FVal: SDValue = N.getOperand(1);
    let mut CCVal: SDValue = N.getOperand(2);
    let mut Cmp: SDValue = N.getOperand(3);
    if Cmp.getOpcode() != FCMP {
        return false;
    }
    let mut CC: *mut ConstantSDNode = dyn_cast(CCVal);
    if !CC {
        return false;
    }
    let mut CmpLHS: SDValue = Cmp.getOperand(0);
    let mut CmpRHS: SDValue = Cmp.getOperand(1);
    let mut CondCode: u32 = CC.getZExtValue();
    let mut getOpc: Closure_7 = Closure_7 {};
    let mut isMax: bool = false;
    if CondCode == GT || CondCode == GE {
        if TVal == CmpLHS && FVal == CmpRHS {
            isMax = true;
        } else {
            return false;
        }
    } else if CondCode == MI || CondCode == LS {
        if TVal == CmpLHS && FVal == CmpRHS {
            isMax = false;
        } else {
            return false;
        }
    } else {
        return false;
    }
    let mut Opc: u32 = getOpc.call(VT, isMax);
    if !Opc {
        return false;
    }
    let mut CFP: *mut ConstantFPSDNode = dyn_cast(CmpRHS);
    if !CFP || CFP.getValueAPF().isNaN() {
        return false;
    }
    if CFP.isZero() && !N.getFlags().hasNoSignedZeros() {
        return false;
    }
    if !self.CurDAG.isKnownNeverSNaN(CmpLHS, 0) {
        return false;
    }
    self.CurDAG.SelectNodeTo(N, Opc, VT, CmpLHS, CmpRHS);
    return true;
}

fn AArch64DAGToDAGISel::PreprocessISelDAG(self) {
    let mut MadeChange: bool = false;
    for N in make_early_inc_range(self.CurDAG.allnodes()) {
        if N.use_empty() {
            continue;
        }
        let mut Result: SDValue = SDValue {};
        match N.getOpcode() {
            SCALAR_TO_VECTOR => {
                let mut ScalarTy: EVT = N.getValueType(0).getVectorElementType();
                if (ScalarTy == i32 || ScalarTy == i64) && ScalarTy == N.getOperand(0).getValueType() {
                    Result = addBitcastHints(*self.CurDAG, N);
                }
                break;
            },
            VSHL => {
                let mut VT: EVT = N.getValueType(0);
                let mut A: SDValue = SDValue {};
                let mut B: SDValue = SDValue {};
                let mut C: SDValue = N.getOperand(1);
                if sd_match(N.getOperand(0), m_OneUse(m_Mul(m_Value(A, m_AnyOf(m_ZExt(m_Value()), m_SExt(m_Value()))), m_Value(B)))) {
                    if B.getOpcode() == A.getOpcode() {
                        break;
                    }
                    let mut DL: SDLoc = &mut N;
                    let mut SHL: SDValue = self.CurDAG.getNode(VSHL, DL, VT, A, C);
                    Result = self.CurDAG.getNode(MUL, DL, VT, SHL, B);
                }
                break;
            },
            _ => {
                break;
            },
        }
        if Result {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                    dbgs() << "AArch64 DAG preprocessing replacing:\nOld:    ";
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                    N.dump(self.CurDAG);
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                    dbgs() << "\nNew: ";
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                    Result.dump(self.CurDAG);
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
            self.CurDAG.ReplaceAllUsesOfValueWith(SDValue { Node: &mut N, ResNo: 0 }, Result);
            MadeChange = true;
        }
    }
    if MadeChange {
        self.CurDAG.RemoveDeadNodes();
    }
    self.PreprocessISelDAG();
}

struct Closure_1 {
    DAG: *mut SelectionDAG,
}

unsafe fn Closure_1::call(self: *mut Closure_1, VT: EVT) -> EVT {
        let mut ScalarVT: EVT = VT.getScalarType();
        assert!((ScalarVT == i32 || ScalarVT == i64), "Unexpected VT");
        return VT.changeElementType(*((*self.DAG).getContext()), if ScalarVT == i32 { f32 } else { f64 });
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, N: SDValue) -> bool {
            let mut Opc: u32 = N.getOpcode();
            return Opc != TRUNCATE && Opc != EXTRACT_SUBREG && Opc != CopyFromReg && Opc != AssertSext && Opc != AssertZext && Opc != AssertAlign && Opc != FREEZE;
        }

struct Closure_3 {
    OpsIter: *mut *mut SDUse,
    NumVecs: *mut u32,
    cap_2: *mut AArch64DAGToDAGISel,
}

unsafe fn Closure_3::call(self: *mut Closure_3) -> SDValue {
        let mut Regs: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { (*self.OpsIter), (*self.OpsIter) + (*self.NumVecs) };
        (*self.OpsIter) += (*self.NumVecs);
        return self.createZMulTuple(Regs);
    }

struct Closure_4 {
    RegWidth: u32,
}

fn Closure_4::call(self: *Closure_4, Imm: APInt) -> APFloat {
        match self.RegWidth {
            16 => {
                return APFloat { IEEEhalf(), Imm };
            },
            32 => {
                return APFloat { IEEEsingle(), Imm };
            },
            64 => {
                return APFloat { IEEEdouble(), Imm };
            },
            _ => {
                llvm_unreachable_internal("Unexpected RegWidth!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ISelDAGToDAG.cpp", 4355);
            },
        }
    }

struct Closure_5 {
    N: *mut *mut SDNode,
    cap_1: *mut AArch64DAGToDAGISel,
    DL: *mut SDLoc,
}

unsafe fn Closure_5::call(self: *mut Closure_5) {
            if PMapper {
                assert!(isa((*self.N).getOperand(2)), "Expected a constant integer expression.");
                let mut Reg: u32 = PMapper.Encoding;
                let mut Immed: u64 = (*self.N).getConstantOperandVal(2);
                self.CurDAG.SelectNodeTo((*self.N), State, Other, self.CurDAG.getTargetConstant(Reg, (*self.DL), i32, false), self.CurDAG.getTargetConstant(Immed, (*self.DL), i16, false), (*self.N).getOperand(0));
                return true;
            }
            return false;
        }

struct Closure_6 {
    MaxSize: *mut u32,
    Scale: *mut u32,
    cap_2: *mut AArch64DAGToDAGISel,
    N: *mut SDValue,
}

unsafe fn Closure_6::call(self: *mut Closure_6, CN: SDValue) -> auto {
        if dyn_cast(CN) {
            C;
        } else {
            let mut ImmOff: i64 = C.getSExtValue();
            if (ImmOff > 0 && ImmOff <= (*self.MaxSize) && (ImmOff % (*self.Scale) == 0)) {
                return self.CurDAG.getTargetConstant(ImmOff / (*self.Scale), (*self.N), i64, false);
            }
        }
        return SDValue {};
    }

struct Closure_7 {}

fn Closure_7::call(self: *mut Closure_7, VT: EVT, isMax: bool) -> auto {
        if VT == f16 {
            return if isMax { FMAXNMHrr } else { FMINNMHrr };
        } else if VT == f32 {
            return if isMax { FMAXNMSrr } else { FMINNMSrr };
        } else if VT == f64 {
            return if isMax { FMAXNMDrr } else { FMINNMDrr };
        } else {
            return 0;
        }
    }
