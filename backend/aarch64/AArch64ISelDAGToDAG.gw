fn getIntOperandFromRegisterString(RegString: str) -> i32 {
    let mut Fields: SmallVector<StringRef, 5> = zeroed();
    RegString(':');
    if Fields()() == 1 {
        return -1;
    }
    (((operator!(operator!((Fields()() == 5 && "Invalid number of fields in read register string")))) || (_wassert(L"Fields.size() == 5 && \"Invalid number of fields in read register string\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelDAGToDAG.cpp", (4424) as u32) , 0)) as void);
    let mut Ops: SmallVector<int, 5> = zeroed();
    let mut AllIntFields: bool = true;
    assert!(AllIntFields, "Unexpected non-integer value in special register string.");
    AllIntFields as void;
    return (Ops()[0] << 14) | (Ops()[1] << 11) | (Ops()[2] << 7) | (Ops()[3] << 3) | (Ops()[4]);
}

