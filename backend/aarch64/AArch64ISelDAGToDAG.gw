fn isValidAsScaledImmediate(Offset: i64, Range: u32, Size: u32) -> bool {
    if (Offset & (Size - 1)) == 0 && Offset >= 0 && Offset < (Range << Log2_32(Size)) {
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectAddrModeIndexedBitWidth(self, N: SDValue, IsSignedImm: bool, BW: u32, Size: u32, Base: *mut SDValue, OffImm: *mut SDValue) -> bool {
    let mut dl: SDLoc = N;
    let mut DL: *DataLayout = null;
    let mut TLI: *TargetLowering = self.getTargetLowering;
    if N.getOpcode() == FrameIndex {
        let mut FI: i32 = cast(N)();
        return true;
    }
    if  {
        if dyn_cast(N.getOperand(1)) {
            RHS;
        } else {
            if IsSignedImm {
                let mut RHSC: i64 = RHS.getSExtValue();
                let mut Scale: u32 = Log2_32(Size);
                let mut Range: i64 = 1 << (BW - 1);
                if (RHSC & (Size - 1)) == 0 && RHSC >= -(Range << Scale) && RHSC < (Range << Scale) {
                    Base = N.getOperand(0);
                    if Base.getOpcode() == FrameIndex {
                        let mut FI: i32 = cast(Base)();
                    }
                    return true;
                }
            } else {
                let mut RHSC: u64 = RHS.getZExtValue();
                let mut Scale: u32 = Log2_32(Size);
                let mut Range: u64 = 1 << BW;
                if (RHSC & (Size - 1)) == 0 && RHSC < (Range << Scale) {
                    Base = N.getOperand(0);
                    if Base.getOpcode() == FrameIndex {
                        let mut FI: i32 = cast(Base)();
                    }
                    return true;
                }
            }
        }
    }
    Base = N;
    return true;
}

fn AArch64DAGToDAGISel::SelectAddrModeIndexed(self, N: SDValue, Size: u32, Base: *mut SDValue, OffImm: *mut SDValue) -> bool {
    let mut dl: SDLoc = N;
    let mut DL: *DataLayout = null;
    let mut TLI: *TargetLowering = self.getTargetLowering;
    if N.getOpcode() == FrameIndex {
        let mut FI: i32 = cast(N)();
        return true;
    }
    if  {
        let mut GAN: *mut GlobalAddressSDNode = dyn_cast(N.getOperand(1).getNode());
        Base = N.getOperand(0);
        OffImm = N.getOperand(1);
        if !GAN {
            return true;
        }
        if GAN.getOffset() % Size == 0 && GAN.getGlobal().getPointerAlignment(DL) >= Size {
            return true;
        }
    }
    if  {
        if dyn_cast(N.getOperand(1)) {
            RHS;
        } else {
            let mut RHSC: i64 = RHS.getZExtValue() as i64;
            let mut Scale: u32 = Log2_32(Size);
            if isValidAsScaledImmediate(RHSC, 4096, Size) {
                Base = N.getOperand(0);
                if Base.getOpcode() == FrameIndex {
                    let mut FI: i32 = cast(Base)();
                }
                return true;
            }
        }
    }
    if self.SelectAddrModeUnscaled(N, Size, Base, OffImm) {
        return false;
    }
    Base = N;
    return true;
}

fn AArch64DAGToDAGISel::SelectAddrModeUnscaled(self, N: SDValue, Size: u32, Base: *mut SDValue, OffImm: *mut SDValue) -> bool {
    if  {
        return false;
    }
    if dyn_cast(N.getOperand(1)) {
        RHS;
    } else {
        let mut RHSC: i64 = RHS.getSExtValue();
        if RHSC >= -256 && RHSC < 256 {
            Base = N.getOperand(0);
            if Base.getOpcode() == FrameIndex {
                let mut FI: i32 = cast(Base)();
                let mut TLI: *TargetLowering = self.getTargetLowering;
            }
            return true;
        }
    }
    return false;
}

