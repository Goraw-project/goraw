fn AArch64DAGToDAGISel::SelectExtendedSHL(self, N: SDValue, Size: u32, WantExtend: bool, Offset: *mut SDValue, SignExtend: *mut SDValue) -> bool {
    assert!(N.getOpcode() == SHL, "Invalid opcode.");
    let mut CSD: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !CSD || (CSD.getZExtValue() & 7) != CSD.getZExtValue() {
        return false;
    }
    let mut dl: SDLoc = N;
    if WantExtend {
        let mut Ext: ShiftExtendType = getExtendTypeForNode(N.getOperand(0), true);
        if Ext == InvalidShiftExtend {
            return false;
        }
        Offset = narrowIfNeeded(N.getOperand(0).getOperand(0));
    } else {
        Offset = N.getOperand(0);
    }
    let mut LegalShiftVal: u32 = Log2_32(Size);
    let mut ShiftVal: u32 = CSD.getZExtValue();
    if ShiftVal != 0 && ShiftVal != LegalShiftVal {
        return false;
    }
    return self.isWorthFoldingAddr(N, Size);
}

fn AArch64DAGToDAGISel::SelectAddrModeWRO(self, N: SDValue, Size: u32, Base: *mut SDValue, Offset: *mut SDValue, SignExtend: *mut SDValue, DoShift: *mut SDValue) -> bool {
    if N.getOpcode() != ADD {
        return false;
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut dl: SDLoc = N;
    if isa(LHS) || isa(RHS) {
        return false;
    }
    let mut Node: *SDNode = N.getNode();
    let mut IsExtendedRegisterWorthFolding: bool = self.isWorthFoldingAddr(N, Size);
    if IsExtendedRegisterWorthFolding && RHS.getOpcode() == SHL && self.SelectExtendedSHL(RHS, Size, true, Offset, SignExtend) {
        Base = LHS;
        return true;
    }
    if IsExtendedRegisterWorthFolding && LHS.getOpcode() == SHL && self.SelectExtendedSHL(LHS, Size, true, Offset, SignExtend) {
        Base = RHS;
        return true;
    }
    let mut Ext: ShiftExtendType = InvalidShiftExtend;
    if IsExtendedRegisterWorthFolding && (Ext = getExtendTypeForNode(LHS, true)) != InvalidShiftExtend {
        Base = RHS;
        Offset = narrowIfNeeded(LHS.getOperand(0));
        if self.isWorthFoldingAddr(LHS, Size) {
            return true;
        }
    }
    if IsExtendedRegisterWorthFolding && (Ext = getExtendTypeForNode(RHS, true)) != InvalidShiftExtend {
        Base = LHS;
        Offset = narrowIfNeeded(RHS.getOperand(0));
        if self.isWorthFoldingAddr(RHS, Size) {
            return true;
        }
    }
    return false;
}

fn isPreferredADD(ImmOff: i64) -> bool {
    if (ImmOff & -4096) == 0 {
        return true;
    }
    if (ImmOff & -16773121) == 0 {
        return (ImmOff & -16711681) != 0 && (ImmOff & -61441) != 0;
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectAddrModeXRO(self, N: SDValue, Size: u32, Base: *mut SDValue, Offset: *mut SDValue, SignExtend: *mut SDValue, DoShift: *mut SDValue) -> bool {
    if N.getOpcode() != ADD {
        return false;
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut DL: SDLoc = N;
    let mut Node: *SDNode = N.getNode();
    if isa(RHS) {
        let mut ImmOff: i64 = operator(RHS).getAsZExtVal() as i64;
        if isValidAsScaledImmediate(ImmOff, 4096, Size) || isPreferredADD(ImmOff) || isPreferredADD(-ImmOff) {
            return false;
        }
        let mut Ops: [1]SDValue = [RHS];
        let mut MOVI: *mut SDNode = null;
        let mut MOVIV: SDValue = SDValue { Node: MOVI, ResNo: 0 };
    }
    let mut IsExtendedRegisterWorthFolding: bool = self.isWorthFoldingAddr(N, Size);
    if IsExtendedRegisterWorthFolding && RHS.getOpcode() == SHL && self.SelectExtendedSHL(RHS, Size, false, Offset, SignExtend) {
        Base = LHS;
        return true;
    }
    if IsExtendedRegisterWorthFolding && LHS.getOpcode() == SHL && self.SelectExtendedSHL(LHS, Size, false, Offset, SignExtend) {
        Base = RHS;
        return true;
    }
    Base = LHS;
    Offset = RHS;
    return true;
}

