        let mut Add0: SDValue = operator(ShiftAmt).getOperand(0);
        let mut Add1: SDValue = operator(ShiftAmt).getOperand(1);
        let mut Add0Imm: u64 = 0;
        let mut Add1Imm: u64 = 0;
        if isIntImmediate(Add1, Add1Imm) && (Add1Imm % Size == 0) {
            NewShiftAmt = Add0;
        } else if operator(ShiftAmt).getOpcode() == SUB && isIntImmediate(Add0, Add0Imm) && Add0Imm != 0 && (Add0Imm % Size == 0) {
