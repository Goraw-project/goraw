fn AArch64DAGToDAGISel::SelectArithImmed(self, N: SDValue, Val: *mut SDValue, Shift: *mut SDValue) -> bool {
    if !isa(N.getNode()) {
        return false;
    }
    let mut Immed: u64 = N.getNode().getAsZExtVal();
    if !isLegalArithImmed(Immed) {
        return false;
    }
    let mut ShiftAmt: u32 = getArithImmedShift(Immed);
    Immed >>= ShiftAmt;
    let mut ShVal: u32 = getShifterImm(LSL, ShiftAmt);
    let mut dl: SDLoc = N;
    Val = self.CurDAG.getTargetConstant(Immed, dl, i32, false);
    Shift = self.CurDAG.getTargetConstant(ShVal, dl, i32, false);
    return true;
}

fn AArch64DAGToDAGISel::SelectNegArithImmed(self, N: SDValue, Val: *mut SDValue, Shift: *mut SDValue) -> bool {
    if !isa(N.getNode()) {
        return false;
    }
    let mut Immed: u64 = N.getNode().getAsZExtVal();
    if Immed == 0 {
        return false;
    }
    if N.getValueType() == i32 {
        Immed = ~(Immed as u32) + 1;
    } else {
        Immed = ~Immed + 1;
    }
    if Immed & 18446744073692774400 {
        return false;
    }
    Immed &= 16777215;
    return self.SelectArithImmed(self.CurDAG.getConstant(Immed, N, i32, false, false), Val, Shift);
}

fn getShiftTypeForNode(N: SDValue) -> ShiftExtendType {
    match N.getOpcode() {
        _ => {
            return InvalidShiftExtend;
        },
        SHL => {
            return LSL;
        },
        SRL => {
            return LSR;
        },
        SRA => {
            return ASR;
        },
        ROTR => {
            return ROR;
        },
    }
}

fn isMemOpOrPrefetch(N: *mut SDNode) -> bool {
    return isa(*N) || N.getOpcode() == PREFETCH;
}

fn isWorthFoldingSHL(V: SDValue) -> bool {
    assert!(V.getOpcode() == SHL, "invalid opcode");
    let mut CSD: *mut ConstantSDNode = dyn_cast(V.getOperand(1));
    if !CSD {
        return false;
    }
    let mut ShiftVal: u32 = CSD.getZExtValue();
    if ShiftVal > 3 {
        return false;
    }
    let mut Node: *SDNode = V.getNode();
    for UI in Node.users() {
        if !isMemOpOrPrefetch(UI) {
            for UII in UI.users() {
                if !isMemOpOrPrefetch(UII) {
                    return false;
                }
            }
        }
    }
    return true;
}

fn AArch64DAGToDAGISel::isWorthFoldingAddr(self: *AArch64DAGToDAGISel, V: SDValue, Size: u32) -> bool {
    if self.CurDAG.shouldOptForSize() || V.hasOneUse() {
        return true;
    }
    if self.Subtarget.hasAddrLSLSlow14() && (Size == 2 || Size == 16) {
        return false;
    }
    if V.getOpcode() == SHL && isWorthFoldingSHL(V) {
        return true;
    }
    if V.getOpcode() == ADD {
        let mut LHS: SDValue = V.getOperand(0);
        let mut RHS: SDValue = V.getOperand(1);
        if LHS.getOpcode() == SHL && isWorthFoldingSHL(LHS) {
            return true;
        }
        if RHS.getOpcode() == SHL && isWorthFoldingSHL(RHS) {
            return true;
        }
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectShiftedRegisterFromAnd(self, N: SDValue, Reg: *mut SDValue, Shift: *mut SDValue) -> bool {
    let mut VT: EVT = N.getValueType();
    if VT != i32 && VT != i64 {
        return false;
    }
    if operator(N).getOpcode() != AND || !operator(N).hasOneUse() {
        return false;
    }
    let mut LHS: SDValue = N.getOperand(0);
    if !operator(LHS).hasOneUse() {
        return false;
    }
    let mut LHSOpcode: u32 = operator(LHS).getOpcode();
    if LHSOpcode != SHL && LHSOpcode != SRL && LHSOpcode != SRA {
        return false;
    }
    let mut ShiftAmtNode: *mut ConstantSDNode = dyn_cast(LHS.getOperand(1));
    if !ShiftAmtNode {
        return false;
    }
    let mut ShiftAmtC: u64 = ShiftAmtNode.getZExtValue();
    let mut RHSC: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !RHSC {
        return false;
    }
    let mut AndMask: APInt = RHSC.getAPIntValue();
    let mut LowZBits: u32 = 0;
    let mut MaskLen: u32 = 0;
    if !AndMask.isShiftedMask(LowZBits, MaskLen) {
        return false;
    }
    let mut BitWidth: u32 = N.getValueSizeInBits().operator unsigned long long();
    let mut DL: SDLoc = LHS;
    let mut NewShiftC: u64 = 0;
    let mut NewShiftOp: u32 = 0;
    if LHSOpcode == SHL {
        if LowZBits <= ShiftAmtC || (BitWidth != LowZBits + MaskLen) {
            return false;
        }
        NewShiftC = LowZBits - ShiftAmtC;
        NewShiftOp = if VT == i64 { UBFMXri } else { UBFMWri };
    } else {
        if LowZBits == 0 {
            return false;
        }
        NewShiftC = LowZBits + ShiftAmtC;
        if NewShiftC >= BitWidth {
            return false;
        }
        if LHSOpcode == SRA && (BitWidth != (LowZBits + MaskLen)) {
            return false;
        }
        if LHSOpcode == SRL && (BitWidth > (NewShiftC + MaskLen)) {
            return false;
        }
        if LHSOpcode == SRL {
            NewShiftOp = if VT == i64 { UBFMXri } else { UBFMWri };
        } else {
            NewShiftOp = if VT == i64 { SBFMXri } else { SBFMWri };
        }
    }
    assert!(NewShiftC < BitWidth, "Invalid shift amount");
    let mut NewShiftAmt: SDValue = self.CurDAG.getTargetConstant(NewShiftC, DL, VT, false);
    let mut BitWidthMinus1: SDValue = self.CurDAG.getTargetConstant(BitWidth - 1, DL, VT, false);
    Reg = SDValue { Node: self.CurDAG.getMachineNode(NewShiftOp, DL, VT, operator(LHS).getOperand(0), NewShiftAmt, BitWidthMinus1), ResNo: 0 };
    let mut ShVal: u32 = getShifterImm(LSL, LowZBits);
    Shift = self.CurDAG.getTargetConstant(ShVal, DL, i32, false);
    return true;
}

fn getExtendTypeForNode(N: SDValue, IsLoadStore: bool) -> ShiftExtendType {
    if N.getOpcode() == SIGN_EXTEND || N.getOpcode() == SIGN_EXTEND_INREG {
        let mut SrcVT: EVT = EVT {};
        if N.getOpcode() == SIGN_EXTEND_INREG {
            SrcVT = cast(N.getOperand(1)).getVT();
        } else {
            SrcVT = N.getOperand(0).getValueType();
        }
        if !IsLoadStore && SrcVT == i8 {
            return SXTB;
        } else if !IsLoadStore && SrcVT == i16 {
            return SXTH;
        } else if SrcVT == i32 {
            return SXTW;
        }
        assert!(SrcVT != i64, "extend from 64-bits?");
        return InvalidShiftExtend;
    } else if N.getOpcode() == ZERO_EXTEND || N.getOpcode() == ANY_EXTEND {
        let mut SrcVT: EVT = N.getOperand(0).getValueType();
        if !IsLoadStore && SrcVT == i8 {
            return UXTB;
        } else if !IsLoadStore && SrcVT == i16 {
            return UXTH;
        } else if SrcVT == i32 {
            return UXTW;
        }
        assert!(SrcVT != i64, "extend from 64-bits?");
        return InvalidShiftExtend;
    } else if N.getOpcode() == AND {
        let mut CSD: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if !CSD {
            return InvalidShiftExtend;
        }
        let mut AndMask: u64 = CSD.getZExtValue();
        match AndMask {
            _ => {
                return InvalidShiftExtend;
            },
            255 => {
                return if !IsLoadStore { UXTB } else { InvalidShiftExtend };
            },
            65535 => {
                return if !IsLoadStore { UXTH } else { InvalidShiftExtend };
            },
            4294967295 => {
                return UXTW;
            },
        }
    }
    return InvalidShiftExtend;
}

fn AArch64DAGToDAGISel::isWorthNegatingImm(self: *AArch64DAGToDAGISel, V: SDValue) -> bool {
    assert!(isa(V), "invalid node");
    let mut VT: EVT = V.getValueType();
    assert!((VT == i32 || VT == i64), "invalid type");
    if !V.hasOneUse() {
        return false;
    }
    let mut Imm: u64 = cast(V).getZExtValue();
    let mut BitSize: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut OrigCost: ImmInsnModel, 4> = ImmInsnModel, 4> {};
    let mut NewCost: ImmInsnModel, 4> = ImmInsnModel, 4> {};
    expandMOVImm(Imm, BitSize, OrigCost);
    expandMOVImm(-Imm, BitSize, NewCost);
    return NewCost.len < OrigCost.len;
}

fn AArch64DAGToDAGISel::isWorthFoldingALU(self: *AArch64DAGToDAGISel, V: SDValue, LSL: bool) -> bool {
    if self.CurDAG.shouldOptForSize() || V.hasOneUse() {
        return true;
    }
    if LSL && self.Subtarget.hasALULSLFast() && V.getOpcode() == SHL && V.getConstantOperandVal(1) <= 4 && getExtendTypeForNode(V.getOperand(0), false) == InvalidShiftExtend {
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectShiftedRegister(self, N: SDValue, AllowROR: bool, Reg: *mut SDValue, Shift: *mut SDValue) -> bool {
    if self.SelectShiftedRegisterFromAnd(N, Reg, Shift) {
        return true;
    }
    let mut ShType: ShiftExtendType = getShiftTypeForNode(N);
    if ShType == InvalidShiftExtend {
        return false;
    }
    if !AllowROR && ShType == ROR {
        return false;
    }
    if dyn_cast(N.getOperand(1)) {
        RHS;
    } else {
        let mut BitSize: u32 = N.getValueSizeInBits().operator unsigned long long();
        let mut Val: u32 = RHS.getZExtValue() & (BitSize - 1);
        let mut ShVal: u32 = getShifterImm(ShType, Val);
        Reg = N.getOperand(0);
        Shift = self.CurDAG.getTargetConstant(ShVal, N, i32, false);
        return self.isWorthFoldingALU(N, true);
    }
    return false;
}

fn narrowIfNeeded(CurDAG: *mut SelectionDAG, N: SDValue) -> SDValue {
    if N.getValueType() == i32 {
        return N;
    }
    let mut dl: SDLoc = N;
    return CurDAG.getTargetExtractSubreg(sub_32, dl, i32, N);
}

fn AArch64DAGToDAGISel::SelectArithExtendedRegister(self, N: SDValue, Reg: *mut SDValue, Shift: *mut SDValue) -> bool {
    let mut ShiftVal: u32 = 0;
    let mut Ext: ShiftExtendType = zeroed();
    if N.getOpcode() == SHL {
        let mut CSD: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if !CSD {
            return false;
        }
        ShiftVal = CSD.getZExtValue();
        if ShiftVal > 4 {
            return false;
        }
        Ext = getExtendTypeForNode(N.getOperand(0), false);
        if Ext == InvalidShiftExtend {
            return false;
        }
        Reg = N.getOperand(0).getOperand(0);
    } else {
        Ext = getExtendTypeForNode(N, false);
        if Ext == InvalidShiftExtend {
            return false;
        }
        if isSignExtendShiftType(Ext) {
            let mut Op: SDValue = N.getOperand(0);
            if operator(Op).getOpcode() == ANY_EXTEND {
                Op = operator(Op).getOperand(0);
            }
            if Op.getOpcode() == EXTRACT_VECTOR_ELT && Op.getOperand(0).getValueType().isFixedLengthVector() {
                return false;
            }
        }
        Reg = N.getOperand(0);
        let mut isDef32: Closure_2 = Closure_2 {};
        if Ext == UXTW && operator(Reg).getValueType(0).getSizeInBits().operator unsigned long long() == 32 && isDef32.call(Reg) {
            return false;
        }
    }
    if Ext == SXTW && Reg.getOpcode() == SRA && Reg.getValueType() == i32 && isa(Reg.getOperand(1)) && Reg.hasOneUse() {
        return false;
    }
    assert!(Ext != UXTX && Ext != SXTX);
    Reg = narrowIfNeeded(self.CurDAG, Reg);
    Shift = self.CurDAG.getTargetConstant(getArithExtendImm(Ext, ShiftVal), N, i32, false);
    return self.isWorthFoldingALU(N, false);
}

fn AArch64DAGToDAGISel::SelectArithUXTXRegister(self, N: SDValue, Reg: *mut SDValue, Shift: *mut SDValue) -> bool {
    let mut ShiftVal: u32 = 0;
    let mut Ext: ShiftExtendType = zeroed();
    if N.getOpcode() != SHL {
        return false;
    }
    let mut CSD: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !CSD {
        return false;
    }
    ShiftVal = CSD.getZExtValue();
    if ShiftVal > 4 {
        return false;
    }
    Ext = UXTX;
    Reg = N.getOperand(0);
    Shift = self.CurDAG.getTargetConstant(getArithExtendImm(Ext, ShiftVal), N, i32, false);
    return self.isWorthFoldingALU(N, false);
}

fn isWorthFoldingADDlow(N: SDValue) -> bool {
    for User in operator(N).users() {
        if User.getOpcode() != LOAD && User.getOpcode() != STORE && User.getOpcode() != ATOMIC_LOAD && User.getOpcode() != ATOMIC_STORE {
            return false;
        }
        if isStrongerThanMonotonic(cast(User).getSuccessOrdering()) {
            return false;
        }
    }
    return true;
}

fn isValidAsScaledImmediate(Offset: i64, Range: u32, Size: u32) -> bool {
    if (Offset & (Size - 1)) == 0 && Offset >= 0 && Offset < (Range << Log2_32(Size)) {
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectAddrModeIndexedBitWidth(self, N: SDValue, IsSignedImm: bool, BW: u32, Size: u32, Base: *mut SDValue, OffImm: *mut SDValue) -> bool {
    let mut dl: SDLoc = N;
    let mut DL: *DataLayout = self.CurDAG.getDataLayout();
    let mut TLI: *TargetLowering = self.getTargetLowering();
    if N.getOpcode() == FrameIndex {
        let mut FI: i32 = cast(N).getIndex();
        Base = self.CurDAG.getTargetFrameIndex(FI, TLI.getPointerTy(DL, 0));
        OffImm = self.CurDAG.getTargetConstant(0, dl, i64, false);
        return true;
    }
    if self.CurDAG.isBaseWithConstantOffset(N) {
        if dyn_cast(N.getOperand(1)) {
            RHS;
        } else {
            if IsSignedImm {
                let mut RHSC: i64 = RHS.getSExtValue();
                let mut Scale: u32 = Log2_32(Size);
                let mut Range: i64 = 1 << (BW - 1);
                if (RHSC & (Size - 1)) == 0 && RHSC >= -(Range << Scale) && RHSC < (Range << Scale) {
                    Base = N.getOperand(0);
                    if Base.getOpcode() == FrameIndex {
                        let mut FI: i32 = cast(Base).getIndex();
                        Base = self.CurDAG.getTargetFrameIndex(FI, TLI.getPointerTy(DL, 0));
                    }
                    OffImm = self.CurDAG.getTargetConstant(RHSC >> Scale, dl, i64, false);
                    return true;
                }
            } else {
                let mut RHSC: u64 = RHS.getZExtValue();
                let mut Scale: u32 = Log2_32(Size);
                let mut Range: u64 = 1 << BW;
                if (RHSC & (Size - 1)) == 0 && RHSC < (Range << Scale) {
                    Base = N.getOperand(0);
                    if Base.getOpcode() == FrameIndex {
                        let mut FI: i32 = cast(Base).getIndex();
                        Base = self.CurDAG.getTargetFrameIndex(FI, TLI.getPointerTy(DL, 0));
                    }
                    OffImm = self.CurDAG.getTargetConstant(RHSC >> Scale, dl, i64, false);
                    return true;
                }
            }
        }
    }
    Base = N;
    OffImm = self.CurDAG.getTargetConstant(0, dl, i64, false);
    return true;
}

fn AArch64DAGToDAGISel::SelectAddrModeIndexed(self, N: SDValue, Size: u32, Base: *mut SDValue, OffImm: *mut SDValue) -> bool {
    let mut dl: SDLoc = N;
    let mut DL: *DataLayout = self.CurDAG.getDataLayout();
    let mut TLI: *TargetLowering = self.getTargetLowering();
    if N.getOpcode() == FrameIndex {
        let mut FI: i32 = cast(N).getIndex();
        Base = self.CurDAG.getTargetFrameIndex(FI, TLI.getPointerTy(DL, 0));
        OffImm = self.CurDAG.getTargetConstant(0, dl, i64, false);
        return true;
    }
    if N.getOpcode() == ADDlow && isWorthFoldingADDlow(N) {
        let mut GAN: *mut GlobalAddressSDNode = dyn_cast(N.getOperand(1).getNode());
        Base = N.getOperand(0);
        OffImm = N.getOperand(1);
        if !GAN {
            return true;
        }
        if GAN.getOffset() % Size == 0 && GAN.getGlobal().getPointerAlignment(DL) >= Size {
            return true;
        }
    }
    if self.CurDAG.isBaseWithConstantOffset(N) {
        if dyn_cast(N.getOperand(1)) {
            RHS;
        } else {
            let mut RHSC: i64 = RHS.getZExtValue() as i64;
            let mut Scale: u32 = Log2_32(Size);
            if isValidAsScaledImmediate(RHSC, 4096, Size) {
                Base = N.getOperand(0);
                if Base.getOpcode() == FrameIndex {
                    let mut FI: i32 = cast(Base).getIndex();
                    Base = self.CurDAG.getTargetFrameIndex(FI, TLI.getPointerTy(DL, 0));
                }
                OffImm = self.CurDAG.getTargetConstant(RHSC >> Scale, dl, i64, false);
                return true;
            }
        }
    }
    if self.SelectAddrModeUnscaled(N, Size, Base, OffImm) {
        return false;
    }
    Base = N;
    OffImm = self.CurDAG.getTargetConstant(0, dl, i64, false);
    return true;
}

fn AArch64DAGToDAGISel::SelectAddrModeUnscaled(self, N: SDValue, Size: u32, Base: *mut SDValue, OffImm: *mut SDValue) -> bool {
    if !self.CurDAG.isBaseWithConstantOffset(N) {
        return false;
    }
    if dyn_cast(N.getOperand(1)) {
        RHS;
    } else {
        let mut RHSC: i64 = RHS.getSExtValue();
        if RHSC >= -256 && RHSC < 256 {
            Base = N.getOperand(0);
            if Base.getOpcode() == FrameIndex {
                let mut FI: i32 = cast(Base).getIndex();
                let mut TLI: *TargetLowering = self.getTargetLowering();
                Base = self.CurDAG.getTargetFrameIndex(FI, TLI.getPointerTy(self.CurDAG.getDataLayout(), 0));
            }
            OffImm = self.CurDAG.getTargetConstant(RHSC, N, i64, false);
            return true;
        }
    }
    return false;
}

fn Widen(CurDAG: *mut SelectionDAG, N: SDValue) -> SDValue {
    let mut dl: SDLoc = N;
    let mut ImpDef: SDValue = SDValue { Node: CurDAG.getMachineNode(IMPLICIT_DEF, dl, i64), ResNo: 0 };
    return CurDAG.getTargetInsertSubreg(sub_32, dl, i64, ImpDef, N);
}

fn AArch64DAGToDAGISel::SelectExtendedSHL(self, N: SDValue, Size: u32, WantExtend: bool, Offset: *mut SDValue, SignExtend: *mut SDValue) -> bool {
    assert!(N.getOpcode() == SHL, "Invalid opcode.");
    let mut CSD: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !CSD || (CSD.getZExtValue() & 7) != CSD.getZExtValue() {
        return false;
    }
    let mut dl: SDLoc = N;
    if WantExtend {
        let mut Ext: ShiftExtendType = getExtendTypeForNode(N.getOperand(0), true);
        if Ext == InvalidShiftExtend {
            return false;
        }
        Offset = narrowIfNeeded(self.CurDAG, N.getOperand(0).getOperand(0));
        SignExtend = self.CurDAG.getTargetConstant(Ext == SXTW, dl, i32, false);
    } else {
        Offset = N.getOperand(0);
        SignExtend = self.CurDAG.getTargetConstant(0, dl, i32, false);
    }
    let mut LegalShiftVal: u32 = Log2_32(Size);
    let mut ShiftVal: u32 = CSD.getZExtValue();
    if ShiftVal != 0 && ShiftVal != LegalShiftVal {
        return false;
    }
    return self.isWorthFoldingAddr(N, Size);
}

fn AArch64DAGToDAGISel::SelectAddrModeWRO(self, N: SDValue, Size: u32, Base: *mut SDValue, Offset: *mut SDValue, SignExtend: *mut SDValue, DoShift: *mut SDValue) -> bool {
    if N.getOpcode() != ADD {
        return false;
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut dl: SDLoc = N;
    if isa(LHS) || isa(RHS) {
        return false;
    }
    let mut Node: *SDNode = N.getNode();
    for UI in Node.users() {
        if !isMemOpOrPrefetch(UI) {
            return false;
        }
    }
    let mut IsExtendedRegisterWorthFolding: bool = self.isWorthFoldingAddr(N, Size);
    if IsExtendedRegisterWorthFolding && RHS.getOpcode() == SHL && self.SelectExtendedSHL(RHS, Size, true, Offset, SignExtend) {
        Base = LHS;
        DoShift = self.CurDAG.getTargetConstant(true, dl, i32, false);
        return true;
    }
    if IsExtendedRegisterWorthFolding && LHS.getOpcode() == SHL && self.SelectExtendedSHL(LHS, Size, true, Offset, SignExtend) {
        Base = RHS;
        DoShift = self.CurDAG.getTargetConstant(true, dl, i32, false);
        return true;
    }
    DoShift = self.CurDAG.getTargetConstant(false, dl, i32, false);
    let mut Ext: ShiftExtendType = InvalidShiftExtend;
    if IsExtendedRegisterWorthFolding && (Ext = getExtendTypeForNode(LHS, true)) != InvalidShiftExtend {
        Base = RHS;
        Offset = narrowIfNeeded(self.CurDAG, LHS.getOperand(0));
        SignExtend = self.CurDAG.getTargetConstant(Ext == SXTW, dl, i32, false);
        if self.isWorthFoldingAddr(LHS, Size) {
            return true;
        }
    }
    if IsExtendedRegisterWorthFolding && (Ext = getExtendTypeForNode(RHS, true)) != InvalidShiftExtend {
        Base = LHS;
        Offset = narrowIfNeeded(self.CurDAG, RHS.getOperand(0));
        SignExtend = self.CurDAG.getTargetConstant(Ext == SXTW, dl, i32, false);
        if self.isWorthFoldingAddr(RHS, Size) {
            return true;
        }
    }
    return false;
}

fn isPreferredADD(ImmOff: i64) -> bool {
    if (ImmOff & -4096) == 0 {
        return true;
    }
    if (ImmOff & -16773121) == 0 {
        return (ImmOff & -16711681) != 0 && (ImmOff & -61441) != 0;
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectAddrModeXRO(self, N: SDValue, Size: u32, Base: *mut SDValue, Offset: *mut SDValue, SignExtend: *mut SDValue, DoShift: *mut SDValue) -> bool {
    if N.getOpcode() != ADD {
        return false;
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut DL: SDLoc = N;
    let mut Node: *SDNode = N.getNode();
    for UI in Node.users() {
        if !isMemOpOrPrefetch(UI) {
            return false;
        }
    }
    if isa(RHS) {
        let mut ImmOff: i64 = operator(RHS).getAsZExtVal() as i64;
        if isValidAsScaledImmediate(ImmOff, 4096, Size) || isPreferredADD(ImmOff) || isPreferredADD(-ImmOff) {
            return false;
        }
        let mut Ops: [1]SDValue = [RHS];
        let mut MOVI: *mut SDNode = self.CurDAG.getMachineNode(MOVi64imm, DL, i64, Ops);
        let mut MOVIV: SDValue = SDValue { Node: MOVI, ResNo: 0 };
        N = self.CurDAG.getNode(ADD, DL, i64, LHS, MOVIV);
    }
    let mut IsExtendedRegisterWorthFolding: bool = self.isWorthFoldingAddr(N, Size);
    if IsExtendedRegisterWorthFolding && RHS.getOpcode() == SHL && self.SelectExtendedSHL(RHS, Size, false, Offset, SignExtend) {
        Base = LHS;
        DoShift = self.CurDAG.getTargetConstant(true, DL, i32, false);
        return true;
    }
    if IsExtendedRegisterWorthFolding && LHS.getOpcode() == SHL && self.SelectExtendedSHL(LHS, Size, false, Offset, SignExtend) {
        Base = RHS;
        DoShift = self.CurDAG.getTargetConstant(true, DL, i32, false);
        return true;
    }
    Base = LHS;
    Offset = RHS;
    SignExtend = self.CurDAG.getTargetConstant(false, DL, i32, false);
    DoShift = self.CurDAG.getTargetConstant(false, DL, i32, false);
    return true;
}

fn AArch64DAGToDAGISel::createDTuple(self, Regs: ArrayRef<SDValue>) -> SDValue {
    let mut RegClassIDs: [3]u32 = [DDRegClassID, DDDRegClassID, DDDDRegClassID];
    let mut SubRegs: [4]u32 = [dsub0, dsub1, dsub2, dsub3];
    return self.createTuple(Regs, RegClassIDs, SubRegs);
}

fn AArch64DAGToDAGISel::createQTuple(self, Regs: ArrayRef<SDValue>) -> SDValue {
    let mut RegClassIDs: [3]u32 = [QQRegClassID, QQQRegClassID, QQQQRegClassID];
    let mut SubRegs: [4]u32 = [qsub0, qsub1, qsub2, qsub3];
    return self.createTuple(Regs, RegClassIDs, SubRegs);
}

fn AArch64DAGToDAGISel::createZTuple(self, Regs: ArrayRef<SDValue>) -> SDValue {
    let mut RegClassIDs: [3]u32 = [ZPR2RegClassID, ZPR3RegClassID, ZPR4RegClassID];
    let mut SubRegs: [4]u32 = [zsub0, zsub1, zsub2, zsub3];
    return self.createTuple(Regs, RegClassIDs, SubRegs);
}

fn AArch64DAGToDAGISel::createZMulTuple(self, Regs: ArrayRef<SDValue>) -> SDValue {
    assert!(Regs.len == 2 || Regs.len == 4);
    let mut RegClassIDs: [3]u32 = [ZPR2Mul2RegClassID, 0, ZPR4Mul4RegClassID];
    let mut SubRegs: [4]u32 = [zsub0, zsub1, zsub2, zsub3];
    return self.createTuple(Regs, RegClassIDs, SubRegs);
}

fn AArch64DAGToDAGISel::createTuple(self, Regs: ArrayRef<SDValue>, RegClassIDs: *u32, SubRegs: *u32) -> SDValue {
    if Regs.len == 1 {
        return Regs[0];
    }
    assert!(Regs.len >= 2 && Regs.len <= 4);
    let mut DL: SDLoc = Regs[0];
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    Ops.push(self.CurDAG.getTargetConstant(RegClassIDs[Regs.len - 2], DL, i32, false));
    for let mut i: u32 = 0; i < Regs.len; i += 1 {
        Ops.push(Regs[i]);
        Ops.push(self.CurDAG.getTargetConstant(SubRegs[i], DL, i32, false));
    }
    let mut N: *mut SDNode = self.CurDAG.getMachineNode(REG_SEQUENCE, DL, Untyped, Ops);
    return SDValue { Node: N, ResNo: 0 };
}

fn AArch64DAGToDAGISel::SelectTable(self, N: *mut SDNode, NumVecs: u32, Opc: u32, isExt: bool) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut ExtOff: u32 = isExt;
    let mut Vec0Off: u32 = ExtOff + 1;
    let mut Regs: SmallVector<SDValue, 4> = N.ops().slice(Vec0Off, NumVecs);
    let mut RegSeq: SDValue = self.createQTuple(Regs);
    let mut Ops: SmallVector<SDValue, 6> = SmallVector<SDValue, 6> {};
    if isExt {
        Ops.push(N.getOperand(1));
    }
    Ops.push(RegSeq);
    Ops.push(N.getOperand(NumVecs + ExtOff + 1));
    self.ReplaceNode(N, self.CurDAG.getMachineNode(Opc, dl, VT, Ops));
}

fn extractPtrauthBlendDiscriminators(Disc: SDValue, DAG: *mut SelectionDAG) -> tuple<SDValue, SDValue> {
    let mut DL: SDLoc = Disc;
    let mut AddrDisc: SDValue = SDValue {};
    let mut ConstDisc: SDValue = SDValue {};
    if operator(Disc).getOpcode() == INTRINSIC_WO_CHAIN && operator(Disc).getConstantOperandVal(0) == ptrauth_blend {
        AddrDisc = operator(Disc).getOperand(1);
        ConstDisc = operator(Disc).getOperand(2);
    } else {
        ConstDisc = Disc;
    }
    let mut ConstDiscN: *mut ConstantSDNode = dyn_cast(ConstDisc);
    if !ConstDiscN || !isUInt(ConstDiscN.getZExtValue()) {
        return make_tuple(DAG.getTargetConstant(0, DL, i64, false), Disc);
    }
    if !AddrDisc {
        AddrDisc = DAG.getRegister(XZR, i64);
    }
    return make_tuple(DAG.getTargetConstant(ConstDiscN.getZExtValue(), DL, i64, false), AddrDisc);
}

fn AArch64DAGToDAGISel::SelectPtrauthAuth(self, N: *mut SDNode) {
    let mut DL: SDLoc = N;
    let mut Val: SDValue = N.getOperand(1);
    let mut AUTKey: SDValue = N.getOperand(2);
    let mut AUTDisc: SDValue = N.getOperand(3);
    let mut AUTKeyC: u32 = cast(AUTKey).getZExtValue();
    AUTKey = self.CurDAG.getTargetConstant(AUTKeyC, DL, i64, false);
    let mut AUTAddrDisc: SDValue = SDValue {};
    let mut AUTConstDisc: SDValue = SDValue {};
    tie(AUTConstDisc, AUTAddrDisc) = extractPtrauthBlendDiscriminators(AUTDisc, self.CurDAG);
    if !self.Subtarget.isX16X17Safer() {
        let mut Ops: []SDValue = []SDValue { [Val, AUTKey, AUTConstDisc, AUTAddrDisc], SDValue> {} };
        if N.getNumOperands() > 4 {
            Ops.push(N.getOperand(4));
        }
        let mut AUT: *mut SDNode = self.CurDAG.getMachineNode(AUTxMxN, DL, i64, i64, Ops);
        self.ReplaceNode(N, AUT);
    } else {
        let mut X16Copy: SDValue = self.CurDAG.getCopyToReg(self.CurDAG.getEntryNode(), DL, X16, Val, SDValue {});
        let mut Ops: [4]SDValue = [AUTKey, AUTConstDisc, AUTAddrDisc, X16Copy.getValue(1)];
        let mut AUT: *mut SDNode = self.CurDAG.getMachineNode(AUTx16x17, DL, i64, Ops);
        self.ReplaceNode(N, AUT);
    }
}

fn AArch64DAGToDAGISel::SelectPtrauthResign(self, N: *mut SDNode) {
    let mut DL: SDLoc = N;
    let mut OffsetBase: i32 = if N.getOpcode() == INTRINSIC_W_CHAIN { 1 } else { 0 };
    let mut Val: SDValue = N.getOperand(OffsetBase + 1);
    let mut AUTKey: SDValue = N.getOperand(OffsetBase + 2);
    let mut AUTDisc: SDValue = N.getOperand(OffsetBase + 3);
    let mut PACKey: SDValue = N.getOperand(OffsetBase + 4);
    let mut PACDisc: SDValue = N.getOperand(OffsetBase + 5);
    let mut IntNum: u32 = N.getConstantOperandVal(OffsetBase + 0);
    let mut HasLoad: bool = IntNum == ptrauth_resign_load_relative;
    let mut AUTKeyC: u32 = cast(AUTKey).getZExtValue();
    let mut PACKeyC: u32 = cast(PACKey).getZExtValue();
    AUTKey = self.CurDAG.getTargetConstant(AUTKeyC, DL, i64, false);
    PACKey = self.CurDAG.getTargetConstant(PACKeyC, DL, i64, false);
    let mut AUTAddrDisc: SDValue = SDValue {};
    let mut AUTConstDisc: SDValue = SDValue {};
    tie(AUTConstDisc, AUTAddrDisc) = extractPtrauthBlendDiscriminators(AUTDisc, self.CurDAG);
    let mut PACAddrDisc: SDValue = SDValue {};
    let mut PACConstDisc: SDValue = SDValue {};
    tie(PACConstDisc, PACAddrDisc) = extractPtrauthBlendDiscriminators(PACDisc, self.CurDAG);
    let mut X16Copy: SDValue = self.CurDAG.getCopyToReg(self.CurDAG.getEntryNode(), DL, X16, Val, SDValue {});
    if HasLoad {
        let mut Addend: SDValue = N.getOperand(OffsetBase + 6);
        let mut IncomingChain: SDValue = N.getOperand(0);
        let mut Ops: [9]SDValue = [AUTKey, AUTConstDisc, AUTAddrDisc, PACKey, PACConstDisc, PACAddrDisc, Addend, IncomingChain, X16Copy.getValue(1)];
        let mut AUTRELLOADPAC: *mut SDNode = self.CurDAG.getMachineNode(AUTRELLOADPAC, DL, i64, Other, Ops);
        self.ReplaceNode(N, AUTRELLOADPAC);
    } else {
        let mut Ops: [7]SDValue = [AUTKey, AUTConstDisc, AUTAddrDisc, PACKey, PACConstDisc, PACAddrDisc, X16Copy.getValue(1)];
        let mut AUTPAC: *mut SDNode = self.CurDAG.getMachineNode(AUTPAC, DL, i64, Ops);
        self.ReplaceNode(N, AUTPAC);
    }
}

fn AArch64DAGToDAGISel::SelectPtrauthResignWithPC(self, N: *mut SDNode) {
    let mut DL: SDLoc = N;
    let mut Val: SDValue = N.getOperand(1);
    let mut AUTKey: SDValue = N.getOperand(2);
    let mut AUTDisc: SDValue = N.getOperand(3);
    let mut AUTPC: SDValue = N.getOperand(4);
    let mut PACKey: SDValue = N.getOperand(5);
    let mut PACDisc: SDValue = N.getOperand(6);
    let mut AUTKeyC: u32 = cast(AUTKey).getZExtValue();
    let mut PACKeyC: u32 = cast(PACKey).getZExtValue();
    AUTKey = self.CurDAG.getTargetConstant(AUTKeyC, DL, i64, false);
    PACKey = self.CurDAG.getTargetConstant(PACKeyC, DL, i64, false);
    let mut PACAddrDisc: SDValue = SDValue {};
    let mut PACConstDisc: SDValue = SDValue {};
    tie(PACConstDisc, PACAddrDisc) = extractPtrauthBlendDiscriminators(PACDisc, self.CurDAG);
    let mut X17Copy: SDValue = self.CurDAG.getCopyToReg(self.CurDAG.getEntryNode(), DL, X17, Val, SDValue {});
    let mut X16Copy: SDValue = self.CurDAG.getCopyToReg(self.CurDAG.getEntryNode(), DL, X16, AUTDisc, X17Copy.getValue(1));
    let mut X15Copy: SDValue = self.CurDAG.getCopyToReg(self.CurDAG.getEntryNode(), DL, X15, AUTPC, X16Copy.getValue(1));
    let mut Ops: [5]SDValue = [AUTKey, PACKey, PACConstDisc, PACAddrDisc, X15Copy.getValue(1)];
    let mut AUTPCPAC: *mut SDNode = self.CurDAG.getMachineNode(AUTPCPAC, DL, i64, Ops);
    self.ReplaceNode(N, AUTPCPAC);
}

fn AArch64DAGToDAGISel::tryIndexedLoad(self, N: *mut SDNode) -> bool {
    let mut LD: *mut LoadSDNode = cast(N);
    if LD.isUnindexed() {
        return false;
    }
    let mut VT: EVT = LD.getMemoryVT();
    let mut DstVT: EVT = N.getValueType(0);
    let mut AM: MemIndexedMode = LD.getAddressingMode();
    let mut IsPre: bool = AM == PRE_INC || AM == PRE_DEC;
    let mut OffsetOp: *mut ConstantSDNode = cast(LD.getOffset());
    let mut OffsetVal: i32 = OffsetOp.getZExtValue() as i32;
    let mut Opcode: u32 = 0;
    let mut ExtType: LoadExtType = LD.getExtensionType();
    let mut InsertTo64: bool = false;
    let mut UseLd1: bool = (VT.is64BitVector() || VT.is128BitVector()) && (!self.Subtarget.isLittleEndian() || (self.Subtarget.requiresStrictAlign() && LD.getAlign() < VT.getStoreSize().operator unsigned long long()));
    if VT == i64 {
        Opcode = if IsPre { LDRXpre } else { LDRXpost };
    } else if VT == i32 {
        if ExtType == NON_EXTLOAD {
            Opcode = if IsPre { LDRWpre } else { LDRWpost };
        } else if ExtType == SEXTLOAD {
            Opcode = if IsPre { LDRSWpre } else { LDRSWpost };
        } else {
            Opcode = if IsPre { LDRWpre } else { LDRWpost };
            InsertTo64 = true;
            DstVT = i32;
        }
    } else if VT == i16 {
        if ExtType == SEXTLOAD {
            if DstVT == i64 {
                Opcode = if IsPre { LDRSHXpre } else { LDRSHXpost };
            } else {
                Opcode = if IsPre { LDRSHWpre } else { LDRSHWpost };
            }
        } else {
            Opcode = if IsPre { LDRHHpre } else { LDRHHpost };
            InsertTo64 = DstVT == i64;
            DstVT = i32;
        }
    } else if VT == i8 {
        if ExtType == SEXTLOAD {
            if DstVT == i64 {
                Opcode = if IsPre { LDRSBXpre } else { LDRSBXpost };
            } else {
                Opcode = if IsPre { LDRSBWpre } else { LDRSBWpost };
            }
        } else {
            Opcode = if IsPre { LDRBBpre } else { LDRBBpost };
            InsertTo64 = DstVT == i64;
            DstVT = i32;
        }
    } else if VT == f16 {
        Opcode = if IsPre { LDRHpre } else { LDRHpost };
    } else if VT == bf16 {
        Opcode = if IsPre { LDRHpre } else { LDRHpost };
    } else if VT == f32 {
        Opcode = if IsPre { LDRSpre } else { LDRSpost };
    } else if VT == f64 || (VT.is64BitVector() && !UseLd1) {
        Opcode = if IsPre { LDRDpre } else { LDRDpost };
    } else if VT.is128BitVector() && !UseLd1 {
        Opcode = if IsPre { LDRQpre } else { LDRQpost };
    } else if VT.is64BitVector() && UseLd1 {
        if IsPre || OffsetVal != 8 {
            return false;
        }
        match VT.getScalarSizeInBits() {
            8 => {
                Opcode = LD1Onev8b_POST;
            },
            16 => {
                Opcode = LD1Onev4h_POST;
            },
            32 => {
                Opcode = LD1Onev2s_POST;
            },
            64 => {
                Opcode = LD1Onev1d_POST;
            },
            _ => {
                llvm_unreachable_internal("Expected vector element to be a power of 2", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ISelDAGToDAG.cpp", 1994);
            },
        }
    } else if VT.is128BitVector() && UseLd1 {
        if IsPre || OffsetVal != 16 {
            return false;
        }
        match VT.getScalarSizeInBits() {
            8 => {
                Opcode = LD1Onev16b_POST;
            },
            16 => {
                Opcode = LD1Onev8h_POST;
            },
            32 => {
                Opcode = LD1Onev4s_POST;
            },
            64 => {
                Opcode = LD1Onev2d_POST;
            },
            _ => {
                llvm_unreachable_internal("Expected vector element to be a power of 2", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ISelDAGToDAG.cpp", 2013);
            },
        }
    } else {
        return false;
    }
    let mut Chain: SDValue = LD.getChain();
    let mut Base: SDValue = LD.getBasePtr();
    let mut dl: SDLoc = N;
    let mut Offset: SDValue = if UseLd1 { self.CurDAG.getRegister(XZR, i64) } else { self.CurDAG.getTargetConstant(OffsetVal, dl, i64, false) };
    let mut Ops: [3]SDValue = [Base, Offset, Chain];
    let mut Res: *mut SDNode = self.CurDAG.getMachineNode(Opcode, dl, i64, DstVT, Other, Ops);
    let mut MemOp: *mut MachineMemOperand = cast(N).getMemOperand();
    self.CurDAG.setNodeMemRefs(cast(Res), [MemOp]);
    let mut LoadedVal: SDValue = SDValue { Node: Res, ResNo: 1 };
    if InsertTo64 {
        let mut SubReg: SDValue = self.CurDAG.getTargetConstant(sub_32, dl, i32, false);
        LoadedVal = SDValue { Node: self.CurDAG.getMachineNode(SUBREG_TO_REG, dl, i64, LoadedVal, SubReg), ResNo: 0 };
    }
    self.ReplaceUses(SDValue { Node: N, ResNo: 0 }, LoadedVal);
    self.ReplaceUses(SDValue { Node: N, ResNo: 1 }, SDValue { Node: Res, ResNo: 0 });
    self.ReplaceUses(SDValue { Node: N, ResNo: 2 }, SDValue { Node: Res, ResNo: 2 });
    self.CurDAG.RemoveDeadNode(N);
    return true;
}

fn AArch64DAGToDAGISel::SelectLoad(self, N: *mut SDNode, NumVecs: u32, Opc: u32, SubRegIdx: u32) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Chain: SDValue = N.getOperand(0);
    let mut Ops: [2]SDValue = [N.getOperand(2), Chain];
    let mut ResTys: [2]EVT = [Untyped, Other];
    let mut Ld: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, ResTys, Ops);
    let mut SuperReg: SDValue = SDValue { Node: Ld, ResNo: 0 };
    for let mut i: u32 = 0; i < NumVecs; i += 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: i }, self.CurDAG.getTargetExtractSubreg(SubRegIdx + i, dl, VT, SuperReg));
    }
    self.ReplaceUses(SDValue { Node: N, ResNo: NumVecs }, SDValue { Node: Ld, ResNo: 1 });
    if dyn_cast(N) {
        MemIntr;
    } else {
        let mut MemOp: *mut MachineMemOperand = MemIntr.getMemOperand();
        self.CurDAG.setNodeMemRefs(cast(Ld), [MemOp]);
    }
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::SelectPostLoad(self, N: *mut SDNode, NumVecs: u32, Opc: u32, SubRegIdx: u32) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Chain: SDValue = N.getOperand(0);
    let mut Ops: [3]SDValue = [N.getOperand(1), N.getOperand(2), Chain];
    let mut ResTys: [3]EVT = [i64, Untyped, Other];
    let mut Ld: *mut SDNode = self.CurDAG.getMachineNode(Opc, dl, ResTys, Ops);
    self.ReplaceUses(SDValue { Node: N, ResNo: NumVecs }, SDValue { Node: Ld, ResNo: 0 });
    let mut SuperReg: SDValue = SDValue { Node: Ld, ResNo: 1 };
    if NumVecs == 1 {
        self.ReplaceUses(SDValue { Node: N, ResNo: 0 }, SuperReg);
    } else {
        for let mut i: u32 = 0; i < NumVecs; i += 1 {
            self.ReplaceUses(SDValue { Node: N, ResNo: i }, self.CurDAG.getTargetExtractSubreg(SubRegIdx + i, dl, VT, SuperReg));
        }
    }
    let mut MemOp: *mut MachineMemOperand = cast(N).getMemOperand();
    self.CurDAG.setNodeMemRefs(cast(Ld), [MemOp]);
    self.ReplaceUses(SDValue { Node: N, ResNo: NumVecs + 1 }, SDValue { Node: Ld, ResNo: 2 });
    self.CurDAG.RemoveDeadNode(N);
}

fn AArch64DAGToDAGISel::findAddrModeSVELoadStore(self, N: *mut SDNode, Opc_rr: u32, Opc_ri: u32, OldBase: *SDValue, OldOffset: *SDValue, Scale: u32) -> tuple<unsigned int, SDValue, SDValue> {
    let mut NewBase: SDValue = OldBase;
    let mut NewOffset: SDValue = OldOffset;
    let mut IsRegImm: bool = self.SelectAddrModeIndexedSVE(N, OldBase, NewBase, NewOffset);
    let mut IsRegReg: bool = !IsRegImm && self.SelectSVERegRegAddrMode(OldBase, Scale, NewBase, NewOffset);
    return make_tuple(if IsRegReg { Opc_rr } else { Opc_ri }, NewBase, NewOffset);
}

enum SelectTypeKind {
    Int1 = 0,
    Int = 1,
    FP = 2,
    AnyType = 3,
}

