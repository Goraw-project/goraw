struct WidenVector {
    DAG: *mut SelectionDAG,
}

fn WidenVector::operator()(self, V64Reg: SDValue) -> SDValue {
    let mut VT: EVT = V64Reg.getValueType();
    let mut NarrowSize: u32 = VT.getVectorNumElements();
    let mut EltTy: MVT = VT.getVectorElementType().getSimpleVT();
    let mut WideTy: MVT = getVectorVT(EltTy, 2 * NarrowSize);
    let mut DL: SDLoc = V64Reg;
    let mut Undef: SDValue = self.DAG.getMachineNode(IMPLICIT_DEF, DL, WideTy);
    return self.DAG.getTargetInsertSubreg;
}

fn NarrowVector(V128Reg: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = V128Reg.getValueType();
    let mut WideSize: u32 = VT.getVectorNumElements();
    let mut EltTy: MVT = VT.getVectorElementType().getSimpleVT();
    let mut NarrowTy: MVT = getVectorVT(EltTy, WideSize / 2);
    return DAG.getTargetExtractSubreg;
}

fn AArch64DAGToDAGISel::SelectLoadLane(self, N: *mut SDNode, NumVecs: u32, Opc: u32) {
    let mut dl: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Narrow: bool = VT.getSizeInBits();
    let mut Regs: SmallVector<SDValue, 4> = zeroed();
    if Narrow {
        transform();
    }
    let mut RegSeq: SDValue = self.createQTuple();
    let mut ResTys: [2]EVT = [Untyped, Other];
    let mut LaneNo: u32 = N.getConstantOperandVal(NumVecs + 2);
    let mut Ops: []SDValue = zeroed();
    let mut Ld: *mut SDNode = null;
    let mut SuperReg: SDValue = SDValue { Node: Ld, ResNo: 0 };
    let mut WideVT: EVT = operator(RegSeq.getOperand(1)).getValueType(0);
    let mut QSubs: []u32 = zeroed();
    for let mut i: u32 = 0; i < NumVecs; i += 1 {
        let mut NV: SDValue = zeroed();
        if Narrow {
            NV = NarrowVector(NV);
        }
    }
}

