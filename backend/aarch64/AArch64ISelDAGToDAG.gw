    let mut dl: SDLoc = N;
    return CurDAG.getTargetExtractSubreg;
}

fn AArch64DAGToDAGISel::SelectArithExtendedRegister(self, N: SDValue, Reg: *mut SDValue, Shift: *mut SDValue) -> bool {
    let mut ShiftVal: u32 = 0;
    let mut Ext: ShiftExtendType = zeroed();
    if N.getOpcode() == SHL {
        let mut CSD: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if !CSD {
            return false;
        }
        ShiftVal = CSD.getZExtValue();
        if ShiftVal > 4 {
            return false;
        }
        Ext = getExtendTypeForNode(N.getOperand(0), false);
        if Ext == InvalidShiftExtend {
            return false;
        }
        Reg = N.getOperand(0).getOperand(0);
    } else {
        Ext = getExtendTypeForNode(N, false);
        if Ext == InvalidShiftExtend {
            return false;
        }
        if isSignExtendShiftType(Ext) {
            let mut Op: SDValue = N.getOperand(0);
            if operator(Op).getOpcode() == ANY_EXTEND {
                Op = operator(Op).getOperand(0);
            }
            if Op.getOpcode() == EXTRACT_VECTOR_ELT && Op.getOperand(0).getValueType().isFixedLengthVector() {
                return false;
            }
        }
        Reg = N.getOperand(0);
        let mut isDef32: Closure_2 = Closure_2 {};
        if Ext == UXTW && operator(Reg).getValueType(0).getSizeInBits() && isDef32.call(Reg) {
            return false;
        }
    }
    if Ext == SXTW && Reg.getOpcode() == SRA && Reg.getValueType() == i32 && isa(Reg.getOperand(1)) && Reg.hasOneUse() {
        return false;
    }
    assert!(Ext != UXTX && Ext != SXTX);
    Reg = narrowIfNeeded(Reg);
    return self.isWorthFoldingALU(N, false);
}

fn AArch64DAGToDAGISel::SelectArithUXTXRegister(self, N: SDValue, Reg: *mut SDValue, Shift: *mut SDValue) -> bool {
    let mut ShiftVal: u32 = 0;
    let mut Ext: ShiftExtendType = zeroed();
    if N.getOpcode() != SHL {
        return false;
    }
    let mut CSD: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !CSD {
        return false;
    }
    ShiftVal = CSD.getZExtValue();
    if ShiftVal > 4 {
        return false;
    }
    Ext = UXTX;
    Reg = N.getOperand(0);
    return self.isWorthFoldingALU(N, false);
}

fn isWorthFoldingADDlow(N: SDValue) -> bool {
    return true;
