fn AArch64DAGToDAGISel::SelectArithImmed(self, N: SDValue, Val: *mut SDValue, Shift: *mut SDValue) -> bool {
    if !isa(N.getNode()) {
        return false;
    }
    let mut Immed: u64 = N.getNode().getAsZExtVal();
    if !isLegalArithImmed(Immed) {
        return false;
    }
    let mut ShiftAmt: u32 = getArithImmedShift(Immed);
    Immed >>= ShiftAmt;
    let mut ShVal: u32 = getShifterImm(LSL, ShiftAmt);
    let mut dl: SDLoc = N;
    return true;
}

fn AArch64DAGToDAGISel::SelectNegArithImmed(self, N: SDValue, Val: *mut SDValue, Shift: *mut SDValue) -> bool {
    if !isa(N.getNode()) {
        return false;
    }
    let mut Immed: u64 = N.getNode().getAsZExtVal();
    if Immed == 0 {
        return false;
    }
    if N.getValueType() == i32 {
        Immed = ~(Immed as u32) + 1;
    } else {
        Immed = ~Immed + 1;
    }
    if Immed & 18446744073692774400 {
        return false;
    }
    Immed &= 16777215;
    return self.SelectArithImmed;
}

fn getShiftTypeForNode(N: SDValue) -> ShiftExtendType {
    match N.getOpcode() {
        _ => {
            return InvalidShiftExtend;
        },
        SHL => {
            return LSL;
        },
        SRL => {
            return LSR;
        },
        SRA => {
            return ASR;
        },
        ROTR => {
            return ROR;
        },
    }
}

fn isMemOpOrPrefetch(N: *mut SDNode) -> bool {}

fn isWorthFoldingSHL(V: SDValue) -> bool {
    assert!(V.getOpcode() == SHL, "invalid opcode");
    let mut CSD: *mut auto = dyn_cast(V.getOperand(1));
    if operator!() {
        return false;
    }
    let mut ShiftVal: u32 = ();
    if ShiftVal > 3 {
        return false;
    }
    let mut Node: *SDNode = V.getNode();
    return true;
}

fn AArch64DAGToDAGISel::isWorthFoldingAddr(self: *AArch64DAGToDAGISel, V: SDValue, Size: u32) -> bool {
    if  {
        return true;
    }
    if self.Subtarget() && (Size == 2 || Size == 16) {
        return false;
    }
    if V.getOpcode() == SHL && isWorthFoldingSHL(V) {
        return true;
    }
    if V.getOpcode() == ADD {
        let mut LHS: SDValue = V.getOperand(0);
        let mut RHS: SDValue = V.getOperand(1);
        if LHS.getOpcode() == SHL && isWorthFoldingSHL(LHS) {
            return true;
        }
        if RHS.getOpcode() == SHL && isWorthFoldingSHL(RHS) {
            return true;
        }
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectShiftedRegisterFromAnd(self, N: SDValue, Reg: *mut SDValue, Shift: *mut SDValue) -> bool {
    let mut VT: EVT = N.getValueType();
    if VT != i32 && VT != i64 {
        return false;
    }
    if operator(N).getOpcode() != AND || !operator(N).hasOneUse() {
        return false;
    }
    let mut LHS: SDValue = N.getOperand(0);
    if !operator(LHS).hasOneUse() {
        return false;
    }
    let mut LHSOpcode: u32 = operator(LHS).getOpcode();
    if LHSOpcode != SHL && LHSOpcode != SRL && LHSOpcode != SRA {
        return false;
    }
    let mut ShiftAmtNode: *mut ConstantSDNode = dyn_cast(LHS.getOperand(1));
    if !ShiftAmtNode {
        return false;
    }
    let mut ShiftAmtC: u64 = ShiftAmtNode.getZExtValue();
    let mut RHSC: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !RHSC {
        return false;
    }
    let mut AndMask: APInt = RHSC.getAPIntValue();
    let mut LowZBits: u32 = 0;
    let mut MaskLen: u32 = 0;
    if !AndMask.isShiftedMask(LowZBits, MaskLen) {
        return false;
    }
    let mut BitWidth: u32 = N.getValueSizeInBits();
    let mut DL: SDLoc = LHS;
    let mut NewShiftC: u64 = 0;
    let mut NewShiftOp: u32 = 0;
    if LHSOpcode == SHL {
        if LowZBits <= ShiftAmtC || (BitWidth != LowZBits + MaskLen) {
            return false;
        }
        NewShiftC = LowZBits - ShiftAmtC;
    } else {
        if LowZBits == 0 {
            return false;
        }
        NewShiftC = LowZBits + ShiftAmtC;
        if NewShiftC >= BitWidth {
            return false;
        }
        if LHSOpcode == SRA && (BitWidth != (LowZBits + MaskLen)) {
            return false;
        }
        if LHSOpcode == SRL && (BitWidth > (NewShiftC + MaskLen)) {
            return false;
        }
    }
    assert!(NewShiftC < BitWidth, "Invalid shift amount");
    let mut NewShiftAmt: SDValue = zeroed();
    let mut BitWidthMinus1: SDValue = zeroed();
    let mut ShVal: u32 = getShifterImm(LSL, LowZBits);
    return true;
}

fn getExtendTypeForNode(N: SDValue, IsLoadStore: bool) -> ShiftExtendType {
    if N.getOpcode() == SIGN_EXTEND || N.getOpcode() == SIGN_EXTEND_INREG {
        let mut SrcVT: EVT = EVT {};
        if N.getOpcode() == SIGN_EXTEND_INREG {
            SrcVT = cast(N.getOperand(1))();
        } else {
            SrcVT = N.getOperand(0).getValueType();
        }
        if !IsLoadStore && SrcVT == i8 {
            return SXTB;
        } else if !IsLoadStore && SrcVT == i16 {
            return SXTH;
        } else if SrcVT == i32 {
            return SXTW;
        }
        assert!(SrcVT != i64, "extend from 64-bits?");
        return InvalidShiftExtend;
    } else if N.getOpcode() == ZERO_EXTEND || N.getOpcode() == ANY_EXTEND {
        let mut SrcVT: EVT = N.getOperand(0).getValueType();
        if !IsLoadStore && SrcVT == i8 {
            return UXTB;
        } else if !IsLoadStore && SrcVT == i16 {
            return UXTH;
        } else if SrcVT == i32 {
            return UXTW;
        }
        assert!(SrcVT != i64, "extend from 64-bits?");
        return InvalidShiftExtend;
    } else if N.getOpcode() == AND {
        let mut CSD: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if !CSD {
            return InvalidShiftExtend;
        }
        let mut AndMask: u64 = CSD.getZExtValue();
        match AndMask {
            _ => {
                return InvalidShiftExtend;
            },
            255 => {
                return if !IsLoadStore { UXTB } else { InvalidShiftExtend };
            },
            65535 => {
                return if !IsLoadStore { UXTH } else { InvalidShiftExtend };
            },
            4294967295 => {
                return UXTW;
            },
        }
    }
    return InvalidShiftExtend;
}

fn AArch64DAGToDAGISel::isWorthNegatingImm(self: *AArch64DAGToDAGISel, V: SDValue) -> bool {
    assert!(isa(V), "invalid node");
    let mut VT: EVT = V.getValueType();
    assert!((VT == i32 || VT == i64), "invalid type");
    if !V.hasOneUse() {
        return false;
    }
    let mut Imm: u64 = cast(V)();
    let mut BitSize: u32 = VT.getSizeInBits();
    let mut OrigCost: ImmInsnModel, 4> = zeroed();
    let mut NewCost: ImmInsnModel, 4> = zeroed();
    expandMOVImm(Imm, BitSize);
    expandMOVImm(-Imm, BitSize);
    return () < ();
}

fn AArch64DAGToDAGISel::isWorthFoldingALU(self: *AArch64DAGToDAGISel, V: SDValue, LSL: bool) -> bool {
    if  {
        return true;
    }
    if LSL && self.Subtarget() && V.getOpcode() == SHL && V.getConstantOperandVal(1) <= 4 && getExtendTypeForNode(V.getOperand(0), false) == InvalidShiftExtend {
        return true;
    }
    return false;
}

fn AArch64DAGToDAGISel::SelectShiftedRegister(self, N: SDValue, AllowROR: bool, Reg: *mut SDValue, Shift: *mut SDValue) -> bool {
    if self.SelectShiftedRegisterFromAnd(N, Reg, Shift) {
        return true;
    }
    let mut ShType: ShiftExtendType = getShiftTypeForNode(N);
    if ShType == InvalidShiftExtend {
        return false;
    }
    if !AllowROR && ShType == ROR {
        return false;
    }
    if dyn_cast(N.getOperand(1)) {
        RHS;
    } else {
        let mut BitSize: u32 = N.getValueSizeInBits();
        let mut Val: u32 = RHS.getZExtValue() & (BitSize - 1);
        let mut ShVal: u32 = getShifterImm(ShType, Val);
        Reg = N.getOperand(0);
        return self.isWorthFoldingALU(N, true);
    }
    return false;
}

fn narrowIfNeeded(CurDAG: *mut SelectionDAG, N: SDValue) -> SDValue {
    if N.getValueType() == i32 {
        return N;
