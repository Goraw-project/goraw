fn AArch64DAGToDAGISel::Select(self, Node: *mut SDNode) {
    if Node.isMachineOpcode() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-isel", 1) {
                errs();
                Node;
                errs();
            }
        }
            if !(false) { break; }
        }
        Node.setNodeId(-1);
        return;
    }
    let mut VT: EVT = Node.getValueType(0);
    match Node.getOpcode() {
        _ => {
            break;
        },
        ATOMIC_CMP_SWAP => {
            if self.SelectCMP_SWAP(Node) {
                return;
            }
        },
        READ_REGISTER => {
            if self.tryReadRegister(Node) {
                return;
            }
        },
        WRITE_REGISTER => {
            if self.tryWriteRegister(Node) {
                return;
            }
        },
        LOAD => {
            if self.tryIndexedLoad(Node) {
                return;
            }
            break;
        },
        SRL => {
            AND;
        },
        ROTR => {
            SHL;
        },
        SIGN_EXTEND => {
            if self.tryBitfieldExtractOpFromSExt(Node) {
                return;
            }
        },
        OR => {
            if self.tryBitfieldInsertOp(Node) {
                return;
            }
        },
        EXTRACT_SUBVECTOR => {
            if self.trySelectCastScalableToFixedLengthVector(Node) {
                return;
            }
            break;
        },
        INSERT_SUBVECTOR => {
            if self.trySelectCastFixedLengthToScalableVector(Node) {
                return;
            }
            break;
        },
        Constant => {
            let mut ConstNode: *mut ConstantSDNode = cast(Node);
            if ConstNode.isZero() && (VT == i32 || VT == i64) {
                self.ReplaceNode(Node, getZeroRegister(Node, VT)());
                return;
            }
            break;
        },
        FrameIndex => {
            let mut FI: i32 = cast(Node)();
            let mut Shifter: u32 = getShifterImm(LSL, 0);
            let mut TLI: *TargetLowering = self.getTargetLowering;
            let mut TFI: SDValue = zeroed();
            let mut DL: SDLoc = Node;
            let mut Ops: []SDValue = zeroed();
            return;
        },
        INTRINSIC_W_CHAIN => {
            let mut IntNo: u32 = Node.getConstantOperandVal(1);
            match IntNo {
                _ => {
                    break;
                },
                swift_async_context_addr => {
                    let mut DL: SDLoc = Node;
                    let mut Chain: SDValue = Node.getOperand(0);
                    let mut CopyFP: SDValue = zeroed();
                    let mut Res: SDValue = zeroed();
                    let mut MF: *mut auto = null;
                    MF()()(true);
                    MF()()(true);
                    return;
                },
                ptrauth_resign_load_relative => {
                    self.SelectPtrauthResign(Node);
                },
            }
        },
        INTRINSIC_WO_CHAIN => {
            let mut IntNo: u32 = Node.getConstantOperandVal(0);
            match IntNo {
                _ => {
                    break;
                },
                ptrauth_auth => {
                    self.SelectPtrauthAuth(Node);
                },
                ptrauth_resign => {
                    self.SelectPtrauthResign(Node);
                },
                ptrauth_auth_with_pc_and_resign => {
                    self.SelectPtrauthResignWithPC(Node);
                },
            }
            break;
        },
        INTRINSIC_VOID => {
            let mut IntNo: u32 = Node.getConstantOperandVal(1);
            if Node.getNumOperands() >= 3 {
                VT = operator(Node.getOperand(2)).getValueType(0);
            }
            match IntNo {
                _ => {
                    break;
                },
            }
            break;
        },
    }
    SelectCode(Node);
}

