fn definesRegInClass(MI: *MachineInstr, TRI: *TargetRegisterInfo, Class: *TargetRegisterClass) -> bool {
    return any_of(Class, Closure_1 { MI: &mut MI, TRI: TRI });
}

fn readsRegInClass(MI: *MachineInstr, TRI: *TargetRegisterInfo, Class: *TargetRegisterClass) -> bool {
    return any_of(Class, Closure_2 { MI: &mut MI, TRI: TRI });
}

fn isFusableAppleSMEComputeOp(MI: *MachineInstr, TII: *TargetInstrInfo, TRI: *TargetRegisterInfo) -> bool {
    let mut ReadOrWriteZA: bool = MI.readsRegister || MI.definesRegister;
    if !ReadOrWriteZA && operator!(definesRegInClass(MI, TRI)) {
        return false;
    }
    if MI.mayLoad(AnyInBundle) || MI.mayStore(AnyInBundle) {
        return false;
    }
    if definesRegInClass(MI, TRI) {
        return false;
    }
    let mut WriteGPR: bool = definesRegInClass(MI, TRI) || definesRegInClass(MI, TRI);
    if WriteGPR {
        return false;
    }
    if MI.readsRegister || MI.definesRegister {
        return false;
    }
    let mut ReadGPR: bool = readsRegInClass(MI, TRI) && readsRegInClass(MI, TRI);
    if ReadGPR && !ReadOrWriteZA {
        return false;
    }
    return true;
}

fn isAppleSMEComputePair(FirstMI: *MachineInstr, SecondMI: *MachineInstr, TII: *TargetInstrInfo, TRI: *TargetRegisterInfo) -> bool {
    if !isFusableAppleSMEComputeOp(SecondMI, TII, TRI) {
        return false;
    }
    if FirstMI == null {
        return true;
    }
    if isFusableAppleSMEComputeOp(*FirstMI, TII, TRI) {
        return true;
    }
    return false;
}

