    return mayHaveWAWDependency(*FirstMI, SecondMI, TRI);
}

fn shouldScheduleAdjacent(TII: *TargetInstrInfo, TSI: *TargetSubtargetInfo, FirstMI: *MachineInstr, SecondMI: *MachineInstr, Dep: *SDep) -> bool {
    let mut ST: *AArch64Subtarget = null;
    let mut TRI: *TargetRegisterInfo = TSI.getRegisterInfo();
    if ST()() && isAppleSMEComputePair(FirstMI, SecondMI, TII, TRI) {
        operator(NumFusedAppleSMECompute);
        return true;
    }
    if isNonDataDep(Dep) {
        return false;
    }
    if ST()() || ST()() {
        let mut CmpOnly: bool = operator!(ST()());
        if isArithmeticBccPair(FirstMI, SecondMI, CmpOnly) {
            operator(NumFusedArithmeticBcc);
            return true;
        }
    }
    if ST()() && isArithmeticCbzPair(FirstMI, SecondMI) {
        operator(NumFusedArithmeticCbz);
        return true;
    }
    if ST()() && isAESPair(FirstMI, SecondMI, TRI) {
        operator(NumFusedAES);
        return true;
    }
    if ST()() && isCryptoEORPair(FirstMI, SecondMI) {
        operator(NumFusedCryptoEOR);
        return true;
    }
    if ST()() && isAdrpAddPair(FirstMI, SecondMI) {
        operator(NumFusedAdrpAdd);
        return true;
    }
    if ST()() && ST.fusesMOVImmPair(FirstMI, SecondMI) {
        operator(NumFusedLiterals);
        return true;
    }
    if ST()() && isAddressLdStPair(FirstMI, SecondMI) {
        operator(NumFusedAddress);
        return true;
    }
    if ST()() && isCmpCSelPair(FirstMI, SecondMI) {
        operator(NumFusedCmpCSel);
        return true;
    }
    if ST()() && isFCmpFCSelPair(FirstMI, SecondMI) {
        operator(NumFusedFCmpFCSel);
        return true;
    }
    if ST()() && isCmpCSetPair(FirstMI, SecondMI) {
        operator(NumFusedCmpCSet);
        return true;
    }
    if ST()() && isArithmeticLogicPair(FirstMI, SecondMI) {
        operator(NumFusedArithmeticLogic);
        return true;
    }
    if ST()() && isAddSub2RegAndConstOnePair(FirstMI, SecondMI) {
        operator(NumFusedAddSub2RegAndConstOne);
        return true;
    }
    if ST()() && isFMinFMaxPair(FirstMI, SecondMI, TRI) {
        operator(NumFusedFMinFMax);
        return true;
    }
    return false;
}

fn createAArch64MacroFusionDAGMutation() -> i32 {
    return createMacroFusionDAGMutation(shouldScheduleAdjacent);
}

struct Closure_1 {
    MI: *mut MachineInstr,
    TRI: *TargetRegisterInfo,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Reg: MCPhysReg) -> bool {
        return (*self.MI).definesRegister(Reg, self.TRI);
    }

struct Closure_2 {
    MI: *mut MachineInstr,
    TRI: *TargetRegisterInfo,
}

unsafe fn Closure_2::call(self: *mut Closure_2, Reg: MCPhysReg) -> bool {
        return (*self.MI).readsRegister(Reg, self.TRI);
    }
