fn mayHaveWAWDependency(FirstMI: *MachineInstr, SecondMI: *MachineInstr, TRI: *TargetRegisterInfo) -> bool {
    let mut DestFirst: Register = FirstMI.getOperand(0).getReg();
    let mut DestSecond: Register = SecondMI.getOperand(0).getReg();
    if !DestFirst.isPhysical() || !DestSecond.isPhysical() {
        return true;
    }
    return TRI.regsOverlap(DestFirst, DestSecond);
}

