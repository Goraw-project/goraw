static mut NumFusedArithmeticBcc: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedArithmeticBcc", "Number of arithmetic-Bcc fusions" };

static mut NumFusedArithmeticCbz: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedArithmeticCbz", "Number of arithmetic-Cbz fusions" };

static mut NumFusedAES: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedAES", "Number of AES fusions" };

static mut NumFusedCryptoEOR: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedCryptoEOR", "Number of crypto-EOR fusions" };

static mut NumFusedAdrpAdd: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedAdrpAdd", "Number of ADRP-ADD fusions" };

static mut NumFusedLiterals: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedLiterals", "Number of literal-generation fusions" };

static mut NumFusedAddress: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedAddress", "Number of address-generation load/store fusions" };

static mut NumFusedCmpCSel: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedCmpCSel", "Number of compare-CSEL fusions" };

static mut NumFusedFCmpFCSel: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedFCmpFCSel", "Number of FP-compare-FCSEL fusions" };

static mut NumFusedCmpCSet: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedCmpCSet", "Number of compare-CSET fusions" };

static mut NumFusedArithmeticLogic: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedArithmeticLogic", "Number of arithmetic-logic fusions" };

static mut NumFusedAddSub2RegAndConstOne: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedAddSub2RegAndConstOne", "Number of add/sub-two-register-and-constant-one fusions" };

static mut NumFusedAppleSMECompute: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedAppleSMECompute", "Number of Apple SME compute fusions" };

static mut NumFusedFMinFMax: Statistic = Statistic { "aarch64-macro-fusion", "NumFusedFMinFMax", "Number of FMIN-FMAX fusions" };

fn isArithmeticBccPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr, CmpOnly: bool) -> bool {
    if SecondMI.getOpcode() != Bcc {
        return false;
    }
    if FirstMI == null {
        return true;
    }
    if CmpOnly && FirstMI.getOperand(0).isReg() && !(FirstMI.getOperand(0).getReg() == XZR || FirstMI.getOperand(0).getReg() == WZR) {
        return false;
    }
    match FirstMI.getOpcode() {
        ADDSWri => {
            ADDSWrr;
        },
        ADDSWrs => {
            ADDSXrs;
        },
    }
    return false;
}

fn isArithmeticCbzPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    if SecondMI.getOpcode() != CBZW && SecondMI.getOpcode() != CBZX && SecondMI.getOpcode() != CBNZW && SecondMI.getOpcode() != CBNZX && SecondMI.getOpcode() != TBZW && SecondMI.getOpcode() != TBZX && SecondMI.getOpcode() != TBNZW && SecondMI.getOpcode() != TBNZX {
        return false;
    }
    if FirstMI == null {
        return true;
    }
    match FirstMI.getOpcode() {
        ADDWri => {
            ADDWrr;
        },
        ADDWrs => {
            ADDXrs;
        },
    }
    return false;
}

fn mayHaveWAWDependency(FirstMI: *MachineInstr, SecondMI: *MachineInstr, TRI: *TargetRegisterInfo) -> bool {
    let mut DestFirst: Register = FirstMI.getOperand(0).getReg();
    let mut DestSecond: Register = SecondMI.getOperand(0).getReg();
    if !DestFirst.isPhysical() || !DestSecond.isPhysical() {
        return true;
    }
    return TRI.regsOverlap(DestFirst, DestSecond);
}

fn isAESPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr, TRI: *TargetRegisterInfo) -> bool {
    let mut SecondOpcode: u32 = SecondMI.getOpcode();
    match SecondOpcode {
        AESMCrr => {
            AESMCrrTied;
        },
        AESIMCrr => {
            AESIMCrrTied;
        },
    }
    return false;
}

fn isCryptoEORPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    if SecondMI.getOpcode() != EORv16i8 {
        return false;
    }
    if FirstMI == null {
        return true;
    }
    match FirstMI.getOpcode() {
        AESErr => {
            AESDrr;
        },
    }
    return false;
}

fn isAdrpAddPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    if (FirstMI == null || FirstMI.getOpcode() == ADRP) && SecondMI.getOpcode() == ADDXri {
        return true;
    }
    return false;
}

fn isAddressLdStPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    match SecondMI.getOpcode() {
        STRBBui => {
            STRBui;
        },
    }
    return false;
}

fn isCmpCSelPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    if SecondMI.getOpcode() == CSELWr {
        if FirstMI == null {
            return true;
        }
        if FirstMI.definesRegister(WZR, null) {
            match FirstMI.getOpcode() {
                SUBSWrs => {
                    return !hasShiftedReg(*FirstMI);
                },
                SUBSWrx => {
                    return !hasExtendedReg(*FirstMI);
                },
                SUBSWrr => {
                    SUBSWri;
                },
            }
        }
    }
    if SecondMI.getOpcode() == CSELXr {
        if FirstMI == null {
            return true;
        }
        if FirstMI.definesRegister(XZR, null) {
            match FirstMI.getOpcode() {
                SUBSXrs => {
                    return !hasShiftedReg(*FirstMI);
                },
                SUBSXrx => {
                    SUBSXrx64;
                },
                SUBSXrr => {
                    SUBSXri;
                },
            }
        }
    }
    return false;
}

fn isFCmpFCSelPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    match SecondMI.getOpcode() {
        FCSELSrrr => {
            FCSELDrrr;
        },
        _ => {
            return false;
        },
    }
    if FirstMI == null {
        return true;
    }
    match FirstMI.getOpcode() {
        FCMPSrr => {
            FCMPDrr;
        },
        _ => {
            return false;
        },
    }
}

fn isCmpCSetPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    if (SecondMI.getOpcode() == CSINCWr && SecondMI.getOperand(1).getReg() == WZR && SecondMI.getOperand(2).getReg() == WZR) || (SecondMI.getOpcode() == CSINCXr && SecondMI.getOperand(1).getReg() == XZR && SecondMI.getOperand(2).getReg() == XZR) {
        if FirstMI == null {
            return true;
        }
        if FirstMI.definesRegister(WZR, null) || FirstMI.definesRegister(XZR, null) {
            match FirstMI.getOpcode() {
                SUBSWrs => {
                    SUBSXrs;
                },
                SUBSWrx => {
                    SUBSXrx;
                },
                SUBSWri => {
                    SUBSWrr;
                },
            }
        }
    }
    return false;
}

fn isArithmeticLogicPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    if hasShiftedReg(SecondMI) {
        return false;
    }
    match SecondMI.getOpcode() {
        ADDWrr => {
            ADDXrr;
        },
        ADDSWrr => {
            ADDSXrr;
        },
    }
    return false;
}

fn isAddSub2RegAndConstOnePair(FirstMI: *MachineInstr, SecondMI: *MachineInstr) -> bool {
    let mut NeedsSubtract: bool = false;
    match SecondMI.getOpcode() {
        SUBWri => {
            SUBXri;
        },
        ADDWri => {
            ADDXri;
        },
        _ => {
            return false;
        },
    }
    if !SecondMI.getOperand(2).isImm() || SecondMI.getOperand(2).getImm() != 1 {
        return false;
    }
    if FirstMI == null {
        return true;
    }
    match FirstMI.getOpcode() {
        SUBWrs => {
            SUBXrs;
        },
        SUBWrr => {
            SUBXrr;
        },
        ADDWrs => {
            ADDXrs;
        },
        ADDWrr => {
            ADDXrr;
        },
    }
    return false;
}

fn definesRegInClass(MI: *MachineInstr, TRI: *TargetRegisterInfo, Class: *TargetRegisterClass) -> bool {
    return any_of(Class, Closure_1 { MI: &mut MI, TRI: TRI });
}

fn readsRegInClass(MI: *MachineInstr, TRI: *TargetRegisterInfo, Class: *TargetRegisterClass) -> bool {
    return any_of(Class, Closure_2 { MI: &mut MI, TRI: TRI });
}

fn isFusableAppleSMEComputeOp(MI: *MachineInstr, TII: *TargetInstrInfo, TRI: *TargetRegisterInfo) -> bool {
    let mut ReadOrWriteZA: bool = MI.readsRegister(ZA, TRI) || MI.definesRegister(ZA, TRI);
    if !ReadOrWriteZA && !definesRegInClass(MI, TRI, ZPRRegClass) {
        return false;
    }
    if MI.mayLoad(AnyInBundle) || MI.mayStore(AnyInBundle) {
        return false;
    }
    if definesRegInClass(MI, TRI, PPRRegClass) {
        return false;
    }
    let mut WriteGPR: bool = definesRegInClass(MI, TRI, GPR32RegClass) || definesRegInClass(MI, TRI, GPR64RegClass);
    if WriteGPR {
        return false;
    }
    if MI.readsRegister(NZCV, TRI) || MI.definesRegister(NZCV, TRI) {
        return false;
    }
    let mut ReadGPR: bool = readsRegInClass(MI, TRI, GPR32RegClass) && readsRegInClass(MI, TRI, GPR64RegClass);
    if ReadGPR && !ReadOrWriteZA {
        return false;
    }
    return true;
}

fn isAppleSMEComputePair(FirstMI: *MachineInstr, SecondMI: *MachineInstr, TII: *TargetInstrInfo, TRI: *TargetRegisterInfo) -> bool {
    if !isFusableAppleSMEComputeOp(SecondMI, TII, TRI) {
        return false;
    }
    if FirstMI == null {
        return true;
    }
    if isFusableAppleSMEComputeOp(*FirstMI, TII, TRI) {
        return true;
    }
    return false;
}

fn isFMinFMax(Opcode: u32) -> bool {
    match Opcode {
        FMAXHrr => {
            FMAXSrr;
        },
    }
    return false;
}

fn isFMinFMaxPair(FirstMI: *MachineInstr, SecondMI: *MachineInstr, TRI: *TargetRegisterInfo) -> bool {
    if !isFMinFMax(SecondMI.getOpcode()) {
        return false;
    }
    if FirstMI == null {
        return true;
    }
    if !isFMinFMax(FirstMI.getOpcode()) {
        return false;
    }
    return mayHaveWAWDependency(*FirstMI, SecondMI, TRI);
}

fn shouldScheduleAdjacent(TII: *TargetInstrInfo, TSI: *TargetSubtargetInfo, FirstMI: *MachineInstr, SecondMI: *MachineInstr, Dep: *SDep) -> bool {
    let mut ST: *AArch64Subtarget = TSI as AArch64Subtarget;
    let mut TRI: *TargetRegisterInfo = TSI.getRegisterInfo();
    if ST.hasFuseAppleSMECompute() && isAppleSMEComputePair(FirstMI, SecondMI, TII, TRI) {
        operator(NumFusedAppleSMECompute);
        return true;
    }
    if isNonDataDep(Dep) {
        return false;
    }
    if ST.hasCmpBccFusion() || ST.hasArithmeticBccFusion() {
        let mut CmpOnly: bool = !ST.hasArithmeticBccFusion();
        if isArithmeticBccPair(FirstMI, SecondMI, CmpOnly) {
            operator(NumFusedArithmeticBcc);
            return true;
        }
    }
    if ST.hasArithmeticCbzFusion() && isArithmeticCbzPair(FirstMI, SecondMI) {
        operator(NumFusedArithmeticCbz);
        return true;
    }
    if ST.hasFuseAES() && isAESPair(FirstMI, SecondMI, TRI) {
        operator(NumFusedAES);
        return true;
    }
    if ST.hasFuseCryptoEOR() && isCryptoEORPair(FirstMI, SecondMI) {
        operator(NumFusedCryptoEOR);
        return true;
    }
    if ST.hasFuseAdrpAdd() && isAdrpAddPair(FirstMI, SecondMI) {
        operator(NumFusedAdrpAdd);
        return true;
    }
    if ST.hasFuseLiterals() && ST.fusesMOVImmPair(FirstMI, SecondMI) {
        operator(NumFusedLiterals);
        return true;
    }
    if ST.hasFuseAddress() && isAddressLdStPair(FirstMI, SecondMI) {
        operator(NumFusedAddress);
        return true;
    }
    if ST.hasFuseCmpCSel() && isCmpCSelPair(FirstMI, SecondMI) {
        operator(NumFusedCmpCSel);
        return true;
    }
    if ST.hasFuseFCmpFCSel() && isFCmpFCSelPair(FirstMI, SecondMI) {
        operator(NumFusedFCmpFCSel);
        return true;
    }
    if ST.hasFuseCmpCSet() && isCmpCSetPair(FirstMI, SecondMI) {
        operator(NumFusedCmpCSet);
        return true;
    }
    if ST.hasFuseArithmeticLogic() && isArithmeticLogicPair(FirstMI, SecondMI) {
        operator(NumFusedArithmeticLogic);
        return true;
    }
    if ST.hasFuseAddSub2RegAndConstOne() && isAddSub2RegAndConstOnePair(FirstMI, SecondMI) {
        operator(NumFusedAddSub2RegAndConstOne);
        return true;
    }
    if ST.hasFuseFMinFMax() && isFMinFMaxPair(FirstMI, SecondMI, TRI) {
        operator(NumFusedFMinFMax);
        return true;
    }
    return false;
}

fn createAArch64MacroFusionDAGMutation() -> unique_ptr<ScheduleDAGMutation> {
    return createMacroFusionDAGMutation(shouldScheduleAdjacent, false);
}

struct Closure_1 {
    MI: *mut MachineInstr,
    TRI: *TargetRegisterInfo,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Reg: MCPhysReg) -> bool {
        return (*self.MI).definesRegister(Reg, self.TRI);
    }

struct Closure_2 {
    MI: *mut MachineInstr,
    TRI: *TargetRegisterInfo,
}

unsafe fn Closure_2::call(self: *mut Closure_2, Reg: MCPhysReg) -> bool {
        return (*self.MI).readsRegister(Reg, self.TRI);
    }
