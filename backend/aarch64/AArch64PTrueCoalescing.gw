static mut EnablePTrueCoalescing: opt<bool> = opt<bool> { "aarch64-enable-ptrue-coalescing", init(true), Hidden, "Enable coalescing of compatible AArch64 SVE PTRUE instructions" };

struct AArch64PTrueCoalescingImpl {
    TII: *AArch64InstrInfo,
    MRI: *mut MachineRegisterInfo,
    MDT: *mut MachineDominatorTree,
}

fn AArch64PTrueCoalescingImpl::createPredicateInfo(self: *AArch64PTrueCoalescingImpl, MI: *mut MachineInstr) -> optional<PredicateInfo> {
    if !isPTrueOpcode(MI.getOpcode()) || MI.getOperand(1).getImm() != 31 {
        return nullopt;
    }
    let mut Pred: Register = MI.getOperand(0).getReg();
    let mut SmallestUsedElementSize: u32 = self.getSmallestElementSizeInUse(Pred);
    let mut ElementSize: u32 = self.TII.getElementSizeForOpcode(MI.getOpcode());
    assert!(ElementSize != ElementSizeNone, "PTRUE missing element size!");
    if SmallestUsedElementSize == ElementSizeNone {
        return nullopt;
    }
    return PredicateInfo { &mut MI, ElementSize, SmallestUsedElementSize };
}

struct AArch64PTrueCoalescingLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64PTrueCoalescingLegacy::getPassName(self: *AArch64PTrueCoalescingLegacy) -> str {
    return "AArch64 PTRUE Coalescing";
}

fn AArch64PTrueCoalescingLegacy::getAnalysisUsage(self: *AArch64PTrueCoalescingLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU.addRequired();
    self.getAnalysisUsage(AU);
}

fn AArch64PTrueCoalescingLegacy::getPassKind(self: *AArch64PTrueCoalescingLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64PTrueCoalescingLegacy::getPassID(self: *AArch64PTrueCoalescingLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64PTrueCoalescingLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64PTrueCoalescingLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64PTrueCoalescingLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64PTrueCoalescingLegacy::getResolver(self: *AArch64PTrueCoalescingLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64PTrueCoalescingLegacy::getRequiredProperties(self: *AArch64PTrueCoalescingLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64PTrueCoalescingLegacy::getSetProperties(self: *AArch64PTrueCoalescingLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64PTrueCoalescingLegacy::getClearedProperties(self: *AArch64PTrueCoalescingLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn AArch64PTrueCoalescingImpl::getSmallestElementSizeInUse(self: *AArch64PTrueCoalescingImpl, Reg: Register) -> u32 {
    if !Reg.isVirtual() {
        return ElementSizeNone;
    }
    let mut SmallestElementSize: u32 = ElementSizeNone;
    for UseMO in self.MRI.use_nodbg_operands(Reg) {
        assert!(UseMO.getSubReg() == 0, "Unexpected SubReg!");
        let mut UseMI: *mut MachineInstr = UseMO.getParent();
        let mut ElementSize: u32 = self.TII.getElementSizeForOpcode(UseMI.getOpcode());
        if ElementSize == ElementSizeNone {
            return ElementSizeNone;
        }
        if SmallestElementSize == ElementSizeNone || SmallestElementSize > ElementSize {
            SmallestElementSize = ElementSize;
        }
    }
    return SmallestElementSize;
}

fn AArch64PTrueCoalescingImpl::tryCoalesce(self: *AArch64PTrueCoalescingImpl, DomPI: *mut PredicateInfo, CanPI: *mut PredicateInfo) -> bool {
    assert!(DomPI.isValid() && CanPI.isValid();
    let mut DomMI: *mut MachineInstr = DomPI.MI;
    let mut CanMI: *mut MachineInstr = CanPI.MI;
    if DomMI == CanMI || !self.MDT.dominates(DomMI, CanMI) {
        return false;
    }
    let mut MutateDomPTrue: bool = false;
    if if CanPI.ElementSize > CanPI.SmallestUsedElementSize { CanPI.ElementSize } else { CanPI.SmallestUsedElementSize } != if DomPI.ElementSize > CanPI.SmallestUsedElementSize { DomPI.ElementSize } else { CanPI.SmallestUsedElementSize } {
        if if CanPI.ElementSize > DomPI.SmallestUsedElementSize { CanPI.ElementSize } else { DomPI.SmallestUsedElementSize } != if DomPI.ElementSize > DomPI.SmallestUsedElementSize { DomPI.ElementSize } else { DomPI.SmallestUsedElementSize } {
            return false;
        }
        MutateDomPTrue = true;
    }
    let mut DomReg: Register = DomMI.getOperand(0).getReg();
    let mut CanReg: Register = CanMI.getOperand(0).getReg();
    if !self.MRI.constrainRegClass(DomReg, self.MRI.getRegClass(CanReg), 0) {
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ptrue-coalesce", 1) {
            dbgs() << "Coalescing PTRUE: " << CanMI;
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ptrue-coalesce", 1) {
            dbgs() << "            with: " << DomMI;
        }
    }
        if !(false) { break; }
    }
    if MutateDomPTrue {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ptrue-coalesce", 1) {
                dbgs() << "        updated: " << DomMI;
            }
        }
            if !(false) { break; }
        }
        DomMI.setDesc(self.TII.get(CanMI.getOpcode()));
        DomPI.ElementSize = CanPI.ElementSize;
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ptrue-coalesce", 1) {
                dbgs() << "             to: " << DomMI;
            }
        }
            if !(false) { break; }
        }
    }
    self.MRI.replaceRegWith(CanReg, DomReg);
    self.MRI.clearKillFlags(DomReg);
    CanMI.eraseFromParent();
    if CanPI.SmallestUsedElementSize < DomPI.SmallestUsedElementSize {
        DomPI.SmallestUsedElementSize = CanPI.SmallestUsedElementSize;
    }
    CanPI.invalidate();
    return true;
}

fn AArch64PTrueCoalescingImpl::run(self, MF: *mut MachineFunction) -> bool {
    if !EnablePTrueCoalescing || !MF.getSubtarget().isSVEorStreamingSVEAvailable() {
        return false;
    }
    self.TII = MF.getSubtarget().getInstrInfo() as *AArch64InstrInfo;
    self.MRI = &mut MF.getRegInfo();
    assert!(self.MRI.isSSA(), "Expected to be run on SSA form!");
    if !self.MRI.def_empty(VG) {
        return false;
    }
    let mut PIs: SmallVector<PredicateInfo, 8> = SmallVector<PredicateInfo, 8> {};
    for MBB in MF {
        for MI in MBB {
            if self.createPredicateInfo(MI) {
                PI;
            } else {
                PIs.push(operator(PI));
            }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ptrue-coalesce", 1) {
            dbgs() << "Coalescable PTRUE candidates: " << PIs.len << "\n";
        }
    }
        if !(false) { break; }
    }
    let mut Changed: bool = false;
    for DominantPI in PIs {
        if !DominantPI.isValid() {
            continue;
        }
        for CandidatePI in PIs {
            if !CandidatePI.isValid() {
                continue;
            }
            Changed |= self.tryCoalesce(DominantPI, CandidatePI);
        }
    }
    return Changed;
}

fn AArch64PTrueCoalescingLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    let mut MDT: *mut MachineDominatorTree = self.getAnalysis().getDomTree();
    return MDT.run(MF);
}

fn createAArch64PTrueCoalescingLegacyPass() -> *mut FunctionPass {
    return AArch64PTrueCoalescingLegacy {};
}

fn AArch64PTrueCoalescingPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut MDT: *mut MachineDominatorTree = MFAM.getResult(MF);
    let mut Changed: bool = MDT.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}
