struct AArch64BranchTargetsImpl {
    Subtarget: *AArch64Subtarget,
}

struct AArch64BranchTargetsLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64BranchTargetsLegacy::getPassName(self: *AArch64BranchTargetsLegacy) -> str {
    return "AArch64 Branch Targets";
}

fn AArch64BranchTargetsLegacy::getPassKind(self: *AArch64BranchTargetsLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64BranchTargetsLegacy::getPassID(self: *AArch64BranchTargetsLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64BranchTargetsLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64BranchTargetsLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64BranchTargetsLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64BranchTargetsLegacy::getResolver(self: *AArch64BranchTargetsLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64BranchTargetsLegacy::getRequiredProperties(self: *AArch64BranchTargetsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64BranchTargetsLegacy::getSetProperties(self: *AArch64BranchTargetsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64BranchTargetsLegacy::getClearedProperties(self: *AArch64BranchTargetsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn AArch64BranchTargetsLegacy::getAnalysisUsage(self: *AArch64BranchTargetsLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage(AU);
}

fn createAArch64BranchTargetsPass() -> *mut FunctionPass {
    return AArch64BranchTargetsLegacy {};
}

fn AArch64BranchTargetsLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return AArch64BranchTargetsImpl {}.run(MF);
}

fn AArch64BranchTargetsPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64BranchTargetsImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

fn AArch64BranchTargetsImpl::run(self, MF: *mut MachineFunction) -> bool {
    if !MF.getInfo().branchTargetEnforcement() {
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-branch-targets", 1) {
            dbgs() << "********** AArch64 Branch Targets  **********\n" << "********** Function: " << MF.getName() << 10;
        }
    }
        if !(false) { break; }
    }
    let mut F: *Function = MF.getFunction();
    self.Subtarget = &mut MF.getSubtarget();
    let mut JumpTableTargets: SmallPtrSet<MachineBasicBlock *, 8> = SmallPtrSet<MachineBasicBlock *, 8> {};
    if MF.getJumpTableInfo() {
        JTI;
    } else {
        for JTE in JTI.getJumpTables() {
            JumpTableTargets.insert_range(JTE.MBBs);
        }
    }
    let mut MadeChange: bool = false;
    let mut HasWinCFI: bool = MF.hasWinCFI();
    for MBB in MF {
        let mut CouldCall: bool = false;
        let mut CouldJump: bool = false;
        if &mut MBB == &mut operator(MF.begin()) && (!self.Subtarget.isTargetELF() || (F.hasAddressTaken(null, false, true, false, false, false) || !F.hasLocalLinkage())) {
            CouldCall = true;
        }
        if MBB.isMachineBlockAddressTaken() || MBB.isIRBlockAddressTaken() || JumpTableTargets.count(&mut MBB) {
            CouldJump = true;
        }
        if MBB.isEHPad() {
            if HasWinCFI && (MBB.isEHFuncletEntry() || MBB.isCleanupFuncletEntry()) {
                CouldCall = true;
            } else {
                CouldJump = true;
            }
        }
        if CouldCall || CouldJump {
            self.addBTI(MBB, CouldCall, CouldJump, HasWinCFI);
            MadeChange = true;
        }
    }
    return MadeChange;
}

fn AArch64BranchTargetsImpl::addBTI(self, MBB: *mut MachineBasicBlock, CouldCall: bool, CouldJump: bool, HasWinCFI: bool) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-branch-targets", 1) {
            dbgs() << "Adding BTI " << (if CouldJump { "j" } else { "" }) << (if CouldCall { "c" } else { "" }) << " to " << MBB.getName() << "\n";
        }
    }
        if !(false) { break; }
    }
    let mut HintNum: u32 = getBTIHintNum(CouldCall, CouldJump);
    let mut MBBI: iterator = MBB.begin();
    while MBBI != MBB.end() && operator(MBBI).isEHLabel() {
        operator(MBBI);
    }
    for ; MBBI != MBB.end() && (operator(MBBI).isMetaInstruction(IgnoreBundle) || operator(MBBI).getOpcode() == EMITBKEY); operator(MBBI) {
        
    }
    if MBBI != MBB.end() && ((HintNum & BTIMask) == BTIC) && (operator(MBBI).getOpcode() == PACIASP || operator(MBBI).getOpcode() == PACIBSP) {
        return;
    }
    let mut TII: *AArch64InstrInfo = self.Subtarget.getInstrInfo();
    let mut DL: DebugLoc = MBB.findDebugLoc(MBBI);
    let mut BTI: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(HINT)).addImm(HintNum).getInstr();
    if HasWinCFI && MBBI != MBB.end() && operator(MBBI).getFlag(FrameSetup) {
        let mut AfterBTI: MachineInstr> = next(BTI, 1);
        BuildMI(MBB, AfterBTI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_Nop));
    }
}
