struct AArch64CondBrTuning {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
    TII: *AArch64InstrInfo,
    TRI: *TargetRegisterInfo,
    MRI: *mut MachineRegisterInfo,
}

fn AArch64CondBrTuning::getPassName(self: *AArch64CondBrTuning) -> str {
    return "AArch64 Conditional Branch Tuning";
}

fn AArch64CondBrTuning::getPassKind(self: *AArch64CondBrTuning) -> PassKind {
    return self.Kind;
}

fn AArch64CondBrTuning::getPassID(self: *AArch64CondBrTuning) -> AnalysisID {
    return self.PassID;
}

fn AArch64CondBrTuning::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64CondBrTuning::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64CondBrTuning::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64CondBrTuning::getResolver(self: *AArch64CondBrTuning) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64CondBrTuning::getRequiredProperties(self: *AArch64CondBrTuning) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64CondBrTuning::getSetProperties(self: *AArch64CondBrTuning) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64CondBrTuning::getClearedProperties(self: *AArch64CondBrTuning) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn AArch64CondBrTuning::getAnalysisUsage(self: *AArch64CondBrTuning, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage(AU);
}

fn AArch64CondBrTuning::getOperandDef(self, MO: *MachineOperand) -> *mut MachineInstr {
    if !MO.getReg().isVirtual() {
        return null;
    }
    return self.MRI.getUniqueVRegDef(MO.getReg());
}

fn AArch64CondBrTuning::tryConvertToFlagSetting(self, MI: *mut MachineInstr, IsFlagSetting: bool, Is64Bit: bool) -> *mut MachineInstr {
    if any_of(MI.operands(), Closure_1 {}) {
        return null;
    }
    if IsFlagSetting {
        for MO in MI.implicit_operands() {
            if MO.isReg() && MO.isDead() && MO.getReg() == NZCV {
                MO.setIsDead(false);
            }
        }
        return &mut MI;
    }
    let mut NewOpc: u32 = self.TII.convertToFlagSettingOpc(MI.getOpcode());
    let mut NewDestReg: Register = MI.getOperand(0).getReg();
    if self.MRI.hasOneNonDBGUse(MI.getOperand(0).getReg()) {
        NewDestReg = if Is64Bit { XZR } else { WZR };
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc), NewDestReg);
    if MI.peekDebugInstrNum() != 0 {
        operator(MIB).setDebugInstrNum(MI.peekDebugInstrNum());
    }
    for MO in drop_begin(MI.operands(), 1) {
        MIB.add(MO);
    }
    return MIB.operator llvm::MachineInstr *();
}

fn AArch64CondBrTuning::convertToCondBr(self, MI: *mut MachineInstr) -> *mut MachineInstr {
    let mut CC: CondCode = zeroed();
    let mut TargetMBB: *mut MachineBasicBlock = self.TII.getBranchDestBlock(MI);
    match MI.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64CondBrTuning.cpp", 126);
        },
        CBZW => {
            CBZX;
        },
        CBNZW => {
            CBNZX;
        },
        TBZW => {
            TBZX;
        },
        TBNZW => {
            TBNZX;
        },
    }
    return BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Bcc)).addImm(CC).addMBB(TargetMBB, 0).operator llvm::MachineInstr *();
}

fn AArch64CondBrTuning::tryToTuneBranch(self, MI: *mut MachineInstr, DefMI: *mut MachineInstr) -> bool {
    if MI.getParent() != DefMI.getParent() {
        return false;
    }
    let mut IsFlagSetting: bool = true;
    let mut MIOpc: u32 = MI.getOpcode();
    let mut NewCmp: *mut MachineInstr = null;
    let mut NewBr: *mut MachineInstr = null;
    match DefMI.getOpcode() {
        _ => {
            return false;
        },
        ADDWri => {
            ADDWrr;
        },
        ADDSWri => {
            ADDSWrr;
        },
        ADDXri => {
            ADDXrr;
        },
        ADDSXri => {
            ADDSXrr;
        },
    }
    NewCmp as void;
    NewBr as void;
    assert!(NewCmp && NewBr, "Expected new instructions.");
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-cond-br-tuning", 1) {
            dbgs() << "  with instruction:\n    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-cond-br-tuning", 1) {
            NewCmp.print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-cond-br-tuning", 1) {
            dbgs() << "    ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-cond-br-tuning", 1) {
            NewBr.print(dbgs(), true, false, false, true, null);
        }
    }
        if !(false) { break; }
    }
    if !IsFlagSetting {
        DefMI.eraseFromParent();
    }
    MI.eraseFromParent();
    return true;
}

fn AArch64CondBrTuning::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-cond-br-tuning", 1) {
            dbgs() << "********** AArch64 Conditional Branch Tuning  **********\n" << "********** Function: " << MF.getName() << 10;
        }
    }
        if !(false) { break; }
    }
    self.TII = MF.getSubtarget().getInstrInfo() as *AArch64InstrInfo;
    self.TRI = MF.getSubtarget().getRegisterInfo();
    self.MRI = &mut MF.getRegInfo();
    let mut Changed: bool = false;
    for MBB in MF {
        let mut LocalChange: bool = false;
        for MI in MBB.terminators() {
            match MI.getOpcode() {
                _ => {
                    break;
                },
                CBZW => {
                    CBZX;
                },
            }
            if LocalChange {
                Changed = true;
                break;
            }
        }
    }
    return Changed;
}

fn createAArch64CondBrTuning() -> *mut FunctionPass {
    return AArch64CondBrTuning {};
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Op: *MachineOperand) -> bool {
        return Op.isFI();
    }
