static mut NumConditionsAdjusted: Statistic = Statistic { "aarch64-condopt", "NumConditionsAdjusted", "Number of conditions adjusted" };

struct CmpInfo {
    Imm: i32,
    Opc: u32,
    CC: CondCode,
}

struct AArch64ConditionOptimizerImpl {
    TII: *AArch64InstrInfo,
    TRI: *TargetRegisterInfo,
    DomTree: *mut MachineDominatorTree,
    MRI: *MachineRegisterInfo,
}

struct AArch64ConditionOptimizerLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64ConditionOptimizerLegacy::getPassName(self: *AArch64ConditionOptimizerLegacy) -> str {
    return "AArch64 Condition Optimizer";
}

fn AArch64ConditionOptimizerLegacy::getPassKind(self: *AArch64ConditionOptimizerLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64ConditionOptimizerLegacy::getPassID(self: *AArch64ConditionOptimizerLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64ConditionOptimizerLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64ConditionOptimizerLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64ConditionOptimizerLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64ConditionOptimizerLegacy::getResolver(self: *AArch64ConditionOptimizerLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64ConditionOptimizerLegacy::getRequiredProperties(self: *AArch64ConditionOptimizerLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64ConditionOptimizerLegacy::getSetProperties(self: *AArch64ConditionOptimizerLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64ConditionOptimizerLegacy::getClearedProperties(self: *AArch64ConditionOptimizerLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createAArch64ConditionOptimizerLegacyPass() -> *mut FunctionPass {
    return AArch64ConditionOptimizerLegacy {};
}

fn AArch64ConditionOptimizerLegacy::getAnalysisUsage(self: *AArch64ConditionOptimizerLegacy, AU: *mut AnalysisUsage) {
    AU.addRequired();
    AU.addPreserved();
    self.getAnalysisUsage(AU);
}

fn AArch64ConditionOptimizerImpl::canAdjustCmp(self, CmpMI: *mut MachineInstr) -> bool {
    let mut ShiftAmt: u32 = getShiftValue(CmpMI.getOperand(3).getImm());
    if !CmpMI.getOperand(2).isImm() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Immediate of cmp is symbolic, " << CmpMI << 10;
            }
        }
            if !(false) { break; }
        }
        return false;
    } else if CmpMI.getOperand(2).getImm() << ShiftAmt >= 4095 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Immediate of cmp may be out of range, " << CmpMI << 10;
            }
        }
            if !(false) { break; }
        }
        return false;
    } else if !self.MRI.use_nodbg_empty(CmpMI.getOperand(0).getReg()) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Destination of cmp is not dead, " << CmpMI << 10;
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    return true;
}

fn AArch64ConditionOptimizerImpl::registersMatch(self, FirstMI: *mut MachineInstr, SecondMI: *mut MachineInstr) -> bool {
    let mut FirstReg: Register = FirstMI.getOperand(1).getReg();
    let mut SecondReg: Register = SecondMI.getOperand(1).getReg();
    let mut FirstCmpReg: Register = if FirstReg.isVirtual() { self.TRI.lookThruCopyLike(FirstReg, self.MRI) } else { FirstReg };
    let mut SecondCmpReg: Register = if SecondReg.isVirtual() { self.TRI.lookThruCopyLike(SecondReg, self.MRI) } else { SecondReg };
    if FirstCmpReg != SecondCmpReg {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "CMPs compare different registers\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    return true;
}

fn AArch64ConditionOptimizerImpl::nzcvLivesOut(self, MBB: *mut MachineBasicBlock) -> bool {
    for SuccBB in MBB.successors() {
        if SuccBB.isLiveIn(NZCV, getAll()) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                    dbgs() << "NZCV live into successor " << printMBBReference(*SuccBB) << " from " << printMBBReference(*MBB) << 10;
                }
            }
                if !(false) { break; }
            }
            return true;
        }
    }
    return false;
}

fn isCmpInstruction(Opc: u32) -> bool {
    match Opc {
        SUBSWri => {
            SUBSXri;
        },
        _ => {
            return false;
        },
    }
}

fn AArch64ConditionOptimizerImpl::getBccTerminator(self, MBB: *mut MachineBasicBlock) -> *mut MachineInstr {
    let mut Term: iterator = MBB.getFirstTerminator();
    if Term == MBB.end() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "No terminator in " << printMBBReference(*MBB) << 10;
            }
        }
            if !(false) { break; }
        }
        return null;
    }
    if operator(Term).getOpcode() != Bcc {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Non-Bcc terminator in " << printMBBReference(*MBB) << ": " << operator(Term);
            }
        }
            if !(false) { break; }
        }
        return null;
    }
    return &mut operator(Term);
}

fn AArch64ConditionOptimizerImpl::findAdjustableCmp(self, CondMI: *mut MachineInstr) -> *mut MachineInstr {
    assert!(CondMI, "CondMI cannot be null");
    let mut MBB: *mut MachineBasicBlock = CondMI.getParent();
    for let mut B: iterator = MBB.begin();
let mut It: iterator = CondMI; It != B;  {
        It = prev_nodbg(It, B, true);
        let mut I: *mut MachineInstr = operator(It);
        assert!(!I.isTerminator(AnyInBundle), "Spurious terminator");
        if I.readsRegister(NZCV, null) {
            return null;
        }
        if isCmpInstruction(I.getOpcode()) {
            if !self.canAdjustCmp(I) {
                return null;
            }
            return &mut I;
        }
        if I.modifiesRegister(NZCV, null) {
            return null;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
            dbgs() << "Flags not defined in " << printMBBReference(*MBB) << 10;
        }
    }
        if !(false) { break; }
    }
    return null;
}

fn getComplementOpc(Opc: i32) -> i32 {
    match Opc {
        ADDSWri => {
            return SUBSWri;
        },
        ADDSXri => {
            return SUBSXri;
        },
        SUBSWri => {
            return ADDSWri;
        },
        SUBSXri => {
            return ADDSXri;
        },
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ConditionOptimizer.cpp", 310);
        },
    }
}

fn getAdjustedCmp(Cmp: CondCode) -> CondCode {
    match Cmp {
        GT => {
            return GE;
        },
        GE => {
            return GT;
        },
        LT => {
            return LE;
        },
        LE => {
            return LT;
        },
        HI => {
            return HS;
        },
        HS => {
            return HI;
        },
        LO => {
            return LS;
        },
        LS => {
            return LO;
        },
        _ => {
            llvm_unreachable_internal("Unexpected condition code", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ConditionOptimizer.cpp", 334);
        },
    }
}

fn AArch64ConditionOptimizerImpl::getAdjustedCmpInfo(self, CmpMI: *mut MachineInstr, Cmp: CondCode) -> CmpInfo {
    let mut Opc: u32 = CmpMI.getOpcode();
    let mut IsSigned: bool = Cmp == GT || Cmp == GE || Cmp == LT || Cmp == LE;
    let mut Negative: bool = (Opc == ADDSWri || Opc == ADDSXri);
    let mut Correction: i32 = if (Cmp == GT || Cmp == HI) { 1 } else { -1 };
    if Negative {
        Correction = -Correction;
    }
    let mut OldImm: i32 = CmpMI.getOperand(2).getImm() as i32;
    let mut NewImm: i32 = if OldImm + Correction < 0 { -OldImm + Correction } else { OldImm + Correction };
    if OldImm == 0 && Negative {
        return CmpInfo { Imm: OldImm, Opc: Opc, CC: Cmp };
    }
    if (OldImm == 1 && Negative && Correction == -1) || (OldImm == 0 && Correction == -1) {
        if !IsSigned {
            return CmpInfo { Imm: OldImm, Opc: Opc, CC: Cmp };
        }
        Opc = getComplementOpc(Opc);
    }
    return CmpInfo { Imm: NewImm, Opc: Opc, CC: getAdjustedCmp(Cmp) };
}

fn AArch64ConditionOptimizerImpl::updateCmpInstr(self, CmpMI: *mut MachineInstr, NewImm: i32, NewOpc: u32) {
    CmpMI.getOperand(2).setImm(NewImm);
    CmpMI.setDesc(self.TII.get(NewOpc));
}

fn AArch64ConditionOptimizerImpl::updateCondInstr(self, CondMI: *mut MachineInstr, NewCC: CondCode) {
    let mut CCOpIdx: i32 = findCondCodeUseOperandIdxForBranchOrSelect(*CondMI);
    assert!(CCOpIdx >= 0, "Unsupported conditional instruction");
    CondMI.getOperand(CCOpIdx).setImm(NewCC);
    operator(NumConditionsAdjusted);
}

fn AArch64ConditionOptimizerImpl::applyCmpAdjustment(self, Pair: *mut CmpCondPair, Info: *CmpInfo) {
    self.updateCmpInstr(Pair.CmpMI, Info.Imm, Info.Opc);
    self.updateCondInstr(Pair.CondMI, Info.CC);
    Pair.CC = Info.CC;
}

fn parseCondCode(Cond: ArrayRef<MachineOperand>) -> CondCode {
    assert!(!Cond.is_empty(), "Expected non-empty condition from analyzeBranch");
    if Cond[0].getImm() != -1 {
        assert!(Cond.len == 1, "Unknown Cond array format");
        return Cond[0].getImm() as i32 as CondCode;
    }
    return Invalid;
}

fn isGreaterThan(Cmp: CondCode) -> bool {
    return Cmp == GT || Cmp == HI;
}

fn isLessThan(Cmp: CondCode) -> bool {
    return Cmp == LT || Cmp == LO;
}

fn AArch64ConditionOptimizerImpl::tryOptimizePair(self, First: *mut CmpCondPair, Second: *mut CmpCondPair) -> bool {
    if !((isGreaterThan(First.CC) || isLessThan(First.CC)) && (isGreaterThan(Second.CC) || isLessThan(Second.CC))) {
        return false;
    }
    let mut FirstImmTrueValue: i32 = First.getImm();
    let mut SecondImmTrueValue: i32 = Second.getImm();
    if First.getOpc() == ADDSWri || First.getOpc() == ADDSXri {
        FirstImmTrueValue = -FirstImmTrueValue;
    }
    if Second.getOpc() == ADDSWri || Second.getOpc() == ADDSXri {
        SecondImmTrueValue = -SecondImmTrueValue;
    }
    let mut FirstAdj: CmpInfo = self.getAdjustedCmpInfo(First.CmpMI, First.CC);
    let mut SecondAdj: CmpInfo = self.getAdjustedCmpInfo(Second.CmpMI, Second.CC);
    if ((isGreaterThan(First.CC) && isLessThan(Second.CC)) || (isLessThan(First.CC) && isGreaterThan(Second.CC))) && if SecondImmTrueValue - FirstImmTrueValue < 0 { -SecondImmTrueValue - FirstImmTrueValue } else { SecondImmTrueValue - FirstImmTrueValue } == 2 {
        if FirstAdj.Imm != SecondAdj.Imm || FirstAdj.Opc != SecondAdj.Opc {
            return false;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Optimized (opposite): " << getCondCodeName(First.CC) << " #" << First.getImm() << ", " << getCondCodeName(Second.CC) << " #" << Second.getImm() << " -> " << getCondCodeName(FirstAdj.CC) << " #" << FirstAdj.Imm << ", " << getCondCodeName(SecondAdj.CC) << " #" << SecondAdj.Imm << 10;
            }
        }
            if !(false) { break; }
        }
        self.applyCmpAdjustment(First, FirstAdj);
        self.applyCmpAdjustment(Second, SecondAdj);
        return true;
    } else if ((isGreaterThan(First.CC) && isGreaterThan(Second.CC)) || (isLessThan(First.CC) && isLessThan(Second.CC))) && if SecondImmTrueValue - FirstImmTrueValue < 0 { -SecondImmTrueValue - FirstImmTrueValue } else { SecondImmTrueValue - FirstImmTrueValue } == 1 {
        let mut AdjustFirst: bool = (FirstImmTrueValue < SecondImmTrueValue);
        if isLessThan(First.CC) {
            AdjustFirst = !AdjustFirst;
        }
        let mut Target: *mut CmpCondPair = if AdjustFirst { Second } else { First };
        let mut ToChange: *mut CmpCondPair = if AdjustFirst { First } else { Second };
        let mut Adj: *mut CmpInfo = if AdjustFirst { FirstAdj } else { SecondAdj };
        if Adj.Imm != Target.getImm() || Adj.Opc != Target.getOpc() {
            return false;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Optimized (same-direction): " << getCondCodeName(ToChange.CC) << " #" << ToChange.getImm() << " -> " << getCondCodeName(Adj.CC) << " #" << Adj.Imm << 10;
            }
        }
            if !(false) { break; }
        }
        self.applyCmpAdjustment(ToChange, Adj);
        return true;
    }
    return false;
}

fn AArch64ConditionOptimizerImpl::commitPendingPair(self, PendingPair: *mut optional<CmpCondPair>, PairsByReg: *mut SmallDenseMap<Register, CmpCondPair>) -> bool {
    if !PendingPair {
        return false;
    }
    let mut Reg: Register = operator(PendingPair).CmpMI.getOperand(1).getReg();
    let mut Key: Register = if Reg.isVirtual() { self.TRI.lookThruCopyLike(Reg, self.MRI) } else { Reg };
    let mut MatchingPair: iterator = PairsByReg.find(Key);
    let mut Changed: bool = MatchingPair != PairsByReg.end() && self.tryOptimizePair(operator(MatchingPair).second, operator(PendingPair));
    PairsByReg[Key] = operator(PendingPair);
    PendingPair = nullopt;
    return Changed;
}

fn AArch64ConditionOptimizerImpl::optimizeIntraBlock(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut PairsByReg: SmallDenseMap<Register, CmpCondPair> = SmallDenseMap<Register, CmpCondPair> {};
    let mut PendingPair: optional<CmpCondPair> = optional<CmpCondPair> {};
    let mut ActiveCmp: *mut MachineInstr = null;
    let mut Changed: bool = false;
    for MI in MBB {
        if MI.isDebugInstr() {
            continue;
        }
        if isCmpInstruction(MI.getOpcode()) && self.canAdjustCmp(MI) {
            Changed |= self.commitPendingPair(PendingPair, PairsByReg);
            ActiveCmp = &mut MI;
            continue;
        }
        if MI.modifiesRegister(NZCV, null) {
            Changed |= self.commitPendingPair(PendingPair, PairsByReg);
            ActiveCmp = null;
            PairsByReg.clear();
            continue;
        }
        if findCondCodeUseOperandIdxForBranchOrSelect(MI) >= 0 && !MI.isBranch(AnyInBundle) {
            if PendingPair {
                PendingPair = nullopt;
                ActiveCmp = null;
            } else if ActiveCmp {
                let mut CCOpIdx: i32 = findCondCodeUseOperandIdxForBranchOrSelect(MI);
                assert!(CCOpIdx >= 0, "Unsupported conditional instruction");
                let mut CC: CondCode = MI.getOperand(CCOpIdx).getImm() as i32 as CondCode;
                PendingPair = CmpCondPair { ActiveCmp, &mut MI, CC };
            }
            continue;
        }
        if MI.readsRegister(NZCV, null) {
            ActiveCmp = null;
            PendingPair = nullopt;
            continue;
        }
    }
    if !self.nzcvLivesOut(&mut MBB) {
        Changed |= self.commitPendingPair(PendingPair, PairsByReg);
    }
    return Changed;
}

fn AArch64ConditionOptimizerImpl::findCondConsumer(self, MBB: *mut MachineBasicBlock) -> CondCode> {
    if self.getBccTerminator(MBB) {
        BrMI;
    } else {
        let mut CondOperands: SmallVector<MachineOperand, 4> = SmallVector<MachineOperand, 4> {};
        let mut TBBDest: *mut MachineBasicBlock = null;
        let mut FBBDest: *mut MachineBasicBlock = null;
        if self.TII.analyzeBranch(*MBB, TBBDest, FBBDest, CondOperands, false) {
            return CondCode> { null, Invalid };
        }
        let mut CC: CondCode = parseCondCode(CondOperands);
        if CC == Invalid {
            return CondCode> { null, Invalid };
        }
        return CondCode> { BrMI, CC };
    }
    let mut Found: *mut MachineInstr = null;
    let mut FoundCC: CondCode = Invalid;
    for MI in reverse(*MBB) {
        if MI.isTerminator(AnyInBundle) || MI.isDebugInstr() {
            continue;
        }
        if !Found {
            if MI.modifiesRegister(NZCV, null) {
                return CondCode> { null, Invalid };
            }
            let mut CCOpIdx: i32 = findCondCodeUseOperandIdxForBranchOrSelect(MI);
            if CCOpIdx >= 0 && !MI.isBranch(AnyInBundle) {
                Found = &mut MI;
                FoundCC = MI.getOperand(CCOpIdx).getImm() as i32 as CondCode;
                continue;
            }
            if MI.readsRegister(NZCV, null) {
                return CondCode> { null, Invalid };
            }
        } else {
            if MI.readsRegister(NZCV, null) {
                return CondCode> { null, Invalid };
            }
            if MI.modifiesRegister(NZCV, null) {
                if isCmpInstruction(MI.getOpcode()) {
                    break;
                }
                return CondCode> { null, Invalid };
            }
        }
    }
    return CondCode> { Found, FoundCC };
}

fn AArch64ConditionOptimizerImpl::optimizeCrossBlock(self, HBB: *mut MachineBasicBlock) -> bool {
    let mut HeadCondOperands: SmallVector<MachineOperand, 4> = SmallVector<MachineOperand, 4> {};
    let mut TBB: *mut MachineBasicBlock = null;
    let mut FBB: *mut MachineBasicBlock = null;
    if self.TII.analyzeBranch(HBB, TBB, FBB, HeadCondOperands, false) {
        return false;
    }
    if !TBB || TBB == &mut HBB {
        return false;
    }
    if !HeadCondMI {
        return false;
    }
    if !TrueCondMI {
        return false;
    }
    if self.nzcvLivesOut(&mut HBB) || self.nzcvLivesOut(TBB) {
        return false;
    }
    let mut HeadCmpMI: *mut MachineInstr = self.findAdjustableCmp(HeadCondMI);
    let mut TrueCmpMI: *mut MachineInstr = self.findAdjustableCmp(TrueCondMI);
    if !HeadCmpMI || !TrueCmpMI {
        return false;
    }
    if !self.registersMatch(HeadCmpMI, TrueCmpMI) {
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
            dbgs() << "Checking cross-block pair: " << getCondCodeName(HeadCondCode) << " #" << HeadCmpMI.getOperand(2).getImm() << ", " << getCondCodeName(TrueCondCode) << " #" << TrueCmpMI.getOperand(2).getImm() << 10;
        }
    }
        if !(false) { break; }
    }
    let mut Head: CmpCondPair = CmpCondPair { HeadCmpMI, HeadCondMI, HeadCondCode };
    let mut True: CmpCondPair = CmpCondPair { TrueCmpMI, TrueCondMI, TrueCondCode };
    return self.tryOptimizePair(Head, True);
}

fn AArch64ConditionOptimizerLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut MDT: *mut MachineDominatorTree = self.getAnalysis().getDomTree();
    return AArch64ConditionOptimizerImpl {}.run(MF, MDT);
}

fn AArch64ConditionOptimizerImpl::run(self, MF: *mut MachineFunction, MDT: *mut MachineDominatorTree) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
            dbgs() << "********** AArch64 Conditional Compares **********\n" << "********** Function: " << MF.getName() << 10;
        }
    }
        if !(false) { break; }
    }
    self.TII = MF.getSubtarget().getInstrInfo() as *AArch64InstrInfo;
    self.TRI = MF.getSubtarget().getRegisterInfo();
    self.DomTree = &mut MDT;
    self.MRI = &mut MF.getRegInfo();
    let mut Changed: bool = false;
    for I in depth_first(self.DomTree) {
        let mut HBB: *mut MachineBasicBlock = I.getBlock();
        Changed |= self.optimizeIntraBlock(*HBB);
        Changed |= self.optimizeCrossBlock(*HBB);
    }
    return Changed;
}

fn AArch64ConditionOptimizerPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut MDT: *mut Result = MFAM.getResult(MF);
    let mut Changed: bool = AArch64ConditionOptimizerImpl {}.run(MF, MDT);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}
