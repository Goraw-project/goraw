fn AArch64ConditionOptimizerImpl::canAdjustCmp(self, CmpMI: *mut MachineInstr) -> bool {
    let mut ShiftAmt: u32 = getShiftValue(CmpMI.getOperand(3).getImm());
    if !CmpMI.getOperand(2).isImm() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Immediate of cmp is symbolic, " << CmpMI << 10;
            }
        }
            if !(false) { break; }
        }
        return false;
    } else if CmpMI.getOperand(2).getImm() << ShiftAmt >= 4095 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Immediate of cmp may be out of range, " << CmpMI << 10;
            }
        }
            if !(false) { break; }
        }
        return false;
    } else if !self.MRI.use_nodbg_empty(CmpMI.getOperand(0).getReg()) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Destination of cmp is not dead, " << CmpMI << 10;
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    return true;
}

fn AArch64ConditionOptimizerImpl::registersMatch(self, FirstMI: *mut MachineInstr, SecondMI: *mut MachineInstr) -> bool {
    let mut FirstReg: Register = FirstMI.getOperand(1).getReg();
    let mut SecondReg: Register = SecondMI.getOperand(1).getReg();
    let mut FirstCmpReg: Register = if FirstReg.isVirtual() { self.TRI.lookThruCopyLike(FirstReg, self.MRI) } else { FirstReg };
    let mut SecondCmpReg: Register = if SecondReg.isVirtual() { self.TRI.lookThruCopyLike(SecondReg, self.MRI) } else { SecondReg };
    if FirstCmpReg != SecondCmpReg {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "CMPs compare different registers\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    return true;
}

fn AArch64ConditionOptimizerImpl::nzcvLivesOut(self, MBB: *mut MachineBasicBlock) -> bool {
    return false;
}

fn isCmpInstruction(Opc: u32) -> bool {
    match Opc {
        _ => {
            return false;
        },
    }
}

fn AArch64ConditionOptimizerImpl::getBccTerminator(self, MBB: *mut MachineBasicBlock) -> *mut MachineInstr {
    let mut Term: i32 = MBB()();
    if Term() == MBB()() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "No terminator in " << printMBBReference(*MBB) << 10;
            }
        }
            if !(false) { break; }
        }
        return null;
    }
    if  {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Non-Bcc terminator in " << printMBBReference(*MBB) << ": " << operator*();
            }
        }
            if !(false) { break; }
        }
        return null;
    }
    return operator&(operator*());
}

fn AArch64ConditionOptimizerImpl::findAdjustableCmp(self, CondMI: *mut MachineInstr) -> *mut MachineInstr {
    assert!(CondMI, "CondMI cannot be null");
    let mut MBB: *mut MachineBasicBlock = CondMI.getParent();
    for let mut B: i32 = MBB()(); ;  {
        let mut I: *mut MachineInstr = null;
        assert!(!I.isTerminator(AnyInBundle), "Spurious terminator");
        if I.readsRegister {
            return null;
        }
        if isCmpInstruction(I.getOpcode()) {
            if !self.canAdjustCmp(I) {
                return null;
            }
            return &mut I;
        }
        if I.modifiesRegister {
            return null;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
            dbgs() << "Flags not defined in " << printMBBReference(*MBB) << 10;
        }
    }
        if !(false) { break; }
    }
    return null;
}

fn getComplementOpc(Opc: i32) -> i32 {
    match Opc {
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "llvm\\lib\\Target\\AArch64\\AArch64ConditionOptimizer.cpp", 310);
        },
    }
}

fn getAdjustedCmp(Cmp: CondCode) -> CondCode {
    match Cmp {
        GT => {
            return GE;
        },
        GE => {
            return GT;
        },
        LT => {
            return LE;
        },
        LE => {
            return LT;
        },
        HI => {
            return HS;
        },
        HS => {
            return HI;
        },
        LO => {
            return LS;
        },
        LS => {
            return LO;
        },
        _ => {
            llvm_unreachable_internal("Unexpected condition code", "llvm\\lib\\Target\\AArch64\\AArch64ConditionOptimizer.cpp", 334);
        },
    }
}

fn AArch64ConditionOptimizerImpl::getAdjustedCmpInfo(self, CmpMI: *mut MachineInstr, Cmp: CondCode) -> CmpInfo {
    let mut Opc: u32 = CmpMI.getOpcode();
    let mut IsSigned: bool = Cmp == GT || Cmp == GE || Cmp == LT || Cmp == LE;
    let mut Negative: bool = false;
    let mut Correction: i32 = if (Cmp == GT || Cmp == HI) { 1 } else { -1 };
    if Negative {
        Correction = -Correction;
    }
    let mut OldImm: i32 = CmpMI.getOperand(2).getImm() as i32;
    let mut NewImm: i32 = if OldImm + Correction < 0 { -OldImm + Correction } else { OldImm + Correction };
    if OldImm == 0 && Negative {
        return CmpInfo { Imm: OldImm, Opc: Opc, CC: Cmp };
    }
    if (OldImm == 1 && Negative && Correction == -1) || (OldImm == 0 && Correction == -1) {
        if !IsSigned {
            return CmpInfo { Imm: OldImm, Opc: Opc, CC: Cmp };
        }
        Opc = getComplementOpc(Opc);
    }
    return CmpInfo { Imm: NewImm, Opc: Opc, CC: getAdjustedCmp(Cmp) };
}

fn AArch64ConditionOptimizerImpl::updateCmpInstr(self, CmpMI: *mut MachineInstr, NewImm: i32, NewOpc: u32) {
    CmpMI.getOperand(2).setImm(NewImm);
    CmpMI.setDesc(self.TII(NewOpc));
}

fn AArch64ConditionOptimizerImpl::updateCondInstr(self, CondMI: *mut MachineInstr, NewCC: CondCode) {
    let mut CCOpIdx: i32 = findCondCodeUseOperandIdxForBranchOrSelect(*CondMI);
    assert!(CCOpIdx >= 0, "Unsupported conditional instruction");
    CondMI.getOperand(CCOpIdx).setImm(NewCC);
    operator(NumConditionsAdjusted);
}

fn AArch64ConditionOptimizerImpl::applyCmpAdjustment(self, Pair: *mut CmpCondPair, Info: *CmpInfo) {
    self.updateCmpInstr(Pair.CmpMI, Info.Imm, Info.Opc);
    self.updateCondInstr(Pair.CondMI, Info.CC);
    Pair.CC = Info.CC;
}

fn parseCondCode(Cond: ArrayRef<MachineOperand>) -> CondCode {
    (((operator!(operator!((operator!() && "Expected non-empty condition from analyzeBranch")))) || (_wassert(L"!Cond.empty() && \"Expected non-empty condition from analyzeBranch\"", L"llvm\\lib\\Target\\AArch64\\AArch64ConditionOptimizer.cpp", (408) as u32) , 0)) as void);
    if Cond()[0]() != -1 {
        (((operator!(operator!((Cond()() == 1 && "Unknown Cond array format")))) || (_wassert(L"Cond.size() == 1 && \"Unknown Cond array format\"", L"llvm\\lib\\Target\\AArch64\\AArch64ConditionOptimizer.cpp", (411) as u32) , 0)) as void);
        return [0]() as i32 as CondCode;
    }
    return Invalid;
}

fn isGreaterThan(Cmp: CondCode) -> bool {
    return Cmp == GT || Cmp == HI;
}

fn isLessThan(Cmp: CondCode) -> bool {
    return Cmp == LT || Cmp == LO;
}

fn AArch64ConditionOptimizerImpl::tryOptimizePair(self, First: *mut CmpCondPair, Second: *mut CmpCondPair) -> bool {
    if !((isGreaterThan(First.CC) || isLessThan(First.CC)) && (isGreaterThan(Second.CC) || isLessThan(Second.CC))) {
        return false;
    }
    let mut FirstImmTrueValue: i32 = First.getImm();
    let mut SecondImmTrueValue: i32 = Second.getImm();
    if  {
        FirstImmTrueValue = -FirstImmTrueValue;
    }
    if  {
        SecondImmTrueValue = -SecondImmTrueValue;
    }
    let mut FirstAdj: CmpInfo = self.getAdjustedCmpInfo(First.CmpMI, First.CC);
    let mut SecondAdj: CmpInfo = self.getAdjustedCmpInfo(Second.CmpMI, Second.CC);
    if ((isGreaterThan(First.CC) && isLessThan(Second.CC)) || (isLessThan(First.CC) && isGreaterThan(Second.CC))) && if SecondImmTrueValue - FirstImmTrueValue < 0 { -SecondImmTrueValue - FirstImmTrueValue } else { SecondImmTrueValue - FirstImmTrueValue } == 2 {
        if FirstAdj.Imm != SecondAdj.Imm || FirstAdj.Opc != SecondAdj.Opc {
            return false;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Optimized (opposite): " << getCondCodeName(First.CC) << " #" << First.getImm() << ", " << getCondCodeName(Second.CC) << " #" << Second.getImm() << " -> " << getCondCodeName(FirstAdj.CC) << " #" << FirstAdj.Imm << ", " << getCondCodeName(SecondAdj.CC) << " #" << SecondAdj.Imm << 10;
            }
        }
            if !(false) { break; }
        }
        self.applyCmpAdjustment(First, FirstAdj);
        self.applyCmpAdjustment(Second, SecondAdj);
        return true;
    } else if ((isGreaterThan(First.CC) && isGreaterThan(Second.CC)) || (isLessThan(First.CC) && isLessThan(Second.CC))) && if SecondImmTrueValue - FirstImmTrueValue < 0 { -SecondImmTrueValue - FirstImmTrueValue } else { SecondImmTrueValue - FirstImmTrueValue } == 1 {
        let mut AdjustFirst: bool = (FirstImmTrueValue < SecondImmTrueValue);
        if isLessThan(First.CC) {
            AdjustFirst = !AdjustFirst;
        }
        let mut Target: *mut CmpCondPair = if AdjustFirst { Second } else { First };
        let mut ToChange: *mut CmpCondPair = if AdjustFirst { First } else { Second };
        let mut Adj: *mut CmpInfo = if AdjustFirst { FirstAdj } else { SecondAdj };
        if Adj.Imm != Target.getImm() || Adj.Opc != Target.getOpc() {
            return false;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
                dbgs() << "Optimized (same-direction): " << getCondCodeName(ToChange.CC) << " #" << ToChange.getImm() << " -> " << getCondCodeName(Adj.CC) << " #" << Adj.Imm << 10;
            }
        }
            if !(false) { break; }
        }
        self.applyCmpAdjustment(ToChange, Adj);
        return true;
    }
    return false;
}

fn AArch64ConditionOptimizerImpl::commitPendingPair(self, PendingPair: *mut optional<CmpCondPair>, PairsByReg: *mut i32) -> bool {
    if PendingPair() {
        return false;
    }
    let mut Reg: Register = zeroed();
    let mut Key: Register = if Reg.isVirtual() { self.TRI.lookThruCopyLike(Reg, self.MRI) } else { Reg };
    let mut MatchingPair: auto = (Key);
    let mut Changed: bool =  != () && self.tryOptimizePair(PendingPair());
    PairsByReg()[Key] = PendingPair();
    PendingPair(nullopt);
    return Changed;
}

fn AArch64ConditionOptimizerImpl::optimizeIntraBlock(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut PairsByReg: i32 = 0;
    let mut PendingPair: optional<CmpCondPair> = zeroed();
    let mut ActiveCmp: *mut MachineInstr = null;
    let mut Changed: bool = false;
    return Changed;
}

fn AArch64ConditionOptimizerImpl::findCondConsumer(self, MBB: *mut MachineBasicBlock) -> CondCode> {
    if self.getBccTerminator(MBB) {
        BrMI;
    } else {
        let mut CondOperands: SmallVector<MachineOperand, 4> = zeroed();
        let mut TBBDest: *mut MachineBasicBlock = null;
        let mut FBBDest: *mut MachineBasicBlock = null;
        if self.TII.analyzeBranch(*MBB, TBBDest, FBBDest) {
            return void { null, Invalid };
        }
        let mut CC: CondCode = parseCondCode();
        if CC == Invalid {
            return void { null, Invalid };
        }
        return void { BrMI, CC };
    }
    let mut Found: *mut MachineInstr = null;
    let mut FoundCC: CondCode = Invalid;
    return void { Found, FoundCC };
}

fn AArch64ConditionOptimizerImpl::optimizeCrossBlock(self, HBB: *mut MachineBasicBlock) -> bool {
    let mut HeadCondOperands: SmallVector<MachineOperand, 4> = zeroed();
    let mut TBB: *mut MachineBasicBlock = null;
    let mut FBB: *mut MachineBasicBlock = null;
    if self.TII.analyzeBranch(HBB, TBB, FBB) {
        return false;
    }
    if !TBB || TBB == &mut HBB {
        return false;
    }
    if operator!() {
        return false;
    }
    if operator!() {
        return false;
    }
    if self.nzcvLivesOut(&mut HBB) || self.nzcvLivesOut(TBB) {
        return false;
    }
    let mut HeadCmpMI: *mut MachineInstr = self.findAdjustableCmp();
    let mut TrueCmpMI: *mut MachineInstr = self.findAdjustableCmp();
    if !HeadCmpMI || !TrueCmpMI {
        return false;
    }
    if !self.registersMatch(HeadCmpMI, TrueCmpMI) {
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
            dbgs() << "Checking cross-block pair: " << getCondCodeName() << " #" << HeadCmpMI.getOperand(2).getImm() << ", " << getCondCodeName() << " #" << TrueCmpMI.getOperand(2).getImm() << 10;
        }
    }
        if !(false) { break; }
    }
    let mut Head: CmpCondPair = void { HeadCmpMI,  };
    let mut True: CmpCondPair = void { TrueCmpMI,  };
    return self.tryOptimizePair(Head, True);
}

fn AArch64ConditionOptimizerLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction {
        return false;
    }
    let mut MDT: *mut MachineDominatorTree = ();
    return AArch64ConditionOptimizerImpl {}.run(MF, MDT);
}

fn AArch64ConditionOptimizerImpl::run(self, MF: *mut MachineFunction, MDT: *mut MachineDominatorTree) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-condopt", 1) {
            dbgs() << "********** AArch64 Conditional Compares **********\n" << "********** Function: " << MF.getName() << 10;
        }
    }
        if !(false) { break; }
    }
    self.TRI = MF.getSubtarget().getRegisterInfo();
    self.DomTree = &mut MDT;
    self.MRI = &mut MF.getRegInfo();
    let mut Changed: bool = false;
    return Changed;
}

fn AArch64ConditionOptimizerPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut MDT: *mut auto = MFAM()(MF);
    let mut Changed: bool = AArch64ConditionOptimizerImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA;
    return PA;
}
