struct AArch64MIPeepholeOptImpl {
    TII: *AArch64InstrInfo,
    TRI: *AArch64RegisterInfo,
    MLI: *mut MachineLoopInfo,
    MRI: *mut MachineRegisterInfo,
}

struct AArch64MIPeepholeOptLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64MIPeepholeOptLegacy::getPassName(self: *AArch64MIPeepholeOptLegacy) -> str {
    return "AArch64 MI Peephole Optimization pass";
}

fn AArch64MIPeepholeOptLegacy::getAnalysisUsage(self: *AArch64MIPeepholeOptLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU.addRequired();
    self.getAnalysisUsage(AU);
}

fn AArch64MIPeepholeOptLegacy::getPassKind(self: *AArch64MIPeepholeOptLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64MIPeepholeOptLegacy::getPassID(self: *AArch64MIPeepholeOptLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64MIPeepholeOptLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64MIPeepholeOptLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64MIPeepholeOptLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64MIPeepholeOptLegacy::getResolver(self: *AArch64MIPeepholeOptLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64MIPeepholeOptLegacy::getRequiredProperties(self: *AArch64MIPeepholeOptLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64MIPeepholeOptLegacy::getSetProperties(self: *AArch64MIPeepholeOptLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64MIPeepholeOptLegacy::getClearedProperties(self: *AArch64MIPeepholeOptLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

