fn AArch64MIPeepholeOptImpl::checkMovImmInstr(self, MI: *mut MachineInstr, MovMI: *mut *mut MachineInstr, SubregToRegMI: *mut *mut MachineInstr) -> bool {
    let mut MBB: *mut MachineBasicBlock = MI.getParent();
    let mut L: *mut MachineLoop = self.MLI.getLoopFor(MBB);
    if L && !L.isLoopInvariant(MI, 0) {
        return false;
    }
    MovMI = self.MRI.getUniqueVRegDef(MI.getOperand(2).getReg());
    if !MovMI {
        return false;
    }
    SubregToRegMI = null;
    if MovMI.getOpcode() == SUBREG_TO_REG {
        SubregToRegMI = MovMI;
        MovMI = self.MRI.getUniqueVRegDef(MovMI.getOperand(1).getReg());
        if !MovMI {
            return false;
        }
    }
    if MovMI.getOpcode() != MOVi32imm && MovMI.getOpcode() != MOVi64imm {
        return false;
    }
    if !self.MRI.hasOneUse(MovMI.getOperand(0).getReg()) {
        return false;
    }
    if SubregToRegMI && !self.MRI.hasOneUse(SubregToRegMI.getOperand(0).getReg()) {
        return false;
    }
    return true;
}

fn AArch64MIPeepholeOptImpl::visitINSviGPR(self, MI: *mut MachineInstr, Opc: u32) -> bool {
    let mut SrcMI: *mut MachineInstr = self.MRI.getUniqueVRegDef(MI.getOperand(3).getReg());
    while true {
        if !SrcMI || SrcMI.getOpcode() != COPY {
            return false;
        }
        if !SrcMI.getOperand(1).getReg().isVirtual() {
            return false;
        }
        if self.MRI.getRegClass(SrcMI.getOperand(1).getReg()) == &mut FPR128RegClass {
            break;
        }
        SrcMI = self.MRI.getUniqueVRegDef(SrcMI.getOperand(1).getReg());
    }
    let mut DstReg: Register = MI.getOperand(0).getReg();
    let mut SrcReg: Register = SrcMI.getOperand(1).getReg();
    let mut INSvilaneMI: *mut MachineInstr = BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Opc), DstReg).add(MI.getOperand(1)).add(MI.getOperand(2)).addUse(SrcReg, getRegState(SrcMI.getOperand(1)), 0).addImm(0).operator llvm::MachineInstr *();
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-mi-peephole-opt", 1) {
            dbgs() << MI << "  replace by:\n: " << *INSvilaneMI << "\n";
        }
    }
        if !(false) { break; }
    }
    INSvilaneMI as void;
    MI.eraseFromParent();
    return true;
}

fn is64bitDefwithZeroHigh64bit(MI: *mut MachineInstr, MRI: *mut MachineRegisterInfo, TII: *AArch64InstrInfo) -> bool {
    if !MI.getOperand(0).isReg() || !MI.getOperand(0).isDef() {
        return false;
    }
    let mut RC: *TargetRegisterClass = MRI.getRegClass(MI.getOperand(0).getReg());
    if RC != &mut FPR64RegClass {
        return false;
    }
    if MI.getOpcode() == COPY {
        let mut SrcOp: *mut MachineOperand = MI.getOperand(1);
        if !SrcOp.isReg() {
            return false;
        }
        let mut SrcReg: Register = SrcOp.getReg();
        if SrcOp.getSubReg() {
            if !SrcReg.isVirtual() {
                return false;
            }
            let mut SrcDef: *mut MachineInstr = MRI.getUniqueVRegDef(SrcReg);
            if !SrcDef || SrcDef.getOpcode() <= GENERIC_OP_END || SrcDef.getDesc().isPseudo() || !SrcDef.mayLoad(AnyInBundle) {
                return false;
            }
            let mut RC: *TargetRegisterClass = MRI.getRegClass(SrcReg);
            return RC == &mut DDRegClass || RC == &mut DDDRegClass || RC == &mut DDDDRegClass;
        }
        let mut IsGPR64Like: Closure_1 = Closure_1 { SrcReg: &mut SrcReg, MRI: &mut MRI };
        if !IsGPR64Like.call() {
            return false;
        }
        assert!(TII, "Expected InstrInfo when materializing COPYs");
        let mut SrcMO: *mut MachineOperand = MI.getOperand(1);
        let mut SrcKill: bool = SrcMO.isKill();
        if SrcReg.isVirtual() {
            if MRI.getRegClass(SrcReg) != &mut GPR64RegClass {
                let mut NewSrc: Register = MRI.createVirtualRegister(&mut GPR64RegClass, "");
                BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(COPY), NewSrc).addReg(SrcReg, getKillRegState(SrcKill), 0);
                SrcReg = NewSrc;
                SrcKill = true;
            }
        } else if !GPR64RegClass.contains(SrcReg.operator MCRegister()) {
            return false;
        }
        SrcMO.setReg(SrcReg);
        SrcMO.setSubReg(0);
        SrcMO.setIsKill(SrcKill);
        MI.setDesc(TII.get(FMOVXDr));
        return true;
    }
    return MI.getOpcode() > GENERIC_OP_END;
}

fn AArch64MIPeepholeOptImpl::visitINSvi64lane(self, MI: *mut MachineInstr) -> bool {
    let mut Low64MI: *mut MachineInstr = self.MRI.getVRegDef(MI.getOperand(1).getReg());
    if !Low64MI || Low64MI.getOpcode() != INSERT_SUBREG {
        return false;
    }
    Low64MI = self.MRI.getUniqueVRegDef(Low64MI.getOperand(2).getReg());
    if !Low64MI || !is64bitDefwithZeroHigh64bit(Low64MI, self.MRI, self.TII) {
        return false;
    }
    let mut High64MI: *mut MachineInstr = self.MRI.getUniqueVRegDef(MI.getOperand(3).getReg());
    if !High64MI || High64MI.getOpcode() != INSERT_SUBREG {
        return false;
    }
    High64MI = self.MRI.getUniqueVRegDef(High64MI.getOperand(2).getReg());
    if High64MI && High64MI.getOpcode() == COPY {
        High64MI = self.MRI.getUniqueVRegDef(High64MI.getOperand(1).getReg());
    }
    if !High64MI || (High64MI.getOpcode() != MOVID && High64MI.getOpcode() != MOVIv2d_ns) {
        return false;
    }
    if High64MI.getOperand(1).getImm() != 0 {
        return false;
    }
    let mut OldDef: Register = MI.getOperand(0).getReg();
    let mut NewDef: Register = MI.getOperand(1).getReg();
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-mi-peephole-opt", 1) {
            dbgs() << "Removing: " << MI << "\n";
        }
    }
        if !(false) { break; }
    }
    self.MRI.constrainRegClass(NewDef, self.MRI.getRegClass(OldDef), 0);
    self.MRI.replaceRegWith(OldDef, NewDef);
    self.MRI.clearKillFlags(NewDef);
    MI.eraseFromParent();
    return true;
}

fn AArch64MIPeepholeOptImpl::visitFMOVDr(self, MI: *mut MachineInstr) -> bool {
    let mut Low64MI: *mut MachineInstr = self.MRI.getUniqueVRegDef(MI.getOperand(1).getReg());
    if !Low64MI || !is64bitDefwithZeroHigh64bit(Low64MI, self.MRI, self.TII) {
        return false;
    }
    let mut OldDef: Register = MI.getOperand(0).getReg();
    let mut NewDef: Register = MI.getOperand(1).getReg();
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-mi-peephole-opt", 1) {
            dbgs() << "Removing: " << MI << "\n";
        }
    }
        if !(false) { break; }
    }
    self.MRI.clearKillFlags(OldDef);
    self.MRI.clearKillFlags(NewDef);
    self.MRI.constrainRegClass(NewDef, self.MRI.getRegClass(OldDef), 0);
    self.MRI.replaceRegWith(OldDef, NewDef);
    MI.eraseFromParent();
    return true;
}

fn AArch64MIPeepholeOptImpl::visitUBFMXri(self, MI: *mut MachineInstr) -> bool {
    let mut Immr: i64 = MI.getOperand(2).getImm();
    let mut Imms: i64 = MI.getOperand(3).getImm();
    let mut IsLSR: bool = Imms == 31 && Immr <= Imms;
    let mut IsLSL: bool = Immr == Imms + 33;
    if !IsLSR && !IsLSL {
        return false;
    }
    if IsLSL {
        Immr -= 32;
    }
    let mut DstRC64: *TargetRegisterClass = self.TII.getRegClass(self.TII.get(MI.getOpcode()), 0);
    let mut DstRC32: *TargetRegisterClass = self.TRI.getSubRegisterClass(DstRC64, sub_32);
    assert!(DstRC32, "Destination register class of UBFMXri doesn't have a sub_32 subregister class");
    let mut SrcRC64: *TargetRegisterClass = self.TII.getRegClass(self.TII.get(MI.getOpcode()), 1);
    let mut SrcRC32: *TargetRegisterClass = self.TRI.getSubRegisterClass(SrcRC64, sub_32);
    assert!(SrcRC32, "Source register class of UBFMXri doesn't have a sub_32 subregister class");
    let mut DstReg64: Register = MI.getOperand(0).getReg();
    let mut DstReg32: Register = self.MRI.createVirtualRegister(DstRC32, "");
    let mut SrcReg64: Register = MI.getOperand(1).getReg();
    let mut SrcReg32: Register = self.MRI.createVirtualRegister(SrcRC32, "");
    BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(COPY), SrcReg32).addReg(SrcReg64, RegState {}, sub_32);
    BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(UBFMWri), DstReg32).addReg(SrcReg32, RegState {}, 0).addImm(Immr).addImm(Imms);
    BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SUBREG_TO_REG), DstReg64).addReg(DstReg32, RegState {}, 0).addImm(sub_32);
    MI.eraseFromParent();
    return true;
}

fn AArch64MIPeepholeOptImpl::visitCopy(self, MI: *mut MachineInstr) -> bool {
    let mut InputReg: Register = MI.getOperand(1).getReg();
    if MI.getOperand(1).getSubReg() != sub_32 || !self.MRI.hasOneNonDBGUse(InputReg) {
        return false;
    }
    let mut SrcMI: *mut MachineInstr = self.MRI.getUniqueVRegDef(InputReg);
    let mut DeadInstrs: SmallPtrSet<MachineInstr *, 4> = SmallPtrSet<MachineInstr *, 4> {};
    DeadInstrs.insert(SrcMI);
    while SrcMI && SrcMI.isFullCopy() && self.MRI.hasOneNonDBGUse(SrcMI.getOperand(1).getReg()) {
        SrcMI = self.MRI.getUniqueVRegDef(SrcMI.getOperand(1).getReg());
        DeadInstrs.insert(SrcMI);
    }
    if !SrcMI {
        return false;
    }
    let mut getSXTWSrcReg: Closure_2 = Closure_2 {};
    let mut getUXTWSrcReg: Closure_3 = Closure_3 { cap_0: self, DeadInstrs: &mut DeadInstrs };
    let mut SrcReg: Register = getSXTWSrcReg.call(SrcMI);
    if !SrcReg.operator unsigned int() {
        SrcReg = getUXTWSrcReg.call(SrcMI);
    }
    if !SrcReg.operator unsigned int() {
        return false;
    }
    self.MRI.constrainRegClass(SrcReg, self.MRI.getRegClass(InputReg), 0);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-mi-peephole-opt", 1) {
            dbgs() << "Optimizing: " << MI;
        }
    }
        if !(false) { break; }
    }
    MI.getOperand(1).setReg(SrcReg);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-mi-peephole-opt", 1) {
            dbgs() << "        to: " << MI;
        }
    }
        if !(false) { break; }
    }
    for DeadMI in DeadInstrs {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-mi-peephole-opt", 1) {
                dbgs() << "  Removing: " << *DeadMI;
            }
        }
            if !(false) { break; }
        }
        DeadMI.eraseFromParent();
    }
    return true;
}

fn AArch64MIPeepholeOptImpl::run(self, MF: *mut MachineFunction) -> bool {
    self.TII = MF.getSubtarget().getInstrInfo() as *AArch64InstrInfo;
    self.TRI = MF.getSubtarget().getRegisterInfo() as *AArch64RegisterInfo;
    self.MRI = &mut MF.getRegInfo();
    assert!(self.MRI.isSSA(), "Expected to be run on SSA form!");
    let mut Changed: bool = false;
    for MBB in MF {
        for MI in make_early_inc_range(MBB) {
            match MI.getOpcode() {
                _ => {
                    break;
                },
                INSERT_SUBREG => {
                    Changed |= self.visitINSERT(MI);
                },
                ANDWrr => {
                    Changed |= self.trySplitLogicalImm(ANDWri, MI, Intersect, 0);
                },
                ANDXrr => {
                    Changed |= self.trySplitLogicalImm(ANDXri, MI, Intersect, 0);
                },
                ANDSWrr => {
                    Changed |= self.trySplitLogicalImm(ANDWri, MI, Intersect, ANDSWri);
                },
                ANDSXrr => {
                    Changed |= self.trySplitLogicalImm(ANDXri, MI, Intersect, ANDSXri);
                },
                EORWrr => {
                    Changed |= self.trySplitLogicalImm(EORWri, MI, Disjoint, 0);
                },
                EORXrr => {
                    Changed |= self.trySplitLogicalImm(EORXri, MI, Disjoint, 0);
                },
                ORRWrr => {
                    Changed |= self.trySplitLogicalImm(ORRWri, MI, Disjoint, 0);
                },
                ORRXrr => {
                    Changed |= self.trySplitLogicalImm(ORRXri, MI, Disjoint, 0);
                },
                ORRWrs => {
                    Changed |= self.visitORR(MI);
                },
                ADDWrr => {
                    Changed |= self.visitADDSUB(ADDWri, SUBWri, MI);
                },
                SUBWrr => {
                    Changed |= self.visitADDSUB(SUBWri, ADDWri, MI);
                },
                ADDXrr => {
                    Changed |= self.visitADDSUB(ADDXri, SUBXri, MI);
                },
                SUBXrr => {
                    Changed |= self.visitADDSUB(SUBXri, ADDXri, MI);
                },
                ADDSWrr => {
                    Changed |= self.visitADDSSUBS(OpcodePair { ADDWri, ADDSWri }, OpcodePair { SUBWri, SUBSWri }, MI);
                },
                SUBSWrr => {
                    Changed |= self.visitADDSSUBS(OpcodePair { SUBWri, SUBSWri }, OpcodePair { ADDWri, ADDSWri }, MI);
                },
                ADDSXrr => {
                    Changed |= self.visitADDSSUBS(OpcodePair { ADDXri, ADDSXri }, OpcodePair { SUBXri, SUBSXri }, MI);
                },
                SUBSXrr => {
                    Changed |= self.visitADDSSUBS(OpcodePair { SUBXri, SUBSXri }, OpcodePair { ADDXri, ADDSXri }, MI);
                },
                CSELWr => {
                    CSELXr;
                },
                INSvi64gpr => {
                    Changed |= self.visitINSviGPR(MI, INSvi64lane);
                },
                INSvi32gpr => {
                    Changed |= self.visitINSviGPR(MI, INSvi32lane);
                },
                INSvi16gpr => {
                    Changed |= self.visitINSviGPR(MI, INSvi16lane);
                },
                INSvi8gpr => {
                    Changed |= self.visitINSviGPR(MI, INSvi8lane);
                },
                INSvi64lane => {
                    Changed |= self.visitINSvi64lane(MI);
                },
                FMOVDr => {
                    Changed |= self.visitFMOVDr(MI);
                },
                UBFMXri => {
                    Changed |= self.visitUBFMXri(MI);
                },
                COPY => {
                    Changed |= self.visitCopy(MI);
                },
            }
        }
    }
    return Changed;
}

fn AArch64MIPeepholeOptLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut MLI: *mut MachineLoopInfo = self.getAnalysis().getLI();
    return MLI.run(MF);
}

fn createAArch64MIPeepholeOptLegacyPass() -> *mut FunctionPass {
    return AArch64MIPeepholeOptLegacy {};
}

fn AArch64MIPeepholeOptPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut MLI: *mut MachineLoopInfo = MFAM.getResult(MF);
    let mut Changed: bool = MLI.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

struct Closure_1 {
    SrcReg: *mut Register,
    MRI: *mut *mut MachineRegisterInfo,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> auto {
            if (*self.SrcReg).isVirtual() {
                return GPR64allRegClass.hasSubClassEq((*self.MRI).getRegClass((*self.SrcReg)));
            }
            return GPR64allRegClass.contains((*self.SrcReg).operator MCRegister());
        }

struct Closure_2 {}

fn Closure_2::call(self: *mut Closure_2, SrcMI: *mut MachineInstr) -> auto {
        if SrcMI.getOpcode() != SBFMXri || SrcMI.getOperand(2).getImm() != 0 || SrcMI.getOperand(3).getImm() != 31 {
            return Register { Reg: 0 };
        }
        return SrcMI.getOperand(1).getReg();
    }

struct Closure_3 {
    cap_0: *mut AArch64MIPeepholeOptImpl,
    DeadInstrs: *mut SmallPtrSet<MachineInstr *, 4>,
}

unsafe fn Closure_3::call(self: *mut Closure_3, SrcMI: *mut MachineInstr) -> auto {
        if SrcMI.getOpcode() != SUBREG_TO_REG || SrcMI.getOperand(2).getImm() != sub_32 || !self.MRI.hasOneNonDBGUse(SrcMI.getOperand(1).getReg()) {
            return Register { Reg: 0 };
        }
        let mut Orr: *mut MachineInstr = self.MRI.getUniqueVRegDef(SrcMI.getOperand(1).getReg());
        if !Orr || Orr.getOpcode() != ORRWrr || Orr.getOperand(1).getReg() != WZR || !self.MRI.hasOneNonDBGUse(Orr.getOperand(2).getReg()) {
            return Register { Reg: 0 };
        }
        let mut Cpy: *mut MachineInstr = self.MRI.getUniqueVRegDef(Orr.getOperand(2).getReg());
        if !Cpy || Cpy.getOpcode() != COPY || Cpy.getOperand(1).getSubReg() != sub_32 {
            return Register { Reg: 0 };
        }
        (*self.DeadInstrs).insert(Orr);
        return Cpy.getOperand(1).getReg();
    }
