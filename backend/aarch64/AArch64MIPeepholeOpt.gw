fn AArch64MIPeepholeOptImpl::visitORR(self, MI: *mut MachineInstr) -> bool {
    if MI.getOperand(3).getImm() != 0 {
        return false;
    }
    if MI.getOperand(1).getReg() != WZR {
        return false;
    }
    if MI.getOperand(2).getSubReg() {
        return false;
    }
    let mut SrcMI: *mut MachineInstr = self.MRI.getUniqueVRegDef(MI.getOperand(2).getReg());
    if !SrcMI {
        return false;
    }
    if SrcMI.getOpcode() == COPY && SrcMI.getOperand(1).getReg().isVirtual() {
        let mut RC: *TargetRegisterClass = self.MRI.getRegClass(SrcMI.getOperand(1).getReg());
        if RC != &mut FPR32RegClass && ((RC != &mut FPR64RegClass && RC != &mut FPR128RegClass && RC != &mut ZPRRegClass) || SrcMI.getOperand(1).getSubReg() != ssub) {
            return false;
        }
        let mut CpySrc: Register = 0;
        if SrcMI.getOperand(1).getSubReg() == ssub {
            CpySrc = self.MRI.createVirtualRegister(&mut FPR32RegClass, "");
            BuildMI(*SrcMI.getParent(), SrcMI, MIMetadata { DL: SrcMI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(COPY), CpySrc).add(SrcMI.getOperand(1));
        } else {
            CpySrc = SrcMI.getOperand(1).getReg();
        }
        BuildMI(*SrcMI.getParent(), SrcMI, MIMetadata { DL: SrcMI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(FMOVSWr), SrcMI.getOperand(0).getReg()).addReg(CpySrc, RegState {}, 0);
        SrcMI.eraseFromParent();
    } else if SrcMI.getOpcode() <= GENERIC_OP_END {
        return false;
    }
    let mut DefReg: Register = MI.getOperand(0).getReg();
    let mut SrcReg: Register = MI.getOperand(2).getReg();
    self.MRI.replaceRegWith(DefReg, SrcReg);
    self.MRI.clearKillFlags(SrcReg);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-mi-peephole-opt", 1) {
            dbgs() << "Removed: " << MI << "\n";
        }
    }
        if !(false) { break; }
    }
    MI.eraseFromParent();
    return true;
}

fn AArch64MIPeepholeOptImpl::visitCSEL(self, MI: *mut MachineInstr) -> bool {
    if MI.getOperand(1).getReg() != MI.getOperand(2).getReg() {
        return false;
    }
    let mut ZeroReg: (unnamed enum at P:\llvm-build\lib\Target\AArch64\AArch64GenRegisterInfoEnums.inc:15:1) = if MI.getOpcode() == CSELXr { XZR } else { WZR };
    let mut OrOpcode: (unnamed enum at P:\llvm-build\lib\Target\AArch64\AArch64GenInstrInfo.inc:14:3) = if MI.getOpcode() == CSELXr { ORRXrs } else { ORRWrs };
    BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(OrOpcode)).addReg(MI.getOperand(0).getReg(), Define, 0).addReg(ZeroReg, RegState {}, 0).addReg(MI.getOperand(1).getReg(), RegState {}, 0).addImm(0);
    MI.eraseFromParent();
    return true;
}

fn AArch64MIPeepholeOptImpl::visitINSERT(self, MI: *mut MachineInstr) -> bool {
    if !MI.isRegTiedToDefOperand(1, null) {
        return false;
    }
    let mut DstReg: Register = MI.getOperand(0).getReg();
    let mut RC: *TargetRegisterClass = self.MRI.getRegClass(DstReg);
    let mut SrcMI: *mut MachineInstr = self.MRI.getUniqueVRegDef(MI.getOperand(2).getReg());
    if !SrcMI {
        return false;
    }
    if (SrcMI.getOpcode() <= GENERIC_OP_END) || !GPR64allRegClass.hasSubClassEq(RC) {
        return false;
    }
    let mut SubregMI: *mut MachineInstr = BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SUBREG_TO_REG), DstReg).add(MI.getOperand(2)).add(MI.getOperand(3)).operator llvm::MachineInstr *();
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-mi-peephole-opt", 1) {
            dbgs() << MI << "  replace by:\n: " << *SubregMI << "\n";
        }
    }
        if !(false) { break; }
    }
    SubregMI as void;
    MI.eraseFromParent();
    return true;
}

