fn AArch64TTIImpl::getFP16BF16PromoteCost(self: *AArch64TTIImpl, Ty: *mut Type, CostKind: TargetCostKind, Op1Info: OperandValueInfo, Op2Info: OperandValueInfo, IncludeTrunc: bool, CanUseSVE: bool, InstCost: function<InstructionCost (Type *)>) -> optional<InstructionCost> {
