fn AArch64TTIImpl::getVectorInstrCostHelper(self: *AArch64TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Index: u32, I: *Instruction, Scalar: *mut Value, ScalarUserAndIdx: tuple<Value *, User *, int>>, VIC: VectorInstrContext) -> InstructionCost {
    assert!(Ty.isVectorTy(), "This must be a vector type");
    if Index != -1 {
        let mut LT: pair<InstructionCost, MVT> = zeroed();
        if operator!() {
            return 0;
        }
        if LT()() {
            let mut Width: u32 = ();
            Index = Index % Width;
        }
        if Index == 0 && !Ty.getScalarType().isIntegerTy() {
            return 0;
        }
        if self.ST.useSVEForFixedLengthVectors() {
            let mut Cost: InstructionCost = if CostKind == TCK_CodeSize { 1 } else { self.ST.getVectorInsertExtractBaseCost() };
            if Index * Ty.getScalarSizeInBits() < 128 {
                return Cost;
            }
            if Index * Ty.getScalarSizeInBits() < 512 && Opcode == ExtractElement {
                return if Ty.getScalarType().isIntegerTy() { Cost + 1 } else { Cost };
            }
            if Opcode == ExtractElement {
                return Cost + 2;
            }
            if Opcode == InsertElement {
                return Cost + 3;
            }
            llvm_unreachable_internal("unexpected opcode", "llvm\\lib\\Target\\AArch64\\AArch64TargetTransformInfo.cpp", 4697);
        }
        if VIC == Load {
            if self.ST() {
                return 0;
            }
            return if CostKind == TCK_CodeSize { 0 } else { self.ST.getVectorInsertExtractBaseCost() + 1 };
        }
        if Ty.getScalarSizeInBits() == 1 {
            return if CostKind == TCK_CodeSize { 2 } else { self.ST.getVectorInsertExtractBaseCost() + 1 };
        }
    }
    let mut ExtractCanFuseWithFmul: Closure_8 = Closure_8 { Index: &mut Index, cap_1: self, Ty: &mut Ty, Scalar: &mut Scalar, I: &mut I };
    if Opcode == ExtractElement && (I || Scalar) && ExtractCanFuseWithFmul() {
        return 0;
    }
    return if CostKind == TCK_CodeSize { 1 } else { self.ST.getVectorInsertExtractBaseCost() };
}

fn AArch64TTIImpl::getVectorInstrCost(self: *AArch64TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Index: u32, Op0: *Value, Op1: *Value, VIC: VectorInstrContext) -> InstructionCost {
