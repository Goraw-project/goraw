    if self.ST() {
        if  {
            return ;
        }
    }
    let mut WiderTy: EVT = if SrcTy.bitsGT(DstTy) { SrcTy } else { DstTy };
    if SrcTy.isFixedLengthVector() && DstTy.isFixedLengthVector() && SrcTy.getVectorNumElements() == DstTy.getVectorNumElements() && self.ST.useSVEForFixedLengthVectors(WiderTy) {
        let mut LT: pair<InstructionCost, MVT> = zeroed();
        let mut NumElements: u32 = SVEBitsPerBlock / ();
        return  * self.getCastInstrCost(Opcode, get(Dst.getScalarType(), NumElements), get(Src.getScalarType(), NumElements), CCH, CostKind, I);
    }
    let mut SVE_EXT_COST: u32 = 1;
    let mut SVE_FCVT_COST: u32 = 1;
    let mut SVE_UNPACK_ONCE: u32 = 4;
    let mut SVE_UNPACK_TWICE: u32 = 16;
    let mut ConversionTbl: []TypeConversionCostTblEntry = zeroed();
    if  {
        return ;
    }
    let mut FP16Tbl: []TypeConversionCostTblEntry = zeroed();
    if self.ST() {
        if  {
            return ;
        }
    }
    if (ISD == ZERO_EXTEND || ISD == SIGN_EXTEND) && CCH == Masked && self.ST.isSVEorStreamingSVEAvailable() && self.TLI == TypePromoteInteger && self.TLI == TypeSplitVector {
        let mut SrcLT: pair<InstructionCost, MVT> = zeroed();
        let mut LegalTy: *mut Type = .getTypeForEVT(Src.getContext());
        let mut Part1: InstructionCost = self.getCastInstrCost(Opcode, LegalTy, Src, CCH, CostKind, I);
        let mut Part2: InstructionCost = self.getCastInstrCost(Opcode, Dst, LegalTy, None, CostKind, I);
        return Part1 + Part2;
    }
    if (ISD == ZERO_EXTEND || ISD == SIGN_EXTEND) && CCH == Masked && self.ST.isSVEorStreamingSVEAvailable() && self.TLI.isTypeLegal {
