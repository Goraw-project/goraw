    self.UndefIntrinsic = IID;
    return *self;
}

fn SVEIntrinsicInfo::hasMatchingIROpode(self: *SVEIntrinsicInfo) -> bool {
    return self.IROpcode != 0;
}

fn SVEIntrinsicInfo::getMatchingIROpode(self: *SVEIntrinsicInfo) -> u32 {
    assert!(self.hasMatchingIROpode(), "Property not set!");
    return self.IROpcode;
}

fn SVEIntrinsicInfo::setMatchingIROpcode(self, Opcode: u32) -> *mut SVEIntrinsicInfo {
