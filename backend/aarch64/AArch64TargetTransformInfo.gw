fn AArch64TTIImpl::isLegalMaskedExpandLoad(self: *AArch64TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    if self.useNeonVector(DataTy) {
        return false;
    }
    return (self.ST.isSVEAvailable() && self.ST()) || (self.ST.isSVEorStreamingSVEAvailable() && self.ST());
}

fn AArch64TTIImpl::isLegalSpeculativeLoad(self: *AArch64TTIImpl, DataType: *mut Type, AddressSpace: u32) -> bool {
    if AddressSpace != 0 {
