fn constructSVEIntrinsicInfo(II: *mut IntrinsicInst) -> SVEIntrinsicInfo {
    if operator!(isa(II.getType)) && all_of(II()(), Closure_2 {}) {
        return SVEIntrinsicInfo {};
    }
    let mut IID: ID = II.getIntrinsicID();
    match IID {
        _ => {
            break;
        },
    }
    return SVEIntrinsicInfo {};
}

fn isAllActivePredicate(Pred: *mut Value) -> bool {
    let mut UncastedPred: *mut Value = null;
    if match(Pred) {
        let mut OrigPredTy: *mut auto = cast(Pred.getType());
        Pred = UncastedPred;
        if match(Pred) {
            if OrigPredTy()() <= cast(UncastedPred.getType())() {
                Pred = UncastedPred;
            }
        }
    }
    let mut C: *mut auto = dyn_cast(Pred);
    return  && ();
}

fn stripInactiveLanes(V: *mut Value, Pg: *Value) -> *mut Value {
    let mut Dup: *mut auto = dyn_cast(V);
    if  {
        return getSplat(cast(V.getType())(), cast((2)));
    }
    return V;
}

fn simplifySVEIntrinsicBinOp(IC: *mut InstCombiner, II: *mut IntrinsicInst, IInfo: *SVEIntrinsicInfo) -> optional<Instruction *> {
    let mut Opc: u32 = IInfo.getMatchingIROpode();
    assert!(isBinaryOp(Opc), "Expected a binary operation!");
    let mut Pg: *mut Value = II.getOperand;
    let mut Op1: *mut Value = II.getOperand;
    let mut Op2: *mut Value = II.getOperand;
    let mut DL: *DataLayout = II.getDataLayout;
    if isCommutative(Opc) && IInfo.inactiveLanesAreNotDefined() && isa(Op1) && !isa(Op2) {
        IC.replaceOperand;
        IC.replaceOperand;
        return &mut II;
    }
    Op1 = stripInactiveLanes(Op1, Pg);
    Op2 = stripInactiveLanes(Op2, Pg);
    let mut SimpleII: *mut Value = null;
    if  {
        SimpleII = simplifyBinOp(Opc, Op1, Op2, DL);
    } else {
        SimpleII = simplifyBinOp(Opc, Op1, Op2, DL);
    }
    let mut NarrowOp1: *mut Value = null;
    let mut NarrowOp2: *mut Value = null;
    if !SimpleII && match(Op1) && match(Op2) && NarrowOp1.getType() == NarrowOp2.getType() {
        let mut SimpleNarrow: *mut Value = simplifyBinOp(Opc, NarrowOp1, NarrowOp2, DL);
        if SimpleNarrow && !isa(SimpleNarrow) {
            if match(SimpleNarrow) {
                SimpleII = getNullValue(II.getType);
            } else if SimpleNarrow == NarrowOp1 {
                SimpleII = Op1;
            } else if SimpleNarrow == NarrowOp2 {
                SimpleII = Op2;
            } else {
                SimpleII = IC();
            }
        }
    }
    if !SimpleII || isa(SimpleII) {
        return nullopt();
    }
    if IInfo.inactiveLanesAreNotDefined() {
        return IC.replaceInstUsesWith;
    }
    let mut Inactive: *mut Value = if IInfo.resultIsZeroInitialized() { getNullValue(II.getType) } else { II.getOperand };
    if SimpleII == Inactive {
        return IC.replaceInstUsesWith;
    }
    SimpleII = IC()(Pg, SimpleII, Inactive);
    return IC.replaceInstUsesWith;
}

fn simplifySVEIntrinsicCompare(IC: *mut InstCombiner, II: *mut IntrinsicInst, IInfo: *SVEIntrinsicInfo) -> optional<Instruction *> {
    let mut Opc: u32 = IInfo.getMatchingIROpode();
    assert!((Opc == ICmp || Opc == FCmp), "Expected a compare operation!");
    let mut Pg: *mut Value = II.getOperand;
    let mut LHS: *mut Value = II.getOperand;
    let mut RHS: *mut Value = II.getOperand;
    let mut CmpPred: Predicate = IInfo.getCmpPredicate();
    let mut IsWideICmp: bool = Opc == ICmp && LHS.getType() != RHS.getType();
    assert!((IsWideICmp || LHS.getType() == RHS.getType()), "Unexpected wide compare!");
    if (isCommutative(CmpPred) || isCommutative(CmpPred)) && isa(LHS) && !isa(RHS) && !IsWideICmp {
        IC.replaceOperand;
        IC.replaceOperand;
        return &mut II;
    }
    LHS = stripInactiveLanes(LHS, Pg);
    RHS = stripInactiveLanes(RHS, Pg);
    if IsWideICmp {
        let mut LHSVal: *APInt = null;
        let mut RHSVal: *APInt = null;
        if operator!(match(LHS)) || operator!(match(RHS)) {
            return nullopt();
        }
        let mut WideVT: *mut Type = get(RHS.getType().getScalarType(), cast(LHS.getType()));
        if isUnsigned(CmpPred) {
            LHS = get(WideVT, LHSVal.getZExtValue(), false, false);
            RHS = get(WideVT, RHSVal.getZExtValue(), false, false);
        } else {
            LHS = get(WideVT, LHSVal.getSExtValue(), false, false);
            RHS = get(WideVT, RHSVal.getSExtValue(), false, false);
        }
    }
    let mut DL: *DataLayout = II.getDataLayout;
    let mut SimpleII: *mut Value = simplifyCmpInst(CmpPred, LHS, RHS, DL);
    if !SimpleII {
        return nullopt();
    }
    assert!(IInfo.resultIsZeroInitialized(), "Expected a zeroing operation!");
    if match(SimpleII) {
        return IC.replaceInstUsesWith;
    }
    SimpleII = IC()(Pg, SimpleII);
    return IC.replaceInstUsesWith;
}

fn simplifySVEIntrinsic(IC: *mut InstCombiner, II: *mut IntrinsicInst, IInfo: *SVEIntrinsicInfo) -> optional<Instruction *> {
    if !IInfo.hasGoverningPredicate() {
        return nullopt();
    }
    let mut OpPredicate: *mut auto = II.getOperand;
    if match() {
        if IInfo.inactiveLanesTakenFromOperand() {
            return IC.replaceInstUsesWith(II, II.getOperand);
        }
        if IInfo.inactiveLanesAreUnused() {
            if IInfo.resultIsZeroInitialized() {
                IC.replaceInstUsesWith(II, getNullValue(II.getType));
            }
            return IC.eraseInstFromFunction;
        }
    }
    if isAllActivePredicate() {
        if IInfo.hasOperandWithNoActiveLanes() {
            let mut OpIdx: u32 = IInfo.getOperandIdxWithNoActiveLanes();
            if operator!(isa(II.getOperand)) {
                return IC.replaceOperand(II, OpIdx, get(II.getType));
            }
        }
        if IInfo.hasMatchingUndefIntrinsic() {
            let mut NewDecl: *mut auto = getOrInsertDeclaration(II, IInfo.getMatchingUndefIntrinsic(), void { II.getType });
            II();
            return &mut II;
        }
    }
    if !IInfo.hasMatchingIROpode() {
        return nullopt();
    }
    let mut Opc: u32 = IInfo.getMatchingIROpode();
    return nullopt();
}

fn tryCombineFromSVBoolBinOp(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut m_ConvertToSVBool: Closure_3 = Closure_3 {};
    let mut ConvertFromSVBool: ID = zeroed();
    let mut Ty: *mut Type = II.getType;
    let mut LHS: *mut Value = null;
    let mut RHS: *mut Value = null;
    let mut NarrowLHS: *mut Value = null;
    let mut NarrowRHS: *mut Value = null;
    if match(II.getOperand) {
        NarrowLHS = IC()(ConvertFromSVBool, Ty, LHS);
        let mut NarrowAnd: *mut Value = IC()(NarrowLHS, NarrowRHS);
        return IC.replaceInstUsesWith;
    }
    if match(II.getOperand) {
        NarrowRHS = IC()(ConvertFromSVBool, Ty, RHS);
        let mut NarrowAnd: *mut Value = IC()(NarrowLHS, NarrowRHS);
        return IC.replaceInstUsesWith;
    }
    let mut BinOp: auto = dyn_cast(II.getOperand);
    if operator!() {
        return nullopt();
    }
    let mut BinOpIID: ID = ();
    match BinOpIID {
        _ => {
            return nullopt();
        },
    }
    let mut BinOpPred: *mut Value = (0);
    let mut BinOpOp1: *mut Value = (1);
    let mut BinOpOp2: *mut Value = (2);
    let mut NarrowBinOpPred: *mut Value = null;
    if operator!(match(BinOpPred, m_ConvertToSVBool(m_SpecificType(Ty, NarrowBinOpPred)))) {
        return nullopt();
    }
    let mut NarrowBinOpOp1: *mut Value = IC()(ConvertFromSVBool, Ty, BinOpOp1);
    let mut NarrowBinOpOp2: *mut Value = NarrowBinOpOp1;
    if BinOpOp1 != BinOpOp2 {
        NarrowBinOpOp2 = IC()(ConvertFromSVBool, Ty, BinOpOp2);
    }
    let mut NarrowedBinOp: *mut Value = IC()(BinOpIID, Ty, void { NarrowBinOpPred, NarrowBinOpOp1, NarrowBinOpOp2 });
    return IC.replaceInstUsesWith;
}

fn instCombineConvertFromSVBool(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if  {
        return ;
    }
    if isa(II.getArgOperand()) || isa(II.getType) {
        return nullopt();
