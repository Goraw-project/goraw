fn instCombineSVECntElts(IC: *mut InstCombiner, II: *mut IntrinsicInst, NumElts: u32) -> optional<Instruction *> {
    let mut Pattern: auto = cast(II.getArgOperand)();
    if  {
        let mut Cnt: *mut Value = IC()(II.getType, (NumElts));
        Cnt.takeName;
        return IC.replaceInstUsesWith;
    }
    let mut MinNumElts: u32 = getNumElementsFromSVEPredPattern();
    return MinNumElts && NumElts >= MinNumElts;
}

