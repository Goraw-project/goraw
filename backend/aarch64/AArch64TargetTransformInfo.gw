fn instCombineSVESDIV(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Int32Ty: *mut Type = IC()();
    let mut Pred: *mut Value = II.getOperand;
    let mut Vec: *mut Value = II.getOperand;
    let mut DivVec: *mut Value = II.getOperand;
    let mut SplatValue: *mut Value = getSplatValue(DivVec);
    let mut SplatConstantInt: *mut ConstantInt = dyn_cast_or_null(SplatValue);
    if !SplatConstantInt {
        return nullopt();
    }
    let mut Divisor: APInt = SplatConstantInt.getValue();
    let mut DivisorValue: i64 = Divisor.getSExtValue();
    if DivisorValue == -1 {
        return nullopt();
    }
    if DivisorValue == 1 {
        IC.replaceInstUsesWith;
    }
    if Divisor.isPowerOf2() {
        let mut DivisorLog2: *mut Constant = get(Int32Ty, Divisor.logBase2(), false, false);
        let mut ASRD: auto = IC();
        return IC.replaceInstUsesWith(II);
    }
    if Divisor.isNegatedPowerOf2() {
        Divisor.negate();
        let mut DivisorLog2: *mut Constant = get(Int32Ty, Divisor.logBase2(), false, false);
        let mut ASRD: auto = IC();
        let mut NEG: auto = IC();
        return IC.replaceInstUsesWith(II);
    }
    return nullopt();
}

fn SimplifyValuePattern(Vec: *mut i32, AllowPoison: bool) -> bool {
    let mut VecSize: u64 = ();
    if VecSize == 1 {
        return true;
    }
    if !isPowerOf2_64(VecSize) {
        return false;
    }
    let mut HalfVecSize: u64 = VecSize / 2;
    for let mut LHS: auto = ();
let mut RHS: auto = () + HalfVecSize; RHS() != ();  += 1 , RHS() += 1 {
        if operator*() != null && operator*() != null {
            if operator*() == operator*() {
                continue;
            } else {
                return false;
            }
        }
        if !AllowPoison {
            return false;
        }
        if operator*() == null && operator*() != null {
            operator*() = operator*();
        }
    }
    Vec()(HalfVecSize);
    SimplifyValuePattern(AllowPoison);
    return true;
}

fn instCombineSVEDupqLane(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut CurrentInsertElt: *mut Value = null;
    let mut Default: *mut Value = null;
    if operator!(match(II.getOperand, m_Intrinsic(m_Value(Default), m_Value(CurrentInsertElt), m_Value()))) || !isa(CurrentInsertElt.getType()) {
        return nullopt();
    }
    let mut IIScalableTy: auto = cast(II.getType);
    let mut Elts: i32 = IIScalableTy()();
    while  {
        let mut Idx: auto = cast((2));
        Elts()[()()] = (1);
        CurrentInsertElt = (0);
    }
    let mut AllowPoison: bool = isa(CurrentInsertElt) && isa(Default);
    if  {
        return nullopt();
    }
    let mut InsertEltChain: *mut Value = get(CurrentInsertElt.getType());
    for let mut I: u64 = 0; I < Elts()(); I += 1 {
        if Elts()[I] == null {
            continue;
        }
        InsertEltChain = IC()(InsertEltChain, [I], IC()(I));
    }
    if InsertEltChain == null {
        return nullopt();
    }
    let mut PatternWidth: u32 = () * ();
    let mut PatternElementCount: u32 = () * () / PatternWidth;
    let mut WideTy: *mut IntegerType = IC()(PatternWidth);
    let mut WideScalableTy: *mut auto = get(WideTy, PatternElementCount);
    let mut WideShuffleMaskTy: *mut auto = get(IC()(), PatternElementCount);
    let mut InsertSubvector: auto = IC()(II.getType, get(II.getType), InsertEltChain, 0);
    let mut WideBitcast: auto = IC()();
    let mut WideShuffleMask: auto = get();
    let mut WideShuffle: auto = IC()(get());
    let mut NarrowBitcast: auto = IC()(II.getType);
    return IC.replaceInstUsesWith(II);
}

