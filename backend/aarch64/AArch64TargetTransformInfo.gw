fn instCombineSVELD1(IC: *mut InstCombiner, II: *mut IntrinsicInst, DL: *DataLayout) -> optional<Instruction *> {
    let mut Pred: *mut Value = II.getOperand;
    let mut PtrOp: *mut Value = II.getOperand;
    let mut VecTy: *mut Type = II.getType;
    if isAllActivePredicate(Pred) {
        let mut Load: *mut LoadInst = IC()(VecTy, PtrOp);
        Load.copyMetadata;
        return IC.replaceInstUsesWith;
    }
    let mut MaskedLoad: *mut CallInst = IC()(VecTy, PtrOp, PtrOp.getPointerAlignment(DL), Pred, get(VecTy));
    MaskedLoad.copyMetadata;
    return IC.replaceInstUsesWith;
}

fn instCombineSVEST1(IC: *mut InstCombiner, II: *mut IntrinsicInst, DL: *DataLayout) -> optional<Instruction *> {
    let mut VecOp: *mut Value = II.getOperand;
    let mut Pred: *mut Value = II.getOperand;
    let mut PtrOp: *mut Value = II.getOperand;
    if isAllActivePredicate(Pred) {
        let mut Store: *mut StoreInst = IC()(VecOp, PtrOp);
        Store.copyMetadata;
        return IC.eraseInstFromFunction;
    }
    let mut MaskedStore: *mut CallInst = IC()(VecOp, PtrOp, PtrOp.getPointerAlignment(DL), Pred);
    MaskedStore.copyMetadata;
    return IC.eraseInstFromFunction;
}

