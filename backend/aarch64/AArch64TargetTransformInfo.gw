}

fn AArch64TTIImpl::getExtractWithExtendCost(self: *AArch64TTIImpl, Opcode: u32, Dst: *mut Type, VecTy: *mut VectorType, Index: u32, CostKind: TargetCostKind) -> InstructionCost {
    assert!((Opcode == SExt || Opcode == ZExt), "Invalid opcode");
    let mut Src: *mut Type = VecTy.getElementType();
    assert!(isa(Dst) && isa(Src), "Invalid type");
    let mut Cost: InstructionCost = self.getVectorInstrCost(ExtractElement, VecTy, CostKind, Index, null, null, None);
    let mut VecLT: auto = getTypeLegalizationCost(VecTy);
    let mut DstVT: auto = self.TLI.getValueType;
    let mut SrcVT: auto = self.TLI.getValueType;
    if operator!() || operator!(self.TLI.isTypeLegal()) {
        return Cost + self.getCastInstrCost(Opcode, Dst, Src, None, CostKind, null);
    }
    if DstVT()() < () {
        return Cost + self.getCastInstrCost(Opcode, Dst, Src, None, CostKind, null);
    }
    match Opcode {
        _ => {
            llvm_unreachable_internal("Opcode should be either SExt or ZExt", "llvm\\lib\\Target\\AArch64\\AArch64TargetTransformInfo.cpp", 4620);
        },
        SExt => {
            return Cost;
        },
        ZExt => {
            if DstVT()() != 64 || () == 32 {
                return Cost;
            }
        },
    }
    return Cost + self.getCastInstrCost(Opcode, Dst, Src, None, CostKind, null);
}

