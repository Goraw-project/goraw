static mut EnableFalkorHWPFUnrollFix: opt<bool> = opt<bool> { "enable-falkor-hwpf-unroll-fix", init(true), Hidden };

static mut SVEPreferFixedOverScalableIfEqualCost: opt<bool> = opt<bool> { "sve-prefer-fixed-over-scalable-if-equal", Hidden };

static mut SVEGatherOverhead: opt<unsigned int> = opt<unsigned int> { "sve-gather-overhead", init(10), Hidden };

static mut SVEScatterOverhead: opt<unsigned int> = opt<unsigned int> { "sve-scatter-overhead", init(10), Hidden };

static mut SVETailFoldInsnThreshold: opt<unsigned int> = opt<unsigned int> { "sve-tail-folding-insn-threshold", init(15), Hidden };

static mut NeonNonConstStrideOverhead: opt<unsigned int> = opt<unsigned int> { "neon-nonconst-stride-overhead", init(10), Hidden };

static mut CallPenaltyChangeSM: opt<unsigned int> = opt<unsigned int> { "call-penalty-sm-change", init(5), Hidden, "Penalty of calling a function that requires a change to PSTATE.SM" };

static mut InlineCallPenaltyChangeSM: opt<unsigned int> = opt<unsigned int> { "inline-call-penalty-sm-change", init(10), Hidden, "Penalty of inlining a call that requires a change to PSTATE.SM" };

static mut EnableOrLikeSelectOpt: opt<bool> = opt<bool> { "enable-aarch64-or-like-select", init(true), Hidden };

static mut EnableLSRCostOpt: opt<bool> = opt<bool> { "enable-aarch64-lsr-cost-opt", init(true), Hidden };

static mut BaseHistCntCost: opt<unsigned int> = opt<unsigned int> { "aarch64-base-histcnt-cost", init(8), Hidden, "The cost of a histcnt instruction" };

static mut DMBLookaheadThreshold: opt<unsigned int> = opt<unsigned int> { "dmb-lookahead-threshold", init(10), Hidden, "The number of instructions to search for a redundant dmb" };

static mut Aarch64ForceUnrollThreshold: opt<int> = opt<int> { "aarch64-force-unroll-threshold", init(0), Hidden, "Threshold for forced unrolling of small loops in AArch64" };

struct TailFoldingOption {
    InitialBits: TailFoldingOpts,
    EnableBits: TailFoldingOpts,
    DisableBits: TailFoldingOpts,
    NeedsDefault: bool,
}

fn TailFoldingOption::setInitialBits(self, Bits: TailFoldingOpts) {
    self.InitialBits = Bits;
}

fn TailFoldingOption::setNeedsDefault(self, V: bool) {
    self.NeedsDefault = V;
}

fn TailFoldingOption::setEnableBit(self, Bit: TailFoldingOpts) {
    operator(self.EnableBits, Bit);
    operator(self.DisableBits, operator(Bit));
}

fn TailFoldingOption::setDisableBit(self, Bit: TailFoldingOpts) {
    operator(self.EnableBits, operator(Bit));
    operator(self.DisableBits, Bit);
}

fn TailFoldingOption::getBits(self: *TailFoldingOption, DefaultBits: TailFoldingOpts) -> TailFoldingOpts {
    let mut Bits: TailFoldingOpts = Disabled;
    assert!((self.InitialBits == Disabled || !self.NeedsDefault), "Initial bits should only include one of (disabled|all|simple|default)");
    Bits = if self.NeedsDefault { DefaultBits } else { self.InitialBits };
    operator(Bits, self.EnableBits);
    operator(Bits, operator(self.DisableBits));
    return Bits;
}

fn TailFoldingOption::reportError(self, Opt: str) {
    errs() << "invalid argument '" << Opt << "' to -sve-tail-folding=; the option should be of the form\n  (disabled|all|default|simple)[+(reductions|recurrences|reverse|noreductions|norecurrences|noreverse)]\n";
    report_fatal_error("Unrecognised tail-folding option", true);
}

fn TailFoldingOption::operator=(self, Val: str) {
    if Val.is_empty() {
        self.reportError("");
        return;
    }
    self.setNeedsDefault(false);
    let mut TailFoldTypes: SmallVector<StringRef, 4> = SmallVector<StringRef, 4> {};
    Val.split(TailFoldTypes, '+', -1, false);
    let mut StartIdx: u32 = 1;
    if TailFoldTypes[0] == "disabled" {
        self.setInitialBits(Disabled);
    } else if TailFoldTypes[0] == "all" {
        self.setInitialBits(All);
    } else if TailFoldTypes[0] == "default" {
        self.setNeedsDefault(true);
    } else if TailFoldTypes[0] == "simple" {
        self.setInitialBits(Simple);
    } else {
        StartIdx = 0;
        self.setInitialBits(Disabled);
    }
    for let mut I: u32 = StartIdx; I < TailFoldTypes.len; I += 1 {
        if TailFoldTypes[I] == "reductions" {
            self.setEnableBit(Reductions);
        } else if TailFoldTypes[I] == "recurrences" {
            self.setEnableBit(Recurrences);
        } else if TailFoldTypes[I] == "reverse" {
            self.setEnableBit(Reverse);
        } else if TailFoldTypes[I] == "noreductions" {
            self.setDisableBit(Reductions);
        } else if TailFoldTypes[I] == "norecurrences" {
            self.setDisableBit(Recurrences);
        } else if TailFoldTypes[I] == "noreverse" {
            self.setDisableBit(Reverse);
        } else {
            self.reportError(Val);
        }
    }
}

fn TailFoldingOption::isDisabled(self: *TailFoldingOption, DefaultBits: TailFoldingOpts) -> bool {
    return self.getBits(DefaultBits) == Disabled;
}

fn TailFoldingOption::satisfies(self: *TailFoldingOption, DefaultBits: TailFoldingOpts, Required: TailFoldingOpts) -> bool {
    return (self.getBits(DefaultBits) & Required) == Required;
}

fn TailFoldingOption::operator=(self, arg: *TailFoldingOption) -> *mut TailFoldingOption {
    self.InitialBits = .InitialBits;
    self.EnableBits = .EnableBits;
    self.DisableBits = .DisableBits;
    self.NeedsDefault = .NeedsDefault;
    return *self;
}

static mut TailFoldingOptionLoc: TailFoldingOption = TailFoldingOption {};

static mut SVETailFolding: string>> = string>> { "sve-tail-folding", "Control the use of vectorisation using tail-folding for SVE where the option is specified in the form (Initial)[+(Flag1|Flag2|...)]:\ndisabled      (Initial) No loop types will vectorize using tail-folding\ndefault       (Initial) Uses the default tail-folding settings for the target CPU\nall           (Initial) All legal loop types will vectorize using tail-folding\nsimple        (Initial) Use tail-folding for simple loops (not reductions or recurrences)\nreductions    Use tail-folding for loops containing reductions\nnoreductions  Inverse of above\nrecurrences   Use tail-folding for loops containing fixed order recurrences\nnorecurrences Inverse of above\nreverse       Use tail-folding for loops requiring reversed predicates\nnoreverse     Inverse of above", location(TailFoldingOptionLoc) };

static mut EnableFixedwidthAutovecInStreamingMode: opt<bool> = opt<bool> { "enable-fixedwidth-autovec-in-streaming-mode", init(false), Hidden };

static mut EnableScalableAutovecInStreamingMode: opt<bool> = opt<bool> { "enable-scalable-autovec-in-streaming-mode", init(false), Hidden };

fn isSMEABIRoutineCall(CI: *CallInst, TLI: *AArch64TargetLowering) -> bool {
    let mut F: *Function = CI.getCalledFunction();
    return F && SMEAttrs { F.getName(), TLI.getRuntimeLibcallsInfo() }.isSMEABIRoutine();
}

fn hasPossibleIncompatibleOps(F: *Function, TLI: *AArch64TargetLowering) -> bool {
    for BB in *F {
        for I in BB {
            if isa(I) && !I.isDebugOrPseudoInst() && (cast(I).isInlineAsm() || isa(I) || isSMEABIRoutineCall(cast(I), TLI)) {
                return true;
            }
        }
    }
    return false;
}

fn extractAttrFeatures(F: *Function, TTI: *AArch64TTIImpl, Features: *mut SmallVectorImpl<StringRef>) {
    let mut AttributeStr: str = if TTI.isMultiversionedFunction(F) { "fmv-features" } else { "target-features" };
    let mut FeatureStr: str = F.getFnAttribute(AttributeStr).getValueAsString();
    FeatureStr.split(Features, ",", -1, true);
}

fn AArch64TTIImpl::getFeatureMask(self: *AArch64TTIImpl, F: *Function) -> APInt {
    let mut Features: SmallVector<StringRef, 8> = SmallVector<StringRef, 8> {};
    extractAttrFeatures(F, self, Features);
    return getCpuSupportsMask(Features);
}

fn AArch64TTIImpl::getPriorityMask(self: *AArch64TTIImpl, F: *Function) -> APInt {
    let mut Features: SmallVector<StringRef, 8> = SmallVector<StringRef, 8> {};
    extractAttrFeatures(F, self, Features);
    return getFMVPriority(Features);
}

fn AArch64TTIImpl::isMultiversionedFunction(self: *AArch64TTIImpl, F: *Function) -> bool {
    return F.hasFnAttribute("fmv-features");
}

fn AArch64TTIImpl::areInlineCompatible(self: *AArch64TTIImpl, Caller: *Function, Callee: *Function) -> bool {
    let mut CallAttrs: SMECallAttrs = SMECallAttrs { SMEAttrs { *Caller, null }, SMEAttrs { *Callee, null }, Normal };
    if CallAttrs.caller().hasNonStreamingInterfaceAndBody() && CallAttrs.callee().hasStreamingInterfaceOrBody() {
        return false;
    }
    if CallAttrs.callee().hasStreamingBody() {
        CallAttrs.callee().set(SM_Compatible, false);
        CallAttrs.callee().set(SM_Enabled, true);
    }
    if CallAttrs.callee().isNewZA() || CallAttrs.callee().isNewZT0() {
        return false;
    }
    if CallAttrs.requiresLazySave() || CallAttrs.requiresSMChange() || CallAttrs.requiresPreservingZT0() || CallAttrs.requiresPreservingAllZAState() {
        if hasPossibleIncompatibleOps(Callee, *self.getTLI()) {
            return false;
        }
    }
    return self.areInlineCompatible(Caller, Callee);
}

fn AArch64TTIImpl::areTypesABICompatible(self: *AArch64TTIImpl, Caller: *Function, Callee: *Function, Types: ArrayRef<Type *>) -> bool {
    if !self.areTypesABICompatible(Caller, Callee, Types) {
        return false;
    }
    if self.ST.useSVEForFixedLengthVectors() && any_of(Types, Closure_1 {}) {
        return false;
    }
    return true;
}

fn AArch64TTIImpl::getInlineCallPenalty(self: *AArch64TTIImpl, F: *Function, Call: *CallBase, DefaultCallPenalty: u32) -> u32 {
    let mut FAttrs: SMEAttrs = SMEAttrs { *F, null };
    let mut CallAttrs: SMECallAttrs = SMECallAttrs { Call, &mut self.getTLI().getRuntimeLibcallsInfo() };
    if SMECallAttrs { FAttrs, CallAttrs.callee(), Normal }.requiresSMChange() {
        if F == Call.getCaller() {
            return CallPenaltyChangeSM.operator unsigned int() * DefaultCallPenalty;
        }
        if SMECallAttrs { FAttrs, CallAttrs.caller(), Normal }.requiresSMChange() {
            return InlineCallPenaltyChangeSM.operator unsigned int() * DefaultCallPenalty;
        }
    }
    return DefaultCallPenalty;
}

fn AArch64TTIImpl::shouldMaximizeVectorBandwidth(self: *AArch64TTIImpl, K: RegisterKind) -> bool {
    assert!(K != RGK_Scalar);
    if K == RGK_FixedWidthVector && self.ST.isNeonAvailable() {
        return true;
    }
    return K == RGK_ScalableVector && self.ST.isSVEorStreamingSVEAvailable() && !self.ST.disableMaximizeScalableBandwidth();
}

fn AArch64TTIImpl::getIntImmCost(self: *AArch64TTIImpl, Val: i64) -> InstructionCost {
    if Val == 0 || isLogicalImmediate(Val, 64) {
        return 0;
    }
    if Val < 0 {
        Val = ~Val;
    }
    let mut Insn: ImmInsnModel, 4> = ImmInsnModel, 4> {};
    expandMOVImm(Val, 64, Insn);
    return Insn.len;
}

fn AArch64TTIImpl::getIntImmCost(self: *AArch64TTIImpl, Imm: *APInt, Ty: *mut Type, CostKind: TargetCostKind) -> InstructionCost {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 {
        return ~0;
    }
    let mut ImmVal: APInt = Imm;
    if BitSize & 63 {
        ImmVal = Imm.sext((BitSize + 63) & ~63);
    }
    let mut Cost: InstructionCost = 0;
    for let mut ShiftVal: u32 = 0; ShiftVal < BitSize; ShiftVal += 64 {
        let mut Tmp: APInt = ImmVal.ashr(ShiftVal).sextOrTrunc(64);
        let mut Val: i64 = Tmp.getSExtValue();
        operator(Cost, self.getIntImmCost(Val));
    }
    return if 1 > Cost { 1 } else { Cost };
}

fn AArch64TTIImpl::getIntImmCostInst(self: *AArch64TTIImpl, Opcode: u32, Idx: u32, Imm: *APInt, Ty: *mut Type, CostKind: TargetCostKind, Inst: *mut Instruction) -> InstructionCost {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 {
        return TCC_Free;
    }
    let mut ImmIdx: u32 = ~0;
    match Opcode {
        _ => {
            return TCC_Free;
        },
        GetElementPtr => {
            if Idx == 0 {
                return 2 * TCC_Basic;
            }
        },
        Store => {
            ImmIdx = 0;
        },
        Add => {
            Sub;
        },
        Shl => {
            LShr;
        },
        Trunc => {
            ZExt;
        },
    }
    if Idx == ImmIdx {
        let mut NumConstants: i32 = (BitSize + 63) / 64;
        let mut Cost: InstructionCost = self.getIntImmCost(Imm, Ty, CostKind);
        return if (Cost <= NumConstants * TCC_Basic) { TCC_Free as i32 } else { Cost };
    }
    return self.getIntImmCost(Imm, Ty, CostKind);
}

fn AArch64TTIImpl::getIntImmCostIntrin(self: *AArch64TTIImpl, IID: ID, Idx: u32, Imm: *APInt, Ty: *mut Type, CostKind: TargetCostKind) -> InstructionCost {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 {
        return TCC_Free;
    }
    if IID >= aarch64_addg && IID <= aarch64_udiv {
        return self.getIntImmCost(Imm, Ty, CostKind);
    }
    match IID {
        _ => {
            return TCC_Free;
        },
        sadd_with_overflow => {
            uadd_with_overflow;
        },
        experimental_stackmap => {
            if (Idx < 2) || (Imm.getBitWidth() <= 64 && isInt(Imm.getSExtValue())) {
                return TCC_Free;
            }
        },
        experimental_patchpoint_void => {
            experimental_patchpoint;
        },
        experimental_gc_statepoint => {
            if (Idx < 5) || (Imm.getBitWidth() <= 64 && isInt(Imm.getSExtValue())) {
                return TCC_Free;
            }
        },
    }
    return self.getIntImmCost(Imm, Ty, CostKind);
}

fn AArch64TTIImpl::getPopcntSupport(self: *AArch64TTIImpl, TyWidth: u32) -> PopcntSupportKind {
    assert!(isPowerOf2_32(TyWidth), "Ty width must be power of 2");
    if TyWidth == 32 || TyWidth == 64 {
        return PSK_FastHardware;
    }
    return PSK_Software;
}

fn AArch64TTIImpl::getBranchMispredictPenalty(self: *AArch64TTIImpl) -> InstructionCost {
    return self.ST.getMispredictionPenalty();
}

fn isUnpackedVectorVT(VecVT: EVT) -> bool {
    return VecVT.isScalableVector() && VecVT.getSizeInBits().getKnownMinValue() < SVEBitsPerBlock;
}

fn getHistogramCost(ST: *AArch64Subtarget, ICA: *IntrinsicCostAttributes) -> InstructionCost {
    if ICA.getArgTypes().len < 2 {
        return getInvalid(0);
    }
    if !ST.hasSVE2() {
        return getInvalid(0);
    }
    let mut BucketPtrsTy: *mut Type = ICA.getArgTypes()[0];
    let mut EltTy: *mut Type = ICA.getArgTypes()[1];
    let mut TotalHistCnts: u32 = 1;
    let mut EltSize: u32 = EltTy.getScalarSizeInBits();
    if (!EltTy.isIntegerTy() && !EltTy.isPointerTy()) || EltSize > 64 {
        return getInvalid(0);
    }
    if dyn_cast(BucketPtrsTy) {
        VTy;
    } else {
        let mut EC: u32 = VTy.getElementCount().getKnownMinValue();
        if !isPowerOf2_64(EC) || !VTy.isScalableTy() || EC == 1 {
            return getInvalid(0);
        }
        let mut LegalEltSize: u32 = if EltSize <= 32 { 32 } else { 64 };
        if EC == 2 || (LegalEltSize == 32 && EC == 4) {
            return BaseHistCntCost.operator unsigned int();
        }
        let mut NaturalVectorWidth: u32 = SVEBitsPerBlock / LegalEltSize;
        TotalHistCnts = EC / NaturalVectorWidth;
        return BaseHistCntCost.operator unsigned int() * TotalHistCnts;
    }
    return getInvalid(0);
}

fn AArch64TTIImpl::getIntrinsicInstrCost(self: *AArch64TTIImpl, ICA: *IntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    let mut RetTy: *mut Type = ICA.getReturnType();
    if dyn_cast(RetTy) {
        VTy;
    } else if VTy.getElementCount() == getScalable(1) && !is_contained([masked_load, masked_store], ICA.getID()) {
        return getInvalid(0);
    }
    match ICA.getID() {
        experimental_vector_histogram_add => {
            let mut HistCost: InstructionCost = getHistogramCost(self.ST, ICA);
            if HistCost.isValid() {
                return HistCost;
            }
            break;
        },
        clmul => {
            let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(RetTy);
            if self.ST.hasNEON() {
                if LT.second == v8i8 || LT.second == v16i8 {
                    return LT.first;
                }
                if self.TLI.getValueType(self.DL, RetTy, true) == i8 {
                    let mut VecTy: *mut FixedVectorType = get(getInt8Ty(RetTy.getContext()), 8);
                    return 1 + self.getVectorInstrCost(ExtractElement, VecTy, CostKind, -1, null, null, None) * 2 + self.getVectorInstrCost(InsertElement, VecTy, CostKind, -1, null, null, None);
                }
            }
            if LT.second.SimpleTy == nxv2i64 {
                if self.ST.hasSVEAES() && (self.ST.isSVEAvailable() || self.ST.hasSSVE_AES()) {
                    return LT.first * 3;
                }
            }
            if self.ST.hasSVE2() || self.ST.hasSME() {
                match LT.second.SimpleTy {
                    nxv16i8 => {
                        return LT.first;
                    },
                    nxv8i16 => {
                        return LT.first * 6;
                    },
                    nxv4i32 => {
                        return LT.first * 3;
                    },
                    nxv2i64 => {
                        return LT.first * 8;
                    },
                    _ => {
                        break;
                    },
                }
            }
            if LT.second.SimpleTy == nxv2i64 {
                return 192;
            }
            if self.ST.hasAES() {
                match LT.second.SimpleTy {
                    i16 => {
                        i32;
                    },
                    v1i64 => {
                        return LT.first;
                    },
                    v2i64 => {
                        return LT.first * 3;
                    },
                    v2i32 => {
                        return LT.first * 6;
                    },
                    v4i32 => {
                        return LT.first * 11;
                    },
                    v4i16 => {
                        return LT.first * 14;
                    },
                    _ => {
                        break;
                    },
                }
            }
            break;
        },
        umin => {
            umax;
        },
        scmp => {
            ucmp;
        },
        sadd_sat => {
            ssub_sat;
        },
        abs => {
            let mut ValidAbsTys: SimpleValueType> = [v8i8, v16i8, v4i16, v8i16, v2i32, v4i32, v2i64, nxv16i8, nxv8i16, nxv4i32, nxv2i64];
            let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(RetTy);
            if any_of(ValidAbsTys, equal_to(LT.second)) {
                return LT.first;
            }
            break;
        },
        bswap => {
            let mut ValidAbsTys: SimpleValueType> = [v4i16, v8i16, v2i32, v4i32, v2i64];
            let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(RetTy);
            if any_of(ValidAbsTys, equal_to(LT.second)) && LT.second.getScalarSizeInBits() == RetTy.getScalarSizeInBits() {
                return LT.first;
            }
            break;
        },
        fma => {
            fmuladd;
        },
        stepvector => {
            let mut Cost: InstructionCost = 1;
            let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(RetTy);
            if LT.first > 1 {
                let mut LegalVTy: *mut Type = LT.second.getTypeForEVT(RetTy.getContext());
                let mut AddCost: InstructionCost = self.getArithmeticInstrCost(Add, LegalVTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null);
                operator(Cost, AddCost * (LT.first - 1));
            }
            return Cost;
        },
        vector_extract => {
            vector_insert;
        },
        bitreverse => {
            let mut BitreverseTbl: [10]CostTblEntry = [CostTblEntry { bitreverse, i32, 1 }, CostTblEntry { bitreverse, i64, 1 }, CostTblEntry { bitreverse, v8i8, 1 }, CostTblEntry { bitreverse, v16i8, 1 }, CostTblEntry { bitreverse, v4i16, 2 }, CostTblEntry { bitreverse, v8i16, 2 }, CostTblEntry { bitreverse, v2i32, 2 }, CostTblEntry { bitreverse, v4i32, 2 }, CostTblEntry { bitreverse, v1i64, 2 }, CostTblEntry { bitreverse, v2i64, 2 }];
            let mut LegalisationCost: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(RetTy);
            let mut Entry: *CostTblEntryT<unsigned short> = CostTableLookup(BitreverseTbl, ICA.getID(), LegalisationCost.second);
            if Entry {
                if self.TLI.getValueType(self.DL, RetTy, true) == i8 || self.TLI.getValueType(self.DL, RetTy, true) == i16 {
                    return LegalisationCost.first * Entry.Cost + 1;
                }
                return LegalisationCost.first * Entry.Cost;
            }
            break;
        },
        ctpop => {
            let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(RetTy);
            let mut MTy: MVT = LT.second;
            if self.ST.hasCSSC() && !RetTy.isVectorTy() {
                let mut ExtraCost: i32 = if MTy.getScalarSizeInBits() != RetTy.getScalarSizeInBits() { 1 } else { 0 };
                return LT.first + ExtraCost;
            }
            if !self.ST.hasNEON() {
                return self.getTypeLegalizationCost(RetTy).first * 12;
            }
            let mut CtpopCostTbl: [13]CostTblEntry = [CostTblEntry { CTPOP, v2i64, 4 }, CostTblEntry { CTPOP, v4i32, 3 }, CostTblEntry { CTPOP, v8i16, 2 }, CostTblEntry { CTPOP, v16i8, 1 }, CostTblEntry { CTPOP, i64, 4 }, CostTblEntry { CTPOP, v2i32, 3 }, CostTblEntry { CTPOP, v4i16, 2 }, CostTblEntry { CTPOP, v8i8, 1 }, CostTblEntry { CTPOP, i32, 5 }, CostTblEntry { CTPOP, nxv2i64, 1 }, CostTblEntry { CTPOP, nxv4i32, 1 }, CostTblEntry { CTPOP, nxv8i16, 1 }, CostTblEntry { CTPOP, nxv16i8, 1 }];
            if self.ST.isSVEorStreamingSVEAvailable() && MTy.isFixedLengthVector() {
                MTy = getScalableVectorVT(MTy.getVectorElementType(), 128 / MTy.getScalarSizeInBits());
            }
            if CostTableLookup(CtpopCostTbl, CTPOP, MTy) {
                Entry;
            } else {
                let mut ExtraCost: i32 = if MTy.isVector() && MTy.getScalarSizeInBits() != RetTy.getScalarSizeInBits() { 1 } else { 0 };
                return LT.first * Entry.Cost + ExtraCost;
            }
            break;
        },
        sadd_with_overflow => {
            uadd_with_overflow;
        },
        fptosi_sat => {
            fptoui_sat;
        },
        fshl => {
            fshr;
        },
        get_active_lane_mask => {
            let mut RetTy: CastReturnType = cast(ICA.getReturnType());
            let mut RetVT: EVT = self.getTLI().getValueType(self.DL, RetTy, false);
            let mut OpVT: EVT = self.getTLI().getValueType(self.DL, ICA.getArgTypes()[0], false);
            if self.getTLI().shouldExpandGetActiveLaneMask(RetVT, OpVT) {
                break;
            }
            if RetTy.isScalableTy() {
                if self.TLI.getTypeAction(RetTy.getContext(), RetVT) != TypeSplitVector {
                    break;
                }
                let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(RetTy);
                let mut Cost: InstructionCost = LT.first;
                if self.ST.hasSVE2p1() || self.ST.hasSME2() {
                    operator(Cost, 2);
                    if Cost == 1 {
                        return Cost;
                    }
                }
                let mut OpTy: *mut Type = ICA.getArgTypes()[0];
                let mut AddAttrs: IntrinsicCostAttributes = IntrinsicCostAttributes { uadd_sat, OpTy, [OpTy, OpTy], FastMathFlags {}, null, getInvalid(0) };
                let mut SplitCost: InstructionCost = self.getIntrinsicInstrCost(AddAttrs, CostKind);
                let mut CondTy: *mut Type = OpTy.getWithNewBitWidth(1);
                operator(SplitCost, self.getCmpSelInstrCost(Select, OpTy, CondTy, ICMP_UGT, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, null));
                return Cost + (SplitCost * (Cost - 1));
            } else if !self.getTLI().isTypeLegal(RetVT) {
                return cast(RetTy).getNumElements() * 2;
            }
            break;
        },
        experimental_vector_match => {
            if !self.ST.hasSVE2() || !self.ST.isSVEAvailable() {
                break;
            }
            let mut NeedleTy: *mut FixedVectorType = cast(ICA.getArgTypes()[1]);
            let mut SearchSize: u32 = NeedleTy.getNumElements();
            if SearchSize <= 2 {
                break;
            }
            if !is_contained([nxv8i16, nxv16i8, v8i16, v16i8, v8i8], SearchVT.SimpleTy) {
                break;
            }
            let mut ElementSizeInBits: u32 = SearchVT.getScalarSizeInBits();
            let mut NeedleEltsPerMatch: u32 = SVEBitsPerBlock / ElementSizeInBits;
            let mut MatchesRequiredForNeedle: u32 = divideCeil(SearchSize, NeedleEltsPerMatch);
            let mut Cost: InstructionCost = 4;
            if isa(RetTy) {
                operator(Cost, 10);
            }
            return Cost * LegalParts * MatchesRequiredForNeedle;
        },
        cttz => {
            let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(ICA.getArgTypes()[0]);
            if LT.second == v8i8 || LT.second == v16i8 {
                return LT.first * 2;
            }
            if LT.second == v4i16 || LT.second == v8i16 || LT.second == v2i32 || LT.second == v4i32 {
                return LT.first * 3;
            }
            break;
        },
        experimental_cttz_elts => {
            let mut ArgVT: EVT = self.getTLI().getValueType(self.DL, ICA.getArgTypes()[0], false);
            if self.getTLI().isOperationCustom(CTTZ_ELTS, ArgVT) {
                return 4;
            }
            break;
        },
        loop_dependence_raw_mask => {
            loop_dependence_war_mask;
        },
        experimental_vector_extract_last_active => {
            if self.ST.isSVEorStreamingSVEAvailable() {
                return LegalCost;
            }
        },
        pow => {
            let mut VT: EVT = self.getTLI().getValueType(self.DL, RetTy, false);
            let mut LC: Libcall = getPOW(VT);
            let mut HasLibcall: bool = self.getTLI().getLibcallImpl(LC) != Unsupported;
            let mut CanLowerWithLibcalls: bool = !isa(RetTy) || HasLibcall;
            if CanLowerWithLibcalls && ICA.getInst() && !ICA.getArgs().is_empty() {
                let mut ExpC: *Constant = dyn_cast(ICA.getArgs()[1]);
                if ExpC && isa(ExpC.getType()) {
                    ExpC = ExpC.getSplatValue(false);
                }
                if dyn_cast_or_null(ExpC) {
                    ExpF;
                } else {
                    let mut Is025: bool = ExpF.getValueAPF().isExactlyValue(0.25);
                    let mut Is075: bool = ExpF.getValueAPF().isExactlyValue(0.75);
                    let mut FMF: FastMathFlags = ICA.getInst().getFastMathFlags();
                    if (Is025 || Is075) && FMF.noInfs() && FMF.approxFunc() && (!Is025 || FMF.noSignedZeros()) {
                        let mut Attrs: IntrinsicCostAttributes = IntrinsicCostAttributes { sqrt, RetTy, [RetTy], FMF, null, getInvalid(0) };
                        let mut Sqrt: InstructionCost = self.getIntrinsicInstrCost(Attrs, CostKind);
                        if Is025 {
                            return 2 * Sqrt;
                        }
                        let mut FMul: InstructionCost = self.getArithmeticInstrCost(FMul, RetTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null);
                        return (Sqrt * 2) + FMul;
                    }
                }
            }
            if HasLibcall {
                return self.getCallInstrCost(null, RetTy, ICA.getArgTypes(), CostKind);
            }
            break;
        },
        sqrt => {
            fabs;
        },
        _ => {
            break;
        },
    }
    return self.getIntrinsicInstrCost(ICA, CostKind);
}

fn processPhiNode(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Worklist: SmallVector<Instruction *, 32> = SmallVector<Instruction *, 32> {};
    let mut RequiredType: *mut Type = II.getType();
    let mut PN: *mut PHINode = dyn_cast(II.getArgOperand(0));
    assert!(PN, "Expected Phi Node!");
    if !PN.hasOneUse() {
        return nullopt;
    }
    for IncValPhi in PN.incoming_values() {
        let mut Reinterpret: *mut IntrinsicInst = dyn_cast(IncValPhi);
        if !Reinterpret || Reinterpret.getIntrinsicID() != aarch64_sve_convert_to_svbool || RequiredType != Reinterpret.getArgOperand(0).getType() {
            return nullopt;
        }
    }
    IC.Builder.SetInsertPoint(PN);
    let mut NPN: *mut PHINode = IC.Builder.CreatePHI(RequiredType, PN.getNumIncomingValues(), "");
    Worklist.push(PN);
    for let mut I: u32 = 0; I < PN.getNumIncomingValues(); I += 1 {
        let mut Reinterpret: *mut Instruction = cast(PN.getIncomingValue(I));
        NPN.addIncoming(Reinterpret.getOperand(0), PN.getIncomingBlock(I));
        Worklist.push(Reinterpret);
    }
    return IC.replaceInstUsesWith(II, NPN);
}

struct SVEIntrinsicInfo {
    GoverningPredicateIdx: u32,
    UndefIntrinsic: ID,
    IROpcode: u32,
    CmpPredicate: Predicate,
    ResultLanes: PredicationStyle,
    ResultIsZeroInitialized: bool,
    OperandIdxForInactiveLanes: u32,
    OperandIdxWithNoActiveLanes: u32,
}

fn SVEIntrinsicInfo::defaultMergingOp(self, IID: ID) -> SVEIntrinsicInfo {
    return SVEIntrinsicInfo {}.setGoverningPredicateOperandIdx(0).setOperandIdxInactiveLanesTakenFrom(1).setMatchingUndefIntrinsic(IID);
}

fn SVEIntrinsicInfo::defaultMergingUnaryOp(self) -> SVEIntrinsicInfo {
    return SVEIntrinsicInfo {}.setGoverningPredicateOperandIdx(1).setOperandIdxInactiveLanesTakenFrom(0).setOperandIdxWithNoActiveLanes(0);
}

fn SVEIntrinsicInfo::defaultMergingUnaryNarrowingTopOp(self) -> SVEIntrinsicInfo {
    return SVEIntrinsicInfo {}.setGoverningPredicateOperandIdx(1).setOperandIdxInactiveLanesTakenFrom(0);
}

fn SVEIntrinsicInfo::defaultUndefOp(self) -> SVEIntrinsicInfo {
    return SVEIntrinsicInfo {}.setGoverningPredicateOperandIdx(0).setInactiveLanesAreNotDefined();
}

fn SVEIntrinsicInfo::defaultVoidOp(self, GPIndex: u32) -> SVEIntrinsicInfo {
    return SVEIntrinsicInfo {}.setGoverningPredicateOperandIdx(GPIndex).setInactiveLanesAreUnused();
}

fn SVEIntrinsicInfo::defaultZeroingOp(self) -> SVEIntrinsicInfo {
    return SVEIntrinsicInfo {}.setGoverningPredicateOperandIdx(0).setInactiveLanesAreUnused().setResultIsZeroInitialized();
}

fn SVEIntrinsicInfo::hasGoverningPredicate(self: *SVEIntrinsicInfo) -> bool {
    return self.GoverningPredicateIdx != max();
}

fn SVEIntrinsicInfo::getGoverningPredicateOperandIdx(self: *SVEIntrinsicInfo) -> u32 {
    assert!(self.hasGoverningPredicate(), "Property not set!");
    return self.GoverningPredicateIdx;
}

fn SVEIntrinsicInfo::setGoverningPredicateOperandIdx(self, Index: u32) -> *mut SVEIntrinsicInfo {
    assert!(!self.hasGoverningPredicate(), "Cannot set property twice!");
    self.GoverningPredicateIdx = Index;
    return *self;
}

fn SVEIntrinsicInfo::hasMatchingUndefIntrinsic(self: *SVEIntrinsicInfo) -> bool {
    return self.UndefIntrinsic != not_intrinsic;
}

fn SVEIntrinsicInfo::getMatchingUndefIntrinsic(self: *SVEIntrinsicInfo) -> ID {
    assert!(self.hasMatchingUndefIntrinsic(), "Property not set!");
    return self.UndefIntrinsic;
}

fn SVEIntrinsicInfo::setMatchingUndefIntrinsic(self, IID: ID) -> *mut SVEIntrinsicInfo {
    assert!(!self.hasMatchingUndefIntrinsic(), "Cannot set property twice!");
    self.UndefIntrinsic = IID;
    return *self;
}

fn SVEIntrinsicInfo::hasMatchingIROpode(self: *SVEIntrinsicInfo) -> bool {
    return self.IROpcode != 0;
}

fn SVEIntrinsicInfo::getMatchingIROpode(self: *SVEIntrinsicInfo) -> u32 {
    assert!(self.hasMatchingIROpode(), "Property not set!");
    return self.IROpcode;
}

fn SVEIntrinsicInfo::setMatchingIROpcode(self, Opcode: u32) -> *mut SVEIntrinsicInfo {
    assert!(!self.hasMatchingIROpode(), "Cannot set property twice!");
    self.IROpcode = Opcode;
    return *self;
}

fn SVEIntrinsicInfo::hasCmpPredicate(self: *SVEIntrinsicInfo) -> bool {
    return self.CmpPredicate != BAD_ICMP_PREDICATE;
}

fn SVEIntrinsicInfo::getCmpPredicate(self: *SVEIntrinsicInfo) -> Predicate {
    assert!(self.hasCmpPredicate(), "Property not set!");
    return self.CmpPredicate;
}

fn SVEIntrinsicInfo::setCmpPredicate(self, Pred: Predicate) -> *mut SVEIntrinsicInfo {
    assert!(!self.hasCmpPredicate(), "Cannot set property twice!");
    self.CmpPredicate = Pred;
    if isFPPredicate(Pred) {
        return self.setMatchingIROpcode(FCmp);
    }
    if isIntPredicate(Pred) {
        return self.setMatchingIROpcode(ICmp);
    }
    llvm_unreachable_internal("Unsupported compare predicate!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64TargetTransformInfo.cpp", 1488);
}

fn SVEIntrinsicInfo::inactiveLanesTakenFromOperand(self: *SVEIntrinsicInfo) -> bool {
    return self.ResultLanes == InactiveLanesTakenFromOperand;
}

fn SVEIntrinsicInfo::getOperandIdxInactiveLanesTakenFrom(self: *SVEIntrinsicInfo) -> u32 {
    assert!(self.inactiveLanesTakenFromOperand(), "Property not set!");
    return self.OperandIdxForInactiveLanes;
}

fn SVEIntrinsicInfo::setOperandIdxInactiveLanesTakenFrom(self, Index: u32) -> *mut SVEIntrinsicInfo {
    assert!(self.ResultLanes == Uninitialized, "Cannot set property twice!");
    self.ResultLanes = InactiveLanesTakenFromOperand;
    self.OperandIdxForInactiveLanes = Index;
    return *self;
}

fn SVEIntrinsicInfo::inactiveLanesAreNotDefined(self: *SVEIntrinsicInfo) -> bool {
    return self.ResultLanes == InactiveLanesAreNotDefined;
}

fn SVEIntrinsicInfo::setInactiveLanesAreNotDefined(self) -> *mut SVEIntrinsicInfo {
    assert!(self.ResultLanes == Uninitialized, "Cannot set property twice!");
    self.ResultLanes = InactiveLanesAreNotDefined;
    return *self;
}

fn SVEIntrinsicInfo::inactiveLanesAreUnused(self: *SVEIntrinsicInfo) -> bool {
    return self.ResultLanes == InactiveLanesAreUnused;
}

fn SVEIntrinsicInfo::setInactiveLanesAreUnused(self) -> *mut SVEIntrinsicInfo {
    assert!(self.ResultLanes == Uninitialized, "Cannot set property twice!");
    self.ResultLanes = InactiveLanesAreUnused;
    return *self;
}

fn SVEIntrinsicInfo::resultIsZeroInitialized(self: *SVEIntrinsicInfo) -> bool {
    return self.ResultIsZeroInitialized;
}

fn SVEIntrinsicInfo::setResultIsZeroInitialized(self) -> *mut SVEIntrinsicInfo {
    self.ResultIsZeroInitialized = true;
    return *self;
}

fn SVEIntrinsicInfo::hasOperandWithNoActiveLanes(self: *SVEIntrinsicInfo) -> bool {
    return self.OperandIdxWithNoActiveLanes != max();
}

fn SVEIntrinsicInfo::getOperandIdxWithNoActiveLanes(self: *SVEIntrinsicInfo) -> u32 {
    assert!(self.hasOperandWithNoActiveLanes(), "Property not set!");
    return self.OperandIdxWithNoActiveLanes;
}

fn SVEIntrinsicInfo::setOperandIdxWithNoActiveLanes(self, Index: u32) -> *mut SVEIntrinsicInfo {
    assert!(!self.hasOperandWithNoActiveLanes(), "Cannot set property twice!");
    self.OperandIdxWithNoActiveLanes = Index;
    return *self;
}

fn constructSVEIntrinsicInfo(II: *mut IntrinsicInst) -> SVEIntrinsicInfo {
    if !isa(II.getType()) && all_of(II.args(), Closure_2 {}) {
        return SVEIntrinsicInfo {};
    }
    let mut IID: ID = II.getIntrinsicID();
    match IID {
        _ => {
            break;
        },
        aarch64_sve_fcvt_bf16f32_v2 => {
            aarch64_sve_fcvt_f16f32;
        },
        aarch64_sve_fcvtnt_bf16f32_v2 => {
            aarch64_sve_fcvtnt_f16f32;
        },
        aarch64_sve_fabd => {
            return defaultMergingOp(aarch64_sve_fabd_u);
        },
        aarch64_sve_fadd => {
            return defaultMergingOp(aarch64_sve_fadd_u).setMatchingIROpcode(FAdd);
        },
        aarch64_sve_fdiv => {
            return defaultMergingOp(aarch64_sve_fdiv_u).setMatchingIROpcode(FDiv);
        },
        aarch64_sve_fmax => {
            return defaultMergingOp(aarch64_sve_fmax_u);
        },
        aarch64_sve_fmaxnm => {
            return defaultMergingOp(aarch64_sve_fmaxnm_u);
        },
        aarch64_sve_fmin => {
            return defaultMergingOp(aarch64_sve_fmin_u);
        },
        aarch64_sve_fminnm => {
            return defaultMergingOp(aarch64_sve_fminnm_u);
        },
        aarch64_sve_fmla => {
            return defaultMergingOp(aarch64_sve_fmla_u);
        },
        aarch64_sve_fmls => {
            return defaultMergingOp(aarch64_sve_fmls_u);
        },
        aarch64_sve_fmul => {
            return defaultMergingOp(aarch64_sve_fmul_u).setMatchingIROpcode(FMul);
        },
        aarch64_sve_fmulx => {
            return defaultMergingOp(aarch64_sve_fmulx_u);
        },
        aarch64_sve_fnmla => {
