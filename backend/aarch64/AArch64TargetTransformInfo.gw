struct Closure_50 {
    LoadedValuesPlus: *mut SmallPtrSet<Value *, 8>,
}

unsafe fn Closure_50::call(self: *mut Closure_50, SI: *mut StoreInst) -> bool {
            return (*self.LoadedValuesPlus).contains(SI.getOperand(0));
        }

struct Closure_51 {
    L: *mut Loop,
}

fn Closure_51::call(self: *Closure_51, Pred: *mut BasicBlock) -> bool {
        return self.L.contains(Pred);
    }

struct Closure_53 {
    DependsOnLoopLoad: *mut function<bool (Instruction *, unsigned int)>,
    Depth: *mut u32,
}

unsafe fn Closure_53::call(self: *mut Closure_53, V: *mut Value) -> bool {
            let mut I: *mut Instruction = dyn_cast(V);
            return I && (*self.DependsOnLoopLoad).call(I, (*self.Depth) + 1);
        }

struct Closure_52 {
    L: *mut *mut Loop,
    DependsOnLoopLoad: *mut function<bool (Instruction *, unsigned int)>,
}

unsafe fn Closure_52::call(self: *mut Closure_52, I: *mut Instruction, Depth: u32) -> auto {
        if isa(I) || (*self.L).isLoopInvariant(I) || Depth > 8 {
            return false;
        }
        if isa(I) {
            return true;
        }
        return any_of(I.operands(), Closure_53 { DependsOnLoopLoad: &mut (*self.DependsOnLoopLoad), Depth: &mut Depth });
    }

struct Closure_54 {
    cap_0: *AArch64TTIImpl,
    AccumLT: *mut pair<InstructionCost, MVT>,
}

unsafe fn Closure_54::call(self: *mut Closure_54, SVEPred: bool, NEONPred: bool) -> auto {
        return (self.ST.isSVEorStreamingSVEAvailable() && SVEPred) || ((*self.AccumLT).second.isFixedLengthVector() && (*self.AccumLT).second.getSizeInBits().operator unsigned long long() <= 128 && self.ST.isNeonAvailable() && NEONPred);
    }

struct Closure_55 {}

fn Closure_55::call(self: *Closure_55) {
        return M.value() < 0 || M.value() == M.index() as i32;
    }

struct Closure_56 {}

fn Closure_56::call(self: *Closure_56, E: i32) -> bool {
        return E < 8;
    }

struct Closure_57 {
    Mask: *mut ArrayRef<int>,
}

unsafe fn Closure_57::call(self: *mut Closure_57, M: i32) -> bool {
        return M < 0 || M == (*self.Mask)[0];
    }

struct Closure_58 {}

fn Closure_58::call(self: *Closure_58, FullV: *mut Value, HalfV: *mut Value) -> bool {
        let mut FullTy: *mut Type = FullV.getType();
        let mut HalfTy: *mut Type = HalfV.getType();
        return FullTy.getPrimitiveSizeInBits().getFixedValue() == 2 * HalfTy.getPrimitiveSizeInBits().getFixedValue();
    }

struct Closure_59 {}

fn Closure_59::call(self: *Closure_59, FullV: *mut Value, HalfV: *mut Value) -> bool {
        let mut FullVT: *mut FixedVectorType = cast(FullV.getType());
        let mut HalfVT: *mut FixedVectorType = cast(HalfV.getType());
        return FullVT.getNumElements() == 2 * HalfVT.getNumElements();
    }

struct Closure_60 {}

fn Closure_60::call(self: *Closure_60, Ext: *mut Instruction) -> bool {
        return Ext.getType().getScalarSizeInBits() == 2 * Ext.getOperand(0).getType().getScalarSizeInBits();
    }

struct Closure_61 {}

fn Closure_61::call(self: *mut Closure_61, Cond: *mut Value, Ops: *mut SmallVectorImpl<Use *>) -> auto {
        if !isa(Cond) {
            return false;
        }
        let mut II: *mut IntrinsicInst = dyn_cast(Cond);
        if II.getIntrinsicID() != vector_reduce_or || !isa(II.getOperand(0).getType()) {
            return false;
        }
        if isa(II.getOperand(0)) {
            Ops.push(&mut II.getOperandUse(0));
        }
        return true;
    }

struct Closure_62 {}

fn Closure_62::call(self: *Closure_62, V: *mut Value) -> bool {
                let mut Ty: *mut VectorType = cast(V.getType());
                if Ty.isScalableTy() {
                    return false;
                }
                return Ty.getScalarSizeInBits() == 16 || Ty.getScalarSizeInBits() == 32;
            }

struct Closure_63 {
    Op: *mut Use,
}

unsafe fn Closure_63::call(self: *mut Closure_63, U: *mut Use) -> bool {
                    return U.get() == (*self.Op).operator llvm::Value *();
                }
