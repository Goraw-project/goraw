fn SVEIntrinsicInfo::setInactiveLanesAreNotDefined(self) -> *mut SVEIntrinsicInfo {
    assert!(self.ResultLanes == Uninitialized, "Cannot set property twice!");
    self.ResultLanes = InactiveLanesAreNotDefined;
