    if !Op1Info.isConstant() && !Op2Info.isConstant() {
        operator(Cost, 2);
    }
    operator+=(Cost, (PromotedTy));
    if IncludeTrunc {
        operator(Cost, self.getCastInstrCost(FPTrunc, Ty, PromotedTy, None, CostKind, null));
    }
    return Cost;
}

fn AArch64TTIImpl::getArithmeticInstrCost(self: *AArch64TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Op1Info: OperandValueInfo, Op2Info: OperandValueInfo, Args: ArrayRef<const Value *>, CtxI: *Instruction) -> InstructionCost {
