}

fn AArch64TTIImpl::enableMemCmpExpansion(self: *AArch64TTIImpl, OptSize: bool, IsZeroCmp: bool) -> MemCmpExpansionOptions {
    let mut Options: MemCmpExpansionOptions = MemCmpExpansionOptions {};
    if self.ST() {
        return Options;
    }
    Options.AllowOverlappingLoads = true;
    Options.MaxNumLoads = self.TLI.getMaxExpandSizeMemcmp;
    Options.NumLoadsPerBlock = if IsZeroCmp { Options.MaxNumLoads } else { 1 };
    Options() = void { 8, 4, 2, 1 };
    Options() = void { 3, 5, 6 };
    return Options;
}

