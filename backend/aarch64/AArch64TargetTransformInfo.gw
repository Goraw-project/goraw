fn SVEIntrinsicInfo::hasCmpPredicate(self: *SVEIntrinsicInfo) -> bool {
    return self.CmpPredicate != BAD_ICMP_PREDICATE;
}

fn SVEIntrinsicInfo::getCmpPredicate(self: *SVEIntrinsicInfo) -> Predicate {
    assert!(self.hasCmpPredicate(), "Property not set!");
    return self.CmpPredicate;
}

fn SVEIntrinsicInfo::setCmpPredicate(self, Pred: Predicate) -> *mut SVEIntrinsicInfo {
    assert!(!self.hasCmpPredicate(), "Cannot set property twice!");
    self.CmpPredicate = Pred;
    if isFPPredicate(Pred) {
        return self.setMatchingIROpcode(FCmp);
    }
    if isIntPredicate(Pred) {
        return self.setMatchingIROpcode(ICmp);
    }
    llvm_unreachable_internal("Unsupported compare predicate!", "llvm\\lib\\Target\\AArch64\\AArch64TargetTransformInfo.cpp", 1488);
}

fn SVEIntrinsicInfo::inactiveLanesTakenFromOperand(self: *SVEIntrinsicInfo) -> bool {
    return self.ResultLanes == InactiveLanesTakenFromOperand;
}

fn SVEIntrinsicInfo::getOperandIdxInactiveLanesTakenFrom(self: *SVEIntrinsicInfo) -> u32 {
    assert!(self.inactiveLanesTakenFromOperand(), "Property not set!");
    return self.OperandIdxForInactiveLanes;
}

fn SVEIntrinsicInfo::setOperandIdxInactiveLanesTakenFrom(self, Index: u32) -> *mut SVEIntrinsicInfo {
    assert!(self.ResultLanes == Uninitialized, "Cannot set property twice!");
    self.ResultLanes = InactiveLanesTakenFromOperand;
    self.OperandIdxForInactiveLanes = Index;
    return *self;
}

fn SVEIntrinsicInfo::inactiveLanesAreNotDefined(self: *SVEIntrinsicInfo) -> bool {
    return self.ResultLanes == InactiveLanesAreNotDefined;
