fn instCombineSVELD1(IC: *mut InstCombiner, II: *mut IntrinsicInst, DL: *DataLayout) -> optional<Instruction *> {
    let mut Pred: *mut Value = II.getOperand(0);
    let mut PtrOp: *mut Value = II.getOperand(1);
    let mut VecTy: *mut Type = II.getType();
    if isAllActivePredicate(Pred) {
        let mut Load: *mut LoadInst = IC.Builder.CreateLoad(VecTy, PtrOp, "");
        Load.copyMetadata(II, ArrayRef<unsigned int> {});
        return IC.replaceInstUsesWith(II, Load);
    }
    let mut MaskedLoad: *mut CallInst = IC.Builder.CreateMaskedLoad(VecTy, PtrOp, PtrOp.getPointerAlignment(DL), Pred, get(VecTy), "");
    MaskedLoad.copyMetadata(II, ArrayRef<unsigned int> {});
    return IC.replaceInstUsesWith(II, MaskedLoad);
}

fn instCombineSVEST1(IC: *mut InstCombiner, II: *mut IntrinsicInst, DL: *DataLayout) -> optional<Instruction *> {
    let mut VecOp: *mut Value = II.getOperand(0);
    let mut Pred: *mut Value = II.getOperand(1);
    let mut PtrOp: *mut Value = II.getOperand(2);
    if isAllActivePredicate(Pred) {
        let mut Store: *mut StoreInst = IC.Builder.CreateStore(VecOp, PtrOp, false);
        Store.copyMetadata(II, ArrayRef<unsigned int> {});
        return IC.eraseInstFromFunction(II);
    }
    let mut MaskedStore: *mut CallInst = IC.Builder.CreateMaskedStore(VecOp, PtrOp, PtrOp.getPointerAlignment(DL), Pred);
    MaskedStore.copyMetadata(II, ArrayRef<unsigned int> {});
    return IC.eraseInstFromFunction(II);
}

fn intrinsicIDToBinOpCode(Intrinsic: u32) -> BinaryOps {
    match Intrinsic {
        aarch64_sve_fmul_u => {
            return FMul;
        },
        aarch64_sve_fadd_u => {
            return FAdd;
        },
        aarch64_sve_fsub_u => {
            return FSub;
        },
        _ => {
            return BinaryOpsEnd;
        },
    }
}

fn instCombineSVEVectorBinOp(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if II.isStrictFP() {
        return nullopt;
    }
    let mut OpPredicate: *mut Value = II.getOperand(0);
    let mut BinOpCode: BinaryOps = intrinsicIDToBinOpCode(II.getIntrinsicID());
    if BinOpCode == BinaryOpsEnd || !isAllActivePredicate(OpPredicate) {
        return nullopt;
    }
    let mut BinOp: *mut Value = IC.Builder.CreateBinOpFMF(BinOpCode, II.getOperand(1), II.getOperand(2), II.getFastMathFlags(), "", null);
    return IC.replaceInstUsesWith(II, BinOp);
}

fn instCombineSVEVectorMlaU(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    assert!(II.getIntrinsicID() == aarch64_sve_mla_u, "Expected MLA_U intrinsic");
    let mut Acc: *mut Value = II.getArgOperand(1);
    let mut MulOp0: *mut Value = II.getArgOperand(2);
    let mut MulOp1: *mut Value = II.getArgOperand(3);
    if match(MulOp0, m_One()) {
        return IC.replaceInstUsesWith(II, IC.Builder.CreateAdd(Acc, MulOp1, "", false, false));
    }
    if match(MulOp1, m_One()) {
        return IC.replaceInstUsesWith(II, IC.Builder.CreateAdd(Acc, MulOp0, "", false, false));
    }
    if match(MulOp0, m_AllOnes()) {
        return IC.replaceInstUsesWith(II, IC.Builder.CreateSub(Acc, MulOp1, "", false, false));
    }
    if match(MulOp1, m_AllOnes()) {
        return IC.replaceInstUsesWith(II, IC.Builder.CreateSub(Acc, MulOp0, "", false, false));
    }
    if isa(MulOp0) && !isa(MulOp1) {
        II.setArgOperand(2, MulOp1);
        II.setArgOperand(3, MulOp0);
        return &mut II;
    }
    return nullopt;
}

fn instCombineSVEPairwiseAddLong(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    assert!((II.getIntrinsicID() == aarch64_sve_sadalp || II.getIntrinsicID() == aarch64_sve_uadalp), "Expected SADALP or UADALP intrinsic");
    let mut User: *mut Instruction = dyn_cast_or_null(II.getUniqueUndroppableUser());
    if !User || !match(II.getArgOperand(1), m_Zero()) {
        return nullopt;
    }
    let mut Acc: *mut Value = null;
    if !match(User, m_c_Add(m_Specific(&mut II), m_Value(Acc))) {
        return nullopt;
    }
    IC.Builder.SetInsertPoint(User);
    let mut PairwiseAddLong: *mut Value = IC.Builder.CreateIntrinsic(II.getIntrinsicID(), [II.getType()], [II.getArgOperand(0), Acc, II.getArgOperand(2)], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_23 {}, null, null });
    IC.replaceInstUsesWith(*User, PairwiseAddLong);
    IC.eraseInstFromFunction(*User);
    return &mut II;
}

fn instCombineSVEVectorAdd(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        MLA;
    } else {
        return MLA;
    }
    if instCombineSVEVectorFuseMulAddSub(IC, II, false) {
        MAD;
    } else {
        return MAD;
    }
    return nullopt;
}

fn instCombineSVEVectorFAdd(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        FMLA;
    } else {
        return FMLA;
    }
    if instCombineSVEVectorFuseMulAddSub(IC, II, false) {
        FMAD;
    } else {
        return FMAD;
    }
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        FMLA;
    } else {
        return FMLA;
    }
    return nullopt;
}

fn instCombineSVEVectorFAddU(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        FMLA;
    } else {
        return FMLA;
    }
    if instCombineSVEVectorFuseMulAddSub(IC, II, false) {
        FMAD;
    } else {
        return FMAD;
    }
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        FMLA_U;
    } else {
        return FMLA_U;
    }
    return instCombineSVEVectorBinOp(IC, II);
}

fn instCombineSVEVectorFSub(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        FMLS;
    } else {
        return FMLS;
    }
    if instCombineSVEVectorFuseMulAddSub(IC, II, false) {
        FMSB;
    } else {
        return FMSB;
    }
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        FMLS;
    } else {
        return FMLS;
    }
    return nullopt;
}

fn instCombineSVEVectorFSubU(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        FMLS;
    } else {
        return FMLS;
    }
    if instCombineSVEVectorFuseMulAddSub(IC, II, false) {
        FMSB;
    } else {
        return FMSB;
    }
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        FMLS_U;
    } else {
        return FMLS_U;
    }
    return instCombineSVEVectorBinOp(IC, II);
}

fn instCombineSVEVectorSub(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if instCombineSVEVectorFuseMulAddSub(IC, II, true) {
        MLS;
    } else {
        return MLS;
    }
    return nullopt;
}

fn instCombineSVEUnpack(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut UnpackArg: *mut Value = II.getArgOperand(0);
    let mut RetTy: *mut ScalableVectorType = cast(II.getType());
    let mut IsSigned: bool = II.getIntrinsicID() == aarch64_sve_sunpkhi || II.getIntrinsicID() == aarch64_sve_sunpklo;
    if getSplatValue(UnpackArg) {
        ScalarArg;
    } else {
        ScalarArg = IC.Builder.CreateIntCast(ScalarArg, RetTy.getScalarType(), IsSigned, "");
        let mut NewVal: *mut Value = IC.Builder.CreateVectorSplat(RetTy.getElementCount(), ScalarArg, "");
        NewVal.takeName(&mut II);
        return IC.replaceInstUsesWith(II, NewVal);
    }
    return nullopt;
}

fn instCombineSVETBL(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut OpVal: *mut Value = II.getOperand(0);
    let mut OpIndices: *mut Value = II.getOperand(1);
    let mut VTy: *mut VectorType = cast(II.getType());
    let mut SplatValue: *mut ConstantInt = dyn_cast_or_null(getSplatValue(OpIndices));
    if !SplatValue || SplatValue.getValue().uge(VTy.getElementCount().getKnownMinValue()) {
        return nullopt;
    }
    let mut Extract: *mut Value = IC.Builder.CreateExtractElement(OpVal, SplatValue, "");
    let mut VectorSplat: *mut Value = IC.Builder.CreateVectorSplat(VTy.getElementCount(), Extract, "");
    VectorSplat.takeName(&mut II);
    return IC.replaceInstUsesWith(II, VectorSplat);
}

fn instCombineSVEUzp1(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut RetTy: *mut Type = II.getType();
    let mut FromSVB: ID = aarch64_sve_convert_from_svbool;
    let mut ToSVB: ID = aarch64_sve_convert_to_svbool;
    if (match(II.getArgOperand(0), m_Intrinsic(m_Intrinsic(m_Value(A)))) && match(II.getArgOperand(1), m_Intrinsic(m_Intrinsic(m_Value(B))))) || (match(II.getArgOperand(0), m_Intrinsic(m_Value(A))) && match(II.getArgOperand(1), m_Intrinsic(m_Value(B)))) {
        let mut TyA: *mut ScalableVectorType = cast(A.getType());
        if TyA == B.getType() && RetTy == getDoubleElementsVectorType(TyA) {
            let mut SubVec: *mut Value = IC.Builder.CreateInsertVector(RetTy, get(RetTy), A, 0, "");
            let mut ConcatVec: *mut Value = IC.Builder.CreateInsertVector(RetTy, SubVec, B, TyA.getMinNumElements(), "");
            ConcatVec.takeName(&mut II);
            return IC.replaceInstUsesWith(II, ConcatVec);
        }
    }
    return nullopt;
}

fn instCombineSVEZip(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(II.getArgOperand(0), m_Intrinsic(m_Value(A), m_Value(B))) && match(II.getArgOperand(1), m_Intrinsic(m_Specific(A), m_Specific(B))) {
        return IC.replaceInstUsesWith(II, (if II.getIntrinsicID() == aarch64_sve_zip1 { A } else { B }));
    }
    return nullopt;
}

fn instCombineLD1GatherIndex(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Mask: *mut Value = II.getOperand(0);
    let mut BasePtr: *mut Value = II.getOperand(1);
    let mut Index: *mut Value = II.getOperand(2);
    let mut Ty: *mut Type = II.getType();
    let mut PassThru: *mut Value = get(Ty);
    let mut IndexBase: *mut Value = null;
    if match(Index, m_Intrinsic(m_Value(IndexBase), m_One())) {
        let mut Alignment: Align = BasePtr.getPointerAlignment(II.getDataLayout());
        let mut Ptr: *mut Value = IC.Builder.CreateGEP(cast(Ty).getElementType(), BasePtr, IndexBase, "", none());
        let mut MaskedLoad: *mut CallInst = IC.Builder.CreateMaskedLoad(Ty, Ptr, Alignment, Mask, PassThru, "");
        MaskedLoad.takeName(&mut II);
        return IC.replaceInstUsesWith(II, MaskedLoad);
    }
    return nullopt;
}

fn instCombineST1ScatterIndex(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Val: *mut Value = II.getOperand(0);
    let mut Mask: *mut Value = II.getOperand(1);
    let mut BasePtr: *mut Value = II.getOperand(2);
    let mut Index: *mut Value = II.getOperand(3);
    let mut Ty: *mut Type = Val.getType();
    let mut IndexBase: *mut Value = null;
    if match(Index, m_Intrinsic(m_Value(IndexBase), m_One())) {
        let mut Alignment: Align = BasePtr.getPointerAlignment(II.getDataLayout());
        let mut Ptr: *mut Value = IC.Builder.CreateGEP(cast(Ty).getElementType(), BasePtr, IndexBase, "", none());
        IC.Builder.CreateMaskedStore(Val, Ptr, Alignment, Mask) as void;
        return IC.eraseInstFromFunction(II);
    }
    return nullopt;
}

fn instCombineSVESDIV(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Int32Ty: *mut Type = IC.Builder.getInt32Ty();
    let mut Pred: *mut Value = II.getOperand(0);
    let mut Vec: *mut Value = II.getOperand(1);
    let mut DivVec: *mut Value = II.getOperand(2);
    let mut SplatValue: *mut Value = getSplatValue(DivVec);
    let mut SplatConstantInt: *mut ConstantInt = dyn_cast_or_null(SplatValue);
    if !SplatConstantInt {
        return nullopt;
    }
    let mut Divisor: APInt = SplatConstantInt.getValue();
    let mut DivisorValue: i64 = Divisor.getSExtValue();
    if DivisorValue == -1 {
        return nullopt;
    }
    if DivisorValue == 1 {
        IC.replaceInstUsesWith(II, Vec);
    }
    if Divisor.isPowerOf2() {
        let mut DivisorLog2: *mut Constant = get(Int32Ty, Divisor.logBase2(), false, false);
        let mut ASRD: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_asrd, [II.getType()], [Pred, Vec, DivisorLog2], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_24 {}, null, null });
        return IC.replaceInstUsesWith(II, ASRD);
    }
    if Divisor.isNegatedPowerOf2() {
        Divisor.negate();
        let mut DivisorLog2: *mut Constant = get(Int32Ty, Divisor.logBase2(), false, false);
        let mut ASRD: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_asrd, [II.getType()], [Pred, Vec, DivisorLog2], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_25 {}, null, null });
        let mut NEG: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_neg, [ASRD.getType()], [ASRD, Pred, ASRD], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_26 {}, null, null });
        return IC.replaceInstUsesWith(II, NEG);
    }
    return nullopt;
}

fn SimplifyValuePattern(Vec: *mut SmallVector<Value *>, AllowPoison: bool) -> bool {
    let mut VecSize: u64 = Vec.len;
    if VecSize == 1 {
        return true;
    }
    if !isPowerOf2_64(VecSize) {
        return false;
    }
    let mut HalfVecSize: u64 = VecSize / 2;
    for let mut LHS: iterator = Vec.begin();
let mut RHS: iterator = Vec.begin() + HalfVecSize; RHS != Vec.end(); LHS += 1 , RHS += 1 {
        if *LHS != null && *RHS != null {
            if *LHS == *RHS {
                continue;
            } else {
                return false;
            }
        }
        if !AllowPoison {
            return false;
        }
        if *LHS == null && *RHS != null {
            *LHS = *RHS;
        }
    }
    Vec.resize(HalfVecSize);
    SimplifyValuePattern(Vec, AllowPoison);
    return true;
}

fn instCombineSVEDupqLane(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut CurrentInsertElt: *mut Value = null;
    let mut Default: *mut Value = null;
    if !match(II.getOperand(0), m_Intrinsic(m_Value(Default), m_Value(CurrentInsertElt), m_Value())) || !isa(CurrentInsertElt.getType()) {
        return nullopt;
    }
    let mut IIScalableTy: CastReturnType = cast(II.getType());
    let mut Elts: SmallVector<Value *> = SmallVector<Value *> { IIScalableTy.getMinNumElements(), null };
    while dyn_cast(CurrentInsertElt) {
        InsertElt;
    }
    let mut AllowPoison: bool = isa(CurrentInsertElt) && isa(Default);
    if !SimplifyValuePattern(Elts, AllowPoison) {
        return nullopt;
    }
    let mut InsertEltChain: *mut Value = get(CurrentInsertElt.getType());
    for let mut I: u64 = 0; I < Elts.len; I += 1 {
        if Elts[I] == null {
            continue;
        }
        InsertEltChain = IC.Builder.CreateInsertElement(InsertEltChain, Elts[I], IC.Builder.getInt64(I), "");
    }
    if InsertEltChain == null {
        return nullopt;
    }
    let mut PatternWidth: u32 = IIScalableTy.getScalarSizeInBits() * Elts.len;
    let mut PatternElementCount: u32 = IIScalableTy.getScalarSizeInBits() * IIScalableTy.getMinNumElements() / PatternWidth;
    let mut WideTy: *mut IntegerType = IC.Builder.getIntNTy(PatternWidth);
    let mut WideScalableTy: *mut ScalableVectorType = get(WideTy, PatternElementCount);
    let mut WideShuffleMaskTy: *mut ScalableVectorType = get(IC.Builder.getInt32Ty(), PatternElementCount);
    let mut InsertSubvector: *mut Value = IC.Builder.CreateInsertVector(II.getType(), get(II.getType()), InsertEltChain, 0, "");
    let mut WideBitcast: *mut Value = IC.Builder.CreateBitOrPointerCast(InsertSubvector, WideScalableTy, "");
    let mut WideShuffleMask: *mut ConstantAggregateZero = get(WideShuffleMaskTy);
    let mut WideShuffle: *mut Value = IC.Builder.CreateShuffleVector(WideBitcast, get(WideScalableTy), WideShuffleMask, "");
    let mut NarrowBitcast: *mut Value = IC.Builder.CreateBitOrPointerCast(WideShuffle, II.getType(), "");
    return IC.replaceInstUsesWith(II, NarrowBitcast);
}

fn instCombineMaxMinNM(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut A: *mut Value = II.getArgOperand(0);
    let mut B: *mut Value = II.getArgOperand(1);
    if A == B {
        return IC.replaceInstUsesWith(II, A);
    }
    return nullopt;
}

fn instCombineSVESrshl(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Pred: *mut Value = II.getOperand(0);
    let mut Vec: *mut Value = II.getOperand(1);
    let mut Shift: *mut Value = II.getOperand(2);
    let mut AbsPred: *mut Value = null;
    let mut MergedValue: *mut Value = null;
    if !match(Vec, m_Intrinsic(m_Value(MergedValue), m_Value(AbsPred), m_Value())) && !match(Vec, m_Intrinsic(m_Value(MergedValue), m_Value(AbsPred), m_Value())) {
        return nullopt;
    }
    if !isa(MergedValue) && !match(MergedValue, m_NonNegative()) && AbsPred != Pred && !isAllActivePredicate(AbsPred) {
        return nullopt;
    }
    if !match(Shift, m_NonNegative()) {
        return nullopt;
    }
    let mut LSL: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_lsl, [II.getType()], [Pred, Vec, Shift], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_27 {}, null, null });
    return IC.replaceInstUsesWith(II, LSL);
}

fn instCombineSVEInsr(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Vec: *mut Value = II.getOperand(0);
    if getSplatValue(Vec) == II.getOperand(1) {
        return IC.replaceInstUsesWith(II, Vec);
    }
    return nullopt;
}

fn instCombineDMB(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut NI: *mut Instruction = II.getNextNode();
    let mut LookaheadThreshold: u32 = DMBLookaheadThreshold.operator unsigned int();
    let mut CanSkipOver: Closure_28 = Closure_28 {};
    while LookaheadThreshold -= 1 && CanSkipOver.call(NI) {
        let mut NIBB: *mut BasicBlock = NI.getParent();
        NI = NI.getNextNode();
        if !NI {
            if NIBB.getUniqueSuccessor() {
                SuccBB;
            } else {
                NI = &mut operator(SuccBB.getFirstNonPHIOrDbgOrLifetime(true));
            }
        }
    }
    let mut NextII: *mut IntrinsicInst = dyn_cast_or_null(NI);
    if NextII && II.isIdenticalTo(NextII) {
        return IC.eraseInstFromFunction(II);
    }
    return nullopt;
}

fn instCombineWhilelo(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    return IC.replaceInstUsesWith(II, IC.Builder.CreateIntrinsic(get_active_lane_mask, [II.getType(), II.getOperand(0).getType()], [II.getOperand(0), II.getOperand(1)], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_29 {}, null, null }));
}

fn instCombinePTrue(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut PredPattern: u32 = cast(II.getOperand(0)).getZExtValue();
    if PredPattern == all || PredPattern == pow2 {
        return IC.replaceInstUsesWith(II, getTrue(II.getType()));
    }
    return nullopt;
}

fn instCombineSVEUxt(IC: *mut InstCombiner, II: *mut IntrinsicInst, NumBits: u32) -> optional<Instruction *> {
    let mut Passthru: *mut Value = II.getOperand(0);
    let mut Pg: *mut Value = II.getOperand(1);
    let mut Op: *mut Value = II.getOperand(2);
    if isa(Passthru) || isAllActivePredicate(Pg) {
        let mut Ty: *mut VectorType = cast(II.getType());
        let mut MaskValue: APInt = getLowBitsSet(Ty.getScalarSizeInBits(), NumBits);
        let mut Mask: *mut Constant = get(Ty, MaskValue);
        let mut And: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_and_u, [Ty], [Pg, Op, Mask], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_30 {}, null, null });
        return IC.replaceInstUsesWith(II, And);
    }
    return nullopt;
}

fn instCombineInStreamingMode(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut FnSMEAttrs: SMEAttrs = SMEAttrs { *II.getFunction(), null };
    let mut IsStreaming: bool = FnSMEAttrs.hasStreamingInterfaceOrBody();
    if IsStreaming || !FnSMEAttrs.hasStreamingCompatibleInterface() {
        return IC.replaceInstUsesWith(II, getBool(II.getType(), IsStreaming));
    }
    return nullopt;
}

fn instCombineSVEUMin(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut UMinID: ID = aarch64_sve_umin_u;
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut Pg: *mut Value = II.getOperand(0);
    if match(II.getOperand(1), m_OneUse(m_Intrinsic(m_Specific(Pg), m_Value(A), m_One()))) && match(II.getOperand(2), m_OneUse(m_Intrinsic(m_Specific(Pg), m_Value(B), m_One()))) {
        let mut NewUMin: *mut Value = IC.Builder.CreateIntrinsic(UMinID, II.getType(), [Pg, A, B], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_31 {}, null, null });
        let mut NewLogicalUMin: *mut Value = IC.Builder.CreateIntrinsic(UMinID, II.getType(), [Pg, NewUMin, get(II.getType(), 1, false, false)], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_32 {}, null, null });
        return IC.replaceInstUsesWith(II, NewLogicalUMin);
    }
    if match(II.getOperand(1), m_Intrinsic(m_Specific(Pg), m_Value(), m_One())) && match(II.getOperand(2), m_One()) {
        return IC.replaceInstUsesWith(II, II.getOperand(1));
    }
    return nullopt;
}

fn instCombineSVEOrr(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut UMinID: ID = aarch64_sve_umin_u;
    let mut Pg: *mut Value = II.getOperand(0);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if !match(II.getOperand(1), m_OneUse(m_Intrinsic(m_Specific(Pg), m_Value(A), m_One()))) || !match(II.getOperand(2), m_OneUse(m_Intrinsic(m_Specific(Pg), m_Value(B), m_One()))) {
        return nullopt;
    }
    let mut NewOrr: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_orr_u, II.getType(), [Pg, A, B], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_33 {}, null, null });
    let mut NewUMin: *mut Value = IC.Builder.CreateIntrinsic(UMinID, II.getType(), [Pg, NewOrr, get(II.getType(), 1, false, false)], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_34 {}, null, null });
    return IC.replaceInstUsesWith(II, NewUMin);
}

fn instCombineSVEAnd(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut CmphsID: ID = aarch64_sve_cmphs;
    let mut Pg: *mut Value = II.getOperand(0);
    let mut LHS: *mut Value = II.getOperand(1);
    let mut RHS: *mut Value = II.getOperand(2);
    let mut A: *mut Value = null;
    let mut PgLHS: *mut Value = null;
    let mut PgRHS: *mut Value = null;
    let mut ConstA: u64 = 0;
    let mut ConstB: u64 = 0;
    if !match(LHS, m_Intrinsic(m_Value(PgLHS), m_ConstantInt(ConstA), m_Value(A))) || !match(RHS, m_Intrinsic(m_Value(PgRHS), m_Specific(A), m_ConstantInt(ConstB))) || !LHS.hasOneUser() || !RHS.hasOneUser() {
        return nullopt;
    }
    if ConstB > ConstA {
        return IC.replaceInstUsesWith(II, getNullValue(II.getType()));
    }
    if PgLHS != PgRHS || (Pg != LHS && Pg != RHS && Pg != PgLHS) {
        return nullopt;
    }
    let mut VecTy: *mut Type = A.getType();
    let mut Base: *mut Constant = get(VecTy, ConstB, false, false);
    let mut Sub: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_sub_u, VecTy, [PgLHS, A, Base], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_35 {}, null, null });
    let mut Limit: *mut Constant = get(VecTy, ConstA - ConstB, false, false);
    let mut NewCmphs: *mut Value = IC.Builder.CreateIntrinsic(CmphsID, VecTy, [PgLHS, Limit, Sub], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_36 {}, null, null });
    return IC.replaceInstUsesWith(II, NewCmphs);
}

fn AArch64TTIImpl::instCombineIntrinsic(self: *AArch64TTIImpl, IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut IInfo: *SVEIntrinsicInfo = constructSVEIntrinsicInfo(II);
    if simplifySVEIntrinsic(IC, II, IInfo) {
        I;
    } else {
        return I;
    }
    let mut IID: ID = II.getIntrinsicID();
    match IID {
        _ => {
            break;
        },
        aarch64_dmb => {
            return instCombineDMB(IC, II);
        },
        aarch64_neon_fmaxnm => {
            aarch64_neon_fminnm;
        },
        aarch64_sve_convert_from_svbool => {
            return instCombineConvertFromSVBool(IC, II);
        },
        aarch64_sve_dup => {
            return instCombineSVEDup(IC, II);
        },
        aarch64_sve_dup_x => {
            return instCombineSVEDupX(IC, II);
        },
        aarch64_sve_cmpeq => {
            aarch64_sve_cmpeq_wide;
        },
        aarch64_sve_cmpne => {
            aarch64_sve_cmpne_wide;
        },
        aarch64_sve_rdffr => {
            return instCombineRDFFR(IC, II);
        },
        aarch64_sve_lasta => {
            aarch64_sve_lastb;
        },
        aarch64_sve_clasta_n => {
            aarch64_sve_clastb_n;
        },
        aarch64_sve_cntd => {
            return instCombineSVECntElts(IC, II, 2);
        },
        aarch64_sve_cntw => {
            return instCombineSVECntElts(IC, II, 4);
        },
        aarch64_sve_cnth => {
            return instCombineSVECntElts(IC, II, 8);
        },
        aarch64_sve_cntb => {
            return instCombineSVECntElts(IC, II, 16);
        },
        aarch64_sme_cntsd => {
            return instCombineSMECntsd(IC, II, self.ST);
        },
        aarch64_sve_ptest_any => {
            aarch64_sve_ptest_first;
        },
        aarch64_sve_fadd => {
            return instCombineSVEVectorFAdd(IC, II);
        },
        aarch64_sve_fadd_u => {
            return instCombineSVEVectorFAddU(IC, II);
        },
        aarch64_sve_fmul_u => {
            return instCombineSVEVectorBinOp(IC, II);
        },
        aarch64_sve_fsub => {
            return instCombineSVEVectorFSub(IC, II);
        },
        aarch64_sve_fsub_u => {
            return instCombineSVEVectorFSubU(IC, II);
        },
        aarch64_sve_add => {
            return instCombineSVEVectorAdd(IC, II);
        },
        aarch64_sve_add_u => {
            return instCombineSVEVectorFuseMulAddSub(IC, II, true);
        },
        aarch64_sve_mla_u => {
            return instCombineSVEVectorMlaU(IC, II);
        },
        aarch64_sve_sadalp => {
            aarch64_sve_uadalp;
        },
        aarch64_sve_sub => {
            return instCombineSVEVectorSub(IC, II);
        },
        aarch64_sve_sub_u => {
            return instCombineSVEVectorFuseMulAddSub(IC, II, true);
        },
        aarch64_sve_tbl => {
            return instCombineSVETBL(IC, II);
        },
        aarch64_sve_uunpkhi => {
            aarch64_sve_uunpklo;
        },
        aarch64_sve_uzp1 => {
            return instCombineSVEUzp1(IC, II);
        },
        aarch64_sve_zip1 => {
            aarch64_sve_zip2;
        },
        aarch64_sve_ld1_gather_index => {
            return instCombineLD1GatherIndex(IC, II);
        },
        aarch64_sve_st1_scatter_index => {
            return instCombineST1ScatterIndex(IC, II);
        },
        aarch64_sve_ld1 => {
            return instCombineSVELD1(IC, II, self.DL);
        },
        aarch64_sve_st1 => {
            return instCombineSVEST1(IC, II, self.DL);
        },
        aarch64_sve_sdiv => {
            return instCombineSVESDIV(IC, II);
        },
        aarch64_sve_sel => {
            return instCombineSVESel(IC, II);
        },
        aarch64_sve_srshl => {
            return instCombineSVESrshl(IC, II);
        },
        aarch64_sve_dupq_lane => {
            return instCombineSVEDupqLane(IC, II);
        },
        aarch64_sve_insr => {
            return instCombineSVEInsr(IC, II);
        },
        aarch64_sve_whilelo => {
            return instCombineWhilelo(IC, II);
        },
        aarch64_sve_ptrue => {
            return instCombinePTrue(IC, II);
        },
        aarch64_sve_uxtb => {
            return instCombineSVEUxt(IC, II, 8);
        },
        aarch64_sve_uxth => {
            return instCombineSVEUxt(IC, II, 16);
        },
        aarch64_sve_uxtw => {
            return instCombineSVEUxt(IC, II, 32);
        },
        aarch64_sme_in_streaming_mode => {
            return instCombineInStreamingMode(IC, II);
        },
        aarch64_sve_umin_u => {
            return instCombineSVEUMin(IC, II);
        },
        aarch64_sve_orr_u => {
            return instCombineSVEOrr(IC, II);
        },
        aarch64_sve_and_z => {
            return instCombineSVEAnd(IC, II);
        },
    }
    return nullopt;
}

fn AArch64TTIImpl::simplifyDemandedVectorEltsIntrinsic(self: *AArch64TTIImpl, IC: *mut InstCombiner, II: *mut IntrinsicInst, OrigDemandedElts: APInt, UndefElts: *mut APInt, UndefElts2: *mut APInt, UndefElts3: *mut APInt, SimplifyAndSetOp: function<void (Instruction *, unsigned int, APInt, APInt &)>) -> optional<Value *> {
    match II.getIntrinsicID() {
        _ => {
            break;
        },
        aarch64_neon_fcvtxn => {
            aarch64_neon_rshrn;
        },
    }
    return nullopt;
}

fn AArch64TTIImpl::enableScalableVectorization(self: *AArch64TTIImpl) -> bool {
    return self.ST.isSVEAvailable() || (self.ST.isSVEorStreamingSVEAvailable() && EnableScalableAutovecInStreamingMode);
}

fn AArch64TTIImpl::getRegisterBitWidth(self: *AArch64TTIImpl, K: RegisterKind) -> TypeSize {
    match K {
        RGK_Scalar => {
            return getFixed(64);
        },
        RGK_FixedWidthVector => {
            if self.ST.useSVEForFixedLengthVectors() && (self.ST.isSVEAvailable() || EnableFixedwidthAutovecInStreamingMode) {
                return getFixed(if self.ST.getMinSVEVectorSizeInBits() > 128 { self.ST.getMinSVEVectorSizeInBits() } else { 128 });
            } else if self.ST.isNeonAvailable() {
                return getFixed(128);
            } else {
                return getFixed(0);
            }
        },
        RGK_ScalableVector => {
            if self.ST.isSVEAvailable() || (self.ST.isSVEorStreamingSVEAvailable() && EnableScalableAutovecInStreamingMode) {
                return getScalable(128);
            } else {
                return getScalable(0);
            }
        },
    }
    llvm_unreachable_internal("Unsupported register kind", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64TargetTransformInfo.cpp", 3698);
}

fn AArch64TTIImpl::isSingleExtWideningInstruction(self: *AArch64TTIImpl, Opcode: u32, DstTy: *mut Type, Args: ArrayRef<const Value *>, SrcOverrideTy: *mut Type) -> bool {
    let mut toVectorTy: Closure_37 = Closure_37 { DstTy: &mut DstTy };
    let mut DstEltSize: u32 = DstTy.getScalarSizeInBits();
    if !self.useNeonVector(DstTy) || Args.len != 2 || (DstEltSize != 16 && DstEltSize != 32 && DstEltSize != 64) {
        return false;
    }
    let mut SrcTy: *mut Type = SrcOverrideTy;
    match Opcode {
        Add => {
            Sub;
        },
        _ => {
            return false;
        },
    }
    let mut DstTyL: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(DstTy);
    if !DstTyL.second.isVector() || DstEltSize != DstTy.getScalarSizeInBits() {
        return false;
    }
    assert!(SrcTy, "Expected some SrcTy");
    let mut SrcTyL: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(SrcTy);
    let mut SrcElTySize: u32 = SrcTyL.second.getScalarSizeInBits();
    if !SrcTyL.second.isVector() || SrcElTySize != SrcTy.getScalarSizeInBits() {
        return false;
    }
    let mut NumDstEls: InstructionCost = DstTyL.first * DstTyL.second.getVectorMinNumElements();
    let mut NumSrcEls: InstructionCost = SrcTyL.first * SrcTyL.second.getVectorMinNumElements();
    return NumDstEls == NumSrcEls && 2 * SrcElTySize == DstEltSize;
}

fn AArch64TTIImpl::isBinExtWideningInstruction(self: *AArch64TTIImpl, Opcode: u32, DstTy: *mut Type, Args: ArrayRef<const Value *>, SrcOverrideTy: *mut Type) -> *mut Type {
    if Opcode != Add && Opcode != Sub && Opcode != Mul {
        return null;
    }
    let mut DstEltSize: u32 = DstTy.getScalarSizeInBits();
    if !self.useNeonVector(DstTy) || Args.len != 2 || (DstEltSize != 16 && DstEltSize != 32 && DstEltSize != 64) {
        return null;
    }
    let mut getScalarSizeWithOverride: Closure_38 = Closure_38 { SrcOverrideTy: &mut SrcOverrideTy };
    let mut MaxEltSize: u32 = 0;
    if (isa(Args[0]) && isa(Args[1])) || (isa(Args[0]) && isa(Args[1])) {
        let mut EltSize0: u32 = getScalarSizeWithOverride.call(Args[0]);
        let mut EltSize1: u32 = getScalarSizeWithOverride.call(Args[1]);
        MaxEltSize = if EltSize0 > EltSize1 { EltSize0 } else { EltSize1 };
    } else if isa(Args[0]) && isa(Args[1]) {
        let mut EltSize0: u32 = getScalarSizeWithOverride.call(Args[0]);
        let mut EltSize1: u32 = getScalarSizeWithOverride.call(Args[1]);
        if EltSize0 >= DstEltSize / 2 || EltSize1 >= DstEltSize / 2 {
            return null;
        }
        MaxEltSize = DstEltSize / 2;
    } else if Opcode == Mul && (isa(Args[0]) || isa(Args[1])) {
        let mut Known: KnownBits = computeKnownBits(if isa(Args[0]) { Args[1] } else { Args[0] }, self.DL, null, null, null, true, 0);
        if Args[0].getType().getScalarSizeInBits() - Known.Zero.countLeadingOnes() > DstTy.getScalarSizeInBits() / 2 {
            return null;
        }
        MaxEltSize = getScalarSizeWithOverride.call(if isa(Args[0]) { Args[0] } else { Args[1] });
    } else {
        return null;
    }
    if MaxEltSize * 2 > DstEltSize {
        return null;
    }
    let mut ExtTy: *mut Type = DstTy.getWithNewBitWidth(MaxEltSize * 2);
    if ExtTy.getPrimitiveSizeInBits().operator unsigned long long() <= 64 {
        return null;
    }
    return ExtTy;
}

fn AArch64TTIImpl::isExtPartOfAvgExpr(self: *AArch64TTIImpl, ExtUser: *Instruction, Dst: *mut Type, Src: *mut Type) -> bool {
    if !Src.isVectorTy() || !self.TLI.isTypeLegal(self.TLI.getValueType(self.DL, Src, false)) || (Src.isScalableTy() && !self.ST.hasSVE2()) {
        return false;
    }
    if ExtUser.getOpcode() != Add || !ExtUser.hasOneUse() {
        return false;
    }
    let mut Add: *Instruction = ExtUser;
    let mut AddUser: *Instruction = dyn_cast_or_null(Add.getUniqueUndroppableUser());
    if AddUser && AddUser.getOpcode() == Add {
        Add = AddUser;
    }
    let mut Shr: *Instruction = dyn_cast_or_null(Add.getUniqueUndroppableUser());
    if !Shr || Shr.getOpcode() != LShr {
        return false;
    }
    let mut Trunc: *Instruction = dyn_cast_or_null(Shr.getUniqueUndroppableUser());
    if !Trunc || Trunc.getOpcode() != Trunc || Src.getScalarSizeInBits() != cast(Trunc).getDestTy().getScalarSizeInBits() {
        return false;
    }
    let mut Ex1: *mut Instruction = null;
    let mut Ex2: *mut Instruction = null;
    if !(match(Add, m_c_Add(m_Instruction(Ex1), m_c_Add(m_Instruction(Ex2), m_One())))) {
        return false;
    }
    if match(Ex1, m_ZExtOrSExt(m_Value())) && Ex1.getOpcode() == Ex2.getOpcode() {
        return true;
    }
    return false;
}

fn AArch64TTIImpl::getCastInstrCost(self: *AArch64TTIImpl, Opcode: u32, Dst: *mut Type, Src: *mut Type, CCH: CastContextHint, CostKind: TargetCostKind, I: *Instruction) -> InstructionCost {
    let mut ISD: i32 = self.TLI.InstructionOpcodeToISD(Opcode);
    assert!(ISD, "Invalid opcode");
    if I && !I.users().is_empty() {
        let mut GetUserAbsorbedCastCost: Closure_39 = Closure_39 { cap_0: self, Dst: &mut Dst, Src: &mut Src, I: &mut I, Opcode: &mut Opcode, CostKind: &mut CostKind };
        let mut MaxAbsorbedCost: InstructionCost = 0;
        let mut AllUsersAbsorbCast: bool = true;
        for U in I.users() {
            let mut Usr: *Instruction = cast(U);
            let mut UserCost: optional<InstructionCost> = GetUserAbsorbedCastCost.call(Usr);
            if !UserCost {
                AllUsersAbsorbCast = false;
                break;
            }
            MaxAbsorbedCost = if MaxAbsorbedCost > operator(UserCost) { MaxAbsorbedCost } else { operator(UserCost) };
        }
        if AllUsersAbsorbCast {
            return MaxAbsorbedCost;
        }
    }
    let mut SrcTy: EVT = self.TLI.getValueType(self.DL, Src, false);
    let mut DstTy: EVT = self.TLI.getValueType(self.DL, Dst, false);
    if (ISD == ZERO_EXTEND || ISD == SIGN_EXTEND) && DstTy.getScalarSizeInBits() > 64 && SrcTy.getScalarSizeInBits() <= 64 && DstTy.isFixedLengthVector() {
        let mut LaneCost: InstructionCost = self.getVectorInstrCost(ExtractElement, Src, CostKind, -1, null, null, None);
        let mut ExtCost: InstructionCost = self.getCastInstrCost(Opcode, Dst.getScalarType(), Src.getScalarType(), CCH, CostKind, null);
        return DstTy.getVectorNumElements() * (LaneCost + ExtCost);
    }
    if !SrcTy.isSimple() || !DstTy.isSimple() {
        return self.getCastInstrCost(Opcode, Dst, Src, CCH, CostKind, I);
    }
    if !self.ST.hasSVE2() && !self.ST.isStreamingSVEAvailable() && ISD == FP_ROUND && SrcTy.isScalableVector() && DstTy.getScalarType() == bf16 && SrcTy.getScalarType() == f64 {
        return getInvalid(0);
    }
