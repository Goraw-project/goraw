        },
        aarch64_sve_fnmls => {
            return defaultMergingOp(aarch64_sve_fnmls_u);
        },
        aarch64_sve_fsub => {
            return defaultMergingOp(aarch64_sve_fsub_u).setMatchingIROpcode(FSub);
        },
        aarch64_sve_add => {
