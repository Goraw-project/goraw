    let mut Limit: *mut Constant = get(VecTy, ConstA - ConstB, false, false);
    let mut NewCmphs: *mut Value = IC()(CmphsID, VecTy, void { PgLHS, Limit, Sub });
    return IC.replaceInstUsesWith;
}

