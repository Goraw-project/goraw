                return cast(Ty)()() * (self.getArithmeticInstrCost(Opcode, Ty.getScalarType(), CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, void {}, null) + self.getVectorInstrCost(ExtractElement, Ty, CostKind, -1, null, null, None) * 2 + self.getVectorInstrCost(InsertElement, Ty, CostKind, -1, null, null, None));
            }
