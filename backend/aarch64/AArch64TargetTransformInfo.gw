        }
        CandidatesForRemoval()();
        Cursor = (0);
    }
    if !EarliestReplacement {
        return nullopt();
    }
    return IC.replaceInstUsesWith;
}

fn instCombineSVESel(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
