nxv2f64, nxv2f16, 1 }, TypeConversionCostTblEntry { FP_EXTEND, nxv4f64, nxv4f16, 2 }, TypeConversionCostTblEntry { FP_EXTEND, nxv8f64, nxv8f16, 4 }, TypeConversionCostTblEntry { FP_EXTEND, nxv2f64, nxv2bf16, 2 }, TypeConversionCostTblEntry { FP_EXTEND, nxv4f64, nxv4bf16, 6 }, TypeConversionCostTblEntry { FP_EXTEND, nxv8f64, nxv8bf16, 14 }, TypeConversionCostTblEntry { FP_EXTEND, nxv2f64, nxv2f32, 1 }, TypeConversionCostTblEntry { FP_EXTEND, nxv4f64, nxv4f32, 2 }, TypeConversionCostTblEntry { FP_EXTEND, nxv8f64, nxv8f32, 6 }, TypeConversionCostTblEntry { BITCAST, nxv2f16, nxv2i16, 0 }, TypeConversionCostTblEntry { BITCAST, nxv4f16, nxv4i16, 0 }, TypeConversionCostTblEntry { BITCAST, nxv2f32, nxv2i32, 0 }, TypeConversionCostTblEntry { BITCAST, nxv2i16, nxv2f16, 0 }, TypeConversionCostTblEntry { BITCAST, nxv4i16, nxv4f16, 0 }, TypeConversionCostTblEntry { BITCAST, nxv2i32, nxv2f32, 0 }, TypeConversionCostTblEntry { ZERO_EXTEND, nxv16i16, nxv16i8, 2 }, TypeConversionCostTblEntry { ZERO_EXTEND, nxv16i32, nxv16i8, 6 }, TypeConversionCostTblEntry { ZERO_EXTEND, nxv16i64, nxv16i8, 14 }, TypeConversionCostTblEntry { ZERO_EXTEND, nxv8i32, nxv8i16, 2 }, TypeConversionCostTblEntry { ZERO_EXTEND, nxv8i64, nxv8i16, 6 }, TypeConversionCostTblEntry { ZERO_EXTEND, nxv4i64, nxv4i32, 2 }, TypeConversionCostTblEntry { SIGN_EXTEND, nxv16i16, nxv16i8, 2 }, TypeConversionCostTblEntry { SIGN_EXTEND, nxv16i32, nxv16i8, 6 }, TypeConversionCostTblEntry { SIGN_EXTEND, nxv16i64, nxv16i8, 14 }, TypeConversionCostTblEntry { SIGN_EXTEND, nxv8i32, nxv8i16, 2 }, TypeConversionCostTblEntry { SIGN_EXTEND, nxv8i64, nxv8i16, 6 }, TypeConversionCostTblEntry { SIGN_EXTEND, nxv4i64, nxv4i32, 2 }];
    if ConvertCostTableLookup(ConversionTbl, ISD, DstTy.getSimpleVT(), SrcTy.getSimpleVT()) {
        Entry;
    } else {
        return Entry.Cost;
    }
    let mut FP16Tbl: [22]TypeConversionCostTblEntry = [TypeConversionCostTblEntry { FP_TO_SINT, v4i8, v4f16, 1 }, TypeConversionCostTblEntry { FP_TO_UINT, v4i8, v4f16, 1 }, TypeConversionCostTblEntry { FP_TO_SINT, v4i16, v4f16, 1 }, TypeConversionCostTblEntry { FP_TO_UINT, v4i16, v4f16, 1 }, TypeConversionCostTblEntry { FP_TO_SINT, v4i32, v4f16, 2 }, TypeConversionCostTblEntry { FP_TO_UINT, v4i32, v4f16, 2 }, TypeConversionCostTblEntry { FP_TO_SINT, v8i8, v8f16, 2 }, TypeConversionCostTblEntry { FP_TO_UINT, v8i8, v8f16, 2 }, TypeConversionCostTblEntry { FP_TO_SINT, v8i16, v8f16, 1 }, TypeConversionCostTblEntry { FP_TO_UINT, v8i16, v8f16, 1 }, TypeConversionCostTblEntry { FP_TO_SINT, v8i32, v8f16, 4 }, TypeConversionCostTblEntry { FP_TO_UINT, v8i32, v8f16, 4 }, TypeConversionCostTblEntry { FP_TO_SINT, v16i8, v16f16, 3 }, TypeConversionCostTblEntry { FP_TO_UINT, v16i8, v16f16, 3 }, TypeConversionCostTblEntry { FP_TO_SINT, v16i16, v16f16, 2 }, TypeConversionCostTblEntry { FP_TO_UINT, v16i16, v16f16, 2 }, TypeConversionCostTblEntry { FP_TO_SINT, v16i32, v16f16, 8 }, TypeConversionCostTblEntry { FP_TO_UINT, v16i32, v16f16, 8 }, TypeConversionCostTblEntry { UINT_TO_FP, v8f16, v8i8, 2 }, TypeConversionCostTblEntry { SINT_TO_FP, v8f16, v8i8, 2 }, TypeConversionCostTblEntry { UINT_TO_FP, v16f16, v16i8, 4 }, TypeConversionCostTblEntry { SINT_TO_FP, v16f16, v16i8, 4 }];
    if self.ST.hasFullFP16() {
        if ConvertCostTableLookup(FP16Tbl, ISD, DstTy.getSimpleVT(), SrcTy.getSimpleVT()) {
            Entry;
        } else {
            return Entry.Cost;
        }
    }
    if (ISD == SINT_TO_FP || ISD == UINT_TO_FP) && DstTy.getScalarType() == f32 && SrcTy.getScalarSizeInBits() > 32 && isa(Dst) && isa(Src) {
        return cast(Dst).getNumElements() * self.getCastInstrCost(Opcode, Dst.getScalarType(), Src.getScalarType(), CCH, CostKind, null) + self.getScalarizationOverhead(cast(Src), false, true, CostKind, true, ArrayRef<Value *> {}, None) + self.getScalarizationOverhead(cast(Dst), true, false, CostKind, true, ArrayRef<Value *> {}, None);
    }
    if (ISD == ZERO_EXTEND || ISD == SIGN_EXTEND) && CCH == Masked && self.ST.isSVEorStreamingSVEAvailable() && self.TLI.getTypeAction(Src.getContext(), SrcTy) == TypePromoteInteger && self.TLI.getTypeAction(Dst.getContext(), DstTy) == TypeSplitVector {
        let mut SrcLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Src);
        let mut LegalTy: *mut Type = SrcLT.second.getTypeForEVT(Src.getContext());
        let mut Part1: InstructionCost = self.getCastInstrCost(Opcode, LegalTy, Src, CCH, CostKind, I);
        let mut Part2: InstructionCost = self.getCastInstrCost(Opcode, Dst, LegalTy, None, CostKind, I);
        return Part1 + Part2;
    }
    if (ISD == ZERO_EXTEND || ISD == SIGN_EXTEND) && CCH == Masked && self.ST.isSVEorStreamingSVEAvailable() && self.TLI.isTypeLegal(DstTy) {
        CCH = Normal;
    }
    return self.getCastInstrCost(Opcode, Dst, Src, CCH, CostKind, I);
}

fn AArch64TTIImpl::getExtractWithExtendCost(self: *AArch64TTIImpl, Opcode: u32, Dst: *mut Type, VecTy: *mut VectorType, Index: u32, CostKind: TargetCostKind) -> InstructionCost {
    assert!((Opcode == SExt || Opcode == ZExt), "Invalid opcode");
    let mut Src: *mut Type = VecTy.getElementType();
    assert!(isa(Dst) && isa(Src), "Invalid type");
    let mut Cost: InstructionCost = self.getVectorInstrCost(ExtractElement, VecTy, CostKind, Index, null, null, None);
    let mut VecLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(VecTy);
    let mut DstVT: EVT = self.TLI.getValueType(self.DL, Dst, false);
    let mut SrcVT: EVT = self.TLI.getValueType(self.DL, Src, false);
    if !VecLT.second.isVector() || !self.TLI.isTypeLegal(DstVT) {
        return Cost + self.getCastInstrCost(Opcode, Dst, Src, None, CostKind, null);
    }
    if DstVT.getFixedSizeInBits() < SrcVT.getFixedSizeInBits() {
        return Cost + self.getCastInstrCost(Opcode, Dst, Src, None, CostKind, null);
    }
    match Opcode {
        _ => {
            llvm_unreachable_internal("Opcode should be either SExt or ZExt", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64TargetTransformInfo.cpp", 4620);
        },
        SExt => {
            return Cost;
        },
        ZExt => {
            if DstVT.getSizeInBits().operator unsigned long long() != 64 || SrcVT.getSizeInBits().operator unsigned long long() == 32 {
                return Cost;
            }
        },
    }
    return Cost + self.getCastInstrCost(Opcode, Dst, Src, None, CostKind, null);
}

fn AArch64TTIImpl::getCFInstrCost(self: *AArch64TTIImpl, Opcode: u32, CostKind: TargetCostKind, I: *Instruction) -> InstructionCost {
    if CostKind != TCK_RecipThroughput {
        return if Opcode == PHI { 0 } else { 1 };
    }
    assert!(CostKind == TCK_RecipThroughput, "unexpected CostKind");
    return 0;
}

fn AArch64TTIImpl::getVectorInstrCostHelper(self: *AArch64TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Index: u32, I: *Instruction, Scalar: *mut Value, ScalarUserAndIdx: tuple<Value *, User *, int>>, VIC: VectorInstrContext) -> InstructionCost {
    assert!(Ty.isVectorTy(), "This must be a vector type");
    if Index != -1 {
        let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Ty);
        if !LT.second.isVector() {
            return 0;
        }
        if LT.second.isFixedLengthVector() {
            let mut Width: u32 = LT.second.getVectorNumElements();
            Index = Index % Width;
        }
        if Index == 0 && !Ty.getScalarType().isIntegerTy() {
            return 0;
        }
        if self.ST.useSVEForFixedLengthVectors() {
            let mut Cost: InstructionCost = if CostKind == TCK_CodeSize { 1 } else { self.ST.getVectorInsertExtractBaseCost() };
            if Index * Ty.getScalarSizeInBits() < 128 {
                return Cost;
            }
            if Index * Ty.getScalarSizeInBits() < 512 && Opcode == ExtractElement {
                return if Ty.getScalarType().isIntegerTy() { Cost + 1 } else { Cost };
            }
            if Opcode == ExtractElement {
                return Cost + 2;
            }
            if Opcode == InsertElement {
                return Cost + 3;
            }
            llvm_unreachable_internal("unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64TargetTransformInfo.cpp", 4697);
        }
        if VIC == Load {
            if self.ST.hasFastLD1Single() {
                return 0;
            }
            return if CostKind == TCK_CodeSize { 0 } else { self.ST.getVectorInsertExtractBaseCost() + 1 };
        }
        if Ty.getScalarSizeInBits() == 1 {
            return if CostKind == TCK_CodeSize { 2 } else { self.ST.getVectorInsertExtractBaseCost() + 1 };
        }
    }
    let mut ExtractCanFuseWithFmul: Closure_40 = Closure_40 { Index: &mut Index, cap_1: self, Ty: &mut Ty, Scalar: &mut Scalar, ScalarUserAndIdx: &mut ScalarUserAndIdx, I: &mut I };
    if Opcode == ExtractElement && (I || Scalar) && ExtractCanFuseWithFmul.call() {
        return 0;
    }
    return if CostKind == TCK_CodeSize { 1 } else { self.ST.getVectorInsertExtractBaseCost() };
}

fn AArch64TTIImpl::getVectorInstrCost(self: *AArch64TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Index: u32, Op0: *Value, Op1: *Value, VIC: VectorInstrContext) -> InstructionCost {
    if Opcode == InsertElement && Index == 0 && Op0 && isa(Op0) {
        return 0;
    }
    return self.getVectorInstrCostHelper(Opcode, Ty, CostKind, Index, null, null, tuple<Value *, User *, int>> {}, VIC);
}

fn AArch64TTIImpl::getVectorInstrCost(self: *AArch64TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Index: u32, Scalar: *mut Value, ScalarUserAndIdx: tuple<Value *, User *, int>>, VIC: VectorInstrContext) -> InstructionCost {
    return self.getVectorInstrCostHelper(Opcode, Ty, CostKind, Index, null, Scalar, ScalarUserAndIdx, VIC);
}

fn AArch64TTIImpl::getVectorInstrCost(self: *AArch64TTIImpl, I: *Instruction, Ty: *mut Type, CostKind: TargetCostKind, Index: u32, VIC: VectorInstrContext) -> InstructionCost {
    return self.getVectorInstrCostHelper(I.getOpcode(), Ty, CostKind, Index, &mut I, null, tuple<Value *, User *, int>> {}, VIC);
}

fn AArch64TTIImpl::getIndexedVectorInstrCostFromEnd(self: *AArch64TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Index: u32) -> InstructionCost {
    if isa(Ty) {
        return self.getIndexedVectorInstrCostFromEnd(Opcode, Ty, CostKind, Index);
    }
    return if CostKind == TCK_CodeSize { 2 } else { self.ST.getVectorInsertExtractBaseCost() + 1 };
}

fn AArch64TTIImpl::getScalarizationOverhead(self: *AArch64TTIImpl, Ty: *mut VectorType, DemandedElts: *APInt, Insert: bool, Extract: bool, CostKind: TargetCostKind, ForPoisonSrc: bool, VL: ArrayRef<Value *>, VIC: VectorInstrContext) -> InstructionCost {
    if isa(Ty) {
        return getInvalid(0);
    }
    if Ty.getElementType().isFloatingPointTy() {
        return self.getScalarizationOverhead(Ty, DemandedElts, Insert, Extract, CostKind, true, ArrayRef<Value *> {}, None);
    }
    let mut VecInstCost: u32 = if CostKind == TCK_CodeSize { 1 } else { self.ST.getVectorInsertExtractBaseCost() };
    return DemandedElts.popcount() * (Insert + Extract) * VecInstCost;
}

fn AArch64TTIImpl::getFP16BF16PromoteCost(self: *AArch64TTIImpl, Ty: *mut Type, CostKind: TargetCostKind, Op1Info: OperandValueInfo, Op2Info: OperandValueInfo, IncludeTrunc: bool, CanUseSVE: bool, InstCost: function<InstructionCost (Type *)>) -> optional<InstructionCost> {
    if !Ty.getScalarType().isHalfTy() && !Ty.getScalarType().isBFloatTy() {
        return nullopt;
    }
    if Ty.getScalarType().isHalfTy() && self.ST.hasFullFP16() {
        return nullopt;
    }
    if CanUseSVE && self.ST.hasSVEB16B16() && self.ST.isNonStreamingSVEorSME2Available() {
        return nullopt;
    }
    let mut PromotedTy: *mut Type = Ty.getWithNewType(getFloatTy(Ty.getContext()));
    let mut Cost: InstructionCost = self.getCastInstrCost(FPExt, PromotedTy, Ty, None, CostKind, null);
    if !Op1Info.isConstant() && !Op2Info.isConstant() {
        operator(Cost, 2);
    }
    operator(Cost, InstCost.call(PromotedTy));
    if IncludeTrunc {
        operator(Cost, self.getCastInstrCost(FPTrunc, Ty, PromotedTy, None, CostKind, null));
    }
    return Cost;
}

fn AArch64TTIImpl::getArithmeticInstrCost(self: *AArch64TTIImpl, Opcode: u32, Ty: *mut Type, CostKind: TargetCostKind, Op1Info: OperandValueInfo, Op2Info: OperandValueInfo, Args: ArrayRef<const Value *>, CtxI: *Instruction) -> InstructionCost {
    let mut ISD: i32 = self.TLI.InstructionOpcodeToISD(Opcode);
    if dyn_cast(Ty) {
        VTy;
    } else if VTy.getElementCount() == getScalable(1) {
        if !is_contained([ADD, SUB, MUL], ISD) {
            return getInvalid(0);
        }
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Ty);
    if ISD == FADD || ISD == FSUB || ISD == FMUL || ISD == FDIV || ISD == FREM || ISD == FNEG {
        if CostKind != TCK_RecipThroughput {
            return self.getArithmeticInstrCost(Opcode, Ty, CostKind, Op1Info, Op2Info, Args, CtxI);
        }
    }
    if ISD == FADD || ISD == FSUB || ISD == FMUL || ISD == FDIV || ISD == FREM {
        if self.getFP16BF16PromoteCost(Ty, CostKind, Op1Info, Op2Info, true, ISD != FDIV && ISD != FREM, Closure_45 { cap_0: self, Opcode: &mut Opcode, CostKind: &mut CostKind, Op1Info: &mut Op1Info, Op2Info: &mut Op2Info }) {
            PromotedCost;
        } else {
            return operator(PromotedCost);
        }
        if Ty.getScalarType().isFP128Ty() {
            return (if CostKind == TCK_CodeSize { 1 } else { 10 }) * LT.first;
        }
    }
    if self.isBinExtWideningInstruction(Opcode, Ty, Args, null) {
        ExtTy;
    } else {
        if ExtTy != Ty {
            return self.getArithmeticInstrCost(Opcode, ExtTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null) + self.getCastInstrCost(ZExt, Ty, ExtTy, None, CostKind, null);
        }
        return LT.first;
    }
    match ISD {
        _ => {
            return self.getArithmeticInstrCost(Opcode, Ty, CostKind, Op1Info, Op2Info, ArrayRef<const Value *> {}, null);
        },
        ADD => {
            SUB;
        },
        MUL => {
            let mut Mul64CostFactor: u32 = if (CostKind == TCK_RecipThroughput && self.ST.hasLimited64bitVectorMulBandwidth()) { 4 } else { 1 };
            if Ty.getScalarSizeInBits() > 64 {
                let mut NumLanes: u32 = if isa(Ty) { cast(Ty).getNumElements() } else { 1 };
                let mut CostPerLane: InstructionCost = LT.first / NumLanes;
                return CostPerLane * CostPerLane * NumLanes * Mul64CostFactor;
            }
            if LT.second == v2i64 {
                if self.ST.hasSVE() {
                    return LT.first * Mul64CostFactor;
                }
                return cast(Ty).getElementCount().getKnownMinValue() * (self.getArithmeticInstrCost(Opcode, Ty.getScalarType(), CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null) + self.getVectorInstrCost(ExtractElement, Ty, CostKind, -1, null, null, None) * 2 + self.getVectorInstrCost(InsertElement, Ty, CostKind, -1, null, null, None));
            }
            if LT.second == nxv2i64 {
                return LT.first * Mul64CostFactor;
            }
            return LT.first;
        },
        SREM => {
            SDIV;
        },
        UDIV => {
            UREM;
        },
        XOR => {
            OR;
        },
        SRL => {
            SRA;
        },
        FNEG => {
            if (Ty.isFloatTy() || Ty.isDoubleTy() || (Ty.isHalfTy() && self.ST.hasFullFP16())) && CtxI && ((CtxI.hasOneUse() && match(operator(CtxI.user_begin()), m_FMul(m_Value(), m_Value()))) || match(CtxI.getOperand(0), m_FMul(m_Value(), m_Value()))) {
                return 0;
            }
        },
        FADD => {
            FSUB;
        },
        FMUL => {
            FDIV;
        },
        FREM => {
            if !Ty.isVectorTy() {
                return self.getCallInstrCost(null, Ty, [Ty, Ty], CostKind);
            }
        },
    }
}

fn AArch64TTIImpl::getAddressComputationCost(self: *AArch64TTIImpl, PtrTy: *mut Type, SE: *mut ScalarEvolution, Ptr: *SCEV, CostKind: TargetCostKind) -> InstructionCost {
    let mut NumVectorInstToHideOverhead: u32 = NeonNonConstStrideOverhead.operator unsigned int();
    let mut MaxMergeDistance: i32 = 64;
    if PtrTy.isVectorTy() && SE && !self.isConstantStridedAccessLessThan(SE, Ptr, MaxMergeDistance + 1) {
        return NumVectorInstToHideOverhead;
    }
    return 1;
}

fn AArch64TTIImpl::hasKnownLowerThroughputFromSchedulingModel(self: *AArch64TTIImpl, Opcode1: u32, Opcode2: u32) -> bool {
    let mut Sched: *MCSchedModel = self.ST.getSchedModel();
    let mut TII: *TargetInstrInfo = self.ST.getInstrInfo();
    if !Sched.hasInstrSchedModel() {
        return false;
    }
    let mut SCD1: *MCSchedClassDesc = Sched.getSchedClassDesc(TII.get(Opcode1).getSchedClass());
    let mut SCD2: *MCSchedClassDesc = Sched.getSchedClassDesc(TII.get(Opcode2).getSchedClass());
    assert!(!SCD1.isVariant() && !SCD2.isVariant(), "Cannot handle variant scheduling classes without an MI");
    if !SCD1.isValid() || !SCD2.isValid() {
        return false;
    }
    return getReciprocalThroughput(*self.ST, *SCD1) > getReciprocalThroughput(*self.ST, *SCD2);
}

fn AArch64TTIImpl::getCmpSelInstrCost(self: *AArch64TTIImpl, Opcode: u32, ValTy: *mut Type, CondTy: *mut Type, VecPred: Predicate, CostKind: TargetCostKind, Op1Info: OperandValueInfo, Op2Info: OperandValueInfo, I: *Instruction) -> InstructionCost {
    if isa(ValTy) && Opcode == Select {
        let mut AmortizationCost: i32 = 20;
        if VecPred == BAD_ICMP_PREDICATE && I && I.getType() == ValTy {
            let mut CurrentPred: CmpPredicate = CmpPredicate {};
            if match(I, m_Select(m_Cmp(CurrentPred, m_Value(), m_Value()), m_Value(), m_Value())) {
                VecPred = CurrentPred.operator llvm::CmpInst::Predicate();
            }
        }
        if isIntPredicate(VecPred) || VecPred == FCMP_OLE || VecPred == FCMP_OLT || VecPred == FCMP_OGT || VecPred == FCMP_OGE || VecPred == FCMP_OEQ || VecPred == FCMP_UNE {
            let mut ValidMinMaxTys: SimpleValueType> = [v8i8, v16i8, v4i16, v8i16, v2i32, v4i32, v2i64, v2f32, v4f32, v2f64];
            let mut ValidFP16MinMaxTys: SimpleValueType> = [v4f16, v8f16];
            let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(ValTy);
            if any_of(ValidMinMaxTys, equal_to(LT.second)) || (self.ST.hasFullFP16() && any_of(ValidFP16MinMaxTys, equal_to(LT.second))) {
                return LT.first;
            }
        }
        let mut VectorSelectTbl: [11]TypeConversionCostTblEntry = [TypeConversionCostTblEntry { Select, v2i1, v2f32, 2 }, TypeConversionCostTblEntry { Select, v2i1, v2f64, 2 }, TypeConversionCostTblEntry { Select, v4i1, v4f32, 2 }, TypeConversionCostTblEntry { Select, v4i1, v4f16, 2 }, TypeConversionCostTblEntry { Select, v8i1, v8f16, 2 }, TypeConversionCostTblEntry { Select, v16i1, v16i16, 16 }, TypeConversionCostTblEntry { Select, v8i1, v8i32, 8 }, TypeConversionCostTblEntry { Select, v16i1, v16i32, 16 }, TypeConversionCostTblEntry { Select, v4i1, v4i64, 4 * AmortizationCost }, TypeConversionCostTblEntry { Select, v8i1, v8i64, 8 * AmortizationCost }, TypeConversionCostTblEntry { Select, v16i1, v16i64, 16 * AmortizationCost }];
        let mut SelCondTy: EVT = self.TLI.getValueType(self.DL, CondTy, false);
        let mut SelValTy: EVT = self.TLI.getValueType(self.DL, ValTy, false);
        if SelCondTy.isSimple() && SelValTy.isSimple() {
            if ConvertCostTableLookup(VectorSelectTbl, Opcode, SelCondTy.getSimpleVT(), SelValTy.getSimpleVT()) {
                Entry;
            } else {
                return Entry.Cost;
            }
        }
    }
    if Opcode == FCmp {
        if self.getFP16BF16PromoteCost(ValTy, CostKind, Op1Info, Op2Info, false, false, Closure_46 { cap_0: self, Opcode: &mut Opcode, CondTy: &mut CondTy, VecPred: &mut VecPred, CostKind: &mut CostKind, Op1Info: &mut Op1Info, Op2Info: &mut Op2Info, ValTy: &mut ValTy }) {
            PromotedCost;
        } else {
            return operator(PromotedCost);
        }
        let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(ValTy);
        if LT.second.getScalarType() != f64 && LT.second.getScalarType() != f32 && LT.second.getScalarType() != f16 {
            return LT.first * self.getCallInstrCost(null, ValTy, [ValTy, ValTy], CostKind);
        }
        let mut Factor: u32 = 1;
        if !CondTy.isVectorTy() && (VecPred == FCMP_ONE || VecPred == FCMP_UEQ) {
            Factor = 2;
        } else if isa(ValTy) && (VecPred == FCMP_ONE || VecPred == FCMP_UEQ || VecPred == FCMP_ORD || VecPred == FCMP_UNO) {
            Factor = 3;
        } else if isa(ValTy) && (VecPred == FCMP_ONE || VecPred == FCMP_UEQ) {
            Factor = 3;
        }
        if isa(ValTy) && CostKind == TCK_RecipThroughput && self.hasKnownLowerThroughputFromSchedulingModel(FCMEQ_PPzZZ_S, FCMEQv4f32) {
            Factor *= 2;
        }
        return Factor * (if CostKind == TCK_Latency { 2 } else { LT.first });
    }
    if CostKind == TCK_RecipThroughput && ValTy.isIntegerTy() && Opcode == ICmp && I && !isUnsigned(VecPred) && self.TLI.isTypeLegal(self.TLI.getValueType(self.DL, ValTy, false)) && match(I.getOperand(0), m_And(m_Value(), m_Value())) {
        if match(I.getOperand(1), m_Zero()) {
            return 0;
        }
        if match(I.getOperand(1), m_One()) && (VecPred == ICMP_SLT || VecPred == ICMP_SGE) {
            return 0;
        }
        if match(I.getOperand(1), m_AllOnes()) && (VecPred == ICMP_SLE || VecPred == ICMP_SGT) {
            return 0;
        }
    }
    return self.getCmpSelInstrCost(Opcode, ValTy, CondTy, VecPred, CostKind, Op1Info, Op2Info, I);
}

fn AArch64TTIImpl::enableMemCmpExpansion(self: *AArch64TTIImpl, OptSize: bool, IsZeroCmp: bool) -> MemCmpExpansionOptions {
    let mut Options: MemCmpExpansionOptions = MemCmpExpansionOptions {};
    if self.ST.requiresStrictAlign() {
        return Options;
    }
    Options.AllowOverlappingLoads = true;
    Options.MaxNumLoads = self.TLI.getMaxExpandSizeMemcmp(OptSize);
    Options.NumLoadsPerBlock = if IsZeroCmp { Options.MaxNumLoads } else { 1 };
    Options.LoadSizes = [8, 4, 2, 1];
    Options.AllowedTailExpansions = [3, 5, 6];
    return Options;
}

fn AArch64TTIImpl::prefersVectorizedAddressing(self: *AArch64TTIImpl) -> bool {
    return self.ST.hasSVE();
}

fn AArch64TTIImpl::getMemIntrinsicInstrCost(self: *AArch64TTIImpl, MICA: *MemIntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    match MICA.getID() {
        masked_scatter => {
            masked_gather;
        },
        masked_load => {
            masked_store;
        },
    }
    return self.getMemIntrinsicInstrCost(MICA, CostKind);
}

fn AArch64TTIImpl::getMaskedMemoryOpCost(self: *AArch64TTIImpl, MICA: *MemIntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    let mut Src: *mut Type = MICA.getDataType();
    if self.useNeonVector(Src) {
        return self.getMemIntrinsicInstrCost(MICA, CostKind);
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Src);
    if !LT.first.isValid() {
        return getInvalid(0);
    }
    let mut VT: *mut VectorType = cast(Src);
    if VT.getElementType().isIntegerTy(1) {
        return getInvalid(0);
    }
    if VT.getElementCount() == getScalable(1) {
        return if is_contained([masked_load, masked_store], MICA.getID()) { LT.first + 1 } else { getInvalid(0) };
    }
    let mut MemOpCost: InstructionCost = LT.first;
    if MICA.getID() == masked_expandload {
        if !self.isLegalMaskedExpandLoad(Src, MICA.getAlignment()) {
            return getInvalid(0);
        }
        operator(MemOpCost, 4);
    }
    if MICA.getID() == masked_compressstore {
        if !self.isLegalMaskedCompressStore(Src, MICA.getAlignment()) {
            return getInvalid(0);
        }
        operator(MemOpCost, 4);
    }
    if LT.first > 1 && LT.second.getScalarSizeInBits() > 8 {
        return MemOpCost * 2;
    }
    return MemOpCost;
}

fn getSVEGatherScatterOverhead(Opcode: u32, ST: *AArch64Subtarget) -> u32 {
    assert!((Opcode == Load || Opcode == Store), "Should be called on only load or stores.");
    match Opcode {
        Load => {
            if SVEGatherOverhead.getNumOccurrences() > 0 {
                return SVEGatherOverhead.operator unsigned int();
            }
        },
        Store => {
            if SVEScatterOverhead.getNumOccurrences() > 0 {
                return SVEScatterOverhead.operator unsigned int();
            }
        },
        _ => {
            llvm_unreachable_internal("Shouldn't have reached here", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64TargetTransformInfo.cpp", 5622);
        },
    }
}

fn AArch64TTIImpl::getGatherScatterOpCost(self: *AArch64TTIImpl, MICA: *MemIntrinsicCostAttributes, CostKind: TargetCostKind) -> InstructionCost {
    let mut Opcode: u32 = if (MICA.getID() == masked_gather || MICA.getID() == vp_gather) { Load } else { Store };
    let mut DataTy: *mut Type = MICA.getDataType();
    let mut Alignment: Align = MICA.getAlignment();
    let mut I: *Instruction = MICA.getInst();
    if self.useNeonVector(DataTy) || !self.isLegalMaskedGatherScatter(DataTy) {
        return self.getMemIntrinsicInstrCost(MICA, CostKind);
    }
    let mut VT: *mut VectorType = cast(DataTy);
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(DataTy);
    if !LT.first.isValid() {
        return getInvalid(0);
    }
    if !LT.second.isVector() || !self.isElementTypeLegalForScalableVector(VT.getElementType()) || VT.getElementType().isIntegerTy(1) {
        return getInvalid(0);
    }
    if VT.getElementCount() == getScalable(1) {
        return getInvalid(0);
    }
    let mut LegalVF: ElementCount = LT.second.getVectorElementCount();
    let mut MemOpCost: InstructionCost = self.getMemoryOpCost(Opcode, VT.getElementType(), Alignment, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, I);
    operator(MemOpCost, getSVEGatherScatterOverhead(Opcode, self.ST));
    return LT.first * MemOpCost * self.getMaxNumElements(LegalVF);
}

fn AArch64TTIImpl::useNeonVector(self: *AArch64TTIImpl, Ty: *Type) -> bool {
    return isa(Ty) && !self.ST.useSVEForFixedLengthVectors();
}

fn AArch64TTIImpl::getMemoryOpCost(self: *AArch64TTIImpl, Opcode: u32, Ty: *mut Type, Alignment: Align, AddressSpace: u32, CostKind: TargetCostKind, OpInfo: OperandValueInfo, I: *Instruction) -> InstructionCost {
    let mut VT: EVT = self.TLI.getValueType(self.DL, Ty, true);
    if VT == Other {
        return self.getMemoryOpCost(Opcode, Ty, Alignment, AddressSpace, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Ty);
    if !LT.first.isValid() {
        return getInvalid(0);
    }
    if dyn_cast(Ty) {
        VTy;
    } else {
        if VTy.getElementType().isIntegerTy(1) && !VTy.getElementCount().isKnownMultipleOf(getScalable(16)) {
            return getInvalid(0);
        }
        if VTy.getElementCount() == getScalable(1) {
            let mut IID: ID = if Opcode == Load { masked_load } else { masked_store };
            return self.getMaskedMemoryOpCost(MemIntrinsicCostAttributes { IID, Ty, Alignment, AddressSpace, null }, CostKind) + 1;
        }
    }
    if CostKind == TCK_CodeSize || CostKind == TCK_SizeAndLatency {
        return LT.first;
    }
    if CostKind == TCK_Latency {
        if Opcode == Store {
            return 1;
        }
        if self.ST.getFixedLoadLatency() {
            return (LT.first - 1) + self.ST.getFixedLoadLatency();
        }
        let mut Inst: u32 = 0;
        if LT.second.isScalableVector() || self.ST.useSVEForFixedLengthVectors(LT.second) {
            Inst = LDR_ZXI;
        } else if LT.second.isVector() || LT.second.isFloatingPoint() {
            match LT.second.getSizeInBits().operator unsigned long long() {
                8 => {
                    Inst = LDRBui;
                },
                16 => {
                    Inst = LDRHui;
                },
                32 => {
                    Inst = LDRSui;
                },
                64 => {
                    Inst = LDRDui;
                },
                128 => {
                    Inst = LDRQui;
                },
                _ => {
                    llvm_unreachable_internal("Unexpected float or vector type", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64TargetTransformInfo.cpp", 5748);
                },
            }
        } else {
            match LT.second.getSizeInBits().operator unsigned long long() {
                8 => {
                    Inst = LDRBBui;
                },
                16 => {
                    Inst = LDRHHui;
                },
                32 => {
                    Inst = LDRWui;
                },
                64 => {
                    Inst = LDRXui;
                },
                _ => {
                    llvm_unreachable_internal("Unexpected integer type", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64TargetTransformInfo.cpp", 5765);
                },
            }
        }
        let mut Sched: *MCSchedModel = self.ST.getSchedModel();
        let mut TII: *TargetInstrInfo = self.ST.getInstrInfo();
        let mut SchedClass: u32 = TII.get(Inst).getSchedClass();
        let mut SCD: *MCSchedClassDesc = if Sched.hasInstrSchedModel() { Sched.getSchedClassDesc(SchedClass) } else { null };
        if !SCD || !SCD.isValid() || SCD.isVariant() {
            return (LT.first - 1) + self.ST.getLoadLatency();
        }
        let mut NumLoads: f32 = (LT.first - 1).getValue();
        return NumLoads * Sched.getReciprocalThroughput(*self.ST, *SCD) + Sched.computeInstrLatency(*self.ST, *SCD);
    }
    if self.ST.isMisaligned128StoreSlow() && Opcode == Store && LT.second.is128BitVector() && Alignment < 16 {
        let mut AmortizationCost: i32 = 6;
        return LT.first * 2 * AmortizationCost;
    }
    if Ty.isPtrOrPtrVectorTy() {
        return LT.first;
    }
    if self.useNeonVector(Ty) {
        if Ty.getScalarSizeInBits() != LT.second.getScalarSizeInBits() {
            if VT == v4i8 {
                return 2;
            }
            return cast(Ty).getNumElements() * 2;
        }
        let mut EltVT: EVT = VT.getVectorElementType();
        let mut EltSize: u32 = EltVT.getScalarSizeInBits();
        if !isPowerOf2_32(EltSize) || EltSize < 8 || EltSize > 64 || Alignment != 1 {
            return LT.first;
        }
        if VT.getVectorNumElements() == 3 && EltVT == i8 {
            return LT.first;
        }
        let mut Cost: InstructionCost = VT.getVectorNumElements() / (128 / EltSize);
        let mut Remainder: u32 = VT.getVectorNumElements() % (128 / EltSize);
        if Remainder != 0 {
            let mut TypeWorklist: pair<unsigned int, unsigned int>> = pair<unsigned int, unsigned int>> {};
            TypeWorklist.push(ValueParamT { Remainder, 0 });
            while !TypeWorklist.is_empty() {
                if isPowerOf2_32(CurrNumElements) {
                    operator(Cost, 1 + (if Offset == 0 { 0 } else { 1 }));
                    continue;
                }
                let mut PrevPow2: u32 = NextPowerOf2(CurrNumElements) / 2;
                TypeWorklist.push(ValueParamT { PrevPow2, Offset });
                TypeWorklist.push(ValueParamT { CurrNumElements - PrevPow2, Offset + PrevPow2 });
            }
        }
        return Cost;
    }
    return LT.first;
}

fn AArch64TTIImpl::getInterleavedMemoryOpCost(self: *AArch64TTIImpl, Opcode: u32, VecTy: *mut Type, Factor: u32, Indices: ArrayRef<unsigned int>, Alignment: Align, AddressSpace: u32, CostKind: TargetCostKind, UseMaskForCond: bool, UseMaskForGaps: bool) -> InstructionCost {
    assert!(Factor >= 2, "Invalid interleave factor");
    let mut VecVTy: *mut VectorType = cast(VecTy);
    if VecTy.isScalableTy() && !self.ST.hasSVE() {
        return getInvalid(0);
    }
    if VecTy.isScalableTy() {
        if Factor > self.TLI.getMaxSupportedInterleaveFactor() {
            return getInvalid(0);
        }
        if Factor == 3 && self.DL.getTypeSizeInBits(VecTy).getKnownMinValue() != (3 * 128) {
            return getInvalid(0);
        }
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(VecTy);
    let mut MaxNativeInterleaveFactor: u32 = self.TLI.getMaxSupportedInterleaveFactor();
    if !VecTy.isScalableTy() && (UseMaskForCond || UseMaskForGaps || (Factor > MaxNativeInterleaveFactor && self.TLI.useSVEForFixedLengthVectorVT(LT.second, false))) {
        return getInvalid(0);
    }
    if !UseMaskForGaps && Factor <= MaxNativeInterleaveFactor {
        let mut EC: ElementCount = VecVTy.getElementCount();
        let mut SubVecTy: *mut VectorType = get(VecVTy.getElementType(), EC.divideCoefficientBy(Factor));
        let mut UseScalable: bool = false;
        if EC.isKnownMultipleOf(Factor) && self.TLI.isLegalInterleavedAccessType(SubVecTy, self.DL, UseScalable) {
            return Factor * self.TLI.getNumInterleavedAccesses(SubVecTy, self.DL, UseScalable);
        }
        if VecTy.isScalableTy() && EC.isKnownMultipleOf(Factor) {
            if SubVecTy.getElementCount() == getScalable(1) {
                return getInvalid(0);
            }
            let mut MemCost: InstructionCost = InstructionCost {};
            if UseMaskForCond {
                let mut IID: u32 = if Opcode == Load { masked_load } else { masked_store };
                MemCost = self.getMemIntrinsicInstrCost(MemIntrinsicCostAttributes { IID, VecTy, Alignment, AddressSpace, null }, CostKind);
            } else {
                MemCost = self.getMemoryOpCost(Opcode, VecTy, Alignment, AddressSpace, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null);
            }
            let mut SubVecCost: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(SubVecTy);
            let mut ResultCost: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(VecTy);
            let mut LegalizationCost: InstructionCost = SubVecCost.first;
            if Opcode == Store && Factor == 4 && SubVecCost.second.getScalarSizeInBits() == (4 * ResultCost.second.getScalarSizeInBits()) {
                operator(LegalizationCost, 4);
            }
            return MemCost + (Factor * LegalizationCost) + (Factor * Log2_64(Factor));
        }
    }
    return self.getInterleavedMemoryOpCost(Opcode, VecTy, Factor, Indices, Alignment, AddressSpace, CostKind, UseMaskForCond, UseMaskForGaps);
}

fn AArch64TTIImpl::getCostOfKeepingLiveOverCall(self: *AArch64TTIImpl, Tys: ArrayRef<Type *>) -> InstructionCost {
    let mut Cost: InstructionCost = 0;
    let mut CostKind: TargetCostKind = TCK_RecipThroughput;
    for I in Tys {
        if !I.isVectorTy() {
            continue;
        }
        if I.getScalarSizeInBits() * cast(I).getNumElements() == 128 {
            operator(Cost, self.getMemoryOpCost(Store, I, 128, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null) + self.getMemoryOpCost(Load, I, 128, 0, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, null));
        }
    }
    return Cost;
}

fn AArch64TTIImpl::isLegalMaskedExpandLoad(self: *AArch64TTIImpl, DataTy: *mut Type, Alignment: Align) -> bool {
    if self.useNeonVector(DataTy) {
        return false;
    }
    return (self.ST.isSVEAvailable() && self.ST.hasSVE2p2()) || (self.ST.isSVEorStreamingSVEAvailable() && self.ST.hasSME2p2());
}

fn AArch64TTIImpl::isLegalSpeculativeLoad(self: *AArch64TTIImpl, DataType: *mut Type, AddressSpace: u32) -> bool {
    if AddressSpace != 0 {
        return false;
    }
    let mut Size: TypeSize = self.DL.getTypeStoreSize(DataType);
    return !Size.isScalable() && isPowerOf2_64(Size.getFixedValue()) && Size.getFixedValue() <= 16;
}

fn AArch64TTIImpl::getMaxInterleaveFactor(self: *AArch64TTIImpl, VF: ElementCount, HasUnorderedReductions: bool) -> u32 {
    if VF.isScalar() || (HasUnorderedReductions && VF.getKnownMinValue() <= 4) {
        return 4;
    }
    return self.ST.getMaxInterleaveFactor();
}

fn getFalkorUnrollingPreferences(L: *mut Loop, SE: *mut ScalarEvolution, UP: *mut UnrollingPreferences) {
    let mut countStridedLoads: Closure_47 = Closure_47 {};
    let mut StridedLoads: i32 = countStridedLoads.call(L, SE);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64tti", 1) {
            dbgs() << "falkor-hwpf: detected " << StridedLoads << " strided loads\n";
        }
    }
        if !(false) { break; }
    }
    if StridedLoads {
        UP.MaxCount = 1 << Log2_32(MaxStridedLoads / StridedLoads);
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64tti", 1) {
                dbgs() << "falkor-hwpf: setting unroll MaxCount to " << UP.MaxCount << 10;
            }
        }
            if !(false) { break; }
        }
    }
}

fn isLoopSizeWithinBudget(L: *mut Loop, TTI: *AArch64TTIImpl, Budget: InstructionCost, FinalSize: *mut u32) -> bool {
    let mut LoopCost: InstructionCost = 0;
    for BB in L.getBlocks() {
        for I in *BB {
            let mut Operands: SmallVector<const Value *, 4> = I.operand_values();
            let mut Cost: InstructionCost = TTI.getInstructionCost(&mut I, Operands, TCK_CodeSize);
            if !Cost.isValid() {
                return false;
            }
            operator(LoopCost, Cost);
            if LoopCost > Budget {
                return false;
            }
        }
    }
    if FinalSize {
        *FinalSize = LoopCost.getValue();
    }
    return true;
}

fn shouldUnrollMultiExitLoop(L: *mut Loop, SE: *mut ScalarEvolution, TTI: *AArch64TTIImpl) -> bool {
    let mut BTC: *SCEV = SE.getSymbolicMaxBackedgeTakenCount(L);
    if isa(BTC) || isa(BTC) {
        return false;
    }
    let mut MaxTC: u32 = SE.getSmallConstantMaxTripCount(L, null);
    if MaxTC > 0 && MaxTC <= 32 {
        return false;
    }
    if !isLoopSizeWithinBudget(L, TTI, 5, null) {
        return false;
    }
    let mut Blocks: ArrayRef<BasicBlock *> = L.getBlocks();
    if Blocks.len != 2 {
        return false;
    }
    if any_of(Blocks, Closure_48 {}) {
        return false;
    }
    return true;
}

fn getAppleRuntimeUnrollPreferences(L: *mut Loop, SE: *mut ScalarEvolution, UP: *mut UnrollingPreferences, TTI: *AArch64TTIImpl) {
    if !L.isInnermost() || L.getNumBlocks() > 8 {
        return;
    }
    if !L.getExitBlock() {
        return;
    }
    let mut HasParellelizableReductions: bool = L.getNumBlocks() == 1 && any_of(L.getHeader().phis(), Closure_49 { SE: &mut SE, L: L }) && isLoopSizeWithinBudget(L, TTI, 12, null);
    if HasParellelizableReductions && SE.getSmallConstantTripMultiple(L, L.getExitingBlock()) % 2 == 0 {
        UP.Partial = true;
        UP.MaxCount = 4;
        UP.AddAdditionalAccumulators = true;
    }
    let mut BTC: *SCEV = SE.getSymbolicMaxBackedgeTakenCount(L);
    if isa(BTC) || isa(BTC) || (SE.getSmallConstantMaxTripCount(L, null) > 0 && SE.getSmallConstantMaxTripCount(L, null) <= 32) {
        return;
    }
    if findStringMetadataForLoop(L, "llvm.loop.isvectorized") {
        return;
    }
    if SE.getSymbolicMaxBackedgeTakenCount(L) != SE.getBackedgeTakenCount(L, Exact) {
        return;
    }
    UP.SCEVExpansionBudget = 1;
    if HasParellelizableReductions {
        UP.Runtime = true;
        UP.DefaultUnrollRuntimeCount = 4;
        UP.AddAdditionalAccumulators = true;
    }
    let mut Header: *mut BasicBlock = L.getHeader();
    let mut Latch: *mut BasicBlock = L.getLoopLatch();
    if Header == Latch {
        let mut Size: u32 = 0;
        let mut Width: u32 = 10;
        if !isLoopSizeWithinBudget(L, TTI, Width, &mut Size) {
            return;
        }
        let mut MaxInstsPerLine: u32 = 16;
        let mut UC: u32 = 1;
        let mut BestUC: u32 = 1;
        let mut SizeWithBestUC: u32 = BestUC * Size;
        while UC <= 8 {
            let mut SizeWithUC: u32 = UC * Size;
            if SizeWithUC > 48 {
                break;
            }
            if (SizeWithUC % MaxInstsPerLine) == 0 || (SizeWithBestUC % MaxInstsPerLine) < (SizeWithUC % MaxInstsPerLine) {
                BestUC = UC;
                SizeWithBestUC = BestUC * Size;
            }
            UC += 1;
        }
        if BestUC == 1 {
            return;
        }
        let mut LoadedValuesPlus: SmallPtrSet<Value *, 8> = SmallPtrSet<Value *, 8> {};
        let mut Stores: SmallVector<StoreInst *> = SmallVector<StoreInst *> {};
        for BB in L.blocks() {
            for I in *BB {
                let mut Ptr: *mut Value = getLoadStorePointerOperand(&mut I);
                if !Ptr {
                    continue;
                }
                let mut PtrSCEV: *SCEV = SE.getSCEV(Ptr);
                if SE.isLoopInvariant(PtrSCEV, L) {
                    continue;
                }
                if isa(&mut I) {
                    LoadedValuesPlus.insert(&mut I);
                    for U in I.users() {
                        if L.contains(cast(U)) {
                            LoadedValuesPlus.insert(U);
                        }
                    }
                } else {
                    Stores.push(cast(&mut I));
                }
            }
        }
        if none_of(Stores, Closure_50 { LoadedValuesPlus: &mut LoadedValuesPlus }) {
            return;
        }
        UP.Runtime = true;
        UP.DefaultUnrollRuntimeCount = BestUC;
        return;
    }
    let mut Term: *mut CondBrInst = dyn_cast(Header.getTerminator());
    let mut Preds: SmallVector<BasicBlock *> = predecessors(Latch);
    if !Term || Preds.len == 1 || !is_contained(Preds, Header) || none_of(Preds, Closure_51 { L: L }) {
        return;
    }
    let mut DependsOnLoopLoad: function<bool (Instruction *, unsigned int)> = Closure_52 { L: &mut L, DependsOnLoopLoad: &mut DependsOnLoopLoad };
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut I: *mut Instruction = null;
    if match(Term, m_Br(m_ICmp(Pred, m_Instruction(I), m_Value()), m_Value(), m_Value())) && DependsOnLoopLoad.call(I, 0) {
        UP.Runtime = true;
    }
}

fn AArch64TTIImpl::getUnrollingPreferences(self: *AArch64TTIImpl, L: *mut Loop, SE: *mut ScalarEvolution, UP: *mut UnrollingPreferences, ORE: *mut OptimizationRemarkEmitter) {
    self.getUnrollingPreferences(L, SE, UP, ORE);
    UP.UpperBound = true;
    if L.getExitingBlock() && !SE.isBackedgeTakenCountMaxOrZero(L) && isa(SE.getBackedgeTakenCount(L, Exact)) {
        UP.MaxUpperBound = 5;
        UP.Runtime = false;
    }
    if L.getLoopDepth() > 1 {
        UP.PartialThreshold *= 2;
    }
    UP.PartialOptSizeThreshold = 0;
    let mut IsVectorized: bool = getBooleanLoopAttribute(L, "llvm.loop.isvectorized");
    let mut Cost: InstructionCost = 0;
    for BB in L.getBlocks() {
        for I in *BB {
            if IsVectorized && I.getType().isVectorTy() {
                return;
            }
            if isa(I) {
                if isa(I) || isa(I) {
                    if cast(I).getCalledFunction() {
                        F;
                    } else if !self.isLoweredToCall(F) {
                        continue;
                    }
                }
                return;
            }
            if Cost >= Aarch64ForceUnrollThreshold.operator int() {
                continue;
            }
            let mut Operands: SmallVector<const Value *, 4> = I.operand_values();
            operator(Cost, self.getInstructionCost(&mut I, Operands, TCK_SizeAndLatency));
        }
    }
    if self.ST.isAppleMLike() {
        getAppleRuntimeUnrollPreferences(L, SE, UP, *self);
    } else if self.ST.getProcFamily() == Falkor && EnableFalkorHWPFUnrollFix {
        getFalkorUnrollingPreferences(L, SE, UP);
    }
    if !L.getExitBlock() && shouldUnrollMultiExitLoop(L, SE, *self) {
        UP.RuntimeUnrollMultiExit = true;
        UP.Runtime = true;
        UP.DefaultUnrollRuntimeCount = 4;
        UP.SCEVExpansionBudget = 5;
        return;
    }
    if self.ST.getProcFamily() != Generic && !self.ST.getSchedModel().isOutOfOrder() {
        UP.Runtime = true;
        UP.Partial = true;
        UP.UnrollRemainder = true;
        UP.DefaultUnrollRuntimeCount = 4;
        UP.UnrollAndJam = true;
        UP.UnrollAndJamInnerLoopThreshold = 60;
    }
    if Cost < Aarch64ForceUnrollThreshold.operator int() {
        UP.Force = true;
    }
}

fn AArch64TTIImpl::getPeelingPreferences(self: *AArch64TTIImpl, L: *mut Loop, SE: *mut ScalarEvolution, PP: *mut PeelingPreferences) {
    self.getPeelingPreferences(L, SE, PP);
}

fn AArch64TTIImpl::getOrCreateResultFromMemIntrinsic(self: *AArch64TTIImpl, Inst: *mut IntrinsicInst, ExpectedType: *mut Type, CanCreate: bool) -> *mut Value {
    match Inst.getIntrinsicID() {
        _ => {
            return null;
        },
        aarch64_neon_st1x2 => {
            aarch64_neon_st1x3;
        },
        aarch64_neon_ld1x2 => {
            aarch64_neon_ld1x3;
        },
    }
}

fn AArch64TTIImpl::getTgtMemIntrinsic(self: *AArch64TTIImpl, Inst: *mut IntrinsicInst, Info: *mut MemIntrinsicInfo) -> bool {
    match Inst.getIntrinsicID() {
        _ => {
            break;
        },
        aarch64_neon_ld1x2 => {
            aarch64_neon_ld1x3;
        },
        aarch64_neon_st1x2 => {
            aarch64_neon_st1x3;
        },
    }
    match Inst.getIntrinsicID() {
        _ => {
            return false;
        },
        aarch64_neon_ld1x2 => {
            aarch64_neon_st1x2;
        },
        aarch64_neon_ld1x3 => {
            aarch64_neon_st1x3;
        },
        aarch64_neon_ld1x4 => {
            aarch64_neon_st1x4;
        },
        aarch64_neon_ld2 => {
            aarch64_neon_st2;
        },
        aarch64_neon_ld3 => {
            aarch64_neon_st3;
        },
        aarch64_neon_ld4 => {
            aarch64_neon_st4;
        },
    }
    return true;
}

fn AArch64TTIImpl::shouldConsiderAddressTypePromotion(self: *AArch64TTIImpl, I: *Instruction, AllowPromotionWithoutCommonHeader: *mut bool) -> bool {
    let mut Considerable: bool = false;
    AllowPromotionWithoutCommonHeader = false;
    if !isa(&mut I) {
        return false;
    }
    let mut ConsideredSExtType: *mut Type = getInt64Ty(I.getParent().getParent().getContext());
    if I.getType() != ConsideredSExtType {
        return false;
    }
    for U in I.users() {
        if dyn_cast(U) {
            GEPInst;
        } else {
            Considerable = true;
            if GEPInst.getNumOperands() > 2 {
                AllowPromotionWithoutCommonHeader = true;
                break;
            }
        }
    }
    return Considerable;
}

fn AArch64TTIImpl::isLegalToVectorizeReduction(self: *AArch64TTIImpl, RdxDesc: *RecurrenceDescriptor, VF: ElementCount) -> bool {
    if !VF.isScalable() {
        return true;
    }
    let mut Ty: *mut Type = RdxDesc.getRecurrenceType();
    if Ty.isBFloatTy() || !self.isElementTypeLegalForScalableVector(Ty) {
        return false;
    }
    match RdxDesc.getRecurrenceKind() {
        Sub => {
            FSub;
        },
        _ => {
            return false;
        },
    }
}

fn AArch64TTIImpl::getMinMaxReductionCost(self: *AArch64TTIImpl, IID: ID, Ty: *mut VectorType, FMF: FastMathFlags, CostKind: TargetCostKind) -> InstructionCost {
    if dyn_cast(Ty) {
        VTy;
    } else if VTy.getElementCount() == getScalable(1) {
        return getInvalid(0);
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Ty);
    if LT.second.getScalarType() == f16 && !self.ST.hasFullFP16() {
        return self.getMinMaxReductionCost(IID, Ty, FMF, CostKind);
    }
    let mut LegalizationCost: InstructionCost = 0;
    if LT.first > 1 {
        let mut LegalVTy: *mut Type = LT.second.getTypeForEVT(Ty.getContext());
        let mut Attrs: IntrinsicCostAttributes = IntrinsicCostAttributes { IID, LegalVTy, [LegalVTy, LegalVTy], FMF, null, getInvalid(0) };
        LegalizationCost = self.getIntrinsicInstrCost(Attrs, CostKind) * (LT.first - 1);
    }
    return LegalizationCost + 2;
}

fn AArch64TTIImpl::getArithmeticReductionCostSVE(self: *AArch64TTIImpl, Opcode: u32, ValTy: *mut VectorType, CostKind: TargetCostKind) -> InstructionCost {
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(ValTy);
    let mut LegalizationCost: InstructionCost = 0;
    if LT.first > 1 {
        let mut LegalVTy: *mut Type = LT.second.getTypeForEVT(ValTy.getContext());
        LegalizationCost = self.getArithmeticInstrCost(Opcode, LegalVTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null);
        operator(LegalizationCost, LT.first - 1);
    }
    let mut ISD: i32 = self.TLI.InstructionOpcodeToISD(Opcode);
    assert!(ISD, "Invalid opcode");
    match ISD {
        ADD => {
            AND;
        },
        _ => {
            return getInvalid(0);
        },
    }
}

fn AArch64TTIImpl::getArithmeticReductionCost(self: *AArch64TTIImpl, Opcode: u32, ValTy: *mut VectorType, FMF: optional<FastMathFlags>, CostKind: TargetCostKind) -> InstructionCost {
    if dyn_cast(ValTy) {
        VTy;
    } else if VTy.getElementCount() == getScalable(1) {
        return getInvalid(0);
    }
    if requiresOrderedReduction(FMF) {
        if dyn_cast(ValTy) {
            FixedVTy;
        } else {
            let mut BaseCost: InstructionCost = self.getArithmeticReductionCost(Opcode, ValTy, FMF, CostKind);
            return BaseCost + FixedVTy.getNumElements();
        }
        if Opcode != FAdd || ValTy.getElementType().isBFloatTy() {
            return getInvalid(0);
        }
        let mut VTy: *mut ScalableVectorType = cast(ValTy);
        let mut Cost: InstructionCost = self.getArithmeticInstrCost(Opcode, VTy.getScalarType(), CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null);
        operator(Cost, self.getMaxNumElements(VTy.getElementCount()));
        return Cost;
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(ValTy);
    let mut MTy: MVT = LT.second;
    if isa(ValTy) || self.TLI.useSVEForFixedLengthVectorVT(MTy, false) {
        return self.getArithmeticReductionCostSVE(Opcode, ValTy, CostKind);
    }
    let mut ISD: i32 = self.TLI.InstructionOpcodeToISD(Opcode);
    assert!(ISD, "Invalid opcode");
    let mut CostTblNoPairwise: [28]CostTblEntry = [CostTblEntry { ADD, v8i8, 2 }, CostTblEntry { ADD, v16i8, 2 }, CostTblEntry { ADD, v4i16, 2 }, CostTblEntry { ADD, v8i16, 2 }, CostTblEntry { ADD, v2i32, 2 }, CostTblEntry { ADD, v4i32, 2 }, CostTblEntry { ADD, v2i64, 2 }, CostTblEntry { OR, v8i8, 5 }, CostTblEntry { OR, v16i8, 7 }, CostTblEntry { OR, v4i16, 4 }, CostTblEntry { OR, v8i16, 6 }, CostTblEntry { OR, v2i32, 3 }, CostTblEntry { OR, v4i32, 5 }, CostTblEntry { OR, v2i64, 3 }, CostTblEntry { XOR, v8i8, 5 }, CostTblEntry { XOR, v16i8, 7 }, CostTblEntry { XOR, v4i16, 4 }, CostTblEntry { XOR, v8i16, 6 }, CostTblEntry { XOR, v2i32, 3 }, CostTblEntry { XOR, v4i32, 5 }, CostTblEntry { XOR, v2i64, 3 }, CostTblEntry { AND, v8i8, 5 }, CostTblEntry { AND, v16i8, 7 }, CostTblEntry { AND, v4i16, 4 }, CostTblEntry { AND, v8i16, 6 }, CostTblEntry { AND, v2i32, 3 }, CostTblEntry { AND, v4i32, 5 }, CostTblEntry { AND, v2i64, 3 }];
    match ISD {
        _ => {
            break;
        },
        FADD => {
            let mut EltTy: *mut Type = ValTy.getScalarType();
            if MTy.isVector() && (EltTy.isFloatTy() || EltTy.isDoubleTy() || (EltTy.isHalfTy() && self.ST.hasFullFP16())) {
                let mut NElts: u32 = MTy.getVectorNumElements();
                if ValTy.getElementCount().getFixedValue() >= 2 && NElts >= 2 && isPowerOf2_32(NElts) {
                    return (LT.first - 1) + Log2_32(NElts);
                }
            }
        },
        ADD => {
            if CostTableLookup(CostTblNoPairwise, ISD, MTy) {
                Entry;
            } else {
                return (LT.first - 1) + Entry.Cost;
            }
        },
        XOR => {
            AND;
        },
    }
    return self.getArithmeticReductionCost(Opcode, ValTy, FMF, CostKind);
}

fn AArch64TTIImpl::getExtendedReductionCost(self: *AArch64TTIImpl, Opcode: u32, IsUnsigned: bool, ResTy: *mut Type, VecTy: *mut VectorType, FMF: optional<FastMathFlags>, CostKind: TargetCostKind) -> InstructionCost {
    let mut VecVT: EVT = self.TLI.getValueType(self.DL, VecTy, false);
    let mut ResVT: EVT = self.TLI.getValueType(self.DL, ResTy, false);
    if Opcode == Add && VecVT.isSimple() && ResVT.isSimple() && VecVT.getSizeInBits().operator unsigned long long() >= 64 {
        let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(VecTy);
        let mut RevVTSize: u32 = ResVT.getSizeInBits().operator unsigned long long();
        if ((LT.second == v8i8 || LT.second == v16i8) && RevVTSize <= 32) || ((LT.second == v4i16 || LT.second == v8i16) && RevVTSize <= 32) || ((LT.second == v2i32 || LT.second == v4i32) && RevVTSize <= 64) {
            return (LT.first - 1) * 2 + 2;
        }
    }
    return self.getExtendedReductionCost(Opcode, IsUnsigned, ResTy, VecTy, FMF, CostKind);
}

fn AArch64TTIImpl::getMulAccReductionCost(self: *AArch64TTIImpl, IsUnsigned: bool, RedOpcode: u32, ResTy: *mut Type, VecTy: *mut VectorType, CostKind: TargetCostKind) -> InstructionCost {
    let mut VecVT: EVT = self.TLI.getValueType(self.DL, VecTy, false);
    let mut ResVT: EVT = self.TLI.getValueType(self.DL, ResTy, false);
    if self.ST.hasDotProd() && VecVT.isSimple() && ResVT.isSimple() && RedOpcode == Add {
        let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(VecTy);
        if (LT.second == v8i8 || LT.second == v16i8) && ResVT == i32 {
            return LT.first + 2;
        }
    }
    return self.getMulAccReductionCost(IsUnsigned, RedOpcode, ResTy, VecTy, CostKind);
}

fn AArch64TTIImpl::getSpliceCost(self: *AArch64TTIImpl, Tp: *mut VectorType, Index: i32, CostKind: TargetCostKind) -> InstructionCost {
    let mut ShuffleTbl: [13]CostTblEntry = [CostTblEntry { SK_Splice, nxv16i8, 1 }, CostTblEntry { SK_Splice, nxv8i16, 1 }, CostTblEntry { SK_Splice, nxv4i32, 1 }, CostTblEntry { SK_Splice, nxv2i64, 1 }, CostTblEntry { SK_Splice, nxv2f16, 1 }, CostTblEntry { SK_Splice, nxv4f16, 1 }, CostTblEntry { SK_Splice, nxv8f16, 1 }, CostTblEntry { SK_Splice, nxv2bf16, 1 }, CostTblEntry { SK_Splice, nxv4bf16, 1 }, CostTblEntry { SK_Splice, nxv8bf16, 1 }, CostTblEntry { SK_Splice, nxv2f32, 1 }, CostTblEntry { SK_Splice, nxv4f32, 1 }, CostTblEntry { SK_Splice, nxv2f64, 1 }];
    if Tp.getElementCount() == getScalable(1) {
        return getInvalid(0);
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(Tp);
    let mut LegalVTy: *mut Type = LT.second.getTypeForEVT(Tp.getContext());
    let mut PromotedVT: EVT = if LT.second.getScalarType() == i1 { self.TLI.getPromotedVTForPredicate(LT.second) } else { LT.second };
    let mut PromotedVTy: *mut Type = PromotedVT.getTypeForEVT(Tp.getContext());
    let mut LegalizationCost: InstructionCost = 0;
    if Index < 0 {
        LegalizationCost = self.getCmpSelInstrCost(ICmp, PromotedVTy, PromotedVTy, BAD_ICMP_PREDICATE, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, null) + self.getCmpSelInstrCost(Select, PromotedVTy, LegalVTy, BAD_ICMP_PREDICATE, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, null);
    }
    if LT.second.getScalarType() == i1 {
        operator(LegalizationCost, self.getCastInstrCost(ZExt, PromotedVTy, LegalVTy, None, CostKind, null) + self.getCastInstrCost(Trunc, LegalVTy, PromotedVTy, None, CostKind, null));
    }
    let mut Entry: *CostTblEntryT<unsigned short> = CostTableLookup(ShuffleTbl, SK_Splice, PromotedVT.getSimpleVT());
    assert!(Entry, "Illegal Type for Splice");
    operator(LegalizationCost, Entry.Cost);
    return LegalizationCost * LT.first;
}

fn AArch64TTIImpl::getPartialReductionCost(self: *AArch64TTIImpl, Opcode: u32, InputTypeA: *mut Type, InputTypeB: *mut Type, AccumType: *mut Type, VF: ElementCount, OpAExtend: PartialReductionExtendKind, OpBExtend: PartialReductionExtendKind, BinOp: optional<unsigned int>, CostKind: TargetCostKind, FMF: optional<FastMathFlags>) -> InstructionCost {
    let mut Invalid: InstructionCost = getInvalid(0);
    if CostKind != TCK_RecipThroughput {
        return Invalid;
    }
    if (Opcode != Add && Opcode != Sub && Opcode != FAdd && Opcode != FSub) {
        return Invalid;
    }
    if AccumType.isFloatingPointTy() {
        assert!(FMF, "Missing FastMathFlags for floating-point partial reduction");
        if !operator(FMF).allowReassoc() || !operator(FMF).allowContract() {
            return Invalid;
        }
    } else {
        assert!(!FMF, "FastMathFlags only apply to floating-point partial reductions");
    }
    assert!((BinOp || (OpBExtend == PR_None && !InputTypeB)) && (!BinOp || (OpBExtend != PR_None && InputTypeB)), "Unexpected values for OpBExtend or InputTypeB");
    if BinOp && ((operator(BinOp) != Mul && operator(BinOp) != FMul) || InputTypeA != InputTypeB) {
        return Invalid;
    }
    if !is_contained([8, 16, 32, 64], AccumType.getScalarSizeInBits()) {
        return Invalid;
    }
    if !OpAExtend {
        assert!(!OpBExtend, "Extended second operand without extended first.");
        assert!(InputTypeA == AccumType, "Type mismatch with no extensions.");
        let mut VTy: *mut VectorType = get(AccumType, VF);
        return self.getArithmeticInstrCost(Opcode, VTy, CostKind, OperandValueInfo { OK_AnyValue, OP_None }, OperandValueInfo { OK_AnyValue, OP_None }, ArrayRef<const Value *> {}, null);
    }
    let mut IsUSDot: bool = OpBExtend != PR_None && OpAExtend != OpBExtend;
    if IsUSDot && !self.ST.hasMatMulInt8() && !self.ST.hasDotProd() {
        return Invalid;
    }
    let mut Ratio: u32 = AccumType.getScalarSizeInBits() / InputTypeA.getScalarSizeInBits();
    if VF.getKnownMinValue() <= Ratio {
        return Invalid;
    }
    let mut InputVectorType: *mut VectorType = get(InputTypeA, VF);
    let mut AccumVectorType: *mut VectorType = get(AccumType, VF.divideCoefficientBy(Ratio));
    let mut TC: LegalizeKind = self.TLI.getTypeConversion(AccumVectorType.getContext(), getEVT(AccumVectorType, false));
    match TC.first {
        _ => {
            return Invalid;
        },
        TypeLegal => {
            TypePromoteInteger;
        },
    }
    let mut AccumLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(AccumVectorType);
    let mut InputLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(InputVectorType);
    let mut IsSupported: Closure_54 = Closure_54 { cap_0: self, AccumLT: &mut AccumLT };
    let mut IsSub: bool = Opcode == Sub || Opcode == FSub;
    let mut Cost: InstructionCost = InputLT.first * TCC_Basic;
    let mut INegCost: InstructionCost = if IsSub { 2 * InputLT.first * TCC_Basic } else { 0 };
    if AccumLT.second.getScalarType() == i32 && InputLT.second.getScalarType() == i8 {
        if !IsUSDot && IsSupported.call(true, self.ST.hasDotProd()) {
            return Cost + INegCost;
        }
        if IsUSDot && IsSupported.call(self.ST.hasMatMulInt8(), self.ST.hasMatMulInt8()) {
            return Cost + INegCost;
        }
        if IsUSDot && IsSupported.call(false, self.ST.hasDotProd()) {
            return Cost * 3 + INegCost;
        }
    }
    if self.ST.isSVEorStreamingSVEAvailable() && !IsUSDot {
        if AccumLT.second.getScalarType() == i64 && InputLT.second.getScalarType() == i16 {
            return Cost + INegCost;
        }
        if AccumLT.second.getScalarType() == i32 && InputLT.second.getScalarType() == i16 && (self.ST.hasSVE2p1() || self.ST.hasSME2()) && !IsSub {
            return Cost;
        }
        if AccumLT.second.getScalarType() == i64 && InputLT.second.getScalarType() == i8 {
            return Cost + INegCost;
        }
        if AccumLT.second.getScalarType() == i16 && InputLT.second.getScalarType() == i8 && (self.ST.hasSVE2p3() || self.ST.hasSME2p3()) && !IsSub {
            return Cost;
        }
    }
    if Opcode == FAdd && !IsSub && IsSupported.call(self.ST.hasSME2() || self.ST.hasSVE2p1(), self.ST.hasF16F32DOT()) && AccumLT.second.getScalarType() == f32 && InputLT.second.getScalarType() == f16 {
        return Cost;
    }
    if Ratio == 2 && !IsUSDot {
        let mut InVT: MVT = InputLT.second.getScalarType();
        if IsSupported.call(self.ST.hasSVE2() || self.ST.hasSME(), true) && is_contained([i8, i16, i32], InVT.SimpleTy) {
            return if (BinOp || IsSub) { Cost * 2 } else { Cost };
        }
        if IsSupported.call(self.ST.hasSVE2(), self.ST.hasFP16FML()) && InVT == f16 {
            return Cost * 2;
        }
        if IsSupported.call(self.ST.hasSVE2p1() || self.ST.hasSME2(), false) && InVT == bf16 && IsSub {
            return Cost * 2;
        }
        let mut FNegCost: InstructionCost = if IsSub { InputLT.first * TCC_Basic } else { 0 };
        if IsSupported.call(self.ST.hasBF16(), self.ST.hasBF16()) && InVT == bf16 {
            return Cost * 2 + FNegCost;
        }
    }
    return self.getPartialReductionCost(Opcode, InputTypeA, InputTypeB, AccumType, VF, OpAExtend, OpBExtend, BinOp, CostKind, FMF);
}

fn AArch64TTIImpl::getShuffleCost(self: *AArch64TTIImpl, Kind: ShuffleKind, DstTy: *mut VectorType, SrcTy: *mut VectorType, CostKind: TargetCostKind, Mask: ArrayRef<int>, Index: i32, SubTp: *mut VectorType, Args: ArrayRef<const Value *>, CtxI: *Instruction, VIC: VectorInstrContext) -> InstructionCost {
    assert!((Mask.is_empty() || DstTy.isScalableTy() || Mask.len == DstTy.getElementCount().getKnownMinValue()), "Expected the Mask to match the return size if given");
    assert!(SrcTy.getScalarType() == DstTy.getScalarType(), "Expected the same scalar types");
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(SrcTy);
    if !Mask.is_empty() && isa(SrcTy) && LT.second.isVector() && LT.second.getScalarSizeInBits() * Mask.len > 128 && SrcTy.getScalarSizeInBits() == LT.second.getScalarSizeInBits() && Mask.len > LT.second.getVectorNumElements() && !Index && !SubTp {
        if Args.len >= 1 && isa(Args[0]) && (isDeInterleaveMaskOfFactor(Mask, 3) || isDeInterleaveMaskOfFactor(Mask, 4)) {
            return if 1 > LT.first / 4 { 1 } else { LT.first / 4 };
        }
        if CtxI && CtxI.hasOneUse() && isa(operator(CtxI.user_begin())) && (isInterleaveMask(Mask, 4, SrcTy.getElementCount().getKnownMinValue() * 2) || isInterleaveMask(Mask, 3, SrcTy.getElementCount().getKnownMinValue() * 2)) {
            return LT.first;
        }
        let mut TpNumElts: u32 = Mask.len;
        let mut LTNumElts: u32 = LT.second.getVectorNumElements();
        let mut NumVecs: u32 = (TpNumElts + LTNumElts - 1) / LTNumElts;
        let mut NTp: *mut VectorType = get(SrcTy.getScalarType(), LT.second.getVectorElementCount());
        let mut Cost: InstructionCost = InstructionCost {};
        let mut PreviousCosts: tuple<unsigned int, unsigned int, SmallVector<int>>, InstructionCost> = tuple<unsigned int, unsigned int, SmallVector<int>>, InstructionCost> {};
        for let mut N: u32 = 0; N < NumVecs; N += 1 {
            let mut NMask: SmallVector<int> = SmallVector<int> {};
            let mut Source1: u32 = -1;
            let mut Source2: u32 = -1;
            let mut NumSources: u32 = 0;
            for let mut E: u32 = 0; E < LTNumElts; E += 1 {
                let mut MaskElt: i32 = if (N * LTNumElts + E < TpNumElts) { Mask[N * LTNumElts + E] } else { PoisonMaskElem };
                if MaskElt < 0 {
                    NMask.push(PoisonMaskElem);
                    continue;
                }
                let mut Source: u32 = MaskElt / LTNumElts;
                if NumSources == 0 {
                    Source1 = Source;
                    NumSources = 1;
                } else if NumSources == 1 && Source != Source1 {
                    Source2 = Source;
                    NumSources = 2;
                } else if NumSources >= 2 && Source != Source1 && Source != Source2 {
                    NumSources += 1;
                }
                if Source == Source1 {
                    NMask.push(MaskElt % LTNumElts);
                } else if Source == Source2 {
                    NMask.push(MaskElt % LTNumElts + LTNumElts);
                } else {
                    NMask.push(MaskElt % LTNumElts);
                }
            }
            let mut Result: pair<iterator, bool> = PreviousCosts.insert(value_type { make_tuple(Source1, Source2, NMask), 0 });
            if !Result.second {
                continue;
            }
            let mut NCost: InstructionCost = if NumSources <= 2 { self.getShuffleCost(if NumSources <= 1 { SK_PermuteSingleSrc } else { SK_PermuteTwoSrc }, NTp, NTp, CostKind, NMask, 0, null, Args, CtxI, None) } else { LTNumElts };
            operator(Result.first).second = NCost;
            operator(Cost, NCost);
        }
        return Cost;
    }
    Kind = self.improveShuffleKindFromMask(Kind, Mask, SrcTy, Index, SubTp);
    let mut IsExtractSubvector: bool = Kind == SK_ExtractSubvector;
    if IsExtractSubvector && LT.second.isFixedLengthVector() {
        if LT.second.getFixedSizeInBits() >= 128 && cast(SubTp).getNumElements() == LT.second.getVectorNumElements() / 2 {
            if Index == 0 {
                return 0;
            }
            if Index == LT.second.getVectorNumElements() as i32 / 2 {
                return 1;
            }
        }
        Kind = SK_PermuteSingleSrc;
    }
    if Kind == SK_InsertSubvector {
        LT = self.getTypeLegalizationCost(DstTy);
        SrcTy = DstTy;
    }
    if !Mask.is_empty() && LT.second.isFixedLengthVector() && (Kind == SK_PermuteTwoSrc || Kind == SK_PermuteSingleSrc) && all_of(enumerate(Mask), Closure_55 {}) {
        return 0;
    }
    if Kind == SK_PermuteSingleSrc && isa(SrcTy) && !Mask.is_empty() && SrcTy.getPrimitiveSizeInBits().isNonZero() && SrcTy.getPrimitiveSizeInBits().isKnownMultipleOf(SVEBitsPerBlock) {
        let mut VTy: *mut FixedVectorType = cast(SrcTy);
        let mut Segments: u32 = VTy.getPrimitiveSizeInBits().operator unsigned long long() / SVEBitsPerBlock;
        let mut SegmentElts: u32 = VTy.getNumElements() / Segments;
        if (self.ST.hasSVE2p1() || self.ST.hasSME2p1()) && self.ST.isSVEorStreamingSVEAvailable() && isDUPQMask(Mask, Segments, SegmentElts) {
            return LT.first;
        }
        if self.ST.isSVEorStreamingSVEAvailable() && isDUPFirstSegmentMask(Mask, Segments, SegmentElts) {
            return LT.first;
        }
    }
    if CostKind == TCK_CodeSize && Kind == SK_Broadcast {
        let mut IsLoad: bool = !Args.is_empty() && isa(Args[0]);
        if IsLoad && LT.second.isVector() && self.isLegalBroadcastLoad(SrcTy.getElementType(), LT.second.getVectorElementCount()) {
            return 0;
        }
    }
    if Mask.len == 4 && SrcTy.getElementCount() == getFixed(4) && (SrcTy.getScalarSizeInBits() == 16 || SrcTy.getScalarSizeInBits() == 32) && all_of(Mask, Closure_56 {}) {
        return getPerfectShuffleCost(Mask);
    }
    let mut Unused: u32 = 0;
    if LT.second.isFixedLengthVector() && LT.second.getVectorNumElements() == Mask.len && (Kind == SK_PermuteTwoSrc || Kind == SK_PermuteSingleSrc || Kind == SK_InsertSubvector) && (isZIPMask(Mask, LT.second.getVectorNumElements(), Unused, Unused) || isTRNMask(Mask, LT.second.getVectorNumElements(), Unused, Unused) || isUZPMask(Mask, LT.second.getVectorNumElements(), Unused) || isREVMask(Mask, LT.second.getScalarSizeInBits(), LT.second.getVectorNumElements(), 16) || isREVMask(Mask, LT.second.getScalarSizeInBits(), LT.second.getVectorNumElements(), 32) || isREVMask(Mask, LT.second.getScalarSizeInBits(), LT.second.getVectorNumElements(), 64) || all_of(drop_begin(Mask, 1), Closure_57 { Mask: &mut Mask })) {
        return 1;
    }
    if Kind == SK_Broadcast || Kind == SK_Transpose || Kind == SK_Select || Kind == SK_PermuteSingleSrc || Kind == SK_Reverse || Kind == SK_Splice {
        let mut ShuffleTbl: [110]CostTblEntry = [CostTblEntry { SK_Broadcast, v8i8, 1 }, CostTblEntry { SK_Broadcast, v16i8, 1 }, CostTblEntry { SK_Broadcast, v4i16, 1 }, CostTblEntry { SK_Broadcast, v8i16, 1 }, CostTblEntry { SK_Broadcast, v2i32, 1 }, CostTblEntry { SK_Broadcast, v4i32, 1 }, CostTblEntry { SK_Broadcast, v2i64, 1 }, CostTblEntry { SK_Broadcast, v4f16, 1 }, CostTblEntry { SK_Broadcast, v8f16, 1 }, CostTblEntry { SK_Broadcast, v4bf16, 1 }, CostTblEntry { SK_Broadcast, v8bf16, 1 }, CostTblEntry { SK_Broadcast, v2f32, 1 }, CostTblEntry { SK_Broadcast, v4f32, 1 }, CostTblEntry { SK_Broadcast, v2f64, 1 }, CostTblEntry { SK_Transpose, v8i8, 1 }, CostTblEntry { SK_Transpose, v16i8, 1 }, CostTblEntry { SK_Transpose, v4i16, 1 }, CostTblEntry { SK_Transpose, v8i16, 1 }, CostTblEntry { SK_Transpose, v2i32, 1 }, CostTblEntry { SK_Transpose, v4i32, 1 }, CostTblEntry { SK_Transpose, v2i64, 1 }, CostTblEntry { SK_Transpose, v4f16, 1 }, CostTblEntry { SK_Transpose, v8f16, 1 }, CostTblEntry { SK_Transpose, v4bf16, 1 }, CostTblEntry { SK_Transpose, v8bf16, 1 }, CostTblEntry { SK_Transpose, v2f32, 1 }, CostTblEntry { SK_Transpose, v4f32, 1 }, CostTblEntry { SK_Transpose, v2f64, 1 }, CostTblEntry { SK_Select, v2i32, 1 }, CostTblEntry { SK_Select, v4i32, 2 }, CostTblEntry { SK_Select, v2i64, 1 }, CostTblEntry { SK_Select, v2f32, 1 }, CostTblEntry { SK_Select, v4f32, 2 }, CostTblEntry { SK_Select, v2f64, 1 }, CostTblEntry { SK_PermuteSingleSrc, v2i32, 1 }, CostTblEntry { SK_PermuteSingleSrc, v4i32, 3 }, CostTblEntry { SK_PermuteSingleSrc, v2i64, 1 }, CostTblEntry { SK_PermuteSingleSrc, v2f32, 1 }, CostTblEntry { SK_PermuteSingleSrc, v4f32, 3 }, CostTblEntry { SK_PermuteSingleSrc, v2f64, 1 }, CostTblEntry { SK_PermuteSingleSrc, v4i16, 3 }, CostTblEntry { SK_PermuteSingleSrc, v4f16, 3 }, CostTblEntry { SK_PermuteSingleSrc, v4bf16, 3 }, CostTblEntry { SK_PermuteSingleSrc, v8i16, 8 }, CostTblEntry { SK_PermuteSingleSrc, v8f16, 8 }, CostTblEntry { SK_PermuteSingleSrc, v8bf16, 8 }, CostTblEntry { SK_PermuteSingleSrc, v8i8, 8 }, CostTblEntry { SK_PermuteSingleSrc, v16i8, 8 }, CostTblEntry { SK_Reverse, v2i32, 1 }, CostTblEntry { SK_Reverse, v4i32, 2 }, CostTblEntry { SK_Reverse, v2i64, 1 }, CostTblEntry { SK_Reverse, v2f32, 1 }, CostTblEntry { SK_Reverse, v4f32, 2 }, CostTblEntry { SK_Reverse, v2f64, 1 }, CostTblEntry { SK_Reverse, v8f16, 2 }, CostTblEntry { SK_Reverse, v8bf16, 2 }, CostTblEntry { SK_Reverse, v8i16, 2 }, CostTblEntry { SK_Reverse, v16i8, 2 }, CostTblEntry { SK_Reverse, v4f16, 1 }, CostTblEntry { SK_Reverse, v4bf16, 1 }, CostTblEntry { SK_Reverse, v4i16, 1 }, CostTblEntry { SK_Reverse, v8i8, 1 }, CostTblEntry { SK_Splice, v2i32, 1 }, CostTblEntry { SK_Splice, v4i32, 1 }, CostTblEntry { SK_Splice, v2i64, 1 }, CostTblEntry { SK_Splice, v2f32, 1 }, CostTblEntry { SK_Splice, v4f32, 1 }, CostTblEntry { SK_Splice, v2f64, 1 }, CostTblEntry { SK_Splice, v8f16, 1 }, CostTblEntry { SK_Splice, v8bf16, 1 }, CostTblEntry { SK_Splice, v8i16, 1 }, CostTblEntry { SK_Splice, v16i8, 1 }, CostTblEntry { SK_Splice, v4f16, 1 }, CostTblEntry { SK_Splice, v4bf16, 1 }, CostTblEntry { SK_Splice, v4i16, 1 }, CostTblEntry { SK_Splice, v8i8, 1 }, CostTblEntry { SK_Broadcast, nxv16i8, 1 }, CostTblEntry { SK_Broadcast, nxv8i16, 1 }, CostTblEntry { SK_Broadcast, nxv4i32, 1 }, CostTblEntry { SK_Broadcast, nxv2i64, 1 }, CostTblEntry { SK_Broadcast, nxv2f16, 1 }, CostTblEntry { SK_Broadcast, nxv4f16, 1 }, CostTblEntry { SK_Broadcast, nxv8f16, 1 }, CostTblEntry { SK_Broadcast, nxv2bf16, 1 }, CostTblEntry { SK_Broadcast, nxv4bf16, 1 }, CostTblEntry { SK_Broadcast, nxv8bf16, 1 }, CostTblEntry { SK_Broadcast, nxv2f32, 1 }, CostTblEntry { SK_Broadcast, nxv4f32, 1 }, CostTblEntry { SK_Broadcast, nxv2f64, 1 }, CostTblEntry { SK_Broadcast, nxv16i1, 1 }, CostTblEntry { SK_Broadcast, nxv8i1, 1 }, CostTblEntry { SK_Broadcast, nxv4i1, 1 }, CostTblEntry { SK_Broadcast, nxv2i1, 1 }, CostTblEntry { SK_Reverse, nxv16i8, 1 }, CostTblEntry { SK_Reverse, nxv8i16, 1 }, CostTblEntry { SK_Reverse, nxv4i32, 1 }, CostTblEntry { SK_Reverse, nxv2i64, 1 }, CostTblEntry { SK_Reverse, nxv2f16, 1 }, CostTblEntry { SK_Reverse, nxv4f16, 1 }, CostTblEntry { SK_Reverse, nxv8f16, 1 }, CostTblEntry { SK_Reverse, nxv2bf16, 1 }, CostTblEntry { SK_Reverse, nxv4bf16, 1 }, CostTblEntry { SK_Reverse, nxv8bf16, 1 }, CostTblEntry { SK_Reverse, nxv2f32, 1 }, CostTblEntry { SK_Reverse, nxv4f32, 1 }, CostTblEntry { SK_Reverse, nxv2f64, 1 }, CostTblEntry { SK_Reverse, nxv16i1, 1 }, CostTblEntry { SK_Reverse, nxv8i1, 1 }, CostTblEntry { SK_Reverse, nxv4i1, 1 }, CostTblEntry { SK_Reverse, nxv2i1, 1 }];
        if CostTableLookup(ShuffleTbl, Kind, LT.second) {
            Entry;
        } else {
            return LT.first * Entry.Cost;
        }
    }
    if Kind == SK_Splice && isa(SrcTy) {
        return self.getSpliceCost(SrcTy, Index, CostKind);
    }
    if Kind == SK_InsertSubvector && LT.second.isFixedLengthVector() && LT.second.getSizeInBits().operator unsigned long long() <= 128 && SubTp {
        let mut SubLT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(SubTp);
        if SubLT.second.isVector() {
            let mut NumElts: i32 = LT.second.getVectorNumElements();
            let mut NumSubElts: i32 = SubLT.second.getVectorNumElements();
            if (Index % NumSubElts) == 0 && (NumElts % NumSubElts) == 0 {
                return SubLT.first;
            }
        }
    }
    if IsExtractSubvector {
        Kind = SK_ExtractSubvector;
    }
    return self.getShuffleCost(Kind, DstTy, SrcTy, CostKind, Mask, Index, SubTp, Args, CtxI, None);
}

fn containsDecreasingPointers(TheLoop: *mut Loop, PSE: *mut PredicatedScalarEvolution, DT: *DominatorTree) -> bool {
    let mut Strides: *SymbolicStrideMap = SymbolicStrideMap {};
    for BB in TheLoop.blocks() {
        for I in *BB {
            if isa(&mut I) || isa(&mut I) {
                let mut Ptr: *mut Value = getLoadStorePointerOperand(&mut I);
                let mut AccessTy: *mut Type = getLoadStoreType(&mut I);
                let mut Predicates: SmallVector<const SCEVPredicate *> = SmallVector<const SCEVPredicate *> {};
                if getPtrStride(*PSE, AccessTy, Ptr, TheLoop, DT, Strides, false, &mut Predicates).value_or(0) < 0 {
                    return true;
                }
            }
        }
    }
    return false;
}

fn AArch64TTIImpl::preferFixedOverScalableIfEqualCost(self: *AArch64TTIImpl) -> bool {
    if SVEPreferFixedOverScalableIfEqualCost.getNumOccurrences() {
        return SVEPreferFixedOverScalableIfEqualCost;
    }
    return self.ST.useFixedOverScalableIfEqualCost();
}

fn AArch64TTIImpl::getEpilogueVectorizationMinVF(self: *AArch64TTIImpl) -> u32 {
    return self.ST.getEpilogueVectorizationMinVF();
}

fn AArch64TTIImpl::preferTailFoldingOverEpilogue(self: *AArch64TTIImpl, TFI: *mut TailFoldingInfo) -> bool {
    let mut DefaultOpts: TailFoldingOpts = self.ST.getSVETailFoldingDefaultOpts();
    if !self.ST.hasSVE() || TailFoldingOptionLoc.isDisabled(DefaultOpts) {
        return false;
    }
    if TFI.IAI.hasGroups() {
        return false;
    }
    let mut Required: TailFoldingOpts = Disabled;
    if TFI.LVL.getReductionVars().len {
        operator(Required, Reductions);
    }
    if TFI.LVL.getFixedOrderRecurrences().len {
        operator(Required, Recurrences);
    }
    if containsDecreasingPointers(TFI.LVL.getLoop(), TFI.LVL.getPredicatedScalarEvolution(), *TFI.LVL.getDominatorTree()) {
        operator(Required, Reverse);
    }
    if Required == Disabled {
        operator(Required, Simple);
    }
    if !TailFoldingOptionLoc.satisfies(DefaultOpts, Required) {
        return false;
    }
    let mut NumInsns: u32 = 0;
    for BB in TFI.LVL.getLoop().blocks() {
        NumInsns += BB.len;
    }
    return NumInsns >= SVETailFoldInsnThreshold.operator unsigned int();
}

fn AArch64TTIImpl::getScalingFactorCost(self: *AArch64TTIImpl, Ty: *mut Type, BaseGV: *mut GlobalValue, BaseOffset: StackOffset, HasBaseReg: bool, Scale: i64, AddrSpace: u32) -> InstructionCost {
    let mut AM: AddrMode = AddrMode {};
    AM.BaseGV = BaseGV;
    AM.BaseOffs = BaseOffset.getFixed();
    AM.HasBaseReg = HasBaseReg;
    AM.Scale = Scale;
    AM.ScalableOffset = BaseOffset.getScalable();
    if self.getTLI().isLegalAddressingMode(self.DL, AM, Ty, AddrSpace, null) {
        return AM.Scale != 0 && AM.Scale != 1;
    }
    return getInvalid(0);
}

fn AArch64TTIImpl::shouldTreatInstructionLikeSelect(self: *AArch64TTIImpl, I: *Instruction) -> bool {
    if EnableOrLikeSelectOpt {
        if I.getOpcode() == Or && isa(I.getNextNode()) {
            return true;
        }
        if I.getOpcode() == Add || I.getOpcode() == Sub {
            return true;
        }
    }
    return self.shouldTreatInstructionLikeSelect(I);
}

fn AArch64TTIImpl::isLSRCostLess(self: *AArch64TTIImpl, C1: *LSRCost, C2: *LSRCost) -> bool {
    if EnableLSRCostOpt {
        return operator(tie(C1.NumRegs, C1.Insns, C1.NumBaseAdds, C1.AddRecCost, C1.NumIVMuls, C1.ScaleCost, C1.ImmCost, C1.SetupCost), tie(C2.NumRegs, C2.Insns, C2.NumBaseAdds, C2.AddRecCost, C2.NumIVMuls, C2.ScaleCost, C2.ImmCost, C2.SetupCost)) < 0;
    }
    return self.isLSRCostLess(C1, C2);
}

fn isSplatShuffle(V: *mut Value) -> bool {
    if dyn_cast(V) {
        Shuf;
    } else {
        return all_equal(Shuf.getShuffleMask());
    }
    return false;
}

fn areExtractShuffleVectors(Op1: *mut Value, Op2: *mut Value, AllowSplat: bool) -> bool {
    if Op1.getType().isScalableTy() || Op2.getType().isScalableTy() {
        return false;
    }
    let mut areTypesHalfed: Closure_58 = Closure_58 {};
    let mut extractHalf: Closure_59 = Closure_59 {};
    let mut M1: ArrayRef<int> = ArrayRef<int> {};
    let mut M2: ArrayRef<int> = ArrayRef<int> {};
    let mut S1Op1: *mut Value = null;
    let mut S2Op1: *mut Value = null;
    if !match(Op1, m_Shuffle(m_Value(S1Op1), m_Undef(), M1)) || !match(Op2, m_Shuffle(m_Value(S2Op1), m_Undef(), M2)) {
        return false;
    }
    if AllowSplat && isSplatShuffle(Op1) {
        S1Op1 = null;
    }
    if AllowSplat && isSplatShuffle(Op2) {
        S2Op1 = null;
    }
    if (S1Op1 && (!areTypesHalfed.call(S1Op1, Op1) || !extractHalf.call(S1Op1, Op1))) || (S2Op1 && (!areTypesHalfed.call(S2Op1, Op2) || !extractHalf.call(S2Op1, Op2))) {
        return false;
    }
    let mut M1Start: i32 = 0;
    let mut M2Start: i32 = 0;
    let mut NumElements: i32 = cast(Op1.getType()).getNumElements() * 2;
    if (S1Op1 && !isExtractSubvectorMask(M1, NumElements, M1Start)) || (S2Op1 && !isExtractSubvectorMask(M2, NumElements, M2Start)) {
        return false;
    }
    if (M1Start != 0 && M1Start != (NumElements / 2)) || (M2Start != 0 && M2Start != (NumElements / 2)) {
        return false;
    }
    if S1Op1 && S2Op1 && M1Start != M2Start {
        return false;
    }
    return true;
}

fn areExtractExts(Ext1: *mut Value, Ext2: *mut Value) -> bool {
    let mut areExtDoubled: Closure_60 = Closure_60 {};
    if !match(Ext1, m_ZExtOrSExt(m_Value())) || !match(Ext2, m_ZExtOrSExt(m_Value())) || !areExtDoubled.call(cast(Ext1)) || !areExtDoubled.call(cast(Ext2)) {
        return false;
    }
    return true;
}

fn isOperandOfVmullHighP64(Op: *mut Value) -> bool {
    let mut VectorOperand: *mut Value = null;
    let mut ElementIndex: *mut ConstantInt = null;
    return match(Op, m_ExtractElt(m_Value(VectorOperand), m_ConstantInt(ElementIndex))) && ElementIndex.getValue() == 1 && isa(VectorOperand.getType()) && cast(VectorOperand.getType()).getNumElements() == 2;
}

fn areOperandsOfVmullHighP64(Op1: *mut Value, Op2: *mut Value) -> bool {
    return isOperandOfVmullHighP64(Op1) && isOperandOfVmullHighP64(Op2);
}

fn shouldSinkVectorOfPtrs(Ptrs: *mut Value, Ops: *mut SmallVectorImpl<Use *>) -> bool {
    let mut GEP: *mut GetElementPtrInst = dyn_cast(Ptrs);
    if !GEP || GEP.getNumOperands() != 2 {
        return false;
    }
    let mut Base: *mut Value = GEP.getOperand(0);
    let mut Offsets: *mut Value = GEP.getOperand(1);
    if Base.getType().isVectorTy() || !Offsets.getType().isVectorTy() {
        return false;
    }
    if isa(Offsets) || isa(Offsets) {
        let mut OffsetsInst: *mut Instruction = cast(Offsets);
        if OffsetsInst.getType().getScalarSizeInBits() > 32 && OffsetsInst.getOperand(0).getType().getScalarSizeInBits() <= 32 {
            Ops.push(&mut GEP.getOperandUse(1));
        }
    }
    return true;
}

fn shouldSinkVScale(Op: *mut Value, Ops: *mut SmallVectorImpl<Use *>) -> bool {
    if match(Op, m_VScale()) {
        return true;
    }
    if match(Op, m_Shl(m_VScale(), m_ConstantInt())) || match(Op, m_Mul(m_VScale(), m_ConstantInt())) {
        Ops.push(&mut cast(Op).getOperandUse(0));
        return true;
    }
    if match(Op, m_Shl(m_ZExt(m_VScale()), m_ConstantInt())) || match(Op, m_Mul(m_ZExt(m_VScale()), m_ConstantInt())) {
        let mut ZExtOp: *mut Value = cast(Op).getOperand(0);
        Ops.push(&mut cast(ZExtOp).getOperandUse(0));
        Ops.push(&mut cast(Op).getOperandUse(0));
        return true;
    }
    return false;
}

fn isFNeg(Op: *mut Value) -> bool {
    return match(Op, m_FNeg(m_Value()));
}

fn AArch64TTIImpl::isProfitableToSinkOperands(self: *AArch64TTIImpl, I: *mut Instruction, Ops: *mut SmallVectorImpl<Use *>) -> bool {
    if dyn_cast(I) {
        II;
    } else {
        match II.getIntrinsicID() {
            aarch64_neon_smull => {
                aarch64_neon_umull;
            },
            fma => {
                fmuladd;
            },
            aarch64_neon_sqdmull => {
                aarch64_neon_sqdmulh;
            },
            aarch64_neon_fmlal => {
                aarch64_neon_fmlal2;
            },
            aarch64_sve_ptest_first => {
                aarch64_sve_ptest_last;
            },
            aarch64_sme_write_horiz => {
                aarch64_sme_write_vert;
            },
            aarch64_sme_read_horiz => {
                aarch64_sme_read_vert;
            },
            aarch64_neon_pmull => {
                if !areExtractShuffleVectors(II.getOperand(0), II.getOperand(1), false) {
                    return false;
                }
            },
            aarch64_neon_pmull64 => {
                if !areOperandsOfVmullHighP64(II.getArgOperand(0), II.getArgOperand(1)) {
                    return false;
                }
            },
            masked_gather => {
                if !shouldSinkVectorOfPtrs(II.getArgOperand(0), Ops) {
                    return false;
                }
            },
            masked_scatter => {
                if !shouldSinkVectorOfPtrs(II.getArgOperand(1), Ops) {
                    return false;
                }
            },
            _ => {
                return false;
            },
        }
    }
    let mut ShouldSinkCondition: Closure_61 = Closure_61 {};
    match I.getOpcode() {
        GetElementPtr => {
            Add;
        },
        Select => {
            if !ShouldSinkCondition.call(I.getOperand(0), Ops) {
                return false;
            }
            Ops.push(&mut I.getOperandUse(0));
            return true;
        },
        UncondBr => {
            return false;
        },
        CondBr => {
            if !ShouldSinkCondition.call(cast(I).getCondition(), Ops) {
                return false;
            }
            Ops.push(&mut I.getOperandUse(0));
            return true;
        },
        FMul => {
            if cast(I).hasAllowContract() {
                if isFNeg(I.getOperand(0)) {
                    Ops.push(&mut I.getOperandUse(0));
                }
                if isFNeg(I.getOperand(1)) {
                    Ops.push(&mut I.getOperandUse(1));
                }
            }
        },
        Xor => {
            if I.getType().isVectorTy() && self.ST.isNeonAvailable() {
                let mut HasBSL2N: bool = self.ST.isSVEorStreamingSVEAvailable() && (self.ST.hasSVE2() || self.ST.hasSME());
                if !HasBSL2N {
                    break;
                }
            }
        },
        And => {
            Or;
        },
        _ => {
            break;
        },
    }
    if !I.getType().isVectorTy() {
        return !Ops.is_empty();
    }
    match I.getOpcode() {
        Sub => {
            Add;
        },
        Or => {
            if self.ST.hasNEON() {
                let mut OtherAnd: *mut Instruction = null;
                let mut IA: *mut Instruction = null;
                let mut IB: *mut Instruction = null;
                let mut MaskValue: *mut Value = null;
                if match(I, m_c_Or(m_OneUse(m_Instruction(OtherAnd)), m_OneUse(m_c_And(m_OneUse(m_Not(m_Value(MaskValue))), m_Instruction(IA))))) {
                    if match(OtherAnd, m_c_And(m_Specific(MaskValue), m_Instruction(IB))) {
                        let mut MainAnd: *mut Instruction = if I.getOperand(0) == OtherAnd { cast(I.getOperand(1)) } else { cast(I.getOperand(0)) };
                        if I.getParent() != MainAnd.getParent() || I.getParent() != OtherAnd.getParent() {
                            return false;
                        }
                        if I.getParent() != IA.getParent() || I.getParent() != IB.getParent() {
                            return false;
                        }
                        Ops.push(&mut MainAnd.getOperandUse(if MainAnd.getOperand(0) == IA { 1 } else { 0 }));
                        Ops.push(&mut I.getOperandUse(0));
                        Ops.push(&mut I.getOperandUse(1));
                        return true;
                    }
                }
            }
            return false;
        },
        Mul => {
            let mut ShouldSinkSplatForIndexedVariant: Closure_62 = Closure_62 {};
            let mut NumZExts: i32 = 0;
            let mut NumSExts: i32 = 0;
            for Op in I.operands() {
                if any_of(Ops, Closure_63 { Op: &mut Op }) {
                    continue;
                }
                if match(&mut Op, m_ZExtOrSExt(m_Value())) {
                    let mut Ext: *mut Instruction = cast(Op);
                    let mut ExtOp: *mut Value = Ext.getOperand(0);
                    if isSplatShuffle(ExtOp) && ShouldSinkSplatForIndexedVariant.call(ExtOp) {
                        Ops.push(&mut Ext.getOperandUse(0));
                    }
                    Ops.push(&mut Op);
                    if isa(Ext) {
                        NumSExts += 1;
                    } else {
                        NumZExts += 1;
                        if Ext.getOperand(0).getType().getScalarSizeInBits() * 2 < I.getType().getScalarSizeInBits() {
                            NumSExts += 1;
                        }
                    }
                    continue;
                }
                let mut Shuffle: *mut ShuffleVectorInst = dyn_cast(Op);
                if !Shuffle {
                    continue;
                }
                if isSplatShuffle(Shuffle) && match(Shuffle.getOperand(0), m_ZExtOrSExt(m_Value())) {
                    Ops.push(&mut Shuffle.getOperandUse(0));
                    Ops.push(&mut Op);
                    if match(Shuffle.getOperand(0), m_SExt(m_Value())) {
                        NumSExts += 1;
                    } else {
                        NumZExts += 1;
                    }
                    continue;
                }
                let mut ShuffleOperand: *mut Value = Shuffle.getOperand(0);
                let mut Insert: *mut InsertElementInst = dyn_cast(ShuffleOperand);
                if !Insert {
                    continue;
                }
                let mut OperandInstr: *mut Instruction = dyn_cast(Insert.getOperand(1));
                if !OperandInstr {
                    continue;
                }
                let mut ElementConstant: *mut ConstantInt = dyn_cast(Insert.getOperand(2));
                if !ElementConstant || !ElementConstant.isZero() {
                    continue;
                }
                let mut Opcode: u32 = OperandInstr.getOpcode();
                if Opcode == SExt {
                    NumSExts += 1;
                } else if Opcode == ZExt {
                    NumZExts += 1;
                } else {
                    let mut Bitwidth: u32 = I.getType().getScalarSizeInBits();
                    let mut UpperMask: APInt = getHighBitsSet(Bitwidth, Bitwidth / 2);
                    if !MaskedValueIsZero(OperandInstr, UpperMask, SimplifyQuery { self.DL, null }, 0) {
                        continue;
                    }
                    NumZExts += 1;
                }
                if !match(OperandInstr, m_And(m_Load(m_Value()), m_Value())) {
                    Ops.push(&mut Insert.getOperandUse(1));
                }
                Ops.push(&mut Shuffle.getOperandUse(0));
                Ops.push(&mut Op);
            }
            if !Ops.is_empty() && (NumSExts == 2 || NumZExts == 2) {
                return true;
            }
            if !ShouldSinkSplatForIndexedVariant.call(I) {
                return false;
            }
            Ops.clear();
            if isSplatShuffle(I.getOperand(0)) {
                Ops.push(&mut I.getOperandUse(0));
            }
            if isSplatShuffle(I.getOperand(1)) {
                Ops.push(&mut I.getOperandUse(1));
            }
            return !Ops.is_empty();
        },
        FMul => {
            if I.getType().isScalableTy() {
                return !Ops.is_empty();
            }
            if cast(I.getType()).getElementType().isHalfTy() && !self.ST.hasFullFP16() {
                return !Ops.is_empty();
            }
            if isSplatShuffle(I.getOperand(0)) {
                Ops.push(&mut I.getOperandUse(0));
            }
            if isSplatShuffle(I.getOperand(1)) {
                Ops.push(&mut I.getOperandUse(1));
            }
            return !Ops.is_empty();
        },
        _ => {
            return false;
        },
    }
    return false;
}

fn AArch64TTIImpl::isLegalMaskedCompressStore(self: *AArch64TTIImpl, DataType: *mut Type, Alignment: Align) -> bool {
    if !(self.ST.isSVEAvailable() || (self.ST.isSVEorStreamingSVEAvailable() && self.ST.hasSME2p2())) {
        return false;
    }
    if isa(DataType) && DataType.getPrimitiveSizeInBits().getFixedValue() < 128 {
        return false;
    }
    if !isa(DataType) {
        return self.isElementTypeLegalForScalableVector(DataType);
    }
    let mut LT: pair<InstructionCost, MVT> = self.getTypeLegalizationCost(DataType);
    if !LT.first.isValid() {
        return false;
    }
    let mut Ctx: *mut LLVMContext = DataType.getContext();
    match LT.second.SimpleTy {
        nxv2f16 => {
            nxv2bf16;
        },
        nxv4f16 => {
            nxv4bf16;
        },
        _ => {
            break;
        },
    }
    return self.isElementTypeLegalForCompressStore(LT.second.getScalarType().getTypeForEVT(Ctx));
}

