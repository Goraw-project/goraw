fn SVEIntrinsicInfo::inactiveLanesAreUnused(self: *SVEIntrinsicInfo) -> bool {
    return self.ResultLanes == InactiveLanesAreUnused;
}

fn SVEIntrinsicInfo::setInactiveLanesAreUnused(self) -> *mut SVEIntrinsicInfo {
    assert!(self.ResultLanes == Uninitialized, "Cannot set property twice!");
    self.ResultLanes = InactiveLanesAreUnused;
