fn AArch64TTIImpl::isBinExtWideningInstruction(self: *AArch64TTIImpl, Opcode: u32, DstTy: *mut Type, Args: ArrayRef<const Value *>, SrcOverrideTy: *mut Type) -> *mut Type {
