    let mut FPFallBack: *mut Value = IC()(Fallback, FPTy);
    let mut FPVTy: *mut auto = get(FPTy, cast(Vec.getType())());
    let mut FPVec: *mut Value = IC()(Vec);
    let mut FPII: *mut auto = IC()(II.getIntrinsicID(), void { FPVec.getType() }, void { Pg, FPFallBack, FPVec });
    let mut FPIItoInt: *mut Value = IC()(II.getType);
    return IC.replaceInstUsesWith;
}

