fn AArch64TTIImpl::getArithmeticReductionCost(self: *AArch64TTIImpl, Opcode: u32, ValTy: *mut VectorType, FMF: optional<FastMathFlags>, CostKind: TargetCostKind) -> InstructionCost {
    if  {
        if VTy()() == (1) {
            return getInvalid(0);
        }
