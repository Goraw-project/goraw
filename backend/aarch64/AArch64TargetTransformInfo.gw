struct Closure_47 {}

fn Closure_47::call(self: *Closure_47, L: *mut Loop, SE: *mut ScalarEvolution) -> i32 {
        let mut StridedLoads: i32 = 0;
        for BB in L.blocks() {
            for I in *BB {
                let mut LMemI: *mut LoadInst = dyn_cast(&mut I);
                if !LMemI {
                    continue;
                }
                let mut PtrValue: *mut Value = LMemI.getPointerOperand();
                if L.isLoopInvariant(PtrValue) {
                    continue;
                }
                let mut LSCEV: *SCEV = SE.getSCEV(PtrValue);
                let mut LSCEVAddRec: *SCEVAddRecExpr = dyn_cast(LSCEV);
                if !LSCEVAddRec || !LSCEVAddRec.isAffine() {
                    continue;
                }
                StridedLoads += 1;
                if StridedLoads > MaxStridedLoads / 2 {
                    return StridedLoads;
                }
            }
        }
        return StridedLoads;
    }

