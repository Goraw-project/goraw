    if requiresOrderedReduction() {
        if  {
            let mut BaseCost: InstructionCost = zeroed();
            return BaseCost + ();
        }
        if Opcode != FAdd || ValTy.getElementType().isBFloatTy() {
            return getInvalid(0);
        }
        let mut VTy: *mut auto = cast(ValTy);
        let mut Cost: InstructionCost = self.getArithmeticInstrCost(Opcode, CostKind);
        Cost *= self.getMaxNumElements();
        return Cost;
    }
    let mut LT: pair<InstructionCost, MVT> = zeroed();
    let mut MTy: MVT = ;
    if isa(ValTy) || self.TLI.useSVEForFixedLengthVectorVT(MTy, false) {
        return self.getArithmeticReductionCostSVE(Opcode, ValTy, CostKind);
    }
    let mut ISD: i32 = self.TLI.InstructionOpcodeToISD;
    assert!(ISD, "Invalid opcode");
    let mut CostTblNoPairwise: []CostTblEntry = zeroed();
    match ISD {
        _ => {
            break;
        },
        FADD => {
            let mut EltTy: *mut Type = ValTy.getScalarType();
            if MTy.isVector() && (EltTy.isFloatTy() || EltTy.isDoubleTy() || (EltTy.isHalfTy() && self.ST())) {
                let mut NElts: u32 = MTy.getVectorNumElements();
                if ValTy.getElementCount()() >= 2 && NElts >= 2 && isPowerOf2_32(NElts) {
                    return (LT() - 1) + Log2_32(NElts);
                }
            }
        },
        ADD => {
            if  {
                return (LT() - 1) + ;
            }
        },
        XOR => {
            AND;
        },
    }
}

fn AArch64TTIImpl::getExtendedReductionCost(self: *AArch64TTIImpl, Opcode: u32, IsUnsigned: bool, ResTy: *mut Type, VecTy: *mut VectorType, FMF: optional<FastMathFlags>, CostKind: TargetCostKind) -> InstructionCost {
    let mut VecVT: EVT = self.TLI.getValueType;
