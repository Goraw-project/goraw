    let mut CandidatesForRemoval: SmallVector<Instruction *, 32> = zeroed();
    let mut Cursor: *mut Value = II.getOperand;
    let mut EarliestReplacement: *mut Value = null;
    let mut IVTy: *auto = cast(II.getType);
    while Cursor {
        let mut CursorVTy: *auto = cast(Cursor.getType());
        if CursorVTy()()() < ()() {
            break;
        }
        if Cursor.getType() ==  {
            EarliestReplacement = Cursor;
        }
        let mut IntrinsicCursor: *mut auto = dyn_cast(Cursor);
        if  {
