fn instCombineSVECondLast(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Pg: *mut Value = II.getArgOperand;
    let mut Fallback: *mut Value = II.getArgOperand;
