                },
            }
        } else {
            match LT()() {
                8 => {
                    
                },
                16 => {
                    
                },
                32 => {
                    
                },
                64 => {
                    
                },
                _ => {
                    llvm_unreachable_internal("Unexpected integer type", "llvm\\lib\\Target\\AArch64\\AArch64TargetTransformInfo.cpp", 5765);
                },
            }
