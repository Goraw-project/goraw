    }
    return ;
}

fn AArch64TTIImpl::getInterleavedMemoryOpCost(self: *AArch64TTIImpl, Opcode: u32, VecTy: *mut Type, Factor: u32, Indices: ArrayRef<unsigned int>, Alignment: Align, AddressSpace: u32, CostKind: TargetCostKind, UseMaskForCond: bool, UseMaskForGaps: bool) -> InstructionCost {
