}

fn AArch64TTIImpl::getMaxInterleaveFactor(self: *AArch64TTIImpl, VF: ElementCount, HasUnorderedReductions: bool) -> u32 {
    if VF.isScalar() || (HasUnorderedReductions && VF()() <= 4) {
        return 4;
    }
    return self.ST.getMaxInterleaveFactor();
}

fn getFalkorUnrollingPreferences(L: *mut Loop, SE: *mut ScalarEvolution, UP: *mut UnrollingPreferences) {
    let mut countStridedLoads: Closure_12 = Closure_12 {};
    let mut StridedLoads: i32 = countStridedLoads.call(L, SE);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64tti", 1) {
            dbgs() << "falkor-hwpf: detected " << StridedLoads << " strided loads\n";
        }
    }
        if !(false) { break; }
    }
    if StridedLoads {
        UP.MaxCount = 1 << Log2_32(MaxStridedLoads / StridedLoads);
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64tti", 1) {
                dbgs() << "falkor-hwpf: setting unroll MaxCount to " << UP.MaxCount << 10;
            }
        }
            if !(false) { break; }
        }
    }
}

fn isLoopSizeWithinBudget(L: *mut Loop, TTI: *AArch64TTIImpl, Budget: InstructionCost, FinalSize: *mut u32) -> bool {
    let mut LoopCost: InstructionCost = 0;
    if FinalSize {
        *FinalSize = LoopCost.getValue();
    }
    return true;
}

fn shouldUnrollMultiExitLoop(L: *mut Loop, SE: *mut ScalarEvolution, TTI: *AArch64TTIImpl) -> bool {
    let mut BTC: *SCEV = SE.getSymbolicMaxBackedgeTakenCount(L);
    if isa(BTC) || isa(BTC) {
        return false;
    }
    let mut MaxTC: u32 = SE.getSmallConstantMaxTripCount(L, null);
    if MaxTC > 0 && MaxTC <= 32 {
        return false;
    }
    if !isLoopSizeWithinBudget(L, TTI, 5, null) {
        return false;
    }
    let mut Blocks: ArrayRef<BasicBlock *> = zeroed();
    if Blocks()() != 2 {
        return false;
    }
    if any_of(Closure_13 {}) {
        return false;
    }
    return true;
}

fn getAppleRuntimeUnrollPreferences(L: *mut Loop, SE: *mut ScalarEvolution, UP: *mut UnrollingPreferences, TTI: *AArch64TTIImpl) {
    if operator!(L()()) || L()() > 8 {
        return;
    }
    if operator!(L()()) {
        return;
    }
    let mut HasParellelizableReductions: bool = L()() == 1 && any_of(L()()(), Closure_14 { SE: &mut SE, L: L }) && isLoopSizeWithinBudget(L, TTI, 12, null);
    if HasParellelizableReductions && SE(L, L()()) % 2 == 0 {
        UP.Partial = true;
        UP.MaxCount = 4;
        UP.AddAdditionalAccumulators = true;
    }
    let mut BTC: *SCEV = SE.getSymbolicMaxBackedgeTakenCount(L);
    if isa(BTC) || isa(BTC) || (SE.getSmallConstantMaxTripCount(L, null) > 0 && SE.getSmallConstantMaxTripCount(L, null) <= 32) {
        return;
    }
    if findStringMetadataForLoop(L, "llvm.loop.isvectorized") {
        return;
    }
    if SE.getSymbolicMaxBackedgeTakenCount(L) != SE.getBackedgeTakenCount(L, Exact) {
        return;
    }
    UP.SCEVExpansionBudget = 1;
    if HasParellelizableReductions {
        UP.Runtime = true;
        UP.DefaultUnrollRuntimeCount = 4;
        UP.AddAdditionalAccumulators = true;
    }
    let mut Header: *mut BasicBlock = L()();
    let mut Latch: *mut BasicBlock = L()();
    if Header == Latch {
        let mut Size: u32 = 0;
        let mut Width: u32 = 10;
        if !isLoopSizeWithinBudget(L, TTI, Width, &mut Size) {
            return;
        }
        let mut MaxInstsPerLine: u32 = 16;
        let mut UC: u32 = 1;
        let mut BestUC: u32 = 1;
        let mut SizeWithBestUC: u32 = BestUC * Size;
        while UC <= 8 {
            let mut SizeWithUC: u32 = UC * Size;
            if SizeWithUC > 48 {
                break;
            }
            if (SizeWithUC % MaxInstsPerLine) == 0 || (SizeWithBestUC % MaxInstsPerLine) < (SizeWithUC % MaxInstsPerLine) {
                BestUC = UC;
                SizeWithBestUC = BestUC * Size;
            }
            UC += 1;
        }
        if BestUC == 1 {
            return;
        }
        let mut LoadedValuesPlus: SmallPtrSet<Value *, 8> = zeroed();
        let mut Stores: i32 = 0;
        if none_of(Closure_15 {}) {
            return;
        }
        UP.Runtime = true;
        UP.DefaultUnrollRuntimeCount = BestUC;
        return;
    }
    let mut Term: *mut auto = dyn_cast(Header.getTerminator());
    let mut Preds: i32 = predecessors(Latch);
    if operator!() || () == 1 || operator!(is_contained(Header)) || none_of(Closure_16 { L: L }) {
        return;
    }
    let mut DependsOnLoopLoad: function<bool (Instruction *, unsigned int)> = zeroed();
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut I: *mut Instruction = null;
    if match(m_Br(m_ICmp(Pred, m_Instruction(I), m_Value()), m_Value(), m_Value())) && (I, 0) {
        UP.Runtime = true;
    }
}

fn AArch64TTIImpl::getUnrollingPreferences(self: *AArch64TTIImpl, L: *mut Loop, SE: *mut ScalarEvolution, UP: *mut UnrollingPreferences, ORE: *mut OptimizationRemarkEmitter) {
    UP.UpperBound = true;
    if L()() && !SE.isBackedgeTakenCountMaxOrZero(L) && isa(SE.getBackedgeTakenCount(L, Exact)) {
        UP.MaxUpperBound = 5;
        UP.Runtime = false;
    }
    if L()() > 1 {
        UP.PartialThreshold *= 2;
    }
    UP.PartialOptSizeThreshold = 0;
    let mut IsVectorized: bool = getBooleanLoopAttribute(L, "llvm.loop.isvectorized");
    let mut Cost: InstructionCost = 0;
    if self.ST.isAppleMLike() {
        getAppleRuntimeUnrollPreferences(L, SE, UP, *self);
    } else if  {
        getFalkorUnrollingPreferences(L, SE, UP);
    }
    if operator!(L()()) && shouldUnrollMultiExitLoop(L, SE, *self) {
        UP.RuntimeUnrollMultiExit = true;
        UP.Runtime = true;
        UP.DefaultUnrollRuntimeCount = 4;
        UP.SCEVExpansionBudget = 5;
        return;
    }
    if self.ST.getProcFamily() != Generic && operator!(self.ST()()) {
        UP.Runtime = true;
        UP.Partial = true;
        UP.UnrollRemainder = true;
        UP.DefaultUnrollRuntimeCount = 4;
        UP.UnrollAndJam = true;
        UP.UnrollAndJamInnerLoopThreshold = 60;
    }
    if Cost < Aarch64ForceUnrollThreshold() {
        UP.Force = true;
    }
}

