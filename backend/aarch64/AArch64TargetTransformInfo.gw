            } else {
                return (0);
            }
        },
        RGK_ScalableVector => {
            if self.ST.isSVEAvailable() || (self.ST.isSVEorStreamingSVEAvailable() && ) {
                return (128);
            } else {
                return (0);
            }
        },
    }
    llvm_unreachable_internal("Unsupported register kind", "llvm\\lib\\Target\\AArch64\\AArch64TargetTransformInfo.cpp", 3698);
}

fn AArch64TTIImpl::isSingleExtWideningInstruction(self: *AArch64TTIImpl, Opcode: u32, DstTy: *mut Type, Args: ArrayRef<const Value *>, SrcOverrideTy: *mut Type) -> bool {
