        },
    }
    return SVEIntrinsicInfo {};
}

fn isAllActivePredicate(Pred: *mut Value) -> bool {
    let mut UncastedPred: *mut Value = null;
    if match(Pred, m_Intrinsic(m_Value(UncastedPred))) {
        let mut OrigPredTy: *mut ScalableVectorType = cast(Pred.getType());
        Pred = UncastedPred;
        if match(Pred, m_Intrinsic(m_Value(UncastedPred))) {
            if OrigPredTy.getMinNumElements() <= cast(UncastedPred.getType()).getMinNumElements() {
                Pred = UncastedPred;
            }
        }
    }
    let mut C: *mut Constant = dyn_cast(Pred);
    return C && C.isAllOnesValue();
}

fn stripInactiveLanes(V: *mut Value, Pg: *Value) -> *mut Value {
    let mut Dup: *mut IntrinsicInst = dyn_cast(V);
    if Dup && Dup.getIntrinsicID() == aarch64_sve_dup && Dup.getOperand(1) == Pg && isa(Dup.getOperand(2)) {
        return getSplat(cast(V.getType()).getElementCount(), cast(Dup.getOperand(2)));
    }
    return V;
}

fn simplifySVEIntrinsicBinOp(IC: *mut InstCombiner, II: *mut IntrinsicInst, IInfo: *SVEIntrinsicInfo) -> optional<Instruction *> {
    let mut Opc: u32 = IInfo.getMatchingIROpode();
    assert!(isBinaryOp(Opc), "Expected a binary operation!");
    let mut Pg: *mut Value = II.getOperand(0);
    let mut Op1: *mut Value = II.getOperand(1);
    let mut Op2: *mut Value = II.getOperand(2);
    let mut DL: *DataLayout = II.getDataLayout();
    if isCommutative(Opc) && IInfo.inactiveLanesAreNotDefined() && isa(Op1) && !isa(Op2) {
        IC.replaceOperand(II, 1, Op2);
        IC.replaceOperand(II, 2, Op1);
        return &mut II;
    }
    Op1 = stripInactiveLanes(Op1, Pg);
    Op2 = stripInactiveLanes(Op2, Pg);
    let mut SimpleII: *mut Value = null;
    if dyn_cast(&mut II) {
        FII;
    } else {
        SimpleII = simplifyBinOp(Opc, Op1, Op2, FII.getFastMathFlags(), SimplifyQuery { DL, null });
    }
    let mut NarrowOp1: *mut Value = null;
    let mut NarrowOp2: *mut Value = null;
    if !SimpleII && match(Op1, m_Intrinsic(m_Value(NarrowOp1))) && match(Op2, m_Intrinsic(m_Value(NarrowOp2))) && NarrowOp1.getType() == NarrowOp2.getType() {
        let mut SimpleNarrow: *mut Value = simplifyBinOp(Opc, NarrowOp1, NarrowOp2, SimplifyQuery { DL, null });
        if SimpleNarrow && !isa(SimpleNarrow) {
            if match(SimpleNarrow, m_ZeroInt()) {
                SimpleII = getNullValue(II.getType());
            } else if SimpleNarrow == NarrowOp1 {
                SimpleII = Op1;
            } else if SimpleNarrow == NarrowOp2 {
                SimpleII = Op2;
            } else {
                SimpleII = IC.Builder.CreateIntrinsic(aarch64_sve_convert_to_svbool, SimpleNarrow.getType(), SimpleNarrow, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_3 {}, null, null });
            }
        }
    }
    if !SimpleII || isa(SimpleII) {
        return nullopt;
    }
    if IInfo.inactiveLanesAreNotDefined() {
        return IC.replaceInstUsesWith(II, SimpleII);
    }
    let mut Inactive: *mut Value = if IInfo.resultIsZeroInitialized() { getNullValue(II.getType()) } else { II.getOperand(IInfo.getOperandIdxInactiveLanesTakenFrom()) };
    if SimpleII == Inactive {
        return IC.replaceInstUsesWith(II, SimpleII);
    }
    SimpleII = IC.Builder.CreateSelect(Pg, SimpleII, Inactive, "", null);
    return IC.replaceInstUsesWith(II, SimpleII);
}

fn simplifySVEIntrinsicCompare(IC: *mut InstCombiner, II: *mut IntrinsicInst, IInfo: *SVEIntrinsicInfo) -> optional<Instruction *> {
    let mut Opc: u32 = IInfo.getMatchingIROpode();
    assert!((Opc == ICmp || Opc == FCmp), "Expected a compare operation!");
    let mut Pg: *mut Value = II.getOperand(0);
    let mut LHS: *mut Value = II.getOperand(1);
    let mut RHS: *mut Value = II.getOperand(2);
    let mut CmpPred: Predicate = IInfo.getCmpPredicate();
    let mut IsWideICmp: bool = Opc == ICmp && LHS.getType() != RHS.getType();
    assert!((IsWideICmp || LHS.getType() == RHS.getType()), "Unexpected wide compare!");
    if (isCommutative(CmpPred) || isCommutative(CmpPred)) && isa(LHS) && !isa(RHS) && !IsWideICmp {
        IC.replaceOperand(II, 1, RHS);
        IC.replaceOperand(II, 2, LHS);
        return &mut II;
    }
    LHS = stripInactiveLanes(LHS, Pg);
    RHS = stripInactiveLanes(RHS, Pg);
    if IsWideICmp {
        let mut LHSVal: *APInt = null;
        let mut RHSVal: *APInt = null;
        if !match(LHS, m_APInt(LHSVal)) || !match(RHS, m_APInt(RHSVal)) {
            return nullopt;
        }
        let mut WideVT: *mut Type = get(RHS.getType().getScalarType(), cast(LHS.getType()));
        if isUnsigned(CmpPred) {
            LHS = get(WideVT, LHSVal.getZExtValue(), false, false);
            RHS = get(WideVT, RHSVal.getZExtValue(), false, false);
        } else {
            LHS = get(WideVT, LHSVal.getSExtValue(), false, false);
            RHS = get(WideVT, RHSVal.getSExtValue(), false, false);
        }
    }
    let mut DL: *DataLayout = II.getDataLayout();
    let mut SimpleII: *mut Value = simplifyCmpInst(CmpPredicate { Pred: CmpPred, HasSameSign: false }, LHS, RHS, SimplifyQuery { DL, null });
    if !SimpleII {
        return nullopt;
    }
    assert!(IInfo.resultIsZeroInitialized(), "Expected a zeroing operation!");
    if match(SimpleII, m_ZeroInt()) {
        return IC.replaceInstUsesWith(II, SimpleII);
    }
    SimpleII = IC.Builder.CreateLogicalAnd(Pg, SimpleII, "", null);
    return IC.replaceInstUsesWith(II, SimpleII);
}

fn simplifySVEIntrinsic(IC: *mut InstCombiner, II: *mut IntrinsicInst, IInfo: *SVEIntrinsicInfo) -> optional<Instruction *> {
    if !IInfo.hasGoverningPredicate() {
        return nullopt;
    }
    let mut OpPredicate: *mut Value = II.getOperand(IInfo.getGoverningPredicateOperandIdx());
    if match(OpPredicate, m_ZeroInt()) {
        if IInfo.inactiveLanesTakenFromOperand() {
            return IC.replaceInstUsesWith(II, II.getOperand(IInfo.getOperandIdxInactiveLanesTakenFrom()));
        }
        if IInfo.inactiveLanesAreUnused() {
            if IInfo.resultIsZeroInitialized() {
                IC.replaceInstUsesWith(II, getNullValue(II.getType()));
            }
            return IC.eraseInstFromFunction(II);
        }
    }
    if isAllActivePredicate(OpPredicate) {
        if IInfo.hasOperandWithNoActiveLanes() {
            let mut OpIdx: u32 = IInfo.getOperandIdxWithNoActiveLanes();
            if !isa(II.getOperand(OpIdx)) {
                return IC.replaceOperand(II, OpIdx, get(II.getType()));
            }
        }
        if IInfo.hasMatchingUndefIntrinsic() {
            let mut NewDecl: *mut Function = getOrInsertDeclaration(II.getModule(), IInfo.getMatchingUndefIntrinsic(), [II.getType()]);
            II.setCalledFunction(NewDecl);
            return &mut II;
        }
    }
    if !IInfo.hasMatchingIROpode() {
        return nullopt;
    }
    let mut Opc: u32 = IInfo.getMatchingIROpode();
    if isBinaryOp(Opc) {
        return simplifySVEIntrinsicBinOp(IC, II, IInfo);
    }
    if Opc == FCmp || Opc == ICmp {
        return simplifySVEIntrinsicCompare(IC, II, IInfo);
    }
    return nullopt;
}

fn tryCombineFromSVBoolBinOp(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut m_ConvertToSVBool: Closure_4 = Closure_4 {};
    let mut ConvertFromSVBool: ID = aarch64_sve_convert_from_svbool;
    let mut Ty: *mut Type = II.getType();
    let mut LHS: *mut Value = null;
    let mut RHS: *mut Value = null;
    let mut NarrowLHS: *mut Value = null;
    let mut NarrowRHS: *mut Value = null;
    if match(II.getOperand(0), m_LogicalAnd(m_Value(LHS), m_ConvertToSVBool.call(m_SpecificType(Ty, NarrowRHS)))) {
        NarrowLHS = IC.Builder.CreateIntrinsic(ConvertFromSVBool, Ty, LHS, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_5 {}, null, null });
        let mut NarrowAnd: *mut Value = IC.Builder.CreateLogicalAnd(NarrowLHS, NarrowRHS, "", null);
        return IC.replaceInstUsesWith(II, NarrowAnd);
    }
    if match(II.getOperand(0), m_LogicalAnd(m_ConvertToSVBool.call(m_SpecificType(Ty, NarrowLHS)), m_Value(RHS))) {
        NarrowRHS = IC.Builder.CreateIntrinsic(ConvertFromSVBool, Ty, RHS, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_6 {}, null, null });
        let mut NarrowAnd: *mut Value = IC.Builder.CreateLogicalAnd(NarrowLHS, NarrowRHS, "", null);
        return IC.replaceInstUsesWith(II, NarrowAnd);
    }
    let mut BinOp: CastReturnType = dyn_cast(II.getOperand(0));
    if !BinOp {
        return nullopt;
    }
    let mut BinOpIID: ID = BinOp.getIntrinsicID();
    match BinOpIID {
        aarch64_sve_and_z => {
            aarch64_sve_bic_z;
        },
        _ => {
            return nullopt;
        },
    }
    let mut BinOpPred: *mut Value = BinOp.getOperand(0);
    let mut BinOpOp1: *mut Value = BinOp.getOperand(1);
    let mut BinOpOp2: *mut Value = BinOp.getOperand(2);
    let mut NarrowBinOpPred: *mut Value = null;
    if !match(BinOpPred, m_ConvertToSVBool.call(m_SpecificType(Ty, NarrowBinOpPred))) {
        return nullopt;
    }
    let mut NarrowBinOpOp1: *mut Value = IC.Builder.CreateIntrinsic(ConvertFromSVBool, Ty, BinOpOp1, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_7 {}, null, null });
    let mut NarrowBinOpOp2: *mut Value = NarrowBinOpOp1;
    if BinOpOp1 != BinOpOp2 {
        NarrowBinOpOp2 = IC.Builder.CreateIntrinsic(ConvertFromSVBool, Ty, BinOpOp2, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_8 {}, null, null });
    }
    let mut NarrowedBinOp: *mut Value = IC.Builder.CreateIntrinsic(BinOpIID, Ty, [NarrowBinOpPred, NarrowBinOpOp1, NarrowBinOpOp2], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_9 {}, null, null });
    return IC.replaceInstUsesWith(II, NarrowedBinOp);
}

fn instCombineConvertFromSVBool(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if isa(II.getArgOperand(0)) {
        return processPhiNode(IC, II);
    }
    if tryCombineFromSVBoolBinOp(IC, II) {
        BinOpCombine;
    } else {
        return BinOpCombine;
    }
    if isa(II.getArgOperand(0).getType()) || isa(II.getType()) {
        return nullopt;
    }
    let mut CandidatesForRemoval: SmallVector<Instruction *, 32> = SmallVector<Instruction *, 32> {};
    let mut Cursor: *mut Value = II.getOperand(0);
    let mut EarliestReplacement: *mut Value = null;
    let mut IVTy: *VectorType const = cast(II.getType());
    while Cursor {
        let mut CursorVTy: *VectorType const = cast(Cursor.getType());
        if CursorVTy.getElementCount().getKnownMinValue() < IVTy.getElementCount().getKnownMinValue() {
            break;
        }
        if Cursor.getType() == IVTy {
            EarliestReplacement = Cursor;
        }
        let mut IntrinsicCursor: *mut IntrinsicInst = dyn_cast(Cursor);
        if !IntrinsicCursor || !(IntrinsicCursor.getIntrinsicID() == aarch64_sve_convert_to_svbool || IntrinsicCursor.getIntrinsicID() == aarch64_sve_convert_from_svbool) {
            break;
        }
        CandidatesForRemoval.insert(CandidatesForRemoval.begin(), IntrinsicCursor);
        Cursor = IntrinsicCursor.getOperand(0);
    }
    if !EarliestReplacement {
        return nullopt;
    }
    return IC.replaceInstUsesWith(II, EarliestReplacement);
}

fn instCombineSVESel(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut OpPredicate: *mut Value = II.getOperand(0);
    if isAllActivePredicate(OpPredicate) {
        return IC.replaceInstUsesWith(II, II.getOperand(1));
    }
    let mut Select: *mut Value = IC.Builder.CreateSelect(OpPredicate, II.getOperand(1), II.getOperand(2), "", null);
    return IC.replaceInstUsesWith(II, Select);
}

fn instCombineSVEDup(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Pg: *mut Value = II.getOperand(1);
    if isAllActivePredicate(Pg) {
        let mut RetTy: *mut ScalableVectorType = cast(II.getType());
        let mut Splat: *mut Value = IC.Builder.CreateVectorSplat(RetTy.getElementCount(), II.getArgOperand(2), "");
        return IC.replaceInstUsesWith(II, Splat);
    }
    if !match(Pg, m_Intrinsic(m_SpecificInt(vl1))) {
        return nullopt;
    }
    let mut Insert: *mut Value = IC.Builder.CreateInsertElement(II.getArgOperand(0), II.getArgOperand(2), 0, "");
    return IC.replaceInstUsesWith(II, Insert);
}

fn instCombineSVEDupX(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut RetTy: *mut ScalableVectorType = cast(II.getType());
    let mut Splat: *mut Value = IC.Builder.CreateVectorSplat(RetTy.getElementCount(), II.getArgOperand(0), "");
    Splat.takeName(&mut II);
    return IC.replaceInstUsesWith(II, Splat);
}

fn instCombineXorSVECmpCC(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if !II.hasOneUse() {
        return nullopt;
    }
    let mut User: *mut Instruction = cast(operator(II.user_begin()));
    if !match(User, m_c_Xor(m_Specific(&mut II), m_Specific(II.getOperand(0)))) {
        return nullopt;
    }
    let mut IID: ID = zeroed();
    match II.getIntrinsicID() {
        aarch64_sve_cmpne => {
            IID = aarch64_sve_cmpeq;
        },
        aarch64_sve_cmpne_wide => {
            IID = aarch64_sve_cmpeq_wide;
        },
        aarch64_sve_cmpeq => {
            IID = aarch64_sve_cmpne;
        },
        aarch64_sve_cmpeq_wide => {
            IID = aarch64_sve_cmpne_wide;
        },
        _ => {
            return nullopt;
        },
    }
    IC.Builder.SetInsertPoint(User);
    let mut CMPCC: *mut Value = IC.Builder.CreateIntrinsic(IID, II.getOperand(1).getType(), [II.getOperand(0), II.getOperand(1), II.getOperand(2)], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_10 {}, null, null });
    IC.replaceInstUsesWith(*User, CMPCC);
    IC.eraseInstFromFunction(*User);
    return &mut II;
}

fn instCombineZExtSVECmpNE(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if !isAllActivePredicate(II.getOperand(0)) || !match(II.getOperand(2), m_Zero()) {
        return nullopt;
    }
    for U in II.users() {
        if match(U, m_ZExt(m_Specific(&mut II))) {
            let mut User: *mut Instruction = cast(U);
            let mut Ty: *mut Type = II.getOperand(1).getType();
            if User.getType() != Ty {
                continue;
            }
            IC.Builder.SetInsertPoint(User);
            let mut UMin: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_umin, Ty, [II.getOperand(0), II.getOperand(1), get(Ty, 1, false, false)], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_11 {}, null, null });
            IC.replaceInstUsesWith(*User, UMin);
            IC.eraseInstFromFunction(*User);
            return &mut II;
        }
    }
    return nullopt;
}

fn instCombineSVECmpNE(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Ctx: *mut LLVMContext = II.getContext();
    if instCombineXorSVECmpCC(IC, II) {
        Res;
    } else {
        return Res;
    }
    if instCombineZExtSVECmpNE(IC, II) {
        Res;
    } else {
        return Res;
    }
    if !isAllActivePredicate(II.getArgOperand(0)) {
        return nullopt;
    }
    let mut SplatValue: *mut ConstantInt = dyn_cast_or_null(getSplatValue(II.getArgOperand(2)));
    if !SplatValue || !SplatValue.isZero() {
        return nullopt;
    }
    let mut DupQLane: *mut IntrinsicInst = dyn_cast(II.getArgOperand(1));
    if !DupQLane || DupQLane.getIntrinsicID() != aarch64_sve_dupq_lane {
        return nullopt;
    }
    let mut DupQLaneIdx: *mut ConstantInt = dyn_cast(DupQLane.getArgOperand(1));
    if !DupQLaneIdx || !DupQLaneIdx.isZero() {
        return nullopt;
    }
    let mut VecIns: *mut IntrinsicInst = dyn_cast(DupQLane.getArgOperand(0));
    if !VecIns || VecIns.getIntrinsicID() != vector_insert {
        return nullopt;
    }
    if !isa(VecIns.getArgOperand(0)) {
        return nullopt;
    }
    if !cast(VecIns.getArgOperand(2)).isZero() {
        return nullopt;
    }
    let mut ConstVec: *mut Constant = dyn_cast(VecIns.getArgOperand(1));
    if !ConstVec {
        return nullopt;
    }
    let mut VecTy: *mut FixedVectorType = dyn_cast(ConstVec.getType());
    let mut OutTy: *mut ScalableVectorType = dyn_cast(II.getType());
    if !VecTy || !OutTy || VecTy.getNumElements() != OutTy.getMinNumElements() {
        return nullopt;
    }
    let mut NumElts: u32 = VecTy.getNumElements();
    let mut PredicateBits: u32 = 0;
    for let mut I: u32 = 0; I < NumElts; I += 1 {
        let mut Arg: *mut ConstantInt = dyn_cast(ConstVec.getAggregateElement(I));
        if !Arg {
            return nullopt;
        }
        if !Arg.isZero() {
            PredicateBits |= 1 << (I * (16 / NumElts));
        }
    }
    if PredicateBits == 0 {
        let mut PFalse: *mut Constant = getNullValue(II.getType());
        PFalse.takeName(&mut II);
        return IC.replaceInstUsesWith(II, PFalse);
    }
    let mut Mask: u32 = 8;
    for let mut I: u32 = 0; I < 16; I += 1 {
        if (PredicateBits & (1 << I)) != 0 {
            Mask |= (I % 8);
        }
    }
    let mut PredSize: u32 = Mask & -Mask;
    let mut PredType: *mut ScalableVectorType = get(getInt1Ty(Ctx), SVEBitsPerBlock / (PredSize * 8));
    for let mut I: u32 = 0; I < 16; I += PredSize {
        if (PredicateBits & (1 << I)) == 0 {
            return nullopt;
        }
    }
    let mut ConvertToSVBool: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_convert_to_svbool, PredType, getTrue(PredType), FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_12 {}, null, null });
    let mut ConvertFromSVBool: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_convert_from_svbool, II.getType(), ConvertToSVBool, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_13 {}, null, null });
    ConvertFromSVBool.takeName(&mut II);
    return IC.replaceInstUsesWith(II, ConvertFromSVBool);
}

fn instCombineSVELast(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Pg: *mut Value = II.getArgOperand(0);
    let mut Vec: *mut Value = II.getArgOperand(1);
    let mut IntrinsicID: ID = II.getIntrinsicID();
    let mut IsAfter: bool = IntrinsicID == aarch64_sve_lasta;
    if getSplatValue(Vec) {
        SplatVal;
    } else {
        return IC.replaceInstUsesWith(II, SplatVal);
    }
    let mut LHS: *mut Value = null;
    let mut RHS: *mut Value = null;
    if match(Vec, m_OneUse(m_BinOp(m_Value(LHS), m_Value(RHS)))) {
        if isSplatValue(LHS, -1, 0) || isSplatValue(RHS, -1, 0) {
            let mut OldBinOp: *mut BinaryOperator = cast(Vec);
            let mut OpC: BinaryOps = OldBinOp.getOpcode();
            let mut NewLHS: *mut Value = IC.Builder.CreateIntrinsic(IntrinsicID, [Vec.getType()], [Pg, LHS], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_14 {}, null, null });
            let mut NewRHS: *mut Value = IC.Builder.CreateIntrinsic(IntrinsicID, [Vec.getType()], [Pg, RHS], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_15 {}, null, null });
            let mut NewBinOp: *mut BinaryOperator = CreateWithCopiedFlags(OpC, NewLHS, NewRHS, OldBinOp, OldBinOp.getName(), II.getIterator());
            return IC.replaceInstUsesWith(II, NewBinOp);
        }
    }
    let mut C: *mut Constant = dyn_cast(Pg);
    if IsAfter && C && C.isNullValue() {
        let mut IdxTy: *mut IntegerType = getInt64Ty(II.getContext());
        let mut Extract: *mut ExtractElementInst = Create(Vec, get(IdxTy, 0, false, false), "", null);
        Extract.insertBefore(II.getIterator());
        Extract.takeName(&mut II);
        return IC.replaceInstUsesWith(II, Extract);
    }
    let mut IntrPG: *mut IntrinsicInst = dyn_cast(Pg);
    if !IntrPG {
        return nullopt;
    }
    if IntrPG.getIntrinsicID() != aarch64_sve_ptrue {
        return nullopt;
    }
    let mut PTruePattern: u64 = cast(IntrPG.getOperand(0)).getZExtValue();
    let mut MinNumElts: u32 = getNumElementsFromSVEPredPattern(PTruePattern);
    if !MinNumElts {
        return nullopt;
    }
    let mut Idx: u32 = MinNumElts - 1;
    if IsAfter {
        Idx += 1;
    }
    let mut PgVTy: *mut ScalableVectorType = cast(Pg.getType());
    if Idx >= PgVTy.getMinNumElements() {
        return nullopt;
    }
    let mut IdxTy: *mut IntegerType = getInt64Ty(II.getContext());
    let mut Extract: *mut ExtractElementInst = Create(Vec, get(IdxTy, Idx, false, false), "", null);
    Extract.insertBefore(II.getIterator());
    Extract.takeName(&mut II);
    return IC.replaceInstUsesWith(II, Extract);
}

fn instCombineSVECondLast(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut Pg: *mut Value = II.getArgOperand(0);
    let mut Fallback: *mut Value = II.getArgOperand(1);
    let mut Vec: *mut Value = II.getArgOperand(2);
    let mut Ty: *mut Type = II.getType();
    if !Ty.isIntegerTy() {
        return nullopt;
    }
    let mut FPTy: *mut Type = null;
    match cast(Ty).getBitWidth() {
        _ => {
            return nullopt;
        },
        16 => {
            FPTy = IC.Builder.getHalfTy();
        },
        32 => {
            FPTy = IC.Builder.getFloatTy();
        },
        64 => {
            FPTy = IC.Builder.getDoubleTy();
        },
    }
    let mut FPFallBack: *mut Value = IC.Builder.CreateBitCast(Fallback, FPTy, "");
    let mut FPVTy: *mut VectorType = get(FPTy, cast(Vec.getType()).getElementCount());
    let mut FPVec: *mut Value = IC.Builder.CreateBitCast(Vec, FPVTy, "");
    let mut FPII: *mut Value = IC.Builder.CreateIntrinsic(II.getIntrinsicID(), [FPVec.getType()], [Pg, FPFallBack, FPVec], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_16 {}, null, null });
    let mut FPIItoInt: *mut Value = IC.Builder.CreateBitCast(FPII, II.getType(), "");
    return IC.replaceInstUsesWith(II, FPIItoInt);
}

fn instCombineRDFFR(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut RDFFR: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_rdffr_z, getTrue(II.getType()), FMFSource {}, "", function_ref<void (CallInst *)> { Closure_17 {}, null, null });
    RDFFR.takeName(&mut II);
    return IC.replaceInstUsesWith(II, RDFFR);
}

fn instCombineSVECntElts(IC: *mut InstCombiner, II: *mut IntrinsicInst, NumElts: u32) -> optional<Instruction *> {
    let mut Pattern: u64 = cast(II.getArgOperand(0)).getZExtValue();
    if Pattern == all {
        let mut Cnt: *mut Value = IC.Builder.CreateElementCount(II.getType(), getScalable(NumElts));
        Cnt.takeName(&mut II);
        return IC.replaceInstUsesWith(II, Cnt);
    }
    let mut MinNumElts: u32 = getNumElementsFromSVEPredPattern(Pattern);
    return if MinNumElts && NumElts >= MinNumElts { IC.replaceInstUsesWith(II, get(II.getType(), MinNumElts, false, false)) } else { nullopt };
}

fn instCombineSMECntsd(IC: *mut InstCombiner, II: *mut IntrinsicInst, ST: *AArch64Subtarget) -> optional<Instruction *> {
    if !ST.isStreaming() {
        return nullopt;
    }
    let mut Cnt: *mut Value = IC.Builder.CreateElementCount(II.getType(), getScalable(2));
    Cnt.takeName(&mut II);
    return IC.replaceInstUsesWith(II, Cnt);
}

fn instCombineSVEPTest(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut PgVal: *mut Value = II.getArgOperand(0);
    let mut OpVal: *mut Value = II.getArgOperand(1);
    if PgVal == OpVal && (II.getIntrinsicID() == aarch64_sve_ptest_first || II.getIntrinsicID() == aarch64_sve_ptest_last) {
        let mut Ops: [2]*mut Value = [PgVal, OpVal];
        let mut Tys: [1]*mut Type = [PgVal.getType()];
        let mut PTest: *mut Value = IC.Builder.CreateIntrinsic(aarch64_sve_ptest_any, Tys, Ops, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_18 {}, null, null });
        PTest.takeName(&mut II);
        return IC.replaceInstUsesWith(II, PTest);
    }
    let mut Pg: *mut IntrinsicInst = dyn_cast(PgVal);
    let mut Op: *mut IntrinsicInst = dyn_cast(OpVal);
    if !Pg || !Op {
        return nullopt;
    }
    let mut OpIID: ID = Op.getIntrinsicID();
    if Pg.getIntrinsicID() == aarch64_sve_convert_to_svbool && OpIID == aarch64_sve_convert_to_svbool && Pg.getArgOperand(0).getType() == Op.getArgOperand(0).getType() {
        let mut Ops: [2]*mut Value = [Pg.getArgOperand(0), Op.getArgOperand(0)];
        let mut Tys: [1]*mut Type = [Pg.getArgOperand(0).getType()];
        let mut PTest: *mut Value = IC.Builder.CreateIntrinsic(II.getIntrinsicID(), Tys, Ops, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_19 {}, null, null });
        PTest.takeName(&mut II);
        return IC.replaceInstUsesWith(II, PTest);
    }
    if (Pg == Op) && (II.getIntrinsicID() == aarch64_sve_ptest_any) && ((OpIID == aarch64_sve_brka_z) || (OpIID == aarch64_sve_brkb_z) || (OpIID == aarch64_sve_brkpa_z) || (OpIID == aarch64_sve_brkpb_z) || (OpIID == aarch64_sve_rdffr_z) || (OpIID == aarch64_sve_and_z) || (OpIID == aarch64_sve_bic_z) || (OpIID == aarch64_sve_eor_z) || (OpIID == aarch64_sve_nand_z) || (OpIID == aarch64_sve_nor_z) || (OpIID == aarch64_sve_orn_z) || (OpIID == aarch64_sve_orr_z)) {
        let mut Ops: [2]*mut Value = [Pg.getArgOperand(0), Pg];
        let mut Tys: [1]*mut Type = [Pg.getType()];
        let mut PTest: *mut Value = IC.Builder.CreateIntrinsic(II.getIntrinsicID(), Tys, Ops, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_20 {}, null, null });
        PTest.takeName(&mut II);
        return IC.replaceInstUsesWith(II, PTest);
    }
    return nullopt;
}

