fn instCombineSVEPTest(IC: *mut InstCombiner, II: *mut IntrinsicInst) -> optional<Instruction *> {
    let mut PgVal: *mut Value = II.getArgOperand;
    let mut OpVal: *mut Value = II.getArgOperand;
    if  {
        let mut Ops: [2]*mut Value = [PgVal, OpVal];
        let mut Tys: [1]*mut Type = [PgVal.getType()];
        let mut PTest: *mut auto = IC();
        PTest()(&mut II);
        return IC.replaceInstUsesWith(II);
    }
    let mut Pg: *mut IntrinsicInst = dyn_cast(PgVal);
    let mut Op: *mut IntrinsicInst = dyn_cast(OpVal);
    if !Pg || !Op {
        return nullopt();
    }
    let mut OpIID: ID = Op.getIntrinsicID();
    if  {
        let mut Ops: []*mut Value = void { Pg.getArgOperand, Op.getArgOperand };
        let mut Tys: []*mut Type = void { Pg.getArgOperand() };
        let mut PTest: *mut auto = IC()(II.getIntrinsicID(), Tys, Ops);
        PTest()(&mut II);
        return IC.replaceInstUsesWith(II);
    }
    if  {
        let mut Ops: []*mut Value = void { Pg.getArgOperand, Pg };
        let mut Tys: []*mut Type = void { Pg.getType };
        let mut PTest: *mut auto = IC()(II.getIntrinsicID(), Tys, Ops);
        PTest()(&mut II);
        return IC.replaceInstUsesWith(II);
    }
    return nullopt();
}

