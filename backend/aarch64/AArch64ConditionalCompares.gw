static mut BlockInstrLimit: opt<unsigned int> = opt<unsigned int> { "aarch64-ccmp-limit", init(30), Hidden, "Maximum number of instructions per speculated block." };

static mut Stress: opt<bool> = opt<bool> { "aarch64-stress-ccmp", Hidden, "Turn all knobs to 11" };

static mut NumConsidered: Statistic = Statistic { "aarch64-ccmp", "NumConsidered", "Number of ccmps considered" };

static mut NumPhiRejs: Statistic = Statistic { "aarch64-ccmp", "NumPhiRejs", "Number of ccmps rejected (PHI)" };

static mut NumPhysRejs: Statistic = Statistic { "aarch64-ccmp", "NumPhysRejs", "Number of ccmps rejected (Physregs)" };

static mut NumPhi2Rejs: Statistic = Statistic { "aarch64-ccmp", "NumPhi2Rejs", "Number of ccmps rejected (PHI2)" };

static mut NumHeadBranchRejs: Statistic = Statistic { "aarch64-ccmp", "NumHeadBranchRejs", "Number of ccmps rejected (Head branch)" };

static mut NumCmpBranchRejs: Statistic = Statistic { "aarch64-ccmp", "NumCmpBranchRejs", "Number of ccmps rejected (CmpBB branch)" };

static mut NumCmpTermRejs: Statistic = Statistic { "aarch64-ccmp", "NumCmpTermRejs", "Number of ccmps rejected (CmpBB is cbz...)" };

static mut NumImmRangeRejs: Statistic = Statistic { "aarch64-ccmp", "NumImmRangeRejs", "Number of ccmps rejected (Imm out of range)" };

static mut NumFoldedExtRejs: Statistic = Statistic { "aarch64-ccmp", "NumFoldedExtRejs", "Number of ccmps rejected (Folded zero- or sign-extension)" };

static mut NumLiveDstRejs: Statistic = Statistic { "aarch64-ccmp", "NumLiveDstRejs", "Number of ccmps rejected (Cmp dest live)" };

static mut NumMultNZCVUses: Statistic = Statistic { "aarch64-ccmp", "NumMultNZCVUses", "Number of ccmps rejected (NZCV used)" };

static mut NumUnknNZCVDefs: Statistic = Statistic { "aarch64-ccmp", "NumUnknNZCVDefs", "Number of ccmps rejected (NZCV def unknown)" };

static mut NumSpeculateRejs: Statistic = Statistic { "aarch64-ccmp", "NumSpeculateRejs", "Number of ccmps rejected (Can't speculate)" };

static mut NumConverted: Statistic = Statistic { "aarch64-ccmp", "NumConverted", "Number of ccmp instructions created" };

static mut NumCompBranches: Statistic = Statistic { "aarch64-ccmp", "NumCompBranches", "Number of cb/cbz/cbnz branches converted" };

struct SSACCmpConv {
    MF: *mut MachineFunction,
    TII: *AArch64InstrInfo,
    TRI: *TargetRegisterInfo,
    MRI: *mut MachineRegisterInfo,
    MBPI: *MachineBranchProbabilityInfo,
    Head: *mut MachineBasicBlock,
    CmpBB: *mut MachineBasicBlock,
    Tail: *mut MachineBasicBlock,
    CmpMI: *mut MachineInstr,
    HeadCond: SmallVector<MachineOperand, 4>,
    HeadCmpBBCC: CondCode,
    CmpBBCond: SmallVector<MachineOperand, 4>,
    CmpBBTailCC: CondCode,
}

fn SSACCmpConv::runOnMachineFunction(self, MF: *mut MachineFunction, MBPI: *MachineBranchProbabilityInfo) {
    self.MF = &mut MF;
    self.MBPI = MBPI;
    self.TII = MF.getSubtarget().getInstrInfo() as *AArch64InstrInfo;
    self.TRI = MF.getSubtarget().getRegisterInfo();
    self.MRI = &mut MF.getRegInfo();
}

fn lookThroughCopies(Reg: Register, MRI: *mut MachineRegisterInfo) -> Register {
    let mut MI: *mut MachineInstr = null;
    while (MI = MRI.getUniqueVRegDef(Reg)) && MI.getOpcode() == COPY {
        if MI.getOperand(1).getReg().isPhysical() {
            break;
        }
        Reg = MI.getOperand(1).getReg();
    }
    return Reg;
}

fn SSACCmpConv::trivialTailPHIs(self) -> bool {
    for I in *self.Tail {
        if !I.isPHI() {
            break;
        }
        let mut HeadReg: u32 = 0;
        let mut CmpBBReg: u32 = 0;
        for let mut oi: u32 = 1;
let mut oe: u32 = I.getNumOperands(); oi != oe; oi += 2 {
            let mut MBB: *mut MachineBasicBlock = I.getOperand(oi + 1).getMBB();
            let mut Reg: Register = lookThroughCopies(I.getOperand(oi).getReg(), self.MRI);
            if MBB == self.Head {
                assert!((!HeadReg || HeadReg == Reg.operator unsigned int()), "Inconsistent PHI operands");
                HeadReg = Reg.operator unsigned int();
            }
            if MBB == self.CmpBB {
                assert!((!CmpBBReg || CmpBBReg == Reg.operator unsigned int()), "Inconsistent PHI operands");
                CmpBBReg = Reg.operator unsigned int();
            }
        }
        if HeadReg != CmpBBReg {
            return false;
        }
    }
    return true;
}

fn SSACCmpConv::updateTailPHIs(self) {
    for I in *self.Tail {
        if !I.isPHI() {
            break;
        }
        for let mut oi: u32 = I.getNumOperands(); oi > 2; oi -= 2 {
            if I.getOperand(oi - 1).getMBB() == self.CmpBB {
                I.removeOperand(oi - 1);
                I.removeOperand(oi - 2);
            }
        }
    }
}

fn SSACCmpConv::isDeadDef(self, DstReg: u32) -> bool {
    if DstReg == WZR || DstReg == XZR {
        return true;
    }
    if !isVirtualRegister(DstReg) {
        return false;
    }
    return self.MRI.use_nodbg_empty(DstReg);
}

fn parseCond(Cond: ArrayRef<MachineOperand>, CC: *mut CondCode) -> bool {
    if Cond[0].getImm() != -1 {
        assert!(Cond.len == 1, "Unknown Cond array format");
        CC = Cond[0].getImm() as i32 as CondCode;
        return true;
    }
    match Cond[1].getImm() {
        _ => {
            return false;
        },
        CBZW => {
            CBZX;
        },
        CBNZW => {
            CBNZX;
        },
        CBWPri => {
            CBXPri;
        },
        CBBAssertExt => {
            CBHAssertExt;
        },
    }
}

fn SSACCmpConv::findConvertibleCompare(self, MBB: *mut MachineBasicBlock) -> *mut MachineInstr {
    let mut I: iterator = MBB.getFirstTerminator();
    if I == MBB.end() {
        return null;
    }
    if !operator(I).readsRegister(NZCV, null) {
        match operator(I).getOpcode() {
            CBZW => {
                CBZX;
            },
            CBWPri => {
                CBXPri;
            },
            CBBAssertExt => {
                CBHAssertExt;
            },
        }
        operator(NumCmpTermRejs);
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Flags not used by terminator: " << operator(I);
            }
        }
            if !(false) { break; }
        }
        return null;
    }
    for let mut B: iterator = MBB.begin(); I != B;  {
        I = prev_nodbg(I, MBB.begin(), true);
        assert!(!operator(I).isTerminator(AnyInBundle), "Spurious terminator");
        match operator(I).getOpcode() {
            SUBSWri => {
                SUBSXri;
            },
            SUBSWrr => {
                SUBSXrr;
            },
            FCMPSrr => {
                FCMPDrr;
            },
        }
        let mut PRI: PhysRegInfo = AnalyzePhysRegInBundle(operator(I), NZCV, self.TRI);
        if PRI.Read {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                    dbgs() << "Can't create ccmp with multiple uses: " << operator(I);
                }
            }
                if !(false) { break; }
            }
            operator(NumMultNZCVUses);
            return null;
        }
        if PRI.Defined || PRI.Clobbered {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                    dbgs() << "Not convertible compare: " << operator(I);
                }
            }
                if !(false) { break; }
            }
            operator(NumUnknNZCVDefs);
            return null;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
            dbgs() << "Flags not defined in " << printMBBReference(*MBB) << 10;
        }
    }
        if !(false) { break; }
    }
    return null;
}

fn SSACCmpConv::canSpeculateInstrs(self, MBB: *mut MachineBasicBlock, CmpMI: *MachineInstr) -> bool {
    if !MBB.livein_empty() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << printMBBReference(*MBB) << " has live-ins.\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut InstrCount: u32 = 0;
    for I in make_range(MBB.begin(), MBB.getFirstTerminator()) {
        if I.isDebugInstr() {
            continue;
        }
        if InstrCount += 1 > BlockInstrLimit.operator unsigned int() && !Stress {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                    dbgs() << printMBBReference(*MBB) << " has more than " << BlockInstrLimit.operator unsigned int() << " instructions.\n";
                }
            }
                if !(false) { break; }
            }
            return false;
        }
        if I.isPHI() {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                    dbgs() << "Can't hoist: " << I;
                }
            }
                if !(false) { break; }
            }
            return false;
        }
        if I.mayLoad(AnyInBundle) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                    dbgs() << "Won't speculate load: " << I;
                }
            }
                if !(false) { break; }
            }
            return false;
        }
        let mut DontMoveAcrossStore: bool = true;
        if !I.isSafeToMove(DontMoveAcrossStore) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                    dbgs() << "Can't speculate: " << I;
                }
            }
                if !(false) { break; }
            }
            return false;
        }
        if &mut I != CmpMI && I.modifiesRegister(NZCV, self.TRI) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                    dbgs() << "Clobbers flags: " << I;
                }
            }
                if !(false) { break; }
            }
            return false;
        }
    }
    return true;
}

fn SSACCmpConv::canConvert(self, MBB: *mut MachineBasicBlock) -> bool {
    self.Head = MBB;
    self.Tail = self.CmpBB = null;
    if self.Head.succ_size() != 2 {
        return false;
    }
    let mut Succ0: *mut MachineBasicBlock = self.Head.succ_begin()[0];
    let mut Succ1: *mut MachineBasicBlock = self.Head.succ_begin()[1];
    if Succ0.pred_size() != 1 {
        swap(Succ0, Succ1);
    }
    if Succ0.pred_size() != 1 || Succ0.succ_size() != 2 {
        return false;
    }
    self.CmpBB = Succ0;
    self.Tail = Succ1;
    if !self.CmpBB.isSuccessor(self.Tail) {
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
            dbgs() << "\nTriangle: " << printMBBReference(*self.Head) << " -> " << printMBBReference(*self.CmpBB) << " -> " << printMBBReference(*self.Tail) << 10;
        }
    }
        if !(false) { break; }
    }
    operator(NumConsidered);
    if !self.trivialTailPHIs() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Can't handle phis in Tail.\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumPhiRejs);
        return false;
    }
    if !self.Tail.livein_empty() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Can't handle live-in physregs in Tail.\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumPhysRejs);
        return false;
    }
    if !self.CmpBB.is_empty() && self.CmpBB.front().isPHI() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Can't handle phis in CmpBB.\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumPhi2Rejs);
        return false;
    }
    if !self.CmpBB.livein_empty() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Can't handle live-in physregs in CmpBB.\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumPhysRejs);
        return false;
    }
    self.HeadCond.clear();
    let mut TBB: *mut MachineBasicBlock = null;
    let mut FBB: *mut MachineBasicBlock = null;
    if self.TII.analyzeBranch(*self.Head, TBB, FBB, self.HeadCond, false) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Head branch not analyzable.\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumHeadBranchRejs);
        return false;
    }
    if !TBB || self.HeadCond.is_empty() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "analyzeBranch didn't find conditional branch in Head.\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumHeadBranchRejs);
        return false;
    }
    if !parseCond(self.HeadCond, self.HeadCmpBBCC) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Unsupported branch type on Head\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumHeadBranchRejs);
        return false;
    }
    if TBB != self.CmpBB {
        assert!(TBB == self.Tail, "Unexpected TBB");
        self.HeadCmpBBCC = getInvertedCondCode(self.HeadCmpBBCC);
    }
    self.CmpBBCond.clear();
    TBB = FBB = null;
    if self.TII.analyzeBranch(*self.CmpBB, TBB, FBB, self.CmpBBCond, false) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "CmpBB branch not analyzable.\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumCmpBranchRejs);
        return false;
    }
    if !TBB || self.CmpBBCond.is_empty() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "analyzeBranch didn't find conditional branch in CmpBB.\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumCmpBranchRejs);
        return false;
    }
    if !parseCond(self.CmpBBCond, self.CmpBBTailCC) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Unsupported branch type on CmpBB\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumCmpBranchRejs);
        return false;
    }
    if TBB != self.Tail {
        self.CmpBBTailCC = getInvertedCondCode(self.CmpBBTailCC);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
            dbgs() << "Head->CmpBB on " << getCondCodeName(self.HeadCmpBBCC) << ", CmpBB->Tail on " << getCondCodeName(self.CmpBBTailCC) << 10;
        }
    }
        if !(false) { break; }
    }
    self.CmpMI = self.findConvertibleCompare(self.CmpBB);
    if !self.CmpMI {
        return false;
    }
    if !self.canSpeculateInstrs(self.CmpBB, self.CmpMI) {
        operator(NumSpeculateRejs);
        return false;
    }
    return true;
}

fn SSACCmpConv::convert(self, RemovedBlocks: *mut SmallVectorImpl<MachineBasicBlock *>) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
            dbgs() << "Merging " << printMBBReference(*self.CmpBB) << " into " << printMBBReference(*self.Head) << ":\n" << *self.CmpBB;
        }
    }
        if !(false) { break; }
    }
    self.updateTailPHIs();
    let mut Head2CmpBB: BranchProbability = self.MBPI.getEdgeProbability(self.Head, self.CmpBB);
    let mut CmpBB2Tail: BranchProbability = self.MBPI.getEdgeProbability(self.CmpBB, self.Tail);
    self.Head.removeSuccessor(self.CmpBB, false);
    self.CmpBB.removeSuccessor(self.Tail, false);
    if self.Head.hasSuccessorProbabilities() && self.CmpBB.hasSuccessorProbabilities() {
        assert!(*self.Head.succ_begin() == self.Tail, "Head successor is not Tail");
        let mut Head2Tail: BranchProbability = self.MBPI.getEdgeProbability(self.Head, self.Tail);
        self.Head.setSuccProbability(self.Head.succ_begin(), Head2Tail + Head2CmpBB * CmpBB2Tail);
        for let mut I: succ_iterator = self.CmpBB.succ_begin();
let mut E: succ_iterator = self.CmpBB.succ_end(); I != E; I += 1 {
            let mut CmpBB2I: BranchProbability = self.MBPI.getEdgeProbability(self.CmpBB, *I);
            self.CmpBB.setSuccProbability(I, Head2CmpBB * CmpBB2I);
        }
    }
    self.Head.transferSuccessorsAndUpdatePHIs(self.CmpBB);
    let mut TermDL: DebugLoc = operator(self.Head.getFirstTerminator()).getDebugLoc();
    self.TII.removeBranch(*self.Head, null);
    if self.HeadCond[0].getImm() == -1 {
        operator(NumCompBranches);
        self.TII.insertCmpForCondBr(*self.Head, self.Head.end(), TermDL, self.HeadCond);
    }
    self.Head.splice(self.Head.end(), self.CmpBB, self.CmpBB.begin(), self.CmpBB.end());
    let mut Opc: u32 = 0;
    let mut FirstOp: u32 = 1;
    let mut isZBranch: bool = false;
    match self.CmpMI.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unknown compare opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ConditionalCompares.cpp", 693);
        },
        SUBSWri => {
            Opc = CCMPWi;
        },
        SUBSWrr => {
            Opc = CCMPWr;
        },
        SUBSXri => {
            Opc = CCMPXi;
        },
        SUBSXrr => {
            Opc = CCMPXr;
        },
        ADDSWri => {
            Opc = CCMNWi;
        },
        ADDSWrr => {
            Opc = CCMNWr;
        },
        ADDSXri => {
            Opc = CCMNXi;
        },
        ADDSXrr => {
            Opc = CCMNXr;
        },
        FCMPSrr => {
            Opc = FCCMPSrr;
        },
        FCMPDrr => {
            Opc = FCCMPDrr;
        },
        FCMPESrr => {
            Opc = FCCMPESrr;
        },
        FCMPEDrr => {
            Opc = FCCMPEDrr;
        },
        CBZW => {
            CBNZW;
        },
        CBZX => {
            CBNZX;
        },
        CBWPri => {
            Opc = CCMPWi;
        },
        CBXPri => {
            Opc = CCMPXi;
        },
        CBWPrr => {
            CBBAssertExt;
        },
        CBXPrr => {
            Opc = CCMPXr;
        },
    }
    let mut NZCV: u32 = getNZCVToSatisfyCondCode(self.CmpBBTailCC);
    let mut MCID: *MCInstrDesc = self.TII.get(Opc);
    self.MRI.constrainRegClass(self.CmpMI.getOperand(FirstOp).getReg(), self.TII.getRegClass(MCID, 0), 0);
    if self.CmpMI.getOperand(FirstOp + 1).isReg() {
        self.MRI.constrainRegClass(self.CmpMI.getOperand(FirstOp + 1).getReg(), self.TII.getRegClass(MCID, 1), 0);
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*self.Head, self.CmpMI, MIMetadata { DL: self.CmpMI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, MCID).add(self.CmpMI.getOperand(FirstOp));
    if isZBranch {
        MIB.addImm(0);
    } else {
        MIB.add(self.CmpMI.getOperand(FirstOp + 1));
    }
    MIB.addImm(NZCV).addImm(self.HeadCmpBBCC);
    if self.CmpMI.isTerminator(AnyInBundle) {
        let mut CC: CondCode = zeroed();
        match self.CmpMI.getOpcode() {
            _ => {
                llvm_unreachable_internal("Unexpected CMP opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ConditionalCompares.cpp", 764);
            },
            CBZW => {
                CBZX;
            },
            CBNZW => {
                CBNZX;
            },
            CBWPri => {
                CBXPri;
            },
        }
        let mut BrTarget: *mut MachineBasicBlock = self.TII.getBranchDestBlock(*self.CmpMI);
        BuildMI(*self.Head, self.CmpMI, MIMetadata { DL: self.CmpMI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Bcc)).addImm(CC).addMBB(BrTarget, 0);
    }
    self.CmpMI.eraseFromParent();
    self.Head.updateTerminator(self.CmpBB.getNextNode());
    RemovedBlocks.push(self.CmpBB);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
            dbgs() << "Result:\n" << *self.Head;
        }
    }
        if !(false) { break; }
    }
    operator(NumConverted);
}

fn SSACCmpConv::expectedCodeSizeDelta(self: *SSACCmpConv) -> i32 {
    let mut delta: i32 = 0;
    if self.HeadCond[0].getImm() == -1 {
        match self.HeadCond[1].getImm() {
            CBZW => {
                CBNZW;
            },
            CBBAssertExt => {
                CBHAssertExt;
            },
            _ => {
                llvm_unreachable_internal("Cannot convert Head branch", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ConditionalCompares.cpp", 821);
            },
        }
    }
    match self.CmpMI.getOpcode() {
        _ => {
            delta -= 1;
        },
        CBZW => {
            CBNZW;
        },
    }
    return delta;
}

struct AArch64ConditionalComparesImpl {
    MBPI: *MachineBranchProbabilityInfo,
    TII: *TargetInstrInfo,
    TRI: *TargetRegisterInfo,
    STI: *TargetSubtargetInfo,
    MinSize: bool,
    MRI: *mut MachineRegisterInfo,
    DomTree: *mut MachineDominatorTree,
    Loops: *mut MachineLoopInfo,
    Traces: *mut MachineTraceMetrics,
    MinInstr: *mut Ensemble,
    CmpConv: SSACCmpConv,
}

struct AArch64ConditionalComparesLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64ConditionalComparesLegacy::AArch64ConditionalComparesLegacy(self) {
    initializeAArch64ConditionalComparesLegacyPass(*getPassRegistry());
}

fn AArch64ConditionalComparesLegacy::getPassName(self: *AArch64ConditionalComparesLegacy) -> str {
    return "AArch64 Conditional Compares";
}

fn AArch64ConditionalComparesLegacy::getPassKind(self: *AArch64ConditionalComparesLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64ConditionalComparesLegacy::getPassID(self: *AArch64ConditionalComparesLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64ConditionalComparesLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64ConditionalComparesLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64ConditionalComparesLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64ConditionalComparesLegacy::getResolver(self: *AArch64ConditionalComparesLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64ConditionalComparesLegacy::getRequiredProperties(self: *AArch64ConditionalComparesLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64ConditionalComparesLegacy::getSetProperties(self: *AArch64ConditionalComparesLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64ConditionalComparesLegacy::getClearedProperties(self: *AArch64ConditionalComparesLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createAArch64ConditionalCompares() -> *mut FunctionPass {
    return AArch64ConditionalComparesLegacy {};
}

fn AArch64ConditionalComparesLegacy::getAnalysisUsage(self: *AArch64ConditionalComparesLegacy, AU: *mut AnalysisUsage) {
    AU.addRequired();
    AU.addRequired();
    AU.addPreserved();
    AU.addRequired();
    AU.addPreserved();
    AU.addRequired();
    AU.addPreserved();
    self.getAnalysisUsage(AU);
}

fn AArch64ConditionalComparesImpl::updateDomTree(self, Removed: ArrayRef<MachineBasicBlock *>) {
    let mut HeadNode: *mut MachineDomTreeNode = self.DomTree.getNode(self.CmpConv.Head);
    for RemovedMBB in Removed {
        let mut Node: *mut MachineDomTreeNode = self.DomTree.getNode(RemovedMBB);
        assert!(Node != HeadNode, "Cannot erase the head node");
        assert!(Node.getIDom() == HeadNode, "CmpBB should be dominated by Head");
        while !Node.isLeaf() {
            self.DomTree.changeImmediateDominator(operator(Node.begin()), HeadNode);
        }
        self.DomTree.eraseNode(RemovedMBB);
    }
}

fn AArch64ConditionalComparesImpl::updateLoops(self, Removed: ArrayRef<MachineBasicBlock *>) {
    if !self.Loops {
        return;
    }
    for RemovedMBB in Removed {
        self.Loops.removeBlock(RemovedMBB);
    }
}

fn AArch64ConditionalComparesImpl::invalidateTraces(self) {
    self.Traces.invalidate(self.CmpConv.Head);
    self.Traces.invalidate(self.CmpConv.CmpBB);
}

fn AArch64ConditionalComparesImpl::shouldConvert(self) -> bool {
    if Stress {
        return true;
    }
    if !self.MinInstr {
        self.MinInstr = self.Traces.getEnsemble(TS_MinInstrCount);
    }
    let mut Trace: Trace = self.MinInstr.getTrace(self.CmpConv.CmpBB);
    if self.MinSize {
        let mut CodeSizeDelta: i32 = self.CmpConv.expectedCodeSizeDelta();
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Code size delta:  " << CodeSizeDelta << 10;
            }
        }
            if !(false) { break; }
        }
        if CodeSizeDelta < 0 {
            return true;
        }
        if CodeSizeDelta > 0 {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                    dbgs() << "Code size is increasing, give up on this one.\n";
                }
            }
                if !(false) { break; }
            }
            return false;
        }
    }
    let mut DelayLimit: u32 = self.STI.getMispredictionPenalty() * 3 / 4;
    let mut HeadDepth: u32 = Trace.getInstrCycles(operator(self.CmpConv.Head.getFirstTerminator())).Depth;
    let mut CmpBBDepth: u32 = Trace.getInstrCycles(operator(self.CmpConv.CmpBB.getFirstTerminator())).Depth;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
            dbgs() << "Head depth:  " << HeadDepth << "\nCmpBB depth: " << CmpBBDepth << 10;
        }
    }
        if !(false) { break; }
    }
    if CmpBBDepth > HeadDepth + DelayLimit {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Branch delay would be larger than " << DelayLimit << " cycles.\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut ResDepth: u32 = Trace.getResourceDepth(true);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
            dbgs() << "Resources:   " << ResDepth << 10;
        }
    }
        if !(false) { break; }
    }
    if ResDepth > HeadDepth {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
                dbgs() << "Too many instructions to speculate.\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    return true;
}

fn AArch64ConditionalComparesImpl::tryConvert(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Changed: bool = false;
    while self.CmpConv.canConvert(MBB) && self.shouldConvert() {
        self.invalidateTraces();
        let mut RemovedBlocks: SmallVector<MachineBasicBlock *, 4> = SmallVector<MachineBasicBlock *, 4> {};
        self.CmpConv.convert(RemovedBlocks);
        Changed = true;
        self.updateDomTree(RemovedBlocks);
        self.updateLoops(RemovedBlocks);
        for MBB in RemovedBlocks {
            MBB.eraseFromParent();
        }
    }
    return Changed;
}

fn AArch64ConditionalComparesImpl::run(self, MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-ccmp", 1) {
            dbgs() << "********** AArch64 Conditional Compares **********\n" << "********** Function: " << MF.getName() << 10;
        }
    }
        if !(false) { break; }
    }
    self.TII = MF.getSubtarget().getInstrInfo();
    self.TRI = MF.getSubtarget().getRegisterInfo();
    self.STI = &mut MF.getSubtarget();
    self.MRI = &mut MF.getRegInfo();
    self.MinInstr = null;
    self.MinSize = MF.getFunction().hasMinSize();
    let mut Changed: bool = false;
    self.CmpConv.runOnMachineFunction(MF, self.MBPI);
    for I in depth_first(self.DomTree) {
        if self.tryConvert(I.getBlock()) {
            Changed = true;
        }
    }
    return Changed;
}

fn AArch64ConditionalComparesLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut MBPI: *MachineBranchProbabilityInfo = &mut self.getAnalysis().getMBPI();
    let mut DomTree: *mut MachineDominatorTree = &mut self.getAnalysis().getDomTree();
    let mut Loops: *mut MachineLoopInfo = &mut self.getAnalysis().getLI();
    let mut Traces: *mut MachineTraceMetrics = &mut self.getAnalysis().getMTM();
    let mut Impl: AArch64ConditionalComparesImpl = AArch64ConditionalComparesImpl { MBPI, DomTree, Loops, Traces };
    return Impl.run(MF);
}

fn AArch64ConditionalComparesPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut MBPI: *MachineBranchProbabilityInfo = &mut MFAM.getResult(MF);
    let mut DomTree: *mut MachineDominatorTree = &mut MFAM.getResult(MF);
    let mut Loops: *mut MachineLoopInfo = &mut MFAM.getResult(MF);
    let mut Traces: *mut MachineTraceMetrics = &mut MFAM.getResult(MF);
    let mut Impl: AArch64ConditionalComparesImpl = AArch64ConditionalComparesImpl { MBPI, DomTree, Loops, Traces };
    let mut Changed: bool = Impl.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserve();
    PA.preserve();
    PA.preserve();
    return PA;
}
