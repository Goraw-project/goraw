    MBPI: *MachineBranchProbabilityInfo,
    TII: *TargetInstrInfo,
    TRI: *TargetRegisterInfo,
    STI: *TargetSubtargetInfo,
    MinSize: bool,
    MRI: *mut MachineRegisterInfo,
    DomTree: *mut MachineDominatorTree,
    Loops: *mut MachineLoopInfo,
    Traces: *mut MachineTraceMetrics,
    MinInstr: *mut Ensemble,
    CmpConv: SSACCmpConv,
}

