fn AArch64SelectionDAGInfo::EmitMOPS(self: *AArch64SelectionDAGInfo, Opcode: u32, DAG: *mut SelectionDAG, DL: *SDLoc, Chain: SDValue, Dst: SDValue, SrcOrValue: SDValue, Size: SDValue, DstAlign: Align, SrcAlign: Align, isVolatile: bool, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo) -> SDValue {
    let mut MemSize: LocationSize = afterPointer();
    if  {
        MemSize = precise();
    }
    let mut IsSet: bool = false;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut Vol: Flags = if isVolatile { MOVolatile } else { MONone };
    let mut DstFlags: i32 = MOStore | Vol;
    let mut DstOp: *mut auto = MF;
    if IsSet {
        if SrcOrValue.getValueType() != i64 {
            SrcOrValue = DAG.getNode(ANY_EXTEND, DL, i64, SrcOrValue);
        }
        let mut Ops: [4]SDValue = [Dst, Size, SrcOrValue, Chain];
        let mut ResultTys: [3]EVT = [i64, i64, Other];
        let mut Node: *mut MachineSDNode = DAG;
        DAG.setNodeMemRefs(Node, void {});
        return SDValue { Node: Node, ResNo: 2 };
    } else {
        let mut Ops: [4]SDValue = [Dst, SrcOrValue, Size, Chain];
        let mut ResultTys: [4]EVT = [i64, i64, i64, Other];
        let mut Node: *mut MachineSDNode = DAG;
        let mut SrcFlags: i32 = MOLoad | Vol;
        let mut SrcOp: *mut auto = MF;
        DAG.setNodeMemRefs(Node, void { ,  });
        return SDValue { Node: Node, ResNo: 3 };
    }
}

fn AArch64SelectionDAGInfo::EmitStreamingCompatibleMemLibCall(self: *AArch64SelectionDAGInfo, DAG: *mut SelectionDAG, DL: *SDLoc, Chain: SDValue, Op0: SDValue, Op1: SDValue, Size: SDValue, LC: Libcall) -> SDValue {
    let mut STI: *AArch64Subtarget = DAG.getMachineFunction();
    let mut TLI: *AArch64TargetLowering = STI.getTargetLowering();
    let mut Args: i32 = 0;
    Args()(Op0, getUnqual(*DAG.getContext()));
    let mut UsesResult: bool = false;
    let mut NewLC: Libcall = zeroed();
    match LC {
        MEMCPY => {
            NewLC = SC_MEMCPY;
            Args()(Op1, getUnqual(*DAG.getContext()));
            break;
        },
        MEMMOVE => {
            NewLC = SC_MEMMOVE;
            Args()(Op1, getUnqual(*DAG.getContext()));
            break;
        },
        MEMSET => {
            NewLC = SC_MEMSET;
            Args()(DAG.getZExtOrTrunc(Op1, DL, i32), getInt32Ty(*DAG.getContext()));
            break;
        },
        MEMCHR => {
            UsesResult = true;
            NewLC = SC_MEMCHR;
            Args()(DAG.getZExtOrTrunc(Op1, DL, i32), getInt32Ty(*DAG.getContext()));
            break;
        },
        _ => {
            return SDValue {};
        },
    }
    let mut NewLCImpl: LibcallImpl = DAG.getLibcalls().getLibcallImpl(NewLC);
    if NewLCImpl == Unsupported {
        return SDValue {};
    }
    let mut PointerVT: EVT = TLI.getPointerTy(DAG.getDataLayout(), 0);
    let mut Symbol: SDValue = DAG.getExternalSymbol(NewLCImpl, PointerVT);
    Args()(Size, DAG.getDataLayout().getIntPtrType(*DAG.getContext(), 0));
    let mut CLI: CallLoweringInfo = DAG;
    let mut RetTy: *mut PointerType = getUnqual(*DAG.getContext());
    CLI.setDebugLoc(DL).setChain(Chain)(DAG.getLibcalls().getLibcallImplCallingConv(NewLCImpl), RetTy, Symbol, move());
    return if UsesResult { DAG.getMergeValues(void { ,  }, DL) } else {  };
}

fn AArch64SelectionDAGInfo::EmitTargetCodeForMemcpy(self: *AArch64SelectionDAGInfo, DAG: *mut SelectionDAG, DL: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: SDValue, DstAlign: Align, SrcAlign: Align, isVolatile: bool, AlwaysInline: bool, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo) -> SDValue {
    let mut STI: *AArch64Subtarget = DAG.getMachineFunction();
    if UseMOPS() && STI()() {
        return self.EmitMOPS;
    }
    let mut AFI: *mut auto = DAG.getMachineFunction();
    let mut Attrs: SMEAttrs = ();
    if LowerToSMERoutines() && !Attrs.hasNonStreamingInterfaceAndBody() {
        return self.EmitStreamingCompatibleMemLibCall(DAG, DL, Chain, Dst, Src, Size, MEMCPY);
    }
    return SDValue {};
}

fn AArch64SelectionDAGInfo::EmitTargetCodeForMemset(self: *AArch64SelectionDAGInfo, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: SDValue, Alignment: Align, isVolatile: bool, AlwaysInline: bool, DstPtrInfo: MachinePointerInfo) -> SDValue {
    let mut STI: *AArch64Subtarget = DAG.getMachineFunction();
    if UseMOPS() && STI()() {
        return self.EmitMOPS;
    }
    let mut AFI: *mut auto = DAG.getMachineFunction();
    let mut Attrs: SMEAttrs = ();
    if LowerToSMERoutines() && !Attrs.hasNonStreamingInterfaceAndBody() {
        return self.EmitStreamingCompatibleMemLibCall(DAG, dl, Chain, Dst, Src, Size, MEMSET);
    }
    return SDValue {};
}

fn AArch64SelectionDAGInfo::EmitTargetCodeForMemmove(self: *AArch64SelectionDAGInfo, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: SDValue, DstAlign: Align, SrcAlign: Align, isVolatile: bool, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo) -> SDValue {
    let mut STI: *AArch64Subtarget = DAG.getMachineFunction();
    if UseMOPS() && STI()() {
        return self.EmitMOPS;
    }
    let mut AFI: *mut auto = DAG.getMachineFunction();
    let mut Attrs: SMEAttrs = ();
    if LowerToSMERoutines() && !Attrs.hasNonStreamingInterfaceAndBody() {
        return self.EmitStreamingCompatibleMemLibCall(DAG, dl, Chain, Dst, Src, Size, MEMMOVE);
    }
    return SDValue {};
}

fn AArch64SelectionDAGInfo::EmitTargetCodeForMemchr(self: *AArch64SelectionDAGInfo, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Src: SDValue, Char: SDValue, Length: SDValue, SrcPtrInfo: MachinePointerInfo) -> pair<SDValue, SDValue> {
    let mut AFI: *mut auto = DAG.getMachineFunction();
    let mut Attrs: SMEAttrs = ();
    if LowerToSMERoutines() && !Attrs.hasNonStreamingInterfaceAndBody() {
        let mut Result: SDValue = self.EmitStreamingCompatibleMemLibCall(DAG, dl, Chain, Src, Char, Length, MEMCHR);
        return make_pair(Result.getValue(0), Result.getValue(1));
    }
    return make_pair(SDValue {}, SDValue {});
}

const kSetTagLoopThreshold: i32 = 176;

fn EmitUnrolledSetTag(DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, ObjSize: u64, BaseMemOperand: *MachineMemOperand, ZeroData: bool) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut ObjSizeScaled: u32 = ObjSize / 16;
    let mut TagSrc: SDValue = Ptr;
    if Ptr.getOpcode() == FrameIndex {
        let mut FI: i32 = cast(Ptr)();
        Ptr = DAG.getTargetFrameIndex(FI, i64);
        TagSrc = DAG.getRegister;
    }
    let mut OpCode1: u32 = 0;
    let mut OpCode2: u32 = 0;
    let mut OutChains: SmallVector<SDValue, 8> = zeroed();
    let mut OffsetScaled: u32 = 0;
    while OffsetScaled < ObjSizeScaled {
        if ObjSizeScaled - OffsetScaled >= 2 {
            let mut AddrNode: SDValue = DAG.getMemBasePlusOffset(Ptr, getFixed(OffsetScaled * 16), dl, SDNodeFlags { Flags: None });
            let mut St: SDValue = DAG;
            OffsetScaled += 2;
            OutChains()(St);
            continue;
        }
        if ObjSizeScaled - OffsetScaled > 0 {
            let mut AddrNode: SDValue = DAG.getMemBasePlusOffset(Ptr, getFixed(OffsetScaled * 16), dl, SDNodeFlags { Flags: None });
            let mut St: SDValue = DAG;
            OffsetScaled += 1;
            OutChains()(St);
        }
    }
    let mut Res: SDValue = DAG(TokenFactor, dl, Other);
    return Res;
}

fn AArch64SelectionDAGInfo::EmitTargetCodeForSetTag(self: *AArch64SelectionDAGInfo, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Addr: SDValue, Size: SDValue, DstPtrInfo: MachinePointerInfo, ZeroData: bool) -> SDValue {
    let mut ObjSize: u64 = operator(Size).getAsZExtVal();
    assert!(ObjSize % 16 == 0);
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut BaseMemOperand: *mut MachineMemOperand = MF.getMachineMemOperand(DstPtrInfo, MOStore, ObjSize, 16, MMOMetadata {}, System, NotAtomic, NotAtomic);
    let mut UseSetTagRangeLoop: bool = kSetTagLoopThreshold >= 0 && ObjSize as i32 >= kSetTagLoopThreshold;
    if !UseSetTagRangeLoop {
        return EmitUnrolledSetTag(DAG, dl, Chain, Addr, ObjSize, BaseMemOperand, ZeroData);
    }
    let mut ResTys: [3]EVT = [i64, i64, Other];
    let mut Opcode: u32 = 0;
    if Addr.getOpcode() == FrameIndex {
        let mut FI: i32 = cast(Addr)();
        Addr = DAG.getTargetFrameIndex(FI, i64);
    } else {}
    let mut Ops: [3]SDValue = [DAG.getTargetConstant(ObjSize, dl, i64, false), Addr, Chain];
    let mut St: *mut SDNode = DAG;
    DAG.setNodeMemRefs(cast(St), void { BaseMemOperand });
    return SDValue { Node: St, ResNo: 2 };
}
