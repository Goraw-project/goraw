fn AArch64AdvSIMDScalarLegacy::getClearedProperties(self: *AArch64AdvSIMDScalarLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn AArch64AdvSIMDScalarPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64AdvSIMDScalarImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

fn isGPR64(Reg: u32, SubReg: u32, MRI: *MachineRegisterInfo) -> bool {
    if SubReg {
        return false;
    }
    if isVirtualRegister(Reg) {
        return MRI.getRegClass(Reg).hasSuperClassEq(&mut GPR64RegClass);
    }
    return GPR64RegClass.contains(Reg);
}

fn isFPR64(Reg: u32, SubReg: u32, MRI: *MachineRegisterInfo) -> bool {
    if isVirtualRegister(Reg) {
        return (MRI.getRegClass(Reg).hasSuperClassEq(&mut FPR64RegClass) && SubReg == 0) || (MRI.getRegClass(Reg).hasSuperClassEq(&mut FPR128RegClass) && SubReg == dsub);
    }
    return (FPR64RegClass.contains(Reg) && SubReg == 0) || (FPR128RegClass.contains(Reg) && SubReg == dsub);
}

fn getSrcFromCopy(MI: *mut MachineInstr, MRI: *MachineRegisterInfo, SubReg: *mut u32) -> *mut MachineOperand {
    SubReg = 0;
    if MI.getOpcode() == FMOVDXr || MI.getOpcode() == FMOVXDr {
        return &mut MI.getOperand(1);
    }
    if MI.getOpcode() == UMOVvi64 && MI.getOperand(2).getImm() == 0 {
        SubReg = dsub;
        return &mut MI.getOperand(1);
    }
    if MI.getOpcode() == COPY {
        if isFPR64(MI.getOperand(0).getReg().operator unsigned int(), MI.getOperand(0).getSubReg(), MRI) && isGPR64(MI.getOperand(1).getReg().operator unsigned int(), MI.getOperand(1).getSubReg(), MRI) {
            return &mut MI.getOperand(1);
        }
        if isGPR64(MI.getOperand(0).getReg().operator unsigned int(), MI.getOperand(0).getSubReg(), MRI) && isFPR64(MI.getOperand(1).getReg().operator unsigned int(), MI.getOperand(1).getSubReg(), MRI) {
            SubReg = MI.getOperand(1).getSubReg();
            return &mut MI.getOperand(1);
        }
    }
    return null;
}

fn getTransformOpcode(Opc: u32) -> u32 {
    match Opc {
        _ => {
            break;
        },
        ADDXrr => {
            return ADDv1i64;
        },
        SUBXrr => {
            return SUBv1i64;
        },
        ANDXrr => {
            return ANDv8i8;
        },
        EORXrr => {
            return EORv8i8;
        },
        ORRXrr => {
            return ORRv8i8;
        },
    }
    return Opc;
}

fn isTransformable(MI: *MachineInstr) -> bool {
    let mut Opc: u32 = MI.getOpcode();
    return Opc != getTransformOpcode(Opc);
}

fn AArch64AdvSIMDScalarImpl::isProfitableToTransform(self: *AArch64AdvSIMDScalarImpl, MI: *MachineInstr) -> bool {
    if !isTransformable(MI) {
        return false;
    }
    let mut NumNewCopies: u32 = 3;
    let mut NumRemovableCopies: u32 = 0;
    let mut OrigSrc0: Register = MI.getOperand(1).getReg();
    let mut OrigSrc1: Register = MI.getOperand(2).getReg();
    let mut SubReg0: u32 = 0;
    let mut SubReg1: u32 = 0;
    if !self.MRI.def_empty(OrigSrc0) {
        let mut Def: def_instr_iterator = self.MRI.def_instr_begin(OrigSrc0);
        assert!(next(Def, 1) == self.MRI.def_instr_end(), "Multiple def in SSA!");
        let mut MOSrc0: *mut MachineOperand = getSrcFromCopy(&mut operator(Def), self.MRI, SubReg0);
        if MOSrc0 {
            NumNewCopies -= 1;
        }
        if MOSrc0 && self.MRI.hasOneNonDBGUse(OrigSrc0) {
            NumRemovableCopies += 1;
        }
    }
    if !self.MRI.def_empty(OrigSrc1) {
        let mut Def: def_instr_iterator = self.MRI.def_instr_begin(OrigSrc1);
        assert!(next(Def, 1) == self.MRI.def_instr_end(), "Multiple def in SSA!");
        let mut MOSrc1: *mut MachineOperand = getSrcFromCopy(&mut operator(Def), self.MRI, SubReg1);
        if MOSrc1 {
            NumNewCopies -= 1;
        }
        if MOSrc1 && self.MRI.hasOneNonDBGUse(OrigSrc1) {
            NumRemovableCopies += 1;
        }
    }
    let mut Dst: Register = MI.getOperand(0).getReg();
    let mut AllUsesAreCopies: bool = true;
    for let mut Use: use_instr_nodbg_iterator = self.MRI.use_instr_nodbg_begin(Dst);
let mut E: use_instr_nodbg_iterator = self.MRI.use_instr_nodbg_end(); Use != E; operator(Use) {
        let mut SubReg: u32 = 0;
        if getSrcFromCopy(&mut operator(Use), self.MRI, SubReg) || isTransformable(operator(Use)) {
            NumRemovableCopies += 1;
        } else if operator(Use).getOpcode() == INSERT_SUBREG || operator(Use).getOpcode() == INSvi64gpr {
            
        } else {
            AllUsesAreCopies = false;
        }
    }
    if AllUsesAreCopies {
        NumNewCopies -= 1;
    }
    if NumNewCopies <= NumRemovableCopies {
        return true;
    }
    return TransformAll;
}

fn insertCopy(TII: *TargetInstrInfo, MI: *mut MachineInstr, Dst: u32, Src: u32, IsKill: bool) -> *mut MachineInstr {
    let mut MIB: MachineInstrBuilder = BuildMI(*MI.getParent(), MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(COPY), Dst).addReg(Src, getKillRegState(IsKill), 0);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-simd-scalar", 1) {
            dbgs() << "    adding copy: " << *MIB.operator llvm::MachineInstr *();
        }
    }
        if !(false) { break; }
    }
    operator(NumCopiesInserted);
    return MIB.operator llvm::MachineInstr *();
}

fn AArch64AdvSIMDScalarImpl::transformInstruction(self, MI: *mut MachineInstr) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-simd-scalar", 1) {
            dbgs() << "Scalar transform: " << MI;
        }
    }
        if !(false) { break; }
    }
    let mut MBB: *mut MachineBasicBlock = MI.getParent();
    let mut OldOpc: u32 = MI.getOpcode();
    let mut NewOpc: u32 = getTransformOpcode(OldOpc);
    assert!(OldOpc != NewOpc, "transform an instruction to itself?!");
    let mut OrigSrc0: Register = MI.getOperand(1).getReg();
    let mut OrigSrc1: Register = MI.getOperand(2).getReg();
    let mut Src0: u32 = 0;
    let mut SubReg0: u32 = 0;
    let mut Src1: u32 = 0;
    let mut SubReg1: u32 = 0;
    let mut KillSrc0: bool = false;
    let mut KillSrc1: bool = false;
    if !self.MRI.def_empty(OrigSrc0) {
        let mut Def: def_instr_iterator = self.MRI.def_instr_begin(OrigSrc0);
        assert!(next(Def, 1) == self.MRI.def_instr_end(), "Multiple def in SSA!");
        let mut MOSrc0: *mut MachineOperand = getSrcFromCopy(&mut operator(Def), self.MRI, SubReg0);
        if MOSrc0 {
            Src0 = MOSrc0.getReg().operator unsigned int();
            KillSrc0 = MOSrc0.isKill();
            MOSrc0.setIsKill(false);
            if self.MRI.hasOneNonDBGUse(OrigSrc0) {
                assert!(MOSrc0, "Can't delete copy w/o a valid original source!");
                operator(Def).eraseFromParent();
                operator(NumCopiesDeleted);
            }
        }
    }
    if !self.MRI.def_empty(OrigSrc1) {
        let mut Def: def_instr_iterator = self.MRI.def_instr_begin(OrigSrc1);
        assert!(next(Def, 1) == self.MRI.def_instr_end(), "Multiple def in SSA!");
        let mut MOSrc1: *mut MachineOperand = getSrcFromCopy(&mut operator(Def), self.MRI, SubReg1);
        if MOSrc1 {
            Src1 = MOSrc1.getReg().operator unsigned int();
            KillSrc1 = MOSrc1.isKill();
            MOSrc1.setIsKill(false);
            if self.MRI.hasOneNonDBGUse(OrigSrc1) {
                assert!(MOSrc1, "Can't delete copy w/o a valid original source!");
                operator(Def).eraseFromParent();
                operator(NumCopiesDeleted);
            }
        }
    }
    if !Src0 {
        SubReg0 = 0;
        Src0 = self.MRI.createVirtualRegister(&mut FPR64RegClass, "").operator unsigned int();
        insertCopy(self.TII, MI, Src0, OrigSrc0.operator unsigned int(), KillSrc0);
        KillSrc0 = true;
    }
    if !Src1 {
        SubReg1 = 0;
        Src1 = self.MRI.createVirtualRegister(&mut FPR64RegClass, "").operator unsigned int();
        insertCopy(self.TII, MI, Src1, OrigSrc1.operator unsigned int(), KillSrc1);
        KillSrc1 = true;
    }
    let mut Dst: Register = self.MRI.createVirtualRegister(&mut FPR64RegClass, "");
    BuildMI(*MBB, MI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NewOpc), Dst).addReg(Src0, getKillRegState(KillSrc0), SubReg0).addReg(Src1, getKillRegState(KillSrc1), SubReg1);
    insertCopy(self.TII, MI, MI.getOperand(0).getReg().operator unsigned int(), Dst.operator unsigned int(), true);
    MI.eraseFromParent();
    operator(NumScalarInsnsUsed);
}

fn AArch64AdvSIMDScalarImpl::processMachineBasicBlock(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Changed: bool = false;
    for MI in make_early_inc_range(*MBB) {
        if self.isProfitableToTransform(MI) {
            self.transformInstruction(MI);
            Changed = true;
        }
    }
    return Changed;
}

fn AArch64AdvSIMDScalarLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    return AArch64AdvSIMDScalarImpl {}.run(MF);
}

fn AArch64AdvSIMDScalarImpl::run(self, MF: *mut MachineFunction) -> bool {
    let mut Changed: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-simd-scalar", 1) {
            dbgs() << "***** AArch64AdvSIMDScalar *****\n";
        }
    }
        if !(false) { break; }
    }
    self.MRI = &mut MF.getRegInfo();
    self.TII = MF.getSubtarget().getInstrInfo();
    for MBB in MF {
        if self.processMachineBasicBlock(&mut MBB) {
            Changed = true;
        }
    }
    return Changed;
}

fn createAArch64AdvSIMDScalar() -> *mut FunctionPass {
    return AArch64AdvSIMDScalarLegacy {};
}
