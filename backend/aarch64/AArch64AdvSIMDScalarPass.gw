static mut TransformAll: opt<bool> = opt<bool> { "aarch64-simd-scalar-force-all", "Force use of AdvSIMD scalar instructions everywhere", init(false), Hidden };

static mut NumScalarInsnsUsed: Statistic = Statistic { "aarch64-simd-scalar", "NumScalarInsnsUsed", "Number of scalar instructions used" };

static mut NumCopiesDeleted: Statistic = Statistic { "aarch64-simd-scalar", "NumCopiesDeleted", "Number of cross-class copies deleted" };

static mut NumCopiesInserted: Statistic = Statistic { "aarch64-simd-scalar", "NumCopiesInserted", "Number of cross-class copies inserted" };

struct AArch64AdvSIMDScalarImpl {
    MRI: *mut MachineRegisterInfo,
    TII: *TargetInstrInfo,
}

struct AArch64AdvSIMDScalarLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64AdvSIMDScalarLegacy::getPassName(self: *AArch64AdvSIMDScalarLegacy) -> str {
    return "AdvSIMD Scalar Operation Optimization";
}

fn AArch64AdvSIMDScalarLegacy::getAnalysisUsage(self: *AArch64AdvSIMDScalarLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage(AU);
}

fn AArch64AdvSIMDScalarLegacy::getPassKind(self: *AArch64AdvSIMDScalarLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64AdvSIMDScalarLegacy::getPassID(self: *AArch64AdvSIMDScalarLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64AdvSIMDScalarLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64AdvSIMDScalarLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64AdvSIMDScalarLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64AdvSIMDScalarLegacy::getResolver(self: *AArch64AdvSIMDScalarLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64AdvSIMDScalarLegacy::getRequiredProperties(self: *AArch64AdvSIMDScalarLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64AdvSIMDScalarLegacy::getSetProperties(self: *AArch64AdvSIMDScalarLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
