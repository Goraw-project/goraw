fn AArch64ExpandPseudoImpl::expandMOVImm(self, MBB: *mut MachineBasicBlock, MBBI: i32, BitSize: u32) -> bool {
    let mut MI: *mut MachineInstr = operator*();
    let mut DstReg: Register = MI.getOperand(0).getReg();
    let mut RenamableState: RegState = getRenamableRegState(MI.getOperand(0).isRenamable());
    let mut Imm: u64 = MI.getOperand(1).getImm();
    if  {
        MI()();
        return true;
    }
    let mut Insn: ImmInsnModel, 4> = zeroed();
    expandMOVImm(Imm, BitSize);
    (((operator!(operator!((Insn()() != 0)))) || (_wassert(L"Insn.size() != 0", L"llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", (158) as u32) , 0)) as void);
    let mut MIBS: SmallVector<MachineInstrBuilder, 4> = zeroed();
    for let mut I: auto = ();
let mut E: auto = (); I() != ;  += 1 {
        let mut LastItem: bool = next() == ;
        match I() {
            _ => {
                llvm_unreachable_internal("unhandled!", "llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", 165);
            },
        }
    }
    transferImpOps(MI);
    MI()();
    return true;
}

fn AArch64ExpandPseudoImpl::expandCMP_SWAP(self, MBB: *mut MachineBasicBlock, MBBI: i32, LdarOp: u32, StlrOp: u32, CmpOp: u32, ExtendImm: u32, ZeroReg: u32, NextMBBI: *mut i32) -> bool {
    let mut MI: *mut MachineInstr = operator*();
    let mut MIMD: MIMetadata = MI;
    let mut Dest: *MachineOperand = MI.getOperand(0);
    let mut StatusReg: Register = MI.getOperand(1).getReg();
    let mut StatusDead: bool = MI.getOperand(1).isDead();
    assert!(!MI.getOperand(2).isUndef(), "cannot handle undef");
    let mut AddrReg: Register = MI.getOperand(2).getReg();
    let mut DesiredReg: Register = MI.getOperand(3).getReg();
    let mut NewReg: Register = MI.getOperand(4).getReg();
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut LoadCmpBB: auto = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    let mut StoreBB: auto = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    let mut DoneBB: auto = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    MF()(MBB()() += 1);
    MF()(() += 1);
    MF()(() += 1);
    if !StatusDead {
        BuildMI(MIMD, self.TII, StatusReg)(0)(0);
    }
    BuildMI(MIMD, self.TII(LdarOp), Dest.getReg())(AddrReg);
    BuildMI(MIMD, self.TII(CmpOp), ZeroReg)(Dest.getReg(), getKillRegState(Dest.isDead()))(DesiredReg)(ExtendImm);
    BuildMI(MIMD, self.TII)(NE)();
    LoadCmpBB()();
    LoadCmpBB()();
    BuildMI(MIMD, self.TII(StlrOp), StatusReg)(NewReg)(AddrReg);
    BuildMI(MIMD, self.TII)(StatusReg, getKillRegState(StatusDead))();
    StoreBB()();
    StoreBB()();
    DoneBB()(&mut MBB, MI, MBB()());
    DoneBB()(&mut MBB);
    MBB.addSuccessor();
    NextMBBI() = MBB()();
    MI()();
    let mut LiveRegs: LivePhysRegs = LivePhysRegs {};
    computeAndAddLiveIns(LiveRegs, operator*());
    computeAndAddLiveIns(LiveRegs, operator*());
    computeAndAddLiveIns(LiveRegs, operator*());
    StoreBB()();
    computeAndAddLiveIns(LiveRegs, operator*());
    LoadCmpBB()();
    computeAndAddLiveIns(LiveRegs, operator*());
    return true;
}

fn AArch64ExpandPseudoImpl::expandCMP_SWAP_128(self, MBB: *mut MachineBasicBlock, MBBI: i32, NextMBBI: *mut i32) -> bool {
    let mut MI: *mut MachineInstr = operator*();
    let mut MIMD: MIMetadata = MI;
    let mut DestLo: *mut MachineOperand = MI.getOperand(0);
    let mut DestHi: *mut MachineOperand = MI.getOperand(1);
    let mut StatusReg: Register = MI.getOperand(2).getReg();
    let mut StatusDead: bool = MI.getOperand(2).isDead();
    assert!(!MI.getOperand(3).isUndef(), "cannot handle undef");
    let mut AddrReg: Register = MI.getOperand(3).getReg();
    let mut DesiredLoReg: Register = MI.getOperand(4).getReg();
    let mut DesiredHiReg: Register = MI.getOperand(5).getReg();
    let mut NewLoReg: Register = MI.getOperand(6).getReg();
    let mut NewHiReg: Register = MI.getOperand(7).getReg();
    let mut STI: *mut auto = MBB.getParent();
    let mut LittleEndian: bool = ();
    let mut Dest0: *mut MachineOperand = if LittleEndian { DestLo } else { DestHi };
    let mut Dest1: *mut MachineOperand = if LittleEndian { DestHi } else { DestLo };
    let mut New0Reg: Register = if LittleEndian { NewLoReg } else { NewHiReg };
    let mut New1Reg: Register = if LittleEndian { NewHiReg } else { NewLoReg };
    let mut LdxpOp: u32 = 0;
    let mut StxpOp: u32 = 0;
    match MI.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", 361);
        },
    }
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut LoadCmpBB: auto = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    let mut StoreBB: auto = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    let mut FailBB: auto = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    let mut DoneBB: auto = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    MF()(MBB()() += 1);
    MF()(() += 1);
    MF()(() += 1);
    MF()(() += 1);
    BuildMI(MIMD, self.TII(LdxpOp))(Dest0.getReg(), Define)(Dest1.getReg(), Define)(AddrReg);
    BuildMI(MIMD, self.TII)(DestLo.getReg(), getKillRegState(DestLo.isDead()))(DesiredLoReg)(0);
    BuildMI(MIMD, self.TII, StatusReg)(EQ);
    BuildMI(MIMD, self.TII)(DestHi.getReg(), getKillRegState(DestHi.isDead()))(DesiredHiReg)(0);
    BuildMI(MIMD, self.TII, StatusReg)(StatusReg, Kill)(StatusReg, Kill)(EQ);
    BuildMI(MIMD, self.TII)(StatusReg, getKillRegState(StatusDead))();
    LoadCmpBB()();
    LoadCmpBB()();
    BuildMI(MIMD, self.TII(StxpOp), StatusReg)(New0Reg)(New1Reg)(AddrReg);
    BuildMI(MIMD, self.TII)(StatusReg, getKillRegState(StatusDead))();
    BuildMI(MIMD, self.TII)();
    StoreBB()();
    StoreBB()();
    BuildMI(MIMD, self.TII(StxpOp), StatusReg)(Dest0.getReg())(Dest1.getReg())(AddrReg);
    BuildMI(MIMD, self.TII)(StatusReg, getKillRegState(StatusDead))();
    FailBB()();
    FailBB()();
    DoneBB()(&mut MBB, MI, MBB()());
    DoneBB()(&mut MBB);
    MBB.addSuccessor();
    NextMBBI() = MBB()();
    MI()();
    let mut LiveRegs: LivePhysRegs = LivePhysRegs {};
    computeAndAddLiveIns(LiveRegs, operator*());
    computeAndAddLiveIns(LiveRegs, operator*());
    computeAndAddLiveIns(LiveRegs, operator*());
    computeAndAddLiveIns(LiveRegs, operator*());
    FailBB()();
    computeAndAddLiveIns(LiveRegs, operator*());
    StoreBB()();
    computeAndAddLiveIns(LiveRegs, operator*());
    LoadCmpBB()();
    computeAndAddLiveIns(LiveRegs, operator*());
    return true;
}

fn AArch64ExpandPseudoImpl::expand_DestructiveOp(self, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, MBBI: i32) -> bool {
    let mut Opcode: u32 = getSVEPseudoMap(MI.getOpcode());
    let mut DType: u64 = self.TII(Opcode) & DestructiveInstTypeMask;
    let mut FalseLanes: u64 = MI.getDesc().TSFlags & FalseLanesMask;
    let mut FalseZero: bool = FalseLanes == FalseLanesZero;
    let mut DstReg: Register = MI.getOperand(0).getReg();
    let mut DstIsDead: bool = MI.getOperand(0).isDead();
    let mut UseRev: bool = false;
    let mut PredIdx: u32 = 0;
    let mut DOPIdx: u32 = 0;
    let mut SrcIdx: u32 = 0;
    let mut Src2Idx: u32 = 0;
    match DType {
        DestructiveBinaryComm => {
            DestructiveBinaryCommWithRev;
        },
        DestructiveBinary => {
            DestructiveBinaryImm;
        },
        DestructiveUnaryPassthru => {
            tie(PredIdx, DOPIdx, SrcIdx) = make_tuple(2, 3, 3);
        },
        DestructiveTernaryCommWithRev => {
            tie(PredIdx, DOPIdx, SrcIdx, Src2Idx) = make_tuple(1, 2, 3, 4);
        },
        Destructive2xRegImmUnpred => {
            tie(DOPIdx, SrcIdx, Src2Idx) = make_tuple(1, 1, 2);
        },
        DestructiveBinaryImmUnpred => {
            tie(DOPIdx, SrcIdx) = make_tuple(1, 2);
        },
        DestructiveBinaryShImmUnpred => {
            tie(DOPIdx, SrcIdx, Src2Idx) = make_tuple(1, 2, 3);
        },
        _ => {
            llvm_unreachable_internal("Unsupported Destructive Operand type", "llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", 550);
        },
    }
    let mut DOPRegIsUnique: bool = false;
    match DType {
        DestructiveBinary => {
            DOPRegIsUnique = DstReg != MI.getOperand(SrcIdx).getReg();
        },
        DestructiveBinaryComm => {
            DestructiveBinaryCommWithRev;
        },
        DestructiveUnaryPassthru => {
            DestructiveBinaryImm;
        },
        DestructiveTernaryCommWithRev => {
            DOPRegIsUnique = DstReg != MI.getOperand(DOPIdx).getReg() || (MI.getOperand(DOPIdx).getReg() != MI.getOperand(SrcIdx).getReg() && MI.getOperand(DOPIdx).getReg() != MI.getOperand(Src2Idx).getReg());
        },
    }
    if UseRev {
        let mut NewOpcode: i32 = 0;
        if (NewOpcode = getSVERevInstr(Opcode)) != -1 {
            Opcode = NewOpcode;
        } else if (NewOpcode = getSVENonRevInstr(Opcode)) != -1 {
            Opcode = NewOpcode;
        }
    }
    let mut ElementSize: u64 = self.TII.getElementSizeForOpcode(Opcode);
    let mut MovPrfx: u32 = 0;
    let mut LSLZero: u32 = 0;
    let mut MovPrfxZero: u32 = 0;
    match ElementSize {
        ElementSizeNone => {
            ElementSizeB;
        },
        ElementSizeH => {
            
        },
        ElementSizeS => {
            
        },
        ElementSizeD => {
            
        },
        _ => {
            llvm_unreachable_internal("Unsupported ElementSize", "llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", 619);
        },
    }
    let mut DOPRegState: RegState = getUndefRegState(MI.getOperand(DOPIdx).isUndef());
    let mut PRFX: MachineInstrBuilder = MachineInstrBuilder {};
    let mut DOP: MachineInstrBuilder = MachineInstrBuilder {};
    if FalseZero {
        assert!((DOPRegIsUnique || DType == DestructiveBinary || DType == DestructiveBinaryComm || DType == DestructiveBinaryCommWithRev), "The destructive operand should be unique");
        assert!(ElementSize != ElementSizeNone, "This instruction is unpredicated");
        PRFX = BuildMI(MBB, MI.getDebugLoc(), self.TII(MovPrfxZero))(DstReg, Define)(MI.getOperand(PredIdx).getReg())(MI.getOperand(DOPIdx).getReg(), DOPRegState);
        DOPIdx = 0;
        DOPRegState = RegState {};
        if (DType == DestructiveBinary || DType == DestructiveBinaryComm || DType == DestructiveBinaryCommWithRev) && !DOPRegIsUnique {
            BuildMI(MBB, MI.getDebugLoc(), self.TII(LSLZero))(DstReg, Define)(MI.getOperand(PredIdx))(DstReg)(0);
        }
    } else if DstReg != MI.getOperand(DOPIdx).getReg() {
        assert!(DOPRegIsUnique, "The destructive operand should be unique");
        PRFX = BuildMI(MBB, MI.getDebugLoc(), self.TII(MovPrfx))(DstReg, Define)(MI.getOperand(DOPIdx).getReg(), DOPRegState);
        DOPIdx = 0;
        DOPRegState = RegState {};
    }
    DOP = BuildMI(MBB, MI.getDebugLoc(), self.TII(Opcode))(DstReg, Define(getDeadRegState(DstIsDead)));
    DOPRegState = DOPRegState(Kill);
    match DType {
        DestructiveUnaryPassthru => {
            DOP()(MI.getOperand(DOPIdx).getReg(), DOPRegState)(MI.getOperand(PredIdx))(MI.getOperand(SrcIdx));
        },
        DestructiveBinary => {
            DestructiveBinaryImm;
        },
        DestructiveTernaryCommWithRev => {
            DOP()(MI.getOperand(PredIdx))(MI.getOperand(DOPIdx).getReg(), DOPRegState)(MI.getOperand(SrcIdx))(MI.getOperand(Src2Idx));
        },
        DestructiveBinaryImmUnpred => {
            DOP()(MI.getOperand(DOPIdx).getReg(), DOPRegState)(MI.getOperand(SrcIdx));
        },
        DestructiveBinaryShImmUnpred => {
            Destructive2xRegImmUnpred;
        },
    }
    if PRFX.operator llvm::MachineInstr *() {
        transferImpOps(MI, PRFX, DOP);
        finalizeBundle(MBB, PRFX()());
    } else {
        transferImpOps(MI, DOP, DOP);
    }
    MI()();
    return true;
}

fn AArch64ExpandPseudoImpl::expandSVEBitwisePseudo(self, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, MBBI: i32) -> bool {
    let mut PRFX: MachineInstrBuilder = MachineInstrBuilder {};
    let mut DOP: MachineInstrBuilder = MachineInstrBuilder {};
    let mut Opcode: u32 = MI.getOpcode();
    let mut Op0: *MachineOperand = MI.getOperand(0);
    let mut Op1: *MachineOperand = &mut MI.getOperand(1);
    let mut Op2: *MachineOperand = &mut MI.getOperand(2);
    let mut DOPReg: Register = Op0.getReg();
    if DOPReg == Op2.getReg() {
        swap(Op1, Op2);
    } else if DOPReg != Op1.getReg() {
        PRFX = BuildMI(MBB, MI.getDebugLoc(), self.TII)(DOPReg, getRenamableRegState(Op0.isRenamable()))(Op1.getReg(), getRenamableRegState(Op1.isRenamable()) | getKillRegState());
    }
    assert!((DOPReg == Op1.getReg() || PRFX.operator llvm::MachineInstr *()), "invalid expansion");
    let mut DOPRegState: RegState = getRenamableRegState(Op0.isRenamable()) | Kill;
    match Opcode {
        _ => {
            llvm_unreachable_internal("unhandled opcode", "llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", 753);
        },
    }
    if PRFX.operator llvm::MachineInstr *() {
        transferImpOps(MI, PRFX, DOP);
        finalizeBundle(MBB, PRFX()());
    } else {
        transferImpOps(MI, DOP, DOP);
    }
    MI()();
    return true;
}

fn AArch64ExpandPseudoImpl::expandSetTagLoop(self, MBB: *mut MachineBasicBlock, MBBI: i32, NextMBBI: *mut i32) -> bool {
    let mut MI: *mut MachineInstr = operator*();
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut SizeReg: Register = MI.getOperand(0).getReg();
    let mut AddressReg: Register = MI.getOperand(1).getReg();
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut ZeroData: bool = false;
    let mut OpCode1: u32 = 0;
    let mut OpCode2: u32 = 0;
    let mut Size: u32 = MI.getOperand(2).getImm();
    assert!(Size > 0 && Size % 16 == 0);
    if Size % (16 * 2) != 0 {
        BuildMI(MBB, DL, self.TII(OpCode1), AddressReg)(AddressReg)(AddressReg)(1);
        Size -= 16;
    }
    let mut I: i32 = BuildMI(MBB, DL, self.TII, SizeReg)(Size);
    let mut LoopBB: auto = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    let mut DoneBB: auto = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt());
    MF()(MBB()() += 1);
    MF()(() += 1);
    BuildMI(DL, self.TII(OpCode2))(AddressReg)(AddressReg)(AddressReg)(2)(MI)(MI.getFlags());
    BuildMI(DL, self.TII)(SizeReg)(SizeReg)(16 * 2)(0);
    BuildMI(DL, self.TII)(NE)();
    LoopBB()();
    LoopBB()();
    DoneBB()(&mut MBB, MI, MBB()());
    DoneBB()(&mut MBB);
    MBB.addSuccessor();
    NextMBBI() = MBB()();
    MI()();
    let mut LiveRegs: LivePhysRegs = LivePhysRegs {};
    computeAndAddLiveIns(LiveRegs, operator*());
    computeAndAddLiveIns(LiveRegs, operator*());
    LoopBB()();
    computeAndAddLiveIns(LiveRegs, operator*());
    DoneBB()();
    computeAndAddLiveIns(LiveRegs, operator*());
    return true;
}

fn AArch64ExpandPseudoImpl::expandSVESpillFill(self, MBB: *mut MachineBasicBlock, MBBI: i32, Opc: u32, N: u32) -> bool {
    let mut RState: RegState = getDefRegState();
    let mut sub0: u32 = 0;
    let mut TRI: *TargetRegisterInfo = MBB.getParent().getSubtarget().getRegisterInfo();
    let mut MI: *mut MachineInstr = operator*();
    for let mut Offset: u32 = 0; Offset < N; Offset += 1 {
        let mut ImmOffset: i32 = MI.getOperand(2).getImm() + Offset;
        let mut Kill: bool = if (Offset + 1 == N) { MI.getOperand(1).isKill() } else { false };
        assert!(ImmOffset >= -256 && ImmOffset < 256, "Immediate spill offset out of range");
        BuildMI(MBB, MI.getDebugLoc(), self.TII(Opc))(TRI.getSubReg, RState)(MI.getOperand(1).getReg(), getKillRegState(Kill))(ImmOffset);
    }
    MI()();
    return true;
}

fn createCallWithOps(MBB: *mut MachineBasicBlock, MBBI: i32, TII: *AArch64InstrInfo, Opcode: u32, ExplicitOps: ArrayRef<MachineOperand>, RegMaskStartIdx: u32) -> *mut MachineInstr {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut Call: *mut MachineInstr = MF.CreateMachineInstr(TII()(Opcode), true);
    MBB()(Call);
    MachineInstrBuilder { MF: MF, MI: Call }();
    while operator!((RegMaskStartIdx)()) {
        let mut MOP: *MachineOperand = (RegMaskStartIdx);
        assert!(MOP.isReg(), "can only add register operands");
        Call.addOperand(CreateReg(MOP.getReg(), false, true, false, false, MOP.isUndef(), false, 0, false, false, false));
        RegMaskStartIdx += 1;
    }
    return Call;
}

fn createCall(MBB: *mut MachineBasicBlock, MBBI: i32, TII: *AArch64InstrInfo, CallTarget: *mut MachineOperand, RegMaskStartIdx: u32) -> *mut MachineInstr {
    let mut Opc: u32 = 0;
    assert!((CallTarget.isGlobal() || CallTarget.isReg()), "invalid operand for regular call");
}

fn AArch64ExpandPseudoImpl::expandCALL_RVMARKER(self, MBB: *mut MachineBasicBlock, MBBI: i32) -> bool {
    let mut MI: *mut MachineInstr = operator*();
    let mut RVTarget: *mut MachineOperand = MI.getOperand(0);
    let mut DoEmitMarker: bool = MI.getOperand(1).getImm();
    assert!(RVTarget.isGlobal(), "invalid operand for attached call");
    let mut OriginalCall: *mut MachineInstr = null;
    if  {
        let mut CallTarget: *MachineOperand = MI.getOperand(2);
        let mut Key: *MachineOperand = MI.getOperand(3);
        let mut IntDisc: *MachineOperand = MI.getOperand(4);
        let mut AddrDisc: *MachineOperand = MI.getOperand(5);
        assert!((Key.getImm() == IA || Key.getImm() == IB), "Invalid auth call key");
        let mut Ops: [4]MachineOperand = [CallTarget, Key, IntDisc, AddrDisc];
    } else {}
    if DoEmitMarker {
        BuildMI(MBB, MI.getDebugLoc(), self.TII)(0);
    }
    let mut RVCall: *mut auto = BuildMI(MBB, MI.getDebugLoc(), self.TII)(RVTarget)();
    if MI.shouldUpdateAdditionalCallInfo() {
        MBB.getParent().moveAdditionalCallInfo(&mut MI, OriginalCall);
    }
    MI()();
    finalizeBundle(MBB, OriginalCall()(), next());
    return true;
}

fn AArch64ExpandPseudoImpl::expandCALL_BTI(self, MBB: *mut MachineBasicBlock, MBBI: i32) -> bool {
    let mut MI: *mut MachineInstr = operator*();
    let mut Call: *mut MachineInstr = null;
    Call.setCFIType(*MBB.getParent(), MI.getCFIType());
    let mut BTI: *mut MachineInstr = BuildMI(MBB, MI.getDebugLoc(), self.TII)(36)();
    if MI.shouldUpdateAdditionalCallInfo() {
        MBB.getParent().moveAdditionalCallInfo(&mut MI, Call);
    }
    MI()();
    finalizeBundle(MBB, Call()(), next(BTI()()));
    return true;
}

fn AArch64ExpandPseudoImpl::expandStoreSwiftAsyncContext(self, MBB: *mut MachineBasicBlock, MBBI: i32) -> bool {
    let mut CtxReg: Register = (0)();
    let mut BaseReg: Register = (1)();
    let mut Offset: i32 = (2)();
    let mut DL: DebugLoc = MBBI()();
    let mut STI: *mut auto = MBB.getParent();
    if STI()()() != "arm64e" {
        BuildMI(MBB, DL, self.TII)(CtxReg)(BaseReg)(Offset / 8)(FrameSetup);
        MBBI()();
        return true;
    }
    let mut Opc: u32 = 0;
    BuildMI(MBB, DL, self.TII(Opc))(BaseReg)(if Offset < 0 { -Offset } else { Offset })(0)(FrameSetup);
    BuildMI(MBB, DL, self.TII)(49946)(48)(FrameSetup);
    BuildMI(MBB, DL, self.TII)(CtxReg)(0)(FrameSetup);
    BuildMI(MBB, DL, self.TII)(FrameSetup);
    BuildMI(MBB, DL, self.TII)(BaseReg)(Offset / 8)(FrameSetup);
    MBBI()();
    return true;
}

fn AArch64ExpandPseudoImpl::expandConditionalPseudo(self, MBB: *mut MachineBasicBlock, MBBI: i32, DL: DebugLoc, Branch: *mut MachineInstrBuilder) -> ConditionalBlocks {
    (((operator!(operator!(((next() != MBB()() || MBB()()() != MBB()()()) && "Unexpected unreachable in block")))) || (_wassert(L"(std::next(MBBI) != MBB.end() || MBB.successors().begin() != MBB.successors().end()) && \"Unexpected unreachable in block\"", L"llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", (1090) as u32) , 0)) as void);
    let mut PrevMI: *mut MachineInstr = operator*(prev());
    let mut CondBB: *mut MachineBasicBlock = MBB.splitAt(PrevMI, true, null);
    let mut EndBB: *mut MachineBasicBlock = if next() == CondBB()() { operator*(CondBB()()()) } else { CondBB.splitAt(operator*(), true) };
    Branch()(CondBB);
    BuildMI(&mut MBB, DL, self.TII)(EndBB);
    MBB.addSuccessor(EndBB, getUnknown());
    BuildMI(CondBB, DL, self.TII)(EndBB);
    return ConditionalBlocks { *CondBB, *EndBB };
}

fn AArch64ExpandPseudoImpl::expandRestoreZASave(self, MBB: *mut MachineBasicBlock, MBBI: i32) -> *mut MachineBasicBlock {
    let mut MI: *mut MachineInstr = operator*();
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut Branch: MachineInstrBuilder = BuildMI(MBB, DL, self.TII)(MI.getOperand(0));
    let mut MIB: MachineInstrBuilder = BuildMI(DL, self.TII);
    for let mut I: u32 = 2; I < MI.getNumOperands(); I += 1 {
        MIB()(MI.getOperand(I));
    }
    MIB()(MI.getOperand(1).getReg(), Implicit);
    MI()();
    return operator&();
}

const ZERO_ALL_ZA_MASK: u32 = 255;

fn AArch64ExpandPseudoImpl::expandCommitZASave(self, MBB: *mut MachineBasicBlock, MBBI: i32) -> *mut MachineBasicBlock {
    let mut MI: *mut MachineInstr = operator*();
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut RI: *TargetRegisterInfo = MBB.getParent().getSubtarget().getRegisterInfo();
    let mut Branch: MachineInstrBuilder = BuildMI(MBB, DL, self.TII)(MI.getOperand(0));
    let mut MIB: MachineInstrBuilder = BuildMI(DL, self.TII);
    for let mut I: u32 = 3; I < MI.getNumOperands(); I += 1 {
        MIB()(MI.getOperand(I));
    }
    BuildMI(DL, self.TII);
    let mut ZeroZA: bool = MI.getOperand(1).getImm() != 0;
    let mut ZeroZT0: bool = MI.getOperand(2).getImm() != 0;
    if ZeroZA {
        (((operator!(operator!((MI.definesRegister && "should define ZA!")))) || (_wassert(L"MI.definesRegister(AArch64::ZAB0, RI) && \"should define ZA!\"", L"llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", (1166) as u32) , 0)) as void);
        BuildMI(DL, self.TII)(ZERO_ALL_ZA_MASK);
    }
    if ZeroZT0 {
        (((operator!(operator!((MI.definesRegister && "should define ZT0!")))) || (_wassert(L"MI.definesRegister(AArch64::ZT0, RI) && \"should define ZT0!\"", L"llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", (1172) as u32) , 0)) as void);
        BuildMI(DL, self.TII);
    }
    MI()();
    return operator&();
}

fn AArch64ExpandPseudoImpl::expandCondSMToggle(self, MBB: *mut MachineBasicBlock, MBBI: i32) -> *mut MachineBasicBlock {
    let mut MI: *mut MachineInstr = operator*();
    if next() == MBB()() && MI.getParent()()() == MI.getParent()()() {
        MI()();
        return &mut MBB;
    }
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut Opc: u32 = 0;
    match MI.getOperand(2).getImm() {
        Always => {
            llvm_unreachable_internal("Should have matched to instruction directly", "llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", 1238);
        },
        IfCallerIsStreaming => {
            
        },
        IfCallerIsNonStreaming => {
            
        },
    }
    let mut PStateSM: auto = MI.getOperand(3).getReg();
    let mut TRI: *TargetRegisterInfo = MBB.getParent().getSubtarget().getRegisterInfo();
    let mut SMReg32: u32 = TRI.getSubReg;
    let mut Tbx: MachineInstrBuilder = BuildMI(MBB, DL, self.TII(Opc))(SMReg32)(0);
    let mut MIB: MachineInstrBuilder = BuildMI(MI.getDebugLoc(), self.TII);
    MIB()(MI.getOperand(0));
    MIB()(MI.getOperand(1));
    for let mut i: u32 = 4; i < MI.getNumOperands(); i += 1 {
        MIB()(MI.getOperand(i));
    }
    MI()();
    return operator&();
}

fn AArch64ExpandPseudoImpl::expandMultiVecPseudo(self, MBB: *mut MachineBasicBlock, MBBI: i32, ContiguousClass: *TargetRegisterClass, StridedClass: *TargetRegisterClass, ContiguousOp: u32, StridedOpc: u32) -> bool {
    let mut MI: *mut MachineInstr = operator*();
    let mut Tuple: Register = MI.getOperand(0).getReg();
    let mut ContiguousRange: ArrayRef<MCPhysReg> = ContiguousClass.getRegisters();
    let mut StridedRange: ArrayRef<MCPhysReg> = StridedClass.getRegisters();
    let mut Opc: u32 = 0;
    if is_contained(ContiguousRange, Tuple.asMCReg()) {
        Opc = ContiguousOp;
    } else if is_contained(StridedRange, Tuple.asMCReg()) {
        Opc = StridedOpc;
    } else {
        llvm_unreachable_internal("Cannot expand Multi-Vector pseudo", "llvm\\lib\\Target\\AArch64\\AArch64ExpandPseudoInsts.cpp", 1284);
    }
    let mut MIB: MachineInstrBuilder = BuildMI(MBB, MI.getDebugLoc(), self.TII(Opc))(MI.getOperand(0))(MI.getOperand(1))(MI.getOperand(2))(MI.getOperand(3));
    transferImpOps(MI, MIB, MIB);
    MI()();
    return true;
}

fn AArch64ExpandPseudoImpl::expandCopyIntoTuplePseudo(self, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, MBBI: i32) -> bool {
    let mut Src: Register = MI.getOperand(1).getReg();
    let mut Dest: Register = MI.getOperand(0).getReg();
    if Src != Dest {
        BuildMI(MBB, MI.getDebugLoc(), self.TII)(Dest, Define)(Src)(Src);
    }
    MI()();
    return true;
}

fn AArch64ExpandPseudoImpl::expandMI(self, MBB: *mut MachineBasicBlock, MBBI: i32, NextMBBI: *mut i32) -> bool {
    let mut MI: *mut MachineInstr = operator*();
    let mut Opcode: u32 = MI.getOpcode();
    let mut OrigInstr: i32 = getSVEPseudoMap(MI.getOpcode());
    if OrigInstr != -1 {
        let mut Orig: *mut auto = self.TII(OrigInstr);
        if (Orig() & DestructiveInstTypeMask) != NotDestructive {}
    }
    match Opcode {
        _ => {
            break;
        },
    }
    return false;
}

fn AArch64ExpandPseudoImpl::expandMBB(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Modified: bool = false;
    let mut MBBI: i32 = MBB()();
    while  {
