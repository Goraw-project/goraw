struct AArch64ExpandPseudoImpl {
    TII: *AArch64InstrInfo,
}

struct AArch64ExpandPseudoLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64ExpandPseudoLegacy::getPassName(self: *AArch64ExpandPseudoLegacy) -> str {
    return "AArch64 pseudo instruction expansion pass";
}

fn AArch64ExpandPseudoLegacy::getPassKind(self: *AArch64ExpandPseudoLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64ExpandPseudoLegacy::getPassID(self: *AArch64ExpandPseudoLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64ExpandPseudoLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64ExpandPseudoLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64ExpandPseudoLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64ExpandPseudoLegacy::getResolver(self: *AArch64ExpandPseudoLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64ExpandPseudoLegacy::getRequiredProperties(self: *AArch64ExpandPseudoLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64ExpandPseudoLegacy::getSetProperties(self: *AArch64ExpandPseudoLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64ExpandPseudoLegacy::getClearedProperties(self: *AArch64ExpandPseudoLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn transferImpOps(OldMI: *mut MachineInstr, UseMI: *mut MachineInstrBuilder, DefMI: *mut MachineInstrBuilder) {
    let mut Desc: *MCInstrDesc = OldMI.getDesc();
    for MO in drop_begin(OldMI.operands(), Desc.getNumOperands()) {
        assert!(MO.isReg() && MO.getReg().operator unsigned int();
        if MO.isUse() {
            UseMI.add(MO);
        } else {
            DefMI.add(MO);
        }
    }
}

fn AArch64ExpandPseudoImpl::expandMOVImm(self, MBB: *mut MachineBasicBlock, MBBI: iterator, BitSize: u32) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut DstReg: Register = MI.getOperand(0).getReg();
    let mut RenamableState: RegState = getRenamableRegState(MI.getOperand(0).isRenamable());
    let mut Imm: u64 = MI.getOperand(1).getImm();
    if DstReg == XZR || DstReg == WZR {
        MI.eraseFromParent();
        return true;
    }
    let mut Insn: ImmInsnModel, 4> = ImmInsnModel, 4> {};
    expandMOVImm(Imm, BitSize, Insn);
    assert!(Insn.len != 0);
    let mut MIBS: SmallVector<MachineInstrBuilder, 4> = SmallVector<MachineInstrBuilder, 4> {};
    for let mut I: iterator = Insn.begin();
let mut E: iterator = Insn.end(); I != E; I += 1 {
        let mut LastItem: bool = next(I, 1) == E;
        match I.Opcode {
            _ => {
                llvm_unreachable_internal("unhandled!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ExpandPseudoInsts.cpp", 165);
            },
            ORRWri => {
                ORRXri;
            },
            EONXrs => {
                EORXrs;
            },
            MOVNWi => {
                MOVNXi;
            },
            MOVKWi => {
                MOVKXi;
            },
        }
    }
    transferImpOps(MI, MIBS.front(), MIBS.back());
    MI.eraseFromParent();
    return true;
}

fn AArch64ExpandPseudoImpl::expandCMP_SWAP(self, MBB: *mut MachineBasicBlock, MBBI: iterator, LdarOp: u32, StlrOp: u32, CmpOp: u32, ExtendImm: u32, ZeroReg: u32, NextMBBI: *mut iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut MIMD: MIMetadata = MI;
    let mut Dest: *MachineOperand = MI.getOperand(0);
    let mut StatusReg: Register = MI.getOperand(1).getReg();
    let mut StatusDead: bool = MI.getOperand(1).isDead();
    assert!(!MI.getOperand(2).isUndef(), "cannot handle undef");
    let mut AddrReg: Register = MI.getOperand(2).getReg();
    let mut DesiredReg: Register = MI.getOperand(3).getReg();
    let mut NewReg: Register = MI.getOperand(4).getReg();
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut LoadCmpBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    let mut StoreBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    let mut DoneBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(operator(MBB.getIterator()), LoadCmpBB);
    MF.insert(operator(LoadCmpBB.getIterator()), StoreBB);
    MF.insert(operator(StoreBB.getIterator()), DoneBB);
    if !StatusDead {
        BuildMI(LoadCmpBB, MIMD, self.TII.get(MOVZWi), StatusReg).addImm(0).addImm(0);
    }
    BuildMI(LoadCmpBB, MIMD, self.TII.get(LdarOp), Dest.getReg()).addReg(AddrReg, RegState {}, 0);
    BuildMI(LoadCmpBB, MIMD, self.TII.get(CmpOp), ZeroReg).addReg(Dest.getReg(), getKillRegState(Dest.isDead()), 0).addReg(DesiredReg, RegState {}, 0).addImm(ExtendImm);
    BuildMI(LoadCmpBB, MIMD, self.TII.get(Bcc)).addImm(NE).addMBB(DoneBB, 0).addReg(NZCV, Implicit | Kill, 0);
    LoadCmpBB.addSuccessor(DoneBB, getUnknown());
    LoadCmpBB.addSuccessor(StoreBB, getUnknown());
    BuildMI(StoreBB, MIMD, self.TII.get(StlrOp), StatusReg).addReg(NewReg, RegState {}, 0).addReg(AddrReg, RegState {}, 0);
    BuildMI(StoreBB, MIMD, self.TII.get(CBNZW)).addReg(StatusReg, getKillRegState(StatusDead), 0).addMBB(LoadCmpBB, 0);
    StoreBB.addSuccessor(LoadCmpBB, getUnknown());
    StoreBB.addSuccessor(DoneBB, getUnknown());
    DoneBB.splice(DoneBB.end(), &mut MBB, MI, MBB.end());
    DoneBB.transferSuccessors(&mut MBB);
    MBB.addSuccessor(LoadCmpBB, getUnknown());
    NextMBBI = MBB.end();
    MI.eraseFromParent();
    let mut LiveRegs: LivePhysRegs = LivePhysRegs {};
    computeAndAddLiveIns(LiveRegs, *DoneBB);
    computeAndAddLiveIns(LiveRegs, *StoreBB);
    computeAndAddLiveIns(LiveRegs, *LoadCmpBB);
    StoreBB.clearLiveIns();
    computeAndAddLiveIns(LiveRegs, *StoreBB);
    LoadCmpBB.clearLiveIns();
    computeAndAddLiveIns(LiveRegs, *LoadCmpBB);
    return true;
}

fn AArch64ExpandPseudoImpl::expandCMP_SWAP_128(self, MBB: *mut MachineBasicBlock, MBBI: iterator, NextMBBI: *mut iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut MIMD: MIMetadata = MI;
    let mut DestLo: *mut MachineOperand = MI.getOperand(0);
    let mut DestHi: *mut MachineOperand = MI.getOperand(1);
    let mut StatusReg: Register = MI.getOperand(2).getReg();
    let mut StatusDead: bool = MI.getOperand(2).isDead();
    assert!(!MI.getOperand(3).isUndef(), "cannot handle undef");
    let mut AddrReg: Register = MI.getOperand(3).getReg();
    let mut DesiredLoReg: Register = MI.getOperand(4).getReg();
    let mut DesiredHiReg: Register = MI.getOperand(5).getReg();
    let mut NewLoReg: Register = MI.getOperand(6).getReg();
    let mut NewHiReg: Register = MI.getOperand(7).getReg();
    let mut STI: *AArch64Subtarget = MBB.getParent().getSubtarget();
    let mut LittleEndian: bool = STI.isLittleEndian();
    let mut Dest0: *mut MachineOperand = if LittleEndian { DestLo } else { DestHi };
    let mut Dest1: *mut MachineOperand = if LittleEndian { DestHi } else { DestLo };
    let mut New0Reg: Register = if LittleEndian { NewLoReg } else { NewHiReg };
    let mut New1Reg: Register = if LittleEndian { NewHiReg } else { NewLoReg };
    let mut LdxpOp: u32 = 0;
    let mut StxpOp: u32 = 0;
    match MI.getOpcode() {
        CMP_SWAP_128_MONOTONIC => {
            LdxpOp = LDXPX;
        },
        CMP_SWAP_128_RELEASE => {
            LdxpOp = LDXPX;
        },
        CMP_SWAP_128_ACQUIRE => {
            LdxpOp = LDAXPX;
        },
        CMP_SWAP_128 => {
            LdxpOp = LDAXPX;
        },
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ExpandPseudoInsts.cpp", 361);
        },
    }
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut LoadCmpBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    let mut StoreBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    let mut FailBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    let mut DoneBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(operator(MBB.getIterator()), LoadCmpBB);
    MF.insert(operator(LoadCmpBB.getIterator()), StoreBB);
    MF.insert(operator(StoreBB.getIterator()), FailBB);
    MF.insert(operator(FailBB.getIterator()), DoneBB);
    BuildMI(LoadCmpBB, MIMD, self.TII.get(LdxpOp)).addReg(Dest0.getReg(), Define, 0).addReg(Dest1.getReg(), Define, 0).addReg(AddrReg, RegState {}, 0);
    BuildMI(LoadCmpBB, MIMD, self.TII.get(SUBSXrs), XZR).addReg(DestLo.getReg(), getKillRegState(DestLo.isDead()), 0).addReg(DesiredLoReg, RegState {}, 0).addImm(0);
    BuildMI(LoadCmpBB, MIMD, self.TII.get(CSINCWr), StatusReg).addUse(WZR, RegState {}, 0).addUse(WZR, RegState {}, 0).addImm(EQ);
    BuildMI(LoadCmpBB, MIMD, self.TII.get(SUBSXrs), XZR).addReg(DestHi.getReg(), getKillRegState(DestHi.isDead()), 0).addReg(DesiredHiReg, RegState {}, 0).addImm(0);
    BuildMI(LoadCmpBB, MIMD, self.TII.get(CSINCWr), StatusReg).addUse(StatusReg, Kill, 0).addUse(StatusReg, Kill, 0).addImm(EQ);
    BuildMI(LoadCmpBB, MIMD, self.TII.get(CBNZW)).addUse(StatusReg, getKillRegState(StatusDead), 0).addMBB(FailBB, 0);
    LoadCmpBB.addSuccessor(FailBB, getUnknown());
    LoadCmpBB.addSuccessor(StoreBB, getUnknown());
    BuildMI(StoreBB, MIMD, self.TII.get(StxpOp), StatusReg).addReg(New0Reg, RegState {}, 0).addReg(New1Reg, RegState {}, 0).addReg(AddrReg, RegState {}, 0);
    BuildMI(StoreBB, MIMD, self.TII.get(CBNZW)).addReg(StatusReg, getKillRegState(StatusDead), 0).addMBB(LoadCmpBB, 0);
    BuildMI(StoreBB, MIMD, self.TII.get(B)).addMBB(DoneBB, 0);
    StoreBB.addSuccessor(LoadCmpBB, getUnknown());
    StoreBB.addSuccessor(DoneBB, getUnknown());
    BuildMI(FailBB, MIMD, self.TII.get(StxpOp), StatusReg).addReg(Dest0.getReg(), RegState {}, 0).addReg(Dest1.getReg(), RegState {}, 0).addReg(AddrReg, RegState {}, 0);
    BuildMI(FailBB, MIMD, self.TII.get(CBNZW)).addReg(StatusReg, getKillRegState(StatusDead), 0).addMBB(LoadCmpBB, 0);
    FailBB.addSuccessor(LoadCmpBB, getUnknown());
    FailBB.addSuccessor(DoneBB, getUnknown());
    DoneBB.splice(DoneBB.end(), &mut MBB, MI, MBB.end());
    DoneBB.transferSuccessors(&mut MBB);
    MBB.addSuccessor(LoadCmpBB, getUnknown());
    NextMBBI = MBB.end();
    MI.eraseFromParent();
    let mut LiveRegs: LivePhysRegs = LivePhysRegs {};
    computeAndAddLiveIns(LiveRegs, *DoneBB);
    computeAndAddLiveIns(LiveRegs, *FailBB);
    computeAndAddLiveIns(LiveRegs, *StoreBB);
    computeAndAddLiveIns(LiveRegs, *LoadCmpBB);
    FailBB.clearLiveIns();
    computeAndAddLiveIns(LiveRegs, *FailBB);
    StoreBB.clearLiveIns();
    computeAndAddLiveIns(LiveRegs, *StoreBB);
    LoadCmpBB.clearLiveIns();
    computeAndAddLiveIns(LiveRegs, *LoadCmpBB);
    return true;
}

fn AArch64ExpandPseudoImpl::expand_DestructiveOp(self, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, MBBI: iterator) -> bool {
    let mut Opcode: u32 = getSVEPseudoMap(MI.getOpcode());
    let mut DType: u64 = self.TII.get(Opcode).TSFlags & DestructiveInstTypeMask;
    let mut FalseLanes: u64 = MI.getDesc().TSFlags & FalseLanesMask;
    let mut FalseZero: bool = FalseLanes == FalseLanesZero;
    let mut DstReg: Register = MI.getOperand(0).getReg();
    let mut DstIsDead: bool = MI.getOperand(0).isDead();
    let mut UseRev: bool = false;
    let mut PredIdx: u32 = 0;
    let mut DOPIdx: u32 = 0;
    let mut SrcIdx: u32 = 0;
    let mut Src2Idx: u32 = 0;
    match DType {
        DestructiveBinaryComm => {
            DestructiveBinaryCommWithRev;
        },
        DestructiveBinary => {
            DestructiveBinaryImm;
        },
        DestructiveUnaryPassthru => {
            tie(PredIdx, DOPIdx, SrcIdx) = make_tuple(2, 3, 3);
        },
        DestructiveTernaryCommWithRev => {
            tie(PredIdx, DOPIdx, SrcIdx, Src2Idx) = make_tuple(1, 2, 3, 4);
        },
        Destructive2xRegImmUnpred => {
            tie(DOPIdx, SrcIdx, Src2Idx) = make_tuple(1, 1, 2);
        },
        DestructiveBinaryImmUnpred => {
            tie(DOPIdx, SrcIdx) = make_tuple(1, 2);
        },
        DestructiveBinaryShImmUnpred => {
            tie(DOPIdx, SrcIdx, Src2Idx) = make_tuple(1, 2, 3);
        },
        _ => {
            llvm_unreachable_internal("Unsupported Destructive Operand type", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ExpandPseudoInsts.cpp", 550);
        },
    }
    let mut DOPRegIsUnique: bool = false;
    match DType {
        DestructiveBinary => {
            DOPRegIsUnique = DstReg != MI.getOperand(SrcIdx).getReg();
        },
        DestructiveBinaryComm => {
            DestructiveBinaryCommWithRev;
        },
        DestructiveUnaryPassthru => {
            DestructiveBinaryImm;
        },
        DestructiveTernaryCommWithRev => {
            DOPRegIsUnique = DstReg != MI.getOperand(DOPIdx).getReg() || (MI.getOperand(DOPIdx).getReg() != MI.getOperand(SrcIdx).getReg() && MI.getOperand(DOPIdx).getReg() != MI.getOperand(Src2Idx).getReg());
        },
    }
    if UseRev {
        let mut NewOpcode: i32 = 0;
        if (NewOpcode = getSVERevInstr(Opcode)) != -1 {
            Opcode = NewOpcode;
        } else if (NewOpcode = getSVENonRevInstr(Opcode)) != -1 {
            Opcode = NewOpcode;
        }
    }
    let mut ElementSize: u64 = self.TII.getElementSizeForOpcode(Opcode);
    let mut MovPrfx: u32 = 0;
    let mut LSLZero: u32 = 0;
    let mut MovPrfxZero: u32 = 0;
    match ElementSize {
        ElementSizeNone => {
            ElementSizeB;
        },
        ElementSizeH => {
            MovPrfx = MOVPRFX_ZZ;
        },
        ElementSizeS => {
            MovPrfx = MOVPRFX_ZZ;
        },
        ElementSizeD => {
            MovPrfx = MOVPRFX_ZZ;
        },
        _ => {
            llvm_unreachable_internal("Unsupported ElementSize", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ExpandPseudoInsts.cpp", 619);
        },
    }
    let mut DOPRegState: RegState = getUndefRegState(MI.getOperand(DOPIdx).isUndef());
    let mut PRFX: MachineInstrBuilder = MachineInstrBuilder {};
    let mut DOP: MachineInstrBuilder = MachineInstrBuilder {};
    if FalseZero {
        assert!((DOPRegIsUnique || DType == DestructiveBinary || DType == DestructiveBinaryComm || DType == DestructiveBinaryCommWithRev), "The destructive operand should be unique");
        assert!(ElementSize != ElementSizeNone, "This instruction is unpredicated");
        PRFX = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MovPrfxZero)).addReg(DstReg, Define, 0).addReg(MI.getOperand(PredIdx).getReg(), RegState {}, 0).addReg(MI.getOperand(DOPIdx).getReg(), DOPRegState, 0);
        DOPIdx = 0;
        DOPRegState = RegState {};
        if (DType == DestructiveBinary || DType == DestructiveBinaryComm || DType == DestructiveBinaryCommWithRev) && !DOPRegIsUnique {
            BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LSLZero)).addReg(DstReg, Define, 0).add(MI.getOperand(PredIdx)).addReg(DstReg, RegState {}, 0).addImm(0);
        }
    } else if DstReg != MI.getOperand(DOPIdx).getReg() {
        assert!(DOPRegIsUnique, "The destructive operand should be unique");
        PRFX = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MovPrfx)).addReg(DstReg, Define, 0).addReg(MI.getOperand(DOPIdx).getReg(), DOPRegState, 0);
        DOPIdx = 0;
        DOPRegState = RegState {};
    }
    DOP = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Opcode)).addReg(DstReg, Define | getDeadRegState(DstIsDead), 0);
    DOPRegState = DOPRegState | Kill;
    match DType {
        DestructiveUnaryPassthru => {
            DOP.addReg(MI.getOperand(DOPIdx).getReg(), DOPRegState, 0).add(MI.getOperand(PredIdx)).add(MI.getOperand(SrcIdx));
        },
        DestructiveBinary => {
            DestructiveBinaryImm;
        },
        DestructiveTernaryCommWithRev => {
            DOP.add(MI.getOperand(PredIdx)).addReg(MI.getOperand(DOPIdx).getReg(), DOPRegState, 0).add(MI.getOperand(SrcIdx)).add(MI.getOperand(Src2Idx));
        },
        DestructiveBinaryImmUnpred => {
            DOP.addReg(MI.getOperand(DOPIdx).getReg(), DOPRegState, 0).add(MI.getOperand(SrcIdx));
        },
        DestructiveBinaryShImmUnpred => {
            Destructive2xRegImmUnpred;
        },
    }
    if PRFX.operator llvm::MachineInstr *() {
        transferImpOps(MI, PRFX, DOP);
        finalizeBundle(MBB, operator(PRFX).getIterator(), operator(MBBI).getIterator());
    } else {
        transferImpOps(MI, DOP, DOP);
    }
    MI.eraseFromParent();
    return true;
}

fn AArch64ExpandPseudoImpl::expandSVEBitwisePseudo(self, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, MBBI: iterator) -> bool {
    let mut PRFX: MachineInstrBuilder = MachineInstrBuilder {};
    let mut DOP: MachineInstrBuilder = MachineInstrBuilder {};
    let mut Opcode: u32 = MI.getOpcode();
    let mut Op0: *MachineOperand = MI.getOperand(0);
    let mut Op1: *MachineOperand = &mut MI.getOperand(1);
    let mut Op2: *MachineOperand = &mut MI.getOperand(2);
    let mut DOPReg: Register = Op0.getReg();
    if DOPReg == Op2.getReg() {
        swap(Op1, Op2);
    } else if DOPReg != Op1.getReg() {
        PRFX = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MOVPRFX_ZZ)).addDef(DOPReg, getRenamableRegState(Op0.isRenamable()), 0).addReg(Op1.getReg(), getRenamableRegState(Op1.isRenamable()) | getUndefRegState(Op1.isUndef()) | getKillRegState(Op1.isKill() && Opcode == NAND_ZZZ), 0);
    }
    assert!((DOPReg == Op1.getReg() || PRFX.operator llvm::MachineInstr *()), "invalid expansion");
    let mut DOPRegState: RegState = getRenamableRegState(Op0.isRenamable()) | getUndefRegState(!PRFX.operator llvm::MachineInstr *() && Op1.isUndef()) | Kill;
    match Opcode {
        _ => {
            llvm_unreachable_internal("unhandled opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ExpandPseudoInsts.cpp", 753);
        },
        EON_ZZZ => {
            DOP = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(BSL2N_ZZZZ)).add(Op0).addReg(DOPReg, DOPRegState, 0).add(*Op1).add(*Op2);
        },
        NAND_ZZZ => {
            DOP = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NBSL_ZZZZ)).add(Op0).addReg(DOPReg, DOPRegState, 0).add(*Op2).add(*Op2);
        },
        NOR_ZZZ => {
            DOP = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(NBSL_ZZZZ)).add(Op0).addReg(DOPReg, DOPRegState, 0).add(*Op2).add(*Op1);
        },
    }
    if PRFX.operator llvm::MachineInstr *() {
        transferImpOps(MI, PRFX, DOP);
        finalizeBundle(MBB, operator(PRFX).getIterator(), operator(MBBI).getIterator());
    } else {
        transferImpOps(MI, DOP, DOP);
    }
    MI.eraseFromParent();
    return true;
}

fn AArch64ExpandPseudoImpl::expandSetTagLoop(self, MBB: *mut MachineBasicBlock, MBBI: iterator, NextMBBI: *mut iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut SizeReg: Register = MI.getOperand(0).getReg();
    let mut AddressReg: Register = MI.getOperand(1).getReg();
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut ZeroData: bool = MI.getOpcode() == STZGloop_wback;
    let mut OpCode1: u32 = if ZeroData { STZGPostIndex } else { STGPostIndex };
    let mut OpCode2: u32 = if ZeroData { STZ2GPostIndex } else { ST2GPostIndex };
    let mut Size: u32 = MI.getOperand(2).getImm();
    assert!(Size > 0 && Size % 16 == 0);
    if Size % (16 * 2) != 0 {
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(OpCode1), AddressReg).addReg(AddressReg, RegState {}, 0).addReg(AddressReg, RegState {}, 0).addImm(1);
        Size -= 16;
    }
    let mut I: iterator = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MOVi64imm), SizeReg).addImm(Size).operator MachineInstrBundleIterator();
    self.expandMOVImm(MBB, I, 64);
    let mut LoopBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    let mut DoneBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(operator(MBB.getIterator()), LoopBB);
    MF.insert(operator(LoopBB.getIterator()), DoneBB);
    BuildMI(LoopBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(OpCode2)).addDef(AddressReg, RegState {}, 0).addReg(AddressReg, RegState {}, 0).addReg(AddressReg, RegState {}, 0).addImm(2).cloneMemRefs(MI).setMIFlags(MI.getFlags());
    BuildMI(LoopBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SUBSXri)).addDef(SizeReg, RegState {}, 0).addReg(SizeReg, RegState {}, 0).addImm(16 * 2).addImm(0);
    BuildMI(LoopBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Bcc)).addImm(NE).addMBB(LoopBB, 0).addReg(NZCV, Implicit | Kill, 0);
    LoopBB.addSuccessor(LoopBB, getUnknown());
    LoopBB.addSuccessor(DoneBB, getUnknown());
    DoneBB.splice(DoneBB.end(), &mut MBB, MI, MBB.end());
    DoneBB.transferSuccessors(&mut MBB);
    MBB.addSuccessor(LoopBB, getUnknown());
    NextMBBI = MBB.end();
    MI.eraseFromParent();
    let mut LiveRegs: LivePhysRegs = LivePhysRegs {};
    computeAndAddLiveIns(LiveRegs, *DoneBB);
    computeAndAddLiveIns(LiveRegs, *LoopBB);
    LoopBB.clearLiveIns();
    computeAndAddLiveIns(LiveRegs, *LoopBB);
    DoneBB.clearLiveIns();
    computeAndAddLiveIns(LiveRegs, *DoneBB);
    return true;
}

fn AArch64ExpandPseudoImpl::expandSVESpillFill(self, MBB: *mut MachineBasicBlock, MBBI: iterator, Opc: u32, N: u32) -> bool {
    assert!((Opc == LDR_ZXI || Opc == STR_ZXI || Opc == LDR_PXI || Opc == STR_PXI), "Unexpected opcode");
    let mut RState: RegState = getDefRegState(Opc == LDR_ZXI || Opc == LDR_PXI);
    let mut sub0: u32 = if (Opc == LDR_ZXI || Opc == STR_ZXI) { zsub0 } else { psub0 };
    let mut TRI: *TargetRegisterInfo = MBB.getParent().getSubtarget().getRegisterInfo();
    let mut MI: *mut MachineInstr = operator(MBBI);
    for let mut Offset: u32 = 0; Offset < N; Offset += 1 {
        let mut ImmOffset: i32 = MI.getOperand(2).getImm() + Offset;
        let mut Kill: bool = if (Offset + 1 == N) { MI.getOperand(1).isKill() } else { false };
        assert!(ImmOffset >= -256 && ImmOffset < 256, "Immediate spill offset out of range");
        BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Opc)).addReg(TRI.getSubReg(MI.getOperand(0).getReg().operator MCRegister(), sub0 + Offset), RState, 0).addReg(MI.getOperand(1).getReg(), getKillRegState(Kill), 0).addImm(ImmOffset);
    }
    MI.eraseFromParent();
    return true;
}

fn createCallWithOps(MBB: *mut MachineBasicBlock, MBBI: iterator, TII: *AArch64InstrInfo, Opcode: u32, ExplicitOps: ArrayRef<MachineOperand>, RegMaskStartIdx: u32) -> *mut MachineInstr {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut Call: *mut MachineInstr = MF.CreateMachineInstr(TII.get(Opcode), operator(MBBI).getDebugLoc(), true);
    MBB.insert(MBBI, Call);
    MachineInstrBuilder { MF: MF, MI: Call }.add(ExplicitOps);
    while !operator(MBBI).getOperand(RegMaskStartIdx).isRegMask() {
        let mut MOP: *MachineOperand = operator(MBBI).getOperand(RegMaskStartIdx);
        assert!(MOP.isReg(), "can only add register operands");
        Call.addOperand(CreateReg(MOP.getReg(), false, true, false, false, MOP.isUndef(), false, 0, false, false, false));
        RegMaskStartIdx += 1;
    }
    for MO in drop_begin(operator(MBBI).operands(), RegMaskStartIdx) {
        Call.addOperand(MO);
    }
    return Call;
}

fn createCall(MBB: *mut MachineBasicBlock, MBBI: iterator, TII: *AArch64InstrInfo, CallTarget: *mut MachineOperand, RegMaskStartIdx: u32) -> *mut MachineInstr {
    let mut Opc: u32 = if CallTarget.isGlobal() { BL } else { BLR };
    assert!((CallTarget.isGlobal() || CallTarget.isReg()), "invalid operand for regular call");
    return createCallWithOps(MBB, MBBI, TII, Opc, CallTarget, RegMaskStartIdx);
}

fn AArch64ExpandPseudoImpl::expandCALL_RVMARKER(self, MBB: *mut MachineBasicBlock, MBBI: iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut RVTarget: *mut MachineOperand = MI.getOperand(0);
    let mut DoEmitMarker: bool = MI.getOperand(1).getImm();
    assert!(RVTarget.isGlobal(), "invalid operand for attached call");
    let mut OriginalCall: *mut MachineInstr = null;
    if MI.getOpcode() == BLRA_RVMARKER {
        let mut CallTarget: *MachineOperand = MI.getOperand(2);
        let mut Key: *MachineOperand = MI.getOperand(3);
        let mut IntDisc: *MachineOperand = MI.getOperand(4);
        let mut AddrDisc: *MachineOperand = MI.getOperand(5);
        assert!((Key.getImm() == IA || Key.getImm() == IB), "Invalid auth call key");
        let mut Ops: [4]MachineOperand = [CallTarget, Key, IntDisc, AddrDisc];
        OriginalCall = createCallWithOps(MBB, MBBI, self.TII, BLRA, Ops, 6);
    } else {
        assert!(MI.getOpcode() == BLR_RVMARKER, "unknown rvmarker MI");
        OriginalCall = createCall(MBB, MBBI, self.TII, MI.getOperand(2), 3);
    }
    if DoEmitMarker {
        BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ORRXrs)).addReg(FP, Define, 0).addReg(XZR, RegState {}, 0).addReg(FP, RegState {}, 0).addImm(0);
    }
    let mut RVCall: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(BL)).add(RVTarget).getInstr();
    if MI.shouldUpdateAdditionalCallInfo() {
        MBB.getParent().moveAdditionalCallInfo(&mut MI, OriginalCall);
    }
    MI.eraseFromParent();
    finalizeBundle(MBB, OriginalCall.getIterator(), next(RVCall.getIterator(), 1));
    return true;
}

fn AArch64ExpandPseudoImpl::expandCALL_BTI(self, MBB: *mut MachineBasicBlock, MBBI: iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut Call: *mut MachineInstr = createCall(MBB, MBBI, self.TII, MI.getOperand(0), 1);
    Call.setCFIType(*MBB.getParent(), MI.getCFIType());
    let mut BTI: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(HINT)).addImm(36).getInstr();
    if MI.shouldUpdateAdditionalCallInfo() {
        MBB.getParent().moveAdditionalCallInfo(&mut MI, Call);
    }
    MI.eraseFromParent();
    finalizeBundle(MBB, Call.getIterator(), next(BTI.getIterator(), 1));
    return true;
}

fn AArch64ExpandPseudoImpl::expandStoreSwiftAsyncContext(self, MBB: *mut MachineBasicBlock, MBBI: iterator) -> bool {
    let mut CtxReg: Register = operator(MBBI).getOperand(0).getReg();
    let mut BaseReg: Register = operator(MBBI).getOperand(1).getReg();
    let mut Offset: i32 = operator(MBBI).getOperand(2).getImm();
    let mut DL: DebugLoc = operator(MBBI).getDebugLoc();
    let mut STI: *AArch64Subtarget = MBB.getParent().getSubtarget();
    if STI.getTargetTriple().getArchName() != "arm64e" {
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(STRXui)).addUse(CtxReg, RegState {}, 0).addUse(BaseReg, RegState {}, 0).addImm(Offset / 8).setMIFlag(FrameSetup);
        operator(MBBI).eraseFromParent();
        return true;
    }
    let mut Opc: u32 = if Offset >= 0 { ADDXri } else { SUBXri };
    BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Opc), X16).addUse(BaseReg, RegState {}, 0).addImm(if Offset < 0 { -Offset } else { Offset }).addImm(0).setMIFlag(FrameSetup);
    BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MOVKXi), X16).addUse(X16, RegState {}, 0).addImm(49946).addImm(48).setMIFlag(FrameSetup);
    BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ORRXrs), X17).addUse(XZR, RegState {}, 0).addUse(CtxReg, RegState {}, 0).addImm(0).setMIFlag(FrameSetup);
    BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(PACDB), X17).addUse(X17, RegState {}, 0).addUse(X16, RegState {}, 0).setMIFlag(FrameSetup);
    BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(STRXui)).addUse(X17, RegState {}, 0).addUse(BaseReg, RegState {}, 0).addImm(Offset / 8).setMIFlag(FrameSetup);
    operator(MBBI).eraseFromParent();
    return true;
}

fn AArch64ExpandPseudoImpl::expandConditionalPseudo(self, MBB: *mut MachineBasicBlock, MBBI: iterator, DL: DebugLoc, Branch: *mut MachineInstrBuilder) -> ConditionalBlocks {
    assert!((next(MBBI, 1) != MBB.end() || MBB.successors().begin() != MBB.successors().end()), "Unexpected unreachable in block");
    let mut PrevMI: *mut MachineInstr = operator(prev(MBBI, 1));
    let mut CondBB: *mut MachineBasicBlock = MBB.splitAt(PrevMI, true, null);
    let mut EndBB: *mut MachineBasicBlock = if next(MBBI, 1) == CondBB.end() { *CondBB.successors().begin() } else { CondBB.splitAt(operator(MBBI), true, null) };
    Branch.addMBB(CondBB, 0);
    BuildMI(&mut MBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(B)).addMBB(EndBB, 0);
    MBB.addSuccessor(EndBB, getUnknown());
    BuildMI(CondBB, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(B)).addMBB(EndBB, 0);
    return ConditionalBlocks { *CondBB, *EndBB };
}

fn AArch64ExpandPseudoImpl::expandRestoreZASave(self, MBB: *mut MachineBasicBlock, MBBI: iterator) -> *mut MachineBasicBlock {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut Branch: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CBZX)).add(MI.getOperand(0));
    let mut MIB: MachineInstrBuilder = BuildMI(CondBB, CondBB.back(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(BL));
    for let mut I: u32 = 2; I < MI.getNumOperands(); I += 1 {
        MIB.add(MI.getOperand(I));
    }
    MIB.addReg(MI.getOperand(1).getReg(), Implicit, 0);
    MI.eraseFromParent();
    return &mut EndBB;
}

const ZERO_ALL_ZA_MASK: u32 = 255;

fn AArch64ExpandPseudoImpl::expandCommitZASave(self, MBB: *mut MachineBasicBlock, MBBI: iterator) -> *mut MachineBasicBlock {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut RI: *TargetRegisterInfo = MBB.getParent().getSubtarget().getRegisterInfo();
    let mut Branch: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(CBNZX)).add(MI.getOperand(0));
    let mut MIB: MachineInstrBuilder = BuildMI(CondBB, CondBB.back(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(BL));
    for let mut I: u32 = 3; I < MI.getNumOperands(); I += 1 {
        MIB.add(MI.getOperand(I));
    }
    BuildMI(CondBB, CondBB.back(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MSR)).addImm(TPIDR2_EL0).addReg(XZR, RegState {}, 0);
    let mut ZeroZA: bool = MI.getOperand(1).getImm() != 0;
    let mut ZeroZT0: bool = MI.getOperand(2).getImm() != 0;
    if ZeroZA {
        assert!(MI.definesRegister(ZAB0, RI), "should define ZA!");
        BuildMI(CondBB, CondBB.back(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ZERO_M)).addImm(ZERO_ALL_ZA_MASK).addDef(ZAB0, ImplicitDefine, 0);
    }
    if ZeroZT0 {
        assert!(MI.definesRegister(ZT0, RI), "should define ZT0!");
        BuildMI(CondBB, CondBB.back(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ZERO_T)).addDef(ZT0, RegState {}, 0);
    }
    MI.eraseFromParent();
    return &mut EndBB;
}

fn AArch64ExpandPseudoImpl::expandCondSMToggle(self, MBB: *mut MachineBasicBlock, MBBI: iterator) -> *mut MachineBasicBlock {
    let mut MI: *mut MachineInstr = operator(MBBI);
    if next(MBBI, 1) == MBB.end() && MI.getParent().successors().begin() == MI.getParent().successors().end() {
        MI.eraseFromParent();
        return &mut MBB;
    }
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut Opc: u32 = 0;
    match MI.getOperand(2).getImm() {
        Always => {
            llvm_unreachable_internal("Should have matched to instruction directly", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ExpandPseudoInsts.cpp", 1238);
        },
        IfCallerIsStreaming => {
            Opc = TBNZW;
        },
        IfCallerIsNonStreaming => {
            Opc = TBZW;
        },
    }
    let mut PStateSM: Register = MI.getOperand(3).getReg();
    let mut TRI: *TargetRegisterInfo = MBB.getParent().getSubtarget().getRegisterInfo();
    let mut SMReg32: u32 = TRI.getSubReg(PStateSM.operator MCRegister(), sub_32).operator unsigned int();
    let mut Tbx: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Opc)).addReg(SMReg32, RegState {}, 0).addImm(0);
    let mut MIB: MachineInstrBuilder = BuildMI(CondBB, CondBB.back(), MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MSRpstatesvcrImm1));
    MIB.add(MI.getOperand(0));
    MIB.add(MI.getOperand(1));
    for let mut i: u32 = 4; i < MI.getNumOperands(); i += 1 {
        MIB.add(MI.getOperand(i));
    }
    MI.eraseFromParent();
    return &mut EndBB;
}

fn AArch64ExpandPseudoImpl::expandMultiVecPseudo(self, MBB: *mut MachineBasicBlock, MBBI: iterator, ContiguousClass: *TargetRegisterClass, StridedClass: *TargetRegisterClass, ContiguousOp: u32, StridedOpc: u32) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut Tuple: Register = MI.getOperand(0).getReg();
    let mut ContiguousRange: ArrayRef<MCPhysReg> = ContiguousClass.getRegisters();
    let mut StridedRange: ArrayRef<MCPhysReg> = StridedClass.getRegisters();
    let mut Opc: u32 = 0;
    if is_contained(ContiguousRange, Tuple.asMCReg()) {
        Opc = ContiguousOp;
    } else if is_contained(StridedRange, Tuple.asMCReg()) {
        Opc = StridedOpc;
    } else {
        llvm_unreachable_internal("Cannot expand Multi-Vector pseudo", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64ExpandPseudoInsts.cpp", 1284);
    }
    let mut MIB: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(Opc)).add(MI.getOperand(0)).add(MI.getOperand(1)).add(MI.getOperand(2)).add(MI.getOperand(3));
    transferImpOps(MI, MIB, MIB);
    MI.eraseFromParent();
    return true;
}

fn AArch64ExpandPseudoImpl::expandCopyIntoTuplePseudo(self, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock, MBBI: iterator) -> bool {
    let mut Src: Register = MI.getOperand(1).getReg();
    let mut Dest: Register = MI.getOperand(0).getReg();
    if Src != Dest {
        BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ORR_ZZZ)).addReg(Dest, Define, 0).addReg(Src, RegState {}, 0).addReg(Src, RegState {}, 0);
    }
    MI.eraseFromParent();
    return true;
}

fn AArch64ExpandPseudoImpl::expandMI(self, MBB: *mut MachineBasicBlock, MBBI: iterator, NextMBBI: *mut iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut Opcode: u32 = MI.getOpcode();
    let mut OrigInstr: i32 = getSVEPseudoMap(MI.getOpcode());
    if OrigInstr != -1 {
        let mut Orig: *MCInstrDesc = self.TII.get(OrigInstr);
        if (Orig.TSFlags & DestructiveInstTypeMask) != NotDestructive {
            return self.expand_DestructiveOp(MI, MBB, MBBI);
        }
    }
    match Opcode {
        _ => {
            break;
        },
        BSPv8i8 => {
            BSPv16i8;
        },
        ADDWrr => {
            SUBWrr;
        },
        LOADgot => {
            let mut MF: *mut MachineFunction = MBB.getParent();
            let mut DstReg: Register = MI.getOperand(0).getReg();
            let mut MO1: *MachineOperand = MI.getOperand(1);
            let mut Flags: u32 = MO1.getTargetFlags();
            if MF.getTarget().getCodeModel() == Tiny {
                let mut MIB: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LDRXl), DstReg);
                if MO1.isGlobal() {
                    MIB.addGlobalAddress(MO1.getGlobal(), 0, Flags);
                } else if MO1.isSymbol() {
                    MIB.addExternalSymbol(MO1.getSymbolName(), Flags);
                } else {
                    assert!(MO1.isCPI(), "Only expect globals, externalsymbols, or constant pools");
                    MIB.addConstantPoolIndex(MO1.getIndex(), MO1.getOffset(), Flags);
                }
            } else {
                let mut MF: *mut MachineFunction = *MI.getParent().getParent();
                let mut DL: DebugLoc = MI.getDebugLoc();
                let mut MIB1: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ADRP), DstReg);
                let mut MIB2: MachineInstrBuilder = MachineInstrBuilder {};
                if MF.getSubtarget().isTargetILP32() {
                    let mut TRI: *TargetRegisterInfo = MBB.getParent().getSubtarget().getRegisterInfo();
                    let mut Reg32: u32 = TRI.getSubReg(DstReg.operator MCRegister(), sub_32).operator unsigned int();
                    MIB2 = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LDRWui)).addDef(Reg32, RegState {}, 0).addReg(DstReg, Kill, 0).addReg(DstReg, Implicit, 0);
                } else {
                    let mut DstReg: Register = MI.getOperand(0).getReg();
                    MIB2 = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(LDRXui)).add(MI.getOperand(0)).addUse(DstReg, Kill, 0);
                }
                if MO1.isGlobal() {
                    MIB1.addGlobalAddress(MO1.getGlobal(), 0, Flags | MO_PAGE);
                    MIB2.addGlobalAddress(MO1.getGlobal(), 0, Flags | MO_PAGEOFF | MO_NC);
                } else if MO1.isSymbol() {
                    MIB1.addExternalSymbol(MO1.getSymbolName(), Flags | MO_PAGE);
                    MIB2.addExternalSymbol(MO1.getSymbolName(), Flags | MO_PAGEOFF | MO_NC);
                } else {
                    assert!(MO1.isCPI(), "Only expect globals, externalsymbols, or constant pools");
                    MIB1.addConstantPoolIndex(MO1.getIndex(), MO1.getOffset(), Flags | MO_PAGE);
                    MIB2.addConstantPoolIndex(MO1.getIndex(), MO1.getOffset(), Flags | MO_PAGEOFF | MO_NC);
                }
                if MI.peekDebugInstrNum() != 0 {
                    operator(MIB2).setDebugInstrNum(MI.peekDebugInstrNum());
                }
                transferImpOps(MI, MIB1, MIB2);
            }
            MI.eraseFromParent();
            return true;
        },
        MOVaddrBA => {
            MOVaddr;
        },
        ADDlowTLS => {
            BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ADDXri)).add(MI.getOperand(0)).add(MI.getOperand(1)).add(MI.getOperand(2)).addImm(0);
        },
        MOVbaseTLS => {
            let mut DstReg: Register = MI.getOperand(0).getReg();
            let mut SysReg: SysRegValues = TPIDR_EL0;
            let mut MF: *mut MachineFunction = MBB.getParent();
            if MF.getSubtarget().useEL3ForTP() {
                SysReg = TPIDR_EL3;
            } else if MF.getSubtarget().useEL2ForTP() {
                SysReg = TPIDR_EL2;
            } else if MF.getSubtarget().useEL1ForTP() {
                SysReg = TPIDR_EL1;
            } else if MF.getSubtarget().useROEL0ForTP() {
                SysReg = TPIDRRO_EL0;
            }
            BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(MRS), DstReg).addImm(SysReg);
            MI.eraseFromParent();
            return true;
        },
        MOVi32imm => {
            return self.expandMOVImm(MBB, MBBI, 32);
        },
        MOVi64imm => {
            return self.expandMOVImm(MBB, MBBI, 64);
        },
        RET_ReallyLR => {
            let mut MIB: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(RET)).addReg(LR, Undef, 0);
            transferImpOps(MI, MIB, MIB);
            MI.eraseFromParent();
            return true;
        },
        CMP_SWAP_8 => {
            return self.expandCMP_SWAP(MBB, MBBI, LDAXRB, STLXRB, SUBSWrx, getArithExtendImm(UXTB, 0), WZR, NextMBBI);
        },
        CMP_SWAP_16 => {
            return self.expandCMP_SWAP(MBB, MBBI, LDAXRH, STLXRH, SUBSWrx, getArithExtendImm(UXTH, 0), WZR, NextMBBI);
        },
        CMP_SWAP_32 => {
            return self.expandCMP_SWAP(MBB, MBBI, LDAXRW, STLXRW, SUBSWrs, getShifterImm(LSL, 0), WZR, NextMBBI);
        },
        CMP_SWAP_64 => {
            return self.expandCMP_SWAP(MBB, MBBI, LDAXRX, STLXRX, SUBSXrs, getShifterImm(LSL, 0), XZR, NextMBBI);
        },
        CMP_SWAP_128 => {
            CMP_SWAP_128_RELEASE;
        },
        AESMCrrTied => {
            AESIMCrrTied;
        },
        IRGstack => {
            let mut MF: *mut MachineFunction = *MBB.getParent();
            let mut AFI: *AArch64FunctionInfo = MF.getInfo();
            let mut TFI: *AArch64FrameLowering = MF.getSubtarget().getFrameLowering();
            let mut BaseOffset: i32 = -AFI.getTaggedBasePointerOffset();
            let mut FrameReg: Register = 0;
            let mut FrameRegOffset: StackOffset = TFI.resolveFrameOffsetReference(MF, BaseOffset, false, Default, FrameReg, false, true);
            let mut SrcReg: Register = FrameReg;
            if FrameRegOffset {
                SrcReg = MI.getOperand(0).getReg();
                emitFrameOffset(MBB, &mut MI, MI.getDebugLoc(), SrcReg.operator unsigned int(), FrameReg.operator unsigned int(), FrameRegOffset, self.TII, NoFlags, false, false, null, false, StackOffset {}, SP);
            }
            BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(IRG)).add(MI.getOperand(0)).addUse(SrcReg, RegState {}, 0).add(MI.getOperand(2));
            MI.eraseFromParent();
            return true;
        },
        TAGPstack => {
            let mut Offset: i64 = MI.getOperand(2).getImm();
            BuildMI(MBB, MBBI, MIMetadata { DL: MI.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if Offset >= 0 { ADDG } else { SUBG })).add(MI.getOperand(0)).add(MI.getOperand(1)).addImm(if Offset < 0 { -Offset } else { Offset }).add(MI.getOperand(4));
            MI.eraseFromParent();
            return true;
        },
        STGloop_wback => {
            STZGloop_wback;
        },
        STGloop => {
            STZGloop;
        },
        STR_ZZZZXI => {
            STR_ZZZZXI_STRIDED_CONTIGUOUS;
        },
        STR_ZZZXI => {
            return self.expandSVESpillFill(MBB, MBBI, STR_ZXI, 3);
        },
        STR_ZZXI => {
            STR_ZZXI_STRIDED_CONTIGUOUS;
        },
        STR_PPXI => {
            return self.expandSVESpillFill(MBB, MBBI, STR_PXI, 2);
        },
        LDR_ZZZZXI => {
            LDR_ZZZZXI_STRIDED_CONTIGUOUS;
        },
        LDR_ZZZXI => {
