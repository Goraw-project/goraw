fn AArch64ExpandPseudoImpl::expandMBB(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Modified: bool = false;
    let mut MBBI: iterator = MBB.begin();
    let mut E: iterator = MBB.end();
    while MBBI != E {
        let mut NMBBI: iterator = next(MBBI, 1);
        if operator(MBBI).isPseudo(IgnoreBundle) {
            Modified |= self.expandMI(MBB, MBBI, NMBBI);
        }
        MBBI = NMBBI;
    }
    return Modified;
}

fn AArch64ExpandPseudoImpl::run(self, MF: *mut MachineFunction) -> bool {
    self.TII = MF.getSubtarget().getInstrInfo();
    let mut Modified: bool = false;
    for MBB in MF {
        Modified |= self.expandMBB(MBB);
    }
    return Modified;
}

fn AArch64ExpandPseudoLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return AArch64ExpandPseudoImpl {}.run(MF);
}

fn createAArch64ExpandPseudoLegacyPass() -> *mut FunctionPass {
    return AArch64ExpandPseudoLegacy {};
}

fn AArch64ExpandPseudoPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64ExpandPseudoImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}
