fn needReorderStoreMI(MI: *MachineInstr) -> bool {
    if !MI {
        return false;
    }
    match MI.getOpcode() {
        _ => {
            return false;
        },
    }
    return false;
}

fn mayOverlapWrite(MI0: *MachineInstr, MI1: *MachineInstr, Off0: *mut i64, Off1: *mut i64) -> bool {
    let mut Base0: *MachineOperand = getLdStBaseOp(MI0);
    let mut Base1: *MachineOperand = getLdStBaseOp(MI1);
    if !Base0.isIdenticalTo(Base1) {
        return true;
    }
    let mut StoreSize0: i32 = getMemScale(MI0);
    let mut StoreSize1: i32 = getMemScale(MI1);
    Off0 = if hasUnscaledLdStOffset(MI0.getOpcode()) { getLdStOffsetOp(MI0).getImm() } else { getLdStOffsetOp(MI0).getImm() * StoreSize0 };
    Off1 = if hasUnscaledLdStOffset(MI1.getOpcode()) { getLdStOffsetOp(MI1).getImm() } else { getLdStOffsetOp(MI1).getImm() * StoreSize1 };
    let mut MI: *MachineInstr = if (Off0 < Off1) { MI0 } else { MI1 };
    let mut Multiples: i32 = if isPairedLdSt(MI) { 2 } else { 1 };
    let mut StoreSize: i32 = getMemScale(MI) * Multiples;
    return llabs(Off0 - Off1) < StoreSize;
}

fn AArch64PostRASchedStrategy::tryCandidate(self, Cand: *mut SchedCandidate, TryCand: *mut SchedCandidate) -> bool {
    let mut OriginalResult: bool = self.tryCandidate(Cand, TryCand);
    if Cand.isValid() {
        let mut Instr0: *mut MachineInstr = TryCand.SU.getInstr();
        let mut Instr1: *mut MachineInstr = Cand.SU.getInstr();
        if !needReorderStoreMI(Instr0) || !needReorderStoreMI(Instr1) {
            return OriginalResult;
        }
        let mut Off0: i64 = 0;
        let mut Off1: i64 = 0;
        if !mayOverlapWrite(*Instr0, *Instr1, Off0, Off1) {
            TryCand.Reason = NodeOrder;
            return Off0 < Off1;
        }
    }
    return OriginalResult;
}
