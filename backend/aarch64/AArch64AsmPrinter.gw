        llvm_unreachable_internal("Unsupported check method", "llvm\\lib\\Target\\AArch64\\AArch64AsmPrinter.cpp", 2207);
    }
    if !OnFailure {} else {
        match Method {
            XPACHint => {
                break;
            },
            XPAC => {
                self.emitMovXReg(TestedReg, ScratchReg);
            },
            _ => {
                let mut XPACOpc: u32 = getXPACOpcodeForKey(Key);
            },
        }
        let mut OnFailureExpr: *auto = create(OnFailure);
    }
}

