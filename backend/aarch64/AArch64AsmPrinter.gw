static mut NumZCZeroingInstrsFPR: Statistic = Statistic { "AArch64AsmPrinter", "NumZCZeroingInstrsFPR", "Number of zero-cycle FPR zeroing instructions expanded from canonical pseudo instructions" };

enum PtrauthCheckMode {
    Unchecked = 0,
    Poison = 1,
    Trap = 2,
}

static mut PtrauthAuthChecks: opt<PtrauthCheckMode> = opt<PtrauthCheckMode> { "aarch64-ptrauth-auth-checks", Hidden, values(OptionEnumValue { Name: "none", Value: Unchecked, Description: "don't test for failure" }, OptionEnumValue { Name: "poison", Value: Poison, Description: "poison on failure" }, OptionEnumValue { Name: "trap", Value: Trap, Description: "trap on failure" }), "Check pointer authentication auth/resign failures" };

struct AArch64AsmPrinter {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
    TM: *mut TargetMachine,
    MAI: *MCAsmInfo,
    OutContext: *mut MCContext,
    OutStreamer: unique_ptr<MCStreamer>,
    MF: *mut MachineFunction,
    MMI: *mut MachineModuleInfo,
    PointerSize: u32,
    MDT: *mut MachineDominatorTree,
    MLI: *mut MachineLoopInfo,
    ORE: *mut MachineOptimizationRemarkEmitter,
    CurrentPatchableFunctionEntrySym: *mut MCSymbol,
    CurrentFnSym: *mut MCSymbol,
    CurrentFnDescSym: *mut MCSymbol,
    CurrentFnSymForSize: *mut MCSymbol,
    CurrentFnCallsiteEndSymbols: DenseMap<const MachineBasicBlock *, SmallVector<MCSymbol *, 1>>,
    SDPI: *StaticDataProfileInfo,
    PSI: *ProfileSummaryInfo,
    MBBSectionRanges: MapVector<MBBSectionID, MBBSectionRange>,
    GlobalGOTEquivs: MapVector<const MCSymbol *, GOTEquivUsePair>,
    GetMMI: function<MachineModuleInfo *()>,
    GetORE: function<MachineOptimizationRemarkEmitter *(MachineFunction &)>,
    GetMDT: function<MachineDominatorTree *(MachineFunction &)>,
    GetMLI: function<MachineLoopInfo *(MachineFunction &)>,
    BeginGCAssembly: function<void (Module &)>,
    FinishGCAssembly: function<void (Module &)>,
    EmitStackMaps: function<void (Module &)>,
    AssertDebugEHFinalized: function<void ()>,
    CurrentFnEnd: *mut MCSymbol,
    MBBSectionExceptionSyms: DenseMap<MBBSectionID, MCSymbol *>,
    CurrentSectionBeginSym: *mut MCSymbol,
    AddrLabelSymbols: unique_ptr<AddrLabelMap>,
    GCMetadataPrinters: unique_ptr<GCMetadataPrinter>>,
    VerboseAsm: bool,
    StackUsageStream: unique_ptr<raw_fd_ostream>,
    PCSectionsSymbols: DenseMap<const MDNode *, SmallVector<const MCSymbol *>>,
    CurrentFnBegin: *mut MCSymbol,
    CurrentFnBeginLocal: *mut MCSymbol,
    EHHandlers: unique_ptr<EHStreamer>, 1>,
    Handlers: unique_ptr<AsmPrinterHandler>, 2>,
    NumUserHandlers: u64,
    SM: StackMaps,
    OwnedMDT: unique_ptr<MachineDominatorTree>,
    OwnedMLI: unique_ptr<MachineLoopInfo>,
    DD: *mut DwarfDebug,
    PP: unique_ptr<PseudoProbeHandler>,
    ModuleCFISection: CFISection,
    HasSplitStack: bool,
    HasNoSplitStack: bool,
    DbgInfoAvailable: bool,
    Sleds: SmallVector<XRayFunctionEntry, 4>,
    LastMI: *MachineInstr,
    LastFn: u32,
    Counter: u32,
    DwarfUsesRelocationsAcrossSections: bool,
    MCInstLowering: AArch64MCInstLower,
    FM: FaultMaps,
    STI: *AArch64Subtarget,
    ShouldEmitWeakSwiftAsyncExtendedFramePointerFlags: bool,
    PtrauthInitFini: bool,
    PtrauthInitFiniAddressDisc: bool,
    InstsEmitted: u32,
    EnableImportCallOptimization: bool,
    SectionToImportedFunctionCalls: pair<MCSymbol *, MCSymbol *>>>,
    PAuthIFuncNextUniqueID: u32,
    HwasanMemaccessSymbols: map<HwasanMemaccessTuple, MCSymbol *>,
    AArch64FI: *mut AArch64FunctionInfo,
    LOHInstToLabel: MInstToMCSymbol,
}

fn AArch64AsmPrinter::getPassName(self: *AArch64AsmPrinter) -> str {
    return "AArch64 Assembly Printer";
}

fn AArch64AsmPrinter::lowerOperand(self: *AArch64AsmPrinter, MO: *MachineOperand, MCOp: *mut MCOperand) -> bool {
    return self.MCInstLowering.lowerOperand(MO, MCOp);
}

fn AArch64AsmPrinter::isPtrauthRegSafe(self: *AArch64AsmPrinter, Reg: Register) -> bool {
    if self.STI.isX16X17Safer() {
        return Reg == X16 || Reg == X17;
    }
    return true;
}

fn AArch64AsmPrinter::EmitToStreamer(self, Inst: *MCInst) {
    self.EmitToStreamer(operator(self.OutStreamer), Inst);
}

fn AArch64AsmPrinter::getAnalysisUsage(self: *AArch64AsmPrinter, AU: *mut AnalysisUsage) {
    self.getAnalysisUsage(AU);
    AU.setPreservesAll();
}

fn AArch64AsmPrinter::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.getAnalysisIfAvailable() {
        PSIW;
    } else {
        self.PSI = &mut PSIW.getPSI();
    }
    if self.getAnalysisIfAvailable() {
        SDPIW;
    } else {
        self.SDPI = &mut SDPIW.getStaticDataProfileInfo();
    }
    self.AArch64FI = MF.getInfo();
    self.STI = &mut MF.getSubtarget();
    self.SetupMachineFunction(MF);
    if self.STI.isTargetCOFF() {
        let mut Local: bool = MF.getFunction().hasLocalLinkage();
        let mut Scl: SymbolStorageClass = if Local { IMAGE_SYM_CLASS_STATIC } else { IMAGE_SYM_CLASS_EXTERNAL };
        let mut Type: i32 = IMAGE_SYM_DTYPE_FUNCTION << SCT_COMPLEX_TYPE_SHIFT;
        operator(self.OutStreamer).beginCOFFSymbolDef(self.CurrentFnSym);
        operator(self.OutStreamer).emitCOFFSymbolStorageClass(Scl);
        operator(self.OutStreamer).emitCOFFSymbolType(Type);
        operator(self.OutStreamer).endCOFFSymbolDef();
    }
    self.emitFunctionBody();
    self.emitXRayTable();
    return false;
}

fn AArch64AsmPrinter::shouldEmitWeakSwiftAsyncExtendedFramePointerFlags(self: *AArch64AsmPrinter) -> bool {
    return self.ShouldEmitWeakSwiftAsyncExtendedFramePointerFlags;
}

fn AArch64AsmPrinter::getIFuncMCSubtargetInfo(self: *AArch64AsmPrinter) -> *MCSubtargetInfo {
