fn targetSupportsIRelativeRelocation(TT: *Triple) -> bool {
    if !TT.isOSBinFormatELF() {
        return false;
    }
    return TT.isOSGlibc() || TT.isAndroid() || TT.isOSFreeBSD() || TT.isOSDragonFly() || TT.isOSNetBSD();
}

