static mut ID: i8 = 0;

fn AArch64AsmPrinterBeginPass::run(self, M: *mut Module, MAM: *mut ModuleAnalysisManager) -> PreservedAnalyses {
    let mut AsmPrinter: *mut AArch64AsmPrinter = MAM() as AArch64AsmPrinter;
    setupModuleAsmPrinter(M, MAM, AsmPrinter);
    AsmPrinter.doInitialization;
    return all();
}

fn AArch64AsmPrinterPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut AsmPrinter: *mut AArch64AsmPrinter = MFAM(operator*(MF.getFunction()))() as AArch64AsmPrinter;
    setupMachineFunctionAsmPrinter(MFAM, MF, AsmPrinter);
    AsmPrinter.runOnMachineFunction(MF);
    return all();
}

fn AArch64AsmPrinterEndPass::run(self, M: *mut Module, MAM: *mut ModuleAnalysisManager) -> PreservedAnalyses {
    let mut AsmPrinter: *mut AArch64AsmPrinter = MAM() as AArch64AsmPrinter;
    setupModuleAsmPrinter(M, MAM, AsmPrinter);
    AsmPrinter.doFinalization;
    return all();
}

