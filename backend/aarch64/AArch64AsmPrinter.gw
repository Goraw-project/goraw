fn getOptionalBooleanModuleFlag(M: *mut Module, Name: str) -> bool {
    let mut Flag: *mut Metadata = M.getModuleFlag(Name);
    if !Flag {
        return false;
    }
    let mut Value: u64 = extract(Flag).getZExtValue();
    assert!((Value == 0 || Value == 1), "Boolean flag is expected, if present");
    return Value;
}

fn AArch64AsmPrinter::emitStartOfAsmFile(self, M: *mut Module) {
    let mut TT: *Triple = M.getTargetTriple();
    if TT.isOSBinFormatCOFF() {
        self.emitCOFFFeatureSymbol(M);
        self.emitCOFFReplaceableFunctionData(M);
        if M.getModuleFlag("import-call-optimization") {
            self.EnableImportCallOptimization = true;
        }
    }
    self.PtrauthInitFini = getOptionalBooleanModuleFlag(M, "ptrauth-init-fini");
    self.PtrauthInitFiniAddressDisc = getOptionalBooleanModuleFlag(M, "ptrauth-init-fini-address-discrimination");
    if !TT.isOSBinFormatELF() {
        return;
    }
    let mut TS: *mut AArch64TargetStreamer = operator(self.OutStreamer).getTargetStreamer() as *mut AArch64TargetStreamer;
    let mut BAFlags: u32 = 0;
    let mut GNUFlags: u32 = 0;
    if extract_or_null(M.getModuleFlag("branch-target-enforcement")) {
        BTE;
    } else {
        if !BTE.isZero() {
            BAFlags |= Feature_BTI_Flag;
            GNUFlags |= GNU_PROPERTY_AARCH64_FEATURE_1_BTI;
        }
    }
    if extract_or_null(M.getModuleFlag("guarded-control-stack")) {
        GCS;
    } else {
        if !GCS.isZero() {
            BAFlags |= Feature_GCS_Flag;
            GNUFlags |= GNU_PROPERTY_AARCH64_FEATURE_1_GCS;
        }
    }
    if extract_or_null(M.getModuleFlag("sign-return-address")) {
        Sign;
    } else {
        if !Sign.isZero() {
            BAFlags |= Feature_PAC_Flag;
            GNUFlags |= GNU_PROPERTY_AARCH64_FEATURE_1_PAC;
        }
    }
    let mut PAuthABIPlatform: u64 = -1;
    if extract_or_null(M.getModuleFlag("aarch64-elf-pauthabi-platform")) {
        PAP;
    } else {
        PAuthABIPlatform = PAP.getZExtValue();
    }
    let mut PAuthABIVersion: u64 = -1;
    if extract_or_null(M.getModuleFlag("aarch64-elf-pauthabi-version")) {
        PAV;
    } else {
        PAuthABIVersion = PAV.getZExtValue();
    }
    if PAuthABIPlatform == AARCH64_PAUTH_PLATFORM_LLVM_LINUX && PAuthABIVersion == 0 {
        PAuthABIPlatform = -1;
        PAuthABIVersion = -1;
    }
    self.emitAttributes(BAFlags, PAuthABIPlatform, PAuthABIVersion, TS);
    TS.emitNoteSection(GNUFlags, PAuthABIPlatform, PAuthABIVersion);
}

fn AArch64AsmPrinter::emitFunctionHeaderComment(self) {
    let mut FI: *AArch64FunctionInfo = self.MF.getInfo();
    let mut OutlinerString: string> = FI.getOutliningStyle();
    if !OutlinerString == nullopt {
        operator(self.OutStreamer).getCommentOS() << ' ' << OutlinerString;
    }
}

fn AArch64AsmPrinter::LowerPATCHABLE_FUNCTION_ENTER(self, MI: *MachineInstr) {
    let mut F: *Function = self.MF.getFunction();
    if F.hasFnAttribute("patchable-function-entry") {
        let mut Num: u32 = 0;
        if F.getFnAttribute("patchable-function-entry").getValueAsString().getAsInteger(10, Num) {
            return;
        }
        self.emitNops(Num);
        return;
    }
    self.emitSled(MI, FUNCTION_ENTER);
}

fn AArch64AsmPrinter::LowerPATCHABLE_FUNCTION_EXIT(self, MI: *MachineInstr) {
    self.emitSled(MI, FUNCTION_EXIT);
}

fn AArch64AsmPrinter::LowerPATCHABLE_TAIL_CALL(self, MI: *MachineInstr) {
    self.emitSled(MI, TAIL_CALL);
}

fn AArch64AsmPrinter::emitSled(self, MI: *MachineInstr, Kind: SledKind) {
    let mut NoopsInSledCount: i8 = 7;
    operator(self.OutStreamer).emitCodeAlignment(4, self.getSubtargetInfo(), 0);
    let mut CurSled: *mut MCSymbol = self.OutContext.createTempSymbol("xray_sled_", true);
    operator(self.OutStreamer).emitLabel(CurSled, SMLoc {});
    let mut Target: *mut MCSymbol = self.OutContext.createTempSymbol();
    self.EmitToStreamer(operator(self.OutStreamer), B.addImm(8).operator llvm::MCInst &());
    for let mut I: i8 = 0; I < NoopsInSledCount; I += 1 {
        self.EmitToStreamer(operator(self.OutStreamer), NOP.operator llvm::MCInst &());
    }
    operator(self.OutStreamer).emitLabel(Target, SMLoc {});
    self.recordSled(CurSled, MI, Kind, 2);
}

fn AArch64AsmPrinter::emitAttributes(self, Flags: u32, PAuthABIPlatform: u64, PAuthABIVersion: u64, TS: *mut AArch64TargetStreamer) {
    PAuthABIPlatform = if (-1 == PAuthABIPlatform) { 0 } else { PAuthABIPlatform };
    PAuthABIVersion = if (-1 == PAuthABIVersion) { 0 } else { PAuthABIVersion };
    if PAuthABIPlatform || PAuthABIVersion {
        TS.emitAttributesSubsection(getVendorName(AEABI_PAUTHABI), REQUIRED, ULEB128);
        TS.emitAttribute(getVendorName(AEABI_PAUTHABI), TAG_PAUTH_PLATFORM, PAuthABIPlatform, "");
        TS.emitAttribute(getVendorName(AEABI_PAUTHABI), TAG_PAUTH_SCHEMA, PAuthABIVersion, "");
    }
    let mut BTIValue: u32 = if (Flags & Feature_BTI_Flag) { 1 } else { 0 };
    let mut PACValue: u32 = if (Flags & Feature_PAC_Flag) { 1 } else { 0 };
    let mut GCSValue: u32 = if (Flags & Feature_GCS_Flag) { 1 } else { 0 };
    if BTIValue || PACValue || GCSValue {
        TS.emitAttributesSubsection(getVendorName(AEABI_FEATURE_AND_BITS), OPTIONAL, ULEB128);
        TS.emitAttribute(getVendorName(AEABI_FEATURE_AND_BITS), TAG_FEATURE_BTI, BTIValue, "");
        TS.emitAttribute(getVendorName(AEABI_FEATURE_AND_BITS), TAG_FEATURE_PAC, PACValue, "");
        TS.emitAttribute(getVendorName(AEABI_FEATURE_AND_BITS), TAG_FEATURE_GCS, GCSValue, "");
    }
}

fn AArch64AsmPrinter::LowerPATCHABLE_EVENT_CALL(self, MI: *MachineInstr, Typed: bool) {
    let mut O: *mut MCStreamer = operator(self.OutStreamer);
    let mut CurSled: *mut MCSymbol = self.OutContext.createTempSymbol("xray_sled_", true);
    O.emitLabel(CurSled, SMLoc {});
    let mut MachO: bool = self.TM.getTargetTriple().isOSBinFormatMachO();
    let mut Sym: *MCSymbolRefExpr = create(self.OutContext.getOrCreateSymbol(if MachO { "_" } else { "" } + (if Typed { "__xray_TypedEvent" } else { "__xray_CustomEvent" })), self.OutContext, SMLoc {});
    if Typed {
        O.AddComment("Begin XRay typed event", true);
        self.EmitToStreamer(O, B.addImm(9).operator llvm::MCInst &());
        self.EmitToStreamer(O, STPXpre.addReg(SP).addReg(X0).addReg(X1).addReg(SP).addImm(-4).operator llvm::MCInst &());
        self.EmitToStreamer(O, STRXui.addReg(X2).addReg(SP).addImm(2).operator llvm::MCInst &());
        self.emitMovXReg(X0, MI.getOperand(0).getReg());
        self.emitMovXReg(X1, MI.getOperand(1).getReg());
        self.emitMovXReg(X2, MI.getOperand(2).getReg());
        self.EmitToStreamer(O, BL.addExpr(Sym).operator llvm::MCInst &());
        self.EmitToStreamer(O, LDRXui.addReg(X2).addReg(SP).addImm(2).operator llvm::MCInst &());
        O.AddComment("End XRay typed event", true);
        self.EmitToStreamer(O, LDPXpost.addReg(SP).addReg(X0).addReg(X1).addReg(SP).addImm(4).operator llvm::MCInst &());
        self.recordSled(CurSled, MI, TYPED_EVENT, 2);
    } else {
        O.AddComment("Begin XRay custom event", true);
        self.EmitToStreamer(O, B.addImm(6).operator llvm::MCInst &());
        self.EmitToStreamer(O, STPXpre.addReg(SP).addReg(X0).addReg(X1).addReg(SP).addImm(-2).operator llvm::MCInst &());
        self.emitMovXReg(X0, MI.getOperand(0).getReg());
        self.emitMovXReg(X1, MI.getOperand(1).getReg());
        self.EmitToStreamer(O, BL.addExpr(Sym).operator llvm::MCInst &());
        O.AddComment("End XRay custom event", true);
        self.EmitToStreamer(O, LDPXpost.addReg(SP).addReg(X0).addReg(X1).addReg(SP).addImm(2).operator llvm::MCInst &());
        self.recordSled(CurSled, MI, CUSTOM_EVENT, 2);
    }
}

fn AArch64AsmPrinter::LowerKCFI_CHECK(self, MI: *MachineInstr) {
    let mut AddrReg: Register = MI.getOperand(0).getReg();
    assert!(operator(next(MI.getIterator(), 1)).isCall(AnyInBundle), "KCFI_CHECK not followed by a call instruction");
    assert!(operator(next(MI.getIterator(), 1)).getOperand(0).getReg() == AddrReg, "KCFI_CHECK call target doesn't match call operand");
    let mut ScratchRegs: [2]u32 = [W16, W17];
    if AddrReg == XZR {
        AddrReg = getXRegFromWReg(ScratchRegs[0]);
        self.emitMovXReg(AddrReg, XZR);
    } else {
        for Reg in ScratchRegs[..] {
            if Reg == getWRegFromXReg(AddrReg.operator MCRegister()).operator unsigned int() {
                Reg = W9;
                break;
            }
        }
        assert!(ScratchRegs[0] != AddrReg.operator unsigned int() && ScratchRegs[1] != AddrReg.operator unsigned int(), "Invalid scratch registers for KCFI_CHECK");
        let mut PrefixNops: i64 = MI.getMF().getFunction().getFnAttributeAsParsedInteger("patchable-function-prefix", 0);
        self.EmitToStreamer(operator(self.OutStreamer), LDURWi.addReg(ScratchRegs[0]).addReg(AddrReg.operator MCRegister()).addImm(-(PrefixNops * 4 + 4)).operator llvm::MCInst &());
    }
    let mut Type: i64 = MI.getOperand(1).getImm();
    self.emitMOVK(ScratchRegs[1], Type & 65535, 0);
    self.emitMOVK(ScratchRegs[1], (Type >> 16) & 65535, 16);
    self.EmitToStreamer(operator(self.OutStreamer), SUBSWrs.addReg(WZR).addReg(ScratchRegs[0]).addReg(ScratchRegs[1]).addImm(0).operator llvm::MCInst &());
    let mut Pass: *mut MCSymbol = self.OutContext.createTempSymbol();
    self.EmitToStreamer(operator(self.OutStreamer), Bcc.addImm(EQ).addExpr(create(Pass, self.OutContext, SMLoc {})).operator llvm::MCInst &());
    let mut TypeIndex: u32 = ScratchRegs[1] - W0;
    let mut AddrIndex: u32 = 0;
    match AddrReg.operator unsigned int() {
        _ => {
            AddrIndex = AddrReg.operator unsigned int() - X0;
        },
        FP => {
            AddrIndex = 29;
        },
        LR => {
            AddrIndex = 30;
        },
    }
    assert!(AddrIndex < 31 && TypeIndex < 31);
    let mut ESR: u32 = 32768 | ((TypeIndex & 31) << 5) | (AddrIndex & 31);
    self.EmitToStreamer(operator(self.OutStreamer), BRK.addImm(ESR).operator llvm::MCInst &());
    operator(self.OutStreamer).emitLabel(Pass, SMLoc {});
}

fn AArch64AsmPrinter::LowerHWASAN_CHECK_MEMACCESS(self, MI: *MachineInstr) {
    let mut Reg: Register = MI.getOperand(0).getReg();
    if Reg == XZR {
        return;
    }
    let mut IsShort: bool = ((MI.getOpcode() == HWASAN_CHECK_MEMACCESS_SHORTGRANULES) || (MI.getOpcode() == HWASAN_CHECK_MEMACCESS_SHORTGRANULES_FIXEDSHADOW));
    let mut AccessInfo: u32 = MI.getOperand(1).getImm();
    let mut IsFixedShadow: bool = ((MI.getOpcode() == HWASAN_CHECK_MEMACCESS_FIXEDSHADOW) || (MI.getOpcode() == HWASAN_CHECK_MEMACCESS_SHORTGRANULES_FIXEDSHADOW));
    let mut FixedShadowOffset: u64 = if IsFixedShadow { MI.getOperand(2).getImm() } else { 0 };
    let mut Sym: *mut *mut MCSymbol = self.HwasanMemaccessSymbols[HwasanMemaccessTuple { Reg, IsShort, AccessInfo, IsFixedShadow, FixedShadowOffset }];
    if !Sym {
        if !self.TM.getTargetTriple().isOSBinFormatELF() {
            report_fatal_error("llvm.hwasan.check.memaccess only supported on ELF", true);
        }
        let mut SymName: str = "__hwasan_check_x" + utostr(Reg.operator unsigned int() - X0, false) + "_" + utostr(AccessInfo, false);
        if IsFixedShadow {
            operator(SymName, "_fixed_" + utostr(FixedShadowOffset, false));
        }
        if IsShort {
            operator(SymName, "_short_v2");
        }
        Sym = self.OutContext.getOrCreateSymbol(SymName);
    }
    self.EmitToStreamer(operator(self.OutStreamer), BL.addExpr(create(Sym, self.OutContext, SMLoc {})).operator llvm::MCInst &());
}

fn AArch64AsmPrinter::emitHwasanMemaccessSymbols(self, M: *mut Module) {
    if self.HwasanMemaccessSymbols.is_empty() {
        return;
    }
    let mut TT: *Triple = M.getTargetTriple();
    assert!(TT.isOSBinFormatELF();
    let mut STI: AArch64Subtarget> = make_unique(TT, self.TM.getTargetCPU(), self.TM.getTargetCPU(), self.TM.getTargetFeatureString(), self.TM, true);
    self.STI = STI.get();
    let mut HwasanTagMismatchV1Sym: *mut MCSymbol = self.OutContext.getOrCreateSymbol("__hwasan_tag_mismatch");
    let mut HwasanTagMismatchV2Sym: *mut MCSymbol = self.OutContext.getOrCreateSymbol("__hwasan_tag_mismatch_v2");
    let mut HwasanTagMismatchV1Ref: *MCSymbolRefExpr = create(HwasanTagMismatchV1Sym, self.OutContext, SMLoc {});
    let mut HwasanTagMismatchV2Ref: *MCSymbolRefExpr = create(HwasanTagMismatchV2Sym, self.OutContext, SMLoc {});
    for P in self.HwasanMemaccessSymbols {
        let mut Reg: u32 = get(P.first);
        let mut IsShort: bool = get(P.first);
        let mut AccessInfo: u32 = get(P.first);
        let mut IsFixedShadow: bool = get(P.first);
        let mut FixedShadowOffset: u64 = get(P.first);
        let mut HwasanTagMismatchRef: *MCSymbolRefExpr = if IsShort { HwasanTagMismatchV2Ref } else { HwasanTagMismatchV1Ref };
        let mut Sym: *mut MCSymbol = P.second;
        let mut HasMatchAllTag: bool = (AccessInfo >> HasMatchAllShift) & 1;
        let mut MatchAllTag: u8 = (AccessInfo >> MatchAllShift) & 255;
        let mut Size: u32 = 1 << ((AccessInfo >> AccessSizeShift) & 15);
        let mut CompileKernel: bool = (AccessInfo >> CompileKernelShift) & 1;
        operator(self.OutStreamer).switchSection(self.OutContext.getELFSection(".text.hot", SHT_PROGBITS, SHF_EXECINSTR | SHF_ALLOC | SHF_GROUP, 0, Sym.getName(), true), 0);
        operator(self.OutStreamer).emitSymbolAttribute(Sym, MCSA_ELF_TypeFunction);
        operator(self.OutStreamer).emitSymbolAttribute(Sym, MCSA_Weak);
        operator(self.OutStreamer).emitSymbolAttribute(Sym, MCSA_Hidden);
        operator(self.OutStreamer).emitLabel(Sym, SMLoc {});
        self.EmitToStreamer(SBFMXri.addReg(X16).addReg(Reg).addImm(4).addImm(55).operator llvm::MCInst &());
        if IsFixedShadow {
            self.emitMOVZ(X17, FixedShadowOffset >> 32, 32);
            self.EmitToStreamer(LDRBBroX.addReg(W16).addReg(X17).addReg(X16).addImm(0).addImm(0).operator llvm::MCInst &());
        } else {
            self.EmitToStreamer(LDRBBroX.addReg(W16).addReg(if IsShort { X20 } else { X9 }).addReg(X16).addImm(0).addImm(0).operator llvm::MCInst &());
        }
        self.EmitToStreamer(SUBSXrs.addReg(XZR).addReg(X16).addReg(Reg).addImm(getShifterImm(LSR, 56)).operator llvm::MCInst &());
        let mut HandleMismatchOrPartialSym: *mut MCSymbol = self.OutContext.createTempSymbol();
        self.EmitToStreamer(Bcc.addImm(NE).addExpr(create(HandleMismatchOrPartialSym, self.OutContext, SMLoc {})).operator llvm::MCInst &());
        let mut ReturnSym: *mut MCSymbol = self.OutContext.createTempSymbol();
        operator(self.OutStreamer).emitLabel(ReturnSym, SMLoc {});
        self.EmitToStreamer(RET.addReg(LR).operator llvm::MCInst &());
        operator(self.OutStreamer).emitLabel(HandleMismatchOrPartialSym, SMLoc {});
        if HasMatchAllTag {
            self.EmitToStreamer(UBFMXri.addReg(X17).addReg(Reg).addImm(56).addImm(63).operator llvm::MCInst &());
            self.EmitToStreamer(SUBSXri.addReg(XZR).addReg(X17).addImm(MatchAllTag).addImm(0).operator llvm::MCInst &());
            self.EmitToStreamer(Bcc.addImm(EQ).addExpr(create(ReturnSym, self.OutContext, SMLoc {})).operator llvm::MCInst &());
        }
        if IsShort {
            self.EmitToStreamer(SUBSWri.addReg(WZR).addReg(W16).addImm(15).addImm(0).operator llvm::MCInst &());
            let mut HandleMismatchSym: *mut MCSymbol = self.OutContext.createTempSymbol();
            self.EmitToStreamer(Bcc.addImm(HI).addExpr(create(HandleMismatchSym, self.OutContext, SMLoc {})).operator llvm::MCInst &());
            self.EmitToStreamer(ANDXri.addReg(X17).addReg(Reg).addImm(encodeLogicalImmediate(15, 64)).operator llvm::MCInst &());
            if Size != 1 {
                self.EmitToStreamer(ADDXri.addReg(X17).addReg(X17).addImm(Size - 1).addImm(0).operator llvm::MCInst &());
            }
            self.EmitToStreamer(SUBSWrs.addReg(WZR).addReg(W16).addReg(W17).addImm(0).operator llvm::MCInst &());
            self.EmitToStreamer(Bcc.addImm(LS).addExpr(create(HandleMismatchSym, self.OutContext, SMLoc {})).operator llvm::MCInst &());
            self.EmitToStreamer(ORRXri.addReg(X16).addReg(Reg).addImm(encodeLogicalImmediate(15, 64)).operator llvm::MCInst &());
            self.EmitToStreamer(LDRBBui.addReg(W16).addReg(X16).addImm(0).operator llvm::MCInst &());
            self.EmitToStreamer(SUBSXrs.addReg(XZR).addReg(X16).addReg(Reg).addImm(getShifterImm(LSR, 56)).operator llvm::MCInst &());
            self.EmitToStreamer(Bcc.addImm(EQ).addExpr(create(ReturnSym, self.OutContext, SMLoc {})).operator llvm::MCInst &());
            operator(self.OutStreamer).emitLabel(HandleMismatchSym, SMLoc {});
        }
        self.EmitToStreamer(STPXpre.addReg(SP).addReg(X0).addReg(X1).addReg(SP).addImm(-32).operator llvm::MCInst &());
        self.EmitToStreamer(STPXi.addReg(FP).addReg(LR).addReg(SP).addImm(29).operator llvm::MCInst &());
        if Reg != X0 {
            self.emitMovXReg(X0, Reg);
        }
        self.emitMOVZ(X1, AccessInfo & RuntimeMask, 0);
        if CompileKernel {
            self.EmitToStreamer(B.addExpr(HwasanTagMismatchRef).operator llvm::MCInst &());
        } else {
            self.EmitToStreamer(ADRP.addReg(X16).addExpr(create(HwasanTagMismatchRef, S_GOT_PAGE, self.OutContext, SMLoc {})).operator llvm::MCInst &());
            self.EmitToStreamer(LDRXui.addReg(X16).addReg(X16).addExpr(create(HwasanTagMismatchRef, S_GOT_LO12, self.OutContext, SMLoc {})).operator llvm::MCInst &());
            self.EmitToStreamer(BR.addReg(X16).operator llvm::MCInst &());
        }
    }
    self.STI = null;
}

fn emitAuthenticatedPointer(OutStreamer: *mut MCStreamer, StubLabel: *mut MCSymbol, StubAuthPtrRef: *MCExpr) {
    OutStreamer.emitLabel(StubLabel, SMLoc {});
    OutStreamer.emitValue(StubAuthPtrRef, 8, SMLoc {});
}

fn AArch64AsmPrinter::emitEndOfAsmFile(self, M: *mut Module) {
    self.emitHwasanMemaccessSymbols(M);
    let mut TT: *Triple = M.getTargetTriple();
    if TT.isOSBinFormatMachO() {
        let mut MMIMacho: *mut MachineModuleInfoMachO = self.MMI.getObjFileInfo();
        let mut Stubs: ExprStubListTy = MMIMacho.getAuthGVStubList();
        if !Stubs.is_empty() {
            operator(self.OutStreamer).switchSection(self.OutContext.getMachOSection("__DATA", "__auth_ptr", S_REGULAR, getMetadata(), null), 0);
            self.emitAlignment(8, null, 0);
            for Stub in Stubs {
                emitAuthenticatedPointer(operator(self.OutStreamer), Stub.first, Stub.second);
            }
            operator(self.OutStreamer).addBlankLine();
        }
        operator(self.OutStreamer).emitSubsectionsViaSymbols();
    }
    if TT.isOSBinFormatELF() {
        let mut MMIELF: *mut MachineModuleInfoELF = self.MMI.getObjFileInfo();
        let mut Stubs: ExprStubListTy = MMIELF.getAuthGVStubList();
        if !Stubs.is_empty() {
            let mut TLOF: *TargetLoweringObjectFile = self.getObjFileLowering();
            operator(self.OutStreamer).switchSection(TLOF.getDataSection(), 0);
            self.emitAlignment(8, null, 0);
            for Stub in Stubs {
                emitAuthenticatedPointer(operator(self.OutStreamer), Stub.first, Stub.second);
            }
            operator(self.OutStreamer).addBlankLine();
        }
        let mut PtrAuthELFGOTFlag: *ConstantInt = extract_or_null(M.getModuleFlag("ptrauth-elf-got"));
        if PtrAuthELFGOTFlag && PtrAuthELFGOTFlag.getZExtValue() == 1 {
            for GV in M.global_values() {
                if !GV.use_empty() && isa(GV) && !GV.getName().starts_with("llvm.") {
                    operator(self.OutStreamer).emitSymbolAttribute(self.getSymbol(&mut GV), MCSA_ELF_TypeFunction);
                }
            }
        }
    }
    self.FM.serializeToFaultMapSection();
    if self.EnableImportCallOptimization && TT.isOSBinFormatCOFF() {
        operator(self.OutStreamer).switchSection(self.getObjFileLowering().getImportCallSection(), 0);
        let mut ImpCallMagic: [12]i8 = "Imp_Call_V1";
        operator(self.OutStreamer).emitBytes(ImpCallMagic[0..(ImpCallMagic)]);
        for x in self.SectionToImportedFunctionCalls {
            let mut SectionSize: u32 =  * (2 + 3 * CallsToImportedFuncs.len);
            operator(self.OutStreamer).emitInt32(SectionSize);
            operator(self.OutStreamer).emitCOFFSecNumber(Section.getBeginSymbol());
            for x in CallsToImportedFuncs {
                operator(self.OutStreamer).emitInt32(19);
                operator(self.OutStreamer).emitCOFFSecOffset(CallsiteSymbol);
                operator(self.OutStreamer).emitCOFFSymbolIndex(CalledSymbol);
            }
        }
    }
}

fn AArch64AsmPrinter::emitLOHs(self) {
    let mut MCArgs: SmallVector<MCSymbol *, 3> = SmallVector<MCSymbol *, 3> {};
    for D in self.AArch64FI.getLOHContainer() {
        for MI in D.getArgs() {
            let mut LabelIt: iterator = self.LOHInstToLabel.find(MI);
            assert!(!LabelIt == self.LOHInstToLabel.end(), "Label hasn't been inserted for LOH related instruction");
            MCArgs.push(operator(LabelIt).second);
        }
        operator(self.OutStreamer).emitLOHDirective(D.getKind(), MCArgs);
        MCArgs.clear();
    }
}

fn AArch64AsmPrinter::emitFunctionBodyEnd(self) {
    if !self.AArch64FI.getLOHRelated().is_empty() {
        self.emitLOHs();
    }
}

fn AArch64AsmPrinter::GetCPISymbol(self: *AArch64AsmPrinter, CPID: u32) -> *mut MCSymbol {
    if !self.getDataLayout().getLinkerPrivateGlobalPrefix().is_empty() {
        return self.OutContext.getOrCreateSymbol(self.getDataLayout().getLinkerPrivateGlobalPrefix() + "CPI" + self.getFunctionNumber() + "_" + CPID);
    }
    return self.GetCPISymbol(CPID);
}

fn AArch64AsmPrinter::printOperand(self, MI: *MachineInstr, OpNum: u32, O: *mut raw_ostream) {
    let mut MO: *MachineOperand = MI.getOperand(OpNum);
    match MO.getType() {
        _ => {
            llvm_unreachable_internal("<unknown operand type>", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 1186);
        },
        MO_Register => {
            let mut Reg: Register = MO.getReg();
            assert!(Reg.isPhysical();
            assert!(!MO.getSubReg(), "Subregs should be eliminated!");
            O << getRegisterName(Reg.operator MCRegister(), NoRegAltName);
            break;
        },
        MO_Immediate => {
            O << MO.getImm();
            break;
        },
        MO_GlobalAddress => {
            self.PrintSymbolOperand(MO, O);
            break;
        },
        MO_BlockAddress => {
            let mut Sym: *mut MCSymbol = self.GetBlockAddressSymbol(MO.getBlockAddress());
            Sym.print(O, self.MAI);
            break;
        },
    }
}

fn AArch64AsmPrinter::printAsmMRegister(self, MO: *MachineOperand, Mode: i8, O: *mut raw_ostream) -> bool {
    let mut Reg: Register = MO.getReg();
    match Mode {
        _ => {
            return true;
        },
        'w' => {
            Reg = getWRegFromXReg(Reg.operator MCRegister());
        },
        'x' => {
            Reg = getXRegFromWReg(Reg.operator MCRegister());
        },
        't' => {
            Reg = getXRegFromXRegTuple(Reg.operator MCRegister());
        },
    }
    O << getRegisterName(Reg.operator MCRegister(), NoRegAltName);
    return false;
}

fn AArch64AsmPrinter::printAsmRegInClass(self, MO: *MachineOperand, RC: *TargetRegisterClass, AltName: u32, O: *mut raw_ostream) -> bool {
    assert!(MO.isReg(), "Should only get here with a register!");
    let mut RI: *TargetRegisterInfo = self.STI.getRegisterInfo();
    let mut Reg: Register = MO.getReg();
    let mut RegToPrint: MCRegister = RC.getRegister(RI.getEncodingValue(Reg.operator MCRegister()));
    if !RI.regsOverlap(RegToPrint, Reg) {
        return true;
    }
    O << getRegisterName(RegToPrint, AltName);
    return false;
}

fn AArch64AsmPrinter::PrintAsmOperand(self, MI: *MachineInstr, OpNum: u32, ExtraCode: *u8, O: *mut raw_ostream) -> bool {
    let mut MO: *MachineOperand = MI.getOperand(OpNum);
    if !self.PrintAsmOperand(MI, OpNum, ExtraCode, O) {
        return false;
    }
    if ExtraCode && ExtraCode[0] {
        if ExtraCode[1] != 0 {
            return true;
        }
        match ExtraCode[0] {
            _ => {
                return true;
            },
            'w' => {
                'x';
            },
            'b' => {
                'h';
            },
        }
    }
    if MO.isReg() {
        let mut Reg: Register = MO.getReg();
        if GPR32allRegClass.contains(Reg.operator MCRegister()) || GPR64allRegClass.contains(Reg.operator MCRegister()) {
            return self.printAsmMRegister(MO, 'x', O);
        }
        if GPR64x8ClassRegClass.contains(Reg.operator MCRegister()) {
            return self.printAsmMRegister(MO, 't', O);
        }
        let mut AltName: u32 = NoRegAltName;
        let mut RegClass: *TargetRegisterClass = null;
        if ZPRRegClass.contains(Reg.operator MCRegister()) {
            RegClass = &mut ZPRRegClass;
        } else if PPRRegClass.contains(Reg.operator MCRegister()) {
            RegClass = &mut PPRRegClass;
        } else if PNRRegClass.contains(Reg.operator MCRegister()) {
            RegClass = &mut PNRRegClass;
        } else {
            RegClass = &mut FPR128RegClass;
            AltName = vreg;
        }
        return self.printAsmRegInClass(MO, RegClass, AltName, O);
    }
    self.printOperand(MI, OpNum, O);
    return false;
}

fn AArch64AsmPrinter::PrintAsmMemoryOperand(self, MI: *MachineInstr, OpNum: u32, ExtraCode: *u8, O: *mut raw_ostream) -> bool {
    if ExtraCode && ExtraCode[0] && ExtraCode[0] != 'a' {
        return true;
    }
    let mut MO: *MachineOperand = MI.getOperand(OpNum);
    assert!(MO.isReg(), "unexpected inline asm memory operand");
    O << "[" << getRegisterName(MO.getReg().operator MCRegister(), NoRegAltName) << "]";
    return false;
}

fn AArch64AsmPrinter::PrintDebugValueComment(self, MI: *MachineInstr, OS: *mut raw_ostream) {
    let mut NOps: u32 = MI.getNumOperands();
    assert!(NOps == 4);
    OS << 9 << self.MAI.getCommentString() << "DEBUG_VALUE: ";
    OS << MI.getDebugVariable().getName();
    OS << " <- ";
    assert!(MI.isIndirectDebugValue();
    OS << '[';
    for let mut I: u32 = 0;
let mut E: u32 = size(MI.debug_operands(), null); I < E; I += 1 {
        if I != 0 {
            OS << ", ";
        }
        self.printOperand(MI, I, OS);
    }
    OS << ']';
    OS << "+";
    self.printOperand(MI, NOps - 2, OS);
}

fn AArch64AsmPrinter::emitJumpTableImpl(self, MJTI: *MachineJumpTableInfo, JumpTableIndices: ArrayRef<unsigned int>) {
    if JumpTableIndices.is_empty() {
        return;
    }
    let mut TLOF: *TargetLoweringObjectFile = self.getObjFileLowering();
    let mut F: *Function = self.MF.getFunction();
    let mut JT: ArrayRef<MachineJumpTableEntry> = MJTI.getJumpTables();
    let mut ReadOnlySec: *mut MCSection = null;
    if self.TM.Options.EnableStaticDataPartitioning {
        ReadOnlySec = TLOF.getSectionForJumpTable(F, self.TM, &mut JT[JumpTableIndices.front()]);
    } else {
        ReadOnlySec = TLOF.getSectionForJumpTable(F, self.TM);
    }
    operator(self.OutStreamer).switchSection(ReadOnlySec, 0);
    let mut AFI: *mut AArch64FunctionInfo = self.MF.getInfo();
    for JTI in JumpTableIndices {
        let mut JTBBs: *[]*mut MachineBasicBlock = JT[JTI].MBBs;
        if JTBBs.is_empty() {
            continue;
        }
        let mut Size: u32 = AFI.getJumpTableEntrySize(JTI);
        self.emitAlignment(Size, null, 0);
        operator(self.OutStreamer).emitLabel(self.GetJTISymbol(JTI, false), SMLoc {});
        let mut BaseSym: *MCSymbol = self.AArch64FI.getJumpTableEntryPCRelSymbol(JTI);
        let mut Base: *MCExpr = create(BaseSym, self.OutContext, SMLoc {});
        for JTBB in JTBBs {
            let mut Value: *MCExpr = create(JTBB.getSymbol(), self.OutContext, SMLoc {});
            Value = createSub(Value, Base, self.OutContext);
            if Size != 4 {
                Value = createLShr(Value, create(2, self.OutContext, false, 0), self.OutContext);
            }
            operator(self.OutStreamer).emitValue(Value, Size, SMLoc {});
        }
    }
}

fn AArch64AsmPrinter::getCodeViewJumpTableInfo(self: *AArch64AsmPrinter, JTI: i32, BranchInstr: *MachineInstr, BranchLabel: *MCSymbol) -> JumpTableEntrySize> {
    let mut AFI: AArch64FunctionInfo *const = self.MF.getInfo();
    let mut Base: MCSymbol *const = self.AArch64FI.getJumpTableEntryPCRelSymbol(JTI);
    let mut EntrySize: JumpTableEntrySize = zeroed();
    match AFI.getJumpTableEntrySize(JTI) {
        1 => {
            EntrySize = UInt8ShiftLeft;
        },
        2 => {
            EntrySize = UInt16ShiftLeft;
        },
        4 => {
            EntrySize = Int32;
        },
        _ => {
            llvm_unreachable_internal("Unexpected jump table entry size", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 1449);
        },
    }
    return make_tuple(Base, 0, BranchLabel, EntrySize);
}

fn AArch64AsmPrinter::emitFunctionEntryLabel(self) {
    let mut TT: *Triple = self.TM.getTargetTriple();
    if TT.isOSBinFormatELF() && (self.MF.getFunction().getCallingConv() == AArch64_VectorCall || self.MF.getFunction().getCallingConv() == AArch64_SVE_VectorCall || self.MF.getInfo().isSVECC()) {
        let mut TS: *mut AArch64TargetStreamer = operator(self.OutStreamer).getTargetStreamer() as *mut AArch64TargetStreamer;
        TS.emitDirectiveVariantPCS(self.CurrentFnSym);
    }
    self.emitFunctionEntryLabel();
    if TT.isWindowsArm64EC() && !self.MF.getFunction().hasLocalLinkage() {
        let mut emitFunctionAlias: Closure_1 = Closure_1 { cap_0: self };
        let mut getSymbolFromMetadata: Closure_2 = Closure_2 { cap_0: self };
        let mut UnmangledNames: SmallVector<MDNode *> = SmallVector<MDNode *> {};
        self.MF.getFunction().getMetadata("arm64ec_unmangled_name", UnmangledNames);
        for Node in UnmangledNames {
            let mut NameStr: str = cast(Node.getOperand(0)).getString();
            let mut UnmangledSym: *mut MCSymbol = self.MMI.getContext().getOrCreateSymbol(NameStr);
            if getArm64ECMangledFunctionName(UnmangledSym.getName()) {
                MangledName;
            } else {
                let mut ECMangledSym: *mut MCSymbol = self.MMI.getContext().getOrCreateSymbol(operator(MangledName));
                emitFunctionAlias.call(UnmangledSym, ECMangledSym);
            }
        }
        if getSymbolFromMetadata.call("arm64ec_ecmangled_name") {
            ECMangledSym;
        } else {
            emitFunctionAlias.call(ECMangledSym, self.CurrentFnSym);
        }
    }
}

fn AArch64AsmPrinter::emitXXStructor(self, DL: *DataLayout, CV: *Constant) {
    let mut C: *mut LLVMContext = CV.getContext();
    assert!(!isa(CV), "ctors/dtors are to be signed by asm printer");
    if self.PtrauthInitFini {
        let mut Int32Ty: *mut IntegerType = get(C, 32);
        let mut Int64Ty: *mut IntegerType = get(C, 64);
        let mut PtrTy: *mut PointerType = get(C, 0);
        let mut Key: *mut ConstantInt = get(Int32Ty, InitFiniKey, false, false);
        let mut IntDisc: *mut ConstantInt = get(Int64Ty, InitFiniPointerConstantDiscriminator, false, false);
        let mut Null: *mut Constant = get(PtrTy);
        let mut AddressDisc: *mut Constant = Null;
        if self.PtrauthInitFiniAddressDisc {
            let mut Marker: u64 = AddrDiscriminator_CtorsDtors;
            AddressDisc = getIntToPtr(get(Int64Ty, Marker, false, false), PtrTy, false);
        }
        CV = get(CV, Key, IntDisc, AddressDisc, Null);
    }
    self.emitXXStructor(DL, CV);
}

fn AArch64AsmPrinter::emitGlobalAlias(self, M: *Module, GA: *GlobalAlias) {
    if dyn_cast_or_null(GA.getAliasee()) {
        F;
    } else {
        if F.getMetadata("arm64ec_exp_name") {
            Node;
        } else {
            let mut ExpStr: str = cast(Node.getOperand(0)).getString();
            let mut ExpSym: *mut MCSymbol = self.MMI.getContext().getOrCreateSymbol(ExpStr);
            let mut Sym: *mut MCSymbol = self.MMI.getContext().getOrCreateSymbol(GA.getName());
            operator(self.OutStreamer).beginCOFFSymbolDef(ExpSym);
            operator(self.OutStreamer).emitCOFFSymbolStorageClass(IMAGE_SYM_CLASS_EXTERNAL);
            operator(self.OutStreamer).emitCOFFSymbolType(IMAGE_SYM_DTYPE_FUNCTION << SCT_COMPLEX_TYPE_SHIFT);
            operator(self.OutStreamer).endCOFFSymbolDef();
            operator(self.OutStreamer).beginCOFFSymbolDef(Sym);
            operator(self.OutStreamer).emitCOFFSymbolStorageClass(IMAGE_SYM_CLASS_EXTERNAL);
            operator(self.OutStreamer).emitCOFFSymbolType(IMAGE_SYM_DTYPE_FUNCTION << SCT_COMPLEX_TYPE_SHIFT);
            operator(self.OutStreamer).endCOFFSymbolDef();
            operator(self.OutStreamer).emitSymbolAttribute(Sym, MCSA_Weak);
            operator(self.OutStreamer).emitAssignment(Sym, create(ExpSym, self.MMI.getContext(), SMLoc {}));
            return;
        }
    }
    self.emitGlobalAlias(M, GA);
}

fn AArch64AsmPrinter::LowerJumpTableDest(self, OutStreamer: *mut MCStreamer, MI: *MachineInstr) {
    let mut DestReg: Register = MI.getOperand(0).getReg();
    let mut ScratchReg: Register = MI.getOperand(1).getReg();
    let mut ScratchRegW: Register = self.STI.getRegisterInfo().getSubReg(ScratchReg.operator MCRegister(), sub_32);
    let mut TableReg: Register = MI.getOperand(2).getReg();
    let mut EntryReg: Register = MI.getOperand(3).getReg();
    let mut JTIdx: i32 = MI.getOperand(4).getIndex();
    let mut Size: i32 = self.AArch64FI.getJumpTableEntrySize(JTIdx);
    let mut Label: *mut MCSymbol = self.MF.getInfo().getJumpTableEntryPCRelSymbol(JTIdx);
    if !Label {
        Label = self.MF.getContext().createTempSymbol();
        self.AArch64FI.setJumpTableEntryInfo(JTIdx, Size, Label);
        OutStreamer.emitLabel(Label, SMLoc {});
    }
    let mut LabelExpr: *MCSymbolRefExpr = create(Label, self.MF.getContext(), SMLoc {});
    self.EmitToStreamer(OutStreamer, ADR.addReg(DestReg.operator MCRegister()).addExpr(LabelExpr).operator llvm::MCInst &());
    let mut LdrOpcode: u32 = 0;
    match Size {
        1 => {
            LdrOpcode = LDRBBroX;
        },
        2 => {
            LdrOpcode = LDRHHroX;
        },
        4 => {
            LdrOpcode = LDRSWroX;
        },
        _ => {
            llvm_unreachable_internal("Unknown jump table size", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 1611);
        },
    }
    self.EmitToStreamer(OutStreamer, LdrOpcode.addReg(if Size == 4 { ScratchReg } else { ScratchRegW }.operator MCRegister()).addReg(TableReg.operator MCRegister()).addReg(EntryReg.operator MCRegister()).addImm(0).addImm(if Size == 1 { 0 } else { 1 }).operator llvm::MCInst &());
    self.EmitToStreamer(OutStreamer, ADDXrs.addReg(DestReg.operator MCRegister()).addReg(DestReg.operator MCRegister()).addReg(ScratchReg.operator MCRegister()).addImm(if Size == 4 { 0 } else { 2 }).operator llvm::MCInst &());
}

fn AArch64AsmPrinter::LowerHardenedBRJumpTable(self, MI: *MachineInstr) {
    let mut MJTI: *MachineJumpTableInfo = self.MF.getJumpTableInfo();
    assert!(MJTI, "Can't lower jump-table dispatch without JTI");
    let mut JTs: *[]MachineJumpTableEntry = MJTI.getJumpTables();
    assert!(!JTs.is_empty(), "Invalid JT index for jump-table dispatch");
    let mut JTOp: MachineOperand = MI.getOperand(0);
    let mut JTI: u32 = JTOp.getIndex();
    assert!(!self.AArch64FI.getJumpTableEntryPCRelSymbol(JTI), "unsupported compressed jump table");
    let mut NumTableEntries: u64 = JTs[JTI].MBBs.len;
    let mut MaxTableEntry: u64 = NumTableEntries - 1;
    if isUInt(MaxTableEntry) {
        self.EmitToStreamer(operator(self.OutStreamer), SUBSXri.addReg(XZR).addReg(X16).addImm(MaxTableEntry).addImm(0).operator llvm::MCInst &());
    } else {
        self.emitMOVZ(X17, MaxTableEntry as u16, 0);
        for let mut Offset: i32 = 16; Offset < 64; Offset += 16 {
            if (MaxTableEntry >> Offset) == 0 {
                break;
            }
            self.emitMOVK(X17, MaxTableEntry >> Offset as u16, Offset);
        }
        self.EmitToStreamer(operator(self.OutStreamer), SUBSXrs.addReg(XZR).addReg(X16).addReg(X17).addImm(0).operator llvm::MCInst &());
    }
    self.EmitToStreamer(operator(self.OutStreamer), CSELXr.addReg(X16).addReg(X16).addReg(XZR).addImm(LS).operator llvm::MCInst &());
    let mut JTMOHi: MachineOperand = JTOp;
    let mut JTMOLo: MachineOperand = JTOp;
    let mut JTMCHi: MCOperand = MCOperand {};
    let mut JTMCLo: MCOperand = MCOperand {};
    JTMOHi.setTargetFlags(MO_PAGE);
    JTMOLo.setTargetFlags(MO_PAGEOFF | MO_NC);
    self.MCInstLowering.lowerOperand(JTMOHi, JTMCHi);
    self.MCInstLowering.lowerOperand(JTMOLo, JTMCLo);
    self.EmitToStreamer(operator(self.OutStreamer), ADRP.addReg(X17).addOperand(JTMCHi).operator llvm::MCInst &());
    self.EmitToStreamer(operator(self.OutStreamer), ADDXri.addReg(X17).addReg(X17).addOperand(JTMCLo).addImm(0).operator llvm::MCInst &());
    self.EmitToStreamer(operator(self.OutStreamer), LDRSWroX.addReg(X16).addReg(X17).addReg(X16).addImm(0).addImm(1).operator llvm::MCInst &());
    let mut AdrLabel: *mut MCSymbol = self.MF.getContext().createTempSymbol();
    let mut AdrLabelE: *MCSymbolRefExpr = create(AdrLabel, self.MF.getContext(), SMLoc {});
    self.AArch64FI.setJumpTableEntryInfo(JTI, 4, AdrLabel);
    operator(self.OutStreamer).emitLabel(AdrLabel, SMLoc {});
    self.EmitToStreamer(operator(self.OutStreamer), ADR.addReg(X17).addExpr(AdrLabelE).operator llvm::MCInst &());
    self.EmitToStreamer(operator(self.OutStreamer), ADDXrs.addReg(X16).addReg(X17).addReg(X16).addImm(0).operator llvm::MCInst &());
    self.EmitToStreamer(operator(self.OutStreamer), BR.addReg(X16).operator llvm::MCInst &());
}

fn AArch64AsmPrinter::LowerMOPS(self, OutStreamer: *mut MCStreamer, MI: *MachineInstr) {
    let mut Opcode: u32 = MI.getOpcode();
    assert!(self.STI.hasMOPS();
    assert!(self.STI.hasMTE() || Opcode != MOPSMemorySetTaggingPseudo);
    let mut Ops: array<unsigned int, 3> = Closure_3 { Opcode: Opcode }.call();
    let mut IsSet: bool = Opcode == MOPSMemorySetPseudo || Opcode == MOPSMemorySetTaggingPseudo;
    for Op in Ops {
        let mut i: i32 = 0;
        let mut MCIB: MCInstBuilder = Op;
        MCIB.addReg(MI.getOperand(i += 1).getReg().operator MCRegister());
        MCIB.addReg(MI.getOperand(i += 1).getReg().operator MCRegister());
        if !IsSet {
            MCIB.addReg(MI.getOperand(i += 1).getReg().operator MCRegister());
        }
        MCIB.addReg(MI.getOperand(i += 1).getReg().operator MCRegister());
        MCIB.addReg(MI.getOperand(i += 1).getReg().operator MCRegister());
        MCIB.addReg(MI.getOperand(i += 1).getReg().operator MCRegister());
        self.EmitToStreamer(OutStreamer, MCIB.operator llvm::MCInst &());
    }
}

fn AArch64AsmPrinter::LowerSTACKMAP(self, OutStreamer: *mut MCStreamer, SM: *mut StackMaps, MI: *MachineInstr) {
    let mut NumNOPBytes: u32 = &mut MI.getNumPatchBytes();
    let mut Ctx: *mut MCContext = OutStreamer.getContext();
    let mut MILabel: *mut MCSymbol = Ctx.createTempSymbol();
    OutStreamer.emitLabel(MILabel, SMLoc {});
    SM.recordStackMap(*MILabel, MI);
    assert!(NumNOPBytes % 4 == 0, "Invalid number of NOP bytes requested!");
    let mut MBB: *MachineBasicBlock = *MI.getParent();
    let mut MII: const_iterator = MI;
    operator(MII);
    while NumNOPBytes > 0 {
        if MII == MBB.end() || operator(MII).isCall(AnyInBundle) || operator(MII).getOpcode() == DBG_VALUE || operator(MII).getOpcode() == PATCHPOINT || operator(MII).getOpcode() == STACKMAP {
            break;
        }
        operator(MII);
        NumNOPBytes -= 4;
    }
    for let mut i: u32 = 0; i < NumNOPBytes; i += 4 {
        self.EmitToStreamer(OutStreamer, NOP.operator llvm::MCInst &());
    }
}

fn AArch64AsmPrinter::LowerPATCHPOINT(self, OutStreamer: *mut MCStreamer, SM: *mut StackMaps, MI: *MachineInstr) {
    let mut Ctx: *mut MCContext = OutStreamer.getContext();
    let mut MILabel: *mut MCSymbol = Ctx.createTempSymbol();
    OutStreamer.emitLabel(MILabel, SMLoc {});
    SM.recordPatchPoint(*MILabel, MI);
    let mut Opers: PatchPointOpers = &mut MI;
    let mut CallTarget: i64 = Opers.getCallTarget().getImm();
    let mut EncodedBytes: u32 = 0;
    if CallTarget {
        assert!((CallTarget & 281474976710655) == CallTarget, "High 16 bits of call target should be zero.");
        let mut ScratchReg: Register = MI.getOperand(Opers.getNextScratchIdx(0)).getReg();
        EncodedBytes = 16;
        self.emitMOVZ(ScratchReg, (CallTarget >> 32) & 65535, 32);
        self.emitMOVK(ScratchReg, (CallTarget >> 16) & 65535, 16);
        self.emitMOVK(ScratchReg, CallTarget & 65535, 0);
        self.EmitToStreamer(OutStreamer, BLR.addReg(ScratchReg.operator MCRegister()).operator llvm::MCInst &());
    }
    let mut NumBytes: u32 = Opers.getNumPatchBytes();
    assert!(NumBytes >= EncodedBytes, "Patchpoint can't request size less than the length of a call.");
    assert!((NumBytes - EncodedBytes) % 4 == 0, "Invalid number of NOP bytes requested!");
    for let mut i: u32 = EncodedBytes; i < NumBytes; i += 4 {
        self.EmitToStreamer(OutStreamer, NOP.operator llvm::MCInst &());
    }
}

fn AArch64AsmPrinter::LowerSTATEPOINT(self, OutStreamer: *mut MCStreamer, SM: *mut StackMaps, MI: *MachineInstr) {
    let mut SOpers: StatepointOpers = &mut MI;
    if SOpers.getNumPatchBytes() {
        PatchBytes;
    } else {
        assert!(PatchBytes % 4 == 0, "Invalid number of NOP bytes requested!");
        for let mut i: u32 = 0; i < PatchBytes; i += 4 {
            self.EmitToStreamer(OutStreamer, NOP.operator llvm::MCInst &());
        }
    }
    let mut Ctx: *mut MCContext = OutStreamer.getContext();
    let mut MILabel: *mut MCSymbol = Ctx.createTempSymbol();
    OutStreamer.emitLabel(MILabel, SMLoc {});
    SM.recordStatepoint(*MILabel, MI);
}

fn AArch64AsmPrinter::LowerFAULTING_OP(self, FaultingMI: *MachineInstr) {
    let mut DefRegister: Register = FaultingMI.getOperand(0).getReg();
    let mut FK: FaultKind = FaultingMI.getOperand(1).getImm() as FaultKind;
    let mut HandlerLabel: *mut MCSymbol = FaultingMI.getOperand(2).getMBB().getSymbol();
    let mut Opcode: u32 = FaultingMI.getOperand(3).getImm();
    let mut OperandsBeginIdx: u32 = 4;
    let mut Ctx: *mut MCContext = operator(self.OutStreamer).getContext();
    let mut FaultingLabel: *mut MCSymbol = Ctx.createTempSymbol();
    operator(self.OutStreamer).emitLabel(FaultingLabel, SMLoc {});
    assert!(FK < FaultKindMax, "Invalid Faulting Kind!");
    self.FM.recordFaultingOp(FK, FaultingLabel, HandlerLabel);
    let mut MI: MCInst = MCInst {};
    MI.setOpcode(Opcode);
    if DefRegister != 0 as Register {
        MI.addOperand(createReg(DefRegister.operator MCRegister()));
    }
    for MO in drop_begin(FaultingMI.operands(), OperandsBeginIdx) {
        let mut Dest: MCOperand = MCOperand {};
        self.lowerOperand(MO, Dest);
        MI.addOperand(Dest);
    }
    operator(self.OutStreamer).AddComment("on-fault: " + HandlerLabel.getName(), true);
    self.EmitToStreamer(MI);
}

fn AArch64AsmPrinter::emitMovXReg(self, Dest: Register, Src: Register) {
    self.EmitToStreamer(operator(self.OutStreamer), ORRXrs.addReg(Dest.operator MCRegister()).addReg(XZR).addReg(Src.operator MCRegister()).addImm(0).operator llvm::MCInst &());
}

fn AArch64AsmPrinter::emitMOVZ(self, Dest: Register, Imm: u64, Shift: u32) {
    let mut Is64Bit: bool = GPR64RegClass.contains(Dest.operator MCRegister());
    self.EmitToStreamer(operator(self.OutStreamer), if Is64Bit { MOVZXi } else { MOVZWi }.addReg(Dest.operator MCRegister()).addImm(Imm).addImm(Shift).operator llvm::MCInst &());
}

fn AArch64AsmPrinter::emitMOVK(self, Dest: Register, Imm: u64, Shift: u32) {
    let mut Is64Bit: bool = GPR64RegClass.contains(Dest.operator MCRegister());
    self.EmitToStreamer(operator(self.OutStreamer), if Is64Bit { MOVKXi } else { MOVKWi }.addReg(Dest.operator MCRegister()).addReg(Dest.operator MCRegister()).addImm(Imm).addImm(Shift).operator llvm::MCInst &());
}

fn AArch64AsmPrinter::emitAUT(self, Key: ID, Pointer: Register, Disc: Register) {
    let mut IsZeroDisc: bool = Disc == XZR;
    let mut Opcode: u32 = getAUTOpcodeForKey(Key, IsZeroDisc);
    let mut AUTInst: MCInst = MCInst {};
    AUTInst.setOpcode(Opcode);
    AUTInst.addOperand(createReg(Pointer.operator MCRegister()));
    AUTInst.addOperand(createReg(Pointer.operator MCRegister()));
    if !IsZeroDisc {
        AUTInst.addOperand(createReg(Disc.operator MCRegister()));
    }
    self.EmitToStreamer(AUTInst);
}

fn AArch64AsmPrinter::emitPAC(self, Key: ID, Pointer: Register, Disc: Register) {
    let mut IsZeroDisc: bool = Disc == XZR;
    let mut Opcode: u32 = getPACOpcodeForKey(Key, IsZeroDisc);
    let mut PACInst: MCInst = MCInst {};
    PACInst.setOpcode(Opcode);
    PACInst.addOperand(createReg(Pointer.operator MCRegister()));
    PACInst.addOperand(createReg(Pointer.operator MCRegister()));
    if !IsZeroDisc {
        PACInst.addOperand(createReg(Disc.operator MCRegister()));
    }
    self.EmitToStreamer(PACInst);
}

fn AArch64AsmPrinter::emitBLRA(self, IsCall: bool, Key: ID, Target: Register, Disc: Register) {
    let mut IsZeroDisc: bool = Disc == XZR;
    let mut Opcode: u32 = getBranchOpcodeForKey(IsCall, Key, IsZeroDisc);
    let mut Inst: MCInst = MCInst {};
    Inst.setOpcode(Opcode);
    Inst.addOperand(createReg(Target.operator MCRegister()));
    if !IsZeroDisc {
        Inst.addOperand(createReg(Disc.operator MCRegister()));
    }
    self.EmitToStreamer(Inst);
}

fn AArch64AsmPrinter::emitFMov0(self, MI: *MachineInstr) {
    let mut DestReg: Register = MI.getOperand(0).getReg();
    if !self.STI.hasZeroCycleZeroingFPWorkaround() && self.STI.isNeonAvailable() {
        if self.STI.hasZeroCycleZeroingFPR64() {
            let mut TRI: *AArch64RegisterInfo = self.STI.getRegisterInfo();
            if FPR16RegClass.contains(DestReg.operator MCRegister()) {
                DestReg = TRI.getMatchingSuperReg(DestReg.operator MCRegister(), hsub, &mut FPR64RegClass);
            } else if FPR32RegClass.contains(DestReg.operator MCRegister()) {
                DestReg = TRI.getMatchingSuperReg(DestReg.operator MCRegister(), ssub, &mut FPR64RegClass);
            } else {
                assert!(FPR64RegClass.contains(DestReg.operator MCRegister();
            }
            let mut MOVI: MCInst = MCInst {};
            MOVI.setOpcode(MOVID);
            MOVI.addOperand(createReg(DestReg.operator MCRegister()));
            MOVI.addOperand(createImm(0));
            self.EmitToStreamer(operator(self.OutStreamer), MOVI);
            operator(NumZCZeroingInstrsFPR);
        } else if self.STI.hasZeroCycleZeroingFPR128() {
            let mut TRI: *AArch64RegisterInfo = self.STI.getRegisterInfo();
            if FPR16RegClass.contains(DestReg.operator MCRegister()) {
                DestReg = TRI.getMatchingSuperReg(DestReg.operator MCRegister(), hsub, &mut FPR128RegClass);
            } else if FPR32RegClass.contains(DestReg.operator MCRegister()) {
                DestReg = TRI.getMatchingSuperReg(DestReg.operator MCRegister(), ssub, &mut FPR128RegClass);
            } else {
                assert!(FPR64RegClass.contains(DestReg.operator MCRegister();
                DestReg = TRI.getMatchingSuperReg(DestReg.operator MCRegister(), dsub, &mut FPR128RegClass);
            }
            let mut MOVI: MCInst = MCInst {};
            MOVI.setOpcode(MOVIv2d_ns);
            MOVI.addOperand(createReg(DestReg.operator MCRegister()));
            MOVI.addOperand(createImm(0));
            self.EmitToStreamer(operator(self.OutStreamer), MOVI);
            operator(NumZCZeroingInstrsFPR);
        } else {
            self.emitFMov0AsFMov(MI, DestReg);
        }
    } else {
        self.emitFMov0AsFMov(MI, DestReg);
    }
}

fn AArch64AsmPrinter::emitFMov0AsFMov(self, MI: *MachineInstr, DestReg: Register) {
    let mut FMov: MCInst = MCInst {};
    match MI.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 2047);
        },
        FMOVH0 => {
            FMov.setOpcode(if self.STI.hasFullFP16() { FMOVWHr } else { FMOVWSr });
        },
        FMOVS0 => {
            FMov.setOpcode(FMOVWSr);
        },
        FMOVD0 => {
            FMov.setOpcode(FMOVXDr);
        },
    }
    self.EmitToStreamer(operator(self.OutStreamer), FMov);
}

fn AArch64AsmPrinter::emitPtrauthDiscriminator(self, Disc: u64, AddrDisc: Register, ScratchReg: Register, MayClobberAddrDisc: bool) -> Register {
    assert!(self.isPtrauthRegSafe(ScratchReg), "Safe scratch register must be provided by the caller");
    assert!(isUInt(Disc), "Constant discriminator is too wide");
    if !AddrDisc.isValid() {
        AddrDisc = XZR;
    }
    if !Disc {
        return AddrDisc;
    }
    if AddrDisc == XZR {
        self.emitMOVZ(ScratchReg, Disc, 0);
        return ScratchReg;
    }
    if MayClobberAddrDisc && self.isPtrauthRegSafe(AddrDisc) {
        ScratchReg = AddrDisc;
    } else {
        self.emitMovXReg(ScratchReg, AddrDisc);
        assert!(ScratchReg != AddrDisc, "Forbidden to clobber AddrDisc, but have to");
    }
    self.emitMOVK(ScratchReg, Disc, 48);
    return ScratchReg;
}

fn AArch64AsmPrinter::emitPtrauthCheckAuthenticatedValue(self, TestedReg: Register, ScratchReg: Register, Key: ID, Method: AuthCheckMethod, OnFailure: *MCSymbol) {
    if Method == None {
        return;
    }
    if Method == DummyLoad {
        self.EmitToStreamer(LDRWui.addReg(getWRegFromXReg(ScratchReg.operator MCRegister())).addReg(TestedReg.operator MCRegister()).addImm(0).operator llvm::MCInst &());
        assert!(!OnFailure, "DummyLoad always traps on error");
        return;
    }
    let mut SuccessSym: *mut MCSymbol = self.createTempSymbol("auth_success_");
    if Method == XPAC || Method == XPACHint {
        self.emitMovXReg(ScratchReg, TestedReg);
        if Method == XPAC {
            let mut XPACOpc: u32 = getXPACOpcodeForKey(Key);
            self.EmitToStreamer(XPACOpc.addReg(ScratchReg.operator MCRegister()).addReg(ScratchReg.operator MCRegister()).operator llvm::MCInst &());
        } else {
            assert!(TestedReg == LR, "XPACHint mode is only compatible with checking the LR register");
            assert!((Key == IA || Key == IB), "XPACHint mode is only compatible with I-keys");
            self.EmitToStreamer(XPACLRI.operator llvm::MCInst &());
        }
        self.EmitToStreamer(SUBSXrs.addReg(XZR).addReg(TestedReg.operator MCRegister()).addReg(ScratchReg.operator MCRegister()).addImm(0).operator llvm::MCInst &());
        self.EmitToStreamer(Bcc.addImm(EQ).addExpr(create(SuccessSym, self.OutContext, SMLoc {})).operator llvm::MCInst &());
    } else if Method == HighBitsNoTBI {
        self.EmitToStreamer(EORXrs.addReg(ScratchReg.operator MCRegister()).addReg(TestedReg.operator MCRegister()).addReg(TestedReg.operator MCRegister()).addImm(1).operator llvm::MCInst &());
        self.EmitToStreamer(TBZX.addReg(ScratchReg.operator MCRegister()).addImm(62).addExpr(create(SuccessSym, self.OutContext, SMLoc {})).operator llvm::MCInst &());
    } else {
        llvm_unreachable_internal("Unsupported check method", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 2207);
    }
    if !OnFailure {
        self.EmitToStreamer(BRK.addImm(50288 | Key).operator llvm::MCInst &());
    } else {
        match Method {
            XPACHint => {
                break;
            },
            XPAC => {
                self.emitMovXReg(TestedReg, ScratchReg);
            },
            _ => {
                let mut XPACOpc: u32 = getXPACOpcodeForKey(Key);
            },
        }
        let mut OnFailureExpr: *MCSymbolRefExpr = create(OnFailure, self.OutContext, SMLoc {});
        self.EmitToStreamer(B.addExpr(OnFailureExpr).operator llvm::MCInst &());
    }
    operator(self.OutStreamer).emitLabel(SuccessSym, SMLoc {});
}

fn AArch64AsmPrinter::emitPtrauthTailCallHardening(self, TC: *MachineInstr) {
    if !self.AArch64FI.shouldSignReturnAddress(*self.MF) {
        return;
    }
    let mut LRCheckMethod: AuthCheckMethod = self.STI.getAuthenticatedLRCheckMethod(*self.MF);
    if LRCheckMethod == None {
        return;
    }
    let mut TRI: *AArch64RegisterInfo = self.STI.getRegisterInfo();
    let mut ScratchReg: Register = if TC.readsRegister(X16, TRI) { X17 } else { X16 };
    assert!(!TC.readsRegister(ScratchReg, TRI), "Neither x16 nor x17 is available as a scratch register");
    let mut Key: ID = if self.AArch64FI.shouldSignWithBKey() { IB } else { IA };
    self.emitPtrauthCheckAuthenticatedValue(LR, ScratchReg, Key, LRCheckMethod, null);
}

fn AArch64AsmPrinter::emitDeactivationSymbolRelocation(self, DS: *mut Value) -> bool {
    if !DS {
        return false;
    }
    if isa(DS) {
        self.EmitToStreamer(NOP.operator llvm::MCInst &());
        return true;
    }
    let mut Dot: *mut MCSymbol = self.OutContext.createTempSymbol();
    operator(self.OutStreamer).emitLabel(Dot, SMLoc {});
    let mut DeactDotExpr: *MCExpr = create(Dot, self.OutContext, SMLoc {});
    let mut DSExpr: *MCExpr = create(self.OutContext.getOrCreateSymbol(DS.getName()), self.OutContext, SMLoc {});
    operator(self.OutStreamer).emitRelocDirective(*DeactDotExpr, "R_AARCH64_PATCHINST", DSExpr, SMLoc {});
    return false;
}

fn PtrAuthSchema@AArch64AsmPrinter@?A0xCB7B40D2::CreateImmReg(self, Key: ID, IntDisc: u64, AddrDiscOp: *MachineOperand) -> PtrAuthSchema {
    let mut Schema: PtrAuthSchema = PtrAuthSchema {};
    Schema.Key = Key;
    Schema.IntDisc = IntDisc;
    Schema.AddrDisc = AddrDiscOp.getReg();
    Schema.AddrDiscIsKilled = AddrDiscOp.isKill();
    Schema.PCDisc = Register { Reg: 0 };
    return Schema;
}

fn PtrAuthSchema@AArch64AsmPrinter@?A0xCB7B40D2::CreateRegReg(self, Key: ID, AddrDisc: Register, PCDisc: Register) -> PtrAuthSchema {
    assert!(PCDisc.isValid(), "Use CreateImmReg for non-PC schemas");
    let mut Schema: PtrAuthSchema = PtrAuthSchema {};
    Schema.Key = Key;
    Schema.IntDisc = 0;
    Schema.AddrDisc = AddrDisc;
    Schema.AddrDiscIsKilled = false;
    Schema.PCDisc = PCDisc;
    return Schema;
}

fn AArch64AsmPrinter::emitPtrauthApplyIndirectAddend(self, Pointer: Register, Scratch: Register, Addend: i64) {
    if isInt(Addend) {
        self.EmitToStreamer(LDRSWpre.addReg(Pointer.operator MCRegister()).addReg(Scratch.operator MCRegister()).addReg(Pointer.operator MCRegister()).addImm(Addend).operator llvm::MCInst &());
    } else {
        if isUInt(Addend) {
            for let mut BitPos: i32 = 0; BitPos != 24 && (Addend >> BitPos); BitPos += 12 {
                self.EmitToStreamer(ADDXri.addReg(Pointer.operator MCRegister()).addReg(Pointer.operator MCRegister()).addImm((Addend >> BitPos) & 4095).addImm(getShifterImm(LSL, BitPos)).operator llvm::MCInst &());
            }
        } else {
            self.emitMOVZ(Scratch, Addend & 65535, 0);
            for let mut Offset: i32 = 16; Offset < 64; Offset += 16 {
                if (Addend >> Offset) & 65535 {
                    Fragment;
                } else {
                    self.emitMOVK(Scratch, Fragment, Offset);
                }
            }
            self.EmitToStreamer(ADDXrs.addReg(Pointer.operator MCRegister()).addReg(Pointer.operator MCRegister()).addReg(Scratch.operator MCRegister()).addImm(0).operator llvm::MCInst &());
        }
        self.EmitToStreamer(LDRSWui.addReg(Scratch.operator MCRegister()).addReg(Pointer.operator MCRegister()).addImm(0).operator llvm::MCInst &());
    }
    self.EmitToStreamer(ADDXrs.addReg(Pointer.operator MCRegister()).addReg(Pointer.operator MCRegister()).addReg(Scratch.operator MCRegister()).addImm(0).operator llvm::MCInst &());
}

fn getCheckMode(MF: *MachineFunction) -> PtrauthCheckMode {
    let mut STI: *AArch64Subtarget = MF.getSubtarget();
    if PtrauthAuthChecks.getNumOccurrences() {
        return PtrauthAuthChecks.operator PtrauthCheckMode();
    }
    if STI.hasFPAC() {
        return Unchecked;
    }
    let mut ShouldTrap: bool = MF.getFunction().hasFnAttribute("ptrauth-auth-traps");
    return if ShouldTrap { Trap } else { Poison };
}

fn AArch64AsmPrinter::emitPtrauthAuthResign(self, Pointer: Register, Scratch: Register, AuthSchema: PtrAuthSchema, SignSchema: optional<PtrAuthSchema>, Addend: optional<int64_t>, DS: *mut Value) {
    let mut CheckMode: PtrauthCheckMode = getCheckMode(self.MF);
    let mut IsAuthWithPC: bool = AuthSchema.PCDisc.isValid();
    assert!(!SignSchema || !operator(SignSchema).PCDisc.isValid();
    let mut SignAddrDiscOrNone: Register = if SignSchema { operator(SignSchema).AddrDisc } else { Register { Reg: 0 } };
    if IsAuthWithPC {
        assert!(Pointer == X17 && Scratch == X16, "AUTPCPAC must use x17/x16 as Pointer/Scratch");
        assert!(AuthSchema.AddrDisc == X16, "AUTPCPAC requires address discriminator in X16");
        assert!(AuthSchema.PCDisc == X15, "AUTPCPAC requires PC discriminator in X15");
        assert!(AuthSchema.IntDisc == 0, "AUTPCPAC does not support IntDisc");
        assert!((AuthSchema.Key == IB || AuthSchema.Key == IA), "AUTPCPAC only supports AUT-ing with IA/IB");
        if !self.emitDeactivationSymbolRelocation(DS) {
            let mut AutOpc: u32 = if (AuthSchema.Key == IB) { AUTIB171615 } else { AUTIA171615 };
            self.EmitToStreamer(AutOpc.operator llvm::MCInst &());
        }
    } else {
        let mut AUTDiscReg: Register = self.emitPtrauthDiscriminator(AuthSchema.IntDisc, AuthSchema.AddrDisc, Scratch, AuthSchema.addrDiscIsKilledAndNoneOf([Pointer, SignAddrDiscOrNone]));
        if !self.emitDeactivationSymbolRelocation(DS) {
            self.emitAUT(AuthSchema.Key, Pointer, AUTDiscReg);
        }
    }
    let mut EmitCheck: Closure_4 = Closure_4 { cap_0: self, Pointer: &mut Pointer, Scratch: &mut Scratch, AuthSchema: &mut AuthSchema };
    let mut EmitResignOnSuccess: Closure_5 = Closure_5 { Addend: &mut Addend, cap_1: self, Pointer: &mut Pointer, Scratch: &mut Scratch, SignSchema: &mut SignSchema };
    if !SignSchema {
        if CheckMode == Trap {
            EmitCheck.call(null);
        }
        return;
    }
    match CheckMode {
        Unchecked => {
            EmitResignOnSuccess.call();
        },
        Trap => {
            EmitCheck.call(null);
        },
        Poison => {
            let mut OnFailure: *mut MCSymbol = self.createTempSymbol("resign_end_");
        },
    }
}

fn AArch64AsmPrinter::emitPtrauthSign(self, MI: *MachineInstr) {
    let mut Val: Register = MI.getOperand(1).getReg();
    let mut Key: ID = MI.getOperand(2).getImm() as ID;
    let mut Disc: u64 = MI.getOperand(3).getImm();
    let mut AddrDisc: Register = MI.getOperand(4).getReg();
    let mut AddrDiscKilled: bool = MI.getOperand(4).isKill();
    let mut ScratchReg: Register = if Val == X16 { X17 } else { X16 };
    assert!(ScratchReg != AddrDisc, "Neither X16 nor X17 is available as a scratch register");
    let mut DiscReg: Register = self.emitPtrauthDiscriminator(Disc, AddrDisc, ScratchReg, AddrDiscKilled);
    if self.emitDeactivationSymbolRelocation(MI.getDeactivationSymbol()) {
        return;
    }
    self.emitPAC(Key, Val, DiscReg);
}

fn AArch64AsmPrinter::emitPtrauthBranch(self, MI: *MachineInstr) {
    let mut IsCall: bool = MI.getOpcode() == BLRA;
    let mut BrTarget: u32 = MI.getOperand(0).getReg().operator unsigned int();
    let mut Key: ID = MI.getOperand(1).getImm() as ID;
    let mut Disc: u64 = MI.getOperand(2).getImm();
    let mut AddrDisc: u32 = MI.getOperand(3).getReg().operator unsigned int();
    if BrTarget == AddrDisc {
        report_fatal_error("Branch target is signed with its own value", true);
    }
    let mut AddrDiscIsImplicitDef: bool = IsCall && (AddrDisc == X16 || AddrDisc == X17);
    let mut DiscReg: Register = self.emitPtrauthDiscriminator(Disc, AddrDisc, X17, AddrDiscIsImplicitDef);
    self.emitBLRA(IsCall, Key, BrTarget, DiscReg);
}

fn AArch64AsmPrinter::emitAddImm(self, Reg: MCRegister, Addend: i64, Tmp: MCRegister) {
    if Addend != 0 {
        let mut AbsOffset: u64 = (if Addend > 0 { Addend } else { -(Addend as u64) });
        let mut IsNeg: bool = Addend < 0;
        if isUInt(AbsOffset) {
            for let mut BitPos: i32 = 0; BitPos != 24 && (AbsOffset >> BitPos); BitPos += 12 {
                self.EmitToStreamer(if IsNeg { SUBXri } else { ADDXri }.addReg(Reg).addReg(Reg).addImm((AbsOffset >> BitPos) & 4095).addImm(getShifterImm(LSL, BitPos)).operator llvm::MCInst &());
            }
        } else {
            let mut UAddend: u64 = Addend;
            self.EmitToStreamer(if IsNeg { MOVNXi } else { MOVZXi }.addReg(Tmp).addImm((if IsNeg { ~UAddend } else { UAddend }) & 65535).addImm(0).operator llvm::MCInst &());
            let mut NeedMovk: Closure_6 = Closure_6 { IsNeg: IsNeg, UAddend: UAddend };
            for let mut BitPos: i32 = 16; BitPos != 64 && NeedMovk.call(BitPos); BitPos += 16 {
                self.emitMOVK(Tmp, (UAddend >> BitPos) & 65535, BitPos);
            }
            self.EmitToStreamer(ADDXrs.addReg(Reg).addReg(Reg).addReg(Tmp).addImm(0).operator llvm::MCInst &());
        }
    }
}

fn AArch64AsmPrinter::emitAddress(self, Reg: MCRegister, Expr: *MCExpr, Tmp: MCRegister, DSOLocal: bool, STI: *MCSubtargetInfo) {
    let mut Val: MCValue = MCValue {};
    if !Expr.evaluateAsRelocatable(Val, null) {
        report_fatal_error("emitAddress could not evaluate", true);
    }
    if DSOLocal {
        self.EmitToStreamer(ADRP.addReg(Reg).addExpr(create(Expr, S_ABS_PAGE, operator(self.OutStreamer).getContext(), SMLoc {})).operator llvm::MCInst &());
        self.EmitToStreamer(ADDXri.addReg(Reg).addReg(Reg).addExpr(create(Expr, S_LO12, operator(self.OutStreamer).getContext(), SMLoc {})).addImm(0).operator llvm::MCInst &());
    } else {
        let mut SymRef: *MCSymbolRefExpr = create(Val.getAddSym(), operator(self.OutStreamer).getContext(), SMLoc {});
        self.EmitToStreamer(ADRP.addReg(Reg).addExpr(create(SymRef, S_GOT_PAGE, operator(self.OutStreamer).getContext(), SMLoc {})).operator llvm::MCInst &());
        self.EmitToStreamer(LDRXui.addReg(Reg).addReg(Reg).addExpr(create(SymRef, S_GOT_LO12, operator(self.OutStreamer).getContext(), SMLoc {})).operator llvm::MCInst &());
        self.emitAddImm(Reg, Val.getConstant(), Tmp);
    }
}

fn targetSupportsIRelativeRelocation(TT: *Triple) -> bool {
    if !TT.isOSBinFormatELF() {
        return false;
    }
    return TT.isOSGlibc() || TT.isAndroid() || TT.isOSFreeBSD() || TT.isOSDragonFly() || TT.isOSNetBSD();
}

fn AArch64AsmPrinter::emitPAuthRelocationAsIRelative(self, Target: *MCExpr, Disc: u64, KeyID: ID, HasAddressDiversity: bool, IsDSOLocal: bool, DSExpr: *MCExpr) -> *MCExpr {
    let mut TT: *Triple = self.TM.getTargetTriple();
    if !targetSupportsIRelativeRelocation(TT) {
        return null;
    }
    if KeyID != DA {
        return null;
    }
    let mut STI: AArch64Subtarget> = make_unique(TT, self.TM.getTargetCPU(), self.TM.getTargetCPU(), self.TM.getTargetFeatureString(), self.TM, true);
    self.STI = STI.get();
    let mut Place: *mut MCSymbol = operator(self.OutStreamer).getContext().createTempSymbol();
    operator(self.OutStreamer).emitLabel(Place, SMLoc {});
    operator(self.OutStreamer).pushSection();
    let mut Group: *MCSymbolELF = operator(self.OutStreamer).getCurrentSectionOnly() as *mut MCSectionELF.getGroup();
    let mut Flags: u32 = SHF_ALLOC | SHF_EXECINSTR;
    if Group {
        Flags |= SHF_GROUP;
    }
    operator(self.OutStreamer).switchSection(operator(self.OutStreamer).getContext().getELFSection(".text.startup", SHT_PROGBITS, Flags, 0, Group, true, if Group { NonUniqueID } else { self.PAuthIFuncNextUniqueID += 1 }, null), 0);
    let mut IRelativeSym: *mut MCSymbol = operator(self.OutStreamer).getContext().createLinkerPrivateSymbol("pauth_ifunc");
    operator(self.OutStreamer).emitLabel(IRelativeSym, SMLoc {});
    if isa(Target) {
        operator(self.OutStreamer).emitInstruction(MOVZXi.addReg(X0).addExpr(Target).addImm(0).operator llvm::MCInst &(), operator(STI));
    } else {
        self.emitAddress(X0, Target, X16, IsDSOLocal, operator(STI));
    }
    if HasAddressDiversity {
        let mut PlacePlusDisc: *MCBinaryExpr = createAdd(create(Place, operator(self.OutStreamer).getContext(), SMLoc {}), create(Disc, operator(self.OutStreamer).getContext(), false, 0), operator(self.OutStreamer).getContext(), SMLoc {});
        self.emitAddress(X1, PlacePlusDisc, X16, true, operator(STI));
    } else {
        if !isUInt(Disc) {
            self.OutContext.reportError(SMLoc {}, "AArch64 PAC Discriminator '" + Disc + "' out of range [0, 0xFFFF]");
        }
        self.emitMOVZ(X1, Disc, 0);
    }
    if DSExpr {
        let mut PrePACInst: *mut MCSymbol = operator(self.OutStreamer).getContext().createTempSymbol();
        operator(self.OutStreamer).emitLabel(PrePACInst, SMLoc {});
        let mut PrePACInstExpr: *MCSymbolRefExpr = create(PrePACInst, operator(self.OutStreamer).getContext(), SMLoc {});
        operator(self.OutStreamer).emitRelocDirective(*PrePACInstExpr, "R_AARCH64_PATCHINST", DSExpr, SMLoc {});
    }
    let mut EmuPAC: *mut MCSymbol = operator(self.OutStreamer).getContext().getOrCreateSymbol("__emupac_pacda");
    let mut EmuPACRef: *MCSymbolRefExpr = create(EmuPAC, operator(self.OutStreamer).getContext(), SMLoc {});
    operator(self.OutStreamer).emitInstruction(B.addExpr(EmuPACRef).operator llvm::MCInst &(), operator(STI));
    if DSExpr {
        operator(self.OutStreamer).emitInstruction(RET.addReg(LR).operator llvm::MCInst &(), operator(STI));
    }
    operator(self.OutStreamer).popSection();
    return create(create(IRelativeSym, operator(self.OutStreamer).getContext(), SMLoc {}), S_FUNCINIT, operator(self.OutStreamer).getContext(), SMLoc {});
}

fn AArch64AsmPrinter::lowerConstantPtrAuth(self, CPA: *ConstantPtrAuth) -> *MCExpr {
    let mut Ctx: *mut MCContext = self.OutContext;
    let mut Offset: APInt = APInt { 64, 0, false, false };
    let mut BaseGV: *Value = CPA.getPointer().stripAndAccumulateConstantOffsets(self.getDataLayout(), Offset, true, false, null, false);
    let mut BaseGVB: *GlobalValue = dyn_cast(BaseGV);
    let mut Sym: *MCExpr = null;
    if BaseGVB {
        Sym = create(self.getSymbol(BaseGVB), Ctx, SMLoc {});
        if Offset.sgt(0) {
            Sym = createAdd(Sym, create(Offset.getSExtValue(), Ctx, false, 0), Ctx, SMLoc {});
        } else if Offset.slt(0) {
            Sym = createSub(Sym, create((operator(Offset)).getSExtValue(), Ctx, false, 0), Ctx);
        }
    } else if isa(BaseGV) {
        Sym = create(Offset.getSExtValue(), Ctx, false, 0);
    } else {
        reportFatalUsageError("unsupported constant expression in ptrauth pointer");
    }
    let mut DSExpr: *MCExpr = null;
    if dyn_cast(CPA.getDeactivationSymbol()) {
        DS;
    } else {
        if isa(DS) {
            return Sym;
        }
        DSExpr = create(self.getSymbol(DS), Ctx, SMLoc {});
    }
    let mut KeyID: u64 = CPA.getKey().getZExtValue();
    if KeyID > LAST {
        CPA.getContext().emitError("AArch64 PAC Key ID '" + KeyID + "' out of range [0, " + LAST as u32 + "]");
        KeyID = 0;
    }
    let mut Disc: u64 = CPA.getDiscriminator().getZExtValue();
    if self.emitPAuthRelocationAsIRelative(Sym, Disc, KeyID, CPA.hasAddressDiscriminator(), BaseGVB && BaseGVB.isDSOLocal(), DSExpr) {
        IFuncSym;
    } else {
        return IFuncSym;
    }
    if !isUInt(Disc) {
        CPA.getContext().emitError("AArch64 PAC Discriminator '" + Disc + "' out of range [0, 0xFFFF]");
        Disc = 0;
    }
    if DSExpr {
        report_fatal_error("deactivation symbols unsupported in constant expressions on this target", true);
    }
    return create(Sym, Disc, KeyID, CPA.hasAddressDiscriminator(), Ctx, SMLoc {});
}

fn AArch64AsmPrinter::LowerLOADauthptrstatic(self, MI: *MachineInstr) {
    let mut DstReg: u32 = MI.getOperand(0).getReg().operator unsigned int();
    let mut GAOp: *MachineOperand = MI.getOperand(1);
    let mut KeyC: u64 = MI.getOperand(2).getImm();
    assert!(KeyC <= LAST, "key is out of range [0, AArch64PACKey::LAST]");
    let mut Key: ID = KeyC as ID;
    let mut Disc: u64 = MI.getOperand(3).getImm();
    assert!(isUInt(Disc), "constant discriminator is out of range [0, 0xffff]");
    let mut AuthPtrStubSym: *mut MCSymbol = null;
    if self.TM.getTargetTriple().isOSBinFormatELF() {
        let mut TLOF: *AArch64_ELFTargetObjectFile = self.getObjFileLowering() as AArch64_ELFTargetObjectFile;
        assert!(GAOp.getOffset() == 0, "non-zero offset for $auth_ptr$ stub slots is not supported");
        let mut GASym: *MCSymbol = self.TM.getSymbol(GAOp.getGlobal());
        AuthPtrStubSym = TLOF.getAuthPtrSlotSymbol(self.TM, self.MMI, GASym, Key, Disc);
    } else {
        assert!(self.TM.getTargetTriple().isOSBinFormatMachO(), "LOADauthptrstatic is implemented only for MachO/ELF");
        let mut TLOF: *AArch64_MachoTargetObjectFile = self.getObjFileLowering() as AArch64_MachoTargetObjectFile;
        assert!(GAOp.getOffset() == 0, "non-zero offset for $auth_ptr$ stub slots is not supported");
        let mut GASym: *MCSymbol = self.TM.getSymbol(GAOp.getGlobal());
        AuthPtrStubSym = TLOF.getAuthPtrSlotSymbol(self.TM, self.MMI, GASym, Key, Disc);
    }
    let mut StubMOHi: MachineOperand = CreateMCSymbol(AuthPtrStubSym, MO_PAGE);
    let mut StubMOLo: MachineOperand = CreateMCSymbol(AuthPtrStubSym, MO_PAGEOFF | MO_NC);
    let mut StubMCHi: MCOperand = MCOperand {};
    let mut StubMCLo: MCOperand = MCOperand {};
    self.MCInstLowering.lowerOperand(StubMOHi, StubMCHi);
    self.MCInstLowering.lowerOperand(StubMOLo, StubMCLo);
    self.EmitToStreamer(operator(self.OutStreamer), ADRP.addReg(DstReg).addOperand(StubMCHi).operator llvm::MCInst &());
    self.EmitToStreamer(operator(self.OutStreamer), LDRXui.addReg(DstReg).addReg(DstReg).addOperand(StubMCLo).operator llvm::MCInst &());
}

fn AArch64AsmPrinter::LowerMOVaddrPAC(self, MI: *MachineInstr) {
    let mut IsGOTLoad: bool = MI.getOpcode() == LOADgotPAC;
    let mut IsELFSignedGOT: bool = MI.getParent().getParent().getInfo().hasELFSignedGOT();
    let mut GAOp: MachineOperand = MI.getOperand(0);
    let mut KeyC: u64 = MI.getOperand(1).getImm();
    assert!(KeyC <= LAST, "key is out of range [0, AArch64PACKey::LAST]");
    let mut Key: ID = KeyC as ID;
    let mut AddrDisc: u32 = MI.getOperand(2).getReg().operator unsigned int();
    let mut Disc: u64 = MI.getOperand(3).getImm();
    let mut Offset: i64 = GAOp.getOffset();
    GAOp.setOffset(0);
    let mut GAMOHi: MachineOperand = GAOp;
    let mut GAMOLo: MachineOperand = GAOp;
    let mut GAMCHi: MCOperand = MCOperand {};
    let mut GAMCLo: MCOperand = MCOperand {};
    GAMOHi.setTargetFlags(MO_PAGE);
    GAMOLo.setTargetFlags(MO_PAGEOFF | MO_NC);
    if IsGOTLoad {
        GAMOHi.addTargetFlag(MO_GOT);
        GAMOLo.addTargetFlag(MO_GOT);
    }
    self.MCInstLowering.lowerOperand(GAMOHi, GAMCHi);
    self.MCInstLowering.lowerOperand(GAMOLo, GAMCLo);
    self.EmitToStreamer(ADRP.addReg(if IsGOTLoad && IsELFSignedGOT { X17 } else { X16 }).addOperand(GAMCHi).operator llvm::MCInst &());
    if IsGOTLoad {
        if IsELFSignedGOT {
            self.EmitToStreamer(ADDXri.addReg(X17).addReg(X17).addOperand(GAMCLo).addImm(0).operator llvm::MCInst &());
            self.EmitToStreamer(LDRXui.addReg(X16).addReg(X17).addImm(0).operator llvm::MCInst &());
            assert!(GAOp.isGlobal();
            assert!(GAOp.getGlobal().getValueType() != null);
            let mut IsFunctionTy: bool = GAOp.getGlobal().getValueType().isFunctionTy();
            let mut AuthKey: ID = if IsFunctionTy { IA } else { DA };
            self.emitAUT(AuthKey, X16, X17);
            if !self.STI.hasFPAC() {
                self.emitPtrauthCheckAuthenticatedValue(X16, X17, AuthKey, XPAC, null);
            }
        } else {
            self.EmitToStreamer(LDRXui.addReg(X16).addReg(X16).addOperand(GAMCLo).operator llvm::MCInst &());
        }
    } else {
        self.EmitToStreamer(ADDXri.addReg(X16).addReg(X16).addOperand(GAMCLo).addImm(0).operator llvm::MCInst &());
    }
    self.emitAddImm(X16, Offset, X17);
    let mut DiscReg: Register = self.emitPtrauthDiscriminator(Disc, AddrDisc, X17, false);
    self.emitPAC(Key, X16, DiscReg);
}

fn AArch64AsmPrinter::LowerLOADgotAUTH(self, MI: *MachineInstr) {
    let mut DstReg: Register = MI.getOperand(0).getReg();
    let mut AuthResultReg: Register = if self.STI.hasFPAC() { DstReg } else { X16 };
    let mut GAMO: *MachineOperand = MI.getOperand(1);
    assert!(GAMO.getOffset() == 0);
    if MI.getMF().getTarget().getCodeModel() == Tiny {
        let mut GAMC: MCOperand = MCOperand {};
        self.MCInstLowering.lowerOperand(GAMO, GAMC);
        self.EmitToStreamer(ADR.addReg(X17).addOperand(GAMC).operator llvm::MCInst &());
        self.EmitToStreamer(LDRXui.addReg(AuthResultReg.operator MCRegister()).addReg(X17).addImm(0).operator llvm::MCInst &());
    } else {
        let mut GAHiOp: MachineOperand = GAMO;
        let mut GALoOp: MachineOperand = GAMO;
        GAHiOp.addTargetFlag(MO_PAGE);
        GALoOp.addTargetFlag(MO_PAGEOFF | MO_NC);
        let mut GAMCHi: MCOperand = MCOperand {};
        let mut GAMCLo: MCOperand = MCOperand {};
        self.MCInstLowering.lowerOperand(GAHiOp, GAMCHi);
        self.MCInstLowering.lowerOperand(GALoOp, GAMCLo);
        self.EmitToStreamer(ADRP.addReg(X17).addOperand(GAMCHi).operator llvm::MCInst &());
        self.EmitToStreamer(ADDXri.addReg(X17).addReg(X17).addOperand(GAMCLo).addImm(0).operator llvm::MCInst &());
        self.EmitToStreamer(LDRXui.addReg(AuthResultReg.operator MCRegister()).addReg(X17).addImm(0).operator llvm::MCInst &());
    }
    assert!(GAMO.isGlobal();
    let mut UndefWeakSym: *mut MCSymbol = null;
    if GAMO.getGlobal().hasExternalWeakLinkage() {
        UndefWeakSym = self.createTempSymbol("undef_weak");
        self.EmitToStreamer(CBZX.addReg(AuthResultReg.operator MCRegister()).addExpr(create(UndefWeakSym, self.OutContext, SMLoc {})).operator llvm::MCInst &());
    }
    assert!(GAMO.getGlobal().getValueType() != null);
    let mut IsFunctionTy: bool = GAMO.getGlobal().getValueType().isFunctionTy();
    let mut AuthKey: ID = if IsFunctionTy { IA } else { DA };
    self.emitAUT(AuthKey, AuthResultReg, X17);
    if GAMO.getGlobal().hasExternalWeakLinkage() {
        operator(self.OutStreamer).emitLabel(UndefWeakSym, SMLoc {});
    }
    if !self.STI.hasFPAC() {
        self.emitPtrauthCheckAuthenticatedValue(AuthResultReg, X17, AuthKey, XPAC, null);
        self.emitMovXReg(DstReg, AuthResultReg);
    }
}

fn AArch64AsmPrinter::lowerBlockAddressConstant(self, BA: *BlockAddress) -> *MCExpr {
    let mut BAE: *MCExpr = self.lowerBlockAddressConstant(BA);
    let mut Fn: *Function = *BA.getFunction();
    if self.STI.getPtrAuthBlockAddressDiscriminatorIfEnabled(Fn) {
        BADisc;
    } else {
        return create(BAE, operator(BADisc), IA, false, self.OutContext, SMLoc {});
    }
    return BAE;
}

fn AArch64AsmPrinter::emitCBPseudoExpansion(self, MI: *MachineInstr) {
    let mut IsImm: bool = false;
    let mut Width: u32 = 0;
    match MI.getOpcode() {
        _ => {
            llvm_unreachable_internal("This is not a CB pseudo instruction", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 3136);
        },
        CBBAssertExt => {
            IsImm = false;
        },
        CBHAssertExt => {
            IsImm = false;
        },
        CBWPrr => {
            Width = 32;
        },
        CBXPrr => {
            Width = 64;
        },
        CBWPri => {
            IsImm = true;
        },
        CBXPri => {
            IsImm = true;
        },
    }
    let mut CC: CondCode = MI.getOperand(0).getImm() as CondCode;
    let mut NeedsRegSwap: bool = false;
    let mut NeedsImmDec: bool = false;
    let mut NeedsImmInc: bool = false;
    let mut MCOpC: u32 = 0;
    match CC {
        _ => {
            llvm_unreachable_internal("Invalid CB condition code", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 3181);
        },
        EQ => {
            MCOpC = (if IsImm { (if Width == 32 { CBEQWri } else { CBEQXri }) } else { (if Width == 8 { CBBEQWrr } else { (if Width == 16 { CBHEQWrr } else { (if Width == 32 { CBEQWrr } else { CBEQXrr }) }) }) });
        },
        NE => {
            MCOpC = (if IsImm { (if Width == 32 { CBNEWri } else { CBNEXri }) } else { (if Width == 8 { CBBNEWrr } else { (if Width == 16 { CBHNEWrr } else { (if Width == 32 { CBNEWrr } else { CBNEXrr }) }) }) });
        },
        HS => {
            MCOpC = (if IsImm { (if Width == 32 { CBHIWri } else { CBHIXri }) } else { (if Width == 8 { CBBHSWrr } else { (if Width == 16 { CBHHSWrr } else { (if Width == 32 { CBHSWrr } else { CBHSXrr }) }) }) });
        },
        LO => {
            MCOpC = (if IsImm { (if Width == 32 { CBLOWri } else { CBLOXri }) } else { (if Width == 8 { CBBHIWrr } else { (if Width == 16 { CBHHIWrr } else { (if Width == 32 { CBHIWrr } else { CBHIXrr }) }) }) });
        },
        HI => {
            MCOpC = (if IsImm { (if Width == 32 { CBHIWri } else { CBHIXri }) } else { (if Width == 8 { CBBHIWrr } else { (if Width == 16 { CBHHIWrr } else { (if Width == 32 { CBHIWrr } else { CBHIXrr }) }) }) });
        },
        LS => {
            MCOpC = (if IsImm { (if Width == 32 { CBLOWri } else { CBLOXri }) } else { (if Width == 8 { CBBHSWrr } else { (if Width == 16 { CBHHSWrr } else { (if Width == 32 { CBHSWrr } else { CBHSXrr }) }) }) });
        },
        GE => {
            MCOpC = (if IsImm { (if Width == 32 { CBGTWri } else { CBGTXri }) } else { (if Width == 8 { CBBGEWrr } else { (if Width == 16 { CBHGEWrr } else { (if Width == 32 { CBGEWrr } else { CBGEXrr }) }) }) });
        },
        LT => {
            MCOpC = (if IsImm { (if Width == 32 { CBLTWri } else { CBLTXri }) } else { (if Width == 8 { CBBGTWrr } else { (if Width == 16 { CBHGTWrr } else { (if Width == 32 { CBGTWrr } else { CBGTXrr }) }) }) });
        },
        GT => {
            MCOpC = (if IsImm { (if Width == 32 { CBGTWri } else { CBGTXri }) } else { (if Width == 8 { CBBGTWrr } else { (if Width == 16 { CBHGTWrr } else { (if Width == 32 { CBGTWrr } else { CBGTXrr }) }) }) });
        },
        LE => {
            MCOpC = (if IsImm { (if Width == 32 { CBLTWri } else { CBLTXri }) } else { (if Width == 8 { CBBGEWrr } else { (if Width == 16 { CBHGEWrr } else { (if Width == 32 { CBGEWrr } else { CBGEXrr }) }) }) });
        },
    }
    let mut Inst: MCInst = MCInst {};
    Inst.setOpcode(MCOpC);
    let mut Lhs: MCOperand = MCOperand {};
    let mut Rhs: MCOperand = MCOperand {};
    let mut Trgt: MCOperand = MCOperand {};
    self.lowerOperand(MI.getOperand(1), Lhs);
    self.lowerOperand(MI.getOperand(2), Rhs);
    self.lowerOperand(MI.getOperand(3), Trgt);
    if NeedsRegSwap {
        assert!(Lhs.isReg(), "Expected register operand for CB");
        assert!(Rhs.isReg(), "Expected register operand for CB");
        Inst.addOperand(Rhs);
        Inst.addOperand(Lhs);
    } else if NeedsImmDec {
        Rhs.setImm(Rhs.getImm() - 1);
        Inst.addOperand(Lhs);
        Inst.addOperand(Rhs);
    } else if NeedsImmInc {
        Rhs.setImm(Rhs.getImm() + 1);
        Inst.addOperand(Lhs);
        Inst.addOperand(Rhs);
    } else {
        Inst.addOperand(Lhs);
        Inst.addOperand(Rhs);
    }
    assert!((!IsImm || (Rhs.getImm() >= 0 && Rhs.getImm() < 64)), "CB immediate operand out-of-bounds");
    Inst.addOperand(Trgt);
    self.EmitToStreamer(operator(self.OutStreamer), Inst);
}

fn AArch64AsmPrinter::emitAtomicHintPseudoExpansion(self, MI: *MachineInstr) {
    let mut StOpc: u32 = 0;
    let mut Relaxed: u32 = MI.getOperand(2).getImm();
    assert!(Relaxed < 2, "Atomic hint relaxed immediate out-of-bounds");
    match MI.getOpcode() {
        ATOMIC_STORE_HINT_B => {
            StOpc = if Relaxed { STRBBui } else { STLRB };
        },
        ATOMIC_STORE_HINT_H => {
            StOpc = if Relaxed { STRHHui } else { STLRH };
        },
        ATOMIC_STORE_HINT_W => {
            StOpc = if Relaxed { STRWui } else { STLRW };
        },
        ATOMIC_STORE_HINT_X => {
            StOpc = if Relaxed { STRXui } else { STLRX };
        },
        _ => {
            llvm_unreachable_internal("Unexpected atomic hint size.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 3276);
        },
    }
    self.EmitToStreamer(HINT.addImm(MI.getOperand(3).getImm()).operator llvm::MCInst &());
    let mut Store: MCInst = MCInst {};
    Store.setOpcode(StOpc);
    Store.addOperand(createReg(MI.getOperand(0).getReg().operator MCRegister()));
    Store.addOperand(createReg(MI.getOperand(1).getReg().operator MCRegister()));
    Store.setFlags(MI.getFlags());
    if Relaxed {
        Store.addOperand(createImm(0));
    }
    self.EmitToStreamer(operator(self.OutStreamer), Store);
}

fn AArch64AsmPrinter::emitAtomicHintPseudoExpansionRO(self, MI: *MachineInstr) {
    let mut StOpc: u32 = 0;
    assert!(MI.getOperand(5).getImm() == 1, "Atomic store addressing mode only supports relaxed stores");
    match MI.getOpcode() {
        ATOMIC_STORE_HINT_BroW => {
            StOpc = STRBBroW;
        },
        ATOMIC_STORE_HINT_HroW => {
            StOpc = STRHHroW;
        },
        ATOMIC_STORE_HINT_WroW => {
            StOpc = STRWroW;
        },
        ATOMIC_STORE_HINT_XroW => {
            StOpc = STRXroW;
        },
        ATOMIC_STORE_HINT_SroW => {
            StOpc = STRSroW;
        },
        ATOMIC_STORE_HINT_DroW => {
            StOpc = STRDroW;
        },
        ATOMIC_STORE_HINT_BroX => {
            StOpc = STRBBroX;
        },
        ATOMIC_STORE_HINT_HroX => {
            StOpc = STRHHroX;
        },
        ATOMIC_STORE_HINT_WroX => {
            StOpc = STRWroX;
        },
        ATOMIC_STORE_HINT_XroX => {
            StOpc = STRXroX;
        },
        ATOMIC_STORE_HINT_SroX => {
            StOpc = STRSroX;
        },
        ATOMIC_STORE_HINT_DroX => {
            StOpc = STRDroX;
        },
        _ => {
            llvm_unreachable_internal("Unexpected atomic hint opcode.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 3336);
        },
    }
    self.EmitToStreamer(HINT.addImm(MI.getOperand(6).getImm()).operator llvm::MCInst &());
    let mut Store: MCInst = MCInst {};
    Store.setOpcode(StOpc);
    Store.addOperand(createReg(MI.getOperand(0).getReg().operator MCRegister()));
    Store.addOperand(createReg(MI.getOperand(1).getReg().operator MCRegister()));
    Store.addOperand(createReg(MI.getOperand(2).getReg().operator MCRegister()));
    Store.addOperand(createImm(MI.getOperand(3).getImm()));
    Store.addOperand(createImm(MI.getOperand(4).getImm()));
    Store.setFlags(MI.getFlags());
    self.EmitToStreamer(operator(self.OutStreamer), Store);
}

fn AArch64AsmPrinter::emitAtomicHintPseudoExpansionImm(self, MI: *MachineInstr) {
    let mut StOpc: u32 = 0;
    assert!(MI.getOperand(3).getImm() == 1, "Atomic store addressing mode only supports relaxed stores");
    match MI.getOpcode() {
        ATOMIC_STORE_HINT_Bui => {
            StOpc = STRBBui;
        },
        ATOMIC_STORE_HINT_Hui => {
            StOpc = STRHHui;
        },
        ATOMIC_STORE_HINT_Wui => {
            StOpc = STRWui;
        },
        ATOMIC_STORE_HINT_Xui => {
            StOpc = STRXui;
        },
        ATOMIC_STORE_HINT_Sui => {
            StOpc = STRSui;
        },
        ATOMIC_STORE_HINT_Dui => {
            StOpc = STRDui;
        },
        ATOMIC_STORE_HINT_Bi => {
            StOpc = STURBBi;
        },
        ATOMIC_STORE_HINT_Hi => {
            StOpc = STURHHi;
        },
        ATOMIC_STORE_HINT_Wi => {
            StOpc = STURWi;
        },
        ATOMIC_STORE_HINT_Xi => {
            StOpc = STURXi;
        },
        ATOMIC_STORE_HINT_Si => {
            StOpc = STURSi;
        },
        ATOMIC_STORE_HINT_Di => {
            StOpc = STURDi;
        },
        _ => {
            llvm_unreachable_internal("Unexpected atomic hint opcode.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 3397);
        },
    }
    self.EmitToStreamer(HINT.addImm(MI.getOperand(4).getImm()).operator llvm::MCInst &());
    let mut Store: MCInst = MCInst {};
    Store.setOpcode(StOpc);
    Store.addOperand(createReg(MI.getOperand(0).getReg().operator MCRegister()));
    Store.addOperand(createReg(MI.getOperand(1).getReg().operator MCRegister()));
    Store.addOperand(createImm(MI.getOperand(2).getImm()));
    Store.setFlags(MI.getFlags());
    self.EmitToStreamer(operator(self.OutStreamer), Store);
}

fn AArch64AsmPrinter::EmitToStreamer(self, S: *mut MCStreamer, Inst: *MCInst) {
    S.emitInstruction(Inst, *self.STI);
    self.InstsEmitted += 1;
}

fn AArch64AsmPrinter::emitInstruction(self, MI: *MachineInstr) {
    verifyInstructionPredicates(MI.getOpcode(), self.STI.getFeatureBits());
    self.InstsEmitted = 0;
    let mut CheckMISize: Closure_7 = Closure_7 { cap_0: self, MI: &mut MI };
    let mut OutInst: MCInst = MCInst {};
    if self.lowerPseudoInstExpansion(MI, OutInst) {
        self.EmitToStreamer(operator(self.OutStreamer), OutInst);
        return;
    }
    if MI.getOpcode() == ADRP {
        for Opd in MI.operands() {
            if Opd.isSymbol() && Opd.getSymbolName() == "swift_async_extendedFramePointerFlags" {
                self.ShouldEmitWeakSwiftAsyncExtendedFramePointerFlags = true;
            }
        }
    }
    if self.AArch64FI.getLOHRelated().count(MI) {
        let mut LOHLabel: *mut MCSymbol = self.createTempSymbol("loh");
        self.LOHInstToLabel[MI] = LOHLabel;
        operator(self.OutStreamer).emitLabel(LOHLabel, SMLoc {});
    }
    let mut TS: *mut AArch64TargetStreamer = operator(self.OutStreamer).getTargetStreamer() as *mut AArch64TargetStreamer;
    match MI.getOpcode() {
        _ => {
            assert!(!isTailCallReturnInst(*MI), "Unhandled tail call instruction");
        },
        READ_REGISTER_GPR64 => {
            self.EmitToStreamer(operator(self.OutStreamer), ORRXrs.addReg(MI.getOperand(0).getReg().operator MCRegister()).addReg(XZR).addReg(MI.getOperand(1).getImm()).addImm(0).operator llvm::MCInst &());
        },
        READ_REGISTER_FPR64 => {
            self.EmitToStreamer(operator(self.OutStreamer), FMOVDr.addReg(MI.getOperand(0).getReg().operator MCRegister()).addReg(MI.getOperand(1).getImm()).operator llvm::MCInst &());
        },
        HINT => {
            if self.CurrentPatchableFunctionEntrySym && self.CurrentPatchableFunctionEntrySym == self.CurrentFnBegin && MI == &mut self.MF.front().front() {
                let mut Imm: i64 = MI.getOperand(0).getImm();
                if Imm == 32 || Imm == 34 || Imm == 36 || Imm == 38 {
                    let mut Inst: MCInst = MCInst {};
                    self.MCInstLowering.Lower(MI, Inst);
                    self.EmitToStreamer(operator(self.OutStreamer), Inst);
                    self.CurrentPatchableFunctionEntrySym = self.createTempSymbol("patch");
                    operator(self.OutStreamer).emitLabel(self.CurrentPatchableFunctionEntrySym, SMLoc {});
                    return;
                }
            }
            break;
        },
        MOVMCSym => {
            let mut DestReg: Register = MI.getOperand(0).getReg();
            let mut MO_Sym: *MachineOperand = MI.getOperand(1);
            let mut Hi_MOSym: MachineOperand = MO_Sym;
            let mut Lo_MOSym: MachineOperand = MO_Sym;
            let mut Hi_MCSym: MCOperand = MCOperand {};
            let mut Lo_MCSym: MCOperand = MCOperand {};
            Hi_MOSym.setTargetFlags(MO_G1 | MO_S);
            Lo_MOSym.setTargetFlags(MO_G0 | MO_NC);
            self.MCInstLowering.lowerOperand(Hi_MOSym, Hi_MCSym);
            self.MCInstLowering.lowerOperand(Lo_MOSym, Lo_MCSym);
            let mut MovZ: MCInst = MCInst {};
            MovZ.setOpcode(MOVZXi);
            MovZ.addOperand(createReg(DestReg.operator MCRegister()));
            MovZ.addOperand(Hi_MCSym);
            MovZ.addOperand(createImm(16));
            self.EmitToStreamer(operator(self.OutStreamer), MovZ);
            let mut MovK: MCInst = MCInst {};
            MovK.setOpcode(MOVKXi);
            MovK.addOperand(createReg(DestReg.operator MCRegister()));
            MovK.addOperand(createReg(DestReg.operator MCRegister()));
            MovK.addOperand(Lo_MCSym);
            MovK.addOperand(createImm(0));
            self.EmitToStreamer(operator(self.OutStreamer), MovK);
            return;
        },
        MOVIv2d_ns => {
            if self.STI.hasZeroCycleZeroingFPWorkaround() && MI.getOperand(1).getImm() == 0 {
                let mut TmpInst: MCInst = MCInst {};
                TmpInst.setOpcode(MOVIv16b_ns);
                TmpInst.addOperand(createReg(MI.getOperand(0).getReg().operator MCRegister()));
                TmpInst.addOperand(createImm(0));
                self.EmitToStreamer(operator(self.OutStreamer), TmpInst);
                return;
            }
        },
        DBG_VALUE => {
            DBG_VALUE_LIST;
        },
        EMITBKEY => {
            let mut ExceptionHandlingType: ExceptionHandling = self.MAI.getExceptionHandlingType();
            if ExceptionHandlingType != DwarfCFI && ExceptionHandlingType != ARM {
                return;
            }
            if self.getFunctionCFISectionType(*self.MF) == None {
                return;
            }
            operator(self.OutStreamer).emitCFIBKeyFrame();
            return;
        },
        EMITMTETAGGED => {
            let mut ExceptionHandlingType: ExceptionHandling = self.MAI.getExceptionHandlingType();
            if ExceptionHandlingType != DwarfCFI && ExceptionHandlingType != ARM {
                return;
            }
            if self.getFunctionCFISectionType(*self.MF) != None {
                operator(self.OutStreamer).emitCFIMTETaggedFrame();
            }
            return;
        },
        AUTx16x17 => {
            let mut Pointer: Register = X16;
            let mut Scratch: Register = X17;
            let mut AuthSchema: PtrAuthSchema = CreateImmReg(MI.getOperand(0).getImm() as ID, MI.getOperand(1).getImm(), MI.getOperand(2));
            self.emitPtrauthAuthResign(Pointer, Scratch, AuthSchema, nullopt, nullopt, MI.getDeactivationSymbol());
            return;
        },
        AUTxMxN => {
            let mut Pointer: Register = MI.getOperand(0).getReg();
            let mut Scratch: Register = MI.getOperand(1).getReg();
            let mut AuthSchema: PtrAuthSchema = CreateImmReg(MI.getOperand(3).getImm() as ID, MI.getOperand(4).getImm(), MI.getOperand(5));
            self.emitPtrauthAuthResign(Pointer, Scratch, AuthSchema, nullopt, nullopt, MI.getDeactivationSymbol());
            return;
        },
        AUTPAC => {
            let mut Pointer: Register = X16;
            let mut Scratch: Register = X17;
            let mut AuthSchema: PtrAuthSchema = CreateImmReg(MI.getOperand(0).getImm() as ID, MI.getOperand(1).getImm(), MI.getOperand(2));
            let mut SignSchema: PtrAuthSchema = CreateImmReg(MI.getOperand(3).getImm() as ID, MI.getOperand(4).getImm(), MI.getOperand(5));
            self.emitPtrauthAuthResign(Pointer, Scratch, AuthSchema, SignSchema, nullopt, MI.getDeactivationSymbol());
            return;
        },
        AUTPCPAC => {
            let mut AuthSchema: PtrAuthSchema = CreateRegReg(MI.getOperand(0).getImm() as ID, X16, X15);
            let mut SignSchema: PtrAuthSchema = CreateImmReg(MI.getOperand(1).getImm() as ID, MI.getOperand(2).getImm(), MI.getOperand(3));
            self.emitPtrauthAuthResign(X17, X16, AuthSchema, SignSchema, nullopt, MI.getDeactivationSymbol());
            return;
        },
        AUTRELLOADPAC => {
            let mut Pointer: Register = X16;
            let mut Scratch: Register = X17;
            let mut AuthSchema: PtrAuthSchema = CreateImmReg(MI.getOperand(0).getImm() as ID, MI.getOperand(1).getImm(), MI.getOperand(2));
            let mut SignSchema: PtrAuthSchema = CreateImmReg(MI.getOperand(3).getImm() as ID, MI.getOperand(4).getImm(), MI.getOperand(5));
            self.emitPtrauthAuthResign(Pointer, Scratch, AuthSchema, SignSchema, MI.getOperand(6).getImm(), MI.getDeactivationSymbol());
            return;
        },
        PAC => {
            self.emitPtrauthSign(MI);
        },
        LOADauthptrstatic => {
            self.LowerLOADauthptrstatic(*MI);
        },
        LOADgotPAC => {
            MOVaddrPAC;
        },
        LOADgotAUTH => {
            self.LowerLOADgotAUTH(*MI);
        },
        BRA => {
            BLRA;
        },
        AUTH_TCRETURN => {
            AUTH_TCRETURN_BTI;
        },
        TCRETURNri => {
            TCRETURNrix16x17;
        },
        TCRETURNdi => {
            self.emitPtrauthTailCallHardening(MI);
            let mut Dest: MCOperand = MCOperand {};
            self.MCInstLowering.lowerOperand(MI.getOperand(0), Dest);
            self.recordIfImportCall(MI);
            let mut TmpInst: MCInst = MCInst {};
            TmpInst.setOpcode(B);
            TmpInst.addOperand(Dest);
            self.EmitToStreamer(operator(self.OutStreamer), TmpInst);
            return;
        },
        SpeculationBarrierISBDSBEndBB => {
            let mut TmpInstDSB: MCInst = MCInst {};
            TmpInstDSB.setOpcode(DSB);
            TmpInstDSB.addOperand(createImm(15));
            self.EmitToStreamer(operator(self.OutStreamer), TmpInstDSB);
            let mut TmpInstISB: MCInst = MCInst {};
            TmpInstISB.setOpcode(ISB);
            TmpInstISB.addOperand(createImm(15));
            self.EmitToStreamer(operator(self.OutStreamer), TmpInstISB);
            return;
        },
        SpeculationBarrierSBEndBB => {
            let mut TmpInstSB: MCInst = MCInst {};
            TmpInstSB.setOpcode(SB);
            self.EmitToStreamer(operator(self.OutStreamer), TmpInstSB);
            return;
        },
        TLSDESC_AUTH_CALLSEQ => {
            let mut MO_Sym: *MachineOperand = MI.getOperand(0);
            let mut MO_TLSDESC_LO12: MachineOperand = MO_Sym;
            let mut MO_TLSDESC: MachineOperand = MO_Sym;
            let mut Sym: MCOperand = MCOperand {};
            let mut SymTLSDescLo12: MCOperand = MCOperand {};
            let mut SymTLSDesc: MCOperand = MCOperand {};
            MO_TLSDESC_LO12.setTargetFlags(MO_TLS | MO_PAGEOFF);
            MO_TLSDESC.setTargetFlags(MO_TLS | MO_PAGE);
            self.MCInstLowering.lowerOperand(MO_Sym, Sym);
            self.MCInstLowering.lowerOperand(MO_TLSDESC_LO12, SymTLSDescLo12);
            self.MCInstLowering.lowerOperand(MO_TLSDESC, SymTLSDesc);
            let mut Adrp: MCInst = MCInst {};
            Adrp.setOpcode(ADRP);
            Adrp.addOperand(createReg(X0));
            Adrp.addOperand(SymTLSDesc);
            self.EmitToStreamer(operator(self.OutStreamer), Adrp);
            let mut Ldr: MCInst = MCInst {};
            Ldr.setOpcode(LDRXui);
            Ldr.addOperand(createReg(X16));
            Ldr.addOperand(createReg(X0));
            Ldr.addOperand(SymTLSDescLo12);
            Ldr.addOperand(createImm(0));
            self.EmitToStreamer(operator(self.OutStreamer), Ldr);
            let mut Add: MCInst = MCInst {};
            Add.setOpcode(ADDXri);
            Add.addOperand(createReg(X0));
            Add.addOperand(createReg(X0));
            Add.addOperand(SymTLSDescLo12);
            Add.addOperand(createImm(getShiftValue(0)));
            self.EmitToStreamer(operator(self.OutStreamer), Add);
            let mut TLSAuthDescCall: MCInst = MCInst {};
            TLSAuthDescCall.setOpcode(TLSAUTHDESCCALL);
            TLSAuthDescCall.addOperand(Sym);
            self.EmitToStreamer(operator(self.OutStreamer), TLSAuthDescCall);
            self.InstsEmitted -= 1;
            let mut Blraa: MCInst = MCInst {};
            Blraa.setOpcode(BLRAA);
            Blraa.addOperand(createReg(X16));
            Blraa.addOperand(createReg(X0));
            self.EmitToStreamer(operator(self.OutStreamer), Blraa);
            return;
        },
        TLSDESC_CALLSEQ => {
            let mut MO_Sym: *MachineOperand = MI.getOperand(0);
            let mut MO_TLSDESC_LO12: MachineOperand = MO_Sym;
            let mut MO_TLSDESC: MachineOperand = MO_Sym;
            let mut Sym: MCOperand = MCOperand {};
            let mut SymTLSDescLo12: MCOperand = MCOperand {};
            let mut SymTLSDesc: MCOperand = MCOperand {};
            MO_TLSDESC_LO12.setTargetFlags(MO_TLS | MO_PAGEOFF);
            MO_TLSDESC.setTargetFlags(MO_TLS | MO_PAGE);
            self.MCInstLowering.lowerOperand(MO_Sym, Sym);
            self.MCInstLowering.lowerOperand(MO_TLSDESC_LO12, SymTLSDescLo12);
            self.MCInstLowering.lowerOperand(MO_TLSDESC, SymTLSDesc);
            let mut Adrp: MCInst = MCInst {};
            Adrp.setOpcode(ADRP);
            Adrp.addOperand(createReg(X0));
            Adrp.addOperand(SymTLSDesc);
            self.EmitToStreamer(operator(self.OutStreamer), Adrp);
            let mut Ldr: MCInst = MCInst {};
            if self.STI.isTargetILP32() {
                Ldr.setOpcode(LDRWui);
                Ldr.addOperand(createReg(W1));
            } else {
                Ldr.setOpcode(LDRXui);
                Ldr.addOperand(createReg(X1));
            }
            Ldr.addOperand(createReg(X0));
            Ldr.addOperand(SymTLSDescLo12);
            Ldr.addOperand(createImm(0));
            self.EmitToStreamer(operator(self.OutStreamer), Ldr);
            let mut Add: MCInst = MCInst {};
            if self.STI.isTargetILP32() {
                Add.setOpcode(ADDWri);
                Add.addOperand(createReg(W0));
                Add.addOperand(createReg(W0));
            } else {
                Add.setOpcode(ADDXri);
                Add.addOperand(createReg(X0));
                Add.addOperand(createReg(X0));
            }
            Add.addOperand(SymTLSDescLo12);
            Add.addOperand(createImm(getShiftValue(0)));
            self.EmitToStreamer(operator(self.OutStreamer), Add);
            let mut TLSDescCall: MCInst = MCInst {};
            TLSDescCall.setOpcode(TLSDESCCALL);
            TLSDescCall.addOperand(Sym);
            self.EmitToStreamer(operator(self.OutStreamer), TLSDescCall);
            self.InstsEmitted -= 1;
            let mut Blr: MCInst = MCInst {};
            Blr.setOpcode(BLR);
            Blr.addOperand(createReg(X1));
            self.EmitToStreamer(operator(self.OutStreamer), Blr);
            return;
        },
        JumpTableDest32 => {
            JumpTableDest16;
        },
        BR_JumpTable => {
            self.LowerHardenedBRJumpTable(*MI);
        },
        FMOVH0 => {
            FMOVS0;
        },
        MOPSMemoryCopyPseudo => {
            MOPSMemoryMovePseudo;
        },
        STACKMAP => {
            return self.LowerSTACKMAP(operator(self.OutStreamer), self.SM, *MI);
        },
        PATCHPOINT => {
            return self.LowerPATCHPOINT(operator(self.OutStreamer), self.SM, *MI);
        },
        STATEPOINT => {
            return self.LowerSTATEPOINT(operator(self.OutStreamer), self.SM, *MI);
        },
        FAULTING_OP => {
            return self.LowerFAULTING_OP(*MI);
        },
        PATCHABLE_FUNCTION_ENTER => {
            self.LowerPATCHABLE_FUNCTION_ENTER(*MI);
        },
        PATCHABLE_FUNCTION_EXIT => {
            self.LowerPATCHABLE_FUNCTION_EXIT(*MI);
        },
        PATCHABLE_TAIL_CALL => {
            self.LowerPATCHABLE_TAIL_CALL(*MI);
        },
        PATCHABLE_EVENT_CALL => {
            return self.LowerPATCHABLE_EVENT_CALL(*MI, false);
        },
        PATCHABLE_TYPED_EVENT_CALL => {
            return self.LowerPATCHABLE_EVENT_CALL(*MI, true);
        },
        KCFI_CHECK => {
            self.LowerKCFI_CHECK(*MI);
        },
        HWASAN_CHECK_MEMACCESS => {
            HWASAN_CHECK_MEMACCESS_SHORTGRANULES;
        },
        SEH_StackAlloc => {
            TS.emitARM64WinCFIAllocStack(MI.getOperand(0).getImm());
        },
        SEH_SaveFPLR => {
            TS.emitARM64WinCFISaveFPLR(MI.getOperand(0).getImm());
        },
        SEH_SaveFPLR_X => {
            assert!(MI.getOperand(0).getImm() < 0, "Pre increment SEH opcode must have a negative offset");
        },
        SEH_SaveReg => {
            TS.emitARM64WinCFISaveReg(MI.getOperand(0).getImm(), MI.getOperand(1).getImm());
        },
        SEH_SaveReg_X => {
            assert!(MI.getOperand(1).getImm() < 0, "Pre increment SEH opcode must have a negative offset");
        },
        SEH_SaveRegP => {
            if MI.getOperand(1).getImm() == 30 && MI.getOperand(0).getImm() >= 19 && MI.getOperand(0).getImm() <= 28 {
                assert!((MI.getOperand(0).getImm() - 19) % 2 == 0, "Register paired with LR must be odd");
                TS.emitARM64WinCFISaveLRPair(MI.getOperand(0).getImm(), MI.getOperand(2).getImm());
                return;
            }
        },
        SEH_SaveRegP_X => {
            assert!((MI.getOperand(1).getImm() - MI.getOperand(0).getImm() == 1), "Non-consecutive registers not allowed for save_regp_x");
        },
        SEH_SaveFReg => {
            TS.emitARM64WinCFISaveFReg(MI.getOperand(0).getImm(), MI.getOperand(1).getImm());
        },
        SEH_SaveFReg_X => {
            assert!(MI.getOperand(1).getImm() < 0, "Pre increment SEH opcode must have a negative offset");
        },
        SEH_SaveFRegP => {
            assert!((MI.getOperand(1).getImm() - MI.getOperand(0).getImm() == 1), "Non-consecutive registers not allowed for save_regp");
        },
        SEH_SaveFRegP_X => {
            assert!((MI.getOperand(1).getImm() - MI.getOperand(0).getImm() == 1), "Non-consecutive registers not allowed for save_regp_x");
        },
        SEH_SetFP => {
            TS.emitARM64WinCFISetFP();
        },
        SEH_AddFP => {
            TS.emitARM64WinCFIAddFP(MI.getOperand(0).getImm());
        },
        SEH_Nop => {
            TS.emitARM64WinCFINop();
        },
        SEH_PrologEnd => {
            TS.emitARM64WinCFIPrologEnd();
        },
        SEH_EpilogStart => {
            TS.emitARM64WinCFIEpilogStart();
        },
        SEH_EpilogEnd => {
            TS.emitARM64WinCFIEpilogEnd();
        },
        SEH_PACSignLR => {
            TS.emitARM64WinCFIPACSignLR();
        },
        SEH_SaveAnyRegI => {
            assert!(MI.getOperand(1).getImm() <= 1008, "SaveAnyRegQP SEH opcode offset must fit into 6 bits");
        },
        SEH_SaveAnyRegIP => {
            assert!(MI.getOperand(1).getImm() - MI.getOperand(0).getImm() == 1, "Non-consecutive registers not allowed for save_any_reg");
        },
        SEH_SaveAnyRegQP => {
            assert!(MI.getOperand(1).getImm() - MI.getOperand(0).getImm() == 1, "Non-consecutive registers not allowed for save_any_reg");
        },
        SEH_SaveAnyRegQPX => {
            assert!(MI.getOperand(1).getImm() - MI.getOperand(0).getImm() == 1, "Non-consecutive registers not allowed for save_any_reg");
        },
        SEH_AllocZ => {
            assert!(MI.getOperand(0).getImm() >= 0, "AllocZ SEH opcode offset must be non-negative");
        },
        SEH_SaveZReg => {
            assert!(MI.getOperand(1).getImm() >= 0, "SaveZReg SEH opcode offset must be non-negative");
        },
        SEH_SavePReg => {
            assert!(MI.getOperand(1).getImm() >= 0, "SavePReg SEH opcode offset must be non-negative");
        },
        BLR => {
            BR;
        },
        CBWPri => {
            CBXPri;
        },
        ATOMIC_STORE_HINT_B => {
            ATOMIC_STORE_HINT_H;
        },
        ATOMIC_STORE_HINT_BroW => {
            ATOMIC_STORE_HINT_HroW;
        },
        ATOMIC_STORE_HINT_Bui => {
            ATOMIC_STORE_HINT_Hui;
        },
    }
    if self.emitDeactivationSymbolRelocation(MI.getDeactivationSymbol()) {
        return;
    }
    let mut TmpInst: MCInst = MCInst {};
    self.MCInstLowering.Lower(MI, TmpInst);
    self.EmitToStreamer(operator(self.OutStreamer), TmpInst);
}

fn AArch64AsmPrinter::recordIfImportCall(self, BranchInst: *MachineInstr) {
    if !self.EnableImportCallOptimization {
        return;
    }
    if GV && GV.hasDLLImportStorageClass() {
        let mut CallSiteSymbol: *mut MCSymbol = self.MMI.getContext().createNamedTempSymbol("impcall");
        operator(self.OutStreamer).emitLabel(CallSiteSymbol, SMLoc {});
        let mut CalledSymbol: *mut MCSymbol = self.MCInstLowering.GetGlobalValueSymbol(GV, OpFlags);
        self.SectionToImportedFunctionCalls[operator(self.OutStreamer).getCurrentSectionOnly()].push(MCSymbol *> { CallSiteSymbol, CalledSymbol });
    }
}

fn AArch64AsmPrinter::emitMachOIFuncStubBody(self, M: *mut Module, GI: *GlobalIFunc, LazyPointer: *mut MCSymbol) {
    {
        let mut Adrp: MCInst = MCInst {};
        Adrp.setOpcode(ADRP);
        Adrp.addOperand(createReg(X16));
        let mut SymPage: MCOperand = MCOperand {};
        self.MCInstLowering.lowerOperand(CreateMCSymbol(LazyPointer, MO_GOT | MO_PAGE), SymPage);
        Adrp.addOperand(SymPage);
        self.EmitToStreamer(Adrp);
    }
    {
        let mut Ldr: MCInst = MCInst {};
        Ldr.setOpcode(LDRXui);
        Ldr.addOperand(createReg(X16));
        Ldr.addOperand(createReg(X16));
        let mut SymPageOff: MCOperand = MCOperand {};
        self.MCInstLowering.lowerOperand(CreateMCSymbol(LazyPointer, MO_GOT | MO_PAGEOFF), SymPageOff);
        Ldr.addOperand(SymPageOff);
        Ldr.addOperand(createImm(0));
        self.EmitToStreamer(Ldr);
    }
    self.EmitToStreamer(LDRXui.addReg(X16).addReg(X16).addImm(0).operator llvm::MCInst &());
    self.EmitToStreamer(if self.TM.getTargetTriple().isArm64e() { BRAAZ } else { BR }.addReg(X16).operator llvm::MCInst &());
}

fn AArch64AsmPrinter::emitMachOIFuncStubHelperBody(self, M: *mut Module, GI: *GlobalIFunc, LazyPointer: *mut MCSymbol) {
    self.EmitToStreamer(STPXpre.addReg(SP).addReg(FP).addReg(LR).addReg(SP).addImm(-2).operator llvm::MCInst &());
    self.EmitToStreamer(ADDXri.addReg(FP).addReg(SP).addImm(0).addImm(0).operator llvm::MCInst &());
    for let mut I: i32 = 0; I != 4; I += 1 {
        self.EmitToStreamer(STPXpre.addReg(SP).addReg(X1 + 2 * I).addReg(X0 + 2 * I).addReg(SP).addImm(-2).operator llvm::MCInst &());
    }
    for let mut I: i32 = 0; I != 4; I += 1 {
        self.EmitToStreamer(STPDpre.addReg(SP).addReg(D1 + 2 * I).addReg(D0 + 2 * I).addReg(SP).addImm(-2).operator llvm::MCInst &());
    }
    self.EmitToStreamer(BL.addOperand(createExpr(self.lowerConstant(GI.getResolver(), null, 0))).operator llvm::MCInst &());
    {
        let mut Adrp: MCInst = MCInst {};
        Adrp.setOpcode(ADRP);
        Adrp.addOperand(createReg(X16));
        let mut SymPage: MCOperand = MCOperand {};
        self.MCInstLowering.lowerOperand(CreateES(LazyPointer.getName().ptr + 1, MO_GOT | MO_PAGE), SymPage);
        Adrp.addOperand(SymPage);
        self.EmitToStreamer(Adrp);
    }
    {
        let mut Ldr: MCInst = MCInst {};
        Ldr.setOpcode(LDRXui);
        Ldr.addOperand(createReg(X16));
        Ldr.addOperand(createReg(X16));
        let mut SymPageOff: MCOperand = MCOperand {};
        self.MCInstLowering.lowerOperand(CreateES(LazyPointer.getName().ptr + 1, MO_GOT | MO_PAGEOFF), SymPageOff);
        Ldr.addOperand(SymPageOff);
        Ldr.addOperand(createImm(0));
        self.EmitToStreamer(Ldr);
    }
    self.EmitToStreamer(STRXui.addReg(X0).addReg(X16).addImm(0).operator llvm::MCInst &());
    self.EmitToStreamer(ADDXri.addReg(X16).addReg(X0).addImm(0).addImm(0).operator llvm::MCInst &());
    for let mut I: i32 = 3; I != -1; I -= 1 {
        self.EmitToStreamer(LDPDpost.addReg(SP).addReg(D1 + 2 * I).addReg(D0 + 2 * I).addReg(SP).addImm(2).operator llvm::MCInst &());
    }
    for let mut I: i32 = 3; I != -1; I -= 1 {
        self.EmitToStreamer(LDPXpost.addReg(SP).addReg(X1 + 2 * I).addReg(X0 + 2 * I).addReg(SP).addImm(2).operator llvm::MCInst &());
    }
    self.EmitToStreamer(LDPXpost.addReg(SP).addReg(FP).addReg(LR).addReg(SP).addImm(2).operator llvm::MCInst &());
    self.EmitToStreamer(if self.TM.getTargetTriple().isArm64e() { BRAAZ } else { BR }.addReg(X16).operator llvm::MCInst &());
}

fn AArch64AsmPrinter::lowerConstant(self, CV: *Constant, BaseCV: *Constant, Offset: u64) -> *MCExpr {
    if dyn_cast(CV) {
        GV;
    } else {
        return create(self.MCInstLowering.GetGlobalValueSymbol(GV, 0), self.OutContext, SMLoc {});
    }
    return self.lowerConstant(CV, BaseCV, Offset);
}

static mut ID: i8 = 0;

fn LLVMInitializeAArch64AsmPrinter() {
    let mut X: RegisterAsmPrinter<AArch64AsmPrinter> = getTheAArch64leTarget();
    let mut Y: RegisterAsmPrinter<AArch64AsmPrinter> = getTheAArch64beTarget();
    let mut Z: RegisterAsmPrinter<AArch64AsmPrinter> = getTheARM64Target();
    let mut W: RegisterAsmPrinter<AArch64AsmPrinter> = getTheARM64_32Target();
    let mut V: RegisterAsmPrinter<AArch64AsmPrinter> = getTheAArch64_32Target();
}

fn AArch64AsmPrinterBeginPass::run(self, M: *mut Module, MAM: *mut ModuleAnalysisManager) -> PreservedAnalyses {
    let mut AsmPrinter: *mut AArch64AsmPrinter = MAM.getResult(M).getPrinter() as AArch64AsmPrinter;
    setupModuleAsmPrinter(M, MAM, AsmPrinter);
    AsmPrinter.doInitialization(M);
    return all();
}

fn AArch64AsmPrinterPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut AsmPrinter: *mut AArch64AsmPrinter = MFAM.getResult(MF).getCachedResult(*MF.getFunction().getParent()).getPrinter() as AArch64AsmPrinter;
    setupMachineFunctionAsmPrinter(MFAM, MF, AsmPrinter);
    AsmPrinter.runOnMachineFunction(MF);
    return all();
}

fn AArch64AsmPrinterEndPass::run(self, M: *mut Module, MAM: *mut ModuleAnalysisManager) -> PreservedAnalyses {
    let mut AsmPrinter: *mut AArch64AsmPrinter = MAM.getResult(M).getPrinter() as AArch64AsmPrinter;
    setupModuleAsmPrinter(M, MAM, AsmPrinter);
    AsmPrinter.doFinalization(M);
    return all();
}

struct Closure_1 {
    cap_0: *mut AArch64AsmPrinter,
}

fn Closure_1::call(self: *Closure_1, Src: *mut MCSymbol, Dst: *mut MCSymbol) {
            operator(self.OutStreamer).emitSymbolAttribute(Src, MCSA_WeakAntiDep);
            operator(self.OutStreamer).emitAssignment(Src, create(Dst, self.MMI.getContext(), SMLoc {}));
        }

struct Closure_2 {
    cap_0: *mut AArch64AsmPrinter,
}

fn Closure_2::call(self: *Closure_2, Name: str) -> *mut MCSymbol {
            let mut Sym: *mut MCSymbol = null;
            if self.MF.getFunction().getMetadata(Name) {
                Node;
            } else {
                let mut NameStr: str = cast(Node.getOperand(0)).getString();
                Sym = self.MMI.getContext().getOrCreateSymbol(NameStr);
            }
            return Sym;
        }

struct Closure_3 {
    Opcode: u32,
}

fn Closure_3::call(self: *mut Closure_3) -> auto {
        if self.Opcode == MOPSMemoryCopyPseudo {
            return array<unsigned int, 3> { [CPYFP, CPYFM, CPYFE] };
        }
        if self.Opcode == MOPSMemoryMovePseudo {
            return array<unsigned int, 3> { [CPYP, CPYM, CPYE] };
        }
        if self.Opcode == MOPSMemorySetPseudo {
            return array<unsigned int, 3> { [SETP, SETM, SETE] };
        }
        if self.Opcode == MOPSMemorySetTaggingPseudo {
            return array<unsigned int, 3> { [SETGP, SETGM, MOPSSETGE] };
        }
        llvm_unreachable_internal("Unhandled memory operation pseudo", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64AsmPrinter.cpp", 1754);
    }

struct Closure_4 {
    cap_0: *mut AArch64AsmPrinter,
    Pointer: *mut Register,
    Scratch: *mut Register,
    AuthSchema: *mut PtrAuthSchema,
}

unsafe fn Closure_4::call(self: *mut Closure_4, OnFailure: *mut MCSymbol) {
        self.emitPtrauthCheckAuthenticatedValue((*self.Pointer), (*self.Scratch), (*self.AuthSchema).Key, XPAC, OnFailure);
    }

struct Closure_5 {
    Addend: *mut optional<int64_t>,
    cap_1: *mut AArch64AsmPrinter,
    Pointer: *mut Register,
    Scratch: *mut Register,
    SignSchema: *mut optional<PtrAuthSchema>,
}

unsafe fn Closure_5::call(self: *mut Closure_5) {
        if (*self.Addend).has_value() {
            self.emitPtrauthApplyIndirectAddend((*self.Pointer), (*self.Scratch), operator((*self.Addend)));
        }
        assert!((*self.Pointer) != operator((*self.SignSchema)).AddrDisc, "Pointer is early-clobbered");
        let mut PACDiscReg: Register = self.emitPtrauthDiscriminator(operator((*self.SignSchema)).IntDisc, operator((*self.SignSchema)).AddrDisc, (*self.Scratch), operator((*self.SignSchema)).AddrDiscIsKilled);
        self.emitPAC(operator((*self.SignSchema)).Key, (*self.Pointer), PACDiscReg);
    }

struct Closure_6 {
    IsNeg: bool,
    UAddend: u64,
}

fn Closure_6::call(self: *mut Closure_6, BitPos: i32) -> auto {
                assert!(BitPos == 16 || BitPos == 32 || BitPos == 48);
                let mut Shifted: u64 = self.UAddend >> BitPos;
                if !self.IsNeg {
                    return Shifted != 0;
                }
                for let mut I: i32 = 0; I != 64 - BitPos; I += 16 {
                    if ((Shifted >> I) & 65535) != 65535 {
                        return true;
                    }
                }
                return false;
            }

struct Closure_7 {
    cap_0: *mut AArch64AsmPrinter,
    MI: *mut *MachineInstr,
}

unsafe fn Closure_7::call(self: *mut Closure_7) {
        assert!(self.STI.getInstrInfo().getInstSizeInBytes(*(*self.MI)) >= self.InstsEmitted * 4);
    }
