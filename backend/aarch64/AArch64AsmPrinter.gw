    let mut EmitResignOnSuccess: Closure_5 = Closure_5 { Addend: &mut Addend, cap_1: self, Pointer: &mut Pointer, Scratch: &mut Scratch };
    if operator!() {
        if CheckMode == Trap {
            EmitCheck.call(null);
        }
        return;
    }
    match CheckMode {
        Unchecked => {
            EmitResignOnSuccess.call();
