fn isOdd(reg: u32) -> bool {
    match reg {
        _ => {
            llvm_unreachable_internal("Register is not from the expected class !", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64PBQPRegAlloc.cpp", 37);
        },
        S1 => {
            S3;
        },
        S0 => {
            S2;
        },
    }
}

fn haveSameParity(reg1: u32, reg2: u32) -> bool {
    assert!(isFpOrNEON(reg1), "Expecting an FP register for reg1");
    assert!(isFpOrNEON(reg2), "Expecting an FP register for reg2");
    return isOdd(reg1) == isOdd(reg2);
}

fn A57ChainingConstraint::addIntraChainConstraint(self, G: *mut PBQPRAGraph, Rd: u32, Ra: u32) -> bool {
    if Rd == Ra {
        return false;
    }
    let mut LIs: *mut LiveIntervals = G.getMetadata().LIS;
    if isPhysicalRegister(Rd) || isPhysicalRegister(Ra) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-pbqp", 1) {
                dbgs() << "Rd is a physical reg:" << isPhysicalRegister(Rd) << 10;
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-pbqp", 1) {
                dbgs() << "Ra is a physical reg:" << isPhysicalRegister(Ra) << 10;
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut node1: NodeId = G.getMetadata().getNodeIdForVReg(Rd);
    let mut node2: NodeId = G.getMetadata().getNodeIdForVReg(Ra);
    let mut vRdAllowed: *AllowedRegVector = &mut G.getNodeMetadata(node1).getAllowedRegs();
    let mut vRaAllowed: *AllowedRegVector = &mut G.getNodeMetadata(node2).getAllowedRegs();
    let mut edge: EdgeId = G.findEdge(node1, node2);
    if edge == G.invalidEdgeId() {
        let mut ld: *LiveInterval = LIs.getInterval(Rd);
        let mut la: *LiveInterval = LIs.getInterval(Ra);
        let mut livesOverlap: bool = ld.overlaps(la);
        let mut costs: RawMatrix = RawMatrix { vRdAllowed.len + 1, vRaAllowed.len + 1, 0 };
        for let mut i: u32 = 0;
let mut ie: u32 = vRdAllowed.len; i != ie; i += 1 {
            let mut pRd: u32 = (*vRdAllowed)[i].operator unsigned int();
            for let mut j: u32 = 0;
let mut je: u32 = vRaAllowed.len; j != je; j += 1 {
                let mut pRa: u32 = (*vRaAllowed)[j].operator unsigned int();
                if livesOverlap && self.TRI.regsOverlap(pRd, pRa) {
                    costs[i + 1][j + 1] = infinity();
                } else {
                    costs[i + 1][j + 1] = if haveSameParity(pRd, pRa) { 0.0 } else { 1.0 };
                }
            }
        }
        G.addEdge(node1, node2, move(costs));
        return true;
    }
    if G.getEdgeNode1Id(edge) == node2 {
        swap(node1, node2);
        swap(vRdAllowed, vRaAllowed);
    }
    let mut costs: RawMatrix = G.getEdgeCosts(edge);
    for let mut i: u32 = 0;
let mut ie: u32 = vRdAllowed.len; i != ie; i += 1 {
        let mut pRd: u32 = (*vRdAllowed)[i].operator unsigned int();
        let mut sameParityMax: PBQPNum = min();
        for let mut j: u32 = 0;
let mut je: u32 = vRaAllowed.len; j != je; j += 1 {
            let mut pRa: u32 = (*vRaAllowed)[j].operator unsigned int();
            if haveSameParity(pRd, pRa) {
                if costs[i + 1][j + 1] != infinity() && costs[i + 1][j + 1] > sameParityMax {
                    sameParityMax = costs[i + 1][j + 1];
                }
            }
        }
        for let mut j: u32 = 0;
let mut je: u32 = vRaAllowed.len; j != je; j += 1 {
            let mut pRa: u32 = (*vRaAllowed)[j].operator unsigned int();
            if !haveSameParity(pRd, pRa) {
                if sameParityMax > costs[i + 1][j + 1] {
                    costs[i + 1][j + 1] = sameParityMax + 1.0;
                }
            }
        }
    }
    G.updateEdgeCosts(edge, move(costs));
    return true;
}

fn A57ChainingConstraint::addInterChainConstraint(self, G: *mut PBQPRAGraph, Rd: u32, Ra: u32) {
    let mut LIs: *mut LiveIntervals = G.getMetadata().LIS;
    if self.Chains.count(Ra) {
        if Rd != Ra {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-pbqp", 1) {
                    dbgs() << "Moving acc chain from " << printReg(Ra, self.TRI, 0, null) << " to " << printReg(Rd, self.TRI, 0, null) << 10;
                }
            }
                if !(false) { break; }
            }
            self.Chains.remove(Ra);
            self.Chains.insert(Rd);
        }
    } else {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-pbqp", 1) {
                dbgs() << "Creating new acc chain for " << printReg(Rd, self.TRI, 0, null) << 10;
            }
        }
            if !(false) { break; }
        }
        self.Chains.insert(Rd);
    }
    let mut node1: NodeId = G.getMetadata().getNodeIdForVReg(Rd);
    let mut ld: *LiveInterval = LIs.getInterval(Rd);
    for r in self.Chains {
        if r == Rd {
            continue;
        }
        let mut lr: *LiveInterval = LIs.getInterval(r);
        if ld.overlaps(lr) {
            let mut vRdAllowed: *AllowedRegVector = &mut G.getNodeMetadata(node1).getAllowedRegs();
            let mut node2: NodeId = G.getMetadata().getNodeIdForVReg(r);
            let mut vRrAllowed: *AllowedRegVector = &mut G.getNodeMetadata(node2).getAllowedRegs();
            let mut edge: EdgeId = G.findEdge(node1, node2);
            assert!(edge != G.invalidEdgeId(), "PBQP error ! The edge should exist !");
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-pbqp", 1) {
                    dbgs() << "Refining constraint !\n";
                }
            }
                if !(false) { break; }
            }
            if G.getEdgeNode1Id(edge) == node2 {
                swap(node1, node2);
                swap(vRdAllowed, vRrAllowed);
            }
            let mut costs: Matrix = G.getEdgeCosts(edge);
            for let mut i: u32 = 0;
let mut ie: u32 = vRdAllowed.len; i != ie; i += 1 {
                let mut pRd: u32 = (*vRdAllowed)[i].operator unsigned int();
                let mut sameParityMax: PBQPNum = min();
                for let mut j: u32 = 0;
let mut je: u32 = vRrAllowed.len; j != je; j += 1 {
                    let mut pRa: u32 = (*vRrAllowed)[j].operator unsigned int();
                    if !haveSameParity(pRd, pRa) {
                        if costs[i + 1][j + 1] != infinity() && costs[i + 1][j + 1] > sameParityMax {
                            sameParityMax = costs[i + 1][j + 1];
                        }
                    }
                }
                for let mut j: u32 = 0;
let mut je: u32 = vRrAllowed.len; j != je; j += 1 {
                    let mut pRa: u32 = (*vRrAllowed)[j].operator unsigned int();
                    if haveSameParity(pRd, pRa) {
                        if sameParityMax > costs[i + 1][j + 1] {
                            costs[i + 1][j + 1] = sameParityMax + 1.0;
                        }
                    }
                }
            }
            G.updateEdgeCosts(edge, move(costs));
        }
    }
}

fn regJustKilledBefore(LIs: *LiveIntervals, reg: u32, MI: *MachineInstr) -> bool {
    let mut LI: *LiveInterval = LIs.getInterval(reg);
    let mut SI: SlotIndex = LIs.getInstructionIndex(MI);
    return LI.expiredAt(SI);
}

fn A57ChainingConstraint::apply(self, G: *mut PBQPRAGraph) {
    let mut MF: *MachineFunction = G.getMetadata().MF;
    let mut LIs: *mut LiveIntervals = G.getMetadata().LIS;
    self.TRI = MF.getSubtarget().getRegisterInfo();
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-pbqp", 1) {
            MF.dump();
        }
    }
        if !(false) { break; }
    }
    for MBB in MF {
        self.Chains.clear();
        for MI in MBB {
            for r in self.Chains {
                let mut toDel: SmallVector<unsigned int, 8> = SmallVector<unsigned int, 8> {};
                if regJustKilledBefore(LIs, r, MI) {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("aarch64-pbqp", 1) {
                            dbgs() << "Killing chain " << printReg(r, self.TRI, 0, null) << " at ";
                            MI.print(dbgs(), true, false, false, true, null);
                        }
                    }
                        if !(false) { break; }
                    }
                    toDel.push(r);
                }
                while !toDel.is_empty() {
                    self.Chains.remove(toDel.back());
                    toDel.pop();
                }
            }
            match MI.getOpcode() {
                FMSUBSrrr => {
                    FMADDSrrr;
                },
                FMLAv2f32 => {
                    FMLSv2f32;
                },
                _ => {
                    break;
                },
            }
        }
    }
}
