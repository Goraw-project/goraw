        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
        self.addRegisterClass;
