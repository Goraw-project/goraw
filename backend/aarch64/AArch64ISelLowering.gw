    self.setOperationAction(LOAD, v4f64, Custom);
    self.setOperationAction(LOAD, v4i64, Custom);
    self.setOperationAction(READCYCLECOUNTER, i64, Legal);
    self.setOperationAction(FSINCOS, f64, Expand);
    self.setOperationAction(FSINCOS, f32, Expand);
    if self.Subtarget.isTargetMachO() && TM.getCodeModel() == Large {
        self.setOperationAction(ConstantFP, f32, Legal);
        self.setOperationAction(ConstantFP, f64, Legal);
    }
    if self.Subtarget() {
        self.setOperationAction(BITCAST, i16, Custom);
        self.setOperationAction(BITCAST, f16, Custom);
        self.setOperationAction(BITCAST, bf16, Custom);
    }
    for let mut im: u32 = PRE_INC as u32; im != LAST_INDEXED_MODE as u32; im += 1 {
        self.setIndexedLoadAction(im, i8, Legal);
        self.setIndexedLoadAction(im, i16, Legal);
        self.setIndexedLoadAction(im, i32, Legal);
        self.setIndexedLoadAction(im, i64, Legal);
        self.setIndexedLoadAction(im, f64, Legal);
        self.setIndexedLoadAction(im, f32, Legal);
        self.setIndexedLoadAction(im, f16, Legal);
        self.setIndexedLoadAction(im, bf16, Legal);
        self.setIndexedStoreAction(im, i8, Legal);
        self.setIndexedStoreAction(im, i16, Legal);
        self.setIndexedStoreAction(im, i32, Legal);
        self.setIndexedStoreAction(im, i64, Legal);
        self.setIndexedStoreAction(im, f64, Legal);
        self.setIndexedStoreAction(im, f32, Legal);
        self.setIndexedStoreAction(im, f16, Legal);
        self.setIndexedStoreAction(im, bf16, Legal);
    }
    self.setOperationAction(TRAP, Other, Legal);
    self.setOperationAction(DEBUGTRAP, Other, Legal);
    self.setOperationAction(UBSANTRAP, Other, Legal);
    self.setTargetDAGCombine(OR);
    self.setTargetDAGCombine(AND);
    self.setOperationAction(INIT_TRAMPOLINE, Other, Custom);
    self.setOperationAction(ADJUST_TRAMPOLINE, Other, Custom);
    self.setTargetDAGCombine;
    self.setTargetDAGCombine;
    self.setTargetDAGCombine(SETCC);
    self.setTargetDAGCombine(SELECT_CC);
    self.setTargetDAGCombine(SETCCCARRY);
    self.setTargetDAGCombine(INTRINSIC_WO_CHAIN);
    self.setTargetDAGCombine;
    self.setTargetDAGCombine;
    self.setTargetDAGCombine(TRUNCATE);
    self.setTargetDAGCombine(LOAD);
    self.setTargetDAGCombine(MSTORE);
    self.setTargetDAGCombine(MUL);
    self.setTargetDAGCombine;
    self.setTargetDAGCombine;
    self.setTargetDAGCombine;
    self.setTargetDAGCombine(FP_EXTEND);
    self.setTargetDAGCombine(GlobalAddress);
    self.setTargetDAGCombine(CTLZ);
    self.setTargetDAGCombine;
    self.setTargetDAGCombine(GET_ACTIVE_LANE_MASK);
    self.setTargetDAGCombine(VECREDUCE_AND);
    self.setTargetDAGCombine(VECREDUCE_OR);
    self.setTargetDAGCombine(VECREDUCE_XOR);
    self.setTargetDAGCombine(VECREDUCE_FADD);
    self.setTargetDAGCombine(VECREDUCE_SEQ_FADD);
    self.setTargetDAGCombine(SCALAR_TO_VECTOR);
    self.setTargetDAGCombine(SHL);
    self.setTargetDAGCombine(VECTOR_DEINTERLEAVE);
    self.setTargetDAGCombine(CTPOP);
    if self.Subtarget.isSVEorStreamingSVEAvailable() {
        self.setTargetDAGCombine(BITCAST);
    }
    self.MaxStoresPerMemsetOptSize = 8;
    self.MaxStoresPerMemset = if self.Subtarget() { self.MaxStoresPerMemsetOptSize } else { 32 };
    self.MaxGluedStoresPerMemcpy = 4;
    self.MaxStoresPerMemcpyOptSize = 4;
    self.MaxStoresPerMemcpy = if self.Subtarget() { self.MaxStoresPerMemcpyOptSize } else { 16 };
    self.MaxStoresPerMemmoveOptSize = 4;
    self.MaxStoresPerMemmove = if self.Subtarget() { self.MaxStoresPerMemmoveOptSize } else { 16 };
    self.MaxLoadsPerMemcmpOptSize = 4;
    self.MaxLoadsPerMemcmp = if self.Subtarget() { self.MaxLoadsPerMemcmpOptSize } else { 8 };
    self.setStackPointerRegisterToSaveRestore;
    self.setSchedulingPreference(Hybrid);
    self.EnableExtLdPromotion = true;
    self.setMinFunctionAlignment(4);
    if !self.Subtarget.isTargetWindows() {
        self.setPrefLoopAlignment(STI.getPrefLoopAlignment());
    }
    self.setMaxBytesForAlignment(STI.getMaxBytesForLoopAlignment());
    self.setPrefFunctionAlignment(STI.getPrefFunctionAlignment());
    let mut MaxJT: u32 = STI.getMaximumJumpTableSize();
    if MaxJT && self.getMaximumJumpTableSize() == 4294967295 {
        self.setMaximumJumpTableSize(MaxJT);
    }
    self.setHasExtractBitsInsn(true);
    self.setMaxDivRemBitWidthSupported(128);
    self.setOperationAction(INTRINSIC_WO_CHAIN, Other, Custom);
    if self.Subtarget() {
        self.setOperationAction(INTRINSIC_WO_CHAIN, i1, Custom);
    }
    if self.Subtarget.isNeonAvailable() {
        self.setOperationPromotedToType(UINT_TO_FP, v4i8, v4i32);
        self.setOperationPromotedToType(SINT_TO_FP, v4i8, v4i32);
        if self.Subtarget() {
            self.setOperationAction(ConstantFP, f16, Legal);
            self.setOperationAction(ConstantFP, bf16, Legal);
            self.setOperationAction(SINT_TO_FP, v8i8, Custom);
            self.setOperationAction(UINT_TO_FP, v8i8, Custom);
            self.setOperationAction(SINT_TO_FP, v16i8, Custom);
            self.setOperationAction(UINT_TO_FP, v16i8, Custom);
            self.setOperationAction(SINT_TO_FP, v4i16, Custom);
            self.setOperationAction(UINT_TO_FP, v4i16, Custom);
            self.setOperationAction(SINT_TO_FP, v8i16, Custom);
            self.setOperationAction(UINT_TO_FP, v8i16, Custom);
        } else {
            self.setOperationPromotedToType(SINT_TO_FP, v8i8, v8i32);
            self.setOperationPromotedToType(UINT_TO_FP, v8i8, v8i32);
            self.setOperationPromotedToType(UINT_TO_FP, v16i8, v16i32);
            self.setOperationPromotedToType(SINT_TO_FP, v16i8, v16i32);
            self.setOperationPromotedToType(UINT_TO_FP, v4i16, v4i32);
            self.setOperationPromotedToType(SINT_TO_FP, v4i16, v4i32);
            self.setOperationPromotedToType(SINT_TO_FP, v8i16, v8i32);
            self.setOperationPromotedToType(UINT_TO_FP, v8i16, v8i32);
        }
        self.setOperationAction(CTLZ, v1i64, Expand);
        self.setOperationAction(CTLZ, v2i64, Expand);
        self.setOperationAction(BITREVERSE, v8i8, Legal);
        self.setOperationAction(BITREVERSE, v16i8, Legal);
        self.setOperationAction(BITREVERSE, v2i32, Custom);
        self.setOperationAction(BITREVERSE, v4i32, Custom);
        self.setOperationAction(BITREVERSE, v1i64, Custom);
        self.setOperationAction(BITREVERSE, v2i64, Custom);
        self.setOperationAction(MUL, v8i16, Custom);
        self.setOperationAction(MUL, v4i32, Custom);
        self.setOperationAction(MUL, v2i64, Custom);
        self.setOperationAction(MUL, v4i16, Custom);
        self.setOperationAction(MUL, v2i32, Custom);
        self.setOperationAction(MUL, v1i64, Custom);
        if self.Subtarget() {
            self.setOperationAction(VECREDUCE_FADD, v2f16, Custom);
        }
        self.setOperationAction(VECREDUCE_ADD, v2i64, Custom);
        self.setOperationAction(VECREDUCE_AND, v2i64, Custom);
        self.setOperationAction(VECREDUCE_OR, v2i64, Custom);
        self.setOperationAction(VECREDUCE_XOR, v2i64, Custom);
        self.setOperationAction(ANY_EXTEND, v4i32, Legal);
        self.setTruncStoreAction(v2i32, v2i16, Expand);
        self.setTruncStoreAction(v4i16, v4i8, Custom);
        self.setTruncStoreAction(v2i32, v2i16, Custom);
        self.setOperationAction(BITCAST, i2, Custom);
        self.setOperationAction(BITCAST, i4, Custom);
        self.setOperationAction(BITCAST, i8, Custom);
        self.setOperationAction(BITCAST, i16, Custom);
        self.setOperationAction(BITCAST, v2i8, Custom);
        self.setOperationAction(BITCAST, v2i16, Custom);
        self.setOperationAction(BITCAST, v4i8, Custom);
        self.setLoadExtAction(EXTLOAD, v2i32, v2i8, Custom);
        self.setLoadExtAction(SEXTLOAD, v2i32, v2i8, Custom);
        self.setLoadExtAction(ZEXTLOAD, v2i32, v2i8, Custom);
        self.setLoadExtAction(EXTLOAD, v2i64, v2i8, Custom);
        self.setLoadExtAction(SEXTLOAD, v2i64, v2i8, Custom);
        self.setLoadExtAction(ZEXTLOAD, v2i64, v2i8, Custom);
        self.setLoadExtAction(EXTLOAD, v4i16, v4i8, Custom);
        self.setLoadExtAction(SEXTLOAD, v4i16, v4i8, Custom);
        self.setLoadExtAction(ZEXTLOAD, v4i16, v4i8, Custom);
        self.setLoadExtAction(EXTLOAD, v4i32, v4i8, Custom);
        self.setLoadExtAction(SEXTLOAD, v4i32, v4i8, Custom);
        self.setLoadExtAction(ZEXTLOAD, v4i32, v4i8, Custom);
        self.setLoadExtAction(EXTLOAD, v2i32, v2i16, Custom);
        self.setLoadExtAction(SEXTLOAD, v2i32, v2i16, Custom);
        self.setLoadExtAction(ZEXTLOAD, v2i32, v2i16, Custom);
        self.setLoadExtAction(EXTLOAD, v2i64, v2i16, Custom);
        self.setLoadExtAction(SEXTLOAD, v2i64, v2i16, Custom);
        self.setLoadExtAction(ZEXTLOAD, v2i64, v2i16, Custom);
        {
            let mut MLAOps: [2]u32 = [PARTIAL_REDUCE_SMLA, PARTIAL_REDUCE_UMLA];
        }
        if self.Subtarget() {
            let mut MLAOps: [2]u32 = [PARTIAL_REDUCE_SMLA, PARTIAL_REDUCE_UMLA];
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, v2i64, v16i8, Custom);
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, v2i32, v16i8, Custom);
            if self.Subtarget() {
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, v4i32, v16i8, Legal);
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, v2i32, v8i8, Legal);
            } else {
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, v4i32, v16i8, Custom);
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, v2i32, v8i8, Custom);
            }
        }
        if self.Subtarget() || self.Subtarget() {
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, v2f32, v4f16, Legal);
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, v4f32, v8f16, Legal);
        }
        if self.Subtarget() {
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, v4f32, v8bf16, Legal);
        }
        self.setOperationAction(CLMUL, i8, Custom);
        if self.Subtarget() {}
    } else {}
    self.setOperationAction(INTRINSIC_W_CHAIN, Other, Custom);
    if self.Subtarget.isSVEorStreamingSVEAvailable() {
        if self.Subtarget() && self.Subtarget.isSVEAvailable() {}
        self.setOperationAction(GET_ACTIVE_LANE_MASK, nxv1i1, Custom);
        self.setOperationAction(VECTOR_REVERSE, nxv1i1, Custom);
        if self.Subtarget.isSVEorStreamingSVEAvailable() && (self.Subtarget() || self.Subtarget()) {
            self.setOperationAction(GET_ACTIVE_LANE_MASK, nxv32i1, Custom);
        }
    }
    if self.Subtarget.isSVEorStreamingSVEAvailable() {
        self.setOperationPromotedToType(LOAD, aarch64svcount, nxv16i1);
        self.setOperationPromotedToType(STORE, aarch64svcount, nxv16i1);
        self.setOperationAction(SELECT, aarch64svcount, Custom);
        self.setOperationAction(SELECT_CC, aarch64svcount, Expand);
        self.setTruncStoreAction(nxv2i64, nxv2i8, Legal);
        self.setTruncStoreAction(nxv2i64, nxv2i16, Legal);
        self.setTruncStoreAction(nxv2i64, nxv2i32, Legal);
        self.setTruncStoreAction(nxv4i32, nxv4i8, Legal);
        self.setTruncStoreAction(nxv4i32, nxv4i16, Legal);
        self.setTruncStoreAction(nxv8i16, nxv8i8, Legal);
        self.setTruncStoreAction(v2i64, v2i8, Custom);
        self.setTruncStoreAction(v2i64, v2i16, Custom);
        self.setTruncStoreAction(v2i32, v2i8, Custom);
        self.setTruncStoreAction(v2i32, v2i16, Custom);
        if self.Subtarget() && self.Subtarget.isNonStreamingSVEorSME2Available() {}
        if operator!(self.Subtarget()) || !self.Subtarget.isNonStreamingSVEorSME2Available() {
            if self.Subtarget() && self.Subtarget.isNeonAvailable() {
                self.setOperationAction(FMUL, v8bf16, Custom);
            }
        }
        self.setOperationAction(INTRINSIC_WO_CHAIN, i8, Custom);
        self.setOperationAction(INTRINSIC_WO_CHAIN, i16, Custom);
        self.setOperationAction(MUL, v1i64, Custom);
        self.setOperationAction(MUL, v2i64, Custom);
        self.setOperationAction(VECREDUCE_SMAX, v2i64, Custom);
        self.setOperationAction(VECREDUCE_SMIN, v2i64, Custom);
        self.setOperationAction(VECREDUCE_UMAX, v2i64, Custom);
        self.setOperationAction(VECREDUCE_UMIN, v2i64, Custom);
        if self.Subtarget.useSVEForFixedLengthVectors() {
            self.setOperationAction(FP_ROUND, v4f16, Custom);
            self.setOperationAction(SMAX, v1i64, Custom);
            self.setOperationAction(SMAX, v2i64, Custom);
            self.setOperationAction(SMIN, v1i64, Custom);
            self.setOperationAction(SMIN, v2i64, Custom);
            self.setOperationAction(UMAX, v1i64, Custom);
            self.setOperationAction(UMAX, v2i64, Custom);
            self.setOperationAction(UMIN, v1i64, Custom);
            self.setOperationAction(UMIN, v2i64, Custom);
            self.setOperationAction(VECREDUCE_SMAX, v2i64, Custom);
            self.setOperationAction(VECREDUCE_SMIN, v2i64, Custom);
            self.setOperationAction(VECREDUCE_UMAX, v2i64, Custom);
            self.setOperationAction(VECREDUCE_UMIN, v2i64, Custom);
        }
        self.setOperationPromotedToType(VECTOR_SPLICE_LEFT, nxv2i1, nxv2i64);
        self.setOperationPromotedToType(VECTOR_SPLICE_RIGHT, nxv2i1, nxv2i64);
        self.setOperationPromotedToType(VECTOR_SPLICE_LEFT, nxv4i1, nxv4i32);
        self.setOperationPromotedToType(VECTOR_SPLICE_RIGHT, nxv4i1, nxv4i32);
        self.setOperationPromotedToType(VECTOR_SPLICE_LEFT, nxv8i1, nxv8i16);
        self.setOperationPromotedToType(VECTOR_SPLICE_RIGHT, nxv8i1, nxv8i16);
        self.setOperationPromotedToType(VECTOR_SPLICE_LEFT, nxv16i1, nxv16i8);
        self.setOperationPromotedToType(VECTOR_SPLICE_RIGHT, nxv16i1, nxv16i8);
        self.setOperationAction(VSCALE, i32, Custom);
        if self.Subtarget.enableSubRegLiveness() && (self.Subtarget() || (self.Subtarget() && self.Subtarget.isStreaming())) {}
    }
    if self.Subtarget.isSVEorStreamingSVEAvailable() {
        let mut MLAOps: [2]u32 = [PARTIAL_REDUCE_SMLA, PARTIAL_REDUCE_UMLA];
        if self.Subtarget() {
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, nxv4i32, nxv16i8, Legal);
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, nxv2i64, nxv16i8, Custom);
        }
        if self.Subtarget() || self.Subtarget() {
            self.setOperationAction(CLMUL, nxv8i16, Custom);
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, nxv4f32, nxv8f16, Legal);
            if !self.Subtarget.isNeonAvailable() || (operator!(self.Subtarget()) && operator!(self.Subtarget())) {
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, v4f32, v8f16, Custom);
                self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, v2f32, v4f16, Custom);
            }
        }
        if self.Subtarget() && (self.Subtarget.isSVEAvailable() || (self.Subtarget.isSVEorStreamingSVEAvailable() && self.Subtarget())) {
            self.setOperationAction([PEXT, PDEP], i32, Custom);
            self.setOperationAction([PEXT, PDEP], i64, Custom);
        }
        if self.Subtarget() {
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, nxv4f32, nxv8bf16, Legal);
        }
        self.setOperationAction(CLMUL, nxv2i64, Custom);
    }
    if self.Subtarget.isSVEAvailable() || (self.Subtarget.isSVEorStreamingSVEAvailable() && self.Subtarget()) {
        self.setOperationPromotedToType(VECTOR_COMPRESS, nxv4bf16, nxv4i16);
        self.setOperationPromotedToType(VECTOR_COMPRESS, nxv4f16, nxv4i16);
        self.setOperationPromotedToType(VECTOR_COMPRESS, nxv4i16, nxv4i32);
        self.setOperationPromotedToType(VECTOR_COMPRESS, nxv2bf16, nxv2i16);
        self.setOperationPromotedToType(VECTOR_COMPRESS, nxv2f16, nxv2i16);
        self.setOperationPromotedToType(VECTOR_COMPRESS, nxv2i16, nxv2i64);
        if self.Subtarget() || self.Subtarget() {} else {
            self.setOperationPromotedToType(VECTOR_COMPRESS, v4bf16, v4i16);
            self.setOperationPromotedToType(VECTOR_COMPRESS, v4f16, v4i16);
            self.setOperationPromotedToType(VECTOR_COMPRESS, v4i16, v4i32);
        }
    }
    if self.Subtarget() || (self.Subtarget() && self.Subtarget.isStreaming()) {}
    if self.Subtarget.isSVEAvailable() {
        if self.Subtarget() {
            self.setOperationAction(EXPERIMENTAL_VECTOR_HISTOGRAM, nxv4i32, Custom);
            self.setOperationAction(EXPERIMENTAL_VECTOR_HISTOGRAM, nxv2i64, Custom);
            let mut MLAOps: [2]u32 = [PARTIAL_REDUCE_SMLA, PARTIAL_REDUCE_UMLA];
        }
    }
    if self.Subtarget() && self.Subtarget() {
        self.setOperationAction(INTRINSIC_W_CHAIN, i8, Custom);
    }
    self.setOperationAction(INTRINSIC_VOID, Other, Custom);
    if self.Subtarget() {
        self.setOperationAction(FLDEXP, f64, Custom);
        self.setOperationAction(FLDEXP, f32, Custom);
        self.setOperationAction(FLDEXP, f16, Custom);
        self.setOperationAction(FLDEXP, bf16, Custom);
    }
    self.PredictableSelectIsExpensive = self.Subtarget();
    self.IsStrictFPEnabled = true;
    self.setMaxAtomicSizeInBitsSupported(128);
    if self.Subtarget.isTargetWindows() {}
}

fn AArch64TargetLowering::getTM(self: *AArch64TargetLowering) -> *AArch64TargetMachine {}

fn AArch64TargetLowering::addTypeForNEON(self, VT: MVT) {
    assert!(VT.isVector(), "VT should be a vector type");
    if VT.isFloatingPoint() {
        let mut PromoteTo: MVT = VT.changeVectorElementTypeToInteger().getSimpleVT();
        self.setOperationPromotedToType(LOAD, VT, PromoteTo);
        self.setOperationPromotedToType(STORE, VT, PromoteTo);
    }
    if VT == v2f32 || VT == v4f32 || VT == v2f64 {
        self.setOperationAction(FSIN, VT, Expand);
        self.setOperationAction(FCOS, VT, Expand);
        self.setOperationAction(FTAN, VT, Expand);
        self.setOperationAction(FASIN, VT, Expand);
        self.setOperationAction(FACOS, VT, Expand);
        self.setOperationAction(FATAN, VT, Expand);
        self.setOperationAction(FATAN2, VT, Expand);
        self.setOperationAction(FSINH, VT, Expand);
        self.setOperationAction(FCOSH, VT, Expand);
        self.setOperationAction(FTANH, VT, Expand);
        self.setOperationAction(FPOW, VT, Expand);
        self.setOperationAction(FCBRT, VT, Expand);
        self.setOperationAction(FLOG, VT, Expand);
        self.setOperationAction(FLOG2, VT, Expand);
        self.setOperationAction(FLOG10, VT, Expand);
        self.setOperationAction(FEXP, VT, Expand);
        self.setOperationAction(FEXP2, VT, Expand);
        self.setOperationAction(FEXP10, VT, Expand);
    }
    if VT == v2f32 || VT == v4f32 || VT == v2f64 || ((VT == v4bf16 || VT == v8bf16 || VT == v4f16 || VT == v8f16) && self.Subtarget()) {
        self.setOperationAction(FCOPYSIGN, VT, Custom);
    }
    self.setOperationAction(EXTRACT_VECTOR_ELT, VT, Custom);
    self.setOperationAction(INSERT_VECTOR_ELT, VT, Custom);
    self.setOperationAction(BUILD_VECTOR, VT, Custom);
    self.setOperationAction(ZERO_EXTEND_VECTOR_INREG, VT, Custom);
    self.setVectorInterleaveAction([VECTOR_INTERLEAVE, VECTOR_DEINTERLEAVE], [2, 3], VT, Custom);
    self.setOperationAction(VECTOR_SHUFFLE, VT, Custom);
    self.setOperationAction(EXTRACT_SUBVECTOR, VT, Custom);
    self.setOperationAction(SRA, VT, Custom);
    self.setOperationAction(SRL, VT, Custom);
    self.setOperationAction(SHL, VT, Custom);
    self.setOperationAction(OR, VT, Custom);
    self.setOperationAction(SETCC, VT, Custom);
    self.setOperationAction(CONCAT_VECTORS, VT, Legal);
    self.setOperationAction(SELECT, VT, Expand);
    self.setOperationAction(SELECT_CC, VT, Expand);
    self.setOperationAction(VSELECT, VT, Expand);
    if VT != v8i8 && VT != v16i8 {
        self.setOperationAction(CTPOP, VT, Custom);
    }
    self.setOperationAction(UDIV, VT, Expand);
    self.setOperationAction(SDIV, VT, Expand);
    self.setOperationAction(UREM, VT, Expand);
    self.setOperationAction(SREM, VT, Expand);
    self.setOperationAction(FREM, VT, Expand);
    if !VT.isFloatingPoint() {
        self.setOperationAction(ABS, VT, Legal);
    }
    if VT.isFloatingPoint() && VT.getScalarSizeInBits() != 16 {
        self.setOperationAction(STRICT_FP_EXTEND, VT, Legal);
    }
    if VT.isFloatingPoint() && VT.getScalarSizeInBits() != 64 {
        self.setOperationAction(STRICT_FP_ROUND, VT, Legal);
    }
    self.setOperationAction(STRICT_FSETCC, VT, Expand);
    self.setOperationAction(STRICT_FSETCCS, VT, Expand);
    if self.Subtarget.isLittleEndian() {
        for let mut im: u32 = PRE_INC as u32; im != LAST_INDEXED_MODE as u32; im += 1 {
            self.setIndexedLoadAction(im, VT, Legal);
            self.setIndexedStoreAction(im, VT, Legal);
        }
    } else {
        self.setIndexedLoadAction(POST_INC, VT, Legal);
        self.setIndexedStoreAction(POST_INC, VT, Legal);
    }
    if self.Subtarget() {
        self.setOperationAction(READ_REGISTER, i128, Custom);
        self.setOperationAction(WRITE_REGISTER, i128, Custom);
    }
    if VT.isInteger() {
        self.setCondCodeAction(SETNE, VT, Expand);
        self.setCondCodeAction(SETLE, VT, Expand);
        self.setCondCodeAction(SETLT, VT, Expand);
        self.setCondCodeAction(SETULE, VT, Expand);
        self.setCondCodeAction(SETULT, VT, Expand);
    }
}

fn AArch64TargetLowering::shouldExpandGetActiveLaneMask(self: *AArch64TargetLowering, ResVT: EVT, OpVT: EVT) -> bool {
    if !self.Subtarget.isSVEorStreamingSVEAvailable() && ResVT.isFixedLengthVector() {
        if !is_contained(void { 2, 4, 8, 16 }, ResVT.getVectorNumElements()) {
            return true;
        }
        if OpVT != i32 && OpVT != i64 {
            return true;
        }
    }
    if ResVT.isFixedLengthVector() && ResVT.getVectorNumElements() == 1 {
        return true;
    }
    if OpVT.getFixedSizeInBits() > 64 {
        return true;
    }
    return false;
}

fn AArch64TargetLowering::addTypeForFixedLengthSVE(self, VT: MVT) {
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    for let mut Op: u32 = 0; Op < BUILTIN_OP_END; Op += 1 {
        self.setOperationAction(Op, VT, Expand);
    }
    if VT.isFloatingPoint() {
        self.setCondCodeAction(SETO, VT, Expand);
        self.setCondCodeAction(SETOLT, VT, Expand);
        self.setCondCodeAction(SETOLE, VT, Expand);
        self.setCondCodeAction(SETULT, VT, Expand);
        self.setCondCodeAction(SETULE, VT, Expand);
        self.setCondCodeAction(SETUGE, VT, Expand);
        self.setCondCodeAction(SETUGT, VT, Expand);
        self.setCondCodeAction(SETUEQ, VT, Expand);
        self.setCondCodeAction(SETONE, VT, Expand);
    }
    let mut Default: LegalizeAction = if VT == v1f64 { Expand } else { Custom };
    if VT.isInteger() {
        let mut InnerVT: MVT = VT.changeVectorElementType(i8);
        while InnerVT != VT {
            self.setTruncStoreAction(VT, InnerVT, Default);
            self.setLoadExtAction(ZEXTLOAD, VT, InnerVT, Default);
            self.setLoadExtAction(SEXTLOAD, VT, InnerVT, Default);
            self.setLoadExtAction(EXTLOAD, VT, InnerVT, Default);
            InnerVT = InnerVT.changeVectorElementType(getIntegerVT(2 * InnerVT.getScalarSizeInBits()));
        }
    }
    if VT.getScalarType() == f32 || VT.getScalarType() == f64 {
        let mut InnerVT: MVT = VT.changeVectorElementType(f16);
        while InnerVT != VT {
            self.setTruncStoreAction(VT, InnerVT, Custom);
            self.setLoadExtAction(EXTLOAD, VT, InnerVT, Default);
            InnerVT = InnerVT.changeVectorElementType(getFloatingPointVT(2 * InnerVT.getScalarSizeInBits()));
        }
    }
    let mut PreferNEON: bool = VT.is64BitVector() || VT.is128BitVector();
    let mut PreferSVE: bool = !PreferNEON && self.Subtarget.isSVEAvailable();
    let mut MLAOps: [2]u32 = [PARTIAL_REDUCE_SMLA, PARTIAL_REDUCE_UMLA];
    let mut NumElts: u32 = VT.getVectorNumElements();
    if VT.getVectorElementType() == i64 {} else if VT.getVectorElementType() == i32 {} else if VT.getVectorElementType() == i16 {}
    if self.Subtarget() {
        if VT.getVectorElementType() == i32 {
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, VT, getVectorVT(i8, NumElts * 4), Custom);
        } else if VT.getVectorElementType() == i64 {
            self.setPartialReduceMLAAction(PARTIAL_REDUCE_SUMLA, VT, getVectorVT(i8, NumElts * 8), Custom);
        }
    }
    if self.Subtarget() && VT.getVectorElementType() == f32 {
        self.setPartialReduceMLAAction(PARTIAL_REDUCE_FMLA, VT, getVectorVT(f16, NumElts * 2), Custom);
    }
    self.setOperationAction(ABDS, VT, Default);
    self.setOperationAction(ABDU, VT, Default);
    self.setOperationAction(ABS, VT, Default);
    self.setOperationAction(ADD, VT, Default);
    self.setOperationAction(AND, VT, Default);
    self.setOperationAction(ANY_EXTEND, VT, Default);
    self.setOperationAction(BITCAST, VT, if PreferNEON { Legal } else { Default });
    self.setOperationAction(BITREVERSE, VT, Default);
    self.setOperationAction(BSWAP, VT, Default);
    self.setOperationAction(BUILD_VECTOR, VT, Custom);
    self.setOperationAction(CONCAT_VECTORS, VT, Default);
    self.setOperationAction(CTLZ, VT, Default);
    self.setOperationAction(CTPOP, VT, Default);
    self.setOperationAction(CTTZ, VT, Default);
    self.setOperationAction(EXTRACT_SUBVECTOR, VT, Default);
    self.setOperationAction(EXTRACT_VECTOR_ELT, VT, Default);
    self.setOperationAction(FABS, VT, Default);
    self.setOperationAction(FADD, VT, Default);
    self.setOperationAction(FCANONICALIZE, VT, Default);
    self.setOperationAction(FCEIL, VT, Default);
    self.setOperationAction(FCOPYSIGN, VT, Default);
    self.setOperationAction(FDIV, VT, Default);
    self.setOperationAction(FFLOOR, VT, Default);
    self.setOperationAction(FMA, VT, Default);
    self.setOperationAction(FMAXIMUM, VT, Default);
    self.setOperationAction(FMAXNUM, VT, Default);
    self.setOperationAction(FMAXNUM_IEEE, VT, Default);
    self.setOperationAction(FMINIMUM, VT, Default);
    self.setOperationAction(FMINNUM, VT, Default);
    self.setOperationAction(FMINNUM_IEEE, VT, Default);
    self.setOperationAction(FMUL, VT, Default);
    self.setOperationAction(FNEARBYINT, VT, Default);
    self.setOperationAction(FNEG, VT, Default);
    self.setOperationAction(FP_EXTEND, VT, Default);
    self.setOperationAction(FP_ROUND, VT, Default);
    self.setOperationAction(FP_TO_SINT, VT, Default);
    self.setOperationAction(FP_TO_UINT, VT, Default);
    self.setOperationAction(FP_TO_UINT_SAT, VT, Custom);
    self.setOperationAction(FP_TO_SINT_SAT, VT, Custom);
    self.setOperationAction(FRINT, VT, Default);
    self.setOperationAction(LRINT, VT, Default);
    self.setOperationAction(LLRINT, VT, Default);
    self.setOperationAction(FROUND, VT, Default);
    self.setOperationAction(FROUNDEVEN, VT, Default);
    self.setOperationAction(FSQRT, VT, Default);
    self.setOperationAction(FSUB, VT, Default);
    self.setOperationAction(FTRUNC, VT, Default);
    self.setOperationAction(GET_ACTIVE_LANE_MASK, VT, Default);
    self.setOperationAction(INSERT_VECTOR_ELT, VT, Default);
    self.setOperationAction(LOAD, VT, if PreferNEON { Legal } else { Default });
    self.setOperationAction(MASKED_UDIV, VT, Default);
    self.setOperationAction(MASKED_SDIV, VT, Default);
    self.setOperationAction(MGATHER, VT, if PreferSVE { Default } else { Expand });
    self.setOperationAction(MLOAD, VT, Default);
    self.setOperationAction(MSCATTER, VT, if PreferSVE { Default } else { Expand });
    self.setOperationAction(MSTORE, VT, Default);
    self.setOperationAction(MUL, VT, Default);
    self.setOperationAction(MULHS, VT, Default);
    self.setOperationAction(MULHU, VT, Default);
    self.setOperationAction(OR, VT, Default);
    self.setOperationAction(SCALAR_TO_VECTOR, VT, if PreferNEON { Legal } else { Expand });
    self.setOperationAction(SDIV, VT, Default);
    self.setOperationAction(SELECT, VT, Default);
    self.setOperationAction(SETCC, VT, Default);
    self.setOperationAction(SHL, VT, Default);
    self.setOperationAction(SIGN_EXTEND, VT, Default);
    self.setOperationAction(SIGN_EXTEND_INREG, VT, Default);
    self.setOperationAction(SINT_TO_FP, VT, Default);
    self.setOperationAction(SMAX, VT, Default);
    self.setOperationAction(SMIN, VT, Default);
    self.setOperationAction(SPLAT_VECTOR, VT, Default);
    self.setOperationAction(SRA, VT, Default);
    self.setOperationAction(SRL, VT, Default);
    self.setOperationAction(STORE, VT, if PreferNEON { Legal } else { Default });
    self.setOperationAction(SUB, VT, Default);
    self.setOperationAction(TRUNCATE, VT, Default);
    self.setOperationAction(UDIV, VT, Default);
    self.setOperationAction(UINT_TO_FP, VT, Default);
    self.setOperationAction(UMAX, VT, Default);
    self.setOperationAction(UMIN, VT, Default);
    self.setOperationAction(VECREDUCE_ADD, VT, Default);
    self.setOperationAction(VECREDUCE_AND, VT, Default);
    self.setOperationAction(VECREDUCE_FADD, VT, Default);
    self.setOperationAction(VECREDUCE_FMAX, VT, Default);
    self.setOperationAction(VECREDUCE_FMIN, VT, Default);
    self.setOperationAction(VECREDUCE_FMAXIMUM, VT, Default);
    self.setOperationAction(VECREDUCE_FMINIMUM, VT, Default);
    self.setOperationAction(VECREDUCE_OR, VT, Default);
    self.setOperationAction(VECREDUCE_SEQ_FADD, VT, if PreferSVE { Default } else { Expand });
    self.setOperationAction(VECREDUCE_SMAX, VT, Default);
    self.setOperationAction(VECREDUCE_SMIN, VT, Default);
    self.setOperationAction(VECREDUCE_UMAX, VT, Default);
    self.setOperationAction(VECREDUCE_UMIN, VT, Default);
    self.setOperationAction(VECREDUCE_XOR, VT, Default);
    self.setOperationAction(VECTOR_SHUFFLE, VT, Default);
    self.setOperationAction(VECTOR_SPLICE_LEFT, VT, Default);
    self.setOperationAction(VECTOR_SPLICE_RIGHT, VT, Default);
    self.setOperationAction(VSELECT, VT, Default);
    self.setOperationAction(XOR, VT, Default);
    self.setOperationAction(ZERO_EXTEND, VT, Default);
}

fn AArch64TargetLowering::addDRType(self, VT: MVT) {
    self.addRegisterClass;
    if self.Subtarget.isNeonAvailable() {
        self.addTypeForNEON(VT);
    }
}

fn AArch64TargetLowering::addQRType(self, VT: MVT) {
    self.addRegisterClass;
    if self.Subtarget.isNeonAvailable() {
        self.addTypeForNEON(VT);
    }
}

fn AArch64TargetLowering::getSetCCResultType(self: *AArch64TargetLowering, arg: *DataLayout, C: *mut LLVMContext, VT: EVT) -> EVT {
    if !VT.isVector() {
        return i32;
    }
    if VT.isScalableVector() {
        return getVectorVT(C, i1, VT.getVectorElementCount());
    }
    return VT.changeVectorElementTypeToInteger();
}

fn isIntImmediate(N: *SDNode, Imm: *mut u64) -> bool {
    if dyn_cast(N) {
        C;
    } else {
        Imm = C.getZExtValue();
        return true;
    }
    return false;
}

fn isVectorizedBinOp(Opcode: u32) -> bool {
    match Opcode {
        _ => {
            return false;
        },
    }
}

fn isOpcWithIntImmediate(N: *SDNode, Opc: u32, Imm: *mut u64) -> bool {
    return N.getOpcode() == Opc && isIntImmediate(N.getOperand(1).getNode(), Imm);
}

fn optimizeLogicalImm(Op: SDValue, Size: u32, Imm: u64, Demanded: *APInt, TLO: *mut TargetLoweringOpt, NewOpc: u32) -> bool {
    let mut OldImm: u64 = Imm;
    let mut NewImm: u64 = 0;
    let mut Enc: u64 = 0;
    let mut Mask: u64 = ((-1) as u64 >> (64 - Size));
    let mut OrigMask: u64 = Mask;
    if Imm == 0 || Imm == Mask || isLogicalImmediate(Imm & Mask, Size) {
        return false;
    }
    let mut EltSize: u32 = Size;
    let mut DemandedBits: u64 = Demanded.getZExtValue();
    Imm &= DemandedBits;
    while true {
        let mut NonDemandedBits: u64 = ~DemandedBits;
        let mut InvertedImm: u64 = ~Imm & DemandedBits;
        let mut RotatedImm: u64 = ((InvertedImm << 1) | (InvertedImm >> (EltSize - 1) & 1)) & NonDemandedBits;
        let mut Sum: u64 = RotatedImm + NonDemandedBits;
        let mut Carry: bool = NonDemandedBits & ~Sum & (1 << (EltSize - 1));
        let mut Ones: u64 = (Sum + Carry) & NonDemandedBits;
        NewImm = (Imm | Ones) & Mask;
        if isShiftedMask_64(NewImm) || isShiftedMask_64(~(NewImm | ~Mask)) {
            break;
        }
        if EltSize == 2 {
            return false;
        }
        EltSize /= 2;
        Mask >>= EltSize;
        let mut Hi: u64 = Imm >> EltSize;
        let mut DemandedBitsHi: u64 = DemandedBits >> EltSize;
        if ((Imm ^ Hi) & (DemandedBits & DemandedBitsHi) & Mask) != 0 {
            return false;
        }
        Imm |= Hi;
        DemandedBits |= DemandedBitsHi;
    }
    operator(NumOptimizedImms);
    while EltSize < Size {
        NewImm |= NewImm << EltSize;
        EltSize *= 2;
    }
    OldImm as void;
    assert!(((OldImm ^ NewImm) & Demanded.getZExtValue()) == 0, "demanded bits should never be altered");
    assert!(OldImm != NewImm, "the new imm shouldn't be equal to the old imm");
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut New: SDValue = SDValue {};
    if NewImm == 0 || NewImm == OrigMask {
        New = TLO.DAG.getNode(Op.getOpcode(), DL, VT, Op.getOperand(0), TLO.DAG.getConstant(NewImm, DL, VT, false, false));
    } else {
        Enc = encodeLogicalImmediate(NewImm, Size);
        let mut EncConst: SDValue = TLO.DAG.getTargetConstant(Enc, DL, VT, false);
        New = SDValue { Node: TLO.DAG.getMachineNode(NewOpc, DL, VT, Op.getOperand(0), EncConst), ResNo: 0 };
    }
    return TLO.CombineTo(Op, New);
}

fn AArch64TargetLowering::targetShrinkDemandedConstant(self: *AArch64TargetLowering, Op: SDValue, DemandedBits: *APInt, DemandedElts: *APInt, TLO: *mut TargetLoweringOpt) -> bool {
    if !TLO.LegalOps {
        return false;
    }
    if operator!() {
        return false;
    }
    let mut VT: EVT = Op.getValueType();
    if VT.isVector() {
        return false;
    }
    let mut Size: u32 = VT.getSizeInBits().operator unsigned long long();
    if Size != 32 && Size != 64 {
        return false;
    }
    if DemandedBits.isAllOnes() {
        return false;
    }
    let mut NewOpc: u32 = 0;
    match Op.getOpcode() {
        _ => {
            return false;
        },
        AND => {
            
        },
        OR => {
            
        },
        XOR => {
            
        },
    }
    let mut C: *mut ConstantSDNode = dyn_cast(Op.getOperand(1));
    if !C {
        return false;
    }
    let mut Imm: u64 = C.getZExtValue();
    return optimizeLogicalImm(Op, Size, Imm, DemandedBits, TLO, NewOpc);
}

fn AArch64TargetLowering::computeKnownBitsForTargetNode(self: *AArch64TargetLowering, Op: SDValue, Known: *mut KnownBits, DemandedElts: *APInt, DAG: *SelectionDAG, Depth: u32) {
    match Op.getOpcode() {
        _ => {
            break;
        },
        INTRINSIC_W_CHAIN => {
            let mut IntID: ID = operator(Op).getConstantOperandVal(1) as ID;
            match IntID {
                _ => {
                    return;
                },
            }
            break;
        },
        INTRINSIC_WO_CHAIN => {
            INTRINSIC_VOID;
        },
    }
}

