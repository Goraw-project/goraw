        for let mut I: u32 = 0; I < InVals.len; I += 1 {
            let mut Reg: Register = MF.getRegInfo().createVirtualRegister(self.getRegClassFor(InVals[I].getValueType().getSimpleVT(), false), "");
            let mut X: SDValue = DAG.getCopyToReg(Result, DL, Reg, InVals[I]);
