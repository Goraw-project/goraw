        let mut ExtractBase: i32 = EltNo *  + ;
        operator+=(ExtractBase, NumElts * (Src() - ()));
        for let mut j: i32 = 0; j < LanesDefined; j += 1 {
            LaneMask[j] = ExtractBase + j;
