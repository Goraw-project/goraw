fn AArch64TargetLowering::getTgtMemIntrinsic(self: *AArch64TargetLowering, Infos: *mut SmallVectorImpl<IntrinsicInfo>, I: *CallBase, MF: *mut MachineFunction, Intrinsic: u32) {
    let mut Info: IntrinsicInfo = IntrinsicInfo {};
    let mut DL: *DataLayout = I.getDataLayout();
    match Intrinsic {
        _ => {
            break;
        },
    }
}

fn AArch64TargetLowering::shouldReduceLoadWidth(self: *AArch64TargetLowering, Load: *mut SDNode, ExtTy: LoadExtType, NewVT: EVT, ByteOffset: optional<unsigned int>) -> bool {
    if !self.shouldReduceLoadWidth(Load, ExtTy, NewVT, ByteOffset) {
        return false;
    }
    if ExtTy != NON_EXTLOAD {
        return true;
    }
    let mut Mem: *mut MemSDNode = dyn_cast(Load);
    assert!(Mem);
    let mut Base: *SDValue = Mem.getBasePtr();
    if Base.getOpcode() == ADD && Base.getOperand(1).getOpcode() == SHL && Base.getOperand(1).hasOneUse() && Base.getOperand(1).getOperand(1).getOpcode() == Constant {
        if Mem.getMemoryVT().isScalableVector() {
            return false;
        }
        let mut ShiftAmount: u64 = Base.getOperand(1).getConstantOperandVal(1);
        let mut LoadBytes: u64 = Mem.getMemoryVT().getSizeInBits().operator unsigned long long() / 8;
        if ShiftAmount == Log2_32(LoadBytes) {
            return false;
        }
    }
    return true;
}

fn AArch64TargetLowering::shouldRemoveRedundantExtend(self: *AArch64TargetLowering, Extend: SDValue) -> bool {
    let mut VT: EVT = Extend.getValueType();
    if (VT == i64 || VT == i32) && operator(Extend).use_size() {
        let mut Extract: SDValue = Extend.getOperand(0);
        if Extract.getOpcode() == ANY_EXTEND && Extract.hasOneUse() {
            Extract = Extract.getOperand(0);
        }
        if Extract.getOpcode() == EXTRACT_VECTOR_ELT && Extract.hasOneUse() {
            let mut VecVT: EVT = Extract.getOperand(0).getValueType();
            if VecVT.getScalarType() == i8 || VecVT.getScalarType() == i16 {
                return false;
            }
        }
    }
    return true;
}

fn AArch64TargetLowering::isTruncateFree(self: *AArch64TargetLowering, Ty1: *mut Type, Ty2: *mut Type) -> bool {
    if !Ty1.isIntegerTy() || !Ty2.isIntegerTy() {
        return false;
    }
    let mut NumBits1: u64 = Ty1.getPrimitiveSizeInBits().getFixedValue();
    let mut NumBits2: u64 = Ty2.getPrimitiveSizeInBits().getFixedValue();
    return NumBits1 > NumBits2;
}

fn AArch64TargetLowering::isTruncateFree(self: *AArch64TargetLowering, VT1: EVT, VT2: EVT) -> bool {
    if VT1.isVector() || VT2.isVector() || !VT1.isInteger() || !VT2.isInteger() {
        return false;
    }
    let mut NumBits1: u64 = VT1.getFixedSizeInBits();
    let mut NumBits2: u64 = VT2.getFixedSizeInBits();
    return NumBits1 > NumBits2;
}

fn AArch64TargetLowering::isProfitableToHoist(self: *AArch64TargetLowering, I: *mut Instruction) -> bool {
    if I.getOpcode() != FMul {
        return true;
    }
    if !I.hasOneUse() {
        return true;
    }
    let mut User: *mut Instruction = I.user_back();
    if !(User.getOpcode() == FSub || User.getOpcode() == FAdd) {
        return true;
    }
    let mut F: *Function = I.getFunction();
    let mut DL: *DataLayout = F.getDataLayout();
    let mut Ty: *mut Type = User.getOperand(0).getType();
    return !(self.isFMAFasterThanFMulAndFAdd(*F, Ty) && self.isOperationLegalOrCustom(FMA, self.getValueType(DL, Ty, false), false) && I.getFastMathFlags().allowContract());
}

fn AArch64TargetLowering::isZExtFree(self: *AArch64TargetLowering, Ty1: *mut Type, Ty2: *mut Type) -> bool {
    if !Ty1.isIntegerTy() || !Ty2.isIntegerTy() {
        return false;
    }
    let mut NumBits1: u32 = Ty1.getPrimitiveSizeInBits().operator unsigned long long();
    let mut NumBits2: u32 = Ty2.getPrimitiveSizeInBits().operator unsigned long long();
    return NumBits1 == 32 && NumBits2 == 64;
}

fn AArch64TargetLowering::isZExtFree(self: *AArch64TargetLowering, VT1: EVT, VT2: EVT) -> bool {
    if VT1.isVector() || VT2.isVector() || !VT1.isInteger() || !VT2.isInteger() {
        return false;
    }
    let mut NumBits1: u32 = VT1.getSizeInBits().operator unsigned long long();
    let mut NumBits2: u32 = VT2.getSizeInBits().operator unsigned long long();
    return NumBits1 == 32 && NumBits2 == 64;
}

fn AArch64TargetLowering::isZExtFree(self: *AArch64TargetLowering, Val: SDValue, VT2: EVT) -> bool {
    let mut VT1: EVT = Val.getValueType();
    if self.isZExtFree(VT1, VT2) {
        return true;
    }
    if Val.getOpcode() != LOAD {
        return false;
    }
    return (VT1.isSimple() && !VT1.isVector() && VT1.isInteger() && VT2.isSimple() && !VT2.isVector() && VT2.isInteger() && VT1.getSizeInBits().operator unsigned long long() <= 32);
}

fn AArch64TargetLowering::isExtFreeImpl(self: *AArch64TargetLowering, Ext: *Instruction) -> bool {
    if isa(Ext) {
        return false;
    }
    if Ext.getType().isVectorTy() {
        return false;
    }
    for U in Ext.uses() {
        let mut Instr: *Instruction = cast(U.getUser());
        match Instr.getOpcode() {
            Shl => {
                if !isa(Instr.getOperand(1)) {
