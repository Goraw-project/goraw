        }
        (((operator!(operator!(((Mask()() == 8 || () == 16) && "Expected a v8i8 or v16i8 Mask")))) || (_wassert(L"(Mask.size() == 8 || Mask.size() == 16) && \"Expected a v8i8 or v16i8 Mask\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (15047) as u32) , 0)) as void);
        TBLOperands.push_back(DAG(if () == 8 { v8i8 } else { v16i8 }, DL, TBLMask));
        let mut Shuffle: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, if () == 8 { v8i8 } else { v16i8 }, TBLOperands);
        return DAG.getBitcast(VT, Shuffle);
    }
    if Sources()() > 2 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
