            let mut Src: SDValue = [i];
            let mut SrcVT: EVT = Src.getValueType();
            Src = DAG.getBitcast(if SrcVT.is64BitVector() { v8i8 } else { v16i8 }, Src);
            assert!((SrcVT.is64BitVector() || SrcVT.is128BitVector()), "Expected a legally typed vector");
            if SrcVT.is64BitVector() {
