fn AArch64TargetLowering::isComplexDeinterleavingOperationSupported(self: *AArch64TargetLowering, Operation: ComplexDeinterleavingOperation, Ty: *mut Type) -> bool {
    let mut VTy: *mut auto = dyn_cast(Ty);
    if operator!() {
        return false;
    }
    if operator!() && operator!(self.Subtarget()) {
        return false;
    }
    let mut ScalarTy: *mut auto = ();
    let mut NumElements: u32 = ()();
    let mut VTyWidth: u32 = () * NumElements;
    if (VTyWidth < 128 && (VTy()() || VTyWidth != 64)) || !isPowerOf2_32(VTyWidth) {
        return false;
    }
    if ScalarTy()() && self.Subtarget() && () {
        let mut ScalarWidth: u32 = ();
        if Operation == CDot {
            return ScalarWidth == 32 || ScalarWidth == 64;
        }
        return 8 <= ScalarWidth && ScalarWidth <= 64;
    }
    if Operation == CDot {
        return false;
    }
    return (ScalarTy()() && self.Subtarget()) || () || ();
}

fn AArch64TargetLowering::createComplexDeinterleavingIR(self: *AArch64TargetLowering, B: *mut IRBuilderBase, OperationType: ComplexDeinterleavingOperation, Rotation: ComplexDeinterleavingRotation, InputA: *mut Value, InputB: *mut Value, Accumulator: *mut Value) -> *mut Value {
    let mut Ty: *mut VectorType = cast(InputA.getType());
    if Accumulator == null {
        Accumulator = getNullValue(Ty);
    }
    let mut IsScalable: bool = Ty.isScalableTy();
    let mut IsInt: bool = Ty.getElementType().isIntegerTy();
    let mut TyWidth: u32 = Ty.getScalarSizeInBits() * Ty.getElementCount().getKnownMinValue();
    assert!(((TyWidth >= 128 && isPowerOf2_32(TyWidth)) || TyWidth == 64), "Vector type must be either 64 or a power of 2 that is at least 128");
    if TyWidth > 128 {
        let mut Stride: i32 = Ty.getElementCount().getKnownMinValue() / 2;
        let mut AccStride: i32 = cast(Accumulator.getType())()() / 2;
        let mut HalfTy: *mut auto = getHalfElementsVectorType(Ty);
        let mut LowerSplitA: *mut auto = B(InputA, 0);
        let mut LowerSplitB: *mut auto = B(InputB, 0);
        let mut UpperSplitA: *mut auto = B(InputA, Stride);
        let mut UpperSplitB: *mut auto = B(InputB, Stride);
        let mut LowerSplitAcc: *mut Value = null;
        let mut UpperSplitAcc: *mut Value = null;
        let mut FullTy: *mut Type = Ty;
        FullTy = Accumulator.getType();
        let mut HalfAccTy: *mut auto = getHalfElementsVectorType(cast(Accumulator.getType()));
        LowerSplitAcc = B(Accumulator, 0);
        UpperSplitAcc = B(Accumulator, AccStride);
        let mut LowerSplitInt: *mut auto = self.createComplexDeinterleavingIR(B, OperationType, Rotation, LowerSplitAcc);
        let mut UpperSplitInt: *mut auto = self.createComplexDeinterleavingIR(B, OperationType, Rotation, UpperSplitAcc);
        let mut Result: *mut auto = B(FullTy, get(FullTy), 0);
        return B(FullTy, AccStride);
    }
    if OperationType == CMulPartial {
        if IsScalable {
            if IsInt {
                return B;
            }
            let mut Mask: *mut auto = B.getAllOnesMask(Ty.getElementCount());
            return B;
        }
        let mut IdMap: [4]ID = zeroed();
        return B.CreateIntrinsic(IdMap[Rotation as i32], Ty, [Accumulator, InputA, InputB], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, Closure_82 {});
    }
    if OperationType == CAdd {
        if IsScalable {
            if Rotation == Rotation_90 || Rotation == Rotation_270 {
                if IsInt {
                    return B;
                }
                let mut Mask: *mut auto = B.getAllOnesMask(Ty.getElementCount());
                return B;
            }
            return null;
        }
        let mut IntId: ID = not_intrinsic;
        if IntId == not_intrinsic {
            return null;
        }
        return B.CreateIntrinsic(IntId, Ty, [InputA, InputB], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, Closure_83 {});
    }
    if OperationType == CDot && IsInt && IsScalable {
        return B;
    }
    return null;
}

