    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
            dbgs() << "Reshuffle, creating node: ";
            Shuffle.dump();
            dbgs() << "Reshuffle, creating node: ";
            V.dump();
        }
    }
        if !(false) { break; }
    }
    return V;
}

fn isSingletonEXTMask(M: ArrayRef<int>, VT: EVT, Imm: *mut u32) -> bool {
    let mut NumElts: u32 = VT.getVectorNumElements();
    if M[0] < 0 {
        return false;
    }
    Imm = M[0];
    let mut ExpectedElt: u32 = Imm;
    for let mut i: u32 = 1; i < NumElts; i += 1 {
        ExpectedElt += 1;
        if ExpectedElt == NumElts {
            ExpectedElt = 0;
        }
        if M[i] < 0 {
            continue;
        }
        if ExpectedElt != M[i] as u32 {
            return false;
        }
    }
    return true;
}

fn ReconstructTruncateFromBuildVector(V: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if V.getValueType() != v16i8 {
        return SDValue {};
    }
    assert!(V.getNumOperands() == 16, "Expected 16 operands on the BUILDVECTOR");
    for let mut X: u32 = 0; X < 4; X += 1 {
        let mut BaseExt: SDValue = V.getOperand(X * 4);
        if BaseExt.getOpcode() != EXTRACT_VECTOR_ELT || (BaseExt.getOperand(0).getValueType() != v4i16 && BaseExt.getOperand(0).getValueType() != v4i32) || !isa(BaseExt.getOperand(1)) || BaseExt.getConstantOperandVal(1) != 0 {
            return SDValue {};
        }
        let mut Base: SDValue = BaseExt.getOperand(0);
        for let mut Y: u32 = 1; Y < 4; Y += 1 {
            let mut Ext: SDValue = V.getOperand(X * 4 + Y);
            if Ext.getOpcode() != EXTRACT_VECTOR_ELT || Ext.getOperand(0) != Base || !isa(Ext.getOperand(1)) || Ext.getConstantOperandVal(1) != Y {
                return SDValue {};
            }
        }
    }
    let mut DL: SDLoc = V;
    let mut Trunc: [4]SDValue = [V.getOperand(0).getOperand(0), V.getOperand(4).getOperand(0), V.getOperand(8).getOperand(0), V.getOperand(12).getOperand(0)];
    for V in Trunc[..] {
        if V.getValueType() == v4i32 {
            V = DAG.getNode(TRUNCATE, DL, v4i16, V);
        }
    }
    let mut Concat0: SDValue = DAG.getNode(CONCAT_VECTORS, DL, v8i16, Trunc[0], Trunc[1]);
    let mut Concat1: SDValue = DAG.getNode(CONCAT_VECTORS, DL, v8i16, Trunc[2], Trunc[3]);
    let mut Trunc0: SDValue = DAG.getNode(TRUNCATE, DL, v8i8, Concat0);
    let mut Trunc1: SDValue = DAG.getNode(TRUNCATE, DL, v8i8, Concat1);
    return DAG.getNode(CONCAT_VECTORS, DL, v16i8, Trunc0, Trunc1);
}

fn isWideDUPMask(M: ArrayRef<int>, VT: EVT, BlockSize: u32, DupLaneOp: *mut u32) -> bool {
    assert!((BlockSize == 16 || BlockSize == 32 || BlockSize == 64), "Only possible block sizes for wide DUP are: 16, 32, 64");
    if BlockSize <= VT.getScalarSizeInBits() {
        return false;
    }
    if BlockSize % VT.getScalarSizeInBits() != 0 {
        return false;
    }
    if VT.getSizeInBits().operator unsigned long long() % BlockSize != 0 {
        return false;
    }
    let mut SingleVecNumElements: u64 = VT.getVectorNumElements();
    let mut NumEltsPerBlock: u64 = BlockSize / VT.getScalarSizeInBits();
    let mut NumBlocks: u64 = VT.getSizeInBits().operator unsigned long long() / BlockSize;
    let mut BlockElts: SmallVector<int, 8> = zeroed();
    for let mut BlockIndex: u64 = 0; BlockIndex < NumBlocks; BlockIndex += 1 {
        for let mut I: u64 = 0; I < NumEltsPerBlock; I += 1 {
            let mut Elt: i32 = M[BlockIndex * NumEltsPerBlock + I];
            if Elt < 0 {
                continue;
            }
            if Elt as u32 >= SingleVecNumElements {
                return false;
            }
            if BlockElts()[I] < 0 {
                BlockElts()[I] = Elt;
            } else if BlockElts()[I] != Elt {
                return false;
            }
        }
    }
    let mut FirstRealEltIter: auto = find_if(Closure_27 {});
    (((operator!(operator!((FirstRealEltIter() != () && "Shuffle with all-undefs must have been caught by previous cases, e.g. isSplat()")))) || (_wassert(L"FirstRealEltIter != BlockElts.end() && \"Shuffle with all-undefs must have been caught by previous cases, \" \"e.g. isSplat()\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (15355) as u32) , 0)) as void);
    if FirstRealEltIter() == () {
        DupLaneOp = 0;
        return true;
    }
    let mut FirstRealIndex: u64 =  - ();
    if operator*() as u32 < FirstRealIndex {
        return false;
    }
    let mut Elt0: u64 = operator*() - FirstRealIndex;
    if Elt0 % NumEltsPerBlock != 0 {
        return false;
    }
    for let mut I: u64 = 0; I < NumEltsPerBlock; I += 1 {
        if BlockElts()[I] >= 0 && [I] as u32 != Elt0 + I {
            return false;
        }
    }
    DupLaneOp = Elt0 / NumEltsPerBlock;
    return true;
}

fn isEXTMask(M: ArrayRef<int>, VT: EVT, ReverseEXT: *mut bool, Imm: *mut u32) -> bool {
    let mut FirstRealElt: *i32 = find_if(M, Closure_28 {});
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut MaskBits: u32 = APInt { 32, NumElts * 2, false, false }.logBase2();
    let mut ExpectedElt: APInt = APInt { MaskBits, *FirstRealElt + 1, false, true };
    let mut FoundWrongElt: bool = any_of(FirstRealElt + 1, M.end(), Closure_29 { ExpectedElt: &mut ExpectedElt });
    if FoundWrongElt {
        return false;
    }
    Imm = ExpectedElt.getZExtValue();
    if Imm < NumElts {
        ReverseEXT = true;
    } else {
        Imm -= NumElts;
    }
    return true;
}

fn checkLaneSlide(Mask: ArrayRef<int>, LaneStart: u32, LaneElts: u32, NumElts: u32, IsLeftSlide: *mut bool) -> u32 {
    let mut FirstIdx: i32 = Mask[LaneStart];
    if FirstIdx > LaneStart as i32 && FirstIdx < (LaneStart + LaneElts) as i32 {
        let mut SlideAmt: u32 = FirstIdx - LaneStart;
        for let mut i: u32 = 0; i < LaneElts; i += 1 {
            let mut MaskIdx: i32 = Mask[LaneStart + i];
            if MaskIdx < 0 {
                continue;
            }
            if i < LaneElts - SlideAmt {
                if MaskIdx != (LaneStart + SlideAmt + i) as i32 {
                    return 0;
                }
            } else {
                if MaskIdx < NumElts as i32 {
                    return 0;
                }
            }
        }
        IsLeftSlide = true;
        return SlideAmt;
    }
    if Mask[LaneStart] >= NumElts as i32 || Mask[LaneStart] < 0 {
        let mut ZeroCount: u32 = 0;
        for let mut i: u32 = 0; i < LaneElts; i += 1 {
            let mut MaskIdx: i32 = Mask[LaneStart + i];
            if MaskIdx >= 0 && MaskIdx < NumElts as i32 {
                break;
            }
            ZeroCount += 1;
        }
        if ZeroCount > 0 && ZeroCount < LaneElts {
            for let mut i: u32 = ZeroCount; i < LaneElts; i += 1 {
                let mut MaskIdx: i32 = Mask[LaneStart + i];
                if MaskIdx < 0 {
                    continue;
                }
                if MaskIdx != (LaneStart + i - ZeroCount) as i32 {
                    return 0;
                }
            }
            IsLeftSlide = false;
            return ZeroCount;
        }
    }
    return 0;
}

fn isSlideWithZerosMask(M: ArrayRef<int>, VT: EVT, V1: SDValue, V2: SDValue, ShiftAmount: *mut u32, IsRightShift: *mut bool, MatchedLaneSize: *mut u32) -> SDValue {
    let mut VTSize: u32 = VT.getSizeInBits().operator unsigned long long();
    if VTSize != 64 && VTSize != 128 {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    let mut V1IsZeros: bool = isBuildVectorAllZeros(V1.getNode());
    let mut V2IsZeros: bool = isBuildVectorAllZeros(V2.getNode());
    if V1IsZeros == V2IsZeros {
        return SDValue {};
    }
    let mut Mask: SmallVector<int, 16> = M.begin();
    let mut DataVec: SDValue = V1;
    if V1IsZeros {
        commuteMask(Mask);
        DataVec = V2;
    }
    for LaneSize in [64, 32, 16] {
        if LaneSize < EltSize * 2 {
            break;
        }
        let mut LaneElts: u32 = LaneSize / EltSize;
        let mut NumLanes: u32 = VTSize / LaneSize;
        let mut FirstIsLeftSlide: bool = false;
        let mut FirstSlideAmt: u32 = checkLaneSlide(Mask, 0, LaneElts, NumElts, FirstIsLeftSlide);
        if FirstSlideAmt == 0 {
            continue;
        }
        let mut AllMatch: bool = true;
        for let mut Lane: u32 = 1; Lane < NumLanes; Lane += 1 {
            let mut IsLeftSlide: bool = false;
            let mut SlideAmt: u32 = checkLaneSlide(Mask, Lane * LaneElts, LaneElts, NumElts, IsLeftSlide);
            if SlideAmt != FirstSlideAmt || IsLeftSlide != FirstIsLeftSlide {
                AllMatch = false;
                break;
            }
        }
        if !AllMatch {
            continue;
        }
        ShiftAmount = FirstSlideAmt * EltSize;
        IsRightShift = FirstIsLeftSlide;
        if ShiftAmount > 0 && ShiftAmount < LaneSize {
            MatchedLaneSize = LaneSize;
            return DataVec;
        }
    }
    return SDValue {};
}

fn isEXTMaskWithSplat(M: ArrayRef<int>, VT: EVT, SplatOperand: u32, ReverseEXT: *mut bool, Imm: *mut u32) -> bool {
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut OtherBase: u32 = if SplatOperand == 0 { NumElts } else { 0 };
    let mut IsSplatElt: Closure_30 = Closure_30 { SplatOperand: SplatOperand, NumElts: NumElts };
    let mut PrefixSplatElts: u32 = 0;
    while PrefixSplatElts != NumElts && IsSplatElt.call(M[PrefixSplatElts]) {
        PrefixSplatElts += 1;
    }
    if PrefixSplatElts > 0 && PrefixSplatElts < NumElts {
        let mut Match: bool = true;
        for let mut I: u32 = PrefixSplatElts; I != NumElts; I += 1 {
            let mut Expected: i32 = OtherBase + I - PrefixSplatElts;
            if M[I] >= 0 && M[I] != Expected {
                Match = false;
                break;
            }
        }
        if Match {
            ReverseEXT = SplatOperand == 1;
            Imm = NumElts - PrefixSplatElts;
            return true;
        }
    }
    let mut SuffixSplatElts: u32 = 0;
    while SuffixSplatElts != NumElts && IsSplatElt.call(M[NumElts - 1 - SuffixSplatElts]) {
        SuffixSplatElts += 1;
    }
    if 0 < SuffixSplatElts && SuffixSplatElts < NumElts {
        let mut Match: bool = true;
        for let mut I: u32 = 0; I != NumElts - SuffixSplatElts; I += 1 {
            let mut Expected: i32 = OtherBase + I + SuffixSplatElts;
            if M[I] >= 0 && M[I] != Expected {
                Match = false;
                break;
            }
        }
        if Match {
            ReverseEXT = SplatOperand == 0;
            Imm = SuffixSplatElts;
            return true;
        }
    }
    return false;
}

fn isINSMask(M: ArrayRef<int>, NumInputElements: i32, DstIsLeft: *mut bool, Anomaly: *mut i32) -> bool {
    if M.len != NumInputElements as u64 {
        return false;
    }
    let mut NumLHSMatch: i32 = 0;
    let mut NumRHSMatch: i32 = 0;
    let mut LastLHSMismatch: i32 = -1;
    let mut LastRHSMismatch: i32 = -1;
    for let mut i: i32 = 0; i < NumInputElements; i += 1 {
        if M[i] == -1 {
            NumLHSMatch += 1;
            NumRHSMatch += 1;
            continue;
        }
        if M[i] == i {
            NumLHSMatch += 1;
        } else {
            LastLHSMismatch = i;
        }
        if M[i] == i + NumInputElements {
            NumRHSMatch += 1;
        } else {
            LastRHSMismatch = i;
        }
    }
    if NumLHSMatch == NumInputElements - 1 {
        DstIsLeft = true;
        Anomaly = LastLHSMismatch;
        return true;
    } else if NumRHSMatch == NumInputElements - 1 {
        DstIsLeft = false;
        Anomaly = LastRHSMismatch;
        return true;
    }
    return false;
}

fn isConcatMask(Mask: ArrayRef<int>, VT: EVT, SplitLHS: bool) -> bool {
    if VT.getSizeInBits().operator unsigned long long() != 128 {
        return false;
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    for let mut I: i32 = 0;
let mut E: i32 = NumElts / 2; I != E; I += 1 {
        if Mask[I] != I {
            return false;
        }
    }
    let mut Offset: i32 = NumElts / 2;
    for let mut I: i32 = NumElts / 2;
let mut E: i32 = NumElts; I != E; I += 1 {
        if Mask[I] != I + SplitLHS * Offset {
            return false;
        }
    }
    return true;
}

fn tryFormConcatFromShuffle(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut V0: SDValue = Op.getOperand(0);
    let mut V1: SDValue = Op.getOperand(1);
    let mut Mask: ArrayRef<int> = cast(Op)();
    if VT.getVectorElementType() != V0.getValueType().getVectorElementType() || VT.getVectorElementType() != V1.getValueType().getVectorElementType() {
        return SDValue {};
    }
    let mut SplitV0: bool = V0.getValueSizeInBits().operator unsigned long long() == 128;
    if !isConcatMask(Mask, VT, SplitV0) {
        return SDValue {};
    }
    let mut CastVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
    if SplitV0 {
        V0 = DAG.getExtractSubvector(DL, CastVT, V0, 0);
    }
    if V1.getValueSizeInBits().operator unsigned long long() == 128 {
        V1 = DAG.getExtractSubvector(DL, CastVT, V1, 0);
    }
    return DAG.getNode(CONCAT_VECTORS, DL, VT, V0, V1);
}

fn GenerateTBL(Op: SDValue, ShuffleMask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    let mut V1: SDValue = Op.getOperand(0);
    let mut V2: SDValue = Op.getOperand(1);
    let mut DL: SDLoc = Op;
    let mut EltVT: EVT = Op.getValueType().getVectorElementType();
    let mut BytesPerElt: u32 = EltVT.getSizeInBits().operator unsigned long long() / 8;
    let mut Swap: bool = false;
    if V1.isUndef() || isZerosVector(V1.getNode()) {
        swap(V1, V2);
        Swap = true;
    }
    let mut IsUndefOrZero: bool = V2.isUndef() || isZerosVector(V2.getNode());
    let mut IndexVT: MVT = v8i8;
    let mut IndexLen: u32 = 8;
    if Op.getValueSizeInBits().operator unsigned long long() == 128 {
        IndexVT = v16i8;
        IndexLen = 16;
    }
    let mut TBLMask: SmallVector<SDValue, 8> = zeroed();
    for Val in ShuffleMask {
        for let mut Byte: u32 = 0; Byte < BytesPerElt; Byte += 1 {
            let mut Offset: u32 = Byte + Val * BytesPerElt;
            if Swap {
                Offset = if Offset < IndexLen { Offset + IndexLen } else { Offset - IndexLen };
            }
            if IsUndefOrZero && Offset >= IndexLen {
                Offset = 255;
            }
            TBLMask()(DAG.getConstant(Offset, DL, i32, false, false));
        }
    }
    let mut V1Cst: SDValue = DAG.getNode(BITCAST, DL, IndexVT, V1);
    let mut V2Cst: SDValue = DAG.getNode(BITCAST, DL, IndexVT, V2);
    let mut Shuffle: SDValue = SDValue {};
    if IsUndefOrZero {
        if IndexLen == 8 {
            V1Cst = DAG.getNode(CONCAT_VECTORS, DL, v16i8, V1Cst, V1Cst);
        }
        Shuffle = DAG(INTRINSIC_WO_CHAIN, DL, IndexVT, DAG, V1Cst, DAG(IndexVT, DL));
    } else {
        if IndexLen == 8 {
            V1Cst = DAG.getNode(CONCAT_VECTORS, DL, v16i8, V1Cst, V2Cst);
            Shuffle = DAG(INTRINSIC_WO_CHAIN, DL, IndexVT, DAG, V1Cst, DAG(IndexVT, DL));
        } else {
            Shuffle = DAG(INTRINSIC_WO_CHAIN, DL, IndexVT, DAG, V1Cst, V2Cst, DAG(IndexVT, DL));
        }
    }
    return DAG.getNode(BITCAST, DL, Op.getValueType(), Shuffle);
}

fn getDUPLANEOp(EltType: EVT) -> u32 {
    llvm_unreachable_internal("Invalid vector element type?", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 15778);
}

fn constructDup(V: SDValue, Lane: i32, DL: SDLoc, VT: EVT, Opcode: u32, DAG: *mut SelectionDAG) -> SDValue {
    let mut getScaledOffsetDup: Closure_31 = Closure_31 {};
    let mut CastVT: MVT = MVT {};
    if getScaledOffsetDup.call(V, Lane, CastVT) {
        V = DAG.getBitcast(CastVT, V.getOperand(0).getOperand(0));
    } else if V.getOpcode() == EXTRACT_SUBVECTOR && V.getOperand(0).getValueType().is128BitVector() {
        Lane += V.getConstantOperandVal(1);
        V = V.getOperand(0);
    } else if V.getOpcode() == CONCAT_VECTORS {
        let mut Idx: u32 = Lane >= VT.getVectorNumElements() as i32 / 2;
        Lane -= Idx * VT.getVectorNumElements() / 2;
        V = WidenVector(V.getOperand(Idx), DAG);
    } else if VT.getSizeInBits().operator unsigned long long() == 64 {
        V = WidenVector(V, DAG);
    }
    return DAG.getNode(Opcode, DL, VT, V, DAG.getConstant(Lane, DL, i64, false, false));
}

fn tryWidenMaskForShuffle(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut ScalarVT: EVT = VT.getVectorElementType();
    let mut ElementSize: u32 = ScalarVT.getFixedSizeInBits();
    let mut V0: SDValue = Op.getOperand(0);
    let mut V1: SDValue = Op.getOperand(1);
    let mut Mask: ArrayRef<int> = cast(Op)();
    if ElementSize > 32 || ElementSize == 1 {
        return SDValue {};
    }
    let mut NewMask: SmallVector<int, 8> = zeroed();
    if widenShuffleMaskElts(Mask) {
        let mut NewEltVT: MVT = if VT.isFloatingPoint() { getFloatingPointVT(ElementSize * 2) } else { getIntegerVT(ElementSize * 2) };
        let mut NewVT: MVT = getVectorVT(NewEltVT, VT.getVectorNumElements() / 2);
        if DAG.getTargetLoweringInfo().isTypeLegal(NewVT) {
            V0 = DAG.getBitcast(NewVT, V0);
            V1 = DAG.getBitcast(NewVT, V1);
            return DAG.getBitcast(VT, DAG.getVectorShuffle(NewVT, DL, V0, V1));
        }
    }
    return SDValue {};
}

fn tryToConvertShuffleOfTbl2ToTbl4(Op: SDValue, ShuffleMask: ArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    let mut Tbl1: SDValue = operator(Op).getOperand(0);
    let mut Tbl2: SDValue = operator(Op).getOperand(1);
    let mut DL: SDLoc = Op;
    let mut Tbl2ID: SDValue = DAG;
    let mut VT: EVT = Op.getValueType();
    if Tbl1.getOpcode() != INTRINSIC_WO_CHAIN || Tbl1.getOperand(0) != Tbl2ID || Tbl2.getOpcode() != INTRINSIC_WO_CHAIN || Tbl2.getOperand(0) != Tbl2ID {
        return SDValue {};
    }
    if Tbl1.getValueType() != v16i8 || Tbl2.getValueType() != v16i8 {
        return SDValue {};
    }
    let mut Mask1: SDValue = Tbl1.getOperand(3);
    let mut Mask2: SDValue = Tbl2.getOperand(3);
    if Mask1.getOpcode() != BUILD_VECTOR || Mask2.getOpcode() != BUILD_VECTOR {
        return SDValue {};
    }
    let mut TBLMaskParts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { 16, SDValue {} };
    for let mut I: u32 = 0; I < 16; I += 1 {
        if ShuffleMask[I] < 16 {
            TBLMaskParts[I] = Mask1.getOperand(ShuffleMask[I]);
        } else {
            let mut C: *mut auto = dyn_cast(Mask2.getOperand(ShuffleMask[I] - 16));
            if operator!() {
                return SDValue {};
            }
            TBLMaskParts[I] = DAG(() + 32, DL, i32);
        }
    }
    let mut TBLMask: SDValue = DAG;
    let mut ID: SDValue = DAG;
    return DAG.getNode(INTRINSIC_WO_CHAIN, DL, v16i8, [ID, operator(Tbl1).getOperand(1), operator(Tbl1).getOperand(2), operator(Tbl2).getOperand(1), operator(Tbl2).getOperand(2), TBLMask]);
}

fn AArch64TargetLowering::LowerEXTEND_VECTOR_INREG(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isScalableVector(), "Unexpected result type!");
    let mut Signed: bool = Op.getOpcode() == SIGN_EXTEND_VECTOR_INREG;
    let mut UnpackOpcode: u32 = 0;
    let mut Val: SDValue = Op.getOperand(0);
    match Val.getSimpleValueType().SimpleTy {
        _ => {
            return SDValue {};
        },
        nxv16i8 => {
            Val = DAG.getNode(UnpackOpcode, DL, nxv8i16, Val);
        },
        nxv8i16 => {
            Val = DAG.getNode(UnpackOpcode, DL, nxv4i32, Val);
        },
        nxv4i32 => {
            Val = DAG.getNode(UnpackOpcode, DL, nxv2i64, Val);
        },
    }
    return Val;
}

fn AArch64TargetLowering::LowerZERO_EXTEND_VECTOR_INREG(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    if VT.isScalableVector() {
        return self.LowerEXTEND_VECTOR_INREG(Op, DAG);
    }
    let mut SrcOp: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = SrcOp.getValueType();
    assert!(VT.getScalarSizeInBits() % SrcVT.getScalarSizeInBits() == 0, "Unexpected extension factor.");
    let mut Scale: u32 = VT.getScalarSizeInBits() / SrcVT.getScalarSizeInBits();
    if Scale != 2 {
        return SDValue {};
    }
    let mut Zeros: SDValue = DAG.getConstant(0, DL, SrcVT, false, false);
    return DAG.getBitcast(VT, DAG);
}

fn AArch64TargetLowering::LowerVECTOR_SHUFFLE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut SVN: *mut ShuffleVectorSDNode = cast(Op.getNode());
    if self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()) {
        return self.LowerFixedLengthVECTOR_SHUFFLEToSVE(Op, DAG);
    }
    let mut ShuffleMask: ArrayRef<int> = SVN.getMask();
    let mut V1: SDValue = Op.getOperand(0);
    let mut V2: SDValue = Op.getOperand(1);
    assert!(V1.getValueType() == VT, "Unexpected VECTOR_SHUFFLE type!");
    assert!(ShuffleMask.len == VT.getVectorNumElements(), "Unexpected VECTOR_SHUFFLE mask size!");
    if tryToConvertShuffleOfTbl2ToTbl4(Op, ShuffleMask, DAG) {
        Res;
    } else {
        return Res;
    }
    if SVN.isSplat() {
        let mut Lane: i32 = SVN.getSplatIndex();
        if Lane == -1 {
            Lane = 0;
        }
        if Lane == 0 && V1.getOpcode() == SCALAR_TO_VECTOR {
            return DAG;
        }
        if V1.getOpcode() == BUILD_VECTOR && !isa(V1.getOperand(Lane)) {
            return DAG;
        }
        let mut Opcode: u32 = getDUPLANEOp(V1.getValueType().getVectorElementType());
        return constructDup(V1, Lane, DL, VT, Opcode, DAG);
    }
    for LaneSize in [64, 32, 16] {
        let mut Lane: u32 = 0;
        if isWideDUPMask(ShuffleMask, VT, LaneSize, Lane) {
            let mut Opcode: u32 = 0;
            let mut NewEltTy: MVT = getIntegerVT(LaneSize);
            let mut NewEltCount: u32 = VT.getSizeInBits().operator unsigned long long() / LaneSize;
            let mut NewVecTy: MVT = getVectorVT(NewEltTy, NewEltCount);
            V1 = DAG.getBitcast(NewVecTy, V1);
            V1 = constructDup(V1, Lane, DL, NewVecTy, Opcode, DAG);
            return DAG.getBitcast(VT, V1);
        }
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    if isREVMask(ShuffleMask, EltSize, NumElts, 64) {
        return DAG;
    }
    if isREVMask(ShuffleMask, EltSize, NumElts, 32) {
        return DAG;
    }
    if isREVMask(ShuffleMask, EltSize, NumElts, 16) {
        let mut VT: EVT = V1.getValueType();
        assert!(VT == v8i8 || VT == v16i8);
        let mut BSVT: EVT = if VT == v8i8 { v4i16 } else { v8i16 };
        return DAG;
    }
    if ((NumElts == 8 && EltSize == 16) || (NumElts == 16 && EltSize == 8) || (NumElts == 4 && EltSize == 32)) && isReverseMask(ShuffleMask, ShuffleMask.len) {
        if self.Subtarget.isSVEorStreamingSVEAvailable() && self.Subtarget.getSVEVectorSizeInBits() == 128 {
            let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
            V1 = convertToScalableVector(DAG, ContainerVT, V1);
            let mut Rev: SDValue = DAG.getNode(VECTOR_REVERSE, DL, ContainerVT, V1);
            return convertFromScalableVector(DAG, VT, Rev);
        }
        let mut Rev: SDValue = DAG;
        return DAG;
    }
    {
        let mut ShiftAmount: u32 = 0;
        let mut IsRightShift: bool = false;
        let mut MatchedLaneSize: u32 = 0;
        if isSlideWithZerosMask(ShuffleMask, VT, V1, V2, ShiftAmount, IsRightShift, MatchedLaneSize) {
            DataVec;
        } else {
            let mut ShiftVT: MVT = getVectorVT(getIntegerVT(MatchedLaneSize), VT.getSizeInBits().operator unsigned long long() / MatchedLaneSize);
            let mut Vec: SDValue = DAG;
            let mut ShiftAmt: SDValue = DAG.getTargetConstant(ShiftAmount, DL, i32, false);
            let mut Opc: u32 = 0;
            let mut Shifted: SDValue = DAG.getNode(Opc, DL, ShiftVT, Vec, ShiftAmt);
            return DAG;
        }
    }
    let mut IsSplat1: bool = V1.getValueType() == VT && DAG.isSplatValue(V1, false);
    let mut IsSplat2: bool = V2.getValueType() == VT && DAG.isSplatValue(V2, false);
    for SplatOperand in [0, 1] {
        if (SplatOperand == 0 && !IsSplat1) || (SplatOperand == 1 && !IsSplat2) {
            continue;
        }
        let mut ReverseSplatEXT: bool = false;
        let mut SplatImm: u32 = 0;
        if isEXTMaskWithSplat(ShuffleMask, VT, SplatOperand, ReverseSplatEXT, SplatImm) {
            let mut ExtOp1: SDValue = V1;
            let mut ExtOp2: SDValue = V2;
            if ReverseSplatEXT {
                swap(ExtOp1, ExtOp2);
            }
            SplatImm *= getExtFactor(ExtOp1);
            return DAG;
        }
    }
    let mut ReverseEXT: bool = false;
    let mut Imm: u32 = 0;
    if isEXTMask(ShuffleMask, VT, ReverseEXT, Imm) {
        if ReverseEXT {
            swap(V1, V2);
        }
        Imm *= getExtFactor(V1);
        return DAG;
    } else if operator(V2).isUndef() && isSingletonEXTMask(ShuffleMask, VT, Imm) {
        Imm *= getExtFactor(V1);
        return DAG;
    }
    let mut WhichResult: u32 = 0;
    let mut OperandOrder: u32 = 0;
    if isZIPMask(ShuffleMask, NumElts, WhichResult, OperandOrder) {
        let mut Opc: u32 = 0;
        return DAG.getNode(Opc, DL, V1.getValueType(), if OperandOrder == 0 { V1 } else { V2 }, if OperandOrder == 0 { V2 } else { V1 });
    }
    if isUZPMask(ShuffleMask, NumElts, WhichResult) {
        let mut Opc: u32 = 0;
        return DAG.getNode(Opc, DL, V1.getValueType(), V1, V2);
    }
    if isTRNMask(ShuffleMask, NumElts, WhichResult, OperandOrder) {
        let mut Opc: u32 = 0;
        return DAG.getNode(Opc, DL, V1.getValueType(), if OperandOrder == 0 { V1 } else { V2 }, if OperandOrder == 0 { V2 } else { V1 });
    }
    if isZIP_v_undef_Mask(ShuffleMask, NumElts, WhichResult) {
        let mut Opc: u32 = 0;
        return DAG.getNode(Opc, DL, V1.getValueType(), V1, V1);
    }
    if isUZP_v_undef_Mask(ShuffleMask, NumElts, WhichResult) {
        let mut Opc: u32 = 0;
        return DAG.getNode(Opc, DL, V1.getValueType(), V1, V1);
    }
    if isTRN_v_undef_Mask(ShuffleMask, NumElts, WhichResult) {
        let mut Opc: u32 = 0;
        return DAG.getNode(Opc, DL, V1.getValueType(), V1, V1);
    }
    if tryFormConcatFromShuffle(Op, DAG) {
        Concat;
    } else {
        return Concat;
    }
    let mut DstIsLeft: bool = false;
    let mut DstLane: i32 = 0;
    let mut NumInputElements: i32 = V1.getValueType().getVectorNumElements();
    if isINSMask(ShuffleMask, NumInputElements, DstIsLeft, DstLane) {
        let mut DstVec: SDValue = if DstIsLeft { V1 } else { V2 };
        let mut SrcVec: SDValue = V1;
        let mut SrcLane: i32 = ShuffleMask[DstLane];
        if SrcLane >= NumInputElements {
            SrcVec = V2;
            SrcLane -= NumElts;
        }
        let mut ScalarVT: EVT = VT.getVectorElementType();
        if ScalarVT.getFixedSizeInBits() < 32 && ScalarVT.isInteger() {
            ScalarVT = i32;
        }
        return DAG.getInsertVectorElt(DL, DstVec, DAG.getExtractVectorElt(DL, ScalarVT, SrcVec, SrcLane), DstLane);
    }
    if tryWidenMaskForShuffle(Op, DAG) {
        NewSD;
    } else {
        return NewSD;
    }
    if NumElts == 4 {
        let mut Entries: i32 = 0;
        if generatePerfectShuffle(ShuffleMask, NumElts) {
            let mut Vals: i32 = 0;
            let mut getValue: Closure_32 = Closure_32 {};
            (((operator!(operator!((Vals()() == ())))) || (_wassert(L"Vals.size() == Entries.size()", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (16341) as u32) , 0)) as void);
            return ();
        }
    }
    if isSelectMask(ShuffleMask, NumElts) {
        assert!(VT.getScalarSizeInBits() <= 32, "Expected larger vector element sizes to be handled already");
        let mut MaskElts: i32 = 0;
        let mut IVT: EVT = VT.changeVectorElementTypeToInteger();
        let mut MaskConst: SDValue = DAG(IVT, DL);
        return DAG.getBitcast(VT, DAG);
    }
    return GenerateTBL(Op, ShuffleMask, DAG);
}

fn AArch64TargetLowering::LowerSPLAT_VECTOR(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    if self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()) {
        return self.LowerToScalableOp(Op, DAG);
    }
    assert!(VT.isScalableVectorOf(i1), "Unexpected vector type!");
    if isa(Op.getOperand(0)) {
        return Op;
    }
    let mut DL: SDLoc = Op;
    let mut SplatVal: SDValue = DAG.getAnyExtOrTrunc(Op.getOperand(0), DL, i64);
    SplatVal = DAG.getNode(SIGN_EXTEND_INREG, DL, i64, SplatVal, DAG.getValueType(i1));
    let mut ID: SDValue = DAG;
    let mut Zero: SDValue = DAG.getConstant(0, DL, i64, false, false);
    if VT == nxv1i1 {
        return DAG.getExtractSubvector(DL, nxv1i1, DAG.getNode(INTRINSIC_WO_CHAIN, DL, nxv2i1, ID, Zero, SplatVal), 0);
    }
    return DAG.getNode(INTRINSIC_WO_CHAIN, DL, VT, ID, Zero, SplatVal);
}

fn AArch64TargetLowering::LowerDUPQLane(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    if !self.isTypeLegal(VT) || !VT.isScalableVector() {
        return SDValue {};
    }
    if VT.getSizeInBits().getKnownMinValue() != SVEBitsPerBlock {
        return SDValue {};
    }
    let mut Idx128: SDValue = Op.getOperand(2);
    let mut CIdx: *mut auto = dyn_cast(Idx128);
    if CIdx() && (CIdx()() <= 3) {
        let mut CI: SDValue = DAG(DL, i64);
        return DAG;
    }
    let mut V: SDValue = DAG.getNode(BITCAST, DL, nxv2i64, Op.getOperand(1));
    let mut One: SDValue = DAG.getConstant(1, DL, i64, false, false);
    let mut SplatOne: SDValue = DAG.getNode(SPLAT_VECTOR, DL, nxv2i64, One);
    let mut SV: SDValue = DAG.getStepVector(DL, nxv2i64);
    SV = DAG.getNode(AND, DL, nxv2i64, SV, SplatOne);
    let mut Idx64: SDValue = DAG.getNode(ADD, DL, i64, Idx128, Idx128);
    let mut SplatIdx64: SDValue = DAG.getNode(SPLAT_VECTOR, DL, nxv2i64, Idx64);
    let mut ShuffleMask: SDValue = DAG.getNode(ADD, DL, nxv2i64, SV, SplatIdx64);
    let mut TBL: SDValue = DAG;
    return DAG.getNode(BITCAST, DL, VT, TBL);
}

fn resolveBuildVector(BVN: *mut BuildVectorSDNode, CnstBits: *mut APInt, UndefBits: *mut APInt) -> bool {
    let mut VT: EVT = BVN.getValueType(0);
    let mut SplatBits: APInt = APInt {};
    let mut SplatUndef: APInt = APInt {};
    let mut SplatBitSize: u32 = 0;
    let mut HasAnyUndefs: bool = false;
    if BVN.isConstantSplat(SplatBits, SplatUndef, SplatBitSize, HasAnyUndefs, 0, false) {
        let mut NumSplats: u32 = VT.getSizeInBits().operator unsigned long long() / SplatBitSize;
        for let mut i: u32 = 0; i < NumSplats; i += 1 {
            operator(CnstBits, SplatBitSize);
            operator(UndefBits, SplatBitSize);
            operator(CnstBits, SplatBits.zextOrTrunc(VT.getSizeInBits().operator unsigned long long()));
            operator(UndefBits, (SplatBits ^ SplatUndef).zextOrTrunc(VT.getSizeInBits().operator unsigned long long()));
        }
        return true;
    }
    return false;
}

fn tryAdvSIMDModImm64(NewOp: u32, Op: SDValue, DAG: *mut SelectionDAG, Bits: *APInt) -> SDValue {
    if Bits.getHiBits(64) == Bits.getLoBits(64) {
        let mut Value: u64 = Bits.zextOrTrunc(64).getZExtValue();
        let mut VT: EVT = Op.getValueType();
        let mut MovTy: MVT = if (VT.getSizeInBits().operator unsigned long long() == 128) { v2i64 } else { f64 };
        if isAdvSIMDModImmType10(Value) {
            Value = encodeAdvSIMDModImmType10(Value);
            let mut DL: SDLoc = Op;
            let mut Mov: SDValue = DAG.getNode(NewOp, DL, MovTy, DAG.getConstant(Value, DL, i32, false, false));
            return DAG;
        }
    }
    return SDValue {};
}

fn tryAdvSIMDModImm32(NewOp: u32, Op: SDValue, DAG: *mut SelectionDAG, Bits: *APInt, LHS: *SDValue) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    if VT.isFixedLengthVector() && operator!(DAG()) {
        return SDValue {};
    }
    if Bits.getHiBits(64) == Bits.getLoBits(64) {
        let mut Value: u64 = Bits.zextOrTrunc(64).getZExtValue();
        let mut MovTy: MVT = if (VT.getSizeInBits().operator unsigned long long() == 128) { v4i32 } else { v2i32 };
        let mut isAdvSIMDModImm: bool = false;
        let mut Shift: u64 = 0;
        if (isAdvSIMDModImm = isAdvSIMDModImmType1(Value)) {
            Value = encodeAdvSIMDModImmType1(Value);
            Shift = 0;
        } else if (isAdvSIMDModImm = isAdvSIMDModImmType2(Value)) {
            Value = encodeAdvSIMDModImmType2(Value);
            Shift = 8;
        } else if (isAdvSIMDModImm = isAdvSIMDModImmType3(Value)) {
            Value = encodeAdvSIMDModImmType3(Value);
            Shift = 16;
        } else if (isAdvSIMDModImm = isAdvSIMDModImmType4(Value)) {
            Value = encodeAdvSIMDModImmType4(Value);
            Shift = 24;
        }
        if isAdvSIMDModImm {
            let mut DL: SDLoc = Op;
            let mut Mov: SDValue = SDValue {};
            if LHS {
                Mov = DAG(NewOp, DL, MovTy, DAG, DAG.getConstant(Value, DL, i32, false, false), DAG.getConstant(Shift, DL, i32, false, false));
            } else {
                Mov = DAG.getNode(NewOp, DL, MovTy, DAG.getConstant(Value, DL, i32, false, false), DAG.getConstant(Shift, DL, i32, false, false));
            }
            return DAG;
        }
    }
    return SDValue {};
}

fn tryAdvSIMDModImm16(NewOp: u32, Op: SDValue, DAG: *mut SelectionDAG, Bits: *APInt, LHS: *SDValue) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    if VT.isFixedLengthVector() && operator!(DAG()) {
        return SDValue {};
    }
    if Bits.getHiBits(64) == Bits.getLoBits(64) {
        let mut Value: u64 = Bits.zextOrTrunc(64).getZExtValue();
        let mut MovTy: MVT = if (VT.getSizeInBits().operator unsigned long long() == 128) { v8i16 } else { v4i16 };
        let mut isAdvSIMDModImm: bool = false;
        let mut Shift: u64 = 0;
        if (isAdvSIMDModImm = isAdvSIMDModImmType5(Value)) {
            Value = encodeAdvSIMDModImmType5(Value);
            Shift = 0;
        } else if (isAdvSIMDModImm = isAdvSIMDModImmType6(Value)) {
            Value = encodeAdvSIMDModImmType6(Value);
            Shift = 8;
        }
        if isAdvSIMDModImm {
            let mut DL: SDLoc = Op;
            let mut Mov: SDValue = SDValue {};
            if LHS {
                Mov = DAG(NewOp, DL, MovTy, DAG, DAG.getConstant(Value, DL, i32, false, false), DAG.getConstant(Shift, DL, i32, false, false));
            } else {
                Mov = DAG.getNode(NewOp, DL, MovTy, DAG.getConstant(Value, DL, i32, false, false), DAG.getConstant(Shift, DL, i32, false, false));
            }
            return DAG;
        }
    }
    return SDValue {};
}

fn tryAdvSIMDModImm321s(NewOp: u32, Op: SDValue, DAG: *mut SelectionDAG, Bits: *APInt) -> SDValue {
    if Bits.getHiBits(64) == Bits.getLoBits(64) {
        let mut Value: u64 = Bits.zextOrTrunc(64).getZExtValue();
        let mut VT: EVT = Op.getValueType();
        let mut MovTy: MVT = if (VT.getSizeInBits().operator unsigned long long() == 128) { v4i32 } else { v2i32 };
        let mut isAdvSIMDModImm: bool = false;
        let mut Shift: u64 = 0;
        if (isAdvSIMDModImm = isAdvSIMDModImmType7(Value)) {
            Value = encodeAdvSIMDModImmType7(Value);
            Shift = 264;
        } else if (isAdvSIMDModImm = isAdvSIMDModImmType8(Value)) {
            Value = encodeAdvSIMDModImmType8(Value);
            Shift = 272;
        }
        if isAdvSIMDModImm {
            let mut DL: SDLoc = Op;
            let mut Mov: SDValue = DAG.getNode(NewOp, DL, MovTy, DAG.getConstant(Value, DL, i32, false, false), DAG.getConstant(Shift, DL, i32, false, false));
            return DAG;
        }
    }
    return SDValue {};
}

fn tryAdvSIMDModImm8(NewOp: u32, Op: SDValue, DAG: *mut SelectionDAG, Bits: *APInt) -> SDValue {
    if Bits.getHiBits(64) == Bits.getLoBits(64) {
        let mut Value: u64 = Bits.zextOrTrunc(64).getZExtValue();
        let mut VT: EVT = Op.getValueType();
        let mut MovTy: MVT = if (VT.getSizeInBits().operator unsigned long long() == 128) { v16i8 } else { v8i8 };
        if isAdvSIMDModImmType9(Value) {
            Value = encodeAdvSIMDModImmType9(Value);
            let mut DL: SDLoc = Op;
            let mut Mov: SDValue = DAG.getNode(NewOp, DL, MovTy, DAG.getConstant(Value, DL, i32, false, false));
            return DAG;
        }
    }
    return SDValue {};
}

fn tryAdvSIMDModImmFP(NewOp: u32, Op: SDValue, DAG: *mut SelectionDAG, Bits: *APInt) -> SDValue {
    if Bits.getHiBits(64) == Bits.getLoBits(64) {
        let mut Value: u64 = Bits.zextOrTrunc(64).getZExtValue();
        let mut VT: EVT = Op.getValueType();
        let mut isWide: bool = (VT.getSizeInBits().operator unsigned long long() == 128);
        let mut MovTy: MVT = MVT {};
        let mut isAdvSIMDModImm: bool = false;
        if (isAdvSIMDModImm = isAdvSIMDModImmType11(Value)) {
            Value = encodeAdvSIMDModImmType11(Value);
            MovTy = if isWide { v4f32 } else { v2f32 };
        } else if isWide && (isAdvSIMDModImm = isAdvSIMDModImmType12(Value)) {
            Value = encodeAdvSIMDModImmType12(Value);
            MovTy = v2f64;
        }
        if isAdvSIMDModImm {
            let mut DL: SDLoc = Op;
            let mut Mov: SDValue = DAG.getNode(NewOp, DL, MovTy, DAG.getConstant(Value, DL, i32, false, false));
            return DAG;
        }
    }
    return SDValue {};
}

fn isAllConstantBuildVector(PotentialBVec: *SDValue, ConstVal: *mut u64) -> bool {
    let mut Bvec: *mut BuildVectorSDNode = dyn_cast(PotentialBVec);
    if !Bvec {
        return false;
    }
    let mut FirstElt: *mut ConstantSDNode = dyn_cast(Bvec.getOperand(0));
    if !FirstElt {
        return false;
    }
    let mut VT: EVT = Bvec.getValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    for let mut i: u32 = 1; i < NumElts; i += 1 {
        if dyn_cast(Bvec.getOperand(i)) != FirstElt {
            return false;
        }
    }
    ConstVal = FirstElt.getZExtValue();
    return true;
}

fn isAllInactivePredicate(N: SDValue) -> bool {
    while  {
        N = N.getOperand(0);
    }
    return isConstantSplatVectorAllZeros(N.getNode(), false);
}

fn isAllActivePredicate(DAG: *SelectionDAG, N: SDValue) -> bool {
    let mut NumElts: u32 = N.getValueType().getVectorMinNumElements();
    while  {
        N = N.getOperand(0);
        if N.getValueType().getVectorMinNumElements() < NumElts {
            return false;
        }
    }
    if isConstantSplatVectorAllOnes(N.getNode(), false) {
        return true;
    }
    if  {
        return N.getValueType().getVectorMinNumElements() >= NumElts;
    }
    return false;
}

fn tryLowerToSLI(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isVector() {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut And: SDValue = SDValue {};
    let mut Shift: SDValue = SDValue {};
    let mut FirstOp: SDValue = N.getOperand(0);
    let mut FirstOpc: u32 = FirstOp.getOpcode();
    let mut SecondOp: SDValue = N.getOperand(1);
    let mut SecondOpc: u32 = SecondOp.getOpcode();
    if  {
        And = FirstOp;
        Shift = SecondOp;
    } else if  {
        And = SecondOp;
        Shift = FirstOp;
    } else {
        return SDValue {};
    }
    let mut IsAnd: bool = And.getOpcode() == AND;
    let mut IsShiftRight: bool = false;
    let mut ShiftHasPredOp: bool = false;
    let mut C2: u64 = 0;
    if ShiftHasPredOp {
        if !isAllActivePredicate(DAG, Shift.getOperand(0)) {
            return SDValue {};
        }
        let mut C: APInt = APInt {};
        if !isConstantSplatVector(Shift.getOperand(2).getNode(), C) {
            return SDValue {};
        }
        C2 = C.getZExtValue();
    } else if dyn_cast(Shift.getOperand(1)) {
        C2node;
    } else {
        C2 = C2node.getZExtValue();
    }
    let mut C1AsAPInt: APInt = APInt {};
    let mut ElemSizeInBits: u32 = VT.getScalarSizeInBits();
    if IsAnd {
        if !isConstantSplatVector(And.getOperand(1).getNode(), C1AsAPInt) {
            return SDValue {};
        }
    } else {
        let mut C1nodeImm: *mut ConstantSDNode = dyn_cast(And.getOperand(1));
        let mut C1nodeShift: *mut ConstantSDNode = dyn_cast(And.getOperand(2));
        assert!(C1nodeImm && C1nodeShift);
        C1AsAPInt = operator((C1nodeImm.getAPIntValue() << C1nodeShift.getAPIntValue()));
        C1AsAPInt = C1AsAPInt.zextOrTrunc(ElemSizeInBits);
    }
    if C2 > ElemSizeInBits {
        return SDValue {};
    }
    let mut RequiredC1: APInt = if IsShiftRight { getHighBitsSet(ElemSizeInBits, C2) } else { getLowBitsSet(ElemSizeInBits, C2) };
    if C1AsAPInt != RequiredC1 {
        return SDValue {};
    }
    let mut X: SDValue = And.getOperand(0);
    let mut Y: SDValue = if ShiftHasPredOp { Shift.getOperand(1) } else { Shift.getOperand(0) };
    let mut Imm: SDValue = if ShiftHasPredOp { DAG.getTargetConstant(C2, DL, i32, false) } else { Shift.getOperand(1) };
    let mut Inst: u32 = 0;
    return DAG.getNode(Inst, DL, VT, X, Y, Imm);
}

fn tryLowerToBSL(N: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = operator(N).getValueType(0);
    assert!(VT.isVector(), "Expected vector type in tryLowerToBSL\n");
    let mut DL: SDLoc = N;
    let mut Subtarget: *auto = DAG;
    if VT.isScalableVector() && operator!() {
        return SDValue {};
    }
    let mut N0: SDValue = operator(N).getOperand(0);
    if N0.getOpcode() != AND {
        return SDValue {};
    }
    let mut N1: SDValue = operator(N).getOperand(1);
    if N1.getOpcode() != AND {
        return SDValue {};
    }
    for let mut i: i32 = 1; i >= 0; i -= 1 {
        for let mut j: i32 = 1; j >= 0; j -= 1 {
            let mut O0: SDValue = operator(N0).getOperand(i);
            let mut O1: SDValue = operator(N1).getOperand(j);
            let mut Sub: SDValue = SDValue {};
            let mut Add: SDValue = SDValue {};
            let mut SubSibling: SDValue = SDValue {};
            let mut AddSibling: SDValue = SDValue {};
            if O0.getOpcode() == SUB && O1.getOpcode() == ADD {
                Sub = O0;
                Add = O1;
                SubSibling = operator(N0).getOperand(1 - i);
                AddSibling = operator(N1).getOperand(1 - j);
            } else if O0.getOpcode() == ADD && O1.getOpcode() == SUB {
                Add = O0;
                Sub = O1;
                AddSibling = operator(N0).getOperand(1 - i);
                SubSibling = operator(N1).getOperand(1 - j);
            } else {
                continue;
            }
            if !isConstantSplatVectorAllZeros(Sub.getOperand(0).getNode(), false) {
                continue;
            }
            if !isConstantSplatVectorAllOnes(Add.getOperand(1).getNode(), false) {
                continue;
            }
            if Sub.getOperand(1) != Add.getOperand(0) {
                continue;
            }
            return DAG;
        }
    }
    let mut Bits: u32 = VT.getScalarSizeInBits();
    for let mut i: i32 = 1; i >= 0; i -= 1 {
        for let mut j: i32 = 1; j >= 0; j -= 1 {
            let mut Val1: APInt = APInt {};
            let mut Val2: APInt = APInt {};
            if isConstantSplatVector(operator(N0).getOperand(i).getNode(), Val1) && isConstantSplatVector(operator(N1).getOperand(j).getNode(), Val2) && operator(Val1.trunc(Bits)) == Val2.trunc(Bits) {
                return DAG;
            }
            let mut BVN0: *mut BuildVectorSDNode = dyn_cast(operator(N0).getOperand(i));
            let mut BVN1: *mut BuildVectorSDNode = dyn_cast(operator(N1).getOperand(j));
            if !BVN0 || !BVN1 {
                continue;
            }
            let mut FoundMatch: bool = true;
            for let mut k: u32 = 0; k < VT.getVectorNumElements(); k += 1 {
                let mut CN0: *mut ConstantSDNode = dyn_cast(BVN0.getOperand(k));
                let mut CN1: *mut ConstantSDNode = dyn_cast(BVN1.getOperand(k));
                if !CN0 || !CN1 || CN0.getAPIntValue().trunc(Bits) != operator(CN1.getAsAPIntVal().trunc(Bits)) {
                    FoundMatch = false;
                    break;
                }
            }
            if FoundMatch {
                return DAG;
            }
        }
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerVectorOR(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if self.useSVEForFixedLengthVectorVT(Op.getValueType(), !self.Subtarget.isNeonAvailable()) {
        return self.LowerToScalableOp(Op, DAG);
    }
    if tryLowerToBSL(Op, DAG) {
        Res;
    } else {
        return Res;
    }
    if tryLowerToSLI(Op.getNode(), DAG) {
        Res;
    } else {
        return Res;
    }
    let mut VT: EVT = Op.getValueType();
    if VT.isScalableVector() {
        return Op;
    }
    let mut LHS: SDValue = Op.getOperand(0);
    let mut BVN: *mut BuildVectorSDNode = dyn_cast(Op.getOperand(1).getNode());
    if !BVN {
        LHS = Op.getOperand(1);
        BVN = dyn_cast(Op.getOperand(0).getNode());
    }
    if !BVN {
        return Op;
    }
    let mut DefBits: APInt = APInt { VT.getSizeInBits().operator unsigned long long(), 0, false, false };
    let mut UndefBits: APInt = APInt { VT.getSizeInBits().operator unsigned long long(), 0, false, false };
    if resolveBuildVector(BVN, DefBits, UndefBits) {
        let mut NewOp: SDValue = SDValue {};
        if (NewOp = tryAdvSIMDModImm32(Op, DAG, DefBits, &mut LHS)) || (NewOp = tryAdvSIMDModImm16(Op, DAG, DefBits, &mut LHS)) {
            return NewOp;
        }
        if (NewOp = tryAdvSIMDModImm32(Op, DAG, UndefBits, &mut LHS)) || (NewOp = tryAdvSIMDModImm16(Op, DAG, UndefBits, &mut LHS)) {
            return NewOp;
        }
    }
    return Op;
}

fn NormalizeBuildVector(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op.getOpcode() == BUILD_VECTOR, "Unknown opcode!");
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut EltTy: EVT = VT.getVectorElementType();
    if EltTy.isFloatingPoint() || EltTy.getSizeInBits().operator unsigned long long() > 16 {
        return Op;
    }
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    for Lane in operator(Op).ops() {
        if  {
            Lane = DAG(()(EltTy.getSizeInBits())(), DL, i32);
        } else if Lane.getOpcode() == POISON {
            Lane = DAG.getPOISON(i32);
        } else if Lane.getOpcode() == UNDEF {
            Lane = DAG.getUNDEF(i32);
        } else {
            if Lane.getValueType() == i64 {
                Lane = DAG.getNode(TRUNCATE, DL, i32, Lane);
            }
            assert!(Lane.getValueType() == i32, "Unexpected BUILD_VECTOR operand type");
        }
        Ops.push(Lane);
    }
    return DAG;
}

fn trySVESplat64(Op: SDValue, DAG: *mut SelectionDAG, ST: *AArch64Subtarget, DefBits: *mut APInt) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    if operator!(ST()()) || !VT.is128BitVector() || DefBits.getHiBits(64) != DefBits.getLoBits(64) {
        return SDValue {};
    }
    let mut Val64: APInt = DefBits.trunc(64);
    let mut ImmVal: i32 = 0;
    let mut ShiftVal: i32 = 0;
    let mut Encoding: u64 = 0;
    if !isSVECpyDupImm(64, Val64.getSExtValue(), ImmVal, ShiftVal) && !isSVELogicalImm(64, Val64.getZExtValue(), Encoding) {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut SplatVal: SDValue = DAG;
    return DAG;
}

fn ConstantBuildVector(Op: SDValue, DAG: *mut SelectionDAG, ST: *AArch64Subtarget) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!((VT.getSizeInBits().operator unsigned long long() == 64 || VT.getSizeInBits().operator unsigned long long() == 128), "Expected a legal NEON vector");
    let mut DefBits: APInt = APInt { VT.getSizeInBits().operator unsigned long long(), 0, false, false };
    let mut UndefBits: APInt = APInt { VT.getSizeInBits().operator unsigned long long(), 0, false, false };
    let mut BVN: *mut BuildVectorSDNode = cast(Op.getNode());
    if resolveBuildVector(BVN, DefBits, UndefBits) {
        let mut TryMOVIWithBits: Closure_33 = Closure_33 { Op: &mut Op, DAG: &mut DAG };
        if TryMOVIWithBits.call(DefBits) {
            R;
        } else {
            return R;
        }
        if TryMOVIWithBits.call(UndefBits) {
            R;
        } else {
            return R;
        }
        if trySVESplat64(Op, DAG, ST, DefBits) {
            R;
        } else {
            return R;
        }
        let mut TryWithFNeg: Closure_34 = Closure_34 { VT: &mut VT, TryMOVIWithBits: &mut TryMOVIWithBits, Op: &mut Op, DAG: &mut DAG };
        let mut R: SDValue = SDValue {};
        if (R = TryWithFNeg(DefBits, f32)) || (R = TryWithFNeg(DefBits, f64)) || (ST()() && (R = TryWithFNeg(DefBits, f16))) {
            return R;
        }
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerFixedLengthBuildVectorToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut BVN: *mut auto = cast(Op);
    if  {
        let mut Start: SDValue = DAG(DL, ContainerVT);
        let mut Steps: SDValue = DAG(DL, ContainerVT);
        let mut Seq: SDValue = DAG.getNode(ADD, DL, ContainerVT, Start, Steps);
        return convertFromScalableVector(DAG, VT, Seq);
    }
    let mut NumElems: u32 = VT.getVectorNumElements();
    if !VT.isPow2VectorType() || VT.getFixedSizeInBits() > 128 || NumElems <= 1 || () {
        return SDValue {};
    }
    let mut IsExtractElt: Closure_35 = Closure_35 {};
    if VT.getScalarType().isInteger() && NumElems - count_if(operator(Op).op_values(), IsExtractElt) > 4 {
        return SDValue {};
    }
    let mut Intermediates: SmallVector<SDValue, 16> = map_to_vector(operator(Op).op_values(), Closure_36 { cap_0: DAG.getPOISON(ContainerVT), DAG: &mut DAG, DL: &mut DL });
    let mut ZipEC: ElementCount = ContainerVT.getVectorElementCount();
    while Intermediates.len > 1 {
        let mut ZipVT: EVT = getPackedSVEVectorVT(ZipEC);
        for let mut I: u32 = 0; I < Intermediates.len; I += 2 {
            let mut Op0: SDValue = DAG.getBitcast(ZipVT, Intermediates[I + 0]);
            let mut Op1: SDValue = DAG.getBitcast(ZipVT, Intermediates[I + 1]);
            Intermediates[I / 2] = if Op1.isUndef() { Op0 } else { DAG };
        }
        Intermediates.resize(Intermediates.len / 2);
        ZipEC = ZipEC.divideCoefficientBy(2);
    }
    assert!(Intermediates.len == 1);
    let mut Vec: SDValue = DAG.getBitcast(ContainerVT, Intermediates[0]);
    return convertFromScalableVector(DAG, VT, Vec);
}

fn AArch64TargetLowering::LowerBUILD_VECTOR(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut OverrideNEON: bool = !self.Subtarget.isNeonAvailable();
    if !OverrideNEON && self.Subtarget.isSVEorStreamingSVEAvailable() {
        if  {
            if Seq()(-16) && (16) && (-16) && (16) {
                OverrideNEON = true;
            }
        }
    }
    if self.useSVEForFixedLengthVectorVT(VT, OverrideNEON) {
        return self.LowerFixedLengthBuildVectorToSVE(Op, DAG);
    }
    Op = NormalizeBuildVector(Op, DAG);
    if Op.getOpcode() != BUILD_VECTOR {
        return SDValue {};
    }
    let mut BVN: *mut BuildVectorSDNode = cast(Op.getNode());
    if BVN.isConstant() {
        if BVN.getConstantSplatNode(null) {
            Const;
        } else {
            let mut BitSize: u32 = VT.getVectorElementType().getSizeInBits().operator unsigned long long();
            let mut Val: APInt = APInt { BitSize, Const.getAPIntValue().zextOrTrunc(BitSize).getZExtValue(), false, false };
            if Val.isZero() || (VT.isInteger() && Val.isAllOnes()) {
                return Op;
            }
        }
        if BVN.getConstantFPSplatNode(null) {
            Const;
        } else if Const.isZero() && !Const.isNegative() {
            return Op;
        }
    }
    if ConstantBuildVector(Op, DAG, self.Subtarget) {
        V;
    } else {
        return V;
    }
    let mut DL: SDLoc = Op;
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut isOnlyLowElement: bool = true;
    let mut usesOnlyOneValue: bool = true;
    let mut usesOnlyOneConstantValue: bool = true;
    let mut isConstant: bool = true;
    let mut AllLanesExtractElt: bool = true;
    let mut NumConstantLanes: u32 = 0;
    let mut NumDifferentLanes: u32 = 0;
    let mut NumUndefLanes: u32 = 0;
    let mut Value: SDValue = SDValue {};
    let mut ConstantValue: SDValue = SDValue {};
    let mut DifferentValueMap: SmallMapVector<SDValue, unsigned int, 16> = zeroed();
    let mut ConsecutiveValCount: u32 = 0;
    let mut PrevVal: SDValue = SDValue {};
    let mut IsZero: Closure_37 = Closure_37 {};
    let mut MaybeLowHalfZeroHigh: bool = VT.isFixedLengthVector() && VT.getSizeInBits().operator unsigned long long() == 128;
    let mut HalfElts: u32 = if MaybeLowHalfZeroHigh { (NumElts >> 1) } else { 0 };
    let mut LowHalfFirstVal: SDValue = if MaybeLowHalfZeroHigh { Op.getOperand(0) } else { SDValue {} };
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        let mut V: SDValue = Op.getOperand(i);
        if V.getOpcode() != EXTRACT_VECTOR_ELT {
            AllLanesExtractElt = false;
        }
        if V.isUndef() {
            NumUndefLanes += 1;
            MaybeLowHalfZeroHigh = false;
            continue;
        }
        if i > 0 {
            isOnlyLowElement = false;
        }
        if !isIntOrFPConstant(V) {
            isConstant = false;
        }
        if isIntOrFPConstant(V) {
            NumConstantLanes += 1;
            if !ConstantValue.getNode() {
                ConstantValue = V;
            } else if ConstantValue != V {
                usesOnlyOneConstantValue = false;
            }
        }
        if !Value.getNode() {
            Value = V;
        } else if V != Value {
            usesOnlyOneValue = false;
            NumDifferentLanes += 1;
        }
        if PrevVal != V {
            ConsecutiveValCount = 0;
            PrevVal = V;
        }
        if MaybeLowHalfZeroHigh {
            if i < HalfElts {
                if V != LowHalfFirstVal {
                    MaybeLowHalfZeroHigh = false;
                }
            } else if !IsZero.call(V) {
                MaybeLowHalfZeroHigh = false;
            }
        }
        DifferentValueMap()[V] = ConsecutiveValCount += 1;
    }
    if !Value.getNode() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                dbgs() << "LowerBUILD_VECTOR: value undefined, creating undef node\n";
            }
        }
            if !(false) { break; }
        }
        return DAG.getUNDEF(VT);
    }
    if isOnlyLowElement && !isIntOrFPConstant(Value) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                dbgs() << "LowerBUILD_VECTOR: only low element used, creating 1 SCALAR_TO_VECTOR node\n";
            }
        }
            if !(false) { break; }
        }
        return DAG.getNode(SCALAR_TO_VECTOR, DL, VT, Value);
    }
    if MaybeLowHalfZeroHigh && LowHalfFirstVal.getNode() && !LowHalfFirstVal.isUndef() && !isIntOrFPConstant(LowHalfFirstVal) {
        let mut LaneVT: EVT = VT.getVectorElementType();
        let mut HalfVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
        let mut HiZero: SDValue = if LaneVT.isInteger() { DAG.getConstant(0, DL, HalfVT, false, false) } else { DAG.getConstantFP(0.0, DL, HalfVT, false) };
        let mut LoHalf: SDValue = if LaneVT.getSizeInBits().operator unsigned long long() == 64 { DAG.getNode(SCALAR_TO_VECTOR, DL, HalfVT, LowHalfFirstVal) } else { DAG };
        return DAG.getNode(CONCAT_VECTORS, DL, VT, LoHalf, HiZero);
    }
    if AllLanesExtractElt {
        let mut Vector: *mut SDNode = null;
        let mut Even: bool = false;
        let mut Odd: bool = false;
        for let mut i: u32 = 0; i < NumElts; i += 1 {
            let mut V: SDValue = Op.getOperand(i);
            let mut N: *SDNode = V.getNode();
            if !isa(N.getOperand(1)) {
                Even = false;
                Odd = false;
                break;
            }
            let mut N0: SDValue = N.getOperand(0);
            if !Vector {
                Vector = N0.getNode();
                if VT.getVectorElementType() != N0.getValueType().getVectorElementType() {
                    break;
                }
            } else if Vector != N0.getNode() {
                Odd = false;
                Even = false;
                break;
            }
            let mut Val: u64 = N.getConstantOperandVal(1);
            if Val == 2 * i {
                Even = true;
                continue;
            }
            if Val - 1 == 2 * i {
                Odd = true;
                continue;
            }
            Odd = false;
            Even = false;
            break;
        }
        if Even || Odd {
            let mut LHS: SDValue = DAG.getExtractSubvector(DL, VT, SDValue { Node: Vector, ResNo: 0 }, 0);
            let mut RHS: SDValue = DAG.getExtractSubvector(DL, VT, SDValue { Node: Vector, ResNo: 0 }, NumElts);
            if Even && !Odd {
                return DAG;
            }
            if Odd && !Even {
                return DAG;
            }
        }
    }
    if usesOnlyOneValue {
        if !isConstant {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                    dbgs() << "LowerBUILD_VECTOR: use DUP for non-constant splats\n";
                }
            }
                if !(false) { break; }
            }
            if Value.getValueType() == i64 && VT.getScalarSizeInBits() <= 32 {
                Value = DAG.getNode(TRUNCATE, DL, i32, Value);
            }
            return DAG;
        }
        if VT.getVectorElementType().isFloatingPoint() {
            let mut Ops: SmallVector<SDValue, 8> = zeroed();
            let mut EltTy: EVT = VT.getVectorElementType();
            assert!((EltTy == f16 || EltTy == bf16 || EltTy == f32 || EltTy == f64), "Unsupported floating-point vector type");
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                    dbgs() << "LowerBUILD_VECTOR: float constant splats, creating int BITCASTS, and try again\n";
                }
            }
                if !(false) { break; }
            }
            let mut NewType: MVT = getIntegerVT(EltTy.getSizeInBits().operator unsigned long long());
            for let mut i: u32 = 0; i < NumElts; i += 1 {
                Ops()(DAG.getNode(BITCAST, DL, NewType, Op.getOperand(i)));
            }
            let mut VecVT: EVT = getVectorVT(*DAG.getContext(), NewType, NumElts, false);
            let mut Val: SDValue = DAG(VecVT, DL);
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                    dbgs() << "LowerBUILD_VECTOR: trying to lower new vector: ";
                    Val.dump();
                }
            }
                if !(false) { break; }
            }
            Val = self.LowerBUILD_VECTOR(Val, DAG);
            if Val.getNode() {
                return DAG.getNode(BITCAST, DL, VT, Val);
            }
        }
    }
    let mut PreferDUPAndInsert: bool = !isConstant && NumDifferentLanes >= 1 && NumDifferentLanes < ((NumElts - NumUndefLanes) / 2) && NumDifferentLanes >= NumConstantLanes;
    if !PreferDUPAndInsert && NumConstantLanes > 0 && usesOnlyOneConstantValue {
        let mut Val: SDValue = DAG.getSplatBuildVector(VT, DL, ConstantValue);
        let mut BitSize: u32 = VT.getScalarSizeInBits();
        let mut ConstantValueAPInt: APInt = APInt { 1, 0, false, false };
        if  {
            ConstantValueAPInt = ()(BitSize);
        }
        if !isNullConstant(ConstantValue) && !isNullFPConstant(ConstantValue) && !ConstantValueAPInt.isAllOnes() {
            Val = ConstantBuildVector(Val, DAG, self.Subtarget);
            if !Val {
                Val = DAG;
            }
        }
        for let mut i: u32 = 0; i < NumElts; i += 1 {
            let mut V: SDValue = Op.getOperand(i);
            if !isIntOrFPConstant(V) && !V.isUndef() {
                Val = DAG.getInsertVectorElt(DL, Val, V, i);
            }
        }
        return Val;
    }
    if BVN.isConstant() && VT.isFixedLengthVector() && VT.getSizeInBits().operator unsigned long long() == 64 && !DAG.getDataLayout().isBigEndian() {
        let mut DL: SDLoc = Op;
        let mut PackedVal: APInt = APInt { 64, 0, false, false };
        let mut BitPos: u32 = 0;
        let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
        for let mut i: u32 = 0;
let mut e: u32 = BVN.getNumOperands(); i != e; i += 1 {
            let mut LaneOp: *SDValue = BVN.getOperand(i);
            let mut LaneBits: APInt = APInt {};
            if LaneOp.getOpcode() == UNDEF {
                LaneBits = APInt { EltSizeInBits, 0, false, false };
            } else if  {
                LaneBits = ();
            } else if  {
                LaneBits = ()();
            } else {
                return SDValue {};
            }
            operator(PackedVal, LaneBits.trunc(VT.getScalarSizeInBits()).zext(64) << BitPos);
            BitPos += EltSizeInBits;
        }
        let mut Insns: ImmInsnModel, 4> = zeroed();
        expandMOVImm(PackedVal.getZExtValue(), 64);
        if Insns()() > 2 {
            return SDValue {};
        }
        let mut ScalarConst: SDValue = DAG.getConstant(PackedVal, DL, i64, false, false);
        return DAG.getNode(BITCAST, DL, VT, ScalarConst);
    }
    if isConstant {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                dbgs() << "LowerBUILD_VECTOR: all elements are constant, use default expansion\n";
            }
        }
            if !(false) { break; }
        }
        return SDValue {};
    }
    if ReconstructTruncateFromBuildVector(Op, DAG) {
        M;
    } else {
        return M;
    }
    if NumElts >= 4 {
        if self.ReconstructShuffle(Op, DAG) {
            Shuffle;
        } else {
            return Shuffle;
        }
        if ReconstructShuffleWithRuntimeMask(Op, DAG) {
            Shuffle;
        } else {
            return Shuffle;
        }
    }
    if PreferDUPAndInsert {
        let mut Ops: SmallVector<SDValue, 8> = zeroed();
        let mut NewVector: SDValue = self.LowerBUILD_VECTOR(DAG(VT, DL), DAG);
        for let mut I: u32 = 0; I < NumElts; I += 1 {
            if Op.getOperand(I) != Value {
                NewVector = DAG.getInsertVectorElt(DL, NewVector, Op.getOperand(I), I);
            }
        }
        return NewVector;
    }
    if DifferentValueMap()() == 2 && NumUndefLanes == 0 {
        let mut Vals: SmallVector<SDValue, 2> = zeroed();
        let mut canUseVECTOR_CONCAT: bool = true;
        if canUseVECTOR_CONCAT {
            let mut SubVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
            if self.isTypeLegal(SubVT) && SubVT.isVector() && SubVT.getVectorNumElements() >= 2 {
                let mut Ops1: SmallVector<SDValue, 8> = zeroed();
                let mut Ops2: SmallVector<SDValue, 8> = zeroed();
                let mut DUP1: SDValue = self.LowerBUILD_VECTOR(DAG(SubVT, DL), DAG);
                let mut DUP2: SDValue = self.LowerBUILD_VECTOR(DAG(SubVT, DL), DAG);
                let mut CONCAT_VECTORS: SDValue = DAG.getNode(CONCAT_VECTORS, DL, VT, DUP1, DUP2);
                return CONCAT_VECTORS;
            }
        }
        if NumElts >= 8 {
            let mut MaskVec: SmallVector<int, 16> = SmallVector<int, 16> {};
            let mut FirstLaneVal: SDValue = Op.getOperand(0);
            for let mut i: u32 = 0; i < NumElts; i += 1 {
                let mut Val: SDValue = Op.getOperand(i);
                if FirstLaneVal == Val {
                    MaskVec.push(i);
                } else {
                    MaskVec.push(i + NumElts);
                }
            }
            let mut Ops1: SmallVector<SDValue, 8> = zeroed();
            let mut Ops2: SmallVector<SDValue, 8> = zeroed();
            let mut VEC1: SDValue = DAG(VT, DL);
            let mut VEC2: SDValue = DAG(VT, DL);
            let mut VECTOR_SHUFFLE: SDValue = DAG.getVectorShuffle;
            return VECTOR_SHUFFLE;
        }
    }
    if !isConstant && !usesOnlyOneValue {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                dbgs() << "LowerBUILD_VECTOR: alternatives failed, creating sequence of INSERT_VECTOR_ELT\n";
            }
        }
            if !(false) { break; }
        }
        let mut Vec: SDValue = DAG.getPOISON(VT);
        let mut Op0: SDValue = Op.getOperand(0);
        let mut i: u32 = 0;
        if !Op0.isUndef() {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                    dbgs() << "Creating node for op0, it is not undefined:\n";
                }
            }
                if !(false) { break; }
            }
            Vec = DAG.getNode(SCALAR_TO_VECTOR, DL, VT, Op0);
            i += 1;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                {
                    if i < NumElts {
                        dbgs() << "Creating nodes for the other vector elements:\n";
                    }
                }
            }
        }
            if !(false) { break; }
        }
        for ; i < NumElts; i += 1 {
            let mut V: SDValue = Op.getOperand(i);
            if V.isUndef() {
                continue;
            }
            Vec = DAG.getInsertVectorElt(DL, Vec, V, i);
        }
        return Vec;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
            dbgs() << "LowerBUILD_VECTOR: use default expansion, failed to find better alternative\n";
        }
    }
        if !(false) { break; }
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerCONCAT_VECTORS(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if self.useSVEForFixedLengthVectorVT(Op.getValueType(), !self.Subtarget.isNeonAvailable()) {
        return self.LowerFixedLengthConcatVectorsToSVE(Op, DAG);
    }
    assert!(Op.getValueType().isScalableVector() && self.isTypeLegal(Op.getValueType()), "Expected legal scalable vector type!");
    if self.isTypeLegal(Op.getOperand(0).getValueType()) {
        let mut NumOperands: u32 = operator(Op).getNumOperands();
        assert!(NumOperands > 1 && isPowerOf2_32(NumOperands), "Unexpected number of operands in CONCAT_VECTORS");
        if NumOperands == 2 {
            return Op;
        }
        let mut ConcatOps: i32 = operator(Op).ops();
        while ConcatOps()() > 1 {
            for let mut I: u32 = 0;
let mut E: u32 = (); I != E; I += 2 {
                let mut V1: SDValue = [I];
                let mut V2: SDValue = [I + 1];
                let mut SubVT: EVT = V1.getValueType();
                let mut PairVT: EVT = SubVT.getDoubleNumVectorElementsVT(*DAG.getContext());
                ConcatOps()[I / 2] = DAG.getNode(CONCAT_VECTORS, Op, PairVT, V1, V2);
            }
            ConcatOps()(() / 2);
        }
        return [0];
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerINSERT_VECTOR_ELT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op.getOpcode() == INSERT_VECTOR_ELT, "Unknown opcode!");
    if self.useSVEForFixedLengthVectorVT(Op.getValueType(), !self.Subtarget.isNeonAvailable()) {
        return self.LowerFixedLengthInsertVectorElt(Op, DAG);
    }
    let mut VT: EVT = Op.getValueType();
    let mut Vec: SDValue = Op.getOperand(0);
    let mut Elt: SDValue = Op.getOperand(1);
    let mut Idx: SDValue = Op.getOperand(2);
    if VT.getScalarType() == i1 {
        let mut DL: SDLoc = Op;
        if VT == nxv1i1 {
            let mut WidenVec: SDValue = DAG.getInsertSubvector(DL, DAG.getPOISON(nxv2i1), Vec, 0);
            let mut Insert: SDValue = DAG.getNode(INSERT_VECTOR_ELT, DL, nxv2i1, WidenVec, Elt, Idx);
            return DAG.getExtractSubvector(DL, nxv1i1, Insert, 0);
        }
        let mut PromoteVT: EVT = self.getPromotedVTForPredicate(VT);
        let mut PromoteVec: SDValue = DAG.getNode(ANY_EXTEND, DL, PromoteVT, Vec);
        if PromoteVT.getVectorElementType() == i64 {
            Elt = DAG.getNode(ANY_EXTEND, DL, i64, Elt);
        }
        let mut Insert: SDValue = DAG.getNode(INSERT_VECTOR_ELT, DL, PromoteVT, PromoteVec, Elt, Idx);
        return DAG.getNode(TRUNCATE, DL, VT, Insert);
    }
    let mut CI: *mut ConstantSDNode = dyn_cast(Idx);
    if !CI || CI.getZExtValue() >= VT.getVectorNumElements() {
        return SDValue {};
    }
    return Op;
}

fn AArch64TargetLowering::LowerEXTRACT_VECTOR_ELT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op.getOpcode() == EXTRACT_VECTOR_ELT, "Unknown opcode!");
    let mut VT: EVT = Op.getOperand(0).getValueType();
    if VT.getScalarType() == i1 {
        let mut DL: SDLoc = Op;
        if VT == nxv1i1 {
            let mut WidenedPred: SDValue = DAG.getInsertSubvector(DL, DAG.getPOISON(nxv2i1), operator(Op).getOperand(0), 0);
            return DAG.getNode(EXTRACT_VECTOR_ELT, DL, Op.getValueType(), WidenedPred, Op.getOperand(1));
        }
        let mut VectorVT: EVT = self.getPromotedVTForPredicate(VT);
        let mut Extend: SDValue = DAG.getNode(ANY_EXTEND, DL, VectorVT, Op.getOperand(0));
        let mut ExtractTy: MVT = if VectorVT == nxv2i64 { i64 } else { i32 };
        let mut Extract: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, ExtractTy, Extend, Op.getOperand(1));
        return DAG.getAnyExtOrTrunc(Extract, DL, Op.getValueType());
    }
    if self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()) {
        return self.LowerFixedLengthExtractVectorElt(Op, DAG);
    }
    let mut CI: *mut ConstantSDNode = dyn_cast(Op.getOperand(1));
    if !CI || CI.getZExtValue() >= VT.getVectorNumElements() {
        return SDValue {};
    }
    if VT == v16i8 || VT == v8i16 || VT == v4i32 || VT == v2i64 || VT == v4f32 || VT == v2f64 || VT == v8f16 || VT == v8bf16 {
        return Op;
    }
    if VT != v8i8 && VT != v4i16 && VT != v2i32 && VT != v1i64 && VT != v2f32 && VT != v4f16 && VT != v4bf16 {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut WideVec: SDValue = WidenVector(Op.getOperand(0), DAG);
    let mut WideTy: EVT = WideVec.getValueType();
    let mut ExtrTy: EVT = WideTy.getVectorElementType();
    if ExtrTy == i16 || ExtrTy == i8 {
        ExtrTy = i32;
    }
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, ExtrTy, WideVec, Op.getOperand(1));
}

fn AArch64TargetLowering::LowerEXTRACT_SUBVECTOR(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFixedLengthVector(), "Only cases that extract a fixed length vector are supported!");
    let mut InVT: EVT = Op.getOperand(0).getValueType();
    if !self.isTypeLegal(InVT) {
        return SDValue {};
    }
    if InVT.is128BitVector() {
        assert!(VT.is64BitVector(), "Extracting unexpected vector type!");
        let mut Idx: u32 = Op.getConstantOperandVal(1);
        if Idx == 0 {
            return Op;
        }
        if Idx * InVT.getScalarSizeInBits() == 64 && self.Subtarget.isNeonAvailable() {
            return Op;
        }
    }
    if InVT.isScalableVector() || self.useSVEForFixedLengthVectorVT(InVT, !self.Subtarget.isNeonAvailable()) {
        let mut DL: SDLoc = Op;
        let mut Vec: SDValue = Op.getOperand(0);
        let mut Idx: SDValue = Op.getOperand(1);
        let mut PackedVT: EVT = getPackedSVEVectorVT(InVT.getVectorElementType());
        if PackedVT != InVT {
            let mut Container: SDValue = DAG.getInsertSubvector(DL, DAG.getPOISON(PackedVT), Vec, 0);
            return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Container, Idx);
        }
        if isNullConstant(Idx) {
            return Op;
        }
        assert!(InVT.isScalableVector(), "Unexpected vector type!");
        let mut Splice: SDValue = DAG.getNode(VECTOR_SPLICE_LEFT, DL, InVT, Vec, Vec, Idx);
        return convertFromScalableVector(DAG, VT, Splice);
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerVECTOR_REPEAT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Src: SDValue = Op.getOperand(0);
    let mut VT: EVT = Op.getValueType();
    assert!(Src.getValueType().is64BitVector(), "Expected 64bit source!");
    let mut SrcAsScalar: SDValue = DAG.getExtractVectorElt(DL, i64, DAG.getBitcast(v1i64, Src), 0);
    let mut Splat: SDValue = DAG.getSplat(nxv2i64, DL, SrcAsScalar);
    let mut PackedVT: EVT = VT.getDoubleNumVectorElementsVT(*DAG.getContext());
    return DAG.getExtractSubvector(DL, VT, DAG.getBitcast(PackedVT, Splat), 0);
}

fn AArch64TargetLowering::LowerINSERT_SUBVECTOR(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op.getValueType().isScalableVector(), "Only expect to lower inserts into scalable vectors!");
    let mut InVT: EVT = Op.getOperand(1).getValueType();
    let mut Idx: u32 = Op.getConstantOperandVal(2);
    let mut Vec0: SDValue = Op.getOperand(0);
    let mut Vec1: SDValue = Op.getOperand(1);
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    if InVT.isScalableVector() {
        if !self.isTypeLegal(VT) {
            return SDValue {};
        }
        if VT.getVectorElementType() == i1 {
            let mut NumElts: u32 = VT.getVectorMinNumElements();
            let mut HalfVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            Lo = DAG.getExtractSubvector(DL, HalfVT, Vec0, 0);
            Hi = DAG.getExtractSubvector(DL, HalfVT, Vec0, NumElts / 2);
            if Idx < (NumElts / 2) {
                Lo = DAG.getInsertSubvector(DL, Lo, Vec1, Idx);
            } else {
                Hi = DAG.getInsertSubvector(DL, Hi, Vec1, Idx - (NumElts / 2));
            }
            return DAG.getNode(CONCAT_VECTORS, DL, VT, Lo, Hi);
        }
        if self.isTypeLegal(InVT) && Vec0.isUndef() {
            return Op;
        }
        if VT.getVectorElementCount() != (InVT.getVectorElementCount() * 2) {
            return SDValue {};
        }
        let mut NarrowVT: EVT = getPackedSVEVectorVT(VT.getVectorElementCount());
        let mut WideVT: EVT = getPackedSVEVectorVT(InVT.getVectorElementCount());
        if VT.isFloatingPoint() {
            Vec0 = self.getSVESafeBitCast(NarrowVT, Vec0, DAG);
            Vec1 = self.getSVESafeBitCast(NarrowVT, Vec1, DAG);
        } else {
            Vec1 = DAG.getNode(ANY_EXTEND, DL, WideVT, Vec1);
            Vec1 = DAG;
        }
        let mut Narrow: SDValue = SDValue {};
        if Idx == 0 {
            let mut HiVec0: SDValue = DAG;
            HiVec0 = DAG;
            Narrow = DAG;
        } else {
            assert!(Idx == InVT.getVectorMinNumElements(), "Invalid subvector index!");
            let mut LoVec0: SDValue = DAG;
            LoVec0 = DAG;
            Narrow = DAG;
        }
        return self.getSVESafeBitCast(VT, Narrow, DAG);
    }
    if Idx == 0 && isPackedVectorType(VT, DAG) {
        if Vec0.isUndef() {
            return Op;
        }
        let mut PredPattern: optional<unsigned int> = getSVEPredPatternFromNumElements(InVT.getVectorNumElements());
        let mut PredTy: EVT = VT.changeVectorElementType(*DAG.getContext(), i1);
        let mut PTrue: SDValue = getPTrue(DAG, DL, PredTy, operator(PredPattern));
        let mut ScalableVec1: SDValue = convertToScalableVector(DAG, VT, Vec1);
        return DAG.getNode(VSELECT, DL, VT, PTrue, ScalableVec1, Vec0);
    }
    return SDValue {};
}

fn isPow2Splat(Op: SDValue, SplatVal: *mut u64, Negated: *mut bool) -> bool {
    if  {
        return false;
    }
    if Op.getOpcode() == BUILD_VECTOR && !isAllConstantBuildVector(Op, SplatVal) {
        return false;
    }
    if Op.getOpcode() != BUILD_VECTOR && !isa(operator(Op).getOperand(0)) {
        return false;
    }
    SplatVal = operator(Op).getConstantOperandVal(0);
    if Op.getValueType().getVectorElementType() != i64 {
        SplatVal = SplatVal as i32;
    }
    Negated = false;
    if isPowerOf2_64(SplatVal) {
        return true;
    }
    Negated = true;
    if isPowerOf2_64(-SplatVal) {
        SplatVal = -SplatVal;
        return true;
    }
    return false;
}

fn AArch64TargetLowering::LowerDIV(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    if VT.isFixedLengthVector() && self.Subtarget.isSVEorStreamingSVEAvailable() {
        return self.LowerFixedLengthVectorIntDivideToSVE(Op, DAG);
    }
    let mut Opc: u32 = Op.getOpcode();
    assert!((Opc == SDIV || Opc == UDIV), "Expected a DIV opcode.");
    assert!(VT.isScalableVector(), "Expected a scalable vector.");
    let mut Signed: bool = Opc == SDIV;
    let mut Negated: bool = false;
    let mut SplatVal: u64 = 0;
    if Signed && isPow2Splat(Op.getOperand(1), SplatVal, Negated) && SplatVal > 1 {
        let mut Pg: SDValue = getPredicateForScalableVector(DAG, DL, VT);
        let mut Res: SDValue = DAG;
        if Negated {
            Res = DAG.getNode(SUB, DL, VT, DAG.getConstant(0, DL, VT, false, false), Res);
        }
        return Res;
    }
    if VT == nxv4i32 || VT == nxv2i64 {
        let mut MaskedOpcode: u32 = if Signed { MASKED_SDIV } else { MASKED_UDIV };
        return DAG.getNode(MaskedOpcode, DL, VT, Op.getOperand(0), Op.getOperand(1), getPredicateForVector(DAG, DL, VT));
    }
    let mut WidenedVT: EVT = EVT {};
    if VT == nxv16i8 {
        WidenedVT = nxv8i16;
    } else if VT == nxv8i16 {
        WidenedVT = nxv4i32;
    } else {
        llvm_unreachable_internal("Unexpected Custom DIV operation", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 18021);
    }
    let mut UnpkLo: u32 = 0;
    let mut UnpkHi: u32 = 0;
    let mut Op0Lo: SDValue = DAG.getNode(UnpkLo, DL, WidenedVT, Op.getOperand(0));
    let mut Op1Lo: SDValue = DAG.getNode(UnpkLo, DL, WidenedVT, Op.getOperand(1));
    let mut Op0Hi: SDValue = DAG.getNode(UnpkHi, DL, WidenedVT, Op.getOperand(0));
    let mut Op1Hi: SDValue = DAG.getNode(UnpkHi, DL, WidenedVT, Op.getOperand(1));
    let mut ResultLo: SDValue = DAG.getNode(Opc, DL, WidenedVT, Op0Lo, Op1Lo);
    let mut ResultHi: SDValue = DAG.getNode(Opc, DL, WidenedVT, Op0Hi, Op1Hi);
    let mut ResultLoCast: SDValue = DAG;
    let mut ResultHiCast: SDValue = DAG;
    return DAG;
}

fn AArch64TargetLowering::shouldExpandBuildVectorWithShuffles(self: *AArch64TargetLowering, VT: EVT, DefinedValues: u32) -> bool {
    if !self.Subtarget.isNeonAvailable() {
        return false;
    }
    return self.shouldExpandBuildVectorWithShuffles(VT, DefinedValues);
}

fn AArch64TargetLowering::isShuffleMaskLegal(self: *AArch64TargetLowering, M: ArrayRef<int>, VT: EVT) -> bool {
    if self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()) {
        return false;
    }
    if VT.getVectorNumElements() == 4 && (VT.is128BitVector() || VT.is64BitVector()) {
        let mut Cost: u32 = getPerfectShuffleCost(M);
        if Cost <= 1 {
            return true;
        }
    }
    let mut DummyBool: bool = false;
    let mut DummyInt: i32 = 0;
    let mut DummyUnsigned: u32 = 0;
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    let mut NumElts: u32 = VT.getVectorNumElements();
    return (isSplatMask(M) || isREVMask(M, EltSize, NumElts, 64) || isREVMask(M, EltSize, NumElts, 32) || isREVMask(M, EltSize, NumElts, 16) || isEXTMask(M, VT, DummyBool, DummyUnsigned) || isSingletonEXTMask(M, VT, DummyUnsigned) || isTRNMask(M, NumElts, DummyUnsigned, DummyUnsigned) || isUZPMask(M, NumElts, DummyUnsigned) || isZIPMask(M, NumElts, DummyUnsigned, DummyUnsigned) || isTRN_v_undef_Mask(M, NumElts, DummyUnsigned) || isUZP_v_undef_Mask(M, NumElts, DummyUnsigned) || isZIP_v_undef_Mask(M, NumElts, DummyUnsigned) || isINSMask(M, NumElts, DummyBool, DummyInt) || isConcatMask(M, VT, VT.getSizeInBits().operator unsigned long long() == 128));
}

fn AArch64TargetLowering::isVectorClearMaskLegal(self: *AArch64TargetLowering, M: ArrayRef<int>, VT: EVT) -> bool {
    return self.isShuffleMaskLegal(M, VT);
}

fn getVShiftImm(Op: SDValue, ElementBits: u32, Cnt: *mut i64) -> bool {
    while Op.getOpcode() == BITCAST {
        Op = Op.getOperand(0);
    }
    let mut BVN: *mut BuildVectorSDNode = dyn_cast(Op.getNode());
    let mut SplatBits: APInt = APInt {};
    let mut SplatUndef: APInt = APInt {};
    let mut SplatBitSize: u32 = 0;
    let mut HasAnyUndefs: bool = false;
    if !BVN || !BVN.isConstantSplat(SplatBits, SplatUndef, SplatBitSize, HasAnyUndefs, ElementBits, false) || SplatBitSize > ElementBits {
        return false;
    }
    Cnt = SplatBits.getSExtValue();
    return true;
}

fn isVShiftLImm(Op: SDValue, VT: EVT, isLong: bool, Cnt: *mut i64) -> bool {
    assert!(VT.isVector(), "vector shift count is not a vector type");
    let mut ElementBits: i64 = VT.getScalarSizeInBits();
    if !getVShiftImm(Op, ElementBits, Cnt) {
        return false;
    }
    return (Cnt >= 0 && (if isLong { Cnt - 1 } else { Cnt }) < ElementBits);
}

fn isVShiftRImm(Op: SDValue, VT: EVT, isNarrow: bool, Cnt: *mut i64) -> bool {
    assert!(VT.isVector(), "vector shift count is not a vector type");
    let mut ElementBits: i64 = VT.getScalarSizeInBits();
    if !getVShiftImm(Op, ElementBits, Cnt) {
        return false;
    }
    return (Cnt >= 1 && Cnt <= (if isNarrow { ElementBits / 2 } else { ElementBits }));
}

fn AArch64TargetLowering::LowerTRUNCATE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    if VT.getScalarType() == i1 {
        let mut DL: SDLoc = Op;
        let mut OpVT: EVT = Op.getOperand(0).getValueType();
        let mut Zero: SDValue = DAG.getConstant(0, DL, OpVT, false, false);
        let mut One: SDValue = DAG.getConstant(1, DL, OpVT, false, false);
        let mut And: SDValue = DAG.getNode(AND, DL, OpVT, Op.getOperand(0), One);
        return DAG.getSetCC(DL, VT, And, Zero, SETNE, SDValue {}, false, None);
    }
    if !VT.isVector() || VT.isScalableVector() {
        return SDValue {};
    }
    if self.useSVEForFixedLengthVectorVT(Op.getOperand(0).getValueType(), !self.Subtarget.isNeonAvailable()) {
        return self.LowerFixedLengthVectorTruncateToSVE(Op, DAG);
    }
    if VT.is64BitVector() && Op.getOperand(0).getValueType().is128BitVector() {
        return Op;
    }
    return SDValue {};
}

fn canLowerSRLToRoundingShiftForVT(Shift: SDValue, ResVT: EVT, DAG: *mut SelectionDAG, ShiftValue: *mut u32, RShOperand: *mut SDValue) -> bool {
    if operator(Shift).getOpcode() != SRL {
        return false;
    }
    let mut VT: EVT = Shift.getValueType();
    assert!(VT.isScalableVT();
    let mut ShiftOp1: auto = dyn_cast_or_null(DAG.getSplatValue(operator(Shift).getOperand(1), false));
    if operator!() {
        return false;
    }
    ShiftValue = ();
    if ShiftValue < 1 || ShiftValue > ResVT.getScalarSizeInBits() {
        return false;
    }
    let mut Add: SDValue = operator(Shift).getOperand(0);
    if operator(Add).getOpcode() != ADD || !operator(Add).hasOneUse() {
        return false;
    }
    assert!(ResVT.getScalarSizeInBits() <= VT.getScalarSizeInBits(), "ResVT must be truncated or same type as the shift.");
    let mut ExtraBits: u64 = VT.getScalarSizeInBits() - ResVT.getScalarSizeInBits();
    if ShiftValue > ExtraBits && !operator(Add).getFlags().hasNoUnsignedWrap() {
        return false;
    }
    let mut AddOp1: auto = dyn_cast_or_null(DAG.getSplatValue(operator(Add).getOperand(1), false));
    if operator!() {
        return false;
    }
    let mut AddValue: u64 = ();
    if AddValue != 1 << (ShiftValue - 1) {
        return false;
    }
    RShOperand = operator(Add).getOperand(0);
    return true;
}

fn AArch64TargetLowering::LowerVectorSRA_SRL_SHL(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut Cnt: i64 = 0;
    if !Op.getOperand(1).getValueType().isVector() {
        return Op;
    }
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    match Op.getOpcode() {
        SHL => {
            if VT.isScalableVector() || self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()) {
                return self.LowerToPredicatedOp;
            }
        },
        SRA => {
            SRL;
        },
    }
    llvm_unreachable_internal("unexpected shift opcode", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 18265);
}

fn AArch64TargetLowering::LowerVSETCC(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if Op.getValueType().isScalableVector() {
        return self.LowerToPredicatedOp;
    }
    if self.useSVEForFixedLengthVectorVT(Op.getOperand(0).getValueType(), !self.Subtarget.isNeonAvailable()) {
        return self.LowerFixedLengthVectorSetccToSVE(Op, DAG);
    }
    let mut CC: CondCode = cast(Op.getOperand(2))();
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    let mut CmpVT: EVT = LHS.getValueType().changeVectorElementTypeToInteger();
    let mut DL: SDLoc = Op;
    if LHS.getValueType().getVectorElementType().isInteger() {
        return Op;
    }
    (((operator!(operator!((((operator!(self.Subtarget()) && LHS.getValueType().getVectorElementType() != f16) || LHS.getValueType().getVectorElementType() != bf16 || LHS.getValueType().getVectorElementType() != f128) && "Unexpected type!")))) || (_wassert(L"((!Subtarget->hasFullFP16() && LHS.getValueType().getVectorElementType() != MVT::f16) || LHS.getValueType().getVectorElementType() != MVT::bf16 || LHS.getValueType().getVectorElementType() != MVT::f128) && \"Unexpected type!\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (18290) as u32) , 0)) as void);
    if CC == SETUO || CC == SETO {
        let mut OneNaN: bool = false;
        if LHS == RHS {
            OneNaN = true;
        } else if DAG.isKnownNeverNaN(RHS, false, 0) {
            OneNaN = true;
            RHS = LHS;
        } else if DAG.isKnownNeverNaN(LHS, false, 0) {
            OneNaN = true;
            LHS = RHS;
        }
        if OneNaN {
            CC = if CC == SETUO { SETUNE } else { SETOEQ };
        }
    }
    let mut CC1: CondCode = zeroed();
    let mut CC2: CondCode = zeroed();
    let mut ShouldInvert: bool = false;
    changeVectorFPCCToAArch64CC(CC, CC1, CC2, ShouldInvert);
    let mut NoNaNs: bool = operator(Op).getFlags().hasNoNaNs();
    let mut Cmp: SDValue = emitVectorComparison(LHS, RHS, CC1, NoNaNs, CmpVT, DL, DAG);
    if !Cmp.getNode() {
        return SDValue {};
    }
    if CC2 != AL {
        let mut Cmp2: SDValue = emitVectorComparison(LHS, RHS, CC2, NoNaNs, CmpVT, DL, DAG);
        if !Cmp2.getNode() {
            return SDValue {};
        }
        Cmp = DAG.getNode(OR, DL, CmpVT, Cmp, Cmp2);
    }
    Cmp = DAG.getSExtOrTrunc(Cmp, DL, Op.getValueType());
    if ShouldInvert {
        Cmp = DAG.getNOT(DL, Cmp, Cmp.getValueType());
    }
    return Cmp;
}

fn getReductionSDNode(Op: u32, DL: SDLoc, ScalarOp: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VecOp: SDValue = ScalarOp.getOperand(0);
    let mut Rdx: SDValue = DAG.getNode(Op, DL, VecOp.getSimpleValueType(), VecOp);
    return DAG.getExtractVectorElt(DL, ScalarOp.getValueType(), Rdx, 0);
}

fn getVectorBitwiseReduce(Opcode: u32, Vec: SDValue, VT: EVT, DL: SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut ScalarOpcode: u32 = 0;
    match Opcode {
        VECREDUCE_AND => {
            ScalarOpcode = AND;
        },
        VECREDUCE_OR => {
            ScalarOpcode = OR;
        },
        VECREDUCE_XOR => {
            ScalarOpcode = XOR;
        },
        _ => {
            llvm_unreachable_internal("Expected bitwise vector reduction", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 18358);
        },
    }
    let mut VecVT: EVT = Vec.getValueType();
    assert!(VecVT.isFixedLengthVector() && VecVT.isPow2VectorType(), "Expected power-of-2 length vector");
    let mut ElemVT: EVT = VecVT.getVectorElementType();
    let mut Result: SDValue = SDValue {};
    let mut NumElems: u32 = VecVT.getVectorNumElements();
    if ElemVT == i1 {
        if NumElems > 16 {
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = DAG.SplitVector(Vec, DL);
            let mut HalfVT: EVT = Lo.getValueType();
            let mut HalfVec: SDValue = DAG.getNode(ScalarOpcode, DL, HalfVT, Lo, Hi);
            return getVectorBitwiseReduce(Opcode, HalfVec, VT, DL, DAG);
        }
        let mut ExtendedWidth: u32 = 64;
        if Vec.getOpcode() == SETCC && Vec.getOperand(0).getValueSizeInBits().operator unsigned long long() >= 128 {
            ExtendedWidth = 128;
        }
        let mut ExtendedVT: EVT = getIntegerVT(max(ExtendedWidth / NumElems, 8));
        let mut ExtendOp: u32 = if ScalarOpcode == XOR { ANY_EXTEND } else { SIGN_EXTEND };
        let mut Extended: SDValue = DAG.getNode(ExtendOp, DL, VecVT.changeVectorElementType(*DAG.getContext(), ExtendedVT), Vec);
        if (ScalarOpcode == AND || ScalarOpcode == OR) && NumElems == 2 && ExtendedWidth == 128 {
            Extended = DAG.getBitcast(v4i32, Extended);
            ExtendedVT = i32;
        }
        match ScalarOpcode {
            AND => {
                Result = DAG.getNode(VECREDUCE_UMIN, DL, ExtendedVT, Extended);
            },
            OR => {
                Result = DAG.getNode(VECREDUCE_UMAX, DL, ExtendedVT, Extended);
            },
            XOR => {
                Result = DAG.getNode(VECREDUCE_ADD, DL, ExtendedVT, Extended);
            },
            _ => {
                llvm_unreachable_internal("Unexpected Opcode", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 18420);
            },
        }
        Result = DAG.getAnyExtOrTrunc(Result, DL, i1);
    } else {
        while VecVT.getSizeInBits().operator unsigned long long() > 64 {
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = DAG.SplitVector(Vec, DL);
            VecVT = Lo.getValueType();
            NumElems = VecVT.getVectorNumElements();
            Vec = DAG.getNode(ScalarOpcode, DL, VecVT, Lo, Hi);
        }
        let mut ScalarVT: EVT = getIntegerVT(*DAG.getContext(), VecVT.getSizeInBits().operator unsigned long long());
        let mut Scalar: SDValue = DAG.getBitcast(ScalarVT, Vec);
        for let mut Shift: u32 = NumElems / 2; Shift > 0; Shift /= 2 {
            let mut ShiftAmount: SDValue = DAG.getConstant(Shift * ElemVT.getSizeInBits().operator unsigned long long(), DL, i64, false, false);
            let mut Shifted: SDValue = DAG.getNode(SRL, DL, ScalarVT, Scalar, ShiftAmount);
            Scalar = DAG.getNode(ScalarOpcode, DL, ScalarVT, Scalar, Shifted);
        }
        Result = DAG.getAnyExtOrTrunc(Scalar, DL, ElemVT);
    }
    return DAG.getAnyExtOrTrunc(Result, DL, VT);
}

fn AArch64TargetLowering::LowerVECREDUCE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Src: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    if self.Subtarget() && Op.getOpcode() == VECREDUCE_FADD && SrcVT == v2f16 {
        return DAG.getNode(FADD, DL, f16, DAG.getExtractVectorElt(DL, f16, Src, 0), DAG.getExtractVectorElt(DL, f16, Src, 1));
    }
    if self.LowerReductionToSVE(Op, DAG) {
        Result;
    } else {
        return Result;
    }
    match Op.getOpcode() {
        VECREDUCE_AND => {
            VECREDUCE_OR;
        },
        VECREDUCE_ADD => {
            return getReductionSDNode(DL, Op, DAG);
        },
        VECREDUCE_SMAX => {
            return getReductionSDNode(DL, Op, DAG);
        },
        VECREDUCE_SMIN => {
            return getReductionSDNode(DL, Op, DAG);
        },
        VECREDUCE_UMAX => {
            return getReductionSDNode(DL, Op, DAG);
        },
        VECREDUCE_UMIN => {
            return getReductionSDNode(DL, Op, DAG);
        },
        _ => {
            llvm_unreachable_internal("Unhandled reduction", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 18498);
        },
    }
}

fn AArch64TargetLowering::LowerVECREDUCE_MUL(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Src: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    assert!(SrcVT.isScalableVector(), "Unexpected operand type!");
    let mut SrcVTs: SDVTList = DAG.getVTList(SrcVT, SrcVT);
    let mut BaseOpc: u32 = getVecReduceBaseOpcode(Op.getOpcode());
    let mut Identity: SDValue = DAG.getIdentityElement(BaseOpc, DL, SrcVT, operator(Op).getFlags());
    let mut Segments: u32 = SVEMaxBitsPerVector / SVEBitsPerBlock;
    let mut Stages: u32 = Log2_32(Segments * SrcVT.getVectorMinNumElements());
    for let mut I: u32 = 0; I < Stages; I += 1 {
        Src = DAG.getNode(VECTOR_DEINTERLEAVE, DL, SrcVTs, Src, Identity);
        Src = DAG.getNode(BaseOpc, DL, SrcVT, Src.getValue(0), Src.getValue(1));
    }
    return DAG.getExtractVectorElt(DL, Op.getValueType(), Src, 0);
}

fn AArch64TargetLowering::LowerATOMIC_LOAD_AND(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Subtarget: *mut auto = DAG;
    if operator!() && operator!() {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut VT: MVT = Op.getSimpleValueType();
    assert!(VT != i128, "Handled elsewhere, code replicated.");
    let mut RHS: SDValue = Op.getOperand(2);
    let mut AN: *mut AtomicSDNode = cast(Op.getNode());
    RHS = DAG.getNode(XOR, DL, VT, DAG.getAllOnesConstant(DL, VT, false, false), RHS);
    return DAG.getAtomic(ATOMIC_LOAD_CLR, DL, AN.getMemoryVT(), Op.getOperand(0), Op.getOperand(1), RHS, AN.getMemOperand());
}

fn AArch64TargetLowering::LowerWindowsDYNAMIC_STACKALLOC(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Node: *mut SDNode = Op.getNode();
    let mut Chain: SDValue = Op.getOperand(0);
    let mut Size: SDValue = Op.getOperand(1);
    let mut Align: MaybeAlign = cast(Op.getOperand(2))();
    let mut VT: EVT = Node.getValueType(0);
    if DAG.getMachineFunction().getFunction().hasFnAttribute("no-stack-arg-probe") {
        let mut SP: SDValue = DAG;
        Chain = SP.getValue(1);
        SP = DAG.getNode(SUB, DL, i64, SP, Size);
        if Align {
            SP = DAG.getNode(AND, DL, VT, SP.getValue(0), DAG.getSignedConstant(-operator(Align).value(), DL, VT, false, false));
        }
        Chain = DAG;
        let mut Ops: [2]SDValue = [SP, Chain];
        return DAG.getMergeValues;
    }
    let mut ChkStkImpl: LibcallImpl = self.getLibcallImpl(STACK_PROBE);
    if ChkStkImpl == Unsupported {
        return SDValue {};
    }
    Chain = DAG.getCALLSEQ_START(Chain, 0, 0, DL);
    let mut PtrVT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut Callee: SDValue = DAG.getTargetExternalSymbol(getLibcallImplName(ChkStkImpl).ptr, PtrVT, 0);
    let mut TRI: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut Mask: *u32 = TRI.getWindowsStackProbePreservedMask();
    if self.Subtarget.hasCustomCallingConv() {
        TRI.UpdateCustomCallPreservedMask(DAG.getMachineFunction(), &mut Mask);
    }
    Size = DAG.getNode(SRL, DL, i64, Size, DAG.getConstant(4, DL, i64, false, false));
    Chain = DAG;
    Chain = DAG;
    Size = DAG.getNode(SHL, DL, i64, Size, DAG.getConstant(4, DL, i64, false, false));
    let mut SP: SDValue = DAG;
    Chain = SP.getValue(1);
    SP = DAG.getNode(SUB, DL, i64, SP, Size);
    if Align {
        SP = DAG.getNode(AND, DL, VT, SP.getValue(0), DAG.getSignedConstant(-operator(Align).value(), DL, VT, false, false));
    }
    Chain = DAG;
    Chain = DAG.getCALLSEQ_END(Chain, 0, 0, SDValue {}, DL);
    let mut Ops: [2]SDValue = [SP, Chain];
    return DAG.getMergeValues;
}

fn AArch64TargetLowering::LowerInlineDYNAMIC_STACKALLOC(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Node: *mut SDNode = Op.getNode();
    let mut Chain: SDValue = Op.getOperand(0);
    let mut Size: SDValue = Op.getOperand(1);
    let mut Align: MaybeAlign = cast(Op.getOperand(2))();
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Node.getValueType(0);
    let mut SP: SDValue = DAG;
    Chain = SP.getValue(1);
    SP = DAG.getNode(SUB, DL, i64, SP, Size);
    if Align {
        SP = DAG.getNode(AND, DL, VT, SP.getValue(0), DAG.getSignedConstant(-operator(Align).value(), DL, VT, false, false));
    }
    Chain = DAG;
    let mut Ops: [2]SDValue = [SP, Chain];
    return DAG.getMergeValues;
}

fn AArch64TargetLowering::LowerDYNAMIC_STACKALLOC(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    if self.Subtarget.isTargetWindows() {
        return self.LowerWindowsDYNAMIC_STACKALLOC(Op, DAG);
    } else if self.hasInlineStackProbe(MF) {
        return self.LowerInlineDYNAMIC_STACKALLOC(Op, DAG);
    } else {
        return SDValue {};
    }
}

fn AArch64TargetLowering::LowerAVG(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, NewOp: u32) -> SDValue {
    if self.Subtarget() {
        return self.LowerToPredicatedOp(Op, DAG, NewOp);
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerVSCALE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT != i64, "Expected illegal VSCALE node");
    let mut DL: SDLoc = Op;
    let mut MulImm: APInt = Op.getConstantOperandAPInt(0);
    return DAG.getZExtOrTrunc(DAG.getVScale(DL, i64, MulImm.sext(64)), DL, VT);
}

