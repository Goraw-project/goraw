    match Op {
        VECREDUCE_SMIN => {
            
        },
        VECREDUCE_SMAX => {
            
        },
        VECREDUCE_UMIN => {
            
        },
        VECREDUCE_UMAX => {
            
        },
        _ => {
            return nullopt;
        },
    }
}

