fn AArch64TargetLowering::getRegisterTypeForCallingConv(self: *AArch64TargetLowering, Context: *mut LLVMContext, CC: ID, VT: EVT) -> MVT {
    let mut NonUnitFixedLengthVector: bool = VT.isFixedLengthVector() && !VT.getVectorElementCount().isScalar();
    if !NonUnitFixedLengthVector || !self.Subtarget.useSVEForFixedLengthVectors() {
        return self.getRegisterTypeForCallingConv(Context, CC, VT);
    }
    let mut VT1: EVT = EVT {};
    let mut RegisterVT: MVT = MVT {};
    let mut NumIntermediates: u32 = 0;
    self.getVectorTypeBreakdownForCallingConv(Context, CC, VT, VT1, NumIntermediates, RegisterVT);
    return RegisterVT;
}

fn AArch64TargetLowering::getNumRegistersForCallingConv(self: *AArch64TargetLowering, Context: *mut LLVMContext, CC: ID, VT: EVT) -> u32 {
    let mut NonUnitFixedLengthVector: bool = VT.isFixedLengthVector() && !VT.getVectorElementCount().isScalar();
    if !NonUnitFixedLengthVector || !self.Subtarget.useSVEForFixedLengthVectors() {
        return self.getNumRegistersForCallingConv(Context, CC, VT);
    }
    let mut VT1: EVT = EVT {};
    let mut VT2: MVT = MVT {};
    let mut NumIntermediates: u32 = 0;
    return self.getVectorTypeBreakdownForCallingConv(Context, CC, VT, VT1, NumIntermediates, VT2);
}

fn AArch64TargetLowering::getVectorTypeBreakdownForCallingConv(self: *AArch64TargetLowering, Context: *mut LLVMContext, CC: ID, VT: EVT, IntermediateVT: *mut EVT, NumIntermediates: *mut u32, RegisterVT: *mut MVT) -> u32 {
    let mut NumRegs: i32 = self.getVectorTypeBreakdownForCallingConv(Context, CC, VT, IntermediateVT, NumIntermediates, RegisterVT);
    if !RegisterVT.isFixedLengthVector() || RegisterVT.getFixedSizeInBits() <= 128 {
        return NumRegs;
    }
    assert!(self.Subtarget.useSVEForFixedLengthVectors(), "Unexpected mode!");
    assert!(IntermediateVT == RegisterVT, "Unexpected VT mismatch!");
    assert!(RegisterVT.getFixedSizeInBits() % 128 == 0, "Unexpected size!");
    if RegisterVT.getSizeInBits() * NumRegs != VT.getSizeInBits() {
        let mut EltTy: EVT = VT.getVectorElementType();
        let mut NewVT: EVT = getVectorVT(Context, EltTy, getFixed(1));
        if !self.isTypeLegal(NewVT) {
            NewVT = EltTy;
        }
        IntermediateVT = NewVT;
        NumIntermediates = VT.getVectorNumElements();
        RegisterVT = self.getRegisterType(Context, NewVT);
        return NumIntermediates;
    }
    let mut NumSubRegs: u32 = RegisterVT.getFixedSizeInBits() / 128;
    NumIntermediates *= NumSubRegs;
    NumRegs *= NumSubRegs;
    match RegisterVT.getVectorElementType().SimpleTy {
        _ => {
            llvm_unreachable_internal("unexpected element type for vector", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 36485);
        },
        i8 => {
            IntermediateVT = RegisterVT = v16i8;
        },
        i16 => {
            IntermediateVT = RegisterVT = v8i16;
        },
        i32 => {
            IntermediateVT = RegisterVT = v4i32;
        },
        i64 => {
            IntermediateVT = RegisterVT = v2i64;
        },
        f16 => {
            IntermediateVT = RegisterVT = v8f16;
        },
        f32 => {
            IntermediateVT = RegisterVT = v4f32;
        },
        f64 => {
            IntermediateVT = RegisterVT = v2f64;
        },
        bf16 => {
            IntermediateVT = RegisterVT = v8bf16;
        },
    }
    return NumRegs;
}

