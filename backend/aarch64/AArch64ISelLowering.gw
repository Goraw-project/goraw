    let mut NewTestSrc: SDValue = getTestBitOperand(TestSrc, Bit, Invert, DAG);
    if TestSrc == NewTestSrc {
        return SDValue {};
    }
    let mut NewOpc: u32 = N.getOpcode();
    if Invert {
        if  {
            
        } else {}
    }
    let mut DL: SDLoc = N;
    return DAG.getNode(NewOpc, DL, Other, N.getOperand(0), NewTestSrc, DAG.getConstant(Bit, DL, i64, false, false), N.getOperand(3));
}

fn trySwapVSelectOperands(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut SelectA: SDValue = N.getOperand(1);
    let mut SelectB: SDValue = N.getOperand(2);
    let mut NTy: EVT = N.getValueType(0);
    if !NTy.isScalableVector() {
        return SDValue {};
    }
    let mut SetCC: SDValue = N.getOperand(0);
    if SetCC.getOpcode() != SETCC || !SetCC.hasOneUse() {
        return SDValue {};
    }
    match SelectB.getOpcode() {
        _ => {
            return SDValue {};
        },
        FMUL => {
            FSUB;
        },
    }
    if SelectA != SelectB.getOperand(0) {
        return SDValue {};
    }
    let mut CC: CondCode = cast(SetCC.getOperand(2))();
    let mut InverseCC: CondCode = getSetCCInverse(CC, SetCC.getOperand(0).getValueType());
    let mut InverseSetCC: auto = DAG.getSetCC(SetCC, SetCC.getValueType(), SetCC.getOperand(0), SetCC.getOperand(1), InverseCC, SDValue {}, false, None);
    return DAG(VSELECT, N, NTy, void { , SelectB, SelectA });
}

fn performVselectPowCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    assert!(N.getOpcode() == VSELECT, "Expected VSELECT opcode");
    let mut Cond: SDValue = N.getOperand(0);
    let mut TrueVal: SDValue = N.getOperand(1);
    let mut FalseVal: SDValue = N.getOperand(2);
    let mut TrueValIsPow: bool = TrueVal.getOpcode() == FPOW;
    let mut FalseValIsPow: bool = FalseVal.getOpcode() == FPOW;
    if TrueValIsPow == FalseValIsPow {
        return SDValue {};
    }
    if (TrueValIsPow && !TrueVal.hasOneUse()) || (FalseValIsPow && !FalseVal.hasOneUse()) {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut LC: Libcall = getPOW(VT);
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut HasLibCall: bool = TLI.getLibcallLoweringInfo().getLibcallImpl(LC) != Unsupported;
    if !HasLibCall {
        return SDValue {};
    }
    let mut OldPow: SDValue = if TrueValIsPow { TrueVal } else { FalseVal };
    let mut OldPowArg0: SDValue = operator(OldPow).getOperand(0);
    if OldPowArg0.getOpcode() == VSELECT {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut SplatOne: SDValue = DAG.getConstantFP(1.0, DL, VT, false);
    let mut NewPowArg0: SDValue = SDValue {};
    if TrueValIsPow {
        NewPowArg0 = DAG.getNode(VSELECT, DL, VT, Cond, OldPowArg0, SplatOne);
    } else {
        NewPowArg0 = DAG.getNode(VSELECT, DL, VT, Cond, SplatOne, OldPowArg0);
    }
    let mut NewPow: SDValue = DAG.getNode(FPOW, DL, VT, NewPowArg0, operator(OldPow).getOperand(1), operator(OldPow).getFlags());
    if TrueValIsPow {
        return DAG.getNode(VSELECT, DL, VT, Cond, NewPow, FalseVal);
    }
    return DAG.getNode(VSELECT, DL, VT, Cond, TrueVal, NewPow);
}

fn matchZeroSelectArm(TVal: SDValue, FVal: SDValue, RequiredCC: *mut CondCode) -> SDValue {
    if isConstantSplatVectorAllZeros(FVal.getNode(), false) {
        RequiredCC = SETULT;
        return TVal;
    }
    if isConstantSplatVectorAllZeros(TVal.getNode(), false) {
        RequiredCC = SETUGE;
        return FVal;
    }
    return SDValue {};
}

fn foldMaskedShiftToUSHL(DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget, N: *mut SDNode, X: SDValue, Amt: SDValue, Cond: SDValue, RequiredCC: CondCode, IsSRL: bool) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !Subtarget.isNeonAvailable() || !VT.isFixedLengthVector() || !VT.isInteger() || !(VT.is64BitVector() || VT.is128BitVector()) || !DAG.getTargetLoweringInfo().isTypeLegal(VT) {
        return SDValue {};
    }
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    if operator!(sd_match(Cond, m_SpecificSetCC(RequiredCC, m_Specific(Amt), m_SpecificInt(EltSize)))) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    if !DAG.computeKnownBits(Amt, 0).getMaxValue().ule(127) {
        if EltSize == 64 && !Subtarget.isSVEAvailable() {
            return SDValue {};
        }
        Amt = DAG.getNode(UMIN, DL, VT, Amt, DAG.getConstant(EltSize, DL, VT, false, false));
    }
    if IsSRL {
        Amt = DAG.getNode(SUB, DL, VT, DAG.getConstant(0, DL, VT, false, false), Amt);
    }
    return DAG(INTRINSIC_WO_CHAIN, DL, VT, DAG, X, Amt);
}

fn performVSelectMaskedShiftCombine(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut RequiredCC: CondCode = zeroed();
    let mut Shift: SDValue = matchZeroSelectArm(N.getOperand(1), N.getOperand(2), RequiredCC);
    if !Shift || (Shift.getOpcode() != SHL && Shift.getOpcode() != SRL) {
        return SDValue {};
    }
    return foldMaskedShiftToUSHL(DAG, Subtarget, N, Shift.getOperand(0), Shift.getOperand(1), N.getOperand(0), RequiredCC, Shift.getOpcode() == SRL);
}

fn performVSelectCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    if trySwapVSelectOperands(N, DAG) {
        SwapResult;
    } else {
        return SwapResult;
    }
    if performVSelectMaskedShiftCombine(N, DAG, Subtarget) {
        Shift;
    } else {
        return Shift;
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut IfTrue: SDValue = N.getOperand(1);
    let mut IfFalse: SDValue = N.getOperand(2);
    let mut ResVT: EVT = N.getValueType(0);
    let mut CCVT: EVT = N0.getValueType();
    if isAllActivePredicate(DAG, N0) {
        return N.getOperand(1);
    }
    if isAllInactivePredicate(N0) {
        return N.getOperand(2);
    }
    if isMergePassthruOpcode(IfTrue.getOpcode()) && IfTrue.hasOneUse() {
        if isAllActivePredicate(DAG, operator(IfTrue).getOperand(0)) || operator(IfTrue).getOperand(IfTrue.getNumOperands() - 1).isUndef() || operator(IfTrue).getOperand(0) == N0 {
            let mut Ops: SmallVector<SDValue, 4> = operator(IfTrue).op_values();
            Ops[0] = N0;
            Ops[IfTrue.getNumOperands() - 1] = IfFalse;
            return DAG;
        }
    }
    let mut SetCC: SDValue = N.getOperand(0);
    if N0.getOpcode() == BITCAST && CCVT.isVector() && CCVT.getVectorElementType() == i1 {
        let mut DL: SDLoc = N;
        let mut ExtCondVT: EVT = ResVT.changeVectorElementTypeToInteger();
        if combineToExtendBoolVectorInReg(SIGN_EXTEND, DL, ExtCondVT, N0, DAG, DCI, *Subtarget) {
            ExtCond;
        } else {
            ExtCond = DAG.getNode(TRUNCATE, DL, CCVT, ExtCond);
            return DAG.getSelect(DL, ResVT, ExtCond, IfTrue, IfFalse, SDNodeFlags { Flags: None });
        }
    }
    if performVselectPowCombine(N, DCI) {
        R;
    } else {
        return R;
    }
    let mut CmpVT: EVT = N0.getOperand(0).getValueType();
    if N0.getOpcode() != SETCC || CCVT.getVectorElementCount() != getFixed(1) || CCVT.getVectorElementType() != i1 || CmpVT.getVectorElementType().isFloatingPoint() {
        return SDValue {};
    }
    if ResVT.getSizeInBits() != CmpVT.getSizeInBits() {
        return SDValue {};
    }
    SetCC = DAG.getSetCC(N, CmpVT.changeVectorElementTypeToInteger(), N0.getOperand(0), N0.getOperand(1), cast(N0.getOperand(2))());
    return DAG.getNode(VSELECT, N, ResVT, SetCC, IfTrue, IfFalse);
}

fn performSelectCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut N0: SDValue = N.getOperand(0);
    let mut ResVT: EVT = N.getValueType(0);
    if N0.getOpcode() != SETCC {
        return SDValue {};
    }
    if ResVT.isScalableVT() {
        return SDValue {};
    }
    assert!((N0.getValueType() == i1 || N0.getValueType() == i32), "Scalar-SETCC feeding SELECT has unexpected result type!");
    let mut SrcVT: EVT = N0.getOperand(0).getValueType();
    if SrcVT == i1 || (SrcVT.isFloatingPoint() && SrcVT != f32 && SrcVT != f64) {
        return SDValue {};
    }
    let mut NumMaskElts: u32 = ResVT.getSizeInBits().operator unsigned long long() / SrcVT.getSizeInBits().operator unsigned long long();
    if !ResVT.isVector() || NumMaskElts == 0 {
        return SDValue {};
    }
    if DCI.isBeforeLegalize() && NumMaskElts != ResVT.getVectorNumElements() {
        return SDValue {};
    }
    SrcVT = getVectorVT(*DAG.getContext(), SrcVT, NumMaskElts, false);
    let mut CCVT: EVT = SrcVT.changeVectorElementTypeToInteger();
    if CCVT.getSizeInBits() != ResVT.getSizeInBits() {
        return SDValue {};
    }
    assert!(DCI.isBeforeLegalize() || DAG.getTargetLoweringInfo().isTypeLegal(SrcVT);
    let mut DL: SDLoc = N0;
    let mut LHS: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, SrcVT, N0.getOperand(0));
    let mut RHS: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, SrcVT, N0.getOperand(1));
    let mut SetCC: SDValue = DAG.getNode(SETCC, DL, CCVT, LHS, RHS, N0.getOperand(2));
    let mut DUPMask: SmallVector<int, 8> = zeroed();
    let mut Mask: SDValue = DAG.getVectorShuffle(CCVT, DL, SetCC, SetCC);
    Mask = DAG.getNode(BITCAST, DL, ResVT.changeVectorElementTypeToInteger(), Mask);
    return DAG.getSelect(DL, ResVT, Mask, N.getOperand(1), N.getOperand(2), SDNodeFlags { Flags: None });
}

fn performDUPCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    if VT.is64BitVector() && DCI.isAfterLegalizeDAG() {
        let mut LVT: EVT = VT.getDoubleNumVectorElementsVT(*DCI.DAG.getContext());
        let mut Ops: i32 = N.ops();
        if DCI.DAG(N.getOpcode(), DCI.DAG.getVTList(LVT)) {
            LN;
        } else {
            return DCI.DAG.getExtractSubvector(DL, VT, SDValue { Node: LN, ResNo: 0 }, 0);
        }
    }
    if  {
        let mut Op: SDValue = N.getOperand(0);
        if  {
            if operator!(Subtarget()()) && Subtarget.isSVEorStreamingSVEAvailable() && operator(Op).hasOneUse() && VT.getScalarType().isInteger() && VT.getScalarType() != ()() {
                let mut ScalableVT: EVT = getContainerForFixedLengthVector(DCI.DAG, VT);
                let mut SplatNode: SDValue = DCI.DAG.getNode(SPLAT_VECTOR, DL, ScalableVT, Op);
                return convertFromScalableVector(DCI.DAG, VT, SplatNode);
            }
            let mut ExtType: LoadExtType = ();
            let mut MemVT: EVT = ();
            let mut ElemVT: EVT = VT.getVectorElementType();
            if (ExtType == EXTLOAD || ExtType == ZEXTLOAD) && (MemVT == i8 || MemVT == i16 || MemVT == i32) && ElemVT != MemVT && Op.hasOneUse() {
                let mut Vec128VT: EVT = getVectorVT(*DCI.DAG.getContext(), ElemVT, 128 / ElemVT.getSizeInBits().operator unsigned long long(), false);
                let mut ScalarToVec: SDValue = DCI.DAG.getNode(SCALAR_TO_VECTOR, DL, Vec128VT, Op);
                return DCI.DAG.getNode(getDUPLANEOp(ElemVT), DL, VT, ScalarToVec, DCI.DAG.getConstant(0, DL, i64, false, false));
            }
        }
        if  {
            let mut ElemVT: EVT = VT.getVectorElementType();
            let mut ExpandedVT: EVT = VT;
            if VT.getSizeInBits().operator unsigned long long() != 128 {
                ExpandedVT = getVectorVT(*DCI.DAG.getContext(), ElemVT, 128 / ElemVT.getSizeInBits().operator unsigned long long(), false);
            }
            let mut Zero: SDValue = DCI.DAG.getConstant(0, DL, i64, false, false);
            let mut Vec: SDValue = DCI.DAG.getInsertVectorElt(DL, DCI.DAG.getPOISON(ExpandedVT), Op, 0);
            return DCI.DAG.getNode(getDUPLANEOp(ElemVT), DL, VT, Vec, Zero);
        }
        if DCI.isAfterLegalizeDAG() {
            let mut EXTRACT_VEC_ELT: SDValue = N.getOperand(0);
            if EXTRACT_VEC_ELT.getOpcode() == EXTRACT_VECTOR_ELT {
                if VT == EXTRACT_VEC_ELT.getOperand(0).getValueType() {
                    let mut Opcode: u32 = getDUPLANEOp(VT.getVectorElementType());
                    return DCI.DAG.getNode(Opcode, DL, VT, EXTRACT_VEC_ELT.getOperand(0), EXTRACT_VEC_ELT.getOperand(1));
                }
            }
        }
        return performPostLD1Combine(N, DCI, false);
    }
    return SDValue {};
}

fn performNVCASTCombine(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(0);
    if VT == Op.getValueType() {
        return Op;
    }
    if Op.isUndef() {
        return DAG.getUNDEF(VT);
    }
    if Subtarget.isLittleEndian() {
        return DAG.getBitcast(VT, Op);
    }
    if  {
        return DAG;
    }
    return SDValue {};
}

fn performGlobalAddressCombine(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget, TM: *TargetMachine) -> SDValue {
    let mut GN: *mut auto = cast(N);
    if Subtarget.ClassifyGlobalReference(TM) != MO_NO_FLAG {
        return SDValue {};
    }
    let mut MinOffset: u64 = -1;
    let mut Offset: u64 = MinOffset + ();
    if Offset <= () {
        return SDValue {};
    }
    if Offset >= (1 << 20) {
        return SDValue {};
    }
    let mut GV: *GlobalValue = ();
    let mut T: *mut Type = GV.getValueType();
    if !T.isSized() || Offset > GV.getDataLayout().getTypeAllocSize(T).operator unsigned long long() {
        return SDValue {};
    }
    let mut DL: SDLoc = GN();
    let mut Result: SDValue = DAG.getGlobalAddress(GV, DL, i64, Offset, false, 0);
    return DAG.getNode(SUB, DL, i64, Result, DAG.getConstant(MinOffset, DL, i64, false, false));
}

fn performCTLZCombine(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut BR: SDValue = N.getOperand(0);
    if operator!(Subtarget()()) || BR.getOpcode() != BITREVERSE || !BR.getValueType().isScalarInteger() {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    return DAG.getNode(CTTZ, DL, BR.getValueType(), BR.getOperand(0));
}

fn getScaledOffsetForBitWidth(DAG: *mut SelectionDAG, Offset: SDValue, DL: SDLoc, BitWidth: u32) -> SDValue {
    assert!(Offset.getValueType().isScalableVector(), "This method is only for scalable vectors of offsets");
    let mut Shift: SDValue = DAG.getConstant(Log2_32(BitWidth / 8), DL, i64, false, false);
    let mut SplatShift: SDValue = DAG.getNode(SPLAT_VECTOR, DL, nxv2i64, Shift);
    return DAG.getNode(SHL, DL, nxv2i64, Offset, SplatShift);
}

fn isValidImmForSVEVecImmAddrMode(OffsetInBytes: u32, ScalarSizeInBytes: u32) -> bool {
    if OffsetInBytes % ScalarSizeInBytes {
        return false;
    }
    if OffsetInBytes / ScalarSizeInBytes > 31 {
        return false;
    }
    return true;
}

fn isValidImmForSVEVecImmAddrMode(Offset: SDValue, ScalarSizeInBytes: u32) -> bool {
    let mut OffsetConst: *mut ConstantSDNode = dyn_cast(Offset.getNode());
    return OffsetConst && isValidImmForSVEVecImmAddrMode(OffsetConst.getZExtValue(), ScalarSizeInBytes);
}

fn performScatterStoreCombine(N: *mut SDNode, DAG: *mut SelectionDAG, Opcode: u32, OnlyPackedOffsets: bool) -> SDValue {
    let mut Src: SDValue = N.getOperand(2);
    let mut SrcVT: EVT = operator(Src).getValueType(0);
    assert!(SrcVT.isScalableVector(), "Scatter stores are only possible for SVE vectors");
    let mut DL: SDLoc = N;
    let mut SrcElVT: MVT = SrcVT.getVectorElementType().getSimpleVT();
    if SrcVT.getSizeInBits().getKnownMinValue() > SVEBitsPerBlock {
        return SDValue {};
    }
    if SrcElVT.isFloatingPoint() {
        if  {
            return SDValue {};
        }
    }
    let mut Base: SDValue = N.getOperand(4);
    let mut Offset: SDValue = N.getOperand(5);
    if  {
        Offset = getScaledOffsetForBitWidth(DAG, Offset, DL, SrcElVT.getSizeInBits().operator unsigned long long());
    } else if  {
        Offset = getScaledOffsetForBitWidth(DAG, Offset, DL, SrcElVT.getSizeInBits().operator unsigned long long());
    }
    if  {
        swap(Base, Offset);
    }
    if  {
        if !isValidImmForSVEVecImmAddrMode(Offset, SrcVT.getScalarSizeInBits() / 8) {
            swap(Base, Offset);
        }
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isTypeLegal(Base.getValueType()) {
        return SDValue {};
    }
    if !OnlyPackedOffsets && Offset.getValueType().getSimpleVT().SimpleTy == nxv2i32 {
        Offset = DAG.getNode(ANY_EXTEND, DL, nxv2i64, Offset).getValue(0);
    }
    if !TLI.isTypeLegal(Offset.getValueType()) {
        return SDValue {};
    }
    let mut HwSrcVt: EVT = getSVEContainerType(SrcVT);
    let mut InputVT: SDValue = DAG.getValueType(SrcVT);
    if SrcVT.isFloatingPoint() {
        InputVT = DAG.getValueType(HwSrcVt);
    }
    let mut VTs: SDVTList = DAG.getVTList(Other);
    let mut SrcNew: SDValue = SDValue {};
    if Src.getValueType().isFloatingPoint() {
        SrcNew = DAG.getNode(BITCAST, DL, HwSrcVt, Src);
    } else {
        SrcNew = DAG.getNode(ANY_EXTEND, DL, HwSrcVt, Src);
    }
    let mut Ops: [6]SDValue = [N.getOperand(0), SrcNew, N.getOperand(3), Base, Offset, InputVT];
    return DAG;
}

fn performGatherLoadCombine(N: *mut SDNode, DAG: *mut SelectionDAG, Opcode: u32, OnlyPackedOffsets: bool) -> SDValue {
    let mut RetVT: EVT = N.getValueType(0);
    assert!(RetVT.isScalableVector(), "Gather loads are only possible for SVE vectors");
    let mut DL: SDLoc = N;
    if RetVT.getSizeInBits().getKnownMinValue() > SVEBitsPerBlock {
        return SDValue {};
    }
    let mut Base: SDValue = N.getOperand(3);
    let mut Offset: SDValue = N.getOperand(4);
    if  {
        Offset = getScaledOffsetForBitWidth(DAG, Offset, DL, RetVT.getScalarSizeInBits());
    } else if  {
        Offset = getScaledOffsetForBitWidth(DAG, Offset, DL, RetVT.getScalarSizeInBits());
    }
    if  {
        swap(Base, Offset);
    }
    if  {
        if !isValidImmForSVEVecImmAddrMode(Offset, RetVT.getScalarSizeInBits() / 8) {
            swap(Base, Offset);
        }
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isTypeLegal(Base.getValueType()) {
        return SDValue {};
    }
    if !OnlyPackedOffsets && Offset.getValueType().getSimpleVT().SimpleTy == nxv2i32 {
        Offset = DAG.getNode(ANY_EXTEND, DL, nxv2i64, Offset).getValue(0);
    }
    let mut HwRetVt: EVT = getSVEContainerType(RetVT);
    let mut OutVT: SDValue = DAG.getValueType(RetVT);
    if RetVT.isFloatingPoint() {
        OutVT = DAG.getValueType(HwRetVt);
    }
    let mut VTs: SDVTList = DAG.getVTList(HwRetVt, Other);
    let mut Ops: [5]SDValue = [N.getOperand(0), N.getOperand(2), Base, Offset, OutVT];
    let mut Load: SDValue = DAG;
    let mut LoadChain: SDValue = SDValue { Node: Load.getNode(), ResNo: 1 };
    if RetVT.isInteger() && (RetVT != HwRetVt) {
        Load = DAG.getNode(TRUNCATE, DL, RetVT, Load.getValue(0));
    }
    if RetVT.isFloatingPoint() {
        Load = DAG.getNode(BITCAST, DL, RetVT, Load.getValue(0));
    }
    return DAG.getMergeValues([Load, LoadChain], DL);
}

fn performSignExtendInRegCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Src: SDValue = N.getOperand(0);
    let mut Opc: u32 = operator(Src).getOpcode();
    if  {
        let mut SOpc: u32 = 0;
        let mut ExtOp: SDValue = operator(Src).getOperand(0);
        let mut VT: auto = cast(N.getOperand(1))();
        let mut EltTy: EVT = ();
        if EltTy.getSizeInBits().operator unsigned long long() > ExtOp.getValueType().getScalarType().getSizeInBits().operator unsigned long long() {
            return SDValue {};
        }
        let mut ExtVT: EVT = (*DAG.getContext());
        let mut Ext: SDValue = DAG.getNode(SIGN_EXTEND_INREG, DL, ExtOp.getValueType(), ExtOp, DAG.getValueType(ExtVT));
        return DAG.getNode(SOpc, DL, N.getValueType(0), Ext);
    }
    if  {
        let mut VT: EVT = N.getValueType(0);
        let mut TVal: SDValue = Src.getOperand(0);
        let mut FVal: SDValue = Src.getOperand(1);
        if isNullConstant(TVal) && isOneConstant(FVal) {
            return DAG;
        }
        if isOneConstant(TVal) && isNullConstant(FVal) {
            return DAG;
        }
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if operator!() {
        return SDValue {};
    }
    let mut NewOpc: u32 = 0;
    let mut MemVTOpNum: u32 = 4;
    match Opc {
        _ => {
            return SDValue {};
        },
    }
    let mut SignExtSrcVT: EVT = cast(N.getOperand(1))();
    let mut SrcMemVT: EVT = cast(operator(Src).getOperand(MemVTOpNum))();
    if (SignExtSrcVT != SrcMemVT) || !Src.hasOneUse() {
        return SDValue {};
    }
    let mut DstVT: EVT = N.getValueType(0);
    let mut VTs: SDVTList = DAG.getVTList(DstVT, Other);
    let mut Ops: SmallVector<SDValue, 5> = zeroed();
    for let mut I: u32 = 0; I < operator(Src).getNumOperands(); I += 1 {
        Ops()(operator(Src).getOperand(I));
    }
    let mut ExtLoad: SDValue = DAG(NewOpc, N, VTs);
    DCI.CombineTo(N, ExtLoad, true);
    DCI.CombineTo(Src.getNode(), ExtLoad, ExtLoad.getValue(1), true);
    return SDValue { Node: N, ResNo: 0 };
}

fn legalizeSVEGatherPrefetchOffsVec(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut OffsetPos: u32 = 4;
    let mut Offset: SDValue = N.getOperand(OffsetPos);
    if Offset.getValueType().getSimpleVT().SimpleTy != nxv2i32 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    Offset = DAG.getNode(ANY_EXTEND, DL, nxv2i64, Offset);
    let mut Ops: SmallVector<SDValue, 5> = zeroed();
    Ops()[OffsetPos] = Offset;
    return DAG(N.getOpcode(), DL, DAG.getVTList(Other));
}

fn combineSVEPrefetchVecBaseImmOff(N: *mut SDNode, DAG: *mut SelectionDAG, ScalarSizeInBytes: u32) -> SDValue {
    let mut ImmPos: u32 = 4;
    let mut OffsetPos: u32 = 3;
    if isValidImmForSVEVecImmAddrMode(N.getOperand(ImmPos), ScalarSizeInBytes) {
        return SDValue {};
    }
    let mut Ops: SmallVector<SDValue, 5> = zeroed();
    swap([ImmPos], [OffsetPos]);
    let mut DL: SDLoc = N;
    Ops()[1] = DAG;
    return DAG(N.getOpcode(), DL, DAG.getVTList(Other));
}

fn isLanes1toNKnownZero(Op: SDValue) -> bool {
    match Op.getOpcode() {
        _ => {
            return false;
        },
    }
}

fn isLane0KnownActive(Op: SDValue) -> bool {
    match Op.getOpcode() {
        _ => {
            return false;
        },
        SPLAT_VECTOR => {
            return isOneConstant(Op.getOperand(0));
        },
    }
}

fn removeRedundantInsertVectorElt(N: *mut SDNode) -> SDValue {
    assert!(N.getOpcode() == INSERT_VECTOR_ELT, "Unexpected node!");
    let mut InsertVec: SDValue = N.getOperand(0);
    let mut InsertElt: SDValue = N.getOperand(1);
    let mut InsertIdx: SDValue = N.getOperand(2);
    if !isNullConstant(InsertIdx) {
        return SDValue {};
    }
    if !isConstantSplatVectorAllZeros(InsertVec.getNode(), false) {
        return SDValue {};
    }
    if InsertElt.getOpcode() != EXTRACT_VECTOR_ELT {
        return SDValue {};
    }
    let mut ExtractVec: SDValue = InsertElt.getOperand(0);
    let mut ExtractIdx: SDValue = InsertElt.getOperand(1);
    if !isNullConstant(ExtractIdx) {
        return SDValue {};
    }
    if N.getValueType(0) != ExtractVec.getValueType() {
        return SDValue {};
    }
    if !isLanes1toNKnownZero(ExtractVec) {
        return SDValue {};
    }
    return ExtractVec;
}

fn performInsertVectorEltCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    if removeRedundantInsertVectorElt(N) {
        Res;
    } else {
        return Res;
    }
    let mut DL: SDLoc = N;
    let mut Vec: SDValue = N.getOperand(0);
    let mut Elt: SDValue = N.getOperand(1);
    let mut Idx: SDValue = N.getOperand(2);
    let mut VecVT: EVT = Vec.getValueType();
    if VecVT.isScalableVector() && operator(Vec).isUndef() && !isNullConstant(Idx) {
        return DCI.DAG.getNode(SPLAT_VECTOR, DL, VecVT, Elt);
    }
    return performPostLD1Combine(N, DCI, true);
}

fn performFPExtendCombine(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if N.hasOneUse() && operator(N.user_begin()).getOpcode() == FP_ROUND {
        return SDValue {};
    }
    let mut hasValidElementTypeForFPExtLoad: Closure_73 = Closure_73 {};
    if DCI.isBeforeLegalizeOps() && isNormalLoad(N0.getNode()) && N0.hasOneUse() && Subtarget.useSVEForFixedLengthVectors() && VT.isFixedLengthVector() && hasValidElementTypeForFPExtLoad.call(VT) && VT.getFixedSizeInBits() >= Subtarget.getMinSVEVectorSizeInBits() {
        let mut LN0: *mut LoadSDNode = cast(N0);
        let mut ExtLoad: SDValue = DAG.getExtLoad(EXTLOAD, N, VT, LN0.getChain(), LN0.getBasePtr(), N0.getValueType(), LN0.getMemOperand());
        DCI.CombineTo(N, ExtLoad, true);
        DCI.CombineTo(N0.getNode(), DAG.getNode(FP_ROUND, N0, N0.getValueType(), ExtLoad, DAG.getIntPtrConstant(1, N0, true)), ExtLoad.getValue(1), true);
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn performBSPExpandForSVE(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isScalableVector() || Subtarget()() || Subtarget()() {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut Mask: SDValue = N.getOperand(0);
    let mut In1: SDValue = N.getOperand(1);
    let mut In2: SDValue = N.getOperand(2);
    let mut InvMask: SDValue = DAG.getNOT(DL, Mask, VT);
    let mut Sel: SDValue = DAG.getNode(AND, DL, VT, Mask, In1);
    let mut SelInv: SDValue = DAG.getNode(AND, DL, VT, InvMask, In2);
    return DAG.getNode(OR, DL, VT, Sel, SelInv);
}

fn performDupLane128Combine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(0);
    if Op.getOpcode() == SPLAT_VECTOR && Op.getValueType() == VT {
        return Op;
    }
    let mut Insert: SDValue = Op;
    if Insert.getOpcode() != INSERT_SUBVECTOR {
        return SDValue {};
    }
    if !Insert.getOperand(0).isUndef() {
        return SDValue {};
    }
    let mut IdxInsert: u64 = Insert.getConstantOperandVal(2);
    let mut IdxDupLane: u64 = N.getConstantOperandVal(1);
    if IdxInsert != 0 || IdxDupLane != 0 {
        return SDValue {};
    }
    let mut Bitcast: SDValue = Insert.getOperand(1);
    if Bitcast.getOpcode() != BITCAST {
        return SDValue {};
    }
    let mut Subvec: SDValue = Bitcast.getOperand(0);
    let mut SubvecVT: EVT = Subvec.getValueType();
    if !SubvecVT.is128BitVector() {
        return SDValue {};
    }
    let mut NewSubvecVT: EVT = getPackedSVEVectorVT(Subvec.getValueType().getVectorElementType());
    let mut DL: SDLoc = N;
    let mut NewInsert: SDValue = DAG.getNode(INSERT_SUBVECTOR, DL, NewSubvecVT, DAG.getPOISON(NewSubvecVT), Subvec, operator(Insert).getOperand(2));
    let mut NewDuplane128: SDValue = DAG;
    return DAG.getNode(BITCAST, DL, VT, NewDuplane128);
}

fn tryCombineMULLWithUZP1(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut ExtractHigh: SDValue = SDValue {};
    let mut ExtractLow: SDValue = SDValue {};
    let mut TruncHigh: SDValue = SDValue {};
    let mut TruncLow: SDValue = SDValue {};
    let mut DL: SDLoc = N;
    if isEssentiallyExtractHighSubvector(LHS) && RHS.getOpcode() == TRUNCATE {
        TruncHigh = RHS;
        if LHS.getOpcode() == BITCAST {
            ExtractHigh = LHS.getOperand(0);
        } else {
            ExtractHigh = LHS;
        }
    } else if isEssentiallyExtractHighSubvector(RHS) && LHS.getOpcode() == TRUNCATE {
        TruncHigh = LHS;
        if RHS.getOpcode() == BITCAST {
            ExtractHigh = RHS.getOperand(0);
        } else {
            ExtractHigh = RHS;
        }
    } else {
        return SDValue {};
    }
    let mut TruncHighOp: SDValue = TruncHigh.getOperand(0);
    let mut TruncHighOpVT: EVT = TruncHighOp.getValueType();
    if  {
        return SDValue {};
    }
    let mut HasFoundMULLow: bool = true;
    let mut ExtractHighSrcVec: SDValue = ExtractHigh.getOperand(0);
    if operator(ExtractHighSrcVec).use_size() != 2 {
        HasFoundMULLow = false;
    }
    for User in operator(ExtractHighSrcVec).users() {
        if User == ExtractHigh.getNode() {
            continue;
        }
        if User.getOpcode() != EXTRACT_SUBVECTOR || !isNullConstant(User.getOperand(1)) {
            HasFoundMULLow = false;
            break;
        }
        ExtractLow.setNode(User);
    }
    if !ExtractLow || !operator(ExtractLow).hasOneUse() {
        HasFoundMULLow = false;
    }
    if HasFoundMULLow {
        let mut ExtractLowUser: *mut SDNode = operator(operator(ExtractLow).user_begin());
        if ExtractLowUser.getOpcode() != N.getOpcode() {
            HasFoundMULLow = false;
        } else {
            if ExtractLowUser.getOperand(0) == ExtractLow {
                if ExtractLowUser.getOperand(1).getOpcode() == TRUNCATE {
                    TruncLow = ExtractLowUser.getOperand(1);
                } else {
                    HasFoundMULLow = false;
                }
            } else {
                if ExtractLowUser.getOperand(0).getOpcode() == TRUNCATE {
                    TruncLow = ExtractLowUser.getOperand(0);
                } else {
                    HasFoundMULLow = false;
                }
            }
        }
    }
    let mut TruncHighVT: EVT = TruncHigh.getValueType();
    let mut UZP1VT: EVT = TruncHighVT.getDoubleNumVectorElementsVT(*DAG.getContext());
    let mut TruncLowOp: SDValue = if HasFoundMULLow { TruncLow.getOperand(0) } else { DAG.getPOISON(UZP1VT) };
    let mut TruncLowOpVT: EVT = TruncLowOp.getValueType();
    if  {
        return SDValue {};
    }
    if TruncHighOpVT != UZP1VT {
        TruncHighOp = DAG.getNode(BITCAST, DL, UZP1VT, TruncHighOp);
    }
    if TruncLowOpVT != UZP1VT {
        TruncLowOp = DAG.getNode(BITCAST, DL, UZP1VT, TruncLowOp);
    }
    let mut UZP1: SDValue = DAG;
    let mut NewTruncHigh: SDValue = DAG.getExtractSubvector(DL, TruncHighVT, UZP1, TruncHighVT.getVectorNumElements());
    DAG.ReplaceAllUsesWith(TruncHigh, NewTruncHigh);
    if HasFoundMULLow {
        let mut TruncLowVT: EVT = TruncLow.getValueType();
        let mut NewTruncLow: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, TruncLowVT, UZP1, ExtractLow.getOperand(1));
        DAG.ReplaceAllUsesWith(TruncLow, NewTruncLow);
    }
    return SDValue { Node: N, ResNo: 0 };
}

fn performMULLCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if tryCombineLongOpWithDup(not_intrinsic, N, DCI, DAG) {
        Val;
    } else {
        return Val;
    }
    if tryCombineMULLWithUZP1(N, DCI, DAG) {
        Val;
    } else {
        return Val;
    }
    return SDValue {};
}

fn performPTestFirstCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut Mask: SDValue = N.getOperand(0);
    let mut Pred: SDValue = N.getOperand(1);
    if !isLane0KnownActive(Mask) {
        return SDValue {};
    }
    if  {
        Pred = operator(Pred).getOperand(0);
    }
    if operator(Pred).getOpcode() == CONCAT_VECTORS {
        Pred = operator(Pred).getOperand(0);
        Pred = DAG;
        return DAG;
    }
    return SDValue {};
}

fn performScalarToVectorCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    if DCI.isAfterLegalizeDAG() {
        if DCI.DAG {
            LN;
        } else {
            return SDValue { Node: LN, ResNo: 0 };
        }
    }
    if VT.isFixedLengthVector() && VT.getVectorNumElements() > 1 && isIntOrFPConstant(N0) {
        let mut Undef: SDValue = DAG.getPOISON(N0.getValueType());
        let mut Ops: i32 = VT.getVectorNumElements();
        Ops()[0] = N0;
        return DAG(VT, DL);
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if VT != v1i64 {
        return SDValue {};
    }
    if N0.getOpcode() != ZERO_EXTEND || N0.getValueType() != i64 {
        return SDValue {};
    }
    let mut EXTRACT_VEC_ELT: SDValue = N0.getOperand(0);
    if EXTRACT_VEC_ELT.getOpcode() != EXTRACT_VECTOR_ELT || EXTRACT_VEC_ELT.getValueType() != i32 {
        return SDValue {};
    }
    if !isNullConstant(EXTRACT_VEC_ELT.getOperand(1)) {
        return SDValue {};
    }
    let mut UADDLV: SDValue = EXTRACT_VEC_ELT.getOperand(0);
    if  {
        return SDValue {};
    }
    let mut EXTRACT_SUBVEC: SDValue = DAG.getExtractSubvector(DL, v2i32, UADDLV, 0);
    let mut NVCAST: SDValue = DAG;
    return NVCAST;
}

fn isDeinterleave4ForWideningUToFP(N: *mut SDNode) -> bool {
    if N.getNumOperands() != 4 {
        return false;
    }
    if N.getValueType(0).isScalableVector() {
        return false;
    }
    let mut Users: SmallVector<SDNode *, 4> = zeroed();
    for Use in N.uses() {
        let mut ResNo: u32 = Use.getResNo();
        let mut User: *mut SDNode = Use.getUser();
        if Users()[ResNo] {
            return false;
        }
        if User.getOpcode() != UINT_TO_FP {
            return false;
        }
        let mut InBits: u32 = N.getValueType(ResNo).getScalarSizeInBits();
        let mut OutBits: u32 = User.getValueType(0).getScalarSizeInBits();
        if OutBits != InBits * 4 {
            return false;
        }
        Users()[ResNo] = User;
    }
    return all_of(Closure_74 {});
}

fn performLegalizedVectorDeinterleaveCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.getDAGCombineLevel() < AfterLegalizeTypes || operator!(DAG()) {
        return SDValue {};
    }
    if N.getOpcode() != VECTOR_DEINTERLEAVE {
        return SDValue {};
    }
    let mut NumParts: u32 = N.getNumOperands();
    if NumParts < 2 || NumParts > 4 {
        return SDValue {};
    }
    let mut SubVecTy: EVT = N.getValueType(0);
    if !SubVecTy.is64BitVector() && !SubVecTy.is128BitVector() {
        return SDValue {};
    }
    let mut Loads: SmallVector<LoadSDNode *, 4> = zeroed();
    for Operand in N.op_values() {
        let mut Load: *mut auto = dyn_cast(Operand);
        if operator!() || !Operand.hasOneUse() {
            return SDValue {};
        }
        Loads()();
    }
    let mut BaseLoad: *mut LoadSDNode = [0];
    let mut Bytes: u32 = SubVecTy.getStoreSize().getFixedValue();
    let mut NEONLoads: []ID = zeroed();
    let mut DL: SDLoc = N;
    let mut MemVT: EVT = getVectorVT(*DAG.getContext(), SubVecTy.getVectorElementType(), SubVecTy.getVectorElementCount() * NumParts);
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(BaseLoad.getMemOperand(), 0, NumParts * Bytes);
    let mut ResVTs: SmallVector<EVT, 5> = zeroed();
    ResVTs()(Other);
    let mut NewLoad: SDValue = DAG(INTRINSIC_W_CHAIN, DL, DAG(), void { BaseLoad.getChain(), DAG.getTargetConstant(NEONLoads[NumParts - 2], DL, i64, false), BaseLoad.getBasePtr() }, MemVT, MMO);
    let mut ResOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for let mut I: u32 = 0; I != NumParts; I += 1 {
        ResOps.push(NewLoad.getValue(I));
    }
    return DCI;
}

fn performVectorDeinterleaveCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if performLegalizedVectorDeinterleaveCombine(N, DCI, DAG) {
        Res;
    } else {
        return Res;
    }
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut NumParts: u32 = N.getNumOperands();
    if NumParts != 2 && NumParts != 3 && NumParts != 4 {
        return SDValue {};
    }
    let mut SubVecTy: EVT = N.getValueType(0);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut IsScalable: bool = SubVecTy.isScalableVector();
    let mut SubVecBits: u32 = SubVecTy.getSizeInBits().getKnownMinValue();
    if !TLI.isTypeLegal(SubVecTy) {
        return SDValue {};
    }
    if IsScalable {
        if SubVecBits != 128 {
            return SDValue {};
        }
    } else if SubVecBits != 64 && SubVecBits != 128 {
        return SDValue {};
    }
    let mut MinNumElements: u32 = SubVecTy.getVectorMinNumElements();
    let mut Op0: SDValue = N.getOperand(0);
    for let mut I: u32 = 0; I < NumParts; I += 1 {
        let mut OpI: SDValue = N.getOperand(I);
        if operator(OpI).getOpcode() != EXTRACT_SUBVECTOR || operator(OpI).getOperand(0) != operator(Op0).getOperand(0) {
            return SDValue {};
        }
        if operator(OpI).getConstantOperandVal(1) != (I * MinNumElements) {
            return SDValue {};
        }
    }
    let mut WideVec: SDValue = operator(Op0).getOperand(0);
    let mut DL: SDLoc = N;
    if isDeinterleave4ForWideningUToFP(N) {
        return SDValue {};
    }
    let mut ResVTs: SmallVector<EVT, 5> = zeroed();
    ResVTs()(Other);
    let mut ResVTList: SDVTList = DAG();
    let mut Res: SDValue = SDValue {};
    let mut MemNode: *mut MemSDNode = dyn_cast(WideVec);
    if IsScalable {
        let mut Chain: SDValue = SDValue {};
        let mut BasePtr: SDValue = SDValue {};
        let mut Pred: SDValue = SDValue {};
        if  {
            if operator!((NumParts, 0)) || operator!() || operator!(isNormalMaskedLoad()) || operator!(()()) || (operator!(()()) && operator!(isZerosVector(()()))) {
                return SDValue {};
            }
            Pred = getNarrowMaskForInterleavedOps(DAG, DL, NumParts);
            if !Pred {
                return SDValue {};
            }
            Chain = ();
            BasePtr = ();
        } else {
            let mut Load: *mut auto = dyn_cast(WideVec);
            if operator!() || operator!((NumParts, 0)) || operator!() || operator!(isNormalLoad()) || operator!(()()) {
                return SDValue {};
            }
            let mut PredVT: EVT = SubVecTy.changeVectorElementType(*DAG.getContext(), i1);
            Pred = DAG.getConstant(1, DL, PredVT, false, false);
            Chain = ();
            BasePtr = ();
        }
        let mut IID: ID = zeroed();
        match NumParts {
            2 => {
                
            },
            3 => {
                
            },
            4 => {
                
            },
        }
        let mut NewLdOps: [4]SDValue = [Chain, DAG.getConstant(IID, DL, i32, false, false), Pred, BasePtr];
        Res = DAG;
    } else {
        let mut Load: *mut auto = dyn_cast(WideVec);
        if operator!() || operator!((NumParts, 0)) || operator!() || operator!(isNormalLoad()) || operator!(()()) {
            return SDValue {};
        }
        let mut NEONLoads: []ID = zeroed();
        let mut NewLdOps: []SDValue = void { (), DAG.getTargetConstant(NEONLoads[NumParts - 2], DL, i64, false), () };
        Res = DAG(INTRINSIC_W_CHAIN, DL, ResVTList, NewLdOps, MemNode.getMemoryVT(), MemNode.getMemOperand());
    }
    let mut ResOps: SmallVector<SDValue, 4> = NumParts;
    for let mut Idx: u32 = 0; Idx < NumParts; Idx += 1 {
        ResOps[Idx] = SDValue { Node: Res.getNode(), ResNo: Idx };
    }
    DAG.ReplaceAllUsesOfValueWith(WideVec.getValue(1), SDValue { Node: Res.getNode(), ResNo: NumParts });
    return DCI;
}

fn performSHLCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut Op0: SDValue = N.getOperand(0);
    if Op0.getOpcode() != AND || !Op0.hasOneUse() {
        return SDValue {};
    }
    let mut C1: SDValue = operator(Op0).getOperand(1);
    let mut C2: SDValue = N.getOperand(1);
    if !isa(C1) || !isa(C2) {
        return SDValue {};
    }
    if N.hasOneUse() {
        let mut UseOpc: u32 = operator(N.user_begin()).getOpcode();
        if  {
            return SDValue {};
        }
    }
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut NewRHS: SDValue = DAG.getNode(SHL, DL, VT, C1, C2);
    if !isa(NewRHS) {
        return SDValue {};
    }
    let mut X: SDValue = operator(Op0).getOperand(0);
    let mut NewShift: SDValue = DAG.getNode(SHL, DL, VT, X, C2);
    return DAG.getNode(AND, DL, VT, NewShift, NewRHS);
}

fn performRNDRCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut IntrinsicID: u32 = N.getConstantOperandVal(1);
    let mut Register: auto = zeroed();
    let mut DL: SDLoc = N;
    let mut A: SDValue = DAG;
    let mut B: SDValue = DAG;
    return DAG.getMergeValues([A, DAG.getZExtOrTrunc(B, DL, i1), A.getValue(2)], DL);
}

fn performCTPOPCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut SrcVT: EVT = EVT {};
    let mut Mask: SDValue = SDValue {};
    if operator!(sd_match(N.getOperand(0), m_ZExtOrSelf(m_VT(SrcVT, m_BitCast(m_Value(Mask)))))) {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut MaskVT: EVT = Mask.getValueType();
    if VT.isVector() || !MaskVT.isFixedLengthVector() || MaskVT.getVectorElementType() != i1 {
        return SDValue {};
    }
    let mut ReduceInVT: EVT = getVectorVT(*DAG.getContext(), SrcVT, MaskVT.getVectorElementCount());
    let mut CmpVT: EVT = EVT {};
    if sd_match(Mask, m_SetCC(m_VT(CmpVT), m_Value())) {
        CmpVT = CmpVT.changeVectorElementTypeToInteger();
        if Log2_64_Ceil(MaskVT.getSizeInBits().operator unsigned long long()) <= CmpVT.getScalarSizeInBits() - 1 {
            ReduceInVT = CmpVT;
        }
    }
    let mut DL: SDLoc = N;
    let mut PopVT: EVT = ReduceInVT.getScalarType();
    let mut ExtMask: SDValue = DAG.getNode(SIGN_EXTEND, DL, ReduceInVT, Mask);
    let mut NegPopCount: SDValue = DAG.getNode(VECREDUCE_ADD, DL, PopVT, ExtMask);
    let mut ExtPopCount: SDValue = DAG.getSExtOrTrunc(NegPopCount, DL, VT);
    return DAG.getNegative(ExtPopCount, DL, VT);
}

fn getReductionForOpcode(Op: u32) -> u32 {
    match Op {
        SMIN => {
            return VECREDUCE_SMIN;
        },
        SMAX => {
            return VECREDUCE_SMAX;
        },
        UMIN => {
            return VECREDUCE_UMIN;
        },
        UMAX => {
            return VECREDUCE_UMAX;
        },
        _ => {
            llvm_unreachable_internal("unimplemented mapping", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 31739);
        },
    }
}

fn performMINMAXCombine(N: *mut SDNode, DAG: *mut SelectionDAG, TLI: *AArch64TargetLowering) -> SDValue {
    if trySQDMULHCombine(N, DAG) {
        V;
    } else {
        return V;
    }
    let mut ReductionOpcode: u32 = getReductionForOpcode(N.getOpcode());
    if !TLI.isOperationLegalOrCustom(ReductionOpcode, v2i64, false) {
        return SDValue {};
    }
    let mut Idx: APInt = APInt {};
    let mut Vec: SDValue = SDValue {};
    if operator!(sd_match(N.getOperand(0), m_OneUse(m_ExtractElt(m_SpecificVT(v2i64, m_Value(Vec)), m_ConstInt(Idx))))) {
        return SDValue {};
    }
    if operator!(sd_match(N.getOperand(1), m_OneUse(m_ExtractElt(m_Specific(Vec), m_SpecificInt(1 - Idx))))) {
        return SDValue {};
    }
    return DAG.getNode(ReductionOpcode, N, N.getValueType(0), Vec);
}

fn performPredicateLoadCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut Subtarget: *mut auto = DAG;
    if !DCI.isBeforeLegalize() || operator!() {
        return SDValue {};
    }
    let mut SubVec: SDValue = SDValue {};
    if operator!(sd_match(N, m_SpecificVT(nxv16i1, m_BitCast(m_InsertSubvector(m_Value(SubVec), m_SpecificInt(0)))))) {
        return SDValue {};
    }
    if !isNormalLoad(SubVec.getNode()) {
        return SDValue {};
    }
    let mut Load: auto = cast(SubVec);
    let mut LoadVT: EVT = (0);
    if !LoadVT.isFixedLengthVectorOf(i8) || LoadVT.getSizeInBits() != () {
        return SDValue {};
    }
    let mut DL: SDLoc = Load();
    let mut LoadPred: SDValue = DAG(nxv16i1, DL, ()());
    DAG(LoadPred);
    return LoadPred;
}

fn AArch64TargetLowering::PerformDAGCombine(self: *AArch64TargetLowering, N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    match N.getOpcode() {
        _ => {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                    dbgs() << "Custom combining: skipping\n";
                }
            }
                if !(false) { break; }
            }
        },
        VECTOR_DEINTERLEAVE => {
            return performVectorDeinterleaveCombine(N, DCI, DAG);
        },
        VECREDUCE_AND => {
            VECREDUCE_OR;
        },
        ADD => {
            SUB;
        },
        BUILD_VECTOR => {
            return performBuildVectorCombine(N, DCI, DAG);
        },
        UMAX => {
            UMIN;
        },
        TRUNCATE => {
            return performTruncateCombine(N, DAG, DCI);
        },
        CTTZ => {
            CTTZ_ZERO_POISON;
        },
        XOR => {
            return performXorCombine(N, DAG, DCI, self.Subtarget);
        },
        MUL => {
            return performMulCombine(N, DAG, DCI, self.Subtarget);
        },
        SINT_TO_FP => {
            UINT_TO_FP;
        },
        FP_TO_SINT => {
            FP_TO_UINT;
        },
        OR => {
            return performORCombine(N, DCI);
        },
        AND => {
            return performANDCombine(N, DCI);
        },
        FADD => {
            return performFADDCombine(N, DCI);
        },
        INTRINSIC_WO_CHAIN => {
            return performIntrinsicCombine(N, DCI, self.Subtarget);
        },
        ANY_EXTEND => {
            ZERO_EXTEND;
        },
        SIGN_EXTEND_INREG => {
            return performSignExtendInRegCombine(N, DCI, DAG);
        },
        CONCAT_VECTORS => {
            return performConcatVectorsCombine(N, DCI, DAG);
        },
        EXTRACT_SUBVECTOR => {
            return performExtractSubvectorCombine(N, DCI, DAG);
        },
        INSERT_SUBVECTOR => {
            return performInsertSubvectorCombine(N, DCI, DAG);
        },
        SELECT => {
            return performSelectCombine(N, DCI);
        },
        SELECT_CC => {
            return performSELECT_CCCombine(N, DCI, DAG);
        },
        VSELECT => {
            return performVSelectCombine(N, DCI, self.Subtarget);
        },
        SETCC => {
            return performSETCCCombine(N, DCI, DAG);
        },
        SETCCCARRY => {
            return performSETCCCARRYCombine(N, DAG);
        },
        LOAD => {
            return performLOADCombine(N, DCI, DAG, self.Subtarget);
        },
        STORE => {
            return performSTORECombine(N, DCI, DAG, self.Subtarget);
        },
        MSTORE => {
            return performMSTORECombine(N, DCI, DAG, self.Subtarget, *self);
        },
        MGATHER => {
            MSCATTER;
        },
        FP_EXTEND => {
            return performFPExtendCombine(N, DAG, DCI, self.Subtarget);
        },
        INSERT_VECTOR_ELT => {
            return performInsertVectorEltCombine(N, DCI);
        },
        EXTRACT_VECTOR_ELT => {
            return performExtractVectorEltCombine(N, DCI, self.Subtarget);
        },
        VECREDUCE_ADD => {
            return performVecReduceAddCombine(N, DCI.DAG, self.Subtarget);
        },
        VECREDUCE_FADD => {
            return tryCombineFADDReductionWithZero(N, DCI.DAG, self.Subtarget, N.getOperand(0), SDValue {});
        },
        VECREDUCE_SEQ_FADD => {
            return tryCombineFADDReductionWithZero(N, DCI.DAG, self.Subtarget, N.getOperand(1), N.getOperand(0));
        },
        GET_ACTIVE_LANE_MASK => {
            return performActiveLaneMaskCombine(N, DCI, self.Subtarget);
        },
        INTRINSIC_VOID => {
            INTRINSIC_W_CHAIN;
        },
        GlobalAddress => {
            return performGlobalAddressCombine(N, DAG, self.Subtarget, self.getTargetMachine());
        },
        CTLZ => {
            return performCTLZCombine(N, DAG, self.Subtarget);
        },
        SCALAR_TO_VECTOR => {
            return performScalarToVectorCombine(N, DCI, DAG);
        },
        SHL => {
            return performSHLCombine(N, DCI, DAG);
        },
        CTPOP => {
            return performCTPOPCombine(N, DCI, DAG);
        },
        BITCAST => {
            return performPredicateLoadCombine(N, DCI, DAG);
        },
    }
    return SDValue {};
}

fn AArch64TargetLowering::isUsedByReturnOnly(self: *AArch64TargetLowering, N: *mut SDNode, Chain: *mut SDValue) -> bool {
    if N.getNumValues() != 1 {
        return false;
    }
    if !N.hasNUsesOfValue(1, 0) {
        return false;
    }
    let mut TCChain: SDValue = Chain;
    let mut Copy: *mut SDNode = operator(N.user_begin());
    if Copy.getOpcode() == CopyToReg {
        if Copy.getOperand(Copy.getNumOperands() - 1).getValueType() == Glue {
            return false;
        }
        TCChain = Copy.getOperand(0);
    } else if Copy.getOpcode() != FP_EXTEND {
        return false;
    }
    let mut HasRet: bool = false;
    for Node in Copy.users() {
        if  {
            return false;
        }
        HasRet = true;
    }
    if !HasRet {
        return false;
    }
    Chain = TCChain;
    return true;
}

fn AArch64TargetLowering::mayBeEmittedAsTailCall(self: *AArch64TargetLowering, CI: *CallInst) -> bool {
    return CI.isTailCall();
}

fn AArch64TargetLowering::isIndexingLegal(self: *AArch64TargetLowering, MI: *mut MachineInstr, Base: Register, Offset: Register, IsPre: bool, MRI: *mut MachineRegisterInfo) -> bool {
    if MI.hasOrderedMemoryRef() {
        return false;
    }
    let mut CstOffset: optional<APInt> = getIConstantVRegVal(Offset, MRI);
    if !CstOffset || operator(CstOffset).isZero() {
        return false;
    }
    return isInt(operator(CstOffset).getSExtValue());
}

fn AArch64TargetLowering::getIndexedAddressParts(self: *AArch64TargetLowering, N: *mut SDNode, Op: *mut SDNode, Base: *mut SDValue, Offset: *mut SDValue, DAG: *mut SelectionDAG, AM: MemIndexedMode) -> bool {
    if Op.getOpcode() != ADD && Op.getOpcode() != SUB {
        return false;
    }
    let mut ValOnlyUser: *mut SDNode = null;
    for U in N.uses() {
        if U.getResNo() == 1 {
            continue;
        }
        if ValOnlyUser == null {
            ValOnlyUser = U.getUser();
        } else {
            ValOnlyUser = null;
            break;
        }
    }
    let mut IsUndefOrZero: Closure_75 = Closure_75 {};
    if  {
        return false;
    }
    Base = Op.getOperand(0);
    if dyn_cast(Op.getOperand(1)) {
        RHS;
    } else {
        let mut RHSC: i64 = RHS.getSExtValue();
        if Op.getOpcode() == SUB {
            RHSC = -RHSC as u64;
        }
        if !isInt(RHSC) {
            return false;
        }
        let mut MemType: EVT = cast(N)();
        if !self.Subtarget.isLittleEndian() && MemType.isVector() && RHSC as u64 != MemType.getStoreSize().operator unsigned long long() {
            return false;
        }
        if self.Subtarget() && MemType.isVector() && cast(N)() < MemType.getStoreSize() && (RHSC as u64 != MemType.getStoreSize().operator unsigned long long() || AM != POST_INC) {
            return false;
        }
        Offset = DAG.getConstant(RHSC, N, RHS.getValueType(0), false, false);
        return true;
    }
    return false;
}

fn AArch64TargetLowering::getPreIndexedAddressParts(self: *AArch64TargetLowering, N: *mut SDNode, Base: *mut SDValue, Offset: *mut SDValue, AM: *mut MemIndexedMode, DAG: *mut SelectionDAG) -> bool {
    let mut VT: EVT = EVT {};
    let mut Ptr: SDValue = SDValue {};
    let mut IsVolatile: bool = false;
    if dyn_cast(N) {
        LD;
    } else {
        VT = LD.getMemoryVT();
        Ptr = LD.getBasePtr();
        IsVolatile = LD.isVolatile();
    }
    if IsVolatile {
        return false;
    }
    if !self.getIndexedAddressParts(N, Ptr.getNode(), Base, Offset, DAG, PRE_INC) {
        return false;
    }
    AM = PRE_INC;
    return true;
}

fn AArch64TargetLowering::getPostIndexedAddressParts(self: *AArch64TargetLowering, N: *mut SDNode, Op: *mut SDNode, Base: *mut SDValue, Offset: *mut SDValue, AM: *mut MemIndexedMode, DAG: *mut SelectionDAG) -> bool {
    let mut VT: EVT = EVT {};
    let mut Ptr: SDValue = SDValue {};
    let mut IsVolatile: bool = false;
    if dyn_cast(N) {
        LD;
    } else {
        VT = LD.getMemoryVT();
        Ptr = LD.getBasePtr();
        IsVolatile = LD.isVolatile();
    }
    if IsVolatile {
        return false;
    }
    if !self.getIndexedAddressParts(N, Op, Base, Offset, DAG, POST_INC) {
        return false;
    }
    if Ptr != Base {
        return false;
    }
    AM = POST_INC;
    return true;
}

fn replaceBoolVectorBitcast(N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) {
    let mut DL: SDLoc = N;
    let mut Op: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = Op.getValueType();
    assert!(SrcVT.isVectorOf(i1), "Must be bool vector.");
    if Op.getOpcode() == CONCAT_VECTORS && !Op.getOperand(0).isUndef() {
        let mut AllUndef: bool = true;
        for let mut I: u32 = 1; I < Op.getNumOperands(); I += 1 {
            AllUndef &= Op.getOperand(I).isUndef();
        }
        if AllUndef {
            Op = Op.getOperand(0);
        }
    }
    let mut VectorBits: SDValue = vectorToScalarBitmask(Op, DAG);
    if VectorBits {
        Results.push(DAG.getZExtOrTrunc(VectorBits, DL, VT));
    }
}

fn CustomNonLegalBITCASTResults(N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG, ExtendVT: EVT, CastVT: EVT) {
    let mut DL: SDLoc = N;
    let mut Op: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut Vec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, ExtendVT, Op);
    let mut CastVal: SDValue = DAG.getNode(BITCAST, DL, CastVT, Vec);
    Results.push(DAG.getExtractSubvector(DL, VT, CastVal, 0));
}

fn AArch64TargetLowering::ReplaceBITCASTResults(self: *AArch64TargetLowering, N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) {
    let mut DL: SDLoc = N;
    let mut Op: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = Op.getValueType();
    if VT == v2i16 && SrcVT == i32 {
        CustomNonLegalBITCASTResults(N, Results, DAG, v2i32, v4i16);
        return;
    }
    if VT == v4i8 && SrcVT == i32 {
        CustomNonLegalBITCASTResults(N, Results, DAG, v2i32, v8i8);
        return;
    }
    if VT == v2i8 && SrcVT == i16 {
        CustomNonLegalBITCASTResults(N, Results, DAG, v4i16, v8i8);
        return;
    }
    if VT.isScalableVector() && !self.isTypeLegal(VT) && self.isTypeLegal(SrcVT) {
        assert!(!VT.isFloatingPoint() && SrcVT.isFloatingPoint(), "Expected fp->int bitcast!");
        if VT.getVectorElementCount() != SrcVT.getVectorElementCount() {
            return;
        }
        let mut CastResult: SDValue = self.getSVESafeBitCast(getSVEContainerType(VT), Op, DAG);
        Results.push(DAG.getNode(TRUNCATE, DL, VT, CastResult));
        return;
    }
    if SrcVT.isVectorOf(i1) && !VT.isVector() {
        return replaceBoolVectorBitcast(N, Results, DAG);
    }
    if VT != i16 || (SrcVT != f16 && SrcVT != bf16) {
        return;
    }
    Op = DAG.getTargetInsertSubreg;
    Op = DAG.getNode(BITCAST, DL, i32, Op);
    Results.push(DAG.getNode(TRUNCATE, DL, i16, Op));
}

fn ReplaceAddWithADDP(N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) {
    let mut VT: EVT = N.getValueType(0);
    if !VT.is256BitVector() || (VT.getScalarType().isFloatingPoint() && !N.getFlags().hasAllowReassociation()) || (VT.getScalarType() == f16 && operator!(Subtarget()())) || VT.getScalarType() == bf16 {
        return;
    }
    let mut X: SDValue = N.getOperand(0);
    let mut Shuf: *mut auto = dyn_cast(N.getOperand(1));
    if operator!() {
        Shuf() = dyn_cast(N.getOperand(0));
        X = N.getOperand(1);
        if operator!() {
            return;
        }
    }
    if Shuf()(0) != X || operator!((1)()) {
        return;
    }
    let mut Mask: ArrayRef<int> = ();
    for let mut I: i32 = 0;
let mut E: i32 = Mask.len; I < E; I += 1 {
        if Mask[I] != (if I % 2 == 0 { I + 1 } else { I - 1 }) {
            return;
        }
    }
    let mut DL: SDLoc = N;
    let mut LoHi: pair<SDValue, SDValue> = DAG.SplitVector(X, DL);
    assert!(LoHi.first.getValueType() == LoHi.second.getValueType();
    let mut Addp: SDValue = DAG;
    let mut NMask: i32 = 0;
    for let mut I: u32 = 0;
let mut E: u32 = VT.getVectorNumElements() / 2; I < E; I += 1 {
        NMask()(I);
        NMask()(I);
    }
    Results.push_back(DAG.getVectorShuffle(VT, DL, DAG.getNode(CONCAT_VECTORS, DL, VT, Addp, DAG.getPOISON(LoHi.first.getValueType())), DAG.getPOISON(VT)));
}

fn ReplaceReductionResults(N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG, InterOp: u32, AcrossOp: u32) {
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut DL: SDLoc = N;
    tie(LoVT, HiVT) = DAG.GetSplitDestVTs(N.getValueType(0));
    tie(Lo, Hi) = DAG.SplitVectorOperand(N, 0);
    let mut InterVal: SDValue = DAG.getNode(InterOp, DL, LoVT, Lo, Hi);
    let mut SplitVal: SDValue = DAG.getNode(AcrossOp, DL, LoVT, InterVal);
    Results.push(SplitVal);
}

fn AArch64TargetLowering::ReplaceExtractSubVectorResults(self: *AArch64TargetLowering, N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) {
    let mut In: SDValue = N.getOperand(0);
    let mut InVT: EVT = In.getValueType();
    if !InVT.isScalableVector() || !InVT.isInteger() {
        return;
    }
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    if VT.isFixedLengthVectorOf(i1) {
        let mut NewEltVT: EVT = EVT {};
        match VT.getVectorMinNumElements() {
            2 => {
                NewEltVT = i32;
            },
            4 => {
                NewEltVT = i16;
            },
            _ => {
                NewEltVT = i8;
            },
        }
        let mut NewInVT: EVT = InVT.changeVectorElementType(*DAG.getContext(), NewEltVT);
        let mut NewVT: EVT = VT.changeVectorElementType(*DAG.getContext(), NewEltVT);
        let mut ExtendedIn: SDValue = DAG.getNode(ANY_EXTEND, DL, NewInVT, In);
        let mut SubVec: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, NewVT, ExtendedIn, N.getOperand(1));
        Results.push(DAG.getNode(TRUNCATE, DL, VT, SubVec));
        return;
    }
    let mut ResEC: ElementCount = VT.getVectorElementCount();
    if InVT.getVectorElementCount() != (ResEC * 2) {
        return;
    }
    let mut CIndex: *mut auto = dyn_cast(N.getOperand(1));
    if operator!() {
        return;
    }
    let mut Index: u32 = ();
    if (Index != 0) && (Index != ResEC.getKnownMinValue()) {
        return;
    }
    let mut Opcode: u32 = 0;
    let mut ExtendedHalfVT: EVT = VT.widenIntegerVectorElementType(*DAG.getContext());
    let mut Half: SDValue = DAG.getNode(Opcode, DL, ExtendedHalfVT, N.getOperand(0));
    Results.push(DAG.getNode(TRUNCATE, DL, VT, Half));
}

fn AArch64TargetLowering::ReplaceGetActiveLaneMaskResults(self: *AArch64TargetLowering, N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) {
    (((operator!(operator!(((self.Subtarget.isSVEorStreamingSVEAvailable() && (self.Subtarget() || self.Subtarget())) && "Custom lower of get.active.lane.mask missing required feature.")))) || (_wassert(L"(Subtarget->isSVEorStreamingSVEAvailable() && (Subtarget->hasSVE2p1() || Subtarget->hasSME2())) && \"Custom lower of get.active.lane.mask missing required feature.\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (32578) as u32) , 0)) as void);
    assert!(N.getValueType(0) == nxv32i1, "Unexpected result type for get.active.lane.mask");
    let mut DL: SDLoc = N;
    let mut Idx: SDValue = N.getOperand(0);
    let mut TC: SDValue = N.getOperand(1);
    assert!(Idx.getValueType().getFixedSizeInBits() <= 64, "Unexpected operand type for get.active.lane.mask");
    if Idx.getValueType() != i64 {
        Idx = DAG.getNode(ZERO_EXTEND, DL, i64, Idx);
        TC = DAG.getNode(ZERO_EXTEND, DL, i64, TC);
    }
    let mut ID: SDValue = DAG;
    let mut HalfVT: EVT = N.getValueType(0).getHalfNumVectorElementsVT(*DAG.getContext());
    let mut WideMask: auto = DAG.getNode(INTRINSIC_WO_CHAIN, DL, [HalfVT, HalfVT], [ID, Idx, TC]);
    Results.push_back(DAG(CONCAT_VECTORS, DL, N.getValueType(0), void { (0), (1) }));
}

fn createGPRPairNode(DAG: *mut SelectionDAG, V: SDValue) -> SDValue {
    let mut DL: SDLoc = V.getNode();
    if DAG.getDataLayout().isBigEndian() {
        swap(VLo, VHi);
    }
    let mut RegClass: SDValue = DAG;
    let mut SubReg0: SDValue = DAG;
    let mut SubReg1: SDValue = DAG;
    let mut Ops: [5]SDValue = [RegClass, VLo, SubReg0, VHi, SubReg1];
    return SDValue { Node: DAG, ResNo: 0 };
}

fn ReplaceCMP_SWAP_128Results(N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) {
    assert!(N.getValueType(0) == i128, "AtomicCmpSwap on types less than 128 should be legal");
    let mut MemOp: *mut MachineMemOperand = cast(N)();
    if Subtarget()() || Subtarget()() {
        let mut Ops: [4]SDValue = [createGPRPairNode(DAG, N.getOperand(2)), createGPRPairNode(DAG, N.getOperand(3)), N.getOperand(1), N.getOperand(0)];
        let mut Opcode: u32 = 0;
        match MemOp.getMergedOrdering() {
            Monotonic => {
                
            },
            Acquire => {
                
            },
            Release => {
                
            },
            AcquireRelease => {
                SequentiallyConsistent;
            },
            _ => {
                llvm_unreachable_internal("Unexpected ordering!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 32654);
            },
        }
        let mut CmpSwap: *mut MachineSDNode = DAG;
        DAG.setNodeMemRefs(CmpSwap, [MemOp]);
        let mut SubReg1: u32 = 0;
        let mut SubReg2: u32 = 0;
        if DAG.getDataLayout().isBigEndian() {
            swap(SubReg1, SubReg2);
        }
        let mut Lo: SDValue = DAG.getTargetExtractSubreg(SubReg1, N, i64, SDValue { Node: CmpSwap, ResNo: 0 });
        let mut Hi: SDValue = DAG.getTargetExtractSubreg(SubReg2, N, i64, SDValue { Node: CmpSwap, ResNo: 0 });
        Results.push(DAG.getNode(BUILD_PAIR, N, i128, Lo, Hi));
        Results.push(SDValue { Node: CmpSwap, ResNo: 1 });
        return;
    }
    let mut Opcode: u32 = 0;
    match MemOp.getMergedOrdering() {
        Monotonic => {
            
        },
        Acquire => {
            
        },
        Release => {
            
        },
        AcquireRelease => {
            SequentiallyConsistent;
        },
        _ => {
            llvm_unreachable_internal("Unexpected ordering!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 32690);
        },
    }
    let mut DL: SDLoc = N;
    let mut Desired: pair<SDValue, SDValue> = DAG.SplitScalar(N.getOperand(2), DL, i64, i64);
    let mut New: pair<SDValue, SDValue> = DAG.SplitScalar(N.getOperand(3), DL, i64, i64);
    let mut Ops: [6]SDValue = [N.getOperand(1), Desired.first, Desired.second, New.first, New.second, N.getOperand(0)];
    let mut CmpSwap: *mut SDNode = DAG;
    DAG.setNodeMemRefs(cast(CmpSwap), void { MemOp });
    Results.push(DAG.getNode(BUILD_PAIR, DL, i128, SDValue { Node: CmpSwap, ResNo: 0 }, SDValue { Node: CmpSwap, ResNo: 1 }));
    Results.push(SDValue { Node: CmpSwap, ResNo: 3 });
}

fn getAtomicLoad128Opcode(ISDOpcode: u32, Ordering: AtomicOrdering) -> u32 {
    assert!(ISDOpcode != ATOMIC_LOAD_CLR, "ATOMIC_LOAD_AND should be lowered to LDCLRP directly");
    assert!(ISDOpcode != ATOMIC_LOAD_ADD, "There is no 128 bit LDADD");
    assert!(ISDOpcode != ATOMIC_LOAD_SUB, "There is no 128 bit LDSUB");
    if ISDOpcode == ATOMIC_LOAD_AND {
        match Ordering {
            Monotonic => {
                
            },
            Acquire => {
                
            },
            Release => {
                
            },
            AcquireRelease => {
                SequentiallyConsistent;
            },
            _ => {
                llvm_unreachable_internal("Unexpected ordering!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 32736);
            },
        }
    }
    if ISDOpcode == ATOMIC_LOAD_OR {
        match Ordering {
            Monotonic => {
                
            },
            Acquire => {
                
            },
            Release => {
                
            },
            AcquireRelease => {
                SequentiallyConsistent;
            },
            _ => {
                llvm_unreachable_internal("Unexpected ordering!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 32756);
            },
        }
    }
    if ISDOpcode == ATOMIC_SWAP {
        match Ordering {
            Monotonic => {
                
            },
            Acquire => {
                
            },
            Release => {
                
            },
            AcquireRelease => {
                SequentiallyConsistent;
            },
            _ => {
                llvm_unreachable_internal("Unexpected ordering!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 32776);
            },
        }
    }
    llvm_unreachable_internal("Unexpected ISDOpcode!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 32780);
}

fn ReplaceATOMIC_LOAD_128Results(N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) {
    assert!(N.getValueType(0) == i128, "AtomicLoadXXX on types less than 128 should be legal");
    if operator!(Subtarget()()) {
        return;
    }
    let mut MemOp: *mut MachineMemOperand = cast(N)();
    let mut Chain: *SDValue = N.getOperand(0);
    let mut Ptr: *SDValue = N.getOperand(1);
    let mut Val128: *SDValue = N.getOperand(2);
    let mut Val2x64: pair<SDValue, SDValue> = DAG.SplitScalar(Val128, Val128, i64, i64);
    let mut ISDOpcode: u32 = N.getOpcode();
    let mut MachineOpcode: u32 = getAtomicLoad128Opcode(ISDOpcode, MemOp.getMergedOrdering());
    if ISDOpcode == ATOMIC_LOAD_AND {
        let mut DL: SDLoc = Val128;
        Val2x64.first = DAG.getNode(XOR, DL, i64, DAG.getAllOnesConstant(DL, i64, false, false), Val2x64.first);
        Val2x64.second = DAG.getNode(XOR, DL, i64, DAG.getAllOnesConstant(DL, i64, false, false), Val2x64.second);
    }
    let mut Ops: [4]SDValue = [Val2x64.first, Val2x64.second, Ptr, Chain];
    if DAG.getDataLayout().isBigEndian() {
        swap(Ops[0], Ops[1]);
    }
    let mut AtomicInst: *mut MachineSDNode = DAG;
    DAG.setNodeMemRefs(AtomicInst, [MemOp]);
    let mut Lo: SDValue = SDValue { Node: AtomicInst, ResNo: 0 };
    let mut Hi: SDValue = SDValue { Node: AtomicInst, ResNo: 1 };
    if DAG.getDataLayout().isBigEndian() {
        swap(Lo, Hi);
    }
    Results.push(DAG.getNode(BUILD_PAIR, N, i128, Lo, Hi));
    Results.push(SDValue { Node: AtomicInst, ResNo: 2 });
}

fn AArch64TargetLowering::ReplaceNodeResults(self: *AArch64TargetLowering, N: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) {
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("Don't know how to custom expand this", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 32844);
        },
        BITCAST => {
            self.ReplaceBITCASTResults(N, Results, DAG);
        },
        VECREDUCE_ADD => {
            VECREDUCE_SMAX;
        },
        ADD => {
            FADD;
        },
        CLMUL => {
            if self.LowerCLMUL(SDValue { Node: N, ResNo: 0 }, DAG) {
                Result;
            } else {
                Results.push(Result);
            }
        },
        CTPOP => {
            PARITY;
        },
        MULHS => {
            if self.useSVEForFixedLengthVectorVT(SDValue { Node: N, ResNo: 0 }.getValueType(), false) {
                Results.push_back(self.LowerToPredicatedOp);
            }
        },
        MULHU => {
            if self.useSVEForFixedLengthVectorVT(SDValue { Node: N, ResNo: 0 }.getValueType(), false) {
                Results.push_back(self.LowerToPredicatedOp);
            }
        },
        FP_TO_UINT => {
            FP_TO_SINT;
        },
        ATOMIC_CMP_SWAP => {
            ReplaceCMP_SWAP_128Results(N, Results, DAG, self.Subtarget);
        },
        ATOMIC_LOAD_CLR => {
            assert!(N.getValueType(0) != i128, "128-bit ATOMIC_LOAD_AND should be lowered directly to LDCLRP");
        },
        ATOMIC_LOAD_AND => {
            ATOMIC_LOAD_OR;
        },
        ADDRSPACECAST => {
            let mut V: SDValue = LowerADDRSPACECAST(SDValue { Node: N, ResNo: 0 }, DAG);
            Results.push(V);
            return;
        },
        ATOMIC_LOAD => {
            LOAD;
        },
        EXTRACT_SUBVECTOR => {
            self.ReplaceExtractSubVectorResults(N, Results, DAG);
        },
        INSERT_SUBVECTOR => {
            CONCAT_VECTORS;
        },
        GET_ACTIVE_LANE_MASK => {
            self.ReplaceGetActiveLaneMaskResults(N, Results, DAG);
        },
        VECTOR_MATCH => {
            let mut VT: EVT = N.getValueType(0);
            if !VT.isFixedLengthVectorOf(i1) {
                return;
            }
            let mut NewVT: EVT = self.getTypeToTransformTo(*DAG.getContext(), VT);
            if NewVT.getVectorNumElements() != VT.getVectorNumElements() {
                return;
            }
            let mut DL: SDLoc = N;
            let mut V: SDValue = DAG.getNode(VECTOR_MATCH, DL, NewVT, N.ops());
            Results.push(DAG.getNode(TRUNCATE, DL, VT, V));
            return;
        },
        INTRINSIC_WO_CHAIN => {
            let mut VT: EVT = N.getValueType(0);
            let mut IntID: ID = N.getConstantOperandVal(0) as ID;
            match IntID {
                _ => {
                    return;
                },
            }
        },
        READ_REGISTER => {
            let mut DL: SDLoc = N;
            assert!(N.getValueType(0) == i128, "READ_REGISTER custom lowering is only for 128-bit sysregs");
            let mut Chain: SDValue = N.getOperand(0);
            let mut SysRegName: SDValue = N.getOperand(1);
            let mut Result: SDValue = DAG;
            let mut Pair: SDValue = DAG.getNode(BUILD_PAIR, DL, i128, Result.getValue(0), Result.getValue(1));
            Results.push(Pair);
            Results.push(Result.getValue(2));
            return;
        },
    }
}

fn AArch64TargetLowering::useLoadStackGuardNode(self: *AArch64TargetLowering, M: *Module) -> bool {
    if self.Subtarget.isTargetAndroid() || self.Subtarget.isTargetFuchsia() {
        return self.useLoadStackGuardNode(M);
    }
    return true;
}

fn AArch64TargetLowering::useStackGuardMixFP(self: *AArch64TargetLowering) -> bool {
    return self.Subtarget.getTargetTriple().isOSMSVCRT();
}

fn AArch64TargetLowering::emitStackGuardMixFP(self: *AArch64TargetLowering, DAG: *mut SelectionDAG, Val: SDValue, DL: *SDLoc) -> SDValue {
    return DAG(SUB, DL, Val.getValueType(), DAG, Val);
}

fn AArch64TargetLowering::combineRepeatedFPDivisors(self: *AArch64TargetLowering) -> u32 {
    return if self.Subtarget() { 2 } else { 3 };
}

fn AArch64TargetLowering::getPreferredVectorAction(self: *AArch64TargetLowering, VT: MVT) -> LegalizeTypeAction {
    if VT == v1i8 || VT == v1i16 || VT == v1i32 || VT == v1f32 {
        return TypeWidenVector;
    }
    return self.getPreferredVectorAction(VT);
}

fn AArch64TargetLowering::isOpSuitableForLDPSTP(self: *AArch64TargetLowering, I: *Instruction) -> bool {
    if operator!(self.Subtarget()) {
        return false;
    }
    if  {
        return ()() == 128 && () >= 16;
    }
    if  {
        return ()()() == 128 && () >= 16;
    }
    return false;
}

fn AArch64TargetLowering::isOpSuitableForLSE128(self: *AArch64TargetLowering, I: *Instruction) -> bool {
    if operator!(self.Subtarget()) {
        return false;
    }
    if  {
        return ()()() == 128 && () >= 16 && (SI()() == Release || () == SequentiallyConsistent);
    }
    if  {
        return ()()() == 128 && () >= 16 && (RMW()() == Xchg || () == And || () == Or);
    }
    return false;
}

fn AArch64TargetLowering::isOpSuitableForRCPC3(self: *AArch64TargetLowering, I: *Instruction) -> bool {
    if operator!(self.Subtarget()) || operator!(self.Subtarget()) {
        return false;
    }
    if  {
        return ()() == 128 && () >= 16 && () == Acquire;
    }
    if  {
        return ()()() == 128 && () >= 16 && () == Release;
    }
    return false;
}

fn AArch64TargetLowering::shouldInsertFencesForAtomic(self: *AArch64TargetLowering, I: *Instruction) -> bool {
    if self.isOpSuitableForRCPC3(I) {
        return false;
    }
    if self.isOpSuitableForLSE128(I) {
        return false;
    }
    if self.isOpSuitableForLDPSTP(I) {
        return true;
    }
    return false;
}

fn AArch64TargetLowering::shouldInsertTrailingSeqCstFenceForAtomicStore(self: *AArch64TargetLowering, I: *Instruction) -> bool {
    if !self.Subtarget.getTargetTriple().isWindowsMSVCEnvironment() {
        return false;
    }
    if  {
        return () == SequentiallyConsistent;
    }
    let mut CAS: *mut auto = dyn_cast(I);
    let mut RMW: *mut auto = dyn_cast(I);
    if operator!() && operator!() {
        return false;
    }
    if CAS() && () != SequentiallyConsistent {
        return false;
    }
    if RMW() && () != SequentiallyConsistent {
        return false;
    }
    return operator!(self.Subtarget());
}

fn AArch64TargetLowering::emitLeadingFence(self: *AArch64TargetLowering, Builder: *mut IRBuilderBase, Inst: *mut Instruction, Ord: AtomicOrdering) -> *mut Instruction {
    let mut LI: *mut auto = dyn_cast(Inst);
    if LI() && Ord == SequentiallyConsistent && self.isOpSuitableForLDPSTP() {
        let mut LDAR: *mut auto = Builder(getInt64Ty());
        LDAR()(SequentiallyConsistent);
        return ;
    }
    return self.emitLeadingFence(Builder, Inst, Ord);
}

fn AArch64TargetLowering::shouldExpandAtomicStoreInIR(self: *AArch64TargetLowering, SI: *mut StoreInst) -> AtomicExpansionKind {
    let mut Size: u32 = SI.getValueOperand().getType().getPrimitiveSizeInBits().operator unsigned long long();
    if Size != 128 {
        return None;
    }
    if self.isOpSuitableForRCPC3(SI) {
        return None;
    }
    if self.isOpSuitableForLSE128(SI) {
        return Expand;
    }
    if self.isOpSuitableForLDPSTP(SI) {
        return None;
    }
    return Expand;
}

fn AArch64TargetLowering::shouldExpandAtomicLoadInIR(self: *AArch64TargetLowering, LI: *mut LoadInst) -> AtomicExpansionKind {
    let mut Size: u32 = LI.getType().getPrimitiveSizeInBits().operator unsigned long long();
    if Size != 128 {
        return None;
    }
    if self.isOpSuitableForRCPC3(LI) {
        return None;
    }
    if self.isOpSuitableForLDPSTP(LI) {
        return None;
    }
    if self.getTargetMachine().getOptLevel() == None {
        return CmpXChg;
    }
    return if self.Subtarget() { CmpXChg } else { LLSC };
}

fn rmwOpMayLowerToLibcall(Subtarget: *AArch64Subtarget, RMW: *AtomicRMWInst) -> bool {
    if !RMW.isFloatingPointOperation() {
        return false;
    }
    match RMW.getType().getScalarType().getTypeID() {
        FloatTyID => {
            DoubleTyID;
        },
        _ => {
            return true;
        },
    }
    llvm_unreachable_internal("covered type switch", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 33316);
}

fn AArch64TargetLowering::shouldExpandAtomicRMWInIR(self: *AArch64TargetLowering, AI: *AtomicRMWInst) -> AtomicExpansionKind {
    let mut Ty: *mut Type = AI.getType();
    let mut Size: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    assert!(Size <= 128, "AtomicExpandPass should've handled larger sizes.");
    let mut CanUseLSE128: bool = self.Subtarget() && Size == 128 && (AI.getOperation() == Xchg || AI.getOperation() == Or || AI.getOperation() == And);
    if CanUseLSE128 {
        return None;
    }
    let mut F: *Function = *AI.getFunction();
    if self.Subtarget() && Size < 128 && !F.isStrictFP() && F.getFnAttribute("no-trapping-math").getValueAsBool() && (AI.getOperation() == FAdd || AI.getOperation() == FSub || AI.getOperation() == FMax || AI.getOperation() == FMin || AI.getOperation() == FMaximum || AI.getOperation() == FMinimum) {
        return None;
    }
    if Size < 128 && !AI.isFloatingPointOperation() {
        if self.Subtarget() {
            match AI.getOperation() {
                Xchg => {
                    Add;
                },
                _ => {
                    break;
                },
            }
        }
        if self.Subtarget() {
            match AI.getOperation() {
                Xchg => {
                    Add;
                },
                _ => {
                    break;
                },
            }
        }
    }
    if self.getTargetMachine().getOptLevel() == None || self.Subtarget() || rmwOpMayLowerToLibcall(*self.Subtarget, AI) {
        return CmpXChg;
    }
    return LLSC;
}

fn AArch64TargetLowering::shouldExpandAtomicCmpXchgInIR(self: *AArch64TargetLowering, AI: *AtomicCmpXchgInst) -> AtomicExpansionKind {
    if self.Subtarget() || self.Subtarget() {
        return None;
    }
    if self.getTargetMachine().getOptLevel() == None {
        return None;
    }
    let mut Size: u32 = AI.getCompareOperand().getType().getPrimitiveSizeInBits().operator unsigned long long();
    if Size > 64 {
        return None;
    }
    return LLSC;
}

fn AArch64TargetLowering::emitLoadLinked(self: *AArch64TargetLowering, Builder: *mut IRBuilderBase, ValueTy: *mut Type, Addr: *mut Value, Ord: AtomicOrdering) -> *mut Value {
    let mut M: *mut Module = Builder.GetInsertBlock().getParent().getParent();
    let mut IsAcquire: bool = isAcquireOrStronger(Ord);
    if ValueTy.getPrimitiveSizeInBits().operator unsigned long long() == 128 {
        let mut Int: ID = zeroed();
        let mut LoHi: *mut Value = Builder.CreateIntrinsic(Int, Addr, null, "lohi", Closure_76 {});
        let mut LoPos: u32 = if self.Subtarget.isLittleEndian() { 0 } else { 1 };
        let mut Lo: *mut Value = Builder.CreateExtractValue(LoHi, LoPos, "lo");
        let mut Hi: *mut Value = Builder.CreateExtractValue(LoHi, 1 - LoPos, "hi");
        let mut Int128Ty: *mut IntegerType = getInt128Ty(Builder.getContext());
        Lo = Builder.CreateZExt(Lo, Int128Ty, "lo64", false);
        Hi = Builder.CreateZExt(Hi, Int128Ty, "hi64", false);
        let mut Or: *mut Value = Builder.CreateOr(Lo, Builder.CreateShl(Hi, get(Int128Ty, 64, false, false), "", false, false), "val64", false);
        return Builder.CreateBitCast(Or, ValueTy, "");
    }
    let mut Tys: [1]*mut Type = [Addr.getType()];
    let mut Int: ID = zeroed();
    let mut DL: *DataLayout = M.getDataLayout();
    let mut IntEltTy: *mut IntegerType = Builder.getIntNTy(DL.getTypeSizeInBits(ValueTy).operator unsigned long long());
    let mut CI: *mut CallInst = Builder;
    CI.addParamAttr(0, get(Builder.getContext(), ElementType, IntEltTy));
    let mut Trunc: *mut Value = Builder.CreateTrunc(CI, IntEltTy, "", false, false);
    return Builder.CreateBitCast(Trunc, ValueTy, "");
}

fn AArch64TargetLowering::emitAtomicCmpXchgNoStoreLLBalance(self: *AArch64TargetLowering, Builder: *mut IRBuilderBase) {
    Builder;
}

fn AArch64TargetLowering::emitStoreConditional(self: *AArch64TargetLowering, Builder: *mut IRBuilderBase, Val: *mut Value, Addr: *mut Value, Ord: AtomicOrdering) -> *mut Value {
    let mut M: *mut Module = Builder.GetInsertBlock().getParent().getParent();
    let mut IsRelease: bool = isReleaseOrStronger(Ord);
    if Val.getType().getPrimitiveSizeInBits().operator unsigned long long() == 128 {
        let mut Int: ID = zeroed();
        let mut Stxr: *mut Function = getOrInsertDeclaration(M, Int, ArrayRef<Type *> {});
        let mut Int64Ty: *mut Type = getInt64Ty(M.getContext());
        let mut Int128Ty: *mut Type = getInt128Ty(M.getContext());
        let mut CastVal: *mut Value = Builder.CreateBitCast(Val, Int128Ty, "");
        let mut Lo: *mut Value = Builder.CreateTrunc(CastVal, Int64Ty, "lo", false, false);
        let mut Hi: *mut Value = Builder.CreateTrunc(Builder.CreateLShr(CastVal, 64, "", false), Int64Ty, "hi", false, false);
        if self.Subtarget.isLittleEndian() {
            return Builder;
        } else {
            return Builder;
        }
    }
    let mut Int: ID = zeroed();
    let mut Tys: [1]*mut Type = [Addr.getType()];
    let mut Stxr: *mut Function = getOrInsertDeclaration(M, Int, Tys);
    let mut DL: *DataLayout = M.getDataLayout();
    let mut IntValTy: *mut IntegerType = Builder.getIntNTy(DL.getTypeSizeInBits(Val.getType()).operator unsigned long long());
    Val = Builder.CreateBitCast(Val, IntValTy, "");
    let mut CI: *mut CallInst = Builder;
    CI.addParamAttr(1, get(Builder.getContext(), ElementType, Val.getType()));
    return CI;
}

fn AArch64TargetLowering::emitCanLoadSpeculatively(self: *AArch64TargetLowering, Builder: *mut IRBuilderBase, Ptr: *mut Value, SizeInBytes: *mut Value) -> *mut Value {
    if Ptr.getType().getPointerAddressSpace() != 0 {
        return null;
    }
    let mut MTETagGranuleInBytes: u64 = 16;
    if  {
        let mut Size: u64 = ();
        if !isPowerOf2_64(Size) || Size > MTETagGranuleInBytes {
            return null;
        }
        let mut PtrAddr: *mut Value = Builder.CreatePtrToAddr(Ptr, "");
        return Builder.CreateIsNull(Builder.CreateAnd(PtrAddr, Size - 1, ""), "");
    }
    let mut SizeLE16: *mut Value = Builder.CreateICmpULE(SizeInBytes, get(SizeInBytes.getType(), MTETagGranuleInBytes, false, false), "");
    let mut DL: *DataLayout = Builder.GetInsertBlock().getDataLayout();
    let mut AddrTy: *mut Type = DL.getAddressType(Ptr.getType());
    let mut SizeAddr: *mut Value = Builder.CreateZExtOrTrunc(SizeInBytes, AddrTy, "");
    let mut SizeMinusOne: *mut Value = Builder.CreateSub(SizeAddr, get(AddrTy, 1, false, false), "", false, false);
    let mut PtrAddr: *mut Value = Builder.CreatePtrToAddr(Ptr, "");
    let mut AlignCheck: *mut Value = Builder.CreateIsNull(Builder.CreateAnd(PtrAddr, SizeMinusOne, ""), "");
    return Builder.CreateAnd(SizeLE16, AlignCheck, "");
}

fn AArch64TargetLowering::functionArgumentNeedsConsecutiveRegisters(self: *AArch64TargetLowering, Ty: *mut Type, CallConv: ID, isVarArg: bool, DL: *DataLayout) -> bool {
    if !Ty.isArrayTy() {
        let mut TySize: *TypeSize = Ty.getPrimitiveSizeInBits();
        return TySize.isScalable() && TySize.getKnownMinValue() > 128;
    }
    let mut ValueVTs: i32 = 0;
    ComputeValueVTs(*self, DL, Ty);
    return all_equal();
}

fn AArch64TargetLowering::shouldNormalizeToSelectSequence(self: *AArch64TargetLowering, arg: *mut LLVMContext, arg: EVT, arg: EVT) -> bool {
    return false;
}

fn UseTlsOffset(IRB: *mut IRBuilderBase, Offset: u32) -> *mut Value {
    let mut M: *mut Module = IRB.GetInsertBlock().getParent().getParent();
    let mut ThreadPointerFunc: *mut Function = getOrInsertDeclaration(M, thread_pointer, IRB.getPtrTy(0));
    return IRB.CreatePointerCast(IRB.CreateConstGEP1_32(IRB.getInt8Ty(), IRB, Offset, ""), IRB.getPtrTy(0), "");
}

fn AArch64TargetLowering::getIRStackGuard(self: *AArch64TargetLowering, IRB: *mut IRBuilderBase, Libcalls: *LibcallLoweringInfo) -> *mut Value {
    if self.Subtarget.isTargetAndroid() {
        return UseTlsOffset(IRB, 40);
    }
    if self.Subtarget.isTargetFuchsia() {
        return UseTlsOffset(IRB, -16);
    }
    return self.getIRStackGuard(IRB, Libcalls);
}

fn AArch64TargetLowering::insertSSPDeclarations(self: *AArch64TargetLowering, M: *mut Module, Libcalls: *LibcallLoweringInfo) {
    let mut SecurityCheckCookieLibcall: LibcallImpl = Libcalls.getLibcallImpl(SECURITY_CHECK_COOKIE);
    let mut SecurityCookieVar: LibcallImpl = Libcalls.getLibcallImpl(STACK_CHECK_GUARD);
    if SecurityCheckCookieLibcall != Unsupported && SecurityCookieVar != Unsupported {
        M.getOrInsertGlobal(getLibcallImplName(SecurityCookieVar), getUnqual(M.getContext()));
        let mut SecurityCheckCookie: FunctionCallee = M;
        if dyn_cast(SecurityCheckCookie.getCallee()) {
            F;
        } else {
            F.setCallingConv(Win64);
            F.addParamAttr(0, InReg);
        }
        return;
    }
    self.insertSSPDeclarations(M, Libcalls);
}

fn AArch64TargetLowering::getSafeStackPointerLocation(self: *AArch64TargetLowering, IRB: *mut IRBuilderBase, Libcalls: *LibcallLoweringInfo) -> *mut Value {
    if self.Subtarget.isTargetAndroid() {
        return UseTlsOffset(IRB, 72);
    }
    return self.getSafeStackPointerLocation(IRB, Libcalls);
}

fn AArch64TargetLowering::getExceptionPointerRegister(self: *AArch64TargetLowering, EH: ExceptionHandling, PersonalityFn: *Constant) -> Register {}

fn AArch64TargetLowering::getExceptionSelectorRegister(self: *AArch64TargetLowering, EH: ExceptionHandling, PersonalityFn: *Constant) -> Register {}

fn AArch64TargetLowering::isMaskAndCmp0FoldingBeneficial(self: *AArch64TargetLowering, AndI: *Instruction) -> bool {
    let mut Mask: *mut ConstantInt = dyn_cast(AndI.getOperand(1));
    if !Mask {
        return false;
    }
    return Mask.getValue().isPowerOf2();
}

fn AArch64TargetLowering::shouldProduceAndByConstByHoistingConstFromShiftsLHSOfAnd(self: *AArch64TargetLowering, X: SDValue, XC: *mut ConstantSDNode, CC: *mut ConstantSDNode, Y: SDValue, OldShiftOpcode: u32, NewShiftOpcode: u32, DAG: *mut SelectionDAG) -> bool {
    if !self.shouldProduceAndByConstByHoistingConstFromShiftsLHSOfAnd(X, XC, CC, Y, OldShiftOpcode, NewShiftOpcode, DAG) {
        return false;
    }
    return X.getValueType().isScalarInteger() || NewShiftOpcode == SHL;
}

fn AArch64TargetLowering::getJumpConditionMergingParams(self: *AArch64TargetLowering, Opc: BinaryOps, Lhs: *Value, Rhs: *Value, arg: *Function) -> CondMergingParams {
    if isa(Lhs) || isa(Rhs) {
        return CondMergingParams { -1, -1, -1 };
    }
    let mut IsCbzTbnzCandidate: Closure_77 = Closure_77 {};
    let mut ComparesLoadedValue: Closure_78 = Closure_78 {};
    if ComparesLoadedValue.call(Lhs) && ComparesLoadedValue.call(Rhs) {
        return CondMergingParams { -1, -1, -1 };
    }
    let mut BaseCost: i32 = ();
    if BaseCost >= 0 {
        operator+=(BaseCost);
    }
    if BaseCost >= 0 &&  > 0 {
        let mut LhsIsFusedBranch: bool = IsCbzTbnzCandidate.call(Lhs);
        let mut RhsIsFusedBranch: bool = IsCbzTbnzCandidate.call(Rhs);
        if LhsIsFusedBranch && RhsIsFusedBranch {
            return CondMergingParams { -1, -1, -1 };
        }
        if LhsIsFusedBranch || RhsIsFusedBranch {
            BaseCost -= ;
        }
    }
    return void { BaseCost, () };
}

fn AArch64TargetLowering::preferredShiftLegalizationStrategy(self: *AArch64TargetLowering, DAG: *mut SelectionDAG, N: *mut SDNode, ExpansionFactor: u32) -> ShiftLegalizationStrategy {
    if DAG.getMachineFunction().getFunction().hasMinSize() && !self.Subtarget.isTargetWindows() && !self.Subtarget.isTargetDarwin() {
        return LowerToLibcall;
    }
    return self.preferredShiftLegalizationStrategy(DAG, N, ExpansionFactor);
}

fn AArch64TargetLowering::initializeSplitCSR(self: *AArch64TargetLowering, Entry: *mut MachineBasicBlock) {
    let mut AFI: *mut AArch64FunctionInfo = Entry.getParent();
    AFI.setIsSplitCSR(true);
}

fn AArch64TargetLowering::insertCopiesSplitCSR(self: *AArch64TargetLowering, Entry: *mut MachineBasicBlock, Exits: *SmallVectorImpl<MachineBasicBlock *>) {
    let mut TRI: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut IStart: *MCPhysReg = TRI.getCalleeSavedRegsViaCopy(Entry.getParent());
    if !IStart {
        return;
    }
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MRI: *mut MachineRegisterInfo = &mut Entry.getParent().getRegInfo();
    let mut MBBI: iterator = Entry.begin();
    for let mut I: *MCPhysReg = IStart; *I; I += 1 {
        let mut RC: *TargetRegisterClass = null;
        if  {
            
        } else if  {
            
        } else {
            llvm_unreachable_internal("Unexpected register class in CSRsViaCopy!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 33827);
        }
        let mut NewVR: Register = MRI.createVirtualRegister(RC, "");
        assert!(Entry.getParent().getFunction().hasFnAttribute(NoUnwind), "Function should be nounwind in insertCopiesSplitCSR!");
        Entry.addLiveIn(*I, getAll());
        BuildMI(*Entry, MBBI, DebugLoc { Loc: null }, TII.get, NewVR)(*I);
        for Exit in Exits {
            BuildMI(*Exit, Exit.getFirstTerminator(), DebugLoc { Loc: null }, TII.get, *I)(NewVR);
        }
    }
}

fn AArch64TargetLowering::isIntDivCheap(self: *AArch64TargetLowering, VT: EVT, Attr: AttributeList) -> bool {
    let mut OptSize: bool = Attr.hasFnAttr(MinSize);
    return OptSize && !VT.isVector();
}

fn AArch64TargetLowering::canMergeStoresTo(self: *AArch64TargetLowering, AddressSpace: u32, MemVT: EVT, MF: *MachineFunction) -> bool {
    if MemVT.isFixedLengthVector() && !self.Subtarget.isNeonAvailable() {
        return false;
    }
    let mut NoFloat: bool = MF.getFunction().hasFnAttribute(NoImplicitFloat);
    return !NoFloat || MemVT.getSizeInBits().operator unsigned long long() <= 64;
}

fn AArch64TargetLowering::preferIncOfAddToSubOfNot(self: *AArch64TargetLowering, VT: EVT) -> bool {
    return VT.isScalarInteger();
}

fn AArch64TargetLowering::shouldConvertFpToSat(self: *AArch64TargetLowering, Op: u32, FPVT: EVT, VT: EVT) -> bool {
    if FPVT == v8f16 && operator!(self.Subtarget()) {
        return false;
    }
    if FPVT == v8bf16 {
        return false;
    }
    return self.shouldConvertFpToSat(Op, FPVT, VT);
}

fn AArch64TargetLowering::preferSelectsOverBooleanArithmetic(self: *AArch64TargetLowering, VT: EVT) -> bool {
    return !VT.isFixedLengthVector();
}

fn AArch64TargetLowering::EmitKCFICheck(self: *AArch64TargetLowering, MBB: *mut MachineBasicBlock, MBBI: *mut instr_iterator, TII: *TargetInstrInfo) -> *mut MachineInstr {
    assert!(operator(MBBI).isCall(AnyInBundle) && operator(MBBI).getCFIType(), "Invalid call instruction for a KCFI check");
    match operator(MBBI).getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected CFI call opcode", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 33915);
        },
    }
    let mut Target: *mut MachineOperand = operator(MBBI).getOperand(0);
    assert!(Target.isReg(), "Invalid target operand for an indirect call");
    Target.setIsRenamable(false);
    return BuildMI(MBB, MBBI, operator(MBBI).getDebugLoc(), TII.get)(Target.getReg())(operator(MBBI).getCFIType())();
}

fn AArch64TargetLowering::shallExtractConstSplatVectorElementToStore(self: *AArch64TargetLowering, VectorTy: *mut Type, ElemSizeInBits: u32, Index: *mut u32) -> bool {
    if dyn_cast(VectorTy) {
        VTy;
    } else {
        if (VTy.getNumElements() == 16 || VTy.getNumElements() == 8) && VTy.getElementType().isIntegerTy(8) {
            if ElemSizeInBits == 8 || ElemSizeInBits == 16 || ElemSizeInBits == 32 || ElemSizeInBits == 64 {
                Index = 0;
                return true;
            }
        }
    }
    return false;
}

fn AArch64TargetLowering::enableAggressiveFMAFusion(self: *AArch64TargetLowering, VT: EVT) -> bool {
    return self.Subtarget() && VT.isFloatingPoint();
}

fn AArch64TargetLowering::getVaListSizeInBits(self: *AArch64TargetLowering, DL: *DataLayout) -> u32 {
    if self.Subtarget.isTargetDarwin() || self.Subtarget.isTargetWindows() {
        return self.getPointerTy(DL, 0).getSizeInBits().operator unsigned long long();
    }
    return 3 * self.getPointerTy(DL, 0).getSizeInBits().operator unsigned long long() + 2 * 32;
}

fn AArch64TargetLowering::finalizeLowering(self: *AArch64TargetLowering, MF: *mut MachineFunction) {
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    if MFI.hasStackProtectorIndex() {
        for let mut i: u32 = 0;
let mut e: u32 = MFI.getObjectIndexEnd(); i != e; i += 1 {
            if MFI.hasScalableStackID(i) && MFI.getObjectSSPLayout(i) != SSPLK_None {
                MFI.setStackID(MFI.getStackProtectorIndex(), ScalableVector);
                MFI.setObjectAlignment(MFI.getStackProtectorIndex(), 16);
                break;
            }
        }
    }
    MFI()(MF);
    self.finalizeLowering(MF);
}

fn AArch64TargetLowering::needsFixedCatchObjects(self: *AArch64TargetLowering) -> bool {
    return true;
}

fn AArch64TargetLowering::shouldLocalize(self: *AArch64TargetLowering, MI: *MachineInstr, TTI: *TargetTransformInfo) -> bool {
    let mut MF: *MachineFunction = *MI.getMF();
    let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
    let mut maxUses: Closure_79 = Closure_79 {};
    let mut Opc: u32 = MI.getOpcode();
    match Opc {
        G_GLOBAL_VALUE => {
            let mut GV: *GlobalValue = *MI.getOperand(1).getGlobal();
            if GV.isThreadLocal() && (self.Subtarget.isTargetMachO() || self.Subtarget.isTargetELF()) {
                return false;
            }
            return true;
        },
        G_FCONSTANT => {
            G_CONSTANT;
        },
        G_PTR_ADD => {
            return true;
        },
        _ => {
            break;
        },
    }
    return self.shouldLocalize(MI, TTI);
}

fn AArch64TargetLowering::fallBackToDAGISel(self: *AArch64TargetLowering, Inst: *Instruction) -> bool {
    if operator!() {
        if Inst.getType().isScalableTy() {
            return true;
        }
        for let mut i: u32 = 0; i < Inst.getNumOperands(); i += 1 {
            if Inst.getOperand(i).getType().isScalableTy() {
                return true;
            }
        }
        if dyn_cast(&mut Inst) {
            AI;
        } else {
            if AI.isScalable() {
                return true;
            }
        }
    }
    if  {
        let mut Caller: *Function = ();
        if self.Subtarget() || Caller.hasFnAttribute("aarch64_pstate_sm_compatible") || Caller.hasFnAttribute("aarch64_za_state_agnostic") {
            let mut CallAttrs: auto = operator*();
            if CallAttrs()() || () || () {
                return true;
            }
        }
    }
    if  {
        if Store()() && getMemCacheHintMetadata(operator*(), 1) {
            return true;
        }
    }
    return false;
}

fn getContainerForFixedLengthVector(DAG: *mut SelectionDAG, VT: EVT) -> EVT {
    assert!(VT.isFixedLengthVector() && DAG.getTargetLoweringInfo().isTypeLegal(VT), "Expected legal fixed length vector!");
    match VT.getVectorElementType().getSimpleVT().SimpleTy {
        _ => {
            llvm_unreachable_internal("unexpected element type for SVE container", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 34121);
        },
        i8 => {
            return nxv16i8;
        },
        i16 => {
            return nxv8i16;
        },
        i32 => {
            return nxv4i32;
        },
        i64 => {
            return nxv2i64;
        },
        bf16 => {
            return nxv8bf16;
        },
        f16 => {
            return nxv8f16;
        },
        f32 => {
            return nxv4f32;
        },
        f64 => {
            return nxv2f64;
        },
    }
}

fn getPredicateForFixedLengthVector(DAG: *mut SelectionDAG, DL: *mut SDLoc, VT: EVT) -> SDValue {
    assert!(VT.isFixedLengthVector() && DAG.getTargetLoweringInfo().isTypeLegal(VT), "Expected legal fixed length vector!");
    let mut PgPattern: optional<unsigned int> = getSVEPredPatternFromNumElements(VT.getVectorNumElements());
    assert!(PgPattern, "Unexpected element count for SVE predicate");
    let mut MaskVT: MVT = MVT {};
    match VT.getVectorElementType().getSimpleVT().SimpleTy {
        _ => {
            llvm_unreachable_internal("unexpected element type for SVE predicate", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 34155);
        },
        i8 => {
            MaskVT = nxv16i1;
        },
        i16 => {
            f16;
        },
        i32 => {
            f32;
        },
        i64 => {
            f64;
        },
    }
    return getPTrue(DAG, DL, MaskVT, operator(PgPattern));
}

fn getPredicateForScalableVector(DAG: *mut SelectionDAG, DL: *mut SDLoc, VT: EVT) -> SDValue {
    assert!(VT.isScalableVector() && DAG.getTargetLoweringInfo().isTypeLegal(VT), "Expected legal scalable vector!");
    let mut PredTy: EVT = VT.changeVectorElementType(*DAG.getContext(), i1);
    return DAG.getConstant(1, DL, PredTy, false, false);
}

fn getPredicateForVector(DAG: *mut SelectionDAG, DL: *mut SDLoc, VT: EVT) -> SDValue {
    if VT.isFixedLengthVector() {
        return getPredicateForFixedLengthVector(DAG, DL, VT);
    }
    return getPredicateForScalableVector(DAG, DL, VT);
}

fn convertToScalableVector(DAG: *mut SelectionDAG, VT: EVT, V: SDValue) -> SDValue {
    assert!(VT.isScalableVector(), "Expected to convert into a scalable vector!");
    assert!(V.getValueType().isFixedLengthVector(), "Expected a fixed length vector operand!");
    return DAG.getInsertSubvector(V, DAG.getPOISON(VT), V, 0);
}

fn convertFromScalableVector(DAG: *mut SelectionDAG, VT: EVT, V: SDValue) -> SDValue {
    assert!(VT.isFixedLengthVector(), "Expected to convert into a fixed length vector!");
    assert!(V.getValueType().isScalableVector(), "Expected a scalable vector operand!");
    return DAG.getExtractSubvector(V, VT, V, 0);
}

fn AArch64TargetLowering::LowerFixedLengthVectorLoadToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Load: auto = cast(Op);
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut LoadVT: EVT = ContainerVT;
    let mut MemVT: EVT = ();
    let mut Pg: SDValue = getPredicateForFixedLengthVector(DAG, DL, VT);
    if VT.isFloatingPoint() {
        LoadVT = ContainerVT.changeTypeToInteger();
        MemVT = MemVT.changeTypeToInteger();
    }
    let mut NewLoad: SDValue = DAG.getMaskedLoad(LoadVT, DL, Pg, DAG.getPOISON(LoadVT), MemVT);
    let mut Result: SDValue = NewLoad;
    if VT.isFloatingPoint() && () == EXTLOAD {
        let mut ExtendVT: EVT = ContainerVT.changeVectorElementType(*DAG.getContext(), ()());
        Result = self.getSVESafeBitCast(ExtendVT, Result, DAG);
        Result = DAG;
    } else if VT.isFloatingPoint() {
        Result = DAG.getNode(BITCAST, DL, ContainerVT, Result);
    }
    Result = convertFromScalableVector(DAG, VT, Result);
    let mut MergedValues: [2]SDValue = [Result, NewLoad.getValue(1)];
    return DAG.getMergeValues;
}

fn convertFixedMaskToScalableVector(Mask: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Mask;
    let mut InVT: EVT = Mask.getValueType();
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, InVT);
    let mut Pg: SDValue = getPredicateForFixedLengthVector(DAG, DL, InVT);
    if isBuildVectorAllOnes(Mask.getNode()) {
        return Pg;
    }
    let mut InvertCond: bool = false;
    if isBitwiseNot(Mask, false) {
        InvertCond = true;
        Mask = Mask.getOperand(0);
    }
    let mut Op1: SDValue = SDValue {};
    let mut Op2: SDValue = SDValue {};
    let mut CC: CondCode = zeroed();
    if Mask.getOpcode() == SETCC {
        Op1 = convertToScalableVector(DAG, ContainerVT, Mask.getOperand(0));
        Op2 = convertToScalableVector(DAG, ContainerVT, Mask.getOperand(1));
        CC = cast(Mask.getOperand(2))();
    } else {
        Op1 = convertToScalableVector(DAG, ContainerVT, Mask);
        Op2 = DAG.getConstant(0, DL, ContainerVT, false, false);
        CC = SETNE;
    }
    if InvertCond {
        CC = getSetCCInverse(CC, Op1.getValueType());
    }
    return DAG;
}

fn AArch64TargetLowering::LowerFixedLengthVectorMLoadToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Load: auto = cast(Op);
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut Mask: SDValue = ();
    if VT.getScalarSizeInBits() > Mask.getValueType().getScalarSizeInBits() {
        (((operator!(operator!((Load()() != NON_EXTLOAD && "Incorrect mask type")))) || (_wassert(L"Load->getExtensionType() != ISD::NON_EXTLOAD && \"Incorrect mask type\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (34301) as u32) , 0)) as void);
        Mask = DAG.getNode(SIGN_EXTEND, DL, VT, Mask);
    }
    Mask = convertFixedMaskToScalableVector(Mask, DAG);
    let mut PassThru: SDValue = SDValue {};
    let mut NewLoad: SDValue = SDValue {};
    let mut Result: SDValue = SDValue {};
    let mut IsPassThruZeroOrUndef: bool = false;
    if Load()()() {
        PassThru = DAG.getUNDEF(ContainerVT);
        IsPassThruZeroOrUndef = true;
    } else {
        if ContainerVT.isInteger() {
            PassThru = DAG.getConstant(0, DL, ContainerVT, false, false);
        } else {
            PassThru = DAG.getConstantFP(0, DL, ContainerVT, false);
        }
        if isZerosVector(()()) {
            IsPassThruZeroOrUndef = true;
        }
    }
    if operator!() {
        NewLoad = DAG.getMaskedLoad(ContainerVT, DL, Mask, PassThru);
        Result = NewLoad;
    } else {
        (((operator!(operator!((((self.Subtarget.isSVEAvailable() && self.Subtarget()) || (self.Subtarget.isSVEorStreamingSVEAvailable() && self.Subtarget())) && "Expected SVE2p2 or SME2p2")))) || (_wassert(L"((Subtarget->isSVEAvailable() && Subtarget->hasSVE2p2()) || (Subtarget->isSVEorStreamingSVEAvailable() && Subtarget->hasSME2p2())) && \"Expected SVE2p2 or SME2p2\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (34334) as u32) , 0)) as void);
        let mut CntActive: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, i64, DAG, Mask, Mask);
        let mut ActiveMask: SDValue = DAG.getNode(GET_ACTIVE_LANE_MASK, DL, operator(Mask).getValueType(0), DAG.getConstant(0, DL, i64, false, false), CntActive);
        NewLoad = DAG.getMaskedLoad(ContainerVT, DL, ActiveMask, DAG.getUNDEF(ContainerVT));
        Result = DAG(INTRINSIC_WO_CHAIN, DL, ContainerVT, DAG, Mask, NewLoad);
    }
    if !IsPassThruZeroOrUndef {
        let mut OldPassThru: SDValue = convertToScalableVector(DAG, ContainerVT);
        Result = DAG.getSelect(DL, ContainerVT, Mask, Result, OldPassThru, SDNodeFlags { Flags: None });
    }
    Result = convertFromScalableVector(DAG, VT, Result);
    let mut MergedValues: [2]SDValue = [Result, NewLoad.getValue(1)];
    return DAG.getMergeValues;
}

fn AArch64TargetLowering::LowerFixedLengthVectorStoreToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Store: auto = cast(Op);
    let mut DL: SDLoc = Op;
    let mut VT: EVT = ()();
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut MemVT: EVT = ();
    let mut Pg: auto = getPredicateForFixedLengthVector(DAG, DL, VT);
    let mut NewValue: auto = convertToScalableVector(DAG, ContainerVT);
    if VT.isFloatingPoint() && () {
        let mut TruncVT: EVT = ContainerVT.changeVectorElementType(*DAG.getContext(), ()());
        MemVT = MemVT.changeTypeToInteger();
        NewValue() = DAG;
        NewValue() = self.getSVESafeBitCast(ContainerVT.changeTypeToInteger(), DAG);
    } else if VT.isFloatingPoint() {
        MemVT = MemVT.changeTypeToInteger();
        NewValue() = self.getSVESafeBitCast(ContainerVT.changeTypeToInteger(), DAG);
    }
    return DAG.getMaskedStore(DL, MemVT);
}

fn AArch64TargetLowering::LowerMSTORE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Store: *mut auto = cast(Op);
    let mut VT: EVT = ()();
    if VT.isFixedLengthVector() {
        return self.LowerFixedLengthVectorMStoreToSVE(Op, DAG);
    }
    if operator!() {
        return SDValue {};
    }
    return expandScalableCompressingStore(DAG);
}

fn AArch64TargetLowering::LowerFixedLengthVectorMStoreToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Store: *mut auto = cast(Op);
    let mut DL: SDLoc = Op;
    let mut VT: EVT = ()();
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut NewValue: auto = convertToScalableVector(DAG, ContainerVT);
    let mut Mask: SDValue = convertFixedMaskToScalableVector(DAG);
    return DAG.getMaskedStore(DL, Mask);
}

fn AArch64TargetLowering::LowerFixedLengthVectorIntDivideToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut Opc: u32 = Op.getOpcode();
    let mut Signed: bool = Opc == SDIV || Opc == MASKED_SDIV;
    let mut Masked: bool = Opc == MASKED_SDIV || Opc == MASKED_UDIV;
    let mut Negated: bool = false;
    let mut SplatVal: u64 = 0;
    if Signed && isPow2Splat(Op.getOperand(1), SplatVal, Negated) && SplatVal > 1 {
        let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
        let mut Op1: SDValue = convertToScalableVector(DAG, ContainerVT, Op.getOperand(0));
        let mut Op2: SDValue = DAG.getTargetConstant(Log2_64(SplatVal), DL, i32, false);
        let mut Pg: SDValue = if Masked { convertFixedMaskToScalableVector(Op.getOperand(2), DAG) } else { getPredicateForFixedLengthVector(DAG, DL, VT) };
        let mut Res: SDValue = DAG;
        if Negated {
            Res = DAG.getNode(SUB, DL, ContainerVT, DAG.getConstant(0, DL, ContainerVT, false, false), Res);
        }
        return convertFromScalableVector(DAG, VT, Res);
    }
    if EltVT == i32 || EltVT == i64 {
        let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
        let mut LHS: SDValue = convertToScalableVector(DAG, ContainerVT, Op.getOperand(0));
        let mut RHS: SDValue = convertToScalableVector(DAG, ContainerVT, Op.getOperand(1));
        let mut Mask: SDValue = if Masked { convertFixedMaskToScalableVector(Op.getOperand(2), DAG) } else { getPredicateForFixedLengthVector(DAG, DL, VT) };
        let mut MaskedOpcode: u32 = if Signed { MASKED_SDIV } else { MASKED_UDIV };
        let mut Div: SDValue = DAG.getNode(MaskedOpcode, DL, ContainerVT, LHS, RHS, Mask);
        return convertFromScalableVector(DAG, VT, Div);
    }
    if Masked {
        return SDValue {};
    }
    let mut HalfVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
    let mut PromVT: EVT = HalfVT.widenIntegerVectorElementType(*DAG.getContext());
    let mut ExtendOpcode: u32 = if Signed { SIGN_EXTEND } else { ZERO_EXTEND };
    let mut WideVT: EVT = VT.widenIntegerVectorElementType(*DAG.getContext());
    if DAG.getTargetLoweringInfo().isTypeLegal(WideVT) {
        let mut Op0: SDValue = DAG.getNode(ExtendOpcode, DL, WideVT, Op.getOperand(0));
        let mut Op1: SDValue = DAG.getNode(ExtendOpcode, DL, WideVT, Op.getOperand(1));
        let mut Div: SDValue = DAG.getNode(Opc, DL, WideVT, Op0, Op1);
        return DAG.getNode(TRUNCATE, DL, VT, Div);
    }
    let mut HalveAndExtendVector: Closure_80 = Closure_80 { DAG: &mut DAG, DL: &mut DL, HalfVT: &mut HalfVT, PromVT: &mut PromVT, ExtendOpcode: &mut ExtendOpcode };
    let mut Lo: SDValue = DAG(Op.getOpcode(), DL, PromVT);
    let mut Hi: SDValue = DAG(Op.getOpcode(), DL, PromVT);
    let mut LoTrunc: SDValue = DAG.getNode(TRUNCATE, DL, HalfVT, Lo);
    let mut HiTrunc: SDValue = DAG.getNode(TRUNCATE, DL, HalfVT, Hi);
    return DAG.getNode(CONCAT_VECTORS, DL, VT, [LoTrunc, HiTrunc]);
}

fn AArch64TargetLowering::LowerFixedLengthVectorIntExtendToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut DL: SDLoc = Op;
    let mut Val: SDValue = Op.getOperand(0);
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, Val.getValueType());
    Val = convertToScalableVector(DAG, ContainerVT, Val);
    let mut Signed: bool = Op.getOpcode() == SIGN_EXTEND;
    let mut ExtendOpc: u32 = 0;
    match ContainerVT.getSimpleVT().SimpleTy {
        _ => {
            llvm_unreachable_internal("unimplemented container type", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 34533);
        },
        nxv16i8 => {
            Val = DAG.getNode(ExtendOpc, DL, nxv8i16, Val);
        },
        nxv8i16 => {
            Val = DAG.getNode(ExtendOpc, DL, nxv4i32, Val);
        },
        nxv4i32 => {
            Val = DAG.getNode(ExtendOpc, DL, nxv2i64, Val);
        },
    }
    return convertFromScalableVector(DAG, VT, Val);
}

fn AArch64TargetLowering::LowerFixedLengthVectorTruncateToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut DL: SDLoc = Op;
    let mut Val: SDValue = Op.getOperand(0);
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, Val.getValueType());
    Val = convertToScalableVector(DAG, ContainerVT, Val);
    match ContainerVT.getSimpleVT().SimpleTy {
        _ => {
            llvm_unreachable_internal("unimplemented container type", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 34566);
        },
        nxv2i64 => {
            Val = DAG.getNode(BITCAST, DL, nxv4i32, Val);
        },
        nxv4i32 => {
            Val = DAG.getNode(BITCAST, DL, nxv8i16, Val);
        },
        nxv8i16 => {
            Val = DAG.getNode(BITCAST, DL, nxv16i8, Val);
        },
    }
    return convertFromScalableVector(DAG, VT, Val);
}

fn AArch64TargetLowering::LowerFixedLengthExtractVectorElt(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut InVT: EVT = Op.getOperand(0).getValueType();
    assert!(InVT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut DL: SDLoc = Op;
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, InVT);
    let mut Op0: SDValue = convertToScalableVector(DAG, ContainerVT, operator(Op).getOperand(0));
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, Op0, Op.getOperand(1));
}

fn AArch64TargetLowering::LowerFixedLengthInsertVectorElt(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut DL: SDLoc = Op;
    let mut InVT: EVT = Op.getOperand(0).getValueType();
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, InVT);
    let mut Op0: SDValue = convertToScalableVector(DAG, ContainerVT, operator(Op).getOperand(0));
    let mut ScalableRes: SDValue = DAG.getNode(INSERT_VECTOR_ELT, DL, ContainerVT, Op0, Op.getOperand(1), Op.getOperand(2));
    return convertFromScalableVector(DAG, VT, ScalableRes);
}

fn AArch64TargetLowering::LowerToPredicatedOp(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, NewOp: u32) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut Pg: SDValue = getPredicateForVector(DAG, DL, VT);
    let mut IsStrictFP: bool = operator(Op).isStrictFPOpcode();
    let mut OpStartIdx: u32 = if IsStrictFP { 1 } else { 0 };
    if VT.isFixedLengthVector() {
        assert!(self.isTypeLegal(VT), "Expected only legal fixed-width types");
        let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
        let mut Operands: SmallVector<SDValue, 4> = [Pg];
        for V in operator(Op).op_values() {
            if isa(V) {
                Operands.push(V);
                continue;
            }
            if dyn_cast(V) {
                VTNode;
            } else {
                let mut VTArg: EVT = VTNode.getVT().getVectorElementType();
                let mut NewVTArg: EVT = ContainerVT.changeVectorElementType(*DAG.getContext(), VTArg);
                Operands.push(DAG.getValueType(NewVTArg));
                continue;
            }
            assert!(self.isTypeLegal(V.getValueType()), "Expected only legal fixed-width types");
            Operands.push(convertToScalableVector(DAG, ContainerVT, V));
        }
        if isMergePassthruOpcode(NewOp) {
            Operands.push(DAG.getPOISON(ContainerVT));
        }
        let mut ScalableRes: auto = DAG;
        return convertFromScalableVector(DAG, VT);
    }
    assert!(VT.isScalableVector(), "Only expect to lower scalable vector op!");
    let mut Operands: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    if IsStrictFP {
        Operands.push(Op.getOperand(0));
    }
    Operands.push(Pg);
    for let mut OpIdx: u32 = OpStartIdx; OpIdx < Op.getNumOperands(); OpIdx += 1 {
        let mut V: SDValue = Op.getOperand(OpIdx);
        assert!((!V.getValueType().isVector() || V.getValueType().isScalableVector()), "Only scalable vectors are supported!");
        Operands.push(V);
    }
    if isMergePassthruOpcode(NewOp) {
        Operands.push(DAG.getPOISON(VT));
    }
    return DAG;
}

fn AArch64TargetLowering::LowerToScalableOp(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFixedLengthVector() && self.isTypeLegal(VT), "Only expected to lower fixed length vector operation!");
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for V in operator(Op).op_values() {
        assert!(!isa(V), "Unexpected VTSDNode node!");
        if !V.getValueType().isVector() {
            Ops.push(V);
            continue;
        }
        assert!(V.getValueType().isFixedLengthVector() && self.isTypeLegal(V.getValueType()), "Only fixed length vectors are supported!");
        Ops.push(convertToScalableVector(DAG, ContainerVT, V));
    }
    let mut ScalableRes: auto = DAG;
    return convertFromScalableVector(DAG, VT);
}

fn AArch64TargetLowering::LowerVECREDUCE_SEQ_FADD(self: *AArch64TargetLowering, ScalarOp: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = ScalarOp;
    let mut AccOp: SDValue = ScalarOp.getOperand(0);
    let mut VecOp: SDValue = ScalarOp.getOperand(1);
    let mut SrcVT: EVT = VecOp.getValueType();
    let mut ResVT: EVT = SrcVT.getVectorElementType();
    let mut ContainerVT: EVT = SrcVT;
    if SrcVT.isFixedLengthVector() {
        ContainerVT = getContainerForFixedLengthVector(DAG, SrcVT);
        VecOp = convertToScalableVector(DAG, ContainerVT, VecOp);
    }
    AccOp = DAG.getInsertVectorElt(DL, DAG.getPOISON(ContainerVT), AccOp, 0);
    let mut Pg: SDValue = getPredicateForVector(DAG, DL, SrcVT);
    let mut Rdx: SDValue = DAG;
    return DAG.getExtractVectorElt(DL, ResVT, Rdx, 0);
}

fn AArch64TargetLowering::LowerPredReductionToSVE(self: *AArch64TargetLowering, ReduceOp: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = ReduceOp;
    let mut Op: SDValue = ReduceOp.getOperand(0);
    let mut OpVT: EVT = Op.getValueType();
    let mut VT: EVT = ReduceOp.getValueType();
    if !OpVT.isScalableVectorOf(i1) {
        return SDValue {};
    }
    let mut Pg: SDValue = getPredicateForVector(DAG, DL, OpVT);
    match ReduceOp.getOpcode() {
        _ => {
            return SDValue {};
        },
        VECREDUCE_OR => {
            if self.isAllActivePredicate(DAG, Pg) && OpVT == nxv16i1 {
                return getPTest(DAG, VT, Op, Op, ANY_ACTIVE);
            } else {
                return getPTest(DAG, VT, Pg, Op, ANY_ACTIVE);
            }
        },
        VECREDUCE_AND => {
            Op = DAG.getNode(XOR, DL, OpVT, Op, Pg);
            return getPTest(DAG, VT, Pg, Op, NONE_ACTIVE);
        },
        VECREDUCE_XOR => {
            let mut ID: SDValue = DAG;
            if OpVT == nxv1i1 {
                Pg = DAG;
                Op = DAG;
            }
            let mut Cntp: SDValue = DAG.getNode(INTRINSIC_WO_CHAIN, DL, i64, ID, Pg, Op);
            return DAG.getAnyExtOrTrunc(Cntp, DL, VT);
        },
    }
    return SDValue {};
}

