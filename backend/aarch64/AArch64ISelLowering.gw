fn AArch64TargetLowering::getAsmOperandValueType(self: *AArch64TargetLowering, DL: *DataLayout, Ty: *mut Type, AllowUnknown: bool) -> EVT {
    if self.Subtarget() && Ty.isIntegerTy(512) {
        return i64x8;
    }
    return self.getAsmOperandValueType(DL, Ty, AllowUnknown);
}

fn AArch64TargetLowering::LowerAsmOperandForConstraint(self: *AArch64TargetLowering, Op: SDValue, Constraint: str, Ops: *mut i32, DAG: *mut SelectionDAG) {
    let mut Result: SDValue = SDValue {};
    if Constraint.len != 1 {
        return;
    }
    let mut ConstraintLetter: i8 = Constraint[0];
    match ConstraintLetter {
        _ => {
            break;
        },
        'z' => {
            if !isNullConstant(Op) {
                return;
            }
            if Op.getValueType() == i64 {
                Result = DAG.getRegister;
            } else {
                Result = DAG.getRegister;
            }
            break;
        },
        'S' => {
            self.LowerAsmOperandForConstraint(Op, "s", DAG);
        },
        'I' => {
            'J';
        },
    }
    if Result.getNode() {
        Ops()(Result);
        return;
    }
    return self.LowerAsmOperandForConstraint(Op, Constraint, DAG);
}

fn WidenVector(V64Reg: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = V64Reg.getValueType();
    let mut NarrowSize: u32 = VT.getVectorNumElements();
    let mut EltTy: MVT = VT.getVectorElementType().getSimpleVT();
    let mut WideTy: MVT = getVectorVT(EltTy, 2 * NarrowSize);
    let mut DL: SDLoc = V64Reg;
    return DAG.getInsertSubvector(DL, DAG.getPOISON(WideTy), V64Reg, 0);
}

fn getExtFactor(V: *mut SDValue) -> u32 {
    let mut EltType: EVT = V.getValueType().getVectorElementType();
    return EltType.getSizeInBits().operator unsigned long long() / 8;
}

fn ReconstructShuffleWithRuntimeMask(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op.getOpcode() == BUILD_VECTOR, "Unknown opcode!");
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    assert!(!VT.isScalableVector(), "Scalable vectors cannot be used with ISD::BUILD_VECTOR");
    if VT != v16i8 && VT != v8i8 {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!((NumElts == 8 || NumElts == 16), "Need to have exactly 8 or 16 elements in vector.");
    let mut SourceVec: SDValue = SDValue {};
    let mut MaskSourceVec: SDValue = SDValue {};
    let mut AndMaskConstants: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        let mut V: SDValue = Op.getOperand(i);
        if V.getOpcode() != EXTRACT_VECTOR_ELT {
            return SDValue {};
        }
        let mut OperandSourceVec: SDValue = V.getOperand(0);
        if !SourceVec {
            SourceVec = OperandSourceVec;
        } else if SourceVec != OperandSourceVec {
            return SDValue {};
        }
        let mut MaskSource: SDValue = V.getOperand(1);
        if MaskSource.getOpcode() == AND {
            if !isa(MaskSource.getOperand(1)) {
                return SDValue {};
            }
            AndMaskConstants.push(MaskSource.getOperand(1));
            MaskSource = operator(MaskSource).getOperand(0);
        } else if !AndMaskConstants.is_empty() {
            return SDValue {};
        }
        if MaskSource.getOpcode() == ANY_EXTEND {
            MaskSource = MaskSource.getOperand(0);
        }
        if MaskSource.getOpcode() != EXTRACT_VECTOR_ELT {
            return SDValue {};
        }
        let mut MaskIdx: SDValue = MaskSource.getOperand(1);
        if !isa(MaskIdx) || operator!(cast(MaskIdx)()(i)) {
            return SDValue {};
        }
        if !MaskSourceVec {
            MaskSourceVec = operator(MaskSource).getOperand(0);
            if MaskSourceVec.getValueType() != VT {
                return SDValue {};
            }
        } else if MaskSourceVec != operator(MaskSource).getOperand(0) {
            return SDValue {};
        }
    }
    if NumElts == 8 {
        SourceVec = DAG.getNode(CONCAT_VECTORS, DL, v16i8, SourceVec, DAG.getPOISON(VT));
    }
    if !AndMaskConstants.is_empty() {
        MaskSourceVec = DAG.getNode(AND, DL, VT, MaskSourceVec, DAG);
    }
    return DAG(INTRINSIC_WO_CHAIN, DL, VT, DAG, SourceVec, MaskSourceVec);
}

fn AArch64TargetLowering::ReconstructShuffle(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op.getOpcode() == BUILD_VECTOR, "Unknown opcode!");
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
            dbgs() << "AArch64TargetLowering::ReconstructShuffle\n";
        }
    }
        if !(false) { break; }
    }
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    assert!(!VT.isScalableVector(), "Scalable vectors cannot be used with ISD::BUILD_VECTOR");
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut IsNeonSized: Closure_26 = Closure_26 {};
    let mut Sources: SmallVector<ShuffleSourceInfo, 2> = zeroed();
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        let mut V: SDValue = Op.getOperand(i);
        if V.isUndef() {
            continue;
        } else if V.getOpcode() != EXTRACT_VECTOR_ELT || !isa(V.getOperand(1)) || !IsNeonSized.call(operator(V).getOperand(0).getValueType()) {
            while true {
                {
