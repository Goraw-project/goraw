    let mut MI: *MachineInstr = MRI.getVRegDef(R);
    if !MI {
        return 1;
    }
    match MI.getOpcode() {
        _ => {
            return 1;
        },
    }
}

fn AArch64TargetLowering::getScalarShiftAmountTy(self: *AArch64TargetLowering, DL: *DataLayout, arg: EVT) -> MVT {
    return i64;
}

fn AArch64TargetLowering::allowsMisalignedMemoryAccesses(self: *AArch64TargetLowering, VT: EVT, AddrSpace: u32, Alignment: Align, Flags: Flags, Fast: *mut u32) -> bool {
    let mut UseNEONLd1: bool = self.Subtarget() && VT.isFixedLengthVector() && (VT.getSizeInBits().operator unsigned long long() == 64 || VT.getSizeInBits().operator unsigned long long() == 128);
    if VT.isScalableVector() || UseNEONLd1 {
        let mut ElementSizeBits: u32 = VT.getScalarSizeInBits();
        if ElementSizeBits % 8 == 0 && Alignment >= ElementSizeBits / 8 {
            return true;
        }
    }
    if self.Subtarget() {
        return false;
    }
    if Fast {
        *Fast = operator!(self.Subtarget()) || VT.getStoreSize().operator unsigned long long() != 16 || Alignment <= 2 || VT == v2i64;
    }
    return true;
}

fn AArch64TargetLowering::allowsMisalignedMemoryAccesses(self: *AArch64TargetLowering, Ty: LLT, AddrSpace: u32, Alignment: Align, Flags: Flags, Fast: *mut u32) -> bool {
    if self.Subtarget() {
        return false;
    }
    if Fast {
        *Fast = operator!(self.Subtarget()) || Ty.getSizeInBytes().operator unsigned long long() != 16 || Alignment <= 2 || Ty == fixed_vector(2, 64);
    }
    return true;
}

fn AArch64TargetLowering::createFastISel(self: *AArch64TargetLowering, funcInfo: *mut FunctionLoweringInfo, libInfo: *TargetLibraryInfo, libcallLowering: *LibcallLoweringInfo) -> *mut FastISel {
    return createFastISel(funcInfo, libInfo, libcallLowering);
}

fn AArch64TargetLowering::EmitF128CSEL(self: *AArch64TargetLowering, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut LLVM_BB: *BasicBlock = MBB.getBasicBlock();
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut It: iterator = operator(MBB.getIterator());
    let mut DestReg: Register = MI.getOperand(0).getReg();
    let mut IfTrueReg: Register = MI.getOperand(1).getReg();
    let mut IfFalseReg: Register = MI.getOperand(2).getReg();
    let mut CondCode: u32 = MI.getOperand(3).getImm();
    let mut NZCVKilled: bool = MI.getOperand(4).isKill();
    let mut TrueBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt);
    let mut EndBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt);
    MF.insert(It, TrueBB);
    MF.insert(It, EndBB);
    EndBB(EndBB.begin(), MBB, next(MI), MBB.end());
    EndBB.transferSuccessorsAndUpdatePHIs(MBB);
    BuildMI(MBB, DL, TII.get)(CondCode)(TrueBB);
    BuildMI(MBB, DL, TII.get)(EndBB);
    MBB.addSuccessor(TrueBB, getUnknown());
    MBB.addSuccessor(EndBB, getUnknown());
    TrueBB.addSuccessor(EndBB, getUnknown());
    if !NZCVKilled {
        TrueBB;
        EndBB;
    }
    BuildMI(*EndBB, EndBB.begin(), DL, TII.get, DestReg)(IfTrueReg)(TrueBB)(IfFalseReg)(MBB);
    MI.eraseFromParent();
    return EndBB;
}

fn AArch64TargetLowering::EmitLoweredCatchRet(self: *AArch64TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    assert!(!isAsynchronousEHPersonality(classifyEHPersonality(BB.getParent().getFunction().getPersonalityFn())), "SEH does not use catchret!");
    return BB;
}

fn AArch64TargetLowering::EmitLoweredSetFpmr(self: *AArch64TargetLowering, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut DL: DebugLoc = MI.getDebugLoc();
    if operator!() {
        BuildMI(*MBB, MI, DL, TII.get)(55842)(MI.getOperand(0));
        MI.eraseFromParent();
        return MBB;
    }
    let mut NewFpmrVal: Register = MI.getOperand(0).getReg();
    let mut LLVM_BB: *BasicBlock = MBB.getBasicBlock();
    let mut MsrBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt);
    let mut EndBB: *mut MachineBasicBlock = MBB.splitAt(MI, true, null);
    MF.insert(operator(MBB.getIterator()), MsrBB);
    let mut CurrentFpmrVal: Register = MF.getRegInfo();
    BuildMI(*MBB, MI, DL, TII.get, CurrentFpmrVal)(55842);
    BuildMI(*MBB, MI, DL, TII.get)(CurrentFpmrVal, Kill)(NewFpmrVal)(0);
    BuildMI(*MBB, MI, DL, TII.get)(EQ)(EndBB);
    BuildMI(*MsrBB, MsrBB.begin(), DL, TII.get)(55842)(NewFpmrVal, getKillRegState(MI.getOperand(0).isDead()));
    MBB.addSuccessor(MsrBB, getUnknown());
    MsrBB.addSuccessor(EndBB, getUnknown());
    MI.eraseFromParent();
    return EndBB;
}

fn AArch64TargetLowering::EmitDynamicProbedAlloc(self: *AArch64TargetLowering, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut MBBI: iterator = MI.getIterator();
    let mut TII: *AArch64InstrInfo = operator*(MF());
    let mut TargetReg: Register = MI.getOperand(0).getReg();
    let mut NextInst: iterator = TII.probedStackAlloc(MBBI, TargetReg, false);
    MI.eraseFromParent();
    return operator(NextInst).getParent();
}

fn AArch64TargetLowering::EmitCheckMatchingVL(self: *AArch64TargetLowering, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut RC_GPR: *TargetRegisterClass = null;
    let mut RC_GPRsp: *TargetRegisterClass = null;
    let mut RegVL_GPR: Register = MRI.createVirtualRegister(RC_GPR, "");
    let mut RegVL_GPRsp: Register = MRI.createVirtualRegister(RC_GPRsp, "");
    let mut RegSVL_GPR: Register = MRI.createVirtualRegister(RC_GPR, "");
    let mut RegSVL_GPRsp: Register = MRI.createVirtualRegister(RC_GPRsp, "");
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut DL: DebugLoc = MI.getDebugLoc();
    BuildMI(*MBB, MI, DL, TII.get, RegVL_GPR)(1);
    BuildMI(*MBB, MI, DL, TII.get, RegVL_GPRsp)(RegVL_GPR);
    BuildMI(*MBB, MI, DL, TII.get, RegSVL_GPRsp)(RegVL_GPRsp)(-1);
    BuildMI(*MBB, MI, DL, TII.get, RegSVL_GPR)(RegSVL_GPRsp);
    let mut LLVM_BB: *BasicBlock = MBB.getBasicBlock();
    let mut It: iterator = operator(MBB.getIterator());
    let mut TrapBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt);
    let mut PassBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(LLVM_BB, nullopt);
    MF.insert(It, TrapBB);
    MF.insert(It, PassBB);
    BuildMI(*MBB, MI, DL, TII.get)(RegSVL_GPR)(PassBB);
    PassBB(PassBB.begin(), MBB, next(MI), MBB.end());
    PassBB.transferSuccessorsAndUpdatePHIs(MBB);
    BuildMI(TrapBB, DL, TII.get)(1);
    MBB.addSuccessor(TrapBB, getUnknown());
    MBB.addSuccessor(PassBB, getUnknown());
    MI.eraseFromParent();
    return PassBB;
}

fn AArch64TargetLowering::EmitTileLoad(self: *AArch64TargetLowering, Opc: u32, BaseReg: u32, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MIB: MachineInstrBuilder = BuildMI(*BB, MI, MI.getDebugLoc(), TII.get);
    MIB.addReg(BaseReg + MI.getOperand(0).getImm(), Define, 0);
    MIB.add(MI.getOperand(1));
    MIB.add(MI.getOperand(2));
    MIB.add(MI.getOperand(3));
    MIB.add(MI.getOperand(4));
    MIB.add(MI.getOperand(5));
    MI.eraseFromParent();
    return BB;
}

fn AArch64TargetLowering::EmitFill(self: *AArch64TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MIB: MachineInstrBuilder = BuildMI(*BB, MI, MI.getDebugLoc(), TII.get);
    MIB.addReg;
    MIB.add(MI.getOperand(0));
    MIB.add(MI.getOperand(1));
    MIB.add(MI.getOperand(2));
    MIB.add(MI.getOperand(1));
    MI.eraseFromParent();
    return BB;
}

fn AArch64TargetLowering::EmitZTInstr(self: *AArch64TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock, Opcode: u32, Op0IsDef: bool) -> *mut MachineBasicBlock {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    MIB = BuildMI(*BB, MI, MI.getDebugLoc(), TII.get)(MI.getOperand(0).getReg(), getDefRegState(Op0IsDef));
    for let mut I: u32 = 1; I < MI.getNumOperands(); I += 1 {
        MIB.add(MI.getOperand(I));
    }
    MI.eraseFromParent();
    return BB;
}

fn AArch64TargetLowering::EmitZAInstr(self: *AArch64TargetLowering, Opc: u32, BaseReg: u32, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MIB: MachineInstrBuilder = BuildMI(*BB, MI, MI.getDebugLoc(), TII.get);
    let mut StartIdx: u32 = 0;
    let mut HasTile: bool = false;
    let mut HasZPROut: bool = HasTile && MI.getOperand(0).isReg();
    if HasZPROut {
        MIB.add(MI.getOperand(StartIdx));
        StartIdx += 1;
    }
    if HasTile {
        MIB.addReg(BaseReg + MI.getOperand(StartIdx).getImm(), Define, 0);
        MIB.addReg(BaseReg + MI.getOperand(StartIdx).getImm(), RegState {}, 0);
        StartIdx += 1;
    } else {
        if MI.getOperand(0).isReg() && !MI.getOperand(1).isImm() {
            MIB.add(MI.getOperand(StartIdx));
            StartIdx += 1;
        }
        MIB.addReg(BaseReg, Define, 0).addReg(BaseReg, RegState {}, 0);
    }
    for let mut I: u32 = StartIdx; I < MI.getNumOperands(); I += 1 {
        MIB.add(MI.getOperand(I));
    }
    MI.eraseFromParent();
    return BB;
}

fn AArch64TargetLowering::EmitZero(self: *AArch64TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MIB: MachineInstrBuilder = BuildMI(*BB, MI, MI.getDebugLoc(), TII.get);
    MIB.add(MI.getOperand(0));
    let mut Mask: u32 = MI.getOperand(0).getImm();
    for let mut I: u32 = 0; I < 8; I += 1 {
        if Mask & (1 << I) {
            MIB.addDef;
        }
    }
    MI.eraseFromParent();
    return BB;
}

fn AArch64TargetLowering::EmitEntryPStateSM(self: *AArch64TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut MF: *mut MachineFunction = BB.getParent();
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut DL: *DebugLoc = MI.getDebugLoc();
    let mut ResultReg: Register = MI.getOperand(0).getReg();
    if MF.getRegInfo().use_empty(ResultReg) {} else if self.Subtarget() {
        BuildMI(*BB, MI, DL, TII.get, ResultReg);
    } else {
        let mut LC: Libcall = SMEABI_SME_STATE;
        let mut TRI: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
        BuildMI(*BB, MI, DL, TII.get)(self.getLibcallName(LC))(TRI.getCallPreservedMask(*MF, self.getLibcallCallingConv(LC)));
        BuildMI(*BB, MI, DL, TII.get, ResultReg);
    }
    MI.eraseFromParent();
    return BB;
}

fn stripVRegCopies(MRI: *MachineRegisterInfo, Reg: Register) -> *MachineInstr {
    while Reg.isVirtual() {
        let mut DefMI: *mut MachineInstr = MRI.getVRegDef(Reg);
        assert!(DefMI, "Virtual register definition not found");
        let mut Opcode: u32 = DefMI.getOpcode();
        if  {
            Reg = DefMI.getOperand(1).getReg();
            if Reg.isPhysical() {
                return DefMI;
            }
            continue;
        }
        if  {
            Reg = DefMI.getOperand(1).getReg();
            continue;
        }
        return DefMI;
    }
    return null;
}

fn AArch64TargetLowering::fixupPtrauthDiscriminator(self: *AArch64TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock, IntDiscOp: *mut MachineOperand, AddrDiscOp: *mut MachineOperand, AddrDiscRC: *TargetRegisterClass) {
    let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
    let mut MRI: *mut MachineRegisterInfo = MI.getMF().getRegInfo();
    let mut DL: *DebugLoc = MI.getDebugLoc();
    let mut AddrDisc: Register = AddrDiscOp.getReg();
    let mut IntDisc: i64 = IntDiscOp.getImm();
    assert!(IntDisc == 0, "Blend components are already expanded");
    let mut DiscMI: *MachineInstr = stripVRegCopies(MRI, AddrDisc);
    if DiscMI {
        match DiscMI.getOpcode() {

        }
    }
    if  {
        AddrDisc = Register { Reg: 0 };
    }
    if AddrDisc.operator unsigned int() && MRI.getRegClass(AddrDisc) != AddrDiscRC {
        let mut TmpReg: Register = MRI.createVirtualRegister(AddrDiscRC, "");
        BuildMI(*BB, MI, DL, TII.get, TmpReg)(AddrDisc);
        AddrDisc = TmpReg;
    }
    if AddrDiscOp.getReg() != AddrDisc {
        AddrDiscOp.setIsKill(false);
    }
    AddrDiscOp.setReg(AddrDisc);
    IntDiscOp.setImm(IntDisc);
}

fn AArch64TargetLowering::EmitInstrWithCustomInserter(self: *AArch64TargetLowering, MI: *mut MachineInstr, BB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    let mut SMEOrigInstr: i32 = getSMEPseudoMap(MI.getOpcode());
    if SMEOrigInstr != -1 {
        let mut TII: *TargetInstrInfo = self.Subtarget.getInstrInfo();
        let mut SMEMatrixType: u64 = TII.get & SMEMatrixTypeMask;
        match SMEMatrixType {
            (SMEMatrixArray) => {
                return self.EmitZAInstr;
            },
            (SMEMatrixTileB) => {
                return self.EmitZAInstr;
            },
            (SMEMatrixTileH) => {
                return self.EmitZAInstr;
            },
            (SMEMatrixTileS) => {
                return self.EmitZAInstr;
            },
            (SMEMatrixTileD) => {
                return self.EmitZAInstr;
            },
            (SMEMatrixTileQ) => {
                return self.EmitZAInstr;
            },
        }
    }
    match MI.getOpcode() {
        _ => {
            MI.dump();
        },
        STATEPOINT => {
            MI(*MI.getMF(), CreateReg(true, true, false, true, false, true));
        },
        STACKMAP => {
            PATCHPOINT;
        },
        PATCHABLE_EVENT_CALL => {
            PATCHABLE_TYPED_EVENT_CALL;
        },
    }
}

fn isZerosVector(N: *SDNode) -> bool {
    while N.getOpcode() == BITCAST {
        N = N.getOperand(0).getNode();
    }
    if isConstantSplatVectorAllZeros(N, false) {
        return true;
    }
    if  {
        return false;
    }
    let mut Opnd0: SDValue = N.getOperand(0);
    return isNullConstant(Opnd0) || isNullFPConstant(Opnd0);
}

fn isOneVector(V: SDValue) -> bool {}

fn changeIntCCToAArch64CC(CC: CondCode, RHS: SDValue) -> CondCode {
    match CC {
        _ => {
            llvm_unreachable_internal("Unknown condition code!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 3834);
        },
        SETNE => {
            return NE;
        },
        SETEQ => {
            return EQ;
        },
        SETGT => {
            return GT;
        },
        SETGE => {
            return if (RHS && isNullConstant(RHS)) { PL } else { GE };
        },
        SETLT => {
            return if (RHS && isNullConstant(RHS)) { MI } else { LT };
        },
        SETLE => {
            return LE;
        },
        SETUGT => {
            return HI;
        },
        SETUGE => {
            return HS;
        },
        SETULT => {
            return LO;
        },
        SETULE => {
            return LS;
        },
    }
}

fn changeFPCCToAArch64CC(CC: CondCode, CondCode: *mut CondCode, CondCode2: *mut CondCode) {
    CondCode2 = AL;
    match CC {
        _ => {
            llvm_unreachable_internal("Unknown FP condition!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 3865);
        },
        SETEQ => {
            SETOEQ;
        },
        SETGT => {
            SETOGT;
        },
        SETGE => {
            SETOGE;
        },
        SETOLT => {
            CondCode = MI;
        },
        SETOLE => {
            CondCode = LS;
        },
        SETONE => {
            CondCode = MI;
        },
        SETO => {
            CondCode = VC;
        },
        SETUO => {
            CondCode = VS;
        },
        SETUEQ => {
            CondCode = EQ;
        },
        SETUGT => {
            CondCode = HI;
        },
        SETUGE => {
            CondCode = PL;
        },
        SETLT => {
            SETULT;
        },
        SETLE => {
            SETULE;
        },
        SETNE => {
            SETUNE;
        },
    }
}

fn changeFPCCToANDAArch64CC(CC: CondCode, CondCode: *mut CondCode, CondCode2: *mut CondCode) {
    CondCode2 = AL;
    match CC {
        _ => {
            changeFPCCToAArch64CC(CC, CondCode, CondCode2);
        },
        SETONE => {
            CondCode = VC;
        },
        SETUEQ => {
            CondCode = PL;
        },
    }
}

fn changeVectorFPCCToAArch64CC(CC: CondCode, CondCode: *mut CondCode, CondCode2: *mut CondCode, Invert: *mut bool) {
    Invert = false;
    match CC {
        _ => {
            changeFPCCToAArch64CC(CC, CondCode, CondCode2);
        },
        SETUO => {
            Invert = true;
        },
        SETO => {
            CondCode = MI;
        },
        SETLE => {
            CondCode = LS;
        },
        SETLT => {
            CondCode = MI;
        },
        SETUEQ => {
            SETULT;
        },
    }
}

fn getCondCode(DAG: *mut SelectionDAG, CC: CondCode) -> SDValue {
    return DAG.getConstant(CC, SDLoc {}, CondCodeVT, false, false);
}

fn numberOfInstrToLoadImm(C: *APInt) -> u32 {
    let mut Imm: u64 = C.getZExtValue();
    let mut Insn: i32 = 0;
    expandMOVImm(Imm, 32);
    return ();
}

fn isSafeSignedCMN(Op: SDValue, DAG: *mut SelectionDAG) -> bool {
    if operator(Op).getFlags().hasNoSignedWrap() {
        return true;
    }
    let mut KnownSrc: KnownBits = DAG.computeKnownBits(Op.getOperand(1), 0);
    return !KnownSrc.getSignedMinValue().isMinSignedValue();
}

fn isCMN(Op: SDValue, CC: CondCode, DAG: *mut SelectionDAG) -> bool {
    return Op.getOpcode() == SUB && isNullConstant(Op.getOperand(0)) && (isIntEqualitySetCC(CC) || (isUnsignedIntSetCC(CC) && DAG.isKnownNeverZero(Op.getOperand(1), 0)) || (isSignedIntSetCC(CC) && isSafeSignedCMN(Op, DAG)));
}

fn emitStrictFPComparison(LHS: SDValue, RHS: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, Chain: SDValue, IsSignaling: bool) -> SDValue {
    let mut VT: EVT = LHS.getValueType();
    assert!(VT != f128);
    let mut FullFP16: bool = DAG();
    if (VT == f16 && !FullFP16) || VT == bf16 {
        LHS = DAG.getNode(STRICT_FP_EXTEND, DL, [f32, Other], [Chain, LHS]);
        RHS = DAG.getNode(STRICT_FP_EXTEND, DL, [f32, Other], [LHS.getValue(1), RHS]);
        Chain = RHS.getValue(1);
    }
    let mut Opcode: u32 = 0;
    return DAG.getNode(Opcode, DL, [FlagsVT, Other], [Chain, LHS, RHS]);
}

fn emitComparison(LHS: SDValue, RHS: SDValue, CC: CondCode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = LHS.getValueType();
    let mut FullFP16: bool = DAG();
    if VT.isFloatingPoint() {
        assert!(VT != f128);
        if (VT == f16 && !FullFP16) || VT == bf16 {
            LHS = DAG.getNode(FP_EXTEND, DL, f32, LHS);
            RHS = DAG.getNode(FP_EXTEND, DL, f32, RHS);
        }
        return DAG;
    }
    let mut Opcode: u32 = 0;
    if isCMN(RHS, CC, DAG) {
        RHS = RHS.getOperand(1);
    } else if LHS.getOpcode() == SUB && isNullConstant(LHS.getOperand(0)) && isIntEqualitySetCC(CC) {
        LHS = LHS.getOperand(1);
    } else if isNullConstant(RHS) && !isUnsignedIntSetCC(CC) {
        if LHS.getOpcode() == AND {
            let mut ANDSNode: SDValue = DAG;
            DAG.ReplaceAllUsesWith(LHS, ANDSNode);
            return ANDSNode.getValue(1);
        } else if  {
            return LHS.getValue(1);
        }
    }
    return DAG.getNode(Opcode, DL, DAG.getVTList(VT, FlagsVT), LHS, RHS).getValue(1);
}

fn emitConditionalComparison(LHS: SDValue, RHS: SDValue, CC: CondCode, CCOp: SDValue, Predicate: CondCode, OutCC: CondCode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut Opcode: u32 = 0;
    let mut FullFP16: bool = DAG();
    if LHS.getValueType().isFloatingPoint() {
        assert!(LHS.getValueType() != f128);
        if (LHS.getValueType() == f16 && !FullFP16) || LHS.getValueType() == bf16 {
            LHS = DAG.getNode(FP_EXTEND, DL, f32, LHS);
            RHS = DAG.getNode(FP_EXTEND, DL, f32, RHS);
        }
    } else if dyn_cast(RHS) {
        Const;
    } else {
        let mut Imm: APInt = Const.getAPIntValue();
        if Imm.isNegative() && Imm.sgt(-32) {
            RHS = DAG.getConstant(Imm.abs(), DL, Const.getValueType(0), false, false);
        }
    }
    let mut Condition: SDValue = getCondCode(DAG, Predicate);
    let mut InvOutCC: CondCode = getInvertedCondCode(OutCC);
    let mut NZCV: u32 = getNZCVToSatisfyCondCode(InvOutCC);
    let mut NZCVOp: SDValue = DAG.getConstant(NZCV, DL, i32, false, false);
    return DAG.getNode(Opcode, DL, FlagsVT, LHS, RHS, NZCVOp, Condition, CCOp);
}

fn canEmitConjunction(DAG: *mut SelectionDAG, Val: SDValue, CanNegate: *mut bool, MustBeFirst: *mut bool, PreferFirst: *mut bool, WillNegate: bool, Depth: u32) -> bool {
    if !Val.hasOneUse() {
        return false;
    }
    let mut Opcode: u32 = operator(Val).getOpcode();
    if Opcode == SETCC {
        let mut VT: EVT = operator(Val).getOperand(0).getValueType();
        if VT == f128 {
            return false;
        }
        CanNegate = true;
        MustBeFirst = false;
        PreferFirst = DAG.doesNodeExist(SUB, DAG.getVTList(VT), [operator(Val).getOperand(0), operator(Val).getOperand(1)]);
        return true;
    }
    if Depth > 6 {
        return false;
    }
    if Opcode == AND || Opcode == OR {
        let mut IsOR: bool = Opcode == OR;
        let mut O0: SDValue = operator(Val).getOperand(0);
        let mut O1: SDValue = operator(Val).getOperand(1);
        let mut CanNegateL: bool = false;
        let mut MustBeFirstL: bool = false;
        let mut PreferFirstL: bool = false;
        if !canEmitConjunction(DAG, O0, CanNegateL, MustBeFirstL, PreferFirstL, IsOR, Depth + 1) {
            return false;
        }
        let mut CanNegateR: bool = false;
        let mut MustBeFirstR: bool = false;
        let mut PreferFirstR: bool = false;
        if !canEmitConjunction(DAG, O1, CanNegateR, MustBeFirstR, PreferFirstR, IsOR, Depth + 1) {
            return false;
        }
        if MustBeFirstL && MustBeFirstR {
            return false;
        }
        if IsOR {
            if !CanNegateL && !CanNegateR {
                return false;
            }
            CanNegate = WillNegate && CanNegateL && CanNegateR;
            MustBeFirst = !CanNegate;
        } else {
            assert!(Opcode == AND, "Must be OR or AND");
            CanNegate = false;
            MustBeFirst = MustBeFirstL || MustBeFirstR;
        }
        PreferFirst = PreferFirstL || PreferFirstR;
        return true;
    }
    return false;
}

fn emitConjunctionRec(DAG: *mut SelectionDAG, Val: SDValue, OutCC: *mut CondCode, Negate: bool, CCOp: SDValue, Predicate: CondCode) -> SDValue {
    let mut Opcode: u32 = operator(Val).getOpcode();
    if Opcode == SETCC {
        let mut LHS: SDValue = operator(Val).getOperand(0);
        let mut RHS: SDValue = operator(Val).getOperand(1);
        let mut CC: CondCode = cast(operator(Val).getOperand(2))();
        let mut isInteger: bool = LHS.getValueType().isInteger();
        if Negate {
            CC = getSetCCInverse(CC, LHS.getValueType());
        }
        let mut DL: SDLoc = Val;
        if isInteger {
            OutCC = changeIntCCToAArch64CC(CC, RHS);
        } else {
            assert!(LHS.getValueType().isFloatingPoint();
            let mut ExtraCC: CondCode = zeroed();
            changeFPCCToANDAArch64CC(CC, OutCC, ExtraCC);
            if ExtraCC != AL {
                let mut ExtraCmp: SDValue = SDValue {};
                if !CCOp.getNode() {
                    ExtraCmp = emitComparison(LHS, RHS, CC, DL, DAG);
                } else {
                    ExtraCmp = emitConditionalComparison(LHS, RHS, CC, CCOp, Predicate, ExtraCC, DL, DAG);
                }
                CCOp = ExtraCmp;
                Predicate = ExtraCC;
            }
        }
        if !CCOp {
            return emitComparison(LHS, RHS, CC, DL, DAG);
        }
        return emitConditionalComparison(LHS, RHS, CC, CCOp, Predicate, OutCC, DL, DAG);
    }
    assert!(operator(Val).hasOneUse(), "Valid conjunction/disjunction tree");
    let mut IsOR: bool = Opcode == OR;
    let mut LHS: SDValue = operator(Val).getOperand(0);
    let mut CanNegateL: bool = false;
    let mut MustBeFirstL: bool = false;
    let mut PreferFirstL: bool = false;
    let mut ValidL: bool = canEmitConjunction(DAG, LHS, CanNegateL, MustBeFirstL, PreferFirstL, IsOR, 0);
    assert!(ValidL, "Valid conjunction/disjunction tree");
    ValidL as void;
    let mut RHS: SDValue = operator(Val).getOperand(1);
    let mut CanNegateR: bool = false;
    let mut MustBeFirstR: bool = false;
    let mut PreferFirstR: bool = false;
    let mut ValidR: bool = canEmitConjunction(DAG, RHS, CanNegateR, MustBeFirstR, PreferFirstR, IsOR, 0);
    assert!(ValidR, "Valid conjunction/disjunction tree");
    ValidR as void;
    let mut ShouldFirstL: bool = PreferFirstL && !PreferFirstR && !MustBeFirstR;
    if MustBeFirstL || ShouldFirstL {
        assert!(!MustBeFirstR, "Valid conjunction/disjunction tree");
        swap(LHS, RHS);
        swap(CanNegateL, CanNegateR);
        swap(MustBeFirstL, MustBeFirstR);
    }
    let mut NegateR: bool = false;
    let mut NegateAfterR: bool = false;
    let mut NegateL: bool = false;
    let mut NegateAfterAll: bool = false;
    if Opcode == OR {
        if !CanNegateL {
            assert!(CanNegateR, "at least one side must be negatable");
            assert!(!MustBeFirstR, "invalid conjunction/disjunction tree");
            assert!(!Negate);
            swap(LHS, RHS);
            NegateR = false;
            NegateAfterR = true;
        } else {
            NegateR = CanNegateR;
            NegateAfterR = !CanNegateR;
        }
        NegateL = true;
        NegateAfterAll = !Negate;
    } else {
        assert!(Opcode == AND, "Valid conjunction/disjunction tree");
        assert!(!Negate, "Valid conjunction/disjunction tree");
        NegateL = false;
        NegateR = false;
        NegateAfterR = false;
        NegateAfterAll = false;
    }
    let mut RHSCC: CondCode = zeroed();
    let mut CmpR: SDValue = emitConjunctionRec(DAG, RHS, RHSCC, NegateR, CCOp, Predicate);
    if NegateAfterR {
        RHSCC = getInvertedCondCode(RHSCC);
    }
    let mut CmpL: SDValue = emitConjunctionRec(DAG, LHS, OutCC, NegateL, CmpR, RHSCC);
    if NegateAfterAll {
        OutCC = getInvertedCondCode(OutCC);
    }
    return CmpL;
}

fn emitConjunction(DAG: *mut SelectionDAG, Val: SDValue, OutCC: *mut CondCode) -> SDValue {
    let mut DummyCanNegate: bool = false;
    let mut DummyMustBeFirst: bool = false;
    let mut DummyPreferFirst: bool = false;
    if !canEmitConjunction(DAG, Val, DummyCanNegate, DummyMustBeFirst, DummyPreferFirst, false, 0) {
        return SDValue {};
    }
    return emitConjunctionRec(DAG, Val, OutCC, false, SDValue {}, AL);
}

fn isSupportedExtend(V: SDValue) -> bool {
    if V.getOpcode() == SIGN_EXTEND_INREG {
        return true;
    }
    if V.getOpcode() == AND {
        if dyn_cast(V.getOperand(1)) {
            MaskCst;
        } else {
            let mut Mask: u64 = MaskCst.getZExtValue();
            return (Mask == 255 || Mask == 65535 || Mask == 4294967295);
        }
    }
    return false;
}

fn getCmpOperandFoldingProfit(Op: SDValue, AllowExtend: bool) -> u32 {
    if !Op.hasOneUse() {
        return 0;
    }
    if AllowExtend && isSupportedExtend(Op) {
        return 1;
    }
    let mut Opc: u32 = Op.getOpcode();
    if Opc == SHL || Opc == SRL || Opc == SRA {
        if dyn_cast(Op.getOperand(1)) {
            ShiftCst;
        } else {
            let mut Shift: u64 = ShiftCst.getZExtValue();
            if AllowExtend && isSupportedExtend(Op.getOperand(0)) {
                return if (Shift <= 4) { 2 } else { 1 };
            }
            let mut VT: EVT = Op.getValueType();
            if (VT == i32 && Shift <= 31) || (VT == i64 && Shift <= 63) {
                return 1;
            }
        }
    }
    return 0;
}

fn getCmpOrCmnOperandFoldingProfit(Op: SDValue, CC: CondCode, DAG: *mut SelectionDAG) -> u32 {
    if isCMN(Op, CC, DAG) {
        return getCmpOperandFoldingProfit(Op.getOperand(1), true) + 1;
    }
    return getCmpOperandFoldingProfit(Op, true);
}

fn shouldBeAdjustedToZero(LHS: SDValue, C: *APInt, CC: *mut CondCode) -> bool {
    if  {
        return false;
    }
    if C.isOne() && (CC == SETLT || CC == SETGE) {
        CC = if (CC == SETLT) { SETLE } else { SETGT };
        return true;
    }
    if C.isAllOnes() && (CC == SETLE || CC == SETGT) {
        CC = if (CC == SETLE) { SETLT } else { SETGE };
        return true;
    }
    return false;
}

fn getAArch64Cmp(LHS: SDValue, RHS: SDValue, CC: CondCode, AArch64cc: *mut SDValue, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    if dyn_cast(RHS.getNode()) {
        RHSC;
    } else {
        let mut VT: EVT = RHS.getValueType();
        let mut C: APInt = RHSC.getAPIntValue();
        if shouldBeAdjustedToZero(LHS, C, CC) {
            RHS = DAG.getConstant(0, DL, VT, false, false);
        } else if !isLegalCmpImmed(C) {
            let mut NumImmForC: u32 = numberOfInstrToLoadImm(C);
            match CC {
                _ => {
                    break;
                },
                SETLT => {
                    SETGE;
                },
                SETULT => {
                    SETUGE;
                },
                SETLE => {
                    SETGT;
                },
                SETULE => {
                    SETUGT;
                },
            }
        } else if C.isZero() && getCmpOperandFoldingProfit(LHS, false) != 0 {
            swap(LHS, RHS);
            CC = getSetCCSwappedOperands(CC);
        }
    }
    if !isa(RHS) || !isLegalCmpImmed(operator(RHS).getAsAPIntVal()) {
        if getCmpOrCmnOperandFoldingProfit(LHS, CC, DAG) > getCmpOrCmnOperandFoldingProfit(RHS, CC, DAG) {
            swap(LHS, RHS);
            CC = getSetCCSwappedOperands(CC);
        }
    }
    let mut Cmp: SDValue = SDValue {};
    let mut AArch64CC: CondCode = zeroed();
    if isIntEqualitySetCC(CC) && isa(RHS) {
        let mut RHSC: *ConstantSDNode = cast(RHS);
        if (RHSC.getZExtValue() >> 16 == 0) && isa(LHS) && cast(LHS)() == ZEXTLOAD && cast(LHS)() == i16 && operator(LHS).hasNUsesOfValue(1, 0) {
            let mut ValueofRHS: i16 = operator(RHS).getAsZExtVal();
            if ValueofRHS < 0 && isLegalArithImmed(-ValueofRHS) {
                let mut SExt: SDValue = DAG.getNode(SIGN_EXTEND_INREG, DL, LHS.getValueType(), LHS, DAG.getValueType(i16));
                Cmp = emitComparison(SExt, DAG.getSignedConstant(ValueofRHS, DL, RHS.getValueType(), false, false), CC, DL, DAG);
                AArch64CC = changeIntCCToAArch64CC(CC, SDValue {});
            }
        }
        if !Cmp && (RHSC.isZero() || RHSC.isOne()) {
            if (Cmp = emitConjunction(DAG, LHS, AArch64CC)) {
                if (CC == SETNE) ^ RHSC.isZero() {
                    AArch64CC = getInvertedCondCode(AArch64CC);
                }
            }
        }
    }
    if !Cmp {
        Cmp = emitComparison(LHS, RHS, CC, DL, DAG);
        AArch64CC = changeIntCCToAArch64CC(CC, RHS);
    }
    AArch64cc = getCondCode(DAG, AArch64CC);
    return Cmp;
}

fn getAArch64XALUOOp(CC: *mut CondCode, Op: SDValue, DAG: *mut SelectionDAG) -> pair<SDValue, SDValue> {
    assert!((Op.getValueType() == i32 || Op.getValueType() == i64), "Unsupported value type");
    let mut Value: SDValue = SDValue {};
    let mut Overflow: SDValue = SDValue {};
    let mut DL: SDLoc = Op;
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    let mut Opc: u32 = 0;
    match Op.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unknown overflow instruction!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 4642);
        },
        SADDO => {
            
        },
        UADDO => {
            
        },
        SSUBO => {
            
        },
        USUBO => {
            
        },
        SMULO => {
            UMULO;
        },
    }
    if Opc {
        let mut VTs: SDVTList = DAG.getVTList(operator(Op).getValueType(0), FlagsVT);
        Value = DAG.getNode(Opc, DL, VTs, LHS, RHS);
        Overflow = Value.getValue(1);
    }
    return make_pair(Value, Overflow);
}

fn AArch64TargetLowering::LowerXOR(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if self.useSVEForFixedLengthVectorVT(Op.getValueType(), !self.Subtarget.isNeonAvailable()) {
        return self.LowerToScalableOp(Op, DAG);
    }
    let mut Sel: SDValue = Op.getOperand(0);
    let mut Other: SDValue = Op.getOperand(1);
    let mut DL: SDLoc = Sel;
    if isOneConstant(Other) && isOverflowIntrOpRes(Sel) {
        if !DAG.getTargetLoweringInfo().isTypeLegal(operator(Sel).getValueType(0)) {
            return SDValue {};
        }
        let mut TVal: SDValue = DAG.getConstant(1, DL, i32, false, false);
        let mut FVal: SDValue = DAG.getConstant(0, DL, i32, false, false);
        let mut CC: CondCode = zeroed();
        let mut Value: SDValue = SDValue {};
        let mut Overflow: SDValue = SDValue {};
        tie(Value, Overflow) = getAArch64XALUOOp(CC, Sel.getValue(0), DAG);
        let mut CCVal: SDValue = getCondCode(DAG, getInvertedCondCode(CC));
        return DAG;
    }
    if Sel.getOpcode() != SELECT_CC {
        swap(Sel, Other);
    }
    if Sel.getOpcode() != SELECT_CC {
        return Op;
    }
    let mut CC: CondCode = cast(Sel.getOperand(4))();
    let mut LHS: SDValue = Sel.getOperand(0);
    let mut RHS: SDValue = Sel.getOperand(1);
    let mut TVal: SDValue = Sel.getOperand(2);
    let mut FVal: SDValue = Sel.getOperand(3);
    if LHS.getValueType() != i32 && LHS.getValueType() != i64 {
        return Op;
    }
    let mut CFVal: *mut ConstantSDNode = dyn_cast(FVal);
    let mut CTVal: *mut ConstantSDNode = dyn_cast(TVal);
    if !CFVal || !CTVal {
        return Op;
    }
    if CTVal.isAllOnes() && CFVal.isZero() {
        swap(TVal, FVal);
        swap(CTVal, CFVal);
        CC = getSetCCInverse(CC, LHS.getValueType());
    }
    if CTVal.isZero() && CFVal.isAllOnes() {
        let mut CCVal: SDValue = SDValue {};
        let mut Cmp: SDValue = getAArch64Cmp(LHS, RHS, CC, CCVal, DAG, DL);
        FVal = Other;
        TVal = DAG.getNode(XOR, DL, Other.getValueType(), Other, DAG.getAllOnesConstant(DL, Other.getValueType(), false, false));
        return DAG;
    }
    return Op;
}

fn valueToCarryFlag(Value: SDValue, DAG: *mut SelectionDAG, Invert: bool) -> SDValue {
    let mut DL: SDLoc = Value;
    let mut VT: EVT = Value.getValueType();
    let mut Op0: SDValue = if Invert { DAG.getConstant(0, DL, VT, false, false) } else { Value };
    let mut Op1: SDValue = if Invert { Value } else { DAG.getConstant(1, DL, VT, false, false) };
    let mut Cmp: SDValue = DAG;
    return Cmp.getValue(1);
}

fn carryFlagToValue(Glue: SDValue, VT: EVT, DAG: *mut SelectionDAG, Invert: bool) -> SDValue {
    assert!(Glue.getResNo() == 1);
    let mut DL: SDLoc = Glue;
    let mut Zero: SDValue = DAG.getConstant(0, DL, VT, false, false);
    let mut One: SDValue = DAG.getConstant(1, DL, VT, false, false);
    let mut Cond: CondCode = if Invert { LO } else { HS };
    let mut CC: SDValue = getCondCode(DAG, Cond);
    return DAG;
}

fn overflowFlagToValue(Glue: SDValue, VT: EVT, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Glue.getResNo() == 1);
    let mut DL: SDLoc = Glue;
    let mut Zero: SDValue = DAG.getConstant(0, DL, VT, false, false);
    let mut One: SDValue = DAG.getConstant(1, DL, VT, false, false);
    let mut CC: SDValue = getCondCode(DAG, VS);
    return DAG;
}

fn lowerADDSUBO_CARRY(Op: SDValue, DAG: *mut SelectionDAG, Opcode: u32, IsSigned: bool) -> SDValue {
    let mut VT0: EVT = Op.getValue(0).getValueType();
    let mut VT1: EVT = Op.getValue(1).getValueType();
    if VT0 != i32 && VT0 != i64 {
        return SDValue {};
    }
    let mut InvertCarry: bool = false;
    let mut OpLHS: SDValue = Op.getOperand(0);
    let mut OpRHS: SDValue = Op.getOperand(1);
    let mut OpCarryIn: SDValue = valueToCarryFlag(Op.getOperand(2), DAG, InvertCarry);
    let mut DL: SDLoc = Op;
    let mut Sum: SDValue = DAG.getNode(Opcode, DL, DAG.getVTList(VT0, FlagsVT), OpLHS, OpRHS, OpCarryIn);
    let mut OutFlag: SDValue = if IsSigned { overflowFlagToValue(Sum.getValue(1), VT1, DAG) } else { carryFlagToValue(Sum.getValue(1), VT1, DAG, InvertCarry) };
    return DAG.getMergeValues([Sum, OutFlag], DL);
}

fn lowerIntNeonIntrinsic(Op: SDValue, Opcode: u32, DAG: *mut SelectionDAG, LastOperandIsImm: bool) -> SDValue {
    if Op.getValueType().isVector() {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut NewOps: SmallVector<SDValue, 2> = zeroed();
    let mut NumOperands: u32 = Op.getNumOperands();
    let mut getFloatVT: Closure_2 = Closure_2 {};
    let mut bitcastToFloat: Closure_3 = Closure_3 { DAG: &mut DAG, getFloatVT: &mut getFloatVT };
    for let mut I: u32 = 1; I < NumOperands; I += 1 {
        let mut Val: SDValue = Op.getOperand(I);
        let mut KeepInt: bool = LastOperandIsImm && (I == NumOperands - 1);
        NewOps()(if KeepInt { Val } else { bitcastToFloat.call(Val) });
    }
    let mut OrigVT: EVT = Op.getValueType();
    let mut OpNode: SDValue = DAG(Opcode, DL, getFloatVT.call(OrigVT));
    return DAG.getBitcast(OrigVT, OpNode);
}

fn LowerXALUO(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if !DAG.getTargetLoweringInfo().isTypeLegal(Op.getValueType()) {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut CC: CondCode = zeroed();
    let mut Value: SDValue = SDValue {};
    let mut Overflow: SDValue = SDValue {};
    tie(Value, Overflow) = getAArch64XALUOOp(CC, Op, DAG);
    let mut TVal: SDValue = DAG.getConstant(1, DL, i32, false, false);
    let mut FVal: SDValue = DAG.getConstant(0, DL, i32, false, false);
    let mut CCVal: SDValue = getCondCode(DAG, getInvertedCondCode(CC));
    Overflow = DAG;
    return DAG.getMergeValues([Value, Overflow], DL);
}

fn LowerPREFETCH(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut IsWrite: u32 = Op.getConstantOperandVal(2);
    let mut Locality: u32 = Op.getConstantOperandVal(3);
    let mut IsData: u32 = Op.getConstantOperandVal(4);
    let mut IsStream: bool = !Locality;
    if Locality {
        assert!(Locality <= 3, "Prefetch locality out-of-range");
        Locality = 3 - Locality;
    }
    let mut PrfOp: u32 = (IsWrite << 4) | (!IsData << 3) | (Locality << 1) | IsStream as u32;
    return DAG;
}

fn simplifySetCCIntoEq(CC: *mut CondCode, LHS: *mut SDValue, RHS: *mut SDValue, DAG: *mut SelectionDAG, DL: SDLoc) {
    if CC == SETULT && LHS.getOpcode() == AND && operator(LHS).hasOneUse() {
        let mut LHSConstOp: *mut ConstantSDNode = dyn_cast(LHS.getOperand(1));
        let mut RHSConst: *mut ConstantSDNode = dyn_cast(RHS);
        if LHSConstOp && RHSConst {
            let mut LHSConstValue: u64 = LHSConstOp.getZExtValue();
            let mut RHSConstant: u64 = RHSConst.getZExtValue();
            if isPowerOf2_64(RHSConstant) {
                let mut NewMaskValue: u64 = LHSConstValue & ~(RHSConstant - 1);
                LHS = DAG.getNode(AND, DL, LHS.getValueType(), LHS.getOperand(0), DAG.getConstant(NewMaskValue, DL, LHS.getValueType(), false, false));
                RHS = DAG.getConstant(0, DL, RHS.getValueType(), false, false);
                CC = SETEQ;
            }
        }
    }
}

fn AArch64TargetLowering::LowerFP_EXTEND(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    if VT.isScalableVector() {
        let mut SrcVal: SDValue = Op.getOperand(0);
        if VT == nxv2f64 && SrcVal.getValueType() == nxv2bf16 {
            if IsStrict {
                return SDValue {};
            }
            let mut DL: SDLoc = Op;
            return DAG.getNode(FP_EXTEND, DL, VT, DAG.getNode(FP_EXTEND, DL, nxv2f32, SrcVal));
        }
        return self.LowerToPredicatedOp;
    }
    if self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()) {
        return self.LowerFixedLengthFPExtendToSVE(Op, DAG);
    }
    let mut Op0: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut Op0VT: EVT = Op0.getValueType();
    if VT == f64 {
        if Op0VT == f32 || Op0VT == f16 {
            return Op;
        }
        if Op0VT == bf16 && IsStrict {
            let mut Ext1: SDValue = DAG.getNode(STRICT_FP_EXTEND, Op, [f32, Other], [Op.getOperand(0), Op0]);
            return DAG.getNode(STRICT_FP_EXTEND, Op, [VT, Other], [Ext1.getValue(1), Ext1]);
        }
        if Op0VT == bf16 {
            return DAG.getNode(FP_EXTEND, Op, VT, DAG.getNode(FP_EXTEND, Op, f32, Op0));
        }
        return SDValue {};
    }
    assert!(Op.getValueType() == f128, "Unexpected lowering");
    return SDValue {};
}

fn AArch64TargetLowering::LowerFP_ROUND(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut SrcVal: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut SrcVT: EVT = SrcVal.getValueType();
    let mut Trunc: bool = Op.getConstantOperandVal(if IsStrict { 2 } else { 1 }) == 1;
    let mut Flags: SDNodeFlags = operator(Op).getFlags();
    if VT.isScalableVector() {
        if SrcVT == nxv8f32 {
            return Op;
        }
        if VT.getScalarType() != bf16 {
            return self.LowerToPredicatedOp;
        }
        if IsStrict {
            return SDValue {};
        }
        let mut DL: SDLoc = Op;
        let mut I32: EVT = nxv4i32;
        let mut ImmV: Closure_4 = Closure_4 { DAG: &mut DAG, DL: &mut DL, I32: &mut I32 };
        let mut NaN: SDValue = SDValue {};
        let mut Narrow: SDValue = SDValue {};
        if SrcVT == nxv2f32 || SrcVT == nxv4f32 {
            if self.Subtarget() {
                return self.LowerToPredicatedOp;
            }
            Narrow = self.getSVESafeBitCast(I32, SrcVal, DAG);
            if !DAG.isKnownNeverSNaN(SrcVal, 0) && !Flags.hasNoNaNs() {
                NaN = DAG.getNode(OR, DL, I32, Narrow, ImmV.call(4194304));
            }
        } else if SrcVT == nxv2f64 && (self.Subtarget() || self.Subtarget.isStreamingSVEAvailable()) {
            let mut Pg: SDValue = getPredicateForVector(DAG, DL, nxv2f32);
            Narrow = DAG;
            let mut NewOps: SmallVector<SDValue, 3> = zeroed();
            if IsStrict {
                NewOps()(Op.getOperand(0));
            }
            NewOps()(Narrow);
            NewOps()(Op.getOperand(if IsStrict { 2 } else { 1 }));
            return DAG(Op.getOpcode(), DL, VT, operator(Op).getFlags());
        } else {
            return SDValue {};
        }
        if !Trunc {
            let mut Lsb: SDValue = DAG.getNode(SRL, DL, I32, Narrow, ImmV.call(16));
            Lsb = DAG.getNode(AND, DL, I32, Lsb, ImmV.call(1));
            let mut RoundingBias: SDValue = DAG.getNode(ADD, DL, I32, Lsb, ImmV.call(32767));
            Narrow = DAG.getNode(ADD, DL, I32, Narrow, RoundingBias);
        }
        if NaN {
            let mut I1: EVT = I32.changeElementType(*DAG.getContext(), i1);
            let mut CondVT: EVT = VT.changeElementType(*DAG.getContext(), i1);
            let mut IsNaN: SDValue = DAG.getSetCC(DL, CondVT, SrcVal, SrcVal, SETUO, SDValue {}, false, None);
            IsNaN = DAG;
            Narrow = DAG.getSelect(DL, I32, IsNaN, NaN, Narrow, SDNodeFlags { Flags: None });
        }
        Narrow = DAG.getNode(SRL, DL, I32, Narrow, ImmV.call(16));
        return self.getSVESafeBitCast(VT, Narrow, DAG);
    }
    if self.useSVEForFixedLengthVectorVT(SrcVT, !self.Subtarget.isNeonAvailable()) {
        return self.LowerFixedLengthFPRoundToSVE(Op, DAG);
    }
    if VT.getScalarType() == bf16 && operator!(((self.Subtarget() || self.Subtarget()) && self.Subtarget())) {
        let mut DL: SDLoc = Op;
        let mut Narrow: SDValue = SrcVal;
        let mut NaN: SDValue = SDValue {};
        let mut I32: EVT = SrcVT.changeElementType(*DAG.getContext(), i32);
        let mut F32: EVT = SrcVT.changeElementType(*DAG.getContext(), f32);
        if SrcVT.getScalarType() == f32 {
            let mut NeverSNaN: bool = DAG.isKnownNeverSNaN(Narrow, 0);
            Narrow = DAG.getNode(BITCAST, DL, I32, Narrow);
            if !NeverSNaN {
                NaN = DAG.getNode(OR, DL, I32, Narrow, DAG.getConstant(4194304, DL, I32, false, false));
            }
        } else if SrcVT.getScalarType() == f64 {
            Narrow = DAG;
            Narrow = DAG.getNode(BITCAST, DL, I32, Narrow);
        } else {
            return SDValue {};
        }
        if !Trunc {
            let mut One: SDValue = DAG.getConstant(1, DL, I32, false, false);
            let mut Lsb: SDValue = DAG.getNode(SRL, DL, I32, Narrow, DAG.getShiftAmountConstant(16, I32, DL));
            Lsb = DAG.getNode(AND, DL, I32, Lsb, One);
            let mut RoundingBias: SDValue = DAG.getNode(ADD, DL, I32, DAG.getConstant(32767, DL, I32, false, false), Lsb);
            Narrow = DAG.getNode(ADD, DL, I32, Narrow, RoundingBias);
        }
        if NaN {
            let mut IsNaN: SDValue = DAG.getSetCC(DL, self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), SrcVT), SrcVal, SrcVal, SETUO, SDValue {}, false, None);
            Narrow = DAG.getSelect(DL, I32, IsNaN, NaN, Narrow, SDNodeFlags { Flags: None });
        }
        Narrow = DAG.getNode(SRL, DL, I32, Narrow, DAG.getShiftAmountConstant(16, I32, DL));
        if VT.isVector() {
            let mut I16: EVT = I32.changeVectorElementType(*DAG.getContext(), i16);
            Narrow = DAG.getNode(TRUNCATE, DL, I16, Narrow);
            return DAG.getNode(BITCAST, DL, VT, Narrow);
        }
        Narrow = DAG.getNode(BITCAST, DL, F32, Narrow);
        let mut Result: SDValue = DAG.getTargetExtractSubreg;
        return if IsStrict { DAG.getMergeValues([Result, Op.getOperand(0)], DL) } else { Result };
    }
    if SrcVT != f128 {
        if self.useSVEForFixedLengthVectorVT(SrcVT, false) {
            return SDValue {};
        }
        return Op;
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerVectorFP_TO_INT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut InVT: EVT = Op.getOperand(if IsStrict { 1 } else { 0 }).getValueType();
    let mut VT: EVT = Op.getValueType();
    if (InVT.getVectorElementType() == f16 && operator!(self.Subtarget())) || InVT.getVectorElementType() == bf16 {
        let mut NewVT: EVT = VT.changeElementType(*DAG.getContext(), f32);
        let mut DL: SDLoc = Op;
        if IsStrict {
            let mut Ext: SDValue = DAG.getNode(STRICT_FP_EXTEND, DL, [NewVT, Other], [Op.getOperand(0), Op.getOperand(1)]);
            return DAG.getNode(Op.getOpcode(), DL, [VT, Other], [Ext.getValue(1), Ext.getValue(0)]);
        }
        return DAG.getNode(Op.getOpcode(), DL, Op.getValueType(), DAG.getNode(FP_EXTEND, DL, NewVT, Op.getOperand(0)));
    }
    if self.LowerFPToIntToSVE(Op, DAG) {
        Res;
    } else {
        return Res;
    }
    let mut VTSize: u64 = VT.getFixedSizeInBits();
    let mut InVTSize: u64 = InVT.getFixedSizeInBits();
    if VTSize < InVTSize {
        let mut DL: SDLoc = Op;
        if IsStrict {
            InVT = InVT.changeVectorElementTypeToInteger();
            let mut Cv: SDValue = DAG.getNode(Op.getOpcode(), DL, [InVT, Other], [Op.getOperand(0), Op.getOperand(1)]);
            let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, VT, Cv);
            return DAG.getMergeValues([Trunc, Cv.getValue(1)], DL);
        }
        let mut Cv: SDValue = DAG.getNode(Op.getOpcode(), DL, InVT.changeVectorElementTypeToInteger(), Op.getOperand(0));
        return DAG.getNode(TRUNCATE, DL, VT, Cv);
    }
    if VTSize > InVTSize {
        let mut DL: SDLoc = Op;
        let mut ExtVT: MVT = getVectorVT(getFloatingPointVT(VT.getScalarSizeInBits()), VT.getVectorNumElements());
        if IsStrict {
            let mut Ext: SDValue = DAG.getNode(STRICT_FP_EXTEND, DL, [ExtVT, Other], [Op.getOperand(0), Op.getOperand(1)]);
            return DAG.getNode(Op.getOpcode(), DL, [VT, Other], [Ext.getValue(1), Ext.getValue(0)]);
        }
        let mut Ext: SDValue = DAG.getNode(FP_EXTEND, DL, ExtVT, Op.getOperand(0));
        return DAG.getNode(Op.getOpcode(), DL, VT, Ext);
    }
    if InVT.getVectorNumElements() == 1 {
        let mut DL: SDLoc = Op;
        let mut Extract: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, InVT.getScalarType(), Op.getOperand(if IsStrict { 1 } else { 0 }), DAG.getConstant(0, DL, i64, false, false));
        let mut ScalarVT: EVT = VT.getScalarType();
        if IsStrict {
            return DAG.getNode(Op.getOpcode(), DL, [ScalarVT, Other], [Op.getOperand(0), Extract]);
        }
        return DAG.getNode(Op.getOpcode(), DL, ScalarVT, Extract);
    }
    return Op;
}

fn AArch64TargetLowering::LowerFP_TO_INT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut SrcVal: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    if SrcVal.getValueType().isVector() {
        return self.LowerVectorFP_TO_INT(Op, DAG);
    }
    if (SrcVal.getValueType() == f16 && operator!(self.Subtarget())) || SrcVal.getValueType() == bf16 {
        let mut DL: SDLoc = Op;
        if IsStrict {
            let mut Ext: SDValue = DAG.getNode(STRICT_FP_EXTEND, DL, [f32, Other], [Op.getOperand(0), SrcVal]);
            return DAG.getNode(Op.getOpcode(), DL, [Op.getValueType(), Other], [Ext.getValue(1), Ext.getValue(0)]);
        }
        return DAG.getNode(Op.getOpcode(), DL, Op.getValueType(), DAG.getNode(FP_EXTEND, DL, f32, SrcVal));
    }
    if SrcVal.getValueType() != f128 {
        return Op;
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerVectorFP_TO_INT_SAT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut SrcVal: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = SrcVal.getValueType();
    let mut DstVT: EVT = Op.getValueType();
    let mut DstElementVT: EVT = DstVT.getVectorElementType();
    let mut SatVT: EVT = cast(Op.getOperand(1))();
    let mut DstElementWidth: u64 = DstVT.getScalarSizeInBits();
    let mut SrcElementWidth: u64 = SrcVT.getScalarSizeInBits();
    let mut SatWidth: u64 = SatVT.getScalarSizeInBits();
    assert!(SatWidth <= DstElementWidth, "Saturation width cannot exceed result width");
    let mut SrcElementVT: EVT = SrcVT.getVectorElementType();
    if SrcElementVT != f64 && SrcElementVT != f32 && SrcElementVT != f16 && SrcElementVT != bf16 {
        return SDValue {};
    }
    if self.LowerFPToIntToSVE(Op, DAG) {
        Res;
    } else {
        return Res;
    }
    let mut CanHandleNatively: Closure_5 = Closure_5 { DstVT: &mut DstVT, SatWidth: &mut SatWidth };
    let mut Expand: Closure_6 = Closure_6 { SatWidth: &mut SatWidth, CanHandleNatively: &mut CanHandleNatively };
    let mut PromVT: optional<EVT> = zeroed();
    match SrcElementVT.getSimpleVT().SimpleTy {
        f16 => {
            bf16;
        },
        f32 => {
            if DstElementVT == i64 {
                PromVT() = getVectorVT(f64, SrcVT.getVectorElementCount());
                break;
            }
        },
        _ => {
            break;
        },
    }
    let mut DL: SDLoc = Op;
    let mut Opc: u32 = Op.getOpcode();
    if PromVT() && operator!(Expand(operator*())) {
        SrcVal = DAG(FP_EXTEND, DL, operator*(), SrcVal);
        if operator*() != v8f32 || self.isTypeLegal(v8f32) {
            return DAG.getNode(Op.getOpcode(), DL, DstVT, SrcVal, Op.getOperand(1));
        }
        let mut Lo: SDValue = DAG.getNode(Opc, DL, v4i32, SrcValLo, Op.getOperand(1));
        let mut Hi: SDValue = DAG.getNode(Opc, DL, v4i32, SrcValHi, Op.getOperand(1));
        Lo = DAG.getNode(TRUNCATE, DL, v4i16, Lo);
        Hi = DAG.getNode(TRUNCATE, DL, v4i16, Hi);
        return DAG.getNode(CONCAT_VECTORS, DL, DstVT, Lo, Hi);
    }
    if CanHandleNatively.call(SrcVT) {
        assert!(self.isTypeLegal(SrcVT), "Expected SrcVT to be a legal type");
        return DAG.getNode(Opc, DL, DstVT, SrcVal, DAG.getValueType(DstVT.getScalarType()));
    } else if Expand.call(SrcVT) {
        return SDValue {};
    }
    assert!((SrcElementWidth > DstElementWidth) || (SrcElementWidth == DstElementWidth && SatWidth < DstElementWidth);
    let mut IntVT: EVT = SrcVT.changeVectorElementTypeToInteger();
    let mut NativeCvt: SDValue = DAG.getNode(Opc, DL, IntVT, SrcVal, DAG.getValueType(IntVT.getScalarType()));
    let mut Sat: SDValue = SDValue {};
    if Opc == FP_TO_SINT_SAT {
        let mut MinC: SDValue = DAG.getConstant(getSignedMaxValue(SatWidth).sext(SrcElementWidth), DL, IntVT, false, false);
        let mut Min: SDValue = DAG.getNode(SMIN, DL, IntVT, NativeCvt, MinC);
        let mut MaxC: SDValue = DAG.getConstant(getSignedMinValue(SatWidth).sext(SrcElementWidth), DL, IntVT, false, false);
        Sat = DAG.getNode(SMAX, DL, IntVT, Min, MaxC);
    } else {
        let mut MinC: SDValue = DAG.getConstant(getAllOnes(SatWidth).zext(SrcElementWidth), DL, IntVT, false, false);
        Sat = DAG.getNode(UMIN, DL, IntVT, NativeCvt, MinC);
    }
    return DAG.getNode(TRUNCATE, DL, DstVT, Sat);
}

fn AArch64TargetLowering::LowerFP_TO_INT_SAT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut SrcVal: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = SrcVal.getValueType();
    if SrcVT.isVector() {
        return self.LowerVectorFP_TO_INT_SAT(Op, DAG);
    }
    let mut DstVT: EVT = Op.getValueType();
    let mut SatVT: EVT = cast(Op.getOperand(1))();
    let mut SatWidth: u64 = SatVT.getScalarSizeInBits();
    let mut DstWidth: u64 = DstVT.getScalarSizeInBits();
    assert!(SatWidth <= DstWidth, "Saturation width cannot exceed result width");
    if (SrcVT == f16 && operator!(self.Subtarget())) || SrcVT == bf16 {
        SrcVal = DAG.getNode(FP_EXTEND, Op, f32, SrcVal);
        SrcVT = f32;
    } else if SrcVT != f64 && SrcVT != f32 && SrcVT != f16 && SrcVT != bf16 {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    if (SrcVT == f64 || SrcVT == f32 || (SrcVT == f16 && self.Subtarget())) && DstVT == SatVT && (DstVT == i64 || DstVT == i32) {
        return DAG.getNode(Op.getOpcode(), DL, DstVT, SrcVal, DAG.getValueType(DstVT));
    }
    if DstWidth < SatWidth {
        return SDValue {};
    }
    if SrcVT == f16 && SatVT == i16 && DstVT == i32 {
        if Op.getOpcode() == FP_TO_SINT_SAT {
            let mut CVTf32: SDValue = DAG;
            let mut Bitcast: SDValue = DAG.getBitcast(DstVT, CVTf32);
            return DAG.getNode(SIGN_EXTEND_INREG, DL, DstVT, Bitcast, DAG.getValueType(SatVT));
        }
        let mut CVTf32: SDValue = DAG;
        return DAG.getBitcast(DstVT, CVTf32);
    }
    let mut NativeCvt: SDValue = DAG.getNode(Op.getOpcode(), DL, DstVT, SrcVal, DAG.getValueType(DstVT));
    let mut Sat: SDValue = SDValue {};
    if Op.getOpcode() == FP_TO_SINT_SAT {
        let mut MinC: SDValue = DAG.getConstant(getSignedMaxValue(SatWidth).sext(DstWidth), DL, DstVT, false, false);
        let mut Min: SDValue = DAG.getNode(SMIN, DL, DstVT, NativeCvt, MinC);
        let mut MaxC: SDValue = DAG.getConstant(getSignedMinValue(SatWidth).sext(DstWidth), DL, DstVT, false, false);
        Sat = DAG.getNode(SMAX, DL, DstVT, Min, MaxC);
    } else {
        let mut MinC: SDValue = DAG.getConstant(getAllOnes(SatWidth).zext(DstWidth), DL, DstVT, false, false);
        Sat = DAG.getNode(UMIN, DL, DstVT, NativeCvt, MinC);
    }
    return DAG.getNode(TRUNCATE, DL, DstVT, Sat);
}

fn AArch64TargetLowering::LowerVectorXRINT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut Src: SDValue = Op.getOperand(0);
    let mut DL: SDLoc = Op;
    assert!(VT.isVector(), "Expected vector type");
    let mut CastVT: EVT = VT.changeVectorElementType(*DAG.getContext(), Src.getValueType().getVectorElementType());
    let mut FOp: SDValue = DAG.getNode(FRINT, DL, CastVT, Src);
    return DAG.getNode(FP_TO_SINT_SAT, DL, VT, FOp, DAG.getValueType(VT.getVectorElementType()));
}

fn AArch64TargetLowering::LowerVectorINT_TO_FP(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut In: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut InVT: EVT = In.getValueType();
    let mut Opc: u32 = Op.getOpcode();
    let mut IsSigned: bool = Opc == SINT_TO_FP || Opc == STRICT_SINT_TO_FP;
    if InVT.isScalableVectorOf(i1) && !IsStrict {
        let mut FalseVal: SDValue = DAG.getConstantFP(0.0, DL, VT, false);
        let mut TrueVal: SDValue = if IsSigned { DAG.getConstantFP(-1.0, DL, VT, false) } else { DAG.getConstantFP(1.0, DL, VT, false) };
        return DAG.getNode(VSELECT, DL, VT, In, TrueVal, FalseVal);
    }
    if VT.getVectorElementType() == bf16 {
        let mut F32: EVT = VT.changeElementType(*DAG.getContext(), f32);
        if IsStrict {
            let mut Val: SDValue = DAG.getNode(Op.getOpcode(), DL, [F32, Other], [Op.getOperand(0), In]);
            return DAG.getNode(STRICT_FP_ROUND, DL, operator(Op).getVTList(), [Val.getValue(1), Val.getValue(0), DAG.getIntPtrConstant(0, DL, true)]);
        }
        return DAG.getNode(FP_ROUND, DL, Op.getValueType(), DAG.getNode(Op.getOpcode(), DL, F32, In), DAG.getIntPtrConstant(0, DL, true));
    }
    if VT.isScalableVector() {
        if VT == nxv8f32 {
            return Op;
        }
        let mut Opcode: u32 = 0;
        return self.LowerToPredicatedOp(Op, DAG, Opcode);
    }
    if self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()) || self.useSVEForFixedLengthVectorVT(InVT, !self.Subtarget.isNeonAvailable()) {
        return self.LowerFixedLengthIntToFPToSVE(Op, DAG);
    }
    let mut VTSize: u64 = VT.getFixedSizeInBits();
    let mut InVTSize: u64 = InVT.getFixedSizeInBits();
    if VTSize < InVTSize {
        let mut IsTargetf32: bool = VT.getVectorElementType() == f32;
        let mut IsTargetf16: bool = false;
        if Op.hasOneUse() && operator(operator(Op).user_begin()).getOpcode() == CONCAT_VECTORS {
            let mut U: *mut SDNode = operator(operator(Op).user_begin());
            if U.hasOneUse() && operator(U.user_begin()).getOpcode() == FP_ROUND {
                let mut TmpVT: EVT = operator(U.user_begin()).getValueType(0);
                if TmpVT.getScalarType() == f16 {
                    IsTargetf16 = true;
                }
            }
        }
        if IsTargetf32 && !IsTargetf16 {
            return if !IsStrict { DAG.UnrollVectorOp(Op.getNode(), 0) } else { SDValue {} };
        }
        let mut CastVT: MVT = getVectorVT(getFloatingPointVT(InVT.getScalarSizeInBits()), InVT.getVectorNumElements());
        if IsStrict {
            In = DAG.getNode(Opc, DL, [CastVT, Other], [Op.getOperand(0), In]);
            return DAG.getNode(STRICT_FP_ROUND, DL, [VT, Other], [In.getValue(1), In.getValue(0), DAG.getIntPtrConstant(0, DL, true)]);
        }
        In = DAG.getNode(Opc, DL, CastVT, In);
        return DAG.getNode(FP_ROUND, DL, VT, In, DAG.getIntPtrConstant(0, DL, true));
    }
    if VTSize > InVTSize {
        let mut CastOpc: u32 = if IsSigned { SIGN_EXTEND } else { ZERO_EXTEND };
        let mut CastVT: EVT = VT.changeVectorElementTypeToInteger();
        In = DAG.getNode(CastOpc, DL, CastVT, In);
        if IsStrict {
            return DAG.getNode(Opc, DL, [VT, Other], [Op.getOperand(0), In]);
        }
        return DAG.getNode(Opc, DL, VT, In);
    }
    if VT.getVectorNumElements() == 1 {
        let mut Extract: SDValue = DAG.getExtractVectorElt(DL, InVT.getScalarType(), In, 0);
        let mut ScalarVT: EVT = VT.getScalarType();
        if IsStrict {
            return DAG.getNode(Op.getOpcode(), DL, [ScalarVT, Other], [Op.getOperand(0), Extract]);
        }
        return DAG.getNode(Op.getOpcode(), DL, ScalarVT, Extract);
    }
    return Op;
}

fn AArch64TargetLowering::LowerINT_TO_FP(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if Op.getValueType().isVector() {
        return self.LowerVectorINT_TO_FP(Op, DAG);
    }
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut SrcVal: SDValue = Op.getOperand(if IsStrict { 1 } else { 0 });
    let mut IsSigned: bool = operator(Op).getOpcode() == STRICT_SINT_TO_FP || operator(Op).getOpcode() == SINT_TO_FP;
    let mut IntToFpViaPromotion: Closure_7 = Closure_7 { Op: &mut Op, IsStrict: &mut IsStrict, DAG: &mut DAG, SrcVal: &mut SrcVal };
    if Op.getValueType() == bf16 {
        let mut MaxWidth: u32 = if IsSigned { DAG.ComputeMaxSignificantBits(SrcVal, 0) } else { DAG.computeKnownBits(SrcVal, 0).countMaxActiveBits() };
        if MaxWidth <= 24 {
            return IntToFpViaPromotion.call(f32);
        }
        if MaxWidth <= 53 {
            return IntToFpViaPromotion.call(f64);
        }
        if SrcVal.getValueType() == i64 {
            let mut DL: SDLoc = Op;
            let mut SignBit: SDValue = SDValue {};
            if IsSigned {
                SignBit = DAG.getNode(AND, DL, i64, SrcVal, DAG.getConstant(1 << 63, DL, i64, false, false));
                SrcVal = DAG.getNode(ABS, DL, i64, SrcVal);
            }
            let mut SrcHi: SDValue = DAG.getNode(AND, DL, i64, SrcVal, DAG.getConstant(~4095, DL, i64, false, false));
            let mut SrcLo: SDValue = DAG.getNode(AND, DL, i64, SrcVal, DAG.getConstant(4095, DL, i64, false, false));
            let mut Highest: SDValue = DAG.getNode(SRL, DL, i64, SrcVal, DAG.getShiftAmountConstant(53, i64, DL));
            let mut Zero64: SDValue = DAG.getConstant(0, DL, i64, false, false);
            let mut ToRound: SDValue = DAG.getSelectCC(DL, Highest, Zero64, SrcHi, SrcVal, SETNE, SDNodeFlags { Flags: None });
            let mut Rounded: SDValue = if IsStrict { DAG.getNode(Op.getOpcode(), DL, [f64, Other], [Op.getOperand(0), ToRound]) } else { DAG.getNode(Op.getOpcode(), DL, f64, ToRound) };
            let mut RoundedBits: SDValue = DAG.getNode(BITCAST, DL, i64, Rounded);
            if SignBit {
                RoundedBits = DAG.getNode(OR, DL, i64, RoundedBits, SignBit);
            }
            let mut HasHighest: SDValue = DAG.getSetCC(DL, self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), i64), Highest, Zero64, SETNE, SDValue {}, false, None);
            let mut HasLo: SDValue = DAG.getSetCC(DL, self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), i64), SrcLo, Zero64, SETNE, SDValue {}, false, None);
            let mut NeedsAdjustment: SDValue = DAG.getNode(AND, DL, HasLo.getValueType(), HasHighest, HasLo);
            NeedsAdjustment = DAG.getZExtOrTrunc(NeedsAdjustment, DL, i64);
            let mut AdjustedBits: SDValue = DAG.getNode(OR, DL, i64, RoundedBits, NeedsAdjustment);
            let mut Adjusted: SDValue = DAG.getNode(BITCAST, DL, f64, AdjustedBits);
            return if IsStrict { DAG.getNode(STRICT_FP_ROUND, DL, [Op.getValueType(), Other], [Rounded.getValue(1), Adjusted, DAG.getIntPtrConstant(0, DL, true)]) } else { DAG.getNode(FP_ROUND, DL, Op.getValueType(), Adjusted, DAG.getIntPtrConstant(0, DL, true)) };
        }
    }
    if Op.getValueType() == f16 && operator!(self.Subtarget()) {
        return IntToFpViaPromotion.call(f32);
    }
    if SrcVal.getValueType() == i128 {
        return SDValue {};
    }
    if Op.getValueType() != f128 {
        return Op;
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerLOOP_DEPENDENCE_MASK(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    (((operator!(operator!(((self.Subtarget() || (self.Subtarget() && self.Subtarget.isStreaming())) && "Lowering loop_dependence_raw_mask or loop_dependence_war_mask requires SVE or SME")))) || (_wassert(L"(Subtarget->hasSVE2() || (Subtarget->hasSME() && Subtarget->isStreaming())) && \"Lowering loop_dependence_raw_mask or loop_dependence_war_mask \" \"requires SVE or SME\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (5757) as u32) , 0)) as void);
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut LaneOffset: u32 = Op.getConstantOperandVal(3);
    let mut NumElements: u32 = VT.getVectorMinNumElements();
    let mut EltSizeInBytes: u64 = Op.getConstantOperandVal(2);
    let mut AddrTy: EVT = operator(Op).getOperand(0).getValueType();
    if LaneOffset != 0 || !is_contained(void { 1, 2, 4, 8 }, EltSizeInBytes) {
        return SDValue {};
    }
    let mut EltVT: EVT = getIntegerVT(EltSizeInBytes * 8);
    let mut PredVT: EVT = getPackedSVEVectorVT(EltVT).changeElementType(*DAG.getContext(), i1);
    if PredVT == VT {
        if AddrTy == i64 {
            return Op;
        }
        assert!(AddrTy == i32, "Only expected i32 to be legal!");
        return DAG.getNode(Op.getOpcode(), DL, VT, DAG.getNode(ZERO_EXTEND, DL, i64, operator(Op).getOperand(0)), DAG.getNode(ZERO_EXTEND, DL, i64, operator(Op).getOperand(1)), DAG.getConstant(EltSizeInBytes, DL, i64, false, false), operator(Op).getOperand(3));
    }
    if NumElements > PredVT.getVectorMinNumElements() {
        return SDValue {};
    }
    let mut Mask: SDValue = DAG(Op.getOpcode(), DL, PredVT, to_vector(operator(Op).op_values()));
    if VT.isFixedLengthVector() {
        let mut WidePredVT: EVT = PredVT.changeElementType(*DAG.getContext(), VT.getScalarType());
        let mut MaskAsInt: SDValue = DAG.getNode(SIGN_EXTEND, DL, WidePredVT, Mask);
        return convertFromScalableVector(DAG, VT, MaskAsInt);
    }
    return DAG.getExtractSubvector(DL, VT, Mask, 0);
}

fn AArch64TargetLowering::LowerBITCAST(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut OpVT: EVT = Op.getValueType();
    let mut ArgVT: EVT = Op.getOperand(0).getValueType();
    if self.useSVEForFixedLengthVectorVT(OpVT, false) {
        return self.LowerFixedLengthBitcastToSVE(Op, DAG);
    }
    if OpVT.isScalableVector() {
        assert!(self.isTypeLegal(OpVT), "Unexpected result type!");
        if !self.isTypeLegal(ArgVT) {
            assert!(OpVT.isFloatingPoint() && !ArgVT.isFloatingPoint(), "Expected int->fp bitcast!");
            if OpVT.getVectorElementCount() != ArgVT.getVectorElementCount() {
                return SDValue {};
            }
            let mut ExtResult: SDValue = DAG.getNode(ANY_EXTEND, Op, getSVEContainerType(ArgVT), Op.getOperand(0));
            return self.getSVESafeBitCast(OpVT, ExtResult, DAG);
        }
        if OpVT.getVectorElementCount() == ArgVT.getVectorElementCount() {
            return Op;
        }
        if !isPackedVectorType(OpVT, DAG) {
            return SDValue {};
        }
        return self.getSVESafeBitCast(OpVT, Op.getOperand(0), DAG);
    }
    if OpVT != f16 && OpVT != bf16 {
        return SDValue {};
    }
    if ArgVT == f16 || ArgVT == bf16 {
        return Op;
    }
    let mut Src: SDValue = Op.getOperand(0);
    let mut DL: SDLoc = Op;
    if ArgVT.isVector() && ArgVT.getSizeInBits().operator unsigned long long() == 16 {
        Src = DAG.getNode(BITCAST, DL, i16, Src);
        ArgVT = i16;
    }
    assert!(ArgVT == i16);
    if Src.getOpcode() == EXTRACT_VECTOR_ELT {
        Op = DAG.getNode(BITCAST, DL, Src.getOperand(0).getValueType().changeElementType(*DAG.getContext(), OpVT), Src.getOperand(0));
        return DAG.getNode(EXTRACT_VECTOR_ELT, DL, OpVT, Op, Src.getOperand(1));
    }
    Op = DAG.getNode(SCALAR_TO_VECTOR, DL, v8i16, Src);
    Op = DAG.getNode(BITCAST, DL, getVectorVT(*DAG.getContext(), OpVT, 8, false), Op);
    return DAG.getExtractVectorElt(DL, OpVT, Op, 0);
}

fn getConstantLaneNumOfExtractHalfOperand(Op: *mut SDValue) -> optional<uint64_t> {
    let mut OpNode: *mut SDNode = Op.getNode();
    if OpNode.getOpcode() != EXTRACT_VECTOR_ELT {
        return nullopt;
    }
    let mut VT: EVT = OpNode.getOperand(0).getValueType();
    let mut C: *mut ConstantSDNode = dyn_cast(OpNode.getOperand(1));
    if !VT.isFixedLengthVector() || VT.getVectorNumElements() != 2 || !C {
        return nullopt;
    }
    return C.getZExtValue();
}

fn isExtendedBUILD_VECTOR(N: SDValue, DAG: *mut SelectionDAG, isSigned: bool) -> bool {
    let mut VT: EVT = N.getValueType();
    if N.getOpcode() != BUILD_VECTOR {
        return false;
    }
    for Elt in operator(N).op_values() {
        if dyn_cast(Elt) {
            C;
        } else {
            let mut EltSize: u32 = VT.getScalarSizeInBits();
            let mut HalfSize: u32 = EltSize / 2;
            if isSigned {
                if !isIntN(HalfSize, C.getSExtValue()) {
                    return false;
                }
            } else {
                if !isUIntN(HalfSize, C.getZExtValue()) {
                    return false;
                }
            }
            continue;
        }
        return false;
    }
    return true;
}

fn skipExtensionForVectorMULL(N: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType();
    assert!(VT.is128BitVector(), "Unexpected vector MULL size");
    let mut HalfVT: EVT = getVectorVT(*DAG.getContext(), VT.getScalarType().getHalfSizedIntegerVT(*DAG.getContext()), VT.getVectorElementCount());
    return DAG.getNode(TRUNCATE, N, HalfVT, N);
}

fn isSignExtended(N: SDValue, DAG: *mut SelectionDAG) -> bool {
    return N.getOpcode() == SIGN_EXTEND || N.getOpcode() == ANY_EXTEND || isExtendedBUILD_VECTOR(N, DAG, true);
}

fn isZeroExtended(N: SDValue, DAG: *mut SelectionDAG) -> bool {
    return N.getOpcode() == ZERO_EXTEND || N.getOpcode() == ANY_EXTEND || isExtendedBUILD_VECTOR(N, DAG, false);
}

fn isAddSubSExt(N: SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut Opcode: u32 = N.getOpcode();
    if Opcode == ADD || Opcode == SUB {
        let mut N0: SDValue = N.getOperand(0);
        let mut N1: SDValue = N.getOperand(1);
        return operator(N0).hasOneUse() && operator(N1).hasOneUse() && isSignExtended(N0, DAG) && isSignExtended(N1, DAG);
    }
    return false;
}

fn isAddSubZExt(N: SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut Opcode: u32 = N.getOpcode();
    if Opcode == ADD || Opcode == SUB {
        let mut N0: SDValue = N.getOperand(0);
        let mut N1: SDValue = N.getOperand(1);
        return operator(N0).hasOneUse() && operator(N1).hasOneUse() && isZeroExtended(N0, DAG) && isZeroExtended(N1, DAG);
    }
    return false;
}

fn AArch64TargetLowering::LowerGET_ROUNDING(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = Op.getOperand(0);
    let mut FPCR_64: SDValue = DAG(INTRINSIC_W_CHAIN, DL, void { i64, Other }, void { Chain, DAG });
    Chain = FPCR_64.getValue(1);
    let mut FPCR_32: SDValue = DAG.getNode(TRUNCATE, DL, i32, FPCR_64);
    let mut FltRounds: SDValue = DAG.getNode(ADD, DL, i32, FPCR_32, DAG.getConstant(1 << 22, DL, i32, false, false));
    let mut RMODE: SDValue = DAG.getNode(SRL, DL, i32, FltRounds, DAG.getConstant(22, DL, i32, false, false));
    let mut AND: SDValue = DAG.getNode(AND, DL, i32, RMODE, DAG.getConstant(3, DL, i32, false, false));
    return DAG.getMergeValues([AND, Chain], DL);
}

fn AArch64TargetLowering::LowerSET_ROUNDING(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = operator(Op).getOperand(0);
    let mut RMValue: SDValue = operator(Op).getOperand(1);
    RMValue = DAG.getNode(SUB, DL, i32, RMValue, DAG.getConstant(1, DL, i32, false, false));
    RMValue = DAG.getNode(AND, DL, i32, RMValue, DAG.getConstant(3, DL, i32, false, false));
    RMValue = DAG.getNode(SHL, DL, i32, RMValue, DAG.getConstant(RoundingBitsPos, DL, i32, false, false));
    RMValue = DAG.getNode(ZERO_EXTEND, DL, i64, RMValue);
    let mut Ops: []SDValue = void { Chain, DAG };
    let mut FPCR: SDValue = DAG(INTRINSIC_W_CHAIN, DL, void { i64, Other }, Ops);
    Chain = FPCR.getValue(1);
    FPCR = FPCR.getValue(0);
    let mut RMMask: i32 = ~(rmMask << RoundingBitsPos);
    FPCR = DAG.getNode(AND, DL, i64, FPCR, DAG.getConstant(RMMask, DL, i64, false, false));
    FPCR = DAG.getNode(OR, DL, i64, FPCR, RMValue);
    let mut Ops2: []SDValue = void { Chain, DAG, FPCR };
    return DAG(INTRINSIC_VOID, DL, Other, Ops2);
}

fn AArch64TargetLowering::LowerGET_FPMODE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = operator(Op).getOperand(0);
    let mut Ops: []SDValue = void { Chain, DAG };
    let mut FPCR: SDValue = DAG(INTRINSIC_W_CHAIN, DL, void { i64, Other }, Ops);
    Chain = FPCR.getValue(1);
    FPCR = FPCR.getValue(0);
    let mut Result: SDValue = DAG.getNode(TRUNCATE, DL, i32, FPCR);
    return DAG.getMergeValues([Result, Chain], DL);
}

fn AArch64TargetLowering::LowerSET_FPMODE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = operator(Op).getOperand(0);
    let mut Mode: SDValue = operator(Op).getOperand(1);
    let mut FPCR: SDValue = DAG.getZExtOrTrunc(Mode, DL, i64);
    let mut Ops2: []SDValue = void { Chain, DAG, FPCR };
    return DAG(INTRINSIC_VOID, DL, Other, Ops2);
}

fn AArch64TargetLowering::LowerRESET_FPMODE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = operator(Op).getOperand(0);
    let mut Ops: []SDValue = void { Chain, DAG };
    let mut FPCR: SDValue = DAG(INTRINSIC_W_CHAIN, DL, void { i64, Other }, Ops);
    Chain = FPCR.getValue(1);
    FPCR = FPCR.getValue(0);
    let mut FPCRMasked: SDValue = DAG.getNode(AND, DL, i64, FPCR, DAG.getConstant(ReservedFPControlBits, DL, i64, false, false));
    let mut Ops2: []SDValue = void { Chain, DAG, FPCRMasked };
    return DAG(INTRINSIC_VOID, DL, Other, Ops2);
}

fn selectUmullSmull(N0: *mut SDValue, N1: *mut SDValue, DAG: *mut SelectionDAG, DL: SDLoc, IsMLA: *mut bool) -> u32 {
    let mut IsN0SExt: bool = isSignExtended(N0, DAG);
    let mut IsN1SExt: bool = isSignExtended(N1, DAG);
    let mut IsN0ZExt: bool = isZeroExtended(N0, DAG);
    let mut IsN1ZExt: bool = isZeroExtended(N1, DAG);
    let mut VT: EVT = N0.getValueType();
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    let mut Mask: APInt = getHighBitsSet(EltSize, EltSize / 2);
    if IsN0ZExt || IsN1ZExt {} else if VT == v2i64 && DAG.MaskedValueIsZero(N0, Mask, 0) && DAG.MaskedValueIsZero(N1, Mask, 0) {}
    if IsN0SExt || IsN1SExt {} else if VT == v2i64 && DAG.ComputeNumSignBits(N0, 0) > EltSize / 2 && DAG.ComputeNumSignBits(N1, 0) > EltSize / 2 {}
    if !IsN1SExt && !IsN1ZExt {
        return 0;
    }
    if IsN1SExt && isAddSubSExt(N0, DAG) {
        IsMLA = true;
    }
    if IsN1ZExt && isAddSubZExt(N0, DAG) {
        IsMLA = true;
    }
    if IsN0ZExt && isAddSubZExt(N1, DAG) {
        swap(N0, N1);
        IsMLA = true;
    }
    return 0;
}

fn convertMulToShlAdd(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Operand: *SDNode = N.getOperand(1).getNode();
    let mut SplatValue: APInt = APInt {};
    if !isConstantSplatVector(Operand, SplatValue) || !SplatValue.getBoolValue() {
        return SDValue {};
    }
    let mut IsNegative: bool = SplatValue.isNegative();
    SplatValue = SplatValue.abs();
    let mut MathOp: u32 = DELETED_NODE;
    let mut TZeros: u32 = SplatValue.countr_zero();
    SplatValue.lshrInPlace(TZeros);
    if (SplatValue - 1).isPowerOf2() {
        MathOp = ADD;
    } else if (SplatValue + 1).isPowerOf2() {
        MathOp = SUB;
    }
    if MathOp != DELETED_NODE {
        let mut DL: SDLoc = N;
        let mut VT: EVT = N.getValueType(0);
        let mut LHS: SDValue = N.getOperand(0);
        let mut ShiftAmt: u32 = if MathOp == ADD { (SplatValue - 1).logBase2() } else { (SplatValue + 1).logBase2() };
        ShiftAmt += TZeros;
        let mut Shl: SDValue = DAG.getNode(SHL, DL, VT, LHS, DAG.getConstant(ShiftAmt, DL, VT, false, false));
        let mut NewLHS: SDValue = if TZeros { DAG.getNode(SHL, DL, VT, LHS, DAG.getConstant(TZeros, DL, VT, false, false)) } else { LHS };
        let mut Combined: SDValue = DAG.getNode(MathOp, DL, VT, Shl, NewLHS);
        if IsNegative {
            Combined = DAG.getNegative(Combined, DL, VT);
        }
        return Combined;
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerMUL(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut OverrideNEON: bool = !self.Subtarget.isNeonAvailable();
    if VT.isScalableVector() || self.useSVEForFixedLengthVectorVT(VT, OverrideNEON) {
        return self.LowerToPredicatedOp;
    }
    assert!((VT.is128BitVector() || VT.is64BitVector()) && VT.isInteger(), "unexpected type for custom-lowering ISD::MUL");
    let mut N0: SDValue = Op.getOperand(0);
    let mut N1: SDValue = Op.getOperand(1);
    let mut isMLA: bool = false;
    let mut OVT: EVT = VT;
    if VT.is64BitVector() {
        if N0.getOpcode() == EXTRACT_SUBVECTOR && isNullConstant(N0.getOperand(1)) && N0.getOperand(0).getValueType().is128BitVector() && N1.getOpcode() == EXTRACT_SUBVECTOR && isNullConstant(N1.getOperand(1)) && N1.getOperand(0).getValueType().is128BitVector() {
            N0 = N0.getOperand(0);
            N1 = N1.getOperand(0);
            VT = N0.getValueType();
        } else {
            if VT == v1i64 {
                if self.Subtarget() {
                    return self.LowerToPredicatedOp;
                }
                return SDValue {};
            } else {
                return Op;
            }
        }
    }
    let mut DL: SDLoc = Op;
    let mut NewOpc: u32 = selectUmullSmull(N0, N1, DAG, DL, isMLA);
    if !NewOpc {
        if VT.getVectorElementType() == i64 {
            if self.Subtarget() {
                return self.LowerToPredicatedOp;
            }
            if convertMulToShlAdd(Op.getNode(), DAG) {
                ShlAdd;
            } else {
                return ShlAdd;
            }
            return SDValue {};
        } else {
            return Op;
        }
    }
    let mut Op0: SDValue = SDValue {};
    let mut Op1: SDValue = skipExtensionForVectorMULL(N1, DAG);
    if !isMLA {
        Op0 = skipExtensionForVectorMULL(N0, DAG);
        assert!(Op0.getValueType().is64BitVector() && Op1.getValueType().is64BitVector(), "unexpected types for extended operands to VMULL");
        return DAG.getExtractSubvector(DL, OVT, DAG.getNode(NewOpc, DL, VT, Op0, Op1), 0);
    }
    let mut N00: SDValue = skipExtensionForVectorMULL(N0.getOperand(0), DAG);
    let mut N01: SDValue = skipExtensionForVectorMULL(N0.getOperand(1), DAG);
    let mut Op1VT: EVT = Op1.getValueType();
    return DAG.getNode(EXTRACT_SUBVECTOR, DL, OVT, DAG.getNode(N0.getOpcode(), DL, VT, DAG.getNode(NewOpc, DL, VT, DAG.getNode(BITCAST, DL, Op1VT, N00), Op1), DAG.getNode(NewOpc, DL, VT, DAG.getNode(BITCAST, DL, Op1VT, N01), Op1)), DAG.getConstant(0, DL, i64, false, false));
}

fn getPTrue(DAG: *mut SelectionDAG, DL: SDLoc, VT: EVT, Pattern: i32) -> SDValue {
    if  {
        return DAG.getConstant(1, DL, VT, false, false);
    }
    if getNumElementsFromSVEPredPattern(Pattern) {
        PatNumElts;
    } else {
        let mut Subtarget: *AArch64Subtarget = DAG;
        let mut NumElts: u32 = VT.getVectorMinNumElements();
        let mut VScale: u32 = Subtarget.getSVEVectorSizeInBits() / 128;
        if PatNumElts == (NumElts * VScale) {
            return DAG.getConstant(1, DL, VT, false, false);
        }
    }
    return DAG;
}

fn getPTrueAsCounter(DAG: *mut SelectionDAG, DL: SDLoc, VT: EVT) -> SDValue {
    let mut IID: ID = zeroed();
    match VT.getScalarSizeInBits() {
        _ => {
            llvm_unreachable_internal("unsupported predicate element size", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 6321);
        },
        8 => {
            
        },
        16 => {
            
        },
        32 => {
            
        },
        64 => {
            
        },
    }
    return DAG.getNode(INTRINSIC_WO_CHAIN, DL, aarch64svcount, DAG.getConstant(IID, DL, i64, false, false));
}

fn optimizeIncrementingWhile(N: *mut SDNode, DAG: *mut SelectionDAG, IsSigned: bool, IsEqual: bool) -> SDValue {
    let mut Op0: u32 = if N.getOpcode() == INTRINSIC_WO_CHAIN { 1 } else { 0 };
    let mut Op1: u32 = if N.getOpcode() == INTRINSIC_WO_CHAIN { 2 } else { 1 };
    if !N.getValueType(0).isScalableVector() || !isa(N.getOperand(Op1)) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut Y: APInt = N.getConstantOperandAPInt(Op1);
    if IsEqual {
        if if IsSigned { Y.isMaxSignedValue() } else { Y.isMaxValue() } {
            return DAG.getConstant(1, DL, N.getValueType(0), false, false);
        }
    }
    if !isa(N.getOperand(Op0)) {
        return SDValue {};
    }
    let mut X: APInt = N.getConstantOperandAPInt(Op0);
    let mut Overflow: bool = false;
    let mut NumActiveElems: APInt = if IsSigned { Y.ssub_ov(X, Overflow) } else { Y.usub_ov(X, Overflow) };
    if Overflow {
        return SDValue {};
    }
    if IsEqual {
        let mut One: APInt = APInt { NumActiveElems.getBitWidth(), 1, IsSigned, false };
        NumActiveElems = if IsSigned { NumActiveElems.sadd_ov(One, Overflow) } else { NumActiveElems.uadd_ov(One, Overflow) };
        if Overflow {
            return SDValue {};
        }
    }
    let mut PredPattern: optional<unsigned int> = getSVEPredPatternFromNumElements(NumActiveElems.getZExtValue());
    let mut MinSVEVectorSize: u32 = if DAG() > 128 { DAG() } else { 128 };
    let mut ElementSize: u32 = 128 / N.getValueType(0).getVectorMinNumElements();
    if PredPattern(nullopt) && NumActiveElems.getZExtValue() <= (MinSVEVectorSize / ElementSize) {
        return getPTrue(DAG, DL, N.getValueType(0), operator(PredPattern));
    }
    return SDValue {};
}

fn optimizeBrk(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    if !isZeroOrZeroSplat(N.getOperand(0), false) {
        return SDValue {};
    }
    let mut Upper: SDValue = N.getOperand(1);
    let mut BrkID: u32 = 0;
    if operator(Upper).getOpcode() == ADD && isOneOrOneSplat(Upper.getOperand(1), false) {
        Upper = Upper.getOperand(0);
    }
    if  {
        return SDValue {};
    }
    let mut Pg: SDValue = operator(Upper).getOperand(0);
    let mut Mask: SDValue = operator(Upper).getOperand(1);
    Pg = getSVEPredicateBitCast(nxv16i1, Pg, DAG);
    let mut MaskR: SDValue = DAG;
    let mut ID: SDValue = DAG.getTargetConstant(BrkID, DL, i64, false);
    let mut Brk: SDValue = DAG.getNode(INTRINSIC_WO_CHAIN, DL, nxv16i1, ID, Pg, MaskR);
    return DAG;
}

fn getSVEPredicateBitCast(VT: EVT, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut InVT: EVT = Op.getValueType();
    assert!(InVT.getVectorElementType() == i1 && VT.getVectorElementType() == i1, "Expected a predicate-to-predicate bitcast");
    assert!(VT.isScalableVector() && DAG.getTargetLoweringInfo().isTypeLegal(VT) && InVT.isScalableVector() && DAG.getTargetLoweringInfo().isTypeLegal(InVT), "Only expect to cast between legal scalable predicate types!");
    if InVT == VT {
        return Op;
    }
    if  {
        Op = Op.getOperand(1);
    }
    let mut Reinterpret: SDValue = DAG;
    if InVT.bitsGT(VT) {
        return Reinterpret;
    }
    if isZeroingInactiveLanes(Op) {
        return Reinterpret;
    }
    let mut Mask: SDValue = DAG.getConstant(1, DL, InVT, false, false);
    Mask = DAG;
    return DAG.getNode(AND, DL, VT, Reinterpret, Mask);
}

fn AArch64TargetLowering::getRuntimePStateSM(self: *AArch64TargetLowering, DAG: *mut SelectionDAG, Chain: SDValue, DL: SDLoc, VT: EVT) -> SDValue {
    let mut LC: Libcall = SMEABI_SME_STATE;
    let mut LCImpl: LibcallImpl = DAG.getLibcalls().getLibcallImpl(LC);
    let mut Callee: SDValue = DAG.getExternalSymbol(LCImpl, self.getPointerTy(DAG.getDataLayout(), 0));
    let mut Int64Ty: *mut Type = getInt64Ty(*DAG.getContext());
    let mut RetTy: *mut Type = get(Int64Ty, Int64Ty);
    let mut CLI: CallLoweringInfo = DAG;
    let mut Args: ArgListTy = ArgListTy {};
    CLI.setDebugLoc(DL).setChain(Chain)(DAG.getLibcalls().getLibcallImplCallingConv(LCImpl), RetTy, Callee, move(Args));
    let mut CallResult: pair<SDValue, SDValue> = self.LowerCallTo(CLI);
    let mut Mask: SDValue = DAG.getConstant(1, DL, i64, false, false);
    return DAG.getNode(AND, DL, i64, CallResult.first.getOperand(0), Mask);
}

fn LowerSMELdrStr(N: SDValue, DAG: *mut SelectionDAG, IsLoad: bool) -> SDValue {
    let mut DL: SDLoc = N;
    let mut TileSlice: SDValue = operator(N).getOperand(2);
    let mut Base: SDValue = operator(N).getOperand(3);
    let mut VecNum: SDValue = operator(N).getOperand(4);
    let mut ConstAddend: i32 = 0;
    let mut VarAddend: SDValue = VecNum;
    if VecNum.getOpcode() == ADD && isa(VecNum.getOperand(1)) {
        ConstAddend = cast(VecNum.getOperand(1))();
        VarAddend = VecNum.getOperand(0);
    } else if  {
        ConstAddend = ();
        VarAddend = SDValue {};
    }
    let mut ImmAddend: i32 = ConstAddend % 16;
    if (ConstAddend - ImmAddend) {
        C;
    } else {
        let mut CVal: SDValue = DAG.getTargetConstant(C, DL, i32, false);
        VarAddend = if VarAddend { DAG.getNode(ADD, DL, i32, [VarAddend, CVal]) } else { CVal };
    }
    if VarAddend {
        let mut SVL: auto = DAG;
        let mut Mul: SDValue = DAG(MUL, DL, i64, void { , DAG.getNode(SIGN_EXTEND, DL, i64, VarAddend) });
        Base = DAG.getNode(ADD, DL, i64, [Base, Mul]);
        TileSlice = DAG.getNode(ADD, DL, i32, [TileSlice, VarAddend]);
    }
    return DAG;
}

fn LowerVectorMatch(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Op1: SDValue = Op.getOperand(0);
    let mut Op2: SDValue = Op.getOperand(1);
    let mut Mask: SDValue = Op.getOperand(2);
    let mut Op1VT: EVT = Op1.getValueType();
    let mut Op2VT: EVT = Op2.getValueType();
    let mut ResVT: EVT = Op.getValueType();
    if (Op2VT == v3i8 || Op2VT == v4i8) {
        let mut Needle: SDValue = Op2;
        let mut NeedleVT: EVT = Op2VT;
        if NeedleVT == v3i8 {
            let mut Pad: SDValue = DAG.getExtractVectorElt(DL, i8, Needle, 0);
            Needle = DAG.getInsertSubvector(DL, DAG.getPOISON(v4i8), Needle, 0);
            Needle = DAG.getInsertVectorElt(DL, Needle, Pad, 3);
        }
        Needle = DAG.getBitcast(v1i32, Needle);
        Needle = DAG.getExtractVectorElt(DL, i32, Needle, 0);
        Needle = DAG.getSplatVector(v4i32, DL, Needle);
        Needle = DAG.getBitcast(v16i8, Needle);
        return DAG.getNode(VECTOR_MATCH, DL, Op.getValueType(), Op1, Needle, Mask);
    }
    if !DAG.getTargetLoweringInfo().isTypeLegal(ResVT) || !DAG.getTargetLoweringInfo().isTypeLegal(Op1VT) {
        return SDValue {};
    }
    if Op1VT.getVectorElementType() != i8 && Op1VT.getVectorElementType() != i16 {
        return SDValue {};
    }
    if Op2VT.getFixedSizeInBits() > 128 {
        let mut MatchLo: SDValue = DAG.getNode(VECTOR_MATCH, DL, ResVT, Op1, NeedleLo, Mask);
        let mut MatchHi: SDValue = DAG.getNode(VECTOR_MATCH, DL, ResVT, Op1, NeedleHi, Mask);
        return DAG.getNode(OR, DL, ResVT, MatchLo, MatchHi);
    }
    let mut OpContainerVT: EVT = if Op1VT.isScalableVector() { Op1VT } else { getContainerForFixedLengthVector(DAG, Op1VT) };
    if Op2VT.is128BitVector() {
        Op2 = convertToScalableVector(DAG, OpContainerVT, Op2);
        if ResVT.isScalableVector() {
            Op2 = DAG;
        }
    } else {
        let mut Op2BitWidth: u32 = Op2VT.getFixedSizeInBits();
        let mut Op2IntVT: MVT = getIntegerVT(Op2BitWidth);
        let mut Op2PromotedVT: EVT = getPackedSVEVectorVT(Op2IntVT);
        Op2 = DAG.getBitcast(getVectorVT(Op2IntVT, 1), Op2);
        Op2 = DAG.getExtractVectorElt(DL, Op2IntVT, Op2, 0);
        Op2 = DAG.getSplatVector(Op2PromotedVT, DL, Op2);
        Op2 = DAG.getBitcast(OpContainerVT, Op2);
    }
    let mut ID: SDValue = DAG;
    if ResVT.isScalableVector() {
        return DAG.getNode(INTRINSIC_WO_CHAIN, DL, ResVT, ID, Mask, Op1, Op2);
    }
    Op1 = convertToScalableVector(DAG, OpContainerVT, Op1);
    Mask = DAG.getNode(SIGN_EXTEND, DL, Op1VT, Mask);
    Mask = convertFixedMaskToScalableVector(Mask, DAG);
    let mut Match: SDValue = DAG.getNode(INTRINSIC_WO_CHAIN, DL, Mask.getValueType(), ID, Mask, Op1, Op2);
    Match = DAG.getNode(SIGN_EXTEND, DL, OpContainerVT, Match);
    Match = convertFromScalableVector(DAG, Op1VT, Match);
    return DAG.getNode(TRUNCATE, DL, ResVT, Match);
}

fn AArch64TargetLowering::LowerINTRINSIC_VOID(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IntNo: u32 = Op.getConstantOperandVal(1);
    let mut DL: SDLoc = Op;
    match IntNo {
        _ => {
            return SDValue {};
        },
    }
}

fn AArch64TargetLowering::LowerINTRINSIC_W_CHAIN(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IntNo: u32 = Op.getConstantOperandVal(1);
    let mut DL: SDLoc = Op;
    match IntNo {
        _ => {
            return SDValue {};
        },
    }
}

fn AArch64TargetLowering::LowerINTRINSIC_WO_CHAIN(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IntNo: u32 = Op.getConstantOperandVal(0);
    let mut DL: SDLoc = Op;
    match IntNo {
        _ => {
            return SDValue {};
        },
        thread_pointer => {
            let mut PtrVT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
            return DAG;
        },
        localaddress => {
            let mut MF: *MachineFunction = DAG.getMachineFunction();
            let mut RegInfo: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
            let mut Reg: u32 = RegInfo.getLocalAddressRegister(MF);
            return DAG.getCopyFromReg(DAG.getEntryNode(), DL, Reg, Op.getSimpleValueType());
        },
        eh_recoverfp => {
            let mut FnOp: SDValue = Op.getOperand(1);
            let mut IncomingFPOp: SDValue = Op.getOperand(2);
            let mut GSD: *mut GlobalAddressSDNode = dyn_cast(FnOp);
            let mut Fn: *mut auto = dyn_cast_or_null(if GSD { GSD.getGlobal() } else { null });
            if operator!() {
                report_fatal_error("llvm.eh.recoverfp must take a function as the first argument", true);
            }
            return IncomingFPOp;
        },
    }
}

fn AArch64TargetLowering::shouldExtendGSIndex(self: *AArch64TargetLowering, VT: EVT, EltTy: *mut EVT) -> bool {
    if VT.getVectorElementType() == i8 || VT.getVectorElementType() == i16 {
        EltTy = i32;
        return true;
    }
    return false;
}

fn AArch64TargetLowering::shouldRemoveExtendFromGSIndex(self: *AArch64TargetLowering, Extend: SDValue, DataVT: EVT) -> bool {
    let mut IndexVT: EVT = Extend.getOperand(0).getValueType();
    if operator!(self.Subtarget()) || IndexVT.getVectorElementType() != i32 {
        return false;
    }
    if IndexVT.getScalarSizeInBits() < DataVT.getScalarSizeInBits() {
        return false;
    }
    return DataVT.isFixedLengthVector() || DataVT.getVectorMinNumElements() > 2;
}

fn isEligibleForSmallVectorLoadOpt(LD: *mut LoadSDNode, Subtarget: *AArch64Subtarget) -> bool {
    if !Subtarget.isNeonAvailable() {
        return false;
    }
    if LD.isVolatile() {
        return false;
    }
    let mut MemVT: EVT = LD.getMemoryVT();
    if MemVT != v2i8 && MemVT != v4i8 && MemVT != v2i16 {
        return false;
    }
    let mut Alignment: Align = LD.getAlign();
    let mut RequiredAlignment: Align = MemVT.getStoreSize().getFixedValue();
    if Subtarget()() && Alignment < RequiredAlignment {
        return false;
    }
    return true;
}

fn AArch64TargetLowering::isVectorLoadExtDesirable(self: *AArch64TargetLowering, ExtVal: SDValue) -> bool {
    let mut ExtVT: EVT = ExtVal.getValueType();
    if  {
        if ExtVT.isFixedLengthVector() && ExtVT.getStoreSizeInBits().operator unsigned long long() <= 128 && isEligibleForSmallVectorLoadOpt(*self.Subtarget) {
            return true;
        }
    }
    if !ExtVT.isScalableVector() && !self.Subtarget.useSVEForFixedLengthVectors() {
        return false;
    }
    if  {
        if operator!(self.isLoadLegalOrCustom(ExtVT, (0), ZEXTLOAD, false)) {
            if !ExtVT.isScalableVector() {
                return false;
            }
            let mut NumExtMaskedLoads: u32 = 0;
            if NumExtMaskedLoads <= 1 {
                return false;
            }
        }
    }
    let mut PreExtScalarVT: EVT = operator(ExtVal).getOperand(0).getValueType().getScalarType();
    return PreExtScalarVT == i8 || PreExtScalarVT == i16 || PreExtScalarVT == i32 || PreExtScalarVT == i64;
}

fn getGatherVecOpcode(IsScaled: bool, IsSigned: bool, NeedsExtend: bool) -> u32 {
    let mut AddrModes: i32 = 0;
    let mut Key: auto = make_tuple(IsScaled, IsSigned, NeedsExtend);
    return ();
}

fn getSignExtendedGatherOpcode(Opcode: u32) -> u32 {
    match Opcode {
        _ => {
            llvm_unreachable_internal("unimplemented opcode", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 7522);
        },
    }
}

fn AArch64TargetLowering::LowerMGATHER(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MGT: *mut MaskedGatherSDNode = cast(Op);
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = MGT.getChain();
    let mut PassThru: SDValue = MGT.getPassThru();
    let mut Mask: SDValue = MGT.getMask();
    let mut BasePtr: SDValue = MGT.getBasePtr();
    let mut Index: SDValue = MGT.getIndex();
    let mut Scale: SDValue = MGT.getScale();
    let mut VT: EVT = Op.getValueType();
    let mut MemVT: EVT = MGT.getMemoryVT();
    let mut ExtType: LoadExtType = MGT.getExtensionType();
    let mut IndexType: MemIndexType = MGT.getIndexType();
    if !operator(PassThru).isUndef() && !isZerosVector(PassThru.getNode()) {
        let mut Ops: [6]SDValue = [Chain, DAG.getUNDEF(VT), Mask, BasePtr, Index, Scale];
        let mut Load: SDValue = DAG.getMaskedGather;
        let mut Select: SDValue = DAG.getSelect(DL, VT, Mask, Load, PassThru, SDNodeFlags { Flags: None });
        return DAG.getMergeValues([Select, Load.getValue(1)], DL);
    }
    let mut IsScaled: bool = MGT.isIndexScaled();
    let mut IsSigned: bool = MGT.isIndexSigned();
    let mut ScaleVal: u64 = operator(Scale).getAsZExtVal();
    if IsScaled && ScaleVal != MemVT.getScalarStoreSize() {
        assert!(isPowerOf2_64(ScaleVal), "Expecting power-of-two types");
        let mut IndexVT: EVT = Index.getValueType();
        Index = DAG.getNode(SHL, DL, IndexVT, Index, DAG.getConstant(Log2_32(ScaleVal), DL, IndexVT, false, false));
        Scale = DAG.getTargetConstant(1, DL, Scale.getValueType(), false);
        let mut Ops: [6]SDValue = [Chain, PassThru, Mask, BasePtr, Index, Scale];
        return DAG.getMaskedGather;
    }
    if VT.isFixedLengthVector() {
        assert!(self.Subtarget.useSVEForFixedLengthVectors(), "Cannot lower when not using SVE for fixed vectors!");
        let mut DataVT: EVT = VT.changeVectorElementTypeToInteger();
        MemVT = MemVT.changeVectorElementTypeToInteger();
        let mut PromotedVT: EVT = VT.changeVectorElementType(*DAG.getContext(), i32);
        if DataVT.getVectorElementType() == i64 || Index.getValueType().getVectorElementType() == i64 || Mask.getValueType().getVectorElementType() == i64 {
            PromotedVT = VT.changeVectorElementType(*DAG.getContext(), i64);
        }
        let mut ExtOpcode: u32 = if IsSigned { SIGN_EXTEND } else { ZERO_EXTEND };
        Index = DAG.getNode(ExtOpcode, DL, PromotedVT, Index);
        Mask = DAG.getNode(SIGN_EXTEND, DL, PromotedVT, Mask);
        if PromotedVT != DataVT && ExtType == NON_EXTLOAD {
            ExtType = EXTLOAD;
        }
        let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, PromotedVT);
        MemVT = ContainerVT.changeVectorElementType(*DAG.getContext(), MemVT.getVectorElementType());
        Index = convertToScalableVector(DAG, ContainerVT, Index);
        Mask = convertFixedMaskToScalableVector(Mask, DAG);
        PassThru = if operator(PassThru).isUndef() { DAG.getUNDEF(ContainerVT) } else { DAG.getConstant(0, DL, ContainerVT, false, false) };
        let mut Ops: [6]SDValue = [Chain, PassThru, Mask, BasePtr, Index, Scale];
        let mut Load: SDValue = DAG.getMaskedGather;
        let mut Result: SDValue = convertFromScalableVector(DAG, PromotedVT, Load);
        Result = DAG.getNode(TRUNCATE, DL, DataVT, Result);
        if VT.isFloatingPoint() {
            Result = DAG.getNode(BITCAST, DL, VT, Result);
        }
        return DAG.getMergeValues([Result, Load.getValue(1)], DL);
    }
    return Op;
}

fn AArch64TargetLowering::LowerMSCATTER(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MSC: *mut MaskedScatterSDNode = cast(Op);
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = MSC.getChain();
    let mut StoreVal: SDValue = MSC.getValue();
    let mut Mask: SDValue = MSC.getMask();
    let mut BasePtr: SDValue = MSC.getBasePtr();
    let mut Index: SDValue = MSC.getIndex();
    let mut Scale: SDValue = MSC.getScale();
    let mut VT: EVT = StoreVal.getValueType();
    let mut MemVT: EVT = MSC.getMemoryVT();
    let mut IndexType: MemIndexType = MSC.getIndexType();
    let mut Truncating: bool = MSC.isTruncatingStore();
    let mut IsScaled: bool = MSC.isIndexScaled();
    let mut IsSigned: bool = MSC.isIndexSigned();
    let mut ScaleVal: u64 = operator(Scale).getAsZExtVal();
    if IsScaled && ScaleVal != MemVT.getScalarStoreSize() {
        assert!(isPowerOf2_64(ScaleVal), "Expecting power-of-two types");
        let mut IndexVT: EVT = Index.getValueType();
        Index = DAG.getNode(SHL, DL, IndexVT, Index, DAG.getConstant(Log2_32(ScaleVal), DL, IndexVT, false, false));
        Scale = DAG.getTargetConstant(1, DL, Scale.getValueType(), false);
        let mut Ops: [6]SDValue = [Chain, StoreVal, Mask, BasePtr, Index, Scale];
        return DAG.getMaskedScatter;
    }
    if VT.isFixedLengthVector() {
        assert!(self.Subtarget.useSVEForFixedLengthVectors(), "Cannot lower when not using SVE for fixed vectors!");
        if VT.isFloatingPoint() {
            VT = VT.changeVectorElementTypeToInteger();
            MemVT = MemVT.changeVectorElementTypeToInteger();
            StoreVal = DAG.getNode(BITCAST, DL, VT, StoreVal);
        }
        let mut PromotedVT: EVT = VT.changeVectorElementType(*DAG.getContext(), i32);
        if VT.getVectorElementType() == i64 || Index.getValueType().getVectorElementType() == i64 || Mask.getValueType().getVectorElementType() == i64 {
            PromotedVT = VT.changeVectorElementType(*DAG.getContext(), i64);
        }
        let mut ExtOpcode: u32 = if IsSigned { SIGN_EXTEND } else { ZERO_EXTEND };
        Index = DAG.getNode(ExtOpcode, DL, PromotedVT, Index);
        Mask = DAG.getNode(SIGN_EXTEND, DL, PromotedVT, Mask);
        StoreVal = DAG.getNode(ANY_EXTEND, DL, PromotedVT, StoreVal);
        if PromotedVT != VT {
            Truncating = true;
        }
        let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, PromotedVT);
        MemVT = ContainerVT.changeVectorElementType(*DAG.getContext(), MemVT.getVectorElementType());
        Index = convertToScalableVector(DAG, ContainerVT, Index);
        Mask = convertFixedMaskToScalableVector(Mask, DAG);
        StoreVal = convertToScalableVector(DAG, ContainerVT, StoreVal);
        let mut Ops: [6]SDValue = [Chain, StoreVal, Mask, BasePtr, Index, Scale];
        return DAG.getMaskedScatter;
    }
    return Op;
}

fn AArch64TargetLowering::LowerMLOAD(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut LoadNode: *mut MaskedLoadSDNode = cast(Op);
    assert!(LoadNode, "Expected custom lowering of a masked load node");
    let mut VT: EVT = operator(Op).getValueType(0);
    if VT.isFixedLengthVector() && self.Subtarget.isSVEorStreamingSVEAvailable() {
        return self.LowerFixedLengthVectorMLoadToSVE(Op, DAG);
    }
    let mut PassThru: SDValue = LoadNode.getPassThru();
    let mut Mask: SDValue = LoadNode.getMask();
    if !LoadNode.isExpandingLoad() {
        if operator(PassThru).isUndef() || isZerosVector(PassThru.getNode()) {
            return Op;
        }
        let mut Load: SDValue = DAG.getMaskedLoad(VT, DL, LoadNode.getChain(), LoadNode.getBasePtr(), LoadNode.getOffset(), Mask, DAG.getUNDEF(VT), LoadNode.getMemoryVT(), LoadNode.getMemOperand(), LoadNode.getAddressingMode(), LoadNode.getExtensionType(), false);
        let mut Result: SDValue = DAG.getSelect(DL, VT, Mask, Load, PassThru, SDNodeFlags { Flags: None });
        return DAG.getMergeValues([Result, Load.getValue(1)], DL);
    }
    if (!self.Subtarget.isSVEAvailable() || operator!(self.Subtarget())) && (!self.Subtarget.isSVEorStreamingSVEAvailable() || operator!(self.Subtarget())) {
        return SDValue {};
    }
    let mut CntActive: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, i64, DAG, Mask, Mask);
    let mut ActiveMask: SDValue = DAG.getNode(GET_ACTIVE_LANE_MASK, DL, operator(Mask).getValueType(0), DAG.getConstant(0, DL, i64, false, false), CntActive);
    let mut Load: SDValue = DAG.getMaskedLoad(VT, DL, LoadNode.getChain(), LoadNode.getBasePtr(), LoadNode.getOffset(), ActiveMask, DAG.getUNDEF(VT), LoadNode.getMemoryVT(), LoadNode.getMemOperand(), LoadNode.getAddressingMode(), LoadNode.getExtensionType(), false);
    let mut Result: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, VT, DAG, Mask, Load);
    if !operator(PassThru).isUndef() && !isZerosVector(PassThru.getNode()) {
        Result = DAG.getSelect(DL, VT, Mask, Result, PassThru, SDNodeFlags { Flags: None });
    }
    return DAG.getMergeValues([Result, Load.getValue(1)], DL);
}

fn LowerTruncateVectorStore(DL: SDLoc, ST: *mut StoreSDNode, VT: EVT, MemVT: EVT, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT.isVector(), "VT should be a vector type");
    assert!((MemVT == v4i8 && VT == v4i16) || (MemVT == v2i16 && VT == v2i32);
    let mut Value: SDValue = ST.getValue();
    let mut PoisonVec: SDValue = DAG.getPOISON(VT);
    let mut DblVT: EVT = VT.getDoubleNumVectorElementsVT(*DAG.getContext());
    let mut DblMemVT: EVT = MemVT.getDoubleNumVectorElementsVT(*DAG.getContext());
    let mut TruncExt: SDValue = DAG.getNode(CONCAT_VECTORS, DL, DblVT, Value, PoisonVec);
    let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, DblMemVT, TruncExt);
    Trunc = DAG.getNode(BITCAST, DL, v2i32, Trunc);
    let mut ExtractTrunc: SDValue = DAG.getExtractVectorElt(DL, i32, Trunc, 0);
    return DAG.getStore(ST.getChain(), DL, ExtractTrunc, ST.getBasePtr(), ST.getMemOperand());
}

fn LowerADDRSPACECAST(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Src: SDValue = Op.getOperand(0);
    let mut DestVT: MVT = Op.getSimpleValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut N: *mut AddrSpaceCastSDNode = cast(Op.getNode());
    let mut SrcAS: u32 = N.getSrcAddressSpace();
    let mut DestAS: u32 = N.getDestAddressSpace();
    assert!(SrcAS != DestAS, "addrspacecast must be between different address spaces");
    assert!(DAG.getDataLayout().getPointerSize(SrcAS) != DAG.getDataLayout().getPointerSize(DestAS), "addrspacecast must be between different ptr sizes");
    TLI as void;
    if SrcAS == PTR32_SPTR {
        return DAG.getNode(SIGN_EXTEND, DL, DestVT, Src, DAG.getTargetConstant(0, DL, DestVT, false));
    } else if SrcAS == PTR32_UPTR {
        return DAG.getNode(ZERO_EXTEND, DL, DestVT, Src, DAG.getTargetConstant(0, DL, DestVT, false));
    } else if (DestAS == PTR32_SPTR) || (DestAS == PTR32_UPTR) {
        let mut Ext: SDValue = DAG.getAnyExtOrTrunc(Src, DL, DestVT);
        let mut Trunc: SDValue = DAG.getZeroExtendInReg(Ext, DL, DestVT);
        return Trunc;
    } else {
        return Src;
    }
}

fn isLegalNTStore(DataType: *mut Type, Alignment: Align, DL: *DataLayout) -> bool {
    if !DL.isLittleEndian() {
        return false;
    }
    if DataType.isIntegerTy(64) {
        return true;
    }
    let mut DataTypeTy: *mut auto = dyn_cast(DataType);
    if operator!() {
        return false;
    }
    let mut NumElements: u32 = ();
    let mut EltSizeBits: u32 = ()();
    if !isPowerOf2_64(NumElements) || !isPowerOf2_64(EltSizeBits) {
        return false;
    }
    let mut TotalSizeBits: u32 = ()();
    if TotalSizeBits == 64 || TotalSizeBits == 128 {
        return true;
    }
    if TotalSizeBits == 256 && (EltSizeBits == 8 || EltSizeBits == 16 || EltSizeBits == 32 || EltSizeBits == 64) {
        return true;
    }
    return false;
}

fn LowerNTStore(StoreNode: *mut StoreSDNode, VT: EVT, MemVT: EVT, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!(StoreNode, "Expected a store operation");
    assert!(StoreNode.isNonTemporal(), "Expected a non-temporal store");
    if DAG.shouldOptForSize() {
        return SDValue {};
    }
    if !DAG.getDataLayout().isLittleEndian() {
        return SDValue {};
    }
    if VT.isVector() {
        let mut EC: ElementCount = MemVT.getVectorElementCount();
        if VT.isVector() && MemVT.getSizeInBits().operator unsigned long long() == 256 && EC.isKnownEven() && (MemVT.getScalarSizeInBits() == 8 || MemVT.getScalarSizeInBits() == 16 || MemVT.getScalarSizeInBits() == 32 || MemVT.getScalarSizeInBits() == 64) {
            let mut Lo: SDValue = DAG.getExtractSubvector(DL, MemVT.getHalfNumVectorElementsVT(*DAG.getContext()), StoreNode.getValue(), 0);
            let mut Hi: SDValue = DAG.getExtractSubvector(DL, MemVT.getHalfNumVectorElementsVT(*DAG.getContext()), StoreNode.getValue(), EC.getKnownMinValue() / 2);
            let mut Result: SDValue = DAG;
            assert!(isLegalNTStore(MemVT.getTypeForEVT(*DAG.getContext()), StoreNode.getAlign(), DAG.getDataLayout()), "Lowering should be consistent with legality");
            return Result;
        }
    }
    return SDValue {};
}

struct SVEMultiVectorInfo {
    RegVT: MVT,
    NumVecs: u32,
    LoadIntID: ID,
    StoreIntID: ID,
}

fn getSVEMultiVectorInfo(VT: MVT) -> SVEMultiVectorInfo {
    let mut Info: SVEMultiVectorInfo = SVEMultiVectorInfo {};
    let mut Size: TypeSize = VT.getSizeInBits();
    assert!((Size == getScalable(2 * 128) || Size == getScalable(4 * 128)), "invalid SVE multi-vector size");
    Info.RegVT = getPackedSVEVectorVT(VT.getVectorElementType()).getSimpleVT();
    if Size == getScalable(2 * 128) {
        Info.NumVecs = 2;
    } else {
        Info.NumVecs = 4;
    }
    return Info;
}

fn isSimpleScalableLoadOrStore(LSNode: *LSBaseSDNode, VT: EVT) -> bool {
    return LSNode.isSimple() && LSNode.isUnindexed() && LSNode.getOffset().isUndef() && VT.isScalableVector() && VT.isSimple() && VT == LSNode.getMemoryVT();
}

fn tryLowerMultiVectorStore(StoreNode: *mut StoreSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Value: SDValue = StoreNode.getValue();
    let mut VT: EVT = Value.getValueType();
    if !isSimpleScalableLoadOrStore(StoreNode, VT) {
        return SDValue {};
    }
    if operator(Value).isUndef() {
        return StoreNode.getChain();
    }
    let mut StoreVT: MVT = VT.getSimpleVT();
    let mut MultiVecInfo: SVEMultiVectorInfo = getSVEMultiVectorInfo(StoreVT);
    let mut DL: SDLoc = StoreNode;
    let mut PNg: SDValue = getPTrueAsCounter(DAG, DL, VT);
    let mut Ops: SmallVector<SDValue, 8> = zeroed();
    Ops()(StoreNode.getChain());
    Ops()(DAG.getConstant(MultiVecInfo.StoreIntID, DL, i64, false, false));
    let mut RegElts: u32 = MultiVecInfo.RegVT.getVectorMinNumElements();
    for let mut i: u32 = 0; i != MultiVecInfo.NumVecs; i += 1 {
        Ops()(DAG.getExtractSubvector(DL, MultiVecInfo.RegVT, Value, i * RegElts));
    }
    Ops()(PNg);
    Ops()(StoreNode.getBasePtr());
    return DAG(INTRINSIC_VOID, DL, DAG.getVTList(Other), StoreNode.getMemoryVT(), StoreNode.getMemOperand());
}

fn tryLowerMultiVectorLoad(LoadNode: *mut LoadSDNode, Results: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) -> bool {
    let mut VT: EVT = LoadNode.getValueType(0);
    if !isSimpleScalableLoadOrStore(LoadNode, VT) {
        return false;
    }
    let mut LoadVT: MVT = VT.getSimpleVT();
    let mut MultiVecInfo: SVEMultiVectorInfo = getSVEMultiVectorInfo(LoadVT);
    let mut DL: SDLoc = LoadNode;
    let mut PNg: SDValue = getPTrueAsCounter(DAG, DL, VT);
    let mut ResultVTs: SmallVector<EVT, 5> = zeroed();
    ResultVTs()(Other);
    let mut NewLoad: SDValue = DAG(INTRINSIC_W_CHAIN, DL, void { LoadNode.getChain(), DAG.getConstant(MultiVecInfo.LoadIntID, DL, i64, false, false), PNg, LoadNode.getBasePtr() });
    let mut ResultOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for let mut I: u32 = 0; I != MultiVecInfo.NumVecs; I += 1 {
        ResultOps.push(NewLoad.getValue(I));
    }
    Results.push(DAG);
    Results.push(NewLoad.getValue(MultiVecInfo.NumVecs));
    return true;
}

fn AArch64TargetLowering::LowerSTORE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Dl: SDLoc = Op;
    let mut StoreNode: *mut StoreSDNode = cast(Op);
    assert!(StoreNode, "Can only custom lower store nodes");
    let mut Value: SDValue = StoreNode.getValue();
    let mut VT: EVT = Value.getValueType();
    let mut MemVT: EVT = StoreNode.getMemoryVT();
    if StoreNode.isNonTemporal() {
        if  {
            return ;
        }
    }
    if VT.isVector() {
        if tryLowerMultiVectorStore(StoreNode, DAG) {
            Store;
        } else {
            return Store;
        }
        if self.useSVEForFixedLengthVectorVT(VT, self.Subtarget.useSVEForFixedLengthVectors()) {
            return self.LowerFixedLengthVectorStoreToSVE(Op, DAG);
        }
        let mut AS: u32 = StoreNode.getAddressSpace();
        let mut Alignment: Align = StoreNode.getAlign();
        if Alignment < MemVT.getStoreSize().operator unsigned long long() && !self.allowsMisalignedMemoryAccesses(MemVT, AS, Alignment, StoreNode.getMemOperand().getFlags(), null) {
            return self.scalarizeVectorStore(StoreNode, DAG);
        }
        if StoreNode.isTruncatingStore() && ((VT == v4i16 && MemVT == v4i8) || (VT == v2i32 && MemVT == v2i16)) {
            return LowerTruncateVectorStore(Dl, StoreNode, VT, MemVT, DAG);
        }
    } else if MemVT == i128 && StoreNode.isVolatile() {
        return self.LowerStore128(Op, DAG);
    } else if MemVT == i64x8 {
        let mut Value: SDValue = StoreNode.getValue();
        assert!(operator(Value).getValueType(0) == i64x8);
        let mut Chain: SDValue = StoreNode.getChain();
        let mut Base: SDValue = StoreNode.getBasePtr();
        let mut PtrVT: EVT = Base.getValueType();
        for let mut i: u32 = 0; i < 8; i += 1 {
            let mut Part: SDValue = DAG;
            let mut Ptr: SDValue = DAG.getNode(ADD, Dl, PtrVT, Base, DAG.getConstant(i * 8, Dl, PtrVT, false, false));
            Chain = DAG.getStore(Chain, Dl, Part, Ptr, StoreNode.getPointerInfo(), StoreNode.getBaseAlign(), MONone, MMOMetadata {});
        }
        return Chain;
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerStore128(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut StoreNode: *mut MemSDNode = cast(Op);
    assert!(StoreNode.getMemoryVT() == i128);
    assert!(StoreNode.isVolatile() || StoreNode.isAtomic();
    let mut IsStoreRelease: bool = StoreNode.getMergedOrdering() == Release;
    if StoreNode.isAtomic() {
        (((operator!(operator!(((self.Subtarget && self.Subtarget && IsStoreRelease) || StoreNode.getMergedOrdering() == Unordered || StoreNode.getMergedOrdering() == Monotonic)))) || (_wassert(L"(Subtarget->hasFeature(AArch64::FeatureLSE2) && Subtarget->hasFeature(AArch64::FeatureRCPC3) && IsStoreRelease) || StoreNode->getMergedOrdering() == AtomicOrdering::Unordered || StoreNode->getMergedOrdering() == AtomicOrdering::Monotonic", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (8118) as u32) , 0)) as void);
    }
    let mut Value: SDValue = if (StoreNode.getOpcode() == STORE || StoreNode.getOpcode() == ATOMIC_STORE) { StoreNode.getOperand(1) } else { StoreNode.getOperand(2) };
    let mut DL: SDLoc = Op;
    let mut StoreValue: auto = DAG.SplitScalar(Value, DL, i64, i64);
    let mut Opcode: u32 = 0;
    if DAG.getDataLayout().isBigEndian() {
        swap();
    }
    let mut Result: SDValue = DAG(Opcode, DL, DAG.getVTList(Other), void { StoreNode.getChain(), StoreNode.getBasePtr() }, StoreNode.getMemoryVT(), StoreNode.getMemOperand());
    return Result;
}

fn tryLowerSmallVectorExtLoad(Load: *mut LoadSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Subtarget: *AArch64Subtarget = DAG;
    if !isEligibleForSmallVectorLoadOpt(Load, Subtarget) {
        return SDValue {};
    }
    let mut MemVT: EVT = Load.getMemoryVT();
    let mut ResVT: EVT = Load.getValueType(0);
    let mut NumElts: u32 = ResVT.getVectorNumElements();
    let mut DstEltBits: u32 = ResVT.getScalarSizeInBits();
    let mut SrcEltBits: u32 = MemVT.getScalarSizeInBits();
    let mut ExtOpcode: u32 = 0;
    match Load.getExtensionType() {
        EXTLOAD => {
            ZEXTLOAD;
        },
        SEXTLOAD => {
            ExtOpcode = SIGN_EXTEND;
        },
        NON_EXTLOAD => {
            return SDValue {};
        },
    }
    let mut DL: SDLoc = Load;
    let mut Chain: SDValue = Load.getChain();
    let mut BasePtr: SDValue = Load.getBasePtr();
    let mut PtrInfo: *MachinePointerInfo = Load.getPointerInfo();
    let mut Alignment: Align = Load.getAlign();
    let mut LoadBits: u32 = MemVT.getStoreSizeInBits().operator unsigned long long();
    let mut ScalarLoadType: MVT = getFloatingPointVT(LoadBits);
    let mut ScalarLoad: SDValue = DAG.getLoad(ScalarLoadType, DL, Chain, BasePtr, PtrInfo, Alignment, MONone, MMOMetadata {});
    let mut ScalarToVecTy: MVT = getVectorVT(ScalarLoadType, 128 / LoadBits);
    let mut ScalarToVec: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, ScalarToVecTy, ScalarLoad);
    let mut BitcastTy: MVT = getVectorVT(getIntegerVT(SrcEltBits), 128 / SrcEltBits);
    let mut Bitcast: SDValue = DAG.getNode(BITCAST, DL, BitcastTy, ScalarToVec);
    let mut Res: SDValue = Bitcast;
    let mut CurrentEltBits: u32 = Res.getValueType().getScalarSizeInBits();
    let mut CurrentNumElts: u32 = Res.getValueType().getVectorNumElements();
    while CurrentEltBits < DstEltBits {
        if Res.getValueSizeInBits().operator unsigned long long() >= 128 {
            CurrentNumElts = CurrentNumElts / 2;
            let mut ExtractVT: MVT = getVectorVT(getIntegerVT(CurrentEltBits), CurrentNumElts);
            Res = DAG.getExtractSubvector(DL, ExtractVT, Res, 0);
        }
        CurrentEltBits = CurrentEltBits * 2;
        let mut ExtVT: MVT = getVectorVT(getIntegerVT(CurrentEltBits), CurrentNumElts);
        Res = DAG.getNode(ExtOpcode, DL, ExtVT, Res);
    }
    if CurrentNumElts != NumElts {
        let mut FinalVT: MVT = getVectorVT(getIntegerVT(CurrentEltBits), NumElts);
        Res = DAG.getExtractSubvector(DL, FinalVT, Res, 0);
    }
    return DAG.getMergeValues([Res, ScalarLoad.getValue(1)], DL);
}

fn AArch64TargetLowering::LowerLOAD(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut LoadNode: *mut LoadSDNode = cast(Op);
    assert!(LoadNode, "Expected custom lowering of a load node");
    let mut OverrideNeon: bool = !self.Subtarget.isNeonAvailable() || cast(Op)() == v2i8;
    if self.useSVEForFixedLengthVectorVT(Op.getValueType(), OverrideNeon) {
        return self.LowerFixedLengthVectorLoadToSVE(Op, DAG);
    }
    if tryLowerSmallVectorExtLoad(LoadNode, DAG) {
        Result;
    } else {
        return Result;
    }
    if LoadNode.getMemoryVT() == i64x8 {
        let mut Ops: SmallVector<SDValue, 8> = zeroed();
        let mut Base: SDValue = LoadNode.getBasePtr();
        let mut Chain: SDValue = LoadNode.getChain();
        let mut PtrVT: EVT = Base.getValueType();
        for let mut i: u32 = 0; i < 8; i += 1 {
            let mut Ptr: SDValue = DAG.getNode(ADD, DL, PtrVT, Base, DAG.getConstant(i * 8, DL, PtrVT, false, false));
            let mut Part: SDValue = DAG.getLoad(i64, DL, Chain, Ptr, LoadNode.getPointerInfo(), LoadNode.getBaseAlign(), MONone, MMOMetadata {});
            Ops()(Part);
            Chain = SDValue { Node: Part.getNode(), ResNo: 1 };
        }
        let mut Loaded: SDValue = DAG;
        return DAG.getMergeValues([Loaded, Chain], DL);
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerFixedLengthVectorCompressToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut Vec: SDValue = convertToScalableVector(DAG, ContainerVT, Op.getOperand(0));
    let mut Mask: SDValue = convertFixedMaskToScalableVector(Op.getOperand(1), DAG);
    let mut Passthru: SDValue = convertToScalableVector(DAG, ContainerVT, Op.getOperand(2));
    let mut Result: SDValue = DAG.getNode(VECTOR_COMPRESS, DL, ContainerVT, Vec, Mask, Passthru);
    return convertFromScalableVector(DAG, VT, Result);
}

fn AArch64TargetLowering::LowerVECTOR_COMPRESS(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    if VT.isFixedLengthVector() {
        return self.LowerFixedLengthVectorCompressToSVE(Op, DAG);
    }
    let mut DL: SDLoc = Op;
    let mut Vec: SDValue = Op.getOperand(0);
    let mut Mask: SDValue = Op.getOperand(1);
    let mut Passthru: SDValue = Op.getOperand(2);
    let mut MaskVT: EVT = Mask.getValueType();
    let mut Compressed: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, Vec.getValueType(), DAG, Mask, Vec);
    if Passthru.isUndef() || isConstantSplatVectorAllZeros(Passthru.getNode(), false) {
        return Compressed;
    }
    let mut CntActive: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, i64, DAG, Mask, Mask);
    let mut Zero: SDValue = DAG.getConstant(0, DL, i64, false, false);
    let mut CompressedMask: SDValue = DAG.getNode(GET_ACTIVE_LANE_MASK, DL, MaskVT, Zero, CntActive);
    return DAG.getNode(VSELECT, DL, VT, CompressedMask, Compressed, Passthru);
}

fn AArch64TargetLowering::LowerSMULFIXSAT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!((VT == v4i16 || VT == v8i16 || VT == v2i32 || VT == v4i32), "Unexpected type for SMULFIXSAT lowering");
    let mut Scale: u32 = Op.getConstantOperandVal(2);
    if Scale != VT.getScalarSizeInBits() - 1 {
        return SDValue {};
    }
    return DAG;
}

fn AArch64TargetLowering::LowerABS(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = Op.getSimpleValueType();
    if VT.isVector() {
        return self.LowerToPredicatedOp;
    }
    let mut DL: SDLoc = Op;
    let mut Neg: SDValue = DAG.getNegative(Op.getOperand(0), DL, VT);
    let mut Cmp: SDValue = DAG;
    return DAG;
}

fn LowerBRCOND(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Chain: SDValue = Op.getOperand(0);
    let mut Cond: SDValue = Op.getOperand(1);
    let mut Dest: SDValue = Op.getOperand(2);
    let mut CC: CondCode = zeroed();
    if emitConjunction(DAG, Cond, CC) {
        Cmp;
    } else {
        let mut DL: SDLoc = Op;
        let mut CCVal: SDValue = getCondCode(DAG, CC);
        return DAG;
    }
    return SDValue {};
}

fn LowerFunnelShift(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Shifts: SDValue = Op.getOperand(2);
    if  {
        let mut DL: SDLoc = Op;
        let mut VT: MVT = Op.getSimpleValueType();
        let mut NewShiftNo: u32 = () % VT.getFixedSizeInBits();
        if Op.getOpcode() == FSHL {
            if NewShiftNo == 0 {
                return Op.getOperand(0);
            }
            NewShiftNo = VT.getFixedSizeInBits() - NewShiftNo;
            return DAG.getNode(FSHR, DL, VT, Op.getOperand(0), Op.getOperand(1), DAG.getConstant(NewShiftNo, DL, Shifts.getValueType(), false, false));
        }
        if Op.getOpcode() == FSHR {
            if NewShiftNo == 0 {
                return Op.getOperand(1);
            }
            if ShiftNo()() == NewShiftNo {
                return Op;
            }
            return DAG.getNode(FSHR, DL, VT, Op.getOperand(0), Op.getOperand(1), DAG.getConstant(NewShiftNo, DL, Shifts.getValueType(), false, false));
        }
    }
    return SDValue {};
}

fn LowerFLDEXP(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut X: SDValue = Op.getOperand(0);
    let mut XScalarTy: EVT = X.getValueType();
    let mut Exp: SDValue = Op.getOperand(1);
    let mut DL: SDLoc = Op;
    let mut XVT: EVT = EVT {};
    let mut ExpVT: EVT = EVT {};
    match Op.getSimpleValueType().SimpleTy {
        _ => {
            return SDValue {};
        },
        bf16 => {
            f16;
        },
        f32 => {
            XVT = nxv4f32;
        },
        f64 => {
            XVT = nxv2f64;
        },
    }
    let mut VX: SDValue = DAG.getInsertVectorElt(DL, DAG.getPOISON(XVT), X, 0);
    let mut VExp: SDValue = DAG.getInsertVectorElt(DL, DAG.getPOISON(ExpVT), Exp, 0);
    let mut VPg: SDValue = DAG.getConstant(1, DL, XVT.changeVectorElementType(*DAG.getContext(), i1), false, false);
    let mut FScale: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, XVT, DAG, VPg, VX, VExp);
    let mut Final: SDValue = DAG.getExtractVectorElt(DL, X.getValueType(), FScale, 0);
    if X.getValueType() != XScalarTy {
        Final = DAG.getNode(FP_ROUND, DL, XScalarTy, Final, DAG.getIntPtrConstant(1, Op, true));
    }
    return Final;
}

fn AArch64TargetLowering::LowerADJUST_TRAMPOLINE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    return Op.getOperand(0);
}

fn AArch64TargetLowering::LowerINIT_TRAMPOLINE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Chain: SDValue = Op.getOperand(0);
    let mut Trmp: SDValue = Op.getOperand(1);
    let mut FPtr: SDValue = Op.getOperand(2);
    let mut Nest: SDValue = Op.getOperand(3);
    let mut TrmpAddr: *Value = cast(Op.getOperand(4))();
    let mut OutChains: [5]SDValue = [5]SDValue {};
    let mut Func: *Function = cast(cast(Op.getOperand(5))());
    let mut CC: ID = Func.getCallingConv();
    let mut NestReg: u32 = 0;
    match CC {
        _ => {
            NestReg = 15;
        },
        ARM64EC_Thunk_X64 => {
            NestReg = 4;
        },
    }
    let mut FptrReg: i8 = 17;
    let mut Addr: SDValue = Trmp;
    let mut DL: SDLoc = Op;
    OutChains[0] = DAG.getStore(Chain, DL, DAG.getConstant(1476395136 | NestReg, DL, i32, false, false), Addr, MachinePointerInfo { TrmpAddr, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    Addr = DAG.getNode(ADD, DL, i64, Trmp, DAG.getConstant(4, DL, i64, false, false));
    OutChains[1] = DAG.getStore(Chain, DL, DAG.getConstant(1476395184 | FptrReg, DL, i32, false, false), Addr, MachinePointerInfo { TrmpAddr, 4, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    Addr = DAG.getNode(ADD, DL, i64, Trmp, DAG.getConstant(8, DL, i64, false, false));
    OutChains[2] = DAG.getStore(Chain, DL, DAG.getConstant(3592356384, DL, i32, false, false), Addr, MachinePointerInfo { TrmpAddr, 8, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    Addr = DAG.getNode(ADD, DL, i64, Trmp, DAG.getConstant(16, DL, i64, false, false));
    OutChains[3] = DAG.getStore(Chain, DL, Nest, Addr, MachinePointerInfo { TrmpAddr, 16, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    Addr = DAG.getNode(ADD, DL, i64, Trmp, DAG.getConstant(24, DL, i64, false, false));
    OutChains[4] = DAG.getStore(Chain, DL, FPtr, Addr, MachinePointerInfo { TrmpAddr, 24, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    let mut StoreToken: SDValue = DAG;
    let mut EndOfTrmp: SDValue = DAG.getNode(ADD, DL, i64, Trmp, DAG.getConstant(12, DL, i64, false, false));
    return DAG.getNode(CLEAR_CACHE, DL, Other, StoreToken, Trmp, EndOfTrmp);
}

fn AArch64TargetLowering::LowerFMUL(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    if VT.getScalarType() != bf16 || (self.Subtarget() && self.Subtarget.isNonStreamingSVEorSME2Available()) {
        return self.LowerToPredicatedOp;
    }
    (((operator!(operator!((self.Subtarget() && "Expected +bf16 for custom FMUL lowering")))) || (_wassert(L"Subtarget->hasBF16() && \"Expected +bf16 for custom FMUL lowering\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (8507) as u32) , 0)) as void);
    assert!((VT == nxv4bf16 || VT == nxv8bf16 || VT == v8bf16), "Unexpected FMUL VT");
    let mut MakeGetIntrinsic: Closure_8 = Closure_8 { DAG: &mut DAG, DL: &mut DL };
    let mut Reinterpret: Closure_10 = Closure_10 { DAG: &mut DAG, DL: &mut DL };
    let mut UseSVEBFMLAL: bool = VT.isScalableVector();
    let mut FCVT: auto = MakeGetIntrinsic();
    let mut FCVTNT: auto = MakeGetIntrinsic();
    let mut BFMLALB: auto = MakeGetIntrinsic();
    let mut BFMLALT: auto = MakeGetIntrinsic();
    let mut AccVT: EVT = if UseSVEBFMLAL { nxv4f32 } else { v4f32 };
    let mut IgnoreZeroSign: bool = DAG.canIgnoreSignBitOfZero(Op);
    let mut Zero: SDValue = DAG.getConstantFP(if IgnoreZeroSign { 0.0 } else { -0.0 }, DL, AccVT, false);
    let mut Pg: SDValue = getPredicateForVector(DAG, DL, AccVT);
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    if UseSVEBFMLAL {
        LHS = Reinterpret(LHS, nxv8bf16);
        RHS = Reinterpret(RHS, nxv8bf16);
    }
    let mut BottomF32: SDValue = Reinterpret((AccVT, Zero, LHS, RHS), nxv4f32);
    let mut BottomBF16: SDValue = (nxv8bf16, DAG.getPOISON(nxv8bf16), Pg, BottomF32);
    if VT == nxv4bf16 {
        return Reinterpret(BottomBF16, VT);
    }
    let mut TopF32: SDValue = Reinterpret((AccVT, Zero, LHS, RHS), nxv4f32);
    let mut TopBF16: SDValue = (nxv8bf16, BottomBF16, Pg, TopF32);
    return Reinterpret(TopBF16, VT);
}

fn AArch64TargetLowering::LowerFMA(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut OpA: SDValue = operator(Op).getOperand(0);
    let mut OpB: SDValue = operator(Op).getOperand(1);
    let mut OpC: SDValue = operator(Op).getOperand(2);
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    assert!(VT.isVector(), "Scalar fma lowering should be handled by patterns");
    if VT != v8f16 && VT != v4f32 && VT != v2f64 {
        return self.LowerToPredicatedOp;
    }
    if OpC.getOpcode() != FNEG {
        return if self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()) { self.LowerToPredicatedOp } else { Op };
    }
    let mut Pg: SDValue = getPredicateForVector(DAG, DL, VT);
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut ConvertToScalableFnegMt: Closure_11 = Closure_11 { cap_0: self, DAG: &mut DAG, ContainerVT: &mut ContainerVT };
    OpA = ConvertToScalableFnegMt.call(OpA);
    OpB = ConvertToScalableFnegMt.call(OpB);
    OpC = ConvertToScalableFnegMt.call(OpC);
    let mut ScalableRes: SDValue = DAG;
    return convertFromScalableVector(DAG, VT, ScalableRes);
}

fn DoCrossByteCLMUL(OpA: SDValue, OpB: SDValue, DL: SDLoc, DAG: *mut SelectionDAG, VT: EVT) -> SDValue {
    let mut LoBytes: SDValue = DAG;
    let mut HiBytes: SDValue = DAG;
    let mut CLMUL: SDValue = DAG.getNode(CLMUL, DL, VT, HiBytes, LoBytes);
    let mut EORBT: SDValue = DAG;
    EORBT = DAG.getNode(INTRINSIC_WO_CHAIN, DL, VT, EORBT, CLMUL, CLMUL, CLMUL);
    let mut PMULLB: SDValue = DAG;
    PMULLB = DAG.getNode(INTRINSIC_WO_CHAIN, DL, VT, PMULLB, OpA, OpB);
    let mut EORTB: SDValue = DAG;
    return DAG.getNode(INTRINSIC_WO_CHAIN, DL, VT, EORTB, PMULLB, PMULLB, EORBT);
}

fn AArch64TargetLowering::LowerCLMUL(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    assert!((VT == i64 || VT == i32 || VT == i16 || VT == i8 || VT == v4i32 || VT == nxv8i16 || VT == nxv2i64), "Unexpected Type");
    let mut ScalarSize: u64 = VT.getScalarSizeInBits();
    let mut HiWordMask: APInt = getBitsSet(ScalarSize, ScalarSize / 2, ScalarSize);
    if VT == v4i32 {
        let mut LoA: SDValue = DAG.getExtractSubvector(DL, v2i32, Op.getOperand(0), 0);
        let mut LoB: SDValue = DAG.getExtractSubvector(DL, v2i32, Op.getOperand(1), 0);
        let mut HiA: SDValue = DAG.getExtractSubvector(DL, v2i32, Op.getOperand(0), 2);
        let mut HiB: SDValue = DAG.getExtractSubvector(DL, v2i32, Op.getOperand(1), 2);
        let mut LoCLMUL: SDValue = DAG.getNode(CLMUL, DL, v2i32, LoA, LoB);
        let mut HiCLMUL: SDValue = DAG.getNode(CLMUL, DL, v2i32, HiA, HiB);
        return DAG.getNode(CONCAT_VECTORS, DL, VT, LoCLMUL, HiCLMUL);
    }
    if VT == nxv2i64 {
        let mut OpA: SDValue = DAG;
        let mut OpB: SDValue = DAG;
        if (self.Subtarget() || self.Subtarget()) && DAG.MaskedValueIsZero(Op.getOperand(0), HiWordMask, 0) && DAG.MaskedValueIsZero(Op.getOperand(1), HiWordMask, 0) {
            let mut PMULLB: SDValue = DAG;
            PMULLB = DAG.getNode(INTRINSIC_WO_CHAIN, DL, nxv4i32, PMULLB, OpA, OpB);
            return DAG;
        }
        if self.Subtarget() && (self.Subtarget.isSVEAvailable() || self.Subtarget()) {
            return Op;
        }
        if self.Subtarget() || self.Subtarget() {
            let mut CrossCLMUL: SDValue = DoCrossByteCLMUL(OpA, OpB, DL, DAG, nxv4i32);
            return DAG;
        }
        return SDValue {};
    }
    if VT == nxv8i16 {
        let mut OpA: SDValue = DAG;
        let mut OpB: SDValue = DAG;
        if DAG.MaskedValueIsZero(Op.getOperand(0), HiWordMask, 0) && DAG.MaskedValueIsZero(Op.getOperand(1), HiWordMask, 0) {
            let mut PMULLB: SDValue = DAG;
            PMULLB = DAG.getNode(INTRINSIC_WO_CHAIN, DL, nxv16i8, PMULLB, OpA, OpB);
            return DAG;
        }
        let mut CrossCLMUL: SDValue = DoCrossByteCLMUL(OpA, OpB, DL, DAG, nxv16i8);
        return DAG;
    }
    let mut VecVT: EVT = getVectorVT(*DAG.getContext(), VT, 64 / VT.getSizeInBits().operator unsigned long long(), false);
    let mut CLMULTy: EVT = if VT == i8 { v8i8 } else { v1i64 };
    let mut ExtractTy: EVT = if VT == i64 {} else { i32 };
    let mut VecOp0: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, Op.getOperand(0));
    let mut VecOp1: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, VecVT, Op.getOperand(1));
    if VecVT != CLMULTy {
        VecOp0 = DAG.getNode(BITCAST, DL, CLMULTy, VecOp0);
        VecOp1 = DAG.getNode(BITCAST, DL, CLMULTy, VecOp1);
    }
    let mut CLMUL: SDValue = DAG.getNode(CLMUL, DL, CLMULTy, VecOp0, VecOp1);
    if ExtractTy == i32 {
        CLMUL = DAG.getNode(BITCAST, DL, v2i32, CLMUL);
    }
    let mut ExtractVecElt: SDValue = DAG.getExtractVectorElt(DL, ExtractTy, CLMUL, 0);
    if ExtractTy != VT {
        ExtractVecElt = DAG.getNode(TRUNCATE, DL, VT, ExtractVecElt);
    }
    return ExtractVecElt;
}

fn AArch64TargetLowering::LowerOperation(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
            dbgs() << "Custom lowering: ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
            Op.dump();
        }
    }
        if !(false) { break; }
    }
    match Op.getOpcode() {
        _ => {
            llvm_unreachable_internal("unimplemented operand", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 8736);
        },
        LOOP_DEPENDENCE_RAW_MASK => {
            LOOP_DEPENDENCE_WAR_MASK;
        },
        BITCAST => {
            return self.LowerBITCAST(Op, DAG);
        },
        GlobalAddress => {
            return self.LowerGlobalAddress(Op, DAG);
        },
        GlobalTLSAddress => {
            return self.LowerGlobalTLSAddress(Op, DAG);
        },
        PtrAuthGlobalAddress => {
            return self.LowerPtrAuthGlobalAddress(Op, DAG);
        },
        ADJUST_TRAMPOLINE => {
            return self.LowerADJUST_TRAMPOLINE(Op, DAG);
        },
        INIT_TRAMPOLINE => {
            return self.LowerINIT_TRAMPOLINE(Op, DAG);
        },
        SETCC => {
            STRICT_FSETCC;
        },
        SETCCCARRY => {
            return self.LowerSETCCCARRY(Op, DAG);
        },
        BRCOND => {
            return LowerBRCOND(Op, DAG);
        },
        BR_CC => {
            return self.LowerBR_CC(Op, DAG);
        },
        SELECT => {
            return self.LowerSELECT(Op, DAG);
        },
        SELECT_CC => {
            return self.LowerSELECT_CC(Op, DAG);
        },
        JumpTable => {
            return self.LowerJumpTable(Op, DAG);
        },
        BR_JT => {
            return self.LowerBR_JT(Op, DAG);
        },
        BRIND => {
            return self.LowerBRIND(Op, DAG);
        },
        ConstantPool => {
            return self.LowerConstantPool(Op, DAG);
        },
        BlockAddress => {
            return self.LowerBlockAddress(Op, DAG);
        },
        VASTART => {
            return self.LowerVASTART(Op, DAG);
        },
        VACOPY => {
            return self.LowerVACOPY(Op, DAG);
        },
        VAARG => {
            return self.LowerVAARG(Op, DAG);
        },
        UADDO_CARRY => {
            return lowerADDSUBO_CARRY(Op, DAG, false);
        },
        USUBO_CARRY => {
            return lowerADDSUBO_CARRY(Op, DAG, false);
        },
        SADDO_CARRY => {
            return lowerADDSUBO_CARRY(Op, DAG, true);
        },
        SSUBO_CARRY => {
            return lowerADDSUBO_CARRY(Op, DAG, true);
        },
        SADDO => {
            UADDO;
        },
        FADD => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FADD => {
            return self.LowerToPredicatedOp;
        },
        FSUB => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FSUB => {
            return self.LowerToPredicatedOp;
        },
        FMUL => {
            return self.LowerFMUL(Op, DAG);
        },
        STRICT_FMUL => {
            return self.LowerToPredicatedOp;
        },
        FMA => {
            return self.LowerFMA(Op, DAG);
        },
        STRICT_FMA => {
            return self.LowerToPredicatedOp;
        },
        FDIV => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FDIV => {
            return self.LowerToPredicatedOp;
        },
        FNEG => {
            return self.LowerToPredicatedOp;
        },
        FCEIL => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FCEIL => {
            return self.LowerToPredicatedOp;
        },
        FFLOOR => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FFLOOR => {
            return self.LowerToPredicatedOp;
        },
        FNEARBYINT => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FNEARBYINT => {
            return self.LowerToPredicatedOp;
        },
        FRINT => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FRINT => {
            return self.LowerToPredicatedOp;
        },
        FROUND => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FROUND => {
            return self.LowerToPredicatedOp;
        },
        FROUNDEVEN => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FROUNDEVEN => {
            return self.LowerToPredicatedOp;
        },
        FTRUNC => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FTRUNC => {
            return self.LowerToPredicatedOp;
        },
        FSQRT => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FSQRT => {
            return self.LowerToPredicatedOp;
        },
        FABS => {
            return self.LowerToPredicatedOp;
        },
        FP_ROUND => {
            STRICT_FP_ROUND;
        },
        FP_EXTEND => {
            STRICT_FP_EXTEND;
        },
        FRAMEADDR => {
            return self.LowerFRAMEADDR(Op, DAG);
        },
        SPONENTRY => {
            return self.LowerSPONENTRY(Op, DAG);
        },
        RETURNADDR => {
            return self.LowerRETURNADDR(Op, DAG);
        },
        ADDROFRETURNADDR => {
            return self.LowerADDROFRETURNADDR(Op, DAG);
        },
        CONCAT_VECTORS => {
            return self.LowerCONCAT_VECTORS(Op, DAG);
        },
        INSERT_VECTOR_ELT => {
            return self.LowerINSERT_VECTOR_ELT(Op, DAG);
        },
        EXTRACT_VECTOR_ELT => {
            return self.LowerEXTRACT_VECTOR_ELT(Op, DAG);
        },
        BUILD_VECTOR => {
            return self.LowerBUILD_VECTOR(Op, DAG);
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        ZERO_EXTEND_VECTOR_INREG => {
            return self.LowerZERO_EXTEND_VECTOR_INREG(Op, DAG);
        },
        VECTOR_REPEAT => {
            return self.LowerVECTOR_REPEAT(Op, DAG);
        },
        VECTOR_SHUFFLE => {
            return self.LowerVECTOR_SHUFFLE(Op, DAG);
        },
        VECTOR_REVERSE => {
            return self.LowerVECTOR_REVERSE(Op, DAG);
        },
        SPLAT_VECTOR => {
            return self.LowerSPLAT_VECTOR(Op, DAG);
        },
        EXTRACT_SUBVECTOR => {
            return self.LowerEXTRACT_SUBVECTOR(Op, DAG);
        },
        INSERT_SUBVECTOR => {
            return self.LowerINSERT_SUBVECTOR(Op, DAG);
        },
        MASKED_SDIV => {
            MASKED_UDIV;
        },
        SMIN => {
            UMIN;
        },
        SRA => {
            SRL;
        },
        SHL_PARTS => {
            SRL_PARTS;
        },
        CTPOP => {
            PARITY;
        },
        FCOPYSIGN => {
            return self.LowerFCOPYSIGN(Op, DAG);
        },
        OR => {
            return self.LowerVectorOR(Op, DAG);
        },
        XOR => {
            return self.LowerXOR(Op, DAG);
        },
        PREFETCH => {
            return LowerPREFETCH(Op, DAG);
        },
        SINT_TO_FP => {
            UINT_TO_FP;
        },
        FP_TO_SINT => {
            FP_TO_UINT;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        GET_ROUNDING => {
            return self.LowerGET_ROUNDING(Op, DAG);
        },
        SET_ROUNDING => {
            return self.LowerSET_ROUNDING(Op, DAG);
        },
        GET_FPMODE => {
            return self.LowerGET_FPMODE(Op, DAG);
        },
        SET_FPMODE => {
            return self.LowerSET_FPMODE(Op, DAG);
        },
        RESET_FPMODE => {
            return self.LowerRESET_FPMODE(Op, DAG);
        },
        MUL => {
            return self.LowerMUL(Op, DAG);
        },
        MULHS => {
            return self.LowerToPredicatedOp;
        },
        MULHU => {
            return self.LowerToPredicatedOp;
        },
        INTRINSIC_W_CHAIN => {
            return self.LowerINTRINSIC_W_CHAIN(Op, DAG);
        },
        INTRINSIC_WO_CHAIN => {
            return self.LowerINTRINSIC_WO_CHAIN(Op, DAG);
        },
        INTRINSIC_VOID => {
            return self.LowerINTRINSIC_VOID(Op, DAG);
        },
        ATOMIC_STORE => {
            if cast(Op)() == i128 {
                (((operator!(operator!((self.Subtarget() || self.Subtarget())))) || (_wassert(L"Subtarget->hasLSE2() || Subtarget->hasRCPC3()", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (8967) as u32) , 0)) as void);
                return self.LowerStore128(Op, DAG);
            }
        },
        STORE => {
            return self.LowerSTORE(Op, DAG);
        },
        MSTORE => {
            return self.LowerMSTORE(Op, DAG);
        },
        MGATHER => {
            return self.LowerMGATHER(Op, DAG);
        },
        MSCATTER => {
            return self.LowerMSCATTER(Op, DAG);
        },
        VECREDUCE_SEQ_FADD => {
            return self.LowerVECREDUCE_SEQ_FADD(Op, DAG);
        },
        VECREDUCE_ADD => {
            VECREDUCE_AND;
        },
        VECREDUCE_MUL => {
            VECREDUCE_FMUL;
        },
        ATOMIC_LOAD_AND => {
            return self.LowerATOMIC_LOAD_AND(Op, DAG);
        },
        DYNAMIC_STACKALLOC => {
            return self.LowerDYNAMIC_STACKALLOC(Op, DAG);
        },
        VSCALE => {
            return self.LowerVSCALE(Op, DAG);
        },
        VECTOR_COMPRESS => {
            return self.LowerVECTOR_COMPRESS(Op, DAG);
        },
        ANY_EXTEND => {
            SIGN_EXTEND;
        },
        ADDRSPACECAST => {
            return LowerADDRSPACECAST(Op, DAG);
        },
        SIGN_EXTEND_INREG => {
            let mut ExtraVT: EVT = cast(Op.getOperand(1))();
            let mut ExtraEltVT: EVT = ExtraVT.getVectorElementType();
            if (ExtraEltVT != i8) && (ExtraEltVT != i16) && (ExtraEltVT != i32) && (ExtraEltVT != i64) {
                return SDValue {};
            }
            return self.LowerToPredicatedOp;
        },
        TRUNCATE => {
            return self.LowerTRUNCATE(Op, DAG);
        },
        MLOAD => {
            return self.LowerMLOAD(Op, DAG);
        },
        LOAD => {
            return self.LowerLOAD(Op, DAG);
        },
        ADD => {
            AND;
        },
        FMAXIMUM => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FMAXIMUM => {
            return self.LowerToPredicatedOp;
        },
        FMAXNUM => {
            FMAXNUM_IEEE;
        },
        STRICT_FMAXNUM => {
            return self.LowerToPredicatedOp;
        },
        FMINIMUM => {
            return self.LowerToPredicatedOp;
        },
        STRICT_FMINIMUM => {
            return self.LowerToPredicatedOp;
        },
        FMINNUM => {
            FMINNUM_IEEE;
        },
        STRICT_FMINNUM => {
            return self.LowerToPredicatedOp;
        },
        VSELECT => {
            return self.LowerFixedLengthVectorSelectToSVE(Op, DAG);
        },
        ABS => {
            return self.LowerABS(Op, DAG);
        },
        SMULFIXSAT => {
            return self.LowerSMULFIXSAT(Op, DAG);
        },
        ABDS => {
            return self.LowerToPredicatedOp;
        },
        ABDU => {
            return self.LowerToPredicatedOp;
        },
        AVGFLOORS => {
            return self.LowerAVG;
        },
        AVGFLOORU => {
            return self.LowerAVG;
        },
        AVGCEILS => {
            return self.LowerAVG;
        },
        AVGCEILU => {
            return self.LowerAVG;
        },
        BITREVERSE => {
            return self.LowerBitreverse(Op, DAG);
        },
        BSWAP => {
            return self.LowerToPredicatedOp;
        },
        CTLZ => {
            return self.LowerToPredicatedOp;
        },
        CTTZ => {
            return self.LowerCTTZ(Op, DAG);
        },
        VECTOR_SPLICE_LEFT => {
            VECTOR_SPLICE_RIGHT;
        },
        VECTOR_DEINTERLEAVE => {
            return self.LowerVECTOR_DEINTERLEAVE(Op, DAG);
        },
        VECTOR_INTERLEAVE => {
            return self.LowerVECTOR_INTERLEAVE(Op, DAG);
        },
        GET_ACTIVE_LANE_MASK => {
            return self.LowerGET_ACTIVE_LANE_MASK(Op, DAG);
        },
        VECTOR_MATCH => {
            return LowerVectorMatch(Op, DAG);
        },
        LRINT => {
            LLRINT;
        },
        LROUND => {
            LLROUND;
        },
        STRICT_LROUND => {
            STRICT_LLROUND;
        },
        WRITE_REGISTER => {
            assert!(Op.getOperand(2).getValueType() == i128, "WRITE_REGISTER custom lowering is only for 128-bit sysregs");
            let mut DL: SDLoc = Op;
            let mut Chain: SDValue = Op.getOperand(0);
            let mut SysRegName: SDValue = Op.getOperand(1);
            let mut Pair: pair<SDValue, SDValue> = DAG.SplitScalar(Op.getOperand(2), DL, i64, i64);
            let mut Result: SDValue = DAG;
            return Result;
        },
        FSHL => {
            FSHR;
        },
        FLDEXP => {
            return LowerFLDEXP(Op, DAG);
        },
        EXPERIMENTAL_VECTOR_HISTOGRAM => {
            return self.LowerVECTOR_HISTOGRAM(Op, DAG);
        },
        PARTIAL_REDUCE_SMLA => {
            PARTIAL_REDUCE_UMLA;
        },
        CLMUL => {
            return self.LowerCLMUL(Op, DAG);
        },
        PEXT => {
            PDEP;
        },
        FCANONICALIZE => {
            return self.LowerFCANONICALIZE(Op, DAG);
        },
        CTTZ_ELTS => {
            CTTZ_ELTS_ZERO_POISON;
        },
    }
}

fn AArch64TargetLowering::mergeStoresAfterLegalization(self: *AArch64TargetLowering, VT: EVT) -> bool {
    return !self.Subtarget.useSVEForFixedLengthVectors();
}

fn AArch64TargetLowering::useSVEForFixedLengthVectorVT(self: *AArch64TargetLowering, VT: EVT, OverrideNEON: bool) -> bool {
    if !VT.isFixedLengthVector() || !VT.isSimple() {
        return false;
    }
    match VT.getVectorElementType().getSimpleVT().SimpleTy {
        i1 => {
            false;
        },
        bf16 => {
            if operator!() {
                return false;
            }
        },
        i8 => {
            i16;
        },
    }
    if OverrideNEON && (VT.is128BitVector() || VT.is64BitVector()) {
        return self.Subtarget.isSVEorStreamingSVEAvailable();
    }
    if VT.getFixedSizeInBits() <= 128 {
        return false;
    }
    if !self.Subtarget.useSVEForFixedLengthVectors() {
        return false;
    }
    if VT.getFixedSizeInBits() > self.Subtarget.getMinSVEVectorSizeInBits() {
        return false;
    }
    if !VT.isPow2VectorType() {
        return false;
    }
    return true;
}

fn getIntrinsicID(N: *SDNode) -> u32 {
    let mut Opcode: u32 = N.getOpcode();
    match Opcode {
        _ => {
            return not_intrinsic;
        },
        INTRINSIC_WO_CHAIN => {
            let mut IID: u32 = N.getConstantOperandVal(0);
            if IID < num_intrinsics {
                return IID;
            }
            return not_intrinsic;
        },
    }
}

fn AArch64TargetLowering::isReassocProfitable(self: *AArch64TargetLowering, DAG: *mut SelectionDAG, N0: SDValue, N1: SDValue) -> bool {
    if !N0.hasOneUse() {
        return false;
    }
    let mut IID: u32 = getIntrinsicID(N1.getNode());
    if  {
        return N0.getOpcode() != ADD;
    }
    return true;
}

fn AArch64TargetLowering::CCAssignFnForCall(self: *AArch64TargetLowering, CC: ID, IsVarArg: bool) -> *mut CCAssignFn {
    match CC {
        _ => {
            reportFatalUsageError("unsupported calling convention");
        },
        GHC => {
            return CC_AArch64_GHC;
        },
        PreserveNone => {
            if !IsVarArg {
                return CC_AArch64_Preserve_None;
            }
        },
        C => {
            Fast;
        },
        Win64 => {
            if IsVarArg {
                if self.Subtarget.isWindowsArm64EC() {
                    return CC_AArch64_Arm64EC_VarArg;
                }
                return CC_AArch64_Win64_VarArg;
            }
        },
        CFGuard_Check => {
            if self.Subtarget.isWindowsArm64EC() {
                return CC_AArch64_Arm64EC_CFGuard_Check;
            }
        },
        AArch64_VectorCall => {
            AArch64_SVE_VectorCall;
        },
        ARM64EC_Thunk_X64 => {
            return CC_AArch64_Arm64EC_Thunk;
        },
        ARM64EC_Thunk_Native => {
            return CC_AArch64_Arm64EC_Thunk_Native;
        },
    }
}

fn AArch64TargetLowering::CCAssignFnForReturn(self: *AArch64TargetLowering, CC: ID) -> *mut CCAssignFn {
    match CC {
        _ => {
            return RetCC_AArch64_AAPCS;
        },
        ARM64EC_Thunk_X64 => {
            return RetCC_AArch64_Arm64EC_Thunk;
        },
        CFGuard_Check => {
            if self.Subtarget.isWindowsArm64EC() {
                return RetCC_AArch64_Arm64EC_CFGuard_Check;
            }
        },
    }
}

fn isPassedInFPR(VT: EVT) -> bool {
    return VT.isFixedLengthVector() || (VT.isFloatingPoint() && !VT.isScalableVector());
}

fn AArch64TargetLowering::lowerEHPadEntry(self: *AArch64TargetLowering, Chain: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Chain.getOpcode() == EntryToken, "Unexpected Chain value");
    let mut Glue: SDValue = Chain.getValue(1);
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut auto = operator*(MF);
    let mut SMEFnAttrs: SMEAttrs = ();
    if SMEFnAttrs.hasStreamingInterfaceOrBody() {
        Chain = self.changeStreamingMode(DAG, DL, true, Chain, Glue, Always, false);
    } else if SMEFnAttrs.hasStreamingCompatibleInterface() {
        Chain = self.changeStreamingMode(DAG, DL, true, Chain, Glue, IfCallerIsStreaming, false);
    }
    return Chain;
}

fn AArch64TargetLowering::LowerFormalArguments(self: *AArch64TargetLowering, Chain: SDValue, CallConv: ID, isVarArg: bool, Ins: *InputArg>, DL: *SDLoc, DAG: *mut SelectionDAG, InVals: *mut SmallVectorImpl<SDValue>) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut F: *Function = MF.getFunction();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut IsWin64: bool = self.Subtarget.isCallingConvWin64(F.getCallingConv(), F.isVarArg());
    let mut StackViaX4: bool = CallConv == ARM64EC_Thunk_X64 || (isVarArg && self.Subtarget.isWindowsArm64EC());
    let mut FuncInfo: *mut AArch64FunctionInfo = MF;
    let mut Outs: OutputArg, 4> = zeroed();
    GetReturnInfo(CallConv, F.getReturnType(), F.getAttributes(), DAG.getTargetLoweringInfo(), MF.getDataLayout());
    if any_of(Closure_12 {}) {
        FuncInfo.setIsSVECC(true);
    }
    let mut ArgLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CallConv, isVarArg, MF, ArgLocs, *DAG.getContext(), false };
    let mut NumArgs: u32 = Ins.len;
    let mut CurOrigArg: const_arg_iterator = F.arg_begin();
    let mut CurArgIdx: u32 = 0;
    let mut UseVarArgCC: bool = false;
    if IsWin64 {
        UseVarArgCC = isVarArg;
    }
    let mut AssignFn: *mut CCAssignFn = self.CCAssignFnForCall(CallConv, UseVarArgCC);
    for let mut i: u32 = 0; i != NumArgs; i += 1 {
        let mut ValVT: MVT = Ins[i].VT;
        if Ins[i].isOrigArg() {
            advance(CurOrigArg, Ins[i].getOrigArgIndex() - CurArgIdx);
            CurArgIdx = Ins[i].getOrigArgIndex();
            let mut ActualVT: EVT = self.getValueType(DAG.getDataLayout(), CurOrigArg.getType(), true);
            let mut ActualMVT: MVT = if ActualVT.isSimple() { ActualVT.getSimpleVT() } else { Other };
            if ActualMVT == i1 || ActualMVT == i8 {
                ValVT = i8;
            } else if ActualMVT == i16 {
                ValVT = i16;
            }
        }
        let mut Res: bool = AssignFn(i, ValVT, ValVT, Full, Ins[i].Flags, Ins[i].OrigTy, CCInfo);
        assert!(!Res, "Call operand has unhandled type");
        Res as void;
    }
    let mut Attrs: SMEAttrs = FuncInfo.getSMEFnAttrs();
    let mut IsLocallyStreaming: bool = !Attrs.hasStreamingInterface() && Attrs.hasStreamingBody();
    assert!(Chain.getOpcode() == EntryToken, "Unexpected Chain value");
    let mut Glue: SDValue = Chain.getValue(1);
    let mut ExtraArgLocs: u32 = 0;
    for let mut i: u32 = 0;
let mut e: u32 = Ins.len; i != e; i += 1 {
        let mut VA: *mut CCValAssign = ArgLocs[i - ExtraArgLocs];
        if Ins[i].Flags.isByVal() {
            let mut PtrVT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
            let mut Size: i32 = Ins[i].Flags.getByValSize();
            let mut NumRegs: u32 = (Size + 7) / 8;
            let mut FrameIdx: u32 = MFI.CreateFixedObject(8 * NumRegs, VA.getLocMemOffset(), false, false);
            let mut FrameIdxN: SDValue = DAG.getFrameIndex(FrameIdx, PtrVT, false);
            InVals.push(FrameIdxN);
            continue;
        }
        if Ins[i].Flags.isSwiftAsync() {
            MF(true);
        }
        let mut ArgValue: SDValue = SDValue {};
        if VA.isRegLoc() {
            let mut RegVT: EVT = VA.getLocVT();
            let mut RC: *TargetRegisterClass = null;
            if RegVT == i32 {
                
            } else if RegVT == i64 {
                
            } else if RegVT == f16 || RegVT == bf16 {
                
            } else if RegVT == f32 {
                
            } else if RegVT == f64 || RegVT.is64BitVector() {
                
            } else if RegVT == f128 || RegVT.is128BitVector() {
                
            } else if RegVT.isScalableVector() && RegVT.getVectorElementType() == i1 {
                FuncInfo.setIsSVECC(true);
            } else if RegVT == aarch64svcount {
                FuncInfo.setIsSVECC(true);
            } else if RegVT.isScalableVector() {
                FuncInfo.setIsSVECC(true);
            } else {
                llvm_unreachable_internal("RegVT not supported by FORMAL_ARGUMENTS Lowering", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 9525);
            }
            let mut Reg: Register = MF.addLiveIn(VA.getLocReg().operator MCRegister(), RC);
            if IsLocallyStreaming {
                ArgValue = DAG.getCopyFromReg(Chain, DL, Reg, RegVT, Glue);
                Glue = ArgValue.getValue(2);
                if isPassedInFPR(ArgValue.getValueType()) {
                    ArgValue = DAG;
                    Glue = ArgValue.getValue(1);
                }
            } else {
                ArgValue = DAG.getCopyFromReg(Chain, DL, Reg, RegVT);
            }
            match VA.getLocInfo() {
                _ => {
                    llvm_unreachable_internal("Unknown loc info!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 9558);
                },
                Full => {
                    break;
                },
                Indirect => {
                    assert!((VA.getValVT().isScalableVT() || self.Subtarget.isWindowsArm64EC()), "Indirect arguments should be scalable on most subtargets");
                },
                BCvt => {
                    ArgValue = DAG.getNode(BITCAST, DL, VA.getValVT(), ArgValue);
                },
                AExt => {
                    SExt;
                },
                AExtUpper => {
                    ArgValue = DAG.getNode(SRL, DL, RegVT, ArgValue, DAG.getConstant(32, DL, RegVT, false, false));
                },
            }
        } else {
            assert!(VA.isMemLoc(), "CCValAssign is neither reg nor mem");
            let mut ArgOffset: u32 = VA.getLocMemOffset();
            let mut ArgSize: u32 = (if VA.getLocInfo() == Indirect { VA.getLocVT().getSizeInBits() } else { VA.getValVT().getSizeInBits() }).operator unsigned long long() / 8;
            let mut BEAlign: u32 = 0;
            if !self.Subtarget.isLittleEndian() && ArgSize < 8 && !Ins[i].Flags.isInConsecutiveRegs() {
                BEAlign = 8 - ArgSize;
            }
            let mut FIN: SDValue = SDValue {};
            let mut PtrInfo: MachinePointerInfo = MachinePointerInfo { 0, 0 };
            if StackViaX4 {
                let mut ObjOffset: u32 = ArgOffset + BEAlign;
                if CallConv == ARM64EC_Thunk_X64 {
                    ObjOffset += 32;
                }
                let mut VReg: Register = MF.addLiveIn;
                let mut Val: SDValue = DAG.getCopyFromReg(Chain, DL, VReg, i64);
                FIN = DAG.getNode(ADD, DL, i64, Val, DAG.getConstant(ObjOffset, DL, i64, false, false));
                PtrInfo = getUnknownStack(MF);
            } else {
                let mut FI: i32 = MFI.CreateFixedObject(ArgSize, ArgOffset + BEAlign, true, false);
                FIN = DAG.getFrameIndex(FI, self.getPointerTy(DAG.getDataLayout(), 0), false);
                PtrInfo = getFixedStack(MF, FI, 0);
            }
            let mut ExtType: LoadExtType = NON_EXTLOAD;
            let mut MemVT: MVT = VA.getValVT();
            match VA.getLocInfo() {
                _ => {
                    break;
                },
                Trunc => {
                    BCvt;
                },
                Indirect => {
                    assert!((VA.getValVT().isScalableVT() || self.Subtarget.isWindowsArm64EC()), "Indirect arguments should be scalable on most subtargets");
                },
                SExt => {
                    ExtType = SEXTLOAD;
                },
                ZExt => {
                    ExtType = ZEXTLOAD;
                },
                AExt => {
                    ExtType = EXTLOAD;
                },
            }
            ArgValue = DAG.getExtLoad(ExtType, DL, VA.getLocVT(), Chain, FIN, PtrInfo, MemVT, MaybeAlign {}, MONone, MMOMetadata {});
        }
        if VA.getLocInfo() == Indirect {
            assert!((VA.getValVT().isScalableVT() || self.Subtarget.isWindowsArm64EC()), "Indirect arguments should be scalable on most subtargets");
            let mut PartSize: TypeSize = VA.getValVT().getStoreSize();
            let mut NumParts: u32 = 1;
            if Ins[i].Flags.isInConsecutiveRegs() {
                while !Ins[i + NumParts - 1].Flags.isInConsecutiveRegsLast() {
                    NumParts += 1;
                }
            }
            let mut PartLoad: MVT = VA.getValVT();
            let mut Ptr: SDValue = ArgValue;
            while NumParts > 0 {
                ArgValue = DAG.getLoad(PartLoad, DL, Chain, Ptr, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
                InVals.push(ArgValue);
                NumParts -= 1;
                if NumParts > 0 {
                    let mut BytesIncrement: SDValue = DAG.getTypeSize(DL, Ptr.getValueType(), PartSize);
                    Ptr = DAG.getNode(ADD, DL, Ptr.getValueType(), Ptr, BytesIncrement, NoUnsignedWrap);
                    ExtraArgLocs += 1;
                    i += 1;
                }
            }
        } else {
            if self.Subtarget.isTargetILP32() && Ins[i].Flags.isPointer() {
                ArgValue = DAG.getNode(AssertZext, DL, ArgValue.getValueType(), ArgValue, DAG.getValueType(i32));
            }
            if Ins[i].isOrigArg() {
                let mut OrigArg: *mut Argument = F.getArg(Ins[i].getOrigArgIndex());
                if OrigArg.getType().isIntegerTy(1) {
                    if !Ins[i].Flags.isZExt() {
                        ArgValue = DAG;
                    }
                }
            }
            InVals.push(ArgValue);
        }
    }
    assert!((ArgLocs.len + ExtraArgLocs) == Ins.len);
    if Attrs.hasStreamingCompatibleInterface() {
        let mut EntryPStateSM: SDValue = DAG;
        let mut EntryPStateSMReg: Register = MF.getRegInfo();
        Chain = DAG.getCopyToReg(EntryPStateSM.getValue(1), DL, EntryPStateSMReg, EntryPStateSM);
        FuncInfo.setPStateSMReg(EntryPStateSMReg);
    }
    if IsLocallyStreaming {
        if Attrs.hasStreamingCompatibleInterface() {
            Chain = self.changeStreamingMode(DAG, DL, true, Chain, Glue, IfCallerIsNonStreaming, false);
        } else {
            Chain = self.changeStreamingMode(DAG, DL, true, Chain, Glue, Always, false);
        }
        for let mut I: u32 = 0; I < InVals.len; I += 1 {
            let mut Reg: Register = MF.getRegInfo().createVirtualRegister(self.getRegClassFor(InVals[I].getValueType().getSimpleVT(), false), "");
            Chain = DAG.getCopyToReg(Chain, DL, Reg, InVals[I]);
            InVals[I] = DAG.getCopyFromReg(Chain, DL, Reg, InVals[I].getValueType());
        }
    }
    if isVarArg {
        if DAG.getMachineFunction().getFrameInfo().hasVAStart() {
            if !self.Subtarget.isTargetDarwin() || IsWin64 {
                self.saveVarArgRegisters(CCInfo, DAG, DL, Chain);
            }
            let mut VarArgsOffset: u32 = CCInfo.getStackSize();
            VarArgsOffset = alignTo(VarArgsOffset, if self.Subtarget.isTargetILP32() { 4 } else { 8 });
            FuncInfo.setVarArgsStackOffset(VarArgsOffset);
            FuncInfo.setVarArgsStackIndex(MFI.CreateFixedObject(4, VarArgsOffset, true, false));
        }
        if MFI.hasMustTailInVarArgFunc() {
            let mut RegParmTypes: SmallVector<MVT, 2> = zeroed();
            RegParmTypes()(i64);
            RegParmTypes()(f128);
            let mut Forwards: *mut SmallVectorImpl<ForwardedRegister> = FuncInfo.getForwardedMustTailRegParms();
            CCInfo.analyzeMustTailForwardedRegisters(Forwards, CC_AArch64_AAPCS);
            if operator!(CCInfo.isAllocated) {
                let mut X8VReg: Register = MF.addLiveIn;
                Forwards();
            }
        }
    }
    if IsWin64 || F.getCallingConv() == ARM64EC_Thunk_X64 {
        for let mut I: u32 = 0;
let mut E: u32 = Ins.len; I != E; I += 1 {
            if (F.getCallingConv() == ARM64EC_Thunk_X64 || Ins[I].Flags.isInReg()) && Ins[I].Flags.isSRet() {
                assert!(!FuncInfo.getSRetReturnReg();
                let mut PtrTy: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
                let mut Reg: Register = MF.getRegInfo().createVirtualRegister(self.getRegClassFor(PtrTy, false), "");
                FuncInfo.setSRetReturnReg(Reg.operator unsigned int());
                let mut Copy: SDValue = DAG.getCopyToReg(DAG.getEntryNode(), DL, Reg, InVals[I]);
                Chain = DAG.getNode(TokenFactor, DL, Other, Copy, Chain);
                break;
            }
        }
    }
    let mut StackArgSize: u32 = CCInfo.getStackSize();
    let mut TailCallOpt: bool = MF.getTarget().Options.GuaranteedTailCallOpt;
    if self.DoesCalleeRestoreStack(CallConv, TailCallOpt) {
        StackArgSize = alignTo(StackArgSize, 16);
        FuncInfo.setArgumentStackToRestore(StackArgSize);
    }
    FuncInfo.setBytesInStackArgArea(StackArgSize);
    if self.Subtarget.hasCustomCallingConv() {
        self.Subtarget.getRegisterInfo().UpdateCustomCalleeSavedRegs(MF);
    }
    if self.Subtarget.isTargetWindows() || self.hasInlineStackProbe(MF) {
        let mut Size: SDValue = SDValue {};
        if Attrs.hasZAState() {
            let mut SVL: SDValue = DAG;
            Size = DAG.getNode(MUL, DL, i64, SVL, SVL);
        } else if Attrs.hasAgnosticZAInterface() {
            let mut LC: Libcall = SMEABI_SME_STATE_SIZE;
            let mut LCImpl: LibcallImpl = DAG.getLibcalls().getLibcallImpl(LC);
            let mut Callee: SDValue = DAG.getExternalSymbol(LCImpl, self.getPointerTy(DAG.getDataLayout(), 0));
            let mut RetTy: *mut Type = i64.getTypeForEVT(*DAG.getContext());
            let mut CLI: CallLoweringInfo = DAG;
            CLI.setDebugLoc(DL).setChain(Chain).setLibCallee(DAG.getLibcalls().getLibcallImplCallingConv(LCImpl), RetTy, Callee, ArgListTy {});
            tie(Size, Chain) = self.LowerCallTo(CLI);
        }
        if Size {
            let mut Buffer: SDValue = DAG.getNode(DYNAMIC_STACKALLOC, DL, DAG.getVTList(i64, Other), [Chain, Size, DAG.getConstant(1, DL, i64, false, false)]);
            Chain = Buffer.getValue(1);
            let mut BufferPtr: Register = MF.getRegInfo();
            Chain = DAG.getCopyToReg(Chain, DL, BufferPtr, Buffer);
            Chain = DAG;
            FuncInfo.setEarlyAllocSMESaveBuffer(BufferPtr);
            MFI.CreateVariableSizedObject(16, null);
        }
    }
    if CallConv == PreserveNone {
        for I in Ins {
            if I.Flags.isSwiftSelf() || I.Flags.isSwiftError() || I.Flags.isSwiftAsync() {
                let mut MF: *mut MachineFunction = DAG.getMachineFunction();
                DAG.getContext().diagnose(DiagnosticInfoUnsupported { MF.getFunction(), "Swift attributes can't be used with preserve_none", DL.getDebugLoc(), DS_Error });
                break;
            }
        }
    }
    return Chain;
}

fn AArch64TargetLowering::saveVarArgRegisters(self: *AArch64TargetLowering, CCInfo: *mut CCState, DAG: *mut SelectionDAG, DL: *SDLoc, Chain: *mut SDValue) {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut FuncInfo: *mut AArch64FunctionInfo = MF;
    let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut F: *mut Function = MF.getFunction();
    let mut IsWin64: bool = self.Subtarget.isCallingConvWin64(F.getCallingConv(), F.isVarArg());
    let mut MemOps: SmallVector<SDValue, 8> = zeroed();
    let mut GPRArgRegs: ArrayRef<MCPhysReg> = getGPRArgRegs();
    let mut NumGPRArgRegs: u32 = GPRArgRegs.len;
    if self.Subtarget.isWindowsArm64EC() {
        NumGPRArgRegs = 4;
    }
    let mut FirstVariadicGPR: u32 = CCInfo.getFirstUnallocated(GPRArgRegs);
    let mut GPRSaveSize: u32 = 8 * (NumGPRArgRegs - FirstVariadicGPR);
    let mut GPRIdx: i32 = 0;
    if GPRSaveSize != 0 {
        if IsWin64 {
            GPRIdx = MFI.CreateFixedObject(GPRSaveSize, -GPRSaveSize as i32, false, false);
            if GPRSaveSize & 15 {
                MFI.CreateFixedObject(16 - (GPRSaveSize & 15), -alignTo(GPRSaveSize, 16) as i32, false, false);
            }
        } else {
            GPRIdx = MFI.CreateStackObject(GPRSaveSize, 8, false, null, 0);
        }
        let mut FIN: SDValue = SDValue {};
        if self.Subtarget.isWindowsArm64EC() {
            let mut VReg: Register = MF.addLiveIn;
            let mut Val: SDValue = DAG.getCopyFromReg(Chain, DL, VReg, i64);
            FIN = DAG.getNode(SUB, DL, i64, Val, DAG.getConstant(GPRSaveSize, DL, i64, false, false));
        } else {
            FIN = DAG.getFrameIndex(GPRIdx, PtrVT, false);
        }
        for let mut i: u32 = FirstVariadicGPR; i < NumGPRArgRegs; i += 1 {
            let mut VReg: Register = MF.addLiveIn;
            let mut Val: SDValue = DAG.getCopyFromReg(Chain, DL, VReg, i64);
            let mut Store: SDValue = DAG.getStore(Val.getValue(1), DL, Val, FIN, if IsWin64 { getFixedStack(MF, GPRIdx, (i - FirstVariadicGPR) * 8) } else { getStack(MF, i * 8, 0) }, MaybeAlign {}, MONone, MMOMetadata {});
            MemOps()(Store);
            FIN = DAG.getNode(ADD, DL, PtrVT, FIN, DAG.getConstant(8, DL, PtrVT, false, false));
        }
    }
    FuncInfo.setVarArgsGPRIndex(GPRIdx);
    FuncInfo.setVarArgsGPRSize(GPRSaveSize);
    if self.Subtarget() && !IsWin64 {
        let mut FPRArgRegs: ArrayRef<MCPhysReg> = getFPRArgRegs();
        let mut NumFPRArgRegs: u32 = FPRArgRegs.len;
        let mut FirstVariadicFPR: u32 = CCInfo.getFirstUnallocated(FPRArgRegs);
        let mut FPRSaveSize: u32 = 16 * (NumFPRArgRegs - FirstVariadicFPR);
        let mut FPRIdx: i32 = 0;
        if FPRSaveSize != 0 {
            FPRIdx = MFI.CreateStackObject(FPRSaveSize, 16, false, null, 0);
            let mut FIN: SDValue = DAG.getFrameIndex(FPRIdx, PtrVT, false);
            for let mut i: u32 = FirstVariadicFPR; i < NumFPRArgRegs; i += 1 {
                let mut VReg: Register = MF.addLiveIn;
                let mut Val: SDValue = DAG.getCopyFromReg(Chain, DL, VReg, f128);
                let mut Store: SDValue = DAG.getStore(Val.getValue(1), DL, Val, FIN, getStack(MF, i * 16, 0), MaybeAlign {}, MONone, MMOMetadata {});
                MemOps()(Store);
                FIN = DAG.getNode(ADD, DL, PtrVT, FIN, DAG.getConstant(16, DL, PtrVT, false, false));
            }
        }
        FuncInfo.setVarArgsFPRIndex(FPRIdx);
        FuncInfo.setVarArgsFPRSize(FPRSaveSize);
    }
    if operator!() {
        Chain = DAG(TokenFactor, DL, Other);
    }
}

fn AArch64TargetLowering::LowerCallResult(self: *AArch64TargetLowering, Chain: SDValue, InGlue: SDValue, CallConv: ID, isVarArg: bool, RVLocs: *SmallVectorImpl<CCValAssign>, DL: *SDLoc, DAG: *mut SelectionDAG, InVals: *mut SmallVectorImpl<SDValue>, isThisReturn: bool, ThisVal: SDValue, RequiresSMChange: bool) -> SDValue {
    let mut CopiedRegs: i32 = 0;
    for let mut i: u32 = 0; i != RVLocs.len; i += 1 {
        let mut VA: CCValAssign = RVLocs[i];
        if i == 0 && isThisReturn {
            assert!(!VA.needsCustom() && VA.getLocVT() == i64, "unexpected return calling convention register assignment");
            InVals.push(ThisVal);
            continue;
        }
        let mut Val: SDValue = (VA.getLocReg());
        if !Val {
            Val = DAG.getCopyFromReg(Chain, DL, VA.getLocReg(), VA.getLocVT(), InGlue);
            Chain = Val.getValue(1);
            InGlue = Val.getValue(2);
            CopiedRegs()[VA.getLocReg()] = Val;
        }
        match VA.getLocInfo() {
            _ => {
                llvm_unreachable_internal("Unknown loc info!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 9999);
            },
            Full => {
                break;
            },
            BCvt => {
                Val = DAG.getNode(BITCAST, DL, VA.getValVT(), Val);
            },
            AExtUpper => {
                Val = DAG.getNode(SRL, DL, VA.getLocVT(), Val, DAG.getConstant(32, DL, VA.getLocVT(), false, false));
            },
            AExt => {
                
            },
            ZExt => {
                Val = DAG.getZExtOrTrunc(Val, DL, VA.getValVT());
            },
        }
        if RequiresSMChange && isPassedInFPR(VA.getValVT()) {
            Val = DAG;
        }
        InVals.push(Val);
    }
    return Chain;
}

fn canGuaranteeTCO(CC: ID, GuaranteeTailCalls: bool) -> bool {
    return (CC == Fast && GuaranteeTailCalls) || CC == Tail || CC == SwiftTail;
}

fn mayTailCallThisCC(CC: ID) -> bool {
    match CC {
        C => {
            AArch64_SVE_VectorCall;
        },
        _ => {
            return false;
        },
    }
}

fn callConvSupportsVarArgs(CC: ID) -> bool {
    match CC {
        C => {
            PreserveNone;
        },
        _ => {
            return false;
        },
    }
}

fn analyzeCallOperands(TLI: *AArch64TargetLowering, Subtarget: *AArch64Subtarget, CLI: *CallLoweringInfo, CCInfo: *mut CCState) {
    let mut DAG: *SelectionDAG = CLI.DAG;
    let mut CalleeCC: ID = CLI.CallConv;
    let mut IsVarArg: bool = CLI.IsVarArg;
    let mut Outs: *OutputArg, 32> = CLI.Outs;
    let mut IsCalleeWin64: bool = Subtarget.isCallingConvWin64(CalleeCC, IsVarArg);
    if CalleeCC == ARM64EC_Thunk_X64 {
        CCInfo.AllocateStack(32, 16);
    }
    let mut NumArgs: u32 = Outs.len;
    let mut IsArm64ECVarArgExitThunk: bool = CalleeCC == ARM64EC_Thunk_X64 && IsVarArg && !(CLI.CB && CLI.CB.isMustTailCall());
    if IsArm64ECVarArgExitThunk {
        if NumArgs < 2 {
            report_fatal_error("variadic arm64ec_thunk_x64 call is missing the x4/x5 (pointer/length) arguments", true);
        }
        NumArgs -= 2;
    }
    for let mut i: u32 = 0; i != NumArgs; i += 1 {
        let mut ArgVT: MVT = Outs[i].VT;
        let mut ArgFlags: ArgFlagsTy = Outs[i].Flags;
        let mut UseVarArgCC: bool = false;
        if IsVarArg {
            if IsCalleeWin64 {
                UseVarArgCC = true;
            } else {
                UseVarArgCC = ArgFlags.isVarArg();
            }
        }
        if !UseVarArgCC {
            let mut ActualVT: EVT = TLI.getValueType(DAG.getDataLayout(), CLI.Args[Outs[i].OrigArgIndex].Ty, true);
            let mut ActualMVT: MVT = if ActualVT.isSimple() { ActualVT.getSimpleVT() } else { ArgVT };
            if ActualMVT == i1 || ActualMVT == i8 {
                ArgVT = i8;
            } else if ActualMVT == i16 {
                ArgVT = i16;
            }
        }
        let mut AssignFn: *mut CCAssignFn = TLI.CCAssignFnForCall(CalleeCC, UseVarArgCC);
        let mut Res: bool = AssignFn(i, ArgVT, ArgVT, Full, ArgFlags, Outs[i].OrigTy, CCInfo);
        assert!(!Res, "Call operand has unhandled type");
        Res as void;
    }
}

fn getSMECallAttrs(Caller: *Function, RTLCI: *RuntimeLibcallsInfo, CLI: *CallLoweringInfo) -> SMECallAttrs {
    if CLI.CB {
        return SMECallAttrs { *CLI.CB, &mut RTLCI };
    }
    if  {
        return SMECallAttrs { SMEAttrs { Caller, null }, Normal };
    }
    return SMECallAttrs { SMEAttrs { Caller, null }, Normal, Normal };
}

fn AArch64TargetLowering::isEligibleForTailCallOptimization(self: *AArch64TargetLowering, CLI: *CallLoweringInfo) -> bool {
    let mut CalleeCC: ID = CLI.CallConv;
    if !mayTailCallThisCC(CalleeCC) {
        return false;
    }
    let mut Callee: SDValue = CLI.Callee;
    let mut IsVarArg: bool = CLI.IsVarArg;
    let mut Outs: *OutputArg, 32> = CLI.Outs;
    let mut OutVals: *SmallVector<SDValue, 32> = CLI.OutVals;
    let mut Ins: *InputArg, 32> = CLI.Ins;
    let mut DAG: *SelectionDAG = CLI.DAG;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut CallerF: *Function = MF.getFunction();
    let mut CallerCC: ID = CallerF.getCallingConv();
    let mut CallAttrs: SMECallAttrs = getSMECallAttrs(CallerF, self.getRuntimeLibcallsInfo(), CLI);
    if CallAttrs.requiresSMChange() || CallAttrs.requiresZASave() || CallAttrs.requiresPreservingZT0() || CallAttrs.caller().hasStreamingBody() || CallAttrs.caller().isNewZA() || CallAttrs.caller().isNewZT0() {
        return false;
    }
    if (CallerCC == C || CallerCC == Fast) && MF() {
        CallerCC = AArch64_SVE_VectorCall;
    }
    let mut CCMatch: bool = CallerCC == CalleeCC;
    if CallerCC == Win64 && !self.Subtarget.isTargetWindows() && CalleeCC != Win64 {
        return false;
    }
    for let mut i: const_arg_iterator = CallerF.arg_begin();
let mut e: const_arg_iterator = CallerF.arg_end(); i != e; i += 1 {
        if i.hasByValAttr() {
            return false;
        }
        if i.hasInRegAttr() {
            let mut ArgIdx: u32 = i - CallerF.arg_begin();
            if !CLI.CB || CLI.CB.arg_size() <= ArgIdx {
                return false;
            }
            let mut Attrs: AttributeSet = CLI.CB.getParamAttributes(ArgIdx);
            if !Attrs.hasAttribute(InReg) || !Attrs.hasAttribute(StructRet) || !i.hasStructRetAttr() || CLI.CB.getArgOperand(ArgIdx) != i {
                return false;
            }
        }
    }
    if canGuaranteeTCO(CalleeCC, self.getTargetMachine().Options.GuaranteedTailCallOpt) {
        return CCMatch;
    }
    if dyn_cast(Callee) {
        G;
    } else {
        let mut GV: *GlobalValue = G.getGlobal();
        let mut TT: *Triple = self.getTargetMachine().getTargetTriple();
        if GV.hasExternalWeakLinkage() && (!TT.isOSWindows() || TT.isOSBinFormatELF() || TT.isOSBinFormatMachO()) {
            return false;
        }
    }
    if IsVarArg && !callConvSupportsVarArgs(CalleeCC) {
        report_fatal_error("Unsupported variadic calling convention", true);
    }
    let mut C: *mut LLVMContext = *DAG.getContext();
    if !resultsCompatible(CalleeCC, CallerCC, MF, C, Ins, self.CCAssignFnForCall(CalleeCC, IsVarArg), self.CCAssignFnForCall(CallerCC, IsVarArg)) {
        return false;
    }
    let mut TRI: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut CallerPreserved: *u32 = TRI.getCallPreservedMask(MF, CallerCC);
    if !CCMatch {
        let mut CalleePreserved: *u32 = TRI.getCallPreservedMask(MF, CalleeCC);
        if self.Subtarget.hasCustomCallingConv() {
            TRI.UpdateCustomCallPreservedMask(MF, &mut CallerPreserved);
            TRI.UpdateCustomCallPreservedMask(MF, &mut CalleePreserved);
        }
        if operator!(TRI()(CallerPreserved, CalleePreserved)) {
            return false;
        }
    }
    if Outs.is_empty() {
        return true;
    }
    let mut ArgLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CalleeCC, IsVarArg, MF, ArgLocs, C, false };
    analyzeCallOperands(*self, self.Subtarget, CLI, CCInfo);
    if IsVarArg && !(CLI.CB && CLI.CB.isMustTailCall()) {
        for ArgLoc in ArgLocs {
            if !ArgLoc.isRegLoc() {
                return false;
            }
        }
    }
    let mut FuncInfo: *AArch64FunctionInfo = MF;
    if any_of(ArgLocs, Closure_13 { cap_0: self }) {
        return false;
    }
    if CCInfo.getStackSize() > FuncInfo.getBytesInStackArgArea() {
        return false;
    }
    let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
    if !self.parametersInCSRMatch(MRI, CallerPreserved, ArgLocs, OutVals) {
        return false;
    }
    return true;
}

fn AArch64TargetLowering::addTokenForArgument(self: *AArch64TargetLowering, Chain: SDValue, DAG: *mut SelectionDAG, MFI: *mut MachineFrameInfo, ClobberedFI: i32) -> SDValue {
    let mut ArgChains: SmallVector<SDValue, 8> = zeroed();
    let mut FirstByte: i64 = MFI.getObjectOffset(ClobberedFI);
    let mut LastByte: i64 = FirstByte + MFI.getObjectSize(ClobberedFI) - 1;
    ArgChains()(Chain);
    for U in operator(DAG.getEntryNode()).users() {
        if dyn_cast(U) {
            L;
        } else if dyn_cast(L.getBasePtr()) {
            FI;
        } else if FI.getIndex() < 0 {
            let mut InFirstByte: i64 = MFI.getObjectOffset(FI.getIndex());
            let mut InLastByte: i64 = InFirstByte;
            InLastByte += MFI.getObjectSize(FI.getIndex()) - 1;
            if (InFirstByte <= FirstByte && FirstByte <= InLastByte) || (FirstByte <= InFirstByte && InFirstByte <= LastByte) {
                ArgChains()(SDValue { Node: L, ResNo: 1 });
            }
        }
    }
    return DAG(TokenFactor, Chain, Other);
}

fn AArch64TargetLowering::DoesCalleeRestoreStack(self: *AArch64TargetLowering, CallCC: ID, TailCallOpt: bool) -> bool {
    return (CallCC == Fast && TailCallOpt) || CallCC == Tail || CallCC == SwiftTail;
}

fn checkZExtBool(Arg: SDValue, DAG: *SelectionDAG) -> bool {
    let mut SizeInBits: u32 = Arg.getValueType().getSizeInBits().operator unsigned long long();
    if SizeInBits < 8 {
        return false;
    }
    let mut RequiredZero: APInt = APInt { SizeInBits, 254, false, false };
    let mut Bits: KnownBits = DAG.computeKnownBits(Arg, 4);
    let mut ZExtBool: bool = (Bits.Zero & RequiredZero) == RequiredZero;
    return ZExtBool;
}

fn AArch64TargetLowering::AdjustInstrPostInstrSelection(self: *AArch64TargetLowering, MI: *mut MachineInstr, Node: *mut SDNode) {
    if  {
        for let mut I: u32 = MI.getNumOperands() - 1; I > 0; I -= 1 {
            let mut MO: *mut MachineOperand = MI.getOperand(I);
            if  {
                MI.removeOperand(I);
            }
        }
        if  {
            MI(CreateReg(false, true));
            MI(CreateReg(true, true));
            MI(CreateReg(true, true));
        }
    }
    let mut MF: *MachineFunction = *MI.getMF();
    if  {
        let mut MO: *MachineOperand = MI.getOperand(1);
        if MO.isFI() && MF.getFrameInfo().hasScalableStackID(MO.getIndex()) {
            MI(CreateReg(false, true));
        }
    }
}

fn AArch64TargetLowering::changeStreamingMode(self: *AArch64TargetLowering, DAG: *mut SelectionDAG, DL: SDLoc, Enable: bool, Chain: SDValue, InGlue: SDValue, Condition: u32, InsertVectorLengthCheck: bool) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut AArch64FunctionInfo = MF;
    FuncInfo.setHasStreamingModeChanges(true);
    let mut GetCheckVL: Closure_14 = Closure_14 { DAG: &mut DAG, DL: &mut DL };
    if InsertVectorLengthCheck && Enable {
        let mut CheckVL: SDValue = GetCheckVL.call(Chain, InGlue);
        Chain = CheckVL.getValue(0);
        InGlue = CheckVL.getValue(1);
    }
    let mut TRI: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut RegMask: SDValue = DAG.getRegisterMask(TRI.getSMStartStopCallPreservedMask());
    let mut MSROp: SDValue = DAG;
    let mut Ops: i32 = void { Chain, MSROp };
    let mut Opcode: u32 = 0;
    if Condition != Always {
        let mut PStateReg: Register = FuncInfo.getPStateSMReg();
        assert!(PStateReg.isValid(), "PStateSM Register is invalid");
        let mut PStateSM: SDValue = DAG.getCopyFromReg(Chain, DL, PStateReg, i64, InGlue);
        Ops()[0] = PStateSM.getValue(1);
        InGlue = PStateSM.getValue(2);
        let mut ConditionOp: SDValue = DAG.getTargetConstant(Condition, DL, i64, false);
        Ops()(ConditionOp);
        Ops()(PStateSM);
    } else {}
    Ops()(RegMask);
    if InGlue {
        Ops()(InGlue);
    }
    let mut SMChange: SDValue = DAG(Opcode, DL, DAG.getVTList(Other, Glue));
    if !InsertVectorLengthCheck || Enable {
        return SMChange;
    }
    return GetCheckVL.call(SMChange.getValue(0), SMChange.getValue(1));
}

fn getSMToggleCondition(CallAttrs: *SMECallAttrs) -> ToggleCondition {
    if !CallAttrs.caller().hasStreamingCompatibleInterface() || CallAttrs.caller().hasStreamingBody() {
        return Always;
    }
    if CallAttrs.callee().hasNonStreamingInterface() {
        return IfCallerIsStreaming;
    }
    if CallAttrs.callee().hasStreamingInterface() {
        return IfCallerIsNonStreaming;
    }
    llvm_unreachable_internal("Unsupported attributes", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 10478);
}

fn shouldLowerTailCallStackArg(MF: *MachineFunction, VA: *CCValAssign, Arg: SDValue, Flags: ArgFlagsTy, CallOffset: i32) -> bool {
    if Flags.isZExt() || Flags.isSExt() {
        return true;
    }
    for {
        let mut Op: u32 = Arg.getOpcode();
        if  {
            Arg = Arg.getOperand(0);
            continue;
        }
        break;
    }
    if  {
        if  {
            let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
            let mut FI: i32 = ();
            if !MFI.isImmutableObjectIndex(FI) {
                return true;
            }
            if CallOffset != MFI.getObjectOffset(FI) {
                return true;
            }
            let mut SizeInBits: u64 = ()();
            if SizeInBits != VA.getValVT().getSizeInBits().operator unsigned long long() {
                return true;
            }
            return false;
        }
    }
    return true;
}

fn getZAMarkerForCall(CallAttrs: *SMECallAttrs) -> optional<unsigned int> {
    return nullopt;
}

fn AArch64TargetLowering::LowerCall(self: *AArch64TargetLowering, CLI: *mut CallLoweringInfo, InVals: *mut SmallVectorImpl<SDValue>) -> SDValue {
    let mut DAG: *mut SelectionDAG = CLI.DAG;
    let mut DL: *mut SDLoc = CLI.DL;
    let mut Outs: *mut OutputArg, 32> = CLI.Outs;
    let mut OutVals: *mut SmallVector<SDValue, 32> = CLI.OutVals;
    let mut Ins: *mut InputArg, 32> = CLI.Ins;
    let mut Chain: SDValue = CLI.Chain;
    let mut Callee: SDValue = CLI.Callee;
    let mut IsTailCall: *mut bool = CLI.IsTailCall;
    let mut CallConv: *mut ID = CLI.CallConv;
    let mut IsVarArg: bool = CLI.IsVarArg;
    let mut CB: *CallBase = CLI.CB;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut CSInfo: CallSiteInfo = CallSiteInfo {};
    let mut IsThisReturn: bool = false;
    let mut FuncInfo: *mut AArch64FunctionInfo = MF;
    let mut TailCallOpt: bool = MF.getTarget().Options.GuaranteedTailCallOpt;
    let mut IsCFICall: bool = CLI.CB && CLI.CB.isIndirectCall() && CLI.CFIType;
    let mut IsSibCall: bool = false;
    let mut GuardWithBTI: bool = false;
    if CLI.CB && CLI.CB.hasFnAttr(ReturnsTwice) && operator!(self.Subtarget()) {
        GuardWithBTI = FuncInfo.branchTargetEnforcement();
    }
    let mut ArgLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CallConv, IsVarArg, MF, ArgLocs, *DAG.getContext(), false };
    if IsVarArg {
        let mut NumArgs: u32 = Outs.len;
        for let mut i: u32 = 0; i != NumArgs; i += 1 {
            if Outs[i].Flags.isVarArg() && Outs[i].VT.isScalableVector() {
                report_fatal_error("Passing SVE types to variadic functions is currently not supported", true);
            }
        }
    }
    analyzeCallOperands(*self, self.Subtarget, CLI, CCInfo);
    let mut RetCC: *mut CCAssignFn = self.CCAssignFnForReturn(CallConv);
    let mut RVLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut RetCCInfo: CCState = CCState { CallConv, IsVarArg, DAG.getMachineFunction(), RVLocs, *DAG.getContext(), false };
    RetCCInfo.AnalyzeCallResult(Ins, RetCC);
    self.setTypeIdForCallsiteInfo(CB, MF, CSInfo);
    if CallConv == C || CallConv == Fast {
        let mut HasSVERegLoc: Closure_15 = Closure_15 {};
        if any_of(RVLocs, HasSVERegLoc) || any_of(ArgLocs, HasSVERegLoc) {
            CallConv = AArch64_SVE_VectorCall;
        }
    }
    let mut CallAttrs: SMECallAttrs = getSMECallAttrs(MF.getFunction(), self.getRuntimeLibcallsInfo(), CLI);
    if CallAttrs.requiresNonLazySaveZA() {
        reportFatalUsageError("Calls that require saving ZA non-lazily is not yet implemented");
    }
    let mut ZAMarkerNode: optional<unsigned int> = getZAMarkerForCall(CallAttrs);
    if IsTailCall {
        IsTailCall = self.isEligibleForTailCallOptimization(CLI);
        if IsTailCall && ZAMarkerNode {
            ZAMarkerNode = nullopt;
        }
