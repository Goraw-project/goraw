fn AArch64TargetLowering::LowerFCANONICALIZE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isVector(), "Expected vector type!");
    let mut In: SDValue = Op.getOperand(0);
    let mut Pg: SDValue = getPredicateForVector(DAG, DL, VT);
    if VT.isScalableVector() {
        return DAG;
    }
    assert!(self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()), "Expected to lower to SVE!");
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    In = convertToScalableVector(DAG, ContainerVT, In);
    In = DAG;
    return convertFromScalableVector(DAG, VT, In);
}

