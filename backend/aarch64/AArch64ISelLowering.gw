                let mut DL: *DataLayout = Ext.getDataLayout();
                advance(U.getOperandNo() - 1);
                let mut IdxTy: *mut Type = ();
                if IdxTy.isScalableTy() {
                    return false;
                }
                let mut ShiftAmt: u64 = countr_zero(DL.getTypeStoreSizeInBits(IdxTy).getFixedValue()) - 3;
                if ShiftAmt == 0 || ShiftAmt > 4 {
                    return false;
                }
                break;
            },
            Trunc => {
                if Instr.getType() == Ext.getOperand(0).getType() {
                    continue;
                }
            },
            _ => {
                return false;
            },
        }
    }
    return true;
}

fn createTblShuffleMask(SrcWidth: u32, DstWidth: u32, NumElts: u32, IsLittleEndian: bool, Mask: *mut SmallVectorImpl<int>) -> bool {
    if DstWidth % 8 != 0 || DstWidth <= 16 || DstWidth > 64 {
        return false;
    }
    assert!(DstWidth % SrcWidth == 0, "TBL lowering is not supported for a conversion instruction with this source and destination element type.");
    let mut Factor: u32 = DstWidth / SrcWidth;
    let mut MaskLen: u32 = NumElts * Factor;
    Mask.clear();
    Mask.resize(MaskLen, NumElts);
    let mut SrcIndex: u32 = 0;
    for let mut I: u32 = if IsLittleEndian { 0 } else { Factor - 1 }; I < MaskLen; I += Factor {
        Mask[I] = SrcIndex += 1;
    }
    return true;
}

