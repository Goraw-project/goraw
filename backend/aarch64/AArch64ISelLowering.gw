    return true;
}

fn AArch64TargetLowering::lowerDeinterleaveIntrinsicToLoad(self: *AArch64TargetLowering, Load: *mut Instruction, Mask: *mut Value, DI: *mut IntrinsicInst, GapMask: *APInt) -> bool {
    let mut Factor: u32 = getDeinterleaveIntrinsicFactor(DI.getIntrinsicID());
    assert!(GapMask.getBitWidth() == Factor);
    if Factor != 2 && Factor != 3 && Factor != 4 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                dbgs() << "Matching ld2, ld3 and ld4 patterns failed\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut LI: *mut auto = dyn_cast(Load);
    if operator!() {
        return false;
    }
    assert!(!Mask, "Unexpected mask on a load\n");
    if !GapMask.isAllOnes() {
        return false;
    }
    let mut VTy: *mut VectorType = getDeinterleavedVectorType(DI);
    let mut DL: *DataLayout = ()();
    let mut UseScalable: bool = false;
    if !self.isLegalInterleavedAccessType(VTy, DL, UseScalable) {
        return false;
    }
    if UseScalable && !VTy.isScalableTy() {
        return false;
    }
    let mut NumLoads: u32 = self.getNumInterleavedAccesses(VTy, DL, UseScalable);
    let mut LdTy: *mut VectorType = get(VTy.getElementType(), VTy.getElementCount().divideCoefficientBy(NumLoads));
    let mut PtrTy: *mut Type = ();
    let mut LdNFunc: *mut Function = getStructuredLoadFunction(Factor, UseScalable, LdTy, PtrTy);
    let mut Builder: i32 = LI();
    let mut Pred: *mut Value = null;
    if UseScalable {
        Pred = (LdTy.getElementCount());
    }
    let mut BaseAddr: *mut Value = ();
    let mut Result: *mut Value = null;
    if NumLoads > 1 {
        let mut ExtractedLdValues: SmallVector<Value *, 4> = zeroed();
        for let mut I: u32 = 0; I < NumLoads; I += 1 {
            let mut Offset: *mut Value = (I * Factor);
            let mut Address: *mut Value = (LdTy, BaseAddr, void { Offset });
            let mut LdN: *mut Value = null;
            if UseScalable {
                LdN = (LdNFunc, void { Pred, Address }, "ldN");
            } else {
                LdN = (LdNFunc, Address, "ldN");
            }
            let mut Idx: *mut Value = (I * LdTy.getElementCount().getKnownMinValue());
            for let mut J: u32 = 0; J < Factor; J += 1 {
                ExtractedLdValues()[J] = (VTy, [J], (LdN, J), Idx);
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                    dbgs() << "LdN4 res: ";
                    LdN.dump();
                }
            }
                if !(false) { break; }
            }
        }
        Result = get(DI.getType());
        for let mut J: u32 = 0; J < Factor; J += 1 {
            Result = (Result, [J], J);
        }
    } else {
        if UseScalable {
            Result = (LdNFunc, void { Pred, BaseAddr }, "ldN");
        } else {
            Result = (LdNFunc, BaseAddr, "ldN");
        }
    }
    DI.replaceAllUsesWith(Result);
    return true;
}

fn AArch64TargetLowering::lowerInterleaveIntrinsicToStore(self: *AArch64TargetLowering, Store: *mut Instruction, Mask: *mut Value, InterleavedValues: ArrayRef<Value *>) -> bool {
    let mut Factor: u32 = InterleavedValues.len;
    if Factor != 2 && Factor != 3 && Factor != 4 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
                dbgs() << "Matching st2, st3 and st4 patterns failed\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut SI: *mut StoreInst = dyn_cast(Store);
    if !SI {
        return false;
    }
    assert!(!Mask, "Unexpected mask on plain store");
    let mut VTy: *mut VectorType = cast(InterleavedValues[0].getType());
    let mut DL: *DataLayout = SI.getModule().getDataLayout();
    let mut UseScalable: bool = false;
    if !self.isLegalInterleavedAccessType(VTy, DL, UseScalable) {
        return false;
    }
    if UseScalable && !VTy.isScalableTy() {
        return false;
    }
    let mut NumStores: u32 = self.getNumInterleavedAccesses(VTy, DL, UseScalable);
    let mut StTy: *mut VectorType = get(VTy.getElementType(), VTy.getElementCount().divideCoefficientBy(NumStores));
    let mut PtrTy: *mut Type = SI.getPointerOperandType();
    let mut StNFunc: *mut Function = getStructuredStoreFunction(SI.getModule(), Factor, UseScalable, StTy, PtrTy);
    let mut Builder: i32 = SI;
    let mut BaseAddr: *mut Value = SI.getPointerOperand();
    let mut Pred: *mut Value = null;
    if UseScalable {
        Pred = (StTy.getElementCount());
    }
    let mut ExtractedValues: ArrayRef<Value *> = InterleavedValues;
    let mut StoreOperands: SmallVector<Value *, 4> = zeroed();
    if UseScalable {
        StoreOperands()(Pred);
    }
    StoreOperands()(BaseAddr);
    for let mut I: u32 = 0; I < NumStores; I += 1 {
        let mut Address: *mut Value = BaseAddr;
        if NumStores > 1 {
            let mut Offset: *mut Value = (I * Factor);
            Address = (StTy, BaseAddr, void { Offset });
            let mut Idx: *mut Value = (I * StTy.getElementCount().getKnownMinValue());
            for let mut J: u32 = 0; J < Factor; J += 1 {
                StoreOperands()[J] = (StTy, ExtractedValues[J], Idx);
            }
            StoreOperands()[() - 1] = Address;
        }
        Builder()(StNFunc);
    }
    return true;
}

fn AArch64TargetLowering::getOptimalMemOpType(self: *AArch64TargetLowering, Context: *mut LLVMContext, Op: *MemOp, FuncAttributes: *AttributeList) -> EVT {
    let mut CanImplicitFloat: bool = !FuncAttributes.hasFnAttr(NoImplicitFloat);
    let mut CanUseNEON: bool = self.Subtarget() && CanImplicitFloat;
    let mut CanUseFP: bool = self.Subtarget() && CanImplicitFloat;
    let mut IsSmallZeroMemset: bool = Op.isMemset() && Op.len < 32 && Op.isZeroMemset();
    let mut AlignmentIsAcceptable: Closure_40 = Closure_40 { Op: &mut Op, cap_1: self };
    if CanUseNEON && Op.isMemset() && !IsSmallZeroMemset && AlignmentIsAcceptable.call(v16i8, 1) {
        return v16i8;
    }
    if CanUseFP && !IsSmallZeroMemset && AlignmentIsAcceptable.call(f128, 16) {
        return f128;
    }
    if Op.len >= 8 && AlignmentIsAcceptable.call(i64, 8) {
        return i64;
    }
    if Op.len >= 4 && AlignmentIsAcceptable.call(i32, 4) {
        return i32;
    }
    return Other;
}

fn AArch64TargetLowering::findOptimalMemOpLowering(self: *AArch64TargetLowering, Context: *mut LLVMContext, MemOps: *mut i32, Limit: u32, Op: *MemOp, DstAS: u32, SrcAS: u32, FuncAttributes: *AttributeList, LargestVT: *mut EVT) -> bool {
    let mut VT: EVT = self.getOptimalMemOpType(Context, Op, FuncAttributes);
    if VT == v16i8 && Op.isMemset() && !Op.isZeroMemset() && Op.len < 16 {
        let mut Size: u32 = Op.len;
        let mut RemainingSize: u32 = Size;
        while RemainingSize > 0 {
            let mut TargetVT: EVT = EVT {};
            if RemainingSize >= 8 {
                TargetVT = i64;
                RemainingSize -= 8;
            } else if RemainingSize >= 4 {
                TargetVT = i32;
                RemainingSize -= 4;
            } else if RemainingSize >= 2 {
                TargetVT = i16;
                RemainingSize -= 2;
            } else if RemainingSize >= 1 {
                TargetVT = i8;
                RemainingSize -= 1;
            } else {
                break;
            }
            MemOps()(TargetVT);
        }
        if RemainingSize == 0 && operator!() {
            if LargestVT {
                *LargestVT = VT;
            }
            return true;
        }
        MemOps()();
    }
    return self.findOptimalMemOpLowering(Context, Limit, Op, DstAS, SrcAS, FuncAttributes, LargestVT);
}

fn AArch64TargetLowering::getOptimalMemOpLLT(self: *AArch64TargetLowering, Op: *MemOp, FuncAttributes: *AttributeList) -> LLT {
    let mut CanImplicitFloat: bool = !FuncAttributes.hasFnAttr(NoImplicitFloat);
    let mut CanUseNEON: bool = self.Subtarget() && CanImplicitFloat;
    let mut CanUseFP: bool = self.Subtarget() && CanImplicitFloat;
    let mut IsSmallZeroMemset: bool = Op.isMemset() && Op.len < 32 && Op.isZeroMemset();
    let mut AlignmentIsAcceptable: Closure_41 = Closure_41 { Op: &mut Op, cap_1: self };
    if CanUseNEON && Op.isMemset() && !IsSmallZeroMemset && AlignmentIsAcceptable.call(v16i8, 1) {
        return fixed_vector(2, integer(64));
    }
    if CanUseFP && !IsSmallZeroMemset && AlignmentIsAcceptable.call(f128, 16) {
        return floatIEEE(128);
    }
    if Op.len >= 8 && AlignmentIsAcceptable.call(i64, 8) {
        return integer(64);
    }
    if Op.len >= 4 && AlignmentIsAcceptable.call(i32, 4) {
        return integer(32);
    }
    return LLT {};
}

fn AArch64TargetLowering::isLegalAddImmediate(self: *AArch64TargetLowering, Immed: i64) -> bool {
    if Immed == min() {
        return false;
    }
    return isLegalArithImmed(if Immed < 0 { -Immed } else { Immed } as u64);
}

fn AArch64TargetLowering::isLegalAddScalableImmediate(self: *AArch64TargetLowering, Imm: i64) -> bool {
    if !self.Subtarget.useScalarIncVL() {
        return false;
    }
    if Imm % 16 == 0 {
        return isInt(Imm / 16);
    }
    if Imm % 8 == 0 {
        return if Imm / 8 < 0 { -Imm / 8 } else { Imm / 8 } <= 16;
    }
    if Imm % 4 == 0 {
        return if Imm / 4 < 0 { -Imm / 4 } else { Imm / 4 } <= 16;
    }
    if Imm % 2 == 0 {
        return if Imm / 2 < 0 { -Imm / 2 } else { Imm / 2 } <= 16;
    }
    return false;
}

fn AArch64TargetLowering::isMulAddWithConstProfitable(self: *AArch64TargetLowering, AddNode: SDValue, ConstNode: SDValue) -> bool {
    let mut VT: EVT = AddNode.getValueType();
    if VT.isVector() || VT.getScalarSizeInBits() > 64 {
        return true;
    }
    let mut C1Node: *ConstantSDNode = cast(AddNode.getOperand(1));
    let mut C2Node: *ConstantSDNode = cast(ConstNode);
    let mut C1: i64 = C1Node.getSExtValue();
    let mut C1C2: APInt = C1Node.getAPIntValue() * C2Node.getAPIntValue();
    if !self.isLegalAddImmediate(C1) || self.isLegalAddImmediate(C1C2.getSExtValue()) {
        return true;
    }
    let mut Insn: ImmInsnModel, 4> = zeroed();
    let mut BitSize: u32 = if VT.getSizeInBits().operator unsigned long long() <= 32 { 32 } else { 64 };
    expandMOVImm(C1C2.getZExtValue(), BitSize);
    if Insn()() > 1 {
        return false;
    }
    return true;
}

fn AArch64TargetLowering::isLegalICmpImmediate(self: *AArch64TargetLowering, Immed: i64) -> bool {
    return self.isLegalAddImmediate(Immed);
}

fn AArch64TargetLowering::isLegalAddressingMode(self: *AArch64TargetLowering, DL: *DataLayout, AMode: *AddrMode, Ty: *mut Type, AS: u32, I: *mut Instruction) -> bool {
    if AMode.BaseGV {
        return false;
    }
    if AMode.HasBaseReg && AMode.BaseOffs && AMode.Scale {
        return false;
    }
    let mut AM: AddrMode = AMode;
    if AM.Scale && !AM.HasBaseReg {
        if AM.Scale == 1 {
            AM.HasBaseReg = true;
            AM.Scale = 0;
        } else if AM.Scale == 2 {
            AM.HasBaseReg = true;
            AM.Scale = 1;
        } else {
            return false;
        }
    }
    if !AM.HasBaseReg {
        return false;
    }
    if Ty.isScalableTy() {
        if isa(Ty) {
            let mut VecNumBytes: u64 = DL.getTypeSizeInBits(Ty).getKnownMinValue() / 8;
            if AM.HasBaseReg && !AM.BaseOffs && AM.ScalableOffset && !AM.Scale && (AM.ScalableOffset % VecNumBytes == 0) && VecNumBytes <= 16 && isPowerOf2_64(VecNumBytes) {
                return isInt(AM.ScalableOffset / VecNumBytes as i64);
            }
            let mut VecElemNumBytes: u64 = DL.getTypeSizeInBits(cast(Ty)()) / 8;
            return AM.HasBaseReg && !AM.BaseOffs && !AM.ScalableOffset && (AM.Scale == 0 || AM.Scale as u64 == VecElemNumBytes);
        }
        return AM.HasBaseReg && !AM.BaseOffs && !AM.ScalableOffset && !AM.Scale;
    }
    if AM.ScalableOffset {
        return false;
    }
    let mut NumBytes: u64 = 0;
    if Ty.isSized() {
        let mut NumBits: u64 = DL.getTypeSizeInBits(Ty).operator unsigned long long();
        NumBytes = NumBits / 8;
        if !isPowerOf2_64(NumBits) {
            NumBytes = 0;
        }
    }
    return self.Subtarget.getInstrInfo().isLegalAddressingMode(NumBytes, AM.BaseOffs, AM.Scale);
}

fn AArch64TargetLowering::getPreferredLargeGEPBaseOffset(self: *AArch64TargetLowering, MinOffset: i64, MaxOffset: i64) -> i64 {
    let mut HighPart: i64 = MinOffset & ~4095;
    if MinOffset >> 12 == MaxOffset >> 12 && self.isLegalAddImmediate(HighPart) {
        return HighPart;
    }
    return 0;
}

fn AArch64TargetLowering::shouldConsiderGEPOffsetSplit(self: *AArch64TargetLowering) -> bool {
    return true;
}

fn AArch64TargetLowering::isFMAFasterThanFMulAndFAdd(self: *AArch64TargetLowering, MF: *MachineFunction, VT: EVT) -> bool {
    let mut ScalarVT: EVT = VT.getScalarType();
    if !ScalarVT.isSimple() {
        return false;
    }
    match ScalarVT.getSimpleVT().SimpleTy {
        f16 => {
            return self.Subtarget();
        },
        f32 => {
            f64;
        },
        bf16 => {
            return VT.isScalableVector() && (self.Subtarget() || self.Subtarget());
        },
        _ => {
            break;
        },
    }
    return false;
}

fn AArch64TargetLowering::isFMAFasterThanFMulAndFAdd(self: *AArch64TargetLowering, F: *Function, Ty: *mut Type) -> bool {
    match Ty.getScalarType().getTypeID() {
        FloatTyID => {
            DoubleTyID;
        },
        _ => {
            return false;
        },
    }
}

fn AArch64TargetLowering::generateFMAsInMachineCombiner(self: *AArch64TargetLowering, VT: EVT, OptLevel: CodeGenOptLevel) -> bool {
    return (OptLevel >= Aggressive) && !VT.isScalableVector() && !self.useSVEForFixedLengthVectorVT(VT, false);
}

fn AArch64TargetLowering::getScratchRegisters(self: *AArch64TargetLowering, arg: ID) -> *MCPhysReg {
    let mut ScratchRegs: []MCPhysReg = zeroed();
    return ScratchRegs;
}

fn AArch64TargetLowering::getRoundingControlRegisters(self: *AArch64TargetLowering) -> ArrayRef<MCPhysReg> {
    let mut RCRegs: []MCPhysReg = zeroed();
    return RCRegs();
}

fn AArch64TargetLowering::isNarrowingProfitable(self: *AArch64TargetLowering, N: *mut SDNode, SrcVT: EVT, DestVT: EVT) -> bool {
    return self.isTypeLegal(DestVT) && DestVT.isVector();
}

fn AArch64TargetLowering::isDesirableToCommuteWithShift(self: *AArch64TargetLowering, N: *SDNode, Level: CombineLevel) -> bool {
    assert!((N.getOpcode() == SHL || N.getOpcode() == SRA || N.getOpcode() == SRL), "Expected shift op");
    let mut ShiftLHS: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if !operator(ShiftLHS).hasOneUse() {
        return false;
    }
    if ShiftLHS.getOpcode() == SIGN_EXTEND && !operator(ShiftLHS.getOperand(0)).hasOneUse() {
        return false;
    }
    if ShiftLHS.getOpcode() == AND && (VT == i32 || VT == i64) && isa(ShiftLHS.getOperand(1)) {
        let mut TruncMask: u64 = ShiftLHS.getConstantOperandVal(1);
        if isMask_64(TruncMask) {
            let mut AndLHS: SDValue = ShiftLHS.getOperand(0);
            if AndLHS.getOpcode() == SRL {
                if  {
                    if N.getOpcode() == SHL {
                        if  {
                            return () == ();
                        }
                    }
                    return false;
                }
            }
        }
    }
    return true;
}

fn AArch64TargetLowering::isDesirableToCommuteXorWithShift(self: *AArch64TargetLowering, N: *SDNode) -> bool {
    assert!(N.getOpcode() == XOR && (N.getOperand(0).getOpcode() == SHL || N.getOperand(0).getOpcode() == SRL), "Expected XOR(SHIFT) pattern");
    let mut XorC: *mut auto = dyn_cast(N.getOperand(1));
    let mut ShiftC: *mut auto = dyn_cast(N.getOperand(0).getOperand(1));
    if XorC() &&  {
        let mut MaskIdx: u32 = 0;
        let mut MaskLen: u32 = 0;
        if XorC()()(MaskIdx, MaskLen) {
            let mut ShiftAmt: u32 = ();
            let mut BitWidth: u32 = N.getValueType(0).getScalarSizeInBits();
            if N.getOperand(0).getOpcode() == SHL {
                return MaskIdx == ShiftAmt && MaskLen == (BitWidth - ShiftAmt);
            }
            return MaskIdx == 0 && MaskLen == (BitWidth - ShiftAmt);
        }
    }
    return false;
}

fn AArch64TargetLowering::shouldFoldConstantShiftPairToMask(self: *AArch64TargetLowering, N: *SDNode) -> bool {
    assert!(((N.getOpcode() == SHL && N.getOperand(0).getOpcode() == SRL) || (N.getOpcode() == SRL && N.getOperand(0).getOpcode() == SHL)), "Expected shift-shift mask");
    if !operator(N.getOperand(0)).hasOneUse() {
        return false;
    }
    let mut VT: EVT = N.getValueType(0);
    if N.getOpcode() == SRL && (VT == i32 || VT == i64) {
        let mut C1: *mut auto = dyn_cast(N.getOperand(0).getOperand(1));
        let mut C2: *mut auto = dyn_cast(N.getOperand(1));
        return (operator!() || operator!() || () >= ());
    }
    if N.getOpcode() == SHL && N.hasOneUse() {
        if  {
            let mut ShlAmt: u32 = ();
            let mut ShouldADD: *mut SDNode = operator(N.user_begin());
            if ShouldADD.getOpcode() == ADD && ShouldADD.hasOneUse() {
                if  {
                    let mut MemVT: EVT = ();
                    if Load()(0)() {
                        return (8 << ShlAmt) != MemVT.getScalarSizeInBits();
                    }
                    if self.isIndexedLoadLegal(PRE_INC, MemVT) {
                        return (8 << ShlAmt) != MemVT.getFixedSizeInBits();
                    }
                }
            }
        }
    }
    return true;
}

fn AArch64TargetLowering::shouldFoldSelectWithIdentityConstant(self: *AArch64TargetLowering, BinOpcode: u32, VT: EVT, SelectOpcode: u32, X: SDValue, Y: SDValue) -> bool {
    return VT.isScalableVector() && self.isTypeLegal(VT) && SelectOpcode == VSELECT;
}

fn AArch64TargetLowering::shouldConvertConstantLoadToIntImm(self: *AArch64TargetLowering, Imm: *APInt, Ty: *mut Type) -> bool {
    assert!(Ty.isIntegerTy();
    let mut BitSize: u32 = Ty.getPrimitiveSizeInBits().operator unsigned long long();
    if BitSize == 0 {
        return false;
    }
    let mut Val: i64 = Imm.getSExtValue();
    if Val == 0 || isLogicalImmediate(Val, BitSize) {
        return true;
    }
    if Val < 0 {
        Val = ~Val;
    }
    if BitSize == 32 {
        Val &= (1 << 32) - 1;
    }
    let mut Shift: u32 = Log2_64(Val as u64) / 16;
    return Shift < 3;
}

fn AArch64TargetLowering::getExtractSubvectorCost(self: *AArch64TargetLowering, ResVT: EVT, SrcVT: EVT, Index: u32) -> ExtractSubvectorCost {
    if !self.isOperationLegalOrCustom(EXTRACT_SUBVECTOR, ResVT, false) {
        return Expensive;
    }
    if Index == 0 {
        return Free;
    }
    if Index == ResVT.getVectorMinNumElements() {
        return Cheap;
    }
    return Expensive;
}

fn AArch64TargetLowering::shouldOptimizeMulOverflowWithZeroHighBits(self: *AArch64TargetLowering, Context: *mut LLVMContext, VT: EVT) -> bool {
    if self.getTypeAction(Context, VT) != TypeExpandInteger {
        return false;
    }
    let mut LegalTy: EVT = getIntegerVT(Context, VT.getSizeInBits().operator unsigned long long() / 2);
    return self.getTypeAction(Context, LegalTy) == TypeLegal;
}

fn foldVectorXorShiftIntoCmp(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if operator!(Subtarget()()) || !VT.isVector() {
        return SDValue {};
    }
    let mut Shift: SDValue = N.getOperand(0);
    let mut Ones: SDValue = N.getOperand(1);
    if  {
        return SDValue {};
    }
    let mut ShiftAmt: *mut auto = dyn_cast(Shift.getOperand(1));
    let mut ShiftEltTy: EVT = Shift.getValueType().getVectorElementType();
    if operator!() || () != ShiftEltTy.getSizeInBits().operator unsigned long long() - 1 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut Zero: SDValue = DAG.getConstant(0, DL, Shift.getValueType(), false, false);
    return DAG.getSetCC(DL, VT, Shift.getOperand(0), Zero, SETGE, SDValue {}, false, None);
}

fn performVecReduceAddCombineWithUADDLP(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getValueType(0) != i32 {
        return SDValue {};
    }
    let mut VecReduceOp0: SDValue = N.getOperand(0);
    let mut SawTrailingZext: bool = false;
    if VecReduceOp0.getOpcode() == ZERO_EXTEND && operator(VecReduceOp0).getValueType(0) == v16i32 && isAbsOpcode(operator(operator(VecReduceOp0).getOperand(0)).getOpcode()) && operator(operator(VecReduceOp0).getOperand(0)).getValueType(0) == v16i16 {
        SawTrailingZext = true;
        VecReduceOp0 = VecReduceOp0.getOperand(0);
    }
    let mut AbsInputVT: MVT = if SawTrailingZext { v16i16 } else { v16i32 };
    if !isAbsOpcode(VecReduceOp0.getOpcode()) || operator(VecReduceOp0).getValueType(0) != AbsInputVT {
        return SDValue {};
    }
    let mut ABS: SDValue = VecReduceOp0;
    if operator(operator(ABS).getOperand(0)).getOpcode() != SUB || operator(operator(ABS).getOperand(0)).getValueType(0) != AbsInputVT {
        return SDValue {};
    }
    let mut SUB: SDValue = operator(ABS).getOperand(0);
    let mut Opcode0: u32 = operator(SUB).getOperand(0).getOpcode();
    let mut Opcode1: u32 = operator(SUB).getOperand(1).getOpcode();
    if operator(operator(SUB).getOperand(0)).getValueType(0) != AbsInputVT || operator(operator(SUB).getOperand(1)).getValueType(0) != AbsInputVT {
        return SDValue {};
    }
    let mut IsZExt: bool = false;
    if Opcode0 == ZERO_EXTEND && Opcode1 == ZERO_EXTEND {
        IsZExt = true;
    } else if Opcode0 == SIGN_EXTEND && Opcode1 == SIGN_EXTEND {
        IsZExt = false;
    } else {
        return SDValue {};
    }
    let mut EXT0: SDValue = operator(SUB).getOperand(0);
    let mut EXT1: SDValue = operator(SUB).getOperand(1);
    if operator(operator(EXT0).getOperand(0)).getValueType(0) != v16i8 || operator(operator(EXT1).getOperand(0)).getValueType(0) != v16i8 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut UABDHigh8Op0: SDValue = DAG.getExtractSubvector(DL, v8i8, operator(EXT0).getOperand(0), 8);
    let mut UABDHigh8Op1: SDValue = DAG.getExtractSubvector(DL, v8i8, operator(EXT1).getOperand(0), 8);
    let mut UABDHigh8: SDValue = DAG.getNode(if IsZExt { ABDU } else { ABDS }, DL, v8i8, UABDHigh8Op0, UABDHigh8Op1);
    let mut UABDL: SDValue = DAG.getNode(ZERO_EXTEND, DL, v8i16, UABDHigh8);
    let mut UABDLo8Op0: SDValue = DAG.getExtractSubvector(DL, v8i8, operator(EXT0).getOperand(0), 0);
    let mut UABDLo8Op1: SDValue = DAG.getExtractSubvector(DL, v8i8, operator(EXT1).getOperand(0), 0);
    let mut UABDLo8: SDValue = DAG.getNode(if IsZExt { ABDU } else { ABDS }, DL, v8i8, UABDLo8Op0, UABDLo8Op1);
    let mut ZExtUABD: SDValue = DAG.getNode(ZERO_EXTEND, DL, v8i16, UABDLo8);
    let mut UABAL: SDValue = DAG.getNode(ADD, DL, v8i16, UABDL, ZExtUABD);
    let mut UADDLP: SDValue = DAG;
    return DAG.getNode(VECREDUCE_ADD, DL, i32, UADDLP);
}

fn performActiveLaneMaskCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, ST: *AArch64Subtarget) -> SDValue {
    if DCI.isBeforeLegalize() || !ST.isSVEorStreamingSVEAvailable() {
        return SDValue {};
    }
    if optimizeBrk(N, DCI.DAG) {
        Brk;
    } else {
        return Brk;
    }
    if optimizeIncrementingWhile(N, DCI.DAG, false, false) {
        While;
    } else {
        return While;
    }
    let mut NumExts: u32 = count_if(N.users(), Closure_42 {});
    let mut MaskEC: ElementCount = N.getValueType(0).getVectorElementCount();
    if !MaskEC.isKnownMultipleOf(NumExts) {
        return SDValue {};
    }
    let mut ExtMinEC: ElementCount = MaskEC.divideCoefficientBy(NumExts);
    if ExtMinEC.getKnownMinValue() < 2 {
        return SDValue {};
    }
    let mut Extracts: i32 = NumExts;
    for Use in N.users() {
        if Use.getOpcode() != EXTRACT_SUBVECTOR {
            continue;
        }
        if Use.getValueType(0).getVectorElementCount() != ExtMinEC {
            return SDValue {};
        }
        let mut Offset: u32 = Use.getConstantOperandVal(1);
        let mut Part: u32 = Offset / ExtMinEC.getKnownMinValue();
        if Extracts()[Part] != null {
            return SDValue {};
        }
        Extracts()[Part] = Use;
    }
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut DL: SDLoc = N;
    let mut Idx: SDValue = N.getOperand(0);
    let mut TC: SDValue = N.getOperand(1);
    let mut IdxVT: EVT = Idx.getValueType();
    let mut ExtVT: EVT = [0](0);
    if N.getValueType(0).isFixedLengthVector() || operator!((ST()() || ST()())) {
        let mut Masks: i32 = 0;
        let mut StartVal: SDValue = Idx;
        for let mut I: u32 = 0; I < NumExts; I += 1 {
            if I > 0 {
                StartVal = DAG.getNode(UADDSAT, DL, IdxVT, Idx, DAG.getElementCount(DL, IdxVT, ExtMinEC * I));
            }
            let mut ALMForPart: auto = DAG.getNode(GET_ACTIVE_LANE_MASK, DL, ExtVT, StartVal, TC);
            Masks()();
            DCI([I]);
        }
        return DAG(CONCAT_VECTORS, DL, N.getValueType(0));
    }
    let mut ID: SDValue = DAG;
    if IdxVT != i64 {
        Idx = DAG.getNode(ZERO_EXTEND, DL, i64, Idx);
        TC = DAG.getNode(ZERO_EXTEND, DL, i64, TC);
    }
    let mut DoubleExtVT: EVT = ExtVT.getDoubleNumVectorElementsVT(*DAG.getContext());
    let mut R: auto = DAG.getNode(INTRINSIC_WO_CHAIN, DL, [ExtVT, ExtVT], [ID, Idx, TC]);
    DCI([0], (0));
    DCI([1], (1));
    let mut Concats: i32 = void { DAG(CONCAT_VECTORS, DL, DoubleExtVT, (0), (1)) };
    if NumExts == 2 {
        assert!(N.getValueType(0) == DoubleExtVT);
        return [0];
    }
    let mut Elts: auto = DAG.getElementCount(DL, i64, ExtVT.getVectorElementCount() * 2);
    for let mut I: u32 = 2; I < NumExts; I += 2 {
        Idx = DAG(UADDSAT, DL, i64, Idx);
        R() = DAG.getNode(INTRINSIC_WO_CHAIN, DL, [ExtVT, ExtVT], [ID, Idx, TC]);
        DCI([I], (0));
        DCI([I + 1], (1));
        Concats()(DAG(CONCAT_VECTORS, DL, DoubleExtVT, (0), (1)));
    }
    return DAG(CONCAT_VECTORS, DL, N.getValueType(0));
}

fn performVecReduceAddCntpCombine(N: *mut SDNode, DAG: *mut SelectionDAG, ST: *AArch64Subtarget) -> SDValue {
    let mut Op: SDValue = N.getOperand(0);
    if operator(Op).getOpcode() != ZERO_EXTEND {
        return SDValue {};
    }
    let mut ZExtOp: SDValue = operator(Op).getOperand(0);
    let mut VT: EVT = ZExtOp.getValueType();
    if !VT.isScalableVectorOf(i1) || !DAG.getTargetLoweringInfo().isTypeLegal(VT) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut Cntp: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, i64, DAG, ZExtOp, ZExtOp);
    return DAG.getZExtOrTrunc(Cntp, DL, N.getValueType(0));
}

fn performVecReduceAddCombine(N: *mut SDNode, DAG: *mut SelectionDAG, ST: *AArch64Subtarget) -> SDValue {
    if performVecReduceAddCntpCombine(N, DAG, ST) {
        Result;
    } else {
        return Result;
    }
    if !ST.isNeonAvailable() {
        return SDValue {};
    }
    if operator!(ST()()) {
        return performVecReduceAddCombineWithUADDLP(N, DAG);
    }
    let mut Op0: SDValue = N.getOperand(0);
    if N.getValueType(0) != i32 || Op0.getValueType().isScalableVT() || Op0.getValueType().getVectorElementType() != i32 {
        return SDValue {};
    }
    let mut ExtOpcode: u32 = Op0.getOpcode();
    let mut A: SDValue = Op0;
    let mut B: SDValue = SDValue {};
    let mut DotOpcode: u32 = 0;
    if ExtOpcode == MUL {
        A = Op0.getOperand(0);
        B = Op0.getOperand(1);
        if A.getOperand(0).getValueType() != B.getOperand(0).getValueType() {
            return SDValue {};
        }
        let mut OpCodeA: u32 = A.getOpcode();
        if OpCodeA != ZERO_EXTEND && OpCodeA != SIGN_EXTEND {
            return SDValue {};
        }
        let mut OpCodeB: u32 = B.getOpcode();
        if OpCodeB != ZERO_EXTEND && OpCodeB != SIGN_EXTEND {
            return SDValue {};
        }
        if OpCodeA == OpCodeB {} else {
            if operator!(ST()()) {
                return SDValue {};
            }
            if OpCodeA == SIGN_EXTEND {
                swap(A, B);
            }
        }
    } else if ExtOpcode == ZERO_EXTEND {} else if ExtOpcode == SIGN_EXTEND {} else {
        return SDValue {};
    }
    let mut Op0VT: EVT = A.getOperand(0).getValueType();
    let mut IsValidElementCount: bool = Op0VT.getVectorNumElements() % 8 == 0;
    let mut IsValidSize: bool = Op0VT.getScalarSizeInBits() == 8;
    if !IsValidElementCount || !IsValidSize {
        return SDValue {};
    }
    let mut DL: SDLoc = Op0;
    if !B {
        B = DAG.getConstant(1, DL, Op0VT, false, false);
    } else {
        B = B.getOperand(0);
    }
    let mut IsMultipleOf16: u32 = Op0VT.getVectorNumElements() % 16 == 0;
    let mut NumOfVecReduce: u32 = 0;
    let mut TargetType: EVT = EVT {};
    if IsMultipleOf16 {
        NumOfVecReduce = Op0VT.getVectorNumElements() / 16;
        TargetType = v4i32;
    } else {
        NumOfVecReduce = Op0VT.getVectorNumElements() / 8;
        TargetType = v2i32;
    }
    if NumOfVecReduce == 1 {
        let mut Zeros: SDValue = DAG.getConstant(0, DL, TargetType, false, false);
        let mut Dot: SDValue = DAG.getNode(DotOpcode, DL, Zeros.getValueType(), Zeros, A.getOperand(0), B);
        return DAG.getNode(VECREDUCE_ADD, DL, N.getValueType(0), Dot);
    }
    let mut VecReduce16Num: u32 = Op0VT.getVectorNumElements() / 16;
    let mut SDotVec16: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut I: u32 = 0;
    for ; I < VecReduce16Num; I += 1 {
        let mut Zeros: SDValue = DAG.getConstant(0, DL, v4i32, false, false);
        let mut Op0: SDValue = DAG.getExtractSubvector(DL, v16i8, A.getOperand(0), I * 16);
        let mut Op1: SDValue = DAG.getExtractSubvector(DL, v16i8, B, I * 16);
        let mut Dot: SDValue = DAG.getNode(DotOpcode, DL, Zeros.getValueType(), Zeros, Op0, Op1);
        SDotVec16.push(Dot);
    }
    let mut SDot16EVT: EVT = getVectorVT(*DAG.getContext(), i32, 4 * VecReduce16Num, false);
    let mut ConcatSDot16: SDValue = DAG;
    let mut VecReduceAdd16: SDValue = DAG.getNode(VECREDUCE_ADD, DL, N.getValueType(0), ConcatSDot16);
    let mut VecReduce8Num: u32 = (Op0VT.getVectorNumElements() % 16) / 8;
    if VecReduce8Num == 0 {
        return VecReduceAdd16;
    }
    let mut Zeros: SDValue = DAG.getConstant(0, DL, v2i32, false, false);
    let mut Vec8Op0: SDValue = DAG.getExtractSubvector(DL, v8i8, A.getOperand(0), I * 16);
    let mut Vec8Op1: SDValue = DAG.getExtractSubvector(DL, v8i8, B, I * 16);
    let mut Dot: SDValue = DAG.getNode(DotOpcode, DL, Zeros.getValueType(), Zeros, Vec8Op0, Vec8Op1);
    let mut VecReduceAdd8: SDValue = DAG.getNode(VECREDUCE_ADD, DL, N.getValueType(0), Dot);
    return DAG.getNode(ADD, DL, N.getValueType(0), VecReduceAdd16, VecReduceAdd8);
}

fn performUADDVAddCombine(A: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DetectAddExtract: Closure_43 = Closure_43 { DAG: &mut DAG };
    if DetectAddExtract.call(A) {
        R;
    } else {
        return R;
    }
    if A.getOperand(0).getOpcode() == ADD && A.getOperand(0).hasOneUse() {
        if performUADDVAddCombine(A.getOperand(0), DAG) {
            R;
        } else {
            return DAG.getNode(ADD, A, A.getValueType(), R, A.getOperand(1));
        }
    }
    if A.getOperand(1).getOpcode() == ADD && A.getOperand(1).hasOneUse() {
        if performUADDVAddCombine(A.getOperand(1), DAG) {
            R;
        } else {
            return DAG.getNode(ADD, A, A.getValueType(), R, A.getOperand(0));
        }
    }
    return SDValue {};
}

fn performUADDVZextCombine(A: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(A.getOpcode() == ADD);
    let mut VT: EVT = A.getValueType();
    if VT != v8i16 && VT != v4i32 && VT != v2i64 {
        return SDValue {};
    }
    let mut Op0: SDValue = A.getOperand(0);
    let mut Op1: SDValue = A.getOperand(1);
    if Op0.getOpcode() != ZERO_EXTEND || Op0.getOpcode() != Op1.getOpcode() {
        return SDValue {};
    }
    let mut Ext0: SDValue = Op0.getOperand(0);
    let mut Ext1: SDValue = Op1.getOperand(0);
    let mut ExtVT0: EVT = Ext0.getValueType();
    let mut ExtVT1: EVT = Ext1.getValueType();
    if ExtVT0 != ExtVT1 || VT.getScalarSizeInBits() != (2 * ExtVT0.getScalarSizeInBits()) {
        return SDValue {};
    }
    let mut PairVT: EVT = ExtVT0.getDoubleNumVectorElementsVT(*DAG.getContext());
    let mut Concat: SDValue = DAG.getNode(CONCAT_VECTORS, A, PairVT, Ext0, Ext1);
    match VT.getSimpleVT().SimpleTy {
        v2i64 => {
            v4i32;
        },
        v8i16 => {
            let mut Uaddlv: SDValue = DAG;
            return DAG;
        },
        _ => {
            llvm_unreachable_internal("Unhandled vector type", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 21065);
        },
    }
}

fn performUADDVCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut A: SDValue = N.getOperand(0);
    if A.getOpcode() == ADD {
        if performUADDVAddCombine(A, DAG) {
            R;
        } else {
            return DAG.getNode(N.getOpcode(), N, N.getValueType(0), R);
        }
    }
    let mut OpVT: MVT = A.getSimpleValueType();
    assert!(N.getSimpleValueType(0) == OpVT, "The operand type should be consistent with the result type of UADDV");
    let mut Mask: APInt = getAllOnes(OpVT.getVectorNumElements());
    Mask.clearBit(0);
    let mut KnownLeadingLanes: KnownBits = DAG.computeKnownBits(A, Mask, 0);
    if KnownLeadingLanes.isZero() {
        return A;
    }
    return SDValue {};
}

fn performBICiCombine(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DemandedBits: APInt = getAllOnes(N.getValueType(0).getScalarSizeInBits());
    let mut DemandedElts: APInt = getAllOnes(N.getValueType(0).getVectorNumElements());
    if DAG.getTargetLoweringInfo().SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }, DemandedBits, DemandedElts, DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn performXorCombine(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    return foldVectorXorShiftIntoCmp(N, DAG, Subtarget);
}

fn AArch64TargetLowering::BuildSDIVPow2(self: *AArch64TargetLowering, N: *mut SDNode, Divisor: *APInt, DAG: *mut SelectionDAG, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut Attr: AttributeList = DAG.getMachineFunction().getFunction().getAttributes();
    if self.isIntDivCheap(N.getValueType(0), Attr) {
        return SDValue { Node: N, ResNo: 0 };
    }
    let mut VT: EVT = N.getValueType(0);
    if VT.isVector() && self.Subtarget.isSVEorStreamingSVEAvailable() {
        return SDValue { Node: N, ResNo: 0 };
    }
    if (VT != i32 && VT != i64) || !(Divisor.isPowerOf2() || Divisor.isNegatedPowerOf2()) {
        return SDValue {};
    }
    if Divisor == 2 || Divisor == APInt { Divisor.getBitWidth(), -2, true, false } {
        return SDValue {};
    }
    return self.buildSDIVPow2WithCMov(N, Divisor, DAG, Created);
}

fn AArch64TargetLowering::BuildSREMPow2(self: *AArch64TargetLowering, N: *mut SDNode, Divisor: *APInt, DAG: *mut SelectionDAG, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut Attr: AttributeList = DAG.getMachineFunction().getFunction().getAttributes();
    if self.isIntDivCheap(N.getValueType(0), Attr) {
        return SDValue { Node: N, ResNo: 0 };
    }
    let mut VT: EVT = N.getValueType(0);
    if VT.isScalableVector() || self.Subtarget.useSVEForFixedLengthVectors() {
        return SDValue { Node: N, ResNo: 0 };
    }
    if (VT != i32 && VT != i64) || !(Divisor.isPowerOf2() || Divisor.isNegatedPowerOf2()) {
        return SDValue {};
    }
    let mut Lg2: u32 = Divisor.countr_zero();
    if Lg2 == 0 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut N0: SDValue = N.getOperand(0);
    let mut Pow2MinusOne: SDValue = DAG.getConstant((1 << Lg2) - 1, DL, VT, false, false);
    let mut Zero: SDValue = DAG.getConstant(0, DL, VT, false, false);
    let mut CCVal: SDValue = SDValue {};
    let mut CSNeg: SDValue = SDValue {};
    if Lg2 == 1 {
        let mut Cmp: SDValue = getAArch64Cmp(N0, Zero, SETGE, CCVal, DAG, DL);
        let mut And: SDValue = DAG.getNode(AND, DL, VT, N0, Pow2MinusOne);
        CSNeg = DAG;
        Created()(Cmp.getNode());
        Created()(And.getNode());
    } else {
        let mut CCVal: SDValue = getCondCode(DAG, MI);
        let mut VTs: SDVTList = DAG.getVTList(VT, FlagsVT);
        let mut Negs: SDValue = DAG;
        let mut AndPos: SDValue = DAG.getNode(AND, DL, VT, N0, Pow2MinusOne);
        let mut AndNeg: SDValue = DAG.getNode(AND, DL, VT, Negs, Pow2MinusOne);
        CSNeg = DAG;
        Created()(Negs.getNode());
        Created()(AndPos.getNode());
        Created()(AndNeg.getNode());
    }
    return CSNeg;
}

fn IsSVECntIntrinsic(S: SDValue) -> bool {
    match getIntrinsicID(S.getNode()) {
        _ => {
            break;
        },
    }
    return false;
}

fn getMaxValueForSVECntIntrinsic(Op: SDValue) -> optional<ElementCount> {
    let mut IID: ID = getIntrinsicID(Op.getNode());
    if  {
        return Op.getOperand(1).getValueType().getVectorElementCount();
    }
    match IID {
        _ => {
            return nullopt();
        },
    }
}

fn calculatePreExtendType(Extend: SDValue) -> EVT {
    match Extend.getOpcode() {
        SIGN_EXTEND => {
            ZERO_EXTEND;
        },
        AssertSext => {
            AssertZext;
        },
        AND => {
            let mut Constant: *mut ConstantSDNode = dyn_cast(Extend.getOperand(1).getNode());
            if !Constant {
                return Other;
            }
            let mut Mask: u64 = Constant.getZExtValue();
            if Mask == 255 {
                return i8;
            } else if Mask == 65535 {
                return i16;
            } else if Mask == 4294967295 {
                return i32;
            }
            return Other;
        },
        _ => {
            return Other;
        },
    }
}

fn performBuildShuffleExtendCombine(BV: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = BV.getValueType();
    if BV.getOpcode() != BUILD_VECTOR && BV.getOpcode() != VECTOR_SHUFFLE {
        return SDValue {};
    }
    let mut Extend: SDValue = operator(BV).getOperand(0);
    let mut ExtendOpcode: u32 = Extend.getOpcode();
    let mut IsAnyExt: bool = ExtendOpcode == ANY_EXTEND;
    let mut IsSExt: bool = ExtendOpcode == SIGN_EXTEND || ExtendOpcode == SIGN_EXTEND_INREG || ExtendOpcode == AssertSext;
    if !IsAnyExt && !IsSExt && ExtendOpcode != ZERO_EXTEND && ExtendOpcode != AssertZext && ExtendOpcode != AND {
        return SDValue {};
    }
    if BV.getOpcode() == VECTOR_SHUFFLE && ExtendOpcode != SIGN_EXTEND && ExtendOpcode != ZERO_EXTEND && ExtendOpcode != ANY_EXTEND {
        return SDValue {};
    }
    let mut PreExtendType: EVT = calculatePreExtendType(Extend);
    if PreExtendType == Other || PreExtendType.getScalarSizeInBits() != VT.getScalarSizeInBits() / 2 {
        return SDValue {};
    }
    let mut SeenZExtOrSExt: bool = !IsAnyExt;
    let mut NBV: SDValue = SDValue {};
    let mut DL: SDLoc = BV;
    if BV.getOpcode() == BUILD_VECTOR {
        let mut PreExtendVT: EVT = VT.changeVectorElementType(*DAG.getContext(), PreExtendType);
        let mut PreExtendLegalType: EVT = if PreExtendType.getScalarSizeInBits() < 32 { i32 } else { PreExtendType };
        let mut NewOps: SmallVector<SDValue, 8> = zeroed();
        for Op in operator(BV).ops() {
            NewOps()(if Op.isUndef() { DAG.getPOISON(PreExtendLegalType) } else { DAG.getAnyExtOrTrunc(Op.getOperand(0), DL, PreExtendLegalType) });
        }
        NBV = DAG(BUILD_VECTOR, DL, PreExtendVT);
    } else {
        let mut PreExtendVT: EVT = VT.changeVectorElementType(*DAG.getContext(), PreExtendType.getScalarType());
        NBV = DAG.getVectorShuffle(PreExtendVT, DL, BV.getOperand(0).getOperand(0), if BV.getOperand(1).isUndef() { DAG.getPOISON(PreExtendVT) } else { BV.getOperand(1).getOperand(0) }, cast(BV)());
    }
    let mut ExtOpc: u32 = if !SeenZExtOrSExt { ANY_EXTEND } else { (if IsSExt { SIGN_EXTEND } else { ZERO_EXTEND }) };
    return DAG.getNode(ExtOpc, DL, VT, NBV);
}

fn performMulVectorExtendCombine(Mul: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Mul.getValueType(0);
    if VT != v8i16 && VT != v4i32 && VT != v2i64 {
        return SDValue {};
    }
    let mut Op0: SDValue = performBuildShuffleExtendCombine(Mul.getOperand(0), DAG);
    let mut Op1: SDValue = performBuildShuffleExtendCombine(Mul.getOperand(1), DAG);
    if !Op0 && !Op1 {
        return SDValue {};
    }
    let mut DL: SDLoc = Mul;
    return DAG.getNode(Mul.getOpcode(), DL, VT, if Op0 {} else { Mul.getOperand(0) }, if Op1 {} else { Mul.getOperand(1) });
}

fn performMulRdsvlCombine(Mul: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Mul;
    let mut VT: EVT = Mul.getValueType(0);
    let mut MulOp0: SDValue = Mul.getOperand(0);
    let mut ConstMultiplier: i32 = cast(Mul.getOperand(1))();
    if  {
        return SDValue {};
    }
    let mut AbsConstValue: u32 = if ConstMultiplier < 0 { -ConstMultiplier } else { ConstMultiplier };
    let mut OperandShift: u32 = cast(operator(MulOp0).getOperand(1))();
    let mut UpperBound: i32 = countr_zero(AbsConstValue) - OperandShift;
    let mut B: u32 = if ConstMultiplier < 0 { 32 } else { 31 };
    let mut CeilAxOverB: u32 = (AbsConstValue + (B - 1)) / B;
    let mut LowerBound: i32 = Log2_32_Ceil(CeilAxOverB) - OperandShift;
    if LowerBound > UpperBound {
        return SDValue {};
    }
    let mut Shift: i32 = if max(0, LowerBound) < UpperBound { max(0, LowerBound) } else { UpperBound };
    let mut RdsvlMul: i32 = (AbsConstValue >> (OperandShift + Shift)) * (if ConstMultiplier < 0 { -1 } else { 1 });
    let mut Rdsvl: auto = DAG;
    if Shift == 0 {
        return ;
    }
    return DAG(if Shift < 0 { SRL } else { SHL }, DL, VT, Rdsvl(), DAG.getConstant(if Shift < 0 { -Shift } else { Shift }, DL, i32, false, false), Exact);
}

fn performMulVectorCmpZeroCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if VT != v2i64 && VT != v1i64 && VT != v2i32 && VT != v4i32 && VT != v4i16 && VT != v8i16 {
        return SDValue {};
    }
    if N.getOperand(0).getOpcode() != AND || N.getOperand(0).getOperand(0).getOpcode() != SRL {
        return SDValue {};
    }
    let mut And: SDValue = N.getOperand(0);
    let mut Srl: SDValue = And.getOperand(0);
    let mut V1: APInt = APInt {};
    let mut V2: APInt = APInt {};
    let mut V3: APInt = APInt {};
    if !isConstantSplatVector(N.getOperand(1).getNode(), V1) || !isConstantSplatVector(And.getOperand(1).getNode(), V2) || !isConstantSplatVector(Srl.getOperand(1).getNode(), V3) {
        return SDValue {};
    }
    let mut HalfSize: u32 = VT.getScalarSizeInBits() / 2;
    if !V1.isMask(HalfSize) || V2 != (1 | 1 << HalfSize) || V3 != (HalfSize - 1) {
        return SDValue {};
    }
    let mut HalfVT: EVT = getVectorVT(*DAG.getContext(), getIntegerVT(*DAG.getContext(), HalfSize), VT.getVectorElementCount() * 2);
    let mut DL: SDLoc = N;
    let mut In: SDValue = DAG;
    let mut Zero: SDValue = DAG.getConstant(0, DL, In.getValueType(), false, false);
    let mut CM: SDValue = DAG.getSetCC(DL, HalfVT, Zero, In, SETGT, SDValue {}, false, None);
    return DAG;
}

fn performVectorExtCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isFixedLengthVector() || VT.getSizeInBits().operator unsigned long long() <= 128 || (N.getOperand(0).getOpcode() != ZERO_EXTEND && N.getOperand(0).getOpcode() != SIGN_EXTEND) || (N.getOperand(1).getOpcode() != ZERO_EXTEND && N.getOperand(1).getOpcode() != SIGN_EXTEND) || N.getOperand(0).getOperand(0).getValueType() != N.getOperand(1).getOperand(0).getValueType() {
        return SDValue {};
    }
    if N.getOpcode() == MUL && N.getOperand(0).getOpcode() != N.getOperand(1).getOpcode() {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0).getOperand(0);
    let mut N1: SDValue = N.getOperand(1).getOperand(0);
    let mut InVT: EVT = N0.getValueType();
    let mut S1: EVT = InVT.getScalarType();
    let mut S2: EVT = VT.getScalarType();
    if (S2 == i32 && S1 == i8) || (S2 == i64 && (S1 == i8 || S1 == i16)) {
        let mut DL: SDLoc = N;
        let mut HalfVT: EVT = getVectorVT(*DAG.getContext(), S2.getHalfSizedIntegerVT(*DAG.getContext()), VT.getVectorElementCount());
        let mut NewN0: SDValue = DAG.getNode(N.getOperand(0).getOpcode(), DL, HalfVT, N0);
        let mut NewN1: SDValue = DAG.getNode(N.getOperand(1).getOpcode(), DL, HalfVT, N1);
        let mut NewOp: SDValue = DAG.getNode(N.getOpcode(), DL, HalfVT, NewN0, NewN1);
        return DAG.getNode(if N.getOpcode() == MUL { N.getOperand(0).getOpcode() } else { SIGN_EXTEND as u32 }, DL, VT, NewOp);
    }
    return SDValue {};
}

fn isOnlyUsedAsMemoryAddress(N: *mut SDNode) -> bool {
    assert!((N.getOpcode() == ADD || N.getOpcode() == SUB), "Expected add/sub node");
    for Use in N.uses() {
        let mut User: *mut SDNode = Use.getUser();
        match User.getOpcode() {
            LOAD => {
                let mut Load: *mut auto = cast(User);
                if operator!() || Use.getOperandNo() != 1 {
                    return false;
                }
                break;
            },
            STORE => {
                let mut Store: *mut auto = cast(User);
                if operator!() || Use.getOperandNo() != 2 {
                    return false;
                }
                break;
            },
            _ => {
                return false;
            },
        }
    }
    return true;
}

fn performMulCombine(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    if performMulVectorExtendCombine(N, DAG) {
        Ext;
    } else {
        return Ext;
    }
    if performMulVectorCmpZeroCombine(N, DAG) {
        Ext;
    } else {
        return Ext;
    }
    if performVectorExtCombine(N, DAG) {
        Ext;
    } else {
        return Ext;
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut MulOper: SDValue = SDValue {};
    let mut AddSubOpc: u32 = 0;
    let mut IsAddSubWith1: Closure_44 = Closure_44 { AddSubOpc: &mut AddSubOpc, MulOper: &mut MulOper };
    if IsAddSubWith1.call(N0) {
        let mut MulVal: SDValue = DAG.getNode(MUL, DL, VT, N1, MulOper);
        return DAG.getNode(AddSubOpc, DL, VT, N1, MulVal);
    }
    if IsAddSubWith1.call(N1) {
        let mut MulVal: SDValue = DAG.getNode(MUL, DL, VT, N0, MulOper);
        return DAG.getNode(AddSubOpc, DL, VT, N0, MulVal);
    }
    if !isa(N1) {
        return SDValue {};
    }
    if performMulRdsvlCombine(N, DAG) {
        Ext;
    } else {
        return Ext;
    }
    let mut C: *mut ConstantSDNode = cast(N1);
    let mut ConstValue: *APInt = C.getAPIntValue();
    if IsSVECntIntrinsic(N0) || (operator(N0).getOpcode() == TRUNCATE && (IsSVECntIntrinsic(operator(N0).getOperand(0)))) {
        if ConstValue.sge(1) && ConstValue.sle(16) {
            return SDValue {};
        }
    }
    let mut TrailingZeroes: u32 = ConstValue.countr_zero();
    if TrailingZeroes {
        if operator(N0).hasOneUse() && (isSignExtended(N0, DAG) || isZeroExtended(N0, DAG)) {
            return SDValue {};
        }
        if N.hasOneUse() {
            let mut User: *mut SDNode = operator(N.user_begin());
            if (User.getOpcode() == ADD || User.getOpcode() == SUB) && !isOnlyUsedAsMemoryAddress(User) {
                return SDValue {};
            }
        }
    }
    let mut ShiftedConstValue: APInt = ConstValue.ashr(TrailingZeroes);
    let mut ShiftAmt: u32 = 0;
    let mut Shl: Closure_45 = Closure_45 { DAG: &mut DAG, DL: &mut DL, VT: &mut VT };
    let mut Add: Closure_46 = Closure_46 { DAG: &mut DAG, DL: &mut DL, VT: &mut VT };
    let mut Sub: Closure_47 = Closure_47 { DAG: &mut DAG, DL: &mut DL, VT: &mut VT };
    let mut Negate: Closure_48 = Closure_48 { N0: &mut N0, DAG: &mut DAG, DL: &mut DL, VT: &mut VT };
    let mut isPowPlusPlusConst: Closure_49 = Closure_49 {};
    let mut isPowPlusPlusOneConst: Closure_50 = Closure_50 {};
    let mut isPowMinusMinusOneConst: Closure_51 = Closure_51 {};
    if ConstValue.isNonNegative() {
        let mut SCVMinus1: APInt = ShiftedConstValue - 1;
        let mut SCVPlus1: APInt = ShiftedConstValue + 1;
        let mut CVPlus1: APInt = ConstValue + 1;
        let mut CVM: APInt = APInt {};
        let mut CVN: APInt = APInt {};
        if SCVMinus1.isPowerOf2() {
            ShiftAmt = SCVMinus1.logBase2();
            return Shl.call(Add.call(Shl.call(N0, ShiftAmt), N0), TrailingZeroes);
        } else if CVPlus1.isPowerOf2() {
            ShiftAmt = CVPlus1.logBase2();
            return Sub.call(Shl.call(N0, ShiftAmt), N0);
        } else if SCVPlus1.isPowerOf2() {
            ShiftAmt = SCVPlus1.logBase2() + TrailingZeroes;
            return Sub.call(Shl.call(N0, ShiftAmt), Shl.call(N0, TrailingZeroes));
        }
        if Subtarget()() && isPowPlusPlusConst.call(ConstValue, CVM, CVN) {
            let mut CVMMinus1: APInt = CVM - 1;
            let mut CVNMinus1: APInt = CVN - 1;
            let mut ShiftM1: u32 = CVMMinus1.logBase2();
            let mut ShiftN1: u32 = CVNMinus1.logBase2();
            if ShiftM1 <= 4 && ShiftN1 <= 4 {
                let mut MVal: SDValue = Add.call(Shl.call(N0, ShiftM1), N0);
                return Add.call(Shl.call(MVal, ShiftN1), MVal);
            }
        }
        if Subtarget()() && isPowPlusPlusOneConst.call(ConstValue, CVM, CVN) {
            let mut ShiftM: u32 = CVM.getZExtValue();
            let mut ShiftN: u32 = CVN.getZExtValue();
            if ShiftM <= 4 && ShiftN <= 4 {
                let mut MVal: SDValue = Add.call(Shl.call(N0, CVM.getZExtValue()), N0);
                return Add.call(Shl.call(MVal, CVN.getZExtValue()), N0);
            }
        }
        if Subtarget()() && isPowMinusMinusOneConst.call(ConstValue, CVM, CVN) {
            let mut ShiftM: u32 = CVM.getZExtValue();
            let mut ShiftN: u32 = CVN.getZExtValue();
            if ShiftM <= 4 && ShiftN <= 4 {
                let mut MVal: SDValue = Sub.call(N0, Shl.call(N0, CVM.getZExtValue()));
                return Sub.call(N0, Shl.call(MVal, CVN.getZExtValue()));
            }
        }
    } else {
        let mut SCVPlus1: APInt = operator(ShiftedConstValue) + 1;
        let mut CVNegPlus1: APInt = operator(ConstValue) + 1;
        let mut CVNegMinus1: APInt = operator(ConstValue) - 1;
        if CVNegPlus1.isPowerOf2() {
            ShiftAmt = CVNegPlus1.logBase2();
            return Sub.call(N0, Shl.call(N0, ShiftAmt));
        } else if CVNegMinus1.isPowerOf2() {
            ShiftAmt = CVNegMinus1.logBase2();
            return Negate.call(Add.call(Shl.call(N0, ShiftAmt), N0));
        } else if SCVPlus1.isPowerOf2() {
            ShiftAmt = SCVPlus1.logBase2() + TrailingZeroes;
            return Sub.call(Shl.call(N0, TrailingZeroes), Shl.call(N0, ShiftAmt));
        }
    }
    return SDValue {};
}

fn performVectorCompareAndMaskUnaryOpCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isVector() || operator(N.getOperand(0)).getOpcode() != AND || operator(operator(N.getOperand(0)).getOperand(0)).getOpcode() != SETCC || VT.getSizeInBits() != operator(N.getOperand(0)).getValueType(0).getSizeInBits() {
        return SDValue {};
    }
    if dyn_cast(operator(N.getOperand(0)).getOperand(1)) {
        BV;
    } else {
        if !BV.isConstant() {
            return SDValue {};
        }
        let mut DL: SDLoc = N;
        let mut IntVT: EVT = BV.getValueType(0);
        let mut SourceConst: SDValue = DAG.getNode(N.getOpcode(), DL, VT, SDValue { Node: BV, ResNo: 0 });
        let mut MaskConst: SDValue = DAG.getNode(BITCAST, DL, IntVT, SourceConst);
        let mut NewAnd: SDValue = DAG.getNode(AND, DL, IntVT, operator(N.getOperand(0)).getOperand(0), MaskConst);
        let mut Res: SDValue = DAG.getNode(BITCAST, DL, VT, NewAnd);
        return Res;
    }
    return SDValue {};
}

fn tryToReplaceScalarFPConversionWithSVE(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    if N.isStrictFPOpcode() {
        return SDValue {};
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if Subtarget()() {
        return SDValue {};
    }
    if !Subtarget.isSVEorStreamingSVEAvailable() || (!Subtarget.isStreaming() && !Subtarget.isStreamingCompatible()) {
        return SDValue {};
    }
    let mut isSupportedType: Closure_52 = Closure_52 {};
    let mut SrcVal: SDValue = N.getOperand(0);
    let mut SrcTy: EVT = SrcVal.getValueType();
    let mut DestTy: EVT = N.getValueType(0);
    if !isSupportedType.call(SrcTy) || !isSupportedType.call(DestTy) {
        return SDValue {};
    }
    let mut SrcVecTy: EVT = EVT {};
    let mut DestVecTy: EVT = EVT {};
    if DestTy.bitsGT(SrcTy) {
        DestVecTy = getPackedSVEVectorVT(DestTy);
        SrcVecTy = DestVecTy.changeVectorElementType(*DAG.getContext(), SrcTy);
    } else {
        SrcVecTy = getPackedSVEVectorVT(SrcTy);
        DestVecTy = SrcVecTy.changeVectorElementType(*DAG.getContext(), DestTy);
    }
    if SrcVecTy == nxv2i32 || DestVecTy == nxv2i32 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut Vec: SDValue = DAG.getInsertVectorElt(DL, DAG.getPOISON(SrcVecTy), SrcVal, 0);
    let mut ConvertOps: SmallVector<SDValue, 2> = zeroed();
    if N.getOpcode() == FP_TO_SINT_SAT || N.getOpcode() == FP_TO_UINT_SAT {
        ConvertOps()(DAG.getValueType(DestVecTy.getVectorElementType()));
    }
    let mut Convert: SDValue = DAG(N.getOpcode(), DL, DestVecTy);
    return DAG.getExtractVectorElt(DL, DestTy, Convert, 0);
}

fn performIntToFpCombine(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    if performVectorCompareAndMaskUnaryOpCombine(N, DAG) {
        Res;
    } else {
        return Res;
    }
    if tryToReplaceScalarFPConversionWithSVE(N, DAG, DCI, Subtarget) {
        Res;
    } else {
        return Res;
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != f16 && VT != f32 && VT != f64 {
        return SDValue {};
    }
    if VT == f16 && operator!(Subtarget()()) {
        return SDValue {};
    }
    if VT.getSizeInBits() != N.getOperand(0).getValueSizeInBits() {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    if Subtarget.isNeonAvailable() && isNormalLoad(N0.getNode()) && N0.hasOneUse() && operator!(cast(N0)()) {
        let mut LN0: *mut LoadSDNode = cast(N0);
        let mut Load: SDValue = DAG.getLoad(VT, N, LN0.getChain(), LN0.getBasePtr(), LN0.getPointerInfo(), LN0.getAlign(), LN0.getMemOperand().getFlags(), MMOMetadata {});
        DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN0, ResNo: 1 }, Load.getValue(1));
        let mut Opcode: u32 = 0;
        return DAG.getNode(Opcode, N, VT, Load);
    }
    return SDValue {};
}

fn performFpToIntCombine(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    if tryToReplaceScalarFPConversionWithSVE(N, DAG, DCI, Subtarget) {
        Res;
    } else {
        return Res;
    }
    return SDValue {};
}

fn performANDORCSELCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut CSel0: SDValue = N.getOperand(0);
    let mut CSel1: SDValue = N.getOperand(1);
    if  {
        return SDValue {};
    }
    if !operator(CSel0).hasOneUse() || !operator(CSel1).hasOneUse() {
        return SDValue {};
    }
    if !isNullConstant(CSel0.getOperand(0)) || !isOneConstant(CSel0.getOperand(1)) || !isNullConstant(CSel1.getOperand(0)) || !isOneConstant(CSel1.getOperand(1)) {
        return SDValue {};
    }
    let mut Cmp0: SDValue = CSel0.getOperand(3);
    let mut Cmp1: SDValue = CSel1.getOperand(3);
    let mut CC0: CondCode = CSel0.getConstantOperandVal(2) as CondCode;
    let mut CC1: CondCode = CSel1.getConstantOperandVal(2) as CondCode;
    if !operator(Cmp0).hasOneUse() || !operator(Cmp1).hasOneUse() {
        return SDValue {};
    }
    if  {
        swap(Cmp0, Cmp1);
        swap(CC0, CC1);
    }
    if  {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut CCmp: SDValue = SDValue {};
    let mut Condition: SDValue = SDValue {};
    let mut NZCV: u32 = 0;
    if  {
        let mut InvCC0: CondCode = getInvertedCondCode(CC0);
        Condition = getCondCode(DAG, InvCC0);
        NZCV = getNZCVToSatisfyCondCode(CC1);
    } else {
        let mut InvCC1: CondCode = getInvertedCondCode(CC1);
        Condition = getCondCode(DAG, CC0);
        NZCV = getNZCVToSatisfyCondCode(InvCC1);
    }
    let mut NZCVOp: SDValue = DAG.getConstant(NZCV, DL, i32, false, false);
    let mut Op1: *mut auto = dyn_cast(Cmp1.getOperand(1));
    if Op1() && ()() && ()(-32) {
        let mut AbsOp1: SDValue = DAG(()(), DL, (0));
        CCmp = DAG;
    } else {
        CCmp = DAG;
    }
    return DAG;
}

fn tryCombineToREV(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    assert!(N.getOpcode() == OR, "Expected OR instruction");
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !VT.isVector() {
        return SDValue {};
    }
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    if EltSize != 16 && EltSize != 32 && EltSize != 64 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if VT.isScalableVector() {
        if  {
            swap(N0, N1);
        }
        if  {
            return SDValue {};
        }
        if N0.getOperand(0) != N1.getOperand(0) || N0.getOperand(1) != N1.getOperand(1) || N0.getOperand(2) != N1.getOperand(2) {
            return SDValue {};
        }
        let mut ShAmt: APInt = APInt {};
        if !isConstantSplatVector(N0.getOperand(2).getNode(), ShAmt) || EltSize / 2 != ShAmt {
            return SDValue {};
        }
        let mut RevOp: u32 = 0;
        return DAG.getNode(RevOp, DL, VT, N0.getOperand(0), N0.getOperand(1), DAG.getPOISON(VT));
    }
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type");
    if EltSize == 16 {
        return SDValue {};
    }
    if  {
        swap(N0, N1);
    }
    if  {
        return SDValue {};
    }
    if N0.getOperand(0) != N1.getOperand(0) || N0.getOperand(1) != N1.getOperand(1) {
        return SDValue {};
    }
    if EltSize / 2 != N0.getConstantOperandVal(1) {
        return SDValue {};
    }
    let mut HalfVT: EVT = EVT {};
    let mut RevOp: u32 = 0;
    if EltSize == 32 {
        HalfVT = if VT.is64BitVector() { v4i16 } else { v8i16 };
    } else {
        HalfVT = if VT.is64BitVector() { v2i32 } else { v4i32 };
    }
    return DAG;
}

fn performANDORDUPNOTCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Opc: u32 = N.getOpcode();
    assert!(Opc == AND || Opc == OR);
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if operator!(sd_match(N, m_c_BinOp(Opc, m_Value(X), m_Shuffle(m_InsertElt(m_Poison(), m_Not(m_Value(Y)), m_Zero(false)), m_Poison())))) {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    let mut Not: SDValue = DAG.getNOT(DL, DAG.getSplat(VT, DL, Y), VT);
    return DAG.getNode(Opc, DL, VT, X, Not);
}

fn performORCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    if performANDORCSELCombine(N, DAG) {
        R;
    } else {
        return R;
    }
    if tryCombineToREV(N, DAG, DCI) {
        R;
    } else {
        return R;
    }
    if performANDORDUPNOTCombine(N, DAG) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn isConstantSplatVectorMaskForType(N: *mut SDNode, MemVT: EVT) -> bool {
    if !MemVT.getVectorElementType().isSimple() {
        return false;
    }
    let mut MaskForTy: u64 = 0;
    match MemVT.getVectorElementType().getSimpleVT().SimpleTy {
        i8 => {
            MaskForTy = 255;
        },
        i16 => {
            MaskForTy = 65535;
        },
        i32 => {
            MaskForTy = 4294967295;
        },
        _ => {
            return false;
        },
    }
    if  {
        if  {
            return ()() == MaskForTy;
        }
    }
    return false;
}

fn performReinterpretCastCombine(N: *mut SDNode) -> SDValue {
    let mut LeafOp: SDValue = SDValue { Node: N, ResNo: 0 };
    let mut Op: SDValue = N.getOperand(0);
    while  {
        Op = operator(Op).getOperand(0);
    }
    if LeafOp.getValueType() == Op.getValueType() {
        return Op;
    }
    return SDValue {};
}

fn performSVEAndCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut Src: SDValue = N.getOperand(0);
    let mut Opc: u32 = operator(Src).getOpcode();
    if  {
        let mut UnpkOp: SDValue = operator(Src).getOperand(0);
        let mut Dup: SDValue = N.getOperand(1);
        if Dup.getOpcode() != SPLAT_VECTOR {
            return SDValue {};
        }
        let mut DL: SDLoc = N;
        let mut C: *mut ConstantSDNode = dyn_cast(operator(Dup).getOperand(0));
        if !C {
            return SDValue {};
        }
        let mut ExtVal: u64 = C.getZExtValue();
        let mut MaskAndTypeMatch: Closure_53 = Closure_53 { ExtVal: ExtVal };
        let mut EltTy: EVT = operator(UnpkOp).getValueType(0).getVectorElementType();
        if MaskAndTypeMatch.call(EltTy) {
            return Src;
        }
        let mut MaskedLoadOp: auto = dyn_cast(UnpkOp);
        if MaskedLoadOp() && (MaskedLoadOp()() == ZEXTLOAD || () == EXTLOAD) {
            let mut EltTy: EVT = ()();
            if MaskAndTypeMatch.call(EltTy) {
                return Src;
            }
        }
        let mut Mask: APInt = C.getAPIntValue().trunc(EltTy.getSizeInBits().operator unsigned long long());
        Dup = DAG.getNode(SPLAT_VECTOR, DL, operator(UnpkOp).getValueType(0), DAG.getConstant(Mask.zextOrTrunc(32), DL, i32, false, false));
        let mut And: SDValue = DAG.getNode(AND, DL, operator(UnpkOp).getValueType(0), UnpkOp, Dup);
        return DAG.getNode(Opc, DL, N.getValueType(0), And);
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if isAllActivePredicate(DAG, N.getOperand(0)) {
        return N.getOperand(1);
    }
    if isAllActivePredicate(DAG, N.getOperand(1)) {
        return N.getOperand(0);
    }
    if operator!() {
        return SDValue {};
    }
    let mut Mask: SDValue = N.getOperand(1);
    if !Src.hasOneUse() {
        return SDValue {};
    }
    let mut MemVT: EVT = EVT {};
    match Opc {
        _ => {
            return SDValue {};
        },
    }
    if isConstantSplatVectorMaskForType(Mask.getNode(), MemVT) {
        return Src;
    }
    return SDValue {};
}

fn performANDSETCCCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut SetCC: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    for U in N.users() {
        if U.getOpcode() == SELECT {
            return SDValue {};
        }
    }
    if SetCC.getOpcode() == SETCC && SetCC.getOperand(0).getValueType() == f32 {
        let mut Cmp: SDValue = SDValue {};
        let mut CC: CondCode = zeroed();
        if !DCI.isBeforeLegalize() && (Cmp = emitConjunction(DAG, SDValue { Node: N, ResNo: 0 }, CC)) {
            let mut InvertedCC: CondCode = getInvertedCondCode(CC);
            let mut DL: SDLoc = N;
            return DAG;
        }
    }
    return SDValue {};
}

fn performANDCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    if performANDORCSELCombine(N, DAG) {
        R;
    } else {
        return R;
    }
    if performANDSETCCCombine(N, DCI) {
        R;
    } else {
        return R;
    }
    if performANDORDUPNOTCombine(N, DAG) {
        R;
    } else {
        return R;
    }
    if !DAG.getTargetLoweringInfo().isTypeLegal(VT) {
        return SDValue {};
    }
    if VT.isScalableVector() {
        return performSVEAndCombine(N, DCI);
    }
    if !VT.is64BitVector() && !VT.is128BitVector() {
        return SDValue {};
    }
    let mut BVN: *mut BuildVectorSDNode = dyn_cast(RHS.getNode());
    if !BVN {
        return SDValue {};
    }
    let mut DefBits: APInt = APInt { VT.getSizeInBits().operator unsigned long long(), 0, false, false };
    let mut UndefBits: APInt = APInt { VT.getSizeInBits().operator unsigned long long(), 0, false, false };
    if resolveBuildVector(BVN, DefBits, UndefBits) {
        let mut NewOp: SDValue = SDValue {};
        let mut Known: KnownBits = DAG.computeKnownBits(LHS, 0);
        let mut ZeroSplat: APInt = APInt { VT.getSizeInBits().operator unsigned long long(), 0, false, false };
        for let mut I: u32 = 0; I < VT.getSizeInBits().operator unsigned long long() / Known.Zero.getBitWidth(); I += 1 {
            operator(ZeroSplat, Known.Zero.zext(VT.getSizeInBits().operator unsigned long long()) << (Known.Zero.getBitWidth() * I));
        }
        DefBits = operator((DefBits | ZeroSplat));
        if (NewOp = tryAdvSIMDModImm32(SDValue { Node: N, ResNo: 0 }, DAG, DefBits, &mut LHS)) || (NewOp = tryAdvSIMDModImm16(SDValue { Node: N, ResNo: 0 }, DAG, DefBits, &mut LHS)) {
            return NewOp;
        }
        UndefBits = operator((UndefBits | ZeroSplat));
        if (NewOp = tryAdvSIMDModImm32(SDValue { Node: N, ResNo: 0 }, DAG, UndefBits, &mut LHS)) || (NewOp = tryAdvSIMDModImm16(SDValue { Node: N, ResNo: 0 }, DAG, UndefBits, &mut LHS)) {
            return NewOp;
        }
    }
    return SDValue {};
}

fn performFADDCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    if !N.getFlags().hasAllowReassociation() {
        return SDValue {};
    }
    let mut ReassocComplex: Closure_54 = Closure_54 { DAG: &mut DAG, DL: &mut DL, VT: &mut VT, N: &mut N };
    if ReassocComplex.call(LHS, RHS) {
        R;
    } else {
        return R;
    }
    if ReassocComplex.call(RHS, LHS) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn hasPairwiseAdd(Opcode: u32, VT: EVT, FullFP16: bool) -> bool {
    match Opcode {
        STRICT_FADD => {
            FADD;
        },
        ADD => {
            return VT == i64;
        },
        _ => {
            return false;
        },
    }
}

fn isPredicateCCSettingOp(N: SDValue) -> bool {
    if  {
        return true;
    }
    return false;
}

fn performFirstTrueTestVectorCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    assert!(N.getOpcode() == EXTRACT_VECTOR_ELT);
    if operator!(Subtarget()()) || DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N0.getValueType();
    if !VT.isScalableVectorOf(i1) || !isNullConstant(N.getOperand(1)) {
        return SDValue {};
    }
    if !isPredicateCCSettingOp(N0) || N0.getResNo() != 0 {
        return SDValue {};
    }
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut Pg: SDValue = DAG.getConstant(1, N, VT, false, false);
    return getPTest(DAG, N.getValueType(0), Pg, N0, FIRST_ACTIVE);
}

fn performLastTrueTestVectorCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    assert!(N.getOpcode() == EXTRACT_VECTOR_ELT);
    if operator!(Subtarget()()) || DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut OpVT: EVT = N0.getValueType();
    if !OpVT.isScalableVectorOf(i1) {
        return SDValue {};
    }
    let mut Idx: SDValue = N.getOperand(1);
    let mut NumEls: u32 = OpVT.getVectorElementCount().getKnownMinValue();
    if operator!(sd_match(Idx, m_ZExtOrSelf(m_Add(m_VScale(m_SpecificInt(NumEls)), m_AllOnes(false))))) {
        return SDValue {};
    }
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut Pg: SDValue = DAG.getConstant(1, N, OpVT, false, false);
    return getPTest(DAG, N.getValueType(0), Pg, N0, LAST_ACTIVE);
}

fn performExtractLastActiveCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    assert!(N.getOpcode() == EXTRACT_VECTOR_ELT);
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut Vec: SDValue = N.getOperand(0);
    let mut Idx: SDValue = N.getOperand(1);
    if DCI.isBeforeLegalize() || Idx.getOpcode() != VECTOR_FIND_LAST_ACTIVE {
        return SDValue {};
    }
    let mut EltVT: EVT = Vec.getValueType().getVectorElementType();
    if operator!(is_contained(void { i8, i16, i32, i64, f16, bf16, f32, f64 }, EltVT.getSimpleVT().SimpleTy)) {
        return SDValue {};
    }
    let mut Mask: SDValue = Idx.getOperand(0);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isOperationLegal(VECTOR_FIND_LAST_ACTIVE, Mask.getValueType()) {
        return SDValue {};
    }
    return DAG;
}

fn hasSVEMultiVectorOps(Subtarget: *AArch64Subtarget) -> bool {
    return (Subtarget.isSVEorStreamingSVEAvailable() && Subtarget()()) || (Subtarget.isStreaming() && Subtarget()());
}

fn m_PredicateAsCounterWhile() -> auto {
    return m_AnyOf(m_SpecificOpc(), m_SpecificOpc(), m_SpecificOpc(), m_SpecificOpc(), m_SpecificOpc(), m_SpecificOpc(), m_SpecificOpc(), m_SpecificOpc());
}

fn perfomPextFirstTrueVectorCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    assert!(N.getOpcode() == EXTRACT_VECTOR_ELT);
    if DCI.isBeforeLegalize() || !hasSVEMultiVectorOps(Subtarget) {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N0.getValueType();
    if !VT.isScalableVectorOf(i1) || !isNullConstant(N.getOperand(1)) {
        return SDValue {};
    }
    if operator!(sd_match(N0)) {
        return SDValue {};
    }
    let mut WhilePredCounter: SDValue = operator(N0).getOperand(1);
    let mut Flags: SDValue = SDValue { Node: WhilePredCounter.getNode(), ResNo: 1 };
    return getSETCC(FIRST_ACTIVE, Flags, N, DCI.DAG);
}

fn performExtractVectorEltCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    assert!(N.getOpcode() == EXTRACT_VECTOR_ELT);
    if performFirstTrueTestVectorCombine(N, DCI, Subtarget) {
        Res;
    } else {
        return Res;
    }
    if performLastTrueTestVectorCombine(N, DCI, Subtarget) {
        Res;
    } else {
        return Res;
    }
    if performExtractLastActiveCombine(N, DCI, Subtarget) {
        Res;
    } else {
        return Res;
    }
    if perfomPextFirstTrueVectorCombine(N, DCI, Subtarget) {
        Res;
    } else {
        return Res;
    }
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut FullFP16: bool = Subtarget()();
    let mut IsStrict: bool = operator(N0).isStrictFPOpcode();
    if  {
        return if VT.isInteger() { DAG.getZExtOrTrunc(N0.getOperand(0), N, VT) } else { N0.getOperand(0) };
    }
    if isNullConstant(N1) && hasPairwiseAdd(operator(N0).getOpcode(), VT, FullFP16) && (!IsStrict || N0.hasOneUse()) {
        let mut DL: SDLoc = N0;
        let mut N00: SDValue = operator(N0).getOperand(if IsStrict { 1 } else { 0 });
        let mut N01: SDValue = operator(N0).getOperand(if IsStrict { 2 } else { 1 });
        let mut Shuffle: *mut ShuffleVectorSDNode = dyn_cast(N01);
        let mut Other: SDValue = N00;
        if !Shuffle {
            Shuffle = dyn_cast(N00);
            Other = N01;
        }
        if Shuffle && Shuffle.getMaskElt(0) == 1 && Other == Shuffle.getOperand(0) {
            let mut Extract1: SDValue = DAG.getExtractVectorElt(DL, VT, Other, 0);
            let mut Extract2: SDValue = DAG.getExtractVectorElt(DL, VT, Other, 1);
            if !IsStrict {
                return DAG.getNode(operator(N0).getOpcode(), DL, VT, Extract1, Extract2);
            }
            let mut Ret: SDValue = DAG.getNode(operator(N0).getOpcode(), DL, [VT, Other], [operator(N0).getOperand(0), Extract1, Extract2]);
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Ret);
            DAG.ReplaceAllUsesOfValueWith(N0.getValue(1), Ret.getValue(1));
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if DCI.isAfterLegalizeDAG() && Subtarget.isLittleEndian() && VT.isInteger() && isa(N1) {
        let mut LoadN0: SDValue = N0;
        if (N0.getOpcode() == ZERO_EXTEND || N0.getOpcode() == SIGN_EXTEND || N0.getOpcode() == ANY_EXTEND) && N0.getOperand(0).hasOneUse() {
            LoadN0 = N0.getOperand(0);
        }
        let mut OffsetElts: u32 = 0;
        if LoadN0.getOpcode() == EXTRACT_SUBVECTOR {
            OffsetElts = LoadN0.getConstantOperandVal(1);
            LoadN0 = LoadN0.getOperand(0);
        }
        if LoadN0.getOpcode() == INSERT_SUBVECTOR && LoadN0.getOperand(0).isUndef() && isNullConstant(LoadN0.getOperand(2)) && LoadN0.getOperand(1).hasOneUse() {
            LoadN0 = LoadN0.getOperand(1);
        }
        let mut Load: auto = dyn_cast(LoadN0);
        if Load() && () && isNormalLoad() && ()() && all_of(operator(N0).uses(), Closure_55 { N0: &mut N0 }) {
            let mut DL: SDLoc = Load();
            let mut Offset: u32 = (OffsetElts + N.getConstantOperandVal(1)) * (0)() / 8;
            let mut BasePtr: SDValue = DAG(DL, DAG.getConstant(Offset, DL, i64, false, false));
            let mut ExtType: LoadExtType = if N0.getOpcode() == ZERO_EXTEND { ZEXTLOAD } else { (if N0.getOpcode() == SIGN_EXTEND { SEXTLOAD } else { EXTLOAD }) };
            let mut ScalarLoad: SDValue = DAG(ExtType, DL, VT, BasePtr, ()(Offset), (0)(), commonAlignment(Offset), ()());
            DAG(ScalarLoad);
            return ScalarLoad;
        }
    }
    return SDValue {};
}

fn performConcatVectorsCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N0Opc: u32 = operator(N0).getOpcode();
    let mut N1Opc: u32 = operator(N1).getOpcode();
    if  {
        let mut Op0MoreElems: SDValue = DAG;
        let mut Op1MoreElems: SDValue = DAG;
        return DAG;
    }
    if VT.isScalableVector() {
        return SDValue {};
    }
    if N.getNumOperands() == 2 && N0Opc == TRUNCATE && N1Opc == TRUNCATE {
        let mut N00: SDValue = operator(N0).getOperand(0);
        let mut N10: SDValue = operator(N1).getOperand(0);
        let mut N00VT: EVT = N00.getValueType();
        let mut N00Opc: u32 = N00.getOpcode();
        let mut N10Opc: u32 = N10.getOpcode();
        if N00VT == N10.getValueType() && (N00VT == v2i64 || N00VT == v4i32) && N00VT.getScalarSizeInBits() == 4 * VT.getScalarSizeInBits() {
            let mut MidVT: MVT = (if N00VT == v2i64 { v4i32 } else { v8i16 });
            let mut Mask: SmallVector<int, 8> = zeroed();
            for let mut i: u64 = 0; i < Mask()(); i += 1 {
                Mask()[i] = i * 2;
            }
            return DAG(TRUNCATE, DL, VT, DAG.getVectorShuffle(MidVT, DL, DAG.getNode(BITCAST, DL, MidVT, N00), DAG.getNode(BITCAST, DL, MidVT, N10)));
        }
        if  {
            let mut N000: SDValue = operator(N00).getOperand(0);
            let mut N100: SDValue = operator(N10).getOperand(0);
            let mut N001ConstVal: u64 = operator(N00).getConstantOperandVal(1);
            let mut N101ConstVal: u64 = operator(N10).getConstantOperandVal(1);
            let mut NScalarSize: u64 = N.getValueType(0).getScalarSizeInBits();
            if N001ConstVal == N101ConstVal && N001ConstVal > NScalarSize {
                N000 = DAG;
                N100 = DAG;
                let mut Uzp: SDValue = DAG;
                let mut NewShiftConstant: SDValue = DAG.getTargetConstant(N001ConstVal - NScalarSize, DL, i32, false);
                return DAG;
            }
        }
    }
    if N.getOperand(0).getValueType() == v4i8 || N.getOperand(0).getValueType() == v2i16 || N.getOperand(0).getValueType() == v2i8 {
        let mut SrcVT: EVT = N.getOperand(0).getValueType();
        if N.getNumOperands() % 2 == 0 && all_of(N.op_values(), Closure_56 { cap_0: SrcVT }) {
            let mut FVT: EVT = if SrcVT == v2i8 { f16 } else { f32 };
            let mut NVT: EVT = getVectorVT(*DAG.getContext(), FVT, N.getNumOperands(), false);
            let mut Ops: i32 = 0;
            for let mut i: u32 = 0; i < N.getNumOperands(); i += 1 {
                let mut V: SDValue = N.getOperand(i);
                if V.isUndef() {
                    Ops()(DAG.getUNDEF(FVT));
                } else {
                    let mut LD: *mut LoadSDNode = cast(V);
                    let mut NewLoad: SDValue = DAG.getLoad(FVT, DL, LD.getChain(), LD.getBasePtr(), LD.getMemOperand());
                    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LD, ResNo: 1 }, NewLoad.getValue(1));
                    Ops()(NewLoad);
                }
            }
            return DAG.getBitcast(N.getValueType(0), DAG(NVT, DL));
        }
    }
    if N.getNumOperands() == 2 && N0Opc == TRUNCATE && N1Opc == TRUNCATE && N.isOnlyUserOf(N0.getNode()) && N.isOnlyUserOf(N1.getNode()) {
        let mut isBitwiseVectorNegate: Closure_57 = Closure_57 {};
        let mut N00: SDValue = operator(N0).getOperand(0);
        let mut N10: SDValue = operator(N1).getOperand(0);
        if isBitwiseVectorNegate.call(N00) && operator(N0).isOnlyUserOf(N00.getNode()) && isBitwiseVectorNegate.call(N10) && operator(N1).isOnlyUserOf(N10.getNode()) {
            return DAG.getNOT(DL, DAG.getNode(CONCAT_VECTORS, DL, VT, DAG.getNode(TRUNCATE, DL, N0.getValueType(), operator(N00).getOperand(0)), DAG.getNode(TRUNCATE, DL, N1.getValueType(), operator(N10).getOperand(0))), VT);
        }
    }
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if N.getNumOperands() == 2 && N0Opc == N1Opc && VT.is128BitVector() && (DAG.getTargetLoweringInfo().isBinOp(N0Opc) || isVectorizedBinOp(N0Opc)) && operator(N0).hasOneUse() && operator(N1).hasOneUse() {
        let mut N00: SDValue = operator(N0).getOperand(0);
        let mut N01: SDValue = operator(N0).getOperand(1);
        let mut N10: SDValue = operator(N1).getOperand(0);
        let mut N11: SDValue = operator(N1).getOperand(1);
        if !N00.isUndef() && !N01.isUndef() && !N10.isUndef() && !N11.isUndef() {
            let mut Concat0: SDValue = DAG.getNode(CONCAT_VECTORS, DL, VT, N00, N10);
            let mut Concat1: SDValue = DAG.getNode(CONCAT_VECTORS, DL, VT, N01, N11);
            return DAG.getNode(N0Opc, DL, VT, Concat0, Concat1);
        }
    }
    let mut IsRSHRN: Closure_58 = Closure_58 {};
    if N.getNumOperands() == 2 && IsRSHRN.call(N0) && ((IsRSHRN.call(N1) && N0.getConstantOperandVal(1) == N1.getConstantOperandVal(1)) || N1.isUndef()) {
        let mut X: SDValue = N0.getOperand(0).getOperand(0);
        let mut Y: SDValue = if N1.isUndef() { DAG.getUNDEF(X.getValueType()) } else { N1.getOperand(0).getOperand(0) };
        let mut BVT: EVT = X.getValueType().getDoubleNumVectorElementsVT(*DCI.DAG.getContext());
        let mut CC: SDValue = DAG.getNode(CONCAT_VECTORS, DL, BVT, X, Y);
        let mut Add: SDValue = DAG.getNode(ADD, DL, BVT, CC, DAG.getConstant(1 << (N0.getConstantOperandVal(1) - 1), DL, BVT, false, false));
        let mut Shr: SDValue = DAG;
        return Shr;
    }
    if  {
        let mut E0: SDValue = DAG.getNode(CONCAT_VECTORS, DL, VT, N0.getOperand(0), DAG.getPOISON(N0.getValueType()));
        let mut E1: SDValue = DAG.getNode(CONCAT_VECTORS, DL, VT, N0.getOperand(1), DAG.getPOISON(N0.getValueType()));
        return DAG;
    }
    if N.getNumOperands() == 2 && N0 == N1 && VT.getVectorNumElements() == 2 {
        assert!(VT.getScalarSizeInBits() == 64);
        return DAG;
    }
    if N.getNumOperands() != 2 || N1Opc != BITCAST {
        return SDValue {};
    }
    let mut RHS: SDValue = operator(N1).getOperand(0);
    let mut RHSTy: MVT = RHS.getValueType().getSimpleVT();
    if !RHSTy.isVector() {
        return SDValue {};
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
            dbgs() << "aarch64-lower: concat_vectors bitcast simplification\n";
        }
    }
        if !(false) { break; }
    }
    let mut ConcatTy: MVT = getVectorVT(RHSTy.getVectorElementType(), RHSTy.getVectorNumElements() * 2);
    return DAG.getNode(BITCAST, DL, VT, DAG.getNode(CONCAT_VECTORS, DL, ConcatTy, DAG.getNode(BITCAST, DL, RHSTy, N0), RHS));
}

fn performExtractSubvectorCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut V: SDValue = N.getOperand(0);
    if VT.isScalableVector() != operator(V).getValueType(0).isScalableVector() {
        return SDValue {};
    }
    if V.getOpcode() == SPLAT_VECTOR {
        if isa(V.getOperand(0)) {
            return DAG.getNode(SPLAT_VECTOR, N, VT, V.getOperand(0));
        }
    }
    return SDValue {};
}

fn performInsertSubvectorCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Vec: SDValue = N.getOperand(0);
    let mut SubVec: SDValue = N.getOperand(1);
    let mut IdxVal: u64 = N.getConstantOperandVal(2);
    let mut VecVT: EVT = Vec.getValueType();
    let mut SubVT: EVT = SubVec.getValueType();
    if VecVT.isScalableVector() && SubVT.isFixedLengthVector() && Vec.isUndef() {
        let mut SplatVal: SDValue = DAG.getSplatValue(SubVec, false);
        if  {
            return DAG(DL, VecVT);
        }
        if  {
            return DAG(DL, VecVT);
        }
    }
    if !VecVT.isFixedLengthVector() || !DAG.getTargetLoweringInfo().isTypeLegal(VecVT) || !DAG.getTargetLoweringInfo().isTypeLegal(SubVT) {
        return SDValue {};
    }
    if IdxVal == 0 && Vec.isUndef() {
        return SDValue {};
    }
    let mut NumSubElts: u32 = SubVT.getVectorNumElements();
    if (SubVT.getSizeInBits() * 2) != VecVT.getSizeInBits() || (IdxVal != 0 && IdxVal != NumSubElts) {
        return SDValue {};
    }
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    if IdxVal == 0 {
        Lo = SubVec;
        Hi = DAG.getExtractSubvector(DL, SubVT, Vec, NumSubElts);
    } else {
        Lo = DAG.getExtractSubvector(DL, SubVT, Vec, 0);
        Hi = SubVec;
    }
    return DAG.getNode(CONCAT_VECTORS, DL, VecVT, Lo, Hi);
}

fn tryCombineFixedPointConvert(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut Op1: SDValue = N.getOperand(1);
    if Op1.getOpcode() != EXTRACT_VECTOR_ELT {
        return SDValue {};
    }
    let mut IID: SDValue = N.getOperand(0);
    let mut Shift: SDValue = N.getOperand(2);
    let mut Vec: SDValue = Op1.getOperand(0);
    let mut Lane: SDValue = Op1.getOperand(1);
    let mut ResTy: EVT = N.getValueType(0);
    let mut VecResTy: EVT = EVT {};
    let mut DL: SDLoc = N;
    if Vec.getValueSizeInBits().operator unsigned long long() != 128 {
        return SDValue {};
    }
    if Vec.getValueType() == v4i32 {
        VecResTy = v4f32;
    } else if Vec.getValueType() == v2i64 {
        VecResTy = v2f64;
    } else {
        return SDValue {};
    }
    let mut Convert: SDValue = DAG.getNode(INTRINSIC_WO_CHAIN, DL, VecResTy, IID, Vec, Shift);
    return DAG.getNode(EXTRACT_VECTOR_ELT, DL, ResTy, Convert, Lane);
}

fn tryExtendDUPToExtractHigh(N: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: MVT = N.getSimpleValueType();
    if N.getOpcode() == EXTRACT_SUBVECTOR && N.getConstantOperandVal(1) == 0 {
        N = N.getOperand(0);
    }
    match N.getOpcode() {
        _ => {
            return SDValue {};
        },
    }
    if !VT.is64BitVector() {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut NumElems: u32 = VT.getVectorNumElements();
    if N.getValueType().is64BitVector() {
        let mut ElementTy: MVT = VT.getVectorElementType();
        let mut NewVT: MVT = getVectorVT(ElementTy, NumElems * 2);
        N = DAG.getNode(operator(N).getOpcode(), DL, NewVT, operator(N).ops());
    }
    return DAG.getExtractSubvector(DL, VT, N, NumElems);
}

fn isEssentiallyExtractHighSubvector(N: SDValue) -> bool {
    if N.getOpcode() == BITCAST {
        N = N.getOperand(0);
    }
    if N.getOpcode() != EXTRACT_SUBVECTOR {
        return false;
    }
    if N.getOperand(0).getValueType().isScalableVector() {
        return false;
    }
    return N.getConstantOperandAPInt(1) == N.getOperand(0).getValueType().getVectorNumElements() / 2;
}

struct GenericSetCCInfo {
    Opnd0: *SDValue,
    Opnd1: *SDValue,
    CC: CondCode,
}

struct AArch64SetCCInfo {
    Cmp: *SDValue,
    CC: CondCode,
}

struct SetCCInfo {
    Generic: GenericSetCCInfo,
    AArch64: AArch64SetCCInfo,
}

struct SetCCInfoAndKind {
    Info: SetCCInfo,
    IsAArch64: bool,
}

fn isSetCC(Op: SDValue, SetCCInfo: *mut SetCCInfoAndKind) -> bool {
    if Op.getOpcode() == SETCC {
        SetCCInfo.Info.Generic.Opnd0 = &mut Op.getOperand(0);
        SetCCInfo.Info.Generic.Opnd1 = &mut Op.getOperand(1);
        SetCCInfo.Info.Generic.CC = cast(Op.getOperand(2))();
        SetCCInfo.IsAArch64 = false;
        return true;
    }
    if  {
        return false;
    }
    SetCCInfo.Info.AArch64.Cmp = &mut Op.getOperand(3);
    SetCCInfo.IsAArch64 = true;
    SetCCInfo.Info.AArch64.CC = Op.getConstantOperandVal(2) as CondCode;
    let mut TValue: *mut ConstantSDNode = dyn_cast(Op.getOperand(0));
    let mut FValue: *mut ConstantSDNode = dyn_cast(Op.getOperand(1));
    if !TValue || !FValue {
        return false;
    }
    if !TValue.isOne() {
        swap(TValue, FValue);
        SetCCInfo.Info.AArch64.CC = getInvertedCondCode(SetCCInfo.Info.AArch64.CC);
    }
    return TValue.isOne() && FValue.isZero();
}

fn isSetCCOrZExtSetCC(Op: *SDValue, Info: *mut SetCCInfoAndKind) -> bool {
    if isSetCC(Op, Info) {
        return true;
    }
    return ((Op.getOpcode() == ZERO_EXTEND) && isSetCC(operator(Op).getOperand(0), Info));
}

fn performSetccAddFolding(Op: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op && Op.getOpcode() == ADD, "Unexpected operation!");
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    let mut InfoAndKind: SetCCInfoAndKind = SetCCInfoAndKind {};
    if isSetCCOrZExtSetCC(LHS, InfoAndKind) && isSetCCOrZExtSetCC(RHS, InfoAndKind) {
        return SDValue {};
    }
    if !isSetCCOrZExtSetCC(LHS, InfoAndKind) {
        swap(LHS, RHS);
        if !isSetCCOrZExtSetCC(LHS, InfoAndKind) {
            return SDValue {};
        }
    }
    let mut CmpVT: EVT = if InfoAndKind.IsAArch64 { InfoAndKind.Info.AArch64.Cmp.getOperand(0).getValueType() } else { InfoAndKind.Info.Generic.Opnd0.getValueType() };
    if CmpVT != i32 && CmpVT != i64 {
        return SDValue {};
    }
    let mut CCVal: SDValue = SDValue {};
    let mut Cmp: SDValue = SDValue {};
    let mut DL: SDLoc = Op;
    if InfoAndKind.IsAArch64 {
        CCVal = DAG.getConstant(getInvertedCondCode(InfoAndKind.Info.AArch64.CC), DL, i32, false, false);
        Cmp = *InfoAndKind.Info.AArch64.Cmp;
    } else {
        Cmp = getAArch64Cmp(*InfoAndKind.Info.Generic.Opnd0, *InfoAndKind.Info.Generic.Opnd1, getSetCCInverse(InfoAndKind.Info.Generic.CC, CmpVT), CCVal, DAG, DL);
    }
    let mut VT: EVT = Op.getValueType(0);
    LHS = DAG.getNode(ADD, DL, VT, RHS, DAG.getConstant(1, DL, VT, false, false));
    return DAG;
}

fn performAddUADDVCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if N.getOpcode() != ADD || !VT.isScalarInteger() {
        return SDValue {};
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    if LHS.getOpcode() != EXTRACT_VECTOR_ELT || RHS.getOpcode() != EXTRACT_VECTOR_ELT || LHS.getValueType() != VT {
        return SDValue {};
    }
    let mut LHSN1: *mut auto = dyn_cast(operator(LHS).getOperand(1));
    let mut RHSN1: *mut auto = dyn_cast(operator(RHS).getOperand(1));
    if operator!() ||  !=  || operator!() {
        return SDValue {};
    }
    let mut Op1: SDValue = operator(LHS).getOperand(0);
    let mut Op2: SDValue = operator(RHS).getOperand(0);
    let mut OpVT1: EVT = Op1.getValueType();
    let mut OpVT2: EVT = Op2.getValueType();
    if  {
        return SDValue {};
    }
    let mut Val1: SDValue = Op1.getOperand(0);
    let mut Val2: SDValue = Op2.getOperand(0);
    let mut ValVT: EVT = operator(Val1).getValueType(0);
    let mut DL: SDLoc = N;
    let mut AddVal: SDValue = DAG.getNode(ADD, DL, ValVT, Val1, Val2);
    return DAG.getExtractVectorElt(DL, VT, DAG, 0);
}

fn performAddCSelIntoCSinc(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isScalarInteger() || N.getOpcode() != ADD {
        return SDValue {};
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    if  {
        swap(LHS, RHS);
        if  {
            return SDValue {};
        }
    }
    if !LHS.hasOneUse() {
        return SDValue {};
    }
    let mut AArch64CC: CondCode = LHS.getConstantOperandVal(2) as CondCode;
    let mut CTVal: *mut ConstantSDNode = dyn_cast(LHS.getOperand(0));
    let mut CFVal: *mut ConstantSDNode = dyn_cast(LHS.getOperand(1));
    if !CTVal || !CFVal {
        return SDValue {};
    }
    if  {
        return SDValue {};
    }
    if  {
        swap(CTVal, CFVal);
        AArch64CC = getInvertedCondCode(AArch64CC);
    }
    let mut DL: SDLoc = N;
    if  {
        let mut C: APInt = -1 * CFVal.getAPIntValue();
        CTVal = cast(DAG.getConstant(C, DL, VT, false, false));
        CFVal = cast(DAG.getAllOnesConstant(DL, VT, false, false));
        AArch64CC = getInvertedCondCode(AArch64CC);
    }
    let mut ADDC: APInt = CTVal.getAPIntValue();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isLegalAddImmediate(ADDC.getSExtValue()) {
        return SDValue {};
    }
    let mut NewNode: SDValue = DAG.getNode(ADD, DL, VT, RHS, SDValue { Node: CTVal, ResNo: 0 });
    let mut CCVal: SDValue = getCondCode(DAG, AArch64CC);
    let mut Cmp: SDValue = LHS.getOperand(3);
    return DAG;
}

fn performAddDotCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if N.getOpcode() != ADD {
        return SDValue {};
    }
    let mut Dot: SDValue = N.getOperand(0);
    let mut A: SDValue = N.getOperand(1);
    let mut isZeroDot: Closure_59 = Closure_59 {};
    if isZeroDot.call(Dot) {
        swap(Dot, A);
    }
    if isZeroDot.call(Dot) {
        return SDValue {};
    }
    return DAG.getNode(Dot.getOpcode(), N, VT, A, Dot.getOperand(1), Dot.getOperand(2));
}

fn isNegatedInteger(Op: SDValue) -> bool {
    return Op.getOpcode() == SUB && isNullConstant(Op.getOperand(0));
}

fn performNegCSelCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if !isNegatedInteger(SDValue { Node: N, ResNo: 0 }) {
        return SDValue {};
    }
    let mut CSel: SDValue = N.getOperand(1);
    if  {
        return SDValue {};
    }
    let mut N0: SDValue = CSel.getOperand(0);
    let mut N1: SDValue = CSel.getOperand(1);
    if !isNegatedInteger(N0) && !isNegatedInteger(N1) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut VT: EVT = CSel.getValueType();
    let mut N0N: SDValue = DAG.getNegative(N0, DL, VT);
    let mut N1N: SDValue = DAG.getNegative(N1, DL, VT);
    return DAG;
}

fn reassociateAddSubLong(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if VT != v8i16 && VT != v4i32 && VT != v2i64 {
        return SDValue {};
    }
    let mut HalfEltVT: EVT = getIntegerVT(VT.getScalarSizeInBits() / 2);
    return SDValue {};
}

fn performAddSubLongCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut VT: MVT = N.getSimpleValueType(0);
    if !VT.is128BitVector() {
        if N.getOpcode() == ADD {
            return performSetccAddFolding(N, DAG);
        }
        return SDValue {};
    }
    if reassociateAddSubLong(N, DAG) {
        R;
    } else {
        return R;
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    if (LHS.getOpcode() != ZERO_EXTEND && LHS.getOpcode() != SIGN_EXTEND) || LHS.getOpcode() != RHS.getOpcode() {
        return SDValue {};
    }
    let mut ExtType: u32 = LHS.getOpcode();
    if isEssentiallyExtractHighSubvector(LHS.getOperand(0)) {
        RHS = tryExtendDUPToExtractHigh(RHS.getOperand(0), DAG);
        if !RHS.getNode() {
            return SDValue {};
        }
        RHS = DAG.getNode(ExtType, N, VT, RHS);
    } else if isEssentiallyExtractHighSubvector(RHS.getOperand(0)) {
        LHS = tryExtendDUPToExtractHigh(LHS.getOperand(0), DAG);
        if !LHS.getNode() {
            return SDValue {};
        }
        LHS = DAG.getNode(ExtType, N, VT, LHS);
    }
    return DAG.getNode(N.getOpcode(), N, VT, LHS, RHS);
}

fn isCMP(Op: SDValue) -> bool {}

fn getCSETCondCode(Op: SDValue) -> CondCode> {
    if  {
        return nullopt();
    }
    let mut CC: CondCode = Op.getConstantOperandVal(2) as CondCode;
    if CC == AL || CC == NV {
        return nullopt();
    }
    let mut OpLHS: SDValue = Op.getOperand(0);
    let mut OpRHS: SDValue = Op.getOperand(1);
    if isOneConstant(OpLHS) && isNullConstant(OpRHS) {
        return CC;
    }
    if isNullConstant(OpLHS) && isOneConstant(OpRHS) {
        return getInvertedCondCode(CC);
    }
    return nullopt();
}

fn foldOverflowCheck(Op: *mut SDNode, DAG: *mut SelectionDAG, IsAdd: bool) -> SDValue {
    let mut CmpOp: SDValue = Op.getOperand(2);
    if !isCMP(CmpOp) {
        return SDValue {};
    }
    if IsAdd {
        if !isOneConstant(CmpOp.getOperand(1)) {
            return SDValue {};
        }
    } else {
        if !isNullConstant(CmpOp.getOperand(0)) {
            return SDValue {};
        }
    }
    let mut CsetOp: SDValue = operator(CmpOp).getOperand(if IsAdd { 0 } else { 1 });
    let mut CC: auto = zeroed();
    if CC() != (if IsAdd { HS } else { LO }) {
        return SDValue {};
    }
    return DAG.getNode(Op.getOpcode(), Op, Op.getVTList(), Op.getOperand(0), Op.getOperand(1), CsetOp.getOperand(3));
}

fn foldADCToCINC(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Cond: SDValue = N.getOperand(2);
    if !isNullConstant(RHS) {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    let mut CC: SDValue = getCondCode(DAG, LO);
    return DAG;
}

fn performAddSubCarryCombine(N: *mut SDNode, DAG: *mut SelectionDAG, NewOpcode: u32) -> SDValue {
    if isAllOnesConstant(N.getOperand(1)) {
        let mut DL: SDLoc = N;
        let mut RHS: SDValue = DAG.getConstant(0, DL, N.getValueType(0), false, false);
        return DAG.getNode(NewOpcode, DL, N.getVTList(), N.getOperand(0), RHS, N.getOperand(2));
    }
    return SDValue {};
}

fn performBuildVectorCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    if DAG() && (VT == v4f16 || VT == v4bf16) {
        let mut Elt0: SDValue = N.getOperand(0);
        let mut Elt1: SDValue = N.getOperand(1);
        let mut Elt2: SDValue = N.getOperand(2);
        let mut Elt3: SDValue = N.getOperand(3);
        if operator(Elt0).getOpcode() == FP_ROUND && operator(Elt1).getOpcode() == FP_ROUND && isa(operator(Elt0).getOperand(1)) && isa(operator(Elt1).getOperand(1)) && operator(Elt0).getConstantOperandVal(1) == operator(Elt1).getConstantOperandVal(1) && operator(operator(Elt0).getOperand(0)).getOpcode() == EXTRACT_VECTOR_ELT && operator(operator(Elt1).getOperand(0)).getOpcode() == EXTRACT_VECTOR_ELT && isa(operator(operator(Elt0).getOperand(0)).getOperand(1)) && isa(operator(operator(Elt1).getOperand(0)).getOperand(1)) && operator(operator(Elt0).getOperand(0)).getOperand(0) == operator(operator(Elt1).getOperand(0)).getOperand(0) && operator(operator(Elt0).getOperand(0)).getConstantOperandVal(1) == 0 && operator(operator(Elt1).getOperand(0)).getConstantOperandVal(1) == 1 {
            let mut LowLanesSrcVec: SDValue = operator(operator(Elt0).getOperand(0)).getOperand(0);
            if LowLanesSrcVec.getValueType() == v2f64 {
                let mut HighLanes: SDValue = SDValue {};
                if operator(Elt2).isUndef() && operator(Elt3).isUndef() {
                    HighLanes = DAG.getPOISON(v2f32);
                } else if operator(Elt2).getOpcode() == FP_ROUND && operator(Elt3).getOpcode() == FP_ROUND && isa(operator(Elt2).getOperand(1)) && isa(operator(Elt3).getOperand(1)) && operator(Elt2).getConstantOperandVal(1) == operator(Elt3).getConstantOperandVal(1) && operator(operator(Elt2).getOperand(0)).getOpcode() == EXTRACT_VECTOR_ELT && operator(operator(Elt3).getOperand(0)).getOpcode() == EXTRACT_VECTOR_ELT && isa(operator(operator(Elt2).getOperand(0)).getOperand(1)) && isa(operator(operator(Elt3).getOperand(0)).getOperand(1)) && operator(operator(Elt2).getOperand(0)).getOperand(0) == operator(operator(Elt3).getOperand(0)).getOperand(0) && operator(operator(Elt2).getOperand(0)).getConstantOperandVal(1) == 0 && operator(operator(Elt3).getOperand(0)).getConstantOperandVal(1) == 1 {
                    let mut HighLanesSrcVec: SDValue = operator(operator(Elt2).getOperand(0)).getOperand(0);
                    HighLanes = DAG;
                }
                if HighLanes {
                    let mut DoubleToSingleSticky: SDValue = DAG;
                    let mut Concat: SDValue = DAG.getNode(CONCAT_VECTORS, DL, v4f32, DoubleToSingleSticky, HighLanes);
                    return DAG.getNode(FP_ROUND, DL, VT, Concat, operator(Elt0).getOperand(1));
                }
            }
        }
    }
    if VT == v2f64 {
        let mut Elt0: SDValue = N.getOperand(0);
        let mut Elt1: SDValue = N.getOperand(1);
        if operator(Elt0).getOpcode() == FP_EXTEND && operator(Elt1).getOpcode() == FP_EXTEND && operator(operator(Elt0).getOperand(0)).getOpcode() == EXTRACT_VECTOR_ELT && operator(operator(Elt1).getOperand(0)).getOpcode() == EXTRACT_VECTOR_ELT && operator(operator(Elt0).getOperand(0)).getOperand(0) == operator(operator(Elt1).getOperand(0)).getOperand(0) && isa(operator(operator(Elt0).getOperand(0)).getOperand(1)) && isa(operator(operator(Elt1).getOperand(0)).getOperand(1)) && operator(operator(Elt0).getOperand(0)).getConstantOperandVal(1) + 1 == operator(operator(Elt1).getOperand(0)).getConstantOperandVal(1) && operator(operator(Elt0).getOperand(0)).getConstantOperandVal(1) % VT.getVectorMinNumElements() == 0 {
            let mut SrcVec: SDValue = operator(operator(Elt0).getOperand(0)).getOperand(0);
            if SrcVec.getValueType() == v4f16 || SrcVec.getValueType() == v4bf16 {
                let mut HalfToSingle: SDValue = DAG.getNode(FP_EXTEND, DL, v4f32, SrcVec);
                let mut SubvectorIdx: SDValue = operator(operator(Elt0).getOperand(0)).getOperand(1);
                let mut Extract: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, VT.changeVectorElementType(*DAG.getContext(), f32), HalfToSingle, SubvectorIdx);
                return DAG.getNode(FP_EXTEND, DL, VT, Extract);
            }
        }
    }
    if VT != v2i32 {
        return SDValue {};
    }
    let mut Elt0: SDValue = N.getOperand(0);
    let mut Elt1: SDValue = N.getOperand(1);
    if operator(Elt0).getOpcode() == EXTRACT_VECTOR_ELT && operator(Elt1).getOpcode() == EXTRACT_VECTOR_ELT && isa(operator(Elt0).getOperand(1)) && isa(operator(Elt1).getOperand(1)) && operator(Elt0).getOperand(0) == operator(Elt1).getOperand(0) && operator(Elt0).getConstantOperandVal(1) + 1 == operator(Elt1).getConstantOperandVal(1) && operator(Elt0).getConstantOperandVal(1) % VT.getVectorMinNumElements() == 0 {
        let mut VecToExtend: SDValue = operator(Elt0).getOperand(0);
        let mut ExtVT: EVT = VecToExtend.getValueType().changeVectorElementType(*DAG.getContext(), i32);
        if !DAG.getTargetLoweringInfo().isTypeLegal(ExtVT) {
            return SDValue {};
        }
        let mut Ext: SDValue = DAG.getNode(ANY_EXTEND, DL, ExtVT, VecToExtend);
        return DAG.getExtractSubvector(DL, v2i32, Ext, operator(Elt0).getConstantOperandVal(1));
    }
    return SDValue {};
}

fn trySQDMULHCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != SMIN {
        return SDValue {};
    }
    let mut DestVT: EVT = N.getValueType(0);
    if !DestVT.isVector() || DestVT.getScalarSizeInBits() > 64 || DestVT.isScalableVector() {
        return SDValue {};
    }
    let mut Clamp: *mut ConstantSDNode = isConstOrConstSplat(N.getOperand(1), false, false);
    if !Clamp {
        return SDValue {};
    }
    let mut ScalarType: MVT = MVT {};
    let mut ShiftAmt: u32 = 0;
    match Clamp.getSExtValue() {
        (1 << 15) - 1 => {
            ScalarType = i16;
        },
        (1 << 31) - 1 => {
            ScalarType = i32;
        },
        _ => {
            return SDValue {};
        },
    }
    let mut Sra: SDValue = N.getOperand(0);
    if Sra.getOpcode() != SRA || !Sra.hasOneUse() {
        return SDValue {};
    }
    let mut RightShiftVec: *mut ConstantSDNode = isConstOrConstSplat(Sra.getOperand(1), false, false);
    if !RightShiftVec {
        return SDValue {};
    }
    let mut SExtValue: u32 = RightShiftVec.getSExtValue();
    if SExtValue != (ShiftAmt - 1) {
        return SDValue {};
    }
    let mut Mul: SDValue = Sra.getOperand(0);
    if Mul.getOpcode() != MUL {
        return SDValue {};
    }
    let mut SExt0: SDValue = Mul.getOperand(0);
    let mut SExt1: SDValue = Mul.getOperand(1);
    if SExt0.getOpcode() != SIGN_EXTEND || SExt1.getOpcode() != SIGN_EXTEND {
        return SDValue {};
    }
    let mut SExt0Type: EVT = SExt0.getOperand(0).getValueType();
    let mut SExt1Type: EVT = SExt1.getOperand(0).getValueType();
    if SExt0Type != SExt1Type || SExt0Type.getScalarType() != ScalarType || SExt0Type.getFixedSizeInBits() > 128 || !SExt0Type.isPow2VectorType() || SExt0Type.getVectorNumElements() == 1 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut V0: SDValue = SExt0.getOperand(0);
    let mut V1: SDValue = SExt1.getOperand(0);
    if SExt0Type.getFixedSizeInBits() < 64 {
        let mut VecNumElements: u32 = SExt0Type.getVectorNumElements();
        let mut ExtVecVT: EVT = getVectorVT(getIntegerVT(64 / VecNumElements), VecNumElements);
        V0 = DAG.getNode(SIGN_EXTEND, DL, ExtVecVT, V0);
        V1 = DAG.getNode(SIGN_EXTEND, DL, ExtVecVT, V1);
    }
    let mut SQDMULH: SDValue = DAG;
    return DAG.getNode(SIGN_EXTEND, DL, DestVT, SQDMULH);
}

fn performTruncateCombine(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    if DCI.isAfterLegalizeDAG() && N0.getOpcode() == OR && N0.hasOneUse() {
        let mut SrcVT: EVT = N0.getValueType();
        let mut EltSize: u32 = SrcVT.getScalarSizeInBits();
        if ((VT == v8i8 && SrcVT == v8i16) || (VT == v4i16 && SrcVT == v4i32) || (VT == v2i32 && SrcVT == v2i64)) && DAG.ComputeNumSignBits(N0.getOperand(0), 0) == EltSize && DAG.ComputeNumSignBits(N0.getOperand(1), 0) == EltSize {
            return DAG;
        }
    }
    if  {
        let mut Op: SDValue = N0.getOperand(0);
        if VT.getScalarType() == i32 && N0.getOperand(0).getValueType().getScalarType() == i64 {
            Op = DAG.getNode(TRUNCATE, DL, i32, Op);
        }
        return DAG.getNode(N0.getOpcode(), DL, VT, Op);
    }
    if DCI.isAfterLegalizeDAG() && N0.getOpcode() == EXTRACT_VECTOR_ELT && N0.hasOneUse() {
        let mut Op: SDValue = N0.getOperand(0);
        let mut ExtractIndexNode: SDValue = N0.getOperand(1);
        if !isa(ExtractIndexNode) {
            return SDValue {};
        }
        assert!((VT == i32 && N0.getValueType() == i64), "Unexpected legalisation result!");
        let mut SrcVectorType: EVT = Op.getValueType();
        assert!((SrcVectorType == v2i64 || SrcVectorType == nxv2i64), "Unexpected legalisation result!");
        let mut ExtractIndex: u32 = cast(ExtractIndexNode)();
        let mut CastVT: MVT = if SrcVectorType.isScalableVector() { nxv4i32 } else { v4i32 };
        Op = DAG;
        return DAG.getExtractVectorElt(DL, VT, Op, ExtractIndex * 2);
    }
    if !DCI.isBeforeLegalizeOps() && N0.getOpcode() == BUILD_VECTOR && N0.hasOneUse() && (VT == v8i8 || VT == v4i16) {
        return DAG.getBuildVector(VT, DL, operator(N0).ops());
    }
    return SDValue {};
}

fn isExtendOrShiftOperand(N: SDValue) -> bool {
    let mut Opcode: u32 = N.getOpcode();
    if isExtOpcode(Opcode) || Opcode == SIGN_EXTEND_INREG {
        let mut SrcVT: EVT = EVT {};
        if Opcode == SIGN_EXTEND_INREG {
            SrcVT = cast(N.getOperand(1))();
        } else {
            SrcVT = N.getOperand(0).getValueType();
        }
        return SrcVT == i32 || SrcVT == i16 || SrcVT == i8;
    } else if Opcode == AND {
        let mut CSD: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if !CSD {
            return false;
        }
        let mut AndMask: u64 = CSD.getZExtValue();
        return AndMask == 255 || AndMask == 65535 || AndMask == 4294967295;
    } else if Opcode == SHL || Opcode == SRL || Opcode == SRA {
        return isa(N.getOperand(1));
    }
    return false;
}

fn performAddCombineSubShift(N: *mut SDNode, SUB: SDValue, Z: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsOneUseExtend: Closure_60 = Closure_60 {};
    if isa(Z) || IsOneUseExtend.call(Z) {
        return SDValue {};
    }
    if SUB.getOpcode() != SUB || !SUB.hasOneUse() {
        return SDValue {};
    }
    let mut Shift: SDValue = SUB.getOperand(0);
    if !IsOneUseExtend.call(Shift) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Y: SDValue = SUB.getOperand(1);
    let mut NewSub: SDValue = DAG.getNode(SUB, DL, VT, Z, Y);
    return DAG.getNode(ADD, DL, VT, NewSub, Shift);
}

fn performAddCombineForShiftedOperands(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != ADD {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    if performAddCombineSubShift(N, LHS, RHS, DAG) {
        Val;
    } else {
        return Val;
    }
    if performAddCombineSubShift(N, RHS, LHS, DAG) {
        Val;
    } else {
        return Val;
    }
    let mut LHSImm: u64 = 0;
    let mut RHSImm: u64 = 0;
    if isOpcWithIntImmediate(LHS.getNode(), SHL, LHSImm) && isOpcWithIntImmediate(RHS.getNode(), SHL, RHSImm) && LHSImm <= 4 && RHSImm > 4 && LHS.hasOneUse() {
        return DAG.getNode(ADD, DL, VT, RHS, LHS);
    }
    return SDValue {};
}

fn performNegSignMaskedAndCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != SUB || !isNullConstant(N.getOperand(0)) {
        return SDValue {};
    }
    let mut And: SDValue = N.getOperand(1);
    if And.getOpcode() != AND || !And.hasOneUse() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return SDValue {};
    }
    if any_of(N.users(), Closure_61 {}) {
        return SDValue {};
    }
    let mut NumBits: u32 = VT.getScalarSizeInBits();
    let mut X: SDValue = And.getOperand(0);
    let mut Mask: SDValue = And.getOperand(1);
    if DAG.ComputeNumSignBits(Mask, 0) != NumBits {
        swap(X, Mask);
        if DAG.ComputeNumSignBits(Mask, 0) != NumBits {
            return SDValue {};
        }
    }
    let mut DL: SDLoc = N;
    return DAG.getNode(AND, DL, VT, DAG.getNegative(X, DL, VT), Mask);
}

fn performSubAddMULCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != SUB {
        return SDValue {};
    }
    let mut Add: SDValue = N.getOperand(1);
    let mut X: SDValue = N.getOperand(0);
    if Add.getOpcode() != ADD {
        return SDValue {};
    }
    if !Add.hasOneUse() {
        return SDValue {};
    }
    if DAG.isConstantIntBuildVectorOrConstantInt(X, true) {
        return SDValue {};
    }
    let mut M1: SDValue = Add.getOperand(0);
    let mut M2: SDValue = Add.getOperand(1);
    if  {
        return SDValue {};
    }
    if  {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut Sub: SDValue = DAG.getNode(SUB, N, VT, X, M1);
    return DAG.getNode(SUB, N, VT, Sub, M2);
}

fn performSVEMulAddSubCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    if !DCI.isAfterLegalizeDAG() {
        return SDValue {};
    }
    if operator!(DAG()) {
        return SDValue {};
    }
    if N.getOpcode() != ADD && N.getOpcode() != SUB {
        return SDValue {};
    }
    if !N.getValueType(0).isFixedLengthVector() {
        return SDValue {};
    }
    let mut performOpt: Closure_62 = Closure_62 { DAG: &mut DAG, N: &mut N };
    if performOpt.call(N.getOperand(0), N.getOperand(1)) {
        res;
    } else {
        return res;
    }
    return SDValue {};
}

fn performAddSubIntoVectorOp(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if VT != i64 || DAG.getTargetLoweringInfo().isOperationExpand(N.getOpcode(), v1i64) {
        return SDValue {};
    }
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    if Op0.getOpcode() != EXTRACT_VECTOR_ELT && Op0.getOpcode() != LOAD {
        return SDValue {};
    }
    if Op1.getOpcode() != EXTRACT_VECTOR_ELT && Op1.getOpcode() != LOAD {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    if Op0.getOpcode() == EXTRACT_VECTOR_ELT && Op0.getOperand(0).getValueType() == v1i64 {
        Op0 = Op0.getOperand(0);
        Op1 = DAG.getNode(SCALAR_TO_VECTOR, DL, v1i64, Op1);
    } else if Op1.getOpcode() == EXTRACT_VECTOR_ELT && Op1.getOperand(0).getValueType() == v1i64 {
        Op0 = DAG.getNode(SCALAR_TO_VECTOR, DL, v1i64, Op0);
        Op1 = Op1.getOperand(0);
    } else {
        return SDValue {};
    }
    return DAG.getExtractVectorElt(DL, i64, DAG.getNode(N.getOpcode(), DL, v1i64, Op0, Op1), 0);
}

fn isLoadOrMultipleLoads(B: SDValue, Loads: *mut i32) -> bool {
    let mut BV: SDValue = peekThroughOneUseBitcasts(B);
    if !operator(BV).hasOneUse() {
        return false;
    }
    if  {
        if operator!() || operator!() {
            return false;
        }
        Loads()();
        return true;
    } else if BV.getOpcode() == BUILD_VECTOR || BV.getOpcode() == CONCAT_VECTORS {
        for let mut Op: u32 = 0; Op < BV.getNumOperands(); Op += 1 {
            let mut Ld: *mut auto = dyn_cast(BV.getOperand(Op));
            if operator!() || operator!() || !BV.getOperand(Op).hasOneUse() {
                return false;
            }
            Loads()();
        }
        return true;
    } else if B.getOpcode() == VECTOR_SHUFFLE {
        if B.getOperand(0).getOpcode() != VECTOR_SHUFFLE || B.getOperand(0).getOperand(0).getOpcode() != CONCAT_VECTORS || B.getOperand(0).getOperand(1).getOpcode() != CONCAT_VECTORS || B.getOperand(1).getOpcode() != CONCAT_VECTORS || B.getOperand(1).getNumOperands() != 4 {
            return false;
        }
        let mut SV1: auto = cast(B);
        let mut SV2: auto = cast(B.getOperand(0));
        let mut NumElts: i32 = B.getValueType().getVectorNumElements();
        let mut NumSubElts: i32 = NumElts / 4;
        for let mut I: i32 = 0; I < NumSubElts; I += 1 {
            if SV1()(I) != I || (I + NumSubElts) != I + NumSubElts || (I + NumSubElts * 2) != I + NumSubElts * 2 || (I + NumSubElts * 3) != I + NumElts {
                return false;
            }
            if SV2()(I) != I || (I + NumSubElts) != I + NumSubElts || (I + NumSubElts * 2) != I + NumElts {
                return false;
            }
        }
        let mut Ld0: *mut auto = dyn_cast((0)(0));
        let mut Ld1: *mut auto = dyn_cast((0)(1));
        let mut Ld2: *mut auto = dyn_cast((1)(0));
        let mut Ld3: *mut auto = dyn_cast(B.getOperand(1).getOperand(0));
        if operator!() || operator!() || operator!() || operator!() || operator!() || operator!() || operator!() || operator!() {
            return false;
        }
        Loads()();
        Loads()();
        Loads()();
        Loads()();
        return true;
    }
    return false;
}

fn areLoadedOffsetButOtherwiseSame(Op0: SDValue, Op1: SDValue, DAG: *mut SelectionDAG, NumSubLoads: *mut u32) -> bool {
    if !Op0.hasOneUse() || !Op1.hasOneUse() {
        return false;
    }
    let mut Loads0: i32 = 0;
    if  {
        if NumSubLoads && () != NumSubLoads {
            return false;
        }
        NumSubLoads = ();
    }
    if Op0.getOpcode() != Op1.getOpcode() {
        return false;
    }
    match Op0.getOpcode() {
        ADD => {
            SUB;
        },
        SIGN_EXTEND => {
            ANY_EXTEND;
        },
    }
    return false;
}

fn performExtBinopLoadFold(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isFixedLengthVector() || (VT.getScalarSizeInBits() != 16 && VT.getScalarSizeInBits() != 32 && VT.getScalarSizeInBits() != 64) {
        return SDValue {};
    }
    let mut Other: SDValue = N.getOperand(0);
    let mut Shift: SDValue = N.getOperand(1);
    if Shift.getOpcode() != SHL && N.getOpcode() != SUB {
        swap(Shift, Other);
    }
    let mut ShiftAmt: APInt = APInt {};
    if Shift.getOpcode() != SHL || !Shift.hasOneUse() || !isConstantSplatVector(Shift.getOperand(1).getNode(), ShiftAmt) {
        return SDValue {};
    }
    if !isExtOpcode(Shift.getOperand(0).getOpcode()) || !isExtOpcode(Other.getOpcode()) || Shift.getOperand(0).getOperand(0).getValueType() != Other.getOperand(0).getValueType() || !Other.hasOneUse() || !Shift.getOperand(0).hasOneUse() {
        return SDValue {};
    }
    let mut Op0: SDValue = Other.getOperand(0);
    let mut Op1: SDValue = Shift.getOperand(0).getOperand(0);
    let mut NumSubLoads: u32 = 0;
    if !areLoadedOffsetButOtherwiseSame(Op0, Op1, DAG, NumSubLoads) {
        return SDValue {};
    }
    let mut NumElts: u32 = Op0.getValueType().getVectorNumElements();
    let mut NumSubElts: u32 = NumElts / NumSubLoads;
    if NumSubElts * VT.getScalarSizeInBits() < 128 || (Other.getOpcode() != Shift.getOperand(0).getOpcode() && Op0.getValueType().getSizeInBits().operator unsigned long long() < 128 && !DAG.getTargetLoweringInfo().isTypeLegal(Op0.getValueType())) {
        return SDValue {};
    }
    let mut GenCombinedTree: function<SDValue (SDValue, SDValue, SelectionDAG &)> = zeroed();
    let mut NewOp: SDValue = (Op0, Op1, DAG);
    let mut LowMask: i32 = NumElts;
    let mut Hi: i32 = NumSubElts;
    let mut Lo: i32 = 0;
    for let mut i: u32 = 0; i < NumSubLoads; i += 1 {
        for let mut j: u32 = 0; j < NumSubElts; j += 1 {
            LowMask()[i * NumSubElts + j] = Lo += 1;
        }
        Lo += NumSubElts;
        Hi += NumSubElts;
    }
    let mut DL: SDLoc = N;
    let mut Ext0: SDValue = SDValue {};
    let mut Ext1: SDValue = SDValue {};
    if Other.getOpcode() != Shift.getOperand(0).getOpcode() {
        let mut SubL: SDValue = DAG.getExtractSubvector(DL, Op0.getValueType(), NewOp, 0);
        let mut SubH: SDValue = DAG.getExtractSubvector(DL, Op0.getValueType(), NewOp, NumSubElts * NumSubLoads);
        let mut Extr0: SDValue = DAG.getVectorShuffle(Op0.getValueType(), DL, SubL, SubH);
        let mut Extr1: SDValue = DAG.getVectorShuffle;
        Ext0 = DAG.getNode(Other.getOpcode(), DL, VT, Extr0);
        Ext1 = DAG.getNode(Shift.getOperand(0).getOpcode(), DL, VT, Extr1);
    } else {
        let mut DVT: EVT = VT.getDoubleNumVectorElementsVT(*DAG.getContext());
        let mut Ext: SDValue = DAG.getNode(Other.getOpcode(), DL, DVT, NewOp);
        let mut SubL: SDValue = DAG.getExtractSubvector(DL, VT, Ext, 0);
        let mut SubH: SDValue = DAG.getExtractSubvector(DL, VT, Ext, NumSubElts * NumSubLoads);
        Ext0 = DAG.getVectorShuffle(VT, DL, SubL, SubH);
        Ext1 = DAG.getVectorShuffle;
    }
    let mut NShift: SDValue = DAG.getNode(Shift.getOpcode(), DL, VT, Ext1, Shift.getOperand(1));
    return DAG.getNode(N.getOpcode(), DL, VT, Ext0, NShift);
}

fn performAddMulZextCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !DCI.isAfterLegalizeDAG() || N.getOpcode() != ADD || VT != i64 {
        return SDValue {};
    }
    let mut Mul: SDValue = N.getOperand(0);
    let mut Other: SDValue = N.getOperand(1);
    if Mul.getOpcode() != MUL {
        swap(Mul, Other);
    }
    if Mul.getOpcode() != MUL {
        return SDValue {};
    }
    if !Mul.hasOneUse() || Mul.getOperand(0).getOpcode() != ZERO_EXTEND || !isa(Mul.getOperand(1)) {
        return SDValue {};
    }
    let mut C: i64 = Mul.getConstantOperandVal(1);
    if C > 0 || C < -4294967295 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut NMul: SDValue = DCI.DAG.getNode(MUL, DL, VT, Mul.getOperand(0), DCI.DAG.getConstant(-C, DL, i64, false, false));
    return DCI.DAG.getNode(SUB, DL, VT, Other, NMul);
}

fn performSubWithBorrowCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != SUB {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return SDValue {};
    }
    let mut N1: SDValue = N.getOperand(1);
    if N1.getOpcode() == ZERO_EXTEND && N1.hasOneUse() {
        N1 = N1.getOperand(0);
    }
    let mut CC: auto = zeroed();
    if !N1.hasOneUse() || (CC() != LO &&  != HI) {
        return SDValue {};
    }
    let mut Flags: SDValue = N1.getOperand(3);
    if  {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut CanFoldSub: bool = N0.getOpcode() == SUB;
    if CC() == HI {
        if !Flags.hasOneUse() {
            return SDValue {};
        }
        let mut RHSC: *mut auto = dyn_cast(Flags.getOperand(1));
        if (!CanFoldSub || !N0.hasOneUse()) &&  && isLegalCmpImmed() {
            return SDValue {};
        }
        Flags = DAG(1);
    }
    let mut DL: SDLoc = N;
    if CanFoldSub {
        return DAG;
    }
    return DAG;
}

fn performAddTruncShiftCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if VT != v2i32 && VT != v4i16 && VT != v8i8 {
        return SDValue {};
    }
    let mut AShr: SDValue = SDValue {};
    let mut LShr: SDValue = SDValue {};
    if operator!(sd_match(N, m_Add(m_Trunc(m_Value(AShr)), m_Trunc(m_Value(LShr))))) {
        return SDValue {};
    }
    if  {
        swap(AShr, LShr);
    }
    if  {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, VT, AShr);
    let mut Shift: SDValue = DAG;
    return DAG.getNode(ADD, DL, VT, Trunc, Shift);
}

fn performSubNegAndOneCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != SUB {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !VT.isFixedLengthVector() {
        return SDValue {};
    }
    let mut Zero: SDValue = N.getOperand(0);
    let mut And: SDValue = N.getOperand(1);
    if !isZerosVector(Zero.getNode()) || And.getOpcode() != AND || !isOneVector(And.getOperand(1)) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    return DAG.getSetCC(DL, VT, And, DAG.getConstant(0, DL, VT, false, false), SETNE, SDValue {}, false, None);
}

fn performAddAddCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != ADD {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !VT.isScalarInteger() {
        return SDValue {};
    }
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    if Op0.getOpcode() == ADD && Op0.hasOneUse() && (Op0.getOperand(0) == Op1 || Op0.getOperand(1) == Op1) {
        A = if (Op0.getOperand(0) == Op1) { Op0.getOperand(1) } else { Op0.getOperand(0) };
        B = Op1;
    } else if Op1.getOpcode() == ADD && Op1.hasOneUse() && (Op1.getOperand(0) == Op0 || Op1.getOperand(1) == Op0) {
        A = if (Op1.getOperand(0) == Op0) { Op1.getOperand(1) } else { Op1.getOperand(0) };
        B = Op0;
    } else {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut ShiftB: SDValue = DAG.getNode(SHL, DL, VT, B, DAG.getConstant(1, DL, VT, false, false));
    return DAG.getNode(ADD, DL, VT, A, ShiftB);
}

fn performAddWithSBCCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != ADD {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return SDValue {};
    }
    let mut SBC: SDValue = N.getOperand(0);
    let mut C: SDValue = N.getOperand(1);
    if  {
        swap(SBC, C);
    }
    if  {
        return SDValue {};
    }
    if !isNullConstant(SBC.getOperand(1)) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    return DAG;
}

fn performConditionalSubCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOpcode() != SUB {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != i32 && VT != i64 {
        return SDValue {};
    }
    let mut X: SDValue = N.getOperand(0);
    let mut Sel: SDValue = N.getOperand(1);
    if  {
        return SDValue {};
    }
    let mut Flags: SDValue = Sel.getOperand(3);
    if  {
        return SDValue {};
    }
    let mut Q: SDValue = Flags.getOperand(1);
    let mut ZeroOnTrue: bool = isNullConstant(Sel.getOperand(0)) && Sel.getOperand(1) == Q;
    let mut ZeroOnFalse: bool = isNullConstant(Sel.getOperand(1)) && Sel.getOperand(0) == Q;
    if !ZeroOnTrue && !ZeroOnFalse {
        return SDValue {};
    }
    let mut Diff: SDValue = Flags.getValue(0);
    return DAG;
}

fn performAddSubCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    if performAddAddCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performAddUADDVCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performAddDotCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performAddCSelIntoCSinc(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performNegCSelCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performVectorExtCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performAddCombineForShiftedOperands(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performNegSignMaskedAndCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performSubAddMULCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performSVEMulAddSubCombine(N, DCI) {
        Val;
    } else {
        return Val;
    }
    if performAddSubIntoVectorOp(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performSubWithBorrowCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performConditionalSubCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performAddTruncShiftCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performSubNegAndOneCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performAddWithSBCCombine(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performExtBinopLoadFold(N, DCI.DAG) {
        Val;
    } else {
        return Val;
    }
    if performAddMulZextCombine(N, DCI) {
        Val;
    } else {
        return Val;
    }
    return performAddSubLongCombine(N, DCI);
}

fn tryCombineLongOpWithDup(IID: u32, N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut LHS: SDValue = N.getOperand(if (IID == not_intrinsic) { 0 } else { 1 });
    let mut RHS: SDValue = N.getOperand(if (IID == not_intrinsic) { 1 } else { 2 });
    assert!(LHS.getValueType().is64BitVector() && RHS.getValueType().is64BitVector(), "unexpected shape for long operation");
    if isEssentiallyExtractHighSubvector(LHS) {
        RHS = tryExtendDUPToExtractHigh(RHS, DAG);
        if !RHS.getNode() {
            return SDValue {};
        }
    } else if isEssentiallyExtractHighSubvector(RHS) {
        LHS = tryExtendDUPToExtractHigh(LHS, DAG);
        if !LHS.getNode() {
            return SDValue {};
        }
    } else {
        return SDValue {};
    }
    if IID == not_intrinsic {
        return DAG.getNode(N.getOpcode(), N, N.getValueType(0), LHS, RHS);
    }
    return DAG.getNode(INTRINSIC_WO_CHAIN, N, N.getValueType(0), N.getOperand(0), LHS, RHS);
}

fn tryCombineShiftImm(IID: u32, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut ElemTy: MVT = N.getSimpleValueType(0).getScalarType();
    let mut ElemBits: u32 = ElemTy.getSizeInBits().operator unsigned long long();
    let mut ShiftAmount: i64 = 0;
    if dyn_cast(N.getOperand(2)) {
        BVN;
    } else {
        let mut SplatValue: APInt = APInt {};
        let mut SplatUndef: APInt = APInt {};
        let mut SplatBitSize: u32 = 0;
        let mut HasAnyUndefs: bool = false;
        if !BVN.isConstantSplat(SplatValue, SplatUndef, SplatBitSize, HasAnyUndefs, ElemBits, false) || SplatBitSize != ElemBits {
            return SDValue {};
        }
        ShiftAmount = SplatValue.getSExtValue();
    }
    if  {
        return N.getOperand(1);
    }
    let mut Opcode: u32 = 0;
    let mut IsRightShift: bool = false;
    match IID {
        _ => {
            llvm_unreachable_internal("Unknown shift intrinsic", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 24845);
        },
    }
    let mut VT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(1);
    let mut DL: SDLoc = N;
    if VT == i64 {
        Op = DAG.getNode(SCALAR_TO_VECTOR, DL, v1i64, Op);
        VT = v1i64;
    }
    if IsRightShift && ShiftAmount <= -1 && ShiftAmount >= -ElemBits as i32 {
        Op = DAG.getNode(Opcode, DL, VT, Op, DAG.getSignedConstant(-ShiftAmount, DL, i32, true, false));
        if N.getValueType(0) == i64 {
            Op = DAG.getExtractVectorElt(DL, i64, Op, 0);
        }
        return Op;
    } else if !IsRightShift && ShiftAmount >= 0 && ShiftAmount < ElemBits {
        Op = DAG.getNode(Opcode, DL, VT, Op, DAG.getTargetConstant(ShiftAmount, DL, i32, false));
        if N.getValueType(0) == i64 {
            Op = DAG.getExtractVectorElt(DL, i64, Op, 0);
        }
        return Op;
    }
    return SDValue {};
}

fn tryCombineCRC32(Mask: u32, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut AndN: SDValue = N.getOperand(2);
    if AndN.getOpcode() != AND {
        return SDValue {};
    }
    let mut CMask: *mut ConstantSDNode = dyn_cast(AndN.getOperand(1));
    if !CMask || CMask.getZExtValue() != Mask {
        return SDValue {};
    }
    return DAG.getNode(INTRINSIC_WO_CHAIN, N, i32, N.getOperand(0), N.getOperand(1), AndN.getOperand(0));
}

fn combineAcrossLanesIntrinsic(Opc: u32, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    return DAG.getExtractVectorElt(DL, N.getValueType(0), DAG.getNode(Opc, DL, N.getOperand(1).getSimpleValueType(), N.getOperand(1)), 0);
}

fn LowerSVEIntrinsicIndex(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Op1: SDValue = N.getOperand(1);
    let mut Op2: SDValue = N.getOperand(2);
    let mut ScalarTy: EVT = Op2.getValueType();
    if (ScalarTy == i8) || (ScalarTy == i16) {
        ScalarTy = i32;
    }
    let mut StepVector: SDValue = DAG.getStepVector(DL, N.getValueType(0));
    let mut Step: SDValue = DAG.getNode(SPLAT_VECTOR, DL, N.getValueType(0), Op2);
    let mut Mul: SDValue = DAG.getNode(MUL, DL, N.getValueType(0), StepVector, Step);
    let mut Base: SDValue = DAG.getNode(SPLAT_VECTOR, DL, N.getValueType(0), Op1);
    return DAG.getNode(ADD, DL, N.getValueType(0), Mul, Base);
}

fn LowerSVEIntrinsicDUP(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Scalar: SDValue = N.getOperand(3);
    let mut ScalarTy: EVT = Scalar.getValueType();
    if (ScalarTy == i8) || (ScalarTy == i16) {
        Scalar = DAG.getNode(ANY_EXTEND, DL, i32, Scalar);
    }
    let mut Passthru: SDValue = N.getOperand(1);
    let mut Pred: SDValue = N.getOperand(2);
    return DAG;
}

fn LowerSVEIntrinsicEXT(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    let mut VT: EVT = N.getValueType(0);
    assert!(VT.isScalableVector(), "Expected a scalable vector.");
    if VT.getSizeInBits().getKnownMinValue() != SVEBitsPerBlock {
        return SDValue {};
    }
    let mut ElemSize: u32 = VT.getVectorElementType().getSizeInBits().operator unsigned long long() / 8;
    let mut ByteSize: u32 = VT.getSizeInBits().getKnownMinValue() / 8;
    let mut ByteVT: EVT = getVectorVT(Ctx, i8, getScalable(ByteSize));
    let mut Op0: SDValue = DAG.getNode(BITCAST, DL, ByteVT, N.getOperand(1));
    let mut Op1: SDValue = DAG.getNode(BITCAST, DL, ByteVT, N.getOperand(2));
    let mut Op2: SDValue = DAG.getNode(MUL, DL, i32, N.getOperand(3), DAG.getConstant(ElemSize, DL, i32, false, false));
    let mut EXT: SDValue = DAG;
    return DAG.getNode(BITCAST, DL, VT, EXT);
}

fn tryConvertSVEWideCompare(N: *mut SDNode, CC: CondCode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut Comparator: SDValue = N.getOperand(3);
    if  {
        let mut IID: u32 = getIntrinsicID(N);
        let mut VT: EVT = N.getValueType(0);
        let mut CmpVT: EVT = N.getOperand(2).getValueType();
        let mut Pred: SDValue = N.getOperand(1);
        let mut Imm: SDValue = SDValue {};
        let mut DL: SDLoc = N;
        match IID {
            _ => {
                llvm_unreachable_internal("Called with wrong intrinsic!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 25006);
            },
        }
        if !Imm {
            return SDValue {};
        }
        let mut Splat: SDValue = DAG.getNode(SPLAT_VECTOR, DL, CmpVT, Imm);
        return DAG;
    }
    return SDValue {};
}

fn getPTest(DAG: *mut SelectionDAG, VT: EVT, Pg: SDValue, Op: SDValue, Cond: CondCode) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = Op;
    assert!(Op.getValueType().isScalableVector() && TLI.isTypeLegal(Op.getValueType()), "Expected legal scalable vector type!");
    assert!(Op.getValueType() == Pg.getValueType(), "Expected same type for PTEST operands");
    let mut OutVT: EVT = TLI.getTypeToTransformTo(*DAG.getContext(), VT);
    let mut TVal: SDValue = DAG.getConstant(1, DL, OutVT, false, false);
    let mut FVal: SDValue = DAG.getConstant(0, DL, OutVT, false, false);
    if Op.getValueType() != nxv16i1 {
        if (Cond == ANY_ACTIVE || Cond == NONE_ACTIVE) && isZeroingInactiveLanes(Op) {
            Pg = DAG;
        } else {
            Pg = getSVEPredicateBitCast(nxv16i1, Pg, DAG);
        }
        Op = DAG;
    }
    let mut PTest: u32 = 0;
    let mut Test: SDValue = DAG.getNode(PTest, DL, i32, Pg, Op);
    let mut CC: SDValue = getCondCode(DAG, getInvertedCondCode(Cond));
    let mut Res: SDValue = DAG;
    return DAG.getZExtOrTrunc(Res, DL, VT);
}

fn combineSVEReductionInt(N: *mut SDNode, Opc: u32, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Pred: SDValue = N.getOperand(1);
    let mut VecToReduce: SDValue = N.getOperand(2);
    let mut ReduceVT: EVT = getPackedSVEVectorVT(N.getValueType(0));
    let mut Reduce: SDValue = DAG.getNode(Opc, DL, ReduceVT, Pred, VecToReduce);
    return DAG.getExtractVectorElt(DL, N.getValueType(0), Reduce, 0);
}

fn combineSVEReductionFP(N: *mut SDNode, Opc: u32, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Pred: SDValue = N.getOperand(1);
    let mut VecToReduce: SDValue = N.getOperand(2);
    let mut ReduceVT: EVT = VecToReduce.getValueType();
    let mut Reduce: SDValue = DAG.getNode(Opc, DL, ReduceVT, Pred, VecToReduce);
    return DAG.getExtractVectorElt(DL, N.getValueType(0), Reduce, 0);
}

fn combineSVEReductionOrderedFP(N: *mut SDNode, Opc: u32, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Pred: SDValue = N.getOperand(1);
    let mut InitVal: SDValue = N.getOperand(2);
    let mut VecToReduce: SDValue = N.getOperand(3);
    let mut ReduceVT: EVT = VecToReduce.getValueType();
    InitVal = DAG.getInsertVectorElt(DL, DAG.getPOISON(ReduceVT), InitVal, 0);
    let mut Reduce: SDValue = DAG.getNode(Opc, DL, ReduceVT, Pred, InitVal, VecToReduce);
    return DAG.getExtractVectorElt(DL, N.getValueType(0), Reduce, 0);
}

fn tryCombineNeonFcvtFP16ToI16(N: *mut SDNode, Opcode: u32, DAG: *mut SelectionDAG) -> SDValue {
    if N.getValueType(0) != i16 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut CVT: SDValue = DAG.getNode(Opcode, DL, f32, N.getOperand(1));
    let mut Bitcast: SDValue = DAG.getBitcast(i32, CVT);
    return DAG.getNode(TRUNCATE, DL, i16, Bitcast);
}

fn convertMergedOpToPredOp(N: *mut SDNode, Opc: u32, DAG: *mut SelectionDAG, UnpredOp: bool, SwapOperands: bool) -> SDValue {
    assert!(N.getOpcode() == INTRINSIC_WO_CHAIN, "Expected intrinsic!");
    assert!(N.getNumOperands() == 4, "Expected 3 operand intrinsic!");
    let mut Pg: SDValue = N.getOperand(1);
    let mut Op1: SDValue = N.getOperand(if SwapOperands { 3 } else { 2 });
    let mut Op2: SDValue = N.getOperand(if SwapOperands { 2 } else { 3 });
    if isAllActivePredicate(DAG, Pg) {
        if UnpredOp {
            return DAG.getNode(Opc, N, N.getValueType(0), Op1, Op2);
        }
        return DAG.getNode(Opc, N, N.getValueType(0), Pg, Op1, Op2);
    }
    return SDValue {};
}

fn combineSVEBitSel(IID: u32, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut Op2: SDValue = N.getOperand(2);
    let mut Op3: SDValue = N.getOperand(3);
    match IID {
        _ => {
            llvm_unreachable_internal("Called with wrong intrinsic!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 25190);
        },
    }
}

fn tryCombineFADDReductionWithZero(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget, Vec: SDValue, Start: SDValue) -> SDValue {
    let mut VT: EVT = Vec.getValueType();
    if !VT.isFixedLengthVector() {
        return SDValue {};
    }
    let mut EltVT: EVT = VT.getVectorElementType();
    if EltVT != f32 && EltVT != f64 && operator!((EltVT == f16 && Subtarget()())) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut NumElts: u32 = VT.getVectorNumElements();
    if !isPowerOf2_32(NumElts) {
        return SDValue {};
    }
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut IsSignedZeroSafe: bool = Flags.hasNoSignedZeros() || DAG.canIgnoreSignBitOfZero(SDValue { Node: N, ResNo: 0 });
    let mut EltBitWidth: u32 = EltVT.getSizeInBits().operator unsigned long long();
    let mut ZeroMask: APInt = if IsSignedZeroSafe { getSignedMaxValue(EltBitWidth) } else { getAllOnes(EltBitWidth) };
    let mut KnownZeroElts: APInt = getZero(NumElts);
    for let mut I: u32 = 0; I < NumElts; I += 1 {
        let mut DemandedElt: APInt = getOneBitSet(NumElts, I);
        let mut KB: KnownBits = DAG.computeKnownBits(Vec, DemandedElt, 0);
        if ZeroMask.isSubsetOf(KB.Zero) {
            KnownZeroElts.setBit(I);
        }
    }
    let mut NumZeroElts: u32 = KnownZeroElts.popcount();
    if NumZeroElts == NumElts {
        if !Start {
            return DAG.getConstantFP(0.0, DL, EltVT, false);
        }
        if IsSignedZeroSafe {
            return Start;
        }
        return DAG.getNode(FADD, DL, EltVT, Start, DAG.getConstantFP(0.0, DL, EltVT, false));
    }
    let mut MinZeroElts: u32 = 0;
    match NumElts {
        2 => {
            4;
        },
        8 => {
            MinZeroElts = 3;
        },
        _ => {
            MinZeroElts = NumElts / 2;
        },
    }
    if NumZeroElts < MinZeroElts {
        return SDValue {};
    }
    if !IsSignedZeroSafe {
        return SDValue {};
    }
    if Start {
        let mut Acc: SDValue = Start;
        for let mut I: u32 = 0; I < NumElts; I += 1 {
            if KnownZeroElts[I] {
                continue;
            }
            let mut Elt: SDValue = DAG.getExtractVectorElt(DL, EltVT, Vec, I);
            Acc = DAG.getNode(FADD, DL, EltVT, Acc, Elt, Flags);
        }
        return Acc;
    }
    let mut Elts: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for let mut I: u32 = 0; I < NumElts; I += 1 {
        Elts.push(DAG.getExtractVectorElt(DL, EltVT, Vec, I));
    }
    while Elts.len > 1 {
        let mut NewElts: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
        let mut NewKnownZeroElts: APInt = getZero(Elts.len / 2);
        for let mut I: u32 = 0; I < Elts.len; I += 2 {
            let mut ZeroI: bool = KnownZeroElts[I];
            let mut ZeroI1: bool = KnownZeroElts[I + 1];
            if ZeroI && ZeroI1 {
                NewElts.push(Elts[I]);
                NewKnownZeroElts.setBit(I / 2);
            } else if ZeroI {
                NewElts.push(Elts[I + 1]);
            } else if ZeroI1 {
                NewElts.push(Elts[I]);
            } else {
                NewElts.push(DAG.getNode(FADD, DL, EltVT, Elts[I], Elts[I + 1], Flags));
            }
        }
        Elts = move(NewElts);
        KnownZeroElts = NewKnownZeroElts;
    }
    return Elts[0];
}

fn getPredCounterWhileElementSize(IID: ID) -> u32 {
    match IID {
        _ => {
            llvm_unreachable_internal("Unexpected IID", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 25362);
        },
    }
}

fn getPredCounterWhileOpcode(IID: ID) -> u32 {
    match IID {
        _ => {
            llvm_unreachable_internal("Unexpected IID", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 25410);
        },
    }
}

fn lowerPredCounterWhile(IID: ID, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut ElementSizeInBits: u32 = getPredCounterWhileElementSize(IID);
    return DAG.getNode(getPredCounterWhileOpcode(IID), DL, DAG.getVTList(aarch64svcount, FlagsVT), N.getOperand(1), N.getOperand(2), N.getOperand(3), DAG.getTargetConstant(ElementSizeInBits, DL, i64, false));
}

fn performIntrinsicCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut IID: u32 = getIntrinsicID(N);
    match IID {
        _ => {
            break;
        },
    }
    return SDValue {};
}

fn isCheapToExtend(N: *SDValue) -> bool {
    let mut OC: u32 = operator(N).getOpcode();
    return OC == LOAD || OC == MLOAD || isConstantSplatVectorAllZeros(N.getNode(), false);
}

fn performSignExtendSetCCCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    assert!(N.getOpcode() == SIGN_EXTEND && operator(N.getOperand(0)).getOpcode() == SETCC);
    let mut SetCC: SDValue = N.getOperand(0);
    let mut CCOp0: SDValue = SetCC.getOperand(0);
    let mut CCOp1: SDValue = SetCC.getOperand(1);
    if !operator(CCOp0).getValueType(0).isInteger() || !operator(CCOp1).getValueType(0).isInteger() {
        return SDValue {};
    }
    let mut Code: CondCode = cast(operator(SetCC).getOperand(2).getNode())();
    let mut ExtType: NodeType = if isSignedIntSetCC(Code) { SIGN_EXTEND } else { ZERO_EXTEND };
    if isCheapToExtend(SetCC.getOperand(0)) && isCheapToExtend(SetCC.getOperand(1)) {
        let mut Ext1: SDValue = DAG.getNode(ExtType, N, N.getValueType(0), CCOp0);
        let mut Ext2: SDValue = DAG.getNode(ExtType, N, N.getValueType(0), CCOp1);
        return DAG.getSetCC(SetCC, N.getValueType(0), Ext1, Ext2, cast(operator(SetCC).getOperand(2).getNode())());
    }
    return SDValue {};
}

fn performZExtDeinterleaveShuffleCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if (VT != v4i32 && VT != v8i16) || N.getOpcode() != ZERO_EXTEND || N.getOperand(0).getOpcode() != EXTRACT_SUBVECTOR {
        return SDValue {};
    }
    let mut ExtOffset: u32 = N.getOperand(0).getConstantOperandVal(1);
    if ExtOffset != 0 && ExtOffset != VT.getVectorNumElements() {
        return SDValue {};
    }
    let mut Shuffle: *mut auto = dyn_cast(N.getOperand(0).getOperand(0));
    if operator!() {
        return SDValue {};
    }
    let mut InVT: EVT = N.getOperand(0).getOperand(0).getValueType();
    assert!(InVT.isFixedLengthVector(), "Unexpected scalable shufflevector.");
    if InVT.getVectorNumElements() != VT.getVectorNumElements() * 2 || InVT.getScalarSizeInBits() * 2 != VT.getScalarSizeInBits() {
        return SDValue {};
    }
    let mut Idx: u32 = 0;
    let mut IsDeInterleave: bool = isDeInterleaveMaskOfFactor(()(ExtOffset, VT.getVectorNumElements()), 4, Idx);
    let mut IsUndefDeInterleave: bool = false;
    if !IsDeInterleave {
        IsUndefDeInterleave = (1)() && all_of(()(ExtOffset, VT.getVectorNumElements() / 2), Closure_63 {}) && isDeInterleaveMaskOfFactor(()(ExtOffset + VT.getVectorNumElements() / 2, VT.getVectorNumElements() / 2), 4, Idx);
    }
    if (!IsDeInterleave && !IsUndefDeInterleave) || Idx >= 4 {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut BC1: SDValue = DAG;
    let mut BC2: SDValue = DAG;
    let mut UZP: SDValue = DAG;
    if (Idx & 1) == 1 {
        UZP = DAG.getNode(SRL, DL, VT, UZP, DAG.getConstant(InVT.getScalarSizeInBits(), DL, VT, false, false));
    }
    return DAG.getNode(AND, DL, VT, UZP, DAG.getConstant((1 << InVT.getScalarSizeInBits()) - 1, DL, VT, false, false));
}

fn performZExtUZPCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if N.getOpcode() != ZERO_EXTEND || (VT != v2i64 && VT != v4i32 && VT != v8i16) {
        return SDValue {};
    }
    let mut Op: SDValue = N.getOperand(0);
    let mut ExtOffset: u32 = -1 as u32;
    if Op.getOpcode() == EXTRACT_SUBVECTOR {
        ExtOffset = Op.getConstantOperandVal(1);
        Op = Op.getOperand(0);
        if Op.getValueType().isScalableVector() {
            return SDValue {};
        }
    }
    let mut Shift: u32 = 0;
    let mut Mask: APInt = getLowBitsSet(VT.getScalarSizeInBits(), Op.getValueType().getScalarSizeInBits());
    if  {
        Shift = Op.getConstantOperandVal(1);
        Op = Op.getOperand(0);
        Mask = Mask.lshr(Shift);
    }
    if Op.getOpcode() == AND && isConstantSplatVector(Op.getOperand(1).getNode(), Mask) {
        Op = Op.getOperand(0);
        Mask = Mask.zext(VT.getScalarSizeInBits());
    } else if  {
        Mask = operator(APInt { Op.getValueType().getScalarSizeInBits(), Op.getConstantOperandVal(1) << Op.getConstantOperandVal(2), false, false });
        Mask = Mask.zext(VT.getScalarSizeInBits());
        Op = Op.getOperand(0);
    }
    if ExtOffset == -1 as u32 {
        if Op.getOpcode() == EXTRACT_SUBVECTOR {
            ExtOffset = Op.getConstantOperandVal(1);
            Op = Op.getOperand(0);
            if Op.getValueType().isScalableVector() {
                return SDValue {};
            }
        } else {
            return SDValue {};
        }
    }
    if ExtOffset != 0 && ExtOffset != VT.getVectorNumElements() {
        return SDValue {};
    }
    if  {
        return SDValue {};
    }
    if  {
        Shift += VT.getScalarSizeInBits() / 2;
    }
    let mut DL: SDLoc = N;
    let mut BC: SDValue = DAG;
    if Shift != 0 {
        BC = DAG;
    }
    return DAG.getNode(AND, DL, VT, BC, DAG.getConstant(Mask, DL, VT, false, false));
}

fn combineToExtendBoolVectorInReg(Opcode: u32, DL: *SDLoc, VT: EVT, N0: SDValue, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    if Opcode != SIGN_EXTEND && Opcode != ZERO_EXTEND && Opcode != ANY_EXTEND {
        return SDValue {};
    }
    if !DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    if operator!(Subtarget()()) {
        return SDValue {};
    }
    let mut SVT: EVT = VT.getScalarType();
    let mut InSVT: EVT = N0.getValueType().getScalarType();
    let mut EltSizeInBits: u32 = SVT.getSizeInBits().operator unsigned long long();
    if !VT.isVector() {
        return SDValue {};
    }
    if SVT != i64 && SVT != i32 && SVT != i16 && SVT != i8 {
        return SDValue {};
    }
    if InSVT != i1 || N0.getOpcode() != BITCAST {
        return SDValue {};
    }
    let mut N00: SDValue = N0.getOperand(0);
    let mut SclVT: EVT = N00.getValueType();
    if !SclVT.isScalarInteger() {
        return SDValue {};
    }
    let mut Vec: SDValue = SDValue {};
    let mut ShuffleMask: i32 = 0;
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!(NumElts == SclVT.getSizeInBits().operator unsigned long long(), "Unexpected bool vector size");
    let mut IsBE: bool = DAG.getDataLayout().isBigEndian();
    if NumElts > EltSizeInBits {
        assert!((NumElts % EltSizeInBits) == 0, "Unexpected integer scale");
        let mut Scale: u32 = NumElts / EltSizeInBits;
        let mut BroadcastVT: EVT = getVectorVT(*DAG.getContext(), SclVT, EltSizeInBits, false);
        Vec = DAG.getNode(SCALAR_TO_VECTOR, DL, BroadcastVT, N00);
        Vec = DAG.getBitcast(VT, Vec);
        for let mut I: u32 = 0; I != Scale; I += 1 {
            ShuffleMask()(EltSizeInBits, I as i32);
        }
        Vec = DAG.getVectorShuffle(VT, DL, Vec, Vec);
    } else {
        Vec = DAG.getSplat(VT, DL, DAG.getAnyExtOrTrunc(N00, DL, SVT));
    }
    let mut Bits: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    for let mut I: u32 = 0; I != NumElts; I += 1 {
        let mut ScalarBit: u32 = if IsBE { (NumElts - 1 - I) } else { I };
        let mut BitIdx: i32 = ScalarBit % EltSizeInBits;
        let mut Bit: APInt = getBitsSet(EltSizeInBits, BitIdx, BitIdx + 1);
        Bits.push(DAG.getConstant(Bit, DL, SVT, false, false));
    }
    let mut BitMask: SDValue = DAG;
    Vec = DAG.getNode(AND, DL, VT, Vec, BitMask);
    let mut CCVT: EVT = getVectorVT(*DAG.getContext(), i1, NumElts, false);
    Vec = DAG.getSetCC(DL, CCVT, Vec, BitMask, SETEQ, SDValue {}, false, None);
    Vec = DAG.getSExtOrTrunc(Vec, DL, VT);
    if Opcode == SIGN_EXTEND {
        return Vec;
    }
    return DAG.getNode(SRL, DL, VT, Vec, DAG.getConstant(EltSizeInBits - 1, DL, VT, false, false));
}

fn performExtendDuplaneTruncCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Dup: SDValue = N.getOperand(0);
    let mut DupOpc: u32 = Dup.getOpcode();
    if  {
        return SDValue {};
    }
    let mut Insert: SDValue = Dup.getOperand(0);
    if !Insert.hasOneUse() || Insert.getOpcode() != INSERT_SUBVECTOR || !Insert.getOperand(0).isUndef() || !isNullConstant(Insert.getOperand(2)) {
        return SDValue {};
    }
    let mut Trunc: SDValue = Insert.getOperand(1);
    if !Trunc.hasOneUse() || Trunc.getOpcode() != TRUNCATE {
        return SDValue {};
    }
    let mut Src: SDValue = Trunc.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut DstVT: EVT = N.getValueType(0);
    if SrcVT != DstVT || !SrcVT.is128BitVector() {
        return SDValue {};
    }
    let mut TruncVT: EVT = Trunc.getValueType();
    let mut SrcBits: u32 = SrcVT.getScalarSizeInBits();
    let mut TruncBits: u32 = TruncVT.getScalarSizeInBits();
    if N.getOpcode() == SIGN_EXTEND {
        if DAG.ComputeNumSignBits(Src, 0) <= SrcBits - TruncBits {
            return SDValue {};
        }
    } else if N.getOpcode() == ZERO_EXTEND {
        let mut Mask: APInt = getHighBitsSet(SrcBits, SrcBits - TruncBits);
        if !DAG.MaskedValueIsZero(Src, Mask, 0) {
            return SDValue {};
        }
    } else {
        assert!(N.getOpcode() == ANY_EXTEND);
    }
    let mut NewDupOpc: u32 = 0;
    match SrcVT.getScalarSizeInBits() {
        16 => {
            
        },
        32 => {
            
        },
        64 => {
            
        },
        _ => {
            return SDValue {};
        },
    }
    return DAG.getNode(NewDupOpc, N, DstVT, Src, Dup.getOperand(1));
}

fn performExtendToBoolVectorLoadCombine(N: *mut SDNode, DAG: *mut SelectionDAG, DCI: *mut DAGCombinerInfo, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut LN0: *mut auto = dyn_cast(N0);
    if operator!() || operator!(isNormalLoad()) || N0.getValueType().getScalarType() != i1 || !VT.isFixedLengthVector() {
        return SDValue {};
    }
    if !N0.hasOneUse() || operator!() {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut CanSplatOrSplit: bool = NumElts <= EltSizeInBits || NumElts % EltSizeInBits == 0;
    if Subtarget.isNeonAvailable() && CanSplatOrSplit {
        let mut ScalarVT: EVT = getIntegerVT(*DAG.getContext(), NumElts);
        let mut ScalarLd: SDValue = DAG(ScalarVT, DL);
        let mut Bitcast: SDValue = DAG.getBitcast((0), ScalarLd);
        if combineToExtendBoolVectorInReg(N.getOpcode(), DL, VT, Bitcast, DAG, DCI, Subtarget) {
            V;
        } else {
            DAG.ReplaceAllUsesOfValueWith(ScalarLd.getValue(1));
            return V;
        }
    }
    return SDValue {};
}

fn performExtendCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    if !DCI.isBeforeLegalizeOps() && N.getOpcode() == ZERO_EXTEND && N.getOperand(0).getValueType().is64BitVector() && (N.getOperand(0).getOpcode() == ABDU || N.getOperand(0).getOpcode() == ABDS) {
        let mut ABDNode: *mut SDNode = N.getOperand(0).getNode();
        let mut NewABD: SDValue = tryCombineLongOpWithDup(not_intrinsic, ABDNode, DCI, DAG);
        if !NewABD.getNode() {
            return SDValue {};
        }
        return DAG.getNode(ZERO_EXTEND, N, N.getValueType(0), NewABD);
    }
    if performZExtDeinterleaveShuffleCombine(N, DAG) {
        R;
    } else {
        return R;
    }
    if performZExtUZPCombine(N, DAG) {
        R;
    } else {
        return R;
    }
    let mut dl: SDLoc = N;
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if combineToExtendBoolVectorInReg(N.getOpcode(), dl, VT, N0, DAG, DCI, *Subtarget) {
        V;
    } else {
        return V;
    }
    if performExtendToBoolVectorLoadCombine(N, DAG, DCI, *Subtarget) {
        V;
    } else {
        return V;
    }
    if N.getValueType(0).isFixedLengthVector() && N.getOpcode() == SIGN_EXTEND && operator(N.getOperand(0)).getOpcode() == SETCC {
        return performSignExtendSetCCCombine(N, DCI, DAG);
    }
    let mut Bswap: SDValue = N.getOperand(0);
    if (N.getOpcode() == ANY_EXTEND || N.getOpcode() == ZERO_EXTEND) && Bswap.getOpcode() == BSWAP && Bswap.getValueType() == i16 && (N.getValueType(0) == i32 || N.getValueType(0) == i64) {
        let mut DL: SDLoc = N;
        let mut NewExtend: SDValue = DAG.getNode(N.getOpcode(), DL, N.getValueType(0), operator(Bswap).getOperand(0));
        return DAG;
    }
    if performExtendDuplaneTruncCombine(N, DAG) {
        R;
    } else {
        return R;
    }
    if  {
        return DAG;
    }
    return SDValue {};
}

fn splitStoreSplat(DAG: *mut SelectionDAG, St: *mut StoreSDNode, SplatVal: SDValue, NumVecElts: u32) -> SDValue {
    assert!(!St.isTruncatingStore(), "cannot split truncating vector store");
    let mut OrigAlignment: Align = St.getAlign();
    let mut EltOffset: u32 = SplatVal.getValueType().getSizeInBits().operator unsigned long long() / 8;
    let mut DL: SDLoc = &mut St;
    let mut BasePtr: SDValue = St.getBasePtr();
    let mut BaseOffset: u64 = 0;
    let mut PtrInfo: *MachinePointerInfo = St.getPointerInfo();
    let mut NewST1: SDValue = DAG.getStore(St.getChain(), DL, SplatVal, BasePtr, PtrInfo, OrigAlignment, St.getMemOperand().getFlags(), MMOMetadata {});
    if operator(BasePtr).getOpcode() == ADD && isa(operator(BasePtr).getOperand(1)) {
        BaseOffset = cast(operator(BasePtr).getOperand(1))();
        BasePtr = operator(BasePtr).getOperand(0);
    }
    let mut Offset: u32 = EltOffset;
    while NumVecElts -= 1 {
        let mut Alignment: Align = commonAlignment(OrigAlignment, Offset);
        let mut OffsetPtr: SDValue = DAG.getNode(ADD, DL, i64, BasePtr, DAG.getConstant(BaseOffset + Offset, DL, i64, false, false));
        NewST1 = DAG.getStore(NewST1.getValue(0), DL, SplatVal, OffsetPtr, PtrInfo.getWithOffset(Offset), Alignment, St.getMemOperand().getFlags(), MMOMetadata {});
        Offset += EltOffset;
    }
    return NewST1;
}

fn getSVEContainerType(ContentTy: EVT) -> MVT {
    assert!(ContentTy.isSimple(), "No SVE containers for extended types");
    match ContentTy.getSimpleVT().SimpleTy {
        _ => {
            llvm_unreachable_internal("No known SVE container for this MVT type", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 26324);
        },
        nxv2i8 => {
            nxv2i16;
        },
        nxv4i8 => {
            nxv4i16;
        },
        nxv8i8 => {
            nxv8i16;
        },
        nxv16i8 => {
            return nxv16i8;
        },
    }
}

fn performLD1Combine(N: *mut SDNode, DAG: *mut SelectionDAG, Opc: u32) -> SDValue {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    if VT.getSizeInBits().getKnownMinValue() > SVEBitsPerBlock {
        return SDValue {};
    }
    let mut ContainerVT: EVT = VT;
    if ContainerVT.isInteger() {
        ContainerVT = getSVEContainerType(ContainerVT);
    }
    let mut VTs: SDVTList = DAG.getVTList(ContainerVT, Other);
    let mut Ops: [4]SDValue = [N.getOperand(0), N.getOperand(2), N.getOperand(3), DAG.getValueType(VT)];
    let mut Load: SDValue = DAG;
    let mut LoadChain: SDValue = SDValue { Node: Load.getNode(), ResNo: 1 };
    if ContainerVT.isInteger() && (VT != ContainerVT) {
        Load = DAG.getNode(TRUNCATE, DL, VT, Load.getValue(0));
    }
    return DAG.getMergeValues([Load, LoadChain], DL);
}

fn performLDNT1Combine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut PtrTy: EVT = N.getOperand(3).getValueType();
    let mut LoadVT: EVT = VT;
    if VT.isFloatingPoint() {
        LoadVT = VT.changeTypeToInteger();
    }
    let mut MINode: *mut auto = cast(N);
    let mut PassThru: SDValue = DAG.getConstant(0, DL, LoadVT, false, false);
    let mut L: SDValue = DAG.getMaskedLoad(LoadVT, DL, (3), DAG.getPOISON(PtrTy), (2), PassThru, UNINDEXED, NON_EXTLOAD, false);
    if VT.isFloatingPoint() {
        let mut Ops: [2]SDValue = [DAG.getNode(BITCAST, DL, VT, L), L.getValue(1)];
        return DAG.getMergeValues;
    }
    return L;
}

