fn AArch64TargetLowering::SimplifyDemandedBitsForTargetNode(self: *AArch64TargetLowering, Op: SDValue, OriginalDemandedBits: *APInt, OriginalDemandedElts: *APInt, Known: *mut KnownBits, TLO: *mut TargetLoweringOpt, Depth: u32) -> bool {
    let mut Opc: u32 = Op.getOpcode();
    match Opc {
        INTRINSIC_WO_CHAIN => {
            let mut MaxCount: optional<ElementCount> = zeroed();
            if operator!() {
                return false;
            }
            let mut MaxSVEVectorSizeInBits: u32 = self.Subtarget.getMaxSVEVectorSizeInBits();
            if !MaxSVEVectorSizeInBits {
                MaxSVEVectorSizeInBits = SVEMaxBitsPerVector;
            }
            let mut VscaleMax: u32 = MaxSVEVectorSizeInBits / 128;
            let mut MaxValue: u32 = () * VscaleMax;
            let mut RequiredBits: u32 = bit_width(MaxValue);
            let mut BitWidth: u32 = Known.Zero.getBitWidth();
            if RequiredBits < BitWidth {
                Known.Zero.setHighBits(BitWidth - RequiredBits);
            }
            return false;
        },
    }
    return self.SimplifyDemandedBitsForTargetNode(Op, OriginalDemandedBits, OriginalDemandedElts, Known, TLO, Depth);
}

