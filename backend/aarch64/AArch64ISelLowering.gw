}

fn AArch64TargetLowering::shouldLowerReductionToSVE(self: *AArch64TargetLowering, RdxOp: SDValue, PairwiseOpIID: *mut ID>) -> bool {
    let mut SrcVT: EVT = RdxOp.getOperand(0).getValueType();
    if SrcVT.isScalableVector() {
        return true;
    }
    let mut OverrideNEON: bool = !self.Subtarget.isNeonAvailable() || RdxOp.getOpcode() == VECREDUCE_AND || RdxOp.getOpcode() == VECREDUCE_OR || RdxOp.getOpcode() == VECREDUCE_XOR || RdxOp.getOpcode() == VECREDUCE_FADD || (RdxOp.getOpcode() != VECREDUCE_ADD && SrcVT.getVectorElementType() == i64);
    let mut UseSVE: bool = self.useSVEForFixedLengthVectorVT(SrcVT, OverrideNEON);
    if self.Subtarget() || self.Subtarget.isStreamingSVEAvailable() {
        if SrcVT == v2i64 || (UseSVE && SrcVT == v2i32) {
            if (PairwiseOpIID = getPairwiseOpForReduction(RdxOp.getOpcode())) {
                UseSVE = true;
            }
        }
    }
    return UseSVE;
}

fn AArch64TargetLowering::LowerReductionToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VecOp: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = VecOp.getValueType();
    if SrcVT.isScalableVector() && Op.getOpcode() == VECREDUCE_ADD && VecOp.getOpcode() == ZERO_EXTEND {
        let mut BoolVec: SDValue = VecOp.getOperand(0);
        if BoolVec.getValueType().getVectorElementType() == i1 {
            let mut CntpOp: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, i64, DAG, BoolVec, BoolVec);
            return DAG.getAnyExtOrTrunc(CntpOp, DL, Op.getValueType());
        }
    }
    if SrcVT.isScalableVectorOf(i1) {
        return self.LowerPredReductionToSVE(Op, DAG);
    }
    let mut PairwiseOpIID: ID> = ID> {};
    if !self.shouldLowerReductionToSVE(Op, PairwiseOpIID) {
        return SDValue {};
    }
    if !SrcVT.isScalableVector() {
        let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, SrcVT);
        VecOp = convertToScalableVector(DAG, ContainerVT, VecOp);
    }
    let mut ResVT: EVT = SrcVT.getVectorElementType();
    let mut Pg: SDValue = getPredicateForVector(DAG, DL, SrcVT);
    let mut Rdx: SDValue = SDValue {};
    if PairwiseOpIID {
        Rdx = DAG.getNode(INTRINSIC_WO_CHAIN, DL, VecOp.getValueType(), DAG.getConstant(operator(PairwiseOpIID), DL, i32, false, false), Pg, VecOp, VecOp);
    } else {
        let mut RdxOpcode: u32 = getPredicatedReductionOpcode(Op.getOpcode());
        if  {
            ResVT = i64;
        }
        let mut RdxVT: EVT = SrcVT;
        if  {
            RdxVT = getPackedSVEVectorVT(ResVT);
        }
        Rdx = DAG.getNode(RdxOpcode, DL, RdxVT, Pg, VecOp);
    }
    let mut Res: SDValue = DAG.getExtractVectorElt(DL, ResVT, Rdx, 0);
    if ResVT != Op.getValueType() {
        Res = DAG.getAnyExtOrTrunc(Res, DL, Op.getValueType());
    }
    return Res;
}

fn AArch64TargetLowering::LowerFixedLengthVectorSelectToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut InVT: EVT = Op.getOperand(1).getValueType();
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, InVT);
    let mut Op1: SDValue = convertToScalableVector(DAG, ContainerVT, operator(Op).getOperand(1));
    let mut Op2: SDValue = convertToScalableVector(DAG, ContainerVT, operator(Op).getOperand(2));
    let mut MaskVT: EVT = Op.getOperand(0).getValueType();
    let mut MaskContainerVT: EVT = getContainerForFixedLengthVector(DAG, MaskVT);
    let mut Mask: SDValue = convertToScalableVector(DAG, MaskContainerVT, Op.getOperand(0));
    Mask = DAG.getNode(TRUNCATE, DL, MaskContainerVT.changeVectorElementType(*DAG.getContext(), i1), Mask);
    let mut ScalableRes: SDValue = DAG.getNode(VSELECT, DL, ContainerVT, Mask, Op1, Op2);
    return convertFromScalableVector(DAG, VT, ScalableRes);
}

fn AArch64TargetLowering::LowerFixedLengthVectorSetccToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut InVT: EVT = Op.getOperand(0).getValueType();
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, InVT);
    assert!(InVT.isFixedLengthVector() && self.isTypeLegal(InVT), "Only expected to lower fixed length vector operation!");
    assert!(Op.getValueType() == InVT.changeTypeToInteger(), "Expected integer result of the same bit length as the inputs!");
    let mut Op1: SDValue = convertToScalableVector(DAG, ContainerVT, Op.getOperand(0));
    let mut Op2: SDValue = convertToScalableVector(DAG, ContainerVT, Op.getOperand(1));
    let mut Pg: SDValue = getPredicateForFixedLengthVector(DAG, DL, InVT);
    let mut CmpVT: EVT = Pg.getValueType();
    let mut Cmp: auto = DAG;
    let mut PromoteVT: EVT = ContainerVT.changeTypeToInteger();
    let mut Promote: auto = DAG.getBoolExtOrTrunc(DL, PromoteVT, InVT);
    return convertFromScalableVector(DAG, Op.getValueType());
}

fn AArch64TargetLowering::LowerFixedLengthBitcastToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut SrcOp: SDValue = Op.getOperand(0);
    let mut VT: EVT = Op.getValueType();
    let mut ContainerDstVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut ContainerSrcVT: EVT = getContainerForFixedLengthVector(DAG, SrcOp.getValueType());
    SrcOp = convertToScalableVector(DAG, ContainerSrcVT, SrcOp);
    Op = DAG.getNode(BITCAST, DL, ContainerDstVT, SrcOp);
    return convertFromScalableVector(DAG, VT, Op);
}

fn AArch64TargetLowering::LowerFixedLengthConcatVectorsToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut NumOperands: u32 = operator(Op).getNumOperands();
    assert!(NumOperands > 1 && isPowerOf2_32(NumOperands), "Unexpected number of operands in CONCAT_VECTORS");
    let mut SrcOp1: SDValue = Op.getOperand(0);
    let mut SrcOp2: SDValue = Op.getOperand(1);
    let mut VT: EVT = Op.getValueType();
    let mut SrcVT: EVT = SrcOp1.getValueType();
    if SrcVT.is128BitVector() && all_equal(operator(Op).op_values()) {
        let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
        let mut Splat: SDValue = DAG;
        return convertFromScalableVector(DAG, VT, Splat);
    }
    if NumOperands > 2 {
        let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
        let mut PairVT: EVT = SrcVT.getDoubleNumVectorElementsVT(*DAG.getContext());
        for let mut I: u32 = 0; I < NumOperands; I += 2 {
            Ops.push(DAG.getNode(CONCAT_VECTORS, DL, PairVT, operator(Op).getOperand(I), operator(Op).getOperand(I + 1)));
        }
        return DAG;
    }
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut Pg: SDValue = getPredicateForFixedLengthVector(DAG, DL, SrcVT);
    SrcOp1 = convertToScalableVector(DAG, ContainerVT, SrcOp1);
    SrcOp2 = convertToScalableVector(DAG, ContainerVT, SrcOp2);
    Op = DAG;
    return convertFromScalableVector(DAG, VT, Op);
}

fn AArch64TargetLowering::LowerFixedLengthFPExtendToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut DL: SDLoc = Op;
    let mut Val: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = Val.getValueType();
    if VT.getScalarType() == f64 && SrcVT.getScalarType() == bf16 {
        return DAG.getNode(FP_EXTEND, DL, VT, DAG.getNode(FP_EXTEND, DL, VT.changeElementType(*DAG.getContext(), f32), Val));
    }
    let mut Pg: SDValue = getPredicateForVector(DAG, DL, VT);
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut ExtendVT: EVT = ContainerVT.changeVectorElementType(*DAG.getContext(), SrcVT.getVectorElementType());
    Val = DAG.getNode(BITCAST, DL, SrcVT.changeTypeToInteger(), Val);
    Val = DAG.getNode(ANY_EXTEND, DL, VT.changeTypeToInteger(), Val);
    Val = convertToScalableVector(DAG, ContainerVT.changeTypeToInteger(), Val);
    Val = self.getSVESafeBitCast(ExtendVT, Val, DAG);
    Val = DAG;
    return convertFromScalableVector(DAG, VT, Val);
}

fn AArch64TargetLowering::LowerFixedLengthFPRoundToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut DL: SDLoc = Op;
    let mut Val: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = Val.getValueType();
    let mut ContainerSrcVT: EVT = getContainerForFixedLengthVector(DAG, SrcVT);
    let mut RoundVT: EVT = ContainerSrcVT.changeVectorElementType(*DAG.getContext(), VT.getVectorElementType());
    Val = convertToScalableVector(DAG, ContainerSrcVT, Val);
    Val = DAG.getNode(Op.getOpcode(), DL, RoundVT, Val, Op.getOperand(1));
    Val = self.getSVESafeBitCast(ContainerSrcVT.changeTypeToInteger(), Val, DAG);
    Val = convertFromScalableVector(DAG, SrcVT.changeTypeToInteger(), Val);
    Val = DAG.getNode(TRUNCATE, DL, VT.changeTypeToInteger(), Val);
    return DAG.getNode(BITCAST, DL, VT, Val);
}

fn AArch64TargetLowering::LowerFixedLengthIntToFPToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut IsSigned: bool = Op.getOpcode() == SINT_TO_FP;
    let mut Opcode: u32 = 0;
    let mut DL: SDLoc = Op;
    let mut Val: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = Val.getValueType();
    let mut ContainerDstVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut ContainerSrcVT: EVT = getContainerForFixedLengthVector(DAG, SrcVT);
    if VT.bitsGE(SrcVT) {
        let mut Pg: SDValue = getPredicateForFixedLengthVector(DAG, DL, VT);
        Val = DAG.getNode(if IsSigned { SIGN_EXTEND } else { ZERO_EXTEND }, DL, VT.changeTypeToInteger(), Val);
        Val = convertToScalableVector(DAG, ContainerDstVT.changeTypeToInteger(), Val);
        Val = DAG.getNode(Opcode, DL, ContainerDstVT, Pg, Val, DAG.getPOISON(ContainerDstVT));
        return convertFromScalableVector(DAG, VT, Val);
    } else {
        let mut CvtVT: EVT = ContainerSrcVT.changeVectorElementType(*DAG.getContext(), ContainerDstVT.getVectorElementType());
        let mut Pg: SDValue = getPredicateForFixedLengthVector(DAG, DL, SrcVT);
        Val = convertToScalableVector(DAG, ContainerSrcVT, Val);
        Val = DAG.getNode(Opcode, DL, CvtVT, Pg, Val, DAG.getPOISON(CvtVT));
        Val = self.getSVESafeBitCast(ContainerSrcVT, Val, DAG);
        Val = convertFromScalableVector(DAG, SrcVT, Val);
        Val = DAG.getNode(TRUNCATE, DL, VT.changeTypeToInteger(), Val);
        return DAG.getNode(BITCAST, DL, VT, Val);
    }
}

fn lowerPredicateInterleaveWithPackedVectors(Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut OpVT: EVT = Op.getValueType();
    assert!(OpVT.isScalableVector() && OpVT.getVectorElementType() == i1 && operator(Op).getNumOperands() == 3, "Unexpected predicate interleave");
    let mut PackedVT: EVT = getPackedSVEVectorVT(OpVT.getVectorElementCount());
    let mut PackedOps: SmallVector<SDValue, 3> = zeroed();
    for V in operator(Op).ops() {
        PackedOps()(DAG.getNode(ZERO_EXTEND, DL, PackedVT, V));
    }
    let mut PackedVTs: SmallVector<EVT, 3> = zeroed();
    let mut PackedOp: SDValue = DAG(Op.getOpcode(), DL, DAG());
    let mut Zero: SDValue = DAG.getConstant(0, DL, PackedVT, false, false);
    let mut Results: SmallVector<SDValue, 3> = zeroed();
    for let mut I: u32 = 0; I != 3; I += 1 {
        Results()(DAG.getSetCC(DL, OpVT, PackedOp.getValue(I), Zero, SETNE, SDValue {}, false, None));
    }
    return DAG.getMergeValues(DL);
}

fn AArch64TargetLowering::LowerVECTOR_DEINTERLEAVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut OpVT: EVT = Op.getValueType();
    if OpVT.isFixedLengthVector() && operator(Op).getNumOperands() == 3 {
        let mut Alignment: Align = DAG.getReducedAlign(OpVT, false);
        let mut StackPtr: SDValue = DAG.CreateStackTemporary(OpVT.getStoreSize() * 3, Alignment);
        let mut Chains: SmallVector<SDValue, 3> = zeroed();
        for let mut I: u32 = 0; I < 3; I += 1 {
            let mut Ptr: SDValue = DAG.getMemBasePlusOffset(StackPtr, OpVT.getStoreSize() * I, DL, SDNodeFlags { Flags: None });
            Chains()(DAG.getStore(DAG.getEntryNode(), DL, Op.getOperand(I), Ptr, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {}));
        }
        let mut Ops: SmallVector<SDValue, 3> = zeroed();
        Ops()(DAG(TokenFactor, DL, Other));
        Ops()(DAG);
        Ops()(StackPtr);
        let mut TripleOpVT: EVT = getVectorVT(*DAG.getContext(), OpVT.getVectorElementType(), OpVT.getVectorNumElements() * 3, false);
        let mut VTs: SDVTList = DAG.getVTList(OpVT, OpVT, OpVT, Other);
        let mut LD3: SDValue = DAG(INTRINSIC_W_CHAIN, DL, VTs, TripleOpVT, MachinePointerInfo { 0, 0 }, Alignment, MOLoad);
        return DAG.getMergeValues([LD3.getValue(0), LD3.getValue(1), LD3.getValue(2)], DL);
    }
    if OpVT.isScalableVector() && operator(Op).getNumOperands() == 3 {
        if OpVT.getVectorElementType() == i1 {
            return lowerPredicateInterleaveWithPackedVectors(Op, DAG);
        }
        let mut PackedVT: EVT = getPackedSVEVectorVT(OpVT.getVectorElementCount());
        let mut Alignment: Align = DAG.getReducedAlign(PackedVT, false);
        let mut StackPtr: SDValue = DAG.CreateStackTemporary(PackedVT.getStoreSize() * 3, Alignment);
        let mut Chains: SmallVector<SDValue, 3> = zeroed();
        for let mut I: u32 = 0; I < 3; I += 1 {
            let mut Ptr: SDValue = DAG.getMemBasePlusOffset(StackPtr, PackedVT.getStoreSize() * I, DL, SDNodeFlags { Flags: None });
            let mut V: SDValue = self.getSVESafeBitCast(PackedVT, Op.getOperand(I), DAG);
            Chains()(DAG.getStore(DAG.getEntryNode(), DL, V, Ptr, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {}));
        }
        let mut IntID: ID = zeroed();
        let mut PredVT: EVT = PackedVT.changeVectorElementType(*DAG.getContext(), i1);
        let mut Ops: SmallVector<SDValue, 7> = zeroed();
        Ops()(DAG(TokenFactor, DL, Other));
        Ops()(DAG.getTargetConstant(IntID, DL, i64, false));
        Ops()(DAG.getConstant(1, DL, PredVT, false, false));
        Ops()(StackPtr);
        let mut VTs: SDVTList = DAG.getVTList(PackedVT, PackedVT, PackedVT, Other);
        let mut LD3: SDValue = DAG(INTRINSIC_W_CHAIN, DL, VTs);
        let mut Results: SmallVector<SDValue, 3> = zeroed();
        Results()(self.getSVESafeBitCast(OpVT, LD3.getValue(0), DAG));
        Results()(self.getSVESafeBitCast(OpVT, LD3.getValue(1), DAG));
        Results()(self.getSVESafeBitCast(OpVT, LD3.getValue(2), DAG));
        return DAG.getMergeValues(DL);
    }
    if self.Subtarget() && self.Subtarget.isStreaming() && OpVT.isScalableVector() && OpVT.getVectorElementType() != i1 {
        let mut IntID: ID = zeroed();
        match operator(Op).getNumOperands() {
            _ => {
                return SDValue {};
            },
            2 => {
                
            },
            4 => {
                if self.Subtarget.getMinSVEVectorSizeInBits() < 256 && OpVT.getScalarSizeInBits() == 64 {
                    return SDValue {};
                }
            },
        }
        let mut Ops: SmallVector<SDValue, 5> = zeroed();
        Ops()(DAG.getTargetConstant(IntID, DL, i64, false));
        Ops()(operator(Op).op_values().begin(), operator(Op).op_values().end());
        return DAG(INTRINSIC_WO_CHAIN, DL, operator(Op).getVTList());
    }
    if operator(Op).getNumOperands() != 2 {
        return SDValue {};
    }
    if OpVT == v1i64 || OpVT == v1f64 {
        return DAG.getMergeValues([Op.getOperand(0), Op.getOperand(1)], DL);
    }
    let mut Even: SDValue = DAG;
    let mut Odd: SDValue = DAG;
    return DAG.getMergeValues([Even, Odd], DL);
}

fn AArch64TargetLowering::LowerVECTOR_INTERLEAVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut OpVT: EVT = Op.getValueType();
    if OpVT.isFixedLengthVector() && operator(Op).getNumOperands() == 3 {
        let mut Alignment: Align = DAG.getReducedAlign(OpVT, false);
        let mut StackPtr: SDValue = DAG.CreateStackTemporary(OpVT.getStoreSize() * 3, Alignment);
        let mut StackPtrInfo: MachinePointerInfo = getFixedStack(DAG.getMachineFunction(), cast(StackPtr)());
        let mut Ops: SmallVector<SDValue, 6> = zeroed();
        Ops()(DAG.getEntryNode());
        Ops()(DAG);
        for V in operator(Op).ops() {
            Ops()(V);
        }
        Ops()(StackPtr);
        let mut TripleOpVT: EVT = getVectorVT(*DAG.getContext(), OpVT.getVectorElementType(), OpVT.getVectorNumElements() * 3, false);
        let mut Chain: SDValue = DAG(INTRINSIC_VOID, DL, DAG.getVTList(Other), TripleOpVT, StackPtrInfo, Alignment, MOStore);
        let mut Results: SmallVector<SDValue, 3> = zeroed();
        for let mut I: u32 = 0; I < 3; I += 1 {
            let mut Ptr: SDValue = DAG.getMemBasePlusOffset(StackPtr, OpVT.getStoreSize() * I, DL, SDNodeFlags { Flags: None });
            Results()(DAG.getLoad(OpVT, DL, Chain, Ptr, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {}));
        }
        return DAG.getMergeValues(DL);
    }
    if OpVT.isScalableVector() && operator(Op).getNumOperands() == 3 {
        if OpVT.getVectorElementType() == i1 {
            return lowerPredicateInterleaveWithPackedVectors(Op, DAG);
        }
        let mut PackedVT: EVT = getPackedSVEVectorVT(OpVT.getVectorElementCount());
        let mut InVecs: SmallVector<SDValue, 3> = zeroed();
        for V in operator(Op).ops() {
            InVecs()(self.getSVESafeBitCast(PackedVT, V, DAG));
        }
        let mut Alignment: Align = DAG.getReducedAlign(PackedVT, false);
        let mut StackPtr: SDValue = DAG.CreateStackTemporary(PackedVT.getStoreSize() * 3, Alignment);
        let mut StackPtrInfo: MachinePointerInfo = getFixedStack(DAG.getMachineFunction(), cast(StackPtr)());
        let mut IntID: ID = zeroed();
        let mut PredVT: EVT = PackedVT.changeVectorElementType(*DAG.getContext(), i1);
        let mut Ops: SmallVector<SDValue, 7> = zeroed();
        Ops()(DAG.getEntryNode());
        Ops()(DAG.getTargetConstant(IntID, DL, i64, false));
        Ops()();
        Ops()(DAG.getConstant(1, DL, PredVT, false, false));
        Ops()(StackPtr);
        let mut TriplePackedVT: EVT = getVectorVT(*DAG.getContext(), PackedVT.getVectorElementType(), PackedVT.getVectorElementCount() * 3);
        let mut Chain: SDValue = DAG(INTRINSIC_VOID, DL, DAG.getVTList(Other), TriplePackedVT, StackPtrInfo, Alignment, MOStore);
        let mut Results: SmallVector<SDValue, 3> = zeroed();
        for let mut I: u32 = 0; I < 3; I += 1 {
            let mut Ptr: SDValue = DAG.getMemBasePlusOffset(StackPtr, PackedVT.getStoreSize() * I, DL, SDNodeFlags { Flags: None });
            let mut L: SDValue = DAG.getLoad(PackedVT, DL, Chain, Ptr, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
            Results()(self.getSVESafeBitCast(OpVT, L, DAG));
        }
        return DAG.getMergeValues(DL);
    }
    if self.Subtarget() && self.Subtarget.isStreaming() && OpVT.isScalableVector() && isPackedVectorType(OpVT, DAG) {
        let mut IntID: ID = zeroed();
        match operator(Op).getNumOperands() {
            _ => {
                return SDValue {};
            },
            2 => {
                
            },
            4 => {
                if self.Subtarget.getMinSVEVectorSizeInBits() < 256 && OpVT.getScalarSizeInBits() == 64 {
                    return SDValue {};
                }
            },
        }
        let mut Ops: SmallVector<SDValue, 5> = zeroed();
        Ops()(DAG.getTargetConstant(IntID, DL, i64, false));
        Ops()(operator(Op).op_values().begin(), operator(Op).op_values().end());
        return DAG(INTRINSIC_WO_CHAIN, DL, operator(Op).getVTList());
    }
    if operator(Op).getNumOperands() != 2 {
        return SDValue {};
    }
    if OpVT == v1i64 || OpVT == v1f64 {
        return DAG.getMergeValues([Op.getOperand(0), Op.getOperand(1)], DL);
    }
    let mut Lo: SDValue = DAG;
    let mut Hi: SDValue = DAG;
    return DAG.getMergeValues([Lo, Hi], DL);
}

fn AArch64TargetLowering::LowerVECTOR_HISTOGRAM(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut HG: *mut MaskedHistogramSDNode = cast(Op);
    let mut DL: SDLoc = HG;
    let mut Chain: SDValue = HG.getChain();
    let mut Inc: SDValue = HG.getInc();
    let mut Mask: SDValue = HG.getMask();
    let mut Ptr: SDValue = HG.getBasePtr();
    let mut Index: SDValue = HG.getIndex();
    let mut Scale: SDValue = HG.getScale();
    let mut IntID: SDValue = HG.getIntID();
    let mut CID: *mut ConstantSDNode = cast(IntID.getNode());
    assert!(CID.getZExtValue() == experimental_vector_histogram_add, "Unexpected histogram update operation");
    let mut IndexVT: EVT = Index.getValueType();
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    let mut EC: ElementCount = IndexVT.getVectorElementCount();
    let mut MemVT: EVT = getVectorVT(Ctx, HG.getMemoryVT(), EC);
    let mut IncExtVT: EVT = getIntegerVT(Ctx, SVEBitsPerBlock / EC.getKnownMinValue());
    let mut IncSplatVT: EVT = getVectorVT(Ctx, IncExtVT, EC);
    let mut ExtTrunc: bool = IncSplatVT != MemVT;
    let mut Zero: SDValue = DAG.getConstant(0, DL, i64, false, false);
    let mut PassThru: SDValue = DAG.getSplatVector(IncSplatVT, DL, Zero);
    let mut IncSplat: SDValue = DAG.getSplatVector(IncSplatVT, DL, DAG.getAnyExtOrTrunc(Inc, DL, IncExtVT));
    let mut Ops: [6]SDValue = [Chain, PassThru, Mask, Ptr, Index, Scale];
    let mut MMO: *mut MachineMemOperand = HG.getMemOperand();
    let mut GMMO: *mut MachineMemOperand = DAG.getMachineFunction().getMachineMemOperand(MMO.getPointerInfo(), MOLoad, MMO.getSize(), MMO.getAlign(), MMOMetadata { AAInfo: MMO.getAAInfo(), Ranges: null, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    let mut IndexType: MemIndexType = HG.getIndexType();
    let mut Gather: SDValue = DAG.getMaskedGather;
    let mut GChain: SDValue = Gather.getValue(1);
    let mut ID: SDValue = DAG;
    let mut HistCnt: SDValue = DAG.getNode(INTRINSIC_WO_CHAIN, DL, IndexVT, ID, Mask, Index, Index);
    let mut Mul: SDValue = DAG.getNode(MUL, DL, IncSplatVT, HistCnt, IncSplat);
    let mut Add: SDValue = DAG.getNode(ADD, DL, IncSplatVT, Gather, Mul);
    let mut SMMO: *mut MachineMemOperand = DAG.getMachineFunction().getMachineMemOperand(MMO.getPointerInfo(), MOStore, MMO.getSize(), MMO.getAlign(), MMOMetadata { AAInfo: MMO.getAAInfo(), Ranges: null, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    let mut ScatterOps: [6]SDValue = [GChain, Add, Mask, Ptr, Index, Scale];
    let mut Scatter: SDValue = DAG.getMaskedScatter;
    return Scatter;
}

fn AArch64TargetLowering::LowerPARTIAL_REDUCE_MLA(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut Acc: SDValue = Op.getOperand(0);
    let mut OrigAcc: SDValue = Acc;
    let mut LHS: SDValue = Op.getOperand(1);
    let mut RHS: SDValue = Op.getOperand(2);
    let mut ResultVT: EVT = Op.getValueType();
    let mut OrigResultVT: EVT = ResultVT;
    let mut OpVT: EVT = LHS.getValueType();
    if (Op.getOpcode() == PARTIAL_REDUCE_UMLA || Op.getOpcode() == PARTIAL_REDUCE_SMLA) && self.Subtarget.isNeonAvailable() && (OpVT.is64BitVector() || OpVT.is128BitVector()) && ResultVT.getScalarSizeInBits() == OpVT.getScalarSizeInBits() * 2 && ResultVT.getVectorNumElements() * 2 == OpVT.getVectorNumElements() {
        if isOneVector(RHS) {
            return Op;
        }
        if OpVT.getScalarType() == i8 && operator!((self.Subtarget.isSVEorStreamingSVEAvailable() && (self.Subtarget() || self.Subtarget()))) {
            return SDValue {};
        }
        if OpVT.getScalarType() == i16 && operator!((self.Subtarget.isSVEorStreamingSVEAvailable() && (self.Subtarget() || self.Subtarget()))) {
            return SDValue {};
        }
        if OpVT.getScalarType() == i32 {
            return SDValue {};
        }
    }
    if ResultVT == v2i32 && OpVT == v16i8 {
        let mut ZeroVec: SDValue = DAG.getConstant(0, DL, v4i32, false, false);
        let mut WideAcc: SDValue = DAG.getInsertSubvector(DL, ZeroVec, Acc, 0);
        let mut Wide: SDValue = DAG.getNode(Op.getOpcode(), DL, v4i32, WideAcc, LHS, RHS);
        let mut Reduced: SDValue = DAG;
        return DAG.getExtractSubvector(DL, v2i32, Reduced, 0);
    }
    if self.Subtarget.isNeonAvailable() && ResultVT == v2i64 && OpVT == v16i8 {
        let mut Wide: SDValue = DAG.getNode(Op.getOpcode(), DL, v4i32, DAG.getConstant(0, DL, v4i32, false, false), LHS, RHS);
        let mut IsUnsigned: bool = Op.getOpcode() == PARTIAL_REDUCE_UMLA;
        let mut Opc: u32 = 0;
        return DAG.getNode(ADD, DL, ResultVT, Acc, DAG.getNode(Opc, DL, ResultVT, Wide));
    }
    if Op.getOpcode() == PARTIAL_REDUCE_SUMLA && operator!(self.Subtarget()) && self.Subtarget() && ((ResultVT == v4i32 && OpVT == v16i8) || (ResultVT == v2i32 && OpVT == v8i8)) {
        let mut SignFlipMask: SDValue = DAG.getConstant(128, DL, OpVT, false, false);
        let mut BiasedLHS: SDValue = DAG.getNode(XOR, DL, OpVT, LHS, SignFlipMask);
        let mut BiasedDot: SDValue = DAG.getNode(PARTIAL_REDUCE_UMLA, DL, ResultVT, Acc, BiasedLHS, RHS);
        let mut BiasCorrection: SDValue = DAG.getNode(PARTIAL_REDUCE_UMLA, DL, ResultVT, DAG.getConstant(0, DL, ResultVT, false, false), SignFlipMask, RHS);
        return DAG.getNode(SUB, DL, ResultVT, BiasedDot, BiasCorrection);
    }
    if !self.Subtarget.isSVEorStreamingSVEAvailable() && OpVT.getVectorNumElements() > 2 * ResultVT.getVectorNumElements() {
        return SDValue {};
    }
    let mut ConvertToScalable: bool = ResultVT.isFixedLengthVector() && self.Subtarget.isSVEorStreamingSVEAvailable();
    if ConvertToScalable {
        ResultVT = getContainerForFixedLengthVector(DAG, ResultVT);
        OpVT = getContainerForFixedLengthVector(DAG, LHS.getValueType());
        Acc = convertToScalableVector(DAG, ResultVT, Acc);
        LHS = convertToScalableVector(DAG, OpVT, LHS);
        RHS = convertToScalableVector(DAG, OpVT, RHS);
        Op = DAG.getNode(Op.getOpcode(), DL, ResultVT, [Acc, LHS, RHS]);
    }
    if ResultVT.getScalarType() != i64 || OpVT.getScalarType() != i8 {
        return if ConvertToScalable { convertFromScalableVector(DAG, OrigResultVT, Op) } else { Op };
    }
    let mut DotVT: EVT = if ResultVT.isScalableVector() { nxv4i32 } else { v4i32 };
    let mut DotNode: SDValue = DAG.getNode(Op.getOpcode(), DL, DotVT, DAG.getConstant(0, DL, DotVT, false, false), LHS, RHS);
    let mut IsUnsigned: bool = Op.getOpcode() == PARTIAL_REDUCE_UMLA;
    if self.Subtarget() || self.Subtarget.isStreamingSVEAvailable() {
        let mut IID: u32 = 0;
        let mut Pg: SDValue = getPredicateForVector(DAG, DL, ResultVT);
        let mut Res: SDValue = DAG.getNode(INTRINSIC_WO_CHAIN, DL, ResultVT, DAG.getConstant(IID, DL, i64, false, false), Pg, Acc, DotNode);
        return if ConvertToScalable { convertFromScalableVector(DAG, OrigResultVT, Res) } else { Res };
    }
    let mut FoldDot: SDValue = DotNode;
    if ConvertToScalable {
        let mut FixedDotVT: EVT = getVectorVT(*DAG.getContext(), i32, OrigResultVT.getVectorNumElements() * 2, false);
        FoldDot = convertFromScalableVector(DAG, FixedDotVT, DotNode);
    }
    if IsUnsigned {
        DotNodeLo = DAG.getZExtOrTrunc(DotNodeLo, DL, OrigResultVT);
        DotNodeHi = DAG.getZExtOrTrunc(DotNodeHi, DL, OrigResultVT);
    } else {
        DotNodeLo = DAG.getSExtOrTrunc(DotNodeLo, DL, OrigResultVT);
        DotNodeHi = DAG.getSExtOrTrunc(DotNodeHi, DL, OrigResultVT);
    }
    let mut Lo: SDValue = DAG.getNode(ADD, DL, OrigResultVT, OrigAcc, DotNodeLo);
    return DAG.getNode(ADD, DL, OrigResultVT, Lo, DotNodeHi);
}

fn AArch64TargetLowering::LowerGET_ACTIVE_LANE_MASK(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(self.Subtarget.isSVEorStreamingSVEAvailable(), "Lowering fixed length get_active_lane_mask requires SVE!");
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    if VT == nxv1i1 {
        let mut Mask: SDValue = DAG.getNode(GET_ACTIVE_LANE_MASK, DL, nxv2i1, Op.getOperand(0), Op.getOperand(1));
        return DAG.getExtractSubvector(DL, VT, Mask, 0);
    }
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    let mut WhileVT: EVT = ContainerVT.changeElementType(*DAG.getContext(), i1);
    let mut Mask: SDValue = DAG.getNode(GET_ACTIVE_LANE_MASK, DL, WhileVT, Op.getOperand(0), Op.getOperand(1));
    let mut MaskAsInt: SDValue = DAG.getNode(SIGN_EXTEND, DL, ContainerVT, Mask);
    return DAG.getExtractSubvector(DL, VT, MaskAsInt, 0);
}

fn getSVEOpcodeForFPToInt(Opc: u32) -> u32 {
    match Opc {
        FP_TO_UINT_SAT => {
            FP_TO_UINT;
        },
        FP_TO_SINT_SAT => {
            FP_TO_SINT;
        },
        STRICT_FP_TO_SINT => {
            
        },
        STRICT_FP_TO_UINT => {
            
        },
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 35650);
        },
    }
}

fn AArch64TargetLowering::LowerFPToIntToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut Opc: u32 = Op.getOpcode();
    let mut VT: EVT = Op.getValueType();
    let mut InVT: EVT = Op.getOperand(if IsStrict { 1 } else { 0 }).getValueType();
    if InVT.getVectorElementType() == bf16 {
        return SDValue {};
    }
    if (Opc == FP_TO_UINT_SAT || Opc == FP_TO_SINT_SAT) && VT.getVectorElementType() != cast(Op.getOperand(1))() {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    if VT.isScalableVector() {
        if VT.getVectorElementType() == i1 {
            let mut CvtVT: EVT = self.getPromotedVTForPredicate(VT);
            let mut Cvt: SDValue = DAG.getNode(Opc, DL, CvtVT, Op.getOperand(0));
            let mut Zero: SDValue = DAG.getConstant(0, DL, CvtVT, false, false);
            return DAG.getSetCC(DL, VT, Cvt, Zero, SETNE, SDValue {}, false, None);
        }
        if InVT == nxv8f32 {
            return Op;
        }
        let mut Operands: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
        if IsStrict {
            Operands.push(Op.getOperand(0));
        }
        Operands.push(getPredicateForVector(DAG, DL, VT));
        Operands.push(Op.getOperand(if IsStrict { 1 } else { 0 }));
        Operands.push(DAG.getPOISON(VT));
        return DAG;
    }
    let mut OverrideNEON: bool = !self.Subtarget.isNeonAvailable();
    if self.useSVEForFixedLengthVectorVT(VT, OverrideNEON) || self.useSVEForFixedLengthVectorVT(InVT, OverrideNEON) {
        return self.LowerFixedLengthFPToIntToSVE(Op, DAG);
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerFixedLengthFPToIntToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if operator(Op).isStrictFPOpcode() {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    let mut Opc: u32 = Op.getOpcode();
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut Opcode: u32 = getSVEOpcodeForFPToInt(Op.getOpcode());
    let mut IsSaturating: bool = Opc == FP_TO_UINT_SAT || Opc == FP_TO_SINT_SAT;
    (((operator!(operator!(((!IsSaturating || (VT.getVectorElementType() == cast(Op.getOperand(1))())) && "Can't handle saturation to a different type than the destination VT")))) || (_wassert(L"(!IsSaturating || (VT.getVectorElementType() == cast<VTSDNode>(Op.getOperand(1))->getVT())) && \"Can't handle saturation to a different type than the destination VT\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (35717) as u32) , 0)) as void);
    let mut Val: SDValue = Op.getOperand(0);
    let mut SrcVT: EVT = Val.getValueType();
    if VT.bitsLT(SrcVT) && IsSaturating {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut ContainerSrcVT: EVT = getContainerForFixedLengthVector(DAG, SrcVT);
    let mut ContainerDstVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    if VT.bitsGT(SrcVT) {
        let mut CvtVT: EVT = ContainerDstVT.changeVectorElementType(*DAG.getContext(), ContainerSrcVT.getVectorElementType());
        let mut Pg: SDValue = getPredicateForFixedLengthVector(DAG, DL, VT);
        Val = DAG.getNode(BITCAST, DL, SrcVT.changeTypeToInteger(), Val);
        Val = DAG.getNode(ANY_EXTEND, DL, VT, Val);
        Val = convertToScalableVector(DAG, ContainerDstVT, Val);
        Val = self.getSVESafeBitCast(CvtVT, Val, DAG);
        Val = DAG.getNode(Opcode, DL, ContainerDstVT, Pg, Val, DAG.getPOISON(ContainerDstVT));
        return convertFromScalableVector(DAG, VT, Val);
    } else {
        let mut CvtVT: EVT = ContainerSrcVT.changeTypeToInteger();
        let mut Pg: SDValue = getPredicateForFixedLengthVector(DAG, DL, SrcVT);
        Val = convertToScalableVector(DAG, ContainerSrcVT, Val);
        Val = DAG.getNode(Opcode, DL, CvtVT, Pg, Val, DAG.getPOISON(CvtVT));
        Val = convertFromScalableVector(DAG, SrcVT.changeTypeToInteger(), Val);
        return DAG.getNode(TRUNCATE, DL, VT, Val);
    }
}

fn GenerateFixedLengthSVETBL(Op: SDValue, Op1: SDValue, Op2: SDValue, ShuffleMask: ArrayRef<int>, VT: EVT, ContainerVT: EVT, DAG: *mut SelectionDAG) -> SDValue {
    let mut Subtarget: *mut auto = DAG;
    let mut DL: SDLoc = Op;
    let mut MinSVESize: u32 = ();
    let mut MaxSVESize: u32 = ();
    let mut IsSingleOp: bool = isSingleSourceMask(ShuffleMask, ShuffleMask.len);
    if operator!() && !MinSVESize {
        MinSVESize = 128;
    }
    if !IsSingleOp && operator!() {
        return SDValue {};
    }
    let mut VTOp1: EVT = Op.getOperand(0).getValueType();
    let mut BitsPerElt: u32 = VTOp1.getVectorElementType().getSizeInBits().operator unsigned long long();
    let mut IndexLen: u32 = MinSVESize / BitsPerElt;
    let mut ElementsPerVectorReg: u32 = VTOp1.getVectorNumElements();
    let mut MaxOffset: u64 = maxUIntN(BitsPerElt);
    let mut MaskEltType: EVT = VTOp1.getVectorElementType().changeTypeToInteger();
    let mut MaskType: EVT = getVectorVT(*DAG.getContext(), MaskEltType, IndexLen, false);
    let mut MinMaxEqual: bool = (MinSVESize == MaxSVESize);
    assert!(ElementsPerVectorReg <= IndexLen && ShuffleMask.len <= IndexLen, "Incorrectly legalised shuffle operation");
    let mut TBLMask: SmallVector<SDValue, 8> = zeroed();
    let mut AddRuntimeVLMask: SmallVector<SDValue, 8> = zeroed();
    if !IsSingleOp && !MinMaxEqual && BitsPerElt == 8 {
        return SDValue {};
    }
    for Index in ShuffleMask {
        if Index < 0 {
            Index = 0;
        }
        if Index as u32 >= ElementsPerVectorReg {
            if MinMaxEqual {
                Index += IndexLen - ElementsPerVectorReg;
            } else {
                Index = Index - ElementsPerVectorReg;
                AddRuntimeVLMask()(DAG.getConstant(1, DL, i64, false, false));
            }
        } else if !MinMaxEqual {
            AddRuntimeVLMask()(DAG.getConstant(0, DL, i64, false, false));
        }
        if Index as u32 >= MaxOffset {
            return SDValue {};
        }
        TBLMask()(DAG.getConstant(Index, DL, i64, false, false));
    }
    for let mut i: u32 = 0; i < IndexLen - ElementsPerVectorReg; i += 1 {
        TBLMask()(DAG.getConstant(MaxOffset as i32, DL, i64, false, false));
        if !MinMaxEqual {
            AddRuntimeVLMask()(DAG.getConstant(0, DL, i64, false, false));
        }
    }
    let mut MaskContainerVT: EVT = getContainerForFixedLengthVector(DAG, MaskType);
    let mut VecMask: SDValue = DAG(MaskType, DL);
    let mut SVEMask: SDValue = convertToScalableVector(DAG, MaskContainerVT, VecMask);
    let mut Shuffle: SDValue = SDValue {};
    if IsSingleOp {
        Shuffle = DAG(INTRINSIC_WO_CHAIN, DL, ContainerVT, DAG, Op1, SVEMask);
    } else if Subtarget()() {
        if !MinMaxEqual {
            let mut MinNumElts: u32 = SVEBitsPerBlock / BitsPerElt;
            let mut VScale: SDValue = if (BitsPerElt == 64) { DAG.getVScale(DL, i64, APInt { 64, MinNumElts, false, false }) } else { DAG.getVScale(DL, i32, APInt { 32, MinNumElts, false, false }) };
            let mut VecMask: SDValue = DAG(MaskType, DL);
            let mut MulByMask: SDValue = DAG(MUL, DL, MaskType, DAG.getNode(SPLAT_VECTOR, DL, MaskType, VScale), DAG(MaskType, DL));
            let mut UpdatedVecMask: SDValue = DAG.getNode(ADD, DL, MaskType, VecMask, MulByMask);
            SVEMask = convertToScalableVector(DAG, getContainerForFixedLengthVector(DAG, MaskType), UpdatedVecMask);
        }
        Shuffle = DAG(INTRINSIC_WO_CHAIN, DL, ContainerVT, DAG, Op1, Op2, SVEMask);
    }
    Shuffle = convertFromScalableVector(DAG, VT, Shuffle);
    return DAG.getNode(BITCAST, DL, Op.getValueType(), Shuffle);
}

fn AArch64TargetLowering::LowerFixedLengthVECTOR_SHUFFLEToSVE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFixedLengthVector(), "Expected fixed length vector type!");
    let mut SVN: *mut auto = cast(Op.getNode());
    let mut ShuffleMask: auto = ();
    let mut DL: SDLoc = Op;
    let mut Op1: SDValue = Op.getOperand(0);
    let mut Op2: SDValue = Op.getOperand(1);
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
    Op1 = convertToScalableVector(DAG, ContainerVT, Op1);
    Op2 = convertToScalableVector(DAG, ContainerVT, Op2);
    let mut MinLegalExtractEltScalarTy: Closure_81 = Closure_81 {};
    if SVN()() {
        let mut Lane: u32 = if 0 > () { 0 } else { () };
        let mut ScalarTy: EVT = MinLegalExtractEltScalarTy.call(VT.getVectorElementType());
        let mut SplatEl: SDValue = DAG.getExtractVectorElt(DL, ScalarTy, Op1, Lane);
        Op = DAG.getNode(SPLAT_VECTOR, DL, ContainerVT, SplatEl);
        return convertFromScalableVector(DAG, VT, Op);
    }
    let mut ReverseEXT: bool = false;
    let mut Imm: u32 = 0;
    if isEXTMask(VT, ReverseEXT, Imm) && Imm == VT.getVectorNumElements() - 1 {
        if ReverseEXT {
            swap(Op1, Op2);
        }
        let mut ScalarTy: EVT = MinLegalExtractEltScalarTy.call(VT.getVectorElementType());
        let mut Scalar: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, ScalarTy, Op1, DAG.getConstant(VT.getVectorNumElements() - 1, DL, i64, false, false));
        Op = DAG;
        return convertFromScalableVector(DAG, VT, Op);
    }
    let mut EltSize: u32 = VT.getScalarSizeInBits();
    for BlockSize in [64, 32, 16] {
        if isREVMask(EltSize, VT.getVectorNumElements(), BlockSize) {
            let mut RevOp: u32 = 0;
            let mut BlockedVT: EVT = getPackedSVEVectorVT(getIntegerVT(*DAG.getContext(), BlockSize));
            let mut Pg: SDValue = getPredicateForVector(DAG, DL, BlockedVT);
            let mut BlockedOp1: SDValue = DAG.getNode(BITCAST, DL, BlockedVT, Op1);
            let mut BlockedRev: SDValue = DAG.getNode(RevOp, DL, BlockedVT, Pg, BlockedOp1, DAG.getPOISON(BlockedVT));
            let mut Container: SDValue = DAG.getNode(BITCAST, DL, ContainerVT, BlockedRev);
            return convertFromScalableVector(DAG, VT, Container);
        }
    }
    if self.Subtarget() && EltSize == 64 && isREVMask(EltSize, VT.getVectorNumElements(), 128) {
        let mut Pg: SDValue = getPredicateForVector(DAG, DL, VT);
        let mut Revd: SDValue = DAG;
        return convertFromScalableVector(DAG, VT, Revd);
    }
    let mut WhichResult: u32 = 0;
    let mut OperandOrder: u32 = 0;
    let mut NumElts: u32 = VT.getVectorNumElements();
    if isZIPMask(NumElts, WhichResult, OperandOrder) && WhichResult == 0 {
        let mut ZIP: SDValue = DAG;
        return convertFromScalableVector(DAG, VT, ZIP);
    }
    if isTRNMask(VT.getVectorNumElements(), WhichResult, OperandOrder) {
        let mut Opc: u32 = 0;
        let mut TRN: SDValue = DAG.getNode(Opc, DL, ContainerVT, if OperandOrder == 0 { Op1 } else { Op2 }, if OperandOrder == 0 { Op2 } else { Op1 });
        return convertFromScalableVector(DAG, VT, TRN);
    }
    if isZIP_v_undef_Mask(NumElts, WhichResult) && WhichResult == 0 {
        return convertFromScalableVector(DAG, VT, DAG);
    }
    if isTRN_v_undef_Mask(NumElts, WhichResult) {
        let mut Opc: u32 = 0;
        return convertFromScalableVector(DAG, VT, DAG.getNode(Opc, DL, ContainerVT, Op1, Op1));
    }
    let mut MinSVESize: u32 = self.Subtarget.getMinSVEVectorSizeInBits();
    let mut MaxSVESize: u32 = self.Subtarget.getMaxSVEVectorSizeInBits();
    if MinSVESize == MaxSVESize && MaxSVESize == VT.getSizeInBits().operator unsigned long long() {
        if isReverseMask() && Op2.isUndef() {
            Op = DAG.getNode(VECTOR_REVERSE, DL, ContainerVT, Op1);
            return convertFromScalableVector(DAG, VT, Op);
        }
        let mut NumElts: u32 = VT.getVectorNumElements();
        if isZIPMask(NumElts, WhichResult, OperandOrder) && WhichResult != 0 {
            let mut ZIP: SDValue = DAG;
            return convertFromScalableVector(DAG, VT, ZIP);
        }
        if isUZPMask(NumElts, WhichResult) {
            let mut Opc: u32 = 0;
            return convertFromScalableVector(DAG, VT, DAG.getNode(Opc, DL, ContainerVT, Op1, Op2));
        }
        if isZIP_v_undef_Mask(NumElts, WhichResult) && WhichResult != 0 {
            return convertFromScalableVector(DAG, VT, DAG);
        }
        if isUZP_v_undef_Mask(NumElts, WhichResult) {
            let mut Opc: u32 = 0;
            return convertFromScalableVector(DAG, VT, DAG.getNode(Opc, DL, ContainerVT, Op1, Op1));
        }
        if (self.Subtarget() || self.Subtarget()) && self.Subtarget.isSVEorStreamingSVEAvailable() {
            assert!(VT.getFixedSizeInBits() % SVEBitsPerBlock == 0, "Unsupported SVE vector size");
            let mut Segments: u32 = VT.getFixedSizeInBits() / SVEBitsPerBlock;
            let mut SegmentElts: u32 = VT.getVectorNumElements() / Segments;
            if isDUPQMask(Segments, SegmentElts) {
                Lane;
            } else {
                let mut IID: SDValue = DAG;
                return convertFromScalableVector(DAG, VT, DAG.getNode(INTRINSIC_WO_CHAIN, DL, ContainerVT, [IID, Op1, DAG.getConstant(operator(Lane), DL, i64, true, false)]));
            }
        }
    }
    if tryWidenMaskForShuffle(Op, DAG) {
        WideOp;
    } else {
        return WideOp;
    }
    if MinSVESize || !self.Subtarget.isNeonAvailable() {
        return GenerateFixedLengthSVETBL(Op, Op1, Op2, VT, ContainerVT, DAG);
    }
    return SDValue {};
}

fn AArch64TargetLowering::getSVESafeBitCast(self: *AArch64TargetLowering, VT: EVT, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut InVT: EVT = Op.getValueType();
    assert!(VT.isScalableVector() && self.isTypeLegal(VT) && InVT.isScalableVector() && self.isTypeLegal(InVT), "Only expect to cast between legal scalable vector types!");
    assert!(VT.getVectorElementType() != i1 && InVT.getVectorElementType() != i1, "For predicate bitcasts, use getSVEPredicateBitCast");
    if InVT == VT {
        return Op;
    }
    let mut PackedVT: EVT = getPackedSVEVectorVT(VT.getVectorElementType());
    let mut PackedInVT: EVT = getPackedSVEVectorVT(InVT.getVectorElementType());
    assert!((VT.getVectorElementCount() == InVT.getVectorElementCount() || VT == PackedVT || InVT == PackedInVT), "Unexpected bitcast!");
    if InVT != PackedInVT {
        Op = DAG;
    }
    if self.Subtarget.isLittleEndian() || PackedVT.getScalarSizeInBits() == PackedInVT.getScalarSizeInBits() {
        Op = DAG.getNode(BITCAST, DL, PackedVT, Op);
    } else {
        let mut PackedVTAsInt: EVT = PackedVT.changeTypeToInteger();
        let mut PackedInVTAsInt: EVT = PackedInVT.changeTypeToInteger();
        Op = DAG.getNode(BITCAST, DL, PackedInVTAsInt, Op);
        if PackedInVTAsInt.getScalarSizeInBits() != 8 {
            Op = DAG.getNode(BSWAP, DL, PackedInVTAsInt, Op);
        }
        Op = DAG;
        if PackedVTAsInt.getScalarSizeInBits() != 8 {
            Op = DAG.getNode(BSWAP, DL, PackedVTAsInt, Op);
        }
        Op = DAG.getNode(BITCAST, DL, PackedVT, Op);
    }
    if VT != PackedVT {
        Op = DAG;
    }
    return Op;
}

