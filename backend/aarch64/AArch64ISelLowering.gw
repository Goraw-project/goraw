fn performST1Combine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Data: SDValue = N.getOperand(2);
    let mut DataVT: EVT = Data.getValueType();
    let mut HwSrcVt: EVT = getSVEContainerType(DataVT);
    let mut InputVT: SDValue = DAG.getValueType(DataVT);
    if DataVT.isFloatingPoint() {
        InputVT = DAG.getValueType(HwSrcVt);
    }
    let mut SrcNew: SDValue = SDValue {};
    if Data.getValueType().isFloatingPoint() {
        SrcNew = DAG.getNode(BITCAST, DL, HwSrcVt, Data);
    } else {
        SrcNew = DAG.getNode(ANY_EXTEND, DL, HwSrcVt, Data);
    }
    let mut Ops: [5]SDValue = [N.getOperand(0), SrcNew, N.getOperand(4), N.getOperand(3), InputVT];
    return DAG;
}

fn performSTNT1Combine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Data: SDValue = N.getOperand(2);
    let mut DataVT: EVT = Data.getValueType();
    let mut PtrTy: EVT = N.getOperand(4).getValueType();
    if DataVT.isFloatingPoint() {
        Data = DAG.getNode(BITCAST, DL, DataVT.changeTypeToInteger(), Data);
    }
    let mut MINode: *mut auto = cast(N);
    return DAG.getMaskedStore(DL, Data, (4), DAG.getPOISON(PtrTy), (3), UNINDEXED, false, false);
}

fn replaceZeroVectorStore(DAG: *mut SelectionDAG, St: *mut StoreSDNode) -> SDValue {
    let mut StVal: SDValue = St.getValue();
    let mut VT: EVT = StVal.getValueType();
    if VT.isScalableVector() {
        return SDValue {};
    }
    let mut NumVecElts: i32 = VT.getVectorNumElements();
    if !(((NumVecElts == 2 || NumVecElts == 3) && VT.getVectorElementType().getSizeInBits().operator unsigned long long() == 64) || ((NumVecElts == 2 || NumVecElts == 3 || NumVecElts == 4) && VT.getVectorElementType().getSizeInBits().operator unsigned long long() == 32)) {
        return SDValue {};
    }
    if StVal.getOpcode() != BUILD_VECTOR {
        return SDValue {};
    }
    if !StVal.hasOneUse() {
        return SDValue {};
    }
    if St.isTruncatingStore() {
        return SDValue {};
    }
    if DAG.isBaseWithConstantOffset(St.getBasePtr()) {
        let mut Offset: i64 = operator(St.getBasePtr()).getConstantOperandVal(1);
        if Offset < -512 || Offset > 504 {
            return SDValue {};
        }
    }
    for let mut I: i32 = 0; I < NumVecElts; I += 1 {
        let mut EltVal: SDValue = StVal.getOperand(I);
        if !isNullConstant(EltVal) && !isNullFPConstant(EltVal) {
            return SDValue {};
        }
    }
    let mut DL: SDLoc = &mut St;
    let mut ZeroReg: u32 = 0;
    let mut ZeroVT: EVT = EVT {};
    if VT.getVectorElementType().getSizeInBits().operator unsigned long long() == 32 {
        ZeroVT = i32;
    } else {
        ZeroVT = i64;
    }
    let mut SplatVal: SDValue = DAG.getCopyFromReg(DAG.getEntryNode(), DL, ZeroReg, ZeroVT);
    return splitStoreSplat(DAG, St, SplatVal, NumVecElts);
}

fn replaceSplatVectorStore(DAG: *mut SelectionDAG, St: *mut StoreSDNode) -> SDValue {
    let mut StVal: SDValue = St.getValue();
    let mut VT: EVT = StVal.getValueType();
    if VT.isFloatingPoint() {
        return SDValue {};
    }
    let mut NumVecElts: u32 = VT.getVectorNumElements();
    if NumVecElts != 4 && NumVecElts != 2 {
        return SDValue {};
    }
    if St.isTruncatingStore() {
        return SDValue {};
    }
    let mut IndexNotInserted: bitset<4> = zeroed();
    let mut SplatVal: SDValue = SDValue {};
    for let mut I: u32 = 0; I < NumVecElts; I += 1 {
        if StVal.getOpcode() != INSERT_VECTOR_ELT {
            return SDValue {};
        }
        if I == 0 {
            SplatVal = StVal.getOperand(1);
        } else if StVal.getOperand(1) != SplatVal {
            return SDValue {};
        }
        let mut CIndex: *mut ConstantSDNode = dyn_cast(StVal.getOperand(2));
        if !CIndex {
            return SDValue {};
        }
        let mut IndexVal: u64 = CIndex.getZExtValue();
        if IndexVal >= NumVecElts {
            return SDValue {};
        }
        IndexNotInserted()(IndexVal);
        StVal = StVal.getOperand(0);
    }
    if IndexNotInserted()() {
        return SDValue {};
    }
    return splitStoreSplat(DAG, St, SplatVal, NumVecElts);
}

fn splitStores(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut S: *mut StoreSDNode = cast(N);
    if S.isVolatile() || S.isIndexed() {
        return SDValue {};
    }
    let mut StVal: SDValue = S.getValue();
    let mut VT: EVT = StVal.getValueType();
    if !VT.isFixedLengthVector() {
        return SDValue {};
    }
    if replaceZeroVectorStore(DAG, *S) {
        ReplacedZeroSplat;
    } else {
        return ReplacedZeroSplat;
    }
    if operator!(Subtarget()()) {
        return SDValue {};
    }
    if DAG.getMachineFunction().getFunction().hasMinSize() {
        return SDValue {};
    }
    if VT.getVectorNumElements() < 2 || VT == v2i64 {
        return SDValue {};
    }
    if VT.getSizeInBits().operator unsigned long long() != 128 || S.getAlign() >= 16 || S.getAlign() <= 2 {
        return SDValue {};
    }
    if replaceSplatVectorStore(DAG, *S) {
        ReplacedSplat;
    } else {
        return ReplacedSplat;
    }
    let mut DL: SDLoc = S;
    let mut HalfVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
    let mut NumElts: u32 = HalfVT.getVectorNumElements();
    let mut SubVector0: SDValue = DAG.getExtractSubvector(DL, HalfVT, StVal, 0);
    let mut SubVector1: SDValue = DAG.getExtractSubvector(DL, HalfVT, StVal, NumElts);
    let mut BasePtr: SDValue = S.getBasePtr();
    let mut NewST1: SDValue = DAG.getStore(S.getChain(), DL, SubVector0, BasePtr, S.getPointerInfo(), S.getAlign(), S.getMemOperand().getFlags(), MMOMetadata {});
    let mut OffsetPtr: SDValue = DAG.getNode(ADD, DL, i64, BasePtr, DAG.getConstant(8, DL, i64, false, false));
    return DAG.getStore(NewST1.getValue(0), DL, SubVector1, OffsetPtr, S.getPointerInfo(), S.getAlign(), S.getMemOperand().getFlags(), MMOMetadata {});
}

fn performSpliceCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOperand(2).isUndef() {
        return N.getOperand(1);
    }
    return SDValue {};
}

fn performUnpackCombine(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    if N.getOperand(0).isUndef() {
        return DAG.getUNDEF(N.getValueType(0));
    }
    if  {
        let mut MLD: *mut MaskedLoadSDNode = cast(N.getOperand(0));
        let mut Mask: SDValue = MLD.getMask();
        let mut DL: SDLoc = N;
        if  {
            let mut MinSVESize: u32 = Subtarget.getMinSVEVectorSizeInBits();
            let mut PgPattern: u32 = operator(Mask).getConstantOperandVal(0);
            let mut VT: EVT = N.getValueType(0);
            let mut NumElts: u32 = getNumElementsFromSVEPredPattern(PgPattern);
            if NumElts && NumElts * VT.getVectorElementType().getSizeInBits().operator unsigned long long() <= MinSVESize {
                Mask = getPTrue(DAG, DL, VT.changeVectorElementType(*DAG.getContext(), i1), PgPattern);
                let mut PassThru: SDValue = DAG.getConstant(0, DL, VT, false, false);
                let mut NewLoad: SDValue = DAG.getMaskedLoad(VT, DL, MLD.getChain(), MLD.getBasePtr(), MLD.getOffset(), Mask, PassThru, MLD.getMemoryVT(), MLD.getMemOperand(), MLD.getAddressingMode(), ZEXTLOAD, false);
                DAG.ReplaceAllUsesOfValueWith(SDValue { Node: MLD, ResNo: 1 }, NewLoad.getValue(1));
                return NewLoad;
            }
        }
    }
    return SDValue {};
}

fn isHalvingTruncateAndConcatOfLegalIntScalableType(N: *mut SDNode) -> bool {
    if  {
        return false;
    }
    let mut Op0: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = operator(Op0).getValueType(0);
    let mut DstVT: EVT = N.getValueType(0);
    return (SrcVT == nxv8i16 && DstVT == nxv16i8) || (SrcVT == nxv4i32 && DstVT == nxv8i16) || (SrcVT == nxv2i64 && DstVT == nxv4i32);
}

fn tryCombineExtendRShTrunc(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut ResVT: EVT = N.getValueType(0);
    let mut RshOpc: u32 = Op0.getOpcode();
    if  {
        return SDValue {};
    }
    let mut ShiftValue: SDValue = Op0.getOperand(1);
    if RshOpc != Op1.getOpcode() || ShiftValue != Op1.getOperand(1) {
        return SDValue {};
    }
    let mut Lo: SDValue = Op0.getOperand(0);
    let mut Hi: SDValue = Op1.getOperand(0);
    if  {
        return SDValue {};
    }
    let mut OrigArg: SDValue = Lo.getOperand(0);
    if OrigArg != Hi.getOperand(0) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    return DAG;
}

fn trySimplifySrlAddToRshrnb(Srl: SDValue, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut VT: EVT = operator(Srl).getValueType(0);
    if !VT.isScalableVector() || operator!(Subtarget()()) {
        return SDValue {};
    }
    let mut ResVT: EVT = EVT {};
    if VT == nxv8i16 {
        ResVT = nxv16i8;
    } else if VT == nxv4i32 {
        ResVT = nxv8i16;
    } else if VT == nxv2i64 {
        ResVT = nxv4i32;
    } else {
        return SDValue {};
    }
    let mut DL: SDLoc = Srl;
    let mut ShiftValue: u32 = 0;
    let mut RShOperand: SDValue = SDValue {};
    if !canLowerSRLToRoundingShiftForVT(Srl, ResVT, DAG, ShiftValue, RShOperand) {
        return SDValue {};
    }
    let mut Rshrnb: SDValue = DAG;
    return DAG;
}

fn isNVCastToHalfWidthElements(V: SDValue, Subtarget: *AArch64Subtarget) -> SDValue {
    if  {
        return SDValue {};
    }
    let mut Op: SDValue = V.getOperand(0);
    if !Op.getValueType().isVector() || V.getValueType().getVectorElementCount() != Op.getValueType().getVectorElementCount() * 2 {
        return SDValue {};
    }
    return Op;
}

fn performUzpCombine(N: *mut SDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut DL: SDLoc = N;
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut ResVT: EVT = N.getValueType(0);
    if Op0.isUndef() && Op1.isUndef() {
        return DAG.getUNDEF(ResVT);
    }
    if Op0.getOpcode() == EXTRACT_SUBVECTOR && Op1.getOpcode() == EXTRACT_SUBVECTOR && Op0.getOperand(0) == Op1.getOperand(0) {
        let mut SourceVec: SDValue = Op0.getOperand(0);
        let mut ExtIdx0: u64 = Op0.getConstantOperandVal(1);
        let mut ExtIdx1: u64 = Op1.getConstantOperandVal(1);
        let mut NumElements: u64 = SourceVec.getValueType().getVectorMinNumElements();
        if ExtIdx0 == 0 && ExtIdx1 == NumElements / 2 {
            let mut WidenedResVT: EVT = ResVT.getDoubleNumVectorElementsVT(*DAG.getContext());
            let mut Uzp: SDValue = DAG.getNode(N.getOpcode(), DL, WidenedResVT, SourceVec, DAG.getPOISON(WidenedResVT));
            return DAG.getExtractSubvector(DL, ResVT, Uzp, 0);
        }
    }
    if  {
        return SDValue {};
    }
    if tryCombineExtendRShTrunc(N, DAG) {
        Urshr;
    } else {
        return Urshr;
    }
    if isNVCastToHalfWidthElements(Op0, Subtarget) {
        PreCast;
    } else {
        if trySimplifySrlAddToRshrnb(PreCast, DAG, Subtarget) {
            Rshrnb;
        } else {
            Rshrnb = DAG;
            return DAG;
        }
    }
    if isNVCastToHalfWidthElements(Op1, Subtarget) {
        PreCast;
    } else {
        if trySimplifySrlAddToRshrnb(PreCast, DAG, Subtarget) {
            Rshrnb;
        } else {
            Rshrnb = DAG;
            return DAG;
        }
    }
    if isNVCastToHalfWidthElements(Op0, Subtarget) {
        PreCast;
    } else {
        if  {
            if  {
                let mut X: SDValue = PreCast.getOperand(0).getOperand(0);
                return DAG;
            }
        }
    }
    if isNVCastToHalfWidthElements(Op1, Subtarget) {
        PreCast;
    } else {
        if  {
            if  {
                let mut Z: SDValue = PreCast.getOperand(0).getOperand(1);
                return DAG;
            }
        }
    }
    if isNVCastToHalfWidthElements(Op0, Subtarget) {
        PreCastOp0;
    } else {
        if isNVCastToHalfWidthElements(Op1, Subtarget) {
            PreCastOp1;
        } else {
            if PreCastOp0.getOpcode() == SRL && PreCastOp1.getOpcode() == SRL && PreCastOp0.getOperand(1) == PreCastOp1.getOperand(1) {
                let mut ShiftAmount: *mut ConstantSDNode = isConstOrConstSplat(PreCastOp0.getOperand(1), false, true);
                if ShiftAmount && ShiftAmount.getAsZExtVal() == ResVT.getScalarSizeInBits() {
                    return DAG;
                }
            }
        }
    }
    if !DAG.getDataLayout().isLittleEndian() {
        return SDValue {};
    }
    if Op1.isUndef() {
        let mut BCVT: EVT = Other;
        let mut HalfVT: EVT = Other;
        match ResVT.getSimpleVT().SimpleTy {
            _ => {
                break;
            },
            v16i8 => {
                BCVT = v8i16;
            },
            v8i16 => {
                BCVT = v4i32;
            },
            v4i32 => {
                BCVT = v2i64;
            },
        }
        if BCVT != Other {
            let mut BC: SDValue = DAG.getBitcast(BCVT, Op0);
            let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, HalfVT, BC);
            return DAG.getNode(CONCAT_VECTORS, DL, ResVT, Trunc, DAG.getPOISON(HalfVT));
        }
    }
    if isHalvingTruncateAndConcatOfLegalIntScalableType(N) && Op0.getOpcode() == BITCAST && Op1.getOpcode() == BITCAST {
        if Op0.getOperand(0).getValueType() == Op1.getOperand(0).getValueType() {
            return DAG;
        }
    }
    if ResVT != v2i32 && ResVT != v4i16 && ResVT != v8i8 {
        return SDValue {};
    }
    let mut SourceOp0: SDValue = peekThroughBitcasts(Op0);
    let mut SourceOp1: SDValue = peekThroughBitcasts(Op1);
    if SourceOp0.getValueType() == SourceOp1.getValueType() {
        let mut Op0Ty: EVT = SourceOp0.getValueType();
        if (ResVT == v4i16 && Op0Ty == v2i32) || (ResVT == v8i8 && Op0Ty == v4i16) {
            let mut Concat: SDValue = DAG.getNode(CONCAT_VECTORS, DL, Op0Ty.getDoubleNumVectorElementsVT(*DAG.getContext()), SourceOp0, SourceOp1);
            return DAG.getNode(TRUNCATE, DL, ResVT, Concat);
        }
    }
    if SourceOp0.getOpcode() != TRUNCATE || SourceOp1.getOpcode() != TRUNCATE {
        return SDValue {};
    }
    SourceOp0 = SourceOp0.getOperand(0);
    SourceOp1 = SourceOp1.getOperand(0);
    if SourceOp0.getValueType() != SourceOp1.getValueType() || !SourceOp0.getValueType().isSimple() {
        return SDValue {};
    }
    let mut ResultTy: EVT = EVT {};
    match SourceOp0.getSimpleValueType().SimpleTy {
        v2i64 => {
            ResultTy = v4i32;
        },
        v4i32 => {
            ResultTy = v8i16;
        },
        v8i16 => {
            ResultTy = v16i8;
        },
        _ => {
            return SDValue {};
        },
    }
    let mut UzpOp0: SDValue = DAG.getNode(BITCAST, DL, ResultTy, SourceOp0);
    let mut UzpOp1: SDValue = DAG.getNode(BITCAST, DL, ResultTy, SourceOp1);
    let mut UzpResult: SDValue = DAG;
    let mut BitcastResultTy: EVT = EVT {};
    match ResVT.getSimpleVT().SimpleTy {
        v2i32 => {
            BitcastResultTy = v2i64;
        },
        v4i16 => {
            BitcastResultTy = v4i32;
        },
        v8i8 => {
            BitcastResultTy = v8i16;
        },
        _ => {
            llvm_unreachable_internal("Should be one of {v2i32, v4i16, v8i8}", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 27023);
        },
    }
    return DAG.getNode(TRUNCATE, DL, ResVT, DAG.getNode(BITCAST, DL, BitcastResultTy, UzpResult));
}

fn performGLD1Combine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Opc: u32 = N.getOpcode();
    let mut Scaled: bool = false;
    let mut Signed: bool = false;
    let mut Extended: bool = false;
    let mut DL: SDLoc = N;
    let mut Chain: SDValue = N.getOperand(0);
    let mut Pg: SDValue = N.getOperand(1);
    let mut Base: SDValue = N.getOperand(2);
    let mut Offset: SDValue = N.getOperand(3);
    let mut Ty: SDValue = N.getOperand(4);
    let mut ResVT: EVT = N.getValueType(0);
    let mut OffsetOpc: u32 = Offset.getOpcode();
    let mut OffsetIsZExt: bool = false;
    let mut OffsetIsSExt: bool = false;
    if !Extended && (OffsetIsSExt || OffsetIsZExt) {
        let mut ExtPg: SDValue = Offset.getOperand(0);
        let mut ExtFrom: *mut VTSDNode = cast(Offset.getOperand(2).getNode());
        let mut ExtFromEVT: EVT = ExtFrom.getVT().getVectorElementType();
        if ExtPg == Pg && ExtFromEVT == i32 {
            let mut UnextendedOffset: SDValue = Offset.getOperand(1);
            let mut NewOpc: u32 = getGatherVecOpcode(Scaled, OffsetIsSExt, true);
            if Signed {
                NewOpc = getSignExtendedGatherOpcode(NewOpc);
            }
            return DAG.getNode(NewOpc, DL, [ResVT, Other], [Chain, Pg, Base, UnextendedOffset, Ty]);
        }
    }
    return SDValue {};
}

fn performVectorShiftCombine(N: *mut SDNode, TLI: *AArch64TargetLowering, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut Op: SDValue = N.getOperand(0);
    let mut OpScalarSize: u32 = Op.getScalarValueSizeInBits();
    let mut ShiftImm: u32 = N.getConstantOperandVal(1);
    assert!(OpScalarSize > ShiftImm, "Invalid shift imm");
    if  {
        if DCI.DAG.ComputeNumSignBits(Op.getOperand(0), 0) > ShiftImm {
            return Op.getOperand(0);
        }
    }
    if N.getFlags().hasExact() {
        return SDValue {};
    }
    let mut ShiftedOutBits: APInt = getLowBitsSet(OpScalarSize, ShiftImm);
    let mut DemandedMask: APInt = operator(ShiftedOutBits);
    if TLI.SimplifyDemandedBits(Op, DemandedMask, DCI) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn performSunpkloCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOperand(0).getOpcode() == SIGN_EXTEND && operator(operator(N.getOperand(0)).getOperand(0)).getValueType(0).getScalarType() == i1 {
        let mut CC: SDValue = operator(N.getOperand(0)).getOperand(0);
        let mut VT: EVT = operator(CC).getValueType(0).getHalfNumVectorElementsVT(*DAG.getContext());
        let mut Unpk: SDValue = DAG.getExtractSubvector(N, VT, CC, 0);
        return DAG.getNode(SIGN_EXTEND, N, N.getValueType(0), Unpk);
    }
    return SDValue {};
}

fn performPostLD1Combine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, IsLaneOp: bool) -> SDValue {
    if DCI.isBeforeLegalizeOps() {
        return SDValue {};
    }
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut VT: EVT = N.getValueType(0);
    if !VT.is128BitVector() && !VT.is64BitVector() {
        return SDValue {};
    }
    let mut LoadIdx: u32 = if IsLaneOp { 1 } else { 0 };
    let mut LD: *mut LoadSDNode = dyn_cast(N.getOperand(LoadIdx).getNode());
    if !LD {
        return SDValue {};
    }
    if LD.isIndexed() {
        return SDValue {};
    }
    let mut Lane: SDValue = SDValue {};
    if IsLaneOp {
        Lane = N.getOperand(2);
        let mut LaneC: *mut auto = dyn_cast(Lane);
        if operator!() || () >= VT.getVectorNumElements() {
            return SDValue {};
        }
        if LaneC()() == 0 && isNullOrNullSplat(N.getOperand(0), false) {
            return SDValue {};
        }
    }
    let mut LoadSDN: *mut LoadSDNode = cast(LD);
    let mut MemVT: EVT = LoadSDN.getMemoryVT();
    if MemVT != VT.getVectorElementType() {
        return SDValue {};
    }
    if N.hasOneUse() {
        let mut UseOpc: u32 = operator(N.user_begin()).getOpcode();
        if UseOpc == FMUL || UseOpc == FMA {
            return SDValue {};
        }
    }
    let mut Addr: SDValue = LD.getOperand(1);
    let mut Vector: SDValue = N.getOperand(0);
    return SDValue {};
}

fn performTBISimplification(Addr: SDValue, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> bool {
    let mut Subtarget: *auto = DAG;
    let mut NumIgnoreBits: u32 = if () || () { 4 } else { 8 };
    let mut DemandedMask: APInt = getLowBitsSet(64, 64 - NumIgnoreBits);
    let mut Known: KnownBits = KnownBits {};
    let mut TLO: TargetLoweringOpt = TargetLoweringOpt { DAG, !DCI.isBeforeLegalize(), !DCI.isBeforeLegalizeOps() };
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.SimplifyDemandedBits(Addr, DemandedMask, Known, TLO, 0, false) {
        DCI.CommitTargetLoweringOpt(TLO);
        return true;
    }
    return false;
}

fn foldTruncStoreOfExt(DAG: *mut SelectionDAG, N: *mut SDNode) -> SDValue {
    assert!((N.getOpcode() == STORE || N.getOpcode() == MSTORE), "Expected STORE dag node in input!");
    if  {
        if operator!() || () {
            return SDValue {};
        }
        let mut Ext: SDValue = ();
        let mut ExtOpCode: auto = Ext.getOpcode();
        if ExtOpCode() != ZERO_EXTEND &&  != SIGN_EXTEND &&  != ANY_EXTEND {
            return SDValue {};
        }
        let mut Orig: SDValue = operator(Ext).getOperand(0);
        if Store()() != Orig.getValueType() {
            return SDValue {};
        }
        return DAG(Orig);
    }
    return SDValue {};
}

fn combineV3I8LoadExt(LD: *mut LoadSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut MemVT: EVT = LD.getMemoryVT();
    if MemVT != getVectorVT(*DAG.getContext(), i8, 3, false) || LD.getBaseAlign() >= 4 {
        return SDValue {};
    }
    let mut DL: SDLoc = LD;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut Chain: SDValue = LD.getChain();
    let mut BasePtr: SDValue = LD.getBasePtr();
    let mut MMO: *mut MachineMemOperand = LD.getMemOperand();
    assert!(LD.getOffset().isUndef(), "undef offset expected");
    let mut L16: SDValue = DAG.getLoad(i16, DL, Chain, BasePtr, MMO);
    let mut Offset2: TypeSize = getFixed(2);
    let mut L8: SDValue = DAG.getLoad(i8, DL, Chain, DAG.getMemBasePlusOffset(BasePtr, Offset2, DL, SDNodeFlags { Flags: None }), MF.getMachineMemOperand(MMO, 2, 1));
    let mut Ext16: SDValue = DAG.getNode(ZERO_EXTEND, DL, i32, L16);
    let mut Ext8: SDValue = DAG.getNode(ZERO_EXTEND, DL, i32, L8);
    let mut Shl: SDValue = DAG.getNode(SHL, DL, i32, Ext8, DAG.getConstant(16, DL, i32, false, false));
    let mut Or: SDValue = DAG.getNode(OR, DL, i32, Ext16, Shl);
    let mut Cast: SDValue = DAG.getNode(BITCAST, DL, v4i8, Or);
    let mut Extract: SDValue = DAG.getExtractSubvector(DL, MemVT, Cast, 0);
    let mut TokenFactor: SDValue = DAG.getNode(TokenFactor, DL, Other, [cast(L16), cast(L8)]);
    return DAG.getMergeValues([Extract, TokenFactor], DL);
}

fn performLOADCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    if Subtarget.supportsAddressTopByteIgnored() {
        performTBISimplification(N.getOperand(1), DCI, DAG);
    }
    let mut LD: *mut LoadSDNode = cast(N);
    let mut RegVT: EVT = LD.getValueType(0);
    let mut MemVT: EVT = LD.getMemoryVT();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = LD;
    let mut AddrSpace: u32 = LD.getAddressSpace();
    if AddrSpace == PTR64 || AddrSpace == PTR32_SPTR || AddrSpace == PTR32_UPTR {
        let mut PtrVT: MVT = TLI.getPointerTy(DAG.getDataLayout(), 0);
        if PtrVT != LD.getBasePtr().getSimpleValueType() {
            let mut Cast: SDValue = DAG.getAddrSpaceCast(DL, PtrVT, LD.getBasePtr(), AddrSpace, 0, SDNodeFlags { Flags: None });
            return DAG.getExtLoad(LD.getExtensionType(), DL, RegVT, LD.getChain(), Cast, LD.getPointerInfo(), MemVT, LD.getBaseAlign(), LD.getMemOperand().getFlags(), MMOMetadata {});
        }
    }
    if LD.isVolatile() || !Subtarget.isLittleEndian() {
        return SDValue { Node: N, ResNo: 0 };
    }
    if combineV3I8LoadExt(LD, DAG) {
        Res;
    } else {
        return Res;
    }
    if !LD.isNonTemporal() {
        return SDValue { Node: N, ResNo: 0 };
    }
    if MemVT.isScalableVector() || MemVT.getSizeInBits().operator unsigned long long() <= 256 || MemVT.getSizeInBits().operator unsigned long long() % 256 == 0 || 256 % MemVT.getScalarSizeInBits() != 0 {
        return SDValue { Node: N, ResNo: 0 };
    }
    let mut Chain: SDValue = LD.getChain();
    let mut BasePtr: SDValue = LD.getBasePtr();
    let mut Flags: SDNodeFlags = LD.getFlags();
    let mut LoadOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut LoadOpsChain: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut NewVT: MVT = getVectorVT(MemVT.getVectorElementType().getSimpleVT(), 256 / MemVT.getVectorElementType().getSizeInBits().operator unsigned long long());
    let mut Num256Loads: u32 = MemVT.getSizeInBits().operator unsigned long long() / 256;
    for let mut I: u32 = 0; I < Num256Loads; I += 1 {
        let mut PtrOffset: u32 = I * 32;
        let mut NewPtr: SDValue = DAG.getMemBasePlusOffset(BasePtr, getFixed(PtrOffset), DL, Flags);
        let mut NewAlign: Align = commonAlignment(LD.getAlign(), PtrOffset);
        let mut NewLoad: SDValue = DAG.getLoad(NewVT, DL, Chain, NewPtr, LD.getPointerInfo().getWithOffset(PtrOffset), NewAlign, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
        LoadOps.push(NewLoad);
        LoadOpsChain.push(cast(NewLoad));
    }
    let mut BitsRemaining: u32 = MemVT.getSizeInBits().operator unsigned long long() % 256;
    let mut PtrOffset: u32 = (MemVT.getSizeInBits().operator unsigned long long() - BitsRemaining) / 8;
    let mut RemainingVT: MVT = getVectorVT(MemVT.getVectorElementType().getSimpleVT(), BitsRemaining / MemVT.getVectorElementType().getSizeInBits().operator unsigned long long());
    let mut NewPtr: SDValue = DAG.getMemBasePlusOffset(BasePtr, getFixed(PtrOffset), DL, Flags);
    let mut NewAlign: Align = commonAlignment(LD.getAlign(), PtrOffset);
    let mut RemainingLoad: SDValue = DAG.getLoad(RemainingVT, DL, Chain, NewPtr, LD.getPointerInfo().getWithOffset(PtrOffset), NewAlign, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
    let mut PoisonVector: SDValue = DAG.getPOISON(NewVT);
    let mut ExtendedRemainingLoad: SDValue = DAG.getInsertSubvector(DL, PoisonVector, RemainingLoad, 0);
    LoadOps.push(ExtendedRemainingLoad);
    LoadOpsChain.push(cast(RemainingLoad));
    let mut ConcatVT: EVT = getVectorVT(*DAG.getContext(), MemVT.getScalarType(), LoadOps.len * NewVT.getVectorNumElements(), false);
    let mut ConcatVectors: SDValue = DAG;
    let mut ExtractSubVector: SDValue = DAG.getExtractSubvector(DL, MemVT, ConcatVectors, 0);
    let mut TokenFactor: SDValue = DAG;
    return DAG.getMergeValues([ExtractSubVector, TokenFactor], DL);
}

fn tryGetOriginalBoolVectorType(Op: SDValue, Depth: i32) -> EVT {
    let mut VecVT: EVT = Op.getValueType();
    assert!(VecVT.isVectorOf(i1), "Need boolean vector type.");
    if Depth > 3 {
        return INVALID_SIMPLE_VALUE_TYPE;
    }
    if Op.getOpcode() == SETCC || Op.getOpcode() == TRUNCATE {
        return Op.getOperand(0).getValueType();
    }
    let mut BaseVT: EVT = INVALID_SIMPLE_VALUE_TYPE;
    for Operand in operator(Op).op_values() {
        if Operand.getValueType() != VecVT {
            continue;
        }
        let mut OperandVT: EVT = tryGetOriginalBoolVectorType(Operand, Depth + 1);
        if !BaseVT.isSimple() {
            BaseVT = OperandVT;
        } else if OperandVT != BaseVT {
            return INVALID_SIMPLE_VALUE_TYPE;
        }
    }
    return BaseVT;
}

fn getBoolVectorBitcastCompare(Vec: SDValue, RHS: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG, CompareLHS: *mut SDValue, CompareRHS: *mut SDValue) -> bool {
    if DAG.getDataLayout().isBigEndian() {
        return false;
    }
    let mut VecVT: EVT = Vec.getValueType();
    assert!(VecVT.isFixedLengthVector() && VecVT.getVectorElementType() == i1, "Expected a fixed-length bool vector");
    let mut NumElts: u32 = VecVT.getVectorNumElements();
    if NumElts != 2 && NumElts != 4 && NumElts != 8 && NumElts != 16 {
        return false;
    }
    let mut getCanonicalCompareVecVT: Closure_64 = Closure_64 { NumElts: &mut NumElts };
    let mut CompareVecVT: EVT = tryGetOriginalBoolVectorType(Vec, 0);
    if !CompareVecVT.isSimple() || CompareVecVT.getSizeInBits().operator unsigned long long() > 128 {
        CompareVecVT = getCanonicalCompareVecVT();
    }
    CompareVecVT = CompareVecVT.changeVectorElementTypeToInteger();
    if CompareVecVT.getSizeInBits().operator unsigned long long() > 128 {
        return false;
    }
    let mut CompareBits: SDValue = DAG.getSExtOrTrunc(Vec, DL, CompareVecVT);
    let mut CompareBitsSize: u32 = CompareBits.getValueSizeInBits().operator unsigned long long();
    if CompareBitsSize != 64 && CompareBitsSize != 128 {
        CompareVecVT = getCanonicalCompareVecVT();
        CompareBits = DAG.getSExtOrTrunc(Vec, DL, CompareVecVT);
        CompareBitsSize = CompareBits.getValueSizeInBits().operator unsigned long long();
    }
    if CompareBitsSize != 64 && CompareBitsSize != 128 {
        return false;
    }
    let mut IsNull: bool = isNullConstant(RHS);
    if CompareBitsSize == 64 {
        CompareLHS = DAG.getBitcast(i64, CompareBits);
        CompareRHS = if IsNull { DAG.getConstant(0, DL, i64, false, false) } else { DAG.getAllOnesConstant(DL, i64, false, false) };
    } else {
        let mut PairwiseBits: SDValue = DAG.getBitcast(v2i64, CompareBits);
        let mut Lo: SDValue = DAG.getExtractVectorElt(DL, i64, PairwiseBits, 0);
        let mut Hi: SDValue = DAG.getExtractVectorElt(DL, i64, PairwiseBits, 1);
        CompareLHS = DAG.getNode(ADD, DL, i64, Lo, Hi);
        CompareRHS = if IsNull { DAG.getConstant(0, DL, i64, false, false) } else { DAG.getSignedConstant(-2, DL, i64, false, false) };
    }
    return true;
}

fn vectorToScalarBitmask(ComparisonResult: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = ComparisonResult;
    let mut VecVT: EVT = ComparisonResult.getValueType();
    assert!(VecVT.isVector(), "Must be a vector type");
    let mut NumElts: u32 = VecVT.getVectorNumElements();
    if NumElts != 2 && NumElts != 4 && NumElts != 8 && NumElts != 16 {
        return SDValue {};
    }
    if VecVT.getVectorElementType() != i1 && !DAG.getTargetLoweringInfo().isTypeLegal(VecVT) {
        return SDValue {};
    }
    if VecVT.getVectorElementType() == i1 {
        VecVT = tryGetOriginalBoolVectorType(ComparisonResult, 0);
        if !VecVT.isSimple() {
            let mut BitsPerElement: u32 = max(64 / NumElts, 8);
            VecVT = getVectorVT(getIntegerVT(BitsPerElement), NumElts);
        }
    }
    VecVT = VecVT.changeVectorElementTypeToInteger();
    if VecVT.getSizeInBits().operator unsigned long long() > 128 {
        assert!(128 % NumElts == 0, "Expected NumElts to evenly divide 128 bits");
        let mut NarrowedEltBits: u32 = 128 / NumElts;
        if NarrowedEltBits < 8 {
            return SDValue {};
        }
        VecVT = getVectorVT(getIntegerVT(NarrowedEltBits), NumElts);
    }
    ComparisonResult = DAG.getSExtOrTrunc(ComparisonResult, DL, VecVT);
    let mut IsLE: bool = DAG.getDataLayout().isLittleEndian();
    let mut MaskConstants: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    if DAG() && VecVT == v16i8 {
        for let mut Half: u32 = 0; Half < 2; Half += 1 {
            for let mut I: u32 = 0; I < 8; I += 1 {
                let mut MaskBit: u32 = if IsLE { (1 << I) } else { (1 << (7 - I)) };
                MaskConstants.push(DAG.getConstant(MaskBit, DL, i32, false, false));
            }
        }
        let mut Mask: SDValue = DAG;
        let mut RepresentativeBits: SDValue = DAG.getNode(AND, DL, VecVT, ComparisonResult, Mask);
        let mut V: SDValue = RepresentativeBits;
        V = DAG;
        V = DAG;
        V = DAG;
        V = DAG.getNode(BITCAST, DL, v8i16, V);
        return DAG.getExtractVectorElt(DL, i32, V, 0);
    }
    let mut NumEl: u32 = VecVT.getVectorNumElements();
    for let mut I: u32 = 0; I < NumEl; I += 1 {
        let mut MaskBit: u32 = if IsLE { (1 << I) } else { (1 << (NumEl - 1 - I)) };
        MaskConstants.push(DAG.getConstant(MaskBit, DL, i64, false, false));
    }
    let mut Mask: SDValue = DAG;
    let mut RepresentativeBits: SDValue = DAG.getNode(AND, DL, VecVT, ComparisonResult, Mask);
    let mut ResultVT: EVT = getIntegerVT(max(NumElts, VecVT.getVectorElementType().getSizeInBits()));
    return DAG.getNode(VECREDUCE_ADD, DL, ResultVT, RepresentativeBits);
}

fn performCTTZCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if !VT.isScalarInteger() {
        return SDValue {};
    }
    let mut BitcastNode: SDValue = N.getOperand(0);
    if BitcastNode.getOpcode() != BITCAST {
        return SDValue {};
    }
    let mut Predicate: SDValue = BitcastNode.getOperand(0);
    let mut PredVT: EVT = Predicate.getValueType();
    if !PredVT.isFixedLengthVector() || PredVT.getVectorElementType() != i1 {
        return SDValue {};
    }
    let mut NumLanes: u32 = PredVT.getVectorNumElements();
    if !isPowerOf2_32(NumLanes) || NumLanes < 2 || NumLanes > 32 {
        return SDValue {};
    }
    let mut DRegBits: u32 = 64;
    let mut QRegBits: u32 = 128;
    let mut MinLaneBits: u32 = 8;
    let mut MaskVT: EVT = tryGetOriginalBoolVectorType(Predicate, 0);
    if !MaskVT.isSimple() || MaskVT.changeVectorElementTypeToInteger().getSizeInBits().operator unsigned long long() > 2 * QRegBits || MaskVT.changeVectorElementTypeToInteger().getSizeInBits().operator unsigned long long() < DRegBits {
        let mut LaneBits: u32 = max(DRegBits / NumLanes, MinLaneBits);
        MaskVT = getVectorVT(getIntegerVT(LaneBits), NumLanes);
    }
    MaskVT = MaskVT.changeVectorElementTypeToInteger();
    let mut MaskBits: u32 = MaskVT.getSizeInBits().operator unsigned long long();
    if MaskBits != DRegBits && MaskBits != QRegBits && MaskBits != 2 * QRegBits {
        return SDValue {};
    }
    let mut TargetBits: u32 = DRegBits;
    if MaskBits == 2 * QRegBits && NumLanes > 16 {
        TargetBits = QRegBits;
    }
    let mut CompressedBits: u32 = min(MaskBits, TargetBits);
    let mut DL: SDLoc = N;
    let mut Mask: SDValue = DAG.getSExtOrTrunc(Predicate, DL, MaskVT);
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    let mut ShrnPair: Closure_65 = Closure_65 { Ctx: &mut Ctx, DAG: &mut DAG, DL: &mut DL };
    let mut CompressedCttz: Closure_66 = Closure_66 { DAG: &mut DAG, DL: &mut DL };
    let mut Cur: SDValue = Mask;
    while Cur.getValueType().getScalarSizeInBits() > MinLaneBits && Cur.getValueType().getSizeInBits().operator unsigned long long() > CompressedBits {
        let mut CurVT: EVT = Cur.getValueType();
        let mut CurLaneBits: u32 = CurVT.getScalarSizeInBits();
        let mut NarrowVT: EVT = CurVT.changeVectorElementType(Ctx, getIntegerVT(Ctx, CurLaneBits / 2));
        Cur = DAG.getNode(TRUNCATE, DL, NarrowVT, Cur);
    }
    if Cur.getValueType().getSizeInBits().operator unsigned long long() > CompressedBits {
        let mut CurVT: EVT = Cur.getValueType();
        if CurVT.getSizeInBits().operator unsigned long long() <= QRegBits {
            Cur = ShrnPair.call(Cur);
        } else {
            let mut HalfVT: EVT = CurVT.getHalfNumVectorElementsVT(Ctx);
            let mut Lo: SDValue = DAG.getExtractSubvector(DL, HalfVT, Cur, 0);
            let mut Hi: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, HalfVT, Cur, DAG.getConstant(HalfVT.getVectorNumElements(), DL, i64, false, false));
            Cur = DAG.getNode(CONCAT_VECTORS, DL, HalfVT, ShrnPair.call(Lo), ShrnPair.call(Hi));
        }
    }
    assert!(Cur.getValueType().getSizeInBits().operator unsigned long long() == CompressedBits, "Unexpected mask width!");
    let mut Ctz: SDValue = CompressedCttz.call(Cur);
    let mut LaneIndexShift: u32 = Log2_32(CompressedBits / NumLanes);
    if LaneIndexShift {
        Ctz = DAG.getNode(SRL, DL, i64, Ctz, DAG.getShiftAmountConstant(LaneIndexShift, i64, DL));
    }
    return DAG.getSExtOrTrunc(Ctz, DL, VT);
}

fn combineBoolVectorAndTruncateStore(DAG: *mut SelectionDAG, Store: *mut StoreSDNode) -> SDValue {
    if !Store.isTruncatingStore() {
        return SDValue {};
    }
    let mut DL: SDLoc = Store;
    let mut VecOp: SDValue = Store.getValue();
    let mut VT: EVT = VecOp.getValueType();
    let mut MemVT: EVT = Store.getMemoryVT();
    if !MemVT.isVector() || !VT.isVector() || MemVT.getVectorElementType() != i1 {
        return SDValue {};
    }
    if VecOp.getOpcode() == BUILD_VECTOR {
        return SDValue {};
    }
    VecOp = DAG.getNode(TRUNCATE, DL, MemVT, VecOp);
    let mut VectorBits: SDValue = vectorToScalarBitmask(VecOp, DAG);
    if !VectorBits {
        return SDValue {};
    }
    let mut StoreVT: EVT = getIntegerVT(*DAG.getContext(), MemVT.getStoreSizeInBits().operator unsigned long long());
    let mut ExtendedBits: SDValue = DAG.getZExtOrTrunc(VectorBits, DL, StoreVT);
    return DAG.getStore(Store.getChain(), DL, ExtendedBits, Store.getBasePtr(), Store.getMemOperand());
}

fn combineStoreValueFPToInt(ST: *mut StoreSDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    if !Subtarget.isNeonAvailable() {
        return SDValue {};
    }
    let mut Value: SDValue = ST.getValue();
    if Value.getValueType().isVector() {
        return SDValue {};
    }
    while operator(Value).isAssert() {
        Value = Value.getOperand(0);
    }
    if Value.getOpcode() != FP_TO_SINT && Value.getOpcode() != FP_TO_UINT {
        return SDValue {};
    }
    if !operator(Value).hasOneUse() {
        return SDValue {};
    }
    let mut FPSrc: SDValue = Value.getOperand(0);
    let mut SrcVT: EVT = FPSrc.getValueType();
    if SrcVT != f32 && SrcVT != f64 {
        return SDValue {};
    }
    let mut VT: EVT = Value.getSimpleValueType();
    if VT != SrcVT.changeTypeToInteger() {
        return SDValue {};
    }
    let mut NumElements: u32 = 128 / SrcVT.getFixedSizeInBits();
    let mut VecSrcVT: EVT = getVectorVT(*DAG.getContext(), SrcVT, NumElements, false);
    let mut VecDstVT: EVT = VecSrcVT.changeTypeToInteger();
    let mut DL: SDLoc = ST;
    let mut VecFP: SDValue = DAG.getNode(SCALAR_TO_VECTOR, DL, VecSrcVT, FPSrc);
    let mut VecConv: SDValue = DAG.getNode(Value.getOpcode(), DL, VecDstVT, VecFP);
    let mut Extracted: SDValue = DAG.getExtractVectorElt(DL, VT, VecConv, 0);
    DCI.CombineTo(ST.getValue().getNode(), Extracted, true);
    return SDValue { Node: ST, ResNo: 0 };
}

fn isHalvingTruncateOfLegalScalableType(SrcVT: EVT, DstVT: EVT) -> bool {
    return (SrcVT == nxv8i16 && DstVT == nxv8i8) || (SrcVT == nxv4i32 && DstVT == nxv4i16) || (SrcVT == nxv2i64 && DstVT == nxv2i32);
}

fn combineI8TruncStore(ST: *mut StoreSDNode, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut Value: SDValue = ST.getValue();
    let mut ValueVT: EVT = Value.getValueType();
    if ST.isVolatile() || !Subtarget.isLittleEndian() || Value.getOpcode() != TRUNCATE || ValueVT != getVectorVT(*DAG.getContext(), i8, 3, false) {
        return SDValue {};
    }
    assert!(ST.getOffset().isUndef(), "undef offset expected");
    let mut DL: SDLoc = ST;
    let mut WideVT: EVT = getVectorVT(*DAG.getContext(), operator(Value).getOperand(0).getValueType().getVectorElementType(), 4, false);
    if !DAG.getTargetLoweringInfo().isTypeLegal(WideVT) {
        return SDValue {};
    }
    let mut PoisonVector: SDValue = DAG.getPOISON(WideVT);
    let mut WideTrunc: SDValue = DAG.getNode(INSERT_SUBVECTOR, DL, WideVT, [PoisonVector, operator(Value).getOperand(0), DAG.getVectorIdxConstant(0, DL, false)]);
    let mut Cast: SDValue = DAG.getNode(BITCAST, DL, if WideVT.getSizeInBits().operator unsigned long long() == 64 { v8i8 } else { v16i8 }, WideTrunc);
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut Chain: SDValue = ST.getChain();
    let mut MMO: *mut MachineMemOperand = ST.getMemOperand();
    let mut IdxScale: u32 = WideVT.getScalarSizeInBits() / 8;
    let mut E2: SDValue = DAG.getExtractVectorElt(DL, i8, Cast, IdxScale * 2);
    let mut Offset2: TypeSize = getFixed(2);
    let mut Ptr2: SDValue = DAG.getMemBasePlusOffset(ST.getBasePtr(), Offset2, DL, SDNodeFlags { Flags: None });
    Chain = DAG.getStore(Chain, DL, E2, Ptr2, MF.getMachineMemOperand(MMO, 2, 1));
    let mut E1: SDValue = DAG.getExtractVectorElt(DL, i8, Cast, IdxScale);
    let mut Offset1: TypeSize = getFixed(1);
    let mut Ptr1: SDValue = DAG.getMemBasePlusOffset(ST.getBasePtr(), Offset1, DL, SDNodeFlags { Flags: None });
    Chain = DAG.getStore(Chain, DL, E1, Ptr1, MF.getMachineMemOperand(MMO, 1, 1));
    let mut E0: SDValue = DAG.getExtractVectorElt(DL, i8, Cast, 0);
    Chain = DAG.getStore(Chain, DL, E0, ST.getBasePtr(), MF.getMachineMemOperand(MMO, 0, 1));
    return Chain;
}

fn getFPSubregForVT(VT: EVT) -> u32 {
    assert!(VT.isSimple(), "Expected simple VT");
    match VT.getSimpleVT().SimpleTy {
        aarch64mfp8 => {
            
        },
        f16 => {
            
        },
        f32 => {
            
        },
        f64 => {
            
        },
        _ => {
            llvm_unreachable_internal("Unexpected VT!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 27899);
        },
    }
}

fn performSTORECombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget) -> SDValue {
    let mut ST: *mut StoreSDNode = cast(N);
    let mut Chain: SDValue = ST.getChain();
    let mut Value: SDValue = ST.getValue();
    let mut Ptr: SDValue = ST.getBasePtr();
    let mut ValueVT: EVT = Value.getValueType();
    let mut MemVT: EVT = ST.getMemoryVT();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = ST;
    let mut SVBool: SDValue = SDValue {};
    if DCI.isBeforeLegalize() && Subtarget.isSVEorStreamingSVEAvailable() && isNormalStore(N) && ValueVT.isFixedLengthVectorOf(i8) && ValueVT.getSizeInBits().operator unsigned long long() == Subtarget.getSVEPredicateSizeInBits() && sd_match(Value, m_ExtractSubvector(m_BitCast(m_SpecificVT(nxv16i1, m_Value(SVBool))), m_SpecificInt(0))) {
        return DAG.getStore(Chain, DL, SVBool, Ptr, ST.getPointerInfo(), ST.getBaseAlign(), ST.getMemOperand().getFlags(), MMOMetadata { AAInfo: ST.getAAInfo(), Ranges: null, MemCacheHint: null });
    }
    if combineStoreValueFPToInt(ST, DCI, DAG, Subtarget) {
        Res;
    } else {
        return Res;
    }
    if performInterleavedStoreCombine(N, DCI, DAG) {
        Res;
    } else {
        return Res;
    }
    if performLegalizedInterleavedStoreCombine(ST, DCI, DAG) {
        Res;
    } else {
        return Res;
    }
    let mut AddrSpace: u32 = ST.getAddressSpace();
    if AddrSpace == PTR64 || AddrSpace == PTR32_SPTR || AddrSpace == PTR32_UPTR {
        let mut PtrVT: MVT = TLI.getPointerTy(DAG.getDataLayout(), 0);
        if PtrVT != Ptr.getSimpleValueType() {
            let mut Cast: SDValue = DAG.getAddrSpaceCast(DL, PtrVT, Ptr, AddrSpace, 0, SDNodeFlags { Flags: None });
            return DAG.getStore(Chain, DL, Value, Cast, ST.getPointerInfo(), ST.getBaseAlign(), ST.getMemOperand().getFlags(), MMOMetadata { AAInfo: ST.getAAInfo(), Ranges: null, MemCacheHint: null });
        }
    }
    if combineI8TruncStore(ST, DAG, Subtarget) {
        Res;
    } else {
        return Res;
    }
    let mut hasValidElementTypeForFPTruncStore: Closure_67 = Closure_67 {};
    if DCI.isBeforeLegalizeOps() && Value.getOpcode() == FP_ROUND && operator(Value).hasOneUse() && ST.isUnindexed() && Subtarget.useSVEForFixedLengthVectors() && ValueVT.isFixedLengthVector() && ValueVT.getFixedSizeInBits() >= Subtarget.getMinSVEVectorSizeInBits() && hasValidElementTypeForFPTruncStore.call(Value.getValueType(), Value.getOperand(0).getValueType()) {
        return DAG.getTruncStore(Chain, DL, Value.getOperand(0), Ptr, MemVT, ST.getMemOperand());
    }
    if splitStores(N, DCI, DAG, Subtarget) {
        Split;
    } else {
        return Split;
    }
    if Subtarget.supportsAddressTopByteIgnored() && performTBISimplification(N.getOperand(2), DCI, DAG) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if foldTruncStoreOfExt(DAG, N) {
        Store;
    } else {
        return Store;
    }
    if combineBoolVectorAndTruncateStore(DAG, ST) {
        Store;
    } else {
        return Store;
    }
    if ST.isTruncatingStore() && isHalvingTruncateOfLegalScalableType(ValueVT, MemVT) {
        if trySimplifySrlAddToRshrnb(ST.getOperand(1), DAG, Subtarget) {
            Rshrnb;
        } else {
            return DAG.getTruncStore(ST.getChain(), ST, Rshrnb, ST.getBasePtr(), MemVT, ST.getMemOperand());
        }
    }
    if DCI.isAfterLegalizeDAG() && ST.isUnindexed() && Value.getOpcode() == EXTRACT_VECTOR_ELT {
        let mut Vector: SDValue = Value.getOperand(0);
        let mut ExtIdx: SDValue = Value.getOperand(1);
        let mut VectorVT: EVT = Vector.getValueType();
        let mut ElemVT: EVT = VectorVT.getVectorElementType();
        if !ValueVT.isInteger() {
            return SDValue {};
        }
        if isConstantSplatVectorAllZeros(Vector.getNode(), false) {
            let mut ZeroElt: SDValue = DAG.getConstant(0, DL, ValueVT, false, false);
            DAG.ReplaceAllUsesWith(Value, ZeroElt);
            return SDValue {};
        }
        if ValueVT != MemVT && !ST.isTruncatingStore() {
            return SDValue {};
        }
        let mut ExtCst: *mut auto = dyn_cast(ExtIdx);
        if (operator!() || operator!()) && !Value.hasOneUse() {
            return SDValue {};
        }
        if Subtarget.isNeonAvailable() && ElemVT == MemVT && (VectorVT.is64BitVector() || VectorVT.is128BitVector()) &&  && operator!() && ST.getBasePtr().getOpcode() != ADD {
            return SDValue {};
        }
        if MemVT == i64 || MemVT == i32 {}
        let mut ExtVector: SDValue = Vector;
        if operator!() || operator!() {
            let mut Ext: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, Value.getValueType(), Vector, ExtIdx);
            ExtVector = DAG.getInsertVectorElt(DL, DAG.getPOISON(VectorVT), Ext, 0);
        }
        let mut FPMemVT: EVT = if MemVT == i8 { aarch64mfp8 } else { getFloatingPointVT(MemVT.getSizeInBits().operator unsigned long long()) };
        let mut FPSubreg: SDValue = DAG.getTargetExtractSubreg(getFPSubregForVT(FPMemVT), DL, FPMemVT, ExtVector);
        return DAG.getStore(ST.getChain(), DL, FPSubreg, ST.getBasePtr(), ST.getMemOperand());
    }
    return SDValue {};
}

fn isSequentialConcatOfVectorInterleave(N: *mut SDNode, Ops: *mut SmallVectorImpl<SDValue>) -> bool {
    if N.getOpcode() != CONCAT_VECTORS {
        return false;
    }
    let mut NumParts: u32 = N.getNumOperands();
    let mut InterleaveOp: *mut SDNode = N.getOperand(0).getNode();
    if InterleaveOp.getOpcode() != VECTOR_INTERLEAVE || InterleaveOp.getNumOperands() != NumParts {
        return false;
    }
    for let mut I: u32 = 0; I < NumParts; I += 1 {
        if N.getOperand(I) != SDValue { Node: InterleaveOp, ResNo: I } {
            return false;
        }
    }
    Ops;
    return true;
}

fn isSplatVectorInterleaveOps(DAG: *mut SelectionDAG, DL: SDLoc, WideValue: SDValue, Ops: *mut SmallVectorImpl<SDValue>) -> bool {
    let mut WideVT: EVT = WideValue.getValueType();
    if !WideVT.isScalableVector() {
        return false;
    }
    let mut SplatValue: SDValue = DAG.getSplatValue(WideValue, false);
    if !SplatValue {
        return false;
    }
    let mut WideSize: TypeSize = WideVT.getSizeInBits();
    if !WideSize.isKnownMultipleOf(128) {
        return false;
    }
    let mut NumParts: u32 = WideSize.getKnownMinValue() / 128;
    if NumParts != 2 && NumParts != 3 && NumParts != 4 {
        return false;
    }
    let mut WideEC: ElementCount = WideVT.getVectorElementCount();
    if !WideEC.isKnownMultipleOf(NumParts) {
        return false;
    }
    let mut SubVecTy: EVT = getVectorVT(*DAG.getContext(), WideVT.getVectorElementType(), WideEC.divideCoefficientBy(NumParts));
    if SubVecTy.getSizeInBits().getKnownMinValue() != 128 || !DAG.getTargetLoweringInfo().isTypeLegal(SubVecTy) {
        return false;
    }
    let mut NarrowSplat: SDValue = DAG.getNode(SPLAT_VECTOR, DL, SubVecTy, SplatValue);
    Ops.append(NumParts, NarrowSplat);
    return true;
}

fn getNarrowMaskForInterleavedOps(DAG: *mut SelectionDAG, DL: *mut SDLoc, WideMask: SDValue, RequiredNumParts: u32) -> SDValue {
    if operator(WideMask).getOpcode() == CONCAT_VECTORS {
        let mut MaskInterleaveOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
        if !isSequentialConcatOfVectorInterleave(WideMask.getNode(), MaskInterleaveOps) {
            return SDValue {};
        }
        if MaskInterleaveOps.len != RequiredNumParts {
            return SDValue {};
        }
        if !all_equal(MaskInterleaveOps) {
            return SDValue {};
        }
        return MaskInterleaveOps[0];
    }
    if operator(WideMask).getOpcode() != SPLAT_VECTOR {
        return SDValue {};
    }
    let mut EC: ElementCount = WideMask.getValueType().getVectorElementCount();
    assert!(EC.isKnownMultipleOf(RequiredNumParts), "Expected element count divisible by number of parts");
    EC = EC.divideCoefficientBy(RequiredNumParts);
    return DAG.getNode(SPLAT_VECTOR, DL, getVectorVT(i1, EC), operator(WideMask).getOperand(0));
}

fn performInterleavedStoreCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut WideValue: SDValue = SDValue {};
    let mut Chain: SDValue = SDValue {};
    let mut BasePtr: SDValue = SDValue {};
    let mut Mask: SDValue = SDValue {};
    let mut IsMasked: bool = false;
    if  {
        if operator!(isNormalMaskedStore()) || operator!() || operator!(()()) {
            return SDValue {};
        }
        WideValue = ();
        Chain = ();
        BasePtr = ();
        Mask = ();
        IsMasked = true;
    } else {
        let mut ST: *mut auto = cast(N);
        if operator!(isNormalStore()) || operator!() || operator!(()()) {
            return SDValue {};
        }
        WideValue = ();
        Chain = ();
        BasePtr = ();
    }
    let mut DL: SDLoc = N;
    let mut ValueInterleaveOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    if isSequentialConcatOfVectorInterleave(WideValue.getNode(), ValueInterleaveOps) {
        if !WideValue.hasOneUse() {
            return SDValue {};
        }
    } else if !isSplatVectorInterleaveOps(DAG, DL, WideValue, ValueInterleaveOps) {
        return SDValue {};
    }
    let mut NumParts: u32 = ValueInterleaveOps.len;
    if NumParts != 2 && NumParts != 3 && NumParts != 4 {
        return SDValue {};
    }
    let mut SubVecTy: EVT = ValueInterleaveOps[0].getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isTypeLegal(SubVecTy) {
        return SDValue {};
    }
    let mut IsScalable: bool = SubVecTy.isScalableVector();
    let mut SubBits: u32 = SubVecTy.getSizeInBits().getKnownMinValue();
    if IsScalable && SubBits != 128 {
        return SDValue {};
    }
    let mut MemN: *mut auto = cast(N);
    if IsScalable {
        let mut Pred: SDValue = SDValue {};
        if IsMasked {
            Pred = getNarrowMaskForInterleavedOps(DAG, DL, Mask, NumParts);
            if !Pred {
                return SDValue {};
            }
        } else {
            let mut PredVT: EVT = SubVecTy.changeVectorElementType(*DAG.getContext(), i1);
            Pred = DAG.getConstant(1, DL, PredVT, false, false);
        }
        let mut IID: ID = zeroed();
        match NumParts {
            2 => {
                
            },
            3 => {
                
            },
            4 => {
                
            },
        }
        let mut Ops: SmallVector<SDValue, 8> = zeroed();
        Ops()(void { Chain, DAG.getConstant(IID, DL, i32, false, false) });
        Ops()(ValueInterleaveOps);
        Ops()(void { Pred, BasePtr });
        return DAG(INTRINSIC_VOID, DL, DAG.getVTList(Other));
    }
    let mut Subtarget: *AArch64Subtarget = DAG;
    if !IsMasked && (SubBits == 64 || SubBits == 128) && Subtarget.isNeonAvailable() {
        let mut NEONStores: []ID = zeroed();
        let mut Ops: SmallVector<SDValue, 8> = zeroed();
        Ops()(Chain);
        Ops()(DAG.getTargetConstant(NEONStores[NumParts - 2], DL, i64, false));
        Ops()(ValueInterleaveOps);
        Ops()(BasePtr);
        return DAG(INTRINSIC_VOID, DL, DAG.getVTList(Other));
    }
    if !Subtarget.isSVEorStreamingSVEAvailable() {
        return SDValue {};
    }
    let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, SubVecTy);
    let mut Pred: SDValue = SDValue {};
    if IsMasked {
        Pred = getNarrowMaskForInterleavedOps(DAG, DL, Mask, NumParts);
        if !Pred {
            return SDValue {};
        }
        let mut MaskVT: EVT = SubVecTy.changeTypeToInteger();
        if Pred.getValueType() != MaskVT {
            Pred = DAG.getNode(SIGN_EXTEND, DL, MaskVT, Pred);
        }
        Pred = convertFixedMaskToScalableVector(Pred, DAG);
    } else {
        Pred = getPredicateForFixedLengthVector(DAG, DL, SubVecTy);
    }
    let mut SVEStores: []ID = zeroed();
    let mut Ops: SmallVector<SDValue, 8> = zeroed();
    Ops()(void { Chain, DAG.getConstant(SVEStores[NumParts - 2], DL, i32, false, false) });
    for V in ValueInterleaveOps {
        Ops()(convertToScalableVector(DAG, ContainerVT, V));
    }
    Ops()(void { Pred, BasePtr });
    return DAG(INTRINSIC_VOID, DL, DAG.getVTList(Other));
}

fn performLegalizedInterleavedStoreCombine(ST: *mut StoreSDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.getDAGCombineLevel() < AfterLegalizeTypes || operator!(DAG()) {
        return SDValue {};
    }
    let mut StoredValue: SDValue = ST.getValue();
    let mut Interleave: *mut SDNode = StoredValue.getNode();
    if Interleave.getOpcode() != VECTOR_INTERLEAVE {
        return SDValue {};
    }
    let mut NumParts: u32 = Interleave.getNumOperands();
    if NumParts < 2 || NumParts > 4 {
        return SDValue {};
    }
    let mut SubVecTy: EVT = Interleave.getValueType(0);
    if !SubVecTy.is64BitVector() && !SubVecTy.is128BitVector() {
        return SDValue {};
    }
    let mut Stores: SmallVector<StoreSDNode *, 4> = zeroed();
    for Use in Interleave.uses() {
        let mut ResNo: u32 = Use.getResNo();
        let mut Store: *mut auto = dyn_cast(Use.getUser());
        if Stores()[ResNo] || operator!() {
            return SDValue {};
        }
        Stores()[ResNo] = ;
    }
    if is_contained(null) {
        return SDValue {};
    }
    let mut BaseStore: *mut StoreSDNode = [0];
    let mut Bytes: u32 = SubVecTy.getStoreSize().getFixedValue();
    let mut NEONStores: []ID = zeroed();
    let mut DL: SDLoc = Interleave;
    let mut Ops: SmallVector<SDValue, 8> = zeroed();
    Ops()(Interleave.op_begin(), Interleave.op_end());
    Ops()(BaseStore.getBasePtr());
    let mut MemVT: EVT = getVectorVT(*DAG.getContext(), SubVecTy.getVectorElementType(), SubVecTy.getVectorElementCount() * NumParts);
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(BaseStore.getMemOperand(), 0, NumParts * Bytes);
    let mut NewStore: SDValue = DAG(INTRINSIC_VOID, DL, DAG.getVTList(Other), MemVT, MMO);
    return NewStore;
}

fn expandScalableCompressingStore(Store: *mut MaskedStoreSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Store;
    let mut VT: EVT = Store.getValue().getValueType();
    assert!(VT.isScalableVector() && Store.isCompressingStore(), "Expected a scalable compressing store");
    let mut MaskVT: EVT = Store.getMask().getValueType();
    let mut Zero: SDValue = DAG.getConstant(0, DL, i64, false, false);
    let mut CntActive: SDValue = DAG(INTRINSIC_WO_CHAIN, DL, i64, DAG, Store.getMask(), Store.getMask());
    let mut CompressedValue: SDValue = DAG.getNode(VECTOR_COMPRESS, DL, VT, Store.getValue(), Store.getMask(), DAG.getPOISON(VT));
    let mut CompressedMask: SDValue = DAG.getNode(GET_ACTIVE_LANE_MASK, DL, MaskVT, Zero, CntActive);
    return DAG.getMaskedStore(Store.getChain(), DL, CompressedValue, Store.getBasePtr(), Store.getOffset(), CompressedMask, Store.getMemoryVT(), Store.getMemOperand(), Store.getAddressingMode(), Store.isTruncatingStore(), false);
}

fn performMSTORECombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG, Subtarget: *AArch64Subtarget, TLI: *AArch64TargetLowering) -> SDValue {
    let mut MST: *mut MaskedStoreSDNode = cast(N);
    let mut Value: SDValue = MST.getValue();
    let mut Mask: SDValue = MST.getMask();
    let mut DL: SDLoc = N;
    let mut VT: EVT = MST.getValue().getValueType();
    if MST.isCompressingStore() && VT.isScalableVector() && TLI.isOperationLegalOrCustomOrPromote(VECTOR_COMPRESS, VT, false) {
        return expandScalableCompressingStore(MST, DAG);
    }
    if performInterleavedStoreCombine(N, DCI, DAG) {
        Res;
    } else {
        return Res;
    }
    if  {
        Value = Value.getOperand(0);
        if Value.getOpcode() == BITCAST {
            let mut HalfVT: EVT = Value.getValueType().getHalfNumVectorElementsVT(*DAG.getContext());
            let mut InVT: EVT = Value.getOperand(0).getValueType();
            if HalfVT.widenIntegerVectorElementType(*DAG.getContext()) == InVT {
                let mut MinSVESize: u32 = Subtarget.getMinSVEVectorSizeInBits();
                let mut PgPattern: u32 = operator(Mask).getConstantOperandVal(0);
                let mut NumElts: u32 = getNumElementsFromSVEPredPattern(PgPattern);
                if NumElts && NumElts * InVT.getVectorElementType().getSizeInBits().operator unsigned long long() <= MinSVESize {
                    Mask = getPTrue(DAG, DL, InVT.changeVectorElementType(*DAG.getContext(), i1), PgPattern);
                    return DAG.getMaskedStore(MST.getChain(), DL, Value.getOperand(0), MST.getBasePtr(), MST.getOffset(), Mask, MST.getMemoryVT(), MST.getMemOperand(), MST.getAddressingMode(), true, false);
                }
            }
        }
    }
    if MST.isTruncatingStore() {
        let mut ValueVT: EVT = operator(Value).getValueType(0);
        let mut MemVT: EVT = MST.getMemoryVT();
        if !isHalvingTruncateOfLegalScalableType(ValueVT, MemVT) {
            return SDValue {};
        }
        if trySimplifySrlAddToRshrnb(Value, DAG, Subtarget) {
            Rshrnb;
        } else {
            return DAG.getMaskedStore(MST.getChain(), DL, Rshrnb, MST.getBasePtr(), MST.getOffset(), MST.getMask(), MST.getMemoryVT(), MST.getMemOperand(), MST.getAddressingMode(), true, false);
        }
    }
    return SDValue {};
}

fn foldIndexIntoBase(BasePtr: *mut SDValue, Index: *mut SDValue, Scale: SDValue, DL: SDLoc, DAG: *mut SelectionDAG) -> bool {
    let mut IndexVT: EVT = Index.getValueType();
    if !IndexVT.isVectorOf(i64) {
        return false;
    }
    if Index.getOpcode() == ADD {
        if DAG.getSplatValue(Index.getOperand(1), false) {
            Offset;
        } else {
            Offset = DAG.getNode(MUL, DL, i64, Offset, Scale);
            BasePtr = DAG.getNode(ADD, DL, i64, BasePtr, Offset);
            Index = Index.getOperand(0);
            return true;
        }
    }
    if Index.getOpcode() == SHL && Index.getOperand(0).getOpcode() == ADD {
        let mut Add: SDValue = Index.getOperand(0);
        let mut ShiftOp: SDValue = Index.getOperand(1);
        let mut OffsetOp: SDValue = Add.getOperand(1);
        if DAG.getSplatValue(ShiftOp, false) {
            Shift;
        } else if DAG.getSplatValue(OffsetOp, false) {
            Offset;
        } else {
            Offset = DAG.getNode(SHL, DL, i64, Offset, Shift);
            Offset = DAG.getNode(MUL, DL, i64, Offset, Scale);
            BasePtr = DAG.getNode(ADD, DL, i64, BasePtr, Offset);
            Index = DAG.getNode(SHL, DL, Index.getValueType(), Add.getOperand(0), ShiftOp);
            return true;
        }
    }
    return false;
}

fn findMoreOptimalIndexType(N: *MaskedGatherScatterSDNode, BasePtr: *mut SDValue, Index: *mut SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut Changed: bool = false;
    while foldIndexIntoBase(BasePtr, Index, N.getScale(), N, DAG) {
        Changed = true;
    }
    let mut IndexVT: EVT = Index.getValueType();
    let mut DataVT: EVT = N.getOperand(1).getValueType();
    if IndexVT.getVectorElementType() != i64 || IndexVT == nxv2i64 {
        return Changed;
    }
    if DataVT.isFixedLengthVector() && DataVT.getScalarSizeInBits() == 64 {
        return Changed;
    }
    if isVectorShrinkable(Index.getNode(), 32, N.isIndexSigned()) {
        let mut NewIndexVT: EVT = IndexVT.changeVectorElementType(*DAG.getContext(), i32);
        Index = DAG.getNode(TRUNCATE, N, NewIndexVT, Index);
        return true;
    }
    let mut Stride: i64 = 0;
    if Index.getOpcode() == STEP_VECTOR {
        Stride = cast(Index.getOperand(0))();
    }
    if Stride == 0 {
        return Changed;
    }
    if Stride < min() || Stride > max() {
        return Changed;
    }
    let mut Subtarget: *auto = DAG;
    let mut MaxVScale: u32 = () / SVEBitsPerBlock;
    let mut LastElementOffset: i64 = IndexVT.getVectorMinNumElements() * Stride * MaxVScale;
    if LastElementOffset < min() || LastElementOffset > max() {
        return Changed;
    }
    let mut NewIndexVT: EVT = IndexVT.changeVectorElementType(*DAG.getContext(), i32);
    Index = DAG.getStepVector(N, NewIndexVT, APInt { 32, Stride, true, false });
    return true;
}

fn performMaskedGatherScatterCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut MGS: *mut MaskedGatherScatterSDNode = cast(N);
    let mut DL: SDLoc = MGS;
    let mut Chain: SDValue = MGS.getChain();
    let mut Scale: SDValue = MGS.getScale();
    let mut Index: SDValue = MGS.getIndex();
    let mut Mask: SDValue = MGS.getMask();
    let mut BasePtr: SDValue = MGS.getBasePtr();
    let mut IndexType: MemIndexType = MGS.getIndexType();
    if !findMoreOptimalIndexType(MGS, BasePtr, Index, DAG) {
        return SDValue {};
    }
    if  {
        let mut PassThru: SDValue = ();
        let mut Ops: [6]SDValue = [Chain, PassThru, Mask, BasePtr, Index, Scale];
        return DAG.getMaskedGather(DAG.getVTList(N.getValueType(0), Other), DL, Ops, IndexType);
    }
    if  {
        let mut Data: SDValue = ();
        let mut Ops: [6]SDValue = [Chain, Data, Mask, BasePtr, Index, Scale];
        return DAG.getMaskedScatter(DAG.getVTList(Other), DL, Ops, IndexType);
    }
    let mut HG: *mut auto = cast(MGS);
    if HG()()()() > Index.getValueType().getScalarSizeInBits() {
        return SDValue {};
    }
    let mut Ops: []SDValue = void { Chain, Mask, BasePtr, Index, Scale, () };
    return DAG.getMaskedHistogram(DAG.getVTList(Other), DL, Ops, IndexType);
}

fn performNEONPostLDSTCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if DCI.isBeforeLegalize() || DCI.isCalledByLegalizer() {
        return SDValue {};
    }
    let mut AddrOpIdx: u32 = N.getNumOperands() - 1;
    let mut Addr: SDValue = N.getOperand(AddrOpIdx);
    for Use in operator(Addr).uses() {
        let mut User: *mut SDNode = Use.getUser();
        if User.getOpcode() != ADD || Use.getResNo() != Addr.getResNo() {
            continue;
        }
        let mut Visited: SmallPtrSet<const SDNode *, 32> = zeroed();
        let mut Worklist: SmallVector<const SDNode *, 16> = zeroed();
        Visited()(Addr.getNode());
        Worklist()(N);
        Worklist()(User);
        if hasPredecessorHelper(N) || hasPredecessorHelper(User) {
            continue;
        }
        let mut IsStore: bool = false;
        let mut IsLaneOp: bool = false;
        let mut IsDupOp: bool = false;
        let mut NewOpc: u32 = 0;
        let mut NumVecs: u32 = 0;
        let mut IntNo: u32 = N.getConstantOperandVal(1);
        match IntNo {
            _ => {
                llvm_unreachable_internal("unexpected intrinsic for Neon base update", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 28667);
            },
        }
        let mut VecTy: EVT = EVT {};
        if IsStore {
            VecTy = N.getOperand(2).getValueType();
        } else {
            VecTy = N.getValueType(0);
        }
        let mut Inc: SDValue = User.getOperand(if User.getOperand(0) == Addr { 1 } else { 0 });
        if dyn_cast(Inc.getNode()) {
            CInc;
        } else {
            let mut IncVal: u64 = CInc.getZExtValue();
            let mut NumBytes: u64 = NumVecs * VecTy.getSizeInBits().operator unsigned long long() / 8;
            if IsLaneOp || IsDupOp {
                NumBytes /= VecTy.getVectorNumElements();
            }
            if IncVal != NumBytes {
                continue;
            }
            Inc = DAG.getRegister;
        }
        let mut Ops: SmallVector<SDValue, 8> = zeroed();
        Ops()(N.getOperand(0));
        if IsLaneOp || IsStore {
            for let mut i: u32 = 2; i < AddrOpIdx; i += 1 {
                Ops()(N.getOperand(i));
            }
        }
        Ops()(Addr);
        Ops()(Inc);
        let mut Tys: [6]EVT = [6]EVT {};
        let mut NumResultVecs: u32 = (if IsStore { 0 } else { NumVecs });
        let mut n: u32 = 0;
        for n = 0; n < NumResultVecs; n += 1 {
            Tys[n] = VecTy;
        }
        Tys[n += 1] = i64;
        Tys[n] = Other;
        let mut SDTys: SDVTList = DAG(Tys(NumResultVecs + 2));
        let mut MemInt: *mut MemIntrinsicSDNode = cast(N);
        let mut UpdN: SDValue = DAG(NewOpc, N, SDTys, MemInt.getMemoryVT(), MemInt.getMemOperand());
        let mut NewResults: i32 = 0;
        for let mut i: u32 = 0; i < NumResultVecs; i += 1 {
            NewResults()(SDValue { Node: UpdN.getNode(), ResNo: i });
        }
        NewResults()(SDValue { Node: UpdN.getNode(), ResNo: NumResultVecs + 1 });
        DCI(N);
        DCI.CombineTo(User, SDValue { Node: UpdN.getNode(), ResNo: NumResultVecs }, true);
        break;
    }
    return SDValue {};
}

fn checkValueWidth(V: SDValue, width: u32, ExtType: *mut LoadExtType) -> bool {
    ExtType = NON_EXTLOAD;
    match V.getOpcode() {
        _ => {
            return false;
        },
        LOAD => {
            let mut LoadNode: *mut LoadSDNode = cast(V.getNode());
            if (LoadNode.getMemoryVT() == i8 && width == 8) || (LoadNode.getMemoryVT() == i16 && width == 16) {
                if LoadNode.getExtensionType() != SEXTLOAD && LoadNode.getExtensionType() != ZEXTLOAD {
                    return false;
                }
                ExtType = LoadNode.getExtensionType();
                return true;
            }
            return false;
        },
        AssertSext => {
            let mut TypeNode: *mut VTSDNode = cast(V.getOperand(1));
            if (TypeNode.getVT() == i8 && width == 8) || (TypeNode.getVT() == i16 && width == 16) {
                ExtType = SEXTLOAD;
                return true;
            }
            return false;
        },
        AssertZext => {
            let mut TypeNode: *mut VTSDNode = cast(V.getOperand(1));
            if (TypeNode.getVT() == i8 && width == 8) || (TypeNode.getVT() == i16 && width == 16) {
                ExtType = ZEXTLOAD;
                return true;
            }
            return false;
        },
        Constant => {
            TargetConstant;
        },
    }
    return true;
}

fn isEquivalentMaskless(CC: u32, width: u32, ExtType: LoadExtType, AddConstant: i32, CompConstant: i32) -> bool {
    let mut MaxUInt: i32 = (1 << width);
    if ExtType == SEXTLOAD {
        AddConstant -= (1 << (width - 1));
    }
    match CC {
        LE => {
            GT;
        },
        LT => {
            GE;
        },
        HI => {
            LS;
        },
        PL => {
            MI;
        },
        LO => {
            HS;
        },
        EQ => {
            NE;
        },
        VS => {
            VC;
        },
        Invalid => {
            break;
        },
    }
    return false;
}

fn performSubsToAndsCombine(N: *mut SDNode, SubsNode: *mut SDNode, AndNode: *mut SDNode, DAG: *mut SelectionDAG, CCIndex: u32, CmpIndex: u32, CC: u32) -> SDValue {
    let mut SubsC: *mut ConstantSDNode = dyn_cast(SubsNode.getOperand(1));
    if !SubsC {
        return SDValue {};
    }
    let mut SubsAP: APInt = SubsC.getAPIntValue();
    if CC == HI {
        if !SubsAP.isMask() {
            return SDValue {};
        }
    } else if CC == LO {
        if !SubsAP.isPowerOf2() {
            return SDValue {};
        }
    } else {
        return SDValue {};
    }
    let mut AndC: *mut ConstantSDNode = dyn_cast(AndNode.getOperand(1));
    if !AndC {
        return SDValue {};
    }
    let mut MaskAP: APInt = if CC == HI { SubsAP } else { (SubsAP - 1) };
    let mut DL: SDLoc = N;
    let mut AndSMask: APInt = (operator(MaskAP)) & AndC.getAPIntValue();
    let mut ANDS: SDValue = DAG;
    let mut AArch64_CC: SDValue = DAG.getConstant(if CC == HI { NE } else { EQ }, DL, operator(N.getOperand(CCIndex)).getValueType(0), false, false);
    assert!((CCIndex == 2 && CmpIndex == 3), "Expected CCIndex to be 2 and CmpIndex to be 3.");
    let mut Ops: [4]SDValue = [N.getOperand(0), N.getOperand(1), AArch64_CC, ANDS.getValue(1)];
    return DAG;
}

fn performCONDCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG, CCIndex: u32, CmpIndex: u32) -> SDValue {
    let mut CC: u32 = cast(N.getOperand(CCIndex))();
    let mut SubsNode: *mut SDNode = N.getOperand(CmpIndex).getNode();
    let mut CondOpcode: u32 = SubsNode.getOpcode();
    if  {
        return SDValue {};
    }
    let mut AndNode: *mut SDNode = SubsNode.getOperand(0).getNode();
    let mut MaskBits: u32 = 0;
    if AndNode.getOpcode() != AND {
        return SDValue {};
    }
    if performSubsToAndsCombine(N, SubsNode, AndNode, DAG, CCIndex, CmpIndex, CC) {
        Val;
    } else {
        return Val;
    }
    if (CC == EQ || CC == NE) && AndNode.hasOneUse() && isa(AndNode.getOperand(1)) && isa(SubsNode.getOperand(1)) {
        let mut X: SDValue = AndNode.getOperand(0);
        let mut M: APInt = AndNode.getConstantOperandAPInt(1);
        let mut C: APInt = SubsNode.getConstantOperandAPInt(1);
        if M.isMask() && C.isSubsetOf(M) && !isLegalArithImmed(C.getZExtValue()) {
            let mut DL: SDLoc = SubsNode;
            let mut VT: EVT = SubsNode.getValueType(0);
            let mut ShiftAmt: u32 = M.countl_zero();
            let mut ShiftedX: SDValue = DAG.getNode(SHL, DL, VT, X, DAG.getShiftAmountConstant(ShiftAmt, VT, DL));
            let mut ShiftedC: SDValue = DAG.getConstant(C << ShiftAmt, DL, VT, false, false);
            let mut NewSubs: SDValue = DAG;
            DCI.CombineTo(SubsNode, NewSubs, NewSubs.getValue(1), true);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if dyn_cast(AndNode.getOperand(1)) {
        CN;
    } else {
        let mut CNV: u32 = CN.getZExtValue();
        if CNV == 255 {
            MaskBits = 8;
        } else if CNV == 65535 {
            MaskBits = 16;
        }
    }
    if !MaskBits {
        return SDValue {};
    }
    let mut AddValue: SDValue = AndNode.getOperand(0);
    if AddValue.getOpcode() != ADD {
        return SDValue {};
    }
    let mut AddInputValue1: SDValue = AddValue.getOperand(0);
    let mut AddInputValue2: SDValue = AddValue.getOperand(1);
    let mut SubsInputValue: SDValue = SubsNode.getOperand(1);
    if !isa(AddInputValue2.getNode()) || !isa(SubsInputValue.getNode()) {
        return SDValue {};
    }
    let mut ExtType: LoadExtType = zeroed();
    if !checkValueWidth(SubsInputValue, MaskBits, ExtType) || !checkValueWidth(AddInputValue2, MaskBits, ExtType) || !checkValueWidth(AddInputValue1, MaskBits, ExtType) {
        return SDValue {};
    }
    if operator!(isEquivalentMaskless(CC, MaskBits, ExtType, cast(AddInputValue2.getNode())(), cast(SubsInputValue.getNode())())) {
        return SDValue {};
    }
    let mut VTs: SDVTList = DAG.getVTList(SubsNode.getValueType(0), SubsNode.getValueType(1));
    let mut Ops: [2]SDValue = [AddValue, SubsNode.getOperand(1)];
    let mut NewValue: SDValue = DAG;
    DAG.ReplaceAllUsesWith(SubsNode, NewValue.getNode());
    return SDValue { Node: N, ResNo: 0 };
}

fn performBRCONDCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    if MF.getFunction().hasFnAttribute(SpeculativeLoadHardening) {
        return SDValue {};
    }
    if performCONDCombine(N, DCI, DAG, 2, 3) {
        NV;
    } else {
        N = NV.getNode();
    }
    let mut Chain: SDValue = N.getOperand(0);
    let mut Dest: SDValue = N.getOperand(1);
    let mut CCVal: SDValue = N.getOperand(2);
    let mut Cmp: SDValue = N.getOperand(3);
    assert!(isa(CCVal), "Expected a ConstantSDNode here!");
    let mut CC: u32 = operator(CCVal).getAsZExtVal();
    if CC != EQ && CC != NE {
        return SDValue {};
    }
    if isCMP(Cmp) && CC == NE && isOneConstant(Cmp.getOperand(1)) {
        let mut CSel: SDValue = Cmp.getOperand(0);
        let mut CSelCC: auto = zeroed();
        if CSelCC() {
            let mut DL: SDLoc = N;
            return DAG(N.getOpcode(), DL, N.getVTList(), Chain, Dest, getCondCode(DAG, getInvertedCondCode(operator*())), CSel.getOperand(3));
        }
    }
    let mut CmpOpc: u32 = Cmp.getOpcode();
    if  {
        return SDValue {};
    }
    if !operator(Cmp).hasNUsesOfValue(0, 0) || !operator(Cmp).hasNUsesOfValue(1, 1) {
        return SDValue {};
    }
    let mut LHS: SDValue = Cmp.getOperand(0);
    let mut RHS: SDValue = Cmp.getOperand(1);
    assert!(LHS.getValueType() == RHS.getValueType(), "Expected the value type to be the same for both operands!");
    if LHS.getValueType() != i32 && LHS.getValueType() != i64 {
        return SDValue {};
    }
    if isNullConstant(LHS) {
        swap(LHS, RHS);
    }
    if !isNullConstant(RHS) {
        return SDValue {};
    }
    if LHS.getOpcode() == SHL || LHS.getOpcode() == SRA || LHS.getOpcode() == SRL {
        return SDValue {};
    }
    let mut BR: SDValue = SDValue {};
    if CC == EQ {
        BR = DAG;
    } else {
        BR = DAG;
    }
    DCI.CombineTo(N, BR, false);
    return SDValue {};
}

fn foldCSELofCTTZ(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut CC: u32 = N.getConstantOperandVal(2);
    let mut SUBS: SDValue = N.getOperand(3);
    let mut Zero: SDValue = SDValue {};
    let mut CTTZ: SDValue = SDValue {};
    if  {
        Zero = N.getOperand(0);
        CTTZ = N.getOperand(1);
    } else if  {
        Zero = N.getOperand(1);
        CTTZ = N.getOperand(0);
    } else {
        return SDValue {};
    }
    if (CTTZ.getOpcode() != CTTZ && CTTZ.getOpcode() != TRUNCATE) || (CTTZ.getOpcode() == TRUNCATE && CTTZ.getOperand(0).getOpcode() != CTTZ) {
        return SDValue {};
    }
    assert!((CTTZ.getValueType() == i32 || CTTZ.getValueType() == i64), "Illegal type in CTTZ folding");
    if !isNullConstant(Zero) || !isNullConstant(SUBS.getOperand(1)) {
        return SDValue {};
    }
    let mut X: SDValue = if CTTZ.getOpcode() == TRUNCATE { CTTZ.getOperand(0).getOperand(0) } else { CTTZ.getOperand(0) };
    if X != SUBS.getOperand(0) {
        return SDValue {};
    }
    let mut BitWidth: u32 = if CTTZ.getOpcode() == TRUNCATE { CTTZ.getOperand(0).getValueSizeInBits() } else { CTTZ.getValueSizeInBits() }.operator unsigned long long();
    let mut BitWidthMinusOne: SDValue = DAG.getConstant(BitWidth - 1, N, CTTZ.getValueType(), false, false);
    return DAG.getNode(AND, N, CTTZ.getValueType(), CTTZ, BitWidthMinusOne);
}

fn foldCSELOfCSEL(Op: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut L: SDValue = Op.getOperand(0);
    let mut R: SDValue = Op.getOperand(1);
    let mut OpCC: CondCode = Op.getConstantOperandVal(2) as CondCode;
    let mut OpCmp: SDValue = Op.getOperand(3);
    if !isCMP(OpCmp) {
        return SDValue {};
    }
    let mut CmpLHS: SDValue = OpCmp.getOperand(0);
    let mut CmpRHS: SDValue = OpCmp.getOperand(1);
    if  {
        swap(CmpLHS, CmpRHS);
    } else if  {
        return SDValue {};
    }
    let mut X: SDValue = operator(CmpLHS).getOperand(0);
    let mut Y: SDValue = operator(CmpLHS).getOperand(1);
    if !isa(X) || !isa(Y) || X == Y {
        return SDValue {};
    }
    let mut CX: *mut ConstantSDNode = cast(X);
    let mut CY: *mut ConstantSDNode = cast(Y);
    if CX.getAPIntValue() == CY.getAPIntValue() {
        return SDValue {};
    }
    let mut CC: CondCode = operator(CmpLHS).getConstantOperandVal(2) as CondCode;
    let mut Cond: SDValue = operator(CmpLHS).getOperand(3);
    if CmpRHS == Y {
        CC = getInvertedCondCode(CC);
    } else if CmpRHS != X {
        return SDValue {};
    }
    if OpCC == NE {
        CC = getInvertedCondCode(CC);
    } else if OpCC != EQ {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType(0);
    let mut CCValue: SDValue = getCondCode(DAG, CC);
    return DAG;
}

fn reassociateCSELOperandsForCSE(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut SubsNode: SDValue = N.getOperand(3);
    if  {
        return SDValue {};
    }
    let mut CmpOpToMatch: SDValue = SubsNode.getOperand(1);
    let mut CmpOpOther: SDValue = SubsNode.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut ExpectedOpcode: u32 = 0;
    let mut ExpectedOp: SDValue = SDValue {};
    let mut SubsOp: SDValue = SDValue {};
    let mut CmpOpConst: *mut auto = dyn_cast(CmpOpToMatch);
    if CmpOpConst() {
        ExpectedOpcode = ADD;
        ExpectedOp = DAG(operator-(), (0));
        SubsOp = DAG((0));
    } else {
        ExpectedOpcode = SUB;
        ExpectedOp = CmpOpToMatch;
        SubsOp = CmpOpToMatch;
    }
    let mut GetReassociationOp: Closure_68 = Closure_68 { ExpectedOpcode: &mut ExpectedOpcode, CmpOpOther: &mut CmpOpOther };
    let mut Fold: Closure_69 = Closure_69 { GetReassociationOp: &mut GetReassociationOp, N: &mut N, DAG: &mut DAG, SubsNode: &mut SubsNode, VT: &mut VT, CmpOpOther: &mut CmpOpOther };
    let mut CC: CondCode = N.getConstantOperandVal(2) as CondCode;
    if Fold(CC, ExpectedOp, SubsOp) {
        R;
    } else {
        return R;
    }
    if operator!() {
        swap(CmpOpToMatch, CmpOpOther);
        if Fold(getSwappedCondition(CC), CmpOpToMatch, CmpOpToMatch) {
            R;
        } else {
            return R;
        }
        return SDValue {};
    }
    if (CC == EQ || CC == NE) && operator!() {
        return SDValue {};
    }
    let mut CheckedFold: Closure_71 = Closure_71 { DAG: &mut DAG, Fold: &mut Fold };
    match CC {
        EQ => {
            LS;
        },
        NE => {
            HI;
        },
        LO => {
            return CheckedFold(operator!(()()), () - 1, LS);
        },
        HS => {
            return CheckedFold(operator!(()()), () - 1, HI);
        },
        LT => {
            return CheckedFold(operator!(()()), () - 1, LE);
        },
        LE => {
            return CheckedFold(operator!(()()), () + 1, LT);
        },
        GT => {
            return CheckedFold(operator!(()()), () + 1, GE);
        },
        GE => {
            return CheckedFold(operator!(()()), () - 1, GT);
        },
        _ => {
            return SDValue {};
        },
    }
}

fn foldCSELofLASTB(Op: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut OpCC: CondCode = Op.getConstantOperandVal(2) as CondCode;
    if OpCC != NE {
        return SDValue {};
    }
    let mut PTest: SDValue = Op.getOperand(3);
    if  {
        return SDValue {};
    }
    let mut TruePred: SDValue = PTest.getOperand(0);
    let mut AnyPred: SDValue = PTest.getOperand(1);
    if  {
        TruePred = TruePred.getOperand(0);
    }
    if  {
        AnyPred = AnyPred.getOperand(0);
    }
    if TruePred != AnyPred && !isAllActivePredicate(DAG, TruePred) {
        return SDValue {};
    }
    let mut LastB: SDValue = Op.getOperand(0);
    let mut Default: SDValue = Op.getOperand(1);
    if  {
        return SDValue {};
    }
    return DAG;
}

fn performCSELCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    if N.getOperand(0) == N.getOperand(1) {
        return N.getOperand(0);
    }
    if foldCSELOfCSEL(N, DAG) {
        R;
    } else {
        return R;
    }
    if reassociateCSELOperandsForCSE(N, DAG) {
        R;
    } else {
        return R;
    }
    if foldCSELofCTTZ(N, DAG) {
        Folded;
    } else {
        return Folded;
    }
    let mut Cond: SDValue = N.getOperand(3);
    if  {
        let mut OldCond: CondCode = N.getConstantOperandVal(2) as CondCode;
        let mut NewCond: CondCode = getSwappedCondition(OldCond);
        if NewCond != AL {
            let mut DL: SDLoc = N;
            let mut Sub: SDValue = DAG;
            return DAG;
        }
    }
    if foldCSELofLASTB(N, DAG) {
        CondLast;
    } else {
        return CondLast;
    }
    return performCONDCombine(N, DCI, DAG, 2, 3);
}

fn tryToWidenSetCCOperands(Op: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Op0MVT: EVT = Op.getOperand(0).getValueType();
    if !Op0MVT.isVector() || Op.use_empty() {
        return SDValue {};
    }
    let mut FirstUse: *mut SDNode = operator(Op.user_begin());
    if FirstUse.getOpcode() != VSELECT {
        return SDValue {};
    }
    let mut UseMVT: EVT = FirstUse.getValueType(0);
    if UseMVT.getScalarSizeInBits() <= Op0MVT.getScalarSizeInBits() {
        return SDValue {};
    }
    if any_of(Op.users(), Closure_72 { UseMVT: &mut UseMVT }) {
        return SDValue {};
    }
    let mut V: APInt = APInt {};
    if !isConstantSplatVector(Op.getOperand(1).getNode(), V) {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut Op0ExtV: SDValue = SDValue {};
    let mut Op1ExtV: SDValue = SDValue {};
    let mut CC: CondCode = cast(Op.getOperand(2))();
    let mut Op0SExt: *mut SDNode = DAG.getNodeIfExists(SIGN_EXTEND, DAG.getVTList(UseMVT), Op.getOperand(0), false);
    let mut Op0ZExt: *mut SDNode = DAG.getNodeIfExists(ZERO_EXTEND, DAG.getVTList(UseMVT), Op.getOperand(0), false);
    if Op0SExt && (isSignedIntSetCC(CC) || isIntEqualitySetCC(CC)) {
        Op0ExtV = SDValue { Node: Op0SExt, ResNo: 0 };
        Op1ExtV = DAG.getNode(SIGN_EXTEND, DL, UseMVT, Op.getOperand(1));
    } else if Op0ZExt && (isUnsignedIntSetCC(CC) || isIntEqualitySetCC(CC)) {
        Op0ExtV = SDValue { Node: Op0ZExt, ResNo: 0 };
        Op1ExtV = DAG.getNode(ZERO_EXTEND, DL, UseMVT, Op.getOperand(1));
    } else {
        return SDValue {};
    }
    return DAG.getNode(SETCC, DL, UseMVT.changeVectorElementType(*DAG.getContext(), i1), Op0ExtV, Op1ExtV, Op.getOperand(2));
}

fn performVecReduceBitwiseCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut Vec: SDValue = N.getOperand(0);
    if DCI.isBeforeLegalize() && Vec.getValueType().getVectorElementType() == i1 && Vec.getValueType().isFixedLengthVector() && Vec.getValueType().isPow2VectorType() {
        let mut DL: SDLoc = N;
        return getVectorBitwiseReduce(N.getOpcode(), Vec, N.getValueType(0), DL, DAG);
    }
    return SDValue {};
}

fn performSETCCCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    assert!(N.getOpcode() == SETCC, "Unexpected opcode!");
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Cond: CondCode = cast(N.getOperand(2))();
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    if tryToWidenSetCCOperands(N, DAG) {
        V;
    } else {
        return V;
    }
    if  {
        let mut OldCond: CondCode = LHS.getConstantOperandVal(2) as CondCode;
        let mut NewCond: CondCode = getInvertedCondCode(OldCond);
        let mut CSEL: SDValue = DAG;
        return DAG.getZExtOrTrunc(CSEL, DL, VT);
    }
    if Cond == SETNE && isNullConstant(RHS) && operator(LHS).getOpcode() == SRL && isa(operator(LHS).getOperand(1)) && operator(LHS).hasOneUse() {
        let mut TstVT: EVT = operator(LHS).getValueType(0);
        if TstVT.isScalarInteger() && TstVT.getFixedSizeInBits() <= 64 && operator(LHS).getConstantOperandVal(1) < TstVT.getFixedSizeInBits() {
            let mut TstImm: u64 = -1 << operator(LHS).getConstantOperandVal(1);
            let mut TST: SDValue = DAG.getNode(AND, DL, TstVT, operator(LHS).getOperand(0), DAG.getSignedConstant(TstImm, DL, TstVT, false, false));
            return DAG.getNode(SETCC, DL, VT, TST, RHS, N.getOperand(2));
        }
    }
    if DCI.isBeforeLegalize() && VT.isScalarInteger() && (Cond == SETEQ || Cond == SETNE) && (isNullConstant(RHS) || isAllOnesConstant(RHS)) && operator(LHS).getOpcode() == BITCAST {
        let mut ToVT: EVT = operator(LHS).getValueType(0);
        let mut FromVT: EVT = operator(LHS).getOperand(0).getValueType();
        if FromVT.isFixedLengthVector() && FromVT.getVectorElementType() == i1 {
            let mut CompareLHS: SDValue = SDValue {};
            let mut CompareRHS: SDValue = SDValue {};
            if getBoolVectorBitcastCompare(LHS.getOperand(0), RHS, DL, DAG, CompareLHS, CompareRHS) {
                return DAG.getSetCC(DL, VT, CompareLHS, CompareRHS, Cond, SDValue {}, false, None);
            }
            let mut IsNull: bool = isNullConstant(RHS);
            LHS = DAG.getNode(if IsNull { VECREDUCE_OR } else { VECREDUCE_AND }, DL, i1, operator(LHS).getOperand(0));
            LHS = DAG.getNode(if IsNull { ZERO_EXTEND } else { SIGN_EXTEND }, DL, ToVT, LHS);
            return DAG.getSetCC(DL, VT, LHS, RHS, Cond, SDValue {}, false, None);
        }
    }
    if performOrXorChainCombine(N, DAG) {
        V;
    } else {
        return V;
    }
    let mut CmpVT: EVT = LHS.getValueType();
    let mut SplatLHSVal: APInt = APInt {};
    if CmpVT.isInteger() && Cond == SETGT && isConstantSplatVector(LHS.getNode(), SplatLHSVal) && SplatLHSVal.isOne() {
        return DAG.getSetCC(DL, VT, DAG.getConstant(0, DL, CmpVT, false, false), RHS, SETGE, SDValue {}, false, None);
    }
    if DCI.isAfterLegalizeDAG() && CmpVT.isFixedLengthVector() && Cond == SETEQ && LHS.getOpcode() == AND && isZerosVector(RHS.getNode()) {
        let mut CMTSTNode: SDValue = DAG;
        return DAG.getNOT(DL, CMTSTNode, CmpVT);
    }
    return SDValue {};
}

fn performSETCCCARRYCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(N.getOpcode() == SETCCCARRY, "Unexpected opcode!");
    let mut HiLHS: SDValue = N.getOperand(0);
    let mut HiRHS: SDValue = N.getOperand(1);
    let mut Carry: SDValue = N.getOperand(2);
    let mut Cond: CondCode = cast(N.getOperand(3))();
    if Cond != SETULT || Carry.getOpcode() != USUBO || Carry.getResNo() != 1 {
        return SDValue {};
    }
    if !isNullConstant(HiLHS) && !isNullConstant(HiRHS) {
        return SDValue {};
    }
    let mut LoLHS: SDValue = Carry.getOperand(0);
    let mut LoRHS: SDValue = Carry.getOperand(1);
    if !isa(LoLHS) && !isa(LoRHS) {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = N;
    let mut LoCmp: SDValue = DAG.getSetCC(DL, VT, LoLHS, LoRHS, SETULT, SDValue {}, false, None);
    if isNullConstant(HiRHS) {
        let mut HiEq: SDValue = DAG.getSetCC(DL, VT, HiLHS, HiRHS, SETEQ, SDValue {}, false, None);
        return DAG.getNode(AND, DL, VT, HiEq, LoCmp);
    }
    let mut HiNe: SDValue = DAG.getSetCC(DL, VT, HiRHS, HiLHS, SETNE, SDValue {}, false, None);
    return DAG.getNode(OR, DL, VT, HiNe, LoCmp);
}

fn performSELECT_CCCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    assert!(N.getOpcode() == SELECT_CC, "Unexpected opcode!");
    if !DCI.isBeforeLegalize() {
        return SDValue {};
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Cond: CondCode = cast(N.getOperand(4))();
    if Cond != SETEQ && Cond != SETNE {
        return SDValue {};
    }
    if (isNullConstant(LHS) || isAllOnesConstant(LHS)) && RHS.getOpcode() == BITCAST {
        swap(LHS, RHS);
    }
    if !(isNullConstant(RHS) || isAllOnesConstant(RHS)) || LHS.getOpcode() != BITCAST {
        return SDValue {};
    }
    let mut FromVT: EVT = LHS.getOperand(0).getValueType();
    if !FromVT.isFixedLengthVectorOf(i1) {
        return SDValue {};
    }
    let mut DL: SDLoc = N;
    let mut CompareLHS: SDValue = SDValue {};
    let mut CompareRHS: SDValue = SDValue {};
    if !getBoolVectorBitcastCompare(LHS.getOperand(0), RHS, DL, DAG, CompareLHS, CompareRHS) {
        return SDValue {};
    }
    return DAG.getNode(SELECT_CC, DL, N.getValueType(0), CompareLHS, CompareRHS, N.getOperand(2), N.getOperand(3), N.getOperand(4));
}

fn performFlagSettingCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, GenericOpcode: u32) -> SDValue {
    let mut DL: SDLoc = N;
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    if !N.hasAnyUseOfValue(1) {
        let mut Res: SDValue = DCI.DAG.getNode(GenericOpcode, DL, VT, N.ops());
        return DCI.CombineTo(N, Res, SDValue { Node: N, ResNo: 1 }, true);
    }
    if DCI.DAG.getNodeIfExists(GenericOpcode, DCI.DAG.getVTList(VT), [LHS, RHS], true) {
        Generic;
    } else {
        DCI.CombineTo(Generic, SDValue { Node: N, ResNo: 0 }, true);
    }
    return SDValue {};
}

fn performANDSCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    if performFlagSettingCombine(N, DCI, AND) {
        R;
    } else {
        return R;
    }
    if !N.hasAnyUseOfValue(0) {
        if performANDORCSELCombine(N, DAG) {
            R;
        } else {
            return DAG;
        }
    }
    return SDValue {};
}

fn performSetCCPunpkCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Pred: SDValue = N.getOperand(0);
    let mut LHS: SDValue = N.getOperand(1);
    let mut RHS: SDValue = N.getOperand(2);
    let mut Cond: CondCode = cast(N.getOperand(3))();
    if Cond != SETNE || !isZerosVector(RHS.getNode()) || operator(LHS).getOpcode() != SIGN_EXTEND {
        return SDValue {};
    }
    let mut Extract: SDValue = operator(LHS).getOperand(0);
    if operator(Extract).getOpcode() != EXTRACT_SUBVECTOR || operator(Extract).getValueType(0) != N.getValueType(0) || operator(Extract).getConstantOperandVal(1) != 0 {
        return SDValue {};
    }
    let mut InnerSetCC: SDValue = operator(Extract).getOperand(0);
    if  {
        return SDValue {};
    }
    let mut InnerPred: SDValue = InnerSetCC.getOperand(0);
    if  {
        return Extract;
    }
    return SDValue {};
}

fn isSignExtInReg(V: *SDValue) -> bool {
    if  {
        return false;
    }
    let mut BitWidth: u32 = operator(V).getValueType(0).getScalarSizeInBits();
    let mut ShiftAmtR: u32 = V.getConstantOperandVal(1);
    let mut ShiftAmtL: u32 = V.getOperand(0).getConstantOperandVal(1);
    return (ShiftAmtR == ShiftAmtL && ShiftAmtR == (BitWidth - 1));
}

fn performSetccMergeZeroCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut Pred: SDValue = N.getOperand(0);
    let mut LHS: SDValue = N.getOperand(1);
    let mut RHS: SDValue = N.getOperand(2);
    let mut Cond: CondCode = cast(N.getOperand(3))();
    if performSetCCPunpkCombine(N, DAG) {
        V;
    } else {
        return V;
    }
    if Cond == SETNE && isZerosVector(RHS.getNode()) && operator(LHS).getOpcode() == SIGN_EXTEND && operator(operator(LHS).getOperand(0)).getValueType(0) == N.getValueType(0) {
        if  {
            return operator(LHS).getOperand(0);
        }
        if isAllActivePredicate(DAG, Pred) {
            return operator(LHS).getOperand(0);
        }
        if DCI.isAfterLegalizeDAG() {
            return DAG.getNode(AND, N, N.getValueType(0), operator(LHS).getOperand(0), Pred);
        }
    }
    if Cond == SETNE && isZerosVector(RHS.getNode()) && operator(LHS).getOpcode() == INSERT_SUBVECTOR && LHS.hasOneUse() {
        let mut L0: SDValue = operator(LHS).getOperand(0);
        let mut L1: SDValue = operator(LHS).getOperand(1);
        let mut L2: SDValue = operator(LHS).getOperand(2);
        if L0.isUndef() && isNullConstant(L2) && isSignExtInReg(L1) {
            let mut DL: SDLoc = N;
            let mut ExtVal: SDValue = L1.getOperand(0);
            let mut NumShiftBits: u32 = ExtVal.getConstantOperandVal(1);
            let mut ShlSrc: SDValue = ExtVal.getOperand(0);
            if DCI.DAG.ComputeNumSignBits(ShlSrc, 0) > NumShiftBits {
                ExtVal = ShlSrc;
            }
            let mut NewLHS: SDValue = DAG.getNode(INSERT_SUBVECTOR, DL, LHS.getValueType(), L0, ExtVal, L2);
            return DAG;
        }
    }
    return SDValue {};
}

fn getTestBitOperand(Op: SDValue, Bit: *mut u32, Invert: *mut bool, DAG: *mut SelectionDAG) -> SDValue {
    if !operator(Op).hasOneUse() {
        return Op;
    }
    if operator(Op).getOpcode() == TRUNCATE && Bit < operator(Op).getValueType(0).getSizeInBits().operator unsigned long long() {
        return getTestBitOperand(operator(Op).getOperand(0), Bit, Invert, DAG);
    }
    if operator(Op).getOpcode() == ANY_EXTEND && Bit < operator(Op).getOperand(0).getValueSizeInBits().operator unsigned long long() {
        return getTestBitOperand(operator(Op).getOperand(0), Bit, Invert, DAG);
    }
    if operator(Op).getNumOperands() != 2 {
        return Op;
    }
    let mut C: *mut auto = dyn_cast(operator(Op).getOperand(1));
    if operator!() {
        return Op;
    }
    match operator(Op).getOpcode() {
        _ => {
            return Op;
        },
        AND => {
            if (C()() >> Bit) & 1 {
                return getTestBitOperand(operator(Op).getOperand(0), Bit, Invert, DAG);
            }
        },
        SHL => {
            if C()() <= Bit && (Bit - ()) < operator(Op).getValueType(0).getSizeInBits() {
                Bit = Bit - ();
                return getTestBitOperand(operator(Op).getOperand(0), Bit, Invert, DAG);
            }
        },
        SRA => {
            Bit = Bit + ();
        },
        SRL => {
            if (Bit + ()) < operator(Op).getValueType(0).getSizeInBits() {
                Bit = Bit + ();
                return getTestBitOperand(operator(Op).getOperand(0), Bit, Invert, DAG);
            }
        },
        XOR => {
            if (C()() >> Bit) & 1 {
                Invert = !Invert;
            }
        },
    }
}

fn performTBZCombine(N: *mut SDNode, DCI: *mut DAGCombinerInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut Bit: u32 = N.getConstantOperandVal(2);
