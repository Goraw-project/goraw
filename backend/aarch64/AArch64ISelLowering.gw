        return SDValue {};
    }
    let mut SmallestEltTy: EVT = VT.getVectorElementType();
    let mut ResMultiplier: u32 = VT.getScalarSizeInBits() / SmallestEltTy.getFixedSizeInBits();
    let mut VTSize: u64 = VT.getFixedSizeInBits();
    NumElts = VTSize / SmallestEltTy.getFixedSizeInBits();
    let mut ShuffleVT: EVT = getVectorVT(*DAG.getContext(), SmallestEltTy, NumElts, false);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
            {}
