fn AArch64TargetLowering::hasPairedLoad(self: *AArch64TargetLowering, LoadedType: EVT, RequiredAlignment: *mut Align) -> bool {
    if !LoadedType.isSimple() || (!LoadedType.isInteger() && !LoadedType.isFloatingPoint()) {
        return false;
    }
    RequiredAlignment = 1;
    let mut NumBits: u32 = LoadedType.getSizeInBits().operator unsigned long long();
    return NumBits == 32 || NumBits == 64;
}

fn AArch64TargetLowering::getNumInterleavedAccesses(self: *AArch64TargetLowering, VecTy: *mut VectorType, DL: *DataLayout, UseScalable: bool) -> u32 {
    let mut VecSize: u32 = 128;
    let mut ElSize: u32 = DL.getTypeSizeInBits(VecTy.getElementType()).operator unsigned long long();
    let mut MinElts: u32 = VecTy.getElementCount().getKnownMinValue();
    if UseScalable && isa(VecTy) {
        VecSize = max(self.Subtarget.getMinSVEVectorSizeInBits(), 128);
    }
    return max(1, (MinElts * ElSize + 127) / VecSize);
}

