    }
    return MONone;
}

fn AArch64TargetLowering::isLegalInterleavedAccessType(self: *AArch64TargetLowering, VecTy: *mut VectorType, DL: *DataLayout, UseScalable: *mut bool) -> bool {
    let mut ElSize: u32 = DL.getTypeSizeInBits(VecTy.getElementType()).operator unsigned long long();
    let mut EC: ElementCount = VecTy.getElementCount();
    let mut MinElts: u32 = EC.getKnownMinValue();
    UseScalable = false;
    if isa(VecTy) && !self.Subtarget.isNeonAvailable() && (!self.Subtarget.useSVEForFixedLengthVectors() || !getSVEPredPatternFromNumElements(MinElts)) {
        return false;
    }
    if isa(VecTy) && !self.Subtarget.isSVEorStreamingSVEAvailable() {
        return false;
    }
    if MinElts < 2 {
        return false;
    }
    if ElSize != 8 && ElSize != 16 && ElSize != 32 && ElSize != 64 {
        return false;
    }
    if EC.isScalable() {
        UseScalable = true;
        return isPowerOf2_32(MinElts) && (MinElts * ElSize) % 128 == 0;
    }
    let mut VecSize: u32 = DL.getTypeSizeInBits(VecTy).operator unsigned long long();
    if self.Subtarget.useSVEForFixedLengthVectors() {
        let mut MinSVEVectorSize: u32 = max(self.Subtarget.getMinSVEVectorSizeInBits(), 128);
        if VecSize % MinSVEVectorSize == 0 || (VecSize < MinSVEVectorSize && isPowerOf2_32(MinElts) && (!self.Subtarget.isNeonAvailable() || VecSize > 128)) {
            UseScalable = true;
            return true;
        }
    }
    return self.Subtarget.isNeonAvailable() && (VecSize == 64 || VecSize % 128 == 0);
}

fn getSVEContainerIRType(VTy: *mut FixedVectorType) -> *mut ScalableVectorType {
    if VTy.getElementType() == getDoubleTy(VTy.getContext()) {
        return get(VTy.getElementType(), 2);
    }
    if VTy.getElementType() == getFloatTy(VTy.getContext()) {
        return get(VTy.getElementType(), 4);
    }
    if VTy.getElementType() == getBFloatTy(VTy.getContext()) {
        return get(VTy.getElementType(), 8);
    }
    if VTy.getElementType() == getHalfTy(VTy.getContext()) {
        return get(VTy.getElementType(), 8);
    }
    if VTy.getElementType() == getInt64Ty(VTy.getContext()) {
        return get(VTy.getElementType(), 2);
    }
    if VTy.getElementType() == getInt32Ty(VTy.getContext()) {
        return get(VTy.getElementType(), 4);
    }
    if VTy.getElementType() == getInt16Ty(VTy.getContext()) {
        return get(VTy.getElementType(), 8);
    }
    if VTy.getElementType() == getInt8Ty(VTy.getContext()) {
        return get(VTy.getElementType(), 16);
    }
    llvm_unreachable_internal("Cannot handle input vector type", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 19513);
}

fn getStructuredLoadFunction(M: *mut Module, Factor: u32, Scalable: bool, LDVTy: *mut Type, PtrTy: *mut Type) -> *mut Function {
    assert!(Factor >= 2 && Factor <= 4, "Invalid interleave factor");
    let mut SVELoads: [3]ID = zeroed();
    let mut NEONLoads: [3]ID = zeroed();
    if Scalable {
        return getOrInsertDeclaration(M, SVELoads[Factor - 2], [LDVTy, PtrTy]);
    }
    return getOrInsertDeclaration(M, NEONLoads[Factor - 2], [LDVTy, PtrTy]);
}

fn getStructuredStoreFunction(M: *mut Module, Factor: u32, Scalable: bool, STVTy: *mut Type, PtrTy: *mut Type) -> *mut Function {
    assert!(Factor >= 2 && Factor <= 4, "Invalid interleave factor");
    let mut SVEStores: [3]ID = zeroed();
    let mut NEONStores: [3]ID = zeroed();
    if Scalable {
        return getOrInsertDeclaration(M, SVEStores[Factor - 2], [STVTy, PtrTy]);
    }
    return getOrInsertDeclaration(M, NEONStores[Factor - 2], [STVTy, PtrTy]);
}

