const CondCodeVT: MVT = i32;

const FlagsVT: MVT = i32;

const GPRArgRegs: []MCPhysReg = zeroed();

const FPRArgRegs: []MCPhysReg = zeroed();

fn getGPRArgRegs() -> ArrayRef<MCPhysReg> {
    return GPRArgRegs();
}

fn getFPRArgRegs() -> ArrayRef<MCPhysReg> {
    return FPRArgRegs();
}

fn getPackedSVEVectorVT(VT: EVT) -> EVT {
    match VT.getSimpleVT().SimpleTy {
        _ => {
            llvm_unreachable_internal("unexpected element type for vector", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 242);
        },
        i8 => {
            return nxv16i8;
        },
        i16 => {
            return nxv8i16;
        },
        i32 => {
            return nxv4i32;
        },
        i64 => {
            return nxv2i64;
        },
        f16 => {
            return nxv8f16;
        },
        f32 => {
            return nxv4f32;
        },
        f64 => {
            return nxv2f64;
        },
        bf16 => {
            return nxv8bf16;
        },
    }
}

fn getPackedSVEVectorVT(EC: ElementCount) -> EVT {
    match EC.getKnownMinValue() {
        _ => {
            llvm_unreachable_internal("unexpected element count for vector", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 267);
        },
        16 => {
            return nxv16i8;
        },
        8 => {
            return nxv8i16;
        },
        4 => {
            return nxv4i32;
        },
        2 => {
            return nxv2i64;
        },
    }
}

fn getPromotedVTForPredicate(VT: EVT) -> EVT {
    assert!(VT.isScalableVectorOf(i1), "Expected scalable predicate vector type!");
    match VT.getVectorMinNumElements() {
        _ => {
            llvm_unreachable_internal("unexpected element count for vector", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 284);
        },
        2 => {
            return nxv2i64;
        },
        4 => {
            return nxv4i32;
        },
        8 => {
            return nxv8i16;
        },
        16 => {
            return nxv16i8;
        },
    }
}

fn isPackedVectorType(VT: EVT, DAG: *mut SelectionDAG) -> bool {
    assert!(VT.isVector() && DAG.getTargetLoweringInfo().isTypeLegal(VT), "Expected legal vector type!");
    return VT.isFixedLengthVector() || VT.getSizeInBits().getKnownMinValue() == SVEBitsPerBlock;
}

fn isPackedPredicateType(VT: EVT, DAG: *mut SelectionDAG) -> bool {
    assert!(VT.isVector() && DAG.getTargetLoweringInfo().isTypeLegal(VT), "Expected legal type!");
    return VT == nxv16i1;
}

fn isUnpackedType(VT: EVT, DAG: *mut SelectionDAG) -> bool {
    let mut Res: bool = !isPackedVectorType(VT, DAG) && !isPackedPredicateType(VT, DAG);
    assert!((!Res || VT.isScalableVector()), "Unexpected fixed-size unpacked type.");
    return Res;
}

fn isMergePassthruOpcode(Opc: u32) -> bool {
    match Opc {
        _ => {
            return false;
        },
    }
}

fn isZeroingInactiveLanes(Op: SDValue) -> bool {
    match Op.getOpcode() {
        _ => {
            return false;
        },
        SPLAT_VECTOR => {
            GET_ACTIVE_LANE_MASK;
        },
        INTRINSIC_WO_CHAIN => {
            match Op.getConstantOperandVal(0) {
                _ => {
                    return false;
                },
            }
        },
    }
}

fn extractPtrauthBlendDiscriminators(Disc: SDValue, DAG: *mut SelectionDAG) -> tuple<SDValue, SDValue> {
    let mut DL: SDLoc = Disc;
    let mut AddrDisc: SDValue = SDValue {};
    let mut ConstDisc: SDValue = SDValue {};
    if operator(Disc).getOpcode() == INTRINSIC_WO_CHAIN && operator(Disc).getConstantOperandVal(0) == ptrauth_blend {
        AddrDisc = operator(Disc).getOperand(1);
        ConstDisc = operator(Disc).getOperand(2);
    } else {
        ConstDisc = Disc;
    }
    let mut ConstDiscN: *auto = dyn_cast(ConstDisc);
    if operator!() || operator!(isUInt()) {
        return make_tuple(DAG.getTargetConstant(0, DL, i64, false), Disc);
    }
    if !AddrDisc {
        AddrDisc = DAG.getRegister(Register { Reg: 0 }, i64);
    }
    return make_tuple(DAG(DL, i64), AddrDisc);
}

