                break;
            }
        }
    }
    return Result;
}

fn AArch64TargetLowering::CanLowerReturn(self: *AArch64TargetLowering, CallConv: ID, MF: *mut MachineFunction, isVarArg: bool, Outs: *OutputArg>, Context: *mut LLVMContext, RetTy: *Type) -> bool {
    let mut RetCC: *mut CCAssignFn = self.CCAssignFnForReturn(CallConv);
    let mut RVLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CallConv, isVarArg, MF, RVLocs, Context, false };
    return CCInfo.CheckReturn(Outs, RetCC);
}

fn AArch64TargetLowering::LowerReturn(self: *AArch64TargetLowering, Chain: SDValue, CallConv: ID, isVarArg: bool, Outs: *OutputArg>, OutVals: *SmallVectorImpl<SDValue>, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut auto = MF;
    let mut RetCC: *mut CCAssignFn = self.CCAssignFnForReturn(CallConv);
    let mut RVLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CallConv, isVarArg, MF, RVLocs, *DAG.getContext(), false };
    CCInfo.AnalyzeReturn(Outs, RetCC);
    let mut Glue: SDValue = SDValue {};
    let mut RetVals: pair<unsigned int, SDValue>, 4> = zeroed();
    let mut RegsUsed: i32 = 0;
    for let mut i: u32 = 0;
let mut realRVLocIdx: u32 = 0; i != RVLocs.len; i += 1 , realRVLocIdx += 1 {
        let mut VA: *mut CCValAssign = RVLocs[i];
        assert!(VA.isRegLoc(), "Can only return in registers!");
        let mut Arg: SDValue = OutVals[realRVLocIdx];
        match VA.getLocInfo() {
            _ => {
                llvm_unreachable_internal("Unknown loc info!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 11328);
            },
            Full => {
                if Outs[i].ArgVT == i1 {
                    Arg = DAG.getNode(TRUNCATE, DL, i1, Arg);
                    Arg = DAG.getNode(ZERO_EXTEND, DL, VA.getLocVT(), Arg);
                }
            },
            BCvt => {
                Arg = DAG.getNode(BITCAST, DL, VA.getLocVT(), Arg);
            },
            AExt => {
                ZExt;
            },
            AExtUpper => {
                assert!(VA.getValVT() == i32, "only expect 32 -> 64 upper bits");
            },
        }
        if RegsUsed()(VA.getLocReg()) {
            let mut Bits: *mut SDValue = find_if(Closure_19 { cap_0: VA });
            Bits = DAG.getNode(OR, DL, Bits.getValueType(), Bits, Arg);
        } else {
            RetVals()(VA.getLocReg(), Arg);
            RegsUsed()(VA.getLocReg());
        }
    }
    let mut TRI: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut FuncAttrs: SMEAttrs = ();
    if FuncAttrs.hasStreamingBody() && !FuncAttrs.hasStreamingInterface() {
        if FuncAttrs.hasStreamingCompatibleInterface() {
            Chain = self.changeStreamingMode(DAG, DL, false, Chain, SDValue {}, IfCallerIsNonStreaming, false);
        } else {
            Chain = self.changeStreamingMode(DAG, DL, false, Chain, SDValue {}, Always, false);
        }
        Glue = Chain.getValue(1);
    }
    let mut RetOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { 1, Chain };
    if () {
        SRetReg;
    } else {
        let mut Val: SDValue = DAG.getCopyFromReg(RetOps[0], DL, SRetReg, self.getPointerTy(MF.getDataLayout(), 0));
        let mut RetValReg: u32 = 0;
        Chain = DAG.getCopyToReg(Chain, DL, RetValReg, Val, Glue);
        Glue = Chain.getValue(1);
        RetOps.push(DAG.getRegister(RetValReg, self.getPointerTy(DAG.getDataLayout(), 0)));
    }
    let mut I: *MCPhysReg = TRI.getCalleeSavedRegsViaCopy(&mut MF);
    if I {
        for ; *I; I += 1 {
            if  {
                RetOps.push(DAG.getRegister(*I, i64));
            } else if  {
                RetOps.push(DAG.getRegister(*I, getFloatingPointVT(64)));
            } else {
                llvm_unreachable_internal("Unexpected register class in CSRsViaCopy!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 11420);
            }
        }
    }
    RetOps[0] = Chain;
    if Glue.getNode() {
        RetOps.push(Glue);
    }
    if CallConv == ARM64EC_Thunk_X64 {
        let mut PtrVT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
        let mut Arm64ECRetDest: SDValue = DAG.getExternalSymbol("__os_arm64x_dispatch_ret", PtrVT);
        Arm64ECRetDest = (cast(Arm64ECRetDest), DAG, 0);
        Arm64ECRetDest = DAG.getLoad(PtrVT, DL, DAG.getEntryNode(), Arm64ECRetDest, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
        RetOps.insert(RetOps.begin() + 1, Arm64ECRetDest);
        RetOps.insert(RetOps.begin() + 2, DAG.getTargetConstant(0, DL, i32, false));
        return DAG;
    }
    return DAG;
}

fn AArch64TargetLowering::getTargetNode(self: *AArch64TargetLowering, N: *mut GlobalAddressSDNode, Ty: EVT, DAG: *mut SelectionDAG, Flag: u32) -> SDValue {
    return DAG.getTargetGlobalAddress(N.getGlobal(), N, Ty, N.getOffset(), Flag);
}

fn AArch64TargetLowering::getTargetNode(self: *AArch64TargetLowering, N: *mut JumpTableSDNode, Ty: EVT, DAG: *mut SelectionDAG, Flag: u32) -> SDValue {
    return DAG.getTargetJumpTable(N.getIndex(), Ty, Flag);
}

fn AArch64TargetLowering::getTargetNode(self: *AArch64TargetLowering, N: *mut ConstantPoolSDNode, Ty: EVT, DAG: *mut SelectionDAG, Flag: u32) -> SDValue {
    return DAG.getTargetConstantPool(N.getConstVal(), Ty, N.getAlign(), N.getOffset(), Flag);
}

fn AArch64TargetLowering::getTargetNode(self: *AArch64TargetLowering, N: *mut BlockAddressSDNode, Ty: EVT, DAG: *mut SelectionDAG, Flag: u32) -> SDValue {
    return DAG.getTargetBlockAddress(N.getBlockAddress(), Ty, 0, Flag);
}

fn AArch64TargetLowering::getTargetNode(self: *AArch64TargetLowering, N: *mut ExternalSymbolSDNode, Ty: EVT, DAG: *mut SelectionDAG, Flag: u32) -> SDValue {
    return DAG.getTargetExternalSymbol(N.getSymbol(), Ty, Flag);
}

fn AArch64TargetLowering::LowerGlobalAddress(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut GN: *mut GlobalAddressSDNode = cast(Op);
    let mut GV: *GlobalValue = GN.getGlobal();
    let mut OpFlags: u32 = self.Subtarget.ClassifyGlobalReference(GV, self.getTargetMachine());
    if OpFlags != MO_NO_FLAG {
        (((operator!(operator!((cast(Op)() == 0 && "unexpected offset in global node")))) || (_wassert(L"cast<GlobalAddressSDNode>(Op)->getOffset() == 0 && \"unexpected offset in global node\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (11551) as u32) , 0)) as void);
    }
    if (OpFlags & MO_GOT) != 0 {
        return ;
    }
    let mut Result: SDValue = SDValue {};
    if self.getTargetMachine().getCodeModel() == Large && !self.getTargetMachine().isPositionIndependent() {
        Result = ;
    } else if self.getTargetMachine().getCodeModel() == Tiny {
        Result = ;
    } else {
        Result = ;
    }
    let mut PtrVT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut DL: SDLoc = GN;
    if OpFlags & (MO_DLLIMPORT | MO_COFFSTUB) {
        Result = DAG.getLoad(PtrVT, DL, DAG.getEntryNode(), Result, getGOT(DAG.getMachineFunction()), MaybeAlign {}, MONone, MMOMetadata {});
    }
    return Result;
}

fn AArch64TargetLowering::LowerDarwinGlobalTLSAddress(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(self.Subtarget.isTargetDarwin(), "This function expects a Darwin target");
    let mut DL: SDLoc = Op;
    let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut PtrMemVT: MVT = self.getPointerMemTy(DAG.getDataLayout(), 0);
    let mut GV: *GlobalValue = cast(Op)();
    let mut TLVPAddr: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS);
    let mut DescAddr: SDValue = DAG;
    let mut Chain: SDValue = DAG.getEntryNode();
    let mut FuncTLVGet: SDValue = DAG;
    Chain = FuncTLVGet.getValue(1);
    FuncTLVGet = DAG.getZExtOrTrunc(FuncTLVGet, DL, PtrVT);
    let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
    MFI.setAdjustsStack(true);
    let mut TRI: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
    let mut Mask: *u32 = TRI.getTLSCallPreservedMask();
    if self.Subtarget.hasCustomCallingConv() {
        TRI.UpdateCustomCallPreservedMask(DAG.getMachineFunction(), &mut Mask);
    }
    Chain = DAG;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut auto = MF;
    let mut TLSCallAttrs: SMECallAttrs = FuncInfo()();
    let mut RequiresSMChange: bool = TLSCallAttrs.requiresSMChange();
    if RequiresSMChange {
        Chain = self.changeStreamingMode(DAG, DL, false, Chain, Chain.getValue(1), getSMToggleCondition(TLSCallAttrs), false);
    }
    let mut Opcode: u32 = 0;
    let mut Ops: SmallVector<SDValue, 8> = zeroed();
    Ops()(Chain);
    Ops()(FuncTLVGet);
    if DAG.getMachineFunction().getFunction().hasFnAttribute("ptrauth-calls") {
        Ops()(DAG.getTargetConstant(IA, DL, i32, false));
        Ops()(DAG.getTargetConstant(0, DL, i64, false));
        Ops()(DAG.getRegister(Register { Reg: 0 }, i64));
    }
    Ops()(DAG.getRegister);
    Ops()(DAG.getRegisterMask(Mask));
    Ops()(Chain.getValue(1));
    Chain = DAG(Opcode, DL, DAG.getVTList(Other, Glue));
    if getZAMarkerForCall(TLSCallAttrs) {
        ZAMarkerNode;
    } else {
        Chain = DAG.getNode(operator(ZAMarkerNode), DL, DAG.getVTList(Other, Glue), [Chain, Chain.getValue(1)]);
    }
    if RequiresSMChange {
        Chain = self.changeStreamingMode(DAG, DL, true, Chain, Chain.getValue(1), getSMToggleCondition(TLSCallAttrs), false);
    }
    return DAG;
}

fn AArch64TargetLowering::LowerELFTLSLocalExec(self: *AArch64TargetLowering, GV: *GlobalValue, ThreadBase: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut PtrVT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut TPOff: SDValue = SDValue {};
    let mut Addr: SDValue = SDValue {};
    match DAG.getTarget().Options.TLSSize {
        _ => {
            llvm_unreachable_internal("Unexpected TLS size", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 11701);
        },
        12 => {
            let mut Var: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_PAGEOFF);
            return DAG;
        },
        24 => {
            let mut HiVar: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_HI12);
            let mut LoVar: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_PAGEOFF | MO_NC);
            Addr = DAG;
            return DAG;
        },
        32 => {
            let mut HiVar: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_G1);
            let mut LoVar: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_G0 | MO_NC);
            TPOff = DAG;
            TPOff = DAG;
            return DAG.getNode(ADD, DL, PtrVT, ThreadBase, TPOff);
        },
        48 => {
            let mut HiVar: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_G2);
            let mut MiVar: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_G1 | MO_NC);
            let mut LoVar: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_G0 | MO_NC);
            TPOff = DAG;
            TPOff = DAG;
            TPOff = DAG;
            return DAG.getNode(ADD, DL, PtrVT, ThreadBase, TPOff);
        },
    }
}

fn AArch64TargetLowering::LowerELFTLSDescCallSeq(self: *AArch64TargetLowering, SymAddr: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut PtrVT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut auto = MF;
    let mut Glue: SDValue = SDValue {};
    let mut Chain: SDValue = DAG.getEntryNode();
    let mut NodeTys: SDVTList = DAG.getVTList(Other, Glue);
    let mut TLSCallAttrs: SMECallAttrs = FuncInfo()();
    let mut ZAMarkerNode: optional<unsigned int> = getZAMarkerForCall(TLSCallAttrs);
    let mut RequiresSMChange: bool = TLSCallAttrs.requiresSMChange();
    let mut ChainAndGlue: Closure_20 = Closure_20 {};
    if RequiresSMChange {
        tie(Chain, Glue) = ChainAndGlue.call(self.changeStreamingMode(DAG, DL, false, Chain, Glue, getSMToggleCondition(TLSCallAttrs), false));
    }
    let mut Opcode: u32 = 0;
    let mut Ops: [3]SDValue = [Chain, SymAddr, Glue];
    tie(Chain, Glue) = ChainAndGlue(DAG(Opcode, DL, NodeTys, if Glue { Ops() } else { Ops()() }));
    if ZAMarkerNode {
        tie(Chain, Glue) = ChainAndGlue.call(DAG.getNode(operator(ZAMarkerNode), DL, NodeTys, [Chain, Chain.getValue(1)]));
    }
    if RequiresSMChange {
        tie(Chain, Glue) = ChainAndGlue.call(self.changeStreamingMode(DAG, DL, true, Chain, Glue, getSMToggleCondition(TLSCallAttrs), false));
    }
    return DAG;
}

fn getELFTLSModel(GV: *GlobalValue, TM: *TargetMachine, HasELFSignedGOT: bool) -> Model {
    let mut Model: Model = if HasELFSignedGOT { GeneralDynamic } else { TM.getTLSModel(GV) };
    if operator!() && Model == LocalDynamic {
        Model = GeneralDynamic;
    }
    if TM.getCodeModel() == Large && Model != LocalExec {
        report_fatal_error("ELF TLS only supported in small memory model or in local exec TLS model", true);
    }
    return Model;
}

fn AArch64TargetLowering::LowerELFGlobalTLSAddress(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(self.Subtarget.isTargetELF(), "This function expects an ELF target");
    let mut GA: *GlobalAddressSDNode = cast(Op);
    let mut MFI: *mut AArch64FunctionInfo = DAG.getMachineFunction();
    let mut Model: Model = getELFTLSModel(GA.getGlobal(), self.getTargetMachine(), MFI.hasELFSignedGOT());
    let mut TPOff: SDValue = SDValue {};
    let mut PtrVT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut DL: SDLoc = Op;
    let mut GV: *GlobalValue = GA.getGlobal();
    let mut ThreadBase: SDValue = DAG;
    if Model == LocalExec {
        return self.LowerELFTLSLocalExec(GV, ThreadBase, DL, DAG);
    } else if Model == InitialExec {
        TPOff = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS);
        TPOff = DAG;
    } else if Model == LocalDynamic {
        MFI.incNumLocalDynamicTLSAccesses();
        let mut SymAddr: SDValue = DAG.getTargetExternalSymbol("_TLS_MODULE_BASE_", PtrVT, MO_TLS);
        TPOff = self.LowerELFTLSDescCallSeq(SymAddr, DL, DAG);
        let mut HiVar: SDValue = DAG.getTargetGlobalAddress(GV, DL, i64, 0, MO_TLS | MO_HI12);
        let mut LoVar: SDValue = DAG.getTargetGlobalAddress(GV, DL, i64, 0, MO_TLS | MO_PAGEOFF | MO_NC);
        TPOff = DAG;
        TPOff = DAG;
    } else if Model == GeneralDynamic {
        let mut SymAddr: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS);
        TPOff = self.LowerELFTLSDescCallSeq(SymAddr, DL, DAG);
    } else {
        llvm_unreachable_internal("Unsupported ELF TLS access model", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 11930);
    }
    return DAG.getNode(ADD, DL, PtrVT, ThreadBase, TPOff);
}

fn AArch64TargetLowering::LowerWindowsGlobalTLSAddress(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(self.Subtarget.isTargetWindows(), "Windows specific TLS lowering");
    let mut Chain: SDValue = DAG.getEntryNode();
    let mut PtrVT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut DL: SDLoc = Op;
    let mut TEB: SDValue = DAG.getRegister;
    let mut TLSArray: SDValue = DAG.getNode(ADD, DL, PtrVT, TEB, DAG.getIntPtrConstant(88, DL, false));
    TLSArray = DAG.getLoad(PtrVT, DL, Chain, TLSArray, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    Chain = TLSArray.getValue(1);
    let mut TLSIndexHi: SDValue = DAG.getTargetExternalSymbol("_tls_index", PtrVT, MO_PAGE);
    let mut TLSIndexLo: SDValue = DAG.getTargetExternalSymbol("_tls_index", PtrVT, MO_PAGEOFF | MO_NC);
    let mut ADRP: SDValue = DAG;
    let mut TLSIndex: SDValue = DAG;
    TLSIndex = DAG.getLoad(i32, DL, Chain, TLSIndex, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    Chain = TLSIndex.getValue(1);
    TLSIndex = DAG.getNode(ZERO_EXTEND, DL, PtrVT, TLSIndex);
    let mut Slot: SDValue = DAG.getNode(SHL, DL, PtrVT, TLSIndex, DAG.getConstant(3, DL, PtrVT, false, false));
    let mut TLS: SDValue = DAG.getLoad(PtrVT, DL, Chain, DAG.getNode(ADD, DL, PtrVT, TLSArray, Slot), MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    Chain = TLS.getValue(1);
    let mut GA: *GlobalAddressSDNode = cast(Op);
    let mut GV: *GlobalValue = GA.getGlobal();
    let mut TGAHi: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_HI12);
    let mut TGALo: SDValue = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, MO_TLS | MO_PAGEOFF | MO_NC);
    let mut Addr: SDValue = DAG;
    Addr = DAG;
    return Addr;
}

fn AArch64TargetLowering::LowerGlobalTLSAddress(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut GA: *GlobalAddressSDNode = cast(Op);
    if DAG.getTarget().useEmulatedTLS() {
        return self.LowerToTLSEmulatedModel(GA, DAG);
    }
    if self.Subtarget.isTargetDarwin() {
        return self.LowerDarwinGlobalTLSAddress(Op, DAG);
    }
    if self.Subtarget.isTargetELF() {
        return self.LowerELFGlobalTLSAddress(Op, DAG);
    }
    if self.Subtarget.isTargetWindows() {
        return self.LowerWindowsGlobalTLSAddress(Op, DAG);
    }
    llvm_unreachable_internal("Unexpected platform trying to use TLS", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 12007);
}

fn LowerPtrAuthGlobalAddressStatically(TGA: SDValue, DL: SDLoc, VT: EVT, KeyC: ID, Discriminator: SDValue, AddrDiscriminator: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut TGN: *auto = cast(TGA.getNode());
    (((operator!(operator!((TGN()()())))) || (_wassert(L"TGN->getGlobal()->hasExternalWeakLinkage()", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (12043) as u32) , 0)) as void);
    if TGN()() != 0 {
        report_fatal_error("unsupported non-zero offset in weak ptrauth global reference", true);
    }
    if !isNullConstant(AddrDiscriminator) {
        report_fatal_error("unsupported weak addr-div ptrauth global", true);
    }
    let mut Key: SDValue = DAG.getTargetConstant(KeyC, DL, i32, false);
    return DAG;
}

fn AArch64TargetLowering::LowerPtrAuthGlobalAddress(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Ptr: SDValue = Op.getOperand(0);
    let mut KeyC: u64 = Op.getConstantOperandVal(1);
    let mut AddrDiscriminator: SDValue = Op.getOperand(2);
    let mut DiscriminatorC: u64 = Op.getConstantOperandVal(3);
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    if KeyC > LAST {
        report_fatal_error("key in ptrauth global out of range [0, " + LAST as i32 + "]", true);
    }
    if !isUInt(DiscriminatorC) {
        report_fatal_error("constant discriminator in ptrauth global out of range [0, 0xffff]", true);
    }
    if !self.Subtarget.isTargetELF() && !self.Subtarget.isTargetMachO() {
        report_fatal_error("ptrauth global lowering only supported on MachO/ELF", true);
    }
    let mut PtrOffsetC: i64 = 0;
    if Ptr.getOpcode() == ADD {
        PtrOffsetC = Ptr.getConstantOperandVal(1);
        Ptr = Ptr.getOperand(0);
    }
    let mut PtrN: *auto = cast(Ptr.getNode());
    let mut PtrGV: *GlobalValue = ();
    let mut OpFlags: u32 = self.Subtarget.ClassifyGlobalReference(PtrGV, self.getTargetMachine());
    let mut NeedsGOTLoad: bool = ((OpFlags & MO_GOT) != 0);
    assert!(((OpFlags & (~MO_GOT)) == 0), "unsupported non-GOT op flags on ptrauth global reference");
    operator+=(PtrOffsetC);
    let mut TPtr: SDValue = DAG.getTargetGlobalAddress(PtrGV, DL, VT, PtrOffsetC, 0);
    (((operator!(operator!((PtrN()() == 0 && "unsupported target flags on ptrauth global")))) || (_wassert(L"PtrN->getTargetFlags() == 0 && \"unsupported target flags on ptrauth global\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (12105) as u32) , 0)) as void);
    let mut Key: SDValue = DAG.getTargetConstant(KeyC, DL, i32, false);
    let mut Discriminator: SDValue = DAG.getTargetConstant(DiscriminatorC, DL, i64, false);
    let mut TAddrDiscriminator: SDValue = if !isNullConstant(AddrDiscriminator) { AddrDiscriminator } else { DAG.getRegister };
    if !NeedsGOTLoad {
        assert!(!PtrGV.hasExternalWeakLinkage(), "extern_weak should use GOT");
        return DAG;
    }
    if !PtrGV.hasExternalWeakLinkage() {
        return DAG;
    }
    return LowerPtrAuthGlobalAddressStatically(TPtr, DL, VT, KeyC as ID, Discriminator, AddrDiscriminator, DAG);
}

fn lookThroughSignExtension(Val: SDValue) -> pair<SDValue, uint64_t> {
    if Val.getOpcode() == SIGN_EXTEND_INREG {
        return void { Val.getOperand(0), cast(Val.getOperand(1))()() - 1 };
    }
    if Val.getOpcode() == SIGN_EXTEND {
        return void { Val.getOperand(0), operator(Val.getOperand(0)).getValueType(0).getFixedSizeInBits() - 1 };
    }
    return void { Val, Val.getValueSizeInBits().operator unsigned long long() - 1 };
}

fn optimizeBitTest(DL: SDLoc, Op: SDValue, Chain: SDValue, Dest: SDValue, Opcode: u32, DAG: *mut SelectionDAG) -> SDValue {
    if Op.getOpcode() != AND {
        return SDValue {};
    }
    if isa(Op.getOperand(1)) && isPowerOf2_64(Op.getConstantOperandVal(1)) {
        let mut Test: SDValue = Op.getOperand(0);
        let mut Mask: u64 = Op.getConstantOperandVal(1);
        return DAG.getNode(Opcode, DL, Other, Chain, Test, DAG.getConstant(Log2_64(Mask), DL, i64, false, false), Dest);
    }
    if Op.getOperand(0).getOpcode() == SHL {
        let mut Op00: SDValue = Op.getOperand(0).getOperand(0);
        if isa(Op00) && operator(Op00).getAsZExtVal() == 1 {
            let mut Shr: SDValue = DAG.getNode(SRL, DL, Op00.getValueType(), Op.getOperand(1), Op.getOperand(0).getOperand(1));
            return DAG.getNode(Opcode, DL, Other, Chain, Shr, DAG.getConstant(0, DL, i64, false, false), Dest);
        }
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerBR_CC(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Chain: SDValue = Op.getOperand(0);
    let mut CC: CondCode = cast(Op.getOperand(1))();
    let mut LHS: SDValue = Op.getOperand(2);
    let mut RHS: SDValue = Op.getOperand(3);
    let mut Dest: SDValue = Op.getOperand(4);
    let mut DL: SDLoc = Op;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut ProduceNonFlagSettingCondBr: bool = !MF.getFunction().hasFnAttribute(SpeculativeLoadHardening);
    if LHS.getValueType() == f128 {
        self.softenSetCCOperands(DAG, f128, LHS, RHS, CC, DL, LHS, RHS);
        if !RHS.getNode() {
            RHS = DAG.getConstant(0, DL, LHS.getValueType(), false, false);
            CC = SETNE;
        }
    }
    if isOverflowIntrOpRes(LHS) && isOneConstant(RHS) && (CC == SETEQ || CC == SETNE) {
        if !DAG.getTargetLoweringInfo().isTypeLegal(operator(LHS).getValueType(0)) {
            return SDValue {};
        }
        let mut OFCC: CondCode = zeroed();
        let mut Value: SDValue = SDValue {};
        let mut Overflow: SDValue = SDValue {};
        tie(Value, Overflow) = getAArch64XALUOOp(OFCC, LHS.getValue(0), DAG);
        if CC == SETNE {
            OFCC = getInvertedCondCode(OFCC);
        }
        let mut CCVal: SDValue = getCondCode(DAG, OFCC);
        return DAG;
    }
    {
        let mut Flags: SDValue = SDValue {};
        let mut InverseCC: u64 = 0;
        let mut m_CSET: auto = m_Node(m_Zero(false), m_Zero(false), m_ConstInt(InverseCC), m_Value(Flags));
        if (CC == SETEQ || CC == SETNE) && isNullConstant(RHS) && sd_match(LHS, m_AnyOf(m_And(m_One(false)))) {
            let mut BranchCC: CondCode = InverseCC;
            if CC == SETNE {
                BranchCC = getInvertedCondCode(BranchCC);
            }
            return DAG;
        }
    }
    if LHS.getValueType().isInteger() {
        assert!((LHS.getValueType() == RHS.getValueType()) && (LHS.getValueType() == i32 || LHS.getValueType() == i64);
        let mut RHSC: *ConstantSDNode = dyn_cast(RHS);
        if RHSC && RHSC.getZExtValue() == 1 && ProduceNonFlagSettingCondBr && LHS.getResNo() == 0 && DAG.computeKnownBits(LHS, 0).getMaxValue().ule(1) {
            let mut CanNegate: bool = false;
            let mut MustBeFirst: bool = false;
            let mut PreferFirst: bool = false;
            if !canEmitConjunction(DAG, LHS, CanNegate, MustBeFirst, PreferFirst, false, 0) {
                let mut NewCC: CondCode = SETCC_INVALID;
                match CC {
                    SETNE => {
                        SETULT;
                    },
                    SETEQ => {
                        SETUGE;
                    },
                    _ => {
                        break;
                    },
                }
                if NewCC != SETCC_INVALID {
                    CC = NewCC;
                    RHS = DAG.getConstant(0, DL, LHS.getValueType(), false, false);
                    RHSC = cast(RHS);
                }
            }
        }
        if RHSC && RHSC.getZExtValue() == 0 && ProduceNonFlagSettingCondBr {
            if CC == SETEQ {
                if optimizeBitTest(DL, LHS, Chain, Dest, DAG) {
                    Result;
                } else {
                    return Result;
                }
                return DAG;
            } else if CC == SETNE {
                if optimizeBitTest(DL, LHS, Chain, Dest, DAG) {
                    Result;
                } else {
                    return Result;
                }
                return DAG;
            } else if CC == SETLT && LHS.getOpcode() != AND {
                let mut SignBitPos: u64 = 0;
                return DAG;
            }
        }
        if RHSC && RHSC.getSExtValue() == -1 && CC == SETGT && LHS.getOpcode() != AND && ProduceNonFlagSettingCondBr {
            let mut SignBitPos: u64 = 0;
            return DAG;
        }
        if self.Subtarget() && isValidCBCond(changeIntCCToAArch64CC(CC, SDValue {})) && ProduceNonFlagSettingCondBr {
            let mut Cond: SDValue = DAG.getTargetConstant(changeIntCCToAArch64CC(CC, SDValue {}), DL, CondCodeVT, false);
            return DAG;
        }
        let mut CCVal: SDValue = SDValue {};
        let mut Cmp: SDValue = getAArch64Cmp(LHS, RHS, CC, CCVal, DAG, DL);
        return DAG;
    }
    assert!(LHS.getValueType() == f16 || LHS.getValueType() == bf16 || LHS.getValueType() == f32 || LHS.getValueType() == f64);
    let mut Cmp: SDValue = emitComparison(LHS, RHS, CC, DL, DAG);
    let mut CC1: CondCode = zeroed();
    let mut CC2: CondCode = zeroed();
    changeFPCCToAArch64CC(CC, CC1, CC2);
    let mut CC1Val: SDValue = getCondCode(DAG, CC1);
    let mut BR1: SDValue = DAG;
    if CC2 != AL {
        let mut CC2Val: SDValue = getCondCode(DAG, CC2);
        return DAG;
    }
    return BR1;
}

fn AArch64TargetLowering::LowerFCOPYSIGN(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if !self.Subtarget.isNeonAvailable() && !self.Subtarget.useSVEForFixedLengthVectors() {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    let mut IntVT: EVT = VT.changeTypeToInteger();
    let mut DL: SDLoc = Op;
    let mut In1: SDValue = Op.getOperand(0);
    let mut In2: SDValue = Op.getOperand(1);
    let mut SrcVT: EVT = In2.getValueType();
    if !SrcVT.bitsEq(VT) {
        In2 = DAG.getFPExtendOrRound(In2, DL, VT);
    }
    if VT.isScalableVector() {
        IntVT = getPackedSVEVectorVT(VT.getVectorElementType().changeTypeToInteger());
    }
    if VT.isFixedLengthVector() && self.useSVEForFixedLengthVectorVT(VT, !self.Subtarget.isNeonAvailable()) {
        let mut ContainerVT: EVT = getContainerForFixedLengthVector(DAG, VT);
        In1 = convertToScalableVector(DAG, ContainerVT, In1);
        In2 = convertToScalableVector(DAG, ContainerVT, In2);
        let mut Res: SDValue = DAG.getNode(FCOPYSIGN, DL, ContainerVT, In1, In2);
        return convertFromScalableVector(DAG, VT, Res);
    }
    if !VT.isVector() && !self.Subtarget.isNeonAvailable() && self.Subtarget.isSVEorStreamingSVEAvailable() {
        if VT != f16 && VT != f32 && VT != f64 && VT != bf16 {
            return SDValue {};
        }
        let mut SVT: EVT = getPackedSVEVectorVT(VT);
        let mut Poison: SDValue = DAG.getPOISON(SVT);
        let mut Ins1: SDValue = DAG.getInsertVectorElt(DL, Poison, In1, 0);
        let mut Ins2: SDValue = DAG.getInsertVectorElt(DL, Poison, In2, 0);
        let mut FCS: SDValue = DAG.getNode(FCOPYSIGN, DL, SVT, Ins1, Ins2);
        return DAG.getExtractVectorElt(DL, VT, FCS, 0);
    }
    let mut BitCast: Closure_21 = Closure_21 { cap_0: self };
    let mut VecVal1: SDValue = SDValue {};
    let mut VecVal2: SDValue = SDValue {};
    let mut VecVT: EVT = EVT {};
    let mut SetVecVal: Closure_22 = Closure_22 { VT: &mut VT, DAG: &mut DAG, VecVT: &mut VecVT, VecVal1: &mut VecVal1, DL: &mut DL, In1: &mut In1, VecVal2: &mut VecVal2, In2: &mut In2, BitCast: &mut BitCast };
    if VT.isVector() {
        VecVT = IntVT;
        SetVecVal.call(-1);
    } else if VT == f64 {
        VecVT = v2i64;
        SetVecVal();
    } else if VT == f32 {
        VecVT = v4i32;
        SetVecVal();
    } else if VT == f16 || VT == bf16 {
        VecVT = v8i16;
        SetVecVal();
    } else {
        llvm_unreachable_internal("Invalid type for copysign!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 12453);
    }
    let mut BitWidth: u32 = In1.getScalarValueSizeInBits();
    let mut SignMaskV: SDValue = DAG.getConstant(operator(getSignMask(BitWidth)), DL, VecVT, false, false);
    if VT == f64 || VT == v2f64 {
        SignMaskV = DAG.getConstant(getAllOnes(BitWidth), DL, VecVT, false, false);
        SignMaskV = DAG.getNode(BITCAST, DL, v2f64, SignMaskV);
        SignMaskV = DAG.getNode(FNEG, DL, v2f64, SignMaskV);
        SignMaskV = DAG.getNode(BITCAST, DL, v2i64, SignMaskV);
    }
    let mut BSP: SDValue = DAG;
    if VT == f16 || VT == bf16 {
        return DAG.getTargetExtractSubreg;
    }
    if VT == f32 {
        return DAG.getTargetExtractSubreg;
    }
    if VT == f64 {
        return DAG.getTargetExtractSubreg;
    }
    return BitCast.call(VT, BSP, DAG);
}

fn AArch64TargetLowering::LowerCTPOP_PARITY(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if DAG.getMachineFunction().getFunction().hasFnAttribute(NoImplicitFloat) {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    if VT.isVector() && self.Subtarget.isSVEorStreamingSVEAvailable() {
        return self.LowerToPredicatedOp;
    }
    let mut IsParity: bool = Op.getOpcode() == PARITY;
    let mut Val: SDValue = Op.getOperand(0);
    let mut DL: SDLoc = Op;
    if VT == i32 && IsParity {
        return SDValue {};
    }
    if self.Subtarget.isSVEorStreamingSVEAvailable() {
        if VT == i32 || VT == i64 {
            let mut ContainerVT: EVT = if VT == i32 { nxv4i32 } else { nxv2i64 };
            Val = DAG.getInsertVectorElt(DL, DAG.getPOISON(ContainerVT), Val, 0);
            Val = DAG.getNode(CTPOP, DL, ContainerVT, Val);
            Val = DAG.getExtractVectorElt(DL, VT, Val, 0);
            if IsParity {
                Val = DAG.getNode(AND, DL, VT, Val, DAG.getConstant(1, DL, VT, false, false));
            }
            return Val;
        }
        if VT == i128 {
            Val = DAG.getNode(BITCAST, DL, v2i64, Val);
            Val = convertToScalableVector(DAG, nxv2i64, Val);
            Val = DAG.getNode(CTPOP, DL, nxv2i64, Val);
            Val = convertFromScalableVector(DAG, v2i64, Val);
            Val = DAG.getNode(VECREDUCE_ADD, DL, i64, Val);
            Val = DAG.getZExtOrTrunc(Val, DL, VT);
            if IsParity {
                Val = DAG.getNode(AND, DL, VT, Val, DAG.getConstant(1, DL, VT, false, false));
            }
            return Val;
        }
    }
    if !self.Subtarget.isNeonAvailable() {
        return SDValue {};
    }
    if VT == i32 || VT == i64 {
        if VT == i32 {
            Val = DAG.getNode(ZERO_EXTEND, DL, i64, Val);
        }
        Val = DAG.getNode(BITCAST, DL, v8i8, Val);
        let mut CtPop: SDValue = DAG.getNode(CTPOP, DL, v8i8, Val);
        let mut AddV: SDValue = DAG;
        AddV = DAG;
        AddV = DAG.getExtractVectorElt(DL, VT, AddV, 0);
        if IsParity {
            AddV = DAG.getNode(AND, DL, VT, AddV, DAG.getConstant(1, DL, VT, false, false));
        }
        return AddV;
    } else if VT == i128 {
        Val = DAG.getNode(BITCAST, DL, v16i8, Val);
        let mut CtPop: SDValue = DAG.getNode(CTPOP, DL, v16i8, Val);
        let mut AddV: SDValue = DAG;
        AddV = DAG.getExtractVectorElt(DL, i64, DAG, 0);
        AddV = DAG.getZExtOrTrunc(AddV, DL, VT);
        if IsParity {
            AddV = DAG.getNode(AND, DL, VT, AddV, DAG.getConstant(1, DL, VT, false, false));
        }
        return AddV;
    }
    assert!(!IsParity, "ISD::PARITY of vector types not supported");
    assert!((VT == v1i64 || VT == v2i64 || VT == v2i32 || VT == v4i32 || VT == v4i16 || VT == v8i16), "Unexpected type for custom ctpop lowering");
    let mut VT8Bit: EVT = if VT.is64BitVector() { v8i8 } else { v16i8 };
    Val = DAG.getBitcast(VT8Bit, Val);
    Val = DAG.getNode(CTPOP, DL, VT8Bit, Val);
    if self.Subtarget() && VT.getScalarSizeInBits() != 16 && VT.getVectorNumElements() >= 2 {
        let mut DT: EVT = if VT == v2i64 { v4i32 } else { VT };
        let mut Zeros: SDValue = DAG.getConstant(0, DL, DT, false, false);
        let mut Ones: SDValue = DAG.getConstant(1, DL, VT8Bit, false, false);
        if VT == v2i64 {
            Val = DAG;
            Val = DAG;
        } else if VT == v2i32 {
            Val = DAG;
        } else if VT == v4i32 {
            Val = DAG;
        } else {
            llvm_unreachable_internal("Unexpected type for custom ctpop lowering", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 12585);
        }
        return Val;
    }
    let mut EltSize: u32 = 8;
    let mut NumElts: u32 = if VT.is64BitVector() { 8 } else { 16 };
    while EltSize != VT.getScalarSizeInBits() {
        EltSize *= 2;
        NumElts /= 2;
        let mut WidenVT: MVT = getVectorVT(getIntegerVT(EltSize), NumElts);
        Val = DAG;
    }
    return Val;
}

fn AArch64TargetLowering::LowerCTTZ(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut RBIT: SDValue = DAG.getNode(BITREVERSE, DL, VT, Op.getOperand(0));
    return DAG.getNode(CTLZ, DL, VT, RBIT);
}

fn AArch64TargetLowering::LowerMinMax(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut Opcode: u32 = Op.getOpcode();
    let mut CC: CondCode = zeroed();
    match Opcode {
        _ => {
            llvm_unreachable_internal("Wrong instruction", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 12620);
        },
        SMAX => {
            CC = SETGT;
        },
        SMIN => {
            CC = SETLT;
        },
        UMAX => {
            CC = SETUGT;
        },
        UMIN => {
            CC = SETULT;
        },
    }
    if VT.isVector() && self.Subtarget.isSVEorStreamingSVEAvailable() {
        match Opcode {
            _ => {
                llvm_unreachable_internal("Wrong instruction", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 12640);
            },
            SMAX => {
                return self.LowerToPredicatedOp;
            },
            SMIN => {
                return self.LowerToPredicatedOp;
            },
            UMAX => {
                return self.LowerToPredicatedOp;
            },
            UMIN => {
                return self.LowerToPredicatedOp;
            },
        }
    }
    let mut Op0: SDValue = Op.getOperand(0);
    let mut Op1: SDValue = Op.getOperand(1);
    let mut Cond: SDValue = DAG.getSetCC(DL, VT, Op0, Op1, CC, SDValue {}, false, None);
    return DAG.getSelect(DL, VT, Cond, Op0, Op1, SDNodeFlags { Flags: None });
}

fn AArch64TargetLowering::LowerBitreverse(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    if self.Subtarget.isSVEorStreamingSVEAvailable() {
        return self.LowerToPredicatedOp;
    }
    let mut DL: SDLoc = Op;
    let mut REVB: SDValue = SDValue {};
    let mut VST: MVT = MVT {};
    match VT.getSimpleVT().SimpleTy {
        _ => {
            llvm_unreachable_internal("Invalid type for bitreverse!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 12671);
        },
        v2i32 => {
            VST = v8i8;
            REVB = DAG;
            break;
        },
        v4i32 => {
            VST = v16i8;
            REVB = DAG;
            break;
        },
        v1i64 => {
            VST = v8i8;
            REVB = DAG;
            break;
        },
        v2i64 => {
            VST = v16i8;
            REVB = DAG;
            break;
        },
    }
    return DAG;
}

fn isLegalCondCmpImmediate(Imm: *APInt) -> bool {
    return Imm.sgt(-32) && Imm.slt(32);
}

fn hasLegalCmpImmediate(LHS: SDValue, RHS: SDValue) -> bool {
    let mut C: *mut ConstantSDNode = dyn_cast(LHS);
    if C && !isLegalCmpImmed(C.getAPIntValue()) {
        return false;
    }
    C = dyn_cast(RHS);
    if C && !isLegalCmpImmed(C.getAPIntValue()) {
        return false;
    }
    return true;
}

fn hasLegalCondCmpImmediate(LHS: SDValue, RHS: SDValue) -> bool {
    let mut C: *mut ConstantSDNode = dyn_cast(LHS);
    if C && !isLegalCondCmpImmediate(C.getAPIntValue()) {
        return false;
    }
    C = dyn_cast(RHS);
    if C && !isLegalCondCmpImmediate(C.getAPIntValue()) {
        return false;
    }
    return true;
}

fn hasCheapXorImmediateThatNeedsCondCmpReg(Pair: *pair<SDValue, SDValue>) -> bool {
    for V in [Pair.first, Pair.second] {
        let mut C: *mut auto = dyn_cast(V);
        if operator!() || isLegalCondCmpImmediate() {
            continue;
        }
        let mut Imm: *APInt = ();
        let mut BitWidth: u32 = if Imm.getBitWidth() <= 32 { 32 } else { 64 };
        if Imm.getBitWidth() <= BitWidth && isLogicalImmediate(Imm.getZExtValue(), BitWidth) {
            return true;
        }
    }
    return false;
}

fn isOrXorChain(N: SDValue, DAG: *mut SelectionDAG, NumLeaves: *mut u32, NumXors: *mut u32, SawXor: *mut bool, RequireLegalCmpImmediates: bool, WorkList: *mut pair<SDValue, SDValue>>) -> bool {
    if NumLeaves ==  {
        return false;
    }
    if operator(N).getOpcode() == ZERO_EXTEND && operator(N).hasOneUse() {
        N = operator(N).getOperand(0);
    }
    if operator(N).getOpcode() == XOR {
        if RequireLegalCmpImmediates && !hasLegalCmpImmediate(operator(N).getOperand(0), operator(N).getOperand(1)) {
            return false;
        }
        WorkList()(make_pair(operator(N).getOperand(0), operator(N).getOperand(1)));
        NumLeaves += 1;
        NumXors += 1;
        SawXor = true;
        return true;
    }
    if operator(N).getOpcode() == OR && operator(N).hasOneUse() {
        return isOrXorChain(operator(N).getOperand(0), DAG, NumLeaves, NumXors, SawXor, RequireLegalCmpImmediates, WorkList) && isOrXorChain(operator(N).getOperand(1), DAG, NumLeaves, NumXors, SawXor, RequireLegalCmpImmediates, WorkList);
    }
    if operator(N).getOpcode() == OR {
        return false;
    }
    let mut VT: EVT = N.getValueType();
    if !VT.isScalarInteger() {
        return false;
    }
    WorkList()(make_pair(N, DAG.getConstant(0, N, VT, false, false)));
    NumLeaves += 1;
    return true;
}

fn performOrXorChainCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut DL: SDLoc = N;
    let mut VT: EVT = N.getValueType(0);
    let mut WorkList: pair<SDValue, SDValue>, 16> = zeroed();
    if N.getOpcode() != SETCC || LHS.getValueType().isVector() || LHS.getValueType().getSizeInBits().operator unsigned long long() > 64 {
        return SDValue {};
    }
    let mut Cond: CondCode = cast(N.getOperand(2))();
    let mut NumLeaves: u32 = 0;
    let mut NumXors: u32 = 0;
    let mut SawXor: bool = false;
    let mut RequireLegalCmpImmediates: bool = any_of(N.users(), Closure_23 {});
    if (Cond == SETEQ || Cond == SETNE) && isNullConstant(RHS) && operator(LHS).getOpcode() == OR && operator(LHS).hasOneUse() && isOrXorChain(LHS, DAG, NumLeaves, NumXors, SawXor, RequireLegalCmpImmediates) && SawXor {
        let mut F: *Function = DAG.getMachineFunction().getFunction();
        let mut Limit: u32 = 5;
        if NumXors >= 6 {
            Limit = 6;
            if NumXors == NumLeaves {
                Limit = min(8, NumXors);
            }
        }
        if F.hasMinSize() {
            Limit = ;
        }
        if WorkList()() > Limit {
            return SDValue {};
        }
        if WorkList()() > 2 && any_of(hasCheapXorImmediateThatNeedsCondCmpReg) {
            return SDValue {};
        }
        let mut PreferAsFirstCmp: Closure_24 = Closure_24 {};
        if  {
            iter_swap();
        }
        let mut XOR0: SDValue = SDValue {};
        let mut XOR1: SDValue = SDValue {};
        tie(XOR0, XOR1) = [0];
        let mut LogicOp: u32 = if (Cond == SETEQ) { AND } else { OR };
        let mut Cmp: SDValue = DAG.getSetCC(DL, VT, XOR0, XOR1, Cond, SDValue {}, false, None);
        for let mut I: u32 = 1; I < WorkList()(); I += 1 {
            tie(XOR0, XOR1) = [I];
            let mut CmpChain: SDValue = DAG.getSetCC(DL, VT, XOR0, XOR1, Cond, SDValue {}, false, None);
            Cmp = DAG.getNode(LogicOp, DL, VT, Cmp, CmpChain);
        }
        return Cmp;
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerSETCC(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if Op.getValueType().isVector() {
        return self.LowerVSETCC(Op, DAG);
    }
    let mut IsStrict: bool = operator(Op).isStrictFPOpcode();
    let mut IsSignaling: bool = Op.getOpcode() == STRICT_FSETCCS;
    let mut OpNo: u32 = if IsStrict { 1 } else { 0 };
    let mut Chain: SDValue = SDValue {};
    if IsStrict {
        Chain = Op.getOperand(0);
    }
    let mut LHS: SDValue = Op.getOperand(OpNo + 0);
    let mut RHS: SDValue = Op.getOperand(OpNo + 1);
    let mut CC: CondCode = cast(Op.getOperand(OpNo + 2))();
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut TVal: SDValue = DAG.getConstant(1, DL, VT, false, false);
    let mut FVal: SDValue = DAG.getConstant(0, DL, VT, false, false);
    if LHS.getValueType() == f128 {
        self.softenSetCCOperands(DAG, f128, LHS, RHS, CC, DL, LHS, RHS, Chain, IsSignaling);
        if !RHS.getNode() {
            assert!(LHS.getValueType() == Op.getValueType(), "Unexpected setcc expansion!");
            return if IsStrict { DAG.getMergeValues([LHS, Chain], DL) } else { LHS };
        }
    }
    if LHS.getValueType().isInteger() {
        if self.Subtarget() && CC == SETNE && isNullConstant(RHS) {
            let mut One: SDValue = DAG.getConstant(1, DL, LHS.getValueType(), false, false);
            let mut UMin: SDValue = DAG.getNode(UMIN, DL, LHS.getValueType(), LHS, One);
            let mut Res: SDValue = DAG.getZExtOrTrunc(UMin, DL, VT);
            return if IsStrict { DAG.getMergeValues([Res, Chain], DL) } else { Res };
        }
        simplifySetCCIntoEq(CC, LHS, RHS, DAG, DL);
        let mut CCVal: SDValue = SDValue {};
        let mut Cmp: SDValue = getAArch64Cmp(LHS, RHS, getSetCCInverse(CC, LHS.getValueType()), CCVal, DAG, DL);
        let mut Res: SDValue = DAG;
        return if IsStrict { DAG.getMergeValues([Res, Chain], DL) } else { Res };
    }
    assert!(LHS.getValueType() == bf16 || LHS.getValueType() == f16 || LHS.getValueType() == f32 || LHS.getValueType() == f64);
    let mut Cmp: SDValue = SDValue {};
    if IsStrict {
        Cmp = emitStrictFPComparison(LHS, RHS, DL, DAG, Chain, IsSignaling);
    } else {
        Cmp = emitComparison(LHS, RHS, CC, DL, DAG);
    }
    let mut CC1: CondCode = zeroed();
    let mut CC2: CondCode = zeroed();
    changeFPCCToAArch64CC(CC, CC1, CC2);
    let mut Res: SDValue = SDValue {};
    if CC2 == AL {
        changeFPCCToAArch64CC(getSetCCInverse(CC, LHS.getValueType()), CC1, CC2);
        let mut CC1Val: SDValue = getCondCode(DAG, CC1);
        Res = DAG;
    } else {
        let mut CC1Val: SDValue = getCondCode(DAG, CC1);
        let mut CS1: SDValue = DAG;
        let mut CC2Val: SDValue = getCondCode(DAG, CC2);
        Res = DAG;
    }
    return if IsStrict { DAG.getMergeValues([Res, Cmp.getValue(1)], DL) } else { Res };
}

fn AArch64TargetLowering::LowerSETCCCARRY(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    let mut VT: EVT = LHS.getValueType();
    if VT != i32 && VT != i64 {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut Carry: SDValue = Op.getOperand(2);
    let mut InvCarry: SDValue = valueToCarryFlag(Carry, DAG, true);
    let mut Cmp: SDValue = DAG;
    let mut OpVT: EVT = Op.getValueType();
    let mut TVal: SDValue = DAG.getConstant(1, DL, OpVT, false, false);
    let mut FVal: SDValue = DAG.getConstant(0, DL, OpVT, false, false);
    let mut Cond: CondCode = cast(Op.getOperand(3))();
    let mut CondInv: CondCode = getSetCCInverse(Cond, VT);
    let mut CCVal: SDValue = getCondCode(DAG, changeIntCCToAArch64CC(CondInv, SDValue {}));
    return DAG;
}

fn emitVectorComparison(LHS: SDValue, RHS: SDValue, CC: CondCode, NoNans: bool, VT: EVT, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!(VT.getSizeInBits() == LHS.getValueType().getSizeInBits(), "function only supposed to emit natural comparisons");
    match CC {
        _ => {
            return SDValue {};
        },
        NE => {
            let mut Fcmeq: SDValue = DAG;
            if !LHS.getValueType().isVector() {
                let mut VecVT: EVT = getVectorVT(*DAG.getContext(), VT, 128 / VT.getSizeInBits().operator unsigned long long(), false);
                let mut MaskVec: SDValue = DAG.getInsertVectorElt(DL, DAG.getPOISON(VecVT), Fcmeq, 0);
                let mut InvertedMask: SDValue = DAG.getNOT(DL, MaskVec, VecVT);
                return DAG.getExtractVectorElt(DL, VT, InvertedMask, 0);
            }
            return DAG.getNOT(DL, Fcmeq, VT);
        },
        EQ => {
            return DAG;
        },
        GE => {
            return DAG;
        },
        GT => {
            return DAG;
        },
        LE => {
            if !NoNans {
                return SDValue {};
            }
        },
        LS => {
            return DAG;
        },
        LT => {
            if !NoNans {
                return SDValue {};
            }
        },
        MI => {
            return DAG;
        },
    }
}

fn emitFloatCompareMask(LHS: SDValue, RHS: SDValue, TVal: SDValue, FVal: SDValue, CC: CondCode, NoNaNs: bool, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!(!LHS.getValueType().isVector();
    assert!(!RHS.getValueType().isVector();
    let mut CTVal: *mut auto = dyn_cast(TVal);
    let mut CFVal: *mut auto = dyn_cast(FVal);
    if operator!() || operator!() {
        return SDValue {};
    }
    if operator!((CTVal()() && ())) && operator!((CTVal()() && ())) {
        return SDValue {};
    }
    if CTVal()() {
        CC = getSetCCInverse(CC, LHS.getValueType());
    }
    let mut VT: EVT = TVal.getValueType();
    if VT.getSizeInBits() != LHS.getValueType().getSizeInBits() {
        return SDValue {};
    }
    if !NoNaNs && (CC == SETUO || CC == SETO) {
        let mut OneNaN: bool = false;
        if LHS == RHS {
            OneNaN = true;
        } else if DAG.isKnownNeverNaN(RHS, false, 0) {
            OneNaN = true;
            RHS = LHS;
        } else if DAG.isKnownNeverNaN(LHS, false, 0) {
            OneNaN = true;
            LHS = RHS;
        }
        if OneNaN {
            CC = if (CC == SETUO) { SETUNE } else { SETOEQ };
        }
    }
    let mut CC1: CondCode = zeroed();
    let mut CC2: CondCode = zeroed();
    let mut ShouldInvert: bool = false;
    changeVectorFPCCToAArch64CC(CC, CC1, CC2, ShouldInvert);
    let mut Cmp: SDValue = emitVectorComparison(LHS, RHS, CC1, NoNaNs, VT, DL, DAG);
    let mut Cmp2: SDValue = SDValue {};
    if CC2 != AL {
        Cmp2 = emitVectorComparison(LHS, RHS, CC2, NoNaNs, VT, DL, DAG);
        if !Cmp2 {
            return SDValue {};
        }
    }
    if !Cmp2 && !ShouldInvert {
        return Cmp;
    }
    let mut VecVT: EVT = getVectorVT(*DAG.getContext(), VT, 128 / VT.getSizeInBits().operator unsigned long long(), false);
    let mut Poison: SDValue = DAG.getPOISON(VecVT);
    Cmp = DAG.getInsertVectorElt(DL, Poison, Cmp, 0);
    if Cmp2 {
        Cmp2 = DAG.getInsertVectorElt(DL, Poison, Cmp2, 0);
        Cmp = DAG.getNode(OR, DL, VecVT, Cmp, Cmp2);
    }
    if ShouldInvert {
        Cmp = DAG.getNOT(DL, Cmp, VecVT);
    }
    Cmp = DAG.getExtractVectorElt(DL, VT, Cmp, 0);
    return Cmp;
}

fn AArch64TargetLowering::LowerSELECT_CC(self: *AArch64TargetLowering, CC: CondCode, LHS: SDValue, RHS: SDValue, TVal: SDValue, FVal: SDValue, Users: user_iterator>, Flags: SDNodeFlags, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if LHS.getValueType() == f128 {
        self.softenSetCCOperands(DAG, f128, LHS, RHS, CC, DL, LHS, RHS);
        if !RHS.getNode() {
            RHS = DAG.getConstant(0, DL, LHS.getValueType(), false, false);
            CC = SETNE;
        }
    }
    if (LHS.getValueType() == f16 && operator!(self.Subtarget())) || LHS.getValueType() == bf16 {
        LHS = DAG.getNode(FP_EXTEND, DL, f32, LHS);
        RHS = DAG.getNode(FP_EXTEND, DL, f32, RHS);
    }
    if LHS.getValueType().isInteger() {
        assert!((LHS.getValueType() == RHS.getValueType()) && (LHS.getValueType() == i32 || LHS.getValueType() == i64);
        let mut CFVal: *mut ConstantSDNode = dyn_cast(FVal);
        let mut CTVal: *mut ConstantSDNode = dyn_cast(TVal);
        let mut RHSC: *mut ConstantSDNode = dyn_cast(RHS);
        if (CC == SETGT || CC == SETLT) && LHS == TVal && RHSC && RHSC.isZero() && CFVal && CFVal.isZero() && LHS.getValueType() == RHS.getValueType() {
            let mut VT: EVT = LHS.getValueType();
            let mut Shift: SDValue = DAG.getNode(SRA, DL, VT, LHS, DAG.getConstant(VT.getSizeInBits().operator unsigned long long() - 1, DL, VT, false, false));
            if CC == SETGT {
                Shift = DAG.getNOT(DL, Shift, VT);
            }
            return DAG.getNode(AND, DL, VT, LHS, Shift);
        }
        if CC == SETLT && RHSC && RHSC.isZero() && LHS.hasOneUse() && (LHS.getOpcode() == SIGN_EXTEND_INREG || LHS.getOpcode() == SIGN_EXTEND) {
            let mut SignBitPos: u64 = 0;
            let mut TestVT: EVT = LHS.getValueType();
            let mut SignBitConst: SDValue = DAG.getConstant(1 << SignBitPos, DL, TestVT, false, false);
            let mut TST: SDValue = DAG;
            let mut Flags: SDValue = TST.getValue(1);
            return DAG;
        }
        if TVal.getOpcode() == SUB && FVal.getOpcode() == SUB {
            if TVal.getOperand(0) == LHS && TVal.getOperand(1) == RHS && FVal.getOperand(0) == RHS && FVal.getOperand(1) == LHS {
                operator(TVal).dropFlags(PoisonGeneratingFlags);
                FVal = DAG.getNegative(TVal, DL, TVal.getValueType());
            } else if TVal.getOperand(0) == RHS && TVal.getOperand(1) == LHS && FVal.getOperand(0) == LHS && FVal.getOperand(1) == RHS {
                operator(FVal).dropFlags(PoisonGeneratingFlags);
                TVal = DAG.getNegative(FVal, DL, FVal.getValueType());
            }
        }
        let mut Opcode: u32 = 0;
        if CTVal && CFVal && CTVal.isAllOnes() && CFVal.isZero() {
            swap(TVal, FVal);
            swap(CTVal, CFVal);
            CC = getSetCCInverse(CC, LHS.getValueType());
        } else if CTVal && CFVal && CTVal.isOne() && CFVal.isZero() {
            swap(TVal, FVal);
            swap(CTVal, CFVal);
            CC = getSetCCInverse(CC, LHS.getValueType());
        } else if TVal.getOpcode() == XOR {
            if isAllOnesConstant(TVal.getOperand(1)) {
                swap(TVal, FVal);
                swap(CTVal, CFVal);
                CC = getSetCCInverse(CC, LHS.getValueType());
            }
        } else if TVal.getOpcode() == SUB {
            if isNullConstant(TVal.getOperand(0)) {
                swap(TVal, FVal);
                swap(CTVal, CFVal);
                CC = getSetCCInverse(CC, LHS.getValueType());
            }
        } else if CTVal && CFVal {
            let mut TrueVal: i64 = CTVal.getSExtValue();
            let mut FalseVal: i64 = CFVal.getSExtValue();
            let mut Swap: bool = false;
            if TrueVal == ~FalseVal {} else if FalseVal > min() && TrueVal == -FalseVal {} else if TVal.getValueType() == i32 {
                let mut TrueVal32: u32 = CTVal.getZExtValue();
                let mut FalseVal32: u32 = CFVal.getZExtValue();
                if (TrueVal32 == FalseVal32 + 1) || (TrueVal32 + 1 == FalseVal32) {
                    if TrueVal32 > FalseVal32 {
                        Swap = true;
                    }
                }
            } else {
                let mut TrueVal64: u64 = TrueVal;
                let mut FalseVal64: u64 = FalseVal;
                if (TrueVal64 == FalseVal64 + 1) || (TrueVal64 + 1 == FalseVal64) {
                    if TrueVal > FalseVal {
                        Swap = true;
                    }
                }
            }
            if Swap {
                swap(TVal, FVal);
                swap(CTVal, CFVal);
                CC = getSetCCInverse(CC, LHS.getValueType());
            }
            if  {
                FVal = TVal;
            }
        }
        let mut RHSVal: *mut ConstantSDNode = dyn_cast(RHS);
        if  {
            let mut AArch64CC: CondCode = changeIntCCToAArch64CC(CC, SDValue {});
            if CTVal && CTVal == RHSVal && AArch64CC == EQ {
                TVal = LHS;
            } else if CFVal && CFVal == RHSVal && AArch64CC == NE {
                FVal = LHS;
            }
        } else if  {
            assert!(CTVal && CFVal, "Expected constant operands for CSNEG.");
            let mut AArch64CC: CondCode = changeIntCCToAArch64CC(CC, SDValue {});
            if CTVal == RHSVal && AArch64CC == EQ {
                TVal = LHS;
                FVal = DAG.getConstant(0, DL, FVal.getValueType(), false, false);
            }
        }
        let mut CCVal: SDValue = SDValue {};
        let mut Cmp: SDValue = getAArch64Cmp(LHS, RHS, CC, CCVal, DAG, DL);
        let mut VT: EVT = TVal.getValueType();
        return DAG.getNode(Opcode, DL, VT, TVal, FVal, CCVal, Cmp);
    }
    assert!(LHS.getValueType() == f16 || LHS.getValueType() == f32 || LHS.getValueType() == f64);
    assert!(LHS.getValueType() == RHS.getValueType();
    let mut VT: EVT = TVal.getValueType();
    if self.Subtarget.isNeonAvailable() && all_of(Users, Closure_25 {}) {
        let mut NoNaNs: bool = Flags.hasNoNaNs();
        let mut VectorCmp: SDValue = emitFloatCompareMask(LHS, RHS, TVal, FVal, CC, NoNaNs, DL, DAG);
        if VectorCmp {
            return VectorCmp;
        }
    }
    let mut Cmp: SDValue = emitComparison(LHS, RHS, CC, DL, DAG);
    let mut CC1: CondCode = zeroed();
    let mut CC2: CondCode = zeroed();
    changeFPCCToAArch64CC(CC, CC1, CC2);
    if Flags.hasNoSignedZeros() {
        let mut RHSVal: *mut ConstantFPSDNode = dyn_cast(RHS);
        if RHSVal && RHSVal.isZero() {
            let mut CFVal: *mut ConstantFPSDNode = dyn_cast(FVal);
            let mut CTVal: *mut ConstantFPSDNode = dyn_cast(TVal);
            if (CC == SETEQ || CC == SETOEQ || CC == SETUEQ) && CTVal && CTVal.isZero() && TVal.getValueType() == LHS.getValueType() {
                TVal = LHS;
            } else if (CC == SETNE || CC == SETONE || CC == SETUNE) && CFVal && CFVal.isZero() && FVal.getValueType() == LHS.getValueType() {
                FVal = LHS;
            }
        }
    }
    let mut CC1Val: SDValue = getCondCode(DAG, CC1);
    let mut CS1: SDValue = DAG;
    if CC2 != AL {
        let mut CC2Val: SDValue = getCondCode(DAG, CC2);
        return DAG;
    }
    return CS1;
}

fn AArch64TargetLowering::LowerVECTOR_SPLICE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Ty: EVT = Op.getValueType();
    if !isa(Op.getOperand(2)) {
        return SDValue {};
    }
    let mut Idx: APInt = Op.getConstantOperandAPInt(2);
    let mut IdxVal: i64 = Idx.getSExtValue();
    assert!(Ty.isScalableVector(), "Only expect scalable vectors for custom lowering of VECTOR_SPLICE");
    let mut PredPattern: optional<unsigned int> = optional<unsigned int> {};
    if Ty.isScalableVector() && Op.getOpcode() == VECTOR_SPLICE_RIGHT && (PredPattern = getSVEPredPatternFromNumElements(IdxVal)) {
        let mut DL: SDLoc = Op;
        let mut PredVT: EVT = Ty.changeVectorElementType(*DAG.getContext(), i1);
        let mut Pred: SDValue = getPTrue(DAG, DL, PredVT, operator(PredPattern));
        Pred = DAG.getNode(VECTOR_REVERSE, DL, PredVT, Pred);
        return DAG;
    }
    let mut BlockSize: u32 = SVEBitsPerBlock / Ty.getVectorMinNumElements();
    if Op.getOpcode() == VECTOR_SPLICE_LEFT && (IdxVal * BlockSize / 8) < 256 {
        return Op;
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerVECTOR_REVERSE(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Op.getValueType() == nxv1i1, "Unexpected vector type!");
    let mut DL: SDLoc = Op;
    let mut Widened: SDValue = DAG.getInsertSubvector(DL, DAG.getPOISON(nxv2i1), Op.getOperand(0), 0);
    let mut Reversed: SDValue = DAG.getNode(VECTOR_REVERSE, DL, nxv2i1, Widened);
    return DAG.getExtractSubvector(DL, nxv1i1, Reversed, 1);
}

fn AArch64TargetLowering::LowerSELECT_CC(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut CC: CondCode = cast(Op.getOperand(4))();
    let mut LHS: SDValue = Op.getOperand(0);
    let mut RHS: SDValue = Op.getOperand(1);
    let mut TVal: SDValue = Op.getOperand(2);
    let mut FVal: SDValue = Op.getOperand(3);
    let mut Flags: SDNodeFlags = operator(Op).getFlags();
    let mut DL: SDLoc = Op;
    return self.LowerSELECT_CC(CC, LHS, RHS, TVal, FVal, operator(Op).users(), Flags, DL, DAG);
}

fn AArch64TargetLowering::LowerSELECT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut CCVal: SDValue = operator(Op).getOperand(0);
    let mut TVal: SDValue = operator(Op).getOperand(1);
    let mut FVal: SDValue = operator(Op).getOperand(2);
    let mut DL: SDLoc = Op;
    let mut Ty: EVT = Op.getValueType();
    if Ty == aarch64svcount {
        TVal = DAG.getNode(BITCAST, DL, nxv16i1, TVal);
        FVal = DAG.getNode(BITCAST, DL, nxv16i1, FVal);
        let mut Sel: SDValue = DAG.getNode(SELECT, DL, nxv16i1, CCVal, TVal, FVal);
        return DAG.getNode(BITCAST, DL, Ty, Sel);
    }
    if Ty.isScalableVector() {
        let mut PredVT: MVT = getVectorVT(i1, Ty.getVectorElementCount());
        let mut SplatPred: SDValue = DAG.getNode(SPLAT_VECTOR, DL, PredVT, CCVal);
        return DAG.getNode(VSELECT, DL, Ty, SplatPred, TVal, FVal);
    }
    if self.useSVEForFixedLengthVectorVT(Ty, !self.Subtarget.isNeonAvailable()) {
        let mut SplatValVT: MVT = getIntegerVT(Ty.getScalarSizeInBits());
        let mut PredVT: MVT = getVectorVT(SplatValVT, Ty.getVectorElementCount());
        let mut SplatVal: SDValue = DAG.getSExtOrTrunc(CCVal, DL, SplatValVT);
        let mut SplatPred: SDValue = DAG.getNode(SPLAT_VECTOR, DL, PredVT, SplatVal);
        return DAG.getNode(VSELECT, DL, Ty, SplatPred, TVal, FVal);
    }
    if isOverflowIntrOpRes(CCVal) {
        if !DAG.getTargetLoweringInfo().isTypeLegal(operator(CCVal).getValueType(0)) {
            return SDValue {};
        }
        let mut OFCC: CondCode = zeroed();
        let mut Value: SDValue = SDValue {};
        let mut Overflow: SDValue = SDValue {};
        tie(Value, Overflow) = getAArch64XALUOOp(OFCC, CCVal.getValue(0), DAG);
        let mut CCVal: SDValue = getCondCode(DAG, OFCC);
        return DAG;
    }
    let mut CC: CondCode = zeroed();
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if CCVal.getOpcode() == SETCC {
        LHS = CCVal.getOperand(0);
        RHS = CCVal.getOperand(1);
        CC = cast(CCVal.getOperand(2))();
    } else {
        LHS = CCVal;
        RHS = DAG.getConstant(0, DL, CCVal.getValueType(), false, false);
        CC = SETNE;
    }
    if (Ty == f16 || Ty == bf16) && operator!(self.Subtarget()) {
        let mut Poison: SDValue = DAG.getPOISON(f32);
        TVal = DAG.getTargetInsertSubreg;
        FVal = DAG.getTargetInsertSubreg;
    }
    let mut Res: SDValue = self.LowerSELECT_CC(CC, LHS, RHS, TVal, FVal, operator(Op).users(), operator(Op).getFlags(), DL, DAG);
    if (Ty == f16 || Ty == bf16) && operator!(self.Subtarget()) {
        return DAG.getTargetExtractSubreg;
    }
    return Res;
}

fn AArch64TargetLowering::LowerJumpTable(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut JT: *mut JumpTableSDNode = cast(Op);
    let mut CM: Model = self.getTargetMachine().getCodeModel();
    if CM == Large && !self.getTargetMachine().isPositionIndependent() && !self.Subtarget.isTargetMachO() {
        return ;
    }
    if CM == Tiny {
        return ;
    }
    return ;
}

fn AArch64TargetLowering::LowerBR_JT(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut JT: SDValue = Op.getOperand(1);
    let mut Entry: SDValue = Op.getOperand(2);
    let mut JTI: i32 = cast(JT.getNode())();
    let mut AFI: *mut auto = DAG.getMachineFunction();
    AFI()(JTI, 4, null);
    if DAG.getMachineFunction().getFunction().hasFnAttribute("aarch64-jump-table-hardening") {
        let mut CM: Model = self.getTargetMachine().getCodeModel();
        if self.Subtarget.isTargetMachO() {
            if CM != Small && CM != Large {
                report_fatal_error("Unsupported code-model for hardened jump-table", true);
            }
        } else {
            assert!(self.Subtarget.isTargetELF(), "jump table hardening only supported on MachO/ELF");
            if CM != Small {
                report_fatal_error("Unsupported code-model for hardened jump-table", true);
            }
        }
        let mut X16Copy: SDValue = DAG;
        let mut B: *mut SDNode = DAG;
        return SDValue { Node: B, ResNo: 0 };
    }
    let mut Dest: *mut SDNode = DAG;
    let mut JTInfo: SDValue = DAG.getJumpTableDebugInfo(JTI, Op.getOperand(0), DL);
    return DAG.getNode(BRIND, DL, Other, JTInfo, SDValue { Node: Dest, ResNo: 0 });
}

fn AArch64TargetLowering::LowerBRIND(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Chain: SDValue = Op.getOperand(0);
    let mut Dest: SDValue = Op.getOperand(1);
    if  {
        return SDValue {};
    }
    let mut MF: *MachineFunction = DAG.getMachineFunction();
    let mut BADisc: optional<uint16_t> = zeroed();
    if operator!() {
        return SDValue {};
    }
    let mut DL: SDLoc = Op;
    let mut Disc: SDValue = DAG(operator*(), DL, i64);
    let mut Key: SDValue = DAG.getTargetConstant(IA, DL, i32, false);
    let mut AddrDisc: SDValue = DAG.getRegister;
    let mut BrA: *mut SDNode = DAG;
    return SDValue { Node: BrA, ResNo: 0 };
}

fn AArch64TargetLowering::LowerConstantPool(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut CP: *mut ConstantPoolSDNode = cast(Op);
    let mut CM: Model = self.getTargetMachine().getCodeModel();
    if CM == Large {
        if self.Subtarget.isTargetMachO() {
            return ;
        }
        if !self.getTargetMachine().isPositionIndependent() {
            return ;
        }
    } else if CM == Tiny {
        return ;
    }
    return ;
}

fn AArch64TargetLowering::LowerBlockAddress(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut BAN: *mut BlockAddressSDNode = cast(Op);
    let mut BA: *BlockAddress = BAN.getBlockAddress();
    if  {
        let mut DL: SDLoc = Op;
        let mut TargetBA: SDValue = DAG.getTargetBlockAddress(BA, BAN.getValueType(0), 0, 0);
        let mut Disc: SDValue = DAG(operator*(), DL, i64);
        let mut Key: SDValue = DAG.getTargetConstant(IA, DL, i32, false);
        let mut AddrDisc: SDValue = DAG.getRegister;
        let mut MOV: *mut SDNode = DAG;
        return DAG;
    }
    let mut CM: Model = self.getTargetMachine().getCodeModel();
    if CM == Large && !self.Subtarget.isTargetMachO() {
        if !self.getTargetMachine().isPositionIndependent() {
            return ;
        }
    } else if CM == Tiny {
        return ;
    }
    return ;
}

fn AArch64TargetLowering::LowerDarwin_VASTART(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut FuncInfo: *mut AArch64FunctionInfo = DAG.getMachineFunction();
    let mut DL: SDLoc = Op;
    let mut FR: SDValue = DAG.getFrameIndex(FuncInfo.getVarArgsStackIndex(), self.getPointerTy(DAG.getDataLayout(), 0), false);
    FR = DAG.getZExtOrTrunc(FR, DL, self.getPointerMemTy(DAG.getDataLayout(), 0));
    let mut SV: *Value = cast(Op.getOperand(2))();
    return DAG.getStore(Op.getOperand(0), DL, FR, Op.getOperand(1), MachinePointerInfo { SV, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
}

fn AArch64TargetLowering::LowerWin64_VASTART(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut AArch64FunctionInfo = MF;
    let mut DL: SDLoc = Op;
    let mut FR: SDValue = SDValue {};
    if self.Subtarget.isWindowsArm64EC() {
        let mut VReg: Register = MF.addLiveIn;
        let mut Val: SDValue = DAG.getCopyFromReg(DAG.getEntryNode(), DL, VReg, i64);
        let mut StackOffset: u64 = 0;
        if FuncInfo.getVarArgsGPRSize() > 0 {
            StackOffset = -FuncInfo.getVarArgsGPRSize() as u64;
        } else {
            StackOffset = FuncInfo.getVarArgsStackOffset();
        }
        FR = DAG.getNode(ADD, DL, i64, Val, DAG.getConstant(StackOffset, DL, i64, false, false));
    } else {
        FR = DAG.getFrameIndex(if FuncInfo.getVarArgsGPRSize() > 0 { FuncInfo.getVarArgsGPRIndex() } else { FuncInfo.getVarArgsStackIndex() }, self.getPointerTy(DAG.getDataLayout(), 0), false);
    }
    let mut SV: *Value = cast(Op.getOperand(2))();
    return DAG.getStore(Op.getOperand(0), DL, FR, Op.getOperand(1), MachinePointerInfo { SV, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
}

fn AArch64TargetLowering::LowerAAPCS_VASTART(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FuncInfo: *mut AArch64FunctionInfo = MF;
    let mut PtrSize: u32 = if self.Subtarget.isTargetILP32() { 4 } else { 8 };
    let mut PtrMemVT: MVT = self.getPointerMemTy(DAG.getDataLayout(), 0);
    let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = Op.getOperand(0);
    let mut VAList: SDValue = Op.getOperand(1);
    let mut SV: *Value = cast(Op.getOperand(2))();
    let mut MemOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut Offset: u32 = 0;
    let mut Stack: SDValue = DAG.getFrameIndex(FuncInfo.getVarArgsStackIndex(), PtrVT, false);
    Stack = DAG.getZExtOrTrunc(Stack, DL, PtrMemVT);
    MemOps.push(DAG.getStore(Chain, DL, Stack, VAList, MachinePointerInfo { SV, 0, 0 }, PtrSize, MONone, MMOMetadata {}));
    Offset += PtrSize;
    let mut GPRSize: i32 = FuncInfo.getVarArgsGPRSize();
    if GPRSize > 0 {
        let mut GRTop: SDValue = SDValue {};
        let mut GRTopAddr: SDValue = SDValue {};
        GRTopAddr = DAG.getNode(ADD, DL, PtrVT, VAList, DAG.getConstant(Offset, DL, PtrVT, false, false));
        GRTop = DAG.getFrameIndex(FuncInfo.getVarArgsGPRIndex(), PtrVT, false);
        GRTop = DAG.getNode(ADD, DL, PtrVT, GRTop, DAG.getSignedConstant(GPRSize, DL, PtrVT, false, false));
        GRTop = DAG.getZExtOrTrunc(GRTop, DL, PtrMemVT);
        MemOps.push(DAG.getStore(Chain, DL, GRTop, GRTopAddr, MachinePointerInfo { SV, Offset, 0 }, PtrSize, MONone, MMOMetadata {}));
    }
    Offset += PtrSize;
    let mut FPRSize: i32 = FuncInfo.getVarArgsFPRSize();
    if FPRSize > 0 {
        let mut VRTop: SDValue = SDValue {};
        let mut VRTopAddr: SDValue = SDValue {};
        VRTopAddr = DAG.getNode(ADD, DL, PtrVT, VAList, DAG.getConstant(Offset, DL, PtrVT, false, false));
        VRTop = DAG.getFrameIndex(FuncInfo.getVarArgsFPRIndex(), PtrVT, false);
        VRTop = DAG.getNode(ADD, DL, PtrVT, VRTop, DAG.getSignedConstant(FPRSize, DL, PtrVT, false, false));
        VRTop = DAG.getZExtOrTrunc(VRTop, DL, PtrMemVT);
        MemOps.push(DAG.getStore(Chain, DL, VRTop, VRTopAddr, MachinePointerInfo { SV, Offset, 0 }, PtrSize, MONone, MMOMetadata {}));
    }
    Offset += PtrSize;
    let mut GROffsAddr: SDValue = DAG.getNode(ADD, DL, PtrVT, VAList, DAG.getConstant(Offset, DL, PtrVT, false, false));
    MemOps.push(DAG.getStore(Chain, DL, DAG.getSignedConstant(-GPRSize, DL, i32, false, false), GROffsAddr, MachinePointerInfo { SV, Offset, 0 }, 4, MONone, MMOMetadata {}));
    Offset += 4;
    let mut VROffsAddr: SDValue = DAG.getNode(ADD, DL, PtrVT, VAList, DAG.getConstant(Offset, DL, PtrVT, false, false));
    MemOps.push(DAG.getStore(Chain, DL, DAG.getSignedConstant(-FPRSize, DL, i32, false, false), VROffsAddr, MachinePointerInfo { SV, Offset, 0 }, 4, MONone, MMOMetadata {}));
    return DAG;
}

fn AArch64TargetLowering::LowerVASTART(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut F: *mut Function = MF.getFunction();
    if self.Subtarget.isCallingConvWin64(F.getCallingConv(), F.isVarArg()) {
        return self.LowerWin64_VASTART(Op, DAG);
    } else if self.Subtarget.isTargetDarwin() {
        return self.LowerDarwin_VASTART(Op, DAG);
    } else {
        return self.LowerAAPCS_VASTART(Op, DAG);
    }
}

fn AArch64TargetLowering::LowerVACOPY(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut PtrSize: u32 = if self.Subtarget.isTargetILP32() { 4 } else { 8 };
    let mut VaListSize: u32 = if (self.Subtarget.isTargetDarwin() || self.Subtarget.isTargetWindows()) { PtrSize } else { if self.Subtarget.isTargetILP32() { 20 } else { 32 } };
    let mut DestSV: *Value = cast(Op.getOperand(3))();
    let mut SrcSV: *Value = cast(Op.getOperand(4))();
    return DAG.getMemcpy(Op.getOperand(0), DL, Op.getOperand(1), Op.getOperand(2), DAG.getConstant(VaListSize, DL, i32, false, false), PtrSize, PtrSize, false, false, null, nullopt, MachinePointerInfo { DestSV, 0, 0 }, MachinePointerInfo { SrcSV, 0, 0 }, AAMDNodes {}, null);
}

fn AArch64TargetLowering::LowerVAARG(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!(self.Subtarget.isTargetDarwin(), "automatic va_arg instruction only works on Darwin");
    let mut V: *Value = cast(Op.getOperand(2))();
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut Chain: SDValue = Op.getOperand(0);
    let mut Addr: SDValue = Op.getOperand(1);
    let mut Align: MaybeAlign = Op.getConstantOperandVal(3);
    let mut MinSlotSize: u32 = if self.Subtarget.isTargetILP32() { 4 } else { 8 };
    let mut PtrVT: MVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut PtrMemVT: MVT = self.getPointerMemTy(DAG.getDataLayout(), 0);
    let mut VAList: SDValue = DAG.getLoad(PtrMemVT, DL, Chain, Addr, MachinePointerInfo { V, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    Chain = VAList.getValue(1);
    VAList = DAG.getZExtOrTrunc(VAList, DL, PtrVT);
    if VT.isScalableVector() {
        report_fatal_error("Passing SVE types to variadic functions is currently not supported", true);
    }
    if Align && operator(Align) > MinSlotSize {
        VAList = DAG.getNode(ADD, DL, PtrVT, VAList, DAG.getConstant(operator(Align).value() - 1, DL, PtrVT, false, false));
        VAList = DAG.getNode(AND, DL, PtrVT, VAList, DAG.getSignedConstant(-operator(Align).value() as i64, DL, PtrVT, false, false));
    }
    let mut ArgTy: *mut Type = VT.getTypeForEVT(*DAG.getContext());
    let mut ArgSize: u32 = DAG.getDataLayout().getTypeAllocSize(ArgTy).operator unsigned long long();
    if VT.isInteger() && !VT.isVector() {
        ArgSize = max(ArgSize, MinSlotSize);
    }
    let mut NeedFPTrunc: bool = false;
    if VT.isFloatingPoint() && !VT.isVector() && VT != f64 {
        ArgSize = 8;
        NeedFPTrunc = true;
    }
    let mut VANext: SDValue = DAG.getNode(ADD, DL, PtrVT, VAList, DAG.getConstant(ArgSize, DL, PtrVT, false, false));
    VANext = DAG.getZExtOrTrunc(VANext, DL, PtrMemVT);
    let mut APStore: SDValue = DAG.getStore(Chain, DL, VANext, Addr, MachinePointerInfo { V, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    if NeedFPTrunc {
        let mut WideFP: SDValue = DAG.getLoad(f64, DL, APStore, VAList, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
        let mut NarrowFP: SDValue = DAG.getNode(FP_ROUND, DL, VT, WideFP.getValue(0), DAG.getIntPtrConstant(1, DL, true));
        let mut Ops: [2]SDValue = [NarrowFP, WideFP.getValue(1)];
        return DAG.getMergeValues;
    }
    return DAG.getLoad(VT, DL, APStore, VAList, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
}

fn AArch64TargetLowering::LowerFRAMEADDR(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
    MFI.setFrameAddressIsTaken(true);
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut Depth: u32 = Op.getConstantOperandVal(0);
    let mut FrameAddr: SDValue = DAG;
    while Depth -= 1 {
        FrameAddr = DAG.getLoad(VT, DL, DAG.getEntryNode(), FrameAddr, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    }
    if self.Subtarget.isTargetILP32() {
        FrameAddr = DAG.getNode(AssertZext, DL, i64, FrameAddr, DAG.getValueType(VT));
    }
    return FrameAddr;
}

fn AArch64TargetLowering::LowerSPONENTRY(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
    let mut VT: EVT = self.getPointerTy(DAG.getDataLayout(), 0);
    let mut FI: i32 = MFI.CreateFixedObject(4, 0, false, false);
    return DAG.getFrameIndex(FI, VT, false);
}

fn AArch64TargetLowering::matchRegisterName(self: *AArch64TargetLowering, RegName: str) -> Register {
    return MatchRegisterName(RegName);
}

fn AArch64TargetLowering::getRegisterByName(self: *AArch64TargetLowering, RegName: *u8, VT: LLT, MF: *MachineFunction) -> Register {
    let mut Reg: Register = self.matchRegisterName(RegName);
    if Reg.operator unsigned int() && !self.Subtarget.getRegisterInfo().isReservedReg(MF, Reg.operator MCRegister()) {
        Reg = Register { Reg: 0 };
    }
    return Reg;
}

fn AArch64TargetLowering::LowerADDROFRETURNADDR(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    DAG.getMachineFunction().getFrameInfo().setFrameAddressIsTaken(true);
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut FrameAddr: SDValue = DAG;
    let mut Offset: SDValue = DAG.getConstant(8, DL, self.getPointerTy(DAG.getDataLayout(), 0), false, false);
    return DAG.getNode(ADD, DL, VT, FrameAddr, Offset);
}

fn AArch64TargetLowering::LowerRETURNADDR(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    MFI.setReturnAddressIsTaken(true);
    let mut VT: EVT = Op.getValueType();
    let mut DL: SDLoc = Op;
    let mut Depth: u32 = Op.getConstantOperandVal(0);
    let mut ReturnAddress: SDValue = SDValue {};
    if Depth {
        let mut FrameAddr: SDValue = self.LowerFRAMEADDR(Op, DAG);
        let mut Offset: SDValue = DAG.getConstant(8, DL, self.getPointerTy(DAG.getDataLayout(), 0), false, false);
        ReturnAddress = DAG.getLoad(VT, DL, DAG.getEntryNode(), DAG.getNode(ADD, DL, VT, FrameAddr, Offset), MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    } else {
        let mut Reg: Register = MF.addLiveIn;
        ReturnAddress = DAG.getCopyFromReg(DAG.getEntryNode(), DL, Reg, VT);
    }
    let mut St: *mut SDNode = null;
    if self.Subtarget() {
        St = DAG;
    } else {
        let mut Chain: SDValue = DAG;
        St = DAG;
    }
    return SDValue { Node: St, ResNo: 0 };
}

fn AArch64TargetLowering::LowerShiftParts(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.expandShiftParts(Op.getNode(), Lo, Hi, DAG);
    return DAG.getMergeValues([Lo, Hi], Op);
}

fn AArch64TargetLowering::isOffsetFoldingLegal(self: *AArch64TargetLowering, GA: *GlobalAddressSDNode) -> bool {
    return false;
}

fn AArch64TargetLowering::isFPImmLegalAsFMov(self: *AArch64TargetLowering, Imm: *APFloat, VT: EVT) -> bool {
    let mut ImmInt: APInt = Imm.bitcastToAPInt();
    if VT == f64 {
        return getFP64Imm(ImmInt) != -1 || Imm.isPosZero();
    }
    if VT == f32 {
        return getFP32Imm(ImmInt) != -1 || Imm.isPosZero();
    }
    if VT == f16 || VT == bf16 {
        return (self.Subtarget() && getFP16Imm(ImmInt) != -1) || Imm.isPosZero();
    }
    return false;
}

fn AArch64TargetLowering::isFPImmLegal(self: *AArch64TargetLowering, Imm: *APFloat, VT: EVT, OptForSize: bool) -> bool {
    let mut IsLegal: bool = self.isFPImmLegalAsFMov(Imm, VT);
    if !IsLegal && (VT == f64 || VT == f32) {
        let mut Insn: ImmInsnModel, 4> = zeroed();
        let mut ImmInt: APInt = Imm.bitcastToAPInt();
        expandMOVImm(ImmInt.getZExtValue(), VT.getSizeInBits());
        (((operator!(operator!((Insn()() <= 4 && "Should be able to build any value with at most 4 moves")))) || (_wassert(L"Insn.size() <= 4 && \"Should be able to build any value with at most 4 moves\"", L"llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", (14071) as u32) , 0)) as void);
        let mut Limit: u32 = if OptForSize { 1 } else { 2 };
        if !OptForSize && () > Limit && self.Subtarget() {
            for let mut I: u32 = 0; I + 1 < (); I += 1 {
                let mut First: *ImmInsnModel = [I];
                let mut Second: *ImmInsnModel = [I + 1];
                if self.Subtarget(First.Opcode, First.Op2, Second.Opcode, Second.Op2) {
                    Limit += 1;
                    I += 1;
                }
            }
        }
        IsLegal = () <= Limit;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-lower", 1) {
            dbgs() << (if IsLegal { "Legal " } else { "Illegal " }) << VT << " imm value: ";
            Imm.dump();
        }
    }
        if !(false) { break; }
    }
    return IsLegal;
}

fn getEstimate(ST: *AArch64Subtarget, Opcode: u32, Operand: SDValue, DAG: *mut SelectionDAG, ExtraSteps: *mut i32) -> SDValue {
    let mut VT: EVT = Operand.getValueType();
    if (ST()() && (VT == f64 || VT == v1f64 || VT == v2f64 || VT == f32 || VT == v1f32 || VT == v2f32 || VT == v4f32)) || (ST()() && (VT == nxv8f16 || VT == nxv4f32 || VT == nxv2f64)) {
        if ExtraSteps == Unspecified {
            let mut AccurateBits: u32 = 8;
            let mut DesiredBits: u32 = semanticsPrecision(VT.getFltSemantics());
            ExtraSteps = if DesiredBits <= AccurateBits { 0 } else { Log2_64_Ceil(DesiredBits) - Log2_64_Ceil(AccurateBits) };
        }
        return DAG.getNode(Opcode, Operand, VT, Operand);
    }
    return SDValue {};
}

fn AArch64TargetLowering::getSqrtInputTest(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, Mode: *DenormalMode, Flags: SDNodeFlags) -> SDValue {
    let mut DL: SDLoc = Op;
    let mut VT: EVT = Op.getValueType();
    let mut CCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut FPZero: SDValue = DAG.getConstantFP(0.0, DL, VT, false);
    return DAG.getSetCC(DL, CCVT, Op, FPZero, SETEQ, SDValue {}, false, Flags);
}

fn AArch64TargetLowering::getSqrtResultForDenormInput(self: *AArch64TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    return Op;
}

fn AArch64TargetLowering::getSqrtEstimate(self: *AArch64TargetLowering, Operand: SDValue, DAG: *mut SelectionDAG, Enabled: i32, ExtraSteps: *mut i32, UseOneConst: *mut bool, Reciprocal: bool) -> SDValue {
    if Enabled == Enabled || (Enabled == Unspecified && self.Subtarget()) {
        if getEstimate(self.Subtarget, Operand, DAG, ExtraSteps) {
            Estimate;
        } else {
            let mut DL: SDLoc = Operand;
            let mut VT: EVT = Operand.getValueType();
            let mut Flags: SDNodeFlags = AllowReassociation | NoSignedZeros;
            for let mut i: i32 = ExtraSteps; i > 0; i -= 1 {
                let mut Step: SDValue = DAG.getNode(FMUL, DL, VT, Estimate, Estimate, Flags);
                Step = DAG;
                Estimate = DAG.getNode(FMUL, DL, VT, Estimate, Step, Flags);
            }
            if !Reciprocal {
                Estimate = DAG.getNode(FMUL, DL, VT, Operand, Estimate, Flags);
            }
            ExtraSteps = 0;
            return Estimate;
        }
    }
    return SDValue {};
}

fn AArch64TargetLowering::getRecipEstimate(self: *AArch64TargetLowering, Operand: SDValue, DAG: *mut SelectionDAG, Enabled: i32, ExtraSteps: *mut i32) -> SDValue {
    if Enabled == Enabled {
        if getEstimate(self.Subtarget, Operand, DAG, ExtraSteps) {
            Estimate;
        } else {
            let mut DL: SDLoc = Operand;
            let mut VT: EVT = Operand.getValueType();
            let mut Flags: SDNodeFlags = AllowReassociation;
            for let mut i: i32 = ExtraSteps; i > 0; i -= 1 {
                let mut Step: SDValue = DAG;
                Estimate = DAG.getNode(FMUL, DL, VT, Estimate, Step, Flags);
            }
            ExtraSteps = 0;
            return Estimate;
        }
    }
    return SDValue {};
}

fn AArch64TargetLowering::LowerXConstraint(self: *AArch64TargetLowering, ConstraintVT: EVT) -> *u8 {
    if operator!(self.Subtarget()) {
        return "r";
    }
    if ConstraintVT.isFloatingPoint() {
        return "w";
    }
    if ConstraintVT.isVector() && (ConstraintVT.getSizeInBits().operator unsigned long long() == 64 || ConstraintVT.getSizeInBits().operator unsigned long long() == 128) {
        return "w";
    }
    return "r";
}

enum PredicateConstraint {
    Uph = 0,
    Upl = 1,
    Upa = 2,
}

fn parseSVERegAsConstraint(Constraint: str) -> pair<unsigned int, const TargetRegisterClass *>> {
    if !Constraint.starts_with('{') || !Constraint.ends_with('}') || (Constraint[1] != 'p' && Constraint[1] != 'z') {
        return nullopt();
    }
    let mut IsPredicate: bool = Constraint[1] == 'p';
    Constraint = Constraint[2..2 + Constraint.len - 3];
    let mut IsPredicateAsCount: bool = IsPredicate && Constraint.starts_with("n");
    if IsPredicateAsCount {
        Constraint = Constraint.drop_front(1);
    }
    let mut V: u32 = 0;
    if Constraint || V > 31 {
        return nullopt();
    }
    if IsPredicateAsCount {
        return make_pair();
    }
    if IsPredicate {
        return make_pair();
    }
    return make_pair();
}

fn parsePredicateConstraint(Constraint: str) -> optional<PredicateConstraint> {}

fn getPredicateRegisterClass(Constraint: PredicateConstraint, VT: EVT) -> *TargetRegisterClass {
    if VT != aarch64svcount && !VT.isScalableVectorOf(i1) {
        return null;
    }
    match Constraint {
        Uph => {
            
        },
        Upl => {
            
        },
        Upa => {
            
        },
    }
    llvm_unreachable_internal("Missing PredicateConstraint!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 14318);
}

enum ReducedGprConstraint {
    Uci = 0,
    Ucj = 1,
}

fn parseReducedGprConstraint(Constraint: str) -> optional<ReducedGprConstraint> {}

fn getReducedGprRegisterClass(Constraint: ReducedGprConstraint, VT: EVT) -> *TargetRegisterClass {
    if !VT.isScalarInteger() || VT.getFixedSizeInBits() > 64 {
        return null;
    }
    match Constraint {
        Uci => {
            
        },
        Ucj => {
            
        },
    }
    llvm_unreachable_internal("Missing ReducedGprConstraint!", "llvm\\lib\\Target\\AArch64\\AArch64ISelLowering.cpp", 14343);
}

fn parseConstraintCode(Constraint: str) -> CondCode {
    let mut Cond: CondCode = zeroed();
    return Cond;
}

fn getSETCC(CC: CondCode, NZCV: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    return DAG;
}

fn AArch64TargetLowering::LowerAsmOutputForConstraint(self: *AArch64TargetLowering, Chain: *mut SDValue, Glue: *mut SDValue, DL: *SDLoc, OpInfo: *AsmOperandInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut Cond: CondCode = parseConstraintCode(OpInfo.ConstraintCode);
    if Cond == Invalid {
        return SDValue {};
    }
    if OpInfo.ConstraintVT.isVector() || !OpInfo.ConstraintVT.isInteger() || OpInfo.ConstraintVT.getSizeInBits().operator unsigned long long() < 8 {
        report_fatal_error("Flag output operand is of invalid type", true);
    }
    if Glue.getNode() {
        Glue = DAG;
        Chain = Glue.getValue(1);
    } else {
        Glue = DAG;
    }
    let mut CC: SDValue = getSETCC(Cond, Glue, DL, DAG);
    let mut Result: SDValue = SDValue {};
    if OpInfo.ConstraintVT.getSizeInBits().operator unsigned long long() <= 32 {
        Result = DAG.getNode(TRUNCATE, DL, OpInfo.ConstraintVT, CC);
    } else {
        Result = DAG.getNode(ZERO_EXTEND, DL, OpInfo.ConstraintVT, CC);
    }
    return Result;
}

fn AArch64TargetLowering::getConstraintType(self: *AArch64TargetLowering, Constraint: str) -> ConstraintType {
    if Constraint.len == 1 {
        match Constraint[0] {
            _ => {
                break;
            },
            'x' => {
                'w';
            },
            'Q' => {
                return C_Memory;
            },
            'I' => {
                'J';
            },
            'z' => {
                'S';
            },
        }
    } else if parsePredicateConstraint(Constraint) {
        return C_RegisterClass;
    } else if parseReducedGprConstraint(Constraint) {
        return C_RegisterClass;
    } else if parseConstraintCode(Constraint) != Invalid {
        return C_Other;
    }
    return self.getConstraintType(Constraint);
}

fn AArch64TargetLowering::getSingleConstraintMatchWeight(self: *AArch64TargetLowering, info: *mut AsmOperandInfo, constraint: *u8) -> ConstraintWeight {
    let mut weight: ConstraintWeight = CW_Invalid;
    let mut CallOperandVal: *mut Value = info.CallOperandVal;
    if !CallOperandVal {
        return CW_Default;
    }
    let mut type: *mut Type = CallOperandVal.getType();
    match *constraint {
        _ => {
            weight = self.getSingleConstraintMatchWeight(info, constraint);
        },
        'x' => {
            'w';
        },
        'z' => {
            weight = CW_Constant;
        },
        'U' => {
            if  {
                weight = CW_Register;
            }
        },
    }
    return weight;
}

