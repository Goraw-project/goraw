fn createAArch64PointerAuthPass() -> *mut FunctionPass {
    return AArch64PointerAuthLegacy {};
}

static mut ID: i8 = 0;

fn emitEpiloguePACSymOffsetIntoReg(TII: *TargetInstrInfo, MBB: *mut MachineBasicBlock, I: iterator, DL: DebugLoc, PACSym: *mut MCSymbol, Reg: Register) {
    BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(ADRP), Reg).addSym(PACSym, MO_PAGE).setMIFlag(FrameDestroy);
    BuildMI(MBB, I, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(ADDXri), Reg).addReg(Reg, RegState {}, 0).addSym(PACSym, MO_PAGEOFF | MO_NC).addImm(0).setMIFlag(FrameDestroy);
}

