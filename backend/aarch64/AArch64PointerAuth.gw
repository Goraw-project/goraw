enum SetRAStateMode {
    Never = 0,
    PAuthLR = 1,
    Always = 2,
}

static mut CFILLVMSetRASignStateMode: opt<SetRAStateMode> = opt<SetRAStateMode> { "aarch64-cfi-llvm-set-ra-sign-state", init(PAuthLR), "Control emission of .cfi_set_ra_state for PAC return address signing CFI", values(OptionEnumValue { Name: "never", Value: Never, Description: "Always use legacy .cfi_negate_ra_state[_with_pc]" }, OptionEnumValue { Name: "pauth-lr", Value: PAuthLR, Description: "Use new CFI only for PAuth_LR (default)" }, OptionEnumValue { Name: "always", Value: Always, Description: "Use new CFI for both PAuth and PAuth_LR" }), Hidden };

struct AArch64PointerAuthImpl {
    Subtarget: *AArch64Subtarget,
    TII: *AArch64InstrInfo,
}

struct AArch64PointerAuthLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

