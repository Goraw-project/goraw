    return false;
}

fn AArch64PointerAuthLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64PointerAuthLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64PointerAuthLegacy::getResolver(self: *AArch64PointerAuthLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

