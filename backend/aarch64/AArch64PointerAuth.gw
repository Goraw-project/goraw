fn AArch64PointerAuthLegacy::getClearedProperties(self: *AArch64PointerAuthLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn createAArch64PointerAuthPass() -> *mut FunctionPass {
    return AArch64PointerAuthLegacy {};
}

static mut ID: i8 = 0;

fn emitEpiloguePACSymOffsetIntoReg(TII: *TargetInstrInfo, MBB: *mut MachineBasicBlock, I: i32, DL: DebugLoc, PACSym: *mut MCSymbol, Reg: Register) {
    BuildMI(MBB, DL, TII.get, Reg)(PACSym, MO_PAGE)(FrameDestroy);
    BuildMI(MBB, DL, TII.get, Reg)(Reg)(PACSym, MO_PAGEOFF | MO_NC)(0)(FrameDestroy);
}

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: decoratePACWithCFI]
// template <typename BuildPACMIFn>
// fn decoratePACWithCFI(MBB: *mut MachineBasicBlock, MBBI: i32, EmitCFI: bool, BuildPACMI: BuildPACMIFn) {
//     if !EmitCFI {
//         BuildPACMI();
//         return;
//     }
//     let mut MF: *mut MachineFunction = *MBB.getParent();
//     let mut MFnI: *mut auto = operator*(MF);
//     let mut CFIBuilder: CFIInstBuilder = MBB;
//     let mut TT: *Triple = MF.getTarget().getTargetTriple();
//     if MFnI()() {
//         match CFILLVMSetRASignStateMode() {
//             Never => {
//                 CFIBuilder.buildNegateRAStateWithPC();
//             },
//             PAuthLR => {
//                 Always;
//             },
//         }
//     } else {
//         match CFILLVMSetRASignStateMode() {
//             Never => {
//                 PAuthLR;
//             },
//             Always => {
//                 BuildPACMI();
//             },
//         }
//     }
// }
// ========================================================

fn emitAUTCFI(MBB: *mut MachineBasicBlock, MBBI: i32, EmitCFI: bool) {
    if !EmitCFI {
        return;
    }
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut MFnI: *mut auto = operator*(MF);
    let mut CFIBuilder: CFIInstBuilder = MBB;
    let mut TT: *Triple = MF.getTarget().getTargetTriple();
    if MFnI()() {
        match CFILLVMSetRASignStateMode() {
            Never => {
                break;
            },
            PAuthLR => {
                Always;
            },
        }
    } else if !TT.isOSBinFormatMachO() {
        match CFILLVMSetRASignStateMode() {
            Never => {
                PAuthLR;
            },
            Always => {
                CFIBuilder.buildSetRAState(0, null);
            },
        }
    }
}

fn AArch64PointerAuthImpl::signLR(self: *AArch64PointerAuthImpl, MF: *mut MachineFunction, MBBI: i32) {
    let mut MFnI: *mut auto = operator*(MF);
    let mut UseBKey: bool = ();
    let mut EmitCFI: bool = (MF);
    let mut NeedsWinCFI: bool = MF.hasWinCFI();
    let mut MBB: *mut MachineBasicBlock = operator*();
    let mut DL: DebugLoc = null;
    if UseBKey && !MF.getTarget().getTargetTriple().isOSBinFormatMachO() {
        BuildMI(MBB, DL, self.TII)(FrameSetup);
    }
    if MFnI()() {
        let mut PACSym: *mut MCSymbol = MF.getContext().createTempSymbol();
        MFnI()(PACSym);
    }
    if MFnI()() && self.Subtarget() {
        decoratePACWithCFI(MBB, EmitCFI, Closure_1 { MBB: &mut MBB, DL: &mut DL, cap_2: self, UseBKey: &mut UseBKey, MF: &mut MF });
    } else {
        if MFnI()() {
            BuildMI(MBB, DL, self.TII)(FrameSetup);
        }
        decoratePACWithCFI(MBB, EmitCFI, Closure_2 { MBB: &mut MBB, DL: &mut DL, cap_2: self, UseBKey: &mut UseBKey, MF: &mut MF });
    }
    if !EmitCFI && NeedsWinCFI {
        assert!(UseBKey, "Windows SEH PAC unwind info only supports B-key signing");
        BuildMI(MBB, DL, self.TII)(FrameSetup);
    }
}

fn AArch64PointerAuthImpl::authenticateLR(self: *AArch64PointerAuthImpl, MF: *mut MachineFunction, MBBI: i32) {
    let mut MFnI: *AArch64FunctionInfo = MF;
    let mut UseBKey: bool = MFnI.shouldSignWithBKey();
    let mut EmitAsyncCFI: bool = MFnI.needsAsyncDwarfUnwindInfo(MF);
    let mut NeedsWinCFI: bool = MF.hasWinCFI();
    let mut MBB: *mut MachineBasicBlock = operator*();
    let mut DL: DebugLoc = ();
    let mut TI: i32 = MBB()();
    let mut PACSym: *mut MCSymbol = MFnI.getSigningInstrLabel();
    let mut AFL: *AArch64FrameLowering = *MF.getSubtarget().getFrameLowering() as *AArch64FrameLowering;
    let mut ArgumentStackToRestore: i64 = AFL.getArgumentStackToRestore(MF, MBB);
    let mut TerminatorIsCombinable: bool = false;
    if self.Subtarget() && TerminatorIsCombinable && !NeedsWinCFI && !MF.getFunction().hasFnAttribute(ShadowCallStack) {
        if MFnI.branchProtectionPAuthLR() && self.Subtarget() {
            assert!(PACSym, "No PAC instruction to refer to");
            BuildMI(MBB, DL, self.TII)(PACSym)(operator*())(FrameDestroy);
        } else {
            if MFnI.branchProtectionPAuthLR() {
                emitEpiloguePACSymOffsetIntoReg(*self.TII, MBB, DL, PACSym);
                BuildMI(MBB, DL, self.TII)(FrameDestroy);
            }
            BuildMI(MBB, DL, self.TII)(operator*())(FrameDestroy);
        }
        MBB()();
        return;
    }
    if ArgumentStackToRestore == 0 {
        if MFnI.branchProtectionPAuthLR() && self.Subtarget() {
            assert!(PACSym, "No PAC instruction to refer to");
            BuildMI(MBB, DL, self.TII)(PACSym)(FrameDestroy);
            emitAUTCFI(MBB, EmitAsyncCFI);
        } else {
            if MFnI.branchProtectionPAuthLR() {
                emitEpiloguePACSymOffsetIntoReg(*self.TII, MBB, DL, PACSym);
                BuildMI(MBB, DL, self.TII)(FrameDestroy);
            }
            BuildMI(MBB, DL, self.TII)(FrameDestroy);
            emitAUTCFI(MBB, EmitAsyncCFI);
        }
        if NeedsWinCFI {
            assert!(UseBKey, "Windows SEH PAC unwind info only supports B-key signing");
            BuildMI(MBB, DL, self.TII)(FrameDestroy);
        }
        return;
    }
    emitFrameOffset(MBB, DL, getFixed(-ArgumentStackToRestore), self.TII, FrameDestroy);
    let mut emitMOV: Closure_3 = Closure_3 { MBB: &mut MBB, DL: &mut DL, cap_2: self };
    if MFnI.branchProtectionPAuthLR() && self.Subtarget() {
        emitMOV();
        assert!(PACSym, "No PAC instruction to refer to");
        emitEpiloguePACSymOffsetIntoReg(*self.TII, MBB, DL, PACSym);
        let mut AutOpc: u32 = 0;
        BuildMI(MBB, DL, self.TII(AutOpc))(FrameDestroy);
        emitAUTCFI(MBB, EmitAsyncCFI);
        emitMOV();
    } else if MFnI.branchProtectionPAuthLR() {
        emitMOV();
        assert!(PACSym, "No PAC instruction to refer to");
        emitEpiloguePACSymOffsetIntoReg(*self.TII, MBB, DL, PACSym);
        BuildMI(MBB, DL, self.TII)(FrameDestroy);
        let mut AutOpc: u32 = 0;
        BuildMI(MBB, DL, self.TII(AutOpc))(FrameDestroy);
        emitAUTCFI(MBB, EmitAsyncCFI);
        emitMOV();
    } else if self.Subtarget() {
        BuildMI(MBB, DL, self.TII)(FrameDestroy);
        emitAUTCFI(MBB, EmitAsyncCFI);
    } else {
        emitMOV();
        let mut AutOpc: u32 = 0;
        BuildMI(MBB, DL, self.TII(AutOpc))(FrameDestroy);
        emitAUTCFI(MBB, EmitAsyncCFI);
        emitMOV();
    }
    if NeedsWinCFI {
        assert!(UseBKey, "Windows SEH PAC unwind info only supports B-key signing");
        BuildMI(MBB, DL, self.TII)(FrameDestroy);
    }
}

fn getCheckerSizeInBytes(Method: AuthCheckMethod) -> u32 {
    match Method {
        None => {
            return 0;
        },
        DummyLoad => {
            return 4;
        },
        HighBitsNoTBI => {
            return 12;
        },
        XPACHint => {
            XPAC;
        },
    }
    llvm_unreachable_internal("Unknown AuthCheckMethod enum", "llvm\\lib\\Target\\AArch64\\AArch64PointerAuth.cpp", 478);
}

fn AArch64PointerAuthImpl::run(self, MF: *mut MachineFunction) -> bool {
    self.Subtarget = operator&(MF);
    self.TII = self.Subtarget.getInstrInfo();
    let mut PAuthPseudoInstrs: i32 = 0;
    let mut Modified: bool = false;
    return Modified;
}

fn AArch64PointerAuthLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return AArch64PointerAuthImpl {}.run(MF);
}

fn AArch64PointerAuthPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64PointerAuthImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA;
    return PA;
}

struct Closure_1 {
    MBB: *mut MachineBasicBlock,
    DL: *mut DebugLoc,
    cap_2: *AArch64PointerAuthImpl,
    UseBKey: *mut bool,
    MF: *mut MachineFunction,
}

unsafe fn Closure_1::call(self: *mut Closure_1) {
            BuildMI((*self.MBB), (*self.DL), self.TII)(FrameSetup)((*self.MF));
        }

struct Closure_2 {
    MBB: *mut MachineBasicBlock,
    DL: *mut DebugLoc,
    cap_2: *AArch64PointerAuthImpl,
    UseBKey: *mut bool,
    MF: *mut MachineFunction,
}

unsafe fn Closure_2::call(self: *mut Closure_2) {
            BuildMI((*self.MBB), (*self.DL), self.TII)(FrameSetup)((*self.MF));
        }

struct Closure_3 {
    MBB: *mut MachineBasicBlock,
    DL: *mut DebugLoc,
    cap_2: *AArch64PointerAuthImpl,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Dst: Register, Src: Register) {
        BuildMI((*self.MBB), (*self.DL), self.TII, Dst)(Src)(0)(FrameDestroy);
    }
