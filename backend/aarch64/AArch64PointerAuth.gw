fn emitAUTCFI(MBB: *mut MachineBasicBlock, MBBI: iterator, EmitCFI: bool) {
    if !EmitCFI {
        return;
    }
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut MFnI: *mut AArch64FunctionInfo = *MF.getInfo();
    let mut CFIBuilder: CFIInstBuilder = CFIInstBuilder { MBB, MBBI, FrameDestroy, true };
    let mut TT: *Triple = MF.getTarget().getTargetTriple();
    if MFnI.branchProtectionPAuthLR() {
        match CFILLVMSetRASignStateMode.operator (anonymous namespace)::SetRAStateMode() {
            Never => {
                break;
            },
            PAuthLR => {
                Always;
            },
        }
    } else if !TT.isOSBinFormatMachO() {
        match CFILLVMSetRASignStateMode.operator (anonymous namespace)::SetRAStateMode() {
            Never => {
                PAuthLR;
            },
            Always => {
                CFIBuilder.buildSetRAState(0, null);
            },
        }
    }
}

fn AArch64PointerAuthImpl::signLR(self: *AArch64PointerAuthImpl, MF: *mut MachineFunction, MBBI: iterator) {
    let mut MFnI: *mut AArch64FunctionInfo = *MF.getInfo();
    let mut UseBKey: bool = MFnI.shouldSignWithBKey();
    let mut EmitCFI: bool = MFnI.needsDwarfUnwindInfo(MF);
    let mut NeedsWinCFI: bool = MF.hasWinCFI();
    let mut MBB: *mut MachineBasicBlock = *operator(MBBI).getParent();
    let mut DL: DebugLoc = null;
    if UseBKey && !MF.getTarget().getTargetTriple().isOSBinFormatMachO() {
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(EMITBKEY)).setMIFlag(FrameSetup);
    }
    if MFnI.branchProtectionPAuthLR() {
        let mut PACSym: *mut MCSymbol = MF.getContext().createTempSymbol();
        MFnI.setSigningInstrLabel(PACSym);
    }
    if MFnI.branchProtectionPAuthLR() && self.Subtarget.hasPAuthLR() {
        decoratePACWithCFI(MBB, MBBI, EmitCFI, Closure_1 { MBB: &mut MBB, MBBI: &mut MBBI, DL: &mut DL, cap_3: self, UseBKey: &mut UseBKey, MF: &mut MF, MFnI: &mut MFnI });
    } else {
        if MFnI.branchProtectionPAuthLR() {
            BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(PACM)).setMIFlag(FrameSetup);
        }
        decoratePACWithCFI(MBB, MBBI, EmitCFI, Closure_2 { MBB: &mut MBB, MBBI: &mut MBBI, DL: &mut DL, cap_3: self, UseBKey: &mut UseBKey, MF: &mut MF, MFnI: &mut MFnI });
    }
    if !EmitCFI && NeedsWinCFI {
        assert!(UseBKey, "Windows SEH PAC unwind info only supports B-key signing");
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SEH_PACSignLR)).setMIFlag(FrameSetup);
    }
}

fn AArch64PointerAuthImpl::authenticateLR(self: *AArch64PointerAuthImpl, MF: *mut MachineFunction, MBBI: iterator) {
    let mut MFnI: *AArch64FunctionInfo = MF.getInfo();
    let mut UseBKey: bool = MFnI.shouldSignWithBKey();
    let mut EmitAsyncCFI: bool = MFnI.needsAsyncDwarfUnwindInfo(MF);
    let mut NeedsWinCFI: bool = MF.hasWinCFI();
    let mut MBB: *mut MachineBasicBlock = *operator(MBBI).getParent();
    let mut DL: DebugLoc = operator(MBBI).getDebugLoc();
    let mut TI: iterator = MBB.getFirstInstrTerminator();
    let mut PACSym: *mut MCSymbol = MFnI.getSigningInstrLabel();
    let mut AFL: *AArch64FrameLowering = *MF.getSubtarget().getFrameLowering() as *AArch64FrameLowering;
    let mut ArgumentStackToRestore: i64 = AFL.getArgumentStackToRestore(MF, MBB);
    let mut TerminatorIsCombinable: bool = next(MBBI, 1) == TI && TI != MBB.end() && operator(TI).getOpcode() == RET && ArgumentStackToRestore == 0;
    if self.Subtarget.hasPAuth() && TerminatorIsCombinable && !NeedsWinCFI && !MF.getFunction().hasFnAttribute(ShadowCallStack) {
        if MFnI.branchProtectionPAuthLR() && self.Subtarget.hasPAuthLR() {
            assert!(PACSym, "No PAC instruction to refer to");
            BuildMI(MBB, TI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if UseBKey { RETABSPPCi } else { RETAASPPCi })).addSym(PACSym, 0).copyImplicitOps(operator(MBBI)).setMIFlag(FrameDestroy);
        } else {
            if MFnI.branchProtectionPAuthLR() {
                emitEpiloguePACSymOffsetIntoReg(*self.TII, MBB, MBBI, DL, PACSym, X16);
                BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(PACM)).setMIFlag(FrameDestroy);
            }
            BuildMI(MBB, TI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if UseBKey { RETAB } else { RETAA })).copyImplicitOps(operator(MBBI)).setMIFlag(FrameDestroy);
        }
        MBB.erase(TI);
        return;
    }
    if ArgumentStackToRestore == 0 {
        if MFnI.branchProtectionPAuthLR() && self.Subtarget.hasPAuthLR() {
            assert!(PACSym, "No PAC instruction to refer to");
            BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if UseBKey { AUTIBSPPCi } else { AUTIASPPCi })).addSym(PACSym, 0).setMIFlag(FrameDestroy);
            emitAUTCFI(MBB, MBBI, EmitAsyncCFI);
        } else {
            if MFnI.branchProtectionPAuthLR() {
                emitEpiloguePACSymOffsetIntoReg(*self.TII, MBB, MBBI, DL, PACSym, X16);
                BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(PACM)).setMIFlag(FrameDestroy);
            }
            BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if UseBKey { AUTIBSP } else { AUTIASP })).setMIFlag(FrameDestroy);
            emitAUTCFI(MBB, MBBI, EmitAsyncCFI);
        }
        if NeedsWinCFI {
            assert!(UseBKey, "Windows SEH PAC unwind info only supports B-key signing");
            BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SEH_PACSignLR)).setMIFlag(FrameDestroy);
        }
        return;
    }
    emitFrameOffset(MBB, MBBI, DL, X16, SP, getFixed(-ArgumentStackToRestore), self.TII, FrameDestroy, false, false, null, false, StackOffset {}, SP);
    let mut emitMOV: Closure_3 = Closure_3 { MBB: &mut MBB, MBBI: &mut MBBI, DL: &mut DL, cap_3: self };
    if MFnI.branchProtectionPAuthLR() && self.Subtarget.hasPAuthLR() {
        emitMOV.call(X17, LR);
        assert!(PACSym, "No PAC instruction to refer to");
        emitEpiloguePACSymOffsetIntoReg(*self.TII, MBB, MBBI, DL, PACSym, X15);
        let mut AutOpc: u32 = if UseBKey { AUTIB171615 } else { AUTIA171615 };
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(AutOpc)).setMIFlag(FrameDestroy);
        emitAUTCFI(MBB, MBBI, EmitAsyncCFI);
        emitMOV.call(LR, X17);
    } else if MFnI.branchProtectionPAuthLR() {
        emitMOV.call(X17, LR);
        assert!(PACSym, "No PAC instruction to refer to");
        emitEpiloguePACSymOffsetIntoReg(*self.TII, MBB, MBBI, DL, PACSym, X15);
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(PACM)).setMIFlag(FrameDestroy);
        let mut AutOpc: u32 = if UseBKey { AUTIB1716 } else { AUTIA1716 };
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(AutOpc)).setMIFlag(FrameDestroy);
        emitAUTCFI(MBB, MBBI, EmitAsyncCFI);
        emitMOV.call(LR, X17);
    } else if self.Subtarget.hasPAuth() {
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if UseBKey { AUTIB } else { AUTIA }), LR).addUse(LR, RegState {}, 0).addUse(X16, RegState {}, 0).setMIFlag(FrameDestroy);
        emitAUTCFI(MBB, MBBI, EmitAsyncCFI);
    } else {
        emitMOV.call(X17, LR);
        let mut AutOpc: u32 = if UseBKey { AUTIB1716 } else { AUTIA1716 };
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(AutOpc)).setMIFlag(FrameDestroy);
        emitAUTCFI(MBB, MBBI, EmitAsyncCFI);
        emitMOV.call(LR, X17);
    }
    if NeedsWinCFI {
        assert!(UseBKey, "Windows SEH PAC unwind info only supports B-key signing");
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(SEH_PACSignLR)).setMIFlag(FrameDestroy);
    }
}

fn getCheckerSizeInBytes(Method: AuthCheckMethod) -> u32 {
    match Method {
        None => {
            return 0;
        },
        DummyLoad => {
            return 4;
        },
        HighBitsNoTBI => {
            return 12;
        },
        XPACHint => {
            XPAC;
        },
    }
    llvm_unreachable_internal("Unknown AuthCheckMethod enum", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64PointerAuth.cpp", 478);
}

fn AArch64PointerAuthImpl::run(self, MF: *mut MachineFunction) -> bool {
    self.Subtarget = &mut MF.getSubtarget();
    self.TII = self.Subtarget.getInstrInfo();
    let mut PAuthPseudoInstrs: instr_iterator> = instr_iterator> {};
    let mut Modified: bool = false;
    for MBB in MF {
        for MI in MBB {
            match MI.getOpcode() {
                _ => {
                    break;
                },
                PAUTH_PROLOGUE => {
                    PAUTH_EPILOGUE;
                },
            }
        }
    }
    for It in PAuthPseudoInstrs {
        match operator(It).getOpcode() {
            PAUTH_PROLOGUE => {
                self.signLR(MF, It);
            },
            PAUTH_EPILOGUE => {
                self.authenticateLR(MF, It);
            },
            _ => {
                llvm_unreachable_internal("Unhandled opcode", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64PointerAuth.cpp", 511);
            },
        }
        operator(It).eraseFromParent();
        Modified = true;
    }
    return Modified;
}

fn AArch64PointerAuthLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return AArch64PointerAuthImpl {}.run(MF);
}

fn AArch64PointerAuthPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64PointerAuthImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

struct Closure_1 {
    MBB: *mut MachineBasicBlock,
    MBBI: *mut iterator,
    DL: *mut DebugLoc,
    cap_3: *AArch64PointerAuthImpl,
    UseBKey: *mut bool,
    MF: *mut MachineFunction,
    MFnI: *mut AArch64FunctionInfo,
}

unsafe fn Closure_1::call(self: *mut Closure_1) {
            operator(BuildMI((*self.MBB), (*self.MBBI), MIMetadata { DL: (*self.DL), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if (*self.UseBKey) { PACIBSPPC } else { PACIASPPC })).setMIFlag(FrameSetup)).setPreInstrSymbol((*self.MF), (*self.MFnI).getSigningInstrLabel());
        }

struct Closure_2 {
    MBB: *mut MachineBasicBlock,
    MBBI: *mut iterator,
    DL: *mut DebugLoc,
    cap_3: *AArch64PointerAuthImpl,
    UseBKey: *mut bool,
    MF: *mut MachineFunction,
    MFnI: *mut AArch64FunctionInfo,
}

unsafe fn Closure_2::call(self: *mut Closure_2) {
            operator(BuildMI((*self.MBB), (*self.MBBI), MIMetadata { DL: (*self.DL), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(if (*self.UseBKey) { PACIBSP } else { PACIASP })).setMIFlag(FrameSetup)).setPreInstrSymbol((*self.MF), (*self.MFnI).getSigningInstrLabel());
        }

struct Closure_3 {
    MBB: *mut MachineBasicBlock,
    MBBI: *mut iterator,
    DL: *mut DebugLoc,
    cap_3: *AArch64PointerAuthImpl,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Dst: Register, Src: Register) {
        BuildMI((*self.MBB), (*self.MBBI), MIMetadata { DL: (*self.DL), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ORRXrs), Dst).addReg(XZR, RegState {}, 0).addReg(Src, RegState {}, 0).addImm(0).setMIFlag(FrameDestroy);
    }
