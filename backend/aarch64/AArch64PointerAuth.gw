    return self.Kind;
}

fn AArch64PointerAuthLegacy::getPassID(self: *AArch64PointerAuthLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64PointerAuthLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64PointerAuthLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64PointerAuthLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64PointerAuthLegacy::getResolver(self: *AArch64PointerAuthLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64PointerAuthLegacy::getRequiredProperties(self: *AArch64PointerAuthLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64PointerAuthLegacy::getSetProperties(self: *AArch64PointerAuthLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
