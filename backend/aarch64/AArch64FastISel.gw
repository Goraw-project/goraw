struct AArch64FastISel {
    LocalValueMap: DenseMap<const Value *, Register>,
    FuncInfo: *mut FunctionLoweringInfo,
    MF: *mut MachineFunction,
    MRI: *mut MachineRegisterInfo,
    MFI: *mut MachineFrameInfo,
    MCP: *mut MachineConstantPool,
    MIMD: MIMetadata,
    TM: *TargetMachine,
    DL: *DataLayout,
    TII: *TargetInstrInfo,
    TLI: *TargetLowering,
    TRI: *TargetRegisterInfo,
    LibInfo: *TargetLibraryInfo,
    LibcallLowering: *LibcallLoweringInfo,
    SkipTargetIndependentISel: bool,
    LastLocalValue: *mut MachineInstr,
    EmitStartPt: *mut MachineInstr,
    SavedInsertPt: iterator,
    Subtarget: *AArch64Subtarget,
    Context: *mut LLVMContext,
}

fn AArch64FastISel::AArch64FastISel(self, FuncInfo: *mut FunctionLoweringInfo, LibInfo: *TargetLibraryInfo, libcallLowering: *LibcallLoweringInfo) {
    self.Subtarget = &mut FuncInfo.MF.getSubtarget();
    self.Context = &mut FuncInfo.Fn.getContext();
}

fn AArch64FastISel::Predicate_imm0_31(self, Imm: i64) -> bool {
    return (Imm as u64) < 32;
}

fn AArch64FastISel::Predicate_imm0_63(self, Imm: i64) -> bool {
    return (Imm as u64) < 64;
}

fn AArch64FastISel::Predicate_VectorIndexD(self, Imm: i64) -> bool {
    return (Imm as u64) < 2;
}

fn AArch64FastISel::Predicate_VectorIndexS(self, Imm: i64) -> bool {
    return (Imm as u64) < 4;
}

fn AArch64FastISel::Predicate_VectorIndexH(self, Imm: i64) -> bool {
    return (Imm as u64) < 8;
}

fn AArch64FastISel::Predicate_VectorIndexB(self, Imm: i64) -> bool {
    return (Imm as u64) < 16;
}

fn AArch64FastISel::Predicate_VectorIndex0(self, Imm: i64) -> bool {
    return (Imm as u64) == 0;
}

fn AArch64FastISel::Predicate_imm0_255(self, Imm: i64) -> bool {
    return (Imm as u32) < 256;
}

fn AArch64FastISel::Predicate_simm8_32b(self, Imm: i64) -> bool {
    return Imm >= -128 && Imm < 128;
}

fn AArch64FastISel::Predicate_simm8_64b(self, Imm: i64) -> bool {
    return Imm >= -128 && Imm < 128;
}

fn AArch64FastISel::Predicate_uimm8_32b(self, Imm: i64) -> bool {
    return Imm >= 0 && Imm < 256;
}

fn AArch64FastISel::Predicate_uimm8_64b(self, Imm: i64) -> bool {
    return Imm >= 0 && Imm < 256;
}

fn AArch64FastISel::Predicate_simm6_32b(self, Imm: i64) -> bool {
    return Imm >= -32 && Imm < 32;
}

fn AArch64FastISel::fastEmit_AArch64ISD_ENTRY_PSTATE_SM_MVT_i64_(self, RetVT: MVT) -> Register {
    if RetVT.SimpleTy != i64 {
        return Register { Reg: 0 };
    }
    return self.fastEmitInst_(EntryPStateSM, &mut GPR64RegClass);
}

fn AArch64FastISel::fastEmit_AArch64ISD_ENTRY_PSTATE_SM_(self, VT: MVT, RetVT: MVT) -> Register {
    match VT.SimpleTy {
        i64 => {
            return self.fastEmit_AArch64ISD_ENTRY_PSTATE_SM_MVT_i64_(RetVT);
        },
        _ => {
            return Register { Reg: 0 };
        },
    }
}

fn AArch64FastISel::fastEmit_AArch64ISD_THREAD_POINTER_MVT_i64_(self, RetVT: MVT) -> Register {
    if RetVT.SimpleTy != i64 {
        return Register { Reg: 0 };
    }
    return self.fastEmitInst_(MOVbaseTLS, &mut GPR64RegClass);
}

fn AArch64FastISel::fastEmit_AArch64ISD_THREAD_POINTER_(self, VT: MVT, RetVT: MVT) -> Register {
    match VT.SimpleTy {
        i64 => {
            return self.fastEmit_AArch64ISD_THREAD_POINTER_MVT_i64_(RetVT);
        },
        _ => {
            return Register { Reg: 0 };
        },
    }
}

fn AArch64FastISel::fastEmit_(self, VT: MVT, RetVT: MVT, Opcode: u32) -> Register {
    match Opcode {
        ENTRY_PSTATE_SM => {
            return self.fastEmit_AArch64ISD_ENTRY_PSTATE_SM_(VT, RetVT);
        },
        THREAD_POINTER => {
            return self.fastEmit_AArch64ISD_THREAD_POINTER_(VT, RetVT);
        },
        _ => {
            return Register { Reg: 0 };
        },
    }
}

