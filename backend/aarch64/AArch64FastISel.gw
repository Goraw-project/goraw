        if RVEVT.isVector() && RVEVT.getVectorElementCount().isVector() && !self.Subtarget.isLittleEndian() {
            return false;
        }
        let mut RVVT: MVT = RVEVT.getSimpleVT();
        if RVVT == f128 {
