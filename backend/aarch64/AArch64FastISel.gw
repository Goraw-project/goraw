            let mut ResultReg: Register = self.emitLSL_ri(VT, SrcVT, Src0Reg, ShiftVal, IsZExt);
            if ResultReg.operator unsigned int() {
                self.updateValueMap;
                return true;
            }
        }
    }
    let mut Src0Reg: Register = self.getRegForValue(I.getOperand);
    if !Src0Reg.operator unsigned int() {
        return false;
    }
    let mut Src1Reg: Register = self.getRegForValue(I.getOperand);
    if !Src1Reg.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = self.emitMul_rr(VT, Src0Reg, Src1Reg);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap;
    return true;
}

fn AArch64FastISel::selectShift(self, I: *Instruction) -> bool {
    let mut RetVT: MVT = MVT {};
    if operator!(self.isTypeSupported(I.getType, RetVT, true)) {
        return false;
    }
    if RetVT.isVector() {
        return self.selectOperator;
    }
    if  {
        let mut ResultReg: Register = 0;
        let mut ShiftVal: u64 = ();
        let mut SrcVT: MVT = RetVT;
        let mut IsZExt: bool = I.getOpcode() != AShr;
        let mut Op0: *Value = I.getOperand;
        if  {
            if operator!(isIntExtFree()) {
                let mut TmpVT: MVT = MVT {};
                if self.isValueAvailable() && self.isTypeSupported(TmpVT) {
                    SrcVT = TmpVT;
                    IsZExt = true;
                    Op0 = (0);
                }
            }
        } else if  {
            if operator!(isIntExtFree()) {
                let mut TmpVT: MVT = MVT {};
                if self.isValueAvailable() && self.isTypeSupported(TmpVT) {
                    SrcVT = TmpVT;
                    IsZExt = false;
                    Op0 = (0);
                }
            }
        }
        let mut Op0Reg: Register = self.getRegForValue;
        if !Op0Reg.operator unsigned int() {
            return false;
        }
        match I.getOpcode() {
            _ => {
                llvm_unreachable_internal("Unexpected instruction.", "llvm\\lib\\Target\\AArch64\\AArch64FastISel.cpp", 4718);
            },
            Shl => {
                ResultReg = self.emitLSL_ri(RetVT, SrcVT, Op0Reg, ShiftVal, IsZExt);
            },
            AShr => {
                ResultReg = self.emitASR_ri(RetVT, SrcVT, Op0Reg, ShiftVal, IsZExt);
            },
            LShr => {
                ResultReg = self.emitLSR_ri(RetVT, SrcVT, Op0Reg, ShiftVal, IsZExt);
            },
        }
        if !ResultReg.operator unsigned int() {
            return false;
        }
        self.updateValueMap;
        return true;
    }
    let mut Op0Reg: Register = self.getRegForValue(I.getOperand);
    if !Op0Reg.operator unsigned int() {
        return false;
    }
    let mut Op1Reg: Register = self.getRegForValue(I.getOperand);
    if !Op1Reg.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = 0;
    match I.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected instruction.", "llvm\\lib\\Target\\AArch64\\AArch64FastISel.cpp", 4746);
        },
        Shl => {
            ResultReg = self.emitLSL_rr(RetVT, Op0Reg, Op1Reg);
        },
        AShr => {
            ResultReg = self.emitASR_rr(RetVT, Op0Reg, Op1Reg);
        },
        LShr => {
            ResultReg = self.emitLSR_rr(RetVT, Op0Reg, Op1Reg);
        },
    }
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap;
    return true;
}

