    let mut IsBitTest: bool = TestBit != -1;
    let mut Is64Bit: bool = BW == 64;
    if TestBit < 32 && TestBit >= 0 {
        Is64Bit = false;
    }
    let mut Opc: u32 = OpcTable[IsBitTest][IsCmpNE][Is64Bit];
    let mut II: *MCInstrDesc = null;
    let mut SrcReg: Register = self.getRegForValue;
    if !SrcReg.operator unsigned int() {
        return false;
    }
    if BW == 64 && !Is64Bit {
        SrcReg = self.fastEmitInst_extractsubreg;
    }
    if (BW < 32) && !IsBitTest {
        SrcReg = self.emitIntExt(VT, SrcReg, i32, true);
    }
    SrcReg = self.constrainOperandRegClass;
    let mut MIB: MachineInstrBuilder = BuildMI()(SrcReg);
    if IsBitTest {
        MIB()(TestBit);
    }
    MIB()(TBB);
    self.finishCondBranch(BI()(), TBB, FBB);
    return true;
}

fn AArch64FastISel::selectBranch(self, I: *Instruction) -> bool {
    let mut BI: *CondBrInst = cast(I);
