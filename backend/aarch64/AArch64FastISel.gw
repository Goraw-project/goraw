    let mut RegInfo: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
    if RegInfo.isAnyArgRegReserved {
        RegInfo.emitReservedArgRegCallError;
    }
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    if self.Subtarget.useSmallAddressing() {
        let mut II: *MCInstrDesc = null;
        MIB = BuildMI(II);
        if Symbol {
            MIB()(Symbol, 0);
        } else if Addr.getGlobalValue() {
            MIB()(Addr.getGlobalValue(), 0, 0);
        } else if Addr.getReg().operator unsigned int() {
            let mut Reg: Register = self.constrainOperandRegClass;
            MIB()(Reg);
        } else {
