    if  {
        Opcode = ();
        U = ;
    } else if  {
        Opcode = ();
        U = ;
    }
    match Opcode {
        _ => {
            break;
        },
        BitCast => {
            if InMBB {
                return self.computeCallAddress(U.getOperand(0), Addr);
            }
        },
        IntToPtr => {
            if  {
                return self.computeCallAddress(U.getOperand(0), Addr);
            }
        },
        PtrToInt => {
            if  {
                return self.computeCallAddress(U.getOperand(0), Addr);
            }
        },
    }
    if dyn_cast(V) {
        GV;
    } else {
        Addr.setGlobalValue(GV);
        return true;
    }
    if !Addr.getGlobalValue() {
        Addr.setReg(self.getRegForValue);
        return Addr.getReg().isValid();
    }
    return false;
}

fn AArch64FastISel::isTypeLegal(self, Ty: *mut Type, VT: *mut MVT) -> bool {
    let mut evt: EVT = zeroed();
    if self.Subtarget.isTargetILP32() && Ty.isPointerTy() {
        return false;
    }
    if evt == Other || !evt.isSimple() {
        return false;
    }
    VT = evt.getSimpleVT();
    if VT == f128 {
        return false;
    }
}

fn AArch64FastISel::isTypeSupported(self, Ty: *mut Type, VT: *mut MVT, IsVectorAllowed: bool) -> bool {
    if Ty.isVectorTy() && !IsVectorAllowed {
        return false;
    }
    if self.isTypeLegal(Ty, VT) {
        return true;
    }
    if VT == i1 || VT == i8 || VT == i16 {
        return true;
    }
    return false;
}

fn AArch64FastISel::isValueAvailable(self: *AArch64FastISel, V: *Value) -> bool {
    if !isa(V) {
        return true;
    }
    let mut I: *auto = cast(V);
}

fn AArch64FastISel::simplifyAddress(self, Addr: *mut Address, VT: MVT) -> bool {
    if self.Subtarget.isTargetILP32() {
        return false;
    }
    let mut ScaleFactor: u32 = getImplicitScaleFactor(VT);
    if !ScaleFactor {
        return false;
    }
    let mut ImmediateOffsetNeedsLowering: bool = false;
    let mut RegisterOffsetNeedsLowering: bool = false;
    let mut Offset: i64 = Addr.getOffset();
    if ((Offset < 0) || (Offset & (ScaleFactor - 1))) && !isInt(Offset) {
        ImmediateOffsetNeedsLowering = true;
    } else if Offset > 0 && !(Offset & (ScaleFactor - 1)) && !isUInt(Offset / ScaleFactor) {
        ImmediateOffsetNeedsLowering = true;
    }
    if !ImmediateOffsetNeedsLowering && Addr.getOffset() && Addr.getOffsetReg().operator unsigned int() {
        RegisterOffsetNeedsLowering = true;
    }
    if Addr.isRegBase() && Addr.getOffsetReg().operator unsigned int() && !Addr.getReg().operator unsigned int() {
        RegisterOffsetNeedsLowering = true;
    }
    if (ImmediateOffsetNeedsLowering || Addr.getOffsetReg().operator unsigned int()) && Addr.isFIBase() {
        let mut ResultReg: Register = self.createResultReg;
        BuildMI(ResultReg)(Addr.getFI())(0)(0);
        Addr.setKind(RegBase);
        Addr.setReg(ResultReg);
    }
    if RegisterOffsetNeedsLowering {
        let mut ResultReg: Register = 0;
        if Addr.getReg().operator unsigned int() {
            if Addr.getExtendType() == SXTW || Addr.getExtendType() == UXTW {
                ResultReg = self.emitAddSub_rx(true, i64, Addr.getReg(), Addr.getOffsetReg(), Addr.getExtendType(), Addr.getShift(), false, true);
            } else {
                ResultReg = self.emitAddSub_rs(true, i64, Addr.getReg(), Addr.getOffsetReg(), LSL, Addr.getShift(), false, true);
            }
        } else {
            if Addr.getExtendType() == UXTW {
                ResultReg = self.emitLSL_ri(i64, i32, Addr.getOffsetReg(), Addr.getShift(), true);
            } else if Addr.getExtendType() == SXTW {
                ResultReg = self.emitLSL_ri(i64, i32, Addr.getOffsetReg(), Addr.getShift(), false);
            } else {
                ResultReg = self.emitLSL_ri(i64, i64, Addr.getOffsetReg(), Addr.getShift(), true);
            }
        }
        if !ResultReg.operator unsigned int() {
            return false;
        }
        Addr.setReg(ResultReg);
        Addr.setOffsetReg(0);
        Addr.setShift(0);
        Addr.setExtendType(InvalidShiftExtend);
    }
    if ImmediateOffsetNeedsLowering {
        let mut ResultReg: Register = 0;
        if Addr.getReg().operator unsigned int() {
            ResultReg = self.emitAdd_ri_(i64, Addr.getReg(), Offset);
        } else {
            ResultReg = self.fastEmit_i;
        }
        if !ResultReg.operator unsigned int() {
            return false;
        }
        Addr.setReg(ResultReg);
        Addr.setOffset(0);
    }
    return true;
}

fn AArch64FastISel::addLoadStoreOperands(self, Addr: *mut Address, MIB: *MachineInstrBuilder, Flags: Flags, ScaleFactor: u32, MMO: *mut MachineMemOperand) {
    let mut Offset: i64 = Addr.getOffset() / ScaleFactor;
    if Addr.isFIBase() {
        let mut FI: i32 = Addr.getFI();
        MIB()(FI)(Offset);
    } else {
        assert!(Addr.isRegBase(), "Unexpected address kind.");
        let mut II: *MCInstrDesc = operator(MIB).getDesc();
        let mut Idx: u32 = if (Flags & MOStore) { 1 } else { 0 };
        Addr.setReg(self.constrainOperandRegClass);
        Addr.setOffsetReg(self.constrainOperandRegClass);
        if Addr.getOffsetReg().operator unsigned int() {
            assert!(Addr.getOffset() == 0, "Unexpected offset");
            let mut IsSigned: bool = Addr.getExtendType() == SXTW || Addr.getExtendType() == SXTX;
            MIB()(Addr.getReg());
            MIB()(Addr.getOffsetReg());
            MIB()(IsSigned);
            MIB()(Addr.getShift() != 0);
        } else {
            MIB()(Addr.getReg())(Offset);
        }
    }
    if MMO {
        operator(MIB).addMemOperand;
    }
}

fn AArch64FastISel::emitAddSub(self, UseAdd: bool, RetVT: MVT, LHS: *Value, RHS: *Value, SetFlags: bool, WantResult: bool, IsZExt: bool) -> Register {
    let mut ExtendType: ShiftExtendType = InvalidShiftExtend;
    let mut NeedExtend: bool = false;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i1 => {
            NeedExtend = true;
        },
        i8 => {
            NeedExtend = true;
        },
        i16 => {
            NeedExtend = true;
        },
        i32 => {
            i64;
        },
    }
    let mut SrcVT: MVT = RetVT;
    RetVT.SimpleTy = max(RetVT.SimpleTy, i32);
    if UseAdd && isa(LHS) && !isa(RHS) {
        swap(LHS, RHS);
    }
    if UseAdd && LHS.hasOneUse() && self.isValueAvailable(LHS) {
        if isMulPowOf2(LHS) {
            swap(LHS, RHS);
        }
    }
    if UseAdd && LHS.hasOneUse() && self.isValueAvailable(LHS) {
        if  {
            if isa((1)) {
                if SI()() == Shl || () == LShr || () == AShr {
                    swap(LHS, RHS);
                }
            }
        }
    }
    let mut LHSReg: Register = self.getRegForValue;
    if !LHSReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    if NeedExtend {
        LHSReg = self.emitIntExt(SrcVT, LHSReg, RetVT, IsZExt);
    }
    let mut ResultReg: Register = 0;
    if  {
        let mut Imm: u64 = if IsZExt { () } else { () };
        if C()() {
            ResultReg = self.emitAddSub_ri(!UseAdd, RetVT, LHSReg, -Imm, SetFlags, WantResult);
        } else {
            ResultReg = self.emitAddSub_ri(UseAdd, RetVT, LHSReg, Imm, SetFlags, WantResult);
        }
    } else if  {
        if C()() {
            ResultReg = self.emitAddSub_ri(UseAdd, RetVT, LHSReg, 0, SetFlags, WantResult);
        }
    }
    if ResultReg.operator unsigned int() {
        return ResultReg;
    }
    if ExtendType != InvalidShiftExtend && RHS.hasOneUse() && self.isValueAvailable(RHS) {
        let mut RHSReg: Register = self.getRegForValue;
        if !RHSReg.operator unsigned int() {
            return Register { Reg: 0 };
        }
        return self.emitAddSub_rx(UseAdd, RetVT, LHSReg, RHSReg, ExtendType, 0, SetFlags, WantResult);
    }
    if RHS.hasOneUse() && self.isValueAvailable(RHS) {
        if isMulPowOf2(RHS) {
            let mut MulLHS: *Value = cast(RHS)(0);
            let mut MulRHS: *Value = cast(RHS)(1);
            if  {
                if C()()() {
                    swap(MulLHS, MulRHS);
                }
            }
            assert!(isa(MulRHS), "Expected a ConstantInt.");
            let mut ShiftVal: u64 = cast(MulRHS)()();
            let mut RHSReg: Register = self.getRegForValue;
            if !RHSReg.operator unsigned int() {
                return Register { Reg: 0 };
            }
            ResultReg = self.emitAddSub_rs(UseAdd, RetVT, LHSReg, RHSReg, LSL, ShiftVal, SetFlags, WantResult);
            if ResultReg.operator unsigned int() {
                return ResultReg;
            }
        }
    }
    if RHS.hasOneUse() && self.isValueAvailable(RHS) {
        if  {
            if  {
                let mut ShiftType: ShiftExtendType = InvalidShiftExtend;
                match SI()() {
                    _ => {
                        break;
                    },
                    Shl => {
                        ShiftType = LSL;
                    },
                    LShr => {
                        ShiftType = LSR;
                    },
                    AShr => {
                        ShiftType = ASR;
                    },
                }
                let mut ShiftVal: u64 = ();
                if ShiftType != InvalidShiftExtend {
                    let mut RHSReg: Register = self.getRegForValue((0));
                    if !RHSReg.operator unsigned int() {
                        return Register { Reg: 0 };
                    }
                    ResultReg = self.emitAddSub_rs(UseAdd, RetVT, LHSReg, RHSReg, ShiftType, ShiftVal, SetFlags, WantResult);
                    if ResultReg.operator unsigned int() {
                        return ResultReg;
                    }
                }
            }
        }
    }
    let mut RHSReg: Register = self.getRegForValue;
    if !RHSReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    if NeedExtend {
        RHSReg = self.emitIntExt(SrcVT, RHSReg, RetVT, IsZExt);
    }
    return self.emitAddSub_rr(UseAdd, RetVT, LHSReg, RHSReg, SetFlags, WantResult);
}

fn AArch64FastISel::emitAddSub_rr(self, UseAdd: bool, RetVT: MVT, LHSReg: Register, RHSReg: Register, SetFlags: bool, WantResult: bool) -> Register {
    assert!(LHSReg.operator unsigned int() && RHSReg.operator unsigned int(), "Invalid register number.");
    if  {
        return Register { Reg: 0 };
    }
    if RetVT != i32 && RetVT != i64 {
        return Register { Reg: 0 };
    }
    let mut OpcTable: [2]u32 = zeroed();
    let mut Is64Bit: bool = RetVT == i64;
    let mut Opc: u32 = OpcTable[SetFlags][UseAdd][Is64Bit];
    let mut RC: *TargetRegisterClass = null;
    let mut ResultReg: Register = 0;
    if WantResult {
        ResultReg = self.createResultReg;
    } else {
        
    }
    let mut II: *MCInstrDesc = null;
    LHSReg = self.constrainOperandRegClass;
    RHSReg = self.constrainOperandRegClass;
    BuildMI(II, ResultReg)(LHSReg)(RHSReg);
    return ResultReg;
}

fn AArch64FastISel::emitAddSub_ri(self, UseAdd: bool, RetVT: MVT, LHSReg: Register, Imm: u64, SetFlags: bool, WantResult: bool) -> Register {
    assert!(LHSReg.operator unsigned int(), "Invalid register number.");
    if RetVT != i32 && RetVT != i64 {
        return Register { Reg: 0 };
    }
    let mut ShiftImm: u32 = 0;
    if isUInt(Imm) {
        ShiftImm = 0;
    } else if (Imm & 16773120) == Imm {
        ShiftImm = 12;
        Imm >>= 12;
    } else {
        return Register { Reg: 0 };
    }
    let mut OpcTable: [2]u32 = zeroed();
    let mut Is64Bit: bool = RetVT == i64;
    let mut Opc: u32 = OpcTable[SetFlags][UseAdd][Is64Bit];
    let mut RC: *TargetRegisterClass = null;
    let mut ResultReg: Register = 0;
    if WantResult {
        ResultReg = self.createResultReg;
    } else {
        
    }
    let mut II: *MCInstrDesc = null;
    LHSReg = self.constrainOperandRegClass;
    BuildMI(II, ResultReg)(LHSReg)(Imm)(getShifterImm(LSL, ShiftImm));
    return ResultReg;
}

fn AArch64FastISel::emitAddSub_rs(self, UseAdd: bool, RetVT: MVT, LHSReg: Register, RHSReg: Register, ShiftType: ShiftExtendType, ShiftImm: u64, SetFlags: bool, WantResult: bool) -> Register {
    assert!(LHSReg.operator unsigned int() && RHSReg.operator unsigned int(), "Invalid register number.");
    if RetVT != i32 && RetVT != i64 {
