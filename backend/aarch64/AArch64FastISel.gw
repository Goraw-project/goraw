fn AArch64FastISel::fastEmit_i(self, VT: MVT, RetVT: MVT, Opcode: u32, imm0: u64) -> Register {
    if VT == i32 && Predicate_imm0_255(imm0) {
        if self.fastEmit_i_Predicate_imm0_255(VT, RetVT, Opcode, imm0) {
            Reg.operator unsigned int();
        } else {
            return Reg;
        }
    }
    if VT == i32 && Predicate_simm6_32b(imm0) {
        if self.fastEmit_i_Predicate_simm6_32b(VT, RetVT, Opcode, imm0) {
            Reg.operator unsigned int();
        } else {
            return Reg;
        }
    }
    match Opcode {
        Constant => {
            return self.fastEmit_ISD_Constant_i(VT, RetVT, imm0);
        },
        _ => {
            return Register { Reg: 0 };
        },
    }
}

