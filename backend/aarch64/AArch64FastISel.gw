fn getCompareCC(Pred: Predicate) -> CondCode {
    match Pred {
        FCMP_ONE => {
            FCMP_UEQ;
        },
        ICMP_EQ => {
            FCMP_OEQ;
        },
        ICMP_SGT => {
            FCMP_OGT;
        },
        ICMP_SGE => {
            FCMP_OGE;
        },
        ICMP_UGT => {
            FCMP_UGT;
        },
        FCMP_OLT => {
            return MI;
        },
        ICMP_ULE => {
            FCMP_OLE;
        },
        FCMP_ORD => {
            return VC;
        },
        FCMP_UNO => {
            return VS;
        },
        FCMP_UGE => {
            return PL;
        },
        ICMP_SLT => {
            FCMP_ULT;
        },
        ICMP_SLE => {
            FCMP_ULE;
        },
        FCMP_UNE => {
            ICMP_NE;
        },
        ICMP_UGE => {
            return HS;
        },
        ICMP_ULT => {
            return LO;
        },
    }
}

fn AArch64FastISel::emitCompareAndBranch(self, BI: *CondBrInst) -> bool {
    if  {
        return false;
    }
    assert!(isa(BI.getCondition()), "Expected cmp instruction");
    let mut CI: *CmpInst = cast(BI.getCondition());
    let mut Predicate: Predicate = self.optimizeCmpPredicate;
    let mut LHS: *Value = CI.getOperand(0);
    let mut RHS: *Value = CI.getOperand(1);
    let mut VT: MVT = MVT {};
    if !self.isTypeSupported(LHS.getType(), VT, false) {
