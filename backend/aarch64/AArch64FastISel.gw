    Args()(I.getNumOperands);
    let mut CLI: CallLoweringInfo = CallLoweringInfo {};
    let mut Ctx: *mut MCContext = null;
    let mut CC: ID = zeroed();
    let mut FuncName: str = getLibcallImplName(LCImpl);
    CLI();
    if ! {
        return false;
    }
    self.updateValueMap;
    return true;
}

fn AArch64FastISel::selectSDiv(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if operator!(self.isTypeLegal(I.getType, VT)) {
        return false;
    }
    if operator!(isa(I.getOperand)) {
        return self.selectBinaryOp;
    }
    let mut C: *APInt = cast(I.getOperand)();
    if (VT != i32 && VT != i64) || operator(C) || !(C.isPowerOf2() || C.isNegatedPowerOf2()) {
        return self.selectBinaryOp;
    }
    let mut Lg2: u32 = C.countr_zero();
    let mut Src0Reg: Register = self.getRegForValue(I.getOperand);
    if !Src0Reg.operator unsigned int() {
        return false;
    }
    if cast(I)() {
        let mut ResultReg: Register = self.emitASR_ri(VT, VT, Src0Reg, Lg2, false);
        if !ResultReg.operator unsigned int() {
            return false;
        }
        self.updateValueMap;
        return true;
    }
    let mut Pow2MinusOne: i64 = (1 << Lg2) - 1;
    let mut AddReg: Register = self.emitAdd_ri_(VT, Src0Reg, Pow2MinusOne);
    if !AddReg.operator unsigned int() {
        return false;
    }
    if !self.emitICmp_ri(VT, Src0Reg, 0) {
        return false;
    }
    let mut SelectOpc: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    if VT == i64 {} else {}
    let mut SelectReg: Register = self.fastEmitInst_rri;
    if !SelectReg.operator unsigned int() {
        return false;
    }
    let mut ZeroReg: Register = zeroed();
    let mut ResultReg: Register = 0;
    if C.isNegative() {
        ResultReg = self.emitAddSub_rs(false, VT, ZeroReg, SelectReg, ASR, Lg2, false, true);
    } else {
        ResultReg = self.emitASR_ri(VT, VT, SelectReg, Lg2, false);
    }
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap;
    return true;
}

fn AArch64FastISel::getRegForGEPIndex(self, Idx: *Value) -> Register {
    let mut IdxN: Register = self.getRegForValue;
    if !IdxN.operator unsigned int() {
        return Register { Reg: 0 };
    }
    let mut PtrVT: MVT = zeroed();
    let mut IdxVT: EVT = getEVT(Idx.getType(), false);
    if IdxVT.bitsLT(PtrVT) {
        IdxN = self.emitIntExt(IdxVT.getSimpleVT(), IdxN, PtrVT, false);
    } else if IdxVT.bitsGT(PtrVT) {
        llvm_unreachable_internal("AArch64 FastISel doesn't support types larger than i64", "llvm\\lib\\Target\\AArch64\\AArch64FastISel.cpp", 4915);
    }
    return IdxN;
}

