fn AArch64FastISel::fastEmit_AArch64ISD_DUP_MVT_i32_MVT_v8i8_r(self, Op0: Register) -> Register {
    if (self.Subtarget.isNeonAvailable()) {
        return self.fastEmitInst_r(DUPv8i8gpr, &mut FPR64RegClass, Op0);
    }
    return Register { Reg: 0 };
}

