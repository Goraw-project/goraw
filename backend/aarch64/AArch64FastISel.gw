        }
    } else {
        let mut CallReg: Register = 0;
        if Symbol {
            let mut ADRPReg: Register = self.createResultReg;
            BuildMI(ADRPReg)(Symbol, MO_GOT | MO_PAGE);
            CallReg = self.createResultReg;
            BuildMI(CallReg)(ADRPReg)(Symbol, MO_GOT | MO_PAGEOFF | MO_NC);
        } else if Addr.getGlobalValue() {
            CallReg = self.materializeGV(Addr.getGlobalValue());
        } else if Addr.getReg().operator unsigned int() {
            CallReg = Addr.getReg();
        }
        if !CallReg.operator unsigned int() {
            return false;
        }
        let mut II: *MCInstrDesc = null;
        CallReg = self.constrainOperandRegClass;
        MIB = BuildMI(II)(CallReg);
    }
    MIB();
    CLI.Call = MIB.operator llvm::MachineInstr *();
    return self.finishCall(CLI, NumBytes);
}

fn AArch64FastISel::isMemCpySmall(self, Len: u64, Alignment: MaybeAlign) -> bool {
    if Alignment() {
        return Len / Alignment()() <= 4;
    } else {
        return Len < 32;
    }
}

fn AArch64FastISel::tryEmitSmallMemCpy(self, Dest: Address, Src: Address, Len: u64, Alignment: MaybeAlign) -> bool {
    if !self.isMemCpySmall(Len, Alignment) {
        return false;
    }
    let mut UnscaledOffset: i64 = 0;
    let mut OrigDest: Address = Dest;
    let mut OrigSrc: Address = Src;
    while Len {
        let mut VT: MVT = MVT {};
        if Alignment() || Alignment() >= 8 {
            if Len >= 8 {
                VT = i64;
            } else if Len >= 4 {
                VT = i32;
            } else if Len >= 2 {
                VT = i16;
            } else {
                VT = i8;
            }
        } else {
            (((operator!(operator!((Alignment("Alignment is set in this branch"))))) || (_wassert(L"Alignment && \"Alignment is set in this branch\"", L"llvm\\lib\\Target\\AArch64\\AArch64FastISel.cpp", (3320) as u32) , 0)) as void);
            if Len >= 4 && Alignment() == 4 {
                VT = i32;
            } else if Len >= 2 && Alignment() == 2 {
                VT = i16;
            } else {
                VT = i8;
            }
        }
        let mut ResultReg: Register = self.emitLoad(VT, VT, Src, true, null);
        if !ResultReg.operator unsigned int() {
            return false;
        }
        if !self.emitStore(VT, ResultReg, Dest, null) {
            return false;
        }
        let mut Size: i64 = VT.getSizeInBits();
        Len -= Size;
        UnscaledOffset += Size;
        Dest.setOffset(OrigDest.getOffset() + UnscaledOffset);
        Src.setOffset(OrigSrc.getOffset() + UnscaledOffset);
    }
    return true;
}

fn AArch64FastISel::foldXALUIntrinsic(self, CC: *mut CondCode, I: *Instruction, Cond: *Value) -> bool {
    if !isa(Cond) {
        return false;
    }
    let mut EV: *auto = cast(Cond);
    if operator!(isa()) {
        return false;
    }
    let mut II: *auto = cast();
    let mut RetVT: MVT = MVT {};
    let mut Callee: *Function = ();
