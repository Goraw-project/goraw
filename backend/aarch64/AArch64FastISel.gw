struct AArch64FastISel {
    LocalValueMap: i32,
    FuncInfo: *mut FunctionLoweringInfo,
    MF: *mut MachineFunction,
    MRI: *mut MachineRegisterInfo,
    MFI: *mut MachineFrameInfo,
    MCP: *mut MachineConstantPool,
    MIMD: MIMetadata,
    TM: *TargetMachine,
    DL: *DataLayout,
    TII: *TargetInstrInfo,
    TLI: *TargetLowering,
    TRI: *TargetRegisterInfo,
    LibInfo: *TargetLibraryInfo,
    LibcallLowering: *LibcallLoweringInfo,
    SkipTargetIndependentISel: bool,
    LastLocalValue: *mut MachineInstr,
    EmitStartPt: *mut MachineInstr,
    SavedInsertPt: i32,
    Subtarget: *AArch64Subtarget,
    Context: *mut LLVMContext,
}

fn AArch64FastISel::AArch64FastISel(self, FuncInfo: *mut FunctionLoweringInfo, LibInfo: *TargetLibraryInfo, libcallLowering: *LibcallLoweringInfo) {
    self.Subtarget = operator&(FuncInfo.MF);
    self.Context = &mut FuncInfo.Fn.getContext();
}

fn AArch64FastISel::getLastLocalValue(self) -> *mut MachineInstr {
    return self.LastLocalValue;
}

fn AArch64FastISel::setLastLocalValue(self, I: *mut MachineInstr) {
    self.EmitStartPt = I;
    self.LastLocalValue = I;
}

fn AArch64FastISel::getCurDebugLoc(self: *AArch64FastISel) -> DebugLoc {
    return self.MIMD.getDL();
}

fn AArch64FastISel::tryToFoldLoadIntoMI(self, arg: *mut MachineInstr, arg: u32, arg: *LoadInst) -> bool {
    return false;
}

fn AArch64FastISel::shouldOptForSize(self: *AArch64FastISel, MF: *MachineFunction) -> bool {
    return MF.getFunction().hasOptSize();
}

fn isIntExtFree(I: *Instruction) -> bool {
    assert!((isa(I) || isa(I)), "Unexpected integer extend instruction.");
    (((operator!(operator!((operator!(I.getType()) && I.getType() && "Unexpected value type.")))) || (_wassert(L"!I->getType()->isVectorTy() && I->getType()->isIntegerTy() && \"Unexpected value type.\"", L"llvm\\lib\\Target\\AArch64\\AArch64FastISel.cpp", (297) as u32) , 0)) as void);
    let mut IsZExt: bool = isa(I);
    if  {
        if LI()() {
            return true;
        }
    }
    if  {
        if (IsZExt && ()) || (!IsZExt && ()) {
            return true;
        }
    }
    return false;
}

fn getImplicitScaleFactor(VT: MVT) -> u32 {
    match VT.SimpleTy {
        _ => {
            return 0;
        },
        i1 => {
            i8;
        },
        i16 => {
            return 2;
        },
        i32 => {
            f32;
        },
        i64 => {
            f64;
        },
    }
}

fn AArch64FastISel::CCAssignFnForCall(self: *AArch64FastISel, CC: ID) -> *mut CCAssignFn {
    if CC == GHC {
        return CC_AArch64_GHC;
    }
    if CC == CFGuard_Check {
        return CC_AArch64_Win64_CFGuard_Check;
    }
    if self.Subtarget.isTargetDarwin() {
        return CC_AArch64_DarwinPCS;
    }
    if self.Subtarget.isTargetWindows() {
        return CC_AArch64_Win64PCS;
    }
    return CC_AArch64_AAPCS;
}

fn AArch64FastISel::fastMaterializeAlloca(self, AI: *AllocaInst) -> Register {
    let mut SI: auto = zeroed();
    if  {
        return Register { Reg: 0 };
    }
    if  {
        let mut ResultReg: Register = self.createResultReg;
        BuildMI(ResultReg)()(0)(0);
        return ResultReg;
    }
    return Register { Reg: 0 };
}

fn AArch64FastISel::materializeInt(self, CI: *ConstantInt, VT: MVT) -> Register {
    if VT > i64 {
        return Register { Reg: 0 };
    }
    if !CI.isZero() {
        return self.fastEmit_i;
    }
    let mut RC: *TargetRegisterClass = null;
    let mut ZeroReg: u32 = 0;
    let mut ResultReg: Register = self.createResultReg;
    BuildMI(ResultReg)(ZeroReg, getKillRegState(true));
    return ResultReg;
}

fn AArch64FastISel::materializeFP(self, CFP: *ConstantFP, VT: MVT) -> Register {
    if CFP.isNullValue() {
        return self.fastMaterializeFloatZero(CFP);
    }
    if VT != f32 && VT != f64 {
        return Register { Reg: 0 };
    }
    let mut Val: APFloat = CFP.getValueAPF();
    let mut Is64Bit: bool = (VT == f64);
    let mut Imm: i32 = if Is64Bit { getFP64Imm(Val) } else { getFP32Imm(Val) };
    if Imm != -1 {
        let mut Opc: u32 = 0;
        return self.fastEmitInst_i;
    }
    if  {
        let mut Opc1: u32 = 0;
        let mut RC: *TargetRegisterClass = null;
        let mut TmpReg: Register = self.createResultReg;
        BuildMI(TmpReg)(CFP.getValueAPF().bitcastToAPInt().getZExtValue());
        let mut ResultReg: Register = self.createResultReg;
        BuildMI(ResultReg)(TmpReg, getKillRegState(true));
        return ResultReg;
    }
    let mut Alignment: Align = zeroed();
    let mut CPI: u32 = 0;
    let mut ADRPReg: Register = self.createResultReg;
    BuildMI(ADRPReg)(CPI, 0, MO_PAGE);
    let mut Opc: u32 = 0;
    let mut ResultReg: Register = self.createResultReg;
    BuildMI(ResultReg)(ADRPReg)(CPI, 0, MO_PAGEOFF | MO_NC);
    return ResultReg;
}

fn AArch64FastISel::materializeGV(self, GV: *GlobalValue) -> Register {
    if GV.isThreadLocal() {
        return Register { Reg: 0 };
    }
    if !self.Subtarget.useSmallAddressing() && !self.Subtarget.isTargetMachO() {
        return Register { Reg: 0 };
    }
    if  {
        return Register { Reg: 0 };
    }
    let mut OpFlags: u32 = self.Subtarget.ClassifyGlobalReference;
    let mut DestEVT: EVT = zeroed();
    if !DestEVT.isSimple() {
        return Register { Reg: 0 };
    }
    let mut ADRPReg: Register = self.createResultReg;
    let mut ResultReg: Register = 0;
    if OpFlags & MO_GOT {
        BuildMI(ADRPReg)(GV, 0, MO_PAGE | OpFlags);
        let mut LdrOpc: u32 = 0;
        if self.Subtarget.isTargetILP32() {
            ResultReg = self.createResultReg;
        } else {
            ResultReg = self.createResultReg;
        }
        BuildMI(ResultReg)(ADRPReg)(GV, 0, MO_GOT | MO_PAGEOFF | MO_NC | OpFlags);
        if !self.Subtarget.isTargetILP32() {
            return ResultReg;
        }
        let mut Result64: Register = self.createResultReg;
        BuildMI()(Result64)(ResultReg, Kill);
        return Result64;
    } else {
        BuildMI(ADRPReg)(GV, 0, MO_PAGE | OpFlags);
        if OpFlags & MO_TAGGED {
            let mut DstReg: Register = self.createResultReg;
            BuildMI(DstReg)(ADRPReg)(GV, 4294967296, MO_PREL | MO_G3)(48);
            ADRPReg = DstReg;
        }
        ResultReg = self.createResultReg;
        BuildMI(ResultReg)(ADRPReg)(GV, 0, MO_PAGEOFF | MO_NC | OpFlags)(0);
    }
    return ResultReg;
}

fn AArch64FastISel::fastMaterializeConstant(self, C: *Constant) -> Register {
    let mut CEVT: EVT = zeroed();
    if !CEVT.isSimple() {
        return Register { Reg: 0 };
    }
    let mut VT: MVT = CEVT.getSimpleVT();
    if isa(C) {
        if C.getType().isVectorTy() {
            return Register { Reg: 0 };
        }
        assert!(VT == i64, "Expected 64-bit pointers");
        return self.materializeInt(get(getInt64Ty(*self.Context), 0, false, false), VT);
    }
    if  {
        return self.materializeInt(VT);
    } else if dyn_cast(C) {
        CFP;
    } else {
        return self.materializeFP(CFP, VT);
    }
    return Register { Reg: 0 };
}

fn AArch64FastISel::fastMaterializeFloatZero(self, CFP: *ConstantFP) -> Register {
    assert!(CFP.isNullValue(), "Floating-point constant is not a positive zero.");
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(CFP.getType(), VT) {
        return Register { Reg: 0 };
    }
    if VT != f32 && VT != f64 {
        return Register { Reg: 0 };
    }
    let mut Is64Bit: bool = (VT == f64);
    let mut ZReg: u32 = 0;
    let mut Opc: u32 = 0;
    return self.fastEmitInst_r;
}

