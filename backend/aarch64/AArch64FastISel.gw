    }
    let mut BW: u32 = VT.getSizeInBits();
    if BW > 64 {
        return false;
    }
    let mut TBB: *mut MachineBasicBlock = null;
    let mut FBB: *mut MachineBasicBlock = null;
    if  {
        swap(TBB, FBB);
        Predicate = getInversePredicate(Predicate);
    }
    let mut TestBit: i32 = -1;
    let mut IsCmpNE: bool = false;
    match Predicate {
        _ => {
            return false;
        },
        ICMP_EQ => {
            ICMP_NE;
        },
        ICMP_SLT => {
            ICMP_SGE;
        },
        ICMP_SGT => {
            ICMP_SLE;
        },
    }
