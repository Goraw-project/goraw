    let mut RC: *TargetRegisterClass = null;
    let mut ResultReg: Register = 0;
    if WantResult {
        ResultReg = self.createResultReg;
    } else {
        
    }
    let mut II: *MCInstrDesc = null;
    LHSReg = self.constrainOperandRegClass;
    RHSReg = self.constrainOperandRegClass;
    BuildMI(II, ResultReg)(LHSReg)(RHSReg)(getShifterImm(ShiftType, ShiftImm));
    return ResultReg;
}

fn AArch64FastISel::emitAddSub_rx(self, UseAdd: bool, RetVT: MVT, LHSReg: Register, RHSReg: Register, ExtType: ShiftExtendType, ShiftImm: u64, SetFlags: bool, WantResult: bool) -> Register {
    assert!(LHSReg.operator unsigned int() && RHSReg.operator unsigned int(), "Invalid register number.");
    if RetVT != i32 && RetVT != i64 {
        return Register { Reg: 0 };
    }
    if ShiftImm >= 4 {
        return Register { Reg: 0 };
    }
    let mut OpcTable: [2]u32 = zeroed();
    let mut Is64Bit: bool = RetVT == i64;
    let mut Opc: u32 = OpcTable[SetFlags][UseAdd][Is64Bit];
    let mut RC: *TargetRegisterClass = null;
    let mut ResultReg: Register = 0;
    if WantResult {
        ResultReg = self.createResultReg;
    } else {
        
    }
    let mut II: *MCInstrDesc = null;
    LHSReg = self.constrainOperandRegClass;
    RHSReg = self.constrainOperandRegClass;
    BuildMI(II, ResultReg)(LHSReg)(RHSReg)(getArithExtendImm(ExtType, ShiftImm));
    return ResultReg;
}

fn AArch64FastISel::emitCmp(self, LHS: *Value, RHS: *Value, IsZExt: bool) -> bool {
    let mut Ty: *mut Type = LHS.getType();
    let mut EVT: EVT = zeroed();
    if !EVT.isSimple() {
        return false;
    }
    let mut VT: MVT = EVT.getSimpleVT();
    match VT.SimpleTy {
        _ => {
            return false;
        },
        i1 => {
            i8;
        },
        f32 => {
            f64;
        },
    }
}

fn AArch64FastISel::emitICmp(self, RetVT: MVT, LHS: *Value, RHS: *Value, IsZExt: bool) -> bool {
    return self.emitSub(RetVT, LHS, RHS, true, false, IsZExt).isValid();
}

fn AArch64FastISel::emitICmp_ri(self, RetVT: MVT, LHSReg: Register, Imm: u64) -> bool {
    return self.emitAddSub_ri(false, RetVT, LHSReg, Imm, true, false).isValid();
}

fn AArch64FastISel::emitFCmp(self, RetVT: MVT, LHS: *Value, RHS: *Value) -> bool {
    if RetVT != f32 && RetVT != f64 {
        return false;
    }
    let mut UseImm: bool = false;
    if  {
        if CFP()() && operator!() {
            UseImm = true;
        }
    }
    let mut LHSReg: Register = self.getRegForValue;
    if !LHSReg.operator unsigned int() {
        return false;
    }
    if UseImm {
        let mut Opc: u32 = 0;
        BuildMI()(LHSReg);
        return true;
    }
    let mut RHSReg: Register = self.getRegForValue;
    if !RHSReg.operator unsigned int() {
        return false;
    }
    let mut Opc: u32 = 0;
    BuildMI()(LHSReg)(RHSReg);
    return true;
}

fn AArch64FastISel::emitAdd(self, RetVT: MVT, LHS: *Value, RHS: *Value, SetFlags: bool, WantResult: bool, IsZExt: bool) -> Register {
    return self.emitAddSub(true, RetVT, LHS, RHS, SetFlags, WantResult, IsZExt);
}

fn AArch64FastISel::emitAdd_ri_(self, VT: MVT, Op0: Register, Imm: i64) -> Register {
    let mut ResultReg: Register = 0;
    if Imm < 0 {
        ResultReg = self.emitAddSub_ri(false, VT, Op0, -Imm, false, true);
    } else {
        ResultReg = self.emitAddSub_ri(true, VT, Op0, Imm, false, true);
    }
    if ResultReg.operator unsigned int() {
        return ResultReg;
    }
    let mut CReg: Register = self.fastEmit_i;
    if !CReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    ResultReg = self.emitAddSub_rr(true, VT, Op0, CReg, false, true);
    return ResultReg;
}

fn AArch64FastISel::emitSub(self, RetVT: MVT, LHS: *Value, RHS: *Value, SetFlags: bool, WantResult: bool, IsZExt: bool) -> Register {
    return self.emitAddSub(false, RetVT, LHS, RHS, SetFlags, WantResult, IsZExt);
}

fn AArch64FastISel::emitSubs_rr(self, RetVT: MVT, LHSReg: Register, RHSReg: Register, WantResult: bool) -> Register {
    return self.emitAddSub_rr(false, RetVT, LHSReg, RHSReg, true, WantResult);
}

fn AArch64FastISel::emitSubs_rs(self, RetVT: MVT, LHSReg: Register, RHSReg: Register, ShiftType: ShiftExtendType, ShiftImm: u64, WantResult: bool) -> Register {
    return self.emitAddSub_rs(false, RetVT, LHSReg, RHSReg, ShiftType, ShiftImm, true, WantResult);
}

fn AArch64FastISel::emitLogicalOp(self, ISDOpc: u32, RetVT: MVT, LHS: *Value, RHS: *Value) -> Register {
    if isa(LHS) && !isa(RHS) {
        swap(LHS, RHS);
    }
    if LHS.hasOneUse() && self.isValueAvailable(LHS) {
        if isMulPowOf2(LHS) {
            swap(LHS, RHS);
        }
    }
    if LHS.hasOneUse() && self.isValueAvailable(LHS) {
        if  {
            if isa((1)) {
                swap(LHS, RHS);
            }
        }
    }
    let mut LHSReg: Register = self.getRegForValue;
    if !LHSReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    let mut ResultReg: Register = 0;
    if  {
        let mut Imm: u64 = ();
        ResultReg = self.emitLogicalOp_ri(ISDOpc, RetVT, LHSReg, Imm);
    }
    if ResultReg.operator unsigned int() {
        return ResultReg;
    }
    if RHS.hasOneUse() && self.isValueAvailable(RHS) {
        if isMulPowOf2(RHS) {
            let mut MulLHS: *Value = cast(RHS)(0);
            let mut MulRHS: *Value = cast(RHS)(1);
            if  {
                if C()()() {
                    swap(MulLHS, MulRHS);
                }
            }
            assert!(isa(MulRHS), "Expected a ConstantInt.");
            let mut ShiftVal: u64 = cast(MulRHS)()();
            let mut RHSReg: Register = self.getRegForValue;
            if !RHSReg.operator unsigned int() {
                return Register { Reg: 0 };
            }
            ResultReg = self.emitLogicalOp_rs(ISDOpc, RetVT, LHSReg, RHSReg, ShiftVal);
            if ResultReg.operator unsigned int() {
                return ResultReg;
            }
        }
    }
    if RHS.hasOneUse() && self.isValueAvailable(RHS) {
        if  {
            if  {
                let mut ShiftVal: u64 = ();
                let mut RHSReg: Register = self.getRegForValue((0));
                if !RHSReg.operator unsigned int() {
                    return Register { Reg: 0 };
                }
                ResultReg = self.emitLogicalOp_rs(ISDOpc, RetVT, LHSReg, RHSReg, ShiftVal);
                if ResultReg.operator unsigned int() {
                    return ResultReg;
                }
            }
        }
    }
    let mut RHSReg: Register = self.getRegForValue;
    if !RHSReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    let mut VT: MVT = max(i32, RetVT.SimpleTy);
    ResultReg = self.fastEmit_rr;
    if RetVT >= i8 && RetVT <= i16 {
        let mut Mask: u64 = if (RetVT == i8) { 255 } else { 65535 };
        ResultReg = self.emitAnd_ri(i32, ResultReg, Mask);
    }
    return ResultReg;
}

fn AArch64FastISel::emitLogicalOp_ri(self, ISDOpc: u32, RetVT: MVT, LHSReg: Register, Imm: u64) -> Register {
    let mut OpcTable: [3]u32 = zeroed();
    let mut RC: *TargetRegisterClass = null;
    let mut Opc: u32 = 0;
    let mut RegSize: u32 = 0;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i1 => {
            i8;
        },
        i64 => {
            Opc = OpcTable[ISDOpc - AND][1];
        },
    }
    if !isLogicalImmediate(Imm, RegSize) {
        return Register { Reg: 0 };
    }
    let mut ResultReg: Register = self.fastEmitInst_ri;
    if RetVT >= i8 && RetVT <= i16 && ISDOpc != AND {
        let mut Mask: u64 = if (RetVT == i8) { 255 } else { 65535 };
        ResultReg = self.emitAnd_ri(i32, ResultReg, Mask);
    }
    return ResultReg;
}

fn AArch64FastISel::emitLogicalOp_rs(self, ISDOpc: u32, RetVT: MVT, LHSReg: Register, RHSReg: Register, ShiftImm: u64) -> Register {
    let mut OpcTable: [3]u32 = zeroed();
    if ShiftImm(RetVT.getSizeInBits()) {
        return Register { Reg: 0 };
    }
    let mut RC: *TargetRegisterClass = null;
    let mut Opc: u32 = 0;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i1 => {
            i8;
        },
        i64 => {
            Opc = OpcTable[ISDOpc - AND][1];
        },
    }
    let mut ResultReg: Register = self.fastEmitInst_rri;
    if RetVT >= i8 && RetVT <= i16 {
        let mut Mask: u64 = if (RetVT == i8) { 255 } else { 65535 };
        ResultReg = self.emitAnd_ri(i32, ResultReg, Mask);
    }
    return ResultReg;
}

fn AArch64FastISel::emitAnd_ri(self, RetVT: MVT, LHSReg: Register, Imm: u64) -> Register {
    return self.emitLogicalOp_ri(AND, RetVT, LHSReg, Imm);
}

fn AArch64FastISel::emitLoad(self, VT: MVT, RetVT: MVT, Addr: Address, WantZExt: bool, MMO: *mut MachineMemOperand) -> Register {
    if  {
        return Register { Reg: 0 };
    }
    if !self.simplifyAddress(Addr, VT) {
        return Register { Reg: 0 };
    }
    let mut ScaleFactor: u32 = getImplicitScaleFactor(VT);
    if !ScaleFactor {
        llvm_unreachable_internal("Unexpected value type.", "llvm\\lib\\Target\\AArch64\\AArch64FastISel.cpp", 1758);
    }
    let mut UseScaled: bool = true;
    if (Addr.getOffset() < 0) || (Addr.getOffset() & (ScaleFactor - 1)) {
        UseScaled = false;
        ScaleFactor = 1;
    }
    let mut GPOpcTable: [2]u32 = zeroed();
    let mut FPOpcTable: [4]u32 = zeroed();
    let mut Opc: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    let mut UseRegOffset: bool = Addr.isRegBase() && !Addr.getOffset() && Addr.getReg().operator unsigned int() && Addr.getOffsetReg().operator unsigned int();
    let mut Idx: u32 = if UseRegOffset { 2 } else { if UseScaled { 1 } else { 0 } };
    if Addr.getExtendType() == UXTW || Addr.getExtendType() == SXTW {
        Idx += 1;
    }
    let mut IsRet64Bit: bool = RetVT == i64;
    match VT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected value type.", "llvm\\lib\\Target\\AArch64\\AArch64FastISel.cpp", 1826);
        },
        i1 => {
            i8;
        },
        i16 => {
            Opc = GPOpcTable[WantZExt][2 * Idx + IsRet64Bit][1];
        },
        i32 => {
            Opc = GPOpcTable[WantZExt][2 * Idx + IsRet64Bit][2];
        },
        i64 => {
            Opc = GPOpcTable[WantZExt][2 * Idx + IsRet64Bit][3];
        },
        f32 => {
            Opc = FPOpcTable[Idx][0];
        },
        f64 => {
            Opc = FPOpcTable[Idx][1];
        },
    }
    let mut ResultReg: Register = self.createResultReg;
    let mut MIB: MachineInstrBuilder = BuildMI(ResultReg);
    self.addLoadStoreOperands(Addr, MIB, MOLoad, ScaleFactor, MMO);
    if VT == i1 {
        let mut ANDReg: Register = self.emitAnd_ri(i32, ResultReg, 1);
        assert!(ANDReg.operator unsigned int(), "Unexpected AND instruction emission failure.");
        ResultReg = ANDReg;
    }
    if WantZExt && RetVT == i64 && VT <= i32 {
        let mut Reg64: Register = self.createResultReg;
        BuildMI(Reg64)(ResultReg, getKillRegState(true));
        ResultReg = Reg64;
    }
    return ResultReg;
}

fn AArch64FastISel::selectAddSub(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if operator!(self.isTypeSupported(I.getType, VT, true)) {
        return false;
    }
    if VT.isVector() {
        return self.selectOperator;
    }
    let mut ResultReg: Register = 0;
    match I.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected instruction.", "llvm\\lib\\Target\\AArch64\\AArch64FastISel.cpp", 1894);
        },
        Add => {
            ResultReg = self.emitAdd(VT, I.getOperand, I.getOperand);
        },
        Sub => {
            ResultReg = self.emitSub(VT, I.getOperand, I.getOperand);
        },
    }
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap;
    return true;
}

fn AArch64FastISel::selectLogicalOp(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if operator!(self.isTypeSupported(I.getType, VT, true)) {
        return false;
    }
    if VT.isVector() {
        return self.selectOperator;
    }
    let mut ResultReg: Register = 0;
    match I.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected instruction.", "llvm\\lib\\Target\\AArch64\\AArch64FastISel.cpp", 1920);
        },
        And => {
            ResultReg = self.emitLogicalOp(AND, VT, I.getOperand, I.getOperand);
        },
        Or => {
            ResultReg = self.emitLogicalOp(OR, VT, I.getOperand, I.getOperand);
        },
        Xor => {
            ResultReg = self.emitLogicalOp(XOR, VT, I.getOperand, I.getOperand);
        },
    }
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap;
    return true;
}

fn AArch64FastISel::selectLoad(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if operator!(self.isTypeSupported(I.getType, VT, true)) || cast(I)() {
        return false;
    }
    let mut SV: *Value = I.getOperand;
    if  {
        if dyn_cast(SV) {
            Arg;
        } else {
            if Arg.hasSwiftErrorAttr() {
                return false;
            }
        }
        if dyn_cast(SV) {
            Alloca;
        } else {
            if Alloca.isSwiftError() {
                return false;
            }
        }
    }
    let mut Addr: Address = Address {};
    if operator!(self.computeAddress(I.getOperand, Addr, I.getType)) {
        return false;
    }
    let mut WantZExt: bool = true;
    let mut RetVT: MVT = VT;
    let mut IntExtVal: *Value = null;
    if I.hasOneUse {
        if  {
            if self.isTypeSupported(RetVT) {
                IntExtVal = ;
            } else {
                RetVT = VT;
            }
        } else if  {
            if self.isTypeSupported(RetVT) {
                IntExtVal = ;
            } else {
                RetVT = VT;
            }
            WantZExt = false;
        }
    }
    let mut ResultReg: Register = self.emitLoad(VT, RetVT, Addr, WantZExt, self.createMachineMemOperandFor);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    if IntExtVal {
        let mut Reg: Register = self.lookUpRegForValue;
        let mut MI: *mut auto = null;
        if operator!() {
            if RetVT == i64 && VT <= i32 {
                if WantZExt {
                    ResultReg = prev(I)(0)();
                } else {
                    ResultReg = self.fastEmitInst_extractsubreg;
                }
            }
            self.updateValueMap;
            return true;
        }
        while MI() {
            Reg = 0;
            MI() = null;
        }
        self.updateValueMap;
        return true;
    }
    self.updateValueMap;
    return true;
}

fn AArch64FastISel::emitStoreRelease(self, VT: MVT, SrcReg: Register, AddrReg: Register, MMO: *mut MachineMemOperand) -> bool {
    let mut Opc: u32 = 0;
    match VT.SimpleTy {
        _ => {
