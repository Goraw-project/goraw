        return false;
    }
    if CLI.CB && CLI.CB.isIndirectCall() && CLI.CB(OB_kcfi) {
        return false;
    }
    if IsTailCall {
        return false;
    }
    if self.Subtarget.isTargetILP32() {
        return false;
    }
    let mut CM: Model = zeroed();
    if CM != Large && !self.Subtarget.useSmallAddressing() {
        return false;
    }
    if CM == Large && !self.Subtarget.isTargetMachO() {
        return false;
    }
    if  {
        return false;
    }
    if IsVarArg {
        return false;
    }
    if self.Subtarget.isWindowsArm64EC() {
        return false;
    }
    let mut OutVTs: SmallVector<MVT, 16> = zeroed();
    let mut OrigTys: SmallVector<Type *, 16> = zeroed();
