    match IID {
        _ => {
            return false;
        },
        sadd_with_overflow => {
            ssub_with_overflow;
        },
        uadd_with_overflow => {
            TmpCC = HS;
        },
        usub_with_overflow => {
            TmpCC = LO;
        },
        smul_with_overflow => {
            umul_with_overflow;
        },
    }
    if operator!(self.isValueAvailable()) {
        return false;
    }
    for let mut Itr: auto = prev(); ;  -= 1 {
        if operator!(isa()) {
            return false;
        }
        let mut EVI: *auto = cast();
        if EVI()() !=  {
            return false;
        }
    }
    CC = TmpCC;
    return true;
}

fn AArch64FastISel::fastLowerIntrinsicCall(self, II: *IntrinsicInst) -> bool {
    match II.getIntrinsicID() {
        _ => {
            return false;
        },
        frameaddress => {
            let mut MFI: *mut MachineFrameInfo = null;
            MFI.setFrameAddressIsTaken(true);
            let mut RegInfo: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
            let mut FramePtr: Register = RegInfo.getFrameRegister;
            let mut SrcReg: Register = zeroed();
            BuildMI(SrcReg)(FramePtr);
            let mut DestReg: Register = 0;
            let mut Depth: u32 = cast(II.getOperand)();
            while Depth -= 1 {
                DestReg = self.fastEmitInst_ri;
                assert!(DestReg.operator unsigned int(), "Unexpected LDR instruction emission failure.");
                SrcReg = DestReg;
            }
            self.updateValueMap;
            return true;
        },
        sponentry => {
            let mut MFI: *mut MachineFrameInfo = null;
            let mut FI: i32 = MFI.CreateFixedObject(4, 0, false, false);
            let mut ResultReg: Register = self.createResultReg;
            BuildMI(ResultReg)(FI)(0)(0);
            self.updateValueMap;
            return true;
        },
        memcpy => {
            memmove;
        },
        memset => {
            let mut MSI: *MemSetInst = cast(II);
            if MSI()() {
                return false;
            }
            if operator!(MSI()()()(64)) {
                return false;
            }
            if MSI()() > 255 {
                return false;
            }
            return (II, "memset", II.arg_size - 1);
        },
        sin => {
            cos;
        },
        fabs => {
            let mut VT: MVT = MVT {};
            if operator!(self.isTypeLegal(II.getType, VT)) {
                return false;
            }
            let mut Opc: u32 = 0;
            match VT.SimpleTy {
                _ => {
                    return false;
                },
                f32 => {
                    
                },
                f64 => {
                    
                },
            }
            let mut SrcReg: Register = self.getRegForValue(II.getOperand);
            if !SrcReg.operator unsigned int() {
                return false;
            }
            let mut ResultReg: Register = self.createResultReg;
            BuildMI(ResultReg)(SrcReg);
            self.updateValueMap;
            return true;
        },
        trap => {
            BuildMI()(1);
        },
        debugtrap => {
            BuildMI()(61440);
        },
        sqrt => {
            let mut RetTy: *mut Type = II.getCalledFunction();
            let mut VT: MVT = MVT {};
            if !self.isTypeLegal(RetTy, VT) {
                return false;
            }
            let mut Op0Reg: Register = self.getRegForValue(II.getOperand);
            if !Op0Reg.operator unsigned int() {
                return false;
            }
            let mut ResultReg: Register = self.fastEmit_r;
            if !ResultReg.operator unsigned int() {
                return false;
            }
            self.updateValueMap;
            return true;
        },
        sadd_with_overflow => {
            uadd_with_overflow;
        },
    }
    return false;
}

fn AArch64FastISel::selectRet(self, I: *Instruction) -> bool {
    let mut Ret: *ReturnInst = cast(I);
