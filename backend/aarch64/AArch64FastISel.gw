fn AArch64FastISel::getLastLocalValue(self) -> *mut MachineInstr {
    return self.LastLocalValue;
}

fn AArch64FastISel::setLastLocalValue(self, I: *mut MachineInstr) {
    self.EmitStartPt = I;
    self.LastLocalValue = I;
}

fn AArch64FastISel::getCurDebugLoc(self: *AArch64FastISel) -> DebugLoc {
    return self.MIMD.getDL();
}

fn AArch64FastISel::tryToFoldLoadIntoMI(self, arg: *mut MachineInstr, arg: u32, arg: *LoadInst) -> bool {
    return false;
}

fn AArch64FastISel::shouldOptForSize(self: *AArch64FastISel, MF: *MachineFunction) -> bool {
    return MF.getFunction().hasOptSize();
}

fn isIntExtFree(I: *Instruction) -> bool {
    assert!((isa(I) || isa(I)), "Unexpected integer extend instruction.");
    assert!(!I.getType().isVectorTy() && I.getType().isIntegerTy(), "Unexpected value type.");
    let mut IsZExt: bool = isa(I);
    if dyn_cast(I.getOperand(0)) {
        LI;
    } else if LI.hasOneUse() {
        return true;
    }
    if dyn_cast(I.getOperand(0)) {
        Arg;
    } else if (IsZExt && Arg.hasZExtAttr()) || (!IsZExt && Arg.hasSExtAttr()) {
        return true;
    }
    return false;
}

fn getImplicitScaleFactor(VT: MVT) -> u32 {
    match VT.SimpleTy {
        _ => {
            return 0;
        },
        i1 => {
            i8;
        },
        i16 => {
            return 2;
        },
        i32 => {
            f32;
        },
        i64 => {
            f64;
        },
    }
}

fn AArch64FastISel::CCAssignFnForCall(self: *AArch64FastISel, CC: ID) -> *mut CCAssignFn {
    if CC == GHC {
        return CC_AArch64_GHC;
    }
    if CC == CFGuard_Check {
        return CC_AArch64_Win64_CFGuard_Check;
    }
    if self.Subtarget.isTargetDarwin() {
        return CC_AArch64_DarwinPCS;
    }
    if self.Subtarget.isTargetWindows() {
        return CC_AArch64_Win64PCS;
    }
    return CC_AArch64_AAPCS;
}

fn AArch64FastISel::fastMaterializeAlloca(self, AI: *AllocaInst) -> Register {
    assert!(self.TLI.getValueType(self.DL, AI.getType(), true) == i64, "Alloca should always return a pointer.");
    let mut SI: iterator = self.FuncInfo.StaticAllocaMap.find(AI);
    if SI == self.FuncInfo.StaticAllocaMap.end() {
        return Register { Reg: 0 };
    }
    if SI != self.FuncInfo.StaticAllocaMap.end() {
        let mut ResultReg: Register = self.createResultReg(&mut GPR64spRegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(ADDXri), ResultReg).addFrameIndex(operator(SI).second).addImm(0).addImm(0);
        return ResultReg;
    }
    return Register { Reg: 0 };
}

fn AArch64FastISel::materializeInt(self, CI: *ConstantInt, VT: MVT) -> Register {
    if VT > i64 {
        return Register { Reg: 0 };
    }
    if !CI.isZero() {
        return self.fastEmit_i(VT, VT, Constant, CI.getZExtValue());
    }
    let mut RC: *TargetRegisterClass = if (VT == i64) { &mut GPR64RegClass } else { &mut GPR32RegClass };
    let mut ZeroReg: u32 = if (VT == i64) { XZR } else { WZR };
    let mut ResultReg: Register = self.createResultReg(RC);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(ZeroReg, getKillRegState(true), 0);
    return ResultReg;
}

fn AArch64FastISel::materializeFP(self, CFP: *ConstantFP, VT: MVT) -> Register {
    if CFP.isNullValue() {
        return self.fastMaterializeFloatZero(CFP);
    }
    if VT != f32 && VT != f64 {
        return Register { Reg: 0 };
    }
    let mut Val: APFloat = CFP.getValueAPF();
    let mut Is64Bit: bool = (VT == f64);
    let mut Imm: i32 = if Is64Bit { getFP64Imm(Val) } else { getFP32Imm(Val) };
    if Imm != -1 {
        let mut Opc: u32 = if Is64Bit { FMOVDi } else { FMOVSi };
        return self.fastEmitInst_i(Opc, self.TLI.getRegClassFor(VT, false), Imm);
    }
    if self.TM.getCodeModel() == Large {
        let mut Opc1: u32 = if Is64Bit { MOVi64imm } else { MOVi32imm };
        let mut RC: *TargetRegisterClass = if Is64Bit { &mut GPR64RegClass } else { &mut GPR32RegClass };
        let mut TmpReg: Register = self.createResultReg(RC);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc1), TmpReg).addImm(CFP.getValueAPF().bitcastToAPInt().getZExtValue());
        let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(VT, false));
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(TmpReg, getKillRegState(true), 0);
        return ResultReg;
    }
    let mut Alignment: Align = self.DL.getPrefTypeAlign(CFP.getType());
    let mut CPI: u32 = self.MCP.getConstantPoolIndex(cast(CFP), Alignment);
    let mut ADRPReg: Register = self.createResultReg(&mut GPR64commonRegClass);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(ADRP), ADRPReg).addConstantPoolIndex(CPI, 0, MO_PAGE);
    let mut Opc: u32 = if Is64Bit { LDRDui } else { LDRSui };
    let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(VT, false));
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg).addReg(ADRPReg, RegState {}, 0).addConstantPoolIndex(CPI, 0, MO_PAGEOFF | MO_NC);
    return ResultReg;
}

fn AArch64FastISel::materializeGV(self, GV: *GlobalValue) -> Register {
    if GV.isThreadLocal() {
        return Register { Reg: 0 };
    }
    if !self.Subtarget.useSmallAddressing() && !self.Subtarget.isTargetMachO() {
        return Register { Reg: 0 };
    }
    if self.FuncInfo.MF.getInfo().hasELFSignedGOT() {
        return Register { Reg: 0 };
    }
    let mut OpFlags: u32 = self.Subtarget.ClassifyGlobalReference(GV, self.TM);
    let mut DestEVT: EVT = self.TLI.getValueType(self.DL, GV.getType(), true);
    if !DestEVT.isSimple() {
        return Register { Reg: 0 };
    }
    let mut ADRPReg: Register = self.createResultReg(&mut GPR64commonRegClass);
    let mut ResultReg: Register = 0;
    if OpFlags & MO_GOT {
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(ADRP), ADRPReg).addGlobalAddress(GV, 0, MO_PAGE | OpFlags);
        let mut LdrOpc: u32 = 0;
        if self.Subtarget.isTargetILP32() {
            ResultReg = self.createResultReg(&mut GPR32RegClass);
            LdrOpc = LDRWui;
        } else {
            ResultReg = self.createResultReg(&mut GPR64RegClass);
            LdrOpc = LDRXui;
        }
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(LdrOpc), ResultReg).addReg(ADRPReg, RegState {}, 0).addGlobalAddress(GV, 0, MO_GOT | MO_PAGEOFF | MO_NC | OpFlags);
        if !self.Subtarget.isTargetILP32() {
            return ResultReg;
        }
        let mut Result64: Register = self.createResultReg(&mut GPR64RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG)).addDef(Result64, RegState {}, 0).addReg(ResultReg, Kill, 0).addImm(sub_32);
        return Result64;
    } else {
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(ADRP), ADRPReg).addGlobalAddress(GV, 0, MO_PAGE | OpFlags);
        if OpFlags & MO_TAGGED {
            let mut DstReg: Register = self.createResultReg(&mut GPR64commonRegClass);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(MOVKXi), DstReg).addReg(ADRPReg, RegState {}, 0).addGlobalAddress(GV, 4294967296, MO_PREL | MO_G3).addImm(48);
            ADRPReg = DstReg;
        }
        ResultReg = self.createResultReg(&mut GPR64spRegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(ADDXri), ResultReg).addReg(ADRPReg, RegState {}, 0).addGlobalAddress(GV, 0, MO_PAGEOFF | MO_NC | OpFlags).addImm(0);
    }
    return ResultReg;
}

fn AArch64FastISel::fastMaterializeConstant(self, C: *Constant) -> Register {
    let mut CEVT: EVT = self.TLI.getValueType(self.DL, C.getType(), true);
    if !CEVT.isSimple() {
        return Register { Reg: 0 };
    }
    let mut VT: MVT = CEVT.getSimpleVT();
    if isa(C) {
        if C.getType().isVectorTy() {
            return Register { Reg: 0 };
        }
        assert!(VT == i64, "Expected 64-bit pointers");
        return self.materializeInt(get(getInt64Ty(*self.Context), 0, false, false), VT);
    }
    if dyn_cast(C) {
        CI;
    } else {
        return self.materializeInt(CI, VT);
    }
    return Register { Reg: 0 };
}

fn AArch64FastISel::fastMaterializeFloatZero(self, CFP: *ConstantFP) -> Register {
    assert!(CFP.isNullValue(), "Floating-point constant is not a positive zero.");
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(CFP.getType(), VT) {
        return Register { Reg: 0 };
    }
    if VT != f32 && VT != f64 {
        return Register { Reg: 0 };
    }
    let mut Is64Bit: bool = (VT == f64);
    let mut ZReg: u32 = if Is64Bit { XZR } else { WZR };
    let mut Opc: u32 = if Is64Bit { FMOVXDr } else { FMOVWSr };
    return self.fastEmitInst_r(Opc, self.TLI.getRegClassFor(VT, false), ZReg);
}

fn isMulPowOf2(I: *Value) -> bool {
    if dyn_cast(I) {
        MI;
    } else {
        if dyn_cast(MI.getOperand(0)) {
            C;
        } else if C.getValue().isPowerOf2() {
            return true;
        }
        if dyn_cast(MI.getOperand(1)) {
            C;
        } else if C.getValue().isPowerOf2() {
            return true;
        }
    }
    return false;
}

fn AArch64FastISel::computeAddress(self, Obj: *Value, Addr: *mut Address, Ty: *mut Type) -> bool {
    let mut U: *User = null;
    let mut Opcode: u32 = UserOp1;
    if dyn_cast(Obj) {
        I;
    } else {
        if self.FuncInfo.StaticAllocaMap.count(Obj as *AllocaInst) || self.FuncInfo.getMBB(I.getParent()) == self.FuncInfo.MBB {
            Opcode = I.getOpcode();
            U = I;
        }
    }
    if dyn_cast(Obj.getType()) {
        Ty;
    } else if Ty.getAddressSpace() > 255 {
        return false;
    }
    match Opcode {
        _ => {
            break;
        },
        BitCast => {
            return self.computeAddress(U.getOperand(0), Addr, Ty);
        },
        IntToPtr => {
            if self.TLI.getValueType(self.DL, U.getOperand(0).getType(), false) == self.TLI.getPointerTy(self.DL, 0) {
                return self.computeAddress(U.getOperand(0), Addr, Ty);
            }
        },
        PtrToInt => {
            if self.TLI.getValueType(self.DL, U.getType(), false) == self.TLI.getPointerTy(self.DL, 0) {
                return self.computeAddress(U.getOperand(0), Addr, Ty);
            }
        },
        GetElementPtr => {
            let mut SavedAddr: Address = Addr;
            let mut TmpOffset: u64 = Addr.getOffset();
            for let mut GTI: gep_type_iterator = gep_type_begin(U);
let mut E: gep_type_iterator = gep_type_end(U); GTI != E; operator(GTI) {
                let mut Op: *Value = GTI.getOperand();
                if GTI.getStructTypeOrNull() {
                    STy;
                } else {
                    let mut SL: *StructLayout = self.DL.getStructLayout(STy);
                    let mut Idx: u32 = cast(Op).getZExtValue();
                    TmpOffset += SL.getElementOffset(Idx).operator unsigned long long();
                }
            }
            Addr.setOffset(TmpOffset);
            if self.computeAddress(U.getOperand(0), Addr, Ty) {
                return true;
            }
            Addr = SavedAddr;
        },
        Alloca => {
            let mut AI: *AllocaInst = cast(Obj);
            let mut SI: iterator = self.FuncInfo.StaticAllocaMap.find(AI);
            if SI != self.FuncInfo.StaticAllocaMap.end() {
                Addr.setKind(FrameIndexBase);
                Addr.setFI(operator(SI).second);
                return true;
            }
            break;
        },
        Add => {
            let mut LHS: *Value = U.getOperand(0);
            let mut RHS: *Value = U.getOperand(1);
            if isa(LHS) {
                swap(LHS, RHS);
            }
            if dyn_cast(RHS) {
                CI;
            } else {
                Addr.setOffset(Addr.getOffset() + CI.getSExtValue());
                return self.computeAddress(LHS, Addr, Ty);
            }
            let mut Backup: Address = Addr;
            if self.computeAddress(LHS, Addr, Ty) && self.computeAddress(RHS, Addr, Ty) {
                return true;
            }
            Addr = Backup;
            break;
        },
        Sub => {
            let mut LHS: *Value = U.getOperand(0);
            let mut RHS: *Value = U.getOperand(1);
            if dyn_cast(RHS) {
                CI;
            } else {
                Addr.setOffset(Addr.getOffset() - CI.getSExtValue());
                return self.computeAddress(LHS, Addr, Ty);
            }
            break;
        },
        Shl => {
            if Addr.getOffsetReg().operator unsigned int() {
                break;
            }
            let mut CI: *ConstantInt const = dyn_cast(U.getOperand(1));
            if !CI {
                break;
            }
            let mut Val: u32 = CI.getZExtValue();
            if Val < 1 || Val > 3 {
                break;
            }
            let mut NumBytes: u64 = 0;
            if Ty && Ty.isSized() {
                let mut NumBits: u64 = self.DL.getTypeSizeInBits(Ty).operator unsigned long long();
                NumBytes = NumBits / 8;
                if !isPowerOf2_64(NumBits) {
                    NumBytes = 0;
                }
            }
            if NumBytes != (1 << Val) {
                break;
            }
            Addr.setShift(Val);
            Addr.setExtendType(LSL);
            let mut Src: *Value = U.getOperand(0);
            if dyn_cast(Src) {
                I;
            } else {
                if self.FuncInfo.getMBB(I.getParent()) == self.FuncInfo.MBB {
                    if dyn_cast(I) {
                        ZE;
                    } else {
                        if !isIntExtFree(ZE) && ZE.getOperand(0).getType().isIntegerTy(32) {
                            Addr.setExtendType(UXTW);
                            Src = ZE.getOperand(0);
                        }
                    }
                }
            }
            if dyn_cast(Src) {
                AI;
            } else if AI.getOpcode() == And {
                let mut LHS: *Value = AI.getOperand(0);
                let mut RHS: *Value = AI.getOperand(1);
                if dyn_cast(LHS) {
                    C;
                } else if C.getValue() == 4294967295 {
                    swap(LHS, RHS);
                }
                if dyn_cast(RHS) {
                    C;
                } else if C.getValue() == 4294967295 {
                    Addr.setExtendType(UXTW);
                    let mut Reg: Register = self.getRegForValue(LHS);
                    if !Reg.operator unsigned int() {
                        return false;
                    }
                    Reg = self.fastEmitInst_extractsubreg(i32, Reg, sub_32);
                    Addr.setOffsetReg(Reg);
                    return true;
                }
            }
            let mut Reg: Register = self.getRegForValue(Src);
            if !Reg.operator unsigned int() {
                return false;
            }
            Addr.setOffsetReg(Reg);
            return true;
        },
        Mul => {
            if Addr.getOffsetReg().operator unsigned int() {
                break;
            }
            if !isMulPowOf2(U) {
                break;
            }
            let mut LHS: *Value = U.getOperand(0);
            let mut RHS: *Value = U.getOperand(1);
            if dyn_cast(LHS) {
                C;
            } else if C.getValue().isPowerOf2() {
                swap(LHS, RHS);
            }
            assert!(isa(RHS), "Expected an ConstantInt.");
            let mut C: *ConstantInt const = cast(RHS);
            let mut Val: u32 = C.getValue().logBase2();
            if Val < 1 || Val > 3 {
                break;
            }
            let mut NumBytes: u64 = 0;
            if Ty && Ty.isSized() {
                let mut NumBits: u64 = self.DL.getTypeSizeInBits(Ty).operator unsigned long long();
                NumBytes = NumBits / 8;
                if !isPowerOf2_64(NumBits) {
                    NumBytes = 0;
                }
            }
            if NumBytes != (1 << Val) {
                break;
            }
            Addr.setShift(Val);
            Addr.setExtendType(LSL);
            let mut Src: *Value = LHS;
            if dyn_cast(Src) {
                I;
            } else {
                if self.FuncInfo.getMBB(I.getParent()) == self.FuncInfo.MBB {
                    if dyn_cast(I) {
                        ZE;
                    } else {
                        if !isIntExtFree(ZE) && ZE.getOperand(0).getType().isIntegerTy(32) {
                            Addr.setExtendType(UXTW);
                            Src = ZE.getOperand(0);
                        }
                    }
                }
            }
            let mut Reg: Register = self.getRegForValue(Src);
            if !Reg.operator unsigned int() {
                return false;
            }
            Addr.setOffsetReg(Reg);
            return true;
        },
        And => {
            if Addr.getOffsetReg().operator unsigned int() {
                break;
            }
            if !Ty || self.DL.getTypeSizeInBits(Ty).operator unsigned long long() != 8 {
                break;
            }
            let mut LHS: *Value = U.getOperand(0);
            let mut RHS: *Value = U.getOperand(1);
            if dyn_cast(LHS) {
                C;
            } else if C.getValue() == 4294967295 {
                swap(LHS, RHS);
            }
            if dyn_cast(RHS) {
                C;
            } else if C.getValue() == 4294967295 {
                Addr.setShift(0);
                Addr.setExtendType(LSL);
                Addr.setExtendType(UXTW);
                let mut Reg: Register = self.getRegForValue(LHS);
                if !Reg.operator unsigned int() {
                    return false;
                }
                Reg = self.fastEmitInst_extractsubreg(i32, Reg, sub_32);
                Addr.setOffsetReg(Reg);
                return true;
            }
            break;
        },
        SExt => {
            ZExt;
        },
    }
    if Addr.isRegBase() && !Addr.getReg().operator unsigned int() {
        let mut Reg: Register = self.getRegForValue(Obj);
        if !Reg.operator unsigned int() {
            return false;
        }
        Addr.setReg(Reg);
        return true;
    }
    if !Addr.getOffsetReg().operator unsigned int() {
        let mut Reg: Register = self.getRegForValue(Obj);
        if !Reg.operator unsigned int() {
            return false;
        }
        Addr.setOffsetReg(Reg);
        return true;
    }
    return false;
}

fn AArch64FastISel::computeCallAddress(self, V: *Value, Addr: *mut Address) -> bool {
    let mut U: *User = null;
    let mut Opcode: u32 = UserOp1;
    let mut InMBB: bool = true;
    if dyn_cast(V) {
        I;
    } else {
        Opcode = I.getOpcode();
        U = I;
        InMBB = I.getParent() == self.FuncInfo.MBB.getBasicBlock();
    }
    match Opcode {
        _ => {
            break;
        },
        BitCast => {
            if InMBB {
                return self.computeCallAddress(U.getOperand(0), Addr);
            }
        },
        IntToPtr => {
            if InMBB && self.TLI.getValueType(self.DL, U.getOperand(0).getType(), false) == self.TLI.getPointerTy(self.DL, 0) {
                return self.computeCallAddress(U.getOperand(0), Addr);
            }
        },
        PtrToInt => {
            if InMBB && self.TLI.getValueType(self.DL, U.getType(), false) == self.TLI.getPointerTy(self.DL, 0) {
                return self.computeCallAddress(U.getOperand(0), Addr);
            }
        },
    }
    if dyn_cast(V) {
        GV;
    } else {
        Addr.setGlobalValue(GV);
        return true;
    }
    if !Addr.getGlobalValue() {
        Addr.setReg(self.getRegForValue(V));
        return Addr.getReg().isValid();
    }
    return false;
}

fn AArch64FastISel::isTypeLegal(self, Ty: *mut Type, VT: *mut MVT) -> bool {
    let mut evt: EVT = self.TLI.getValueType(self.DL, Ty, true);
    if self.Subtarget.isTargetILP32() && Ty.isPointerTy() {
        return false;
    }
    if evt == Other || !evt.isSimple() {
        return false;
    }
    VT = evt.getSimpleVT();
    if VT == f128 {
        return false;
    }
    return self.TLI.isTypeLegal(VT);
}

fn AArch64FastISel::isTypeSupported(self, Ty: *mut Type, VT: *mut MVT, IsVectorAllowed: bool) -> bool {
    if Ty.isVectorTy() && !IsVectorAllowed {
        return false;
    }
    if self.isTypeLegal(Ty, VT) {
        return true;
    }
    if VT == i1 || VT == i8 || VT == i16 {
        return true;
    }
    return false;
}

fn AArch64FastISel::isValueAvailable(self: *AArch64FastISel, V: *Value) -> bool {
    if !isa(V) {
        return true;
    }
    let mut I: *Instruction const = cast(V);
    return self.FuncInfo.getMBB(I.getParent()) == self.FuncInfo.MBB;
}

fn AArch64FastISel::simplifyAddress(self, Addr: *mut Address, VT: MVT) -> bool {
    if self.Subtarget.isTargetILP32() {
        return false;
    }
    let mut ScaleFactor: u32 = getImplicitScaleFactor(VT);
    if !ScaleFactor {
        return false;
    }
    let mut ImmediateOffsetNeedsLowering: bool = false;
    let mut RegisterOffsetNeedsLowering: bool = false;
    let mut Offset: i64 = Addr.getOffset();
    if ((Offset < 0) || (Offset & (ScaleFactor - 1))) && !isInt(Offset) {
        ImmediateOffsetNeedsLowering = true;
    } else if Offset > 0 && !(Offset & (ScaleFactor - 1)) && !isUInt(Offset / ScaleFactor) {
        ImmediateOffsetNeedsLowering = true;
    }
    if !ImmediateOffsetNeedsLowering && Addr.getOffset() && Addr.getOffsetReg().operator unsigned int() {
        RegisterOffsetNeedsLowering = true;
    }
    if Addr.isRegBase() && Addr.getOffsetReg().operator unsigned int() && !Addr.getReg().operator unsigned int() {
        RegisterOffsetNeedsLowering = true;
    }
    if (ImmediateOffsetNeedsLowering || Addr.getOffsetReg().operator unsigned int()) && Addr.isFIBase() {
        let mut ResultReg: Register = self.createResultReg(&mut GPR64spRegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(ADDXri), ResultReg).addFrameIndex(Addr.getFI()).addImm(0).addImm(0);
        Addr.setKind(RegBase);
        Addr.setReg(ResultReg);
    }
    if RegisterOffsetNeedsLowering {
        let mut ResultReg: Register = 0;
        if Addr.getReg().operator unsigned int() {
            if Addr.getExtendType() == SXTW || Addr.getExtendType() == UXTW {
                ResultReg = self.emitAddSub_rx(true, i64, Addr.getReg(), Addr.getOffsetReg(), Addr.getExtendType(), Addr.getShift(), false, true);
            } else {
                ResultReg = self.emitAddSub_rs(true, i64, Addr.getReg(), Addr.getOffsetReg(), LSL, Addr.getShift(), false, true);
            }
        } else {
            if Addr.getExtendType() == UXTW {
                ResultReg = self.emitLSL_ri(i64, i32, Addr.getOffsetReg(), Addr.getShift(), true);
            } else if Addr.getExtendType() == SXTW {
                ResultReg = self.emitLSL_ri(i64, i32, Addr.getOffsetReg(), Addr.getShift(), false);
            } else {
                ResultReg = self.emitLSL_ri(i64, i64, Addr.getOffsetReg(), Addr.getShift(), true);
            }
        }
        if !ResultReg.operator unsigned int() {
            return false;
        }
        Addr.setReg(ResultReg);
        Addr.setOffsetReg(0);
        Addr.setShift(0);
        Addr.setExtendType(InvalidShiftExtend);
    }
    if ImmediateOffsetNeedsLowering {
        let mut ResultReg: Register = 0;
        if Addr.getReg().operator unsigned int() {
            ResultReg = self.emitAdd_ri_(i64, Addr.getReg(), Offset);
        } else {
            ResultReg = self.fastEmit_i(i64, i64, Constant, Offset);
        }
        if !ResultReg.operator unsigned int() {
            return false;
        }
        Addr.setReg(ResultReg);
        Addr.setOffset(0);
    }
    return true;
}

fn AArch64FastISel::addLoadStoreOperands(self, Addr: *mut Address, MIB: *MachineInstrBuilder, Flags: Flags, ScaleFactor: u32, MMO: *mut MachineMemOperand) {
    let mut Offset: i64 = Addr.getOffset() / ScaleFactor;
    if Addr.isFIBase() {
        let mut FI: i32 = Addr.getFI();
        MMO = self.FuncInfo.MF.getMachineMemOperand(getFixedStack(*self.FuncInfo.MF, FI, Offset), Flags, self.MFI.getObjectSize(FI), self.MFI.getObjectAlign(FI), MMOMetadata {}, System, NotAtomic, NotAtomic);
        MIB.addFrameIndex(FI).addImm(Offset);
    } else {
        assert!(Addr.isRegBase(), "Unexpected address kind.");
        let mut II: *MCInstrDesc = operator(MIB).getDesc();
        let mut Idx: u32 = if (Flags & MOStore) { 1 } else { 0 };
        Addr.setReg(self.constrainOperandRegClass(II, Addr.getReg(), II.getNumDefs() + Idx));
        Addr.setOffsetReg(self.constrainOperandRegClass(II, Addr.getOffsetReg(), II.getNumDefs() + Idx + 1));
        if Addr.getOffsetReg().operator unsigned int() {
            assert!(Addr.getOffset() == 0, "Unexpected offset");
            let mut IsSigned: bool = Addr.getExtendType() == SXTW || Addr.getExtendType() == SXTX;
            MIB.addReg(Addr.getReg(), RegState {}, 0);
            MIB.addReg(Addr.getOffsetReg(), RegState {}, 0);
            MIB.addImm(IsSigned);
            MIB.addImm(Addr.getShift() != 0);
        } else {
            MIB.addReg(Addr.getReg(), RegState {}, 0).addImm(Offset);
        }
    }
    if MMO {
        MIB.addMemOperand(MMO);
    }
}

fn AArch64FastISel::emitAddSub(self, UseAdd: bool, RetVT: MVT, LHS: *Value, RHS: *Value, SetFlags: bool, WantResult: bool, IsZExt: bool) -> Register {
    let mut ExtendType: ShiftExtendType = InvalidShiftExtend;
    let mut NeedExtend: bool = false;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i1 => {
            NeedExtend = true;
        },
        i8 => {
            NeedExtend = true;
        },
        i16 => {
            NeedExtend = true;
        },
        i32 => {
            i64;
        },
    }
    let mut SrcVT: MVT = RetVT;
    RetVT.SimpleTy = if RetVT.SimpleTy > i32 { RetVT.SimpleTy } else { i32 };
    if UseAdd && isa(LHS) && !isa(RHS) {
        swap(LHS, RHS);
    }
    if UseAdd && LHS.hasOneUse() && self.isValueAvailable(LHS) {
        if isMulPowOf2(LHS) {
            swap(LHS, RHS);
        }
    }
    if UseAdd && LHS.hasOneUse() && self.isValueAvailable(LHS) {
        if dyn_cast(LHS) {
            SI;
        } else if isa(SI.getOperand(1)) {
            if SI.getOpcode() == Shl || SI.getOpcode() == LShr || SI.getOpcode() == AShr {
                swap(LHS, RHS);
            }
        }
    }
    let mut LHSReg: Register = self.getRegForValue(LHS);
    if !LHSReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    if NeedExtend {
        LHSReg = self.emitIntExt(SrcVT, LHSReg, RetVT, IsZExt);
    }
    let mut ResultReg: Register = 0;
    if dyn_cast(RHS) {
        C;
    } else {
        let mut Imm: u64 = if IsZExt { C.getZExtValue() } else { C.getSExtValue() };
        if C.isNegative() {
            ResultReg = self.emitAddSub_ri(!UseAdd, RetVT, LHSReg, -Imm, SetFlags, WantResult);
        } else {
            ResultReg = self.emitAddSub_ri(UseAdd, RetVT, LHSReg, Imm, SetFlags, WantResult);
        }
    }
    if ResultReg.operator unsigned int() {
        return ResultReg;
    }
    if ExtendType != InvalidShiftExtend && RHS.hasOneUse() && self.isValueAvailable(RHS) {
        let mut RHSReg: Register = self.getRegForValue(RHS);
        if !RHSReg.operator unsigned int() {
            return Register { Reg: 0 };
        }
        return self.emitAddSub_rx(UseAdd, RetVT, LHSReg, RHSReg, ExtendType, 0, SetFlags, WantResult);
    }
    if RHS.hasOneUse() && self.isValueAvailable(RHS) {
        if isMulPowOf2(RHS) {
            let mut MulLHS: *Value = cast(RHS).getOperand(0);
            let mut MulRHS: *Value = cast(RHS).getOperand(1);
            if dyn_cast(MulLHS) {
                C;
            } else if C.getValue().isPowerOf2() {
                swap(MulLHS, MulRHS);
            }
            assert!(isa(MulRHS), "Expected a ConstantInt.");
            let mut ShiftVal: u64 = cast(MulRHS).getValue().logBase2();
            let mut RHSReg: Register = self.getRegForValue(MulLHS);
            if !RHSReg.operator unsigned int() {
                return Register { Reg: 0 };
            }
            ResultReg = self.emitAddSub_rs(UseAdd, RetVT, LHSReg, RHSReg, LSL, ShiftVal, SetFlags, WantResult);
            if ResultReg.operator unsigned int() {
                return ResultReg;
            }
        }
    }
    if RHS.hasOneUse() && self.isValueAvailable(RHS) {
        if dyn_cast(RHS) {
            SI;
        } else {
            if dyn_cast(SI.getOperand(1)) {
                C;
            } else {
                let mut ShiftType: ShiftExtendType = InvalidShiftExtend;
                match SI.getOpcode() {
                    _ => {
                        break;
                    },
                    Shl => {
                        ShiftType = LSL;
                    },
                    LShr => {
                        ShiftType = LSR;
                    },
                    AShr => {
                        ShiftType = ASR;
                    },
                }
                let mut ShiftVal: u64 = C.getZExtValue();
                if ShiftType != InvalidShiftExtend {
                    let mut RHSReg: Register = self.getRegForValue(SI.getOperand(0));
                    if !RHSReg.operator unsigned int() {
                        return Register { Reg: 0 };
                    }
                    ResultReg = self.emitAddSub_rs(UseAdd, RetVT, LHSReg, RHSReg, ShiftType, ShiftVal, SetFlags, WantResult);
                    if ResultReg.operator unsigned int() {
                        return ResultReg;
                    }
                }
            }
        }
    }
    let mut RHSReg: Register = self.getRegForValue(RHS);
    if !RHSReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    if NeedExtend {
        RHSReg = self.emitIntExt(SrcVT, RHSReg, RetVT, IsZExt);
    }
    return self.emitAddSub_rr(UseAdd, RetVT, LHSReg, RHSReg, SetFlags, WantResult);
}

fn AArch64FastISel::emitAddSub_rr(self, UseAdd: bool, RetVT: MVT, LHSReg: Register, RHSReg: Register, SetFlags: bool, WantResult: bool) -> Register {
    assert!(LHSReg.operator unsigned int() && RHSReg.operator unsigned int(), "Invalid register number.");
    if LHSReg == SP || LHSReg == WSP || RHSReg == SP || RHSReg == WSP {
        return Register { Reg: 0 };
    }
    if RetVT != i32 && RetVT != i64 {
        return Register { Reg: 0 };
    }
    let mut OpcTable: [2]u32 = [[[SUBWrr, SUBXrr], [ADDWrr, ADDXrr]], [[SUBSWrr, SUBSXrr], [ADDSWrr, ADDSXrr]]];
    let mut Is64Bit: bool = RetVT == i64;
    let mut Opc: u32 = OpcTable[SetFlags][UseAdd][Is64Bit];
    let mut RC: *TargetRegisterClass = if Is64Bit { &mut GPR64RegClass } else { &mut GPR32RegClass };
    let mut ResultReg: Register = 0;
    if WantResult {
        ResultReg = self.createResultReg(RC);
    } else {
        ResultReg = if Is64Bit { XZR } else { WZR };
    }
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    LHSReg = self.constrainOperandRegClass(II, LHSReg, II.getNumDefs());
    RHSReg = self.constrainOperandRegClass(II, RHSReg, II.getNumDefs() + 1);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II, ResultReg).addReg(LHSReg, RegState {}, 0).addReg(RHSReg, RegState {}, 0);
    return ResultReg;
}

fn AArch64FastISel::emitAddSub_ri(self, UseAdd: bool, RetVT: MVT, LHSReg: Register, Imm: u64, SetFlags: bool, WantResult: bool) -> Register {
    assert!(LHSReg.operator unsigned int(), "Invalid register number.");
    if RetVT != i32 && RetVT != i64 {
        return Register { Reg: 0 };
    }
    let mut ShiftImm: u32 = 0;
    if isUInt(Imm) {
        ShiftImm = 0;
    } else if (Imm & 16773120) == Imm {
        ShiftImm = 12;
        Imm >>= 12;
    } else {
        return Register { Reg: 0 };
    }
    let mut OpcTable: [2]u32 = [[[SUBWri, SUBXri], [ADDWri, ADDXri]], [[SUBSWri, SUBSXri], [ADDSWri, ADDSXri]]];
    let mut Is64Bit: bool = RetVT == i64;
    let mut Opc: u32 = OpcTable[SetFlags][UseAdd][Is64Bit];
    let mut RC: *TargetRegisterClass = null;
    if SetFlags {
        RC = if Is64Bit { &mut GPR64RegClass } else { &mut GPR32RegClass };
    } else {
        RC = if Is64Bit { &mut GPR64spRegClass } else { &mut GPR32spRegClass };
    }
    let mut ResultReg: Register = 0;
    if WantResult {
        ResultReg = self.createResultReg(RC);
    } else {
        ResultReg = if Is64Bit { XZR } else { WZR };
    }
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    LHSReg = self.constrainOperandRegClass(II, LHSReg, II.getNumDefs());
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II, ResultReg).addReg(LHSReg, RegState {}, 0).addImm(Imm).addImm(getShifterImm(LSL, ShiftImm));
    return ResultReg;
}

fn AArch64FastISel::emitAddSub_rs(self, UseAdd: bool, RetVT: MVT, LHSReg: Register, RHSReg: Register, ShiftType: ShiftExtendType, ShiftImm: u64, SetFlags: bool, WantResult: bool) -> Register {
    assert!(LHSReg.operator unsigned int() && RHSReg.operator unsigned int(), "Invalid register number.");
    assert!(LHSReg != SP && LHSReg != WSP && RHSReg != SP && RHSReg != WSP);
    if RetVT != i32 && RetVT != i64 {
        return Register { Reg: 0 };
    }
    if ShiftImm >= RetVT.getSizeInBits().operator unsigned long long() {
        return Register { Reg: 0 };
    }
    let mut OpcTable: [2]u32 = [[[SUBWrs, SUBXrs], [ADDWrs, ADDXrs]], [[SUBSWrs, SUBSXrs], [ADDSWrs, ADDSXrs]]];
    let mut Is64Bit: bool = RetVT == i64;
    let mut Opc: u32 = OpcTable[SetFlags][UseAdd][Is64Bit];
    let mut RC: *TargetRegisterClass = if Is64Bit { &mut GPR64RegClass } else { &mut GPR32RegClass };
    let mut ResultReg: Register = 0;
    if WantResult {
        ResultReg = self.createResultReg(RC);
    } else {
        ResultReg = if Is64Bit { XZR } else { WZR };
    }
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    LHSReg = self.constrainOperandRegClass(II, LHSReg, II.getNumDefs());
    RHSReg = self.constrainOperandRegClass(II, RHSReg, II.getNumDefs() + 1);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II, ResultReg).addReg(LHSReg, RegState {}, 0).addReg(RHSReg, RegState {}, 0).addImm(getShifterImm(ShiftType, ShiftImm));
    return ResultReg;
}

fn AArch64FastISel::emitAddSub_rx(self, UseAdd: bool, RetVT: MVT, LHSReg: Register, RHSReg: Register, ExtType: ShiftExtendType, ShiftImm: u64, SetFlags: bool, WantResult: bool) -> Register {
    assert!(LHSReg.operator unsigned int() && RHSReg.operator unsigned int(), "Invalid register number.");
    assert!(LHSReg != XZR && LHSReg != WZR && RHSReg != XZR && RHSReg != WZR);
    if RetVT != i32 && RetVT != i64 {
        return Register { Reg: 0 };
    }
    if ShiftImm >= 4 {
        return Register { Reg: 0 };
    }
    let mut OpcTable: [2]u32 = [[[SUBWrx, SUBXrx], [ADDWrx, ADDXrx]], [[SUBSWrx, SUBSXrx], [ADDSWrx, ADDSXrx]]];
    let mut Is64Bit: bool = RetVT == i64;
    let mut Opc: u32 = OpcTable[SetFlags][UseAdd][Is64Bit];
    let mut RC: *TargetRegisterClass = null;
    if SetFlags {
        RC = if Is64Bit { &mut GPR64RegClass } else { &mut GPR32RegClass };
    } else {
        RC = if Is64Bit { &mut GPR64spRegClass } else { &mut GPR32spRegClass };
    }
    let mut ResultReg: Register = 0;
    if WantResult {
        ResultReg = self.createResultReg(RC);
    } else {
        ResultReg = if Is64Bit { XZR } else { WZR };
    }
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    LHSReg = self.constrainOperandRegClass(II, LHSReg, II.getNumDefs());
    RHSReg = self.constrainOperandRegClass(II, RHSReg, II.getNumDefs() + 1);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II, ResultReg).addReg(LHSReg, RegState {}, 0).addReg(RHSReg, RegState {}, 0).addImm(getArithExtendImm(ExtType, ShiftImm));
    return ResultReg;
}

fn AArch64FastISel::emitCmp(self, LHS: *Value, RHS: *Value, IsZExt: bool) -> bool {
    let mut Ty: *mut Type = LHS.getType();
    let mut EVT: EVT = self.TLI.getValueType(self.DL, Ty, true);
    if !EVT.isSimple() {
        return false;
    }
    let mut VT: MVT = EVT.getSimpleVT();
    match VT.SimpleTy {
        _ => {
            return false;
        },
        i1 => {
            i8;
        },
        f32 => {
            f64;
        },
    }
}

fn AArch64FastISel::emitICmp(self, RetVT: MVT, LHS: *Value, RHS: *Value, IsZExt: bool) -> bool {
    return self.emitSub(RetVT, LHS, RHS, true, false, IsZExt).isValid();
}

fn AArch64FastISel::emitICmp_ri(self, RetVT: MVT, LHSReg: Register, Imm: u64) -> bool {
    return self.emitAddSub_ri(false, RetVT, LHSReg, Imm, true, false).isValid();
}

fn AArch64FastISel::emitFCmp(self, RetVT: MVT, LHS: *Value, RHS: *Value) -> bool {
    if RetVT != f32 && RetVT != f64 {
        return false;
    }
    let mut UseImm: bool = false;
    if dyn_cast(RHS) {
        CFP;
    } else if CFP.isZero() && !CFP.isNegative() {
        UseImm = true;
    }
    let mut LHSReg: Register = self.getRegForValue(LHS);
    if !LHSReg.operator unsigned int() {
        return false;
    }
    if UseImm {
        let mut Opc: u32 = if (RetVT == f64) { FCMPDri } else { FCMPSri };
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc)).addReg(LHSReg, RegState {}, 0);
        return true;
    }
    let mut RHSReg: Register = self.getRegForValue(RHS);
    if !RHSReg.operator unsigned int() {
        return false;
    }
    let mut Opc: u32 = if (RetVT == f64) { FCMPDrr } else { FCMPSrr };
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc)).addReg(LHSReg, RegState {}, 0).addReg(RHSReg, RegState {}, 0);
    return true;
}

fn AArch64FastISel::emitAdd(self, RetVT: MVT, LHS: *Value, RHS: *Value, SetFlags: bool, WantResult: bool, IsZExt: bool) -> Register {
    return self.emitAddSub(true, RetVT, LHS, RHS, SetFlags, WantResult, IsZExt);
}

fn AArch64FastISel::emitAdd_ri_(self, VT: MVT, Op0: Register, Imm: i64) -> Register {
    let mut ResultReg: Register = 0;
    if Imm < 0 {
        ResultReg = self.emitAddSub_ri(false, VT, Op0, -Imm, false, true);
    } else {
        ResultReg = self.emitAddSub_ri(true, VT, Op0, Imm, false, true);
    }
    if ResultReg.operator unsigned int() {
        return ResultReg;
    }
    let mut CReg: Register = self.fastEmit_i(VT, VT, Constant, Imm);
    if !CReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    ResultReg = self.emitAddSub_rr(true, VT, Op0, CReg, false, true);
    return ResultReg;
}

fn AArch64FastISel::emitSub(self, RetVT: MVT, LHS: *Value, RHS: *Value, SetFlags: bool, WantResult: bool, IsZExt: bool) -> Register {
    return self.emitAddSub(false, RetVT, LHS, RHS, SetFlags, WantResult, IsZExt);
}

fn AArch64FastISel::emitSubs_rr(self, RetVT: MVT, LHSReg: Register, RHSReg: Register, WantResult: bool) -> Register {
    return self.emitAddSub_rr(false, RetVT, LHSReg, RHSReg, true, WantResult);
}

fn AArch64FastISel::emitSubs_rs(self, RetVT: MVT, LHSReg: Register, RHSReg: Register, ShiftType: ShiftExtendType, ShiftImm: u64, WantResult: bool) -> Register {
    return self.emitAddSub_rs(false, RetVT, LHSReg, RHSReg, ShiftType, ShiftImm, true, WantResult);
}

fn AArch64FastISel::emitLogicalOp(self, ISDOpc: u32, RetVT: MVT, LHS: *Value, RHS: *Value) -> Register {
    if isa(LHS) && !isa(RHS) {
        swap(LHS, RHS);
    }
    if LHS.hasOneUse() && self.isValueAvailable(LHS) {
        if isMulPowOf2(LHS) {
            swap(LHS, RHS);
        }
    }
    if LHS.hasOneUse() && self.isValueAvailable(LHS) {
        if dyn_cast(LHS) {
            SI;
        } else if isa(SI.getOperand(1)) {
            swap(LHS, RHS);
        }
    }
    let mut LHSReg: Register = self.getRegForValue(LHS);
    if !LHSReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    let mut ResultReg: Register = 0;
    if dyn_cast(RHS) {
        C;
    } else {
        let mut Imm: u64 = C.getZExtValue();
        ResultReg = self.emitLogicalOp_ri(ISDOpc, RetVT, LHSReg, Imm);
    }
    if ResultReg.operator unsigned int() {
        return ResultReg;
    }
    if RHS.hasOneUse() && self.isValueAvailable(RHS) {
        if isMulPowOf2(RHS) {
            let mut MulLHS: *Value = cast(RHS).getOperand(0);
            let mut MulRHS: *Value = cast(RHS).getOperand(1);
            if dyn_cast(MulLHS) {
                C;
            } else if C.getValue().isPowerOf2() {
                swap(MulLHS, MulRHS);
            }
            assert!(isa(MulRHS), "Expected a ConstantInt.");
            let mut ShiftVal: u64 = cast(MulRHS).getValue().logBase2();
            let mut RHSReg: Register = self.getRegForValue(MulLHS);
            if !RHSReg.operator unsigned int() {
                return Register { Reg: 0 };
            }
            ResultReg = self.emitLogicalOp_rs(ISDOpc, RetVT, LHSReg, RHSReg, ShiftVal);
            if ResultReg.operator unsigned int() {
                return ResultReg;
            }
        }
    }
    if RHS.hasOneUse() && self.isValueAvailable(RHS) {
        if dyn_cast(RHS) {
            SI;
        } else if dyn_cast(SI.getOperand(1)) {
            C;
        } else {
            let mut ShiftVal: u64 = C.getZExtValue();
            let mut RHSReg: Register = self.getRegForValue(SI.getOperand(0));
            if !RHSReg.operator unsigned int() {
                return Register { Reg: 0 };
            }
            ResultReg = self.emitLogicalOp_rs(ISDOpc, RetVT, LHSReg, RHSReg, ShiftVal);
            if ResultReg.operator unsigned int() {
                return ResultReg;
            }
        }
    }
    let mut RHSReg: Register = self.getRegForValue(RHS);
    if !RHSReg.operator unsigned int() {
        return Register { Reg: 0 };
    }
    let mut VT: MVT = if i32 > RetVT.SimpleTy { i32 } else { RetVT.SimpleTy };
    ResultReg = self.fastEmit_rr(VT, VT, ISDOpc, LHSReg, RHSReg);
    if RetVT >= i8 && RetVT <= i16 {
        let mut Mask: u64 = if (RetVT == i8) { 255 } else { 65535 };
        ResultReg = self.emitAnd_ri(i32, ResultReg, Mask);
    }
    return ResultReg;
}

fn AArch64FastISel::emitLogicalOp_ri(self, ISDOpc: u32, RetVT: MVT, LHSReg: Register, Imm: u64) -> Register {
    let mut OpcTable: [3]u32 = [[ANDWri, ANDXri], [ORRWri, ORRXri], [EORWri, EORXri]];
    let mut RC: *TargetRegisterClass = null;
    let mut Opc: u32 = 0;
    let mut RegSize: u32 = 0;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i1 => {
            i8;
        },
        i64 => {
            Opc = OpcTable[ISDOpc - AND][1];
        },
    }
    if !isLogicalImmediate(Imm, RegSize) {
        return Register { Reg: 0 };
    }
    let mut ResultReg: Register = self.fastEmitInst_ri(Opc, RC, LHSReg, encodeLogicalImmediate(Imm, RegSize));
    if RetVT >= i8 && RetVT <= i16 && ISDOpc != AND {
        let mut Mask: u64 = if (RetVT == i8) { 255 } else { 65535 };
        ResultReg = self.emitAnd_ri(i32, ResultReg, Mask);
    }
    return ResultReg;
}

fn AArch64FastISel::emitLogicalOp_rs(self, ISDOpc: u32, RetVT: MVT, LHSReg: Register, RHSReg: Register, ShiftImm: u64) -> Register {
    let mut OpcTable: [3]u32 = [[ANDWrs, ANDXrs], [ORRWrs, ORRXrs], [EORWrs, EORXrs]];
    if ShiftImm >= RetVT.getSizeInBits().operator unsigned long long() {
        return Register { Reg: 0 };
    }
    let mut RC: *TargetRegisterClass = null;
    let mut Opc: u32 = 0;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i1 => {
            i8;
        },
        i64 => {
            Opc = OpcTable[ISDOpc - AND][1];
        },
    }
    let mut ResultReg: Register = self.fastEmitInst_rri(Opc, RC, LHSReg, RHSReg, getShifterImm(LSL, ShiftImm));
    if RetVT >= i8 && RetVT <= i16 {
        let mut Mask: u64 = if (RetVT == i8) { 255 } else { 65535 };
        ResultReg = self.emitAnd_ri(i32, ResultReg, Mask);
    }
    return ResultReg;
}

fn AArch64FastISel::emitAnd_ri(self, RetVT: MVT, LHSReg: Register, Imm: u64) -> Register {
    return self.emitLogicalOp_ri(AND, RetVT, LHSReg, Imm);
}

fn AArch64FastISel::emitLoad(self, VT: MVT, RetVT: MVT, Addr: Address, WantZExt: bool, MMO: *mut MachineMemOperand) -> Register {
    if !self.TLI.allowsMisalignedMemoryAccesses(VT, 0, 1, MONone, null) {
        return Register { Reg: 0 };
    }
    if !self.simplifyAddress(Addr, VT) {
        return Register { Reg: 0 };
    }
    let mut ScaleFactor: u32 = getImplicitScaleFactor(VT);
    if !ScaleFactor {
        llvm_unreachable_internal("Unexpected value type.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 1758);
    }
    let mut UseScaled: bool = true;
    if (Addr.getOffset() < 0) || (Addr.getOffset() & (ScaleFactor - 1)) {
        UseScaled = false;
        ScaleFactor = 1;
    }
    let mut GPOpcTable: [2]u32 = [[[LDURSBWi, LDURSHWi, LDURWi, LDURXi], [LDURSBXi, LDURSHXi, LDURSWi, LDURXi], [LDRSBWui, LDRSHWui, LDRWui, LDRXui], [LDRSBXui, LDRSHXui, LDRSWui, LDRXui], [LDRSBWroX, LDRSHWroX, LDRWroX, LDRXroX], [LDRSBXroX, LDRSHXroX, LDRSWroX, LDRXroX], [LDRSBWroW, LDRSHWroW, LDRWroW, LDRXroW], [LDRSBXroW, LDRSHXroW, LDRSWroW, LDRXroW]], [[LDURBBi, LDURHHi, LDURWi, LDURXi], [LDURBBi, LDURHHi, LDURWi, LDURXi], [LDRBBui, LDRHHui, LDRWui, LDRXui], [LDRBBui, LDRHHui, LDRWui, LDRXui], [LDRBBroX, LDRHHroX, LDRWroX, LDRXroX], [LDRBBroX, LDRHHroX, LDRWroX, LDRXroX], [LDRBBroW, LDRHHroW, LDRWroW, LDRXroW], [LDRBBroW, LDRHHroW, LDRWroW, LDRXroW]]];
    let mut FPOpcTable: [4]u32 = [[LDURSi, LDURDi], [LDRSui, LDRDui], [LDRSroX, LDRDroX], [LDRSroW, LDRDroW]];
    let mut Opc: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    let mut UseRegOffset: bool = Addr.isRegBase() && !Addr.getOffset() && Addr.getReg().operator unsigned int() && Addr.getOffsetReg().operator unsigned int();
    let mut Idx: u32 = if UseRegOffset { 2 } else { if UseScaled { 1 } else { 0 } };
    if Addr.getExtendType() == UXTW || Addr.getExtendType() == SXTW {
        Idx += 1;
    }
    let mut IsRet64Bit: bool = RetVT == i64;
    match VT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected value type.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 1826);
        },
        i1 => {
            i8;
        },
        i16 => {
            Opc = GPOpcTable[WantZExt][2 * Idx + IsRet64Bit][1];
        },
        i32 => {
            Opc = GPOpcTable[WantZExt][2 * Idx + IsRet64Bit][2];
        },
        i64 => {
            Opc = GPOpcTable[WantZExt][2 * Idx + IsRet64Bit][3];
        },
        f32 => {
            Opc = FPOpcTable[Idx][0];
        },
        f64 => {
            Opc = FPOpcTable[Idx][1];
        },
    }
    let mut ResultReg: Register = self.createResultReg(RC);
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg);
    self.addLoadStoreOperands(Addr, MIB, MOLoad, ScaleFactor, MMO);
    if VT == i1 {
        let mut ANDReg: Register = self.emitAnd_ri(i32, ResultReg, 1);
        assert!(ANDReg.operator unsigned int(), "Unexpected AND instruction emission failure.");
        ResultReg = ANDReg;
    }
    if WantZExt && RetVT == i64 && VT <= i32 {
        let mut Reg64: Register = self.createResultReg(&mut GPR64RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), Reg64).addReg(ResultReg, getKillRegState(true), 0).addImm(sub_32);
        ResultReg = Reg64;
    }
    return ResultReg;
}

fn AArch64FastISel::selectAddSub(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if !self.isTypeSupported(I.getType(), VT, true) {
        return false;
    }
    if VT.isVector() {
        return self.selectOperator(I, I.getOpcode());
    }
    let mut ResultReg: Register = 0;
    match I.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected instruction.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 1894);
        },
        Add => {
            ResultReg = self.emitAdd(VT, I.getOperand(0), I.getOperand(1), false, true, false);
        },
        Sub => {
            ResultReg = self.emitSub(VT, I.getOperand(0), I.getOperand(1), false, true, false);
        },
    }
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectLogicalOp(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if !self.isTypeSupported(I.getType(), VT, true) {
        return false;
    }
    if VT.isVector() {
        return self.selectOperator(I, I.getOpcode());
    }
    let mut ResultReg: Register = 0;
    match I.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected instruction.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 1920);
        },
        And => {
            ResultReg = self.emitLogicalOp(AND, VT, I.getOperand(0), I.getOperand(1));
        },
        Or => {
            ResultReg = self.emitLogicalOp(OR, VT, I.getOperand(0), I.getOperand(1));
        },
        Xor => {
            ResultReg = self.emitLogicalOp(XOR, VT, I.getOperand(0), I.getOperand(1));
        },
    }
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectLoad(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if !self.isTypeSupported(I.getType(), VT, true) || cast(I).isAtomic() {
        return false;
    }
    let mut SV: *Value = I.getOperand(0);
    if self.TLI.supportSwiftError() {
        if dyn_cast(SV) {
            Arg;
        } else {
            if Arg.hasSwiftErrorAttr() {
                return false;
            }
        }
        if dyn_cast(SV) {
            Alloca;
        } else {
            if Alloca.isSwiftError() {
                return false;
            }
        }
    }
    let mut Addr: Address = Address {};
    if !self.computeAddress(I.getOperand(0), Addr, I.getType()) {
        return false;
    }
    let mut WantZExt: bool = true;
    let mut RetVT: MVT = VT;
    let mut IntExtVal: *Value = null;
    if I.hasOneUse() {
        if dyn_cast(operator(I.use_begin()).getUser()) {
            ZE;
        } else {
            if self.isTypeSupported(ZE.getType(), RetVT, false) {
                IntExtVal = ZE;
            } else {
                RetVT = VT;
            }
        }
    }
    let mut ResultReg: Register = self.emitLoad(VT, RetVT, Addr, WantZExt, self.createMachineMemOperandFor(I));
    if !ResultReg.operator unsigned int() {
        return false;
    }
    if IntExtVal {
        let mut Reg: Register = self.lookUpRegForValue(IntExtVal);
        let mut MI: *mut MachineInstr = self.MRI.getUniqueVRegDef(Reg);
        if !MI {
            if RetVT == i64 && VT <= i32 {
                if WantZExt {
                    let mut I: iterator = prev(self.FuncInfo.InsertPt, 1);
                    ResultReg = operator(prev(I, 1)).getOperand(0).getReg();
                    self.removeDeadCode(I, next(I, 1));
                } else {
                    ResultReg = self.fastEmitInst_extractsubreg(i32, ResultReg, sub_32);
                }
            }
            self.updateValueMap(I, ResultReg, 1);
            return true;
        }
        while MI {
            Reg = 0;
            for Opnd in MI.uses() {
                if Opnd.isReg() {
                    Reg = Opnd.getReg();
                    break;
                }
            }
            let mut I: iterator = MI;
            self.removeDeadCode(I, next(I, 1));
            MI = null;
            if Reg.operator unsigned int() {
                MI = self.MRI.getUniqueVRegDef(Reg);
            }
        }
        self.updateValueMap(IntExtVal, ResultReg, 1);
        return true;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::emitStoreRelease(self, VT: MVT, SrcReg: Register, AddrReg: Register, MMO: *mut MachineMemOperand) -> bool {
    let mut Opc: u32 = 0;
    match VT.SimpleTy {
        _ => {
            return false;
        },
        i8 => {
            Opc = STLRB;
        },
        i16 => {
            Opc = STLRH;
        },
        i32 => {
            Opc = STLRW;
        },
        i64 => {
            Opc = STLRX;
        },
    }
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    SrcReg = self.constrainOperandRegClass(II, SrcReg, 0);
    AddrReg = self.constrainOperandRegClass(II, AddrReg, 1);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II).addReg(SrcReg, RegState {}, 0).addReg(AddrReg, RegState {}, 0).addMemOperand(MMO);
    return true;
}

fn AArch64FastISel::emitStore(self, VT: MVT, SrcReg: Register, Addr: Address, MMO: *mut MachineMemOperand) -> bool {
    if !self.TLI.allowsMisalignedMemoryAccesses(VT, 0, 1, MONone, null) {
        return false;
    }
    if !self.simplifyAddress(Addr, VT) {
        return false;
    }
    let mut ScaleFactor: u32 = getImplicitScaleFactor(VT);
    if !ScaleFactor {
        llvm_unreachable_internal("Unexpected value type.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 2082);
    }
    let mut UseScaled: bool = true;
    if (Addr.getOffset() < 0) || (Addr.getOffset() & (ScaleFactor - 1)) {
        UseScaled = false;
        ScaleFactor = 1;
    }
    let mut OpcTable: [4]u32 = [[STURBBi, STURHHi, STURWi, STURXi, STURSi, STURDi], [STRBBui, STRHHui, STRWui, STRXui, STRSui, STRDui], [STRBBroX, STRHHroX, STRWroX, STRXroX, STRSroX, STRDroX], [STRBBroW, STRHHroW, STRWroW, STRXroW, STRSroW, STRDroW]];
    let mut Opc: u32 = 0;
    let mut VTIsi1: bool = false;
    let mut UseRegOffset: bool = Addr.isRegBase() && !Addr.getOffset() && Addr.getReg().operator unsigned int() && Addr.getOffsetReg().operator unsigned int();
    let mut Idx: u32 = if UseRegOffset { 2 } else { if UseScaled { 1 } else { 0 } };
    if Addr.getExtendType() == UXTW || Addr.getExtendType() == SXTW {
        Idx += 1;
    }
    match VT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected value type.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 2113);
        },
        i1 => {
            VTIsi1 = true;
        },
        i8 => {
            Opc = OpcTable[Idx][0];
        },
        i16 => {
            Opc = OpcTable[Idx][1];
        },
        i32 => {
            Opc = OpcTable[Idx][2];
        },
        i64 => {
            Opc = OpcTable[Idx][3];
        },
        f32 => {
            Opc = OpcTable[Idx][4];
        },
        f64 => {
            Opc = OpcTable[Idx][5];
        },
    }
    if VTIsi1 && SrcReg != WZR {
        let mut ANDReg: Register = self.emitAnd_ri(i32, SrcReg, 1);
        assert!(ANDReg.operator unsigned int(), "Unexpected AND instruction emission failure.");
        SrcReg = ANDReg;
    }
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    SrcReg = self.constrainOperandRegClass(II, SrcReg, II.getNumDefs());
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II).addReg(SrcReg, RegState {}, 0);
    self.addLoadStoreOperands(Addr, MIB, MOStore, ScaleFactor, MMO);
    return true;
}

fn AArch64FastISel::selectStore(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    let mut Op0: *Value = I.getOperand(0);
    if !self.isTypeSupported(Op0.getType(), VT, true) {
        return false;
    }
    let mut PtrV: *Value = I.getOperand(1);
    if self.TLI.supportSwiftError() {
        if dyn_cast(PtrV) {
            Arg;
        } else {
            if Arg.hasSwiftErrorAttr() {
                return false;
            }
        }
        if dyn_cast(PtrV) {
            Alloca;
        } else {
            if Alloca.isSwiftError() {
                return false;
            }
        }
    }
    let mut SrcReg: Register = 0;
    if dyn_cast(Op0) {
        CI;
    } else {
        if CI.isZero() {
            SrcReg = if (VT == i64) { XZR } else { WZR };
        }
    }
    if !SrcReg.operator unsigned int() {
        SrcReg = self.getRegForValue(Op0);
    }
    if !SrcReg.operator unsigned int() {
        return false;
    }
    let mut SI: *StoreInst = cast(I);
    if SI.isAtomic() {
        let mut Ord: AtomicOrdering = SI.getOrdering();
        if isReleaseOrStronger(Ord) {
            let mut AddrReg: Register = self.getRegForValue(PtrV);
            if !AddrReg.operator unsigned int() {
                return false;
            }
            return self.emitStoreRelease(VT, SrcReg, AddrReg, self.createMachineMemOperandFor(I));
        }
    }
    let mut Addr: Address = Address {};
    if !self.computeAddress(PtrV, Addr, Op0.getType()) {
        return false;
    }
    if !self.emitStore(VT, SrcReg, Addr, self.createMachineMemOperandFor(I)) {
        return false;
    }
    return true;
}

fn getCompareCC(Pred: Predicate) -> CondCode {
    match Pred {
        FCMP_ONE => {
            FCMP_UEQ;
        },
        ICMP_EQ => {
            FCMP_OEQ;
        },
        ICMP_SGT => {
            FCMP_OGT;
        },
        ICMP_SGE => {
            FCMP_OGE;
        },
        ICMP_UGT => {
            FCMP_UGT;
        },
        FCMP_OLT => {
            return MI;
        },
        ICMP_ULE => {
            FCMP_OLE;
        },
        FCMP_ORD => {
            return VC;
        },
        FCMP_UNO => {
            return VS;
        },
        FCMP_UGE => {
            return PL;
        },
        ICMP_SLT => {
            FCMP_ULT;
        },
        ICMP_SLE => {
            FCMP_ULE;
        },
        FCMP_UNE => {
            ICMP_NE;
        },
        ICMP_UGE => {
            return HS;
        },
        ICMP_ULT => {
            return LO;
        },
    }
}

fn AArch64FastISel::emitCompareAndBranch(self, BI: *CondBrInst) -> bool {
    if self.FuncInfo.MF.getFunction().hasFnAttribute(SpeculativeLoadHardening) {
        return false;
    }
    assert!(isa(BI.getCondition()), "Expected cmp instruction");
    let mut CI: *CmpInst = cast(BI.getCondition());
    let mut Predicate: Predicate = self.optimizeCmpPredicate(CI);
    let mut LHS: *Value = CI.getOperand(0);
    let mut RHS: *Value = CI.getOperand(1);
    let mut VT: MVT = MVT {};
    if !self.isTypeSupported(LHS.getType(), VT, false) {
        return false;
    }
    let mut BW: u32 = VT.getSizeInBits().operator unsigned long long();
    if BW > 64 {
        return false;
    }
    let mut TBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(BI.getSuccessor(0));
    let mut FBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(BI.getSuccessor(1));
    if self.FuncInfo.MBB.isLayoutSuccessor(TBB) {
        swap(TBB, FBB);
        Predicate = getInversePredicate(Predicate);
    }
    let mut TestBit: i32 = -1;
    let mut IsCmpNE: bool = false;
    match Predicate {
        _ => {
            return false;
        },
        ICMP_EQ => {
            ICMP_NE;
        },
        ICMP_SLT => {
            ICMP_SGE;
        },
        ICMP_SGT => {
            ICMP_SLE;
        },
    }
    let mut OpcTable: [2]u32 = [[[CBZW, CBZX], [CBNZW, CBNZX]], [[TBZW, TBZX], [TBNZW, TBNZX]]];
    let mut IsBitTest: bool = TestBit != -1;
    let mut Is64Bit: bool = BW == 64;
    if TestBit < 32 && TestBit >= 0 {
        Is64Bit = false;
    }
    let mut Opc: u32 = OpcTable[IsBitTest][IsCmpNE][Is64Bit];
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    let mut SrcReg: Register = self.getRegForValue(LHS);
    if !SrcReg.operator unsigned int() {
        return false;
    }
    if BW == 64 && !Is64Bit {
        SrcReg = self.fastEmitInst_extractsubreg(i32, SrcReg, sub_32);
    }
    if (BW < 32) && !IsBitTest {
        SrcReg = self.emitIntExt(VT, SrcReg, i32, true);
    }
    SrcReg = self.constrainOperandRegClass(II, SrcReg, II.getNumDefs());
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc)).addReg(SrcReg, RegState {}, 0);
    if IsBitTest {
        MIB.addImm(TestBit);
    }
    MIB.addMBB(TBB, 0);
    self.finishCondBranch(BI.getParent(), TBB, FBB);
    return true;
}

fn AArch64FastISel::selectBranch(self, I: *Instruction) -> bool {
    let mut BI: *CondBrInst = cast(I);
    let mut TBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(BI.getSuccessor(0));
    let mut FBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(BI.getSuccessor(1));
    if dyn_cast(BI.getCondition()) {
        CI;
    } else {
        if CI.hasOneUse() && self.isValueAvailable(CI) {
            let mut Predicate: Predicate = self.optimizeCmpPredicate(CI);
            match Predicate {
                _ => {
                    break;
                },
                FCMP_FALSE => {
                    self.fastEmitBranch(FBB, self.MIMD.getDL());
                },
                FCMP_TRUE => {
                    self.fastEmitBranch(TBB, self.MIMD.getDL());
                },
            }
            if self.emitCompareAndBranch(BI) {
                return true;
            }
            if self.FuncInfo.MBB.isLayoutSuccessor(TBB) {
                swap(TBB, FBB);
                Predicate = getInversePredicate(Predicate);
            }
            if !self.emitCmp(CI.getOperand(0), CI.getOperand(1), CI.isUnsigned()) {
                return false;
            }
            let mut CC: CondCode = getCompareCC(Predicate);
            let mut ExtraCC: CondCode = AL;
            match Predicate {
                _ => {
                    break;
                },
                FCMP_UEQ => {
                    ExtraCC = EQ;
                },
                FCMP_ONE => {
                    ExtraCC = MI;
                },
            }
            assert!((CC != AL), "Unexpected condition code.");
            if ExtraCC != AL {
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Bcc)).addImm(ExtraCC).addMBB(TBB, 0);
            }
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Bcc)).addImm(CC).addMBB(TBB, 0);
            self.finishCondBranch(BI.getParent(), TBB, FBB);
            return true;
        }
    }
    let mut CondReg: Register = self.getRegForValue(BI.getCondition());
    if !CondReg.operator unsigned int() {
        return false;
    }
    if self.FuncInfo.MF.getFunction().hasFnAttribute(SpeculativeLoadHardening) {
        return false;
    }
    let mut Opcode: u32 = TBNZW;
    if self.FuncInfo.MBB.isLayoutSuccessor(TBB) {
        swap(TBB, FBB);
        Opcode = TBZW;
    }
    let mut II: *MCInstrDesc = self.TII.get(Opcode);
    let mut ConstrainedCondReg: Register = self.constrainOperandRegClass(II, CondReg, II.getNumDefs());
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II).addReg(ConstrainedCondReg, RegState {}, 0).addImm(0).addMBB(TBB, 0);
    self.finishCondBranch(BI.getParent(), TBB, FBB);
    return true;
}

fn AArch64FastISel::selectIndirectBr(self, I: *Instruction) -> bool {
    let mut BI: *IndirectBrInst = cast(I);
    let mut AddrReg: Register = self.getRegForValue(BI.getOperand(0));
    if !AddrReg.operator unsigned int() {
        return false;
    }
    if self.FuncInfo.MF.getFunction().hasFnAttribute("ptrauth-indirect-gotos") {
        return false;
    }
    let mut II: *MCInstrDesc = self.TII.get(BR);
    AddrReg = self.constrainOperandRegClass(II, AddrReg, II.getNumDefs());
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II).addReg(AddrReg, RegState {}, 0);
    for Succ in BI.successors() {
        self.FuncInfo.MBB.addSuccessor(self.FuncInfo.getMBB(Succ), getUnknown());
    }
    return true;
}

fn AArch64FastISel::selectCmp(self, I: *Instruction) -> bool {
    let mut CI: *CmpInst = cast(I);
    if CI.getType().isVectorTy() {
        return false;
    }
    let mut Predicate: Predicate = self.optimizeCmpPredicate(CI);
    let mut ResultReg: Register = 0;
    match Predicate {
        _ => {
            break;
        },
        FCMP_FALSE => {
            ResultReg = self.createResultReg(&mut GPR32RegClass);
        },
        FCMP_TRUE => {
            ResultReg = self.fastEmit_i(i32, i32, Constant, 1);
        },
    }
    if ResultReg.operator unsigned int() {
        self.updateValueMap(I, ResultReg, 1);
        return true;
    }
    if !self.emitCmp(CI.getOperand(0), CI.getOperand(1), CI.isUnsigned()) {
        return false;
    }
    ResultReg = self.createResultReg(&mut GPR32RegClass);
    let mut CondCodeTable: [2]u32 = [[NE, VC], [PL, LE]];
    let mut CondCodes: *mut u32 = null;
    match Predicate {
        _ => {
            break;
        },
        FCMP_UEQ => {
            CondCodes = &mut CondCodeTable[0][0];
        },
        FCMP_ONE => {
            CondCodes = &mut CondCodeTable[1][0];
        },
    }
    if CondCodes {
        let mut TmpReg1: Register = self.createResultReg(&mut GPR32RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(CSINCWr), TmpReg1).addReg(WZR, getKillRegState(true), 0).addReg(WZR, getKillRegState(true), 0).addImm(CondCodes[0]);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(CSINCWr), ResultReg).addReg(TmpReg1, getKillRegState(true), 0).addReg(WZR, getKillRegState(true), 0).addImm(CondCodes[1]);
        self.updateValueMap(I, ResultReg, 1);
        return true;
    }
    let mut CC: CondCode = getCompareCC(Predicate);
    assert!((CC != AL), "Unexpected condition code.");
    let mut invertedCC: CondCode = getInvertedCondCode(CC);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(CSINCWr), ResultReg).addReg(WZR, getKillRegState(true), 0).addReg(WZR, getKillRegState(true), 0).addImm(invertedCC);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::optimizeSelect(self, SI: *SelectInst) -> bool {
    if !SI.getType().isIntegerTy(1) {
        return false;
    }
    let mut Src1Val: *Value = null;
    let mut Src2Val: *Value = null;
    let mut Opc: u32 = 0;
    let mut NeedExtraOp: bool = false;
    if dyn_cast(SI.getTrueValue()) {
        CI;
    } else {
        if CI.isOne() {
            Src1Val = SI.getCondition();
            Src2Val = SI.getFalseValue();
            Opc = ORRWrr;
        } else {
            assert!(CI.isZero();
            Src1Val = SI.getFalseValue();
            Src2Val = SI.getCondition();
            Opc = BICWrr;
        }
    }
    if !Opc {
        return false;
    }
    let mut Src1Reg: Register = self.getRegForValue(Src1Val);
    if !Src1Reg.operator unsigned int() {
        return false;
    }
    let mut Src2Reg: Register = self.getRegForValue(Src2Val);
    if !Src2Reg.operator unsigned int() {
        return false;
    }
    if NeedExtraOp {
        Src1Reg = self.emitLogicalOp_ri(XOR, i32, Src1Reg, 1);
    }
    let mut ResultReg: Register = self.fastEmitInst_rr(Opc, &mut GPR32RegClass, Src1Reg, Src2Reg);
    self.updateValueMap(SI, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectSelect(self, I: *Instruction) -> bool {
    assert!(isa(I), "Expected a select instruction.");
    let mut VT: MVT = MVT {};
    if !self.isTypeSupported(I.getType(), VT, false) {
        return false;
    }
    let mut Opc: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    match VT.SimpleTy {
        _ => {
            return false;
        },
        i1 => {
            i8;
        },
        i64 => {
            Opc = CSELXr;
        },
        f32 => {
            Opc = FCSELSrrr;
        },
        f64 => {
            Opc = FCSELDrrr;
        },
    }
    let mut SI: *SelectInst = cast(I);
    let mut Cond: *Value = SI.getCondition();
    let mut CC: CondCode = NE;
    let mut ExtraCC: CondCode = AL;
    if self.optimizeSelect(SI) {
        return true;
    }
    if self.foldXALUIntrinsic(CC, I, Cond) {
        let mut CondReg: Register = self.getRegForValue(Cond);
        if !CondReg.operator unsigned int() {
            return false;
        }
    } else if isa(Cond) && cast(Cond).hasOneUse() && self.isValueAvailable(Cond) {
        let mut Cmp: *CmpInst const = cast(Cond);
        let mut Predicate: Predicate = self.optimizeCmpPredicate(Cmp);
        let mut FoldSelect: *Value = null;
        match Predicate {
            _ => {
                break;
            },
            FCMP_FALSE => {
                FoldSelect = SI.getFalseValue();
            },
            FCMP_TRUE => {
                FoldSelect = SI.getTrueValue();
            },
        }
        if FoldSelect {
            let mut SrcReg: Register = self.getRegForValue(FoldSelect);
            if !SrcReg.operator unsigned int() {
                return false;
            }
            self.updateValueMap(I, SrcReg, 1);
            return true;
        }
        if !self.emitCmp(Cmp.getOperand(0), Cmp.getOperand(1), Cmp.isUnsigned()) {
            return false;
        }
        CC = getCompareCC(Predicate);
        match Predicate {
            _ => {
                break;
            },
            FCMP_UEQ => {
                ExtraCC = EQ;
            },
            FCMP_ONE => {
                ExtraCC = MI;
            },
        }
        assert!((CC != AL), "Unexpected condition code.");
    } else {
        let mut CondReg: Register = self.getRegForValue(Cond);
        if !CondReg.operator unsigned int() {
            return false;
        }
        let mut II: *MCInstrDesc = self.TII.get(ANDSWri);
        CondReg = self.constrainOperandRegClass(II, CondReg, 1);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II, WZR).addReg(CondReg, RegState {}, 0).addImm(encodeLogicalImmediate(1, 32));
    }
    let mut Src1Reg: Register = self.getRegForValue(SI.getTrueValue());
    let mut Src2Reg: Register = self.getRegForValue(SI.getFalseValue());
    if !Src1Reg.operator unsigned int() || !Src2Reg.operator unsigned int() {
        return false;
    }
    if ExtraCC != AL {
        Src2Reg = self.fastEmitInst_rri(Opc, RC, Src1Reg, Src2Reg, ExtraCC);
    }
    let mut ResultReg: Register = self.fastEmitInst_rri(Opc, RC, Src1Reg, Src2Reg, CC);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectFPExt(self, I: *Instruction) -> bool {
    let mut V: *mut Value = I.getOperand(0);
    if !I.getType().isDoubleTy() || !V.getType().isFloatTy() {
        return false;
    }
    let mut Op: Register = self.getRegForValue(V);
    if Op == 0 {
        return false;
    }
    let mut ResultReg: Register = self.createResultReg(&mut FPR64RegClass);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(FCVTDSr), ResultReg).addReg(Op, RegState {}, 0);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectFPTrunc(self, I: *Instruction) -> bool {
    let mut V: *mut Value = I.getOperand(0);
    if !I.getType().isFloatTy() || !V.getType().isDoubleTy() {
        return false;
    }
    let mut Op: Register = self.getRegForValue(V);
    if Op == 0 {
        return false;
    }
    let mut ResultReg: Register = self.createResultReg(&mut FPR32RegClass);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(FCVTSDr), ResultReg).addReg(Op, RegState {}, 0);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectFPToInt(self, I: *Instruction, Signed: bool) -> bool {
    let mut DestVT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), DestVT) || DestVT.isVector() {
        return false;
    }
    let mut SrcReg: Register = self.getRegForValue(I.getOperand(0));
    if !SrcReg.operator unsigned int() {
        return false;
    }
    let mut SrcVT: EVT = self.TLI.getValueType(self.DL, I.getOperand(0).getType(), true);
    if SrcVT == f128 || SrcVT == f16 || SrcVT == bf16 {
        return false;
    }
    let mut Opc: u32 = 0;
    if SrcVT == f64 {
        if Signed {
            Opc = if (DestVT == i32) { FCVTZSUWDr } else { FCVTZSUXDr };
        } else {
            Opc = if (DestVT == i32) { FCVTZUUWDr } else { FCVTZUUXDr };
        }
    } else {
        if Signed {
            Opc = if (DestVT == i32) { FCVTZSUWSr } else { FCVTZSUXSr };
        } else {
            Opc = if (DestVT == i32) { FCVTZUUWSr } else { FCVTZUUXSr };
        }
    }
    let mut ResultReg: Register = self.createResultReg(if DestVT == i32 { &mut GPR32RegClass } else { &mut GPR64RegClass });
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg).addReg(SrcReg, RegState {}, 0);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectIntToFP(self, I: *Instruction, Signed: bool) -> bool {
    let mut DestVT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), DestVT) || DestVT.isVector() {
        return false;
    }
    if DestVT == f16 || DestVT == bf16 {
        return false;
    }
    assert!((DestVT == f32 || DestVT == f64), "Unexpected value type.");
    let mut SrcReg: Register = self.getRegForValue(I.getOperand(0));
    if !SrcReg.operator unsigned int() {
        return false;
    }
    let mut SrcVT: EVT = self.TLI.getValueType(self.DL, I.getOperand(0).getType(), true);
    if SrcVT == i16 || SrcVT == i8 || SrcVT == i1 {
        SrcReg = self.emitIntExt(SrcVT.getSimpleVT(), SrcReg, i32, !Signed);
        if !SrcReg.operator unsigned int() {
            return false;
        }
    }
    let mut Opc: u32 = 0;
    if SrcVT == i64 {
        if Signed {
            Opc = if (DestVT == f32) { SCVTFUXSri } else { SCVTFUXDri };
        } else {
            Opc = if (DestVT == f32) { UCVTFUXSri } else { UCVTFUXDri };
        }
    } else {
        if Signed {
            Opc = if (DestVT == f32) { SCVTFUWSri } else { SCVTFUWDri };
        } else {
            Opc = if (DestVT == f32) { UCVTFUWSri } else { UCVTFUWDri };
        }
    }
    let mut ResultReg: Register = self.fastEmitInst_r(Opc, self.TLI.getRegClassFor(DestVT, false), SrcReg);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::fastLowerArguments(self) -> bool {
    if !self.FuncInfo.CanLowerReturn {
        return false;
    }
    let mut F: *Function = self.FuncInfo.Fn;
    if F.isVarArg() {
        return false;
    }
    let mut CC: ID = F.getCallingConv();
    if CC != C && CC != Swift {
        return false;
    }
    if self.Subtarget.hasCustomCallingConv() {
        return false;
    }
    let mut GPRCnt: u32 = 0;
    let mut FPRCnt: u32 = 0;
    for Arg in F.args() {
        if Arg.hasAttribute(ByVal) || Arg.hasAttribute(InReg) || Arg.hasAttribute(StructRet) || Arg.hasAttribute(SwiftSelf) || Arg.hasAttribute(SwiftAsync) || Arg.hasAttribute(SwiftError) || Arg.hasAttribute(Nest) {
            return false;
        }
        let mut ArgTy: *mut Type = Arg.getType();
        if ArgTy.isStructTy() || ArgTy.isArrayTy() {
            return false;
        }
        let mut ArgVT: EVT = self.TLI.getValueType(self.DL, ArgTy, false);
        if !ArgVT.isSimple() {
            return false;
        }
        let mut VT: MVT = ArgVT.getSimpleVT().SimpleTy;
        if VT.isFloatingPoint() && !self.Subtarget.hasFPARMv8() {
            return false;
        }
        if VT.isVector() && (!self.Subtarget.hasNEON() || !self.Subtarget.isLittleEndian()) {
            return false;
        }
        if VT >= i1 && VT <= i64 {
            GPRCnt += 1;
        } else if (VT >= f16 && VT <= f64) || VT.is64BitVector() || VT.is128BitVector() {
            FPRCnt += 1;
        } else {
            return false;
        }
        if GPRCnt > 8 || FPRCnt > 8 {
            return false;
        }
    }
    let mut Registers: [6]MCPhysReg = [[W0, W1, W2, W3, W4, W5, W6, W7], [X0, X1, X2, X3, X4, X5, X6, X7], [H0, H1, H2, H3, H4, H5, H6, H7], [S0, S1, S2, S3, S4, S5, S6, S7], [D0, D1, D2, D3, D4, D5, D6, D7], [Q0, Q1, Q2, Q3, Q4, Q5, Q6, Q7]];
    let mut GPRIdx: u32 = 0;
    let mut FPRIdx: u32 = 0;
    for Arg in F.args() {
        let mut VT: MVT = self.TLI.getSimpleValueType(self.DL, Arg.getType(), false);
        let mut SrcReg: u32 = 0;
        let mut RC: *TargetRegisterClass = null;
        if VT >= i1 && VT <= i32 {
            SrcReg = Registers[0][GPRIdx += 1];
            RC = &mut GPR32RegClass;
            VT = i32;
        } else if VT == i64 {
            SrcReg = Registers[1][GPRIdx += 1];
            RC = &mut GPR64RegClass;
        } else if VT == f16 || VT == bf16 {
            SrcReg = Registers[2][FPRIdx += 1];
            RC = &mut FPR16RegClass;
        } else if VT == f32 {
            SrcReg = Registers[3][FPRIdx += 1];
            RC = &mut FPR32RegClass;
        } else if (VT == f64) || VT.is64BitVector() {
            SrcReg = Registers[4][FPRIdx += 1];
            RC = &mut FPR64RegClass;
        } else if VT.is128BitVector() {
            SrcReg = Registers[5][FPRIdx += 1];
            RC = &mut FPR128RegClass;
        } else {
            llvm_unreachable_internal("Unexpected value type.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 2995);
        }
        let mut DstReg: Register = self.FuncInfo.MF.addLiveIn(SrcReg, RC);
        let mut ResultReg: Register = self.createResultReg(RC);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(DstReg, getKillRegState(true), 0);
        self.updateValueMap(&mut Arg, ResultReg, 1);
    }
    return true;
}

fn AArch64FastISel::processCallArgs(self, CLI: *mut CallLoweringInfo, OutVTs: *mut SmallVectorImpl<MVT>, OrigTys: *mut SmallVectorImpl<Type *>, NumBytes: *mut u32) -> bool {
    let mut CC: ID = CLI.CallConv;
    let mut ArgLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CC, false, *self.FuncInfo.MF, ArgLocs, *self.Context, false };
    CCInfo.AnalyzeCallOperands(OutVTs, CLI.OutFlags, OrigTys, self.CCAssignFnForCall(CC));
    NumBytes = CCInfo.getStackSize();
    let mut AdjStackDown: u32 = self.TII.getCallFrameSetupOpcode();
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(AdjStackDown)).addImm(NumBytes).addImm(0);
    for VA in ArgLocs {
        let mut ArgVal: *Value = CLI.OutVals[VA.getValNo()];
        let mut ArgVT: MVT = OutVTs[VA.getValNo()];
        let mut ArgReg: Register = self.getRegForValue(ArgVal);
        if !ArgReg.operator unsigned int() {
            return false;
        }
        match VA.getLocInfo() {
            Full => {
                break;
            },
            SExt => {
                let mut DestVT: MVT = VA.getLocVT();
                let mut SrcVT: MVT = ArgVT;
                ArgReg = self.emitIntExt(SrcVT, ArgReg, DestVT, false);
                if !ArgReg.operator unsigned int() {
                    return false;
                }
                break;
            },
            AExt => {
                ZExt;
            },
            _ => {
                llvm_unreachable_internal("Unknown arg promotion!", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 3060);
            },
        }
        if VA.isRegLoc() && !VA.needsCustom() {
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), VA.getLocReg()).addReg(ArgReg, RegState {}, 0);
            CLI.OutRegs.push(VA.getLocReg());
        } else if VA.needsCustom() {
            return false;
        } else {
            assert!(VA.isMemLoc(), "Assuming store on stack.");
            if isa(ArgVal) {
                continue;
            }
            let mut ArgSize: u32 = (ArgVT.getSizeInBits().operator unsigned long long() + 7) / 8;
            let mut BEAlign: u32 = 0;
            if ArgSize < 8 && !self.Subtarget.isLittleEndian() {
                BEAlign = 8 - ArgSize;
            }
            let mut Addr: Address = Address {};
            Addr.setKind(RegBase);
            Addr.setReg(SP);
            Addr.setOffset(VA.getLocMemOffset() + BEAlign);
            let mut Alignment: Align = self.DL.getABITypeAlign(ArgVal.getType());
            let mut MMO: *mut MachineMemOperand = self.FuncInfo.MF.getMachineMemOperand(getStack(*self.FuncInfo.MF, Addr.getOffset(), 0), MOStore, ArgVT.getStoreSize(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
            if !self.emitStore(ArgVT, ArgReg, Addr, MMO) {
                return false;
            }
        }
    }
    return true;
}

fn AArch64FastISel::finishCall(self, CLI: *mut CallLoweringInfo, NumBytes: u32) -> bool {
    let mut CC: ID = CLI.CallConv;
    let mut AdjStackUp: u32 = self.TII.getCallFrameDestroyOpcode();
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(AdjStackUp)).addImm(NumBytes).addImm(0);
    let mut RVLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
    let mut CCInfo: CCState = CCState { CC, false, *self.FuncInfo.MF, RVLocs, *self.Context, false };
    CCInfo.AnalyzeCallResult(CLI.Ins, self.CCAssignFnForCall(CC));
    let mut ResultReg: Register = self.FuncInfo.CreateRegs(CLI.RetTy, false);
    for let mut i: u32 = 0; i != RVLocs.len; i += 1 {
        let mut VA: *mut CCValAssign = RVLocs[i];
        let mut CopyVT: MVT = VA.getValVT();
        let mut CopyReg: Register = ResultReg.operator unsigned int() + i;
        if CopyVT.isVector() && !self.Subtarget.isLittleEndian() {
            return false;
        }
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), CopyReg).addReg(VA.getLocReg(), RegState {}, 0);
        CLI.InRegs.push(VA.getLocReg());
    }
    CLI.ResultReg = ResultReg;
    CLI.NumResultRegs = RVLocs.len;
    return true;
}

fn AArch64FastISel::fastLowerCall(self, CLI: *mut CallLoweringInfo) -> bool {
    let mut CC: ID = CLI.CallConv;
    let mut IsTailCall: bool = CLI.IsTailCall;
    let mut IsVarArg: bool = CLI.IsVarArg;
    let mut Callee: *Value = CLI.Callee;
    let mut Symbol: *mut MCSymbol = CLI.Symbol;
    if !Callee && !Symbol {
        return false;
    }
    if CLI.CB && CLI.CB.hasFnAttr(ReturnsTwice) && !self.Subtarget.noBTIAtReturnTwice() && self.MF.getInfo().branchTargetEnforcement() {
        return false;
    }
    if CLI.CB && CLI.CB.isIndirectCall() && CLI.CB.getOperandBundle(OB_kcfi) {
        return false;
    }
    if IsTailCall {
        return false;
    }
    if self.Subtarget.isTargetILP32() {
        return false;
    }
    let mut CM: Model = self.TM.getCodeModel();
    if CM != Large && !self.Subtarget.useSmallAddressing() {
        return false;
    }
    if CM == Large && !self.Subtarget.isTargetMachO() {
        return false;
    }
    if self.MF.getFunction().getParent().getRtLibUseGOT() {
        return false;
    }
    if IsVarArg {
        return false;
    }
    if self.Subtarget.isWindowsArm64EC() {
        return false;
    }
    for Flag in CLI.OutFlags {
        if Flag.isInReg() || Flag.isSRet() || Flag.isNest() || Flag.isByVal() || Flag.isSwiftSelf() || Flag.isSwiftAsync() || Flag.isSwiftError() {
            return false;
        }
    }
    let mut OutVTs: SmallVector<MVT, 16> = SmallVector<MVT, 16> {};
    let mut OrigTys: SmallVector<Type *, 16> = SmallVector<Type *, 16> {};
    OutVTs.reserve(CLI.OutVals.len);
    for Val in CLI.OutVals {
        let mut VT: MVT = MVT {};
        if !self.isTypeLegal(Val.getType(), VT) && !(VT == i1 || VT == i8 || VT == i16) {
            return false;
        }
        if VT.isVector() || VT.getSizeInBits().operator unsigned long long() > 64 {
            return false;
        }
        OutVTs.push(VT);
        OrigTys.push(Val.getType());
    }
    let mut Addr: Address = Address {};
    if Callee && !self.computeCallAddress(Callee, Addr) {
        return false;
    }
    if self.Subtarget.isTargetWindows() && Addr.getGlobalValue() && Addr.getGlobalValue().hasExternalWeakLinkage() {
        return false;
    }
    let mut NumBytes: u32 = 0;
    if !self.processCallArgs(CLI, OutVTs, OrigTys, NumBytes) {
        return false;
    }
    let mut RegInfo: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
    if RegInfo.isAnyArgRegReserved(*self.MF) {
        RegInfo.emitReservedArgRegCallError(*self.MF);
    }
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    if self.Subtarget.useSmallAddressing() {
        let mut II: *MCInstrDesc = self.TII.get(if Addr.getReg().operator unsigned int() { getBLRCallOpcode(*self.MF) } else { BL as u32 });
        MIB = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II);
        if Symbol {
            MIB.addSym(Symbol, 0);
        } else if Addr.getGlobalValue() {
            MIB.addGlobalAddress(Addr.getGlobalValue(), 0, 0);
        } else if Addr.getReg().operator unsigned int() {
            let mut Reg: Register = self.constrainOperandRegClass(II, Addr.getReg(), 0);
            MIB.addReg(Reg, RegState {}, 0);
        } else {
            return false;
        }
    } else {
        let mut CallReg: Register = 0;
        if Symbol {
            let mut ADRPReg: Register = self.createResultReg(&mut GPR64commonRegClass);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(ADRP), ADRPReg).addSym(Symbol, MO_GOT | MO_PAGE);
            CallReg = self.createResultReg(&mut GPR64RegClass);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(LDRXui), CallReg).addReg(ADRPReg, RegState {}, 0).addSym(Symbol, MO_GOT | MO_PAGEOFF | MO_NC);
        } else if Addr.getGlobalValue() {
            CallReg = self.materializeGV(Addr.getGlobalValue());
        } else if Addr.getReg().operator unsigned int() {
            CallReg = Addr.getReg();
        }
        if !CallReg.operator unsigned int() {
            return false;
        }
        let mut II: *MCInstrDesc = self.TII.get(getBLRCallOpcode(*self.MF));
        CallReg = self.constrainOperandRegClass(II, CallReg, 0);
        MIB = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II).addReg(CallReg, RegState {}, 0);
    }
    for Reg in CLI.OutRegs {
        MIB.addReg(Reg, Implicit, 0);
    }
    MIB.addRegMask(self.TRI.getCallPreservedMask(*self.FuncInfo.MF, CC));
    CLI.Call = MIB.operator llvm::MachineInstr *();
    return self.finishCall(CLI, NumBytes);
}

fn AArch64FastISel::isMemCpySmall(self, Len: u64, Alignment: MaybeAlign) -> bool {
    if Alignment {
        return Len / operator(Alignment).value() <= 4;
    } else {
        return Len < 32;
    }
}

fn AArch64FastISel::tryEmitSmallMemCpy(self, Dest: Address, Src: Address, Len: u64, Alignment: MaybeAlign) -> bool {
    if !self.isMemCpySmall(Len, Alignment) {
        return false;
    }
    let mut UnscaledOffset: i64 = 0;
    let mut OrigDest: Address = Dest;
    let mut OrigSrc: Address = Src;
    while Len {
        let mut VT: MVT = MVT {};
        if !Alignment || operator(Alignment) >= 8 {
            if Len >= 8 {
                VT = i64;
            } else if Len >= 4 {
                VT = i32;
            } else if Len >= 2 {
                VT = i16;
            } else {
                VT = i8;
            }
        } else {
            assert!(Alignment, "Alignment is set in this branch");
            if Len >= 4 && operator(Alignment) == 4 {
                VT = i32;
            } else if Len >= 2 && operator(Alignment) == 2 {
                VT = i16;
            } else {
                VT = i8;
            }
        }
        let mut ResultReg: Register = self.emitLoad(VT, VT, Src, true, null);
        if !ResultReg.operator unsigned int() {
            return false;
        }
        if !self.emitStore(VT, ResultReg, Dest, null) {
            return false;
        }
        let mut Size: i64 = VT.getSizeInBits().operator unsigned long long() / 8;
        Len -= Size;
        UnscaledOffset += Size;
        Dest.setOffset(OrigDest.getOffset() + UnscaledOffset);
        Src.setOffset(OrigSrc.getOffset() + UnscaledOffset);
    }
    return true;
}

fn AArch64FastISel::foldXALUIntrinsic(self, CC: *mut CondCode, I: *Instruction, Cond: *Value) -> bool {
    if !isa(Cond) {
        return false;
    }
    let mut EV: *ExtractValueInst const = cast(Cond);
    if !isa(EV.getAggregateOperand()) {
        return false;
    }
    let mut II: *IntrinsicInst const = cast(EV.getAggregateOperand());
    let mut RetVT: MVT = MVT {};
    let mut Callee: *Function = II.getCalledFunction();
    let mut RetTy: *mut Type = cast(Callee.getReturnType()).getTypeAtIndex(0);
    if !self.isTypeLegal(RetTy, RetVT) {
        return false;
    }
    if RetVT != i32 && RetVT != i64 {
        return false;
    }
    let mut LHS: *Value = II.getArgOperand(0);
    let mut RHS: *Value = II.getArgOperand(1);
    if isa(LHS) && !isa(RHS) && II.isCommutative() {
        swap(LHS, RHS);
    }
    let mut IID: ID = II.getIntrinsicID();
    match IID {
        _ => {
            break;
        },
        smul_with_overflow => {
            if dyn_cast(RHS) {
                C;
            } else if C.getValue() == 2 {
                IID = sadd_with_overflow;
            }
        },
        umul_with_overflow => {
            if dyn_cast(RHS) {
                C;
            } else if C.getValue() == 2 {
                IID = uadd_with_overflow;
            }
        },
    }
    let mut TmpCC: CondCode = zeroed();
    match IID {
        _ => {
            return false;
        },
        sadd_with_overflow => {
            ssub_with_overflow;
        },
        uadd_with_overflow => {
            TmpCC = HS;
        },
        usub_with_overflow => {
            TmpCC = LO;
        },
        smul_with_overflow => {
            umul_with_overflow;
        },
    }
    if !self.isValueAvailable(II) {
        return false;
    }
    let mut Start: const_iterator = I;
    let mut End: const_iterator = II;
    for let mut Itr: BasicBlock>, false, true> = prev(Start, 1); Itr != End; operator(Itr) {
        if !isa(Itr) {
            return false;
        }
        let mut EVI: *ExtractValueInst const = cast(Itr);
        if EVI.getAggregateOperand() != II {
            return false;
        }
    }
    CC = TmpCC;
    return true;
}

fn AArch64FastISel::fastLowerIntrinsicCall(self, II: *IntrinsicInst) -> bool {
    match II.getIntrinsicID() {
        _ => {
            return false;
        },
        frameaddress => {
            let mut MFI: *mut MachineFrameInfo = self.FuncInfo.MF.getFrameInfo();
            MFI.setFrameAddressIsTaken(true);
            let mut RegInfo: *AArch64RegisterInfo = self.Subtarget.getRegisterInfo();
            let mut FramePtr: Register = RegInfo.getFrameRegister(*(self.FuncInfo.MF));
            let mut SrcReg: Register = self.MRI.createVirtualRegister(&mut GPR64RegClass, "");
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), SrcReg).addReg(FramePtr, RegState {}, 0);
            let mut DestReg: Register = 0;
            let mut Depth: u32 = cast(II.getOperand(0)).getZExtValue();
            while Depth -= 1 {
                DestReg = self.fastEmitInst_ri(LDRXui, &mut GPR64RegClass, SrcReg, 0);
                assert!(DestReg.operator unsigned int(), "Unexpected LDR instruction emission failure.");
                SrcReg = DestReg;
            }
            self.updateValueMap(II, SrcReg, 1);
            return true;
        },
        sponentry => {
            let mut MFI: *mut MachineFrameInfo = self.FuncInfo.MF.getFrameInfo();
            let mut FI: i32 = MFI.CreateFixedObject(4, 0, false, false);
            let mut ResultReg: Register = self.createResultReg(&mut GPR64spRegClass);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(ADDXri), ResultReg).addFrameIndex(FI).addImm(0).addImm(0);
            self.updateValueMap(II, ResultReg, 1);
            return true;
        },
        memcpy => {
            memmove;
        },
        memset => {
            let mut MSI: *MemSetInst = cast(II);
            if MSI.isVolatile() {
                return false;
            }
            if !MSI.getLength().getType().isIntegerTy(64) {
                return false;
            }
            if MSI.getDestAddressSpace() > 255 {
                return false;
            }
            return self.lowerCallTo(II, "memset", II.arg_size() - 1);
        },
        sin => {
            cos;
        },
        fabs => {
            let mut VT: MVT = MVT {};
            if !self.isTypeLegal(II.getType(), VT) {
                return false;
            }
            let mut Opc: u32 = 0;
            match VT.SimpleTy {
                _ => {
                    return false;
                },
                f32 => {
                    Opc = FABSSr;
                },
                f64 => {
                    Opc = FABSDr;
                },
            }
            let mut SrcReg: Register = self.getRegForValue(II.getOperand(0));
            if !SrcReg.operator unsigned int() {
                return false;
            }
            let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(VT, false));
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(Opc), ResultReg).addReg(SrcReg, RegState {}, 0);
            self.updateValueMap(II, ResultReg, 1);
            return true;
        },
        trap => {
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(BRK)).addImm(1);
        },
        debugtrap => {
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(BRK)).addImm(61440);
        },
        sqrt => {
            let mut RetTy: *mut Type = II.getCalledFunction().getReturnType();
            let mut VT: MVT = MVT {};
            if !self.isTypeLegal(RetTy, VT) {
                return false;
            }
            let mut Op0Reg: Register = self.getRegForValue(II.getOperand(0));
            if !Op0Reg.operator unsigned int() {
                return false;
            }
            let mut ResultReg: Register = self.fastEmit_r(VT, VT, FSQRT, Op0Reg);
            if !ResultReg.operator unsigned int() {
                return false;
            }
            self.updateValueMap(II, ResultReg, 1);
            return true;
        },
        sadd_with_overflow => {
            uadd_with_overflow;
        },
        aarch64_crc32b => {
            aarch64_crc32h;
        },
    }
    return false;
}

fn AArch64FastISel::selectRet(self, I: *Instruction) -> bool {
    let mut Ret: *ReturnInst = cast(I);
    let mut F: *Function = *I.getParent().getParent();
    if !self.FuncInfo.CanLowerReturn {
        return false;
    }
    if self.FuncInfo.MF.getInfo().getSRetReturnReg() {
        return false;
    }
    if F.isVarArg() {
        return false;
    }
    if self.TLI.supportSwiftError() && F.getAttributes().hasAttrSomewhere(SwiftError, null) {
        return false;
    }
    if self.TLI.supportSplitCSR(self.FuncInfo.MF) {
        return false;
    }
    let mut RetRegs: SmallVector<Register, 4> = SmallVector<Register, 4> {};
    if Ret.getNumOperands() > 0 {
        let mut CC: ID = F.getCallingConv();
        let mut Outs: OutputArg, 4> = OutputArg, 4> {};
        GetReturnInfo(CC, F.getReturnType(), F.getAttributes(), Outs, self.TLI, self.DL);
        let mut ValLocs: SmallVector<CCValAssign, 16> = SmallVector<CCValAssign, 16> {};
        let mut CCInfo: CCState = CCState { CC, F.isVarArg(), *self.FuncInfo.MF, ValLocs, I.getContext(), false };
        CCInfo.AnalyzeReturn(Outs, RetCC_AArch64_AAPCS);
        if ValLocs.len != 1 {
            return false;
        }
        let mut VA: *mut CCValAssign = ValLocs[0];
        let mut RV: *Value = Ret.getOperand(0);
        if (VA.getLocInfo() != Full) && (VA.getLocInfo() != BCvt) {
            return false;
        }
        if !VA.isRegLoc() {
            return false;
        }
        let mut Reg: Register = self.getRegForValue(RV);
        if !Reg.operator unsigned int() {
            return false;
        }
        let mut SrcReg: Register = Reg.operator unsigned int() + VA.getValNo();
        let mut DestReg: Register = VA.getLocReg();
        if !self.MRI.getRegClass(SrcReg).contains(DestReg.operator MCRegister()) {
            return false;
        }
        let mut RVEVT: EVT = self.TLI.getValueType(self.DL, RV.getType(), false);
        if !RVEVT.isSimple() {
            return false;
        }
        if RVEVT.isVector() && RVEVT.getVectorElementCount().isVector() && !self.Subtarget.isLittleEndian() {
            return false;
        }
        let mut RVVT: MVT = RVEVT.getSimpleVT();
        if RVVT == f128 {
            return false;
        }
        let mut DestVT: MVT = VA.getValVT();
        if RVVT != DestVT {
            if RVVT != i1 && RVVT != i8 && RVVT != i16 {
                return false;
            }
            if !Outs[0].Flags.isZExt() && !Outs[0].Flags.isSExt() {
                return false;
            }
            let mut IsZExt: bool = Outs[0].Flags.isZExt();
            SrcReg = self.emitIntExt(RVVT, SrcReg, DestVT, IsZExt);
            if !SrcReg.operator unsigned int() {
                return false;
            }
        }
        if self.Subtarget.isTargetILP32() && RV.getType().isPointerTy() {
            SrcReg = self.emitAnd_ri(i64, SrcReg, 4294967295);
        }
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), DestReg).addReg(SrcReg, RegState {}, 0);
        RetRegs.push(VA.getLocReg());
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(RET_ReallyLR));
    for RetReg in RetRegs {
        MIB.addReg(RetReg, Implicit, 0);
    }
    return true;
}

fn AArch64FastISel::selectTrunc(self, I: *Instruction) -> bool {
    let mut DestTy: *mut Type = I.getType();
    let mut Op: *mut Value = I.getOperand(0);
    let mut SrcTy: *mut Type = Op.getType();
    let mut SrcEVT: EVT = self.TLI.getValueType(self.DL, SrcTy, true);
    let mut DestEVT: EVT = self.TLI.getValueType(self.DL, DestTy, true);
    if !SrcEVT.isSimple() {
        return false;
    }
    if !DestEVT.isSimple() {
        return false;
    }
    let mut SrcVT: MVT = SrcEVT.getSimpleVT();
    let mut DestVT: MVT = DestEVT.getSimpleVT();
    if SrcVT != i64 && SrcVT != i32 && SrcVT != i16 && SrcVT != i8 {
        return false;
    }
    if DestVT != i32 && DestVT != i16 && DestVT != i8 && DestVT != i1 {
        return false;
    }
    let mut SrcReg: Register = self.getRegForValue(Op);
    if !SrcReg.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = 0;
    if SrcVT == i64 {
        let mut Mask: u64 = 0;
        match DestVT.SimpleTy {
            _ => {
                return false;
            },
            i1 => {
                Mask = 1;
            },
            i8 => {
                Mask = 255;
            },
            i16 => {
                Mask = 65535;
            },
        }
        let mut Reg32: Register = self.fastEmitInst_extractsubreg(i32, SrcReg, sub_32);
        ResultReg = self.emitAnd_ri(i32, Reg32, Mask);
        assert!(ResultReg.operator unsigned int(), "Unexpected AND instruction emission failure.");
    } else {
        ResultReg = self.createResultReg(&mut GPR32RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(SrcReg, RegState {}, 0);
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::emiti1Ext(self, SrcReg: Register, DestVT: MVT, IsZExt: bool) -> Register {
    assert!((DestVT == i8 || DestVT == i16 || DestVT == i32 || DestVT == i64), "Unexpected value type.");
    if DestVT == i8 || DestVT == i16 {
        DestVT = i32;
    }
    if IsZExt {
        let mut ResultReg: Register = self.emitAnd_ri(i32, SrcReg, 1);
        assert!(ResultReg.operator unsigned int(), "Unexpected AND instruction emission failure.");
        if DestVT == i64 {
            let mut Reg64: Register = self.MRI.createVirtualRegister(&mut GPR64RegClass, "");
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), Reg64).addReg(ResultReg, RegState {}, 0).addImm(sub_32);
            ResultReg = Reg64;
        }
        return ResultReg;
    } else {
        if DestVT == i64 {
            return Register { Reg: 0 };
        }
        return self.fastEmitInst_rii(SBFMWri, &mut GPR32RegClass, SrcReg, 0, 0);
    }
}

fn AArch64FastISel::emitMul_rr(self, RetVT: MVT, Op0: Register, Op1: Register) -> Register {
    let mut Opc: u32 = 0;
    let mut ZReg: Register = 0;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i8 => {
            i16;
        },
        i64 => {
            Opc = MADDXrrr;
        },
    }
    let mut RC: *TargetRegisterClass = if (RetVT == i64) { &mut GPR64RegClass } else { &mut GPR32RegClass };
    return self.fastEmitInst_rrr(Opc, RC, Op0, Op1, ZReg);
}

fn AArch64FastISel::emitSMULL_rr(self, RetVT: MVT, Op0: Register, Op1: Register) -> Register {
    if RetVT != i64 {
        return Register { Reg: 0 };
    }
    return self.fastEmitInst_rrr(SMADDLrrr, &mut GPR64RegClass, Op0, Op1, XZR);
}

fn AArch64FastISel::emitUMULL_rr(self, RetVT: MVT, Op0: Register, Op1: Register) -> Register {
    if RetVT != i64 {
        return Register { Reg: 0 };
    }
    return self.fastEmitInst_rrr(UMADDLrrr, &mut GPR64RegClass, Op0, Op1, XZR);
}

fn AArch64FastISel::emitLSL_rr(self, RetVT: MVT, Op0Reg: Register, Op1Reg: Register) -> Register {
    let mut Opc: u32 = 0;
    let mut NeedTrunc: bool = false;
    let mut Mask: u64 = 0;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i8 => {
            Opc = LSLVWr;
        },
        i16 => {
            Opc = LSLVWr;
        },
        i32 => {
            Opc = LSLVWr;
        },
        i64 => {
            Opc = LSLVXr;
        },
    }
    let mut RC: *TargetRegisterClass = if (RetVT == i64) { &mut GPR64RegClass } else { &mut GPR32RegClass };
    if NeedTrunc {
        Op1Reg = self.emitAnd_ri(i32, Op1Reg, Mask);
    }
    let mut ResultReg: Register = self.fastEmitInst_rr(Opc, RC, Op0Reg, Op1Reg);
    if NeedTrunc {
        ResultReg = self.emitAnd_ri(i32, ResultReg, Mask);
    }
    return ResultReg;
}

fn AArch64FastISel::emitLSL_ri(self, RetVT: MVT, SrcVT: MVT, Op0: Register, Shift: u64, IsZExt: bool) -> Register {
    assert!(RetVT.SimpleTy >= SrcVT.SimpleTy, "Unexpected source/return type pair.");
    assert!((SrcVT == i1 || SrcVT == i8 || SrcVT == i16 || SrcVT == i32 || SrcVT == i64), "Unexpected source value type.");
    assert!((RetVT == i8 || RetVT == i16 || RetVT == i32 || RetVT == i64), "Unexpected return value type.");
    let mut Is64Bit: bool = (RetVT == i64);
    let mut RegSize: u32 = if Is64Bit { 64 } else { 32 };
    let mut DstBits: u32 = RetVT.getSizeInBits().operator unsigned long long();
    let mut SrcBits: u32 = SrcVT.getSizeInBits().operator unsigned long long();
    let mut RC: *TargetRegisterClass = if Is64Bit { &mut GPR64RegClass } else { &mut GPR32RegClass };
    if Shift == 0 {
        if RetVT == SrcVT {
            let mut ResultReg: Register = self.createResultReg(RC);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(Op0, RegState {}, 0);
            return ResultReg;
        } else {
            return self.emitIntExt(SrcVT, Op0, RetVT, IsZExt);
        }
    }
    if Shift >= DstBits {
        return Register { Reg: 0 };
    }
    let mut ImmR: u32 = RegSize - Shift;
    let mut ImmS: u32 = if SrcBits - 1 < DstBits - 1 - Shift { SrcBits - 1 } else { DstBits - 1 - Shift };
    let mut OpcTable: [2]u32 = [[SBFMWri, SBFMXri], [UBFMWri, UBFMXri]];
    let mut Opc: u32 = OpcTable[IsZExt][Is64Bit];
    if SrcVT.SimpleTy <= i32 && RetVT == i64 {
        let mut TmpReg: Register = self.MRI.createVirtualRegister(RC, "");
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), TmpReg).addReg(Op0, RegState {}, 0).addImm(sub_32);
        Op0 = TmpReg;
    }
    return self.fastEmitInst_rii(Opc, RC, Op0, ImmR, ImmS);
}

fn AArch64FastISel::emitLSR_rr(self, RetVT: MVT, Op0Reg: Register, Op1Reg: Register) -> Register {
    let mut Opc: u32 = 0;
    let mut NeedTrunc: bool = false;
    let mut Mask: u64 = 0;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i8 => {
            Opc = LSRVWr;
        },
        i16 => {
            Opc = LSRVWr;
        },
        i32 => {
            Opc = LSRVWr;
        },
        i64 => {
            Opc = LSRVXr;
        },
    }
    let mut RC: *TargetRegisterClass = if (RetVT == i64) { &mut GPR64RegClass } else { &mut GPR32RegClass };
    if NeedTrunc {
        Op0Reg = self.emitAnd_ri(i32, Op0Reg, Mask);
        Op1Reg = self.emitAnd_ri(i32, Op1Reg, Mask);
    }
    let mut ResultReg: Register = self.fastEmitInst_rr(Opc, RC, Op0Reg, Op1Reg);
    if NeedTrunc {
        ResultReg = self.emitAnd_ri(i32, ResultReg, Mask);
    }
    return ResultReg;
}

fn AArch64FastISel::emitLSR_ri(self, RetVT: MVT, SrcVT: MVT, Op0: Register, Shift: u64, IsZExt: bool) -> Register {
    assert!(RetVT.SimpleTy >= SrcVT.SimpleTy, "Unexpected source/return type pair.");
    assert!((SrcVT == i1 || SrcVT == i8 || SrcVT == i16 || SrcVT == i32 || SrcVT == i64), "Unexpected source value type.");
    assert!((RetVT == i8 || RetVT == i16 || RetVT == i32 || RetVT == i64), "Unexpected return value type.");
    let mut Is64Bit: bool = (RetVT == i64);
    let mut RegSize: u32 = if Is64Bit { 64 } else { 32 };
    let mut DstBits: u32 = RetVT.getSizeInBits().operator unsigned long long();
    let mut SrcBits: u32 = SrcVT.getSizeInBits().operator unsigned long long();
    let mut RC: *TargetRegisterClass = if Is64Bit { &mut GPR64RegClass } else { &mut GPR32RegClass };
    if Shift == 0 {
        if RetVT == SrcVT {
            let mut ResultReg: Register = self.createResultReg(RC);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(Op0, RegState {}, 0);
            return ResultReg;
        } else {
            return self.emitIntExt(SrcVT, Op0, RetVT, IsZExt);
        }
    }
    if Shift >= DstBits {
        return Register { Reg: 0 };
    }
    if Shift >= SrcBits && IsZExt {
        return self.materializeInt(get(*self.Context, APInt { RegSize, 0, false, false }), RetVT);
    }
    if !IsZExt {
        Op0 = self.emitIntExt(SrcVT, Op0, RetVT, IsZExt);
        if !Op0.operator unsigned int() {
            return Register { Reg: 0 };
        }
        SrcVT = RetVT;
        SrcBits = SrcVT.getSizeInBits().operator unsigned long long();
        IsZExt = true;
    }
    let mut ImmR: u32 = if SrcBits - 1 < Shift { SrcBits - 1 } else { Shift };
    let mut ImmS: u32 = SrcBits - 1;
    let mut OpcTable: [2]u32 = [[SBFMWri, SBFMXri], [UBFMWri, UBFMXri]];
    let mut Opc: u32 = OpcTable[IsZExt][Is64Bit];
    if SrcVT.SimpleTy <= i32 && RetVT == i64 {
        let mut TmpReg: Register = self.MRI.createVirtualRegister(RC, "");
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), TmpReg).addReg(Op0, RegState {}, 0).addImm(sub_32);
        Op0 = TmpReg;
    }
    return self.fastEmitInst_rii(Opc, RC, Op0, ImmR, ImmS);
}

fn AArch64FastISel::emitASR_rr(self, RetVT: MVT, Op0Reg: Register, Op1Reg: Register) -> Register {
    let mut Opc: u32 = 0;
    let mut NeedTrunc: bool = false;
    let mut Mask: u64 = 0;
    match RetVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i8 => {
            Opc = ASRVWr;
        },
        i16 => {
            Opc = ASRVWr;
        },
        i32 => {
            Opc = ASRVWr;
        },
        i64 => {
            Opc = ASRVXr;
        },
    }
    let mut RC: *TargetRegisterClass = if (RetVT == i64) { &mut GPR64RegClass } else { &mut GPR32RegClass };
    if NeedTrunc {
        Op0Reg = self.emitIntExt(RetVT, Op0Reg, i32, false);
        Op1Reg = self.emitAnd_ri(i32, Op1Reg, Mask);
    }
    let mut ResultReg: Register = self.fastEmitInst_rr(Opc, RC, Op0Reg, Op1Reg);
    if NeedTrunc {
        ResultReg = self.emitAnd_ri(i32, ResultReg, Mask);
    }
    return ResultReg;
}

fn AArch64FastISel::emitASR_ri(self, RetVT: MVT, SrcVT: MVT, Op0: Register, Shift: u64, IsZExt: bool) -> Register {
    assert!(RetVT.SimpleTy >= SrcVT.SimpleTy, "Unexpected source/return type pair.");
    assert!((SrcVT == i1 || SrcVT == i8 || SrcVT == i16 || SrcVT == i32 || SrcVT == i64), "Unexpected source value type.");
    assert!((RetVT == i8 || RetVT == i16 || RetVT == i32 || RetVT == i64), "Unexpected return value type.");
    let mut Is64Bit: bool = (RetVT == i64);
    let mut RegSize: u32 = if Is64Bit { 64 } else { 32 };
    let mut DstBits: u32 = RetVT.getSizeInBits().operator unsigned long long();
    let mut SrcBits: u32 = SrcVT.getSizeInBits().operator unsigned long long();
    let mut RC: *TargetRegisterClass = if Is64Bit { &mut GPR64RegClass } else { &mut GPR32RegClass };
    if Shift == 0 {
        if RetVT == SrcVT {
            let mut ResultReg: Register = self.createResultReg(RC);
            BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(COPY), ResultReg).addReg(Op0, RegState {}, 0);
            return ResultReg;
        } else {
            return self.emitIntExt(SrcVT, Op0, RetVT, IsZExt);
        }
    }
    if Shift >= DstBits {
        return Register { Reg: 0 };
    }
    if Shift >= SrcBits && IsZExt {
        return self.materializeInt(get(*self.Context, APInt { RegSize, 0, false, false }), RetVT);
    }
    let mut ImmR: u32 = if SrcBits - 1 < Shift { SrcBits - 1 } else { Shift };
    let mut ImmS: u32 = SrcBits - 1;
    let mut OpcTable: [2]u32 = [[SBFMWri, SBFMXri], [UBFMWri, UBFMXri]];
    let mut Opc: u32 = OpcTable[IsZExt][Is64Bit];
    if SrcVT.SimpleTy <= i32 && RetVT == i64 {
        let mut TmpReg: Register = self.MRI.createVirtualRegister(RC, "");
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), TmpReg).addReg(Op0, RegState {}, 0).addImm(sub_32);
        Op0 = TmpReg;
    }
    return self.fastEmitInst_rii(Opc, RC, Op0, ImmR, ImmS);
}

fn AArch64FastISel::emitIntExt(self, SrcVT: MVT, SrcReg: Register, DestVT: MVT, IsZExt: bool) -> Register {
    assert!(DestVT != i1, "ZeroExt/SignExt an i1?");
    if ((DestVT != i8) && (DestVT != i16) && (DestVT != i32) && (DestVT != i64)) || ((SrcVT != i1) && (SrcVT != i8) && (SrcVT != i16) && (SrcVT != i32)) {
        return Register { Reg: 0 };
    }
    let mut Opc: u32 = 0;
    let mut Imm: u32 = 0;
    match SrcVT.SimpleTy {
        _ => {
            return Register { Reg: 0 };
        },
        i1 => {
            return self.emiti1Ext(SrcReg, DestVT, IsZExt);
        },
        i8 => {
            if DestVT == i64 {
                Opc = if IsZExt { UBFMXri } else { SBFMXri };
            } else {
                Opc = if IsZExt { UBFMWri } else { SBFMWri };
            }
        },
        i16 => {
            if DestVT == i64 {
                Opc = if IsZExt { UBFMXri } else { SBFMXri };
            } else {
                Opc = if IsZExt { UBFMWri } else { SBFMWri };
            }
        },
        i32 => {
            assert!(DestVT == i64, "IntExt i32 to i32?!?");
        },
    }
    if DestVT == i8 || DestVT == i16 {
        DestVT = i32;
    } else if DestVT == i64 {
        let mut Src64: Register = self.MRI.createVirtualRegister(&mut GPR64RegClass, "");
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), Src64).addReg(SrcReg, RegState {}, 0).addImm(sub_32);
        SrcReg = Src64;
    }
    let mut RC: *TargetRegisterClass = if (DestVT == i64) { &mut GPR64RegClass } else { &mut GPR32RegClass };
    return self.fastEmitInst_rii(Opc, RC, SrcReg, 0, Imm);
}

fn AArch64FastISel::optimizeIntExtLoad(self, I: *Instruction, RetVT: MVT, SrcVT: MVT) -> bool {
    let mut LI: *LoadInst const = dyn_cast(I.getOperand(0));
    if !LI || !LI.hasOneUse() {
        return false;
    }
    let mut Reg: Register = self.lookUpRegForValue(LI);
    if !Reg.operator unsigned int() {
        return false;
    }
    let mut MI: *mut MachineInstr = self.MRI.getUniqueVRegDef(Reg);
    if !MI {
        return false;
    }
    let mut IsZExt: bool = isa(I);
    let mut LoadMI: *MachineInstr = MI;
    if LoadMI.getOpcode() == COPY && LoadMI.getOperand(1).getSubReg() == sub_32 {
        let mut LoadReg: Register = MI.getOperand(1).getReg();
        LoadMI = self.MRI.getUniqueVRegDef(LoadReg);
        assert!(LoadMI, "Expected valid instruction");
    }
    if !(IsZExt && isZExtLoad(*LoadMI)) && !(!IsZExt && isSExtLoad(*LoadMI)) {
        return false;
    }
    if RetVT != i64 || SrcVT > i32 {
        self.updateValueMap(I, Reg, 1);
        return true;
    }
    if IsZExt {
        let mut Reg64: Register = self.createResultReg(&mut GPR64RegClass);
        BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), Reg64).addReg(Reg, getKillRegState(true), 0).addImm(sub_32);
        Reg = Reg64;
    } else {
        assert!((MI.getOpcode() == COPY && MI.getOperand(1).getSubReg() == sub_32), "Expected copy instruction");
        Reg = MI.getOperand(1).getReg();
        let mut I: iterator = MI;
        self.removeDeadCode(I, next(I, 1));
    }
    self.updateValueMap(I, Reg, 1);
    return true;
}

fn AArch64FastISel::selectIntExt(self, I: *Instruction) -> bool {
    assert!((isa(I) || isa(I)), "Unexpected integer extend instruction.");
    let mut RetVT: MVT = MVT {};
    let mut SrcVT: MVT = MVT {};
    if !self.isTypeSupported(I.getType(), RetVT, false) {
        return false;
    }
    if !self.isTypeSupported(I.getOperand(0).getType(), SrcVT, false) {
        return false;
    }
    if self.optimizeIntExtLoad(I, RetVT, SrcVT) {
        return true;
    }
    let mut SrcReg: Register = self.getRegForValue(I.getOperand(0));
    if !SrcReg.operator unsigned int() {
        return false;
    }
    let mut IsZExt: bool = isa(I);
    if dyn_cast(I.getOperand(0)) {
        Arg;
    } else {
        if (IsZExt && Arg.hasZExtAttr()) || (!IsZExt && Arg.hasSExtAttr()) {
            if RetVT == i64 && SrcVT != i64 {
                let mut ResultReg: Register = self.createResultReg(&mut GPR64RegClass);
                BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(SUBREG_TO_REG), ResultReg).addReg(SrcReg, RegState {}, 0).addImm(sub_32);
                SrcReg = ResultReg;
            }
            self.updateValueMap(I, SrcReg, 1);
            return true;
        }
    }
    let mut ResultReg: Register = self.emitIntExt(SrcVT, SrcReg, RetVT, IsZExt);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectRem(self, I: *Instruction, ISDOpcode: u32) -> bool {
    let mut DestEVT: EVT = self.TLI.getValueType(self.DL, I.getType(), true);
    if !DestEVT.isSimple() {
        return false;
    }
    let mut DestVT: MVT = DestEVT.getSimpleVT();
    if DestVT != i64 && DestVT != i32 {
        return false;
    }
    let mut DivOpc: u32 = 0;
    let mut Is64bit: bool = (DestVT == i64);
    match ISDOpcode {
        _ => {
            return false;
        },
        SREM => {
            DivOpc = if Is64bit { SDIVXr } else { SDIVWr };
        },
        UREM => {
            DivOpc = if Is64bit { UDIVXr } else { UDIVWr };
        },
    }
    let mut MSubOpc: u32 = if Is64bit { MSUBXrrr } else { MSUBWrrr };
    let mut Src0Reg: Register = self.getRegForValue(I.getOperand(0));
    if !Src0Reg.operator unsigned int() {
        return false;
    }
    let mut Src1Reg: Register = self.getRegForValue(I.getOperand(1));
    if !Src1Reg.operator unsigned int() {
        return false;
    }
    let mut RC: *TargetRegisterClass = if (DestVT == i64) { &mut GPR64RegClass } else { &mut GPR32RegClass };
    let mut QuotReg: Register = self.fastEmitInst_rr(DivOpc, RC, Src0Reg, Src1Reg);
    assert!(QuotReg.operator unsigned int(), "Unexpected DIV instruction emission failure.");
    let mut ResultReg: Register = self.fastEmitInst_rrr(MSubOpc, RC, QuotReg, Src1Reg, Src0Reg);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectMul(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if !self.isTypeSupported(I.getType(), VT, true) {
        return false;
    }
    if VT.isVector() {
        return self.selectBinaryOp(I, MUL);
    }
    let mut Src0: *Value = I.getOperand(0);
    let mut Src1: *Value = I.getOperand(1);
    if dyn_cast(Src0) {
        C;
    } else if C.getValue().isPowerOf2() {
        swap(Src0, Src1);
    }
    if dyn_cast(Src1) {
        C;
    } else if C.getValue().isPowerOf2() {
        let mut ShiftVal: u64 = C.getValue().logBase2();
        let mut SrcVT: MVT = VT;
        let mut IsZExt: bool = true;
        if dyn_cast(Src0) {
            ZExt;
        } else {
            if !isIntExtFree(ZExt) {
                let mut VT: MVT = MVT {};
                if self.isValueAvailable(ZExt) && self.isTypeSupported(ZExt.getSrcTy(), VT, false) {
                    SrcVT = VT;
                    IsZExt = true;
                    Src0 = ZExt.getOperand(0);
                }
            }
        }
        let mut Src0Reg: Register = self.getRegForValue(Src0);
        if !Src0Reg.operator unsigned int() {
            return false;
        }
        let mut ResultReg: Register = self.emitLSL_ri(VT, SrcVT, Src0Reg, ShiftVal, IsZExt);
        if ResultReg.operator unsigned int() {
            self.updateValueMap(I, ResultReg, 1);
            return true;
        }
    }
    let mut Src0Reg: Register = self.getRegForValue(I.getOperand(0));
    if !Src0Reg.operator unsigned int() {
        return false;
    }
    let mut Src1Reg: Register = self.getRegForValue(I.getOperand(1));
    if !Src1Reg.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = self.emitMul_rr(VT, Src0Reg, Src1Reg);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectShift(self, I: *Instruction) -> bool {
    let mut RetVT: MVT = MVT {};
    if !self.isTypeSupported(I.getType(), RetVT, true) {
        return false;
    }
    if RetVT.isVector() {
        return self.selectOperator(I, I.getOpcode());
    }
    if dyn_cast(I.getOperand(1)) {
        C;
    } else {
        let mut ResultReg: Register = 0;
        let mut ShiftVal: u64 = C.getZExtValue();
        let mut SrcVT: MVT = RetVT;
        let mut IsZExt: bool = I.getOpcode() != AShr;
        let mut Op0: *Value = I.getOperand(0);
        if dyn_cast(Op0) {
            ZExt;
        } else {
            if !isIntExtFree(ZExt) {
                let mut TmpVT: MVT = MVT {};
                if self.isValueAvailable(ZExt) && self.isTypeSupported(ZExt.getSrcTy(), TmpVT, false) {
                    SrcVT = TmpVT;
                    IsZExt = true;
                    Op0 = ZExt.getOperand(0);
                }
            }
        }
        let mut Op0Reg: Register = self.getRegForValue(Op0);
        if !Op0Reg.operator unsigned int() {
            return false;
        }
        match I.getOpcode() {
            _ => {
                llvm_unreachable_internal("Unexpected instruction.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 4718);
            },
            Shl => {
                ResultReg = self.emitLSL_ri(RetVT, SrcVT, Op0Reg, ShiftVal, IsZExt);
            },
            AShr => {
                ResultReg = self.emitASR_ri(RetVT, SrcVT, Op0Reg, ShiftVal, IsZExt);
            },
            LShr => {
                ResultReg = self.emitLSR_ri(RetVT, SrcVT, Op0Reg, ShiftVal, IsZExt);
            },
        }
        if !ResultReg.operator unsigned int() {
            return false;
        }
        self.updateValueMap(I, ResultReg, 1);
        return true;
    }
    let mut Op0Reg: Register = self.getRegForValue(I.getOperand(0));
    if !Op0Reg.operator unsigned int() {
        return false;
    }
    let mut Op1Reg: Register = self.getRegForValue(I.getOperand(1));
    if !Op1Reg.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = 0;
    match I.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected instruction.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 4746);
        },
        Shl => {
            ResultReg = self.emitLSL_rr(RetVT, Op0Reg, Op1Reg);
        },
        AShr => {
            ResultReg = self.emitASR_rr(RetVT, Op0Reg, Op1Reg);
        },
        LShr => {
            ResultReg = self.emitLSR_rr(RetVT, Op0Reg, Op1Reg);
        },
    }
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectBitCast(self, I: *Instruction) -> bool {
    let mut RetVT: MVT = MVT {};
    let mut SrcVT: MVT = MVT {};
    if !self.isTypeLegal(I.getOperand(0).getType(), SrcVT) {
        return false;
    }
    if !self.isTypeLegal(I.getType(), RetVT) {
        return false;
    }
    let mut Opc: u32 = 0;
    if RetVT == f32 && SrcVT == i32 {
        Opc = FMOVWSr;
    } else if RetVT == f64 && SrcVT == i64 {
        Opc = FMOVXDr;
    } else if RetVT == i32 && SrcVT == f32 {
        Opc = FMOVSWr;
    } else if RetVT == i64 && SrcVT == f64 {
        Opc = FMOVDXr;
    } else {
        return false;
    }
    let mut RC: *TargetRegisterClass = null;
    match RetVT.SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected value type.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 4787);
        },
        i32 => {
            RC = &mut GPR32RegClass;
        },
        i64 => {
            RC = &mut GPR64RegClass;
        },
        f32 => {
            RC = &mut FPR32RegClass;
        },
        f64 => {
            RC = &mut FPR64RegClass;
        },
    }
    let mut Op0Reg: Register = self.getRegForValue(I.getOperand(0));
    if !Op0Reg.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = self.fastEmitInst_r(Opc, RC, Op0Reg);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectFRem(self, I: *Instruction) -> bool {
    let mut RetVT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), RetVT) {
        return false;
    }
    let mut LCImpl: LibcallImpl = self.LibcallLowering.getLibcallImpl(getREM(RetVT));
    if LCImpl == Unsupported {
        return false;
    }
    let mut Args: ArgListTy = ArgListTy {};
    Args.reserve(I.getNumOperands());
    for Arg in I.operands() {
        Args.push(Arg);
    }
    let mut CLI: CallLoweringInfo = CallLoweringInfo {};
    let mut Ctx: *mut MCContext = self.MF.getContext();
    let mut CC: ID = self.LibcallLowering.getLibcallImplCallingConv(LCImpl);
    let mut FuncName: str = getLibcallImplName(LCImpl);
    CLI.setCallee(self.DL, Ctx, CC, I.getType(), FuncName, move(Args), ~0);
    if !self.lowerCallTo(CLI) {
        return false;
    }
    self.updateValueMap(I, CLI.ResultReg, 1);
    return true;
}

fn AArch64FastISel::selectSDiv(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(I.getType(), VT) {
        return false;
    }
    if !isa(I.getOperand(1)) {
        return self.selectBinaryOp(I, SDIV);
    }
    let mut C: *APInt = cast(I.getOperand(1)).getValue();
    if (VT != i32 && VT != i64) || operator(C) || !(C.isPowerOf2() || C.isNegatedPowerOf2()) {
        return self.selectBinaryOp(I, SDIV);
    }
    let mut Lg2: u32 = C.countr_zero();
    let mut Src0Reg: Register = self.getRegForValue(I.getOperand(0));
    if !Src0Reg.operator unsigned int() {
        return false;
    }
    if cast(I).isExact() {
        let mut ResultReg: Register = self.emitASR_ri(VT, VT, Src0Reg, Lg2, false);
        if !ResultReg.operator unsigned int() {
            return false;
        }
        self.updateValueMap(I, ResultReg, 1);
        return true;
    }
    let mut Pow2MinusOne: i64 = (1 << Lg2) - 1;
    let mut AddReg: Register = self.emitAdd_ri_(VT, Src0Reg, Pow2MinusOne);
    if !AddReg.operator unsigned int() {
        return false;
    }
    if !self.emitICmp_ri(VT, Src0Reg, 0) {
        return false;
    }
    let mut SelectOpc: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    if VT == i64 {
        SelectOpc = CSELXr;
        RC = &mut GPR64RegClass;
    } else {
        SelectOpc = CSELWr;
        RC = &mut GPR32RegClass;
    }
    let mut SelectReg: Register = self.fastEmitInst_rri(SelectOpc, RC, AddReg, Src0Reg, LT);
    if !SelectReg.operator unsigned int() {
        return false;
    }
    let mut ZeroReg: Register = if (VT == i64) { XZR } else { WZR };
    let mut ResultReg: Register = 0;
    if C.isNegative() {
        ResultReg = self.emitAddSub_rs(false, VT, ZeroReg, SelectReg, ASR, Lg2, false, true);
    } else {
        ResultReg = self.emitASR_ri(VT, VT, SelectReg, Lg2, false);
    }
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn AArch64FastISel::getRegForGEPIndex(self, Idx: *Value) -> Register {
    let mut IdxN: Register = self.getRegForValue(Idx);
    if !IdxN.operator unsigned int() {
        return Register { Reg: 0 };
    }
    let mut PtrVT: MVT = self.TLI.getPointerTy(self.DL, 0);
    let mut IdxVT: EVT = getEVT(Idx.getType(), false);
    if IdxVT.bitsLT(PtrVT) {
        IdxN = self.emitIntExt(IdxVT.getSimpleVT(), IdxN, PtrVT, false);
    } else if IdxVT.bitsGT(PtrVT) {
        llvm_unreachable_internal("AArch64 FastISel doesn't support types larger than i64", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FastISel.cpp", 4915);
    }
    return IdxN;
}

fn AArch64FastISel::selectGetElementPtr(self, I: *Instruction) -> bool {
    if self.Subtarget.isTargetILP32() {
        return false;
    }
    let mut N: Register = self.getRegForValue(I.getOperand(0));
    if !N.operator unsigned int() {
        return false;
    }
    let mut TotalOffs: u64 = 0;
    let mut VT: MVT = self.TLI.getPointerTy(self.DL, 0);
    for let mut GTI: gep_type_iterator = gep_type_begin(I);
let mut E: gep_type_iterator = gep_type_end(I); GTI != E; operator(GTI) {
        let mut Idx: *Value = GTI.getOperand();
        if GTI.getStructTypeOrNull() {
            StTy;
        } else {
            let mut Field: u32 = cast(Idx).getZExtValue();
            if Field {
                TotalOffs += self.DL.getStructLayout(StTy).getElementOffset(Field).operator unsigned long long();
            }
        }
    }
    if TotalOffs {
        N = self.emitAdd_ri_(VT, N, TotalOffs);
        if !N.operator unsigned int() {
            return false;
        }
    }
    self.updateValueMap(I, N, 1);
    return true;
}

fn AArch64FastISel::selectAtomicCmpXchg(self, I: *AtomicCmpXchgInst) -> bool {
    assert!(self.TM.getOptLevel() == None, "cmpxchg survived AtomicExpand at optlevel > -O0");
    let mut RetPairTy: *mut StructType = cast(I.getType());
    let mut RetTy: *mut Type = RetPairTy.getTypeAtIndex(0);
    assert!(RetPairTy.getTypeAtIndex(1).isIntegerTy(1), "cmpxchg has a non-i1 status result");
    let mut VT: MVT = MVT {};
    if !self.isTypeLegal(RetTy, VT) {
        return false;
    }
    let mut ResRC: *TargetRegisterClass = null;
    let mut Opc: u32 = 0;
    let mut CmpOpc: u32 = 0;
    if VT == i32 {
        Opc = CMP_SWAP_32;
        CmpOpc = SUBSWrs;
        ResRC = &mut GPR32RegClass;
    } else if VT == i64 {
        Opc = CMP_SWAP_64;
        CmpOpc = SUBSXrs;
        ResRC = &mut GPR64RegClass;
    } else {
        return false;
    }
    let mut II: *MCInstrDesc = self.TII.get(Opc);
    let mut AddrReg: Register = self.getRegForValue(I.getPointerOperand());
    let mut DesiredReg: Register = self.getRegForValue(I.getCompareOperand());
    let mut NewReg: Register = self.getRegForValue(I.getNewValOperand());
    if !AddrReg.operator unsigned int() || !DesiredReg.operator unsigned int() || !NewReg.operator unsigned int() {
        return false;
    }
    AddrReg = self.constrainOperandRegClass(II, AddrReg, II.getNumDefs());
    DesiredReg = self.constrainOperandRegClass(II, DesiredReg, II.getNumDefs() + 1);
    NewReg = self.constrainOperandRegClass(II, NewReg, II.getNumDefs() + 2);
    let mut ResultReg1: Register = self.createResultReg(ResRC);
    let mut ResultReg2: Register = self.createResultReg(&mut GPR32RegClass);
    let mut ScratchReg: Register = self.createResultReg(&mut GPR32RegClass);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, II).addDef(ResultReg1, RegState {}, 0).addDef(ScratchReg, RegState {}, 0).addUse(AddrReg, RegState {}, 0).addUse(DesiredReg, RegState {}, 0).addUse(NewReg, RegState {}, 0);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(CmpOpc)).addDef(if VT == i32 { WZR } else { XZR }, RegState {}, 0).addUse(ResultReg1, RegState {}, 0).addUse(DesiredReg, RegState {}, 0).addImm(0);
    BuildMI(*self.FuncInfo.MBB, self.FuncInfo.InsertPt, self.MIMD, self.TII.get(CSINCWr)).addDef(ResultReg2, RegState {}, 0).addUse(WZR, RegState {}, 0).addUse(WZR, RegState {}, 0).addImm(NE);
    assert!((ResultReg1.operator unsigned int() + 1) == ResultReg2.operator unsigned int(), "Nonconsecutive result registers.");
    self.updateValueMap(I, ResultReg1, 2);
    return true;
}

fn AArch64FastISel::fastSelectInstruction(self, I: *Instruction) -> bool {
    if self.TLI.fallBackToDAGISel(*I) {
        return false;
    }
    match I.getOpcode() {
        _ => {
            break;
        },
        Add => {
            Sub;
        },
        Mul => {
            return self.selectMul(I);
        },
        SDiv => {
            return self.selectSDiv(I);
        },
        SRem => {
            if !self.selectBinaryOp(I, SREM) {
                return self.selectRem(I, SREM);
            }
        },
        URem => {
            if !self.selectBinaryOp(I, UREM) {
                return self.selectRem(I, UREM);
            }
        },
        Shl => {
            LShr;
        },
        And => {
            Or;
        },
        CondBr => {
            return self.selectBranch(I);
        },
        IndirectBr => {
            return self.selectIndirectBr(I);
        },
        BitCast => {
            if !self.selectBitCast(I) {
                return self.selectBitCast(I);
            }
        },
        FPToSI => {
            if !self.selectCast(I, FP_TO_SINT) {
                return self.selectFPToInt(I, true);
            }
        },
        FPToUI => {
            return self.selectFPToInt(I, false);
        },
        ZExt => {
            SExt;
        },
        Trunc => {
            if !self.selectCast(I, TRUNCATE) {
                return self.selectTrunc(I);
            }
        },
        FPExt => {
            return self.selectFPExt(I);
        },
        FPTrunc => {
            return self.selectFPTrunc(I);
        },
        SIToFP => {
            if !self.selectCast(I, SINT_TO_FP) {
                return self.selectIntToFP(I, true);
            }
        },
        UIToFP => {
            return self.selectIntToFP(I, false);
        },
        Load => {
            return self.selectLoad(I);
        },
        Store => {
            return self.selectStore(I);
        },
        FCmp => {
            ICmp;
        },
        Select => {
            return self.selectSelect(I);
        },
        Ret => {
            return self.selectRet(I);
        },
        FRem => {
            return self.selectFRem(I);
        },
        GetElementPtr => {
            return self.selectGetElementPtr(I);
        },
        AtomicCmpXchg => {
            return self.selectAtomicCmpXchg(cast(I));
        },
    }
    return self.selectOperator(I, I.getOpcode());
}

fn createFastISel(FuncInfo: *mut FunctionLoweringInfo, LibInfo: *TargetLibraryInfo, LibcallLowering: *LibcallLoweringInfo) -> *mut FastISel {
    let mut CallerAttrs: SMEAttrs = FuncInfo.MF.getInfo().getSMEFnAttrs();
    if CallerAttrs.hasZAState() || CallerAttrs.hasZT0State() || CallerAttrs.hasStreamingInterfaceOrBody() || CallerAttrs.hasStreamingCompatibleInterface() || CallerAttrs.hasAgnosticZAInterface() {
        return null;
    }
    return AArch64FastISel { FuncInfo, LibInfo, LibcallLowering };
}
