    if !CondReg.operator unsigned int() {
        return false;
    }
    if  {
        return false;
    }
    let mut Opcode: u32 = 0;
    if  {
        swap(TBB, FBB);
    }
    let mut II: *MCInstrDesc = null;
    let mut ConstrainedCondReg: Register = self.constrainOperandRegClass;
    BuildMI(II)(ConstrainedCondReg)(0)(TBB);
    self.finishCondBranch(BI()(), TBB, FBB);
    return true;
}

