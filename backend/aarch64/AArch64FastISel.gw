fn AArch64FastISel::selectMul(self, I: *Instruction) -> bool {
    let mut VT: MVT = MVT {};
    if operator!(self.isTypeSupported(I.getType, VT, true)) {
        return false;
    }
    if VT.isVector() {
        return self.selectBinaryOp;
    }
    let mut Src0: *Value = I.getOperand;
    let mut Src1: *Value = I.getOperand;
    if  {
        if C()()() {
            swap(Src0, Src1);
        }
    }
    if  {
        if C()()() {
            let mut ShiftVal: u64 = ()();
            let mut SrcVT: MVT = VT;
            let mut IsZExt: bool = true;
            if  {
                if operator!(isIntExtFree()) {
                    let mut VT: MVT = MVT {};
                    if self.isValueAvailable() && self.isTypeSupported(VT) {
                        SrcVT = VT;
                        IsZExt = true;
                        Src0 = (0);
                    }
                }
            } else if  {
                if operator!(isIntExtFree()) {
                    let mut VT: MVT = MVT {};
                    if self.isValueAvailable() && self.isTypeSupported(VT) {
                        SrcVT = VT;
                        IsZExt = false;
                        Src0 = (0);
                    }
