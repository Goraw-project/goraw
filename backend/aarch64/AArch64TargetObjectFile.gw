static mut EmitAArch64DebugTLSLocation: i32 = "aarch64-emit-debug-tls-location";

fn AArch64_ELFTargetObjectFile::Initialize(self, Ctx: *mut MCContext, TM: *TargetMachine) {
    self.Initialize;
    if TM.getMCSubtargetInfo().hasFeature {
        let mut Text: *mut auto = null;
        Text()(() | SHF_AARCH64_PURECODE);
    }
}

fn AArch64_ELFTargetObjectFile::emitPersonalityValueImpl(self: *AArch64_ELFTargetObjectFile, Streamer: *mut MCStreamer, DL: *DataLayout, Sym: *MCSymbol, MMI: *MachineModuleInfo) {
    if operator!(MMI()) {
        self.emitPersonalityValueImpl;
        return;
    }
    let mut TS: *mut auto = null;
    let mut Discriminator: u16 = 32429;
    TS()(create(Sym, self.getContext), Discriminator, IA, true);
}

fn AArch64_ELFTargetObjectFile::getIndirectSymViaGOTPCRel(self: *AArch64_ELFTargetObjectFile, GV: *GlobalValue, Sym: *MCSymbol, MV: *MCValue, Offset: i64, MMI: *mut MachineModuleInfo, Streamer: *mut MCStreamer) -> *MCExpr {
    let mut Ctx: *mut auto = self.getContext;
    let mut Res: *MCExpr = create(Sym);
    if Offset + MV.getConstant() {
        FinalOffset;
    } else {
        Res = createAdd(Res, create(FinalOffset));
    }
    return create(Res, S_GOTPCREL);
}

fn AArch64_MachoTargetObjectFile::getTTypeGlobalReference(self: *AArch64_MachoTargetObjectFile, GV: *GlobalValue, Encoding: u32, TM: *TargetMachine, MMI: *mut MachineModuleInfo, Streamer: *mut MCStreamer) -> *MCExpr {
    if Encoding & (DW_EH_PE_indirect | DW_EH_PE_pcrel) {
        let mut Sym: *MCSymbol = TM.getSymbol(GV);
        let mut Res: *MCExpr = create(Sym, S_MACHO_GOT, self.getContext);
        let mut PCSym: *mut MCSymbol = self.getContext();
        Streamer.emitLabel(PCSym, SMLoc {});
        let mut PC: *MCExpr = create(PCSym, self.getContext);
        return createSub(Res, PC, self.getContext);
    }
    return self.getTTypeGlobalReference;
}

fn AArch64_MachoTargetObjectFile::getCFIPersonalitySymbol(self: *AArch64_MachoTargetObjectFile, GV: *GlobalValue, TM: *TargetMachine, MMI: *mut MachineModuleInfo) -> *mut MCSymbol {
    return TM.getSymbol(GV);
}

fn AArch64_MachoTargetObjectFile::getIndirectSymViaGOTPCRel(self: *AArch64_MachoTargetObjectFile, GV: *GlobalValue, Sym: *MCSymbol, MV: *MCValue, Offset: i64, MMI: *mut MachineModuleInfo, Streamer: *mut MCStreamer) -> *MCExpr {
    assert!((Offset + MV.getConstant() == 0), "Arch64 does not support GOT PC rel with extra offset");
    let mut Res: *MCExpr = create(Sym, S_MACHO_GOT, self.getContext);
    let mut PCSym: *mut MCSymbol = self.getContext();
    Streamer.emitLabel(PCSym, SMLoc {});
    let mut PC: *MCExpr = create(PCSym, self.getContext);
    return createSub(Res, PC, self.getContext);
}

fn AArch64_MachoTargetObjectFile::getNameWithPrefix(self: *AArch64_MachoTargetObjectFile, OutName: *mut SmallVectorImpl<char>, GV: *GlobalValue, TM: *TargetMachine) {
    self.getMangler(OutName, GV, true);
}

