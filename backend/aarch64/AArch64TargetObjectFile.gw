fn AArch64_ELFTargetObjectFile::getAuthPtrSlotSymbol(self: *AArch64_ELFTargetObjectFile, TM: *TargetMachine, MMI: *mut MachineModuleInfo, RawSym: *MCSymbol, Key: ID, Discriminator: u16) -> *mut MCSymbol {
    let mut ELFMMI: *mut MachineModuleInfoELF = MMI.getObjFileInfo();
    return getAuthPtrSlotSymbolHelper(self.getContext(), TM, MMI, ELFMMI, RawSym, Key, Discriminator);
}

fn AArch64_MachoTargetObjectFile::getAuthPtrSlotSymbol(self: *AArch64_MachoTargetObjectFile, TM: *TargetMachine, MMI: *mut MachineModuleInfo, RawSym: *MCSymbol, Key: ID, Discriminator: u16) -> *mut MCSymbol {
    let mut MachOMMI: *mut MachineModuleInfoMachO = MMI.getObjFileInfo();
    return getAuthPtrSlotSymbolHelper(self.getContext(), TM, MMI, MachOMMI, RawSym, Key, Discriminator);
}

fn isExecuteOnlyFunction(GO: *GlobalObject, Kind: SectionKind, TM: *TargetMachine) -> bool {
    if dyn_cast(GO) {
        F;
    } else if TM.getSubtarget(*F).genExecuteOnly() && Kind.isText() {
        return true;
    }
    return false;
}

fn AArch64_ELFTargetObjectFile::getExplicitSectionGlobal(self: *AArch64_ELFTargetObjectFile, GO: *GlobalObject, Kind: SectionKind, TM: *TargetMachine) -> *mut MCSection {
    if isExecuteOnlyFunction(GO, Kind, TM) {
        Kind = getExecuteOnly();
    }
    return self.getExplicitSectionGlobal(GO, Kind, TM);
}

fn AArch64_ELFTargetObjectFile::SelectSectionForGlobal(self: *AArch64_ELFTargetObjectFile, GO: *GlobalObject, Kind: SectionKind, TM: *TargetMachine) -> *mut MCSection {
    if isExecuteOnlyFunction(GO, Kind, TM) {
        Kind = getExecuteOnly();
    }
    return self.SelectSectionForGlobal(GO, Kind, TM);
}

fn AArch64_ELFTargetObjectFile::getDebugThreadLocalSymbol(self: *AArch64_ELFTargetObjectFile, Sym: *MCSymbol) -> *MCExpr {
    return create(Sym, S_DTPREL, self.getContext(), SMLoc {});
}
