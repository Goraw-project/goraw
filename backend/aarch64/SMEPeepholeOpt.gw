static mut ID: i8 = 0;

fn isConditionalStartStop(MI: *MachineInstr) -> bool {}

fn isMatchingStartStopPair(MI1: *MachineInstr, MI2: *MachineInstr) -> bool {
    if MI1.getOperand(0).getImm() != MI2.getOperand(0).getImm() {
        return false;
    }
    if MI1.getOperand(1).getImm() == MI2.getOperand(1).getImm() {
        return false;
    }
    let mut IsConditional: bool = isConditionalStartStop(MI2);
    if isConditionalStartStop(MI1) != IsConditional {
        return false;
    }
    if !IsConditional {
        return true;
    }
    if MI1.getOperand(2).getImm() != MI2.getOperand(2).getImm() {
        return false;
    }
    if MI1.getOperand(4).getRegMask() != MI2.getOperand(4).getRegMask() {
        return false;
    }
    if MI1.getOperand(3).isReg() && MI2.getOperand(3).isReg() {
        let mut Reg1: Register = MI1.getOperand(3).getReg();
        let mut Reg2: Register = MI2.getOperand(3).getReg();
        if Reg1.isPhysical() || Reg2.isPhysical() || Reg1 != Reg2 {
            return false;
        }
    }
    return true;
}

fn ChangesStreamingMode(MI: *MachineInstr) -> bool {}

fn isSVERegOp(TRI: *TargetRegisterInfo, MRI: *MachineRegisterInfo, MO: *MachineOperand) -> bool {
    if !MO.isReg() {
        return false;
    }
    let mut R: Register = MO.getReg();
    if R.isPhysical() {
        return any_of(TRI()(R), Closure_1 {});
    }
    let mut RC: *TargetRegisterClass = MRI.getRegClass(R);
    return TRI.getCommonSubClass || TRI.getCommonSubClass;
}

fn SMEPeepholeOpt::optimizeStartStopPairs(self: *SMEPeepholeOpt, MBB: *mut MachineBasicBlock, HasRemovedAllSMChanges: *mut bool) -> bool {
    let mut MRI: *MachineRegisterInfo = MBB.getParent().getRegInfo();
    let mut TRI: *TargetRegisterInfo = *MBB.getParent().getSubtarget().getRegisterInfo();
    let mut Changed: bool = false;
    let mut Prev: *mut MachineInstr = null;
    let mut NumSMChanges: u32 = 0;
    let mut NumSMChangesRemoved: u32 = 0;
    HasRemovedAllSMChanges = NumSMChanges && (NumSMChanges == NumSMChangesRemoved);
    return Changed;
}

fn SMEPeepholeOpt::visitRegSequence(self, MI: *mut MachineInstr) -> bool {
    assert!(MI.getMF().getRegInfo().isSSA(), "Expected to be run on SSA form!");
    let mut MRI: *mut MachineRegisterInfo = MI.getMF().getRegInfo();
    match MRI.getRegClass(MI.getOperand(0).getReg()).getID() {
        _ => {
            return false;
        },
    }
    if MI.getNumOperands() != 5 && MI.getNumOperands() != 9 {
        return false;
    }
    let mut SubReg: MCRegister = NoRegister;
    for let mut I: u32 = 1; I < MI.getNumOperands(); I += 2 {
        let mut MO: *mut MachineOperand = MI.getOperand(I);
        let mut Def: *mut MachineOperand = MRI.getOneDef(MO.getReg());
        if !Def || !Def.getParent().isCopy() {
            return false;
        }
        let mut CopySrc: *MachineOperand = Def.getParent().getOperand(1);
        let mut OpSubReg: u32 = CopySrc.getSubReg();
        if SubReg == NoRegister {
            SubReg = OpSubReg;
        }
        let mut CopySrcOp: *mut MachineOperand = MRI.getOneDef(CopySrc.getReg());
        if !CopySrcOp || !CopySrcOp.isReg() || OpSubReg != SubReg.operator unsigned int() || CopySrcOp.getReg().isPhysical() {
            return false;
        }
        let mut CopySrcClass: *TargetRegisterClass = MRI.getRegClass(CopySrcOp.getReg());
        if  {
            return false;
        }
    }
    let mut Opc: u32 = 0;
    let mut TII: *TargetInstrInfo = MI.getMF()();
    let mut MIB: MachineInstrBuilder = BuildMI(*MI.getParent(), MI, MI.getDebugLoc(), TII.get, MI.getOperand(0).getReg());
    for let mut I: u32 = 1; I < MI.getNumOperands(); I += 2 {
        MIB()(MI.getOperand(I).getReg());
    }
    MI()();
    return true;
}

fn SMEPeepholeOpt::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction {
        return false;
    }
    let mut AFI: *mut AArch64FunctionInfo = MF;
    let mut SMEFnAttrs: SMEAttrs = AFI.getSMEFnAttrs();
    if operator!(MF()) && !SMEFnAttrs.hasStreamingCompatibleInterface() {
        return false;
    }
    assert!(MF.getRegInfo().isSSA(), "Expected to be run on SSA form!");
    let mut Changed: bool = false;
    let mut FunctionHasAllSMChangesRemoved: bool = false;
    if FunctionHasAllSMChangesRemoved {
        AFI.setHasStreamingModeChanges(false);
    }
    return Changed;
}

fn createSMEPeepholeOptPass() -> *mut FunctionPass {
    return SMEPeepholeOpt {};
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, SR: *MCPhysReg) {}
