fn expandFormTransposedRegTuple(MBB: *mut MachineBasicBlock, MI: *mut MachineInstr, LIS: *mut LiveIntervals) -> bool {
    let mut TII: *TargetInstrInfo = MBB.getParent().getSubtarget().getInstrInfo();
    let mut TupleSize: u32 = if MI.getOpcode() == FORM_TRANSPOSED_REG_TUPLE_X2_PSEUDO { 2 } else { 4 };
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut TupleReg: Register = MI.getOperand(0).getReg();
    let mut OrigRegs: SmallVector<Register, 5> = [TupleReg];
    let mut FirstCopyMBBI: iterator = iterator {};
    for let mut I: u32 = 0; I < TupleSize; I += 1 {
        let mut SrcOp: *mut MachineOperand = MI.getOperand(I + 1);
        OrigRegs.push(SrcOp.getReg());
        if SrcOp.isKill() {
            for let mut J: u32 = I + 2; J < MI.getNumOperands(); J += 1 {
                let mut LaterOp: *mut MachineOperand = MI.getOperand(J);
                if LaterOp.getReg() == SrcOp.getReg() {
                    LaterOp.setIsKill(true);
                    SrcOp.setIsKill(false);
                }
            }
        }
        let mut DefState: RegState = if I == 0 { Undef } else { NoFlags };
        let mut CopyMI: *mut MachineInstr = BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(COPY_INTO_TRANSPOSED_TUPLE)).addDef(TupleReg, DefState, zsub0 + I).add(SrcOp).addImm(TupleSize).operator llvm::MachineInstr *();
        if I == 0 {
            FirstCopyMBBI = CopyMI;
        }
    }
    let mut EndMBBI: iterator = next(MI.getIterator(), 1);
    if LIS {
        LIS.RemoveMachineInstrFromMaps(MI);
    }
    MI.eraseFromParent();
    if LIS {
        LIS.repairIntervalsInRange(&mut MBB, FirstCopyMBBI, EndMBBI, OrigRegs);
    }
    return true;
}

fn runAArch64PostCoalescer(MF: *mut MachineFunction, LIS: *mut LiveIntervals) -> bool {
    let mut FuncInfo: *mut AArch64FunctionInfo = MF.getInfo();
    if !FuncInfo.hasStreamingModeChanges() && !MF.getSubtarget().isStreaming() {
        return false;
    }
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    let mut Changed: bool = false;
    for MBB in MF {
        for MI in make_early_inc_range(MBB) {
            match MI.getOpcode() {
                _ => {
                    break;
                },
                FORM_TRANSPOSED_REG_TUPLE_X2_PSEUDO => {
                    FORM_TRANSPOSED_REG_TUPLE_X4_PSEUDO;
                },
                COALESCER_BARRIER_FPR16 => {
                    COALESCER_BARRIER_FPR32;
                },
            }
        }
    }
    return Changed;
}

struct AArch64PostCoalescerLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64PostCoalescerLegacy::getPassName(self: *AArch64PostCoalescerLegacy) -> str {
    return "AArch64 Post Coalescer pass";
}

fn AArch64PostCoalescerLegacy::getAnalysisUsage(self: *AArch64PostCoalescerLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU.addUsedIfAvailable();
    AU.addPreserved();
    AU.addPreserved();
    self.getAnalysisUsage(AU);
}

fn AArch64PostCoalescerLegacy::getPassKind(self: *AArch64PostCoalescerLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64PostCoalescerLegacy::getPassID(self: *AArch64PostCoalescerLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64PostCoalescerLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64PostCoalescerLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64PostCoalescerLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64PostCoalescerLegacy::getResolver(self: *AArch64PostCoalescerLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64PostCoalescerLegacy::getRequiredProperties(self: *AArch64PostCoalescerLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64PostCoalescerLegacy::getSetProperties(self: *AArch64PostCoalescerLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64PostCoalescerLegacy::getClearedProperties(self: *AArch64PostCoalescerLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn AArch64PostCoalescerLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    let mut LISWrapper: *mut LiveIntervalsWrapperPass = self.getAnalysisIfAvailable();
    let mut LIS: *mut LiveIntervals = if LISWrapper { &mut LISWrapper.getLIS() } else { null };
    return runAArch64PostCoalescer(MF, LIS);
}

fn AArch64PostCoalescerPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut LIS: *mut Result = MFAM.getCachedResult(MF);
    let mut Changed: bool = runAArch64PostCoalescer(MF, LIS);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    PA.preserve();
    PA.preserve();
    return PA;
}

fn createAArch64PostCoalescerPass() -> *mut FunctionPass {
    return AArch64PostCoalescerLegacy {};
}
