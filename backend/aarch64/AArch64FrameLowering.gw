struct Closure_11 {}

fn Closure_11::call(self: *Closure_11) {
        return A() < B();
    }

struct Closure_12 {}

fn Closure_12::call(self: *Closure_12) {}

struct Closure_13 {
    MFI: *mut MachineFrameInfo,
    ZPRStackTop: *mut u64,
    PPRStackTop: *mut u64,
    AssignOffsets: *mut AssignObjectOffsets,
}

unsafe fn Closure_13::call(self: *mut Closure_13, FI: i32) {
        let mut StackTop: *mut u64 = if (*self.MFI).getStackID(FI) == ScalableVector { (*self.ZPRStackTop) } else { (*self.PPRStackTop) };
        let mut Alignment: Align = (*self.MFI).getObjectAlign(FI);
        if Alignment > 16 {
            report_fatal_error("Alignment of scalable vectors > 16 bytes is not yet supported", true);
        }
        StackTop += (*self.MFI).getObjectSize(FI);
        StackTop = alignTo(StackTop, Alignment);
        assert!(StackTop < max() as u64, "SVE StackTop far too large?!");
        let mut Offset: i64 = -StackTop;
        if (*self.AssignOffsets) == Yes {
            (*self.MFI).setObjectOffset(FI, Offset);
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "alloc FI(" << FI << ") at SP[" << Offset << "]\n";
            }
        }
            if !(false) { break; }
        }
    }

struct Closure_14 {
    LiveRegs: *mut LivePhysRegs,
    MRI: *mut MachineRegisterInfo,
}

unsafe fn Closure_14::call(self: *mut Closure_14) {
        return (*self.LiveRegs).available((*self.MRI), Reg);
    }

struct Closure_15 {}

fn Closure_15::call(self: *Closure_15, Left: *TagStoreInstr, Right: *TagStoreInstr) -> bool {
        return Left.Offset < Right.Offset;
    }

struct Closure_16 {}

fn Closure_16::call(self: *Closure_16, S: *StackAccess) -> bool {
        return S.AccessTypes == NotAccessed;
    }

