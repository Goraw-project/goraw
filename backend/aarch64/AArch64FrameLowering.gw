static mut EnableRedZone: i32 = "aarch64-redzone";

static mut StackTaggingMergeSetTag: i32 = "stack-tagging-merge-settag";

static mut OrderFrameObjects: i32 = "aarch64-order-frame-objects";

static mut SplitSVEObjects: i32 = "aarch64-split-sve-objects";

static mut EnableHomogeneousPrologEpilog: i32 = "homogeneous-prolog-epilog";

static mut StackHazardRemarkSize: i32 = "aarch64-stack-hazard-remark-size";

static mut StackHazardInNonStreaming: i32 = "aarch64-stack-hazard-in-non-streaming";

static mut DisableMultiVectorSpillFill: i32 = "aarch64-disable-multivector-spill-fill";

fn AArch64FrameLowering::getArgumentStackToRestore(self: *AArch64FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock) -> i64 {
    let mut MBBI: iterator = MBB.getLastNonDebugInstr(true);
    let mut AFI: *mut AArch64FunctionInfo = MF;
    let mut IsTailCallReturn: bool = if (MBB.end() != MBBI) { isTailCallReturnInst(operator(MBBI)) } else { false };
    let mut ArgumentPopSize: i64 = 0;
    if IsTailCallReturn {
        let mut StackAdjust: *mut MachineOperand = operator(MBBI).getOperand(1);
        ArgumentPopSize = StackAdjust.getImm();
    } else {
        ArgumentPopSize = AFI.getArgumentStackToRestore();
    }
    return ArgumentPopSize;
}

enum AssignObjectOffsets {
    No = 0,
    Yes = 1,
}

fn getStackHazardSize(MF: *MachineFunction) -> u32 {
    return MF();
}

fn AArch64FrameLowering::getZPRStackSize(self: *AArch64FrameLowering, MF: *MachineFunction) -> StackOffset {
    let mut AFI: *AArch64FunctionInfo = MF;
    return getScalable(AFI.getStackSizeZPR());
}

fn AArch64FrameLowering::getPPRStackSize(self: *AArch64FrameLowering, MF: *MachineFunction) -> StackOffset {
    let mut AFI: *AArch64FunctionInfo = MF;
    return get(if AFI.hasSplitSVEObjects() { getStackHazardSize(MF) } else { 0 }, AFI.getStackSizePPR());
}

fn isLikelyToHaveSVEStack(AFL: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut AFI: *mut auto = MF;
    if AFI()() {
        return true;
    }
    if AFI()() {
        return AFL.getSVEStackSize(MF);
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    for let mut FI: i32 = MFI.getObjectIndexBegin(); FI < MFI.getObjectIndexEnd(); FI += 1 {
        if MFI.hasScalableStackID(FI) {
            return true;
        }
    }
    return false;
}

fn isTargetWindows(MF: *MachineFunction) -> bool {
    return MF();
}

fn AArch64FrameLowering::hasSVECalleeSavesAboveFrameRecord(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut AFI: *mut auto = MF;
    return isTargetWindows(MF) && ();
}

fn AArch64FrameLowering::homogeneousPrologEpilog(self: *AArch64FrameLowering, MF: *mut MachineFunction, Exit: *mut MachineBasicBlock) -> bool {
    if !MF.getFunction().hasMinSize() {
        return false;
    }
    if operator!() {
        return false;
    }
    if EnableRedZone() {
        return false;
    }
    if isTargetWindows(MF) {
        return false;
    }
    if isLikelyToHaveSVEStack(*self, MF) {
        return false;
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut RegInfo: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
    if MFI.hasVarSizedObjects() || RegInfo.hasStackRealignment(MF) {
        return false;
    }
    if Exit && self.getArgumentStackToRestore(MF, *Exit) {
        return false;
    }
    let mut AFI: *mut auto = MF;
    if AFI()() || () {
        return false;
    }
    let mut CSRegs: *MCPhysReg = MF.getRegInfo().getCalleeSavedRegs();
    let mut NumGPRs: u32 = 0;
    for let mut I: u32 = 0; CSRegs[I]; I += 1 {
        let mut Reg: Register = CSRegs[I];
        if  {
            if NumGPRs % 2 != 0 {
                return false;
            }
            break;
        }
        if  {
            NumGPRs += 1;
        }
    }
    return true;
}

fn AArch64FrameLowering::producePairRegisters(self: *AArch64FrameLowering, MF: *mut MachineFunction) -> bool {
    return produceCompactUnwindFrame(*self, MF) || self.homogeneousPrologEpilog(MF, null);
}

const DefaultSafeSPDisplacement: u32 = 255;

fn estimateRSStackSizeLimit(MF: *mut MachineFunction) -> u32 {
    for MBB in MF {
        for MI in MBB {
            if  {
                continue;
            }
            for MO in MI.operands() {
                if !MO.isFI() {
                    continue;
                }
                let mut Offset: StackOffset = StackOffset {};
                if isAArch64FrameOffsetLegal(MI, Offset, null, null, null) == AArch64FrameOffsetCannotUpdate {
                    return 0;
                }
            }
        }
    }
    return DefaultSafeSPDisplacement;
}

fn AArch64FrameLowering::getStackIDForScalableVectors(self: *AArch64FrameLowering) -> Value {
    return ScalableVector;
}

fn AArch64FrameLowering::getFixedObjectSize(self: *AArch64FrameLowering, MF: *MachineFunction, AFI: *AArch64FunctionInfo, IsWin64: bool, IsFunclet: bool) -> u32 {
    assert!(AFI.getTailCallReservedStack() % 16 == 0, "Tail call reserved stack must be aligned to 16 bytes");
    if !IsWin64 || IsFunclet {
        return AFI.getTailCallReservedStack();
    } else {
        if AFI.getTailCallReservedStack() != 0 && !MF.getFunction().getAttributes().hasAttrSomewhere(SwiftAsync, null) {
            report_fatal_error("cannot generate ABI-changing tail call for Win64", true);
        }
        let mut FixedObjectSize: u32 = AFI.getTailCallReservedStack();
        FixedObjectSize += AFI.getVarArgsGPRSize();
        if MF.hasEHFunclets() {
            let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
            let mut EHInfo: *WinEHFuncInfo = *MF.getWinEHFuncInfo();
            let mut CatchObjFrameIndices: SmallSetVector<int, 8> = zeroed();
            FixedObjectSize += 8;
        }
        return alignTo(FixedObjectSize, 16);
    }
}

fn AArch64FrameLowering::canUseRedZone(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    if operator!() {
        return false;
    }
    let mut Subtarget: *AArch64Subtarget = MF;
    let mut RedZoneSize: u32 = Subtarget.getTargetLowering().getRedZoneSize(MF.getFunction());
    if !RedZoneSize {
        return false;
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut AFI: *AArch64FunctionInfo = MF;
    let mut NumBytes: u64 = AFI.getLocalStackSize();
    let mut LowerQRegCopyThroughMem: bool = Subtarget()() && !Subtarget.isNeonAvailable() && operator!(Subtarget()());
    return !(MFI.hasCalls() || self.hasFP(MF) || NumBytes > RedZoneSize || AFI.hasSVEStackSize() || LowerQRegCopyThroughMem);
}

fn AArch64FrameLowering::hasFPImpl(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut RegInfo: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
    let mut AFI: *AArch64FunctionInfo = operator*(MF);
    if MF.hasEHFunclets() {
        return true;
    }
    if MFI.hasStackProtectorIndex() {
        let mut Subtarget: *auto = MF;
        if Subtarget()()() {
            return true;
        }
    }
    if MF.disableFramePointerElim() {
        return true;
    }
    if MFI.hasVarSizedObjects() || MFI.isFrameAddressTaken() || MFI.hasStackMap() || MFI.hasPatchPoint() || RegInfo.hasStackRealignment(MF) {
        return true;
    }
    if AFI.needsDwarfUnwindInfo(MF) && ((self.requiresSaveVG(MF) || AFI.getSMEFnAttrs().hasStreamingBody()) && (!AFI.hasCalculatedStackSizeSVE() || AFI.hasSVEStackSize())) {
        return true;
    }
    if !MFI.isMaxCallFrameSizeComputed() || MFI.getMaxCallFrameSize() > DefaultSafeSPDisplacement {
        return true;
    }
    return false;
}

fn AArch64FrameLowering::isFPReserved(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut TM: *TargetMachine = MF.getTarget();
    let mut TT: *Triple = TM.getTargetTriple();
    if TT.isOSDarwin() || TT.isOSWindows() {
        return true;
    }
    if self.hasFP(MF) {
        return true;
    }
    if MF.framePointerIsReserved() {
        return true;
    }
    return false;
}

fn AArch64FrameLowering::hasReservedCallFrame(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    return !MF.getFrameInfo().hasVarSizedObjects();
}

fn AArch64FrameLowering::eliminateCallFramePseudoInstr(self: *AArch64FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, I: iterator) -> iterator {
    let mut Subtarget: *AArch64Subtarget = MF;
    let mut TII: *AArch64InstrInfo = Subtarget.getInstrInfo();
    let mut TLI: *AArch64TargetLowering = Subtarget.getTargetLowering();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut DL: DebugLoc = operator(I).getDebugLoc();
    let mut Opc: u32 = operator(I).getOpcode();
    let mut IsDestroy: bool = Opc == TII()();
    let mut CalleePopAmount: u64 = if IsDestroy { operator(I).getOperand(1).getImm() } else { 0 };
    if !self.hasReservedCallFrame(MF) {
        let mut Amount: i64 = operator(I).getOperand(0).getImm();
        Amount = alignTo(Amount, self.getStackAlign());
        if !IsDestroy {
            Amount = -Amount;
        }
        if CalleePopAmount == 0 {
            assert!(Amount > -16777215 && Amount < 16777215, "call frame too large");
            if TLI.hasInlineStackProbe(MF) && -Amount >= StackProbeMaxUnprobedStack {
                assert!(MFI.hasVarSizedObjects(), "non-reserved call frame without var sized objects?");
                let mut ScratchReg: Register = MF.getRegInfo();
                self.inlineStackProbeFixed(I, ScratchReg, -Amount, get(0, 0));
            } else {
                emitFrameOffset(MBB, I, DL, getFixed(Amount), TII);
            }
        }
    } else if CalleePopAmount != 0 {
        assert!(CalleePopAmount < 16777215, "call frame too large");
        emitFrameOffset(MBB, I, DL, getFixed(-CalleePopAmount as i64), TII);
    }
    return MBB.erase(I);
}

fn AArch64FrameLowering::resetCFIToInitialState(self: *AArch64FrameLowering, MBB: *mut MachineBasicBlock) {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut Subtarget: *auto = MF;
    let mut TRI: *auto = operator*();
    let mut MFI: *auto = operator*(MF);
    let mut CFIBuilder: CFIInstBuilder = CFIInstBuilder { MBB, MBB.begin(), NoFlags, true };
    CFIBuilder.buildDefCFA;
    if MFI()(MF) {
        if MFI()() {
            CFIBuilder.buildNegateRAStateWithPC();
        } else if !MF.getTarget().getTargetTriple().isOSBinFormatMachO() {
            CFIBuilder.buildNegateRAState();
        }
    }
    if MFI()(MF) {
        CFIBuilder.buildSameValue;
    }
    let mut CSI: i32 = MF.getFrameInfo()();
}

fn getRegisterOrZero(Reg: MCRegister, HasSVE: bool) -> MCRegister {
    match Reg.id() {
        _ => {
            return 0;
        },
    }
}

fn AArch64FrameLowering::emitZeroCallUsedRegs(self: *AArch64FrameLowering, RegsToZero: BitVector, MBB: *mut MachineBasicBlock, arg: *mut RegScavenger) {
    let mut MBBI: iterator = MBB.getFirstTerminator();
    let mut DL: DebugLoc = null;
    if MBBI != MBB.end() {
        DL = operator(MBBI).getDebugLoc();
    }
    let mut MF: *MachineFunction = *MBB.getParent();
    let mut STI: *AArch64Subtarget = MF;
    let mut TRI: *AArch64RegisterInfo = *STI.getRegisterInfo();
    let mut GPRsToZero: BitVector = TRI()();
    let mut FPRsToZero: BitVector = TRI()();
    let mut HasSVE: bool = STI.isSVEorStreamingSVEAvailable();
    let mut HasFPR: bool = STI()();
    for Reg in RegsToZero.set_bits() {
        if TRI()(MF, Reg) {
            if getRegisterOrZero(Reg, HasSVE) {
                XReg.operator unsigned int();
            } else {
                GPRsToZero.set(XReg.operator unsigned int());
            }
        } else if HasFPR && isFpOrNEON(Reg) {
            if getRegisterOrZero(Reg, HasSVE) {
                XReg.operator unsigned int();
            } else {
                FPRsToZero.set(XReg.operator unsigned int());
            }
        }
    }
    let mut TII: *AArch64InstrInfo = *STI.getInstrInfo();
    if HasSVE {}
}

fn AArch64FrameLowering::windowsRequiresStackProbe(self: *AArch64FrameLowering, MF: *MachineFunction, StackSizeInBytes: u64) -> bool {
    let mut Subtarget: *AArch64Subtarget = MF;
    let mut MFI: *AArch64FunctionInfo = operator*(MF);
    return Subtarget.isTargetWindows() && MFI.hasStackProbing() && StackSizeInBytes >= MFI.getStackProbeSize();
}

fn getLiveRegsForEntryMBB(LiveRegs: *mut LivePhysRegs, MBB: *MachineBasicBlock) {
    let mut MF: *MachineFunction = MBB.getParent();
    LiveRegs.addLiveIns(MBB);
    let mut CSRegs: *MCPhysReg = MF.getRegInfo().getCalleeSavedRegs();
    for let mut i: u32 = 0; CSRegs[i]; i += 1 {
        LiveRegs.addReg(CSRegs[i]);
    }
}

fn AArch64FrameLowering::findScratchNonCalleeSaveRegister(self: *AArch64FrameLowering, MBB: *mut MachineBasicBlock, HasCall: bool) -> Register {
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut Subtarget: *AArch64Subtarget = MF;
    let mut TRI: *AArch64RegisterInfo = *Subtarget.getRegisterInfo();
    let mut LiveRegs: LivePhysRegs = TRI();
    getLiveRegsForEntryMBB(LiveRegs, *MBB);
    if HasCall {
        LiveRegs.addReg;
        LiveRegs.addReg;
        LiveRegs.addReg;
    }
    let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
    return Register { Reg: 0 };
}

fn AArch64FrameLowering::canUseAsPrologue(self: *AArch64FrameLowering, MBB: *MachineBasicBlock) -> bool {
    let mut MF: *MachineFunction = MBB.getParent();
    let mut TmpMBB: *mut MachineBasicBlock = &mut MBB;
    let mut Subtarget: *AArch64Subtarget = MF;
    let mut RegInfo: *AArch64RegisterInfo = Subtarget.getRegisterInfo();
    let mut TLI: *AArch64TargetLowering = Subtarget.getTargetLowering();
    let mut AFI: *AArch64FunctionInfo = MF;
    if AFI.hasSwiftAsyncContext() {
        let mut TRI: *AArch64RegisterInfo = *Subtarget.getRegisterInfo();
        let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
        let mut LiveRegs: LivePhysRegs = TRI();
        getLiveRegsForEntryMBB(LiveRegs, MBB);
        if operator!(LiveRegs.available) || operator!(LiveRegs.available) {
            return false;
        }
    }
    if MF() && MBB.isLiveIn {
        return false;
    }
    if RegInfo()(*MF) || TLI.hasInlineStackProbe(*MF) {
        if !self.findScratchNonCalleeSaveRegister(TmpMBB, false).isValid() {
            return false;
        }
    }
    if self.requiresSaveVG(*MF) || self.windowsRequiresStackProbe(*MF, max()) {
        if !self.findScratchNonCalleeSaveRegister(TmpMBB, true).isValid() {
            return false;
        }
    }
    return true;
}

fn AArch64FrameLowering::needsWinCFI(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut F: *Function = MF.getFunction();
    return MF.getTarget().getMCAsmInfo().usesWindowsCFI() && F.needsUnwindTableEntry();
}

fn AArch64FrameLowering::shouldSignReturnAddressEverywhere(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    if MF.getTarget().getMCAsmInfo().usesWindowsCFI() {
        return false;
    }
    let mut AFI: *AArch64FunctionInfo = MF;
    return AFI.getSignReturnAddressCondition() == All;
}

fn AArch64FrameLowering::insertSEH(self: *AArch64FrameLowering, MBBI: iterator, TII: *AArch64InstrInfo, Flag: MIFlag) -> iterator {
    let mut Opc: u32 = operator(MBBI).getOpcode();
    let mut MBB: *mut MachineBasicBlock = operator(MBBI).getParent();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut DL: DebugLoc = operator(MBBI).getDebugLoc();
    let mut ImmIdx: u32 = operator(MBBI).getNumOperands() - 1;
    let mut Imm: i32 = operator(MBBI).getOperand(ImmIdx).getImm();
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    let mut Subtarget: *AArch64Subtarget = MF;
    let mut RegInfo: *AArch64RegisterInfo = Subtarget.getRegisterInfo();
    match Opc {
        _ => {
            report_fatal_error("No SEH Opcode for this instruction", true);
        },
    }
    let mut I: iterator = MBB.insertAfter(MBBI, MIB.operator llvm::MachineInstr *());
    return I;
}

fn AArch64FrameLowering::requiresSaveVG(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut AFI: *AArch64FunctionInfo = MF;
    if !AFI.needsDwarfUnwindInfo(MF) || !AFI.hasStreamingModeChanges() {
        return false;
    }
    let mut ST: *mut auto = MF;
    if ST()() {
        return ();
    }
    return true;
}

fn AArch64FrameLowering::emitPacRetPlusLeafHardening(self: *AArch64FrameLowering, MF: *mut MachineFunction) {
    let mut Subtarget: *AArch64Subtarget = MF;
    let mut TII: *AArch64InstrInfo = Subtarget.getInstrInfo();
    let mut EmitSignRA: Closure_1 = Closure_1 { TII: &mut TII };
    let mut EmitAuthRA: Closure_2 = Closure_2 { TII: &mut TII };
    EmitSignRA.call(MF.front());
    for MBB in MF {
        if MBB.isEHFuncletEntry() {
            EmitSignRA.call(MBB);
        }
        if MBB.isReturnBlock() {
            EmitAuthRA.call(MBB);
        }
    }
}

fn AArch64FrameLowering::emitPrologue(self: *AArch64FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock) {
    let mut PrologueEmitter: AArch64PrologueEmitter = AArch64PrologueEmitter { MF, MBB, *self };
    PrologueEmitter.emitPrologue();
}

fn AArch64FrameLowering::emitEpilogue(self: *AArch64FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock) {
    let mut EpilogueEmitter: AArch64EpilogueEmitter = AArch64EpilogueEmitter { MF, MBB, *self };
    EpilogueEmitter.emitEpilogue();
}

fn AArch64FrameLowering::enableCFIFixup(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    return self.enableCFIFixup(MF) && MF(MF);
}

fn AArch64FrameLowering::enableFullCFIFixup(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    return self.enableCFIFixup(MF) && MF(MF);
}

fn AArch64FrameLowering::getFrameIndexReference(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32, FrameReg: *mut Register) -> StackOffset {
    return self.resolveFrameIndexReference(MF, FI, FrameReg, MF.getFunction().hasFnAttribute(SanitizeHWAddress) || MF.getFunction().hasFnAttribute(SanitizeMemTag), false);
}

fn AArch64FrameLowering::getFrameIndexReferenceFromSP(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut ObjectOffset: i64 = MFI.getObjectOffset(FI);
    let mut ZPRStackSize: StackOffset = self.getZPRStackSize(MF);
    let mut PPRStackSize: StackOffset = self.getPPRStackSize(MF);
    let mut SVEStackSize: StackOffset = ZPRStackSize + PPRStackSize;
    if MFI.isVariableSizedObjectIndex(FI) {
        return getFixed(-(MFI.getStackSize() as i64)) - SVEStackSize;
    }
    if !SVEStackSize {
        return getFixed(ObjectOffset - self.getOffsetOfLocalArea());
    }
    let mut AFI: *auto = MF;
    let mut FPAfterSVECalleeSaves: bool = self.hasSVECalleeSavesAboveFrameRecord(MF);
    if MFI.hasScalableStackID(FI) {
        if FPAfterSVECalleeSaves && -ObjectOffset <= () as i64 {
            (((operator!(operator!((operator!() && "split-sve-objects not supported with FPAfterSVECalleeSaves")))) || (_wassert(L"!AFI->hasSplitSVEObjects() && \"split-sve-objects not supported with FPAfterSVECalleeSaves\"", L"llvm\\lib\\Target\\AArch64\\AArch64FrameLowering.cpp", (1305) as u32) , 0)) as void);
            return getScalable(ObjectOffset);
        }
        let mut AccessOffset: StackOffset = StackOffset {};
        if AFI()() && MFI.getStackID(FI) == ScalableVector {
            AccessOffset = operator(PPRStackSize);
        }
        return AccessOffset + get(-(() as i64), ObjectOffset);
    }
    let mut IsFixed: bool = MFI.isFixedObjectIndex(FI);
    let mut IsCSR: bool = !IsFixed && ObjectOffset >= -((MFI) as i32);
    let mut ScalableOffset: StackOffset = StackOffset {};
    if !IsFixed && !IsCSR {
        ScalableOffset = operator(SVEStackSize);
    } else if FPAfterSVECalleeSaves && IsCSR {
        ScalableOffset = operator-();
    }
    return getFixed(ObjectOffset) + ScalableOffset;
}

fn AArch64FrameLowering::getNonLocalFrameIndexReference(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32) -> StackOffset {
    return getFixed(self.getSEHFrameIndexOffset(MF, FI));
}

fn AArch64FrameLowering::getFPOffset(self: *AArch64FrameLowering, MF: *MachineFunction, ObjectOffset: i64) -> StackOffset {
    let mut AFI: *auto = MF;
    let mut Subtarget: *auto = MF;
    let mut F: *Function = MF.getFunction();
    let mut IsWin64: bool = (F.getCallingConv(), F.isVarArg());
    let mut FixedObject: u32 = self.getFixedObjectSize(MF, IsWin64, false);
    let mut CalleeSaveSize: i64 = (MF.getFrameInfo());
    let mut FPAdjust: i64 = CalleeSaveSize - ();
    return getFixed(ObjectOffset + FixedObject + FPAdjust);
}

fn AArch64FrameLowering::getStackOffset(self: *AArch64FrameLowering, MF: *MachineFunction, ObjectOffset: i64) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    return getFixed(ObjectOffset + MFI.getStackSize() as i64);
}

fn AArch64FrameLowering::getSEHFrameIndexOffset(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32) -> i32 {
    let mut RegInfo: *AArch64RegisterInfo = MF();
    let mut ObjectOffset: i32 = MF.getFrameInfo().getObjectOffset(FI);
}

fn AArch64FrameLowering::resolveFrameIndexReference(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32, FrameReg: *mut Register, PreferFP: bool, ForSimm: bool) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut ObjectOffset: i64 = MFI.getObjectOffset(FI);
    let mut isFixed: bool = MFI.isFixedObjectIndex(FI);
    let mut StackID: Value = MFI.getStackID(FI) as Value;
    return self.resolveFrameOffsetReference(MF, ObjectOffset, isFixed, StackID, FrameReg, PreferFP, ForSimm);
}

fn AArch64FrameLowering::resolveFrameOffsetReference(self: *AArch64FrameLowering, MF: *MachineFunction, ObjectOffset: i64, isFixed: bool, StackID: Value, FrameReg: *mut Register, PreferFP: bool, ForSimm: bool) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut Subtarget: *auto = MF;
    let mut RegInfo: *AArch64RegisterInfo = ();
    let mut AFI: *auto = MF;
    let mut FPOffset: i64 = self.getFPOffset(MF, ObjectOffset).getFixed();
    let mut Offset: i64 = self.getStackOffset(MF, ObjectOffset).getFixed();
    let mut isCSR: bool = !isFixed && ObjectOffset >= -((MFI) as i32);
    let mut isSVE: bool = MFI.isScalableStackID(StackID);
    let mut ZPRStackSize: StackOffset = self.getZPRStackSize(MF);
    let mut PPRStackSize: StackOffset = self.getPPRStackSize(MF);
    let mut SVEStackSize: StackOffset = ZPRStackSize + PPRStackSize;
    let mut UseFP: bool = false;
    if AFI()() && !isSVE {
        PreferFP &= !SVEStackSize;
        if isFixed {
            UseFP = self.hasFP(MF);
        } else if isCSR && RegInfo()(MF) {
            assert!(self.hasFP(MF), "Re-aligned stack must have frame pointer");
            UseFP = true;
        } else if self.hasFP(MF) && operator!(RegInfo()(MF)) {
            let mut FPOffsetFits: bool = !ForSimm || FPOffset >= -256;
            PreferFP |= Offset > -FPOffset && !SVEStackSize;
            if FPOffset >= 0 {
                UseFP = true;
