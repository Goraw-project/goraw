fn AArch64FrameLowering::emitZeroCallUsedRegs(self: *AArch64FrameLowering, RegsToZero: BitVector, MBB: *mut MachineBasicBlock, arg: *mut RegScavenger) {
    let mut MBBI: iterator = MBB.getFirstTerminator();
    let mut DL: DebugLoc = null;
    if MBBI != MBB.end() {
        DL = operator(MBBI).getDebugLoc();
    }
    let mut MF: *MachineFunction = *MBB.getParent();
    let mut STI: *AArch64Subtarget = MF.getSubtarget();
    let mut TRI: *AArch64RegisterInfo = *STI.getRegisterInfo();
    let mut GPRsToZero: BitVector = BitVector { Bits: TRI.getNumRegs(), Size: false };
    let mut FPRsToZero: BitVector = BitVector { Bits: TRI.getNumRegs(), Size: false };
    let mut HasSVE: bool = STI.isSVEorStreamingSVEAvailable();
    let mut HasFPR: bool = STI.hasFPARMv8();
    for Reg in RegsToZero.set_bits() {
        if TRI.isGeneralPurposeRegister(MF, Reg) {
            if getRegisterOrZero(Reg, HasSVE) {
                XReg.operator unsigned int();
            } else {
                GPRsToZero.set(XReg.operator unsigned int());
            }
        } else if HasFPR && isFpOrNEON(Reg) {
            if getRegisterOrZero(Reg, HasSVE) {
                XReg.operator unsigned int();
            } else {
                FPRsToZero.set(XReg.operator unsigned int());
            }
        }
    }
    let mut TII: *AArch64InstrInfo = *STI.getInstrInfo();
    for Reg in GPRsToZero.set_bits() {
        TII.buildClearRegister(Reg, MBB, MBBI, DL, true);
    }
    for Reg in FPRsToZero.set_bits() {
        TII.buildClearRegister(Reg, MBB, MBBI, DL, true);
    }
    if HasSVE {
        for PReg in [P0, P1, P2, P3, P4, P5, P6, P7, P8, P9, P10, P11, P12, P13, P14, P15] {
            if RegsToZero[PReg.operator unsigned int()] {
                BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(PFALSE), PReg);
            }
        }
    }
}

fn AArch64FrameLowering::windowsRequiresStackProbe(self: *AArch64FrameLowering, MF: *MachineFunction, StackSizeInBytes: u64) -> bool {
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    let mut MFI: *AArch64FunctionInfo = *MF.getInfo();
    return Subtarget.isTargetWindows() && MFI.hasStackProbing() && StackSizeInBytes >= MFI.getStackProbeSize();
}

fn getLiveRegsForEntryMBB(LiveRegs: *mut LivePhysRegs, MBB: *MachineBasicBlock) {
    let mut MF: *MachineFunction = MBB.getParent();
    LiveRegs.addLiveIns(MBB);
    let mut CSRegs: *MCPhysReg = MF.getRegInfo().getCalleeSavedRegs();
    for let mut i: u32 = 0; CSRegs[i]; i += 1 {
        LiveRegs.addReg(CSRegs[i]);
    }
}

fn AArch64FrameLowering::findScratchNonCalleeSaveRegister(self: *AArch64FrameLowering, MBB: *mut MachineBasicBlock, HasCall: bool) -> Register {
    let mut MF: *mut MachineFunction = MBB.getParent();
    if &mut MF.front() == MBB && MF.getFunction().getCallingConv() != PreserveNone {
        return X9;
    }
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    let mut TRI: *AArch64RegisterInfo = *Subtarget.getRegisterInfo();
    let mut LiveRegs: LivePhysRegs = TRI;
    getLiveRegsForEntryMBB(LiveRegs, *MBB);
    if HasCall {
        LiveRegs.addReg(X16);
        LiveRegs.addReg(X17);
        LiveRegs.addReg(X18);
    }
    let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
    if LiveRegs.available(MRI, X9) {
        return X9;
    }
    for Reg in GPR64RegClass {
        if LiveRegs.available(MRI, Reg) {
            return Reg;
        }
    }
    return Register { Reg: 0 };
}

fn AArch64FrameLowering::canUseAsPrologue(self: *AArch64FrameLowering, MBB: *MachineBasicBlock) -> bool {
    let mut MF: *MachineFunction = MBB.getParent();
    let mut TmpMBB: *mut MachineBasicBlock = &mut MBB;
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    let mut RegInfo: *AArch64RegisterInfo = Subtarget.getRegisterInfo();
    let mut TLI: *AArch64TargetLowering = Subtarget.getTargetLowering();
    let mut AFI: *AArch64FunctionInfo = MF.getInfo();
    if AFI.hasSwiftAsyncContext() {
        let mut TRI: *AArch64RegisterInfo = *Subtarget.getRegisterInfo();
        let mut MRI: *MachineRegisterInfo = MF.getRegInfo();
        let mut LiveRegs: LivePhysRegs = TRI;
        getLiveRegsForEntryMBB(LiveRegs, MBB);
        if !LiveRegs.available(MRI, X16) || !LiveRegs.available(MRI, X17) {
            return false;
        }
    }
    if MF.getInfo().hasStackProbing() && MBB.isLiveIn(NZCV, getAll()) {
        return false;
    }
    if RegInfo.hasStackRealignment(*MF) || TLI.hasInlineStackProbe(*MF) {
        if !self.findScratchNonCalleeSaveRegister(TmpMBB, false).isValid() {
            return false;
        }
    }
    if self.requiresSaveVG(*MF) || self.windowsRequiresStackProbe(*MF, max()) {
        if !self.findScratchNonCalleeSaveRegister(TmpMBB, true).isValid() {
            return false;
        }
    }
    return true;
}

fn AArch64FrameLowering::needsWinCFI(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut F: *Function = MF.getFunction();
    return MF.getTarget().getMCAsmInfo().usesWindowsCFI() && F.needsUnwindTableEntry();
}

fn AArch64FrameLowering::shouldSignReturnAddressEverywhere(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    if MF.getTarget().getMCAsmInfo().usesWindowsCFI() {
        return false;
    }
    let mut AFI: *AArch64FunctionInfo = MF.getInfo();
    return AFI.getSignReturnAddressCondition() == All;
}

fn AArch64FrameLowering::insertSEH(self: *AArch64FrameLowering, MBBI: iterator, TII: *AArch64InstrInfo, Flag: MIFlag) -> iterator {
    let mut Opc: u32 = operator(MBBI).getOpcode();
    let mut MBB: *mut MachineBasicBlock = operator(MBBI).getParent();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut DL: DebugLoc = operator(MBBI).getDebugLoc();
    let mut ImmIdx: u32 = operator(MBBI).getNumOperands() - 1;
    let mut Imm: i32 = operator(MBBI).getOperand(ImmIdx).getImm();
    let mut MIB: MachineInstrBuilder = MachineInstrBuilder {};
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    let mut RegInfo: *AArch64RegisterInfo = Subtarget.getRegisterInfo();
    match Opc {
        _ => {
            report_fatal_error("No SEH Opcode for this instruction", true);
        },
        STR_ZXI => {
            LDR_ZXI;
        },
        STR_PXI => {
            LDR_PXI;
        },
        LDPDpost => {
            Imm = -Imm;
        },
        STPDpre => {
            let mut Reg0: u32 = RegInfo.getSEHRegNum(operator(MBBI).getOperand(1).getReg().operator unsigned int());
            let mut Reg1: u32 = RegInfo.getSEHRegNum(operator(MBBI).getOperand(2).getReg().operator unsigned int());
            MIB = BuildMI(MF, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_SaveFRegP_X)).addImm(Reg0).addImm(Reg1).addImm(Imm * 8).setMIFlag(Flag);
            break;
        },
        LDPXpost => {
            Imm = -Imm;
        },
        STPXpre => {
            let mut Reg0: Register = operator(MBBI).getOperand(1).getReg();
            let mut Reg1: Register = operator(MBBI).getOperand(2).getReg();
            if Reg0 == FP && Reg1 == LR {
                MIB = BuildMI(MF, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_SaveFPLR_X)).addImm(Imm * 8).setMIFlag(Flag);
            } else {
                MIB = BuildMI(MF, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_SaveRegP_X)).addImm(RegInfo.getSEHRegNum(Reg0.operator unsigned int())).addImm(RegInfo.getSEHRegNum(Reg1.operator unsigned int())).addImm(Imm * 8).setMIFlag(Flag);
            }
            break;
        },
        LDRDpost => {
            Imm = -Imm;
        },
        STRDpre => {
            let mut Reg: u32 = RegInfo.getSEHRegNum(operator(MBBI).getOperand(1).getReg().operator unsigned int());
            MIB = BuildMI(MF, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_SaveFReg_X)).addImm(Reg).addImm(Imm).setMIFlag(Flag);
            break;
        },
        LDRXpost => {
            Imm = -Imm;
        },
        STRXpre => {
            let mut Reg: u32 = RegInfo.getSEHRegNum(operator(MBBI).getOperand(1).getReg().operator unsigned int());
            MIB = BuildMI(MF, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_SaveReg_X)).addImm(Reg).addImm(Imm).setMIFlag(Flag);
            break;
        },
        STPDi => {
            LDPDi;
        },
        STPXi => {
            LDPXi;
        },
        STRXui => {
            LDRXui;
        },
        STRDui => {
            LDRDui;
        },
        STPQi => {
            LDPQi;
        },
        LDPQpost => {
            Imm = -Imm;
        },
        STPQpre => {
            let mut Reg0: u32 = RegInfo.getSEHRegNum(operator(MBBI).getOperand(1).getReg().operator unsigned int());
            let mut Reg1: u32 = RegInfo.getSEHRegNum(operator(MBBI).getOperand(2).getReg().operator unsigned int());
            MIB = BuildMI(MF, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SEH_SaveAnyRegQPX)).addImm(Reg0).addImm(Reg1).addImm(Imm * 16).setMIFlag(Flag);
            break;
        },
    }
    let mut I: iterator = MBB.insertAfter(MBBI, MIB.operator llvm::MachineInstr *());
    return I;
}

fn AArch64FrameLowering::requiresSaveVG(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut AFI: *AArch64FunctionInfo = MF.getInfo();
    if !AFI.needsDwarfUnwindInfo(MF) || !AFI.hasStreamingModeChanges() {
        return false;
    }
    let mut ST: *AArch64Subtarget = MF.getSubtarget();
    if ST.isTargetDarwin() {
        return ST.hasSVE();
    }
    return true;
}

fn AArch64FrameLowering::emitPacRetPlusLeafHardening(self: *AArch64FrameLowering, MF: *mut MachineFunction) {
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    let mut TII: *AArch64InstrInfo = Subtarget.getInstrInfo();
    let mut EmitSignRA: Closure_1 = Closure_1 { TII: &mut TII };
    let mut EmitAuthRA: Closure_2 = Closure_2 { TII: &mut TII };
    EmitSignRA.call(MF.front());
    for MBB in MF {
        if MBB.isEHFuncletEntry() {
            EmitSignRA.call(MBB);
        }
        if MBB.isReturnBlock() {
            EmitAuthRA.call(MBB);
        }
    }
}

fn AArch64FrameLowering::emitPrologue(self: *AArch64FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock) {
    let mut PrologueEmitter: AArch64PrologueEmitter = AArch64PrologueEmitter { MF, MBB, *self };
    PrologueEmitter.emitPrologue();
}

fn AArch64FrameLowering::emitEpilogue(self: *AArch64FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock) {
    let mut EpilogueEmitter: AArch64EpilogueEmitter = AArch64EpilogueEmitter { MF, MBB, *self };
    EpilogueEmitter.emitEpilogue();
}

fn AArch64FrameLowering::enableCFIFixup(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    return self.enableCFIFixup(MF) && MF.getInfo().needsDwarfUnwindInfo(MF);
}

fn AArch64FrameLowering::enableFullCFIFixup(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    return self.enableCFIFixup(MF) && MF.getInfo().needsAsyncDwarfUnwindInfo(MF);
}

fn AArch64FrameLowering::getFrameIndexReference(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32, FrameReg: *mut Register) -> StackOffset {
    return self.resolveFrameIndexReference(MF, FI, FrameReg, MF.getFunction().hasFnAttribute(SanitizeHWAddress) || MF.getFunction().hasFnAttribute(SanitizeMemTag), false);
}

fn AArch64FrameLowering::getFrameIndexReferenceFromSP(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut ObjectOffset: i64 = MFI.getObjectOffset(FI);
    let mut ZPRStackSize: StackOffset = self.getZPRStackSize(MF);
    let mut PPRStackSize: StackOffset = self.getPPRStackSize(MF);
    let mut SVEStackSize: StackOffset = ZPRStackSize + PPRStackSize;
    if MFI.isVariableSizedObjectIndex(FI) {
        return getFixed(-(MFI.getStackSize() as i64)) - SVEStackSize;
    }
    if !SVEStackSize {
        return getFixed(ObjectOffset - self.getOffsetOfLocalArea());
    }
    let mut AFI: *AArch64FunctionInfo const = MF.getInfo();
    let mut FPAfterSVECalleeSaves: bool = self.hasSVECalleeSavesAboveFrameRecord(MF);
    if MFI.hasScalableStackID(FI) {
        if FPAfterSVECalleeSaves && -ObjectOffset <= AFI.getSVECalleeSavedStackSize() as i64 {
            assert!(!AFI.hasSplitSVEObjects(), "split-sve-objects not supported with FPAfterSVECalleeSaves");
            return getScalable(ObjectOffset);
        }
        let mut AccessOffset: StackOffset = StackOffset {};
        if AFI.hasSplitSVEObjects() && MFI.getStackID(FI) == ScalableVector {
            AccessOffset = operator(PPRStackSize);
        }
        return AccessOffset + get(-(AFI.getCalleeSavedStackSize() as i64), ObjectOffset);
    }
    let mut IsFixed: bool = MFI.isFixedObjectIndex(FI);
    let mut IsCSR: bool = !IsFixed && ObjectOffset >= -(AFI.getCalleeSavedStackSize(MFI) as i32);
    let mut ScalableOffset: StackOffset = StackOffset {};
    if !IsFixed && !IsCSR {
        ScalableOffset = operator(SVEStackSize);
    } else if FPAfterSVECalleeSaves && IsCSR {
        ScalableOffset = operator(getScalable(AFI.getSVECalleeSavedStackSize()));
    }
    return getFixed(ObjectOffset) + ScalableOffset;
}

fn AArch64FrameLowering::getNonLocalFrameIndexReference(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32) -> StackOffset {
    return getFixed(self.getSEHFrameIndexOffset(MF, FI));
}

fn AArch64FrameLowering::getFPOffset(self: *AArch64FrameLowering, MF: *MachineFunction, ObjectOffset: i64) -> StackOffset {
    let mut AFI: *AArch64FunctionInfo const = MF.getInfo();
    let mut Subtarget: *AArch64Subtarget const = MF.getSubtarget();
    let mut F: *Function = MF.getFunction();
    let mut IsWin64: bool = Subtarget.isCallingConvWin64(F.getCallingConv(), F.isVarArg());
    let mut FixedObject: u32 = self.getFixedObjectSize(MF, AFI, IsWin64, false);
    let mut CalleeSaveSize: i64 = AFI.getCalleeSavedStackSize(MF.getFrameInfo());
    let mut FPAdjust: i64 = CalleeSaveSize - AFI.getCalleeSaveBaseToFrameRecordOffset();
    return getFixed(ObjectOffset + FixedObject + FPAdjust);
}

fn AArch64FrameLowering::getStackOffset(self: *AArch64FrameLowering, MF: *MachineFunction, ObjectOffset: i64) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    return getFixed(ObjectOffset + MFI.getStackSize() as i64);
}

fn AArch64FrameLowering::getSEHFrameIndexOffset(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32) -> i32 {
    let mut RegInfo: *AArch64RegisterInfo = MF.getSubtarget().getRegisterInfo();
    let mut ObjectOffset: i32 = MF.getFrameInfo().getObjectOffset(FI);
    return if RegInfo.getLocalAddressRegister(MF) == FP { self.getFPOffset(MF, ObjectOffset).getFixed() } else { self.getStackOffset(MF, ObjectOffset).getFixed() };
}

fn AArch64FrameLowering::resolveFrameIndexReference(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32, FrameReg: *mut Register, PreferFP: bool, ForSimm: bool) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut ObjectOffset: i64 = MFI.getObjectOffset(FI);
    let mut isFixed: bool = MFI.isFixedObjectIndex(FI);
    let mut StackID: Value = MFI.getStackID(FI) as Value;
    return self.resolveFrameOffsetReference(MF, ObjectOffset, isFixed, StackID, FrameReg, PreferFP, ForSimm);
}

fn AArch64FrameLowering::resolveFrameOffsetReference(self: *AArch64FrameLowering, MF: *MachineFunction, ObjectOffset: i64, isFixed: bool, StackID: Value, FrameReg: *mut Register, PreferFP: bool, ForSimm: bool) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut Subtarget: *AArch64Subtarget const = MF.getSubtarget();
    let mut RegInfo: *AArch64RegisterInfo = Subtarget.getRegisterInfo();
    let mut AFI: *AArch64FunctionInfo const = MF.getInfo();
    let mut FPOffset: i64 = self.getFPOffset(MF, ObjectOffset).getFixed();
    let mut Offset: i64 = self.getStackOffset(MF, ObjectOffset).getFixed();
    let mut isCSR: bool = !isFixed && ObjectOffset >= -(AFI.getCalleeSavedStackSize(MFI) as i32);
    let mut isSVE: bool = MFI.isScalableStackID(StackID);
    let mut ZPRStackSize: StackOffset = self.getZPRStackSize(MF);
    let mut PPRStackSize: StackOffset = self.getPPRStackSize(MF);
    let mut SVEStackSize: StackOffset = ZPRStackSize + PPRStackSize;
    let mut UseFP: bool = false;
    if AFI.hasStackFrame() && !isSVE {
        PreferFP &= !SVEStackSize;
        if isFixed {
            UseFP = self.hasFP(MF);
        } else if isCSR && RegInfo.hasStackRealignment(MF) {
            assert!(self.hasFP(MF), "Re-aligned stack must have frame pointer");
            UseFP = true;
        } else if self.hasFP(MF) && !RegInfo.hasStackRealignment(MF) {
            let mut FPOffsetFits: bool = !ForSimm || FPOffset >= -256;
            PreferFP |= Offset > -FPOffset && !SVEStackSize;
            if FPOffset >= 0 {
                UseFP = true;
            } else if MFI.hasVarSizedObjects() {
                let mut CanUseBP: bool = RegInfo.hasBasePointer(MF);
                if FPOffsetFits && CanUseBP {
                    UseFP = PreferFP;
                } else if !CanUseBP {
                    UseFP = true;
                }
            } else if MF.hasEHFunclets() && !RegInfo.hasBasePointer(MF) {
                Subtarget as void;
                assert!(Subtarget.isCallingConvWin64(MF.getFunction().getCallingConv(), MF.getFunction().isVarArg()), "Funclets should only be present on Win64");
                UseFP = true;
            } else {
                if FPOffsetFits && PreferFP {
                    UseFP = true;
                }
            }
        }
    }
    assert!(((isFixed || isCSR) || !RegInfo.hasStackRealignment(MF) || !UseFP), "In the presence of dynamic stack pointer realignment, non-argument/CSR objects cannot be accessed through the frame pointer");
    let mut FPAfterSVECalleeSaves: bool = self.hasSVECalleeSavesAboveFrameRecord(MF);
    if isSVE {
        let mut FPOffset: StackOffset = get(-AFI.getCalleeSaveBaseToFrameRecordOffset(), ObjectOffset);
        let mut SPOffset: StackOffset = SVEStackSize + get(MFI.getStackSize() - AFI.getCalleeSavedStackSize(), ObjectOffset);
        if AFI.hasSplitSVEObjects() && StackID == ScalableVector {
            operator(FPOffset, PPRStackSize);
            operator(SPOffset, PPRStackSize);
        }
        if FPAfterSVECalleeSaves {
            operator(FPOffset, getScalable(AFI.getSVECalleeSavedStackSize()));
            if -ObjectOffset <= AFI.getSVECalleeSavedStackSize() as i64 {
                operator(FPOffset, getFixed(AFI.getCalleeSavedStackSize()));
                operator(SPOffset, getFixed(AFI.getCalleeSavedStackSize()));
            }
        }
        if self.hasFP(MF) && (SPOffset.getFixed() || FPOffset.getScalable() < SPOffset.getScalable() || RegInfo.hasStackRealignment(MF)) {
            FrameReg = RegInfo.getFrameRegister(MF);
            return FPOffset;
        }
        FrameReg = if RegInfo.hasBasePointer(MF) { RegInfo.getBaseRegister() } else { SP };
        return SPOffset;
    }
    let mut SVEAreaOffset: StackOffset = StackOffset {};
    if FPAfterSVECalleeSaves {
        let mut SVECalleeSavedStack: StackOffset = getScalable(AFI.getSVECalleeSavedStackSize());
        if UseFP {
            if isFixed {
                SVEAreaOffset = SVECalleeSavedStack;
            } else if !isCSR {
                SVEAreaOffset = SVECalleeSavedStack - SVEStackSize;
            }
        } else {
            if isFixed {
                SVEAreaOffset = SVEStackSize;
            } else if isCSR {
                SVEAreaOffset = SVEStackSize - SVECalleeSavedStack;
            }
        }
    } else {
        if UseFP && !(isFixed || isCSR) {
            SVEAreaOffset = operator(SVEStackSize);
        }
        if !UseFP && (isFixed || isCSR) {
            SVEAreaOffset = SVEStackSize;
        }
    }
    if UseFP {
        FrameReg = RegInfo.getFrameRegister(MF);
        return getFixed(FPOffset) + SVEAreaOffset;
    }
    if RegInfo.hasBasePointer(MF) {
        FrameReg = RegInfo.getBaseRegister();
    } else {
        assert!(!MFI.hasVarSizedObjects(), "Can't use SP when we have var sized objects.");
        FrameReg = SP;
        if self.canUseRedZone(MF) {
            Offset -= AFI.getLocalStackSize();
        }
    }
    return getFixed(Offset) + SVEAreaOffset;
}

fn getPrologueDeath(MF: *mut MachineFunction, Reg: u32) -> RegState {
    let mut IsLiveIn: bool = MF.getRegInfo().isLiveIn(Reg);
    return getKillRegState(!IsLiveIn);
}

fn produceCompactUnwindFrame(AFL: *AArch64FrameLowering, MF: *mut MachineFunction) -> bool {
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    let mut Attrs: AttributeList = MF.getFunction().getAttributes();
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    return Subtarget.isTargetMachO() && !(Subtarget.getTargetLowering().supportSwiftError() && Attrs.hasAttrSomewhere(SwiftError, null)) && MF.getFunction().getCallingConv() != SwiftTail && !AFL.requiresSaveVG(MF) && !AFI.isSVECC();
}

fn invalidateWindowsRegisterPairing(SpillExtendedVolatile: bool, SpillCount: u32, Reg1: u32, Reg2: u32, NeedsWinCFI: bool, TRI: *TargetRegisterInfo) -> bool {
    if Reg2 == FP {
        return true;
    }
    if !NeedsWinCFI {
        return false;
    }
    if TRI.getEncodingValue(Reg2) == TRI.getEncodingValue(Reg1) + 1 {
        return if SpillExtendedVolatile { !((Reg1 == FP && Reg2 == LR) || (SpillCount % 2) == 0) } else { false };
    }
    if Reg1 >= X19 && Reg1 <= X27 && (Reg1 - X19) % 2 == 0 && Reg2 == LR {
        return false;
    }
    return true;
}

fn invalidateRegisterPairing(SpillExtendedVolatile: bool, SpillCount: u32, Reg1: u32, Reg2: u32, UsesWinAAPCS: bool, NeedsWinCFI: bool, NeedsFrameRecord: bool, TRI: *TargetRegisterInfo) -> bool {
    if UsesWinAAPCS {
        return invalidateWindowsRegisterPairing(SpillExtendedVolatile, SpillCount, Reg1, Reg2, NeedsWinCFI, TRI);
    }
    if NeedsFrameRecord {
        return Reg2 == LR;
    }
    return false;
}

struct RegPairInfo {
    Reg1: Register,
    Reg2: Register,
    FrameIdx: i32,
    Offset: i32,
    Type: RegType,
    RC: *TargetRegisterClass,
}

fn RegPairInfo::isPaired(self: *RegPairInfo) -> bool {
    return self.Reg2.isValid();
}

fn RegPairInfo::isScalable(self: *RegPairInfo) -> bool {
    return self.Type == PPR || self.Type == ZPR;
}

fn RegPairInfo::operator=(self, arg: *mut *mut RegPairInfo) -> *mut RegPairInfo {
    self.Reg1.operator=( as RegPairInfo.Reg1);
    self.Reg2.operator=( as RegPairInfo.Reg2);
    self.FrameIdx =  as RegPairInfo.FrameIdx;
    self.Offset =  as RegPairInfo.Offset;
    self.Type =  as RegPairInfo.Type;
    self.RC =  as RegPairInfo.RC;
    return *self;
}

fn findFreePredicateReg(SavedRegs: *mut BitVector) -> MCRegister {
    for let mut PReg: u32 = P8; PReg <= P15; PReg += 1 {
        if SavedRegs.test(PReg) {
            let mut PNReg: u32 = PReg - P0 + PN0;
            return PNReg;
        }
    }
    return MCRegister { Reg: 0 };
}

fn enableMultiVectorSpillFill(Subtarget: *AArch64Subtarget, MF: *mut MachineFunction) -> bool {
    if DisableMultiVectorSpillFill {
        return false;
    }
    let mut FuncAttrs: SMEAttrs = MF.getInfo().getSMEFnAttrs();
    let mut IsLocallyStreaming: bool = FuncAttrs.hasStreamingBody() && !FuncAttrs.hasStreamingInterface();
    return Subtarget.hasSVE2p1() || (Subtarget.hasSME2() && (!IsLocallyStreaming && Subtarget.isStreaming()));
}

fn computeCalleeSaveRegisterPairs(AFL: *AArch64FrameLowering, MF: *mut MachineFunction, CSI: ArrayRef<CalleeSavedInfo>, TRI: *TargetRegisterInfo, RegPairs: *mut SmallVectorImpl<RegPairInfo>, NeedsFrameRecord: bool) {
    if CSI.is_empty() {
        return;
    }
    let mut IsWindows: bool = isTargetWindows(MF);
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    let mut StackHazardSize: u32 = getStackHazardSize(MF);
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut CC: ID = MF.getFunction().getCallingConv();
    let mut Count: u32 = CSI.len;
    CC as void;
    assert!((!produceCompactUnwindFrame(AFL, MF) || CC == PreserveMost || CC == PreserveAll || CC == CXX_FAST_TLS || CC == Win64 || (Count & 1) == 0), "Odd number of callee-saved regs to spill!");
    let mut ByteOffset: i32 = AFI.getCalleeSavedStackSize();
    let mut StackFillDir: i32 = -1;
    let mut RegInc: i32 = 1;
    let mut FirstReg: u32 = 0;
    if IsWindows {
        ByteOffset = 0;
        StackFillDir = 1;
        RegInc = -1;
        FirstReg = Count - 1;
    }
    let mut FPAfterSVECalleeSaves: bool = AFL.hasSVECalleeSavesAboveFrameRecord(MF);
    let mut SpillExtendedVolatile: bool = IsWindows && any_of(CSI, Closure_3 {});
    let mut ZPRByteOffset: i32 = 0;
    let mut PPRByteOffset: i32 = 0;
    let mut SplitPPRs: bool = AFI.hasSplitSVEObjects();
    if SplitPPRs {
        ZPRByteOffset = AFI.getZPRCalleeSavedStackSize();
        PPRByteOffset = AFI.getPPRCalleeSavedStackSize();
    } else if !FPAfterSVECalleeSaves {
        ZPRByteOffset = AFI.getZPRCalleeSavedStackSize() + AFI.getPPRCalleeSavedStackSize();
        PPRByteOffset = 0;
    }
    let mut NeedGapToAlignStack: bool = AFI.hasCalleeSaveStackFreeSpace();
    let mut LastReg: Register = 0;
    let mut HasCSHazardPadding: bool = AFI.hasStackHazardSlotIndex() && !SplitPPRs;
    let mut AlignOffset: Closure_4 = Closure_4 { StackFillDir: StackFillDir };
    for let mut i: u32 = FirstReg; i < Count; i += RegInc {
        let mut RPI: RegPairInfo = RegPairInfo {};
        RPI.Reg1 = CSI[i].getReg();
        if GPR64RegClass.contains(RPI.Reg1.operator MCRegister()) {
            RPI.Type = GPR;
            RPI.RC = &mut GPR64RegClass;
        } else if FPR64RegClass.contains(RPI.Reg1.operator MCRegister()) {
            RPI.Type = FPR64;
            RPI.RC = &mut FPR64RegClass;
        } else if FPR128RegClass.contains(RPI.Reg1.operator MCRegister()) {
            RPI.Type = FPR128;
            RPI.RC = &mut FPR128RegClass;
        } else if ZPRRegClass.contains(RPI.Reg1.operator MCRegister()) {
            RPI.Type = ZPR;
            RPI.RC = &mut ZPRRegClass;
        } else if PPRRegClass.contains(RPI.Reg1.operator MCRegister()) {
            RPI.Type = PPR;
            RPI.RC = &mut PPRRegClass;
        } else if RPI.Reg1 == VG {
            RPI.Type = VG;
            RPI.RC = &mut FIXED_REGSRegClass;
        } else {
            llvm_unreachable_internal("Unsupported register class.", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64FrameLowering.cpp", 1784);
        }
        let mut ScalableByteOffset: *mut i32 = if RPI.Type == PPR && SplitPPRs { PPRByteOffset } else { ZPRByteOffset };
        if HasCSHazardPadding && (!LastReg.operator unsigned int() || !isFpOrNEON(LastReg)) && isFpOrNEON(RPI.Reg1) {
            ByteOffset += StackFillDir * StackHazardSize;
        }
        LastReg = RPI.Reg1;
        let mut NeedsWinCFI: bool = AFL.needsWinCFI(MF);
        let mut Scale: i32 = TRI.getSpillSize(*RPI.RC);
        if i + RegInc < Count && !HasCSHazardPadding {
            let mut NextReg: MCRegister = CSI[i + RegInc].getReg();
            let mut SpillCount: u32 = if NeedsWinCFI { FirstReg - i } else { i };
            let mut Aligned: i32 = AlignOffset.call(ByteOffset, Scale);
            let mut PairOffset: i32 = if IsWindows { Aligned } else { Aligned + StackFillDir * 2 * Scale };
            let mut PairFitsImmRange: bool = PairOffset / Scale >= -64 && PairOffset / Scale <= 63;
            match RPI.Type {
                GPR => {
                    if GPR64RegClass.contains(NextReg) && PairFitsImmRange && !invalidateRegisterPairing(SpillExtendedVolatile, SpillCount, RPI.Reg1.operator unsigned int(), NextReg.operator unsigned int(), IsWindows, NeedsWinCFI, NeedsFrameRecord, TRI) {
                        RPI.Reg2 = NextReg;
                    }
                },
                FPR64 => {
                    if FPR64RegClass.contains(NextReg) && PairFitsImmRange && !invalidateRegisterPairing(SpillExtendedVolatile, SpillCount, RPI.Reg1.operator unsigned int(), NextReg.operator unsigned int(), IsWindows, NeedsWinCFI, NeedsFrameRecord, TRI) {
                        RPI.Reg2 = NextReg;
                    }
                },
                FPR128 => {
                    if FPR128RegClass.contains(NextReg) && PairFitsImmRange {
                        RPI.Reg2 = NextReg;
                    }
                },
                PPR => {
                    break;
                },
                ZPR => {
                    if !NeedsWinCFI && AFI.getPredicateRegForFillSpill() != 0 && ((RPI.Reg1.operator unsigned int() - Z0) & 1) == 0 && (NextReg == RPI.Reg1.operator unsigned int() + 1) {
                        let mut Offset: i32 = (ScalableByteOffset + StackFillDir * 2 * Scale) / Scale;
                        if (-16 <= Offset && Offset <= 14) && (Offset % 2 == 0) {
                            RPI.Reg2 = NextReg;
                        }
                    }
                },
                VG => {
                    break;
                },
            }
        }
        assert!((!RPI.isPaired() || (CSI[i].getFrameIdx() + RegInc == CSI[i + RegInc].getFrameIdx())), "Out of order callee saved regs!");
        assert!((!RPI.isPaired() || !NeedsFrameRecord || RPI.Reg2 != FP || RPI.Reg1 == LR), "FrameRecord must be allocated together with LR");
        assert!((!RPI.isPaired() || !NeedsFrameRecord || RPI.Reg1 != FP || RPI.Reg2 == LR), "FrameRecord must be allocated together with LR");
        assert!((!produceCompactUnwindFrame(AFL, MF) || CC == PreserveMost || CC == PreserveAll || CC == CXX_FAST_TLS || CC == Win64 || (RPI.isPaired() && ((RPI.Reg1 == LR && RPI.Reg2 == FP) || RPI.Reg1.operator unsigned int() + 1 == RPI.Reg2.operator unsigned int()))), "Callee-save registers not saved as adjacent register pair!");
        RPI.FrameIdx = CSI[i].getFrameIdx();
        if IsWindows && RPI.isPaired() {
            RPI.FrameIdx = CSI[i + RegInc].getFrameIdx();
        }
        if RPI.isScalable() && ScalableByteOffset % Scale != 0 {
            ScalableByteOffset = AlignOffset.call(ScalableByteOffset, Scale);
        }
        if !RPI.isScalable() && ByteOffset % Scale != 0 {
            ByteOffset = AlignOffset.call(ByteOffset, Scale);
        }
        let mut OffsetPre: i32 = if RPI.isScalable() { ScalableByteOffset } else { ByteOffset };
        assert!(OffsetPre % Scale == 0);
        if RPI.isScalable() {
            ScalableByteOffset += StackFillDir * (if RPI.isPaired() { 2 * Scale } else { Scale });
        } else {
            ByteOffset += StackFillDir * (if RPI.isPaired() { 2 * Scale } else { Scale });
        }
        if NeedsFrameRecord && AFI.hasSwiftAsyncContext() && ((!IsWindows && RPI.Reg2 == FP) || (IsWindows && RPI.Reg2 == LR)) {
            ByteOffset += StackFillDir * 8;
        }
        if NeedGapToAlignStack && !IsWindows && !RPI.isScalable() && RPI.Type != FPR128 && !RPI.isPaired() && ByteOffset % 16 != 0 {
            ByteOffset += 8 * StackFillDir;
            assert!(MFI.getObjectAlign(RPI.FrameIdx) <= 16);
            MFI.setObjectAlignment(RPI.FrameIdx, 16);
            NeedGapToAlignStack = false;
        }
        let mut OffsetPost: i32 = if RPI.isScalable() { ScalableByteOffset } else { ByteOffset };
        assert!(OffsetPost % Scale == 0);
        let mut Offset: i32 = if IsWindows { OffsetPre } else { OffsetPost };
        if NeedsFrameRecord && AFI.hasSwiftAsyncContext() && ((!IsWindows && RPI.Reg2 == FP) || (IsWindows && RPI.Reg2 == LR)) {
            Offset += 8;
        }
        RPI.Offset = Offset / Scale;
        assert!((!RPI.isPaired() || (!RPI.isScalable() && RPI.Offset >= -64 && RPI.Offset <= 63) || (RPI.isScalable() && RPI.Offset >= -256 && RPI.Offset <= 255)), "Offset out of bounds for LDP/STP immediate");
        let mut isFrameRecord: Closure_5 = Closure_5 { RPI: &mut RPI, IsWindows: &mut IsWindows, i: &mut i, CSI: &mut CSI };
        if NeedsFrameRecord && isFrameRecord.call() {
            AFI.setCalleeSaveBaseToFrameRecordOffset(Offset);
        }
        RegPairs.push(RPI);
        if RPI.isPaired() {
            i += RegInc;
        }
    }
    if IsWindows {
        if AFI.hasCalleeSaveStackFreeSpace() {
            MFI.setObjectAlignment(CSI[0].getFrameIdx(), 16);
        }
        reverse(RegPairs.begin(), RegPairs.end());
    }
}

fn AArch64FrameLowering::spillCalleeSavedRegisters(self: *AArch64FrameLowering, MBB: *mut MachineBasicBlock, MI: iterator, CSI: ArrayRef<CalleeSavedInfo>, TRI: *TargetRegisterInfo) -> bool {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    let mut TLI: *AArch64TargetLowering = *Subtarget.getTargetLowering();
    let mut TII: *AArch64InstrInfo = *Subtarget.getInstrInfo();
    let mut NeedsWinCFI: bool = self.needsWinCFI(MF);
    let mut DL: DebugLoc = null;
    let mut RegPairs: SmallVector<RegPairInfo, 8> = SmallVector<RegPairInfo, 8> {};
    computeCalleeSaveRegisterPairs(*self, MF, CSI, TRI, RegPairs, self.hasFP(MF));
    let mut MRI: *mut MachineRegisterInfo = MF.getRegInfo();
    MRI.freezeReservedRegs();
    if self.homogeneousPrologEpilog(MF, null) {
        let mut MIB: MachineInstrBuilder = BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(HOM_Prolog)).setMIFlag(FrameSetup);
        for RPI in RegPairs {
            MIB.addReg(RPI.Reg1, RegState {}, 0);
            MIB.addReg(RPI.Reg2, RegState {}, 0);
            if !MRI.isReserved(RPI.Reg1.operator MCRegister()) {
                MBB.addLiveIn(RPI.Reg1.operator MCRegister(), getAll());
            }
            if RPI.isPaired() && !MRI.isReserved(RPI.Reg2.operator MCRegister()) {
                MBB.addLiveIn(RPI.Reg2.operator MCRegister(), getAll());
            }
        }
        return true;
    }
    let mut PTrueCreated: bool = false;
    for RPI in reverse(RegPairs) {
        let mut Reg1: Register = RPI.Reg1;
        let mut Reg2: Register = RPI.Reg2;
        let mut StrOpc: u32 = 0;
        let mut Size: u32 = TRI.getSpillSize(*RPI.RC);
        let mut Alignment: Align = TRI.getSpillAlign(*RPI.RC);
        match RPI.Type {
            GPR => {
                StrOpc = if RPI.isPaired() { STPXi } else { STRXui };
            },
            FPR64 => {
                StrOpc = if RPI.isPaired() { STPDi } else { STRDui };
            },
            FPR128 => {
                StrOpc = if RPI.isPaired() { STPQi } else { STRQui };
            },
            ZPR => {
                StrOpc = if RPI.isPaired() { ST1B_2Z_IMM } else { STR_ZXI };
            },
            PPR => {
                StrOpc = STR_PXI;
            },
            VG => {
                StrOpc = STRXui;
            },
        }
        let mut X0Scratch: Register = 0;
        let mut RestoreX0: Closure_6 = Closure_6 { X0Scratch: &mut X0Scratch, MBB: &mut MBB, MI: &mut MI, DL: &mut DL, TII: &mut TII };
        if Reg1 == VG {
            Reg1 = self.findScratchNonCalleeSaveRegister(&mut MBB, true);
            assert!(Reg1.isValid();
            if MF.getSubtarget().hasSVE() {
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(CNTD_XPiI), Reg1).addImm(31).addImm(1).setMIFlag(FrameSetup);
            } else {
                let mut STI: *AArch64Subtarget = MF.getSubtarget();
                if any_of(MBB.liveins(), Closure_7 { STI: &mut STI }) {
                    X0Scratch = Reg1;
                    BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(COPY), X0Scratch).addReg(X0, RegState {}, 0).setMIFlag(FrameSetup);
                }
                let mut LC: Libcall = SMEABI_GET_CURRENT_VG;
                let mut RegMask: *u32 = TRI.getCallPreservedMask(MF, TLI.getLibcallCallingConv(LC));
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(BL)).addExternalSymbol(TLI.getLibcallName(LC), 0).addRegMask(RegMask).addReg(X0, ImplicitDefine, 0).setMIFlag(FrameSetup);
                Reg1 = X0;
            }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                {
                    dbgs() << "CSR spill: (" << printReg(Reg1, TRI, 0, null);
                    if RPI.isPaired() {
                        dbgs() << ", " << printReg(Reg2, TRI, 0, null);
                    }
                    dbgs() << ") -> fi#(" << RPI.FrameIdx;
                    if RPI.isPaired() {
                        dbgs() << ", " << RPI.FrameIdx + 1;
                    }
                    dbgs() << ")\n";
                }
            }
        }
            if !(false) { break; }
        }
        assert!((!isTargetWindows(MF) || !(Reg1 == LR && Reg2 == FP)), "Windows unwdinding requires a consecutive (FP,LR) pair");
        let mut FrameIdxReg1: u32 = RPI.FrameIdx;
        let mut FrameIdxReg2: u32 = RPI.FrameIdx + 1;
        if isTargetWindows(MF) && RPI.isPaired() {
            swap(Reg1, Reg2);
            swap(FrameIdxReg1, FrameIdxReg2);
        }
        if RPI.isPaired() && RPI.isScalable() {
            let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
            let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
            let mut PnReg: u32 = AFI.getPredicateRegForFillSpill();
            assert!((PnReg != 0 && enableMultiVectorSpillFill(Subtarget, MF)), "Expects SVE2.1 or SME2 target and a predicate register");
            if !PTrueCreated {
                PTrueCreated = true;
                BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(PTRUE_C_B), PnReg).setMIFlags(FrameSetup);
            }
            let mut MIB: MachineInstrBuilder = BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(StrOpc));
            if !MRI.isReserved(Reg1.operator MCRegister()) {
                MBB.addLiveIn(Reg1.operator MCRegister(), getAll());
            }
            if !MRI.isReserved(Reg2.operator MCRegister()) {
                MBB.addLiveIn(Reg2.operator MCRegister(), getAll());
            }
            MIB.addReg(Z0_Z1 + (RPI.Reg1.operator unsigned int() - Z0), RegState {}, 0);
            MIB.addMemOperand(MF.getMachineMemOperand(getFixedStack(MF, FrameIdxReg2, 0), MOStore, Size, Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic));
            MIB.addReg(PnReg, RegState {}, 0);
            MIB.addReg(SP, RegState {}, 0).addImm(RPI.Offset / 2).setMIFlag(FrameSetup);
            MIB.addMemOperand(MF.getMachineMemOperand(getFixedStack(MF, FrameIdxReg1, 0), MOStore, Size, Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic));
            if NeedsWinCFI {
                self.insertSEH(MIB.operator MachineInstrBundleIterator(), TII, FrameSetup);
            }
        } else {
            let mut MIB: MachineInstrBuilder = BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(StrOpc));
            if !MRI.isReserved(Reg1.operator MCRegister()) {
                MBB.addLiveIn(Reg1.operator MCRegister(), getAll());
            }
            if RPI.isPaired() {
                if !MRI.isReserved(Reg2.operator MCRegister()) {
                    MBB.addLiveIn(Reg2.operator MCRegister(), getAll());
                }
                MIB.addReg(Reg2, getPrologueDeath(MF, Reg2.operator unsigned int()), 0);
                MIB.addMemOperand(MF.getMachineMemOperand(getFixedStack(MF, FrameIdxReg2, 0), MOStore, Size, Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic));
            }
            MIB.addReg(Reg1, getPrologueDeath(MF, Reg1.operator unsigned int()), 0).addReg(SP, RegState {}, 0).addImm(RPI.Offset).setMIFlag(FrameSetup);
            MIB.addMemOperand(MF.getMachineMemOperand(getFixedStack(MF, FrameIdxReg1, 0), MOStore, Size, Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic));
            if NeedsWinCFI {
                self.insertSEH(MIB.operator MachineInstrBundleIterator(), TII, FrameSetup);
            }
        }
        let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
        if RPI.Type == ZPR {
            MFI.setStackID(FrameIdxReg1, ScalableVector);
            if RPI.isPaired() {
                MFI.setStackID(FrameIdxReg2, ScalableVector);
            }
        } else if RPI.Type == PPR {
            MFI.setStackID(FrameIdxReg1, ScalablePredicateVector);
            if RPI.isPaired() {
                MFI.setStackID(FrameIdxReg2, ScalablePredicateVector);
            }
        }
    }
    return true;
}

fn AArch64FrameLowering::restoreCalleeSavedRegisters(self: *AArch64FrameLowering, MBB: *mut MachineBasicBlock, MBBI: iterator, CSI: MutableArrayRef<CalleeSavedInfo>, TRI: *TargetRegisterInfo) -> bool {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut TII: *AArch64InstrInfo = *MF.getSubtarget().getInstrInfo();
    let mut DL: DebugLoc = null;
    let mut RegPairs: SmallVector<RegPairInfo, 8> = SmallVector<RegPairInfo, 8> {};
    let mut NeedsWinCFI: bool = self.needsWinCFI(MF);
    if MBBI != MBB.end() {
        DL = operator(MBBI).getDebugLoc();
    }
    computeCalleeSaveRegisterPairs(*self, MF, CSI, TRI, RegPairs, self.hasFP(MF));
    if self.homogeneousPrologEpilog(MF, &mut MBB) {
        let mut MIB: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(HOM_Epilog)).setMIFlag(FrameDestroy);
        for RPI in RegPairs {
            MIB.addReg(RPI.Reg1, Define, 0);
            MIB.addReg(RPI.Reg2, Define, 0);
        }
        return true;
    }
    let mut IsPPR: Closure_8 = Closure_8 {};
    let mut PPRBegin: *mut RegPairInfo = find_if(RegPairs, IsPPR);
    let mut PPREnd: *mut RegPairInfo = find_if_not(PPRBegin, RegPairs.end(), IsPPR);
    reverse(PPRBegin, PPREnd);
    let mut IsZPR: Closure_9 = Closure_9 {};
    let mut ZPRBegin: *mut RegPairInfo = find_if(RegPairs, IsZPR);
    let mut ZPREnd: *mut RegPairInfo = find_if_not(ZPRBegin, RegPairs.end(), IsZPR);
    reverse(ZPRBegin, ZPREnd);
    let mut PTrueCreated: bool = false;
    for RPI in RegPairs {
        let mut Reg1: Register = RPI.Reg1;
        let mut Reg2: Register = RPI.Reg2;
        let mut LdrOpc: u32 = 0;
        let mut Size: u32 = TRI.getSpillSize(*RPI.RC);
        let mut Alignment: Align = TRI.getSpillAlign(*RPI.RC);
        match RPI.Type {
            GPR => {
                LdrOpc = if RPI.isPaired() { LDPXi } else { LDRXui };
            },
            FPR64 => {
                LdrOpc = if RPI.isPaired() { LDPDi } else { LDRDui };
            },
            FPR128 => {
                LdrOpc = if RPI.isPaired() { LDPQi } else { LDRQui };
            },
            ZPR => {
                LdrOpc = if RPI.isPaired() { LD1B_2Z_IMM } else { LDR_ZXI };
            },
            PPR => {
                LdrOpc = LDR_PXI;
            },
            VG => {
                continue;
            },
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                {
                    dbgs() << "CSR restore: (" << printReg(Reg1, TRI, 0, null);
                    if RPI.isPaired() {
                        dbgs() << ", " << printReg(Reg2, TRI, 0, null);
                    }
                    dbgs() << ") -> fi#(" << RPI.FrameIdx;
                    if RPI.isPaired() {
                        dbgs() << ", " << RPI.FrameIdx + 1;
                    }
                    dbgs() << ")\n";
                }
            }
        }
            if !(false) { break; }
        }
        let mut FrameIdxReg1: u32 = RPI.FrameIdx;
        let mut FrameIdxReg2: u32 = RPI.FrameIdx + 1;
        if isTargetWindows(MF) && RPI.isPaired() {
            swap(Reg1, Reg2);
            swap(FrameIdxReg1, FrameIdxReg2);
        }
        let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
        if RPI.isPaired() && RPI.isScalable() {
            let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
            let mut PnReg: u32 = AFI.getPredicateRegForFillSpill();
            assert!((PnReg != 0 && enableMultiVectorSpillFill(Subtarget, MF)), "Expects SVE2.1 or SME2 target and a predicate register");
            if !PTrueCreated {
                PTrueCreated = true;
                BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(PTRUE_C_B), PnReg).setMIFlags(FrameDestroy);
            }
            let mut MIB: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LdrOpc));
            MIB.addReg(Z0_Z1 + (RPI.Reg1.operator unsigned int() - Z0), getDefRegState(true), 0);
            MIB.addMemOperand(MF.getMachineMemOperand(getFixedStack(MF, FrameIdxReg2, 0), MOLoad, Size, Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic));
            MIB.addReg(PnReg, RegState {}, 0);
            MIB.addReg(SP, RegState {}, 0).addImm(RPI.Offset / 2).setMIFlag(FrameDestroy);
            MIB.addMemOperand(MF.getMachineMemOperand(getFixedStack(MF, FrameIdxReg1, 0), MOLoad, Size, Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic));
            if NeedsWinCFI {
                self.insertSEH(MIB.operator MachineInstrBundleIterator(), TII, FrameDestroy);
            }
        } else {
            let mut MIB: MachineInstrBuilder = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LdrOpc));
            if RPI.isPaired() {
                MIB.addReg(Reg2, getDefRegState(true), 0);
                MIB.addMemOperand(MF.getMachineMemOperand(getFixedStack(MF, FrameIdxReg2, 0), MOLoad, Size, Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic));
            }
            MIB.addReg(Reg1, getDefRegState(true), 0);
            MIB.addReg(SP, RegState {}, 0).addImm(RPI.Offset).setMIFlag(FrameDestroy);
            MIB.addMemOperand(MF.getMachineMemOperand(getFixedStack(MF, FrameIdxReg1, 0), MOLoad, Size, Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic));
            if NeedsWinCFI {
                self.insertSEH(MIB.operator MachineInstrBundleIterator(), TII, FrameDestroy);
            }
        }
    }
    return true;
}

fn getMMOFrameID(MMO: *mut MachineMemOperand, MFI: *MachineFrameInfo) -> optional<int> {
    let mut PSV: *FixedStackPseudoSourceValue = dyn_cast_or_null(MMO.getPseudoValue());
    if PSV {
        return PSV.getFrameIndex();
    }
    if MMO.getValue() {
        if dyn_cast(getUnderlyingObject(MMO.getValue(), MaxLookupSearchDepth, false)) {
            Al;
        } else {
            for let mut FI: i32 = MFI.getObjectIndexBegin(); FI < MFI.getObjectIndexEnd(); FI += 1 {
                if MFI.getObjectAllocation(FI) == Al {
                    return FI;
                }
            }
        }
    }
    return nullopt;
}

fn getLdStFrameID(MI: *MachineInstr, MFI: *MachineFrameInfo) -> optional<int> {
    if !MI.mayLoadOrStore(AnyInBundle) || MI.getNumMemOperands() < 1 {
        return nullopt;
    }
    return getMMOFrameID(*MI.memoperands_begin(), MFI);
}

fn isPPRAccess(MI: *MachineInstr) -> bool {
    return PPRRegClass.contains(MI.getOperand(0).getReg().operator MCRegister());
}

fn AArch64FrameLowering::determineStackHazardSlot(self: *AArch64FrameLowering, MF: *mut MachineFunction, SavedRegs: *mut BitVector) {
    let mut StackHazardSize: u32 = getStackHazardSize(MF);
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    if StackHazardSize == 0 || StackHazardSize % 16 != 0 || AFI.hasStackHazardSlotIndex() {
        return;
    }
    let mut Attrs: SMEAttrs = AFI.getSMEFnAttrs();
    if !StackHazardInNonStreaming && Attrs.hasNonStreamingInterfaceAndBody() {
        return;
    }
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut HasFPRCSRs: bool = any_of(SavedRegs.set_bits(), Closure_10 {});
    let mut HasPPRCSRs: bool = any_of(SavedRegs.set_bits(), Closure_11 {});
    let mut HasFPRStackObjects: bool = false;
    let mut HasPPRStackObjects: bool = false;
    if !HasFPRCSRs || SplitSVEObjects {
        let mut SlotTypes: SmallVector<SlotType> = SmallVector<SlotType> { MFI.getObjectIndexEnd(), Unknown };
        for MBB in MF {
            for MI in MBB {
                let mut FI: optional<int> = getLdStFrameID(MI, MFI);
                if !FI || FI < 0 || FI > SlotTypes.len {
                    continue;
                }
                if MFI.hasScalableStackID(operator(FI)) {
                    operator(SlotTypes[operator(FI)], if isPPRAccess(MI) { PPR } else { ZPRorFPR });
                } else {
                    operator(SlotTypes[operator(FI)], if isFpOrNEON(MI) { ZPRorFPR } else { GPR });
                }
            }
        }
        for let mut FI: i32 = 0; FI < SlotTypes.len; FI += 1 {
            HasFPRStackObjects |= SlotTypes[FI] == ZPRorFPR;
            if SlotTypes[FI] == PPR {
                MFI.setStackID(FI, ScalablePredicateVector);
                HasPPRStackObjects = true;
            }
        }
    }
    if HasFPRCSRs || HasFPRStackObjects {
        let mut ID: i32 = MFI.CreateStackObject(StackHazardSize, 16, false, null, 0);
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Created Hazard slot at " << ID << " size " << StackHazardSize << "\n";
            }
        }
            if !(false) { break; }
        }
        AFI.setStackHazardSlotIndex(ID);
    }
    if !AFI.hasStackHazardSlotIndex() {
        return;
    }
    if SplitSVEObjects {
        let mut CC: ID = MF.getFunction().getCallingConv();
        if AFI.isSVECC() || CC == AArch64_SVE_VectorCall {
            AFI.setSplitSVEObjects(true);
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Using SplitSVEObjects for SVE CC function\n";
                }
            }
                if !(false) { break; }
            }
            return;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Determining if SplitSVEObjects should be used in non-SVE CC function...\n";
            }
        }
            if !(false) { break; }
        }
        if !is_contained([C, Fast], CC) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Calling convention is not supported with SplitSVEObjects\n";
                }
            }
                if !(false) { break; }
            }
            return;
        }
        if !HasPPRCSRs && !HasPPRStackObjects {
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Not using SplitSVEObjects as no PPRs are on the stack\n";
                }
            }
                if !(false) { break; }
            }
            return;
        }
        if !HasFPRCSRs && !HasFPRStackObjects {
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Not using SplitSVEObjects as no FPRs or ZPRs are on the stack\n";
                }
            }
                if !(false) { break; }
            }
            return;
        }
        let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
        assert!(Subtarget.isSVEorStreamingSVEAvailable(), "Expected SVE to be available for PPRs");
        let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
        let mut FPRZRegs: BitVector = BitVector { Bits: SavedRegs.len, Size: false };
        for let mut Reg: u64 = 0;
let mut E: u64 = SavedRegs.len; HasFPRCSRs && Reg < E; Reg += 1 {
            let mut RegBit: reference = SavedRegs[Reg];
            if !RegBit {
                continue;
            }
            let mut SubRegIdx: u32 = 0;
            if FPR64RegClass.contains(Reg) {
                SubRegIdx = dsub;
            } else if FPR128RegClass.contains(Reg) {
                SubRegIdx = zsub;
            } else {
                continue;
            }
            RegBit = false;
            let mut ZReg: Register = TRI.getMatchingSuperReg(Reg, SubRegIdx, &mut ZPRRegClass);
            FPRZRegs.set(ZReg.operator unsigned int());
        }
        operator(SavedRegs, FPRZRegs);
        AFI.setSplitSVEObjects(true);
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "SplitSVEObjects enabled!\n";
            }
        }
            if !(false) { break; }
        }
    }
}

fn AArch64FrameLowering::determineCalleeSaves(self: *AArch64FrameLowering, MF: *mut MachineFunction, SavedRegs: *mut BitVector, RS: *mut RegScavenger) {
    if MF.getFunction().getCallingConv() == GHC {
        return;
    }
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    self.determineCalleeSaves(MF, SavedRegs, RS);
    let mut RegInfo: *AArch64RegisterInfo = Subtarget.getRegisterInfo();
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    let mut UnspilledCSGPR: Register = 0;
    let mut UnspilledCSGPRPaired: Register = 0;
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut CSRegs: *MCPhysReg = MF.getRegInfo().getCalleeSavedRegs();
    let mut BasePointerReg: MCRegister = if RegInfo.hasBasePointer(MF) { RegInfo.getBaseRegister() } else { MCRegister { Reg: 0 } };
    let mut ExtraCSSpill: Register = 0;
    let mut HasUnpairedGPR64: bool = false;
    let mut HasPairZReg: bool = false;
    let mut UserReservedRegs: BitVector = RegInfo.getUserReservedRegs(MF);
    let mut ReservedRegs: BitVector = RegInfo.getReservedRegs(MF);
    for let mut i: u32 = 0; CSRegs[i]; i += 1 {
        let mut Reg: MCRegister = CSRegs[i];
        if Reg == BasePointerReg {
            SavedRegs.set(Reg.operator unsigned int());
        }
        if UserReservedRegs[Reg.operator unsigned int()] {
            SavedRegs.reset(Reg.operator unsigned int());
            continue;
        }
        let mut RegUsed: bool = SavedRegs.test(Reg.operator unsigned int());
        let mut PairedReg: MCRegister = 0;
        let mut RegIsGPR64: bool = GPR64RegClass.contains(Reg);
        if RegIsGPR64 || FPR64RegClass.contains(Reg) || FPR128RegClass.contains(Reg) {
            if HasUnpairedGPR64 {
                PairedReg = CSRegs[if i % 2 == 0 { i - 1 } else { i + 1 }];
            } else {
                PairedReg = CSRegs[i ^ 1];
            }
        }
        if RegIsGPR64 && !GPR64RegClass.contains(PairedReg) {
            PairedReg = Register { Reg: 0 }.operator MCRegister();
            HasUnpairedGPR64 = true;
        }
        assert!(!PairedReg.isValid() || GPR64RegClass.contains(Reg, PairedReg) || FPR64RegClass.contains(Reg, PairedReg) || FPR128RegClass.contains(Reg, PairedReg);
        if !RegUsed {
            if GPR64RegClass.contains(Reg) && !ReservedRegs[Reg.operator unsigned int()] {
                UnspilledCSGPR = Reg;
                UnspilledCSGPRPaired = PairedReg;
            }
            continue;
        }
        if self.producePairRegisters(MF) && PairedReg.isValid() && !SavedRegs.test(PairedReg.operator unsigned int()) {
            SavedRegs.set(PairedReg.operator unsigned int());
            if GPR64RegClass.contains(PairedReg) && !ReservedRegs[PairedReg.operator unsigned int()] {
                ExtraCSSpill = PairedReg;
            }
        }
        HasPairZReg |= (ZPRRegClass.contains(Reg, CSRegs[i ^ 1]) && SavedRegs.test(CSRegs[i ^ 1]));
    }
    if HasPairZReg && enableMultiVectorSpillFill(Subtarget, MF) {
        let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
        let mut PnReg: MCRegister = findFreePredicateReg(SavedRegs);
        if PnReg.isValid() {
            AFI.setPredicateRegForFillSpill(PnReg.operator unsigned int());
        }
        if !AFI.getPredicateRegForFillSpill() && MF.getFunction().getCallingConv() == AArch64_SVE_VectorCall {
            SavedRegs.set(P8);
            AFI.setPredicateRegForFillSpill(PN8);
        }
        assert!(!ReservedRegs[AFI.getPredicateRegForFillSpill()], "Predicate cannot be a reserved register");
    }
    if MF.getFunction().getCallingConv() == Win64 && !Subtarget.isTargetWindows() {
        SavedRegs.set(X18);
    }
    self.determineStackHazardSlot(MF, SavedRegs);
    let mut CSStackSize: u32 = 0;
    let mut ZPRCSStackSize: u32 = 0;
    let mut PPRCSStackSize: u32 = 0;
    let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
    for Reg in SavedRegs.set_bits() {
        let mut RC: *TargetRegisterClass = TRI.getMinimalPhysRegClass(Reg);
        assert!(RC, "expected register class!");
        let mut SpillSize: u32 = TRI.getSpillSize(*RC);
        let mut IsZPR: bool = ZPRRegClass.contains(Reg);
        let mut IsPPR: bool = !IsZPR && PPRRegClass.contains(Reg);
        if IsZPR {
            ZPRCSStackSize += SpillSize;
        } else if IsPPR {
            PPRCSStackSize += SpillSize;
        } else {
            let mut SavedSuper: bool = any_of(TRI.superregs(Reg), Closure_12 { SavedRegs: &mut SavedRegs });
            if !SavedSuper {
                CSStackSize += SpillSize;
            }
        }
    }
    let mut NumSavedRegs: u32 = SavedRegs.count();
    if AFI.isStackHazardIncludedInCalleeSaveArea() {
        CSStackSize += getStackHazardSize(MF);
    }
    if self.requiresSaveVG(MF) {
        CSStackSize += 8;
    }
    if self.requiresSaveVG(MF) && !Subtarget.hasSVE() {
        SavedRegs.set(LR);
    }
    let mut EstimatedStackSize: u64 = MFI.estimateStackSize(MF);
    if self.hasFP(MF) || self.windowsRequiresStackProbe(MF, EstimatedStackSize + CSStackSize + 16) {
        SavedRegs.set(FP);
        SavedRegs.set(LR);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            {
                dbgs() << "*** determineCalleeSaves\nSaved CSRs:";
                for Reg in SavedRegs.set_bits() {
                    dbgs() << ' ' << printReg(Reg, RegInfo, 0, null);
                }
                dbgs() << "\n";
            }
        }
    }
        if !(false) { break; }
    }
    let mut SVELocals: u64 = ZPRLocalStackSize + PPRLocalStackSize;
    let mut SVEStackSize: u64 = alignTo(ZPRCSStackSize + PPRCSStackSize + SVELocals, 16);
    let mut CanEliminateFrame: bool = (SavedRegs.count() == 0) && !SVEStackSize;
    let mut EstimatedStackSizeLimit: u32 = estimateRSStackSizeLimit(MF);
    let mut CalleeStackUsed: i64 = 0;
    for let mut I: i32 = MFI.getObjectIndexBegin(); I != 0; I += 1 {
        let mut FixedOff: i64 = MFI.getObjectOffset(I);
        if FixedOff > CalleeStackUsed {
            CalleeStackUsed = FixedOff;
        }
    }
    let mut BigStack: bool = SVEStackSize || (EstimatedStackSize + CSStackSize + CalleeStackUsed) > EstimatedStackSizeLimit;
    if BigStack || !CanEliminateFrame || RegInfo.cannotEliminateFrame(MF) {
        AFI.setHasStackFrame(true);
    }
    if BigStack {
        if !ExtraCSSpill.isValid() && UnspilledCSGPR.isValid() {
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Spilling " << printReg(UnspilledCSGPR, RegInfo, 0, null) << " to get a scratch register.\n";
                }
            }
                if !(false) { break; }
            }
            SavedRegs.set(UnspilledCSGPR.operator unsigned int());
            ExtraCSSpill = UnspilledCSGPR;
            if self.producePairRegisters(MF) {
                if !UnspilledCSGPRPaired.isValid() {
                    if produceCompactUnwindFrame(*self, MF) {
                        SavedRegs.reset(UnspilledCSGPR.operator unsigned int());
                        ExtraCSSpill = Register { Reg: 0 };
                    }
                } else {
                    SavedRegs.set(UnspilledCSGPRPaired.operator unsigned int());
                }
            }
        }
        if !ExtraCSSpill.isValid() || MF.getRegInfo().isPhysRegUsed(ExtraCSSpill.operator MCRegister(), false) {
            let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
            let mut RC: *TargetRegisterClass = GPR64RegClass;
            let mut Size: u32 = TRI.getSpillSize(RC);
            let mut Alignment: Align = TRI.getSpillAlign(RC);
            let mut FI: i32 = MFI.CreateSpillStackObject(Size, Alignment, Default);
            RS.addScavengingFrameIndex(FI);
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "No available CS registers, allocated fi#" << FI << " as the emergency spill slot.\n";
                }
            }
                if !(false) { break; }
            }
        }
    }
    CSStackSize += 8 * (SavedRegs.count() - NumSavedRegs);
    if self.hasFP(MF) && AFI.hasSwiftAsyncContext() {
        CSStackSize += 8;
    }
    let mut AlignedCSStackSize: u64 = alignTo(CSStackSize, 16);
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            dbgs() << "Estimated stack frame size: " << EstimatedStackSize + AlignedCSStackSize << " bytes.\n";
        }
    }
        if !(false) { break; }
    }
    assert!((!MFI.isCalleeSavedInfoValid() || AFI.getCalleeSavedStackSize() == AlignedCSStackSize), "Should not invalidate callee saved info");
    AFI.setCalleeSavedStackSize(AlignedCSStackSize);
    AFI.setCalleeSaveStackHasFreeSpace(AlignedCSStackSize != CSStackSize);
    AFI.setSVECalleeSavedStackSize(ZPRCSStackSize, alignTo(PPRCSStackSize, 16));
}

fn orderZPRCalleeSavesForPairs(MF: *mut MachineFunction, RegInfo: *TargetRegisterInfo, CSI: *mut []CalleeSavedInfo) {
    assert!(!isTargetWindows(MF), "ZPR callee-save reordering not supported on Windows");
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    if !AFI.getPredicateRegForFillSpill() {
        return;
    }
    let mut ZPRSaves: SmallVector<CalleeSavedInfo> = SmallVector<CalleeSavedInfo> {};
    let mut ZPRPositions: SmallVector<size_t> = SmallVector<size_t> {};
    for x in enumerate(CSI) {
        if ZPRRegClass.contains(CS.getReg()) {
            ZPRSaves.push(CS);
            ZPRPositions.push(Index);
        }
    }
    if ZPRSaves.len < 2 {
        return;
    }
    sort(ZPRSaves, Closure_13 {});
    let mut Pairs: pair<CalleeSavedInfo, CalleeSavedInfo>> = pair<CalleeSavedInfo, CalleeSavedInfo>> {};
    let mut Singles: SmallVector<CalleeSavedInfo> = SmallVector<CalleeSavedInfo> {};
    for let mut i: u64 = 0; i < ZPRSaves.len;  {
        if i + 1 < ZPRSaves.len && (ZPRSaves[i].getReg().operator unsigned int() + 1 == ZPRSaves[i + 1].getReg().operator unsigned int()) && (ZPRSaves[i].getReg().operator unsigned int() - Z0) % 2 == 0 {
            Pairs.push(ZPRSaves[i], ZPRSaves[i + 1]);
            i += 2;
        } else {
            Singles.push(ZPRSaves[i += 1]);
        }
    }
    let mut ZPRByteOffset: i32 = AFI.getZPRCalleeSavedStackSize();
    if !AFI.hasSplitSVEObjects() {
        ZPRByteOffset += AFI.getPPRCalleeSavedStackSize();
    }
    let mut Scale: i32 = RegInfo.getSpillSize(ZPRRegClass);
    let mut LowestOffset: i32 = (ZPRByteOffset / Scale) - ZPRSaves.len as i32;
    let mut AlignmentSingle: optional<CalleeSavedInfo> = optional<CalleeSavedInfo> {};
    if LowestOffset % 2 != 0 {
        if !Singles.is_empty() {
            AlignmentSingle = Singles.pop_back_val();
        } else {
            assert!(!Pairs.is_empty(), "Expected a ZPR pair to split");
            AlignmentSingle = Odd;
            Singles.push(Even);
        }
    }
    if Pairs.is_empty() {
        return;
    }
    let mut ZPRSavesInCSIOrder: SmallVector<CalleeSavedInfo> = SmallVector<CalleeSavedInfo> {};
    append_range(ZPRSavesInCSIOrder, Singles);
    for x in Pairs {
        ZPRSavesInCSIOrder.push(Even);
        ZPRSavesInCSIOrder.push(Odd);
    }
    if AlignmentSingle {
        ZPRSavesInCSIOrder.push(operator(AlignmentSingle));
    }
    assert!(ZPRSavesInCSIOrder.len == ZPRPositions.len, "Reordering should not change the number of ZPR spills");
    for x in zip(ZPRPositions, ZPRSavesInCSIOrder) {
        CSI[Position] = CS;
    }
}

fn AArch64FrameLowering::assignCalleeSavedSpillSlots(self: *AArch64FrameLowering, MF: *mut MachineFunction, RegInfo: *TargetRegisterInfo, CSI: *mut []CalleeSavedInfo) -> bool {
    let mut IsWindows: bool = isTargetWindows(MF);
    let mut StackHazardSize: u32 = getStackHazardSize(MF);
    if IsWindows {
        reverse(CSI.begin(), CSI.end());
    }
    if CSI.is_empty() {
        return true;
    }
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    if self.requiresSaveVG(MF) {
        let mut VGInfo: CalleeSavedInfo = CalleeSavedInfo { VG, 0 };
        let mut It: CalleeSavedInfo>>> = find_if(CSI, Closure_14 {});
        if !It == CSI.end() {
            CSI.insert(It, VGInfo);
        } else {
            CSI.push(VGInfo);
        }
    }
    let mut Subtarget: *AArch64Subtarget = MF.getSubtarget();
    if !IsWindows && enableMultiVectorSpillFill(Subtarget, MF) {
        orderZPRCalleeSavesForPairs(MF, RegInfo, CSI);
    }
    let mut LastReg: Register = 0;
    let mut HazardSlotIndex: i32 = max();
    for CS in CSI {
        let mut Reg: MCRegister = CS.getReg();
        let mut RC: *TargetRegisterClass = RegInfo.getMinimalPhysRegClass(Reg);
        if AFI.isStackHazardIncludedInCalleeSaveArea() && (!LastReg.operator unsigned int() || !isFpOrNEON(LastReg)) && isFpOrNEON(Reg) {
            assert!(HazardSlotIndex == max(), "Unexpected register order for hazard slot");
            HazardSlotIndex = MFI.CreateStackObject(StackHazardSize, 8, true, null, 0);
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Created CSR Hazard at slot " << HazardSlotIndex << "\n";
                }
            }
                if !(false) { break; }
            }
            AFI.setStackHazardCSRSlotIndex(HazardSlotIndex);
            MFI.setIsCalleeSavedObjectIndex(HazardSlotIndex, true);
        }
        let mut Size: u32 = RegInfo.getSpillSize(*RC);
        let mut Alignment: Align = RegInfo.getSpillAlign(*RC);
        let mut FrameIdx: i32 = MFI.CreateStackObject(Size, Alignment, true, null, 0);
        CS.setFrameIdx(FrameIdx);
        MFI.setIsCalleeSavedObjectIndex(FrameIdx, true);
        if self.hasFP(MF) && AFI.hasSwiftAsyncContext() && Reg == FP {
            FrameIdx = MFI.CreateStackObject(8, Alignment, true, null, 0);
            AFI.setSwiftAsyncContextFrameIdx(FrameIdx);
            MFI.setIsCalleeSavedObjectIndex(FrameIdx, true);
        }
        LastReg = Reg;
    }
    if AFI.isStackHazardIncludedInCalleeSaveArea() && HazardSlotIndex == max() {
        HazardSlotIndex = MFI.CreateStackObject(StackHazardSize, 8, true, null, 0);
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Created CSR Hazard at slot " << HazardSlotIndex << "\n";
            }
        }
            if !(false) { break; }
        }
        AFI.setStackHazardCSRSlotIndex(HazardSlotIndex);
        MFI.setIsCalleeSavedObjectIndex(HazardSlotIndex, true);
    }
    return true;
}

fn AArch64FrameLowering::enableStackSlotScavenging(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut AFI: *AArch64FunctionInfo = MF.getInfo();
    if AFI.hasStreamingModeChanges() && !self.hasFP(MF) {
        return false;
    }
    if AFI.hasStackHazardSlotIndex() {
        return false;
    }
    return AFI.hasCalleeSaveStackFreeSpace();
}

fn getSVECalleeSaveSlotRange(MFI: *MachineFrameInfo, Min: *mut i32, Max: *mut i32) -> bool {
    Min = max();
    Max = min();
    if !MFI.isCalleeSavedInfoValid() {
        return false;
    }
    let mut CSI: *[]CalleeSavedInfo = MFI.getCalleeSavedInfo();
    for CS in CSI {
        if ZPRRegClass.contains(CS.getReg()) || PPRRegClass.contains(CS.getReg()) {
            assert!((Max == min() || Max + 1 == CS.getFrameIdx()), "SVE CalleeSaves are not consecutive");
            Min = if Min < CS.getFrameIdx() { Min } else { CS.getFrameIdx() };
            Max = if Max > CS.getFrameIdx() { Max } else { CS.getFrameIdx() };
        }
    }
    return Min != max();
}

fn determineSVEStackSizes(MF: *mut MachineFunction, AssignOffsets: AssignObjectOffsets) -> SVEStackSizes {
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    let mut SVEStack: SVEStackSizes = SVEStackSizes { ZPRStackSize: u64 { 0 }, PPRStackSize: u64 { 0 } };
    let mut ZPRStackTop: *mut u64 = SVEStack.ZPRStackSize;
    let mut PPRStackTop: *mut u64 = if AFI.hasSplitSVEObjects() { SVEStack.PPRStackSize } else { SVEStack.ZPRStackSize };
    for let mut I: i32 = MFI.getObjectIndexBegin(); I != 0; I += 1 {
        assert!(!MFI.hasScalableStackID(I), "SVE vectors should never be passed on the stack by value, only by reference.");
    }
    let mut AllocateObject: Closure_15 = Closure_15 { MFI: &mut MFI, ZPRStackTop: &mut ZPRStackTop, PPRStackTop: &mut PPRStackTop, AssignOffsets: &mut AssignOffsets };
    let mut MinCSFrameIndex: i32 = 0;
    let mut MaxCSFrameIndex: i32 = 0;
    if getSVECalleeSaveSlotRange(MFI, MinCSFrameIndex, MaxCSFrameIndex) {
        for let mut FI: i32 = MinCSFrameIndex; FI <= MaxCSFrameIndex; FI += 1 {
            AllocateObject.call(FI);
        }
    }
    PPRStackTop = alignTo(PPRStackTop, 16);
    ZPRStackTop = alignTo(ZPRStackTop, 16);
    let mut ObjectsToAllocate: SmallVector<int, 8> = SmallVector<int, 8> {};
    let mut StackProtectorFI: i32 = -1;
    if MFI.hasStackProtectorIndex() {
        StackProtectorFI = MFI.getStackProtectorIndex();
        if MFI.getStackID(StackProtectorFI) == ScalableVector {
            ObjectsToAllocate.push(StackProtectorFI);
        }
    }
    for let mut FI: i32 = 0;
let mut E: i32 = MFI.getObjectIndexEnd(); FI != E; FI += 1 {
        if FI == StackProtectorFI || MFI.isDeadObjectIndex(FI) || MFI.isCalleeSavedObjectIndex(FI) {
            continue;
        }
        if MFI.getStackID(FI) != ScalableVector && MFI.getStackID(FI) != ScalablePredicateVector {
            continue;
        }
        ObjectsToAllocate.push(FI);
    }
    for FI in ObjectsToAllocate {
        AllocateObject.call(FI);
    }
    PPRStackTop = alignTo(PPRStackTop, 16);
    ZPRStackTop = alignTo(ZPRStackTop, 16);
    if AssignOffsets == Yes {
        AFI.setStackSizeSVE(SVEStack.ZPRStackSize, SVEStack.PPRStackSize);
    }
    return SVEStack;
}

fn AArch64FrameLowering::processFunctionBeforeFrameFinalized(self: *AArch64FrameLowering, MF: *mut MachineFunction, RS: *mut RegScavenger) {
    assert!(self.getStackGrowthDirection() == StackGrowsDown, "Upwards growing stack unsupported");
    determineSVEStackSizes(MF, Yes) as void;
    if !MF.hasEHFunclets() {
        return;
    }
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    let mut EHInfo: *mut WinEHFuncInfo = *MF.getWinEHFuncInfo();
    let mut CurrentOffset: i64 = AFI.getVarArgsGPRSize() + AFI.getTailCallReservedStack();
    for TBME in EHInfo.TryBlockMap {
        for H in TBME.HandlerArray {
            let mut FrameIndex: i32 = H.CatchObj.FrameIndex;
            if (FrameIndex != 2147483647) && MFI.getObjectOffset(FrameIndex) == 0 {
                CurrentOffset = alignTo(CurrentOffset, MFI.getObjectAlign(FrameIndex).value());
                CurrentOffset += MFI.getObjectSize(FrameIndex);
                MFI.setObjectOffset(FrameIndex, -CurrentOffset);
            }
        }
    }
    let mut UnwindHelpOffset: i64 = alignTo(CurrentOffset + 8, 16);
    assert!(UnwindHelpOffset == self.getFixedObjectSize(MF, AFI, true, false), "UnwindHelpOffset must be at the start of the fixed object area");
    let mut UnwindHelpFI: i32 = MFI.CreateFixedObject(8, -UnwindHelpOffset, false, false);
    EHInfo.UnwindHelpFrameIdx = UnwindHelpFI;
    let mut MBB: *mut MachineBasicBlock = MF.front();
    let mut MBBI: iterator = MBB.begin();
    while MBBI != MBB.end() && operator(MBBI).getFlag(FrameSetup) {
        operator(MBBI);
    }
    let mut DL: DebugLoc = null;
    RS.enterBasicBlockEnd(MBB);
    RS.backward(MBBI);
    let mut DstReg: Register = RS.FindUnusedReg(&mut GPR64commonRegClass);
    assert!(DstReg.operator unsigned int(), "There must be a free register after frame setup");
    let mut TII: *AArch64InstrInfo = *MF.getSubtarget().getInstrInfo();
    BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(MOVi64imm), DstReg).addImm(-2);
    BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(STURXi)).addReg(DstReg, getKillRegState(true), 0).addFrameIndex(UnwindHelpFI).addImm(0);
}

struct TagStoreInstr {
    MI: *mut MachineInstr,
    Offset: i64,
    Size: i64,
}

fn TagStoreInstr::operator=(self, arg: *mut *mut TagStoreInstr) -> *mut TagStoreInstr {
    self.MI =  as TagStoreInstr.MI;
    self.Offset =  as TagStoreInstr.Offset;
    self.Size =  as TagStoreInstr.Size;
    return *self;
}

struct TagStoreEdit {
    MF: *mut MachineFunction,
    MBB: *mut MachineBasicBlock,
    MRI: *mut MachineRegisterInfo,
    TagStores: SmallVector<TagStoreInstr, 8>,
    CombinedMemRefs: SmallVector<MachineMemOperand *, 8>,
    FrameReg: Register,
    FrameRegOffset: StackOffset,
    Size: i64,
    FrameRegUpdate: optional<int64_t>,
    FrameRegUpdateFlags: u32,
    ZeroData: bool,
    DL: DebugLoc,
}

fn TagStoreEdit::TagStoreEdit(self, MBB: *mut MachineBasicBlock, ZeroData: bool) {
    self.MF = MBB.getParent();
    self.MRI = &mut self.MF.getRegInfo();
}

fn TagStoreEdit::addInstruction(self, I: TagStoreInstr) {
    assert!((self.TagStores.is_empty() || self.TagStores.back().Offset + self.TagStores.back().Size == I.Offset), "Non-adjacent tag store instructions.");
    self.TagStores.push(I);
}

fn TagStoreEdit::clear(self) {
    self.TagStores.clear();
}

fn TagStoreEdit::emitUnrolled(self, InsertI: iterator) {
    let mut TII: *AArch64InstrInfo = self.MF.getSubtarget().getInstrInfo();
    let mut kMinOffset: i64 = -256 * 16;
    let mut kMaxOffset: i64 = 255 * 16;
    let mut BaseReg: Register = self.FrameReg;
    let mut BaseRegOffsetBytes: i64 = self.FrameRegOffset.getFixed();
    if BaseRegOffsetBytes < kMinOffset || BaseRegOffsetBytes + (self.Size - self.Size % 32) > kMaxOffset || BaseRegOffsetBytes % 16 != 0 {
        let mut ScratchReg: Register = self.MRI.createVirtualRegister(&mut GPR64RegClass, "");
        emitFrameOffset(*self.MBB, InsertI, self.DL, ScratchReg.operator unsigned int(), BaseReg.operator unsigned int(), getFixed(BaseRegOffsetBytes), TII, NoFlags, false, false, null, false, StackOffset {}, SP);
        BaseReg = ScratchReg;
        BaseRegOffsetBytes = 0;
    }
    let mut LastI: *mut MachineInstr = null;
    while self.Size {
        let mut InstrSize: i64 = if (self.Size > 16) { 32 } else { 16 };
        let mut Opcode: u32 = if InstrSize == 16 { (if self.ZeroData { STZGi } else { STGi }) } else { (if self.ZeroData { STZ2Gi } else { ST2Gi }) };
        assert!(BaseRegOffsetBytes % 16 == 0);
        let mut I: *mut MachineInstr = BuildMI(*self.MBB, InsertI, MIMetadata { DL: self.DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Opcode)).addReg(SP, RegState {}, 0).addReg(BaseReg, RegState {}, 0).addImm(BaseRegOffsetBytes / 16).setMemRefs(self.CombinedMemRefs).operator llvm::MachineInstr *();
        if BaseRegOffsetBytes == 0 {
            LastI = I;
        }
        BaseRegOffsetBytes += InstrSize;
        self.Size -= InstrSize;
    }
    if LastI {
        self.MBB.splice(InsertI, self.MBB, LastI);
    }
}

fn TagStoreEdit::emitLoop(self, InsertI: iterator) {
    let mut TII: *AArch64InstrInfo = self.MF.getSubtarget().getInstrInfo();
    let mut BaseReg: Register = if self.FrameRegUpdate { self.FrameReg } else { self.MRI.createVirtualRegister(&mut GPR64RegClass, "") };
    let mut SizeReg: Register = self.MRI.createVirtualRegister(&mut GPR64RegClass, "");
    emitFrameOffset(*self.MBB, InsertI, self.DL, BaseReg.operator unsigned int(), self.FrameReg.operator unsigned int(), self.FrameRegOffset, TII, NoFlags, false, false, null, false, StackOffset {}, SP);
    let mut LoopSize: i64 = self.Size;
    if self.FrameRegUpdate && operator(self.FrameRegUpdate) {
        LoopSize -= LoopSize % 32;
    }
    let mut LoopI: *mut MachineInstr = BuildMI(*self.MBB, InsertI, MIMetadata { DL: self.DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(if self.ZeroData { STZGloop_wback } else { STGloop_wback })).addDef(SizeReg, RegState {}, 0).addDef(BaseReg, RegState {}, 0).addImm(LoopSize).addReg(BaseReg, RegState {}, 0).setMemRefs(self.CombinedMemRefs).operator llvm::MachineInstr *();
    if self.FrameRegUpdate {
        LoopI.setFlags(self.FrameRegUpdateFlags);
    }
    let mut ExtraBaseRegUpdate: i64 = if self.FrameRegUpdate { (operator(self.FrameRegUpdate) - self.FrameRegOffset.getFixed() - self.Size) } else { 0 };
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            dbgs() << "TagStoreEdit::emitLoop: LoopSize=" << LoopSize << ", Size=" << self.Size << ", ExtraBaseRegUpdate=" << ExtraBaseRegUpdate << ", FrameRegUpdate=" << self.FrameRegUpdate << ", FrameRegOffset.getFixed()=" << self.FrameRegOffset.getFixed() << "\n";
        }
    }
        if !(false) { break; }
    }
    if LoopSize < self.Size {
        assert!(self.FrameRegUpdate);
        assert!(self.Size - LoopSize == 16);
        let mut STGOffset: i64 = ExtraBaseRegUpdate + 16;
        assert!(STGOffset % 16 == 0 && STGOffset >= -4096 && STGOffset <= 4080, "STG immediate out of range");
        BuildMI(*self.MBB, InsertI, MIMetadata { DL: self.DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(if self.ZeroData { STZGPostIndex } else { STGPostIndex })).addDef(BaseReg, RegState {}, 0).addReg(BaseReg, RegState {}, 0).addReg(BaseReg, RegState {}, 0).addImm(STGOffset / 16).setMemRefs(self.CombinedMemRefs).setMIFlags(self.FrameRegUpdateFlags);
    } else if ExtraBaseRegUpdate {
        let mut AddSubOffset: i64 = if ExtraBaseRegUpdate < 0 { -ExtraBaseRegUpdate } else { ExtraBaseRegUpdate };
        assert!(AddSubOffset <= 4095, "ADD/SUB immediate out of range");
        BuildMI(*self.MBB, InsertI, MIMetadata { DL: self.DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(if ExtraBaseRegUpdate > 0 { ADDXri } else { SUBXri })).addDef(BaseReg, RegState {}, 0).addReg(BaseReg, RegState {}, 0).addImm(AddSubOffset).addImm(0).setMIFlags(self.FrameRegUpdateFlags);
    }
}

fn canMergeRegUpdate(II: iterator, Reg: u32, Size: i64, TotalOffset: *mut i64) -> bool {
    let mut MI: *mut MachineInstr = operator(II);
    if (MI.getOpcode() == ADDXri || MI.getOpcode() == SUBXri) && MI.getOperand(0).getReg() == Reg && MI.getOperand(1).getReg() == Reg {
        let mut Shift: u32 = getShiftValue(MI.getOperand(3).getImm());
        let mut Offset: i64 = MI.getOperand(2).getImm() << Shift;
        if MI.getOpcode() == SUBXri {
            Offset = -Offset;
        }
        let mut PostOffset: i64 = Offset - Size;
        let mut kMaxOffset: i64 = 4080 - 16;
        let mut kMinOffset: i64 = -4095;
        if PostOffset <= kMaxOffset && PostOffset >= kMinOffset && PostOffset % 16 == 0 {
            *TotalOffset = Offset;
            return true;
        }
    }
    return false;
}

fn mergeMemRefs(TSE: *SmallVectorImpl<TagStoreInstr>, MemRefs: *mut SmallVectorImpl<MachineMemOperand *>) {
    MemRefs.clear();
    for TS in TSE {
        let mut MI: *mut MachineInstr = TS.MI;
        if MI.memoperands_empty() {
            MemRefs.clear();
            return;
        }
        MemRefs.append(MI.memoperands_begin(), MI.memoperands_end());
    }
}

fn TagStoreEdit::emitCode(self, InsertI: *mut iterator, TFI: *AArch64FrameLowering, TryMergeSPUpdate: bool) {
    if self.TagStores.is_empty() {
        return;
    }
    let mut FirstTagStore: *mut TagStoreInstr = self.TagStores[0];
    let mut LastTagStore: *mut TagStoreInstr = self.TagStores[self.TagStores.len - 1];
    self.Size = LastTagStore.Offset - FirstTagStore.Offset + LastTagStore.Size;
    self.DL = self.TagStores[0].MI.getDebugLoc();
    let mut Reg: Register = 0;
    self.FrameRegOffset = TFI.resolveFrameOffsetReference(*self.MF, FirstTagStore.Offset, false, Default, Reg, false, true);
    self.FrameReg = Reg;
    self.FrameRegUpdate = nullopt;
    mergeMemRefs(self.TagStores, self.CombinedMemRefs);
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            {
                dbgs() << "Replacing adjacent STG instructions:\n";
                for Instr in self.TagStores {
                    dbgs() << "  " << *Instr.MI;
                }
            }
        }
    }
        if !(false) { break; }
    }
    let mut kSetTagLoopThreshold: i32 = 176;
    if self.Size < kSetTagLoopThreshold {
        if self.TagStores.len < 2 {
            return;
        }
        self.emitUnrolled(InsertI);
    } else {
        let mut UpdateInstr: *mut MachineInstr = null;
        let mut TotalOffset: i64 = 0;
        if TryMergeSPUpdate {
            if InsertI != self.MBB.end() && canMergeRegUpdate(InsertI, self.FrameReg.operator unsigned int(), self.FrameRegOffset.getFixed() + self.Size, &mut TotalOffset) {
                UpdateInstr = &mut operator(operator(InsertI, 0));
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("frame-info", 1) {
                        dbgs() << "Folding SP update into loop:\n  " << *UpdateInstr;
                    }
                }
                    if !(false) { break; }
                }
            }
        }
        if !UpdateInstr && self.TagStores.len < 2 {
            return;
        }
        if UpdateInstr {
            self.FrameRegUpdate = TotalOffset;
            self.FrameRegUpdateFlags = UpdateInstr.getFlags();
        }
        self.emitLoop(InsertI);
        if UpdateInstr {
            UpdateInstr.eraseFromParent();
        }
    }
    for TS in self.TagStores {
        TS.MI.eraseFromParent();
    }
}

fn isMergeableStackTaggingInstruction(MI: *mut MachineInstr, Offset: *mut i64, Size: *mut i64, ZeroData: *mut bool) -> bool {
    let mut MF: *mut MachineFunction = *MI.getParent().getParent();
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut Opcode: u32 = MI.getOpcode();
    ZeroData = (Opcode == STZGloop || Opcode == STZGi || Opcode == STZ2Gi);
    if Opcode == STGloop || Opcode == STZGloop {
        if !MI.getOperand(0).isDead() || !MI.getOperand(1).isDead() {
            return false;
        }
        if !MI.getOperand(2).isImm() || !MI.getOperand(3).isFI() {
            return false;
        }
        Offset = MFI.getObjectOffset(MI.getOperand(3).getIndex());
        Size = MI.getOperand(2).getImm();
        return true;
    }
    if Opcode == STGi || Opcode == STZGi {
        Size = 16;
    } else if Opcode == ST2Gi || Opcode == STZ2Gi {
        Size = 32;
    } else {
        return false;
    }
    if MI.getOperand(0).getReg() != SP || !MI.getOperand(1).isFI() {
        return false;
    }
    Offset = MFI.getObjectOffset(MI.getOperand(1).getIndex()) + 16 * MI.getOperand(2).getImm();
    return true;
}

fn countAvailableScavengerSlots(LiveRegs: *mut LivePhysRegs, MRI: *mut MachineRegisterInfo, RS: *mut RegScavenger) -> u64 {
    let mut FreeGPRs: _Iter_diff_t<const unsigned short *> = count_if(GPR64RegClass, Closure_16 { LiveRegs: &mut LiveRegs, MRI: &mut MRI });
    let mut NumEmergencySlots: u64 = 0;
    if RS {
        NumEmergencySlots = RS.getNumScavengingFrameIndices();
    }
    return FreeGPRs + NumEmergencySlots;
}

fn tryMergeAdjacentSTG(II: iterator, TFI: *AArch64FrameLowering, RS: *mut RegScavenger) -> iterator {
    let mut FirstZeroData: bool = false;
    let mut Size: i64 = 0;
    let mut Offset: i64 = 0;
    let mut MI: *mut MachineInstr = operator(II);
    let mut MBB: *mut MachineBasicBlock = MI.getParent();
    let mut NextI: iterator = operator(II);
    if &mut MI == &mut MBB.instr_back() {
        return II;
    }
    if !isMergeableStackTaggingInstruction(MI, Offset, Size, FirstZeroData) {
        return II;
    }
    let mut Instrs: SmallVector<TagStoreInstr, 4> = SmallVector<TagStoreInstr, 4> {};
    Instrs.push(&mut MI, Offset, Size);
    let mut kScanLimit: i32 = 10;
    let mut Count: i32 = 0;
    for let mut E: iterator = MBB.end(); NextI != E && Count < kScanLimit; operator(NextI) {
        let mut MI: *mut MachineInstr = operator(NextI);
        let mut ZeroData: bool = false;
        let mut Size: i64 = 0;
        let mut Offset: i64 = 0;
        if isMergeableStackTaggingInstruction(MI, Offset, Size, ZeroData) {
            if ZeroData != FirstZeroData {
                break;
            }
            Instrs.push(&mut MI, Offset, Size);
            continue;
        }
        if !MI.isTransient() {
            Count += 1;
        }
        if MI.getFlag(FrameSetup) || MI.getFlag(FrameDestroy) {
            break;
        }
        if MI.mayLoadOrStore(AnyInBundle) || MI.hasUnmodeledSideEffects() || MI.isCall(AnyInBundle) {
            break;
        }
    }
    let mut InsertI: iterator = Instrs.back().MI;
    let mut LiveRegs: LivePhysRegs = *(MBB.getParent().getSubtarget().getRegisterInfo());
    LiveRegs.addLiveOuts(*MBB);
    for let mut I: reverse_iterator = MBB.rbegin(); ; operator(I) {
        let mut MI: *mut MachineInstr = operator(I);
        if MI == InsertI {
            break;
        }
        LiveRegs.stepBackward(operator(I));
    }
    operator(InsertI, 0);
    if LiveRegs.contains(NZCV) {
        return InsertI;
    }
    if countAvailableScavengerSlots(LiveRegs, MBB.getParent().getRegInfo(), RS) < 2 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Failed to merge MTE stack tagging instructions into loop " << "due to high register pressure.\n";
            }
        }
            if !(false) { break; }
        }
        return InsertI;
    }
    stable_sort(Instrs, Closure_17 {});
    let mut CurOffset: i64 = Instrs[0].Offset;
    for Instr in Instrs {
        if CurOffset > Instr.Offset {
            return NextI;
        }
        CurOffset = Instr.Offset + Instr.Size;
    }
    let mut TSE: TagStoreEdit = TagStoreEdit { MBB, FirstZeroData };
    let mut EndOffset: optional<int64_t> = optional<int64_t> {};
    for Instr in Instrs {
        if EndOffset && operator(EndOffset) != Instr.Offset {
            TSE.emitCode(InsertI, TFI, false);
            TSE.clear();
        }
        TSE.addInstruction(Instr);
        EndOffset = Instr.Offset + Instr.Size;
    }
    let mut MF: *MachineFunction = MBB.getParent();
    TSE.emitCode(InsertI, TFI, !MF.getInfo().needsAsyncDwarfUnwindInfo(*MF));
    return InsertI;
}

fn AArch64FrameLowering::processFunctionBeforeFrameIndicesReplaced(self: *AArch64FrameLowering, MF: *mut MachineFunction, RS: *mut RegScavenger) {
    for BB in MF {
        for let mut II: iterator = BB.begin(); II != BB.end();  {
            if StackTaggingMergeSetTag {
                II = tryMergeAdjacentSTG(II, self, RS);
            }
        }
    }
    if !MF.getFunction().hasFnAttribute(Naked) && self.shouldSignReturnAddressEverywhere(MF) {
        self.emitPacRetPlusLeafHardening(MF);
    }
}

fn AArch64FrameLowering::getFrameIndexReferencePreferSP(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32, FrameReg: *mut Register, IgnoreSPUpdates: bool) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    if IgnoreSPUpdates {
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Offset from the SP for " << FI << " is " << MFI.getObjectOffset(FI) << "\n";
            }
        }
            if !(false) { break; }
        }
        FrameReg = SP;
        return getFixed(MFI.getObjectOffset(FI));
    }
    if MFI.hasVarSizedObjects() || MF.getInfo().hasSVEStackSize() || MF.getSubtarget().getRegisterInfo().hasStackRealignment(MF) {
        return self.getFrameIndexReference(MF, FI, FrameReg);
    }
    FrameReg = SP;
    return self.getStackOffset(MF, MFI.getObjectOffset(FI));
}

fn AArch64FrameLowering::getWinEHParentFrameOffset(self: *AArch64FrameLowering, MF: *MachineFunction) -> u32 {
    return 0;
}

fn AArch64FrameLowering::getWinEHFuncletFrameSize(self: *AArch64FrameLowering, MF: *MachineFunction) -> u32 {
    let mut CSSize: u32 = MF.getInfo().getCalleeSavedStackSize();
    return alignTo(CSSize + MF.getFrameInfo().getMaxCallFrameSize(), self.getStackAlign());
}

struct FrameObject {
    IsValid: bool,
    ObjectIndex: i32,
    GroupIndex: i32,
    ObjectFirst: bool,
    GroupFirst: bool,
    Accesses: u32,
}

fn FrameObject::operator=(self, arg: *mut *mut FrameObject) -> *mut FrameObject {
    self.IsValid =  as FrameObject.IsValid;
    self.ObjectIndex =  as FrameObject.ObjectIndex;
    self.GroupIndex =  as FrameObject.GroupIndex;
    self.ObjectFirst =  as FrameObject.ObjectFirst;
    self.GroupFirst =  as FrameObject.GroupFirst;
    self.Accesses =  as FrameObject.Accesses;
    return *self;
}

struct GroupBuilder {
    CurrentMembers: SmallVector<int, 8>,
    NextGroupIndex: i32,
    Objects: *mut []FrameObject,
}

fn GroupBuilder::AddMember(self, Index: i32) {
    self.CurrentMembers.push(Index);
}

fn GroupBuilder::EndCurrentGroup(self) {
    if self.CurrentMembers.len > 1 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "group:";
            }
        }
            if !(false) { break; }
        }
        for Index in self.CurrentMembers {
            self.Objects[Index].GroupIndex = self.NextGroupIndex;
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << " " << Index;
                }
            }
                if !(false) { break; }
            }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "\n";
            }
        }
            if !(false) { break; }
        }
        self.NextGroupIndex += 1;
    }
    self.CurrentMembers.clear();
}

fn FrameObjectCompare(A: *FrameObject, B: *FrameObject) -> bool {
    return operator(make_tuple(!A.IsValid, A.Accesses, A.ObjectFirst, A.GroupFirst, A.GroupIndex, A.ObjectIndex), make_tuple(!B.IsValid, B.Accesses, B.ObjectFirst, B.GroupFirst, B.GroupIndex, B.ObjectIndex)) < 0;
}

fn AArch64FrameLowering::orderFrameObjects(self: *AArch64FrameLowering, MF: *MachineFunction, ObjectsToAllocate: *mut SmallVectorImpl<int>) {
    let mut AFI: *AArch64FunctionInfo = *MF.getInfo();
    if (!OrderFrameObjects && !AFI.hasSplitSVEObjects()) || ObjectsToAllocate.is_empty() {
        return;
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut FrameObjects: []FrameObject = []FrameObject { MFI.getObjectIndexEnd(), FrameObject> {} };
    for Obj in ObjectsToAllocate {
        FrameObjects[Obj].IsValid = true;
        FrameObjects[Obj].ObjectIndex = Obj;
    }
    let mut GB: GroupBuilder = FrameObjects;
    for MBB in MF {
        for MI in MBB {
            if MI.isDebugInstr() {
                continue;
            }
            if AFI.hasStackHazardSlotIndex() {
                let mut FI: optional<int> = getLdStFrameID(MI, MFI);
                if FI && operator(FI) >= 0 && operator(FI) < FrameObjects.len as i32 {
                    if MFI.getStackID(operator(FI)) == ScalableVector || isFpOrNEON(MI) {
                        FrameObjects[operator(FI)].Accesses |= AccessFPR;
                    } else {
                        FrameObjects[operator(FI)].Accesses |= AccessGPR;
                    }
                }
            }
            let mut OpIndex: i32 = 0;
            match MI.getOpcode() {
                STGloop => {
                    STZGloop;
                },
                STGi => {
                    STZGi;
                },
                _ => {
                    OpIndex = -1;
                },
            }
            let mut TaggedFI: i32 = -1;
            if OpIndex >= 0 {
                let mut MO: *MachineOperand = MI.getOperand(OpIndex);
                if MO.isFI() {
                    let mut FI: i32 = MO.getIndex();
                    if FI >= 0 && FI < MFI.getObjectIndexEnd() && FrameObjects[FI].IsValid {
                        TaggedFI = FI;
                    }
                }
            }
            if TaggedFI >= 0 {
                GB.AddMember(TaggedFI);
            } else {
                GB.EndCurrentGroup();
            }
        }
        GB.EndCurrentGroup();
    }
    if AFI.hasStackHazardSlotIndex() {
        FrameObjects[AFI.getStackHazardSlotIndex()].Accesses = AccessHazard;
        for Obj in FrameObjects {
            if !Obj.Accesses || Obj.Accesses == (AccessGPR | AccessFPR) {
                Obj.Accesses = AccessGPR;
            }
        }
    }
    let mut TBPI: optional<int> = AFI.getTaggedBasePointerIndex();
    if TBPI {
        FrameObjects[operator(TBPI)].ObjectFirst = true;
        FrameObjects[operator(TBPI)].GroupFirst = true;
        let mut FirstGroupIndex: i32 = FrameObjects[operator(TBPI)].GroupIndex;
        if FirstGroupIndex >= 0 {
            for Object in FrameObjects {
                if Object.GroupIndex == FirstGroupIndex {
                    Object.GroupFirst = true;
                }
            }
        }
    }
    stable_sort(FrameObjects, FrameObjectCompare);
    let mut i: i32 = 0;
    for Obj in FrameObjects {
        if !Obj.IsValid {
            break;
        }
        ObjectsToAllocate[i += 1] = Obj.ObjectIndex;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            {
                dbgs() << "Final frame order:\n";
                for Obj in FrameObjects {
                    if !Obj.IsValid {
                        break;
                    }
                    dbgs() << "  " << Obj.ObjectIndex << ": group " << Obj.GroupIndex;
                    if Obj.ObjectFirst {
                        dbgs() << ", first";
                    }
                    if Obj.GroupFirst {
                        dbgs() << ", group-first";
                    }
                    dbgs() << "\n";
                }
            }
        }
    }
        if !(false) { break; }
    }
}

fn AArch64FrameLowering::inlineStackProbeLoopExactMultiple(self: *AArch64FrameLowering, MBBI: iterator, ProbeSize: i64, TargetReg: Register) -> iterator {
    let mut MBB: *mut MachineBasicBlock = *operator(MBBI).getParent();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut TII: *AArch64InstrInfo = MF.getSubtarget().getInstrInfo();
    let mut DL: DebugLoc = MBB.findDebugLoc(MBBI);
    let mut MBBInsertPoint: iterator = next(MBB.getIterator(), 1);
    let mut LoopMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(MBBInsertPoint, LoopMBB);
    let mut ExitMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(MBBInsertPoint, ExitMBB);
    emitFrameOffset(*LoopMBB, LoopMBB.end(), DL, SP, SP, getFixed(-ProbeSize), TII, FrameSetup, false, false, null, false, StackOffset {}, SP);
    BuildMI(*LoopMBB, LoopMBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LDRXui)).addDef(XZR, RegState {}, 0).addReg(SP, RegState {}, 0).addImm(0).addMemOperand(MF.getMachineMemOperand(getUnknownStack(MF), MOLoad | MOVolatile, 8, 8, MMOMetadata {}, System, NotAtomic, NotAtomic)).setMIFlags(FrameSetup);
    BuildMI(*LoopMBB, LoopMBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(SUBSXrx64), XZR).addReg(SP, RegState {}, 0).addReg(TargetReg, RegState {}, 0).addImm(getArithExtendImm(UXTX, 0)).setMIFlags(FrameSetup);
    BuildMI(*LoopMBB, LoopMBB.end(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Bcc)).addImm(NE).addMBB(LoopMBB, 0).setMIFlags(FrameSetup);
    LoopMBB.addSuccessor(ExitMBB, getUnknown());
    LoopMBB.addSuccessor(LoopMBB, getUnknown());
    ExitMBB.splice(ExitMBB.end(), &mut MBB, MBBI, MBB.end());
    ExitMBB.transferSuccessorsAndUpdatePHIs(&mut MBB);
    MBB.addSuccessor(LoopMBB, getUnknown());
    fullyRecomputeLiveIns([ExitMBB, LoopMBB]);
    return ExitMBB.begin();
}

fn AArch64FrameLowering::inlineStackProbeFixed(self: *AArch64FrameLowering, MBBI: iterator, ScratchReg: Register, FrameSize: i64, CFAOffset: StackOffset) {
    let mut MBB: *mut MachineBasicBlock = operator(MBBI).getParent();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut TII: *AArch64InstrInfo = MF.getSubtarget().getInstrInfo();
    let mut AFI: *mut AArch64FunctionInfo = MF.getInfo();
    let mut EmitAsyncCFI: bool = AFI.needsAsyncDwarfUnwindInfo(MF);
    let mut HasFP: bool = self.hasFP(MF);
    let mut DL: DebugLoc = null;
    let mut ProbeSize: i64 = MF.getInfo().getStackProbeSize();
    let mut NumBlocks: i64 = FrameSize / ProbeSize;
    let mut ResidualSize: i64 = FrameSize % ProbeSize;
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            dbgs() << "Stack probing: total " << FrameSize << " bytes, " << NumBlocks << " blocks of " << ProbeSize << " bytes, plus " << ResidualSize << " bytes\n";
        }
    }
        if !(false) { break; }
    }
    if NumBlocks <= StackProbeMaxLoopUnroll {
        for let mut i: i32 = 0; i < NumBlocks; i += 1 {
            emitFrameOffset(*MBB, MBBI, DL, SP, SP, getFixed(-ProbeSize), TII, FrameSetup, false, false, null, EmitAsyncCFI && !HasFP, CFAOffset, SP);
            operator(CFAOffset, getFixed(ProbeSize));
            BuildMI(*MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LDRXui)).addDef(XZR, RegState {}, 0).addReg(SP, RegState {}, 0).addImm(0).addMemOperand(MF.getMachineMemOperand(getUnknownStack(MF), MOLoad | MOVolatile, 8, 8, MMOMetadata {}, System, NotAtomic, NotAtomic)).setMIFlags(FrameSetup);
        }
    } else if NumBlocks != 0 {
        emitFrameOffset(*MBB, MBBI, DL, ScratchReg.operator unsigned int(), SP, getFixed(-ProbeSize * NumBlocks), TII, FrameSetup, false, false, null, EmitAsyncCFI && !HasFP, CFAOffset, SP);
        operator(CFAOffset, getFixed(ProbeSize * NumBlocks));
        MBBI = self.inlineStackProbeLoopExactMultiple(MBBI, ProbeSize, ScratchReg);
        MBB = operator(MBBI).getParent();
        if EmitAsyncCFI && !HasFP {
            CFIInstBuilder { *MBB, MBBI, FrameSetup, true }.buildDefCFARegister(SP);
        }
    }
    if ResidualSize != 0 {
        emitFrameOffset(*MBB, MBBI, DL, SP, SP, getFixed(-ResidualSize), TII, FrameSetup, false, false, null, EmitAsyncCFI && !HasFP, CFAOffset, SP);
        if ResidualSize > StackProbeMaxUnprobedStack {
            BuildMI(*MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(LDRXui)).addDef(XZR, RegState {}, 0).addReg(SP, RegState {}, 0).addImm(0).addMemOperand(MF.getMachineMemOperand(getUnknownStack(MF), MOLoad | MOVolatile, 8, 8, MMOMetadata {}, System, NotAtomic, NotAtomic)).setMIFlags(FrameSetup);
        }
    }
}

fn AArch64FrameLowering::inlineStackProbe(self: *AArch64FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock) {
    let mut ToReplace: SmallVector<MachineInstr *, 4> = SmallVector<MachineInstr *, 4> {};
    for MI in MBB {
        if MI.getOpcode() == PROBED_STACKALLOC || MI.getOpcode() == PROBED_STACKALLOC_VAR {
            ToReplace.push(&mut MI);
        }
    }
    for MI in ToReplace {
        if MI.getOpcode() == PROBED_STACKALLOC {
            let mut ScratchReg: Register = MI.getOperand(0).getReg();
            let mut FrameSize: i64 = MI.getOperand(1).getImm();
            let mut CFAOffset: StackOffset = get(MI.getOperand(2).getImm(), MI.getOperand(3).getImm());
            self.inlineStackProbeFixed(MI.getIterator(), ScratchReg, FrameSize, CFAOffset);
        } else {
            assert!(MI.getOpcode() == PROBED_STACKALLOC_VAR, "Stack probe pseudo-instruction expected");
            let mut TII: *AArch64InstrInfo = MI.getMF().getSubtarget().getInstrInfo();
            let mut TargetReg: Register = MI.getOperand(0).getReg();
            TII.probedStackAlloc(MI.getIterator(), TargetReg, true) as void;
        }
        MI.eraseFromParent();
    }
}

struct StackAccess {
    Idx: i32,
    Offset: StackOffset,
    Size: i64,
    AccessTypes: u32,
}

fn StackAccess::operator<(self: *StackAccess, Rhs: *StackAccess) -> bool {
    return operator(make_tuple(self.start(), self.Idx), make_tuple(Rhs.start(), Rhs.Idx)) < 0;
}

fn StackAccess::isCPU(self: *StackAccess) -> bool {
    return self.AccessTypes & (GPR | PPR);
}

fn StackAccess::isSME(self: *StackAccess) -> bool {
    return self.AccessTypes & FPR;
}

fn StackAccess::isMixed(self: *StackAccess) -> bool {
    return self.isCPU() && self.isSME();
}

fn StackAccess::start(self: *StackAccess) -> i64 {
    return self.Offset.getFixed() + self.Offset.getScalable();
}

fn StackAccess::end(self: *StackAccess) -> i64 {
    return self.start() + self.Size;
}

fn StackAccess::getTypeString(self: *StackAccess) -> str {
    match self.AccessTypes {
        FPR => {
            return "FPR";
        },
        PPR => {
            return "PPR";
        },
        GPR => {
            return "GPR";
        },
        NotAccessed => {
            return "NA";
        },
        _ => {
            return "Mixed";
        },
    }
}

fn StackAccess::print(self: *StackAccess, OS: *mut raw_ostream) {
    OS << self.getTypeString() << " stack object at [SP" << (if self.Offset.getFixed() < 0 { "" } else { "+" }) << self.Offset.getFixed();
    if self.Offset.getScalable() {
        OS << (if self.Offset.getScalable() < 0 { "" } else { "+" }) << self.Offset.getScalable() << " * vscale";
    }
    OS << "]";
}

fn StackAccess::operator=(self, arg: *mut *mut StackAccess) -> *mut StackAccess {
    self.Idx =  as StackAccess.Idx;
    self.Offset.operator=( as StackAccess.Offset);
    self.Size =  as StackAccess.Size;
    self.AccessTypes =  as StackAccess.AccessTypes;
    return *self;
}

fn op_<<(OS: *mut raw_ostream, SA: *StackAccess) -> *mut raw_ostream {
    SA.print(OS);
    return OS;
}

fn AArch64FrameLowering::emitRemarks(self: *AArch64FrameLowering, MF: *MachineFunction, ORE: *mut MachineOptimizationRemarkEmitter) {
    let mut AFI: *AArch64FunctionInfo = MF.getInfo();
    if AFI.getSMEFnAttrs().hasNonStreamingInterfaceAndBody() {
        return;
    }
    let mut StackHazardSize: u32 = getStackHazardSize(MF);
    let mut HazardSize: u64 = if (StackHazardSize) { StackHazardSize } else { StackHazardRemarkSize.operator unsigned int() };
    if HazardSize == 0 {
        return;
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    if !MFI.hasStackObjects() {
        return;
    }
    let mut StackAccesses: []StackAccess = []StackAccess { MFI.getNumObjects(), allocator<StackAccess> {} };
    let mut NumFPLdSt: u64 = 0;
    let mut NumNonFPLdSt: u64 = 0;
    for MBB in MF {
        for MI in MBB {
            if !MI.mayLoadOrStore(AnyInBundle) || MI.getNumMemOperands() < 1 {
                continue;
            }
            for MMO in MI.memoperands() {
                let mut FI: optional<int> = getMMOFrameID(MMO, MFI);
                if FI && !MFI.isDeadObjectIndex(operator(FI)) {
                    let mut FrameIdx: i32 = operator(FI);
                    let mut ArrIdx: u64 = FrameIdx + MFI.getNumFixedObjects();
                    if StackAccesses[ArrIdx].AccessTypes == NotAccessed {
                        StackAccesses[ArrIdx].Idx = FrameIdx;
                        StackAccesses[ArrIdx].Offset = self.getFrameIndexReferenceFromSP(MF, FrameIdx);
                        StackAccesses[ArrIdx].Size = MFI.getObjectSize(FrameIdx);
                    }
                    let mut RegTy: u32 = GPR;
                    if MFI.hasScalableStackID(FrameIdx) {
                        RegTy = if isPPRAccess(MI) { PPR } else { FPR };
                    } else if isFpOrNEON(MI) {
                        RegTy = FPR;
                    }
                    StackAccesses[ArrIdx].AccessTypes |= RegTy;
                    if RegTy == FPR {
                        NumFPLdSt += 1;
                    } else {
                        NumNonFPLdSt += 1;
                    }
                }
            }
        }
    }
    if NumFPLdSt == 0 || NumNonFPLdSt == 0 {
        return;
    }
    sort(StackAccesses);
    erase_if(StackAccesses, Closure_18 {});
    let mut MixedObjects: SmallVector<const StackAccess *> = SmallVector<const StackAccess *> {};
    let mut HazardPairs: pair<const StackAccess *, const StackAccess *>> = pair<const StackAccess *, const StackAccess *>> {};
    if StackAccesses.front().isMixed() {
        MixedObjects.push(&mut StackAccesses.front());
    }
    for let mut It: iterator = StackAccesses.begin();
let mut End: _Simple_types<StackAccess>>> = prev(StackAccesses.end(), 1); !It == End; operator(It) {
        let mut First: *value_type = operator(It);
        let mut Second: *value_type = operator((It + 1));
        if Second.isMixed() {
            MixedObjects.push(&mut Second);
        }
        if (First.isSME() && Second.isCPU()) || (First.isCPU() && Second.isSME()) {
            let mut Distance: u64 = Second.start() - First.end() as u64;
            if Distance < HazardSize {
                HazardPairs.push(&mut First, &mut Second);
            }
        }
    }
    let mut EmitRemark: Closure_19 = Closure_19 { ORE: &mut ORE, MF: &mut MF };
    for P in HazardPairs {
        EmitRemark.call(formatv("{0} is too close to {1}", *P.first, *P.second));
    }
    for Obj in MixedObjects {
        EmitRemark.call(formatv("{0} accessed by both GP and FP instructions", *Obj));
    }
}

struct Closure_1 {
    TII: *mut *AArch64InstrInfo,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MBB: *mut MachineBasicBlock) {
        let mut DL: DebugLoc = null;
        let mut MBBI: iterator = MBB.begin();
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, (*self.TII).get(PAUTH_PROLOGUE)).setMIFlag(FrameSetup);
    }

struct Closure_2 {
    TII: *mut *AArch64InstrInfo,
}

unsafe fn Closure_2::call(self: *mut Closure_2, MBB: *mut MachineBasicBlock) {
        let mut DL: DebugLoc = null;
        let mut MBBI: iterator = MBB.getFirstTerminator();
        if MBBI != MBB.end() {
            DL = operator(MBBI).getDebugLoc();
        }
        (*self.TII).createPauthEpilogueInstr(MBB, DL);
    }

struct Closure_3 {}

fn Closure_3::call(self: *Closure_3, CSI: *CalleeSavedInfo) -> bool {
        let mut Reg: *MCRegister = CSI.getReg();
        return Reg.operator unsigned int() >= X0 && Reg.operator unsigned int() <= X18;
    }

struct Closure_4 {
    StackFillDir: i32,
}

fn Closure_4::call(self: *Closure_4, Offset: i32, Align: i32) -> u32 {
        if self.StackFillDir < 0 {
            return alignDown(Offset, Align, 0);
        }
        return alignTo(Offset, Align);
    }

struct Closure_5 {
    RPI: *mut RegPairInfo,
    IsWindows: *mut bool,
    i: *mut u32,
    CSI: *mut ArrayRef<CalleeSavedInfo>,
}

unsafe fn Closure_5::call(self: *mut Closure_5) -> auto {
            if (*self.RPI).isPaired() {
                return if (*self.IsWindows) { (*self.RPI).Reg1 == FP && (*self.RPI).Reg2 == LR } else { (*self.RPI).Reg1 == LR && (*self.RPI).Reg2 == FP };
            }
            return (*self.i) > 0 && (*self.RPI).Reg1 == FP && (*self.CSI)[(*self.i) - 1].getReg() == LR;
        }

struct Closure_6 {
    X0Scratch: *mut Register,
    MBB: *mut MachineBasicBlock,
    MI: *mut iterator,
    DL: *mut DebugLoc,
    TII: *mut AArch64InstrInfo,
}

unsafe fn Closure_6::call(self: *mut Closure_6) -> auto {
            if (*self.X0Scratch).isValid() {
                BuildMI((*self.MBB), (*self.MI), MIMetadata { DL: (*self.DL), PCSections: null, MMRA: null, DeactivationSymbol: null }, (*self.TII).get(COPY), X0).addReg((*self.X0Scratch), RegState {}, 0).setMIFlag(FrameSetup);
            }
        }

struct Closure_7 {
    STI: *mut AArch64Subtarget,
}

unsafe fn Closure_7::call(self: *mut Closure_7, LiveIn: *RegisterMaskPair) -> bool {
                    return (*self.STI).getRegisterInfo().isSuperOrSubRegisterEq(X0, LiveIn.PhysReg);
                }

struct Closure_8 {}

fn Closure_8::call(self: *Closure_8, c: *RegPairInfo) -> bool {
        return c.Type == PPR;
    }

struct Closure_9 {}

fn Closure_9::call(self: *Closure_9, c: *RegPairInfo) -> bool {
        return c.Type == ZPR;
    }

struct Closure_10 {}

fn Closure_10::call(self: *Closure_10, Reg: u32) -> bool {
        return FPR64RegClass.contains(Reg) || FPR128RegClass.contains(Reg) || ZPRRegClass.contains(Reg);
    }

struct Closure_11 {}

fn Closure_11::call(self: *Closure_11, Reg: u32) -> bool {
        return PPRRegClass.contains(Reg);
    }

struct Closure_12 {
    SavedRegs: *mut BitVector,
}

unsafe fn Closure_12::call(self: *mut Closure_12, SuperReg: MCPhysReg) -> bool {
                return (*self.SavedRegs).test(SuperReg);
            }

struct Closure_13 {}

fn Closure_13::call(self: *Closure_13) {
        return A.getReg() < B.getReg();
    }

struct Closure_14 {}

fn Closure_14::call(self: *Closure_14) {
            return Info.getReg() == LR;
        }

struct Closure_15 {
    MFI: *mut MachineFrameInfo,
    ZPRStackTop: *mut u64,
    PPRStackTop: *mut u64,
    AssignOffsets: *mut AssignObjectOffsets,
}

unsafe fn Closure_15::call(self: *mut Closure_15, FI: i32) {
        let mut StackTop: *mut u64 = if (*self.MFI).getStackID(FI) == ScalableVector { (*self.ZPRStackTop) } else { (*self.PPRStackTop) };
        let mut Alignment: Align = (*self.MFI).getObjectAlign(FI);
        if Alignment > 16 {
            report_fatal_error("Alignment of scalable vectors > 16 bytes is not yet supported", true);
        }
        StackTop += (*self.MFI).getObjectSize(FI);
        StackTop = alignTo(StackTop, Alignment);
        assert!(StackTop < max() as u64, "SVE StackTop far too large?!");
        let mut Offset: i64 = -StackTop;
        if (*self.AssignOffsets) == Yes {
            (*self.MFI).setObjectOffset(FI, Offset);
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "alloc FI(" << FI << ") at SP[" << Offset << "]\n";
            }
        }
            if !(false) { break; }
        }
    }

struct Closure_16 {
    LiveRegs: *mut LivePhysRegs,
    MRI: *mut MachineRegisterInfo,
}

unsafe fn Closure_16::call(self: *mut Closure_16) {
        return (*self.LiveRegs).available((*self.MRI), Reg);
    }

struct Closure_17 {}

fn Closure_17::call(self: *Closure_17, Left: *TagStoreInstr, Right: *TagStoreInstr) -> bool {
        return Left.Offset < Right.Offset;
    }

struct Closure_18 {}

fn Closure_18::call(self: *Closure_18, S: *StackAccess) -> bool {
        return S.AccessTypes == NotAccessed;
    }

struct Closure_20 {
    MF: *mut MachineFunction,
    Str: *mut str,
}

unsafe fn Closure_20::call(self: *mut Closure_20) -> MachineOptimizationRemarkAnalysis {
            let mut R: MachineOptimizationRemarkAnalysis = MachineOptimizationRemarkAnalysis { "sme", "StackHazard", (*self.MF).getFunction().getSubprogram(), &mut (*self.MF).front() };
            return R << formatv("stack hazard in '{0}': ", (*self.MF).getName()) << (*self.Str);
        }

struct Closure_19 {
    ORE: *mut *mut MachineOptimizationRemarkEmitter,
    MF: *mut MachineFunction,
}

unsafe fn Closure_19::call(self: *mut Closure_19, Str: str) {
        (*self.ORE).emit(Closure_20 { MF: &mut (*self.MF), Str: &mut Str }, null);
    }
