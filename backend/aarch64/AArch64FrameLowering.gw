                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Calling convention is not supported with SplitSVEObjects\n";
                }
            }
                if !(false) { break; }
            }
            return;
        }
        if !HasPPRCSRs && !HasPPRStackObjects {
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Not using SplitSVEObjects as no PPRs are on the stack\n";
                }
            }
                if !(false) { break; }
            }
            return;
        }
        if !HasFPRCSRs && !HasFPRStackObjects {
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Not using SplitSVEObjects as no FPRs or ZPRs are on the stack\n";
                }
            }
                if !(false) { break; }
            }
            return;
        }
        let mut Subtarget: *AArch64Subtarget = MF;
        assert!(Subtarget.isSVEorStreamingSVEAvailable(), "Expected SVE to be available for PPRs");
        let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
        let mut FPRZRegs: BitVector = BitVector { Bits: SavedRegs.len, Size: false };
        for let mut Reg: u64 = 0;
let mut E: u64 = SavedRegs.len; HasFPRCSRs && Reg < E; Reg += 1 {
            let mut RegBit: reference = SavedRegs[Reg];
            if !RegBit {
                continue;
            }
            let mut SubRegIdx: u32 = 0;
            if  {
                
            } else if  {
                
            } else {
                continue;
            }
            RegBit = false;
            let mut ZReg: Register = TRI.getMatchingSuperReg;
            FPRZRegs.set(ZReg.operator unsigned int());
