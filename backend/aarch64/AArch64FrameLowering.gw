        return;
    }
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut HasFPRCSRs: bool = any_of(SavedRegs.set_bits(), Closure_8 {});
    let mut HasPPRCSRs: bool = any_of(SavedRegs.set_bits(), Closure_9 {});
    let mut HasFPRStackObjects: bool = false;
    let mut HasPPRStackObjects: bool = false;
    if !HasFPRCSRs ||  {
        let mut SlotTypes: i32 = MFI.getObjectIndexEnd();
        for MBB in MF {
            for MI in MBB {
                let mut FI: optional<int> = zeroed();
                if operator!() ||  < 0 ||  > () {
                    continue;
                }
                if MFI.hasScalableStackID(operator*()) {
                    operator|=(SlotTypes()[operator*()], if isPPRAccess(MI) { PPR } else { ZPRorFPR });
                } else {
                    operator|=(SlotTypes()[operator*()], if isFpOrNEON(MI) { ZPRorFPR } else { GPR });
                }
            }
        }
        for let mut FI: i32 = 0; FI < (); FI += 1 {
            operator|=(HasFPRStackObjects, [FI] == ZPRorFPR);
            if SlotTypes()[FI] == PPR {
                MFI.setStackID(FI, ScalablePredicateVector);
                HasPPRStackObjects = true;
            }
        }
    }
    if HasFPRCSRs || HasFPRStackObjects {
        let mut ID: i32 = MFI.CreateStackObject(StackHazardSize, 16, false, null, 0);
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Created Hazard slot at " << ID << " size " << StackHazardSize << "\n";
            }
        }
            if !(false) { break; }
        }
        AFI()(ID);
    }
    if operator!() {
        return;
    }
    if SplitSVEObjects() {
        let mut CC: ID = MF.getFunction().getCallingConv();
        if AFI()() || CC == AArch64_SVE_VectorCall {
            AFI()(true);
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Using SplitSVEObjects for SVE CC function\n";
                }
            }
                if !(false) { break; }
            }
            return;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Determining if SplitSVEObjects should be used in non-SVE CC function...\n";
            }
        }
            if !(false) { break; }
