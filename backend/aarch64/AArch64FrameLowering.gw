                dbgs() << "SplitSVEObjects enabled!\n";
            }
        }
            if !(false) { break; }
        }
    }
}

fn AArch64FrameLowering::determineCalleeSaves(self: *AArch64FrameLowering, MF: *mut MachineFunction, SavedRegs: *mut BitVector, RS: *mut RegScavenger) {
    if MF.getFunction().getCallingConv() == GHC {
        return;
    }
    let mut Subtarget: *AArch64Subtarget = MF;
    self.determineCalleeSaves(MF, SavedRegs, RS);
    let mut RegInfo: *AArch64RegisterInfo = Subtarget.getRegisterInfo();
    let mut AFI: *mut AArch64FunctionInfo = MF;
    let mut UnspilledCSGPR: Register = 0;
    let mut UnspilledCSGPRPaired: Register = 0;
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut CSRegs: *MCPhysReg = MF.getRegInfo().getCalleeSavedRegs();
    let mut BasePointerReg: MCRegister = if RegInfo.hasBasePointer(MF) { RegInfo.getBaseRegister() } else { MCRegister { Reg: 0 } };
    let mut ExtraCSSpill: Register = 0;
    let mut HasUnpairedGPR64: bool = false;
    let mut HasPairZReg: bool = false;
    let mut UserReservedRegs: BitVector = RegInfo.getUserReservedRegs(MF);
    let mut ReservedRegs: BitVector = RegInfo.getReservedRegs(MF);
    for let mut i: u32 = 0; CSRegs[i]; i += 1 {
        let mut Reg: MCRegister = CSRegs[i];
        if Reg == BasePointerReg {
            SavedRegs.set(Reg.operator unsigned int());
        }
        if UserReservedRegs[Reg.operator unsigned int()] {
            SavedRegs.reset(Reg.operator unsigned int());
            continue;
        }
        let mut RegUsed: bool = SavedRegs.test(Reg.operator unsigned int());
        let mut PairedReg: MCRegister = 0;
        let mut RegIsGPR64: bool = false;
        if  {
            if HasUnpairedGPR64 {
                PairedReg = CSRegs[if i % 2 == 0 { i - 1 } else { i + 1 }];
            } else {
                PairedReg = CSRegs[i ^ 1];
            }
        }
        if  {
            PairedReg = Register { Reg: 0 }.operator MCRegister();
            HasUnpairedGPR64 = true;
        }
        if !RegUsed {
            if  {
                UnspilledCSGPR = Reg;
                UnspilledCSGPRPaired = PairedReg;
            }
            continue;
        }
        if self.producePairRegisters(MF) && PairedReg.isValid() && !SavedRegs.test(PairedReg.operator unsigned int()) {
            SavedRegs.set(PairedReg.operator unsigned int());
            if  {
                ExtraCSSpill = PairedReg;
            }
        }
    }
    if HasPairZReg && enableMultiVectorSpillFill(Subtarget, MF) {
        let mut AFI: *mut AArch64FunctionInfo = MF;
        let mut PnReg: MCRegister = findFreePredicateReg(SavedRegs);
        if PnReg.isValid() {
            AFI.setPredicateRegForFillSpill(PnReg.operator unsigned int());
        }
        if !AFI.getPredicateRegForFillSpill() && MF.getFunction().getCallingConv() == AArch64_SVE_VectorCall {
            SavedRegs;
            AFI.setPredicateRegForFillSpill;
        }
        assert!(!ReservedRegs[AFI.getPredicateRegForFillSpill()], "Predicate cannot be a reserved register");
    }
    if MF.getFunction().getCallingConv() == Win64 && !Subtarget.isTargetWindows() {
        SavedRegs;
    }
    self.determineStackHazardSlot(MF, SavedRegs);
    let mut CSStackSize: u32 = 0;
    let mut ZPRCSStackSize: u32 = 0;
    let mut PPRCSStackSize: u32 = 0;
    let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
    for Reg in SavedRegs.set_bits() {
        let mut RC: *TargetRegisterClass = TRI.getMinimalPhysRegClass(Reg);
        assert!(RC, "expected register class!");
        let mut SpillSize: u32 = TRI.getSpillSize(*RC);
        let mut IsZPR: bool = false;
        let mut IsPPR: bool = false;
        if IsZPR {
            ZPRCSStackSize += SpillSize;
        } else if IsPPR {
            PPRCSStackSize += SpillSize;
        } else {
            let mut SavedSuper: bool = any_of(TRI()(Reg), Closure_10 { SavedRegs: &mut SavedRegs });
            if !SavedSuper {
                CSStackSize += SpillSize;
            }
        }
    }
    let mut NumSavedRegs: u32 = SavedRegs.count();
    if AFI.isStackHazardIncludedInCalleeSaveArea() {
        CSStackSize += getStackHazardSize(MF);
    }
    if self.requiresSaveVG(MF) {
        CSStackSize += 8;
    }
    if self.requiresSaveVG(MF) && operator!(Subtarget()()) {
        SavedRegs;
    }
    let mut EstimatedStackSize: u64 = MFI.estimateStackSize(MF);
    if self.hasFP(MF) || self.windowsRequiresStackProbe(MF, EstimatedStackSize + CSStackSize + 16) {
        SavedRegs;
        SavedRegs;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            {
                dbgs() << "*** determineCalleeSaves\nSaved CSRs:";
                for Reg in SavedRegs.set_bits() {
                    dbgs() << ' ' << printReg(Reg, RegInfo);
                }
                dbgs() << "\n";
            }
        }
    }
        if !(false) { break; }
    }
    let mut SVELocals: u64 = ZPRLocalStackSize + PPRLocalStackSize;
    let mut SVEStackSize: u64 = alignTo(ZPRCSStackSize + PPRCSStackSize + SVELocals, 16);
    let mut CanEliminateFrame: bool = (SavedRegs.count() == 0) && !SVEStackSize;
    let mut EstimatedStackSizeLimit: u32 = estimateRSStackSizeLimit(MF);
    let mut CalleeStackUsed: i64 = 0;
    for let mut I: i32 = MFI.getObjectIndexBegin(); I != 0; I += 1 {
        let mut FixedOff: i64 = MFI.getObjectOffset(I);
        if FixedOff > CalleeStackUsed {
            CalleeStackUsed = FixedOff;
        }
    }
    let mut BigStack: bool = SVEStackSize || (EstimatedStackSize + CSStackSize + CalleeStackUsed) > EstimatedStackSizeLimit;
    if BigStack || !CanEliminateFrame || RegInfo.cannotEliminateFrame(MF) {
        AFI.setHasStackFrame(true);
    }
    if BigStack {
        if !ExtraCSSpill.isValid() && UnspilledCSGPR.isValid() {
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "Spilling " << printReg(UnspilledCSGPR, RegInfo) << " to get a scratch register.\n";
                }
            }
                if !(false) { break; }
            }
            SavedRegs.set(UnspilledCSGPR.operator unsigned int());
            ExtraCSSpill = UnspilledCSGPR;
            if self.producePairRegisters(MF) {
                if !UnspilledCSGPRPaired.isValid() {
                    if produceCompactUnwindFrame(*self, MF) {
                        SavedRegs.reset(UnspilledCSGPR.operator unsigned int());
                        ExtraCSSpill = Register { Reg: 0 };
                    }
                } else {
                    SavedRegs.set(UnspilledCSGPRPaired.operator unsigned int());
                }
            }
        }
        if !ExtraCSSpill.isValid() || MF.getRegInfo().isPhysRegUsed(ExtraCSSpill.operator MCRegister(), false) {
            let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
            let mut RC: *TargetRegisterClass = null;
            let mut Size: u32 = TRI.getSpillSize(RC);
            let mut Alignment: Align = TRI.getSpillAlign(RC);
            let mut FI: i32 = MFI.CreateSpillStackObject(Size, Alignment, Default);
            RS.addScavengingFrameIndex(FI);
            while true {
                {
                if DebugFlag && isCurrentDebugType("frame-info", 1) {
                    dbgs() << "No available CS registers, allocated fi#" << FI << " as the emergency spill slot.\n";
                }
            }
                if !(false) { break; }
            }
        }
    }
    CSStackSize += 8 * (SavedRegs.count() - NumSavedRegs);
    if self.hasFP(MF) && AFI.hasSwiftAsyncContext() {
        CSStackSize += 8;
    }
    let mut AlignedCSStackSize: u64 = alignTo(CSStackSize, 16);
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            dbgs() << "Estimated stack frame size: " << EstimatedStackSize + AlignedCSStackSize << " bytes.\n";
        }
    }
        if !(false) { break; }
    }
    assert!((!MFI.isCalleeSavedInfoValid() || AFI.getCalleeSavedStackSize() == AlignedCSStackSize), "Should not invalidate callee saved info");
    AFI.setCalleeSavedStackSize(AlignedCSStackSize);
    AFI.setCalleeSaveStackHasFreeSpace(AlignedCSStackSize != CSStackSize);
    AFI.setSVECalleeSavedStackSize(ZPRCSStackSize, alignTo(PPRCSStackSize, 16));
}

fn orderZPRCalleeSavesForPairs(MF: *mut MachineFunction, RegInfo: *TargetRegisterInfo, CSI: *mut i32) {
    assert!(!isTargetWindows(MF), "ZPR callee-save reordering not supported on Windows");
    let mut AFI: *mut auto = MF;
    if operator!() {
        return;
    }
    let mut ZPRSaves: i32 = 0;
    let mut ZPRPositions: i32 = 0;
    if ZPRSaves()() < 2 {
        return;
    }
    sort(Closure_11 {});
    let mut Pairs: i32 = 0;
    let mut Singles: i32 = 0;
    for let mut i: u64 = 0; i < ZPRSaves()();  {
        if  {
            Pairs()([i], [i + 1]);
            i += 2;
        } else {
            Singles()([i += 1]);
        }
    }
    let mut ZPRByteOffset: i32 = ();
    if operator!() {
        operator+=(ZPRByteOffset);
    }
    let mut Scale: i32 = RegInfo.getSpillSize;
    let mut LowestOffset: i32 = (ZPRByteOffset / Scale) - () as i32;
    let mut AlignmentSingle: optional<CalleeSavedInfo> = zeroed();
    if LowestOffset % 2 != 0 {
        if operator!() {
            AlignmentSingle() = ();
        } else {
            (((operator!(operator!((operator!() && "Expected a ZPR pair to split")))) || (_wassert(L"!Pairs.empty() && \"Expected a ZPR pair to split\"", L"llvm\\lib\\Target\\AArch64\\AArch64FrameLowering.cpp", (2859) as u32) , 0)) as void);
            AlignmentSingle() = ;
            Singles()();
        }
    }
    if Pairs()() {
        return;
    }
    let mut ZPRSavesInCSIOrder: i32 = 0;
    append_range();
    if AlignmentSingle() {
        ZPRSavesInCSIOrder()(operator*());
    }
    (((operator!(operator!((ZPRSavesInCSIOrder()() == () && "Reordering should not change the number of ZPR spills")))) || (_wassert(L"ZPRSavesInCSIOrder.size() == ZPRPositions.size() && \"Reordering should not change the number of ZPR spills\"", L"llvm\\lib\\Target\\AArch64\\AArch64FrameLowering.cpp", (2883) as u32) , 0)) as void);
}

fn AArch64FrameLowering::assignCalleeSavedSpillSlots(self: *AArch64FrameLowering, MF: *mut MachineFunction, RegInfo: *TargetRegisterInfo, CSI: *mut i32) -> bool {
    let mut IsWindows: bool = isTargetWindows(MF);
    let mut StackHazardSize: u32 = getStackHazardSize(MF);
    if IsWindows {
        reverse();
    }
    if CSI()() {
        return true;
    }
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut AFI: *mut auto = MF;
    if self.requiresSaveVG(MF) {
        let mut It: auto = find_if(Closure_12 {});
        if It() != () {
            CSI()();
        } else {
            CSI()();
        }
    }
    let mut Subtarget: *AArch64Subtarget = MF;
    if !IsWindows && enableMultiVectorSpillFill(Subtarget, MF) {
        orderZPRCalleeSavesForPairs(MF, RegInfo);
    }
    let mut LastReg: Register = 0;
    let mut HazardSlotIndex: i32 = max();
    if AFI()() && HazardSlotIndex == max() {
        HazardSlotIndex = MFI.CreateStackObject(StackHazardSize, 8, true, null, 0);
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Created CSR Hazard at slot " << HazardSlotIndex << "\n";
            }
        }
            if !(false) { break; }
        }
        AFI()(HazardSlotIndex);
        MFI.setIsCalleeSavedObjectIndex(HazardSlotIndex, true);
    }
    return true;
}

fn AArch64FrameLowering::enableStackSlotScavenging(self: *AArch64FrameLowering, MF: *MachineFunction) -> bool {
    let mut AFI: *AArch64FunctionInfo = MF;
    if AFI.hasStreamingModeChanges() && !self.hasFP(MF) {
        return false;
    }
    if AFI.hasStackHazardSlotIndex() {
        return false;
    }
    return AFI.hasCalleeSaveStackFreeSpace();
}

fn getSVECalleeSaveSlotRange(MFI: *MachineFrameInfo, Min: *mut i32, Max: *mut i32) -> bool {
    Min = max();
    Max = min();
    if !MFI.isCalleeSavedInfoValid() {
        return false;
    }
    let mut CSI: i32 = MFI()();
    return Min != max();
}

fn determineSVEStackSizes(MF: *mut MachineFunction, AssignOffsets: AssignObjectOffsets) -> SVEStackSizes {
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut AFI: *mut auto = MF;
    let mut SVEStack: SVEStackSizes = SVEStackSizes { ZPRStackSize: u64 { 0 }, PPRStackSize: u64 { 0 } };
    let mut ZPRStackTop: *mut u64 = SVEStack.ZPRStackSize;
    let mut PPRStackTop: *mut u64 = if () { SVEStack.PPRStackSize } else { SVEStack.ZPRStackSize };
    for let mut I: i32 = MFI.getObjectIndexBegin(); I != 0; I += 1 {
        assert!(!MFI.hasScalableStackID(I), "SVE vectors should never be passed on the stack by value, only by reference.");
    }
    let mut AllocateObject: Closure_13 = Closure_13 { MFI: &mut MFI, ZPRStackTop: &mut ZPRStackTop, PPRStackTop: &mut PPRStackTop, AssignOffsets: &mut AssignOffsets };
    let mut MinCSFrameIndex: i32 = 0;
    let mut MaxCSFrameIndex: i32 = 0;
    if getSVECalleeSaveSlotRange(MFI, MinCSFrameIndex, MaxCSFrameIndex) {
        for let mut FI: i32 = MinCSFrameIndex; FI <= MaxCSFrameIndex; FI += 1 {
            AllocateObject.call(FI);
        }
    }
    PPRStackTop = alignTo(PPRStackTop, 16);
    ZPRStackTop = alignTo(ZPRStackTop, 16);
    let mut ObjectsToAllocate: SmallVector<int, 8> = zeroed();
    let mut StackProtectorFI: i32 = -1;
    if MFI.hasStackProtectorIndex() {
        StackProtectorFI = MFI.getStackProtectorIndex();
        if MFI.getStackID(StackProtectorFI) == ScalableVector {
            ObjectsToAllocate()(StackProtectorFI);
        }
    }
    for let mut FI: i32 = 0;
let mut E: i32 = MFI.getObjectIndexEnd(); FI != E; FI += 1 {
        if FI == StackProtectorFI || MFI.isDeadObjectIndex(FI) || MFI.isCalleeSavedObjectIndex(FI) {
            continue;
        }
        if MFI.getStackID(FI) != ScalableVector && MFI.getStackID(FI) != ScalablePredicateVector {
            continue;
        }
        ObjectsToAllocate()(FI);
    }
    PPRStackTop = alignTo(PPRStackTop, 16);
    ZPRStackTop = alignTo(ZPRStackTop, 16);
    if AssignOffsets == Yes {
        AFI()(SVEStack.ZPRStackSize, SVEStack.PPRStackSize);
    }
    return SVEStack;
}

fn AArch64FrameLowering::processFunctionBeforeFrameFinalized(self: *AArch64FrameLowering, MF: *mut MachineFunction, RS: *mut RegScavenger) {
    assert!(self.getStackGrowthDirection() == StackGrowsDown, "Upwards growing stack unsupported");
    determineSVEStackSizes(MF, Yes) as void;
    if !MF.hasEHFunclets() {
        return;
    }
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut AFI: *mut auto = MF;
    let mut EHInfo: *mut WinEHFuncInfo = *MF.getWinEHFuncInfo();
    let mut CurrentOffset: i64 = () + ();
    let mut UnwindHelpOffset: i64 = alignTo(CurrentOffset + 8, 16);
    (((operator!(operator!((UnwindHelpOffset == self.getFixedObjectSize(MF, true, false) && "UnwindHelpOffset must be at the start of the fixed object area")))) || (_wassert(L"UnwindHelpOffset == getFixedObjectSize(MF, AFI, true, false) && \"UnwindHelpOffset must be at the start of the fixed object area\"", L"llvm\\lib\\Target\\AArch64\\AArch64FrameLowering.cpp", (3145) as u32) , 0)) as void);
    let mut UnwindHelpFI: i32 = MFI.CreateFixedObject(8, -UnwindHelpOffset, false, false);
    EHInfo.UnwindHelpFrameIdx = UnwindHelpFI;
    let mut MBB: *mut MachineBasicBlock = MF.front();
    let mut MBBI: iterator = MBB.begin();
    while MBBI != MBB.end() && operator(MBBI).getFlag(FrameSetup) {
        operator(MBBI);
    }
    let mut DL: DebugLoc = null;
    RS.enterBasicBlockEnd(MBB);
    RS.backward(MBBI);
    let mut DstReg: Register = RS.FindUnusedReg;
    assert!(DstReg.operator unsigned int(), "There must be a free register after frame setup");
    let mut TII: *AArch64InstrInfo = operator*(MF());
    BuildMI(MBB, MBBI, DL, TII(), DstReg)(-2);
    BuildMI(MBB, MBBI, DL, TII())(DstReg, getKillRegState(true))(UnwindHelpFI)(0);
}

struct TagStoreInstr {
    MI: *mut MachineInstr,
    Offset: i64,
    Size: i64,
}

struct TagStoreEdit {
    MF: *mut MachineFunction,
    MBB: *mut MachineBasicBlock,
    MRI: *mut MachineRegisterInfo,
    TagStores: SmallVector<TagStoreInstr, 8>,
    CombinedMemRefs: SmallVector<MachineMemOperand *, 8>,
    FrameReg: Register,
    FrameRegOffset: StackOffset,
    Size: i64,
    FrameRegUpdate: optional<int64_t>,
    FrameRegUpdateFlags: u32,
    ZeroData: bool,
    DL: DebugLoc,
}

fn TagStoreEdit::TagStoreEdit(self, MBB: *mut MachineBasicBlock, ZeroData: bool) {
    self.MF = MBB.getParent();
    self.MRI = &mut self.MF.getRegInfo();
}

fn TagStoreEdit::addInstruction(self, I: TagStoreInstr) {}

fn TagStoreEdit::clear(self) {}

fn TagStoreEdit::emitUnrolled(self, InsertI: iterator) {
    let mut TII: *AArch64InstrInfo = self.MF();
    let mut kMinOffset: i64 = -256 * 16;
    let mut kMaxOffset: i64 = 255 * 16;
    let mut BaseReg: Register = self.FrameReg;
    let mut BaseRegOffsetBytes: i64 = self.FrameRegOffset.getFixed();
    if BaseRegOffsetBytes < kMinOffset || BaseRegOffsetBytes + (self.Size - self.Size % 32) > kMaxOffset || BaseRegOffsetBytes % 16 != 0 {
        let mut ScratchReg: Register = self.MRI;
        emitFrameOffset(*self.MBB, InsertI, self.DL, ScratchReg, BaseReg, getFixed(BaseRegOffsetBytes), TII);
        BaseReg = ScratchReg;
        BaseRegOffsetBytes = 0;
    }
    let mut LastI: *mut MachineInstr = null;
    while self.Size {
        let mut InstrSize: i64 = if (self.Size > 16) { 32 } else { 16 };
        let mut Opcode: u32 = 0;
        assert!(BaseRegOffsetBytes % 16 == 0);
        let mut I: *mut MachineInstr = BuildMI(*self.MBB, InsertI, self.DL, TII()(Opcode))(BaseReg)(BaseRegOffsetBytes / 16);
        if BaseRegOffsetBytes == 0 {
            LastI = I;
        }
        BaseRegOffsetBytes += InstrSize;
        self.Size -= InstrSize;
    }
    if LastI {
        self.MBB.splice(InsertI, self.MBB, LastI);
    }
}

fn TagStoreEdit::emitLoop(self, InsertI: iterator) {
    let mut TII: *AArch64InstrInfo = self.MF();
    let mut BaseReg: Register = if self.FrameRegUpdate { self.FrameReg } else { self.MRI };
    let mut SizeReg: Register = self.MRI;
    emitFrameOffset(*self.MBB, InsertI, self.DL, BaseReg, self.FrameReg, self.FrameRegOffset, TII);
    let mut LoopSize: i64 = self.Size;
    if self.FrameRegUpdate && operator(self.FrameRegUpdate) {
        LoopSize -= LoopSize % 32;
    }
    let mut LoopI: *mut MachineInstr = BuildMI(*self.MBB, InsertI, self.DL, TII())(SizeReg)(BaseReg)(LoopSize)(BaseReg);
    if self.FrameRegUpdate {
        LoopI.setFlags(self.FrameRegUpdateFlags);
    }
    let mut ExtraBaseRegUpdate: i64 = if self.FrameRegUpdate { (operator(self.FrameRegUpdate) - self.FrameRegOffset.getFixed() - self.Size) } else { 0 };
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            dbgs() << "TagStoreEdit::emitLoop: LoopSize=" << LoopSize << ", Size=" << self.Size << ", ExtraBaseRegUpdate=" << ExtraBaseRegUpdate << ", FrameRegUpdate=" << ", FrameRegOffset.getFixed()=" << self.FrameRegOffset.getFixed() << "\n";
        }
    }
        if !(false) { break; }
    }
    if LoopSize < self.Size {
        assert!(self.FrameRegUpdate);
        assert!(self.Size - LoopSize == 16);
        let mut STGOffset: i64 = ExtraBaseRegUpdate + 16;
        assert!(STGOffset % 16 == 0 && STGOffset >= -4096 && STGOffset <= 4080, "STG immediate out of range");
        BuildMI(*self.MBB, InsertI, self.DL, TII())(BaseReg)(BaseReg)(BaseReg)(STGOffset / 16)(self.FrameRegUpdateFlags);
    } else if ExtraBaseRegUpdate {
        let mut AddSubOffset: i64 = if ExtraBaseRegUpdate < 0 { -ExtraBaseRegUpdate } else { ExtraBaseRegUpdate };
        assert!(AddSubOffset <= 4095, "ADD/SUB immediate out of range");
        BuildMI(*self.MBB, InsertI, self.DL, TII())(BaseReg)(BaseReg)(AddSubOffset)(0)(self.FrameRegUpdateFlags);
    }
}

fn canMergeRegUpdate(II: iterator, Reg: u32, Size: i64, TotalOffset: *mut i64) -> bool {
    let mut MI: *mut MachineInstr = operator(II);
    if  {
        let mut Shift: u32 = getShiftValue(MI.getOperand(3).getImm());
        let mut Offset: i64 = MI.getOperand(2).getImm() << Shift;
        if  {
            Offset = -Offset;
        }
        let mut PostOffset: i64 = Offset - Size;
        let mut kMaxOffset: i64 = 4080 - 16;
        let mut kMinOffset: i64 = -4095;
        if PostOffset <= kMaxOffset && PostOffset >= kMinOffset && PostOffset % 16 == 0 {
            *TotalOffset = Offset;
            return true;
        }
    }
    return false;
}

fn mergeMemRefs(TSE: *SmallVectorImpl<TagStoreInstr>, MemRefs: *mut SmallVectorImpl<MachineMemOperand *>) {
    MemRefs()();
}

fn TagStoreEdit::emitCode(self, InsertI: *mut iterator, TFI: *AArch64FrameLowering, TryMergeSPUpdate: bool) {
    if  {
        return;
    }
    let mut FirstTagStore: *mut TagStoreInstr = null;
    let mut LastTagStore: *mut TagStoreInstr = null;
    self.Size = LastTagStore.Offset - FirstTagStore.Offset + LastTagStore.Size;
    let mut Reg: Register = 0;
    self.FrameRegOffset = TFI.resolveFrameOffsetReference(*self.MF, FirstTagStore.Offset, false, Default, Reg, false, true);
    self.FrameReg = Reg;
    self.FrameRegUpdate = nullopt;
    mergeMemRefs();
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            {
                dbgs() << "Replacing adjacent STG instructions:\n";
            }
        }
    }
        if !(false) { break; }
    }
    let mut kSetTagLoopThreshold: i32 = 176;
    if self.Size < kSetTagLoopThreshold {
        if  {
            return;
        }
        self.emitUnrolled(InsertI);
    } else {
        let mut UpdateInstr: *mut MachineInstr = null;
        let mut TotalOffset: i64 = 0;
        if TryMergeSPUpdate {
            if InsertI != self.MBB.end() && canMergeRegUpdate(InsertI, self.FrameReg.operator unsigned int(), self.FrameRegOffset.getFixed() + self.Size, &mut TotalOffset) {
                UpdateInstr = &mut operator(operator(InsertI, 0));
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("frame-info", 1) {
                        dbgs() << "Folding SP update into loop:\n  " << *UpdateInstr;
                    }
                }
                    if !(false) { break; }
                }
            }
        }
        if  {
            return;
        }
        if UpdateInstr {
            self.FrameRegUpdate;
            self.FrameRegUpdateFlags = UpdateInstr.getFlags();
        }
        self.emitLoop(InsertI);
        if UpdateInstr {
            UpdateInstr.eraseFromParent();
        }
    }
}

fn isMergeableStackTaggingInstruction(MI: *mut MachineInstr, Offset: *mut i64, Size: *mut i64, ZeroData: *mut bool) -> bool {
    let mut MF: *mut MachineFunction = *MI.getParent().getParent();
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut Opcode: u32 = MI.getOpcode();
    if  {
        if !MI.getOperand(0).isDead() || !MI.getOperand(1).isDead() {
            return false;
        }
        if !MI.getOperand(2).isImm() || !MI.getOperand(3).isFI() {
            return false;
        }
        Offset = MFI.getObjectOffset(MI.getOperand(3).getIndex());
        Size = MI.getOperand(2).getImm();
        return true;
    }
    if  {
        Size = 16;
    } else if  {
        Size = 32;
    } else {
        return false;
    }
    if  {
        return false;
    }
    Offset = MFI.getObjectOffset(MI.getOperand(1).getIndex()) + 16 * MI.getOperand(2).getImm();
    return true;
}

fn countAvailableScavengerSlots(LiveRegs: *mut LivePhysRegs, MRI: *mut MachineRegisterInfo, RS: *mut RegScavenger) -> u64 {
    let mut FreeGPRs: auto = count_if(Closure_14 { LiveRegs: &mut LiveRegs, MRI: &mut MRI });
    let mut NumEmergencySlots: u64 = 0;
    if RS {
        NumEmergencySlots = RS.getNumScavengingFrameIndices();
    }
    return  + NumEmergencySlots;
}

fn tryMergeAdjacentSTG(II: iterator, TFI: *AArch64FrameLowering, RS: *mut RegScavenger) -> iterator {
    let mut FirstZeroData: bool = false;
    let mut Size: i64 = 0;
    let mut Offset: i64 = 0;
    let mut MI: *mut MachineInstr = operator(II);
    let mut MBB: *mut MachineBasicBlock = MI.getParent();
    let mut NextI: iterator = operator(II);
    if &mut MI == &mut MBB.instr_back() {
        return II;
    }
    if !isMergeableStackTaggingInstruction(MI, Offset, Size, FirstZeroData) {
        return II;
    }
    let mut Instrs: SmallVector<TagStoreInstr, 4> = zeroed();
    Instrs()(&mut MI, Offset, Size);
    let mut kScanLimit: i32 = 10;
    let mut Count: i32 = 0;
    for let mut E: iterator = MBB.end(); NextI != E && Count < kScanLimit; operator(NextI) {
        let mut MI: *mut MachineInstr = operator(NextI);
        let mut ZeroData: bool = false;
        let mut Size: i64 = 0;
        let mut Offset: i64 = 0;
        if isMergeableStackTaggingInstruction(MI, Offset, Size, ZeroData) {
            if ZeroData != FirstZeroData {
                break;
            }
            Instrs()(&mut MI, Offset, Size);
            continue;
        }
        if !MI.isTransient() {
            Count += 1;
        }
        if MI.getFlag(FrameSetup) || MI.getFlag(FrameDestroy) {
            break;
        }
        if MI.mayLoadOrStore(AnyInBundle) || MI.hasUnmodeledSideEffects() || MI.isCall(AnyInBundle) {
            break;
        }
    }
    let mut InsertI: iterator = ();
    let mut LiveRegs: LivePhysRegs = *(MBB.getParent().getSubtarget().getRegisterInfo());
    LiveRegs.addLiveOuts(*MBB);
    for let mut I: reverse_iterator = MBB.rbegin(); ; operator(I) {
        let mut MI: *mut MachineInstr = operator(I);
        if MI == InsertI {
            break;
        }
        LiveRegs.stepBackward(operator(I));
    }
    operator(InsertI, 0);
    if LiveRegs.contains {
        return InsertI;
    }
    if countAvailableScavengerSlots(LiveRegs, MBB.getParent().getRegInfo(), RS) < 2 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Failed to merge MTE stack tagging instructions into loop " << "due to high register pressure.\n";
            }
        }
            if !(false) { break; }
        }
        return InsertI;
    }
    stable_sort(Closure_15 {});
    let mut CurOffset: i64 = [0];
    let mut TSE: TagStoreEdit = TagStoreEdit { MBB, FirstZeroData };
    let mut EndOffset: optional<int64_t> = optional<int64_t> {};
    let mut MF: *MachineFunction = MBB.getParent();
    TSE.emitCode(InsertI, TFI, operator!(MF(*MF)));
    return InsertI;
}

fn AArch64FrameLowering::processFunctionBeforeFrameIndicesReplaced(self: *AArch64FrameLowering, MF: *mut MachineFunction, RS: *mut RegScavenger) {
    for BB in MF {
        for let mut II: iterator = BB.begin(); II != BB.end();  {
            if StackTaggingMergeSetTag() {
                II = tryMergeAdjacentSTG(II, self, RS);
            }
        }
    }
    if !MF.getFunction().hasFnAttribute(Naked) && self.shouldSignReturnAddressEverywhere(MF) {
        self.emitPacRetPlusLeafHardening(MF);
    }
}

fn AArch64FrameLowering::getFrameIndexReferencePreferSP(self: *AArch64FrameLowering, MF: *MachineFunction, FI: i32, FrameReg: *mut Register, IgnoreSPUpdates: bool) -> StackOffset {
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    if IgnoreSPUpdates {
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "Offset from the SP for " << FI << " is " << MFI.getObjectOffset(FI) << "\n";
            }
        }
            if !(false) { break; }
        }
        return getFixed(MFI.getObjectOffset(FI));
    }
    if MFI.hasVarSizedObjects() || MF() || MF.getSubtarget().getRegisterInfo().hasStackRealignment(MF) {
        return self.getFrameIndexReference(MF, FI, FrameReg);
    }
    return self.getStackOffset(MF, MFI.getObjectOffset(FI));
}

fn AArch64FrameLowering::getWinEHParentFrameOffset(self: *AArch64FrameLowering, MF: *MachineFunction) -> u32 {
    return 0;
}

fn AArch64FrameLowering::getWinEHFuncletFrameSize(self: *AArch64FrameLowering, MF: *MachineFunction) -> u32 {
    let mut CSSize: u32 = MF();
    return alignTo(CSSize + MF.getFrameInfo().getMaxCallFrameSize(), self.getStackAlign());
}

struct FrameObject {
    IsValid: bool,
    ObjectIndex: i32,
    GroupIndex: i32,
    ObjectFirst: bool,
    GroupFirst: bool,
    Accesses: u32,
}

struct GroupBuilder {
    CurrentMembers: SmallVector<int, 8>,
    NextGroupIndex: i32,
    Objects: *mut i32,
}

fn GroupBuilder::AddMember(self, Index: i32) {}

fn GroupBuilder::EndCurrentGroup(self) {
    if  {
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "group:";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("frame-info", 1) {
                dbgs() << "\n";
            }
        }
            if !(false) { break; }
        }
        self.NextGroupIndex += 1;
    }
}

fn FrameObjectCompare(A: *FrameObject, B: *FrameObject) -> bool {
    return make_tuple(!A.IsValid, A.Accesses, A.ObjectFirst, A.GroupFirst, A.GroupIndex, A.ObjectIndex) < make_tuple(!B.IsValid, B.Accesses, B.ObjectFirst, B.GroupFirst, B.GroupIndex, B.ObjectIndex);
}

fn AArch64FrameLowering::orderFrameObjects(self: *AArch64FrameLowering, MF: *MachineFunction, ObjectsToAllocate: *mut SmallVectorImpl<int>) {
    let mut AFI: *AArch64FunctionInfo = operator*(MF);
    if (operator!() && !AFI.hasSplitSVEObjects()) || ObjectsToAllocate()() {
        return;
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    let mut FrameObjects: i32 = MFI.getObjectIndexEnd();
    let mut GB: GroupBuilder = FrameObjects();
    for MBB in MF {
        for MI in MBB {
            if MI.isDebugInstr() {
                continue;
            }
            if AFI.hasStackHazardSlotIndex() {
                let mut FI: optional<int> = zeroed();
                if FI() && operator*() >= 0 && operator*() < () as i32 {
                    if MFI.getStackID(operator*()) == ScalableVector || isFpOrNEON(MI) {
                        operator|=(FrameObjects()[operator*()], AccessFPR);
                    } else {
                        operator|=(FrameObjects()[operator*()], AccessGPR);
                    }
                }
            }
            let mut OpIndex: i32 = 0;
            match MI.getOpcode() {
                _ => {
                    OpIndex = -1;
                },
            }
            let mut TaggedFI: i32 = -1;
            if OpIndex >= 0 {
                let mut MO: *MachineOperand = MI.getOperand(OpIndex);
                if MO.isFI() {
                    let mut FI: i32 = MO.getIndex();
                    if FI >= 0 && FI < MFI.getObjectIndexEnd() && [FI] {
                        TaggedFI = FI;
                    }
                }
            }
            if TaggedFI >= 0 {
                GB.AddMember(TaggedFI);
            } else {
                GB.EndCurrentGroup();
            }
        }
        GB.EndCurrentGroup();
    }
    if AFI.hasStackHazardSlotIndex() {
        FrameObjects()[AFI.getStackHazardSlotIndex()] = AccessHazard;
    }
    let mut TBPI: optional<int> = zeroed();
    if TBPI() {
        FrameObjects()[operator*()] = true;
        FrameObjects()[operator*()] = true;
        let mut FirstGroupIndex: i32 = [operator*()];
    }
    stable_sort(FrameObjectCompare);
    let mut i: i32 = 0;
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            {
                dbgs() << "Final frame order:\n";
            }
        }
    }
        if !(false) { break; }
    }
}

fn AArch64FrameLowering::inlineStackProbeLoopExactMultiple(self: *AArch64FrameLowering, MBBI: iterator, ProbeSize: i64, TargetReg: Register) -> iterator {
    let mut MBB: *mut MachineBasicBlock = *operator(MBBI).getParent();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut TII: *AArch64InstrInfo = MF();
    let mut DL: DebugLoc = MBB.findDebugLoc(MBBI);
    let mut MBBInsertPoint: iterator = next(MBB.getIterator());
    let mut LoopMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(MBBInsertPoint, LoopMBB);
    let mut ExitMBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(MBB.getBasicBlock(), nullopt);
    MF.insert(MBBInsertPoint, ExitMBB);
    emitFrameOffset(*LoopMBB, LoopMBB.end(), DL, getFixed(-ProbeSize), TII, FrameSetup);
    BuildMI(*LoopMBB, LoopMBB.end(), DL, TII())(0)(MF)(FrameSetup);
    BuildMI(*LoopMBB, LoopMBB.end(), DL, TII())(TargetReg)(getArithExtendImm(UXTX, 0))(FrameSetup);
    BuildMI(*LoopMBB, LoopMBB.end(), DL, TII())(NE)(LoopMBB)(FrameSetup);
    LoopMBB.addSuccessor(ExitMBB, getUnknown());
    LoopMBB.addSuccessor(LoopMBB, getUnknown());
    ExitMBB.splice(ExitMBB.end(), &mut MBB, MBBI, MBB.end());
    ExitMBB.transferSuccessorsAndUpdatePHIs(&mut MBB);
    MBB.addSuccessor(LoopMBB, getUnknown());
    fullyRecomputeLiveIns(void { ExitMBB, LoopMBB });
    return ExitMBB.begin();
}

fn AArch64FrameLowering::inlineStackProbeFixed(self: *AArch64FrameLowering, MBBI: iterator, ScratchReg: Register, FrameSize: i64, CFAOffset: StackOffset) {
    let mut MBB: *mut MachineBasicBlock = operator(MBBI).getParent();
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut TII: *AArch64InstrInfo = MF();
    let mut AFI: *mut AArch64FunctionInfo = MF;
    let mut EmitAsyncCFI: bool = AFI.needsAsyncDwarfUnwindInfo(MF);
    let mut HasFP: bool = self.hasFP(MF);
    let mut DL: DebugLoc = null;
    let mut ProbeSize: i64 = MF();
    let mut NumBlocks: i64 = FrameSize / ProbeSize;
    let mut ResidualSize: i64 = FrameSize % ProbeSize;
    while true {
        {
        if DebugFlag && isCurrentDebugType("frame-info", 1) {
            dbgs() << "Stack probing: total " << FrameSize << " bytes, " << NumBlocks << " blocks of " << ProbeSize << " bytes, plus " << ResidualSize << " bytes\n";
        }
    }
        if !(false) { break; }
    }
    if NumBlocks <= StackProbeMaxLoopUnroll {
        for let mut i: i32 = 0; i < NumBlocks; i += 1 {
            emitFrameOffset(*MBB, MBBI, DL, getFixed(-ProbeSize), TII, FrameSetup, false, false, null, EmitAsyncCFI && !HasFP, CFAOffset);
            operator(CFAOffset, getFixed(ProbeSize));
            BuildMI(*MBB, MBBI, DL, TII())(0)(MF)(FrameSetup);
        }
    } else if NumBlocks != 0 {
        emitFrameOffset(*MBB, MBBI, DL, ScratchReg, getFixed(-ProbeSize * NumBlocks), TII, FrameSetup, false, false, null, EmitAsyncCFI && !HasFP, CFAOffset);
        operator(CFAOffset, getFixed(ProbeSize * NumBlocks));
        MBBI = self.inlineStackProbeLoopExactMultiple(MBBI, ProbeSize, ScratchReg);
        MBB = operator(MBBI).getParent();
        if EmitAsyncCFI && !HasFP {
            CFIInstBuilder { *MBB, MBBI, FrameSetup, true }.buildDefCFARegister;
        }
    }
    if ResidualSize != 0 {
        emitFrameOffset(*MBB, MBBI, DL, getFixed(-ResidualSize), TII, FrameSetup, false, false, null, EmitAsyncCFI && !HasFP, CFAOffset);
        if ResidualSize > StackProbeMaxUnprobedStack {
            BuildMI(*MBB, MBBI, DL, TII())(0)(MF)(FrameSetup);
        }
    }
}

fn AArch64FrameLowering::inlineStackProbe(self: *AArch64FrameLowering, MF: *mut MachineFunction, MBB: *mut MachineBasicBlock) {
    let mut ToReplace: SmallVector<MachineInstr *, 4> = zeroed();
    for MI in MBB {
        if  {
            ToReplace()(&mut MI);
        }
    }
}

struct StackAccess {
    Idx: i32,
    Offset: StackOffset,
    Size: i64,
    AccessTypes: u32,
}

fn StackAccess::operator<(self: *StackAccess, Rhs: *StackAccess) -> bool {
    return make_tuple(self.start(), self.Idx) < make_tuple(Rhs.start(), Rhs.Idx);
}

fn StackAccess::isCPU(self: *StackAccess) -> bool {
    return self.AccessTypes & (GPR | PPR);
}

fn StackAccess::isSME(self: *StackAccess) -> bool {
    return self.AccessTypes & FPR;
}

fn StackAccess::isMixed(self: *StackAccess) -> bool {
    return self.isCPU() && self.isSME();
}

fn StackAccess::start(self: *StackAccess) -> i64 {
    return self.Offset.getFixed() + self.Offset.getScalable();
}

fn StackAccess::end(self: *StackAccess) -> i64 {
    return self.start() + self.Size;
}

fn StackAccess::getTypeString(self: *StackAccess) -> str {
    match self.AccessTypes {
        FPR => {
            return "FPR";
        },
        PPR => {
            return "PPR";
        },
        GPR => {
            return "GPR";
        },
        NotAccessed => {
            return "NA";
        },
        _ => {
            return "Mixed";
        },
    }
}

fn StackAccess::print(self: *StackAccess, OS: *mut raw_ostream) {
    OS << self.getTypeString() << " stack object at [SP" << (if self.Offset.getFixed() < 0 { "" } else { "+" }) << self.Offset.getFixed();
    if self.Offset.getScalable() {
        OS << (if self.Offset.getScalable() < 0 { "" } else { "+" }) << self.Offset.getScalable() << " * vscale";
    }
    OS << "]";
}

fn op_<<(OS: *mut raw_ostream, SA: *StackAccess) -> *mut raw_ostream {
    SA.print(OS);
    return OS;
}

fn AArch64FrameLowering::emitRemarks(self: *AArch64FrameLowering, MF: *MachineFunction, ORE: *mut MachineOptimizationRemarkEmitter) {
    let mut AFI: *mut auto = MF;
    if AFI()()() {
        return;
    }
    let mut StackHazardSize: u32 = getStackHazardSize(MF);
    let mut HazardSize: u64 = if (StackHazardSize) { StackHazardSize } else {  };
    if HazardSize == 0 {
        return;
    }
    let mut MFI: *MachineFrameInfo = MF.getFrameInfo();
    if !MFI.hasStackObjects() {
        return;
    }
    let mut StackAccesses: i32 = MFI.getNumObjects();
    let mut NumFPLdSt: u64 = 0;
    let mut NumNonFPLdSt: u64 = 0;
    for MBB in MF {
        for MI in MBB {
            if !MI.mayLoadOrStore(AnyInBundle) || MI.getNumMemOperands() < 1 {
                continue;
            }
            for MMO in MI.memoperands() {
                let mut FI: optional<int> = zeroed();
                if FI() && operator!(MFI.isDeadObjectIndex(operator*())) {
                    let mut FrameIdx: i32 = operator*();
                    let mut ArrIdx: u64 = FrameIdx + MFI.getNumFixedObjects();
                    if StackAccesses()[ArrIdx] == NotAccessed {
                        StackAccesses()[ArrIdx] = FrameIdx;
                        StackAccesses()[ArrIdx] = self.getFrameIndexReferenceFromSP(MF, FrameIdx);
                        StackAccesses()[ArrIdx] = MFI.getObjectSize(FrameIdx);
                    }
                    let mut RegTy: u32 = GPR;
                    if MFI.hasScalableStackID(FrameIdx) {
                        RegTy = if isPPRAccess(MI) { PPR } else { FPR };
                    } else if isFpOrNEON(MI) {
                        RegTy = FPR;
                    }
                    operator|=(StackAccesses()[ArrIdx], RegTy);
                    if RegTy == FPR {
                        NumFPLdSt += 1;
                    } else {
                        NumNonFPLdSt += 1;
                    }
                }
            }
        }
    }
    if NumFPLdSt == 0 || NumNonFPLdSt == 0 {
        return;
    }
    sort();
    erase_if(Closure_16 {});
    let mut MixedObjects: i32 = 0;
    let mut HazardPairs: i32 = 0;
    if StackAccesses()()() {
        MixedObjects()(operator&());
    }
    for let mut It: auto = ();
let mut End: auto = prev(); It() != ;  += 1 {
        let mut First: *auto = operator*();
        let mut Second: *auto = operator*((It() + 1));
        if Second()() {
            MixedObjects()(operator&());
        }
        if (First()() && ()) || (First()() && ()) {
            let mut Distance: u64 = () - () as u64;
            if Distance < HazardSize {
                HazardPairs()(operator&(), operator&());
            }
        }
    }
    let mut EmitRemark: Closure_17 = Closure_17 { ORE: &mut ORE, MF: &mut MF };
}

struct Closure_1 {
    TII: *mut *AArch64InstrInfo,
}

unsafe fn Closure_1::call(self: *mut Closure_1, MBB: *mut MachineBasicBlock) {
        let mut DL: DebugLoc = null;
        let mut MBBI: iterator = MBB.begin();
        BuildMI(MBB, MBBI, DL, (*self.TII)())(FrameSetup);
    }

struct Closure_2 {
    TII: *mut *AArch64InstrInfo,
}

unsafe fn Closure_2::call(self: *mut Closure_2, MBB: *mut MachineBasicBlock) {
        let mut DL: DebugLoc = null;
        let mut MBBI: iterator = MBB.getFirstTerminator();
        if MBBI != MBB.end() {
            DL = operator(MBBI).getDebugLoc();
        }
        (*self.TII).createPauthEpilogueInstr(MBB, DL);
    }

