static mut NumCopiesRemoved: Statistic = Statistic { "aarch64-copyelim", "NumCopiesRemoved", "Number of copies removed." };

struct AArch64RedundantCopyEliminationImpl {
    MRI: *MachineRegisterInfo,
    TRI: *TargetRegisterInfo,
    DomBBClobberedRegs: LiveRegUnits,
    DomBBUsedRegs: LiveRegUnits,
    OptBBClobberedRegs: LiveRegUnits,
    OptBBUsedRegs: LiveRegUnits,
}

