static mut ID: i8 = 0;

fn AArch64RedundantCopyEliminationImpl::knownRegValInBlock(self, CondBr: *mut MachineInstr, MBB: *mut MachineBasicBlock, KnownRegs: *mut SmallVectorImpl<RegImm>, FirstUse: *mut iterator) -> bool {
    let mut Opc: u32 = CondBr.getOpcode();
    if ((Opc == CBZW || Opc == CBZX) && MBB == CondBr.getOperand(1).getMBB()) || ((Opc == CBNZW || Opc == CBNZX) && MBB != CondBr.getOperand(1).getMBB()) {
        FirstUse = CondBr;
        KnownRegs.push(RegImm { CondBr.getOperand(0).getReg().operator unsigned int(), 0 });
        return true;
    }
    if Opc != Bcc {
        return false;
    }
    let mut CC: CondCode = CondBr.getOperand(0).getImm() as CondCode;
    if CC != EQ && CC != NE {
        return false;
    }
    let mut BrTarget: *mut MachineBasicBlock = CondBr.getOperand(1).getMBB();
    if (CC == EQ && BrTarget != MBB) || (CC == NE && BrTarget == MBB) {
        return false;
    }
    let mut PredMBB: *mut MachineBasicBlock = *MBB.pred_begin();
    assert!(PredMBB == CondBr.getParent(), "Conditional branch not in predecessor block!");
    if CondBr == PredMBB.begin() {
        return false;
    }
    self.DomBBClobberedRegs.clear();
    self.DomBBUsedRegs.clear();
    let mut RIt: reverse_iterator = CondBr.getReverseIterator();
    for PredI in make_range(next(RIt, 1), PredMBB.rend()) {
        let mut IsCMN: bool = false;
        match PredI.getOpcode() {
            _ => {
                break;
            },
            ADDSWri => {
                ADDSXri;
            },
            SUBSWri => {
                SUBSXri;
            },
            ADCSWr => {
                ADCSXr;
            },
        }
        if PredI.definesRegister(NZCV, null) {
            return false;
        }
        accumulateUsedDefed(PredI, self.DomBBClobberedRegs, self.DomBBUsedRegs, self.TRI);
    }
    return false;
}

fn AArch64RedundantCopyEliminationImpl::optimizeBlock(self, MBB: *mut MachineBasicBlock) -> bool {
    if MBB.pred_size() != 1 {
        return false;
    }
    let mut PredMBB: *mut MachineBasicBlock = *MBB.pred_begin();
    if PredMBB.succ_size() != 2 {
        return false;
    }
    let mut CondBr: iterator = PredMBB.getLastNonDebugInstr(true);
    if CondBr == PredMBB.end() {
        return false;
    }
    let mut FirstUse: iterator = iterator {};
    let mut SeenFirstUse: bool = false;
    let mut KnownRegs: SmallVector<RegImm, 4> = SmallVector<RegImm, 4> {};
    let mut Itr: iterator = next(CondBr, 1);
    while true {
        {
        operator(Itr);
        if !self.knownRegValInBlock(operator(Itr), MBB, KnownRegs, FirstUse) {
            continue;
        }
        self.OptBBClobberedRegs.clear();
        self.OptBBUsedRegs.clear();
        for let mut PredI: iterator = Itr; ; operator(PredI) {
            if FirstUse == PredI {
                SeenFirstUse = true;
            }
            if operator(PredI).isCopy() {
                let mut CopyDstReg: MCPhysReg = operator(PredI).getOperand(0).getReg().operator unsigned int();
                let mut CopySrcReg: MCPhysReg = operator(PredI).getOperand(1).getReg().operator unsigned int();
                for KnownReg in KnownRegs {
                    if !self.OptBBClobberedRegs.available(KnownReg.Reg) {
                        continue;
                    }
                    if CopySrcReg == KnownReg.Reg && self.OptBBClobberedRegs.available(CopyDstReg) {
                        KnownRegs.push(RegImm { CopyDstReg, KnownReg.Imm });
                        if SeenFirstUse {
                            FirstUse = PredI;
                        }
                        break;
                    }
                    if CopyDstReg == KnownReg.Reg && self.OptBBClobberedRegs.available(CopySrcReg) {
                        KnownRegs.push(RegImm { CopySrcReg, KnownReg.Imm });
                        if SeenFirstUse {
                            FirstUse = PredI;
                        }
                        break;
                    }
                }
            }
            if PredI == PredMBB.begin() {
                break;
            }
            accumulateUsedDefed(operator(PredI), self.OptBBClobberedRegs, self.OptBBUsedRegs, self.TRI);
            if all_of(KnownRegs, Closure_1 { cap_0: self }) {
                break;
            }
        }
        break;
    }
        if !(Itr != PredMBB.begin() && operator(Itr).isTerminator(AnyInBundle)) { break; }
    }
    if KnownRegs.is_empty() {
        return false;
    }
    let mut Changed: bool = false;
    let mut UsedKnownRegs: SmallSetVector<unsigned int, 4> = SmallSetVector<unsigned int, 4> {};
    let mut LastChange: iterator = MBB.begin();
    for let mut I: iterator = MBB.begin();
let mut E: iterator = MBB.end(); I != E;  {
        let mut MI: *mut MachineInstr = &mut operator(I);
        operator(I);
        let mut RemovedMI: bool = false;
        let mut IsCopy: bool = MI.isCopy();
        let mut IsMoveImm: bool = MI.isMoveImmediate(IgnoreBundle);
        if IsCopy || IsMoveImm {
            let mut DefReg: Register = MI.getOperand(0).getReg();
            let mut SrcReg: Register = if IsCopy { MI.getOperand(1).getReg() } else { Register { Reg: 0 } };
            let mut SrcImm: i64 = if IsMoveImm { MI.getOperand(1).getImm() } else { 0 };
            if !self.MRI.isReserved(DefReg.operator MCRegister()) && ((IsCopy && (SrcReg == XZR || SrcReg == WZR)) || IsMoveImm) {
                for KnownReg in KnownRegs {
                    if KnownReg.Reg != DefReg.operator unsigned int() && !self.TRI.isSuperRegister(DefReg.operator MCRegister(), KnownReg.Reg) {
                        continue;
                    }
                    if IsCopy && KnownReg.Imm != 0 {
                        continue;
                    }
                    if IsMoveImm {
                        if KnownReg.Imm != SrcImm {
                            continue;
                        }
                        let mut CmpReg: MCPhysReg = KnownReg.Reg;
                        if any_of(MI.implicit_operands(), Closure_2 { CmpReg: CmpReg }) {
                            continue;
                        }
                        if self.TRI.isSuperRegister(DefReg.operator MCRegister(), KnownReg.Reg) && KnownReg.Imm < 0 {
                            continue;
                        }
                    }
                    if IsCopy {
                        while true {
                            {
                            if DebugFlag && isCurrentDebugType("aarch64-copyelim", 1) {
                                dbgs() << "Remove redundant Copy : " << *MI;
                            }
                        }
                            if !(false) { break; }
                        }
                    } else {
                        while true {
                            {
                            if DebugFlag && isCurrentDebugType("aarch64-copyelim", 1) {
                                dbgs() << "Remove redundant Move : " << *MI;
                            }
                        }
                            if !(false) { break; }
                        }
                    }
                    MI.eraseFromParent();
                    Changed = true;
                    LastChange = I;
                    operator(NumCopiesRemoved, 0);
                    UsedKnownRegs.insert(KnownReg.Reg);
                    RemovedMI = true;
                    break;
                }
            }
        }
        if RemovedMI {
            continue;
        }
        for let mut RI: u32 = 0; RI < KnownRegs.len;  {
            if MI.modifiesRegister(KnownRegs[RI].Reg, self.TRI) {
                swap(KnownRegs[RI], KnownRegs[KnownRegs.len - 1]);
                KnownRegs.pop();
            } else {
                RI += 1;
            }
        }
        if KnownRegs.is_empty() {
            break;
        }
    }
    if !Changed {
        return false;
    }
    for KnownReg in UsedKnownRegs {
        if !MBB.isLiveIn(KnownReg, getAll()) {
            MBB.addLiveIn(KnownReg, getAll());
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-copyelim", 1) {
            dbgs() << "Clearing kill flags.\n\tFirstUse: " << operator(FirstUse) << "\tLastChange: ";
            if LastChange == MBB.end() {
                dbgs() << "<end>\n";
            } else {
                dbgs() << operator(LastChange);
            }
        }
    }
        if !(false) { break; }
    }
    for MMI in make_range(FirstUse, PredMBB.end()) {
        MMI.clearKillInfo();
    }
    for MMI in make_range(MBB.begin(), LastChange) {
        MMI.clearKillInfo();
    }
    return true;
}

fn AArch64RedundantCopyEliminationImpl::run(self, MF: *mut MachineFunction) -> bool {
    self.TRI = MF.getSubtarget().getRegisterInfo();
    self.MRI = &mut MF.getRegInfo();
    let mut TII: *TargetInstrInfo = *MF.getSubtarget().getInstrInfo();
    self.DomBBClobberedRegs.init(*self.TRI);
    self.DomBBUsedRegs.init(*self.TRI);
    self.OptBBClobberedRegs.init(*self.TRI);
    self.OptBBUsedRegs.init(*self.TRI);
    let mut Changed: bool = false;
    for MBB in MF {
        Changed |= optimizeTerminators(&mut MBB, TII);
        Changed |= self.optimizeBlock(&mut MBB);
    }
    return Changed;
}

fn AArch64RedundantCopyEliminationLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    return AArch64RedundantCopyEliminationImpl {}.run(MF);
}

fn AArch64RedundantCopyEliminationPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64RedundantCopyEliminationImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

fn createAArch64RedundantCopyEliminationPass() -> *mut FunctionPass {
    return AArch64RedundantCopyEliminationLegacy {};
}

struct Closure_1 {
    cap_0: *mut AArch64RedundantCopyEliminationImpl,
}

fn Closure_1::call(self: *Closure_1, KnownReg: RegImm) -> bool {
                return !self.OptBBClobberedRegs.available(KnownReg.Reg);
            }

struct Closure_2 {
    CmpReg: MCPhysReg,
}

fn Closure_2::call(self: *Closure_2, O: *mut MachineOperand) -> bool {
                            return !O.isDead() && O.isReg() && O.isDef() && O.getReg() != self.CmpReg;
                        }
