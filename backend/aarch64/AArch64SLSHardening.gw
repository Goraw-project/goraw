const CommonNamePrefix: str = "__llvm_slsblr_thunk_";

struct ThunkKind {
    Id: ThunkKindId,
    NameInfix: str,
    HasXmOperand: bool,
    NeedsPAuth: bool,
    BROpcode: u32,
}

struct ThunksSet {
    BLRThunks: reg_bitmask_t,
    BLRAAZThunks: reg_bitmask_t,
    BLRABZThunks: reg_bitmask_t,
    BLRAAThunks: [32]reg_bitmask_t,
    BLRABThunks: [32]reg_bitmask_t,
}

fn ThunksSet::operator|=(self, Other: *ThunksSet) -> *mut ThunksSet {
    self.BLRThunks |= Other.BLRThunks;
    self.BLRAAZThunks |= Other.BLRAAZThunks;
    self.BLRABZThunks |= Other.BLRABZThunks;
    for let mut I: u32 = 0; I < NumXRegisters; I += 1 {
        self.BLRAAThunks[I] |= Other.BLRAAThunks[I];
    }
    for let mut I: u32 = 0; I < NumXRegisters; I += 1 {
        self.BLRABThunks[I] |= Other.BLRABThunks[I];
    }
    return *self;
}

fn ThunksSet::get(self, Kind: ThunkKindId, Xn: Register, Xm: Register) -> bool {
    let mut XnBit: reg_bitmask_t = 1 << indexOfXReg(Xn);
    return self.getBitmask(Kind, Xm) & XnBit;
}

fn ThunksSet::set(self, Kind: ThunkKindId, Xn: Register, Xm: Register) {
    let mut XnBit: reg_bitmask_t = 1 << indexOfXReg(Xn);
    self.getBitmask(Kind, Xm) |= XnBit;
}

fn ThunksSet::getBitmask(self, Kind: ThunkKindId, Xm: Register) -> *mut reg_bitmask_t {
    match Kind {
        ThunkBR => {
            return self.BLRThunks;
        },
        ThunkBRAAZ => {
            return self.BLRAAZThunks;
        },
        ThunkBRABZ => {
            return self.BLRABZThunks;
        },
        ThunkBRAA => {
            return self.BLRAAThunks[indexOfXReg(Xm)];
        },
        ThunkBRAB => {
            return self.BLRABThunks[indexOfXReg(Xm)];
        },
    }
    llvm_unreachable_internal("Unknown ThunkKindId enum", "P:/Goraw/llvm-project/llvm/lib/Target/AArch64/AArch64SLSHardening.cpp", 135);
}

fn ThunksSet::operator=(self, arg: *mut *mut ThunksSet) -> *mut ThunksSet {
    self.BLRThunks =  as ThunksSet.BLRThunks;
    self.BLRAAZThunks =  as ThunksSet.BLRAAZThunks;
    self.BLRABZThunks =  as ThunksSet.BLRABZThunks;
    __builtin_memcpy(&mut self.BLRAAThunks, &mut  as ThunksSet.BLRAAThunks, 128);
    __builtin_memcpy(&mut self.BLRABThunks, &mut  as ThunksSet.BLRABThunks, 128);
    return *self;
}

struct SLSHardeningInserter {
    ComdatThunks: bool,
}

fn SLSHardeningInserter::getThunkPrefix(self) -> *u8 {
    return CommonNamePrefix.ptr;
}

fn SLSHardeningInserter::mayUseThunk(self, MF: *MachineFunction) -> bool {
    self.ComdatThunks &= !MF.getSubtarget().hardenSlsNoComdat();
    return MF.getSubtarget().hardenSlsBlr() || MF.getSubtarget().hardenSlsRetBr();
}

const BR: ThunkKind = ThunkKind { Id: ThunkBR, NameInfix: "", HasXmOperand: false, NeedsPAuth: false, BROpcode: BR };

const BRAA: ThunkKind = ThunkKind { Id: ThunkBRAA, NameInfix: "aa_", HasXmOperand: true, NeedsPAuth: true, BROpcode: BRAA };

const BRAB: ThunkKind = ThunkKind { Id: ThunkBRAB, NameInfix: "ab_", HasXmOperand: true, NeedsPAuth: true, BROpcode: BRAB };

const BRAAZ: ThunkKind = ThunkKind { Id: ThunkBRAAZ, NameInfix: "aaz_", HasXmOperand: false, NeedsPAuth: true, BROpcode: BRAAZ };

const BRABZ: ThunkKind = ThunkKind { Id: ThunkBRABZ, NameInfix: "abz_", HasXmOperand: false, NeedsPAuth: true, BROpcode: BRABZ };

fn getThunkKind(OriginalOpcode: u32) -> *ThunkKind {
    match OriginalOpcode {
        BLR => {
            BLRNoIP;
        },
        BLRAA => {
            return &mut BRAA;
        },
        BLRAB => {
            return &mut BRAB;
        },
        BLRAAZ => {
            return &mut BRAAZ;
        },
        BLRABZ => {
            return &mut BRABZ;
        },
    }
    return null;
}

fn isBLR(MI: *MachineInstr) -> bool {
    return getThunkKind(MI.getOpcode()) != null;
}

fn ThunksSet::indexOfXReg(self, Reg: Register) -> u32 {
    assert!(GPR64RegClass.contains(Reg.operator MCRegister();
    assert!(Reg != X16 && Reg != X17 && Reg != LR);
    let mut Result: u32 = Reg.operator unsigned int() as u32 - X0 as u32;
    if Reg == FP {
        Result = 29;
    } else if Reg == XZR {
        Result = 31;
    }
    assert!(Result < NumXRegisters, "Internal register numbering changed");
    assert!(GPR64RegClass.getRegister(Result).id() == Reg.operator unsigned int(), "Internal register numbering changed");
    return Result;
}

fn ThunksSet::xRegByIndex(self, N: u32) -> Register {
    return GPR64RegClass.getRegister(N);
}

fn insertSpeculationBarrier(ST: *AArch64Subtarget, MBB: *mut MachineBasicBlock, MBBI: iterator, DL: DebugLoc, AlwaysUseISBDSB: bool) {
    assert!(MBBI != MBB.begin(), "Must not insert SpeculationBarrierEndBB as only instruction in MBB.");
    assert!(operator(prev(MBBI, 1)).isBarrier(AnyInBundle), "SpeculationBarrierEndBB must only follow unconditional control flow instructions.");
    assert!(operator(prev(MBBI, 1)).isTerminator(AnyInBundle), "SpeculationBarrierEndBB must only follow terminators.");
    let mut TII: *TargetInstrInfo = ST.getInstrInfo();
    let mut BarrierOpc: u32 = if ST.hasSB() && !AlwaysUseISBDSB { SpeculationBarrierSBEndBB } else { SpeculationBarrierISBDSBEndBB };
    if MBBI == MBB.end() || (operator(MBBI).getOpcode() != SpeculationBarrierSBEndBB && operator(MBBI).getOpcode() != SpeculationBarrierISBDSBEndBB) {
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(BarrierOpc));
    }
}

fn SLSHardeningInserter::insertThunks(self, MMI: *mut MachineModuleInfo, MF: *mut MachineFunction, ExistingThunks: ThunksSet) -> ThunksSet {
    let mut ST: *AArch64Subtarget = &mut MF.getSubtarget();
    for MBB in MF {
        if ST.hardenSlsRetBr() {
            self.hardenReturnsAndBRs(MMI, MBB);
        }
        if ST.hardenSlsBlr() {
            self.hardenBLRs(MMI, MBB, ExistingThunks);
        }
    }
    return ExistingThunks;
}

fn SLSHardeningInserter::hardenReturnsAndBRs(self, MMI: *mut MachineModuleInfo, MBB: *mut MachineBasicBlock) -> bool {
    let mut ST: *AArch64Subtarget = &mut MBB.getParent().getSubtarget();
    let mut Modified: bool = false;
    let mut MBBI: iterator = MBB.getFirstTerminator();
    let mut E: iterator = MBB.end();
    let mut NextMBBI: iterator = iterator {};
    for ; MBBI != E; MBBI = NextMBBI {
        let mut MI: *mut MachineInstr = operator(MBBI);
        NextMBBI = next(MBBI, 1);
        if MI.isReturn(AnyInBundle) || isIndirectBranchOpcode(MI.getOpcode()) {
            assert!(MI.isTerminator(AnyInBundle);
            insertSpeculationBarrier(ST, MBB, next(MBBI, 1), MI.getDebugLoc(), false);
            Modified = true;
        }
    }
    return Modified;
}

fn createThunkName(Kind: *ThunkKind, Xn: Register, Xm: Register) -> str {
    let mut N: u32 = indexOfXReg(Xn);
    if !Kind.HasXmOperand {
        return formatv("{0}{1}x{2}", CommonNamePrefix, Kind.NameInfix, N).operator SmallString();
    }
    let mut M: u32 = indexOfXReg(Xm);
    return formatv("{0}{1}x{2}_x{3}", CommonNamePrefix, Kind.NameInfix, N, M).operator SmallString();
}

fn parseThunkName(ThunkName: str) -> tuple<const ThunkKind &, Register, Register> {
    assert!(ThunkName.starts_with(CommonNamePrefix), "Should be filtered out by ThunkInserter");
    let mut NameSuffix: str = ThunkName.drop_front(CommonNamePrefix.len);
    let mut Kind: *ThunkKind = *NameSuffix.StartsWith("aa_", &mut BRAA).StartsWith("ab_", &mut BRAB).StartsWith("aaz_", &mut BRAAZ).StartsWith("abz_", &mut BRABZ).Default(&mut BR);
    let mut ParseRegName: Closure_1 = Closure_1 {};
    let mut RegsStr: str = NameSuffix.drop_front(Kind.NameInfix.len);
    let mut XnStr: str = "";
    let mut XmStr: str = "";
    tie(XnStr, XmStr) = RegsStr.split('_');
    let mut Xn: Register = ParseRegName.call(XnStr);
    let mut Xm: Register = if Kind.HasXmOperand { ParseRegName.call(XmStr) } else { Register { Reg: 0 } };
    return make_tuple(ref(Kind), Xn, Xm);
}

fn SLSHardeningInserter::populateThunk(self, MF: *mut MachineFunction) {
    assert!(MF.getFunction().hasComdat() == self.ComdatThunks, "ComdatThunks value changed since MF creation");
    let mut Xn: Register = 0;
    let mut Xm: Register = 0;
    let mut KindAndRegs: tuple<const ThunkKind &, Register, Register> = parseThunkName(MF.getName());
    let mut Kind: *ThunkKind = get(KindAndRegs);
    tie(ignore, Xn, Xm) = KindAndRegs;
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    if MF.len == 1 {
        assert!(MF.front().len == 1);
        assert!(MF.front().front().getOpcode() == RET);
        MF.front().erase(MF.front().begin());
    } else {
        assert!(MF.len == 0);
        MF.push(MF.CreateMachineBasicBlock(null, nullopt));
    }
    let mut Entry: *mut MachineBasicBlock = &mut MF.front();
    Entry.clear();
    Entry.addLiveIn(Xn.operator MCRegister(), getAll());
    BuildMI(Entry, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(ORRXrs), X16).addReg(XZR, RegState {}, 0).addReg(Xn, RegState {}, 0).addImm(0);
    let mut Builder: MachineInstrBuilder = BuildMI(Entry, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Kind.BROpcode)).addReg(X16, RegState {}, 0);
    if Xm.isValid() {
        Entry.addLiveIn(Xm.operator MCRegister(), getAll());
        Builder.addReg(Xm, RegState {}, 0);
    }
    insertSpeculationBarrier(&mut MF.getSubtarget(), *Entry, Entry.end(), DebugLoc { Loc: null }, true);
}

fn SLSHardeningInserter::convertBLRToBL(self, MMI: *mut MachineModuleInfo, MBB: *mut MachineBasicBlock, MBBI: instr_iterator, Thunks: *mut ThunksSet) {
    let mut BLR: *mut MachineInstr = operator(MBBI);
    assert!(isBLR(BLR);
    let mut Kind: *ThunkKind = *getThunkKind(BLR.getOpcode());
    let mut NumRegOperands: u32 = if Kind.HasXmOperand { 2 } else { 1 };
    assert!(BLR.getNumExplicitOperands() == NumRegOperands, "Expected one or two register inputs");
    let mut Xn: Register = BLR.getOperand(0).getReg();
    let mut Xm: Register = if Kind.HasXmOperand { BLR.getOperand(1).getReg() } else { Register { Reg: 0 } };
    let mut DL: DebugLoc = BLR.getDebugLoc();
    let mut MF: *mut MachineFunction = *operator(MBBI).getMF();
    let mut Context: *mut MCContext = MBB.getParent().getContext();
    let mut TII: *TargetInstrInfo = MF.getSubtarget().getInstrInfo();
    let mut ThunkName: str = createThunkName(Kind, Xn, Xm);
    let mut Sym: *mut MCSymbol = Context.getOrCreateSymbol(ThunkName);
    if !Thunks.get(Kind.Id, Xn, Xm) {
        let mut TargetAttrs: str = if Kind.NeedsPAuth { "+pauth" } else { "" };
        Thunks.set(Kind.Id, Xn, Xm);
        self.createThunkFunction(MMI, ThunkName.operator StringRef(), self.ComdatThunks, TargetAttrs);
    }
    let mut BL: *mut MachineInstr = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(BL)).addSym(Sym, 0).operator llvm::MachineInstr *();
    let mut ImpLROpIdx: i32 = -1;
    let mut ImpSPOpIdx: i32 = -1;
    for let mut OpIdx: u32 = BL.getNumExplicitOperands(); OpIdx < BL.getNumOperands(); OpIdx += 1 {
        let mut Op: MachineOperand = BL.getOperand(OpIdx);
        if !Op.isReg() {
            continue;
        }
        if Op.getReg() == LR && Op.isDef() {
            ImpLROpIdx = OpIdx;
        }
        if Op.getReg() == SP && !Op.isDef() {
            ImpSPOpIdx = OpIdx;
        }
    }
    assert!(ImpLROpIdx != -1);
    assert!(ImpSPOpIdx != -1);
    let mut FirstOpIdxToRemove: i32 = if ImpLROpIdx > ImpSPOpIdx { ImpLROpIdx } else { ImpSPOpIdx };
    let mut SecondOpIdxToRemove: i32 = if ImpLROpIdx < ImpSPOpIdx { ImpLROpIdx } else { ImpSPOpIdx };
    BL.removeOperand(FirstOpIdxToRemove);
    BL.removeOperand(SecondOpIdxToRemove);
    BL.copyImplicitOps(MF, BLR);
    MF.moveAdditionalCallInfo(&mut BLR, BL);
    for let mut OpIdx: u32 = 0; OpIdx < NumRegOperands; OpIdx += 1 {
        let mut Op: *mut MachineOperand = BLR.getOperand(OpIdx);
        BL.addOperand(CreateReg(Op.getReg(), false, true, Op.isKill(), false, false, false, 0, false, false, false));
    }
    MBB.erase(MBBI);
}

fn SLSHardeningInserter::hardenBLRs(self, MMI: *mut MachineModuleInfo, MBB: *mut MachineBasicBlock, Thunks: *mut ThunksSet) -> bool {
    let mut Modified: bool = false;
    let mut MBBI: instr_iterator = MBB.instr_begin();
    let mut E: instr_iterator = MBB.instr_end();
    let mut NextMBBI: instr_iterator = instr_iterator {};
    for ; MBBI != E; MBBI = NextMBBI {
        let mut MI: *mut MachineInstr = operator(MBBI);
        NextMBBI = next(MBBI, 1);
        if isBLR(MI) {
            self.convertBLRToBL(MMI, MBB, MBBI, Thunks);
            Modified = true;
        }
    }
    return Modified;
}

struct AArch64SLSHardeningLegacy {
}

fn AArch64SLSHardeningLegacy::getPassName(self: *AArch64SLSHardeningLegacy) -> str {
    return "AArch64 sls hardening pass";
}

static mut ID: i8 = 0;

fn createAArch64SLSHardeningLegacyPass() -> *mut FunctionPass {
    return AArch64SLSHardeningLegacy {};
}

fn AArch64SLSHardeningPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut MMI: *mut Result = MFAM.getResult(MF).getCachedResult(*MF.getFunction().getParent());
    assert!(MMI, "MachineModuleAnalysis must be available");
    let mut Inserter: SLSHardeningInserter = SLSHardeningInserter {};
    Inserter.init(*MF.getFunction().getParent());
    if Inserter.run(MMI.getMMI(), MF) {
        let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
        PA.preserveSet();
        return PA;
    }
    return all();
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Name: str) -> Register {
        let mut N: u32 = 0;
        assert!(Name.starts_with("x"), "xN register name expected");
        let mut Fail: bool = Name.drop_front(1).getAsInteger(10, N);
        assert!(!Fail && N < NumXRegisters, "Unexpected register");
        Fail as void;
        return xRegByIndex(N);
    }
