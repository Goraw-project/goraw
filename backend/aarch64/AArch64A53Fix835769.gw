static mut NumNopsAdded: Statistic = Statistic { "aarch64-fix-cortex-a53-835769", "NumNopsAdded", "Number of Nops added to work around erratum 835769" };

fn isFirstInstructionInSequence(MI: *mut MachineInstr) -> bool {
    match MI.getOpcode() {
        PRFMl => {
            PRFMroW;
        },
        _ => {
            return MI.mayLoadOrStore(AnyInBundle);
        },
    }
}

fn isSecondInstructionInSequence(MI: *mut MachineInstr) -> bool {
    match MI.getOpcode() {
        MSUBXrrr => {
            MADDXrrr;
        },
        _ => {
            return false;
        },
    }
}

struct AArch64A53Fix835769Impl {
    TII: *TargetInstrInfo,
}

struct AArch64A53Fix835769Legacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64A53Fix835769Legacy::getRequiredProperties(self: *AArch64A53Fix835769Legacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn AArch64A53Fix835769Legacy::getPassName(self: *AArch64A53Fix835769Legacy) -> str {
    return "Workaround A53 erratum 835769 pass";
}

fn AArch64A53Fix835769Legacy::getAnalysisUsage(self: *AArch64A53Fix835769Legacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage(AU);
}

fn AArch64A53Fix835769Legacy::getPassKind(self: *AArch64A53Fix835769Legacy) -> PassKind {
    return self.Kind;
}

fn AArch64A53Fix835769Legacy::getPassID(self: *AArch64A53Fix835769Legacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64A53Fix835769Legacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64A53Fix835769Legacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64A53Fix835769Legacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64A53Fix835769Legacy::getResolver(self: *AArch64A53Fix835769Legacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64A53Fix835769Legacy::getSetProperties(self: *AArch64A53Fix835769Legacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64A53Fix835769Legacy::getClearedProperties(self: *AArch64A53Fix835769Legacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn AArch64A53Fix835769Pass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64A53Fix835769Impl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

fn AArch64A53Fix835769Legacy::runOnMachineFunction(self, F: *mut MachineFunction) -> bool {
    return AArch64A53Fix835769Impl {}.run(F);
}

fn AArch64A53Fix835769Impl::run(self, MF: *mut MachineFunction) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-fix-cortex-a53-835769", 1) {
            dbgs() << "***** AArch64A53Fix835769 *****\n";
        }
    }
        if !(false) { break; }
    }
    let mut STI: *AArch64Subtarget = MF.getSubtarget();
    if !STI.fixCortexA53_835769() {
        return false;
    }
    let mut Changed: bool = false;
    self.TII = STI.getInstrInfo();
    for MBB in MF {
        Changed |= self.runOnBasicBlock(MBB);
    }
    return Changed;
}

fn getBBFallenThrough(MBB: *mut MachineBasicBlock, TII: *TargetInstrInfo) -> *mut MachineBasicBlock {
    let mut MBBI: iterator = MBB;
    if MBBI == MBB.getParent().begin() {
        return null;
    }
    let mut TBB: *mut MachineBasicBlock = null;
    let mut FBB: *mut MachineBasicBlock = null;
    let mut Cond: SmallVector<MachineOperand, 2> = SmallVector<MachineOperand, 2> {};
    let mut PrevBB: *mut MachineBasicBlock = &mut operator(prev(MBBI, 1));
    for S in MBB.predecessors() {
        if S == PrevBB && !TII.analyzeBranch(*PrevBB, TBB, FBB, Cond, false) && !TBB && !FBB {
            return S;
        }
    }
    return null;
}

fn getLastNonPseudo(MBB: *mut MachineBasicBlock, TII: *TargetInstrInfo) -> *mut MachineInstr {
    let mut FMBB: *mut MachineBasicBlock = &mut MBB;
    while (FMBB = getBBFallenThrough(FMBB, TII)) {
        for I in reverse(*FMBB) {
            if !I.isPseudo(IgnoreBundle) {
                return &mut I;
            }
        }
    }
    return null;
}

fn insertNopBeforeInstruction(MBB: *mut MachineBasicBlock, MI: *mut MachineInstr, TII: *TargetInstrInfo) {
    if MI == MBB.getFirstNonDebugInstr(true) {
        let mut I: *mut MachineInstr = getLastNonPseudo(MBB, TII);
        assert!(I, "Expected instruction");
        let mut DL: DebugLoc = I.getDebugLoc();
        BuildMI(I.getParent(), MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(NOP));
    } else {
        let mut DL: DebugLoc = MI.getDebugLoc();
        BuildMI(MBB, MI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(NOP));
    }
    operator(NumNopsAdded);
}

fn AArch64A53Fix835769Impl::runOnBasicBlock(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Changed: bool = false;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-fix-cortex-a53-835769", 1) {
            dbgs() << "Running on MBB: " << MBB << " - scanning instructions...\n";
        }
    }
        if !(false) { break; }
    }
    let mut Sequences: []*mut MachineInstr = []*mut MachineInstr {};
    let mut Idx: u32 = 0;
    let mut PrevInstr: *mut MachineInstr = null;
    PrevInstr = getLastNonPseudo(MBB, self.TII);
    for MI in MBB {
        let mut CurrInstr: *mut MachineInstr = &mut MI;
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-fix-cortex-a53-835769", 1) {
                dbgs() << "  Examining: " << MI;
            }
        }
            if !(false) { break; }
        }
        if PrevInstr {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-fix-cortex-a53-835769", 1) {
                    dbgs() << "    PrevInstr: " << *PrevInstr << "    CurrInstr: " << *CurrInstr << "    isFirstInstructionInSequence(PrevInstr): " << isFirstInstructionInSequence(PrevInstr) << "\n" << "    isSecondInstructionInSequence(CurrInstr): " << isSecondInstructionInSequence(CurrInstr) << "\n";
                }
            }
                if !(false) { break; }
            }
            if isFirstInstructionInSequence(PrevInstr) && isSecondInstructionInSequence(CurrInstr) {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-fix-cortex-a53-835769", 1) {
                        dbgs() << "   ** pattern found at Idx " << Idx << "!\n";
                    }
                }
                    if !(false) { break; }
                }
                Idx as void;
                Sequences.push(CurrInstr);
            }
        }
        if !CurrInstr.isPseudo(IgnoreBundle) {
            PrevInstr = CurrInstr;
        }
        Idx += 1;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-fix-cortex-a53-835769", 1) {
            dbgs() << "Scan complete, " << Sequences.len << " occurrences of pattern found.\n";
        }
    }
        if !(false) { break; }
    }
    for MI in Sequences {
        Changed = true;
        insertNopBeforeInstruction(MBB, MI, self.TII);
    }
    return Changed;
}

fn createAArch64A53Fix835769LegacyPass() -> *mut FunctionPass {
    return AArch64A53Fix835769Legacy {};
}
