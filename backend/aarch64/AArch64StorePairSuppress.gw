struct AArch64StorePairSuppress {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
    TII: *AArch64InstrInfo,
    TRI: *TargetRegisterInfo,
    MRI: *MachineRegisterInfo,
    SchedModel: TargetSchedModel,
    Traces: *mut MachineTraceMetrics,
    MinInstr: *mut Ensemble,
}

fn AArch64StorePairSuppress::getPassName(self: *AArch64StorePairSuppress) -> str {
    return "AArch64 Store Pair Suppression";
}

fn AArch64StorePairSuppress::getAnalysisUsage(self: *AArch64StorePairSuppress, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU;
    AU;
    self.getAnalysisUsage;
}

fn AArch64StorePairSuppress::getPassKind(self: *AArch64StorePairSuppress) -> PassKind {
    return self.Kind;
}

fn AArch64StorePairSuppress::getPassID(self: *AArch64StorePairSuppress) -> AnalysisID {
    return self.PassID;
}

fn AArch64StorePairSuppress::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64StorePairSuppress::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64StorePairSuppress::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64StorePairSuppress::getResolver(self: *AArch64StorePairSuppress) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64StorePairSuppress::getRequiredProperties(self: *AArch64StorePairSuppress) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64StorePairSuppress::getSetProperties(self: *AArch64StorePairSuppress) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64StorePairSuppress::getClearedProperties(self: *AArch64StorePairSuppress) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn createAArch64StorePairSuppressPass() -> *mut FunctionPass {
    return AArch64StorePairSuppress {};
}

fn AArch64StorePairSuppress::shouldAddSTPToBlock(self, BB: *MachineBasicBlock) -> bool {
    if !self.MinInstr {
        self.MinInstr = self.Traces.getEnsemble(TS_MinInstrCount);
    }
    let mut BBTrace: Trace = self.MinInstr.getTrace(BB);
    let mut ResLength: u32 = BBTrace.getResourceLength(void {}, void {}, void {});
    let mut SCIdx: u32 = self.TII();
    let mut PairSCDesc: *MCSchedClassDesc = null;
    let mut SCIdx2: u32 = self.TII();
    let mut SingleSCDesc: *MCSchedClassDesc = null;
    if PairSCDesc.isValid() && !PairSCDesc.isVariant() && SingleSCDesc.isValid() && !SingleSCDesc.isVariant() {
        let mut ResLenWithSTP: u32 = BBTrace.getResourceLength;
        if ResLenWithSTP > ResLength {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-stp-suppress", 1) {
                    dbgs() << "  Suppress STP in BB: " << BB.getNumber() << " resources " << ResLength << " -> " << ResLenWithSTP << "\n";
                }
            }
                if !(false) { break; }
            }
            return false;
        }
    }
    return true;
}

fn AArch64StorePairSuppress::isNarrowFPStore(self, MI: *MachineInstr) -> bool {
    match MI.getOpcode() {
        _ => {
            return false;
        },
    }
}

fn AArch64StorePairSuppress::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction || MF.getFunction().hasOptSize() {
        return false;
    }
    let mut ST: *AArch64Subtarget = MF;
    if operator!(ST()()) {
        return false;
    }
    self.TII = ST.getInstrInfo();
    self.TRI;
    self.MRI = &mut MF.getRegInfo();
    self.Traces = operator&();
    self.MinInstr = null;
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-stp-suppress", 1) {
            dbgs() << "*** " << self.getPassName() << ": " << MF.getName() << 10;
        }
    }
        if !(false) { break; }
    }
    if  {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-stp-suppress", 1) {
                dbgs() << "  Skipping pass: no machine model present.\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    return false;
}
