struct AArch64SRLTDefineSuperRegsImpl {
    Subtarget: *AArch64Subtarget,
    TRI: *AArch64RegisterInfo,
}

struct AArch64SRLTDefineSuperRegsLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64SRLTDefineSuperRegsLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    return AArch64SRLTDefineSuperRegsImpl {}.run(MF);
}

fn AArch64SRLTDefineSuperRegsLegacy::getPassName(self: *AArch64SRLTDefineSuperRegsLegacy) -> str {
    return "AArch64 SRLT Define Super-Regs Pass";
}

fn AArch64SRLTDefineSuperRegsLegacy::getAnalysisUsage(self: *AArch64SRLTDefineSuperRegsLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage;
}

fn AArch64SRLTDefineSuperRegsLegacy::getPassKind(self: *AArch64SRLTDefineSuperRegsLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64SRLTDefineSuperRegsLegacy::getPassID(self: *AArch64SRLTDefineSuperRegsLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64SRLTDefineSuperRegsLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64SRLTDefineSuperRegsLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64SRLTDefineSuperRegsLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64SRLTDefineSuperRegsLegacy::getResolver(self: *AArch64SRLTDefineSuperRegsLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64SRLTDefineSuperRegsLegacy::getRequiredProperties(self: *AArch64SRLTDefineSuperRegsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64SRLTDefineSuperRegsLegacy::getSetProperties(self: *AArch64SRLTDefineSuperRegsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64SRLTDefineSuperRegsLegacy::getClearedProperties(self: *AArch64SRLTDefineSuperRegsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64SRLTDefineSuperRegsImpl::getWidestSuperReg(self, R: Register, RequiredBaseRegUnits: *BitVector, QHiRegUnits: *BitVector) -> Register {
    assert!(R.isPhysical(), "Expected to be run straight after virtregrewriter!");
    let mut Units: BitVector = self.TRI();
    let mut IsSuitableSuperReg: Closure_1 = Closure_1 { cap_0: self, QHiRegUnits: &mut QHiRegUnits, Units: &mut Units, RequiredBaseRegUnits: &mut RequiredBaseRegUnits };
    let mut LargestSuperReg: Register = 0;
    return LargestSuperReg;
}

fn AArch64SRLTDefineSuperRegsImpl::run(self, MF: *mut MachineFunction) -> bool {
    self.Subtarget = operator&(MF);
    self.TRI = self.Subtarget.getRegisterInfo();
    let mut MRI: *MachineRegisterInfo = &mut MF.getRegInfo();
    if !MRI.subRegLivenessEnabled() {
        return false;
    }
    assert!(!MRI.isSSA(), "Expected to be run after breaking down SSA form!");
    let mut XRegs: auto = seq_inclusive();
    let mut ZRegs: auto = seq_inclusive();
    let mut FixedRegs: []u32 = zeroed();
    let mut RequiredBaseRegUnits: BitVector = self.TRI();
    let mut QHiRegUnits: BitVector = self.TRI();
    let mut Changed: bool = false;
    return Changed;
}

fn createAArch64SRLTDefineSuperRegsLegacyPass() -> *mut FunctionPass {
    return AArch64SRLTDefineSuperRegsLegacy {};
}

fn AArch64SRLTDefineSuperRegsPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64SRLTDefineSuperRegsImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA;
    return PA;
}

struct Closure_1 {
    cap_0: *mut AArch64SRLTDefineSuperRegsImpl,
    QHiRegUnits: *mut BitVector,
    Units: *mut BitVector,
    RequiredBaseRegUnits: *mut BitVector,
}

unsafe fn Closure_1::call(self: *mut Closure_1, SR: Register) -> bool {
        return true;
    }
