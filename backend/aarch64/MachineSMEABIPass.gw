fn getPhysLiveRegs(LiveUnits: *LiveRegUnits) -> LiveRegs {
    let mut PhysLiveRegs: LiveRegs = None;
    if operator!(LiveUnits.available) {
        PhysLiveRegs(NZCV);
    }
    if operator!(LiveUnits.available) {
        PhysLiveRegs(W0);
    }
    if operator!(LiveUnits.available) {
        PhysLiveRegs(W0_HI);
    }
    return PhysLiveRegs;
}

fn setPhysLiveRegs(LiveUnits: *mut LiveRegUnits, PhysLiveRegs: LiveRegs) {
    if PhysLiveRegs & NZCV {
        LiveUnits.addReg;
    }
    if PhysLiveRegs & W0 {
        LiveUnits.addReg;
    }
    if PhysLiveRegs & W0_HI {
        LiveUnits.addReg;
    }
}

fn isCallStartOpcode(Opc: u32) -> bool {
    match Opc {
        _ => {
            return false;
        },
    }
}

fn MachineSMEABI::collectNeededZAStates(self, SMEFnAttrs: SMEAttrs) -> FunctionInfo {
    assert!((SMEFnAttrs.hasAgnosticZAInterface() || SMEFnAttrs.hasZT0State() || SMEFnAttrs.hasZAState()), "Expected function to have ZA/ZT0 state!");
    let mut Blocks: i32 = self.MF.getNumBlockIDs();
    let mut PhysLiveRegsAfterSMEPrologue: LiveRegs = None;
    let mut AfterSMEProloguePt: i32 = 0;
    return void { move(), PhysLiveRegsAfterSMEPrologue };
}

fn MachineSMEABI::assignBundleZAStates(self, Bundles: *EdgeBundles, FnInfo: *FunctionInfo) -> i32 {
    let mut BundleStates: i32 = Bundles.getNumBundles();
    for let mut I: u32 = 0;
let mut E: u32 = Bundles.getNumBundles(); I != E; I += 1 {
        let mut BundleState: optional<ZAState> = zeroed();
        if operator!() ||  == ANY {
            BundleState() = ACTIVE;
        }
        BundleStates()[I] = operator*();
    }
    return ;
}

fn MachineSMEABI::findStateChangeInsertionPoint(self, MBB: *mut MachineBasicBlock, Block: *BlockInfo, Inst: i32) -> i32 {
    let mut PhysLiveRegs: LiveRegs = zeroed();
    let mut InsertPt: i32 = 0;
    if Inst() != Block()() {
        InsertPt() = ;
        PhysLiveRegs = ;
    } else {
        InsertPt() = MBB()();
        PhysLiveRegs = Block.PhysLiveRegsAtExit;
    }
    if PhysLiveRegs == None {
        return void { , PhysLiveRegs };
    }
    let mut PrevStateChangeI: i32 = 0;
    if Inst() == Block()() {
        PrevStateChangeI() = MBB()();
    } else {
        PrevStateChangeI() = prev();
    }
    let mut LiveUnits: LiveRegUnits = *self.TRI;
    setPhysLiveRegs(LiveUnits, PhysLiveRegs);
    let mut BestCandidate: auto = make_pair(PhysLiveRegs);
    for let mut I: i32 = ; I() != ;  -= 1 {
        if I()() {
            continue;
        }
        if I()() == self.TII() || () {
            break;
        }
        LiveUnits.stepBackward(operator*());
        let mut CurrentPhysLiveRegs: LiveRegs = getPhysLiveRegs(LiveUnits);
        if !(CurrentPhysLiveRegs & NZCV) {
            BestCandidate() = void { , CurrentPhysLiveRegs };
        }
        if CurrentPhysLiveRegs == None {
            break;
        }
    }
    return ;
}

fn MachineSMEABI::insertStateChanges(self, Context: *mut EmitContext, FnInfo: *FunctionInfo, Bundles: *EdgeBundles, BundleStates: ArrayRef<ZAState>) {}

fn getDebugLoc(MBB: *mut MachineBasicBlock, MBBI: i32) -> DebugLoc {
    if MBB.is_empty() {
        return DebugLoc { Loc: null };
    }
    return if  != MBB()() { () } else { MBB.back().getDebugLoc() };
}

fn findMarkedCall(MBB: *MachineBasicBlock, MBBI: i32, Calls: *SmallVectorImpl<const MachineInstr *>, Marker: u32, CallDestroyOpcode: u32) -> bool {
    let mut IsMarker: Closure_2 = Closure_2 { Marker: &mut Marker };
    let mut MarkerInst: auto = find_if(MBB()(), IsMarker);
    if MarkerInst() == MBB()() {
        return false;
    }
    let mut I: i32 = ;
    while  += 1 != MBB()() {
        if I()() || () == CallDestroyOpcode {
            break;
        }
    }
    if I() != MBB()() && () {
        Calls()(operator&(operator*()));
    }
    return true;
}

fn MachineSMEABI::collectReachableMarkedCalls(self: *MachineSMEABI, StartMBB: *MachineBasicBlock, StartInst: i32, Calls: *SmallVectorImpl<const MachineInstr *>, Marker: u32) {
    let mut CallDestroyOpcode: u32 = self.TII();
    if findMarkedCall(StartMBB, Calls, Marker, CallDestroyOpcode) {
        return;
    }
    let mut Visited: SmallPtrSet<const MachineBasicBlock *, 4> = zeroed();
    let mut Worklist: i32 = StartMBB()();
    while operator!() {
        let mut MBB: *MachineBasicBlock = ();
        if operator!() {
            continue;
        }
        if  {
            Worklist()(MBB()(), MBB()());
        }
    }
}

fn getCalleeName(CallInst: *MachineInstr) -> str {
    assert!(CallInst.isCall(AnyInBundle), "expected a call");
    return "";
}

fn MachineSMEABI::emitCallSaveRemarks(self: *MachineSMEABI, MBB: *MachineBasicBlock, MBBI: i32, DL: DebugLoc, Marker: u32, RemarkName: str, SaveName: str) {
    let mut SaveRemark: Closure_3 = Closure_3 { RemarkName: &mut RemarkName };
    let mut StateName: str = zeroed();
    self.ORE;
    if !self.ORE.allowExtraAnalysis("sme") {
        return;
    }
    let mut CallsRequiringSaves: i32 = 0;
}

fn MachineSMEABI::emitSetupLazySave(self, Context: *mut EmitContext, MBB: *mut MachineBasicBlock, MBBI: i32) {
    let mut DL: DebugLoc = zeroed();
    let mut TPIDR2: Register = self.MRI;
    let mut TPIDR2Ptr: Register = self.MRI;
    BuildMI(MBB, DL, self.TII, TPIDR2)(Context.getTPIDR2Block(*self.MF))(0)(0);
    BuildMI(MBB, DL, self.TII(COPY), TPIDR2Ptr)(TPIDR2);
    BuildMI(MBB, DL, self.TII)(TPIDR2Ptr);
}

fn MachineSMEABI::createPhysRegSave(self, PhysLiveRegs: LiveRegs, MBB: *mut MachineBasicBlock, MBBI: i32, DL: DebugLoc) -> PhysRegSave {
    let mut RegSave: PhysRegSave = PhysRegSave { PhysLiveRegs: PhysLiveRegs, StatusFlags: Register { Reg: 0 }, X0Save: Register { Reg: 0 } };
    if PhysLiveRegs & NZCV {
        RegSave.StatusFlags = self.MRI;
        BuildMI(MBB, DL, self.TII, RegSave.StatusFlags)(2);
    }
    if PhysLiveRegs & W0 {
        RegSave.X0Save = self.MRI;
        BuildMI(MBB, DL, self.TII(COPY), RegSave.X0Save);
    }
    return RegSave;
}

fn MachineSMEABI::restorePhyRegSave(self, RegSave: *PhysRegSave, MBB: *mut MachineBasicBlock, MBBI: i32, DL: DebugLoc) {
    if RegSave.StatusFlags.isValid() {
        BuildMI(MBB, DL, self.TII)(RegSave.StatusFlags);
    }
    if RegSave.X0Save.isValid() {
        BuildMI(MBB, DL, self.TII(COPY))(RegSave.X0Save);
    }
}

fn MachineSMEABI::addSMELibCall(self, MIB: *mut MachineInstrBuilder, LC: Libcall, ExpectedCC: ID) {
    let mut LCImpl: LibcallImpl = self.LLI.getLibcallImpl(LC);
    if LCImpl == Unsupported {
        self.emitError("cannot lower SME ABI (SME routines unsupported)");
    }
    let mut CC: ID = self.LLI.getLibcallImplCallingConv(LCImpl);
    let mut ImplName: str = getLibcallImplName(LCImpl);
    if CC != ExpectedCC {
        self.emitError("invalid calling convention for SME routine: '" + ImplName + "'");
    }
    MIB()(ImplName.ptr);
    MIB()(self.TRI.getCallPreservedMask(*self.MF, CC));
}

fn MachineSMEABI::emitRestoreLazySave(self, Context: *mut EmitContext, MBB: *mut MachineBasicBlock, MBBI: i32, PhysLiveRegs: LiveRegs) {
    let mut DL: DebugLoc = zeroed();
    let mut TPIDR2EL0: Register = self.MRI;
    let mut TPIDR2: Register = zeroed();
    let mut RegSave: PhysRegSave = zeroed();
    BuildMI(MBB, DL, self.TII)(1);
    BuildMI(MBB, DL, self.TII, TPIDR2EL0)(2);
    BuildMI(MBB, DL, self.TII, TPIDR2)(Context.getTPIDR2Block(*self.MF))(0)(0);
    let mut RestoreZA: auto = BuildMI(MBB, DL, self.TII)(TPIDR2EL0)(TPIDR2);
    self.addSMELibCall(SMEABI_TPIDR2_RESTORE, AArch64_SME_ABI_Support_Routines_PreserveMost_From_X0);
    BuildMI(MBB, DL, self.TII);
}

fn MachineSMEABI::emitZAMode(self, MBB: *mut MachineBasicBlock, MBBI: i32, ClearTPIDR2: bool, On: bool) {
    let mut DL: DebugLoc = zeroed();
    if ClearTPIDR2 {
        BuildMI(MBB, DL, self.TII);
    }
    BuildMI(MBB, DL, self.TII)(if On { 1 } else { 0 });
}

fn MachineSMEABI::emitAllocateLazySaveBuffer(self, Context: *mut EmitContext, MBB: *mut MachineBasicBlock, MBBI: i32) {
    let mut MFI: *mut MachineFrameInfo = self.MF.getFrameInfo();
    let mut DL: DebugLoc = zeroed();
    let mut SP: Register = self.MRI;
    let mut SVL: Register = self.MRI;
    let mut Buffer: Register = self.AFI.getEarlyAllocSMESaveBuffer();
    BuildMI(MBB, DL, self.TII, SVL)(1);
    if !Buffer.isValid() {
        assert!(!self.Subtarget.isTargetWindows(), "Lazy ZA save is not yet supported on Windows");
        Buffer = self.MRI;
        BuildMI(MBB, DL, self.TII(COPY), SP);
        BuildMI(MBB, DL, self.TII, Buffer)(SVL)(SVL)(SP);
        BuildMI(MBB, DL, self.TII(COPY))(Buffer);
        MFI.CreateVariableSizedObject(16, null);
    }
    {
        if !self.Subtarget.isLittleEndian() {
            reportFatalInternalError("TPIDR2 block initialization is not supported on big-endian targets");
        }
        BuildMI(MBB, DL, self.TII)(Buffer)(SVL)(Context.getTPIDR2Block(*self.MF))(0);
    }
}

const ZERO_ALL_ZA_MASK: u32 = 255;

fn MachineSMEABI::emitSMEPrologue(self, MBB: *mut MachineBasicBlock, MBBI: i32) {
    let mut DL: DebugLoc = zeroed();
    let mut ZeroZA: bool = self.AFI.getSMEFnAttrs().isNewZA();
    let mut ZeroZT0: bool = self.AFI.getSMEFnAttrs().isNewZT0();
    if self.AFI.getSMEFnAttrs().hasPrivateZAInterface() {
        let mut TPIDR2EL0: Register = self.MRI;
        BuildMI(MBB, DL, self.TII)(TPIDR2EL0, Define)(2);
        let mut CommitZASave: auto = BuildMI(MBB, DL, self.TII)(TPIDR2EL0)(ZeroZA)(ZeroZT0);
        self.addSMELibCall(SMEABI_TPIDR2_SAVE, AArch64_SME_ABI_Support_Routines_PreserveMost_From_X0);
        if ZeroZA {
            CommitZASave();
        }
        if ZeroZT0 {
            CommitZASave();
        }
        BuildMI(MBB, DL, self.TII)(1);
    } else if self.AFI.getSMEFnAttrs().hasSharedZAInterface() {
        if ZeroZA {
            BuildMI(MBB, DL, self.TII)(ZERO_ALL_ZA_MASK);
        }
        if ZeroZT0 {
            BuildMI(MBB, DL, self.TII);
        }
    }
}

fn MachineSMEABI::emitFullZASaveRestore(self, Context: *mut EmitContext, MBB: *mut MachineBasicBlock, MBBI: i32, PhysLiveRegs: LiveRegs, IsSave: bool) {
    let mut DL: DebugLoc = zeroed();
    let mut RegSave: PhysRegSave = zeroed();
    let mut BufferPtr: Register = zeroed();
    BuildMI(MBB, DL, self.TII(COPY), BufferPtr)(Context.getAgnosticZABufferPtr(*self.MF));
    let mut SaveRestoreZA: auto = BuildMI(MBB, DL, self.TII)(BufferPtr, Implicit);
    self.addSMELibCall(if IsSave { SMEABI_SME_SAVE } else { SMEABI_SME_RESTORE }, AArch64_SME_ABI_Support_Routines_PreserveMost_From_X1);
}

fn MachineSMEABI::emitZT0SaveRestore(self, Context: *mut EmitContext, MBB: *mut MachineBasicBlock, MBBI: i32, IsSave: bool) {
    let mut DL: DebugLoc = zeroed();
    let mut ZT0Save: Register = self.MRI;
    BuildMI(MBB, DL, self.TII, ZT0Save)(Context.getZT0SaveSlot(*self.MF))(0)(0);
    if IsSave {
        BuildMI(MBB, DL, self.TII)(ZT0Save);
    } else {
        BuildMI(MBB, DL, self.TII)(ZT0Save);
    }
}

fn MachineSMEABI::emitAllocateFullZASaveBuffer(self, Context: *mut EmitContext, MBB: *mut MachineBasicBlock, MBBI: i32, PhysLiveRegs: LiveRegs) {
    if self.AFI.getEarlyAllocSMESaveBuffer().operator unsigned int() {
        return;
    }
    let mut DL: DebugLoc = zeroed();
    let mut BufferPtr: Register = Context.getAgnosticZABufferPtr(*self.MF);
    let mut BufferSize: Register = self.MRI;
    let mut RegSave: PhysRegSave = zeroed();
    {
        let mut SMEStateSize: auto = BuildMI(MBB, DL, self.TII);
        self.addSMELibCall(SMEABI_SME_STATE_SIZE, AArch64_SME_ABI_Support_Routines_PreserveMost_From_X1);
        BuildMI(MBB, DL, self.TII(COPY), BufferSize);
    }
    {
        let mut MFI: *mut MachineFrameInfo = self.MF.getFrameInfo();
        BuildMI(MBB, DL, self.TII)(BufferSize)(getArithExtendImm(UXTX, 0));
        BuildMI(MBB, DL, self.TII(COPY), BufferPtr);
        MFI.CreateVariableSizedObject(16, null);
    }
}

struct FromState {
    From: ZAState,
}

fn FromState::to(self: *FromState, To: ZAState) -> u8 {
    return self.From << 4 | To;
}

fn transitionFrom(From: ZAState) -> FromState {
    return FromState { From: From };
}

fn MachineSMEABI::emitStateChange(self, Context: *mut EmitContext, MBB: *mut MachineBasicBlock, InsertPt: i32, From: ZAState, To: ZAState, PhysLiveRegs: LiveRegs) {
    if From == ANY || To == ANY {
        return;
    }
    if From == ENTRY && To == OFF {
        return;
    }
    if From == ENTRY {
        assert!(&mut MBB == &mut MBB.getParent().front(), "ENTRY state only valid in entry block");
        if To == ACTIVE {
            return;
        }
        From = ACTIVE;
    }
    let mut SMEFnAttrs: SMEAttrs = self.AFI.getSMEFnAttrs();
    let mut IsAgnosticZA: bool = SMEFnAttrs.hasAgnosticZAInterface();
    let mut HasZT0State: bool = SMEFnAttrs.hasZT0State();
    let mut HasZAState: bool = IsAgnosticZA || SMEFnAttrs.hasZAState();
    match transitionFrom(From).to(To) {
        transitionFrom(ACTIVE).to(ACTIVE_ZT0_SAVED) => {
            
        },
        transitionFrom(ACTIVE_ZT0_SAVED).to(ACTIVE) => {
            
        },
        transitionFrom(ACTIVE).to(LOCAL_SAVED) => {
            transitionFrom(ACTIVE_ZT0_SAVED).to(LOCAL_SAVED);
        },
        transitionFrom(ACTIVE).to(LOCAL_COMMITTED) => {
            assert!(HasZT0State && !HasZAState, "Expect to only have ZT0 state.");
        },
        transitionFrom(LOCAL_COMMITTED).to(OFF) => {
            transitionFrom(LOCAL_COMMITTED).to(LOCAL_SAVED);
        },
        transitionFrom(LOCAL_COMMITTED).to(ACTIVE) => {
            transitionFrom(LOCAL_COMMITTED).to(ACTIVE_ZT0_SAVED);
        },
        transitionFrom(ACTIVE).to(OFF) => {
            transitionFrom(ACTIVE_ZT0_SAVED).to(OFF);
        },
        _ => {
            dbgs() << "Error: Transition from " << getZAStateString(From) << " to " << getZAStateString(To) << 10;
        },
    }
}

fn canElidePrivateZASetup(FnInfo: *FunctionInfo) -> bool {
    return true;
}

fn MachineSMEABI::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    self.AFI = MF;
    let mut SMEFnAttrs: SMEAttrs = self.AFI.getSMEFnAttrs();
    if !SMEFnAttrs.hasZAState() && !SMEFnAttrs.hasZT0State() && !SMEFnAttrs.hasAgnosticZAInterface() {
        return false;
    }
    self.Subtarget = operator&(MF);
    if operator!(self.Subtarget()) && !SMEFnAttrs.hasAgnosticZAInterface() {
        return false;
    }
    assert!(MF.getRegInfo().isSSA(), "Expected to be run on SSA form!");
    self.MF = &mut MF;
    self.ORE = operator&();
    self.LLI = operator&((operator*(MF.getFunction()), *self.Subtarget));
    self.TII = self.Subtarget.getInstrInfo();
    self.TRI = self.Subtarget.getRegisterInfo();
    self.MRI = &mut MF.getRegInfo();
    let mut Bundles: *EdgeBundles = ();
    let mut FnInfo: FunctionInfo = self.collectNeededZAStates(SMEFnAttrs);
    if SMEFnAttrs.hasPrivateZAInterface() && canElidePrivateZASetup(FnInfo) {
        return false;
    }
    let mut BundleStates: i32 = 0;
    let mut Context: EmitContext = EmitContext {};
    self.insertStateChanges(Context, FnInfo, Bundles);
    if Context.needsSaveBuffer() {
        if FnInfo() {
            let mut MBBI: i32 = operator*(FnInfo());
        } else {
            let mut EntryBlock: *mut MachineBasicBlock = MF.front();
        }
    }
    return true;
}

fn createMachineSMEABIPass(OptLevel: CodeGenOptLevel) -> *mut FunctionPass {
    return OptLevel;
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, SR: *MCPhysReg) {}

struct Closure_2 {
    Marker: *mut u32,
}

unsafe fn Closure_2::call(self: *mut Closure_2) {
        return MI() == (*self.Marker);
    }

struct Closure_3 {
    RemarkName: *mut str,
}

unsafe fn Closure_3::call(self: *mut Closure_3, DL: DebugLoc, MBB: *MachineBasicBlock) -> MachineOptimizationRemarkAnalysis {
        return MachineOptimizationRemarkAnalysis { "sme", (*self.RemarkName), DL, &mut MBB };
    }
