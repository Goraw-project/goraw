static mut ID: i8 = 0;

fn AArch64LowerHomogeneousPrologEpilogLegacy::runOnModule(self, M: *mut Module) -> bool {
    if self.skipModule(M) {
        return false;
    }
    let mut MMI: *mut MachineModuleInfo = operator&();
    return AArch64LowerHomogeneousPrologEpilogImpl { &mut M, MMI }.run();
}

fn AArch64LowerHomogeneousPrologEpilogPass::run(self, M: *mut Module, MAM: *mut ModuleAnalysisManager) -> PreservedAnalyses {
    let mut MMI: *mut MachineModuleInfo = operator&(MAM()(M)());
    let mut Changed: bool = AArch64LowerHomogeneousPrologEpilogImpl { &mut M, MMI }.run();
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = PreservedAnalyses {};
    PA;
    return PA;
}

fn AArch64LowerHomogeneousPrologEpilogImpl::run(self) -> bool {
    let mut Changed: bool = false;
    return Changed;
}

enum FrameHelperType {
    Prolog = 0,
    PrologFrame = 1,
    Epilog = 2,
    EpilogTail = 3,
}

fn getFrameHelperName(Regs: *mut SmallVectorImpl<unsigned int>, Type: FrameHelperType, FpOffset: u32) -> str {
    let mut RegStream: ostringstream = zeroed();
    match Type {
        Prolog => {
            RegStream() << "OUTLINED_FUNCTION_PROLOG_";
        },
        PrologFrame => {
            RegStream() << "OUTLINED_FUNCTION_PROLOG_FRAME" << FpOffset << "_";
        },
        Epilog => {
            RegStream() << "OUTLINED_FUNCTION_EPILOG_";
        },
        EpilogTail => {
            RegStream() << "OUTLINED_FUNCTION_EPILOG_TAIL_";
        },
    }
    return ();
}

fn createFrameHelperMachineFunction(M: *mut Module, MMI: *mut MachineModuleInfo, Name: str) -> *mut MachineFunction {
    let mut C: *mut LLVMContext = M.getContext();
    let mut F: *mut Function = M.getFunction(Name);
    assert!(F == null, "Function has been created before");
    F = Create(get(getVoidTy(C), false), ExternalLinkage, Name, M);
    assert!(F, "Function was null!");
    F.setLinkage;
    F.setUnnamedAddr;
    F.addFnAttr(NoInline);
    F.addFnAttr(MinSize);
    F.addFnAttr(Naked);
    let mut MF: *mut MachineFunction = MMI.getOrCreateMachineFunction(*F);
    MF.getProperties().resetTracksLiveness().resetIsSSA().setNoVRegs().setNoPHIs();
    MF.getRegInfo().freezeReservedRegs();
    let mut EntryBB: *mut BasicBlock = Create(C, "entry", F, null);
    let mut Builder: i32 = EntryBB;
    Builder()();
    let mut MBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(null, nullopt());
    MF()(MF()(), MBB);
    return MF;
}

fn emitStore(MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, Pos: i32, TII: *TargetInstrInfo, Reg1: u32, Reg2: u32, Offset: i32, IsPreDec: bool) {
    let mut IsPaired: bool = false;
    let mut IsFloat: bool = false;
    let mut Opc: u32 = 0;
    if IsPreDec {} else {}
    let mut Scale: TypeSize = 0;
    let mut Width: TypeSize = 0;
    let mut MinOffset: i64 = 0;
    let mut MaxOffset: i64 = 0;
    let mut Success: bool = getMemOpInfo(Opc, Scale, Width, MinOffset, MaxOffset);
    assert!(Success, "Invalid Opcode");
    let mut MIB: MachineInstrBuilder = BuildMI(MBB, DebugLoc { Loc: null }, TII.get);
    if IsPreDec {
        MIB();
    }
    if IsPaired {
        MIB()(Reg2);
    }
    MIB()(Reg1)(Offset)(FrameSetup);
}

fn emitLoad(MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, Pos: i32, TII: *TargetInstrInfo, Reg1: u32, Reg2: u32, Offset: i32, IsPostDec: bool) {
    let mut IsPaired: bool = false;
    let mut IsFloat: bool = false;
    let mut Opc: u32 = 0;
    if IsPostDec {} else {}
    let mut Scale: TypeSize = 0;
    let mut Width: TypeSize = 0;
    let mut MinOffset: i64 = 0;
    let mut MaxOffset: i64 = 0;
    let mut Success: bool = getMemOpInfo(Opc, Scale, Width, MinOffset, MaxOffset);
    assert!(Success, "Invalid Opcode");
    let mut MIB: MachineInstrBuilder = BuildMI(MBB, DebugLoc { Loc: null }, TII.get);
    if IsPostDec {
        MIB();
    }
    if IsPaired {
        MIB()(Reg2, getDefRegState(true));
    }
    MIB()(Reg1, getDefRegState(true))(Offset)(FrameDestroy);
}

fn getOrCreateFrameHelper(M: *mut Module, MMI: *mut MachineModuleInfo, Regs: *mut SmallVectorImpl<unsigned int>, Type: FrameHelperType, FpOffset: u32) -> *mut Function {
    (((operator!(operator!((Regs()() >= 2)))) || (_wassert(L"Regs.size() >= 2", L"llvm\\lib\\Target\\AArch64\\AArch64LowerHomogeneousPrologEpilog.cpp", (326) as u32) , 0)) as void);
    let mut Name: str = getFrameHelperName(Regs, Type, FpOffset);
    let mut F: *mut Function = M.getFunction(Name);
    if F {
        return F;
    }
    let mut MF: *mut MachineFunction = createFrameHelperMachineFunction(M, MMI, Name);
    let mut MBB: *mut MachineBasicBlock = operator*(MF()());
    let mut STI: *TargetSubtargetInfo = MF.getSubtarget();
    let mut TII: *TargetInstrInfo = *STI.getInstrInfo();
    let mut Size: i32 = Regs()() as i32;
    match Type {
        Prolog => {
            PrologFrame;
        },
        Epilog => {
            EpilogTail;
        },
    }
    return M.getFunction(Name);
}

fn shouldUseFrameHelper(MBB: *mut MachineBasicBlock, NextMBBI: *mut i32, Regs: *mut SmallVectorImpl<unsigned int>, Type: FrameHelperType) -> bool {
    let mut TRI: *TargetRegisterInfo = MBB.getParent().getSubtarget().getRegisterInfo();
    let mut RegCount: auto = Regs()();
    (((operator!(operator!((RegCount() > 0 && (RegCount() % 2 == 0))))) || (_wassert(L"RegCount > 0 && (RegCount % 2 == 0)", L"llvm\\lib\\Target\\AArch64\\AArch64LowerHomogeneousPrologEpilog.cpp", (410) as u32) , 0)) as void);
    let mut InstCount: i32 =  / 2;
    if operator!(is_contained(Regs)) {
        return false;
    }
    match Type {
        Prolog => {
            InstCount -= 1;
        },
        PrologFrame => {
            break;
        },
        Epilog => {
            for let mut NextMI: auto = ; NextMI() != MBB()();  += 1 {
                if NextMI() {
                    return false;
                }
            }
        },
        EpilogTail => {
            if NextMBBI() == MBB()() {
                return false;
            }
            if  {
                return false;
            }
            InstCount += 1;
            break;
        },
    }
    return InstCount >= ;
}

fn AArch64LowerHomogeneousPrologEpilogImpl::lowerEpilog(self, MBB: *mut MachineBasicBlock, MBBI: i32, NextMBBI: *mut i32) -> bool {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut MI: *mut MachineInstr = operator*();
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut Regs: SmallVector<unsigned int, 8> = zeroed();
    let mut HasUnpairedReg: bool = false;
    HasUnpairedReg as void;
    let mut Size: i32 = () as i32;
    if Size == 0 {
        return false;
    }
    assert!(Size % 2 == 0);
    let mut Return: auto = ;
    let mut HelperCall: *mut MachineInstr = null;
    if shouldUseFrameHelper(MBB, EpilogTail) {
        let mut EpilogTailHelper: *mut auto = getOrCreateFrameHelper(self.M, self.MMI, EpilogTail);
        HelperCall = BuildMI(MBB, DL, self.TII)()(0)(FrameDestroy)(MI)(operator*());
        NextMBBI() = next();
        Return()();
    } else if shouldUseFrameHelper(MBB, Epilog) {
        let mut EpilogHelper: *mut auto = getOrCreateFrameHelper(self.M, self.MMI, Epilog);
        HelperCall = BuildMI(MBB, DL, self.TII)()(FrameDestroy)(MI);
    } else {
        for let mut I: i32 = 0; I < Size - 2; I += 2 {
            emitLoad(MF, MBB, *self.TII, [I], [I + 1], Size - I - 2, false);
        }
        emitLoad(MF, MBB, *self.TII, [Size - 2], [Size - 1], Size, true);
    }
    MBBI()();
    return true;
}

fn AArch64LowerHomogeneousPrologEpilogImpl::lowerProlog(self, MBB: *mut MachineBasicBlock, MBBI: i32, NextMBBI: *mut i32) -> bool {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut MI: *mut MachineInstr = operator*();
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut Regs: SmallVector<unsigned int, 8> = zeroed();
    let mut HasUnpairedReg: bool = false;
    let mut LRIdx: i32 = 0;
    let mut FpOffset: optional<int> = zeroed();
    HasUnpairedReg as void;
    let mut Size: i32 = () as i32;
    if Size == 0 {
        return false;
    }
    assert!(Size % 2 == 0);
    if  {
        emitStore(MF, MBB, *self.TII, -LRIdx - 2, true);
        let mut PrologFrameHelper: *mut auto = getOrCreateFrameHelper(self.M, self.MMI, PrologFrame, operator*());
        BuildMI(MBB, DL, self.TII)()(FrameSetup)(MI);
    } else if  {
        emitStore(MF, MBB, *self.TII, -LRIdx - 2, true);
        let mut PrologHelper: *mut auto = getOrCreateFrameHelper(self.M, self.MMI, Prolog);
        BuildMI(MBB, DL, self.TII)()(FrameSetup)(MI);
    } else {
        emitStore(MF, MBB, *self.TII, [Size - 2], [Size - 1], -Size, true);
        for let mut I: i32 = Size - 3; I >= 0; I -= 2 {
            emitStore(MF, MBB, *self.TII, [I - 1], [I], Size - I - 1, false);
        }
        if FpOffset() {
            BuildMI(MBB, DL, self.TII)(operator*())(0)(FrameSetup);
        }
    }
    MBBI()();
    return true;
}

