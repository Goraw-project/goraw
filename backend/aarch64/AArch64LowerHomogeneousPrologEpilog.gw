static mut FrameHelperSizeThreshold: opt<int> = opt<int> { "frame-helper-size-threshold", init(2), Hidden, "The minimum number of instructions that are outlined in a frame helper (default = 2)" };

struct AArch64LowerHomogeneousPrologEpilogImpl {
    TII: *AArch64InstrInfo,
    M: *mut Module,
    MMI: *mut MachineModuleInfo,
}

struct AArch64LowerHomogeneousPrologEpilogLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
}

fn AArch64LowerHomogeneousPrologEpilogLegacy::getAnalysisUsage(self: *AArch64LowerHomogeneousPrologEpilogLegacy, AU: *mut AnalysisUsage) {
    AU.addRequired();
    AU.addPreserved();
    AU.setPreservesAll();
    self.getAnalysisUsage(AU);
}

fn AArch64LowerHomogeneousPrologEpilogLegacy::getPassName(self: *AArch64LowerHomogeneousPrologEpilogLegacy) -> str {
    return "AArch64 homogeneous prolog/epilog lowering pass";
}

fn AArch64LowerHomogeneousPrologEpilogLegacy::getPassKind(self: *AArch64LowerHomogeneousPrologEpilogLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64LowerHomogeneousPrologEpilogLegacy::getPassID(self: *AArch64LowerHomogeneousPrologEpilogLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64LowerHomogeneousPrologEpilogLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64LowerHomogeneousPrologEpilogLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64LowerHomogeneousPrologEpilogLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64LowerHomogeneousPrologEpilogLegacy::getResolver(self: *AArch64LowerHomogeneousPrologEpilogLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

static mut ID: i8 = 0;

fn AArch64LowerHomogeneousPrologEpilogLegacy::runOnModule(self, M: *mut Module) -> bool {
    if self.skipModule(M) {
        return false;
    }
    let mut MMI: *mut MachineModuleInfo = &mut self.getAnalysis().getMMI();
    return AArch64LowerHomogeneousPrologEpilogImpl { &mut M, MMI }.run();
}

fn AArch64LowerHomogeneousPrologEpilogPass::run(self, M: *mut Module, MAM: *mut ModuleAnalysisManager) -> PreservedAnalyses {
    let mut MMI: *mut MachineModuleInfo = &mut MAM.getResult(M).getMMI();
    let mut Changed: bool = AArch64LowerHomogeneousPrologEpilogImpl { &mut M, MMI }.run();
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = PreservedAnalyses {};
    PA.preserve();
    return PA;
}

fn AArch64LowerHomogeneousPrologEpilogImpl::run(self) -> bool {
    let mut Changed: bool = false;
    for F in *self.M {
        if F.is_empty() {
            continue;
        }
        let mut MF: *mut MachineFunction = self.MMI.getMachineFunction(F);
        if !MF {
            continue;
        }
        Changed |= self.runOnMachineFunction(*MF);
    }
    return Changed;
}

enum FrameHelperType {
    Prolog = 0,
    PrologFrame = 1,
    Epilog = 2,
    EpilogTail = 3,
}

fn getFrameHelperName(Regs: *mut SmallVectorImpl<unsigned int>, Type: FrameHelperType, FpOffset: u32) -> str {
    let mut RegStream: ostringstream = ostringstream {};
    match Type {
        Prolog => {
            RegStream << "OUTLINED_FUNCTION_PROLOG_";
        },
        PrologFrame => {
            RegStream << "OUTLINED_FUNCTION_PROLOG_FRAME" << FpOffset << "_";
        },
        Epilog => {
            RegStream << "OUTLINED_FUNCTION_EPILOG_";
        },
        EpilogTail => {
            RegStream << "OUTLINED_FUNCTION_EPILOG_TAIL_";
        },
    }
    for Reg in Regs {
        if Reg == NoRegister {
            continue;
        }
        RegStream << getRegisterName(Reg, NoRegAltName);
    }
    return RegStream;
}

fn createFrameHelperMachineFunction(M: *mut Module, MMI: *mut MachineModuleInfo, Name: str) -> *mut MachineFunction {
    let mut C: *mut LLVMContext = M.getContext();
    let mut F: *mut Function = M.getFunction(Name);
    assert!(F == null, "Function has been created before");
    F = Create(get(getVoidTy(C), false), ExternalLinkage, Name, M);
    assert!(F, "Function was null!");
    F.setLinkage(LinkOnceODRLinkage);
    F.setUnnamedAddr(Global);
    F.addFnAttr(NoInline);
    F.addFnAttr(MinSize);
    F.addFnAttr(Naked);
    let mut MF: *mut MachineFunction = MMI.getOrCreateMachineFunction(*F);
    MF.getProperties().resetTracksLiveness().resetIsSSA().setNoVRegs().setNoPHIs();
    MF.getRegInfo().freezeReservedRegs();
    let mut EntryBB: *mut BasicBlock = Create(C, "entry", F, null);
    let mut Builder: IRBuilder<> = EntryBB;
    Builder.CreateRetVoid();
    let mut MBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(null, nullopt);
    MF.insert(MF.begin(), MBB);
    return MF;
}

fn emitStore(MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, Pos: iterator, TII: *TargetInstrInfo, Reg1: u32, Reg2: u32, Offset: i32, IsPreDec: bool) {
    assert!(Reg1 != NoRegister);
    let mut IsPaired: bool = Reg2 != NoRegister;
    let mut IsFloat: bool = FPR64RegClass.contains(Reg1);
    assert!(!(IsFloat ^ FPR64RegClass.contains(Reg2);
    let mut Opc: u32 = 0;
    if IsPreDec {
        if IsFloat {
            Opc = if IsPaired { STPDpre } else { STRDpre };
        } else {
            Opc = if IsPaired { STPXpre } else { STRXpre };
        }
    } else {
        if IsFloat {
            Opc = if IsPaired { STPDi } else { STRDui };
        } else {
            Opc = if IsPaired { STPXi } else { STRXui };
        }
    }
    let mut Scale: TypeSize = TypeSize { 0, false };
    let mut Width: TypeSize = TypeSize { 0, false };
    let mut MinOffset: i64 = 0;
    let mut MaxOffset: i64 = 0;
    let mut Success: bool = getMemOpInfo(Opc, Scale, Width, MinOffset, MaxOffset);
    assert!(Success, "Invalid Opcode");
    Offset *= (8 / Scale.operator unsigned long long() as i32);
    let mut MIB: MachineInstrBuilder = BuildMI(MBB, Pos, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Opc));
    if IsPreDec {
        MIB.addDef(SP, RegState {}, 0);
    }
    if IsPaired {
        MIB.addReg(Reg2, RegState {}, 0);
    }
    MIB.addReg(Reg1, RegState {}, 0).addReg(SP, RegState {}, 0).addImm(Offset).setMIFlag(FrameSetup);
}

fn emitLoad(MF: *mut MachineFunction, MBB: *mut MachineBasicBlock, Pos: iterator, TII: *TargetInstrInfo, Reg1: u32, Reg2: u32, Offset: i32, IsPostDec: bool) {
    assert!(Reg1 != NoRegister);
    let mut IsPaired: bool = Reg2 != NoRegister;
    let mut IsFloat: bool = FPR64RegClass.contains(Reg1);
    assert!(!(IsFloat ^ FPR64RegClass.contains(Reg2);
    let mut Opc: u32 = 0;
    if IsPostDec {
        if IsFloat {
            Opc = if IsPaired { LDPDpost } else { LDRDpost };
        } else {
            Opc = if IsPaired { LDPXpost } else { LDRXpost };
        }
    } else {
        if IsFloat {
            Opc = if IsPaired { LDPDi } else { LDRDui };
        } else {
            Opc = if IsPaired { LDPXi } else { LDRXui };
        }
    }
    let mut Scale: TypeSize = TypeSize { 0, false };
    let mut Width: TypeSize = TypeSize { 0, false };
    let mut MinOffset: i64 = 0;
    let mut MaxOffset: i64 = 0;
    let mut Success: bool = getMemOpInfo(Opc, Scale, Width, MinOffset, MaxOffset);
    assert!(Success, "Invalid Opcode");
    Offset *= (8 / Scale.operator unsigned long long() as i32);
    let mut MIB: MachineInstrBuilder = BuildMI(MBB, Pos, MIMetadata { DL: DebugLoc { Loc: null }, PCSections: null, MMRA: null, DeactivationSymbol: null }, TII.get(Opc));
    if IsPostDec {
        MIB.addDef(SP, RegState {}, 0);
    }
    if IsPaired {
        MIB.addReg(Reg2, getDefRegState(true), 0);
    }
    MIB.addReg(Reg1, getDefRegState(true), 0).addReg(SP, RegState {}, 0).addImm(Offset).setMIFlag(FrameDestroy);
}

fn getOrCreateFrameHelper(M: *mut Module, MMI: *mut MachineModuleInfo, Regs: *mut SmallVectorImpl<unsigned int>, Type: FrameHelperType, FpOffset: u32) -> *mut Function {
    assert!(Regs.len >= 2);
    let mut Name: str = getFrameHelperName(Regs, Type, FpOffset);
    let mut F: *mut Function = M.getFunction(Name);
    if F {
        return F;
    }
    let mut MF: *mut MachineFunction = createFrameHelperMachineFunction(M, MMI, Name);
    let mut MBB: *mut MachineBasicBlock = operator(MF.begin());
    let mut STI: *TargetSubtargetInfo = MF.getSubtarget();
    let mut TII: *TargetInstrInfo = *STI.getInstrInfo();
    let mut Size: i32 = Regs.len as i32;
    match Type {
        Prolog => {
            PrologFrame;
        },
        Epilog => {
            EpilogTail;
        },
    }
    return M.getFunction(Name);
}

fn shouldUseFrameHelper(MBB: *mut MachineBasicBlock, NextMBBI: *mut iterator, Regs: *mut SmallVectorImpl<unsigned int>, Type: FrameHelperType) -> bool {
    let mut TRI: *TargetRegisterInfo = MBB.getParent().getSubtarget().getRegisterInfo();
    let mut RegCount: u64 = Regs.len;
    assert!(RegCount > 0 && (RegCount % 2 == 0);
    let mut InstCount: i32 = RegCount / 2;
    if !is_contained(Regs, LR) {
        return false;
    }
    match Type {
        Prolog => {
            InstCount -= 1;
        },
        PrologFrame => {
            break;
        },
        Epilog => {
            for let mut NextMI: iterator = NextMBBI; NextMI != MBB.end(); operator(NextMI, 0) {
                if operator(NextMI).readsRegister(W16, TRI) {
                    return false;
                }
            }
        },
        EpilogTail => {
            if NextMBBI == MBB.end() {
                return false;
            }
            if operator(NextMBBI).getOpcode() != RET_ReallyLR {
                return false;
            }
            InstCount += 1;
            break;
        },
    }
    return InstCount >= FrameHelperSizeThreshold.operator int();
}

fn AArch64LowerHomogeneousPrologEpilogImpl::lowerEpilog(self, MBB: *mut MachineBasicBlock, MBBI: iterator, NextMBBI: *mut iterator) -> bool {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut Regs: SmallVector<unsigned int, 8> = SmallVector<unsigned int, 8> {};
    let mut HasUnpairedReg: bool = false;
    for MO in MI.operands() {
        if MO.isReg() {
            if !MO.getReg().isValid() {
                assert!(!HasUnpairedReg);
                HasUnpairedReg = true;
            }
            Regs.push(MO.getReg().operator unsigned int());
        }
    }
    HasUnpairedReg as void;
    let mut Size: i32 = Regs.len as i32;
    if Size == 0 {
        return false;
    }
    assert!(Size % 2 == 0);
    assert!(MI.getOpcode() == HOM_Epilog);
    let mut Return: iterator = NextMBBI;
    let mut HelperCall: *mut MachineInstr = null;
    if shouldUseFrameHelper(MBB, NextMBBI, Regs, EpilogTail) {
        let mut EpilogTailHelper: *mut Function = getOrCreateFrameHelper(self.M, self.MMI, Regs, EpilogTail, 0);
        HelperCall = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(TCRETURNdi)).addGlobalAddress(EpilogTailHelper, 0, 0).addImm(0).setMIFlag(FrameDestroy).copyImplicitOps(MI).copyImplicitOps(operator(Return)).operator llvm::MachineInstr *();
        NextMBBI = next(Return, 1);
        operator(Return).removeFromParent();
    } else if shouldUseFrameHelper(MBB, NextMBBI, Regs, Epilog) {
        let mut EpilogHelper: *mut Function = getOrCreateFrameHelper(self.M, self.MMI, Regs, Epilog, 0);
        HelperCall = BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(BL)).addGlobalAddress(EpilogHelper, 0, 0).setMIFlag(FrameDestroy).copyImplicitOps(MI).operator llvm::MachineInstr *();
    } else {
        for let mut I: i32 = 0; I < Size - 2; I += 2 {
            emitLoad(MF, MBB, MBBI, *self.TII, Regs[I], Regs[I + 1], Size - I - 2, false);
        }
        emitLoad(MF, MBB, MBBI, *self.TII, Regs[Size - 2], Regs[Size - 1], Size, true);
    }
    if HelperCall {
        for Def in operator(MBBI).defs() {
            HelperCall.addRegisterDefined(Def.getReg(), MF.getRegInfo().getTargetRegisterInfo());
        }
    }
    operator(MBBI).removeFromParent();
    return true;
}

fn AArch64LowerHomogeneousPrologEpilogImpl::lowerProlog(self, MBB: *mut MachineBasicBlock, MBBI: iterator, NextMBBI: *mut iterator) -> bool {
    let mut MF: *mut MachineFunction = *MBB.getParent();
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut DL: DebugLoc = MI.getDebugLoc();
    let mut Regs: SmallVector<unsigned int, 8> = SmallVector<unsigned int, 8> {};
    let mut HasUnpairedReg: bool = false;
    let mut LRIdx: i32 = 0;
    let mut FpOffset: optional<int> = optional<int> {};
    for MO in MI.operands() {
        if MO.isReg() {
            if MO.getReg().isValid() {
                if MO.getReg() == LR {
                    LRIdx = Regs.len;
                }
            } else {
                assert!(!HasUnpairedReg);
                HasUnpairedReg = true;
            }
            Regs.push(MO.getReg().operator unsigned int());
        } else if MO.isImm() {
            FpOffset = MO.getImm();
        }
    }
    HasUnpairedReg as void;
    let mut Size: i32 = Regs.len as i32;
    if Size == 0 {
        return false;
    }
    assert!(Size % 2 == 0);
    assert!(MI.getOpcode() == HOM_Prolog);
    if FpOffset && shouldUseFrameHelper(MBB, NextMBBI, Regs, PrologFrame) {
        emitStore(MF, MBB, MBBI, *self.TII, LR, FP, -LRIdx - 2, true);
        let mut PrologFrameHelper: *mut Function = getOrCreateFrameHelper(self.M, self.MMI, Regs, PrologFrame, operator(FpOffset));
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(BL)).addGlobalAddress(PrologFrameHelper, 0, 0).setMIFlag(FrameSetup).copyImplicitOps(MI).addReg(FP, Implicit | Define, 0).addReg(SP, Implicit, 0);
    } else if !FpOffset && shouldUseFrameHelper(MBB, NextMBBI, Regs, Prolog) {
        emitStore(MF, MBB, MBBI, *self.TII, LR, FP, -LRIdx - 2, true);
        let mut PrologHelper: *mut Function = getOrCreateFrameHelper(self.M, self.MMI, Regs, Prolog, 0);
        BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(BL)).addGlobalAddress(PrologHelper, 0, 0).setMIFlag(FrameSetup).copyImplicitOps(MI);
    } else {
        emitStore(MF, MBB, MBBI, *self.TII, Regs[Size - 2], Regs[Size - 1], -Size, true);
        for let mut I: i32 = Size - 3; I >= 0; I -= 2 {
            emitStore(MF, MBB, MBBI, *self.TII, Regs[I - 1], Regs[I], Size - I - 1, false);
        }
        if FpOffset {
            BuildMI(MBB, MBBI, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(ADDXri)).addDef(FP, RegState {}, 0).addUse(SP, RegState {}, 0).addImm(operator(FpOffset)).addImm(0).setMIFlag(FrameSetup);
        }
    }
    operator(MBBI).removeFromParent();
    return true;
}

fn AArch64LowerHomogeneousPrologEpilogImpl::runOnMI(self, MBB: *mut MachineBasicBlock, MBBI: iterator, NextMBBI: *mut iterator) -> bool {
    let mut MI: *mut MachineInstr = operator(MBBI);
    let mut Opcode: u32 = MI.getOpcode();
    match Opcode {
        _ => {
            break;
        },
        HOM_Prolog => {
            return self.lowerProlog(MBB, MBBI, NextMBBI);
        },
        HOM_Epilog => {
            return self.lowerEpilog(MBB, MBBI, NextMBBI);
        },
    }
    return false;
}

fn AArch64LowerHomogeneousPrologEpilogImpl::runOnMBB(self, MBB: *mut MachineBasicBlock) -> bool {
    let mut Modified: bool = false;
    let mut MBBI: iterator = MBB.begin();
    let mut E: iterator = MBB.end();
    while MBBI != E {
        let mut NMBBI: iterator = next(MBBI, 1);
        Modified |= self.runOnMI(MBB, MBBI, NMBBI);
        MBBI = NMBBI;
    }
    return Modified;
}

fn AArch64LowerHomogeneousPrologEpilogImpl::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    self.TII = MF.getSubtarget().getInstrInfo();
    let mut Modified: bool = false;
    for MBB in MF {
        Modified |= self.runOnMBB(MBB);
    }
    return Modified;
}

fn createAArch64LowerHomogeneousPrologEpilogPass() -> *mut ModulePass {
    return AArch64LowerHomogeneousPrologEpilogLegacy {};
}
