    let mut CI: *CallInst = dyn_cast(Instr);
    return operator!((CI && CI.isInlineAsm));
}

fn shouldConvertImpl(Cst: *Constant) -> bool {
    if isa(Cst) {
        return false;
    }
    if Cst.isNullValue() {
        return false;
    }
    if Cst.getType().isScalableTy() {
        return false;
    }
    if Stress() {
        return true;
    }
    if Cst.getType().isVectorTy() {
        return false;
    }
    return isConstantUsingVectorTy(Cst.getType());
}

fn shouldConvert(C: *mut Constant, PromotionCache: *mut i32) -> bool {
    let mut Converted: auto = (make_pair(&mut C, PromotedConstant {}));
    if Converted() {
        Converted() = shouldConvertImpl(&mut C);
    }
    return ;
}

