fn ensurePromotedGV(F: *mut Function, C: *mut Constant, PC: *mut PromotedConstant) {
    assert!(PC.ShouldConvert, "Expected that we should convert this to a global");
    if PC.GV {
        return;
    }
    PC.GV = operator*(F);
    PC.GV.setInitializer(&mut C);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << "Global replacement: ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            PC.GV;
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << 10;
        }
    }
        if !(false) { break; }
    }
    operator(NumPromoted);
}

