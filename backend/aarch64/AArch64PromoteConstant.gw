static mut Stress: opt<bool> = opt<bool> { "aarch64-stress-promote-const", Hidden, "Promote all vector constants" };

static mut NumPromoted: Statistic = Statistic { "aarch64-promote-const", "NumPromoted", "Number of promoted constants" };

static mut NumPromotedUses: Statistic = Statistic { "aarch64-promote-const", "NumPromotedUses", "Number of promoted constants uses" };

struct AArch64PromoteConstant {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
}

fn AArch64PromoteConstant::getPassName(self: *AArch64PromoteConstant) -> str {
    return "AArch64 Promote Constant";
}

fn AArch64PromoteConstant::runOnModule(self, M: *mut Module) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << self.getPassName() << 10;
        }
    }
        if !(false) { break; }
    }
    if self.skipModule(M) {
        return false;
    }
    let mut Changed: bool = false;
    let mut PromotionCache: PromotionCacheTy = PromotionCacheTy {};
    for MF in M {
        Changed |= self.runOnFunction(MF, PromotionCache);
    }
    return Changed;
}

fn AArch64PromoteConstant::getAnalysisUsage(self: *AArch64PromoteConstant, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU.addRequired();
}

fn AArch64PromoteConstant::appendAndTransferDominatedUses(self, NewPt: *mut Instruction, User: *mut Instruction, OpNo: u32, IPI: *mut iterator, InsertPts: *mut InsertionPoints) {
    operator(IPI).second.push(User, OpNo);
    let mut OldInstr: *mut Instruction = operator(IPI).first;
    let mut OldUses: Uses = move(operator(IPI).second);
    InsertPts[NewPt] = move(OldUses);
    InsertPts.erase(OldInstr);
}

fn AArch64PromoteConstant::getPassKind(self: *AArch64PromoteConstant) -> PassKind {
    return self.Kind;
}

fn AArch64PromoteConstant::getPassID(self: *AArch64PromoteConstant) -> AnalysisID {
    return self.PassID;
}

fn AArch64PromoteConstant::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64PromoteConstant::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64PromoteConstant::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64PromoteConstant::getResolver(self: *AArch64PromoteConstant) -> *mut AnalysisResolver {
    return self.Resolver;
}

static mut ID: i8 = 0;

fn createAArch64PromoteConstantPass() -> *mut ModulePass {
    return AArch64PromoteConstant {};
}

fn isConstantUsingVectorTy(CstTy: *Type) -> bool {
    if CstTy.isVectorTy() {
        return true;
    }
    if CstTy.isStructTy() {
        for let mut EltIdx: u32 = 0;
let mut EndEltIdx: u32 = CstTy.getStructNumElements(); EltIdx < EndEltIdx; EltIdx += 1 {
            if isConstantUsingVectorTy(CstTy.getStructElementType(EltIdx)) {
                return true;
            }
        }
    } else if CstTy.isArrayTy() {
        return isConstantUsingVectorTy(CstTy.getArrayElementType());
    }
    return false;
}

fn containsOnlyConstantData(C: *Constant) -> bool {
    if isa(C) {
        return true;
    }
    if isa(C) || isa(C) || isa(C) {
        return false;
    }
    return all_of(C.operands(), Closure_1 {});
}

fn shouldConvertUse(Cst: *Constant, Instr: *Instruction, OpIdx: u32) -> bool {
    if isa(Instr) && OpIdx == 2 {
        return false;
    }
    if isa(Instr) && OpIdx > 0 {
        return false;
    }
    if isa(Instr) && OpIdx > 1 {
        return false;
    }
    if isa(Instr) && OpIdx > 0 {
        return false;
    }
    if isa(Instr) && OpIdx > 0 {
        return false;
    }
    if isa(Instr) && OpIdx > 1 {
        return false;
    }
    if isa(Instr) && OpIdx > 0 {
        return false;
    }
    if isa(Instr) {
        return false;
    }
    if isa(Instr) {
        return false;
    }
    if isa(Instr) {
        return false;
    }
    if isa(Instr) {
        return false;
    }
    let mut CI: *CallInst = dyn_cast(Instr);
    return !(CI && CI.isInlineAsm());
}

fn shouldConvertImpl(Cst: *Constant) -> bool {
    if isa(Cst) {
        return false;
    }
    if Cst.isNullValue() {
        return false;
    }
    if Cst.getType().isScalableTy() {
        return false;
    }
    if Stress {
        return true;
    }
    if Cst.getType().isVectorTy() {
        return false;
    }
    return isConstantUsingVectorTy(Cst.getType());
}

fn shouldConvert(C: *mut Constant, PromotionCache: *mut PromotionCacheTy) -> bool {
    let mut Converted: pair<iterator, bool> = PromotionCache.insert(make_pair(&mut C, PromotedConstant {}));
    if Converted.second {
        operator(Converted.first).second.ShouldConvert = shouldConvertImpl(&mut C);
    }
    return operator(Converted.first).second.ShouldConvert;
}

fn AArch64PromoteConstant::findInsertionPoint(self, User: *mut Instruction, OpNo: u32) -> *mut Instruction {
    if dyn_cast(&mut User) {
        PhiInst;
    } else {
        return PhiInst.getIncomingBlock(OpNo).getTerminator();
    }
    return &mut User;
}

fn AArch64PromoteConstant::isDominated(self, NewPt: *mut Instruction, User: *mut Instruction, OpNo: u32, InsertPts: *mut InsertionPoints) -> bool {
    let mut DT: *mut DominatorTree = self.getAnalysis(*NewPt.getParent().getParent(), null).getDomTree();
    for IPI in InsertPts {
        if NewPt == IPI.first || DT.dominates(IPI.first, NewPt) || (IPI.first.getParent() != NewPt.getParent() && DT.dominates(IPI.first.getParent(), NewPt.getParent())) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                    dbgs() << "Insertion point dominated by:\n";
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                    IPI.first.print(dbgs(), false);
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                    dbgs() << 10;
                }
            }
                if !(false) { break; }
            }
            IPI.second.push(User, OpNo);
            return true;
        }
    }
    return false;
}

fn AArch64PromoteConstant::tryAndMerge(self, NewPt: *mut Instruction, User: *mut Instruction, OpNo: u32, InsertPts: *mut InsertionPoints) -> bool {
    let mut DT: *mut DominatorTree = self.getAnalysis(*NewPt.getParent().getParent(), null).getDomTree();
    let mut NewBB: *mut BasicBlock = NewPt.getParent();
    for let mut IPI: iterator = InsertPts.begin();
let mut EndIPI: iterator = InsertPts.end(); IPI != EndIPI; operator(IPI) {
        let mut CurBB: *mut BasicBlock = operator(IPI).first.getParent();
        if NewBB == CurBB {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                    dbgs() << "Merge insertion point with:\n";
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                    operator(IPI).first.print(dbgs(), false);
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                    dbgs() << "\nat considered insertion point.\n";
                }
            }
                if !(false) { break; }
            }
            appendAndTransferDominatedUses(NewPt, User, OpNo, IPI, InsertPts);
            return true;
        }
        let mut CommonDominator: *mut BasicBlock = DT.findNearestCommonDominator(NewBB, CurBB);
        if !CommonDominator {
            continue;
        }
        if CommonDominator != NewBB {
            assert!(CommonDominator != CurBB, "Instruction has not been rejected during isDominated check!");
            NewPt = CommonDominator.getTerminator();
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                dbgs() << "Merge insertion point with:\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                operator(IPI).first.print(dbgs(), false);
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                dbgs() << 10;
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                NewPt.print(dbgs(), false);
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                dbgs() << 10;
            }
        }
            if !(false) { break; }
        }
        appendAndTransferDominatedUses(NewPt, User, OpNo, IPI, InsertPts);
        return true;
    }
    return false;
}

fn AArch64PromoteConstant::computeInsertionPoint(self, User: *mut Instruction, OpNo: u32, InsertPts: *mut InsertionPoints) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << "Considered use, opidx " << OpNo << ":\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            User.print(dbgs(), false);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << 10;
        }
    }
        if !(false) { break; }
    }
    let mut InsertionPoint: *mut Instruction = self.findInsertionPoint(*User, OpNo);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << "Considered insertion point:\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            InsertionPoint.print(dbgs(), false);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << 10;
        }
    }
        if !(false) { break; }
    }
    if self.isDominated(InsertionPoint, User, OpNo, InsertPts) {
        return;
    }
    if self.tryAndMerge(InsertionPoint, User, OpNo, InsertPts) {
        return;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << "Keep considered insertion point\n";
        }
    }
        if !(false) { break; }
    }
    InsertPts[InsertionPoint].push(User, OpNo);
}

fn ensurePromotedGV(F: *mut Function, C: *mut Constant, PC: *mut PromotedConstant) {
    assert!(PC.ShouldConvert, "Expected that we should convert this to a global");
    if PC.GV {
        return;
    }
    PC.GV = GlobalVariable { *F.getParent(), C.getType(), true, InternalLinkage, null, "_PromotedConst", null, NotThreadLocal, nullopt, false };
    PC.GV.setInitializer(&mut C);
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << "Global replacement: ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            PC.GV.print(dbgs(), false);
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
            dbgs() << 10;
        }
    }
        if !(false) { break; }
    }
    operator(NumPromoted);
}

fn AArch64PromoteConstant::insertDefinitions(self, F: *mut Function, PromotedGV: *mut GlobalVariable, InsertPts: *mut InsertionPoints) {
    let mut DT: *mut DominatorTree = self.getAnalysis(F, null).getDomTree();
    assert!(!InsertPts.is_empty(), "Empty uses does not need a definition");
    for IPI in InsertPts {
        let mut Builder: IRBuilder<> = IPI.first;
        let mut LoadedCst: *mut LoadInst = Builder.CreateLoad(PromotedGV.getValueType(), &mut PromotedGV, "");
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                dbgs() << "**********\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                dbgs() << "New def: ";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                LoadedCst.print(dbgs(), false);
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                dbgs() << 10;
            }
        }
            if !(false) { break; }
        }
        for Use in IPI.second {
            assert!(DT.dominates(LoadedCst, self.findInsertionPoint(*Use.first, Use.second)), "Inserted definition does not dominate all its uses!");
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                    {
                        dbgs() << "Use to update " << Use.second << ":";
                        Use.first.print(dbgs(), false);
                        dbgs() << 10;
                    }
                }
            }
                if !(false) { break; }
            }
            Use.first.setOperand(Use.second, LoadedCst);
            operator(NumPromotedUses);
        }
    }
}

fn AArch64PromoteConstant::promoteConstants(self, F: *mut Function, Updates: *mut SmallVectorImpl<UpdateRecord>, PromotionCache: *mut PromotionCacheTy) {
    for let mut U: iterator = Updates.begin();
let mut E: iterator = Updates.end(); U != E;  {
        while true {
            {
            if DebugFlag && isCurrentDebugType("aarch64-promote-const", 1) {
                dbgs() << "** Compute insertion points **\n";
            }
        }
            if !(false) { break; }
        }
        let mut First: iterator = U;
        let mut C: *mut Constant = First.C;
        let mut InsertPts: InsertionPoints = InsertionPoints {};
        while true {
            {
            self.computeInsertionPoint(U.User, U.Op, InsertPts);
        }
            if !(U += 1 != E && U.C == C) { break; }
        }
        let mut Promotion: *mut PromotedConstant = PromotionCache[C];
        ensurePromotedGV(F, *C, Promotion);
        self.insertDefinitions(F, *Promotion.GV, InsertPts);
    }
}

fn AArch64PromoteConstant::runOnFunction(self, F: *mut Function, PromotionCache: *mut PromotionCacheTy) -> bool {
    let mut Updates: SmallVector<UpdateRecord, 64> = SmallVector<UpdateRecord, 64> {};
    for I in instructions(&mut F) {
        for U in I.operands() {
            let mut Cst: *mut Constant = dyn_cast(U);
            if !Cst || isa(Cst) || !containsOnlyConstantData(Cst) {
                continue;
            }
            if !shouldConvert(*Cst, PromotionCache) {
                continue;
            }
            let mut OpNo: u32 = &mut U - I.op_begin();
            if !shouldConvertUse(Cst, &mut I, OpNo) {
                continue;
            }
            Updates.push(Cst, &mut I, OpNo);
        }
    }
    if Updates.is_empty() {
        return false;
    }
    self.promoteConstants(F, Updates, PromotionCache);
    return true;
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, U: *Use) -> bool {
        return containsOnlyConstantData(cast(&mut U));
    }
