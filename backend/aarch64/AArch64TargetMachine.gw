fn AArch64TargetMachine::isGlobalISelOptNone(self: *AArch64TargetMachine) -> bool {
    let mut GlobalISelFlag: bool = getCGPassBuilderOption().EnableGlobalISelOption == BOU_TRUE;
    return self.getOptLevel == None || (self.getOptLevel as u32 >  as u32 && !GlobalISelFlag);
}

fn AArch64TargetMachine::reset(self) {
    self.LastSubtarget = null;
}

fn createTLOF(TT: *Triple) -> i32 {
    if TT.isOSBinFormatMachO() {
        return make_unique();
    }
    if TT.isOSBinFormatCOFF() {
        return make_unique();
    }
    return make_unique();
}

fn computeDefaultCPU(TT: *Triple, CPU: str) -> str {
    if CPU.is_empty() && TT.isArm64e() {
        return "apple-a12";
    }
    return CPU;
}

fn getEffectiveRelocModel(TT: *Triple, RM: Model>) -> Model {
    if TT.isOSDarwin() || TT.isOSWindows() {
        return PIC_;
    }
    if operator!() || operator*() == DynamicNoPIC {
        return Static;
    }
    return operator*();
}

fn getEffectiveAArch64CodeModel(TT: *Triple, CM: Model>, JIT: bool) -> Model {
    if CM() {
        if operator*() != Small && operator*() != Tiny && operator*() != Large {
            report_fatal_error("Only small, tiny and large code models are allowed on AArch64", true);
        } else if operator*() == Tiny && !TT.isOSBinFormatELF() {
            report_fatal_error("tiny code model is only supported on ELF", true);
        }
        return operator*();
    }
    if JIT && !TT.isOSWindows() {
        return Large;
    }
    return Small;
}

fn AArch64TargetMachine::AArch64TargetMachine(self, T: *Target, TT: *Triple, CPU: str, FS: str, Options: *TargetOptions, RM: Model>, CM: Model>, OL: CodeGenOptLevel, JIT: bool, LittleEndian: bool) {
    self.initAsmInfo;
    if TT.isOSBinFormatMachO() {
        self = true;
        self = true;
    }
    if self.getMCAsmInfo() {
        self = true;
    }
    if self == 0 {
        self = 24;
    }
    if (self.getCodeModel == Small || self.getCodeModel == Kernel) && self > 32 {
        self = 32;
    } else if self.getCodeModel == Tiny && self > 24 {
        self = 24;
    }
    let mut TargetSupportsGISel: bool = TT.getArch() != aarch64_32 && TT.getEnvironment() != GNUILP32 && operator!((self.getCodeModel == Large && TT.isOSBinFormatMachO()));
    let mut GlobalISelFlag: bool = getCGPassBuilderOption().EnableGlobalISelOption == BOU_TRUE;
    if TargetSupportsGISel &&  != -1 && (self.getOptLevel as i32 <=  || (!GlobalISelFlag && !Options.EnableGlobalISel)) {
        self.setGlobalISel;
        self.setGlobalISelAbort;
    }
    setUseExtended(true);
    self.setMachineOutliner;
    self.setSupportsDefaultOutlining;
    self.setSupportsDebugEntryValues;
    if operator!(self.getMCAsmInfo()) {
        self.setCFIFixup;
    }
}

