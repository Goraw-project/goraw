static mut EnableCollectLOH: opt<bool> = opt<bool> { "aarch64-enable-collect-loh", "Enable the pass that emits the linker optimization hints (LOH)", init(true), Hidden };

static mut EnableDeadRegisterElimination: opt<bool> = opt<bool> { "aarch64-enable-dead-defs", Hidden, "Enable the pass that removes dead definitions and replaces stores to them with stores to the zero register", init(true) };

static mut EnableRedundantCopyElimination: opt<bool> = opt<bool> { "aarch64-enable-copyelim", "Enable the redundant copy elimination pass", init(true), Hidden };

static mut EnableLoadStoreOpt: opt<bool> = opt<bool> { "aarch64-enable-ldst-opt", "Enable the load/store pair optimization pass", init(true), Hidden };

static mut EnableAtomicTidy: opt<bool> = opt<bool> { "aarch64-enable-atomic-cfg-tidy", Hidden, "Run SimplifyCFG after expanding atomic operations to make use of cmpxchg flow-based information", init(true) };

static mut EnableEarlyIfConversion: opt<bool> = opt<bool> { "aarch64-enable-early-ifcvt", Hidden, "Run early if-conversion", init(true) };

static mut EnableCondOpt: opt<bool> = opt<bool> { "aarch64-enable-condopt", "Enable the condition optimizer pass", init(true), Hidden };

static mut EnableGEPOpt: opt<bool> = opt<bool> { "aarch64-enable-gep-opt", Hidden, "Enable optimizations on complex GEPs", init(false) };

static mut EnableSelectOpt: opt<bool> = opt<bool> { "aarch64-select-opt", Hidden, "Enable select to branch optimizations", init(true) };

static mut BranchRelaxation: opt<bool> = opt<bool> { "aarch64-enable-branch-relax", Hidden, init(true), "Relax out of range conditional branches" };

static mut EnableCompressJumpTables: opt<bool> = opt<bool> { "aarch64-enable-compress-jump-tables", Hidden, init(true), "Use smallest entry possible for jump tables" };

static mut EnableGlobalMerge: boolOrDefault> = boolOrDefault> { "aarch64-enable-global-merge", Hidden, "Enable the global merge pass" };

static mut EnableLoopDataPrefetch: opt<bool> = opt<bool> { "aarch64-enable-loop-data-prefetch", Hidden, "Enable the loop data prefetch pass", init(true) };

static mut EnableGlobalISelAtO: opt<int> = opt<int> { "aarch64-enable-global-isel-at-O", Hidden, "Enable GlobalISel at or below an opt level (-1 to disable)", init(0) };

static mut EnableSMEPeepholeOpt: opt<bool> = opt<bool> { "enable-aarch64-sme-peephole-opt", init(true), Hidden, "Perform SME peephole optimization" };

static mut EnableFalkorHWPFFix: opt<bool> = opt<bool> { "aarch64-enable-falkor-hwpf-fix", init(true), Hidden };

static mut EnableBranchTargets: opt<bool> = opt<bool> { "aarch64-enable-branch-targets", Hidden, "Enable the AArch64 branch target pass", init(true) };

static mut SVEVectorBitsMaxOpt: opt<unsigned int> = opt<unsigned int> { "aarch64-sve-vector-bits-max", "Assume SVE vector registers are at most this big, with zero meaning no maximum size is assumed.", init(0), Hidden };

static mut SVEVectorBitsMinOpt: opt<unsigned int> = opt<unsigned int> { "aarch64-sve-vector-bits-min", "Assume SVE vector registers are at least this big, with zero meaning no minimum size is assumed.", init(0), Hidden };

static mut ForceStreaming: opt<bool> = opt<bool> { "force-streaming", "Force the use of streaming code for all functions", init(false), Hidden };

static mut ForceStreamingCompatible: opt<bool> = opt<bool> { "force-streaming-compatible", "Force the use of streaming-compatible code for all functions", init(false), Hidden };

static mut EnableHomogeneousPrologEpilog: opt<bool> = zeroed();

static mut EnableGISelLoadStoreOptPreLegal: opt<bool> = opt<bool> { "aarch64-enable-gisel-ldst-prelegal", "Enable GlobalISel's pre-legalizer load/store optimization pass", init(true), Hidden };

static mut EnableGISelLoadStoreOptPostLegal: opt<bool> = opt<bool> { "aarch64-enable-gisel-ldst-postlegal", "Enable GlobalISel's post-legalizer load/store optimization pass", init(false), Hidden };

