static mut EnableCCMP: opt<bool> = opt<bool> { "aarch64-enable-ccmp", "Enable the CCMP formation pass", init(true), Hidden };

static mut EnableCondBrTuning: opt<bool> = opt<bool> { "aarch64-enable-cond-br-tune", "Enable the conditional branch tuning pass", init(true), Hidden };

