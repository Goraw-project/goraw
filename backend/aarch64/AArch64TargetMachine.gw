struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, Name: str, PM: *mut ModulePassManager, arg: PipelineElement>) -> bool {
        if Name == "aarch64-asm-printer-begin" {
            PM.addPass(AArch64AsmPrinterBeginPass {});
            return true;
        }
        if Name == "aarch64-asm-printer-end" {
            PM.addPass(AArch64AsmPrinterEndPass {});
            return true;
        }
        if Name == "aarch64-lower-homogeneous-prolog-epilog" {
            PM.addPass(AArch64LowerHomogeneousPrologEpilogPass {});
            return true;
        }
        return false;
    }

