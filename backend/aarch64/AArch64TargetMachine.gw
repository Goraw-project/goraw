fn AArch64TargetMachine::registerPassBuilderCallbacks(self, PB: *mut PassBuilder) {
    let mut PIC: *mut PassInstrumentationCallbacks = PB.getPassInstrumentationCallbacks();
    if PIC {
        PIC.registerClassToPassNameCallback(Closure_1 { cap_0: self, PIC: PIC });
    }
    PB.registerPipelineParsingCallback(Closure_2 {});
    PB.registerPipelineParsingCallback(Closure_3 {});
    PB.registerPipelineParsingCallback(Closure_4 {});
    PB.registerPipelineParsingCallback(Closure_5 {});
    PB.registerPipelineParsingCallback(Closure_6 { cap_0: self });
    PB.registerPipelineParsingCallback(Closure_7 { cap_0: self });
    PB.registerPipelineParsingCallback(Closure_8 {});
    PB.registerPipelineParsingCallback(Closure_9 {});
    PB.registerAnalysisRegistrationCallback(Closure_10 {});
    PB.registerAnalysisRegistrationCallback(Closure_11 {});
    PB.registerParseAACallback(Closure_12 {});
    PB.registerAnalysisRegistrationCallback(Closure_13 {});
    PB.registerAnalysisRegistrationCallback(Closure_14 {});
    PB.registerLateLoopOptimizationsEPCallback(Closure_15 {});
    if self.getTargetTriple().isOSWindows() {
        PB.registerPipelineEarlySimplificationEPCallback(Closure_16 {});
    }
}

fn AArch64TargetMachine::getTargetTransformInfo(self: *AArch64TargetMachine, F: *Function) -> TargetTransformInfo {
    return make_unique(self, F);
}

