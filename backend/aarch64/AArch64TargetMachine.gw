static mut EnableSVEShuffleOpt: opt<bool> = opt<bool> { "aarch64-enable-sve-shuffle-opts", "Enable pattern matching of shuffles that could make use of SVE instructions like tbl or the bottom/top variants", init(true), Hidden };

fn LLVMInitializeAArch64Target() {
    let mut X: RegisterTargetMachine<AArch64leTargetMachine> = getTheAArch64leTarget();
    let mut Y: RegisterTargetMachine<AArch64beTargetMachine> = getTheAArch64beTarget();
    let mut Z: RegisterTargetMachine<AArch64leTargetMachine> = getTheARM64Target();
    let mut W: RegisterTargetMachine<AArch64leTargetMachine> = getTheARM64_32Target();
    let mut V: RegisterTargetMachine<AArch64leTargetMachine> = getTheAArch64_32Target();
    let mut PR: *mut PassRegistry = *getPassRegistry();
    initializeGlobalISel(PR);
    initializeAArch64A53Fix835769LegacyPass(PR);
    initializeAArch64A57FPLoadBalancingLegacyPass(PR);
    initializeAArch64CodeLayoutOptPass(PR);
    initializeAArch64AdvSIMDScalarLegacyPass(PR);
    initializeAArch64AsmPrinterPass(PR);
    initializeAArch64BranchTargetsLegacyPass(PR);
    initializeAArch64CollectLOHLegacyPass(PR);
    initializeAArch64CompressJumpTablesLegacyPass(PR);
    initializeAArch64ConditionalComparesLegacyPass(PR);
    initializeAArch64ConditionOptimizerLegacyPass(PR);
    initializeAArch64DeadRegisterDefinitionsLegacyPass(PR);
    initializeAArch64ExpandPseudoLegacyPass(PR);
    initializeAArch64LoadStoreOptLegacyPass(PR);
    initializeAArch64MIPeepholeOptLegacyPass(PR);
    initializeAArch64PTrueCoalescingLegacyPass(PR);
    initializeAArch64SIMDInstrOptLegacyPass(PR);
    initializeAArch64O0PreLegalizerCombinerLegacyPass(PR);
    initializeAArch64PreLegalizerCombinerLegacyPass(PR);
    initializeAArch64PointerAuthLegacyPass(PR);
    initializeAArch64PostCoalescerLegacyPass(PR);
    initializeAArch64PostLegalizerCombinerLegacyPass(PR);
    initializeAArch64PostSelectOptimizeLegacyPass(PR);
    initializeAArch64PostLegalizerLoweringLegacyPass(PR);
    initializeAArch64PromoteConstantPass(PR);
    initializeAArch64RedundantCopyEliminationLegacyPass(PR);
    initializeAArch64RedundantCondBranchLegacyPass(PR);
    initializeAArch64StorePairSuppressPass(PR);
    initializeFalkorHWPFFixPass(PR);
    initializeFalkorMarkStridedAccessesLegacyPass(PR);
    initializeLDTLSCleanupPass(PR);
    initializeMachineKCFILegacyPass(PR);
    initializeMachineSMEABIPass(PR);
    initializeAArch64SRLTDefineSuperRegsLegacyPass(PR);
    initializeSMEPeepholeOptPass(PR);
    initializeAArch64SpeculationHardeningPass(PR);
    initializeAArch64SLSHardeningLegacyPass(PR);
    initializeAArch64StackTaggingPass(PR);
    initializeAArch64StackTaggingPreRALegacyPass(PR);
    initializeAArch64LowerHomogeneousPrologEpilogLegacyPass(PR);
    initializeAArch64DAGToDAGISelLegacyPass(PR);
    initializeAArch64CondBrTuningPass(PR);
    initializeAArch64Arm64ECCallLoweringPass(PR);
    initializeSVEShuffleOptsPass(PR);
}

fn AArch64TargetMachine::isGlobalISelOptNone(self: *AArch64TargetMachine) -> bool {
    let mut GlobalISelFlag: bool = getCGPassBuilderOption().EnableGlobalISelOption == BOU_TRUE;
    return self.getOptLevel() == None || (self.getOptLevel() as u32 > EnableGlobalISelAtO.operator int() as u32 && !GlobalISelFlag);
}

fn AArch64TargetMachine::reset(self) {
    self.SubtargetMap.clear();
    self.LastSubtarget = null;
}

fn createTLOF(TT: *Triple) -> unique_ptr<TargetLoweringObjectFile> {
    if TT.isOSBinFormatMachO() {
        return make_unique();
    }
    if TT.isOSBinFormatCOFF() {
        return make_unique();
    }
    return make_unique();
}

fn computeDefaultCPU(TT: *Triple, CPU: str) -> str {
    if CPU.is_empty() && TT.isArm64e() {
        return "apple-a12";
    }
    return CPU;
}

fn getEffectiveRelocModel(TT: *Triple, RM: Model>) -> Model {
    if TT.isOSDarwin() || TT.isOSWindows() {
        return PIC_;
    }
    if !RM || operator(RM) == DynamicNoPIC {
        return Static;
    }
    return operator(RM);
}

fn getEffectiveAArch64CodeModel(TT: *Triple, CM: Model>, JIT: bool) -> Model {
    if CM {
        if operator(CM) != Small && operator(CM) != Tiny && operator(CM) != Large {
            report_fatal_error("Only small, tiny and large code models are allowed on AArch64", true);
        } else if operator(CM) == Tiny && !TT.isOSBinFormatELF() {
            report_fatal_error("tiny code model is only supported on ELF", true);
        }
        return operator(CM);
    }
    if JIT && !TT.isOSWindows() {
        return Large;
    }
    return Small;
}

fn AArch64TargetMachine::AArch64TargetMachine(self, T: *Target, TT: *Triple, CPU: str, FS: str, Options: *TargetOptions, RM: Model>, CM: Model>, OL: CodeGenOptLevel, JIT: bool, LittleEndian: bool) {
    self.initAsmInfo();
    if TT.isOSBinFormatMachO() {
        self.Options.TrapUnreachable = true;
        self.Options.NoTrapAfterNoreturn = true;
    }
    if self.getMCAsmInfo().usesWindowsCFI() {
        self.Options.TrapUnreachable = true;
    }
    if self.Options.TLSSize == 0 {
        self.Options.TLSSize = 24;
    }
    if (self.getCodeModel() == Small || self.getCodeModel() == Kernel) && self.Options.TLSSize > 32 {
        self.Options.TLSSize = 32;
    } else if self.getCodeModel() == Tiny && self.Options.TLSSize > 24 {
        self.Options.TLSSize = 24;
    }
    let mut TargetSupportsGISel: bool = TT.getArch() != aarch64_32 && TT.getEnvironment() != GNUILP32 && !(self.getCodeModel() == Large && TT.isOSBinFormatMachO());
    let mut GlobalISelFlag: bool = getCGPassBuilderOption().EnableGlobalISelOption == BOU_TRUE;
    if TargetSupportsGISel && EnableGlobalISelAtO.operator int() != -1 && (self.getOptLevel() as i32 <= EnableGlobalISelAtO.operator int() || (!GlobalISelFlag && !Options.EnableGlobalISel)) {
        self.setGlobalISel(true);
        self.setGlobalISelAbort(Disable);
    }
    setUseExtended(true);
    self.setMachineOutliner(true);
    self.setSupportsDefaultOutlining(true);
    self.setSupportsDebugEntryValues(true);
    if !self.getMCAsmInfo().usesWindowsCFI() {
        self.setCFIFixup(true);
    }
}

fn AArch64TargetMachine::getEnableGlobalISelAtO(self: *AArch64TargetMachine) -> u32 {
    return EnableGlobalISelAtO.operator int();
}

fn AArch64TargetMachine::~AArch64TargetMachine(self) {}

fn AArch64TargetMachine::getSubtargetImpl(self: *AArch64TargetMachine, F: *Function) -> *AArch64Subtarget {
    let mut FnAttrs: AttributeSet = F.getAttributes().getFnAttrs();
    if self.LastSubtarget && self.LastSubtargetAttrs == FnAttrs {
        return self.LastSubtarget;
    }
    let mut CPUAttr: Attribute = F.getFnAttribute("target-cpu");
    let mut TuneAttr: Attribute = F.getFnAttribute("tune-cpu");
    let mut FSAttr: Attribute = F.getFnAttribute("target-features");
    let mut CPU: str = if CPUAttr.isValid() { CPUAttr.getValueAsString() } else { self.TargetCPU };
    let mut TuneCPU: str = if TuneAttr.isValid() { TuneAttr.getValueAsString() } else { CPU };
    let mut FS: str = if FSAttr.isValid() { FSAttr.getValueAsString() } else { self.TargetFS };
    let mut HasMinSize: bool = F.hasMinSize();
    let mut IsStreaming: bool = ForceStreaming || F.hasFnAttribute("aarch64_pstate_sm_enabled") || F.hasFnAttribute("aarch64_pstate_sm_body");
    let mut IsStreamingCompatible: bool = ForceStreamingCompatible || F.hasFnAttribute("aarch64_pstate_sm_compatible");
    let mut MinSVEVectorSize: u32 = 0;
    let mut MaxSVEVectorSize: u32 = 0;
    if F.hasFnAttribute(VScaleRange) {
        let mut CR: ConstantRange = getVScaleRange(&mut F, 64);
        MinSVEVectorSize = CR.getUnsignedMin().getZExtValue() * 128;
        MaxSVEVectorSize = CR.getUnsignedMax().getZExtValue() * 128;
    } else {
        MinSVEVectorSize = SVEVectorBitsMinOpt.operator unsigned int();
        MaxSVEVectorSize = SVEVectorBitsMaxOpt.operator unsigned int();
    }
    assert!(MinSVEVectorSize % 128 == 0, "SVE requires vector length in multiples of 128!");
    assert!(MaxSVEVectorSize % 128 == 0, "SVE requires vector length in multiples of 128!");
    assert!((MaxSVEVectorSize >= MinSVEVectorSize || MaxSVEVectorSize == 0), "Minimum SVE vector size should not be larger than its maximum!");
    if MaxSVEVectorSize != 0 {
        MinSVEVectorSize = if MinSVEVectorSize < MaxSVEVectorSize { MinSVEVectorSize } else { MaxSVEVectorSize };
        MaxSVEVectorSize = if MinSVEVectorSize > MaxSVEVectorSize { MinSVEVectorSize } else { MaxSVEVectorSize };
    }
    let mut Key: str = "";
    operator(Key, "SVEMin");
    operator(Key, utostr(MinSVEVectorSize, false));
    operator(Key, "SVEMax");
    operator(Key, utostr(MaxSVEVectorSize, false));
    operator(Key, "IsStreaming=");
    operator(Key, utostr(IsStreaming, false));
    operator(Key, "IsStreamingCompatible=");
    operator(Key, utostr(IsStreamingCompatible, false));
    operator(Key, CPU);
    operator(Key, TuneCPU);
    operator(Key, FS);
    operator(Key, "HasMinSize=");
    operator(Key, utostr(HasMinSize, false));
    let mut I: *mut AArch64Subtarget> = self.SubtargetMap[Key.operator StringRef()];
    if !I {
        I = make_unique(self.TargetTriple, CPU, TuneCPU, FS, *self, self.isLittle, MinSVEVectorSize, MaxSVEVectorSize, IsStreaming, IsStreamingCompatible, HasMinSize, EnableSRLTSubregToRegMitigation);
    }
    if IsStreaming && !operator(I).hasSME() {
        reportFatalUsageError("streaming SVE functions require SME");
    }
    self.LastSubtargetAttrs = FnAttrs;
    self.LastSubtarget = I.get();
    return self.LastSubtarget;
}

fn scheduleFormTransposedTupleAdjacentToUsers(TII: *TargetInstrInfo, TSI: *TargetSubtargetInfo, FirstMI: *MachineInstr, SecondMI: *MachineInstr, Dep: *SDep) -> bool {
    if isNonDataDep(Dep) {
        return false;
    }
    return !FirstMI || FirstMI.getOpcode() == FORM_TRANSPOSED_REG_TUPLE_X2_PSEUDO || FirstMI.getOpcode() == FORM_TRANSPOSED_REG_TUPLE_X4_PSEUDO;
}

fn AArch64TargetMachine::createMachineScheduler(self: *AArch64TargetMachine, C: *mut MachineSchedContext) -> *mut ScheduleDAGInstrs {
    let mut ST: *AArch64Subtarget = C.MF.getSubtarget();
    let mut DAG: *mut ScheduleDAGMILive = createSchedLive(C);
    DAG.addMutation(createLoadClusterDAGMutation(DAG.TII, DAG.TRI, false));
    DAG.addMutation(createStoreClusterDAGMutation(DAG.TII, DAG.TRI, false));
    if ST.hasFusion() {
        DAG.addMutation(createAArch64MacroFusionDAGMutation());
    }
    if ST.hasSME() && ST.isStreaming() {
        DAG.addMutation(createMacroFusionDAGMutation(scheduleFormTransposedTupleAdjacentToUsers, false));
    }
    return DAG;
}

fn AArch64TargetMachine::createPostMachineScheduler(self: *AArch64TargetMachine, C: *mut MachineSchedContext) -> *mut ScheduleDAGInstrs {
    let mut ST: *AArch64Subtarget = C.MF.getSubtarget();
    let mut DAG: *mut ScheduleDAGMI = createSchedPostRA(C);
    if ST.hasFusion() {
        DAG.addMutation(createAArch64MacroFusionDAGMutation());
        return DAG;
    }
    return DAG;
}

fn AArch64TargetMachine::clearLinkerOptimizationHints(self: *AArch64TargetMachine, MIs: *SmallPtrSetImpl<MachineInstr *>) -> u64 {
    if MIs.is_empty() {
        return 0;
    }
    let mut MI: *mut MachineInstr = operator(MIs.begin());
    let mut FuncInfo: *mut AArch64FunctionInfo = MI.getMF().getInfo();
    return FuncInfo.clearLinkerOptimizationHints(MIs);
}

