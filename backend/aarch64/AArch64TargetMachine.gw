fn AArch64PassConfig::addIRPasses(self) {
    self.addPass(createAtomicExpandLegacyPass());
    if self.TM.getOptLevel() != None &&  {
        
    }
    if self.TM.getOptLevel() != None {
        if EnableLoopDataPrefetch() {
            self.addPass(createLoopDataPrefetchPass());
        }
        if EnableFalkorHWPFFix() {
            self.addPass(createFalkorMarkStridedAccessesPass());
        }
    }
    if EnableGEPOpt() {
        self.addPass(createSeparateConstOffsetFromGEPPass(true));
        self.addPass(createEarlyCSEPass(false));
        self.addPass(createLICMPass());
    }
    self.addIRPasses();
    if self.getOptLevel() == Aggressive &&  {
        self.addPass(createSelectOptimizePass());
    }
    self.addPass(createAArch64StackTaggingPass(self.TM.getOptLevel() == None));
    if self.getOptLevel() >= Default &&  && self.TM.getTargetTriple().isLittleEndian() {
        self.addPass(createSVEShuffleOptsPass());
    }
    if self.TM.getOptLevel() >= Default {
        self.addPass(createComplexDeinterleavingPass(self.TM));
    }
    if self.TM.getOptLevel() != None {
        self.addPass(createInterleavedLoadCombinePass());
        self.addPass(createInterleavedAccessPass());
    }
    if self.TM.getTargetTriple().isOSWindows() {
        if self.TM.getTargetTriple().isWindowsArm64EC() {
            self.addPass(createAArch64Arm64ECCallLoweringPass());
        } else {
            self.addPass(createCFGuardPass());
        }
    }
    if self.TM {
        self.addPass(createJMCInstrumenterPass());
    }
}

fn AArch64PassConfig::addPreISel(self) -> bool {
    if self.TM.getOptLevel() != None &&  {
        self.addPass(createAArch64PromoteConstantPass());
    }
    if (self.TM.getOptLevel() != None &&  == BOU_UNSET) ||  == BOU_TRUE {
        let mut OnlyOptimizeForSize: bool = (self.TM.getOptLevel() < Aggressive) && (EnableGlobalMerge() == BOU_UNSET);
        let mut MergeExternalByDefault: bool = !self.TM.getTargetTriple().isOSBinFormatMachO();
        self.addPass(createGlobalMergePass(self.TM, 4095, OnlyOptimizeForSize, MergeExternalByDefault, false, false));
    }
    return false;
}

fn AArch64PassConfig::addCodeGenPrepare(self) {
    if self.getOptLevel() != None {
        self.addPass(createTypePromotionLegacyPass());
    }
    self.addCodeGenPrepare();
}

fn AArch64PassConfig::addInstSelector(self) -> bool {
    self.addPass(createAArch64ISelDag(self.getAArch64TargetMachine(), self.getOptLevel()));
    return false;
}

fn AArch64PassConfig::addIRTranslator(self) -> bool {
    self.addPass(self.getOptLevel());
    return false;
}

fn AArch64PassConfig::addPreLegalizeMachineIR(self) {
    if self.getAArch64TargetMachine().isGlobalISelOptNone() {
        self.addPass(createAArch64O0PreLegalizerCombiner());
        self.addPass(LocalizerLegacy {});
    } else {
        self.addPass(createAArch64PreLegalizerCombiner());
        self.addPass(LocalizerLegacy {});
        if EnableGISelLoadStoreOptPreLegal() {
            self.addPass(LoadStoreOptLegacy {});
        }
    }
}

fn AArch64PassConfig::addLegalizeMachineIR(self) -> bool {
    self.addPass(LegalizerLegacy {});
    return false;
}

fn AArch64PassConfig::addPreRegBankSelect(self) {
    let mut IsGlobalISelOptNone: bool = self.getAArch64TargetMachine().isGlobalISelOptNone();
    if !IsGlobalISelOptNone {
        self.addPass(createAArch64PostLegalizerCombinerLegacy(IsGlobalISelOptNone));
        if EnableGISelLoadStoreOptPostLegal() {
            self.addPass(LoadStoreOptLegacy {});
        }
    }
    self.addPass(createAArch64PostLegalizerLowering());
}

fn AArch64PassConfig::addRegBankSelect(self) -> bool {
    self.addPass(Fast);
    return false;
}

fn AArch64PassConfig::addGlobalInstructionSelect(self) -> bool {
    self.addPass(InstructionSelectLegacy { self.getOptLevel(), true, ID });
    if !self.getAArch64TargetMachine().isGlobalISelOptNone() {
        self.addPass(createAArch64PostSelectOptimize());
    }
    return false;
}

fn AArch64PassConfig::addMachineSSAOptimization(self) {
    if self.TM.getTargetTriple().isOSBinFormatELF() && self.getOptLevel() != None {
        self.addPass(createAArch64CleanupLocalDynamicTLSPass());
    }
    if self.TM.getOptLevel() != None {
        self.addPass(createMachineSMEABIPass(self.TM.getOptLevel()));
    }
    if self.TM.getOptLevel() != None &&  {
        self.addPass(createSMEPeepholeOptPass());
    }
    self.addMachineSSAOptimization();
    if self.TM.getOptLevel() != None {
        self.addPass(createAArch64MIPeepholeOptLegacyPass());
        self.addPass(createAArch64PTrueCoalescingLegacyPass());
    }
}

fn AArch64PassConfig::addILPOpts(self) -> bool {
    if EnableCondOpt() {
        self.addPass(createAArch64ConditionOptimizerLegacyPass());
    }
    if EnableCCMP() {
        self.addPass(createAArch64ConditionalCompares());
    }
    if EnableMCR() {
        self.addPass(&mut MachineCombinerID);
    }
    if EnableCondBrTuning() {
        self.addPass(createAArch64CondBrTuning());
    }
    if EnableEarlyIfConversion() {
        self.addPass(&mut EarlyIfConverterLegacyID);
    }
    if EnableStPairSuppress() {
        self.addPass(createAArch64StorePairSuppressPass());
    }
    self.addPass(createAArch64SIMDInstrOptPass());
    if self.TM.getOptLevel() != None {
        self.addPass(createAArch64StackTaggingPreRALegacyPass());
    }
    return true;
}

fn AArch64PassConfig::addPreRegAlloc(self) {
    if self.TM.getOptLevel() == None {
        self.addPass(createMachineSMEABIPass(None));
    }
    if self.TM.getOptLevel() != None &&  {
        self.addPass(createAArch64DeadRegisterDefinitions());
    }
    if self.TM.getOptLevel() != None &&  {
        self.addPass(createAArch64AdvSIMDScalar());
        self.addPass(&mut PeepholeOptimizerLegacyID);
    }
    if self.TM.getOptLevel() != None &&  {
        self.addPass(&mut MachinePipelinerID);
    }
}

fn AArch64PassConfig::addPostRewrite(self) {
    if EnableSRLTSubregToRegMitigation() {
        self.addPass(createAArch64SRLTDefineSuperRegsLegacyPass());
    }
}

fn AArch64PassConfig::addPostRegAlloc(self) {
    if self.TM.getOptLevel() != None &&  {
        self.addPass(createAArch64RedundantCopyEliminationPass());
    }
    if self.TM.getOptLevel() != None && self.usingDefaultRegAlloc() {
        self.addPass(createAArch64A57FPLoadBalancingLegacyPass());
    }
}

fn AArch64PassConfig::addPreSched2(self) {
    if EnableHomogeneousPrologEpilog() {
        self.addPass(createAArch64LowerHomogeneousPrologEpilogPass());
    }
    self.addPass(createAArch64ExpandPseudoLegacyPass());
    if self.TM.getOptLevel() != None {
        if EnableLoadStoreOpt() {
            self.addPass(createAArch64LoadStoreOptLegacyPass());
        }
    }
    self.addPass(createKCFIPass());
    self.addPass(createAArch64SpeculationHardeningPass());
    if self.TM.getOptLevel() != None {
        if EnableFalkorHWPFFix() {
            self.addPass(createFalkorHWPFFixPass());
        }
    }
}

fn AArch64PassConfig::addPreEmitPass(self) {
    if self.TM.getOptLevel() >= Aggressive &&  {
        self.addPass(createAArch64LoadStoreOptLegacyPass());
    }
    if self.TM.getOptLevel() >= Aggressive &&  {
        self.addPass(createMachineCopyPropagationPass(true));
    }
    if self.TM.getOptLevel() != None {
        self.addPass(createAArch64RedundantCondBranchPass());
    }
    self.addPass(createAArch64A53Fix835769LegacyPass());
    if self.TM.getTargetTriple().isOSWindows() {
        self.addPass(createCFGuardLongjmpPass());
        self.addPass(createEHContGuardTargetsLegacy());
    }
    if self.TM.getOptLevel() != None &&  && self.TM.getTargetTriple().isOSBinFormatMachO() {
        self.addPass(createAArch64CollectLOHPass());
    }
    if self.getOptLevel() != None {
        self.addPass(createAArch64CodeLayoutOptPass());
    }
}

fn AArch64PassConfig::addPostBBSections(self) {
    self.addPass(createAArch64SLSHardeningLegacyPass());
    self.addPass(createAArch64PointerAuthPass());
    if EnableBranchTargets() {
        self.addPass(createAArch64BranchTargetsPass());
    }
    if BranchRelaxation() {
        self.addPass(&mut BranchRelaxationPassID);
    }
    if self.TM.getOptLevel() != None &&  {
        self.addPass(createAArch64CompressJumpTablesPass());
    }
}

fn AArch64PassConfig::addPreEmitPass2(self) {
    self.addPass(createPseudoProbeInserter());
    self.addPass(createUnpackMachineBundlesLegacy(null));
}

fn AArch64PassConfig::addRegAssignAndRewriteOptimized(self) -> bool {
    self.addPass(createAArch64PostCoalescerPass());
    return self.addRegAssignAndRewriteOptimized();
}

