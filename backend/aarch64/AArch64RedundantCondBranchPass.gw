struct AArch64RedundantCondBranchLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64RedundantCondBranchLegacy::getPassName(self: *AArch64RedundantCondBranchLegacy) -> str {
    return "AArch64 Redundant Conditional Branch Elimination";
}

fn AArch64RedundantCondBranchLegacy::getRequiredProperties(self: *AArch64RedundantCondBranchLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {}.setNoVRegs();
}

fn AArch64RedundantCondBranchLegacy::getPassKind(self: *AArch64RedundantCondBranchLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64RedundantCondBranchLegacy::getPassID(self: *AArch64RedundantCondBranchLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64RedundantCondBranchLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64RedundantCondBranchLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64RedundantCondBranchLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64RedundantCondBranchLegacy::getResolver(self: *AArch64RedundantCondBranchLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64RedundantCondBranchLegacy::getSetProperties(self: *AArch64RedundantCondBranchLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64RedundantCondBranchLegacy::getClearedProperties(self: *AArch64RedundantCondBranchLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn runAArch64RedundantCondBranch(MF: *mut MachineFunction) -> bool {
    let mut TII: *TargetInstrInfo = *MF.getSubtarget().getInstrInfo();
    let mut Changed: bool = false;
    return Changed;
}

fn AArch64RedundantCondBranchLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction {
        return false;
    }
    return runAArch64RedundantCondBranch(MF);
}

fn AArch64RedundantCondBranchPass::run(self, MF: *mut MachineFunction, arg: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    if runAArch64RedundantCondBranch(MF) {
        return getMachineFunctionPassPreservedAnalyses();
    }
    return all();
}

fn createAArch64RedundantCondBranchPass() -> *mut FunctionPass {
    return AArch64RedundantCondBranchLegacy {};
}
