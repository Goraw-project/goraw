static mut NumDeadDefsReplaced: Statistic = Statistic { "aarch64-dead-defs", "NumDeadDefsReplaced", "Number of dead definitions replaced" };

struct AArch64DeadRegisterDefinitionsImpl {
    MRI: *MachineRegisterInfo,
    TII: *TargetInstrInfo,
    Changed: bool,
}

struct AArch64DeadRegisterDefinitionsLegacy {
    Resolver: *mut AnalysisResolver,
    PassID: *void,
    Kind: PassKind,
    RequiredProperties: MachineFunctionProperties,
    SetProperties: MachineFunctionProperties,
    ClearedProperties: MachineFunctionProperties,
}

fn AArch64DeadRegisterDefinitionsLegacy::getPassName(self: *AArch64DeadRegisterDefinitionsLegacy) -> str {
    return "AArch64 Dead register definitions";
}

fn AArch64DeadRegisterDefinitionsLegacy::getAnalysisUsage(self: *AArch64DeadRegisterDefinitionsLegacy, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    self.getAnalysisUsage(AU);
}

fn AArch64DeadRegisterDefinitionsLegacy::getPassKind(self: *AArch64DeadRegisterDefinitionsLegacy) -> PassKind {
    return self.Kind;
}

fn AArch64DeadRegisterDefinitionsLegacy::getPassID(self: *AArch64DeadRegisterDefinitionsLegacy) -> AnalysisID {
    return self.PassID;
}

fn AArch64DeadRegisterDefinitionsLegacy::doInitialization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64DeadRegisterDefinitionsLegacy::doFinalization(self, arg: *mut Module) -> bool {
    return false;
}

fn AArch64DeadRegisterDefinitionsLegacy::assignPassManager(self, arg: *mut PMStack, arg: PassManagerType) {}

fn AArch64DeadRegisterDefinitionsLegacy::getResolver(self: *AArch64DeadRegisterDefinitionsLegacy) -> *mut AnalysisResolver {
    return self.Resolver;
}

fn AArch64DeadRegisterDefinitionsLegacy::getRequiredProperties(self: *AArch64DeadRegisterDefinitionsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64DeadRegisterDefinitionsLegacy::getSetProperties(self: *AArch64DeadRegisterDefinitionsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

fn AArch64DeadRegisterDefinitionsLegacy::getClearedProperties(self: *AArch64DeadRegisterDefinitionsLegacy) -> MachineFunctionProperties {
    return MachineFunctionProperties {};
}

static mut ID: i8 = 0;

fn usesFrameIndex(MI: *MachineInstr) -> bool {
    for MO in MI.uses() {
        if MO.isFI() {
            return true;
        }
    }
    return false;
}

fn atomicReadDroppedOnZero(Opcode: u32) -> bool {
    match Opcode {
        LDADDB => {
            LDADDH;
        },
    }
    return false;
}

fn AArch64DeadRegisterDefinitionsImpl::processMachineBasicBlock(self, MBB: *mut MachineBasicBlock) {
    for MI in MBB {
        if usesFrameIndex(MI) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
                    dbgs() << "    Ignoring, operand is frame index\n";
                }
            }
                if !(false) { break; }
            }
            continue;
        }
        if MI.definesRegister(XZR, null) || MI.definesRegister(WZR, null) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
                    dbgs() << "    Ignoring, XZR or WZR already used by the instruction\n";
                }
            }
                if !(false) { break; }
            }
            continue;
        }
        if atomicBarrierDroppedOnZero(MI.getOpcode()) || atomicReadDroppedOnZero(MI.getOpcode()) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
                    dbgs() << "    Ignoring, semantics change with xzr/wzr.\n";
                }
            }
                if !(false) { break; }
            }
            continue;
        }
        let mut Desc: *MCInstrDesc = MI.getDesc();
        for let mut I: i32 = 0;
let mut E: i32 = Desc.getNumDefs(); I != E; I += 1 {
            let mut MO: *mut MachineOperand = MI.getOperand(I);
            if !MO.isReg() || !MO.isDef() {
                continue;
            }
            let mut Reg: Register = MO.getReg();
            if !Reg.isVirtual() || (!MO.isDead() && !self.MRI.use_nodbg_empty(Reg)) {
                continue;
            }
            assert!(!MO.isImplicit(), "Unexpected implicit def!");
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
                    dbgs() << "  Dead def operand #" << I << " in:\n    ";
                    MI.print(dbgs(), true, false, false, true, null);
                }
            }
                if !(false) { break; }
            }
            if MI.isRegTiedToUseOperand(I, null) {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
                        dbgs() << "    Ignoring, def is tied operand.\n";
                    }
                }
                    if !(false) { break; }
                }
                continue;
            }
            let mut RC: *TargetRegisterClass = self.TII.getRegClass(Desc, I);
            let mut NewReg: u32 = 0;
            if RC == null {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
                        dbgs() << "    Ignoring, register is not a GPR.\n";
                    }
                }
                    if !(false) { break; }
                }
                continue;
            } else if RC.contains(WZR) {
                NewReg = WZR;
            } else if RC.contains(XZR) {
                NewReg = XZR;
            } else {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
                        dbgs() << "    Ignoring, register is not a GPR.\n";
                    }
                }
                    if !(false) { break; }
                }
                continue;
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
                    dbgs() << "    Replacing with zero register. New:\n      ";
                }
            }
                if !(false) { break; }
            }
            MO.setReg(NewReg);
            MO.setIsDead(true);
            while true {
                {
                if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
                    MI.print(dbgs(), true, false, false, true, null);
                }
            }
                if !(false) { break; }
            }
            operator(NumDeadDefsReplaced);
            self.Changed = true;
            break;
        }
    }
}

fn AArch64DeadRegisterDefinitionsImpl::run(self, MF: *mut MachineFunction) -> bool {
    self.TII = MF.getSubtarget().getInstrInfo();
    self.MRI = &mut MF.getRegInfo();
    while true {
        {
        if DebugFlag && isCurrentDebugType("aarch64-dead-defs", 1) {
            dbgs() << "***** AArch64DeadRegisterDefinitions *****\n";
        }
    }
        if !(false) { break; }
    }
    self.Changed = false;
    for MBB in MF {
        self.processMachineBasicBlock(MBB);
    }
    return self.Changed;
}

fn AArch64DeadRegisterDefinitionsLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if self.skipFunction(MF.getFunction()) {
        return false;
    }
    return AArch64DeadRegisterDefinitionsImpl {}.run(MF);
}

fn AArch64DeadRegisterDefinitionsPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    let mut Changed: bool = AArch64DeadRegisterDefinitionsImpl {}.run(MF);
    if !Changed {
        return all();
    }
    let mut PA: PreservedAnalyses = getMachineFunctionPassPreservedAnalyses();
    PA.preserveSet();
    return PA;
}

fn createAArch64DeadRegisterDefinitions() -> *mut FunctionPass {
    return AArch64DeadRegisterDefinitionsLegacy {};
}
