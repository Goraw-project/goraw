fn LangOptions::isNoBuiltinFunc(self: *LangOptions, FuncName: str) -> bool {
    for let mut i: u32 = 0;
let mut e: u32 = self.NoBuiltinFuncs.len; i != e; i += 1 {
        if FuncName == self.NoBuiltinFuncs[i] {
            return true;
        }
    }
    return false;
}

fn LangOptions::getOpenCLVersionTuple(self: *LangOptions) -> VersionTuple {
    let mut Ver: i32 = if self.OpenCLCPlusPlus { self.OpenCLCPlusPlusVersion } else { self.OpenCLVersion };
    if self.OpenCLCPlusPlus && Ver != 100 {
        return Ver / 100;
    }
    return VersionTuple { Ver / 100, (Ver % 100) / 10 };
}

fn LangOptions::getOpenCLCompatibleVersion(self: *LangOptions) -> u32 {
    if !self.OpenCLCPlusPlus {
        return self.OpenCLVersion;
    }
    if self.OpenCLCPlusPlusVersion == 100 {
        return 200;
    }
    if self.OpenCLCPlusPlusVersion == 202100 {
        return 300;
    }
    llvm_unreachable_internal("Unknown OpenCL version", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\LangOptions.cpp", 74);
}

fn LangOptions::remapPathPrefix(self: *LangOptions, Path: *mut SmallVectorImpl<char>) {}

fn LangOptions::getOpenCLVersionString(self: *LangOptions) -> str {
    let mut Result: str = "";
    {
        let mut Out: raw_string_ostream = Result;
        Out << (if self.OpenCLCPlusPlus { "C++ for OpenCL" } else { "OpenCL C" }) << " version " << self.getOpenCLVersionTuple().getAsString();
    }
    return Result;
}

fn LangOptions::setLangDefaults(self, Opts: *mut LangOptions, Lang: Language, T: *Triple, Includes: *mut i32, LangStd: Kind) {
    if Lang == Asm {
        Opts.AsmPreprocessor = 1;
    } else if Lang == ObjC || Lang == ObjCXX {
        Opts.ObjC = 1;
    }
    if LangStd == lang_unspecified {
        LangStd = getDefaultLanguageStandard(Lang, T);
    }
    let mut Std: *LangStandard = getLangStandardForKind(LangStd);
    Opts.LangStd = LangStd;
    Opts.LineComment = Std.hasLineComments();
    Opts.C99 = Std.isC99();
    Opts.C11 = Std.isC11();
    Opts.C17 = Std.isC17();
    Opts.C23 = Std.isC23();
    Opts.C2y = Std.isC2y();
    Opts.CPlusPlus = Std.isCPlusPlus();
    Opts.CPlusPlus11 = Std.isCPlusPlus11();
    Opts.CPlusPlus14 = Std.isCPlusPlus14();
    Opts.CPlusPlus17 = Std.isCPlusPlus17();
    Opts.CPlusPlus20 = Std.isCPlusPlus20();
    Opts.CPlusPlus23 = Std.isCPlusPlus23();
    Opts.CPlusPlus26 = Std.isCPlusPlus26();
    Opts.CPlusPlus29 = Std.isCPlusPlus29();
    Opts.GNUMode = Std.isGNUMode();
    Opts.GNUCVersion = 0;
    Opts.HexFloats = Std.hasHexFloats();
    Opts.WChar = Std.isCPlusPlus();
    Opts.Digraphs = Std.hasDigraphs();
    Opts.RawStringLiterals = Std.hasRawStringLiterals();
    Opts.AllowLiteralDigitSeparator = Std.allowLiteralDigitSeparator();
    Opts.NamedLoops = Std.isC2y();
    Opts.HLSL = Lang == HLSL;
    if Opts.HLSL {
        if Opts.IncludeDefaultHeader {
            Includes()("hlsl.h");
        }
        Opts.MaxMatrixDimension = 4;
    }
    Opts.OpenCL = Std.isOpenCL();
    match LangStd {
        lang_opencl10 => {
            Opts.OpenCLVersion = 100;
        },
        lang_opencl11 => {
            Opts.OpenCLVersion = 110;
        },
        lang_opencl12 => {
            Opts.OpenCLVersion = 120;
        },
        lang_opencl20 => {
            Opts.OpenCLVersion = 200;
        },
        lang_opencl30 => {
            Opts.OpenCLVersion = 300;
        },
        lang_opencl31 => {
            Opts.OpenCLVersion = 310;
        },
        lang_openclcpp10 => {
            Opts.OpenCLCPlusPlusVersion = 100;
        },
        lang_openclcpp2021 => {
            Opts.OpenCLCPlusPlusVersion = 202100;
        },
        lang_hlsl2015 => {
            Opts.HLSLVersion = HLSL_2015 as u32;
        },
        lang_hlsl2016 => {
            Opts.HLSLVersion = HLSL_2016 as u32;
        },
        lang_hlsl2017 => {
            Opts.HLSLVersion = HLSL_2017 as u32;
        },
        lang_hlsl2018 => {
            Opts.HLSLVersion = HLSL_2018 as u32;
        },
        lang_hlsl2021 => {
            Opts.HLSLVersion = HLSL_2021 as u32;
        },
        lang_hlsl202x => {
            Opts.HLSLVersion = HLSL_202x as u32;
        },
        lang_hlsl202y => {
            Opts.HLSLVersion = HLSL_202y as u32;
        },
        _ => {
            break;
        },
    }
    if Opts.OpenCL {
        Opts.AltiVec = 0;
        Opts.ZVector = 0;
        Opts.setDefaultFPContractMode(FPM_On);
        Opts.OpenCLCPlusPlus = Opts.CPlusPlus;
        Opts.OpenCLPipes = Opts.getOpenCLCompatibleVersion() == 200;
        Opts.OpenCLGenericAddressSpace = Opts.getOpenCLCompatibleVersion() == 200;
        if Opts.IncludeDefaultHeader {
            if Opts.DeclareOpenCLBuiltins {
                Includes()("opencl-c-base.h");
            } else {
                Includes()("opencl-c.h");
            }
        }
    }
    Opts.HIP = Lang == HIP;
    Opts.CUDA = Lang == CUDA || Opts.HIP;
    if Opts.HIP {
        Opts.setDefaultFPContractMode(FPM_FastHonorPragmas);
    } else if Opts.CUDA {
        if T.isSPIRV() {
            Opts.OpenCLVersion = 200;
        }
        Opts.setDefaultFPContractMode(FPM_Fast);
    }
    Opts.Bool = Opts.OpenCL || Opts.CPlusPlus || Opts.C23;
    Opts.Half = Opts.OpenCL || Opts.HLSL;
    Opts.PreserveVec3Type = Opts.HLSL;
}

fn FPOptions::defaultWithoutTrailingStorage(self, LO: *LangOptions) -> FPOptions {
    let mut result: FPOptions = LO;
    return result;
}

fn FPOptions::getChangesSlow(self: *FPOptions, Base: *FPOptions) -> FPOptionsOverride {
    let mut OverrideMask: storage_type = 0;
    if self.getFPContractMode() != Base.getFPContractMode() {
        OverrideMask |= FPContractModeMask;
    }
    if self.getRoundingMath() != Base.getRoundingMath() {
        OverrideMask |= RoundingMathMask;
    }
    if self.getConstRoundingMode() != Base.getConstRoundingMode() {
        OverrideMask |= ConstRoundingModeMask;
    }
    if self.getSpecifiedExceptionMode() != Base.getSpecifiedExceptionMode() {
        OverrideMask |= SpecifiedExceptionModeMask;
    }
    if self.getAllowFEnvAccess() != Base.getAllowFEnvAccess() {
        OverrideMask |= AllowFEnvAccessMask;
    }
    if self.getAllowFPReassociate() != Base.getAllowFPReassociate() {
        OverrideMask |= AllowFPReassociateMask;
    }
    if self.getNoHonorNaNs() != Base.getNoHonorNaNs() {
        OverrideMask |= NoHonorNaNsMask;
    }
    if self.getNoHonorInfs() != Base.getNoHonorInfs() {
        OverrideMask |= NoHonorInfsMask;
    }
    if self.getNoSignedZero() != Base.getNoSignedZero() {
        OverrideMask |= NoSignedZeroMask;
    }
    if self.getAllowReciprocal() != Base.getAllowReciprocal() {
        OverrideMask |= AllowReciprocalMask;
    }
    if self.getAllowApproxFunc() != Base.getAllowApproxFunc() {
        OverrideMask |= AllowApproxFuncMask;
    }
    if self.getFPEvalMethod() != Base.getFPEvalMethod() {
        OverrideMask |= FPEvalMethodMask;
    }
    if self.getFloat16ExcessPrecision() != Base.getFloat16ExcessPrecision() {
        OverrideMask |= Float16ExcessPrecisionMask;
    }
    if self.getBFloat16ExcessPrecision() != Base.getBFloat16ExcessPrecision() {
        OverrideMask |= BFloat16ExcessPrecisionMask;
    }
    if self.getMathErrno() != Base.getMathErrno() {
        OverrideMask |= MathErrnoMask;
    }
    if self.getComplexRange() != Base.getComplexRange() {
        OverrideMask |= ComplexRangeMask;
    }
    return FPOptionsOverride { Options: *self, OverrideMask: OverrideMask };
}

fn FPOptions::dump(self) {
    errs() << "\n FPContractMode " << self.getFPContractMode();
    errs() << "\n RoundingMath " << self.getRoundingMath();
    errs() << "\n ConstRoundingMode " << self.getConstRoundingMode();
    errs() << "\n SpecifiedExceptionMode " << self.getSpecifiedExceptionMode();
    errs() << "\n AllowFEnvAccess " << self.getAllowFEnvAccess();
    errs() << "\n AllowFPReassociate " << self.getAllowFPReassociate();
    errs() << "\n NoHonorNaNs " << self.getNoHonorNaNs();
    errs() << "\n NoHonorInfs " << self.getNoHonorInfs();
    errs() << "\n NoSignedZero " << self.getNoSignedZero();
    errs() << "\n AllowReciprocal " << self.getAllowReciprocal();
    errs() << "\n AllowApproxFunc " << self.getAllowApproxFunc();
    errs() << "\n FPEvalMethod " << self.getFPEvalMethod();
    errs() << "\n Float16ExcessPrecision " << self.getFloat16ExcessPrecision();
    errs() << "\n BFloat16ExcessPrecision " << self.getBFloat16ExcessPrecision();
    errs() << "\n MathErrno " << self.getMathErrno();
    errs() << "\n ComplexRange " << self.getComplexRange();
    errs() << "\n";
}

fn FPOptionsOverride::dump(self) {
    if self.hasFPContractModeOverride() {
        errs() << "\n FPContractMode Override is " << self.getFPContractModeOverride();
    }
    if self.hasRoundingMathOverride() {
        errs() << "\n RoundingMath Override is " << self.getRoundingMathOverride();
    }
    if self.hasConstRoundingModeOverride() {
        errs() << "\n ConstRoundingMode Override is " << self.getConstRoundingModeOverride();
    }
    if self.hasSpecifiedExceptionModeOverride() {
        errs() << "\n SpecifiedExceptionMode Override is " << self.getSpecifiedExceptionModeOverride();
    }
    if self.hasAllowFEnvAccessOverride() {
        errs() << "\n AllowFEnvAccess Override is " << self.getAllowFEnvAccessOverride();
    }
    if self.hasAllowFPReassociateOverride() {
        errs() << "\n AllowFPReassociate Override is " << self.getAllowFPReassociateOverride();
    }
    if self.hasNoHonorNaNsOverride() {
        errs() << "\n NoHonorNaNs Override is " << self.getNoHonorNaNsOverride();
    }
    if self.hasNoHonorInfsOverride() {
        errs() << "\n NoHonorInfs Override is " << self.getNoHonorInfsOverride();
    }
    if self.hasNoSignedZeroOverride() {
        errs() << "\n NoSignedZero Override is " << self.getNoSignedZeroOverride();
    }
    if self.hasAllowReciprocalOverride() {
        errs() << "\n AllowReciprocal Override is " << self.getAllowReciprocalOverride();
    }
    if self.hasAllowApproxFuncOverride() {
        errs() << "\n AllowApproxFunc Override is " << self.getAllowApproxFuncOverride();
    }
    if self.hasFPEvalMethodOverride() {
        errs() << "\n FPEvalMethod Override is " << self.getFPEvalMethodOverride();
    }
    if self.hasFloat16ExcessPrecisionOverride() {
        errs() << "\n Float16ExcessPrecision Override is " << self.getFloat16ExcessPrecisionOverride();
    }
    if self.hasBFloat16ExcessPrecisionOverride() {
        errs() << "\n BFloat16ExcessPrecision Override is " << self.getBFloat16ExcessPrecisionOverride();
    }
    if self.hasMathErrnoOverride() {
        errs() << "\n MathErrno Override is " << self.getMathErrnoOverride();
    }
    if self.hasComplexRangeOverride() {
        errs() << "\n ComplexRange Override is " << self.getComplexRangeOverride();
    }
    errs() << "\n";
}

fn LangOptions::getCPlusPlusLangStd(self: *LangOptions) -> optional<uint32_t> {
    if !self.CPlusPlus {
        return nullopt;
    }
    let mut Std: Kind = zeroed();
    if self.CPlusPlus29 {
        Std = lang_cxx29;
    } else if self.CPlusPlus26 {
        Std = lang_cxx26;
    } else if self.CPlusPlus23 {
        Std = lang_cxx23;
    } else if self.CPlusPlus20 {
        Std = lang_cxx20;
    } else if self.CPlusPlus17 {
        Std = lang_cxx17;
    } else if self.CPlusPlus14 {
        Std = lang_cxx14;
    } else if self.CPlusPlus11 {
        Std = lang_cxx11;
    } else {
        Std = lang_cxx98;
    }
    return getLangStandardForKind(Std).getVersion();
}

fn LangOptions::getCLangStd(self: *LangOptions) -> optional<uint32_t> {
    let mut Std: Kind = zeroed();
    if self.C2y {
        Std = lang_c2y;
    } else if self.C23 {
        Std = lang_c23;
    } else if self.C17 {
        Std = lang_c17;
    } else if self.C11 {
        Std = lang_c11;
    } else if self.C99 {
        Std = lang_c99;
    } else if !self.GNUMode && self.Digraphs {
        Std = lang_c94;
    } else {
        return nullopt;
    }
    return getLangStandardForKind(Std).getVersion();
}
