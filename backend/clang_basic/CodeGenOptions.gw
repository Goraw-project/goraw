fn CodeGenOptions::remapDebugPathPrefix(self: *CodeGenOptions, Path: str) -> str {
    let mut P: str = Path;
    for x in reverse(self.DebugPrefixMap) {
        if replace_path_prefix(P, From, To, native) {
            break;
        }
    }
    return P;
}
