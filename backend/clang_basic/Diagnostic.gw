    if ID.isValid() {
        let mut Decomp: FileIDAndOffset = zeroed();
        F() = self.getFile(SrcMgr);
        F() = ;
        F()(void { (), 0 });
    } else {
        F()(void { self.FirstDiagState, 0 });
    }
    return operator&();
}

