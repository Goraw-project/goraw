fn op_<<(DB: *StreamingDiagnostic, nullability: DiagNullabilityKind) -> *StreamingDiagnostic {
    DB.AddString(("'" + getNullabilitySpelling(nullability.first, nullability.second) + "'"));
    return DB;
}

fn op_<<(DB: *StreamingDiagnostic, E: *mut *mut Error) -> *StreamingDiagnostic {
    DB.AddString(toString(move(E)));
    return DB;
}

fn DummyArgToStringFn(AK: ArgumentKind, QT: i64, Modifier: str, Argument: str, PrevArgs: ArgumentValue>, Output: *mut SmallVectorImpl<char>, Cookie: *mut void, QualTypeVals: ArrayRef<intptr_t>) {
    let mut Str: str = "<can't format argument>";
    Output.append(Str.begin(), Str.end());
}

fn DiagnosticsEngine::DiagnosticsEngine(self, diags: IntrusiveRefCntPtr<DiagnosticIDs>, DiagOpts: *mut DiagnosticOptions, client: *mut DiagnosticConsumer, ShouldOwnClient: bool) {
    self.setClient(client, ShouldOwnClient);
    self.ArgToStringFn = DummyArgToStringFn;
    self.Reset(false);
}

fn DiagnosticsEngine::~DiagnosticsEngine(self) {
    self.setClient(null, true);
}

fn DiagnosticsEngine::dump(self: *DiagnosticsEngine) {
    self.DiagStatesByLoc.dump(*self.SourceMgr, "");
}

fn DiagnosticsEngine::dump(self: *DiagnosticsEngine, DiagName: str) {
    self.DiagStatesByLoc.dump(*self.SourceMgr, DiagName);
}

fn DiagnosticsEngine::setClient(self, client: *mut DiagnosticConsumer, ShouldOwnClient: bool) {
    self.Owner.reset(if ShouldOwnClient { client } else { null });
    self.Client = client;
}

fn DiagnosticsEngine::pushMappings(self, Loc: SourceLocation) {
    self.DiagStateOnPushStack.push(self.GetCurDiagState());
}

fn DiagnosticsEngine::popMappings(self, Loc: SourceLocation) -> bool {
    if self.DiagStateOnPushStack.is_empty() {
        return false;
    }
    if self.DiagStateOnPushStack.back() != self.GetCurDiagState() {
        self.PushDiagStatePoint(self.DiagStateOnPushStack.back(), Loc);
    }
    self.DiagStateOnPushStack.pop();
    return true;
}

fn DiagnosticsEngine::ResetPragmas(self) {
    self.DiagStatesByLoc.clear(true);
}

fn DiagnosticsEngine::Reset(self, soft: bool) {
    self.ErrorOccurred = false;
    self.UncompilableErrorOccurred = false;
    self.FatalErrorOccurred = false;
    self.UnrecoverableErrorOccurred = false;
    self.NumWarnings = 0;
    self.NumErrors = 0;
    self.TrapNumErrorsOccurred = 0;
    self.TrapNumUnrecoverableErrorsOccurred = 0;
    self.LastDiagLevel = Ignored;
    if !soft {
        self.DiagStates.clear();
        self.DiagStatesByLoc.clear(false);
        self.DiagStateOnPushStack.clear();
        self.DiagStates.push(operator(self.Diags));
        self.DiagStatesByLoc.appendFirst(&mut self.DiagStates.back());
    }
}

fn DiagState@DiagnosticsEngine@clang::getOrAddMapping(self, Diag: kind) -> *mut DiagnosticMapping {
    let mut Result: pair<iterator, bool> = self.DiagMap.try_emplace(Diag);
    if Result.second {
        operator(Result.first).second = self.DiagIDs.getDefaultMapping(Diag);
        if IsCustomDiag(Diag) {
            self.DiagIDs.initCustomDiagMapping(operator(Result.first).second, Diag);
        }
    }
    return operator(Result.first).second;
}

fn DiagStateMap@DiagnosticsEngine@clang::appendFirst(self, State: *mut DiagState) {
    assert!(self.Files.is_empty(), "not first");
    self.FirstDiagState = self.CurDiagState = State;
    self.CurDiagStateLoc = SourceLocation {};
}

fn DiagStateMap@DiagnosticsEngine@clang::append(self, SrcMgr: *mut SourceManager, Loc: SourceLocation, State: *mut DiagState) {
    self.CurDiagState = State;
    self.CurDiagStateLoc = Loc;
    let mut Decomp: FileIDAndOffset = SrcMgr.getDecomposedLoc(Loc);
    let mut Offset: u32 = Decomp.second;
    for let mut F: *mut File = self.getFile(SrcMgr, Decomp.first); F; Offset = F.ParentOffset , F = F.Parent {
        F.HasLocalTransitions = true;
        let mut Last: *mut DiagStatePoint = F.StateTransitions.back();
        assert!(Last.Offset <= Offset, "state transitions added out of order");
        if Last.Offset == Offset {
            if Last.State == State {
                break;
            }
            Last.State = State;
            continue;
        }
        F.StateTransitions.push(ValueParamT { State, Offset });
    }
}

fn DiagStateMap@DiagnosticsEngine@clang::lookup(self: *DiagStateMap@DiagnosticsEngine@clang, SrcMgr: *mut SourceManager, Loc: SourceLocation) -> *mut DiagState {
    if self.Files.is_empty() {
        return self.FirstDiagState;
    }
    let mut Decomp: FileIDAndOffset = SrcMgr.getDecomposedLoc(Loc);
    let mut F: *File = self.getFile(SrcMgr, Decomp.first);
    return F.lookup(Decomp.second);
}

fn File@DiagStateMap@DiagnosticsEngine@clang::lookup(self: *File@DiagStateMap@DiagnosticsEngine@clang, Offset: u32) -> *mut DiagState {
    let mut OnePastIt: *DiagStatePoint = partition_point(self.StateTransitions, Closure_1 { Offset: Offset });
    assert!(OnePastIt != self.StateTransitions.begin(), "missing initial state");
    return OnePastIt[-1].State;
}

fn DiagStateMap@DiagnosticsEngine@clang::getFile(self: *DiagStateMap@DiagnosticsEngine@clang, SrcMgr: *mut SourceManager, ID: FileID) -> *mut File {
    let mut Range: pair<iterator, iterator> = self.Files.equal_range(ID);
    if !Range.first == Range.second {
        return &mut operator(Range.first).second;
    }
    let mut F: *mut File = operator(self.Files.insert(Range.first, make_pair(ID, File {}))).second;
    if ID.isValid() {
        let mut Decomp: FileIDAndOffset = SrcMgr.getDecomposedIncludedLoc(ID);
        F.Parent = self.getFile(SrcMgr, Decomp.first);
        F.ParentOffset = Decomp.second;
        F.StateTransitions.push(ValueParamT { F.Parent.lookup(Decomp.second), 0 });
    } else {
        F.StateTransitions.push(ValueParamT { self.FirstDiagState, 0 });
    }
    return &mut F;
}

fn DiagStateMap@DiagnosticsEngine@clang::dump(self: *DiagStateMap@DiagnosticsEngine@clang, SrcMgr: *mut SourceManager, DiagName: str) {
    errs() << "diagnostic state at ";
    self.CurDiagStateLoc.print(errs(), SrcMgr);
    errs() << ": " << self.CurDiagState << "\n";
    for F in self.Files {
        let mut ID: FileID = F.first;
        let mut File: *mut File = F.second;
        let mut PrintedOuterHeading: bool = false;
        let mut PrintOuterHeading: Closure_2 = Closure_2 { PrintedOuterHeading: &mut PrintedOuterHeading, File: &mut File, ID: &mut ID, SrcMgr: &mut SrcMgr, F: &mut F };
        if DiagName.is_empty() {
            PrintOuterHeading.call();
        }
        for Transition in File.StateTransitions {
            let mut PrintedInnerHeading: bool = false;
            let mut PrintInnerHeading: Closure_3 = Closure_3 { PrintedInnerHeading: &mut PrintedInnerHeading, PrintOuterHeading: &mut PrintOuterHeading, SrcMgr: &mut SrcMgr, ID: &mut ID, Transition: &mut Transition };
            if DiagName.is_empty() {
                PrintInnerHeading.call();
            }
            for Mapping in *Transition.State {
                let mut Option: str = operator(SrcMgr.getDiagnostics().Diags).getWarningOptionForDiag(Mapping.first);
                if !DiagName.is_empty() && DiagName != Option {
                    continue;
                }
                PrintInnerHeading.call();
                errs() << "    ";
                if Option.is_empty() {
                    errs() << "<unknown " << Mapping.first << ">";
                } else {
                    errs() << Option;
                }
                errs() << ": ";
                match Mapping.second.getSeverity() {
                    Ignored => {
                        errs() << "ignored";
                    },
                    Remark => {
                        errs() << "remark";
                    },
                    Warning => {
                        errs() << "warning";
                    },
                    Error => {
                        errs() << "error";
                    },
                    Fatal => {
                        errs() << "fatal";
                    },
                }
                if !Mapping.second.isUser() {
                    errs() << " default";
                }
                if Mapping.second.isPragma() {
                    errs() << " pragma";
                }
                if Mapping.second.hasNoWarningAsError() {
                    errs() << " no-error";
                }
                if Mapping.second.hasNoErrorAsFatal() {
                    errs() << " no-fatal";
                }
                if Mapping.second.wasUpgradedFromWarning() {
                    errs() << " overruled";
                }
                errs() << "\n";
            }
        }
    }
}

fn DiagnosticsEngine::PushDiagStatePoint(self, State: *mut DiagState, Loc: SourceLocation) {
    assert!(Loc.isValid(), "Adding invalid loc point");
    self.DiagStatesByLoc.append(*self.SourceMgr, Loc, State);
}

fn DiagnosticsEngine::setSeverity(self, Diag: kind, Map: Severity, L: SourceLocation) {
    assert!((operator(self.Diags).isWarningOrExtension(Diag) || (Map == Fatal || Map == Error)), "Cannot map errors into warnings!");
    assert!((L.isInvalid() || self.SourceMgr), "No SourceMgr for valid location");
    let mut WasUpgradedFromWarning: bool = false;
    if Map == Warning && L.isInvalid() {
        let mut Info: *mut DiagnosticMapping = self.GetCurDiagState().getOrAddMapping(Diag);
        if Info.getSeverity() == Error || Info.getSeverity() == Fatal {
            Map = Info.getSeverity();
            WasUpgradedFromWarning = true;
        }
    }
    let mut Mapping: DiagnosticMapping = self.makeUserMapping(Map, L);
    Mapping.setUpgradedFromWarning(WasUpgradedFromWarning);
    let mut Info: *mut DiagnosticMapping = self.GetCurDiagState().getOrAddMapping(Diag);
    Mapping.setNoWarningAsError(Info.hasNoWarningAsError() || Mapping.hasNoWarningAsError());
    if (L.isInvalid() || L == self.DiagStatesByLoc.getCurDiagStateLoc()) && self.DiagStatesByLoc.getCurDiagState() {
        self.DiagStatesByLoc.getCurDiagState().setMapping(Diag, Mapping);
        return;
    }
    self.DiagStates.push(*self.GetCurDiagState());
    self.DiagStates.back().setMapping(Diag, Mapping);
    self.PushDiagStatePoint(&mut self.DiagStates.back(), L);
}

fn DiagnosticsEngine::setSeverityForGroup(self, Flavor: Flavor, Group: str, Map: Severity, Loc: SourceLocation) -> bool {
    let mut GroupDiags: kind, 256> = kind, 256> {};
    if operator(self.Diags).getDiagnosticsInGroup(Flavor, Group, GroupDiags) {
        return true;
    }
    operator(self.Diags).setGroupSeverity(Group, Map);
    for Diag in GroupDiags {
        self.setSeverity(Diag, Map, Loc);
    }
    return false;
}

fn DiagnosticsEngine::setSeverityForGroup(self, Flavor: Flavor, Group: Group, Map: Severity, Loc: SourceLocation) -> bool {
    return self.setSeverityForGroup(Flavor, operator(self.Diags).getWarningOptionForGroup(Group), Map, Loc);
}

fn DiagnosticsEngine::setDiagnosticGroupWarningAsError(self, Group: str, Enabled: bool) -> bool {
    if Enabled {
        return self.setSeverityForGroup(WarningOrError, Group, Error, SourceLocation {});
    }
    operator(self.Diags).setGroupSeverity(Group, Warning);
    let mut GroupDiags: kind, 8> = kind, 8> {};
    if operator(self.Diags).getDiagnosticsInGroup(WarningOrError, Group, GroupDiags) {
        return true;
    }
    for Diag in GroupDiags {
        let mut Info: *mut DiagnosticMapping = self.GetCurDiagState().getOrAddMapping(Diag);
        if Info.getSeverity() == Error || Info.getSeverity() == Fatal {
            Info.setSeverity(Warning);
        }
        Info.setNoWarningAsError(true);
    }
    return false;
}

fn DiagnosticsEngine::setDiagnosticGroupErrorAsFatal(self, Group: str, Enabled: bool) -> bool {
    if Enabled {
        return self.setSeverityForGroup(WarningOrError, Group, Fatal, SourceLocation {});
    }
    operator(self.Diags).setGroupSeverity(Group, Error);
    let mut GroupDiags: kind, 8> = kind, 8> {};
    if operator(self.Diags).getDiagnosticsInGroup(WarningOrError, Group, GroupDiags) {
        return true;
    }
    for Diag in GroupDiags {
        let mut Info: *mut DiagnosticMapping = self.GetCurDiagState().getOrAddMapping(Diag);
        if Info.getSeverity() == Fatal {
            Info.setSeverity(Error);
        }
        Info.setNoErrorAsFatal(true);
    }
    return false;
}

fn DiagnosticsEngine::setSeverityForAll(self, Flavor: Flavor, Map: Severity, Loc: SourceLocation) {
    let mut AllDiags: []kind = []kind {};
    getAllDiagnostics(Flavor, AllDiags);
    for Diag in AllDiags {
        if operator(self.Diags).isWarningOrExtension(Diag) {
            self.setSeverity(Diag, Map, Loc);
        }
    }
}

struct WarningsSpecialCaseList {
    StrAlloc: BumpPtrAllocator,
    Sections: []Section,
    DiagToSection: kind, const Section *>,
}

fn WarningsSpecialCaseList::sections(self: *WarningsSpecialCaseList) -> ArrayRef<const Section> {
    return self.Sections;
}

fn WarningsSpecialCaseList::create(self, Input: *MemoryBuffer, Err: *mut str) -> unique_ptr<WarningsSpecialCaseList> {
    let mut WarningSuppressionList: WarningsSpecialCaseList> = make_unique();
    if !operator(WarningSuppressionList).createInternal(&mut Input, Err) {
        return null;
    }
    return WarningSuppressionList;
}

fn WarningsSpecialCaseList::processSections(self, Diags: *mut DiagnosticsEngine) {
    let mut WarningFlavor: Flavor = WarningOrError;
    for SectionEntry in self.sections() {
        let mut DiagGroup: str = SectionEntry.name();
        if DiagGroup == "*" {
            continue;
        }
        let mut GroupDiags: kind> = kind> {};
        if operator(Diags.getDiagnosticIDs()).getDiagnosticsInGroup(WarningFlavor, DiagGroup, GroupDiags) {
            let mut Suggestion: str = getNearestOption(WarningFlavor, DiagGroup);
            Diags.Report(warn_unknown_diag_option) << WarningFlavor as u32 << DiagGroup << !Suggestion.is_empty() << Suggestion;
            continue;
        }
        for Diag in GroupDiags {
            self.DiagToSection[Diag] = &mut SectionEntry;
        }
    }
}

fn DiagnosticsEngine::setDiagSuppressionMapping(self, Input: *mut MemoryBuffer) {
    let mut Error: str = "";
    let mut WarningSuppressionList: unique_ptr<WarningsSpecialCaseList> = create(Input, Error);
    if !WarningSuppressionList {
        self.Report(err_drv_malformed_warning_suppression_mapping) << Input.getBufferIdentifier() << Error;
        return;
    }
    operator(WarningSuppressionList).processSections(*self);
    self.DiagSuppressionMapping = SourceManager &) const> { Closure_4 { cap_0: &mut move(WarningSuppressionList) }, null, null };
}

fn WarningsSpecialCaseList::isDiagSuppressed(self: *WarningsSpecialCaseList, DiagId: kind, DiagLoc: SourceLocation, SM: *SourceManager) -> bool {
    let mut PLoc: PresumedLoc = SM.getPresumedLoc(DiagLoc, true);
    if !PLoc.isValid() {
        return false;
    }
    let mut DiagSection: *Section = self.DiagToSection.lookup(DiagId);
    if !DiagSection {
        return false;
    }
    let mut F: str = remove_leading_dotslash(PLoc.getFilename(), native);
    let mut LastSup: u32 = DiagSection.getLastMatch("src", F, "");
    if LastSup == 0 {
        return false;
    }
    let mut LastEmit: u32 = DiagSection.getLastMatch("src", F, "emit");
    return LastSup > LastEmit;
}

fn DiagnosticsEngine::getDiagStateSystemClassForLoc(self: *DiagnosticsEngine, Loc: SourceLocation) -> DiagStateSystemClass {
    let mut SM: *SourceManager = self.getSourceManager();
    let mut Class: u32 = 0;
    if SM.isInSystemHeader(SM.getExpansionLoc(Loc)) {
        Class |= SystemHeader as u32;
    }
    if SM.isInSystemMacro(Loc) {
        Class |= SystemMacro as u32;
    }
    return Class as DiagStateSystemClass;
}

fn DiagnosticsEngine::isSuppressedViaMapping(self: *DiagnosticsEngine, DiagId: kind, DiagLoc: SourceLocation) -> bool {
    if !self.hasSourceManager() || !self.DiagSuppressionMapping {
        return false;
    }
    return self.DiagSuppressionMapping.call(DiagId, DiagLoc, self.getSourceManager());
}

fn DiagnosticsEngine::Report(self, storedDiag: *StoredDiagnostic) {
    let mut DiagStorage: DiagnosticStorage = DiagnosticStorage {};
    DiagStorage.DiagRanges.append(storedDiag.range_begin(), storedDiag.range_end());
    DiagStorage.FixItHints.append(storedDiag.fixit_begin(), storedDiag.fixit_end());
    assert!(self.Client, "DiagnosticConsumer not set!");
    let mut DiagLevel: Level = storedDiag.getLevel();
    let mut Info: Diagnostic = Diagnostic { self, storedDiag.getLocation(), storedDiag.getID(), DiagStorage, storedDiag.getMessage() };
    self.Report(DiagLevel, Info);
}

fn DiagnosticsEngine::Report(self, DiagLevel: Level, Info: *Diagnostic) {
    assert!(DiagLevel != Ignored, "Cannot emit ignored diagnostics!");
    assert!(!operator(self.getDiagnosticIDs()).isTrapDiag(Info.getID()), "Trap diagnostics should not be consumed by the DiagnosticsEngine");
    self.Client.HandleDiagnostic(DiagLevel, Info);
    if self.Client.IncludeInDiagnosticCounts() {
        if DiagLevel == Warning {
            self.NumWarnings += 1;
        }
    }
}

fn DiagnosticsEngine::ProcessDiag(self, DiagBuilder: *DiagnosticBuilder) -> bool {
    let mut Info: Diagnostic = Diagnostic { self, DiagBuilder };
    assert!(self.getClient(), "DiagnosticClient not set!");
    let mut DiagID: u32 = Info.getID();
    let mut DiagLevel: Level = self.getDiagnosticLevel(DiagID, Info.getLocation());
    if DiagLevel >= Error {
        self.TrapNumErrorsOccurred += 1;
        if operator(self.Diags).isUnrecoverable(DiagID) {
            self.TrapNumUnrecoverableErrorsOccurred += 1;
        }
    }
    if self.SuppressAllDiagnostics {
        return false;
    }
    if DiagLevel != Note {
        if self.LastDiagLevel == Fatal {
            self.FatalErrorOccurred = true;
        }
        self.LastDiagLevel = DiagLevel;
    }
    if self.FatalErrorOccurred {
        if DiagLevel >= Error && self.Client.IncludeInDiagnosticCounts() {
            self.NumErrors += 1;
        }
        return false;
    }
    if DiagLevel == Ignored || (DiagLevel == Note && self.LastDiagLevel == Ignored) {
        return false;
    }
    if DiagLevel >= Error {
        if operator(self.Diags).isUnrecoverable(DiagID) {
            self.UnrecoverableErrorOccurred = true;
        }
        if operator(self.Diags).isDefaultMappingAsError(DiagID) {
            self.UncompilableErrorOccurred = true;
        }
        self.ErrorOccurred = true;
        if self.Client.IncludeInDiagnosticCounts() {
            self.NumErrors += 1;
        }
        if self.ErrorLimit && self.NumErrors > self.ErrorLimit && DiagLevel == Error {
            self.Report(fatal_too_many_errors);
            return false;
        }
    }
    if Info.getID() == fatal_too_many_errors {
        self.FatalErrorOccurred = true;
    }
    self.Report(DiagLevel, Info);
    return true;
}

fn DiagnosticsEngine::EmitDiagnostic(self, DB: *DiagnosticBuilder, Force: bool) -> bool {
    assert!(self.getClient(), "DiagnosticClient not set!");
    let mut Emitted: bool = false;
    if Force {
        let mut Info: Diagnostic = Diagnostic { self, DB };
        let mut DiagLevel: Level = self.getDiagnosticLevel(Info.getID(), Info.getLocation());
        Emitted = DiagLevel != Ignored;
        if Emitted {
            self.Report(DiagLevel, Info);
        }
    } else {
        Emitted = self.ProcessDiag(DB);
    }
    return Emitted;
}

fn DiagnosticBuilder::DiagnosticBuilder(self, DiagObj: *mut DiagnosticsEngine, DiagLoc: SourceLocation, DiagID: u32) {
    assert!(DiagObj, "DiagnosticBuilder requires a valid DiagnosticsEngine!");
}

fn DiagnosticBuilder::DiagnosticBuilder(self, D: *DiagnosticBuilder) {
    self.DiagLoc = D.DiagLoc;
    self.DiagID = D.DiagID;
    self.FlagValue = D.FlagValue;
    self.DiagObj = D.DiagObj;
    self.DiagStorage = D.DiagStorage;
    D.DiagStorage = null;
    self.Allocator = D.Allocator;
    self.IsActive = D.IsActive;
    self.IsForceEmit = D.IsForceEmit;
    D.Clear();
}

fn DiagnosticConsumer::~DiagnosticConsumer(self) {}

fn DiagnosticConsumer::HandleDiagnostic(self, DiagLevel: Level, Info: *Diagnostic) {
    if !self.IncludeInDiagnosticCounts() {
        return;
    }
    if DiagLevel == Warning {
        self.NumWarnings += 1;
    } else if DiagLevel >= Error {
        self.NumErrors += 1;
    }
}

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: ModifierIs]
// template <typename StrLen>
// fn ModifierIs(Modifier: *u8, ModifierLen: u32, Str: [6]char (&)) -> bool {
//     return  - 1 == ModifierLen && memcmp(Modifier, Str,  - 1) == 0;
// }
// ========================================================

fn ScanFormat(I: *u8, E: *u8, Target: i8) -> *u8 {
    let mut Depth: u32 = 0;
    for ; I != E; I += 1 {
        if Depth == 0 && *I == Target {
            return I;
        }
        if Depth != 0 && *I == '}' {
            Depth -= 1;
        }
        if *I == '%' {
            I += 1;
            if I == E {
                break;
            }
            if !isDigit(*I) && !isPunctuation(*I) {
                for I += 1; I != E && !isDigit(*I) && *I != '{'; I += 1 {
                    
                }
                if I == E {
                    break;
                }
                if *I == '{' {
                    Depth += 1;
                }
            }
        }
    }
    return E;
}

fn HandleSelectModifier(DInfo: *Diagnostic, ValNo: u32, Argument: *u8, ArgumentLen: u32, OutStr: *mut SmallVectorImpl<char>) {
    let mut ArgumentEnd: *u8 = Argument + ArgumentLen;
    while ValNo {
        let mut NextVal: *u8 = ScanFormat(Argument, ArgumentEnd, '|');
        assert!(NextVal != ArgumentEnd, "Value for integer select modifier was larger than the number of options in the diagnostic string!");
        Argument = NextVal + 1;
        ValNo -= 1;
    }
    let mut EndPtr: *u8 = ScanFormat(Argument, ArgumentEnd, '|');
    DInfo.FormatDiagnostic(Argument, EndPtr, OutStr);
}

fn HandleIntegerSModifier(ValNo: u32, OutStr: *mut SmallVectorImpl<char>) {
    if ValNo != 1 {
        OutStr.push('s');
    }
}

fn HandleOrdinalModifier(ValNo: u32, OutStr: *mut SmallVectorImpl<char>) {
    assert!(ValNo != 0, "ValNo must be strictly positive!");
    let mut Out: raw_svector_ostream = OutStr;
    Out << ValNo << getOrdinalSuffix(ValNo);
}

fn HandleIntegerHumanModifier(ValNo: i64, OutStr: *mut SmallVectorImpl<char>) {
    let mut Units: pair<int64_t, char>, 4> = pair<int64_t, char>, 4> { [pair<long long, char> { 1000000000000, 'T' }, pair<long long, char> { 1000000000, 'G' }, pair<long long, char> { 1000000, 'M' }, pair<long long, char> { 1000, 'k' }] };
    let mut Out: raw_svector_ostream = OutStr;
    if ValNo < 0 {
        Out << "-";
        ValNo = -ValNo;
    }
    for x in Units {
        if ValNo >= UnitSize {
            Out << format("%0.2f%c", ValNo / UnitSize as f64, UnitSign);
            return;
        }
    }
    Out << ValNo;
}

fn PluralNumber(Start: **mut u8, End: *u8) -> u32 {
    let mut Val: u32 = 0;
    while Start != End && *Start >= '0' && *Start <= '9' {
        Val *= 10;
        Val += *Start - '0';
        Start += 1;
    }
    return Val;
}

fn TestPluralRange(Val: u32, Start: **mut u8, End: *u8) -> bool {
    if *Start != '[' {
        let mut Ref: u32 = PluralNumber(Start, End);
        return Ref == Val;
    }
    Start += 1;
    let mut Low: u32 = PluralNumber(Start, End);
    assert!(*Start == ',', "Bad plural expression syntax: expected ,");
    Start += 1;
    let mut High: u32 = PluralNumber(Start, End);
    assert!(*Start == ']', "Bad plural expression syntax: expected )");
    Start += 1;
    return Low <= Val && Val <= High;
}

fn EvalPluralExpr(ValNo: u32, Start: *u8, End: *u8) -> bool {
    if *Start == ':' {
        return true;
    }
    while true {
        let mut C: i8 = *Start;
        if C == '%' {
            Start += 1;
            let mut Arg: u32 = PluralNumber(Start, End);
            assert!(*Start == '=', "Bad plural expression syntax: expected =");
            Start += 1;
            let mut ValMod: u32 = ValNo % Arg;
            if TestPluralRange(ValMod, Start, End) {
                return true;
            }
        } else {
            assert!((C == '[' || (C >= '0' && C <= '9')), "Bad plural expression syntax: unexpected character");
            if TestPluralRange(ValNo, Start, End) {
                return true;
            }
        }
        Start = find(Start, End, ',');
        if Start == End {
            break;
        }
        Start += 1;
    }
    return false;
}

fn HandlePluralModifier(DInfo: *Diagnostic, ValNo: u32, Argument: *u8, ArgumentLen: u32, OutStr: *mut SmallVectorImpl<char>) {
    let mut ArgumentEnd: *u8 = Argument + ArgumentLen;
    while true {
        assert!(Argument < ArgumentEnd, "Plural expression didn't match.");
        let mut ExprEnd: *u8 = Argument;
        while *ExprEnd != ':' {
            assert!(ExprEnd != ArgumentEnd, "Plural missing expression end");
            ExprEnd += 1;
        }
        if EvalPluralExpr(ValNo, Argument, ExprEnd) {
            Argument = ExprEnd + 1;
            ExprEnd = ScanFormat(Argument, ArgumentEnd, '|');
            DInfo.FormatDiagnostic(Argument, ExprEnd, OutStr);
            return;
        }
        Argument = ScanFormat(Argument, ArgumentEnd - 1, '|') + 1;
    }
}

fn getTokenDescForDiagnostic(Kind: TokenKind) -> *u8 {
    match Kind {
        identifier => {
            return "identifier";
        },
        _ => {
            return null;
        },
    }
}

fn Diagnostic::FormatDiagnostic(self: *Diagnostic, OutStr: *mut SmallVectorImpl<char>) {
    if self.StoredDiagMessage.has_value() {
        OutStr.append(operator(self.StoredDiagMessage).begin(), operator(self.StoredDiagMessage).end());
        return;
    }
    let mut Diag: str = operator(self.getDiags().getDiagnosticIDs()).getDescription(self.getID());
    self.FormatDiagnostic(Diag.begin(), Diag.end(), OutStr);
}

fn EscapeStringForDiagnostic(Str: str, OutStr: *mut SmallVectorImpl<char>, ForCodepoint: bool) {
    OutStr.reserve(OutStr.len + Str.len);
    let mut Begin: *u8 = Str.ptr as *u8;
    let mut OutStream: raw_svector_ostream = OutStr;
    let mut Size: u32 = Str.len;
    let mut End: *u8 = Begin + Size;
    if ForCodepoint {
        let mut Size: u32 = getUTF8SequenceSize(Begin, End);
        if Size == 0 {
            Size = findMaximalSubpartOfIllFormedUTF8Sequence(Begin, End);
        }
        End = Begin + Size;
    }
    while Begin != End {
        if !ForCodepoint && (isPrintable(*Begin) || isWhitespace(*Begin)) {
            OutStream << *Begin;
            Begin += 1;
            continue;
        }
        if ForCodepoint && *Begin < 128 {
            if isPrintable(*Begin) {
                OutStream << "'" << *Begin << "'";
                Begin += 1;
                continue;
            }
        }
        if isLegalUTF8Sequence(Begin, End) {
            let mut CodepointValue: UTF32 = zeroed();
            let mut CpPtr: *mut UTF32 = &mut CodepointValue;
            let mut CodepointBegin: *u8 = Begin;
            let mut CodepointEnd: *u8 = Begin + getNumBytesForUTF8(*Begin);
            let mut Res: ConversionResult = ConvertUTF8toUTF32(&mut Begin, CodepointEnd, &mut CpPtr, CpPtr + 1, strictConversion);
            Res as void;
            assert!(conversionOK == Res, "the sequence is legal UTF-8 but we couldn't convert it to UTF-32");
            assert!(Begin == CodepointEnd, "we must be further along in the string now");
            if isPrintable(CodepointValue) || (!ForCodepoint && isFormatting(CodepointValue)) {
                OutStream << (if ForCodepoint { "'" } else { "" }) << CodepointBegin as *u8[0..distance(CodepointBegin, CodepointEnd)] << (if ForCodepoint { "' " } else { "" });
                if !ForCodepoint {
                    continue;
                }
            }
            OutStream << (if ForCodepoint { "" } else { "<" }) << "U+" << format_hex_no_prefix(CodepointValue, 4, true) << (if ForCodepoint { "" } else { ">" });
            continue;
        }
        OutStream << "<0x" << format_hex_no_prefix(*Begin, 2, true) << ">";
        Begin += 1;
    }
}

fn EscapeStringForDiagnostic(Str: str, OutStr: *mut SmallVectorImpl<char>) {
    EscapeStringForDiagnostic(Str, OutStr, false);
}

fn EscapeSingleCodepointForDiagnostic(Str: str) -> str {
    let mut CP: str = "";
    EscapeStringForDiagnostic(Str, CP, true);
    return CP;
}

fn EscapeSingleCodepointForDiagnostic(CP: UTF32) -> str {
    let mut ResultBuf: [4]i8 = zeroed();
    let mut ResultPtr: *mut u8 = ResultBuf;
    if !ConvertCodePointToUTF8(CP, ResultPtr) {
        return formatv("<{0:X+}>", CP);
    }
    return EscapeSingleCodepointForDiagnostic(ResultBuf[0..ResultPtr - ResultBuf]);
}

fn Diagnostic::FormatDiagnostic(self: *Diagnostic, DiagStr: *u8, DiagEnd: *u8, OutStr: *mut SmallVectorImpl<char>) {
    if DiagEnd - DiagStr == 2 && DiagStr[0..DiagEnd - DiagStr] == "%0" && self.getArgKind(0) == ak_std_string {
        let mut S: str = self.getArgStdStr(0);
        EscapeStringForDiagnostic(S, OutStr);
        return;
    }
    let mut FormattedArgs: ArgumentValue, 8> = ArgumentValue, 8> {};
    let mut QualTypeVals: SmallVector<intptr_t, 2> = SmallVector<intptr_t, 2> {};
    let mut Tree: str = "";
    for let mut i: u32 = 0;
let mut e: u32 = self.getNumArgs(); i < e; i += 1 {
        if self.getArgKind(i) == ak_qualtype {
            QualTypeVals.push(self.getRawArg(i));
        }
    }
    while DiagStr != DiagEnd {
        if DiagStr[0] != '%' {
            let mut StrEnd: *u8 = find(DiagStr, DiagEnd, '%');
            OutStr.append(DiagStr, StrEnd);
            DiagStr = StrEnd;
            continue;
        } else if isPunctuation(DiagStr[1]) {
            OutStr.push(DiagStr[1]);
            DiagStr += 2;
            continue;
        }
        DiagStr += 1;
        let mut Modifier: *u8 = null;
        let mut Argument: *u8 = null;
        let mut ModifierLen: u32 = 0;
        let mut ArgumentLen: u32 = 0;
        if !isDigit(DiagStr[0]) {
            Modifier = DiagStr;
            while DiagStr[0] == '-' || (DiagStr[0] >= 'a' && DiagStr[0] <= 'z') {
                DiagStr += 1;
            }
            ModifierLen = DiagStr - Modifier;
            if DiagStr[0] == '{' {
                DiagStr += 1;
                Argument = DiagStr;
                DiagStr = ScanFormat(DiagStr, DiagEnd, '}');
                assert!(DiagStr != DiagEnd, "Mismatched {}'s in diagnostic string!");
                ArgumentLen = DiagStr - Argument;
                DiagStr += 1;
            }
        }
        assert!(isDigit(*DiagStr), "Invalid format for argument in diagnostic");
        let mut ArgNo: u32 = *DiagStr += 1 - '0';
        let mut ArgNo2: u32 = ArgNo;
        let mut Kind: ArgumentKind = self.getArgKind(ArgNo);
        if ModifierIs(Modifier, ModifierLen, "diff") {
            assert!(*DiagStr == ',' && isDigit(*(DiagStr + 1)), "Invalid format for diff modifier");
            DiagStr += 1;
            ArgNo2 = *DiagStr += 1 - '0';
            let mut Kind2: ArgumentKind = self.getArgKind(ArgNo2);
            if Kind == ak_qualtype && Kind2 == ak_qualtype {
                Kind = ak_qualtype_pair;
            } else {
                let mut ArgumentEnd: *u8 = Argument + ArgumentLen;
                let mut Pipe: *u8 = ScanFormat(Argument, ArgumentEnd, '|');
                assert!(ScanFormat(Pipe + 1, ArgumentEnd, '|') == ArgumentEnd, "Found too many '|'s in a %diff modifier!");
                let mut FirstDollar: *u8 = ScanFormat(Argument, Pipe, '$');
                let mut SecondDollar: *u8 = ScanFormat(FirstDollar + 1, Pipe, '$');
                let mut ArgStr1: [2]i8 = ['%', '0' + ArgNo as i8];
                let mut ArgStr2: [2]i8 = ['%', '0' + ArgNo2 as i8];
                self.FormatDiagnostic(Argument, FirstDollar, OutStr);
                self.FormatDiagnostic(ArgStr1, ArgStr1 + 2, OutStr);
                self.FormatDiagnostic(FirstDollar + 1, SecondDollar, OutStr);
                self.FormatDiagnostic(ArgStr2, ArgStr2 + 2, OutStr);
                self.FormatDiagnostic(SecondDollar + 1, Pipe, OutStr);
                continue;
            }
        }
        match Kind {
            ak_std_string => {
                ak_c_string;
            },
            ak_sint => {
                let mut Val: i64 = self.getArgSInt(ArgNo);
                if ModifierIs(Modifier, ModifierLen, "select") {
                    HandleSelectModifier(*self, Val as u32, Argument, ArgumentLen, OutStr);
                } else if ModifierIs(Modifier, ModifierLen, "s") {
                    HandleIntegerSModifier(Val, OutStr);
                } else if ModifierIs(Modifier, ModifierLen, "plural") {
                    HandlePluralModifier(*self, Val as u32, Argument, ArgumentLen, OutStr);
                } else if ModifierIs(Modifier, ModifierLen, "ordinal") {
                    HandleOrdinalModifier(Val as u32, OutStr);
                } else if ModifierIs(Modifier, ModifierLen, "human") {
                    HandleIntegerHumanModifier(Val, OutStr);
                } else {
                    assert!(ModifierLen == 0, "Unknown integer modifier");
                    OutStr << Val;
                }
                break;
            },
            ak_uint => {
                let mut Val: u64 = self.getArgUInt(ArgNo);
                if ModifierIs(Modifier, ModifierLen, "select") {
                    HandleSelectModifier(*self, Val, Argument, ArgumentLen, OutStr);
                } else if ModifierIs(Modifier, ModifierLen, "s") {
                    HandleIntegerSModifier(Val, OutStr);
                } else if ModifierIs(Modifier, ModifierLen, "plural") {
                    HandlePluralModifier(*self, Val as u32, Argument, ArgumentLen, OutStr);
                } else if ModifierIs(Modifier, ModifierLen, "ordinal") {
                    HandleOrdinalModifier(Val, OutStr);
                } else if ModifierIs(Modifier, ModifierLen, "human") {
                    HandleIntegerHumanModifier(Val, OutStr);
                } else {
                    assert!(ModifierLen == 0, "Unknown integer modifier");
                    OutStr << Val;
                }
                break;
            },
            ak_tokenkind => {
                let mut Kind: TokenKind = self.getRawArg(ArgNo) as TokenKind;
                assert!(ModifierLen == 0, "No modifiers for token kinds yet");
                let mut Out: raw_svector_ostream = OutStr;
                if getPunctuatorSpelling(Kind) {
                    S;
                } else {
                    Out << ''' << S << ''';
                }
                break;
            },
            ak_identifierinfo => {
                let mut II: *IdentifierInfo = self.getArgIdentifier(ArgNo);
                assert!(ModifierLen == 0, "No modifiers for strings yet");
                if !II {
                    let mut S: *u8 = "(null)";
                    OutStr.append(S, S + strlen(S));
                    continue;
                }
                OutStr << ''' << II.getName() << ''';
                break;
            },
            ak_addrspace => {
                ak_qual;
            },
            ak_qualtype_pair => {
                let mut TDT: TemplateDiffTypes = TemplateDiffTypes {};
                TDT.FromType = self.getRawArg(ArgNo);
                TDT.ToType = self.getRawArg(ArgNo2);
                TDT.ElideType = self.getDiags().ElideType;
                TDT.ShowColors = self.getDiags().ShowColors;
                TDT.TemplateDiffUsed = false;
                let mut val: i64 = &mut TDT as i64;
                let mut ArgumentEnd: *u8 = Argument + ArgumentLen;
                let mut Pipe: *u8 = ScanFormat(Argument, ArgumentEnd, '|');
                if self.getDiags().PrintTemplateTree && Tree.is_empty() {
                    TDT.PrintFromType = true;
                    TDT.PrintTree = true;
                    self.getDiags().ConvertArgToString(Kind, val, Modifier[0..ModifierLen], Argument[0..ArgumentLen], FormattedArgs, Tree, QualTypeVals);
                    if !Tree.is_empty() {
                        self.FormatDiagnostic(Pipe + 1, ArgumentEnd, OutStr);
                        break;
                    }
                }
                let mut FirstDollar: *u8 = ScanFormat(Argument, ArgumentEnd, '$');
                let mut SecondDollar: *u8 = ScanFormat(FirstDollar + 1, ArgumentEnd, '$');
                self.FormatDiagnostic(Argument, FirstDollar, OutStr);
                TDT.PrintTree = false;
                TDT.PrintFromType = true;
                self.getDiags().ConvertArgToString(Kind, val, Modifier[0..ModifierLen], Argument[0..ArgumentLen], FormattedArgs, OutStr, QualTypeVals);
                if !TDT.TemplateDiffUsed {
                    FormattedArgs.push(make_pair(ak_qualtype, TDT.FromType));
                }
                self.FormatDiagnostic(FirstDollar + 1, SecondDollar, OutStr);
                TDT.PrintFromType = false;
                self.getDiags().ConvertArgToString(Kind, val, Modifier[0..ModifierLen], Argument[0..ArgumentLen], FormattedArgs, OutStr, QualTypeVals);
                if !TDT.TemplateDiffUsed {
                    FormattedArgs.push(make_pair(ak_qualtype, TDT.ToType));
                }
                self.FormatDiagnostic(SecondDollar + 1, Pipe, OutStr);
                break;
            },
        }
        if Kind == ak_qualtype_pair {
            continue;
        } else if Kind != ak_std_string {
            FormattedArgs.push(make_pair(Kind, self.getRawArg(ArgNo)));
        } else {
            FormattedArgs.push(make_pair(ak_c_string, self.getArgStdStr(ArgNo).ptr as i64));
        }
    }
    OutStr.append(Tree.begin(), Tree.end());
}

fn StoredDiagnostic::StoredDiagnostic(self, Level: Level, Info: *Diagnostic) {
    assert!((Info.getLocation().isInvalid() || Info.hasSourceManager()), "Valid source location without setting a source manager for diagnostic");
    if Info.getLocation().isValid() {
        self.Loc = FullSourceLoc { ID: Info.getLocation(), SrcMgr: Info.getSourceManager() };
    }
    let mut Message: str = "";
    Info.FormatDiagnostic(Message);
    self.Message.assign(Message.begin(), Message.end());
    self.Ranges.assign(Info.getRanges().begin(), Info.getRanges().end());
    self.FixIts.assign(Info.getFixItHints().begin(), Info.getFixItHints().end());
}

fn op_<<(OS: *mut raw_ostream, SD: *StoredDiagnostic) -> *mut raw_ostream {
    if SD.getLocation().hasManager() {
        OS << SD.getLocation().printToString(SD.getLocation().getManager()) << ": ";
    }
    OS << SD.getMessage();
    return OS;
}

fn DiagnosticConsumer::IncludeInDiagnosticCounts(self: *DiagnosticConsumer) -> bool {
    return true;
}

fn IgnoringDiagConsumer::anchor(self) {}

fn ForwardingDiagnosticConsumer::~ForwardingDiagnosticConsumer(self) {}

fn ForwardingDiagnosticConsumer::HandleDiagnostic(self, DiagLevel: Level, Info: *Diagnostic) {
    self.Target.HandleDiagnostic(DiagLevel, Info);
}

fn ForwardingDiagnosticConsumer::clear(self) {
    self.clear();
    self.Target.clear();
}

fn ForwardingDiagnosticConsumer::IncludeInDiagnosticCounts(self: *ForwardingDiagnosticConsumer) -> bool {
    return self.Target.IncludeInDiagnosticCounts();
}

fn DiagStorageAllocator::DiagStorageAllocator(self) {
    for let mut I: u32 = 0; I != NumCached; I += 1 {
        self.FreeList[I] = self.Cached + I;
    }
    self.NumFreeListEntries = NumCached;
}

fn DiagStorageAllocator::~DiagStorageAllocator(self) {
    assert!((self.NumFreeListEntries == NumCached || isRecoveringFromCrash()), "A partial is on the lam");
}

static mut ID: i8 = 0;

struct Closure_1 {
    Offset: u32,
}

fn Closure_1::call(self: *Closure_1, P: *DiagStatePoint) -> bool {
        return self.Offset <= self.Offset;
    }

struct Closure_2 {
    PrintedOuterHeading: *mut bool,
    File: *mut File,
    ID: *mut FileID,
    SrcMgr: *mut SourceManager,
    F: *mut value_type,
}

unsafe fn Closure_2::call(self: *mut Closure_2) -> auto {
            if (*self.PrintedOuterHeading) {
                return;
            }
            (*self.PrintedOuterHeading) = true;
            errs() << "File " << &mut (*self.File) << " <FileID " << (*self.ID).getHashValue() << ">: " << (*self.SrcMgr).getBufferOrFake((*self.ID), SourceLocation {}).getBufferIdentifier();
            if (*self.F).second.Parent {
                let mut Decomp: FileIDAndOffset = (*self.SrcMgr).getDecomposedIncludedLoc((*self.ID));
                assert!((*self.File).ParentOffset == Decomp.second);
                errs() << " parent " << (*self.File).Parent << " <FileID " << Decomp.first.getHashValue() << "> ";
                (*self.SrcMgr).getLocForStartOfFile(Decomp.first).getLocWithOffset(Decomp.second).print(errs(), (*self.SrcMgr));
            }
            if (*self.File).HasLocalTransitions {
                errs() << " has_local_transitions";
            }
            errs() << "\n";
        }

struct Closure_3 {
    PrintedInnerHeading: *mut bool,
    PrintOuterHeading: *mut (lambda at P:\Goraw\llvm-project\clang\lib\Basic\Diagnostic.cpp:258:30),
    SrcMgr: *mut SourceManager,
    ID: *mut FileID,
    Transition: *mut DiagStatePoint,
}

unsafe fn Closure_3::call(self: *mut Closure_3) -> auto {
                if (*self.PrintedInnerHeading) {
                    return;
                }
                (*self.PrintedInnerHeading) = true;
                (*self.PrintOuterHeading).call();
                errs() << "  ";
                (*self.SrcMgr).getLocForStartOfFile((*self.ID)).getLocWithOffset((*self.Transition).Offset).print(errs(), (*self.SrcMgr));
                errs() << ": state " << (*self.Transition).State << ":\n";
            }

struct Closure_4 {
    cap_0: *mut WarningsSpecialCaseList>> &>,
}

unsafe fn Closure_4::call(self: *mut Closure_4, DiagId: kind, DiagLoc: SourceLocation, SM: *SourceManager) -> bool {
        return operator(WarningSuppressionList).isDiagSuppressed(DiagId, DiagLoc, SM);
    }
