const StaticDiagInfoSize: u32 = size(StaticDiagInfo);

fn GetDiagInfo(DiagID: u32) -> *StaticDiagInfoRec {
    if DiagID >= DIAG_UPPER_LIMIT || DiagID <= DIAG_START_COMMON {
        return null;
    }
    let mut Offset: u32 = 0;
    let mut ID: u32 = DiagID - DIAG_START_COMMON - 1;
    if DiagID > DIAG_START_DRIVER {
        Offset += NUM_BUILTIN_COMMON_DIAGNOSTICS - DIAG_START_COMMON - 1;
        ID -= DIAG_START_DRIVER - DIAG_START_COMMON;
    }
    if DiagID > DIAG_START_FRONTEND {
        Offset += NUM_BUILTIN_DRIVER_DIAGNOSTICS - DIAG_START_DRIVER - 1;
        ID -= DIAG_START_FRONTEND - DIAG_START_DRIVER;
    }
    if DiagID > DIAG_START_CODEGEN {
        Offset += NUM_BUILTIN_FRONTEND_DIAGNOSTICS - DIAG_START_FRONTEND - 1;
        ID -= DIAG_START_CODEGEN - DIAG_START_FRONTEND;
    }
    if DiagID > DIAG_START_SERIALIZATION {
        Offset += NUM_BUILTIN_CODEGEN_DIAGNOSTICS - DIAG_START_CODEGEN - 1;
        ID -= DIAG_START_SERIALIZATION - DIAG_START_CODEGEN;
    }
    if DiagID > DIAG_START_LEX {
        Offset += NUM_BUILTIN_SERIALIZATION_DIAGNOSTICS - DIAG_START_SERIALIZATION - 1;
        ID -= DIAG_START_LEX - DIAG_START_SERIALIZATION;
    }
    if DiagID > DIAG_START_PARSE {
        Offset += NUM_BUILTIN_LEX_DIAGNOSTICS - DIAG_START_LEX - 1;
        ID -= DIAG_START_PARSE - DIAG_START_LEX;
    }
    if DiagID > DIAG_START_AST {
        Offset += NUM_BUILTIN_PARSE_DIAGNOSTICS - DIAG_START_PARSE - 1;
        ID -= DIAG_START_AST - DIAG_START_PARSE;
    }
    if DiagID > DIAG_START_COMMENT {
        Offset += NUM_BUILTIN_AST_DIAGNOSTICS - DIAG_START_AST - 1;
        ID -= DIAG_START_COMMENT - DIAG_START_AST;
    }
    if DiagID > DIAG_START_CROSSTU {
        Offset += NUM_BUILTIN_COMMENT_DIAGNOSTICS - DIAG_START_COMMENT - 1;
        ID -= DIAG_START_CROSSTU - DIAG_START_COMMENT;
    }
    if DiagID > DIAG_START_SEMA {
        Offset += NUM_BUILTIN_CROSSTU_DIAGNOSTICS - DIAG_START_CROSSTU - 1;
        ID -= DIAG_START_SEMA - DIAG_START_CROSSTU;
    }
    if DiagID > DIAG_START_ANALYSIS {
        Offset += NUM_BUILTIN_SEMA_DIAGNOSTICS - DIAG_START_SEMA - 1;
        ID -= DIAG_START_ANALYSIS - DIAG_START_SEMA;
    }
    if DiagID > DIAG_START_REFACTORING {
        Offset += NUM_BUILTIN_ANALYSIS_DIAGNOSTICS - DIAG_START_ANALYSIS - 1;
        ID -= DIAG_START_REFACTORING - DIAG_START_ANALYSIS;
    }
    if DiagID > DIAG_START_INSTALLAPI {
        Offset += NUM_BUILTIN_REFACTORING_DIAGNOSTICS - DIAG_START_REFACTORING - 1;
        ID -= DIAG_START_INSTALLAPI - DIAG_START_REFACTORING;
    }
    if DiagID > DIAG_START_TRAP {
        Offset += NUM_BUILTIN_INSTALLAPI_DIAGNOSTICS - DIAG_START_INSTALLAPI - 1;
        ID -= DIAG_START_TRAP - DIAG_START_INSTALLAPI;
    }
    if ID + Offset >= StaticDiagInfoSize {
        return null;
    }
    assert!(ID < StaticDiagInfoSize && Offset < StaticDiagInfoSize);
    let mut Found: *StaticDiagInfoRec = &mut StaticDiagInfo[ID + Offset];
    if Found.DiagID != DiagID {
        return null;
    }
    return Found;
}

struct CustomDiagInfo {
    DiagInfo: []CustomDiagDesc,
    DiagIDs: map<CustomDiagDesc, unsigned int>,
    GroupToDiags: vector<unsigned int>>,
}

fn CustomDiagInfo::getDescription(self: *CustomDiagInfo, DiagID: u32) -> *CustomDiagDesc {
    assert!(DiagID - DIAG_UPPER_LIMIT < self.DiagInfo.len, "Invalid diagnostic ID");
    return self.DiagInfo[DiagID - DIAG_UPPER_LIMIT];
}

fn CustomDiagInfo::getOrCreateDiagID(self, D: CustomDiagDesc) -> u32 {
    let mut I: iterator = self.DiagIDs.lower_bound(D);
    if !I == self.DiagIDs.end() && operator(I).first == D {
        return operator(I).second;
    }
    let mut ID: u32 = self.DiagInfo.len + DIAG_UPPER_LIMIT;
    self.DiagIDs.insert(make_pair(D, ID));
    self.DiagInfo.push(D);
    if D.GetGroup() {
        Group;
    } else {
        self.GroupToDiags[operator(Group)].push(ID);
    }
    return ID;
}

fn CustomDiagInfo::getDiagsInGroup(self: *CustomDiagInfo, G: Group) -> ArrayRef<unsigned int> {
    let mut Diags: const_iterator = self.GroupToDiags.find(G);
    if !Diags == self.GroupToDiags.end() {
        return operator(Diags).second;
    }
    return ArrayRef<unsigned int> {};
}

fn DiagnosticIDs::getDefaultMapping(self: *DiagnosticIDs, DiagID: u32) -> DiagnosticMapping {
    let mut Info: DiagnosticMapping = Make(Fatal, false, false);
    if IsCustomDiag(DiagID) {
        Info.setSeverity(operator(self.CustomDiagInfo).getDescription(DiagID).GetDefaultSeverity());
    } else if GetDiagInfo(DiagID) {
        StaticInfo;
    } else {
        Info.setSeverity(StaticInfo.DefaultSeverity as Severity);
        if StaticInfo.WarnNoWerror {
            assert!(Info.getSeverity() == Warning, "Unexpected mapping with no-Werror bit!");
            Info.setNoWarningAsError(true);
        }
    }
    return Info;
}

fn DiagnosticIDs::initCustomDiagMapping(self, Mapping: *mut DiagnosticMapping, DiagID: u32) {
    assert!(IsCustomDiag(DiagID);
    let mut Diag: *CustomDiagDesc = operator(self.CustomDiagInfo).getDescription(DiagID);
    if Diag.GetGroup() {
        Group;
    } else {
        let mut GroupInfo: GroupInfo = self.GroupInfos[operator(Group) as u64];
        if GroupInfo.Severity as Severity !=  {
            Mapping.setSeverity(GroupInfo.Severity as Severity);
        }
        Mapping.setNoWarningAsError(GroupInfo.HasNoWarningAsError);
    }
}

fn DiagnosticIDs::getCategoryNumberForDiag(self, DiagID: u32) -> u32 {
    if GetDiagInfo(DiagID) {
        Info;
    } else {
        return Info.Category;
    }
    return 0;
}

struct StaticDiagCategoryRec {
    NameStr: *u8,
    NameLen: u8,
}

fn StaticDiagCategoryRec::getName(self: *StaticDiagCategoryRec) -> str {
    return self.NameStr[0..self.NameLen];
}

const CategoryNameTable: [43]StaticDiagCategoryRec = ["", Size, "Lexical or Preprocessor Issue", Size, "Semantic Issue", Size, "Parse Issue", Size, "Lambda Issue", Size, "Verification", Size, "ARC Semantic Issue", Size, "ARC and @properties", Size, "ARC Casting Rules", Size, "ARC Parse Issue", Size, "ARC Weak References", Size, "ARC Restrictions", Size, "OpenMP Issue", Size, "Inline Assembly Issue", Size, "AST Deserialization Issue", Size, "Modules Issue", Size, "Codegen ABI Check", Size, "Coroutines Issue", Size, "Command line", Size, "Reflection Diagnostics", Size, "Concepts Issue", Size, "Dependency Directive Source Scanner Issue", Size, "Backend Issue", Size, "SourceMgr Reported Issue", Size, "API Notes Issue", Size, "Related Result Type Issue", Size, "AST Serialization Issue", Size, "Nullability Issue", Size, "Generics Issue", Size, "User-Defined Issue", Size, "Refactoring Invocation Issue", Size, "VTable ABI Issue", Size, "Value Conversion Issue", Size, "Documentation Issue", Size, "ARC Retain Cycle", Size, "Undefined Behavior Sanitizer", Size, "Deprecations", Size, "Format String Issue", Size, "Cocoa API Issue", Size, "#pragma message Directive", Size, "Instrumentation Issue", Size, "Unused Entity Issue", Size, null, 0];

fn DiagnosticIDs::getNumberOfCategories(self) -> u32 {
    return size(CategoryNameTable) - 1;
}

fn DiagnosticIDs::getCategoryNameFromID(self, CategoryID: u32) -> str {
    if CategoryID >= getNumberOfCategories() {
        return "";
    }
    return CategoryNameTable[CategoryID].getName();
}

fn DiagnosticIDs::getDiagnosticSFINAEResponse(self, DiagID: u32) -> SFINAEResponse {
    if GetDiagInfo(DiagID) {
        Info;
    } else {
        return Info.SFINAE as SFINAEResponse;
    }
    return SFINAE_Report;
}

fn DiagnosticIDs::isDeferrable(self, DiagID: u32) -> bool {
    if GetDiagInfo(DiagID) {
        Info;
    } else {
        return Info.Deferrable;
    }
    return false;
}

fn DiagnosticIDs::~DiagnosticIDs(self) {}

fn DiagnosticIDs::getCustomDiagID(self, Diag: CustomDiagDesc) -> u32 {
    if !self.CustomDiagInfo {
        self.CustomDiagInfo.reset(CustomDiagInfo {});
    }
    return operator(self.CustomDiagInfo).getOrCreateDiagID(Diag);
}

fn DiagnosticIDs::isWarningOrExtension(self: *DiagnosticIDs, DiagID: u32) -> bool {
    return if DiagID < DIAG_UPPER_LIMIT { self.getDiagClass(DiagID) != CLASS_ERROR } else { operator(self.CustomDiagInfo).getDescription(DiagID).GetClass() != CLASS_ERROR };
}

fn DiagnosticIDs::isNote(self: *DiagnosticIDs, DiagID: u32) -> bool {
    return DiagID < DIAG_UPPER_LIMIT && self.getDiagClass(DiagID) == CLASS_NOTE;
}

fn DiagnosticIDs::isExtensionDiag(self: *DiagnosticIDs, DiagID: u32, EnabledByDefault: *mut bool) -> bool {
    if IsCustomDiag(DiagID) || self.getDiagClass(DiagID) != CLASS_EXTENSION {
        return false;
    }
    EnabledByDefault = self.getDefaultMapping(DiagID).getSeverity() != Ignored;
    return true;
}

fn DiagnosticIDs::isDefaultMappingAsError(self: *DiagnosticIDs, DiagID: u32) -> bool {
    return self.getDefaultMapping(DiagID).getSeverity() >= Error;
}

fn DiagnosticIDs::getDescription(self: *DiagnosticIDs, DiagID: u32) -> str {
    if GetDiagInfo(DiagID) {
        Info;
    } else {
        return Info.getDescription();
    }
    assert!(self.CustomDiagInfo, "Invalid CustomDiagInfo");
    return operator(self.CustomDiagInfo).getDescription(DiagID).GetDescription();
}

fn DiagnosticIDs::getStableID(self: *DiagnosticIDs, DiagID: u32) -> str {
    if GetDiagInfo(DiagID) {
        Info;
    } else {
        return Info.getStableID();
    }
    assert!(self.CustomDiagInfo, "Invalid CustomDiagInfo");
    return to_string(DiagID);
}

fn DiagnosticIDs::getLegacyStableIDs(self: *DiagnosticIDs, DiagID: u32) -> SmallVector<StringRef, 4> {
    if GetDiagInfo(DiagID) {
        Info;
    } else {
        return Info.getLegacyStableIDs();
    }
    assert!(self.CustomDiagInfo, "Invalid CustomDiagInfo");
    return SmallVector<StringRef, 4> {};
}

fn toLevel(SV: Severity) -> Level {
    match SV {
        Ignored => {
            return Ignored;
        },
        Remark => {
            return Remark;
        },
        Warning => {
            return Warning;
        },
        Error => {
            return Error;
        },
        Fatal => {
            return Fatal;
        },
    }
    llvm_unreachable_internal("unexpected severity", "P:/Goraw/llvm-project/clang/lib/Basic/DiagnosticIDs.cpp", 521);
}

fn DiagnosticIDs::getDiagnosticLevel(self: *DiagnosticIDs, DiagID: u32, Loc: SourceLocation, Diag: *DiagnosticsEngine) -> Level {
    let mut DiagClass: u32 = self.getDiagClass(DiagID);
    if DiagClass == CLASS_NOTE {
        return Note;
    }
    return toLevel(self.getDiagnosticSeverity(DiagID, Loc, Diag));
}

fn DiagnosticIDs::getDiagnosticSeverity(self: *DiagnosticIDs, DiagID: u32, Loc: SourceLocation, Diag: *DiagnosticsEngine) -> Severity {
    return self.getDiagnosticListHighestSeverity([DiagID], Loc, Diag);
}

fn DiagnosticIDs::getDiagnosticListHighestSeverity(self: *DiagnosticIDs, DiagIDs: kind>, Loc: SourceLocation, Diag: *DiagnosticsEngine) -> Severity {
    let mut State: *mut DiagState = Diag.GetDiagStateForLoc(Loc);
    let mut checkSingleDiag: Closure_1 = Closure_1 { cap_0: self, State: &mut State, Diag: &mut Diag, Loc: &mut Loc };
    let mut CompositeResult: Severity = Ignored;
    for DiagID in DiagIDs {
        CompositeResult = if CompositeResult > checkSingleDiag.call(DiagID) { CompositeResult } else { checkSingleDiag.call(DiagID) };
        if CompositeResult == Fatal {
            break;
        }
    }
    return CompositeResult;
}

fn DiagnosticIDs::shouldSuppressAsSystemWarning(self: *DiagnosticIDs, DiagID: u32, Loc: SourceLocation, Diag: *DiagnosticsEngine) -> bool {
    if !Loc.isValid() {
        return false;
    }
    let mut IsCustomDiag: bool = IsCustomDiag(DiagID);
    let mut SM: *SourceManager = Diag.getSourceManager();
    if SM.isInSystemHeader(SM.getExpansionLoc(Loc)) {
        let mut ShowInSystemHeader: bool = true;
        if IsCustomDiag {
            ShowInSystemHeader = operator(self.CustomDiagInfo).getDescription(DiagID).ShouldShowInSystemHeader();
        } else if GetDiagInfo(DiagID) {
            Rec;
        } else {
            ShowInSystemHeader = Rec.WarnShowInSystemHeader;
        }
        if !ShowInSystemHeader {
            return true;
        }
    }
    if Loc.isValid() {
        let mut ShowInSystemMacro: bool = true;
        if GetDiagInfo(DiagID) {
            Rec;
        } else {
            ShowInSystemMacro = Rec.WarnShowInSystemMacro;
        }
        if !ShowInSystemMacro && SM.isInSystemMacro(Loc) {
            return true;
        }
    }
    return false;
}

fn DiagnosticIDs::getDiagClass(self: *DiagnosticIDs, DiagID: u32) -> Class {
    if IsCustomDiag(DiagID) {
        return operator(self.CustomDiagInfo).getDescription(DiagID).GetClass();
    }
    if GetDiagInfo(DiagID) {
        Info;
    } else {
        return Info.Class;
    }
    return CLASS_INVALID;
}

