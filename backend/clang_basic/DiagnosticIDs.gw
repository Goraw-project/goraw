fn toLevel(SV: Severity) -> Level {
    match SV {
        Ignored => {
            return Ignored;
        },
        Remark => {
            return Remark;
        },
        Warning => {
            return Warning;
        },
        Error => {
            return Error;
        },
        Fatal => {
            return Fatal;
        },
    }
    llvm_unreachable_internal("unexpected severity", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\DiagnosticIDs.cpp", 521);
}

fn DiagnosticIDs::getDiagnosticLevel(self: *DiagnosticIDs, DiagID: u32, Loc: SourceLocation, Diag: *DiagnosticsEngine) -> Level {
    let mut DiagClass: u32 = self.getDiagClass(DiagID);
    if DiagClass == CLASS_NOTE {
        return Note;
    }
    return toLevel(self.getDiagnosticSeverity(DiagID, Loc, Diag));
}

fn DiagnosticIDs::getDiagnosticSeverity(self: *DiagnosticIDs, DiagID: u32, Loc: SourceLocation, Diag: *DiagnosticsEngine) -> Severity {
    return self.getDiagnosticListHighestSeverity;
}

