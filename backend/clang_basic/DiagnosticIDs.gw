    let mut State: *mut DiagState = Diag.GetDiagStateForLoc(Loc);
    let mut checkSingleDiag: Closure_1 = Closure_1 { cap_0: self, State: &mut State, Diag: &mut Diag, Loc: &mut Loc };
    let mut CompositeResult: Severity = Ignored;
    return CompositeResult;
}

fn DiagnosticIDs::shouldSuppressAsSystemWarning(self: *DiagnosticIDs, DiagID: u32, Loc: SourceLocation, Diag: *DiagnosticsEngine) -> bool {
    if !Loc.isValid() {
        return false;
    }
    let mut IsCustomDiag: bool = IsCustomDiag(DiagID);
    let mut SM: *SourceManager = Diag.getSourceManager();
    if SM.isInSystemHeader(SM.getExpansionLoc(Loc)) {
        let mut ShowInSystemHeader: bool = true;
        if IsCustomDiag {
            
        } else if GetDiagInfo(DiagID) {
            Rec;
        } else {
            ShowInSystemHeader = Rec.WarnShowInSystemHeader;
        }
        if !ShowInSystemHeader {
            return true;
        }
    }
    if Loc.isValid() {
        let mut ShowInSystemMacro: bool = true;
        if GetDiagInfo(DiagID) {
            Rec;
        } else {
            ShowInSystemMacro = Rec.WarnShowInSystemMacro;
        }
        if !ShowInSystemMacro && SM.isInSystemMacro(Loc) {
            return true;
        }
    }
    return false;
}

