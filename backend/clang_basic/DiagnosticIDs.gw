fn DiagnosticIDs::isUnrecoverable(self: *DiagnosticIDs, DiagID: u32) -> bool {
    if self.getDiagClass(DiagID) < CLASS_ERROR {
        return false;
    }
    if DiagID == err_unavailable || DiagID == err_unavailable_message {
        return false;
    }
    if isARCDiagnostic(DiagID) && DiagID != err_arc_may_not_respond && DiagID != err_arc_atomic_ownership {
        return false;
    }
    if isCodegenABICheckDiagnostic(DiagID) {
        return false;
    }
    return true;
}

fn DiagnosticIDs::isARCDiagnostic(self, DiagID: u32) -> bool {
    let mut cat: u32 = getCategoryNumberForDiag(DiagID);
    return getCategoryNameFromID(cat).starts_with("ARC ");
}

fn DiagnosticIDs::isCodegenABICheckDiagnostic(self, DiagID: u32) -> bool {
    let mut cat: u32 = getCategoryNumberForDiag(DiagID);
    return getCategoryNameFromID(cat) == "Codegen ABI Check";
}

struct Closure_1 {
    cap_0: *DiagnosticIDs,
    State: *mut *mut DiagState,
    Diag: *mut DiagnosticsEngine,
    Loc: *mut SourceLocation,
}

unsafe fn Closure_1::call(self: *mut Closure_1, DiagID: kind) -> auto {
        let mut IsCustomDiag: bool = IsCustomDiag(DiagID);
        assert!(self.getDiagClass(DiagID) != CLASS_NOTE);
        let mut Result: Severity = Fatal;
        let mut Mapping: DiagnosticMapping = (*self.State).getOrAddMapping(DiagID as kind);
        if Mapping.getSeverity() !=  {
            Result = Mapping.getSeverity();
        }
        if (*self.State).EnableAllWarnings && Result == Ignored && !Mapping.isUser() && (IsCustomDiag || self.getDiagClass(DiagID) != CLASS_REMARK) {
            Result = Warning;
        }
        let mut EnabledByDefault: bool = false;
        let mut IsExtensionDiag: bool = self.isExtensionDiag(DiagID, EnabledByDefault);
        if (*self.Diag).AllExtensionsSilenced && IsExtensionDiag && !EnabledByDefault {
            return Ignored;
        }
        if IsExtensionDiag && !(Mapping.isUser() && Result == Ignored) {
            if Mapping.hasNoWarningAsError() {
                Result = if Result > if (*self.State).ExtBehavior < Warning { (*self.State).ExtBehavior } else { Warning } { Result } else { if (*self.State).ExtBehavior < Warning { (*self.State).ExtBehavior } else { Warning } };
            } else {
                Result = if Result > (*self.State).ExtBehavior { Result } else { (*self.State).ExtBehavior };
            }
        }
        if Result == Ignored {
            return Result;
        }
        if (*self.State).IgnoreAllWarnings {
            if (!IsCustomDiag || operator(self.CustomDiagInfo).getDescription(DiagID).GetGroup()) && (Result == Warning || (Result >= Error && !self.isDefaultMappingAsError(DiagID as kind))) {
                return Ignored;
            }
        }
        if Result == Warning {
            if (*self.State).WarningsAsErrors && !Mapping.hasNoWarningAsError() {
                Result = Error;
            }
        }
        if Result == Error {
            if (*self.State).ErrorsAsFatal && !Mapping.hasNoErrorAsFatal() {
                Result = Fatal;
            }
        }
        if Result == Fatal && DiagID != fatal_too_many_errors && (*self.Diag).FatalsAsError {
            Result = Error;
        }
        if !(*self.Diag).hasSourceManager() {
            return Result;
        }
        if (*self.State).SuppressSystemWarnings && !(*self.Diag).getForceSystemWarnings() && self.shouldSuppressAsSystemWarning(DiagID, (*self.Loc), (*self.Diag)) {
            return Ignored;
        }
        if !Mapping.isPragma() && (*self.Diag).isSuppressedViaMapping(DiagID, (*self.Loc)) {
            return Ignored;
        }
        return Result;
    }

struct Closure_2 {
    cap_0: str,
}

fn Closure_2::call(self: *Closure_2, O: *WarningOption) -> bool {
        return O.getName() < Name;
    }

