enum DiagnosticClass {
    CLASS_NOTE = 0,
    CLASS_REMARK = 1,
    CLASS_WARNING = 2,
    CLASS_EXTENSION = 3,
    CLASS_ERROR = 4,
    CLASS_TRAP = 5,
}

struct StaticDiagInfoRec {
    DiagID: u16,
    DefaultSeverity: u16,
    Class: u16,
    SFINAE: u16,
    Category: u16,
    WarnNoWerror: u16,
    WarnShowInSystemHeader: u16,
    WarnShowInSystemMacro: u16,
    OptionGroupIndex: u16,
    Deferrable: u16,
    DescriptionLen: u16,
}

fn StaticDiagInfoRec::getOptionGroupIndex(self: *StaticDiagInfoRec) -> u32 {
    return self.OptionGroupIndex;
}

fn StaticDiagInfoRec::getDescription(self: *StaticDiagInfoRec) -> str {
    let mut MyIndex: u64 = self - &mut StaticDiagInfo[0];
    let mut StringOffset: u32 = StaticDiagInfoDescriptionOffsets[MyIndex];
    let mut Table: *u8 = &mut StaticDiagInfoDescriptions as *u8;
    return &mut Table[StringOffset][0..self.DescriptionLen];
}

fn StaticDiagInfoRec::getStableID(self: *StaticDiagInfoRec) -> str {
    let mut MyIndex: u64 = self - &mut StaticDiagInfo[0];
    let mut StringOffset: u32 = StaticDiagInfoStableIDOffsets[MyIndex];
    return DiagStableIDs[StringOffset];
}

fn StaticDiagInfoRec::getLegacyStableIDs(self: *StaticDiagInfoRec) -> SmallVector<StringRef, 4> {
    let mut Result: SmallVector<StringRef, 4> = SmallVector<StringRef, 4> {};
    let mut MyIndex: u64 = self - &mut StaticDiagInfo[0];
    let mut StartOffset: u32 = StaticDiagInfoLegacyStableIDStartOffsets[MyIndex];
    for let mut Offset: u32 = StartOffset; DiagLegacyStableIDs[Offset] != 0; Offset += 1 {
        Result.push(DiagStableIDs[DiagLegacyStableIDs[Offset]]);
    }
    return Result;
}

fn StaticDiagInfoRec::getFlavor(self: *StaticDiagInfoRec) -> Flavor {
    return if self.Class == CLASS_REMARK { Remark } else { WarningOrError };
}

fn StaticDiagInfoRec::operator<(self: *StaticDiagInfoRec, RHS: *StaticDiagInfoRec) -> bool {
    return self.DiagID < RHS.DiagID;
}

