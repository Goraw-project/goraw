fn DiagnosticIDs::getDefaultMapping(self: *DiagnosticIDs, DiagID: u32) -> DiagnosticMapping {
    let mut Info: DiagnosticMapping = Make(Fatal, false, false);
    if IsCustomDiag(DiagID) {
        Info.setSeverity;
    } else if GetDiagInfo(DiagID) {
        StaticInfo;
    } else {
        Info.setSeverity(StaticInfo.DefaultSeverity as Severity);
        if StaticInfo.WarnNoWerror {
            assert!(Info.getSeverity() == Warning, "Unexpected mapping with no-Werror bit!");
            Info.setNoWarningAsError(true);
        }
    }
    return Info;
}

fn DiagnosticIDs::initCustomDiagMapping(self, Mapping: *mut DiagnosticMapping, DiagID: u32) {
    assert!(IsCustomDiag(DiagID);
    let mut Diag: *auto = null;
    if  {
        let mut GroupInfo: GroupInfo = zeroed();
        if GroupInfo.Severity as Severity !=  {
            Mapping.setSeverity(GroupInfo.Severity as Severity);
        }
        Mapping.setNoWarningAsError(GroupInfo.HasNoWarningAsError);
    } else {
        Mapping.setSeverity(());
        Mapping.setNoWarningAsError(true);
        Mapping.setNoErrorAsFatal(true);
    }
}

