fn DiagnosticIDs::setGroupSeverity(self, Group: str, Sev: Severity) {
    if getGroupForWarningOption(Group) {
        G;
    } else {
        forEachSubGroup(operator(G), Closure_3 { cap_0: self, Sev: &mut Sev });
    }
}

fn DiagnosticIDs::setGroupNoWarningsAsError(self, Group: str, Val: bool) {
    if getGroupForWarningOption(Group) {
        G;
    } else {
        forEachSubGroup(operator(G), Closure_4 { cap_0: self, G: &mut G, Val: &mut Val });
    }
}

fn DiagnosticIDs::getAllDiagnostics(self, Flavor: Flavor, Diags: *mut []kind) {
    for let mut i: u32 = 0; i != StaticDiagInfoSize; i += 1 {
        if StaticDiagInfo[i].getFlavor() == Flavor {
            Diags.push(StaticDiagInfo[i].DiagID);
        }
    }
}

fn DiagnosticIDs::getNearestOption(self, Flavor: Flavor, Group: str) -> str {
    let mut Best: str = "";
    let mut BestDistance: u32 = Group.len + 1;
    for O in OptionTable[..] {
        if !O.Members && !O.SubGroups {
            continue;
        }
        let mut Distance: u32 = O.getName().edit_distance(Group, true, BestDistance);
        if Distance > BestDistance {
            continue;
        }
        let mut Diags: kind, 8> = kind, 8> {};
        if getDiagnosticsInGroup(Flavor, &mut O, Diags, null) || Diags.is_empty() {
            continue;
        }
        if Distance == BestDistance {
            Best = "";
        } else if Distance < BestDistance {
            Best = O.getName();
            BestDistance = Distance;
        }
    }
    return Best;
}

