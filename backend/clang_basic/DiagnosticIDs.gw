fn DiagnosticIDs::isNote(self: *DiagnosticIDs, DiagID: u32) -> bool {
    return DiagID < DIAG_UPPER_LIMIT && self.getDiagClass(DiagID) == CLASS_NOTE;
}

fn DiagnosticIDs::isExtensionDiag(self: *DiagnosticIDs, DiagID: u32, EnabledByDefault: *mut bool) -> bool {
    if IsCustomDiag(DiagID) || self.getDiagClass(DiagID) != CLASS_EXTENSION {
        return false;
    }
    EnabledByDefault = self.getDefaultMapping(DiagID).getSeverity() != Ignored;
    return true;
}

fn DiagnosticIDs::isDefaultMappingAsError(self: *DiagnosticIDs, DiagID: u32) -> bool {
    return self.getDefaultMapping(DiagID).getSeverity() >= Error;
}

