fn DiagnosticIDs::isARCDiagnostic(self, DiagID: u32) -> bool {
    let mut cat: u32 = getCategoryNumberForDiag(DiagID);
    return getCategoryNameFromID(cat)("ARC ");
}

fn DiagnosticIDs::isCodegenABICheckDiagnostic(self, DiagID: u32) -> bool {
    let mut cat: u32 = getCategoryNumberForDiag(DiagID);
    return getCategoryNameFromID(cat) == "Codegen ABI Check";
}

