        if (*self.State).SuppressSystemWarnings && !(*self.Diag).getForceSystemWarnings() && self.shouldSuppressAsSystemWarning(DiagID, (*self.Loc), (*self.Diag)) {
            return Ignored;
        }
        if !Mapping.isPragma() && (*self.Diag).isSuppressedViaMapping(DiagID, (*self.Loc)) {
            return Ignored;
        }
        return Result;
    }

