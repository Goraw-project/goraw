}

unsafe fn Closure_4::call(self: *mut Closure_4, SubGroup: u64) {
            self.GroupInfos[operator((*self.G)) as u64].HasNoWarningAsError = (*self.Val);
        }

struct Closure_5 {
    LangOpts: *mut LangOptions,
}

unsafe fn Closure_5::call(self: *mut Closure_5) -> auto {
        if !(*self.LangOpts).CPlusPlus {
            if (*self.LangOpts).C2y {
                return 2029;
            }
            if (*self.LangOpts).C23 {
                return 2023;
            }
            if (*self.LangOpts).C17 {
                return 2017;
            }
            if (*self.LangOpts).C11 {
                return 2011;
            }
            if (*self.LangOpts).C99 {
                return 1999;
            }
            return 1989;
        }
        if (*self.LangOpts).CPlusPlus29 {
            return 2029;
        }
        if (*self.LangOpts).CPlusPlus26 {
            return 2026;
        }
        if (*self.LangOpts).CPlusPlus23 {
            return 2023;
        }
        if (*self.LangOpts).CPlusPlus20 {
            return 2020;
        }
        if (*self.LangOpts).CPlusPlus17 {
            return 2017;
        }
        if (*self.LangOpts).CPlusPlus14 {
            return 2014;
        }
        if (*self.LangOpts).CPlusPlus11 {
            return 2011;
        }
        return 1998;
    }
