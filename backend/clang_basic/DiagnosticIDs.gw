fn getDiagnosticsInGroup(Flavor: Flavor, Group: *WarningOption, Diags: *mut kind>, CustomDiagInfo: *mut CustomDiagInfo) -> bool {
    if !Group.Members && !Group.SubGroups {
        return Flavor == Remark;
    }
    let mut NotFound: bool = true;
    let mut Member: *i16 = null;
    for ; *Member != -1; Member += 1 {
        if GetDiagInfo(*Member).getFlavor() == Flavor {
            NotFound = false;
            Diags()(*Member);
        }
    }
    let mut SubGroups: *i16 = null;
    for ; *SubGroups != -1 as i16; SubGroups += 1 {
        if CustomDiagInfo {
            copy(CustomDiagInfo()(*SubGroups as Group), back_inserter(Diags));
        }
        NotFound &= getDiagnosticsInGroup(Flavor, &mut OptionTable[*SubGroups as i16], Diags, CustomDiagInfo);
    }
    return NotFound;
}

fn DiagnosticIDs::getDiagnosticsInGroup(self: *DiagnosticIDs, Flavor: Flavor, Group: str, Diags: *mut kind>) -> bool {
    if  {
        if  {
            copy(back_inserter(Diags));
        }
        return getDiagnosticsInGroup(Flavor, &mut OptionTable[* as u32], Diags);
    }
    return true;
}

