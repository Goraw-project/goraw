7, 854, "", 24961, 3156, 0, "", 24989, 3158, 0, "", 25019, 3160, 0, "", 25047, 3162, 0, "Warns when objects which are supposed to be globally unique might get duplicated\nwhen built into a shared library.\n\nThis can occur to objects which are hidden from the dynamic linker, due to\nhaving hidden visibility (on posix) or lacking a dllimport/dllexport attribute\n(on windows). If such an object is built into a shared library, each instance\nof the library will get its own copy. This can cause very subtle bugs if there was\nonly supposed to be one copy of the object in question: singletons aren't single,\nchanges to one object won't affect the others, the object's initializer will run\nonce per copy, etc.\n\nSpecifically, this warning fires when it detects an object which:\n\n1. Is defined as `inline` in a header file (so it might get compiled into multiple libaries), and\n1. Has external linkage (otherwise it's supposed to be duplicated), and\n1. Has hidden visibility (posix) or lacks a dllimport/dllexport attribute (windows).\n\nAs well as one of the following:\n\n1. The object is mutable, or\n1. The object's initializer definitely has side effects.\n\nThe warning can be resolved by removing one of the conditions above. In rough\norder of preference, this may be done by:\n\n1. Marking the object `const` (if possible)\n1. Moving the object's definition to a source file\n1. Making the object visible using `__attribute((visibility(\"default\")))`,\n   `__declspec(dllimport)`, or `__declspec(dllexport)`.\n\nWhen annotating an object with `__declspec(dllimport)` or `__declspec(dllexport)`,\ntake care to ensure that the object is only exported from one dll, and is imported\neverywhere else.\n\nNote that for (2), all levels of a pointer variable must be constant;\n`const int*` will trigger the warning because the pointer itself is mutable.", 25073, 3165, 0, "", 25102, 3167, 0, "", 25119, 3171, 0, "", 25138, 3173, 0, "", 25157, 3176, 0, "", 25178, 3179, 0, "", 25197, 3181, 0, "", 25221, 3183, 0, "", 25237, 3204, 0, "", 25256, 3206, 0, "", 25279, 3210, 859, "", 25306, 3212, 0, "Warns when a `final` class contains a virtual method (including virtual\ndestructors) that does not override anything. Since `final` classes cannot\nbe subclassed, their methods cannot be overridden, so there is no point to\nintroducing new `virtual` methods.\n\nThe warning also detects virtual methods in classes whose destructor is\n`final`, for the same reason.", 25336, 3214, 0, "", 25366, 3217, 0, "", 25391, 3219, 0, "", 25417, 3221, 861, "", 25434, 0, 865, "", 25462, 3223, 0, "", 25485, 3225, 0, "", 25514, 3227, 0, "", 25545, 3229, 0, "", 25577, 3231, 0, "", 25601, 3233, 869, "", 25621, 3236, 0, "", 25654, 3238, 0, "", 25694, 3240, 0, "", 25727, 3242, 0, "", 25769, 3244, 0, "", 25804, 3246, 0, "", 25851, 3248, 0, "", 25863, 3251, 0, "", 25879, 3254, 0, "", 25895, 3257, 0, "", 25926, 3259, 0, "", 25941, 3261, 0, "", 25977, 3263, 0, "", 26008, 3266, 0, "", 26026, 3268, 0, "", 26042, 3271, 0, "", 26065, 3274, 0, "", 26088, 3276, 0, "", 26123, 3278, 0, "", 26155, 0, 876, "", 26162, 0, 0, "", 26178, 3280, 0, "", 26200, 3282, 0, "", 26225, 3284, 887, "", 26249, 3286, 0, "", 26278, 3301, 0, "", 26296, 3303, 0, "", 26318, 3305, 0, "", 26345, 3307, 889, "", 26361, 3309, 0, "", 26388, 3311, 0, "", 26401, 3313, 0, "", 26423, 3315, 0, "", 26444, 0, 891, "", 26466, 3317, 0, "", 26480, 3319, 893, "", 26503, 3321, 0, "", 26520, 3323, 0, "", 26541, 3325, 0, "", 26562, 3327, 0, "", 26576, 3329, 895, "", 26592, 3331, 897, "", 26605, 3339, 901, "", 26621, 3341, 0, "", 26644, 3343, 0, "", 26667, 3345, 0, "", 26689, 3347, 0, "", 26711, 3349, 0, "", 26719, 3354, 0, "", 26752, 3358, 0, "", 26768, 3362, 0, "", 26782, 3364, 0, "", 26800, 0, 903, "", 26819, 3367, 0, "", 26832, 3371, 0, "", 26843, 3374, 905, "", 26847, 3376, 907, "", 26865, 3379, 909, "", 26879, 3381, 0, "", 26907, 3384, 0, "", 26933, 3386, 911, "", 26958, 3388, 0, "", 26979, 0, 0, "", 27001, 3390, 0, "", 27021, 3392, 0, "", 27043, 3394, 0, "", 27056, 3396, 913, "", 27073, 0, 915, "**Note:** enabling this warning in C will change the semantic behavior of the\nprogram by treating all string literals as having type `const char *`\ninstead of `char *`. This can cause unexpected behaviors with type-sensitive\nconstructs like `_Generic`.", 27087, 3398, 0, "", 27103, 3402, 0, "", 27133, 3404, 0, ""];

fn DiagnosticIDs::getWarningOptionDocumentation(self, Group: Group) -> str {
    return OptionTable[Group as i32].Documentation;
}

fn DiagnosticIDs::getWarningOptionForGroup(self, Group: Group) -> str {
    return OptionTable[Group as i32].getName();
}

fn DiagnosticIDs::getGroupForWarningOption(self, Name: str) -> Group> {
    let mut Found: *WarningOption = partition_point(OptionTable, Closure_2 { cap_0: Name });
    if Found == end(OptionTable) || Found.getName() != Name {
        return nullopt;
    }
    return Found - OptionTable as Group;
}

fn DiagnosticIDs::getGroupForDiag(self: *DiagnosticIDs, DiagID: u32) -> Group> {
    if IsCustomDiag(DiagID) {
        assert!(self.CustomDiagInfo);
        return operator(self.CustomDiagInfo).getDescription(DiagID).GetGroup();
    }
    if GetDiagInfo(DiagID) {
        Info;
    } else {
        return Info.getOptionGroupIndex() as Group;
    }
    return nullopt;
}

fn DiagnosticIDs::getWarningOptionForDiag(self, DiagID: u32) -> str {
    if self.getGroupForDiag(DiagID) {
        G;
    } else {
        return getWarningOptionForGroup(operator(G));
    }
    return "";
}

fn DiagnosticIDs::getDiagnosticFlags(self) -> []str {
    let mut Res: []str = []str { ["-W", "-Wno-"], basic_string<char>> {} };
    for Name in DiagGroupNames {
        if Name.is_empty() {
            continue;
        }
        Res.push(("-W" + Name));
        Res.push(("-Wno-" + Name));
    }
    return Res;
}

fn getDiagnosticsInGroup(Flavor: Flavor, Group: *WarningOption, Diags: *mut kind>, CustomDiagInfo: *mut CustomDiagInfo) -> bool {
    if !Group.Members && !Group.SubGroups {
        return Flavor == Remark;
    }
    let mut NotFound: bool = true;
    let mut Member: *i16 = DiagArrays + Group.Members;
    for ; *Member != -1; Member += 1 {
        if GetDiagInfo(*Member).getFlavor() == Flavor {
            NotFound = false;
            Diags.push(*Member);
        }
    }
    let mut SubGroups: *i16 = DiagSubGroups + Group.SubGroups;
    for ; *SubGroups != -1 as i16; SubGroups += 1 {
        if CustomDiagInfo {
            copy(CustomDiagInfo.getDiagsInGroup(*SubGroups as Group), back_inserter(Diags));
        }
        NotFound &= getDiagnosticsInGroup(Flavor, &mut OptionTable[*SubGroups as i16], Diags, CustomDiagInfo);
    }
    return NotFound;
}

fn DiagnosticIDs::getDiagnosticsInGroup(self: *DiagnosticIDs, Flavor: Flavor, Group: str, Diags: *mut kind>) -> bool {
    if getGroupForWarningOption(Group) {
        G;
    } else {
        if self.CustomDiagInfo {
            copy(operator(self.CustomDiagInfo).getDiagsInGroup(operator(G)), back_inserter(Diags));
        }
        return getDiagnosticsInGroup(Flavor, &mut OptionTable[operator(G) as u32], Diags, self.CustomDiagInfo.get());
    }
    return true;
}

