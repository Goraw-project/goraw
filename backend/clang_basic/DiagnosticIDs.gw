const StaticDiagInfo: [0]StaticDiagInfoRec = [0]StaticDiagInfoRec {};

const StaticDiagInfoSize: u32 = size(StaticDiagInfo);

fn GetDiagInfo(DiagID: u32) -> *StaticDiagInfoRec {
    if DiagID >= DIAG_UPPER_LIMIT || DiagID <= DIAG_START_COMMON {
        return null;
    }
    let mut Offset: u32 = 0;
    let mut ID: u32 = DiagID - DIAG_START_COMMON - 1;
    if DiagID > DIAG_START_DRIVER {
        ID -= DIAG_START_DRIVER - DIAG_START_COMMON;
    }
    if DiagID > DIAG_START_FRONTEND {
        ID -= DIAG_START_FRONTEND - DIAG_START_DRIVER;
    }
    if DiagID > DIAG_START_CODEGEN {
        ID -= DIAG_START_CODEGEN - DIAG_START_FRONTEND;
    }
    if DiagID > DIAG_START_SERIALIZATION {
        ID -= DIAG_START_SERIALIZATION - DIAG_START_CODEGEN;
    }
    if DiagID > DIAG_START_LEX {
        ID -= DIAG_START_LEX - DIAG_START_SERIALIZATION;
    }
    if DiagID > DIAG_START_PARSE {
        ID -= DIAG_START_PARSE - DIAG_START_LEX;
    }
    if DiagID > DIAG_START_AST {
        ID -= DIAG_START_AST - DIAG_START_PARSE;
    }
    if DiagID > DIAG_START_COMMENT {
        ID -= DIAG_START_COMMENT - DIAG_START_AST;
    }
    if DiagID > DIAG_START_CROSSTU {
        ID -= DIAG_START_CROSSTU - DIAG_START_COMMENT;
    }
    if DiagID > DIAG_START_SEMA {
        ID -= DIAG_START_SEMA - DIAG_START_CROSSTU;
    }
    if DiagID > DIAG_START_ANALYSIS {
        ID -= DIAG_START_ANALYSIS - DIAG_START_SEMA;
    }
    if DiagID > DIAG_START_REFACTORING {
        ID -= DIAG_START_REFACTORING - DIAG_START_ANALYSIS;
    }
    if DiagID > DIAG_START_INSTALLAPI {
        ID -= DIAG_START_INSTALLAPI - DIAG_START_REFACTORING;
    }
    if DiagID > DIAG_START_TRAP {
        ID -= DIAG_START_TRAP - DIAG_START_INSTALLAPI;
    }
    if ID + Offset >= StaticDiagInfoSize {
        return null;
    }
    assert!(ID < StaticDiagInfoSize && Offset < StaticDiagInfoSize);
    let mut Found: *StaticDiagInfoRec = &mut StaticDiagInfo[ID + Offset];
    if Found.DiagID != DiagID {
        return null;
    }
    return Found;
}

