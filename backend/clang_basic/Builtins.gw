        ARM_ACLE_H => {
            return "arm_acle.h";
        },
        BLOCKS_H => {
            return "Blocks.h";
        },
        COMPLEX_H => {
            return "complex.h";
        },
        CTYPE_H => {
            return "ctype.h";
        },
        EMMINTRIN_H => {
            return "emmintrin.h";
        },
        FOUNDATION_NSOBJCRUNTIME_H => {
            return "Foundation/NSObjCRuntime.h";
        },
        IMMINTRIN_H => {
            return "immintrin.h";
        },
        INTRIN_H => {
            return "intrin.h";
        },
        MALLOC_H => {
            return "malloc.h";
        },
        MATH_H => {
            return "math.h";
        },
        MEMORY => {
            return "memory";
        },
        MMINTRIN_H => {
            return "mmintrin.h";
        },
        OBJC_MESSAGE_H => {
            return "objc/message.h";
        },
        OBJC_OBJC_AUTO_H => {
            return "objc/objc-auto.h";
        },
        OBJC_OBJC_EXCEPTION_H => {
            return "objc/objc-exception.h";
        },
        OBJC_OBJC_SYNC_H => {
            return "objc/objc-sync.h";
        },
        OBJC_RUNTIME_H => {
            return "objc/runtime.h";
        },
        POLL_H => {
            return "poll.h";
        },
        PTHREAD_H => {
            return "pthread.h";
        },
        SETJMPEX_H => {
            return "setjmpex.h";
        },
        SETJMP_H => {
            return "setjmp.h";
        },
        STDBIT_H => {
            return "stdbit.h";
        },
        STDARG_H => {
            return "stdarg.h";
        },
        STDIO_H => {
            return "stdio.h";
        },
        STDLIB_H => {
            return "stdlib.h";
        },
        STRINGS_H => {
            return "strings.h";
        },
        STRING_H => {
            return "string.h";
        },
        SYS_SOCKET_H => {
            return "sys/socket.h";
        },
        SYS_STAT_H => {
            return "sys/stat.h";
