fn Context::getShardAndInfo(self: *Context, ID: u32) -> Info &> {
    assert!((ID < (FirstTSBuiltin + self.NumTargetBuiltins + self.NumAuxTargetBuiltins)), "Invalid builtin ID!");
    let mut Shards: ArrayRef<InfosShard> = self.BuiltinShards;
    if self.isAuxBuiltinID(ID) {
        Shards = self.AuxTargetShards;
        ID = self.getAuxBuiltinID(ID) - FirstTSBuiltin;
    } else if ID >= FirstTSBuiltin {
        Shards = self.TargetShards;
        ID -= FirstTSBuiltin;
    }
    for Shard in Shards {
        if ID < Shard.Infos.len {
            return Info &> { Shard, Shard.Infos[ID] };
        }
        ID -= Shard.Infos.len;
    }
    llvm_unreachable_internal("Invalid target builtin shard structure!", "P:/Goraw/llvm-project/clang/lib/Basic/Builtins.cpp", 72);
}

fn getBuiltinNameInto(Shard: *InfosShard, BuiltinInfo: *Info, Buf: *mut SmallVectorImpl<char>) -> str {
    let mut Name: str = (*Shard.Strings)[BuiltinInfo.Offsets.Name];
    if Shard.NamePrefix.is_empty() {
        return Name;
    }
    Buf.assign(Shard.NamePrefix.begin(), Shard.NamePrefix.end());
    Buf.append(Name.begin(), Name.end());
    return Buf.ptr[0..Buf.len];
}

fn Info::getName(self: *Info, Shard: *InfosShard) -> str {
    let mut Buf: str = "";
    return getBuiltinNameInto(Shard, *self, Buf);
}

fn Context::getName(self: *Context, ID: u32) -> str {
    return I.getName(Shard);
}

fn Context::getQuotedName(self: *Context, ID: u32) -> str {
    return ("'" + Shard.NamePrefix + (*Shard.Strings)[I.Offsets.Name] + "'");
}

fn Context::getTypeString(self: *Context, ID: u32) -> *u8 {
    return (*Shard.Strings)[I.Offsets.Type].ptr;
}

fn Context::getAttributesString(self: *Context, ID: u32) -> *u8 {
    return (*Shard.Strings)[I.Offsets.Attributes].ptr;
}

fn Context::getRequiredFeatures(self: *Context, ID: u32) -> *u8 {
    return (*Shard.Strings)[I.Offsets.Features].ptr;
}

fn Context::InitializeTarget(self, Target: *TargetInfo, AuxTarget: *TargetInfo) {
    assert!(self.TargetShards.is_empty(), "Already initialized target?");
    assert!(self.NumTargetBuiltins == 0, "Already initialized target?");
    self.TargetShards = Target.getTargetBuiltins();
    for Shard in self.TargetShards {
        self.NumTargetBuiltins += Shard.Infos.len;
    }
    if AuxTarget {
        self.AuxTargetShards = AuxTarget.getTargetBuiltins();
        for Shard in self.AuxTargetShards {
            self.NumAuxTargetBuiltins += Shard.Infos.len;
        }
    }
}

fn Context::isBuiltinFunc(self, FuncName: str) -> bool {
    let mut InStdNamespace: bool = FuncName.consume_front("std-");
    for Shard in [InfosShard { Strings: &mut BuiltinStrings, Infos: BuiltinInfos, NamePrefix: "" }] {
        let mut FuncNameSuffix: str = FuncName;
        if FuncNameSuffix.consume_front(Shard.NamePrefix) {
            for I in Shard.Infos {
                if FuncNameSuffix == (*Shard.Strings)[I.Offsets.Name] && strchr((*Shard.Strings)[I.Offsets.Attributes].ptr, 'z') as bool == InStdNamespace {
                    return strchr((*Shard.Strings)[I.Offsets.Attributes].ptr, 'f') != null;
                }
            }
        }
    }
    return false;
}

fn builtinIsSupported(Strings: *StringTable, BuiltinInfo: *Info, LangOpts: *LangOptions) -> bool {
    let mut AttributesStr: str = Strings[BuiltinInfo.Offsets.Attributes];
    if LangOpts.NoBuiltin && strchr(AttributesStr.ptr, 'f') != null {
        return false;
    }
    if !LangOpts.Coroutines && (BuiltinInfo.Langs & COR_LANG) {
        return false;
    }
    if LangOpts.NoMathBuiltin && BuiltinInfo.Header.ID == MATH_H {
        return false;
    }
    if !LangOpts.GNUMode && (BuiltinInfo.Langs & GNU_LANG) {
        return false;
    }
    if !LangOpts.MicrosoftExt && (BuiltinInfo.Langs & MS_LANG) {
        return false;
    }
    if !LangOpts.HLSL && (BuiltinInfo.Langs & HLSL_LANG) {
        return false;
    }
    if !LangOpts.ObjC && BuiltinInfo.Langs == OBJC_LANG {
        return false;
    }
    if !LangOpts.OpenCL && (BuiltinInfo.Langs & ALL_OCL_LANGUAGES) {
        return false;
    }
    if !LangOpts.OpenCLGenericAddressSpace && (BuiltinInfo.Langs & OCL_GAS) {
        return false;
    }
    if !LangOpts.OpenCLPipes && (BuiltinInfo.Langs & OCL_PIPE) {
        return false;
    }
    if (LangOpts.getOpenCLCompatibleVersion() < 200 || !LangOpts.Blocks) && (BuiltinInfo.Langs & OCL_DSE) {
        return false;
    }
    if !LangOpts.OpenMP && BuiltinInfo.Langs == OMP_LANG {
        return false;
    }
    if !LangOpts.CUDA && BuiltinInfo.Langs == CUDA_LANG {
        return false;
    }
    if !LangOpts.CPlusPlus && BuiltinInfo.Langs == CXX_LANG {
        return false;
    }
    if !LangOpts.CPlusPlus20 && strchr(AttributesStr.ptr, 'G') != null {
        return false;
    }
    if !LangOpts.C23 && BuiltinInfo.Langs == C23_LANG {
        return false;
    }
    if !LangOpts.C2y && BuiltinInfo.Langs == C2Y_LANG {
        return false;
    }
    return true;
}

fn isBuiltinConstForTriple(BuiltinID: u32, Trip: Triple) -> bool {
    match BuiltinID {
        BI__builtin_fma => {
            BI__builtin_fmaf;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn Context::shouldGenerateFPMathIntrinsic(self: *Context, BuiltinID: u32, Trip: Triple, ErrnoOverwritten: optional<bool>, MathErrnoEnabled: bool, HasOptNoneAttr: bool, IsOptimizationEnabled: bool) -> bool {
    let mut ErrnoOverridenToFalseWithOpt: bool = ErrnoOverwritten.has_value() && !ErrnoOverwritten.value() && !HasOptNoneAttr && IsOptimizationEnabled;
    let mut ConstAlways: bool = self.isConst(BuiltinID) || isBuiltinConstForTriple(BuiltinID, Trip);
    let mut ConstWithoutErrnoAndExceptions: bool = self.isConstWithoutErrnoAndExceptions(BuiltinID);
    let mut ConstWithoutExceptions: bool = self.isConstWithoutExceptions(BuiltinID);
    let mut ConstWithoutErrnoOrExceptions: bool = ConstWithoutErrnoAndExceptions || ConstWithoutExceptions;
    let mut GenerateIntrinsics: bool = (ConstAlways && !HasOptNoneAttr) || (!MathErrnoEnabled && !(ErrnoOverwritten.has_value() && ErrnoOverwritten.value()) && !HasOptNoneAttr);
    if !GenerateIntrinsics {
        GenerateIntrinsics = ConstWithoutErrnoOrExceptions && !ConstWithoutErrnoAndExceptions;
        if !GenerateIntrinsics {
            GenerateIntrinsics = ConstWithoutErrnoOrExceptions && (!MathErrnoEnabled && !(ErrnoOverwritten.has_value() && ErrnoOverwritten.value()) && !HasOptNoneAttr);
        }
        if !GenerateIntrinsics {
            GenerateIntrinsics = ConstWithoutErrnoOrExceptions && ErrnoOverridenToFalseWithOpt;
        }
    }
    return GenerateIntrinsics;
}

fn Context::initializeBuiltins(self, Table: *mut IdentifierTable, LangOpts: *LangOptions) {
    {
        let mut ID: u32 = 0;
        let mut NameBuf: str = "";
        for Shard in self.BuiltinShards {
            for I in Shard.Infos {
                if ID != 0 && builtinIsSupported(*Shard.Strings, I, LangOpts) {
                    Table.get(getBuiltinNameInto(Shard, I, NameBuf)).setBuiltinID(ID);
                }
                ID += 1;
            }
        }
        assert!(ID == FirstTSBuiltin, "Should have added all non-target IDs!");
        for Shard in self.TargetShards {
            for I in Shard.Infos {
                if builtinIsSupported(*Shard.Strings, I, LangOpts) {
                    Table.get(getBuiltinNameInto(Shard, I, NameBuf)).setBuiltinID(ID);
                }
                ID += 1;
            }
        }
        for Shard in self.AuxTargetShards {
            for I in Shard.Infos {
                Table.get(getBuiltinNameInto(Shard, I, NameBuf)).setBuiltinID(ID);
                ID += 1;
            }
        }
    }
    for Name in LangOpts.NoBuiltinFuncs {
        let mut InStdNamespace: bool = Name.consume_front("std-");
        let mut NameIt: iterator = Table.find(Name);
        if NameIt != Table.end() {
            let mut ID: u32 = operator(NameIt).second.getBuiltinID();
            if ID != NotBuiltin && self.isPredefinedLibFunction(ID) && self.isInStdNamespace(ID) == InStdNamespace {
                operator(NameIt).second.clearBuiltinID();
            }
        }
    }
}

fn Context::getRequiredVectorWidth(self: *Context, ID: u32) -> u32 {
    let mut WidthPos: *u8 = strchr(self.getAttributesString(ID), 'V');
    if !WidthPos {
        return 0;
    }
    WidthPos += 1;
    assert!(*WidthPos == ':', "Vector width specifier must be followed by a ':'");
    WidthPos += 1;
    let mut EndPos: *mut u8 = null;
    let mut Width: u32 = strtol(WidthPos, &mut EndPos, 10);
    assert!(*EndPos == ':', "Vector width specific must end with a ':'");
    return Width;
}

fn Context::isLike(self: *Context, ID: u32, FormatIdx: *mut u32, HasVAListArg: *mut bool, Fmt: *u8) -> bool {
    assert!(Fmt, "Not passed a format string");
    assert!(strlen(Fmt) == 2, "Format string needs to be two characters long");
    assert!(toupper(Fmt[0]) == Fmt[1], "Format string is not in the form \"xX\"");
    let mut Like: *u8 = strpbrk(self.getAttributesString(ID), Fmt);
    if !Like {
        return false;
    }
    HasVAListArg = (*Like == Fmt[1]);
    Like += 1;
    assert!(*Like == ':', "Format specifier must be followed by a ':'");
    Like += 1;
    assert!(strchr(Like, ':'), "Format specifier must end with a ':'");
    FormatIdx = strtol(Like, null, 10);
    return true;
}

fn Context::isPrintfLike(self, ID: u32, FormatIdx: *mut u32, HasVAListArg: *mut bool) -> bool {
    return self.isLike(ID, FormatIdx, HasVAListArg, "pP");
}

fn Context::isScanfLike(self, ID: u32, FormatIdx: *mut u32, HasVAListArg: *mut bool) -> bool {
    return self.isLike(ID, FormatIdx, HasVAListArg, "sS");
}

fn parseCommaSeparatedIndices(CurrPos: *u8, Indxs: *mut SmallVectorImpl<int>) {
    assert!(*CurrPos == '<', "Expected '<' to start index list");
    CurrPos += 1;
    let mut EndPos: *mut u8 = null;
    let mut PosIdx: i32 = strtol(CurrPos, &mut EndPos, 10);
    assert!(PosIdx >= 0, "Index is supposed to be positive!");
    Indxs.push(PosIdx);
    while *EndPos == ',' {
        let mut PayloadPos: *u8 = EndPos + 1;
        let mut PayloadIdx: i32 = strtol(PayloadPos, &mut EndPos, 10);
        Indxs.push(PayloadIdx);
    }
    assert!(*EndPos == '>', "Index list must end with '>'");
}

fn Context::isNonNull(self: *Context, ID: u32, Indxs: *mut SmallVectorImpl<int>, Mode: *mut NonNullMode) -> bool {
    let mut AttrPos: *u8 = strchr(self.getAttributesString(ID), 'N');
    if !AttrPos {
        return false;
    }
    AttrPos += 1;
    assert!(*AttrPos == ':', "Format specifier must be followed by a ':'");
    AttrPos += 1;
    if *AttrPos == '0' {
        Mode = NonOptimizing;
    } else if *AttrPos == '1' {
        Mode = Optimizing;
    } else {
        llvm_unreachable_internal("Unrecognized NonNull optimization mode", "P:/Goraw/llvm-project/clang/lib/Basic/Builtins.cpp", 439);
    }
    AttrPos += 1;
    assert!(*AttrPos == ':', "Mode must be followed by a ':'");
    AttrPos += 1;
    parseCommaSeparatedIndices(AttrPos, Indxs);
    return true;
}

fn Context::performsCallback(self: *Context, ID: u32, Encoding: *mut SmallVectorImpl<int>) -> bool {
    let mut CalleePos: *u8 = strchr(self.getAttributesString(ID), 'C');
    if !CalleePos {
        return false;
    }
    CalleePos += 1;
    parseCommaSeparatedIndices(CalleePos, Encoding);
    return true;
}

fn Context::canBeRedeclared(self: *Context, ID: u32) -> bool {
    return ID == NotBuiltin || ID == BI__va_start || ID == BI__builtin_assume_aligned || (!self.hasReferenceArgsOrResult(ID) && !self.hasCustomTypechecking(ID)) || self.isInStdNamespace(ID);
}

fn evaluateRequiredTargetFeatures(RequiredFeatures: str, TargetFetureMap: *StringMap<bool>) -> bool {
    if RequiredFeatures.is_empty() {
        return true;
    }
    assert!(!RequiredFeatures.contains(' '), "Space in feature list");
    let mut TF: TargetFeatures = TargetFetureMap;
    return TF.hasRequiredFeatures(RequiredFeatures);
}
