        },
    }
    llvm_unreachable_internal("Unknown HeaderDesc::HeaderID enum", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\Builtins.cpp", 30);
}

const NumBuiltins: u32 = FirstTSBuiltin;

const BuiltinInfos: [1]Info = [Info { Offsets: StrOffsets { Offset {}, Offset {}, Offset {}, Offset {} }, Header: NO_HEADER, Langs: ALL_LANGUAGES }];

fn Context::getShardAndInfo(self: *Context, ID: u32) -> Info &> {
    assert!((ID < (FirstTSBuiltin + self.NumTargetBuiltins + self.NumAuxTargetBuiltins)), "Invalid builtin ID!");
    let mut Shards: ArrayRef<InfosShard> = zeroed();
    if self.isAuxBuiltinID(ID) {
        ID = self.getAuxBuiltinID(ID) - FirstTSBuiltin;
    } else if ID >= FirstTSBuiltin {
        ID -= FirstTSBuiltin;
    }
    llvm_unreachable_internal("Invalid target builtin shard structure!", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\Builtins.cpp", 72);
}

fn getBuiltinNameInto(Shard: *InfosShard, BuiltinInfo: *Info, Buf: *mut SmallVectorImpl<char>) -> str {
    let mut Name: str = (*Shard.Strings)[BuiltinInfo.Offsets.Name];
    if Shard()() {
        return Name;
    }
    Buf()(Shard()(), Shard()());
    Buf()(Name.begin(), Name.end());
    return Buf()();
}

fn Info::getName(self: *Info, Shard: *InfosShard) -> str {
    let mut Buf: str = zeroed();
    return getBuiltinNameInto(Shard, *self)();
}

