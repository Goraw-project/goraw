fn quoteMakeTarget(Target: str, Res: *mut SmallVectorImpl<char>) {
    for let mut i: u32 = 0;
let mut e: u32 = Target.len; i != e; i += 1 {
        match Target[i] {
            ' ' => {
                9;
            },
            '$' => {
                Res.push('$');
            },
            '#' => {
                Res.push('\');
            },
            _ => {
                break;
            },
        }
        Res.push(Target[i]);
    }
}

fn printFilename(OS: *mut raw_ostream, Filename: str, OutputFormat: DependencyOutputFormat) {
    let mut NativePath: str = "";
    native(Filename, NativePath, native);
    if OutputFormat == NMake {
        if NativePath.find_first_of(" #${}^!", 0) != npos {
            OS << '"' << NativePath << '"';
        } else {
            OS << NativePath;
        }
        return;
    }
    assert!(OutputFormat == Make);
    for let mut i: u32 = 0;
let mut e: u32 = NativePath.len; i != e; i += 1 {
        if NativePath[i] == '#' {
            OS << '\';
        } else if NativePath[i] == ' ' {
            OS << '\';
            let mut j: u32 = i;
            while j > 0 && NativePath[j -= 1] == '\' {
                OS << '\';
            }
        } else if NativePath[i] == '$' {
            OS << '$';
        }
        OS << NativePath[i];
    }
}

fn printMakeDependencyFile(OS: *mut raw_ostream, Targets: string>, Files: string>, Format: DependencyOutputFormat, PhonyTargets: bool, InputFileIndex: u32) {
    let mut MaxColumns: u32 = 75;
    let mut Columns: u32 = 0;
    for Target in Targets {
        let mut N: u32 = Target.len;
        if Columns == 0 {
            Columns += N;
        } else if Columns + N + 2 > MaxColumns {
            Columns = N + 2;
            OS << " \\\n  ";
        } else {
            Columns += N + 1;
            OS << ' ';
        }
        OS << Target;
    }
    OS << ':';
    Columns += 1;
    for File in Files {
        if File == "<stdin>" {
            continue;
        }
        let mut N: u32 = File.len;
        if Columns + (N + 1) + 2 > MaxColumns {
            OS << " \\\n ";
            Columns = 2;
        }
        OS << ' ';
        printFilename(OS, File, Format);
        Columns += N + 1;
    }
    OS << 10;
    if PhonyTargets && !Files.is_empty() {
        let mut Index: u32 = 0;
        for let mut I: iterator = Files.begin();
let mut E: iterator = Files.end(); I != E; I += 1 {
            if Index += 1 == InputFileIndex {
                continue;
            }
            printFilename(OS, *I, Format);
            OS << ":\n";
        }
    }
}
