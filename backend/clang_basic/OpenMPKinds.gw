                    return "lower_bound";
                },
                OMPC_NUMTEAMS_dims => {
                    return "dims";
                },
            }
        },
        OMPC_thread_limit => {
            match Type {
                OMPC_THREADLIMIT_unknown => {
                    return "unknown";
                },
                OMPC_THREADLIMIT_dims => {
                    return "dims";
                },
            }
        },
        OMPC_allocate => {
            match Type {
                OMPC_ALLOCATE_unknown => {
                    return "unknown";
                },
                OMPC_ALLOCATE_allocator => {
                    return "allocator";
                },
                OMPC_ALLOCATE_align => {
                    return "align";
                },
            }
        },
        OMPC_num_threads => {
            match Type {
                OMPC_NUMTHREADS_unknown => {
                    return "unknown";
                },
                OMPC_NUMTHREADS_strict => {
                    return "strict";
                },
                OMPC_NUMTHREADS_dims => {
                    return "dims";
                },
            }
        },
        OMPC_threadset => {
            match Type {
                OMPC_THREADSET_unknown => {
                    return "unknown";
                },
                OMPC_THREADSET_omp_pool => {
                    return "omp_pool";
                },
                OMPC_THREADSET_omp_team => {
                    return "omp_team";
                },
            }
        },
        OMPC_use_device_ptr => {
            match Type {
                OMPC_USE_DEVICE_PTR_FALLBACK_unknown => {
                    return "unknown";
                },
                OMPC_USE_DEVICE_PTR_FALLBACK_fb_nullify => {
                    return "fb_nullify";
                },
                OMPC_USE_DEVICE_PTR_FALLBACK_fb_preserve => {
                    return "fb_preserve";
                },
            }
        },
        OMPC_unknown => {
            OMPC_threadprivate;
        },
        _ => {
            break;
        },
    }
    llvm_unreachable_internal("Invalid OpenMP simple clause kind", "P:/Goraw/llvm-project/clang/lib/Basic/OpenMPKinds.cpp", 735);
}

fn isOpenMPLoopDirective(DKind: OpenMPDirectiveKind) -> bool {
    return getDirectiveAssociation(DKind) == LoopNest;
}

fn isOpenMPWorksharingDirective(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_for || DKind == OMPD_for_simd || DKind == OMPD_sections || DKind == OMPD_section || DKind == OMPD_single || DKind == OMPD_parallel_for || DKind == OMPD_parallel_for_simd || DKind == OMPD_parallel_sections || DKind == OMPD_target_parallel_for || DKind == OMPD_distribute_parallel_for || DKind == OMPD_distribute_parallel_for_simd || DKind == OMPD_target_parallel_for_simd || DKind == OMPD_teams_distribute_parallel_for_simd || DKind == OMPD_teams_distribute_parallel_for || DKind == OMPD_target_teams_distribute_parallel_for || DKind == OMPD_target_teams_distribute_parallel_for_simd || DKind == OMPD_parallel_loop || DKind == OMPD_teams_loop || DKind == OMPD_target_parallel_loop || DKind == OMPD_target_teams_loop;
}

fn isOpenMPTaskLoopDirective(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_taskloop || is_contained(getLeafConstructs(DKind), OMPD_taskloop);
}

fn isOpenMPParallelDirective(DKind: OpenMPDirectiveKind) -> bool {
    if DKind == OMPD_teams_loop {
        return true;
    }
    return DKind == OMPD_parallel || is_contained(getLeafConstructs(DKind), OMPD_parallel);
}

fn isOpenMPTargetExecutionDirective(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_target || is_contained(getLeafConstructs(DKind), OMPD_target);
}

fn isOpenMPTargetDataManagementDirective(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_target_data || DKind == OMPD_target_enter_data || DKind == OMPD_target_exit_data || DKind == OMPD_target_update;
}

fn isOpenMPTargetMapEnteringDirective(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_target_data || DKind == OMPD_target_enter_data || isOpenMPTargetExecutionDirective(DKind);
}

fn isOpenMPNestingTeamsDirective(DKind: OpenMPDirectiveKind) -> bool {
    if DKind == OMPD_teams {
        return true;
    }
    let mut Leaves: ArrayRef<Directive> = getLeafConstructs(DKind);
    return !Leaves.is_empty() && Leaves.front() == OMPD_teams;
}

fn isOpenMPTeamsDirective(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_teams || is_contained(getLeafConstructs(DKind), OMPD_teams);
}

fn isOpenMPSimdDirective(DKind: OpenMPDirectiveKind) -> bool {
    if getDirectiveAssociation(DKind) != LoopNest {
        return false;
    }
    return DKind == OMPD_simd || is_contained(getLeafConstructs(DKind), OMPD_simd);
}

fn isOpenMPNestingDistributeDirective(Kind: OpenMPDirectiveKind) -> bool {
    if Kind == OMPD_distribute {
        return true;
    }
    let mut Leaves: ArrayRef<Directive> = getLeafConstructs(Kind);
    return !Leaves.is_empty() && Leaves.front() == OMPD_distribute;
}

fn isOpenMPDistributeDirective(Kind: OpenMPDirectiveKind) -> bool {
    return Kind == OMPD_distribute || is_contained(getLeafConstructs(Kind), OMPD_distribute);
}

fn isOpenMPGenericLoopDirective(Kind: OpenMPDirectiveKind) -> bool {
    if Kind == OMPD_loop {
        return true;
    }
    let mut Leaves: ArrayRef<Directive> = getLeafConstructs(Kind);
    return !Leaves.is_empty() && Leaves.back() == OMPD_loop;
}

fn isOpenMPPrivate(Kind: OpenMPClauseKind) -> bool {
    return Kind == OMPC_private || Kind == OMPC_firstprivate || Kind == OMPC_lastprivate || Kind == OMPC_linear || Kind == OMPC_reduction || Kind == OMPC_task_reduction || Kind == OMPC_in_reduction;
}

fn isOpenMPThreadPrivate(Kind: OpenMPClauseKind) -> bool {
    return Kind == OMPC_threadprivate || Kind == OMPC_copyin;
}

fn isOpenMPTaskingDirective(Kind: OpenMPDirectiveKind) -> bool {
    return Kind == OMPD_task || isOpenMPTaskLoopDirective(Kind);
}

fn isOpenMPLoopBoundSharingDirective(Kind: OpenMPDirectiveKind) -> bool {
    return Kind == OMPD_distribute_parallel_for || Kind == OMPD_distribute_parallel_for_simd || Kind == OMPD_teams_distribute_parallel_for_simd || Kind == OMPD_teams_distribute_parallel_for || Kind == OMPD_target_teams_distribute_parallel_for || Kind == OMPD_target_teams_distribute_parallel_for_simd || Kind == OMPD_teams_loop || Kind == OMPD_target_teams_loop;
}

fn isOpenMPCanonicalLoopNestTransformationDirective(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_tile || DKind == OMPD_unroll || DKind == OMPD_reverse || DKind == OMPD_split || DKind == OMPD_interchange || DKind == OMPD_stripe || DKind == OMPD_flatten;
}

fn isOpenMPCanonicalLoopSequenceTransformationDirective(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_fuse;
}

fn isOpenMPLoopTransformationDirective(DKind: OpenMPDirectiveKind) -> bool {
    return isOpenMPCanonicalLoopNestTransformationDirective(DKind) || isOpenMPCanonicalLoopSequenceTransformationDirective(DKind);
}

fn isOpenMPCombinedParallelADirective(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_parallel_for || DKind == OMPD_parallel_for_simd || DKind == OMPD_parallel_master || DKind == OMPD_parallel_master_taskloop || DKind == OMPD_parallel_master_taskloop_simd || DKind == OMPD_parallel_sections;
}

fn needsTaskBasedThreadLimit(DKind: OpenMPDirectiveKind) -> bool {
    return DKind == OMPD_target || DKind == OMPD_target_parallel || DKind == OMPD_target_parallel_for || DKind == OMPD_target_parallel_for_simd || DKind == OMPD_target_simd || DKind == OMPD_target_parallel_loop;
}

fn isOpenMPExecutableDirective(DKind: OpenMPDirectiveKind) -> bool {
    if DKind == OMPD_error {
        return true;
    }
    let mut Cat: Category = getDirectiveCategory(DKind);
    return Cat == Executable || Cat == Subsidiary;
}

fn isOpenMPInformationalDirective(DKind: OpenMPDirectiveKind) -> bool {
    if DKind == OMPD_error {
        return true;
    }
    let mut Cat: Category = getDirectiveCategory(DKind);
    return Cat == Informational;
}

fn isOpenMPCapturingDirective(DKind: OpenMPDirectiveKind) -> bool {
    if isOpenMPExecutableDirective(DKind) {
        match DKind {
            OMPD_atomic => {
                OMPD_barrier;
            },
            _ => {
                return !isOpenMPLoopTransformationDirective(DKind);
            },
        }
    }
    match DKind {
        OMPD_metadirective => {
            OMPD_nothing;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn isOpenMPOrderConcurrentNestableDirective(DKind: OpenMPDirectiveKind, LangOpts: *LangOptions) -> bool {
    if DKind == OMPD_loop || DKind == OMPD_parallel || DKind == OMPD_simd || isOpenMPCombinedParallelADirective(DKind) {
        return true;
    }
    if LangOpts.OpenMP >= 60 {
        return DKind == OMPD_atomic || isOpenMPLoopTransformationDirective(DKind);
    }
    return false;
}

fn getOpenMPCaptureRegions(CaptureRegions: *mut SmallVectorImpl<OpenMPDirectiveKind>, DKind: OpenMPDirectiveKind) {
    assert!(DKind < Directive_enumSize);
    assert!(isOpenMPCapturingDirective(DKind), "Expecting capturing directive");
    let mut GetRegionsForLeaf: Closure_1 = Closure_1 { CaptureRegions: &mut CaptureRegions };
    let mut MayNeedUnknownRegion: bool = false;
    for L in getLeafConstructsOrSelf(DKind) {
        MayNeedUnknownRegion |= GetRegionsForLeaf.call(L);
    }
    if CaptureRegions.is_empty() && MayNeedUnknownRegion {
        CaptureRegions.push(OMPD_unknown);
    }
    assert!((CaptureRegions[0] == OMPD_unknown || !is_contained(CaptureRegions, OMPD_unknown)), "Misplaced OMPD_unknown");
}

fn checkFailClauseParameter(FailClauseParameter: OpenMPClauseKind) -> bool {
    return FailClauseParameter == OMPC_acquire || FailClauseParameter == OMPC_relaxed || FailClauseParameter == OMPC_seq_cst;
}

struct Closure_1 {
    CaptureRegions: *mut SmallVectorImpl<OpenMPDirectiveKind>,
}

unsafe fn Closure_1::call(self: *mut Closure_1, LKind: OpenMPDirectiveKind) -> bool {
        assert!(isLeafConstruct(LKind), "Epecting leaf directive");
        match LKind {
            OMPD_metadirective => {
                (*self.CaptureRegions).push(OMPD_metadirective);
            },
            OMPD_nothing => {
                (*self.CaptureRegions).push(OMPD_nothing);
            },
            OMPD_parallel => {
                (*self.CaptureRegions).push(OMPD_parallel);
            },
            OMPD_target => {
                (*self.CaptureRegions).push(OMPD_task);
            },
            OMPD_task => {
                OMPD_target_enter_data;
            },
            OMPD_teams => {
                (*self.CaptureRegions).push(OMPD_teams);
            },
            OMPD_taskloop => {
                (*self.CaptureRegions).push(OMPD_taskloop);
            },
            OMPD_loop => {
                if !(*self.CaptureRegions).is_empty() && !is_contained((*self.CaptureRegions), OMPD_parallel) {
                    (*self.CaptureRegions).push(OMPD_parallel);
                } else {
                    return true;
                }
            },
            OMPD_dispatch => {
                OMPD_distribute;
            },
            OMPD_masked => {
                OMPD_master;
            },
            _ => {
                errs() << getOpenMPDirectiveName(LKind, FallbackVersion) << 10;
            },
        }
        return false;
    }
