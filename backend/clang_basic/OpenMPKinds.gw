fn getOpenMPDefaultVariableCategory(Str: str, LangOpts: *LangOptions) -> OpenMPDefaultClauseVariableCategory {
    return Str.Case("aggregate", OMPC_DEFAULT_VC_aggregate).Case("all", OMPC_DEFAULT_VC_all).Case("pointer", OMPC_DEFAULT_VC_pointer).Case("scalar", OMPC_DEFAULT_VC_scalar).Default(OMPC_DEFAULT_VC_unknown);
}

fn getOpenMPDefaultVariableCategoryName(VC: u32) -> *u8 {
    match VC {
        OMPC_DEFAULT_VC_aggregate => {
            return "aggregate";
        },
        OMPC_DEFAULT_VC_all => {
            return "all";
        },
        OMPC_DEFAULT_VC_pointer => {
            return "pointer";
        },
        OMPC_DEFAULT_VC_scalar => {
            return "scalar";
        },
    }
    llvm_unreachable_internal("Invalid Variable Category in the default clause", "P:/Goraw/llvm-project/clang/lib/Basic/OpenMPKinds.cpp", 40);
}

fn getOpenMPSimpleClauseType(Kind: OpenMPClauseKind, Str: str, LangOpts: *LangOptions) -> u32 {
    match Kind {
        OMPC_default => {
            return Str.Case("none", OMP_DEFAULT_none).Case("shared", OMP_DEFAULT_shared).Case("private", OMP_DEFAULT_private).Case("firstprivate", OMP_DEFAULT_firstprivate).Case("unknown", OMP_DEFAULT_unknown).Default(OMP_DEFAULT_unknown);
        },
        OMPC_proc_bind => {
            return Str.Case("master", 2).Case("close", 3).Case("spread", 4).Case("primary", 5).Case("default", 6).Case("unknown", 7).Default(OMP_PROC_BIND_unknown);
        },
        OMPC_schedule => {
            return Str.Case("static", OMPC_SCHEDULE_static as u32).Case("dynamic", OMPC_SCHEDULE_dynamic as u32).Case("guided", OMPC_SCHEDULE_guided as u32).Case("auto", OMPC_SCHEDULE_auto as u32).Case("runtime", OMPC_SCHEDULE_runtime as u32).Case("monotonic", OMPC_SCHEDULE_MODIFIER_monotonic as u32).Case("nonmonotonic", OMPC_SCHEDULE_MODIFIER_nonmonotonic as u32).Case("simd", OMPC_SCHEDULE_MODIFIER_simd as u32).Default(OMPC_SCHEDULE_unknown);
        },
        OMPC_depend => {
            let mut Type: u32 = Str.Case("in", OMPC_DEPEND_in).Case("out", OMPC_DEPEND_out).Case("inout", OMPC_DEPEND_inout).Case("mutexinoutset", OMPC_DEPEND_mutexinoutset).Case("depobj", OMPC_DEPEND_depobj).Case("source", OMPC_DEPEND_source).Case("sink", OMPC_DEPEND_sink).Case("inoutset", OMPC_DEPEND_inoutset).Case("outallmemory", OMPC_DEPEND_outallmemory).Case("inoutallmemory", OMPC_DEPEND_inoutallmemory).Default(OMPC_DEPEND_unknown);
            if LangOpts.OpenMP < 51 && Type == OMPC_DEPEND_inoutset {
                return OMPC_DEPEND_unknown;
            }
            return Type;
        },
        OMPC_doacross => {
            return Str.Case("source", OMPC_DOACROSS_source).Case("sink", OMPC_DOACROSS_sink).Case("sink_omp_cur_iteration", OMPC_DOACROSS_sink_omp_cur_iteration).Case("source_omp_cur_iteration", OMPC_DOACROSS_source_omp_cur_iteration).Default(OMPC_DOACROSS_unknown);
        },
        OMPC_linear => {
            return Str.Case("val", OMPC_LINEAR_val).Case("ref", OMPC_LINEAR_ref).Case("uval", OMPC_LINEAR_uval).Case("step", OMPC_LINEAR_step).Default(OMPC_LINEAR_unknown);
        },
        OMPC_map => {
            let mut Type: u32 = Str.Case("alloc", OMPC_MAP_alloc as u32).Case("to", OMPC_MAP_to as u32).Case("from", OMPC_MAP_from as u32).Case("tofrom", OMPC_MAP_tofrom as u32).Case("delete", OMPC_MAP_delete as u32).Case("release", OMPC_MAP_release as u32).Case("always", OMPC_MAP_MODIFIER_always as u32).Case("close", OMPC_MAP_MODIFIER_close as u32).Case("mapper", OMPC_MAP_MODIFIER_mapper as u32).Case("iterator", OMPC_MAP_MODIFIER_iterator as u32).Case("present", OMPC_MAP_MODIFIER_present as u32).Case("self", OMPC_MAP_MODIFIER_self as u32).Case("ompx_hold", OMPC_MAP_MODIFIER_ompx_hold as u32).Default(OMPC_MAP_unknown);
            if LangOpts.OpenMP < 51 && Type == OMPC_MAP_MODIFIER_present {
                return OMPC_MAP_MODIFIER_unknown;
            }
            if !LangOpts.OpenMPExtensions && Type == OMPC_MAP_MODIFIER_ompx_hold {
                return OMPC_MAP_MODIFIER_unknown;
            }
            return Type;
        },
        OMPC_to => {
            OMPC_from;
        },
        OMPC_dist_schedule => {
            return Str.Case("static", OMPC_DIST_SCHEDULE_static).Default(OMPC_DIST_SCHEDULE_unknown);
        },
        OMPC_defaultmap => {
            let mut Type: u32 = Str.Case("scalar", OMPC_DEFAULTMAP_scalar as u32).Case("aggregate", OMPC_DEFAULTMAP_aggregate as u32).Case("pointer", OMPC_DEFAULTMAP_pointer as u32).Case("all", OMPC_DEFAULTMAP_all as u32).Case("alloc", OMPC_DEFAULTMAP_MODIFIER_alloc as u32).Case("to", OMPC_DEFAULTMAP_MODIFIER_to as u32).Case("from", OMPC_DEFAULTMAP_MODIFIER_from as u32).Case("tofrom", OMPC_DEFAULTMAP_MODIFIER_tofrom as u32).Case("firstprivate", OMPC_DEFAULTMAP_MODIFIER_firstprivate as u32).Case("none", OMPC_DEFAULTMAP_MODIFIER_none as u32).Case("default", OMPC_DEFAULTMAP_MODIFIER_default as u32).Case("present", OMPC_DEFAULTMAP_MODIFIER_present as u32).Case("storage", OMPC_DEFAULTMAP_MODIFIER_storage as u32).Case("private", OMPC_DEFAULTMAP_MODIFIER_private as u32).Default(OMPC_DEFAULTMAP_unknown);
            if LangOpts.OpenMP < 60 && (Type == OMPC_DEFAULTMAP_MODIFIER_storage || Type == OMPC_DEFAULTMAP_MODIFIER_private) {
                return OMPC_DEFAULTMAP_MODIFIER_unknown;
            }
            return Type;
        },
        OMPC_atomic_default_mem_order => {
            return Str.Case("seq_cst", OMPC_ATOMIC_DEFAULT_MEM_ORDER_seq_cst).Case("acq_rel", OMPC_ATOMIC_DEFAULT_MEM_ORDER_acq_rel).Case("relaxed", OMPC_ATOMIC_DEFAULT_MEM_ORDER_relaxed).Default(OMPC_ATOMIC_DEFAULT_MEM_ORDER_unknown);
        },
        OMPC_fail => {
            return Str.Case("seq_cst", OMPC_seq_cst).Case("acquire", OMPC_acquire).Case("relaxed", OMPC_relaxed).Default(OMPC_unknown) as u32;
        },
        OMPC_device_type => {
            return Str.Case("host", OMPC_DEVICE_TYPE_host).Case("nohost", OMPC_DEVICE_TYPE_nohost).Case("any", OMPC_DEVICE_TYPE_any).Default(OMPC_DEVICE_TYPE_unknown);
        },
        OMPC_at => {
            return Str.Case("compilation", OMPC_AT_compilation).Case("execution", OMPC_AT_execution).Default(OMPC_AT_unknown);
        },
        OMPC_severity => {
            return Str.Case("fatal", OMPC_SEVERITY_fatal).Case("warning", OMPC_SEVERITY_warning).Default(OMPC_SEVERITY_unknown);
        },
        OMPC_lastprivate => {
            return Str.Case("conditional", OMPC_LASTPRIVATE_conditional).Default(OMPC_LASTPRIVATE_unknown);
        },
        OMPC_order => {
            return Str.Case("concurrent", OMPC_ORDER_concurrent as u32).Case("reproducible", OMPC_ORDER_MODIFIER_reproducible as u32).Case("unconstrained", OMPC_ORDER_MODIFIER_unconstrained as u32).Default(OMPC_ORDER_unknown);
        },
        OMPC_update_depend_objects => {
            return Str.Case("in", OMPC_DEPEND_in).Case("out", OMPC_DEPEND_out).Case("inout", OMPC_DEPEND_inout).Case("mutexinoutset", OMPC_DEPEND_mutexinoutset).Case("depobj", OMPC_DEPEND_depobj).Case("source", OMPC_DEPEND_source).Case("sink", OMPC_DEPEND_sink).Case("inoutset", OMPC_DEPEND_inoutset).Case("outallmemory", OMPC_DEPEND_outallmemory).Case("inoutallmemory", OMPC_DEPEND_inoutallmemory).Default(OMPC_DEPEND_unknown);
        },
        OMPC_device => {
            return Str.Case("ancestor", OMPC_DEVICE_ancestor).Case("device_num", OMPC_DEVICE_device_num).Default(OMPC_DEVICE_unknown);
        },
        OMPC_reduction => {
            return Str.Case("default", OMPC_REDUCTION_default).Case("inscan", OMPC_REDUCTION_inscan).Case("task", OMPC_REDUCTION_task).Default(OMPC_REDUCTION_unknown);
        },
        OMPC_adjust_args => {
            return Str.Case("nothing", OMPC_ADJUST_ARGS_nothing).Case("need_device_ptr", OMPC_ADJUST_ARGS_need_device_ptr).Case("need_device_addr", OMPC_ADJUST_ARGS_need_device_addr).Default(OMPC_ADJUST_ARGS_unknown);
        },
        OMPC_bind => {
            return Str.Case("teams", OMPC_BIND_teams).Case("parallel", OMPC_BIND_parallel).Case("thread", OMPC_BIND_thread).Default(OMPC_BIND_unknown);
        },
        OMPC_grainsize => {
            let mut Type: u32 = Str.Case("strict", OMPC_GRAINSIZE_strict).Default(OMPC_GRAINSIZE_unknown);
            if LangOpts.OpenMP < 51 {
                return OMPC_GRAINSIZE_unknown;
            }
            return Type;
        },
        OMPC_dyn_groupprivate => {
            return Str.Case("cgroup", OMPC_DYN_GROUPPRIVATE_cgroup).Case("abort", OMPC_DYN_GROUPPRIVATE_FALLBACK_abort).Case("fallback(abort)", OMPC_DYN_GROUPPRIVATE_FALLBACK_abort).Case("null", OMPC_DYN_GROUPPRIVATE_FALLBACK_null).Case("fallback(null)", OMPC_DYN_GROUPPRIVATE_FALLBACK_null).Case("default_mem", OMPC_DYN_GROUPPRIVATE_FALLBACK_default_mem).Case("fallback(default_mem)", OMPC_DYN_GROUPPRIVATE_FALLBACK_default_mem).Default(OMPC_DYN_GROUPPRIVATE_unknown);
        },
        OMPC_num_tasks => {
            let mut Type: u32 = Str.Case("strict", OMPC_NUMTASKS_strict).Default(OMPC_NUMTASKS_unknown);
            if LangOpts.OpenMP < 51 {
                return OMPC_NUMTASKS_unknown;
            }
            return Type;
        },
        OMPC_num_teams => {
            let mut Type: u32 = Str.Case("lower_bound", OMPC_NUMTEAMS_lower_bound).Case("dims", OMPC_NUMTEAMS_dims).Default(OMPC_NUMTEAMS_unknown);
            if LangOpts.OpenMP < 51 {
                return OMPC_NUMTEAMS_unknown;
            }
            if Type == OMPC_NUMTEAMS_dims && LangOpts.OpenMP < 61 {
                return OMPC_NUMTEAMS_unknown;
            }
            return Type;
        },
        OMPC_thread_limit => {
            let mut Type: u32 = Str.Case("dims", OMPC_THREADLIMIT_dims).Default(OMPC_THREADLIMIT_unknown);
            if LangOpts.OpenMP < 61 {
                return OMPC_THREADLIMIT_unknown;
            }
            return Type;
        },
        OMPC_allocate => {
            return Str.Case("allocator", OMPC_ALLOCATE_allocator).Case("align", OMPC_ALLOCATE_align).Default(OMPC_ALLOCATE_unknown);
        },
        OMPC_threadset => {
            let mut Type: u32 = Str.Case("omp_pool", OMPC_THREADSET_omp_pool).Case("omp_team", OMPC_THREADSET_omp_team).Default(OMPC_THREADSET_unknown);
            if LangOpts.OpenMP < 60 {
                return OMPC_THREADSET_unknown;
            }
            return Type;
        },
        OMPC_num_threads => {
            let mut Type: u32 = Str.Case("strict", OMPC_NUMTHREADS_strict).Case("dims", OMPC_NUMTHREADS_dims).Default(OMPC_NUMTHREADS_unknown);
            if LangOpts.OpenMP < 60 {
                return OMPC_NUMTHREADS_unknown;
            }
            return Type;
        },
        OMPC_use_device_ptr => {
            let mut Type: u32 = Str.Case("fb_nullify", OMPC_USE_DEVICE_PTR_FALLBACK_fb_nullify).Case("fb_preserve", OMPC_USE_DEVICE_PTR_FALLBACK_fb_preserve).Default(OMPC_USE_DEVICE_PTR_FALLBACK_unknown);
            if LangOpts.OpenMP < 61 {
                return OMPC_USE_DEVICE_PTR_FALLBACK_unknown;
            }
            return Type;
        },
        OMPC_unknown => {
            OMPC_threadprivate;
        },
        _ => {
            break;
        },
    }
    llvm_unreachable_internal("Invalid OpenMP simple clause kind", "P:/Goraw/llvm-project/clang/lib/Basic/OpenMPKinds.cpp", 337);
}

