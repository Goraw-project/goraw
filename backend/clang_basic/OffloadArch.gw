fn OffloadArch::CudaDefault(self) -> OffloadArch {
    return getNVPTX(parseArch("sm_52"));
}

fn OffloadArch::HIPDefault(self) -> OffloadArch {
    return getAMDGPU(parseArchAMDGCN("gfx906"));
}

fn OffloadArchToString(A: OffloadArch) -> *u8 {
    match A.targetArch() {
        Unused => {
            return "";
        },
        Unknown => {
            return "unknown";
        },
        NVPTX => {
            return getArchName(A.nvptxKind()).ptr;
        },
        AMDGPU => {
            return getArchNameAMDGCN(A.amdgpuKind()).ptr;
        },
        AMDGCNSPIRV => {
            return "amdgcnspirv";
        },
        IntelCPU => {
            return "graniterapids";
        },
        IntelGPU => {
            return "bmg_g21";
        },
        Generic => {
            return "generic";
        },
    }
    return "unknown";
}

fn OffloadArchToVirtualArchString(A: OffloadArch) -> *u8 {
    match A.targetArch() {
        NVPTX => {
            return getVirtualArch(A.nvptxKind()).ptr;
        },
        AMDGPU => {
            AMDGCNSPIRV;
        },
        Unknown => {
            return "unknown";
        },
        Unused => {
            IntelCPU;
        },
    }
    return "unknown";
}

fn StringToOffloadArch(S: str) -> OffloadArch {
    if S.is_empty() {
        return getUnused();
    }
    if S == "amdgcnspirv" {
        return getAMDGCNSPIRV();
    }
    if S == "generic" {
        return getGeneric();
    }
    if S == "graniterapids" {
        return getIntel(IntelCPU, GRANITERAPIDS);
    }
    if S == "bmg_g21" {
        return getIntel(IntelGPU, BMG_G21);
    }
    if parseArch(S) {
        NV;
    } else {
        return getNVPTX(NV);
    }
    if parseArchAMDGCN(S) {
        AK;
    } else {
        return getAMDGPU(AK);
    }
    return getUnknown();
}

