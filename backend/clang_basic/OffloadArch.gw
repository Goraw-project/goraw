fn getSubArchOffloadArch(SubArch: SubArchType) -> OffloadArch {
    let mut AK: GPUKind = getGPUKindFromSubArch(SubArch);
    if AK == GK_NONE {
        return getUnknown();
    }
    return getAMDGPU(AK);
}

fn getOffloadArchSubArch(ID: OffloadArch) -> SubArchType {
    if !ID.isAMDGPU() {
        return NoSubArch;
    }
    return getSubArch(ID.amdgpuKind());
}

fn OffloadArchToTriple(DefaultToolchainTriple: *Triple, ID: OffloadArch) -> Triple {
    if ID.isAMDGCNSPIRV() {
        return Triple { spirv64, NoSubArch, AMD, AMDHSA };
    }
    if ID.isNVPTX() {
        let mut Arch: ArchType = if DefaultToolchainTriple.isArch64Bit() { nvptx64 } else { nvptx };
        return Triple { Arch, NoSubArch, NVIDIA, CUDA };
    }
    if ID.isAMDGPU() {
        return Triple { amdgpu, NoSubArch, AMD, AMDHSA };
    }
    return Triple {};
}
