fn XRayFunctionFilter::~XRayFunctionFilter(self) {}

fn XRayFunctionFilter::shouldImbueFunction(self: *XRayFunctionFilter, FunctionName: str) -> ImbueAttribute {
    if operator(self.AlwaysInstrument).inSection("xray_always_instrument", "fun", FunctionName, "arg1") || operator(self.AttrList).inSection("always", "fun", FunctionName, "arg1") {
        return ALWAYS_ARG1;
    }
    if operator(self.AlwaysInstrument).inSection("xray_always_instrument", "fun", FunctionName, "") || operator(self.AttrList).inSection("always", "fun", FunctionName, "") {
        return ALWAYS;
    }
    if operator(self.NeverInstrument).inSection("xray_never_instrument", "fun", FunctionName, "") || operator(self.AttrList).inSection("never", "fun", FunctionName, "") {
        return NEVER;
    }
    return NONE;
}

fn XRayFunctionFilter::shouldImbueFunctionsInFile(self: *XRayFunctionFilter, Filename: str, Category: str) -> ImbueAttribute {
    if operator(self.AlwaysInstrument).inSection("xray_always_instrument", "src", Filename, Category) || operator(self.AttrList).inSection("always", "src", Filename, Category) {
        return ALWAYS;
    }
    if operator(self.NeverInstrument).inSection("xray_never_instrument", "src", Filename, Category) || operator(self.AttrList).inSection("never", "src", Filename, Category) {
        return NEVER;
    }
    return NONE;
}

fn XRayFunctionFilter::shouldImbueLocation(self: *XRayFunctionFilter, Loc: SourceLocation, Category: str) -> ImbueAttribute {
    if !Loc.isValid() {
        return NONE;
    }
    return self.shouldImbueFunctionsInFile(self.SM.getFilename(self.SM.getFileLoc(Loc)), Category);
}
