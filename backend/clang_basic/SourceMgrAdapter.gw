fn SourceMgrAdapter::handleDiag(self, Diag: *SMDiagnostic, Context: *mut void) {
    Context as *mut SourceMgrAdapter.handleDiag(Diag);
}

fn SourceMgrAdapter::~SourceMgrAdapter(self) {}

fn SourceMgrAdapter::mapLocation(self, LLVMSrcMgr: *SourceMgr, Loc: SMLoc) -> SourceLocation {
    if !Loc.isValid() {
        return SourceLocation {};
    }
    let mut BufferID: u32 = LLVMSrcMgr.FindBufferContainingLoc(Loc);
    if !BufferID {
        return SourceLocation {};
    }
    let mut Buffer: *MemoryBuffer = LLVMSrcMgr.getMemoryBuffer(BufferID);
    let mut KnownBuffer: auto = zeroed();
    if  {
        let mut FileID: FileID = FileID {};
        if  {
            FileID = self.SrcMgr.getOrCreateFileID;
        } else {
            let mut bufferName: str = Buffer.getBufferIdentifier();
            let mut bufferCopy: auto = zeroed();
            FileID = self.SrcMgr(move());
        }
    }
    let mut Offset: u32 = Loc.getPointer() - Buffer.getBufferStart();
    return self.SrcMgr.getLocForStartOfFile()(Offset);
}

fn SourceMgrAdapter::mapRange(self, LLVMSrcMgr: *SourceMgr, Range: SMRange) -> SourceRange {
    if !Range.isValid() {
        return SourceRange {};
    }
    let mut Start: SourceLocation = self.mapLocation(LLVMSrcMgr, Range.Start);
    let mut End: SourceLocation = self.mapLocation(LLVMSrcMgr, Range.End);
    return SourceRange { B: Start, E: End };
}

fn SourceMgrAdapter::handleDiag(self, Diag: *SMDiagnostic) {
    let mut Loc: SourceLocation = SourceLocation {};
    if Diag.getSourceMgr() {
        LLVMSrcMgr;
    } else {
        Loc = self.mapLocation(*LLVMSrcMgr, Diag.getLoc());
    }
    let mut Message: str = Diag.getMessage();
    let mut DiagID: u32 = 0;
    match Diag.getKind() {
        DK_Error => {
            DiagID = self.ErrorDiagID;
        },
        DK_Warning => {
            DiagID = self.WarningDiagID;
        },
        DK_Remark => {
            llvm_unreachable_internal("remarks not implemented", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\SourceMgrAdapter.cpp", 112);
        },
        DK_Note => {
            DiagID = self.NoteDiagID;
        },
    }
    let mut Builder: DiagnosticBuilder = self.Diagnostics.Report(Loc, DiagID);
    if Diag.getSourceMgr() {
        LLVMSrcMgr;
    } else {
        let mut StartOfLine: SourceLocation = Loc.getLocWithOffset(-Diag.getColumnNo());
    }
}
