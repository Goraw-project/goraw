fn getFileName(FE: FileEntryRef) -> str {
    let mut Filename: str = FE.getFileEntry().tryGetRealPathName();
    if Filename.is_empty() {
        Filename = FE.getName();
    }
    return Filename;
}

fn percentEncodeURICharacter(C: i8) -> str {
    if isAlnum(C) || "-._~:@!$&'()*+,;=".contains(C) {
        return &mut C[0..1];
    }
    return "%" + toHex(&mut C[0..1], false);
}

fn SarifDocumentWriter::fileNameToURI(self, Filename: str) -> str {
    let mut Ret: str = "file://";
    let mut Root: str = root_name(Filename, native);
    if Root.starts_with("//") {
        operator(Ret, Root.drop_front(2));
    } else if !Root.is_empty() {
        operator(Ret, "/" + Root);
    }
    let mut Iter: const_iterator = begin(Filename, native);
    let mut End: const_iterator = end(Filename);
    assert!(!Iter == End, "Expected there to be a non-root path component.");
    for Component in make_range(operator(Iter), End) {
        if Component == "\\" {
            continue;
        }
        operator(Ret, "/");
        for C in Component {
            operator(Ret, percentEncodeURICharacter(C));
        }
    }
    return Ret.operator basic_string();
}

fn adjustColumnPos(Loc: FullSourceLoc, TokenLen: u32) -> u32 {
    assert!(!Loc.isInvalid(), "invalid Loc when adjusting column position");
    let mut LocInfo: FileIDAndOffset = Loc.getDecomposedExpansionLoc();
    let mut Buf: optional<MemoryBufferRef> = Loc.getManager().getBufferOrNone(LocInfo.first, SourceLocation {});
    assert!(Buf, "got an invalid buffer for the location's file");
    assert!(operator(Buf).getBufferSize() >= (LocInfo.second + TokenLen), "token extends past end of buffer?");
    let mut Off: u32 = LocInfo.second - (Loc.getExpansionColumnNumber(null) - 1);
    let mut Ret: u32 = 1;
    while Off < (LocInfo.second + TokenLen) {
        Off += getNumBytesForUTF8(operator(Buf).getBuffer()[Off]);
        Ret += 1;
    }
    return Ret;
}

fn createMessage(Text: str) -> Object {
    return Object { M: ["text", Text] };
}

fn createTextRegion(SM: *SourceManager, R: *CharSourceRange) -> Object {
    let mut BeginCharLoc: FullSourceLoc = FullSourceLoc { ID: R.getBegin(), SrcMgr: SM };
    let mut EndCharLoc: FullSourceLoc = FullSourceLoc { ID: R.getEnd(), SrcMgr: SM };
    let mut Region: Object = ["startLine", BeginCharLoc.getExpansionLineNumber(null), "startColumn", adjustColumnPos(BeginCharLoc, 0)];
    if BeginCharLoc == EndCharLoc {
        Region["endColumn"] = adjustColumnPos(BeginCharLoc, 0);
    } else {
        Region["endLine"] = EndCharLoc.getExpansionLineNumber(null);
        Region["endColumn"] = adjustColumnPos(EndCharLoc, 0);
    }
    return Region;
}

fn createLocation(PhysicalLocation: *mut *mut Object, Message: str) -> Object {
    let mut Ret: Object = ["physicalLocation", move(PhysicalLocation)];
    if !Message.is_empty() {
        Ret.insert(KV { K: "message", V: createMessage(Message) });
    }
    return Ret;
}

fn importanceToStr(I: ThreadFlowImportance) -> str {
    match I {
        Important => {
            return "important";
        },
        Essential => {
            return "essential";
        },
        Unimportant => {
            return "unimportant";
        },
    }
    llvm_unreachable_internal("Fully covered switch is not so fully covered", "P:/Goraw/llvm-project/clang/lib/Basic/Sarif.cpp", 182);
}

fn resultLevelToStr(R: SarifResultLevel) -> str {
    match R {
        None => {
            return "none";
        },
        Note => {
            return "note";
        },
        Warning => {
            return "warning";
        },
        Error => {
            return "error";
        },
    }
    llvm_unreachable_internal("Potentially un-handled SarifResultLevel. Is the switch not fully covered?", "P:/Goraw/llvm-project/clang/lib/Basic/Sarif.cpp", 197);
}

fn createThreadFlowLocation(Location: *mut *mut Object, Importance: *ThreadFlowImportance) -> Object {
    return Object { M: ["location", move(Location), "importance", importanceToStr(Importance)] };
}

fn SarifDocumentWriter::createPhysicalLocation(self, R: *CharSourceRange) -> Object {
    assert!(R.isValid(), "Cannot create a physicalLocation from invalid SourceRange!");
    assert!(R.isCharRange(), "Cannot create a physicalLocation from a token range!");
    let mut Start: FullSourceLoc = FullSourceLoc { ID: R.getBegin(), SrcMgr: self.SourceMgr };
    let mut FE: OptionalFileEntryRef = Start.getExpansionLoc().getFileEntryRef();
    assert!(FE, "Diagnostic does not exist within a valid file!");
    let mut FileURI: str = fileNameToURI(getFileName(operator(FE)));
    let mut I: iterator = self.CurrentArtifacts.find(FileURI);
    if I == self.CurrentArtifacts.end() {
        let mut Idx: u32 = self.CurrentArtifacts.len as u32;
        let mut Location: *SarifArtifactLocation = create(FileURI).setIndex(Idx);
        let mut Artifact: *SarifArtifact = create(Location).setRoles(["resultFile"]).setLength(operator(FE).getSize()).setMimeType("text/plain");
        let mut StatusIter: pair<iterator, bool> = self.CurrentArtifacts.insert(SarifArtifact> { FileURI, Artifact });
        if StatusIter.second {
            I = StatusIter.first;
        }
    }
    assert!(I != self.CurrentArtifacts.end(), "Failed to insert new artifact");
    let mut Location: *SarifArtifactLocation = operator(I).second.Location;
    let mut ArtifactLocationObject: Object = ["uri", Location.URI];
    if Location.Index.has_value() {
        ArtifactLocationObject["index"] = operator(Location.Index);
    }
    return Object { M: ["artifactLocation", move(ArtifactLocationObject), "region", createTextRegion(self.SourceMgr, R)] };
}

fn SarifDocumentWriter::getCurrentTool(self) -> *mut Object {
    assert!(!self.Closed, "SARIF Document is closed. Need to call createRun() before using getcurrentTool!");
    assert!(!self.Runs.is_empty(), "There are no runs associated with the document!");
    return *self.Runs.back().getAsObject().get("tool").getAsObject();
}

fn SarifDocumentWriter::reset(self) {
    self.CurrentRules.clear();
    self.CurrentArtifacts.clear();
}

fn SarifDocumentWriter::endRun(self) {
    if self.Closed {
        self.reset();
        return;
    }
    assert!(!self.Runs.is_empty(), "There are no runs associated with the document!");
    let mut Tool: *mut Object = self.getCurrentTool();
    let mut Rules: Array = Array {};
    for R in self.CurrentRules {
        let mut Config: Object = ["enabled", R.DefaultConfiguration.Enabled, "level", resultLevelToStr(R.DefaultConfiguration.Level), "rank", R.DefaultConfiguration.Rank];
        let mut Rule: Object = ["name", R.Name, "id", R.Id, "fullDescription", Object { M: ["text", R.Description] }, "defaultConfiguration", move(Config)];
        if !R.HelpURI.is_empty() {
            Rule["helpUri"] = R.HelpURI;
        }
        if !R.DeprecatedIds.is_empty() {
            Rule["deprecatedIds"] = R.DeprecatedIds;
        }
        Rules.push(move(Rule));
    }
    let mut Driver: *mut Object = *Tool.getObject("driver");
    Driver["rules"] = move(Rules);
    let mut Run: *mut Object = self.getCurrentRun();
    let mut Artifacts: *mut Array = Run.getArray("artifacts");
    let mut Vec: pair<StringRef, SarifArtifact>, 0> = pair<StringRef, SarifArtifact>, 0> {};
    for x in self.CurrentArtifacts {
        Vec.push(K, V);
    }
    sort(Vec, less_first {});
    for x in Vec {
        let mut Loc: Object = ["uri", A.Location.URI];
        if A.Location.Index.has_value() {
            Loc["index"] = operator(A.Location.Index) as i64;
        }
        let mut Artifact: Object = Object {};
        Artifact["location"] = move(Loc);
        if A.Length.has_value() {
            Artifact["length"] = operator(A.Length) as i64;
        }
        if !A.Roles.is_empty() {
            Artifact["roles"] = A.Roles;
        }
        if !A.MimeType.is_empty() {
            Artifact["mimeType"] = A.MimeType;
        }
        if A.Offset.has_value() {
            Artifact["offset"] = operator(A.Offset);
        }
        Artifacts.push(move(Artifact));
    }
    self.reset();
    self.Closed = true;
}

fn SarifDocumentWriter::createThreadFlows(self, ThreadFlows: ArrayRef<ThreadFlow>) -> Array {
    let mut Ret: Object = ["locations", Array {}];
    let mut Locs: Array = Array {};
    for ThreadFlow in ThreadFlows {
        let mut PLoc: Object = self.createPhysicalLocation(ThreadFlow.Range);
        let mut Loc: Object = createLocation(move(PLoc), ThreadFlow.Message);
        Locs.push(createThreadFlowLocation(move(Loc), ThreadFlow.Importance));
    }
    Ret["locations"] = move(Locs);
    return Array { V: [move(Ret)] };
}

fn SarifDocumentWriter::createCodeFlow(self, ThreadFlows: ArrayRef<ThreadFlow>) -> Object {
    return Object { M: ["threadFlows", self.createThreadFlows(ThreadFlows)] };
}

fn SarifDocumentWriter::createRun(self, ShortToolName: str, LongToolName: str, ToolVersion: str) {
    self.endRun();
    self.Closed = false;
    let mut Tool: Object = ["driver", Object { M: ["name", ShortToolName, "fullName", LongToolName, "language", "en-US", "version", ToolVersion, "informationUri", "https://clang.llvm.org/docs/UsersManual.html"] }];
    let mut TheRun: Object = ["tool", move(Tool), "results", initializer_list<Value> {}, "artifacts", initializer_list<Value> {}, "columnKind", "unicodeCodePoints"];
    self.Runs.push(move(TheRun));
}

fn SarifDocumentWriter::getCurrentRun(self) -> *mut Object {
    assert!(!self.Closed, "SARIF Document is closed. Can only getCurrentRun() if document is opened via createRun(), create a run first");
    assert!(!self.Runs.is_empty(), "There are no runs associated with the document!");
    return *self.Runs.back().getAsObject();
}

fn SarifDocumentWriter::createRule(self, Rule: *SarifRule) -> u64 {
    let mut Ret: u64 = self.CurrentRules.len;
    self.CurrentRules.push(Rule);
    return Ret;
}

fn SarifDocumentWriter::appendResult(self, Result: *SarifResult) {
    let mut RuleIdx: u64 = Result.RuleIdx;
    assert!(RuleIdx < self.CurrentRules.len, "Trying to reference a rule that doesn't exist");
    let mut Rule: *SarifRule = self.CurrentRules[RuleIdx];
    assert!(Rule.DefaultConfiguration.Enabled, "Cannot add a result referencing a disabled Rule");
    let mut Ret: Object = ["message", createMessage(Result.DiagnosticMessage), "ruleIndex", RuleIdx as i64, "ruleId", Rule.Id];
    if !Result.HostedViewerURI.is_empty() {
        Ret["hostedViewerUri"] = Result.HostedViewerURI;
    }
    if !Result.Locations.is_empty() {
        let mut Locs: Array = Array {};
        for Range in Result.Locations {
            Locs.push(createLocation(self.createPhysicalLocation(Range), ""));
        }
        Ret["locations"] = move(Locs);
    }
    if !Result.RelatedLocations.is_empty() {
        let mut ReLocs: Array = Array {};
        for Range in Result.RelatedLocations {
            ReLocs.push(createLocation(self.createPhysicalLocation(Range), ""));
        }
        Ret["relatedLocations"] = move(ReLocs);
    }
    if !Result.PartialFingerprints.is_empty() {
        let mut fingerprints: Object = Object {};
        for pair in Result.PartialFingerprints {
            fingerprints[pair.first] = pair.second;
        }
        Ret["partialFingerprints"] = move(fingerprints);
    }
    if !Result.ThreadFlows.is_empty() {
        Ret["codeFlows"] = Array { V: [self.createCodeFlow(Result.ThreadFlows)] };
    }
    Ret["level"] = resultLevelToStr(Result.LevelOverride.value_or(Rule.DefaultConfiguration.Level));
    let mut Run: *mut Object = self.getCurrentRun();
    let mut Results: *mut Array = Run.getArray("results");
    Results.push(move(Ret));
}

fn SarifDocumentWriter::createDocument(self) -> Object {
    self.endRun();
    let mut Doc: Object = ["$schema", self.SchemaURI, "version", self.SchemaVersion];
    if !self.Runs.is_empty() {
        Doc["runs"] = self.Runs;
    }
    return Doc;
}
