fn PrettyStackTraceLoc::print(self: *PrettyStackTraceLoc, OS: *mut raw_ostream) {
    if self.Loc.isValid() {
        self.Loc.print(OS, self.SM);
        OS << ": ";
    }
    OS << self.Message << 10;
}

fn SourceLocation::getHashValue(self: *SourceLocation) -> u32 {}

fn SourceLocation::print(self: *SourceLocation, OS: *mut raw_ostream, SM: *SourceManager) {
    if !self.isValid() {
        OS << "<invalid loc>";
        return;
    }
    if self.isFileID() {
        let mut PLoc: PresumedLoc = SM.getPresumedLoc(*self, true);
        if PLoc.isInvalid() {
            OS << "<invalid>";
            return;
        }
        OS << PLoc.getFilename() << ':' << PLoc.getLine() << ':' << PLoc.getColumn();
        return;
    }
    SM.getExpansionLoc(*self).print(OS, SM);
    OS << " <Spelling=";
    SM.getSpellingLoc(*self).print(OS, SM);
    OS << '>';
}

fn SourceLocation::printToString(self: *SourceLocation, SM: *SourceManager) -> str {
    let mut S: str = "";
    let mut OS: raw_string_ostream = S;
    self.print(OS, SM);
    return S;
}

fn SourceLocation::dump(self: *SourceLocation, SM: *SourceManager) {
    self.print;
    errs();
}

fn SourceRange::dump(self: *SourceRange, SM: *SourceManager) {
    self.print;
    errs();
}

fn PrintDifference(OS: *mut raw_ostream, SM: *SourceManager, Loc: SourceLocation, Previous: PresumedLoc) -> PresumedLoc {
    if Loc.isFileID() {
        let mut PLoc: PresumedLoc = SM.getPresumedLoc(Loc, true);
        if PLoc.isInvalid() {
            OS << "<invalid sloc>";
            return Previous;
        }
        if Previous.isInvalid() || strcmp(PLoc.getFilename(), Previous.getFilename()) != 0 {
            OS << PLoc.getFilename() << ':' << PLoc.getLine() << ':' << PLoc.getColumn();
        } else if Previous.isInvalid() || PLoc.getLine() != Previous.getLine() {
            OS << "line" << ':' << PLoc.getLine() << ':' << PLoc.getColumn();
        } else {
            OS << "col" << ':' << PLoc.getColumn();
        }
        return PLoc;
    }
    let mut PrintedLoc: PresumedLoc = PrintDifference(OS, SM, SM.getExpansionLoc(Loc), Previous);
    OS << " <Spelling=";
    PrintedLoc = PrintDifference(OS, SM, SM.getSpellingLoc(Loc), PrintedLoc);
    OS << '>';
    return PrintedLoc;
}

fn SourceRange::print(self: *SourceRange, OS: *mut raw_ostream, SM: *SourceManager) {
    OS << '<';
    let mut PrintedLoc: PresumedLoc = PrintDifference(OS, SM, self.B, PresumedLoc {});
    if self.B != self.E {
        OS << ", ";
        PrintDifference(OS, SM, self.E, PrintedLoc);
    }
    OS << '>';
}

fn SourceRange::printToString(self: *SourceRange, SM: *SourceManager) -> str {
    let mut S: str = "";
    let mut OS: raw_string_ostream = S;
    self.print(OS, SM);
    return S;
}

fn FullSourceLoc::getFileID(self: *FullSourceLoc) -> FileID {
    assert!(self.isValid();
    return self.SrcMgr.getFileID(*self);
}

fn FullSourceLoc::getExpansionLoc(self: *FullSourceLoc) -> FullSourceLoc {
    assert!(self.isValid();
    return FullSourceLoc { ID: self.SrcMgr.getExpansionLoc(*self), SrcMgr: *self.SrcMgr };
}

fn FullSourceLoc::getDecomposedExpansionLoc(self: *FullSourceLoc) -> FileIDAndOffset {
    return self.SrcMgr(*self);
}

fn FullSourceLoc::getSpellingLoc(self: *FullSourceLoc) -> FullSourceLoc {
    assert!(self.isValid();
    return FullSourceLoc { ID: self.SrcMgr.getSpellingLoc(*self), SrcMgr: *self.SrcMgr };
}

fn FullSourceLoc::getFileLoc(self: *FullSourceLoc) -> FullSourceLoc {
    assert!(self.isValid();
    return FullSourceLoc { ID: self.SrcMgr.getFileLoc(*self), SrcMgr: *self.SrcMgr };
}

fn FullSourceLoc::getPresumedLoc(self: *FullSourceLoc, UseLineDirectives: bool) -> PresumedLoc {
    if !self.isValid() {
        return PresumedLoc {};
    }
    return self.SrcMgr.getPresumedLoc(*self, UseLineDirectives);
}

fn FullSourceLoc::isMacroArgExpansion(self: *FullSourceLoc, StartLoc: *mut FullSourceLoc) -> bool {
    assert!(self.isValid();
    return self.SrcMgr.isMacroArgExpansion(*self, StartLoc);
}

fn FullSourceLoc::getImmediateMacroCallerLoc(self: *FullSourceLoc) -> FullSourceLoc {
    assert!(self.isValid();
    return FullSourceLoc { ID: self.SrcMgr.getImmediateMacroCallerLoc(*self), SrcMgr: *self.SrcMgr };
}

fn FullSourceLoc::getModuleImportLoc(self: *FullSourceLoc) -> pair<FullSourceLoc, StringRef> {
    if !self.isValid() {
        return make_pair(FullSourceLoc {}, "");
    }
    let mut ImportLoc: pair<SourceLocation, StringRef> = zeroed();
    return make_pair();
}

fn FullSourceLoc::getFileOffset(self: *FullSourceLoc) -> u32 {
    assert!(self.isValid();
    return self.SrcMgr.getFileOffset(*self);
}

fn FullSourceLoc::getLineNumber(self: *FullSourceLoc, Invalid: *mut bool) -> u32 {
    assert!(self.isValid();
    return self.SrcMgr.getLineNumber(self.getFileID(), self.getFileOffset(), Invalid);
}

fn FullSourceLoc::getColumnNumber(self: *FullSourceLoc, Invalid: *mut bool) -> u32 {
    assert!(self.isValid();
    return self.SrcMgr.getColumnNumber(self.getFileID(), self.getFileOffset(), Invalid);
}

fn FullSourceLoc::getFileEntry(self: *FullSourceLoc) -> *FileEntry {
    assert!(self.isValid();
    return self.SrcMgr.getFileEntryForID(self.getFileID());
}

fn FullSourceLoc::getFileEntryRef(self: *FullSourceLoc) -> OptionalFileEntryRef {
    assert!(self.isValid();
    return self.SrcMgr.getFileEntryRefForID(self.getFileID());
}

fn FullSourceLoc::getExpansionLineNumber(self: *FullSourceLoc, Invalid: *mut bool) -> u32 {
    assert!(self.isValid();
    return self.SrcMgr.getExpansionLineNumber(*self, Invalid);
}

fn FullSourceLoc::getExpansionColumnNumber(self: *FullSourceLoc, Invalid: *mut bool) -> u32 {
    assert!(self.isValid();
    return self.SrcMgr.getExpansionColumnNumber(*self, Invalid);
}

fn FullSourceLoc::getSpellingLineNumber(self: *FullSourceLoc, Invalid: *mut bool) -> u32 {
    assert!(self.isValid();
    return self.SrcMgr.getSpellingLineNumber(*self, Invalid);
}

fn FullSourceLoc::getSpellingColumnNumber(self: *FullSourceLoc, Invalid: *mut bool) -> u32 {
    assert!(self.isValid();
    return self.SrcMgr.getSpellingColumnNumber(*self, Invalid);
}

fn FullSourceLoc::isInSystemHeader(self: *FullSourceLoc) -> bool {
    assert!(self.isValid();
    return self.SrcMgr.isInSystemHeader(*self);
}

fn FullSourceLoc::isBeforeInTranslationUnitThan(self: *FullSourceLoc, Loc: SourceLocation) -> bool {
    assert!(self.isValid();
    return self.SrcMgr.isBeforeInTranslationUnit(*self, Loc);
}

fn FullSourceLoc::dump(self: *FullSourceLoc) {
    self.dump(*self.SrcMgr);
}

fn FullSourceLoc::getCharacterData(self: *FullSourceLoc, Invalid: *mut bool) -> *u8 {
    assert!(self.isValid();
    return self.SrcMgr.getCharacterData(*self, Invalid);
}

fn FullSourceLoc::getBufferData(self: *FullSourceLoc, Invalid: *mut bool) -> str {
    assert!(self.isValid();
    return self.SrcMgr.getBufferData(self.SrcMgr.getFileID(*self), Invalid);
}

fn FullSourceLoc::getDecomposedLoc(self: *FullSourceLoc) -> FileIDAndOffset {
    return self.SrcMgr(*self);
}
