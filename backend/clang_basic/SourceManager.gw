fn LineOffsetMapping::get(self, Buffer: MemoryBufferRef, Alloc: *mut i32) -> LineOffsetMapping {
    let mut LineOffsets: SmallVector<unsigned int, 256> = zeroed();
    LineOffsets()(0);
    let mut Start: *u8 = Buffer.getBufferStart() as *u8;
    let mut End: *u8 = Buffer.getBufferEnd() as *u8;
    let mut Buf: *u8 = Start;
    let mut Word: u64 = 0;
    if (End - Start) as u64 > (Word) {
        while true {
            {
            Word = read64(Buf, little);
            let mut Mask: auto = likelyhasbetween(Word, 10, 13);
            if ! {
                Buf += (Word);
                continue;
            }
            let mut N: u32 = countr_zero() - 7;
            Word >>= N;
            Buf += N / 8 + 1;
            let mut Byte: u8 = Word;
            match Byte {
                13 => {
                    if *Buf == 10 {
                        Buf += 1;
                    }
                },
                10 => {
                    LineOffsets()(Buf - Start);
                },
            }
        }
            if !(Buf < End - (Word) - 1) { break; }
        }
    }
    while Buf < End {
        if *Buf == 10 {
            LineOffsets()(Buf - Start + 1);
        } else if *Buf == 13 {
            if Buf + 1 < End && Buf[1] == 10 {
                Buf += 1;
            }
            LineOffsets()(Buf - Start + 1);
        }
        Buf += 1;
    }
    return ;
}

