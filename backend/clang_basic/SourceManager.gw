}

fn SourceManager::createFileIDImpl(self, File: *mut ContentCache, Filename: str, IncludePos: SourceLocation, FileCharacter: CharacteristicKind, LoadedID: i32, LoadedOffset: UIntTy) -> FileID {
    if LoadedID < 0 {
        assert!(LoadedID != -1, "Loading sentinel FileID");
        let mut Index: u32 = -LoadedID - 2;
        return get(LoadedID);
    }
    let mut FileSize: u32 = File.getSize();
    let mut NeedConversion: ErrorOr<bool> = zeroed();
    if NeedConversion() && * {
        if  {
            let mut BufSize: u32 = ();
            if BufSize > FileSize {
                if File()() {
                    File()(BufSize);
                }
                FileSize = BufSize;
            }
        }
    }
    if !(self.NextLocalOffset + FileSize + 1 > self.NextLocalOffset && self.NextLocalOffset + FileSize + 1 <= self.CurrentLoadedOffset) {
        self.Diag;
        self.noteSLocAddressSpaceUsage(self.Diag, 32);
        return FileID {};
    }
    self.LastLookupStartOffset = self.NextLocalOffset;
    self.NextLocalOffset += FileSize + 1;
    self.LastLookupEndOffset = self.NextLocalOffset;
    self.updateSlocUsageStats();
    let mut FID: FileID = get();
    return self.LastFileIDLookup = FID;
}

fn SourceManager::createMacroArgExpansionLoc(self, SpellingLoc: SourceLocation, ExpansionLoc: SourceLocation, Length: u32) -> SourceLocation {
    let mut Info: ExpansionInfo = createForMacroArg(SpellingLoc, ExpansionLoc);
