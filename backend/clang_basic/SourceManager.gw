// template <typename T>
// fn likelyhasbetween(x: T, m: u8, n: u8) -> T {
//     return ((x - operator~(0 as T) / 255 * (n + 1)) & operator~(x) & ((x & operator~(0 as T) / 255 * 127) + (operator~(0 as T) / 255 * (127 - (m - 1))))) & operator~(0 as T) / 255 * 128;
