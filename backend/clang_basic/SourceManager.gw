fn SourceManager::translateFile(self: *SourceManager, SourceFile: *FileEntry) -> FileID {
    assert!(SourceFile, "Null source file!");
    if self.MainFileID.isValid() {
        let mut Invalid: bool = false;
        let mut MainSLoc: *SLocEntry = self.getSLocEntry(self.MainFileID, &mut Invalid);
        if Invalid {
            return FileID {};
        }
        if MainSLoc.isFile() {
            if MainSLoc.getFile().getContentCache() == SourceFile {
                return self.MainFileID;
            }
        }
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.local_sloc_entry_size(); I != N; I += 1 {
        let mut SLoc: *SLocEntry = self.getLocalSLocEntry(I);
        if SLoc.isFile() && SLoc.getFile().getContentCache() == SourceFile {
            return get(I);
        }
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.loaded_sloc_entry_size(); I != N; I += 1 {
        let mut SLoc: *SLocEntry = self.getLoadedSLocEntry(I, null);
        if SLoc.isFile() && SLoc.getFile().getContentCache() == SourceFile {
            return get(-I - 2);
        }
    }
    return FileID {};
}

fn SourceManager::translateLineCol(self: *SourceManager, FID: FileID, Line: u32, Col: u32) -> SourceLocation {
    assert!(Line && Col, "Line and column should start from 1!");
    if FID.isInvalid() {
        return SourceLocation {};
    }
    let mut Invalid: bool = false;
    let mut Entry: *SLocEntry = self.getSLocEntry(FID, &mut Invalid);
    if Invalid {
        return SourceLocation {};
    }
    if !Entry.isFile() {
        return SourceLocation {};
    }
    let mut FileLoc: SourceLocation = getFileLoc(Entry.getOffset());
    if Line == 1 && Col == 1 {
        return FileLoc;
    }
    let mut Content: *ContentCache = &mut Entry.getFile().getContentCache();
    let mut Buffer: MemoryBufferRef> = zeroed();
    if ! {
        return SourceLocation {};
    }
    if Line > Content.SourceLineCache.len {
        let mut Size: u32 = ();
        if Size > 0 {
            Size -= 1;
        }
        return FileLoc.getLocWithOffset(Size);
    }
    let mut FilePos: u32 = Content.SourceLineCache[Line - 1];
    let mut Buf: *u8 = () + FilePos;
    let mut BufLength: u32 = () - FilePos;
    if BufLength == 0 {
        return FileLoc.getLocWithOffset(FilePos);
    }
    let mut i: u32 = 0;
    while i < BufLength - 1 && i < Col - 1 && Buf[i] != 10 && Buf[i] != 13 {
        i += 1;
    }
    return FileLoc.getLocWithOffset(FilePos + i);
}

fn SourceManager::computeMacroArgsCache(self: *SourceManager, MacroArgsCache: *mut i32, FID: FileID) {
    assert!(FID.isValid();
    MacroArgsCache()(0);
    let mut ID: i32 = FID.ID;
    while true {
        ID += 1;
        if ID > 0 {
            if ID >= self.local_sloc_entry_size() {
                return;
            }
        } else if ID == -1 {
            return;
        }
        let mut Invalid: bool = false;
        let mut Entry: *SLocEntry = self.getSLocEntryByID(ID, &mut Invalid);
        if Invalid {
            return;
        }
        if Entry.isFile() {
            let mut File: *FileInfo = Entry.getFile();
            if File.getFileCharacteristic() == C_User_ModuleMap || File.getFileCharacteristic() == C_System_ModuleMap {
                continue;
            }
            let mut IncludeLoc: SourceLocation = File.getIncludeLoc();
            let mut IncludedInFID: bool = (IncludeLoc.isValid() && self.isInFileID(IncludeLoc, FID, null)) || (FID == self.MainFileID && Entry.getFile().getName() == "<built-in>");
            if IncludedInFID {
                if Entry.getFile().NumCreatedFIDs {
                    ID += Entry.getFile().NumCreatedFIDs - 1;
                }
                continue;
            }
            if IncludeLoc.isValid() {
                return;
            }
            continue;
        }
        let mut ExpInfo: *ExpansionInfo = Entry.getExpansion();
        if ExpInfo.getExpansionLocStart().isFileID() {
            if !self.isInFileID(ExpInfo.getExpansionLocStart(), FID, null) {
                return;
            }
        }
        if !ExpInfo.isMacroArgExpansion() {
            continue;
        }
    }
}

