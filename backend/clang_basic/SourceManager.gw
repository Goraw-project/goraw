    return if  { () +  } else { "<<<<INVALID BUFFER>>>>" };
}

fn SourceManager::getColumnNumber(self: *SourceManager, FID: FileID, FilePos: u32, Invalid: *mut bool) -> u32 {
    let mut MemBuf: MemoryBufferRef> = zeroed();
    if Invalid {
        *Invalid = !;
    }
    if ! {
        return 1;
    }
    if FilePos > () {
        if Invalid {
            *Invalid = true;
        }
        return 1;
    }
    let mut Buf: *u8 = ();
    if self.LastLineNoFileIDQuery == FID && self.LastLineNoContentCache.SourceLineCache && self.LastLineNoResult < self.LastLineNoContentCache.SourceLineCache.len {
        let mut SourceLineCache: *u32 = self.LastLineNoContentCache.SourceLineCache.begin();
        let mut LineStart: u32 = SourceLineCache[self.LastLineNoResult - 1];
        let mut LineEnd: u32 = SourceLineCache[self.LastLineNoResult];
        if FilePos >= LineStart && FilePos < LineEnd {
            if FilePos + 1 == LineEnd && FilePos > LineStart {
                if Buf[FilePos - 1] == 13 || Buf[FilePos - 1] == 10 {
                    FilePos -= 1;
                }
            }
            return (FilePos - LineStart) + 1;
        }
    }
    let mut LineStart: u32 = FilePos;
    while LineStart && Buf[LineStart - 1] != 10 && Buf[LineStart - 1] != 13 {
        LineStart -= 1;
    }
    return (FilePos - LineStart) + 1;
}

