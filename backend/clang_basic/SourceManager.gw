fn SourceManager::getLineNumber(self: *SourceManager, FID: FileID, FilePos: u32, Invalid: *mut bool) -> u32 {
    if FID.isInvalid() {
        if Invalid {
            *Invalid = true;
        }
        return 1;
    }
    let mut Content: *ContentCache = null;
    if self.LastLineNoFileIDQuery == FID {
        Content = self.LastLineNoContentCache;
    } else {
        let mut MyInvalid: bool = false;
        let mut Entry: *SLocEntry = self.getSLocEntry(FID, &mut MyInvalid);
        if MyInvalid || !Entry.isFile() {
            if Invalid {
                *Invalid = true;
            }
            return 1;
        }
        Content = &mut Entry.getFile().getContentCache();
    }
    if !Content.SourceLineCache {
        let mut Buffer: MemoryBufferRef> = zeroed();
        if Invalid {
            *Invalid = !;
        }
        if ! {
            return 1;
        }
    } else if Invalid {
        *Invalid = false;
    }
    let mut SourceLineCache: *u32 = Content.SourceLineCache.begin();
    let mut SourceLineCacheStart: *u32 = SourceLineCache;
    let mut SourceLineCacheEnd: *u32 = Content.SourceLineCache.end();
    let mut QueriedFilePos: u32 = FilePos + 1;
    if self.LastLineNoFileIDQuery == FID {
        if QueriedFilePos >= self.LastLineNoFilePos {
            SourceLineCache = SourceLineCache + self.LastLineNoResult - 1;
            if SourceLineCache + 5 < SourceLineCacheEnd {
                if SourceLineCache[5] > QueriedFilePos {
                    SourceLineCacheEnd = SourceLineCache + 5;
                } else if SourceLineCache + 10 < SourceLineCacheEnd {
                    if SourceLineCache[10] > QueriedFilePos {
                        SourceLineCacheEnd = SourceLineCache + 10;
                    } else if SourceLineCache + 20 < SourceLineCacheEnd {
                        if SourceLineCache[20] > QueriedFilePos {
                            SourceLineCacheEnd = SourceLineCache + 20;
                        }
                    }
                }
            }
        } else {
            if self.LastLineNoResult < Content.SourceLineCache.len {
                SourceLineCacheEnd = SourceLineCache + self.LastLineNoResult + 1;
            }
        }
    }
    let mut Pos: *u32 = null;
    let mut LineNo: u32 = Pos - SourceLineCacheStart;
    self.LastLineNoFileIDQuery = FID;
    self.LastLineNoContentCache = Content;
    self.LastLineNoFilePos = QueriedFilePos;
    self.LastLineNoResult = LineNo;
    return LineNo;
}

