fn cloneContentCache(Alloc: *mut BumpPtrAllocator, Other: *ContentCache) -> *mut ContentCache {
    let mut Clone: *mut ContentCache = ContentCache {};
    Clone.OrigEntry = Other.OrigEntry;
    Clone.ContentsEntry = Other.ContentsEntry;
    Clone.Filename = Other.Filename;
    Clone.BufferOverridden = Other.BufferOverridden;
    Clone.IsFileVolatile = Other.IsFileVolatile;
    Clone.IsTransient = Other.IsTransient;
    Clone.IsBufferInvalid = Other.IsBufferInvalid;
    Clone.setUnownedBuffer(Other.getBufferIfLoaded());
    return Clone;
}

static mut MaxUsedSLocBytes: Statistic = Statistic { "source-manager", "MaxUsedSLocBytes", "Maximum number of bytes used by source locations (both loaded and local)." };

fn ContentCache::getSizeBytesMapped(self: *ContentCache) -> u32 {
    return if self.Buffer { operator(self.Buffer).getBufferSize() } else { 0 };
}

fn ContentCache::getMemoryBufferKind(self: *ContentCache) -> BufferKind {
    if self.Buffer == null {
        assert!(0, "Buffer should never be null");
        return MemoryBuffer_Malloc;
    }
    return operator(self.Buffer).getBufferKind();
}

fn ContentCache::getSize(self: *ContentCache) -> u32 {
    return if self.Buffer { operator(self.Buffer).getBufferSize() as u32 } else { operator(self.ContentsEntry).getSize() as u32 };
}

fn ContentCache::getInvalidBOM(self, BufStr: str) -> *u8 {
    let mut InvalidBOM: *u8 = BufStr.StartsWith(withInnerNUL("\000\000\376\377"), "UTF-32 (BE)").StartsWith(withInnerNUL("\377\376\000\000"), "UTF-32 (LE)").StartsWith("\376\377", "UTF-16 (BE)").StartsWith("\377\376", "UTF-16 (LE)").StartsWith("+/v", "UTF-7").StartsWith("\367dL", "UTF-1").StartsWith("\335sfs", "UTF-EBCDIC").StartsWith("\016\376\377", "SCSU").StartsWith("\373\356(", "BOCU-1").StartsWith("\2041\2253", "GB-18030").Default(null);
    return InvalidBOM;
}

fn ContentCache::getBufferOrNone(self: *ContentCache, Diag: *mut DiagnosticsEngine, FM: *mut FileManager, Loc: SourceLocation) -> MemoryBufferRef> {
    if self.IsBufferInvalid {
        return nullopt;
    }
    if self.Buffer {
        return operator(self.Buffer).getMemBufferRef();
    }
    if !self.ContentsEntry {
        return nullopt;
    }
    self.IsBufferInvalid = true;
    let mut BufferOrError: MemoryBuffer>> = FM.getBufferForFile(operator(self.ContentsEntry), self.IsFileVolatile, true, nullopt, true);
    if !BufferOrError {
        Diag.Report(Loc, err_cannot_open_file) << operator(self.ContentsEntry).getName() << BufferOrError.getError().message();
        return nullopt;
    }
    self.Buffer = move(operator(BufferOrError));
    if operator(self.Buffer).getBufferSize() >= max() {
        Diag.Report(Loc, err_file_too_large) << operator(self.ContentsEntry).getName();
        return nullopt;
    }
    assert!(operator(self.Buffer).getBufferSize() >= operator(self.ContentsEntry).getSize() as u64);
    if !operator(self.ContentsEntry).isNamedPipe() && operator(self.Buffer).getBufferSize() < operator(self.ContentsEntry).getSize() as u64 {
        Diag.Report(Loc, err_file_modified) << operator(self.ContentsEntry).getName();
        return nullopt;
    }
    let mut BufStr: str = operator(self.Buffer).getBuffer();
    let mut InvalidBOM: *u8 = getInvalidBOM(BufStr);
    if InvalidBOM {
        Diag.Report(Loc, err_unsupported_bom) << InvalidBOM << operator(self.ContentsEntry).getName();
        return nullopt;
    }
    self.IsBufferInvalid = false;
    return operator(self.Buffer).getMemBufferRef();
}

fn LineTableInfo::getLineTableFilenameID(self, Name: str) -> u32 {
    let mut IterBool: pair<iterator, bool> = self.FilenameIDs.try_emplace(Name, self.FilenamesByID.len);
    if IterBool.second {
        self.FilenamesByID.push(&mut operator(IterBool.first));
    }
    return operator(IterBool.first).second;
}

fn LineTableInfo::AddLineNote(self, FID: FileID, Offset: u32, LineNo: u32, FilenameID: i32, EntryExit: u32, FileKind: CharacteristicKind) {
    let mut Entries: *mut []LineEntry = self.LineEntries[FID];
    assert!((Entries.is_empty() || Entries.back().FileOffset < Offset), "Adding line entries out of order!");
    let mut IncludeOffset: u32 = 0;
    if EntryExit == 1 {
        IncludeOffset = Offset - 1;
    } else {
        let mut PrevEntry: *LineEntry const = if Entries.is_empty() { null } else { &mut Entries.back() };
        if EntryExit == 2 {
            assert!(PrevEntry && PrevEntry.IncludeOffset, "PPDirectives should have caught case when popping empty include stack");
            PrevEntry = self.FindNearestLineEntry(FID, PrevEntry.IncludeOffset);
        }
        if PrevEntry {
            IncludeOffset = PrevEntry.IncludeOffset;
            if FilenameID == -1 {
                FilenameID = PrevEntry.FilenameID;
            }
        }
    }
    Entries.push(get(Offset, LineNo, FilenameID, FileKind, IncludeOffset));
}

fn LineTableInfo::FindNearestLineEntry(self, FID: FileID, Offset: u32) -> *LineEntry {
    let mut Entries: *[]LineEntry = self.LineEntries[FID];
    assert!(!Entries.is_empty(), "No #line entries for this FID after all!");
    if Entries.back().FileOffset <= Offset {
        return &mut Entries.back();
    }
    let mut I: []LineEntry = upper_bound(Entries, Offset);
    if I == Entries.begin() {
        return null;
    }
    return &mut operator(operator(I));
}

fn LineTableInfo::AddEntry(self, FID: FileID, Entries: *[]LineEntry) {
    self.LineEntries[FID] = Entries;
}

fn SourceManager::getLineTableFilenameID(self, Name: str) -> u32 {
    return self.getLineTable().getLineTableFilenameID(Name);
}

fn SourceManager::AddLineNote(self, Loc: SourceLocation, LineNo: u32, FilenameID: i32, IsFileEntry: bool, IsFileExit: bool, FileKind: CharacteristicKind) {
    let mut LocInfo: FileIDAndOffset = self.getDecomposedExpansionLoc(Loc);
    let mut Invalid: bool = false;
    let mut Entry: *mut SLocEntry = self.getSLocEntry(LocInfo.first, &mut Invalid);
    if !Entry.isFile() || Invalid {
        return;
    }
    let mut FileInfo: *mut FileInfo = Entry.getFile();
    FileInfo.setHasLineDirectives();
    self.getLineTable() as void;
    let mut EntryExit: u32 = 0;
    if IsFileEntry {
        EntryExit = 1;
    } else if IsFileExit {
        EntryExit = 2;
    }
    operator(self.LineTable).AddLineNote(LocInfo.first, LocInfo.second, LineNo, FilenameID, EntryExit, FileKind);
}

fn SourceManager::getLineTable(self) -> *mut LineTableInfo {
    if !self.LineTable {
        self.LineTable.reset(LineTableInfo {});
    }
    return operator(self.LineTable);
}

fn SourceManager::SourceManager(self, Diag: *mut DiagnosticsEngine, FileMgr: *mut FileManager, UserFilesAreVolatile: bool) {
    self.clearIDTables();
    Diag.setSourceManager(self);
}

fn SourceManager::~SourceManager(self) {
    for let mut i: u32 = 0;
let mut e: u32 = self.MemBufferInfos.len; i != e; i += 1 {
        if self.MemBufferInfos[i] {
            self.MemBufferInfos[i].~ContentCache();
            self.ContentCacheAlloc.Deallocate(self.MemBufferInfos[i], 1);
        }
    }
    for let mut I: iterator = self.FileInfos.begin();
let mut E: iterator = self.FileInfos.end(); I != E; operator(I) {
        if operator(I).second {
            operator(I).second.~ContentCache();
            self.ContentCacheAlloc.Deallocate(operator(I).second, 1);
        }
    }
    for let mut i: u32 = 0;
let mut e: u32 = self.FileIDContentCaches.len; i != e; i += 1 {
        if self.FileIDContentCaches[i] {
            self.FileIDContentCaches[i].~ContentCache();
            self.ContentCacheAlloc.Deallocate(self.FileIDContentCaches[i], 1);
        }
    }
}

fn SourceManager::clearIDTables(self) {
    for let mut i: u32 = 0;
let mut e: u32 = self.FileIDContentCaches.len; i != e; i += 1 {
        if self.FileIDContentCaches[i] {
            self.FileIDContentCaches[i].~ContentCache();
            self.ContentCacheAlloc.Deallocate(self.FileIDContentCaches[i], 1);
        }
    }
    self.FileIDContentCaches.clear();
    self.MainFileID = FileID {};
    self.LocalSLocEntryTable.clear();
    self.LocalLocOffsetTable.clear();
    self.LoadedSLocEntryTable.clear();
    self.SLocEntryLoaded.clear();
    self.SLocEntryOffsetLoaded.clear();
    self.LastLineNoFileIDQuery = FileID {};
    self.LastLineNoContentCache = null;
    self.LastFileIDLookup = FileID {};
    self.LastLookupStartOffset = self.LastLookupEndOffset = 0;
    self.IncludedLocMap.clear();
    if self.LineTable {
        operator(self.LineTable).clear();
    }
    self.NextLocalOffset = 0;
    self.CurrentLoadedOffset = MaxLoadedOffset;
    self.createExpansionLoc(SourceLocation {}, SourceLocation {}, SourceLocation {}, 1, true, 0, 0);
    self.Diag.ResetPragmas();
}

fn SourceManager::isMainFile(self, SourceFile: *FileEntry) -> bool {
    assert!(self.MainFileID.isValid(), "expected initialized SourceManager");
    if self.getFileEntryForID(self.MainFileID) {
        FE;
    } else {
        return FE.getUID() == SourceFile.getUID();
    }
    return false;
}

fn SourceManager::initializeForReplay(self, Old: *SourceManager) {
    assert!(self.MainFileID.isInvalid(), "expected uninitialized SourceManager");
    for let mut I: u32 = 0;
let mut N: u32 = Old.LoadedSLocEntryTable.len; I != N; I += 1 {
        if !Old.SLocEntryLoaded[I] {
            Old.loadSLocEntry(I, null);
        }
    }
    for FileInfo in Old.FileInfos {
        let mut Slot: *mut *mut ContentCache = self.FileInfos[FileInfo.first];
        if Slot {
            continue;
        }
        Slot = cloneContentCache(self.ContentCacheAlloc, *FileInfo.second);
    }
}

fn SourceManager::getOrCreateContentCache(self, FileEnt: FileEntryRef, isSystemFile: bool) -> *mut ContentCache {
    let mut Entry: *mut *mut ContentCache = self.FileInfos[FileEnt];
    if Entry {
        return *Entry;
    }
    Entry = self.ContentCacheAlloc.Allocate(1);
    if self.OverriddenFilesInfo {
        let mut overI: iterator = operator(self.OverriddenFilesInfo).OverriddenFiles.find(FileEnt.operator const clang::FileEntry *());
        if overI == operator(self.OverriddenFilesInfo).OverriddenFiles.end() {
            FileEnt;
        } else {
            ContentCache { if self.OverridenFilesKeepOriginalName { FileEnt } else { operator(overI).second }, operator(overI).second };
        }
    } else {
        FileEnt;
    }
    Entry.IsFileVolatile = self.UserFilesAreVolatile && !isSystemFile;
    Entry.IsTransient = self.FilesAreTransient;
    Entry.BufferOverridden |= FileEnt.isNamedPipe();
    return *Entry;
}

fn SourceManager::createMemBufferContentCache(self, Buffer: MemoryBuffer>) -> *mut ContentCache {
    let mut Entry: *mut ContentCache = self.ContentCacheAlloc.Allocate(1);
    ContentCache {};
    self.MemBufferInfos.push(Entry);
    Entry.setBuffer(move(Buffer));
    return *Entry;
}

fn SourceManager::loadSLocEntry(self: *SourceManager, Index: u32, Invalid: *mut bool) -> *SLocEntry {
    return self.loadSLocEntry(Index, Invalid);
}

fn SourceManager::loadSLocEntry(self, Index: u32, Invalid: *mut bool) -> *mut SLocEntry {
    assert!(!self.SLocEntryLoaded[Index]);
    if self.ExternalSLocEntries.ReadSLocEntry(-(Index as i32 + 2)) {
        if Invalid {
            *Invalid = true;
        }
        if !self.SLocEntryLoaded[Index] {
            if !self.FakeSLocEntryForRecovery {
                self.FakeSLocEntryForRecovery = make_unique(get(0, get(SourceLocation {}, self.getFakeContentCacheForRecovery(), C_User, "")));
            }
            return operator(self.FakeSLocEntryForRecovery);
        }
    }
    return self.LoadedSLocEntryTable[Index];
}

fn SourceManager::AllocateLoadedSLocEntries(self, NumSLocEntries: u32, TotalSize: UIntTy) -> UIntTy> {
    assert!(self.ExternalSLocEntries, "Don't have an external sloc source");
    if self.CurrentLoadedOffset < TotalSize || self.CurrentLoadedOffset - TotalSize < self.NextLocalOffset {
        return make_pair(0, 0);
    }
    self.LoadedSLocEntryTable.resize(self.LoadedSLocEntryTable.len + NumSLocEntries);
    self.SLocEntryLoaded.resize(self.LoadedSLocEntryTable.len, false);
    self.SLocEntryOffsetLoaded.resize(self.LoadedSLocEntryTable.len, false);
    self.CurrentLoadedOffset -= TotalSize;
    self.updateSlocUsageStats();
    let mut BaseID: i32 = -self.LoadedSLocEntryTable.len - 1;
    self.LoadedSLocEntryAllocBegin.push(get(BaseID));
    return make_pair(BaseID, self.CurrentLoadedOffset);
}

fn SourceManager::getFakeBufferForRecovery(self: *SourceManager) -> MemoryBufferRef {
    if !self.FakeBufferForRecovery {
        self.FakeBufferForRecovery = getMemBuffer("<<<INVALID BUFFER>>", "", true);
    }
    return operator(self.FakeBufferForRecovery);
}

fn SourceManager::getFakeContentCacheForRecovery(self: *SourceManager) -> *mut ContentCache {
    if !self.FakeContentCacheForRecovery {
        self.FakeContentCacheForRecovery = make_unique();
        operator(self.FakeContentCacheForRecovery).setUnownedBuffer(self.getFakeBufferForRecovery());
    }
    return operator(self.FakeContentCacheForRecovery);
}

fn SourceManager::getPreviousFileID(self: *SourceManager, FID: FileID) -> FileID {
    if FID.isInvalid() {
        return FileID {};
    }
    let mut ID: i32 = FID.ID;
    if ID == -1 {
        return FileID {};
    }
    if ID > 0 {
        if ID - 1 == 0 {
            return FileID {};
        }
    } else if -(ID - 1) - 2 >= self.LoadedSLocEntryTable.len {
        return FileID {};
    }
    return get(ID - 1);
}

fn SourceManager::getNextFileID(self: *SourceManager, FID: FileID) -> FileID {
    if FID.isInvalid() {
        return FileID {};
    }
    let mut ID: i32 = FID.ID;
    if ID > 0 {
        if ID + 1 >= self.local_sloc_entry_size() {
            return FileID {};
        }
    } else if ID + 1 >= -1 {
        return FileID {};
    }
    return get(ID + 1);
}

fn SourceManager::createFileID(self, SourceFile: FileEntryRef, IncludePos: SourceLocation, FileCharacter: CharacteristicKind, LoadedID: i32, LoadedOffset: UIntTy) -> FileID {
    let mut IR: *mut ContentCache = self.getOrCreateContentCache(SourceFile, isSystem(FileCharacter));
    let mut Cache: *mut ContentCache = &mut IR;
    let mut Filename: str = SourceFile.getName();
    if IR.OrigEntry && !operator(IR.OrigEntry).isSameRef(SourceFile) {
        Cache = cloneContentCache(self.ContentCacheAlloc, IR);
        Cache.OrigEntry = SourceFile;
        self.FileIDContentCaches.push(Cache);
    }
    if operator(Cache.ContentsEntry).isNamedPipe() {
        Cache.getBufferOrNone(self.Diag, self.getFileManager(), SourceLocation {}) as void;
    }
    return self.createFileIDImpl(*Cache, Filename, IncludePos, FileCharacter, LoadedID, LoadedOffset);
}

fn SourceManager::createFileID(self, Buffer: MemoryBuffer>, FileCharacter: CharacteristicKind, LoadedID: i32, LoadedOffset: UIntTy, IncludeLoc: SourceLocation) -> FileID {
    let mut Name: str = operator(Buffer).getBufferIdentifier();
    return self.createFileIDImpl(self.createMemBufferContentCache(move(Buffer)), Name, IncludeLoc, FileCharacter, LoadedID, LoadedOffset);
}

fn SourceManager::createFileID(self, Buffer: *MemoryBufferRef, FileCharacter: CharacteristicKind, LoadedID: i32, LoadedOffset: UIntTy, IncludeLoc: SourceLocation) -> FileID {
    return self.createFileID(getMemBuffer(Buffer, true), FileCharacter, LoadedID, LoadedOffset, IncludeLoc);
}

fn SourceManager::getOrCreateFileID(self, SourceFile: FileEntryRef, FileCharacter: CharacteristicKind) -> FileID {
    let mut ID: FileID = self.translateFile(SourceFile);
    return if ID.isValid() { ID } else { self.createFileID(SourceFile, SourceLocation {}, FileCharacter, 0, 0) };
}

fn SourceManager::createFileIDImpl(self, File: *mut ContentCache, Filename: str, IncludePos: SourceLocation, FileCharacter: CharacteristicKind, LoadedID: i32, LoadedOffset: UIntTy) -> FileID {
    if LoadedID < 0 {
        assert!(LoadedID != -1, "Loading sentinel FileID");
        let mut Index: u32 = -LoadedID - 2;
        assert!(Index < self.LoadedSLocEntryTable.len, "FileID out of range");
        assert!(!self.SLocEntryLoaded[Index], "FileID already loaded");
        self.LoadedSLocEntryTable[Index] = get(LoadedOffset, get(IncludePos, File, FileCharacter, Filename));
        self.SLocEntryLoaded[Index] = self.SLocEntryOffsetLoaded[Index] = true;
        return get(LoadedID);
    }
    let mut FileSize: u32 = File.getSize();
    let mut NeedConversion: ErrorOr<bool> = needConversion(Filename, file_t {});
    if NeedConversion && operator(NeedConversion) {
        if File.getBufferOrNone(self.Diag, self.getFileManager(), SourceLocation {}) {
            Buffer;
        } else {
            let mut BufSize: u32 = operator(Buffer).getBufferSize();
            if BufSize > FileSize {
                if File.ContentsEntry.has_value() {
                    operator(File.ContentsEntry).updateFileEntryBufferSize(BufSize);
                }
                FileSize = BufSize;
            }
        }
    }
    if !(self.NextLocalOffset + FileSize + 1 > self.NextLocalOffset && self.NextLocalOffset + FileSize + 1 <= self.CurrentLoadedOffset) {
        self.Diag.Report(IncludePos, err_sloc_space_too_large);
        self.noteSLocAddressSpaceUsage(self.Diag, 32);
        return FileID {};
    }
    assert!(self.LocalSLocEntryTable.len == self.LocalLocOffsetTable.len);
    self.LocalSLocEntryTable.push(get(self.NextLocalOffset, get(IncludePos, File, FileCharacter, Filename)));
    self.LocalLocOffsetTable.push(self.NextLocalOffset);
    self.LastLookupStartOffset = self.NextLocalOffset;
    self.NextLocalOffset += FileSize + 1;
    self.LastLookupEndOffset = self.NextLocalOffset;
    self.updateSlocUsageStats();
    let mut FID: FileID = get(self.LocalSLocEntryTable.len - 1);
    return self.LastFileIDLookup = FID;
}

fn SourceManager::createMacroArgExpansionLoc(self, SpellingLoc: SourceLocation, ExpansionLoc: SourceLocation, Length: u32) -> SourceLocation {
    let mut Info: ExpansionInfo = createForMacroArg(SpellingLoc, ExpansionLoc);
    return self.createExpansionLocImpl(Info, Length, 0, 0);
}

fn SourceManager::createExpansionLoc(self, SpellingLoc: SourceLocation, ExpansionLocStart: SourceLocation, ExpansionLocEnd: SourceLocation, Length: u32, ExpansionIsTokenRange: bool, LoadedID: i32, LoadedOffset: UIntTy) -> SourceLocation {
    let mut Info: ExpansionInfo = create(SpellingLoc, ExpansionLocStart, ExpansionLocEnd, ExpansionIsTokenRange);
    return self.createExpansionLocImpl(Info, Length, LoadedID, LoadedOffset);
}

fn SourceManager::createTokenSplitLoc(self, Spelling: SourceLocation, TokenStart: SourceLocation, TokenEnd: SourceLocation) -> SourceLocation {
    assert!(self.getFileID(TokenStart) == self.getFileID(TokenEnd), "token spans multiple files");
    return self.createExpansionLocImpl(createForTokenSplit(Spelling, TokenStart, TokenEnd), TokenEnd.getOffset() - TokenStart.getOffset(), 0, 0);
}

fn SourceManager::createExpansionLocImpl(self, Info: *ExpansionInfo, Length: u32, LoadedID: i32, LoadedOffset: UIntTy) -> SourceLocation {
    if LoadedID < 0 {
        assert!(LoadedID != -1, "Loading sentinel FileID");
        let mut Index: u32 = -LoadedID - 2;
        assert!(Index < self.LoadedSLocEntryTable.len, "FileID out of range");
        assert!(!self.SLocEntryLoaded[Index], "FileID already loaded");
        self.LoadedSLocEntryTable[Index] = get(LoadedOffset, Info);
        self.SLocEntryLoaded[Index] = self.SLocEntryOffsetLoaded[Index] = true;
        return getMacroLoc(LoadedOffset);
    }
    assert!(self.LocalSLocEntryTable.len == self.LocalLocOffsetTable.len);
    self.LocalSLocEntryTable.push(get(self.NextLocalOffset, Info));
    self.LocalLocOffsetTable.push(self.NextLocalOffset);
    if self.NextLocalOffset + Length + 1 <= self.NextLocalOffset || self.NextLocalOffset + Length + 1 > self.CurrentLoadedOffset {
        self.Diag.Report(err_sloc_space_too_large);
        report_fatal_error("ran out of source locations", true);
    }
    self.NextLocalOffset += Length + 1;
    self.updateSlocUsageStats();
    return getMacroLoc(self.NextLocalOffset - (Length + 1));
}

fn SourceManager::getMemoryBufferForFileOrNone(self, File: FileEntryRef) -> MemoryBufferRef> {
    let mut IR: *mut ContentCache = self.getOrCreateContentCache(File, false);
    return IR.getBufferOrNone(self.Diag, self.getFileManager(), SourceLocation {});
}

fn SourceManager::overrideFileContents(self, SourceFile: FileEntryRef, Buffer: MemoryBuffer>) {
    let mut IR: *mut ContentCache = self.getOrCreateContentCache(SourceFile, false);
    IR.setBuffer(move(Buffer));
    IR.BufferOverridden = true;
    self.getOverriddenFilesInfo().OverriddenFilesWithBuffer.insert(SourceFile.operator const clang::FileEntry *());
}

fn SourceManager::overrideFileContents(self, SourceFile: *FileEntry, NewFile: FileEntryRef) {
    assert!(SourceFile.getSize() == NewFile.getSize(), "Different sizes, use the FileManager to create a virtual file with the correct size");
    assert!(self.FileInfos.find_as(SourceFile) == self.FileInfos.end(), "This function should be called at the initialization stage, before any parsing occurs.");
    let mut Pair: pair<iterator, bool> = self.getOverriddenFilesInfo().OverriddenFiles.insert(make_pair(SourceFile, NewFile));
    if !Pair.second {
        operator(Pair.first).second = NewFile;
    }
}

fn SourceManager::bypassFileContentsOverride(self, File: FileEntryRef) -> OptionalFileEntryRef {
    assert!(self.isFileOverridden(&mut File.getFileEntry();
    let mut BypassFile: OptionalFileEntryRef = self.FileMgr.getBypassFile(File);
    if !BypassFile {
        return nullopt;
    }
    self.getOrCreateContentCache(operator(BypassFile), false) as void;
    return BypassFile;
}

fn SourceManager::setFileIsTransient(self, File: FileEntryRef) {
    self.getOrCreateContentCache(File, false).IsTransient = true;
}

fn SourceManager::getNonBuiltinFilenameForID(self: *SourceManager, FID: FileID) -> optional<StringRef> {
    if self.getSLocEntryForFile(FID) {
        Entry;
    } else if Entry.getFile().getContentCache().OrigEntry {
        return Entry.getFile().getName();
    }
    return nullopt;
}

fn SourceManager::getBufferData(self: *SourceManager, FID: FileID, Invalid: *mut bool) -> str {
    let mut B: optional<StringRef> = self.getBufferDataOrNone(FID);
    if Invalid {
        *Invalid = !B;
    }
    return if B { operator(B) } else { "<<<<<INVALID SOURCE LOCATION>>>>>" };
}

fn SourceManager::getBufferDataIfLoaded(self: *SourceManager, FID: FileID) -> optional<StringRef> {
    if self.getSLocEntryForFile(FID) {
        Entry;
    } else {
        return Entry.getFile().getContentCache().getBufferDataIfLoaded();
    }
    return nullopt;
}

fn SourceManager::getBufferDataOrNone(self: *SourceManager, FID: FileID) -> optional<StringRef> {
    if self.getSLocEntryForFile(FID) {
        Entry;
    } else if Entry.getFile().getContentCache().getBufferOrNone(self.Diag, self.getFileManager(), SourceLocation {}) {
        B;
    } else {
        return operator(B).getBuffer();
    }
    return nullopt;
}

fn SourceManager::getFileIDSlow(self: *SourceManager, SLocOffset: UIntTy) -> FileID {
    if !SLocOffset {
        return get(0);
    }
    if SLocOffset < self.NextLocalOffset {
        return self.getFileIDLocal(SLocOffset);
    }
    return self.getFileIDLoaded(SLocOffset);
}

fn SourceManager::getFileIDLocal(self: *SourceManager, SLocOffset: UIntTy) -> FileID {
    assert!(SLocOffset < self.NextLocalOffset, "Bad function choice");
    assert!(SLocOffset >= self.LocalSLocEntryTable[0].getOffset() && SLocOffset > 0, "Invalid SLocOffset");
    assert!(self.LocalSLocEntryTable.len == self.LocalLocOffsetTable.len);
    assert!(self.LastFileIDLookup.ID >= 0, "Only cache local file sloc entry");
    let mut LessIndex: u32 = 0;
    let mut GreaterIndex: u32 = self.LocalLocOffsetTable.len;
    if self.LastLookupStartOffset < SLocOffset {
        LessIndex = self.LastFileIDLookup.ID;
    } else {
        GreaterIndex = self.LastFileIDLookup.ID;
    }
    let mut NumProbes: u32 = 0;
    while true {
        GreaterIndex -= 1;
        assert!(GreaterIndex < self.LocalLocOffsetTable.len);
        if self.LocalLocOffsetTable[GreaterIndex] <= SLocOffset {
            let mut Res: FileID = get(GreaterIndex);
            self.LastFileIDLookup = Res;
            self.LastLookupStartOffset = self.LocalLocOffsetTable[GreaterIndex];
            self.LastLookupEndOffset = if GreaterIndex + 1 >= self.LocalLocOffsetTable.len { self.NextLocalOffset } else { self.LocalLocOffsetTable[GreaterIndex + 1] };
            self.NumLinearScans += NumProbes + 1;
            return Res;
        }
        if NumProbes += 1 == 8 {
            break;
        }
    }
    while LessIndex < GreaterIndex {
        self.NumBinaryProbes += 1;
        let mut MiddleIndex: u32 = LessIndex + (GreaterIndex - LessIndex) / 2;
        if self.LocalLocOffsetTable[MiddleIndex] <= SLocOffset {
            LessIndex = MiddleIndex + 1;
        } else {
            GreaterIndex = MiddleIndex;
        }
    }
    self.LastLookupStartOffset = self.LocalLocOffsetTable[LessIndex - 1];
    self.LastLookupEndOffset = self.LocalLocOffsetTable[LessIndex];
    return self.LastFileIDLookup = get(LessIndex - 1);
}

fn SourceManager::getFileIDLoaded(self: *SourceManager, SLocOffset: UIntTy) -> FileID {
    if SLocOffset < self.CurrentLoadedOffset {
        assert!(0, "Invalid SLocOffset or bad function choice");
        return FileID {};
    }
    return get(self.ExternalSLocEntries.getSLocEntryID(SLocOffset));
}

fn SourceManager::getExpansionLocSlowCase(self: *SourceManager, Loc: SourceLocation) -> SourceLocation {
    while true {
        {
        Loc = self.getSLocEntry(self.getFileID(Loc), null).getExpansion().getExpansionLocStart();
    }
        if !(!Loc.isFileID()) { break; }
    }
    return Loc;
}

fn SourceManager::getSpellingLocSlowCase(self: *SourceManager, Loc: SourceLocation) -> SourceLocation {
    while true {
        {
        let mut Entry: *SLocEntry = self.getSLocEntry(self.getFileID(Loc), null);
        Loc = Entry.getExpansion().getSpellingLoc().getLocWithOffset(Loc.getOffset() - Entry.getOffset());
    }
        if !(!Loc.isFileID()) { break; }
    }
    return Loc;
}

fn SourceManager::getFileLocSlowCase(self: *SourceManager, Loc: SourceLocation) -> SourceLocation {
    while true {
        {
        let mut Entry: *SLocEntry = self.getSLocEntry(self.getFileID(Loc), null);
        let mut ExpInfo: *ExpansionInfo = Entry.getExpansion();
        if ExpInfo.isMacroArgExpansion() {
            Loc = ExpInfo.getSpellingLoc().getLocWithOffset(Loc.getOffset() - Entry.getOffset());
        } else {
            Loc = ExpInfo.getExpansionLocStart();
        }
    }
        if !(!Loc.isFileID()) { break; }
    }
    return Loc;
}

fn SourceManager::getImmediateSpellingLoc(self: *SourceManager, Loc: SourceLocation) -> SourceLocation {
    if Loc.isFileID() {
        return Loc;
    }
    let mut LocInfo: FileIDAndOffset = self.getDecomposedLoc(Loc);
    Loc = self.getSLocEntry(LocInfo.first, null).getExpansion().getSpellingLoc();
    return Loc.getLocWithOffset(LocInfo.second);
}

fn SourceManager::getFilename(self: *SourceManager, SpellingLoc: SourceLocation) -> str {
    if self.getFileEntryRefForID(self.getFileID(SpellingLoc)) {
        F;
    } else {
        return operator(F).getName();
    }
    return "";
}

fn SourceManager::getImmediateExpansionRange(self: *SourceManager, Loc: SourceLocation) -> CharSourceRange {
    assert!(Loc.isMacroID(), "Not a macro expansion loc!");
    let mut Expansion: *ExpansionInfo = self.getSLocEntry(self.getFileID(Loc), null).getExpansion();
    return Expansion.getExpansionLocRange();
}

fn SourceManager::getTopMacroCallerLoc(self: *SourceManager, Loc: SourceLocation) -> SourceLocation {
    while self.isMacroArgExpansion(Loc, null) {
        Loc = self.getImmediateSpellingLoc(Loc);
    }
    return Loc;
}

fn SourceManager::getExpansionRange(self: *SourceManager, Loc: SourceLocation) -> CharSourceRange {
    if Loc.isFileID() {
        return CharSourceRange { Range: SourceRange { B: Loc, E: Loc }, IsTokenRange: true };
    }
    let mut Res: CharSourceRange = self.getImmediateExpansionRange(Loc);
    while !Res.getBegin().isFileID() {
        Res.setBegin(self.getImmediateExpansionRange(Res.getBegin()).getBegin());
    }
    while !Res.getEnd().isFileID() {
        let mut EndRange: CharSourceRange = self.getImmediateExpansionRange(Res.getEnd());
        Res.setEnd(EndRange.getEnd());
        Res.setTokenRange(EndRange.isTokenRange());
    }
    return Res;
}

fn SourceManager::isMacroArgExpansion(self: *SourceManager, Loc: SourceLocation, StartLoc: *mut SourceLocation) -> bool {
    if !Loc.isMacroID() {
        return false;
    }
    let mut FID: FileID = self.getFileID(Loc);
    let mut Expansion: *ExpansionInfo = self.getSLocEntry(FID, null).getExpansion();
    if !Expansion.isMacroArgExpansion() {
        return false;
    }
    if StartLoc {
        *StartLoc = Expansion.getExpansionLocStart();
    }
    return true;
}

fn SourceManager::isMacroBodyExpansion(self: *SourceManager, Loc: SourceLocation) -> bool {
    if !Loc.isMacroID() {
        return false;
    }
    let mut FID: FileID = self.getFileID(Loc);
    let mut Expansion: *ExpansionInfo = self.getSLocEntry(FID, null).getExpansion();
    return Expansion.isMacroBodyExpansion();
}

fn SourceManager::isAtStartOfImmediateMacroExpansion(self: *SourceManager, Loc: SourceLocation, MacroBegin: *mut SourceLocation) -> bool {
    assert!(Loc.isValid() && Loc.isMacroID(), "Expected a valid macro loc");
    let mut DecompLoc: FileIDAndOffset = self.getDecomposedLoc(Loc);
    if DecompLoc.second > 0 {
        return false;
    }
    let mut Invalid: bool = false;
    let mut ExpInfo: *ExpansionInfo = self.getSLocEntry(DecompLoc.first, &mut Invalid).getExpansion();
    if Invalid {
        return false;
    }
    let mut ExpLoc: SourceLocation = ExpInfo.getExpansionLocStart();
    if ExpInfo.isMacroArgExpansion() {
        let mut PrevFID: FileID = self.getPreviousFileID(DecompLoc.first);
        if !PrevFID.isInvalid() {
            let mut PrevEntry: *SLocEntry = self.getSLocEntry(PrevFID, &mut Invalid);
            if Invalid {
                return false;
            }
            if PrevEntry.isExpansion() && PrevEntry.getExpansion().getExpansionLocStart() == ExpLoc {
                return false;
            }
        }
    }
    if MacroBegin {
        *MacroBegin = ExpLoc;
    }
    return true;
}

fn SourceManager::isAtEndOfImmediateMacroExpansion(self: *SourceManager, Loc: SourceLocation, MacroEnd: *mut SourceLocation) -> bool {
    assert!(Loc.isValid() && Loc.isMacroID(), "Expected a valid macro loc");
    let mut FID: FileID = self.getFileID(Loc);
    let mut NextLoc: SourceLocation = Loc.getLocWithOffset(1);
    if self.isInFileID(NextLoc, FID, null) {
        return false;
    }
    let mut Invalid: bool = false;
    let mut ExpInfo: *ExpansionInfo = self.getSLocEntry(FID, &mut Invalid).getExpansion();
    if Invalid {
        return false;
    }
    if ExpInfo.isMacroArgExpansion() {
        let mut NextFID: FileID = self.getNextFileID(FID);
        if !NextFID.isInvalid() {
            let mut NextEntry: *SLocEntry = self.getSLocEntry(NextFID, &mut Invalid);
            if Invalid {
                return false;
            }
            if NextEntry.isExpansion() && NextEntry.getExpansion().getExpansionLocStart() == ExpInfo.getExpansionLocStart() {
                return false;
            }
        }
    }
    if MacroEnd {
        *MacroEnd = ExpInfo.getExpansionLocEnd();
    }
    return true;
}

fn SourceManager::getCharacterData(self: *SourceManager, SL: SourceLocation, Invalid: *mut bool) -> *u8 {
    let mut LocInfo: FileIDAndOffset = self.getDecomposedSpellingLoc(SL);
    let mut CharDataInvalid: bool = false;
    let mut Entry: *SLocEntry = self.getSLocEntry(LocInfo.first, &mut CharDataInvalid);
    if CharDataInvalid || !Entry.isFile() {
        if Invalid {
            *Invalid = true;
        }
        return "<<<<INVALID BUFFER>>>>";
    }
    let mut Buffer: MemoryBufferRef> = Entry.getFile().getContentCache().getBufferOrNone(self.Diag, self.getFileManager(), SourceLocation {});
    if Invalid {
        *Invalid = !Buffer;
    }
    return if Buffer { operator(Buffer).getBufferStart() + LocInfo.second } else { "<<<<INVALID BUFFER>>>>" };
}

fn SourceManager::getColumnNumber(self: *SourceManager, FID: FileID, FilePos: u32, Invalid: *mut bool) -> u32 {
    let mut MemBuf: MemoryBufferRef> = self.getBufferOrNone(FID, SourceLocation {});
    if Invalid {
        *Invalid = !MemBuf;
    }
    if !MemBuf {
        return 1;
    }
    if FilePos > operator(MemBuf).getBufferSize() {
        if Invalid {
            *Invalid = true;
        }
        return 1;
    }
    let mut Buf: *u8 = operator(MemBuf).getBufferStart();
    if self.LastLineNoFileIDQuery == FID && self.LastLineNoContentCache.SourceLineCache && self.LastLineNoResult < self.LastLineNoContentCache.SourceLineCache.len {
        let mut SourceLineCache: *u32 = self.LastLineNoContentCache.SourceLineCache.begin();
        let mut LineStart: u32 = SourceLineCache[self.LastLineNoResult - 1];
        let mut LineEnd: u32 = SourceLineCache[self.LastLineNoResult];
        if FilePos >= LineStart && FilePos < LineEnd {
            if FilePos + 1 == LineEnd && FilePos > LineStart {
                if Buf[FilePos - 1] == 13 || Buf[FilePos - 1] == 10 {
                    FilePos -= 1;
                }
            }
            return (FilePos - LineStart) + 1;
        }
    }
    let mut LineStart: u32 = FilePos;
    while LineStart && Buf[LineStart - 1] != 10 && Buf[LineStart - 1] != 13 {
        LineStart -= 1;
    }
    return (FilePos - LineStart) + 1;
}

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: isInvalid]
// template <typename LocType>
// fn isInvalid(Loc: PresumedLoc, Invalid: *mut bool) -> bool {
//     let mut MyInvalid: bool = Loc.isInvalid();
//     if Invalid {
//         *Invalid = MyInvalid;
//     }
//     return MyInvalid;
// }
// ========================================================

fn SourceManager::getColumnNumber(self: *SourceManager, Loc: SourceLocation, Invalid: *mut bool) -> u32 {
    assert!(Loc.isFileID();
    if isInvalid(Loc, Invalid) {
        return 0;
    }
    let mut LocInfo: FileIDAndOffset = self.getDecomposedLoc(Loc);
    return self.getColumnNumber(LocInfo.first, LocInfo.second, Invalid);
}

fn SourceManager::getPresumedColumnNumber(self: *SourceManager, Loc: SourceLocation, Invalid: *mut bool) -> u32 {
    let mut PLoc: PresumedLoc = self.getPresumedLoc(Loc, true);
    if isInvalid(PLoc, Invalid) {
        return 0;
    }
    return PLoc.getColumn();
}

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: likelyhasbetween]
// template <typename T>
// fn likelyhasbetween(x: u64, m: u8, n: u8) -> u64 {
//     return ((x - ~0 as u64 / 255 * (n + 1)) & ~x & ((x & ~0 as u64 / 255 * 127) + (~0 as u64 / 255 * (127 - (m - 1))))) & ~0 as u64 / 255 * 128;
// }
// ========================================================

fn LineOffsetMapping::get(self, Buffer: MemoryBufferRef, Alloc: *mut BumpPtrAllocator) -> LineOffsetMapping {
    let mut LineOffsets: SmallVector<unsigned int, 256> = SmallVector<unsigned int, 256> {};
    LineOffsets.push(0);
    let mut Start: *u8 = Buffer.getBufferStart() as *u8;
    let mut End: *u8 = Buffer.getBufferEnd() as *u8;
    let mut Buf: *u8 = Start;
    let mut Word: u64 = 0;
    if (End - Start) as u64 > (Word) {
        while true {
            {
            Word = read64(Buf, little);
            let mut Mask: u64 = likelyhasbetween(Word, 10, 13);
            if !Mask {
                Buf += (Word);
                continue;
            }
            let mut N: u32 = countr_zero(Mask) - 7;
            Word >>= N;
            Buf += N / 8 + 1;
            let mut Byte: u8 = Word;
            match Byte {
                13 => {
                    if *Buf == 10 {
                        Buf += 1;
                    }
                },
                10 => {
                    LineOffsets.push(Buf - Start);
                },
            }
        }
            if !(Buf < End - (Word) - 1) { break; }
        }
    }
    while Buf < End {
        if *Buf == 10 {
            LineOffsets.push(Buf - Start + 1);
        } else if *Buf == 13 {
            if Buf + 1 < End && Buf[1] == 10 {
                Buf += 1;
            }
            LineOffsets.push(Buf - Start + 1);
        }
        Buf += 1;
    }
    return LineOffsetMapping { LineOffsets, Alloc };
}

fn LineOffsetMapping::LineOffsetMapping(self, LineOffsets: ArrayRef<unsigned int>, Alloc: *mut BumpPtrAllocator) {
    self.Storage[0] = LineOffsets.len;
    copy(LineOffsets.begin(), LineOffsets.end(), self.Storage + 1);
}

fn SourceManager::getLineNumber(self: *SourceManager, FID: FileID, FilePos: u32, Invalid: *mut bool) -> u32 {
    if FID.isInvalid() {
        if Invalid {
            *Invalid = true;
        }
        return 1;
    }
    let mut Content: *ContentCache = null;
    if self.LastLineNoFileIDQuery == FID {
        Content = self.LastLineNoContentCache;
    } else {
        let mut MyInvalid: bool = false;
        let mut Entry: *SLocEntry = self.getSLocEntry(FID, &mut MyInvalid);
        if MyInvalid || !Entry.isFile() {
            if Invalid {
                *Invalid = true;
            }
            return 1;
        }
        Content = &mut Entry.getFile().getContentCache();
    }
    if !Content.SourceLineCache {
        let mut Buffer: MemoryBufferRef> = Content.getBufferOrNone(self.Diag, self.getFileManager(), SourceLocation {});
        if Invalid {
            *Invalid = !Buffer;
        }
        if !Buffer {
            return 1;
        }
        Content.SourceLineCache = get(operator(Buffer), self.ContentCacheAlloc);
    } else if Invalid {
        *Invalid = false;
    }
    let mut SourceLineCache: *u32 = Content.SourceLineCache.begin();
    let mut SourceLineCacheStart: *u32 = SourceLineCache;
    let mut SourceLineCacheEnd: *u32 = Content.SourceLineCache.end();
    let mut QueriedFilePos: u32 = FilePos + 1;
    if self.LastLineNoFileIDQuery == FID {
        if QueriedFilePos >= self.LastLineNoFilePos {
            SourceLineCache = SourceLineCache + self.LastLineNoResult - 1;
            if SourceLineCache + 5 < SourceLineCacheEnd {
                if SourceLineCache[5] > QueriedFilePos {
                    SourceLineCacheEnd = SourceLineCache + 5;
                } else if SourceLineCache + 10 < SourceLineCacheEnd {
                    if SourceLineCache[10] > QueriedFilePos {
                        SourceLineCacheEnd = SourceLineCache + 10;
                    } else if SourceLineCache + 20 < SourceLineCacheEnd {
                        if SourceLineCache[20] > QueriedFilePos {
                            SourceLineCacheEnd = SourceLineCache + 20;
                        }
                    }
                }
            }
        } else {
            if self.LastLineNoResult < Content.SourceLineCache.len {
                SourceLineCacheEnd = SourceLineCache + self.LastLineNoResult + 1;
            }
        }
    }
    let mut Pos: *u32 = lower_bound(SourceLineCache, SourceLineCacheEnd, QueriedFilePos);
    let mut LineNo: u32 = Pos - SourceLineCacheStart;
    self.LastLineNoFileIDQuery = FID;
    self.LastLineNoContentCache = Content;
    self.LastLineNoFilePos = QueriedFilePos;
    self.LastLineNoResult = LineNo;
    return LineNo;
}

fn SourceManager::getLineNumber(self: *SourceManager, Loc: SourceLocation, Invalid: *mut bool) -> u32 {
    assert!(Loc.isFileID();
    if isInvalid(Loc, Invalid) {
        return 0;
    }
    let mut LocInfo: FileIDAndOffset = self.getDecomposedLoc(Loc);
    return self.getLineNumber(LocInfo.first, LocInfo.second, null);
}

fn SourceManager::getPresumedLineNumber(self: *SourceManager, Loc: SourceLocation, Invalid: *mut bool) -> u32 {
    let mut PLoc: PresumedLoc = self.getPresumedLoc(Loc, true);
    if isInvalid(PLoc, Invalid) {
        return 0;
    }
    return PLoc.getLine();
}

fn SourceManager::getFileCharacteristic(self: *SourceManager, Loc: SourceLocation) -> CharacteristicKind {
    assert!(Loc.isValid(), "Can't get file characteristic of invalid loc!");
    let mut LocInfo: FileIDAndOffset = self.getDecomposedExpansionLoc(Loc);
    let mut SEntry: *SLocEntry = self.getSLocEntryForFile(LocInfo.first);
    if !SEntry {
        return C_User;
    }
    let mut FI: *FileInfo = SEntry.getFile();
    if !FI.hasLineDirectives() {
        return FI.getFileCharacteristic();
    }
    assert!(self.LineTable, "Can't have linetable entries without a LineTable!");
    let mut Entry: *LineEntry = operator(self.LineTable).FindNearestLineEntry(LocInfo.first, LocInfo.second);
    if !Entry {
        return FI.getFileCharacteristic();
    }
    return Entry.FileKind;
}

fn SourceManager::getBufferName(self: *SourceManager, Loc: SourceLocation, Invalid: *mut bool) -> str {
    if isInvalid(Loc, Invalid) {
        return "<invalid loc>";
    }
    let mut B: MemoryBufferRef> = self.getBufferOrNone(self.getFileID(Loc), SourceLocation {});
    if Invalid {
        *Invalid = !B;
    }
    return if B { operator(B).getBufferIdentifier() } else { "<invalid buffer>" };
}

fn SourceManager::getPresumedLoc(self: *SourceManager, Loc: SourceLocation, UseLineDirectives: bool) -> PresumedLoc {
    if Loc.isInvalid() {
        return PresumedLoc {};
    }
    let mut LocInfo: FileIDAndOffset = self.getDecomposedExpansionLoc(Loc);
    let mut Invalid: bool = false;
    let mut Entry: *SLocEntry = self.getSLocEntry(LocInfo.first, &mut Invalid);
    if Invalid || !Entry.isFile() {
        return PresumedLoc {};
    }
    let mut FI: *FileInfo = Entry.getFile();
    let mut C: *ContentCache = &mut FI.getContentCache();
    let mut FID: FileID = LocInfo.first;
    let mut Filename: str = "";
    if C.OrigEntry {
        Filename = operator(C.OrigEntry).getName();
    } else if C.getBufferOrNone(self.Diag, self.getFileManager(), SourceLocation {}) {
        Buffer;
    } else {
        Filename = operator(Buffer).getBufferIdentifier();
    }
    let mut LineNo: u32 = self.getLineNumber(LocInfo.first, LocInfo.second, &mut Invalid);
    if Invalid {
        return PresumedLoc {};
    }
    let mut ColNo: u32 = self.getColumnNumber(LocInfo.first, LocInfo.second, &mut Invalid);
    if Invalid {
        return PresumedLoc {};
    }
    let mut IncludeLoc: SourceLocation = FI.getIncludeLoc();
    if UseLineDirectives && FI.hasLineDirectives() {
        assert!(self.LineTable, "Can't have linetable entries without a LineTable!");
        if operator(self.LineTable).FindNearestLineEntry(LocInfo.first, LocInfo.second) {
            Entry;
        } else {
            if Entry.FilenameID != -1 {
                Filename = operator(self.LineTable).getFilename(Entry.FilenameID);
                FID = get(0);
            }
            let mut MarkerLineNo: u32 = self.getLineNumber(LocInfo.first, Entry.FileOffset, null);
            LineNo = Entry.LineNo + (LineNo - MarkerLineNo - 1);
            if Entry.IncludeOffset {
                IncludeLoc = self.getLocForStartOfFile(LocInfo.first);
                IncludeLoc = IncludeLoc.getLocWithOffset(Entry.IncludeOffset);
            }
        }
    }
    return PresumedLoc { Filename: Filename.ptr, ID: FID, Line: LineNo, Col: ColNo, IncludeLoc: IncludeLoc };
}

fn SourceManager::isInMainFile(self: *SourceManager, Loc: SourceLocation) -> bool {
    if Loc.isInvalid() {
        return false;
    }
    let mut LocInfo: FileIDAndOffset = self.getDecomposedExpansionLoc(Loc);
    let mut Entry: *SLocEntry = self.getSLocEntryForFile(LocInfo.first);
    if !Entry {
        return false;
    }
    let mut FI: *FileInfo = Entry.getFile();
    if FI.hasLineDirectives() {
        if operator(self.LineTable).FindNearestLineEntry(LocInfo.first, LocInfo.second) {
            Entry;
        } else if Entry.IncludeOffset {
            return false;
        }
    }
    return FI.getIncludeLoc().isInvalid();
}

fn SourceManager::getFileIDSize(self: *SourceManager, FID: FileID) -> u32 {
    let mut Invalid: bool = false;
    let mut Entry: *SLocEntry = self.getSLocEntry(FID, &mut Invalid);
    if Invalid {
        return 0;
    }
    let mut ID: i32 = FID.ID;
    let mut NextOffset: UIntTy = zeroed();
    if (ID > 0 && ID + 1 == self.local_sloc_entry_size()) {
        NextOffset = self.getNextLocalOffset();
    } else if ID + 1 == -1 {
        NextOffset = MaxLoadedOffset;
    } else {
        NextOffset = self.getSLocEntry(get(ID + 1), null).getOffset();
    }
    return NextOffset - Entry.getOffset() - 1;
}

fn SourceManager::translateFileLineCol(self: *SourceManager, SourceFile: *FileEntry, Line: u32, Col: u32) -> SourceLocation {
    assert!(SourceFile, "Null source file!");
    assert!(Line && Col, "Line and column should start from 1!");
    let mut FirstFID: FileID = self.translateFile(SourceFile);
    return self.translateLineCol(FirstFID, Line, Col);
}

fn SourceManager::translateFile(self: *SourceManager, SourceFile: *FileEntry) -> FileID {
    assert!(SourceFile, "Null source file!");
    if self.MainFileID.isValid() {
        let mut Invalid: bool = false;
        let mut MainSLoc: *SLocEntry = self.getSLocEntry(self.MainFileID, &mut Invalid);
        if Invalid {
            return FileID {};
        }
        if MainSLoc.isFile() {
            if MainSLoc.getFile().getContentCache().OrigEntry == SourceFile {
                return self.MainFileID;
            }
        }
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.local_sloc_entry_size(); I != N; I += 1 {
        let mut SLoc: *SLocEntry = self.getLocalSLocEntry(I);
        if SLoc.isFile() && SLoc.getFile().getContentCache().OrigEntry == SourceFile {
            return get(I);
        }
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.loaded_sloc_entry_size(); I != N; I += 1 {
        let mut SLoc: *SLocEntry = self.getLoadedSLocEntry(I, null);
        if SLoc.isFile() && SLoc.getFile().getContentCache().OrigEntry == SourceFile {
            return get(-I - 2);
        }
    }
    return FileID {};
}

fn SourceManager::translateLineCol(self: *SourceManager, FID: FileID, Line: u32, Col: u32) -> SourceLocation {
    assert!(Line && Col, "Line and column should start from 1!");
    if FID.isInvalid() {
        return SourceLocation {};
    }
    let mut Invalid: bool = false;
    let mut Entry: *SLocEntry = self.getSLocEntry(FID, &mut Invalid);
    if Invalid {
        return SourceLocation {};
    }
    if !Entry.isFile() {
        return SourceLocation {};
    }
    let mut FileLoc: SourceLocation = getFileLoc(Entry.getOffset());
    if Line == 1 && Col == 1 {
        return FileLoc;
    }
    let mut Content: *ContentCache = &mut Entry.getFile().getContentCache();
    let mut Buffer: MemoryBufferRef> = Content.getBufferOrNone(self.Diag, self.getFileManager(), SourceLocation {});
    if !Buffer {
        return SourceLocation {};
    }
    if !Content.SourceLineCache {
        Content.SourceLineCache = get(operator(Buffer), self.ContentCacheAlloc);
    }
    if Line > Content.SourceLineCache.len {
        let mut Size: u32 = operator(Buffer).getBufferSize();
        if Size > 0 {
            Size -= 1;
        }
        return FileLoc.getLocWithOffset(Size);
    }
    let mut FilePos: u32 = Content.SourceLineCache[Line - 1];
    let mut Buf: *u8 = operator(Buffer).getBufferStart() + FilePos;
    let mut BufLength: u32 = operator(Buffer).getBufferSize() - FilePos;
    if BufLength == 0 {
        return FileLoc.getLocWithOffset(FilePos);
    }
    let mut i: u32 = 0;
    while i < BufLength - 1 && i < Col - 1 && Buf[i] != 10 && Buf[i] != 13 {
        i += 1;
    }
    return FileLoc.getLocWithOffset(FilePos + i);
}

fn SourceManager::computeMacroArgsCache(self: *SourceManager, MacroArgsCache: *mut MacroArgsMap, FID: FileID) {
    assert!(FID.isValid();
    MacroArgsCache.try_emplace(0);
    let mut ID: i32 = FID.ID;
    while true {
        ID += 1;
        if ID > 0 {
            if ID >= self.local_sloc_entry_size() {
                return;
            }
        } else if ID == -1 {
            return;
        }
        let mut Invalid: bool = false;
        let mut Entry: *SLocEntry = self.getSLocEntryByID(ID, &mut Invalid);
        if Invalid {
            return;
        }
        if Entry.isFile() {
            let mut File: *FileInfo = Entry.getFile();
            if File.getFileCharacteristic() == C_User_ModuleMap || File.getFileCharacteristic() == C_System_ModuleMap {
                continue;
            }
            let mut IncludeLoc: SourceLocation = File.getIncludeLoc();
            let mut IncludedInFID: bool = (IncludeLoc.isValid() && self.isInFileID(IncludeLoc, FID, null)) || (FID == self.MainFileID && Entry.getFile().getName() == "<built-in>");
            if IncludedInFID {
                if Entry.getFile().NumCreatedFIDs {
                    ID += Entry.getFile().NumCreatedFIDs - 1;
                }
                continue;
            }
            if IncludeLoc.isValid() {
                return;
            }
            continue;
        }
        let mut ExpInfo: *ExpansionInfo = Entry.getExpansion();
        if ExpInfo.getExpansionLocStart().isFileID() {
            if !self.isInFileID(ExpInfo.getExpansionLocStart(), FID, null) {
                return;
            }
        }
        if !ExpInfo.isMacroArgExpansion() {
            continue;
        }
        self.associateFileChunkWithMacroArgExp(MacroArgsCache, FID, ExpInfo.getSpellingLoc(), getMacroLoc(Entry.getOffset()), self.getFileIDSize(get(ID)));
    }
}

fn SourceManager::associateFileChunkWithMacroArgExp(self: *SourceManager, MacroArgsCache: *mut MacroArgsMap, FID: FileID, SpellLoc: SourceLocation, ExpansionLoc: SourceLocation, ExpansionLength: u32) {
    if !SpellLoc.isFileID() {
        let mut SpellBeginOffs: UIntTy = SpellLoc.getOffset();
        let mut SpellEndOffs: UIntTy = SpellBeginOffs + ExpansionLength;
        while true {
            let mut Entry: *SLocEntry = self.getSLocEntry(SpellFID, null);
            let mut SpellFIDBeginOffs: UIntTy = Entry.getOffset();
            let mut SpellFIDSize: u32 = self.getFileIDSize(SpellFID);
            let mut SpellFIDEndOffs: UIntTy = SpellFIDBeginOffs + SpellFIDSize;
            let mut Info: *ExpansionInfo = Entry.getExpansion();
            if Info.isMacroArgExpansion() {
                let mut CurrSpellLength: u32 = 0;
                if SpellFIDEndOffs < SpellEndOffs {
                    CurrSpellLength = SpellFIDSize - SpellRelativeOffs;
                } else {
                    CurrSpellLength = ExpansionLength;
                }
                self.associateFileChunkWithMacroArgExp(MacroArgsCache, FID, Info.getSpellingLoc().getLocWithOffset(SpellRelativeOffs), ExpansionLoc, CurrSpellLength);
            }
            if SpellFIDEndOffs >= SpellEndOffs {
                return;
            }
            let mut advance: u32 = SpellFIDSize - SpellRelativeOffs + 1;
            ExpansionLoc = ExpansionLoc.getLocWithOffset(advance);
            ExpansionLength -= advance;
            SpellFID.ID += 1;
            SpellRelativeOffs = 0;
        }
    }
    assert!(SpellLoc.isFileID();
    let mut BeginOffs: u32 = 0;
    if !self.isInFileID(SpellLoc, FID, &mut BeginOffs) {
        return;
    }
    let mut EndOffs: u32 = BeginOffs + ExpansionLength;
    let mut I: iterator = MacroArgsCache.upper_bound(EndOffs);
    operator(I);
    let mut EndOffsMappedLoc: SourceLocation = operator(I).second;
    MacroArgsCache[BeginOffs] = ExpansionLoc;
    MacroArgsCache[EndOffs] = EndOffsMappedLoc;
}

fn SourceManager::updateSlocUsageStats(self: *SourceManager) {
    let mut UsedBytes: UIntTy = self.NextLocalOffset + (MaxLoadedOffset - self.CurrentLoadedOffset);
    MaxUsedSLocBytes.updateMax(UsedBytes);
}

fn SourceManager::getMacroArgExpandedLocation(self: *SourceManager, Loc: SourceLocation) -> SourceLocation {
    if Loc.isInvalid() || !Loc.isFileID() {
        return Loc;
    }
    if FID.isInvalid() {
        return Loc;
    }
    let mut MacroArgsCache: *mut unique_ptr<MacroArgsMap> = self.MacroArgsCacheMap[FID];
    if !MacroArgsCache {
        MacroArgsCache = make_unique();
        self.computeMacroArgsCache(operator(MacroArgsCache), FID);
    }
    assert!(!operator(MacroArgsCache).is_empty();
    let mut I: iterator = operator(MacroArgsCache).upper_bound(Offset);
    if I == operator(MacroArgsCache).begin() {
        return Loc;
    }
    operator(I);
    let mut MacroArgBeginOffs: UIntTy = operator(I).first;
    let mut MacroArgExpandedLoc: SourceLocation = operator(I).second;
    if MacroArgExpandedLoc.isValid() {
        return MacroArgExpandedLoc.getLocWithOffset(Offset - MacroArgBeginOffs);
    }
    return Loc;
}

fn SourceManager::getDecomposedIncludedLoc(self: *SourceManager, FID: FileID) -> FileIDAndOffset {
    if FID.isInvalid() {
        return make_pair(FileID {}, 0);
    }
    let mut InsertOp: pair<iterator, bool> = self.IncludedLocMap.try_emplace(FID);
    let mut DecompLoc: *mut DecompTy = operator(InsertOp.first).second;
    if !InsertOp.second {
        return DecompLoc;
    }
    let mut UpperLoc: SourceLocation = SourceLocation {};
    let mut Invalid: bool = false;
    let mut Entry: *SLocEntry = self.getSLocEntry(FID, &mut Invalid);
    if !Invalid {
        if Entry.isExpansion() {
            UpperLoc = Entry.getExpansion().getExpansionLocStart();
        } else {
            UpperLoc = Entry.getFile().getIncludeLoc();
        }
    }
    if UpperLoc.isValid() {
        DecompLoc = self.getDecomposedLoc(UpperLoc);
    }
    return DecompLoc;
}

fn SourceManager::getUniqueLoadedASTFileID(self: *SourceManager, Loc: SourceLocation) -> FileID {
    assert!(self.isLoadedSourceLocation(Loc), "Must be a source location in a loaded PCH/Module file");
    let mut FirstFID: *FileID = lower_bound(self.LoadedSLocEntryAllocBegin, FID, greater<FileID> {});
    assert!(FirstFID, "The failure to find the first FileID of a loaded AST from a loaded source location was unexpected.");
    return *FirstFID;
}

fn SourceManager::isInTheSameTranslationUnitImpl(self: *SourceManager, LOffs: *FileIDAndOffset, ROffs: *FileIDAndOffset) -> bool {
    if self.isLoadedFileID(LOffs.first) != self.isLoadedFileID(ROffs.first) {
        return false;
    }
    if self.isLoadedFileID(LOffs.first) && self.isLoadedFileID(ROffs.first) {
        let mut FindSLocEntryAlloc: Closure_1 = Closure_1 { cap_0: self };
        if FindSLocEntryAlloc.call(LOffs.first) != FindSLocEntryAlloc.call(ROffs.first) {
            return false;
        }
    }
    return true;
}

fn MoveUpTranslationUnitIncludeHierarchy(Loc: *mut FileIDAndOffset, SM: *SourceManager) -> bool {
    let mut UpperLoc: FileIDAndOffset = SM.getDecomposedIncludedLoc(Loc.first);
    if UpperLoc.first.isInvalid() || !SM.isInTheSameTranslationUnitImpl(UpperLoc, Loc) {
        return true;
    }
    Loc = UpperLoc;
    return false;
}

fn SourceManager::getInBeforeInTUCache(self: *SourceManager, LFID: FileID, RFID: FileID) -> *mut InBeforeInTUCacheEntry {
    let mut Key: IsBeforeInTUCacheKey = IsBeforeInTUCacheKey { LFID, RFID };
    if self.IBTUCache.len < MagicCacheSize {
        return operator(self.IBTUCache.try_emplace(Key, LFID, RFID).first).second;
    }
    let mut I: iterator = self.IBTUCache.find(Key);
    if I != self.IBTUCache.end() {
        return operator(I).second;
    }
    self.IBTUCacheOverflow.setQueryFIDs(LFID, RFID);
    return self.IBTUCacheOverflow;
}

fn SourceManager::isBeforeInTranslationUnit(self: *SourceManager, LHS: SourceLocation, RHS: SourceLocation) -> bool {
    assert!(LHS.isValid() && RHS.isValid(), "Passed invalid source location!");
    if LHS == RHS {
        return false;
    }
    let mut LOffs: FileIDAndOffset = self.getDecomposedLoc(LHS);
    let mut ROffs: FileIDAndOffset = self.getDecomposedLoc(RHS);
    if LOffs.first.isInvalid() || ROffs.first.isInvalid() {
        return LOffs.first.isInvalid() && !ROffs.first.isInvalid();
    }
    let mut InSameTU: pair<bool, bool> = self.isInTheSameTranslationUnit(LOffs, ROffs);
    if InSameTU.first {
        return InSameTU.second;
    }
    return LOffs.first < ROffs.first;
}

fn SourceManager::isInTheSameTranslationUnit(self: *SourceManager, LOffs: *mut FileIDAndOffset, ROffs: *mut FileIDAndOffset) -> pair<bool, bool> {
    if !self.isInTheSameTranslationUnitImpl(LOffs, ROffs) {
        return make_pair(false, false);
    }
    if LOffs.first == ROffs.first {
        return make_pair(true, LOffs.second < ROffs.second);
    }
    let mut IsBeforeInTUCache: *mut InBeforeInTUCacheEntry = self.getInBeforeInTUCache(LOffs.first, ROffs.first);
    if IsBeforeInTUCache.isCacheValid() {
        return make_pair(true, IsBeforeInTUCache.getCachedResult(LOffs.second, ROffs.second));
    }
    let mut LChain: SmallDenseMap<FileID, Entry, 16> = SmallDenseMap<FileID, Entry, 16> {};
    let mut LChild: FileID = FileID {};
    while true {
        {
        LChain.try_emplace(LOffs.first, Entry { LOffs, LChild });
        if LOffs.first == ROffs.first {
            break;
        }
        LChild = LOffs.first;
    }
        if !(!MoveUpTranslationUnitIncludeHierarchy(LOffs, *self)) { break; }
    }
    let mut RChild: FileID = FileID {};
    while true {
        {
        let mut LIt: iterator = LChain.find(ROffs.first);
        if LIt != LChain.end() {
            LOffs = operator(LIt).second.DecomposedLoc;
            LChild = operator(LIt).second.ChildFID;
            let mut LChildID: u32 = LChild.ID;
            let mut RChildID: u32 = RChild.ID;
            assert!(((LOffs.second != ROffs.second) || (LChildID == 0 || RChildID == 0) || self.isInSameSLocAddrSpace(self.getComposedLoc(LChild, 0), self.getComposedLoc(RChild, 0), null)), "Mixed local/loaded FileIDs with same include location?");
            IsBeforeInTUCache.setCommonLoc(LOffs.first, LOffs.second, ROffs.second, LChildID < RChildID);
            return make_pair(true, IsBeforeInTUCache.getCachedResult(LOffs.second, ROffs.second));
        }
        RChild = ROffs.first;
    }
        if !(!MoveUpTranslationUnitIncludeHierarchy(ROffs, *self)) { break; }
    }
    let mut LB: str = self.getBufferOrFake(LOffs.first, SourceLocation {}).getBufferIdentifier();
    let mut RB: str = self.getBufferOrFake(ROffs.first, SourceLocation {}).getBufferIdentifier();
    let mut LIsBuiltins: bool = LB == "<built-in>";
    let mut RIsBuiltins: bool = RB == "<built-in>";
    if LIsBuiltins || RIsBuiltins {
        if LIsBuiltins != RIsBuiltins {
            return make_pair(true, LIsBuiltins);
        }
        return make_pair(true, LOffs.first < ROffs.first);
    }
    let mut LIsAsm: bool = LB == "<inline asm>";
    let mut RIsAsm: bool = RB == "<inline asm>";
    if LIsAsm || RIsAsm {
        if LIsAsm != RIsAsm {
            return make_pair(true, RIsAsm);
        }
        assert!(LOffs.first == ROffs.first);
        return make_pair(true, false);
    }
    let mut LIsScratch: bool = LB == "<scratch space>";
    let mut RIsScratch: bool = RB == "<scratch space>";
    if LIsScratch || RIsScratch {
        if LIsScratch != RIsScratch {
            return make_pair(true, LIsScratch);
        }
        return make_pair(true, LOffs.second < ROffs.second);
    }
    llvm_unreachable_internal("Unsortable locations found", "P:/Goraw/llvm-project/clang/lib/Basic/SourceManager.cpp", 2139);
}

fn SourceManager::PrintStats(self: *SourceManager) {
    errs() << "\n*** Source Manager Stats:\n";
    errs() << self.FileInfos.len << " files mapped, " << self.MemBufferInfos.len << " mem buffers mapped.\n";
    errs() << self.LocalSLocEntryTable.len << " local SLocEntries allocated (" << capacity_in_bytes(self.LocalSLocEntryTable) << " bytes of capacity), " << self.NextLocalOffset << "B of SLoc address space used.\n";
    errs() << self.LoadedSLocEntryTable.len << " loaded SLocEntries allocated (" << capacity_in_bytes(self.LoadedSLocEntryTable) << " bytes of capacity), " << MaxLoadedOffset - self.CurrentLoadedOffset << "B of SLoc address space used.\n";
    let mut NumLineNumsComputed: u32 = 0;
    let mut NumFileBytesMapped: u32 = 0;
    for let mut I: fileinfo_iterator = self.fileinfo_begin();
let mut E: fileinfo_iterator = self.fileinfo_end(); I != E; operator(I) {
        NumLineNumsComputed += operator(I).second.SourceLineCache;
        NumFileBytesMapped += operator(I).second.getSizeBytesMapped();
    }
    let mut NumMacroArgsComputed: u32 = self.MacroArgsCacheMap.len;
    errs() << NumFileBytesMapped << " bytes of files mapped, " << NumLineNumsComputed << " files with line #'s computed, " << NumMacroArgsComputed << " files with macro args computed.\n";
    errs() << "FileID scans: " << self.NumLinearScans << " linear, " << self.NumBinaryProbes << " binary.\n";
}

fn SourceManager::dump(self: *SourceManager) {
    let mut out: *mut raw_ostream = errs();
    let mut DumpSLocEntry: Closure_2 = Closure_2 { out: &mut out };
    for let mut ID: u32 = 0;
let mut NumIDs: u32 = self.LocalSLocEntryTable.len; ID != NumIDs; ID += 1 {
        DumpSLocEntry.call(ID, self.LocalSLocEntryTable[ID], if ID == NumIDs - 1 { self.NextLocalOffset } else { self.LocalSLocEntryTable[ID + 1].getOffset() });
    }
    let mut NextStart: UIntTy> = UIntTy> {};
    for let mut Index: u32 = 0; Index != self.LoadedSLocEntryTable.len; Index += 1 {
        let mut ID: i32 = -Index as i32 - 2;
        if self.SLocEntryLoaded[Index] {
            DumpSLocEntry.call(ID, self.LoadedSLocEntryTable[Index], NextStart);
            NextStart = self.LoadedSLocEntryTable[Index].getOffset();
        } else {
            NextStart = nullopt;
        }
    }
}

fn SourceManager::noteSLocAddressSpaceUsage(self: *SourceManager, Diag: *mut DiagnosticsEngine, MaxNotes: optional<unsigned int>) {
    let mut Usage: UsageMap = UsageMap {};
    let mut CountedSize: u64 = 0;
    let mut AddUsageForFileID: Closure_3 = Closure_3 { cap_0: self, Usage: &mut Usage, CountedSize: &mut CountedSize };
    for let mut Index: u64 = 0; Index != self.LoadedSLocEntryTable.len; Index += 1 {
        AddUsageForFileID.call(get(-2 - Index));
    }
    for let mut Index: u64 = 0; Index != self.LocalSLocEntryTable.len; Index += 1 {
        AddUsageForFileID.call(get(Index));
    }
    let mut SortedUsage: FileEntry *, Info>, 0> = Usage.takeVector();
    let mut Cmp: Closure_4 = Closure_4 {};
    let mut SortedEnd: iterator = SortedUsage.end();
    if MaxNotes && SortedUsage.len > operator(MaxNotes) {
        SortedEnd = SortedUsage.begin() + operator(MaxNotes);
        nth_element(SortedUsage.begin(), SortedEnd, SortedUsage.end(), Cmp);
    }
    sort(SortedUsage.begin(), SortedEnd, Cmp);
    let mut LocalUsage: u64 = self.NextLocalOffset;
    let mut LoadedUsage: u64 = MaxLoadedOffset - self.CurrentLoadedOffset;
    let mut UsagePercent: i32 = 100.0 * LocalUsage + LoadedUsage / MaxLoadedOffset as i32;
    Diag.Report(note_total_sloc_usage) << LocalUsage << LoadedUsage << (LocalUsage + LoadedUsage) << UsagePercent;
    let mut ReportedSize: u64 = 0;
    for x in make_range(SortedUsage.begin(), SortedEnd) {
        Diag.Report(FileInfo.Loc, note_file_sloc_usage) << FileInfo.Inclusions << FileInfo.DirectSize << (FileInfo.TotalSize - FileInfo.DirectSize);
        ReportedSize += FileInfo.TotalSize;
    }
    if ReportedSize != CountedSize {
        Diag.Report(note_file_misc_sloc_usage) << (SortedUsage.end() - SortedEnd) << CountedSize - ReportedSize;
    }
}

fn ExternalSLocEntrySource::~ExternalSLocEntrySource(self) {}

fn SourceManager::getMemoryBufferSizes(self: *SourceManager) -> MemoryBufferSizes {
    let mut malloc_bytes: u64 = 0;
    let mut mmap_bytes: u64 = 0;
    for let mut i: u32 = 0;
let mut e: u32 = self.MemBufferInfos.len; i != e; i += 1 {
        if self.MemBufferInfos[i].getSizeBytesMapped() {
            sized_mapped;
        } else {
            match self.MemBufferInfos[i].getMemoryBufferKind() {
                MemoryBuffer_MMap => {
                    mmap_bytes += sized_mapped;
                },
                MemoryBuffer_Malloc => {
                    malloc_bytes += sized_mapped;
                },
            }
        }
    }
    return MemoryBufferSizes { malloc_bytes, mmap_bytes };
}

fn SourceManager::getDataStructureSizes(self: *SourceManager) -> u64 {
    let mut size: u64 = capacity_in_bytes(self.MemBufferInfos) + capacity_in_bytes(self.FileIDContentCaches) + capacity_in_bytes(self.LocalSLocEntryTable) + capacity_in_bytes(self.LoadedSLocEntryTable) + capacity_in_bytes(self.SLocEntryLoaded) + capacity_in_bytes(self.FileInfos);
    if self.OverriddenFilesInfo {
        size += capacity_in_bytes(operator(self.OverriddenFilesInfo).OverriddenFiles);
    }
    return size;
}

fn SourceManagerForFile::SourceManagerForFile(self, FileName: str, Content: str) {
    let mut InMemoryFileSystem: InMemoryFileSystem> = makeIntrusiveRefCnt();
    operator(InMemoryFileSystem).addFile(FileName, 0, getMemBuffer(Content, FileName, false), nullopt, nullopt, nullopt, nullopt);
    self.FileMgr = make_unique(FileSystemOptions {}, move(InMemoryFileSystem));
    self.DiagOpts = make_unique();
    self.Diagnostics = make_unique(create(), operator(self.DiagOpts));
    self.SourceMgr = make_unique(operator(self.Diagnostics), operator(self.FileMgr));
    let mut FE: FileEntryRef = cantFail(operator(self.FileMgr).getFileRef(FileName, false, true, true), null);
    let mut ID: FileID = operator(self.SourceMgr).createFileID(FE, SourceLocation {}, C_User, 0, 0);
    assert!(ID.isValid();
    operator(self.SourceMgr).setMainFileID(ID);
}

struct Closure_1 {
    cap_0: *SourceManager,
}

fn Closure_1::call(self: *Closure_1, FID: FileID) -> *FileID {
            return lower_bound(self.LoadedSLocEntryAllocBegin, FID, greater<FileID> {});
        }

struct Closure_2 {
    out: *mut raw_ostream,
}

unsafe fn Closure_2::call(self: *mut Closure_2, ID: i32, Entry: *SLocEntry, NextStart: UIntTy>) {
        (*self.out) << "SLocEntry <FileID " << ID << "> " << (if Entry.isFile() { "file" } else { "expansion" }) << " <SourceLocation " << Entry.getOffset() << ":";
        if NextStart {
            (*self.out) << operator(NextStart) << ">\n";
        } else {
            (*self.out) << "????>\n";
        }
        if Entry.isFile() {
            let mut FI: *FileInfo = Entry.getFile();
            if FI.NumCreatedFIDs {
                (*self.out) << "  covers <FileID " << ID << ":" << ID + FI.NumCreatedFIDs << ">\n";
            }
            if FI.getIncludeLoc().isValid() {
                (*self.out) << "  included from " << FI.getIncludeLoc().getOffset() << "\n";
            }
            let mut CC: *ContentCache = FI.getContentCache();
            (*self.out) << "  for " << (if CC.OrigEntry { operator(CC.OrigEntry).getName() } else { "<none>" }) << "\n";
            if CC.BufferOverridden {
                (*self.out) << "  contents overridden\n";
            }
            if CC.ContentsEntry != CC.OrigEntry {
                (*self.out) << "  contents from " << (if CC.ContentsEntry { operator(CC.ContentsEntry).getName() } else { "<none>" }) << "\n";
            }
        } else {
            let mut EI: *ExpansionInfo = Entry.getExpansion();
            (*self.out) << "  spelling from " << EI.getSpellingLoc().getOffset() << "\n";
            (*self.out) << "  macro " << (if EI.isMacroArgExpansion() { "arg" } else { "body" }) << " range <" << EI.getExpansionLocStart().getOffset() << ":" << EI.getExpansionLocEnd().getOffset() << ">\n";
        }
    }

struct Closure_3 {
    cap_0: *SourceManager,
    Usage: *mut UsageMap,
    CountedSize: *mut u64,
}

unsafe fn Closure_3::call(self: *mut Closure_3, ID: FileID) {
        let mut Size: u32 = self.getFileIDSize(ID) + 1;
        let mut FileStart: SourceLocation = self.getFileLoc(self.getComposedLoc(ID, 0));
        let mut FileLocID: FileID = self.getFileID(FileStart);
        let mut Entry: *FileEntry = self.getFileEntryForID(FileLocID);
        let mut EntryInfo: *mut Info = (*self.Usage)[Entry];
        if EntryInfo.Loc.isInvalid() {
            EntryInfo.Loc = FileStart;
        }
        if ID == FileLocID {
            EntryInfo.Inclusions += 1;
            EntryInfo.DirectSize += Size;
        }
        EntryInfo.TotalSize += Size;
        (*self.CountedSize) += Size;
    }

struct Closure_4 {}

fn Closure_4::call(self: *Closure_4, A: *value_type, B: *value_type) -> bool {
        return A.second.TotalSize > B.second.TotalSize || (A.second.TotalSize == B.second.TotalSize && A.second.Loc < B.second.Loc);
    }
