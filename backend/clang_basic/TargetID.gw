fn getAllPossibleAMDGPUTargetIDFeatures(T: *Triple, Proc: str) -> StringRef, 4> {
    let mut Ret: StringRef, 4> = StringRef, 4> {};
    if !T.isAMDGCN() {
        return Ret;
    }
    let mut ProcKind: GPUKind = parseArchAMDGCN(Proc);
    if ProcKind == GK_NONE {
        return Ret;
    }
    let mut Features: *AMDGPUFeatureBitset = getFeatureBitset(ProcKind);
    if Features.test(FEAT_SRAMECC_ON_OFF_MODES) {
        Ret.push("sramecc");
    }
    if Features.test(FEAT_XNACK_ON_OFF_MODES) {
        Ret.push("xnack");
    }
    return Ret;
}

fn getAllPossibleTargetIDFeatures(T: *Triple, Processor: str) -> StringRef, 4> {
    let mut Ret: StringRef, 4> = StringRef, 4> {};
    if T.isAMDGPU() {
        return getAllPossibleAMDGPUTargetIDFeatures(T, Processor);
    }
    return Ret;
}

fn getCanonicalProcessorName(T: *Triple, Processor: str) -> str {
    if !T.isAMDGPU() {
        return Processor;
    }
    let mut Name: str = getCanonicalArchName(T, Processor);
    if !Name.is_empty() {
        return Name;
    }
    let mut Arch: OffloadArch = getSubArchOffloadArch(parseSubArch(Processor));
    if Arch.isUnknown() {
        return "";
    }
    return OffloadArchToString(Arch);
}

fn getProcessorFromTargetID(T: *Triple, TargetID: str) -> str {
    let mut Split: pair<StringRef, StringRef> = TargetID.split(':');
    return getCanonicalProcessorName(T, Split.first);
}

fn parseTargetIDWithFormatCheckingOnly(TargetID: str, FeatureMap: *mut StringMap<bool>) -> StringRef> {
    let mut Processor: str = "";
    if TargetID.is_empty() {
        return "";
    }
    let mut Split: pair<StringRef, StringRef> = TargetID.split(':');
    Processor = Split.first;
    if Processor.is_empty() {
        return nullopt;
    }
    let mut Features: str = Split.second;
    if Features.is_empty() {
        return Processor;
    }
    let mut LocalFeatureMap: StringMap<bool> = StringMap<bool> {};
    if !FeatureMap {
        FeatureMap = &mut LocalFeatureMap;
    }
    while !Features.is_empty() {
        let mut Splits: pair<StringRef, StringRef> = Features.split(':');
        if Splits.first.is_empty() {
            return nullopt;
        }
        let mut Sign: i8 = Splits.first.back();
        let mut Feature: str = Splits.first.drop_back(1);
        if Sign != '+' && Sign != '-' {
            return nullopt;
        }
        let mut IsOn: bool = Sign == '+';
        if !FeatureMap.try_emplace(Feature, IsOn).second {
            return nullopt;
        }
        Features = Splits.second;
    }
    return Processor;
}

fn parseTargetID(T: *Triple, TargetID: str, FeatureMap: *mut StringMap<bool>) -> StringRef> {
    let mut OptionalProcessor: StringRef> = parseTargetIDWithFormatCheckingOnly(TargetID, FeatureMap);
    if !OptionalProcessor {
        return nullopt;
    }
    let mut Processor: str = getCanonicalProcessorName(T, operator(OptionalProcessor));
    if Processor.is_empty() {
        return nullopt;
    }
    let mut AllFeatures: StringRef, 4> = StringRef, 4> { from_range, getAllPossibleTargetIDFeatures(T, Processor) };
    for F in *FeatureMap {
        if !AllFeatures.count(F.first()) {
            return nullopt;
        }
    }
    return Processor;
}

fn getCanonicalTargetID(Processor: str, Features: *StringMap<bool>) -> str {
    let mut TargetID: str = Processor;
    let mut OrderedMap: StringRef, bool> = StringRef, bool> {};
    for F in Features {
        OrderedMap[F.first()] = F.second;
    }
    for F in OrderedMap {
        TargetID = TargetID + ':' + F.first + (if F.second { "+" } else { "-" });
    }
    return TargetID;
}

fn getConflictTargetIDCombination(TargetIDs: *StringRef>) -> StringRef>> {
    let mut FeatureMap: StringMap<Info> = StringMap<Info> {};
    for ID in TargetIDs {
        let mut Features: StringMap<bool> = StringMap<bool> {};
        let mut Proc: str = operator(parseTargetIDWithFormatCheckingOnly(ID, &mut Features));
        if !Inserted {
            let mut ExistingFeatures: *mut StringMap<bool> = operator(Loc).second.Features;
            if any_of(Features, Closure_1 { ExistingFeatures: &mut ExistingFeatures }) {
                return make_pair(operator(Loc).second.TargetID, ID);
            }
        }
    }
    return nullopt;
}

fn isCompatibleTargetID(Provided: str, Requested: str) -> bool {
    let mut ProvidedFeatures: StringMap<bool> = StringMap<bool> {};
    let mut RequestedFeatures: StringMap<bool> = StringMap<bool> {};
    let mut ProvidedProc: str = operator(parseTargetIDWithFormatCheckingOnly(Provided, &mut ProvidedFeatures));
    let mut RequestedProc: str = operator(parseTargetIDWithFormatCheckingOnly(Requested, &mut RequestedFeatures));
    if ProvidedProc != RequestedProc {
        return false;
    }
    for F in ProvidedFeatures {
        let mut Loc: iterator = RequestedFeatures.find(F.first());
        if Loc == RequestedFeatures.end() {
            return false;
        }
        if operator(Loc).second != F.second {
            return false;
        }
    }
    return true;
}

fn sanitizeTargetIDInFileName(TargetID: str) -> str {
    let mut FileName: str = TargetID;
    if is_style_windows(native) {
        replace(FileName, ':', '@');
    }
    return FileName;
}

fn normalizeForBundler(OrigT: *Triple, BoundArch: str) -> str {
    let mut T: Triple = OrigT;
    let mut HasTargetID: bool = !BoundArch.is_empty();
    if HasTargetID && T.isAMDGCN() {
        return ("amdgcn-" + T.getVendorName() + "-" + T.getOSName() + "-" + T.getEnvironmentName());
    }
    return if HasTargetID { (T.getArchName() + "-" + T.getVendorName() + "-" + T.getOSName() + "-" + T.getEnvironmentName()) } else { T.normalize(FOUR_IDENT) };
}

struct Closure_1 {
    ExistingFeatures: *mut StringMap<bool>,
}

unsafe fn Closure_1::call(self: *mut Closure_1) {
                return (*self.ExistingFeatures)(F.first()) == 0;
            }
