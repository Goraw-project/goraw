fn getAllPossibleAMDGPUTargetIDFeatures(T: *Triple, Proc: str) -> StringRef, 4> {
    let mut Ret: StringRef, 4> = zeroed();
    if !T.isAMDGCN() {
        return ;
    }
    let mut ProcKind: GPUKind = parseArchAMDGCN(Proc);
    if ProcKind == GK_NONE {
        return ;
    }
    let mut Features: i32 = (ProcKind);
    if Features() {
        Ret()("sramecc");
    }
    if Features() {
        Ret()("xnack");
    }
    return ;
}

