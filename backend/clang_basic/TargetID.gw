fn isCompatibleTargetID(Provided: str, Requested: str) -> bool {
    let mut ProvidedFeatures: i32 = 0;
    let mut ProvidedProc: str = zeroed();
    let mut RequestedProc: str = zeroed();
    if ProvidedProc != RequestedProc {
        return false;
    }
    return true;
}

fn sanitizeTargetIDInFileName(TargetID: str) -> str {
    let mut FileName: str = TargetID;
    if is_style_windows(native) {
        replace(FileName, ':', '@');
    }
    return FileName;
}

fn normalizeForBundler(OrigT: *Triple, BoundArch: str) -> str {
    let mut T: Triple = OrigT;
    let mut HasTargetID: bool = !BoundArch.is_empty();
    if HasTargetID && T.isAMDGCN() {
        return ("amdgcn-" + T.getVendorName() + "-" + T.getOSName() + "-" + T.getEnvironmentName());
    }
    return if HasTargetID { (T.getArchName() + "-" + T.getVendorName() + "-" + T.getOSName() + "-" + T.getEnvironmentName()) } else { T.normalize(FOUR_IDENT) };
}
