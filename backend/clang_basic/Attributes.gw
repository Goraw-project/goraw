fn canonicalizeScopeName(Name: str) -> str {
    if Name == "__gnu__" {
        return "gnu";
    }
    if Name == "_Clang" {
        return "clang";
    }
    return Name;
}

fn canonicalizeAttrName(Name: str) -> str {
    if Name.len >= 4 && Name.starts_with("__") && Name.ends_with("__") {
        return Name[2..2 + Name.len - 4];
    }
    return Name;
}

