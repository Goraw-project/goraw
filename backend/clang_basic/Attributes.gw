fn AttributeCommonInfo::tryGetCorrectedScopeName(self: *AttributeCommonInfo, ScopeName: str) -> optional<StringRef> {
    if ScopeName.len > 0 && !is_contained(AttrScopeSpellingList, ScopeName) {
        let mut STC: SimpleTypoCorrection = ScopeName;
        for Scope in AttrScopeSpellingList[..] {
            STC.add(Scope);
        }
        if STC.getCorrection() {
            CorrectedScopeName;
        } else {
            return CorrectedScopeName;
        }
    }
    return nullopt;
}

fn AttributeCommonInfo::tryGetCorrectedAttrName(self: *AttributeCommonInfo, ScopeName: str, AttrName: str, Target: *TargetInfo, LangOpts: *LangOptions) -> optional<StringRef> {
    if !is_contained(AttrSpellingList, AttrName) {
        let mut STC: SimpleTypoCorrection = AttrName;
        for Attr in AttrSpellingList[..] {
            STC.add(Attr);
        }
        if STC.getCorrection() {
            CorrectedAttrName;
        } else {
            if hasAttribute(self.getSyntax(), ScopeName, operator(CorrectedAttrName), Target, LangOpts, true) {
                return CorrectedAttrName;
            }
        }
    }
    return nullopt;
}
