fn canonicalizeScopeName(Name: str) -> str {
    if Name == "__gnu__" {
        return "gnu";
    }
    if Name == "_Clang" {
        return "clang";
    }
    return Name;
}

fn canonicalizeAttrName(Name: str) -> str {
    if Name.len >= 4 && Name.starts_with("__") && Name.ends_with("__") {
        return Name[2..2 + Name.len - 4];
    }
    return Name;
}

fn hasAttributeImpl(Syntax: Syntax, Name: str, ScopeName: str, Target: *TargetInfo, LangOpts: *LangOptions) -> i32 {
    return 0;
}

fn hasAttribute(Syntax: Syntax, ScopeName: str, Name: str, Target: *TargetInfo, LangOpts: *LangOptions, CheckPlugins: bool) -> i32 {
    ScopeName = canonicalizeScopeName(ScopeName);
    Name = canonicalizeAttrName(Name);
    if LangOpts() && ScopeName == "omp" && (Name == "directive" || Name == "sequence") {
        return 1;
    }
    let mut res: i32 = hasAttributeImpl(Syntax, Name, ScopeName, Target, LangOpts);
    if res {
        return res;
    }
    if CheckPlugins {}
    return 0;
}

fn hasAttribute(Syntax: Syntax, Scope: *IdentifierInfo, Attr: *IdentifierInfo, Target: *TargetInfo, LangOpts: *LangOptions, CheckPlugins: bool) -> i32 {
    return hasAttribute(Syntax, if Scope { Scope.getName() } else { "" }, Attr.getName(), Target, LangOpts, CheckPlugins);
}

fn hasAttribute(Syntax: Syntax, Scope: *IdentifierInfo, Attr: *IdentifierInfo, Target: *TargetInfo, LangOpts: *LangOptions) -> i32 {
    return hasAttribute(Syntax, Scope, Attr, Target, LangOpts, true);
}

fn getSubjectMatchRuleSpelling(Rule: SubjectMatchRule) -> *u8 {
    match Rule {

    }
    llvm_unreachable_internal("Invalid subject match rule", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\Attributes.cpp", 104);
}

fn normalizeAttrScopeName(ScopeName: str, SyntaxUsed: Syntax) -> str {
    if SyntaxUsed == AS_CXX11 || SyntaxUsed == AS_C23 {
        return canonicalizeScopeName(ScopeName);
    }
    return ScopeName;
}

fn normalizeAttrScopeName(ScopeName: *IdentifierInfo, SyntaxUsed: Syntax) -> str {
    if ScopeName {
        return normalizeAttrScopeName(ScopeName.getName(), SyntaxUsed);
    }
    return "";
}

fn normalizeAttrName(AttrName: str, NormalizedScopeName: str, SyntaxUsed: Syntax) -> str {
    let mut ShouldNormalize: bool = SyntaxUsed == AS_GNU || ((SyntaxUsed == AS_CXX11 || SyntaxUsed == AS_C23) && (NormalizedScopeName.is_empty() || NormalizedScopeName == "gnu" || NormalizedScopeName == "clang"));
    if ShouldNormalize {
        return canonicalizeAttrName(AttrName);
    }
    return AttrName;
}

fn AttributeCommonInfo::getNormalizedScopeName(self: *AttributeCommonInfo) -> str {
    return normalizeAttrScopeName(self.getScopeName(), self.getSyntax());
}

fn AttributeCommonInfo::getNormalizedAttrName(self: *AttributeCommonInfo, ScopeName: str) -> str {
    return normalizeAttrName(self.getAttrName().getName(), ScopeName, self.getSyntax());
}

fn AttributeCommonInfo::isGNUScope(self: *AttributeCommonInfo) -> bool {
    return self.AttrScope.isValid() && (self.AttrScope.getName().isStr("gnu") || self.AttrScope.getName().isStr("__gnu__"));
}

fn AttributeCommonInfo::isClangScope(self: *AttributeCommonInfo) -> bool {
    return self.AttrScope.isValid() && (self.AttrScope.getName().isStr("clang") || self.AttrScope.getName().isStr("_Clang"));
}

fn normalizeName(AttrName: str, ScopeName: str, SyntaxUsed: Syntax) -> str {
    let mut StrAttrName: str = if SyntaxUsed == AS_HLSLAnnotation { AttrName.lower() } else { AttrName };
    let mut FullName: str = zeroed();
    if !ScopeName.is_empty() {
        assert!(SyntaxUsed == AS_CXX11 || SyntaxUsed == AS_C23);
        FullName() += "::";
    }
    FullName() += StrAttrName;
    return ;
}

fn normalizeName(Name: *IdentifierInfo, Scope: *IdentifierInfo, SyntaxUsed: Syntax) -> str {
    let mut ScopeName: str = normalizeAttrScopeName(Scope, SyntaxUsed);
    let mut AttrName: str = normalizeAttrName(Name.getName(), ScopeName, SyntaxUsed);
}

fn AttributeCommonInfo::getParsedKind(self, Name: *IdentifierInfo, ScopeName: *IdentifierInfo, SyntaxUsed: Syntax) -> Kind {
    let mut Kind: Kind = zeroed();
    return Kind;
}

fn AttributeCommonInfo::getCXX11AttrArgsInfo(self, Name: *IdentifierInfo) -> AttrArgsInfo {
    let mut AttrName: str = normalizeAttrName(Name.getName(), "", AS_CXX11);
}

fn AttributeCommonInfo::getNormalizedFullName(self: *AttributeCommonInfo) -> str {}

fn AttributeCommonInfo::getNormalizedFullName(self: *AttributeCommonInfo, ScopeName: str, AttrName: str) -> str {}

fn AttributeCommonInfo::getNormalizedRange(self: *AttributeCommonInfo) -> SourceRange {
    return if self.hasScope() { SourceRange { B: self.AttrScope.getNameLoc(), E: self.AttrRange.getEnd() } } else { self.AttrRange };
}

fn getScopeFromNormalizedScopeName(ScopeName: str) -> Scope {}

fn AttributeCommonInfo::calculateAttributeSpellingListIndex(self: *AttributeCommonInfo) -> u32 {
    if self.getParsedKind() == UnknownAttribute {
        return 0;
    }
    let mut Syntax: Syntax = self.getSyntax() as Syntax;
    let mut ScopeName: str = normalizeAttrScopeName(self.getScopeName(), Syntax);
    let mut Name: str = normalizeAttrName(self.getAttrName().getName(), ScopeName, Syntax);
    let mut ComputedScope: Scope = getScopeFromNormalizedScopeName(ScopeName);
}

const AttrSpellingList: [0]char *const = [0]char *const {};

const AttrScopeSpellingList: [0]char *const = [0]char *const {};

fn AttributeCommonInfo::tryGetCorrectedScopeName(self: *AttributeCommonInfo, ScopeName: str) -> optional<StringRef> {
    if ScopeName.len > 0 && !is_contained(AttrScopeSpellingList, ScopeName) {
        let mut STC: SimpleTypoCorrection = ScopeName;
        for Scope in AttrScopeSpellingList[..] {
            STC.add(Scope);
        }
        if  {
            return ;
        }
    }
    return nullopt();
}

fn AttributeCommonInfo::tryGetCorrectedAttrName(self: *AttributeCommonInfo, ScopeName: str, AttrName: str, Target: *TargetInfo, LangOpts: *LangOptions) -> optional<StringRef> {
    if !is_contained(AttrSpellingList, AttrName) {
        let mut STC: SimpleTypoCorrection = AttrName;
        for Attr in AttrSpellingList[..] {
            STC.add(Attr);
        }
        if  {
            if hasAttribute(self.getSyntax(), ScopeName, *, Target, LangOpts, true) {
                return ;
            }
        }
    }
    return nullopt();
}
