fn parseXRayInstrValue(Value: str) -> XRayInstrMask {
    let mut ParsedKind: XRayInstrMask = Value.Case("all", All).Case("custom", Custom).Case("function", FunctionEntry | FunctionExit).Case("function-entry", FunctionEntry).Case("function-exit", FunctionExit).Case("typed", Typed).Case("none", None).Default(None);
    return ParsedKind;
}

fn serializeXRayInstrValue(Set: XRayInstrSet, Values: *mut SmallVectorImpl<StringRef>) {
    if Set.Mask == All {
        Values.push("all");
        return;
    }
    if Set.Mask == None {
        Values.push("none");
        return;
    }
    if Set.has(Custom) {
        Values.push("custom");
    }
    if Set.has(Typed) {
        Values.push("typed");
    }
    if Set.has(FunctionEntry) && Set.has(FunctionExit) {
        Values.push("function");
    } else if Set.has(FunctionEntry) {
        Values.push("function-entry");
    } else if Set.has(FunctionExit) {
        Values.push("function-exit");
    }
}
