        OO_Coawait => {
            return "co_await";
        },
    }
    llvm_unreachable_internal("Invalid OverloadedOperatorKind!", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\IdentifierTable.cpp", 788);
}

fn getNullabilitySpelling(kind: NullabilityKind, isContextSensitive: bool) -> str {
    match kind {
        NonNull => {
            return if isContextSensitive { "nonnull" } else { "_Nonnull" };
        },
        Nullable => {
            return if isContextSensitive { "nullable" } else { "_Nullable" };
        },
        NullableResult => {
            assert!(!isContextSensitive, "_Nullable_result isn't supported as context-sensitive keyword");
        },
        Unspecified => {
            return if isContextSensitive { "null_unspecified" } else { "_Null_unspecified" };
        },
    }
    llvm_unreachable_internal("Unknown nullability kind.", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\IdentifierTable.cpp", 808);
}

fn op_<<(OS: *mut raw_ostream, NK: NullabilityKind) -> *mut raw_ostream {
    match NK {
        NonNull => {
            return OS << "NonNull";
        },
        Nullable => {
            return OS << "Nullable";
        },
        NullableResult => {
            return OS << "NullableResult";
        },
        Unspecified => {
            return OS << "Unspecified";
        },
    }
    llvm_unreachable_internal("Unknown nullability kind.", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\IdentifierTable.cpp", 823);
}

