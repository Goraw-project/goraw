fn IdentifierInfo::isKeyword(self: *IdentifierInfo, LangOpts: *LangOptions) -> bool {
    match getTokenKwStatus(LangOpts, self.getTokenID()) {
        KS_Enabled => {
            KS_Extension;
        },
        _ => {
            return false;
        },
    }
}

fn IdentifierInfo::isCPlusPlusKeyword(self: *IdentifierInfo, LangOpts: *LangOptions) -> bool {
    if !LangOpts() || !self.isKeyword(LangOpts) {
        return false;
    }
    let mut LangOptsNoCPP: LangOptions = LangOpts;
    LangOptsNoCPP() = false;
    LangOptsNoCPP() = false;
    LangOptsNoCPP() = false;
    return !self.isKeyword(LangOptsNoCPP);
}

fn IdentifierInfo::isReserved(self: *IdentifierInfo, LangOpts: *LangOptions) -> ReservedIdentifierStatus {
    let mut Name: str = self.getName();
    if Name.len <= 1 {
        return NotReserved;
    }
    if Name[0] == '_' {
        if Name[1] == '_' {
            return StartsWithDoubleUnderscore;
        }
        if 'A' <= Name[1] && Name[1] <= 'Z' {
            return StartsWithUnderscoreFollowedByCapitalLetter;
        }
        return StartsWithUnderscoreAtGlobalScope;
    }
    if LangOpts() && Name.contains("__") {
        return ContainsDoubleUnderscore;
    }
    return NotReserved;
}

fn IdentifierInfo::isReservedLiteralSuffixId(self: *IdentifierInfo) -> ReservedLiteralSuffixIdStatus {
    let mut Name: str = self.getName();
    if Name[0] != '_' {
        return NotStartsWithUnderscore;
    }
    if Name.contains("__") {
        return ContainsDoubleUnderscore;
    }
    return NotReserved;
}

fn IdentifierInfo::deuglifiedName(self: *IdentifierInfo) -> str {
    let mut Name: str = self.getName();
    if Name.len >= 2 && Name.front() == '_' && (Name[1] == '_' || (Name[1] >= 'A' && Name[1] <= 'Z')) {
        return Name.ltrim('_');
    }
    return Name;
}

fn IdentifierInfo::getPPKeywordID(self: *IdentifierInfo) -> PPKeywordKind {
    let mut Len: u32 = self.getLength();
    if Len < 2 {
        return pp_not_keyword;
    }
    let mut Name: *u8 = self.getNameStart();
    if Name[0] == '_' && self.isImportKeyword() {
        return pp___preprocessed_import;
    }
    if Name[0] == '_' && self.isModuleKeyword() {
        return pp___preprocessed_module;
    }
    match (Len << 6) + (((Name[0] - 'a') - (Name[2] - 'a')) & 63) {
        _ => {
            return pp_not_keyword;
        },
        (2 << 6) + ((('i' - 'a') - (0 - 'a')) & 63) => {
            return if memcmp(Name, "if", 2) { pp_not_keyword } else { pp_if };
        },
        (4 << 6) + ((('e' - 'a') - ('i' - 'a')) & 63) => {
            return if memcmp(Name, "elif", 4) { pp_not_keyword } else { pp_elif };
        },
        (4 << 6) + ((('e' - 'a') - ('s' - 'a')) & 63) => {
            return if memcmp(Name, "else", 4) { pp_not_keyword } else { pp_else };
        },
        (4 << 6) + ((('l' - 'a') - ('n' - 'a')) & 63) => {
            return if memcmp(Name, "line", 4) { pp_not_keyword } else { pp_line };
        },
        (4 << 6) + ((('s' - 'a') - ('c' - 'a')) & 63) => {
            return if memcmp(Name, "sccs", 4) { pp_not_keyword } else { pp_sccs };
        },
        (5 << 6) + ((('e' - 'a') - ('b' - 'a')) & 63) => {
            return if memcmp(Name, "embed", 5) { pp_not_keyword } else { pp_embed };
        },
        (5 << 6) + ((('e' - 'a') - ('d' - 'a')) & 63) => {
            return if memcmp(Name, "endif", 5) { pp_not_keyword } else { pp_endif };
        },
        (5 << 6) + ((('e' - 'a') - ('r' - 'a')) & 63) => {
            return if memcmp(Name, "error", 5) { pp_not_keyword } else { pp_error };
        },
        (5 << 6) + ((('i' - 'a') - ('e' - 'a')) & 63) => {
            return if memcmp(Name, "ident", 5) { pp_not_keyword } else { pp_ident };
        },
        (5 << 6) + ((('i' - 'a') - ('d' - 'a')) & 63) => {
            return if memcmp(Name, "ifdef", 5) { pp_not_keyword } else { pp_ifdef };
        },
        (5 << 6) + ((('u' - 'a') - ('d' - 'a')) & 63) => {
            return if memcmp(Name, "undef", 5) { pp_not_keyword } else { pp_undef };
        },
        (6 << 6) + ((('a' - 'a') - ('s' - 'a')) & 63) => {
            return if memcmp(Name, "assert", 6) { pp_not_keyword } else { pp_assert };
        },
        (6 << 6) + ((('d' - 'a') - ('f' - 'a')) & 63) => {
            return if memcmp(Name, "define", 6) { pp_not_keyword } else { pp_define };
        },
        (6 << 6) + ((('i' - 'a') - ('n' - 'a')) & 63) => {
            return if memcmp(Name, "ifndef", 6) { pp_not_keyword } else { pp_ifndef };
        },
        (6 << 6) + ((('i' - 'a') - ('p' - 'a')) & 63) => {
            return if memcmp(Name, "import", 6) { pp_not_keyword } else { pp_import };
        },
        (6 << 6) + ((('m' - 'a') - ('d' - 'a')) & 63) => {
            return if memcmp(Name, "module", 6) { pp_not_keyword } else { pp_module };
        },
        (6 << 6) + ((('p' - 'a') - ('a' - 'a')) & 63) => {
            return if memcmp(Name, "pragma", 6) { pp_not_keyword } else { pp_pragma };
        },
        (7 << 6) + ((('d' - 'a') - ('f' - 'a')) & 63) => {
            return if memcmp(Name, "defined", 7) { pp_not_keyword } else { pp_defined };
        },
        (7 << 6) + ((('e' - 'a') - ('i' - 'a')) & 63) => {
            return if memcmp(Name, "elifdef", 7) { pp_not_keyword } else { pp_elifdef };
        },
        (7 << 6) + ((('i' - 'a') - ('c' - 'a')) & 63) => {
            return if memcmp(Name, "include", 7) { pp_not_keyword } else { pp_include };
        },
        (7 << 6) + ((('w' - 'a') - ('r' - 'a')) & 63) => {
            return if memcmp(Name, "warning", 7) { pp_not_keyword } else { pp_warning };
        },
        (8 << 6) + ((('e' - 'a') - ('i' - 'a')) & 63) => {
            return if memcmp(Name, "elifndef", 8) { pp_not_keyword } else { pp_elifndef };
        },
        (8 << 6) + ((('u' - 'a') - ('a' - 'a')) & 63) => {
            return if memcmp(Name, "unassert", 8) { pp_not_keyword } else { pp_unassert };
        },
        (12 << 6) + ((('i' - 'a') - ('c' - 'a')) & 63) => {
            return if memcmp(Name, "include_next", 12) { pp_not_keyword } else { pp_include_next };
        },
        (14 << 6) + ((('_' - 'a') - ('p' - 'a')) & 63) => {
            return if memcmp(Name, "__public_macro", 14) { pp_not_keyword } else { pp___public_macro };
        },
        (15 << 6) + ((('_' - 'a') - ('p' - 'a')) & 63) => {
            return if memcmp(Name, "__private_macro", 15) { pp_not_keyword } else { pp___private_macro };
        },
        (16 << 6) + ((('_' - 'a') - ('i' - 'a')) & 63) => {
            return if memcmp(Name, "__include_macros", 16) { pp_not_keyword } else { pp___include_macros };
        },
    }
}

fn IdentifierTable::PrintStats(self: *IdentifierTable) {
    let mut NumBuckets: u32 = 0;
    let mut NumIdentifiers: u32 = 0;
    let mut NumEmptyBuckets: u32 = NumBuckets - NumIdentifiers;
    let mut AverageIdentifierSize: u32 = 0;
    let mut MaxIdentifierLength: u32 = 0;
    for let mut I: i32 = 0; ;  {
        
    }
    fprintf((__acrt_iob_func(2)), "# Identifiers:   %d\n", NumIdentifiers);
    fprintf((__acrt_iob_func(2)), "# Empty Buckets: %d\n", NumEmptyBuckets);
    fprintf((__acrt_iob_func(2)), "Hash density (#identifiers per bucket): %f\n", NumIdentifiers / NumBuckets as f64);
    fprintf((__acrt_iob_func(2)), "Ave identifier length: %f\n", (AverageIdentifierSize / NumIdentifiers as f64));
    fprintf((__acrt_iob_func(2)), "Max identifier length: %d\n", MaxIdentifierLength);
}

fn Selector::isKeywordSelector(self: *Selector, Names: ArrayRef<StringRef>) -> bool {
    assert!(!(), "must have >= 1 selector slots");
    if self.getNumArgs() != () {
        return false;
    }
    for let mut I: u32 = 0;
let mut E: u32 = (); I != E; I += 1 {
        if self.getNameForSlot(I) != [I] {
            return false;
        }
    }
    return true;
}

fn Selector::isUnarySelector(self: *Selector, Name: str) -> bool {
    return self.isUnarySelector() && self.getNameForSlot(0) == Name;
}

fn Selector::getNumArgs(self: *Selector) -> u32 {
    let mut IIF: u32 = self.getIdentifierInfoFlag();
    if IIF <= ZeroArg {
        return 0;
    }
    if IIF == OneArg {
        return 1;
    }
    let mut SI: *mut MultiKeywordSelector = self.getMultiKeywordSelector();
    return SI.getNumArgs();
}

fn Selector::getIdentifierInfoForSlot(self: *Selector, argIndex: u32) -> *IdentifierInfo {
    if self.getIdentifierInfoFlag() < MultiArg {
        assert!(argIndex == 0, "illegal keyword index");
        return self.getAsIdentifierInfo();
    }
    let mut SI: *mut MultiKeywordSelector = self.getMultiKeywordSelector();
    return SI.getIdentifierInfoForSlot(argIndex);
}

fn Selector::getNameForSlot(self: *Selector, argIndex: u32) -> str {
    let mut II: *IdentifierInfo = self.getIdentifierInfoForSlot(argIndex);
    return if II { II.getName() } else { "" };
}

fn MultiKeywordSelector::getName(self: *MultiKeywordSelector) -> str {
    let mut Str: str = zeroed();
    let mut OS: raw_svector_ostream = Str();
    for let mut I: keyword_iterator = self.keyword_begin();
let mut E: keyword_iterator = self.keyword_end(); I != E; I += 1 {
        if *I {
            OS << (*I).getName();
        }
        OS << ':';
    }
    return OS;
}

fn Selector::getAsString(self: *Selector) -> str {
    if self.isNull() {
        return "<null selector>";
    }
    if self.getIdentifierInfoFlag() < MultiArg {
        let mut II: *IdentifierInfo = self.getAsIdentifierInfo();
        if self.getNumArgs() == 0 {
            assert!(II, "If the number of arguments is 0 then II is guaranteed to not be null.");
            return II.getName();
        }
        if !II {
            return ":";
        }
        return II.getName();
    }
    return self.getMultiKeywordSelector().getName();
}

fn Selector::print(self: *Selector, OS: *mut raw_ostream) {
    OS << self.getAsString();
}

fn Selector::dump(self: *Selector) {
    self.print;
}

fn startsWithWord(name: str, word: str) -> bool {
    if name.len < word.len {
        return false;
    }
    return ((name.len == word.len || !isLowercase(name[word.len])) && name.starts_with(word));
}

fn Selector::getMethodFamilyImpl(self, sel: Selector) -> ObjCMethodFamily {
    let mut first: *IdentifierInfo = sel.getIdentifierInfoForSlot(0);
    if !first {
        return OMF_None;
    }
    let mut name: str = first.getName();
    if sel.isUnarySelector() {
        if name == "autorelease" {
            return OMF_autorelease;
        }
        if name == "dealloc" {
            return OMF_dealloc;
        }
        if name == "finalize" {
            return OMF_finalize;
        }
        if name == "release" {
            return OMF_release;
        }
        if name == "retain" {
            return OMF_retain;
        }
        if name == "retainCount" {
            return OMF_retainCount;
        }
        if name == "self" {
            return OMF_self;
        }
        if name == "initialize" {
            return OMF_initialize;
        }
    }
    if name == "performSelector" || name == "performSelectorInBackground" || name == "performSelectorOnMainThread" {
        return OMF_performSelector;
    }
    name = name.ltrim('_');
    if name.is_empty() {
        return OMF_None;
    }
    match name.front() {
        'a' => {
            if startsWithWord(name, "alloc") {
                return OMF_alloc;
            }
        },
        'c' => {
            if startsWithWord(name, "copy") {
                return OMF_copy;
            }
        },
        'i' => {
            if startsWithWord(name, "init") {
                return OMF_init;
            }
        },
        'm' => {
            if startsWithWord(name, "mutableCopy") {
                return OMF_mutableCopy;
            }
        },
        'n' => {
            if startsWithWord(name, "new") {
                return OMF_new;
            }
        },
        _ => {
            break;
        },
    }
    return OMF_None;
}

fn Selector::getInstTypeMethodFamily(self, sel: Selector) -> ObjCInstanceTypeFamily {
    let mut first: *IdentifierInfo = sel.getIdentifierInfoForSlot(0);
    if !first {
        return OIT_None;
    }
    let mut name: str = first.getName();
    if name.is_empty() {
        return OIT_None;
    }
    match name.front() {
        'a' => {
            if startsWithWord(name, "array") {
                return OIT_Array;
            }
        },
        'd' => {
            if startsWithWord(name, "default") {
                return OIT_ReturnsSelf;
            }
        },
        's' => {
            if startsWithWord(name, "shared") {
                return OIT_ReturnsSelf;
            }
        },
        'i' => {
            if startsWithWord(name, "init") {
                return OIT_Init;
            }
        },
        _ => {
            break;
        },
    }
    return OIT_None;
}

fn Selector::getStringFormatFamilyImpl(self, sel: Selector) -> ObjCStringFormatFamily {
    let mut first: *IdentifierInfo = sel.getIdentifierInfoForSlot(0);
    if !first {
        return SFF_None;
    }
    let mut name: str = first.getName();
    match name.front() {
        'a' => {
            if name == "appendFormat" {
                return SFF_NSString;
            }
        },
        'i' => {
            if name == "initWithFormat" {
                return SFF_NSString;
            }
        },
        'l' => {
            if name == "localizedStringWithFormat" {
                return SFF_NSString;
            }
        },
        's' => {
            if name == "stringByAppendingFormat" || name == "stringWithFormat" {
                return SFF_NSString;
            }
        },
    }
    return SFF_None;
}

struct SelectorTableImpl {
    Table: i32,
    Allocator: i32,
}

fn getSelectorTableImpl(P: *mut void) -> *mut SelectorTableImpl {
    return *P as *mut SelectorTableImpl;
}

fn SelectorTable::constructSetterName(self, Name: str) -> str {
    let mut SetterName: str = zeroed();
    SetterName() += Name;
    SetterName()[3] = toUppercase([3]);
    return ;
}

fn SelectorTable::constructSetterSelector(self, Idents: *mut IdentifierTable, SelTable: *mut SelectorTable, Name: *IdentifierInfo) -> Selector {
    let mut SetterName: *mut IdentifierInfo = operator&(Idents((Name.getName())));
    return SelTable.getUnarySelector(SetterName);
}

fn SelectorTable::getPropertyNameFromSetterSelector(self, Sel: Selector) -> str {
    let mut Name: str = Sel.getNameForSlot(0);
    assert!(Name.starts_with("set"), "invalid setter name");
    return (toLowercase(Name[3]) + Name.drop_front(4));
}

fn SelectorTable::getTotalMemory(self: *SelectorTable) -> u64 {
    let mut SelTabImpl: *mut SelectorTableImpl = getSelectorTableImpl(self.Impl);
    return SelTabImpl()();
}

fn SelectorTable::getSelector(self, nKeys: u32, IIV: **mut IdentifierInfo) -> Selector {
    if nKeys < 2 {
        return Selector { IIV[0], nKeys };
    }
    let mut SelTabImpl: *mut SelectorTableImpl = getSelectorTableImpl(self.Impl);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if SelTabImpl()(IIV(nKeys), InsertToken) {
        SI;
    } else {
        return SI;
    }
    let mut Size: u32 =  + nKeys * ;
    let mut SI: *mut MultiKeywordSelector = SelTabImpl()(Size, alignof) as *mut MultiKeywordSelector;
    MultiKeywordSelector { ExtraKindOrNumArgs: nKeys, FoldingSetHash: IIV };
    SelTabImpl()(SI, InsertToken);
    return SI;
}

fn SelectorTable::SelectorTable(self) {
    self.Impl = SelectorTableImpl {};
}

fn SelectorTable::~SelectorTable(self) {
    &mut getSelectorTableImpl(self.Impl);
}

