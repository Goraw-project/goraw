fn IdentifierIterator::~IdentifierIterator(self) {}

fn IdentifierInfoLookup::~IdentifierInfoLookup(self) {}

struct EmptyLookupIterator {
}

fn EmptyLookupIterator::Next(self) -> str {
    return "";
}

fn IdentifierInfoLookup::getIdentifiers(self) -> *mut IdentifierIterator {
    return EmptyLookupIterator {};
}

fn IdentifierTable::IdentifierTable(self, LangOpts: *LangOptions, ExternalLookup: *mut IdentifierInfoLookup) {
    self.AddKeywords(LangOpts);
}

fn getKeywordStatusHelper(LangOpts: *LangOptions, Flag: TokenKey) -> KeywordStatus {
    assert!((Flag & ~(Flag - 1)) == Flag, "Multiple bits set?");
    match Flag {
        KEYC99 => {
            if LangOpts.C99 {
                return KS_Enabled;
            }
        },
        KEYC23 => {
            if LangOpts.C23 {
                return KS_Enabled;
            }
        },
        KEYCXX => {
            return if LangOpts.CPlusPlus { KS_Enabled } else { KS_Unknown };
        },
        KEYCXX11 => {
            if LangOpts.CPlusPlus11 {
                return KS_Enabled;
            }
        },
        KEYCXX20 => {
            if LangOpts.CPlusPlus20 {
                return KS_Enabled;
            }
        },
        KEYGNU => {
            return if LangOpts.GNUKeywords { KS_Extension } else { KS_Unknown };
        },
        KEYMS => {
            return if LangOpts.MicrosoftExt { KS_Extension } else { KS_Unknown };
        },
        BOOLSUPPORT => {
            if LangOpts.Bool {
                return KS_Enabled;
            }
        },
        KEYALTIVEC => {
            return if LangOpts.AltiVec { KS_Enabled } else { KS_Unknown };
        },
        KEYBORLAND => {
            return if LangOpts.Borland { KS_Extension } else { KS_Unknown };
        },
        KEYOPENCLC => {
            return if LangOpts.OpenCL && !LangOpts.OpenCLCPlusPlus { KS_Enabled } else { KS_Unknown };
        },
        WCHARSUPPORT => {
            return if LangOpts.WChar { KS_Enabled } else { KS_Unknown };
        },
        HALFSUPPORT => {
            return if LangOpts.Half { KS_Enabled } else { KS_Unknown };
        },
        CHAR8SUPPORT => {
            if LangOpts.Char8 {
                return KS_Enabled;
            }
        },
        KEYOBJC => {
            return if LangOpts.ObjC { KS_Enabled } else { KS_Unknown };
        },
        KEYZVECTOR => {
            return if LangOpts.ZVector { KS_Enabled } else { KS_Unknown };
        },
        KEYCOROUTINES => {
            return if LangOpts.Coroutines { KS_Enabled } else { KS_Unknown };
        },
        KEYMODULES => {
            return KS_Unknown;
        },
        KEYOPENCLCXX => {
            return if LangOpts.OpenCLCPlusPlus { KS_Enabled } else { KS_Unknown };
        },
        KEYMSCOMPAT => {
            return if LangOpts.MSVCCompat { KS_Enabled } else { KS_Unknown };
        },
        KEYSYCL => {
            return if LangOpts.isSYCL() { KS_Enabled } else { KS_Unknown };
        },
        KEYCUDA => {
            return if LangOpts.CUDA { KS_Enabled } else { KS_Unknown };
        },
        KEYZOS => {
            return if LangOpts.ZOSExt { KS_Enabled } else { KS_Unknown };
        },
        KEYHLSL => {
            return if LangOpts.HLSL { KS_Enabled } else { KS_Unknown };
        },
        KEYNOCXX => {
            return if LangOpts.CPlusPlus { KS_Unknown } else { KS_Enabled };
        },
        KEYNOOPENCL => {
            KEYNOMS18;
        },
        KEYFIXEDPOINT => {
            return if LangOpts.FixedPoint { KS_Enabled } else { KS_Disabled };
        },
        KEYDEFERTS => {
            return if LangOpts.DeferTS { KS_Enabled } else { KS_Disabled };
        },
        _ => {
            llvm_unreachable_internal("Unknown KeywordStatus flag", "P:/Goraw/llvm-project/clang/lib/Basic/IdentifierTable.cpp", 170);
        },
    }
}

fn getKeywordStatus(LangOpts: *LangOptions, Flags: u32) -> KeywordStatus {
    if Flags == KEYALL {
        return KS_Enabled;
    }
    if LangOpts.OpenCL && (Flags & KEYNOOPENCL) {
        return KS_Disabled;
    }
    if LangOpts.HLSL && (Flags & KEYNOHLSL) {
        return KS_Disabled;
    }
    if LangOpts.MSVCCompat && (Flags & KEYNOMS18) && !LangOpts.isCompatibleWithMSVC(MSVC2015) {
        return KS_Disabled;
    }
    let mut CurStatus: KeywordStatus = KS_Unknown;
    while Flags != 0 {
        let mut CurFlag: u32 = Flags & ~(Flags - 1);
        Flags = Flags & ~CurFlag;
        CurStatus = if CurStatus > getKeywordStatusHelper(LangOpts, CurFlag as TokenKey) { CurStatus } else { getKeywordStatusHelper(LangOpts, CurFlag as TokenKey) };
    }
    if CurStatus == KS_Unknown {
        return KS_Disabled;
    }
    return CurStatus;
}

fn IsKeywordInCpp(Flags: u32) -> bool {
    return (Flags & (KEYCXX | KEYCXX11 | KEYCXX20 | BOOLSUPPORT | WCHARSUPPORT | CHAR8SUPPORT)) != 0;
}

fn MarkIdentifierAsKeywordInCpp(Table: *mut IdentifierTable, Name: str) {
    let mut II: *mut IdentifierInfo = Table.get(Name, identifier);
    II.setIsKeywordInCPlusPlus(true);
    II.setHandleIdentifierCase(true);
}

fn AddKeyword(Keyword: str, TokenCode: TokenKind, Flags: u32, LangOpts: *LangOptions, Table: *mut IdentifierTable) {
    let mut AddResult: KeywordStatus = getKeywordStatus(LangOpts, Flags);
    if AddResult == KS_Disabled {
        if !LangOpts.ObjC && IsKeywordInCpp(Flags) {
            MarkIdentifierAsKeywordInCpp(Table, Keyword);
        }
        return;
    }
    let mut Info: *mut IdentifierInfo = Table.get(Keyword, if AddResult == KS_Future { identifier } else { TokenCode });
    Info.setIsExtensionToken(AddResult == KS_Extension);
    Info.setIsFutureCompatKeyword(AddResult == KS_Future);
}

fn AddCXXOperatorKeyword(Keyword: str, TokenCode: TokenKind, Table: *mut IdentifierTable) {
    let mut Info: *mut IdentifierInfo = Table.get(Keyword, TokenCode);
    Info.setIsCPlusPlusOperatorKeyword(true);
}

fn AddObjCKeyword(Name: str, ObjCID: ObjCKeywordKind, Table: *mut IdentifierTable) {
    Table.get(Name).setObjCKeywordID(ObjCID);
}

fn AddNotableIdentifier(Name: str, BTID: NotableIdentifierKind, Table: *mut IdentifierTable) {
    if BTID != not_notable {
        let mut Info: *mut IdentifierInfo = Table.get(Name, identifier);
        Info.setNotableIdentifierID(BTID);
    }
}

fn IdentifierTable::AddKeywords(self, LangOpts: *LangOptions) {
    AddKeyword("auto", kw_auto, KEYALL, LangOpts, *self);
    AddKeyword("break", kw_break, KEYALL, LangOpts, *self);
    AddKeyword("case", kw_case, KEYALL, LangOpts, *self);
    AddKeyword("char", kw_char, KEYALL, LangOpts, *self);
