    } else {
        MarkIdentifierAsKeywordInCpp(*self, "bitand");
    }
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("bitor", pipe, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "bitor");
    }
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("compl", tilde, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "compl");
    }
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("not", exclaim, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "not");
    }
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("not_eq", exclaimequal, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "not_eq");
    }
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("or", pipepipe, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "or");
    }
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("or_eq", pipeequal, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "or_eq");
    }
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("xor", caret, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "xor");
    }
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("xor_eq", caretequal, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "xor_eq");
    }
    AddKeyword("restrict", kw_restrict, KEYC99 | (0), LangOpts, *self);
    AddKeyword("inline", kw_inline, KEYC99 | (KEYCXX | KEYGNU), LangOpts, *self);
    AddKeyword("alignas", kw_alignas, KEYCXX11 | (KEYC23), LangOpts, *self);
    AddKeyword("char16_t", kw_char16_t, KEYCXX11 | (KEYNOMS18), LangOpts, *self);
    AddKeyword("char32_t", kw_char32_t, KEYCXX11 | (KEYNOMS18), LangOpts, *self);
    AddKeyword("constexpr", kw_constexpr, KEYCXX11 | (KEYC23), LangOpts, *self);
