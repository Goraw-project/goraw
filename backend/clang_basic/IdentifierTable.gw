        },
        OO_Plus => {
            return "+";
        },
        OO_Minus => {
            return "-";
        },
        OO_Star => {
            return "*";
        },
        OO_Slash => {
            return "/";
        },
        OO_Percent => {
            return "%";
        },
        OO_Caret => {
            return "^";
        },
        OO_Amp => {
            return "&";
        },
        OO_Pipe => {
            return "|";
        },
        OO_Tilde => {
            return "~";
        },
        OO_Exclaim => {
            return "!";
        },
        OO_Equal => {
            return "=";
        },
        OO_Less => {
            return "<";
        },
        OO_Greater => {
            return ">";
        },
        OO_PlusEqual => {
            return "+=";
        },
        OO_MinusEqual => {
            return "-=";
        },
        OO_StarEqual => {
            return "*=";
        },
        OO_SlashEqual => {
            return "/=";
        },
        OO_PercentEqual => {
            return "%=";
        },
        OO_CaretEqual => {
            return "^=";
        },
        OO_AmpEqual => {
            return "&=";
        },
        OO_PipeEqual => {
            return "|=";
        },
        OO_LessLess => {
            return "<<";
        },
        OO_GreaterGreater => {
            return ">>";
        },
        OO_LessLessEqual => {
            return "<<=";
        },
        OO_GreaterGreaterEqual => {
            return ">>=";
        },
        OO_EqualEqual => {
            return "==";
        },
        OO_ExclaimEqual => {
            return "!=";
        },
        OO_LessEqual => {
            return "<=";
        },
        OO_GreaterEqual => {
            return ">=";
        },
        OO_Spaceship => {
            return "<=>";
        },
        OO_AmpAmp => {
            return "&&";
        },
        OO_PipePipe => {
            return "||";
