    AddKeyword("_alignof", kw___alignof, KEYMS, LangOpts, *self);
    AddKeyword("__is_literal_type", kw___is_literal, KEYCXX, LangOpts, *self);
    AddKeyword("__is_same_as", kw___is_same, KEYCXX, LangOpts, *self);
    if LangOpts.ParseUnknownAnytype {
        AddKeyword("__unknown_anytype", kw___unknown_anytype, KEYALL, LangOpts, *self);
    }
    if LangOpts.DeclSpecKeyword {
        AddKeyword("__declspec", kw___declspec, KEYALL, LangOpts, *self);
    }
    if LangOpts.IEEE128 {
        AddKeyword("__ieee128", kw___float128, KEYALL, LangOpts, *self);
    }
    self.get("import").setKeywordImport(true);
    self.get("module").setModuleKeyword(true);
    self.get("__preprocessed_import").setKeywordImport(true);
    self.get("__preprocessed_module").setModuleKeyword(true);
}

