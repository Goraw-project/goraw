    AddKeyword("virtual", kw_virtual, KEYCXX, LangOpts, *self);
    AddKeyword("wchar_t", kw_wchar_t, WCHARSUPPORT, LangOpts, *self);
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("and", ampamp, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "and");
    }
    if LangOpts.CXXOperatorNames {
        AddCXXOperatorKeyword("and_eq", ampequal, *self);
    } else {
        MarkIdentifierAsKeywordInCpp(*self, "and_eq");
    }
