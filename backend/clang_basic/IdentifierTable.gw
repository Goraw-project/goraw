    AddKeyword("return", kw_return, KEYALL, LangOpts, *self);
    AddKeyword("short", kw_short, KEYALL, LangOpts, *self);
    AddKeyword("signed", kw_signed, KEYALL, LangOpts, *self);
    AddKeyword("static", kw_static, KEYALL, LangOpts, *self);
    AddKeyword("struct", kw_struct, KEYALL, LangOpts, *self);
    AddKeyword("switch", kw_switch, KEYALL, LangOpts, *self);
    AddKeyword("typedef", kw_typedef, KEYALL, LangOpts, *self);
    AddKeyword("union", kw_union, KEYALL, LangOpts, *self);
    AddKeyword("unsigned", kw_unsigned, KEYALL, LangOpts, *self);
    AddKeyword("void", kw_void, KEYALL, LangOpts, *self);
    AddKeyword("volatile", kw_volatile, KEYALL | KEYNOHLSL, LangOpts, *self);
