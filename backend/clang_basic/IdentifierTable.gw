    AddKeyword("noexcept", kw_noexcept, KEYCXX11 | (0), LangOpts, *self);
    AddKeyword("nullptr", kw_nullptr, KEYCXX11 | (KEYC23), LangOpts, *self);
    AddKeyword("static_assert", kw_static_assert, KEYCXX11 | (KEYMSCOMPAT | KEYC23), LangOpts, *self);
    AddKeyword("thread_local", kw_thread_local, KEYCXX11 | (KEYC23), LangOpts, *self);
    AddKeyword("co_await", kw_co_await, KEYCXX20 | (KEYCOROUTINES), LangOpts, *self);
    AddKeyword("co_return", kw_co_return, KEYCXX20 | (KEYCOROUTINES), LangOpts, *self);
