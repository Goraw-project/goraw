    if LangOpts() {
        AddKeyword("__ieee128", kw___float128, LangOpts, *self);
    }
    self.get("import").setKeywordImport(true);
    self.get("module").setModuleKeyword(true);
    self.get("__preprocessed_import").setKeywordImport(true);
    self.get("__preprocessed_module").setModuleKeyword(true);
}

