    AddKeyword("_Static_assert", kw__Static_assert, KEYALL, LangOpts, *self);
    AddKeyword("_Thread_local", kw__Thread_local, KEYALL, LangOpts, *self);
    AddKeyword("__func__", kw___func__, KEYALL, LangOpts, *self);
