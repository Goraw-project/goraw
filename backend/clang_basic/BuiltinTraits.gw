fn getTraitName(T: TypeTrait) -> *u8 {
    assert!(T <= TT_Last, "invalid enum value!");
    return TypeTraitNames[T];
}

fn getTraitName(T: ArrayTypeTrait) -> *u8 {
    assert!(T <= ATT_Last, "invalid enum value!");
    return ArrayTypeTraitNames[T];
}

fn getTraitName(T: UnaryExprOrTypeTrait) -> *u8 {
    assert!(T <= UETT_Last, "invalid enum value!");
    return UnaryExprOrTypeTraitNames[T];
}

fn getTraitName(T: ExpressionTrait) -> *u8 {
    assert!(T <= ET_Last, "invalid enum value!");
    return ExpressionTraitNames[T];
}

fn getTraitSpelling(T: TypeTrait) -> *u8 {
    assert!(T <= TT_Last, "invalid enum value!");
    if T == BTT_IsDeducible {
        assert!(strlen(TypeTraitSpellings[T]) == 0);
        return "__is_deducible";
    }
    return TypeTraitSpellings[T];
}

fn getTraitSpelling(T: ArrayTypeTrait) -> *u8 {
    assert!(T <= ATT_Last, "invalid enum value!");
    return ArrayTypeTraitSpellings[T];
}

fn getTraitSpelling(T: UnaryExprOrTypeTrait) -> *u8 {
    assert!(T <= UETT_Last, "invalid enum value!");
    return UnaryExprOrTypeTraitSpellings[T];
}

fn getTypeTraitArity(T: TypeTrait) -> u32 {
    assert!(T <= TT_Last, "invalid enum value!");
    return TypeTraitArities[T];
}

fn getTraitSpelling(T: ExpressionTrait) -> *u8 {
    assert!(T <= ET_Last, "invalid enum value!");
    return ExpressionTraitSpellings[T];
}
