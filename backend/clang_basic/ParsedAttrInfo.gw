fn instantiateEntries() -> unique_ptr<ParsedAttrInfo>> {
    let mut Instances: unique_ptr<ParsedAttrInfo>> = unique_ptr<ParsedAttrInfo>> {};
    for It in entries() {
        Instances.push(It.instantiate());
    }
    return Instances;
}

fn getAttributePluginInstances() -> *unique_ptr<ParsedAttrInfo>> {
    let mut Instances: unique_ptr<ParsedAttrInfo>> = instantiateEntries();
    return Instances;
}
