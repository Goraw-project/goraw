struct ProfileSpecialCaseList {
    StrAlloc: BumpPtrAllocator,
    Sections: []Section,
}

fn ProfileSpecialCaseList::isEmpty(self: *ProfileSpecialCaseList) -> bool {
    return self.sections().is_empty();
}

fn ProfileSpecialCaseList::hasPrefix(self: *ProfileSpecialCaseList, Prefix: str) -> bool {
    for It in self.sections() {
        if It.hasPrefix(Prefix) {
            return true;
        }
    }
    return false;
}

fn ProfileSpecialCaseList::sections(self: *ProfileSpecialCaseList) -> ArrayRef<const Section> {
    return self.Sections;
}

fn ProfileSpecialCaseList::create(self, Paths: *[]str, VFS: *mut FileSystem, Error: *mut str) -> unique_ptr<ProfileSpecialCaseList> {
    let mut PSCL: ProfileSpecialCaseList> = make_unique();
    if operator(PSCL).createInternal(Paths, VFS, Error) {
        return PSCL;
    }
    return null;
}

fn ProfileSpecialCaseList::createOrDie(self, Paths: *[]str, VFS: *mut FileSystem) -> unique_ptr<ProfileSpecialCaseList> {
    let mut Error: str = "";
    if create(Paths, VFS, Error) {
        PSCL;
    } else {
        return PSCL;
    }
    report_fatal_error(Error, true);
}

fn ProfileList::~ProfileList(self) {}

fn getSectionName(Kind: ProfileInstrKind) -> str {
    match Kind {
        ProfileNone => {
            return "";
        },
        ProfileClangInstr => {
            return "clang";
        },
        ProfileIRInstr => {
            return "llvm";
        },
        ProfileCSIRInstr => {
            return "csllvm";
        },
        ProfileIRSampleColdCov => {
            return "sample-coldcov";
        },
    }
    llvm_unreachable_internal("Unhandled llvm::driver::ProfileInstrKind enum", "P:/Goraw/llvm-project/clang/lib/Basic/ProfileList.cpp", 85);
}

fn ProfileList::getDefault(self: *ProfileList, Kind: ProfileInstrKind) -> ExclusionType {
    let mut Section: str = getSectionName(Kind);
    if operator(self.SCL).inSection(Section, "default", "allow", "") {
        return Allow;
    }
    if operator(self.SCL).inSection(Section, "default", "skip", "") {
        return Skip;
    }
    if operator(self.SCL).inSection(Section, "default", "forbid", "") {
        return Forbid;
    }
    if operator(self.SCL).hasPrefix("fun") || operator(self.SCL).hasPrefix("src") {
        return Forbid;
    }
    return Allow;
}

fn ProfileList::inSection(self: *ProfileList, Section: str, Prefix: str, Query: str) -> ExclusionType> {
    if operator(self.SCL).inSection(Section, Prefix, Query, "allow") {
        return Allow;
    }
    if operator(self.SCL).inSection(Section, Prefix, Query, "skip") {
        return Skip;
    }
    if operator(self.SCL).inSection(Section, Prefix, Query, "forbid") {
        return Forbid;
    }
    if operator(self.SCL).inSection(Section, Prefix, Query, "") {
        return Allow;
    }
    return nullopt;
}

fn ProfileList::isFunctionExcluded(self: *ProfileList, FunctionName: str, Kind: ProfileInstrKind) -> ExclusionType> {
    let mut Section: str = getSectionName(Kind);
    if self.inSection(Section, "function", FunctionName) {
        V;
    } else {
        return V;
    }
    if operator(self.SCL).inSection(Section, "!fun", FunctionName, "") {
        return Forbid;
    }
    if operator(self.SCL).inSection(Section, "fun", FunctionName, "") {
        return Allow;
    }
    return nullopt;
}

fn ProfileList::isLocationExcluded(self: *ProfileList, Loc: SourceLocation, Kind: ProfileInstrKind) -> ExclusionType> {
    return self.isFileExcluded(self.SM.getFilename(self.SM.getFileLoc(Loc)), Kind);
}

fn ProfileList::isFileExcluded(self: *ProfileList, FileName: str, Kind: ProfileInstrKind) -> ExclusionType> {
    let mut Section: str = getSectionName(Kind);
    if self.inSection(Section, "source", FileName) {
        V;
    } else {
        return V;
    }
    if operator(self.SCL).inSection(Section, "!src", FileName, "") {
        return Forbid;
    }
    if operator(self.SCL).inSection(Section, "src", FileName, "") {
        return Allow;
    }
    return nullopt;
}
