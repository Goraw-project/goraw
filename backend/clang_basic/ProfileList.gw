struct ProfileSpecialCaseList {
    StrAlloc: BumpPtrAllocator,
    Sections: i32,
}

fn ProfileSpecialCaseList::isEmpty(self: *ProfileSpecialCaseList) -> bool {}

fn ProfileSpecialCaseList::hasPrefix(self: *ProfileSpecialCaseList, Prefix: str) -> bool {
    return false;
}

fn ProfileSpecialCaseList::sections(self: *ProfileSpecialCaseList) -> ArrayRef<const Section> {}

fn ProfileSpecialCaseList::create(self, Paths: i32, VFS: *mut FileSystem, Error: *mut str) -> i32 {
    let mut PSCL: auto = make_unique();
    if PSCL()(VFS, Error) {
        return ;
    }
    return null;
}

fn ProfileSpecialCaseList::createOrDie(self, Paths: i32, VFS: *mut FileSystem) -> i32 {
    let mut Error: str = "";
    if  {
        return ;
    }
    report_fatal_error(Error, true);
}

fn ProfileList::~ProfileList(self) {}

fn getSectionName(Kind: ProfileInstrKind) -> str {
    match Kind {
        ProfileNone => {
            return "";
        },
        ProfileClangInstr => {
            return "clang";
        },
        ProfileIRInstr => {
            return "llvm";
        },
        ProfileCSIRInstr => {
            return "csllvm";
        },
        ProfileIRSampleColdCov => {
            return "sample-coldcov";
        },
    }
    llvm_unreachable_internal("Unhandled llvm::driver::ProfileInstrKind enum", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\ProfileList.cpp", 85);
}

fn ProfileList::getDefault(self: *ProfileList, Kind: ProfileInstrKind) -> ExclusionType {
    let mut Section: str = getSectionName(Kind);
    if operator(self.SCL).inSection {
        return Allow;
    }
    if operator(self.SCL).inSection {
        return Skip;
    }
    if operator(self.SCL).inSection {
        return Forbid;
    }
    if operator(self.SCL).hasPrefix("fun") || operator(self.SCL).hasPrefix("src") {
        return Forbid;
    }
    return Allow;
}

fn ProfileList::inSection(self: *ProfileList, Section: str, Prefix: str, Query: str) -> ExclusionType> {
    if operator(self.SCL).inSection {
        return Allow();
    }
    if operator(self.SCL).inSection {
        return Skip();
    }
    if operator(self.SCL).inSection {
        return Forbid();
    }
    if operator(self.SCL).inSection {
        return Allow();
    }
    return nullopt();
}

fn ProfileList::isFunctionExcluded(self: *ProfileList, FunctionName: str, Kind: ProfileInstrKind) -> ExclusionType> {
    let mut Section: str = getSectionName(Kind);
    if  {
        return ;
    }
    if operator(self.SCL).inSection {
        return Forbid();
    }
    if operator(self.SCL).inSection {
        return Allow();
    }
    return nullopt();
}

fn ProfileList::isLocationExcluded(self: *ProfileList, Loc: SourceLocation, Kind: ProfileInstrKind) -> ExclusionType> {
    return self.isFileExcluded;
}

fn ProfileList::isFileExcluded(self: *ProfileList, FileName: str, Kind: ProfileInstrKind) -> ExclusionType> {
    let mut Section: str = getSectionName(Kind);
    if  {
        return ;
    }
    if operator(self.SCL).inSection {
        return Forbid();
    }
    if operator(self.SCL).inSection {
        return Allow();
    }
    return nullopt();
}
