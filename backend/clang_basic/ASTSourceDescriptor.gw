fn ASTSourceDescriptor::ASTSourceDescriptor(self, M: *mut Module) {
    if M.Directory {
        self.Path = operator(M.Directory).getName();
    }
    if M.getASTFileName() {
        FileKey;
    } else {
        self.ASTFile = FileKey;
    }
}

fn ASTSourceDescriptor::getModuleName(self: *ASTSourceDescriptor) -> str {
    if self.ClangModule {
        return self.ClangModule.Name;
    } else {
        return self.PCHModuleName[0..allocator<char> {}];
    }
}
