fn getTokenName(Kind: TokenKind) -> *u8 {
    if Kind < NUM_TOKENS {
        return TokNames[Kind];
    }
    llvm_unreachable_internal("unknown TokenKind", "P:/Goraw/llvm-project/clang/lib/Basic/TokenKinds.cpp", 27);
    return null;
}

fn getPunctuatorSpelling(Kind: TokenKind) -> *u8 {
    match Kind {
        l_square => {
            return "[";
        },
        r_square => {
            return "]";
        },
        l_paren => {
            return "(";
        },
        r_paren => {
            return ")";
        },
        l_brace => {
            return "{";
        },
        r_brace => {
            return "}";
        },
        period => {
            return ".";
        },
        ellipsis => {
            return "...";
        },
        amp => {
            return "&";
        },
        ampamp => {
            return "&&";
        },
        ampequal => {
            return "&=";
        },
        star => {
            return "*";
        },
        starequal => {
            return "*=";
        },
        plus => {
            return "+";
        },
        plusplus => {
            return "++";
        },
        plusequal => {
            return "+=";
        },
        minus => {
            return "-";
        },
        arrow => {
            return "->";
        },
        minusminus => {
            return "--";
        },
        minusequal => {
            return "-=";
        },
        tilde => {
            return "~";
        },
        exclaim => {
            return "!";
        },
        exclaimequal => {
            return "!=";
        },
        slash => {
            return "/";
        },
        slashequal => {
            return "/=";
        },
        percent => {
            return "%";
        },
        percentequal => {
            return "%=";
        },
        less => {
            return "<";
        },
        lessless => {
            return "<<";
        },
        lessequal => {
            return "<=";
        },
        lesslessequal => {
            return "<<=";
        },
        spaceship => {
            return "<=>";
        },
        greater => {
            return ">";
        },
        greatergreater => {
            return ">>";
        },
        greaterequal => {
            return ">=";
        },
        greatergreaterequal => {
            return ">>=";
        },
        caret => {
            return "^";
        },
        caretcaret => {
            return "^^";
        },
        caretequal => {
            return "^=";
        },
        pipe => {
            return "|";
        },
        pipepipe => {
            return "||";
        },
        pipeequal => {
            return "|=";
        },
        question => {
            return "?";
        },
        colon => {
            return ":";
        },
        semi => {
            return ";";
        },
        equal => {
            return "=";
        },
        equalequal => {
            return "==";
        },
        comma => {
            return ",";
        },
        hash => {
            return "#";
        },
        hashhash => {
            return "##";
        },
        hashat => {
            return "#@";
        },
        periodstar => {
            return ".*";
        },
        arrowstar => {
            return "->*";
        },
        coloncolon => {
            return "::";
        },
        at => {
            return "@";
        },
        lesslessless => {
            return "<<<";
        },
        greatergreatergreater => {
            return ">>>";
        },
        _ => {
            break;
        },
    }
    return null;
}

