        },
        objc_throw => {
            return "@throw";
        },
        objc_try => {
            return "@try";
        },
        objc_catch => {
            return "@catch";
        },
        objc_finally => {
            return "@finally";
        },
        objc_synchronized => {
            return "@synchronized";
        },
        objc_autoreleasepool => {
            return "@autoreleasepool";
