fn StackExhaustionHandler::runWithSufficientStackSpace(self, Loc: SourceLocation, Fn: function_ref<void ()>) {
    runWithSufficientStackSpace(Closure_1 { cap_0: self, Loc: &mut Loc });
}

fn StackExhaustionHandler::warnOnStackNearlyExhausted(self, Loc: SourceLocation) {
    if isStackNearlyExhausted() {
        self.warnStackExhausted(Loc);
    }
}

fn StackExhaustionHandler::warnStackExhausted(self, Loc: SourceLocation) {
    if !self.WarnedStackExhausted {
        self.DiagsRef;
        self.WarnedStackExhausted = true;
    }
}

struct Closure_1 {
    cap_0: *mut StackExhaustionHandler,
    Loc: *mut SourceLocation,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> auto {
        self.warnStackExhausted((*self.Loc));
    }
