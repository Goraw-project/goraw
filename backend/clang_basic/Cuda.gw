fn CudaFeatureEnabled(Version: VersionTuple, Feature: CudaFeature) -> bool {
    return CudaFeatureEnabled(ToCudaVersion(Version), Feature);
}

fn CudaFeatureEnabled(Version: CudaVersion, Feature: CudaFeature) -> bool {
    match Feature {
        CUDA_USES_NEW_LAUNCH => {
            return Version >= CUDA_92;
        },
        CUDA_USES_FATBIN_REGISTER_END => {
            return Version >= CUDA_101;
        },
    }
    llvm_unreachable_internal("Unknown CUDA feature.", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\Cuda.cpp", 130);
}

fn CudaArchToID(Arch: OffloadArch) -> u32 {
    assert!(Arch.isNVPTX(), "invalid NVIDIA GPU architecture");
    return getSmVersion(Arch.nvptxKind());
}

fn IsNVIDIAAcceleratedOffloadArch(Arch: OffloadArch) -> bool {
    return Arch.isNVPTX() && isAcceleratedArch(Arch.nvptxKind());
}

fn IsNVIDIAFamilySpecificOffloadArch(Arch: OffloadArch) -> bool {
    return Arch.isNVPTX() && isFamilySpecificArch(Arch.nvptxKind());
}
