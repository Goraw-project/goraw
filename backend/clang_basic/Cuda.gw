fn MaxVersionForOffloadArch(A: OffloadArch) -> CudaVersion {
    if A.isAMDGPU() || A.isAMDGCNSPIRV() {
        return NEW;
    }
    if !A.isNVPTX() {
        return UNKNOWN;
    }
    match A.nvptxKind() {
        GK_SM_20 => {
            return CUDA_80;
        },
        GK_SM_21 => {
