struct CudaVersionMapEntry {
    Name: *u8,
    Version: CudaVersion,
    TVersion: VersionTuple,
}

const CudaNameVersionMap: [34]CudaVersionMapEntry = ["7.0", CUDA_70, VersionTuple { 7, 0 }, "7.5", CUDA_75, VersionTuple { 7, 5 }, "8.0", CUDA_80, VersionTuple { 8, 0 }, "9.0", CUDA_90, VersionTuple { 9, 0 }, "9.1", CUDA_91, VersionTuple { 9, 1 }, "9.2", CUDA_92, VersionTuple { 9, 2 }, "10.0", CUDA_100, VersionTuple { 10, 0 }, "10.1", CUDA_101, VersionTuple { 10, 1 }, "10.2", CUDA_102, VersionTuple { 10, 2 }, "11.0", CUDA_110, VersionTuple { 11, 0 }, "11.1", CUDA_111, VersionTuple { 11, 1 }, "11.2", CUDA_112, VersionTuple { 11, 2 }, "11.3", CUDA_113, VersionTuple { 11, 3 }, "11.4", CUDA_114, VersionTuple { 11, 4 }, "11.5", CUDA_115, VersionTuple { 11, 5 }, "11.6", CUDA_116, VersionTuple { 11, 6 }, "11.7", CUDA_117, VersionTuple { 11, 7 }, "11.8", CUDA_118, VersionTuple { 11, 8 }, "12.0", CUDA_120, VersionTuple { 12, 0 }, "12.1", CUDA_121, VersionTuple { 12, 1 }, "12.2", CUDA_122, VersionTuple { 12, 2 }, "12.3", CUDA_123, VersionTuple { 12, 3 }, "12.4", CUDA_124, VersionTuple { 12, 4 }, "12.5", CUDA_125, VersionTuple { 12, 5 }, "12.6", CUDA_126, VersionTuple { 12, 6 }, "12.8", CUDA_128, VersionTuple { 12, 8 }, "12.9", CUDA_129, VersionTuple { 12, 9 }, "13.0", CUDA_130, VersionTuple { 13, 0 }, "13.1", CUDA_131, VersionTuple { 13, 1 }, "13.2", CUDA_132, VersionTuple { 13, 2 }, "13.3", CUDA_133, VersionTuple { 13, 3 }, "13.4", CUDA_134, VersionTuple { 13, 4 }, "", NEW, max(), "unknown", UNKNOWN, VersionTuple {}];

fn CudaVersionToString(V: CudaVersion) -> *u8 {
    for let mut I: *CudaVersionMapEntry = CudaNameVersionMap; I.Version != UNKNOWN; I += 1 {
        if I.Version == V {
            return I.Name;
        }
    }
    return CudaVersionToString(UNKNOWN);
}

fn CudaStringToVersion(S: str) -> CudaVersion {
    let mut VS: str = S;
    for let mut I: *CudaVersionMapEntry = CudaNameVersionMap; I.Version != UNKNOWN; I += 1 {
        if VS == I.Name {
            return I.Version;
        }
    }
    return UNKNOWN;
}

fn ToCudaVersion(Version: VersionTuple) -> CudaVersion {
    for let mut I: *CudaVersionMapEntry = CudaNameVersionMap; I.Version != UNKNOWN; I += 1 {
        if I.TVersion == Version {
            return I.Version;
        }
    }
    return UNKNOWN;
}

fn MinVersionForOffloadArch(A: OffloadArch) -> CudaVersion {
    if A.isUnknown() {
        return UNKNOWN;
    }
    if A.isAMDGPU() || A.isAMDGCNSPIRV() {
        return CUDA_70;
    }
    match A.nvptxKind() {
        GK_SM_20 => {
            return CUDA_70;
        },
        GK_SM_21 => {
            return CUDA_70;
        },
        GK_SM_30 => {
            return CUDA_70;
        },
        GK_SM_32_ => {
