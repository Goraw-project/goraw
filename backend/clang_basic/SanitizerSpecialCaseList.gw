fn SanitizerSpecialCaseList::create(self, Paths: *[]str, VFS: *mut FileSystem, Error: *mut str) -> unique_ptr<SanitizerSpecialCaseList> {
    let mut SSCL: SanitizerSpecialCaseList> = SanitizerSpecialCaseList {};
    if operator(SSCL).createInternal(Paths, VFS, Error) {
        operator(SSCL).createSanitizerSections();
        return SSCL;
    }
    return null;
}

fn SanitizerSpecialCaseList::createOrDie(self, Paths: *[]str, VFS: *mut FileSystem) -> unique_ptr<SanitizerSpecialCaseList> {
    let mut Error: str = "";
    if create(Paths, VFS, Error) {
        SSCL;
    } else {
        return SSCL;
    }
    report_fatal_error(Error, true);
}

fn SanitizerSpecialCaseList::createSanitizerSections(self) {
    for S in self.sections() {
        let mut Mask: SanitizerMask = SanitizerMask {};
        if S.matchName("address") {
            operator(Mask, Address);
        }
        if S.matchName("pointer-compare") {
            operator(Mask, PointerCompare);
        }
        if S.matchName("pointer-subtract") {
            operator(Mask, PointerSubtract);
        }
        if S.matchName("kernel-address") {
            operator(Mask, KernelAddress);
        }
        if S.matchName("hwaddress") {
            operator(Mask, HWAddress);
        }
        if S.matchName("kernel-hwaddress") {
            operator(Mask, KernelHWAddress);
        }
        if S.matchName("memtag-stack") {
            operator(Mask, MemtagStack);
        }
        if S.matchName("memtag-heap") {
            operator(Mask, MemtagHeap);
        }
        if S.matchName("memtag-globals") {
            operator(Mask, MemtagGlobals);
        }
        if S.matchName("memtag") {
            operator(Mask, MemTag);
        }
        if S.matchName("memory") {
            operator(Mask, Memory);
        }
        if S.matchName("kernel-memory") {
            operator(Mask, KernelMemory);
        }
        if S.matchName("fuzzer") {
            operator(Mask, Fuzzer);
        }
        if S.matchName("fuzzer-no-link") {
            operator(Mask, FuzzerNoLink);
        }
        if S.matchName("type") {
            operator(Mask, Type);
        }
        if S.matchName("thread") {
            operator(Mask, Thread);
        }
        if S.matchName("numerical") {
            operator(Mask, NumericalStability);
        }
        if S.matchName("realtime") {
            operator(Mask, Realtime);
        }
        if S.matchName("leak") {
            operator(Mask, Leak);
        }
        if S.matchName("alignment") {
            operator(Mask, Alignment);
        }
        if S.matchName("array-bounds") {
            operator(Mask, ArrayBounds);
        }
        if S.matchName("bool") {
            operator(Mask, Bool);
        }
        if S.matchName("builtin") {
            operator(Mask, Builtin);
        }
        if S.matchName("enum") {
            operator(Mask, Enum);
        }
        if S.matchName("float-cast-overflow") {
            operator(Mask, FloatCastOverflow);
        }
        if S.matchName("float-divide-by-zero") {
            operator(Mask, FloatDivideByZero);
        }
        if S.matchName("function") {
            operator(Mask, Function);
        }
        if S.matchName("integer-divide-by-zero") {
            operator(Mask, IntegerDivideByZero);
        }
        if S.matchName("nonnull-attribute") {
            operator(Mask, NonnullAttribute);
        }
        if S.matchName("null") {
            operator(Mask, Null);
        }
        if S.matchName("nullability-arg") {
            operator(Mask, NullabilityArg);
        }
        if S.matchName("nullability-assign") {
            operator(Mask, NullabilityAssign);
        }
        if S.matchName("nullability-return") {
            operator(Mask, NullabilityReturn);
        }
        if S.matchName("nullability") {
            operator(Mask, Nullability);
        }
        if S.matchName("object-size") {
            operator(Mask, ObjectSize);
        }
        if S.matchName("pointer-overflow") {
            operator(Mask, PointerOverflow);
        }
        if S.matchName("return") {
            operator(Mask, Return);
        }
        if S.matchName("returns-nonnull-attribute") {
            operator(Mask, ReturnsNonnullAttribute);
        }
        if S.matchName("shift-base") {
            operator(Mask, ShiftBase);
        }
        if S.matchName("shift-exponent") {
            operator(Mask, ShiftExponent);
        }
        if S.matchName("shift") {
            operator(Mask, Shift);
        }
        if S.matchName("signed-integer-overflow") {
            operator(Mask, SignedIntegerOverflow);
        }
        if S.matchName("unreachable") {
            operator(Mask, Unreachable);
        }
        if S.matchName("vla-bound") {
            operator(Mask, VLABound);
        }
        if S.matchName("vptr") {
            operator(Mask, Vptr);
        }
        if S.matchName("unsigned-integer-overflow") {
            operator(Mask, UnsignedIntegerOverflow);
        }
        if S.matchName("unsigned-shift-base") {
            operator(Mask, UnsignedShiftBase);
        }
        if S.matchName("dataflow") {
            operator(Mask, DataFlow);
        }
        if S.matchName("cfi-cast-strict") {
            operator(Mask, CFICastStrict);
        }
        if S.matchName("cfi-derived-cast") {
            operator(Mask, CFIDerivedCast);
        }
        if S.matchName("cfi-icall") {
            operator(Mask, CFIICall);
        }
        if S.matchName("cfi-mfcall") {
            operator(Mask, CFIMFCall);
        }
        if S.matchName("cfi-unrelated-cast") {
            operator(Mask, CFIUnrelatedCast);
        }
        if S.matchName("cfi-nvcall") {
            operator(Mask, CFINVCall);
        }
        if S.matchName("cfi-vcall") {
            operator(Mask, CFIVCall);
        }
        if S.matchName("cfi") {
            operator(Mask, CFI);
        }
        if S.matchName("kcfi") {
            operator(Mask, KCFI);
        }
        if S.matchName("safe-stack") {
            operator(Mask, SafeStack);
        }
        if S.matchName("shadow-call-stack") {
            operator(Mask, ShadowCallStack);
        }
        if S.matchName("undefined") {
            operator(Mask, Undefined);
        }
        if S.matchName("undefined-trap") {
            operator(Mask, UndefinedTrap);
        }
        if S.matchName("implicit-unsigned-integer-truncation") {
            operator(Mask, ImplicitUnsignedIntegerTruncation);
        }
        if S.matchName("implicit-signed-integer-truncation") {
            operator(Mask, ImplicitSignedIntegerTruncation);
        }
        if S.matchName("implicit-integer-truncation") {
            operator(Mask, ImplicitIntegerTruncation);
        }
        if S.matchName("implicit-integer-sign-change") {
            operator(Mask, ImplicitIntegerSignChange);
        }
        if S.matchName("implicit-integer-arithmetic-value-change") {
            operator(Mask, ImplicitIntegerArithmeticValueChange);
        }
        if S.matchName("implicit-integer-conversion") {
            operator(Mask, ImplicitIntegerConversion);
        }
        if S.matchName("implicit-bitfield-conversion") {
            operator(Mask, ImplicitBitfieldConversion);
        }
        if S.matchName("implicit-conversion") {
            operator(Mask, ImplicitConversion);
        }
        if S.matchName("integer") {
            operator(Mask, Integer);
        }
        if S.matchName("objc-cast") {
            operator(Mask, ObjCCast);
        }
        if S.matchName("local-bounds") {
            operator(Mask, LocalBounds);
        }
        if S.matchName("bounds") {
            operator(Mask, Bounds);
        }
        if S.matchName("scudo") {
            operator(Mask, Scudo);
        }
        if S.matchName("alloc-token") {
            operator(Mask, AllocToken);
        }
        if S.matchName("all") {
            operator(Mask, All);
        }
        self.SanitizerSections.emplace_back(Mask, S);
    }
}

fn SanitizerSpecialCaseList::inSection(self: *SanitizerSpecialCaseList, Mask: SanitizerMask, Prefix: str, Query: str, Category: str) -> bool {
    return !self.inSectionBlame(Mask, Prefix, Query, Category) == NotFound;
}

fn SanitizerSpecialCaseList::inSectionBlame(self: *SanitizerSpecialCaseList, Mask: SanitizerMask, Prefix: str, Query: str, Category: str) -> pair<unsigned int, unsigned int> {
    for S in reverse(self.SanitizerSections) {
        if S.Mask & Mask {
            let mut LineNum: u32 = S.S.getLastMatch(Prefix, Query, Category);
            if LineNum > 0 {
                return pair<unsigned int, unsigned int> { S.S.fileIndex(), LineNum };
            }
        }
    }
    return NotFound;
}
