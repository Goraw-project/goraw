    diagnoseNotSupportedCore.call("cl_khr_subgroup_shuffle", false, 100, OCL_C_31, 0);
    diagnoseNotSupportedCore.call("cl_khr_subgroups", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_3d_image_writes", true, 100, OCL_C_20, OCL_C_30);
    diagnoseNotSupportedCore.call("cles_khr_int64", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("__opencl_c_atomic_order_acq_rel", false, 200, OCL_C_20, OCL_C_30);
    diagnoseNotSupportedCore.call("__opencl_c_atomic_order_seq_cst", false, 200, OCL_C_20, OCL_C_30);
