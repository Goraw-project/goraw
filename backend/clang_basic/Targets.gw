fn DefineStd(Builder: *mut MacroBuilder, MacroName: str, Opts: *LangOptions) {
    assert!(MacroName[0] != '_', "Identifier should be in the user's namespace");
    if Opts.GNUMode {
        Builder.defineMacro(MacroName, "1", "");
    }
    Builder.defineMacro("__" + MacroName, "1", "");
    Builder.defineMacro("__" + MacroName + "__", "1", "");
}

fn defineCPUMacros(Builder: *mut MacroBuilder, CPUName: str, Tuning: bool) {
    Builder.defineMacro("__" + CPUName, "1", "");
    Builder.defineMacro("__" + CPUName + "__", "1", "");
    if Tuning {
        Builder.defineMacro("__tune_" + CPUName + "__", "1", "");
    }
}

fn addCygMingDefines(Opts: *LangOptions, Builder: *mut MacroBuilder) {
    if Opts.DeclSpecKeyword {
        Builder.defineMacro("__declspec", "__declspec", "");
    } else {
        Builder.defineMacro("__declspec(a)", "__attribute__((a))", "");
    }
    if !Opts.MicrosoftExt {
        let mut CCs: [5]*mut u8 = ["cdecl", "stdcall", "fastcall", "thiscall", "pascal"];
        for CC in CCs[..] {
            let mut GCCSpelling: str = "__attribute__((__";
            operator(GCCSpelling, CC);
            operator(GCCSpelling, "__))");
            Builder.defineMacro("_" + CC, GCCSpelling, "");
            Builder.defineMacro("__" + CC, GCCSpelling, "");
        }
    }
}

fn AllocateTarget(Triple: *Triple, Opts: *TargetOptions) -> unique_ptr<TargetInfo> {
    let mut os: OSType = Triple.getOS();
    match Triple.getArch() {
        _ => {
            return null;
        },
        arc => {
            return make_unique(Triple, Opts);
        },
        xcore => {
            return make_unique(Triple, Opts);
        },
        hexagon => {
            if os == Linux && Triple.getEnvironment() == Musl {
                return make_unique(Triple, Opts);
            }
        },
        lanai => {
            return make_unique(Triple, Opts);
        },
        aarch64_32 => {
            if Triple.isOSDarwin() {
                return make_unique(Triple, Opts);
            } else if Triple.isAppleMachO() {
                return make_unique(Triple, Opts);
            }
        },
        aarch64 => {
            if Triple.isOSDarwin() {
                return make_unique(Triple, Opts);
            } else if Triple.isAppleMachO() {
                return make_unique(Triple, Opts);
            }
        },
        aarch64_be => {
            match os {
                FreeBSD => {
                    return make_unique(Triple, Opts);
                },
                Fuchsia => {
                    return make_unique(Triple, Opts);
                },
                Linux => {
                    return make_unique(Triple, Opts);
                },
                NetBSD => {
                    return make_unique(Triple, Opts);
                },
                _ => {
                    return make_unique(Triple, Opts);
                },
            }
        },
        arm => {
            thumb;
        },
        armeb => {
