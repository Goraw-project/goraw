fn TargetInfo::CreateTargetInfo(self, Diags: *mut DiagnosticsEngine, OptsRef: *mut TargetOptions) -> *mut TargetInfo {
    let mut Opts: *mut TargetOptions = &mut OptsRef;
    let mut Triple: Triple = normalize(Opts.Triple, ANY);
    let mut Target: unique_ptr<TargetInfo> = AllocateTarget(Triple, *Opts);
    if !Target {
        Diags.Report(err_target_unknown_triple) << Triple;
        return null;
    }
    operator(Target).TargetOpts = Opts;
    if !Opts.CPU.is_empty() && !operator(Target).setCPU(Opts.CPU) {
        Diags.Report(err_target_unknown_cpu) << Opts.CPU;
        let mut ValidList: SmallVector<StringRef, 32> = SmallVector<StringRef, 32> {};
        operator(Target).fillValidCPUList(ValidList);
        if !ValidList.is_empty() {
            Diags.Report(note_valid_options) << join(ValidList, ", ");
        }
        return null;
    }
    if !Opts.TuneCPU.is_empty() && !operator(Target).isValidTuneCPUName(Opts.TuneCPU) {
        Diags.Report(err_target_unknown_cpu) << Opts.TuneCPU;
        let mut ValidList: SmallVector<StringRef, 32> = SmallVector<StringRef, 32> {};
        operator(Target).fillValidTuneCPUList(ValidList);
        if !ValidList.is_empty() {
            Diags.Report(note_valid_options) << join(ValidList, ", ");
        }
        return null;
    }
    if !Opts.ABI.is_empty() && !operator(Target).setABI(Opts.ABI) {
        Diags.Report(err_target_unknown_abi) << Opts.ABI;
        return null;
    }
    if !Opts.FPMath.is_empty() && !operator(Target).setFPMath(Opts.FPMath) {
        Diags.Report(err_target_unknown_fpmath) << Opts.FPMath;
        return null;
    }
    erase_if(Opts.FeaturesAsWritten, Closure_1 { Target: &mut Target, Diags: &mut Diags });
    if !operator(Target).initFeatureMap(Opts.FeatureMap, Diags, Opts.CPU, Opts.FeaturesAsWritten) {
        return null;
    }
    Opts.Features.clear();
    for F in Opts.FeatureMap {
        Opts.Features.push((if F.getValue() { "+" } else { "-" }) + F.getKey());
    }
    sort(Opts.Features);
    if !operator(Target).handleTargetFeatures(Opts.Features, Diags) {
        return null;
    }
    operator(Target).setSupportedOpenCLOpts();
    operator(Target).setCommandLineOpenCLOpts();
    operator(Target).setDependentOpenCLOpts();
    operator(Target).setMaxAtomicWidth();
    if !Opts.DarwinTargetVariantTriple.is_empty() {
        operator(Target).DarwinTargetVariantTriple = Opts.DarwinTargetVariantTriple;
    }
    if !operator(Target).validateTarget(Diags) {
        return null;
    }
    operator(Target).CheckFixedPointBits();
    return Target.release();
}

fn TargetInfo::validateOpenCLTarget(self: *TargetInfo, Opts: *LangOptions, Diags: *mut DiagnosticsEngine) -> bool {
    let mut OpenCLFeaturesMap: *StringMap<bool> = self.getSupportedOpenCLOpts();
    let mut diagnoseNotSupportedCore: Closure_2 = Closure_2 { cap_0: self, Opts: &mut Opts, OpenCLFeaturesMap: &mut OpenCLFeaturesMap, Diags: &mut Diags };
    diagnoseNotSupportedCore.call("cl_khr_byte_addressable_store", true, 100, OCL_C_11P, 0);
    diagnoseNotSupportedCore.call("cl_khr_global_int32_base_atomics", true, 100, OCL_C_11P, 0);
    diagnoseNotSupportedCore.call("cl_khr_global_int32_extended_atomics", true, 100, OCL_C_11P, 0);
    diagnoseNotSupportedCore.call("cl_khr_local_int32_base_atomics", true, 100, OCL_C_11P, 0);
    diagnoseNotSupportedCore.call("cl_khr_local_int32_extended_atomics", true, 100, OCL_C_11P, 0);
    diagnoseNotSupportedCore.call("cl_khr_fp64", true, 100, 0, OCL_C_12P);
    diagnoseNotSupportedCore.call("cl_khr_fp16", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_int64_base_atomics", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_int64_extended_atomics", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_depth_images", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_extended_bit_ops", false, 100, OCL_C_31, 0);
    diagnoseNotSupportedCore.call("cl_ext_float_atomics", false, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_gl_msaa_sharing", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_integer_dot_product", false, 100, OCL_C_31, 0);
    diagnoseNotSupportedCore.call("cl_khr_kernel_clock", false, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_mipmap_image", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_mipmap_image_writes", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_srgb_image_writes", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_subgroup_ballot", false, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_subgroup_clustered_reduce", false, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_khr_subgroup_extended_types", false, 100, OCL_C_31, 0);
