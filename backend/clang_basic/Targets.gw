fn TargetInfo::CreateTargetInfo(self, Diags: *mut DiagnosticsEngine, OptsRef: *mut TargetOptions) -> *mut TargetInfo {
    let mut Opts: *mut TargetOptions = &mut OptsRef;
    let mut Triple: Triple = normalize(Opts.Triple, ANY);
    let mut Target: i32 = 0;
    if operator!() {
        Diags << Triple;
        return null;
    }
    Target() = Opts;
    if !Opts.CPU.is_empty() && operator!((Opts.CPU)) {
        Diags << Opts.CPU;
        let mut ValidList: SmallVector<StringRef, 32> = zeroed();
        Target()();
        if operator!(()) {
            Diags << join(", ");
        }
        return null;
    }
    if !Opts.TuneCPU.is_empty() && operator!((Opts.TuneCPU)) {
        Diags << Opts.TuneCPU;
        let mut ValidList: SmallVector<StringRef, 32> = zeroed();
        Target()();
        if operator!(()) {
            Diags << join(", ");
        }
        return null;
    }
    if !Opts.ABI.is_empty() && operator!((Opts.ABI)) {
        Diags << Opts.ABI;
        return null;
    }
    if !Opts.FPMath.is_empty() && operator!((Opts.FPMath)) {
        Diags << Opts.FPMath;
        return null;
    }
    erase_if(Opts(), Closure_1 { Diags: &mut Diags });
    if operator!((Opts(), Diags, Opts.CPU, Opts())) {
        return null;
    }
    Opts()();
    sort(Opts());
    if operator!((Opts(), Diags)) {
        return null;
    }
    Target()();
    Target()();
    Target()();
    Target()();
    if !Opts.DarwinTargetVariantTriple.is_empty() {
        Target() = Opts.DarwinTargetVariantTriple;
    }
    if operator!((Diags)) {
        return null;
    }
    Target()();
    return ();
}

