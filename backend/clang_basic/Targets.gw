    diagnoseNotSupportedCore.call("__opencl_c_read_write_images", false, 200, OCL_C_20, OCL_C_30);
    diagnoseNotSupportedCore.call("__opencl_c_work_group_collective_functions", false, 200, OCL_C_20, OCL_C_30);
    diagnoseNotSupportedCore.call("cl_clang_storage_class_specifiers", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("__cl_clang_function_pointers", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("__cl_clang_variadic_functions", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("__cl_clang_function_scope_local_variables", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("__cl_clang_non_portable_kernel_param_types", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("__cl_clang_bitfields", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_amd_media_ops", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_amd_media_ops2", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_bfloat16_conversions", false, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_required_subgroup_size", false, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_split_work_group_barrier", false, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_subgroups", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_subgroups_char", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_subgroups_long", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_subgroups_short", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_subgroup_buffer_prefetch", false, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_subgroup_local_block_io", false, 100, 0, 0);
    diagnoseNotSupportedCore.call("cl_intel_device_side_avc_motion_estimation", true, 100, 0, 0);
    diagnoseNotSupportedCore.call("__opencl_c_3d_image_writes", false, 300, 0, OCL_C_30);
    diagnoseNotSupportedCore.call("__opencl_c_fp64", false, 300, 0, OCL_C_30);
    diagnoseNotSupportedCore.call("__opencl_c_subgroups", false, 300, 0, OCL_C_30);
    if Opts.getOpenCLCompatibleVersion() < 300 {
        return true;
    }
    return diagnoseUnsupportedFeatureDependencies(*self, Diags) && diagnoseFeatureExtensionDifferences(*self, Diags);
}

struct Closure_1 {
    Target: *mut unique_ptr<TargetInfo>,
    Diags: *mut DiagnosticsEngine,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Name: str) -> bool {
        if operator((*self.Target)).isReadOnlyFeature(Name[1..1 + npos]) {
            (*self.Diags).Report(warn_fe_backend_readonly_feature_flag) << Name;
            return true;
        }
        return false;
    }

struct Closure_2 {
    cap_0: *TargetInfo,
    Opts: *mut LangOptions,
    OpenCLFeaturesMap: *mut StringMap<bool>,
    Diags: *mut DiagnosticsEngine,
}

unsafe fn Closure_2::call(self: *mut Closure_2) {
        if isOpenCLOptionCoreIn((*self.Opts), OptArgs) && !self.hasFeatureEnabled((*self.OpenCLFeaturesMap), Name) {
            (*self.Diags).Report(warn_opencl_unsupported_core_feature) << Name << (*self.Opts).OpenCLCPlusPlus << (*self.Opts).getOpenCLVersionTuple().getAsString();
        }
    }
