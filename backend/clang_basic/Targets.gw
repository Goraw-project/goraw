    diagnoseNotSupportedCore("cl_intel_subgroup_buffer_prefetch", false, 100, 0, 0);
    diagnoseNotSupportedCore("cl_intel_subgroup_local_block_io", false, 100, 0, 0);
    diagnoseNotSupportedCore("cl_intel_device_side_avc_motion_estimation", true, 100, 0, 0);
    diagnoseNotSupportedCore("__opencl_c_3d_image_writes", false, 300, 0, OCL_C_30);
    diagnoseNotSupportedCore("__opencl_c_fp64", false, 300, 0, OCL_C_30);
    diagnoseNotSupportedCore("__opencl_c_subgroups", false, 300, 0, OCL_C_30);
    if Opts.getOpenCLCompatibleVersion() < 300 {
        return true;
    }
    return diagnoseUnsupportedFeatureDependencies(*self, Diags) && diagnoseFeatureExtensionDifferences(*self, Diags);
}

struct Closure_1 {
    Diags: *mut DiagnosticsEngine,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Name: str) -> bool {
        if Target()(Name[1..1 + npos]) {
            (*self.Diags) << Name;
            return true;
        }
        return false;
    }

struct Closure_2 {
    cap_0: *TargetInfo,
    Opts: *mut LangOptions,
    Diags: *mut DiagnosticsEngine,
}

unsafe fn Closure_2::call(self: *mut Closure_2) {
        if  {
            (*self.Diags) << Name << (*self.Opts).OpenCLCPlusPlus << (*self.Opts).getOpenCLVersionTuple().getAsString();
        }
    }
