fn SimpleTypoCorrection::add(self, Candidate: str) {
    if Candidate.is_empty() {
        return;
    }
    let mut MinPossibleEditDistance: u32 = if Candidate.len as i32 - self.Typo.len as i32 < 0 { -Candidate.len as i32 - self.Typo.len as i32 } else { Candidate.len as i32 - self.Typo.len as i32 };
    if MinPossibleEditDistance > 0 && self.Typo.len / MinPossibleEditDistance < 3 {
        return;
    }
    let mut EditDistance: u32 = self.Typo.edit_distance(Candidate, true, self.MaxEditDistance);
    if EditDistance < self.BestEditDistance {
        self.BestCandidate = Candidate;
        self.BestEditDistance = EditDistance;
        self.BestIndex = self.NextIndex;
    }
    self.NextIndex += 1;
}

fn SimpleTypoCorrection::add(self, Candidate: *u8) {
    if Candidate {
        self.add(Candidate);
    }
}

fn SimpleTypoCorrection::add(self, Candidate: *IdentifierInfo) {
    if Candidate {
        self.add(Candidate.getName());
    }
}

fn SimpleTypoCorrection::getCorrectionIndex(self: *SimpleTypoCorrection) -> u32 {
    return self.BestIndex;
}

fn SimpleTypoCorrection::getCorrection(self: *SimpleTypoCorrection) -> optional<StringRef> {
    if self.hasCorrection() {
        return self.BestCandidate;
    }
    return nullopt();
}

fn SimpleTypoCorrection::hasCorrection(self: *SimpleTypoCorrection) -> bool {
    return self.BestEditDistance <= self.MaxEditDistance;
}
