fn Module::Module(self, arg: ModuleConstructorTag, Name: str, DefinitionLoc: SourceLocation, Parent: *mut Module, IsFramework: bool, IsExplicit: bool, VisibilityID: u32) {
    if Parent {
        self.IsAvailable = Parent.isAvailable();
        self.IsUnimportable = Parent.isUnimportable();
        self.IsSystem = Parent.IsSystem;
        self.IsExternC = Parent.IsExternC;
        self.NoUndeclaredIncludes = Parent.NoUndeclaredIncludes;
        self.ModuleMapIsPrivate = Parent.ModuleMapIsPrivate;
        Parent.addSubmodule(Name, self);
    }
}

fn Module::~Module(self) {}

fn isPlatformEnvironment(Target: *TargetInfo, Feature: str) -> bool {
    let mut Platform: str = Target.getPlatformName();
    let mut Env: str = Target.getTriple().getEnvironmentName();
    if Platform == Feature || Target.getTriple().getOSName() == Feature || Env == Feature {
        return true;
    }
    let mut CmpPlatformEnv: Closure_1 = Closure_1 {};
    let mut PlatformEnv: str = Target.getTriple().getOSAndEnvironmentName();
    if Target.getTriple().isOSDarwin() && PlatformEnv.ends_with("simulator") {
        return PlatformEnv.operator StringRef() == Feature || CmpPlatformEnv.call(PlatformEnv.operator StringRef(), Feature);
    }
    return PlatformEnv.operator StringRef() == Feature;
}

fn hasFeature(Feature: str, LangOpts: *LangOptions, Target: *TargetInfo) -> bool {
    let mut HasFeature: bool = Feature.Case("altivec", LangOpts.AltiVec).Case("blocks", LangOpts.Blocks).Case("coroutines", LangOpts.Coroutines).Case("cplusplus", LangOpts.CPlusPlus).Case("cplusplus11", LangOpts.CPlusPlus11).Case("cplusplus14", LangOpts.CPlusPlus14).Case("cplusplus17", LangOpts.CPlusPlus17).Case("cplusplus20", LangOpts.CPlusPlus20).Case("cplusplus23", LangOpts.CPlusPlus23).Case("cplusplus26", LangOpts.CPlusPlus26).Case("cplusplus29", LangOpts.CPlusPlus29).Case("c99", LangOpts.C99).Case("c11", LangOpts.C11).Case("c17", LangOpts.C17).Case("c23", LangOpts.C23).Case("freestanding", LangOpts.Freestanding).Case("gnuinlineasm", LangOpts.GNUAsm).Case("objc", LangOpts.ObjC).Case("objc_arc", LangOpts.ObjCAutoRefCount).Case("opencl", LangOpts.OpenCL).Case("tls", Target.isTLSSupported()).Case("zvector", LangOpts.ZVector).Default(Target.hasFeature(Feature) || isPlatformEnvironment(Target, Feature));
    if !HasFeature {
        HasFeature = is_contained(LangOpts.ModuleFeatures, Feature);
    }
    return HasFeature;
}

fn Module::isUnimportable(self: *Module, LangOpts: *LangOptions, Target: *TargetInfo, Req: *mut Requirement, ShadowingModule: *mut *mut Module) -> bool {
    if !self.IsUnimportable {
        return false;
    }
    for let mut Current: *Module = self; Current; Current = Current.Parent {
        if Current.ShadowingModule {
            ShadowingModule = Current.ShadowingModule;
            return true;
        }
        for let mut I: u32 = 0;
let mut N: u32 = Current.Requirements.len; I != N; I += 1 {
            if hasFeature(Current.Requirements[I].FeatureName, LangOpts, Target) != Current.Requirements[I].RequiredState {
                Req = Current.Requirements[I];
                return true;
            }
        }
    }
    llvm_unreachable_internal("could not find a reason why module is unimportable", "P:/Goraw/llvm-project/clang/lib/Basic/Module.cpp", 147);
}

fn Module::isForBuilding(self: *Module, LangOpts: *LangOptions) -> bool {
    let mut TopLevelName: str = self.getTopLevelModuleName();
    let mut CurrentModule: str = LangOpts.CurrentModule;
    if !LangOpts.isCompilingModule() && self.getTopLevelModule().IsFramework && CurrentModule == LangOpts.ModuleName && !CurrentModule.ends_with("_Private") && TopLevelName.ends_with("_Private") {
        TopLevelName = TopLevelName.drop_back(8);
    }
    return TopLevelName == CurrentModule;
}

fn Module::isAvailable(self: *Module, LangOpts: *LangOptions, Target: *TargetInfo, Req: *mut Requirement, MissingHeader: *mut UnresolvedHeaderDirective, ShadowingModule: *mut *mut Module) -> bool {
    if self.IsAvailable {
        return true;
    }
    if self.isUnimportable(LangOpts, Target, Req, ShadowingModule) {
        return false;
    }
    for let mut Current: *Module = self; Current; Current = Current.Parent {
        if !Current.MissingHeaders.is_empty() {
            MissingHeader = Current.MissingHeaders.front();
            return false;
        }
    }
    llvm_unreachable_internal("could not find a reason why module is unavailable", "P:/Goraw/llvm-project/clang/lib/Basic/Module.cpp", 191);
}

fn Module::isSubModuleOf(self: *Module, Other: *Module) -> bool {
    for let mut Parent: *Module = self; Parent; Parent = Parent.Parent {
        if Parent == Other {
            return true;
        }
    }
    return false;
}

fn Module::getTopLevelModule(self: *Module) -> *Module {
    let mut Result: *Module = self;
    while Result.Parent {
        Result = Result.Parent;
    }
    return Result;
}

fn getModuleNameFromComponent(IdComponent: *string, SourceLocation>) -> str {
    return IdComponent.first;
}

fn getModuleNameFromComponent(R: str) -> str {
    return R;
}

