fn Module::getFullModuleName(self: *Module, AllowStringLiterals: bool) -> str {
    let mut Names: SmallVector<StringRef, 2> = SmallVector<StringRef, 2> {};
    for let mut M: *Module = self; M; M = M.Parent {
        Names.push(M.Name);
    }
    let mut Result: str = "";
    let mut Out: raw_string_ostream = Result;
    printModuleId(Out, Names.rbegin(), Names.rend(), AllowStringLiterals);
    return Result;
}

fn Module::fullModuleNameIs(self: *Module, nameParts: ArrayRef<StringRef>) -> bool {
    for let mut M: *Module = self; M; M = M.Parent {
        if nameParts.is_empty() || M.Name != nameParts.back() {
            return false;
        }
        nameParts = nameParts.drop_back(1);
    }
    return nameParts.is_empty();
}

fn Module::getEffectiveUmbrellaDir(self: *Module) -> OptionalDirectoryEntryRef {
    if get_if(&mut self.Umbrella) {
        Hdr;
    } else {
        return Hdr.getDir();
    }
    if get_if(&mut self.Umbrella) {
        Dir;
    } else {
        return *Dir;
    }
    return nullopt;
}

fn Module::addTopHeader(self, File: FileEntryRef) {
    assert!(File).operator const clang::FileEntry *();
    self.TopHeaders.insert(File);
}

fn Module::getTopHeaders(self, FileMgr: *mut FileManager) -> ArrayRef<FileEntryRef> {
    if !self.TopHeaderNames.is_empty() {
        for TopHeaderName in self.TopHeaderNames {
            if FileMgr.getOptionalFileRef(TopHeaderName, false, true, true) {
                FE;
            } else {
                self.TopHeaders.insert(operator(FE));
            }
        }
        self.TopHeaderNames.clear();
    }
    return FileEntryRef> { self.TopHeaders.begin(), self.TopHeaders.end() };
}

fn Module::directlyUses(self, Requested: *Module) -> bool {
    let mut Top: *mut Module = self.getTopLevelModule();
    if Requested.isSubModuleOf(Top) {
        return true;
    }
    for Use in Top.DirectUses {
        if Requested.isSubModuleOf(Use) {
            return true;
        }
    }
    if Requested.fullModuleNameIs(["_Builtin_stddef", "max_align_t"]) || Requested.fullModuleNameIs(["_Builtin_stddef_wint_t"]) {
        return true;
    }
    if !Requested.Parent && Requested.Name == "ptrauth" {
        return true;
    }
    if self.NoUndeclaredIncludes {
        self.UndeclaredUses.insert(Requested);
    }
    return false;
}

fn Module::addRequirement(self, Feature: str, RequiredState: bool, LangOpts: *LangOptions, Target: *TargetInfo) {
    self.Requirements.push(Requirement { Feature[0..allocator<char> {}], RequiredState });
    if hasFeature(Feature, LangOpts, Target) == RequiredState {
        return;
    }
    self.markUnavailable(true);
}

fn Module::markUnavailable(self, Unimportable: bool) {
    let mut needUpdate: Closure_2 = Closure_2 { Unimportable: Unimportable };
    if !needUpdate.call(self) {
        return;
    }
    let mut Stack: SmallVector<Module *, 2> = SmallVector<Module *, 2> {};
    Stack.push(self);
    while !Stack.is_empty() {
        let mut Current: *mut Module = Stack.pop_back_val();
        if !needUpdate.call(Current) {
            continue;
        }
        Current.IsAvailable = false;
        Current.IsUnimportable |= Unimportable;
        for Submodule in Current.submodules() {
            if needUpdate.call(Submodule) {
                Stack.push(Submodule);
            }
        }
    }
}

fn Module::findSubmodule(self: *Module, Name: str) -> ModuleRef {
    let mut It: const_iterator = self.SubModuleIndex.find(Name);
    if It != self.SubModuleIndex.end() {
        return self.SubModules[operator(It).second];
    }
    return null;
}

fn Module::getGlobalModuleFragment(self: *Module) -> *mut Module {
    assert!(self.isNamedModuleUnit(), "We should only query the global module fragment from the C++20 Named modules");
    for SubModule in self.submodules() {
        if SubModule.isExplicitGlobalModule() {
            return SubModule;
        }
    }
    return null;
}

fn Module::getPrivateModuleFragment(self: *Module) -> *mut Module {
    assert!(self.isNamedModuleUnit(), "We should only query the private module fragment from the C++20 Named modules");
    for SubModule in self.submodules() {
        if SubModule.isPrivateModule() {
            return SubModule;
        }
    }
    return null;
}

fn Module::getExportedModules(self: *Module, Exported: *mut SmallVectorImpl<Module *>) {
    for Mod in self.submodules() {
        if !Mod.IsExplicit {
            Exported.push(Mod);
        }
    }
    let mut AnyWildcard: bool = false;
    let mut UnrestrictedWildcard: bool = false;
    let mut WildcardRestrictions: SmallVector<Module *, 4> = SmallVector<Module *, 4> {};
    for let mut I: u32 = 0;
let mut N: u32 = self.Exports.len; I != N; I += 1 {
        let mut Mod: *mut Module = self.Exports[I].first.operator clang::Module *();
        if !self.Exports[I].second {
            Exported.push(Mod);
            continue;
        }
        AnyWildcard = true;
        if UnrestrictedWildcard {
            continue;
        }
        if self.Exports[I].first.operator clang::Module *() {
            Restriction;
        } else {
            WildcardRestrictions.push(Restriction);
        }
    }
    if !AnyWildcard {
        return;
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.Imports.len; I != N; I += 1 {
        let mut Mod: *mut Module = self.Imports[I].operator clang::Module *();
        let mut Acceptable: bool = UnrestrictedWildcard;
        if !Acceptable {
            for let mut R: u32 = 0;
let mut NR: u32 = WildcardRestrictions.len; R != NR; R += 1 {
                let mut Restriction: *mut Module = WildcardRestrictions[R];
                if Mod == Restriction || Mod.isSubModuleOf(Restriction) {
                    Acceptable = true;
                    break;
                }
            }
        }
        if !Acceptable {
            continue;
        }
        Exported.push(Mod);
    }
}

fn Module::buildVisibleModulesCache(self: *Module) {
    assert!(self.VisibleModulesCache.is_empty(), "cache does not need building");
    self.VisibleModulesCache.insert(self);
    let mut Stack: SmallVector<Module *, 16> = SmallVector<Module *, 16> { self.Imports.begin(), self.Imports.end() };
    while !Stack.is_empty() {
        let mut CurrModule: *mut Module = Stack.pop_back_val();
        if self.VisibleModulesCache.insert(CurrModule).second {
            CurrModule.getExportedModules(Stack);
        }
    }
}

fn Module::print(self: *Module, OS: *mut raw_ostream, Indent: u32, Dump: bool) {
    OS.indent(Indent);
    if self.IsFramework {
        OS << "framework ";
    }
    if self.IsExplicit {
        OS << "explicit ";
    }
    OS << "module ";
    printModuleId(OS, &mut self.Name, &mut self.Name + 1, true);
    if self.IsSystem || self.IsExternC {
        OS.indent(Indent + 2);
        if self.IsSystem {
            OS << " [system]";
        }
        if self.IsExternC {
            OS << " [extern_c]";
        }
    }
    OS << " {\n";
    if !self.Requirements.is_empty() {
        OS.indent(Indent + 2);
        OS << "requires ";
        for let mut I: u32 = 0;
let mut N: u32 = self.Requirements.len; I != N; I += 1 {
            if I {
                OS << ", ";
            }
            if !self.Requirements[I].RequiredState {
                OS << "!";
            }
            OS << self.Requirements[I].FeatureName;
        }
        OS << "\n";
    }
    if self.getUmbrellaHeaderAsWritten() {
        H;
    } else {
        OS.indent(Indent + 2);
        OS << "umbrella header \"";
        OS.write_escaped(operator(H).NameAsWritten, false);
        OS << "\"\n";
    }
    if !self.ConfigMacros.is_empty() || self.ConfigMacrosExhaustive {
        OS.indent(Indent + 2);
        OS << "config_macros ";
        if self.ConfigMacrosExhaustive {
            OS << "[exhaustive]";
        }
        for let mut I: u32 = 0;
let mut N: u32 = self.ConfigMacros.len; I != N; I += 1 {
            if I {
                OS << ", ";
            }
            OS << self.ConfigMacros[I];
        }
        OS << "\n";
    }
    let mut Kinds: [5](unnamed at P:\Goraw\llvm-project\clang\lib\Basic\Module.cpp:513:3) = [(unnamed at P:\Goraw\llvm-project\clang\lib\Basic\Module.cpp:513:3) { "", HK_Normal }, (unnamed at P:\Goraw\llvm-project\clang\lib\Basic\Module.cpp:513:3) { "textual ", HK_Textual }, (unnamed at P:\Goraw\llvm-project\clang\lib\Basic\Module.cpp:513:3) { "private ", HK_Private }, (unnamed at P:\Goraw\llvm-project\clang\lib\Basic\Module.cpp:513:3) { "private textual ", HK_PrivateTextual }, (unnamed at P:\Goraw\llvm-project\clang\lib\Basic\Module.cpp:513:3) { "exclude ", HK_Excluded }];
    for K in Kinds[..] {
        assert!(&mut K == &mut Kinds[K.Kind], "kinds in wrong order");
        for H in self.getHeaders(K.Kind) {
            OS.indent(Indent + 2);
            OS << K.Prefix << "header \"";
            OS.write_escaped(H.NameAsWritten, false);
            OS << "\" { size " << H.Entry.getSize() << " mtime " << H.Entry.getModificationTime() << " }\n";
        }
    }
    for Unresolved in [&mut self.UnresolvedHeaders, &mut self.MissingHeaders] {
        for U in *Unresolved {
            OS.indent(Indent + 2);
            OS << Kinds[U.Kind].Prefix << "header \"";
            OS.write_escaped(U.FileName, false);
            OS << "\"";
            if U.Size || U.ModTime {
                OS << " {";
                if U.Size {
                    OS << " size " << operator(U.Size);
                }
                if U.ModTime {
                    OS << " mtime " << operator(U.ModTime);
                }
                OS << " }";
            }
            OS << "\n";
        }
    }
    if !self.ExportAsModule.is_empty() {
        OS.indent(Indent + 2);
        OS << "export_as" << self.ExportAsModule << "\n";
    }
    for Submodule in self.submodules() {
        if !Submodule.IsInferred || Submodule.IsFramework {
            Submodule.print(OS, Indent + 2, Dump);
        }
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.Exports.len; I != N; I += 1 {
        OS.indent(Indent + 2);
        OS << "export ";
        if self.Exports[I].first.operator clang::Module *() {
            Restriction;
        } else {
            OS << Restriction.getFullModuleName(true);
            if self.Exports[I].second {
                OS << ".*";
            }
        }
        OS << "\n";
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.UnresolvedExports.len; I != N; I += 1 {
        OS.indent(Indent + 2);
        OS << "export ";
        printModuleId(OS, self.UnresolvedExports[I].Id);
        if self.UnresolvedExports[I].Wildcard {
            OS << (if self.UnresolvedExports[I].Id.is_empty() { "*" } else { ".*" });
        }
        OS << "\n";
    }
    if Dump {
        for M in self.Imports {
            OS.indent(Indent + 2);
            errs() << "import " << M.getFullModuleName(false) << "\n";
        }
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.DirectUses.len; I != N; I += 1 {
        OS.indent(Indent + 2);
        OS << "use ";
        OS << self.DirectUses[I].getFullModuleName(true);
        OS << "\n";
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.UnresolvedDirectUses.len; I != N; I += 1 {
        OS.indent(Indent + 2);
        OS << "use ";
        printModuleId(OS, self.UnresolvedDirectUses[I]);
        OS << "\n";
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.LinkLibraries.len; I != N; I += 1 {
        OS.indent(Indent + 2);
        OS << "link ";
        if self.LinkLibraries[I].IsFramework {
            OS << "framework ";
        }
        OS << "\"";
        OS.write_escaped(self.LinkLibraries[I].Library, false);
        OS << "\"";
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.UnresolvedConflicts.len; I != N; I += 1 {
        OS.indent(Indent + 2);
        OS << "conflict ";
        printModuleId(OS, self.UnresolvedConflicts[I].Id);
        OS << ", \"";
        OS.write_escaped(self.UnresolvedConflicts[I].Message, false);
        OS << "\"\n";
    }
    for let mut I: u32 = 0;
let mut N: u32 = self.Conflicts.len; I != N; I += 1 {
        OS.indent(Indent + 2);
        OS << "conflict ";
        OS << operator(self.Conflicts[I].Other).getFullModuleName(true);
        OS << ", \"";
        OS.write_escaped(self.Conflicts[I].Message, false);
        OS << "\"\n";
    }
    if self.InferSubmodules {
        OS.indent(Indent + 2);
        if self.InferExplicitSubmodules {
            OS << "explicit ";
        }
        OS << "module * {\n";
        if self.InferExportWildcard {
            OS.indent(Indent + 4);
            OS << "export *\n";
        }
        OS.indent(Indent + 2);
        OS << "}\n";
    }
    OS.indent(Indent);
    OS << "}\n";
}

fn Module::dump(self: *Module) {
    self.print(errs(), 0, true);
}

fn VisibleModuleSet::setVisible(self, M: *mut Module, Loc: SourceLocation, IncludeExports: bool, Vis: VisibleCallback, Cb: ConflictCallback) {
    assert!((M.isGlobalModule() || Loc.isValid()), "setVisible expects a valid import location");
    if self.isVisible(M) {
        return;
    }
    self.Generation += 1;
    let mut VisitModule: function<void (Visiting)> = Closure_3 { cap_0: self, Loc: &mut Loc, Vis: &mut Vis, IncludeExports: &mut IncludeExports, VisitModule: &mut VisitModule, Cb: &mut Cb };
    VisitModule.call(Visiting { M, null });
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, LHS: str, RHS: str) -> bool {
        let mut Pos: u64 = LHS.find('-', 0);
        if Pos == npos {
            return false;
        }
        let mut NewLHS: str = LHS.slice(0, Pos);
        operator(NewLHS, LHS.slice(Pos + 1, LHS.len));
        return NewLHS.operator StringRef() == RHS;
    }

struct Closure_2 {
    Unimportable: bool,
}

fn Closure_2::call(self: *Closure_2, M: *mut Module) -> bool {
        return M.IsAvailable || (!M.IsUnimportable && self.Unimportable);
    }

struct Closure_3 {
    cap_0: *mut VisibleModuleSet,
    Loc: *mut SourceLocation,
    Vis: *mut VisibleCallback,
    IncludeExports: *mut bool,
    VisitModule: *mut function<void (Visiting)>,
    Cb: *mut ConflictCallback,
}

unsafe fn Closure_3::call(self: *mut Closure_3, V: Visiting) {
        let mut ID: u32 = V.M.getVisibilityID();
        if self.ImportLocs.len <= ID {
            self.ImportLocs.resize(ID + 1);
        } else if self.ImportLocs[ID].isValid() {
            return;
        }
        self.ImportLocs[ID] = (*self.Loc);
        (*self.Vis).call(V.M);
        if (*self.IncludeExports) {
            let mut Exports: SmallVector<Module *, 16> = SmallVector<Module *, 16> {};
            V.M.getExportedModules(Exports);
            for E in Exports {
                if !E.isUnimportable() {
                    (*self.VisitModule).call(Visiting { E, &mut V });
                }
            }
        }
        for C in V.M.Conflicts {
            if self.isVisible(C.Other.operator clang::Module *()) {
                let mut Path: SmallVector<Module *, 8> = SmallVector<Module *, 8> {};
                for let mut I: *mut Visiting = &mut V; I; I = I.ExportedBy {
                    Path.push(I.M);
                }
                (*self.Cb).call(Path, C.Other.operator clang::Module *(), C.Message);
            }
        }
    }
