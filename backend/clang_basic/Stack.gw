static mut BottomOfStack: u64 = 0;

fn noteBottomOfStack(ForceSet: bool) {
    if !BottomOfStack || ForceSet {
        BottomOfStack = getStackPointer();
    }
}

fn isStackNearlyExhausted() -> bool {
    let mut SufficientStack: u64 = 256 << 10;
    if !BottomOfStack {
        return false;
    }
    let mut StackDiff: i64 = getStackPointer() as i64 - BottomOfStack as i64;
    let mut StackUsage: u64 = if StackDiff < 0 { -StackDiff } else { StackDiff } as u64;
    if StackUsage > DesiredStackSize {
        return false;
    }
    return StackUsage >= DesiredStackSize - SufficientStack;
}

fn runWithSufficientStackSpaceSlow(Diag: function_ref<void ()>, Fn: function_ref<void ()>) {
    let mut CRC: CrashRecoveryContext = CrashRecoveryContext {};
    let mut PrevBottom: u64 = BottomOfStack;
    CRC.RunSafelyOnNewStack(function_ref<void ()> { Closure_1 { Diag: &mut Diag, Fn: &mut Fn }, null, null }, DesiredStackSize);
    BottomOfStack = PrevBottom;
}

struct Closure_1 {
    Diag: *mut function_ref<void ()>,
    Fn: *mut function_ref<void ()>,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> auto {
        noteBottomOfStack(true);
        (*self.Diag).call();
        (*self.Fn).call();
    }
