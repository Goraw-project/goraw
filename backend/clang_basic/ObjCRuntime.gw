fn ObjCRuntime::getAsString(self: *ObjCRuntime) -> str {
    let mut Result: str = "";
    {
        let mut Out: raw_string_ostream = Result;
        Out << *self;
    }
    return Result;
}

fn op_<<(out: *mut raw_ostream, value: *ObjCRuntime) -> *mut raw_ostream {
    match value.getKind() {
        MacOSX => {
            out << "macosx";
        },
        FragileMacOSX => {
            out << "macosx-fragile";
        },
        iOS => {
            out << "ios";
        },
        WatchOS => {
            out << "watchos";
        },
        GNUstep => {
            out << "gnustep";
        },
        GCC => {
            out << "gcc";
        },
        ObjFW => {
            out << "objfw";
        },
    }
    if value.getVersion() > 0 {
        out << '-' << value.getVersion();
    }
    return out;
}

fn ObjCRuntime::tryParse(self, input: str) -> bool {
    let mut dash: size_t = input.rfind('-', npos);
    if dash != npos && dash + 1 != input.len && (input[dash + 1] < '0' || input[dash + 1] > '9') {
        dash = npos;
    }
    let mut kind: Kind = zeroed();
    let mut runtimeName: str = input[0..0 + dash];
    self.Version = 0;
    if runtimeName == "macosx" {
        kind = MacOSX;
    } else if runtimeName == "macosx-fragile" {
        kind = FragileMacOSX;
    } else if runtimeName == "ios" {
        kind = iOS;
    } else if runtimeName == "watchos" {
        kind = WatchOS;
    } else if runtimeName == "gnustep" {
        self.Version = VersionTuple { 1, 6 };
        kind = GNUstep;
    } else if runtimeName == "gcc" {
        kind = GCC;
    } else if runtimeName == "objfw" {
        kind = ObjFW;
        self.Version = VersionTuple { 0, 8 };
    } else {
        return true;
    }
    self.TheKind = kind;
    if dash != npos {
        let mut verString: str = input[dash + 1..dash + 1 + npos];
        if self.Version.tryParse(verString) {
            return true;
        }
    }
    if kind == ObjFW && self.Version > VersionTuple { 0, 8 } {
        self.Version = VersionTuple { 0, 8 };
    }
    return false;
}
