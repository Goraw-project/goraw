fn EmitUnknownDiagWarning(Diags: *mut DiagnosticsEngine, Flavor: Flavor, Prefix: str, Opt: str) {
    let mut Suggestion: str = getNearestOption(Flavor, Opt);
    Diags.Report(warn_unknown_diag_option) << (if Flavor == WarningOrError { 0 } else { 1 }) << (operator(Prefix, Opt[0..allocator<char> {}])) << !Suggestion.is_empty() << (operator(Prefix, Suggestion[0..allocator<char> {}]));
}

fn ProcessWarningOptions(Diags: *mut DiagnosticsEngine, Opts: *DiagnosticOptions, VFS: *mut FileSystem, ReportDiags: bool) {
    Diags.setSuppressSystemWarnings(true);
    Diags.setIgnoreAllWarnings(Opts.IgnoreWarnings);
    Diags.setShowOverloads(Opts.getShowOverloads());
    Diags.setElideType(Opts.ElideType);
    Diags.setPrintTemplateTree(Opts.ShowTemplateTree);
    Diags.setShowColors(Opts.showColors(StandardErrHasColors()));
    if Opts.ErrorLimit {
        Diags.setErrorLimit(Opts.ErrorLimit);
    }
    if Opts.TemplateBacktraceLimit {
        Diags.setTemplateBacktraceLimit(Opts.TemplateBacktraceLimit);
    }
    if Opts.ConstexprBacktraceLimit {
        Diags.setConstexprBacktraceLimit(Opts.ConstexprBacktraceLimit);
    }
    if Opts.PedanticErrors {
        Diags.setExtensionHandlingBehavior(Error);
    } else if Opts.Pedantic {
        Diags.setExtensionHandlingBehavior(Warning);
    } else {
        Diags.setExtensionHandlingBehavior(Ignored);
    }
    let mut _Diags: kind, 10> = kind, 10> {};
    let mut DiagIDs: IntrusiveRefCntPtr<DiagnosticIDs> = Diags.getDiagnosticIDs();
    for let mut Report: u32 = 0;
let mut ReportEnd: u32 = 2; Report != ReportEnd; Report += 1 {
        let mut SetDiagnostic: bool = (Report == 0);
        if !SetDiagnostic && !ReportDiags {
            break;
        }
        for let mut i: u32 = 0;
let mut e: u32 = Opts.Warnings.len; i != e; i += 1 {
            let mut Flavor: Flavor = WarningOrError;
            let mut Opt: str = Opts.Warnings[i];
            let mut OrigOpt: str = Opts.Warnings[i];
            if Opt == "format=0" {
                Opt = "no-format";
            }
            let mut isPositive: bool = !Opt.consume_front("no-");
            let mut Mapping: Severity = if isPositive { Warning } else { Ignored };
            if Opt == "system-headers" {
                if SetDiagnostic {
                    Diags.setSuppressSystemWarnings(!isPositive);
                }
                continue;
            }
            if Opt == "everything" {
                if SetDiagnostic {
                    if isPositive {
                        Diags.setEnableAllWarnings(true);
                    } else {
                        Diags.setEnableAllWarnings(false);
                        Diags.setSeverityForAll(Flavor, Ignored, SourceLocation {});
                    }
                }
                continue;
            }
            if Opt.starts_with("error") {
                let mut Specifier: str = "";
                if Opt.len > 5 {
                    if Opt[5] != '=' && Opt[5..5 + npos] != "-implicit-function-declaration" {
                        if Report {
                            Diags.Report(warn_unknown_warning_specifier) << "-Werror" << ("-W" + OrigOpt);
                        }
                        continue;
                    }
                    Specifier = Opt[6..6 + npos];
                }
                if Specifier.is_empty() {
                    if SetDiagnostic {
                        Diags.setWarningsAsErrors(isPositive);
                    }
                    continue;
                }
                if SetDiagnostic {
                    Diags.setDiagnosticGroupWarningAsError(Specifier, isPositive);
                } else if operator(DiagIDs).getDiagnosticsInGroup(Flavor, Specifier, _Diags) {
                    EmitUnknownDiagWarning(Diags, Flavor, "-Werror=", Specifier);
                }
                continue;
            }
            if Opt.starts_with("fatal-errors") {
                let mut Specifier: str = "";
                if Opt.len != 12 {
                    if (Opt[12] != '=' && Opt[12] != '-') || Opt.len == 13 {
                        if Report {
                            Diags.Report(warn_unknown_warning_specifier) << "-Wfatal-errors" << ("-W" + OrigOpt);
                        }
                        continue;
                    }
                    Specifier = Opt[13..13 + npos];
                }
                if Specifier.is_empty() {
                    if SetDiagnostic {
                        Diags.setErrorsAsFatal(isPositive);
                    }
                    continue;
                }
                if SetDiagnostic {
                    Diags.setDiagnosticGroupErrorAsFatal(Specifier, isPositive);
                } else if operator(DiagIDs).getDiagnosticsInGroup(Flavor, Specifier, _Diags) {
                    EmitUnknownDiagWarning(Diags, Flavor, "-Wfatal-errors=", Specifier);
                }
                continue;
            }
            if Report {
                if operator(DiagIDs).getDiagnosticsInGroup(Flavor, Opt, _Diags) {
                    EmitUnknownDiagWarning(Diags, Flavor, if isPositive { "-W" } else { "-Wno-" }, Opt);
                }
            } else {
                Diags.setSeverityForGroup(Flavor, Opt, Mapping, SourceLocation {});
            }
        }
        for Opt in Opts.Remarks {
            let mut Flavor: Flavor = Remark;
            let mut IsPositive: bool = !Opt.consume_front("no-");
            let mut Severity: Severity = if IsPositive { Remark } else { Ignored };
            if Opt == "everything" {
                if SetDiagnostic {
                    Diags.setSeverityForAll(Flavor, Severity, SourceLocation {});
                }
                continue;
            }
            if Report {
                if operator(DiagIDs).getDiagnosticsInGroup(Flavor, Opt, _Diags) {
                    EmitUnknownDiagWarning(Diags, Flavor, if IsPositive { "-R" } else { "-Rno-" }, Opt);
                }
            } else {
                Diags.setSeverityForGroup(Flavor, Opt, if IsPositive { Remark } else { Ignored }, SourceLocation {});
            }
        }
    }
    if !Opts.DiagnosticSuppressionMappingsFile.is_empty() {
        if VFS.getBufferForFile(Opts.DiagnosticSuppressionMappingsFile, -1, true, false, true) {
            FileContents;
        } else {
            Diags.setDiagSuppressionMapping(operator(operator(FileContents)));
        }
    }
}
