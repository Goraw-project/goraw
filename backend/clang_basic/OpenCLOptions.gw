const DependentFeaturesList: [5]pair<StringRef, StringRef> = [pair<StringRef, StringRef> { "__opencl_c_read_write_images", "__opencl_c_images" }, pair<StringRef, StringRef> { "__opencl_c_3d_image_writes", "__opencl_c_images" }, pair<StringRef, StringRef> { "__opencl_c_pipes", "__opencl_c_generic_address_space" }, pair<StringRef, StringRef> { "__opencl_c_device_enqueue", "__opencl_c_generic_address_space" }, pair<StringRef, StringRef> { "__opencl_c_device_enqueue", "__opencl_c_program_scope_global_variables" }];

const FeatureExtensionMap: [2]pair<StringRef, StringRef> = [pair<StringRef, StringRef> { "cl_khr_fp64", "__opencl_c_fp64" }, pair<StringRef, StringRef> { "cl_khr_3d_image_writes", "__opencl_c_3d_image_writes" }];

fn OpenCLOptions::isKnown(self: *OpenCLOptions, Ext: str) -> bool {
    return self.OptMap.contains(Ext);
}

fn OpenCLOptions::isAvailableOption(self: *OpenCLOptions, Ext: str, LO: *LangOptions) -> bool {
    if !self.isKnown(Ext) {
        return false;
    }
    let mut OptInfo: *OpenCLOptionInfo = operator(self.OptMap.find(Ext)).getValue();
    if OptInfo.isCoreIn(LO) || OptInfo.isOptionalCoreIn(LO) {
        return self.isSupported(Ext, LO);
    }
    return self.isEnabled(Ext);
}

fn OpenCLOptions::isEnabled(self: *OpenCLOptions, Ext: str) -> bool {
    let mut I: const_iterator = self.OptMap.find(Ext);
    return I != self.OptMap.end() && operator(I).getValue().Enabled;
}

fn OpenCLOptions::isWithPragma(self: *OpenCLOptions, Ext: str) -> bool {
    let mut E: const_iterator = self.OptMap.find(Ext);
    return E != self.OptMap.end() && operator(E).second.WithPragma;
}

fn OpenCLOptions::isSupported(self: *OpenCLOptions, Ext: str, LO: *LangOptions) -> bool {
    let mut I: const_iterator = self.OptMap.find(Ext);
    return I != self.OptMap.end() && operator(I).getValue().Supported && operator(I).getValue().isAvailableIn(LO);
}

fn OpenCLOptions::isSupportedCore(self: *OpenCLOptions, Ext: str, LO: *LangOptions) -> bool {
    let mut I: const_iterator = self.OptMap.find(Ext);
    return I != self.OptMap.end() && operator(I).getValue().Supported && operator(I).getValue().isCoreIn(LO);
}

fn OpenCLOptions::isSupportedOptionalCore(self: *OpenCLOptions, Ext: str, LO: *LangOptions) -> bool {
    let mut I: const_iterator = self.OptMap.find(Ext);
    return I != self.OptMap.end() && operator(I).getValue().Supported && operator(I).getValue().isOptionalCoreIn(LO);
}

fn OpenCLOptions::isSupportedCoreOrOptionalCore(self: *OpenCLOptions, Ext: str, LO: *LangOptions) -> bool {
    return self.isSupportedCore(Ext, LO) || self.isSupportedOptionalCore(Ext, LO);
}

fn OpenCLOptions::isSupportedExtension(self: *OpenCLOptions, Ext: str, LO: *LangOptions) -> bool {
    let mut I: const_iterator = self.OptMap.find(Ext);
    return I != self.OptMap.end() && operator(I).getValue().Supported && operator(I).getValue().isAvailableIn(LO) && !self.isSupportedCoreOrOptionalCore(Ext, LO);
}

fn OpenCLOptions::enable(self, Ext: str, V: bool) {
    self.OptMap[Ext].Enabled = V;
}

fn OpenCLOptions::acceptsPragma(self, Ext: str, V: bool) {
    self.OptMap[Ext].WithPragma = V;
}

fn OpenCLOptions::support(self, Ext: str, V: bool) {
    assert!(!Ext.is_empty(), "Extension is empty.");
    assert!(Ext[0] != '+' && Ext[0] != '-');
    self.OptMap[Ext].Supported = V;
}

