const DefaultAddrSpaceMap: LangASMap = LangASMap {};

const FakeAddrSpaceMap: LangASMap = void { void { Default, 0 }, void { opencl_global, 1 }, void { opencl_local, 3 }, void { opencl_constant, 2 }, void { opencl_private, 0 }, void { opencl_generic, 4 }, void { opencl_global_device, 5 }, void { opencl_global_host, 6 }, void { cuda_device, 7 }, void { cuda_constant, 8 }, void { cuda_shared, 9 }, void { sycl_global, 1 }, void { sycl_global_device, 5 }, void { sycl_global_host, 6 }, void { sycl_local, 3 }, void { sycl_private, 0 }, void { sycl_generic, 4 }, void { sycl_constant, 2 }, void { ptr32_sptr, 10 }, void { ptr32_uptr, 11 }, void { ptr64, 12 }, void { hlsl_groupshared, 13 }, void { hlsl_constant, 14 }, void { hlsl_private, 15 }, void { hlsl_device, 16 }, void { hlsl_input, 17 }, void { hlsl_output, 18 }, void { hlsl_push_constant, 19 }, void { wasm_funcref, 20 }, void { amdgpu_barrier, 21 } };

fn TargetInfo::TargetInfo(self, T: *Triple) {
    self.HasMustTail = true;
    self.BigEndian = !T.isLittleEndian();
    self.TLSSupported = true;
    self.VLASupported = true;
    self.NoAsmVariants = false;
    self.HasFastHalfType = false;
    self.HalfArgsAndReturns = false;
    self.HasFloat128 = false;
    self.HasIbm128 = false;
    self.HasFloat16 = false;
    self.HasBFloat16 = false;
    self.HasFullBFloat16 = false;
    self.HasLongDouble = true;
    self.HasFPReturn = true;
    self.HasStrictFP = false;
    self.MaxAtomicPromoteWidth = self.MaxAtomicInlineWidth = 0;
    self.MCountName = "mcount";
    self.UserLabelPrefix = if self.Triple.isOSBinFormatMachO() { "_" } else { "" };
    self.RegParmMax = 0;
    self.SSERegParmMax = 0;
    self.HasAlignMac68kSupport = false;
    self.HasBuiltinMSVaList = false;
    self.HasBuiltinZOSVaList = false;
    self.HasAArch64ACLETypes = false;
    self.HasRISCVVTypes = false;
    self.HasAMDGPUTypes = false;
    self.AllowAMDGPUUnsafeFPAtomics = false;
    self.HasUnalignedAccess = false;
    self.ARMCDECoprocMask = 0;
    self.RealTypeUsesObjCFPRetMask = 0;
    self.ComplexLongDoubleUsesFP2Ret = false;
    self.TheCXXABI.set(if self.Triple.isKnownWindowsMSVCEnvironment() || self.Triple.isUEFI() { Microsoft } else { GenericItanium });
    self.HasMicrosoftRecordLayout = self.TheCXXABI.isMicrosoft();
    self.AddrSpaceMap = &mut DefaultAddrSpaceMap;
    self.UseAddrSpaceMapMangling = false;
    self.PlatformName = "unknown";
    self.PlatformMinVersion = VersionTuple {};
    self.MaxOpenCLWorkGroupSize = 1024;
    self.MaxBitIntWidth.reset();
}

fn TargetInfo::~TargetInfo(self) {}

fn TargetInfo::getMaxBitIntWidth(self: *TargetInfo) -> u64 {
    if self.MaxBitIntWidth {
        return min(operator(self.MaxBitIntWidth), MAX_INT_BITS);
    }
    return 128;
}

fn TargetInfo::resetDataLayout(self, DL: str) {
    self.DataLayoutString = DL;
}

fn TargetInfo::resetDataLayout(self) {
    self.DataLayoutString = self.Triple.computeDataLayout(self.getABI());
}

