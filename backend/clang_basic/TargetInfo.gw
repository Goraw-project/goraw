const DefaultAddrSpaceMap: LangASMap = LangASMap {};

const FakeAddrSpaceMap: LangASMap = [pair<LangAS, unsigned int> { Default, 0 }, pair<LangAS, unsigned int> { opencl_global, 1 }, pair<LangAS, unsigned int> { opencl_local, 3 }, pair<LangAS, unsigned int> { opencl_constant, 2 }, pair<LangAS, unsigned int> { opencl_private, 0 }, pair<LangAS, unsigned int> { opencl_generic, 4 }, pair<LangAS, unsigned int> { opencl_global_device, 5 }, pair<LangAS, unsigned int> { opencl_global_host, 6 }, pair<LangAS, unsigned int> { cuda_device, 7 }, pair<LangAS, unsigned int> { cuda_constant, 8 }, pair<LangAS, unsigned int> { cuda_shared, 9 }, pair<LangAS, unsigned int> { sycl_global, 1 }, pair<LangAS, unsigned int> { sycl_global_device, 5 }, pair<LangAS, unsigned int> { sycl_global_host, 6 }, pair<LangAS, unsigned int> { sycl_local, 3 }, pair<LangAS, unsigned int> { sycl_private, 0 }, pair<LangAS, unsigned int> { sycl_generic, 4 }, pair<LangAS, unsigned int> { sycl_constant, 2 }, pair<LangAS, unsigned int> { ptr32_sptr, 10 }, pair<LangAS, unsigned int> { ptr32_uptr, 11 }, pair<LangAS, unsigned int> { ptr64, 12 }, pair<LangAS, unsigned int> { hlsl_groupshared, 13 }, pair<LangAS, unsigned int> { hlsl_constant, 14 }, pair<LangAS, unsigned int> { hlsl_private, 15 }, pair<LangAS, unsigned int> { hlsl_device, 16 }, pair<LangAS, unsigned int> { hlsl_input, 17 }, pair<LangAS, unsigned int> { hlsl_output, 18 }, pair<LangAS, unsigned int> { hlsl_push_constant, 19 }, pair<LangAS, unsigned int> { wasm_funcref, 20 }, pair<LangAS, unsigned int> { amdgpu_barrier, 21 }];

fn TargetInfo::TargetInfo(self, T: *Triple) {
    self.HasMustTail = true;
    self.BigEndian = !T.isLittleEndian();
    self.TLSSupported = true;
    self.VLASupported = true;
    self.NoAsmVariants = false;
    self.HasFastHalfType = false;
    self.HalfArgsAndReturns = false;
    self.HasFloat128 = false;
    self.HasIbm128 = false;
    self.HasFloat16 = false;
    self.HasBFloat16 = false;
    self.HasFullBFloat16 = false;
    self.HasLongDouble = true;
    self.HasFPReturn = true;
    self.HasStrictFP = false;
    self.PointerWidth = self.PointerAlign = 32;
    self.BoolWidth = self.BoolAlign = 8;
    self.ShortWidth = self.ShortAlign = 16;
    self.IntWidth = self.IntAlign = 32;
    self.LongWidth = self.LongAlign = 32;
    self.LongLongWidth = self.LongLongAlign = 64;
    self.Int128Align = 128;
    self.ShortAccumWidth = self.ShortAccumAlign = 16;
    self.AccumWidth = self.AccumAlign = 32;
    self.LongAccumWidth = self.LongAccumAlign = 64;
    self.ShortFractWidth = self.ShortFractAlign = 8;
    self.FractWidth = self.FractAlign = 16;
    self.LongFractWidth = self.LongFractAlign = 32;
    self.PaddingOnUnsignedFixedPoint = false;
    self.ShortAccumScale = 7;
    self.AccumScale = 15;
    self.LongAccumScale = 31;
    self.SuitableAlign = 64;
    self.DefaultAlignForAttributeAligned = 128;
    self.MinGlobalAlign = 0;
    if T.isGNUEnvironment() || T.isWindowsMSVCEnvironment() || T.isAndroid() || T.isOHOSFamily() {
        self.NewAlign = if self.Triple.isArch64Bit() { 128 } else { if self.Triple.isArch32Bit() { 64 } else { 0 } };
    } else if T.isOSDarwin() || T.isOSOpenBSD() {
        self.NewAlign = 128;
    } else {
        self.NewAlign = 0;
    }
    self.HalfWidth = 16;
    self.HalfAlign = 16;
    self.FloatWidth = 32;
    self.FloatAlign = 32;
    self.DoubleWidth = 64;
    self.DoubleAlign = 64;
    self.LongDoubleWidth = 64;
    self.LongDoubleAlign = 64;
    self.Float128Align = 128;
    self.Ibm128Align = 128;
    self.LargeArrayMinWidth = 0;
    self.LargeArrayAlign = 0;
    self.MaxAtomicPromoteWidth = self.MaxAtomicInlineWidth = 0;
    self.MaxVectorAlign = 0;
    self.MaxTLSAlign = 0;
    self.VectorsAreElementAligned = false;
    self.SizeType = UnsignedLong;
    self.PtrDiffType = SignedLong;
    self.IntMaxType = SignedLongLong;
    self.IntPtrType = SignedLong;
    self.WCharType = SignedInt;
    self.WIntType = SignedInt;
    self.Char16Type = UnsignedShort;
    self.Char32Type = UnsignedInt;
    self.Int64Type = SignedLongLong;
    self.Int16Type = SignedShort;
    self.SigAtomicType = SignedInt;
    self.ProcessIDType = SignedInt;
    self.UseSignedCharForObjCBool = true;
    self.UseBitFieldTypeAlignment = true;
    self.UseZeroLengthBitfieldAlignment = false;
    self.UseLeadingZeroLengthBitfield = true;
    self.UseExplicitBitFieldAlignment = true;
    self.ZeroLengthBitfieldBoundary = 0;
    self.LargestOverSizedBitfieldContainer = 64;
    self.MaxAlignedAttribute = 0;
    self.HalfFormat = &mut IEEEhalf();
    self.FloatFormat = &mut IEEEsingle();
    self.DoubleFormat = &mut IEEEdouble();
    self.LongDoubleFormat = &mut IEEEdouble();
    self.Float128Format = &mut IEEEquad();
    self.Ibm128Format = &mut PPCDoubleDouble();
    self.MCountName = "mcount";
    self.UserLabelPrefix = if self.Triple.isOSBinFormatMachO() { "_" } else { "" };
    self.RegParmMax = 0;
    self.SSERegParmMax = 0;
    self.HasAlignMac68kSupport = false;
    self.HasBuiltinMSVaList = false;
    self.HasBuiltinZOSVaList = false;
    self.HasAArch64ACLETypes = false;
    self.HasRISCVVTypes = false;
    self.HasAMDGPUTypes = false;
    self.AllowAMDGPUUnsafeFPAtomics = false;
    self.HasUnalignedAccess = false;
    self.ARMCDECoprocMask = 0;
    self.RealTypeUsesObjCFPRetMask = 0;
    self.ComplexLongDoubleUsesFP2Ret = false;
    self.TheCXXABI.set(if self.Triple.isKnownWindowsMSVCEnvironment() || self.Triple.isUEFI() { Microsoft } else { GenericItanium });
    self.HasMicrosoftRecordLayout = self.TheCXXABI.isMicrosoft();
    self.AddrSpaceMap = &mut DefaultAddrSpaceMap;
    self.UseAddrSpaceMapMangling = false;
    self.PlatformName = "unknown";
    self.PlatformMinVersion = VersionTuple {};
    self.MaxOpenCLWorkGroupSize = 1024;
    self.MaxBitIntWidth.reset();
}

fn TargetInfo::~TargetInfo(self) {}

fn TargetInfo::getMaxBitIntWidth(self: *TargetInfo) -> u64 {
    if self.MaxBitIntWidth {
        return if operator(self.MaxBitIntWidth) < MAX_INT_BITS { operator(self.MaxBitIntWidth) } else { MAX_INT_BITS };
    }
    return 128;
}

fn TargetInfo::resetDataLayout(self, DL: str) {
    self.DataLayoutString = DL;
}

fn TargetInfo::resetDataLayout(self) {
    self.DataLayoutString = self.Triple.computeDataLayout(self.getABI());
}

fn TargetInfo::checkCFProtectionBranchSupported(self: *TargetInfo, Diags: *mut DiagnosticsEngine) -> bool {
    Diags.Report(err_opt_not_valid_on_target) << "cf-protection=branch";
    return false;
}

fn TargetInfo::getDefaultCFBranchLabelScheme(self: *TargetInfo) -> CFBranchLabelSchemeKind {
    report_fatal_error("not implemented", true);
}

fn TargetInfo::checkCFBranchLabelSchemeSupported(self: *TargetInfo, Scheme: CFBranchLabelSchemeKind, Diags: *mut DiagnosticsEngine) -> bool {
    if Scheme != Default {
        Diags.Report(err_opt_not_valid_on_target) << ("mcf-branch-label-scheme=" + getCFBranchLabelSchemeFlagVal(Scheme));
    }
    return false;
}

fn TargetInfo::checkCFProtectionReturnSupported(self: *TargetInfo, Diags: *mut DiagnosticsEngine) -> bool {
    Diags.Report(err_opt_not_valid_on_target) << "cf-protection=return";
    return false;
}

fn TargetInfo::getTypeName(self, T: IntType) -> *u8 {
    match T {
        _ => {
            llvm_unreachable_internal("not an integer!", "P:/Goraw/llvm-project/clang/lib/Basic/TargetInfo.cpp", 261);
        },
        SignedChar => {
            return "signed char";
        },
        UnsignedChar => {
            return "unsigned char";
        },
        SignedShort => {
            return "short";
        },
        UnsignedShort => {
            return "unsigned short";
        },
        SignedInt => {
            return "int";
        },
        UnsignedInt => {
            return "unsigned int";
        },
        SignedLong => {
            return "long int";
        },
        UnsignedLong => {
            return "long unsigned int";
        },
        SignedLongLong => {
            return "long long int";
        },
        UnsignedLongLong => {
            return "long long unsigned int";
        },
    }
}

fn TargetInfo::getTypeConstantSuffix(self: *TargetInfo, T: IntType) -> *u8 {
    match T {
        _ => {
            llvm_unreachable_internal("not an integer!", "P:/Goraw/llvm-project/clang/lib/Basic/TargetInfo.cpp", 279);
        },
        SignedChar => {
            SignedShort;
        },
        SignedLong => {
            return "L";
        },
        SignedLongLong => {
            return "LL";
        },
        UnsignedChar => {
            if self.getCharWidth() < self.getIntWidth() {
                return "";
            }
        },
        UnsignedShort => {
            if self.getShortWidth() < self.getIntWidth() {
                return "";
            }
        },
        UnsignedInt => {
            return "U";
        },
        UnsignedLong => {
            return "UL";
        },
        UnsignedLongLong => {
            return "ULL";
        },
    }
}

