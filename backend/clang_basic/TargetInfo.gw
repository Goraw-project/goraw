fn TargetInfo::getIntTypeByWidth(self: *TargetInfo, BitWidth: u32, IsSigned: bool) -> IntType {
    if self.getCharWidth() == BitWidth {
        return if IsSigned { SignedChar } else { UnsignedChar };
    }
    if self.getShortWidth() == BitWidth {
        return if IsSigned { SignedShort } else { UnsignedShort };
    }
    if self.getIntWidth() == BitWidth {
        return if IsSigned { SignedInt } else { UnsignedInt };
    }
    if self.getLongWidth() == BitWidth {
        return if IsSigned { SignedLong } else { UnsignedLong };
    }
    if self.getLongLongWidth() == BitWidth {
        return if IsSigned { SignedLongLong } else { UnsignedLongLong };
    }
    return NoInt;
}

fn TargetInfo::getLeastIntTypeByWidth(self: *TargetInfo, BitWidth: u32, IsSigned: bool) -> IntType {
    if self.getCharWidth() >= BitWidth {
        return if IsSigned { SignedChar } else { UnsignedChar };
    }
    if self.getShortWidth() >= BitWidth {
        return if IsSigned { SignedShort } else { UnsignedShort };
    }
    if self.getIntWidth() >= BitWidth {
        return if IsSigned { SignedInt } else { UnsignedInt };
    }
    if self.getLongWidth() >= BitWidth {
        return if IsSigned { SignedLong } else { UnsignedLong };
    }
    if self.getLongLongWidth() >= BitWidth {
        return if IsSigned { SignedLongLong } else { UnsignedLongLong };
    }
    return NoInt;
}

fn TargetInfo::getRealTypeByWidth(self: *TargetInfo, BitWidth: u32, ExplicitType: FloatModeKind) -> FloatModeKind {
    if self.getHalfWidth() == BitWidth {
        return Half;
    }
    if self.getFloatWidth() == BitWidth {
        return Float;
    }
    if self.getDoubleWidth() == BitWidth {
        return Double;
    }
    match BitWidth {
        96 => {
            if &mut self.getLongDoubleFormat() == &mut x87DoubleExtended() {
                return LongDouble;
            }
        },
        128 => {
            if ExplicitType == Float128 {
                return if self.hasFloat128Type() { Float128 } else { NoFloat };
            }
        },
    }
    return NoFloat;
}

