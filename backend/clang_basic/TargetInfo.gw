fn TargetInfo::adjust(self, Diags: *mut DiagnosticsEngine, Opts: *mut LangOptions, Aux: *TargetInfo) {
    if Opts.NoBitFieldTypeAlign {
        self.UseBitFieldTypeAlignment = false;
    }
    match Opts.WCharSize {
        _ => {
            llvm_unreachable_internal("invalid wchar_t width", "P:/Goraw/llvm-project/clang/lib/Basic/TargetInfo.cpp", 448);
        },
        0 => {
            break;
        },
        1 => {
            self.WCharType = if Opts.WCharIsSigned { SignedChar } else { UnsignedChar };
        },
        2 => {
            self.WCharType = if Opts.WCharIsSigned { SignedShort } else { UnsignedShort };
        },
        4 => {
            self.WCharType = if Opts.WCharIsSigned { SignedInt } else { UnsignedInt };
        },
    }
    if Opts.AlignDouble {
        self.DoubleAlign = self.LongLongAlign = 64;
        self.LongDoubleAlign = 64;
    }
    if Opts.HLSL {
        self.BoolWidth = self.BoolAlign = 32;
        self.LongWidth = self.LongAlign = 64;
        if !Opts.NativeHalfType {
            self.HalfFormat = &mut IEEEsingle();
            self.HalfWidth = self.HalfAlign = 32;
        }
    }
    if Opts.OpenCL {
        self.ShortWidth = self.ShortAlign = 16;
        self.IntWidth = self.IntAlign = 32;
        self.LongWidth = self.LongAlign = 64;
        self.LongLongWidth = self.LongLongAlign = 128;
        self.HalfWidth = self.HalfAlign = 16;
        self.FloatWidth = self.FloatAlign = 32;
        if self.DoubleWidth != self.FloatWidth {
            self.DoubleWidth = self.DoubleAlign = 64;
            self.DoubleFormat = &mut IEEEdouble();
        }
        self.LongDoubleWidth = self.LongDoubleAlign = 128;
        let mut MaxPointerWidth: u32 = self.getMaxPointerWidth();
        assert!(MaxPointerWidth == 32 || MaxPointerWidth == 64);
        let mut Is32BitArch: bool = MaxPointerWidth == 32;
        self.SizeType = if Is32BitArch { UnsignedInt } else { UnsignedLong };
        self.PtrDiffType = if Is32BitArch { SignedInt } else { SignedLong };
        self.IntPtrType = if Is32BitArch { SignedInt } else { SignedLong };
        self.IntMaxType = SignedLongLong;
        self.Int64Type = SignedLong;
        self.HalfFormat = &mut IEEEhalf();
        self.FloatFormat = &mut IEEEsingle();
        self.LongDoubleFormat = &mut IEEEquad();
        if Opts.getOpenCLCompatibleVersion() >= 300 {
            let mut OpenCLFeaturesMap: *StringMap<bool> = self.getSupportedOpenCLOpts();
            Opts.OpenCLGenericAddressSpace = self.hasFeatureEnabled(OpenCLFeaturesMap, "__opencl_c_generic_address_space");
            Opts.OpenCLPipes = self.hasFeatureEnabled(OpenCLFeaturesMap, "__opencl_c_pipes");
            Opts.Blocks = self.hasFeatureEnabled(OpenCLFeaturesMap, "__opencl_c_device_enqueue");
        }
    }
    if Opts.DoubleSize {
        if Opts.DoubleSize == 32 {
            self.DoubleWidth = 32;
            self.LongDoubleWidth = 32;
            self.DoubleFormat = &mut IEEEsingle();
            self.LongDoubleFormat = &mut IEEEsingle();
        } else if Opts.DoubleSize == 64 {
            self.DoubleWidth = 64;
            self.LongDoubleWidth = 64;
            self.DoubleFormat = &mut IEEEdouble();
            self.LongDoubleFormat = &mut IEEEdouble();
        }
    }
    if Opts.LongDoubleSize {
        if Opts.LongDoubleSize == self.DoubleWidth {
            self.LongDoubleWidth = self.DoubleWidth;
            self.LongDoubleAlign = self.DoubleAlign;
            self.LongDoubleFormat = self.DoubleFormat;
        } else if Opts.LongDoubleSize == 128 {
            self.LongDoubleWidth = self.LongDoubleAlign = 128;
            self.LongDoubleFormat = &mut IEEEquad();
        } else if Opts.LongDoubleSize == 80 {
            self.LongDoubleFormat = &mut x87DoubleExtended();
            if self.getTriple().isWindowsMSVCEnvironment() {
                self.LongDoubleWidth = 128;
                self.LongDoubleAlign = 128;
            } else {
                if self.getTriple().getArch() == x86 {
                    self.LongDoubleWidth = 96;
                    self.LongDoubleAlign = 32;
                } else {
                    self.LongDoubleWidth = 128;
                    self.LongDoubleAlign = 128;
                }
            }
        }
    }
    if Opts.NewAlignOverride {
        self.NewAlign = Opts.NewAlignOverride * self.getCharWidth();
    }
    self.PaddingOnUnsignedFixedPoint |= Opts.PaddingOnUnsignedFixedPoint;
    self.CheckFixedPointBits();
    if Opts.ProtectParens && !self.checkArithmeticFenceSupported() {
        Diags.Report(err_opt_not_valid_on_target) << "-fprotect-parens";
        Opts.ProtectParens = false;
    }
    if Opts.MaxBitIntWidth {
        self.MaxBitIntWidth = Opts.MaxBitIntWidth as u32;
    }
    if Opts.FakeAddressSpaceMap {
        self.AddrSpaceMap = &mut FakeAddrSpaceMap;
    }
    if Opts.CUDA && Opts.CUDAIsDevice && Aux && !self.HasMicrosoftRecordLayout {
        self.HasMicrosoftRecordLayout = Aux.getCXXABI().isMicrosoft();
    }
}

fn TargetInfo::initFeatureMap(self: *TargetInfo, Features: *mut StringMap<bool>, Diags: *mut DiagnosticsEngine, CPU: str, FeatureVec: *[]str) -> bool {
    for Name in FeatureVec {
        if Name.is_empty() {
            continue;
        }
        if Name[0] != '+' && Name[0] != '-' {
            Diags.Report(warn_fe_backend_invalid_feature_flag) << Name;
        } else {
            self.setFeatureEnabled(Features, Name[1..1 + npos], Name[0] == '+');
        }
    }
    return true;
}

fn TargetInfo::parseTargetAttr(self: *TargetInfo, Features: str) -> ParsedTargetAttr {
    let mut Ret: ParsedTargetAttr = ParsedTargetAttr {};
    if Features == "default" {
        return Ret;
    }
    let mut AttrFeatures: SmallVector<StringRef, 1> = SmallVector<StringRef, 1> {};
    Features.split(AttrFeatures, ",", -1, true);
    for Feature in AttrFeatures {
        Feature = Feature.trim(" \t\n\v\f\r");
        if Feature.starts_with("fpmath=") {
            continue;
        }
        if Feature.starts_with("branch-protection=") {
            Ret.BranchProtection = Feature.split('=').second.trim(" \t\n\v\f\r");
            continue;
        }
        if Feature.starts_with("arch=") {
            if !Ret.CPU.is_empty() {
                Ret.Duplicate = "arch=";
            } else {
                Ret.CPU = Feature.split("=").second.trim(" \t\n\v\f\r");
            }
        } else if Feature.starts_with("tune=") {
            if !Ret.Tune.is_empty() {
                Ret.Duplicate = "tune=";
            } else {
                Ret.Tune = Feature.split("=").second.trim(" \t\n\v\f\r");
            }
        } else if Feature.starts_with("no-") {
            Ret.Features.push("-" + Feature.split("-").second);
        } else {
            Ret.Features.push("+" + Feature);
        }
    }
    return Ret;
}

fn TargetInfo::getCallingConvKind(self: *TargetInfo, ClangABICompat4: bool) -> CallingConvKind {
    if self.getCXXABI() != Microsoft && (ClangABICompat4 || self.getTriple().isPS4()) {
        return CCK_ClangABI4OrPS4;
    }
    return CCK_Default;
}

fn TargetInfo::getVTableUniqueness(self: *TargetInfo) -> VTableUniquenessKind {
    return AlwaysUnique;
}

fn TargetInfo::callGlobalDeleteInDeletingDtor(self: *TargetInfo, LangOpts: *LangOptions) -> bool {
    if self.getCXXABI() == Microsoft && !LangOpts.isCompatibleWith(Ver21) {
        return true;
    }
    return false;
}

fn TargetInfo::emitVectorDeletingDtors(self: *TargetInfo, LangOpts: *LangOptions) -> bool {
    if self.getCXXABI() == Microsoft && !LangOpts.isCompatibleWith(Ver21) {
        return true;
    }
    return false;
}

fn TargetInfo::areDefaultedSMFStillPOD(self: *TargetInfo, LangOpts: *LangOptions) -> bool {
    return !LangOpts.isCompatibleWith(Ver15);
}

fn TargetInfo::setDependentOpenCLOpts(self) {
    let mut Opts: *mut StringMap<bool> = self.getSupportedOpenCLOpts();
    if !self.hasFeatureEnabled(Opts, "cl_khr_fp64") || !self.hasFeatureEnabled(Opts, "__opencl_c_fp64") {
        self.setFeatureEnabled(Opts, "__opencl_c_ext_fp64_global_atomic_add", false);
        self.setFeatureEnabled(Opts, "__opencl_c_ext_fp64_local_atomic_add", false);
        self.setFeatureEnabled(Opts, "__opencl_c_ext_fp64_global_atomic_min_max", false);
        self.setFeatureEnabled(Opts, "__opencl_c_ext_fp64_local_atomic_min_max", false);
    }
}

fn TargetInfo::getOpenCLTypeAddrSpace(self: *TargetInfo, TK: OpenCLTypeKind) -> LangAS {
    match TK {
        OCLTK_Image => {
            OCLTK_Pipe;
        },
        OCLTK_Sampler => {
            return opencl_constant;
        },
        _ => {
            return Default;
        },
    }
}

fn removeGCCRegisterPrefix(Name: str) -> str {
    if Name[0] == '%' || Name[0] == '#' {
        Name = Name[1..1 + npos];
    }
    return Name;
}

fn TargetInfo::isValidClobber(self: *TargetInfo, Name: str) -> bool {
    return (self.isValidGCCRegisterName(Name) || Name == "memory" || Name == "cc" || Name == "unwind");
}

fn TargetInfo::isValidGCCRegisterName(self: *TargetInfo, Name: str) -> bool {
    if Name.is_empty() {
        return false;
    }
    Name = removeGCCRegisterPrefix(Name);
    if Name.is_empty() {
        return false;
    }
    let mut Names: ArrayRef<const char *> = self.getGCCRegNames();
    if isDigit(Name[0]) {
        let mut n: u32 = 0;
        if !Name.getAsInteger(0, n) {
            return n < Names.len;
        }
    }
    if is_contained(Names, Name) {
        return true;
    }
    for ARN in self.getGCCAddlRegNames() {
        for AN in ARN.Names[..] {
            if !AN {
                break;
            }
            if AN == Name && ARN.RegNum < Names.len {
                return true;
            }
        }
    }
    for GRA in self.getGCCRegAliases() {
        for A in GRA.Aliases[..] {
            if !A {
                break;
            }
            if A == Name {
                return true;
            }
        }
    }
    return false;
}

fn TargetInfo::getNormalizedGCCRegisterName(self: *TargetInfo, Name: str, ReturnCanonical: bool) -> str {
    assert!(self.isValidGCCRegisterName(Name), "Invalid register passed in");
    Name = removeGCCRegisterPrefix(Name);
    let mut Names: ArrayRef<const char *> = self.getGCCRegNames();
    if isDigit(Name[0]) {
        let mut n: u32 = 0;
        if !Name.getAsInteger(0, n) {
            assert!(n < Names.len, "Out of bounds register number!");
            return Names[n];
        }
    }
    for ARN in self.getGCCAddlRegNames() {
        for AN in ARN.Names[..] {
            if !AN {
                break;
            }
            if AN == Name && ARN.RegNum < Names.len {
                return if ReturnCanonical { Names[ARN.RegNum] } else { Name };
            }
        }
    }
    for RA in self.getGCCRegAliases() {
        for A in RA.Aliases[..] {
            if !A {
                break;
            }
            if A == Name {
                return RA.Register;
            }
        }
    }
    return Name;
}

fn TargetInfo::validateOutputConstraint(self: *TargetInfo, Info: *mut ConstraintInfo) -> bool {
    let mut Name: *u8 = Info.getConstraintStr().ptr;
    if *Name != '=' && *Name != '+' {
        return false;
    }
    if *Name == '+' {
        Info.setIsReadWrite();
    }
    Name += 1;
    while *Name {
        match *Name {
            _ => {
                if !self.validateAsmConstraint(Name, Info) {
                    return false;
                }
            },
            '&' => {
                Info.setEarlyClobber();
            },
            '%' => {
                break;
            },
            'r' => {
                Info.setAllowsRegister();
            },
            'm' => {
                'o';
            },
            'g' => {
                'X';
            },
            ',' => {
                if Name[1] == '=' || Name[1] == '+' {
                    Name += 1;
                }
            },
            '#' => {
                while Name[1] && Name[1] != ',' {
                    Name += 1;
                }
            },
            '?' => {
                '!';
            },
        }
        Name += 1;
    }
    if Info.earlyClobber() && Info.isReadWrite() && !Info.allowsRegister() {
        return false;
    }
    return Info.allowsMemory() || Info.allowsRegister();
}

fn TargetInfo::resolveSymbolicName(self: *TargetInfo, Name: **mut u8, OutputConstraints: ArrayRef<ConstraintInfo>, Index: *mut u32) -> bool {
    assert!(*Name == '[', "Symbolic name did not start with '['");
    Name += 1;
    let mut Start: *u8 = Name;
    while *Name && *Name != ']' {
        Name += 1;
    }
    if !*Name {
        return false;
    }
    let mut SymbolicName: str = Start[0..Name - Start];
    for Index = 0; Index != OutputConstraints.len; Index += 1 {
        if SymbolicName == OutputConstraints[Index].getName() {
            return true;
        }
    }
    return false;
}

fn TargetInfo::validateInputConstraint(self: *TargetInfo, OutputConstraints: MutableArrayRef<ConstraintInfo>, Info: *mut ConstraintInfo) -> bool {
    let mut Name: *u8 = Info.ConstraintStr.ptr;
    if !*Name {
        return false;
    }
    while *Name {
        match *Name {
            _ => {
                if *Name >= '0' && *Name <= '9' {
                    let mut DigitStart: *u8 = Name;
                    while Name[1] >= '0' && Name[1] <= '9' {
                        Name += 1;
                    }
                    let mut DigitEnd: *u8 = Name;
                    let mut i: u32 = 0;
                    if DigitStart[0..DigitEnd - DigitStart + 1].getAsInteger(10, i) {
                        return false;
                    }
                    if i >= OutputConstraints.len {
                        return false;
                    }
                    if OutputConstraints[i].isReadWrite() {
                        return false;
                    }
                    if Info.hasTiedOperand() && Info.getTiedOperand() != i {
                        return false;
                    }
                    Info.setTiedOperand(i, OutputConstraints[i]);
                } else if !self.validateAsmConstraint(Name, Info) {
                    return false;
                }
            },
            '[' => {
                let mut Index: u32 = 0;
                if !self.resolveSymbolicName(Name, OutputConstraints, Index) {
                    return false;
                }
                if Info.hasTiedOperand() && Info.getTiedOperand() != Index {
                    return false;
                }
                if OutputConstraints[Index].isReadWrite() {
                    return false;
                }
                Info.setTiedOperand(Index, OutputConstraints[Index]);
                break;
            },
            '%' => {
                break;
            },
            'i' => {
                break;
            },
            'n' => {
                Info.setRequiresImmediate();
            },
            'I' => {
                'J';
            },
            'r' => {
                Info.setAllowsRegister();
            },
            'm' => {
                'o';
            },
            'g' => {
                'X';
            },
            'E' => {
                'F';
            },
            ',' => {
                break;
            },
            '#' => {
                while Name[1] && Name[1] != ',' {
                    Name += 1;
                }
            },
            '?' => {
                '!';
            },
        }
        Name += 1;
    }
    return true;
}

fn TargetInfo::validatePointerAuthKey(self: *TargetInfo, value: *APSInt) -> bool {
    return false;
}

fn TargetInfo::CheckFixedPointBits(self: *TargetInfo) {
    assert!(self.ShortAccumScale + self.getShortAccumIBits() + 1 <= self.ShortAccumWidth);
    assert!(self.AccumScale + self.getAccumIBits() + 1 <= self.AccumWidth);
    assert!(self.LongAccumScale + self.getLongAccumIBits() + 1 <= self.LongAccumWidth);
    assert!(self.getUnsignedShortAccumScale() + self.getUnsignedShortAccumIBits() <= self.ShortAccumWidth);
    assert!(self.getUnsignedAccumScale() + self.getUnsignedAccumIBits() <= self.AccumWidth);
    assert!(self.getUnsignedLongAccumScale() + self.getUnsignedLongAccumIBits() <= self.LongAccumWidth);
    assert!(self.getShortFractScale() + 1 <= self.ShortFractWidth);
    assert!(self.getFractScale() + 1 <= self.FractWidth);
    assert!(self.getLongFractScale() + 1 <= self.LongFractWidth);
    assert!(self.getUnsignedShortFractScale() <= self.ShortFractWidth);
    assert!(self.getUnsignedFractScale() <= self.FractWidth);
    assert!(self.getUnsignedLongFractScale() <= self.LongFractWidth);
    assert!(self.getShortFractScale() == self.getUnsignedShortFractScale() || self.getShortFractScale() == self.getUnsignedShortFractScale() - 1);
    assert!(self.getFractScale() == self.getUnsignedFractScale() || self.getFractScale() == self.getUnsignedFractScale() - 1);
    assert!(self.getLongFractScale() == self.getUnsignedLongFractScale() || self.getLongFractScale() == self.getUnsignedLongFractScale() - 1);
    assert!(self.getLongFractScale() >= self.getFractScale() && self.getFractScale() >= self.getShortFractScale();
    assert!(self.getUnsignedLongFractScale() >= self.getUnsignedFractScale() && self.getUnsignedFractScale() >= self.getUnsignedShortFractScale();
    assert!(self.LongAccumScale >= self.AccumScale && self.AccumScale >= self.ShortAccumScale);
    assert!(self.getUnsignedLongAccumScale() >= self.getUnsignedAccumScale() && self.getUnsignedAccumScale() >= self.getUnsignedShortAccumScale();
    assert!(self.getLongAccumIBits() >= self.getAccumIBits() && self.getAccumIBits() >= self.getShortAccumIBits();
    assert!(self.getUnsignedLongAccumIBits() >= self.getUnsignedAccumIBits() && self.getUnsignedAccumIBits() >= self.getUnsignedShortAccumIBits();
    assert!(self.getShortAccumIBits() >= self.getUnsignedShortAccumIBits();
    assert!(self.getAccumIBits() >= self.getUnsignedAccumIBits();
    assert!(self.getLongAccumIBits() >= self.getUnsignedLongAccumIBits();
}

fn TargetInfo::copyAuxTarget(self, Aux: *TargetInfo) {
    let mut Target: *mut TransferrableTargetInfo = self as *mut TransferrableTargetInfo;
    let mut Src: *TransferrableTargetInfo = Aux as *TransferrableTargetInfo;
    *Target = *Src;
}

fn TargetInfo::simplifyConstraint(self: *TargetInfo, Constraint: str, OutCons: *mut SmallVectorImpl<ConstraintInfo>) -> str {
    let mut Result: str = "";
    Constraint = Constraint.split(0).first;
    for let mut I: *u8 = Constraint.begin();
let mut E: *u8 = Constraint.end(); I < E; I += 1 {
        match *I {
            _ => {
                operator(Result, self.convertConstraint(I));
            },
            '*' => {
                '?';
            },
            '#' => {
                while I + 1 != E && I[1] != ',' {
                    I += 1;
                }
            },
            '&' => {
                '%';
            },
            ',' => {
                operator(Result, "|");
            },
            'g' => {
                operator(Result, "imr");
            },
            '[' => {
                assert!(OutCons, "Must pass output names to constraints with a symbolic name");
                let mut Index: u32 = 0;
                let mut ResolveResult: bool = self.resolveSymbolicName(I, *OutCons, Index);
                assert!(ResolveResult, "Could not resolve symbolic name");
                ResolveResult as void;
                operator(Result, utostr(Index, false));
                break;
            },
        }
    }
    return Result;
}

fn Microsoft64BitMinGlobalAlign(TypeSize: u64) -> u32 {
    if TypeSize >= 512 {
        return 128;
    }
    if TypeSize >= 64 {
        return 64;
    }
    if TypeSize >= 16 {
        return 32;
    }
    return 0;
}
