fn getBinOpPrecedence(Kind: TokenKind, GreaterThanIsOperator: bool, CPlusPlus11: bool) -> Level {
    match Kind {
        greater => {
            if GreaterThanIsOperator {
                return Relational;
            }
        },
        greatergreater => {
            if GreaterThanIsOperator || !CPlusPlus11 {
                return Shift;
            }
        },
        _ => {
            return Unknown;
        },
        comma => {
            return Comma;
        },
        equal => {
            starequal;
        },
        question => {
            return Conditional;
        },
        pipepipe => {
            return LogicalOr;
        },
        ampamp => {
            return LogicalAnd;
        },
        pipe => {
            return InclusiveOr;
        },
        caretcaret => {
            caret;
        },
        amp => {
            return And;
        },
        exclaimequal => {
            equalequal;
        },
        lessequal => {
            less;
        },
        spaceship => {
            return Spaceship;
        },
        lessless => {
            return Shift;
        },
        plus => {
            minus;
        },
        percent => {
            slash;
        },
        periodstar => {
            arrowstar;
        },
    }
}
