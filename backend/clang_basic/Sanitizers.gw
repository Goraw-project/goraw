    let mut ParsedKind: SanitizerMask = Value.StartsWith("address=", Address).StartsWith("pointer-compare=", PointerCompare).StartsWith("pointer-subtract=", PointerSubtract).StartsWith("kernel-address=", KernelAddress).StartsWith("hwaddress=", HWAddress).StartsWith("kernel-hwaddress=", KernelHWAddress).StartsWith("memtag-stack=", MemtagStack).StartsWith("memtag-heap=", MemtagHeap).StartsWith("memtag-globals=", MemtagGlobals).StartsWith("memtag=", if AllowGroups { MemTagGroup } else { SanitizerMask {} }).StartsWith("memory=", Memory).StartsWith("kernel-memory=", KernelMemory).StartsWith("fuzzer=", Fuzzer).StartsWith("fuzzer-no-link=", FuzzerNoLink).StartsWith("type=", Type).StartsWith("thread=", Thread).StartsWith("numerical=", NumericalStability).StartsWith("realtime=", Realtime).StartsWith("leak=", Leak).StartsWith("alignment=", Alignment).StartsWith("array-bounds=", ArrayBounds).StartsWith("bool=", Bool).StartsWith("builtin=", Builtin).StartsWith("enum=", Enum).StartsWith("float-cast-overflow=", FloatCastOverflow).StartsWith("float-divide-by-zero=", FloatDivideByZero).StartsWith("function=", Function).StartsWith("integer-divide-by-zero=", IntegerDivideByZero).StartsWith("nonnull-attribute=", NonnullAttribute).StartsWith("null=", Null).StartsWith("nullability-arg=", NullabilityArg).StartsWith("nullability-assign=", NullabilityAssign).StartsWith("nullability-return=", NullabilityReturn).StartsWith("nullability=", if AllowGroups { NullabilityGroup } else { SanitizerMask {} }).StartsWith("object-size=", ObjectSize).StartsWith("pointer-overflow=", PointerOverflow).StartsWith("return=", Return).StartsWith("returns-nonnull-attribute=", ReturnsNonnullAttribute).StartsWith("shift-base=", ShiftBase).StartsWith("shift-exponent=", ShiftExponent).StartsWith("shift=", if AllowGroups { ShiftGroup } else { SanitizerMask {} }).StartsWith("signed-integer-overflow=", SignedIntegerOverflow).StartsWith("unreachable=", Unreachable).StartsWith("vla-bound=", VLABound).StartsWith("vptr=", Vptr).StartsWith("unsigned-integer-overflow=", UnsignedIntegerOverflow).StartsWith("unsigned-shift-base=", UnsignedShiftBase).StartsWith("dataflow=", DataFlow).StartsWith("cfi-cast-strict=", CFICastStrict).StartsWith("cfi-derived-cast=", CFIDerivedCast).StartsWith("cfi-icall=", CFIICall).StartsWith("cfi-mfcall=", CFIMFCall).StartsWith("cfi-unrelated-cast=", CFIUnrelatedCast).StartsWith("cfi-nvcall=", CFINVCall).StartsWith("cfi-vcall=", CFIVCall).StartsWith("cfi=", if AllowGroups { CFIGroup } else { SanitizerMask {} }).StartsWith("kcfi=", KCFI).StartsWith("safe-stack=", SafeStack).StartsWith("shadow-call-stack=", ShadowCallStack).StartsWith("undefined=", if AllowGroups { UndefinedGroup } else { SanitizerMask {} }).StartsWith("undefined-trap=", if AllowGroups { UndefinedTrapGroup } else { SanitizerMask {} }).StartsWith("implicit-unsigned-integer-truncation=", ImplicitUnsignedIntegerTruncation).StartsWith("implicit-signed-integer-truncation=", ImplicitSignedIntegerTruncation).StartsWith("implicit-integer-truncation=", if AllowGroups { ImplicitIntegerTruncationGroup } else { SanitizerMask {} }).StartsWith("implicit-integer-sign-change=", ImplicitIntegerSignChange).StartsWith("implicit-integer-arithmetic-value-change=", if AllowGroups { ImplicitIntegerArithmeticValueChangeGroup } else { SanitizerMask {} }).StartsWith("implicit-integer-conversion=", if AllowGroups { ImplicitIntegerConversionGroup } else { SanitizerMask {} }).StartsWith("implicit-bitfield-conversion=", ImplicitBitfieldConversion).StartsWith("implicit-conversion=", if AllowGroups { ImplicitConversionGroup } else { SanitizerMask {} }).StartsWith("integer=", if AllowGroups { IntegerGroup } else { SanitizerMask {} }).StartsWith("objc-cast=", ObjCCast).StartsWith("local-bounds=", LocalBounds).StartsWith("bounds=", if AllowGroups { BoundsGroup } else { SanitizerMask {} }).StartsWith("scudo=", Scudo).StartsWith("alloc-token=", AllocToken).StartsWith("all=", if AllowGroups { AllGroup } else { SanitizerMask {} }).Default(SanitizerMask {});
    if operator(ParsedKind) {
        return false;
    }
    let mut A: f64 = 0.0;
    if W.getAsDouble(A, true) || A < 0.0 || A > 1.0 {
        return false;
    }
    Cutoffs.set(expandSanitizerGroups(ParsedKind), A);
    return true;
}

