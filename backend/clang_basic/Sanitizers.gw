const SanitizerMaskCutoffsEps: f64 = 9.99999971E-10;

fn SanitizerMaskCutoffs::set(self, K: SanitizerMask, V: f64) {
    if V < SanitizerMaskCutoffsEps && self.Cutoffs.is_empty() {
        return;
    }
    for let mut i: u32 = 0; i < SO_Count; i += 1 {
        if K & bitPosToMask(i) {
            self.Cutoffs.resize(SO_Count);
            self.Cutoffs[i] = V;
        }
    }
}

fn SanitizerMaskCutoffs::operator[](self: *SanitizerMaskCutoffs, Kind: u32) -> optional<double> {
    if self.Cutoffs.is_empty() || self.Cutoffs[Kind] < SanitizerMaskCutoffsEps {
        return nullopt;
    }
    return self.Cutoffs[Kind];
}

fn SanitizerMaskCutoffs::clear(self, K: SanitizerMask) {
    self.set(K, 0);
}

fn SanitizerMaskCutoffs::getAllScaled(self: *SanitizerMaskCutoffs, ScalingFactor: u32) -> vector<unsigned int>> {
    let mut ScaledCutoffs: []u32 = []u32 {};
    let mut AnyCutoff: bool = false;
    for let mut i: u32 = 0; i < SO_Count; i += 1 {
        let mut C: optional<double> = (*self)[i];
        if C.has_value() {
            ScaledCutoffs.push(lround(clamp(operator(C), 0.0, 1.0) * ScalingFactor));
            AnyCutoff = true;
        } else {
            ScaledCutoffs.push(0);
        }
    }
    if AnyCutoff {
        return ScaledCutoffs;
    }
    return nullopt;
}

