edCast).Case("cfi-nvcall", CFINVCall).Case("cfi-vcall", CFIVCall).Case("cfi", if AllowGroups { CFIGroup } else { SanitizerMask {} }).Case("kcfi", KCFI).Case("safe-stack", SafeStack).Case("shadow-call-stack", ShadowCallStack).Case("undefined", if AllowGroups { UndefinedGroup } else { SanitizerMask {} }).Case("undefined-trap", if AllowGroups { UndefinedTrapGroup } else { SanitizerMask {} }).Case("implicit-unsigned-integer-truncation", ImplicitUnsignedIntegerTruncation).Case("implicit-signed-integer-truncation", ImplicitSignedIntegerTruncation).Case("implicit-integer-truncation", if AllowGroups { ImplicitIntegerTruncationGroup } else { SanitizerMask {} }).Case("implicit-integer-sign-change", ImplicitIntegerSignChange).Case("implicit-integer-arithmetic-value-change", if AllowGroups { ImplicitIntegerArithmeticValueChangeGroup } else { SanitizerMask {} }).Case("implicit-integer-conversion", if AllowGroups { ImplicitIntegerConversionGroup } else { SanitizerMask {} }).Case("implicit-bitfield-conversion", ImplicitBitfieldConversion).Case("implicit-conversion", if AllowGroups { ImplicitConversionGroup } else { SanitizerMask {} }).Case("integer", if AllowGroups { IntegerGroup } else { SanitizerMask {} }).Case("objc-cast", ObjCCast).Case("local-bounds", LocalBounds).Case("bounds", if AllowGroups { BoundsGroup } else { SanitizerMask {} }).Case("scudo", Scudo).Case("alloc-token", AllocToken).Case("all", if AllowGroups { AllGroup } else { SanitizerMask {} }).Default(SanitizerMask {});
    return ParsedKind;
}

