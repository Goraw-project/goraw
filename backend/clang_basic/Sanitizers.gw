fn expandSanitizerGroups(Kinds: SanitizerMask) -> SanitizerMask {
    if Kinds & MemTagGroup {
        operator(Kinds, MemTag);
    }
    if Kinds & NullabilityGroup {
        operator(Kinds, Nullability);
    }
    if Kinds & ShiftGroup {
        operator(Kinds, Shift);
    }
    if Kinds & CFIGroup {
        operator(Kinds, CFI);
    }
    if Kinds & UndefinedGroup {
        operator(Kinds, Undefined);
    }
    if Kinds & UndefinedTrapGroup {
        operator(Kinds, UndefinedTrap);
    }
    if Kinds & ImplicitIntegerTruncationGroup {
        operator(Kinds, ImplicitIntegerTruncation);
    }
    if Kinds & ImplicitIntegerArithmeticValueChangeGroup {
        operator(Kinds, ImplicitIntegerArithmeticValueChange);
    }
    if Kinds & ImplicitIntegerConversionGroup {
        operator(Kinds, ImplicitIntegerConversion);
    }
    if Kinds & ImplicitConversionGroup {
        operator(Kinds, ImplicitConversion);
    }
    if Kinds & IntegerGroup {
        operator(Kinds, Integer);
    }
    if Kinds & BoundsGroup {
        operator(Kinds, Bounds);
    }
    if Kinds & AllGroup {
        operator(Kinds, All);
    }
    return Kinds;
}

fn SanitizerMask::hash_value(self: *SanitizerMask) -> hash_code {
    return hash_combine_range(&mut self.maskLoToHigh[0], &mut self.maskLoToHigh[kNumElem]);
}

fn SanitizerMask::countPopulation(self: *SanitizerMask) -> u32 {
    let mut total: u32 = 0;
    for Val in self.maskLoToHigh[..] {
        total += popcount(Val);
    }
    return total;
}

fn hash_value(Arg: *SanitizerMask) -> hash_code {
    return Arg.hash_value();
}

fn AsanDtorKindToString(kind: AsanDtorKind) -> str {
    match kind {
        None => {
            return "none";
        },
        Global => {
            return "global";
        },
        Invalid => {
            return "invalid";
        },
    }
    return "invalid";
}

fn AsanDtorKindFromString(kindStr: str) -> AsanDtorKind {
    return kindStr.Case("none", None).Case("global", Global).Default(Invalid);
}

fn AsanDetectStackUseAfterReturnModeToString(mode: AsanDetectStackUseAfterReturnMode) -> str {
    match mode {
        Always => {
            return "always";
        },
        Runtime => {
            return "runtime";
        },
        Never => {
            return "never";
        },
        Invalid => {
            return "invalid";
        },
    }
    return "invalid";
}

fn AsanDetectStackUseAfterReturnModeFromString(modeStr: str) -> AsanDetectStackUseAfterReturnMode {
    return modeStr.Case("always", Always).Case("runtime", Runtime).Case("never", Never).Default(Invalid);
}
