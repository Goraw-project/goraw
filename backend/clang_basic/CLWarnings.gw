fn diagGroupFromCLWarningID(CLWarningID: u32) -> Group> {
    match CLWarningID {
        4005 => {
            return MacroRedefined;
        },
        4018 => {
            return SignCompare;
        },
        4100 => {
            return UnusedParameter;
        },
        4910 => {
            return DllexportExplicitInstantiationDecl;
        },
        4996 => {
            return DeprecatedDeclarations;
        },
    }
    return Group> {};
}
