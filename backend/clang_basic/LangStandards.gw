fn LangStandard::getLangKind(self, Name: str) -> Kind {}

fn LangStandard::getHLSLLangKind(self, Name: str) -> Kind {}

fn LangStandard::getLangStandardForName(self, Name: str) -> *LangStandard {
    let mut K: Kind = getLangKind(Name);
    if K == lang_unspecified {
        return null;
    }
    return &mut getLangStandardForKind(K);
}

fn getDefaultLanguageStandard(Lang: Language, T: *Triple) -> Kind {
    match Lang {
        Unknown => {
            LLVM_IR;
        },
        OpenCL => {
            return lang_opencl12;
        },
        OpenCLCXX => {
            return lang_openclcpp10;
        },
        Asm => {
            C;
        },
        ObjC => {
            return lang_gnu11;
        },
        CXX => {
            ObjCXX;
        },
        HLSL => {
            return lang_hlsl202x;
        },
    }
    llvm_unreachable_internal("unhandled Language kind!", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\LangStandards.cpp", 121);
}
