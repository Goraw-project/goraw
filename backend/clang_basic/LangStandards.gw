fn languageToString(L: Language) -> str {
    match L {
        Unknown => {
            return "Unknown";
        },
        Asm => {
            return "Asm";
        },
        LLVM_IR => {
            return "LLVM IR";
        },
        CIR => {
            return "ClangIR";
        },
        C => {
            return "C";
        },
        CXX => {
            return "C++";
        },
        ObjC => {
            return "Objective-C";
        },
        ObjCXX => {
            return "Objective-C++";
        },
        OpenCL => {
            return "OpenCL";
        },
        OpenCLCXX => {
            return "OpenCLC++";
        },
        CUDA => {
            return "CUDA";
        },
        HIP => {
            return "HIP";
        },
        HLSL => {
            return "HLSL";
        },
    }
    llvm_unreachable_internal("unhandled language kind", "P:\\Goraw\\llvm-project\\clang\\lib\\Basic\\LangStandards.cpp", 46);
}

fn LangStandard::getLangStandardForKind(self, K: Kind) -> *LangStandard {
    match K {
        lang_unspecified => {
            report_fatal_error("getLangStandardForKind() on unspecified kind", true);
        },
        lang_c89 => {
            return Lang_c89;
        },
        lang_c94 => {
            return Lang_c94;
        },
        lang_gnu89 => {
            return Lang_gnu89;
