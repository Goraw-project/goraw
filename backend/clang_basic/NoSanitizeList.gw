fn NoSanitizeList::~NoSanitizeList(self) {}

fn NoSanitizeList::containsPrefix(self: *NoSanitizeList, Mask: SanitizerMask, Prefix: str, Name: str, Category: str) -> bool {
    let mut NoSan: pair<unsigned int, unsigned int> = operator(self.SSCL).inSectionBlame(Mask, Prefix, Name, Category);
    if NoSan(NotFound) {
        return false;
    }
    let mut San: pair<unsigned int, unsigned int> = operator(self.SSCL).inSectionBlame(Mask, Prefix, Name, "sanitize");
    return San(NotFound) || NoSan(San);
}

fn NoSanitizeList::containsGlobal(self: *NoSanitizeList, Mask: SanitizerMask, GlobalName: str, Category: str) -> bool {
    return self.containsPrefix(Mask, "global", GlobalName, Category);
}

fn NoSanitizeList::containsType(self: *NoSanitizeList, Mask: SanitizerMask, MangledTypeName: str, Category: str) -> bool {
    return self.containsPrefix(Mask, "type", MangledTypeName, Category);
}

fn NoSanitizeList::containsFunction(self: *NoSanitizeList, Mask: SanitizerMask, FunctionName: str) -> bool {
    return self.containsPrefix(Mask, "fun", FunctionName, "");
}

fn NoSanitizeList::containsFile(self: *NoSanitizeList, Mask: SanitizerMask, FileName: str, Category: str) -> bool {
    return self.containsPrefix(Mask, "src", FileName, Category);
}

fn NoSanitizeList::containsMainFile(self: *NoSanitizeList, Mask: SanitizerMask, FileName: str, Category: str) -> bool {
    return self.containsPrefix(Mask, "mainfile", FileName, Category);
}

fn NoSanitizeList::containsLocation(self: *NoSanitizeList, Mask: SanitizerMask, Loc: SourceLocation, Category: str) -> bool {
    return Loc.isValid() && self.containsFile(Mask, self.SM.getFilename(self.SM.getFileLoc(Loc)), Category);
}
