const kPrivateModuleSuffix: str = "_Private";

fn ModuleMapCallbacks::anchor(self) {}

fn ModuleMap::resolveLinkAsDependencies(self, Mod: *mut Module) {
    let mut PendingLinkAs: iterator = self.PendingLinkAsModule.find(Mod.Name);
    if PendingLinkAs != self.PendingLinkAsModule.end() {
        for Name in operator(PendingLinkAs).second {
            let mut M: *mut Module = self.findModule(Name.getKey());
            if M {
                M.UseExportAsModuleLinkName = true;
            }
        }
    }
}

fn ModuleMap::addLinkAsDependency(self, Mod: *mut Module) {
    if self.findModule(Mod.ExportAsModule) {
        Mod.UseExportAsModuleLinkName = true;
    } else {
        self.PendingLinkAsModule[Mod.ExportAsModule].insert(Mod.Name);
    }
}

fn ModuleMap::headerRoleToKind(self, Role: ModuleHeaderRole) -> HeaderKind {
    match Role as i32 {
        NormalHeader => {
            return HK_Normal;
        },
        PrivateHeader => {
            return HK_Private;
        },
        TextualHeader => {
            return HK_Textual;
        },
        PrivateHeader | TextualHeader => {
            return HK_PrivateTextual;
        },
        ExcludedHeader => {
            return HK_Excluded;
        },
    }
    llvm_unreachable_internal("unknown header role", "P:/Goraw/llvm-project/clang/lib/Lex/ModuleMap.cpp", 84);
}

fn ModuleMap::headerKindToRole(self, Kind: HeaderKind) -> ModuleHeaderRole {
    match Kind as i32 {
        HK_Normal => {
            return NormalHeader;
        },
        HK_Private => {
            return PrivateHeader;
        },
        HK_Textual => {
            return TextualHeader;
        },
        HK_PrivateTextual => {
            return PrivateHeader | TextualHeader;
        },
        HK_Excluded => {
            return ExcludedHeader;
        },
    }
    llvm_unreachable_internal("unknown header kind", "P:/Goraw/llvm-project/clang/lib/Lex/ModuleMap.cpp", 101);
}

fn ModuleMap::isModular(self, Role: ModuleHeaderRole) -> bool {
    return !(Role & (TextualHeader | ExcludedHeader));
}

fn ModuleMap::resolveExport(self: *ModuleMap, Mod: *mut Module, Unresolved: *UnresolvedExportDecl, Complain: bool) -> ExportDecl {
    if Unresolved.Id.is_empty() {
        assert!(Unresolved.Wildcard, "Invalid unresolved export");
        return ExportDecl { null, true };
    }
    let mut Context: *mut Module = self.resolveModuleId(Unresolved.Id, Mod, Complain);
    if !Context {
        return ExportDecl {};
    }
    return ExportDecl { Context, Unresolved.Wildcard };
}

fn ModuleMap::resolveModuleId(self: *ModuleMap, Id: *ModuleId, Mod: *mut Module, Complain: bool) -> *mut Module {
    let mut Context: *mut Module = self.lookupModuleUnqualified(Id[0].first, Mod);
    if !Context {
        if Complain {
            self.Diags.Report(Id[0].second, err_mmap_missing_module_unqualified) << Id[0].first << Mod.getFullModuleName(false);
        }
        return null;
    }
    for let mut I: u32 = 1;
let mut N: u32 = Id.len; I != N; I += 1 {
        let mut Sub: *mut Module = self.lookupModuleQualified(Id[I].first, Context).operator clang::Module *();
        if !Sub {
            if Complain {
                self.Diags.Report(Id[I].second, err_mmap_missing_module_qualified) << Id[I].first << Context.getFullModuleName(false) << SourceRange { B: Id[0].second, E: Id[I - 1].second };
            }
            return null;
        }
        Context = Sub;
    }
    return Context;
}

fn appendSubframeworkPaths(Mod: *mut Module, Path: *mut SmallVectorImpl<char>) {
    let mut Paths: SmallVector<StringRef, 2> = SmallVector<StringRef, 2> {};
    for ; Mod; Mod = Mod.Parent {
        if Mod.IsFramework {
            Paths.push(Mod.Name);
        }
    }
    if Paths.is_empty() {
        return;
    }
    for Framework in drop_begin(reverse(Paths), 1) {
        append(Path, "Frameworks", Framework + ".framework", "", "");
    }
}

fn ModuleMap::findHeader(self, M: *mut Module, Header: *UnresolvedHeaderDirective, RelativePathName: *mut SmallVectorImpl<char>, NeedsFramework: *mut bool) -> OptionalFileEntryRef {
    let mut GetFile: Closure_1 = Closure_1 { cap_0: self, Header: &mut Header };
    if is_absolute(Header.FileName, native) {
        RelativePathName.clear();
        RelativePathName.append(Header.FileName.begin(), Header.FileName.end());
        return GetFile.call(Header.FileName);
    }
    let mut Directory: OptionalDirectoryEntryRef = M.Directory;
    if !Directory {
        return nullopt;
    }
    let mut FullPathName: str = operator(Directory).getName();
    let mut GetFrameworkFile: Closure_2 = Closure_2 { FullPathName: &mut FullPathName, M: &mut M, RelativePathName: &mut RelativePathName, Header: &mut Header, GetFile: &mut GetFile };
    if M.isPartOfFramework() {
        return GetFrameworkFile.call();
    }
    append(RelativePathName, Header.FileName, "", "", "");
    append(FullPathName, RelativePathName, "", "", "");
    let mut NormalHdrFile: OptionalFileEntryRef = GetFile.call(FullPathName.operator StringRef());
    if !NormalHdrFile && operator(Directory).getName().ends_with(".framework") {
        FullPathName.assign(operator(Directory).getName());
        RelativePathName.clear();
        if GetFrameworkFile.call() {
            self.Diags.Report(Header.FileNameLoc, warn_mmap_incomplete_framework_module_declaration) << Header.FileName << M.getFullModuleName(false);
            NeedsFramework = true;
        }
        return nullopt;
    }
    return NormalHdrFile;
}

fn isBuiltinHeaderName(FileName: str) -> bool {
    return FileName.Case("float.h", true).Case("iso646.h", true).Case("limits.h", true).Case("stdalign.h", true).Case("stdarg.h", true).Case("stdatomic.h", true).Case("stdbool.h", true).Case("stdckdint.h", true).Case("stdcountof.h", true).Case("stddef.h", true).Case("stdint.h", true).Case("tgmath.h", true).Case("unwind.h", true).Default(false);
}

fn isBuiltInModuleName(ModuleName: str) -> bool {
    return ModuleName.Case("_Builtin_float", true).Case("_Builtin_inttypes", true).Case("_Builtin_iso646", true).Case("_Builtin_limits", true).Case("_Builtin_stdalign", true).Case("_Builtin_stdarg", true).Case("_Builtin_stdatomic", true).Case("_Builtin_stdbool", true).Case("_Builtin_stddef", true).Case("_Builtin_stdint", true).Case("_Builtin_stdnoreturn", true).Case("_Builtin_tgmath", true).Case("_Builtin_unwind", true).Default(false);
}

fn ModuleMap::resolveHeader(self, Mod: *mut Module, Header: *UnresolvedHeaderDirective, NeedsFramework: *mut bool) {
    let mut RelativePathName: str = "";
    if self.findHeader(Mod, Header, RelativePathName, NeedsFramework) {
        File;
    } else {
        if Header.IsUmbrella {
            let mut UmbrellaDir: *DirectoryEntry = &mut operator(File).getDir().getDirEntry();
            if self.UmbrellaDirs[UmbrellaDir] {
                UmbrellaMod;
            } else {
                self.Diags.Report(Header.FileNameLoc, err_mmap_umbrella_clash) << UmbrellaMod.getFullModuleName(false);
            }
        } else {
            let mut H: Header = Header { Flags: Header.FileName, SizeInBytes: RelativePathName.operator basic_string(), Count: operator(File) };
            self.addHeader(Mod, H, headerKindToRole(Header.Kind), false, Header.FileNameLoc);
        }
    }
}

fn ModuleMap::resolveAsBuiltinHeader(self, Mod: *mut Module, Header: *UnresolvedHeaderDirective) -> bool {
    if Header.Kind == HK_Excluded || is_absolute(Header.FileName, native) || Mod.isPartOfFramework() || !Mod.IsSystem || Header.IsUmbrella || !self.BuiltinIncludeDir || self.BuiltinIncludeDir == Mod.Directory || !self.LangOpts.BuiltinHeadersInSystemModules || !isBuiltinHeaderName(Header.FileName) {
        return false;
    }
    let mut Path: str = "";
    append(Path, operator(self.BuiltinIncludeDir).getName(), Header.FileName, "", "");
    let mut File: OptionalFileEntryRef = self.SourceMgr.getFileManager().getOptionalFileRef(Path.operator StringRef(), false, true, true);
    if !File {
        return false;
    }
    let mut H: Header = Header { Flags: Header.FileName, SizeInBytes: Header.FileName, Count: operator(File) };
    let mut Role: ModuleHeaderRole = headerKindToRole(Header.Kind);
    self.addHeader(Mod, H, Role, false, SourceLocation {});
    return true;
}

fn ModuleMap::~ModuleMap(self) {}

fn ModuleMap::setTarget(self, Target: *TargetInfo) {
    assert!((!self.Target || self.Target == &mut Target), "Improper target override");
    self.Target = &mut Target;
}

