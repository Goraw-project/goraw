fn sanitizeFilenameAsIdentifier(Name: str, Buffer: *mut SmallVectorImpl<char>) -> str {
    if Name.is_empty() {
        return Name;
    }
    if !isValidAsciiIdentifier(Name, false) {
        Buffer()();
        if isDigit(Name[0]) {
            Buffer()('_');
        }
        Buffer()(Buffer()() + Name.len);
        for let mut I: u32 = 0;
let mut N: u32 = Name.len; I != N; I += 1 {
            if isAsciiIdentifierContinue(Name[I]) {
                Buffer()(Name[I]);
            } else {
                Buffer()('_');
            }
        }
        Name = Buffer()();
    }
    while  {
        if Name.ptr != Buffer()() {
            Buffer()(Name.begin(), Name.end());
        }
        Buffer()('_');
        Name = Buffer()();
    }
    return Name;
}

