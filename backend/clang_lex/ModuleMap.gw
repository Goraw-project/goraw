fn ModuleMap::isBuiltinHeader(self, File: FileEntryRef) -> bool {
    return File.getDir() == self.BuiltinIncludeDir && self.LangOpts.BuiltinHeadersInSystemModules && isBuiltinHeaderName(filename(File.getName(), native));
}

fn ModuleMap::shouldImportRelativeToBuiltinIncludeDir(self: *ModuleMap, FileName: str, Module: *mut Module) -> bool {
    return self.LangOpts.BuiltinHeadersInSystemModules && self.BuiltinIncludeDir && Module.IsSystem && !Module.isPartOfFramework() && isBuiltinHeaderName(FileName);
}

fn ModuleMap::findKnownHeader(self, File: FileEntryRef) -> iterator {
    self.resolveHeaderDirectives(File.operator const clang::FileEntry *());
    let mut Known: iterator = self.Headers.find(File);
    if self.HeaderInfo.getHeaderSearchOpts().ImplicitModuleMaps && Known == self.Headers.end() && self.isBuiltinHeader(File) {
        self.HeaderInfo.loadTopLevelSystemModules();
        return self.Headers.find(File);
    }
    return Known;
}

fn ModuleMap::findHeaderInUmbrellaDirs(self, File: FileEntryRef, IntermediateDirs: *mut SmallVectorImpl<DirectoryEntryRef>) -> KnownHeader {
    if self.UmbrellaDirs.is_empty() {
        return KnownHeader {};
    }
    let mut Dir: OptionalDirectoryEntryRef = File.getDir();
    let mut DirName: str = self.SourceMgr.getFileManager().getCanonicalName(operator(Dir));
    while true {
        {
        let mut KnownDir: iterator = self.UmbrellaDirs.find(operator(Dir).operator const clang::DirectoryEntry *());
        if KnownDir != self.UmbrellaDirs.end() {
            return KnownHeader { operator(KnownDir).second, NormalHeader };
        }
        IntermediateDirs.push(operator(Dir));
        DirName = parent_path(DirName, native);
        if DirName.is_empty() {
            break;
        }
        Dir = self.SourceMgr.getFileManager().getOptionalDirectoryRef(DirName, true);
    }
        if !(Dir) { break; }
    }
    return KnownHeader {};
}

fn violatesPrivateInclude(RequestingModule: *mut Module, IncFileEnt: *FileEntry, Header: KnownHeader) -> bool {
    if Header.getRole() & PrivateHeader {
        let mut IsPrivate: bool = false;
        let mut HeaderList: [2]Header> = [Header.getModule().getHeaders(HK_Private), Header.getModule().getHeaders(HK_PrivateTextual)];
        for Hs in HeaderList[..] {
            IsPrivate |= any_of(Hs, Closure_3 { IncFileEnt: &mut IncFileEnt });
        }
        assert!(IsPrivate, "inconsistent headers and roles");
    }
    return !Header.isAccessibleFrom(RequestingModule);
}

fn getTopLevelOrNull(M: *mut Module) -> *mut Module {
    return if M { M.getTopLevelModule() } else { null };
}

fn ModuleMap::diagnoseHeaderInclusion(self, RequestingModule: *mut Module, RequestingModuleIsModuleInterface: bool, FilenameLoc: SourceLocation, Filename: str, File: FileEntryRef) {
    if RequestingModule {
        self.resolveUses(RequestingModule, false);
        self.resolveHeaderDirectives(RequestingModule, nullopt);
    }
    let mut Known: iterator = self.findKnownHeader(File);
    self.diagnoseDuplicateHeaderOwnership(FilenameLoc, Filename, File, Known);
    let mut TopLevelRequestingModule: *mut Module = getTopLevelOrNull(RequestingModule);
    let mut TopLevelSourceModule: *mut Module = getTopLevelOrNull(self.SourceModule);
    let mut IsPublicForMainPrivateModule: bool = false;
    if TopLevelRequestingModule != TopLevelSourceModule {
        if TopLevelRequestingModule && TopLevelSourceModule && TopLevelSourceModule.Name.ends_with(kPrivateModuleSuffix) && TopLevelSourceModule.Name.drop_back(kPrivateModuleSuffix.len) == TopLevelRequestingModule.Name {
            IsPublicForMainPrivateModule = true;
        } else {
            return;
        }
    }
    let mut Excluded: bool = false;
    let mut UsedByPrivateModule: bool = false;
    let mut Private: *mut Module = null;
    let mut NotUsed: *mut Module = null;
    if Known != self.Headers.end() {
        for Header in operator(Known).second {
            if Header.getRole() == ExcludedHeader {
                Excluded = true;
                continue;
            }
            if violatesPrivateInclude(RequestingModule, File.operator const clang::FileEntry *(), Header) {
                Private = Header.getModule();
                continue;
            }
            if RequestingModule && self.LangOpts.ModulesDeclUse && !RequestingModule.directlyUses(Header.getModule()) {
                NotUsed = Header.getModule();
                if IsPublicForMainPrivateModule {
                    UsedByPrivateModule = self.SourceModule.directlyUses(Header.getModule());
                }
                continue;
            }
            return;
        }
        Excluded = true;
    }
    if Private {
        self.Diags.Report(FilenameLoc, warn_use_of_private_header_outside_module) << Filename;
        return;
    }
    if NotUsed {
        if UsedByPrivateModule {
            self.Diags.Report(FilenameLoc, err_undeclared_use_of_module_private) << RequestingModule.getTopLevelModule().Name << Filename << NotUsed.Name;
        } else {
            self.Diags.Report(FilenameLoc, err_undeclared_use_of_module_indirect) << RequestingModule.getTopLevelModule().Name << Filename << NotUsed.Name;
        }
        return;
    }
    if Excluded || self.isHeaderInUmbrellaDirs(File) {
        return;
    }
    if RequestingModule && self.LangOpts.ModulesStrictDeclUse {
        self.Diags.Report(FilenameLoc, err_undeclared_use_of_module) << RequestingModule.getTopLevelModule().Name << Filename;
    } else if RequestingModule && RequestingModuleIsModuleInterface && self.LangOpts.isCompilingModule() {
        let mut DiagID: kind = if RequestingModule.getTopLevelModule().IsFramework { warn_non_modular_include_in_framework_module } else { warn_non_modular_include_in_module };
        self.Diags.Report(FilenameLoc, DiagID) << RequestingModule.getFullModuleName(false) << File.getName();
    }
}

fn ModuleMap::diagnoseDuplicateHeaderOwnership(self, FilenameLoc: SourceLocation, Filename: str, File: FileEntryRef, Known: iterator) {
    if Known == self.Headers.end() {
        return;
    }
    if self.Diags.isIgnored(warn_mmap_duplicate_header_ownership, FilenameLoc) {
        return;
    }
    if !self.DiagnosedDuplicateHeaders.insert(&mut File.getFileEntry()).second {
        return;
    }
    let mut OwningModules: SmallVector<OwnerInfo, 2> = SmallVector<OwnerInfo, 2> {};
    let mut SeenTopLevel: SmallPtrSet<Module *, 2> = SmallPtrSet<Module *, 2> {};
    for H in operator(Known).second {
        if !isModular(H.getRole()) {
            continue;
        }
        let mut TopLevel: *mut Module = H.getModule().getTopLevelModule();
        if !SeenTopLevel.insert(TopLevel).second {
            continue;
        }
        let mut It: iterator = self.HeaderOwnerLocs.find(Module *> { &mut File.getFileEntry(), H.getModule() });
        let mut OwnerLoc: SourceLocation = if It != self.HeaderOwnerLocs.end() { operator(It).second } else { SourceLocation {} };
        OwningModules.push(ValueParamT { TopLevel, OwnerLoc, false });
    }
    if OwningModules.is_empty() {
        return;
    }
    let mut IntermediateDirs: SmallVector<DirectoryEntryRef, 2> = SmallVector<DirectoryEntryRef, 2> {};
    if self.findHeaderInUmbrellaDirs(File, IntermediateDirs) {
        UmbrellaOwner;
    } else {
        let mut TopLevel: *mut Module = UmbrellaOwner.getModule().getTopLevelModule();
        if SeenTopLevel.insert(TopLevel).second {
            let mut IsExcluded: bool = any_of(operator(Known).second, Closure_4 { TopLevel: TopLevel });
            if !IsExcluded {
                OwningModules.push(ValueParamT { TopLevel, UmbrellaOwner.getModule().UmbrellaDeclLoc, true });
            }
        }
    }
    if OwningModules.len < 2 {
        return;
    }
    self.Diags.Report(FilenameLoc, warn_mmap_duplicate_header_ownership) << Filename;
    for Owner in OwningModules {
        let mut NoteID: u32 = if Owner.IsUmbrella { note_mmap_header_covered_by_umbrella } else { note_mmap_header_owned_by };
        self.Diags.Report(Owner.Loc, NoteID) << Owner.Mod.getFullModuleName(false);
    }
}

fn isBetterKnownHeader(New: *KnownHeader, Old: *KnownHeader) -> bool {
    if New.getModule().isAvailable() && !Old.getModule().isAvailable() {
        return true;
    }
    if (New.getRole() & PrivateHeader) != (Old.getRole() & PrivateHeader) {
        return !(New.getRole() & PrivateHeader);
    }
    if (New.getRole() & TextualHeader) != (Old.getRole() & TextualHeader) {
        return !(New.getRole() & TextualHeader);
    }
    if (New.getRole() == ExcludedHeader) != (Old.getRole() == ExcludedHeader) {
        return New.getRole() != ExcludedHeader;
    }
    return false;
}

fn ModuleMap::findModuleForHeader(self, File: FileEntryRef, AllowTextual: bool, AllowExcluded: bool) -> KnownHeader {
    let mut MakeResult: Closure_5 = Closure_5 { AllowTextual: &mut AllowTextual };
    let mut Known: iterator = self.findKnownHeader(File);
    if Known != self.Headers.end() {
        let mut Result: KnownHeader = KnownHeader {};
        for H in operator(Known).second {
            if !AllowExcluded && H.getRole() == ExcludedHeader {
                continue;
            }
            if H.getModule().getTopLevelModule() == self.SourceModule {
                return MakeResult.call(H);
            }
            if !Result || isBetterKnownHeader(H, Result) {
                Result = H;
            }
        }
        return MakeResult.call(Result);
    }
    return MakeResult.call(self.findOrCreateModuleForHeaderInUmbrellaDir(File));
}

fn ModuleMap::findUmbrellaHeaderForModule(self, M: *mut Module, NameAsWritten: str, RelativePathName: *mut SmallVectorImpl<char>) -> OptionalFileEntryRef {
    let mut Header: UnresolvedHeaderDirective = UnresolvedHeaderDirective {};
    Header.FileName = move(NameAsWritten);
    Header.IsUmbrella = true;
    let mut NeedsFramework: bool = false;
    return self.findHeader(M, Header, RelativePathName, NeedsFramework);
}

fn ModuleMap::findOrCreateModuleForHeaderInUmbrellaDir(self, File: FileEntryRef) -> KnownHeader {
    assert!(!self.Headers.count(File), "already have a module for this header");
    let mut SkippedDirs: SmallVector<DirectoryEntryRef, 2> = SmallVector<DirectoryEntryRef, 2> {};
    let mut H: KnownHeader = self.findHeaderInUmbrellaDirs(File, SkippedDirs);
    if H {
        let mut Result: *mut Module = H.getModule();
        let mut UmbrellaModule: *mut Module = Result;
        while !UmbrellaModule.getEffectiveUmbrellaDir() && UmbrellaModule.Parent {
            UmbrellaModule = UmbrellaModule.Parent;
        }
        if UmbrellaModule.InferSubmodules {
            let mut UmbrellaModuleMap: FileID = self.getModuleMapFileIDForUniquing(UmbrellaModule);
            let mut Explicit: bool = UmbrellaModule.InferExplicitSubmodules;
            for SkippedDir in reverse(SkippedDirs) {
                let mut NameBuf: str = "";
                let mut Name: str = sanitizeFilenameAsIdentifier(stem(SkippedDir.getName(), native), NameBuf);
                Result = self.findOrCreateModuleFirst(Name, Result, false, Explicit);
                self.setInferredModuleAllowedBy(Result, UmbrellaModuleMap);
                self.UmbrellaDirs[SkippedDir.operator const clang::DirectoryEntry *()] = Result;
                if UmbrellaModule.InferExportWildcard && Result.Exports.is_empty() {
                    Result.Exports.push(ExportDecl { null, true });
                }
            }
            let mut NameBuf: str = "";
            let mut Name: str = sanitizeFilenameAsIdentifier(stem(File.getName(), native), NameBuf);
            Result = self.findOrCreateModuleFirst(Name, Result, false, Explicit);
            self.setInferredModuleAllowedBy(Result, UmbrellaModuleMap);
            Result.addTopHeader(File);
            if UmbrellaModule.InferExportWildcard && Result.Exports.is_empty() {
                Result.Exports.push(ExportDecl { null, true });
            }
        } else {
            for let mut I: u32 = 0;
let mut N: u32 = SkippedDirs.len; I != N; I += 1 {
                self.UmbrellaDirs[SkippedDirs[I].operator const clang::DirectoryEntry *()] = Result;
            }
        }
        let mut Header: KnownHeader = KnownHeader { Result, NormalHeader };
        self.Headers[File].push(Header);
        return Header;
    }
    return KnownHeader {};
}

fn ModuleMap::findAllModulesForHeader(self, File: FileEntryRef) -> KnownHeader> {
    let mut Known: iterator = self.findKnownHeader(File);
    if Known != self.Headers.end() {
        return operator(Known).second;
    }
    if self.findOrCreateModuleForHeaderInUmbrellaDir(File) {
        return operator(self.Headers.find(File)).second;
    }
    return KnownHeader> {};
}

fn ModuleMap::findResolvedModulesForHeader(self: *ModuleMap, File: FileEntryRef) -> KnownHeader> {
    self.resolveHeaderDirectives(File.operator const clang::FileEntry *());
    let mut It: const_iterator = self.Headers.find(File);
    if It == self.Headers.end() {
        return KnownHeader> {};
    }
    return operator(It).second;
}

fn ModuleMap::isHeaderInUnavailableModule(self: *ModuleMap, Header: FileEntryRef) -> bool {
    return self.isHeaderUnavailableInModule(Header, null);
}

fn ModuleMap::isHeaderUnavailableInModule(self: *ModuleMap, Header: FileEntryRef, RequestingModule: *Module) -> bool {
    self.resolveHeaderDirectives(Header.operator const clang::FileEntry *());
    let mut Known: const_iterator = self.Headers.find(Header);
    if Known != self.Headers.end() {
        for let mut I: const_iterator = operator(Known).second.begin();
let mut E: const_iterator = operator(Known).second.end(); I != E; I += 1 {
            if I.getRole() == ExcludedHeader {
                continue;
            }
            if I.isAvailable() && (!RequestingModule || I.getModule().isSubModuleOf(RequestingModule)) {
                if !RequestingModule && I.getRole() == TextualHeader {
                    continue;
                }
                return false;
            }
        }
        return true;
    }
    let mut Dir: OptionalDirectoryEntryRef = Header.getDir();
    let mut SkippedDirs: SmallVector<DirectoryEntryRef, 2> = SmallVector<DirectoryEntryRef, 2> {};
    let mut DirName: str = operator(Dir).getName();
    let mut IsUnavailable: Closure_6 = Closure_6 { RequestingModule: &mut RequestingModule };
    while true {
        {
        let mut KnownDir: const_iterator = self.UmbrellaDirs.find(operator(Dir).operator const clang::DirectoryEntry *());
        if KnownDir != self.UmbrellaDirs.end() {
            let mut Found: *mut Module = operator(KnownDir).second;
            if IsUnavailable.call(Found) {
                return true;
            }
            let mut UmbrellaModule: *mut Module = Found;
            while !UmbrellaModule.getEffectiveUmbrellaDir() && UmbrellaModule.Parent {
                UmbrellaModule = UmbrellaModule.Parent;
            }
            if UmbrellaModule.InferSubmodules {
                for SkippedDir in reverse(SkippedDirs) {
                    let mut NameBuf: str = "";
                    let mut Name: str = sanitizeFilenameAsIdentifier(stem(SkippedDir.getName(), native), NameBuf);
                    Found = self.lookupModuleQualified(Name, Found).operator clang::Module *();
                    if !Found {
                        return false;
                    }
                    if IsUnavailable.call(Found) {
                        return true;
                    }
                }
                let mut NameBuf: str = "";
                let mut Name: str = sanitizeFilenameAsIdentifier(stem(Header.getName(), native), NameBuf);
                Found = self.lookupModuleQualified(Name, Found).operator clang::Module *();
                if !Found {
                    return false;
                }
            }
            return IsUnavailable.call(Found);
        }
        SkippedDirs.push(operator(Dir));
        DirName = parent_path(DirName, native);
        if DirName.is_empty() {
            break;
        }
        Dir = self.SourceMgr.getFileManager().getOptionalDirectoryRef(DirName, true);
    }
        if !(Dir) { break; }
    }
    return false;
}

fn ModuleMap::findModule(self: *ModuleMap, Name: str) -> *mut Module {
    let mut Known: const_iterator = self.Modules.find(Name);
    if Known != self.Modules.end() {
        return operator(Known).getValue();
    }
    return null;
}

fn ModuleMap::findOrInferSubmodule(self, Parent: *mut Module, Name: str) -> *mut Module {
    if Parent.findSubmodule(Name).operator clang::Module *() {
        SubM;
    } else {
        return SubM;
    }
    if !Parent.InferSubmodules {
        return null;
    }
    let mut Result: *mut Module = Module { ModuleConstructorTag {}, Name, SourceLocation {}, Parent, false, Parent.InferExplicitSubmodules, 0 };
    Result.InferExplicitSubmodules = Parent.InferExplicitSubmodules;
    Result.InferSubmodules = Parent.InferSubmodules;
    Result.InferExportWildcard = Parent.InferExportWildcard;
    if Result.InferExportWildcard {
        Result.Exports.push(ExportDecl { null, true });
    }
    return Result;
}

fn ModuleMap::lookupModuleUnqualified(self: *ModuleMap, Name: str, Context: *mut Module) -> *mut Module {
    for ; Context; Context = Context.Parent {
        if self.lookupModuleQualified(Name, Context).operator clang::Module *() {
            Sub;
        } else {
            return Sub;
        }
    }
    return self.findModule(Name);
}

fn ModuleMap::lookupModuleQualified(self: *ModuleMap, Name: str, Context: *mut Module) -> ModuleRef {
    if !Context {
        return self.findModule(Name);
    }
    return Context.findSubmodule(Name);
}

fn ModuleMap::findOrCreateModule(self, Name: str, Parent: *mut Module, IsFramework: bool, IsExplicit: bool) -> pair<Module *, bool> {
    let mut Sub: ModuleRef = self.lookupModuleQualified(Name, Parent);
    if Sub.getExisting() {
        return make_pair(Sub.getExisting(), false);
    }
    let mut M: *mut Module = self.createModule(Name, Parent, IsFramework, IsExplicit);
    return make_pair(M, true);
}

fn ModuleMap::createModule(self, Name: str, Parent: *mut Module, IsFramework: bool, IsExplicit: bool) -> *mut Module {
    assert!(!self.lookupModuleQualified(Name, Parent).getExisting(), "Creating duplicate submodule");
    let mut Result: *mut Module = Module { ModuleConstructorTag {}, Name, SourceLocation {}, Parent, IsFramework, IsExplicit, self.NumCreatedModules += 1 };
    if !Parent {
        if self.LangOpts.CurrentModule == Name {
            self.SourceModule = Result;
        }
        self.Modules[Name] = Result;
        self.ModuleScopeIDs[Result] = self.CurrentModuleScopeID;
    }
    return Result;
}

fn ModuleMap::createGlobalModuleFragmentForModuleUnit(self, Loc: SourceLocation, Parent: *mut Module) -> *mut Module {
    let mut Result: *mut Module = Module { ModuleConstructorTag {}, "<global>", Loc, Parent, false, true, self.NumCreatedModules += 1 };
    Result.Kind = ExplicitGlobalModuleFragment;
    if !Result.Parent {
        self.PendingSubmodules.push(Result);
    }
    return Result;
}

fn ModuleMap::createImplicitGlobalModuleFragmentForModuleUnit(self, Loc: SourceLocation, Parent: *mut Module) -> *mut Module {
    assert!(Parent, "We should only create an implicit global module fragment in a module purview");
    let mut Result: *mut Module = Module { ModuleConstructorTag {}, "<implicit global>", Loc, Parent, false, false, self.NumCreatedModules += 1 };
    Result.Kind = ImplicitGlobalModuleFragment;
    return Result;
}

fn ModuleMap::createPrivateModuleFragmentForInterfaceUnit(self, Parent: *mut Module, Loc: SourceLocation) -> *mut Module {
    let mut Result: *mut Module = Module { ModuleConstructorTag {}, "<private>", Loc, Parent, false, true, self.NumCreatedModules += 1 };
    Result.Kind = PrivateModuleFragment;
    return Result;
}

fn ModuleMap::createModuleUnitWithKind(self, Loc: SourceLocation, Name: str, Kind: ModuleKind) -> *mut Module {
    let mut Result: *mut Module = Module { ModuleConstructorTag {}, Name, Loc, null, false, false, self.NumCreatedModules += 1 };
    Result.Kind = Kind;
    for Submodule in self.PendingSubmodules {
        Submodule.setParent(Result);
    }
    self.PendingSubmodules.clear();
    return Result;
}

fn ModuleMap::createModuleForInterfaceUnit(self, Loc: SourceLocation, Name: str) -> *mut Module {
    assert!(self.LangOpts.CurrentModule == Name, "module name mismatch");
    assert!(!self.Modules[Name], "redefining existing module");
    let mut Result: *mut Module = self.createModuleUnitWithKind(Loc, Name, ModuleInterfaceUnit);
    self.Modules[Name] = self.SourceModule = Result;
    let mut MainFile: OptionalFileEntryRef = self.SourceMgr.getFileEntryRefForID(self.SourceMgr.getMainFileID());
    assert!(MainFile, "no input file for module interface");
    self.Headers[operator(MainFile)].push(KnownHeader { Result, PrivateHeader });
    return Result;
}

fn ModuleMap::createModuleForImplementationUnit(self, Loc: SourceLocation, Name: str) -> *mut Module {
    assert!(self.LangOpts.CurrentModule == Name, "module name mismatch");
    assert!(self.Modules[Name] && self.Modules[Name].Kind == ModuleInterfaceUnit, "creating implementation module without an interface");
    let mut IName: str = ".ImplementationUnit";
    assert!(!self.Modules[IName], "multiple implementation units?");
    let mut Result: *mut Module = self.createModuleUnitWithKind(Loc, Name, ModuleImplementationUnit);
    self.Modules[IName] = self.SourceModule = Result;
    assert!(self.SourceMgr.getFileEntryForID(self.SourceMgr.getMainFileID()), "no input file for module implementation");
    return Result;
}

fn ModuleMap::createHeaderUnit(self, Loc: SourceLocation, Name: str, H: Header) -> *mut Module {
    assert!(self.LangOpts.CurrentModule == Name, "module name mismatch");
    assert!(!self.Modules[Name], "redefining existing module");
    let mut Result: *mut Module = Module { ModuleConstructorTag {}, Name, Loc, null, false, false, self.NumCreatedModules += 1 };
    Result.Kind = ModuleHeaderUnit;
    self.Modules[Name] = self.SourceModule = Result;
    self.addHeader(Result, H, NormalHeader, false, SourceLocation {});
    return Result;
}

fn inferFrameworkLink(Mod: *mut Module) {
    assert!(Mod.IsFramework, "Can only infer linking for framework modules");
    assert!(!Mod.isSubFramework(), "Can only infer linking for top-level frameworks");
    let mut FrameworkName: str = Mod.Name;
    FrameworkName.consume_back("_Private");
    Mod.LinkLibraries.push(LinkLibrary { FrameworkName, true });
}

fn ModuleMap::inferFrameworkModule(self, FrameworkDir: DirectoryEntryRef, IsSystem: bool, Parent: *mut Module) -> *mut Module {
    let mut Attrs: Attributes = Attributes {};
    Attrs.IsSystem = IsSystem;
    return self.inferFrameworkModule(FrameworkDir, Attrs, Parent);
}

fn ModuleMap::inferFrameworkModule(self, FrameworkDir: DirectoryEntryRef, Attrs: Attributes, Parent: *mut Module) -> *mut Module {
    let mut FrameworkDirName: str = self.SourceMgr.getFileManager().getCanonicalName(FrameworkDir);
    let mut ModuleNameStorage: str = "";
    let mut ModuleName: str = sanitizeFilenameAsIdentifier(stem(FrameworkDirName, native), ModuleNameStorage);
    if self.lookupModuleQualified(ModuleName, Parent).operator clang::Module *() {
        Mod;
    } else {
        return Mod;
    }
    let mut FileMgr: *mut FileManager = self.SourceMgr.getFileManager();
    let mut ModuleMapFID: FileID = FileID {};
    if !Parent {
        let mut canInfer: bool = false;
        if has_parent_path(FrameworkDirName, native) {
            let mut Parent: str = parent_path(FrameworkDirName, native);
            if FileMgr.getOptionalDirectoryRef(Parent, true) {
                ParentDir;
            } else {
                let mut inferred: const_iterator = self.InferredDirectories.find(operator(ParentDir).operator const clang::DirectoryEntry *());
                if inferred == self.InferredDirectories.end() {
                    let mut IsFrameworkDir: bool = Parent.ends_with(".framework");
                    if self.HeaderInfo.lookupModuleMapFile(operator(ParentDir), IsFrameworkDir) {
                        ModMapFile;
                    } else {
                        self.parseAndLoadModuleMapFile(operator(ModMapFile), Attrs.IsSystem, true, operator(ParentDir), FileID {}, null, SourceLocation {});
                        inferred = self.InferredDirectories.find(operator(ParentDir).operator const clang::DirectoryEntry *());
                    }
                    if inferred == self.InferredDirectories.end() {
                        inferred = self.InferredDirectories.insert(make_pair(operator(ParentDir), InferredDirectory {})).first;
                    }
                }
                if operator(inferred).second.InferModules {
                    let mut Name: str = stem(FrameworkDirName, native);
                    canInfer = !is_contained(operator(inferred).second.ExcludedModules, Name);
                    Attrs.IsSystem |= operator(inferred).second.Attrs.IsSystem;
                    Attrs.IsExternC |= operator(inferred).second.Attrs.IsExternC;
                    Attrs.IsExhaustive |= operator(inferred).second.Attrs.IsExhaustive;
                    Attrs.NoUndeclaredIncludes |= operator(inferred).second.Attrs.NoUndeclaredIncludes;
                    ModuleMapFID = operator(inferred).second.ModuleMapFID;
                }
            }
        }
        if !canInfer {
            return null;
        }
    } else {
        ModuleMapFID = self.getModuleMapFileIDForUniquing(Parent);
    }
    let mut UmbrellaName: str = FrameworkDir.getName();
    append(UmbrellaName, "Headers", ModuleName + ".h", "", "");
    let mut UmbrellaHeader: OptionalFileEntryRef = FileMgr.getOptionalFileRef(UmbrellaName.operator StringRef(), false, true, true);
    if !UmbrellaHeader {
        return null;
    }
    let mut Result: *mut Module = Module { ModuleConstructorTag {}, ModuleName, SourceLocation {}, Parent, true, false, self.NumCreatedModules += 1 };
    self.setInferredModuleAllowedBy(Result, ModuleMapFID);
    if !Parent {
        if self.LangOpts.CurrentModule == ModuleName {
            self.SourceModule = Result;
        }
        self.Modules[ModuleName] = Result;
        self.ModuleScopeIDs[Result] = self.CurrentModuleScopeID;
    }
    Result.IsSystem |= Attrs.IsSystem;
    Result.IsExternC |= Attrs.IsExternC;
    Result.ConfigMacrosExhaustive |= Attrs.IsExhaustive;
    Result.NoUndeclaredIncludes |= Attrs.NoUndeclaredIncludes;
    Result.Directory = FrameworkDir;
    let mut RelativePath: str = UmbrellaName[operator(Result.getTopLevelModule().Directory).getName().len..operator(Result.getTopLevelModule().Directory).getName().len + npos];
    RelativePath = relative_path(RelativePath, native);
    self.setUmbrellaHeaderAsWritten(Result, operator(UmbrellaHeader), ModuleName + ".h", RelativePath, SourceLocation {});
    Result.Exports.push(ExportDecl { null, true });
    Result.InferSubmodules = true;
    Result.InferExportWildcard = true;
    let mut EC: error_code = error_code {};
    let mut SubframeworksDirName: str = FrameworkDir.getName();
    append(SubframeworksDirName, "Frameworks", "", "", "");
    native(SubframeworksDirName, native);
    let mut FS: *mut FileSystem = FileMgr.getVirtualFileSystem();
    for let mut Dir: directory_iterator = FS.dir_begin(SubframeworksDirName, EC);
let mut DirEnd: directory_iterator = directory_iterator {}; Dir != DirEnd && !EC; Dir.increment(EC) {
        if !operator(Dir).path().ends_with(".framework") {
            continue;
        }
        if FileMgr.getOptionalDirectoryRef(operator(Dir).path(), true) {
            SubframeworkDir;
        } else {
            let mut SubframeworkDirName: str = FileMgr.getCanonicalName(operator(SubframeworkDir));
            let mut FoundParent: bool = false;
            while true {
                {
                SubframeworkDirName = parent_path(SubframeworkDirName, native);
                if SubframeworkDirName.is_empty() {
                    break;
                }
                if FileMgr.getOptionalDirectoryRef(SubframeworkDirName, true) {
                    SubDir;
                } else {
                    if operator(SubDir).operator const clang::DirectoryEntry *() == FrameworkDir.operator const clang::DirectoryEntry *() {
                        FoundParent = true;
                        break;
                    }
                }
            }
                if !(true) { break; }
            }
            if !FoundParent {
                continue;
            }
            self.inferFrameworkModule(operator(SubframeworkDir), Attrs, Result);
        }
    }
    if !Result.isSubFramework() {
        inferFrameworkLink(Result);
    }
    return Result;
}

fn ModuleMap::createShadowedModule(self, Name: str, IsFramework: bool, ShadowingModule: *mut Module) -> *mut Module {
    let mut Result: *mut Module = Module { ModuleConstructorTag {}, Name, SourceLocation {}, null, IsFramework, false, self.NumCreatedModules += 1 };
    Result.ShadowingModule = ShadowingModule;
    Result.markUnavailable(true);
    self.ModuleScopeIDs[Result] = self.CurrentModuleScopeID;
    self.ShadowModules.push(Result);
    return Result;
}

fn ModuleMap::setUmbrellaHeaderAsWritten(self, Mod: *mut Module, UmbrellaHeader: FileEntryRef, NameAsWritten: str, PathRelativeToRootModuleDirectory: str, Loc: SourceLocation) {
    self.Headers[UmbrellaHeader].push(KnownHeader { Mod, NormalHeader });
    if Loc.isValid() {
        self.HeaderOwnerLocs[Module *> { &mut UmbrellaHeader.getFileEntry(), Mod }] = Loc;
    }
    Mod.Umbrella = UmbrellaHeader;
    Mod.UmbrellaDeclLoc = Loc;
    Mod.UmbrellaAsWritten = NameAsWritten;
    Mod.UmbrellaRelativeToRootModuleDirectory = PathRelativeToRootModuleDirectory;
    self.UmbrellaDirs[UmbrellaHeader.getDir().operator const clang::DirectoryEntry *()] = Mod;
    for Cb in self.Callbacks {
        operator(Cb).moduleMapAddUmbrellaHeader(UmbrellaHeader);
    }
}

fn ModuleMap::setUmbrellaDirAsWritten(self, Mod: *mut Module, UmbrellaDir: DirectoryEntryRef, NameAsWritten: str, PathRelativeToRootModuleDirectory: str, Loc: SourceLocation) {
    Mod.Umbrella = UmbrellaDir;
    Mod.UmbrellaDeclLoc = Loc;
    Mod.UmbrellaAsWritten = NameAsWritten;
    Mod.UmbrellaRelativeToRootModuleDirectory = PathRelativeToRootModuleDirectory;
    self.UmbrellaDirs[UmbrellaDir.operator const clang::DirectoryEntry *()] = Mod;
}

fn ModuleMap::addUnresolvedHeader(self, Mod: *mut Module, Header: UnresolvedHeaderDirective, NeedsFramework: *mut bool) {
    if self.resolveAsBuiltinHeader(Mod, Header) {
        Header.Kind = headerRoleToKind(headerKindToRole(Header.Kind) | TextualHeader);
        Header.HasBuiltinHeader = true;
    }
    if (Header.Size || Header.ModTime) && !Header.IsUmbrella && Header.Kind != HK_Excluded {
        if Header.ModTime {
            self.LazyHeadersByModTime[operator(Header.ModTime)].push(Mod);
        } else {
            self.LazyHeadersBySize[operator(Header.Size)].push(Mod);
        }
        Mod.UnresolvedHeaders.push(Header);
        return;
    }
    self.resolveHeader(Mod, Header, NeedsFramework);
}

fn ModuleMap::resolveHeaderDirectives(self: *ModuleMap, File: *FileEntry) {
    let mut BySize: iterator = self.LazyHeadersBySize.find(File.getSize());
    if BySize != self.LazyHeadersBySize.end() {
        for M in operator(BySize).second {
            self.resolveHeaderDirectives(M, File);
        }
        self.LazyHeadersBySize.erase(BySize);
    }
    let mut ByModTime: iterator = self.LazyHeadersByModTime.find(File.getModificationTime());
    if ByModTime != self.LazyHeadersByModTime.end() {
        for M in operator(ByModTime).second {
            self.resolveHeaderDirectives(M, File);
        }
        self.LazyHeadersByModTime.erase(ByModTime);
    }
}

fn ModuleMap::resolveHeaderDirectives(self: *ModuleMap, Mod: *mut Module, File: optional<const FileEntry *>) {
    let mut NeedsFramework: bool = false;
    let mut NewHeaders: UnresolvedHeaderDirective, 1> = UnresolvedHeaderDirective, 1> {};
    let mut Size: off_t = if File { (operator(File)).getSize() } else { 0 };
    let mut ModTime: time_t = if File { (operator(File)).getModificationTime() } else { 0 };
    for Header in Mod.UnresolvedHeaders {
        if File && ((Header.ModTime && Header.ModTime != ModTime) || (Header.Size && Header.Size != Size)) {
            NewHeaders.push(Header);
        } else {
            self.resolveHeader(Mod, Header, NeedsFramework);
        }
    }
    Mod.UnresolvedHeaders.swap(NewHeaders);
}

fn ModuleMap::addHeader(self, Mod: *mut Module, Header: Header, Role: ModuleHeaderRole, Imported: bool, Loc: SourceLocation) {
    let mut KH: KnownHeader = KnownHeader { Mod, Role };
    let mut HeaderEntry: FileEntryRef = Header.Entry;
    let mut HeaderList: *mut KnownHeader, 1> = self.Headers[HeaderEntry];
    if is_contained(HeaderList, KH) {
        return;
    }
    if Loc.isValid() {
        self.HeaderOwnerLocs[Module *> { &mut HeaderEntry.getFileEntry(), Mod }] = Loc;
    }
    HeaderList.push(KH);
    Mod.addHeader(headerRoleToKind(Role), move(Header));
    let mut isCompilingModuleHeader: bool = Mod.isForBuilding(self.LangOpts);
    if !Imported || isCompilingModuleHeader {
        self.HeaderInfo.MarkFileModuleHeader(HeaderEntry, Role, isCompilingModuleHeader);
    }
    for Cb in self.Callbacks {
        operator(Cb).moduleMapAddHeader(HeaderEntry.getName());
    }
}

fn ModuleMap::parseModuleMapFile(self, File: FileEntryRef, IsSystem: bool, ImplicitlyDiscovered: bool, Dir: DirectoryEntryRef, ID: FileID, ExternModuleLoc: SourceLocation) -> bool {
    let mut Known: iterator = self.ParsedModuleMap.find(File.operator const clang::FileEntry *());
    if Known != self.ParsedModuleMap.end() {
        return operator(Known).second == null;
    }
    if ID.isInvalid() {
        let mut LocalFID: *mut FileID = self.ModuleMapLocalFileID[File.operator const clang::FileEntry *()];
        if LocalFID.isInvalid() {
            let mut FileCharacter: CharacteristicKind = if IsSystem { C_System_ModuleMap } else { C_User_ModuleMap };
            LocalFID = self.SourceMgr.createFileID(File, ExternModuleLoc, FileCharacter, 0, 0);
        }
        ID = LocalFID;
    }
    let mut Buffer: MemoryBufferRef> = self.SourceMgr.getBufferOrNone(ID, SourceLocation {});
    if !Buffer {
        self.ParsedModuleMap[File.operator const clang::FileEntry *()] = null;
        return true;
    }
    self.Diags.Report(remark_mmap_parse) << File.getName();
    let mut MaybeMMF: ModuleMapFile> = parseModuleMap(ID, Dir, self.SourceMgr, self.Diags, IsSystem, ImplicitlyDiscovered, null);
    if !MaybeMMF {
        self.ParsedModuleMap[File.operator const clang::FileEntry *()] = null;
        return true;
    }
    self.ParsedModuleMaps.push(make_unique(move(operator(MaybeMMF))));
    let mut MMF: *ModuleMapFile = operator(self.ParsedModuleMaps.back());
    let mut PendingExternalModuleMaps: []*ExternModuleDecl = []*ExternModuleDecl {};
    let mut CollectExternDecls: ModuleDecl &)> = Closure_7 { CollectExternDecls: &mut CollectExternDecls, PendingExternalModuleMaps: &mut PendingExternalModuleMaps };
    for Decl in MMF.Decls {
        visit(makeVisitor(Closure_11 { cap_0: self, MMF: &mut MMF, CollectExternDecls: &mut CollectExternDecls }, Closure_12 { PendingExternalModuleMaps: &mut PendingExternalModuleMaps }), Decl);
    }
    for EMD in PendingExternalModuleMaps {
        let mut FileNameRef: str = EMD.Path;
        let mut ModuleMapFileName: str = "";
        if is_relative(FileNameRef, native) {
            operator(ModuleMapFileName, Dir.getName());
            append(ModuleMapFileName, EMD.Path, "", "", "");
            FileNameRef = ModuleMapFileName.operator StringRef();
        }
        if self.SourceMgr.getFileManager().getOptionalFileRef(FileNameRef, false, true, true) {
            EFile;
        } else {
            self.parseModuleMapFile(operator(EFile), IsSystem, ImplicitlyDiscovered, operator(EFile).getDir(), FileID {}, ExternModuleLoc);
        }
    }
    self.ParsedModuleMap[File.operator const clang::FileEntry *()] = &mut MMF;
    for Cb in self.Callbacks {
        operator(Cb).moduleMapFileRead(SourceLocation {}, File, IsSystem);
    }
    return false;
}

fn ModuleMap::loadAllParsedModules(self) {
    for Entry in self.ParsedModules {
        self.findOrLoadModule(Entry.first());
    }
}

fn ModuleMap::getContainingModuleMapFileID(self: *ModuleMap, Module: *Module) -> FileID {
    if Module.DefinitionLoc.isInvalid() {
        return FileID {};
    }
    return self.SourceMgr.getFileID(Module.DefinitionLoc);
}

fn ModuleMap::getContainingModuleMapFile(self: *ModuleMap, Module: *Module) -> OptionalFileEntryRef {
    return self.SourceMgr.getFileEntryRefForID(self.getContainingModuleMapFileID(Module));
}

fn ModuleMap::getModuleMapFileIDForUniquing(self: *ModuleMap, M: *Module) -> FileID {
    if M.IsInferred {
        assert!(self.InferredModuleAllowedBy.count(M), "missing inferred module map");
        return operator(self.InferredModuleAllowedBy.find(M)).second;
    }
    return self.getContainingModuleMapFileID(M);
}

fn ModuleMap::getModuleMapFileForUniquing(self: *ModuleMap, M: *Module) -> OptionalFileEntryRef {
    return self.SourceMgr.getFileEntryRefForID(self.getModuleMapFileIDForUniquing(M));
}

fn ModuleMap::setInferredModuleAllowedBy(self, M: *mut Module, ModMapFID: FileID) {
    M.IsInferred = true;
    self.InferredModuleAllowedBy[M] = ModMapFID;
}

fn ModuleMap::canonicalizeModuleMapPath(self, Path: *mut SmallVectorImpl<char>) -> error_code {
    let mut Dir: str = parent_path(Path.ptr[0..Path.len], native);
    if filename(Dir, native) == "Modules" {
        let mut Parent: str = parent_path(Dir, native);
        if Parent.ends_with(".framework") {
            Dir = Parent;
        }
    }
    let mut FM: *mut FileManager = self.SourceMgr.getFileManager();
    let mut DirEntry: Expected<DirectoryEntryRef> = FM.getDirectoryRef(if Dir.is_empty() { "." } else { Dir }, true);
    if !DirEntry {
        return errorToErrorCode(DirEntry.takeError());
    }
    let mut CanonicalDir: str = FM.getCanonicalName(operator(DirEntry));
    if CanonicalDir != Dir {
        replace_path_prefix(Path, Dir, CanonicalDir, native);
    }
    remove_dots(Path, false, native);
    return error_code {};
}

fn ModuleMap::addAdditionalModuleMapFile(self, M: *Module, ModuleMap: FileEntryRef) {
    self.AdditionalModMaps[M].insert(ModuleMap);
}

fn ModuleMap::dump(self) {
    errs() << "Modules:";
    for let mut M: iterator = self.Modules.begin();
let mut MEnd: iterator = self.Modules.end(); M != MEnd; operator(M) {
        operator(M).getValue().print(errs(), 2, false);
    }
    errs() << "Headers:";
    for let mut H: iterator = self.Headers.begin();
let mut HEnd: iterator = self.Headers.end(); H != HEnd; operator(H) {
        errs() << "  \"" << operator(H).first.getName() << "\" -> ";
        for let mut I: const_iterator = operator(H).second.begin();
let mut E: const_iterator = operator(H).second.end(); I != E; I += 1 {
            if I != operator(H).second.begin() {
                errs() << ",";
            }
            errs() << I.getModule().getFullModuleName(false);
        }
        errs() << "\n";
    }
}

fn ModuleMap::resolveExports(self, Mod: *mut Module, Complain: bool) -> bool {
    let mut Unresolved: UnresolvedExportDecl, 2> &> = move(Mod.UnresolvedExports);
    Mod.UnresolvedExports.clear();
    for UE in Unresolved {
        let mut Export: ExportDecl = self.resolveExport(Mod, UE, Complain);
        if Export.first || Export.second {
            Mod.Exports.push(Export);
        } else {
            Mod.UnresolvedExports.push(UE);
        }
    }
    return !Mod.UnresolvedExports.is_empty();
}

fn ModuleMap::resolveUses(self, Mod: *mut Module, Complain: bool) -> bool {
    let mut Top: *mut Module = Mod.getTopLevelModule();
    let mut Unresolved: SourceLocation>, 2>, 2> &> = move(Top.UnresolvedDirectUses);
    Top.UnresolvedDirectUses.clear();
    for UDU in Unresolved {
        let mut DirectUse: *mut Module = self.resolveModuleId(UDU, Top, Complain);
        if DirectUse {
            Top.DirectUses.push(DirectUse);
        } else {
            Top.UnresolvedDirectUses.push(UDU);
        }
    }
    return !Top.UnresolvedDirectUses.is_empty();
}

fn ModuleMap::resolveConflicts(self, Mod: *mut Module, Complain: bool) -> bool {
    let mut Unresolved: UnresolvedConflict>> &> = move(Mod.UnresolvedConflicts);
    Mod.UnresolvedConflicts.clear();
    for UC in Unresolved {
        if self.resolveModuleId(UC.Id, Mod, Complain) {
            OtherMod;
        } else {
            let mut Conflict: Conflict = Conflict {};
            Conflict.Other = OtherMod;
            Conflict.Message = UC.Message;
            Mod.Conflicts.push(Conflict);
        }
    }
    return !Mod.UnresolvedConflicts.is_empty();
}

struct ModuleMapLoader {
    SourceMgr: *mut SourceManager,
    Diags: *mut DiagnosticsEngine,
    Map: *mut ModuleMap,
    ModuleMapFID: FileID,
    CurrModuleDeclLoc: SourceLocation,
    Directory: DirectoryEntryRef,
    IsSystem: bool,
    ImplicitlyDiscovered: bool,
    HadError: bool,
    ActiveModule: *mut Module,
    UsesRequiresExcludedHack: SmallPtrSet<Module *, 2>,
}

fn ModuleMapLoader::diagnosePrivateModules(self, StartLoc: SourceLocation) {
    let mut GenNoteAndFixIt: Closure_13 = Closure_13 { cap_0: self };
    for let mut E: module_iterator = self.Map.module_begin(); E != self.Map.module_end(); operator(E) {
        let mut M: *Module = operator(E).getValue();
        if M.Directory != self.ActiveModule.Directory {
            continue;
        }
        let mut FullName: str = self.ActiveModule.getFullModuleName(false);
        if !FullName.starts_with(M.Name) && !FullName.ends_with("Private") {
            continue;
        }
        let mut FixedPrivModDecl: str = "";
        let mut Canonical: str = M.Name;
        Canonical.append("_Private");
        if self.ActiveModule.Parent && self.ActiveModule.Name == "Private" && !M.Parent && M.Name == self.ActiveModule.Parent.Name {
            self.Diags.Report(self.ActiveModule.DefinitionLoc, warn_mmap_mismatched_private_submodule) << FullName;
            let mut FixItInitBegin: SourceLocation = self.CurrModuleDeclLoc;
            if StartLoc.isValid() {
                FixItInitBegin = StartLoc;
            }
            if self.ActiveModule.Parent.IsFramework {
                FixedPrivModDecl.append("framework ");
            }
            FixedPrivModDecl.append("module ");
            FixedPrivModDecl.append(Canonical);
            GenNoteAndFixIt.call(FullName.operator StringRef(), FixedPrivModDecl.operator StringRef(), M, SourceRange { B: FixItInitBegin, E: self.ActiveModule.DefinitionLoc });
            continue;
        }
        if !self.ActiveModule.Parent && !M.Parent && !M.Name == self.ActiveModule.Name && self.ActiveModule.Name != Canonical.operator StringRef() {
            self.Diags.Report(self.ActiveModule.DefinitionLoc, warn_mmap_mismatched_private_module_name) << self.ActiveModule.Name;
            GenNoteAndFixIt.call(self.ActiveModule.Name, Canonical.operator StringRef(), M, self.ActiveModule.DefinitionLoc);
        }
    }
}

fn ModuleMapLoader::handleModuleDecl(self, MD: *ModuleDecl) {
    if MD.Id.front().first == "*" {
        return self.handleInferredModuleDecl(MD);
    }
    self.CurrModuleDeclLoc = MD.Location;
    let mut PreviousActiveModule: *mut Module = self.ActiveModule;
    if MD.Id.len > 1 {
        self.ActiveModule = null;
        let mut TopLevelModule: *Module = null;
        for let mut I: u32 = 0;
let mut N: u32 = MD.Id.len - 1; I != N; I += 1 {
            if self.Map.lookupModuleQualified(MD.Id[I].first, self.ActiveModule).operator clang::Module *() {
                Next;
            } else {
                if I == 0 {
                    TopLevelModule = Next;
                }
                self.ActiveModule = Next;
                continue;
            }
            self.Diags.Report(MD.Id[I].second, err_mmap_missing_parent_module) << MD.Id[I].first << (self.ActiveModule != null) << (if self.ActiveModule { self.ActiveModule.getTopLevelModule().getFullModuleName(false) } else { "" });
            self.HadError = true;
        }
        if TopLevelModule && self.ModuleMapFID != self.Map.getContainingModuleMapFileID(TopLevelModule) {
            assert!(self.ModuleMapFID != self.Map.getModuleMapFileIDForUniquing(TopLevelModule), "submodule defined in same file as 'module *' that allowed its top-level module");
            self.Map.addAdditionalModuleMapFile(TopLevelModule, operator(self.SourceMgr.getFileEntryRefForID(self.ModuleMapFID)));
        }
    }
    let mut ModuleName: str = MD.Id.back().first;
    let mut ModuleNameLoc: SourceLocation = MD.Id.back().second;
    let mut ShadowingModule: *mut Module = null;
    if self.Map.lookupModuleQualified(ModuleName, self.ActiveModule).operator clang::Module *() {
        Existing;
    } else {
        let mut LoadedFromASTFile: bool = Existing.IsFromModuleFile;
        if LoadedFromASTFile {
            let mut ExistingModMapFile: OptionalFileEntryRef = self.Map.getContainingModuleMapFile(Existing);
            let mut CurrentModMapFile: OptionalFileEntryRef = self.SourceMgr.getFileEntryRefForID(self.ModuleMapFID);
            if (ExistingModMapFile && CurrentModMapFile && operator(ExistingModMapFile) == operator(CurrentModMapFile)) || Existing.DefinitionLoc.isInvalid() {
                LoadedFromASTFile = true;
            } else {
                LoadedFromASTFile = false;
            }
        }
        let mut Inferred: bool = Existing.IsInferred;
        let mut PartOfFramework: bool = MD.Framework || Existing.isPartOfFramework();
        let mut ParsedAsMainInput: bool = self.Map.LangOpts.getCompilingModule() == CMK_ModuleMap && self.Map.LangOpts.CurrentModule == ModuleName && self.SourceMgr.getDecomposedLoc(ModuleNameLoc).first != self.SourceMgr.getDecomposedLoc(Existing.DefinitionLoc).first;
        let mut SameModuleDecl: bool = ModuleNameLoc == Existing.DefinitionLoc;
        if LoadedFromASTFile || Inferred || PartOfFramework || ParsedAsMainInput || SameModuleDecl {
            self.ActiveModule = PreviousActiveModule;
            return;
        }
        if !Existing.Parent && self.Map.mayShadowNewModule(Existing) {
            ShadowingModule = Existing;
        } else {
            self.Diags.Report(ModuleNameLoc, err_mmap_module_redefinition) << ModuleName;
            self.Diags.Report(Existing.DefinitionLoc, note_mmap_prev_definition);
            self.HadError = true;
            return;
        }
    }
    if ShadowingModule {
        self.ActiveModule = self.Map.createShadowedModule(ModuleName, MD.Framework, ShadowingModule);
    } else {
        self.ActiveModule = self.Map.findOrCreateModuleFirst(ModuleName, self.ActiveModule, MD.Framework, MD.Explicit);
    }
    self.ActiveModule.DefinitionLoc = ModuleNameLoc;
    if MD.Attrs.IsSystem || self.IsSystem {
        self.ActiveModule.IsSystem = true;
    }
    if MD.Attrs.IsExternC {
        self.ActiveModule.IsExternC = true;
    }
    if MD.Attrs.NoUndeclaredIncludes {
        self.ActiveModule.NoUndeclaredIncludes = true;
    }
    self.ActiveModule.Directory = self.Directory;
    let mut MapFileName: str = operator(self.SourceMgr.getFileEntryRefForID(self.ModuleMapFID)).getName();
    if MapFileName.ends_with("module.private.modulemap") || MapFileName.ends_with("module_private.map") {
        self.ActiveModule.ModuleMapIsPrivate = true;
    }
    let mut StartLoc: SourceLocation = self.SourceMgr.getLocForStartOfFile(self.SourceMgr.getMainFileID());
    if self.Map.HeaderInfo.getHeaderSearchOpts().ImplicitModuleMaps && !self.Diags.isIgnored(warn_mmap_mismatched_private_submodule, StartLoc) && !self.Diags.isIgnored(warn_mmap_mismatched_private_module_name, StartLoc) && self.ActiveModule.ModuleMapIsPrivate {
        self.diagnosePrivateModules(MD.Location);
    }
    for Decl in MD.Decls {
        visit(makeVisitor(Closure_14 { cap_0: self }, Closure_15 { cap_0: self }, Closure_16 { cap_0: self }, Closure_17 { cap_0: self }, Closure_18 { cap_0: self }, Closure_19 { cap_0: self }, Closure_20 { cap_0: self }, Closure_21 { cap_0: self }, Closure_22 { cap_0: self }, Closure_23 { cap_0: self }, Closure_24 { cap_0: self }, Closure_25 { cap_0: self }), Decl);
    }
    if self.ActiveModule.IsFramework && !self.ActiveModule.isSubFramework() && self.ActiveModule.LinkLibraries.is_empty() {
        inferFrameworkLink(self.ActiveModule);
    }
    if !self.ActiveModule.IsAvailable && !self.ActiveModule.IsUnimportable && self.ActiveModule.Parent {
        self.ActiveModule.getTopLevelModule().markUnavailable(false);
        self.ActiveModule.getTopLevelModule().MissingHeaders.append(self.ActiveModule.MissingHeaders.begin(), self.ActiveModule.MissingHeaders.end());
    }
    self.ActiveModule = PreviousActiveModule;
}

fn ModuleMapLoader::handleExternModuleDecl(self, EMD: *ExternModuleDecl) {
    let mut FileNameRef: str = EMD.Path;
    let mut ModuleMapFileName: str = "";
    if is_relative(FileNameRef, native) {
        operator(ModuleMapFileName, self.Directory.getName());
        append(ModuleMapFileName, EMD.Path, "", "", "");
        remove_dots(ModuleMapFileName, true, native);
        FileNameRef = ModuleMapFileName.operator StringRef();
    }
    if self.SourceMgr.getFileManager().getOptionalFileRef(FileNameRef, false, true, true) {
        File;
    } else {
        self.Map.parseAndLoadModuleMapFile(operator(File), self.IsSystem, self.ImplicitlyDiscovered, if self.Map.HeaderInfo.getHeaderSearchOpts().ModuleMapFileHomeIsCwd { self.Directory } else { operator(File).getDir() }, FileID {}, null, EMD.Location);
    }
}

fn shouldAddRequirement(M: *mut Module, Feature: str, IsRequiresExcludedHack: *mut bool) -> bool {
    if Feature == "excluded" && (M.fullModuleNameIs(["Darwin", "C", "excluded"]) || M.fullModuleNameIs(["Tcl", "Private"])) {
        IsRequiresExcludedHack = true;
        return false;
    } else if Feature == "cplusplus" && M.fullModuleNameIs(["IOKit", "avc"]) {
        return false;
    }
    return true;
}

fn ModuleMapLoader::handleRequiresDecl(self, RD: *RequiresDecl) {
    for RF in RD.Features {
        let mut IsRequiresExcludedHack: bool = false;
        let mut ShouldAddRequirement: bool = shouldAddRequirement(self.ActiveModule, RF.Feature, IsRequiresExcludedHack);
        if IsRequiresExcludedHack {
            self.UsesRequiresExcludedHack.insert(self.ActiveModule);
        }
        if ShouldAddRequirement {
            self.ActiveModule.addRequirement(RF.Feature, RF.RequiredState, self.Map.LangOpts, *self.Map.Target);
        }
    }
}

fn ModuleMapLoader::handleHeaderDecl(self, HD: *HeaderDecl) {
    let mut Role: ModuleHeaderRole = NormalHeader;
    if HD.Private {
        Role = PrivateHeader;
    } else if HD.Excluded {
        Role = ExcludedHeader;
    }
    if HD.Textual {
        Role = Role | TextualHeader;
    }
    if self.UsesRequiresExcludedHack.count(self.ActiveModule) {
        Role = Role | TextualHeader;
    }
    let mut Header: UnresolvedHeaderDirective = UnresolvedHeaderDirective {};
    Header.FileName = HD.Path;
    Header.FileNameLoc = HD.PathLoc;
    Header.IsUmbrella = HD.Umbrella;
    Header.Kind = self.Map.headerRoleToKind(Role);
    if Header.IsUmbrella && !holds_alternative(self.ActiveModule.Umbrella) {
        self.Diags.Report(Header.FileNameLoc, err_mmap_umbrella_clash) << self.ActiveModule.getFullModuleName(false);
        self.HadError = true;
        return;
    }
    if self.ImplicitlyDiscovered {
        let mut NormalizedPath: str = HD.Path;
        remove_dots(NormalizedPath, true, native);
        if NormalizedPath.starts_with("..") {
            self.Diags.Report(HD.PathLoc, warn_mmap_path_outside_directory);
        }
    }
    if HD.Size {
        Header.Size = HD.Size;
    }
    if HD.MTime {
        Header.ModTime = HD.MTime;
    }
    let mut NeedsFramework: bool = false;
    if !self.Map.LangOpts.BuiltinHeadersInSystemModules || !isBuiltInModuleName(self.ActiveModule.getTopLevelModuleName()) || self.ActiveModule.fullModuleNameIs(["_Builtin_stddef", "max_align_t"]) {
        self.Map.addUnresolvedHeader(self.ActiveModule, move(Header), NeedsFramework);
    }
    if NeedsFramework {
        self.Diags.Report(self.CurrModuleDeclLoc, note_mmap_add_framework_keyword) << self.ActiveModule.getFullModuleName(false) << CreateReplacement(self.CurrModuleDeclLoc, "framework module");
    }
}

fn compareModuleHeaders(A: *Header, B: *Header) -> bool {
    return operator(A.NameAsWritten, B.NameAsWritten) < 0;
}

fn ModuleMapLoader::handleUmbrellaDirDecl(self, UDD: *UmbrellaDirDecl) {
    let mut DirName: str = UDD.Path[0..allocator<char> {}];
    let mut DirNameAsWritten: str = DirName;
    if !holds_alternative(self.ActiveModule.Umbrella) {
        self.Diags.Report(UDD.Location, err_mmap_umbrella_clash) << self.ActiveModule.getFullModuleName(false);
        self.HadError = true;
        return;
    }
    if self.ImplicitlyDiscovered {
        let mut NormalizedPath: str = UDD.Path;
        remove_dots(NormalizedPath, true, native);
        if NormalizedPath.starts_with("..") {
            self.Diags.Report(UDD.Location, warn_mmap_path_outside_directory);
        }
    }
    let mut Dir: OptionalDirectoryEntryRef = OptionalDirectoryEntryRef {};
    if is_absolute(DirName, native) {
        Dir = self.SourceMgr.getFileManager().getOptionalDirectoryRef(DirName, true);
    } else {
        let mut PathName: str = "";
        PathName = self.Directory.getName();
        append(PathName, DirName, "", "", "");
        Dir = self.SourceMgr.getFileManager().getOptionalDirectoryRef(PathName.operator StringRef(), true);
    }
    if !Dir {
        self.Diags.Report(UDD.Location, warn_mmap_umbrella_dir_not_found) << DirName;
        return;
    }
    if self.UsesRequiresExcludedHack.count(self.ActiveModule) {
        let mut EC: error_code = error_code {};
        let mut Headers: Header, 6> = Header, 6> {};
        let mut FS: *mut FileSystem = self.SourceMgr.getFileManager().getVirtualFileSystem();
        for let mut I: recursive_directory_iterator = recursive_directory_iterator { FS, operator(Dir).getName(), EC };
let mut E: recursive_directory_iterator = recursive_directory_iterator {}; I != E && !EC; I.increment(EC) {
            if self.SourceMgr.getFileManager().getOptionalFileRef(operator(I).path(), false, true, true) {
                FE;
            } else {
                let mut Header: Header = Header { Flags: "", SizeInBytes: operator(I).path()[0..allocator<char> {}], Count: operator(FE) };
                Headers.push(move(Header));
            }
        }
        stable_sort(Headers, compareModuleHeaders);
        for Header in Headers {
            self.Map.addHeader(self.ActiveModule, move(Header), TextualHeader, false, SourceLocation {});
        }
        return;
    }
    if self.Map.UmbrellaDirs[operator(Dir).operator const clang::DirectoryEntry *()] {
        OwningModule;
    } else {
        self.Diags.Report(UDD.Location, err_mmap_umbrella_clash) << OwningModule.getFullModuleName(false);
        self.HadError = true;
        return;
    }
    self.Map.setUmbrellaDirAsWritten(self.ActiveModule, operator(Dir), DirNameAsWritten, DirName, UDD.Location);
}

fn ModuleMapLoader::handleExportDecl(self, ED: *ExportDecl) {
    let mut Unresolved: UnresolvedExportDecl = UnresolvedExportDecl { ED.Location, ED.Id, ED.Wildcard };
    self.ActiveModule.UnresolvedExports.push(Unresolved);
}

fn ModuleMapLoader::handleExportAsDecl(self, EAD: *ExportAsDecl) {
    let mut ModName: *SourceLocation> const = EAD.Id.front();
    if !self.ActiveModule.ExportAsModule.is_empty() {
        if self.ActiveModule.ExportAsModule == ModName.first {
            self.Diags.Report(ModName.second, warn_mmap_redundant_export_as) << self.ActiveModule.Name << ModName.first;
        } else {
            self.Diags.Report(ModName.second, err_mmap_conflicting_export_as) << self.ActiveModule.Name << self.ActiveModule.ExportAsModule << ModName.first;
        }
    }
    self.ActiveModule.ExportAsModule = ModName.first;
    self.Map.addLinkAsDependency(self.ActiveModule);
}

fn ModuleMapLoader::handleUseDecl(self, UD: *UseDecl) {
    if self.ActiveModule.Parent {
        self.Diags.Report(UD.Location, err_mmap_use_decl_submodule);
    } else {
        self.ActiveModule.UnresolvedDirectUses.push(UD.Id);
    }
}

fn ModuleMapLoader::handleLinkDecl(self, LD: *LinkDecl) {
    self.ActiveModule.LinkLibraries.push(LinkLibrary { LD.Library[0..allocator<char> {}], LD.Framework });
}

fn ModuleMapLoader::handleConfigMacros(self, CMD: *ConfigMacrosDecl) {
    if self.ActiveModule.Parent {
        self.Diags.Report(CMD.Location, err_mmap_config_macro_submodule);
        return;
    }
    if CMD.Exhaustive {
        self.ActiveModule.ConfigMacrosExhaustive = true;
    }
    self.ActiveModule.ConfigMacros.insert(self.ActiveModule.ConfigMacros.end(), CMD.Macros.begin(), CMD.Macros.end());
}

fn ModuleMapLoader::handleConflict(self, CD: *ConflictDecl) {
    let mut Conflict: UnresolvedConflict = UnresolvedConflict {};
    Conflict.Id = CD.Id;
    Conflict.Message = CD.Message;
    self.ActiveModule.UnresolvedConflicts.push(move(Conflict));
}

fn ModuleMapLoader::handleInferredModuleDecl(self, MD: *ModuleDecl) {
    let mut StarLoc: SourceLocation = MD.Id.front().second;
    if !self.ActiveModule && !MD.Framework {
        self.Diags.Report(StarLoc, err_mmap_top_level_inferred_submodule);
        return;
    }
    if self.ActiveModule {
        if self.ActiveModule.IsAvailable && !self.ActiveModule.getEffectiveUmbrellaDir() {
            self.Diags.Report(StarLoc, err_mmap_inferred_no_umbrella);
            return;
        }
        if self.ActiveModule.InferSubmodules {
            self.Diags.Report(StarLoc, err_mmap_inferred_redef);
            if self.ActiveModule.InferredSubmoduleLoc.isValid() {
                self.Diags.Report(self.ActiveModule.InferredSubmoduleLoc, note_mmap_prev_definition);
            }
            return;
        }
        if MD.Framework {
            self.Diags.Report(StarLoc, err_mmap_inferred_framework_submodule);
            return;
        }
    } else if MD.Explicit {
        self.Diags.Report(StarLoc, err_mmap_explicit_inferred_framework);
        return;
    }
    if self.ActiveModule {
        self.ActiveModule.InferSubmodules = true;
        self.ActiveModule.InferredSubmoduleLoc = StarLoc;
        self.ActiveModule.InferExplicitSubmodules = MD.Explicit;
    } else {
        let mut InfDir: *mut InferredDirectory = self.Map.InferredDirectories[self.Directory.operator const clang::DirectoryEntry *()];
        InfDir.InferModules = true;
        InfDir.Attrs = MD.Attrs;
        InfDir.ModuleMapFID = self.ModuleMapFID;
    }
    for Decl in MD.Decls {
        visit(makeVisitor(Closure_26 { cap_0: self }, Closure_27 { cap_0: self }, Closure_28 { cap_0: self }), Decl);
    }
}

fn ModuleMapLoader::loadModuleDecl(self, MD: *ModuleDecl) -> bool {
    self.handleModuleDecl(MD);
    return self.HadError;
}

fn ModuleMapLoader::loadExternModuleDecl(self, EMD: *ExternModuleDecl) -> bool {
    self.handleExternModuleDecl(EMD);
    return self.HadError;
}

fn ModuleMapLoader::parseAndLoadModuleMapFile(self, MMF: *ModuleMapFile) -> bool {
    for Decl in MMF.Decls {
        visit(makeVisitor(Closure_29 { cap_0: self }, Closure_30 { cap_0: self }), Decl);
    }
    return self.HadError;
}

fn ModuleMap::findOrLoadModule(self, Name: str) -> *mut Module {
    let mut Known: const_iterator = self.Modules.find(Name);
    if Known != self.Modules.end() {
        return operator(Known).getValue();
    }
    let mut ParsedMod: iterator = self.ParsedModules.find(Name);
    if ParsedMod == self.ParsedModules.end() {
        return null;
    }
    self.Diags.Report(remark_mmap_load_module) << Name;
    for ModuleDecl in operator(ParsedMod).second {
        let mut MMF: *ModuleMapFile = *ModuleDecl.first;
        let mut Loader: ModuleMapLoader = ModuleMapLoader { self.SourceMgr, self.Diags, *self, MMF.ID, operator(MMF.Dir), MMF.IsSystem, MMF.ImplicitlyDiscovered };
        if Loader.loadModuleDecl(*ModuleDecl.second) {
            return null;
        }
    }
    return self.findModule(Name);
}

fn ModuleMap::parseAndLoadModuleMapFile(self, File: FileEntryRef, IsSystem: bool, ImplicitlyDiscovered: bool, Dir: DirectoryEntryRef, ID: FileID, Offset: *mut u32, ExternModuleLoc: SourceLocation) -> bool {
    assert!(self.Target, "Missing target information");
    let mut Known: iterator = self.LoadedModuleMap.find(File.operator const clang::FileEntry *());
    if Known != self.LoadedModuleMap.end() {
        return operator(Known).second;
    }
    if ID.isInvalid() {
        let mut LocalFID: *mut FileID = self.ModuleMapLocalFileID[File.operator const clang::FileEntry *()];
        if LocalFID.isInvalid() {
            let mut FileCharacter: CharacteristicKind = if IsSystem { C_System_ModuleMap } else { C_User_ModuleMap };
            LocalFID = self.SourceMgr.createFileID(File, ExternModuleLoc, FileCharacter, 0, 0);
        }
        ID = LocalFID;
    }
    assert!(self.Target, "Missing target information");
    let mut Buffer: MemoryBufferRef> = self.SourceMgr.getBufferOrNone(ID, SourceLocation {});
    if !Buffer {
        return self.LoadedModuleMap[File.operator const clang::FileEntry *()] = true;
    }
    assert!((!Offset || *Offset <= operator(Buffer).getBufferSize()), "invalid buffer offset");
    let mut MMF: ModuleMapFile> = parseModuleMap(ID, Dir, self.SourceMgr, self.Diags, IsSystem, ImplicitlyDiscovered, Offset);
    let mut Result: bool = false;
    if MMF {
        self.Diags.Report(remark_mmap_load) << File.getName();
        let mut Loader: ModuleMapLoader = ModuleMapLoader { self.SourceMgr, self.Diags, *self, ID, Dir, IsSystem, ImplicitlyDiscovered };
        Result = Loader.parseAndLoadModuleMapFile(operator(MMF));
        let mut PKnown: iterator = self.ParsedModuleMap.find(File.operator const clang::FileEntry *());
        if PKnown == self.ParsedModuleMap.end() {
            self.ParsedModuleMaps.push(make_unique(move(operator(MMF))));
            self.ParsedModuleMap[File.operator const clang::FileEntry *()] = &mut operator(self.ParsedModuleMaps.back());
        }
    }
    self.LoadedModuleMap[File.operator const clang::FileEntry *()] = Result;
    for Cb in self.Callbacks {
        operator(Cb).moduleMapFileRead(if MMF { operator(MMF).Start } else { SourceLocation {} }, File, IsSystem);
    }
    return Result;
}

