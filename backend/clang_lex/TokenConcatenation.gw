// Внешние системные функции libc
extern fn memset(dest: *mut u8, c: i32, n: u64) -> *mut u8;

fn IsStringPrefix(Str: str, CPlusPlus11: bool) -> bool {
    if Str[0] == 'L' || (CPlusPlus11 && (Str[0] == 'u' || Str[0] == 'U' || Str[0] == 'R')) {
        if Str.len == 1 {
            return true;
        }
        if Str[1] == 'R' && Str[0] != 'R' && Str.len == 2 && CPlusPlus11 {
            return true;
        }
        if Str[0] == 'u' && Str[1] == '8' {
            if Str.len == 2 {
                return true;
            }
            if Str.len == 3 && Str[2] == 'R' {
                return true;
            }
        }
    }
    return false;
}

fn TokenConcatenation::IsIdentifierStringPrefix(self: *TokenConcatenation, Tok: *Token) -> bool {
    let mut LangOpts: *LangOptions = self.PP.getLangOpts();
    if !Tok.needsCleaning() {
        if Tok.getLength() < 1 || Tok.getLength() > 3 {
            return false;
        }
        let mut SM: *mut SourceManager = self.PP.getSourceManager();
        let mut Ptr: *u8 = SM.getCharacterData(SM.getSpellingLoc(Tok.getLocation()), null);
        return IsStringPrefix(Ptr[0..Tok.getLength()], LangOpts());
    }
    if Tok.getLength() < 256 {
        let mut Buffer: [256]i8 = zeroed();
        let mut TokPtr: *u8 = Buffer;
        let mut length: u32 = self.PP.getSpelling(Tok, TokPtr, null);
        return IsStringPrefix(TokPtr[0..length], LangOpts());
    }
    return IsStringPrefix(self.PP, LangOpts());
}

fn TokenConcatenation::TokenConcatenation(self, pp: *Preprocessor) {
    memset(self.TokenInfo, 0, (self.TokenInfo));
    self.TokenInfo[identifier] |= aci_custom;
    self.TokenInfo[numeric_constant] |= aci_custom_firstchar;
    self.TokenInfo[period] |= aci_custom_firstchar;
    self.TokenInfo[amp] |= aci_custom_firstchar;
    self.TokenInfo[plus] |= aci_custom_firstchar;
    self.TokenInfo[minus] |= aci_custom_firstchar;
    self.TokenInfo[slash] |= aci_custom_firstchar;
    self.TokenInfo[less] |= aci_custom_firstchar;
    self.TokenInfo[greater] |= aci_custom_firstchar;
    self.TokenInfo[pipe] |= aci_custom_firstchar;
    self.TokenInfo[percent] |= aci_custom_firstchar;
    self.TokenInfo[colon] |= aci_custom_firstchar;
    self.TokenInfo[hash] |= aci_custom_firstchar;
    self.TokenInfo[arrow] |= aci_custom_firstchar;
    if self.PP.getLangOpts() {
        self.TokenInfo[string_literal] |= aci_custom;
        self.TokenInfo[wide_string_literal] |= aci_custom;
        self.TokenInfo[utf8_string_literal] |= aci_custom;
        self.TokenInfo[utf16_string_literal] |= aci_custom;
        self.TokenInfo[utf32_string_literal] |= aci_custom;
        self.TokenInfo[char_constant] |= aci_custom;
        self.TokenInfo[wide_char_constant] |= aci_custom;
        self.TokenInfo[utf16_char_constant] |= aci_custom;
        self.TokenInfo[utf32_char_constant] |= aci_custom;
    }
    if self.PP.getLangOpts() {
        self.TokenInfo[utf8_char_constant] |= aci_custom;
    }
    if self.PP.getLangOpts() {
        self.TokenInfo[lessequal] |= aci_custom_firstchar;
    }
    self.TokenInfo[amp] |= aci_avoid_equal;
    self.TokenInfo[plus] |= aci_avoid_equal;
    self.TokenInfo[minus] |= aci_avoid_equal;
    self.TokenInfo[slash] |= aci_avoid_equal;
    self.TokenInfo[less] |= aci_avoid_equal;
    self.TokenInfo[greater] |= aci_avoid_equal;
    self.TokenInfo[pipe] |= aci_avoid_equal;
    self.TokenInfo[percent] |= aci_avoid_equal;
    self.TokenInfo[star] |= aci_avoid_equal;
    self.TokenInfo[exclaim] |= aci_avoid_equal;
    self.TokenInfo[lessless] |= aci_avoid_equal;
    self.TokenInfo[greatergreater] |= aci_avoid_equal;
    self.TokenInfo[caret] |= aci_avoid_equal;
    self.TokenInfo[equal] |= aci_avoid_equal;
}

fn GetFirstChar(PP: *Preprocessor, Tok: *Token) -> i8 {
    if Tok.getIdentifierInfo() {
        II;
    } else {
        return II.getNameStart()[0];
    }
}

fn TokenConcatenation::AvoidConcat(self: *TokenConcatenation, PrevPrevTok: *Token, PrevTok: *Token, Tok: *Token) -> bool {
    if PrevTok && Tok.is(semi) {
        return false;
    }
    if PrevTok.isAnnotation() {
        return true;
    }
    let mut SM: *mut SourceManager = self.PP.getSourceManager();
    let mut PrevSpellLoc: SourceLocation = SM.getSpellingLoc(PrevTok.getLocation());
    let mut SpellLoc: SourceLocation = SM.getSpellingLoc(Tok.getLocation());
    if PrevSpellLoc.getLocWithOffset(PrevTok.getLength()) == SpellLoc {
        return false;
    }
    let mut PrevKind: TokenKind = PrevTok.getKind();
    if !PrevTok.isAnnotation() && PrevTok.getIdentifierInfo() {
        PrevKind = identifier;
    }
    let mut ConcatInfo: u32 = self.TokenInfo[PrevKind];
    if ConcatInfo == 0 {
        return false;
    }
    if ConcatInfo & aci_avoid_equal {
        if Tok {
            return true;
        }
        ConcatInfo &= ~aci_avoid_equal;
    }
    if Tok.isAnnotation() {
        assert!(Tok, "unexpected annotation in AvoidConcat");
        ConcatInfo = 0;
        if Tok {
            return true;
        }
    }
    if ConcatInfo == 0 {
        return false;
    }
    let mut FirstChar: i8 = 0;
    if ConcatInfo & aci_custom {} else {
        FirstChar = GetFirstChar(self.PP, Tok);
    }
    match PrevKind {
        _ => {
            llvm_unreachable_internal("InitAvoidConcatTokenInfo built wrong", "clang\\lib\\Lex\\TokenConcatenation.cpp", 225);
        },
        raw_identifier => {
            llvm_unreachable_internal("tok::raw_identifier in non-raw lexing mode!", "clang\\lib\\Lex\\TokenConcatenation.cpp", 228);
        },
        string_literal => {
            wide_string_literal;
        },
        identifier => {
            if Tok.is(numeric_constant) {
                return GetFirstChar(self.PP, Tok) != '.';
            }
        },
        numeric_constant => {
            return isPreprocessingNumberBody(FirstChar) || FirstChar == '+' || FirstChar == '-' || (self.PP.getLangOpts() && FirstChar == '$');
        },
        period => {
            return (FirstChar == '.' && PrevPrevTok.is(period)) || isDigit(FirstChar) || (self.PP.getLangOpts() && FirstChar == '*');
        },
        amp => {
            return FirstChar == '&';
        },
        plus => {
            return FirstChar == '+';
        },
        minus => {
            return FirstChar == '-' || FirstChar == '>';
        },
        slash => {
            return FirstChar == '*' || FirstChar == '/';
        },
        less => {
            return FirstChar == '<' || FirstChar == ':' || FirstChar == '%';
        },
        greater => {
            return FirstChar == '>';
        },
        pipe => {
            return FirstChar == '|';
        },
        percent => {
            return FirstChar == '>' || FirstChar == ':';
        },
        colon => {
            return FirstChar == '>' || (self.PP.getLangOpts() && FirstChar == ':');
        },
        hash => {
            return FirstChar == '#' || FirstChar == '@' || FirstChar == '%';
        },
        arrow => {
            return self.PP.getLangOpts() && FirstChar == '*';
        },
        lessequal => {
            return self.PP.getLangOpts() && FirstChar == '>';
        },
    }
}
