// Внешние системные функции libc
extern fn free(ptr: *mut u8);
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn MacroArgs::create(self, MI: *MacroInfo, UnexpArgTokens: ArrayRef<Token>, VarargsElided: bool, PP: *mut Preprocessor) -> *mut MacroArgs {
    assert!(MI.isFunctionLike(), "Can't have args for an object-like macro!");
    let mut ResultEnt: *mut *mut MacroArgs = null;
    let mut ClosestMatch: u32 = ~0;
    for let mut Entry: *mut *mut MacroArgs = &mut PP.MacroArgCache; *Entry; Entry = &mut (*Entry).ArgCache {
        if (*Entry).NumUnexpArgTokens >= () && (*Entry).NumUnexpArgTokens < ClosestMatch {
            ResultEnt = Entry;
            if (*Entry).NumUnexpArgTokens == () {
                break;
            }
            ClosestMatch = (*Entry).NumUnexpArgTokens;
        }
    }
    let mut Result: *mut MacroArgs = null;
    if !ResultEnt {
        Result = ();
    } else {
        Result = *ResultEnt;
        *ResultEnt = Result.ArgCache;
        Result.NumUnexpArgTokens = ();
        Result.VarargsElided = VarargsElided;
        Result.NumMacroArgs = MI.getNumParams();
    }
    if !() {
        copy(Result()());
    }
    return Result;
}

fn MacroArgs::destroy(self, PP: *mut Preprocessor) {
    self.ArgCache = PP.MacroArgCache;
    PP.MacroArgCache = self;
}

fn MacroArgs::deallocate(self) -> *mut MacroArgs {
    let mut Next: *mut MacroArgs = self.ArgCache;
    self.~MacroArgs();
    free(self);
    return Next;
}

fn MacroArgs::getArgLength(self, ArgPtr: *Token) -> u32 {
    let mut NumArgTokens: u32 = 0;
    for ; ArgPtr.isNot(eof); ArgPtr += 1 {
        NumArgTokens += 1;
    }
    return NumArgTokens;
}

fn MacroArgs::getUnexpArgument(self: *MacroArgs, Arg: u32) -> *Token {
    assert!(Arg < self.getNumMacroArguments(), "Invalid arg #");
    let mut Start: *Token = getTrailingObjects();
    let mut Result: *Token = Start;
    for ; Arg; Result += 1 {
        assert!(Result < Start + self.NumUnexpArgTokens, "Invalid arg #");
        if Result.is(eof) {
            Arg -= 1;
        }
    }
    assert!(Result < Start + self.NumUnexpArgTokens, "Invalid arg #");
    return Result;
}

fn MacroArgs::invokedWithVariadicArgument(self, MI: MacroInfo *const, PP: *mut Preprocessor) -> bool {
    if !MI.isVariadic() {
        return false;
    }
    let mut VariadicArgIndex: i32 = self.getNumMacroArguments() - 1;
}

fn MacroArgs::ArgNeedsPreexpansion(self: *MacroArgs, ArgTok: *Token, PP: *mut Preprocessor) -> bool {
    for ; ArgTok.isNot(eof); ArgTok += 1 {
        if ArgTok.getIdentifierInfo() {
            II;
        } else if II.hasMacroDefinition() {
            return true;
        }
    }
    return false;
}

fn MacroArgs::getPreExpArgument(self, Arg: u32, PP: *mut Preprocessor) -> i32 {
    assert!(Arg < self.getNumMacroArguments(), "Invalid argument number!");
    let mut Result: *mut i32 = null;
    if !() {
        return ;
    }
    let mut PreExpandingMacroArgs: SaveAndRestore = PP.InMacroArgPreExpansion;
    let mut AT: *Token = self.getUnexpArgument(Arg);
    let mut NumToks: u32 = getArgLength(AT) + 1;
    PP.EnterTokenStream(AT, NumToks, false, false, false);
    while true {
        {
        Result()(Token {});
        let mut Tok: *mut Token = ();
        PP.Lex(Tok);
    }
        if !(()(eof)) { break; }
    }
    if PP.InCachingLexMode() {
        PP.ExitCachingLexMode();
    }
    PP.RemoveTopOfLexerStack();
    return ;
}

fn MacroArgs::StringifyArgument(self, ArgToks: *Token, PP: *mut Preprocessor, Charify: bool, ExpansionLocStart: SourceLocation, ExpansionLocEnd: SourceLocation) -> Token {
    let mut Tok: Token = Token {};
    Tok.startToken();
    Tok.setKind(if Charify { char_constant } else { string_literal });
    let mut ArgTokStart: *Token = ArgToks;
    let mut Result: str = zeroed();
    Result() += "\"";
    let mut isFirst: bool = true;
    for ; ArgToks.isNot(eof); ArgToks += 1 {
        let mut Tok: *Token = *ArgToks;
        if !isFirst && (Tok.hasLeadingSpace() || Tok.isAtStartOfLine()) {
            Result() += ' ';
        }
        isFirst = false;
        if isStringLiteral(Tok.getKind()) || Tok.is(char_constant) || Tok.is(wide_char_constant) || Tok.is(utf8_char_constant) || Tok.is(utf16_char_constant) || Tok.is(utf32_char_constant) {
            let mut Invalid: bool = false;
            let mut TokStr: str = PP.getSpelling(Tok, &mut Invalid);
            if !Invalid {
                let mut Str: str = Stringify(TokStr, false);
                Result()(Str.begin, Str.end);
            }
        } else if Tok.is(code_completion) {
            PP.CodeCompleteNaturalLanguage();
        } else {
            let mut CurStrLen: u32 = ();
            Result()(CurStrLen + Tok.getLength());
            let mut BufPtr: *u8 = () + CurStrLen;
            let mut Invalid: bool = false;
            let mut ActualTokLen: u32 = PP.getSpelling(Tok, BufPtr, &mut Invalid);
            if !Invalid {
                if ActualTokLen && BufPtr != operator&([CurStrLen]) {
                    memcpy(operator&([CurStrLen]), BufPtr, ActualTokLen);
                }
                if ActualTokLen != Tok.getLength() {
                    Result()(CurStrLen + ActualTokLen);
                }
            }
        }
    }
    if Result()() == '\' {
        let mut FirstNonSlash: u32 = () - 2;
        while Result()[FirstNonSlash] == '\' {
            FirstNonSlash -= 1;
        }
        if (Result()() - 1 - FirstNonSlash) & 1 {
            PP;
            Result()();
        }
    }
    Result() += '"';
    if Charify {
        Result()[0] = '\'';
        Result()[() - 1] = '\'';
        let mut isBad: bool = false;
        if Result()() == 3 {
            isBad = [1] == '\'';
        } else {
            isBad = (Result()() != 4 || [1] != '\');
        }
        if isBad {
            PP;
            Result() = "' '";
        }
    }
    PP.CreateString(Tok, ExpansionLocStart, ExpansionLocEnd);
    return Tok;
}
