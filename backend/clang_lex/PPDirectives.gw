                    continue;
                }
                if Path.len > NameWithoriginalSlashes.len {
                    Path.push(if isAngled { '>' } else { '"' });
                    continue;
                }
                assert!(IsSep.call(NameWithoriginalSlashes[Path.len - 1]);
                while true {
                    {
                    Path.push(NameWithoriginalSlashes[Path.len - 1]);
                }
                    if !(Path.len <= NameWithoriginalSlashes.len && IsSep.call(NameWithoriginalSlashes[Path.len - 1])) { break; }
                }
            }
            if NameWasUNC {
                Path = (Path[0..0 + 1] + "\\\\?\\" + Path[1..1 + npos]);
            }
