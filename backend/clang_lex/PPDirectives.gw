}

fn Closure_4::call(self: *Closure_4, Component: str) -> bool {
        return Component.len == 1 && is_separator(Component[0], self.Separator);
    }

struct Closure_5 {
    cap_0: *mut Preprocessor,
    FilenameLoc: *mut SourceLocation,
    Filename: *mut str,
}

unsafe fn Closure_5::call(self: *mut Closure_5, FE: FileEntryRef) {
        if self.LangOpts.AsmPreprocessor {
            return;
        }
        let mut RequestingModule: *mut Module = self.getModuleForLocation((*self.FilenameLoc), self.LangOpts.ModulesValidateTextualHeaderIncludes);
        let mut RequestingModuleIsModuleInterface: bool = !self.SourceMgr.isInMainFile((*self.FilenameLoc));
        self.HeaderInfo.getModuleMap().diagnoseHeaderInclusion(RequestingModule, RequestingModuleIsModuleInterface, (*self.FilenameLoc), (*self.Filename), FE);
    }

