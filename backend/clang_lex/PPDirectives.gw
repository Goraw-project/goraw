fn Preprocessor::HandleIncludeNextDirective(self, HashLoc: SourceLocation, IncludeNextTok: *mut Token) {
    self.Diag(IncludeNextTok, ext_pp_include_next_directive);
    let mut Lookup: ConstSearchDirIterator = null;
    let mut LookupFromFile: *FileEntry = null;
    tie(Lookup, LookupFromFile) = self.getIncludeNextStart(IncludeNextTok);
    return self.HandleIncludeDirective(HashLoc, IncludeNextTok, Lookup, LookupFromFile);
}

fn Preprocessor::HandleMicrosoftImportDirective(self, Tok: *mut Token) {
    self.Diag(Tok, err_pp_import_directive_ms);
    self.DiscardUntilEndOfDirective(null);
}

fn Preprocessor::HandleImportDirective(self, HashLoc: SourceLocation, ImportTok: *mut Token) {
    if !self.LangOpts.ObjC {
        if self.LangOpts.MSVCCompat {
            return self.HandleMicrosoftImportDirective(ImportTok);
        }
        self.Diag(ImportTok, ext_pp_import_directive);
    }
    return self.HandleIncludeDirective(HashLoc, ImportTok, null, null);
}

fn Preprocessor::HandleIncludeMacrosDirective(self, HashLoc: SourceLocation, IncludeMacrosTok: *mut Token) {
    let mut Loc: SourceLocation = IncludeMacrosTok.getLocation();
    let mut FID: FileID = self.SourceMgr.getFileID(Loc);
    if FID != self.getPredefinesFileID() && FID != self.DeferredGMFInputsFileID {
        self.Diag(IncludeMacrosTok.getLocation(), pp_include_macros_out_of_predefines);
        self.DiscardUntilEndOfDirective(null);
        return;
    }
    self.HandleIncludeDirective(HashLoc, IncludeMacrosTok, null, null);
    let mut TmpTok: Token = Token {};
    while true {
        {
        self.Lex(TmpTok);
        assert!(TmpTok.isNot(eof), "Didn't find end of -imacros!");
    }
        if !(TmpTok.isNot(hashhash)) { break; }
    }
}

fn Preprocessor::ReadMacroParameterList(self, MI: *mut MacroInfo, Tok: *mut Token) -> bool {
    let mut Parameters: SmallVector<IdentifierInfo *, 32> = SmallVector<IdentifierInfo *, 32> {};
    while true {
        self.LexUnexpandedNonComment(Tok);
        match Tok.getKind() {
            r_paren => {
                if Parameters.is_empty() {
                    return false;
                }
            },
            ellipsis => {
                if !self.LangOpts.C99 {
                    self.Diag(Tok, if self.LangOpts.CPlusPlus11 { warn_cxx98_compat_variadic_macro } else { ext_variadic_macro });
                }
            },
            eod => {
                self.Diag(Tok, err_pp_missing_rparen_in_macro_def);
            },
            _ => {
                let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
            },
        }
    }
}

fn isConfigurationPattern(MacroName: *mut Token, MI: *mut MacroInfo, LOptions: *LangOptions) -> bool {
    if MI.getNumTokens() == 1 {
        let mut Value: *Token = MI.getReplacementToken(0);
        if MacroName.getKind() == Value.getKind() {
            return true;
        }
        let mut MacroText: str = MacroName.getIdentifierInfo().getName();
        if Value.getIdentifierInfo() {
            II;
        } else {
            if !II.isKeyword(LOptions) {
                return false;
            }
            let mut ValueText: str = II.getName();
            let mut TrimmedValue: str = ValueText;
            if !ValueText.starts_with("__") {
                if ValueText.starts_with("_") {
                    TrimmedValue = TrimmedValue.drop_front(1);
                } else {
                    return false;
                }
            } else {
                TrimmedValue = TrimmedValue.drop_front(2);
                if TrimmedValue.ends_with("__") {
                    TrimmedValue = TrimmedValue.drop_back(2);
                }
            }
            return TrimmedValue == MacroText;
        }
    }
    return MacroName.isOneOf(kw_extern, kw_inline, kw_static, kw_const) && MI.getNumTokens() == 0;
}

fn Preprocessor::ReadOptionalMacroParameterListAndBody(self, MacroNameTok: *Token, ImmediatelyAfterHeaderGuard: bool) -> *mut MacroInfo {
    let mut LastTok: Token = MacroNameTok;
    let mut MI: MacroInfo *const = self.AllocateMacroInfo(MacroNameTok.getLocation());
    let mut Tok: Token = Token {};
    self.LexUnexpandedToken(Tok);
    let mut _: Closure_8 = Closure_8 { cap_0: self };
    let mut VariadicMacroScopeGuard: VariadicMacroScopeGuard = *self;
    if Tok.is(eod) {
        if ImmediatelyAfterHeaderGuard {
            self.CurPPLexer.MIOpt.SetDefinedMacro(MacroNameTok.getIdentifierInfo(), MacroNameTok.getLocation());
        }
    } else if Tok.hasLeadingSpace() {
        Tok.clearFlag(LeadingSpace);
    } else if Tok.is(l_paren) {
        MI.setIsFunctionLike();
        if self.ReadMacroParameterList(MI, LastTok) {
            return null;
        }
        if MI.isC99Varargs() {
            VariadicMacroScopeGuard.enterScope();
        }
        self.LexUnexpandedToken(Tok);
    } else if self.LangOpts.C99 || self.LangOpts.CPlusPlus11 {
        self.Diag(Tok, ext_c99_whitespace_required_after_macro_name);
    } else {
        let mut isInvalid: bool = false;
        if Tok.is(at) {
            isInvalid = true;
        } else if Tok.is(unknown) {
            isInvalid = true;
        }
        if isInvalid {
            self.Diag(Tok, ext_missing_whitespace_after_macro_name);
        } else {
            self.Diag(Tok, warn_missing_whitespace_after_macro_name);
        }
    }
    if !Tok.is(eod) {
        LastTok = Tok;
    }
    let mut Tokens: SmallVector<Token, 16> = SmallVector<Token, 16> {};
    if MI.isObjectLike() {
        while Tok.isNot(eod) {
            LastTok = Tok;
            Tokens.push(Tok);
            self.LexUnexpandedToken(Tok);
        }
    } else {
        let mut VAOCtx: VAOptDefinitionContext = *self;
        while Tok.isNot(eod) {
            LastTok = Tok;
            if !Tok.isOneOf(hash, hashat, hashhash) {
                Tokens.push(Tok);
                if VAOCtx.isVAOptToken(Tok) {
                    if VAOCtx.isInVAOpt() {
                        self.Diag(Tok, err_pp_vaopt_nested_use);
                        return null;
                    }
                    self.LexUnexpandedToken(Tok);
                    if Tok.isNot(l_paren) {
                        self.Diag(Tok, err_pp_missing_lparen_in_vaopt_use);
                        return null;
                    }
                    Tokens.push(Tok);
                    VAOCtx.sawVAOptFollowedByOpeningParens(Tok.getLocation());
                    self.LexUnexpandedToken(Tok);
                    if Tok.is(hashhash) {
                        self.Diag(Tok, err_vaopt_paste_at_start);
                        return null;
                    }
                    continue;
                } else if VAOCtx.isInVAOpt() {
                    if Tok.is(r_paren) {
                        if VAOCtx.sawClosingParen() {
                            assert!(Tokens.len >= 3, "Must have seen at least __VA_OPT__( and a subsequent tok::r_paren");
                            if Tokens[Tokens.len - 2].is(hashhash) {
                                self.Diag(Tok, err_vaopt_paste_at_end);
                                return null;
                            }
                        }
                    } else if Tok.is(l_paren) {
                        VAOCtx.sawOpeningParen(Tok.getLocation());
                    }
                }
                self.LexUnexpandedToken(Tok);
                continue;
            }
            if self.getLangOpts().TraditionalCPP {
                Tok.setKind(unknown);
                Tokens.push(Tok);
                self.LexUnexpandedToken(Tok);
                continue;
            }
            if Tok.is(hashhash) {
                self.LexUnexpandedToken(Tok);
                if Tok.is(eod) {
                    Tokens.push(LastTok);
                    break;
                }
                if !Tokens.is_empty() && Tok.getIdentifierInfo() == self.Ident__VA_ARGS__ && Tokens[Tokens.len - 1].is(comma) {
                    MI.setHasCommaPasting();
                }
                Tokens.push(LastTok);
                continue;
            }
            self.LexUnexpandedToken(Tok);
            if !VAOCtx.isVAOptToken(Tok) && (Tok.getIdentifierInfo() == null || MI.getParameterNum(Tok.getIdentifierInfo()) == -1) {
                if self.getLangOpts().AsmPreprocessor && Tok.isNot(eod) {
                    LastTok.setKind(unknown);
                    Tokens.push(LastTok);
                    continue;
                } else {
                    self.Diag(Tok, err_pp_stringize_not_parameter) << LastTok.is(hashat);
                    return null;
                }
            }
            Tokens.push(LastTok);
            if !VAOCtx.isVAOptToken(Tok) {
                Tokens.push(Tok);
                LastTok = Tok;
                self.LexUnexpandedToken(Tok);
            }
        }
        if VAOCtx.isInVAOpt() {
            assert!(Tok.is(eod), "Must be at End Of preprocessing Directive");
            self.Diag(Tok, err_pp_expected_after) << LastTok.getKind() << r_paren;
            self.Diag(VAOCtx.getUnmatchedOpeningParenLoc(), note_matching) << l_paren;
            return null;
        }
    }
    MI.setDefinitionEndLoc(LastTok.getLocation());
    MI.setTokens(Tokens, self.BP);
    return MI;
}

fn isObjCProtectedMacro(II: *IdentifierInfo) -> bool {
    return II.isStr("__strong") || II.isStr("__weak") || II.isStr("__unsafe_unretained") || II.isStr("__autoreleasing");
}

fn Preprocessor::HandleDefineDirective(self, DefineTok: *mut Token, ImmediatelyAfterHeaderGuard: bool) {
    self.NumDefined += 1;
    let mut MacroNameTok: Token = Token {};
    let mut MacroShadowsKeyword: bool = false;
    self.ReadMacroName(MacroNameTok, MU_Define, &mut MacroShadowsKeyword);
    if MacroNameTok.is(eod) {
        return;
    }
    let mut II: *mut IdentifierInfo = MacroNameTok.getIdentifierInfo();
    if !II.hasMacroDefinition() && II.hadMacroDefinition() && II.isFinal() {
        self.emitFinalMacroWarning(MacroNameTok, false);
    }
    if self.CurLexer {
        operator(self.CurLexer).SetCommentRetentionState(self.KeepMacroComments);
    }
    let mut MI: MacroInfo *const = self.ReadOptionalMacroParameterListAndBody(MacroNameTok, ImmediatelyAfterHeaderGuard);
    if !MI {
        return;
    }
    if MacroShadowsKeyword && !isConfigurationPattern(MacroNameTok, MI, self.getLangOpts()) {
        self.Diag(MacroNameTok, warn_pp_macro_hides_keyword);
    }
    let mut NumTokens: u32 = MI.getNumTokens();
    if NumTokens != 0 {
        if MI.getReplacementToken(0).is(hashhash) {
            self.Diag(MI.getReplacementToken(0), err_paste_at_start);
            return;
        }
        if MI.getReplacementToken(NumTokens - 1).is(hashhash) {
            self.Diag(MI.getReplacementToken(NumTokens - 1), err_paste_at_end);
            return;
        }
    }
    if self.SkippingUntilPCHThroughHeader {
        let mut OtherMI: *MacroInfo = self.getMacroInfo(MacroNameTok.getIdentifierInfo());
        if !OtherMI || !MI.isIdenticalTo(*OtherMI, *self, self.LangOpts.MicrosoftExt) {
            self.Diag(MI.getDefinitionLoc(), warn_pp_macro_def_mismatch_with_pch) << MacroNameTok.getIdentifierInfo();
        }
        if !self.LangOpts.MicrosoftExt {
            return;
        }
    }
    if self.getMacroInfo(MacroNameTok.getIdentifierInfo()) {
        OtherMI;
    } else {
        if MacroNameTok.getIdentifierInfo().isFinal() {
            self.emitFinalMacroWarning(MacroNameTok, false);
        }
        if self.getLangOpts().ObjC && self.SourceMgr.getFileID(OtherMI.getDefinitionLoc()) == self.getPredefinesFileID() && isObjCProtectedMacro(MacroNameTok.getIdentifierInfo()) {
            if (!self.getDiagnostics().getSuppressSystemWarnings() || !self.SourceMgr.isInSystemHeader(DefineTok.getLocation())) && !MI.isIdenticalTo(*OtherMI, *self, self.LangOpts.MicrosoftExt) {
                self.Diag(MI.getDefinitionLoc(), warn_pp_objc_macro_redef_ignored);
            }
            assert!(!OtherMI.isWarnIfUnused();
            return;
        }
        if !self.getDiagnostics().getSuppressSystemWarnings() || !self.SourceMgr.isInSystemHeader(DefineTok.getLocation()) {
            if !OtherMI.isUsed() && OtherMI.isWarnIfUnused() {
                self.Diag(OtherMI.getDefinitionLoc(), pp_macro_not_used);
            }
            if isLanguageDefinedBuiltin(self.SourceMgr, OtherMI, II.getName()) {
                self.Diag(MacroNameTok, ext_pp_redef_builtin_macro);
            } else if !OtherMI.isAllowRedefinitionsWithoutWarning() && !MI.isIdenticalTo(*OtherMI, *self, self.LangOpts.MicrosoftExt) {
                self.Diag(MI.getDefinitionLoc(), ext_pp_macro_redef) << MacroNameTok.getIdentifierInfo();
                self.Diag(OtherMI.getDefinitionLoc(), note_previous_definition);
            }
        }
        if OtherMI.isWarnIfUnused() {
            self.WarnUnusedMacroLocs.erase(OtherMI.getDefinitionLoc());
        }
    }
    let mut MD: *mut DefMacroDirective = self.appendDefMacroDirective(MacroNameTok.getIdentifierInfo(), MI);
    assert!(!MI.isUsed();
    if self.getSourceManager().isInMainFile(MI.getDefinitionLoc()) && !self.Diags.isIgnored(pp_macro_not_used, MI.getDefinitionLoc()) && !self.MacroExpansionInDirectivesOverride && self.getSourceManager().getFileID(MI.getDefinitionLoc()) != self.getPredefinesFileID() {
        MI.setIsWarnIfUnused(true);
        self.WarnUnusedMacroLocs.insert(MI.getDefinitionLoc());
    }
    if self.Callbacks {
        operator(self.Callbacks).MacroDefined(MacroNameTok, MD);
    }
}

fn Preprocessor::HandleUndefDirective(self) {
    self.NumUndefined += 1;
    let mut MacroNameTok: Token = Token {};
    self.ReadMacroName(MacroNameTok, MU_Undef, null);
    if MacroNameTok.is(eod) {
        return;
    }
    self.CheckEndOfDirective("undef", false, null);
    let mut II: *mut IdentifierInfo = MacroNameTok.getIdentifierInfo();
    let mut MD: MacroDefinition = self.getMacroDefinition(II);
    let mut Undef: *mut UndefMacroDirective = null;
    if II.isFinal() {
        self.emitFinalMacroWarning(MacroNameTok, true);
    }
    if MD.getMacroInfo() {
        MI;
    } else {
        if !MI.isUsed() && MI.isWarnIfUnused() {
            self.Diag(MI.getDefinitionLoc(), pp_macro_not_used);
        }
        if isLanguageDefinedBuiltin(self.SourceMgr, MI, II.getName()) {
            self.Diag(MacroNameTok, ext_pp_undef_builtin_macro);
        }
        if MI.isWarnIfUnused() {
            self.WarnUnusedMacroLocs.erase(MI.getDefinitionLoc());
        }
        Undef = self.AllocateUndefMacroDirective(MacroNameTok.getLocation());
    }
    if self.Callbacks {
        operator(self.Callbacks).MacroUndefined(MacroNameTok, MD, Undef);
    }
    if Undef {
        self.appendMacroDirective(II, Undef);
    }
}

fn Preprocessor::HandleIfdefDirective(self, Result: *mut Token, HashToken: *Token, isIfndef: bool, ReadAnyTokensBeforeDirective: bool) {
    self.NumIf += 1;
    let mut DirectiveTok: Token = Result;
    let mut MacroNameTok: Token = Token {};
    self.ReadMacroName(MacroNameTok, MU_Other, null);
    if MacroNameTok.is(eod) {
        self.SkipExcludedConditionalBlock(HashToken.getLocation(), DirectiveTok.getLocation(), false, false, SourceLocation {});
        return;
    }
    self.emitMacroExpansionWarnings(MacroNameTok, true);
    self.CheckEndOfDirective(if isIfndef { "ifndef" } else { "ifdef" }, false, null);
    let mut MII: *mut IdentifierInfo = MacroNameTok.getIdentifierInfo();
    let mut MD: MacroDefinition = self.getMacroDefinition(MII);
    let mut MI: *mut MacroInfo = MD.getMacroInfo();
    if self.CurPPLexer.getConditionalStackDepth() == 0 {
        if !ReadAnyTokensBeforeDirective && !MI {
            assert!(isIfndef, "#ifdef shouldn't reach here");
            self.CurPPLexer.MIOpt.EnterTopLevelIfndef(MII, MacroNameTok.getLocation());
        } else {
            self.CurPPLexer.MIOpt.EnterTopLevelConditional();
        }
    }
    if MI {
        self.markMacroAsUsed(MI);
    }
    if self.Callbacks {
        if isIfndef {
            operator(self.Callbacks).Ifndef(DirectiveTok.getLocation(), MacroNameTok, MD);
        } else {
            operator(self.Callbacks).Ifdef(DirectiveTok.getLocation(), MacroNameTok, MD);
        }
    }
    let mut RetainExcludedCB: bool = self.PPOpts.RetainExcludedConditionalBlocks && self.getSourceManager().isInMainFile(DirectiveTok.getLocation());
    if self.PPOpts.SingleFileParseMode && !MI {
        self.CurPPLexer.pushConditionalLevel(DirectiveTok.getLocation(), false, false, false);
    } else if self.PPOpts.SingleModuleParseMode && !MI {
        self.SkipExcludedConditionalBlock(HashToken.getLocation(), DirectiveTok.getLocation(), true, false, SourceLocation {});
    } else if !MI == isIfndef || RetainExcludedCB {
        self.CurPPLexer.pushConditionalLevel(DirectiveTok.getLocation(), false, true, false);
    } else {
        self.SkipExcludedConditionalBlock(HashToken.getLocation(), DirectiveTok.getLocation(), false, false, SourceLocation {});
    }
}

fn Preprocessor::HandleIfDirective(self, IfToken: *mut Token, HashToken: *Token, ReadAnyTokensBeforeDirective: bool) {
    self.NumIf += 1;
    let mut IfNDefMacro: *mut IdentifierInfo = null;
    let mut DER: DirectiveEvalResult = self.EvaluateDirectiveExpression(IfNDefMacro, true);
    let mut ConditionalTrue: bool = DER.Conditional;
    if !self.CurPPLexer {
        return;
    }
    if self.CurPPLexer.getConditionalStackDepth() == 0 {
        if !ReadAnyTokensBeforeDirective && IfNDefMacro && ConditionalTrue {
            self.CurPPLexer.MIOpt.EnterTopLevelIfndef(IfNDefMacro, IfToken.getLocation());
        } else {
            self.CurPPLexer.MIOpt.EnterTopLevelConditional();
        }
    }
    if self.Callbacks {
        operator(self.Callbacks).If(IfToken.getLocation(), DER.ExprRange, (if ConditionalTrue { CVK_True } else { CVK_False }));
    }
    let mut RetainExcludedCB: bool = self.PPOpts.RetainExcludedConditionalBlocks && self.getSourceManager().isInMainFile(IfToken.getLocation());
    if self.PPOpts.SingleFileParseMode && DER.IncludedUndefinedIds {
        self.CurPPLexer.pushConditionalLevel(IfToken.getLocation(), false, false, false);
    } else if self.PPOpts.SingleModuleParseMode && DER.IncludedUndefinedIds {
        self.SkipExcludedConditionalBlock(HashToken.getLocation(), IfToken.getLocation(), true, false, SourceLocation {});
    } else if ConditionalTrue || RetainExcludedCB {
        self.CurPPLexer.pushConditionalLevel(IfToken.getLocation(), false, true, false);
    } else {
        self.SkipExcludedConditionalBlock(HashToken.getLocation(), IfToken.getLocation(), false, false, SourceLocation {});
    }
}

fn Preprocessor::HandleEndifDirective(self, EndifToken: *mut Token) {
    self.NumEndif += 1;
    self.CheckEndOfDirective("endif", false, null);
    let mut CondInfo: PPConditionalInfo = PPConditionalInfo {};
    if self.CurPPLexer.popConditionalLevel(CondInfo) {
        self.Diag(EndifToken, err_pp_endif_without_if);
        return;
    }
    if self.CurPPLexer.getConditionalStackDepth() == 0 {
        self.CurPPLexer.MIOpt.ExitTopLevelConditional();
    }
    assert!(!CondInfo.WasSkipping && !self.CurPPLexer.LexingRawMode, "This code should only be reachable in the non-skipping case!");
    if self.Callbacks {
        operator(self.Callbacks).Endif(EndifToken.getLocation(), CondInfo.IfLoc);
    }
}

fn Preprocessor::HandleElseDirective(self, Result: *mut Token, HashToken: *Token) {
    self.NumElse += 1;
    self.CheckEndOfDirective("else", false, null);
    let mut CI: PPConditionalInfo = PPConditionalInfo {};
    if self.CurPPLexer.popConditionalLevel(CI) {
        self.Diag(Result, pp_err_else_without_if);
        return;
    }
    if self.CurPPLexer.getConditionalStackDepth() == 0 {
        self.CurPPLexer.MIOpt.EnterTopLevelConditional();
    }
    if CI.FoundElse {
        self.Diag(Result, pp_err_else_after_else);
    }
    if self.Callbacks {
        operator(self.Callbacks).Else(Result.getLocation(), CI.IfLoc);
    }
    let mut RetainExcludedCB: bool = self.PPOpts.RetainExcludedConditionalBlocks && self.getSourceManager().isInMainFile(Result.getLocation());
    if (self.PPOpts.SingleFileParseMode && !CI.FoundNonSkip) || RetainExcludedCB {
        self.CurPPLexer.pushConditionalLevel(CI.IfLoc, false, false, true);
        return;
    }
    self.SkipExcludedConditionalBlock(HashToken.getLocation(), CI.IfLoc, true, true, Result.getLocation());
}

fn Preprocessor::HandleElifFamilyDirective(self, ElifToken: *mut Token, HashToken: *Token, Kind: PPKeywordKind) {
    let mut DirKind: PPElifDiag = if Kind == pp_elif { PED_Elif } else { if Kind == pp_elifdef { PED_Elifdef } else { PED_Elifndef } };
    self.NumElse += 1;
    match DirKind {
        PED_Elifdef => {
            PED_Elifndef;
        },
        _ => {
            break;
        },
    }
    let mut ConditionRange: SourceRange = self.DiscardUntilEndOfDirective(null);
    let mut CI: PPConditionalInfo = PPConditionalInfo {};
    if self.CurPPLexer.popConditionalLevel(CI) {
        self.Diag(ElifToken, pp_err_elif_without_if) << DirKind;
        return;
    }
    if self.CurPPLexer.getConditionalStackDepth() == 0 {
        self.CurPPLexer.MIOpt.EnterTopLevelConditional();
    }
    if CI.FoundElse {
        self.Diag(ElifToken, pp_err_elif_after_else) << DirKind;
    }
    if self.Callbacks {
        match Kind {
            pp_elif => {
                operator(self.Callbacks).Elif(ElifToken.getLocation(), ConditionRange, CVK_NotEvaluated, CI.IfLoc);
            },
            pp_elifdef => {
                operator(self.Callbacks).Elifdef(ElifToken.getLocation(), ConditionRange, CI.IfLoc);
            },
            pp_elifndef => {
                operator(self.Callbacks).Elifndef(ElifToken.getLocation(), ConditionRange, CI.IfLoc);
            },
            _ => {
                assert!(false, "unexpected directive kind");
            },
        }
    }
    let mut RetainExcludedCB: bool = self.PPOpts.RetainExcludedConditionalBlocks && self.getSourceManager().isInMainFile(ElifToken.getLocation());
    if (self.PPOpts.SingleFileParseMode && !CI.FoundNonSkip) || RetainExcludedCB {
        self.CurPPLexer.pushConditionalLevel(ElifToken.getLocation(), false, false, false);
        return;
    }
    self.SkipExcludedConditionalBlock(HashToken.getLocation(), CI.IfLoc, true, CI.FoundElse, ElifToken.getLocation());
}

fn Preprocessor::LexEmbedParameters(self, CurTok: *mut Token, ForHasEmbed: bool) -> optional<LexEmbedParametersResult> {
    let mut Result: LexEmbedParametersResult = LexEmbedParametersResult { MaybeLimitParam: optional<PPEmbedParameterLimit> {}, MaybeOffsetParam: optional<PPEmbedParameterOffset> {}, MaybeIfEmptyParam: optional<PPEmbedParameterIfEmpty> {}, MaybePrefixParam: optional<PPEmbedParameterPrefix> {}, MaybeSuffixParam: optional<PPEmbedParameterSuffix> {}, UnrecognizedParams:  };
    let mut EndTokenKind: TokenKind = if ForHasEmbed { r_paren } else { eod };
    let mut DiagMismatchedBracesAndSkipToEOD: Closure_9 = Closure_9 { cap_0: self, CurTok: &mut CurTok };
    let mut ExpectOrDiagAndSkipToEOD: Closure_10 = Closure_10 { CurTok: &mut CurTok, cap_1: self };
    let mut LexPPParameterName: Closure_11 = Closure_11 { ExpectOrDiagAndSkipToEOD: &mut ExpectOrDiagAndSkipToEOD, CurTok: &mut CurTok, cap_2: self };
    let mut NormalizeParameterName: Closure_12 = Closure_12 {};
    let mut LexParenthesizedIntegerExpr: Closure_13 = Closure_13 { ExpectOrDiagAndSkipToEOD: &mut ExpectOrDiagAndSkipToEOD, cap_1: self, CurTok: &mut CurTok, EndTokenKind: &mut EndTokenKind };
    let mut GetMatchingCloseBracket: Closure_14 = Closure_14 {};
    let mut LexParenthesizedBalancedTokenSoup: Closure_15 = Closure_15 { ExpectOrDiagAndSkipToEOD: &mut ExpectOrDiagAndSkipToEOD, cap_1: self, CurTok: &mut CurTok, GetMatchingCloseBracket: &mut GetMatchingCloseBracket, DiagMismatchedBracesAndSkipToEOD: &mut DiagMismatchedBracesAndSkipToEOD };
    self.LexNonComment(CurTok);
    while !CurTok.isOneOf(EndTokenKind, eod) {
        let mut ParamStartLoc: SourceLocation = CurTok.getLocation();
        let mut ParamName: string> = LexPPParameterName.call();
        if !ParamName {
            return nullopt;
        }
        let mut Parameter: str = NormalizeParameterName.call(operator(ParamName));
        if Parameter == "limit" {
            if Result.MaybeLimitParam {
                self.Diag(CurTok, err_pp_embed_dup_params) << Parameter;
            }
            let mut Limit: optional<size_t> = LexParenthesizedIntegerExpr.call();
            if !Limit {
                return nullopt;
            }
            Result.MaybeLimitParam = PPEmbedParameterLimit { operator(Limit), ParamStartLoc, CurTok.getLocation() };
        } else if Parameter == "clang::offset" {
            if Result.MaybeOffsetParam {
                self.Diag(CurTok, err_pp_embed_dup_params) << Parameter;
            }
            let mut Offset: optional<size_t> = LexParenthesizedIntegerExpr.call();
            if !Offset {
                return nullopt;
            }
            Result.MaybeOffsetParam = PPEmbedParameterOffset { operator(Offset), ParamStartLoc, CurTok.getLocation() };
        } else if Parameter == "prefix" {
            if Result.MaybePrefixParam {
                self.Diag(CurTok, err_pp_embed_dup_params) << Parameter;
            }
            let mut Soup: SmallVector<Token, 4> = SmallVector<Token, 4> {};
            if !LexParenthesizedBalancedTokenSoup.call(Soup) {
                return nullopt;
            }
            Result.MaybePrefixParam = PPEmbedParameterPrefix { move(Soup), ParamStartLoc, CurTok.getLocation() };
        } else if Parameter == "suffix" {
            if Result.MaybeSuffixParam {
                self.Diag(CurTok, err_pp_embed_dup_params) << Parameter;
            }
            let mut Soup: SmallVector<Token, 4> = SmallVector<Token, 4> {};
            if !LexParenthesizedBalancedTokenSoup.call(Soup) {
                return nullopt;
            }
            Result.MaybeSuffixParam = PPEmbedParameterSuffix { move(Soup), ParamStartLoc, CurTok.getLocation() };
        } else if Parameter == "if_empty" {
            if Result.MaybeIfEmptyParam {
                self.Diag(CurTok, err_pp_embed_dup_params) << Parameter;
            }
            let mut Soup: SmallVector<Token, 4> = SmallVector<Token, 4> {};
            if !LexParenthesizedBalancedTokenSoup.call(Soup) {
                return nullopt;
            }
            Result.MaybeIfEmptyParam = PPEmbedParameterIfEmpty { move(Soup), ParamStartLoc, CurTok.getLocation() };
        } else {
            Result.UnrecognizedParams += 1;
            if CurTok.is(l_paren) {
                let mut Soup: SmallVector<Token, 4> = SmallVector<Token, 4> {};
                if !LexParenthesizedBalancedTokenSoup.call(Soup) {
                    return nullopt;
                }
            }
            if !ForHasEmbed {
                self.Diag(ParamStartLoc, err_pp_unknown_parameter) << 1 << Parameter;
                if CurTok.isNot(EndTokenKind) {
                    self.DiscardUntilEndOfDirective(CurTok, null);
                }
                return nullopt;
            }
        }
    }
    return Result;
}

fn Preprocessor::HandleEmbedDirectiveImpl(self, HashLoc: SourceLocation, Params: *LexEmbedParametersResult, BinaryContents: str, FileName: str) {
    if BinaryContents.is_empty() {
        if Params.MaybeIfEmptyParam {
            let mut Toks: ArrayRef<Token> = operator(Params.MaybeIfEmptyParam).Tokens;
            let mut TokCount: u64 = Toks.len;
            let mut NewToks: []Token = make_unique(TokCount);
            copy(Toks, NewToks.get());
            self.EnterTokenStream(move(NewToks), TokCount, true, true);
        }
        return;
    }
    let mut NumPrefixToks: u64 = Params.PrefixTokenCount();
    let mut NumSuffixToks: u64 = Params.SuffixTokenCount();
    let mut TotalNumToks: u64 = 1 + NumPrefixToks + NumSuffixToks;
    let mut CurIdx: u64 = 0;
    let mut Toks: []Token = make_unique(TotalNumToks);
    if Params.MaybePrefixParam {
        copy(operator(Params.MaybePrefixParam).Tokens, &mut Toks[CurIdx]);
        CurIdx += NumPrefixToks;
    }
    let mut Data: *mut EmbedAnnotationData = EmbedAnnotationData {};
    Data.BinaryData = BinaryContents;
    Data.FileName = FileName;
    Toks[CurIdx].startToken();
    Toks[CurIdx].setKind(annot_embed);
    Toks[CurIdx].setAnnotationRange(HashLoc);
    Toks[CurIdx += 1].setAnnotationValue(Data);
    if Params.MaybeSuffixParam {
        copy(operator(Params.MaybeSuffixParam).Tokens, &mut Toks[CurIdx]);
        CurIdx += NumSuffixToks;
    }
    assert!(CurIdx == TotalNumToks, "Calculated the incorrect number of tokens");
    self.EnterTokenStream(move(Toks), TotalNumToks, true, true);
}

fn Preprocessor::HandleEmbedDirective(self, HashLoc: SourceLocation, EmbedTok: *mut Token) {
    if self.LangOpts.C23 {
        self.Diag(EmbedTok, warn_compat_pp_embed_directive);
    } else {
        self.Diag(EmbedTok, ext_pp_embed_directive) << (if self.LangOpts.CPlusPlus { 1 } else { 0 });
    }
    let mut FilenameTok: Token = Token {};
    if self.LexHeaderName(FilenameTok, true) {
        return;
    }
    if FilenameTok.isNot(header_name) {
        self.Diag(FilenameTok.getLocation(), err_pp_expects_filename);
        if FilenameTok.isNot(eod) {
            self.DiscardUntilEndOfDirective(null);
        }
        return;
    }
    let mut CurTok: Token = Token {};
    let mut Params: optional<LexEmbedParametersResult> = self.LexEmbedParameters(CurTok, false);
    assert!((Params || CurTok.is(eod)), "expected success or to be at the end of the directive");
    if !Params {
        return;
    }
    let mut FilenameBuffer: str = "";
    let mut Filename: str = self.getSpelling(FilenameTok, FilenameBuffer, null);
    let mut OriginalFilename: str = Filename;
    let mut isAngled: bool = self.GetIncludeFilenameSpelling(FilenameTok.getLocation(), Filename);
    if Filename.is_empty() {
        return;
    }
    let mut MaybeFileRef: OptionalFileEntryRef = self.LookupEmbedFile(Filename, isAngled, true);
    if !MaybeFileRef {
        if self.Callbacks && operator(self.Callbacks).EmbedFileNotFound(Filename) {
            return;
        }
        self.Diag(FilenameTok, err_pp_file_not_found) << Filename;
        return;
    }
    if operator(MaybeFileRef).isDeviceFile() {
        self.Diag(FilenameTok, err_pp_embed_device_file) << Filename;
        return;
    }
    let mut MaybeFile: MemoryBufferRef> = self.getSourceManager().getMemoryBufferForFileOrNone(operator(MaybeFileRef));
    if !MaybeFile {
        self.Diag(FilenameTok, err_cannot_open_file) << Filename << "a buffer to the contents could not be created";
        return;
    }
    let mut BinaryContents: str = operator(MaybeFile).getBuffer();
    if operator(Params).MaybeOffsetParam {
        BinaryContents = BinaryContents[operator(operator(Params).MaybeOffsetParam).Offset..operator(operator(Params).MaybeOffsetParam).Offset + npos];
    }
    if operator(Params).MaybeLimitParam {
        BinaryContents = BinaryContents[0..0 + operator(operator(Params).MaybeLimitParam).Limit];
    }
    if self.Callbacks {
        operator(self.Callbacks).EmbedDirective(HashLoc, Filename, isAngled, MaybeFileRef, operator(Params));
    }
    let mut Mem: *mut void = self.BP.Allocate(OriginalFilename.len, alignof);
    memcpy(Mem, OriginalFilename.ptr, OriginalFilename.len);
    let mut FilenameToGo: str = Mem as *mut u8[0..OriginalFilename.len];
    self.HandleEmbedDirectiveImpl(HashLoc, operator(Params), BinaryContents, FilenameToGo);
}

fn Preprocessor::HandleCXXImportDirective(self, ImportTok: Token) {
    assert!(self.getLangOpts().CPlusPlusModules && ImportTok.is(kw_import);
    let mut SaveImportingCXXModules: SaveAndRestore<bool> = SaveAndRestore<bool> { self.ImportingCXXNamedModules, true };
    let mut Tok: Token = Token {};
    if self.LexHeaderName(Tok, true) {
        if Tok.isNot(eod) {
            self.CheckEndOfDirective(ImportTok.getIdentifierInfo().getName(), false, null);
        }
        return;
    }
    let mut UseLoc: SourceLocation = ImportTok.getLocation();
    let mut DirToks: SmallVector<Token, 4> = [ImportTok];
    let mut Path: SmallVector<IdentifierLoc, 2> = SmallVector<IdentifierLoc, 2> {};
    let mut ImportingHeader: bool = false;
    let mut IsPartition: bool = false;
    match Tok.getKind() {
        header_name => {
            ImportingHeader = true;
        },
        colon => {
            IsPartition = true;
        },
        code_completion => {
            identifier;
        },
        _ => {
            DirToks.push(Tok);
        },
    }
    if !DirToks.back().isOneOf(semi, eod) {
        self.CollectPPImportSuffix(DirToks, false);
    }
    if DirToks.back().isNot(eod) {
        self.CheckEndOfDirective(ImportTok.getIdentifierInfo().getName(), false, null);
    } else {
        DirToks.pop();
    }
    if DirToks.back().isNot(semi) {
        self.EnterModuleSuffixTokenStream(DirToks);
        return;
    }
    if ImportingHeader {
        let mut SemiLoc: SourceLocation = DirToks.back().getLocation();
        if SemiLoc.isMacroID() {
            self.Diag(SemiLoc, err_header_import_semi_in_macro);
        }
        let mut Action: ImportAction = self.HandleHeaderIncludeOrImport(SourceLocation {}, ImportTok, Tok, SemiLoc, null, null);
        match Action.Kind {
            None => {
                break;
            },
            ModuleBegin => {
                DirToks.push();
            },
            ModuleImport => {
                HeaderUnitImport;
            },
            Failure => {
                assert!(self.TheModuleLoader.HadFatalFailure, "This should be an early exit only to a fatal error");
            },
        }
    }
    self.EnterModuleSuffixTokenStream(DirToks);
}

fn Preprocessor::HandleCXXModuleDirective(self, ModuleTok: Token) {
    assert!(self.getLangOpts().CPlusPlusModules && ModuleTok.is(kw_module);
    let mut StartLoc: SourceLocation = ModuleTok.getLocation();
    let mut Tok: Token = Token {};
    let mut UseLoc: SourceLocation = ModuleTok.getLocation();
    let mut DirToks: SmallVector<Token, 4> = [ModuleTok];
    let mut Path: SmallVector<IdentifierLoc, 2> = SmallVector<IdentifierLoc, 2> {};
    let mut Partition: SmallVector<IdentifierLoc, 2> = SmallVector<IdentifierLoc, 2> {};
    self.LexUnexpandedToken(Tok);
    match Tok.getKind() {
        semi => {
            DirToks.push(Tok);
        },
        colon => {
            DirToks.push(Tok);
        },
        identifier => {
            if self.HandleModuleName(ModuleTok.getIdentifierInfo().getName(), UseLoc, Tok, Path, DirToks, false, false) {
                return;
            }
            if Tok.is(colon) {
                self.LexUnexpandedToken(Tok);
                if self.HandleModuleName(ModuleTok.getIdentifierInfo().getName(), UseLoc, Tok, Partition, DirToks, false, true) {
                    return;
                }
            }
            if Tok.is(identifier) && self.getMacroDefinition(Tok.getIdentifierInfo()) {
                let mut TokCopy: []unique_ptr<Token = make_unique(1);
                TokCopy[0] = Tok;
                self.EnterTokenStream(move(TokCopy), 1, false, false);
                self.Lex(Tok);
                DirToks.back() = Tok;
            }
            break;
        },
        _ => {
            DirToks.push(Tok);
        },
    }
    if !DirToks.back().isOneOf(semi, eod) {
        self.CollectPPImportSuffix(DirToks, false);
    }
    let mut End: SourceLocation = if DirToks.back().isNot(eod) { self.CheckEndOfDirective(ModuleTok.getIdentifierInfo().getName(), false, &mut DirToks) } else { DirToks.pop_back_val().getLocation() };
    let mut IsGMFIntroducer: bool = DirToks.len == 2 && DirToks[0].is(kw_module) && DirToks[1].is(semi);
    let mut IsSynthesizedGMF: bool = IsGMFIntroducer && self.HasSynthesizedGMF && self.CurPPLexer.getFileID() == self.getPredefinesFileID();
    if !self.IncludeMacroStack.is_empty() && !IsSynthesizedGMF {
        self.Diag(StartLoc, err_pp_module_decl_in_header) << SourceRange { B: StartLoc, E: End };
    }
    if self.CurPPLexer.getConditionalStackDepth() != 0 {
        self.Diag(StartLoc, err_pp_cond_span_module_decl) << SourceRange { B: StartLoc, E: End };
    }
    if IsGMFIntroducer {
        self.EnterDeferredGMFInputs(End);
    }
    self.EnterModuleSuffixTokenStream(DirToks);
}

fn Preprocessor::HandleObjCImportDirective(self, AtTok: *mut Token, ImportTok: *mut Token) {
    assert!(self.getLangOpts().ObjC && AtTok.is(at) && ImportTok.isObjCAtKeyword(objc_import);
    ImportTok.setKind(kw_import);
    let mut DirToks: SmallVector<Token, 32> = [AtTok, ImportTok];
    let mut Path: SmallVector<IdentifierLoc, 3> = SmallVector<IdentifierLoc, 3> {};
    let mut UseLoc: SourceLocation = ImportTok.getLocation();
    self.ModuleImportLoc = ImportTok.getLocation();
    let mut Tok: Token = Token {};
    self.Lex(Tok);
    if self.HandleModuleName(ImportTok.getIdentifierInfo().getName(), UseLoc, Tok, Path, DirToks, true, false) {
        return;
    }
    if !DirToks.back().isOneOf(semi, eod) {
        self.CollectPPImportSuffix(DirToks, false);
    }
    let mut End: SourceLocation = if DirToks.back().isNot(eod) { self.CheckEndOfDirective(ImportTok.getIdentifierInfo().getName(), false, &mut DirToks) } else { DirToks.pop_back_val().getLocation() };
    let mut Imported: *mut Module = null;
    if self.getLangOpts().Modules {
        Imported = self.TheModuleLoader.loadModule(self.ModuleImportLoc, Path, Hidden, false).operator clang::Module *();
        if Imported {
            self.makeModuleVisible(Imported, End, true);
        }
    }
    if self.Callbacks {
        operator(self.Callbacks).moduleImport(self.ModuleImportLoc, Path, Imported);
    }
    self.EnterModuleSuffixTokenStream(DirToks);
}

