unsafe fn Closure_10::call(self: *mut Closure_10, Kind: TokenKind) -> bool {
        if (*self.CurTok).isNot(Kind) {
            self.Diag((*self.CurTok), err_expected) << Kind;
            if (*self.CurTok).isNot(eod) {
                self.DiscardUntilEndOfDirective((*self.CurTok), null);
            }
            return false;
        }
        return true;
    }

