unsafe fn Closure_9::call(self: *mut Closure_9, Expected: TokenKind, Matches: TokenKind, SourceLocation>) {
        self.Diag((*self.CurTok), err_expected) << Expected;
        self.Diag(Matches.second, note_matching) << Matches.first;
        if (*self.CurTok).isNot(eod) {
            self.DiscardUntilEndOfDirective((*self.CurTok), null);
