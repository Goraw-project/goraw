    let mut CheckIncludePathPortability: bool = !IsMapped && !operator(File).getFileEntry().tryGetRealPathName().is_empty();
    if CheckIncludePathPortability {
        let mut Name: str = LookupFilename;
        let mut NameWithoriginalSlashes: str = Filename;
        let mut NameWasUNC: bool = Name.consume_front("\\\\?\\");
        NameWithoriginalSlashes.consume_front("\\\\?\\");
        let mut RealPathName: str = operator(File).getFileEntry().tryGetRealPathName();
        let mut Components: SmallVector<StringRef, 16> = SmallVector<StringRef, 16> { begin(Name, native), end(Name) };
        let mut FixedDriveRealPath: str = "";
        if is_absolute(Name, native) && is_absolute(RealPathName, native) && toLowercase(Name[0]) == toLowercase(RealPathName[0]) && isLowercase(Name[0]) != isLowercase(RealPathName[0]) {
            assert!(Components.len >= 3, "should have drive, backslash, name");
            assert!(Components[0].len == 2, "should start with drive");
            assert!(Components[0][1] == ':', "should have colon");
            FixedDriveRealPath = (Name[0..0 + 1] + RealPathName[1..1 + npos]);
            RealPathName = FixedDriveRealPath.operator StringRef();
        }
        if trySimplifyPath(Components, RealPathName, BackslashStyle) {
            let mut Path: str = "";
            Path.reserve(Name.len + 2);
            Path.push(if isAngled { '<' } else { '"' });
            let mut IsSep: Closure_7 = Closure_7 { BackslashStyle: BackslashStyle };
            for Component in Components {
                if !(Component.len == 1 && IsSep.call(Component[0])) {
                    Path.append(Component);
