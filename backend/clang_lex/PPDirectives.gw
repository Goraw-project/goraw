    let mut IsFirstIncludeOfFile: bool = false;
    if Action == Enter && File && !self.HeaderInfo.ShouldEnterIncludeFile(*self, operator(File), EnterOnce, self.getLangOpts().Modules, ModuleToImport, IsFirstIncludeOfFile) {
