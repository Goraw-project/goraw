fn Closure_6::call(self: *Closure_6, Filename: str) -> str {
            Filename = Filename.drop_until(function_ref<bool (char)> { isAlphanumeric, null, null });
            while !Filename.is_empty() && !isAlphanumeric(Filename.back()) {
                Filename = Filename.drop_back(1);
            }
            return Filename;
        }

