fn Preprocessor::DiscardUntilEndOfDirective(self, Tmp: *mut Token, DiscardedToks: *mut SmallVectorImpl<Token>) -> SourceRange {
    let mut Res: SourceRange = SourceRange {};
    let mut ReadNextTok: Closure_1 = Closure_1 { cap_0: self, Tmp: &mut Tmp, DiscardedToks: &mut DiscardedToks };
    ReadNextTok.call();
    Res.setBegin(Tmp.getLocation());
    while Tmp.isNot(eod) {
        assert!(Tmp.isNot(eof), "EOF seen while discarding directive tokens");
        ReadNextTok.call();
    }
    Res.setEnd(Tmp.getLocation());
    return Res;
}

enum MacroDiag {
    MD_NoWarn = 0,
    MD_KeywordDef = 1,
    MD_ReservedMacro = 2,
    MD_ReservedAttributeIdentifier = 3,
}

enum PPElifDiag {
    PED_Elif = 0,
    PED_Elifdef = 1,
    PED_Elifndef = 2,
}

fn isFeatureTestMacro(MacroName: str) -> bool {
    let mut ReservedMacro: [29]str = ["_ATFILE_SOURCE", "_BSD_SOURCE", "_CRT_NONSTDC_NO_WARNINGS", "_CRT_SECURE_CPP_OVERLOAD_STANDARD_NAMES", "_CRT_SECURE_NO_WARNINGS", "_FILE_OFFSET_BITS", "_FORTIFY_SOURCE", "_GLIBCXX_ASSERTIONS", "_GLIBCXX_CONCEPT_CHECKS", "_GLIBCXX_DEBUG", "_GLIBCXX_DEBUG_PEDANTIC", "_GLIBCXX_PARALLEL", "_GLIBCXX_PARALLEL_ASSERTIONS", "_GLIBCXX_SANITIZE_VECTOR", "_GLIBCXX_USE_CXX11_ABI", "_GLIBCXX_USE_DEPRECATED", "_GNU_SOURCE", "_ISOC11_SOURCE", "_ISOC95_SOURCE", "_ISOC99_SOURCE", "_LARGEFILE64_SOURCE", "_POSIX_C_SOURCE", "_REENTRANT", "_SVID_SOURCE", "_THREAD_SAFE", "_XOPEN_SOURCE", "_XOPEN_SOURCE_EXTENDED", "__STDCPP_WANT_MATH_SPEC_FUNCS__", "__STDC_FORMAT_MACROS"];
    return binary_search(ReservedMacro, MacroName);
}

fn isLanguageDefinedBuiltin(SourceMgr: *SourceManager, MI: *MacroInfo, MacroName: str) -> bool {
    if MI.isBuiltinMacro() {
        return true;
    }
    if !SourceMgr.isWrittenInBuiltinFile(MI.getDefinitionLoc()) {
        return false;
    }
    if MacroName.starts_with("__STDC") {
        return true;
    }
    if MacroName == "__cplusplus" {
        return true;
    }
    if MacroName.starts_with("__cpp") {
        return true;
    }
    return false;
}

fn isReservedCXXAttributeName(PP: *mut Preprocessor, II: *mut IdentifierInfo) -> bool {
    let mut Lang: *LangOptions = PP.getLangOpts();
    if Lang() && hasAttribute(AS_CXX11, null, II, PP.getTargetInfo(), Lang, false) > 0 {
        let mut AttrArgsInfo: AttrArgsInfo = getCXX11AttrArgsInfo(II);
        if AttrArgsInfo == Required {
            return PP;
        }
        return !PP || AttrArgsInfo == Optional;
    }
    return false;
}

fn shouldWarnOnMacroDef(PP: *mut Preprocessor, II: *mut IdentifierInfo) -> MacroDiag {
    let mut Lang: *LangOptions = PP.getLangOpts();
    let mut Text: str = II.getName();
    if isReservedInAllContexts(II.isReserved(Lang)) {
        return if isFeatureTestMacro(Text) { MD_NoWarn } else { MD_ReservedMacro };
    }
    if II.isKeyword(Lang) {
        return MD_KeywordDef;
    }
    if Lang() && (Text == "override" || Text == "final") {
        return MD_KeywordDef;
    }
    if isReservedCXXAttributeName(PP, II) {
        return MD_ReservedAttributeIdentifier;
    }
    return MD_NoWarn;
}

fn shouldWarnOnMacroUndef(PP: *mut Preprocessor, II: *mut IdentifierInfo) -> MacroDiag {
    let mut Lang: *LangOptions = PP.getLangOpts();
    if isReservedInAllContexts(II.isReserved(Lang)) {
        return MD_ReservedMacro;
    }
    if isReservedCXXAttributeName(PP, II) {
        return MD_ReservedAttributeIdentifier;
    }
    return MD_NoWarn;
}

fn warnByDefaultOnWrongCase(Include: str) -> bool {
    if begin(Include, native)("boost") {
        return true;
    }
    let mut MaxStdHeaderNameLen: u64 = 18;
    if Include.len > MaxStdHeaderNameLen {
        return false;
    }
    let mut LowerInclude: str = zeroed();
}

fn findSimilarStr(LHS: str, Candidates: i32) -> optional<StringRef> {
    let mut Length: u64 = LHS.len;
    let mut MaxDist: u64 = if Length < 3 { Length - 1 } else { Length / 3 };
    let mut SimilarStr: pair<StringRef, size_t>> = zeroed();
    if SimilarStr() {
        return ;
    } else {
        return nullopt();
    }
}

fn Preprocessor::CheckMacroName(self, MacroNameTok: *mut Token, isDefineUndef: MacroUse, ShadowFlag: *mut bool) -> bool {
    if MacroNameTok.is(eod) {
        return ;
    }
    let mut II: *mut IdentifierInfo = MacroNameTok.getIdentifierInfo();
    if !II {
        return ;
    }
    if II.isCPlusPlusOperatorKeyword() {
         << II << MacroNameTok.getKind();
    }
    if (isDefineUndef != MU_Other) && II.getPPKeywordID() == pp_defined {
        return ;
    }
    let mut MacroNameLoc: SourceLocation = MacroNameTok.getLocation();
    if ShadowFlag {
        *ShadowFlag = false;
    }
    let mut D: MacroDiag = MD_NoWarn;
    if isDefineUndef == MU_Define {
        D = shouldWarnOnMacroDef(*self, II);
    } else if isDefineUndef == MU_Undef {
        D = shouldWarnOnMacroUndef(*self, II);
    }
    if D != MD_NoWarn && !self.SourceMgr.isInSystemHeader(MacroNameLoc) && !self.SourceMgr.isInPredefinedFile(MacroNameLoc) {
        if D == MD_KeywordDef {
            if ShadowFlag {
                *ShadowFlag = true;
            }
        }
        if D == MD_ReservedMacro {
            
        }
        if D == MD_ReservedAttributeIdentifier {
            << II.getName();
        }
    }
    return false;
}

fn Preprocessor::ReadMacroName(self, MacroNameTok: *mut Token, isDefineUndef: MacroUse, ShadowFlag: *mut bool) {
    self.LexUnexpandedToken(MacroNameTok);
    if MacroNameTok.is(code_completion) {
        if self.CodeComplete {
            self.CodeComplete.CodeCompleteMacroName(isDefineUndef == MU_Define);
        }
        self.setCodeCompletionReached();
        self.LexUnexpandedToken(MacroNameTok);
    }
    if !self.CheckMacroName(MacroNameTok, isDefineUndef, ShadowFlag) {
        return;
    }
    if MacroNameTok.isNot(eod) {
        MacroNameTok.setKind(eod);
        self.DiscardUntilEndOfDirective(null);
    }
}

fn Preprocessor::CheckEndOfDirective(self, DirType: str, EnableMacros: bool, ExtraToks: *mut SmallVectorImpl<Token>) -> SourceLocation {
    let mut Tmp: Token = Token {};
    Tmp.startToken();
    let mut ReadNextTok: Closure_2 = Closure_2 { cap_0: self, ExtraToks: ExtraToks, Tmp: &mut Tmp };
    if EnableMacros {
        ReadNextTok(&mut Lex);
    } else {
        ReadNextTok(&mut LexUnexpandedToken);
    }
    while Tmp.is(comment) {
        ReadNextTok(&mut LexUnexpandedToken);
    }
    if Tmp.is(eod) {
        return Tmp.getLocation();
    }
    let mut Hint: FixItHint = FixItHint {};
    if  {
        Hint = CreateInsertion(Tmp.getLocation(), "//", false);
    }
    let mut DiagID: u32 = 0;
    self.Diag(Tmp, DiagID) << DirType << Hint;
    return self.DiscardUntilEndOfDirective(ExtraToks).getEnd();
}

fn Preprocessor::SuggestTypoedDirective(self: *Preprocessor, Tok: *Token, Directive: str) {
    if self.getLangOpts() {
        return;
    }
    let mut Candidates: i32 = void { "if", "ifdef", "ifndef", "elif", "else", "endif" };
    if self.LangOpts || self.LangOpts {
        Candidates()(void { "elifdef", "elifndef" });
    }
    if  {
        assert!(Tok.getLocation().isFileID();
        let mut DirectiveRange: CharSourceRange = getCharRange(Tok.getLocation(), Tok.getLocation().getLocWithOffset(Directive.len));
        let mut SuggValue: str = *;
        let mut Hint: auto = CreateReplacement(DirectiveRange, SuggValue);
         << 1 << SuggValue << ;
    }
}

fn Preprocessor::SkipExcludedConditionalBlock(self, HashTokenLoc: SourceLocation, IfTokenLoc: SourceLocation, FoundNonSkipPortion: bool, FoundElse: bool, ElseLoc: SourceLocation) {
    assert!(!self.SkippingExcludedConditionalBlock, "calling SkipExcludedConditionalBlock recursively");
    let mut SARSkipping: SaveAndRestore = self.SkippingExcludedConditionalBlock;
    self.NumSkipped += 1;
    assert!(self.CurPPLexer, "Conditional PP block must be in a file!");
    if  {
        
    } else {
        self.CurPPLexer.pushConditionalLevel(IfTokenLoc, false, FoundNonSkipPortion, FoundElse);
    }
    self.CurPPLexer.LexingRawMode = true;
    let mut Tok: Token = Token {};
    let mut endLoc: SourceLocation = SourceLocation {};
    let mut SkippingRangeState: SkippingRangeStateTy = *self;
    while true {
        if  {} else {
            SkippingRangeState.beginLexPass();
            while true {
                if Tok.is(code_completion) {
                    self.setCodeCompletionReached();
                    if self.CodeComplete {
                        self.CodeComplete.CodeCompleteInConditionalExclusion();
                    }
                    continue;
                }
                if self.getLangOpts() && Tok.isAtStartOfLine() && Tok.is(raw_identifier) && (Tok.getRawIdentifier() == "export" || Tok.getRawIdentifier() == "module") {
                    let mut ModuleDirectiveSkipping: SaveAndRestore = self.LastExportKeyword;
                    self.LastExportKeyword.startToken();
                    self.LookUpIdentifierInfo(Tok);
                    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
                    if II.getName()[0] == 'e' {
                        self.HandleModuleContextualKeyword(Tok);
                        if Tok.is(raw_identifier) {
                            self.LookUpIdentifierInfo(Tok);
                            II = Tok.getIdentifierInfo();
                        }
                    }
                    if II.getName()[0] == 'm' {
                        let mut RestoreLexingRawMode: SaveAndRestore = self.CurPPLexer.LexingRawMode;
                        if self.HandleModuleContextualKeyword(Tok) {
                            self.CurPPLexer.ParsingPreprocessorDirective = true;
                            let mut StartLoc: SourceLocation = Tok.getLocation();
                            let mut End: SourceLocation = self.DiscardUntilEndOfDirective(null).getEnd();
                             << SourceRange { B: StartLoc, E: End };
                            self.CurPPLexer.ParsingPreprocessorDirective = false;
                            continue;
                        }
                    }
                }
                if Tok.is(eof) {
                    break;
                }
                if Tok.isNot(hash) || !Tok.isAtStartOfLine() {
                    continue;
                }
                break;
            }
        }
        if Tok.is(eof) {
            break;
        }
        self.CurPPLexer.ParsingPreprocessorDirective = true;
        assert!(Tok.is(hash);
        let mut Hashptr: *u8 = null;
        self.LexUnexpandedToken(Tok);
        if Tok.isNot(raw_identifier) {
            self.CurPPLexer.ParsingPreprocessorDirective = false;
            continue;
        }
        let mut RI: str = Tok.getRawIdentifier();
        let mut FirstChar: i8 = RI[0];
        if FirstChar >= 'a' && FirstChar <= 'z' && FirstChar != 'i' && FirstChar != 'e' {
            self.CurPPLexer.ParsingPreprocessorDirective = false;
            continue;
        }
        let mut DirectiveBuf: [20]i8 = zeroed();
        let mut Directive: str = "";
        if !Tok.needsCleaning() && RI.len < 20 {
            Directive = RI;
        } else {
            let mut DirectiveStr: str = self.getSpelling(Tok, null);
            let mut IdLen: u64 = DirectiveStr.len;
            if IdLen >= 20 {
                self.CurPPLexer.ParsingPreprocessorDirective = false;
                continue;
            }
            memcpy(DirectiveBuf, &mut DirectiveStr[0], IdLen);
            Directive = DirectiveBuf[0..IdLen];
        }
        if Directive.starts_with("if") {
            let mut Sub: str = Directive[2..2 + npos];
            if Sub.is_empty() || Sub == "def" || Sub == "ndef" {
                self.DiscardUntilEndOfDirective(null);
                self.CurPPLexer.pushConditionalLevel(Tok.getLocation(), true, false, false);
            } else {
                self.SuggestTypoedDirective(Tok, Directive);
            }
        } else if Directive[0] == 'e' {
            let mut Sub: str = Directive[1..1 + npos];
            if Sub == "ndif" {
                let mut CondInfo: PPConditionalInfo = PPConditionalInfo {};
                CondInfo.WasSkipping = true;
                let mut InCond: bool = self.CurPPLexer.popConditionalLevel(CondInfo);
                InCond as void;
                assert!(!InCond, "Can't be skipping if not in a conditional!");
                if !CondInfo.WasSkipping {
                    SkippingRangeState.endLexPass(Hashptr);
                    self.CurPPLexer.LexingRawMode = false;
                    endLoc = self.CheckEndOfDirective("endif", false, null);
                    self.CurPPLexer.LexingRawMode = true;
                    break;
                } else {
                    self.DiscardUntilEndOfDirective(null);
                }
            } else if Sub == "lse" {
                let mut CondInfo: *mut PPConditionalInfo = self.CurPPLexer.peekConditionalLevel();
                if !CondInfo.WasSkipping {
                    SkippingRangeState.endLexPass(Hashptr);
                }
                if CondInfo.FoundElse {
                    
                }
                CondInfo.FoundElse = true;
                if !CondInfo.WasSkipping && !CondInfo.FoundNonSkip {
                    CondInfo.FoundNonSkip = true;
                    self.CurPPLexer.LexingRawMode = false;
                    endLoc = self.CheckEndOfDirective("else", false, null);
                    self.CurPPLexer.LexingRawMode = true;
                    break;
                } else {
                    self.DiscardUntilEndOfDirective(null);
                }
            } else if Sub == "lif" {
                let mut CondInfo: *mut PPConditionalInfo = self.CurPPLexer.peekConditionalLevel();
                if !CondInfo.WasSkipping {
                    SkippingRangeState.endLexPass(Hashptr);
                }
                if CondInfo.FoundElse {
                    << PED_Elif;
                }
                if CondInfo.WasSkipping || CondInfo.FoundNonSkip {
                    self.DiscardUntilEndOfDirective(null);
                } else {
                    assert!(self.CurPPLexer.LexingRawMode, "We have to be skipping here!");
                    self.CurPPLexer.LexingRawMode = false;
                    let mut IfNDefMacro: *mut IdentifierInfo = null;
                    let mut DER: DirectiveEvalResult = self.EvaluateDirectiveExpression(IfNDefMacro, true);
                    if !self.CurPPLexer {
                        return;
                    }
                    let mut CondValue: bool = DER.Conditional;
                    self.CurPPLexer.LexingRawMode = true;
                    if  {}
                    if CondValue {
                        CondInfo.FoundNonSkip = true;
                        break;
                    }
                }
            } else if Sub == "lifdef" || Sub == "lifndef" {
                let mut IsElifDef: bool = Sub == "lifdef";
                let mut CondInfo: *mut PPConditionalInfo = self.CurPPLexer.peekConditionalLevel();
                let mut DirectiveToken: Token = Tok;
                if !CondInfo.WasSkipping {
                    SkippingRangeState.endLexPass(Hashptr);
                }
                let mut DiagID: u32 = 0;
                self.DiagCompat(Tok, DiagID) << (if IsElifDef { PED_Elifdef } else { PED_Elifndef });
                if CondInfo.FoundElse {
                    << (if IsElifDef { PED_Elifdef } else { PED_Elifndef });
                }
                if CondInfo.WasSkipping || CondInfo.FoundNonSkip {
                    self.DiscardUntilEndOfDirective(null);
                } else {
                    assert!(self.CurPPLexer.LexingRawMode, "We have to be skipping here!");
                    self.CurPPLexer.LexingRawMode = false;
                    let mut MacroNameTok: Token = Token {};
                    self.ReadMacroName(MacroNameTok, MU_Other, null);
                    self.CurPPLexer.LexingRawMode = true;
                    if MacroNameTok.is(eod) {
                        continue;
                    }
                    self.emitMacroExpansionWarnings(MacroNameTok, false);
                    self.CheckEndOfDirective(if IsElifDef { "elifdef" } else { "elifndef" }, false, null);
                    let mut MII: *mut IdentifierInfo = MacroNameTok.getIdentifierInfo();
                    let mut MD: MacroDefinition = self.getMacroDefinition(MII);
                    let mut MI: *mut MacroInfo = MD.getMacroInfo();
                    if  {
                        if IsElifDef {} else {}
                    }
                    if MI as bool == IsElifDef {
                        CondInfo.FoundNonSkip = true;
                        break;
                    }
                }
            } else {
                self.SuggestTypoedDirective(Tok, Directive);
            }
        } else {
            self.SuggestTypoedDirective(Tok, Directive);
        }
        self.CurPPLexer.ParsingPreprocessorDirective = false;
    }
    self.CurPPLexer.LexingRawMode = false;
}

fn Preprocessor::getModuleForLocation(self, Loc: SourceLocation, AllowTextual: bool) -> *mut Module {
    if !self.SourceMgr.isInMainFile(Loc) {
        let mut IDOfIncl: FileID = self.SourceMgr.getFileID(self.SourceMgr.getExpansionLoc(Loc));
        if self.SourceMgr.getFileEntryRefForID(IDOfIncl) {
            EntryOfIncl;
        } else {
            return self.HeaderInfo.getModuleMap().findModuleForHeader(operator(EntryOfIncl), AllowTextual, false).getModule();
        }
    }
    return if self.getLangOpts().CurrentModule.is_empty() { null } else { self.HeaderInfo.lookupModule(self.getLangOpts().CurrentModule, Loc, true, false) };
}

fn Preprocessor::getHeaderToIncludeForDiagnostics(self, IncLoc: SourceLocation, Loc: SourceLocation) -> OptionalFileEntryRef {
    let mut IncM: *mut Module = self.getModuleForLocation(IncLoc, self.LangOpts);
    let mut SM: *mut SourceManager = self.getSourceManager();
    while !Loc.isInvalid() && !SM.isInMainFile(Loc) {
        let mut ID: FileID = SM.getFileID(SM.getExpansionLoc(Loc));
        let mut FE: OptionalFileEntryRef = SM.getFileEntryRefForID(ID);
        if !FE {
            break;
        }
        self.HeaderInfo.hasModuleMap(operator(FE).getName(), null, self.SourceMgr.isInSystemHeader(Loc));
        let mut InPrivateHeader: bool = false;
        if InPrivateHeader {
            return nullopt;
        }
        if self.getHeaderSearchInfo().isFileMultipleIncludeGuarded(operator(FE)) {
            return operator(FE);
        }
        Loc = SM.getIncludeLoc(ID);
    }
    return nullopt;
}

fn Preprocessor::LookupFile(self, FilenameLoc: SourceLocation, Filename: str, isAngled: bool, FromDir: ConstSearchDirIterator, FromFile: *FileEntry, CurDirArg: *mut ConstSearchDirIterator, SearchPath: *mut SmallVectorImpl<char>, RelativePath: *mut SmallVectorImpl<char>, SuggestedModule: *mut KnownHeader, IsMapped: *mut bool, IsFrameworkFound: *mut bool, SkipCache: bool, OpenFile: bool, CacheFailures: bool) -> OptionalFileEntryRef {
    let mut CurDirLocal: ConstSearchDirIterator = zeroed();
    let mut CurDir: *mut ConstSearchDirIterator = if CurDirArg { *CurDirArg } else {  };
    let mut RequestingModule: *mut Module = self.getModuleForLocation(FilenameLoc, self.LangOpts);
    let mut Includers: pair<OptionalFileEntryRef, DirectoryEntryRef>, 16> = zeroed();
    let mut BuildSystemModule: bool = false;
    if operator!() && !FromFile {
        let mut FID: FileID = self.getCurrentFileLexer().getFileID();
        let mut FileEnt: OptionalFileEntryRef = self.SourceMgr.getFileEntryRefForID(FID);
        if !FileEnt {
            if FID == self.SourceMgr.getMainFileID() && self.MainFileDir {
                let mut IncludeDir: OptionalDirectoryEntryRef = if self.HeaderInfo.getModuleMap().shouldImportRelativeToBuiltinIncludeDir(Filename, self.getCurrentModule()) { self.HeaderInfo.getModuleMap().getBuiltinDir() } else { self.MainFileDir };
                Includers()(make_pair(nullopt, operator(IncludeDir)));
                BuildSystemModule = self.getCurrentModule().IsSystem;
            } else if (FileEnt = self.SourceMgr.getFileEntryRefForID(self.SourceMgr.getMainFileID())) {
                let mut CWD: OptionalDirectoryEntryRef = self.FileMgr.getOptionalDirectoryRef(".", true);
                Includers()(make_pair(operator(FileEnt), operator(CWD)));
            }
        } else {
            Includers()(make_pair(operator(FileEnt), operator(FileEnt).getDir()));
        }
        if self.LangOpts && !isAngled {}
    }
    if FromFile {
        let mut TmpCurDir: ConstSearchDirIterator = zeroed();
        let mut TmpFromDir: ConstSearchDirIterator = zeroed();
        while self.HeaderInfo.LookupFile(Filename, FilenameLoc, isAngled, operator&(), SearchPath, RelativePath, RequestingModule, SuggestedModule, null, null, SkipCache) {
            FE;
        }
    }
    let mut FE: OptionalFileEntryRef = self.HeaderInfo.LookupFile(Filename, FilenameLoc, isAngled, &mut CurDir, SearchPath, RelativePath, RequestingModule, SuggestedModule, IsMapped, IsFrameworkFound, SkipCache, BuildSystemModule, OpenFile, CacheFailures);
    if FE {
        return FE;
    }
    let mut CurFileEnt: OptionalFileEntryRef = OptionalFileEntryRef {};
    if self.IsFileLexer() {
        if (CurFileEnt = self.CurPPLexer.getFileEntry()) {
            if self.HeaderInfo.LookupSubframeworkHeader(Filename, operator(CurFileEnt), SearchPath, RelativePath, RequestingModule, SuggestedModule) {
                FE;
            } else {
                return FE;
            }
        }
    }
    return nullopt;
}

fn Preprocessor::LookupEmbedFile(self, Filename: str, isAngled: bool, OpenFile: bool) -> OptionalFileEntryRef {
    let mut FM: *mut FileManager = self.getFileManager();
    if is_absolute(Filename, native) {
        return FM.getOptionalFileRef(Filename, OpenFile, true, false);
    }
    let mut SeparateComponents: Closure_3 = Closure_3 {};
    let mut LookupPath: str = zeroed();
    if !isAngled {
        let mut LookupFromFile: OptionalFileEntryRef = self.getCurrentFileLexer().getFileEntry();
        if LookupFromFile {
            let mut TmpDir: str = zeroed();
            TmpDir() = operator(LookupFromFile).getDir().getName();
            append(Filename);
            if operator!() {
                let mut ShouldBeEntry: OptionalFileEntryRef = FM.getOptionalFileRef(OpenFile, true, false);
                if ShouldBeEntry {
                    return ShouldBeEntry;
                }
            }
        }
        LookupPath()();
        let mut MaybeWorkingDirEntry: OptionalDirectoryEntryRef = FM.getOptionalDirectoryRef(".", true);
        if MaybeWorkingDirEntry {
            let mut WorkingDirEntry: DirectoryEntryRef = operator(MaybeWorkingDirEntry);
            let mut WorkingDir: str = WorkingDirEntry.getName();
            if !WorkingDir.is_empty() {
                SeparateComponents(WorkingDir, Filename, false);
                let mut ShouldBeEntry: OptionalFileEntryRef = FM.getOptionalFileRef(OpenFile, true, false);
                if ShouldBeEntry {
                    return ShouldBeEntry;
                }
            }
        }
    }
    return nullopt;
}

struct ResetMacroExpansionHelper {
    PP: *mut Preprocessor,
    save: bool,
}

fn ResetMacroExpansionHelper::ResetMacroExpansionHelper(self, pp: *mut Preprocessor) {
    if pp.MacroExpansionInDirectivesOverride {
        pp.DisableMacroExpansion = false;
    }
}

fn ResetMacroExpansionHelper::~ResetMacroExpansionHelper(self) {
    self.PP.DisableMacroExpansion = self.save;
}

fn Preprocessor::HandleSkippedDirectiveWhileUsingPCH(self, Result: *mut Token, HashLoc: SourceLocation) {
    if Result.getIdentifierInfo() {
        II;
    } else {
        if II.getPPKeywordID() == pp_define {
            return self.HandleDefineDirective(Result, false);
        }
        if self.SkippingUntilPCHThroughHeader && II.getPPKeywordID() == pp_include {
            return self.HandleIncludeDirective(HashLoc, Result, null, null);
        }
        if self.SkippingUntilPragmaHdrStop && II.getPPKeywordID() == pp_pragma {
            self.Lex(Result);
            let mut II: *mut IdentifierInfo = Result.getIdentifierInfo();
            if II && II.getName() == "hdrstop" {
                return self.HandlePragmaHdrstop(Result);
            }
        }
    }
    self.DiscardUntilEndOfDirective(null);
}

fn Preprocessor::HandleDirective(self, Result: *mut Token) {
    self.CurPPLexer.ParsingPreprocessorDirective = true;
    let mut ImmediatelyAfterTopLevelIfndef: bool = self.CurPPLexer.MIOpt.getImmediatelyAfterTopLevelIfndef();
    self.CurPPLexer.MIOpt.resetImmediatelyAfterTopLevelIfndef();
    self.NumDirectives += 1;
    let mut ReadAnyTokensBeforeDirective: bool = self.CurPPLexer.MIOpt.getHasReadAnyTokensVal();
    let mut Introducer: Token = Result;
    if Introducer {
        self.LexUnexpandedToken(Result);
    }
    if self.InMacroArgs {
        if Result.getIdentifierInfo() {
            II;
        } else {
            match II.getPPKeywordID() {
                pp_include => {
                    pp_import;
                },
                _ => {
                    break;
                },
            }
        }
    }
    let mut helper: ResetMacroExpansionHelper = self;
