            self.Diag(FilenameTok.getLocation(), note_implicit_top_level_module_import_here) << ModuleToImport.getTopLevelModuleName();
            return ImportAction { None, null };
        }
        let mut Path: SmallVector<IdentifierLoc, 2> = SmallVector<IdentifierLoc, 2> {};
