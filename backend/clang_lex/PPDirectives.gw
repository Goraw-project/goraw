            self.Diag(FilenameTok, DiagId) << Path << CreateReplacement(FilenameRange, Path.operator StringRef());
        }
        let mut SuppressBackslashDiag: bool = self.Diags.isIgnored(pp_nonportable_path_separator, FilenameLoc) || FilenameLoc.isMacroID() || self.SourceMgr.isWrittenInBuiltinFile(FilenameLoc) || self.SourceMgr.isWrittenInModuleIncludes(FilenameLoc);
        if !SuppressBackslashDiag && OriginalFilename.contains('\') {
            let mut SuggestedPath: str = OriginalFilename;
