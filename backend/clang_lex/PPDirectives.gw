    }

struct Closure_3 {}

fn Closure_3::call(self: *Closure_3, LookupPath: *mut SmallVectorImpl<char>, StartingFrom: str, FileName: str, RemoveInitialFileComponentFromLookupPath: bool) {
        native(StartingFrom, LookupPath, native);
        if RemoveInitialFileComponentFromLookupPath {
            remove_filename(LookupPath, native);
        }
        if !LookupPath.is_empty() && !is_separator(LookupPath.back(), native) {
            LookupPath.push(get_separator(native).front());
        }
        LookupPath.append(FileName.begin(), FileName.end());
    }

