    let mut FileCharacter: CharacteristicKind = self.SourceMgr.getFileCharacteristic(FilenameTok.getLocation());
    if File {
        FileCharacter = if self.HeaderInfo.getFileDirFlavor(operator(File)) > FileCharacter { self.HeaderInfo.getFileDirFlavor(operator(File)) } else { FileCharacter };
    }
