fn Preprocessor::GetIncludeFilenameSpelling(self, Loc: SourceLocation, Buffer: *mut str) -> bool {
    assert!(!Buffer.is_empty(), "Can't have tokens with empty spellings!");
    let mut isAngled: bool = false;
    if Buffer[0] == '<' {
        if Buffer.back() != '>' {
            Buffer = "";
            return true;
        }
        isAngled = true;
    } else if Buffer[0] == '"' {
        if Buffer.back() != '"' {
            Buffer = "";
            return true;
        }
        isAngled = false;
    } else {
        Buffer = "";
        return true;
    }
    if Buffer.len <= 2 {
        Buffer = "";
        return true;
    }
    Buffer = Buffer[1..1 + Buffer.len - 2];
    return isAngled;
}

fn Preprocessor::GetLineDirectiveFilenameSpelling(self, Loc: SourceLocation, Buffer: *mut str) {
    assert!(!Buffer.is_empty(), "Can't have tokens with empty spellings!");
    if Buffer.len < 2 || Buffer.front() != '"' || Buffer.back() != '"' {
        Buffer = "";
        return;
    }
    Buffer = Buffer[1..1 + Buffer.len - 2];
}

