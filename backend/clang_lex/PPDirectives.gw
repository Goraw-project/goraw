// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn Preprocessor::AllocateMacroInfo(self, L: SourceLocation) -> *mut MacroInfo {}

fn Preprocessor::AllocateDefMacroDirective(self, MI: *mut MacroInfo, Loc: SourceLocation) -> *mut DefMacroDirective {}

fn Preprocessor::AllocateUndefMacroDirective(self, UndefLoc: SourceLocation) -> *mut UndefMacroDirective {}

