fn isConfigurationPattern(MacroName: *mut Token, MI: *mut MacroInfo, LOptions: *LangOptions) -> bool {
    if MI.getNumTokens() == 1 {
        let mut Value: *Token = MI.getReplacementToken(0);
        if MacroName.getKind() == Value.getKind() {
            return true;
        }
        let mut MacroText: str = MacroName.getIdentifierInfo().getName();
        if Value.getIdentifierInfo() {
            II;
        } else {
            if !II.isKeyword(LOptions) {
                return false;
            }
            let mut ValueText: str = II.getName();
            let mut TrimmedValue: str = ValueText;
            if !ValueText.starts_with("__") {
                if ValueText.starts_with("_") {
                    TrimmedValue = TrimmedValue.drop_front(1);
                } else {
                    return false;
                }
            } else {
                TrimmedValue = TrimmedValue.drop_front(2);
                if TrimmedValue.ends_with("__") {
                    TrimmedValue = TrimmedValue.drop_back(2);
                }
            }
            return TrimmedValue == MacroText;
        }
    }
    return MacroName && MI.getNumTokens() == 0;
}

