// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn Preprocessor::AllocateMacroInfo(self, L: SourceLocation) -> *mut MacroInfo {
    return L;
}

fn Preprocessor::AllocateDefMacroDirective(self, MI: *mut MacroInfo, Loc: SourceLocation) -> *mut DefMacroDirective {
    return DefMacroDirective { MI, Loc };
}

fn Preprocessor::AllocateUndefMacroDirective(self, UndefLoc: SourceLocation) -> *mut UndefMacroDirective {
    return UndefLoc;
}

fn Preprocessor::AllocateVisibilityMacroDirective(self, Loc: SourceLocation, isPublic: bool) -> *mut VisibilityMacroDirective {
    return VisibilityMacroDirective { Loc, isPublic };
}

fn Preprocessor::DiscardUntilEndOfDirective(self, Tmp: *mut Token, DiscardedToks: *mut SmallVectorImpl<Token>) -> SourceRange {
    let mut Res: SourceRange = SourceRange {};
    let mut ReadNextTok: Closure_1 = Closure_1 { cap_0: self, Tmp: &mut Tmp, DiscardedToks: &mut DiscardedToks };
    ReadNextTok.call();
    Res.setBegin(Tmp.getLocation());
    while Tmp.isNot(eod) {
        assert!(Tmp.isNot(eof), "EOF seen while discarding directive tokens");
        ReadNextTok.call();
    }
    Res.setEnd(Tmp.getLocation());
    return Res;
}

enum MacroDiag {
    MD_NoWarn = 0,
    MD_KeywordDef = 1,
    MD_ReservedMacro = 2,
    MD_ReservedAttributeIdentifier = 3,
}

enum PPElifDiag {
    PED_Elif = 0,
    PED_Elifdef = 1,
    PED_Elifndef = 2,
}

fn isFeatureTestMacro(MacroName: str) -> bool {
    let mut ReservedMacro: [29]str = ["_ATFILE_SOURCE", "_BSD_SOURCE", "_CRT_NONSTDC_NO_WARNINGS", "_CRT_SECURE_CPP_OVERLOAD_STANDARD_NAMES", "_CRT_SECURE_NO_WARNINGS", "_FILE_OFFSET_BITS", "_FORTIFY_SOURCE", "_GLIBCXX_ASSERTIONS", "_GLIBCXX_CONCEPT_CHECKS", "_GLIBCXX_DEBUG", "_GLIBCXX_DEBUG_PEDANTIC", "_GLIBCXX_PARALLEL", "_GLIBCXX_PARALLEL_ASSERTIONS", "_GLIBCXX_SANITIZE_VECTOR", "_GLIBCXX_USE_CXX11_ABI", "_GLIBCXX_USE_DEPRECATED", "_GNU_SOURCE", "_ISOC11_SOURCE", "_ISOC95_SOURCE", "_ISOC99_SOURCE", "_LARGEFILE64_SOURCE", "_POSIX_C_SOURCE", "_REENTRANT", "_SVID_SOURCE", "_THREAD_SAFE", "_XOPEN_SOURCE", "_XOPEN_SOURCE_EXTENDED", "__STDCPP_WANT_MATH_SPEC_FUNCS__", "__STDC_FORMAT_MACROS"];
    return binary_search(ReservedMacro, MacroName);
}

fn isLanguageDefinedBuiltin(SourceMgr: *SourceManager, MI: *MacroInfo, MacroName: str) -> bool {
    if MI.isBuiltinMacro() {
        return true;
    }
    if !SourceMgr.isWrittenInBuiltinFile(MI.getDefinitionLoc()) {
        return false;
    }
    if MacroName.starts_with("__STDC") {
        return true;
    }
    if MacroName == "__cplusplus" {
        return true;
    }
    if MacroName.starts_with("__cpp") {
        return true;
    }
    return false;
}

fn isReservedCXXAttributeName(PP: *mut Preprocessor, II: *mut IdentifierInfo) -> bool {
    let mut Lang: *LangOptions = PP.getLangOpts();
    if Lang.CPlusPlus && hasAttribute(AS_CXX11, null, II, PP.getTargetInfo(), Lang, false) > 0 {
        let mut AttrArgsInfo: AttrArgsInfo = getCXX11AttrArgsInfo(II);
        if AttrArgsInfo == Required {
            return PP.isNextPPTokenOneOf(l_paren);
        }
        return !PP.isNextPPTokenOneOf(l_paren) || AttrArgsInfo == Optional;
    }
    return false;
}

fn shouldWarnOnMacroDef(PP: *mut Preprocessor, II: *mut IdentifierInfo) -> MacroDiag {
    let mut Lang: *LangOptions = PP.getLangOpts();
    let mut Text: str = II.getName();
    if isReservedInAllContexts(II.isReserved(Lang)) {
        return if isFeatureTestMacro(Text) { MD_NoWarn } else { MD_ReservedMacro };
    }
    if II.isKeyword(Lang) {
        return MD_KeywordDef;
    }
    if Lang.CPlusPlus11 && (Text == "override" || Text == "final") {
        return MD_KeywordDef;
    }
    if isReservedCXXAttributeName(PP, II) {
        return MD_ReservedAttributeIdentifier;
    }
    return MD_NoWarn;
}

fn shouldWarnOnMacroUndef(PP: *mut Preprocessor, II: *mut IdentifierInfo) -> MacroDiag {
    let mut Lang: *LangOptions = PP.getLangOpts();
    if isReservedInAllContexts(II.isReserved(Lang)) {
        return MD_ReservedMacro;
    }
    if isReservedCXXAttributeName(PP, II) {
        return MD_ReservedAttributeIdentifier;
    }
    return MD_NoWarn;
}

fn warnByDefaultOnWrongCase(Include: str) -> bool {
    if operator(operator(begin(Include, native))).equals_insensitive("boost") {
        return true;
    }
    let mut MaxStdHeaderNameLen: u64 = 18;
    if Include.len > MaxStdHeaderNameLen {
        return false;
    }
    let mut LowerInclude: str = [Include];
    for Ch in LowerInclude {
        if Ch as u8 > 127 {
            return false;
        }
        if Ch >= 'A' && Ch <= 'Z' {
            Ch += 'a' - 'A';
        } else if is_separator(Ch, native) {
            Ch = '/';
        }
    }
    return LowerInclude.operator StringRef().Cases(["assert.h", "complex.h", "ctype.h", "errno.h", "fenv.h"], true).Cases(["float.h", "inttypes.h", "iso646.h", "limits.h", "locale.h"], true).Cases(["math.h", "setjmp.h", "signal.h", "stdalign.h", "stdarg.h"], true).Cases(["stdatomic.h", "stdbool.h", "stdckdint.h", "stdcountof.h"], true).Cases(["stddef.h", "stdint.h", "stdio.h", "stdlib.h", "stdnoreturn.h"], true).Cases(["string.h", "tgmath.h", "threads.h", "time.h", "uchar.h"], true).Cases(["wchar.h", "wctype.h"], true).Cases(["cassert", "ccomplex", "cctype", "cerrno", "cfenv"], true).Cases(["cfloat", "cinttypes", "ciso646", "climits", "clocale"], true).Cases(["cmath", "csetjmp", "csignal", "cstdalign", "cstdarg"], true).Cases(["cstdbool", "cstddef", "cstdint", "cstdio", "cstdlib"], true).Cases(["cstring", "ctgmath", "ctime", "cuchar", "cwchar"], true).Case("cwctype", true).Cases(["algorithm", "fstream", "list", "regex", "thread"], true).Cases(["array", "functional", "locale", "scoped_allocator", "tuple"], true).Cases(["atomic", "future", "map", "set", "type_traits"], true).Cases(["bitset", "initializer_list", "memory", "shared_mutex", "typeindex"], true).Cases(["chrono", "iomanip", "mutex", "sstream", "typeinfo"], true).Cases(["codecvt", "ios", "new", "stack", "unordered_map"], true).Cases(["complex", "iosfwd", "numeric", "stdexcept", "unordered_set"], true).Cases(["condition_variable", "iostream", "ostream", "streambuf", "utility"], true).Cases(["deque", "istream", "queue", "string", "valarray"], true).Cases(["exception", "iterator", "random", "strstream", "vector"], true).Cases(["forward_list", "limits", "ratio", "system_error"], true).Cases(["aio.h", "arpa/inet.h", "cpio.h", "dirent.h", "dlfcn.h"], true).Cases(["fcntl.h", "fmtmsg.h", "fnmatch.h", "ftw.h", "glob.h"], true).Cases(["grp.h", "iconv.h", "langinfo.h", "libgen.h", "monetary.h"], true).Cases(["mqueue.h", "ndbm.h", "net/if.h", "netdb.h", "netinet/in.h"], true).Cases(["netinet/tcp.h", "nl_types.h", "poll.h", "pthread.h", "pwd.h"], true).Cases(["regex.h", "sched.h", "search.h", "semaphore.h", "spawn.h"], true).Cases(["strings.h", "stropts.h", "sys/ipc.h", "sys/mman.h", "sys/msg.h"], true).Cases(["sys/resource.h", "sys/select.h", "sys/sem.h", "sys/shm.h", "sys/socket.h"], true).Cases(["sys/stat.h", "sys/statvfs.h", "sys/time.h", "sys/times.h", "sys/types.h"], true).Cases(["sys/uio.h", "sys/un.h", "sys/utsname.h", "sys/wait.h", "syslog.h"], true).Cases(["tar.h", "termios.h", "trace.h", "ulimit.h"], true).Cases(["unistd.h", "utime.h", "utmpx.h", "wordexp.h"], true).Default(false);
}

fn findSimilarStr(LHS: str, Candidates: *[]str) -> optional<StringRef> {
    for C in Candidates {
        if LHS.equals_insensitive(C) {
            return C;
        }
    }
    let mut Length: u64 = LHS.len;
    let mut MaxDist: u64 = if Length < 3 { Length - 1 } else { Length / 3 };
    let mut SimilarStr: pair<StringRef, size_t>> = pair<StringRef, size_t>> {};
    for C in Candidates {
        let mut CurDist: u64 = LHS.edit_distance(C, true, 0);
        if CurDist <= MaxDist {
            if !SimilarStr {
                SimilarStr = StringRef, unsigned long long> { C, CurDist };
            } else if CurDist < operator(SimilarStr).second {
                SimilarStr = StringRef, unsigned long long> { C, CurDist };
            }
        }
    }
    if SimilarStr {
        return operator(SimilarStr).first;
    } else {
        return nullopt;
    }
}

fn Preprocessor::CheckMacroName(self, MacroNameTok: *mut Token, isDefineUndef: MacroUse, ShadowFlag: *mut bool) -> bool {
    if MacroNameTok.is(eod) {
        return self.Diag(MacroNameTok, err_pp_missing_macro_name);
    }
    let mut II: *mut IdentifierInfo = MacroNameTok.getIdentifierInfo();
    if !II {
        return self.Diag(MacroNameTok, err_pp_macro_not_identifier);
    }
    if II.isCPlusPlusOperatorKeyword() {
        self.Diag(MacroNameTok, if self.getLangOpts().MicrosoftExt { ext_pp_operator_used_as_macro_name } else { err_pp_operator_used_as_macro_name }) << II << MacroNameTok.getKind();
    }
    if (isDefineUndef != MU_Other) && II.getPPKeywordID() == pp_defined {
        return self.Diag(MacroNameTok, err_defined_macro_name);
    }
    let mut MacroNameLoc: SourceLocation = MacroNameTok.getLocation();
    if ShadowFlag {
        *ShadowFlag = false;
    }
    let mut D: MacroDiag = MD_NoWarn;
    if isDefineUndef == MU_Define {
        D = shouldWarnOnMacroDef(*self, II);
    } else if isDefineUndef == MU_Undef {
        D = shouldWarnOnMacroUndef(*self, II);
    }
    if D != MD_NoWarn && !self.SourceMgr.isInSystemHeader(MacroNameLoc) && !self.SourceMgr.isInPredefinedFile(MacroNameLoc) {
        if D == MD_KeywordDef {
            if ShadowFlag {
                *ShadowFlag = true;
            }
        }
        if D == MD_ReservedMacro {
            self.Diag(MacroNameTok, warn_pp_macro_is_reserved_id);
        }
        if D == MD_ReservedAttributeIdentifier {
            self.Diag(MacroNameTok, warn_pp_macro_is_reserved_attribute_id) << II.getName();
        }
    }
    return false;
}

fn Preprocessor::ReadMacroName(self, MacroNameTok: *mut Token, isDefineUndef: MacroUse, ShadowFlag: *mut bool) {
    self.LexUnexpandedToken(MacroNameTok);
    if MacroNameTok.is(code_completion) {
        if self.CodeComplete {
            self.CodeComplete.CodeCompleteMacroName(isDefineUndef == MU_Define);
        }
        self.setCodeCompletionReached();
        self.LexUnexpandedToken(MacroNameTok);
    }
    if !self.CheckMacroName(MacroNameTok, isDefineUndef, ShadowFlag) {
        return;
    }
    if MacroNameTok.isNot(eod) {
        MacroNameTok.setKind(eod);
        self.DiscardUntilEndOfDirective(null);
    }
}

fn Preprocessor::CheckEndOfDirective(self, DirType: str, EnableMacros: bool, ExtraToks: *mut SmallVectorImpl<Token>) -> SourceLocation {
    let mut Tmp: Token = Token {};
    Tmp.startToken();
    let mut ReadNextTok: Closure_2 = Closure_2 { cap_0: self, ExtraToks: ExtraToks, Tmp: &mut Tmp };
    if EnableMacros {
        ReadNextTok.call(&mut Lex);
    } else {
        ReadNextTok.call(&mut LexUnexpandedToken);
    }
    while Tmp.is(comment) {
        ReadNextTok.call(&mut LexUnexpandedToken);
    }
    if Tmp.is(eod) {
        return Tmp.getLocation();
    }
    let mut Hint: FixItHint = FixItHint {};
    if (self.LangOpts.GNUMode || self.LangOpts.C99 || self.LangOpts.CPlusPlus) && !self.CurTokenLexer {
        Hint = CreateInsertion(Tmp.getLocation(), "//", false);
    }
    let mut DiagID: u32 = ext_pp_extra_tokens_at_eol;
    if self.getLangOpts().CPlusPlusModules && (DirType == "import" || DirType == "module") {
        DiagID = warn_pp_extra_tokens_at_module_directive_eol;
    }
    self.Diag(Tmp, DiagID) << DirType << Hint;
    return self.DiscardUntilEndOfDirective(ExtraToks).getEnd();
}

fn Preprocessor::SuggestTypoedDirective(self: *Preprocessor, Tok: *Token, Directive: str) {
    if self.getLangOpts().AsmPreprocessor {
        return;
    }
    let mut Candidates: []str = []str { ["if", "ifdef", "ifndef", "elif", "else", "endif"], StringRef> {} };
    if self.LangOpts.C23 || self.LangOpts.CPlusPlus23 {
        Candidates.insert(Candidates.end(), ["elifdef", "elifndef"]);
    }
    if findSimilarStr(Directive, Candidates) {
        Sugg;
    } else {
        assert!(Tok.getLocation().isFileID();
        let mut DirectiveRange: CharSourceRange = getCharRange(Tok.getLocation(), Tok.getLocation().getLocWithOffset(Directive.len));
        let mut SuggValue: str = operator(Sugg);
        let mut Hint: FixItHint = CreateReplacement(DirectiveRange, SuggValue);
        self.Diag(Tok, warn_pp_invalid_directive) << 1 << SuggValue << Hint;
    }
}

fn Preprocessor::SkipExcludedConditionalBlock(self, HashTokenLoc: SourceLocation, IfTokenLoc: SourceLocation, FoundNonSkipPortion: bool, FoundElse: bool, ElseLoc: SourceLocation) {
    assert!(!self.SkippingExcludedConditionalBlock, "calling SkipExcludedConditionalBlock recursively");
    let mut SARSkipping: SaveAndRestore<bool> = SaveAndRestore<bool> { self.SkippingExcludedConditionalBlock, true };
    self.NumSkipped += 1;
    assert!(!self.CurTokenLexer, "Conditional PP block cannot appear in a macro!");
    assert!(self.CurPPLexer, "Conditional PP block must be in a file!");
    assert!(self.CurLexer, "Conditional PP block but no current lexer set!");
    if self.PreambleConditionalStack.reachedEOFWhileSkipping() {
        self.PreambleConditionalStack.clearSkipInfo();
    } else {
        self.CurPPLexer.pushConditionalLevel(IfTokenLoc, false, FoundNonSkipPortion, FoundElse);
    }
    self.CurPPLexer.LexingRawMode = true;
    let mut Tok: Token = Token {};
    let mut endLoc: SourceLocation = SourceLocation {};
    let mut SkippingRangeState: SkippingRangeStateTy = *self;
    while true {
        if operator(self.CurLexer).isDependencyDirectivesLexer() {
            operator(self.CurLexer).LexDependencyDirectiveTokenWhileSkipping(Tok);
        } else {
            SkippingRangeState.beginLexPass();
            while true {
                operator(self.CurLexer).Lex(Tok);
                if Tok.is(code_completion) {
                    self.setCodeCompletionReached();
                    if self.CodeComplete {
                        self.CodeComplete.CodeCompleteInConditionalExclusion();
                    }
                    continue;
                }
                if self.getLangOpts().CPlusPlusModules && Tok.isAtStartOfLine() && Tok.is(raw_identifier) && (Tok.getRawIdentifier() == "export" || Tok.getRawIdentifier() == "module") {
                    let mut ModuleDirectiveSkipping: Token> = self.LastExportKeyword;
                    self.LastExportKeyword.startToken();
                    self.LookUpIdentifierInfo(Tok);
                    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
                    if II.getName()[0] == 'e' {
                        self.HandleModuleContextualKeyword(Tok);
                        operator(self.CurLexer).Lex(Tok);
                        if Tok.is(raw_identifier) {
                            self.LookUpIdentifierInfo(Tok);
                            II = Tok.getIdentifierInfo();
                        }
                    }
                    if II.getName()[0] == 'm' {
                        let mut RestoreLexingRawMode: SaveAndRestore<bool> = SaveAndRestore<bool> { self.CurPPLexer.LexingRawMode, false };
                        if self.HandleModuleContextualKeyword(Tok) {
                            self.CurPPLexer.ParsingPreprocessorDirective = true;
                            let mut StartLoc: SourceLocation = Tok.getLocation();
                            let mut End: SourceLocation = self.DiscardUntilEndOfDirective(null).getEnd();
                            self.Diag(StartLoc, err_pp_cond_span_module_decl) << SourceRange { B: StartLoc, E: End };
                            self.CurPPLexer.ParsingPreprocessorDirective = false;
                            if self.CurLexer {
                                operator(self.CurLexer).resetExtendedTokenMode();
                            }
                            continue;
                        }
                    }
                }
                if Tok.is(eof) {
                    if self.PreambleConditionalStack.isRecording() {
                        self.PreambleConditionalStack.SkipInfo.emplace(HashTokenLoc, IfTokenLoc, FoundNonSkipPortion, FoundElse, ElseLoc);
                    }
                    break;
                }
                if Tok.isNot(hash) || !Tok.isAtStartOfLine() {
                    continue;
                }
                break;
            }
        }
        if Tok.is(eof) {
            break;
        }
        self.CurPPLexer.ParsingPreprocessorDirective = true;
        if self.CurLexer {
            operator(self.CurLexer).SetKeepWhitespaceMode(false);
        }
        assert!(Tok.is(hash);
        let mut Hashptr: *u8 = operator(self.CurLexer).getBufferLocation() - Tok.getLength();
        assert!(operator(self.CurLexer).getSourceLocation(Hashptr, 1) == Tok.getLocation();
        self.LexUnexpandedToken(Tok);
        if Tok.isNot(raw_identifier) {
            self.CurPPLexer.ParsingPreprocessorDirective = false;
            if self.CurLexer {
                operator(self.CurLexer).resetExtendedTokenMode();
            }
            continue;
        }
        let mut RI: str = Tok.getRawIdentifier();
        let mut FirstChar: i8 = RI[0];
        if FirstChar >= 'a' && FirstChar <= 'z' && FirstChar != 'i' && FirstChar != 'e' {
            self.CurPPLexer.ParsingPreprocessorDirective = false;
            if self.CurLexer {
                operator(self.CurLexer).resetExtendedTokenMode();
            }
            continue;
        }
        let mut DirectiveBuf: [20]i8 = zeroed();
        let mut Directive: str = "";
        if !Tok.needsCleaning() && RI.len < 20 {
            Directive = RI;
        } else {
            let mut DirectiveStr: str = self.getSpelling(Tok, null);
            let mut IdLen: u64 = DirectiveStr.len;
            if IdLen >= 20 {
                self.CurPPLexer.ParsingPreprocessorDirective = false;
                if self.CurLexer {
                    operator(self.CurLexer).resetExtendedTokenMode();
                }
                continue;
            }
            memcpy(DirectiveBuf, &mut DirectiveStr[0], IdLen);
            Directive = DirectiveBuf[0..IdLen];
        }
        if Directive.starts_with("if") {
            let mut Sub: str = Directive[2..2 + npos];
            if Sub.is_empty() || Sub == "def" || Sub == "ndef" {
                self.DiscardUntilEndOfDirective(null);
                self.CurPPLexer.pushConditionalLevel(Tok.getLocation(), true, false, false);
            } else {
                self.SuggestTypoedDirective(Tok, Directive);
            }
        } else if Directive[0] == 'e' {
            let mut Sub: str = Directive[1..1 + npos];
            if Sub == "ndif" {
                let mut CondInfo: PPConditionalInfo = PPConditionalInfo {};
                CondInfo.WasSkipping = true;
                let mut InCond: bool = self.CurPPLexer.popConditionalLevel(CondInfo);
                InCond as void;
                assert!(!InCond, "Can't be skipping if not in a conditional!");
                if !CondInfo.WasSkipping {
                    SkippingRangeState.endLexPass(Hashptr);
                    self.CurPPLexer.LexingRawMode = false;
                    endLoc = self.CheckEndOfDirective("endif", false, null);
                    self.CurPPLexer.LexingRawMode = true;
                    if self.Callbacks {
                        operator(self.Callbacks).Endif(Tok.getLocation(), CondInfo.IfLoc);
                    }
                    break;
                } else {
                    self.DiscardUntilEndOfDirective(null);
                }
            } else if Sub == "lse" {
                let mut CondInfo: *mut PPConditionalInfo = self.CurPPLexer.peekConditionalLevel();
                if !CondInfo.WasSkipping {
                    SkippingRangeState.endLexPass(Hashptr);
                }
                if CondInfo.FoundElse {
                    self.Diag(Tok, pp_err_else_after_else);
                }
                CondInfo.FoundElse = true;
                if !CondInfo.WasSkipping && !CondInfo.FoundNonSkip {
                    CondInfo.FoundNonSkip = true;
                    self.CurPPLexer.LexingRawMode = false;
                    endLoc = self.CheckEndOfDirective("else", false, null);
                    self.CurPPLexer.LexingRawMode = true;
                    if self.Callbacks {
                        operator(self.Callbacks).Else(Tok.getLocation(), CondInfo.IfLoc);
                    }
                    break;
                } else {
                    self.DiscardUntilEndOfDirective(null);
                }
            } else if Sub == "lif" {
                let mut CondInfo: *mut PPConditionalInfo = self.CurPPLexer.peekConditionalLevel();
                if !CondInfo.WasSkipping {
                    SkippingRangeState.endLexPass(Hashptr);
                }
                if CondInfo.FoundElse {
                    self.Diag(Tok, pp_err_elif_after_else) << PED_Elif;
                }
                if CondInfo.WasSkipping || CondInfo.FoundNonSkip {
                    self.DiscardUntilEndOfDirective(null);
                } else {
                    assert!(self.CurPPLexer.LexingRawMode, "We have to be skipping here!");
                    self.CurPPLexer.LexingRawMode = false;
                    let mut IfNDefMacro: *mut IdentifierInfo = null;
                    let mut DER: DirectiveEvalResult = self.EvaluateDirectiveExpression(IfNDefMacro, true);
                    if !self.CurPPLexer {
                        return;
                    }
                    let mut CondValue: bool = DER.Conditional;
                    self.CurPPLexer.LexingRawMode = true;
                    if self.Callbacks {
                        operator(self.Callbacks).Elif(Tok.getLocation(), DER.ExprRange, (if CondValue { CVK_True } else { CVK_False }), CondInfo.IfLoc);
                    }
                    if CondValue {
                        CondInfo.FoundNonSkip = true;
                        break;
                    }
                }
            } else if Sub == "lifdef" || Sub == "lifndef" {
                let mut IsElifDef: bool = Sub == "lifdef";
                let mut CondInfo: *mut PPConditionalInfo = self.CurPPLexer.peekConditionalLevel();
                let mut DirectiveToken: Token = Tok;
                if !CondInfo.WasSkipping {
                    SkippingRangeState.endLexPass(Hashptr);
                }
                let mut DiagID: u32 = if self.LangOpts.CPlusPlus { cxx23_pp_directive } else { c23_pp_directive };
                self.DiagCompat(Tok, DiagID) << (if IsElifDef { PED_Elifdef } else { PED_Elifndef });
                if CondInfo.FoundElse {
                    self.Diag(Tok, pp_err_elif_after_else) << (if IsElifDef { PED_Elifdef } else { PED_Elifndef });
                }
                if CondInfo.WasSkipping || CondInfo.FoundNonSkip {
                    self.DiscardUntilEndOfDirective(null);
                } else {
                    assert!(self.CurPPLexer.LexingRawMode, "We have to be skipping here!");
                    self.CurPPLexer.LexingRawMode = false;
                    let mut MacroNameTok: Token = Token {};
                    self.ReadMacroName(MacroNameTok, MU_Other, null);
                    self.CurPPLexer.LexingRawMode = true;
                    if MacroNameTok.is(eod) {
                        continue;
                    }
                    self.emitMacroExpansionWarnings(MacroNameTok, false);
                    self.CheckEndOfDirective(if IsElifDef { "elifdef" } else { "elifndef" }, false, null);
                    let mut MII: *mut IdentifierInfo = MacroNameTok.getIdentifierInfo();
                    let mut MD: MacroDefinition = self.getMacroDefinition(MII);
                    let mut MI: *mut MacroInfo = MD.getMacroInfo();
                    if self.Callbacks {
                        if IsElifDef {
                            operator(self.Callbacks).Elifdef(DirectiveToken.getLocation(), MacroNameTok, MD);
                        } else {
                            operator(self.Callbacks).Elifndef(DirectiveToken.getLocation(), MacroNameTok, MD);
                        }
                    }
                    if MI as bool == IsElifDef {
                        CondInfo.FoundNonSkip = true;
                        break;
                    }
                }
            } else {
                self.SuggestTypoedDirective(Tok, Directive);
            }
        } else {
            self.SuggestTypoedDirective(Tok, Directive);
        }
        self.CurPPLexer.ParsingPreprocessorDirective = false;
        if self.CurLexer {
            operator(self.CurLexer).resetExtendedTokenMode();
        }
    }
    self.CurPPLexer.LexingRawMode = false;
    if self.Callbacks && (Tok.isNot(eof) || !self.isRecordingPreamble()) {
        operator(self.Callbacks).SourceRangeSkipped(SourceRange { B: HashTokenLoc, E: if endLoc.isValid() { endLoc } else { self.CurPPLexer.getSourceLocation() } }, Tok.getLocation());
    }
}

fn Preprocessor::getModuleForLocation(self, Loc: SourceLocation, AllowTextual: bool) -> *mut Module {
    if !self.SourceMgr.isInMainFile(Loc) {
        let mut IDOfIncl: FileID = self.SourceMgr.getFileID(self.SourceMgr.getExpansionLoc(Loc));
        if self.SourceMgr.getFileEntryRefForID(IDOfIncl) {
            EntryOfIncl;
        } else {
            return self.HeaderInfo.getModuleMap().findModuleForHeader(operator(EntryOfIncl), AllowTextual, false).getModule();
        }
    }
    return if self.getLangOpts().CurrentModule.is_empty() { null } else { self.HeaderInfo.lookupModule(self.getLangOpts().CurrentModule, Loc, true, false) };
}

fn Preprocessor::getHeaderToIncludeForDiagnostics(self, IncLoc: SourceLocation, Loc: SourceLocation) -> OptionalFileEntryRef {
    let mut IncM: *mut Module = self.getModuleForLocation(IncLoc, self.LangOpts.ModulesValidateTextualHeaderIncludes);
    let mut SM: *mut SourceManager = self.getSourceManager();
    while !Loc.isInvalid() && !SM.isInMainFile(Loc) {
        let mut ID: FileID = SM.getFileID(SM.getExpansionLoc(Loc));
        let mut FE: OptionalFileEntryRef = SM.getFileEntryRefForID(ID);
        if !FE {
            break;
        }
        self.HeaderInfo.hasModuleMap(operator(FE).getName(), null, self.SourceMgr.isInSystemHeader(Loc));
        let mut InPrivateHeader: bool = false;
        for Header in self.HeaderInfo.findAllModulesForHeader(operator(FE)) {
            if !Header.isAccessibleFrom(IncM) {
                InPrivateHeader = true;
                continue;
            }
            if Header.getRole() == ExcludedHeader {
                continue;
            }
            if Header.getRole() & TextualHeader {
                continue;
            }
            if self.getLangOpts().ObjC || self.getLangOpts().CPlusPlusModules {
                return nullopt;
            }
            return operator(FE);
        }
        if InPrivateHeader {
            return nullopt;
        }
        if self.getHeaderSearchInfo().isFileMultipleIncludeGuarded(operator(FE)) {
            return operator(FE);
        }
        Loc = SM.getIncludeLoc(ID);
    }
    return nullopt;
}

fn Preprocessor::LookupFile(self, FilenameLoc: SourceLocation, Filename: str, isAngled: bool, FromDir: ConstSearchDirIterator, FromFile: *FileEntry, CurDirArg: *mut ConstSearchDirIterator, SearchPath: *mut SmallVectorImpl<char>, RelativePath: *mut SmallVectorImpl<char>, SuggestedModule: *mut KnownHeader, IsMapped: *mut bool, IsFrameworkFound: *mut bool, SkipCache: bool, OpenFile: bool, CacheFailures: bool) -> OptionalFileEntryRef {
    let mut CurDirLocal: ConstSearchDirIterator = null;
    let mut CurDir: *mut ConstSearchDirIterator = if CurDirArg { *CurDirArg } else { CurDirLocal };
    let mut RequestingModule: *mut Module = self.getModuleForLocation(FilenameLoc, self.LangOpts.ModulesValidateTextualHeaderIncludes);
    let mut Includers: pair<OptionalFileEntryRef, DirectoryEntryRef>, 16> = pair<OptionalFileEntryRef, DirectoryEntryRef>, 16> {};
    let mut BuildSystemModule: bool = false;
    if !FromDir && !FromFile {
        let mut FID: FileID = self.getCurrentFileLexer().getFileID();
        let mut FileEnt: OptionalFileEntryRef = self.SourceMgr.getFileEntryRefForID(FID);
        if !FileEnt {
            if FID == self.SourceMgr.getMainFileID() && self.MainFileDir {
                let mut IncludeDir: OptionalDirectoryEntryRef = if self.HeaderInfo.getModuleMap().shouldImportRelativeToBuiltinIncludeDir(Filename, self.getCurrentModule()) { self.HeaderInfo.getModuleMap().getBuiltinDir() } else { self.MainFileDir };
                Includers.push(make_pair(nullopt, operator(IncludeDir)));
                BuildSystemModule = self.getCurrentModule().IsSystem;
            } else if (FileEnt = self.SourceMgr.getFileEntryRefForID(self.SourceMgr.getMainFileID())) {
                let mut CWD: OptionalDirectoryEntryRef = self.FileMgr.getOptionalDirectoryRef(".", true);
                Includers.push(make_pair(operator(FileEnt), operator(CWD)));
            }
        } else {
            Includers.push(make_pair(operator(FileEnt), operator(FileEnt).getDir()));
        }
        if self.LangOpts.MSVCCompat && !isAngled {
            for ISEntry in reverse(self.IncludeMacroStack) {
                if IsFileLexer(ISEntry) {
                    if (FileEnt = ISEntry.ThePPLexer.getFileEntry()) {
                        Includers.push(make_pair(operator(FileEnt), operator(FileEnt).getDir()));
                    }
                }
            }
        }
    }
    CurDir = self.CurDirLookup;
    if FromFile {
        let mut TmpCurDir: ConstSearchDirIterator = CurDir;
        let mut TmpFromDir: ConstSearchDirIterator = null;
        while self.HeaderInfo.LookupFile(Filename, FilenameLoc, isAngled, TmpFromDir, &mut TmpCurDir, Includers, SearchPath, RelativePath, RequestingModule, SuggestedModule, null, null, SkipCache, false, true, true) {
            FE;
        }
    }
    let mut FE: OptionalFileEntryRef = self.HeaderInfo.LookupFile(Filename, FilenameLoc, isAngled, FromDir, &mut CurDir, Includers, SearchPath, RelativePath, RequestingModule, SuggestedModule, IsMapped, IsFrameworkFound, SkipCache, BuildSystemModule, OpenFile, CacheFailures);
    if FE {
        return FE;
    }
    let mut CurFileEnt: OptionalFileEntryRef = OptionalFileEntryRef {};
    if self.IsFileLexer() {
        if (CurFileEnt = self.CurPPLexer.getFileEntry()) {
            if self.HeaderInfo.LookupSubframeworkHeader(Filename, operator(CurFileEnt), SearchPath, RelativePath, RequestingModule, SuggestedModule) {
                FE;
            } else {
                return FE;
            }
        }
    }
    for ISEntry in reverse(self.IncludeMacroStack) {
        if IsFileLexer(ISEntry) {
            if (CurFileEnt = ISEntry.ThePPLexer.getFileEntry()) {
                if self.HeaderInfo.LookupSubframeworkHeader(Filename, operator(CurFileEnt), SearchPath, RelativePath, RequestingModule, SuggestedModule) {
                    FE;
                } else {
                    return FE;
                }
            }
        }
    }
    return nullopt;
}

fn Preprocessor::LookupEmbedFile(self, Filename: str, isAngled: bool, OpenFile: bool) -> OptionalFileEntryRef {
    let mut FM: *mut FileManager = self.getFileManager();
    if is_absolute(Filename, native) {
        return FM.getOptionalFileRef(Filename, OpenFile, true, false);
    }
    let mut SeparateComponents: Closure_3 = Closure_3 {};
    let mut LookupPath: str = "";
    if !isAngled {
        let mut LookupFromFile: OptionalFileEntryRef = self.getCurrentFileLexer().getFileEntry();
        if LookupFromFile {
            let mut TmpDir: str = "";
            TmpDir = operator(LookupFromFile).getDir().getName();
            append(TmpDir, Filename, "", "", "");
            if !TmpDir.is_empty() {
                let mut ShouldBeEntry: OptionalFileEntryRef = FM.getOptionalFileRef(TmpDir.operator StringRef(), OpenFile, true, false);
                if ShouldBeEntry {
                    return ShouldBeEntry;
                }
            }
        }
        LookupPath.clear();
        let mut MaybeWorkingDirEntry: OptionalDirectoryEntryRef = FM.getOptionalDirectoryRef(".", true);
        if MaybeWorkingDirEntry {
            let mut WorkingDirEntry: DirectoryEntryRef = operator(MaybeWorkingDirEntry);
            let mut WorkingDir: str = WorkingDirEntry.getName();
            if !WorkingDir.is_empty() {
                SeparateComponents.call(LookupPath, WorkingDir, Filename, false);
                let mut ShouldBeEntry: OptionalFileEntryRef = FM.getOptionalFileRef(LookupPath.operator StringRef(), OpenFile, true, false);
                if ShouldBeEntry {
                    return ShouldBeEntry;
                }
            }
        }
    }
    for Entry in self.PPOpts.EmbedEntries {
        LookupPath.clear();
        SeparateComponents.call(LookupPath, Entry, Filename, false);
        let mut ShouldBeEntry: OptionalFileEntryRef = FM.getOptionalFileRef(LookupPath.operator StringRef(), OpenFile, true, false);
        if ShouldBeEntry {
            return ShouldBeEntry;
        }
    }
    return nullopt;
}

struct ResetMacroExpansionHelper {
    PP: *mut Preprocessor,
    save: bool,
}

fn ResetMacroExpansionHelper::ResetMacroExpansionHelper(self, pp: *mut Preprocessor) {
    if pp.MacroExpansionInDirectivesOverride {
        pp.DisableMacroExpansion = false;
    }
}

fn ResetMacroExpansionHelper::~ResetMacroExpansionHelper(self) {
    self.PP.DisableMacroExpansion = self.save;
}

fn Preprocessor::HandleSkippedDirectiveWhileUsingPCH(self, Result: *mut Token, HashLoc: SourceLocation) {
    if Result.getIdentifierInfo() {
        II;
    } else {
        if II.getPPKeywordID() == pp_define {
            return self.HandleDefineDirective(Result, false);
        }
        if self.SkippingUntilPCHThroughHeader && II.getPPKeywordID() == pp_include {
            return self.HandleIncludeDirective(HashLoc, Result, null, null);
        }
        if self.SkippingUntilPragmaHdrStop && II.getPPKeywordID() == pp_pragma {
            self.Lex(Result);
            let mut II: *mut IdentifierInfo = Result.getIdentifierInfo();
            if II && II.getName() == "hdrstop" {
                return self.HandlePragmaHdrstop(Result);
            }
        }
    }
    self.DiscardUntilEndOfDirective(null);
}

fn Preprocessor::HandleDirective(self, Result: *mut Token) {
    self.CurPPLexer.ParsingPreprocessorDirective = true;
    if self.CurLexer {
        operator(self.CurLexer).SetKeepWhitespaceMode(false);
    }
    let mut ImmediatelyAfterTopLevelIfndef: bool = self.CurPPLexer.MIOpt.getImmediatelyAfterTopLevelIfndef();
    self.CurPPLexer.MIOpt.resetImmediatelyAfterTopLevelIfndef();
    self.NumDirectives += 1;
    let mut ReadAnyTokensBeforeDirective: bool = self.CurPPLexer.MIOpt.getHasReadAnyTokensVal();
    let mut Introducer: Token = Result;
    if Introducer.isOneOf(hash, at) {
        self.LexUnexpandedToken(Result);
    }
    if self.InMacroArgs {
        if Result.getIdentifierInfo() {
            II;
        } else {
            match II.getPPKeywordID() {
                pp_include => {
                    pp_import;
                },
                _ => {
                    break;
                },
            }
        }
        self.Diag(Result, ext_embedded_directive);
    }
    let mut helper: ResetMacroExpansionHelper = self;
    if self.SkippingUntilPCHThroughHeader || self.SkippingUntilPragmaHdrStop {
        return self.HandleSkippedDirectiveWhileUsingPCH(Result, Introducer.getLocation());
    }
    match Result.getKind() {
        eod => {
            self.CurPPLexer.MIOpt.SetReadToken(ReadAnyTokensBeforeDirective);
        },
        code_completion => {
            self.setCodeCompletionReached();
        },
        numeric_constant => {
            if self.getLangOpts().AsmPreprocessor && self.SourceMgr.getFileID(Introducer.getLocation()) != self.getPredefinesFileID() {
                break;
            }
        },
        _ => {
            let mut II: *mut IdentifierInfo = Result.getIdentifierInfo();
        },
    }
    if self.getLangOpts().AsmPreprocessor {
        let mut Toks: []Token = make_unique(2);
        Toks[0] = Introducer;
        Toks[1] = Result;
        if Result.is(hashhash) {
            Toks[1].setKind(unknown);
        }
        self.EnterTokenStream(move(Toks), 2, false, false);
        return;
    }
    self.Diag(Result, err_pp_invalid_directive) << 0;
    self.DiscardUntilEndOfDirective(null);
}

fn GetLineValue(DigitTok: *mut Token, Val: *mut u32, DiagID: u32, PP: *mut Preprocessor, IsGNULineDirective: bool) -> bool {
    if DigitTok.isNot(numeric_constant) {
        PP.Diag(DigitTok, DiagID);
        if DigitTok.isNot(eod) {
            PP.DiscardUntilEndOfDirective(null);
        }
        return true;
    }
    let mut IntegerBuffer: str = "";
    IntegerBuffer.resize(DigitTok.getLength());
    let mut DigitTokBegin: *u8 = &mut IntegerBuffer[0];
    let mut Invalid: bool = false;
    let mut ActualLength: u32 = PP.getSpelling(DigitTok, DigitTokBegin, &mut Invalid);
    if Invalid {
        return true;
    }
    Val = 0;
    for let mut i: u32 = 0; i != ActualLength; i += 1 {
        if DigitTokBegin[i] == ''' {
            continue;
        }
        if !isDigit(DigitTokBegin[i]) {
            PP.Diag(PP.AdvanceToTokenCharacter(DigitTok.getLocation(), i), err_pp_line_digit_sequence) << IsGNULineDirective;
            PP.DiscardUntilEndOfDirective(null);
            return true;
        }
        let mut NextVal: u32 = Val * 10 + (DigitTokBegin[i] - '0');
        if NextVal < Val {
            PP.Diag(DigitTok, DiagID);
            PP.DiscardUntilEndOfDirective(null);
            return true;
        }
        Val = NextVal;
    }
    if DigitTokBegin[0] == '0' && Val {
        PP.Diag(DigitTok.getLocation(), warn_pp_line_decimal) << IsGNULineDirective;
    }
    return false;
}

fn Preprocessor::HandleLineDirective(self) {
    let mut DigitTok: Token = Token {};
    self.Lex(DigitTok);
    let mut LineNo: u32 = 0;
    if GetLineValue(DigitTok, LineNo, err_pp_line_requires_integer, *self, false) {
        return;
    }
    if LineNo == 0 {
        self.Diag(DigitTok, ext_pp_line_zero);
    }
    let mut LineLimit: u32 = 32768;
    if self.LangOpts.C99 || self.LangOpts.CPlusPlus11 {
        LineLimit = 2147483648;
    }
    if LineNo >= LineLimit {
        self.Diag(DigitTok, ext_pp_line_too_big) << LineLimit;
    } else if self.LangOpts.CPlusPlus11 && LineNo >= 32768 {
        self.Diag(DigitTok, warn_cxx98_compat_pp_line_too_big);
    }
    let mut FilenameID: i32 = -1;
    let mut StrTok: Token = Token {};
    self.LexHeaderName(StrTok, true);
    if StrTok.is(eod) {
        
    } else if StrTok.isNot(header_name) {
        self.Diag(StrTok, err_pp_line_invalid_filename);
        self.DiscardUntilEndOfDirective(null);
        return;
    } else {
        let mut FilenameBuffer: str = "";
        let mut Filename: str = self.getSpelling(StrTok, FilenameBuffer, null);
        self.GetLineDirectiveFilenameSpelling(StrTok.getLocation(), Filename);
        FilenameID = self.SourceMgr.getLineTableFilenameID(Filename);
        self.CheckEndOfDirective("line", true, null);
    }
    let mut FileKind: CharacteristicKind = self.SourceMgr.getFileCharacteristic(DigitTok.getLocation());
    self.SourceMgr.AddLineNote(DigitTok.getLocation(), LineNo, FilenameID, false, false, FileKind);
    if self.Callbacks {
        operator(self.Callbacks).FileChanged(self.CurPPLexer.getSourceLocation(), RenameFile, FileKind, FileID {});
    }
}

fn ReadLineMarkerFlags(IsFileEntry: *mut bool, IsFileExit: *mut bool, FileKind: *mut CharacteristicKind, PP: *mut Preprocessor) -> bool {
    let mut FlagVal: u32 = 0;
    let mut FlagTok: Token = Token {};
    PP.Lex(FlagTok);
    if FlagTok.is(eod) {
        return false;
    }
    if GetLineValue(FlagTok, FlagVal, err_pp_linemarker_invalid_flag, PP, false) {
        return true;
    }
    if FlagVal == 1 {
        IsFileEntry = true;
        PP.Lex(FlagTok);
        if FlagTok.is(eod) {
            return false;
        }
        if GetLineValue(FlagTok, FlagVal, err_pp_linemarker_invalid_flag, PP, false) {
            return true;
        }
    } else if FlagVal == 2 {
        IsFileExit = true;
        let mut SM: *mut SourceManager = PP.getSourceManager();
        let mut CurFileID: FileID = SM.getDecomposedExpansionLoc(FlagTok.getLocation()).first;
        let mut PLoc: PresumedLoc = SM.getPresumedLoc(FlagTok.getLocation(), true);
        if PLoc.isInvalid() {
            return true;
        }
        let mut IncLoc: SourceLocation = PLoc.getIncludeLoc();
        if IncLoc.isInvalid() || SM.getDecomposedExpansionLoc(IncLoc).first != CurFileID {
            PP.Diag(FlagTok, err_pp_linemarker_invalid_pop);
            PP.DiscardUntilEndOfDirective(null);
            return true;
        }
        PP.Lex(FlagTok);
        if FlagTok.is(eod) {
            return false;
        }
        if GetLineValue(FlagTok, FlagVal, err_pp_linemarker_invalid_flag, PP, false) {
            return true;
        }
    }
    if FlagVal != 3 {
        PP.Diag(FlagTok, err_pp_linemarker_invalid_flag);
        PP.DiscardUntilEndOfDirective(null);
        return true;
    }
    FileKind = C_System;
    PP.Lex(FlagTok);
    if FlagTok.is(eod) {
        return false;
    }
    if GetLineValue(FlagTok, FlagVal, err_pp_linemarker_invalid_flag, PP, false) {
        return true;
    }
    if FlagVal != 4 {
        PP.Diag(FlagTok, err_pp_linemarker_invalid_flag);
        PP.DiscardUntilEndOfDirective(null);
        return true;
    }
    FileKind = C_ExternCSystem;
    PP.Lex(FlagTok);
    if FlagTok.is(eod) {
        return false;
    }
    PP.Diag(FlagTok, err_pp_linemarker_invalid_flag);
    PP.DiscardUntilEndOfDirective(null);
    return true;
}

fn Preprocessor::HandleDigitDirective(self, DigitTok: *mut Token) {
    let mut LineNo: u32 = 0;
    if GetLineValue(DigitTok, LineNo, err_pp_linemarker_requires_integer, *self, true) {
        return;
    }
    let mut StrTok: Token = Token {};
    self.LexHeaderName(StrTok, true);
    let mut IsFileEntry: bool = false;
    let mut IsFileExit: bool = false;
    let mut FilenameID: i32 = -1;
    let mut FileKind: CharacteristicKind = C_User;
    if StrTok.is(eod) {
        self.Diag(StrTok, ext_pp_gnu_line_directive);
        FileKind = self.SourceMgr.getFileCharacteristic(DigitTok.getLocation());
    } else if StrTok.isNot(header_name) {
        self.Diag(StrTok, err_pp_linemarker_invalid_filename);
        self.DiscardUntilEndOfDirective(null);
        return;
    } else {
        let mut FilenameBuffer: str = "";
        let mut Filename: str = self.getSpelling(StrTok, FilenameBuffer, null);
        self.GetLineDirectiveFilenameSpelling(StrTok.getLocation(), Filename);
        if ReadLineMarkerFlags(IsFileEntry, IsFileExit, FileKind, *self) {
            return;
        }
        if !self.SourceMgr.isInPredefinedFile(DigitTok.getLocation()) {
            self.Diag(StrTok, ext_pp_gnu_line_directive);
        }
        if !(IsFileExit && Filename.is_empty()) {
            FilenameID = self.SourceMgr.getLineTableFilenameID(Filename);
        }
    }
    self.SourceMgr.AddLineNote(DigitTok.getLocation(), LineNo, FilenameID, IsFileEntry, IsFileExit, FileKind);
    if self.Callbacks {
        let mut Reason: FileChangeReason = RenameFile;
        if IsFileEntry {
            Reason = EnterFile;
        } else if IsFileExit {
            Reason = ExitFile;
        }
        operator(self.Callbacks).FileChanged(self.CurPPLexer.getSourceLocation(), Reason, FileKind, FileID {});
    }
}

fn Preprocessor::HandleUserDiagnosticDirective(self, Tok: *mut Token, isWarning: bool) {
    let mut Message: str = "";
    operator(self.CurLexer).ReadToEndOfLine(&mut Message);
    let mut Msg: str = Message.ltrim(' ');
    if isWarning {
        self.Diag(Tok, pp_hash_warning) << Msg;
    } else {
        self.Diag(Tok, err_pp_hash_error) << Msg;
    }
}

fn Preprocessor::HandleIdentSCCSDirective(self, Tok: *mut Token) {
    self.Diag(Tok, ext_pp_ident_directive);
    let mut StrTok: Token = Token {};
    self.Lex(StrTok);
    if StrTok.isNot(string_literal) && StrTok.isNot(wide_string_literal) {
        self.Diag(StrTok, err_pp_malformed_ident);
        if StrTok.isNot(eod) {
            self.DiscardUntilEndOfDirective(null);
        }
        return;
    }
    if StrTok.hasUDSuffix() {
        self.Diag(StrTok, err_invalid_string_udl);
        self.DiscardUntilEndOfDirective(null);
        return;
    }
    self.CheckEndOfDirective("ident", false, null);
    if self.Callbacks {
        let mut Invalid: bool = false;
        let mut Str: str = self.getSpelling(StrTok, &mut Invalid);
        if !Invalid {
            operator(self.Callbacks).Ident(Tok.getLocation(), Str);
        }
    }
}

fn Preprocessor::HandleMacroPublicDirective(self, Tok: *mut Token) {
    let mut MacroNameTok: Token = Token {};
    self.ReadMacroName(MacroNameTok, MU_Undef, null);
    if MacroNameTok.is(eod) {
        return;
    }
    self.CheckEndOfDirective("__public_macro", false, null);
    let mut II: *mut IdentifierInfo = MacroNameTok.getIdentifierInfo();
    let mut MD: *mut MacroDirective = self.getLocalMacroDirective(II);
    if !MD {
        self.Diag(MacroNameTok, err_pp_visibility_non_macro) << II;
        return;
    }
    self.appendMacroDirective(II, self.AllocateVisibilityMacroDirective(MacroNameTok.getLocation(), true));
}

fn Preprocessor::HandleMacroPrivateDirective(self) {
    let mut MacroNameTok: Token = Token {};
    self.ReadMacroName(MacroNameTok, MU_Undef, null);
    if MacroNameTok.is(eod) {
        return;
    }
    self.CheckEndOfDirective("__private_macro", false, null);
    let mut II: *mut IdentifierInfo = MacroNameTok.getIdentifierInfo();
    let mut MD: *mut MacroDirective = self.getLocalMacroDirective(II);
    if !MD {
        self.Diag(MacroNameTok, err_pp_visibility_non_macro) << II;
        return;
    }
    self.appendMacroDirective(II, self.AllocateVisibilityMacroDirective(MacroNameTok.getLocation(), false));
}

fn Preprocessor::GetIncludeFilenameSpelling(self, Loc: SourceLocation, Buffer: *mut str) -> bool {
    assert!(!Buffer.is_empty(), "Can't have tokens with empty spellings!");
    let mut isAngled: bool = false;
    if Buffer[0] == '<' {
        if Buffer.back() != '>' {
            self.Diag(Loc, err_pp_expects_filename);
            Buffer = "";
            return true;
        }
        isAngled = true;
    } else if Buffer[0] == '"' {
        if Buffer.back() != '"' {
            self.Diag(Loc, err_pp_expects_filename);
            Buffer = "";
            return true;
        }
        isAngled = false;
    } else {
        self.Diag(Loc, err_pp_expects_filename);
        Buffer = "";
        return true;
    }
    if Buffer.len <= 2 {
        self.Diag(Loc, err_pp_empty_filename);
        Buffer = "";
        return true;
    }
    Buffer = Buffer[1..1 + Buffer.len - 2];
    return isAngled;
}

fn Preprocessor::GetLineDirectiveFilenameSpelling(self, Loc: SourceLocation, Buffer: *mut str) {
    assert!(!Buffer.is_empty(), "Can't have tokens with empty spellings!");
    if Buffer.len < 2 || Buffer.front() != '"' || Buffer.back() != '"' {
        self.Diag(Loc, err_pp_line_invalid_filename);
        Buffer = "";
        return;
    }
    Buffer = Buffer[1..1 + Buffer.len - 2];
}

fn Preprocessor::EnterAnnotationToken(self, Range: SourceRange, Kind: TokenKind, AnnotationVal: *mut void) {
    let mut Tok: []Token = make_unique(1);
    Tok[0].startToken();
    Tok[0].setKind(Kind);
    Tok[0].setLocation(Range.getBegin());
    Tok[0].setAnnotationEndLoc(Range.getEnd());
    Tok[0].setAnnotationValue(AnnotationVal);
    self.EnterTokenStream(move(Tok), 1, true, false);
}

fn diagnoseAutoModuleImport(PP: *mut Preprocessor, HashLoc: SourceLocation, IncludeTok: *mut Token, Path: ArrayRef<IdentifierLoc>, PathEnd: SourceLocation) {
    let mut PathString: str = "";
    for let mut I: u64 = 0;
let mut N: u64 = Path.len; I != N; I += 1 {
        if I {
            operator(PathString, '.');
        }
        operator(PathString, Path[I].getIdentifierInfo().getName());
    }
    let mut IncludeKind: i32 = 0;
    match IncludeTok.getIdentifierInfo().getPPKeywordID() {
        pp_include => {
            IncludeKind = 0;
        },
        pp_import => {
            IncludeKind = 1;
        },
        pp_include_next => {
            IncludeKind = 2;
        },
        pp___include_macros => {
            IncludeKind = 3;
        },
        _ => {
            llvm_unreachable_internal("unknown include directive kind", "P:/Goraw/llvm-project/clang/lib/Lex/PPDirectives.cpp", 2040);
        },
    }
    PP.Diag(HashLoc, remark_pp_include_directive_modular_translation) << IncludeKind << PathString;
}

fn trySimplifyPath(Components: *mut SmallVectorImpl<StringRef>, RealPathName: str, Separator: Style) -> bool {
    let mut RealPathComponentIter: reverse_iterator = rbegin(RealPathName, native);
    let mut RealPathComponentEnd: reverse_iterator = rend(RealPathName);
    let mut Cnt: i32 = 0;
    let mut SuggestReplacement: bool = false;
    let mut IsSep: Closure_4 = Closure_4 { Separator: Separator };
    for Component in reverse(Components) {
        if "." == Component {} else if ".." == Component {
            Cnt += 1;
        } else if Cnt {
            Cnt -= 1;
        } else if !RealPathComponentIter == RealPathComponentEnd {
            if !IsSep.call(Component) && !IsSep.call(operator(RealPathComponentIter)) && Component != operator(RealPathComponentIter) {
                SuggestReplacement = operator(operator(RealPathComponentIter)).equals_insensitive(Component);
                if !SuggestReplacement {
                    break;
                }
                Component = operator(RealPathComponentIter);
            }
            operator(RealPathComponentIter);
        }
    }
    return SuggestReplacement;
}

fn Preprocessor::checkModuleIsAvailable(self, LangOpts: *LangOptions, TargetInfo: *TargetInfo, M: *Module, Diags: *mut DiagnosticsEngine) -> bool {
    let mut Requirement: Requirement = Requirement {};
    let mut MissingHeader: UnresolvedHeaderDirective = UnresolvedHeaderDirective {};
    let mut ShadowingModule: *mut Module = null;
    if M.isAvailable(LangOpts, TargetInfo, Requirement, MissingHeader, ShadowingModule) {
        return false;
    }
    if MissingHeader.FileNameLoc.isValid() {
        Diags.Report(MissingHeader.FileNameLoc, err_module_header_missing) << MissingHeader.IsUmbrella << MissingHeader.FileName;
    } else if ShadowingModule {
        Diags.Report(M.DefinitionLoc, err_module_shadowed) << M.Name;
        Diags.Report(ShadowingModule.DefinitionLoc, note_previous_definition);
    } else {
        Diags.Report(M.DefinitionLoc, err_module_unavailable) << M.getFullModuleName(false) << Requirement.RequiredState << Requirement.FeatureName;
    }
    return true;
}

fn Preprocessor::getIncludeNextStart(self: *Preprocessor, IncludeNextTok: *Token) -> pair<ConstSearchDirIterator, const FileEntry *> {
    let mut Lookup: ConstSearchDirIterator = self.CurDirLookup;
    let mut LookupFromFile: *FileEntry = null;
    if self.isInPrimaryFile() && self.LangOpts.IsHeaderFile {} else if self.isInPrimaryFile() {
        Lookup = null;
        self.Diag(IncludeNextTok, pp_include_next_in_primary);
    } else if self.CurLexerSubmodule {
        assert!(self.CurPPLexer, "#include_next directive in macro?");
        if self.CurPPLexer.getFileEntry() {
            FE;
        } else {
            LookupFromFile = operator(FE).operator const clang::FileEntry *();
        }
        Lookup = null;
    } else if !Lookup {
        self.Diag(IncludeNextTok, pp_include_next_absolute_path);
    } else {
        operator(Lookup);
    }
    return pair<ConstSearchDirIterator, const FileEntry *> { Lookup, LookupFromFile };
}

fn Preprocessor::HandleIncludeDirective(self, HashLoc: SourceLocation, IncludeTok: *mut Token, LookupFrom: ConstSearchDirIterator, LookupFromFile: *FileEntry) {
    let mut FilenameTok: Token = Token {};
    if self.LexHeaderName(FilenameTok, true) {
        return;
    }
    if FilenameTok.isNot(header_name) {
        if FilenameTok.is(identifier) && (self.PPOpts.SingleFileParseMode || self.PPOpts.SingleModuleParseMode) {
            self.DiscardUntilEndOfDirective(null);
            return;
        }
        self.Diag(FilenameTok.getLocation(), err_pp_expects_filename);
        if FilenameTok.isNot(eod) {
            self.DiscardUntilEndOfDirective(null);
        }
        return;
    }
    let mut EndLoc: SourceLocation = self.CheckEndOfDirective(IncludeTok.getIdentifierInfo().getNameStart(), true, null);
    let mut Action: ImportAction = self.HandleHeaderIncludeOrImport(HashLoc, IncludeTok, FilenameTok, EndLoc, LookupFrom, LookupFromFile);
    match Action.Kind {
        None => {
            SkippedModuleImport;
        },
        ModuleBegin => {
            self.EnterAnnotationToken(SourceRange { B: HashLoc, E: EndLoc }, annot_module_begin, Action.ModuleForHeader);
        },
        HeaderUnitImport => {
            self.EnterAnnotationToken(SourceRange { B: HashLoc, E: EndLoc }, annot_header_unit, Action.ModuleForHeader);
        },
        ModuleImport => {
            self.EnterAnnotationToken(SourceRange { B: HashLoc, E: EndLoc }, annot_module_include, Action.ModuleForHeader);
        },
        Failure => {
            assert!(self.TheModuleLoader.HadFatalFailure, "This should be an early exit only to a fatal error");
        },
    }
}

fn Preprocessor::LookupHeaderIncludeOrImport(self, CurDir: *mut ConstSearchDirIterator, Filename: *mut str, FilenameLoc: SourceLocation, FilenameRange: CharSourceRange, FilenameTok: *Token, IsFrameworkFound: *mut bool, IsImportDecl: bool, IsMapped: *mut bool, LookupFrom: ConstSearchDirIterator, LookupFromFile: *FileEntry, LookupFilename: *mut str, RelativePath: *mut SmallVectorImpl<char>, SearchPath: *mut SmallVectorImpl<char>, SuggestedModule: *mut KnownHeader, isAngled: bool) -> OptionalFileEntryRef {
    let mut DiagnoseHeaderInclusion: Closure_5 = Closure_5 { cap_0: self, FilenameLoc: &mut FilenameLoc, Filename: &mut Filename };
    let mut File: OptionalFileEntryRef = self.LookupFile(FilenameLoc, LookupFilename, isAngled, LookupFrom, LookupFromFile, CurDir, if self.Callbacks { &mut SearchPath } else { null }, if self.Callbacks { &mut RelativePath } else { null }, &mut SuggestedModule, &mut IsMapped, &mut IsFrameworkFound, false, true, true);
    if File {
        DiagnoseHeaderInclusion.call(operator(File));
        return File;
    }
    if self.Callbacks && operator(self.Callbacks).FileNotFound(Filename) {
        return nullopt;
    }
    if self.SuppressIncludeNotFoundError {
        return nullopt;
    }
    if isAngled {
        let mut File: OptionalFileEntryRef = self.LookupFile(FilenameLoc, LookupFilename, false, LookupFrom, LookupFromFile, CurDir, if self.Callbacks { &mut SearchPath } else { null }, if self.Callbacks { &mut RelativePath } else { null }, &mut SuggestedModule, &mut IsMapped, null, false, true, true);
        if File {
            DiagnoseHeaderInclusion.call(operator(File));
            self.Diag(FilenameTok, err_pp_file_not_found_angled_include_not_fatal) << Filename << IsImportDecl << CreateReplacement(FilenameRange, "\"" + Filename + "\"");
            return File;
        }
    }
    let mut OriginalFilename: str = Filename;
    if self.LangOpts.SpellChecking {
        let mut CorrectTypoFilename: Closure_6 = Closure_6 {};
        let mut TypoCorrectionName: str = CorrectTypoFilename.call(Filename);
        let mut TypoCorrectionLookupName: str = CorrectTypoFilename.call(LookupFilename);
        let mut File: OptionalFileEntryRef = self.LookupFile(FilenameLoc, TypoCorrectionLookupName, isAngled, LookupFrom, LookupFromFile, CurDir, if self.Callbacks { &mut SearchPath } else { null }, if self.Callbacks { &mut RelativePath } else { null }, &mut SuggestedModule, &mut IsMapped, null, false, true, true);
        if File {
            DiagnoseHeaderInclusion.call(operator(File));
            let mut Hint: FixItHint = if isAngled { CreateReplacement(FilenameRange, "<" + TypoCorrectionName + ">") } else { CreateReplacement(FilenameRange, "\"" + TypoCorrectionName + "\"") };
            self.Diag(FilenameTok, err_pp_file_not_found_typo_not_fatal) << OriginalFilename << TypoCorrectionName << Hint;
            Filename = TypoCorrectionName;
            LookupFilename = TypoCorrectionLookupName;
            return File;
        }
    }
    assert!(!File, "expected missing file");
    self.Diag(FilenameTok, err_pp_file_not_found) << OriginalFilename << FilenameRange;
    if IsFrameworkFound {
        let mut SlashPos: u64 = OriginalFilename.find('/', 0);
        assert!(SlashPos != npos, "Include with framework name should have '/' in the filename");
        let mut FrameworkName: str = OriginalFilename[0..0 + SlashPos];
        let mut CacheEntry: *mut FrameworkCacheEntry = self.HeaderInfo.LookupFrameworkCache(FrameworkName);
        assert!(CacheEntry.Directory, "Found framework should be in cache");
        self.Diag(FilenameTok, note_pp_framework_without_header) << OriginalFilename[SlashPos + 1..SlashPos + 1 + npos] << FrameworkName << operator(CacheEntry.Directory).getName();
    }
    return nullopt;
}

fn Preprocessor::HandleHeaderIncludeOrImport(self, HashLoc: SourceLocation, IncludeTok: *mut Token, FilenameTok: *mut Token, EndLoc: SourceLocation, LookupFrom: ConstSearchDirIterator, LookupFromFile: *FileEntry) -> ImportAction {
