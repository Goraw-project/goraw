    let mut MaybeTranslateInclude: bool = Action == Enter && File && ModuleToImport && !ModuleToImport.isForBuilding(self.getLangOpts());
    let mut UsableHeaderUnit: bool = false;
    if self.getLangOpts().CPlusPlusModules && ModuleToImport && ModuleToImport.isHeaderUnit() {
