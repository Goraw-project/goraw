    }

struct Closure_10 {}

fn Closure_10::call(self: *Closure_10) {}

struct Closure_11 {
    cap_0: *mut HeaderSearch,
    MMDir: *mut DirectoryEntryRef,
    PathPrefix: *mut str,
    MMState: *mut ModuleMapDirectoryState,
}

unsafe fn Closure_11::call(self: *mut Closure_11, MD: *ModuleDecl) {
            self.processModuleDeclForIndex(MD, MD.Id.front().first, (*self.MMDir), (*self.PathPrefix), (*self.MMState));
        }

struct Closure_12 {
    cap_0: *mut HeaderSearch,
    MMDir: *mut DirectoryEntryRef,
    PathPrefix: *mut str,
    MMState: *mut ModuleMapDirectoryState,
}

unsafe fn Closure_12::call(self: *mut Closure_12, EMD: *ExternModuleDecl) {
            self.processExternModuleDeclForIndex(EMD, (*self.MMDir), (*self.PathPrefix), (*self.MMState));
        }

struct Closure_13 {
    WorkingDir: *mut str,
    File: *mut str,
    BestPrefixLength: *mut u32,
}

unsafe fn Closure_13::call(self: *mut Closure_13, Dir: str) -> auto {
        if !(*self.WorkingDir).is_empty() && !is_absolute(Dir, native) {
            make_absolute((*self.WorkingDir), Dir);
        }
        remove_dots(Dir, true, native);
        for let mut NI: const_iterator = begin((*self.File), native);
let mut NE: const_iterator = end((*self.File));
let mut DI: const_iterator = begin(Dir.operator StringRef(), native);
let mut DE: const_iterator = end(Dir.operator StringRef()); !NI == NE; operator(NI) , operator(DI) {
            if DI == DE {
                let mut PrefixLength: u32 = NI - begin((*self.File), native);
                if PrefixLength > (*self.BestPrefixLength) {
                    (*self.BestPrefixLength) = PrefixLength;
                    return true;
                }
                break;
            }
            if operator(operator(NI)).len == 1 && operator(operator(DI)).len == 1 && is_separator(operator(operator(NI)).front(), native) && is_separator(operator(operator(DI)).front(), native) {
                continue;
            }
            if operator(operator(NI)).ends_with(".sdk") && operator(operator(DI)).ends_with(".sdk") {
                let mut NBasename: str = stem(operator(NI), native);
                let mut DBasename: str = stem(operator(DI), native);
                if DBasename.starts_with(NBasename) {
                    continue;
                }
            }
            if operator(NI) != operator(DI) {
                break;
            }
        }
        return false;
    }
