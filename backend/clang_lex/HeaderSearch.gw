        assert!(Dir, "parent must exist");
        let mut DirName: str = operator(Dir).getName();
        if filename(DirName, native) == "Modules" {
            DirName = parent_path(DirName, native);
            if DirName.ends_with(".framework") {
                if self.FileMgr.getOptionalDirectoryRef(DirName, true) {
                    MaybeDir;
                } else {
                    Dir = operator(MaybeDir);
                }
            }
            assert!(Dir, "parent must exist");
        }
    }
    assert!(Dir, "module map home directory must exist");
    match self.parseAndLoadModuleMapFileImpl(File, IsSystem, ImplicitlyDiscovered, operator(Dir), ID, Offset, true) {
        MMR_AlreadyProcessed => {
            MMR_NewlyProcessed;
        },
        MMR_NoDirectory => {
            MMR_InvalidModuleMap;
        },
    }
    llvm_unreachable_internal("Unknown load module map result", "clang\\lib\\Lex\\HeaderSearch.cpp", 2116);
}

