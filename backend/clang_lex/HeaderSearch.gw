        CurDir = operator(Dir).operator const clang::DirectoryEntry *();
        let mut IsFramework: bool = extension(operator(Dir).getName(), native) == ".framework";
        self.parseModuleMapFile(operator(Dir), IsSystem, true, IsFramework);
        let mut DirState: auto = zeroed();
        if  {
            continue;
        }
        if !self.HSOpts.LazyLoadModuleMaps && self.Diags.isIgnored {
            return true;
        }
        let mut MMState: *mut auto = ;
        if MMState()() && () && () {
            self.buildModuleMapIndex(operator(Dir));
        }
        if !self.HSOpts.LazyLoadModuleMaps {
