        HeadersFilename() += "PrivateHeaders/";
        if SearchPath {
            SearchPath()();
            SearchPath()(() - 1);
        }
        HeadersFilename()(Filename.begin() + SlashPos + 1, Filename.end());
        File() = self.FileMgr.getOptionalFileRef(true);
