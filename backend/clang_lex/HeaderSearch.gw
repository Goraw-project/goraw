            if ExternalHFI.IsValid {
                HFI.Resolved = true;
                if ExternalHFI.External {
                    mergeHeaderFileInfo(*HFI, ExternalHFI);
                }
            }
        }
    } else if  {
        
    } else {
        HFI = operator&();
    }
    return if (HFI && HFI.IsValid) { HFI } else { null };
}

