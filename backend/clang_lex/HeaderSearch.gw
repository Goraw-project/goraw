    let mut BestPrefixIsFramework: bool = false;
    if !BestPrefixLength && CheckDir(parent_path(MainFile, native)) {
        if IsAngled {
            *IsAngled = false;
        }
        BestPrefixIsFramework = false;
    }
    let mut Filename: str = File.drop_front(BestPrefixLength);
    let mut IsPrivateHeader: bool = false;
    let mut FrameworkName: str = zeroed();
    let mut IncludeSpelling: str = zeroed();
    if BestPrefixIsFramework && isFrameworkStylePath(Filename, IsPrivateHeader) {
        Filename = ;
    }
    return convert_to_slash(Filename, native);
}

