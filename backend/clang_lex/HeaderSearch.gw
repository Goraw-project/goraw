        }
    }
    let mut HFI: *mut HeaderFileInfo = self.getFileInfo(FE);
    HFI.mergeModuleMembership(Role);
    HFI.isCompilingModuleHeader |= isCompilingModuleHeader;
}

fn HeaderSearch::ShouldEnterIncludeFile(self, PP: *mut Preprocessor, File: FileEntryRef, isImport: bool, ModulesEnabled: bool, M: *mut Module, IsFirstIncludeOfFile: *mut bool) -> bool {
    operator(NumIncluded);
