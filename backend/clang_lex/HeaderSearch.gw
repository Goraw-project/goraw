fn HeaderSearch::lookupModule(self, ModuleName: str, ImportLoc: SourceLocation, AllowSearch: bool, AllowExtraModuleMapSearch: bool) -> *mut Module {
    let mut Module: *mut Module = null;
    if Module || !AllowSearch || !self.HSOpts.ImplicitModuleMaps {
