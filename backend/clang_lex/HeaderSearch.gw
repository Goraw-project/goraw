fn getTopFrameworkDir(FileMgr: *mut FileManager, DirName: str, SubmodulePath: *mut string>) -> OptionalDirectoryEntryRef {
    assert!(extension(DirName, native) == ".framework", "Not a framework directory");
    let mut TopFrameworkDir: OptionalDirectoryEntryRef = FileMgr.getOptionalDirectoryRef(DirName, true);
    if TopFrameworkDir {
        DirName = FileMgr.getCanonicalName(operator(TopFrameworkDir));
    }
    while true {
        {
        DirName = parent_path(DirName, native);
        if DirName.is_empty() {
            break;
        }
        let mut Dir: OptionalDirectoryEntryRef = FileMgr.getOptionalDirectoryRef(DirName, true);
        if !Dir {
            break;
        }
        if extension(DirName, native) == ".framework" {
            SubmodulePath()(stem(DirName, native));
            TopFrameworkDir = operator(Dir);
        }
    }
        if !(true) { break; }
    }
    return TopFrameworkDir;
}

fn needModuleLookup(RequestingModule: *mut Module, HasSuggestedModule: bool) -> bool {
    return HasSuggestedModule || (RequestingModule && RequestingModule.NoUndeclaredIncludes);
}

fn DirectoryLookup::DoFrameworkLookup(self: *DirectoryLookup, Filename: str, HS: *mut HeaderSearch, SearchPath: *mut SmallVectorImpl<char>, RelativePath: *mut SmallVectorImpl<char>, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, InUserSpecifiedSystemFramework: *mut bool, IsFrameworkFound: *mut bool) -> OptionalFileEntryRef {
    let mut FileMgr: *mut FileManager = HS.getFileMgr();
    let mut SlashPos: u64 = Filename.find('/', 0);
    if SlashPos == npos {
        return nullopt;
    }
    let mut CacheEntry: *mut FrameworkCacheEntry = HS.LookupFrameworkCache(Filename[0..0 + SlashPos]);
    if CacheEntry.Directory && CacheEntry.Directory {
        return nullopt;
    }
    let mut FrameworkName: str = zeroed();
    FrameworkName() += operator(self.getFrameworkDirRef()).getName();
    if FrameworkName()() || () != '/' {
        FrameworkName()('/');
    }
    let mut ModuleName: str = Filename.begin()[0..SlashPos];
    FrameworkName() += ModuleName;
    FrameworkName() += ".framework/";
    if !CacheEntry.Directory {
        operator(NumFrameworkLookups);
        let mut Dir: auto = FileMgr.getOptionalDirectoryRef();
        if ! {
            return nullopt;
        }
        CacheEntry.Directory = self.getFrameworkDirRef();
        if self.getDirCharacteristic() == C_User {
            let mut SystemFrameworkMarker: str = zeroed();
            SystemFrameworkMarker() += ".system_framework";
            if FileMgr.getOptionalFileRef() {
                CacheEntry.IsUserSpecifiedSystemFramework = true;
            }
        }
    }
    InUserSpecifiedSystemFramework = CacheEntry.IsUserSpecifiedSystemFramework;
    IsFrameworkFound = CacheEntry.Directory.has_value();
    if RelativePath {
        RelativePath()();
        RelativePath()(Filename.begin() + SlashPos + 1, Filename.end());
    }
    let mut OrigSize: u32 = ();
    FrameworkName() += "Headers/";
    if SearchPath {
        SearchPath()();
        SearchPath()(() - 1);
    }
    FrameworkName()(Filename.begin() + SlashPos + 1, Filename.end());
    let mut File: auto = FileMgr.getOptionalFileRef(!SuggestedModule);
    if ! {
        let mut Private: *u8 = "Private";
        FrameworkName()(() + OrigSize, Private, Private + strlen(Private));
        if SearchPath {
            SearchPath()(SearchPath()() + OrigSize, Private, Private + strlen(Private));
        }
        File() = FileMgr.getOptionalFileRef(!SuggestedModule);
    }
    if File() && needModuleLookup(RequestingModule, SuggestedModule) {
        let mut FrameworkPath: str = ()();
        let mut FoundFramework: bool = false;
        while true {
            {
            let mut Dir: auto = FileMgr.getOptionalDirectoryRef(FrameworkPath, true);
            if ! {
                break;
            }
            if extension(FrameworkPath, native) == ".framework" {
                FoundFramework = true;
                break;
            }
            FrameworkPath = parent_path(FrameworkPath, native);
            if FrameworkPath.is_empty() {
                break;
            }
        }
            if !(true) { break; }
        }
        let mut IsSystem: bool = self.getDirCharacteristic() != C_User;
        if FoundFramework {
            if !HS.findUsableModuleForFrameworkHeader(*, FrameworkPath, RequestingModule, SuggestedModule, IsSystem) {
                return nullopt;
            }
        } else {
            if !HS.findUsableModuleForHeader(*, self.getDir(), RequestingModule, SuggestedModule, IsSystem) {
                return nullopt;
            }
        }
    }
    if File() {
        return *;
    }
    return nullopt;
}

