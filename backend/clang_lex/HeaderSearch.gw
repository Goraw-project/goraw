unsafe fn Closure_2::call(self: *mut Closure_2, Filename: str) {
            (*self.Index).try_emplace(Filename.lower(), (*self.i));
        }

struct Closure_3 {
    SearchPath: *mut *mut SmallVectorImpl<char>,
    cap_1: *DirectoryLookup,
    RelativePath: *mut *mut SmallVectorImpl<char>,
    Filename: *mut str,
    HS: *mut HeaderSearch,
    RequestingModule: *mut *mut Module,
    SuggestedModule: *mut *mut KnownHeader,
}

unsafe fn Closure_3::call(self: *mut Closure_3, File: FileEntryRef) -> auto {
        if (*self.SearchPath) {
            let mut SearchPathRef: str = self.getName();
            (*self.SearchPath).clear();
            (*self.SearchPath).append(SearchPathRef.begin(), SearchPathRef.end());
        }
        if (*self.RelativePath) {
            (*self.RelativePath).clear();
            (*self.RelativePath).append((*self.Filename).begin(), (*self.Filename).end());
        }
        if !(*self.HS).findUsableModuleForHeader(File, File.getFileEntry().getDir(), (*self.RequestingModule), (*self.SuggestedModule), self.isSystemHeaderDirectory()) {
            return nullopt;
        }
        return File;
    }

struct Closure_4 {
    Includer: *mut OptionalFileEntryRef,
    BuildSystemModule: *mut bool,
    cap_2: *mut HeaderSearch,
}

unsafe fn Closure_4::call(self: *mut Closure_4) -> bool {
                if !(*self.Includer) {
                    return (*self.BuildSystemModule);
                }
                let mut HFI: *HeaderFileInfo = self.getExistingFileInfo(operator((*self.Includer)));
                assert!(HFI, "includer without file info");
                return HFI.DirInfo != C_User;
            }

struct Closure_5 {
    ModulesEnabled: *mut bool,
    FileInfo: *mut HeaderFileInfo,
    cap_2: *mut HeaderSearch,
    File: *mut FileEntryRef,
}

unsafe fn Closure_5::call(self: *mut Closure_5) -> auto {
        if !(*self.ModulesEnabled) || (*self.FileInfo).isPragmaOnce {
            return false;
        }
        self.ModMap.resolveHeaderDirectives((*self.File).operator const clang::FileEntry *());
        if (*self.FileInfo).isTextualModuleHeader {
            return true;
        }
        if (*self.FileInfo).isCompilingModuleHeader {
            if (*self.FileInfo).isModuleHeader {
                if self.ModMap.isBuiltinHeader((*self.File)) {
                    return true;
                }
            } else {
                if (*self.FileInfo).getControllingMacro(self.ExternalLookup) {
                    return true;
                }
            }
        }
        return false;
    }

