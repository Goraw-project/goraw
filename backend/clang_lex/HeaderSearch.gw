fn moduleMembershipNeedsMerge(HFI: *HeaderFileInfo, Role: ModuleHeaderRole) -> bool {
    if isModular(Role) {
        return !HFI.isModuleHeader || HFI.isTextualModuleHeader;
    }
    if !HFI.isModuleHeader && (Role & TextualHeader) {
        return !HFI.isTextualModuleHeader;
    }
    return false;
}

fn mergeHeaderFileInfoModuleBits(HFI: *mut HeaderFileInfo, isModuleHeader: bool, isTextualModuleHeader: bool) {
    HFI.isModuleHeader |= isModuleHeader;
    if HFI.isModuleHeader {
        HFI.isTextualModuleHeader = false;
    } else {
        HFI.isTextualModuleHeader |= isTextualModuleHeader;
    }
}

fn HeaderFileInfo::mergeModuleMembership(self, Role: ModuleHeaderRole) {
    mergeHeaderFileInfoModuleBits(*self, isModular(Role), (Role & TextualHeader));
}

fn mergeHeaderFileInfo(HFI: *mut HeaderFileInfo, OtherHFI: *HeaderFileInfo) {
    assert!(OtherHFI.External, "expected to merge external HFI");
    HFI.isImport |= OtherHFI.isImport;
    HFI.isPragmaOnce |= OtherHFI.isPragmaOnce;
    mergeHeaderFileInfoModuleBits(HFI, OtherHFI.isModuleHeader, OtherHFI.isTextualModuleHeader);
    if !HFI.LazyControllingMacro.isValid() {
        HFI.LazyControllingMacro = OtherHFI.LazyControllingMacro;
    }
    HFI.DirInfo = OtherHFI.DirInfo;
    HFI.External = (!HFI.IsValid || HFI.External);
    HFI.IsValid = true;
}

fn HeaderSearch::getFileInfo(self, FE: FileEntryRef) -> *mut HeaderFileInfo {
    let mut HFI: *mut HeaderFileInfo = null;
    if self.ExternalSource && !HFI.Resolved {
        let mut ExternalHFI: HeaderFileInfo = self.ExternalSource.GetHeaderFileInfo(FE);
        if ExternalHFI.IsValid {
            HFI.Resolved = true;
            if ExternalHFI.External {
                mergeHeaderFileInfo(*HFI, ExternalHFI);
            }
        }
    }
    HFI.IsValid = true;
    HFI.External = false;
    return *HFI;
}

fn HeaderSearch::getExistingFileInfo(self: *HeaderSearch, FE: FileEntryRef) -> *HeaderFileInfo {
    let mut HFI: *mut HeaderFileInfo = null;
