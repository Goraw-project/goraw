    let mut MaybeReenterImportedFile: Closure_3 = Closure_3 { ModulesEnabled: &mut ModulesEnabled, FileInfo: &mut FileInfo, cap_2: self, File: &mut File };
    if isImport {
        FileInfo.isImport = true;
        if PP.alreadyIncluded(File) && !MaybeReenterImportedFile.call() {
            return false;
        }
    } else {
        if FileInfo.isPragmaOnce || (FileInfo.isImport && !MaybeReenterImportedFile.call()) {
            return false;
        }
    }
    if FileInfo.getControllingMacro(self.ExternalLookup) {
        ControllingMacro;
    } else {
        if if M { PP.isMacroDefinedInLocalModule(ControllingMacro, M) } else { PP.isMacroDefined(ControllingMacro) } {
            operator(NumMultiIncludeFileOptzn);
            return false;
        }
    }
    IsFirstIncludeOfFile = PP.markIncluded(File);
    return true;
}

