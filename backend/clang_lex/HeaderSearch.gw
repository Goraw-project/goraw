fn HeaderFileInfo::getControllingMacro(self, External: *mut ExternalPreprocessorSource) -> *IdentifierInfo {
    if self.LazyControllingMacro.isID() {
        if !External {
            return null;
        }
        self.LazyControllingMacro = External.GetIdentifier(self.LazyControllingMacro.getID());
        return self.LazyControllingMacro.getPtr();
    }
    let mut ControllingMacro: *mut IdentifierInfo = self.LazyControllingMacro.getPtr();
    if ControllingMacro && ControllingMacro.isOutOfDate() {
        assert!(External, "We must have an external source if we have a controlling macro that is out of date.");
        External.updateOutOfDateIdentifier(*ControllingMacro);
    }
    return ControllingMacro;
}

