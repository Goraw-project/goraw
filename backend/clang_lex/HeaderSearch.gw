fn HeaderSearch::loadSubdirectoryModuleMaps(self, SearchDir: *mut DirectoryLookup) {
    assert!(self.HSOpts.ImplicitModuleMaps, "Should not be loading subdirectory module maps");
    if SearchDir.haveSearchedAllModuleMaps() {
        return;
    }
    let mut EC: error_code = error_code {};
    let mut Dir: str = zeroed();
    self.FileMgr.makeAbsolutePath();
    let mut DirNative: str = zeroed();
    native();
    let mut FS: *mut FileSystem = self.FileMgr.getVirtualFileSystem();
    for let mut Dir: directory_iterator = FS.dir_begin(EC);
let mut DirEnd: directory_iterator = directory_iterator {}; Dir != DirEnd && !EC; Dir.increment(EC) {
        if operator(Dir).type() == regular_file {
            continue;
        }
        let mut IsFramework: bool = extension(operator(Dir).path(), native) == ".framework";
        if IsFramework == SearchDir.isFramework() {
            self.parseAndLoadModuleMapFile(operator(Dir).path(), SearchDir.isSystemHeaderDirectory(), true, SearchDir.isFramework());
        }
    }
    SearchDir.setSearchedAllModuleMaps(true);
}

