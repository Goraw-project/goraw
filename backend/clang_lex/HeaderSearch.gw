fn computeRelativePath(FileName: str, DirPath: str) -> str {
    if !FileName.starts_with(DirPath) {
        return "";
    }
    let mut RelativePath: str = FileName[DirPath.len..DirPath.len + npos];
    while !RelativePath.is_empty() && is_separator(RelativePath.front(), native) {
        RelativePath = RelativePath[1..1 + npos];
    }
    return RelativePath;
}

