fn HeaderSearch::LookupSubframeworkHeader(self, Filename: str, ContextFileEnt: FileEntryRef, SearchPath: *mut SmallVectorImpl<char>, RelativePath: *mut SmallVectorImpl<char>, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader) -> OptionalFileEntryRef {
