fn suggestModule(HS: *mut HeaderSearch, Module: KnownHeader, File: FileEntryRef, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader) -> bool {
    if RequestingModule && Module && RequestingModule.NoUndeclaredIncludes {
        HS.getModuleMap().resolveUses(RequestingModule, false);
        if !RequestingModule.directlyUses(Module.getModule()) {
            if HS.getModuleMap().isBuiltinHeader(File) {
                if SuggestedModule {
                    *SuggestedModule;
                }
                return true;
            }
            return false;
        }
    }
    if SuggestedModule {
        *SuggestedModule;
    }
    return true;
}

fn HeaderSearch::diagnoseUncoveredSymlink(self, File: FileEntryRef, Module: *mut KnownHeader, Root: *DirectoryEntry) {
    if !Module {
        return;
    }
    if !self.HSOpts.ImplicitModuleMaps || Module.getModule().isPartOfFramework() || !Module.getModule().isModuleMapModule() {
        return;
    }
    if self.Diags.isIgnored {
        return;
    }
    if File.isDeviceFile() || File.isNamedPipe() {
        return;
    }
    let mut AbsPath: str = zeroed();
    self.FileMgr.makeAbsolutePath();
    remove_dots(true);
    let mut LinkTarget: str = zeroed();
    if readlink() {
        return;
    }
    let mut FileName: str = File.getNameAsRequested();
    let mut DirName: str = FileName;
    let mut CurDir: *DirectoryEntry = null;
    while true {
        {
        DirName = parent_path(DirName, native);
        if DirName.is_empty() {
            break;
        }
        let mut Dir: OptionalDirectoryEntryRef = self.FileMgr.getOptionalDirectoryRef(DirName, true);
        if !Dir {
            break;
        }
        CurDir = operator(Dir).operator const clang::DirectoryEntry *();
        let mut DirState: auto = zeroed();
        if  {
            continue;
        }
        let mut RelativePath: str = computeRelativePath(FileName, DirName);
        if RelativePath.is_empty() {
            continue;
        }
        let mut RelativePathNative: str = zeroed();
        native();
        let mut MatchingModules: auto = zeroed();
        if !() {
            return;
        }
    }
        if !(CurDir != Root) { break; }
    }
    self.Diags << File.getName() <<  << Module.getModule().getFullModuleName(false);
    self.Diags;
}

fn HeaderSearch::findUsableModuleForHeader(self, File: FileEntryRef, Root: *DirectoryEntry, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, IsSystemHeaderDir: bool) -> bool {
    if needModuleLookup(RequestingModule, SuggestedModule) {
        if !self.HSOpts.LazyLoadModuleMaps {
            self.hasModuleMap(File.getNameAsRequested(), Root, IsSystemHeaderDir);
            let mut Module: KnownHeader = self.findModuleForHeader(File, true, false);
            self.diagnoseUncoveredSymlink(File, Module, Root);
            return suggestModule(*self, Module, File, RequestingModule, SuggestedModule);
        }
        let mut Module: KnownHeader = self.findModuleForHeader(File, true, false);
        if !Module {
            self.hasModuleMap(File.getNameAsRequested(), Root, IsSystemHeaderDir);
        }
        self.diagnoseUncoveredSymlink(File, Module, Root);
        return suggestModule(*self, Module, File, RequestingModule, SuggestedModule);
    }
    return true;
}

fn HeaderSearch::findUsableModuleForFrameworkHeader(self, File: FileEntryRef, FrameworkName: str, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, IsSystemFramework: bool) -> bool {
    if needModuleLookup(RequestingModule, SuggestedModule) {
        let mut SubmodulePath: string, 4> = zeroed();
        let mut TopFrameworkDir: OptionalDirectoryEntryRef = getTopFrameworkDir(self.FileMgr, FrameworkName);
        assert!(TopFrameworkDir, "Could not find the top-most framework dir");
        let mut ModuleName: str = stem(operator(TopFrameworkDir).getName(), native);
        self.loadFrameworkModule(ModuleName, operator(TopFrameworkDir), IsSystemFramework, true);
        let mut Module: KnownHeader = self.findModuleForHeader(File, true, false);
        return suggestModule(*self, Module, File, RequestingModule, SuggestedModule);
    }
    return true;
}

fn getPrivateModuleMap(File: FileEntryRef, FileMgr: *mut FileManager, Diags: *mut DiagnosticsEngine, Diagnose: bool) -> OptionalFileEntryRef {
    let mut Filename: str = filename(File.getName(), native);
    let mut PrivateFilename: str = zeroed();
    if Filename == "module.map" {
        append("module_private.map");
    } else if Filename == "module.modulemap" {
        append("module.private.modulemap");
    } else {
        return nullopt;
    }
    let mut PMMFile: auto = FileMgr.getOptionalFileRef();
    if PMMFile() {
        if Diagnose && Filename == "module.map" {
            Diags <<  << 1 << File.getDir().getName().ends_with(".framework");
        }
    }
    return ;
}

fn HeaderSearch::parseAndLoadModuleMapFile(self, File: FileEntryRef, IsSystem: bool, ImplicitlyDiscovered: bool, ID: FileID, Offset: *mut u32, OriginalModuleMapFile: str) -> bool {
