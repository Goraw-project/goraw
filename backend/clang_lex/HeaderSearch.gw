fn DirectoryLookup::LookupFile(self: *DirectoryLookup, Filename: *mut str, HS: *mut HeaderSearch, IncludeLoc: SourceLocation, SearchPath: *mut SmallVectorImpl<char>, RelativePath: *mut SmallVectorImpl<char>, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, InUserSpecifiedSystemFramework: *mut bool, IsFrameworkFound: *mut bool, IsInHeaderMap: *mut bool, MappedName: *mut SmallVectorImpl<char>, OpenFile: bool) -> OptionalFileEntryRef {
