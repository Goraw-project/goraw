        let mut RelativePath: str = computeRelativePath(FileName, DirName);
        let mut RelativePathNative: str = zeroed();
        native();
        let mut ModulesToLoad: auto = zeroed();
        let mut LoadedAny: bool = false;
        if LoadedAny {
            return true;
        }
    }
        if !(CurDir != Root) { break; }
    }
    return false;
}

