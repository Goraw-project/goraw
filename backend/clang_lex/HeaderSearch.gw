    VFSUsage: *mut []bool,
}

unsafe fn Closure_1::call(self: *mut Closure_1, FS: *mut FileSystem) {
        if dyn_cast(&mut FS) {
            RFS;
        } else {
            if !RFS.getOverlayFileDir().is_empty() {
                (*self.VFSUsage).push(RFS.hasBeenUsed());
                RFS.clearHasBeenUsed();
            }
        }
    }

