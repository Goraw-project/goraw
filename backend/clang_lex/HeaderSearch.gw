static mut NumIncluded: TrackingStatistic = TrackingStatistic { "file-search", "NumIncluded", "Number of attempted #includes." };

static mut NumMultiIncludeFileOptzn: TrackingStatistic = TrackingStatistic { "file-search", "NumMultiIncludeFileOptzn", "Number of #includes skipped due to the multi-include optimization." };

static mut NumFrameworkLookups: TrackingStatistic = TrackingStatistic { "file-search", "NumFrameworkLookups", "Number of framework lookups." };

static mut NumSubFrameworkLookups: TrackingStatistic = TrackingStatistic { "file-search", "NumSubFrameworkLookups", "Number of subframework lookups." };

fn HeaderFileInfo::getControllingMacro(self, External: *mut ExternalPreprocessorSource) -> *IdentifierInfo {
    if self.LazyControllingMacro.isID() {
        if !External {
            return null;
        }
        self.LazyControllingMacro = External.GetIdentifier(self.LazyControllingMacro.getID());
        return self.LazyControllingMacro.getPtr();
    }
    let mut ControllingMacro: *mut IdentifierInfo = self.LazyControllingMacro.getPtr();
    if ControllingMacro && ControllingMacro.isOutOfDate() {
        assert!(External, "We must have an external source if we have a controlling macro that is out of date.");
        External.updateOutOfDateIdentifier(*ControllingMacro);
    }
    return ControllingMacro;
}

fn ExternalHeaderFileInfoSource::~ExternalHeaderFileInfoSource(self) {}

fn HeaderSearch::PrintStats(self) {
    errs() << "\n*** HeaderSearch Stats:\n" << self.FileInfo.len << " files tracked.\n";
    let mut NumOnceOnlyFiles: u32 = 0;
    for x in self.FileInfo {
        NumOnceOnlyFiles += (HFI.isPragmaOnce || HFI.isImport);
    }
    errs() << "  " << NumOnceOnlyFiles << " #import/#pragma once files.\n";
    errs() << "  " << NumIncluded.operator unsigned long long() << " #include/#include_next/#import.\n" << "    " << NumMultiIncludeFileOptzn.operator unsigned long long() << " #includes skipped due to the multi-include optimization.\n";
    errs() << NumFrameworkLookups.operator unsigned long long() << " framework lookups.\n" << NumSubFrameworkLookups.operator unsigned long long() << " subframework lookups.\n";
}

fn HeaderSearch::SetSearchPaths(self, dirs: []DirectoryLookup, angledDirIdx: u32, systemDirIdx: u32, searchDirToHSEntry: DenseMap<unsigned int, unsigned int>) {
    assert!(angledDirIdx <= systemDirIdx && systemDirIdx <= dirs.len, "Directory indices are unordered");
    self.SearchDirs = move(dirs);
    self.SearchDirsUsage.assign(self.SearchDirs.len, false);
    self.AngledDirIdx = angledDirIdx;
    self.SystemDirIdx = systemDirIdx;
    self.SearchDirToHSEntry = move(searchDirToHSEntry);
    self.indexInitialHeaderMaps();
}

fn HeaderSearch::AddSearchPath(self, dir: *DirectoryLookup, isAngled: bool) {
    let mut idx: u32 = if isAngled { self.SystemDirIdx } else { self.AngledDirIdx };
    self.SearchDirs.insert(self.SearchDirs.begin() + idx, dir);
    self.SearchDirsUsage.insert(self.SearchDirsUsage.begin() + idx, false);
    if !isAngled {
        self.AngledDirIdx += 1;
    }
    self.SystemDirIdx += 1;
}

fn HeaderSearch::computeUserEntryUsage(self: *HeaderSearch) -> []bool {
    let mut UserEntryUsage: []bool = []bool { self.HSOpts.UserEntries.len, allocator<bool> {} };
    for let mut I: u32 = 0;
let mut E: u32 = self.SearchDirsUsage.len; I < E; I += 1 {
        if self.SearchDirsUsage[I] {
            let mut UserEntryIdxIt: const_iterator = self.SearchDirToHSEntry.find(I);
            if UserEntryIdxIt != self.SearchDirToHSEntry.end() {
                UserEntryUsage[operator(UserEntryIdxIt).second] = true;
            }
        }
    }
    return UserEntryUsage;
}

fn HeaderSearch::collectVFSUsageAndClear(self: *HeaderSearch) -> []bool {
    let mut VFSUsage: []bool = []bool {};
    if !self.getHeaderSearchOpts().ModulesIncludeVFSUsage {
        return VFSUsage;
    }
    let mut RootFS: *mut FileSystem = self.FileMgr.getVirtualFileSystem();
    RootFS.visit(VisitCallbackTy { Closure_1 { VFSUsage: &mut VFSUsage }, null, null });
    assert!(VFSUsage.len == self.getHeaderSearchOpts().VFSOverlayFiles.len, "A different number of RedirectingFileSystem's were present than -ivfsoverlay options passed to Clang!");
    reverse(VFSUsage.begin(), VFSUsage.end());
    return VFSUsage;
}

fn HeaderSearch::CreateHeaderMap(self, FE: FileEntryRef) -> *HeaderMap {
    if !self.HeaderMaps.is_empty() {
        for let mut i: u32 = 0;
let mut e: u32 = self.HeaderMaps.len; i != e; i += 1 {
            if self.HeaderMaps[i].first == FE {
                return self.HeaderMaps[i].second.get();
            }
        }
    }
    if Create(FE, self.FileMgr) {
        HM;
    } else {
        self.HeaderMaps.push(FE, move(HM));
        return self.HeaderMaps.back().second.get();
    }
    return null;
}

fn HeaderSearch::getHeaderMapFileNames(self: *HeaderSearch, Names: *mut string>) {
    for HM in self.HeaderMaps {
        Names.push(HM.first.getName()[0..allocator<char> {}]);
    }
}

fn HeaderSearch::getCachedModuleFileName(self, Module: *mut Module) -> ModuleFileName {
    let mut ModuleMap: OptionalFileEntryRef = self.getModuleMap().getModuleMapFileForUniquing(Module);
    if !ModuleMap {
        return ModuleFileName {};
    }
    return self.getCachedModuleFileName(Module.Name, operator(ModuleMap).getNameAsRequested());
}

fn HeaderSearch::getPrebuiltModuleFileName(self, ModuleName: str, FileMapOnly: bool) -> ModuleFileName {
    let mut i: const_iterator = self.HSOpts.PrebuiltModuleFiles.find(ModuleName);
    if !i == self.HSOpts.PrebuiltModuleFiles.end() {
        return makeExplicit(operator(i).second);
    }
    if FileMapOnly || self.HSOpts.PrebuiltModulePaths.is_empty() {
        return ModuleFileName {};
    }
    for Dir in self.HSOpts.PrebuiltModulePaths {
        let mut Result: str = Dir;
        self.FileMgr.makeAbsolutePath(Result, false);
        if ModuleName.contains(':') {
            append(Result, ModuleName.split(':').first + "-" + ModuleName.split(':').second + ".pcm", "", "", "");
        } else {
            append(Result, ModuleName + ".pcm", "", "", "");
        }
        if self.getFileMgr().getOptionalFileRef(Result.operator StringRef(), false, true, true) {
            return makeExplicit(Result.operator StringRef());
        }
    }
    return ModuleFileName {};
}

fn HeaderSearch::getPrebuiltImplicitModuleFileName(self, Module: *mut Module) -> ModuleFileName {
    let mut ModuleMap: OptionalFileEntryRef = self.getModuleMap().getModuleMapFileForUniquing(Module);
    let mut ModuleName: str = Module.Name;
    let mut ModuleMapPath: str = operator(ModuleMap).getName();
    for Dir in self.HSOpts.PrebuiltModulePaths {
        let mut CachePath: str = Dir;
        self.FileMgr.makeAbsolutePath(CachePath, false);
        let mut FileName: ModuleFileName = self.getCachedModuleFileNameImpl(ModuleName, ModuleMapPath, CachePath.operator StringRef());
        if !FileName.is_empty() && self.getFileMgr().getOptionalFileRef(FileName.operator StringRef(), false, true, true) {
            return makeExplicit(FileName.operator StringRef());
        }
    }
    return ModuleFileName {};
}

fn HeaderSearch::getCachedModuleFileName(self, ModuleName: str, ModuleMapPath: str) -> ModuleFileName {
    return self.getCachedModuleFileNameImpl(ModuleName, ModuleMapPath, self.getNormalizedModuleCachePath());
}

fn HeaderSearch::getCachedModuleFileNameImpl(self, ModuleName: str, ModuleMapPath: str, CachePath: str) -> ModuleFileName {
    if CachePath.is_empty() {
        return ModuleFileName {};
    }
    let mut Result: str = CachePath;
    let mut SuffixBegin: u32 = Result.len;
    if self.HSOpts.DisableModuleHash {
        append(Result, ModuleName + ".pcm", "", "", "");
    } else {
        append(Result, self.ContextHash, "", "", "");
        let mut CanonicalPath: str = ModuleMapPath;
        if self.getModuleMap().canonicalizeModuleMapPath(CanonicalPath) {
            return ModuleFileName {};
        }
        let mut Hash: u64 = xxh3_64bits(CanonicalPath.operator StringRef());
        let mut HashStr: str = "";
        APInt { 64, Hash, false, false }.toStringUnsigned(HashStr, 36);
        append(Result, ModuleName + "-" + HashStr + ".pcm", "", "", "");
    }
    return makeImplicit(Result.operator StringRef(), Result.len - SuffixBegin);
}

fn HeaderSearch::lookupModule(self, ModuleName: str, ImportLoc: SourceLocation, AllowSearch: bool, AllowExtraModuleMapSearch: bool) -> *mut Module {
    let mut Module: *mut Module = self.ModMap.findOrLoadModule(ModuleName);
    if Module || !AllowSearch || !self.HSOpts.ImplicitModuleMaps {
        return Module;
    }
    let mut SearchName: str = ModuleName;
    Module = self.lookupModule(ModuleName, SearchName, ImportLoc, AllowExtraModuleMapSearch);
    if !Module && SearchName.consume_back("_Private") {
        Module = self.lookupModule(ModuleName, SearchName, ImportLoc, AllowExtraModuleMapSearch);
    }
    if !Module && SearchName.consume_back("Private") {
        Module = self.lookupModule(ModuleName, SearchName, ImportLoc, AllowExtraModuleMapSearch);
    }
    return Module;
}

fn HeaderSearch::lookupModule(self, ModuleName: str, SearchName: str, ImportLoc: SourceLocation, AllowExtraModuleMapSearch: bool) -> *mut Module {
    let mut Module: *mut Module = null;
    for Dir in self.search_dir_range() {
        if Dir.isFramework() {
            let mut FrameworkDirName: str = "";
            operator(FrameworkDirName, operator(Dir.getFrameworkDirRef()).getName());
            append(FrameworkDirName, SearchName + ".framework", "", "", "");
            if self.FileMgr.getOptionalDirectoryRef(FrameworkDirName.operator StringRef(), true) {
                FrameworkDir;
            } else {
                let mut IsSystem: bool = Dir.getDirCharacteristic() != C_User;
                Module = self.loadFrameworkModule(ModuleName, operator(FrameworkDir), IsSystem, true);
                if Module {
                    break;
                }
            }
        }
        if !Dir.isNormalDir() {
            continue;
        }
        let mut IsSystem: bool = Dir.isSystemHeaderDirectory();
        let mut NormalDir: DirectoryEntryRef = operator(Dir.getDirRef());
        if self.parseModuleMapFile(NormalDir, IsSystem, true, false) == MMR_NewlyProcessed {
            Module = self.ModMap.findOrLoadModule(ModuleName);
            if Module {
                break;
            }
        }
        let mut NestedModuleMapDirName: str = "";
        NestedModuleMapDirName = operator(Dir.getDirRef()).getName();
        append(NestedModuleMapDirName, ModuleName, "", "", "");
        if self.parseModuleMapFile(NestedModuleMapDirName.operator StringRef(), IsSystem, true, false) == MMR_NewlyProcessed {
            Module = self.ModMap.findOrLoadModule(ModuleName);
            if Module {
                break;
            }
        }
        if self.HSOpts.AllowModuleMapSubdirectorySearch {
            if Dir.haveSearchedAllModuleMaps() {
                continue;
            }
            if AllowExtraModuleMapSearch {
                self.loadSubdirectoryModuleMaps(Dir);
            }
            Module = self.ModMap.findOrLoadModule(ModuleName);
            if Module {
                break;
            }
        }
    }
    return Module;
}

fn HeaderSearch::indexInitialHeaderMaps(self) {
    let mut Index: BumpPtrAllocator> = self.SearchDirs.len;
    for let mut i: u32 = 0; i != self.SearchDirs.len; i += 1 {
        let mut Dir: *mut DirectoryLookup = self.SearchDirs[i];
        if !Dir.isHeaderMap() {
            self.SearchDirHeaderMapIndex = move(Index);
            self.FirstNonHeaderMapSearchDirIdx = i;
            break;
        }
        let mut Callback: Closure_2 = Closure_2 { Index: &mut Index, i: &mut i };
        Dir.getHeaderMap().forEachKey(Callback);
    }
}

fn DirectoryLookup::getName(self: *DirectoryLookup) -> str {
    if self.isNormalDir() {
        return operator(self.getDirRef()).getName();
    }
    if self.isFramework() {
        return operator(self.getFrameworkDirRef()).getName();
    }
    assert!(self.isHeaderMap(), "Unknown DirectoryLookup");
    return self.getHeaderMap().getFileName();
}

fn HeaderSearch::getFileAndSuggestModule(self, FileName: str, IncludeLoc: SourceLocation, Dir: *DirectoryEntry, IsSystemHeaderDir: bool, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, OpenFile: bool, CacheFailures: bool) -> OptionalFileEntryRef {
    let mut File: Expected<FileEntryRef> = self.getFileMgr().getFileRef(FileName, OpenFile, CacheFailures, true);
    if !File {
        let mut EC: error_code = errorToErrorCode(File.takeError());
        if !EC == no_such_file_or_directory && !EC == invalid_argument && !EC == is_a_directory && !EC == not_a_directory {
            self.Diags.Report(IncludeLoc, err_cannot_open_file) << FileName << EC.message();
        }
        return nullopt;
    }
    if !self.findUsableModuleForHeader(operator(File), if Dir { Dir } else { operator(File).getFileEntry().getDir() }, RequestingModule, SuggestedModule, IsSystemHeaderDir) {
        return nullopt;
    }
    return operator(File);
}

fn DirectoryLookup::LookupFile(self: *DirectoryLookup, Filename: *mut str, HS: *mut HeaderSearch, IncludeLoc: SourceLocation, SearchPath: *mut SmallVectorImpl<char>, RelativePath: *mut SmallVectorImpl<char>, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, InUserSpecifiedSystemFramework: *mut bool, IsFrameworkFound: *mut bool, IsInHeaderMap: *mut bool, MappedName: *mut SmallVectorImpl<char>, OpenFile: bool) -> OptionalFileEntryRef {
    InUserSpecifiedSystemFramework = false;
    IsInHeaderMap = false;
    MappedName.clear();
    let mut TmpDir: str = "";
    if self.isNormalDir() {
        TmpDir = operator(self.getDirRef()).getName();
        append(TmpDir, Filename, "", "", "");
        if SearchPath {
            let mut SearchPathRef: str = operator(self.getDirRef()).getName();
            SearchPath.clear();
            SearchPath.append(SearchPathRef.begin(), SearchPathRef.end());
        }
        if RelativePath {
            RelativePath.clear();
            RelativePath.append(Filename.begin(), Filename.end());
        }
        return HS.getFileAndSuggestModule(TmpDir.operator StringRef(), IncludeLoc, self.getDir(), self.isSystemHeaderDirectory(), RequestingModule, SuggestedModule, OpenFile, true);
    }
    if self.isFramework() {
        return self.DoFrameworkLookup(Filename, HS, SearchPath, RelativePath, RequestingModule, SuggestedModule, InUserSpecifiedSystemFramework, IsFrameworkFound);
    }
    assert!(self.isHeaderMap(), "Unknown directory lookup");
    let mut HM: *HeaderMap = self.getHeaderMap();
    let mut Path: str = "";
    let mut Dest: str = HM.lookupFilename(Filename, Path);
    if Dest.is_empty() {
        return nullopt;
    }
    IsInHeaderMap = true;
    let mut FixupSearchPathAndFindUsableModule: Closure_3 = Closure_3 { SearchPath: &mut SearchPath, cap_1: self, RelativePath: &mut RelativePath, Filename: &mut Filename, HS: &mut HS, RequestingModule: &mut RequestingModule, SuggestedModule: &mut SuggestedModule };
    if is_relative(Dest, native) {
        MappedName.append(Dest.begin(), Dest.end());
        Filename = MappedName.begin()[0..MappedName.len];
        Dest = HM.lookupFilename(Filename, Path);
    }
    if HS.getFileMgr().getOptionalFileRef(Dest, OpenFile, true, true) {
        Res;
    } else {
        return FixupSearchPathAndFindUsableModule.call(operator(Res));
    }
    HS.noteLookupUsage(HS.searchDirIdx(*self), IncludeLoc);
    return nullopt;
}

fn getTopFrameworkDir(FileMgr: *mut FileManager, DirName: str, SubmodulePath: *mut string>) -> OptionalDirectoryEntryRef {
    assert!(extension(DirName, native) == ".framework", "Not a framework directory");
    let mut TopFrameworkDir: OptionalDirectoryEntryRef = FileMgr.getOptionalDirectoryRef(DirName, true);
    if TopFrameworkDir {
        DirName = FileMgr.getCanonicalName(operator(TopFrameworkDir));
    }
    while true {
        {
        DirName = parent_path(DirName, native);
        if DirName.is_empty() {
            break;
        }
        let mut Dir: OptionalDirectoryEntryRef = FileMgr.getOptionalDirectoryRef(DirName, true);
        if !Dir {
            break;
        }
        if extension(DirName, native) == ".framework" {
            SubmodulePath.push(stem(DirName, native)[0..allocator<char> {}]);
            TopFrameworkDir = operator(Dir);
        }
    }
        if !(true) { break; }
    }
    return TopFrameworkDir;
}

fn needModuleLookup(RequestingModule: *mut Module, HasSuggestedModule: bool) -> bool {
    return HasSuggestedModule || (RequestingModule && RequestingModule.NoUndeclaredIncludes);
}

fn DirectoryLookup::DoFrameworkLookup(self: *DirectoryLookup, Filename: str, HS: *mut HeaderSearch, SearchPath: *mut SmallVectorImpl<char>, RelativePath: *mut SmallVectorImpl<char>, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, InUserSpecifiedSystemFramework: *mut bool, IsFrameworkFound: *mut bool) -> OptionalFileEntryRef {
    let mut FileMgr: *mut FileManager = HS.getFileMgr();
    let mut SlashPos: u64 = Filename.find('/', 0);
    if SlashPos == npos {
        return nullopt;
    }
    let mut CacheEntry: *mut FrameworkCacheEntry = HS.LookupFrameworkCache(Filename[0..0 + SlashPos]);
    if CacheEntry.Directory && CacheEntry.Directory != self.getFrameworkDirRef() {
        return nullopt;
    }
    let mut FrameworkName: str = "";
    operator(FrameworkName, operator(self.getFrameworkDirRef()).getName());
    if FrameworkName.is_empty() || FrameworkName.back() != '/' {
        FrameworkName.push('/');
    }
    let mut ModuleName: str = Filename.begin()[0..SlashPos];
    operator(FrameworkName, ModuleName);
    operator(FrameworkName, ".framework/");
    if !CacheEntry.Directory {
        operator(NumFrameworkLookups);
        let mut Dir: OptionalDirectoryEntryRef = FileMgr.getOptionalDirectoryRef(FrameworkName.operator StringRef(), true);
        if !Dir {
            return nullopt;
        }
        CacheEntry.Directory = self.getFrameworkDirRef();
        if self.getDirCharacteristic() == C_User {
            let mut SystemFrameworkMarker: str = FrameworkName;
            operator(SystemFrameworkMarker, ".system_framework");
            if FileMgr.getOptionalFileRef(SystemFrameworkMarker.operator StringRef(), false, true, true) {
                CacheEntry.IsUserSpecifiedSystemFramework = true;
            }
        }
    }
    InUserSpecifiedSystemFramework = CacheEntry.IsUserSpecifiedSystemFramework;
    IsFrameworkFound = CacheEntry.Directory.has_value();
    if RelativePath {
        RelativePath.clear();
        RelativePath.append(Filename.begin() + SlashPos + 1, Filename.end());
    }
    let mut OrigSize: u32 = FrameworkName.len;
    operator(FrameworkName, "Headers/");
    if SearchPath {
        SearchPath.clear();
        SearchPath.append(FrameworkName.begin(), FrameworkName.end() - 1);
    }
    FrameworkName.append(Filename.begin() + SlashPos + 1, Filename.end());
    let mut File: OptionalFileEntryRef = FileMgr.getOptionalFileRef(FrameworkName.operator StringRef(), !SuggestedModule, true, true);
    if !File {
        let mut Private: *u8 = "Private";
        FrameworkName.insert(FrameworkName.begin() + OrigSize, Private, Private + strlen(Private));
        if SearchPath {
            SearchPath.insert(SearchPath.begin() + OrigSize, Private, Private + strlen(Private));
        }
        File = FileMgr.getOptionalFileRef(FrameworkName.operator StringRef(), !SuggestedModule, true, true);
    }
    if File && needModuleLookup(RequestingModule, SuggestedModule) {
        let mut FrameworkPath: str = operator(File).getDir().getName();
        let mut FoundFramework: bool = false;
        while true {
            {
            let mut Dir: OptionalDirectoryEntryRef = FileMgr.getOptionalDirectoryRef(FrameworkPath, true);
            if !Dir {
                break;
            }
            if extension(FrameworkPath, native) == ".framework" {
                FoundFramework = true;
                break;
            }
            FrameworkPath = parent_path(FrameworkPath, native);
            if FrameworkPath.is_empty() {
                break;
            }
        }
            if !(true) { break; }
        }
        let mut IsSystem: bool = self.getDirCharacteristic() != C_User;
        if FoundFramework {
            if !HS.findUsableModuleForFrameworkHeader(operator(File), FrameworkPath, RequestingModule, SuggestedModule, IsSystem) {
                return nullopt;
            }
        } else {
            if !HS.findUsableModuleForHeader(operator(File), self.getDir(), RequestingModule, SuggestedModule, IsSystem) {
                return nullopt;
            }
        }
    }
    if File {
        return operator(File);
    }
    return nullopt;
}

fn HeaderSearch::cacheLookupSuccess(self, CacheLookup: *mut LookupFileCacheInfo, HitIt: ConstSearchDirIterator, Loc: SourceLocation) {
    CacheLookup.HitIt = HitIt;
    self.noteLookupUsage(HitIt.Idx, Loc);
}

fn HeaderSearch::noteLookupUsage(self, HitIdx: u32, Loc: SourceLocation) {
    self.SearchDirsUsage[HitIdx] = true;
    let mut UserEntryIdxIt: iterator = self.SearchDirToHSEntry.find(HitIdx);
    if UserEntryIdxIt != self.SearchDirToHSEntry.end() {
        self.Diags.Report(Loc, remark_pp_search_path_usage) << self.HSOpts.UserEntries[operator(UserEntryIdxIt).second].Path;
    }
}

fn HeaderSearch::setTarget(self, Target: *TargetInfo) {
    self.ModMap.setTarget(Target);
}

fn checkMSVCHeaderSearch(Diags: *mut DiagnosticsEngine, MSFE: OptionalFileEntryRef, FE: *FileEntry, IncludeLoc: SourceLocation) -> bool {
    if MSFE && FE != operator(MSFE) {
        Diags.Report(IncludeLoc, ext_pp_include_search_ms) << operator(MSFE).getName();
        return true;
    }
    return false;
}

fn copyString(Str: str, Alloc: *mut BumpPtrAllocator) -> *u8 {
    assert!(!Str.is_empty();
    let mut CopyStr: *mut u8 = Alloc.Allocate(Str.len + 1);
    copy(Str.begin(), Str.end(), CopyStr);
    CopyStr[Str.len] = 0;
    return CopyStr;
}

fn isFrameworkStylePath(Path: str, IsPrivateHeader: *mut bool, FrameworkName: *mut SmallVectorImpl<char>, IncludeSpelling: *mut SmallVectorImpl<char>) -> bool {
    let mut I: const_iterator = begin(Path, native);
    let mut E: const_iterator = end(Path);
    IsPrivateHeader = false;
    let mut FoundComp: i32 = 0;
    while !I == E {
        if operator(I) == "Headers" {
            FoundComp += 1;
        } else if operator(I) == "PrivateHeaders" {
            FoundComp += 1;
            IsPrivateHeader = true;
        } else if operator(operator(I)).ends_with(".framework") {
            let mut Name: str = operator(operator(I)).drop_back(10);
            FrameworkName.clear();
            FrameworkName.append(Name.begin(), Name.end());
            IncludeSpelling.clear();
            IncludeSpelling.append(Name.begin(), Name.end());
            FoundComp = 1;
        } else if FoundComp >= 2 {
            IncludeSpelling.push('/');
            IncludeSpelling.append(operator(operator(I)).begin(), operator(operator(I)).end());
        }
        operator(I);
    }
    return !FrameworkName.is_empty() && FoundComp >= 2;
}

fn diagnoseFrameworkInclude(Diags: *mut DiagnosticsEngine, IncludeLoc: SourceLocation, Includer: str, IncludeFilename: str, IncludeFE: FileEntryRef, isAngled: bool, FoundByHeaderMap: bool) {
    let mut IsIncluderPrivateHeader: bool = false;
    let mut FromFramework: str = "";
    let mut ToFramework: str = "";
    let mut FromIncludeSpelling: str = "";
    let mut ToIncludeSpelling: str = "";
    if !isFrameworkStylePath(Includer, IsIncluderPrivateHeader, FromFramework, FromIncludeSpelling) {
        return;
    }
    let mut IsIncludeePrivateHeader: bool = false;
    let mut IsIncludeeInFramework: bool = isFrameworkStylePath(IncludeFE.getName(), IsIncludeePrivateHeader, ToFramework, ToIncludeSpelling);
    if !isAngled && !FoundByHeaderMap {
        let mut NewInclude: str = "<";
        if IsIncludeeInFramework {
            operator(NewInclude, ToIncludeSpelling.operator StringRef());
            operator(NewInclude, ">");
        } else {
            operator(NewInclude, IncludeFilename);
            operator(NewInclude, ">");
        }
        Diags.Report(IncludeLoc, warn_quoted_include_in_framework_header) << IncludeFilename << CreateReplacement(IncludeLoc, NewInclude.operator StringRef());
    }
    if !IsIncluderPrivateHeader && IsIncludeeInFramework && IsIncludeePrivateHeader && FromFramework == ToFramework {
        Diags.Report(IncludeLoc, warn_framework_include_private_from_public) << IncludeFilename;
    }
}

fn HeaderSearch::diagnoseHeaderShadowing(self, Filename: str, FE: FileEntryRef, IncludeLoc: SourceLocation, FromDir: ConstSearchDirIterator, Includers: pair<OptionalFileEntryRef, DirectoryEntryRef>>, isAngled: bool, IncluderLoopIndex: i32, MainLoopIt: ConstSearchDirIterator) {
    if self.Diags.isIgnored(warn_header_shadowing, IncludeLoc) {
        return;
    }
    if MainLoopIt && operator(operator(MainLoopIt)).isSystemHeaderDirectory() {
        return;
    }
    if !self.ShadowCheckedHeaders[Filename].insert(FE.operator const clang::FileEntry *()).second {
        return;
    }
    if !MainLoopIt {
        for let mut i: u64 = IncluderLoopIndex + 1; i < Includers.len; i += 1 {
            let mut IncluderAndDir: *DirectoryEntryRef> const = Includers[i];
            let mut TmpDir: str = IncluderAndDir.second.getName();
            append(TmpDir, Filename, "", "", "");
            if self.getFileMgr().getOptionalFileRef(TmpDir.operator StringRef(), false, true, true) {
                File;
            } else {
                if operator(File) == FE {
                    continue;
                }
                self.Diags.Report(IncludeLoc, warn_header_shadowing) << Filename << FE.getDir().getName() << IncluderAndDir.second.getName();
                return;
            }
        }
    }
    let mut It: ConstSearchDirIterator = if isAngled { self.angled_dir_begin() } else { self.search_dir_begin() };
    if MainLoopIt {
        It = next(MainLoopIt, 1);
    } else if FromDir {
        It = FromDir;
    }
    for ; !It == self.search_dir_end(); operator(It) {
        if operator(operator(It)).getDirCharacteristic() != C_User {
            continue;
        }
        let mut TmpPath: str = operator(operator(It)).getName();
        append(TmpPath, Filename, "", "", "");
        if self.getFileMgr().getOptionalFileRef(TmpPath.operator StringRef(), false, true, true) {
            File;
        } else {
            if operator(File) == FE {
                continue;
            }
            self.Diags.Report(IncludeLoc, warn_header_shadowing) << Filename << FE.getDir().getName() << operator(operator(It)).getName();
            return;
        }
    }
}

fn HeaderSearch::LookupFile(self, Filename: str, IncludeLoc: SourceLocation, isAngled: bool, FromDir: ConstSearchDirIterator, CurDirArg: *mut ConstSearchDirIterator, Includers: pair<OptionalFileEntryRef, DirectoryEntryRef>>, SearchPath: *mut SmallVectorImpl<char>, RelativePath: *mut SmallVectorImpl<char>, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, IsMapped: *mut bool, IsFrameworkFound: *mut bool, SkipCache: bool, BuildSystemModule: bool, OpenFile: bool, CacheFailures: bool) -> OptionalFileEntryRef {
    let mut CurDirLocal: ConstSearchDirIterator = null;
    let mut CurDir: *mut ConstSearchDirIterator = if CurDirArg { *CurDirArg } else { CurDirLocal };
    if IsMapped {
        *IsMapped = false;
    }
    if IsFrameworkFound {
        *IsFrameworkFound = false;
    }
    if SuggestedModule {
        *SuggestedModule = KnownHeader {};
    }
    if is_absolute(Filename, native) {
        CurDir = null;
        if FromDir {
            return nullopt;
        }
        if SearchPath {
            SearchPath.clear();
        }
        if RelativePath {
            RelativePath.clear();
            RelativePath.append(Filename.begin(), Filename.end());
        }
        return self.getFileAndSuggestModule(Filename, IncludeLoc, null, false, RequestingModule, SuggestedModule, OpenFile, CacheFailures);
    }
    let mut MSSuggestedModule: KnownHeader = KnownHeader {};
    let mut MSFE: OptionalFileEntryRef = OptionalFileEntryRef {};
    if !Includers.is_empty() && !isAngled {
        let mut TmpDir: str = "";
        let mut First: bool = true;
        for IncluderAndDir in Includers {
            let mut Includer: OptionalFileEntryRef = IncluderAndDir.first;
            TmpDir = IncluderAndDir.second.getName();
            append(TmpDir, Filename, "", "", "");
            let mut IncluderIsSystemHeader: bool = Closure_4 { Includer: &mut Includer, BuildSystemModule: &mut BuildSystemModule, cap_2: self }.call();
            if self.getFileAndSuggestModule(TmpDir.operator StringRef(), IncludeLoc, IncluderAndDir.second.operator const clang::DirectoryEntry *(), IncluderIsSystemHeader, RequestingModule, SuggestedModule, true, true) {
                FE;
            } else {
                self.diagnoseHeaderShadowing(Filename, operator(FE), IncludeLoc, FromDir, Includers, isAngled, &mut IncluderAndDir - Includers.begin(), null);
                if !Includer {
                    assert!(First, "only first includer can have no file");
                    return FE;
                }
                let mut FromHFI: *HeaderFileInfo = self.getExistingFileInfo(operator(Includer));
                assert!(FromHFI, "includer without file info");
                let mut DirInfo: u32 = FromHFI.DirInfo;
                let mut ToHFI: *mut HeaderFileInfo = self.getFileInfo(operator(FE));
                ToHFI.DirInfo = DirInfo;
                if SearchPath {
                    let mut SearchPathRef: str = IncluderAndDir.second.getName();
                    SearchPath.clear();
                    SearchPath.append(SearchPathRef.begin(), SearchPathRef.end());
                }
                if RelativePath {
                    RelativePath.clear();
                    RelativePath.append(Filename.begin(), Filename.end());
                }
                if First {
                    diagnoseFrameworkInclude(self.Diags, IncludeLoc, IncluderAndDir.second.getName(), Filename, operator(FE), false, false);
                    return FE;
                }
                if self.Diags.isIgnored(ext_pp_include_search_ms, IncludeLoc) {
                    return FE;
                } else {
                    MSFE = FE;
                    if SuggestedModule {
                        MSSuggestedModule = *SuggestedModule;
                        *SuggestedModule = KnownHeader {};
                    }
                    break;
                }
            }
            First = false;
        }
    }
    CurDir = null;
    let mut It: ConstSearchDirIterator = if isAngled { self.angled_dir_begin() } else { self.search_dir_begin() };
    if FromDir {
        It = FromDir;
    }
    let mut CacheLookup: *mut LookupFileCacheInfo = self.LookupFileCache[Filename];
    let mut NextIt: ConstSearchDirIterator = next(It, 1);
    if !SkipCache {
        if CacheLookup.StartIt == NextIt && CacheLookup.RequestingModule == RequestingModule {
            if CacheLookup.HitIt {
                It = CacheLookup.HitIt;
            }
            if CacheLookup.MappedName {
                Filename = CacheLookup.MappedName;
                if IsMapped {
                    *IsMapped = true;
                }
            }
        } else {
            CacheLookup.reset(RequestingModule, NextIt);
            if It == self.search_dir_begin() && self.FirstNonHeaderMapSearchDirIdx > 0 {
                let mut Iter: iterator = self.SearchDirHeaderMapIndex.find(Filename.lower());
                if Iter == self.SearchDirHeaderMapIndex.end() {
                    It = self.search_dir_nth(self.FirstNonHeaderMapSearchDirIdx);
                } else {
                    It = self.search_dir_nth(operator(Iter).second);
                }
            }
        }
    } else {
        CacheLookup.reset(RequestingModule, NextIt);
    }
    let mut MappedName: str = "";
    for ; !It == self.search_dir_end(); operator(It) {
        let mut InUserSpecifiedSystemFramework: bool = false;
        let mut IsInHeaderMap: bool = false;
        let mut IsFrameworkFoundInDir: bool = false;
        let mut File: OptionalFileEntryRef = operator(operator(It)).LookupFile(Filename, *self, IncludeLoc, SearchPath, RelativePath, RequestingModule, SuggestedModule, InUserSpecifiedSystemFramework, IsFrameworkFoundInDir, IsInHeaderMap, MappedName, OpenFile);
        if !MappedName.is_empty() {
            assert!(IsInHeaderMap, "MappedName should come from a header map");
            CacheLookup.MappedName = copyString(MappedName.operator StringRef(), self.LookupFileCache.getAllocator());
        }
        if IsMapped {
            *IsMapped |= (!MappedName.is_empty() || (IsInHeaderMap && File));
        }
        if IsFrameworkFound {
            *IsFrameworkFound |= (IsFrameworkFoundInDir && !CacheLookup.MappedName);
        }
        if !File {
            continue;
        }
        if !MSFE {
            self.diagnoseHeaderShadowing(Filename, operator(File), IncludeLoc, FromDir, Includers, isAngled, -1, It);
        }
        CurDir = It;
        self.IncludeNames[operator(File).operator const clang::FileEntry *()] = Filename;
        let mut HFI: *mut HeaderFileInfo = self.getFileInfo(operator(File));
        HFI.DirInfo = operator(operator(CurDir)).getDirCharacteristic();
        if HFI.DirInfo == C_User && InUserSpecifiedSystemFramework {
            HFI.DirInfo = C_System;
        }
        for let mut j: u32 = self.SystemHeaderPrefixes.len; j; j -= 1 {
            if Filename.starts_with(self.SystemHeaderPrefixes[j - 1].first) {
                HFI.DirInfo = if self.SystemHeaderPrefixes[j - 1].second { C_System } else { C_User };
                break;
            }
        }
        if checkMSVCHeaderSearch(self.Diags, MSFE, &mut operator(File).getFileEntry(), IncludeLoc) {
            if SuggestedModule {
                *SuggestedModule = MSSuggestedModule;
            }
            return MSFE;
        }
        let mut FoundByHeaderMap: bool = if !IsMapped { false } else { *IsMapped };
        if !Includers.is_empty() {
            diagnoseFrameworkInclude(self.Diags, IncludeLoc, Includers.front().second.getName(), Filename, operator(File), isAngled, FoundByHeaderMap);
        }
        self.cacheLookupSuccess(CacheLookup, It, IncludeLoc);
        return File;
    }
    if checkMSVCHeaderSearch(self.Diags, MSFE, null, IncludeLoc) {
        if SuggestedModule {
            *SuggestedModule = MSSuggestedModule;
        }
        return MSFE;
    }
    CacheLookup.HitIt = self.search_dir_end();
    return nullopt;
}

fn HeaderSearch::LookupSubframeworkHeader(self, Filename: str, ContextFileEnt: FileEntryRef, SearchPath: *mut SmallVectorImpl<char>, RelativePath: *mut SmallVectorImpl<char>, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader) -> OptionalFileEntryRef {
    let mut SlashPos: u64 = Filename.find('/', 0);
    if SlashPos == npos {
        return nullopt;
    }
    let mut ContextName: str = ContextFileEnt.getName();
    let mut DotFrameworkLen: u32 = 10;
    let mut FrameworkPos: u64 = ContextName.find(".framework", 0);
    if FrameworkPos == npos || (ContextName[FrameworkPos + DotFrameworkLen] != '/' && ContextName[FrameworkPos + DotFrameworkLen] != '\') {
        return nullopt;
    }
    let mut FrameworkName: str = ContextName.ptr[0..ContextName.ptr + FrameworkPos + DotFrameworkLen + 1];
    operator(FrameworkName, "Frameworks/");
    FrameworkName.append(Filename.begin(), Filename.begin() + SlashPos);
    operator(FrameworkName, ".framework/");
    let mut CacheLookup: *mut FrameworkCacheEntry> = operator(self.FrameworkMap.insert(make_pair(Filename[0..0 + SlashPos], FrameworkCacheEntry {})).first);
    if CacheLookup.second.Directory && CacheLookup.first().len == FrameworkName.len && memcmp(CacheLookup.first().ptr, &mut FrameworkName[0], CacheLookup.first().len) != 0 {
        return nullopt;
    }
    if !CacheLookup.second.Directory {
        operator(NumSubFrameworkLookups);
        let mut Dir: OptionalDirectoryEntryRef = self.FileMgr.getOptionalDirectoryRef(FrameworkName.operator StringRef(), true);
        if !Dir {
            return nullopt;
        }
        CacheLookup.second.Directory = Dir;
    }
    if RelativePath {
        RelativePath.clear();
        RelativePath.append(Filename.begin() + SlashPos + 1, Filename.end());
    }
    let mut HeadersFilename: str = FrameworkName;
    operator(HeadersFilename, "Headers/");
    if SearchPath {
        SearchPath.clear();
        SearchPath.append(HeadersFilename.begin(), HeadersFilename.end() - 1);
    }
    HeadersFilename.append(Filename.begin() + SlashPos + 1, Filename.end());
    let mut File: OptionalFileEntryRef = self.FileMgr.getOptionalFileRef(HeadersFilename.operator StringRef(), true, true, true);
    if !File {
        HeadersFilename = FrameworkName;
        operator(HeadersFilename, "PrivateHeaders/");
        if SearchPath {
            SearchPath.clear();
            SearchPath.append(HeadersFilename.begin(), HeadersFilename.end() - 1);
        }
        HeadersFilename.append(Filename.begin() + SlashPos + 1, Filename.end());
        File = self.FileMgr.getOptionalFileRef(HeadersFilename.operator StringRef(), true, true, true);
        if !File {
            return nullopt;
        }
    }
    let mut ContextHFI: *HeaderFileInfo = self.getExistingFileInfo(ContextFileEnt);
    assert!(ContextHFI, "context file without file info");
    let mut DirInfo: u32 = ContextHFI.DirInfo;
    self.getFileInfo(operator(File)).DirInfo = DirInfo;
    FrameworkName.pop();
    if !self.findUsableModuleForFrameworkHeader(operator(File), FrameworkName.operator StringRef(), RequestingModule, SuggestedModule, false) {
        return nullopt;
    }
    return operator(File);
}

fn moduleMembershipNeedsMerge(HFI: *HeaderFileInfo, Role: ModuleHeaderRole) -> bool {
    if isModular(Role) {
        return !HFI.isModuleHeader || HFI.isTextualModuleHeader;
    }
    if !HFI.isModuleHeader && (Role & TextualHeader) {
        return !HFI.isTextualModuleHeader;
    }
    return false;
}

fn mergeHeaderFileInfoModuleBits(HFI: *mut HeaderFileInfo, isModuleHeader: bool, isTextualModuleHeader: bool) {
    HFI.isModuleHeader |= isModuleHeader;
    if HFI.isModuleHeader {
        HFI.isTextualModuleHeader = false;
    } else {
        HFI.isTextualModuleHeader |= isTextualModuleHeader;
    }
}

fn HeaderFileInfo::mergeModuleMembership(self, Role: ModuleHeaderRole) {
    mergeHeaderFileInfoModuleBits(*self, isModular(Role), (Role & TextualHeader));
}

fn mergeHeaderFileInfo(HFI: *mut HeaderFileInfo, OtherHFI: *HeaderFileInfo) {
    assert!(OtherHFI.External, "expected to merge external HFI");
    HFI.isImport |= OtherHFI.isImport;
    HFI.isPragmaOnce |= OtherHFI.isPragmaOnce;
    mergeHeaderFileInfoModuleBits(HFI, OtherHFI.isModuleHeader, OtherHFI.isTextualModuleHeader);
    if !HFI.LazyControllingMacro.isValid() {
        HFI.LazyControllingMacro = OtherHFI.LazyControllingMacro;
    }
    HFI.DirInfo = OtherHFI.DirInfo;
    HFI.External = (!HFI.IsValid || HFI.External);
    HFI.IsValid = true;
}

fn HeaderSearch::getFileInfo(self, FE: FileEntryRef) -> *mut HeaderFileInfo {
    let mut HFI: *mut HeaderFileInfo = &mut self.FileInfo[FE];
    if self.ExternalSource && !HFI.Resolved {
        let mut ExternalHFI: HeaderFileInfo = self.ExternalSource.GetHeaderFileInfo(FE);
        if ExternalHFI.IsValid {
            HFI.Resolved = true;
            if ExternalHFI.External {
                mergeHeaderFileInfo(*HFI, ExternalHFI);
            }
        }
    }
    HFI.IsValid = true;
    HFI.External = false;
    return *HFI;
}

fn HeaderSearch::getExistingFileInfo(self: *HeaderSearch, FE: FileEntryRef) -> *HeaderFileInfo {
    let mut HFI: *mut HeaderFileInfo = null;
    if self.ExternalSource {
        HFI = &mut self.FileInfo[FE];
        if !HFI.Resolved {
            let mut ExternalHFI: HeaderFileInfo = self.ExternalSource.GetHeaderFileInfo(FE);
            if ExternalHFI.IsValid {
                HFI.Resolved = true;
                if ExternalHFI.External {
                    mergeHeaderFileInfo(*HFI, ExternalHFI);
                }
            }
        }
    } else if self.FileInfo.find(FE) {
        It != self.FileInfo.end();
    } else {
        HFI = &mut It.second;
    }
    return if (HFI && HFI.IsValid) { HFI } else { null };
}

fn HeaderSearch::forEachExistingLocalFileInfo(self: *HeaderSearch, Fn: function_ref<void (FileEntryRef, const HeaderFileInfo &)>) {
    for x in self.FileInfo {
        if HFI.IsValid && !HFI.External {
            Fn.call(FE, HFI);
        }
    }
}

fn HeaderSearch::isFileMultipleIncludeGuarded(self: *HeaderSearch, File: FileEntryRef) -> bool {
    if self.getExistingFileInfo(File) {
        HFI;
    } else {
        return HFI.isPragmaOnce || HFI.LazyControllingMacro.isValid();
    }
    return false;
}

fn HeaderSearch::MarkFileModuleHeader(self, FE: FileEntryRef, Role: ModuleHeaderRole, isCompilingModuleHeader: bool) {
    if !isCompilingModuleHeader {
        if (Role & ExcludedHeader) {
            return;
        }
        let mut HFI: *HeaderFileInfo = self.getExistingFileInfo(FE);
        if HFI && !moduleMembershipNeedsMerge(HFI, Role) {
            return;
        }
    }
    let mut HFI: *mut HeaderFileInfo = self.getFileInfo(FE);
    HFI.mergeModuleMembership(Role);
    HFI.isCompilingModuleHeader |= isCompilingModuleHeader;
}

fn HeaderSearch::ShouldEnterIncludeFile(self, PP: *mut Preprocessor, File: FileEntryRef, isImport: bool, ModulesEnabled: bool, M: *mut Module, IsFirstIncludeOfFile: *mut bool) -> bool {
    operator(NumIncluded);
    IsFirstIncludeOfFile = false;
    let mut FileInfo: *mut HeaderFileInfo = self.getFileInfo(File);
    let mut MaybeReenterImportedFile: Closure_5 = Closure_5 { ModulesEnabled: &mut ModulesEnabled, FileInfo: &mut FileInfo, cap_2: self, File: &mut File };
    if isImport {
        FileInfo.isImport = true;
        if PP.alreadyIncluded(File) && !MaybeReenterImportedFile.call() {
            return false;
        }
    } else {
        if FileInfo.isPragmaOnce || (FileInfo.isImport && !MaybeReenterImportedFile.call()) {
            return false;
        }
    }
    if FileInfo.getControllingMacro(self.ExternalLookup) {
        ControllingMacro;
    } else {
        if if M { PP.isMacroDefinedInLocalModule(ControllingMacro, M) } else { PP.isMacroDefined(ControllingMacro) } {
            operator(NumMultiIncludeFileOptzn);
            return false;
        }
    }
    IsFirstIncludeOfFile = PP.markIncluded(File);
    return true;
}

fn HeaderSearch::getTotalMemory(self: *HeaderSearch) -> u64 {
    return self.SearchDirs.capacity() + capacity_in_bytes(self.FileInfo) + capacity_in_bytes(self.HeaderMaps) + self.LookupFileCache.getAllocator().getTotalMemory() + self.FrameworkMap.getAllocator().getTotalMemory();
}

fn HeaderSearch::searchDirIdx(self: *HeaderSearch, DL: *DirectoryLookup) -> u32 {
    return &mut DL - &mut operator(self.SearchDirs.begin());
}

fn HeaderSearch::getUniqueFrameworkName(self, Framework: str) -> str {
    return operator(self.FrameworkNames.insert(Framework).first).first();
}

fn HeaderSearch::getIncludeNameForHeader(self: *HeaderSearch, File: *FileEntry) -> str {
    let mut It: const_iterator = self.IncludeNames.find(File);
    if It == self.IncludeNames.end() {
        return "";
    }
    return operator(It).second.operator StringRef();
}

fn HeaderSearch::buildModuleMapIndex(self, Dir: DirectoryEntryRef, MMState: *mut ModuleMapDirectoryState) {
    if !MMState.ModuleMapFile {
        return;
    }
    let mut ParsedMM: *ModuleMapFile = self.ModMap.getParsedModuleMap(operator(MMState.ModuleMapFile));
    if !ParsedMM {
        return;
    }
    let mut ParsedPrivateMM: *ModuleMapFile = null;
    if MMState.PrivateModuleMapFile {
        ParsedPrivateMM = self.ModMap.getParsedModuleMap(operator(MMState.PrivateModuleMapFile));
    }
    self.processModuleMapForIndex(*ParsedMM, Dir, "", MMState);
    if ParsedPrivateMM {
        self.processModuleMapForIndex(*ParsedPrivateMM, Dir, "", MMState);
    }
}

fn HeaderSearch::addToModuleMapIndex(self, RelPath: str, ModuleName: str, PathPrefix: str, MMState: *mut ModuleMapDirectoryState) {
    let mut RelFromRootPath: str = PathPrefix;
    append(RelFromRootPath, RelPath, "", "", "");
    native(RelFromRootPath, native);
    MMState.HeaderToModules[RelFromRootPath.operator StringRef()].push(ModuleName);
}

fn HeaderSearch::processExternModuleDeclForIndex(self, EMD: *ExternModuleDecl, MMDir: DirectoryEntryRef, PathPrefix: str, MMState: *mut ModuleMapDirectoryState) {
    let mut FileNameRef: str = EMD.Path;
    let mut ModuleMapFileName: str = "";
    if is_relative(FileNameRef, native) {
        ModuleMapFileName = MMDir.getName();
        append(ModuleMapFileName, EMD.Path, "", "", "");
        FileNameRef = ModuleMapFileName.operator StringRef();
    }
    if self.FileMgr.getOptionalFileRef(FileNameRef, false, true, true) {
        EFile;
    } else {
        if self.ModMap.getParsedModuleMap(operator(EFile)) {
            ExtMMF;
        } else {
            let mut NewPrefix: str = PathPrefix;
            let mut ExternDir: str = parent_path(EMD.Path, native);
            if !ExternDir.is_empty() {
                append(NewPrefix, ExternDir, "", "", "");
                native(NewPrefix, native);
            }
            self.processModuleMapForIndex(*ExtMMF, operator(EFile).getDir(), NewPrefix.operator StringRef(), MMState);
        }
    }
}

fn HeaderSearch::processModuleDeclForIndex(self, MD: *ModuleDecl, ModuleName: str, MMDir: DirectoryEntryRef, PathPrefix: str, MMState: *mut ModuleMapDirectoryState) {
    if MD.Id.front().first == "*" {
        return;
    }
    let mut ProcessDecl: Visitor<(lambda at P:\Goraw\llvm-project\clang\lib\Lex\HeaderSearch.cpp:1679:7), (lambda at P:\Goraw\llvm-project\clang\lib\Lex\HeaderSearch.cpp:1686:7), (lambda at P:\Goraw\llvm-project\clang\lib\Lex\HeaderSearch.cpp:1693:7), (lambda at P:\Goraw\llvm-project\clang\lib\Lex\HeaderSearch.cpp:1697:7), (lambda at P:\Goraw\llvm-project\clang\lib\Lex\HeaderSearch.cpp:1700:7)> = makeVisitor(Closure_6 { MMState: &mut MMState, ModuleName: &mut ModuleName, cap_2: self, PathPrefix: &mut PathPrefix }, Closure_7 { PathPrefix: &mut PathPrefix, MMState: &mut MMState, ModuleName: &mut ModuleName }, Closure_8 { cap_0: self, ModuleName: &mut ModuleName, MMDir: &mut MMDir, PathPrefix: &mut PathPrefix, MMState: &mut MMState }, Closure_9 { cap_0: self, MMDir: &mut MMDir, PathPrefix: &mut PathPrefix, MMState: &mut MMState }, Closure_10 {});
    for Decl in MD.Decls {
        visit(ProcessDecl, Decl);
    }
}

fn HeaderSearch::processModuleMapForIndex(self, MMF: *ModuleMapFile, MMDir: DirectoryEntryRef, PathPrefix: str, MMState: *mut ModuleMapDirectoryState) {
    for Decl in MMF.Decls {
        visit(makeVisitor(Closure_11 { cap_0: self, MMDir: &mut MMDir, PathPrefix: &mut PathPrefix, MMState: &mut MMState }, Closure_12 { cap_0: self, MMDir: &mut MMDir, PathPrefix: &mut PathPrefix, MMState: &mut MMState }), Decl);
    }
}

fn computeRelativePath(FileName: str, DirPath: str) -> str {
    if !FileName.starts_with(DirPath) {
        return "";
    }
    let mut RelativePath: str = FileName[DirPath.len..DirPath.len + npos];
    while !RelativePath.is_empty() && is_separator(RelativePath.front(), native) {
        RelativePath = RelativePath[1..1 + npos];
    }
    return RelativePath;
}

fn HeaderSearch::findMatchingModulesInIndex(self: *HeaderSearch, RelativePath: str, MMState: *ModuleMapDirectoryState) -> SmallVector<StringRef, 1> {
    let mut Modules: SmallVector<StringRef, 1> = SmallVector<StringRef, 1> {};
    let mut CachedMods: const_iterator = MMState.HeaderToModules.find(RelativePath);
    if CachedMods != MMState.HeaderToModules.end() {
        Modules.append(operator(CachedMods).second.begin(), operator(CachedMods).second.end());
    }
    for UmbrellaDir in MMState.UmbrellaDirModules {
        if RelativePath.starts_with(UmbrellaDir.first) || UmbrellaDir.first == "." {
            Modules.push(UmbrellaDir.second);
        }
    }
    Modules.append(MMState.UmbrellaHeaderModules.begin(), MMState.UmbrellaHeaderModules.end());
    return Modules;
}

fn HeaderSearch::hasModuleMap(self, FileName: str, Root: *DirectoryEntry, IsSystem: bool) -> bool {
    if !self.HSOpts.ImplicitModuleMaps {
        return false;
    }
    let mut DirName: str = FileName;
    let mut CurDir: *DirectoryEntry = null;
    while true {
        {
        DirName = parent_path(DirName, native);
        if DirName.is_empty() {
            return false;
        }
        let mut Dir: OptionalDirectoryEntryRef = self.FileMgr.getOptionalDirectoryRef(DirName, true);
        if !Dir {
            return false;
        }
        CurDir = operator(Dir).operator const clang::DirectoryEntry *();
        let mut IsFramework: bool = extension(operator(Dir).getName(), native) == ".framework";
        self.parseModuleMapFile(operator(Dir), IsSystem, true, IsFramework);
        let mut DirState: iterator = self.DirectoryModuleMap.find(operator(Dir).operator const clang::DirectoryEntry *());
        if DirState == self.DirectoryModuleMap.end() || !operator(DirState).second.ModuleMapFile {
            continue;
        }
        if !self.HSOpts.LazyLoadModuleMaps && self.Diags.isIgnored(warn_mmap_deprecated_symlink_to_modular_header, SourceLocation {}) {
            return true;
        }
        let mut MMState: *mut ModuleMapDirectoryState = operator(DirState).second;
        if MMState.HeaderToModules.is_empty() && MMState.UmbrellaDirModules.is_empty() && MMState.UmbrellaHeaderModules.is_empty() {
            self.buildModuleMapIndex(operator(Dir), MMState);
        }
        if !self.HSOpts.LazyLoadModuleMaps {
            return true;
        }
        let mut RelativePath: str = computeRelativePath(FileName, DirName);
        let mut RelativePathNative: str = RelativePath;
        native(RelativePathNative, native);
        let mut ModulesToLoad: SmallVector<StringRef, 1> = self.findMatchingModulesInIndex(RelativePathNative.operator StringRef(), MMState);
        let mut LoadedAny: bool = false;
        for ModName in ModulesToLoad {
            if self.ModMap.findOrLoadModule(ModName) {
                LoadedAny = true;
            }
        }
        if LoadedAny {
            return true;
        }
    }
        if !(CurDir != Root) { break; }
    }
    return false;
}

fn HeaderSearch::findModuleForHeader(self: *HeaderSearch, File: FileEntryRef, AllowTextual: bool, AllowExcluded: bool) -> KnownHeader {
    if self.ExternalSource {
        self.getExistingFileInfo(File) as void;
    }
    return self.ModMap.findModuleForHeader(File, AllowTextual, AllowExcluded);
}

fn HeaderSearch::findAllModulesForHeader(self: *HeaderSearch, File: FileEntryRef) -> KnownHeader> {
    if self.ExternalSource {
        self.getExistingFileInfo(File) as void;
    }
    return self.ModMap.findAllModulesForHeader(File);
}

fn HeaderSearch::findResolvedModulesForHeader(self: *HeaderSearch, File: FileEntryRef) -> KnownHeader> {
    if self.ExternalSource {
        self.getExistingFileInfo(File) as void;
    }
    return self.ModMap.findResolvedModulesForHeader(File);
}

fn suggestModule(HS: *mut HeaderSearch, Module: KnownHeader, File: FileEntryRef, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader) -> bool {
    if RequestingModule && Module && RequestingModule.NoUndeclaredIncludes {
        HS.getModuleMap().resolveUses(RequestingModule, false);
        if !RequestingModule.directlyUses(Module.getModule()) {
            if HS.getModuleMap().isBuiltinHeader(File) {
                if SuggestedModule {
                    *SuggestedModule = KnownHeader {};
                }
                return true;
            }
            return false;
        }
    }
    if SuggestedModule {
        *SuggestedModule = if (Module.getRole() & TextualHeader) { KnownHeader {} } else { Module };
    }
    return true;
}

fn HeaderSearch::diagnoseUncoveredSymlink(self, File: FileEntryRef, Module: *mut KnownHeader, Root: *DirectoryEntry) {
    if !Module {
        return;
    }
    if !self.HSOpts.ImplicitModuleMaps || Module.getModule().isPartOfFramework() || !Module.getModule().isModuleMapModule() {
        return;
    }
    if self.Diags.isIgnored(warn_mmap_deprecated_symlink_to_modular_header, Module.getModule().DefinitionLoc) {
        return;
    }
    if File.isDeviceFile() || File.isNamedPipe() {
        return;
    }
    let mut AbsPath: str = File.getName();
    self.FileMgr.makeAbsolutePath(AbsPath, false);
    remove_dots(AbsPath, true, native);
    let mut LinkTarget: str = "";
    if readlink(AbsPath, LinkTarget) {
        return;
    }
    let mut FileName: str = File.getNameAsRequested();
    let mut DirName: str = FileName;
    let mut CurDir: *DirectoryEntry = null;
    while true {
        {
        DirName = parent_path(DirName, native);
        if DirName.is_empty() {
            break;
        }
        let mut Dir: OptionalDirectoryEntryRef = self.FileMgr.getOptionalDirectoryRef(DirName, true);
        if !Dir {
            break;
        }
        CurDir = operator(Dir).operator const clang::DirectoryEntry *();
        let mut DirState: iterator = self.DirectoryModuleMap.find(operator(Dir).operator const clang::DirectoryEntry *());
        if DirState == self.DirectoryModuleMap.end() || !operator(DirState).second.ModuleMapFile {
            continue;
        }
        let mut RelativePath: str = computeRelativePath(FileName, DirName);
        if RelativePath.is_empty() {
            continue;
        }
        let mut RelativePathNative: str = RelativePath;
        native(RelativePathNative, native);
        let mut MatchingModules: SmallVector<StringRef, 1> = self.findMatchingModulesInIndex(RelativePathNative.operator StringRef(), operator(DirState).second);
        if !MatchingModules.is_empty() {
            return;
        }
    }
        if !(CurDir != Root) { break; }
    }
    self.Diags.Report(warn_mmap_deprecated_symlink_to_modular_header) << File.getName() << LinkTarget << Module.getModule().getFullModuleName(false);
    self.Diags.Report(Module.getModule().DefinitionLoc, note_mmap_module_defined_here);
}

fn HeaderSearch::findUsableModuleForHeader(self, File: FileEntryRef, Root: *DirectoryEntry, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, IsSystemHeaderDir: bool) -> bool {
    if needModuleLookup(RequestingModule, SuggestedModule) {
        if !self.HSOpts.LazyLoadModuleMaps {
            self.hasModuleMap(File.getNameAsRequested(), Root, IsSystemHeaderDir);
            let mut Module: KnownHeader = self.findModuleForHeader(File, true, false);
            self.diagnoseUncoveredSymlink(File, Module, Root);
            return suggestModule(*self, Module, File, RequestingModule, SuggestedModule);
        }
        let mut Module: KnownHeader = self.findModuleForHeader(File, true, false);
        if !Module {
            self.hasModuleMap(File.getNameAsRequested(), Root, IsSystemHeaderDir);
            Module = self.ModMap.findModuleForHeader(File, true, false);
        }
        self.diagnoseUncoveredSymlink(File, Module, Root);
        return suggestModule(*self, Module, File, RequestingModule, SuggestedModule);
    }
    return true;
}

fn HeaderSearch::findUsableModuleForFrameworkHeader(self, File: FileEntryRef, FrameworkName: str, RequestingModule: *mut Module, SuggestedModule: *mut KnownHeader, IsSystemFramework: bool) -> bool {
    if needModuleLookup(RequestingModule, SuggestedModule) {
        let mut SubmodulePath: string, 4> = string, 4> {};
        let mut TopFrameworkDir: OptionalDirectoryEntryRef = getTopFrameworkDir(self.FileMgr, FrameworkName, SubmodulePath);
        assert!(TopFrameworkDir, "Could not find the top-most framework dir");
        let mut ModuleName: str = stem(operator(TopFrameworkDir).getName(), native);
        self.loadFrameworkModule(ModuleName, operator(TopFrameworkDir), IsSystemFramework, true);
        let mut Module: KnownHeader = self.findModuleForHeader(File, true, false);
        return suggestModule(*self, Module, File, RequestingModule, SuggestedModule);
    }
    return true;
}

fn getPrivateModuleMap(File: FileEntryRef, FileMgr: *mut FileManager, Diags: *mut DiagnosticsEngine, Diagnose: bool) -> OptionalFileEntryRef {
    let mut Filename: str = filename(File.getName(), native);
    let mut PrivateFilename: str = File.getDir().getName();
    if Filename == "module.map" {
        append(PrivateFilename, "module_private.map", "", "", "");
    } else if Filename == "module.modulemap" {
        append(PrivateFilename, "module.private.modulemap", "", "", "");
    } else {
        return nullopt;
    }
    let mut PMMFile: OptionalFileEntryRef = FileMgr.getOptionalFileRef(PrivateFilename.operator StringRef(), false, true, true);
    if PMMFile {
        if Diagnose && Filename == "module.map" {
            Diags.Report(warn_deprecated_module_dot_map) << PrivateFilename << 1 << File.getDir().getName().ends_with(".framework");
        }
    }
    return PMMFile;
}

fn HeaderSearch::parseAndLoadModuleMapFile(self, File: FileEntryRef, IsSystem: bool, ImplicitlyDiscovered: bool, ID: FileID, Offset: *mut u32, OriginalModuleMapFile: str) -> bool {
    let mut Dir: OptionalDirectoryEntryRef = OptionalDirectoryEntryRef {};
    if self.getHeaderSearchOpts().ModuleMapFileHomeIsCwd {
        Dir = self.FileMgr.getOptionalDirectoryRef(".", true);
    } else {
        if !OriginalModuleMapFile.is_empty() {
            Dir = self.FileMgr.getOptionalDirectoryRef(parent_path(OriginalModuleMapFile, native), true);
            if !Dir {
                let mut FakeFile: FileEntryRef = self.FileMgr.getVirtualFileRef(OriginalModuleMapFile, 0, 0);
                Dir = FakeFile.getDir();
            }
        } else {
            Dir = File.getDir();
        }
        assert!(Dir, "parent must exist");
        let mut DirName: str = operator(Dir).getName();
        if filename(DirName, native) == "Modules" {
            DirName = parent_path(DirName, native);
            if DirName.ends_with(".framework") {
                if self.FileMgr.getOptionalDirectoryRef(DirName, true) {
                    MaybeDir;
                } else {
                    Dir = operator(MaybeDir);
                }
            }
            assert!(Dir, "parent must exist");
        }
    }
    assert!(Dir, "module map home directory must exist");
    match self.parseAndLoadModuleMapFileImpl(File, IsSystem, ImplicitlyDiscovered, operator(Dir), ID, Offset, true) {
        MMR_AlreadyProcessed => {
            MMR_NewlyProcessed;
        },
        MMR_NoDirectory => {
            MMR_InvalidModuleMap;
        },
    }
    llvm_unreachable_internal("Unknown load module map result", "P:/Goraw/llvm-project/clang/lib/Lex/HeaderSearch.cpp", 2116);
}

fn HeaderSearch::parseAndLoadModuleMapFileImpl(self, File: FileEntryRef, IsSystem: bool, ImplicitlyDiscovered: bool, Dir: DirectoryEntryRef, ID: FileID, Offset: *mut u32, DiagnosePrivMMap: bool) -> ModuleMapResult {
    let mut AddResult: pair<iterator, bool> = self.LoadedModuleMaps.insert(make_pair(File, true));
    if !AddResult.second {
        return if operator(AddResult.first).second { MMR_AlreadyProcessed } else { MMR_InvalidModuleMap };
    }
    if self.ModMap.parseAndLoadModuleMapFile(File, IsSystem, ImplicitlyDiscovered, Dir, ID, Offset, SourceLocation {}) {
        self.LoadedModuleMaps[File.operator const clang::FileEntry *()] = false;
        return MMR_InvalidModuleMap;
    }
    if getPrivateModuleMap(File, self.FileMgr, self.Diags, DiagnosePrivMMap) {
        PMMFile;
    } else {
        if self.ModMap.parseAndLoadModuleMapFile(operator(PMMFile), IsSystem, ImplicitlyDiscovered, Dir, FileID {}, null, SourceLocation {}) {
            self.LoadedModuleMaps[File.operator const clang::FileEntry *()] = false;
            return MMR_InvalidModuleMap;
        }
    }
    return MMR_NewlyProcessed;
}

fn HeaderSearch::parseModuleMapFileImpl(self, File: FileEntryRef, IsSystem: bool, ImplicitlyDiscovered: bool, Dir: DirectoryEntryRef, ID: FileID) -> ModuleMapResult {
    let mut AddResult: pair<iterator, bool> = self.ParsedModuleMaps.insert(make_pair(File, true));
    if !AddResult.second {
        return if operator(AddResult.first).second { MMR_AlreadyProcessed } else { MMR_InvalidModuleMap };
    }
    if self.ModMap.parseModuleMapFile(File, IsSystem, ImplicitlyDiscovered, Dir, ID, SourceLocation {}) {
        self.ParsedModuleMaps[File.operator const clang::FileEntry *()] = false;
        return MMR_InvalidModuleMap;
    }
    if getPrivateModuleMap(File, self.FileMgr, self.Diags, false) {
        PMMFile;
    } else {
        if self.ModMap.parseModuleMapFile(operator(PMMFile), IsSystem, ImplicitlyDiscovered, Dir, FileID {}, SourceLocation {}) {
            self.ParsedModuleMaps[File.operator const clang::FileEntry *()] = false;
            return MMR_InvalidModuleMap;
        }
    }
    return MMR_NewlyProcessed;
}

fn HeaderSearch::lookupModuleMapFile(self, Dir: DirectoryEntryRef, IsFramework: bool) -> OptionalFileEntryRef {
    if !self.HSOpts.ImplicitModuleMaps {
        return nullopt;
    }
    let mut ModuleMapFileName: str = Dir.getName();
    if IsFramework {
        append(ModuleMapFileName, "Modules", "", "", "");
    }
    append(ModuleMapFileName, "module.modulemap", "", "", "");
    if self.FileMgr.getOptionalFileRef(ModuleMapFileName.operator StringRef(), false, true, true) {
        F;
    } else {
        return operator(F);
    }
    ModuleMapFileName = Dir.getName();
    append(ModuleMapFileName, "module.map", "", "", "");
    if self.FileMgr.getOptionalFileRef(ModuleMapFileName.operator StringRef(), false, true, true) {
        F;
    } else {
        self.Diags.Report(warn_deprecated_module_dot_map) << ModuleMapFileName << 0 << IsFramework;
        return operator(F);
    }
    if IsFramework {
        ModuleMapFileName = Dir.getName();
        append(ModuleMapFileName, "Modules", "module.private.modulemap", "", "");
        if self.FileMgr.getOptionalFileRef(ModuleMapFileName.operator StringRef(), false, true, true) {
            F;
        } else {
            return operator(F);
        }
    }
    return nullopt;
}

fn HeaderSearch::loadFrameworkModule(self, Name: str, Dir: DirectoryEntryRef, IsSystem: bool, ImplicitlyDiscovered: bool) -> *mut Module {
    match self.parseAndLoadModuleMapFile(Dir, IsSystem, ImplicitlyDiscovered, true) {
        MMR_InvalidModuleMap => {
            if self.HSOpts.ImplicitModuleMaps {
                self.ModMap.inferFrameworkModule(Dir, IsSystem, null);
            }
        },
        MMR_NoDirectory => {
            return null;
        },
        MMR_AlreadyProcessed => {
            MMR_NewlyProcessed;
        },
    }
    return self.ModMap.findOrLoadModule(Name);
}

fn HeaderSearch::parseAndLoadModuleMapFile(self, DirName: str, IsSystem: bool, ImplicitlyDiscovered: bool, IsFramework: bool) -> ModuleMapResult {
    if self.FileMgr.getOptionalDirectoryRef(DirName, true) {
        Dir;
    } else {
        return self.parseAndLoadModuleMapFile(operator(Dir), IsSystem, ImplicitlyDiscovered, IsFramework);
    }
    return MMR_NoDirectory;
}

fn HeaderSearch::parseAndLoadModuleMapFile(self, Dir: DirectoryEntryRef, IsSystem: bool, ImplicitlyDiscovered: bool, IsFramework: bool) -> ModuleMapResult {
    let mut InsertRes: pair<iterator, bool> = self.DirectoryModuleMap.insert(ModuleMapDirectoryState> { Dir, ModuleMapDirectoryState { OptionalFileEntryRef {}, OptionalFileEntryRef {}, Invalid, SmallVector<StringRef, 1>> {}, string, StringRef>, 2> {}, SmallVector<StringRef, 2> {} } });
    let mut MMState: *mut ModuleMapDirectoryState = operator(InsertRes.first).second;
    if !InsertRes.second {
        match MMState.Status {
            Parsed => {
                break;
            },
            Loaded => {
                return MMR_AlreadyProcessed;
            },
            Invalid => {
                return MMR_InvalidModuleMap;
            },
        }
    }
    if !MMState.ModuleMapFile {
        MMState.ModuleMapFile = self.lookupModuleMapFile(Dir, IsFramework);
        if MMState.ModuleMapFile {
            MMState.PrivateModuleMapFile = getPrivateModuleMap(operator(MMState.ModuleMapFile), self.FileMgr, self.Diags, true);
        }
    }
    if MMState.ModuleMapFile {
        let mut Result: ModuleMapResult = self.parseAndLoadModuleMapFileImpl(operator(MMState.ModuleMapFile), IsSystem, ImplicitlyDiscovered, Dir, FileID {}, null, false);
        if Result == MMR_NewlyProcessed {
            MMState.Status = Loaded;
        } else if Result == MMR_InvalidModuleMap {
            MMState.Status = Invalid;
        }
        return Result;
    }
    return MMR_InvalidModuleMap;
}

fn HeaderSearch::parseModuleMapFile(self, DirName: str, IsSystem: bool, ImplicitlyDiscovered: bool, IsFramework: bool) -> ModuleMapResult {
    if self.FileMgr.getOptionalDirectoryRef(DirName, true) {
        Dir;
    } else {
        return self.parseModuleMapFile(operator(Dir), IsSystem, ImplicitlyDiscovered, IsFramework);
    }
    return MMR_NoDirectory;
}

fn HeaderSearch::parseModuleMapFile(self, Dir: DirectoryEntryRef, IsSystem: bool, ImplicitlyDiscovered: bool, IsFramework: bool) -> ModuleMapResult {
    if !self.HSOpts.LazyLoadModuleMaps {
        return self.parseAndLoadModuleMapFile(Dir, IsSystem, ImplicitlyDiscovered, IsFramework);
    }
    let mut InsertRes: pair<iterator, bool> = self.DirectoryModuleMap.insert(ModuleMapDirectoryState> { Dir, ModuleMapDirectoryState { OptionalFileEntryRef {}, OptionalFileEntryRef {}, Invalid, SmallVector<StringRef, 1>> {}, string, StringRef>, 2> {}, SmallVector<StringRef, 2> {} } });
    let mut MMState: *mut ModuleMapDirectoryState = operator(InsertRes.first).second;
    if !InsertRes.second {
        match MMState.Status {
            Parsed => {
                Loaded;
            },
            Invalid => {
                return MMR_InvalidModuleMap;
            },
        }
    }
    if !MMState.ModuleMapFile {
        MMState.ModuleMapFile = self.lookupModuleMapFile(Dir, IsFramework);
        if MMState.ModuleMapFile {
            MMState.PrivateModuleMapFile = getPrivateModuleMap(operator(MMState.ModuleMapFile), self.FileMgr, self.Diags, true);
        }
    }
    if MMState.ModuleMapFile {
        let mut Result: ModuleMapResult = self.parseModuleMapFileImpl(operator(MMState.ModuleMapFile), IsSystem, ImplicitlyDiscovered, Dir, FileID {});
        if Result == MMR_NewlyProcessed {
            MMState.Status = Parsed;
        } else if Result == MMR_InvalidModuleMap {
            MMState.Status = Invalid;
        }
        return Result;
    }
    return MMR_InvalidModuleMap;
}

fn HeaderSearch::collectAllModules(self, Modules: *mut SmallVectorImpl<Module *>) {
    Modules.clear();
    if self.HSOpts.ImplicitModuleMaps {
        for DL in self.search_dir_range() {
            let mut IsSystem: bool = DL.isSystemHeaderDirectory();
            if DL.isFramework() {
                let mut EC: error_code = error_code {};
                let mut DirNative: str = "";
                native(operator(DL.getFrameworkDirRef()).getName(), DirNative, native);
                let mut FS: *mut FileSystem = self.FileMgr.getVirtualFileSystem();
                for let mut Dir: directory_iterator = FS.dir_begin(DirNative, EC);
let mut DirEnd: directory_iterator = directory_iterator {}; Dir != DirEnd && !EC; Dir.increment(EC) {
                    if extension(operator(Dir).path(), native) != ".framework" {
                        continue;
                    }
                    let mut FrameworkDir: OptionalDirectoryEntryRef = self.FileMgr.getOptionalDirectoryRef(operator(Dir).path(), true);
                    if !FrameworkDir {
                        continue;
                    }
                    self.loadFrameworkModule(stem(operator(Dir).path(), native), operator(FrameworkDir), IsSystem, true);
                }
                continue;
            }
            if DL.isHeaderMap() {
                continue;
            }
            self.parseAndLoadModuleMapFile(operator(DL.getDirRef()), IsSystem, true, false);
            self.loadSubdirectoryModuleMaps(DL);
        }
    }
    append_range(Modules, make_second_range(self.ModMap.modules()));
}

fn HeaderSearch::loadTopLevelSystemModules(self) {
    if !self.HSOpts.ImplicitModuleMaps {
        return;
    }
    for DL in self.search_dir_range() {
        if !DL.isNormalDir() {
            continue;
        }
        self.parseAndLoadModuleMapFile(operator(DL.getDirRef()), DL.isSystemHeaderDirectory(), true, DL.isFramework());
    }
}

fn HeaderSearch::loadSubdirectoryModuleMaps(self, SearchDir: *mut DirectoryLookup) {
    assert!(self.HSOpts.ImplicitModuleMaps, "Should not be loading subdirectory module maps");
    if SearchDir.haveSearchedAllModuleMaps() {
        return;
    }
    let mut EC: error_code = error_code {};
    let mut Dir: str = operator(SearchDir.getDirRef()).getName();
    self.FileMgr.makeAbsolutePath(Dir, false);
    let mut DirNative: str = "";
    native(Dir, DirNative, native);
    let mut FS: *mut FileSystem = self.FileMgr.getVirtualFileSystem();
    for let mut Dir: directory_iterator = FS.dir_begin(DirNative, EC);
let mut DirEnd: directory_iterator = directory_iterator {}; Dir != DirEnd && !EC; Dir.increment(EC) {
        if operator(Dir).type() == regular_file {
            continue;
        }
        let mut IsFramework: bool = extension(operator(Dir).path(), native) == ".framework";
        if IsFramework == SearchDir.isFramework() {
            self.parseAndLoadModuleMapFile(operator(Dir).path(), SearchDir.isSystemHeaderDirectory(), true, SearchDir.isFramework());
        }
    }
    SearchDir.setSearchedAllModuleMaps(true);
}

fn HeaderSearch::suggestPathToFileForDiagnostics(self: *HeaderSearch, File: FileEntryRef, MainFile: str, IsAngled: *mut bool) -> str {
    return self.suggestPathToFileForDiagnostics(File.getName(), "", MainFile, IsAngled);
}

fn HeaderSearch::suggestPathToFileForDiagnostics(self: *HeaderSearch, File: str, WorkingDir: str, MainFile: str, IsAngled: *mut bool) -> str {
    let mut FilePath: str = File;
    if !WorkingDir.is_empty() && !is_absolute(FilePath, native) {
        make_absolute(WorkingDir, FilePath);
    }
    remove_dots(FilePath, true, native);
    native(FilePath, posix);
    File = FilePath.operator StringRef();
    let mut BestPrefixLength: u32 = 0;
    let mut CheckDir: Closure_13 = Closure_13 { WorkingDir: &mut WorkingDir, File: &mut File, BestPrefixLength: &mut BestPrefixLength };
    let mut BestPrefixIsFramework: bool = false;
    for DL in self.search_dir_range() {
        if DL.isNormalDir() {
            let mut Dir: str = operator(DL.getDirRef()).getName();
            if CheckDir.call(Dir) {
                if IsAngled {
                    *IsAngled = BestPrefixLength && isSystem(DL.getDirCharacteristic());
                }
                BestPrefixIsFramework = false;
            }
        } else if DL.isFramework() {
            let mut Dir: str = operator(DL.getFrameworkDirRef()).getName();
            if CheckDir.call(Dir) {
                if IsAngled {
                    *IsAngled = BestPrefixLength;
                }
                BestPrefixIsFramework = true;
            }
        }
    }
    if !BestPrefixLength && CheckDir.call(parent_path(MainFile, native)) {
        if IsAngled {
            *IsAngled = false;
        }
        BestPrefixIsFramework = false;
    }
    let mut Filename: str = File.drop_front(BestPrefixLength);
    for DL in self.search_dir_range() {
        if !DL.isHeaderMap() {
            continue;
        }
        let mut SpelledFilename: str = DL.getHeaderMap().reverseLookupFilename(Filename);
        if !SpelledFilename.is_empty() {
            Filename = SpelledFilename;
            BestPrefixIsFramework = false;
            break;
        }
    }
    let mut IsPrivateHeader: bool = false;
    let mut FrameworkName: str = "";
    let mut IncludeSpelling: str = "";
    if BestPrefixIsFramework && isFrameworkStylePath(Filename, IsPrivateHeader, FrameworkName, IncludeSpelling) {
        Filename = IncludeSpelling.operator StringRef();
    }
    return convert_to_slash(Filename, native);
}

fn normalizeModuleCachePath(FileMgr: *mut FileManager, Path: str, NormalizedPath: *mut SmallVectorImpl<char>) {
    NormalizedPath.assign(Path.begin(), Path.end());
    if !NormalizedPath.is_empty() {
        FileMgr.makeAbsolutePath(NormalizedPath, false);
        remove_dots(NormalizedPath, false, native);
    }
}

fn createSpecificModuleCachePathImpl(FileMgr: *mut FileManager, ModuleCachePath: str, DisableModuleHash: bool, ContextHash: str, NormalizedModuleCachePathLen: *mut u64) -> str {
    let mut SpecificModuleCachePath: str = "";
    normalizeModuleCachePath(FileMgr, ModuleCachePath, SpecificModuleCachePath);
    NormalizedModuleCachePathLen = SpecificModuleCachePath.len;
    if !SpecificModuleCachePath.is_empty() && !DisableModuleHash {
        append(SpecificModuleCachePath, ContextHash, "", "", "");
    }
    return SpecificModuleCachePath.operator basic_string();
}

fn HeaderSearch::initializeModuleCachePath(self, NewContextHash: str) {
    self.ContextHash = move(NewContextHash);
    self.SpecificModuleCachePath = createSpecificModuleCachePathImpl(self.FileMgr, self.HSOpts.ModuleCachePath, self.HSOpts.DisableModuleHash, self.ContextHash, self.NormalizedModuleCachePathLen);
}

fn createSpecificModuleCachePath(FileMgr: *mut FileManager, ModuleCachePath: str, DisableModuleHash: bool, ContextHash: str) -> str {
    let mut NormalizedModuleCachePathLen: u64 = 0;
    return createSpecificModuleCachePathImpl(FileMgr, ModuleCachePath, DisableModuleHash, move(ContextHash), NormalizedModuleCachePathLen);
}

