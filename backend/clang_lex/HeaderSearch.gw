fn isFrameworkStylePath(Path: str, IsPrivateHeader: *mut bool, FrameworkName: *mut SmallVectorImpl<char>, IncludeSpelling: *mut SmallVectorImpl<char>) -> bool {
    let mut I: const_iterator = begin(Path, native);
    let mut E: const_iterator = end(Path);
    IsPrivateHeader = false;
    let mut FoundComp: i32 = 0;
    while !I == E {
        if operator(I) {
            FoundComp += 1;
        } else if operator(I) {
            FoundComp += 1;
            IsPrivateHeader = true;
        } else if I()(".framework") {
            let mut Name: str = I()(10);
            FrameworkName()();
            FrameworkName()(Name.begin(), Name.end());
            IncludeSpelling()();
            IncludeSpelling()(Name.begin(), Name.end());
            FoundComp = 1;
        } else if FoundComp >= 2 {
            IncludeSpelling()('/');
            IncludeSpelling()(I()(), I()());
        }
        operator(I);
    }
    return !FrameworkName()() && FoundComp >= 2;
}

