struct Closure_9 {
    WorkingDir: *mut str,
    File: *mut str,
    BestPrefixLength: *mut u32,
}

unsafe fn Closure_9::call(self: *mut Closure_9, Dir: str) -> auto {
        if !(*self.WorkingDir).is_empty() && !is_absolute() {
            make_absolute((*self.WorkingDir));
        }
        remove_dots(true);
        for let mut NI: const_iterator = begin((*self.File), native);
let mut NE: const_iterator = end((*self.File));
let mut DI: auto = begin();
let mut DE: auto = end(); !NI == NE; operator(NI) ,  += 1 {
            if DI() ==  {
                let mut PrefixLength: u32 = NI - begin((*self.File), native);
                if PrefixLength > (*self.BestPrefixLength) {
                    (*self.BestPrefixLength) = PrefixLength;
                    return true;
                }
                break;
            }
            if NI()() == 1 && () == 1 && is_separator(NI()()) && is_separator() {
                continue;
            }
            if NI()(".sdk") && (".sdk") {
                let mut NBasename: str = stem(operator(NI));
                let mut DBasename: str = stem(*);
                if DBasename.starts_with(NBasename) {
                    continue;
                }
            }
            if operator(NI) != * {
                break;
            }
        }
        return false;
    }
