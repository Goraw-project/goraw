fn HeaderSearch::PrintStats(self) {
    let mut NumOnceOnlyFiles: u32 = 0;
    errs() << NumOnceOnlyFiles << " #import/#pragma once files.\n";
    errs() << NumIncluded << " #include/#include_next/#import.\n" << "    " << NumMultiIncludeFileOptzn << " #includes skipped due to the multi-include optimization.\n";
    errs() << " framework lookups.\n" << NumSubFrameworkLookups << " subframework lookups.\n";
}

