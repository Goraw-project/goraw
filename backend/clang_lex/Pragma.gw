struct PragmaDiagnosticHandler {
    Name: str,
    Namespace: *u8,
}

fn PragmaDiagnosticHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, DiagToken: *mut Token) {
    let mut DiagLoc: SourceLocation = DiagToken.getLocation();
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(identifier) {
        PP;
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut Callbacks: *mut PPCallbacks = PP.getPPCallbacks();
    PP.LexUnexpandedToken(Tok);
    if II.isStr("pop") {
        if !PP.getDiagnostics().popMappings(DiagLoc) {
            PP;
        } else if Callbacks {
            Callbacks.PragmaDiagnosticPop(DiagLoc, self.Namespace);
        }
        if Tok.isNot(eod) {
            PP;
        }
        return;
    } else if II.isStr("push") {
        PP.getDiagnostics().pushMappings(DiagLoc);
        if Callbacks {
            Callbacks.PragmaDiagnosticPush(DiagLoc, self.Namespace);
        }
        if Tok.isNot(eod) {
            PP;
        }
        return;
    }
    let mut SV: Severity = zeroed();
    if SV ==  {
        PP;
        return;
    }
    let mut StringLoc: SourceLocation = Tok.getLocation();
    let mut WarningName: str = "";
    if !PP.FinishLexStringLiteral(Tok, WarningName, "pragma diagnostic", false) {
        return;
    }
    if Tok.isNot(eod) {
        PP;
        return;
    }
    if WarningName.len < 3 || WarningName[0] != '-' || (WarningName[1] != 'W' && WarningName[1] != 'R') {
        PP;
        return;
    }
    let mut Flavor: Flavor = if WarningName[1] == 'W' { WarningOrError } else { Remark };
    let mut Group: str = WarningName[2..2 + npos];
    let mut unknownDiag: bool = false;
    if Group == "everything" {
        PP.getDiagnostics().setSeverityForAll(Flavor, SV, DiagLoc);
    } else {
        unknownDiag = PP.getDiagnostics().setSeverityForGroup(Flavor, Group, SV, DiagLoc);
    }
    if unknownDiag {
        PP << WarningName;
    } else if Callbacks {
        Callbacks.PragmaDiagnostic(DiagLoc, self.Namespace, SV, WarningName);
    }
}

