fn HandleMacroAnnotationPragma(PP: *mut Preprocessor, Tok: *mut Token, Pragma: *u8, MessageString: *mut str) -> *mut IdentifierInfo {
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << "(";
        return null;
    }
    PP.LexUnexpandedToken(Tok);
    if !Tok.is(identifier) {
        PP << identifier;
        return null;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !II.hasMacroDefinition() {
        PP << II;
        return null;
    }
    PP.Lex(Tok);
    if Tok.is(comma) {
        PP.Lex(Tok);
        if !PP.FinishLexStringLiteral(Tok, MessageString, Pragma, true) {
            return null;
        }
    }
    if Tok.isNot(r_paren) {
        PP << ")";
        return null;
    }
    return II;
}

