}

fn PragmaModuleLoadHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut Loc: SourceLocation = Tok.getLocation();
    let mut ModuleName: SmallVector<IdentifierLoc, 8> = SmallVector<IdentifierLoc, 8> {};
    if LexModuleName(PP, Tok, ModuleName) {
        return;
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma";
    }
    PP.getModuleLoader().loadModule(Loc, ModuleName, Hidden, false);
}

