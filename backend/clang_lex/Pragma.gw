fn PragmaWarningHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut DiagLoc: SourceLocation = Tok.getLocation();
    let mut Callbacks: *mut PPCallbacks = PP.getPPCallbacks();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << "(";
        return;
    }
    PP.Lex(Tok);
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if II && II.isStr("push") {
        let mut Level: i32 = -1;
