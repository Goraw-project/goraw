struct PragmaDebugHandler {
    Name: str,
}

fn PragmaDebugHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, DebugToken: *mut Token) {
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok, warn_pragma_debug_missing_command);
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if II.isStr("assert") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            llvm_unreachable_internal("This is an assertion!", "P:/Goraw/llvm-project/clang/lib/Lex/Pragma.cpp", 1110);
        }
    } else if II.isStr("crash") {
        let mut T: Timer = Timer { "crash", "pragma crash" };
        let mut R: TimeRegion = &mut T;
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            __builtin_trap();
        }
    } else if II.isStr("parser_crash") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            let mut Crasher: Token = Token {};
            Crasher.startToken();
            Crasher.setKind(annot_pragma_parser_crash);
            Crasher.setAnnotationRange(Tok.getLocation());
            PP.EnterToken(Crasher, false);
        }
    } else if II.isStr("sleep") {
        sleep_for(100);
    } else if II.isStr("dump") {
        let mut DumpAnnot: Token = Token {};
        DumpAnnot.startToken();
        DumpAnnot.setKind(annot_pragma_dump);
        DumpAnnot.setAnnotationRange(Tok.getLocation());
        PP.EnterToken(DumpAnnot, false);
    } else if II.isStr("diag_mapping") {
        let mut DiagName: Token = Token {};
        PP.LexUnexpandedToken(DiagName);
        if DiagName.is(eod) {
            PP.getDiagnostics().dump();
        } else if DiagName.is(string_literal) && !DiagName.hasUDSuffix() {
            let mut Literal: StringLiteralParser = StringLiteralParser { DiagName, PP, Unevaluated, CA_NoConversion };
            if Literal.hadError {
                return;
            }
            PP.getDiagnostics().dump(Literal.GetString());
        } else {
            PP.Diag(DiagName, warn_pragma_debug_missing_argument) << II.getName();
        }
    } else if II.isStr("llvm_fatal_error") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            report_fatal_error("#pragma clang __debug llvm_fatal_error", true);
        }
    } else if II.isStr("llvm_unreachable") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            llvm_unreachable_internal("#pragma clang __debug llvm_unreachable", "P:/Goraw/llvm-project/clang/lib/Lex/Pragma.cpp", 1152);
        }
    } else if II.isStr("macro") {
        let mut MacroName: Token = Token {};
        PP.LexUnexpandedToken(MacroName);
        let mut MacroII: *mut IdentifierInfo = MacroName.getIdentifierInfo();
        if MacroII {
            PP.dumpMacroInfo(MacroII);
        } else {
            PP.Diag(MacroName, warn_pragma_debug_missing_argument) << II.getName();
        }
    } else if II.isStr("module_map") {
        let mut ModuleName: SmallVector<IdentifierLoc, 8> = SmallVector<IdentifierLoc, 8> {};
        if LexModuleName(PP, Tok, ModuleName) {
            return;
        }
        let mut MM: *mut ModuleMap = PP.getHeaderSearchInfo().getModuleMap();
        let mut M: *mut Module = null;
        for IIAndLoc in ModuleName {
            M = MM.lookupModuleQualified(IIAndLoc.getIdentifierInfo().getName(), M).operator clang::Module *();
            if !M {
                PP.Diag(IIAndLoc.getLoc(), warn_pragma_debug_unknown_module) << IIAndLoc.getIdentifierInfo().getName();
                return;
            }
        }
        M.dump();
    } else if II.isStr("module_lookup") {
        let mut MName: Token = Token {};
        PP.LexUnexpandedToken(MName);
        let mut MNameII: *mut IdentifierInfo = MName.getIdentifierInfo();
        if !MNameII {
            PP.Diag(MName, warn_pragma_debug_missing_argument) << II.getName();
            return;
        }
        let mut M: *mut Module = PP.getHeaderSearchInfo().lookupModule(MNameII.getName(), SourceLocation {}, true, false);
        if !M {
            PP.Diag(MName, warn_pragma_debug_unable_to_find_module) << MNameII.getName();
            return;
        }
        M.dump();
    } else if II.isStr("overflow_stack") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            DebugOverflowStack(null);
        }
    } else if II.isStr("captured") {
        self.HandleCaptured(PP);
    } else if II.isStr("modules") {
        let mut Visitor: ModuleVisitor = ModuleVisitor { PP };
        let mut Kind: Token = Token {};
        PP.LexUnexpandedToken(Kind);
        let mut DumpII: *mut IdentifierInfo = Kind.getIdentifierInfo();
        if !DumpII {
            PP.Diag(Kind, warn_pragma_debug_missing_argument) << II.getName();
        } else if DumpII.isStr("all") {
            Visitor.visitAll(false);
        } else if DumpII.isStr("visible") {
            Visitor.visitAll(true);
        } else if DumpII.isStr("building") {
            for Building in PP.getBuildingSubmodules() {
                errs() << "in " << Building.M.getFullModuleName(false);
                if Building.ImportLoc.isValid() {
                    errs() << " imported ";
                    if Building.IsPragma {
                        errs() << "via pragma ";
                    }
                    errs() << "at ";
                    Building.ImportLoc.print(errs(), PP.getSourceManager());
                    errs() << "\n";
                }
            }
        } else {
            PP.Diag(Tok, warn_pragma_debug_unexpected_command) << DumpII.getName();
        }
    } else if II.isStr("sloc_usage") {
        let mut MaxNotes: optional<unsigned int> = optional<unsigned int> {};
        let mut ArgToken: Token = Token {};
        PP.Lex(ArgToken);
        let mut Value: u64 = 0;
        if ArgToken.is(numeric_constant) && PP.parseSimpleIntegerLiteral(ArgToken, Value) {
            MaxNotes = Value;
        } else if ArgToken.isNot(eod) {
            PP.Diag(ArgToken, warn_pragma_debug_unexpected_argument);
        }
        PP.Diag(Tok, remark_sloc_usage);
        PP.getSourceManager().noteSLocAddressSpaceUsage(PP.getDiagnostics(), MaxNotes);
    } else {
        PP.Diag(Tok, warn_pragma_debug_unexpected_command) << II.getName();
    }
    let mut Callbacks: *mut PPCallbacks = PP.getPPCallbacks();
    if Callbacks {
        Callbacks.PragmaDebug(Tok.getLocation(), II.getName());
    }
}

fn PragmaDebugHandler::HandleCaptured(self, PP: *mut Preprocessor) {
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma clang __debug captured";
        return;
    }
    let mut NameLoc: SourceLocation = Tok.getLocation();
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(1), 1 };
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_captured);
    Toks[0].setLocation(NameLoc);
    PP.EnterTokenStream(Toks, true, false);
}

fn PragmaDebugHandler::DebugOverflowStack(self, P: void (*)()) {
    let mut Self: void (*volatile)(void (*)()) = DebugOverflowStack;
    Self(Self as void (*)());
}

fn PragmaDebugHandler::getName(self: *PragmaDebugHandler) -> str {
    return self.Name;
}

fn PragmaDebugHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaUnsafeBufferUsageHandler {
    Name: str,
}

fn PragmaUnsafeBufferUsageHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok, err_pp_pragma_unsafe_buffer_usage_syntax);
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut Loc: SourceLocation = Tok.getLocation();
    if II.isStr("begin") {
        if PP.enterOrExitSafeBufferOptOutRegion(true, Loc) {
            PP.Diag(Loc, err_pp_double_begin_pragma_unsafe_buffer_usage);
        }
    } else if II.isStr("end") {
        if PP.enterOrExitSafeBufferOptOutRegion(false, Loc) {
            PP.Diag(Loc, err_pp_unmatched_end_begin_pragma_unsafe_buffer_usage);
        }
    } else {
        PP.Diag(Tok, err_pp_pragma_unsafe_buffer_usage_syntax);
    }
}

fn PragmaUnsafeBufferUsageHandler::getName(self: *PragmaUnsafeBufferUsageHandler) -> str {
    return self.Name;
}

fn PragmaUnsafeBufferUsageHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaDiagnosticHandler {
    Name: str,
    Namespace: *u8,
}

fn PragmaDiagnosticHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, DiagToken: *mut Token) {
    let mut DiagLoc: SourceLocation = DiagToken.getLocation();
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok, warn_pragma_diagnostic_invalid);
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut Callbacks: *mut PPCallbacks = PP.getPPCallbacks();
    PP.LexUnexpandedToken(Tok);
    if II.isStr("pop") {
        if !PP.getDiagnostics().popMappings(DiagLoc) {
            PP.Diag(Tok, warn_pragma_diagnostic_cannot_pop);
        } else if Callbacks {
            Callbacks.PragmaDiagnosticPop(DiagLoc, self.Namespace);
        }
        if Tok.isNot(eod) {
            PP.Diag(Tok.getLocation(), warn_pragma_diagnostic_invalid_token);
        }
        return;
    } else if II.isStr("push") {
        PP.getDiagnostics().pushMappings(DiagLoc);
        if Callbacks {
            Callbacks.PragmaDiagnosticPush(DiagLoc, self.Namespace);
        }
        if Tok.isNot(eod) {
            PP.Diag(Tok.getLocation(), warn_pragma_diagnostic_invalid_token);
        }
        return;
    }
    let mut SV: Severity = II.getName().Case("ignored", Ignored).Case("warning", Warning).Case("error", Error).Case("fatal", Fatal).Default();
    if SV ==  {
        PP.Diag(Tok, warn_pragma_diagnostic_invalid);
        return;
    }
    let mut StringLoc: SourceLocation = Tok.getLocation();
    let mut WarningName: str = "";
    if !PP.FinishLexStringLiteral(Tok, WarningName, "pragma diagnostic", false) {
        return;
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_diagnostic_invalid_token);
        return;
    }
    if WarningName.len < 3 || WarningName[0] != '-' || (WarningName[1] != 'W' && WarningName[1] != 'R') {
        PP.Diag(StringLoc, warn_pragma_diagnostic_invalid_option);
        return;
    }
    let mut Flavor: Flavor = if WarningName[1] == 'W' { WarningOrError } else { Remark };
    let mut Group: str = WarningName[2..2 + npos];
    let mut unknownDiag: bool = false;
    if Group == "everything" {
        PP.getDiagnostics().setSeverityForAll(Flavor, SV, DiagLoc);
    } else {
        unknownDiag = PP.getDiagnostics().setSeverityForGroup(Flavor, Group, SV, DiagLoc);
    }
    if unknownDiag {
        PP.Diag(StringLoc, warn_pragma_diagnostic_unknown_warning) << WarningName;
    } else if Callbacks {
        Callbacks.PragmaDiagnostic(DiagLoc, self.Namespace, SV, WarningName);
    }
}

fn PragmaDiagnosticHandler::getName(self: *PragmaDiagnosticHandler) -> str {
    return self.Name;
}

fn PragmaDiagnosticHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

