fn PragmaHandler::~PragmaHandler(self) {}

fn EmptyPragmaHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {}

fn PragmaNamespace::FindHandler(self: *PragmaNamespace, Name: str, IgnoreNull: bool) -> *mut PragmaHandler {
    let mut I: const_iterator = self.Handlers.find(Name);
    if I != self.Handlers.end() {
        return operator(I).getValue().get();
    }
    if IgnoreNull {
        return null;
    }
    I = self.Handlers.find("");
    if I != self.Handlers.end() {
        return operator(I).getValue().get();
    }
    return null;
}

fn PragmaNamespace::AddPragma(self, Handler: *mut PragmaHandler) {
    assert!(!self.Handlers.count(Handler.getName()), "A handler with this name is already registered in this namespace");
    self.Handlers[Handler.getName()].reset(Handler);
}

fn PragmaNamespace::RemovePragmaHandler(self, Handler: *mut PragmaHandler) {
    let mut I: iterator = self.Handlers.find(Handler.getName());
    assert!(I != self.Handlers.end(), "Handler not registered in this namespace");
    operator(I).getValue().release();
    self.Handlers.erase(I);
}

fn PragmaNamespace::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.LexUnexpandedToken(Tok);
    let mut Handler: *mut PragmaHandler = self.FindHandler(if Tok.getIdentifierInfo() { Tok.getIdentifierInfo().getName() } else { "" }, false);
    if !Handler {
        PP.Diag(Tok, warn_pragma_ignored);
        return;
    }
    Handler.HandlePragma(PP, Introducer, Tok);
}

struct TokenCollector {
    Self: *mut Preprocessor,
    Collect: bool,
    Tokens: SmallVector<Token, 3>,
    Tok: *mut Token,
}

fn TokenCollector::lex(self) {
    if self.Collect {
        self.Tokens.push(self.Tok);
    }
    self.Self.Lex(self.Tok);
}

fn TokenCollector::revert(self) {
    assert!(self.Collect, "did not collect tokens");
    assert!(!self.Tokens.is_empty(), "collected unexpected number of tokens");
    let mut Toks: []Token = make_unique(self.Tokens.len);
    copy(self.Tokens.begin() + 1, self.Tokens.end(), Toks.get());
    Toks[self.Tokens.len - 1] = self.Tok;
    self.Self.EnterTokenStream(move(Toks), self.Tokens.len, true, true);
    self.Tok = *self.Tokens.begin();
}

fn Preprocessor::HandlePragmaDirective(self, Introducer: PragmaIntroducer) {
    if self.Callbacks {
        operator(self.Callbacks).PragmaDirective(Introducer.Loc, Introducer.Kind);
    }
    if !self.PragmasEnabled {
        return;
    }
    self.NumPragma += 1;
    let mut Tok: Token = Token {};
    operator(self.PragmaHandlers).HandlePragma(*self, Introducer, Tok);
    if (self.CurTokenLexer && operator(self.CurTokenLexer).isParsingPreprocessorDirective()) || (self.CurPPLexer && self.CurPPLexer.ParsingPreprocessorDirective) {
        self.DiscardUntilEndOfDirective(null);
    }
}

fn Preprocessor::Handle_Pragma(self, Tok: *mut Token) {
    let mut Toks: TokenCollector = TokenCollector { Self: *self, Collect: self.InMacroArgPreExpansion, Tokens: SmallVector<Token, 3> {}, Tok: Tok };
    let mut PragmaLoc: SourceLocation = Tok.getLocation();
    Toks.lex();
    if Tok.isNot(l_paren) {
        self.Diag(PragmaLoc, err__Pragma_malformed);
        return;
    }
    Toks.lex();
    if !isStringLiteral(Tok.getKind()) {
        self.Diag(PragmaLoc, err__Pragma_malformed);
        if Tok.isNot(r_paren) && Tok.isNot(eof) && Tok.isNot(eod) {
            self.Lex(Tok);
        }
        while Tok.isNot(r_paren) && !Tok.isAtStartOfLine() && Tok.isNot(eof) && Tok.isNot(eod) {
            self.Lex(Tok);
        }
        if Tok.is(r_paren) {
            self.Lex(Tok);
        }
        return;
    }
    if Tok.hasUDSuffix() {
        self.Diag(Tok, err_invalid_string_udl);
        self.Lex(Tok);
        if Tok.is(r_paren) {
            self.Lex(Tok);
        }
        return;
    }
    let mut StrTok: Token = Tok;
    Toks.lex();
    if Tok.isNot(r_paren) {
        self.Diag(PragmaLoc, err__Pragma_malformed);
        return;
    }
    if self.InMacroArgPreExpansion {
        Toks.revert();
        return;
    }
    let mut RParenLoc: SourceLocation = Tok.getLocation();
    let mut Invalid: bool = false;
    let mut StrVal: str = "";
    StrVal.resize(StrTok.getLength());
    let mut StrValRef: str = self.getSpelling(StrTok, StrVal, &mut Invalid);
    if Invalid {
        self.Diag(PragmaLoc, err__Pragma_malformed);
        return;
    }
    assert!(StrValRef.len <= StrVal.len);
    if StrValRef.begin() != StrVal.begin() {
        StrVal.assign(StrValRef);
    } else if StrValRef.len != StrVal.len {
        StrVal.resize(StrValRef.len);
    }
    prepare_PragmaString(StrVal);
    let mut TmpTok: Token = Token {};
    TmpTok.startToken();
    self.CreateString(StrVal.operator StringRef(), TmpTok, SourceLocation {}, SourceLocation {});
    let mut TokLoc: SourceLocation = TmpTok.getLocation();
    let mut TL: unique_ptr<Lexer> = Create_PragmaLexer(TokLoc, PragmaLoc, RParenLoc, StrVal.len, *self);
    self.EnterSourceFileWithLexer(move(TL), null);
    self.HandlePragmaDirective(PragmaIntroducer { Kind: PIK__Pragma, Loc: PragmaLoc });
    return self.Lex(Tok);
}

fn prepare_PragmaString(StrVal: *mut SmallVectorImpl<char>) {
    if StrVal[0] == 'L' || StrVal[0] == 'U' || (StrVal[0] == 'u' && StrVal[1] != '8') {
        StrVal.erase(StrVal.begin());
    } else if StrVal[0] == 'u' {
        StrVal.erase(StrVal.begin(), StrVal.begin() + 2);
    }
    if StrVal[0] == 'R' {
        assert!(StrVal[1] == '"' && StrVal[StrVal.len - 1] == '"', "Invalid raw string token!");
        let mut NumDChars: u32 = 0;
        while StrVal[2 + NumDChars] != '(' {
            assert!(NumDChars < (StrVal.len - 5) / 2, "Invalid raw string token!");
            NumDChars += 1;
        }
        assert!(StrVal[StrVal.len - 2 - NumDChars] == ')');
        StrVal.erase(StrVal.begin(), StrVal.begin() + 2 + NumDChars);
        StrVal.erase(StrVal.end() - 1 - NumDChars, StrVal.end());
    } else {
        assert!(StrVal[0] == '"' && StrVal[StrVal.len - 1] == '"', "Invalid string token!");
        let mut ResultPos: u32 = 1;
        for let mut i: u64 = 1;
let mut e: u64 = StrVal.len - 1; i != e; i += 1 {
            if StrVal[i] == '\' && i + 1 < e && (StrVal[i + 1] == '\' || StrVal[i + 1] == '"') {
                i += 1;
            }
            StrVal[ResultPos += 1] = StrVal[i];
        }
        StrVal.erase(StrVal.begin() + ResultPos, StrVal.end() - 1);
    }
    StrVal[0] = ' ';
    StrVal[StrVal.len - 1] = 10;
}

fn Preprocessor::HandleMicrosoft__pragma(self, Tok: *mut Token) {
    let mut Toks: TokenCollector = TokenCollector { Self: *self, Collect: self.InMacroArgPreExpansion, Tokens: SmallVector<Token, 3> {}, Tok: Tok };
    let mut PragmaLoc: SourceLocation = Tok.getLocation();
    Toks.lex();
    if Tok.isNot(l_paren) {
        self.Diag(PragmaLoc, err__Pragma_malformed);
        return;
    }
    let mut PragmaToks: SmallVector<Token, 32> = SmallVector<Token, 32> {};
    let mut NumParens: i32 = 0;
    Toks.lex();
    while Tok.isNot(eof) {
        PragmaToks.push(Tok);
        if Tok.is(l_paren) {
            NumParens += 1;
        } else if Tok.is(r_paren) && NumParens -= 1 == 0 {
            break;
        }
        Toks.lex();
    }
    if Tok.is(eof) {
        self.Diag(PragmaLoc, err_unterminated___pragma);
        return;
    }
    if self.InMacroArgPreExpansion {
        Toks.revert();
        return;
    }
    PragmaToks.front().setFlag(LeadingSpace);
    PragmaToks.back().setKind(eod);
    let mut TokArray: *mut Token = PragmaToks.len;
    copy(PragmaToks.begin(), PragmaToks.end(), TokArray);
    self.EnterTokenStream(TokArray, PragmaToks.len, true, true, false);
    self.HandlePragmaDirective(PragmaIntroducer { Kind: PIK___pragma, Loc: PragmaLoc });
    return self.Lex(Tok);
}

fn Preprocessor::HandlePragmaOnce(self, OnceTok: *mut Token) {
    if self.isInPrimaryFile() && self.TUKind != TU_Prefix && !self.getLangOpts().IsHeaderFile {
        self.Diag(OnceTok, pp_pragma_once_in_main_file);
        return;
    }
    self.HeaderInfo.MarkFileIncludeOnce(operator(self.getCurrentFileLexer().getFileEntry()));
}

fn Preprocessor::HandlePragmaMark(self, MarkTok: *mut Token) {
    assert!(self.CurPPLexer, "No current lexer?");
    let mut Buffer: str = "";
    operator(self.CurLexer).ReadToEndOfLine(&mut Buffer);
    if self.Callbacks {
        operator(self.Callbacks).PragmaMark(MarkTok.getLocation(), Buffer.operator StringRef());
    }
}

fn Preprocessor::HandlePragmaPoison(self) {
    let mut Tok: Token = Token {};
    while true {
        if self.CurPPLexer {
            self.CurPPLexer.LexingRawMode = true;
        }
        self.LexUnexpandedToken(Tok);
        if self.CurPPLexer {
            self.CurPPLexer.LexingRawMode = false;
        }
        if Tok.is(eod) {
            return;
        }
        if Tok.isNot(raw_identifier) {
            self.Diag(Tok, err_pp_invalid_poison);
            return;
        }
        let mut II: *mut IdentifierInfo = self.LookUpIdentifierInfo(Tok);
        if II.isPoisoned() {
            continue;
        }
        if self.isMacroDefined(II) {
            self.Diag(Tok, pp_poisoning_existing_macro);
        }
        II.setIsPoisoned(true);
        if II.isFromAST() {
            II.setChangedSinceDeserialization();
        }
    }
}

fn Preprocessor::HandlePragmaSystemHeader(self, SysHeaderTok: *mut Token) {
    if self.isInPrimaryFile() {
        self.Diag(SysHeaderTok, pp_pragma_sysheader_in_main_file);
        return;
    }
    let mut TheLexer: *mut PreprocessorLexer = self.getCurrentFileLexer();
    self.HeaderInfo.MarkFileSystemHeader(operator(TheLexer.getFileEntry()));
    let mut PLoc: PresumedLoc = self.SourceMgr.getPresumedLoc(SysHeaderTok.getLocation(), true);
    if PLoc.isInvalid() {
        return;
    }
    let mut FilenameID: u32 = self.SourceMgr.getLineTableFilenameID(PLoc.getFilename());
    if self.Callbacks {
        operator(self.Callbacks).FileChanged(SysHeaderTok.getLocation(), SystemHeaderPragma, C_System, FileID {});
    }
    self.SourceMgr.AddLineNote(SysHeaderTok.getLocation(), PLoc.getLine() + 1, FilenameID, false, false, C_System);
}

fn Preprocessor::HandlePragmaDependency(self, DependencyTok: *mut Token) {
    let mut FilenameTok: Token = Token {};
    if self.LexHeaderName(FilenameTok, false) {
        return;
    }
    if FilenameTok.isNot(header_name) {
        self.Diag(FilenameTok.getLocation(), err_pp_expects_filename);
        return;
    }
    let mut FilenameBuffer: str = "";
    let mut Invalid: bool = false;
    let mut Filename: str = self.getSpelling(FilenameTok, FilenameBuffer, &mut Invalid);
    if Invalid {
        return;
    }
    let mut isAngled: bool = self.GetIncludeFilenameSpelling(FilenameTok.getLocation(), Filename);
    if Filename.is_empty() {
        return;
    }
    let mut File: OptionalFileEntryRef = self.LookupFile(FilenameTok.getLocation(), Filename, isAngled, null, null, null, null, null, null, null, null, false, true, true);
    if !File {
        if !self.SuppressIncludeNotFoundError {
            self.Diag(FilenameTok, err_pp_file_not_found) << Filename;
        }
        return;
    }
    let mut CurFile: OptionalFileEntryRef = self.getCurrentFileLexer().getFileEntry();
    if CurFile && operator(CurFile).getModificationTime() < operator(File).getModificationTime() {
        let mut Message: str = "";
        self.Lex(DependencyTok);
        while DependencyTok.isNot(eod) {
            operator(Message, self.getSpelling(DependencyTok, null) + " ");
            self.Lex(DependencyTok);
        }
        if !Message.is_empty() {
            Message.erase(Message.end() - 1);
        }
        self.Diag(FilenameTok, pp_out_of_date_dependency) << Message;
    }
}

fn Preprocessor::ParsePragmaPushOrPopMacro(self, Tok: *mut Token) -> *mut IdentifierInfo {
    let mut PragmaTok: Token = Tok;
    self.Lex(Tok);
    if Tok.isNot(l_paren) {
        self.Diag(PragmaTok.getLocation(), err_pragma_push_pop_macro_malformed) << self.getSpelling(PragmaTok, null);
        return null;
    }
    self.Lex(Tok);
    if Tok.isNot(string_literal) {
        self.Diag(PragmaTok.getLocation(), err_pragma_push_pop_macro_malformed) << self.getSpelling(PragmaTok, null);
        return null;
    }
    if Tok.hasUDSuffix() {
        self.Diag(Tok, err_invalid_string_udl);
        return null;
    }
    let mut StrTok: Token = Tok;
    let mut StrVal: str = self.getSpelling(StrTok, null);
    self.Lex(Tok);
    if Tok.isNot(r_paren) {
        self.Diag(PragmaTok.getLocation(), err_pragma_push_pop_macro_malformed) << self.getSpelling(PragmaTok, null);
        return null;
    }
    assert!(StrVal[0] == '"' && StrVal[StrVal.len - 1] == '"', "Invalid string token!");
    if StrVal.len <= 2 {
        self.Diag(StrTok.getLocation(), warn_pargma_push_pop_macro_empty_string) << SourceRange { B: StrTok.getLocation(), E: StrTok.getLocation().getLocWithOffset(StrTok.getLength()) } << PragmaTok.getIdentifierInfo().isStr("pop_macro");
        return null;
    }
    let mut MacroTok: Token = Token {};
    MacroTok.startToken();
    MacroTok.setKind(raw_identifier);
    self.CreateString(&mut StrVal[1][0..StrVal.len - 2], MacroTok, SourceLocation {}, SourceLocation {});
    return self.LookUpIdentifierInfo(MacroTok);
}

fn Preprocessor::HandlePragmaPushMacro(self, PushMacroTok: *mut Token) {
    let mut IdentInfo: *mut IdentifierInfo = self.ParsePragmaPushOrPopMacro(PushMacroTok);
    if !IdentInfo {
        return;
    }
    let mut MI: *mut MacroInfo = self.getMacroInfo(IdentInfo);
    if MI {
        MI.setIsAllowRedefinitionsWithoutWarning(true);
    }
    self.PragmaPushMacroInfo[IdentInfo].push(MI);
}

fn Preprocessor::HandlePragmaPopMacro(self, PopMacroTok: *mut Token) {
    let mut MessageLoc: SourceLocation = PopMacroTok.getLocation();
    let mut IdentInfo: *mut IdentifierInfo = self.ParsePragmaPushOrPopMacro(PopMacroTok);
    if !IdentInfo {
        return;
    }
    let mut iter: iterator = self.PragmaPushMacroInfo.find(IdentInfo);
    if iter != self.PragmaPushMacroInfo.end() {
        if self.getMacroInfo(IdentInfo) {
            MI;
        } else {
            if MI.isWarnIfUnused() {
                self.WarnUnusedMacroLocs.erase(MI.getDefinitionLoc());
            }
            self.appendMacroDirective(IdentInfo, self.AllocateUndefMacroDirective(MessageLoc));
        }
        let mut MacroToReInstall: *mut MacroInfo = operator(iter).second.back();
        if MacroToReInstall {
            self.appendDefMacroDirective(IdentInfo, MacroToReInstall, MessageLoc);
        }
        operator(iter).second.pop();
        if operator(iter).second.is_empty() {
            self.PragmaPushMacroInfo.erase(iter);
        }
    } else {
        self.Diag(MessageLoc, warn_pragma_pop_macro_no_push) << IdentInfo.getName();
    }
}

fn Preprocessor::HandlePragmaIncludeAlias(self, Tok: *mut Token) {
    self.Lex(Tok);
    if Tok.isNot(l_paren) {
        self.Diag(Tok, warn_pragma_include_alias_expected) << "(";
        return;
    }
    let mut SourceFilenameTok: Token = Token {};
    if self.LexHeaderName(SourceFilenameTok, true) {
        return;
    }
    let mut SourceFileName: str = "";
    let mut FileNameBuffer: str = "";
    if SourceFilenameTok.is(header_name) {
        SourceFileName = self.getSpelling(SourceFilenameTok, FileNameBuffer, null);
    } else {
        self.Diag(Tok, warn_pragma_include_alias_expected_filename);
        return;
    }
    FileNameBuffer.clear();
    self.Lex(Tok);
    if Tok.isNot(comma) {
        self.Diag(Tok, warn_pragma_include_alias_expected) << ",";
        return;
    }
    let mut ReplaceFilenameTok: Token = Token {};
    if self.LexHeaderName(ReplaceFilenameTok, true) {
        return;
    }
    let mut ReplaceFileName: str = "";
    if ReplaceFilenameTok.is(header_name) {
        ReplaceFileName = self.getSpelling(ReplaceFilenameTok, FileNameBuffer, null);
    } else {
        self.Diag(Tok, warn_pragma_include_alias_expected_filename);
        return;
    }
    self.Lex(Tok);
    if Tok.isNot(r_paren) {
        self.Diag(Tok, warn_pragma_include_alias_expected) << ")";
        return;
    }
    let mut OriginalSource: str = SourceFileName;
    let mut SourceIsAngled: bool = self.GetIncludeFilenameSpelling(SourceFilenameTok.getLocation(), SourceFileName);
    let mut ReplaceIsAngled: bool = self.GetIncludeFilenameSpelling(ReplaceFilenameTok.getLocation(), ReplaceFileName);
    if !SourceFileName.is_empty() && !ReplaceFileName.is_empty() && (SourceIsAngled != ReplaceIsAngled) {
        let mut DiagID: u32 = 0;
        if SourceIsAngled {
            DiagID = warn_pragma_include_alias_mismatch_angle;
        } else {
            DiagID = warn_pragma_include_alias_mismatch_quote;
        }
        self.Diag(SourceFilenameTok.getLocation(), DiagID) << SourceFileName << ReplaceFileName;
        return;
    }
    self.getHeaderSearchInfo().AddIncludeAlias(OriginalSource, ReplaceFileName);
}

fn LexModuleNameComponent(PP: *mut Preprocessor, Tok: *mut Token, ModuleNameComponent: *mut IdentifierLoc, First: bool) -> bool {
    PP.LexUnexpandedToken(Tok);
    if Tok.is(string_literal) && !Tok.hasUDSuffix() {
        let mut Literal: StringLiteralParser = StringLiteralParser { Tok, PP, Unevaluated, CA_NoConversion };
        if Literal.hadError {
            return true;
        }
        ModuleNameComponent = IdentifierLoc { Loc: Tok.getLocation(), II: PP.getIdentifierInfo(Literal.GetString()) };
    } else if !Tok.isAnnotation() && Tok.getIdentifierInfo() {
        ModuleNameComponent = IdentifierLoc { Loc: Tok.getLocation(), II: Tok.getIdentifierInfo() };
    } else {
        PP.Diag(Tok.getLocation(), err_pp_expected_module_name) << First;
        return true;
    }
    return false;
}

fn LexModuleName(PP: *mut Preprocessor, Tok: *mut Token, ModuleName: *mut SmallVectorImpl<IdentifierLoc>) -> bool {
    while true {
        let mut NameComponent: IdentifierLoc = IdentifierLoc {};
        if LexModuleNameComponent(PP, Tok, NameComponent, ModuleName.is_empty()) {
            return true;
        }
        ModuleName.push(NameComponent);
        PP.LexUnexpandedToken(Tok);
        if Tok.isNot(period) {
            return false;
        }
    }
}

fn Preprocessor::HandlePragmaModuleBuild(self, Tok: *mut Token) {
    let mut Loc: SourceLocation = Tok.getLocation();
    let mut ModuleNameLoc: IdentifierLoc = IdentifierLoc {};
    if LexModuleNameComponent(*self, Tok, ModuleNameLoc, true) {
        return;
    }
    let mut ModuleName: *mut IdentifierInfo = ModuleNameLoc.getIdentifierInfo();
    self.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
        self.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma";
        self.DiscardUntilEndOfDirective(null);
    }
    operator(self.CurLexer).LexingRawMode = true;
    let mut TryConsumeIdentifier: Closure_1 = Closure_1 { Tok: &mut Tok, cap_1: self };
    let mut Start: *u8 = operator(self.CurLexer).getBufferLocation();
    let mut End: *u8 = null;
    let mut NestingLevel: u32 = 1;
    while true {
        End = operator(self.CurLexer).getBufferLocation();
        operator(self.CurLexer).Lex(Tok);
        if Tok.is(eof) {
            self.Diag(Loc, err_pp_module_build_missing_end);
            break;
        }
        if Tok.isNot(hash) || !Tok.isAtStartOfLine() {
            continue;
        }
        operator(self.CurLexer).ParsingPreprocessorDirective = true;
        operator(self.CurLexer).Lex(Tok);
        if TryConsumeIdentifier.call("pragma") && TryConsumeIdentifier.call("clang") && TryConsumeIdentifier.call("module") {
            if TryConsumeIdentifier.call("build") {
                NestingLevel += 1;
            } else if TryConsumeIdentifier.call("endbuild") {
                if NestingLevel -= 1 == 0 {
                    break;
                }
            }
            assert!(Tok.getKind() != eof, "missing EOD before EOF");
        }
    }
    operator(self.CurLexer).LexingRawMode = false;
    assert!(operator(self.CurLexer).getBuffer().begin() <= Start && Start <= operator(self.CurLexer).getBuffer().end() && operator(self.CurLexer).getBuffer().begin() <= End && End <= operator(self.CurLexer).getBuffer().end(), "module source range not contained within same file buffer");
    self.TheModuleLoader.createModuleFromSource(Loc, ModuleName.getName(), Start[0..End - Start]);
}

fn Preprocessor::HandlePragmaHdrstop(self, Tok: *mut Token) {
    self.Lex(Tok);
    if Tok.is(l_paren) {
        self.Diag(Tok.getLocation(), warn_pp_hdrstop_filename_ignored);
        let mut FileName: str = "";
        if !self.LexStringLiteral(Tok, FileName, "pragma hdrstop", false) {
            return;
        }
        if Tok.isNot(r_paren) {
            self.Diag(Tok, err_expected) << r_paren;
            return;
        }
        self.Lex(Tok);
    }
    if Tok.isNot(eod) {
        self.Diag(Tok.getLocation(), ext_pp_extra_tokens_at_eol) << "pragma hdrstop";
    }
    if self.creatingPCHWithPragmaHdrStop() && self.SourceMgr.isInMainFile(Tok.getLocation()) {
        assert!(self.CurLexer, "no lexer for #pragma hdrstop processing");
        let mut Result: *mut Token = Tok;
        Result.startToken();
        operator(self.CurLexer).FormTokenWithChars(Result, operator(self.CurLexer).BufferEnd, eof);
        operator(self.CurLexer).cutOffLexing();
    }
    if self.usingPCHWithPragmaHdrStop() {
        self.SkippingUntilPragmaHdrStop = false;
    }
}

fn Preprocessor::isPragmaSetPPStateMacro(self, MacroName: *mut IdentifierInfo) -> bool {
    return MacroName == self.Ident__GLIBCXX__;
}

fn Preprocessor::HandlePragmaSetPPState(self, Introducer: PragmaIntroducer, Tok: *mut Token) {
    self.LexUnexpandedToken(Tok);
    if !Tok.getIdentifierInfo() {
        self.Diag(Tok.getLocation(), err_pp_pragma_set_pp_state_expected_name);
        return;
    }
    let mut MacroName: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !self.isPragmaSetPPStateMacro(MacroName) {
        self.Diag(Tok.getLocation(), err_pp_pragma_set_pp_state_invalid_arg) << MacroName;
        return;
    }
    self.Lex(Tok);
    let mut Value: uint64_t = zeroed();
    if !Tok.is(numeric_constant) || !self.parseSimpleIntegerLiteral(Tok, Value) {
        self.Diag(Tok.getLocation(), err_pp_pragma_set_pp_state_expected_int_after) << MacroName.getName();
        return;
    }
    if MacroName.getName() == "__GLIBCXX__" {
        self.setStdLibCxxVersion(Value);
    } else {
        llvm_unreachable_internal("forgot to handle a possible argument to __set_pp_state", "P:/Goraw/llvm-project/clang/lib/Lex/Pragma.cpp", 951);
    }
    if self.Callbacks {
        operator(self.Callbacks).PragmaSetPPState(Introducer.Loc, MacroName, Value);
    }
}

fn Preprocessor::AddPragmaHandler(self, Namespace: str, Handler: *mut PragmaHandler) {
    let mut InsertNS: *mut PragmaNamespace = self.PragmaHandlers.get();
    if !Namespace.is_empty() {
        if operator(self.PragmaHandlers).FindHandler(Namespace, true) {
            Existing;
        } else {
            InsertNS = Existing.getIfNamespace();
            assert!(InsertNS != null, "Cannot have a pragma namespace and pragma handler with the same name!");
        }
    }
    assert!(!InsertNS.FindHandler(Handler.getName(), true), "Pragma handler already exists for this identifier!");
    InsertNS.AddPragma(Handler);
}

fn Preprocessor::RemovePragmaHandler(self, Namespace: str, Handler: *mut PragmaHandler) {
    let mut NS: *mut PragmaNamespace = self.PragmaHandlers.get();
    if !Namespace.is_empty() {
        let mut Existing: *mut PragmaHandler = operator(self.PragmaHandlers).FindHandler(Namespace, true);
        assert!(Existing, "Namespace containing handler does not exist!");
        NS = Existing.getIfNamespace();
        assert!(NS, "Invalid namespace, registered as a regular pragma handler!");
    }
    NS.RemovePragmaHandler(Handler);
    if NS != self.PragmaHandlers.get() && NS.IsEmpty() {
        operator(self.PragmaHandlers).RemovePragmaHandler(NS);
        NS;
    }
}

fn Preprocessor::LexOnOffSwitch(self, Result: *mut OnOffSwitch) -> bool {
    let mut Tok: Token = Token {};
    self.LexUnexpandedToken(Tok);
    if Tok.isNot(identifier) {
        self.Diag(Tok, ext_on_off_switch_syntax);
        return true;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if II.isStr("ON") {
        Result = OOS_ON;
    } else if II.isStr("OFF") {
        Result = OOS_OFF;
    } else if II.isStr("DEFAULT") {
        Result = OOS_DEFAULT;
    } else {
        self.Diag(Tok, ext_on_off_switch_syntax);
        return true;
    }
    self.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
        self.Diag(Tok, ext_pragma_syntax_eod);
    }
    return false;
}

