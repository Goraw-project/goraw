fn PragmaMessageHandler::PragmaKind(self, Kind: PragmaMessageKind, PragmaNameOnly: bool) -> *u8 {
    match Kind {
        PMK_Message => {
            return if PragmaNameOnly { "message" } else { "pragma message" };
        },
        PMK_Warning => {
            return if PragmaNameOnly { "warning" } else { "pragma warning" };
        },
        PMK_Error => {
            return if PragmaNameOnly { "error" } else { "pragma error" };
        },
    }
    llvm_unreachable_internal("Unknown PragmaMessageKind!", "clang\\lib\\Lex\\Pragma.cpp", 1691);
}

fn PragmaMessageHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut MessageLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    let mut ExpectClosingParen: bool = false;
    match Tok.getKind() {
        l_paren => {
            ExpectClosingParen = true;
        },
        string_literal => {
            break;
        },
        _ => {
            PP << self.Kind;
        },
    }
    let mut MessageString: str = "";
    if !PP.FinishLexStringLiteral(Tok, MessageString, PragmaKind(self.Kind, false), true) {
        return;
    }
    if ExpectClosingParen {
        if Tok.isNot(r_paren) {
            PP << self.Kind;
            return;
        }
        PP.Lex(Tok);
    }
    if Tok.isNot(eod) {
        PP << self.Kind;
        return;
    }
    PP << MessageString;
    if PP.getPPCallbacks() {
        Callbacks;
    } else {
        Callbacks.PragmaMessage(MessageLoc, self.Namespace, self.Kind, MessageString);
    }
}

