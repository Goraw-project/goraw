fn LexModuleNameComponent(PP: *mut Preprocessor, Tok: *mut Token, ModuleNameComponent: *mut IdentifierLoc, First: bool) -> bool {
    PP.LexUnexpandedToken(Tok);
    if Tok.is(string_literal) && !Tok.hasUDSuffix() {
        let mut Literal: StringLiteralParser = Tok(PP, Unevaluated);
        if Literal.hadError {
            return true;
        }
        ModuleNameComponent = IdentifierLoc { Loc: Tok.getLocation(), II: PP.getIdentifierInfo(Literal.GetString()) };
    } else if !Tok.isAnnotation() && Tok.getIdentifierInfo() {
        ModuleNameComponent = IdentifierLoc { Loc: Tok.getLocation(), II: Tok.getIdentifierInfo() };
    } else {
        PP << First;
        return true;
    }
    return false;
}

fn LexModuleName(PP: *mut Preprocessor, Tok: *mut Token, ModuleName: *mut SmallVectorImpl<IdentifierLoc>) -> bool {
    while true {
        let mut NameComponent: IdentifierLoc = IdentifierLoc {};
        if LexModuleNameComponent(PP, Tok, NameComponent, ModuleName()()) {
            return true;
        }
        ModuleName()(NameComponent);
        PP.LexUnexpandedToken(Tok);
        if Tok.isNot(period) {
            return false;
        }
    }
}

fn Preprocessor::HandlePragmaModuleBuild(self, Tok: *mut Token) {
    let mut Loc: SourceLocation = Tok.getLocation();
    let mut ModuleNameLoc: IdentifierLoc = IdentifierLoc {};
    if LexModuleNameComponent(*self, Tok, ModuleNameLoc, true) {
        return;
    }
    let mut ModuleName: *mut IdentifierInfo = ModuleNameLoc.getIdentifierInfo();
    self.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
         << "pragma";
        self.DiscardUntilEndOfDirective(null);
    }
    let mut TryConsumeIdentifier: Closure_1 = Closure_1 { Tok: &mut Tok, cap_1: self };
    let mut Start: *u8 = null;
    let mut End: *u8 = null;
    let mut NestingLevel: u32 = 1;
    while true {
        if Tok.is(eof) {
            break;
        }
        if Tok.isNot(hash) || !Tok.isAtStartOfLine() {
            continue;
        }
        if TryConsumeIdentifier.call("pragma") && TryConsumeIdentifier.call("clang") && TryConsumeIdentifier.call("module") {
            if TryConsumeIdentifier.call("build") {
                NestingLevel += 1;
            } else if TryConsumeIdentifier.call("endbuild") {
                if NestingLevel -= 1 == 0 {
                    break;
                }
            }
            assert!(Tok.getKind() != eof, "missing EOD before EOF");
        }
    }
    self.TheModuleLoader.createModuleFromSource(Loc, ModuleName.getName(), Start[0..End - Start]);
}

fn Preprocessor::HandlePragmaHdrstop(self, Tok: *mut Token) {
    self.Lex(Tok);
    if Tok.is(l_paren) {
        let mut FileName: str = "";
        if !self.LexStringLiteral(Tok, FileName, "pragma hdrstop", false) {
            return;
        }
        if Tok.isNot(r_paren) {
             << r_paren;
            return;
        }
        self.Lex(Tok);
    }
    if Tok.isNot(eod) {
        << "pragma hdrstop";
    }
    if self.creatingPCHWithPragmaHdrStop() && self.SourceMgr.isInMainFile(Tok.getLocation()) {
        let mut Result: *mut Token = Tok;
        Result.startToken();
    }
    if self.usingPCHWithPragmaHdrStop() {
        self.SkippingUntilPragmaHdrStop = false;
    }
}

fn Preprocessor::isPragmaSetPPStateMacro(self, MacroName: *mut IdentifierInfo) -> bool {
    return MacroName == self.Ident__GLIBCXX__;
}

fn Preprocessor::HandlePragmaSetPPState(self, Introducer: PragmaIntroducer, Tok: *mut Token) {
    self.LexUnexpandedToken(Tok);
    if !Tok.getIdentifierInfo() {
        return;
    }
    let mut MacroName: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !self.isPragmaSetPPStateMacro(MacroName) {
         << MacroName;
        return;
    }
    self.Lex(Tok);
    let mut Value: uint64_t = zeroed();
    if !Tok.is(numeric_constant) || !self.parseSimpleIntegerLiteral(Tok, Value) {
         << MacroName.getName();
        return;
    }
    if MacroName.getName() == "__GLIBCXX__" {
        self.setStdLibCxxVersion(Value);
    } else {
        llvm_unreachable_internal("forgot to handle a possible argument to __set_pp_state", "clang\\lib\\Lex\\Pragma.cpp", 951);
    }
}

fn Preprocessor::AddPragmaHandler(self, Namespace: str, Handler: *mut PragmaHandler) {
    let mut InsertNS: *mut PragmaNamespace = null;
    if !Namespace.is_empty() {
        if  {
            Existing;
