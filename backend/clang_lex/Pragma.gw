fn PragmaDeprecatedHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut MessageString: str = "";
    if HandleMacroAnnotationPragma(PP, Tok, "#pragma clang deprecated", MessageString) {
        II;
    } else {
        II.setIsDeprecatedMacro(true);
        PP.addMacroDeprecationMsg(II, move(MessageString), Tok.getLocation());
    }
}

fn PragmaDeprecatedHandler::getName(self: *PragmaDeprecatedHandler) -> str {
    return self.Name;
}

fn PragmaDeprecatedHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaRestrictExpansionHandler {
    Name: str,
}

fn PragmaRestrictExpansionHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut MessageString: str = "";
    if HandleMacroAnnotationPragma(PP, Tok, "#pragma clang restrict_expansion", MessageString) {
        II;
    } else {
        II.setIsRestrictExpansion(true);
        PP.addRestrictExpansionMsg(II, move(MessageString), Tok.getLocation());
    }
}

fn PragmaRestrictExpansionHandler::getName(self: *PragmaRestrictExpansionHandler) -> str {
    return self.Name;
}

fn PragmaRestrictExpansionHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaFinalHandler {
    Name: str,
}

fn PragmaFinalHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << "(";
        return;
    }
    PP.LexUnexpandedToken(Tok);
    if !Tok.is(identifier) {
        PP << identifier;
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !II.hasMacroDefinition() {
        PP << II;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(r_paren) {
        PP << ")";
        return;
    }
    II.setIsFinal(true);
    PP.addFinalLoc(II, Tok.getLocation());
}

fn PragmaFinalHandler::getName(self: *PragmaFinalHandler) -> str {
    return self.Name;
}

fn PragmaFinalHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaSetPPStateHandler {
    Name: str,
}

fn PragmaSetPPStateHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.HandlePragmaSetPPState(Introducer, Tok);
}

fn PragmaSetPPStateHandler::getName(self: *PragmaSetPPStateHandler) -> str {
    return self.Name;
}

fn PragmaSetPPStateHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

fn Preprocessor::RegisterBuiltinPragmas(self) {
    self.AddPragmaHandler(PragmaOnceHandler {});
    self.AddPragmaHandler(PragmaMarkHandler {});
    self.AddPragmaHandler(PragmaPushMacroHandler {});
    self.AddPragmaHandler(PragmaPopMacroHandler {});
    self.AddPragmaHandler(PragmaMessageHandler { PMK_Message, "" });
    self.AddPragmaHandler("GCC", PragmaPoisonHandler {});
    self.AddPragmaHandler("GCC", PragmaSystemHeaderHandler {});
    self.AddPragmaHandler("GCC", PragmaDependencyHandler {});
    self.AddPragmaHandler("GCC", "GCC");
    self.AddPragmaHandler("GCC", PragmaMessageHandler { PMK_Warning, "GCC" });
    self.AddPragmaHandler("GCC", PragmaMessageHandler { PMK_Error, "GCC" });
    self.AddPragmaHandler("clang", PragmaPoisonHandler {});
    self.AddPragmaHandler("clang", PragmaSystemHeaderHandler {});
    self.AddPragmaHandler("clang", PragmaDebugHandler {});
    self.AddPragmaHandler("clang", PragmaDependencyHandler {});
    self.AddPragmaHandler("clang", "clang");
    self.AddPragmaHandler("clang", PragmaARCCFCodeAuditedHandler {});
    self.AddPragmaHandler("clang", PragmaAssumeNonNullHandler {});
    self.AddPragmaHandler("clang", PragmaDeprecatedHandler {});
    self.AddPragmaHandler("clang", PragmaRestrictExpansionHandler {});
    self.AddPragmaHandler("clang", PragmaFinalHandler {});
    self.AddPragmaHandler("clang", PragmaSetPPStateHandler {});
    let mut ModuleHandler: *mut PragmaNamespace = "module";
    self.AddPragmaHandler("clang", ModuleHandler);
    ModuleHandler.AddPragma(PragmaModuleImportHandler {});
    ModuleHandler.AddPragma(PragmaModuleBeginHandler {});
    ModuleHandler.AddPragma(PragmaModuleEndHandler {});
    ModuleHandler.AddPragma(PragmaModuleBuildHandler {});
    ModuleHandler.AddPragma(PragmaModuleLoadHandler {});
    self.AddPragmaHandler("clang", PragmaUnsafeBufferUsageHandler {});
    self.AddPragmaHandler("region");
    self.AddPragmaHandler("endregion");
    if self.LangOpts {
        self.AddPragmaHandler(PragmaWarningHandler {});
        self.AddPragmaHandler(PragmaExecCharsetHandler {});
        self.AddPragmaHandler(PragmaIncludeAliasHandler {});
        self.AddPragmaHandler(PragmaHdrstopHandler {});
        self.AddPragmaHandler(PragmaSystemHeaderHandler {});
        self.AddPragmaHandler("managed");
        self.AddPragmaHandler("unmanaged");
    }
}

fn Preprocessor::IgnorePragmas(self) {
    self.AddPragmaHandler("");
    self.AddPragmaHandler("GCC", "");
    self.AddPragmaHandler("clang", "");
}

struct Closure_1 {
    Tok: *mut Token,
    cap_1: *mut Preprocessor,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Ident: str) -> auto {
        if (*self.Tok).getKind() != raw_identifier || (*self.Tok).getRawIdentifier() != Ident {
            return false;
        }
        return true;
    }
