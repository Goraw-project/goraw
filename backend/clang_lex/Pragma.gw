struct PragmaMessageHandler {
    Name: str,
    Kind: PragmaMessageKind,
    Namespace: str,
}

fn PragmaMessageHandler::PragmaKind(self, Kind: PragmaMessageKind, PragmaNameOnly: bool) -> *u8 {
    match Kind {
        PMK_Message => {
            return if PragmaNameOnly { "message" } else { "pragma message" };
        },
        PMK_Warning => {
            return if PragmaNameOnly { "warning" } else { "pragma warning" };
        },
        PMK_Error => {
            return if PragmaNameOnly { "error" } else { "pragma error" };
        },
    }
    llvm_unreachable_internal("Unknown PragmaMessageKind!", "P:/Goraw/llvm-project/clang/lib/Lex/Pragma.cpp", 1691);
}

fn PragmaMessageHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut MessageLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    let mut ExpectClosingParen: bool = false;
    match Tok.getKind() {
        l_paren => {
            ExpectClosingParen = true;
        },
        string_literal => {
            break;
        },
        _ => {
            PP.Diag(MessageLoc, err_pragma_message_malformed) << self.Kind;
        },
    }
    let mut MessageString: str = "";
    if !PP.FinishLexStringLiteral(Tok, MessageString, PragmaKind(self.Kind, false), true) {
        return;
    }
    if ExpectClosingParen {
        if Tok.isNot(r_paren) {
            PP.Diag(Tok.getLocation(), err_pragma_message_malformed) << self.Kind;
            return;
        }
        PP.Lex(Tok);
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), err_pragma_message_malformed) << self.Kind;
        return;
    }
    PP.Diag(MessageLoc, if (self.Kind == PMK_Error) { err_pragma_message } else { warn_pragma_message }) << MessageString;
    if PP.getPPCallbacks() {
        Callbacks;
    } else {
        Callbacks.PragmaMessage(MessageLoc, self.Namespace, self.Kind, MessageString);
    }
}

fn PragmaMessageHandler::getName(self: *PragmaMessageHandler) -> str {
    return self.Name;
}

fn PragmaMessageHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaModuleImportHandler {
    Name: str,
}

fn PragmaModuleImportHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut ImportLoc: SourceLocation = Tok.getLocation();
    let mut ModuleName: SmallVector<IdentifierLoc, 8> = SmallVector<IdentifierLoc, 8> {};
    if LexModuleName(PP, Tok, ModuleName) {
        return;
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma";
    }
    let mut Imported: *mut Module = PP.getModuleLoader().loadModule(ImportLoc, ModuleName, Hidden, false).operator clang::Module *();
    if !Imported {
        return;
    }
    PP.makeModuleVisible(Imported, ImportLoc, true);
    PP.EnterAnnotationToken(SourceRange { B: ImportLoc, E: ModuleName.back().getLoc() }, annot_module_include, Imported);
    if PP.getPPCallbacks() {
        CB;
    } else {
        CB.moduleImport(ImportLoc, ModuleName, Imported);
    }
}

fn PragmaModuleImportHandler::getName(self: *PragmaModuleImportHandler) -> str {
    return self.Name;
}

fn PragmaModuleImportHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaModuleBeginHandler {
    Name: str,
}

fn PragmaModuleBeginHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut BeginLoc: SourceLocation = Tok.getLocation();
    let mut ModuleName: SmallVector<IdentifierLoc, 8> = SmallVector<IdentifierLoc, 8> {};
    if LexModuleName(PP, Tok, ModuleName) {
        return;
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma";
    }
    let mut Current: str = PP.getLangOpts().CurrentModule;
    if ModuleName.front().getIdentifierInfo().getName() != Current {
        PP.Diag(ModuleName.front().getLoc(), err_pp_module_begin_wrong_module) << ModuleName.front().getIdentifierInfo() << (ModuleName.len > 1) << Current.is_empty() << Current;
        return;
    }
    let mut HSI: *mut HeaderSearch = PP.getHeaderSearchInfo();
    let mut MM: *mut ModuleMap = HSI.getModuleMap();
    let mut M: *mut Module = HSI.lookupModule(Current, ModuleName.front().getLoc(), true, false);
    if !M {
        PP.Diag(ModuleName.front().getLoc(), err_pp_module_begin_no_module_map) << Current;
        return;
    }
    for let mut I: u32 = 1; I != ModuleName.len; I += 1 {
        let mut NewM: *mut Module = MM.findOrInferSubmodule(M, ModuleName[I].getIdentifierInfo().getName());
        if !NewM {
            PP.Diag(ModuleName[I].getLoc(), err_pp_module_begin_no_submodule) << M.getFullModuleName(false) << ModuleName[I].getIdentifierInfo();
            return;
        }
        M = NewM;
    }
    if checkModuleIsAvailable(PP.getLangOpts(), PP.getTargetInfo(), *M, PP.getDiagnostics()) {
        PP.Diag(BeginLoc, note_pp_module_begin_here) << M.getTopLevelModuleName();
        return;
    }
    PP.EnterSubmodule(M, BeginLoc, true);
    PP.EnterAnnotationToken(SourceRange { B: BeginLoc, E: ModuleName.back().getLoc() }, annot_module_begin, M);
}

fn PragmaModuleBeginHandler::getName(self: *PragmaModuleBeginHandler) -> str {
    return self.Name;
}

fn PragmaModuleBeginHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaModuleEndHandler {
    Name: str,
}

fn PragmaModuleEndHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut Loc: SourceLocation = Tok.getLocation();
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma";
    }
    let mut M: *mut Module = PP.LeaveSubmodule(true);
    if M {
        PP.EnterAnnotationToken(Loc, annot_module_end, M);
    } else {
        PP.Diag(Loc, err_pp_module_end_without_module_begin);
    }
}

fn PragmaModuleEndHandler::getName(self: *PragmaModuleEndHandler) -> str {
    return self.Name;
}

fn PragmaModuleEndHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

