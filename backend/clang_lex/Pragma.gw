fn PragmaModuleBeginHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut BeginLoc: SourceLocation = Tok.getLocation();
    let mut ModuleName: SmallVector<IdentifierLoc, 8> = zeroed();
    if LexModuleName(PP, Tok) {
        return;
    }
    if Tok.isNot(eod) {
        PP << "pragma";
    }
    let mut Current: str = PP.getLangOpts().CurrentModule;
    if ModuleName()()()() != Current {
        PP << ()() << (ModuleName()() > 1) << Current.is_empty() << Current;
        return;
    }
    let mut HSI: *mut HeaderSearch = PP.getHeaderSearchInfo();
    let mut MM: *mut ModuleMap = HSI.getModuleMap();
    let mut M: *mut Module = HSI(Current, ()());
    if !M {
        PP << Current;
        return;
    }
    for let mut I: u32 = 1; I != (); I += 1 {
        let mut NewM: *mut auto = MM.findOrInferSubmodule(M, [I]()());
        if operator!() {
            PP << M.getFullModuleName(false) << [I]();
            return;
        }
        M = ;
    }
    if checkModuleIsAvailable(PP.getLangOpts(), PP.getTargetInfo(), *M, PP.getDiagnostics()) {
        PP << M.getTopLevelModuleName();
        return;
    }
    PP.EnterSubmodule(M, BeginLoc, true);
    PP.EnterAnnotationToken(BeginLoc, annot_module_begin, M);
}

