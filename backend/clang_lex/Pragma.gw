struct PragmaFinalHandler {
    Name: str,
}

fn PragmaFinalHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(Tok, err_expected) << "(";
        return;
    }
    PP.LexUnexpandedToken(Tok);
    if !Tok.is(identifier) {
        PP.Diag(Tok, err_expected) << identifier;
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !II.hasMacroDefinition() {
        PP.Diag(Tok, err_pp_visibility_non_macro) << II;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(r_paren) {
        PP.Diag(Tok, err_expected) << ")";
        return;
    }
    II.setIsFinal(true);
    PP.addFinalLoc(II, Tok.getLocation());
}

fn PragmaFinalHandler::getName(self: *PragmaFinalHandler) -> str {
    return self.Name;
}

fn PragmaFinalHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

