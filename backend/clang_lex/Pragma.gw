struct PragmaARCCFCodeAuditedHandler {
    Name: str,
}

fn PragmaARCCFCodeAuditedHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, NameTok: *mut Token) {
    let mut Loc: SourceLocation = NameTok.getLocation();
    let mut IsBegin: bool = false;
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    let mut BeginEnd: *IdentifierInfo = Tok.getIdentifierInfo();
    if BeginEnd && BeginEnd.isStr("begin") {
        IsBegin = true;
    } else if BeginEnd && BeginEnd.isStr("end") {
        IsBegin = false;
    } else {
        PP.Diag(Tok.getLocation(), err_pp_arc_cf_code_audited_syntax);
        return;
    }
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma";
    }
    let mut BeginLoc: SourceLocation = PP.getPragmaARCCFCodeAuditedInfo().getLoc();
    let mut NewLoc: SourceLocation = SourceLocation {};
    if IsBegin {
        if BeginLoc.isValid() {
            PP.Diag(Loc, err_pp_double_begin_of_arc_cf_code_audited);
            PP.Diag(BeginLoc, note_pragma_entered_here);
        }
        NewLoc = Loc;
    } else {
        if !BeginLoc.isValid() {
            PP.Diag(Loc, err_pp_unmatched_end_of_arc_cf_code_audited);
            return;
        }
        NewLoc = SourceLocation {};
    }
    PP.setPragmaARCCFCodeAuditedInfo(NameTok.getIdentifierInfo(), NewLoc);
}

fn PragmaARCCFCodeAuditedHandler::getName(self: *PragmaARCCFCodeAuditedHandler) -> str {
    return self.Name;
}

fn PragmaARCCFCodeAuditedHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaAssumeNonNullHandler {
    Name: str,
}

fn PragmaAssumeNonNullHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, NameTok: *mut Token) {
    let mut Loc: SourceLocation = NameTok.getLocation();
    let mut IsBegin: bool = false;
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    let mut BeginEnd: *IdentifierInfo = Tok.getIdentifierInfo();
    if BeginEnd && BeginEnd.isStr("begin") {
        IsBegin = true;
    } else if BeginEnd && BeginEnd.isStr("end") {
        IsBegin = false;
    } else {
        PP.Diag(Tok.getLocation(), err_pp_assume_nonnull_syntax);
        return;
    }
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma";
    }
    let mut BeginLoc: SourceLocation = PP.getPragmaAssumeNonNullLoc();
    let mut NewLoc: SourceLocation = SourceLocation {};
    let mut Callbacks: *mut PPCallbacks = PP.getPPCallbacks();
    if IsBegin {
        if BeginLoc.isValid() {
            PP.Diag(Loc, err_pp_double_begin_of_assume_nonnull);
            PP.Diag(BeginLoc, note_pragma_entered_here);
        }
        NewLoc = Loc;
        if Callbacks {
            Callbacks.PragmaAssumeNonNullBegin(NewLoc);
        }
    } else {
        if !BeginLoc.isValid() {
            PP.Diag(Loc, err_pp_unmatched_end_of_assume_nonnull);
            return;
        }
        NewLoc = SourceLocation {};
        if Callbacks {
            Callbacks.PragmaAssumeNonNullEnd(NewLoc);
        }
    }
    PP.setPragmaAssumeNonNullLoc(NewLoc);
}

fn PragmaAssumeNonNullHandler::getName(self: *PragmaAssumeNonNullHandler) -> str {
    return self.Name;
}

fn PragmaAssumeNonNullHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

