fn Preprocessor::HandleMicrosoft__pragma(self, Tok: *mut Token) {
    let mut Toks: TokenCollector = TokenCollector { Self: *self, Collect: self.InMacroArgPreExpansion, Tokens: void {}, Tok: Tok };
