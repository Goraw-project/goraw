fn HandleMacroAnnotationPragma(PP: *mut Preprocessor, Tok: *mut Token, Pragma: *u8, MessageString: *mut str) -> *mut IdentifierInfo {
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(Tok, err_expected) << "(";
        return null;
    }
    PP.LexUnexpandedToken(Tok);
    if !Tok.is(identifier) {
        PP.Diag(Tok, err_expected) << identifier;
        return null;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !II.hasMacroDefinition() {
        PP.Diag(Tok, err_pp_visibility_non_macro) << II;
        return null;
    }
    PP.Lex(Tok);
    if Tok.is(comma) {
        PP.Lex(Tok);
        if !PP.FinishLexStringLiteral(Tok, MessageString, Pragma, true) {
            return null;
        }
    }
    if Tok.isNot(r_paren) {
        PP.Diag(Tok, err_expected) << ")";
        return null;
    }
    return II;
}

struct PragmaDeprecatedHandler {
    Name: str,
}

fn PragmaDeprecatedHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut MessageString: str = "";
    if HandleMacroAnnotationPragma(PP, Tok, "#pragma clang deprecated", MessageString) {
        II;
    } else {
        II.setIsDeprecatedMacro(true);
        PP.addMacroDeprecationMsg(II, move(MessageString), Tok.getLocation());
    }
}

fn PragmaDeprecatedHandler::getName(self: *PragmaDeprecatedHandler) -> str {
    return self.Name;
}

fn PragmaDeprecatedHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

