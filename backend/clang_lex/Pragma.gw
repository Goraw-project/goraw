    let mut OriginalSource: str = SourceFileName;
    let mut SourceIsAngled: bool = self.GetIncludeFilenameSpelling(SourceFilenameTok.getLocation(), SourceFileName);
    let mut ReplaceIsAngled: bool = self.GetIncludeFilenameSpelling(ReplaceFilenameTok.getLocation(), ReplaceFileName);
    if !SourceFileName.is_empty() && !ReplaceFileName.is_empty() && (SourceIsAngled != ReplaceIsAngled) {
