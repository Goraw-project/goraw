struct PragmaWarningHandler {
    Name: str,
}

fn PragmaWarningHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut DiagLoc: SourceLocation = Tok.getLocation();
    let mut Callbacks: *mut PPCallbacks = PP.getPPCallbacks();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(Tok, warn_pragma_warning_expected) << "(";
        return;
    }
    PP.Lex(Tok);
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if II && II.isStr("push") {
        let mut Level: i32 = -1;
        PP.Lex(Tok);
        if Tok.is(comma) {
            PP.Lex(Tok);
            let mut Value: u64 = 0;
            if Tok.is(numeric_constant) && PP.parseSimpleIntegerLiteral(Tok, Value) {
                Level = Value;
            }
            if Level < 0 || Level > 4 {
                PP.Diag(Tok, warn_pragma_warning_push_level);
                return;
            }
        }
        PP.getDiagnostics().pushMappings(DiagLoc);
        if Callbacks {
            Callbacks.PragmaWarningPush(DiagLoc, Level);
        }
    } else if II && II.isStr("pop") {
        PP.Lex(Tok);
        if !PP.getDiagnostics().popMappings(DiagLoc) {
            PP.Diag(Tok, warn_pragma_diagnostic_cannot_pop);
        } else if Callbacks {
            Callbacks.PragmaWarningPop(DiagLoc);
        }
    } else {
        while true {
            II = Tok.getIdentifierInfo();
            if !II && !Tok.is(numeric_constant) {
                PP.Diag(Tok, warn_pragma_warning_spec_invalid);
                return;
            }
            let mut SpecifierValid: bool = false;
            let mut Specifier: PragmaWarningSpecifier = zeroed();
            if II {
                let mut SpecifierInt: i32 = II.getName().Case("default", PWS_Default).Case("disable", PWS_Disable).Case("error", PWS_Error).Case("once", PWS_Once).Case("suppress", PWS_Suppress).Default(-1);
                SpecifierValid = SpecifierInt != -1;
                if SpecifierValid {
                    Specifier = SpecifierInt as PragmaWarningSpecifier;
                }
                if SpecifierValid {
                    PP.Lex(Tok);
                }
            } else {
                let mut Value: u64 = 0;
                if PP.parseSimpleIntegerLiteral(Tok, Value) {
                    if (SpecifierValid = (Value >= 1) && (Value <= 4)) {
                        Specifier = PWS_Level1 + Value - 1 as PragmaWarningSpecifier;
                    }
                } else {
                    SpecifierValid = false;
                }
            }
            if !SpecifierValid {
                PP.Diag(Tok, warn_pragma_warning_spec_invalid);
                return;
            }
            if Tok.isNot(colon) {
                PP.Diag(Tok, warn_pragma_warning_expected) << ":";
                return;
            }
            let mut Ids: SmallVector<int, 4> = SmallVector<int, 4> {};
            PP.Lex(Tok);
            while Tok.is(numeric_constant) {
                let mut Value: u64 = 0;
                if !PP.parseSimpleIntegerLiteral(Tok, Value) || Value == 0 || Value > 2147483647 {
                    PP.Diag(Tok, warn_pragma_warning_expected_number);
                    return;
                }
                Ids.push(Value);
            }
            let mut SV: Severity = ;
            if Specifier == PWS_Disable {
                SV = Ignored;
            }
            if SV !=  {
                for Id in Ids {
                    if diagGroupFromCLWarningID(Id) {
                        Group;
                    } else {
                        let mut unknownDiag: bool = PP.getDiagnostics().setSeverityForGroup(WarningOrError, operator(Group), SV, DiagLoc);
                        assert!(!unknownDiag, "wd table should only contain known diags");
                        unknownDiag as void;
                    }
                }
            }
            if Callbacks {
                Callbacks.PragmaWarning(DiagLoc, Specifier, Ids);
            }
            if Tok.isNot(semi) {
                break;
            }
            PP.Lex(Tok);
        }
    }
    if Tok.isNot(r_paren) {
        PP.Diag(Tok, warn_pragma_warning_expected) << ")";
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma warning";
    }
}

fn PragmaWarningHandler::getName(self: *PragmaWarningHandler) -> str {
    return self.Name;
}

fn PragmaWarningHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

struct PragmaExecCharsetHandler {
    Name: str,
}

fn PragmaExecCharsetHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut DiagLoc: SourceLocation = Tok.getLocation();
    let mut Callbacks: *mut PPCallbacks = PP.getPPCallbacks();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(Tok, warn_pragma_exec_charset_expected) << "(";
        return;
    }
    PP.Lex(Tok);
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if II && II.isStr("push") {
        PP.Lex(Tok);
        if Tok.is(comma) {
            PP.Lex(Tok);
            let mut ExecCharset: str = "";
            if !PP.FinishLexStringLiteral(Tok, ExecCharset, "pragma execution_character_set", false) {
                return;
            }
            if !ExecCharset == "UTF-8" && !ExecCharset == "utf-8" {
                PP.Diag(Tok, warn_pragma_exec_charset_push_invalid) << ExecCharset;
                return;
            }
        }
        if Callbacks {
            Callbacks.PragmaExecCharsetPush(DiagLoc, "UTF-8");
        }
    } else if II && II.isStr("pop") {
        PP.Lex(Tok);
        if Callbacks {
            Callbacks.PragmaExecCharsetPop(DiagLoc);
        }
    } else {
        PP.Diag(Tok, warn_pragma_exec_charset_spec_invalid);
        return;
    }
    if Tok.isNot(r_paren) {
        PP.Diag(Tok, warn_pragma_exec_charset_expected) << ")";
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok, ext_pp_extra_tokens_at_eol) << "pragma execution_character_set";
    }
}

fn PragmaExecCharsetHandler::getName(self: *PragmaExecCharsetHandler) -> str {
    return self.Name;
}

fn PragmaExecCharsetHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

