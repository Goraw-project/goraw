fn PragmaDebugHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, DebugToken: *mut Token) {
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(identifier) {
        PP;
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if II.isStr("assert") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            llvm_unreachable_internal("This is an assertion!", "clang\\lib\\Lex\\Pragma.cpp", 1110);
        }
    } else if II.isStr("crash") {
        let mut T: Timer = Timer { "crash", "pragma crash" };
        let mut R: TimeRegion = &mut T;
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            __builtin_trap();
        }
    } else if II.isStr("parser_crash") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            let mut Crasher: Token = Token {};
            Crasher.startToken();
            Crasher.setKind(annot_pragma_parser_crash);
            Crasher.setAnnotationRange(Tok.getLocation());
            PP.EnterToken(Crasher, false);
        }
    } else if II.isStr("sleep") {
        sleep_for(100);
    } else if II.isStr("dump") {
        let mut DumpAnnot: Token = Token {};
        DumpAnnot.startToken();
        DumpAnnot.setKind(annot_pragma_dump);
        DumpAnnot.setAnnotationRange(Tok.getLocation());
        PP.EnterToken(DumpAnnot, false);
    } else if II.isStr("diag_mapping") {
        let mut DiagName: Token = Token {};
        PP.LexUnexpandedToken(DiagName);
        if DiagName.is(eod) {
            PP.getDiagnostics().dump();
        } else if DiagName.is(string_literal) && !DiagName.hasUDSuffix() {
            let mut Literal: StringLiteralParser = DiagName(PP, Unevaluated);
            if Literal.hadError {
                return;
            }
            PP.getDiagnostics().dump(Literal.GetString());
        } else {
            PP << II.getName();
        }
    } else if II.isStr("llvm_fatal_error") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            report_fatal_error("#pragma clang __debug llvm_fatal_error", true);
        }
    } else if II.isStr("llvm_unreachable") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            llvm_unreachable_internal("#pragma clang __debug llvm_unreachable", "clang\\lib\\Lex\\Pragma.cpp", 1152);
        }
    } else if II.isStr("macro") {
        let mut MacroName: Token = Token {};
        PP.LexUnexpandedToken(MacroName);
        let mut MacroII: *mut IdentifierInfo = MacroName.getIdentifierInfo();
        if MacroII {
            PP.dumpMacroInfo(MacroII);
        } else {
            PP << II.getName();
        }
    } else if II.isStr("module_map") {
        let mut ModuleName: SmallVector<IdentifierLoc, 8> = zeroed();
        if LexModuleName(PP, Tok) {
            return;
        }
        let mut MM: *mut ModuleMap = PP.getHeaderSearchInfo().getModuleMap();
        let mut M: *mut Module = null;
        M.dump();
    } else if II.isStr("module_lookup") {
        let mut MName: Token = Token {};
        PP.LexUnexpandedToken(MName);
        let mut MNameII: *mut IdentifierInfo = MName.getIdentifierInfo();
        if !MNameII {
            PP << II.getName();
            return;
        }
        let mut M: *mut Module = PP.getHeaderSearchInfo().lookupModule(MNameII.getName(), SourceLocation {}, true, false);
        if !M {
            PP << MNameII.getName();
            return;
        }
        M.dump();
    } else if II.isStr("overflow_stack") {
        if !PP.getPreprocessorOpts().DisablePragmaDebugCrash {
            DebugOverflowStack(null);
        }
    } else if II.isStr("captured") {
        self.HandleCaptured(PP);
    } else if II.isStr("modules") {
        let mut Visitor: ModuleVisitor = ModuleVisitor { PP };
        let mut Kind: Token = Token {};
        PP.LexUnexpandedToken(Kind);
        let mut DumpII: *mut IdentifierInfo = Kind.getIdentifierInfo();
        if !DumpII {
            PP << II.getName();
        } else if DumpII.isStr("all") {
            Visitor.visitAll(false);
        } else if DumpII.isStr("visible") {
            Visitor.visitAll(true);
        } else if DumpII.isStr("building") {} else {
            PP << DumpII.getName();
        }
    } else if II.isStr("sloc_usage") {
        let mut MaxNotes: optional<unsigned int> = zeroed();
        let mut ArgToken: Token = Token {};
        PP.Lex(ArgToken);
        let mut Value: u64 = 0;
        if ArgToken.is(numeric_constant) && PP.parseSimpleIntegerLiteral(ArgToken, Value) {
            MaxNotes() = Value;
        } else if ArgToken.isNot(eod) {
            PP;
        }
        PP;
        PP.getSourceManager().noteSLocAddressSpaceUsage(PP.getDiagnostics());
    } else {
        PP << II.getName();
    }
    let mut Callbacks: *mut PPCallbacks = PP.getPPCallbacks();
    if Callbacks {
        Callbacks.PragmaDebug(Tok.getLocation(), II.getName());
    }
}

fn PragmaDebugHandler::HandleCaptured(self, PP: *mut Preprocessor) {
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
        PP << "pragma clang __debug captured";
        return;
    }
    let mut NameLoc: SourceLocation = Tok.getLocation();
    let mut Toks: MutableArrayRef<Token> = zeroed();
    Toks()[0]();
    Toks()[0](annot_pragma_captured);
    Toks()[0](NameLoc);
    PP(true, false);
}

fn PragmaDebugHandler::DebugOverflowStack(self, P: void (*)()) {
    let mut Self: void (*volatile)(void (*)()) = DebugOverflowStack;
    Self(Self as void (*)());
}

