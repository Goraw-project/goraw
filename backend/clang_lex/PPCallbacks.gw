fn PPCallbacks::~PPCallbacks(self) {}

fn PPCallbacks::HasInclude(self, Loc: SourceLocation, FileName: str, IsAngled: bool, File: OptionalFileEntryRef, FileType: CharacteristicKind) {}

fn PPChainedCallbacks::~PPChainedCallbacks(self) {}

fn PPChainedCallbacks::HasInclude(self, Loc: SourceLocation, FileName: str, IsAngled: bool, File: OptionalFileEntryRef, FileType: CharacteristicKind) {
    operator(self.First).HasInclude(Loc, FileName, IsAngled, File, FileType);
    operator(self.Second).HasInclude(Loc, FileName, IsAngled, File, FileType);
}
