// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn Token::isObjCAtKeyword(self: *Token, objcKey: ObjCKeywordKind) -> bool {
    if self.isAnnotation() {
        return false;
    }
    if self.getIdentifierInfo() {
        II;
    } else {
        return II.getObjCKeywordID() == objcKey;
    }
    return false;
}

fn Token::getObjCKeywordID(self: *Token) -> ObjCKeywordKind {
    if self.isAnnotation() {
        return objc_not_keyword;
    }
    let mut specId: *IdentifierInfo = self.getIdentifierInfo();
    return if specId { specId.getObjCKeywordID() } else { objc_not_keyword };
}

fn Token::isModuleContextualKeyword(self: *Token, AllowExport: bool) -> bool {
    if AllowExport && self.is(kw_export) {
        return true;
    }
    if self.isOneOf(kw_import, kw_module) {
        return true;
    }
    if self.isNot(identifier) {
        return false;
    }
    let mut II: *IdentifierInfo = self.getIdentifierInfo();
    return II.isImportKeyword() || II.isModuleKeyword();
}

fn Token::isSimpleTypeSpecifier(self: *Token, LangOpts: *LangOptions) -> bool {
    match self.getKind() {
        annot_typename => {
            annot_decltype;
        },
        kw_short => {
            kw_long;
        },
        _ => {
            return false;
        },
    }
}

fn Lexer::anchor(self) {}

fn Lexer::InitLexer(self, BufStart: *u8, BufPtr: *u8, BufEnd: *u8) {
    self.BufferStart = BufStart;
    self.BufferPtr = BufPtr;
    self.BufferEnd = BufEnd;
    assert!(BufEnd[0] == 0, "We assume that the input buffer has a null character at the end to simplify lexing!");
    if self.BufferStart == self.BufferPtr {
        let mut Buf: str = self.BufferStart[0..self.BufferEnd - self.BufferStart];
        let mut BOMLength: u64 = Buf.StartsWith("\357\273\277", 3).Default(0);
        self.BufferPtr += BOMLength;
    }
    self.Is_PragmaLexer = false;
    self.CurrentConflictMarkerState = CMK_None;
    self.IsAtStartOfLine = true;
    self.IsAtPhysicalStartOfLine = true;
    self.HasLeadingSpace = false;
    self.HasLeadingEmptyMacro = false;
    self.ParsingPreprocessorDirective = false;
    self.ParsingFilename = false;
    self.LexingRawMode = false;
    self.ExtendedTokenMode = 0;
    self.NewLinePtr = null;
}

fn Lexer::Lexer(self, FID: FileID, InputFile: *MemoryBufferRef, PP: *mut Preprocessor, IsFirstIncludeOfFile: bool) {
    self.InitLexer(InputFile.getBufferStart(), InputFile.getBufferStart(), InputFile.getBufferEnd());
    self.resetExtendedTokenMode();
}

fn Lexer::Lexer(self, fileloc: SourceLocation, langOpts: *LangOptions, BufStart: *u8, BufPtr: *u8, BufEnd: *u8, IsFirstIncludeOfFile: bool) {
    self.InitLexer(BufStart, BufPtr, BufEnd);
    self.LexingRawMode = true;
}

fn Lexer::resetExtendedTokenMode(self) {
    assert!(self.PP, "Cannot reset token mode without a preprocessor");
    if self.LangOpts.TraditionalCPP {
        self.SetKeepWhitespaceMode(true);
    } else {
        self.SetCommentRetentionState(self.PP.getCommentRetentionState());
    }
}

fn Lexer::Create_PragmaLexer(self, SpellingLoc: SourceLocation, ExpansionLocStart: SourceLocation, ExpansionLocEnd: SourceLocation, TokLen: u32, PP: *mut Preprocessor) -> unique_ptr<Lexer> {
    let mut SM: *mut SourceManager = PP.getSourceManager();
    let mut SpellingFID: FileID = SM.getFileID(SpellingLoc);
    let mut InputFile: MemoryBufferRef = SM.getBufferOrFake(SpellingFID, SourceLocation {});
    let mut L: Lexer> = make_unique(SpellingFID, InputFile, PP);
    let mut StrData: *u8 = SM.getCharacterData(SpellingLoc, null);
    operator(L).BufferPtr = StrData;
    operator(L).BufferEnd = StrData + TokLen;
    assert!(operator(L).BufferEnd[0] == 0, "Buffer is not nul terminated!");
    operator(L).FileLoc = SM.createExpansionLoc(SM.getLocForStartOfFile(SpellingFID), ExpansionLocStart, ExpansionLocEnd, TokLen, true, 0, 0);
    operator(L).ParsingPreprocessorDirective = true;
    operator(L).Is_PragmaLexer = true;
    return L;
}

fn Lexer::seek(self, Offset: u32, IsAtStartOfLine: bool) {
    self.IsAtPhysicalStartOfLine = IsAtStartOfLine;
    self.IsAtStartOfLine = IsAtStartOfLine;
    assert!((self.BufferStart + Offset) <= self.BufferEnd);
    self.BufferPtr = self.BufferStart + Offset;
}

