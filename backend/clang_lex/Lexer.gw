fn Lexer::Stringify(self, Str: str, Charify: bool) -> str {
    let mut Result: str = Str[0..allocator<char> {}];
    let mut Quote: i8 = if Charify { ''' } else { '"' };
    StringifyImpl(Result, Quote);
    return Result;
}

fn Lexer::Stringify(self, Str: *mut SmallVectorImpl<char>) {
    StringifyImpl(Str, '"');
}

fn getSpellingSlow(Tok: *Token, BufPtr: *u8, LangOpts: *LangOptions, Spelling: *mut u8) -> u64 {
    assert!(Tok.needsCleaning(), "getSpellingSlow called on simple token");
    let mut Length: u64 = 0;
    let mut BufEnd: *u8 = BufPtr + Tok.getLength();
    if isStringLiteral(Tok.getKind()) {
        while BufPtr < BufEnd {
            let mut CharAndSize: SizedChar = getCharAndSizeNoWarn(BufPtr, LangOpts);
            Spelling[Length += 1] = CharAndSize.Char;
            BufPtr += CharAndSize.Size;
            if Spelling[Length - 1] == '"' {
                break;
            }
        }
        if Length >= 2 && Spelling[Length - 2] == 'R' && Spelling[Length - 1] == '"' {
            let mut RawEnd: *u8 = BufEnd;
            while true {
                {
                RawEnd -= 1;
            }
                if !(*RawEnd != '"') { break; }
            }
            let mut RawLength: u64 = RawEnd - BufPtr + 1;
            memcpy(Spelling + Length, BufPtr, RawLength);
            Length += RawLength;
            BufPtr += RawLength;
        }
    }
    while BufPtr < BufEnd {
        let mut CharAndSize: SizedChar = getCharAndSizeNoWarn(BufPtr, LangOpts);
        Spelling[Length += 1] = CharAndSize.Char;
        BufPtr += CharAndSize.Size;
    }
    assert!(Length < Tok.getLength(), "NeedsCleaning flag set on token that didn't need cleaning!");
    return Length;
}

fn Lexer::getSpelling(self, loc: SourceLocation, buffer: *mut SmallVectorImpl<char>, SM: *SourceManager, options: *LangOptions, invalid: *mut bool) -> str {
    let mut locInfo: FileIDAndOffset = SM.getDecomposedLoc(loc);
    let mut invalidTemp: bool = false;
    let mut file: str = SM.getBufferData(locInfo.first, &mut invalidTemp);
    if invalidTemp {
        if invalid {
            *invalid = true;
        }
        return "";
    }
    let mut tokenBegin: *u8 = file.ptr + locInfo.second;
    let mut lexer: Lexer = Lexer { SM.getLocForStartOfFile(locInfo.first), options, file.begin(), tokenBegin, file.end(), true };
    let mut token: Token = Token {};
    lexer.LexFromRawLexer(token);
    let mut length: u32 = token.getLength();
    if !token.needsCleaning() {
        return tokenBegin[0..length];
    }
    buffer.resize(length);
    buffer.resize(getSpellingSlow(token, tokenBegin, options, buffer.ptr));
    return buffer.ptr[0..buffer.len];
}

fn Lexer::getSpelling(self, Tok: *Token, SourceMgr: *SourceManager, LangOpts: *LangOptions, Invalid: *mut bool) -> str {
    assert!(Tok.getLength() as i32 >= 0, "Token character range is bogus!");
    let mut CharDataInvalid: bool = false;
    let mut TokStart: *u8 = SourceMgr.getCharacterData(Tok.getLocation(), &mut CharDataInvalid);
    if Invalid {
        *Invalid = CharDataInvalid;
    }
    if CharDataInvalid {
        return "";
    }
    if !Tok.needsCleaning() {
        return TokStart + TokStart + Tok.getLength() + allocator<char> {};
    }
    let mut Result: str = "";
    Result.resize(Tok.getLength());
    Result.resize(getSpellingSlow(Tok, TokStart, LangOpts, &mut operator(Result.begin())));
    return Result;
}

fn Lexer::getSpelling(self, Tok: *Token, Buffer: **mut u8, SourceMgr: *SourceManager, LangOpts: *LangOptions, Invalid: *mut bool) -> u32 {
    assert!(Tok.getLength() as i32 >= 0, "Token character range is bogus!");
    let mut TokStart: *u8 = null;
    if Tok.is(raw_identifier) {
        TokStart = Tok.getRawIdentifier().ptr;
    } else if !Tok.hasUCN() {
        if Tok.getIdentifierInfo() {
            II;
        } else {
            Buffer = II.getNameStart();
            return II.getLength();
        }
    }
    if Tok.isLiteral() {
        TokStart = Tok.getLiteralData();
    }
    if !TokStart {
        let mut CharDataInvalid: bool = false;
        TokStart = SourceMgr.getCharacterData(Tok.getLocation(), &mut CharDataInvalid);
        if Invalid {
            *Invalid = CharDataInvalid;
        }
        if CharDataInvalid {
            Buffer = "";
            return 0;
        }
    }
    if !Tok.needsCleaning() {
        Buffer = TokStart;
        return Tok.getLength();
    }
    return getSpellingSlow(Tok, TokStart, LangOpts, Buffer);
}

fn Lexer::MeasureTokenLength(self, Loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions) -> u32 {
    let mut TheTok: Token = Token {};
    if getRawToken(Loc, TheTok, SM, LangOpts, false) {
        return 0;
    }
    return TheTok.getLength();
}

fn Lexer::findEndOfIdentifierContinuation(self, Loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions) -> SourceLocation {
    Loc = SM.getExpansionLoc(Loc);
    let mut LocInfo: FileIDAndOffset = SM.getDecomposedLoc(Loc);
    let mut Invalid: bool = false;
    let mut Buffer: str = SM.getBufferData(LocInfo.first, &mut Invalid);
    if Invalid {
        return Loc;
    }
    let mut StrData: *u8 = Buffer.ptr + LocInfo.second;
    if StrData >= Buffer.end() {
        return Loc;
    }
    let mut TheLexer: Lexer = Lexer { SM.getLocForStartOfFile(LocInfo.first), LangOpts, Buffer.begin(), StrData, Buffer.end(), true };
    let mut Tok: Token = Token {};
    Tok.startToken();
    TheLexer.LexIdentifierContinue(Tok, StrData);
    return Loc.getLocWithOffset(Tok.getLength());
}

fn Lexer::getRawToken(self, Loc: SourceLocation, Result: *mut Token, SM: *SourceManager, LangOpts: *LangOptions, IgnoreWhiteSpace: bool) -> bool {
    Loc = SM.getExpansionLoc(Loc);
    let mut LocInfo: FileIDAndOffset = SM.getDecomposedLoc(Loc);
    let mut Invalid: bool = false;
    let mut Buffer: str = SM.getBufferData(LocInfo.first, &mut Invalid);
    if Invalid {
        return true;
    }
    let mut StrData: *u8 = Buffer.ptr + LocInfo.second;
    if !IgnoreWhiteSpace && isWhitespace(SkipEscapedNewLines(StrData)[0]) {
        return true;
    }
    let mut TheLexer: Lexer = Lexer { SM.getLocForStartOfFile(LocInfo.first), LangOpts, Buffer.begin(), StrData, Buffer.end(), true };
    TheLexer.SetCommentRetentionState(true);
    TheLexer.LexFromRawLexer(Result);
    return false;
}

fn findBeginningOfLine(Buffer: str, Offset: u32) -> *u8 {
    let mut BufStart: *u8 = Buffer.ptr;
    if Offset >= Buffer.len {
        return null;
    }
    let mut LexStart: *u8 = BufStart + Offset;
    for ; LexStart != BufStart; LexStart -= 1 {
        if isVerticalWhitespace(LexStart[0]) && !isNewLineEscaped(BufStart, LexStart) {
            LexStart += 1;
            break;
        }
    }
    return LexStart;
}

fn getBeginningOfFileToken(Loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions) -> SourceLocation {
    assert!(Loc.isFileID();
    let mut LocInfo: FileIDAndOffset = SM.getDecomposedLoc(Loc);
    if LocInfo.first.isInvalid() {
        return Loc;
    }
    let mut Invalid: bool = false;
    let mut Buffer: str = SM.getBufferData(LocInfo.first, &mut Invalid);
    if Invalid {
        return Loc;
    }
    let mut StrData: *u8 = Buffer.ptr + LocInfo.second;
    let mut LexStart: *u8 = findBeginningOfLine(Buffer, LocInfo.second);
    if !LexStart || LexStart == StrData {
        return Loc;
    }
    let mut LexerStartLoc: SourceLocation = Loc.getLocWithOffset(-LocInfo.second);
    let mut TheLexer: Lexer = Lexer { LexerStartLoc, LangOpts, Buffer.ptr, LexStart, Buffer.end(), true };
    TheLexer.SetCommentRetentionState(true);
    let mut TheTok: Token = Token {};
    while true {
        {
        TheLexer.LexFromRawLexer(TheTok);
        if TheLexer.getBufferLocation() > StrData {
            if TheLexer.getBufferLocation() - TheTok.getLength() <= StrData {
                return TheTok.getLocation();
            }
            break;
        }
    }
        if !(TheTok.getKind() != eof) { break; }
    }
    return Loc;
}

fn Lexer::GetBeginningOfToken(self, Loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions) -> SourceLocation {
    if Loc.isFileID() {
        return getBeginningOfFileToken(Loc, SM, LangOpts);
    }
    if !SM.isMacroArgExpansion(Loc, null) {
        return Loc;
    }
    let mut FileLoc: SourceLocation = SM.getSpellingLoc(Loc);
    let mut BeginFileLoc: SourceLocation = getBeginningOfFileToken(FileLoc, SM, LangOpts);
    let mut FileLocInfo: FileIDAndOffset = SM.getDecomposedLoc(FileLoc);
    let mut BeginFileLocInfo: FileIDAndOffset = SM.getDecomposedLoc(BeginFileLoc);
    assert!(FileLocInfo.first == BeginFileLocInfo.first && FileLocInfo.second >= BeginFileLocInfo.second);
    return Loc.getLocWithOffset(BeginFileLocInfo.second - FileLocInfo.second);
}

enum PreambleDirectiveKind {
    PDK_Skipped = 0,
    PDK_Unknown = 1,
}

fn Lexer::ComputePreamble(self, Buffer: str, LangOpts: *LangOptions, MaxLines: u32) -> PreambleBounds {
    let mut StartOffset: UIntTy = 1;
    let mut FileLoc: SourceLocation = getFromRawEncoding(StartOffset);
    let mut TheLexer: Lexer = Lexer { FileLoc, LangOpts, Buffer.begin(), Buffer.begin(), Buffer.end(), true };
    TheLexer.SetCommentRetentionState(true);
    let mut InPreprocessorDirective: bool = false;
    let mut TheTok: Token = Token {};
    let mut ActiveCommentLoc: SourceLocation = SourceLocation {};
    let mut MaxLineOffset: u32 = 0;
    if MaxLines {
        let mut CurPtr: *u8 = Buffer.begin();
        let mut CurLine: u32 = 0;
        while CurPtr != Buffer.end() {
            let mut ch: i8 = *CurPtr += 1;
            if ch == 10 {
                CurLine += 1;
                if CurLine == MaxLines {
                    break;
                }
            }
        }
        if CurPtr != Buffer.end() {
            MaxLineOffset = CurPtr - Buffer.begin();
        }
    }
    while true {
        {
        TheLexer.LexFromRawLexer(TheTok);
        if InPreprocessorDirective {
            if TheTok.getKind() == eof {
                break;
            }
            if !TheTok.isAtStartOfLine() {
                continue;
            }
            InPreprocessorDirective = false;
        }
        if TheTok.isAtStartOfLine() {
            let mut TokOffset: u32 = TheTok.getLocation().getRawEncoding() - StartOffset;
            if MaxLineOffset && TokOffset >= MaxLineOffset {
                break;
            }
        }
        if TheTok.getKind() == comment {
            if ActiveCommentLoc.isInvalid() {
                ActiveCommentLoc = TheTok.getLocation();
            }
            continue;
        }
        if TheTok.isAtStartOfLine() && TheTok.getKind() == hash {
            let mut HashTok: Token = TheTok;
            InPreprocessorDirective = true;
            ActiveCommentLoc = SourceLocation {};
            TheLexer.LexFromRawLexer(TheTok);
            if TheTok.getKind() == raw_identifier && !TheTok.needsCleaning() {
                let mut Keyword: str = TheTok.getRawIdentifier();
                let mut PDK: PreambleDirectiveKind = Keyword.Case("include", PDK_Skipped).Case("__include_macros", PDK_Skipped).Case("define", PDK_Skipped).Case("undef", PDK_Skipped).Case("line", PDK_Skipped).Case("error", PDK_Skipped).Case("pragma", PDK_Skipped).Case("import", PDK_Skipped).Case("include_next", PDK_Skipped).Case("warning", PDK_Skipped).Case("ident", PDK_Skipped).Case("sccs", PDK_Skipped).Case("assert", PDK_Skipped).Case("unassert", PDK_Skipped).Case("if", PDK_Skipped).Case("ifdef", PDK_Skipped).Case("ifndef", PDK_Skipped).Case("elif", PDK_Skipped).Case("elifdef", PDK_Skipped).Case("elifndef", PDK_Skipped).Case("else", PDK_Skipped).Case("endif", PDK_Skipped).Default(PDK_Unknown);
                match PDK {
                    PDK_Skipped => {
                        continue;
                    },
                    PDK_Unknown => {
                        break;
                    },
                }
            }
            TheTok = HashTok;
        } else if TheTok.isAtStartOfLine() && TheTok.getKind() == raw_identifier && TheTok.getRawIdentifier() == "module" && LangOpts.CPlusPlusModules {
            let mut ModuleTok: Token = TheTok;
            while true {
                {
                TheLexer.LexFromRawLexer(TheTok);
            }
                if !(TheTok.getKind() == comment) { break; }
            }
            if TheTok.getKind() != semi {
                TheTok = ModuleTok;
                break;
            }
            continue;
        }
        break;
    }
        if !(true) { break; }
    }
    let mut End: SourceLocation = SourceLocation {};
    if ActiveCommentLoc.isValid() {
        End = ActiveCommentLoc;
    } else {
        End = TheTok.getLocation();
    }
    return PreambleBounds { Size: End.getRawEncoding() - FileLoc.getRawEncoding(), PreambleEndsAtStartOfLine: TheTok.isAtStartOfLine() };
}

fn Lexer::getTokenPrefixLength(self, TokStart: SourceLocation, CharNo: u32, SM: *SourceManager, LangOpts: *LangOptions) -> u32 {
    let mut Invalid: bool = false;
    let mut TokPtr: *u8 = SM.getCharacterData(TokStart, &mut Invalid);
    if Invalid || (CharNo == 0 && isObviouslySimpleCharacter(*TokPtr)) {
        return 0;
    }
    let mut PhysOffset: u32 = 0;
    while isObviouslySimpleCharacter(*TokPtr) {
        if CharNo == 0 {
            return PhysOffset;
        }
        TokPtr += 1;
        CharNo -= 1;
        PhysOffset += 1;
    }
    for ; CharNo; CharNo -= 1 {
        let mut CharAndSize: SizedChar = getCharAndSizeNoWarn(TokPtr, LangOpts);
        TokPtr += CharAndSize.Size;
        PhysOffset += CharAndSize.Size;
    }
    if !isObviouslySimpleCharacter(*TokPtr) {
        PhysOffset += SkipEscapedNewLines(TokPtr) - TokPtr;
    }
    return PhysOffset;
}

fn Lexer::getLocForEndOfToken(self, Loc: SourceLocation, Offset: u32, SM: *SourceManager, LangOpts: *LangOptions) -> SourceLocation {
    if Loc.isInvalid() {
        return SourceLocation {};
    }
    if Loc.isMacroID() {
        let mut LocFileID: FileID = SM.getFileID(Loc);
        if Offset > 0 || !isAtEndOfMacroExpansion(Loc, SM, LangOpts, &mut Loc) {
            return SourceLocation {};
        }
        if !SM.getSLocEntry(LocFileID, null).getExpansion().isExpansionTokenRange() {
            return Loc;
        }
    }
    let mut Len: u32 = MeasureTokenLength(Loc, SM, LangOpts);
    if Len > Offset {
        Len = Len - Offset;
    } else {
        return Loc;
    }
    return Loc.getLocWithOffset(Len);
}

fn Lexer::isAtStartOfMacroExpansion(self, loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions, MacroBegin: *mut SourceLocation) -> bool {
    assert!(loc.isValid() && loc.isMacroID(), "Expected a valid macro loc");
    let mut expansionLoc: SourceLocation = SourceLocation {};
    if !SM.isAtStartOfImmediateMacroExpansion(loc, &mut expansionLoc) {
        return false;
    }
    if expansionLoc.isFileID() {
        if MacroBegin {
            *MacroBegin = expansionLoc;
        }
        return true;
    }
    return isAtStartOfMacroExpansion(expansionLoc, SM, LangOpts, MacroBegin);
}

fn Lexer::isAtEndOfMacroExpansion(self, loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions, MacroEnd: *mut SourceLocation) -> bool {
    assert!(loc.isValid() && loc.isMacroID(), "Expected a valid macro loc");
    let mut spellLoc: SourceLocation = SM.getSpellingLoc(loc);
    let mut tokLen: u32 = MeasureTokenLength(spellLoc, SM, LangOpts);
    if tokLen == 0 {
        return false;
    }
    let mut afterLoc: SourceLocation = loc.getLocWithOffset(tokLen);
    let mut expansionLoc: SourceLocation = SourceLocation {};
    let mut FID: FileID = SM.getFileID(loc);
    if SM.isInFileID(afterLoc, FID, null) {
        if !SM.isAtEndOfImmediateMacroExpansion(afterLoc, &mut expansionLoc) {
            return false;
        }
    } else {
        let mut Entry: *SLocEntry = SM.getSLocEntry(FID, null);
        assert!(Entry.isExpansion(), "Should be in an expansion");
        expansionLoc = Entry.getExpansion().getExpansionLocEnd();
    }
    if expansionLoc.isFileID() {
        if MacroEnd {
            *MacroEnd = expansionLoc;
        }
        return true;
    }
    return isAtEndOfMacroExpansion(expansionLoc, SM, LangOpts, MacroEnd);
}

fn makeRangeFromFileLocs(Range: CharSourceRange, SM: *SourceManager, LangOpts: *LangOptions) -> CharSourceRange {
    let mut Begin: SourceLocation = Range.getBegin();
    let mut End: SourceLocation = Range.getEnd();
    assert!(Begin.isFileID() && End.isFileID();
    if Range.isTokenRange() {
        End = getLocForEndOfToken(End, 0, SM, LangOpts);
        if End.isInvalid() {
            return CharSourceRange {};
        }
    }
    if FID.isInvalid() {
        return CharSourceRange {};
    }
    let mut EndOffs: u32 = 0;
    if !SM.isInFileID(End, FID, &mut EndOffs) || BeginOffs > EndOffs {
        return CharSourceRange {};
    }
    return getCharRange(Begin, End);
}

fn isInExpansionTokenRange(Loc: SourceLocation, SM: *SourceManager) -> bool {
    return SM.getSLocEntry(SM.getFileID(Loc), null).getExpansion().isExpansionTokenRange();
}

fn Lexer::makeFileCharRange(self, Range: CharSourceRange, SM: *SourceManager, LangOpts: *LangOptions) -> CharSourceRange {
    let mut Begin: SourceLocation = Range.getBegin();
    let mut End: SourceLocation = Range.getEnd();
    if Begin.isInvalid() || End.isInvalid() {
        return CharSourceRange {};
    }
    if Begin.isFileID() && End.isFileID() {
        return makeRangeFromFileLocs(Range, SM, LangOpts);
    }
    if Begin.isMacroID() && End.isFileID() {
        if !isAtStartOfMacroExpansion(Begin, SM, LangOpts, &mut Begin) {
            return CharSourceRange {};
        }
        Range.setBegin(Begin);
        return makeRangeFromFileLocs(Range, SM, LangOpts);
    }
    if Begin.isFileID() && End.isMacroID() {
        if Range.isTokenRange() {
            if !isAtEndOfMacroExpansion(End, SM, LangOpts, &mut End) {
                return CharSourceRange {};
            }
            Range.setTokenRange(isInExpansionTokenRange(Range.getEnd(), SM));
        } else if !isAtStartOfMacroExpansion(End, SM, LangOpts, &mut End) {
            return CharSourceRange {};
        }
        Range.setEnd(End);
        return makeRangeFromFileLocs(Range, SM, LangOpts);
    }
    assert!(Begin.isMacroID() && End.isMacroID();
    let mut MacroBegin: SourceLocation = SourceLocation {};
    let mut MacroEnd: SourceLocation = SourceLocation {};
    if isAtStartOfMacroExpansion(Begin, SM, LangOpts, &mut MacroBegin) && ((Range.isTokenRange() && isAtEndOfMacroExpansion(End, SM, LangOpts, &mut MacroEnd)) || (Range.isCharRange() && isAtStartOfMacroExpansion(End, SM, LangOpts, &mut MacroEnd))) {
        Range.setBegin(MacroBegin);
        Range.setEnd(MacroEnd);
        if Range.isTokenRange() {
            Range.setTokenRange(isInExpansionTokenRange(End, SM));
        }
        return makeRangeFromFileLocs(Range, SM, LangOpts);
    }
    let mut Invalid: bool = false;
    let mut BeginEntry: *SLocEntry = SM.getSLocEntry(SM.getFileID(Begin), &mut Invalid);
    if Invalid {
        return CharSourceRange {};
    }
    if BeginEntry.getExpansion().isMacroArgExpansion() {
        let mut EndEntry: *SLocEntry = SM.getSLocEntry(SM.getFileID(End), &mut Invalid);
        if Invalid {
            return CharSourceRange {};
        }
        if EndEntry.getExpansion().isMacroArgExpansion() && BeginEntry.getExpansion().getExpansionLocStart() == EndEntry.getExpansion().getExpansionLocStart() {
            Range.setBegin(SM.getImmediateSpellingLoc(Begin));
            Range.setEnd(SM.getImmediateSpellingLoc(End));
            return makeFileCharRange(Range, SM, LangOpts);
        }
    }
    return CharSourceRange {};
}

fn Lexer::getSourceText(self, Range: CharSourceRange, SM: *SourceManager, LangOpts: *LangOptions, Invalid: *mut bool) -> str {
    Range = makeFileCharRange(Range, SM, LangOpts);
    if Range.isInvalid() {
        if Invalid {
            *Invalid = true;
        }
        return "";
    }
    let mut beginInfo: FileIDAndOffset = SM.getDecomposedLoc(Range.getBegin());
    if beginInfo.first.isInvalid() {
        if Invalid {
            *Invalid = true;
        }
        return "";
    }
    let mut EndOffs: u32 = 0;
    if !SM.isInFileID(Range.getEnd(), beginInfo.first, &mut EndOffs) || beginInfo.second > EndOffs {
        if Invalid {
            *Invalid = true;
        }
        return "";
    }
    let mut invalidTemp: bool = false;
    let mut file: str = SM.getBufferData(beginInfo.first, &mut invalidTemp);
    if invalidTemp {
        if Invalid {
            *Invalid = true;
        }
        return "";
    }
    if Invalid {
        *Invalid = false;
    }
    return file[beginInfo.second..beginInfo.second + EndOffs - beginInfo.second];
}

fn Lexer::getImmediateMacroName(self, Loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions) -> str {
    assert!(Loc.isMacroID(), "Only reasonable to call this on macros");
    while true {
        let mut FID: FileID = SM.getFileID(Loc);
        let mut E: *SLocEntry = &mut SM.getSLocEntry(FID, null);
        let mut Expansion: *ExpansionInfo = E.getExpansion();
        Loc = Expansion.getExpansionLocStart();
        if !Expansion.isMacroArgExpansion() {
            break;
        }
        Loc = SM.getImmediateExpansionRange(Loc).getBegin();
        let mut SpellLoc: SourceLocation = Expansion.getSpellingLoc();
        if SpellLoc.isFileID() {
            break;
        }
        let mut MacroFID: FileID = SM.getFileID(Loc);
        if SM.isInFileID(SpellLoc, MacroFID, null) {
            break;
        }
        Loc = SpellLoc;
    }
    Loc = SM.getSpellingLoc(Loc);
    let mut ExpansionInfo: FileIDAndOffset = SM.getDecomposedLoc(Loc);
    let mut MacroTokenLength: u32 = MeasureTokenLength(Loc, SM, LangOpts);
    let mut ExpansionBuffer: str = SM.getBufferData(ExpansionInfo.first, null);
    return ExpansionBuffer[ExpansionInfo.second..ExpansionInfo.second + MacroTokenLength];
}

fn Lexer::getImmediateMacroNameForDiagnostics(self, Loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions) -> str {
    assert!(Loc.isMacroID(), "Only reasonable to call this on macros");
    while SM.isMacroArgExpansion(Loc, null) {
        Loc = SM.getImmediateExpansionRange(Loc).getBegin();
    }
    let mut SpellLoc: SourceLocation = SM.getSpellingLoc(Loc);
    if !SpellLoc.isFileID() || SM.isWrittenInScratchSpace(SpellLoc) {
        return "";
    }
    Loc = SM.getSpellingLoc(SM.getImmediateExpansionRange(Loc).getBegin());
    let mut ExpansionInfo: FileIDAndOffset = SM.getDecomposedLoc(Loc);
    let mut MacroTokenLength: u32 = MeasureTokenLength(Loc, SM, LangOpts);
    let mut ExpansionBuffer: str = SM.getBufferData(ExpansionInfo.first, null);
    return ExpansionBuffer[ExpansionInfo.second..ExpansionInfo.second + MacroTokenLength];
}

fn Lexer::isAsciiIdentifierContinueChar(self, c: i8, LangOpts: *LangOptions) -> bool {
    return isAsciiIdentifierContinue(c, LangOpts.DollarIdents);
}

fn Lexer::isNewLineEscaped(self, BufferStart: *u8, Str: *u8) -> bool {
    assert!(isVerticalWhitespace(Str[0]);
    if Str - 1 < BufferStart {
        return false;
    }
    if (Str[0] == 10 && Str[-1] == 13) || (Str[0] == 13 && Str[-1] == 10) {
        if Str - 2 < BufferStart {
            return false;
        }
        Str -= 1;
    }
    Str -= 1;
    while Str > BufferStart && isHorizontalWhitespace(*Str) {
        Str -= 1;
    }
    return *Str == '\';
}

fn Lexer::getIndentationForLine(self, Loc: SourceLocation, SM: *SourceManager) -> str {
    if Loc.isInvalid() || Loc.isMacroID() {
        return "";
    }
    let mut LocInfo: FileIDAndOffset = SM.getDecomposedLoc(Loc);
    if LocInfo.first.isInvalid() {
        return "";
    }
    let mut Invalid: bool = false;
    let mut Buffer: str = SM.getBufferData(LocInfo.first, &mut Invalid);
    if Invalid {
        return "";
    }
    let mut Line: *u8 = findBeginningOfLine(Buffer, LocInfo.second);
    if !Line {
        return "";
    }
    let mut Rest: str = Buffer[Line - Buffer.ptr..Line - Buffer.ptr + npos];
    let mut NumWhitespaceChars: u64 = Rest.find_first_not_of(" \t", 0);
    return if NumWhitespaceChars == npos { "" } else { Rest.take_front(NumWhitespaceChars) };
}

fn GetMappedTokenLoc(PP: *mut Preprocessor, FileLoc: SourceLocation, CharNo: u32, TokLen: u32) -> SourceLocation {
    assert!(FileLoc.isMacroID(), "Must be a macro expansion");
    let mut SM: *mut SourceManager = PP.getSourceManager();
    let mut SpellingLoc: SourceLocation = SM.getSpellingLoc(FileLoc);
    SpellingLoc = SpellingLoc.getLocWithOffset(CharNo);
    let mut II: CharSourceRange = SM.getImmediateExpansionRange(FileLoc);
    return SM.createExpansionLoc(SpellingLoc, II.getBegin(), II.getEnd(), TokLen, true, 0, 0);
}

fn Lexer::getSourceLocation(self: *Lexer, Loc: *u8, TokLen: u32) -> SourceLocation {
    assert!(Loc >= self.BufferStart && Loc <= self.BufferEnd, "Location out of range for this buffer!");
    let mut CharNo: u32 = Loc - self.BufferStart;
    if self.FileLoc.isFileID() {
        return self.FileLoc.getLocWithOffset(CharNo);
    }
    assert!(self.PP, "This doesn't work on raw lexers");
    return GetMappedTokenLoc(*self.PP, self.FileLoc, CharNo, TokLen);
}

fn Lexer::Diag(self: *Lexer, Loc: *u8, DiagID: u32) -> DiagnosticBuilder {
    return self.PP.Diag(self.getSourceLocation(Loc, 1), DiagID);
}

fn Lexer::DiagCompat(self: *Lexer, Loc: *u8, CompatDiagId: u32) -> DiagnosticBuilder {
    return self.Diag(Loc, getCompatDiagId(self.LangOpts, CompatDiagId));
}

fn GetTrigraphCharForLetter(Letter: i8) -> i8 {
    match Letter {
        _ => {
            return 0;
        },
        '=' => {
            return '#';
        },
        ')' => {
            return ']';
        },
        '(' => {
            return '[';
        },
        '!' => {
            return '|';
        },
        ''' => {
            return '^';
        },
        '>' => {
            return '}';
        },
        '/' => {
            return '\';
        },
        '<' => {
            return '{';
        },
        '-' => {
            return '~';
        },
    }
}

fn DecodeTrigraphChar(CP: *u8, L: *mut Lexer, Trigraphs: bool) -> i8 {
    let mut Res: i8 = GetTrigraphCharForLetter(*CP);
    if !Res {
        return Res;
    }
    if !Trigraphs {
        if L && !L.isLexingRawMode() {
            L.Diag(CP - 2, trigraph_ignored);
        }
        return 0;
    }
    if L && !L.isLexingRawMode() {
        L.Diag(CP - 2, trigraph_converted) << &mut Res[0..1];
    }
    return Res;
}

fn Lexer::getEscapedNewLineSize(self, Ptr: *u8) -> u32 {
    let mut Size: u32 = 0;
    while isWhitespace(Ptr[Size]) {
        Size += 1;
        if Ptr[Size - 1] != 10 && Ptr[Size - 1] != 13 {
            continue;
        }
        if (Ptr[Size] == 13 || Ptr[Size] == 10) && Ptr[Size - 1] != Ptr[Size] {
            Size += 1;
        }
        return Size;
    }
    return 0;
}

fn Lexer::SkipEscapedNewLines(self, P: *u8) -> *u8 {
    while true {
        let mut AfterEscape: *u8 = null;
        if *P == '\' {
            AfterEscape = P + 1;
        } else if *P == '?' {
            if P[1] != '?' || P[2] != '/' {
                return P;
            }
            AfterEscape = P + 3;
        } else {
            return P;
        }
        let mut NewLineSize: u32 = getEscapedNewLineSize(AfterEscape);
        if NewLineSize == 0 {
            return P;
        }
        P = AfterEscape + NewLineSize;
    }
}

fn Lexer::findNextToken(self, Loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions, IncludeComments: bool) -> optional<Token> {
    if Loc.isMacroID() {
        if !isAtEndOfMacroExpansion(Loc, SM, LangOpts, &mut Loc) {
            return nullopt;
        }
    }
    Loc = getLocForEndOfToken(Loc, 0, SM, LangOpts);
    let mut LocInfo: FileIDAndOffset = SM.getDecomposedLoc(Loc);
    let mut InvalidTemp: bool = false;
    let mut File: str = SM.getBufferData(LocInfo.first, &mut InvalidTemp);
    if InvalidTemp {
        return nullopt;
    }
    let mut TokenBegin: *u8 = File.ptr + LocInfo.second;
    let mut lexer: Lexer = Lexer { SM.getLocForStartOfFile(LocInfo.first), LangOpts, File.begin(), TokenBegin, File.end(), true };
    lexer.SetCommentRetentionState(IncludeComments);
    let mut Tok: Token = Token {};
    lexer.LexFromRawLexer(Tok);
    return Tok;
}

fn Lexer::findPreviousToken(self, Loc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions, IncludeComments: bool) -> optional<Token> {
    let mut StartOfFile: SourceLocation = SM.getLocForStartOfFile(SM.getFileID(Loc));
    while Loc != StartOfFile {
        Loc = Loc.getLocWithOffset(-1);
        if Loc.isInvalid() {
            return nullopt;
        }
        Loc = GetBeginningOfToken(Loc, SM, LangOpts);
        let mut Tok: Token = Token {};
        if getRawToken(Loc, Tok, SM, LangOpts, false) {
            continue;
        }
        if !Tok.is(comment) || IncludeComments {
            return Tok;
        }
    }
    return nullopt;
}

fn Lexer::findLocationAfterToken(self, Loc: SourceLocation, TKind: TokenKind, SM: *SourceManager, LangOpts: *LangOptions, SkipTrailingWhitespaceAndNewLine: bool) -> SourceLocation {
    let mut Tok: optional<Token> = findNextToken(Loc, SM, LangOpts, false);
    if !Tok || operator(Tok).isNot(TKind) {
        return SourceLocation {};
    }
    let mut TokenLoc: SourceLocation = operator(Tok).getLocation();
    let mut NumWhitespaceChars: u32 = 0;
    if SkipTrailingWhitespaceAndNewLine {
        let mut TokenEnd: *u8 = SM.getCharacterData(TokenLoc, null) + operator(Tok).getLength();
        let mut C: u8 = *TokenEnd;
        while isHorizontalWhitespace(C) {
            C = *(TokenEnd += 1);
            NumWhitespaceChars += 1;
        }
        if C == 10 || C == 13 {
            let mut PrevC: i8 = C;
            C = *(TokenEnd += 1);
            NumWhitespaceChars += 1;
            if (C == 10 || C == 13) && C != PrevC {
                NumWhitespaceChars += 1;
            }
        }
    }
    return TokenLoc.getLocWithOffset(operator(Tok).getLength() + NumWhitespaceChars);
}

fn Lexer::getCharAndSizeSlow(self, Ptr: *u8, Tok: *mut Token) -> SizedChar {
    let mut Size: u32 = 0;
    if Ptr[0] == '\' {
        Size += 1;
        Ptr += 1;
        !isWhitespace(Ptr[0]);
        if getEscapedNewLineSize(Ptr) {
            EscapedNewLineSize;
        } else {
            if Tok {
                Tok.setFlag(NeedsCleaning);
            }
            if Ptr[0] != 10 && Ptr[0] != 13 && Tok && !self.isLexingRawMode() {
                self.Diag(Ptr, backslash_newline_space);
            }
            Size += EscapedNewLineSize;
            Ptr += EscapedNewLineSize;
            let mut CharAndSize: SizedChar = self.getCharAndSizeSlow(Ptr, Tok);
            CharAndSize.Size += Size;
            return CharAndSize;
        }
        return SizedChar { '\', Size };
    }
    if Ptr[0] == '?' && Ptr[1] == '?' {
        if DecodeTrigraphChar(Ptr + 2, if Tok { self } else { null }, self.LangOpts.Trigraphs) {
            C;
        } else {
            if Tok {
                Tok.setFlag(NeedsCleaning);
            }
            Ptr += 3;
            Size += 3;
            if C == '\' {
                
            }
            return SizedChar { C, Size };
        }
    }
    return SizedChar { *Ptr, Size + 1 };
}

fn Lexer::getCharAndSizeSlowNoWarn(self, Ptr: *u8, LangOpts: *LangOptions) -> SizedChar {
    let mut Size: u32 = 0;
    if Ptr[0] == '\' {
        Size += 1;
        Ptr += 1;
        !isWhitespace(Ptr[0]);
        if getEscapedNewLineSize(Ptr) {
            EscapedNewLineSize;
        } else {
            Size += EscapedNewLineSize;
            Ptr += EscapedNewLineSize;
            let mut CharAndSize: SizedChar = getCharAndSizeSlowNoWarn(Ptr, LangOpts);
            CharAndSize.Size += Size;
            return CharAndSize;
        }
        return SizedChar { '\', Size };
    }
    if LangOpts.Trigraphs && Ptr[0] == '?' && Ptr[1] == '?' {
        if GetTrigraphCharForLetter(Ptr[2]) {
            C;
        } else {
            Ptr += 3;
            Size += 3;
            if C == '\' {
                
            }
            return SizedChar { C, Size };
        }
    }
    return SizedChar { *Ptr, Size + 1 };
}

fn Lexer::SetByteOffset(self, Offset: u32, StartOfLine: bool) {
    self.BufferPtr = self.BufferStart + Offset;
    if self.BufferPtr > self.BufferEnd {
        self.BufferPtr = self.BufferEnd;
    }
    self.IsAtStartOfLine = StartOfLine;
    self.IsAtPhysicalStartOfLine = StartOfLine;
}

fn isUnicodeWhitespace(Codepoint: u32) -> bool {
    let mut UnicodeWhitespaceChars: UnicodeCharSet = UnicodeWhitespaceCharRanges;
    return UnicodeWhitespaceChars.contains(Codepoint);
}

fn isMathematicalExtensionID(C: u32, LangOpts: *LangOptions, IsStart: bool, IsExtension: *mut bool) -> bool {
    let mut MathStartChars: UnicodeCharSet = MathematicalNotationProfileIDStartRanges;
    let mut MathContinueChars: UnicodeCharSet = MathematicalNotationProfileIDContinueRanges;
    if MathStartChars.contains(C) || (!IsStart && MathContinueChars.contains(C)) {
        IsExtension = true;
        return true;
    }
    return false;
}

fn isAllowedIDChar(C: u32, LangOpts: *LangOptions, IsExtension: *mut bool) -> bool {
    if LangOpts.AsmPreprocessor {
        return false;
    } else if LangOpts.DollarIdents && '$' == C {
        return true;
    } else if LangOpts.CPlusPlus || LangOpts.C23 {
        let mut XIDStartChars: UnicodeCharSet = XIDStartRanges;
        let mut XIDContinueChars: UnicodeCharSet = XIDContinueRanges;
        if C == '_' || XIDStartChars.contains(C) || XIDContinueChars.contains(C) {
            return true;
        }
        return isMathematicalExtensionID(C, LangOpts, false, IsExtension);
    } else if LangOpts.C11 {
        let mut C11AllowedIDChars: UnicodeCharSet = C11AllowedIDCharRanges;
        return C11AllowedIDChars.contains(C);
    } else {
        let mut C99AllowedIDChars: UnicodeCharSet = C99AllowedIDCharRanges;
        return C99AllowedIDChars.contains(C);
    }
}

fn isAllowedInitiallyIDChar(C: u32, LangOpts: *LangOptions, IsExtension: *mut bool) -> bool {
    assert!(C > 127, "isAllowedInitiallyIDChar called with an ASCII codepoint");
    IsExtension = false;
    if LangOpts.AsmPreprocessor {
        return false;
    }
    if LangOpts.CPlusPlus || LangOpts.C23 {
        let mut XIDStartChars: UnicodeCharSet = XIDStartRanges;
        if XIDStartChars.contains(C) {
            return true;
        }
        return isMathematicalExtensionID(C, LangOpts, true, IsExtension);
    }
    if !isAllowedIDChar(C, LangOpts, IsExtension) {
        return false;
    }
    if LangOpts.C11 {
        let mut C11DisallowedInitialIDChars: UnicodeCharSet = C11DisallowedInitialIDCharRanges;
        return !C11DisallowedInitialIDChars.contains(C);
    }
    let mut C99DisallowedInitialIDChars: UnicodeCharSet = C99DisallowedInitialIDCharRanges;
    return !C99DisallowedInitialIDChars.contains(C);
}

fn diagnoseMathematicalNotationInIdentifier(Diags: *mut DiagnosticsEngine, LangOpts: *LangOptions, C: u32, Range: CharSourceRange) {
    let mut MathStartChars: UnicodeCharSet = MathematicalNotationProfileIDStartRanges;
    let mut MathContinueChars: UnicodeCharSet = MathematicalNotationProfileIDContinueRanges;
    MathStartChars as void;
    MathContinueChars as void;
    assert!((MathStartChars.contains(C) || MathContinueChars.contains(C)), "Unexpected mathematical notation codepoint");
    let mut DiagID: u32 = if LangOpts.CPlusPlus { getCompatDiagId(LangOpts, mathematical_notation) } else { ext_mathematical_notation };
    Diags.Report(Range.getBegin(), DiagID) << EscapeSingleCodepointForDiagnostic(C) << Range;
}

fn makeCharRange(L: *mut Lexer, Begin: *u8, End: *u8) -> CharSourceRange {
    return getCharRange(L.getSourceLocation(Begin, 1), L.getSourceLocation(End, 1));
}

fn maybeDiagnoseIDCharCompat(Diags: *mut DiagnosticsEngine, C: u32, Range: CharSourceRange, IsFirst: bool) {
    if !Diags.isIgnored(warn_c99_compat_unicode_id, Range.getBegin()) {
        let mut C99AllowedIDChars: UnicodeCharSet = C99AllowedIDCharRanges;
        let mut C99DisallowedInitialIDChars: UnicodeCharSet = C99DisallowedInitialIDCharRanges;
        if !C99AllowedIDChars.contains(C) {
            Diags.Report(Range.getBegin(), warn_c99_compat_unicode_id) << Range << CannotAppearInIdentifier;
        } else if IsFirst && C99DisallowedInitialIDChars.contains(C) {
            Diags.Report(Range.getBegin(), warn_c99_compat_unicode_id) << Range << CannotStartIdentifier;
        }
    }
}

fn maybeDiagnoseUTF8Homoglyph(Diags: *mut DiagnosticsEngine, C: u32, Range: CharSourceRange) {
    let mut SortedHomoglyphs: [50]HomoglyphPair = [HomoglyphPair { 173, 0 }, HomoglyphPair { 451, '!' }, HomoglyphPair { 894, ';' }, HomoglyphPair { 8203, 0 }, HomoglyphPair { 8204, 0 }, HomoglyphPair { 8205, 0 }, HomoglyphPair { 8288, 0 }, HomoglyphPair { 8289, 0 }, HomoglyphPair { 8290, 0 }, HomoglyphPair { 8291, 0 }, HomoglyphPair { 8292, 0 }, HomoglyphPair { 8722, '-' }, HomoglyphPair { 8725, '/' }, HomoglyphPair { 8726, '\' }, HomoglyphPair { 8727, '*' }, HomoglyphPair { 8739, '|' }, HomoglyphPair { 8743, '^' }, HomoglyphPair { 8758, ':' }, HomoglyphPair { 8764, '~' }, HomoglyphPair { 42889, ':' }, HomoglyphPair { 65279, 0 }, HomoglyphPair { 65281, '!' }, HomoglyphPair { 65283, '#' }, HomoglyphPair { 65284, '$' }, HomoglyphPair { 65285, '%' }, HomoglyphPair { 65286, '&' }, HomoglyphPair { 65288, '(' }, HomoglyphPair { 65289, ')' }, HomoglyphPair { 65290, '*' }, HomoglyphPair { 65291, '+' }, HomoglyphPair { 65292, ',' }, HomoglyphPair { 65293, '-' }, HomoglyphPair { 65294, '.' }, HomoglyphPair { 65295, '/' }, HomoglyphPair { 65306, ':' }, HomoglyphPair { 65307, ';' }, HomoglyphPair { 65308, '<' }, HomoglyphPair { 65309, '=' }, HomoglyphPair { 65310, '>' }, HomoglyphPair { 65311, '?' }, HomoglyphPair { 65312, '@' }, HomoglyphPair { 65339, '[' }, HomoglyphPair { 65340, '\' }, HomoglyphPair { 65341, ']' }, HomoglyphPair { 65342, '^' }, HomoglyphPair { 65371, '{' }, HomoglyphPair { 65372, '|' }, HomoglyphPair { 65373, '}' }, HomoglyphPair { 65374, '~' }, HomoglyphPair { 0, 0 }];
    let mut Homoglyph: *HomoglyphPair = lower_bound(begin(SortedHomoglyphs), end(SortedHomoglyphs) - 1, HomoglyphPair { C, 0 });
    if Homoglyph.Character == C {
        if Homoglyph.LooksLike {
            let mut LooksLikeStr: [2]i8 = [Homoglyph.LooksLike, 0];
            Diags.Report(Range.getBegin(), warn_utf8_symbol_homoglyph) << Range << EscapeSingleCodepointForDiagnostic(C) << LooksLikeStr;
        } else {
            Diags.Report(Range.getBegin(), warn_utf8_symbol_zero_width) << Range << EscapeSingleCodepointForDiagnostic(C);
        }
    }
}

fn CheckCodepointValidInIdentifier(PP: *Preprocessor, LangOpts: *LangOptions, CodePoint: u32, Range: CharSourceRange, IsFirst: bool, Diagnose: bool) -> bool {
    if isASCII(CodePoint) {
        return true;
    }
    let mut IsExtension: bool = false;
    let mut IsIDStart: bool = isAllowedInitiallyIDChar(CodePoint, LangOpts, IsExtension);
    let mut IsIDContinue: bool = IsIDStart || isAllowedIDChar(CodePoint, LangOpts, IsExtension);
    if (IsFirst && IsIDStart) || (!IsFirst && IsIDContinue) {
        return true;
    }
    if !Diagnose {
        return false;
    }
    let mut InvalidOnlyAtStart: bool = IsFirst && !IsIDStart && IsIDContinue;
    if !IsFirst || InvalidOnlyAtStart {
        PP.Diag(Range.getBegin(), err_character_not_allowed_identifier) << Range << EscapeSingleCodepointForDiagnostic(CodePoint) << InvalidOnlyAtStart << CreateRemoval(Range);
    } else {
        PP.Diag(Range.getBegin(), err_character_not_allowed) << Range << EscapeSingleCodepointForDiagnostic(CodePoint) << CreateRemoval(Range);
    }
    return false;
}

fn Lexer::tryConsumeIdentifierUCN(self, CurPtr: **mut u8, Size: u32, Result: *mut Token) -> bool {
    let mut UCNPtr: *u8 = CurPtr + Size;
    let mut CodePoint: u32 = self.tryReadUCN(UCNPtr, CurPtr, null);
    if CodePoint == 0 {
        return false;
    }
    let mut IsExtension: bool = false;
    if !isAllowedIDChar(CodePoint, self.LangOpts, IsExtension) {
        if isASCII(CodePoint) || isUnicodeWhitespace(CodePoint) {
            return false;
        }
        let mut DiagnoseAndContinue: bool = !self.isLexingRawMode() && !self.ParsingPreprocessorDirective && !self.PP.isPreprocessedOutput();
        if !CheckCodepointValidInIdentifier(self.PP, self.LangOpts, CodePoint, makeCharRange(*self, CurPtr, UCNPtr), false, DiagnoseAndContinue) && !DiagnoseAndContinue {
            return false;
        }
    } else if !self.isLexingRawMode() {
        if IsExtension {
            diagnoseMathematicalNotationInIdentifier(self.PP.getDiagnostics(), self.LangOpts, CodePoint, makeCharRange(*self, CurPtr, UCNPtr));
        }
        maybeDiagnoseIDCharCompat(self.PP.getDiagnostics(), CodePoint, makeCharRange(*self, CurPtr, UCNPtr), false);
    }
    Result.setFlag(HasUCN);
    if (UCNPtr - CurPtr == 6 && CurPtr[1] == 'u') || (UCNPtr - CurPtr == 10 && CurPtr[1] == 'U') {
        CurPtr = UCNPtr;
    } else {
        while CurPtr != UCNPtr {
            self.getAndAdvanceChar(CurPtr, Result) as void;
        }
    }
    return true;
}

fn Lexer::tryConsumeIdentifierUTF8Char(self, CurPtr: **mut u8, Result: *mut Token) -> bool {
    let mut CodePoint: UTF32 = zeroed();
    let mut FirstCodeUnitSize: u32 = 0;
    self.getCharAndSize(CurPtr, FirstCodeUnitSize);
    let mut CharStart: *u8 = CurPtr + FirstCodeUnitSize - 1;
    let mut UnicodePtr: *u8 = CharStart;
    let mut ConvResult: ConversionResult = convertUTF8Sequence(&mut UnicodePtr as **mut UTF8, self.BufferEnd as *UTF8, &mut CodePoint, strictConversion);
    if ConvResult != conversionOK {
        return false;
    }
    let mut IsExtension: bool = false;
    if !isAllowedIDChar(CodePoint as u32, self.LangOpts, IsExtension) {
        if isASCII(CodePoint) || isUnicodeWhitespace(CodePoint) {
            return false;
        }
        let mut DiagnoseAndContinue: bool = !self.isLexingRawMode() && !self.ParsingPreprocessorDirective && !self.PP.isPreprocessedOutput();
        if !CheckCodepointValidInIdentifier(self.PP, self.LangOpts, CodePoint, makeCharRange(*self, CharStart, UnicodePtr), false, DiagnoseAndContinue) && !DiagnoseAndContinue {
            return false;
        }
    } else if !self.isLexingRawMode() {
        if IsExtension {
            diagnoseMathematicalNotationInIdentifier(self.PP.getDiagnostics(), self.LangOpts, CodePoint, makeCharRange(*self, CharStart, UnicodePtr));
        }
        maybeDiagnoseIDCharCompat(self.PP.getDiagnostics(), CodePoint, makeCharRange(*self, CharStart, UnicodePtr), false);
        maybeDiagnoseUTF8Homoglyph(self.PP.getDiagnostics(), CodePoint, makeCharRange(*self, CharStart, UnicodePtr));
    }
    self.ConsumeChar(CurPtr, FirstCodeUnitSize, Result);
    CurPtr = UnicodePtr;
    return true;
}

fn Lexer::LexUnicodeIdentifierStart(self, Result: *mut Token, C: u32, CurPtr: *u8) -> bool {
    let mut IsExtension: bool = false;
    if isAllowedInitiallyIDChar(C, self.LangOpts, IsExtension) {
        if !self.isLexingRawMode() && !self.ParsingPreprocessorDirective && !self.PP.isPreprocessedOutput() {
            if IsExtension {
                diagnoseMathematicalNotationInIdentifier(self.PP.getDiagnostics(), self.LangOpts, C, makeCharRange(*self, self.BufferPtr, CurPtr));
            }
            maybeDiagnoseIDCharCompat(self.PP.getDiagnostics(), C, makeCharRange(*self, self.BufferPtr, CurPtr), true);
            maybeDiagnoseUTF8Homoglyph(self.PP.getDiagnostics(), C, makeCharRange(*self, self.BufferPtr, CurPtr));
        }
        self.MIOpt.ReadToken();
        return self.LexIdentifierContinue(Result, CurPtr);
    }
    if !self.isLexingRawMode() && !self.ParsingPreprocessorDirective && !self.PP.isPreprocessedOutput() && !isASCII(*self.BufferPtr) && !isUnicodeWhitespace(C) {
        CheckCodepointValidInIdentifier(self.PP, self.LangOpts, C, makeCharRange(*self, self.BufferPtr, CurPtr), true, true);
        self.BufferPtr = CurPtr;
        return false;
    }
    self.MIOpt.ReadToken();
    self.FormTokenWithChars(Result, CurPtr, unknown);
    return true;
}

fn fastParseASCIIIdentifierScalar(CurPtr: *u8) -> *u8 {
    let mut C: u8 = *CurPtr;
    while isAsciiIdentifierContinue(C) {
        C = *CurPtr += 1;
    }
    return CurPtr;
}

fn fastParseASCIIIdentifierSSE42(CurPtr: *u8, BufferEnd: *u8) -> *u8 {
    let mut AsciiIdentifierRange: [16]i8 = [16]i8 {};
    let mut BytesPerRegister: i64 = 16;
    let mut AsciiIdentifierRangeV: __m128i = _mm_load_si128(AsciiIdentifierRange as *__m128i);
    while __builtin_expect((BufferEnd - CurPtr >= BytesPerRegister) as bool, true) {
        let mut Cv: __m128i = _mm_loadu_si128(CurPtr as *__m128i);
        let mut Consumed: i32 = _mm_cmpistri(AsciiIdentifierRangeV, Cv, 0 | 4 | 0 | 16);
        CurPtr += Consumed;
        if Consumed == BytesPerRegister {
            continue;
        }
        return CurPtr;
    }
    return fastParseASCIIIdentifierScalar(CurPtr);
}

fn fastParseASCIIIdentifier(CurPtr: *u8, BufferEnd: *u8) -> *u8 {
    if __builtin_expect((0) as bool, true) {
        return fastParseASCIIIdentifierSSE42(CurPtr, BufferEnd);
    }
    return fastParseASCIIIdentifierScalar(CurPtr);
}

fn Lexer::LexIdentifierContinue(self, Result: *mut Token, CurPtr: *u8) -> bool {
    while true {
        CurPtr = fastParseASCIIIdentifier(CurPtr, self.BufferEnd);
        let mut Size: u32 = 0;
        let mut C: u8 = self.getCharAndSize(CurPtr, Size);
        if isAsciiIdentifierContinue(C) {
            CurPtr = self.ConsumeChar(CurPtr, Size, Result);
            continue;
        }
        if C == '$' {
            if !self.LangOpts.DollarIdents {
                break;
            }
            if !self.isLexingRawMode() {
                self.Diag(CurPtr, ext_dollar_in_identifier);
            }
            CurPtr = self.ConsumeChar(CurPtr, Size, Result);
            continue;
        }
        if C == '\' && self.tryConsumeIdentifierUCN(CurPtr, Size, Result) {
            continue;
        }
        if !isASCII(C) && self.tryConsumeIdentifierUTF8Char(CurPtr, Result) {
            continue;
        }
        break;
    }
    let mut IdStart: *u8 = self.BufferPtr;
    self.FormTokenWithChars(Result, CurPtr, raw_identifier);
    Result.setRawIdentifierData(IdStart);
    if self.LexingRawMode {
        return true;
    }
    let mut II: *IdentifierInfo = self.PP.LookUpIdentifierInfo(Result);
    if self.isCodeCompletionPoint(CurPtr) {
        Result.setKind(code_completion);
        assert!(*CurPtr == 0, "Completion character must be 0");
        CurPtr += 1;
        if CurPtr < self.BufferEnd {
            while isAsciiIdentifierContinue(*CurPtr) {
                CurPtr += 1;
            }
        }
        self.BufferPtr = CurPtr;
        return true;
    }
    if II.isHandleIdentifierCase() || II.isModuleKeyword() || II.isImportKeyword() || II.getTokenID() == kw_export {
        return self.PP.HandleIdentifier(Result);
    }
    return true;
}

fn Lexer::isHexaLiteral(self, Start: *u8, LangOpts: *LangOptions) -> bool {
    let mut CharAndSize1: SizedChar = getCharAndSizeNoWarn(Start, LangOpts);
    let mut C1: i8 = CharAndSize1.Char;
    if C1 != '0' {
        return false;
    }
    let mut CharAndSize2: SizedChar = getCharAndSizeNoWarn(Start + CharAndSize1.Size, LangOpts);
    let mut C2: i8 = CharAndSize2.Char;
    return (C2 == 'x' || C2 == 'X');
}

fn Lexer::LexNumericConstant(self, Result: *mut Token, CurPtr: *u8) -> bool {
    let mut Size: u32 = 0;
    let mut C: i8 = self.getCharAndSize(CurPtr, Size);
    let mut PrevCh: i8 = 0;
    while isPreprocessingNumberBody(C) {
        CurPtr = self.ConsumeChar(CurPtr, Size, Result);
        PrevCh = C;
        if self.LangOpts.HLSL && C == '.' && (*CurPtr == 'x' || *CurPtr == 'r') {
            CurPtr -= Size;
            break;
        }
        C = self.getCharAndSize(CurPtr, Size);
    }
    if (C == '-' || C == '+') && (PrevCh == 'E' || PrevCh == 'e') {
        if !self.LangOpts.MicrosoftExt || !self.isHexaLiteral(self.BufferPtr, self.LangOpts) {
            return self.LexNumericConstant(Result, self.ConsumeChar(CurPtr, Size, Result));
        }
    }
    if (C == '-' || C == '+') && (PrevCh == 'P' || PrevCh == 'p') {
        let mut IsHexFloat: bool = true;
        if !self.LangOpts.C99 {
            if !self.isHexaLiteral(self.BufferPtr, self.LangOpts) {
                IsHexFloat = false;
            } else if !self.LangOpts.CPlusPlus17 && find(self.BufferPtr, CurPtr, '_') != CurPtr {
                IsHexFloat = false;
            }
        }
        if IsHexFloat {
            return self.LexNumericConstant(Result, self.ConsumeChar(CurPtr, Size, Result));
        }
    }
    if C == ''' && self.LangOpts.AllowLiteralDigitSeparator {
        if isAsciiIdentifierContinue(Next) {
            if !self.isLexingRawMode() {
                self.Diag(CurPtr, if self.LangOpts.CPlusPlus { warn_cxx11_compat_digit_separator } else { warn_c23_compat_digit_separator });
            }
            CurPtr = self.ConsumeChar(CurPtr, Size, Result);
            CurPtr = self.ConsumeChar(CurPtr, NextSize, Result);
            return self.LexNumericConstant(Result, CurPtr);
        }
    }
    if C == '$' && self.LangOpts.DollarIdents {
        CurPtr = self.ConsumeChar(CurPtr, Size, Result);
        return self.LexNumericConstant(Result, CurPtr);
    }
    if C == '\' && self.tryConsumeIdentifierUCN(CurPtr, Size, Result) {
        return self.LexNumericConstant(Result, CurPtr);
    }
    if !isASCII(C) && self.tryConsumeIdentifierUTF8Char(CurPtr, Result) {
        return self.LexNumericConstant(Result, CurPtr);
    }
    let mut TokStart: *u8 = self.BufferPtr;
    self.FormTokenWithChars(Result, CurPtr, numeric_constant);
    Result.setLiteralData(TokStart);
    return true;
}

fn Lexer::LexUDSuffix(self, Result: *mut Token, CurPtr: *u8, IsStringLiteral: bool) -> *u8 {
    assert!(self.LangOpts.CPlusPlus);
    let mut Size: u32 = 0;
    let mut C: i8 = self.getCharAndSize(CurPtr, Size);
    let mut Consumed: bool = false;
    if !isAsciiIdentifierStart(C, self.LangOpts.DollarIdents) {
        if C == '\' && self.tryConsumeIdentifierUCN(CurPtr, Size, Result) {
            Consumed = true;
        } else if !isASCII(C) && self.tryConsumeIdentifierUTF8Char(CurPtr, Result) {
            Consumed = true;
        } else {
            return CurPtr;
        }
    }
    if !self.LangOpts.CPlusPlus11 {
        if !self.isLexingRawMode() {
            self.Diag(CurPtr, if C == '_' { warn_cxx11_compat_user_defined_literal } else { warn_cxx11_compat_reserved_user_defined_literal }) << CreateInsertion(self.getSourceLocation(CurPtr, 1), " ", false);
        }
        return CurPtr;
    }
    if !Consumed {
        let mut IsUDSuffix: bool = false;
        if C == '_' {
            IsUDSuffix = true;
        } else if IsStringLiteral && self.LangOpts.CPlusPlus14 {
            let mut MaxStandardSuffixLength: u32 = 3;
            let mut Buffer: [3]i8 = [3]i8 {};
            let mut Consumed: u32 = Size;
            let mut Chars: u32 = 1;
            while true {
                if !isAsciiIdentifierContinue(Next, self.LangOpts.DollarIdents) {
                    let mut CompleteSuffix: str = Buffer[0..Chars];
                    IsUDSuffix = isValidUDSuffix(self.LangOpts, CompleteSuffix);
                    break;
                }
                if Chars == MaxStandardSuffixLength {
                    break;
                }
                Buffer[Chars += 1] = Next;
                Consumed += NextSize;
            }
        }
        if !IsUDSuffix {
            if !self.isLexingRawMode() {
                self.Diag(CurPtr, if self.LangOpts.MSVCCompat { ext_ms_reserved_user_defined_literal } else { ext_reserved_user_defined_literal }) << CreateInsertion(self.getSourceLocation(CurPtr, 1), " ", false);
            }
            return CurPtr;
        }
        CurPtr = self.ConsumeChar(CurPtr, Size, Result);
    }
    Result.setFlag(HasUDSuffix);
    while true {
        C = self.getCharAndSize(CurPtr, Size);
        if isAsciiIdentifierContinue(C, self.LangOpts.DollarIdents) {
            CurPtr = self.ConsumeChar(CurPtr, Size, Result);
        } else if C == '\' && self.tryConsumeIdentifierUCN(CurPtr, Size, Result) {} else if !isASCII(C) && self.tryConsumeIdentifierUTF8Char(CurPtr, Result) {} else {
            break;
        }
    }
    return CurPtr;
}

fn Lexer::LexStringLiteral(self, Result: *mut Token, CurPtr: *u8, Kind: TokenKind) -> bool {
    let mut AfterQuote: *u8 = CurPtr;
    let mut NulCharacter: *u8 = null;
    if !self.isLexingRawMode() && (Kind == utf8_string_literal || Kind == utf16_string_literal || Kind == utf32_string_literal) {
        self.Diag(self.BufferPtr, if self.LangOpts.CPlusPlus { warn_cxx98_compat_unicode_literal } else { warn_c99_compat_unicode_literal });
    }
    let mut C: i8 = self.getAndAdvanceChar(CurPtr, Result);
    while C != '"' {
        if C == '\' {
            let mut SavedCurPtr: *u8 = CurPtr;
            C = self.getAndAdvanceChar(CurPtr, Result);
            if self.ParsingFilename && C == '"' {
                CurPtr = SavedCurPtr;
            }
        }
        if C == 10 || C == 13 || (C == 0 && CurPtr - 1 == self.BufferEnd) {
            if !self.isLexingRawMode() && !self.LangOpts.AsmPreprocessor {
                self.Diag(self.BufferPtr, ext_unterminated_char_or_string) << 1;
            }
            self.FormTokenWithChars(Result, CurPtr - 1, unknown);
            return true;
        }
        if C == 0 {
            if self.isCodeCompletionPoint(CurPtr - 1) {
                if self.ParsingFilename {
                    self.codeCompleteIncludedFile(AfterQuote, CurPtr - 1, false);
                } else {
                    self.PP.CodeCompleteNaturalLanguage();
                }
                self.FormTokenWithChars(Result, CurPtr - 1, unknown);
                self.cutOffLexing();
                return true;
            }
            NulCharacter = CurPtr - 1;
        }
        C = self.getAndAdvanceChar(CurPtr, Result);
    }
    if self.LangOpts.CPlusPlus {
        CurPtr = self.LexUDSuffix(Result, CurPtr, true);
    }
    if NulCharacter && !self.isLexingRawMode() {
        self.Diag(NulCharacter, null_in_char_or_string) << 1;
    }
    let mut TokStart: *u8 = self.BufferPtr;
    self.FormTokenWithChars(Result, CurPtr, Kind);
    Result.setLiteralData(TokStart);
    return true;
}

fn Lexer::LexRawStringLiteral(self, Result: *mut Token, CurPtr: *u8, Kind: TokenKind) -> bool {
    if !self.isLexingRawMode() {
        self.Diag(self.BufferPtr, warn_cxx98_compat_raw_string_literal);
    }
    let mut PrefixLen: u32 = 0;
    while PrefixLen != 16 && isRawStringDelimBody(CurPtr[PrefixLen]) {
        if !self.isLexingRawMode() && is_contained(['$', '@', '`'], CurPtr[PrefixLen]) {
            let mut Pos: *u8 = &mut CurPtr[PrefixLen];
            self.DiagCompat(Pos, raw_string_literal_character_set) << Pos[0..1];
        }
        PrefixLen += 1;
    }
    if CurPtr[PrefixLen] != '(' {
        if !self.isLexingRawMode() {
            let mut PrefixEnd: *u8 = &mut CurPtr[PrefixLen];
            if PrefixLen == 16 {
                self.Diag(PrefixEnd, err_raw_delim_too_long);
            } else if *PrefixEnd == 10 {
                self.Diag(PrefixEnd, err_invalid_newline_raw_delim);
            } else {
                self.Diag(PrefixEnd, err_invalid_char_raw_delim) << PrefixEnd[0..1];
            }
        }
        while true {
            let mut C: i8 = *CurPtr += 1;
            if C == '"' {
                break;
            }
            if C == 0 && CurPtr - 1 == self.BufferEnd {
                CurPtr -= 1;
                break;
            }
        }
        self.FormTokenWithChars(Result, CurPtr, unknown);
        return true;
    }
    let mut Prefix: *u8 = CurPtr;
    CurPtr += PrefixLen + 1;
    while true {
        let mut C: i8 = *CurPtr += 1;
        if C == ')' {
            if strncmp(CurPtr, Prefix, PrefixLen) == 0 && CurPtr[PrefixLen] == '"' {
                CurPtr += PrefixLen + 1;
                break;
            }
        } else if C == 0 && CurPtr - 1 == self.BufferEnd {
            if !self.isLexingRawMode() {
                self.Diag(self.BufferPtr, err_unterminated_raw_string) << Prefix[0..PrefixLen];
            }
            self.FormTokenWithChars(Result, CurPtr - 1, unknown);
            return true;
        }
    }
    if self.LangOpts.CPlusPlus {
        CurPtr = self.LexUDSuffix(Result, CurPtr, true);
    }
    let mut TokStart: *u8 = self.BufferPtr;
    self.FormTokenWithChars(Result, CurPtr, Kind);
    Result.setLiteralData(TokStart);
    return true;
}

fn Lexer::LexAngledStringLiteral(self, Result: *mut Token, CurPtr: *u8) -> bool {
    let mut NulCharacter: *u8 = null;
    let mut AfterLessPos: *u8 = CurPtr;
    let mut C: i8 = self.getAndAdvanceChar(CurPtr, Result);
    while C != '>' {
        if C == '\' {
            C = self.getAndAdvanceChar(CurPtr, Result);
        }
        if isVerticalWhitespace(C) || (C == 0 && (CurPtr - 1 == self.BufferEnd)) {
            return false;
        }
        if C == 0 {
            if self.isCodeCompletionPoint(CurPtr - 1) {
                self.codeCompleteIncludedFile(AfterLessPos, CurPtr - 1, true);
                self.cutOffLexing();
                self.FormTokenWithChars(Result, CurPtr - 1, unknown);
                return true;
            }
            NulCharacter = CurPtr - 1;
        }
        C = self.getAndAdvanceChar(CurPtr, Result);
    }
    if NulCharacter && !self.isLexingRawMode() {
        self.Diag(NulCharacter, null_in_char_or_string) << 1;
    }
    let mut TokStart: *u8 = self.BufferPtr;
    self.FormTokenWithChars(Result, CurPtr, header_name);
    Result.setLiteralData(TokStart);
    return true;
}

fn Lexer::codeCompleteIncludedFile(self, PathStart: *u8, CompletionPoint: *u8, IsAngled: bool) {
    let mut PartialPath: str = PathStart[0..CompletionPoint - PathStart];
    let mut SlashChars: str = if self.LangOpts.MSVCCompat { "/\\" } else { "/" };
    let mut Slash: u64 = PartialPath.find_last_of(SlashChars, npos);
    let mut Dir: str = if (Slash == npos) { "" } else { PartialPath.take_front(Slash) };
    let mut StartOfFilename: *u8 = if (Slash == npos) { PathStart } else { PathStart + Slash + 1 };
    self.PP.setCodeCompletionIdentifierInfo(&mut self.PP.getIdentifierTable().get(StartOfFilename[0..CompletionPoint - StartOfFilename]));
    while CompletionPoint < self.BufferEnd {
        let mut Next: i8 = *(CompletionPoint + 1);
        if Next == 0 || Next == 13 || Next == 10 {
            break;
        }
        CompletionPoint += 1;
        if Next == (if IsAngled { '>' } else { '"' }) {
            break;
        }
        if SlashChars.contains(Next) {
            break;
        }
    }
    self.PP.setCodeCompletionTokenRange(self.FileLoc.getLocWithOffset(StartOfFilename - self.BufferStart), self.FileLoc.getLocWithOffset(CompletionPoint - self.BufferStart));
    self.PP.CodeCompleteIncludedFile(Dir, IsAngled);
}

fn Lexer::LexCharConstant(self, Result: *mut Token, CurPtr: *u8, Kind: TokenKind) -> bool {
    let mut NulCharacter: *u8 = null;
    if !self.isLexingRawMode() {
        if Kind == utf16_char_constant || Kind == utf32_char_constant {
            self.Diag(self.BufferPtr, if self.LangOpts.CPlusPlus { warn_cxx98_compat_unicode_literal } else { warn_c99_compat_unicode_literal });
        } else if Kind == utf8_char_constant {
            self.Diag(self.BufferPtr, if self.LangOpts.CPlusPlus { warn_cxx14_compat_u8_character_literal } else { warn_c17_compat_u8_character_literal });
        }
    }
    let mut C: i8 = self.getAndAdvanceChar(CurPtr, Result);
    if C == ''' {
        if !self.isLexingRawMode() && !self.LangOpts.AsmPreprocessor {
            self.Diag(self.BufferPtr, ext_empty_character);
        }
        self.FormTokenWithChars(Result, CurPtr, unknown);
        return true;
    }
    while C != ''' {
        if C == '\' {
            C = self.getAndAdvanceChar(CurPtr, Result);
        }
        if C == 10 || C == 13 || (C == 0 && CurPtr - 1 == self.BufferEnd) {
            if !self.isLexingRawMode() && !self.LangOpts.AsmPreprocessor {
                self.Diag(self.BufferPtr, ext_unterminated_char_or_string) << 0;
            }
            self.FormTokenWithChars(Result, CurPtr - 1, unknown);
            return true;
        }
        if C == 0 {
            if self.isCodeCompletionPoint(CurPtr - 1) {
                self.PP.CodeCompleteNaturalLanguage();
                self.FormTokenWithChars(Result, CurPtr - 1, unknown);
                self.cutOffLexing();
                return true;
            }
            NulCharacter = CurPtr - 1;
        }
        C = self.getAndAdvanceChar(CurPtr, Result);
    }
    if self.LangOpts.CPlusPlus {
        CurPtr = self.LexUDSuffix(Result, CurPtr, false);
    }
    if NulCharacter && !self.isLexingRawMode() {
        self.Diag(NulCharacter, null_in_char_or_string) << 0;
    }
    let mut TokStart: *u8 = self.BufferPtr;
    self.FormTokenWithChars(Result, CurPtr, Kind);
    Result.setLiteralData(TokStart);
    return true;
}

fn Lexer::SkipWhitespace(self, Result: *mut Token, CurPtr: *u8) -> bool {
    let mut SawNewline: bool = isVerticalWhitespace(CurPtr[-1]);
    let mut Char: u8 = *CurPtr;
    let mut lastNewLine: *u8 = null;
    let mut setLastNewLine: Closure_1 = Closure_1 { lastNewLine: &mut lastNewLine, cap_1: self };
    if SawNewline {
        setLastNewLine.call(CurPtr - 1);
    }
    while true {
        while Char == ' ' || isHorizontalWhitespace(Char) {
            Char = *CurPtr += 1;
        }
        if !isVerticalWhitespace(Char) {
            break;
        }
        if self.ParsingPreprocessorDirective {
            self.BufferPtr = CurPtr;
            return false;
        }
        if *CurPtr == 10 {
            setLastNewLine.call(CurPtr);
        }
        SawNewline = true;
        Char = *CurPtr += 1;
    }
    if self.isKeepWhitespaceMode() {
        self.FormTokenWithChars(Result, CurPtr, unknown);
        if SawNewline {
            self.IsAtStartOfLine = true;
            self.IsAtPhysicalStartOfLine = true;
        }
        return true;
    }
    let mut PrevChar: i8 = CurPtr[-1];
    let mut HasLeadingSpace: bool = !isVerticalWhitespace(PrevChar);
    Result.setFlagValue(LeadingSpace, HasLeadingSpace);
    if SawNewline {
        Result.setFlag(StartOfLine);
        Result.setFlag(PhysicalStartOfLine);
        if self.NewLinePtr && lastNewLine && self.NewLinePtr != lastNewLine && self.PP {
            if self.PP.getEmptylineHandler() {
                Handler;
            } else {
                Handler.HandleEmptyline(SourceRange { B: self.getSourceLocation(self.NewLinePtr + 1, 1), E: self.getSourceLocation(lastNewLine, 1) });
            }
        }
    }
    self.BufferPtr = CurPtr;
    return false;
}

fn Lexer::SkipLineComment(self, Result: *mut Token, CurPtr: *u8) -> bool {
    if !self.LineComment {
        if !self.isLexingRawMode() {
            self.Diag(self.BufferPtr, ext_line_comment);
        }
        self.LineComment = true;
    }
    let mut UnicodeDecodingAlreadyDiagnosed: bool = false;
    let mut C: i8 = 0;
    while true {
        C = *CurPtr;
        while isASCII(C) && C != 0 && C != 10 && C != 13 {
            C = *CurPtr += 1;
            UnicodeDecodingAlreadyDiagnosed = false;
        }
        if !isASCII(C) {
            let mut Length: u32 = getUTF8SequenceSize(CurPtr as *UTF8, self.BufferEnd as *UTF8);
            if Length == 0 {
                if !UnicodeDecodingAlreadyDiagnosed && !self.isLexingRawMode() {
                    self.Diag(CurPtr, warn_invalid_utf8_in_comment);
                }
                UnicodeDecodingAlreadyDiagnosed = true;
                CurPtr += 1;
            } else {
                UnicodeDecodingAlreadyDiagnosed = false;
                CurPtr += Length;
            }
            continue;
        }
        let mut NextLine: *u8 = CurPtr;
        if C != 0 {
            let mut EscapePtr: *u8 = CurPtr - 1;
            let mut HasSpace: bool = false;
            while isHorizontalWhitespace(*EscapePtr) {
                EscapePtr -= 1;
                HasSpace = true;
            }
            if *EscapePtr == '\' {
                CurPtr = EscapePtr;
            } else if EscapePtr[0] == '/' && EscapePtr[-1] == '?' && EscapePtr[-2] == '?' && self.LangOpts.Trigraphs {
                CurPtr = EscapePtr - 2;
            } else {
                break;
            }
            if HasSpace && !self.isLexingRawMode() {
                self.Diag(EscapePtr, backslash_newline_space);
            }
        }
        let mut OldPtr: *u8 = CurPtr;
        let mut OldRawMode: bool = self.isLexingRawMode();
        self.LexingRawMode = true;
        C = self.getAndAdvanceChar(CurPtr, Result);
        self.LexingRawMode = OldRawMode;
        if C != 0 && CurPtr == OldPtr + 1 {
            CurPtr = NextLine;
            break;
        }
        if CurPtr != OldPtr + 1 && C != '/' && (CurPtr == self.BufferEnd + 1 || CurPtr[0] != '/') {
            for ; OldPtr != CurPtr; OldPtr += 1 {
                if OldPtr[0] == 10 || OldPtr[0] == 13 {
                    if isWhitespace(C) {
                        let mut ForwardPtr: *u8 = CurPtr;
                        while isWhitespace(*ForwardPtr) {
                            ForwardPtr += 1;
                        }
                        if ForwardPtr[0] == '/' && ForwardPtr[1] == '/' {
                            break;
                        }
                    }
                    if !self.isLexingRawMode() {
                        self.Diag(OldPtr - 1, ext_multi_line_line_comment);
                    }
                    break;
                }
            }
        }
        if C == 13 || C == 10 || CurPtr == self.BufferEnd + 1 {
            CurPtr -= 1;
            break;
        }
        if C == 0 && self.isCodeCompletionPoint(CurPtr - 1) {
            self.PP.CodeCompleteNaturalLanguage();
            self.cutOffLexing();
            return false;
        }
    }
    if self.PP && !self.isLexingRawMode() && self.PP.HandleComment(Result, SourceRange { B: self.getSourceLocation(self.BufferPtr, 1), E: self.getSourceLocation(CurPtr, 1) }) {
        self.BufferPtr = CurPtr;
        return true;
    }
    if self.inKeepCommentMode() {
        return self.SaveLineComment(Result, CurPtr);
    }
    if self.ParsingPreprocessorDirective || CurPtr == self.BufferEnd {
        self.BufferPtr = CurPtr;
        return false;
    }
    self.NewLinePtr = CurPtr += 1;
    Result.setFlag(StartOfLine);
    Result.setFlag(PhysicalStartOfLine);
    Result.clearFlag(LeadingSpace);
    self.BufferPtr = CurPtr;
    return false;
}

fn Lexer::SaveLineComment(self, Result: *mut Token, CurPtr: *u8) -> bool {
    self.FormTokenWithChars(Result, CurPtr, comment);
    if !self.ParsingPreprocessorDirective || self.LexingRawMode {
        return true;
    }
    let mut Invalid: bool = false;
    let mut Spelling: str = self.PP.getSpelling(Result, &mut Invalid);
    if Invalid {
        return true;
    }
    assert!(Spelling[0] == '/' && Spelling[1] == '/', "Not line comment?");
    Spelling[1] = '*';
    operator(Spelling, "*/");
    Result.setKind(comment);
    self.PP.CreateString(Spelling, Result, Result.getLocation(), Result.getLocation());
    return true;
}

fn isEndOfBlockCommentWithEscapedNewLine(CurPtr: *u8, L: *mut Lexer, Trigraphs: bool) -> bool {
    assert!(CurPtr[0] == 10 || CurPtr[0] == 13);
    let mut TrigraphPos: *u8 = null;
    let mut SpacePos: *u8 = null;
    while true {
        CurPtr -= 1;
        if CurPtr[0] == 10 || CurPtr[0] == 13 {
            if CurPtr[0] == CurPtr[1] {
                return false;
            }
            CurPtr -= 1;
        }
        while isHorizontalWhitespace(*CurPtr) || *CurPtr == 0 {
            SpacePos = CurPtr;
            CurPtr -= 1;
        }
        if *CurPtr == '\' {
            CurPtr -= 1;
        } else if CurPtr[0] == '/' && CurPtr[-1] == '?' && CurPtr[-2] == '?' {
            TrigraphPos = CurPtr - 2;
            CurPtr -= 3;
        } else {
            return false;
        }
        if *CurPtr == '*' {
            break;
        }
        if *CurPtr != 10 && *CurPtr != 13 {
            return false;
        }
    }
    if TrigraphPos {
        if !Trigraphs {
            if !L.isLexingRawMode() {
                L.Diag(TrigraphPos, trigraph_ignored_block_comment);
            }
            return false;
        }
        if !L.isLexingRawMode() {
            L.Diag(TrigraphPos, trigraph_ends_block_comment);
        }
    }
    if !L.isLexingRawMode() {
        L.Diag(CurPtr + 1, escaped_newline_block_comment_end);
    }
    if SpacePos && !L.isLexingRawMode() {
        L.Diag(SpacePos, backslash_newline_space);
    }
    return true;
}

fn Lexer::SkipBlockComment(self, Result: *mut Token, CurPtr: *u8) -> bool {
    let mut CharSize: u32 = 0;
    let mut C: u8 = self.getCharAndSize(CurPtr, CharSize);
    CurPtr += CharSize;
    if C == 0 && CurPtr == self.BufferEnd + 1 {
        if !self.isLexingRawMode() {
            self.Diag(self.BufferPtr, err_unterminated_block_comment);
        }
        CurPtr -= 1;
        if self.isKeepWhitespaceMode() {
            self.FormTokenWithChars(Result, CurPtr, unknown);
            return true;
        }
        self.BufferPtr = CurPtr;
        return false;
    }
    if C == '/' {
        C = *CurPtr += 1;
    }
    let mut UnicodeDecodingAlreadyDiagnosed: bool = false;
    while true {
        if CurPtr + 24 < self.BufferEnd && !(self.PP && self.PP.getCodeCompletionFileLoc() == self.FileLoc) {
            while C != '/' && CurPtr as i64 % 16 != 0 {
                if !isASCII(C) {
                    
                }
                C = *CurPtr += 1;
            }
            if C == '/' {
                
            }
            let mut Slashes: __m128i = _mm_set1_epi8('/');
            while CurPtr + 16 < self.BufferEnd {
                let mut Mask: i32 = _mm_movemask_epi8(*CurPtr as *__m128i);
                if __builtin_expect((Mask != 0) as bool, false) {}
                let mut cmp: i32 = _mm_movemask_epi8(_mm_cmpeq_epi8(*CurPtr as *__m128i, Slashes));
                if cmp != 0 {
                    CurPtr += countr_zero(cmp) + 1;
                }
                CurPtr += 16;
            }
            C = *CurPtr += 1;
        }
        while C != '/' && C != 0 {
            if isASCII(C) {
                UnicodeDecodingAlreadyDiagnosed = false;
                C = *CurPtr += 1;
                continue;
            }
            getUTF8SequenceSize(CurPtr as *UTF8 - 1, self.BufferEnd as *UTF8);
            if Length == 0 {
                if !UnicodeDecodingAlreadyDiagnosed && !self.isLexingRawMode() {
                    self.Diag(CurPtr - 1, warn_invalid_utf8_in_comment);
                }
                UnicodeDecodingAlreadyDiagnosed = true;
            } else {
                UnicodeDecodingAlreadyDiagnosed = false;
                CurPtr += Length - 1;
            }
            C = *CurPtr += 1;
        }
        if C == '/' {
            CurPtr[-2] == '*';
            if (CurPtr[-2] == 10 || CurPtr[-2] == 13) {
                if isEndOfBlockCommentWithEscapedNewLine(CurPtr - 2, self, self.LangOpts.Trigraphs) {
                    break;
                }
            }
            if CurPtr[0] == '*' && CurPtr[1] != '/' {
                if !self.isLexingRawMode() {
                    self.Diag(CurPtr - 1, warn_nested_block_comment);
                }
            }
        } else if C == 0 && CurPtr == self.BufferEnd + 1 {
            if !self.isLexingRawMode() {
                self.Diag(self.BufferPtr, err_unterminated_block_comment);
            }
            CurPtr -= 1;
            if self.isKeepWhitespaceMode() {
                self.FormTokenWithChars(Result, CurPtr, unknown);
                return true;
            }
            self.BufferPtr = CurPtr;
            return false;
        } else if C == 0 && self.isCodeCompletionPoint(CurPtr - 1) {
            self.PP.CodeCompleteNaturalLanguage();
            self.cutOffLexing();
            return false;
        }
        C = *CurPtr += 1;
    }
    if self.PP && !self.isLexingRawMode() && self.PP.HandleComment(Result, SourceRange { B: self.getSourceLocation(self.BufferPtr, 1), E: self.getSourceLocation(CurPtr, 1) }) {
        self.BufferPtr = CurPtr;
        return true;
    }
    if self.inKeepCommentMode() {
        self.FormTokenWithChars(Result, CurPtr, comment);
        self.IsAtPhysicalStartOfLine = Result.isAtPhysicalStartOfLine();
        return true;
    }
    if isHorizontalWhitespace(*CurPtr) {
        self.SkipWhitespace(Result, CurPtr + 1);
        return false;
    }
    self.BufferPtr = CurPtr;
    Result.setFlag(LeadingSpace);
    return false;
}

fn Lexer::ReadToEndOfLine(self, Result: *mut SmallVectorImpl<char>) {
    assert!(self.ParsingPreprocessorDirective && self.ParsingFilename == false, "Must be in a preprocessing directive!");
    let mut Tmp: Token = Token {};
    Tmp.startToken();
    let mut CurPtr: *u8 = self.BufferPtr;
    while true {
        let mut Char: i8 = self.getAndAdvanceChar(CurPtr, Tmp);
        match Char {
            _ => {
                if Result {
                    Result.push(Char);
                }
            },
            0 => {
                if CurPtr - 1 != self.BufferEnd {
                    if self.isCodeCompletionPoint(CurPtr - 1) {
                        self.PP.CodeCompleteNaturalLanguage();
                        self.cutOffLexing();
                        return;
                    }
                    if Result {
                        Result.push(Char);
                    }
                    break;
                }
            },
            13 => {
                10;
            },
        }
    }
}

fn Lexer::LexEndOfFile(self, Result: *mut Token, CurPtr: *u8) -> bool {
    if self.ParsingPreprocessorDirective {
        self.ParsingPreprocessorDirective = false;
        self.FormTokenWithChars(Result, CurPtr, eod);
        if self.PP {
            self.resetExtendedTokenMode();
        }
        return true;
    }
    if self.isLexingRawMode() {
        Result.startToken();
        self.BufferPtr = self.BufferEnd;
        self.FormTokenWithChars(Result, self.BufferEnd, eof);
        return true;
    }
    if self.PP.isRecordingPreamble() && self.PP.isInPrimaryFile() {
        self.PP.setRecordedPreambleConditionalStack(self.ConditionalStack);
        if !self.ConditionalStack.is_empty() {
            self.MIOpt.ExitTopLevelConditional();
        }
        self.ConditionalStack.clear();
    }
    while !self.ConditionalStack.is_empty() {
        if self.PP.getCodeCompletionFileLoc() != self.FileLoc {
            self.PP.Diag(self.ConditionalStack.back().IfLoc, err_pp_unterminated_conditional);
        }
        self.ConditionalStack.pop();
    }
    if CurPtr != self.BufferStart && (CurPtr[-1] != 10 && CurPtr[-1] != 13) {
        self.Diag(self.BufferEnd, warn_no_newline_eof) << CreateInsertion(self.getSourceLocation(self.BufferEnd, 1), "\n", false);
    }
    self.BufferPtr = CurPtr;
    return self.PP.HandleEndOfFile(Result, self.isPragmaLexer());
}

fn Lexer::peekNextPPToken(self) -> optional<Token> {
    assert!(!self.LexingRawMode, "How can we expand a macro from a skipping buffer?");
    if self.isDependencyDirectivesLexer() {
        if self.NextDepDirectiveTokenIndex == self.DepDirectives.front().Tokens.len {
            return nullopt;
        }
        let mut Result: Token = Token {};
        self.convertDependencyDirectiveToken(self.DepDirectives.front().Tokens[self.NextDepDirectiveTokenIndex], Result) as void;
        return Result;
    }
    self.LexingRawMode = true;
    let mut TmpBufferPtr: *u8 = self.BufferPtr;
    let mut inPPDirectiveMode: bool = self.ParsingPreprocessorDirective;
    let mut atStartOfLine: bool = self.IsAtStartOfLine;
    let mut atPhysicalStartOfLine: bool = self.IsAtPhysicalStartOfLine;
    let mut leadingSpace: bool = self.HasLeadingSpace;
    let mut MIOptState: MultipleIncludeOpt = self.MIOpt;
    let mut Tok: Token = Token {};
    self.Lex(Tok);
    self.BufferPtr = TmpBufferPtr;
    self.ParsingPreprocessorDirective = inPPDirectiveMode;
    self.HasLeadingSpace = leadingSpace;
    self.IsAtStartOfLine = atStartOfLine;
    self.IsAtPhysicalStartOfLine = atPhysicalStartOfLine;
    self.MIOpt = MIOptState;
    self.LexingRawMode = false;
    if Tok.is(eof) {
        return nullopt;
    }
    return Tok;
}

fn FindConflictEnd(CurPtr: *u8, BufferEnd: *u8, CMK: ConflictMarkerKind) -> *u8 {
    let mut Terminator: *u8 = if CMK == CMK_Perforce { "<<<<\n" } else { ">>>>>>>" };
    let mut TermLen: u64 = if CMK == CMK_Perforce { 5 } else { 7 };
    let mut RestOfBuffer: str = CurPtr[0..BufferEnd - CurPtr][TermLen..TermLen + npos];
    let mut Pos: u64 = RestOfBuffer.find(Terminator, 0);
    while Pos != npos {
        if Pos == 0 || (RestOfBuffer[Pos - 1] != 13 && RestOfBuffer[Pos - 1] != 10) {
            RestOfBuffer = RestOfBuffer[Pos + TermLen..Pos + TermLen + npos];
            Pos = RestOfBuffer.find(Terminator, 0);
            continue;
        }
        return RestOfBuffer.ptr + Pos;
    }
    return null;
}

fn Lexer::IsStartOfConflictMarker(self, CurPtr: *u8) -> bool {
    if CurPtr != self.BufferStart && CurPtr[-1] != 10 && CurPtr[-1] != 13 {
        return false;
    }
    if !CurPtr[0..self.BufferEnd - CurPtr].starts_with("<<<<<<<") && !CurPtr[0..self.BufferEnd - CurPtr].starts_with(">>>> ") {
        return false;
    }
    if self.CurrentConflictMarkerState || self.isLexingRawMode() {
        return false;
    }
    let mut Kind: ConflictMarkerKind = if *CurPtr == '<' { CMK_Normal } else { CMK_Perforce };
    if FindConflictEnd(CurPtr, self.BufferEnd, Kind) {
        self.Diag(CurPtr, err_conflict_marker);
        self.CurrentConflictMarkerState = Kind;
        while *CurPtr != 13 && *CurPtr != 10 {
            assert!(CurPtr != self.BufferEnd, "Didn't find end of line");
            CurPtr += 1;
        }
        self.BufferPtr = CurPtr;
        return true;
    }
    return false;
}

fn Lexer::HandleEndOfConflictMarker(self, CurPtr: *u8) -> bool {
    if CurPtr != self.BufferStart && CurPtr[-1] != 10 && CurPtr[-1] != 13 {
        return false;
    }
    if !self.CurrentConflictMarkerState || self.isLexingRawMode() {
        return false;
    }
    for let mut i: u32 = 1; i != 4; i += 1 {
        if CurPtr[i] != CurPtr[0] {
            return false;
        }
    }
    if FindConflictEnd(CurPtr, self.BufferEnd, self.CurrentConflictMarkerState) {
        End;
    } else {
        CurPtr = End;
        while CurPtr != self.BufferEnd && *CurPtr != 13 && *CurPtr != 10 {
            CurPtr += 1;
        }
        self.BufferPtr = CurPtr;
        self.CurrentConflictMarkerState = CMK_None;
        return true;
    }
    return false;
}

fn findPlaceholderEnd(CurPtr: *u8, BufferEnd: *u8) -> *u8 {
    if CurPtr == BufferEnd {
        return null;
    }
    BufferEnd -= 1;
    for ; CurPtr != BufferEnd; CurPtr += 1 {
        if CurPtr[0] == '#' && CurPtr[1] == '>' {
            return CurPtr + 2;
        }
    }
    return null;
}

fn Lexer::lexEditorPlaceholder(self, Result: *mut Token, CurPtr: *u8) -> bool {
    assert!(CurPtr[-1] == '<' && CurPtr[0] == '#', "Not a placeholder!");
    if !self.PP || !self.PP.getPreprocessorOpts().LexEditorPlaceholders || self.LexingRawMode {
        return false;
    }
    let mut End: *u8 = findPlaceholderEnd(CurPtr + 1, self.BufferEnd);
    if !End {
        return false;
    }
    let mut Start: *u8 = CurPtr - 1;
    if !self.LangOpts.AllowEditorPlaceholders {
        self.Diag(Start, err_placeholder_in_source);
    }
    Result.startToken();
    self.FormTokenWithChars(Result, End, raw_identifier);
    Result.setRawIdentifierData(Start);
    self.PP.LookUpIdentifierInfo(Result);
    Result.setFlag(IsEditorPlaceholder);
    self.BufferPtr = End;
    return true;
}

fn Lexer::isCodeCompletionPoint(self: *Lexer, CurPtr: *u8) -> bool {
    if self.PP && self.PP.isCodeCompletionEnabled() {
        let mut Loc: SourceLocation = self.FileLoc.getLocWithOffset(CurPtr - self.BufferStart);
        return Loc == self.PP.getCodeCompletionLoc();
    }
    return false;
}

fn Lexer::DiagnoseDelimitedOrNamedEscapeSequence(self, Loc: SourceLocation, Named: bool, Opts: *LangOptions, Diags: *mut DiagnosticsEngine) {
    let mut DiagId: u32 = 0;
    if Opts.CPlusPlus23 {
        DiagId = warn_cxx23_delimited_escape_sequence;
    } else if Opts.C2y && !Named {
        DiagId = warn_c2y_delimited_escape_sequence;
    } else {
        DiagId = ext_delimited_escape_sequence;
    }
    let mut Ext: u32 = 0;
    if !Opts.CPlusPlus {
        Ext = if Named { 2 } else { 1 };
    } else {
        Ext = 0;
    }
    Diags.Report(Loc, DiagId) << Named << Ext;
}

fn Lexer::tryReadNumericUCN(self, StartPtr: **mut u8, SlashLoc: *u8, Result: *mut Token) -> optional<uint32_t> {
    let mut CharSize: u32 = 0;
    let mut Kind: i8 = self.getCharAndSize(StartPtr, CharSize);
    assert!((Kind == 'u' || Kind == 'U'), "expected a UCN");
    let mut NumHexDigits: u32 = 0;
    if Kind == 'u' {
        NumHexDigits = 4;
    } else if Kind == 'U' {
        NumHexDigits = 8;
    }
    let mut Delimited: bool = false;
    let mut FoundEndDelimiter: bool = false;
    let mut Count: u32 = 0;
    let mut Diagnose: bool = Result && !self.isLexingRawMode();
    if !self.LangOpts.CPlusPlus && !self.LangOpts.C99 {
        if Diagnose {
            self.Diag(SlashLoc, warn_ucn_not_valid_in_c89);
        }
        return nullopt;
    }
    let mut CurPtr: *u8 = StartPtr + CharSize;
    let mut KindLoc: *u8 = &mut CurPtr[-1];
    let mut CodePoint: u32 = 0;
    while Count != NumHexDigits || Delimited {
        let mut C: i8 = self.getCharAndSize(CurPtr, CharSize);
        if !Delimited && Count == 0 && C == '{' {
            Delimited = true;
            CurPtr += CharSize;
            continue;
        }
        if Delimited && C == '}' {
            CurPtr += CharSize;
            FoundEndDelimiter = true;
            break;
        }
        let mut Value: u32 = hexDigitValue(C);
        if Value == max() {
            if !Delimited {
                break;
            }
            if Diagnose {
                self.Diag(SlashLoc, warn_delimited_ucn_incomplete) << KindLoc[0..1];
            }
            return nullopt;
        }
        if CodePoint & 4026531840 {
            if Diagnose {
                self.Diag(KindLoc, err_escape_too_large) << 0;
            }
            return nullopt;
        }
        CodePoint <<= 4;
        CodePoint |= Value;
        CurPtr += CharSize;
        Count += 1;
    }
    if Count == 0 {
        if Diagnose {
            self.Diag(SlashLoc, if FoundEndDelimiter { warn_delimited_ucn_empty } else { warn_ucn_escape_no_digits }) << KindLoc[0..1];
        }
        return nullopt;
    }
    if Delimited && Kind == 'U' {
        if Diagnose {
            self.Diag(SlashLoc, err_hex_escape_no_digits) << KindLoc[0..1];
        }
        return nullopt;
    }
    if !Delimited && Count != NumHexDigits {
        if Diagnose {
            self.Diag(SlashLoc, warn_ucn_escape_incomplete);
            if Count == 4 && NumHexDigits == 8 {
                let mut URange: CharSourceRange = makeCharRange(*self, KindLoc, KindLoc + 1);
                self.Diag(KindLoc, note_ucn_four_not_eight) << CreateReplacement(URange, "u");
            }
        }
        return nullopt;
    }
    if Delimited && self.PP {
        DiagnoseDelimitedOrNamedEscapeSequence(self.getSourceLocation(SlashLoc, 1), false, self.PP.getLangOpts(), self.PP.getDiagnostics());
    }
    if Result {
        Result.setFlag(HasUCN);
        if CurPtr - StartPtr == (Count + 1 + (if Delimited { 2 } else { 0 })) as ptrdiff_t {
            StartPtr = CurPtr;
        } else {
            while StartPtr != CurPtr {
                self.getAndAdvanceChar(StartPtr, *Result) as void;
            }
        }
    } else {
        StartPtr = CurPtr;
    }
    return CodePoint;
}

fn Lexer::tryReadNamedUCN(self, StartPtr: **mut u8, SlashLoc: *u8, Result: *mut Token) -> optional<uint32_t> {
    let mut CharSize: u32 = 0;
    let mut Diagnose: bool = Result && !self.isLexingRawMode();
    let mut C: i8 = self.getCharAndSize(StartPtr, CharSize);
    assert!(C == 'N', "expected \\N{...}");
    let mut CurPtr: *u8 = StartPtr + CharSize;
    let mut KindLoc: *u8 = &mut CurPtr[-1];
    C = self.getCharAndSize(CurPtr, CharSize);
    if C != '{' {
        if Diagnose {
            self.Diag(SlashLoc, warn_ucn_escape_incomplete);
        }
        return nullopt;
    }
    CurPtr += CharSize;
    let mut StartName: *u8 = CurPtr;
    let mut FoundEndDelimiter: bool = false;
    let mut Buffer: SmallVector<char, 30> = SmallVector<char, 30> {};
    while C {
        C = self.getCharAndSize(CurPtr, CharSize);
        CurPtr += CharSize;
        if C == '}' {
            FoundEndDelimiter = true;
            break;
        }
        if isVerticalWhitespace(C) {
            break;
        }
        Buffer.push(C);
    }
    if !FoundEndDelimiter || Buffer.is_empty() {
        if Diagnose {
            self.Diag(SlashLoc, if FoundEndDelimiter { warn_delimited_ucn_empty } else { warn_delimited_ucn_incomplete }) << KindLoc[0..1];
        }
        return nullopt;
    }
    let mut Name: str = Buffer.ptr[0..Buffer.len];
    let mut Match: optional<char32_t> = nameToCodepointStrict(Name);
    let mut LooseMatch: LooseMatchingResult> = LooseMatchingResult> {};
    if !Match {
        LooseMatch = nameToCodepointLooseMatching(Name);
        if Diagnose {
            self.Diag(StartName, err_invalid_ucn_name) << Buffer.ptr[0..Buffer.len] << makeCharRange(*self, StartName, CurPtr - CharSize);
            if LooseMatch {
                self.Diag(StartName, note_invalid_ucn_name_loose_matching) << CreateReplacement(makeCharRange(*self, StartName, CurPtr - CharSize), operator(LooseMatch).Name.operator StringRef());
            }
        }
    }
    if Diagnose && Match {
        DiagnoseDelimitedOrNamedEscapeSequence(self.getSourceLocation(SlashLoc, 1), true, self.PP.getLangOpts(), self.PP.getDiagnostics());
    }
    if LooseMatch && Diagnose {
        Match = operator(LooseMatch).CodePoint;
    }
    if Result {
        Result.setFlag(HasUCN);
        if CurPtr - StartPtr == (Buffer.len + 3) as ptrdiff_t {
            StartPtr = CurPtr;
        } else {
            while StartPtr != CurPtr {
                self.getAndAdvanceChar(StartPtr, *Result) as void;
            }
        }
    } else {
        StartPtr = CurPtr;
    }
    return if Match { operator(Match) } else { nullopt };
}

fn Lexer::tryReadUCN(self, StartPtr: **mut u8, SlashLoc: *u8, Result: *mut Token) -> u32 {
    let mut CharSize: u32 = 0;
    let mut CodePointOpt: optional<uint32_t> = optional<uint32_t> {};
    let mut Kind: i8 = self.getCharAndSize(StartPtr, CharSize);
    if Kind == 'u' || Kind == 'U' {
        CodePointOpt = self.tryReadNumericUCN(StartPtr, SlashLoc, Result);
    } else if Kind == 'N' {
        CodePointOpt = self.tryReadNamedUCN(StartPtr, SlashLoc, Result);
    }
    if !CodePointOpt {
        return 0;
    }
    let mut CodePoint: u32 = operator(CodePointOpt);
    if self.LangOpts.AsmPreprocessor {
        return CodePoint;
    }
    if CodePoint < 160 {
        if Result && self.PP {
            if CodePoint < 32 || CodePoint >= 127 {
                self.Diag(self.BufferPtr, err_ucn_control_character);
            } else {
                let mut C: i8 = CodePoint as i8;
                self.Diag(self.BufferPtr, err_ucn_escape_basic_scs) << &mut C[0..1];
            }
        }
        return 0;
    } else if CodePoint >= 55296 && CodePoint <= 57343 {
        if Result && self.PP {
            if self.LangOpts.CPlusPlus && !self.LangOpts.CPlusPlus11 {
                self.Diag(self.BufferPtr, warn_ucn_escape_surrogate);
            } else {
                self.Diag(self.BufferPtr, err_ucn_escape_invalid);
            }
        }
        return 0;
    }
    return CodePoint;
}

fn Lexer::CheckUnicodeWhitespace(self, Result: *mut Token, C: u32, CurPtr: *u8) -> bool {
    if !self.isLexingRawMode() && !self.PP.isPreprocessedOutput() && isUnicodeWhitespace(C) {
        self.Diag(self.BufferPtr, ext_unicode_whitespace) << EscapeSingleCodepointForDiagnostic(C) << makeCharRange(*self, self.BufferPtr, CurPtr);
        Result.setFlag(LeadingSpace);
        return true;
    }
    return false;
}

fn Lexer::PropagateLineStartLeadingSpaceInfo(self, Result: *mut Token) {
    self.IsAtStartOfLine = Result.isAtStartOfLine();
    self.HasLeadingSpace = Result.hasLeadingSpace();
    self.HasLeadingEmptyMacro = Result.hasLeadingEmptyMacro();
}

fn Lexer::Lex(self, Result: *mut Token) -> bool {
    assert!(!self.isDependencyDirectivesLexer();
    Result.startToken();
    if self.IsAtStartOfLine {
        Result.setFlag(StartOfLine);
        self.IsAtStartOfLine = false;
    }
    if self.IsAtPhysicalStartOfLine {
        Result.setFlag(PhysicalStartOfLine);
        self.IsAtPhysicalStartOfLine = false;
    }
    if self.HasLeadingSpace {
        Result.setFlag(LeadingSpace);
        self.HasLeadingSpace = false;
    }
    if self.HasLeadingEmptyMacro {
        Result.setFlag(LeadingEmptyMacro);
        self.HasLeadingEmptyMacro = false;
    }
    let mut isRawLex: bool = self.isLexingRawMode();
    isRawLex as void;
    let mut returnedToken: bool = self.LexTokenInternal(Result);
    assert!((returnedToken || !isRawLex), "Raw lex must succeed");
    return returnedToken;
}

fn Lexer::LexTokenInternal(self, Result: *mut Token) -> bool {
    assert!(!Result.needsCleaning(), "Result needs cleaning");
    assert!(!Result.hasPtrData(), "Result has not been reset");
    let mut CurPtr: *u8 = self.BufferPtr;
    if *CurPtr == ' ' || isHorizontalWhitespace(*CurPtr) {
        while true {
            {
            CurPtr += 1;
        }
            if !(*CurPtr == ' ' || isHorizontalWhitespace(*CurPtr)) { break; }
        }
        if self.isKeepWhitespaceMode() {
            self.FormTokenWithChars(Result, CurPtr, unknown);
            return true;
        }
        self.BufferPtr = CurPtr;
        Result.setFlag(LeadingSpace);
    }
    let mut SizeTmp: u32 = 0;
    let mut SizeTmp2: u32 = 0;
    let mut Char: i8 = self.getAndAdvanceChar(CurPtr, Result);
    let mut Kind: TokenKind = zeroed();
    if !isVerticalWhitespace(Char) {
        self.NewLinePtr = null;
    }
    match Char {
        0 => {
            if CurPtr - 1 == self.BufferEnd {
                return self.LexEndOfFile(Result, CurPtr - 1);
            }
        },
        26 => {
            if self.LangOpts.MicrosoftExt {
                if !self.isLexingRawMode() {
                    self.Diag(CurPtr - 1, ext_ctrl_z_eof_microsoft);
                }
                return self.LexEndOfFile(Result, CurPtr - 1);
            }
        },
        13 => {
            if CurPtr[0] == 10 {
                self.getAndAdvanceChar(CurPtr, Result) as void;
            }
        },
        10 => {
            if self.ParsingPreprocessorDirective {
                self.ParsingPreprocessorDirective = false;
                if self.PP {
                    self.resetExtendedTokenMode();
                }
                self.IsAtStartOfLine = true;
                self.IsAtPhysicalStartOfLine = true;
                self.NewLinePtr = CurPtr - 1;
                Kind = eod;
                break;
            }
        },
        ' ' => {
            9;
        },
        '0' => {
            '1';
        },
        'u' => {
            self.MIOpt.ReadToken();
        },
        'U' => {
            self.MIOpt.ReadToken();
        },
        'R' => {
            self.MIOpt.ReadToken();
        },
        'L' => {
            self.MIOpt.ReadToken();
        },
        'A' => {
            'B';
        },
        '$' => {
            if self.LangOpts.DollarIdents {
                if !self.isLexingRawMode() {
                    self.Diag(CurPtr - 1, ext_dollar_in_identifier);
                }
                self.MIOpt.ReadToken();
                return self.LexIdentifierContinue(Result, CurPtr);
            }
        },
        ''' => {
            self.MIOpt.ReadToken();
        },
        '"' => {
            self.MIOpt.ReadToken();
        },
        '?' => {
            Kind = question;
        },
        '[' => {
            Kind = l_square;
        },
        ']' => {
            Kind = r_square;
        },
        '(' => {
            Kind = l_paren;
        },
        ')' => {
            Kind = r_paren;
        },
        '{' => {
            Kind = l_brace;
        },
        '}' => {
            Kind = r_brace;
        },
        '.' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '&' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '*' => {
            if self.getCharAndSize(CurPtr, SizeTmp) == '=' {
                Kind = starequal;
                CurPtr = self.ConsumeChar(CurPtr, SizeTmp, Result);
            } else {
                Kind = star;
            }
        },
        '+' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '-' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '~' => {
            Kind = tilde;
        },
        '!' => {
            if self.getCharAndSize(CurPtr, SizeTmp) == '=' {
                Kind = exclaimequal;
                CurPtr = self.ConsumeChar(CurPtr, SizeTmp, Result);
            } else {
                Kind = exclaim;
            }
        },
        '/' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '%' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '<' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '>' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '^' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '|' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        ':' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        ';' => {
            Kind = semi;
        },
        '=' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        ',' => {
            Kind = comma;
        },
        '#' => {
            Char = self.getCharAndSize(CurPtr, SizeTmp);
        },
        '@' => {
            if CurPtr[-1] == '@' && self.LangOpts.ObjC {
                self.FormTokenWithChars(Result, CurPtr, at);
                if self.PP && Result.isAtPhysicalStartOfLine() && !self.LexingRawMode && !self.Is_PragmaLexer {
                    let mut NextPPTok: Token = Token {};
                    NextPPTok.startToken();
                    {
                        let mut SavedParsingPreprocessorDirective: SaveAndRestore<bool> = SaveAndRestore<bool> { self.ParsingPreprocessorDirective, true };
                        let mut NextTokOr: optional<Token> = self.peekNextPPToken();
                        if NextTokOr.has_value() {
                            NextPPTok = operator(NextTokOr);
                        }
                    }
                    if NextPPTok.is(raw_identifier) && NextPPTok.getRawIdentifier() == "import" {
                        self.PP.HandleDirective(Result);
                        return false;
                    }
                }
                return true;
            } else {
                Kind = unknown;
            }
        },
        '\' => {
            if !self.LangOpts.AsmPreprocessor {
                if self.tryReadUCN(CurPtr, self.BufferPtr, &mut Result) {
                    CodePoint;
                } else {
                    if self.CheckUnicodeWhitespace(Result, CodePoint, CurPtr) {
                        if self.SkipWhitespace(Result, CurPtr) {
                            return true;
                        }
                    }
                    return self.LexUnicodeIdentifierStart(Result, CodePoint, CurPtr);
                }
            }
        },
        _ => {
            if isASCII(Char) {
                Kind = unknown;
                break;
            }
            let mut CodePoint: UTF32 = zeroed();
            CurPtr -= 1;
            let mut Status: ConversionResult = convertUTF8Sequence(&mut CurPtr as **mut UTF8, self.BufferEnd as *UTF8, &mut CodePoint, strictConversion);
            if Status == conversionOK {
                if self.CheckUnicodeWhitespace(Result, CodePoint, CurPtr) {
                    if self.SkipWhitespace(Result, CurPtr) {
                        return true;
                    }
                }
                return self.LexUnicodeIdentifierStart(Result, CodePoint, CurPtr);
            }
            if self.isLexingRawMode() || self.ParsingPreprocessorDirective || self.PP.isPreprocessedOutput() {
                CurPtr += 1;
                Kind = unknown;
                break;
            }
            self.Diag(CurPtr, err_invalid_utf8);
            self.BufferPtr = CurPtr + 1;
        },
    }
    self.MIOpt.ReadToken();
    self.FormTokenWithChars(Result, CurPtr, Kind);
    return true;
    self.FormTokenWithChars(Result, CurPtr, hash);
    self.PP.HandleDirective(Result);
    if self.PP.hadModuleLoaderFatalFailure() {
        return true;
    }
    return false;
    Result.clearFlag(NeedsCleaning);
}

fn Lexer::convertDependencyDirectiveToken(self, DDTok: *Token, Result: *mut Token) -> *u8 {
    let mut TokPtr: *u8 = self.BufferStart + DDTok.Offset;
    Result.startToken();
    Result.setLocation(self.getSourceLocation(TokPtr, 1));
    Result.setKind(DDTok.Kind);
    Result.setFlag(DDTok.Flags as TokenFlags);
    Result.setLength(DDTok.Length);
    if Result.is(raw_identifier) {
        Result.setRawIdentifierData(TokPtr);
    } else if Result.isLiteral() {
        Result.setLiteralData(TokPtr);
    }
    self.BufferPtr = TokPtr + DDTok.Length;
    return TokPtr;
}

fn Lexer::LexDependencyDirectiveToken(self, Result: *mut Token) -> bool {
    assert!(self.isDependencyDirectivesLexer();
    if self.BufferPtr == self.BufferEnd {
        return self.LexEndOfFile(Result, self.BufferPtr);
    }
    while self.NextDepDirectiveTokenIndex == self.DepDirectives.front().Tokens.len {
        if self.DepDirectives.front().Kind == pp_eof {
            return self.LexEndOfFile(Result, self.BufferEnd);
        }
        if self.DepDirectives.front().Kind == tokens_present_before_eof {
            self.MIOpt.ReadToken();
        }
        self.NextDepDirectiveTokenIndex = 0;
        self.DepDirectives = self.DepDirectives.drop_front(1);
    }
    let mut DDTok: *Token = self.DepDirectives.front().Tokens[self.NextDepDirectiveTokenIndex += 1];
    if self.NextDepDirectiveTokenIndex > 1 || DDTok.Kind != hash {
        self.MIOpt.ReadToken();
    }
    let mut DDTokPtr: *u8 = self.BufferStart + DDTok.Offset;
    if self.ParsingFilename && *DDTokPtr == '<' {
        Result.startToken();
        Result.setFlag(DDTok.Flags as TokenFlags);
        Result.clearFlag(NeedsCleaning);
        self.BufferPtr = DDTokPtr;
        if !self.LexAngledStringLiteral(Result, self.BufferPtr + 1) {
            self.convertDependencyDirectiveToken(DDTok, Result);
            return true;
        }
        while true {
            let mut NextTok: *Token = self.DepDirectives.front().Tokens[self.NextDepDirectiveTokenIndex];
            if self.BufferStart + NextTok.Offset >= self.BufferPtr {
                break;
            }
            self.NextDepDirectiveTokenIndex += 1;
        }
        return true;
    }
    let mut TokPtr: *u8 = self.convertDependencyDirectiveToken(DDTok, Result);
    if Result.is(hash) && Result.isAtStartOfLine() {
        self.PP.HandleDirective(Result);
        if self.PP.hadModuleLoaderFatalFailure() {
            return true;
        }
        return false;
    }
    if Result.is(at) && Result.isAtStartOfLine() {
        let mut NextTok: optional<Token> = self.peekNextPPToken();
        if NextTok && operator(NextTok).is(raw_identifier) && operator(NextTok).getRawIdentifier() == "import" {
            self.PP.HandleDirective(Result);
            if self.PP.hadModuleLoaderFatalFailure() {
                return true;
            }
            return false;
        }
    }
    if Result.is(raw_identifier) {
        Result.setRawIdentifierData(TokPtr);
        if !self.isLexingRawMode() {
            let mut II: *IdentifierInfo = self.PP.LookUpIdentifierInfo(Result);
            if self.LangOpts.CPlusPlusModules && Result.isModuleContextualKeyword(true) && self.PP.HandleModuleContextualKeyword(Result) {
                self.PP.HandleDirective(Result);
                return false;
            }
            if II.isHandleIdentifierCase() {
                return self.PP.HandleIdentifier(Result);
            }
        }
        return true;
    }
    if Result.isLiteral() {
        return true;
    }
    if Result.is(colon) {
        if *self.BufferPtr == ':' {
            assert!(self.DepDirectives.front().Tokens[self.NextDepDirectiveTokenIndex].is(colon);
            self.NextDepDirectiveTokenIndex += 1;
            Result.setKind(coloncolon);
        }
        return true;
    }
    if Result.is(eod) {
        self.ParsingPreprocessorDirective = false;
    }
    return true;
}

fn Lexer::LexDependencyDirectiveTokenWhileSkipping(self, Result: *mut Token) -> bool {
    assert!(self.isDependencyDirectivesLexer();
    let mut Stop: bool = false;
    let mut NestedIfs: u32 = 0;
    while true {
        {
        self.DepDirectives = self.DepDirectives.drop_front(1);
        match self.DepDirectives.front().Kind {
            pp_none => {
                llvm_unreachable_internal("unexpected 'pp_none'", "P:/Goraw/llvm-project/clang/lib/Lex/Lexer.cpp", 4789);
            },
            pp_include => {
                pp___include_macros;
            },
            pp_if => {
                pp_ifdef;
            },
            pp_elif => {
                pp_elifdef;
            },
            pp_endif => {
                if !NestedIfs {
                    Stop = true;
                } else {
                    NestedIfs -= 1;
                }
            },
            pp_eof => {
                self.NextDepDirectiveTokenIndex = 0;
            },
        }
    }
        if !(!Stop) { break; }
    }
    let mut DDTok: *Token = self.DepDirectives.front().Tokens.front();
    assert!(DDTok.is(hash);
    self.NextDepDirectiveTokenIndex = 1;
    self.convertDependencyDirectiveToken(DDTok, Result);
    return false;
}

struct Closure_1 {
    lastNewLine: *mut *u8,
    cap_1: *mut Lexer,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Ptr: *u8) {
        (*self.lastNewLine) = Ptr;
        if !self.NewLinePtr {
            self.NewLinePtr = Ptr;
        }
    }
