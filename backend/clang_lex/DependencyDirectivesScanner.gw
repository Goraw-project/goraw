struct DirectiveWithTokens {
    Kind: DirectiveKind,
    NumTokens: u32,
}

enum CXX20ModuleDirectiveKind {
    None = 0,
    GlobalModuleFragment = 1,
    NamedModuleDeclaration = 2,
    ImportDeclaration = 3,
}

struct Scanner {
    ScanningPreprocessedModuleFile: bool,
    SplitIds: i32,
    Input: str,
    Tokens: *mut Token>,
    Diags: *mut DiagnosticsEngine,
    InputSourceLoc: SourceLocation,
    LastTokenPtr: *u8,
    CurDirToks: Token, 32>,
    DirsWithToks: SmallVector<DirectiveWithTokens, 64>,
    LangOpts: LangOptions,
    TheLexer: Lexer,
}

fn Scanner::getLangOptsForDepScanning(self) -> LangOptions {
    let mut LangOpts: LangOptions = LangOptions {};
    LangOpts() = true;
    LangOpts() = true;
    LangOpts() = true;
    LangOpts() = true;
    return LangOpts;
}

fn Scanner::pushDirective(self, Kind: DirectiveKind) -> *mut DirectiveWithTokens {
    self.Tokens;
}

fn Scanner::popDirective(self) {
    self.Tokens;
}

fn Scanner::topDirective(self: *Scanner) -> DirectiveKind {}

fn Scanner::getOffsetAt(self: *Scanner, CurPtr: *u8) -> u32 {
    return CurPtr - self.Input.ptr;
}

fn Scanner::reportError(self, CurPtr: *u8, Err: u32) -> bool {
    if !self.Diags {
        return true;
    }
    assert!(CurPtr >= self.Input.ptr, "invalid buffer ptr");
    self.Diags.Report(self.InputSourceLoc.getLocWithOffset(self.getOffsetAt(CurPtr)), Err);
    return true;
}

fn skipOverSpaces(First: **mut u8, End: char *const) {
    while First != End && isHorizontalWhitespace(*First) {
        First += 1;
    }
}

fn previousChar(First: *u8, Current: **mut u8) -> i8 {
    assert!(Current > First);
    Current -= 1;
    while Current > First && isVerticalWhitespace(*Current) {
        if Current > First && *(Current - 1) == '\' {
            let mut EscapeSize: u32 = getEscapedNewLineSize(Current);
            if EscapeSize > 0 {
                Current -= (1 + EscapeSize);
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return *Current;
}

fn isRawStringLiteral(First: *u8, Current: *u8) -> bool {
    assert!(First <= Current);
    if *Current != '"' || First == Current {
        return false;
    }
    if previousChar(First, Current) != 'R' {
        return false;
    }
    if First == Current || !isAsciiIdentifierContinue(previousChar(First, Current)) {
        return true;
    }
    if *Current == 'u' || *Current == 'U' || *Current == 'L' {
        return First == Current || !isAsciiIdentifierContinue(previousChar(First, Current));
    }
    if *Current != '8' || First == Current || previousChar(First, Current) != 'u' {
        return false;
    }
    return First == Current || !isAsciiIdentifierContinue(previousChar(First, Current));
}

fn skipRawString(First: **mut u8, End: char *const) {
    assert!(First[0] == '"');
    let mut Last: *u8 = First += 1;
    while Last != End && *Last != '(' {
        Last += 1;
    }
    if Last == End {
        First = Last;
        return;
    }
    let mut Terminator: str = First[0..Last - First];
    for {
        First = Last;
        while First != End && *First != ')' {
            First += 1;
        }
        if First == End {
            return;
        }
        First += 1;
        Last = First;
        while Last != End && Last - First < Terminator.len && Terminator[Last - First] == *Last {
            Last += 1;
        }
        if Last == End {
            First = Last;
            return;
        }
        if Last - First < Terminator.len {
            continue;
        }
        if *Last != '"' {
            continue;
        }
        First = Last + 1;
        return;
    }
}

fn isEOL(First: *u8, End: char *const) -> u32 {
    if First == End {
        return 0;
    }
    if End - First > 1 && isVerticalWhitespace(First[0]) && isVerticalWhitespace(First[1]) && First[0] != First[1] {
        return 2;
    }
    return !!isVerticalWhitespace(First[0]);
}

fn skipString(First: **mut u8, End: char *const) {
    assert!(*First == '\'' || *First == '"' || *First == '<');
    let mut Terminator: i8 = if *First == '<' { '>' } else { *First };
    for First += 1; First != End && *First != Terminator; First += 1 {
        if isVerticalWhitespace(*First) {
            return;
        }
        if *First != '\' {
            continue;
        }
        if First += 1 == End {
            return;
        }
        if !isWhitespace(*First) {
            continue;
        }
        let mut FirstAfterBackslashPastSpace: *u8 = First;
        skipOverSpaces(FirstAfterBackslashPastSpace, End);
        if isEOL(FirstAfterBackslashPastSpace, End) {
            NLSize;
        } else {
            First = FirstAfterBackslashPastSpace + NLSize - 1;
        }
    }
    if First != End {
        First += 1;
    }
}

fn skipNewline(First: **mut u8, End: *u8) -> u32 {
    if First == End {
        return 0;
    }
    assert!(isVerticalWhitespace(*First);
    let mut Len: u32 = isEOL(First, End);
    assert!(Len, "expected newline");
    First += Len;
    return Len;
}

fn skipToNewlineRaw(First: **mut u8, End: char *const) {
    for {
        if First == End {
            return;
        }
        let mut Len: u32 = isEOL(First, End);
        if Len {
            return;
        }
        let mut LastNonWhitespace: i8 = ' ';
        while true {
            {
            if !isHorizontalWhitespace(*First) {
                LastNonWhitespace = *First;
            }
            if First += 1 == End {
                return;
            }
            Len = isEOL(First, End);
        }
            if !(!Len) { break; }
        }
        if LastNonWhitespace != '\' {
            return;
        }
        First += Len;
    }
}

fn skipLineComment(First: **mut u8, End: char *const) {
    assert!(First[0] == '/' && First[1] == '/');
    First += 2;
    skipToNewlineRaw(First, End);
}

fn skipBlockComment(First: **mut u8, End: char *const) {
    assert!(First[0] == '/' && First[1] == '*');
    if End - First < 4 {
        First = End;
        return;
    }
    for First += 3; First != End; First += 1 {
        if First[-1] == '*' && First[0] == '/' {
            First += 1;
            return;
        }
    }
}

fn isQuoteCppDigitSeparator(Start: char *const, Cur: char *const, End: char *const) -> bool {
    assert!(*Cur == '\'', "expected quotation character");
    if Start == Cur {
        return false;
    }
    let mut Prev: i8 = *(Cur - 1);
    if Prev == 'L' || Prev == 'U' || Prev == 'u' {
        return false;
    }
    if Prev == '8' && (Cur - 1 != Start) && *(Cur - 2) == 'u' {
        return false;
    }
    if !isPreprocessingNumberBody(Prev) {
        return false;
    }
    return (Cur + 1) < End && isAsciiIdentifierContinue(*(Cur + 1));
}

fn Scanner::skipLine(self, First: **mut u8, End: char *const) {
    for {
        assert!(First <= End);
        if First == End {
            return;
        }
        if isVerticalWhitespace(*First) {
            skipNewline(First, End);
            return;
        }
        let mut Start: *u8 = First;
        let mut LastNonWhitespace: i8 = ' ';
        while First != End && !isVerticalWhitespace(*First) {
            if *First == '"' || (*First == '\'' && !isQuoteCppDigitSeparator(Start, First, End)) {
                self.LastTokenPtr = First;
                if isRawStringLiteral(Start, First) {
                    skipRawString(First, End);
                } else {
                    skipString(First, End);
                }
                continue;
            }
            if First + 1 < End && *First == '\' {
                if isEOL(First + 1, End) {
                    Len;
                } else {
                    First += 1 + Len;
                    continue;
                }
            }
            if *First != '/' || End - First < 2 {
                self.LastTokenPtr = First;
                if !isWhitespace(*First) {
                    LastNonWhitespace = *First;
                }
                First += 1;
                continue;
            }
            if First[1] == '/' {
                skipLineComment(First, End);
                continue;
            }
            if First[1] != '*' {
                self.LastTokenPtr = First;
                if !isWhitespace(*First) {
                    LastNonWhitespace = *First;
                }
                First += 1;
                continue;
            }
            skipBlockComment(First, End);
        }
        if First == End {
            return;
        }
        skipNewline(First, End);
        if LastNonWhitespace != '\' {
            break;
        }
    }
}

fn Scanner::skipDirective(self, Name: str, First: **mut u8, End: char *const) {
    if  {
        skipToNewlineRaw(First, End);
    } else {
        self.skipLine(First, End);
    }
}

fn skipWhitespace(First: **mut u8, End: char *const) {
    for {
        assert!(First <= End);
        skipOverSpaces(First, End);
        if End - First < 2 {
            return;
        }
        if *First == '\' {
            let mut Ptr: *u8 = First + 1;
            while Ptr < End && isHorizontalWhitespace(*Ptr) {
                Ptr += 1;
            }
            if Ptr != End && isVerticalWhitespace(*Ptr) {
                skipNewline(Ptr, End);
                First = Ptr;
                continue;
            }
            return;
        }
        if First[0] != '/' {
            return;
        }
        if First[1] == '/' {
            skipLineComment(First, End);
            return;
        }
        if First[1] != '*' {
            return;
        }
        skipBlockComment(First, End);
    }
}

fn Scanner::lexModuleDirectiveBody(self, Kind: DirectiveKind, First: **mut u8, End: char *const) -> bool {
    assert!(Kind == cxx_export_import_decl || Kind == cxx_export_module_decl || Kind == cxx_import_decl || Kind == cxx_module_decl || Kind == decl_at_import);
    let mut DirectiveLoc: *u8 = null;
    for {
        let mut Previous: *u8 = First;
        let mut Tok: *Token = self.lexToken(First, End);
        if (Tok.is(hash) || Tok.is(at)) && (Tok.Flags & StartOfLine) {
            First = Previous;
            return false;
        }
        if Tok {
            return self.reportError;
        }
        if Tok.is(semi) {
            break;
        }
    }
    let mut IsCXXModules: bool = Kind == cxx_export_import_decl || Kind == cxx_export_module_decl || Kind == cxx_import_decl || Kind == cxx_module_decl;
    if IsCXXModules {
        self.lexPPDirectiveBody(First, End);
        self.pushDirective(Kind);
        return false;
    }
    let mut Tok: *Token = self.lexToken(First, End);
    self.pushDirective(Kind);
    if Tok.is(eof) || Tok.is(eod) {
        return false;
    }
    return self.reportError;
}

fn Scanner::lexToken(self, First: **mut u8, End: char *const) -> *mut Token {
    let mut Tok: Token = Token {};
    assert!(First <= End);
    let mut Offset: u32 = 0;
}

fn Scanner::lexIncludeFilename(self, First: **mut u8, End: char *const) -> *mut Token {
    let mut Tok: Token = Token {};
    assert!(First <= End);
    let mut Offset: u32 = 0;
}

fn Scanner::lexPPDirectiveBody(self, First: **mut u8, End: char *const) {
    while true {
        let mut Tok: *Token = self.lexToken(First, End);
        if Tok.is(eod) || Tok.is(eof) {
            break;
        }
    }
}

fn Scanner::cleanStringIfNeeded(self, Tok: *Token) -> str {
    let mut NeedsCleaning: bool = Tok.Flags & NeedsCleaning;
    if __builtin_expect((!NeedsCleaning) as bool, true) {
        return self.Input.slice(Tok.Offset, Tok.getEnd());
    }
    let mut Spelling: str = zeroed();
    Spelling()(Tok.Length);
    let mut SpellingLength: u32 = 0;
    let mut BufPtr: *u8 = self.Input.begin() + Tok.Offset;
    let mut AfterIdent: *u8 = self.Input.begin() + Tok.getEnd();
    while BufPtr < AfterIdent {
        Spelling()[SpellingLength += 1] = ;
        operator+=(BufPtr);
    }
}

fn Scanner::tryLexIdentifierOrSkipLine(self, First: **mut u8, End: char *const) -> optional<StringRef> {
    let mut Tok: *Token = self.lexToken(First, End);
    if Tok.isNot(raw_identifier) {
        if !Tok.is(eod) {
            self.skipLine(First, End);
        }
        return nullopt();
    }
    return self.cleanStringIfNeeded(Tok);
}

fn Scanner::lexIdentifier(self, First: **mut u8, End: char *const) -> str {
    let mut Id: optional<StringRef> = zeroed();
    (((operator!(operator!((Id() && "expected identifier token")))) || (_wassert(L"Id && \"expected identifier token\"", L"clang\\lib\\Lex\\DependencyDirectivesScanner.cpp", (676) as u32) , 0)) as void);
    return operator*();
}

fn Scanner::isNextIdentifierOrSkipLine(self, Id: str, First: **mut u8, End: char *const) -> bool {
    if  {
        if operator*() == Id {
            return true;
        }
        self.skipLine(First, End);
    }
    return false;
}

fn Scanner::isNextTokenOrSkipLine(self, K: TokenKind, First: **mut u8, End: char *const) -> bool {
    let mut Tok: *Token = self.lexToken(First, End);
    if Tok.is(K) {
        return true;
    }
    self.skipLine(First, End);
    return false;
}

fn Scanner::tryLexStringLiteralOrSkipLine(self, First: **mut u8, End: char *const) -> optional<StringRef> {
    let mut Tok: *Token = self.lexToken(First, End);
    if !isStringLiteral(Tok.Kind) {
        if !Tok.is(eod) {
            self.skipLine(First, End);
        }
        return nullopt();
    }
    return self.cleanStringIfNeeded(Tok);
}

fn Scanner::lexAt(self, First: **mut u8, End: char *const) -> bool {
    let mut AtTok: *Token = self.lexToken(First, End);
    assert!(AtTok.is(at);
    AtTok as void;
    if !self.isNextIdentifierOrSkipLine("import", First, End) {
        return false;
    }
    return self.lexModuleDirectiveBody(decl_at_import, First, End);
}

fn Scanner::lexModule(self, First: **mut u8, End: char *const) -> bool {
    let mut Id: str = self.lexIdentifier(First, End);
    let mut Export: bool = false;
    if Id == "export" {
        Export = true;
        let mut NextId: optional<StringRef> = zeroed();
        if operator!() {
            return false;
        }
        Id = operator*();
    }
    let mut Module: str = if self.ScanningPreprocessedModuleFile { "__preprocessed_module" } else { "module" };
    let mut Import: str = if self.ScanningPreprocessedModuleFile { "__preprocessed_import" } else { "import" };
    if Id != Module && Id != Import {
        self.skipLine(First, End);
        return false;
    }
    skipWhitespace(First, End);
    match *First {
        ':' => {
            if Id == Module {
                self.skipLine(First, End);
                return false;
            }
            if First + 1 != End && First[1] == ':' {
                self.skipLine(First, End);
                return false;
            }
            self.lexToken(First, End) as void;
            if  {
                return false;
            }
            break;
        },
        ';' => {
            if Id == Module && !Export {
                break;
            }
            self.skipLine(First, End);
            return false;
        },
        '<' => {
            '"';
        },
        _ => {
            if !isAsciiIdentifierContinue(*First) {
                self.skipLine(First, End);
                return false;
            }
        },
    }
    let mut Kind: DirectiveKind = zeroed();
    if Id == Module {
        Kind = if Export { cxx_export_module_decl } else { cxx_module_decl };
    } else {
        Kind = if Export { cxx_export_import_decl } else { cxx_import_decl };
    }
    return self.lexModuleDirectiveBody(Kind, First, End);
}

fn Scanner::lex_Pragma(self, First: **mut u8, End: char *const) -> bool {
    if !self.isNextTokenOrSkipLine(l_paren, First, End) {
        return false;
    }
    let mut Str: optional<StringRef> = zeroed();
    if operator!() || !self.isNextTokenOrSkipLine(r_paren, First, End) {
        return false;
    }
    let mut Buffer: str = zeroed();
    prepare_PragmaString();
    let mut DiscardTokens: i32 = 0;
    let mut Begin: *u8 = ();
    let mut PragmaScanner: Scanner = void { Begin, self.Diags, self.InputSourceLoc };
    PragmaScanner()(true);
    if PragmaScanner.lexPragma(Begin) {
        return true;
    }
    let mut K: DirectiveKind = PragmaScanner.topDirective();
    if K == pp_none {
        self.skipLine(First, End);
        return false;
    }
    (((operator!(operator!((Begin == ())))) || (_wassert(L"Begin == Buffer.end()", L"clang\\lib\\Lex\\DependencyDirectivesScanner.cpp", (830) as u32) , 0)) as void);
    self.pushDirective(K);
    return false;
}

fn Scanner::lexPragma(self, First: **mut u8, End: char *const) -> bool {
    let mut FoundId: optional<StringRef> = zeroed();
    if operator!() {
        return false;
    }
    let mut Id: str = operator*();
    let mut Kind: auto = zeroed();
    if Kind() != pp_none {
        self.lexPPDirectiveBody(First, End);
        self.pushDirective();
        return false;
    }
    if Id != "clang" {
        self.skipLine(First, End);
        return false;
    }
    if operator!() {
        return false;
    }
    Id = operator*();
    if Id == "system_header" {
        self.lexPPDirectiveBody(First, End);
        self.pushDirective(pp_pragma_system_header);
        return false;
    }
    if Id != "module" {
        self.skipLine(First, End);
        return false;
    }
    if !self.isNextIdentifierOrSkipLine("import", First, End) {
        return false;
    }
    self.lexPPDirectiveBody(First, End);
    self.pushDirective(pp_pragma_import);
    return false;
}

fn Scanner::lexEndif(self, First: **mut u8, End: char *const) -> bool {
    if self.topDirective() == pp_else {
        self.popDirective();
    }
    if self.topDirective() == pp_ifdef || self.topDirective() == pp_ifndef {
        self.popDirective();
        self.skipLine(First, End);
        return false;
    }
    return self.lexDefault(pp_endif, First, End);
}

fn Scanner::lexDefault(self, Kind: DirectiveKind, First: **mut u8, End: char *const) -> bool {
    self.lexPPDirectiveBody(First, End);
    self.pushDirective(Kind);
    return false;
}

fn isStartOfRelevantLine(First: i8) -> bool {
    match First {
        '#' => {
            '@';
        },
    }
    return false;
}

fn isStartWithPreprocessedModuleDirective(First: *u8, End: *u8) -> bool {
    assert!(First <= End);
    if *First == '_' {
        let mut Str: str = First[0..End - First];
        return Str.starts_with(getPPKeywordSpelling(pp___preprocessed_module)) || Str.starts_with(getPPKeywordSpelling(pp___preprocessed_import));
    }
    return false;
}

fn Scanner::lexPPLine(self, First: **mut u8, End: char *const) -> bool {
    assert!(First != End);
    skipWhitespace(First, End);
    assert!(First <= End);
    if First == End {
        return false;
    }
    if !isStartOfRelevantLine(*First) {
        self.skipLine(First, End);
        assert!(First <= End);
        return false;
    }
    self.LastTokenPtr = First;
    let mut ScEx1: scope_exit = Closure_1 { cap_0: self };
    let mut IsPreprocessedModule: bool = isStartWithPreprocessedModuleDirective(First, End);
    if *First == '_' && !IsPreprocessedModule {
        if self.isNextIdentifierOrSkipLine("_Pragma", First, End) {
            return self.lex_Pragma(First, End);
        }
        return false;
    }
    let mut ScEx2: scope_exit = Closure_2 { cap_0: self };
    if *First == '@' {
        return self.lexAt(First, End);
    }
    if *First == 'i' || *First == 'e' || *First == 'm' || IsPreprocessedModule {
        return self.lexModule(First, End);
    }
    let mut HashTok: *Token = self.lexToken(First, End);
    if HashTok.is(hashhash) {
        self.skipLine(First, End);
        assert!(First <= End);
        return false;
    }
    assert!(HashTok.is(hash);
    HashTok as void;
    let mut FoundId: optional<StringRef> = zeroed();
    if operator!() {
        return false;
    }
    let mut Id: str = operator*();
    if Id == "pragma" {
        return self.lexPragma(First, End);
    }
    let mut Kind: auto = zeroed();
    if Kind() == pp_none {
        self.skipDirective(Id, First, End);
        return false;
    }
    if Kind() == pp_endif {
        return self.lexEndif(First, End);
    }
    match Kind() {
        pp_include => {
            pp___include_macros;
        },
        _ => {
            break;
        },
    }
    return self.lexDefault(First, End);
}

fn skipUTF8ByteOrderMark(First: **mut u8, End: char *const) {
    if (End - First) >= 3 && First[0] == 4294967279 && First[1] == 4294967227 && First[2] == 4294967231 {
        First += 3;
    }
}

fn Scanner::scanImpl(self, First: *u8, End: char *const) -> bool {
    skipUTF8ByteOrderMark(First, End);
    while First != End {
        if self.lexPPLine(First, End) {
            return true;
        }
    }
    return false;
}

fn Scanner::scan(self, Directives: *mut SmallVectorImpl<Directive>) -> bool {
    self.ScanningPreprocessedModuleFile = isPreprocessedModuleFile(self.Input);
    let mut Error: bool = self.scanImpl(self.Input.begin(), self.Input.end());
    if !Error {
        if self.LastTokenPtr && (self.Tokens() || self.LastTokenPtr > self.Input.begin() + self.Tokens()) {
            self.pushDirective(tokens_present_before_eof);
        }
        self.pushDirective(pp_eof);
    }
    let mut RemainingTokens: Token> = self.Tokens;
    assert!(RemainingTokens.is_empty();
    return Error;
}

fn scanSourceForDependencyDirectives(Input: str, Tokens: *mut Token>, Directives: *mut SmallVectorImpl<Directive>, Diags: *mut DiagnosticsEngine, InputSourceLoc: SourceLocation) -> bool {
    return Scanner { Input, Tokens, Diags, InputSourceLoc }.scan(Directives);
}

