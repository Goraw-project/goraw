fn skipUntilMaybeCXX20ModuleDirective(First: **mut u8, End: char *const) {
    assert!(First <= End);
    while First != End {
        if *First == '#' {
            First += 1;
            skipToNewlineRaw(First, End);
        }
        skipWhitespace(First, End);
        if isEOL(First, End) {
            Len;
        } else {
            First += Len;
            continue;
        }
        break;
    }
}

fn scanFirstCXX20ModuleDirective(Source: str) -> CXX20ModuleDirectiveKind {
    let mut First: *u8 = Source.begin();
    let mut End: char *const = Source.end();
    skipUntilMaybeCXX20ModuleDirective(First, End);
    if First == End {
        return None;
    }
    if !(*First == 'i' || *First == 'e' || *First == 'm') {
        return None;
    }
    let mut Tokens: i32 = 0;
    let mut S: Scanner = First[0..End - First];
    S()(true);
    if S.lexModule(First, End) || S()() {
        return None;
    }
    (((operator!(operator!((S()() == 1)))) || (_wassert(L"S.DirsWithToks.size() == 1", L"clang\\lib\\Lex\\DependencyDirectivesScanner.cpp", (1168) as u32) , 0)) as void);
    let mut Directive: *DirectiveWithTokens = S()();
    match Directive.Kind {
        cxx_module_decl => {
            assert!(Directive.NumTokens >= 2);
        },
        cxx_export_module_decl => {
            return NamedModuleDeclaration;
        },
        cxx_import_decl => {
            cxx_export_import_decl;
        },
        _ => {
            llvm_unreachable_internal("unexpected C++20 module directive kind", "clang\\lib\\Lex\\DependencyDirectivesScanner.cpp", 1182);
        },
    }
}

fn scanInputForCXX20ModulesUsage(Source: str) -> bool {
    return scanFirstCXX20ModuleDirective(Source) != None;
}

fn scanInputForCXX20ModuleUnit(Source: str) -> ModuleUnitKind {
    match scanFirstCXX20ModuleDirective(Source) {
        GlobalModuleFragment => {
            return HasGlobalModuleFragment;
        },
        NamedModuleDeclaration => {
            return NamedModuleWithoutGlobalModuleFragment;
        },
        None => {
            ImportDeclaration;
        },
    }
    llvm_unreachable_internal("unexpected C++20 module directive kind", "clang\\lib\\Lex\\DependencyDirectivesScanner.cpp", 1203);
}

fn isPreprocessedModuleFile(Source: str) -> bool {
    let mut First: *u8 = Source.begin();
    let mut End: char *const = Source.end();
    skipUntilMaybeCXX20ModuleDirective(First, End);
    if First == End {
        return false;
    }
    let mut Tokens: i32 = 0;
    let mut S: Scanner = First[0..End - First];
    while First != End {
        if *First == '#' {
            First += 1;
            skipToNewlineRaw(First, End);
        } else if *First == 'e' {
            S()(S.getOffsetAt(First), true);
            let mut Id: str = S.lexIdentifier(First, End);
            if Id == "export" {
                let mut NextId: optional<StringRef> = zeroed();
                if operator!() {
                    return false;
                }
                Id = operator*();
            }
            if Id == "__preprocessed_module" || Id == "__preprocessed_import" {
                return true;
            }
            skipToNewlineRaw(First, End);
        } else if isStartWithPreprocessedModuleDirective(First, End) {
            return true;
        } else {
            skipToNewlineRaw(First, End);
        }
        skipWhitespace(First, End);
        if isEOL(First, End) {
            Len;
        } else {
            First += Len;
            continue;
        }
        break;
    }
    return false;
}

struct Closure_1 {
    cap_0: *mut Scanner,
}

fn Closure_1::call(self: *Closure_1) {}

struct Closure_2 {
    cap_0: *mut Scanner,
}

fn Closure_2::call(self: *Closure_2) {}

struct Closure_3 {}

fn Closure_3::call(self: *mut Closure_3, Prev: TokenKind, Tok: *Token) -> auto {
        if Prev == Tok.Kind {
            return !Tok;
        }
        if Prev == raw_identifier && Tok {
            return true;
        }
        if Prev == r_paren && Tok {
            return true;
        }
        if Prev == comma && Tok {
            return true;
        }
        return false;
    }
