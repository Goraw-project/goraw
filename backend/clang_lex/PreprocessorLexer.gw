fn PreprocessorLexer::anchor(self) {}

fn PreprocessorLexer::PreprocessorLexer(self, pp: *mut Preprocessor, fid: FileID) {
    if pp {
        self.InitialNumSLocEntries = pp.getSourceManager().local_sloc_entry_size();
    }
}

fn PreprocessorLexer::LexIncludeFilename(self, FilenameTok: *mut Token) {
    assert!(self.ParsingFilename == false, "reentered LexIncludeFilename");
    self.ParsingFilename = true;
    if self.LexingRawMode {
        self.IndirectLex(FilenameTok);
    } else {
        self.PP.Lex(FilenameTok);
    }
    self.ParsingFilename = false;
}

fn PreprocessorLexer::getFileEntry(self: *PreprocessorLexer) -> OptionalFileEntryRef {
    return self.PP.getSourceManager().getFileEntryRefForID(self.getFileID());
}
