fn PreprocessingRecord::findBeginLocalPreprocessedEntity(self: *PreprocessingRecord, Loc: SourceLocation) -> u32 {
    if self.SourceMgr.isLoadedSourceLocation(Loc) {
        return 0;
    }
    let mut Count: u64 = 0;
    let mut Half: u64 = 0;
    let mut First: i32 = 0;
    let mut I: i32 = 0;
    while Count > 0 {
        Half = Count / 2;
        I() = ;
        advance(Half);
        if self.SourceMgr.isBeforeInTranslationUnit((*)()(), Loc) {
            First() = ;
             += 1;
            Count = Count - Half - 1;
        } else {
            Count = Half;
        }
    }
}

fn PreprocessingRecord::findEndLocalPreprocessedEntity(self: *PreprocessingRecord, Loc: SourceLocation) -> u32 {
    if self.SourceMgr.isLoadedSourceLocation(Loc) {
        return 0;
    }
    let mut I: auto = upper_bound(Loc, self.SourceMgr);
}

