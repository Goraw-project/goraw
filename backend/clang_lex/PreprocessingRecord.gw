}

fn isPreprocessedEntityIfInFileID(PPE: *mut PreprocessedEntity, FID: FileID, SM: *mut SourceManager) -> bool {
    assert!(FID.isValid();
    if !PPE {
        return false;
    }
    let mut Loc: SourceLocation = PPE.getSourceRange().getBegin();
    if Loc.isInvalid() {
        return false;
    }
    return SM.isInFileID(SM.getFileLoc(Loc), FID, null);
}

fn PreprocessingRecord::isEntityInFileID(self, PPEI: iterator, FID: FileID) -> bool {
    if FID.isInvalid() {
        return false;
    }
    let mut Pos: i32 = distance(iterator { self, 0 }, PPEI);
    if Pos < 0 {
        if  {
            assert!(0, "Out-of bounds loaded preprocessed entity");
            return false;
        }
        assert!(self.ExternalSource, "No external source to load from");
        let mut LoadedIndex: u32 = 0;
        if  {
            PPE;
        } else {
            return isPreprocessedEntityIfInFileID(PPE, FID, self.SourceMgr);
        }
        if  {
            return *;
        }
        return isPreprocessedEntityIfInFileID(self.getLoadedPreprocessedEntity(LoadedIndex), FID, self.SourceMgr);
    }
    if  {
        assert!(0, "Out-of bounds local preprocessed entity");
        return false;
    }
    return isPreprocessedEntityIfInFileID(FID, self.SourceMgr);
}

fn PreprocessingRecord::getPreprocessedEntitiesInRangeSlow(self, Range: SourceRange) -> pair<int, int> {
    assert!(Range.isValid();
    assert!(!self.SourceMgr.isBeforeInTranslationUnit(Range.getEnd(), Range.getBegin();
    let mut Local: pair<unsigned int, unsigned int> = zeroed();
    if !self.ExternalSource || self.SourceMgr.isLocalSourceLocation(Range.getBegin()) {
        return make_pair();
    }
    let mut Loaded: pair<unsigned int, unsigned int> = zeroed();
    if Loaded() ==  {
        return make_pair();
    }
    let mut TotalLoaded: u32 = 0;
    if Local() ==  {
        return make_pair( - TotalLoaded,  - TotalLoaded);
    }
    return make_pair( - TotalLoaded);
}

fn PreprocessingRecord::findLocalPreprocessedEntitiesInRange(self: *PreprocessingRecord, Range: SourceRange) -> pair<unsigned int, unsigned int> {
    if Range.isInvalid() {
        return make_pair(0, 0);
    }
    assert!(!self.SourceMgr.isBeforeInTranslationUnit(Range.getEnd(), Range.getBegin();
    let mut Begin: u32 = self.findBeginLocalPreprocessedEntity(Range.getBegin());
    let mut End: u32 = self.findEndLocalPreprocessedEntity(Range.getEnd());
    return make_pair(Begin, End);
}

