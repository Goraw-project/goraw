// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn ExternalPreprocessingRecordSource::~ExternalPreprocessingRecordSource(self) {}

fn InclusionDirective::InclusionDirective(self, PPRec: *mut PreprocessingRecord, Kind: InclusionKind, FileName: str, InQuotes: bool, ImportedModule: bool, File: OptionalFileEntryRef, Range: SourceRange) {
    let mut Memory: *mut u8 = PPRec.Allocate(FileName.len + 1, alignof) as *mut u8;
    memcpy(Memory, FileName.ptr, FileName.len);
    Memory[FileName.len] = 0;
    self.FileName = Memory[0..FileName.len];
}

