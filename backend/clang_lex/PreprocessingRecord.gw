// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn ExternalPreprocessingRecordSource::~ExternalPreprocessingRecordSource(self) {}

fn InclusionDirective::InclusionDirective(self, PPRec: *mut PreprocessingRecord, Kind: InclusionKind, FileName: str, InQuotes: bool, ImportedModule: bool, File: OptionalFileEntryRef, Range: SourceRange) {
    let mut Memory: *mut u8 = PPRec.Allocate(FileName.len + 1, alignof) as *mut u8;
    memcpy(Memory, FileName.ptr, FileName.len);
    Memory[FileName.len] = 0;
    self.FileName = Memory[0..FileName.len];
}

fn PreprocessingRecord::getPreprocessedEntitiesInRange(self, Range: SourceRange) -> iterator> {
    if Range.isInvalid() {
        return make_range(iterator {}, iterator {});
    }
    if self.CachedRangeQuery.Range == Range {
        return make_range(iterator { self, self.CachedRangeQuery.Result.first }, iterator { self, self.CachedRangeQuery.Result.second });
    }
    let mut Res: pair<int, int> = self.getPreprocessedEntitiesInRangeSlow(Range);
    self.CachedRangeQuery.Range = Range;
    self.CachedRangeQuery.Result = Res;
    return make_range(iterator { self, Res.first }, iterator { self, Res.second });
}

fn isPreprocessedEntityIfInFileID(PPE: *mut PreprocessedEntity, FID: FileID, SM: *mut SourceManager) -> bool {
    assert!(FID.isValid();
    if !PPE {
        return false;
    }
    let mut Loc: SourceLocation = PPE.getSourceRange().getBegin();
    if Loc.isInvalid() {
        return false;
    }
    return SM.isInFileID(SM.getFileLoc(Loc), FID, null);
}

fn PreprocessingRecord::isEntityInFileID(self, PPEI: iterator, FID: FileID) -> bool {
    if FID.isInvalid() {
        return false;
    }
    let mut Pos: i32 = distance(iterator { self, 0 }, PPEI);
    if Pos < 0 {
        if -Pos - 1 >= self.LoadedPreprocessedEntities.len {
            assert!(0, "Out-of bounds loaded preprocessed entity");
            return false;
        }
        assert!(self.ExternalSource, "No external source to load from");
        let mut LoadedIndex: u32 = self.LoadedPreprocessedEntities.len + Pos;
        if self.LoadedPreprocessedEntities[LoadedIndex] {
            PPE;
        } else {
            return isPreprocessedEntityIfInFileID(PPE, FID, self.SourceMgr);
        }
        if self.ExternalSource.isPreprocessedEntityInFileID(LoadedIndex, FID) {
            IsInFile;
        } else {
            return operator(IsInFile);
        }
        return isPreprocessedEntityIfInFileID(self.getLoadedPreprocessedEntity(LoadedIndex), FID, self.SourceMgr);
    }
    if Pos >= self.PreprocessedEntities.len {
        assert!(0, "Out-of bounds local preprocessed entity");
        return false;
    }
    return isPreprocessedEntityIfInFileID(self.PreprocessedEntities[Pos], FID, self.SourceMgr);
}

fn PreprocessingRecord::getPreprocessedEntitiesInRangeSlow(self, Range: SourceRange) -> pair<int, int> {
    assert!(Range.isValid();
    assert!(!self.SourceMgr.isBeforeInTranslationUnit(Range.getEnd(), Range.getBegin();
    let mut Local: pair<unsigned int, unsigned int> = self.findLocalPreprocessedEntitiesInRange(Range);
    if !self.ExternalSource || self.SourceMgr.isLocalSourceLocation(Range.getBegin()) {
        return make_pair(Local.first, Local.second);
    }
    let mut Loaded: pair<unsigned int, unsigned int> = self.ExternalSource.findPreprocessedEntitiesInRange(Range);
    if Loaded.first == Loaded.second {
        return make_pair(Local.first, Local.second);
    }
    let mut TotalLoaded: u32 = self.LoadedPreprocessedEntities.len;
    if Local.first == Local.second {
        return make_pair(Loaded.first - TotalLoaded, Loaded.second - TotalLoaded);
    }
    return make_pair(Loaded.first - TotalLoaded, Local.second);
}

fn PreprocessingRecord::findLocalPreprocessedEntitiesInRange(self: *PreprocessingRecord, Range: SourceRange) -> pair<unsigned int, unsigned int> {
    if Range.isInvalid() {
        return make_pair(0, 0);
    }
    assert!(!self.SourceMgr.isBeforeInTranslationUnit(Range.getEnd(), Range.getBegin();
    let mut Begin: u32 = self.findBeginLocalPreprocessedEntity(Range.getBegin());
    let mut End: u32 = self.findEndLocalPreprocessedEntity(Range.getEnd());
    return make_pair(Begin, End);
}

