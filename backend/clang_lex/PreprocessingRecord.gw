fn PreprocessingRecord::Defined(self, MacroNameTok: *Token, MD: *MacroDefinition, Range: SourceRange) {
    if MD {
        self.addMacroExpansion(MacroNameTok, MD.getMacroInfo(), MacroNameTok.getLocation());
    }
}

fn PreprocessingRecord::SourceRangeSkipped(self, Range: SourceRange, EndifLoc: SourceLocation) {
    assert!(Range.isValid();
}

fn PreprocessingRecord::MacroExpands(self, Id: *Token, MD: *MacroDefinition, Range: SourceRange, Args: *MacroArgs) {
    self.addMacroExpansion(Id, MD.getMacroInfo(), Range);
}

fn PreprocessingRecord::MacroDefined(self, Id: *Token, MD: *MacroDirective) {
    let mut MI: *MacroInfo = MD.getMacroInfo();
    let mut R: SourceRange = SourceRange { B: MI.getDefinitionLoc(), E: MI.getDefinitionEndLoc() };
    let mut Def: *mut MacroDefinitionRecord = MacroDefinitionRecord { Id.getIdentifierInfo(), R };
    self.addPreprocessedEntity(Def);
}

fn PreprocessingRecord::MacroUndefined(self, Id: *Token, MD: *MacroDefinition, Undef: *MacroDirective) {
    MD;
}

fn PreprocessingRecord::InclusionDirective(self, HashLoc: SourceLocation, IncludeTok: *Token, FileName: str, IsAngled: bool, FilenameRange: CharSourceRange, File: OptionalFileEntryRef, SearchPath: str, RelativePath: str, SuggestedModule: *Module, ModuleImported: bool, FileType: CharacteristicKind) {
    let mut Kind: InclusionKind = Include;
    match IncludeTok.getIdentifierInfo().getPPKeywordID() {
        pp_include => {
            Kind = Include;
        },
        pp_import => {
            Kind = Import;
        },
        pp_include_next => {
            Kind = IncludeNext;
        },
        pp___include_macros => {
            Kind = IncludeMacros;
        },
        _ => {
            llvm_unreachable_internal("Unknown include directive kind", "clang\\lib\\Lex\\PreprocessingRecord.cpp", 494);
        },
    }
    let mut EndLoc: SourceLocation = SourceLocation {};
    if !IsAngled {
        EndLoc = FilenameRange.getBegin();
    } else {
        EndLoc = FilenameRange.getEnd();
        if FilenameRange.isCharRange() {
            EndLoc = EndLoc.getLocWithOffset(-1);
        }
    }
    let mut ID: *mut InclusionDirective = *self;
    self.addPreprocessedEntity;
}

fn PreprocessingRecord::getTotalMemory(self: *PreprocessingRecord) -> u64 {}
