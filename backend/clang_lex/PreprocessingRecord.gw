fn PreprocessingRecord::findBeginLocalPreprocessedEntity(self: *PreprocessingRecord, Loc: SourceLocation) -> u32 {
    if self.SourceMgr.isLoadedSourceLocation(Loc) {
        return 0;
    }
    let mut Count: u64 = self.PreprocessedEntities.len;
    let mut Half: u64 = 0;
    let mut First: []*mut PreprocessedEntity = self.PreprocessedEntities.begin();
    let mut I: []*mut PreprocessedEntity = []*mut PreprocessedEntity {};
    while Count > 0 {
        Half = Count / 2;
        I = First;
        advance(I, Half);
        if self.SourceMgr.isBeforeInTranslationUnit((operator(I)).getSourceRange().getEnd(), Loc) {
            First = I;
            operator(First);
            Count = Count - Half - 1;
        } else {
            Count = Half;
        }
    }
    return First - self.PreprocessedEntities.begin();
}

fn PreprocessingRecord::findEndLocalPreprocessedEntity(self: *PreprocessingRecord, Loc: SourceLocation) -> u32 {
    if self.SourceMgr.isLoadedSourceLocation(Loc) {
        return 0;
    }
    let mut I: PreprocessedEntity *>>> = upper_bound(self.PreprocessedEntities, Loc, self.SourceMgr);
    return I - self.PreprocessedEntities.begin();
}

fn PreprocessingRecord::addPreprocessedEntity(self, Entity: *mut PreprocessedEntity) -> PPEntityID {
    assert!(Entity);
    let mut BeginLoc: SourceLocation = Entity.getSourceRange().getBegin();
    if isa(Entity) {
        assert!((self.PreprocessedEntities.is_empty() || !self.SourceMgr.isBeforeInTranslationUnit(BeginLoc, self.PreprocessedEntities.back().getSourceRange().getBegin())), "a macro definition was encountered out-of-order");
        self.PreprocessedEntities.push(Entity);
        return getPPEntityID(self.PreprocessedEntities.len - 1, false);
    }
    if self.PreprocessedEntities.is_empty() || !self.SourceMgr.isBeforeInTranslationUnit(BeginLoc, self.PreprocessedEntities.back().getSourceRange().getBegin()) {
        self.PreprocessedEntities.push(Entity);
        return getPPEntityID(self.PreprocessedEntities.len - 1, false);
    }
    let mut count: u32 = 0;
    for let mut RI: pp_iter = self.PreprocessedEntities.end();
let mut Begin: pp_iter = self.PreprocessedEntities.begin(); !RI == Begin && count < 4; operator(RI) , count += 1 {
        let mut I: pp_iter = RI;
        operator(I);
        if !self.SourceMgr.isBeforeInTranslationUnit(BeginLoc, (operator(I)).getSourceRange().getBegin()) {
            let mut insertI: pp_iter = self.PreprocessedEntities.insert(RI, Entity);
            return getPPEntityID(insertI - self.PreprocessedEntities.begin(), false);
        }
    }
    let mut I: pp_iter = upper_bound(self.PreprocessedEntities, BeginLoc, self.SourceMgr);
    let mut insertI: pp_iter = self.PreprocessedEntities.insert(I, Entity);
    return getPPEntityID(insertI - self.PreprocessedEntities.begin(), false);
}

fn PreprocessingRecord::SetExternalSource(self, Source: *mut ExternalPreprocessingRecordSource) {
    assert!(!self.ExternalSource, "Preprocessing record already has an external source");
    self.ExternalSource = &mut Source;
}

fn PreprocessingRecord::allocateLoadedEntities(self, NumEntities: u32) -> u32 {
    let mut Result: u32 = self.LoadedPreprocessedEntities.len;
    self.LoadedPreprocessedEntities.resize(self.LoadedPreprocessedEntities.len + NumEntities);
    return Result;
}

fn PreprocessingRecord::allocateSkippedRanges(self, NumRanges: u32) -> u32 {
    let mut Result: u32 = self.SkippedRanges.len;
    self.SkippedRanges.resize(self.SkippedRanges.len + NumRanges);
    self.SkippedRangesAllLoaded = false;
    return Result;
}

fn PreprocessingRecord::ensureSkippedRangesLoaded(self) {
    if self.SkippedRangesAllLoaded || !self.ExternalSource {
        return;
    }
    for let mut Index: u32 = 0; Index != self.SkippedRanges.len; Index += 1 {
        if self.SkippedRanges[Index].isInvalid() {
            self.SkippedRanges[Index] = self.ExternalSource.ReadSkippedRange(Index);
        }
    }
    self.SkippedRangesAllLoaded = true;
}

fn PreprocessingRecord::RegisterMacroDefinition(self, Macro: *mut MacroInfo, Def: *mut MacroDefinitionRecord) {
    self.MacroDefinitions[Macro] = Def;
}

fn PreprocessingRecord::getPreprocessedEntity(self, PPID: PPEntityID) -> *mut PreprocessedEntity {
    if PPID.ID < 0 {
        let mut Index: u32 = -PPID.ID - 1;
        assert!(Index < self.LoadedPreprocessedEntities.len, "Out-of bounds loaded preprocessed entity");
        return self.getLoadedPreprocessedEntity(Index);
    }
    if PPID.ID == 0 {
        return null;
    }
    let mut Index: u32 = PPID.ID - 1;
    assert!(Index < self.PreprocessedEntities.len, "Out-of bounds local preprocessed entity");
    return self.PreprocessedEntities[Index];
}

fn PreprocessingRecord::getLoadedPreprocessedEntity(self, Index: u32) -> *mut PreprocessedEntity {
    assert!(Index < self.LoadedPreprocessedEntities.len, "Out-of bounds loaded preprocessed entity");
    assert!(self.ExternalSource, "No external source to load from");
    let mut Entity: *mut *mut PreprocessedEntity = self.LoadedPreprocessedEntities[Index];
    if !Entity {
        Entity = self.ExternalSource.ReadPreprocessedEntity(Index);
        if !Entity {
            Entity = PreprocessedEntity { Kind: InvalidKind, Range: SourceRange {} };
        }
    }
    return Entity;
}

fn PreprocessingRecord::findMacroDefinition(self, MI: *MacroInfo) -> *mut MacroDefinitionRecord {
    return self.MacroDefinitions.lookup(MI);
}

fn PreprocessingRecord::addMacroExpansion(self, Id: *Token, MI: *MacroInfo, Range: SourceRange) {
    if Id.getLocation().isMacroID() {
        return;
    }
    if MI.isBuiltinMacro() {
        self.addPreprocessedEntity(MacroExpansion { Id.getIdentifierInfo(), Range });
    } else if self.findMacroDefinition(MI) {
        Def;
    } else {
        self.addPreprocessedEntity(MacroExpansion { Def, Range });
    }
}

fn PreprocessingRecord::Ifdef(self, Loc: SourceLocation, MacroNameTok: *Token, MD: *MacroDefinition) {
    if MD {
        self.addMacroExpansion(MacroNameTok, MD.getMacroInfo(), MacroNameTok.getLocation());
    }
}

fn PreprocessingRecord::Elifdef(self, Loc: SourceLocation, MacroNameTok: *Token, MD: *MacroDefinition) {
    if MD {
        self.addMacroExpansion(MacroNameTok, MD.getMacroInfo(), MacroNameTok.getLocation());
    }
}

fn PreprocessingRecord::Ifndef(self, Loc: SourceLocation, MacroNameTok: *Token, MD: *MacroDefinition) {
    if MD {
        self.addMacroExpansion(MacroNameTok, MD.getMacroInfo(), MacroNameTok.getLocation());
    }
}

fn PreprocessingRecord::Elifndef(self, Loc: SourceLocation, MacroNameTok: *Token, MD: *MacroDefinition) {
    if MD {
        self.addMacroExpansion(MacroNameTok, MD.getMacroInfo(), MacroNameTok.getLocation());
    }
}

fn PreprocessingRecord::Defined(self, MacroNameTok: *Token, MD: *MacroDefinition, Range: SourceRange) {
    if MD {
        self.addMacroExpansion(MacroNameTok, MD.getMacroInfo(), MacroNameTok.getLocation());
    }
}

fn PreprocessingRecord::SourceRangeSkipped(self, Range: SourceRange, EndifLoc: SourceLocation) {
    assert!(Range.isValid();
    self.SkippedRanges.push(Range.getBegin(), EndifLoc);
}

fn PreprocessingRecord::MacroExpands(self, Id: *Token, MD: *MacroDefinition, Range: SourceRange, Args: *MacroArgs) {
    self.addMacroExpansion(Id, MD.getMacroInfo(), Range);
}

fn PreprocessingRecord::MacroDefined(self, Id: *Token, MD: *MacroDirective) {
    let mut MI: *MacroInfo = MD.getMacroInfo();
    let mut R: SourceRange = SourceRange { B: MI.getDefinitionLoc(), E: MI.getDefinitionEndLoc() };
    let mut Def: *mut MacroDefinitionRecord = MacroDefinitionRecord { Id.getIdentifierInfo(), R };
    self.addPreprocessedEntity(Def);
    self.MacroDefinitions[MI] = Def;
}

fn PreprocessingRecord::MacroUndefined(self, Id: *Token, MD: *MacroDefinition, Undef: *MacroDirective) {
    MD.forAllDefinitions(Closure_1 { cap_0: self });
}

fn PreprocessingRecord::InclusionDirective(self, HashLoc: SourceLocation, IncludeTok: *Token, FileName: str, IsAngled: bool, FilenameRange: CharSourceRange, File: OptionalFileEntryRef, SearchPath: str, RelativePath: str, SuggestedModule: *Module, ModuleImported: bool, FileType: CharacteristicKind) {
    let mut Kind: InclusionKind = Include;
    match IncludeTok.getIdentifierInfo().getPPKeywordID() {
        pp_include => {
            Kind = Include;
        },
        pp_import => {
            Kind = Import;
        },
        pp_include_next => {
            Kind = IncludeNext;
        },
        pp___include_macros => {
            Kind = IncludeMacros;
        },
        _ => {
            llvm_unreachable_internal("Unknown include directive kind", "P:/Goraw/llvm-project/clang/lib/Lex/PreprocessingRecord.cpp", 494);
        },
    }
    let mut EndLoc: SourceLocation = SourceLocation {};
    if !IsAngled {
        EndLoc = FilenameRange.getBegin();
    } else {
        EndLoc = FilenameRange.getEnd();
        if FilenameRange.isCharRange() {
            EndLoc = EndLoc.getLocWithOffset(-1);
        }
    }
    let mut ID: *mut InclusionDirective = InclusionDirective { Kind: *self, Range: Kind, FileName: FileName, InQuotes: !IsAngled, Kind: ModuleImported, ImportedModule: File, File: SourceRange { B: HashLoc, E: EndLoc } };
    self.addPreprocessedEntity(ID);
}

fn PreprocessingRecord::getTotalMemory(self: *PreprocessingRecord) -> u64 {
    return self.BumpAlloc.getTotalMemory() + capacity_in_bytes(self.MacroDefinitions) + capacity_in_bytes(self.PreprocessedEntities) + capacity_in_bytes(self.LoadedPreprocessedEntities) + capacity_in_bytes(self.SkippedRanges);
}

struct Closure_1 {
    cap_0: *mut PreprocessingRecord,
}

fn Closure_1::call(self: *Closure_1, MI: *mut MacroInfo) {
        self.MacroDefinitions.erase(MI);
    }
