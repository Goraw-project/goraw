fn TextEncoding::getConverter(self: *TextEncoding, Action: ConversionAction) -> *mut TextEncodingConverter {
    match Action {
        CA_ToLiteralEncoding => {
            return self.ToLiteralEncodingConverter.get();
        },
        _ => {
            return null;
        },
    }
}

fn TextEncoding::setConvertersFromOptions(self, TE: *mut TextEncoding, Opts: *LangOptions) -> error_code {
    let mut UTF8: *u8 = "UTF-8";
    TE.LiteralEncoding = if Opts.LiteralEncoding.is_empty() { UTF8 } else { Opts.LiteralEncoding.ptr };
    if TE.LiteralEncoding == UTF8 {
        return error_code {};
    }
    let mut ErrorOrConverter: ErrorOr<TextEncodingConverter> = create(UTF8, TE.LiteralEncoding);
    if ErrorOrConverter {
        TE.ToLiteralEncodingConverter = make_unique(move(operator(ErrorOrConverter)));
    } else {
        return ErrorOrConverter.getError();
    }
    return error_code {};
}
