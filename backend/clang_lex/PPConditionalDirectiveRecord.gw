fn PPConditionalDirectiveRecord::PPConditionalDirectiveRecord(self, SM: *mut SourceManager) {
    self.CondDirectiveStack.push(SourceLocation {});
}

fn PPConditionalDirectiveRecord::rangeIntersectsConditionalDirective(self: *PPConditionalDirectiveRecord, Range: SourceRange) -> bool {
    if Range.isInvalid() {
        return false;
    }
    let mut low: const_iterator = lower_bound(self.CondDirectiveLocs, Range.getBegin(), self.SourceMgr);
    if low == self.CondDirectiveLocs.end() {
        return false;
    }
    if self.SourceMgr.isBeforeInTranslationUnit(Range.getEnd(), operator(low).getLoc()) {
        return false;
    }
    let mut upp: const_iterator = upper_bound(low, self.CondDirectiveLocs.end(), Range.getEnd(), self.SourceMgr);
    let mut uppRegion: SourceLocation = SourceLocation {};
    if !upp == self.CondDirectiveLocs.end() {
        uppRegion = operator(upp).getRegionLoc();
    }
    return operator(low).getRegionLoc() != uppRegion;
}

fn PPConditionalDirectiveRecord::findConditionalDirectiveRegionLoc(self: *PPConditionalDirectiveRecord, Loc: SourceLocation) -> SourceLocation {
    if Loc.isInvalid() {
        return SourceLocation {};
    }
    if self.CondDirectiveLocs.is_empty() {
        return SourceLocation {};
    }
    if self.SourceMgr.isBeforeInTranslationUnit(self.CondDirectiveLocs.back().getLoc(), Loc) {
        return self.CondDirectiveStack.back();
    }
    let mut low: const_iterator = lower_bound(self.CondDirectiveLocs, Loc, self.SourceMgr);
    assert!(!low == self.CondDirectiveLocs.end();
    return operator(low).getRegionLoc();
}

fn PPConditionalDirectiveRecord::addCondDirectiveLoc(self, DirLoc: CondDirectiveLoc) {
    if self.SourceMgr.isInSystemHeader(DirLoc.getLoc()) {
        return;
    }
    assert!(self.CondDirectiveLocs.is_empty() || self.SourceMgr.isBeforeInTranslationUnit(self.CondDirectiveLocs.back().getLoc(), DirLoc.getLoc();
    self.CondDirectiveLocs.push(DirLoc);
}

fn PPConditionalDirectiveRecord::If(self, Loc: SourceLocation, ConditionRange: SourceRange, ConditionValue: ConditionValueKind) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    self.CondDirectiveStack.push(Loc);
}

fn PPConditionalDirectiveRecord::Ifdef(self, Loc: SourceLocation, MacroNameTok: *Token, MD: *MacroDefinition) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    self.CondDirectiveStack.push(Loc);
}

fn PPConditionalDirectiveRecord::Ifndef(self, Loc: SourceLocation, MacroNameTok: *Token, MD: *MacroDefinition) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    self.CondDirectiveStack.push(Loc);
}

fn PPConditionalDirectiveRecord::Elif(self, Loc: SourceLocation, ConditionRange: SourceRange, ConditionValue: ConditionValueKind, IfLoc: SourceLocation) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    self.CondDirectiveStack.back() = Loc;
}

fn PPConditionalDirectiveRecord::Elifdef(self, Loc: SourceLocation, arg: *Token, arg: *MacroDefinition) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    self.CondDirectiveStack.back() = Loc;
}

fn PPConditionalDirectiveRecord::Elifdef(self, Loc: SourceLocation, arg: SourceRange, arg: SourceLocation) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    self.CondDirectiveStack.back() = Loc;
}

fn PPConditionalDirectiveRecord::Elifndef(self, Loc: SourceLocation, arg: *Token, arg: *MacroDefinition) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    self.CondDirectiveStack.back() = Loc;
}

fn PPConditionalDirectiveRecord::Elifndef(self, Loc: SourceLocation, arg: SourceRange, arg: SourceLocation) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    self.CondDirectiveStack.back() = Loc;
}

fn PPConditionalDirectiveRecord::Else(self, Loc: SourceLocation, IfLoc: SourceLocation) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    self.CondDirectiveStack.back() = Loc;
}

fn PPConditionalDirectiveRecord::Endif(self, Loc: SourceLocation, IfLoc: SourceLocation) {
    self.addCondDirectiveLoc(CondDirectiveLoc { Loc, self.CondDirectiveStack.back() });
    assert!(!self.CondDirectiveStack.is_empty();
    self.CondDirectiveStack.pop();
}

fn PPConditionalDirectiveRecord::getTotalMemory(self: *PPConditionalDirectiveRecord) -> u64 {
    return capacity_in_bytes(self.CondDirectiveLocs);
}
