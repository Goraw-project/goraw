fn Preprocessor::PoisonSEHIdentifiers(self, Poison: bool) {
    assert!(self.Ident__exception_code && self.Ident__exception_info);
    assert!(self.Ident___exception_code && self.Ident___exception_info);
    self.Ident__exception_code.setIsPoisoned(Poison);
    self.Ident___exception_code.setIsPoisoned(Poison);
    self.Ident_GetExceptionCode.setIsPoisoned(Poison);
    self.Ident__exception_info.setIsPoisoned(Poison);
    self.Ident___exception_info.setIsPoisoned(Poison);
    self.Ident_GetExceptionInfo.setIsPoisoned(Poison);
    self.Ident__abnormal_termination.setIsPoisoned(Poison);
    self.Ident___abnormal_termination.setIsPoisoned(Poison);
    self.Ident_AbnormalTermination.setIsPoisoned(Poison);
}

