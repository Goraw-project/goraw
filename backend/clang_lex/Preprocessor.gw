                }
            }
        }
    }
    if II.isFutureCompatKeyword() && !self.DisableMacroExpansion {
        self.Diag(Identifier, self.getIdentifierTable().getFutureCompatDiagKind(II, self.getLangOpts()));
        II.setIsFutureCompatKeyword(false);
    }
    if II.IsKeywordInCPlusPlus() && !self.DisableMacroExpansion {
        << &mut II;
    }
    if II.isExtensionToken() && !self.DisableMacroExpansion {
        
    }
    if  {
        self.HandleDirective(Identifier);
        return self.hadModuleLoaderFatalFailure();
    }
    return true;
}

fn Preprocessor::Lex(self, Result: *mut Token) {
    self.LexLevel += 1;
    while !self.CurLexerCallback(*self, Result) {
        
    }
    if Result.is(unknown) && self.TheModuleLoader.HadFatalFailure {
        return;
    }
    if Result.is(code_completion) && Result.getIdentifierInfo() {
        self.setCodeCompletionIdentifierInfo(Result.getIdentifierInfo());
        self.setCodeCompletionTokenRange(Result.getLocation(), Result.getEndLoc());
        Result.setIdentifierInfo(null);
    }
    if self.getLangOpts() && self.LexLevel == 1 && !Result.getFlag(IsReinjected) {
        match Result.getKind() {
            l_paren => {
                l_square;
            },
            r_paren => {
                r_square;
            },
            r_brace => {
                self.StdCXXImportSeqState.handleCloseBrace();
            },
            annot_pragma_unused => {
                annot_pragma_vis;
            },
            header_name => {
                annot_header_unit;
            },
            kw_export => {
                if self.hasSeenNoTrivialPPDirective() {
                    Result.setFlag(HasSeenNoTrivialPPDirective);
                }
            },
            colon => {
                
            },
            kw_import => {
                if self.StdCXXImportSeqState.atTopLevel() {
                    self.TrackGMFState.handleImport(self.StdCXXImportSeqState.afterTopLevelSeq());
                    self.StdCXXImportSeqState.handleImport();
                }
            },
            kw_module => {
                if self.StdCXXImportSeqState.atTopLevel() {
                    if self.hasSeenNoTrivialPPDirective() {
                        Result.setFlag(HasSeenNoTrivialPPDirective);
                    }
                    self.TrackGMFState.handleModule(self.StdCXXImportSeqState.afterTopLevelSeq());
                }
            },
            annot_module_name => {
                
            },
            _ => {
                self.TrackGMFState.handleMisc();
            },
        }
    }
    if  {
        self.CheckPointCounter = 0;
    }
    if Result.isNot(kw_export) {
        self.LastExportKeyword.startToken();
    }
    self.LexLevel -= 1;
    if (self.LexLevel == 0 || self.PreprocessToken) && !Result.getFlag(IsReinjected) {
        if self.LexLevel == 0 {
            self.TokenCount += 1;
        }
    }
}

fn Preprocessor::LexTokensUntilEOF(self, Tokens: *mut i32) {
    while 1 {
        let mut Tok: Token = Token {};
        self.Lex(Tok);
        if Tok {
            break;
        }
        if Tokens() != null {
            Tokens()(Tok);
        }
    }
}

fn Preprocessor::LexHeaderName(self, FilenameTok: *mut Token, AllowMacroExpansion: bool) -> bool {
    if self.CurPPLexer {
        if self.CurPPLexer.ParsingFilename {
            self.LexUnexpandedToken(FilenameTok);
        } else {
            self.CurPPLexer.LexIncludeFilename(FilenameTok);
        }
    } else {
        self.Lex(FilenameTok);
    }
    let mut FilenameBuffer: str = zeroed();
    if FilenameTok.is(less) && AllowMacroExpansion {
        let mut StartOfLine: bool = FilenameTok.isAtStartOfLine();
        let mut LeadingSpace: bool = FilenameTok.hasLeadingSpace();
        let mut LeadingEmptyMacro: bool = FilenameTok.hasLeadingEmptyMacro();
        let mut Start: SourceLocation = FilenameTok.getLocation();
        let mut End: SourceLocation = SourceLocation {};
        FilenameBuffer()('<');
        while FilenameTok.isNot(greater) {
            self.Lex(FilenameTok);
            if FilenameTok {
                 << greater;
                 << less;
                return true;
            }
            End = FilenameTok.getLocation();
            if FilenameTok.is(code_completion) {
                self.setCodeCompletionReached();
                self.Lex(FilenameTok);
                continue;
            }
            if FilenameTok.hasLeadingSpace() {
                FilenameBuffer()(' ');
            }
            let mut PreAppendSize: u64 = ();
            FilenameBuffer()(PreAppendSize + FilenameTok.getLength());
