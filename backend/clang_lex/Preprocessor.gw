fn Preprocessor::HandleIdentifier(self, Identifier: *mut Token) -> bool {
    assert!(Identifier.getIdentifierInfo(), "Can't handle identifiers without identifier info!");
    let mut II: *mut IdentifierInfo = *Identifier.getIdentifierInfo();
    if II.isOutOfDate() {
        let mut CurrentIsPoisoned: bool = false;
        let mut IsSpecialVariadicMacro: bool = &mut II == self.Ident__VA_ARGS__ || &mut II == self.Ident__VA_OPT__;
        if IsSpecialVariadicMacro {
            CurrentIsPoisoned = II.isPoisoned();
        }
        self.updateOutOfDateIdentifier(II);
        Identifier.setKind(II.getTokenID());
        if IsSpecialVariadicMacro {
            II.setIsPoisoned(CurrentIsPoisoned);
        }
    }
    if II.isPoisoned() && self.CurPPLexer {
        self.HandlePoisonedIdentifier(Identifier);
    }
    if self.getMacroDefinition(&mut II) {
        MD;
    } else {
        let mut MI: *MacroInfo = MD.getMacroInfo();
        assert!(MI, "macro definition with no macro info?");
        if !self.DisableMacroExpansion {
            if !Identifier.isExpandDisabled() && MI.isEnabled() {
                if !MI.isFunctionLike() ||  {
                    return self.HandleMacroExpandedIdentifier(Identifier, MD);
                }
            } else {
                Identifier.setFlag(DisableExpand);
