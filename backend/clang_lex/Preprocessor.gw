            let mut Input: optional<StringRef> = zeroed();
            if !self.isPreprocessedModuleFile() &&  {
                self.MainFileIsPreprocessedModuleFile = isPreprocessedModuleFile(*);
            }
            if Input() && !self.MainFileIsPreprocessedModuleFile && self.hasDeferredGMFInputs() {
                MainFileModuleUnitKind = scanInputForCXX20ModuleUnit(*);
            }
            let mut Tracer: auto = make_unique(*self);
            self.DirTracer = ();
            let mut FirstPPTok: optional<Token> = zeroed();
            if FirstPPTok() {
