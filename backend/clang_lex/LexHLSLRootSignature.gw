fn isNumberChar(C: i8) -> bool {
    return isdigit(C) || C == '.' || C == 'e' || C == 'E' || C == '-' || C == '+' || C == 'f' || C == 'F';
}

fn RootSignatureLexer::lexToken(self) -> RootSignatureToken {
    self.advanceBuffer(self.Buffer.take_while.len);
    if self.isEndOfBuffer() {
        return RootSignatureToken { end_of_stream, self.LocOffset };
    }
    let mut Result: RootSignatureToken = self.LocOffset;
    let mut C: i8 = self.Buffer.front();
    match C {
        '(' => {
            Result.TokKind = pu_l_paren;
            self.advanceBuffer(1);
            return Result;
        },
        ')' => {
            Result.TokKind = pu_r_paren;
            self.advanceBuffer(1);
            return Result;
        },
        ',' => {
            Result.TokKind = pu_comma;
            self.advanceBuffer(1);
            return Result;
        },
        '|' => {
            Result.TokKind = pu_or;
            self.advanceBuffer(1);
            return Result;
        },
        '=' => {
            Result.TokKind = pu_equal;
            self.advanceBuffer(1);
            return Result;
        },
        '+' => {
            Result.TokKind = pu_plus;
            self.advanceBuffer(1);
            return Result;
        },
        '-' => {
            Result.TokKind = pu_minus;
            self.advanceBuffer(1);
            return Result;
        },
        _ => {
            break;
        },
    }
    if isdigit(C) || C == '.' {
        Result.NumSpelling = self.Buffer.take_while;
        let mut IsInteger: bool = Result.NumSpelling.find_if_not == npos;
        Result.TokKind = if IsInteger { int_literal } else { float_literal };
        self.advanceBuffer(Result.NumSpelling.len);
        return Result;
    }
    if self.Buffer.len <= 1 {
        Result = RootSignatureToken { invalid, self.LocOffset };
        return Result;
    }
    let mut NextC: i8 = self.Buffer[1];
    if (C == 't' || C == 's' || C == 'u' || C == 'b') && isdigit(NextC) {
        match C {
            'b' => {
                Result.TokKind = bReg;
            },
            't' => {
                Result.TokKind = tReg;
            },
            'u' => {
                Result.TokKind = uReg;
            },
            's' => {
                Result.TokKind = sReg;
            },
            _ => {
                llvm_unreachable_internal("Switch for an expected token was not provided", "clang\\lib\\Lex\\LexHLSLRootSignature.cpp", 89);
            },
        }
        self.advanceBuffer(1);
        Result.NumSpelling = self.Buffer.take_while;
        self.advanceBuffer(Result.NumSpelling.len);
        return Result;
    }
    let mut TokSpelling: str = self.Buffer.take_while;
    let mut Switch: auto = zeroed();
    Switch()("RootSignature", kw_RootSignature);
    Switch()("RootFlags", kw_RootFlags);
    Switch()("DescriptorTable", kw_DescriptorTable);
    Switch()("RootConstants", kw_RootConstants);
    Switch()("StaticSampler", kw_StaticSampler);
    Switch()("num32BitConstants", kw_num32BitConstants);
    Switch()("CBV", kw_CBV);
    Switch()("SRV", kw_SRV);
    Switch()("UAV", kw_UAV);
    Switch()("Sampler", kw_Sampler);
    Switch()("space", kw_space);
    Switch()("visibility", kw_visibility);
    Switch()("flags", kw_flags);
    Switch()("numDescriptors", kw_numDescriptors);
    Switch()("offset", kw_offset);
    Switch()("filter", kw_filter);
    Switch()("mipLODBias", kw_mipLODBias);
    Switch()("addressU", kw_addressU);
    Switch()("addressV", kw_addressV);
    Switch()("addressW", kw_addressW);
    Switch()("maxAnisotropy", kw_maxAnisotropy);
    Switch()("comparisonFunc", kw_comparisonFunc);
    Switch()("borderColor", kw_borderColor);
    Switch()("minLOD", kw_minLOD);
    Switch()("maxLOD", kw_maxLOD);
    Switch()("unbounded", en_unbounded);
    Switch()("DESCRIPTOR_RANGE_OFFSET_APPEND", en_DescriptorRangeOffsetAppend);
    Switch()("ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT", en_AllowInputAssemblerInputLayout);
    Switch()("DENY_VERTEX_SHADER_ROOT_ACCESS", en_DenyVertexShaderRootAccess);
    Switch()("DENY_HULL_SHADER_ROOT_ACCESS", en_DenyHullShaderRootAccess);
    Switch()("DENY_DOMAIN_SHADER_ROOT_ACCESS", en_DenyDomainShaderRootAccess);
    Switch()("DENY_GEOMETRY_SHADER_ROOT_ACCESS", en_DenyGeometryShaderRootAccess);
    Switch()("DENY_PIXEL_SHADER_ROOT_ACCESS", en_DenyPixelShaderRootAccess);
    Switch()("DENY_AMPLIFICATION_SHADER_ROOT_ACCESS", en_DenyAmplificationShaderRootAccess);
    Switch()("DENY_MESH_SHADER_ROOT_ACCESS", en_DenyMeshShaderRootAccess);
    Switch()("ALLOW_STREAM_OUTPUT", en_AllowStreamOutput);
    Switch()("LOCAL_ROOT_SIGNATURE", en_LocalRootSignature);
    Switch()("CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED", en_CBVSRVUAVHeapDirectlyIndexed);
    Switch()("SAMPLER_HEAP_DIRECTLY_INDEXED", en_SamplerHeapDirectlyIndexed);
    Switch()("DATA_VOLATILE", en_DataVolatile);
    Switch()("DATA_STATIC_WHILE_SET_AT_EXECUTE", en_DataStaticWhileSetAtExecute);
    Switch()("DATA_STATIC", en_DataStatic);
    Switch()("DESCRIPTORS_VOLATILE", en_DescriptorsVolatile);
    Switch()("DESCRIPTORS_STATIC_KEEPING_BUFFER_BOUNDS_CHECKS", en_DescriptorsStaticKeepingBufferBoundsChecks);
    Switch()("SHADER_VISIBILITY_ALL", en_All);
    Switch()("SHADER_VISIBILITY_VERTEX", en_Vertex);
    Switch()("SHADER_VISIBILITY_HULL", en_Hull);
    Switch()("SHADER_VISIBILITY_DOMAIN", en_Domain);
    Switch()("SHADER_VISIBILITY_GEOMETRY", en_Geometry);
    Switch()("SHADER_VISIBILITY_PIXEL", en_Pixel);
    Switch()("SHADER_VISIBILITY_AMPLIFICATION", en_Amplification);
    Switch()("SHADER_VISIBILITY_MESH", en_Mesh);
    Switch()("FILTER_MIN_MAG_MIP_POINT", en_MinMagMipPoint);
    Switch()("FILTER_MIN_MAG_POINT_MIP_LINEAR", en_MinMagPointMipLinear);
    Switch()("FILTER_MIN_POINT_MAG_LINEAR_MIP_POINT", en_MinPointMagLinearMipPoint);
    Switch()("FILTER_MIN_POINT_MAG_MIP_LINEAR", en_MinPointMagMipLinear);
    Switch()("FILTER_MIN_LINEAR_MAG_MIP_POINT", en_MinLinearMagMipPoint);
    Switch()("FILTER_MIN_LINEAR_MAG_POINT_MIP_LINEAR", en_MinLinearMagPointMipLinear);
    Switch()("FILTER_MIN_MAG_LINEAR_MIP_POINT", en_MinMagLinearMipPoint);
    Switch()("FILTER_MIN_MAG_MIP_LINEAR", en_MinMagMipLinear);
    Switch()("FILTER_ANISOTROPIC", en_Anisotropic);
    Switch()("FILTER_COMPARISON_MIN_MAG_MIP_POINT", en_ComparisonMinMagMipPoint);
    Switch()("FILTER_COMPARISON_MIN_MAG_POINT_MIP_LINEAR", en_ComparisonMinMagPointMipLinear);
    Switch()("FILTER_COMPARISON_MIN_POINT_MAG_LINEAR_MIP_POINT", en_ComparisonMinPointMagLinearMipPoint);
    Switch()("FILTER_COMPARISON_MIN_POINT_MAG_MIP_LINEAR", en_ComparisonMinPointMagMipLinear);
    Switch()("FILTER_COMPARISON_MIN_LINEAR_MAG_MIP_POINT", en_ComparisonMinLinearMagMipPoint);
    Switch()("FILTER_COMPARISON_MIN_LINEAR_MAG_POINT_MIP_LINEAR", en_ComparisonMinLinearMagPointMipLinear);
    Switch()("FILTER_COMPARISON_MIN_MAG_LINEAR_MIP_POINT", en_ComparisonMinMagLinearMipPoint);
    Switch()("FILTER_COMPARISON_MIN_MAG_MIP_LINEAR", en_ComparisonMinMagMipLinear);
    Switch()("FILTER_COMPARISON_ANISOTROPIC", en_ComparisonAnisotropic);
    Switch()("FILTER_MINIMUM_MIN_MAG_MIP_POINT", en_MinimumMinMagMipPoint);
    Switch()("FILTER_MINIMUM_MIN_MAG_POINT_MIP_LINEAR", en_MinimumMinMagPointMipLinear);
    Switch()("FILTER_MINIMUM_MIN_POINT_MAG_LINEAR_MIP_POINT", en_MinimumMinPointMagLinearMipPoint);
    Switch()("FILTER_MINIMUM_MIN_POINT_MAG_MIP_LINEAR", en_MinimumMinPointMagMipLinear);
    Switch()("FILTER_MINIMUM_MIN_LINEAR_MAG_MIP_POINT", en_MinimumMinLinearMagMipPoint);
    Switch()("FILTER_MINIMUM_MIN_LINEAR_MAG_POINT_MIP_LINEAR", en_MinimumMinLinearMagPointMipLinear);
    Switch()("FILTER_MINIMUM_MIN_MAG_LINEAR_MIP_POINT", en_MinimumMinMagLinearMipPoint);
    Switch()("FILTER_MINIMUM_MIN_MAG_MIP_LINEAR", en_MinimumMinMagMipLinear);
    Switch()("FILTER_MINIMUM_ANISOTROPIC", en_MinimumAnisotropic);
    Switch()("FILTER_MAXIMUM_MIN_MAG_MIP_POINT", en_MaximumMinMagMipPoint);
    Switch()("FILTER_MAXIMUM_MIN_MAG_POINT_MIP_LINEAR", en_MaximumMinMagPointMipLinear);
    Switch()("FILTER_MAXIMUM_MIN_POINT_MAG_LINEAR_MIP_POINT", en_MaximumMinPointMagLinearMipPoint);
    Switch()("FILTER_MAXIMUM_MIN_POINT_MAG_MIP_LINEAR", en_MaximumMinPointMagMipLinear);
    Switch()("FILTER_MAXIMUM_MIN_LINEAR_MAG_MIP_POINT", en_MaximumMinLinearMagMipPoint);
    Switch()("FILTER_MAXIMUM_MIN_LINEAR_MAG_POINT_MIP_LINEAR", en_MaximumMinLinearMagPointMipLinear);
    Switch()("FILTER_MAXIMUM_MIN_MAG_LINEAR_MIP_POINT", en_MaximumMinMagLinearMipPoint);
    Switch()("FILTER_MAXIMUM_MIN_MAG_MIP_LINEAR", en_MaximumMinMagMipLinear);
    Switch()("FILTER_MAXIMUM_ANISOTROPIC", en_MaximumAnisotropic);
    Switch()("TEXTURE_ADDRESS_WRAP", en_Wrap);
    Switch()("TEXTURE_ADDRESS_MIRROR", en_Mirror);
    Switch()("TEXTURE_ADDRESS_CLAMP", en_Clamp);
    Switch()("TEXTURE_ADDRESS_BORDER", en_Border);
    Switch()("TEXTURE_ADDRESS_MIRRORONCE", en_MirrorOnce);
    Switch()("COMPARISON_NEVER", en_Never);
    Switch()("COMPARISON_LESS", en_Less);
    Switch()("COMPARISON_EQUAL", en_Equal);
    Switch()("COMPARISON_LESS_EQUAL", en_LessEqual);
    Switch()("COMPARISON_GREATER", en_Greater);
    Switch()("COMPARISON_NOT_EQUAL", en_NotEqual);
    Switch()("COMPARISON_GREATER_EQUAL", en_GreaterEqual);
    Switch()("COMPARISON_ALWAYS", en_Always);
    Switch()("STATIC_BORDER_COLOR_TRANSPARENT_BLACK", en_TransparentBlack);
    Switch()("STATIC_BORDER_COLOR_OPAQUE_BLACK", en_OpaqueBlack);
    Switch()("STATIC_BORDER_COLOR_OPAQUE_WHITE", en_OpaqueWhite);
    Switch()("STATIC_BORDER_COLOR_OPAQUE_BLACK_UINT", en_OpaqueBlackUint);
    Switch()("STATIC_BORDER_COLOR_OPAQUE_WHITE_UINT", en_OpaqueWhiteUint);
    Switch()("UINT_BORDER_COLOR", en_UintBorderColor);
    Switch()("NON_NORMALIZED_COORDINATES", en_NonNormalizedCoordinates);
    Result.TokKind = (invalid);
    self.advanceBuffer(TokSpelling.len);
    return Result;
}

fn RootSignatureLexer::consumeToken(self) -> RootSignatureToken {
    if  {
        let mut Result: RootSignatureToken = zeroed();
        return Result;
    }
    return self.lexToken();
}

fn RootSignatureLexer::peekNextToken(self) -> RootSignatureToken {}
