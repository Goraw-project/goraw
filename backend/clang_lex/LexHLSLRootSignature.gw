fn isNumberChar(C: i8) -> bool {
    return isdigit(C) || C == '.' || C == 'e' || C == 'E' || C == '-' || C == '+' || C == 'f' || C == 'F';
}

fn RootSignatureLexer::lexToken(self) -> RootSignatureToken {
    self.advanceBuffer(self.Buffer.take_while(function_ref<bool (char)> { isspace, null, null }).len);
    if self.isEndOfBuffer() {
        return RootSignatureToken { end_of_stream, self.LocOffset };
    }
    let mut Result: RootSignatureToken = self.LocOffset;
    let mut C: i8 = self.Buffer.front();
    match C {
        '(' => {
            Result.TokKind = pu_l_paren;
            self.advanceBuffer(1);
            return Result;
        },
        ')' => {
            Result.TokKind = pu_r_paren;
            self.advanceBuffer(1);
            return Result;
        },
        ',' => {
            Result.TokKind = pu_comma;
            self.advanceBuffer(1);
            return Result;
        },
        '|' => {
            Result.TokKind = pu_or;
            self.advanceBuffer(1);
            return Result;
        },
        '=' => {
            Result.TokKind = pu_equal;
            self.advanceBuffer(1);
            return Result;
        },
        '+' => {
            Result.TokKind = pu_plus;
            self.advanceBuffer(1);
            return Result;
        },
        '-' => {
            Result.TokKind = pu_minus;
            self.advanceBuffer(1);
            return Result;
        },
        _ => {
            break;
        },
    }
    if isdigit(C) || C == '.' {
        Result.NumSpelling = self.Buffer.take_while(function_ref<bool (char)> { isNumberChar, null, null });
        let mut IsInteger: bool = Result.NumSpelling.find_if_not(function_ref<bool (char)> { isdigit, null, null }, 0) == npos;
        Result.TokKind = if IsInteger { int_literal } else { float_literal };
        self.advanceBuffer(Result.NumSpelling.len);
        return Result;
    }
    if self.Buffer.len <= 1 {
        Result = RootSignatureToken { invalid, self.LocOffset };
        return Result;
    }
    let mut NextC: i8 = self.Buffer[1];
    if (C == 't' || C == 's' || C == 'u' || C == 'b') && isdigit(NextC) {
        match C {
            'b' => {
                Result.TokKind = bReg;
            },
            't' => {
                Result.TokKind = tReg;
            },
            'u' => {
                Result.TokKind = uReg;
            },
            's' => {
                Result.TokKind = sReg;
            },
            _ => {
                llvm_unreachable_internal("Switch for an expected token was not provided", "P:/Goraw/llvm-project/clang/lib/Lex/LexHLSLRootSignature.cpp", 89);
            },
        }
        self.advanceBuffer(1);
        Result.NumSpelling = self.Buffer.take_while(function_ref<bool (char)> { isNumberChar, null, null });
        self.advanceBuffer(Result.NumSpelling.len);
        return Result;
    }
    let mut TokSpelling: str = self.Buffer.take_while(function_ref<bool (char)> { Closure_1 {}, null, null });
    let mut Switch: StringSwitch<TokenKind> = TokSpelling;
    Switch.CaseLower("RootSignature", kw_RootSignature);
    Switch.CaseLower("RootFlags", kw_RootFlags);
    Switch.CaseLower("DescriptorTable", kw_DescriptorTable);
    Switch.CaseLower("RootConstants", kw_RootConstants);
    Switch.CaseLower("StaticSampler", kw_StaticSampler);
    Switch.CaseLower("num32BitConstants", kw_num32BitConstants);
    Switch.CaseLower("CBV", kw_CBV);
    Switch.CaseLower("SRV", kw_SRV);
    Switch.CaseLower("UAV", kw_UAV);
    Switch.CaseLower("Sampler", kw_Sampler);
    Switch.CaseLower("space", kw_space);
    Switch.CaseLower("visibility", kw_visibility);
    Switch.CaseLower("flags", kw_flags);
    Switch.CaseLower("numDescriptors", kw_numDescriptors);
    Switch.CaseLower("offset", kw_offset);
    Switch.CaseLower("filter", kw_filter);
    Switch.CaseLower("mipLODBias", kw_mipLODBias);
    Switch.CaseLower("addressU", kw_addressU);
    Switch.CaseLower("addressV", kw_addressV);
    Switch.CaseLower("addressW", kw_addressW);
    Switch.CaseLower("maxAnisotropy", kw_maxAnisotropy);
    Switch.CaseLower("comparisonFunc", kw_comparisonFunc);
    Switch.CaseLower("borderColor", kw_borderColor);
    Switch.CaseLower("minLOD", kw_minLOD);
    Switch.CaseLower("maxLOD", kw_maxLOD);
    Switch.CaseLower("unbounded", en_unbounded);
    Switch.CaseLower("DESCRIPTOR_RANGE_OFFSET_APPEND", en_DescriptorRangeOffsetAppend);
    Switch.CaseLower("ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT", en_AllowInputAssemblerInputLayout);
    Switch.CaseLower("DENY_VERTEX_SHADER_ROOT_ACCESS", en_DenyVertexShaderRootAccess);
    Switch.CaseLower("DENY_HULL_SHADER_ROOT_ACCESS", en_DenyHullShaderRootAccess);
    Switch.CaseLower("DENY_DOMAIN_SHADER_ROOT_ACCESS", en_DenyDomainShaderRootAccess);
    Switch.CaseLower("DENY_GEOMETRY_SHADER_ROOT_ACCESS", en_DenyGeometryShaderRootAccess);
    Switch.CaseLower("DENY_PIXEL_SHADER_ROOT_ACCESS", en_DenyPixelShaderRootAccess);
    Switch.CaseLower("DENY_AMPLIFICATION_SHADER_ROOT_ACCESS", en_DenyAmplificationShaderRootAccess);
    Switch.CaseLower("DENY_MESH_SHADER_ROOT_ACCESS", en_DenyMeshShaderRootAccess);
    Switch.CaseLower("ALLOW_STREAM_OUTPUT", en_AllowStreamOutput);
    Switch.CaseLower("LOCAL_ROOT_SIGNATURE", en_LocalRootSignature);
    Switch.CaseLower("CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED", en_CBVSRVUAVHeapDirectlyIndexed);
    Switch.CaseLower("SAMPLER_HEAP_DIRECTLY_INDEXED", en_SamplerHeapDirectlyIndexed);
    Switch.CaseLower("DATA_VOLATILE", en_DataVolatile);
    Switch.CaseLower("DATA_STATIC_WHILE_SET_AT_EXECUTE", en_DataStaticWhileSetAtExecute);
    Switch.CaseLower("DATA_STATIC", en_DataStatic);
    Switch.CaseLower("DESCRIPTORS_VOLATILE", en_DescriptorsVolatile);
    Switch.CaseLower("DESCRIPTORS_STATIC_KEEPING_BUFFER_BOUNDS_CHECKS", en_DescriptorsStaticKeepingBufferBoundsChecks);
    Switch.CaseLower("SHADER_VISIBILITY_ALL", en_All);
    Switch.CaseLower("SHADER_VISIBILITY_VERTEX", en_Vertex);
    Switch.CaseLower("SHADER_VISIBILITY_HULL", en_Hull);
    Switch.CaseLower("SHADER_VISIBILITY_DOMAIN", en_Domain);
    Switch.CaseLower("SHADER_VISIBILITY_GEOMETRY", en_Geometry);
    Switch.CaseLower("SHADER_VISIBILITY_PIXEL", en_Pixel);
    Switch.CaseLower("SHADER_VISIBILITY_AMPLIFICATION", en_Amplification);
    Switch.CaseLower("SHADER_VISIBILITY_MESH", en_Mesh);
    Switch.CaseLower("FILTER_MIN_MAG_MIP_POINT", en_MinMagMipPoint);
    Switch.CaseLower("FILTER_MIN_MAG_POINT_MIP_LINEAR", en_MinMagPointMipLinear);
    Switch.CaseLower("FILTER_MIN_POINT_MAG_LINEAR_MIP_POINT", en_MinPointMagLinearMipPoint);
    Switch.CaseLower("FILTER_MIN_POINT_MAG_MIP_LINEAR", en_MinPointMagMipLinear);
    Switch.CaseLower("FILTER_MIN_LINEAR_MAG_MIP_POINT", en_MinLinearMagMipPoint);
    Switch.CaseLower("FILTER_MIN_LINEAR_MAG_POINT_MIP_LINEAR", en_MinLinearMagPointMipLinear);
    Switch.CaseLower("FILTER_MIN_MAG_LINEAR_MIP_POINT", en_MinMagLinearMipPoint);
    Switch.CaseLower("FILTER_MIN_MAG_MIP_LINEAR", en_MinMagMipLinear);
    Switch.CaseLower("FILTER_ANISOTROPIC", en_Anisotropic);
    Switch.CaseLower("FILTER_COMPARISON_MIN_MAG_MIP_POINT", en_ComparisonMinMagMipPoint);
    Switch.CaseLower("FILTER_COMPARISON_MIN_MAG_POINT_MIP_LINEAR", en_ComparisonMinMagPointMipLinear);
    Switch.CaseLower("FILTER_COMPARISON_MIN_POINT_MAG_LINEAR_MIP_POINT", en_ComparisonMinPointMagLinearMipPoint);
    Switch.CaseLower("FILTER_COMPARISON_MIN_POINT_MAG_MIP_LINEAR", en_ComparisonMinPointMagMipLinear);
    Switch.CaseLower("FILTER_COMPARISON_MIN_LINEAR_MAG_MIP_POINT", en_ComparisonMinLinearMagMipPoint);
    Switch.CaseLower("FILTER_COMPARISON_MIN_LINEAR_MAG_POINT_MIP_LINEAR", en_ComparisonMinLinearMagPointMipLinear);
    Switch.CaseLower("FILTER_COMPARISON_MIN_MAG_LINEAR_MIP_POINT", en_ComparisonMinMagLinearMipPoint);
    Switch.CaseLower("FILTER_COMPARISON_MIN_MAG_MIP_LINEAR", en_ComparisonMinMagMipLinear);
    Switch.CaseLower("FILTER_COMPARISON_ANISOTROPIC", en_ComparisonAnisotropic);
    Switch.CaseLower("FILTER_MINIMUM_MIN_MAG_MIP_POINT", en_MinimumMinMagMipPoint);
    Switch.CaseLower("FILTER_MINIMUM_MIN_MAG_POINT_MIP_LINEAR", en_MinimumMinMagPointMipLinear);
    Switch.CaseLower("FILTER_MINIMUM_MIN_POINT_MAG_LINEAR_MIP_POINT", en_MinimumMinPointMagLinearMipPoint);
    Switch.CaseLower("FILTER_MINIMUM_MIN_POINT_MAG_MIP_LINEAR", en_MinimumMinPointMagMipLinear);
    Switch.CaseLower("FILTER_MINIMUM_MIN_LINEAR_MAG_MIP_POINT", en_MinimumMinLinearMagMipPoint);
    Switch.CaseLower("FILTER_MINIMUM_MIN_LINEAR_MAG_POINT_MIP_LINEAR", en_MinimumMinLinearMagPointMipLinear);
    Switch.CaseLower("FILTER_MINIMUM_MIN_MAG_LINEAR_MIP_POINT", en_MinimumMinMagLinearMipPoint);
    Switch.CaseLower("FILTER_MINIMUM_MIN_MAG_MIP_LINEAR", en_MinimumMinMagMipLinear);
    Switch.CaseLower("FILTER_MINIMUM_ANISOTROPIC", en_MinimumAnisotropic);
    Switch.CaseLower("FILTER_MAXIMUM_MIN_MAG_MIP_POINT", en_MaximumMinMagMipPoint);
    Switch.CaseLower("FILTER_MAXIMUM_MIN_MAG_POINT_MIP_LINEAR", en_MaximumMinMagPointMipLinear);
    Switch.CaseLower("FILTER_MAXIMUM_MIN_POINT_MAG_LINEAR_MIP_POINT", en_MaximumMinPointMagLinearMipPoint);
    Switch.CaseLower("FILTER_MAXIMUM_MIN_POINT_MAG_MIP_LINEAR", en_MaximumMinPointMagMipLinear);
    Switch.CaseLower("FILTER_MAXIMUM_MIN_LINEAR_MAG_MIP_POINT", en_MaximumMinLinearMagMipPoint);
    Switch.CaseLower("FILTER_MAXIMUM_MIN_LINEAR_MAG_POINT_MIP_LINEAR", en_MaximumMinLinearMagPointMipLinear);
    Switch.CaseLower("FILTER_MAXIMUM_MIN_MAG_LINEAR_MIP_POINT", en_MaximumMinMagLinearMipPoint);
    Switch.CaseLower("FILTER_MAXIMUM_MIN_MAG_MIP_LINEAR", en_MaximumMinMagMipLinear);
    Switch.CaseLower("FILTER_MAXIMUM_ANISOTROPIC", en_MaximumAnisotropic);
    Switch.CaseLower("TEXTURE_ADDRESS_WRAP", en_Wrap);
    Switch.CaseLower("TEXTURE_ADDRESS_MIRROR", en_Mirror);
    Switch.CaseLower("TEXTURE_ADDRESS_CLAMP", en_Clamp);
    Switch.CaseLower("TEXTURE_ADDRESS_BORDER", en_Border);
    Switch.CaseLower("TEXTURE_ADDRESS_MIRRORONCE", en_MirrorOnce);
    Switch.CaseLower("COMPARISON_NEVER", en_Never);
    Switch.CaseLower("COMPARISON_LESS", en_Less);
    Switch.CaseLower("COMPARISON_EQUAL", en_Equal);
    Switch.CaseLower("COMPARISON_LESS_EQUAL", en_LessEqual);
    Switch.CaseLower("COMPARISON_GREATER", en_Greater);
    Switch.CaseLower("COMPARISON_NOT_EQUAL", en_NotEqual);
    Switch.CaseLower("COMPARISON_GREATER_EQUAL", en_GreaterEqual);
    Switch.CaseLower("COMPARISON_ALWAYS", en_Always);
    Switch.CaseLower("STATIC_BORDER_COLOR_TRANSPARENT_BLACK", en_TransparentBlack);
    Switch.CaseLower("STATIC_BORDER_COLOR_OPAQUE_BLACK", en_OpaqueBlack);
    Switch.CaseLower("STATIC_BORDER_COLOR_OPAQUE_WHITE", en_OpaqueWhite);
    Switch.CaseLower("STATIC_BORDER_COLOR_OPAQUE_BLACK_UINT", en_OpaqueBlackUint);
    Switch.CaseLower("STATIC_BORDER_COLOR_OPAQUE_WHITE_UINT", en_OpaqueWhiteUint);
    Switch.CaseLower("UINT_BORDER_COLOR", en_UintBorderColor);
    Switch.CaseLower("NON_NORMALIZED_COORDINATES", en_NonNormalizedCoordinates);
    Result.TokKind = Switch.Default(invalid);
    self.advanceBuffer(TokSpelling.len);
    return Result;
}

fn RootSignatureLexer::consumeToken(self) -> RootSignatureToken {
    if self.NextToken && operator(self.NextToken).TokKind != end_of_stream {
        let mut Result: RootSignatureToken = operator(self.NextToken);
        self.NextToken = nullopt;
        return Result;
    }
    return self.lexToken();
}

fn RootSignatureLexer::peekNextToken(self) -> RootSignatureToken {
    if self.NextToken {
        return operator(self.NextToken);
    }
    self.NextToken = self.lexToken();
    return operator(self.NextToken);
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, C: i8) -> bool {
        return isalnum(C) || C == '_';
    }
