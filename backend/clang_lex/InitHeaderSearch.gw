struct DirectoryLookupInfo {
    Group: IncludeDirGroup,
    Lookup: DirectoryLookup,
    UserEntryIdx: optional<unsigned int>,
}

fn DirectoryLookupInfo::operator=(self, arg: *mut *mut DirectoryLookupInfo) -> *mut DirectoryLookupInfo {
    self.Group =  as DirectoryLookupInfo.Group;
    self.Lookup.operator=( as DirectoryLookupInfo.Lookup);
    self.UserEntryIdx.operator=( as DirectoryLookupInfo.UserEntryIdx);
    return *self;
}

struct InitHeaderSearch {
    IncludePath: []DirectoryLookupInfo,
    SystemHeaderPrefixes: []string, bool>,
    Headers: *mut HeaderSearch,
    Verbose: bool,
    IncludeSysroot: str,
    HasSysroot: bool,
}

fn InitHeaderSearch::AddSystemHeaderPrefix(self, Prefix: str, IsSystemHeader: bool) {
    self.SystemHeaderPrefixes.push(Prefix[0..allocator<char> {}], IsSystemHeader);
}

fn CanPrefixSysroot(Path: str) -> bool {
    return !Path.is_empty() && is_separator(Path[0], native);
}

fn InitHeaderSearch::AddPath(self, Path: str, Group: IncludeDirGroup, isFramework: bool, UserEntryIdx: optional<unsigned int>) -> bool {
    if self.HasSysroot {
        let mut MappedPathStorage: str = "";
        let mut MappedPathStr: str = Path.toStringRef(MappedPathStorage);
        if CanPrefixSysroot(MappedPathStr) {
            return self.AddUnmappedPath(self.IncludeSysroot + Path, Group, isFramework, UserEntryIdx);
        }
    }
    return self.AddUnmappedPath(Path, Group, isFramework, UserEntryIdx);
}

fn InitHeaderSearch::AddUnmappedPath(self, Path: str, Group: IncludeDirGroup, isFramework: bool, UserEntryIdx: optional<unsigned int>) -> bool {
    assert!(!Path.isTriviallyEmpty(), "can't handle empty path here");
    let mut FM: *mut FileManager = self.Headers.getFileMgr();
    let mut MappedPathStorage: str = "";
    let mut MappedPathStr: str = Path.toStringRef(MappedPathStorage);
    if self.HasSysroot && (MappedPathStr.starts_with("/usr/include") || MappedPathStr.starts_with("/usr/local/include")) {
        self.Headers.getDiags().Report(warn_poison_system_directories) << MappedPathStr;
    }
    let mut Type: CharacteristicKind = zeroed();
    if Group == Quoted || Group == Angled {
        Type = C_User;
    } else if Group == ExternCSystem {
        Type = C_ExternCSystem;
    } else {
        Type = C_System;
    }
    if FM.getOptionalDirectoryRef(MappedPathStr, true) {
        DE;
    } else {
        self.IncludePath.push(Group, DirectoryLookup { operator(DE), Type, isFramework }, UserEntryIdx);
        return true;
    }
    if !isFramework {
        if FM.getOptionalFileRef(MappedPathStr, false, true, true) {
            FE;
        } else {
            if self.Headers.CreateHeaderMap(operator(FE)) {
                HM;
            } else {
                self.IncludePath.push(Group, DirectoryLookup { HM, Type }, UserEntryIdx);
                return true;
            }
        }
    }
    if self.Verbose {
        errs() << "ignoring nonexistent directory \"" << MappedPathStr << "\"\n";
    }
    return false;
}

fn InitHeaderSearch::AddDefaultCIncludePaths(self, triple: *Triple, HSOpts: *HeaderSearchOptions) {
    if !self.ShouldAddDefaultIncludePaths(triple) {
        llvm_unreachable_internal("Include management is handled in the driver.", "P:/Goraw/llvm-project/clang/lib/Lex/InitHeaderSearch.cpp", 176);
    }
    if HSOpts.UseStandardSystemIncludes {
        self.AddPath("/usr/local/include", System, false, nullopt);
    }
    if HSOpts.UseBuiltinIncludes {
        let mut P: str = HSOpts.ResourceDir;
        append(P, "include", "", "", "");
        self.AddUnmappedPath(P, ExternCSystem, false, nullopt);
    }
    if !HSOpts.UseStandardSystemIncludes {
        return;
    }
    let mut CIncludeDirs: str = "";
    if CIncludeDirs != "" {
        let mut dirs: SmallVector<StringRef, 5> = SmallVector<StringRef, 5> {};
        CIncludeDirs.split(dirs, ":", -1, true);
        for dir in dirs {
            self.AddPath(dir, ExternCSystem, false, nullopt);
        }
        return;
    }
    self.AddPath("/usr/include", ExternCSystem, false, nullopt);
}

fn InitHeaderSearch::ShouldAddDefaultIncludePaths(self, triple: *Triple) -> bool {
    match triple.getOS() {
        AIX => {
            DragonFly;
        },
        UnknownOS => {
            if triple.isWasm() || triple.isAppleMachO() {
                return false;
            }
        },
        _ => {
            break;
        },
    }
    if triple.isOSDarwin() {
        return false;
    }
    if triple.getArch() == hexagon {
        return false;
    }
    return true;
}

fn InitHeaderSearch::AddDefaultIncludePaths(self, Lang: *LangOptions, triple: *Triple, HSOpts: *HeaderSearchOptions) {
    if !self.ShouldAddDefaultIncludePaths(triple) {
        return;
    }
    if Lang.CPlusPlus && !Lang.AsmPreprocessor && HSOpts.UseStandardCXXIncludes && HSOpts.UseStandardSystemIncludes {
        if HSOpts.UseLibcxx {
            self.AddPath("/usr/include/c++/v1", CXXSystem, false, nullopt);
        }
    }
    self.AddDefaultCIncludePaths(triple, HSOpts);
}

fn RemoveDuplicates(SearchList: *mut []DirectoryLookupInfo, First: u32, Verbose: bool) -> u32 {
    let mut SeenDirs: SmallPtrSet<const DirectoryEntry *, 8> = SmallPtrSet<const DirectoryEntry *, 8> {};
    let mut SeenFrameworkDirs: SmallPtrSet<const DirectoryEntry *, 8> = SmallPtrSet<const DirectoryEntry *, 8> {};
    let mut SeenHeaderMaps: SmallPtrSet<const HeaderMap *, 8> = SmallPtrSet<const HeaderMap *, 8> {};
    let mut NonSystemRemoved: u32 = 0;
    for let mut i: u32 = First; i != SearchList.len; i += 1 {
        let mut DirToRemove: u32 = i;
        let mut CurEntry: *DirectoryLookup = SearchList[i].Lookup;
        if CurEntry.isNormalDir() {
            if SeenDirs.insert(CurEntry.getDir()).second {
                continue;
            }
        } else if CurEntry.isFramework() {
            if SeenFrameworkDirs.insert(CurEntry.getFrameworkDir()).second {
                continue;
            }
        } else {
            assert!(CurEntry.isHeaderMap(), "Not a headermap or normal dir?");
            if SeenHeaderMaps.insert(CurEntry.getHeaderMap()).second {
                continue;
            }
        }
        if CurEntry.getDirCharacteristic() != C_User {
            let mut FirstDir: u32 = 0;
            for FirstDir = First; ; FirstDir += 1 {
                assert!(FirstDir != i, "Didn't find dupe?");
                let mut SearchEntry: *DirectoryLookup = SearchList[FirstDir].Lookup;
                if SearchEntry.getLookupType() != CurEntry.getLookupType() {
                    continue;
                }
                let mut isSame: bool = false;
                if CurEntry.isNormalDir() {
                    isSame = SearchEntry.getDir() == CurEntry.getDir();
                } else if CurEntry.isFramework() {
                    isSame = SearchEntry.getFrameworkDir() == CurEntry.getFrameworkDir();
                } else {
                    assert!(CurEntry.isHeaderMap(), "Not a headermap or normal dir?");
                    isSame = SearchEntry.getHeaderMap() == CurEntry.getHeaderMap();
                }
                if isSame {
                    break;
                }
            }
            if SearchList[FirstDir].Lookup.getDirCharacteristic() == C_User {
                DirToRemove = FirstDir;
            }
        }
        if Verbose {
            errs() << "ignoring duplicate directory \"" << CurEntry.getName() << "\"\n";
            if DirToRemove != i {
                errs() << "  as it is a non-system directory that duplicates " << "a system directory\n";
            }
        }
        if DirToRemove != i {
            NonSystemRemoved += 1;
        }
        SearchList.erase(SearchList.begin() + DirToRemove);
        i -= 1;
    }
    return NonSystemRemoved;
}

fn extractLookups(Infos: *[]DirectoryLookupInfo) -> []DirectoryLookup {
    let mut Lookups: []DirectoryLookup = []DirectoryLookup {};
    Lookups.reserve(Infos.len);
    transform(Infos, back_inserter(Lookups), Closure_1 {});
    return Lookups;
}

fn mapToUserEntries(Infos: *[]DirectoryLookupInfo) -> DenseMap<unsigned int, unsigned int> {
    let mut LookupsToUserEntries: DenseMap<unsigned int, unsigned int> = DenseMap<unsigned int, unsigned int> {};
    for let mut I: u32 = 0;
let mut E: u32 = Infos.len; I < E; I += 1 {
        if Infos[I].UserEntryIdx {
            LookupsToUserEntries.insert(pair<unsigned int, unsigned int> { I, operator(Infos[I].UserEntryIdx) });
        }
    }
    return LookupsToUserEntries;
}

fn InitHeaderSearch::Realize(self, Lang: *LangOptions) {
    let mut SearchList: []DirectoryLookupInfo = []DirectoryLookupInfo {};
    SearchList.reserve(self.IncludePath.len);
    for Include in self.IncludePath {
        if Include.Group == Quoted {
            SearchList.push(Include);
        }
    }
    RemoveDuplicates(SearchList, 0, self.Verbose);
    let mut NumQuoted: u32 = SearchList.len;
    for Include in self.IncludePath {
        if Include.Group == Angled {
            SearchList.push(Include);
        }
    }
    RemoveDuplicates(SearchList, NumQuoted, self.Verbose);
    let mut NumAngled: u32 = SearchList.len;
    for Include in self.IncludePath {
        if Include.Group == System || Include.Group == ExternCSystem || (!Lang.ObjC && !Lang.CPlusPlus && Include.Group == CSystem) || (Lang.CPlusPlus && Include.Group == CXXSystem) || (Lang.ObjC && !Lang.CPlusPlus && Include.Group == ObjCSystem) || (Lang.ObjC && Lang.CPlusPlus && Include.Group == ObjCXXSystem) {
            SearchList.push(Include);
        }
    }
    for Include in self.IncludePath {
        if Include.Group == After {
            SearchList.push(Include);
        }
    }
    let mut NonSystemRemoved: u32 = RemoveDuplicates(SearchList, NumQuoted, self.Verbose);
    NumAngled -= NonSystemRemoved;
    self.Headers.SetSearchPaths(extractLookups(SearchList), NumQuoted, NumAngled, mapToUserEntries(SearchList));
    self.Headers.SetSystemHeaderPrefixes(self.SystemHeaderPrefixes);
    if self.Verbose {
        errs() << "#include \"...\" search starts here:\n";
        for let mut i: u32 = 0;
let mut e: u32 = SearchList.len; i != e; i += 1 {
            if i == NumQuoted {
                errs() << "#include <...> search starts here:\n";
            }
            let mut Name: str = SearchList[i].Lookup.getName();
            let mut Suffix: *u8 = null;
            if SearchList[i].Lookup.isNormalDir() {
                Suffix = "";
            } else if SearchList[i].Lookup.isFramework() {
                Suffix = " (framework directory)";
            } else {
                assert!(SearchList[i].Lookup.isHeaderMap(), "Unknown DirectoryLookup");
                Suffix = " (headermap)";
            }
            errs() << " " << Name << Suffix << "\n";
        }
        errs() << "End of search list.\n";
    }
}

fn ApplyHeaderSearchOptions(HS: *mut HeaderSearch, HSOpts: *HeaderSearchOptions, Lang: *LangOptions, Triple: *Triple) {
    let mut Init: InitHeaderSearch = InitHeaderSearch { HS, HSOpts.Verbose, HSOpts.Sysroot };
    for let mut i: u32 = 0;
let mut e: u32 = HSOpts.UserEntries.len; i != e; i += 1 {
        let mut E: *Entry = HSOpts.UserEntries[i];
        if E.IgnoreSysRoot {
            Init.AddUnmappedPath(E.Path, E.Group, E.IsFramework, i);
        } else {
            Init.AddPath(E.Path, E.Group, E.IsFramework, i);
        }
    }
    Init.AddDefaultIncludePaths(Lang, Triple, HSOpts);
    for let mut i: u32 = 0;
let mut e: u32 = HSOpts.SystemHeaderPrefixes.len; i != e; i += 1 {
        Init.AddSystemHeaderPrefix(HSOpts.SystemHeaderPrefixes[i].Prefix, HSOpts.SystemHeaderPrefixes[i].IsSystemHeader);
    }
    if HSOpts.UseBuiltinIncludes {
        let mut P: str = HSOpts.ResourceDir;
        append(P, "include", "", "", "");
        if HS.getFileMgr().getOptionalDirectoryRef(P.operator StringRef(), true) {
            Dir;
        } else {
            HS.getModuleMap().setBuiltinIncludeDir(operator(Dir));
        }
    }
    Init.Realize(Lang);
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Info: *DirectoryLookupInfo) -> DirectoryLookup {
        return Info.Lookup;
    }
