            Ptr += 1;
            continue;
        }
        let mut C: u32 = hexDigitValue(*Ptr += 1);
        assert!(C < self.radix, "NumericLiteralParser ctor should have rejected this");
        CharVal = C;
        OldVal = Val;
        operator(Val, RadixVal);
        OverflowOccurred |= Val.udiv(RadixVal) != OldVal;
        operator(Val, CharVal);
        OverflowOccurred |= Val.ult(CharVal);
    }
    return OverflowOccurred;
}

fn NumericLiteralParser::GetFloatValue(self, Result: *mut APFloat, RM: RoundingMode) -> opStatus {
    let mut n: u32 = min(self.SuffixBegin - self.ThisTokBegin, self.ThisTokEnd - self.ThisTokBegin);
