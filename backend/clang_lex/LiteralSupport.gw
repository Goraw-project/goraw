// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn getCharWidth(kind: TokenKind, Target: *TargetInfo) -> u32 {
    match kind {
        _ => {
            llvm_unreachable_internal("Unknown token type!", "clang\\lib\\Lex\\LiteralSupport.cpp", 43);
        },
        char_constant => {
            string_literal;
        },
        wide_char_constant => {
            wide_string_literal;
        },
        utf16_char_constant => {
            utf16_string_literal;
        },
        utf32_char_constant => {
            utf32_string_literal;
        },
    }
}

fn getEncodingPrefixLen(kind: TokenKind) -> u32 {
    match kind {
        _ => {
            llvm_unreachable_internal("Unknown token type!", "clang\\lib\\Lex\\LiteralSupport.cpp", 64);
        },
        char_constant => {
            string_literal;
        },
        utf8_char_constant => {
            utf8_string_literal;
        },
        wide_char_constant => {
            wide_string_literal;
        },
    }
}

fn MakeCharSourceRange(Features: *LangOptions, TokLoc: FullSourceLoc, TokBegin: *u8, TokRangeBegin: *u8, TokRangeEnd: *u8) -> CharSourceRange {
    let mut Begin: SourceLocation = AdvanceToTokenCharacter(TokLoc, TokRangeBegin - TokBegin, TokLoc.getManager(), Features);
    let mut End: SourceLocation = AdvanceToTokenCharacter(Begin, TokRangeEnd - TokRangeBegin, TokLoc.getManager(), Features);
    return getCharRange(Begin, End);
}

fn Diag(Diags: *mut DiagnosticsEngine, Features: *LangOptions, TokLoc: FullSourceLoc, TokBegin: *u8, TokRangeBegin: *u8, TokRangeEnd: *u8, DiagID: u32) -> DiagnosticBuilder {
    let mut Begin: SourceLocation = AdvanceToTokenCharacter(TokLoc, TokRangeBegin - TokBegin, TokLoc.getManager(), Features);
    return Diags.Report(Begin, DiagID) << MakeCharSourceRange(Features, TokLoc, TokBegin, TokRangeBegin, TokRangeEnd);
}

fn IsEscapeValidInUnevaluatedStringLiteral(Escape: i8) -> bool {
    match Escape {
        '\'' => {
            '"';
        },
    }
    return false;
}

fn convertCharacter(Char: str, Converter: *TextEncodingConverter) -> ErrorOr<char> {
    let mut ResultCharConv: str = zeroed();
    let mut EC: error_code = Converter.convert(Char);
    if EC {
        return EC();
    } else if ResultCharConv()() > 1 {
        return error_code { 7, generic_category() };
    }
    return [0];
}

fn ProcessCharEscape(ThisTokBegin: *u8, ThisTokBuf: **mut u8, ThisTokEnd: *u8, HadError: *mut bool, Loc: FullSourceLoc, CharWidth: u32, Diags: *mut DiagnosticsEngine, Features: *LangOptions, EvalMethod: StringLiteralEvalMethod, Converter: *mut TextEncodingConverter) -> u32 {
    let mut EscapeBegin: *u8 = ThisTokBuf;
    let mut Delimited: bool = false;
    let mut EndDelimiterFound: bool = false;
    ThisTokBuf += 1;
    let mut ResultChar: u32 = *ThisTokBuf += 1;
    let mut Escape: i8 = ResultChar;
    let mut Transcode: bool = true;
    let mut Invalid: bool = false;
    match ResultChar {
        '\' => {
            '\'';
        },
        'a' => {
            ResultChar = 7;
        },
        'b' => {
            ResultChar = 8;
        },
        'e' => {
            if Diags {
                Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << "e";
            }
        },
        'E' => {
            if Diags {
                Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << "E";
            }
        },
        'f' => {
            ResultChar = 12;
        },
        'n' => {
            ResultChar = 10;
        },
        'r' => {
            ResultChar = 13;
        },
        't' => {
            ResultChar = 9;
        },
        'v' => {
            ResultChar = 11;
        },
        'x' => {
            Transcode = false;
            ResultChar = 0;
            if ThisTokBuf != ThisTokEnd && *ThisTokBuf == '{' {
                Delimited = true;
                ThisTokBuf += 1;
                if *ThisTokBuf == '}' {
                    HadError = true;
                    if Diags {
                        Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf);
                    }
                }
            } else if ThisTokBuf == ThisTokEnd || !isHexDigit(*ThisTokBuf) {
                if Diags {
                    Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << "x";
                }
                return ResultChar;
            }
            let mut Overflow: bool = false;
            for ; ThisTokBuf != ThisTokEnd; ThisTokBuf += 1 {
                if Delimited && *ThisTokBuf == '}' {
                    ThisTokBuf += 1;
                    EndDelimiterFound = true;
                    break;
                }
                let mut CharVal: i32 = hexDigitValue(*ThisTokBuf);
                if CharVal == -1 {
                    if !Delimited {
                        break;
                    }
                    HadError = true;
                    if Diags {
                        Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << ThisTokBuf[0..1];
                    }
                    continue;
                }
                if ResultChar & 4026531840 {
                    Overflow = true;
                }
                ResultChar <<= 4;
                ResultChar |= CharVal;
            }
            if CharWidth != 32 && (ResultChar >> CharWidth) != 0 {
                Overflow = true;
                ResultChar &= ~0 >> (32 - CharWidth);
            }
            if !HadError && Overflow {
                HadError = true;
                if Diags {
                    Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << 0;
                }
            }
            break;
        },
        '0' => {
            '1';
        },
        'o' => {
            let mut Overflow: bool = false;
            Transcode = false;
            if ThisTokBuf == ThisTokEnd || *ThisTokBuf != '{' {
                HadError = true;
                if Diags {
                    Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << "o";
                }
                break;
            }
            ResultChar = 0;
            Delimited = true;
            ThisTokBuf += 1;
            if *ThisTokBuf == '}' {
                HadError = true;
                if Diags {
                    Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf);
                }
            }
            while ThisTokBuf != ThisTokEnd {
                if *ThisTokBuf == '}' {
                    EndDelimiterFound = true;
                    ThisTokBuf += 1;
                    break;
                }
                if *ThisTokBuf < '0' || *ThisTokBuf > '7' {
                    HadError = true;
                    if Diags {
                        Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << ThisTokBuf[0..1];
                    }
                    ThisTokBuf += 1;
                    continue;
                }
                if ResultChar & 3758096384 {
                    Overflow = true;
                }
                ResultChar <<= 3;
                ResultChar |= *ThisTokBuf += 1 - '0';
            }
            if !HadError && (Overflow || (CharWidth != 32 && (ResultChar >> CharWidth) != 0)) {
                HadError = true;
                if Diags {
                    Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << 1;
                }
                ResultChar &= ~0 >> (32 - CharWidth);
            }
            break;
        },
        '(' => {
            '{';
        },
        _ => {
            Invalid = true;
        },
    }
    if Delimited && Diags {
        if !EndDelimiterFound {
            Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << r_brace;
        } else if !HadError {
            DiagnoseDelimitedOrNamedEscapeSequence(Loc, false, Features, *Diags);
        }
    }
    if EvalMethod == Unevaluated && !IsEscapeValidInUnevaluatedStringLiteral(Escape) {
        Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << EscapeBegin[0..ThisTokBuf - EscapeBegin];
        HadError = true;
    }
    if !HadError && EvalMethod != Unevaluated && Transcode && Converter {
        assert!(ResultChar <= max() as u32);
        let mut ByteChar: i8 = if Invalid { '?' } else { ResultChar };
        let mut ErrorOrChar: auto = zeroed();
        if ErrorOrChar() {
            ResultChar = *;
        } else {
            Diag(Diags, Features, Loc, ThisTokBegin, EscapeBegin, ThisTokBuf) << ()();
            HadError = true;
        }
    }
    return ResultChar;
}

fn appendCodePoint(Codepoint: u32, Str: *mut SmallVectorImpl<char>) {
    let mut ResultBuf: [4]i8 = zeroed();
    let mut ResultPtr: *mut u8 = ResultBuf;
    if ConvertCodePointToUTF8(Codepoint, ResultPtr) {
        Str()(ResultBuf, ResultPtr);
    }
}

fn expandUCNs(Buf: *mut SmallVectorImpl<char>, Input: str) {
    for let mut I: iterator = Input.begin();
let mut E: iterator = Input.end(); I != E; I += 1 {
        if *I != '\' {
            Buf()(*I);
            continue;
        }
        I += 1;
        let mut Kind: i8 = *I;
        I += 1;
        assert!(Kind == 'u' || Kind == 'U' || Kind == 'N');
        let mut CodePoint: u32 = 0;
        if Kind == 'u' && *I == '{' {
            for I += 1; *I != '}'; I += 1 {
                let mut Value: u32 = hexDigitValue(*I);
                assert!(Value != -1);
                CodePoint <<= 4;
                CodePoint += Value;
            }
            appendCodePoint(CodePoint, Buf);
            continue;
        }
        if Kind == 'N' {
            assert!(*I == '{');
            I += 1;
            let mut Delim: auto = find(I, Input.end(), '}');
            (((operator!(operator!((Delim() != Input.end())))) || (_wassert(L"Delim != Input.end()", L"clang\\lib\\Lex\\LiteralSupport.cpp", (444) as u32) , 0)) as void);
            let mut Name: str = I;
            let mut Res: LooseMatchingResult> = zeroed();
            (((operator!(operator!((Res() && "could not find a codepoint that was previously found")))) || (_wassert(L"Res && \"could not find a codepoint that was previously found\"", L"clang\\lib\\Lex\\LiteralSupport.cpp", (448) as u32) , 0)) as void);
            CodePoint = ;
            assert!(CodePoint != 4294967295);
            appendCodePoint(CodePoint, Buf);
            I = ;
            continue;
        }
        let mut NumHexDigits: u32 = 0;
        if Kind == 'u' {
            NumHexDigits = 4;
        } else {
            NumHexDigits = 8;
        }
        assert!(I + NumHexDigits <= E);
        for ; NumHexDigits != 0; I += 1 , NumHexDigits -= 1 {
            let mut Value: u32 = hexDigitValue(*I);
            assert!(Value != -1);
            CodePoint <<= 4;
            CodePoint += Value;
        }
        appendCodePoint(CodePoint, Buf);
        I -= 1;
    }
}

fn isFunctionLocalStringLiteralMacro(K: TokenKind, LO: *LangOptions) -> bool {
    return LO() && (K == kw___FUNCTION__ || K == kw_L__FUNCTION__ || K == kw___FUNCSIG__ || K == kw_L__FUNCSIG__ || K == kw___FUNCDNAME__);
}

fn tokenIsLikeStringLiteral(Tok: *Token, LO: *LangOptions) -> bool {
    return isStringLiteral(Tok.getKind()) || isFunctionLocalStringLiteralMacro(Tok.getKind(), LO);
}

fn ProcessNumericUCNEscape(ThisTokBegin: *u8, ThisTokBuf: **mut u8, ThisTokEnd: *u8, UcnVal: *mut u32, UcnLen: *mut u16, Delimited: *mut bool, Loc: FullSourceLoc, Diags: *mut DiagnosticsEngine, Features: *LangOptions, in_char_string_literal: bool) -> bool {
    let mut UcnBegin: *u8 = ThisTokBuf;
    let mut HasError: bool = false;
    let mut EndDelimiterFound: bool = false;
    ThisTokBuf += 2;
    Delimited = false;
    if UcnBegin[1] == 'u' && in_char_string_literal && ThisTokBuf != ThisTokEnd && *ThisTokBuf == '{' {
        Delimited = true;
        ThisTokBuf += 1;
    } else if ThisTokBuf == ThisTokEnd || !isHexDigit(*ThisTokBuf) {
        if Diags {
            Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf) << &mut ThisTokBuf[-1][0..1];
        }
        return false;
    }
    UcnLen = (if ThisTokBuf[-1] == 'u' { 4 } else { 8 });
    let mut Overflow: bool = false;
    let mut Count: u16 = 0;
    for ; ThisTokBuf != ThisTokEnd && (Delimited || Count != UcnLen); ThisTokBuf += 1 {
        if Delimited && *ThisTokBuf == '}' {
            ThisTokBuf += 1;
            EndDelimiterFound = true;
            break;
        }
        let mut CharVal: i32 = hexDigitValue(*ThisTokBuf);
        if CharVal == -1 {
            HasError = true;
            if !Delimited {
                break;
            }
            if Diags {
                Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf) << ThisTokBuf[0..1];
            }
            Count += 1;
            continue;
        }
        if UcnVal & 4026531840 {
            Overflow = true;
            continue;
        }
        UcnVal <<= 4;
        UcnVal |= CharVal;
        Count += 1;
    }
    if Overflow {
        if Diags {
            Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf) << 0;
        }
        return false;
    }
    if Delimited && !EndDelimiterFound {
        if Diags {
            Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf) << r_brace;
        }
        return false;
    }
    if Count == 0 || (!Delimited && Count != UcnLen) {
        if Diags {
            Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf);
        }
        return false;
    }
    return !HasError;
}

fn allowedInCharacterName(C: i8) -> bool {
    return (C >= 'A' && C <= 'Z') || (C >= '0' && C <= '9') || C == '-' || C == ' ';
}

fn DiagnoseInvalidUnicodeCharacterName(Diags: *mut DiagnosticsEngine, Features: *LangOptions, Loc: FullSourceLoc, TokBegin: *u8, TokRangeBegin: *u8, TokRangeEnd: *u8, Name: str) {
    Diag(Diags, Features, Loc, TokBegin, TokRangeBegin, TokRangeEnd) << Name;
    let mut HasIllegalCharacter: bool = false;
    for let mut P: *u8 = Name.begin();
let mut E: *u8 = Name.end(); P != E;  {
        if allowedInCharacterName(*P) {
            P += 1;
            continue;
        }
        let mut CharLoc: SourceLocation = AdvanceToTokenCharacter(Loc, (TokRangeBegin - TokBegin) + (P - Name.begin()), Loc.getManager(), Features);
        Diags << EscapeSingleCodepointForDiagnostic(P);
        HasIllegalCharacter = true;
        break;
    }
    let mut Res: LooseMatchingResult> = zeroed();
    if Res() {
        Diag(Diags, Features, Loc, TokBegin, TokRangeBegin, TokRangeEnd) << CreateReplacement(MakeCharSourceRange(Features, Loc, TokBegin, TokRangeBegin, TokRangeEnd));
        return;
    }
    if HasIllegalCharacter {
        return;
    }
    let mut Distance: u32 = 0;
    let mut Matches: i32 = (Name, 5);
    (((operator!(operator!((operator!() && "No unicode characters found")))) || (_wassert(L"!Matches.empty() && \"No unicode characters found\"", L"clang\\lib\\Lex\\LiteralSupport.cpp", (629) as u32) , 0)) as void);
}

fn ProcessNamedUCNEscape(ThisTokBegin: *u8, ThisTokBuf: **mut u8, ThisTokEnd: *u8, UcnVal: *mut u32, UcnLen: *mut u16, Loc: FullSourceLoc, Diags: *mut DiagnosticsEngine, Features: *LangOptions) -> bool {
    let mut UcnBegin: *u8 = ThisTokBuf;
    assert!(UcnBegin[0] == '\' && UcnBegin[1] == 'N');
    ThisTokBuf += 2;
    if ThisTokBuf == ThisTokEnd || *ThisTokBuf != '{' {
        if Diags {
            Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf) << &mut ThisTokBuf[-1][0..1];
        }
        return false;
    }
    ThisTokBuf += 1;
    let mut ClosingBrace: *u8 = find_if(ThisTokBuf, ThisTokEnd, Closure_1 {});
    let mut Incomplete: bool = ClosingBrace == ThisTokEnd;
    let mut Empty: bool = ClosingBrace == ThisTokBuf;
    if Incomplete || Empty {
        if Diags {
            Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf) << &mut UcnBegin[1][0..1];
        }
        ThisTokBuf = if ClosingBrace == ThisTokEnd { ClosingBrace } else { ClosingBrace + 1 };
        return false;
    }
    let mut Name: str = ThisTokBuf[0..ClosingBrace - ThisTokBuf];
    ThisTokBuf = ClosingBrace + 1;
    let mut Res: optional<char32_t> = zeroed();
    if operator!() {
        if Diags {
            DiagnoseInvalidUnicodeCharacterName(Diags, Features, Loc, ThisTokBegin, &mut UcnBegin[3], ClosingBrace, Name);
        }
        return false;
    }
    UcnVal = *;
    UcnLen = if UcnVal > 65535 { 8 } else { 4 };
    return true;
}

fn ProcessUCNEscape(ThisTokBegin: *u8, ThisTokBuf: **mut u8, ThisTokEnd: *u8, UcnVal: *mut u32, UcnLen: *mut u16, Loc: FullSourceLoc, Diags: *mut DiagnosticsEngine, Features: *LangOptions, in_char_string_literal: bool) -> bool {
    let mut HasError: bool = false;
    let mut UcnBegin: *u8 = ThisTokBuf;
    let mut IsDelimitedEscapeSequence: bool = false;
    let mut IsNamedEscapeSequence: bool = false;
    if ThisTokBuf[1] == 'N' {
        IsNamedEscapeSequence = true;
        HasError = !ProcessNamedUCNEscape(ThisTokBegin, ThisTokBuf, ThisTokEnd, UcnVal, UcnLen, Loc, Diags, Features);
    } else {
        HasError = !ProcessNumericUCNEscape(ThisTokBegin, ThisTokBuf, ThisTokEnd, UcnVal, UcnLen, IsDelimitedEscapeSequence, Loc, Diags, Features, in_char_string_literal);
    }
    if HasError {
        return false;
    }
    if (55296 <= UcnVal && UcnVal <= 57343) || UcnVal > 1114111 {
        if Diags {
            Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf);
        }
        return false;
    }
    if UcnVal < 160 && (UcnVal != 36 && UcnVal != 64 && UcnVal != 96) {
        let mut IsError: bool = (operator!((Features() || Features())) || !in_char_string_literal);
        if Diags {
            let mut BasicSCSChar: i8 = UcnVal;
            if UcnVal >= 32 && UcnVal < 127 {
                Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf) << &mut BasicSCSChar[0..1];
            } else {
                Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf);
            }
        }
        if IsError {
            return false;
        }
    }
    if operator!(Features()) && operator!(Features()) && Diags {
        Diag(Diags, Features, Loc, ThisTokBegin, UcnBegin, ThisTokBuf);
    }
    if (IsDelimitedEscapeSequence || IsNamedEscapeSequence) && Diags {
        DiagnoseDelimitedOrNamedEscapeSequence(Loc, IsNamedEscapeSequence, Features, *Diags);
    }
    return true;
}

fn MeasureUCNEscape(ThisTokBegin: *u8, ThisTokBuf: **mut u8, ThisTokEnd: *u8, CharByteWidth: u32, Features: *LangOptions, HadError: *mut bool) -> i32 {
    if CharByteWidth == 4 {
        return 4;
    }
    let mut UcnVal: u32 = 0;
    let mut UcnLen: u16 = 0;
    let mut Loc: FullSourceLoc = FullSourceLoc {};
    if !ProcessUCNEscape(ThisTokBegin, ThisTokBuf, ThisTokEnd, UcnVal, UcnLen, Loc, null, Features, true) {
        HadError = true;
        return 0;
    }
    if CharByteWidth == 2 {
        return if UcnVal <= 65535 { 2 } else { 4 };
    }
    if UcnVal < 128 {
        return 1;
    }
    if UcnVal < 2048 {
        return 2;
    }
    if UcnVal < 65536 {
        return 3;
    }
    return 4;
}

fn EncodeUCNEscape(ThisTokBegin: *u8, ThisTokBuf: **mut u8, ThisTokEnd: *u8, ResultBuf: *mut *mut u8, HadError: *mut bool, Loc: FullSourceLoc, CharByteWidth: u32, Diags: *mut DiagnosticsEngine, Features: *LangOptions, Converter: *mut TextEncodingConverter) {
    let mut UcnVal: UTF32 = 0;
    let mut UcnLen: u16 = 0;
    if !ProcessUCNEscape(ThisTokBegin, ThisTokBuf, ThisTokEnd, UcnVal, UcnLen, Loc, Diags, Features, true) {
        HadError = true;
        return;
    }
    assert!((CharByteWidth == 1 || CharByteWidth == 2 || CharByteWidth == 4), "only character widths of 1, 2, or 4 bytes supported");
    UcnLen as void;
    assert!((UcnLen == 4 || UcnLen == 8), "only ucn length of 4 or 8 supported");
    if CharByteWidth == 4 {
        let mut ResultPtr: *mut UTF32 = ResultBuf as *mut UTF32;
        *ResultPtr = UcnVal;
        ResultBuf += 4;
        return;
    }
    if CharByteWidth == 2 {
        let mut ResultPtr: *mut UTF16 = ResultBuf as *mut UTF16;
        if UcnVal <= 65535 as UTF32 {
            *ResultPtr = UcnVal;
            ResultBuf += 2;
            return;
        }
        UcnVal -= 65536;
        *ResultPtr = 55296 + (UcnVal >> 10);
        *(ResultPtr + 1) = 56320 + (UcnVal & 1023);
        ResultBuf += 4;
        return;
    }
    assert!(CharByteWidth == 1, "UTF-8 encoding is only for 1 byte characters");
    let mut bytesToWrite: u16 = 0;
    if UcnVal < 128 as UTF32 {
        bytesToWrite = 1;
    } else if UcnVal < 2048 as UTF32 {
        bytesToWrite = 2;
    } else if UcnVal < 65536 as UTF32 {
        bytesToWrite = 3;
    } else {
        bytesToWrite = 4;
    }
    let mut byteMask: u32 = 191;
    let mut byteMark: u32 = 128;
    let mut firstByteMark: [5]UTF8 = [0, 0, 192, 224, 240];
    ResultBuf += bytesToWrite;
    match bytesToWrite {
        4 => {
            *ResultBuf -= 1 = ((UcnVal | byteMark) & byteMask) as UTF8;
        },
        3 => {
            *ResultBuf -= 1 = ((UcnVal | byteMark) & byteMask) as UTF8;
        },
        2 => {
            *ResultBuf -= 1 = ((UcnVal | byteMark) & byteMask) as UTF8;
        },
        1 => {
            *ResultBuf -= 1 = (UcnVal | firstByteMark[bytesToWrite]) as UTF8;
        },
    }
    ResultBuf += bytesToWrite;
    if Converter {
        let mut CpConv: str = zeroed();
        let mut Cp: *mut u8 = ResultBuf - bytesToWrite;
        let mut EC: auto = Converter.convert(Cp[0..bytesToWrite]);
        if operator!() {
            memcpy(Cp);
            ResultBuf = Cp + ();
        } else {
            Diags << ();
            HadError = true;
        }
    }
}

fn NumericLiteralParser::NumericLiteralParser(self, TokSpelling: str, TokLoc: SourceLocation, SM: *SourceManager, LangOpts: *LangOptions, Target: *TargetInfo, Diags: *mut DiagnosticsEngine) {
    self.s = self.DigitsBegin = self.ThisTokBegin;
    self.saw_exponent = false;
    self.saw_period = false;
    self.saw_ud_suffix = false;
    self.saw_fixed_point_suffix = false;
    self.isLong = false;
    self.isUnsigned = false;
    self.isLongLong = false;
    self.isSizeT = false;
    self.isHalf = false;
    self.isFloat = false;
    self.isImaginary = false;
    self.isFloat16 = false;
    self.isFloat128 = false;
    self.MicrosoftInteger = 0;
    self.isFract = false;
    self.isAccum = false;
    self.hadError = false;
    self.isBitInt = false;
    if isPreprocessingNumberBody(*self.ThisTokEnd) && operator!((LangOpts() && *self.ThisTokEnd == '.')) {
        Diags;
        self.hadError = true;
        return;
    }
    if *self.s == '0' {
        self.ParseNumberStartingWithZero(TokLoc);
        if self.hadError {
            return;
        }
    } else {
        self.radix = 10;
        self.s = self.SkipDigits(self.s);
        if self.s == self.ThisTokEnd {} else {
            self.ParseDecimalOrOctalCommon(TokLoc);
            if self.hadError {
                return;
            }
        }
    }
    self.SuffixBegin = self.s;
    self.checkSeparator(TokLoc, self.s, CSK_AfterDigits);
    if LangOpts() {
        for let mut c: *u8 = self.s; c != self.ThisTokEnd; c += 1 {
            if *c == 'r' || *c == 'k' || *c == 'R' || *c == 'K' {
                self.saw_fixed_point_suffix = true;
                break;
            }
        }
    }
    let mut isFixedPointConstant: bool = self.isFixedPointLiteral();
    let mut isFPConstant: bool = self.isFloatingLiteral();
    let mut HasSize: bool = false;
    let mut DoubleUnderscore: bool = false;
    for ; self.s != self.ThisTokEnd; self.s += 1 {
        match *self.s {
            'R' => {
                'r';
            },
            'K' => {
                'k';
            },
            'h' => {
                'H';
            },
            'f' => {
                'F';
            },
            'q' => {
                'Q';
            },
            'u' => {
                'U';
            },
            'l' => {
                'L';
            },
            'z' => {
                'Z';
            },
            'i' => {
                'I';
            },
            'j' => {
                'J';
            },
