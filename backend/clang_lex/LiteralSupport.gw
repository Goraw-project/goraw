        ThisTokEnd -= 1;
        if ThisTokBuf[0] == 'L' || ThisTokBuf[0] == 'u' || ThisTokBuf[0] == 'U' {
            ThisTokBuf += 1;
            if ThisTokBuf[0] == '8' {
                ThisTokBuf += 1;
            }
        }
        if ThisTokBuf[0] == 'R' {
            if ThisTokBuf[1] != '"' {
                return self.DiagnoseLexingError([i]());
            }
            ThisTokBuf += 2;
            let mut MaxRawStrDelimLen: u32 = 16;
            let mut Prefix: *u8 = ThisTokBuf;
            while ThisTokBuf - Prefix as u32 < MaxRawStrDelimLen && ThisTokBuf[0] != '(' {
                ThisTokBuf += 1;
            }
            if ThisTokBuf[0] != '(' {
                return self.DiagnoseLexingError([i]());
            }
            ThisTokBuf += 1;
            ThisTokEnd -= ThisTokBuf - Prefix;
            if ThisTokEnd < ThisTokBuf {
                return self.DiagnoseLexingError([i]());
            }
            let mut RemainingTokenSpan: str = ThisTokBuf[0..ThisTokEnd - ThisTokBuf];
            while !RemainingTokenSpan.is_empty() {
                let mut CRLFPos: u64 = RemainingTokenSpan.find("\r\n", 0);
                let mut BeforeCRLF: str = RemainingTokenSpan[0..0 + CRLFPos];
                let mut AfterCRLF: str = RemainingTokenSpan[CRLFPos..CRLFPos + npos];
                if self.CopyStringFragment([i], ThisTokBegin, BeforeCRLF, Converter) {
                    self.hadError = true;
                }
                RemainingTokenSpan = AfterCRLF[1..1 + npos];
            }
        } else {
            if ThisTokBuf[0] != '"' {
                return self.DiagnoseLexingError([i]());
            }
            ThisTokBuf += 1;
            if !self.isUnevaluated() && self.Features && ThisTokBuf + 1 != ThisTokEnd && ThisTokBuf[0] == '\' && ThisTokBuf[1] == 'p' {
                if i == 0 {
                    ThisTokBuf += 1;
                    self.Pascal = true;
                } else if self.Pascal {
                    ThisTokBuf += 2;
                }
            }
            while ThisTokBuf != ThisTokEnd {
                if ThisTokBuf[0] != '\' {
                    let mut InStart: *u8 = ThisTokBuf;
                    while true {
                        {
                        ThisTokBuf += 1;
                    }
                        if !(ThisTokBuf != ThisTokEnd && ThisTokBuf[0] != '\') { break; }
                    }
                    if self.CopyStringFragment([i], ThisTokBegin, InStart[0..ThisTokBuf - InStart], Converter) {
                        self.hadError = true;
                    }
                    continue;
                }
                if ThisTokBuf[1] == 'u' || ThisTokBuf[1] == 'U' || ThisTokBuf[1] == 'N' {
                    EncodeUCNEscape(ThisTokBegin, ThisTokBuf, ThisTokEnd, self.ResultPtr, self.hadError, [i](), self.CharByteWidth, self.Diags, self.Features, Converter);
                    continue;
                }
                let mut ResultChar: u32 = ProcessCharEscape(ThisTokBegin, ThisTokBuf, ThisTokEnd, self.hadError, [i](), self.CharByteWidth * 8, self.Diags, self.Features, self.EvalMethod, Converter);
                if self.CharByteWidth == 4 {
                    let mut ResultWidePtr: *mut UTF32 = self.ResultPtr as *mut UTF32;
                    *ResultWidePtr = ResultChar;
                    self.ResultPtr += 4;
                } else if self.CharByteWidth == 2 {
                    let mut ResultWidePtr: *mut UTF16 = self.ResultPtr as *mut UTF16;
                    *ResultWidePtr = ResultChar & 65535;
                    self.ResultPtr += 2;
                } else {
                    assert!(self.CharByteWidth == 1, "Unexpected char width");
                    *self.ResultPtr += 1 = ResultChar & 255;
                }
            }
        }
    }
    assert!((!self.Pascal || !self.isUnevaluated()), "Pascal string in unevaluated context");
    if self.Pascal {
        if self.CharByteWidth == 4 {
            let mut ResultWidePtr: *mut UTF32 = null;
            ResultWidePtr[0] = self.GetNumStringChars() - 1;
        } else if self.CharByteWidth == 2 {
            let mut ResultWidePtr: *mut UTF16 = null;
            ResultWidePtr[0] = self.GetNumStringChars() - 1;
        } else {
            assert!(self.CharByteWidth == 1, "Unexpected char width");
        }
        if self.GetStringLength() > 256 {
            if self.Diags {
                self.Diags << ()();
            }
            self.hadError = true;
            return;
        }
    } else if self.Diags {
        let mut MaxChars: u32 = if self.Features { 65536 } else { if self.Features { 4095 } else { 509 } };
        if self.GetNumStringChars() > MaxChars {
            self.Diags << self.GetNumStringChars() << MaxChars << (if self.Features { 2 } else { if self.Features { 1 } else { 0 } }) << ()();
        }
    }
}

fn resyncUTF8(Err: *u8, End: *u8) -> *u8 {
    if Err == End {
        return End;
    }
    End = Err + min(getNumBytesForUTF8(*Err), End - Err);
    while Err += 1 != End && (*Err & 192) == 128 {
        
    }
    return Err;
}

fn StringLiteralParser::CopyStringFragment(self, Tok: *Token, TokBegin: *u8, Fragment: str, Converter: *mut TextEncodingConverter) -> bool {
    let mut ErrorPtrTmp: *UTF8 = null;
    if ConvertUTF8toWide(self.CharByteWidth, Fragment, self.ResultPtr, ErrorPtrTmp) {
        if Converter {
            assert!(self.isOrdinary(), "Only ordinary literals are supported");
            let mut CpConv: str = zeroed();
            let mut Cp: *mut u8 = self.ResultPtr - Fragment.len;
            let mut EC: auto = Converter.convert(Fragment);
            if operator!() {
                memcpy(Cp);
                self.ResultPtr = Cp + ();
            } else {
                if self.Diags {
                    self.Diags << ();
                }
                return true;
            }
        }
        return false;
    }
    let mut NoErrorOnBadEncoding: bool = self.isOrdinary();
    if NoErrorOnBadEncoding {
        memcpy(self.ResultPtr, Fragment.ptr, Fragment.len);
        self.ResultPtr += Fragment.len;
    }
    if self.Diags {
        let mut ErrorPtr: *u8 = ErrorPtrTmp as *u8;
        let mut SourceLoc: FullSourceLoc = FullSourceLoc { ID: Tok.getLocation(), SrcMgr: self.SM };
        let mut Builder: *DiagnosticBuilder = Diag(self.Diags, self.Features, SourceLoc, TokBegin, ErrorPtr, resyncUTF8(ErrorPtr, Fragment.end()));
        let mut NextStart: *u8 = resyncUTF8(ErrorPtr, Fragment.end());
        let mut NextFragment: str = NextStart[0..Fragment.end() - NextStart];
        let mut Dummy: str = zeroed();
        Dummy()(Fragment.len * self.CharByteWidth);
        let mut Ptr: *mut u8 = ();
        while !ConvertUTF8toWide(self.CharByteWidth, NextFragment, Ptr, ErrorPtrTmp) {
            let mut ErrorPtr: *u8 = ErrorPtrTmp as *u8;
            NextStart = resyncUTF8(ErrorPtr, Fragment.end());
            Builder << MakeCharSourceRange(self.Features, SourceLoc, TokBegin, ErrorPtr, NextStart);
            NextFragment = NextStart[0..Fragment.end() - NextStart];
        }
    }
    return !NoErrorOnBadEncoding;
}

fn StringLiteralParser::DiagnoseLexingError(self, Loc: SourceLocation) {
    self.hadError = true;
    if self.Diags {
        self.Diags;
    }
}

fn StringLiteralParser::getOffsetOfStringByte(self: *StringLiteralParser, Tok: *Token, ByteNo: u32) -> u32 {
    let mut SpellingBuffer: str = zeroed();
    SpellingBuffer()(Tok.getLength());
    let mut StringInvalid: bool = false;
    let mut SpellingPtr: *u8 = operator&([0]);
    let mut TokLen: u32 = getSpelling(Tok, SpellingPtr, self.SM, self.Features, &mut StringInvalid);
    if StringInvalid {
        return 0;
    }
    let mut SpellingStart: *u8 = SpellingPtr;
    let mut SpellingEnd: *u8 = SpellingPtr + TokLen;
    if SpellingPtr[0] == 'u' && SpellingPtr[1] == '8' {
        SpellingPtr += 2;
    }
    assert!(SpellingPtr[0] != 'L' && SpellingPtr[0] != 'u' && SpellingPtr[0] != 'U', "Doesn't handle wide or utf strings yet");
    if SpellingPtr[0] == 'R' {
        assert!(SpellingPtr[1] == '"', "Should be a raw string literal!");
        SpellingPtr += 2;
        while *SpellingPtr != '(' {
            SpellingPtr += 1;
            assert!(SpellingPtr < SpellingEnd, "Missing ( for raw string literal");
        }
        SpellingPtr += 1;
        return SpellingPtr - SpellingStart + ByteNo;
    }
    assert!(SpellingPtr[0] == '"', "Should be a string literal!");
    SpellingPtr += 1;
    while ByteNo {
        assert!(SpellingPtr < SpellingEnd, "Didn't find byte offset!");
        if *SpellingPtr != '\' {
            SpellingPtr += 1;
            ByteNo -= 1;
            continue;
        }
        let mut HadError: bool = false;
        if SpellingPtr[1] == 'u' || SpellingPtr[1] == 'U' || SpellingPtr[1] == 'N' {
            let mut EscapePtr: *u8 = SpellingPtr;
            let mut Len: u32 = MeasureUCNEscape(SpellingStart, SpellingPtr, SpellingEnd, 1, self.Features, HadError);
            if Len > ByteNo {
                SpellingPtr = EscapePtr;
                break;
            }
            ByteNo -= Len;
        } else {
            ProcessCharEscape(SpellingStart, SpellingPtr, SpellingEnd, HadError, FullSourceLoc { ID: Tok.getLocation(), SrcMgr: self.SM }, self.CharByteWidth * 8, self.Diags, self.Features, Evaluated, null);
            ByteNo -= 1;
        }
        assert!(!HadError, "This method isn't valid on erroneous strings");
    }
    return SpellingPtr - SpellingStart;
}

fn StringLiteralParser::isValidUDSuffix(self, LangOpts: *LangOptions, Suffix: str) -> bool {
    return isValidUDSuffix(LangOpts, Suffix) || Suffix == "sv";
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, C: i8) -> bool {
        return C == '}' || isVerticalWhitespace(C);
    }

struct Closure_2 {
    cap_0: *mut NumericLiteralParser,
    IsSingleZero: *mut bool,
    TokLoc: *mut SourceLocation,
}

unsafe fn Closure_2::call(self: *mut Closure_2) -> auto {
        if self.radix == 8 && self.LangOpts && !self.hadError && !(*self.IsSingleZero) {
            self.Diags;
        }
    }
