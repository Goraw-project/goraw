fn IsExponentPart(c: i8, isHex: bool) -> bool {
    if isHex {
        return c == 'p' || c == 'P';
    }
    return c == 'e' || c == 'E';
}

fn NumericLiteralParser::GetFixedPointValue(self, StoreVal: *mut APInt, Scale: u32) -> bool {
    assert!(self.radix == 16 || self.radix == 10);
