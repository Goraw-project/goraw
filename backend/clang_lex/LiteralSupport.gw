fn alwaysFitsInto64Bits(Radix: u32, NumDigits: u32) -> bool {
    match Radix {
        2 => {
            return NumDigits <= 64;
        },
        8 => {
            return NumDigits <= 64 / 3;
        },
        10 => {
            return NumDigits <= 19;
        },
        16 => {
            return NumDigits <= 64 / 4;
        },
        _ => {
            llvm_unreachable_internal("impossible Radix", "clang\\lib\\Lex\\LiteralSupport.cpp", 1566);
        },
    }
}

fn NumericLiteralParser::GetIntegerValue(self, Val: *mut APInt) -> bool {
    let mut NumDigits: u32 = self.SuffixBegin - self.DigitsBegin;
