        StoreVal = Val.trunc(StoreVal.getBitWidth());
    } else if Val.getBitWidth() < StoreVal.getBitWidth() {
        IntOverflowOccurred |= Val.zext(MaxVal.getBitWidth()).ugt(MaxVal);
        StoreVal = Val.zext(StoreVal.getBitWidth());
    } else {
        StoreVal = move(Val);
    }
