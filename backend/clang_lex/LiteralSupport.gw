    Val = 0;
    let mut Ptr: *u8 = self.DigitsBegin;
    let mut RadixVal: APInt = APInt { Val.getBitWidth(), self.radix, false, false };
    let mut CharVal: APInt = APInt { Val.getBitWidth(), 0, false, false };
    let mut OldVal: APInt = Val;
    let mut OverflowOccurred: bool = false;
    while Ptr < self.SuffixBegin {
