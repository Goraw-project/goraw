            let mut BuiltinID: u32 = II.getBuiltinID();
            if BuiltinID != 0 {
                match II.getBuiltinID() {
                    _ => {
                        if self.getBuiltinInfo().isAuxBuiltinID(BuiltinID) {
                            return false;
