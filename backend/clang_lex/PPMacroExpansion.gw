fn HasExtension(PP: *Preprocessor, Extension: str) -> bool {
    if HasFeature(PP, Extension) {
        return true;
    }
    if PP.getDiagnostics().getExtensionHandlingBehavior() >= Error {
        return false;
    }
    let mut LangOpts: *LangOptions = PP.getLangOpts();
    if Extension.starts_with("__") && Extension.ends_with("__") && Extension.len >= 4 {
        Extension = Extension[2..2 + Extension.len - 4];
    }
    return Extension.Case("define_target_os_macros", PP.getPreprocessorOpts().DefineTargetOSMacros).Case("swiftcc", PP.getTargetInfo().checkCallingConvention(CC_Swift) == CCCR_OK).Case("swiftasynccc", PP.getTargetInfo().checkCallingConvention(CC_SwiftAsync) == CCCR_OK).Case("objc_c_static_assert", true).Case("c_alignas", true).Case("c_alignof", true).Case("c_atomic", true).Case("c_generic_selections", true).Case("c_generic_selection_with_controlling_type", true).Case("c_static_assert", true).Case("c_thread_local", PP.getTargetInfo().isTLSSupported()).Case("c_attributes", true).Case("c_fixed_enum", true).Case("c_countof", !LangOpts.C2y && !LangOpts.CPlusPlus).Case("cxx_atomic", LangOpts.CPlusPlus).Case("cxx_default_function_template_args", LangOpts.CPlusPlus).Case("cxx_defaulted_functions", LangOpts.CPlusPlus).Case("cxx_deleted_functions", LangOpts.CPlusPlus).Case("cxx_explicit_conversions", LangOpts.CPlusPlus).Case("cxx_inline_namespaces", LangOpts.CPlusPlus).Case("cxx_lambdas", LangOpts.CPlusPlus).Case("cxx_local_type_template_args", LangOpts.CPlusPlus).Case("cxx_nonstatic_member_init", LangOpts.CPlusPlus).Case("cxx_override_control", LangOpts.CPlusPlus).Case("cxx_range_for", LangOpts.CPlusPlus).Case("cxx_reference_qualified_functions", LangOpts.CPlusPlus).Case("cxx_rvalue_references", LangOpts.CPlusPlus).Case("cxx_variadic_templates", LangOpts.CPlusPlus).Case("cxx_fixed_enum", true).Case("cxx_binary_literals", true).Case("cxx_init_captures", LangOpts.CPlusPlus11).Case("cxx_variable_templates", LangOpts.CPlusPlus).Case("cxx_generalized_nttp", LangOpts.CPlusPlus20).Case("cxx_explicit_this_parameter", LangOpts.CPlusPlus23).Case("overloadable_unmarked", true).Case("pragma_clang_attribute_namespaces", true).Case("pragma_clang_attribute_external_declaration", true).Case("statement_attributes_with_gnu_syntax", true).Case("gnu_asm", LangOpts.GNUAsm).Case("gnu_asm_goto_with_outputs", LangOpts.GNUAsm).Case("gnu_asm_goto_with_outputs_full", LangOpts.GNUAsm).Case("gnu_asm_constexpr_strings", LangOpts.GNUAsm && LangOpts.CPlusPlus11).Case("matrix_types", LangOpts.MatrixTypes).Case("matrix_types_scalar_division", true).Case("cxx_attributes_on_using_declarations", LangOpts.CPlusPlus11).Case("datasizeof", LangOpts.CPlusPlus).Case("cuda_implicit_host_device_templates", LangOpts.CUDA && LangOpts.OffloadImplicitHostDeviceTemplates).Case("cxx_type_aware_allocators", true).Case("overflow_behavior_types", LangOpts.OverflowBehaviorTypes).Default(false);
}

fn EvaluateHasIncludeCommon(Tok: *mut Token, II: *mut IdentifierInfo, PP: *mut Preprocessor, LookupFrom: ConstSearchDirIterator, LookupFromFile: *FileEntry) -> bool {
    let mut LParenLoc: SourceLocation = Tok.getLocation();
    if !PP.isParsingIfOrElifDirective() {
        PP.Diag(LParenLoc, err_pp_directive_required) << II;
        assert!(Tok.is(identifier);
        Tok.setIdentifierInfo(II);
        return false;
    }
    while true {
        {
        if PP.LexHeaderName(Tok, true) {
            return false;
        }
    }
        if !(Tok.getKind() == comment) { break; }
    }
    if Tok.isNot(l_paren) {
        LParenLoc = PP.getLocForEndOfToken(LParenLoc, 0);
        PP.Diag(LParenLoc, err_pp_expected_after) << II << l_paren;
        if Tok.isNot(header_name) {
            return false;
        }
    } else {
        LParenLoc = Tok.getLocation();
        if PP.LexHeaderName(Tok, true) {
            return false;
        }
    }
    if Tok.isNot(header_name) {
        PP.Diag(Tok.getLocation(), err_pp_expects_filename);
        return false;
    }
    let mut FilenameBuffer: str = "";
    let mut Invalid: bool = false;
    let mut Filename: str = PP.getSpelling(Tok, FilenameBuffer, &mut Invalid);
    if Invalid {
        return false;
    }
    let mut FilenameLoc: SourceLocation = Tok.getLocation();
    PP.LexNonComment(Tok);
    if Tok.isNot(r_paren) {
        PP.Diag(PP.getLocForEndOfToken(FilenameLoc, 0), err_pp_expected_after) << II << r_paren;
        PP.Diag(LParenLoc, note_matching) << l_paren;
        return false;
    }
    let mut isAngled: bool = PP.GetIncludeFilenameSpelling(Tok.getLocation(), Filename);
    if Filename.is_empty() {
        return false;
    }
    let mut KH: KnownHeader = KnownHeader {};
    let mut File: OptionalFileEntryRef = PP.LookupFile(FilenameLoc, Filename, isAngled, LookupFrom, LookupFromFile, null, null, null, &mut KH, null, null, false, true, true);
    if PP.getPPCallbacks() {
        Callbacks;
    } else {
        let mut FileType: CharacteristicKind = C_User;
        if File {
            FileType = PP.getHeaderSearchInfo().getFileDirFlavor(operator(File));
        }
        Callbacks.HasInclude(FilenameLoc, Filename, isAngled, File, FileType);
    }
    return File.has_value();
}

fn Preprocessor::EvaluateHasEmbed(self, Tok: *mut Token, II: *mut IdentifierInfo) -> EmbedResult {
    if !self.isParsingIfOrElifDirective() {
        self.Diag(Tok, err_pp_directive_required) << II;
        assert!(Tok.is(identifier);
        Tok.setIdentifierInfo(II);
        return Invalid;
    }
    self.LexUnexpandedToken(Tok);
    if Tok.isNot(l_paren) {
        self.Diag(Tok, err_pp_expected_after) << II << l_paren;
        return Invalid;
    }
    let mut LParenLoc: SourceLocation = Tok.getLocation();
    if self.LexHeaderName(Tok, true) {
        return Invalid;
    }
    if Tok.isNot(header_name) {
        self.Diag(Tok.getLocation(), err_pp_expects_filename);
        return Invalid;
    }
    let mut FilenameLoc: SourceLocation = Tok.getLocation();
    let mut FilenameTok: Token = Tok;
    let mut Params: optional<LexEmbedParametersResult> = self.LexEmbedParameters(Tok, true);
    if !Params {
        return Invalid;
    }
    if Tok.isNot(r_paren) {
        self.Diag(self.getLocForEndOfToken(FilenameLoc, 0), err_pp_expected_after) << II << r_paren;
        self.Diag(LParenLoc, note_matching) << l_paren;
        if Tok.isNot(eod) {
            self.DiscardUntilEndOfDirective(null);
        }
        return Invalid;
    }
    if operator(Params).UnrecognizedParams > 0 {
        return NotFound;
    }
    let mut FilenameBuffer: str = "";
    let mut Filename: str = self.getSpelling(FilenameTok, FilenameBuffer, null);
    if Filename.is_empty() {
        return Empty;
    }
    let mut isAngled: bool = self.GetIncludeFilenameSpelling(FilenameTok.getLocation(), Filename);
    let mut MaybeFileEntry: OptionalFileEntryRef = self.LookupEmbedFile(Filename, isAngled, false);
    if self.Callbacks {
        operator(self.Callbacks).HasEmbed(LParenLoc, Filename, isAngled, MaybeFileEntry);
    }
    if !MaybeFileEntry {
        return NotFound;
    }
    let mut FileSize: u64 = operator(MaybeFileEntry).getSize();
    if operator(Params).MaybeOffsetParam {
        if operator(operator(Params).MaybeOffsetParam).Offset > FileSize {
            FileSize = 0;
        } else {
            FileSize -= operator(operator(Params).MaybeOffsetParam).Offset;
        }
    }
    if operator(Params).MaybeLimitParam {
        if operator(operator(Params).MaybeLimitParam).Limit > FileSize {
            FileSize = 0;
        } else {
            FileSize = operator(operator(Params).MaybeLimitParam).Limit;
        }
    }
    if FileSize == 0 {
        return Empty;
    }
    return Found;
}

fn Preprocessor::EvaluateHasInclude(self, Tok: *mut Token, II: *mut IdentifierInfo) -> bool {
    return EvaluateHasIncludeCommon(Tok, II, *self, null, null);
}

fn Preprocessor::EvaluateHasIncludeNext(self, Tok: *mut Token, II: *mut IdentifierInfo) -> bool {
    let mut Lookup: ConstSearchDirIterator = null;
    let mut LookupFromFile: *FileEntry = null;
    tie(Lookup, LookupFromFile) = self.getIncludeNextStart(Tok);
    return EvaluateHasIncludeCommon(Tok, II, *self, Lookup, LookupFromFile);
}

fn EvaluateFeatureLikeBuiltinMacro(OS: *mut raw_svector_ostream, Tok: *mut Token, II: *mut IdentifierInfo, PP: *mut Preprocessor, ExpandArgs: bool, Op: function_ref<int (Token &, bool &)>) {
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(Tok.getLocation(), err_pp_expected_after) << II << l_paren;
        if !Tok.isOneOf(eof, eod) {
            OS << 0;
            Tok.setKind(numeric_constant);
        }
        return;
    }
    let mut ParenDepth: u32 = 1;
    let mut LParenLoc: SourceLocation = Tok.getLocation();
    let mut Result: optional<int> = optional<int> {};
    let mut ResultTok: Token = Token {};
    let mut SuppressDiagnostic: bool = false;
    while Tok.isNoneOf(eod, eof) {
        if ExpandArgs {
            PP.Lex(Tok);
        } else {
            PP.LexUnexpandedToken(Tok);
        }
        Tok.getKind();
        if !SuppressDiagnostic {
            if PP.Diag(Tok.getLocation(), err_pp_expected_after) {
                Diag;
            } else {
                if ResultTok.getIdentifierInfo() {
                    LastII;
                } else {
                    Diag << LastII;
                }
                Diag << r_paren << ResultTok.getLocation();
            }
            PP.Diag(LParenLoc, note_matching) << l_paren;
            SuppressDiagnostic = true;
        }
    }
}

fn ExpectFeatureIdentifierInfo(Tok: *mut Token, PP: *mut Preprocessor, DiagID: i32) -> *mut IdentifierInfo {
    let mut II: *mut IdentifierInfo = null;
    if !Tok.isAnnotation() && (II = Tok.getIdentifierInfo()) {
        return II;
    }
    PP.Diag(Tok.getLocation(), DiagID);
    return null;
}

fn isTargetArch(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    let mut Arch: Triple = II.getName().lower() + "--";
    let mut TT: *Triple = TI.getTriple();
    if TT.isThumb() {
        if (Arch.getSubArch() == NoSubArch || Arch.getSubArch() == TT.getSubArch()) && ((TT.getArch() == thumb && Arch.getArch() == arm) || (TT.getArch() == thumbeb && Arch.getArch() == armeb)) {
            return true;
        }
    }
    return (Arch.getSubArch() == NoSubArch || Arch.getSubArch() == TT.getSubArch()) && Arch.getArch() == TT.getArch();
}

fn isTargetVendor(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    let mut VendorName: str = TI.getTriple().getVendorName();
    if VendorName.is_empty() {
        VendorName = "unknown";
    }
    return VendorName.equals_insensitive(II.getName());
}

fn isTargetOS(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    let mut OS: Triple = "unknown-unknown-" + II.getName().lower();
    if OS.getOS() == Darwin {
        return TI.getTriple().isOSDarwin();
    }
    return TI.getTriple().getOS() == OS.getOS();
}

fn isTargetEnvironment(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    let mut Env: Triple = "---" + II.getName().lower();
    if Env.getEnvironment() == UnknownEnvironment && Env.getEnvironmentName() != "unknown" {
        return false;
    }
    return TI.getTriple().getEnvironment() == Env.getEnvironment();
}

fn isTargetVariantOS(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    if TI.getTriple().isOSDarwin() {
        let mut VariantTriple: *Triple = TI.getDarwinTargetVariantTriple();
        if !VariantTriple {
            return false;
        }
        let mut OS: Triple = "unknown-unknown-" + II.getName().lower();
        if OS.getOS() == Darwin {
            return VariantTriple.isOSDarwin();
        }
        return VariantTriple.getOS() == OS.getOS();
    }
    return false;
}

fn isTargetVariantEnvironment(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    if TI.getTriple().isOSDarwin() {
        let mut VariantTriple: *Triple = TI.getDarwinTargetVariantTriple();
        if !VariantTriple {
            return false;
        }
        let mut Env: Triple = "---" + II.getName().lower();
        return VariantTriple.getEnvironment() == Env.getEnvironment();
    }
    return false;
}

