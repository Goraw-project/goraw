fn ComputeDATE_TIME(DATELoc: *mut SourceLocation, DATETokLen: *mut u64, TIMELoc: *mut SourceLocation, TIMETokLen: *mut u64, PP: *mut Preprocessor) {
    if PP.getPreprocessorOpts().InitDateTimeMacros == LiteralOne {
        if !DATELoc.isValid() {
            let mut TmpTok: Token = Token {};
            TmpTok.startToken();
            PP.CreateString("\"1\"", TmpTok, SourceLocation {}, SourceLocation {});
            DATELoc = TmpTok.getLocation();
        }
        DATETokLen = strlen("\"1\"");
        if !TIMELoc.isValid() {
            let mut TmpTok: Token = Token {};
            TmpTok.startToken();
            PP.CreateString("\"1\"", TmpTok, SourceLocation {}, SourceLocation {});
            TIMELoc = TmpTok.getLocation();
        }
        TIMETokLen = strlen("\"1\"");
        return;
    }
    let mut TT: time_t = zeroed();
    let mut TM: *mut tm = null;
    if PP.getPreprocessorOpts() {
        TT = *PP.getPreprocessorOpts();
        TM = gmtime(&mut TT);
    } else {
        TT = time(null);
        TM = localtime(&mut TT);
    }
    let mut Months: [12]char *const = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    if !DATELoc.isValid() {
        let mut TmpBuffer: str = zeroed();
        let mut TmpStream: raw_svector_ostream = TmpBuffer();
        if TM {
            TmpStream << format("\"%s %2d %4d\"", Months[TM.tm_mon], TM.tm_mday, TM.tm_year + 1900);
        } else {
            TmpStream << "??? ?? ????";
        }
        let mut TmpTok: Token = Token {};
        TmpTok.startToken();
        PP.CreateString(TmpStream, TmpTok, SourceLocation {}, SourceLocation {});
        DATELoc = TmpTok.getLocation();
    }
    DATETokLen = strlen("\"Mmm dd yyyy\"");
    if !TIMELoc.isValid() {
        let mut TmpBuffer: str = zeroed();
        let mut TmpStream: raw_svector_ostream = TmpBuffer();
        if TM {
            TmpStream << format("\"%02d:%02d:%02d\"", TM.tm_hour, TM.tm_min, TM.tm_sec);
        } else {
            TmpStream << "??:??:??";
        }
        let mut TmpTok: Token = Token {};
        TmpTok.startToken();
        PP.CreateString(TmpStream, TmpTok, SourceLocation {}, SourceLocation {});
        TIMELoc = TmpTok.getLocation();
    }
    TIMETokLen = strlen("\"hh:mm:ss\"");
}

fn HasFeature(PP: *Preprocessor, Feature: str) -> bool {
    let mut LangOpts: *LangOptions = PP.getLangOpts();
    if Feature.starts_with("__") && Feature.ends_with("__") && Feature.len >= 4 {
        Feature = Feature[2..2 + Feature.len - 4];
    }
}

fn HasExtension(PP: *Preprocessor, Extension: str) -> bool {
    if HasFeature(PP, Extension) {
        return true;
    }
    if PP.getDiagnostics().getExtensionHandlingBehavior() >= Error {
        return false;
    }
    let mut LangOpts: *LangOptions = PP.getLangOpts();
    if Extension.starts_with("__") && Extension.ends_with("__") && Extension.len >= 4 {
        Extension = Extension[2..2 + Extension.len - 4];
    }
}

fn EvaluateHasIncludeCommon(Tok: *mut Token, II: *mut IdentifierInfo, PP: *mut Preprocessor, LookupFrom: ConstSearchDirIterator, LookupFromFile: *FileEntry) -> bool {
    let mut LParenLoc: SourceLocation = Tok.getLocation();
    if !PP.isParsingIfOrElifDirective() {
        PP << II;
        assert!(Tok.is(identifier);
        Tok.setIdentifierInfo(II);
        return false;
    }
    while true {
        {
        if PP.LexHeaderName(Tok, true) {
            return false;
        }
    }
        if !(Tok.getKind() == comment) { break; }
    }
    if Tok.isNot(l_paren) {
        LParenLoc = PP.getLocForEndOfToken(LParenLoc, 0);
        PP << II << l_paren;
        if Tok.isNot(header_name) {
            return false;
        }
    } else {
        LParenLoc = Tok.getLocation();
        if PP.LexHeaderName(Tok, true) {
            return false;
        }
    }
    if Tok.isNot(header_name) {
        PP;
        return false;
    }
    let mut FilenameBuffer: str = zeroed();
    let mut Invalid: bool = false;
    let mut Filename: str = PP(Tok, &mut Invalid);
    if Invalid {
        return false;
    }
    let mut FilenameLoc: SourceLocation = Tok.getLocation();
    PP.LexNonComment(Tok);
    if Tok.isNot(r_paren) {
        PP << II << r_paren;
        PP << l_paren;
        return false;
    }
    let mut isAngled: bool = PP.GetIncludeFilenameSpelling(Tok.getLocation(), Filename);
    if Filename.is_empty() {
        return false;
    }
    let mut KH: KnownHeader = KnownHeader {};
    let mut File: OptionalFileEntryRef = PP.LookupFile(FilenameLoc, Filename, isAngled, LookupFromFile, null, null, null, &mut KH, null, null);
    if PP.getPPCallbacks() {
        Callbacks;
    } else {
        let mut FileType: CharacteristicKind = C_User;
        if File {
            FileType = PP.getHeaderSearchInfo().getFileDirFlavor(operator(File));
        }
        Callbacks.HasInclude(FilenameLoc, Filename, isAngled, File, FileType);
    }
    return File.has_value();
}

fn Preprocessor::EvaluateHasEmbed(self, Tok: *mut Token, II: *mut IdentifierInfo) -> EmbedResult {
    if !self.isParsingIfOrElifDirective() {
         << II;
        assert!(Tok.is(identifier);
        Tok.setIdentifierInfo(II);
        return Invalid;
    }
    self.LexUnexpandedToken(Tok);
    if Tok.isNot(l_paren) {
         << II << l_paren;
        return Invalid;
    }
    let mut LParenLoc: SourceLocation = Tok.getLocation();
    if self.LexHeaderName(Tok, true) {
        return Invalid;
    }
    if Tok.isNot(header_name) {
        return Invalid;
    }
    let mut FilenameLoc: SourceLocation = Tok.getLocation();
    let mut FilenameTok: Token = Tok;
    let mut Params: optional<LexEmbedParametersResult> = zeroed();
    if operator!() {
        return Invalid;
    }
    if Tok.isNot(r_paren) {
         << II << r_paren;
         << l_paren;
        if Tok.isNot(eod) {
            self.DiscardUntilEndOfDirective(null);
        }
        return Invalid;
    }
    if Params() > 0 {
        return NotFound;
    }
    let mut FilenameBuffer: str = zeroed();
    let mut Filename: str = self(FilenameTok);
    if Filename.is_empty() {
        return Empty;
    }
    let mut isAngled: bool = self.GetIncludeFilenameSpelling(FilenameTok.getLocation(), Filename);
    let mut MaybeFileEntry: OptionalFileEntryRef = self.LookupEmbedFile(Filename, isAngled, false);
    if  {}
    if !MaybeFileEntry {
        return NotFound;
    }
    let mut FileSize: u64 = operator(MaybeFileEntry).getSize();
    if Params() {
        if Params() > FileSize {
            FileSize = 0;
        } else {
            FileSize -= ;
        }
    }
    if Params() {
        if Params() > FileSize {
            FileSize = 0;
        } else {
            FileSize = ;
        }
    }
    if FileSize == 0 {
        return Empty;
    }
    return Found;
}

fn Preprocessor::EvaluateHasInclude(self, Tok: *mut Token, II: *mut IdentifierInfo) -> bool {
    return EvaluateHasIncludeCommon(Tok, II, *self, null, null);
}

fn Preprocessor::EvaluateHasIncludeNext(self, Tok: *mut Token, II: *mut IdentifierInfo) -> bool {
    let mut Lookup: ConstSearchDirIterator = zeroed();
    let mut LookupFromFile: *FileEntry = null;
    tie(LookupFromFile) = self.getIncludeNextStart;
    return EvaluateHasIncludeCommon(Tok, II, *self, LookupFromFile);
}

fn EvaluateFeatureLikeBuiltinMacro(OS: *mut raw_svector_ostream, Tok: *mut Token, II: *mut IdentifierInfo, PP: *mut Preprocessor, ExpandArgs: bool, Op: function_ref<int (Token &, bool &)>) {
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(l_paren) {
        PP << II << l_paren;
        if !Tok {
            OS << 0;
            Tok.setKind(numeric_constant);
        }
        return;
    }
    let mut ParenDepth: u32 = 1;
    let mut LParenLoc: SourceLocation = Tok.getLocation();
    let mut Result: optional<int> = zeroed();
    let mut ResultTok: Token = Token {};
    let mut SuppressDiagnostic: bool = false;
    while Tok {
        if ExpandArgs {
            PP.Lex(Tok);
        } else {
            PP.LexUnexpandedToken(Tok);
        }
        Tok.getKind();
        if !SuppressDiagnostic {
            if  {
                if ResultTok.getIdentifierInfo() {
                    LastII;
                } else {
                    Diag() << LastII;
                }
                Diag() << r_paren << ResultTok.getLocation();
            }
            PP << l_paren;
            SuppressDiagnostic = true;
        }
    }
}

fn ExpectFeatureIdentifierInfo(Tok: *mut Token, PP: *mut Preprocessor, DiagID: i32) -> *mut IdentifierInfo {
    let mut II: *mut IdentifierInfo = null;
    if !Tok.isAnnotation() && (II = Tok.getIdentifierInfo()) {
        return II;
    }
    PP.Diag(Tok.getLocation(), DiagID);
    return null;
}

fn isTargetArch(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    let mut Arch: Triple = II.getName().lower();
    let mut TT: *Triple = TI.getTriple();
    if TT.isThumb() {
        if (Arch.getSubArch() == NoSubArch || Arch.getSubArch() == TT.getSubArch()) && ((TT.getArch() == thumb && Arch.getArch() == arm) || (TT.getArch() == thumbeb && Arch.getArch() == armeb)) {
            return true;
        }
    }
    return (Arch.getSubArch() == NoSubArch || Arch.getSubArch() == TT.getSubArch()) && Arch.getArch() == TT.getArch();
}

fn isTargetVendor(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    let mut VendorName: str = TI.getTriple().getVendorName();
    if VendorName.is_empty() {
        VendorName = "unknown";
    }
    return VendorName.equals_insensitive(II.getName());
}

fn isTargetOS(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    let mut OS: Triple = "unknown-unknown-" + II.getName().lower();
    if OS.getOS() == Darwin {
        return TI.getTriple().isOSDarwin();
    }
    return TI.getTriple().getOS() == OS.getOS();
}

fn isTargetEnvironment(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    let mut Env: Triple = "---" + II.getName().lower();
    if Env.getEnvironment() == UnknownEnvironment && Env.getEnvironmentName() != "unknown" {
        return false;
    }
    return TI.getTriple().getEnvironment() == Env.getEnvironment();
}

fn isTargetVariantOS(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    if TI.getTriple().isOSDarwin() {
        let mut VariantTriple: *Triple = TI.getDarwinTargetVariantTriple();
        if !VariantTriple {
            return false;
        }
        let mut OS: Triple = "unknown-unknown-" + II.getName().lower();
        if OS.getOS() == Darwin {
            return VariantTriple.isOSDarwin();
        }
        return VariantTriple.getOS() == OS.getOS();
    }
    return false;
}

fn isTargetVariantEnvironment(TI: *TargetInfo, II: *IdentifierInfo) -> bool {
    if TI.getTriple().isOSDarwin() {
        let mut VariantTriple: *Triple = TI.getDarwinTargetVariantTriple();
        if !VariantTriple {
            return false;
        }
        let mut Env: Triple = "---" + II.getName().lower();
        return VariantTriple.getEnvironment() == Env.getEnvironment();
    }
    return false;
}

fn IsBuiltinTrait(Tok: *mut Token) -> bool {
    match Tok.getKind() {
        _ => {
            return false;
        },
    }
}

fn Preprocessor::ExpandBuiltinMacro(self, Tok: *mut Token) {
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    assert!(II, "Can't be a macro without id info!");
    let mut MacroNameLoc: SourceLocation = Tok.getLocation();
    if II == self.Ident_Pragma {
        return self.Handle_Pragma(Tok);
    } else if II == self.Ident__pragma {
        return self.HandleMicrosoft__pragma(Tok);
    }
    self.NumBuiltinMacroExpanded += 1;
    let mut TmpBuffer: str = zeroed();
    let mut OS: raw_svector_ostream = TmpBuffer();
    Tok.setIdentifierInfo(null);
    Tok.clearFlag(NeedsCleaning);
    let mut IsAtStartOfLine: bool = Tok.isAtStartOfLine();
    let mut HasLeadingSpace: bool = Tok.hasLeadingSpace();
    if II == self.Ident__LINE__ {
        let mut Loc: SourceLocation = Tok.getLocation();
        Loc = self.AdvanceToTokenCharacter(Loc, 0);
        Loc = self.SourceMgr.getExpansionRange(Loc).getEnd();
        let mut PLoc: PresumedLoc = self.SourceMgr.getPresumedLoc(Loc, true);
        OS << (if PLoc.isValid() { PLoc.getLine() } else { 1 });
        Tok.setKind(numeric_constant);
    } else if II == self.Ident__FILE__ || II == self.Ident__BASE_FILE__ || II == self.Ident__FILE_NAME__ {
        let mut PLoc: PresumedLoc = self.SourceMgr.getPresumedLoc(Tok.getLocation(), true);
        if II == self.Ident__BASE_FILE__ && PLoc.isValid() {
            let mut NextLoc: SourceLocation = PLoc.getIncludeLoc();
            while NextLoc.isValid() {
                PLoc = self.SourceMgr.getPresumedLoc(NextLoc, true);
                if PLoc.isInvalid() {
                    break;
                }
                NextLoc = PLoc.getIncludeLoc();
            }
        }
        let mut FN: str = zeroed();
        if PLoc.isValid() {
            if II == self.Ident__FILE_NAME__ {
                processPathToFileName(PLoc, self.getLangOpts(), self.getTargetInfo());
            } else {
                FN() += PLoc.getFilename();
                processPathForFileMacro(self.getLangOpts(), self.getTargetInfo());
            }
            Stringify();
            OS << '"' <<  << '"';
        }
        Tok.setKind(string_literal);
    } else if II == self.Ident__DATE__ {
        let mut TIMETokLen: u64 = 0;
        let mut DATETokLen: u64 = 0;
        ComputeDATE_TIME(self.DATELoc, DATETokLen, self.TIMELoc, TIMETokLen, *self);
        Tok.setKind(string_literal);
        Tok.setLength(DATETokLen);
        Tok.setLocation(self.SourceMgr.createExpansionLoc(self.DATELoc, Tok.getLocation(), Tok.getLocation(), Tok.getLength(), true, 0, 0));
        return;
    } else if II == self.Ident__TIME__ {
        let mut TIMETokLen: u64 = 0;
        let mut DATETokLen: u64 = 0;
        ComputeDATE_TIME(self.DATELoc, DATETokLen, self.TIMELoc, TIMETokLen, *self);
        Tok.setKind(string_literal);
        Tok.setLength(TIMETokLen);
        Tok.setLocation(self.SourceMgr.createExpansionLoc(self.TIMELoc, Tok.getLocation(), Tok.getLocation(), Tok.getLength(), true, 0, 0));
        return;
    } else if II == self.Ident__INCLUDE_LEVEL__ {
        let mut Depth: u32 = 0;
        let mut PLoc: PresumedLoc = self.SourceMgr.getPresumedLoc(Tok.getLocation(), true);
        if PLoc.isValid() {
            PLoc = self.SourceMgr.getPresumedLoc(PLoc.getIncludeLoc(), true);
            for ; PLoc.isValid(); Depth += 1 {
                PLoc = self.SourceMgr.getPresumedLoc(PLoc.getIncludeLoc(), true);
            }
        }
        OS << Depth;
        Tok.setKind(numeric_constant);
    } else if II == self.Ident__TIMESTAMP__ {
        let mut Result: str = "1";
        let mut TmpStream: stringstream = zeroed();
        if self.getPreprocessorOpts().InitDateTimeMacros == Default {
            TmpStream()(locale { "C", all });
            if self.getPreprocessorOpts() {
                let mut TT: time_t = *self.getPreprocessorOpts();
                let mut TM: *mut tm = gmtime(&mut TT);
                TmpStream() << put_time(TM, "%a %b %e %T %Y");
            } else {
                let mut CurFile: *FileEntry = null;
                if self.getCurrentFileLexer() {
                    TheLexer;
                } else {
                    CurFile = self.SourceMgr.getFileEntryForID(TheLexer.getFileID());
                }
                if CurFile {
                    let mut TT: time_t = CurFile.getModificationTime();
                    let mut TM: *mut tm = localtime(&mut TT);
                    TmpStream() << put_time(TM, "%a %b %e %T %Y");
                }
            }
            Result = ();
            if Result.is_empty() {
                Result = "??? ??? ?? ??:??:?? ????";
            }
        }
        OS << '"' << Result << '"';
        Tok.setKind(string_literal);
    } else if II == self.Ident__FLT_EVAL_METHOD__ {
        OS << self.getTUFPEvalMethod();
        Tok.setKind(numeric_constant);
        if self.getLastFPEvalPragmaLocation().isValid() {}
    } else if II == self.Ident__COUNTER__ {
        let mut MaxPosValue: u32 = max();
        if self.CounterValue > MaxPosValue {
            self.CounterValue = MaxPosValue;
        }
        OS << self.CounterValue += 1;
        Tok.setKind(numeric_constant);
    } else if II == self.Ident__has_feature {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_2 { cap_0: self });
    } else if II == self.Ident__has_extension {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_3 { cap_0: self });
    } else if II == self.Ident__has_builtin {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_4 { cap_0: self });
    } else if II == self.Ident__has_constexpr_builtin {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_5 { cap_0: self });
    } else if II == self.Ident__is_identifier {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_6 {});
    } else if II == self.Ident__has_attribute {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, true, Closure_7 { cap_0: self });
    } else if II == self.Ident__has_declspec {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, true, Closure_8 { cap_0: self });
    } else if II == self.Ident__has_cpp_attribute || II == self.Ident__has_c_attribute {
        let mut IsCXX: bool = II == self.Ident__has_cpp_attribute;
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, true, Closure_9 { cap_0: self, IsCXX: &mut IsCXX });
    } else if II == self.Ident__has_include || II == self.Ident__has_include_next {
        let mut Value: bool = false;
        if II == self.Ident__has_include {
            Value = self.EvaluateHasInclude(Tok, II);
        } else {
            Value = self.EvaluateHasIncludeNext(Tok, II);
        }
        if Tok.isNot(r_paren) {
            return;
        }
        OS << Value as i32;
        Tok.setKind(numeric_constant);
    } else if II == self.Ident__has_embed {
        let mut Value: EmbedResult = self.EvaluateHasEmbed(Tok, II);
        if Value == Invalid {
            return;
        }
        Tok.setKind(numeric_constant);
        OS << Value as i32;
    } else if II == self.Ident__has_warning {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_10 { cap_0: self });
    } else if II == self.Ident__building_module {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_11 { cap_0: self });
    } else if II == self.Ident__MODULE__ {
        OS << self.getLangOpts().CurrentModule;
        let mut ModuleII: *mut IdentifierInfo = self.getIdentifierInfo(self.getLangOpts().CurrentModule);
        Tok.setIdentifierInfo(ModuleII);
        Tok.setKind(ModuleII.getTokenID());
    } else if II == self.Ident__identifier {
        let mut Loc: SourceLocation = Tok.getLocation();
        self.LexNonComment(Tok);
        if Tok.isNot(l_paren) {
             << II << l_paren;
            if !Tok.isAnnotation() && Tok.getIdentifierInfo() {
                Tok.setKind(identifier);
            }
            return;
        }
        let mut LParenLoc: SourceLocation = Tok.getLocation();
        self.LexNonComment(Tok);
        if !Tok.isAnnotation() && Tok.getIdentifierInfo() {
            Tok.setKind(identifier);
        } else if Tok.is(string_literal) && !Tok.hasUDSuffix() {
            let mut Literal: StringLiteralParser = Tok(*self, Unevaluated);
            if Literal.hadError {
                return;
            }
            Tok.setIdentifierInfo(self.getIdentifierInfo(Literal.GetString()));
            Tok.setKind(identifier);
        } else {
             << Tok.getKind();
            if Tok || Tok.isAnnotation() {
                return;
            }
        }
        let mut RParen: Token = Token {};
        self.LexNonComment(RParen);
        if RParen.isNot(r_paren) {
             << Tok.getKind() << r_paren;
             << l_paren;
        }
        return;
    } else if II == self.Ident__is_target_arch {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_12 { cap_0: self });
    } else if II == self.Ident__is_target_vendor {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_13 { cap_0: self });
    } else if II == self.Ident__is_target_os {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_14 { cap_0: self });
    } else if II == self.Ident__is_target_environment {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_15 { cap_0: self });
    } else if II == self.Ident__is_target_variant_os {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_16 { cap_0: self });
    } else if II == self.Ident__is_target_variant_environment {
        EvaluateFeatureLikeBuiltinMacro(OS, Tok, II, *self, false, Closure_17 { cap_0: self });
    } else {
        llvm_unreachable_internal("Unknown identifier!", "clang\\lib\\Lex\\PPMacroExpansion.cpp", 2094);
    }
    self.CreateString(OS, Tok, MacroNameLoc, Tok.getLocation());
    Tok.setFlagValue(StartOfLine, IsAtStartOfLine);
    Tok.setFlagValue(LeadingSpace, HasLeadingSpace);
    Tok.clearFlag(NeedsCleaning);
}

fn Preprocessor::markMacroAsUsed(self, MI: *mut MacroInfo) {
    MI.setIsUsed(true);
}

fn Preprocessor::processPathForFileMacro(self, Path: *mut SmallVectorImpl<char>, LangOpts: *LangOptions, TI: *TargetInfo) {
    LangOpts.remapPathPrefix(Path);
    if LangOpts.UseTargetPathSeparator {
        if TI.getTriple().isOSWindows() {
            remove_dots(Path, false, windows_backslash);
        } else {
            remove_dots(Path, false, posix);
        }
    }
}

fn Preprocessor::processPathToFileName(self, FileName: *mut SmallVectorImpl<char>, PLoc: *PresumedLoc, LangOpts: *LangOptions, TI: *TargetInfo) {
    let mut PLFileName: str = filename(PLoc.getFilename(), native);
    if PLFileName.is_empty() {
        PLFileName = PLoc.getFilename();
    }
    FileName()(PLFileName.begin(), PLFileName.end());
    processPathForFileMacro(FileName, LangOpts, TI);
}

