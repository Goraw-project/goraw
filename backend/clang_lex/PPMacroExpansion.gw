fn Preprocessor::getLocalMacroDirectiveHistory(self: *Preprocessor, II: *IdentifierInfo) -> *mut MacroDirective {
    if !II.hadMacroDefinition() {
        return null;
    }
    let mut Pos: iterator = self.CurSubmoduleState.Macros.find(II);
    return if Pos == self.CurSubmoduleState.Macros.end() { null } else { operator(Pos).second.getLatest() };
}

fn Preprocessor::appendMacroDirective(self, II: *mut IdentifierInfo, MD: *mut MacroDirective) {
    assert!(MD, "MacroDirective should be non-zero!");
    assert!(!MD.getPrevious(), "Already attached to a MacroDirective history.");
    let mut StoredMD: *mut MacroState = self.CurSubmoduleState.Macros[II];
    let mut OldMD: *mut MacroDirective = StoredMD.getLatest();
    MD.setPrevious(OldMD);
    StoredMD.setLatest(MD);
    StoredMD.overrideActiveModuleMacros(*self, II);
    if self.needModuleMacros() {
        self.PendingModuleMacroNames.push(II);
    }
    II.setHasMacroDefinition(true);
    if !MD.isDefined() && !self.LeafModuleMacros.contains(II) {
        II.setHasMacroDefinition(false);
    }
    if II.isFromAST() {
        II.setChangedSinceDeserialization();
    }
}

fn Preprocessor::setLoadedMacroDirective(self, II: *mut IdentifierInfo, ED: *mut MacroDirective, MD: *mut MacroDirective) {
    assert!(II && MD);
    let mut StoredMD: *mut MacroState = self.CurSubmoduleState.Macros[II];
    if StoredMD.getLatest() {
        OldMD;
    } else {
        assert!(OldMD.getMacroInfo().isBuiltinMacro(), "only built-ins should have an entry here");
        assert!(!OldMD.getPrevious(), "builtin should only have a single entry");
        ED.setPrevious(OldMD);
        StoredMD.setLatest(MD);
    }
    II.setHasMacroDefinition(true);
    if !MD.isDefined() && !self.LeafModuleMacros.contains(II) {
        II.setHasMacroDefinition(false);
    }
}

fn Preprocessor::addModuleMacro(self, Mod: *mut Module, II: *mut IdentifierInfo, Macro: *mut MacroInfo, Overrides: ArrayRef<ModuleMacro *>, New: *mut bool) -> *mut ModuleMacro {
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.ModuleMacros.lookup(KeyTy { Mod, II }, InsertToken) {
        MM;
    } else {
        New = false;
        return MM;
    }
    let mut MM: *mut ModuleMacro = create(*self, Mod, II, Macro, Overrides);
    self.ModuleMacros.insert(MM, InsertToken);
    let mut HidAny: bool = false;
    for O in Overrides {
        HidAny |= (O.NumOverriddenBy == 0);
        O.NumOverriddenBy += 1;
    }
    let mut LeafMacros: *mut ModuleMacro *> = self.LeafModuleMacros[II];
    if HidAny {
        erase_if(LeafMacros, Closure_1 {});
    }
    LeafMacros.push(MM);
    II.setHasMacroDefinition(true);
    New = true;
    return MM;
}

fn Preprocessor::getModuleMacro(self, Mod: *mut Module, II: *IdentifierInfo) -> *mut ModuleMacro {
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    return self.ModuleMacros.lookup(KeyTy { Mod, II }, InsertToken);
}

fn Preprocessor::updateModuleMacroInfo(self, II: *IdentifierInfo, Info: *mut FullModuleMacroInfo) {
    assert!(Info.ActiveModuleMacrosGeneration != self.CurSubmoduleState.VisibleModules.getGeneration(), "don't need to update this macro name info");
    Info.ActiveModuleMacrosGeneration = self.CurSubmoduleState.VisibleModules.getGeneration();
    let mut Leaf: iterator = self.LeafModuleMacros.find(II);
    if Leaf == self.LeafModuleMacros.end() {
        return;
    }
    Info.ActiveModuleMacros.clear();
    let mut NumHiddenOverrides: DenseMap<ModuleMacro *, int> = DenseMap<ModuleMacro *, int> {};
    for O in Info.OverriddenMacros {
        NumHiddenOverrides[O] = -1;
    }
    let mut Worklist: SmallVector<ModuleMacro *, 16> = SmallVector<ModuleMacro *, 16> {};
    for LeafMM in operator(Leaf).second {
        assert!(LeafMM.getNumOverridingMacros() == 0, "leaf macro overridden");
        if NumHiddenOverrides.lookup(LeafMM) == 0 {
            Worklist.push(LeafMM);
        }
    }
    while !Worklist.is_empty() {
        let mut MM: *mut ModuleMacro = Worklist.pop_back_val();
        if self.CurSubmoduleState.VisibleModules.isVisible(MM.getOwningModule()) {
            if MM.getMacroInfo() {
                Info.ActiveModuleMacros.push(MM);
            }
        } else {
            for O in MM.overrides() {
                if NumHiddenOverrides[O] += 1 as u32 == O.getNumOverridingMacros() {
                    Worklist.push(O);
                }
            }
        }
    }
    reverse(Info.ActiveModuleMacros.begin(), Info.ActiveModuleMacros.end());
    let mut MI: *mut MacroInfo = null;
    let mut IsSystemMacro: bool = true;
    let mut IsAmbiguous: bool = false;
    if Info.MD {
        MD;
    } else {
        while isa_and_nonnull(MD) {
            MD = MD.getPrevious();
        }
        if dyn_cast_or_null(MD) {
            DMD;
        } else {
            MI = DMD.getInfo();
            IsSystemMacro &= self.SourceMgr.isInSystemHeader(DMD.getLocation());
        }
    }
    for Active in Info.ActiveModuleMacros {
        let mut NewMI: *mut MacroInfo = Active.getMacroInfo();
        if MI && NewMI != MI && !MI.isIdenticalTo(*NewMI, *self, true) {
            IsAmbiguous = true;
        }
        IsSystemMacro &= Active.getOwningModule().IsSystem || self.SourceMgr.isInSystemHeader(NewMI.getDefinitionLoc());
        MI = NewMI;
    }
    Info.IsAmbiguous = IsAmbiguous && !IsSystemMacro;
}

fn Preprocessor::dumpMacroInfo(self, II: *IdentifierInfo) {
    let mut Leaf: ArrayRef<ModuleMacro *> = ArrayRef<ModuleMacro *> {};
    let mut LeafIt: iterator = self.LeafModuleMacros.find(II);
    if LeafIt != self.LeafModuleMacros.end() {
        Leaf = operator(LeafIt).second;
    }
    let mut State: *MacroState = null;
    let mut Pos: iterator = self.CurSubmoduleState.Macros.find(II);
    if Pos != self.CurSubmoduleState.Macros.end() {
        State = &mut operator(Pos).second;
    }
    errs() << "MacroState " << State << " " << II.getNameStart();
    let mut ModuleInfo: ModuleMacroInfo = if State { State.getModuleInfo(*self, II) } else { ModuleMacroInfo { ActiveModuleMacros: ArrayRef<ModuleMacro *> {}, IsAmbiguous: false } };
    if ModuleInfo.IsAmbiguous {
        errs() << " ambiguous";
    }
    if State && !State.getOverriddenMacros().is_empty() {
        errs() << " overrides";
        for O in State.getOverriddenMacros() {
            errs() << " " << O.getOwningModule().getFullModuleName(false);
        }
    }
    errs() << "\n";
    for let mut MD: *mut MacroDirective = if State { State.getLatest() } else { null }; MD; MD = MD.getPrevious() {
        errs() << " ";
        MD.dump();
    }
    let mut Active: DenseSet<ModuleMacro *> = DenseSet<ModuleMacro *> { from_range, ModuleInfo.ActiveModuleMacros };
    let mut Visited: DenseSet<ModuleMacro *> = DenseSet<ModuleMacro *> {};
    let mut Worklist: SmallVector<ModuleMacro *, 16> = Leaf;
    while !Worklist.is_empty() {
        let mut MM: *mut ModuleMacro = Worklist.pop_back_val();
        errs() << " ModuleMacro " << MM << " " << MM.getOwningModule().getFullModuleName(false);
        if !MM.getMacroInfo() {
            errs() << " undef";
        }
        if Active.count(MM) {
            errs() << " active";
        } else if !self.CurSubmoduleState.VisibleModules.isVisible(MM.getOwningModule()) {
            errs() << " hidden";
        } else if MM.getMacroInfo() {
            errs() << " overridden";
        }
        if !MM.overrides().is_empty() {
            errs() << " overrides";
            for O in MM.overrides() {
                errs() << " " << O.getOwningModule().getFullModuleName(false);
                if Visited.insert(O).second {
                    Worklist.push(O);
                }
            }
        }
        errs() << "\n";
        if MM.getMacroInfo() {
            MI;
        } else {
            errs() << "  ";
            MI.dump();
            errs() << "\n";
        }
    }
}

fn Preprocessor::RegisterBuiltinMacros(self) {
    self.Ident__LINE__ = self.RegisterBuiltinMacro("__LINE__");
    self.Ident__FILE__ = self.RegisterBuiltinMacro("__FILE__");
    if self.getPreprocessorOpts().InitDateTimeMacros != Undefined {
        self.Ident__DATE__ = self.RegisterBuiltinMacro("__DATE__");
        self.Ident__TIME__ = self.RegisterBuiltinMacro("__TIME__");
    } else {
        self.Ident__DATE__ = null;
        self.Ident__TIME__ = null;
    }
    self.Ident__COUNTER__ = self.RegisterBuiltinMacro("__COUNTER__");
    self.Ident_Pragma = self.RegisterBuiltinMacro("_Pragma");
    self.Ident__FLT_EVAL_METHOD__ = self.RegisterBuiltinMacro("__FLT_EVAL_METHOD__");
    if self.getLangOpts().CPlusPlus {
        self.Ident__has_cpp_attribute = self.RegisterBuiltinMacro("__has_cpp_attribute");
    } else {
        self.Ident__has_cpp_attribute = null;
    }
    self.Ident__BASE_FILE__ = self.RegisterBuiltinMacro("__BASE_FILE__");
    self.Ident__INCLUDE_LEVEL__ = self.RegisterBuiltinMacro("__INCLUDE_LEVEL__");
    if self.getPreprocessorOpts().InitDateTimeMacros != Undefined {
        self.Ident__TIMESTAMP__ = self.RegisterBuiltinMacro("__TIMESTAMP__");
    } else {
        self.Ident__TIMESTAMP__ = null;
    }
    if self.getLangOpts().MicrosoftExt {
        self.Ident__identifier = self.RegisterBuiltinMacro("__identifier");
        self.Ident__pragma = self.RegisterBuiltinMacro("__pragma");
    } else {
        self.Ident__identifier = null;
        self.Ident__pragma = null;
    }
    self.Ident__FILE_NAME__ = self.RegisterBuiltinMacro("__FILE_NAME__");
    self.Ident__has_feature = self.RegisterBuiltinMacro("__has_feature");
    self.Ident__has_extension = self.RegisterBuiltinMacro("__has_extension");
    self.Ident__has_builtin = self.RegisterBuiltinMacro("__has_builtin");
    self.Ident__has_constexpr_builtin = self.RegisterBuiltinMacro("__has_constexpr_builtin");
    self.Ident__has_attribute = self.RegisterBuiltinMacro("__has_attribute");
    if !self.getLangOpts().CPlusPlus {
        self.Ident__has_c_attribute = self.RegisterBuiltinMacro("__has_c_attribute");
    } else {
        self.Ident__has_c_attribute = null;
    }
    self.Ident__has_declspec = self.RegisterBuiltinMacro("__has_declspec_attribute");
    self.Ident__has_embed = self.RegisterBuiltinMacro("__has_embed");
    self.Ident__has_include = self.RegisterBuiltinMacro("__has_include");
    self.Ident__has_include_next = self.RegisterBuiltinMacro("__has_include_next");
    self.Ident__has_warning = self.RegisterBuiltinMacro("__has_warning");
    self.Ident__is_identifier = self.RegisterBuiltinMacro("__is_identifier");
    self.Ident__is_target_arch = self.RegisterBuiltinMacro("__is_target_arch");
    self.Ident__is_target_vendor = self.RegisterBuiltinMacro("__is_target_vendor");
    self.Ident__is_target_os = self.RegisterBuiltinMacro("__is_target_os");
    self.Ident__is_target_environment = self.RegisterBuiltinMacro("__is_target_environment");
    self.Ident__is_target_variant_os = self.RegisterBuiltinMacro("__is_target_variant_os");
    self.Ident__is_target_variant_environment = self.RegisterBuiltinMacro("__is_target_variant_environment");
    self.Ident__building_module = self.RegisterBuiltinMacro("__building_module");
    if !self.getLangOpts().CurrentModule.is_empty() {
        self.Ident__MODULE__ = self.RegisterBuiltinMacro("__MODULE__");
    } else {
        self.Ident__MODULE__ = null;
    }
}

fn isTrivialSingleTokenExpansion(MI: *MacroInfo, MacroIdent: *IdentifierInfo, PP: *mut Preprocessor) -> bool {
    let mut II: *mut IdentifierInfo = MI.getReplacementToken(0).getIdentifierInfo();
    if !II {
        return true;
    }
    if II.isOutOfDate() {
        PP.getExternalSource().updateOutOfDateIdentifier(*II);
    }
    if PP.getMacroInfo(II) {
        ExpansionMI;
    } else if ExpansionMI.isEnabled() && II != MacroIdent {
        return false;
    }
    if MI.isObjectLike() {
        return true;
    }
    return !is_contained(MI.params(), II);
}

fn Preprocessor::HandleMacroExpandedIdentifier(self, Identifier: *mut Token, M: *MacroDefinition) -> bool {
    self.emitMacroExpansionWarnings(Identifier, false);
    let mut MI: *mut MacroInfo = M.getMacroInfo();
    if self.CurPPLexer {
        self.CurPPLexer.MIOpt.ExpandedMacro();
    }
    if MI.isBuiltinMacro() {
        if self.Callbacks {
            operator(self.Callbacks).MacroExpands(Identifier, M, Identifier.getLocation(), null);
        }
        self.ExpandBuiltinMacro(Identifier);
        return true;
    }
    let mut Args: *mut MacroArgs = null;
    let mut ExpansionEnd: SourceLocation = Identifier.getLocation();
    if MI.isFunctionLike() {
        self.InMacroArgs = true;
        self.ArgMacro = &mut Identifier;
        Args = self.ReadMacroCallArgumentList(Identifier, MI, ExpansionEnd);
        self.InMacroArgs = false;
        self.ArgMacro = null;
        if !Args {
            return true;
        }
        self.NumFnMacroExpanded += 1;
    } else {
        self.NumMacroExpanded += 1;
    }
    self.markMacroAsUsed(MI);
    let mut ExpandLoc: SourceLocation = Identifier.getLocation();
    let mut ExpansionRange: SourceRange = SourceRange { B: ExpandLoc, E: ExpansionEnd };
    if self.Callbacks {
        if self.InMacroArgs {
            self.DelayedMacroExpandsCallbacks.push(MacroExpandsInfo { Identifier, M, ExpansionRange });
        } else {
            operator(self.Callbacks).MacroExpands(Identifier, M, ExpansionRange, Args);
            if !self.DelayedMacroExpandsCallbacks.is_empty() {
                for Info in self.DelayedMacroExpandsCallbacks {
                    operator(self.Callbacks).MacroExpands(Info.Tok, Info.MD, Info.Range, null);
                }
                self.DelayedMacroExpandsCallbacks.clear();
            }
        }
    }
    if M.isAmbiguous() {
        self.Diag(Identifier, warn_pp_ambiguous_macro) << Identifier.getIdentifierInfo();
        self.Diag(MI.getDefinitionLoc(), note_pp_ambiguous_macro_chosen) << Identifier.getIdentifierInfo();
        M.forAllDefinitions(Closure_2 { MI: &mut MI, cap_1: self, Identifier: &mut Identifier });
    }
    if MI.getNumTokens() == 0 {
        if Args {
            Args.destroy(*self);
        }
        Identifier.setFlag(LeadingEmptyMacro);
        self.PropagateLineStartLeadingSpaceInfo(Identifier);
        self.NumFastMacroExpanded += 1;
        return false;
    } else if MI.getNumTokens() == 1 && isTrivialSingleTokenExpansion(MI, Identifier.getIdentifierInfo(), *self) {
        if Args {
            Args.destroy(*self);
        }
        let mut isAtStartOfLine: bool = Identifier.isAtStartOfLine();
        let mut hasLeadingSpace: bool = Identifier.hasLeadingSpace();
        Identifier = MI.getReplacementToken(0);
        Identifier.setFlagValue(StartOfLine, isAtStartOfLine);
        Identifier.setFlagValue(LeadingSpace, hasLeadingSpace);
        let mut Loc: SourceLocation = self.SourceMgr.createExpansionLoc(Identifier.getLocation(), ExpandLoc, ExpansionEnd, Identifier.getLength(), true, 0, 0);
        Identifier.setLocation(Loc);
        if Identifier.getIdentifierInfo() {
            NewII;
        } else {
            if self.getMacroInfo(NewII) {
                NewMI;
            } else if !NewMI.isEnabled() || NewMI == MI {
                Identifier.setFlag(DisableExpand);
                if NewMI != MI || MI.isFunctionLike() {
                    self.Diag(Identifier, pp_disabled_macro_expansion);
                }
            }
        }
        self.NumFastMacroExpanded += 1;
        return true;
    }
    self.EnterMacro(Identifier, ExpansionEnd, MI, Args);
    return false;
}

enum Bracket {
    Brace = 0,
    Paren = 1,
}

fn CheckMatchedBrackets(Tokens: *SmallVectorImpl<Token>) -> bool {
    let mut Brackets: SmallVector<Bracket, 8> = SmallVector<Bracket, 8> {};
    for let mut I: const_iterator = Tokens.begin();
let mut E: const_iterator = Tokens.end(); I != E; I += 1 {
        if I.is(l_paren) {
            Brackets.push(Paren);
        } else if I.is(r_paren) {
            if Brackets.is_empty() || Brackets.back() == Brace {
                return false;
            }
            Brackets.pop();
        } else if I.is(l_brace) {
            Brackets.push(Brace);
        } else if I.is(r_brace) {
            if Brackets.is_empty() || Brackets.back() == Paren {
                return false;
            }
            Brackets.pop();
        }
    }
    return Brackets.is_empty();
}

fn GenerateNewArgTokens(PP: *mut Preprocessor, OldTokens: *mut SmallVectorImpl<Token>, NewTokens: *mut SmallVectorImpl<Token>, NumArgs: *mut u32, ParenHints: *mut SmallVectorImpl<SourceRange>, InitLists: *mut SmallVectorImpl<SourceRange>) -> bool {
    if !CheckMatchedBrackets(OldTokens) {
        return false;
    }
    let mut Braces: u32 = 0;
    let mut ArgStartIterator: iterator = OldTokens.begin();
    let mut ClosingBrace: iterator = OldTokens.end();
    NumArgs = 0;
    let mut TempToken: Token = Token {};
    let mut FoundSeparatorToken: bool = false;
    for let mut I: iterator = OldTokens.begin();
let mut E: iterator = OldTokens.end(); I != E; I += 1 {
        if I.is(l_brace) {
            Braces += 1;
        } else if I.is(r_brace) {
            Braces -= 1;
            if Braces == 0 && ClosingBrace == E && FoundSeparatorToken {
                ClosingBrace = I;
            }
        } else if I.is(eof) {
            if Braces != 0 {
                FoundSeparatorToken = true;
                I.setKind(comma);
                I.setLength(1);
            } else {
                NumArgs += 1;
                if FoundSeparatorToken && ArgStartIterator.is(l_brace) {
                    InitLists.push(SourceRange { B: ArgStartIterator.getLocation(), E: PP.getLocForEndOfToken(ClosingBrace.getLocation(), 0) });
                    ClosingBrace = E;
                }
                if FoundSeparatorToken {
                    TempToken.startToken();
                    TempToken.setKind(l_paren);
                    TempToken.setLocation(ArgStartIterator.getLocation());
                    TempToken.setLength(0);
                    NewTokens.push(TempToken);
                }
                NewTokens.insert(NewTokens.end(), ArgStartIterator, I);
                if FoundSeparatorToken {
                    let mut Loc: SourceLocation = PP.getLocForEndOfToken((I - 1).getLocation(), 0);
                    TempToken.startToken();
                    TempToken.setKind(r_paren);
                    TempToken.setLocation(Loc);
                    TempToken.setLength(0);
                    NewTokens.push(TempToken);
                    ParenHints.push(SourceRange { B: ArgStartIterator.getLocation(), E: Loc });
                }
                NewTokens.push(*I);
                ArgStartIterator = I + 1;
                FoundSeparatorToken = false;
            }
        }
    }
    return !ParenHints.is_empty() && InitLists.is_empty();
}

fn Preprocessor::ReadMacroCallArgumentList(self, MacroName: *mut Token, MI: *mut MacroInfo, MacroEnd: *mut SourceLocation) -> *mut MacroArgs {
    let mut NumFixedArgsLeft: u32 = MI.getNumParams();
    let mut isVariadic: bool = MI.isVariadic();
    let mut Tok: Token = Token {};
    self.LexUnexpandedToken(Tok);
    assert!(Tok.is(l_paren), "Error computing l-paren-ness?");
    let mut ArgTokens: SmallVector<Token, 64> = SmallVector<Token, 64> {};
    let mut ContainsCodeCompletionTok: bool = false;
    let mut FoundElidedComma: bool = false;
    let mut TooManyArgsLoc: SourceLocation = SourceLocation {};
    let mut NumActuals: u32 = 0;
    while Tok.isNot(r_paren) {
        if ContainsCodeCompletionTok && Tok.isOneOf(eof, eod) {
            break;
        }
        assert!(Tok.isOneOf(l_paren, comma), "only expect argument separators here");
        let mut ArgTokenStart: u64 = ArgTokens.len;
        let mut ArgStartLoc: SourceLocation = Tok.getLocation();
        let mut NumParens: u32 = 0;
        while true {
            self.LexUnexpandedToken(Tok);
            if Tok.isOneOf(eof, eod) {
                if !ContainsCodeCompletionTok {
                    self.Diag(MacroName, err_unterm_macro_invoc);
                    self.Diag(MI.getDefinitionLoc(), note_macro_here) << MacroName.getIdentifierInfo();
                    MacroName = Tok;
                    return null;
                }
                let mut Toks: []Token = make_unique(1);
                Toks[0] = Tok;
                self.EnterTokenStream(move(Toks), 1, true, false);
                break;
            } else if Tok.is(r_paren) {
                if NumParens -= 1 == 0 {
                    MacroEnd = Tok.getLocation();
                    if !ArgTokens.is_empty() && ArgTokens.back().commaAfterElided() {
                        FoundElidedComma = true;
                    }
                    break;
                }
            } else if Tok.is(l_paren) {
                NumParens += 1;
            } else if Tok.is(comma) {
                if Tok.getFlags() & IgnoredComma {
                    Tok.clearFlag(IgnoredComma);
                } else if NumParens == 0 {
                    if !isVariadic {
                        break;
                    }
                    if NumFixedArgsLeft > 1 {
                        break;
                    }
                }
            } else if Tok.is(comment) && !self.KeepMacroComments {
                continue;
            } else if !Tok.isAnnotation() && Tok.getIdentifierInfo() != null {
                if self.getMacroInfo(Tok.getIdentifierInfo()) {
                    MI;
                } else if !MI.isEnabled() {
                    Tok.setFlag(DisableExpand);
                }
            } else if Tok.is(code_completion) {
                ContainsCodeCompletionTok = true;
                if self.CodeComplete {
                    self.CodeComplete.CodeCompleteMacroArgument(MacroName.getIdentifierInfo(), MI, NumActuals);
                }
            }
            ArgTokens.push(Tok);
        }
        if ArgTokens.is_empty() && Tok.getKind() == r_paren {
            break;
        }
        if !isVariadic && NumFixedArgsLeft == 0 && TooManyArgsLoc.isInvalid() {
            if ArgTokens.len != ArgTokenStart {
                TooManyArgsLoc = ArgTokens[ArgTokenStart].getLocation();
            } else {
                TooManyArgsLoc = ArgStartLoc;
            }
        }
        if ArgTokens.len == ArgTokenStart && !self.getLangOpts().C99 {
            if self.getLangOpts().CPlusPlus {
                self.DiagCompat(Tok, empty_fnmacro_arg);
            } else {
                self.Diag(Tok, ext_empty_fnmacro_arg);
            }
        }
        let mut EOFTok: Token = Token {};
        EOFTok.startToken();
        EOFTok.setKind(eof);
        EOFTok.setLocation(Tok.getLocation());
        EOFTok.setLength(0);
        ArgTokens.push(EOFTok);
        NumActuals += 1;
        if !ContainsCodeCompletionTok && NumFixedArgsLeft != 0 {
            NumFixedArgsLeft -= 1;
        }
    }
    let mut MinArgsExpected: u32 = MI.getNumParams();
    if !isVariadic && NumActuals > MinArgsExpected && !ContainsCodeCompletionTok {
        self.Diag(TooManyArgsLoc, err_too_many_args_in_macro_invoc);
        self.Diag(MI.getDefinitionLoc(), note_macro_here) << MacroName.getIdentifierInfo();
        let mut FixedArgTokens: SmallVector<Token, 4> = SmallVector<Token, 4> {};
        let mut FixedNumArgs: u32 = 0;
        let mut ParenHints: SmallVector<SourceRange, 4> = SmallVector<SourceRange, 4> {};
        let mut InitLists: SmallVector<SourceRange, 4> = SmallVector<SourceRange, 4> {};
        if !GenerateNewArgTokens(*self, ArgTokens, FixedArgTokens, FixedNumArgs, ParenHints, InitLists) {
            if !InitLists.is_empty() {
                let mut DB: DiagnosticBuilder = self.Diag(MacroName, note_init_list_at_beginning_of_macro_argument);
                for Range in InitLists {
                    DB << Range;
                }
            }
            return null;
        }
        if FixedNumArgs != MinArgsExpected {
            return null;
        }
        let mut DB: DiagnosticBuilder = self.Diag(MacroName, note_suggest_parens_for_macro);
        for ParenLocation in ParenHints {
            DB << CreateInsertion(ParenLocation.getBegin(), "(", false);
            DB << CreateInsertion(ParenLocation.getEnd(), ")", false);
        }
        ArgTokens.swap(FixedArgTokens);
        NumActuals = FixedNumArgs;
    }
    let mut isVarargsElided: bool = false;
    if ContainsCodeCompletionTok {
        let mut EOFTok: Token = Token {};
        EOFTok.startToken();
        EOFTok.setKind(eof);
        EOFTok.setLocation(Tok.getLocation());
        EOFTok.setLength(0);
        for ; NumActuals < MinArgsExpected; NumActuals += 1 {
            ArgTokens.push(EOFTok);
        }
    }
    if NumActuals < MinArgsExpected {
        if NumActuals == 0 && MinArgsExpected == 1 {
            isVarargsElided = MI.isVariadic();
        } else if (FoundElidedComma || MI.isVariadic()) && (NumActuals + 1 == MinArgsExpected || (NumActuals == 0 && MinArgsExpected == 2)) {
            if !MI.hasCommaPasting() {
                let mut ID: u32 = 0;
                if self.getLangOpts().CPlusPlus20 {
                    ID = warn_cxx17_compat_missing_varargs_arg;
                } else if self.getLangOpts().CPlusPlus {
                    ID = ext_cxx_missing_varargs_arg;
                } else if self.getLangOpts().C23 {
                    ID = warn_c17_compat_missing_varargs_arg;
                } else {
                    ID = ext_c_missing_varargs_arg;
                }
                self.Diag(Tok, ID);
                self.Diag(MI.getDefinitionLoc(), note_macro_here) << MacroName.getIdentifierInfo();
            }
            isVarargsElided = true;
        } else if !ContainsCodeCompletionTok {
            self.Diag(Tok, err_too_few_args_in_macro_invoc);
            self.Diag(MI.getDefinitionLoc(), note_macro_here) << MacroName.getIdentifierInfo();
            return null;
        }
        let mut EndLoc: SourceLocation = Tok.getLocation();
        Tok.startToken();
        Tok.setKind(eof);
        Tok.setLocation(EndLoc);
        Tok.setLength(0);
        ArgTokens.push(Tok);
        if NumActuals == 0 && MinArgsExpected == 2 {
            ArgTokens.push(Tok);
        }
    } else if NumActuals > MinArgsExpected && !MI.isVariadic() && !ContainsCodeCompletionTok {
        self.Diag(MacroName, err_too_many_args_in_macro_invoc);
        self.Diag(MI.getDefinitionLoc(), note_macro_here) << MacroName.getIdentifierInfo();
        return null;
    }
    return create(MI, ArgTokens, isVarargsElided, *self);
}

fn Preprocessor::cacheMacroExpandedTokens(self, tokLexer: *mut TokenLexer, tokens: ArrayRef<Token>) -> *mut Token {
    assert!(tokLexer);
    if tokens.is_empty() {
        return null;
    }
    let mut newIndex: u64 = self.MacroExpandedTokens.len;
    let mut cacheNeedsToGrow: bool = tokens.len > self.MacroExpandedTokens.capacity() - self.MacroExpandedTokens.len;
    self.MacroExpandedTokens.append(tokens.begin(), tokens.end());
    if cacheNeedsToGrow {
        for Lexer in self.MacroExpandingLexersStack {
            let mut prevLexer: *mut TokenLexer = null;
            let mut tokIndex: u64 = 0;
            tie(prevLexer, tokIndex) = Lexer;
            prevLexer.Tokens = self.MacroExpandedTokens.ptr + tokIndex;
        }
    }
    self.MacroExpandingLexersStack.push(make_pair(tokLexer, newIndex));
    return self.MacroExpandedTokens.ptr + newIndex;
}

fn Preprocessor::removeCachedMacroExpandedTokensOfLastLexer(self) {
    assert!(!self.MacroExpandingLexersStack.is_empty();
    let mut tokIndex: u64 = self.MacroExpandingLexersStack.back().second;
    assert!(tokIndex < self.MacroExpandedTokens.len);
    self.MacroExpandedTokens.resize(tokIndex);
    self.MacroExpandingLexersStack.pop();
}

fn ComputeDATE_TIME(DATELoc: *mut SourceLocation, DATETokLen: *mut u64, TIMELoc: *mut SourceLocation, TIMETokLen: *mut u64, PP: *mut Preprocessor) {
    if PP.getPreprocessorOpts().InitDateTimeMacros == LiteralOne {
        if !DATELoc.isValid() {
            let mut TmpTok: Token = Token {};
            TmpTok.startToken();
            PP.CreateString("\"1\"", TmpTok, SourceLocation {}, SourceLocation {});
            DATELoc = TmpTok.getLocation();
        }
        DATETokLen = strlen("\"1\"");
        if !TIMELoc.isValid() {
            let mut TmpTok: Token = Token {};
            TmpTok.startToken();
            PP.CreateString("\"1\"", TmpTok, SourceLocation {}, SourceLocation {});
            TIMELoc = TmpTok.getLocation();
        }
        TIMETokLen = strlen("\"1\"");
        return;
    }
    let mut TT: time_t = zeroed();
    let mut TM: *mut tm = null;
    if PP.getPreprocessorOpts().SourceDateEpoch {
        TT = operator(PP.getPreprocessorOpts().SourceDateEpoch);
        TM = gmtime(&mut TT);
    } else {
        TT = time(null);
        TM = localtime(&mut TT);
    }
    let mut Months: [12]char *const = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    if !DATELoc.isValid() {
        let mut TmpBuffer: str = "";
        let mut TmpStream: raw_svector_ostream = TmpBuffer;
        if TM {
            TmpStream << format("\"%s %2d %4d\"", Months[TM.tm_mon], TM.tm_mday, TM.tm_year + 1900);
        } else {
            TmpStream << "??? ?? ????";
        }
        let mut TmpTok: Token = Token {};
        TmpTok.startToken();
        PP.CreateString(TmpStream, TmpTok, SourceLocation {}, SourceLocation {});
        DATELoc = TmpTok.getLocation();
    }
    DATETokLen = strlen("\"Mmm dd yyyy\"");
    if !TIMELoc.isValid() {
        let mut TmpBuffer: str = "";
        let mut TmpStream: raw_svector_ostream = TmpBuffer;
        if TM {
            TmpStream << format("\"%02d:%02d:%02d\"", TM.tm_hour, TM.tm_min, TM.tm_sec);
        } else {
            TmpStream << "??:??:??";
        }
        let mut TmpTok: Token = Token {};
        TmpTok.startToken();
        PP.CreateString(TmpStream, TmpTok, SourceLocation {}, SourceLocation {});
        TIMELoc = TmpTok.getLocation();
    }
    TIMETokLen = strlen("\"hh:mm:ss\"");
}

fn HasFeature(PP: *Preprocessor, Feature: str) -> bool {
    let mut LangOpts: *LangOptions = PP.getLangOpts();
    if Feature.starts_with("__") && Feature.ends_with("__") && Feature.len >= 4 {
        Feature = Feature[2..2 + Feature.len - 4];
    }
    return Feature.Case("speculative_load_hardening", LangOpts.SpeculativeLoadHardening).Case("address_sanitizer", LangOpts.Sanitize.hasOneOf(Address | KernelAddress)).Case("leak_sanitizer", LangOpts.Sanitize.has(Leak)).Case("hwaddress_sanitizer", LangOpts.Sanitize.hasOneOf(HWAddress | KernelHWAddress)).Case("memtag_stack", LangOpts.Sanitize.has(MemtagStack)).Case("memtag_heap", LangOpts.Sanitize.has(MemtagHeap)).Case("memtag_globals", LangOpts.Sanitize.has(MemtagGlobals)).Case("xray_instrument", LangOpts.XRayInstrument).Case("undefined_behavior_sanitizer", LangOpts.Sanitize.hasOneOf(Undefined & operator(LangOpts.UBSanFeatureIgnoredSanitize.Mask))).Case("undefined_behavior_sanitizer_finegrained_feature_checks", true).Case("alignment_sanitizer", LangOpts.Sanitize.has(Alignment)).Case("bool_sanitizer", LangOpts.Sanitize.has(Bool)).Case("builtin_sanitizer", LangOpts.Sanitize.has(Builtin)).Case("array_bounds_sanitizer", LangOpts.Sanitize.has(ArrayBounds)).Case("enum_sanitizer", LangOpts.Sanitize.has(Enum)).Case("float_cast_overflow_sanitizer", LangOpts.Sanitize.has(FloatCastOverflow)).Case("integer_divide_by_zero_sanitizer", LangOpts.Sanitize.has(IntegerDivideByZero)).Case("nonnull_attribute_sanitizer", LangOpts.Sanitize.has(NonnullAttribute)).Case("null_sanitizer", LangOpts.Sanitize.has(Null)).Case("object_size_sanitizer", LangOpts.Sanitize.has(ObjectSize)).Case("pointer_overflow_sanitizer", LangOpts.Sanitize.has(PointerOverflow)).Case("return_sanitizer", LangOpts.Sanitize.has(Return)).Case("returns_nonnull_attribute_sanitizer", LangOpts.Sanitize.has(ReturnsNonnullAttribute)).Case("shift_base_sanitizer", LangOpts.Sanitize.has(ShiftBase)).Case("shift_exponent_sanitizer", LangOpts.Sanitize.has(ShiftExponent)).Case("shift_sanitizer", LangOpts.Sanitize.hasOneOf(Shift)).Case("signed_integer_overflow_sanitizer", LangOpts.Sanitize.has(SignedIntegerOverflow)).Case("unreachable_sanitizer", LangOpts.Sanitize.has(Unreachable)).Case("vla_bound_sanitizer", LangOpts.Sanitize.has(VLABound)).Case("function_sanitizer", LangOpts.Sanitize.has(Function)).Case("realtime_sanitizer", LangOpts.Sanitize.has(Realtime)).Case("coverage_sanitizer", LangOpts.SanitizeCoverage).Case("assume_nonnull", true).Case("attribute_analyzer_noreturn", true).Case("attribute_availability", true).Case("attribute_availability_with_message", true).Case("attribute_availability_app_extension", true).Case("attribute_availability_with_version_underscores", true).Case("attribute_availability_tvos", true).Case("attribute_availability_watchos", true).Case("attribute_availability_driverkit", true).Case("attribute_availability_with_strict", true).Case("attribute_availability_with_replacement", true).Case("attribute_availability_in_templates", true).Case("attribute_availability_swift", true).Case("attribute_cf_returns_not_retained", true).Case("attribute_cf_returns_retained", true).Case("attribute_cf_returns_on_parameters", true).Case("attribute_deprecated_with_message", true).Case("attribute_deprecated_with_replacement", true).Case("attribute_ext_vector_type", true).Case("attribute_ns_returns_not_retained", true).Case("attribute_ns_returns_retained", true).Case("attribute_ns_consumes_self", true).Case("attribute_ns_consumed", true).Case("attribute_cf_consumed", true).Case("attribute_objc_ivar_unused", true).Case("attribute_objc_method_family", true).Case("attribute_overloadable", true).Case("attribute_unavailable_with_message", true).Case("attribute_unused_on_fields", true).Case("attribute_diagnose_if_objc", true).Case("ext_vector_type_boolean", true).Case("blocks", LangOpts.Blocks).Case("c_thread_safety_attributes", true).Case("cxx_exceptions", LangOpts.CXXExceptions).Case("cxx_rtti", LangOpts.RTTI && LangOpts.RTTIData).Case("enumerator_attributes", true).Case("nullability", true).Case("nullability_on_arrays", true).Case("nullability_on_classes", true).Case("nullability_nullable_result", true).Case("numerical_stability_sanitizer", LangOpts.Sanitize.has(NumericalStability)).Case("memo