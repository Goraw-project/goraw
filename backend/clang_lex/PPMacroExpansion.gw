fn Preprocessor::RegisterBuiltinMacros(self) {
    self.Ident__LINE__ = self.RegisterBuiltinMacro("__LINE__");
    self.Ident__FILE__ = self.RegisterBuiltinMacro("__FILE__");
    if self.getPreprocessorOpts().InitDateTimeMacros != Undefined {
        self.Ident__DATE__ = self.RegisterBuiltinMacro("__DATE__");
        self.Ident__TIME__ = self.RegisterBuiltinMacro("__TIME__");
    } else {
        self.Ident__DATE__ = null;
        self.Ident__TIME__ = null;
    }
    self.Ident__COUNTER__ = self.RegisterBuiltinMacro("__COUNTER__");
    self.Ident_Pragma = self.RegisterBuiltinMacro("_Pragma");
    self.Ident__FLT_EVAL_METHOD__ = self.RegisterBuiltinMacro("__FLT_EVAL_METHOD__");
    if self.getLangOpts() {
        self.Ident__has_cpp_attribute = self.RegisterBuiltinMacro("__has_cpp_attribute");
    } else {
        self.Ident__has_cpp_attribute = null;
    }
    self.Ident__BASE_FILE__ = self.RegisterBuiltinMacro("__BASE_FILE__");
    self.Ident__INCLUDE_LEVEL__ = self.RegisterBuiltinMacro("__INCLUDE_LEVEL__");
    if self.getPreprocessorOpts().InitDateTimeMacros != Undefined {
        self.Ident__TIMESTAMP__ = self.RegisterBuiltinMacro("__TIMESTAMP__");
    } else {
        self.Ident__TIMESTAMP__ = null;
    }
    if self.getLangOpts() {
        self.Ident__identifier = self.RegisterBuiltinMacro("__identifier");
        self.Ident__pragma = self.RegisterBuiltinMacro("__pragma");
    } else {
        self.Ident__identifier = null;
        self.Ident__pragma = null;
    }
    self.Ident__FILE_NAME__ = self.RegisterBuiltinMacro("__FILE_NAME__");
    self.Ident__has_feature = self.RegisterBuiltinMacro("__has_feature");
    self.Ident__has_extension = self.RegisterBuiltinMacro("__has_extension");
    self.Ident__has_builtin = self.RegisterBuiltinMacro("__has_builtin");
    self.Ident__has_constexpr_builtin = self.RegisterBuiltinMacro("__has_constexpr_builtin");
    self.Ident__has_attribute = self.RegisterBuiltinMacro("__has_attribute");
    if operator!(self.getLangOpts()) {
        self.Ident__has_c_attribute = self.RegisterBuiltinMacro("__has_c_attribute");
    } else {
        self.Ident__has_c_attribute = null;
    }
    self.Ident__has_declspec = self.RegisterBuiltinMacro("__has_declspec_attribute");
    self.Ident__has_embed = self.RegisterBuiltinMacro("__has_embed");
    self.Ident__has_include = self.RegisterBuiltinMacro("__has_include");
    self.Ident__has_include_next = self.RegisterBuiltinMacro("__has_include_next");
    self.Ident__has_warning = self.RegisterBuiltinMacro("__has_warning");
    self.Ident__is_identifier = self.RegisterBuiltinMacro("__is_identifier");
    self.Ident__is_target_arch = self.RegisterBuiltinMacro("__is_target_arch");
    self.Ident__is_target_vendor = self.RegisterBuiltinMacro("__is_target_vendor");
    self.Ident__is_target_os = self.RegisterBuiltinMacro("__is_target_os");
    self.Ident__is_target_environment = self.RegisterBuiltinMacro("__is_target_environment");
    self.Ident__is_target_variant_os = self.RegisterBuiltinMacro("__is_target_variant_os");
    self.Ident__is_target_variant_environment = self.RegisterBuiltinMacro("__is_target_variant_environment");
    self.Ident__building_module = self.RegisterBuiltinMacro("__building_module");
    if !self.getLangOpts().CurrentModule.is_empty() {
        self.Ident__MODULE__ = self.RegisterBuiltinMacro("__MODULE__");
    } else {
        self.Ident__MODULE__ = null;
    }
}

fn isTrivialSingleTokenExpansion(MI: *MacroInfo, MacroIdent: *IdentifierInfo, PP: *mut Preprocessor) -> bool {
    let mut II: *mut IdentifierInfo = MI.getReplacementToken(0).getIdentifierInfo();
    if !II {
        return true;
    }
    if II.isOutOfDate() {
        PP.getExternalSource().updateOutOfDateIdentifier(*II);
    }
    if PP.getMacroInfo(II) {
        ExpansionMI;
    } else if ExpansionMI.isEnabled() && II != MacroIdent {
        return false;
    }
    if MI.isObjectLike() {
        return true;
    }
    return operator!(is_contained(MI()(), II));
}

fn Preprocessor::HandleMacroExpandedIdentifier(self, Identifier: *mut Token, M: *MacroDefinition) -> bool {
    self.emitMacroExpansionWarnings(Identifier, false);
    let mut MI: *mut MacroInfo = M.getMacroInfo();
    if self.CurPPLexer {
        self.CurPPLexer.MIOpt.ExpandedMacro();
    }
    if MI.isBuiltinMacro() {
        self.ExpandBuiltinMacro(Identifier);
        return true;
    }
    let mut Args: *mut MacroArgs = null;
    let mut ExpansionEnd: SourceLocation = Identifier.getLocation();
    if MI.isFunctionLike() {
        self.InMacroArgs = true;
        self.ArgMacro = &mut Identifier;
        Args = self.ReadMacroCallArgumentList(Identifier, MI, ExpansionEnd);
        self.InMacroArgs = false;
        self.ArgMacro = null;
        if !Args {
            return true;
        }
        self.NumFnMacroExpanded += 1;
    } else {
        self.NumMacroExpanded += 1;
    }
    self.markMacroAsUsed(MI);
    let mut ExpandLoc: SourceLocation = Identifier.getLocation();
    let mut ExpansionRange: SourceRange = SourceRange { B: ExpandLoc, E: ExpansionEnd };
    if  {
        if self.InMacroArgs {} else {
            if  {}
        }
    }
    if M.isAmbiguous() {
         << Identifier.getIdentifierInfo();
         << Identifier.getIdentifierInfo();
        M;
    }
    if MI.getNumTokens() == 0 {
        if Args {
            Args.destroy(*self);
        }
        Identifier.setFlag(LeadingEmptyMacro);
        self.PropagateLineStartLeadingSpaceInfo(Identifier);
        self.NumFastMacroExpanded += 1;
        return false;
    } else if MI.getNumTokens() == 1 && isTrivialSingleTokenExpansion(MI, Identifier.getIdentifierInfo(), *self) {
        if Args {
            Args.destroy(*self);
        }
        let mut isAtStartOfLine: bool = Identifier.isAtStartOfLine();
        let mut hasLeadingSpace: bool = Identifier.hasLeadingSpace();
        Identifier = MI.getReplacementToken(0);
        Identifier.setFlagValue(StartOfLine, isAtStartOfLine);
        Identifier.setFlagValue(LeadingSpace, hasLeadingSpace);
        let mut Loc: SourceLocation = self.SourceMgr.createExpansionLoc(Identifier.getLocation(), ExpandLoc, ExpansionEnd, Identifier.getLength(), true, 0, 0);
        Identifier.setLocation(Loc);
        if Identifier.getIdentifierInfo() {
            NewII;
        } else {
            if self.getMacroInfo(NewII) {
                NewMI;
            } else if !NewMI.isEnabled() || NewMI == MI {
                Identifier.setFlag(DisableExpand);
                if NewMI != MI || MI.isFunctionLike() {
                    
                }
            }
        }
        self.NumFastMacroExpanded += 1;
        return true;
    }
    self.EnterMacro(Identifier, ExpansionEnd, MI, Args);
    return false;
}

