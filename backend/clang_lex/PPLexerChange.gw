fn Preprocessor::isInPrimaryFile(self: *Preprocessor) -> bool {
    if self.IsFileLexer() {
        return self.IncludeMacroStack.is_empty();
    }
    assert!(IsFileLexer(self.IncludeMacroStack[0]), "Top level include stack isn't our primary lexer?");
    return none_of(drop_begin(self.IncludeMacroStack, 1), Closure_1 {});
}

fn Preprocessor::getCurrentFileLexer(self: *Preprocessor) -> *mut PreprocessorLexer {
    if self.IsFileLexer() {
        return self.CurPPLexer;
    }
    for ISI in reverse(self.IncludeMacroStack) {
        if IsFileLexer(ISI) {
            return ISI.ThePPLexer;
        }
    }
    return null;
}

fn Preprocessor::EnterSourceFile(self, FID: FileID, CurDir: ConstSearchDirIterator, Loc: SourceLocation, IsFirstIncludeOfFile: bool) -> bool {
    assert!(!self.CurTokenLexer, "Cannot #include a file inside a macro!");
    self.NumEnteredSourceFiles += 1;
    if self.MaxIncludeStackDepth < self.IncludeMacroStack.len {
        self.MaxIncludeStackDepth = self.IncludeMacroStack.len;
    }
    let mut InputFile: MemoryBufferRef> = self.getSourceManager().getBufferOrNone(FID, Loc);
    if !InputFile {
        let mut FileStart: SourceLocation = self.SourceMgr.getLocForStartOfFile(FID);
        self.Diag(Loc, err_pp_error_opening_file) << self.SourceMgr.getBufferName(FileStart, null)[0..allocator<char> {}] << "";
        return true;
    }
    if self.isCodeCompletionEnabled() && self.SourceMgr.getFileEntryForID(FID) == self.CodeCompletionFile {
        self.CodeCompletionFileLoc = self.SourceMgr.getLocForStartOfFile(FID);
        self.CodeCompletionLoc = self.CodeCompletionFileLoc.getLocWithOffset(self.CodeCompletionOffset);
    }
    let mut TheLexer: Lexer> = make_unique(FID, operator(InputFile), *self, IsFirstIncludeOfFile);
    if self.GetDependencyDirectives && FID != self.PredefinesFileID {
        if self.SourceMgr.getFileEntryRefForID(FID) {
            File;
        } else if (*self.GetDependencyDirectives).call(operator(File)) {
            MaybeDepDirectives;
        } else {
            operator(TheLexer).DepDirectives = operator(MaybeDepDirectives);
        }
    }
    self.EnterSourceFileWithLexer(move(TheLexer), CurDir);
    return false;
}

fn Preprocessor::EnterSourceFileWithLexer(self, TheLexer: unique_ptr<Lexer>, CurDir: ConstSearchDirIterator) {
    let mut PrevPPLexer: *mut PreprocessorLexer = self.CurPPLexer;
    if self.CurPPLexer || self.CurTokenLexer {
        self.PushIncludeMacroStack();
    }
    self.CurLexer = move(TheLexer);
    self.CurPPLexer = self.CurLexer.get();
    self.CurDirLookup = CurDir;
    self.CurLexerSubmodule = null;
    self.CurLexerCallback = if operator(self.CurLexer).isDependencyDirectivesLexer() { CLK_DependencyDirectivesLexer } else { CLK_Lexer };
    if self.Callbacks && !operator(self.CurLexer).Is_PragmaLexer {
        let mut FileType: CharacteristicKind = self.SourceMgr.getFileCharacteristic(operator(self.CurLexer).getFileLoc());
        let mut PrevFID: FileID = FileID {};
        let mut EnterLoc: SourceLocation = SourceLocation {};
        if PrevPPLexer {
            PrevFID = PrevPPLexer.getFileID();
            EnterLoc = PrevPPLexer.getSourceLocation();
        }
        operator(self.Callbacks).FileChanged(operator(self.CurLexer).getFileLoc(), EnterFile, FileType, PrevFID);
        operator(self.Callbacks).LexedFileChanged(operator(self.CurLexer).getFileID(), EnterFile, FileType, PrevFID, EnterLoc);
    }
}

fn Preprocessor::EnterMacro(self, Tok: *mut Token, ILEnd: SourceLocation, Macro: *mut MacroInfo, Args: *mut MacroArgs) {
    let mut TokLexer: unique_ptr<TokenLexer> = unique_ptr<TokenLexer> {};
    if self.NumCachedTokenLexers == 0 {
        TokLexer = make_unique(Tok, ILEnd, Macro, Args, *self);
    } else {
        TokLexer = move(self.TokenLexerCache[self.NumCachedTokenLexers -= 1]);
        operator(TokLexer).Init(Tok, ILEnd, Macro, Args);
    }
    self.PushIncludeMacroStack();
    self.CurDirLookup = null;
    self.CurTokenLexer = move(TokLexer);
    self.CurLexerCallback = CLK_TokenLexer;
}

fn Preprocessor::EnterTokenStream(self, Toks: *Token, NumToks: u32, DisableMacroExpansion: bool, OwnsTokens: bool, IsReinject: bool) {
    if self.InCachingLexMode() {
        if self.CachedLexPos < self.CachedTokens.len {
            assert!(IsReinject, "new tokens in the middle of cached stream");
            self.CachedTokens.insert(self.CachedTokens.begin() + self.CachedLexPos, Toks, Toks + NumToks);
            if OwnsTokens {
                Toks;
            }
            return;
        }
        self.ExitCachingLexMode();
        self.EnterTokenStream(Toks, NumToks, DisableMacroExpansion, OwnsTokens, IsReinject);
        self.EnterCachingLexMode();
        return;
    }
    let mut TokLexer: unique_ptr<TokenLexer> = unique_ptr<TokenLexer> {};
    if self.NumCachedTokenLexers == 0 {
        TokLexer = make_unique(Toks, NumToks, DisableMacroExpansion, OwnsTokens, IsReinject, *self);
    } else {
        TokLexer = move(self.TokenLexerCache[self.NumCachedTokenLexers -= 1]);
        operator(TokLexer).Init(Toks, NumToks, DisableMacroExpansion, OwnsTokens, IsReinject);
    }
    self.PushIncludeMacroStack();
    self.CurDirLookup = null;
    self.CurTokenLexer = move(TokLexer);
    self.CurLexerCallback = CLK_TokenLexer;
}

fn computeRelativePath(FM: *mut FileManager, Dir: *DirectoryEntry, File: FileEntryRef, Result: *mut str) {
    Result.clear();
    let mut FilePath: str = File.getDir().getName();
    let mut Path: str = FilePath;
    while !Path.is_empty() {
        if FM.getOptionalDirectoryRef(Path, true) {
            CurDir;
        } else {
            if operator(CurDir).operator const clang::DirectoryEntry *() == Dir {
                Result = FilePath[Path.len..Path.len + npos];
                append(Result, filename(File.getName(), native), "", "", "");
                return;
            }
        }
        Path = parent_path(Path, native);
    }
    Result = File.getName();
}

fn Preprocessor::PropagateLineStartLeadingSpaceInfo(self, Result: *mut Token) {
    if self.CurTokenLexer {
        operator(self.CurTokenLexer).PropagateLineStartLeadingSpaceInfo(Result);
        return;
    }
    if self.CurLexer {
        operator(self.CurLexer).PropagateLineStartLeadingSpaceInfo(Result);
        return;
    }
}

fn Preprocessor::getCurLexerEndPos(self) -> *u8 {
    let mut EndPos: *u8 = operator(self.CurLexer).BufferEnd;
    if EndPos != operator(self.CurLexer).BufferStart && (EndPos[-1] == 10 || EndPos[-1] == 13) {
        EndPos -= 1;
        if EndPos != operator(self.CurLexer).BufferStart && (EndPos[-1] == 10 || EndPos[-1] == 13) && EndPos[-1] != EndPos[0] {
            EndPos -= 1;
        }
    }
    return EndPos;
}

fn collectAllSubModulesWithUmbrellaHeader(Mod: *Module, SubMods: *SmallVectorImpl<const Module *>) {
    if Mod.getUmbrellaHeaderAsWritten() {
        SubMods.push(&mut Mod);
    }
    for M in Mod.submodules() {
        collectAllSubModulesWithUmbrellaHeader(*M, SubMods);
    }
}

fn Preprocessor::diagnoseMissingHeaderInUmbrellaDir(self, Mod: *Module) {
    let mut UmbrellaHeader: Header> = Mod.getUmbrellaHeaderAsWritten();
    assert!(UmbrellaHeader, "Module must use umbrella header");
    let mut File: *FileID = self.SourceMgr.translateFile(operator(UmbrellaHeader).Entry);
    let mut ExpectedHeadersLoc: SourceLocation = self.SourceMgr.getLocForEndOfFile(File);
    if self.getDiagnostics().isIgnored(warn_uncovered_module_header, ExpectedHeadersLoc) {
        return;
    }
    let mut ModMap: *mut ModuleMap = self.getHeaderSearchInfo().getModuleMap();
    let mut Dir: OptionalDirectoryEntryRef = Mod.getEffectiveUmbrellaDir();
    let mut FS: *mut FileSystem = self.FileMgr.getVirtualFileSystem();
    let mut EC: error_code = error_code {};
    for let mut Entry: recursive_directory_iterator = recursive_directory_iterator { FS, operator(Dir).getName(), EC };
let mut End: recursive_directory_iterator = recursive_directory_iterator {}; Entry != End && !EC; Entry.increment(EC) {
        if !extension(operator(Entry).path(), native).Cases([".h", ".H", ".hh", ".hpp"], true).Default(false) {
            continue;
        }
        if self.getFileManager().getOptionalFileRef(operator(Entry).path(), false, true, true) {
            Header;
        } else if !self.getSourceManager().hasFileInfo(operator(Header).operator const clang::FileEntry *()) {
            if !ModMap.isHeaderInUnavailableModule(operator(Header)) {
                let mut RelativePath: str = "";
                computeRelativePath(self.FileMgr, operator(Dir).operator const clang::DirectoryEntry *(), operator(Header), RelativePath);
                self.Diag(ExpectedHeadersLoc, warn_uncovered_module_header) << Mod.getFullModuleName(false) << RelativePath;
            }
        }
    }
}

fn Preprocessor::HandleEndOfFile(self, Result: *mut Token, isEndOfMacro: bool) -> bool {
    assert!(!self.CurTokenLexer, "Ending a file when currently in a macro!");
    let mut UnclosedSafeBufferOptOutLoc: SourceLocation = SourceLocation {};
    if self.IncludeMacroStack.is_empty() && self.isPPInSafeBufferOptOutRegion(UnclosedSafeBufferOptOutLoc) {
        self.Diag(UnclosedSafeBufferOptOutLoc, err_pp_unclosed_pragma_unsafe_buffer_usage);
    }
    let mut LeavingSubmodule: bool = self.CurLexer && self.CurLexerSubmodule;
    if (LeavingSubmodule || self.IncludeMacroStack.is_empty()) && !self.BuildingSubmoduleStack.is_empty() && self.BuildingSubmoduleStack.back().IsPragma {
        self.Diag(self.BuildingSubmoduleStack.back().ImportLoc, err_pp_module_begin_without_module_end);
        let mut M: *mut Module = self.LeaveSubmodule(true);
        Result.startToken();
        let mut EndPos: *u8 = self.getCurLexerEndPos();
        operator(self.CurLexer).BufferPtr = EndPos;
        operator(self.CurLexer).FormTokenWithChars(Result, EndPos, annot_module_end);
        Result.setAnnotationEndLoc(Result.getLocation());
        Result.setAnnotationValue(M);
        return true;
    }
    if self.CurPPLexer {
        if self.CurPPLexer.MIOpt.GetControllingMacroAtEndOfFile() {
            ControllingMacro;
        } else {
            if self.CurPPLexer.getFileEntry() {
                FE;
            } else {
                self.HeaderInfo.SetFileControllingMacro(operator(FE), ControllingMacro);
                if self.getMacroInfo(ControllingMacro) {
                    MI;
                } else {
                    MI.setUsedForHeaderGuard(true);
                }
                if self.CurPPLexer.MIOpt.GetDefinedMacro() {
                    DefinedMacro;
                } else {
                    if !self.isMacroDefined(ControllingMacro) && DefinedMacro != ControllingMacro && operator(self.CurLexer).isFirstTimeLexingFile() {
                        let mut ControllingMacroName: str = ControllingMacro.getName();
                        let mut DefinedMacroName: str = DefinedMacro.getName();
                        let mut MaxHalfLength: u64 = if ControllingMacroName.len > DefinedMacroName.len { ControllingMacroName.len } else { DefinedMacroName.len } / 2;
                        let mut ED: u32 = ControllingMacroName.edit_distance(DefinedMacroName, true, MaxHalfLength);
                        if ED <= MaxHalfLength {
                            self.Diag(self.CurPPLexer.MIOpt.GetMacroLocation(), warn_header_guard) << self.CurPPLexer.MIOpt.GetMacroLocation() << ControllingMacro;
                            self.Diag(self.CurPPLexer.MIOpt.GetDefinedLocation(), note_header_guard) << self.CurPPLexer.MIOpt.GetDefinedLocation() << DefinedMacro << ControllingMacro << CreateReplacement(self.CurPPLexer.MIOpt.GetDefinedLocation(), ControllingMacro.getName());
                        }
                    }
                }
            }
        }
    }
    if self.PragmaARCCFCodeAuditedInfo.getLoc().isValid() && !isEndOfMacro && !(self.CurLexer && operator(self.CurLexer).Is_PragmaLexer) {
        self.Diag(self.PragmaARCCFCodeAuditedInfo.getLoc(), err_pp_eof_in_arc_cf_code_audited);
        self.PragmaARCCFCodeAuditedInfo = IdentifierLoc {};
    }
    if self.PragmaAssumeNonNullLoc.isValid() && !isEndOfMacro && !(self.CurLexer && operator(self.CurLexer).Is_PragmaLexer) {
        if self.isRecordingPreamble() && self.isInPrimaryFile() {
            self.PreambleRecordedPragmaAssumeNonNullLoc = self.PragmaAssumeNonNullLoc;
        } else {
            self.Diag(self.PragmaAssumeNonNullLoc, err_pp_eof_in_assume_nonnull);
        }
        self.PragmaAssumeNonNullLoc = SourceLocation {};
    }
    let mut LeavingPCHThroughHeader: bool = false;
    if !self.IncludeMacroStack.is_empty() {
        if self.isCodeCompletionEnabled() && self.CurPPLexer && self.SourceMgr.getLocForStartOfFile(self.CurPPLexer.getFileID()) == self.CodeCompletionFileLoc {
            assert!(self.CurLexer, "Got EOF but no current lexer set!");
            Result.startToken();
            operator(self.CurLexer).FormTokenWithChars(Result, operator(self.CurLexer).BufferEnd, eof);
            self.PendingDestroyLexers.push(move(self.CurLexer));
            self.CurPPLexer = null;
            self.recomputeCurLexerKind();
            return true;
        }
        if !isEndOfMacro && self.CurPPLexer && (self.SourceMgr.getIncludeLoc(self.CurPPLexer.getFileID()).isValid() || (self.PredefinesFileID.isValid() && self.CurPPLexer.getFileID() == self.PredefinesFileID)) {
            let mut NumFIDs: u32 = self.SourceMgr.local_sloc_entry_size() - self.CurPPLexer.getInitialNumSLocEntries() + 1;
            self.SourceMgr.setNumCreatedFIDsForFileID(self.CurPPLexer.getFileID(), NumFIDs, false);
        }
        let mut ExitedFromPredefinesFile: bool = false;
        let mut ExitedFID: FileID = FileID {};
        if !isEndOfMacro && self.CurPPLexer {
            ExitedFID = self.CurPPLexer.getFileID();
            assert!(self.PredefinesFileID.isValid(), "HandleEndOfFile is called before PredefinesFileId is set");
            ExitedFromPredefinesFile = (self.PredefinesFileID == ExitedFID);
        }
        if LeavingSubmodule {
            let mut M: *mut Module = self.LeaveSubmodule(false);
            let mut EndPos: *u8 = self.getCurLexerEndPos();
            Result.startToken();
            operator(self.CurLexer).BufferPtr = EndPos;
            operator(self.CurLexer).FormTokenWithChars(Result, EndPos, annot_module_end);
            Result.setAnnotationEndLoc(Result.getLocation());
            Result.setAnnotationValue(M);
        }
        let mut FoundPCHThroughHeader: bool = false;
        if self.CurPPLexer && self.creatingPCHWithThroughHeader() && self.isPCHThroughHeader(self.SourceMgr.getFileEntryForID(self.CurPPLexer.getFileID())) {
            FoundPCHThroughHeader = true;
        }
        self.RemoveTopOfLexerStack();
        self.PropagateLineStartLeadingSpaceInfo(Result);
        if self.Callbacks && !isEndOfMacro && self.CurPPLexer {
            let mut Loc: SourceLocation = self.CurPPLexer.getSourceLocation();
            let mut FileType: CharacteristicKind = self.SourceMgr.getFileCharacteristic(Loc);
            operator(self.Callbacks).FileChanged(Loc, ExitFile, FileType, ExitedFID);
            operator(self.Callbacks).LexedFileChanged(self.CurPPLexer.getFileID(), ExitFile, FileType, ExitedFID, Loc);
        }
        if ExitedFromPredefinesFile {
            self.replayPreambleConditionalStack();
            if self.PreambleRecordedPragmaAssumeNonNullLoc.isValid() {
                self.PragmaAssumeNonNullLoc = self.PreambleRecordedPragmaAssumeNonNullLoc;
            }
        }
        if !isEndOfMacro && self.CurPPLexer && FoundPCHThroughHeader && (self.isInPrimaryFile() || self.CurPPLexer.getFileID() == self.getPredefinesFileID()) {
            LeavingPCHThroughHeader = true;
        } else {
            return LeavingSubmodule;
        }
    }
    assert!(self.CurLexer, "Got EOF but no current lexer set!");
    let mut EndPos: *u8 = self.getCurLexerEndPos();
    Result.startToken();
    operator(self.CurLexer).BufferPtr = EndPos;
    if self.getLangOpts().IncrementalExtensions {
        operator(self.CurLexer).FormTokenWithChars(Result, EndPos, annot_repl_input_end);
        Result.setAnnotationEndLoc(Result.getLocation());
        Result.setAnnotationValue(null);
    } else {
        operator(self.CurLexer).FormTokenWithChars(Result, EndPos, eof);
    }
    if self.isCodeCompletionEnabled() {
        if operator(self.CurLexer).getFileLoc() == self.CodeCompletionFileLoc {
            Result.setLocation(Result.getLocation().getLocWithOffset(-1));
        }
    }
    if self.creatingPCHWithThroughHeader() && !LeavingPCHThroughHeader {
        self.Diag(operator(self.CurLexer).getFileLoc(), err_pp_through_header_not_seen) << self.PPOpts.PCHThroughHeader << 0;
    }
    if !self.isIncrementalProcessingEnabled() {
        if self.LexLevel > 0 && self.CurLexer {
            self.PendingDestroyLexers.push(move(self.CurLexer));
        } else {
            self.CurLexer.reset(null);
        }
    }
    if !self.isIncrementalProcessingEnabled() {
        self.CurPPLexer = null;
    }
    if self.TUKind == TU_Complete {
        for let mut I: iterator = self.WarnUnusedMacroLocs.begin();
let mut E: iterator = self.WarnUnusedMacroLocs.end(); I != E; operator(I) {
            self.Diag(operator(I), pp_macro_not_used);
        }
    }
    if self.getCurrentModule() {
        Mod;
    } else {
        let mut AllMods: SmallVector<const Module *, 4> = SmallVector<const Module *, 4> {};
        collectAllSubModulesWithUmbrellaHeader(*Mod, AllMods);
        for M in AllMods {
            self.diagnoseMissingHeaderInUmbrellaDir(*M);
        }
    }
    return true;
}

fn Preprocessor::HandleEndOfTokenLexer(self, Result: *mut Token) -> bool {
    assert!(self.CurTokenLexer && !self.CurPPLexer, "Ending a macro when currently in a #include file!");
    if !self.MacroExpandingLexersStack.is_empty() && self.MacroExpandingLexersStack.back().first == self.CurTokenLexer.get() {
        self.removeCachedMacroExpandedTokensOfLastLexer();
    }
    if self.NumCachedTokenLexers == TokenLexerCacheSize {
        self.CurTokenLexer.reset(null);
    } else {
        self.TokenLexerCache[self.NumCachedTokenLexers += 1] = move(self.CurTokenLexer);
    }
    return self.HandleEndOfFile(Result, true);
}

fn Preprocessor::RemoveTopOfLexerStack(self) {
    assert!(!self.IncludeMacroStack.is_empty(), "Ran out of stack entries to load");
    if self.CurTokenLexer {
        if self.NumCachedTokenLexers == TokenLexerCacheSize {
            self.CurTokenLexer.reset(null);
        } else {
            self.TokenLexerCache[self.NumCachedTokenLexers += 1] = move(self.CurTokenLexer);
        }
    }
    self.PopIncludeMacroStack();
}

fn Preprocessor::HandleMicrosoftCommentPaste(self, Tok: *mut Token) {
    assert!(self.CurTokenLexer && !self.CurPPLexer, "Pasted comment can only be formed from macro");
    let mut FoundLexer: *mut PreprocessorLexer = null;
    let mut LexerWasInPPMode: bool = false;
    for ISI in reverse(self.IncludeMacroStack) {
        if ISI.ThePPLexer == null {
            continue;
        }
        FoundLexer = ISI.ThePPLexer;
        FoundLexer.LexingRawMode = true;
        LexerWasInPPMode = FoundLexer.ParsingPreprocessorDirective;
        FoundLexer.ParsingPreprocessorDirective = true;
        break;
    }
    if !self.HandleEndOfTokenLexer(Tok) {
        self.Lex(Tok);
    }
    while Tok.isNot(eod) && Tok.isNot(eof) {
        self.Lex(Tok);
    }
    if Tok.is(eod) {
        assert!(FoundLexer, "Can't get end of line without an active lexer");
        FoundLexer.LexingRawMode = false;
        if LexerWasInPPMode {
            return;
        }
        FoundLexer.ParsingPreprocessorDirective = false;
        return self.Lex(Tok);
    }
    assert!(!FoundLexer, "Lexer should return EOD before EOF in PP mode");
}

fn Preprocessor::EnterSubmodule(self, M: *mut Module, ImportLoc: SourceLocation, ForPragma: bool) {
    if !self.getLangOpts().ModulesLocalVisibility {
        self.BuildingSubmoduleStack.push(BuildingSubmoduleInfo { M, ImportLoc, ForPragma, self.CurSubmoduleState, self.PendingModuleMacroNames.len });
        if self.Callbacks {
            operator(self.Callbacks).EnteredSubmodule(M, ImportLoc, ForPragma);
        }
        return;
    }
    let mut ModMap: *mut ModuleMap = self.getHeaderSearchInfo().getModuleMap();
    ModMap.resolveExports(M, false);
    ModMap.resolveUses(M, false);
    ModMap.resolveConflicts(M, false);
    let mut R: pair<iterator, bool> = self.Submodules.try_emplace(M);
    let mut State: *mut SubmoduleState = operator(R.first).second;
    let mut FirstTime: bool = R.second;
    if FirstTime {
        let mut StartingMacros: *mut MacroMap = self.NullSubmoduleState.Macros;
        for Macro in StartingMacros {
            if !Macro.second.getLatest() && Macro.second.getOverriddenMacros().is_empty() {
                continue;
            }
            let mut MS: MacroState = Macro.second.getLatest();
            MS.setOverriddenMacros(*self, Macro.second.getOverriddenMacros());
            State.Macros.insert(make_pair(Macro.first, move(MS)));
        }
    }
    self.BuildingSubmoduleStack.push(BuildingSubmoduleInfo { M, ImportLoc, ForPragma, self.CurSubmoduleState, self.PendingModuleMacroNames.len });
    if self.Callbacks {
        operator(self.Callbacks).EnteredSubmodule(M, ImportLoc, ForPragma);
    }
    self.CurSubmoduleState = &mut State;
    if FirstTime {
        self.makeModuleVisible(M, ImportLoc, false);
    }
}

fn Preprocessor::needModuleMacros(self: *Preprocessor) -> bool {
    if self.BuildingSubmoduleStack.is_empty() {
        return false;
    }
    if self.getLangOpts().ModulesLocalVisibility {
        return true;
    }
    return self.getLangOpts().isCompilingModule();
}

fn Preprocessor::LeaveSubmodule(self, ForPragma: bool) -> *mut Module {
    if self.BuildingSubmoduleStack.is_empty() || self.BuildingSubmoduleStack.back().IsPragma != ForPragma {
        assert!(ForPragma, "non-pragma module enter/leave mismatch");
        return null;
    }
    let mut Info: *mut BuildingSubmoduleInfo = self.BuildingSubmoduleStack.back();
    let mut LeavingMod: *mut Module = Info.M;
    let mut ImportLoc: SourceLocation = Info.ImportLoc;
    if !self.needModuleMacros() || (!self.getLangOpts().ModulesLocalVisibility && LeavingMod.getTopLevelModuleName() != self.getLangOpts().CurrentModule) {
        self.BuildingSubmoduleStack.pop();
        if self.Callbacks {
            operator(self.Callbacks).LeftSubmodule(LeavingMod, ImportLoc, ForPragma);
        }
        self.makeModuleVisible(LeavingMod, ImportLoc, true);
        return LeavingMod;
    }
    let mut VisitedMacros: SmallPtrSet<const IdentifierInfo *, 8> = SmallPtrSet<const IdentifierInfo *, 8> {};
    for let mut I: u32 = Info.OuterPendingModuleMacroNames; I != self.PendingModuleMacroNames.len; I += 1 {
        let mut II: *mut IdentifierInfo = self.PendingModuleMacroNames[I];
        if !VisitedMacros.insert(II).second {
            continue;
        }
        let mut MacroIt: iterator = self.CurSubmoduleState.Macros.find(II);
        if MacroIt == self.CurSubmoduleState.Macros.end() {
            continue;
        }
        let mut Macro: *mut MacroState = operator(MacroIt).second;
        let mut OldMD: *mut MacroDirective = null;
        let mut OldState: *mut SubmoduleState = Info.OuterSubmoduleState;
        if self.getLangOpts().ModulesLocalVisibility {
            OldState = &mut self.NullSubmoduleState;
        }
        if OldState && OldState != self.CurSubmoduleState {
            let mut OldMacros: *mut MacroMap = OldState.Macros;
            let mut OldMacroIt: iterator = OldMacros.find(II);
            if OldMacroIt == OldMacros.end() {
                OldMD = null;
            } else {
                OldMD = operator(OldMacroIt).second.getLatest();
            }
        }
        let mut ExplicitlyPublic: bool = false;
        for let mut MD: *mut MacroDirective = Macro.getLatest(); MD != OldMD; MD = MD.getPrevious() {
            assert!(MD, "broken macro directive chain");
            if dyn_cast(MD) {
                VisMD;
            } else {
                if VisMD.isPublic() {
                    ExplicitlyPublic = true;
                } else if !ExplicitlyPublic {
                    break;
                }
            }
        }
    }
    self.PendingModuleMacroNames.resize(Info.OuterPendingModuleMacroNames);
    if self.getLangOpts().ModulesLocalVisibility {
        self.CurSubmoduleState = Info.OuterSubmoduleState;
    }
    self.BuildingSubmoduleStack.pop();
    if self.Callbacks {
        operator(self.Callbacks).LeftSubmodule(LeavingMod, ImportLoc, ForPragma);
    }
    self.makeModuleVisible(LeavingMod, ImportLoc, true);
    return LeavingMod;
}

