struct PPValue {
    Range: SourceRange,
    II: *mut IdentifierInfo,
    Val: APSInt,
}

fn PPValue::getIdentifier(self: *PPValue) -> *mut IdentifierInfo {
    return self.II;
}

fn PPValue::setIdentifier(self, II: *mut IdentifierInfo) {
    self.II = II;
}

fn PPValue::getBitWidth(self: *PPValue) -> u32 {
    return self.Val.getBitWidth();
}

fn PPValue::isUnsigned(self: *PPValue) -> bool {
    return self.Val.isUnsigned();
}

fn PPValue::getRange(self: *PPValue) -> SourceRange {
    return self.Range;
}

fn PPValue::setRange(self, L: SourceLocation) {
    self.Range.setBegin(L);
    self.Range.setEnd(L);
}

fn PPValue::setRange(self, B: SourceLocation, E: SourceLocation) {
    self.Range.setBegin(B);
    self.Range.setEnd(E);
}

fn PPValue::setBegin(self, L: SourceLocation) {
    self.Range.setBegin(L);
}

fn PPValue::setEnd(self, L: SourceLocation) {
    self.Range.setEnd(L);
}

struct DefinedTracker {
    State: TrackerState,
    TheMacro: *mut IdentifierInfo,
    IncludedUndefinedIds: bool,
}

fn EvaluateDefined(Result: *mut PPValue, PeekTok: *mut Token, DT: *mut DefinedTracker, ValueLive: bool, PP: *mut Preprocessor) -> bool {
    let mut beginLoc: SourceLocation = PeekTok.getLocation();
    Result.setBegin(beginLoc);
    PP.LexUnexpandedNonComment(PeekTok);
    let mut LParenLoc: SourceLocation = SourceLocation {};
    if PeekTok.is(l_paren) {
        LParenLoc = PeekTok.getLocation();
        PP.LexUnexpandedNonComment(PeekTok);
    }
    if PeekTok.is(code_completion) {
        if PP.getCodeCompletionHandler() {
            PP.getCodeCompletionHandler().CodeCompleteMacroName(false);
        }
        PP.setCodeCompletionReached();
        PP.LexUnexpandedNonComment(PeekTok);
    }
    if PP.CheckMacroName(PeekTok, MU_Other, null) {
        return true;
    }
    let mut II: *mut IdentifierInfo = PeekTok.getIdentifierInfo();
    let mut Macro: MacroDefinition = PP.getMacroDefinition(II);
    Result.Val = !!Macro;
    Result.Val.setIsUnsigned(false);
    DT.IncludedUndefinedIds = !Macro;
    PP.emitMacroExpansionWarnings(PeekTok, if (II.getName() == "INFINITY" || II.getName() == "NAN") { true } else { false });
    if Result.Val != 0 && ValueLive {
        PP.markMacroAsUsed(Macro.getMacroInfo());
    }
    let mut macroToken: Token = PeekTok;
    if LParenLoc.isValid() {
        Result.setEnd(PeekTok.getLocation());
        PP.LexUnexpandedNonComment(PeekTok);
        if PeekTok.isNot(r_paren) {
            PP << "'defined'" << r_paren;
            PP << l_paren;
            return true;
        }
        PP.LexNonComment(PeekTok);
        Result.setEnd(PeekTok.getLocation());
    } else {
        Result.setEnd(PeekTok.getLocation());
        PP.LexNonComment(PeekTok);
    }
    if beginLoc.isMacroID() {
        let mut IsFunctionTypeMacro: bool = PP.getSourceManager().getSLocEntry(PP.getSourceManager().getFileID(beginLoc), null).getExpansion().isFunctionMacroExpansion();
        if IsFunctionTypeMacro {
            PP;
        } else {
            PP;
        }
    }
    if PP.getPPCallbacks() {
        Callbacks;
    } else {
        Callbacks.Defined(macroToken, Macro, SourceRange { B: beginLoc, E: PeekTok.getLocation() });
    }
    DT.State = DefinedMacro;
    DT.TheMacro = II;
    return false;
}

fn EvaluateValue(Result: *mut PPValue, PeekTok: *mut Token, DT: *mut DefinedTracker, ValueLive: bool, PP: *mut Preprocessor) -> bool {
    DT.State = Unknown;
    Result.setIdentifier(null);
    if PeekTok.is(code_completion) {
        if PP.getCodeCompletionHandler() {
            PP.getCodeCompletionHandler().CodeCompletePreprocessorExpression();
        }
        PP.setCodeCompletionReached();
        PP.LexNonComment(PeekTok);
    }
    match PeekTok.getKind() {
        _ => {
            if PeekTok.getIdentifierInfo() {
                II;
            } else {
                if II.isStr("defined") {
                    return EvaluateDefined(Result, PeekTok, DT, ValueLive, PP);
                }
                if !II.isCPlusPlusOperatorKeyword() {
                    if ValueLive {
                        let mut DiagID: u32 = 0;
                        PP.Diag(PeekTok, DiagID) << II;
                        let mut DiagEngine: *DiagnosticsEngine = PP.getDiagnostics();
                        if DiagEngine.isIgnored(DiagID, PeekTok.getLocation()) {
                            let mut UndefPrefixes: i32 = DiagEngine.getDiagnosticOptions();
                            let mut IdentifierName: str = II.getName();
                            if any_of(Closure_1 { IdentifierName: &mut IdentifierName }) {
                                PP << void { join(",") } << II;
                            }
                        }
                    }
                    Result.Val = 0;
                    Result.Val.setIsUnsigned(false);
                    Result.setIdentifier(II);
                    Result.setRange(PeekTok.getLocation());
                    DT.IncludedUndefinedIds = true;
                    PP.LexNonComment(PeekTok);
                    return false;
                }
            }
        },
        eod => {
            r_paren;
        },
        numeric_constant => {
            let mut IntegerBuffer: str = zeroed();
            let mut NumberInvalid: bool = false;
            let mut Spelling: str = PP(PeekTok, &mut NumberInvalid);
            if NumberInvalid {
                return true;
            }
            let mut Literal: NumericLiteralParser = NumericLiteralParser { Spelling, PeekTok.getLocation(), PP.getSourceManager(), PP.getLangOpts(), PP.getTargetInfo(), PP.getDiagnostics() };
            if Literal.hadError {
                return true;
            }
            if Literal.isFloatingLiteral() || Literal.isImaginary {
                PP;
                return true;
            }
            assert!(Literal.isIntegerLiteral(), "Unknown ppnumber");
            if Literal.hasUDSuffix() {
                PP << 1;
            }
            if operator!(PP.getLangOpts()) && Literal.isLongLong {
                if PP.getLangOpts() {
                    PP;
                } else {
                    PP;
                }
            }
            if Literal.isSizeT {
                if PP.getLangOpts() {
                    PP;
                } else {
                    PP;
                }
            }
            if Literal.isBitInt {
                PP;
            }
            if Literal.GetIntegerValue(Result.Val) {
                PP << 1;
                Result.Val.setIsUnsigned(true);
            } else {
                Result.Val.setIsUnsigned(Literal.isUnsigned);
                if !Literal.isUnsigned && Result.Val.isNegative() {
                    if ValueLive && Literal.getRadix() == 10 {
                        PP;
                    }
                    Result.Val.setIsUnsigned(true);
                }
            }
            Result.setRange(PeekTok.getLocation());
            PP.LexNonComment(PeekTok);
            return false;
        },
        char_constant => {
            wide_char_constant;
        },
        l_paren => {
            let mut Start: SourceLocation = PeekTok.getLocation();
            PP.LexNonComment(PeekTok);
            if EvaluateValue(Result, PeekTok, DT, ValueLive, PP) {
                return true;
            }
            if PeekTok.is(r_paren) {} else {
                if EvaluateDirectiveSubExpr(Result, 1, PeekTok, ValueLive, DT.IncludedUndefinedIds, PP) {
                    return true;
                }
                if PeekTok.isNot(r_paren) {
                    PP << Result.getRange();
                    PP << l_paren;
                    return true;
                }
                DT.State = Unknown;
            }
            Result.setRange(Start, PeekTok.getLocation());
            Result.setIdentifier(null);
            PP.LexNonComment(PeekTok);
            return false;
        },
        plus => {
            let mut Start: SourceLocation = PeekTok.getLocation();
            PP.LexNonComment(PeekTok);
            if EvaluateValue(Result, PeekTok, DT, ValueLive, PP) {
                return true;
            }
            Result.setBegin(Start);
            Result.setIdentifier(null);
            return false;
        },
        minus => {
            let mut Loc: SourceLocation = PeekTok.getLocation();
            PP.LexNonComment(PeekTok);
            if EvaluateValue(Result, PeekTok, DT, ValueLive, PP) {
                return true;
            }
            Result.setBegin(Loc);
            Result.setIdentifier(null);
            Result.Val = operator(Result.Val);
            let mut Overflow: bool = !Result.isUnsigned() && Result.Val.isMinSignedValue();
            if Overflow && ValueLive {
                PP << Result.getRange();
            }
            DT.State = Unknown;
            return false;
        },
        tilde => {
            let mut Start: SourceLocation = PeekTok.getLocation();
            PP.LexNonComment(PeekTok);
            if EvaluateValue(Result, PeekTok, DT, ValueLive, PP) {
                return true;
            }
            Result.setBegin(Start);
            Result.setIdentifier(null);
            Result.Val = operator(Result.Val);
            DT.State = Unknown;
            return false;
        },
        exclaim => {
            let mut Start: SourceLocation = PeekTok.getLocation();
            PP.LexNonComment(PeekTok);
            if EvaluateValue(Result, PeekTok, DT, ValueLive, PP) {
                return true;
            }
            Result.setBegin(Start);
            Result.Val = operator(Result.Val);
            Result.Val.setIsUnsigned(false);
            Result.setIdentifier(null);
            if DT.State == DefinedMacro {
                DT.State = NotDefinedMacro;
            } else if DT.State == NotDefinedMacro {
                DT.State = DefinedMacro;
            }
            return false;
        },
        kw_true => {
            kw_false;
        },
    }
}

fn getPrecedence(Kind: TokenKind) -> u32 {
    match Kind {
        _ => {
            return ~0;
        },
        percent => {
            slash;
        },
        plus => {
            minus;
        },
        lessless => {
            greatergreater;
        },
        lessequal => {
            less;
        },
        exclaimequal => {
            equalequal;
        },
        amp => {
            return 9;
        },
        caret => {
            return 8;
        },
        pipe => {
            return 7;
        },
        ampamp => {
            return 6;
        },
        pipepipe => {
            return 5;
        },
        question => {
            return 4;
        },
        comma => {
            return 3;
        },
        colon => {
            return 2;
        },
        r_paren => {
            return 0;
        },
        eod => {
            return 0;
        },
    }
}

fn diagnoseUnexpectedOperator(PP: *mut Preprocessor, LHS: *mut PPValue, Tok: *mut Token) {
    if Tok.is(l_paren) && LHS.getIdentifier() {
        PP << LHS.getIdentifier();
    } else {
        PP << LHS.getRange();
    }
}

fn EvaluateDirectiveSubExpr(LHS: *mut PPValue, MinPrec: u32, PeekTok: *mut Token, ValueLive: bool, IncludedUndefinedIds: *mut bool, PP: *mut Preprocessor) -> bool {
    if (PP.getPreprocessorOpts().SingleFileParseMode || PP.getPreprocessorOpts().SingleModuleParseMode) && IncludedUndefinedIds {
        PP.DiscardUntilEndOfDirective(PeekTok, null);
        return true;
    }
    let mut PeekPrec: u32 = getPrecedence(PeekTok.getKind());
    if PeekPrec == ~0 {
        diagnoseUnexpectedOperator(PP, LHS, PeekTok);
        return true;
    }
    while true {
        if PeekPrec < MinPrec {
            return false;
        }
        let mut Operator: TokenKind = PeekTok.getKind();
        let mut RHSIsLive: bool = false;
        if Operator == ampamp && LHS.Val == 0 {
            RHSIsLive = false;
        } else if Operator == pipepipe && LHS.Val != 0 {
            RHSIsLive = false;
        } else if Operator == question && LHS.Val == 0 {
            RHSIsLive = false;
        } else {
            RHSIsLive = ValueLive;
        }
        let mut OpLoc: SourceLocation = PeekTok.getLocation();
        PP.LexNonComment(PeekTok);
        let mut RHS: PPValue = LHS.getBitWidth();
        let mut DT: DefinedTracker = DefinedTracker {};
        if EvaluateValue(RHS, PeekTok, DT, RHSIsLive, PP) {
            return true;
        }
        IncludedUndefinedIds = DT.IncludedUndefinedIds;
        let mut ThisPrec: u32 = PeekPrec;
        PeekPrec = getPrecedence(PeekTok.getKind());
        if PeekPrec == ~0 {
            diagnoseUnexpectedOperator(PP, RHS, PeekTok);
            return true;
        }
        let mut RHSPrec: u32 = 0;
        if Operator == question {
            RHSPrec = getPrecedence(comma);
        } else {
            RHSPrec = ThisPrec + 1;
        }
        if PeekPrec >= RHSPrec {
            if EvaluateDirectiveSubExpr(RHS, RHSPrec, PeekTok, RHSIsLive, IncludedUndefinedIds, PP) {
                return true;
            }
            PeekPrec = getPrecedence(PeekTok.getKind());
        }
        assert!(PeekPrec <= ThisPrec, "Recursion didn't work!");
        let mut Res: APSInt = APSInt { LHS.getBitWidth(), true };
        match Operator {
            question => {
                lessless;
            },
            _ => {
                Res.setIsUnsigned(LHS.isUnsigned() || RHS.isUnsigned());
            },
        }
        let mut Overflow: bool = false;
        match Operator {
            _ => {
                llvm_unreachable_internal("Unknown operator token!", "clang\\lib\\Lex\\PPExpressions.cpp", 717);
            },
            percent => {
                if RHS.Val != 0 {
                    Res = LHS.Val % RHS.Val;
                } else if ValueLive {
                    PP << LHS.getRange() << RHS.getRange();
                    return true;
                }
            },
            slash => {
                if RHS.Val != 0 {
                    if LHS.Val.isSigned() {
                        Res = APSInt { LHS.Val.sdiv_ov(RHS.Val, Overflow), false };
                    } else {
                        Res = LHS.Val / RHS.Val;
                    }
                } else if ValueLive {
                    PP << LHS.getRange() << RHS.getRange();
                    return true;
                }
            },
            star => {
                if Res.isSigned() {
                    Res = APSInt { LHS.Val.smul_ov(RHS.Val, Overflow), false };
                } else {
                    Res = LHS.Val * RHS.Val;
                }
            },
            lessless => {
                if LHS.isUnsigned() {
                    Res = LHS.Val.ushl_ov(RHS.Val, Overflow);
                } else {
                    Res = APSInt { LHS.Val.sshl_ov(RHS.Val, Overflow), false };
                }
                break;
            },
            greatergreater => {
                let mut ShAmt: u32 = RHS.Val.getLimitedValue(18446744073709551615) as u32;
                if ShAmt >= LHS.getBitWidth() {
                    Overflow = true;
                    ShAmt = LHS.getBitWidth() - 1;
                }
                Res = LHS.Val >> ShAmt;
                break;
            },
            plus => {
                if LHS.isUnsigned() {
                    Res = LHS.Val + RHS.Val;
                } else {
                    Res = APSInt { LHS.Val.sadd_ov(RHS.Val, Overflow), false };
                }
            },
            minus => {
                if LHS.isUnsigned() {
                    Res = LHS.Val - RHS.Val;
                } else {
                    Res = APSInt { LHS.Val.ssub_ov(RHS.Val, Overflow), false };
                }
            },
            lessequal => {
                Res = LHS.Val <= RHS.Val;
            },
            less => {
                Res = LHS.Val < RHS.Val;
            },
            greaterequal => {
                Res = LHS.Val >= RHS.Val;
            },
            greater => {
                Res = LHS.Val > RHS.Val;
            },
            exclaimequal => {
                Res = LHS.Val != RHS.Val;
            },
            equalequal => {
                Res = LHS.Val == RHS.Val;
            },
            amp => {
                Res = LHS.Val & RHS.Val;
            },
            caret => {
                Res = LHS.Val ^ RHS.Val;
            },
            pipe => {
                Res = LHS.Val | RHS.Val;
            },
            ampamp => {
                Res = (LHS.Val != 0 && RHS.Val != 0);
            },
            pipepipe => {
                Res = (LHS.Val != 0 || RHS.Val != 0);
            },
            comma => {
                if operator!(PP.getLangOpts()) || ValueLive {
                    PP << LHS.getRange() << RHS.getRange();
                }
            },
            question => {
                if PeekTok.isNot(colon) {
                    PP << colon << LHS.getRange() << RHS.getRange();
                    PP << question;
                    return true;
                }
                PP.LexNonComment(PeekTok);
                let mut AfterColonLive: bool = ValueLive && LHS.Val == 0;
                let mut AfterColonVal: PPValue = LHS.getBitWidth();
                let mut DT: DefinedTracker = DefinedTracker {};
                if EvaluateValue(AfterColonVal, PeekTok, DT, AfterColonLive, PP) {
                    return true;
                }
                if EvaluateDirectiveSubExpr(AfterColonVal, ThisPrec, PeekTok, AfterColonLive, IncludedUndefinedIds, PP) {
                    return true;
                }
                Res = if LHS.Val != 0 { RHS.Val } else { AfterColonVal.Val };
                RHS.setEnd(AfterColonVal.getRange().getEnd());
                Res.setIsUnsigned(RHS.isUnsigned() || AfterColonVal.isUnsigned());
                PeekPrec = getPrecedence(PeekTok.getKind());
                break;
            },
            colon => {
                PP << LHS.getRange() << RHS.getRange();
            },
        }
        if Overflow && ValueLive {
            PP << LHS.getRange() << RHS.getRange();
        }
        LHS.Val = Res;
        LHS.setEnd(RHS.getRange().getEnd());
        RHS.setIdentifier(null);
    }
}

fn Preprocessor::EvaluateDirectiveExpression(self, IfNDefMacro: *mut *mut IdentifierInfo, Tok: *mut Token, EvaluatedDefined: *mut bool, CheckForEoD: bool) -> DirectiveEvalResult {
    let mut PPDir: SaveAndRestore = self.ParsingIfOrElifDirective;
    let mut DisableMacroExpansionAtStartOfDirective: bool = self.DisableMacroExpansion;
    self.DisableMacroExpansion = false;
    self.LexNonComment(Tok);
    let mut BitWidth: u32 = self.getTargetInfo().getIntMaxTWidth();
    let mut ResVal: PPValue = BitWidth;
    let mut DT: DefinedTracker = DefinedTracker {};
    let mut ExprStartLoc: SourceLocation = self.SourceMgr.getExpansionLoc(Tok.getLocation());
    if EvaluateValue(ResVal, Tok, DT, true, *self) {
        if Tok.isNot(eod) {
            self.DiscardUntilEndOfDirective(Tok, null);
        }
        self.DisableMacroExpansion = DisableMacroExpansionAtStartOfDirective;
        return DirectiveEvalResult { nullopt, false, DT.IncludedUndefinedIds, void { ExprStartLoc, Tok.getLocation() } };
    }
    EvaluatedDefined = DT.State != Unknown;
    if Tok.is(eod) {
        if DT.State == NotDefinedMacro {
            IfNDefMacro = DT.TheMacro;
        }
        self.DisableMacroExpansion = DisableMacroExpansionAtStartOfDirective;
        let mut IsNonZero: bool = ResVal.Val != 0;
        let mut ValRange: SourceRange = ResVal.getRange();
        return void { move(ResVal.Val), IsNonZero, DT.IncludedUndefinedIds, ValRange };
    }
    if EvaluateDirectiveSubExpr(ResVal, getPrecedence(question), Tok, true, DT.IncludedUndefinedIds, *self) {
        if Tok.isNot(eod) {
            self.DiscardUntilEndOfDirective(Tok, null);
        }
        self.DisableMacroExpansion = DisableMacroExpansionAtStartOfDirective;
        return DirectiveEvalResult { nullopt, false, DT.IncludedUndefinedIds, void { ExprStartLoc, Tok.getLocation() } };
    }
    if CheckForEoD {
        if Tok.isNot(eod) {
            self.DiscardUntilEndOfDirective(Tok, null);
        }
    }
    EvaluatedDefined = EvaluatedDefined || DT.State != Unknown;
    self.DisableMacroExpansion = DisableMacroExpansionAtStartOfDirective;
    let mut IsNonZero: bool = ResVal.Val != 0;
    let mut ValRange: SourceRange = ResVal.getRange();
    return void { move(ResVal.Val), IsNonZero, DT.IncludedUndefinedIds, ValRange };
}

fn Preprocessor::EvaluateDirectiveExpression(self, IfNDefMacro: *mut *mut IdentifierInfo, CheckForEoD: bool) -> DirectiveEvalResult {
    let mut Tok: Token = Token {};
    let mut EvaluatedDefined: bool = false;
    return self.EvaluateDirectiveExpression(IfNDefMacro, Tok, EvaluatedDefined, CheckForEoD);
}

fn getCXXStandardLibraryVersion(PP: *mut Preprocessor, MacroName: *mut IdentifierInfo, Lib: Library) -> optional<CXXStandardLibraryVersionInfo> {
    let mut Macro: *mut MacroInfo = PP.getMacroInfo(MacroName);
    if !Macro || Macro.getNumTokens() != 1 || !Macro.isObjectLike() {
        return nullopt();
    }
    let mut RevisionDateTok: *Token = Macro.getReplacementToken(0);
    let mut Invalid: bool = false;
    let mut Buffer: SmallVector<char, 10> = zeroed();
    let mut RevisionDate: str = PP(RevisionDateTok, &mut Invalid);
    if !Invalid {
        let mut Value: uint64_t = zeroed();
        if !RevisionDate {
            return CXXStandardLibraryVersionInfo { Lib: Lib, Version: Value };
        }
    }
    return CXXStandardLibraryVersionInfo { Lib: Unknown, Version: 0 };
}

fn Preprocessor::getStdLibCxxVersion(self) -> optional<uint64_t> {
    if  {
        return nullopt();
    }
    return nullopt();
}

fn Preprocessor::setStdLibCxxVersion(self, Version: uint64_t) {}

fn Preprocessor::NeedsStdLibCxxWorkaroundBefore(self, FixedVersion: u64) -> bool {
    assert!(FixedVersion >= 20000000 && FixedVersion <= 21000000, "invalid value for __GLIBCXX__");
    let mut Ver: uint64_t> = zeroed();
    if operator!() {
        return false;
    }
    return * < FixedVersion;
}

struct Closure_1 {
    IdentifierName: *mut str,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Prefix: str) -> bool {
                                return (*self.IdentifierName).starts_with(Prefix);
                            }
