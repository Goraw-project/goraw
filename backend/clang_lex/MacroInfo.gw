fn MacroInfo::getDefinitionLengthSlow(self: *MacroInfo, SM: *SourceManager) -> u32 {
    assert!(!self.IsDefinitionLengthCached);
    self.IsDefinitionLengthCached = true;
    let mut ReplacementTokens: ArrayRef<Token> = zeroed();
    if ReplacementTokens()() {
        return (self.DefinitionLength = 0);
    }
    let mut firstToken: *Token = ();
    let mut lastToken: *Token = ();
    let mut macroStart: SourceLocation = firstToken.getLocation();
    let mut macroEnd: SourceLocation = lastToken.getLocation();
    assert!(macroStart.isValid() && macroEnd.isValid();
    assert!((macroStart.isFileID() || firstToken.is(comment)), "Macro defined in macro?");
    assert!((macroEnd.isFileID() || lastToken.is(comment)), "Macro defined in macro?");
    let mut startInfo: FileIDAndOffset = zeroed();
    let mut endInfo: FileIDAndOffset = zeroed();
    assert!(startInfo() ==, "Macro definition spanning multiple FileIDs ?");
    assert!(startInfo() <=);
    self.DefinitionLength =  - ;
    self.DefinitionLength += lastToken.getLength();
    return self.DefinitionLength;
}

fn MacroInfo::isIdenticalTo(self: *MacroInfo, Other: *MacroInfo, PP: *mut Preprocessor, Syntactically: bool) -> bool {
    let mut Lexically: bool = !Syntactically;
    if self.getNumTokens() != Other.getNumTokens() || self.getNumParams() != Other.getNumParams() || self.isFunctionLike() != Other.isFunctionLike() || self.isC99Varargs() != Other.isC99Varargs() || self.isGNUVarargs() != Other.isGNUVarargs() {
        return false;
    }
    if Lexically {
        for let mut I: param_iterator = self.param_begin();
let mut OI: param_iterator = Other.param_begin();
let mut E: param_iterator = self.param_end(); I != E; I += 1 , OI += 1 {
            if *I != *OI {
                return false;
            }
        }
    }
    for let mut i: u32 = 0; i != self.NumReplacementTokens; i += 1 {
        let mut A: *Token = self.ReplacementTokens[i];
        let mut B: *Token = Other.ReplacementTokens[i];
        if A.getKind() != B.getKind() {
            return false;
        }
        if i != 0 && (A.isAtStartOfLine() != B.isAtStartOfLine() || A.hasLeadingSpace() != B.hasLeadingSpace()) {
            return false;
        }
        if A.getIdentifierInfo() || B.getIdentifierInfo() {
            if A.getIdentifierInfo() == B.getIdentifierInfo() {
                continue;
            }
            if Lexically {
                return false;
            }
            let mut AArgNum: i32 = self.getParameterNum(A.getIdentifierInfo());
            if AArgNum == -1 {
                return false;
            }
            if AArgNum != Other.getParameterNum(B.getIdentifierInfo()) {
                return false;
            }
            continue;
        }
        if PP.getSpelling(A, null) {
            return false;
        }
    }
    return true;
}

fn MacroInfo::dump(self: *MacroInfo) {
    let mut Out: *mut raw_ostream = errs();
    Out << "MacroInfo " << self;
    if self.IsBuiltinMacro {
        Out << " builtin";
    }
    if self.IsDisabled {
        Out << " disabled";
    }
    if self.IsUsed {
        Out << " used";
    }
    if self.IsAllowRedefinitionsWithoutWarning {
        Out << " allow_redefinitions_without_warning";
    }
    if self.IsWarnIfUnused {
        Out << " warn_if_unused";
    }
    if self.UsedForHeaderGuard {
        Out << " header_guard";
    }
    Out << "\n    #define <macro>";
    if self.IsFunctionLike {
        Out << "(";
        for let mut I: u32 = 0; I != self.NumParameters; I += 1 {
            if I {
                Out << ", ";
            }
            Out << self.ParameterList[I].getName();
        }
        if self.IsC99Varargs || self.IsGNUVarargs {
            if self.NumParameters && self.IsC99Varargs {
                Out << ", ";
            }
            Out << "...";
        }
        Out << ")";
    }
    let mut First: bool = true;
}

fn MacroDirective::getDefinition(self) -> DefInfo {
    let mut MD: *mut MacroDirective = self;
    let mut UndefLoc: SourceLocation = SourceLocation {};
    let mut isPublic: optional<bool> = zeroed();
    for ; MD; MD = MD.getPrevious() {
        if dyn_cast(MD) {
            DefMD;
        } else {
            return DefMD;
        }
        if dyn_cast(MD) {
            UndefMD;
        } else {
            UndefLoc = UndefMD.getLocation();
            continue;
        }
        let mut VisMD: *mut VisibilityMacroDirective = cast(MD);
        if ! {
            isPublic() = VisMD.isPublic();
        }
    }
    return null;
}

fn MacroDirective::findDirectiveAtLoc(self: *MacroDirective, L: SourceLocation, SM: *SourceManager) -> DefInfo {
    assert!(L.isValid(), "SourceLocation is invalid.");
    for let mut Def: DefInfo = self.getDefinition(); Def; Def = Def.getPreviousDefinition() {
        if Def.getLocation().isInvalid() || SM.isBeforeInTranslationUnit(Def.getLocation(), L) {
            return if (!Def.isUndefined() || SM.isBeforeInTranslationUnit(L, Def.getUndefLocation())) { Def } else { DefInfo {} };
        }
    }
    return DefInfo {};
}

fn MacroDirective::dump(self: *MacroDirective) {
    let mut Out: *mut raw_ostream = errs();
    match self.getKind() {
        MD_Define => {
            Out << "DefMacroDirective";
        },
        MD_Undefine => {
            Out << "UndefMacroDirective";
        },
        MD_Visibility => {
            Out << "VisibilityMacroDirective";
        },
    }
    Out << " " << self;
    if self.getPrevious() {
        Prev;
    } else {
        Out << " prev " << Prev;
    }
    if self.IsFromPCH {
        Out << " from_pch";
    }
    if isa(self) {
        Out << (if self.IsPublic { " public" } else { " private" });
    }
    if  {
        if  {
            Out << "\n  ";
            Info()();
        }
    }
    Out << "\n";
}

fn ModuleMacro::create(self, PP: *mut Preprocessor, OwningModule: *mut Module, II: *IdentifierInfo, Macro: *mut MacroInfo, Overrides: ArrayRef<ModuleMacro *>) -> *mut ModuleMacro {
    let mut Mem: *mut void = PP()()( +  * (), alignof);
    return OwningModule;
}
