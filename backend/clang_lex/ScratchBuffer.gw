// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

const ScratchBufSize: u32 = 4060;

fn ScratchBuffer::ScratchBuffer(self, SM: *mut SourceManager) {
    self.BytesUsed = ScratchBufSize;
}

fn ScratchBuffer::getToken(self, Buf: *u8, Len: u32, DestPtr: **mut u8) -> SourceLocation {
    if self.BytesUsed + Len + 2 > ScratchBufSize {
        self.AllocScratchBuffer(Len + 2);
    } else {
        self.SourceMgr.getSLocEntry(self.SourceMgr.getFileID(self.BufferStartLoc), null).getFile().getContentCache().SourceLineCache = LineOffsetMapping {};
    }
    self.CurBuffer[self.BytesUsed += 1] = 10;
    DestPtr = self.CurBuffer + self.BytesUsed;
    memcpy(self.CurBuffer + self.BytesUsed, Buf, Len);
    self.BytesUsed += Len + 1;
    self.CurBuffer[self.BytesUsed - 1] = 0;
    return self.BufferStartLoc.getLocWithOffset(self.BytesUsed - Len - 1);
}

fn ScratchBuffer::AllocScratchBuffer(self, RequestLen: u32) {
    if RequestLen < ScratchBufSize {
        RequestLen = ScratchBufSize;
    }
    let mut OwnBuf: i32 = (RequestLen, "<scratch space>");
    self.CurBuffer = ();
    let mut FID: FileID = self.SourceMgr(move());
    self.BufferStartLoc = self.SourceMgr.getLocForStartOfFile(FID);
    self.BytesUsed = 0;
}
