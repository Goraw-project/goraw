struct MMToken {
    Kind: TokenKind,
    Location: UIntTy,
    StringLength: u32,
}

fn MMToken::clear(self) {
    self.Kind = EndOfFile;
    self.Location = 0;
    self.StringLength = 0;
    self..StringData = null;
}

fn MMToken::is(self: *MMToken, K: TokenKind) -> bool {
    return self.Kind == K;
}

fn MMToken::getLocation(self: *MMToken) -> SourceLocation {
    return getFromRawEncoding(self.Location);
}

fn MMToken::getInteger(self: *MMToken) -> u64 {
    return if self.Kind == IntegerLiteral { self..IntegerValue } else { 0 };
}

fn MMToken::getString(self: *MMToken) -> str {
    return if self.Kind == IntegerLiteral { "" } else { self..StringData[0..self.StringLength] };
}

struct ModuleMapFileParser {
    L: *mut Lexer,
    Diags: *mut DiagnosticsEngine,
    MMF: ModuleMapFile,
    HadError: bool,
    Tok: MMToken,
}

fn ModuleMapFileParser::getLocation(self: *ModuleMapFileParser) -> SourceLocation {
    return self.Tok.getLocation();
}

fn formatModuleId(Id: *ModuleId) -> str {
    let mut result: str = "";
    {
        let mut OS: raw_string_ostream = result;
        for let mut I: u32 = 0;
let mut N: u32 = Id.len; I != N; I += 1 {
            if I {
                OS << ".";
            }
            OS << Id[I].first;
        }
    }
    return result;
}

fn parseModuleMap(ID: FileID, Dir: DirectoryEntryRef, SM: *mut SourceManager, Diags: *mut DiagnosticsEngine, IsSystem: bool, ImplicitlyDiscovered: bool, Offset: *mut u32) -> optional<ModuleMapFile> {
    let mut Buffer: MemoryBufferRef> = SM.getBufferOrNone(ID, SourceLocation {});
    let mut LOpts: LangOptions = LangOptions {};
    LOpts.LangStd = lang_c99;
    let mut L: Lexer = Lexer { SM.getLocForStartOfFile(ID), LOpts, operator(Buffer).getBufferStart(), operator(Buffer).getBufferStart() + (if Offset { *Offset } else { 0 }), operator(Buffer).getBufferEnd(), true };
    let mut Start: SourceLocation = L.getSourceLocation();
    let mut Parser: ModuleMapFileParser = ModuleMapFileParser { L: L, Diags: Diags, MMF: ModuleMapFile { ID: FileID {}, Dir: OptionalDirectoryEntryRef {}, Start: SourceLocation {}, IsSystem: , ImplicitlyDiscovered: , Decls: []TopLevelDecl {} }, HadError: false, Tok: MMToken { , , , (anonymous union at P:\Goraw\llvm-project\clang\lib\Lex\ModuleMapFile.cpp:63:3) {} } };
    let mut Failed: bool = Parser.parseTopLevelDecls();
    if Offset {
        let mut Loc: FileIDAndOffset = SM.getDecomposedLoc(Parser.getLocation());
        assert!(Loc.first == ID, "stopped in a different file?");
        *Offset = Loc.second;
    }
    if Failed {
        return nullopt;
    }
    Parser.MMF.ID = ID;
    Parser.MMF.Dir = Dir;
    Parser.MMF.Start = Start;
    Parser.MMF.IsSystem = IsSystem;
    Parser.MMF.ImplicitlyDiscovered = ImplicitlyDiscovered;
    return move(Parser.MMF);
}

fn ModuleMapFileParser::parseTopLevelDecls(self) -> bool {
    self.Tok.clear();
    self.consumeToken();
    while true {
        {
        match self.Tok.Kind {
            EndOfFile => {
                return self.HadError;
            },
            ExternKeyword => {
                let mut EMD: optional<ExternModuleDecl> = self.parseExternModuleDecl();
                if EMD {
                    self.MMF.Decls.push(move(operator(EMD)));
                }
                break;
            },
            ExplicitKeyword => {
                ModuleKeyword;
            },
            Comma => {
                ConfigMacros;
            },
        }
    }
        if !(true) { break; }
    }
}

fn ModuleMapFileParser::parseModuleDecl(self, TopLevel: bool) -> optional<ModuleDecl> {
    assert!(self.Tok.is(ExplicitKeyword) || self.Tok.is(ModuleKeyword) || self.Tok.is(FrameworkKeyword);
    let mut MDecl: ModuleDecl = ModuleDecl {};
    let mut ExplicitLoc: SourceLocation = SourceLocation {};
    MDecl.Explicit = false;
    MDecl.Framework = false;
    if self.Tok.is(ExplicitKeyword) {
        MDecl.Location = ExplicitLoc = self.consumeToken();
        MDecl.Explicit = true;
    }
    if self.Tok.is(FrameworkKeyword) {
        let mut FrameworkLoc: SourceLocation = self.consumeToken();
        if !MDecl.Location.isValid() {
            MDecl.Location = FrameworkLoc;
        }
        MDecl.Framework = true;
    }
    if !self.Tok.is(ModuleKeyword) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_module);
        self.consumeToken();
        self.HadError = true;
        return nullopt;
    }
    let mut ModuleLoc: SourceLocation = self.consumeToken();
    if !MDecl.Location.isValid() {
        MDecl.Location = ModuleLoc;
    }
    if self.Tok.is(Star) {
        let mut StarLoc: SourceLocation = self.consumeToken();
        MDecl.Id.push(SourceLocation> { "*", StarLoc });
        if TopLevel && !MDecl.Framework {
            self.Diags.Report(StarLoc, err_mmap_top_level_inferred_submodule);
            self.HadError = true;
            return nullopt;
        }
    } else {
        if self.parseModuleId(MDecl.Id) {
            self.HadError = true;
            return nullopt;
        }
        if !TopLevel {
            if MDecl.Id.len > 1 {
                self.Diags.Report(MDecl.Id.front().second, err_mmap_nested_submodule_id) << SourceRange { B: MDecl.Id.front().second, E: MDecl.Id.back().second };
                self.HadError = true;
            }
        } else if MDecl.Id.len == 1 && MDecl.Explicit {
            self.Diags.Report(ExplicitLoc, err_mmap_explicit_top_level);
            MDecl.Explicit = false;
            self.HadError = true;
        }
    }
    if self.parseOptionalAttributes(MDecl.Attrs) {
        return nullopt;
    }
    if !self.Tok.is(LBrace) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_lbrace) << MDecl.Id.back().first;
        self.HadError = true;
        return nullopt;
    }
    let mut LBraceLoc: SourceLocation = self.consumeToken();
    let mut Done: bool = false;
    while true {
        {
        let mut SubDecl: optional<Decl> = optional<Decl> {};
        match self.Tok.Kind {
            EndOfFile => {
                RBrace;
            },
            ConfigMacros => {
                if !TopLevel {
                    self.Diags.Report(self.Tok.getLocation(), err_mmap_config_macro_submodule);
                }
            },
            Conflict => {
                SubDecl = self.parseConflictDecl();
            },
            ExternKeyword => {
                SubDecl = self.parseExternModuleDecl();
            },
            ExplicitKeyword => {
                FrameworkKeyword;
            },
            ExportKeyword => {
                SubDecl = self.parseExportDecl();
            },
            ExportAsKeyword => {
                if !TopLevel {
                    self.Diags.Report(self.Tok.getLocation(), err_mmap_submodule_export_as);
                    self.parseExportAsDecl();
                } else {
                    SubDecl = self.parseExportAsDecl();
                }
            },
            UseKeyword => {
                SubDecl = self.parseUseDecl();
            },
            RequiresKeyword => {
                SubDecl = self.parseRequiresDecl();
            },
            TextualKeyword => {
                SubDecl = self.parseHeaderDecl(TextualKeyword, self.consumeToken());
            },
            UmbrellaKeyword => {
                let mut UmbrellaLoc: SourceLocation = self.consumeToken();
                if self.Tok.is(HeaderKeyword) {
                    SubDecl = self.parseHeaderDecl(UmbrellaKeyword, UmbrellaLoc);
                } else {
                    SubDecl = self.parseUmbrellaDirDecl(UmbrellaLoc);
                }
                break;
            },
            ExcludeKeyword => {
                let mut ExcludeLoc: SourceLocation = self.consumeToken();
                if self.Tok.is(HeaderKeyword) {
                    SubDecl = self.parseHeaderDecl(ExcludeKeyword, ExcludeLoc);
                } else {
                    SubDecl = self.parseExcludeDecl(ExcludeLoc);
                }
                break;
            },
            PrivateKeyword => {
                SubDecl = self.parseHeaderDecl(PrivateKeyword, self.consumeToken());
            },
            HeaderKeyword => {
                SubDecl = self.parseHeaderDecl(HeaderKeyword, self.consumeToken());
            },
            LinkKeyword => {
                SubDecl = self.parseLinkDecl();
            },
            _ => {
                self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_member);
            },
        }
        if SubDecl {
            MDecl.Decls.push(move(operator(SubDecl)));
        }
    }
        if !(!Done) { break; }
    }
    if self.Tok.is(RBrace) {
        self.consumeToken();
    } else {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_rbrace);
        self.Diags.Report(LBraceLoc, note_mmap_lbrace_match);
        self.HadError = true;
    }
    return move(MDecl);
}

fn ModuleMapFileParser::parseExternModuleDecl(self) -> optional<ExternModuleDecl> {
    assert!(self.Tok.is(ExternKeyword);
    let mut EMD: ExternModuleDecl = ExternModuleDecl {};
    EMD.Location = self.consumeToken();
    if !self.Tok.is(ModuleKeyword) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_module);
        self.consumeToken();
        self.HadError = true;
        return nullopt;
    }
    self.consumeToken();
    if self.parseModuleId(EMD.Id) {
        self.HadError = true;
        return nullopt;
    }
    if !self.Tok.is(StringLiteral) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_mmap_file);
        self.HadError = true;
        return nullopt;
    }
    EMD.Path = self.Tok.getString();
    self.consumeToken();
    return move(EMD);
}

fn ModuleMapFileParser::parseConfigMacrosDecl(self) -> optional<ConfigMacrosDecl> {
    assert!(self.Tok.is(ConfigMacros);
    let mut CMDecl: ConfigMacrosDecl = ConfigMacrosDecl {};
    CMDecl.Location = self.consumeToken();
    let mut Attrs: ModuleAttributes = ModuleAttributes {};
    if self.parseOptionalAttributes(Attrs) {
        return nullopt;
    }
    CMDecl.Exhaustive = Attrs.IsExhaustive;
    if !self.Tok.is(Identifier) {
        return nullopt;
    }
    CMDecl.Macros.push(self.Tok.getString());
    self.consumeToken();
    while true {
        {
        if !self.Tok.is(Comma) {
            break;
        }
        self.consumeToken();
        if !self.Tok.is(Identifier) {
            self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_config_macro);
            return nullopt;
        }
        CMDecl.Macros.push(self.Tok.getString());
        self.consumeToken();
    }
        if !(true) { break; }
    }
    return move(CMDecl);
}

fn ModuleMapFileParser::parseConflictDecl(self) -> optional<ConflictDecl> {
    assert!(self.Tok.is(Conflict);
    let mut CD: ConflictDecl = ConflictDecl {};
    CD.Location = self.consumeToken();
    if self.parseModuleId(CD.Id) {
        return nullopt;
    }
    if !self.Tok.is(Comma) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_conflicts_comma) << CD.Location;
        return nullopt;
    }
    self.consumeToken();
    if !self.Tok.is(StringLiteral) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_conflicts_message) << formatModuleId(CD.Id);
        return nullopt;
    }
    CD.Message = self.Tok.getString();
    self.consumeToken();
    return move(CD);
}

fn ModuleMapFileParser::parseExportDecl(self) -> optional<ExportDecl> {
    assert!(self.Tok.is(ExportKeyword);
    let mut ED: ExportDecl = ExportDecl {};
    ED.Location = self.consumeToken();
    ED.Wildcard = false;
    while true {
        {
        if self.Tok.is(Identifier) {
            ED.Id.push(make_pair(self.Tok.getString()[0..allocator<char> {}], self.Tok.getLocation()));
            self.consumeToken();
            if self.Tok.is(Period) {
                self.consumeToken();
                continue;
            }
            break;
        }
        if self.Tok.is(Star) {
            ED.Wildcard = true;
            self.consumeToken();
            break;
        }
        self.Diags.Report(self.Tok.getLocation(), err_mmap_module_id);
        self.HadError = true;
        return nullopt;
    }
        if !(true) { break; }
    }
    return move(ED);
}

fn ModuleMapFileParser::parseExportAsDecl(self) -> optional<ExportAsDecl> {
    assert!(self.Tok.is(ExportAsKeyword);
    let mut EAD: ExportAsDecl = ExportAsDecl {};
    EAD.Location = self.consumeToken();
    if !self.Tok.is(Identifier) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_module_id);
        self.HadError = true;
        return nullopt;
    }
    if self.parseModuleId(EAD.Id) {
        return nullopt;
    }
    if EAD.Id.len > 1 {
        self.Diags.Report(EAD.Id[1].second, err_mmap_qualified_export_as);
    }
    return move(EAD);
}

fn ModuleMapFileParser::parseUseDecl(self) -> optional<UseDecl> {
    assert!(self.Tok.is(UseKeyword);
    let mut UD: UseDecl = UseDecl {};
    UD.Location = self.consumeToken();
    if self.parseModuleId(UD.Id) {
        return nullopt;
    }
    return move(UD);
}

fn ModuleMapFileParser::parseRequiresDecl(self) -> optional<RequiresDecl> {
    assert!(self.Tok.is(RequiresKeyword);
    let mut RD: RequiresDecl = RequiresDecl {};
    RD.Location = self.consumeToken();
    while true {
        {
        let mut RequiredState: bool = true;
        if self.Tok.is(Exclaim) {
            RequiredState = false;
            self.consumeToken();
        }
        if !self.Tok.is(Identifier) {
            self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_feature);
            self.HadError = true;
            return nullopt;
        }
        let mut RF: RequiresFeature = RequiresFeature {};
        RF.Feature = self.Tok.getString();
        RF.Location = self.consumeToken();
        RF.RequiredState = RequiredState;
        RD.Features.push(move(RF));
        if !self.Tok.is(Comma) {
            break;
        }
        self.consumeToken();
    }
        if !(true) { break; }
    }
    return move(RD);
}

fn ModuleMapFileParser::parseHeaderDecl(self, LeadingToken: TokenKind, LeadingLoc: SourceLocation) -> optional<HeaderDecl> {
    let mut HD: HeaderDecl = HeaderDecl {};
    HD.Private = false;
    HD.Excluded = false;
    HD.Textual = false;
    HD.Location = LeadingLoc;
    if LeadingToken == PrivateKeyword {
        HD.Private = true;
        if self.Tok.is(TextualKeyword) {
            HD.Textual = true;
            LeadingToken = self.Tok.Kind;
            self.consumeToken();
        }
    } else if LeadingToken == ExcludeKeyword {
        HD.Excluded = true;
    } else if LeadingToken == TextualKeyword {
        HD.Textual = true;
    }
    if LeadingToken != HeaderKeyword {
        if !self.Tok.is(HeaderKeyword) {
            self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_header) << (if LeadingToken == PrivateKeyword { "private" } else { if LeadingToken == ExcludeKeyword { "exclude" } else { if LeadingToken == TextualKeyword { "textual" } else { "umbrella" } } });
            return nullopt;
        }
        self.consumeToken();
    }
    if !self.Tok.is(StringLiteral) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_header) << "header";
        self.HadError = true;
        return nullopt;
    }
    HD.Path = self.Tok.getString();
    HD.PathLoc = self.consumeToken();
    HD.Umbrella = LeadingToken == UmbrellaKeyword;
    if self.Tok.is(LBrace) {
        let mut LBraceLoc: SourceLocation = self.consumeToken();
        while !self.Tok.is(RBrace) && !self.Tok.is(EndOfFile) {
            let mut Str: str = self.Tok.getString();
            let mut Loc: SourceLocation = self.consumeToken();
            match Str.Case("size", Size).Case("mtime", ModTime).Default(Unknown) {
                Size => {
                    if HD.Size {
                        self.Diags.Report(Loc, err_mmap_duplicate_header_attribute) << Str;
                    }
                },
                ModTime => {
                    if HD.MTime {
                        self.Diags.Report(Loc, err_mmap_duplicate_header_attribute) << Str;
                    }
                },
                Unknown => {
                    self.Diags.Report(Loc, err_mmap_expected_header_attribute);
                },
            }
        }
        if self.Tok.is(RBrace) {
            self.consumeToken();
        } else {
            self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_rbrace);
            self.Diags.Report(LBraceLoc, note_mmap_lbrace_match);
            self.HadError = true;
        }
    }
    return move(HD);
}

fn ModuleMapFileParser::parseExcludeDecl(self, LeadingLoc: SourceLocation) -> optional<ExcludeDecl> {
    if !self.Tok.is(Identifier) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_missing_exclude_name);
        self.HadError = true;
        return nullopt;
    }
    let mut ED: ExcludeDecl = ExcludeDecl {};
    ED.Location = LeadingLoc;
    ED.Module = self.Tok.getString();
    self.consumeToken();
    return move(ED);
}

fn ModuleMapFileParser::parseUmbrellaDirDecl(self, UmbrellaLoc: SourceLocation) -> optional<UmbrellaDirDecl> {
    let mut UDD: UmbrellaDirDecl = UmbrellaDirDecl {};
    UDD.Location = UmbrellaLoc;
    if !self.Tok.is(StringLiteral) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_header) << "umbrella";
        self.HadError = true;
        return nullopt;
    }
    UDD.Path = self.Tok.getString();
    self.consumeToken();
    return move(UDD);
}

fn ModuleMapFileParser::parseLinkDecl(self) -> optional<LinkDecl> {
    assert!(self.Tok.is(LinkKeyword);
    let mut LD: LinkDecl = LinkDecl {};
    LD.Location = self.consumeToken();
    LD.Framework = false;
    if self.Tok.is(FrameworkKeyword) {
        self.consumeToken();
        LD.Framework = true;
    }
    if !self.Tok.is(StringLiteral) {
        self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_library_name) << LD.Framework << LD.Location;
        self.HadError = true;
        return nullopt;
    }
    LD.Library = self.Tok.getString();
    self.consumeToken();
    return move(LD);
}

fn ModuleMapFileParser::consumeToken(self) -> SourceLocation {
    let mut Result: SourceLocation = self.Tok.getLocation();
    self.Tok.clear();
    let mut LToken: Token = Token {};
    self.L.LexFromRawLexer(LToken);
    self.Tok.Location = LToken.getLocation().getRawEncoding();
    match LToken.getKind() {
        raw_identifier => {
            let mut RI: str = LToken.getRawIdentifier();
            self.Tok..StringData = RI.ptr;
            self.Tok.StringLength = RI.len;
            self.Tok.Kind = RI.Case("config_macros", ConfigMacros).Case("conflict", Conflict).Case("exclude", ExcludeKeyword).Case("explicit", ExplicitKeyword).Case("export", ExportKeyword).Case("export_as", ExportAsKeyword).Case("extern", ExternKeyword).Case("framework", FrameworkKeyword).Case("header", HeaderKeyword).Case("link", LinkKeyword).Case("module", ModuleKeyword).Case("private", PrivateKeyword).Case("requires", RequiresKeyword).Case("textual", TextualKeyword).Case("umbrella", UmbrellaKeyword).Case("use", UseKeyword).Default(Identifier);
            break;
        },
        comma => {
            self.Tok.Kind = Comma;
        },
        eof => {
            self.Tok.Kind = EndOfFile;
        },
        l_brace => {
            self.Tok.Kind = LBrace;
        },
        l_square => {
            self.Tok.Kind = LSquare;
        },
        period => {
            self.Tok.Kind = Period;
        },
        r_brace => {
            self.Tok.Kind = RBrace;
        },
        r_square => {
            self.Tok.Kind = RSquare;
        },
        star => {
            self.Tok.Kind = Star;
        },
        exclaim => {
            self.Tok.Kind = Exclaim;
        },
        string_literal => {
            if LToken.hasUDSuffix() {
                self.Diags.Report(LToken.getLocation(), err_invalid_string_udl);
                self.HadError = true;
            }
            self.Tok.Kind = StringLiteral;
            self.Tok..StringData = LToken.getLiteralData() + 1;
            self.Tok.StringLength = LToken.getLength() - 2;
            break;
        },
        numeric_constant => {
            let mut Value: u64 = 0;
            if LToken.getLiteralData()[0..LToken.getLength()].getAsInteger(0, Value) {
                self.Diags.Report(self.Tok.getLocation(), err_mmap_unknown_token);
                self.HadError = true;
            }
            self.Tok.Kind = IntegerLiteral;
            self.Tok..IntegerValue = Value;
            break;
        },
        comment => {
            
        },
        hash => {
            let mut NextIsIdent: Closure_1 = Closure_1 { cap_0: self, LToken: &mut LToken };
            if NextIsIdent.call("pragma") && NextIsIdent.call("clang") && NextIsIdent.call("module") && NextIsIdent.call("contents") {
                self.Tok.Kind = EndOfFile;
                break;
            }
        },
        _ => {
            self.Diags.Report(self.Tok.getLocation(), err_mmap_unknown_token);
        },
    }
    return Result;
}

fn ModuleMapFileParser::skipUntil(self, K: TokenKind) {
    let mut braceDepth: u32 = 0;
    let mut squareDepth: u32 = 0;
    while true {
        {
        match self.Tok.Kind {
            EndOfFile => {
                return;
            },
            LBrace => {
                if self.Tok.is(K) && braceDepth == 0 && squareDepth == 0 {
                    return;
                }
            },
            LSquare => {
                if self.Tok.is(K) && braceDepth == 0 && squareDepth == 0 {
                    return;
                }
            },
            RBrace => {
                if braceDepth > 0 {
                    braceDepth -= 1;
                } else if self.Tok.is(K) {
                    return;
                }
            },
            RSquare => {
                if squareDepth > 0 {
                    squareDepth -= 1;
                } else if self.Tok.is(K) {
                    return;
                }
            },
            _ => {
                if braceDepth == 0 && squareDepth == 0 && self.Tok.is(K) {
                    return;
                }
            },
        }
        self.consumeToken();
    }
        if !(true) { break; }
    }
}

fn ModuleMapFileParser::parseModuleId(self, Id: *mut ModuleId) -> bool {
    Id.clear();
    while true {
        {
        if self.Tok.is(Identifier) || self.Tok.is(StringLiteral) {
            Id.push(make_pair(self.Tok.getString()[0..allocator<char> {}], self.Tok.getLocation()));
            self.consumeToken();
        } else {
            self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_module_name);
            return true;
        }
        if !self.Tok.is(Period) {
            break;
        }
        self.consumeToken();
    }
        if !(true) { break; }
    }
    return false;
}

fn ModuleMapFileParser::parseOptionalAttributes(self, Attrs: *mut ModuleAttributes) -> bool {
    let mut Error: bool = false;
    while self.Tok.is(LSquare) {
        let mut LSquareLoc: SourceLocation = self.consumeToken();
        if !self.Tok.is(Identifier) {
            self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_attribute);
            self.skipUntil(RSquare);
            if self.Tok.is(RSquare) {
                self.consumeToken();
            }
            Error = true;
        }
        let mut Attribute: AttributeKind = self.Tok.getString().Case("exhaustive", AT_exhaustive).Case("extern_c", AT_extern_c).Case("no_undeclared_includes", AT_no_undeclared_includes).Case("system", AT_system).Default(AT_unknown);
        match Attribute {
            AT_unknown => {
                self.Diags.Report(self.Tok.getLocation(), warn_mmap_unknown_attribute) << self.Tok.getString();
            },
            AT_system => {
                Attrs.IsSystem = true;
            },
            AT_extern_c => {
                Attrs.IsExternC = true;
            },
            AT_exhaustive => {
                Attrs.IsExhaustive = true;
            },
            AT_no_undeclared_includes => {
                Attrs.NoUndeclaredIncludes = true;
            },
        }
        self.consumeToken();
        if !self.Tok.is(RSquare) {
            self.Diags.Report(self.Tok.getLocation(), err_mmap_expected_rsquare);
            self.Diags.Report(LSquareLoc, note_mmap_lsquare_match);
            self.skipUntil(RSquare);
            Error = true;
        }
        if self.Tok.is(RSquare) {
            self.consumeToken();
        }
    }
    if Error {
        self.HadError = true;
    }
    return Error;
}

fn dumpExternModule(EMD: *ExternModuleDecl, out: *mut raw_ostream, depth: i32) {
    out.indent(depth * 2);
    out << "extern module " << formatModuleId(EMD.Id) << " \"" << EMD.Path << "\"\n";
}

fn dumpDecls(Decls: ArrayRef<Decl>, out: *mut raw_ostream, depth: i32) {
    for Decl in Decls {
        visit(makeVisitor(Closure_2 { out: &mut out, depth: &mut depth }, Closure_3 { out: &mut out, depth: &mut depth }, Closure_4 { out: &mut out, depth: &mut depth }, Closure_5 { out: &mut out, depth: &mut depth }, Closure_6 { out: &mut out, depth: &mut depth }, Closure_7 { out: &mut out, depth: &mut depth }, Closure_8 { out: &mut out, depth: &mut depth }, Closure_9 { out: &mut out, depth: &mut depth }, Closure_10 { out: &mut out, depth: &mut depth }, Closure_11 { out: &mut out, depth: &mut depth }, Closure_12 { out: &mut out, depth: &mut depth }, Closure_13 { out: &mut out, depth: &mut depth }), Decl);
    }
}

fn dumpModule(MD: *ModuleDecl, out: *mut raw_ostream, depth: i32) {
    out.indent(depth * 2);
    out << "module " << formatModuleId(MD.Id) << "\n";
    dumpDecls(MD.Decls, out, depth + 1);
}

fn ModuleMapFile::dump(self: *ModuleMapFile, out: *mut raw_ostream) {
    for Decl in self.Decls {
        visit(makeVisitor(Closure_14 { out: &mut out }, Closure_15 { out: &mut out }), Decl);
    }
}

struct Closure_1 {
    cap_0: *mut ModuleMapFileParser,
    LToken: *mut Token,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Str: str) -> auto {
                self.L.LexFromRawLexer((*self.LToken));
                return !(*self.LToken).isAtStartOfLine() && (*self.LToken).is(raw_identifier) && (*self.LToken).getRawIdentifier() == Str;
            }

struct Closure_2 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_2::call(self: *mut Closure_2, RD: *RequiresDecl) {
            (*self.out).indent((*self.depth) * 2);
            (*self.out) << "requires\n";
        }

struct Closure_3 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_3::call(self: *mut Closure_3, HD: *HeaderDecl) {
            (*self.out).indent((*self.depth) * 2);
            if HD.Private {
                (*self.out) << "private ";
            }
            if HD.Textual {
                (*self.out) << "textual ";
            }
            if HD.Excluded {
                (*self.out) << "excluded ";
            }
            if HD.Umbrella {
                (*self.out) << "umbrella ";
            }
            (*self.out) << "header \"" << HD.Path << "\"\n";
        }

struct Closure_4 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_4::call(self: *mut Closure_4, UDD: *UmbrellaDirDecl) {
            (*self.out).indent((*self.depth) * 2);
            (*self.out) << "umbrella\n";
        }

struct Closure_5 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_5::call(self: *mut Closure_5, MD: *ModuleDecl) {
            dumpModule(MD, (*self.out), (*self.depth));
        }

struct Closure_6 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_6::call(self: *mut Closure_6, ED: *ExcludeDecl) {
            (*self.out).indent((*self.depth) * 2);
            (*self.out) << "exclude " << ED.Module << "\n";
        }

struct Closure_7 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_7::call(self: *mut Closure_7, ED: *ExportDecl) {
            (*self.out).indent((*self.depth) * 2);
            (*self.out) << "export " << (if ED.Wildcard { "*" } else { formatModuleId(ED.Id) }) << "\n";
        }

struct Closure_8 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_8::call(self: *mut Closure_8, EAD: *ExportAsDecl) {
            (*self.out).indent((*self.depth) * 2);
            (*self.out) << "export as\n";
        }

struct Closure_9 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_9::call(self: *mut Closure_9, EMD: *ExternModuleDecl) {
            dumpExternModule(EMD, (*self.out), (*self.depth));
        }

struct Closure_10 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_10::call(self: *mut Closure_10, UD: *UseDecl) {
            (*self.out).indent((*self.depth) * 2);
            (*self.out) << "use\n";
        }

struct Closure_11 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_11::call(self: *mut Closure_11, LD: *LinkDecl) {
            (*self.out).indent((*self.depth) * 2);
            (*self.out) << "link\n";
        }

struct Closure_12 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_12::call(self: *mut Closure_12, CMD: *ConfigMacrosDecl) {
            (*self.out).indent((*self.depth) * 2);
            (*self.out) << "config_macros ";
            if CMD.Exhaustive {
                (*self.out) << "[exhaustive] ";
            }
            for Macro in CMD.Macros {
                (*self.out) << Macro << " ";
            }
            (*self.out) << "\n";
        }

struct Closure_13 {
    out: *mut raw_ostream,
    depth: *mut i32,
}

unsafe fn Closure_13::call(self: *mut Closure_13, CD: *ConflictDecl) {
            (*self.out).indent((*self.depth) * 2);
            (*self.out) << "conflicts\n";
        }

struct Closure_14 {
    out: *mut raw_ostream,
}

unsafe fn Closure_14::call(self: *mut Closure_14, MD: *ModuleDecl) {
            dumpModule(MD, (*self.out), 0);
        }

struct Closure_15 {
    out: *mut raw_ostream,
}

unsafe fn Closure_15::call(self: *mut Closure_15, EMD: *ExternModuleDecl) {
            dumpExternModule(EMD, (*self.out), 0);
        }
