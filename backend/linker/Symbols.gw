// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn maybeDemangleSymbol(ctx: *COFFLinkerContext, symName: str) -> str {
    if ctx.config.demangle {
        let mut prefix: str = "";
        let mut prefixless: str = symName;
        if prefixless.consume_front("__imp_") {
            prefix = "__declspec(dllimport) ";
        }
        let mut demangleInput: str = prefixless;
        if ctx.config.machine == I386 {
            demangleInput.consume_front("_");
        }
        let mut demangled: str = demangle(demangleInput.operator basic_string_view());
        if demangled != demangleInput {
            return prefix + demangled;
        }
        return (prefix + prefixless);
    }
    return symName();
}

fn toString(ctx: *COFFLinkerContext, b: *mut Symbol) -> str {
    return maybeDemangleSymbol(ctx, b.getName());
}

fn toCOFFString(ctx: *COFFLinkerContext, b: *Symbol) -> str {
    return maybeDemangleSymbol(ctx, b.getName());
}

fn op_<<(s: *COFFSyncStream, sym: *Symbol) -> *COFFSyncStream {
    s(maybeDemangleSymbol(s.ctx, sym.getName()));
    return s;
}

fn Symbol::computeName(self) {
    assert!(self.nameData == null, "should only compute the name once for DefinedCOFF symbols");
    let mut d: *mut auto = cast(self);
    let mut nameStr: str = check(cast()()());
    self.nameData = nameStr.ptr;
    self.nameSize = nameStr.len;
    assert!(self.nameSize == nameStr.len, "name length truncated");
}

