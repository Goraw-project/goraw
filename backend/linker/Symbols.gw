fn Symbol::replaceKeepingName(self, other: *mut Symbol, size: u64) {
    let mut origName: str = self.getName();
    memcpy(self, other, size);
    self.nameData = origName.ptr;
    self.nameSize = origName.len;
}

fn DefinedCOFF::getCOFFSymbol(self) -> COFFSymbolRef {
    let mut symSize: u64 = cast(self.file)()();
    if symSize ==  {
        return COFFSymbolRef { self.sym as *coff_symbol16 };
    }
    assert!(symSize ==);
    return COFFSymbolRef { self.sym as *coff_symbol32 };
}

fn DefinedAbsolute::getRVA(self) -> u64 {
    return self.va - self.ctx.config.imageBase;
}

fn Undefined::getWeakAlias(self) -> *mut Symbol {
    let mut weakChain: i32 = 0;
    for let mut a: *mut Symbol = self.weakAlias; a; a = cast(a) {
        if a.isAntiDep {
            break;
        }
        if !isa(a) {
            return a;
        }
        if operator!((a)) {
            break;
        }
    }
    return null;
}

fn Undefined::resolveWeakAlias(self) -> bool {
    let mut d: *mut Defined = self.getDefinedWeakAlias();
    if !d {
        return false;
    }
    let mut name: str = self.getName();
    let mut wasAntiDep: bool = self.isAntiDep;
    if isa(d) {
        memcpy(self, d);
    } else if isa(d) {
        memcpy(self, d);
    } else {
        memcpy(self, d);
    }
    self.nameData = name.ptr;
    self.nameSize = name.len;
    self.isAntiDep = wasAntiDep;
    return true;
}

fn LazyArchive::getMemberBuffer(self) -> MemoryBufferRef {
    let mut c: Child = check2((self.sym.getMember()), Closure_1 { cap_0: self });
    return check2((c.getMemoryBufferRef), Closure_2 { cap_0: self });
}

struct Closure_1 {
    cap_0: *mut LazyArchive,
}

fn Closure_1::call(self: *mut Closure_1) -> auto {
        return toString("could not get the member for symbol " + toCOFFString(self.file.symtab.ctx, self.sym));
    }

struct Closure_2 {
    cap_0: *mut LazyArchive,
}

fn Closure_2::call(self: *mut Closure_2) -> auto {
        return toString("could not get the buffer for the member defining symbol " + toCOFFString(self.file.symtab.ctx, self.sym));
    }
