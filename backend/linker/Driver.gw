}

unsafe fn Closure_11::call(self: *mut Closure_11, path: str) -> auto {
        if (*self.args) {
            return true;
        }
        if  {
            return self.contains(operator*());
        }
        return false;
    }

struct Closure_12 {
    cap_0: *mut LinkerDriver,
}

fn Closure_12::call(self: *Closure_12, name: str) {
            let mut nativeSym: auto = dyn_cast_or_null(operator(self.ctx.hybridSymtab).findUnderscore(name));
            if operator!() {
                return;
            }
            if  {
                nativeSym().getChunk().replace(self.getChunk());
            }
        }
