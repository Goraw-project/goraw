    } else if config.manifest == SideBySide || (config.manifest == Default && !config.manifestDependencies.is_empty()) {
        self.createSideBySideManifest();
    }
    if  {
        if args {
            Err(self.ctx) << "/order and /call-graph-order-file may not be used together";
        }
        self.parseOrderFile();
        config.callGraphProfileSort = false;
    }
    if config.callGraphProfileSort {
        let mut timeScope: TimeTraceScope = TimeTraceScope { Entry: "Call graph" };
        if  {
            self.parseCallGraphFile();
        } else {
            readCallGraphsFromObjectFiles(self.ctx);
        }
    }
    if  {
        config.printSymbolOrder = ();
    }
    self.convertResources();
    if config.doICF != None {
        findKeepUniqueSections(self.ctx);
        doICF(self.ctx);
    }
    writeResult(self.ctx);
    self.ctx.forEachSymtab;
    rootTimer.stop();
    if config.showTiming {
        self.ctx();
    }
    self.reproFile.reset;
    if config.timeTraceEnabled {
        timeTraceProfilerEnd();
        checkError(timeTraceProfilerWrite(args.getLastArgValue(), config.outputFile));
        timeTraceProfilerCleanup();
    }
}

