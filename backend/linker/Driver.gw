unsafe fn Closure_9::call(self: *mut Closure_9, name: str) -> auto {
        let mut sym: *mut Symbol = self.lookup(name);
        if !sym {
            if self.ctx.config.warnMissingOrderSymbol {
                Warn(self.ctx) << ": no such symbol: " << name;
            }
            return null;
        }
        if dyn_cast_or_null(sym) {
            dr;
        } else {
            return dyn_cast_or_null(dr.getChunk());
        }
        return null;
    }

