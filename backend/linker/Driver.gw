fn Closure_5::call(self: *mut Closure_5, filename: str) -> auto {
        if self.ctx.config.vfs {
            if operator(self.ctx.config.vfs).status(filename) {
                statOrErr;
            } else {
                return saver().save(operator(statOrErr).getName());
            }
        }
        return filename;
    }

