fn Log(ctx: *mut COFFLinkerContext) -> COFFSyncStream {
    return COFFSyncStream { ctx, Log };
}

fn Msg(ctx: *mut COFFLinkerContext) -> COFFSyncStream {
    return COFFSyncStream { ctx, Msg };
}

fn Warn(ctx: *mut COFFLinkerContext) -> COFFSyncStream {
    return COFFSyncStream { ctx, Warn };
}

fn Err(ctx: *mut COFFLinkerContext) -> COFFSyncStream {
    return COFFSyncStream { ctx, Err };
}

fn Fatal(ctx: *mut COFFLinkerContext) -> COFFSyncStream {
    return COFFSyncStream { ctx, Fatal };
}

fn errCount(ctx: *mut COFFLinkerContext) -> u64 {
    return ctx.e.errorCount;
}

fn link(args: ArrayRef<const char *>, stdoutOS: *mut raw_ostream, stderrOS: *mut raw_ostream, exitEarly: bool, disableOutput: bool) -> bool {
    let mut ctx: *mut COFFLinkerContext = COFFLinkerContext {};
    ctx.e.initialize(stdoutOS, stderrOS, exitEarly, disableOutput);
    ctx.e.logName = getFilenameWithoutExe(args[0]);
    ctx.e.errorLimitExceededMsg = "too many errors emitted, stopping now (use /errorlimit:0 to see all errors)";
    ctx.driver.linkerMain(args);
    return errCount(*ctx) == 0;
}

fn getOldNewOptions(ctx: *mut COFFLinkerContext, args: *mut InputArgList, id: u32) -> pair<StringRef, StringRef> {
    let mut arg: *mut auto = args;
    if operator!() {
        return void { "", "" };
    }
    let mut s: str = self.getValue();
    let mut ret: pair<StringRef, StringRef> = s.split(';');
    if ret.second.is_empty() {
        Err(ctx) << self.getSpelling() << " expects 'old;new' format, but got " << s;
    }
    return ret;
}

fn getOldNewOptionsExtra(ctx: *mut COFFLinkerContext, args: *mut InputArgList, id: u32) -> tuple<StringRef, StringRef, StringRef> {
    return void { oldDir, newDir, extraDir };
}

fn getOutputPath(path: str, isDll: bool, isDriver: bool) -> str {
    let mut ext: str = ".exe";
    if isDll {
        ext = ".dll";
    } else if isDriver {
        ext = ".sys";
    }
    return (stem(path, native) + ext);
}

fn isCrtend(s: str) -> bool {
    if !s.consume_back(".o") {
        return false;
    }
    if s.ends_with("crtend") {
        return true;
    }
    return !s.is_empty() && s.drop_back(1).ends_with("crtend");
}

fn createFutureForFile(path: str, prefetchInputs: bool) -> i32 {
    let mut strategy: launch = async;
}

fn LinkerDriver::getArch(self) -> ArchType {
    return getMachineArchType(self.ctx.config.machine);
}

fn LinkerDriver::getChunks(self: *LinkerDriver) -> i32 {
    let mut res: i32 = 0;
    return ;
}

fn compatibleMachineType(ctx: *mut COFFLinkerContext, mt: MachineTypes) -> bool {
    if mt == IMAGE_FILE_MACHINE_UNKNOWN {
        return true;
    }
    match ctx.config.machine {
        ARM64 => {
            return mt == ARM64 || mt == ARM64X;
        },
        ARM64EC => {
            ARM64X;
        },
        IMAGE_FILE_MACHINE_UNKNOWN => {
            return true;
        },
        _ => {
            return ctx.config.machine == mt;
        },
    }
}

fn LinkerDriver::addFile(self, file: *mut InputFile) {
    Log(self.ctx) << "Reading ";
    if file.lazy {
        if  {
            f().parseLazy();
        } else {
            cast(file).parseLazy();
        }
    } else {
        self.ctx.consumedInputsSize += file.mb.getBufferSize();
        file.parse();
        if  {
            self.ctx.objFileInstances;
        } else if  {
            if self.ltoCompilationDone {
                Err(self.ctx) << "LTO object file " << " linked in after doing LTO compilation.";
            }
            f().symtab.bitcodeFileInstances.push();
        } else if  {
            self.ctx.importFileInstances;
        }
    }
    let mut mt: MachineTypes = file.getMachineType();
    if mt == ARM64EC && (self.ctx.config.machine == IMAGE_FILE_MACHINE_UNKNOWN || (self.ctx.config.machineInferred && (self.ctx.config.machine == ARM64 || self.ctx.config.machine == AMD64))) {
        Err(self.ctx) << ": machine type arm64ec is ambiguous and cannot be inferred, use /machine:arm64ec or /machine:arm64x";
        return;
    }
    if !compatibleMachineType(self.ctx, mt) {
        Err(self.ctx) << ": machine type " << machineToStr(mt) << " conflicts with " << machineToStr(self.ctx.config.machine);
        return;
    }
    if self.ctx.config.machine == IMAGE_FILE_MACHINE_UNKNOWN && mt != IMAGE_FILE_MACHINE_UNKNOWN {
        self.ctx.config.machineInferred = true;
        self.setMachine(mt);
    }
    self.parseDirectives(file);
}

fn LinkerDriver::takeBuffer(self, mb: i32) -> MemoryBufferRef {
    let mut mbref: MemoryBufferRef = operator*();
    if self.ctx.driver.tar {
        operator(self.ctx.driver.tar).append(relativeToRoot(mbref.getBufferIdentifier()), mbref.getBuffer());
    }
    return mbref;
}

fn LinkerDriver::addObjectFile(self, ctx: *mut COFFLinkerContext, mb: MemoryBufferRef, archiveName: str, offsetInArchive: u64, lazy: bool) -> *mut InputFile {
    let mut coffObj: i32 = createCOFFObject(ctx, mb);
    let mut obj: *mut InputFile = null;
    if ctx.symtab.isEC() {
        if  {
            let mut hybridObj: *mut InputFile = self.addObjectFile(ctx, operator*(), archiveName, offsetInArchive, lazy);
            if ctx.config.machine != ARM64X {
                return hybridObj;
            }
        }
    }
    if ctx.config.fatLTOObjects {
        let mut fatLTOData: Expected<MemoryBufferRef> = zeroed();
        if operator!(errorToBool(self.takeError())) {
            obj = create(ctx, operator*(), archiveName, offsetInArchive, lazy);
        }
    }
    if !obj {
        obj = create(ctx, self.release(), lazy);
    }
    obj.parentName = archiveName;
    self.addFile(obj);
    return obj;
}

fn LinkerDriver::addBuffer(self, mb: i32, wholeArchive: bool, lazy: bool) {
    let mut filename: str = self.getBufferIdentifier();
    let mut mbref: MemoryBufferRef = self.takeBuffer(move());
    match identify_magic(mbref.getBuffer()).operator llvm::file_magic::Impl() {
        windows_resource => {
            self.resources.push(mbref);
        },
        archive => {
            let mut file: i32 = check2((create(mbref)), Closure_1 { filename: &mut filename });
            if wholeArchive || (self.ctx.symtab.isEC() && self.isThin()) {
                let mut archive: *mut Archive = self.get();
                let mut memberIndex: i32 = 0;
                return;
            }
            self.addFile(make(self.ctx, mbref));
            break;
        },
        bitcode => {
            self.addFile(create(self.ctx, mbref, "", 0, lazy));
        },
        coff_object => {
            self.addObjectFile(self.ctx, mbref, "", 0, lazy);
            break;
        },
        coff_import_library => {
            self.addFile(create(self.ctx, mbref, lazy));
        },
        pdb => {
            self.addFile(make(self.ctx, mbref));
        },
        coff_cl_gl_object => {
            Err(self.ctx) << ": is not a native COFF file. Recompile without /GL";
        },
        pecoff_executable => {
            if self.ctx.config.mingw {
                let mut obj: i32 = createCOFFObject(self.ctx, mbref);
                if self.ctx.symtab.isEC() {
                    if  {
                        let mut hybridObj: i32 = createCOFFObject(self.ctx, self.takeBuffer(move()));
                        self.addFile(make(self.ctx.symtab));
                        self.addFile(make(operator(self.ctx.hybridSymtab)));
                        break;
                    }
                }
                let mut machine: auto = self.getMachine() as MachineTypes;
                self.addFile(make(self.ctx.getSymtab()));
                break;
            }
        },
        _ => {
            Err(self.ctx) << ": unknown file type";
        },
    }
}

fn LinkerDriver::handleReproFile(self, path: str, inputOpt: InputOpt) {
    if !self.reproFile {
        return;
    }
    operator(self.reproFile) << '"';
    if inputOpt == DefaultLib {
        operator(self.reproFile) << "/defaultlib:";
    } else if inputOpt == WholeArchive {
        operator(self.reproFile) << "/wholearchive:";
    }
    let mut absPath: str = path;
    let mut ec: error_code = make_absolute(absPath);
    if ec {
        Err(self.ctx) << "cannot find absolute path for reproFile for " << ": " << ec.message();
    }
    remove_dots(absPath, true, native);
    operator(self.reproFile) << absPath << "\"\n";
}

fn LinkerDriver::enqueuePath(self, path: str, lazy: bool, inputOpt: InputOpt) {
    let mut future: auto = zeroed();
    let mut pathStr: str = path();
    self.enqueueTask;
}

fn LinkerDriver::addArchiveBuffer(self, mb: MemoryBufferRef, symName: str, parentName: str, offsetInArchive: u64, lazy: bool) {
    let mut magic: file_magic = identify_magic(mb.getBuffer());
    if magic.operator llvm::file_magic::Impl() == coff_import_library {
        let mut imp: *mut InputFile = make(self.ctx, mb);
        imp.parentName = parentName;
        self.addFile(imp);
        return;
    }
    let mut obj: *mut InputFile = null;
    if magic.operator llvm::file_magic::Impl() == coff_object {
        obj = self.addObjectFile(self.ctx, mb, parentName, offsetInArchive, lazy);
    } else if magic.operator llvm::file_magic::Impl() == bitcode {
        obj = create(self.ctx, mb, parentName, offsetInArchive, lazy);
        obj.parentName = parentName;
        self.addFile(obj);
    } else if magic.operator llvm::file_magic::Impl() == coff_cl_gl_object {
        Err(self.ctx) << ": is not a native COFF file. Recompile without /GL?";
        return;
    } else {
        Err(self.ctx) << "unknown file type: ";
        return;
    }
    Log(self.ctx) << "Loaded " << obj << " for ";
}

fn LinkerDriver::addThinArchiveBuffer(self, mb: MemoryBufferRef, symName: str, lazy: bool) {
    self.addArchiveBuffer(mb, symName, "", 0, lazy);
}

fn LinkerDriver::enqueueArchiveMember(self, c: *Child, sym: *Symbol, parentName: str) {
    let mut reportBufferError: Closure_2 = Closure_2 { cap_0: c, cap_1: parentName, cap_2: self, cap_3: sym };
    if !c.getParent().isThin() {
        let mut offsetInArchive: u64 = c.getChildOffset();
        let mut mbOrErr: Expected<MemoryBufferRef> = zeroed();
        if operator!() {
            reportBufferError(self.takeError());
        }
        let mut mb: MemoryBufferRef = self.get();
        self.enqueueTask;
        return;
    }
    let mut childName: str = check2((c.getFullName), Closure_4 { cap_0: self, sym: &mut sym });
    let mut future: auto = zeroed();
    self.enqueueTask;
}

fn LinkerDriver::isDecorated(self, sym: str) -> bool {
    return sym.starts_with("@") || sym.contains("@@") || sym.starts_with("?") || (!self.ctx.config.mingw && sym.contains('@'));
}

fn LinkerDriver::parseDirectives(self, file: *mut InputFile) {
    let mut s: str = file.getDirectives();
    if s.is_empty() {
        return;
    }
    Log(self.ctx) << "Directives: " << file << ": ";
    let mut parser: ArgParser = self.ctx;
    let mut directives: ParsedDirectives = parser.parseDirectives(s);
    for arg in directives.args {
        match arg.getOption().getID() {
            OPT_aligncomm => {
                file.symtab.parseAligncomm(arg.getValue(0));
            },
            OPT_alternatename => {
                file.symtab.parseAlternateName(arg.getValue(0));
            },
            OPT_arm64xsameaddress => {
                if file.symtab.isEC() {
                    self.parseSameAddress(arg.getValue(0));
                } else {
                    Warn(self.ctx) << " is not allowed in non-ARM64EC files (" << toString(file) << ")";
                }
            },
            OPT_defaultlib => {
                if self.findLibIfNew(arg.getValue(0)) {
                    path;
                } else {
                    self.enqueuePath(operator(path), false, DefaultLib);
                }
            },
            OPT_entry => {
                if !arg.getValue(0)[0] {
                    Fatal(self.ctx) << "missing entry point symbol name";
                }
            },
            OPT_failifmismatch => {
                self.checkFailIfMismatch(arg.getValue(0), file);
            },
            OPT_incl => {
                file.symtab.addGCRoot(arg.getValue(0), false);
            },
            OPT_manifestdependency => {
                self.ctx.config.manifestDependencies.insert(arg.getValue(0));
            },
            OPT_merge => {
                self.parseMerge(arg.getValue(0));
            },
            OPT_nodefaultlib => {
                self.ctx.config.noDefaultLibs.insert;
            },
            OPT_release => {
                self.ctx.config.writeCheckSum = true;
            },
            OPT_section => {
                self.parseSection(arg.getValue(0));
            },
            OPT_stack => {
                self.parseNumbers(arg.getValue(0), &mut self.ctx.config.stackReserve, &mut self.ctx.config.stackCommit);
            },
            OPT_subsystem => {
                let mut gotVersion: bool = false;
                self.parseSubsystem(arg.getValue(0), &mut self.ctx.config.subsystem, &mut self.ctx.config.majorSubsystemVersion, &mut self.ctx.config.minorSubsystemVersion, &mut gotVersion);
                if gotVersion {
                    self.ctx.config.majorOSVersion = self.ctx.config.majorSubsystemVersion;
                    self.ctx.config.minorOSVersion = self.ctx.config.minorSubsystemVersion;
                }
                break;
            },
            OPT_editandcontinue => {
                OPT_guardsym;
            },
            _ => {
                Err(self.ctx) << " is not allowed in .drectve (" << toString(file) << ")";
            },
        }
    }
}

fn LinkerDriver::findFile(self, filename: str) -> str {
    let mut getFilename: Closure_5 = Closure_5 { cap_0: self };
    if is_absolute(filename, native) {
        return getFilename.call(filename);
    }
    let mut hasExt: bool = filename.contains('.');
    return filename;
}

fn getUniqueID(path: str) -> UniqueID> {
    let mut ret: UniqueID = UniqueID {};
    if getUniqueID(path, ret) {
        return nullopt();
    }
    return ret;
}

fn LinkerDriver::findFileIfNew(self, filename: str) -> optional<StringRef> {
    let mut path: str = self.findFile(filename);
    if  {
        let mut seen: bool = operator!(self.visitedFiles(operator*()).second);
        if seen {
            return nullopt;
        }
    }
    if path.ends_with_insensitive(".lib") {
        self.visitedLibs;
    }
    return path;
}

fn LinkerDriver::findLibMinGW(self, filename: str) -> str {
    if filename.contains('/') || filename.contains('\') {
        return filename;
    }
    let mut s: str = filename;
    replace_extension(s, ".a", native);
    let mut libName: str = saver().save("lib" + s);
    return self.findFile(libName);
}

fn LinkerDriver::findLib(self, filename: str) -> str {
    let mut hasExt: bool = filename.contains('.');
    if !hasExt {
        filename = saver().save(filename + ".lib");
    }
    let mut ret: str = self.findFile(filename);
    if self.ctx.config.mingw && ret == filename {
        return self.findLibMinGW(filename);
    }
    return ret;
}

fn LinkerDriver::findLibIfNew(self, filename: str) -> optional<StringRef> {
    if self.ctx.config.noDefaultLibAll {
        return nullopt;
    }
    if operator!(self.visitedLibs.second) {
        return nullopt;
    }
    let mut path: str = self.findLib(filename);
    if self.ctx.config.noDefaultLibs.contains(path.lower()) {
        return nullopt;
    }
    if  {
        if operator!(self.visitedFiles(operator*()).second) {
            return nullopt;
        }
    }
    return path;
}

fn LinkerDriver::setMachine(self, machine: MachineTypes) {
    assert!(self.ctx.config.machine == IMAGE_FILE_MACHINE_UNKNOWN);
    assert!(machine != IMAGE_FILE_MACHINE_UNKNOWN);
    self.ctx.config.machine = machine;
    if !isArm64EC(machine) {
        self.ctx.symtab.machine = machine;
    } else {
        self.ctx.symtab.machine = ARM64EC;
        self.ctx.hybridSymtab;
    }
    self.addWinSysRootLibSearchPaths();
}

fn LinkerDriver::detectWinSysRoot(self, Args: *InputArgList) {
    let mut VFS: FileSystem> = getRealFileSystem();
    let mut VCToolsDir: optional<StringRef> = optional<StringRef> {};
    let mut VCToolsVersion: optional<StringRef> = optional<StringRef> {};
    let mut WinSysRoot: optional<StringRef> = optional<StringRef> {};
    if  {
        VCToolsDir = self.getValue();
    }
    if  {
        VCToolsVersion = self.getValue();
    }
    if  {
        WinSysRoot = self.getValue();
    }
    if !findVCToolChainViaCommandLine(operator(VFS), VCToolsDir, VCToolsVersion, WinSysRoot, self.vcToolChainPath, self.vsLayout) && (Args || !findVCToolChainViaEnvironment(operator(VFS), self.vcToolChainPath, self.vsLayout)) && !findVCToolChainViaSetupConfig(operator(VFS), StringRef> {}, self.vcToolChainPath, self.vsLayout) && !findVCToolChainViaRegistry(self.vcToolChainPath, self.vsLayout) {
        return;
    }
    if  {
        self.diaPath = self.getValue();
        if A().getOption().getID() == OPT_winsysroot {
            append(self.diaPath, "DIA SDK", "", "", "");
        }
    }
    self.useWinSysRootLibPath = !GetEnv("LIB") || Args;
    if !GetEnv("LIB") || Args {
        let mut WinSdkDir: optional<StringRef> = optional<StringRef> {};
        let mut WinSdkVersion: optional<StringRef> = optional<StringRef> {};
        if  {
            WinSdkDir = self.getValue();
        }
        if  {
            WinSdkVersion = self.getValue();
        }
        if useUniversalCRT(self.vsLayout, self.vcToolChainPath, self.getArch(), operator(VFS)) {
            let mut UniversalCRTSdkPath: str = "";
            let mut UCRTVersion: str = "";
            if getUniversalCRTSdkDir(operator(VFS), WinSdkDir, WinSdkVersion, WinSysRoot, UniversalCRTSdkPath, UCRTVersion) {
                self.universalCRTLibPath = UniversalCRTSdkPath;
                append(self.universalCRTLibPath, "Lib", UCRTVersion, "ucrt", "");
            }
        }
        let mut sdkPath: str = "";
        let mut windowsSDKIncludeVersion: str = "";
        let mut windowsSDKLibVersion: str = "";
        if getWindowsSDKDir(operator(VFS), WinSdkDir, WinSdkVersion, WinSysRoot, sdkPath, self.sdkMajor, windowsSDKIncludeVersion, windowsSDKLibVersion) {
            self.windowsSdkLibPath = sdkPath;
            append(self.windowsSdkLibPath, "Lib", "", "", "");
            if self.sdkMajor >= 8 {
                append(self.windowsSdkLibPath, windowsSDKLibVersion, "um", "", "");
            }
        }
    }
}

fn LinkerDriver::addClangLibSearchPaths(self, argv0: str) {
    let mut lldBinary: str = getMainExecutable(argv0.ptr, null);
    let mut binDir: str = lldBinary;
    remove_filename(binDir, native);
    let mut rootDir: str = parent_path(binDir.operator StringRef(), native);
    let mut libDir: str = rootDir;
    append(libDir, "lib", "", "", "");
    let mut runtimeLibDir: str = rootDir;
    append(runtimeLibDir, "lib", "clang", to_string(24), "lib");
    let mut runtimeLibDirWithOS: str = runtimeLibDir;
    append(runtimeLibDirWithOS, "windows", "", "", "");
    self.searchPaths.push(saver().save(runtimeLibDirWithOS));
    self.searchPaths.push(saver().save(runtimeLibDir));
    self.searchPaths.push(saver().save(libDir));
}

fn LinkerDriver::addWinSysRootLibSearchPaths(self) {
    if !self.diaPath.is_empty() {
        append(self.diaPath, "lib", archToLegacyVCArch(self.getArch()), "", "");
        self.searchPaths.push(saver().save(self.diaPath));
    }
    if self.useWinSysRootLibPath {
        self.searchPaths.push(saver().save(getSubDirectoryPath(Lib, self.vsLayout, self.vcToolChainPath, self.getArch(), "")));
        self.searchPaths.push(saver().save(getSubDirectoryPath(Lib, self.vsLayout, self.vcToolChainPath, self.getArch(), "atlmfc")));
    }
    if !self.universalCRTLibPath.is_empty() {
        let mut ArchName: str = archToWindowsSDKArch(self.getArch());
        if !ArchName.is_empty() {
            append(self.universalCRTLibPath, ArchName, "", "", "");
            self.searchPaths.push(saver().save(self.universalCRTLibPath));
        }
    }
    if !self.windowsSdkLibPath.is_empty() {
        let mut path: str = "";
        if appendArchToWindowsSDKLibPath(self.sdkMajor, self.windowsSdkLibPath, self.getArch(), path) {
            self.searchPaths.push(saver().save(path));
        }
    }
    let mut noDefaultLibs: i32 = 0;
    self.ctx.config.noDefaultLibs = move();
}

fn LinkerDriver::addLibSearchPaths(self) {
    let mut envOpt: string> = GetEnv("LIB");
    if !envOpt {
        return;
    }
    let mut env: str = saver().save(operator(envOpt));
    while !env.is_empty() {
        let mut path: str = "";
        tie(path, env) = env.split(';');
        self.searchPaths.push(path);
    }
}

fn LinkerDriver::getDefaultImageBase(self) -> u64 {
    if self.ctx.config.is64() {
        return if self.ctx.config.dll { 6442450944 } else { 5368709120 };
    }
    return if self.ctx.config.dll { 268435456 } else { 4194304 };
}

fn rewritePath(s: str) -> str {
    if exists(s) {
        return relativeToRoot(s);
    }
    return s();
}

fn createResponseFile(args: *InputArgList, searchPaths: ArrayRef<StringRef>) -> str {
    let mut data: str = "";
    let mut os: raw_svector_ostream = data;
    for arg in args {
        match arg.getOption().getID() {
            OPT_linkrepro => {
                OPT_reproduce;
            },
            OPT_INPUT => {
                os << quote(rewritePath(arg.getValue(0))) << "\n";
            },
            OPT_wholearchive_file => {
                os << arg.getSpelling() << quote(rewritePath(arg.getValue(0))) << "\n";
            },
            OPT_call_graph_ordering_file => {
                OPT_deffile;
            },
            OPT_order => {
                let mut orderFile: str = arg.getValue(0);
                orderFile.consume_front("@");
                os << arg.getSpelling() << '@' << quote(rewritePath(orderFile)) << 10;
                break;
            },
            OPT_pdbstream => {
                let mut nameFile: pair<StringRef, StringRef> = arg.getValue(0).split("=");
                os << arg.getSpelling() << nameFile.first << '=' << quote(rewritePath(nameFile.second)) << 10;
                break;
            },
            OPT_implib => {
                OPT_manifestfile;
            },
            _ => {
                os << toString(*arg) << "\n";
            },
        }
    }
    for path in searchPaths {
        let mut relPath: str = relativeToRoot(path);
        os << "/libpath:" << quote(relPath) << "\n";
    }
    return data.operator basic_string();
}

fn parseDebugTypes(ctx: *mut COFFLinkerContext, args: *InputArgList) -> u32 {
    let mut debugTypes: u32 = None as u32;
    if  {
        let mut types: SmallVector<StringRef, 3> = SmallVector<StringRef, 3> {};
        self.getValue().split(types, ',', -1, false);
        for type in types {
            let mut v: u32 = 0;
            if v == 0 {
                Warn(ctx) << "/debugtype: unknown option '" << "'";
                continue;
            }
            debugTypes |= v;
        }
        return debugTypes;
    }
    debugTypes = CV as u32;
    if args {
        debugTypes |= PData as u32;
    }
    if args {
        debugTypes |= Fixup as u32;
    }
    return debugTypes;
}

fn LinkerDriver::getMapFile(self, args: *InputArgList, os: OptSpecifier, osFile: OptSpecifier) -> str {
    let mut arg: *mut auto = args;
    if operator!() {
        return "";
    }
    if arg().getOption().getID() == osFile.getID() {
        return self.getValue();
    }
    (((operator!(operator!((arg().getOption().getID() == os.getID())))) || (_wassert(L"arg->getOption().getID() == os.getID()", L"P:/Goraw/llvm-project/lld/COFF/Driver.cpp", (1042) as u32) , 0)) as void);
    let mut outFile: str = self.ctx.config.outputFile;
    return (outFile[0..0 + outFile.rfind('.', npos)] + ".map");
}

fn LinkerDriver::getImplibPath(self) -> str {
    if !self.ctx.config.implib.is_empty() {
        return self.ctx.config.implib;
    }
    let mut out: str = self.ctx.config.outputFile;
    replace_extension(out, ".lib", native);
    return out.operator basic_string();
}

fn LinkerDriver::getImportName(self, asLib: bool) -> str {
    let mut out: str = "";
    if self.ctx.config.importName.is_empty() {
        out.assign(filename(self.ctx.config.outputFile, native));
        if asLib {
            replace_extension(out, ".dll", native);
        }
    } else {
        out.assign(self.ctx.config.importName);
        if !has_extension(out, native) {
            replace_extension(out, if (self.ctx.config.dll || asLib) { ".dll" } else { ".exe" }, native);
        }
    }
    return out.operator basic_string();
}

fn LinkerDriver::createImportLibrary(self, asLib: bool) {
    let mut timeScope: TimeTraceScope = "Create import library";
    let mut exports: i32 = 0;
    let mut getExports: Closure_6 = Closure_6 {};
    getExports(self.ctx.symtab);
    if self.ctx.config.machine == ARM64X {
        getExports(operator(self.ctx.hybridSymtab));
    }
    let mut libName: str = self.getImportName(asLib);
    let mut path: str = self.getImplibPath();
    if !self.ctx.config.incremental {
        checkError();
        return;
    }
    let mut oldBuf: i32 = getFile(path, false, false);
    if operator!() {
        checkError();
        return;
    }
    let mut tmpName: str = "";
    if createUniqueFile(path + ".tmp-%%%%%%%%.lib", tmpName, all_read | all_write) {
        ec;
    } else {
        Fatal(self.ctx) << "cannot create temporary file for import library " << ": " << ec.message();
    }
    if  {
        e;
    } else {
        checkError(move(e));
        return;
    }
    let mut newBuf: i32 = check(getFile(tmpName, false, false));
    if (operator*()).getBuffer() != self.getBuffer() {
        oldBuf().reset();
        checkError(errorCodeToError(rename(tmpName, path)));
    } else {
        remove(tmpName, true);
    }
}

fn LinkerDriver::enqueueTask(self, task: function<void ()>) {
    self.taskQueue(move(task));
}

fn LinkerDriver::run(self) -> bool {
    let mut timeScope: TimeTraceScope = "Read input files";
    let mut t: ScopedTimer = self.ctx.inputFileTimer;
    let mut didWork: bool = !self.taskQueue.is_empty();
    while !self.taskQueue.is_empty() {
        self.taskQueue.front().call();
        self.taskQueue.pop_front();
    }
    return didWork;
}

fn LinkerDriver::parseOrderFile(self, arg: str) {
    if !arg.starts_with("@") {
        Err(self.ctx) << "malformed /order option: '@' missing";
        return;
    }
    let mut set: i32 = 0;
    let mut path: str = arg[1..1 + npos];
    let mut mb: i32 = check2((getFile(path, false, false, true)), Closure_7 { path: &mut path });
    self.ctx.driver.takeBuffer(move());
}

fn LinkerDriver::parseCallGraphFile(self, path: str) {
    let mut mb: i32 = check2((getFile(path, false, false, true)), Closure_8 { path: &mut path });
    let mut map: i32 = 0;
    let mut findSection: Closure_9 = Closure_9 { cap_0: self, path: &mut path };
    self.ctx.driver.takeBuffer(move());
}

fn readCallGraphsFromObjectFiles(ctx: *mut COFFLinkerContext) {}

fn markAddrsig(s: *mut Symbol) {
    if  {
        if dyn_cast_or_null(self.getChunk()) {
            c;
        } else {
            c.keepUnique = true;
        }
    }
}

fn findKeepUniqueSections(ctx: *mut COFFLinkerContext) {
    let mut timeScope: TimeTraceScope = "Find keep unique sections";
    ctx.forEachSymtab;
}

fn LinkerDriver::parsePDBAltPath(self) {
    let mut buf: str = "";
    let mut pdbBasename: str = filename(self.ctx.config.pdbPath.operator StringRef(), windows);
    let mut binaryExtension: str = extension(self.ctx.config.outputFile, windows);
    if !binaryExtension.is_empty() {
        binaryExtension = binaryExtension[1..1 + npos];
    }
    let mut cursor: u64 = 0;
    while cursor < self.ctx.config.pdbAltPath.len {
        let mut firstMark: u64 = 0;
        let mut secondMark: u64 = 0;
        if (firstMark = self.ctx.config.pdbAltPath.find('%', cursor)) == npos || (secondMark = self.ctx.config.pdbAltPath.find('%', firstMark + 1)) == npos {
            buf.append(self.ctx.config.pdbAltPath.substr);
            break;
        }
        buf.append(self.ctx.config.pdbAltPath[cursor..cursor + firstMark - cursor]);
        let mut var: str = self.ctx.config.pdbAltPath[firstMark..firstMark + secondMark - firstMark + 1];
        if var.equals_insensitive("%_pdb%") {
            buf.append(pdbBasename);
        } else if var.equals_insensitive("%_ext%") {
            buf.append(binaryExtension);
        } else {
            Warn(self.ctx) << "only %_PDB% and %_EXT% supported in /pdbaltpath:, keeping " << " as literal";
            buf.append(var);
        }
        cursor = secondMark + 1;
    }
    self.ctx.config.pdbAltPath = move(buf);
}

fn LinkerDriver::convertResources(self) {
    let mut timeScope: TimeTraceScope = "Convert resources";
    let mut resourceObjFiles: i32 = 0;
    if !self.ctx.config.mingw && (resourceObjFiles().len > 1 || (resourceObjFiles().len == 1 && !self.resources.is_empty())) {
        Err(self.ctx) << (if !self.resources.is_empty() { "internal .obj file created from .res files" } else { toString([1]) }) << ": more than one resource obj file not allowed, already got " << self.front();
        return;
    }
    if self.resources.is_empty() && self.len <= 1 {
        return;
    }
    let mut f: *mut ObjFile = create(self.ctx, self.convertResToCOFF(self.resources));
    self.addFile(f);
    f.includeResourceChunks();
}

fn LinkerDriver::maybeCreateECExportThunk(self, name: str, sym: *mut *mut Symbol) {
    if !sym {
        return;
    }
    let mut def: *mut Defined = sym.getDefined();
    if !def {
        return;
    }
    if def.getChunk().getArm64ECRangeType() {
        return;
    }
    let mut expName: str = "";
    if getArm64ECMangledFunctionName(name) {
        mangledName;
    } else {
        expName = saver().save("EXP+" + operator(mangledName));
    }
    sym = self.ctx.symtab.addGCRoot(expName, false);
    if  {
        if operator!(self.getWeakAlias()) {
            let mut thunk: auto = make(def);
            replaceSymbol(self.getName());
        }
    }
}

fn LinkerDriver::createECExportThunks(self) {
    if self.ctx.symtab.entry {
        self.maybeCreateECExportThunk(self.ctx.symtab.entry.getName(), self.ctx.symtab.entry);
    }
}

fn LinkerDriver::pullArm64ECIcallHelper(self) {
    if !self.ctx.config.arm64ECIcallHelper {
        self.ctx.config.arm64ECIcallHelper = self.ctx.symtab.addGCRoot("__icall_helper_arm64ec", false);
    }
}

fn LinkerDriver::maybeExportMinGWSymbols(self, args: *InputArgList) {
    if !args {
        if !self.ctx.config.dll {
            return;
        }
        if self.ctx.symtab.hadExplicitExports || (self.ctx.config.machine == ARM64X && operator(self.ctx.hybridSymtab).hadExplicitExports) {
            return;
        }
        if args {
            return;
        }
    }
    self.ctx.forEachActiveSymtab;
}

fn getReproduceFile(args: *InputArgList) -> string> {
    if  {
        return self.getValue();
    }
    if  {
        let mut path: str = zeroed();
        append("repro.tar");
        return ;
    }
    if getenv("LLD_REPRODUCE") {
        path;
    } else {
        return path;
    }
    return nullopt;
}

fn getVFS(ctx: *mut COFFLinkerContext, args: *InputArgList) -> i32 {
    let mut arg: *Arg = args;
    if !arg {
        return null;
    }
    let mut bufOrErr: auto = getFile(arg.getValue(0));
    if operator!() {
        checkError(errorCodeToError(self.getError()));
        return null;
    }
    if  {
        return ;
    }
    Err(ctx) << "Invalid vfs overlay";
    return null;
}

fn DllDefaultEntryPoint(machine: MachineTypes, mingw: bool) -> str {
    if mingw {
        return if (machine == I386) { "_DllMainCRTStartup@12" } else { "DllMainCRTStartup" };
    } else {
        return if (machine == I386) { "__DllMainCRTStartup@12" } else { "_DllMainCRTStartup" };
    }
}

const lldsaveTempsValues: [9]char *const = ["resolution", "preopt", "promote", "internalize", "import", "opt", "precodegen", "prelink", "combinedindex"];

fn LinkerDriver::linkerMain(self, argsArr: ArrayRef<const char *>) {
    let mut rootTimer: ScopedTimer = self.ctx.rootTimer;
    let mut config: *mut Configuration = &mut self.ctx.config;
    InitializeAllTargetInfos();
    InitializeAllTargets();
    InitializeAllTargetMCs();
    InitializeAllAsmParsers();
    InitializeAllAsmPrinters();
    if argsArr.len > 1 && (argsArr[1].equals_insensitive("/lib") || argsArr[1].equals_insensitive("-lib")) {
        if libDriverMain(argsArr.slice(1)) != 0 {
            Fatal(self.ctx) << "lib failed";
        }
        return;
    }
    let mut parser: ArgParser = self.ctx;
    let mut args: InputArgList = parser.parse(argsArr);
    config.timeTraceEnabled = args;
    config.timeTraceGranularity = getInteger(args, OPT_time_trace_granularity_eq, 500);
    if config.timeTraceEnabled {
        timeTraceProfilerInitialize(config.timeTraceGranularity, argsArr[0], false);
    }
    let mut timeScope: TimeTraceScope = "COFF link";
    let mut v: i32 = 0;
    v().push("lld-link (LLVM option parsing)");
    {
        let mut timeScope2: TimeTraceScope = "Parse cl::opt";
        ResetAllOptionOccurrences();
        ParseCommandLineOptions(self.len, self.ptr);
    }
    if  {
        let mut n: i32 = 20;
        let mut s: str = self.getValue();
        if s {
            Err(self.ctx) << self.getSpelling() << " number expected, but got " << s;
        }
        self.ctx.e.errorLimit = n;
    }
    if args {
        self.printHelp(argsArr[0]);
        return;
    }
    if  {
        let mut v: str = arg().getValue();
        let mut threads: u32 = 0;
        if !to_integer(v, threads, 0) || threads == 0 {
            Err(self.ctx) << self.getSpelling() << ": expected a positive integer, but got '" << self.getValue() << "'";
        }
        strategy = hardware_concurrency(threads);
        config.thinLTOJobs = v;
    }
    if args {
        config.showTiming = true;
    }
    config.showSummary = args;
    config.printSearchPaths = args;
    if args {
        Msg(self.ctx);
        return;
    }
    config.mingw = args;
    if config.mingw {
        self.ctx.e.errorLimitExceededMsg = "too many errors emitted, stopping now (use --error-limit=0 to see all errors)";
    }
    {
        let mut timeScope2: TimeTraceScope = "Reproducer";
        if getReproduceFile(args) {
            path;
        } else {
            let mut errOrWriter: i32 = create(operator(path), stem(operator(path), native));
            if errOrWriter() {
                self.tar = move(operator*());
            } else {
                Err(self.ctx) << "/linkrepro: failed to open " << ": " << toString(self.takeError());
            }
        }
    }
    if  {
        let mut ec: error_code = error_code {};
        self.reproFile = make_unique(self.getValue(), ec);
        if ec {
            Err(self.ctx) << "cannot open " << self.getValue() << ": " << ec.message();
            self.reproFile.reset;
        }
    }
    if !args {
        if args {
            config.noEntry = true;
        } else {
            Fatal(self.ctx) << "no input files";
        }
    }
    {
        let mut timeScope2: TimeTraceScope = "Search paths";
        self.searchPaths;
        if !config.mingw {
            self.addClangLibSearchPaths(argsArr[0]);
            self.detectWinSysRoot(args);
            if !args {
                self.addLibSearchPaths();
            }
        } else {
            if args {
                Warn(self.ctx) << "ignoring /vctoolsdir or /winsysroot flags in MinGW mode";
            }
        }
    }
    if  {
        config.outputFile = self.getValue();
    }
    if args {
        config.verbose = true;
    }
    self.ctx.e.verbose = config.verbose;
    if args {
        config.forceUnresolved = true;
    }
    if args {
        config.forceMultiple = true;
    }
    if args {
        config.forceMultipleRes = true;
    }
    if config.mingw {
        config.warnLongSectionNames = false;
    }
    let mut doGC: bool = true;
    let mut shouldCreatePDB: bool = false;
    config.demangle = args.hasFlag(OPT_demangle, OPT_demangle_no, true);
    config.debugTypes = parseDebugTypes(self.ctx, args);
    config.driverUponly = args || args || args;
    config.driverWdm = args || args || args;
    config.driver = config.driverUponly || config.driverWdm || args;
    if shouldCreatePDB {
        if  {
            config.pdbPath = self.getValue();
        }
        if  {
            config.pdbAltPath = self.getValue();
        }
        if  {
            self.parsePDBPageSize(self.getValue());
        }
        if args {
            config.natvisFiles = args.getAllArgValues(OPT_natvis);
        }
        if args {}
        if  {
            config.pdbSourcePath = self.getValue();
        }
    }
    if args {
        Warn(self.ctx) << "ignoring /pdbstripped flag, it is not yet supported";
    }
    if args {
        if args {
            config.noEntry = true;
        } else {
            Err(self.ctx) << "/noentry must be specified with /dll";
        }
    }
    if args {
        config.dll = true;
        config.manifestID = 2;
    }
    let mut dynamicBaseArg: *mut auto = args;
    if dynamicBaseArg() && self.getOption().getID() == OPT_dynamicbase_no {
        config.dynamicBase = false;
    }
    let mut fixed: bool = args.hasFlag(OPT_fixed, OPT_fixed_no, false);
    if fixed {
        if dynamicBaseArg() && self.getOption().getID() == OPT_dynamicbase {
            Err(self.ctx) << "/fixed must not be specified with /dynamicbase";
        } else {
            config.relocatable = false;
            config.dynamicBase = false;
        }
    }
    config.appContainer = args.hasFlag(OPT_appcontainer, OPT_appcontainer_no, false);
    {
        let mut timeScope2: TimeTraceScope = "Machine arg";
        if  {
            let mut machine: MachineTypes = getMachineType(self.getValue());
            if machine == IMAGE_FILE_MACHINE_UNKNOWN {
                Fatal(self.ctx) << "unknown /machine argument: " << self.getValue();
            }
            self.setMachine(machine);
        }
    }
    {
        let mut timeScope2: TimeTraceScope = "Nodefaultlib";
    }
    if args {
        config.noDefaultLibAll = true;
    }
    if  {
        self.parseNumbers(self.getValue(), &mut config.imageBase);
    }
    if  {
        self.parseNumbers(self.getValue(), &mut config.fileAlign);
        if !isPowerOf2_64(config.fileAlign) {
            Err(self.ctx) << "/filealign: not a power of two: ";
        }
    }
    if  {
        self.parseNumbers(self.getValue(), &mut config.stackReserve, &mut config.stackCommit);
    }
    if  {
        self.parseGuard(self.getValue());
    }
    if  {
        self.parseNumbers(self.getValue(), &mut config.heapReserve, &mut config.heapCommit);
    }
    if  {
        self.parseVersion(self.getValue(), &mut config.majorImageVersion, &mut config.minorImageVersion);
    }
    if  {
        self.parseSubsystem(self.getValue(), &mut config.subsystem, &mut config.majorSubsystemVersion, &mut config.minorSubsystemVersion);
    }
    if  {
        self.parseVersion(self.getValue(), &mut config.majorOSVersion, &mut config.minorOSVersion);
    } else {
        config.majorOSVersion = config.majorSubsystemVersion;
        config.minorOSVersion = config.minorSubsystemVersion;
    }
    if args {
        arg;
    } else {
        if arg.getOption().getID() == OPT_repro {
            config.timestamp = 0;
            config.repro = true;
        } else {
            config.repro = false;
            let mut value: str = arg.getValue(0);
            if value {
                Fatal(self.ctx) << "invalid timestamp: " << ".  Expected 32-bit integer";
            }
        }
    }
    if  {
        config.implib = self.getValue();
    }
    config.noimplib = args;
    if args {
        doGC = true;
    }
    let mut icfLevel: optional<ICFLevel> = zeroed();
    if args {
        icfLevel() = None;
    }
    let mut tailMerge: u32 = 1;
    let mut ltoDebugPM: bool = false;
    if operator!() {
        icfLevel() = if doGC { All } else { None };
    }
    config.doGC = doGC;
    config.doICF = operator*();
    config.tailMerge = (tailMerge == 1 && config.doICF != None) || tailMerge == 2;
    config.ltoDebugPassManager = ltoDebugPM;
    if args {
        config.saveTempsArgs;
    } else {}
    if  {
        let mut s: str = self.getValue();
        if s == "obj" {
            config.emit = Obj;
        } else if s == "llvm" {
            config.emit = LLVM;
        } else if s == "asm" {
            config.emit = ASM;
        } else {
            Err(self.ctx) << "/lldemit: unknown option: ";
        }
    }
    if args {
        config.killAt = true;
    }
    if  {
        config.ltoCache = self.getValue();
    }
    if  {
        config.ltoCachePolicy = check2((parseCachePruningPolicy(self.getValue())), Closure_10 {});
    }
    self.parseMerge(".idata=.rdata");
    self.parseMerge(".didat=.rdata");
    self.parseMerge(".edata=.rdata");
    self.parseMerge(".xdata=.rdata");
    self.parseMerge(".00cfg=.rdata");
    self.parseMerge(".bss=.data");
    if isArm64EC(config.machine) {
        self.parseMerge(".wowthk=.text");
    }
    if config.mingw {
        self.parseMerge(".ctors=.rdata");
        self.parseMerge(".dtors=.rdata");
        self.parseMerge(".CRT=.rdata");
        self.parseMerge(".data_cygwin_nocopy=.data");
    }
    if  {
        self.parseSectionLayout(self.getValue());
    }
    if  {
        self.parseNumbers(self.getValue(), &mut config.align);
        if !isPowerOf2_64(config.align) {
            Err(self.ctx) << "/align: not a power of two: ";
        }
        if !args {
            Warn(self.ctx) << "/align specified without /driver; image may not run";
        }
    }
    if  {
        if arg().getOption().getID() == OPT_manifest {
            config.manifest = SideBySide;
        } else {
            self.parseManifest(self.getValue());
        }
    }
    if  {
        self.parseManifestUAC(self.getValue());
    }
    if  {
        config.manifestFile = self.getValue();
    }
    if !config.manifestInput.is_empty() && config.manifest != Embed {
        Fatal(self.ctx) << "/manifestinput: requires /manifest:embed";
    }
    config.dtltoDistributor = args.getLastArgValue(OPT_thinlto_distributor, "");
    config.dtltoDistributorArgs = getStrings(args, OPT_thinlto_distributor_arg);
    config.dtltoCompiler = args.getLastArgValue(OPT_thinlto_remote_compiler, "");
    if !config.dtltoDistributor.is_empty() && config.dtltoCompiler.is_empty() {
        Err(self.ctx) << "A value must be specified for /thinlto-remote-compiler if /thinlto-distributor is specified.";
    }
    config.dtltoCompilerPrependArgs = getStrings(args, OPT_thinlto_remote_compiler_prepend_arg);
    config.dtltoCompilerArgs = getStrings(args, OPT_thinlto_remote_compiler_arg);
    config.fatLTOObjects = args.hasFlag(OPT_fat_lto_objects, OPT_fat_lto_objects_no, false);
    config.dwoDir = args.getLastArgValue(OPT_dwodir, "");
    config.thinLTOEmitImportsFiles = args;
    config.thinLTOIndexOnly = args || args;
    config.thinLTOIndexOnlyArg = args.getLastArgValue(OPT_thinlto_index_only_arg, "");
    config.thinLTOObjectSuffixReplace;
    config.ltoObjPath = args.getLastArgValue(OPT_lto_obj_path, "");
    config.ltoCSProfileGenerate = args;
    config.ltoCSProfileFile = args.getLastArgValue(OPT_lto_cs_profile_file, "");
    config.ltoSampleProfileName = args.getLastArgValue(OPT_lto_sample_profile, "");
    config.ltoPGOWarnMismatch = args.hasFlag(OPT_lto_pgo_warn_mismatch, OPT_lto_pgo_warn_mismatch_no, true);
    config.allowBind = args.hasFlag(OPT_allowbind, OPT_allowbind_no, true);
    config.allowIsolation = args.hasFlag(OPT_allowisolation, OPT_allowisolation_no, true);
    config.incremental = args.hasFlag(OPT_incremental, OPT_incremental_no, !config.doGC && config.doICF == None && !args && !args);
    config.integrityCheck = args.hasFlag(OPT_integritycheck, OPT_integritycheck_no, false);
    config.cetCompat = args.hasFlag(OPT_cetcompat, OPT_cetcompat_no, false);
    config.cetCompatStrict = args.hasFlag(OPT_cetcompatstrict, OPT_cetcompatstrict_no, false);
    config.cetCompatIpValidationRelaxed = args.hasFlag(OPT_cetipvalidationrelaxed, OPT_cetipvalidationrelaxed_no, false);
    config.cetCompatDynamicApisInProcOnly = args.hasFlag(OPT_cetdynamicapisinproc, OPT_cetdynamicapisinproc_no, false);
    config.hotpatchCompat = args.hasFlag(OPT_hotpatchcompatible, OPT_hotpatchcompatible_no, false);
    config.nxCompat = args.hasFlag(OPT_nxcompat, OPT_nxcompat_no, true);
    config.terminalServerAware = !config.dll && args.hasFlag(OPT_tsaware, OPT_tsaware_no, true);
    config.autoImport = args.hasFlag(OPT_auto_import, OPT_auto_import_no, config.mingw);
    config.pseudoRelocs = args.hasFlag(OPT_runtime_pseudo_reloc, OPT_runtime_pseudo_reloc_no, config.mingw);
    config.callGraphProfileSort = args.hasFlag(OPT_call_graph_profile_sort, OPT_call_graph_profile_sort_no, true);
    config.stdcallFixup = args.hasFlag(OPT_stdcall_fixup, OPT_stdcall_fixup_no, config.mingw);
    config.warnStdcallFixup = !args;
    config.allowDuplicateWeak = args.hasFlag(OPT_lld_allow_duplicate_weak, OPT_lld_allow_duplicate_weak_no, config.mingw);
    if args.hasFlag(OPT_inferasanlibs, OPT_inferasanlibs_no, false) {
        Warn(self.ctx) << "ignoring '/inferasanlibs', this flag is not supported";
    }
    if config.incremental && args {
        Warn(self.ctx) << "ignoring '/incremental' due to '/profile' specification";
        config.incremental = false;
    }
    if config.incremental && args {
        Warn(self.ctx) << "ignoring '/incremental' due to '/order' specification";
        config.incremental = false;
    }
    if config.incremental && config.doGC {
        Warn(self.ctx) << "ignoring '/incremental' because REF is enabled; use '/opt:noref' to disable";
        config.incremental = false;
    }
    if config.incremental && config.doICF != None {
        Warn(self.ctx) << "ignoring '/incremental' because ICF is enabled; use '/opt:noicf' to disable";
        config.incremental = false;
    }
    if args.hasFlag(OPT_prefetch_inputs, OPT_prefetch_inputs_no, false) {
        config.prefetchInputs = true;
    }
    config.optRemarksFilename = args.getLastArgValue(OPT_opt_remarks_filename, "");
    config.optRemarksPasses = args.getLastArgValue(OPT_opt_remarks_passes, "");
    config.optRemarksFormat = args.getLastArgValue(OPT_opt_remarks_format, "");
    config.optRemarksWithHotness = args;
    if  {
        let mut resultOrErr: auto = (self.getValue());
        if operator!() {
            Err(self.ctx) << self.getSpelling() << ": invalid argument '" << self.getValue() << "', only integer or 'auto' is supported";
        } else {
            config.optRemarksHotnessThreshold = operator*();
        }
    }
    if errCount(self.ctx) {
        return;
    }
    let mut wholeArchives: i32 = 0;
    let mut isWholeArchive: Closure_11 = Closure_11 { args: &mut args };
    {
        let mut timeScope2: TimeTraceScope = "Parse & queue inputs";
        let mut inLib: bool = false;
        for arg in args {
            match arg.getOption().getID() {
                OPT_end_lib => {
                    if !inLib {
                        Err(self.ctx) << "stray ";
                    }
                },
                OPT_start_lib => {
                    if inLib {
                        Err(self.ctx) << "nested ";
                    }
                },
                OPT_wholearchive_file => {
                    if self.findFileIfNew(arg.getValue(0)) {
                        path;
                    } else {
                        self.enqueuePath(operator(path), inLib, WholeArchive);
                    }
                },
                OPT_INPUT => {
                    if self.findFileIfNew(arg.getValue(0)) {
                        path;
                    } else {
                        self.enqueuePath(operator(path), inLib, if isWholeArchive.call(operator(path)) { WholeArchive } else { None });
                    }
                },
                _ => {
                    break;
                },
            }
        }
    }
    self.run();
    if errorCount() {
        return;
    }
    if config.machine == IMAGE_FILE_MACHINE_UNKNOWN {
        Warn(self.ctx) << "/machine is not specified. x64 is assumed";
        self.setMachine(AMD64);
    }
    config.wordsize = if config.is64() { 8 } else { 4 };
    if config.printSearchPaths {
        let mut buffer: str = "";
        let mut stream: raw_svector_ostream = buffer;
        stream << "Library search paths:\n";
        Msg(self.ctx);
    }
    self.run();
    if errorCount() {
        return;
    }
    if args {
        config.writeCheckSum = true;
    }
    if config.machine == I386 {
        config.safeSEH = args.hasFlag(OPT_safeseh, OPT_safeseh_no, !config.mingw);
        config.noSEH = args;
    }
    if  {
        self.parseDosStub(self.getValue());
    }
    if config.hotpatchCompat && config.functionPadMin < 6 {
        Err(self.ctx) << "/hotpatchcompatible: requires at least 6 bytes of /functionpadmin";
    }
    if self.tar {
        let mut timeScope: TimeTraceScope = "Reproducer: response file";
        operator(self.tar).append("response.txt", createResponseFile(args, self.searchPaths.slice(1)));
    }
    config.largeAddressAware = args.hasFlag(OPT_largeaddressaware, OPT_largeaddressaware_no, config.is64());
    config.highEntropyVA = config.is64() && args.hasFlag(OPT_highentropyva, OPT_highentropyva_no, true);
    config.mergeDebugDirectory = !args;
    if !config.dynamicBase && (config.machine == ARMNT || isAnyArm64(config.machine)) {
        Err(self.ctx) << "/dynamicbase:no is not compatible with ";
    }
    {
        let mut timeScope: TimeTraceScope = "Parse /export";
    }
    if  {
        self.ctx.symtab.parseModuleDefs(self.getValue());
        if self.ctx.config.machine == ARM64X {
            if  {
                operator(self.ctx.hybridSymtab).parseModuleDefs(self.getValue());
            }
        }
    }
    if !args {
        self.ctx.forEachSymtab;
        if !config.noimplib {
            self.createImportLibrary(true);
        }
        return;
    }
    if config.subsystem == IMAGE_SUBSYSTEM_UNKNOWN {
        let mut timeScope: TimeTraceScope = "Infer subsystem";
        config.subsystem = self.ctx.symtab.inferSubsystem();
        if config.subsystem == IMAGE_SUBSYSTEM_UNKNOWN {
            Fatal(self.ctx) << "subsystem must be defined";
        }
    }
    self.ctx.forEachActiveSymtab;
    {
        let mut timeScope: TimeTraceScope = "Delay load";
    }
    if config.outputFile.is_empty() {
        config.outputFile = getOutputPath((operator*(args.begin())).getValue(), config.dll, config.driver);
    }
    if tryCreateFile(config.outputFile) {
        e;
    } else {
        Err(self.ctx) << "cannot open output file " << ": " << e.message();
        return;
    }
    config.lldmapFile = self.getMapFile(args, OPT_lldmap, OPT_lldmap_file);
    config.mapFile = self.getMapFile(args, OPT_map, OPT_map_file);
    if config.mapFile != "" && args {}
    if config.lldmapFile != "" && config.lldmapFile == config.mapFile {
        Warn(self.ctx) << "/lldmap and /map have the same output file '" << "'.\n>>> ignoring /lldmap";
        config.lldmapFile.clear();
    }
    if args.hasFlag(OPT_build_id, OPT_build_id_no, false) {
        config.buildIDHash = Binary;
    }
    if shouldCreatePDB {
        if config.pdbPath.is_empty() {
            config.pdbPath = config.outputFile;
            replace_extension(config.pdbPath, ".pdb", native);
        }
        if config.pdbAltPath.is_empty() {
            config.pdbAltPath = config.pdbPath;
            make_absolute(config.pdbAltPath);
            remove_dots(config.pdbAltPath, false, native);
        } else {
            self.parsePDBAltPath();
        }
        config.buildIDHash = PDB;
    }
    if config.imageBase == -1 {
        config.imageBase = self.getDefaultImageBase();
    }
    self.ctx.forEachSymtab;
    {
        let mut timeScope: TimeTraceScope = "Add unresolved symbols";
        while true {
            {
            self.ctx.forEachSymtab;
            self.ctx.forEachActiveSymtab;
        }
            if !(self.run()) { break; }
        }
    }
    for pat in getStrings(args, OPT_incl_glob) {
        self.ctx.forEachActiveSymtab;
    }
    self.ctx.forEachSymtab;
    if config.autoImport || config.stdcallFixup {
        self.ctx.forEachSymtab;
        self.run();
    }
    if !config.forceUnresolved {
        self.ctx.forEachSymtab;
    }
    if errorCount() {
        return;
    }
    self.ctx.forEachSymtab;
    if config.mingw {
        self.maybeExportMinGWSymbols(args);
    }
    self.ltoCompilationDone = true;
    self.ctx.forEachSymtab;
    self.ctx.forEachSymtab;
    if config.emit != Obj || config.thinLTOIndexOnly {
        return;
    }
    self.run();
    self.ctx.forEachSymtab;
    if isArm64EC(config.machine) {
        self.createECExportThunks();
    }
    let mut aliases: i32 = 0;
    self.ctx.forEachSymtab;
    if errorCount() {
        return;
    }
    if self.ctx.hybridSymtab {
        let mut maybeReplaceWithNative: Closure_12 = Closure_12 { cap_0: self };
        maybeReplaceWithNative.call("_tls_start");
        maybeReplaceWithNative.call("_tls_end");
    }
    self.ctx.forEachActiveSymtab;
    if config.doGC {
        if config.mingw {
            self.ctx.forEachSymtab;
        }
        markLive(self.ctx);
    }
    self.ctx.symtab.initializeSameAddressThunks();
    if config.mingw {
        for let mut i: auto = self.ctx.objFileInstances.begin;
let mut e: auto = self.ctx.objFileInstances.end; i() != ;  += 1 {
            let mut file: *mut ObjFile = operator*();
            if isCrtend(file.getName()) {
                self.ctx.objFileInstances;
                self.ctx.objFileInstances.push(file);
                break;
            }
        }
    }
    if config.dll || !self.ctx.symtab.exports.is_empty() || (self.ctx.config.machine == ARM64X && !operator(self.ctx.hybridSymtab).exports.is_empty()) {
        let mut timeScope: TimeTraceScope = "Create .lib exports";
        self.ctx.forEachActiveSymtab;
        if !config.noimplib && (!config.mingw || !config.implib.is_empty()) {
            self.createImportLibrary(false);
        }
        self.ctx.forEachActiveSymtab;
    }
    if  {
        writeDefFile(self.ctx, self.getValue(), self.ctx.symtab.exports);
    }
    self.ctx.forEachSymtab;
    if config.manifest == Embed {
        self.addBuffer(self.createManifestRes(), false, false);
    } else if config.manifest == SideBySide || (config.manifest == Default && !config.manifestDependencies.is_empty()) {
        self.createSideBySideManifest();
    }
    if  {
        if args {
            Err(self.ctx) << "/order and /call-graph-order-file may not be used together";
        }
        self.parseOrderFile(self.getValue());
        config.callGraphProfileSort = false;
    }
    if config.callGraphProfileSort {
        let mut timeScope: TimeTraceScope = "Call graph";
        if  {
            self.parseCallGraphFile(self.getValue());
        } else {
            readCallGraphsFromObjectFiles(self.ctx);
        }
    }
    if  {
        config.printSymbolOrder = self.getValue();
    }
    self.convertResources();
    if config.doICF != None {
        findKeepUniqueSections(self.ctx);
        doICF(self.ctx);
    }
    writeResult(self.ctx);
    self.ctx.forEachSymtab;
    rootTimer.stop();
    if config.showTiming {
        self.ctx.rootTimer.print();
    }
    self.reproFile.reset;
    if config.timeTraceEnabled {
        timeTraceProfilerEnd();
        checkError(timeTraceProfilerWrite(args.getLastArgValue(OPT_time_trace_eq, ""), config.outputFile));
        timeTraceProfilerCleanup();
    }
}

