// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;
extern fn memset(dest: *mut u8, c: i32, n: u64) -> *mut u8;

struct HintNameChunk {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    name: str,
    hint: u16,
}

fn HintNameChunk::getSize(self: *HintNameChunk) -> u64 {
    return alignTo(self.name.len + 3, 2);
}

fn HintNameChunk::writeTo(self: *HintNameChunk, buf: *mut u8) {
    memset(buf, 0, self.getSize());
    write16le(buf, self.hint);
    memcpy(buf + 2, self.name.ptr, self.name.len);
}

fn HintNameChunk::kind(self: *HintNameChunk) -> Kind {
    return self.chunkKind;
}

fn HintNameChunk::getAlignment(self: *HintNameChunk) -> u32 {
    return 1 << self.p2Align;
}

fn HintNameChunk::setAlignment(self, align: u32) {
    align = if align {} else { 1 };
    assert!(isPowerOf2_32(align), "alignment is not a power of 2");
    self.p2Align = Log2_32(align);
    assert!(self.p2Align <= Log2MaxSectionAlignment, "impossible requested alignment");
}

fn HintNameChunk::getRVA(self: *HintNameChunk) -> u32 {
    return self.rva;
}

fn HintNameChunk::setRVA(self, v: u64) {
    self.rva = v as u32;
}

fn HintNameChunk::setOutputSectionIdx(self, o: u16) {
    self.osidx = o;
}

fn HintNameChunk::getOutputSectionIdx(self: *HintNameChunk) -> u16 {
    return self.osidx;
}

fn HintNameChunk::getOutputCharacteristics(self: *HintNameChunk) -> u32 {
    return 0;
}

fn HintNameChunk::getSectionName(self: *HintNameChunk) -> str {
    llvm_unreachable_internal("unimplemented getSectionName", "lld\\COFF\\Chunks.h", 176);
}

fn HintNameChunk::getBaserels(self, res: *mut []Baserel) {}

fn HintNameChunk::getMachine(self: *HintNameChunk) -> MachineTypes {
    return IMAGE_FILE_MACHINE_UNKNOWN;
}

fn HintNameChunk::getDebugName(self: *HintNameChunk) -> str {
    return "";
}

fn HintNameChunk::verifyRanges(self) -> bool {
    return true;
}

fn HintNameChunk::extendRanges(self) -> u32 {
    return 0;
}

fn HintNameChunk::getEntryThunk(self: *HintNameChunk) -> *mut Defined {
    return null;
}

fn HintNameChunk::classof(self, c: *Chunk) -> bool {
    return c.kind() >= OtherKind;
}

struct LookupChunk {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    hintName: *mut Chunk,
    ctx: *mut COFFLinkerContext,
}

fn LookupChunk::LookupChunk(self, ctx: *mut COFFLinkerContext, c: *mut Chunk) {
    self.setAlignment(ctx.config.wordsize);
}

fn LookupChunk::getSize(self: *LookupChunk) -> u64 {
    return self.ctx.config.wordsize;
}

fn LookupChunk::writeTo(self: *LookupChunk, buf: *mut u8) {
    if self.ctx.config.is64() {
        write64le(buf, self.hintName.getRVA());
    } else {
        write32le(buf, self.hintName.getRVA());
    }
}

fn LookupChunk::kind(self: *LookupChunk) -> Kind {
    return self.chunkKind;
}

fn LookupChunk::getAlignment(self: *LookupChunk) -> u32 {
    return 1 << self.p2Align;
}

fn LookupChunk::setAlignment(self, align: u32) {
    align = if align {} else { 1 };
    assert!(isPowerOf2_32(align), "alignment is not a power of 2");
    self.p2Align = Log2_32(align);
    assert!(self.p2Align <= Log2MaxSectionAlignment, "impossible requested alignment");
}

fn LookupChunk::getRVA(self: *LookupChunk) -> u32 {
    return self.rva;
}

fn LookupChunk::setRVA(self, v: u64) {
    self.rva = v as u32;
}

fn LookupChunk::setOutputSectionIdx(self, o: u16) {
    self.osidx = o;
}

fn LookupChunk::getOutputSectionIdx(self: *LookupChunk) -> u16 {
    return self.osidx;
}

fn LookupChunk::getOutputCharacteristics(self: *LookupChunk) -> u32 {
    return 0;
}

fn LookupChunk::getSectionName(self: *LookupChunk) -> str {
    llvm_unreachable_internal("unimplemented getSectionName", "lld\\COFF\\Chunks.h", 176);
}

fn LookupChunk::getBaserels(self, res: *mut []Baserel) {}

fn LookupChunk::getMachine(self: *LookupChunk) -> MachineTypes {
    return IMAGE_FILE_MACHINE_UNKNOWN;
}

fn LookupChunk::getDebugName(self: *LookupChunk) -> str {
