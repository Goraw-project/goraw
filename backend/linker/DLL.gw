    return self.ctx.config.wordsize;
}

fn DelayAddressChunk::writeTo(self: *DelayAddressChunk, buf: *mut u8) {
    if self.ctx.config.is64() {
        write64le(buf, self.thunk.getRVA() + self.ctx.config.imageBase);
    } else {
        let mut bit: u32 = 0;
        if self.ctx.config.machine == ARMNT {
            bit = 1;
        }
        write32le(buf, (self.thunk.getRVA() + self.ctx.config.imageBase) | bit);
    }
}

