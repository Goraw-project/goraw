struct AuxImportChunk {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    file: *mut ImportFile,
}

fn AuxImportChunk::AuxImportChunk(self, file: *mut ImportFile) {
    self.setAlignment();
}

fn AuxImportChunk::getSize(self: *AuxImportChunk) -> u64 {
    return ;
}

fn AuxImportChunk::writeTo(self: *AuxImportChunk, buf: *mut u8) {
    let mut impchkVA: u64 = 0;
    if self.file.impchkThunk {
        impchkVA = self.file.impchkThunk.getRVA() + self.file.symtab.ctx.config.imageBase;
    }
    write64le(buf, impchkVA);
}

fn AuxImportChunk::getBaserels(self, res: *mut i32) {
    if self.file.impchkThunk {
        res()(self.rva, self.file.symtab.machine);
    }
}

fn AuxImportChunk::kind(self: *AuxImportChunk) -> Kind {
    return self.chunkKind;
}

fn AuxImportChunk::getAlignment(self: *AuxImportChunk) -> u32 {
    return 1 << self.p2Align;
}

