fn TailMergeChunkX64::writeTo(self: *TailMergeChunkX64, buf: *mut u8) {
    memcpy(buf, tailMergeX64, (tailMergeX64));
    write32le(buf + 54, self.desc.getRVA() - self.rva - 58);
    write32le(buf + 59, self.helper.getRVA() - self.rva - 63);
}

