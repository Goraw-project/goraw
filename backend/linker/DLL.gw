struct OrdinalOnlyChunk {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    ordinal: u16,
    ctx: *mut COFFLinkerContext,
}

fn OrdinalOnlyChunk::OrdinalOnlyChunk(self, c: *mut COFFLinkerContext, v: u16) {
    self.setAlignment(self.ctx.config.wordsize);
}

fn OrdinalOnlyChunk::getSize(self: *OrdinalOnlyChunk) -> u64 {
    return self.ctx.config.wordsize;
}

fn OrdinalOnlyChunk::writeTo(self: *OrdinalOnlyChunk, buf: *mut u8) {
    if self.ctx.config.is64() {
        write64le(buf, (1 << 63) | self.ordinal);
    } else {
        write32le(buf, (1 << 31) | self.ordinal);
    }
}

fn OrdinalOnlyChunk::kind(self: *OrdinalOnlyChunk) -> Kind {
    return self.chunkKind;
}

fn OrdinalOnlyChunk::getAlignment(self: *OrdinalOnlyChunk) -> u32 {
    return 1 << self.p2Align;
}

fn OrdinalOnlyChunk::setAlignment(self, align: u32) {
    align = if align {} else { 1 };
    assert!(isPowerOf2_32(align), "alignment is not a power of 2");
    self.p2Align = Log2_32(align);
    assert!(self.p2Align <= Log2MaxSectionAlignment, "impossible requested alignment");
}

fn OrdinalOnlyChunk::getRVA(self: *OrdinalOnlyChunk) -> u32 {
    return self.rva;
}

fn OrdinalOnlyChunk::setRVA(self, v: u64) {
    self.rva = v as u32;
}

fn OrdinalOnlyChunk::setOutputSectionIdx(self, o: u16) {
    self.osidx = o;
}

fn OrdinalOnlyChunk::getOutputSectionIdx(self: *OrdinalOnlyChunk) -> u16 {
    return self.osidx;
}

fn OrdinalOnlyChunk::getOutputCharacteristics(self: *OrdinalOnlyChunk) -> u32 {
    return 0;
}

fn OrdinalOnlyChunk::getSectionName(self: *OrdinalOnlyChunk) -> str {
    llvm_unreachable_internal("unimplemented getSectionName", "lld\\COFF\\Chunks.h", 176);
}

