struct ThunkChunkX64 {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    imp: *mut Defined,
    tailMerge: *mut Chunk,
}

fn ThunkChunkX64::getSize(self: *ThunkChunkX64) -> u64 {
    return (thunkX64);
}

fn ThunkChunkX64::getMachine(self: *ThunkChunkX64) -> MachineTypes {
    return AMD64;
}

fn ThunkChunkX64::writeTo(self: *ThunkChunkX64, buf: *mut u8) {
    memcpy(buf, thunkX64, (thunkX64));
    write32le(buf + 3, self.imp.getRVA() - self.rva - 7);
    write32le(buf + 8, self.tailMerge.getRVA() - self.rva - 12);
}

fn ThunkChunkX64::kind(self: *ThunkChunkX64) -> Kind {
    return self.chunkKind;
}

fn ThunkChunkX64::getAlignment(self: *ThunkChunkX64) -> u32 {
    return 1 << self.p2Align;
}

fn ThunkChunkX64::setAlignment(self, align: u32) {
    align = if align {} else { 1 };
    assert!(isPowerOf2_32(align), "alignment is not a power of 2");
    self.p2Align = Log2_32(align);
    assert!(self.p2Align <= Log2MaxSectionAlignment, "impossible requested alignment");
}

