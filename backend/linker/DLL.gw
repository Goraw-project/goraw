struct DelayDirectoryChunk {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    dllName: *mut Chunk,
    moduleHandle: *mut Chunk,
    addressTab: *mut Chunk,
    nameTab: *mut Chunk,
}

fn DelayDirectoryChunk::DelayDirectoryChunk(self, n: *mut Chunk) {
    self.setAlignment(4);
}

fn DelayDirectoryChunk::getSize(self: *DelayDirectoryChunk) -> u64 {
    return ;
}

fn DelayDirectoryChunk::writeTo(self: *DelayDirectoryChunk, buf: *mut u8) {
    memset(buf, 0, self.getSize());
    let mut e: *mut delay_import_directory_table_entry = (buf) as *mut delay_import_directory_table_entry;
    e.Attributes = 1;
    e.Name = self.dllName.getRVA();
    e.ModuleHandle = self.moduleHandle.getRVA();
    e.DelayImportAddressTable = self.addressTab.getRVA();
    e.DelayImportNameTable = self.nameTab.getRVA();
}

fn DelayDirectoryChunk::kind(self: *DelayDirectoryChunk) -> Kind {
    return self.chunkKind;
}

fn DelayDirectoryChunk::getAlignment(self: *DelayDirectoryChunk) -> u32 {
