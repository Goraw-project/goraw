struct ImportDirectoryChunk {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    dllName: *mut Chunk,
    lookupTab: *mut Chunk,
    addressTab: *mut Chunk,
}

fn ImportDirectoryChunk::ImportDirectoryChunk(self, n: *mut Chunk) {
    self.setAlignment(4);
}

fn ImportDirectoryChunk::getSize(self: *ImportDirectoryChunk) -> u64 {
    return ;
}

fn ImportDirectoryChunk::writeTo(self: *ImportDirectoryChunk, buf: *mut u8) {
    memset(buf, 0, self.getSize());
    let mut e: *mut coff_import_directory_table_entry = (buf) as *mut coff_import_directory_table_entry;
    e.ImportLookupTableRVA = self.lookupTab.getRVA();
    e.NameRVA = self.dllName.getRVA();
    e.ImportAddressTableRVA = self.addressTab.getRVA();
}

fn ImportDirectoryChunk::kind(self: *ImportDirectoryChunk) -> Kind {
    return self.chunkKind;
}

fn ImportDirectoryChunk::getAlignment(self: *ImportDirectoryChunk) -> u32 {
    return 1 << self.p2Align;
}

