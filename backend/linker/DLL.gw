fn ExportDirectoryChunk::writeTo(self: *ExportDirectoryChunk, buf: *mut u8) {
    memset(buf, 0, self.getSize());
    let mut e: *mut export_directory_table_entry = (buf) as *mut export_directory_table_entry;
    e.NameRVA = self.dllName.getRVA();
    e.OrdinalBase = self.baseOrdinal;
    e.AddressTableEntries = (self.maxOrdinal - self.baseOrdinal) + 1;
    e.NumberOfNamePointers = self.nameTabSize;
    e.ExportAddressTableRVA = self.addressTab.getRVA();
    e.NamePointerRVA = self.nameTab.getRVA();
    e.OrdinalTableRVA = self.ordinalTab.getRVA();
}

