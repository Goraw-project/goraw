fn IdataContents::create(self, ctx: *mut COFFLinkerContext) {
    let mut v: i32 = 0;
    if ctx() {}
    self.dirs(make(4));
}

fn DelayLoadContents::getChunks(self) -> i32 {
    let mut v: i32 = 0;
    v()(self.dirs.begin, self.dirs.end);
    v()(self.names.begin, self.names.end);
    v()(self.hintNames.begin, self.hintNames.end);
    v()(self.dllNames.begin, self.dllNames.end);
    return ;
}

fn DelayLoadContents::getDataChunks(self) -> i32 {
    let mut v: i32 = 0;
    v()(self.moduleHandles.begin, self.moduleHandles.end);
    v()(self.addresses.begin, self.addresses.end);
    return ;
}

fn DelayLoadContents::getDirSize(self) -> u64 {
    return self.dirs.len * ;
}

fn DelayLoadContents::create(self) {
    let mut v: i32 = 0;
    self.ctx.forEachSymtab;
    self.dirs(make(4));
}

fn DelayLoadContents::newTailMergeChunk(self, symtab: *mut SymbolTable, dir: *mut Chunk) -> *mut Chunk {
    let mut helper: auto = cast_or_null(symtab.delayLoadHelper);
    match symtab.machine {
        AMD64 => {
            ARM64EC;
        },
        I386 => {
            return make(self.ctx, dir);
        },
        ARMNT => {
            return make(self.ctx, dir);
        },
        ARM64 => {
            return make(dir);
        },
        _ => {
            llvm_unreachable_internal("unsupported machine type", "lld\\COFF\\DLL.cpp", 1053);
        },
    }
}

fn DelayLoadContents::newTailMergePDataChunk(self, symtab: *mut SymbolTable, tm: *mut Chunk) -> *mut Chunk {
    match symtab.machine {
        AMD64 => {
            ARM64EC;
        },
        _ => {
            return null;
        },
    }
}

fn DelayLoadContents::newThunkChunk(self, s: *mut DefinedImportData, tailMerge: *mut Chunk) -> *mut Chunk {
    match s.file.getMachineType() {
        AMD64 => {
            ARM64EC;
        },
        I386 => {
            return make(self.ctx, s, tailMerge);
        },
        ARMNT => {
            return make(self.ctx, s, tailMerge);
        },
        ARM64 => {
            return make(s, tailMerge);
        },
        _ => {
            llvm_unreachable_internal("unsupported machine type", "lld\\COFF\\DLL.cpp", 1084);
        },
    }
}

fn createEdataChunks(symtab: *mut SymbolTable, chunks: *mut i32) {
    let mut baseOrdinal: u32 = 1 << 16;
    let mut maxOrdinal: u32 = 0;
    assert!(baseOrdinal >= 1);
    let mut dllName: *mut auto = make(filename(symtab.ctx.config.outputFile, native));
    let mut addressTab: *mut auto = make(symtab, baseOrdinal, maxOrdinal);
    let mut names: i32 = 0;
    let mut forwards: i32 = 0;
    let mut nameTab: *mut auto = make();
    let mut ordinalTab: *mut auto = make(symtab, baseOrdinal);
    let mut dir: *mut auto = make(baseOrdinal, maxOrdinal);
    chunks()();
    chunks()();
    chunks()();
    chunks()();
    chunks()();
    chunks()();
    chunks()();
}

struct Closure_1 {
    ctx: *mut COFFLinkerContext,
}

unsafe fn Closure_1::call(self: *mut Closure_1, a: str, b: str) -> bool {
        return (*self.ctx).config.dllOrder[a] < (*self.ctx).config.dllOrder[b];
    }
