fn createAddBufferFn(files: *mut []unique_ptr<MemoryBuffer>, filenames: *mut []str) -> AddBufferFn {
    return Closure_1 { files: &mut files, filenames: &mut filenames };
}

fn BitcodeCompiler::getThinLTOOutputFile(self, path: str) -> str {
    return getThinLTOOutputFile(path, self.ctx.config.thinLTOPrefixReplaceOld, self.ctx.config.thinLTOPrefixReplaceNew);
}

fn BitcodeCompiler::createConfig(self) -> Config {
    let mut c: Config = Config {};
    c.Options = initTargetOptionsFromCodeGenFlags();
    c.Options.EmitAddrsig = true;
    for C in self.ctx.config.mllvmOpts {
        c.MllvmArgs.push(C);
    }
    c.Options.FunctionSections = true;
    c.Options.DataSections = true;
    if self.ctx.config.machine == IMAGE_FILE_MACHINE_I386 {
        c.RelocModel = Static;
    } else {
        c.RelocModel = PIC_;
    }
    c.DisableVerify = false;
    c.DiagHandler = diagnosticHandler;
    c.DwoDir = self.ctx.config.dwoDir;
    c.OptLevel = self.ctx.config.ltoo;
    c.CPU = getCPUStr();
    c.MAttrs = getMAttrs();
    let mut optLevelOrNone: optional<CodeGenOptLevel> = getLevel(self.ctx.config.ltoCgo.value_or(getCGOptLevel(self.ctx.config.ltoo)));
    assert!(optLevelOrNone, "Invalid optimization level!");
    c.CGOptLevel = operator(optLevelOrNone);
    c.AlwaysEmitRegularLTOObj = !self.ctx.config.ltoObjPath.is_empty();
    c.DebugPassManager = self.ctx.config.ltoDebugPassManager;
    c.CSIRProfile = self.ctx.config.ltoCSProfileFile[0..allocator<char> {}];
    c.RunCSIRInstr = self.ctx.config.ltoCSProfileGenerate;
    c.PGOWarnMismatch = self.ctx.config.ltoPGOWarnMismatch;
    c.SampleProfile = self.ctx.config.ltoSampleProfileName;
    c.TimeTraceEnabled = self.ctx.config.timeTraceEnabled;
    c.TimeTraceGranularity = self.ctx.config.timeTraceGranularity;
    c.RemarksFilename = self.ctx.config.optRemarksFilename;
    c.RemarksPasses = self.ctx.config.optRemarksPasses;
    c.RemarksWithHotness = self.ctx.config.optRemarksWithHotness;
    c.RemarksHotnessThreshold = self.ctx.config.optRemarksHotnessThreshold;
    c.RemarksFormat = self.ctx.config.optRemarksFormat;
    if self.ctx.config.emit == LLVM {
        c.PreCodeGenModuleHook = Closure_2 { cap_0: self };
    } else if self.ctx.config.emit == ASM {
        c.CGFileType = AssemblyFile;
        c.Options.MCOptions.AsmVerbose = true;
    }
    if !self.ctx.config.saveTempsArgs.is_empty() {
        checkError(c.addSaveTemps(self.ctx.config.outputFile + ".", true, self.ctx.config.saveTempsArgs));
    }
    c.PTO.LoopVectorization = c.OptLevel > 1;
    c.PTO.SLPVectorization = c.OptLevel > 1;
    return c;
}

fn BitcodeCompiler::BitcodeCompiler(self, c: *mut COFFLinkerContext) {
    if !self.ctx.config.thinLTOIndexOnlyArg.is_empty() {
        self.indexFile = openFile(self.ctx.config.thinLTOIndexOnlyArg);
    }
    let mut backend: ThinBackend = ThinBackend {};
    if self.ctx.config.thinLTOIndexOnly {
        let mut OnIndexWrite: Closure_3 = Closure_3 { cap_0: self };
        backend = createWriteIndexesThinBackend(hardware_concurrency(self.ctx.config.thinLTOJobs), self.ctx.config.thinLTOPrefixReplaceOld[0..allocator<char> {}], self.ctx.config.thinLTOPrefixReplaceNew[0..allocator<char> {}], self.ctx.config.thinLTOPrefixReplaceNativeObject[0..allocator<char> {}], self.ctx.config.thinLTOEmitImportsFiles, self.indexFile.get(), OnIndexWrite);
    } else {
        backend = createInProcessThinBackend(heavyweight_hardware_concurrency(self.ctx.config.thinLTOJobs), null, false, false);
    }
    if self.ctx.config.dtltoDistributor.is_empty() {
        self.ltoObj = make_unique(self.createConfig(), backend, self.ctx.config.ltoPartitions);
    } else {
        self.ltoObj = make_unique(self.createConfig(), self.ctx.config.ltoPartitions, LTOK_Default, null, self.ctx.config.thinLTOEmitImportsFiles, self.ctx.config.thinLTOIndexOnly, self.ctx.config.outputFile, self.ctx.config.dtltoDistributor, self.ctx.config.dtltoDistributorArgs, self.ctx.config.dtltoCompiler, self.ctx.config.dtltoCompilerPrependArgs, self.ctx.config.dtltoCompilerArgs, createAddBufferFn(self.files, self.file_names), !self.ctx.config.saveTempsArgs.is_empty());
    }
}

fn BitcodeCompiler::~BitcodeCompiler(self) {}

fn BitcodeCompiler::waitForLTOCleanup(self) {
    if self.ltoObj {
        operator(self.ltoObj).waitForCleanup();
    }
}

fn undefine(s: *mut Symbol) {
    replaceSymbol(s, s.getName());
}

fn BitcodeCompiler::add(self, f: *mut BitcodeFile) {
    let mut obj: *mut InputFile = operator(f.obj);
    let mut symNum: u32 = 0;
    let mut symBodies: []*mut Symbol = f.getSymbols().operator vector();
    let mut resols: []SymbolResolution = []SymbolResolution { symBodies.len, SymbolResolution> {} };
    if self.ctx.config.thinLTOIndexOnly {
        self.thinIndices.insert(obj.getName());
    }
    for objSym in obj.symbols() {
        let mut sym: *mut Symbol = symBodies[symNum];
        let mut r: *mut SymbolResolution = resols[symNum];
        symNum += 1;
        r.Prevailing = !objSym.isUndefined() && sym.getFile() == &mut f;
        r.VisibleToRegularObj = sym.isUsedInRegularObj;
        if r.Prevailing {
            undefine(sym);
        }
        r.LinkerRedefined = !sym.canInline;
    }
    checkError(operator(self.ltoObj).add(move(f.obj), resols));
}

fn BitcodeCompiler::compile(self) -> []*mut InputFile {
    let mut timeScope: TimeTraceScope = "Bitcode compile";
    let mut maxTasks: u32 = operator(self.ltoObj).getMaxTasks();
    self.buf.resize(maxTasks);
    self.files.resize(maxTasks);
    self.file_names.resize(maxTasks);
    let mut cache: FileCache = FileCache {};
    if !self.ctx.config.ltoCache.is_empty() {
        cache = check(localCache("ThinLTO", "Thin", self.ctx.config.ltoCache, createAddBufferFn(self.files, self.file_names), !self.ctx.config.dtltoDistributor.is_empty()));
    }
    checkError(operator(self.ltoObj).run(Closure_4 { cap_0: self }, cache));
    for s in self.thinIndices {
        let mut path: str = self.getThinLTOOutputFile(s);
        openFile(path + ".thinlto.bc");
        if self.ctx.config.thinLTOEmitImportsFiles {
            openFile(path + ".imports");
        }
    }
    if self.ctx.config.thinLTOIndexOnly {
        if !self.ctx.config.ltoObjPath.is_empty() {
            saveBuffer(self.buf[0].second.operator StringRef(), self.ctx.config.ltoObjPath);
        }
        if self.indexFile {
            operator(self.indexFile).close();
        }
        return []*mut InputFile {};
    }
    if !self.ctx.config.ltoCache.is_empty() {
        check(pruneCache(self.ctx.config.ltoCache, self.ctx.config.ltoCachePolicy, self.files));
    }
    let mut ret: []*mut InputFile = []*mut InputFile {};
    let mut emitASM: bool = self.ctx.config.emit == ASM;
    let mut Ext: *u8 = if emitASM { ".s" } else { ".obj" };
    for let mut i: u32 = 0; i != maxTasks; i += 1 {
        let mut bitcodeFilePath: str = "";
        let mut objBuf: str = "";
        if self.files[i] {
            objBuf = operator(self.files[i]).getBuffer();
            bitcodeFilePath = self.file_names[i];
        } else {
            objBuf = self.buf[i].second.operator StringRef();
            bitcodeFilePath = self.buf[i].first;
        }
        if objBuf.is_empty() {
            continue;
        }
        let mut ltoObjName: str = "";
        if bitcodeFilePath == "ld-temp.o" {
            ltoObjName = saver().save(self.ctx.config.outputFile + ".lto" + (if i == 0 { "" } else { '.' + i }) + Ext);
        } else {
            let mut directory: str = parent_path(bitcodeFilePath, native);
            let mut baseName: str = stem(bitcodeFilePath, native);
            let mut outputFileBaseName: str = filename(self.ctx.config.outputFile, native);
            let mut path: str = "";
            append(path, directory, outputFileBaseName + ".lto." + baseName + Ext, "", "");
            remove_dots(path, true, native);
            ltoObjName = saver().save(path);
        }
        if is_contained(self.ctx.config.saveTempsArgs, "prelink") || emitASM {
            saveBuffer(self.buf[i].second.operator StringRef(), ltoObjName);
        }
        if !emitASM {
            ret.push(create(self.ctx, MemoryBufferRef { Buffer: objBuf, Identifier: ltoObjName }, false));
        }
    }
    return ret;
}

fn BitcodeCompiler::setBitcodeLibFuncs(self, bitcodeLibFuncs: ArrayRef<StringRef>) {
    operator(self.ltoObj).setBitcodeLibFuncs(bitcodeLibFuncs);
}

struct Closure_1 {
    files: *mut []unique_ptr<MemoryBuffer>,
    filenames: *mut []str,
}

unsafe fn Closure_1::call(self: *mut Closure_1, task: u32, moduleName: str, mb: unique_ptr<MemoryBuffer>) {
        (*self.files)[task] = move(mb);
        (*self.filenames)[task] = moduleName;
    }

struct Closure_2 {
    cap_0: *mut BitcodeCompiler,
}

fn Closure_2::call(self: *Closure_2, task: u64, m: *Module) -> bool {
            if openLTOOutputFile(self.ctx.config.outputFile) {
                os;
            } else {
                WriteBitcodeToFile(m, operator(os), false, null, false, null);
            }
            return false;
        }

struct Closure_3 {
    cap_0: *mut BitcodeCompiler,
}

fn Closure_3::call(self: *Closure_3, S: str) {
            self.thinIndices.erase(S);
        }

struct Closure_4 {
    cap_0: *mut BitcodeCompiler,
}

fn Closure_4::call(self: *Closure_4, task: u64, moduleName: str) -> CachedFileStream> {
        self.buf[task].first = moduleName;
        return make_unique(make_unique(self.buf[task].second));
    }
