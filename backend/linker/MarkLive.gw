fn markLive(ctx: *mut COFFLinkerContext) {
    let mut timeScope: TimeTraceScope = TimeTraceScope { Entry: "Mark live" };
    let mut t: ScopedTimer = ctx();
    let mut worklist: SmallVector<SectionChunk *, 256> = zeroed();
    let mut enqueue: Closure_1 = Closure_1 {};
    let mut addSym: function<void (Symbol *)> = zeroed();
    let mut addImportFile: Closure_2 = Closure_2 {};
    addSym() = Closure_3 { enqueue: &mut enqueue, addImportFile: &mut addImportFile };
    while !() {
        let mut sc: *mut SectionChunk = ();
        assert!(sc.live, "We mark as live when pushing onto the worklist!");
        if sc.getEntryThunk() {
            entryThunk;
        } else {
            addSym()(entryThunk);
        }
    }
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, c: *mut SectionChunk) {
        if c.live {
            return;
        }
        c.live = true;
        worklist()(c);
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, file: *mut ImportFile) {
        file.live = true;
        if file.impchkThunk && file.impchkThunk.exitThunk {
            addSym()(file.impchkThunk.exitThunk);
        }
    }

