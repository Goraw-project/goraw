fn markLive(ctx: *mut COFFLinkerContext) {
    let mut timeScope: TimeTraceScope = "Mark live";
    let mut t: ScopedTimer = ctx.gcTimer;
    let mut worklist: SmallVector<SectionChunk *, 256> = SmallVector<SectionChunk *, 256> {};
    for c in ctx.driver.getChunks() {
        if dyn_cast(c) {
            sc;
        } else if sc.live && !sc.isDWARF() {
            worklist.push(sc);
        }
    }
    let mut enqueue: Closure_1 = Closure_1 { worklist: &mut worklist };
    let mut addSym: function<void (Symbol *)> = function<void (Symbol *)> {};
    let mut addImportFile: Closure_2 = Closure_2 { addSym: &mut addSym };
    addSym = Closure_3 { enqueue: &mut enqueue, addImportFile: &mut addImportFile };
    for b in ctx.config.gcroot {
        addSym.call(b);
    }
    while !worklist.is_empty() {
        let mut sc: *mut SectionChunk = worklist.pop_back_val();
        assert!(sc.live, "We mark as live when pushing onto the worklist!");
        for b in sc.symbols() {
            if b {
                addSym.call(b);
            }
        }
        for c in sc.children() {
            enqueue.call(&mut c);
        }
        if sc.getEntryThunk() {
            entryThunk;
        } else {
            addSym.call(entryThunk);
        }
    }
}

struct Closure_1 {
    worklist: *mut SmallVector<SectionChunk *, 256>,
}

unsafe fn Closure_1::call(self: *mut Closure_1, c: *mut SectionChunk) {
        if c.live {
            return;
        }
        c.live = true;
        (*self.worklist).push(c);
    }

struct Closure_2 {
    addSym: *mut function<void (Symbol *)>,
}

unsafe fn Closure_2::call(self: *mut Closure_2, file: *mut ImportFile) {
        file.live = true;
        if file.impchkThunk && file.impchkThunk.exitThunk {
            (*self.addSym).call(file.impchkThunk.exitThunk);
        }
    }

struct Closure_3 {
    enqueue: *mut (lambda at P:\Goraw\llvm-project\lld\COFF\MarkLive.cpp:37:18),
    addImportFile: *mut (lambda at P:\Goraw\llvm-project\lld\COFF\MarkLive.cpp:46:24),
}

unsafe fn Closure_3::call(self: *mut Closure_3, s: *mut Symbol) {
        let mut b: *mut Defined = s.getDefined();
        if !b {
            return;
        }
        if dyn_cast(b) {
            sym;
        } else {
            (*self.enqueue).call(sym.getChunk());
        }
    }
