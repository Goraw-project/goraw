const indent8: [9]i8 = "        ";

const indent16: [17]i8 = "                ";

fn writeHeader(os: *mut raw_ostream, addr: u64, size: u64, align: u64) {
    os << format("%08llx %08llx %5lld ", addr, size, align);
}

fn getSymbols(ctx: *COFFLinkerContext) -> []*mut DefinedRegular {
    let mut v: []*mut DefinedRegular = []*mut DefinedRegular {};
    for file in ctx.objFileInstances {
        for b in file.getSymbols() {
            if dyn_cast_or_null(b) {
                sym;
            } else if sym && !sym.getCOFFSymbol().isSectionDefinition() {
                v.push(sym);
            }
        }
    }
    return v;
}

fn getSectionSyms(syms: ArrayRef<DefinedRegular *>) -> SymbolMapTy {
    let mut ret: SymbolMapTy = SymbolMapTy {};
    for s in syms {
        ret[s.getChunk()].push(s);
    }
    for it in ret {
        let mut v: *mut SmallVectorImpl<DefinedRegular *> = it.second;
        stable_sort(v, Closure_1 {});
    }
    return ret;
}

fn getSymbolStrings(ctx: *COFFLinkerContext, syms: ArrayRef<DefinedRegular *>) -> string> {
    let mut str: []str = []str { syms.len, basic_string<char>> {} };
    parallelFor(0 as u64, syms.len, function_ref<void (size_t)> { Closure_2 { str: &mut str, syms: &mut syms, ctx: &mut ctx }, null, null });
    let mut ret: string> = string> {};
    for let mut i: u64 = 0;
let mut e: u64 = syms.len; i < e; i += 1 {
        ret[syms[i]] = move(str[i]);
    }
    return ret;
}

fn writeLLDMapFile(ctx: *COFFLinkerContext) {
    if ctx.config.lldmapFile.is_empty() {
        return;
    }
    let mut timeScope: TimeTraceScope = ".lldmap file";
    let mut ec: error_code = error_code {};
    let mut os: raw_fd_ostream = raw_fd_ostream { ctx.config.lldmapFile, ec, OF_None };
    if ec {
        fatal("cannot open " + ctx.config.lldmapFile + ": " + ec.message());
    }
    let mut syms: []*mut DefinedRegular = getSymbols(ctx);
    let mut sectionSyms: SymbolMapTy = getSectionSyms(syms);
    let mut symStr: string> = getSymbolStrings(ctx, syms);
    os << "Address  Size     Align Out     In      Symbol\n";
    for sec in ctx.outputSections {
        writeHeader(os, sec.getRVA(), sec.getVirtualSize(), pageSize);
        os << sec.name << 10;
        for c in sec.chunks {
            let mut sc: *mut SectionChunk = dyn_cast(c);
            if !sc {
                continue;
            }
            writeHeader(os, sc.getRVA(), sc.getSize(), sc.getAlignment());
            os << indent8 << sc.file.getName() << ":(" << sc.getSectionName() << ")\n";
            for sym in sectionSyms[sc] {
                os << symStr[sym] << 10;
            }
        }
    }
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, a: *mut DefinedRegular, b: *mut DefinedRegular) -> bool {
            return a.getRVA() < b.getRVA();
        }

struct Closure_2 {
    str: *mut []str,
    syms: *mut ArrayRef<DefinedRegular *>,
    ctx: *mut COFFLinkerContext,
}

unsafe fn Closure_2::call(self: *mut Closure_2, i: u64) {
        let mut os: raw_string_ostream = (*self.str)[i];
        writeHeader(os, (*self.syms)[i].getRVA(), 0, 0);
        os << indent16 << toString((*self.ctx), *(*self.syms)[i]);
    }
