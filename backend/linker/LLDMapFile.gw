const indent8: [9]i8 = "        ";

const indent16: [17]i8 = "                ";

fn writeHeader(os: *mut raw_ostream, addr: u64, size: u64, align: u64) {
    os << format("%08llx %08llx %5lld ", addr, size, align);
}

fn getSymbols(ctx: *COFFLinkerContext) -> i32 {
    let mut v: i32 = 0;
    return ;
}

fn getSectionSyms(syms: ArrayRef<DefinedRegular *>) -> i32 {
    let mut ret: i32 = 0;
    return ;
}

fn getSymbolStrings(ctx: *COFFLinkerContext, syms: ArrayRef<DefinedRegular *>) -> i32 {
    let mut str: i32 = syms()();
    parallelFor(0 as u64, Closure_1 { ctx: &mut ctx });
    let mut ret: i32 = 0;
    for let mut i: u64 = 0;
let mut e: u64 = (); i < e; i += 1 {
        ret()[[i]] = move([i]);
    }
    return ;
}

fn writeLLDMapFile(ctx: *COFFLinkerContext) {
    if ctx.config.lldmapFile.len == 0 {
        return;
    }
    let mut timeScope: TimeTraceScope = TimeTraceScope { Entry: ".lldmap file" };
    let mut ec: error_code = error_code {};
    let mut os: raw_fd_ostream = raw_fd_ostream { ctx.config.lldmapFile, ec, OF_None };
    if ec {
        fatal("cannot open " + ctx.config.lldmapFile + ": " + ec.message());
    }
    let mut syms: i32 = 0;
    let mut sectionSyms: i32 = 0;
    let mut symStr: i32 = 0;
    os << "Address  Size     Align Out     In      Symbol\n";
}

struct Closure_1 {
    ctx: *mut COFFLinkerContext,
}

unsafe fn Closure_1::call(self: *mut Closure_1, i: u64) {
        let mut os: raw_string_ostream = str()[i];
        writeHeader(os, [i](), 0, 0);
        os << indent16 << toString((*self.ctx), operator*([i]));
    }
