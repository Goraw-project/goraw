// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;
extern fn memset(dest: *mut u8, c: i32, n: u64) -> *mut u8;

fn getBasename(path: str) -> str {
    return filename(path, windows);
}

fn toString(file: *InputFile) -> str {
    if !file {
        return "<internal>";
    }
    if file.parentName.is_empty() {
        return file.getName()[0..allocator<char> {}];
    }
    return (getBasename(file.parentName) + "(" + getBasename(file.getName()) + ")");
}

fn op_<<(s: *COFFSyncStream, f: *InputFile) -> *COFFSyncStream {
    return s << toString(f);
}

fn checkAndSetWeakAlias(symtab: *mut SymbolTable, f: *mut InputFile, source: *mut Symbol, target: *mut Symbol, isAntiDep: bool) {
    if dyn_cast(source) {
        u;
    } else {
        if u.weakAlias && u.weakAlias != target {
            if isAntiDep {
                return;
            }
            if !u.isAntiDep {
                if symtab.ctx.config.allowDuplicateWeak {
                    let mut isAbsZero: Closure_1 = Closure_1 {};
                    if isAbsZero.call(u.weakAlias) && !isAbsZero.call(target) {
                        u.setWeakAlias(target, isAntiDep);
                    }
                    return;
                }
                symtab.reportDuplicate(source, f, null, 0);
            }
        }
        u.setWeakAlias(target, isAntiDep);
    }
}

fn ignoredSymbolName(name: str) -> bool {
    return name == "@feat.00" || name == "@comp.id";
}

fn cloneSymbol(sym: COFFSymbolRef) -> *mut coff_symbol_generic {
    if sym.isBigObj() {
        let mut copy: *mut little, 1>> = make(*sym.getRawPtr() as *coff_symbol32);
        return copy as *mut coff_symbol_generic;
    } else {
        let mut copy: *mut little, 1>> = make(*sym.getRawPtr() as *coff_symbol16);
        return copy as *mut coff_symbol_generic;
    }
}

fn fixupDllMain(ctx: *mut COFFLinkerContext, file: *mut Archive, sym: *Symbol, skipDllMain: *mut bool) -> bool {
    let mut c: *Child = check2((sym.getMember()), string ()> { Closure_2 { file: &mut file, ctx: &mut ctx, sym: &mut sym }, null, null });
    let mut mb: MemoryBufferRef = check2((c.getMemoryBufferRef()), string ()> { Closure_3 { file: &mut file }, null, null });
    if identify_magic(mb.getBuffer()).operator llvm::file_magic::Impl() == coff_import_library {
        if ctx.config.warnImportedDllMain {
            Warn(ctx) << file.getFileName() << ": skipping imported DllMain symbol [importeddllmain]\nNOTE: this might be a mistake when the DLL/library was produced.";
        }
        skipDllMain = true;
        return true;
    }
    return false;
}

fn ArchiveFile::ArchiveFile(self, ctx: *mut COFFLinkerContext, m: MemoryBufferRef, f: *mut unique_ptr<Archive>) {
    self.file.swap(f);
}

fn ArchiveFile::parse(self) {
    let mut ctx: *mut COFFLinkerContext = self.symtab.ctx;
    let mut archiveSymtab: *mut SymbolTable = &mut self.symtab;
    if ctx.symtab.isEC() {
        let mut symbols: symbol_iterator> = check2((operator(self.file).ec_symbols()), string ()> { Closure_4 { cap_0: self }, null, null });
        if !symbols.is_empty() {
            for sym in symbols {
                ctx.symtab.addLazyArchive(self, sym);
            }
            archiveSymtab = &mut operator(ctx.hybridSymtab);
        } else {
            let mut sym: symbol_iterator = operator(self.file).symbol_begin();
            if sym != operator(self.file).symbol_end() {
                let mut machine: MachineTypes = IMAGE_FILE_MACHINE_UNKNOWN;
                let mut child: Child = check2((operator(sym).getMember()), string ()> { Closure_5 { cap_0: self }, null, null });
                let mut mb: MemoryBufferRef = check2((child.getMemoryBufferRef()), string ()> { Closure_6 { cap_0: self }, null, null });
                match identify_magic(mb.getBuffer()).operator llvm::file_magic::Impl() {
                    coff_object => {
                        let mut obj: unique_ptr<COFFObjectFile> = check2((create(mb)), string ()> { Closure_7 { child: &mut child }, null, null });
                        machine = operator(obj).getMachine();
                        break;
                    },
                    coff_import_library => {
                        machine = mb.getMachine();
                    },
                    bitcode => {
                        let mut obj: InputFile> = check(create(mb));
                        machine = getMachineType(obj.get());
                        break;
                    },
                    _ => {
                        break;
                    },
                }
                archiveSymtab = &mut ctx.getSymtab(machine);
            }
        }
    }
    let mut skipDllMain: bool = false;
    let mut mangledDllMain: str = "";
    let mut impMangledDllMain: str = "";
    if !operator(self.file).isEmpty() && ctx.config.machine != IMAGE_FILE_MACHINE_UNKNOWN {
        mangledDllMain = archiveSymtab.mangle("DllMain");
        impMangledDllMain = uniqueSaver().save("__imp_" + mangledDllMain);
    }
    for sym in operator(self.file).symbols() {
        if !mangledDllMain.is_empty() && (sym.getName() == mangledDllMain || sym.getName() == impMangledDllMain) {
            if skipDllMain || fixupDllMain(ctx, self.file.get(), sym, skipDllMain) {
                continue;
            }
        }
        archiveSymtab.addLazyArchive(self, sym);
    }
}

fn ArchiveFile::addMember(self, sym: *Symbol) {
    let mut c: *Child = check2((sym.getMember()), string ()> { Closure_8 { cap_0: self, sym: &mut sym }, null, null });
    if !self.seen.insert(c.getChildOffset()).second {
        return;
    }
    self.symtab.ctx.driver.enqueueArchiveMember(c, sym, self.getName());
}

fn getArchiveMembers(ctx: *mut COFFLinkerContext, file: *mut Archive) -> []MemoryBufferRef {
    let mut v: []MemoryBufferRef = []MemoryBufferRef {};
    let mut err: Error = success();
    let mut addToTar: bool = file.isThin() && ctx.driver.tar;
    for c in file.children(err, true) {
        let mut mbref: MemoryBufferRef = check2((c.getMemoryBufferRef()), string ()> { Closure_9 { file: &mut file }, null, null });
        if addToTar {
            operator(ctx.driver.tar).append(relativeToRoot(check(c.getFullName())), mbref.getBuffer());
        }
        v.push(mbref);
    }
    if err {
        Fatal(ctx) << file.getFileName() << ": Archive::children failed: " << toString(move(err));
    }
    return v;
}

fn ObjFile::createCOFFObject(self, ctx: *mut COFFLinkerContext, m: MemoryBufferRef) -> unique_ptr<COFFObjectFile> {
    let mut bin: unique_ptr<Binary>> = createBinary(m, null, true);
    if !bin {
        Fatal(ctx) << "Could not parse " << m.getBufferIdentifier();
    }
    let mut obj: unique_ptr<COFFObjectFile> = dyn_cast(operator(bin).release());
    if !obj.get() {
        Fatal(ctx) << m.getBufferIdentifier() << " is not a COFF file";
    }
    return obj;
}

fn ObjFile::create(self, ctx: *mut COFFLinkerContext, coffObj: *mut COFFObjectFile, lazy: bool) -> *mut ObjFile {
    return make(ctx.getSymtab(coffObj.getMachine()), coffObj, lazy);
}

fn ObjFile::parseLazy(self) {
    let mut numSymbols: u32 = operator(self.coffObj).getNumberOfSymbols();
    for let mut i: u32 = 0; i < numSymbols; i += 1 {
        let mut coffSym: COFFSymbolRef = check(operator(self.coffObj).getSymbol(i));
        if coffSym.isUndefined() || !coffSym.isExternal() || coffSym.isWeakExternal() {
            continue;
        }
        let mut name: str = check(operator(self.coffObj).getSymbolName(coffSym));
        if coffSym.isAbsolute() && ignoredSymbolName(name) {
            continue;
        }
        self.symtab.addLazyObject(self, name);
        if !self.lazy {
            return;
        }
        i += coffSym.getNumberOfAuxSymbols();
    }
}

struct ECMapEntry {
    src: ulittle32_t,
    dst: ulittle32_t,
    type: ulittle32_t,
}

fn ObjFile::initializeECThunks(self) {
    for chunk in self.hybmpChunks {
        if chunk.getContents().len %  {
            Err(self.symtab.ctx) << "Invalid .hybmp chunk size " << chunk.getContents().len;
            continue;
        }
        let mut end: *u8 = chunk.getContents().ptr + chunk.getContents().len;
        for let mut iter: *u8 = chunk.getContents().ptr; iter != end; iter +=  {
            let mut entry: *ECMapEntry = iter as *ECMapEntry;
            match entry.type.operator unsigned int() {
                Entry => {
                    self.symtab.addEntryThunk(self.getSymbol(entry.src.operator unsigned int()), self.getSymbol(entry.dst.operator unsigned int()));
                },
                Exit => {
                    self.symtab.addExitThunk(self.getSymbol(entry.src.operator unsigned int()), self.getSymbol(entry.dst.operator unsigned int()));
                },
                GuestExit => {
                    break;
                },
                _ => {
                    Warn(self.symtab.ctx) << "Ignoring unknown EC thunk type " << entry.type;
                },
            }
        }
    }
}

fn ObjFile::parse(self) {
    self.initializeChunks();
    self.initializeSymbols();
    self.initializeFlags();
    self.initializeDependencies();
    self.initializeECThunks();
}

fn ObjFile::getSection(self, i: u32) -> *coff_section {
    let mut sec: Expected<const coff_section *> = operator(self.coffObj).getSection(i);
    if !sec {
        Fatal(self.symtab.ctx) << "getSection failed: #" << i << ": " << sec.takeError();
    }
    return operator(sec);
}

static mut pendingComdat: SectionChunk *const = 1 as *mut SectionChunk;

fn ObjFile::initializeChunks(self) {
    let mut numSections: u32 = operator(self.coffObj).getNumberOfSections();
    self.sparseChunks.resize(numSections + 1);
    for let mut i: u32 = 1; i < numSections + 1; i += 1 {
        let mut sec: *coff_section = self.getSection(i);
        if sec.Characteristics.operator unsigned int() & IMAGE_SCN_LNK_COMDAT {
            self.sparseChunks[i] = pendingComdat;
        } else {
            self.sparseChunks[i] = self.readSection(i, null, "");
        }
    }
}

fn ObjFile::readSection(self, sectionNumber: u32, def: *coff_aux_section_definition, leaderName: str) -> *mut SectionChunk {
    let mut sec: *coff_section = self.getSection(sectionNumber);
    let mut name: str = "";
    if operator(self.coffObj).getSectionName(sec) {
        e;
    } else {
        name = operator(e);
    }
    if name == ".drectve" {
        let mut data: ArrayRef<uint8_t> = ArrayRef<uint8_t> {};
        cantFail(operator(self.coffObj).getSectionContents(sec, data), null);
        self.directives = data.ptr as *u8[0..data.len];
        return null;
    }
    if name == ".llvm_addrsig" {
        self.addrsigSec = sec;
        return null;
    }
    if name == ".llvm.call-graph-profile" {
        self.callgraphSec = sec;
        return null;
    }
    if self.symtab.ctx.config.discardSection.contains(name) {
        return null;
    }
    if !self.symtab.ctx.config.includeDwarfChunks && name.starts_with(".debug_") {
        return null;
    }
    if sec.Characteristics.operator unsigned int() & IMAGE_SCN_LNK_REMOVE {
        return null;
    }
    let mut c: *mut SectionChunk = null;
    if isArm64EC(self.getMachineType()) {
        c = make(self, sec);
    } else {
        c = make(self, sec);
    }
    if def {
        c.checksum = def.CheckSum.operator unsigned int();
    }
    if c.isCodeView() {
        self.debugChunks.push(c);
    } else if name == ".gfids$y" {
        self.guardFidChunks.push(c);
    } else if name == ".giats$y" {
        self.guardIATChunks.push(c);
    } else if name == ".gljmp$y" {
        self.guardLJmpChunks.push(c);
    } else if name == ".gehcont$y" {
        self.guardEHContChunks.push(c);
    } else if name == ".sxdata" {
        self.sxDataChunks.push(c);
    } else if isArm64EC(self.getMachineType()) && name == ".hybmp$x" {
        self.hybmpChunks.push(c);
    } else if self.symtab.ctx.config.tailMerge && sec.NumberOfRelocations.operator unsigned short() == 0 && name == ".rdata" && leaderName.starts_with("??_C@") {
        addSection(self.symtab.ctx, c);
    } else if name == ".rsrc" || name.starts_with(".rsrc$") {
        self.resourceChunks.push(c);
    } else if !(sec.Characteristics.operator unsigned int() & IMAGE_SCN_LNK_INFO) {
        self.chunks.push(c);
    }
    return c;
}

fn ObjFile::includeResourceChunks(self) {
    self.chunks.insert(self.chunks.end(), self.resourceChunks.begin(), self.resourceChunks.end());
}

fn ObjFile::readAssociativeDefinition(self, sym: COFFSymbolRef, def: *coff_aux_section_definition) {
    self.readAssociativeDefinition(sym, def, def.getNumber(sym.isBigObj()));
}

fn ObjFile::readAssociativeDefinition(self, sym: COFFSymbolRef, def: *coff_aux_section_definition, parentIndex: u32) {
    let mut parent: *mut SectionChunk = self.sparseChunks[parentIndex];
    let mut sectionNumber: i32 = sym.getSectionNumber();
    let mut diag: Closure_10 = Closure_10 { cap_0: self, sym: &mut sym, parentIndex: &mut parentIndex, sectionNumber: &mut sectionNumber };
    if parent == pendingComdat {
        diag.call();
        return;
    }
    if parent {
        let mut c: *mut SectionChunk = self.readSection(sectionNumber, def, "");
        self.sparseChunks[sectionNumber] = c;
        if c {
            c.selection = IMAGE_COMDAT_SELECT_ASSOCIATIVE;
            parent.addAssociative(c);
        }
    } else {
        self.sparseChunks[sectionNumber] = null;
    }
}

fn ObjFile::recordPrevailingSymbolForMingw(self, sym: COFFSymbolRef, prevailingSectionMap: *mut DenseMap<StringRef, uint32_t>) {
    let mut sectionNumber: i32 = sym.getSectionNumber();
    let mut sc: *mut SectionChunk = self.sparseChunks[sectionNumber];
    if sc && sc.getOutputCharacteristics() & IMAGE_SCN_MEM_EXECUTE {
        let mut name: str = sc.getSectionName().split('$').second;
        prevailingSectionMap[name] = sectionNumber;
    }
}

fn ObjFile::maybeAssociateSEHForMingw(self, sym: COFFSymbolRef, def: *coff_aux_section_definition, prevailingSectionMap: *DenseMap<StringRef, uint32_t>) {
    let mut name: str = check(operator(self.coffObj).getSymbolName(sym));
    if name.consume_front(".pdata$") || name.consume_front(".xdata$") || name.consume_front(".eh_frame$") {
        let mut parentSym: const_iterator = prevailingSectionMap.find(name);
        if parentSym != prevailingSectionMap.end() {
            self.readAssociativeDefinition(sym, def, operator(parentSym).second);
        }
    }
}

fn ObjFile::createRegular(self, sym: COFFSymbolRef) -> *mut Symbol {
    let mut sc: *mut SectionChunk = self.sparseChunks[sym.getSectionNumber()];
    if sym.isExternal() {
        let mut name: str = check(operator(self.coffObj).getSymbolName(sym));
        if sc {
            return self.symtab.addRegular(self, name, sym.getGeneric(), sc, sym.getValue(), false);
        }
        if self.symtab.ctx.config.mingw && name.starts_with(".weak.") {
            return null;
        }
        return self.symtab.addUndefined(name, self, false);
    }
    if sc {
        let mut symGen: *coff_symbol_generic = sym.getGeneric();
        if sym.isSection() {
            let mut customSymGen: *mut coff_symbol_generic = cloneSymbol(sym);
            customSymGen.Value = 0;
            symGen = customSymGen;
        }
        return make(self, "", false, false, symGen, sc);
    }
    return null;
}

fn ObjFile::initializeSymbols(self) {
    let mut numSymbols: u32 = operator(self.coffObj).getNumberOfSymbols();
    self.symbols.resize(numSymbols);
    let mut weakAliases: pair<Symbol *, const coff_aux_weak_external *>, 8> = pair<Symbol *, const coff_aux_weak_external *>, 8> {};
    let mut pendingIndexes: []u32 = []u32 {};
    pendingIndexes.reserve(numSymbols);
    let mut prevailingSectionMap: DenseMap<StringRef, uint32_t> = DenseMap<StringRef, uint32_t> {};
    let mut comdatDefs: []*coff_aux_section_definition = []*coff_aux_section_definition { operator(self.coffObj).getNumberOfSections() + 1, coff_aux_section_definition *> {} };
    let mut ctx: *mut COFFLinkerContext = self.symtab.ctx;
    for let mut i: u32 = 0; i < numSymbols; i += 1 {
        let mut coffSym: COFFSymbolRef = check(operator(self.coffObj).getSymbol(i));
        let mut prevailingComdat: bool = false;
        if coffSym.isUndefined() {
            self.symbols[i] = self.createUndefined(coffSym, false);
        } else if coffSym.isWeakExternal() {
            let mut aux: *coff_aux_weak_external = coffSym.getAux();
            let mut overrideLazy: bool = true;
            if isArm64EC(self.getMachineType()) && aux.Characteristics.operator unsigned int() == IMAGE_WEAK_EXTERN_ANTI_DEPENDENCY {
                let mut targetSym: COFFSymbolRef = check(operator(self.coffObj).getSymbol(aux.TagIndex.operator unsigned int()));
                if !targetSym.isAnyUndefined() {
                    let mut targetName: str = check(operator(self.coffObj).getSymbolName(targetSym));
                    let mut name: str = check(operator(self.coffObj).getSymbolName(coffSym));
                    let mut mangledName: string> = getArm64ECMangledFunctionName(name);
                    overrideLazy = mangledName == targetName;
                } else {
                    overrideLazy = false;
                }
            }
            self.symbols[i] = self.createUndefined(coffSym, overrideLazy);
            weakAliases.push(self.symbols[i], aux);
        } else if self.createDefined(coffSym, comdatDefs, prevailingComdat) {
            optSym;
        } else {
            self.symbols[i] = operator(optSym);
            if ctx.config.mingw && prevailingComdat {
                self.recordPrevailingSymbolForMingw(coffSym, prevailingSectionMap);
            }
        }
        i += coffSym.getNumberOfAuxSymbols();
    }
    for i in pendingIndexes {
        let mut sym: COFFSymbolRef = check(operator(self.coffObj).getSymbol(i));
        if sym.getSectionDefinition() {
            def;
        } else {
            if def.Selection == IMAGE_COMDAT_SELECT_ASSOCIATIVE {
                self.readAssociativeDefinition(sym, def);
            } else if ctx.config.mingw {
                self.maybeAssociateSEHForMingw(sym, def, prevailingSectionMap);
            }
        }
        if self.sparseChunks[sym.getSectionNumber()] == pendingComdat {
            let mut name: str = check(operator(self.coffObj).getSymbolName(sym));
            Log(ctx) << "comdat section " << name << " without leader and unassociated, discarding";
            continue;
        }
        self.symbols[i] = self.createRegular(sym);
    }
    for kv in weakAliases {
        let mut sym: *mut Symbol = kv.first;
        let mut aux: *coff_aux_weak_external = kv.second;
        checkAndSetWeakAlias(self.symtab, self, sym, self.symbols[aux.TagIndex.operator unsigned int()], aux.Characteristics.operator unsigned int() == IMAGE_WEAK_EXTERN_ANTI_DEPENDENCY);
    }
    decltype(this->sparseChunks) {}.swap(self.sparseChunks);
}

fn ObjFile::createUndefined(self, sym: COFFSymbolRef, overrideLazy: bool) -> *mut Symbol {
    let mut name: str = check(operator(self.coffObj).getSymbolName(sym));
    let mut s: *mut Symbol = self.symtab.addUndefined(name, self, overrideLazy);
    if self.symtab.isEC() && self.getMachineType() == AMD64 {
        let mut u: CastReturnType = dyn_cast(s);
        if u && !u.weakAlias {
            if getArm64ECMangledFunctionName(name) {
                mangledName;
            } else {
                let mut m: *mut Symbol = self.symtab.addUndefined(saver().save(operator(mangledName)), self, false);
                u.setWeakAlias(m, true);
            }
        }
    }
    return s;
}

fn findSectionDef(obj: *mut COFFObjectFile, section: i32) -> *coff_aux_section_definition {
    let mut numSymbols: u32 = obj.getNumberOfSymbols();
    for let mut i: u32 = 0; i < numSymbols; i += 1 {
        let mut sym: COFFSymbolRef = check(obj.getSymbol(i));
        if sym.getSectionNumber() != section {
            continue;
        }
        if sym.getSectionDefinition() {
            def;
        } else {
            return def;
        }
    }
    return null;
}

fn ObjFile::handleComdatSelection(self, sym: COFFSymbolRef, selection: *mut COMDATType, prevailing: *mut bool, leader: *mut DefinedRegular, def: *coff_aux_section_definition) {
    if prevailing {
        return;
    }
    let mut leaderChunk: *mut SectionChunk = leader.getChunk();
    let mut leaderSelection: COMDATType = leaderChunk.selection;
    let mut ctx: *mut COFFLinkerContext = self.symtab.ctx;
    assert!(leader.data, "Comdat leader without SectionChunk?");
    if isa(leader.file) {
        selection = leaderSelection = IMAGE_COMDAT_SELECT_ANY;
    }
    if (selection == IMAGE_COMDAT_SELECT_ANY && leaderSelection == IMAGE_COMDAT_SELECT_LARGEST) || (selection == IMAGE_COMDAT_SELECT_LARGEST && leaderSelection == IMAGE_COMDAT_SELECT_ANY) {
        leaderSelection = selection = IMAGE_COMDAT_SELECT_LARGEST;
    }
    if ctx.config.mingw && ((selection == IMAGE_COMDAT_SELECT_ANY && leaderSelection == IMAGE_COMDAT_SELECT_SAME_SIZE) || (selection == IMAGE_COMDAT_SELECT_SAME_SIZE && leaderSelection == IMAGE_COMDAT_SELECT_ANY)) {
        leaderSelection = selection = IMAGE_COMDAT_SELECT_SAME_SIZE;
    }
    if selection != leaderSelection {
        Log(ctx) << "conflicting comdat type for " << self.symtab.printSymbol(leader) << ": " << leaderSelection as i32 << " in " << leader.getFile() << " and " << selection as i32 << " in " << self;
        self.symtab.reportDuplicate(leader, self, null, 0);
        return;
    }
    match selection {
        IMAGE_COMDAT_SELECT_NODUPLICATES => {
            self.symtab.reportDuplicate(leader, self, null, 0);
        },
        IMAGE_COMDAT_SELECT_ANY => {
            break;
        },
        IMAGE_COMDAT_SELECT_SAME_SIZE => {
            if leaderChunk.getSize() != self.getSection(sym).SizeOfRawData.operator unsigned int() {
                if !ctx.config.mingw {
                    self.symtab.reportDuplicate(leader, self, null, 0);
                } else {
                    let mut leaderDef: *coff_aux_section_definition = null;
                    if leaderChunk.file {
                        leaderDef = findSectionDef(leaderChunk.file.getCOFFObj(), leaderChunk.getSectionNumber());
                    }
                    if !leaderDef || leaderDef.Length.operator unsigned int() != def.Length.operator unsigned int() {
                        self.symtab.reportDuplicate(leader, self, null, 0);
                    }
                }
            }
        },
        IMAGE_COMDAT_SELECT_EXACT_MATCH => {
            let mut newChunk: SectionChunk = SectionChunk { self, self.getSection(sym), SectionKind };
            if leaderChunk.getContents() != newChunk.getContents() {
                self.symtab.reportDuplicate(leader, self, &mut newChunk, sym.getValue());
            }
            break;
        },
        IMAGE_COMDAT_SELECT_ASSOCIATIVE => {
            llvm_unreachable_internal("createDefined not called for associative comdats", "P:/Goraw/llvm-project/lld/COFF/InputFiles.cpp", 811);
        },
        IMAGE_COMDAT_SELECT_LARGEST => {
            if leaderChunk.getSize() < self.getSection(sym).SizeOfRawData.operator unsigned int() {
                let mut name: str = check(operator(self.coffObj).getSymbolName(sym));
                replaceSymbol(leader, self, name, true, true, sym.getGeneric(), null);
                prevailing = true;
            }
        },
        IMAGE_COMDAT_SELECT_NEWEST => {
            llvm_unreachable_internal("should have been rejected earlier", "P:/Goraw/llvm-project/lld/COFF/InputFiles.cpp", 831);
        },
    }
}

fn ObjFile::createDefined(self, sym: COFFSymbolRef, comdatDefs: *[]*coff_aux_section_definition, prevailing: *mut bool) -> optional<Symbol *> {
    prevailing = false;
    let mut getName: Closure_11 = Closure_11 { cap_0: self, sym: &mut sym };
    if sym.isCommon() {
        let mut c: *mut CommonChunk = make(sym);
        self.chunks.push(c);
        return self.symtab.addCommon(self, getName.call(), sym.getValue(), sym.getGeneric(), c);
    }
    let mut ctx: *mut COFFLinkerContext = self.symtab.ctx;
    if sym.isAbsolute() {
        let mut name: str = getName.call();
        if name == "@feat.00" {
            self.feat00Flags = sym.getValue();
        }
        if ignoredSymbolName(name) {
            return null;
        }
        if sym.isExternal() {
            return self.symtab.addAbsolute(name, sym);
        }
        return make(ctx, name, sym);
    }
    let mut sectionNumber: i32 = sym.getSectionNumber();
    if sectionNumber == IMAGE_SYM_DEBUG {
        return null;
    }
    if sym.isEmptySectionDeclaration() {
        let mut name: str = getName.call();
        let mut hdr: *mut coff_section = make();
        memset(hdr, 0, (*hdr));
        strncpy(hdr.Name, name.ptr, if name.len < NameSize as u64 { name.len } else { NameSize as u64 });
        if sym.getValue() {
            hdr.Characteristics = sym.getValue() | IMAGE_SCN_ALIGN_4BYTES;
        } else {
            hdr.Characteristics = IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE | IMAGE_SCN_ALIGN_4BYTES;
        }
        let mut sc: *mut SectionChunk = make(self, hdr);
        self.chunks.push(sc);
        let mut symGen: *mut coff_symbol_generic = cloneSymbol(sym);
        symGen.Value = 0;
        return make(self, "", false, false, symGen, sc);
    }
    if isReservedSectionNumber(sectionNumber) {
        Fatal(ctx) << toString(self) << ": " << getName.call() << " should not refer to special section " << sectionNumber;
    }
    if sectionNumber as u32 >= self.sparseChunks.len {
        Fatal(ctx) << toString(self) << ": " << getName.call() << " should not refer to non-existent section " << sectionNumber;
    }
    if comdatDefs[sectionNumber] {
        def;
    } else {
        comdatDefs[sectionNumber] = null;
        let mut leader: *mut DefinedRegular = null;
        if sym.isExternal() {
            tie(leader, prevailing) = self.symtab.addComdat(self, getName.call(), sym.getGeneric());
        } else {
            leader = make(self, "", false, false, sym.getGeneric());
            prevailing = true;
        }
        if def.Selection < IMAGE_COMDAT_SELECT_NODUPLICATES as i32 || def.Selection > IMAGE_COMDAT_SELECT_LARGEST as i32 {
            Fatal(ctx) << "unknown comdat type " << to_string(def.Selection as i32) << " for " << getName.call() << " in " << toString(self);
        }
        let mut selection: COMDATType = def.Selection as COMDATType;
        if leader.isCOMDAT {
            self.handleComdatSelection(sym, selection, prevailing, leader, def);
        }
        if prevailing {
            let mut c: *mut SectionChunk = self.readSection(sectionNumber, def, getName.call());
            self.sparseChunks[sectionNumber] = c;
            if !c {
                return null;
            }
            c.sym = cast(leader);
            c.selection = selection;
            cast(leader).data = &mut c.repl;
        } else {
            self.sparseChunks[sectionNumber] = null;
        }
        return leader;
    }
    if self.sparseChunks[sectionNumber] == pendingComdat {
        if sym.getSectionDefinition() {
            def;
        } else {
            if def.Selection != IMAGE_COMDAT_SELECT_ASSOCIATIVE {
                comdatDefs[sectionNumber] = def;
            }
        }
        return nullopt;
    }
    return self.createRegular(sym);
}

fn ObjFile::getMachineType(self: *ObjFile) -> MachineTypes {
    return operator(self.coffObj).getMachine() as MachineTypes;
}

fn ObjFile::getDebugSection(self, secName: str) -> ArrayRef<uint8_t> {
    if findByName(self.debugChunks, secName) {
        sec;
    } else {
        return sec.consumeDebugMagic();
    }
    return ArrayRef<uint8_t> {};
}

fn ObjFile::initializeFlags(self) {
    let mut data: ArrayRef<uint8_t> = self.getDebugSection(".debug$S");
    if data.is_empty() {
        return;
    }
    let mut subsections: DebugSubsectionArray = DebugSubsectionArray {};
    let mut reader: BinaryStreamReader = BinaryStreamReader { Stream: data, Offset: little };
    let mut exitOnErr: ExitOnError = ExitOnError { Banner: "", GetExitCode: 1 };
    exitOnErr.call(reader.readArray(subsections, data.len, 0));
    for ss in subsections {
        if ss.kind() != Symbols {
            continue;
        }
        let mut offset: u32 = 0;
        for let mut i: u32 = 0; i < 2; i += 1 {
            let mut sym: Expected<CVSymbol> = readSymbolFromStream(ss.getRecordData(), offset);
            if !sym {
                consumeError(sym.takeError());
                return;
            }
            if operator(sym).kind() == S_COMPILE3 {
                let mut cs: Compile3Sym = cantFail(deserializeAs(sym.get()), null);
                self.hotPatchable = (cs.Flags & HotPatch) != None;
            }
            if operator(sym).kind() == S_OBJNAME {
                let mut objName: ObjNameSym = cantFail(deserializeAs(sym.get()), null);
                if objName.Signature {
                    self.pchSignature = objName.Signature;
                }
            }
            offset += operator(sym).len;
        }
    }
}

fn ObjFile::initializeDependencies(self) {
    let mut ctx: *mut COFFLinkerContext = self.symtab.ctx;
    if !ctx.config.debug {
        return;
    }
    let mut isPCH: bool = false;
    let mut data: ArrayRef<uint8_t> = self.getDebugSection(".debug$P");
    if !data.is_empty() {
        isPCH = true;
    } else {
        data = self.getDebugSection(".debug$T");
    }
    if data.is_empty() {
        if !self.debugChunks.is_empty() {
            self.debugTypesObj = makeTpiSource(ctx, self);
        }
        return;
    }
    let mut types: CVTypeArray = CVTypeArray {};
    let mut reader: BinaryStreamReader = BinaryStreamReader { Stream: data, Offset: little };
    cantFail(reader.readArray(types, reader.getLength(), 0), null);
    let mut firstType: Iterator = types.begin(null);
    if firstType == types.end() {
        return;
    }
    self.debugTypes = data;
    if isPCH {
        self.debugTypesObj = makePrecompSource(ctx, self);
        return;
    }
    if operator(operator(firstType)).kind() == LF_TYPESERVER2 {
        let mut ts: TypeServer2Record = cantFail(deserializeAs(operator(operator(firstType)).ptr), null);
        self.debugTypesObj = makeUseTypeServerSource(ctx, self, ts);
        self.enqueuePdbFile(ts.getName(), self);
        return;
    }
    if operator(operator(firstType)).kind() == LF_PRECOMP {
        let mut precomp: PrecompRecord = cantFail(deserializeAs(operator(operator(firstType)).ptr), null);
        if precomp.Signature {
            self.pchSignature = precomp.Signature;
        }
        self.debugTypesObj = makeUsePrecompSource(ctx, self, precomp);
        self.debugTypes = self.debugTypes.drop_front(operator(operator(firstType)).RecordData.len);
        return;
    }
    self.debugTypesObj = makeTpiSource(ctx, self);
}

fn normalizePdbPath(path: str) -> str {
    return path.lower();
}

fn findPdbPath(pdbPath: str, dependentFile: *mut ObjFile, outputPath: str) -> string> {
    if exists(pdbPath) {
        return normalizePdbPath(pdbPath);
    }
    let mut objPath: str = if !dependentFile.parentName.is_empty() { dependentFile.parentName } else { dependentFile.getName() };
    let mut pdbName: str = filename(pdbPath, windows);
    let mut path: str = "";
    append(path, parent_path(objPath, native), pdbName, "", "");
    if exists(path) {
        return normalizePdbPath(path.operator StringRef());
    }
    path.clear();
    append(path, parent_path(outputPath, native), pdbName, "", "");
    if exists(path) {
        return normalizePdbPath(path.operator StringRef());
    }
    return nullopt;
}

fn PDBInputFile::~PDBInputFile(self) {}

fn PDBInputFile::findFromRecordPath(self, ctx: *COFFLinkerContext, path: str, fromFile: *mut ObjFile) -> *mut PDBInputFile {
    let mut p: string> = findPdbPath(path, fromFile, ctx.config.outputFile);
    if !p {
        return null;
    }
    let mut it: const_iterator = ctx.pdbInputFileInstances.find(operator(p));
    if !it == ctx.pdbInputFileInstances.end() {
        return operator(it).second;
    }
    return null;
}

fn PDBInputFile::parse(self) {
    self.symtab.ctx.pdbInputFileInstances[self.mb.getBufferIdentifier()] = self;
    let mut thisSession: IPDBSession> = IPDBSession> {};
    let mut E: Error = createFromPdb(getMemBuffer(self.mb, false), thisSession);
    if E {
        self.loadErrorStr.emplace(toString(move(E)));
        return;
    }
    self.session.reset(thisSession.release() as *mut NativeSession);
    let mut pdbFile: *mut PDBFile = operator(self.session).getPDBFile();
    let mut expectedInfo: Expected<InfoStream &> = pdbFile.getPDBInfoStream();
    if !expectedInfo {
        self.loadErrorStr.emplace(toString(expectedInfo.takeError()));
        return;
    }
    self.debugTypesObj = makeTypeServerSource(self.symtab.ctx, self);
}

fn ObjFile::getVariableLocation(self, var: str) -> pair<StringRef, uint32_t>> {
    if !self.dwarf {
        self.dwarf = make(create(*self.getCOFFObj(), Process, null, "", defaultErrorHandler, defaultWarningHandler, false));
        if !self.dwarf {
            return nullopt;
        }
    }
    if self.symtab.machine == I386 {
        var.consume_front("_");
    }
    let mut ret: string, unsigned int>> = self.dwarf.getVariableLoc(var);
    if !ret {
        return nullopt;
    }
    return make_pair(saver().save(operator(ret).first), operator(ret).second);
}

fn ObjFile::getDILineInfo(self, offset: u32, sectionIndex: u32) -> optional<DILineInfo> {
    if !self.dwarf {
        self.dwarf = make(create(*self.getCOFFObj(), Process, null, "", defaultErrorHandler, defaultWarningHandler, false));
        if !self.dwarf {
            return nullopt;
        }
    }
    return self.dwarf.getDILineInfo(offset, sectionIndex);
}

fn ObjFile::enqueuePdbFile(self, path: str, fromFile: *mut ObjFile) {
    let mut p: string> = findPdbPath(path, fromFile, self.symtab.ctx.config.outputFile);
    if !p {
        return;
    }
    let mut it: pair<iterator, bool> = self.symtab.ctx.pdbInputFileInstances.emplace(operator(p), null);
    if !it.second {
        return;
    }
    self.symtab.ctx.driver.enqueuePDB(operator(p));
}

fn ImportFile::getMachineType(self, m: MemoryBufferRef) -> MachineTypes {
    let mut machine: u16 = m.getBufferStart() as *coff_import_header.Machine.operator unsigned short();
    return machine;
}

fn ImportFile::isSameImport(self: *ImportFile, other: *ImportFile) -> bool {
    if !self.externalName.is_empty() {
        return other.externalName == self.externalName;
    }
    return self.hdr.OrdinalHint.operator unsigned short() == other.hdr.OrdinalHint.operator unsigned short();
}

fn ImportFile::makeImportThunk(self) -> *mut ImportThunkChunk {
    match self.hdr.Machine.operator unsigned short() {
        AMD64 => {
            return make(self.symtab.ctx, self.impSym);
        },
        I386 => {
            return make(self.symtab.ctx, self.impSym);
        },
        ARM64 => {
            return make(self.symtab.ctx, self.impSym, ARM64);
        },
        ARMNT => {
            return make(self.symtab.ctx, self.impSym);
        },
    }
    llvm_unreachable_internal("unknown machine type", "P:/Goraw/llvm-project/lld/COFF/InputFiles.cpp", 1256);
}

fn ImportFile::parse(self) {
    let mut hdr: *coff_import_header = self.mb.getBufferStart() as *coff_import_header;
    if self.mb.getBufferSize() < (*hdr) || self.mb.getBufferSize() != (*hdr) + hdr.SizeOfData.operator unsigned int() {
        Fatal(self.symtab.ctx) << "broken import library";
    }
    let mut buf: str = self.mb.getBuffer()[(*hdr)..(*hdr) + npos];
    let mut split: pair<StringRef, StringRef> = buf.split(0);
    buf = split.second;
    let mut name: str = "";
    if isArm64EC(hdr.Machine) {
        if getArm64ECDemangledFunctionName(split.first) {
            demangledName;
        } else {
            name = saver().save(operator(demangledName));
        }
    }
    if name.is_empty() {
        name = saver().save(split.first);
    }
    let mut impName: str = saver().save("__imp_" + name);
    self.dllName = buf.split(0).first;
    let mut extName: str = "";
    match hdr.getNameType() {
        IMPORT_ORDINAL => {
            extName = "";
        },
        IMPORT_NAME => {
            extName = name;
        },
        IMPORT_NAME_NOPREFIX => {
            extName = ltrim1(name, "?@_");
        },
        IMPORT_NAME_UNDECORATE => {
            extName = ltrim1(name, "?@_");
        },
        IMPORT_NAME_EXPORTAS => {
            extName = buf[self.dllName.len + 1..self.dllName.len + 1 + npos].split(0).first;
        },
    }
    self.hdr = hdr;
    self.externalName = extName;
    let mut isCode: bool = hdr.getType() == IMPORT_CODE;
    if !self.symtab.isEC() {
        self.impSym = self.symtab.addImportData(impName, self, self.location);
    } else {
        let mut auxImpName: str = saver().save("__imp_aux_" + name);
        if isCode {
            self.impSym = self.symtab.addImportData(auxImpName, self, self.location);
            self.impECSym = self.symtab.addImportData(impName, self, self.auxLocation);
        } else {
            self.impSym = self.symtab.addImportData(impName, self, self.location);
            self.impECSym = self.symtab.addImportData(auxImpName, self, self.auxLocation);
        }
        if !self.impECSym {
            return;
        }
        let mut auxImpCopyName: str = saver().save("__auximpcopy_" + name);
        self.auxImpCopySym = self.symtab.addImportData(auxImpCopyName, self, self.auxCopyLocation);
        if !self.auxImpCopySym {
            return;
        }
    }
    if !self.impSym {
        return;
    }
    if hdr.getType() == IMPORT_CONST {
        self.symtab.addImportData(name, self, self.location) as void;
    }
    if isCode {
        if !self.symtab.isEC() {
            self.thunkSym = self.symtab.addImportThunk(name, self.impSym, self.makeImportThunk());
        } else {
            self.thunkSym = self.symtab.addImportThunk(name, self.impSym, make(self.symtab.ctx, self.impSym));
            if getArm64ECMangledFunctionName(name) {
                mangledName;
            } else {
                let mut auxThunkName: str = saver().save(operator(mangledName));
                self.auxThunkSym = self.symtab.addImportThunk(auxThunkName, self.impECSym, make(self.symtab.ctx, self.impECSym, ARM64EC));
            }
            let mut impChkName: str = saver().save("__impchk_" + name);
            self.impchkThunk = make(self);
            self.impchkThunk.sym = self.symtab.addImportThunk(impChkName, self.impSym, self.impchkThunk);
            self.symtab.ctx.driver.pullArm64ECIcallHelper();
        }
    }
}

fn BitcodeFile::BitcodeFile(self, symtab: *mut SymbolTable, mb: MemoryBufferRef, o: *mut InputFile>, lazy: bool) {
    self.obj.swap(o);
}

fn BitcodeFile::create(self, ctx: *mut COFFLinkerContext, mb: MemoryBufferRef, archiveName: str, offsetInArchive: u64, lazy: bool) -> *mut BitcodeFile {
    let mut path: str = mb.getBufferIdentifier();
    if ctx.config.thinLTOIndexOnly {
        path = replaceThinLTOSuffix(mb.getBufferIdentifier(), ctx.config.thinLTOObjectSuffixReplace.first, ctx.config.thinLTOObjectSuffixReplace.second);
    }
    let mut mbref: MemoryBufferRef = MemoryBufferRef { Buffer: mb.getBuffer(), Identifier: saver().save(if archiveName.is_empty() { path } else { archiveName + filename(path, native) + utostr(offsetInArchive, false) }) };
    let mut obj: InputFile> = check(create(mbref));
    operator(obj).setArchivePathAndName(archiveName, mb.getBufferIdentifier());
    return make(ctx.getSymtab(getMachineType(obj.get())), mb, obj, lazy);
}

fn BitcodeFile::~BitcodeFile(self) {}

fn BitcodeFile::parse(self) {
    let mut saver: *mut StringSaver = saver();
    let mut comdat: []pair<Symbol *, bool> = []pair<Symbol *, bool> { operator(self.obj).getComdatTable().len, Symbol *, bool>> {} };
    for let mut i: u64 = 0; i != operator(self.obj).getComdatTable().len; i += 1 {
        comdat[i] = self.symtab.addComdat(self, saver.save(operator(self.obj).getComdatTable()[i].first), null);
    }
    for objSym in operator(self.obj).symbols() {
        let mut symName: str = saver.save(objSym.getName());
        let mut comdatIndex: i32 = objSym.getComdatIndex();
        let mut sym: *mut Symbol = null;
        let mut fakeSC: *mut SectionChunk = null;
        if objSym.isExecutable() {
            fakeSC = &mut self.symtab.ctx.ltoTextSectionChunk.chunk;
        } else {
            fakeSC = &mut self.symtab.ctx.ltoDataSectionChunk.chunk;
        }
        if objSym.isUndefined() {
            sym = self.symtab.addUndefined(symName, self, false);
            if objSym.isWeak() {
                sym.deferUndefined = true;
            }
            if symName.starts_with("__imp_") {
                sym.isUsedInRegularObj = true;
            }
        } else if objSym.isCommon() {
            sym = self.symtab.addCommon(self, symName, objSym.getCommonSize(), null, null);
        } else if objSym.isWeak() && objSym.isIndirect() {
            sym = self.symtab.addUndefined(symName, self, true);
            let mut fallback: str = objSym.getCOFFWeakExternalFallback()[0..allocator<char> {}];
            let mut alias: *mut Symbol = self.symtab.addUndefined(saver.save(fallback));
            checkAndSetWeakAlias(self.symtab, self, sym, alias, false);
        } else if comdatIndex != -1 {
            if symName == operator(self.obj).getComdatTable()[comdatIndex].first {
                sym = comdat[comdatIndex].first;
                if cast(sym).data == null {
                    cast(sym).data = &mut fakeSC.repl;
                }
            } else if comdat[comdatIndex].second {
                sym = self.symtab.addRegular(self, symName, null, fakeSC, 0, false);
            } else {
                sym = self.symtab.addUndefined(symName, self, false);
            }
        } else {
            sym = self.symtab.addRegular(self, symName, null, fakeSC, 0, objSym.isWeak());
        }
        self.symbols.push(sym);
        if objSym.isUsed() {
            self.symtab.ctx.config.gcroot.push(sym);
        }
    }
    self.directives = saver.save(operator(self.obj).getCOFFLinkerOpts());
}

fn BitcodeFile::parseLazy(self) {
    for sym in operator(self.obj).symbols() {
        if !sym.isUndefined() {
            self.symtab.addLazyObject(self, sym.getName());
            if !self.lazy {
                return;
            }
        }
    }
}

fn BitcodeFile::getMachineType(self, obj: *InputFile) -> MachineTypes {
    let mut t: Triple = obj.getTargetTriple();
    match t.getArch() {
        x86_64 => {
            return AMD64;
        },
        x86 => {
            return I386;
        },
        arm => {
            thumb;
        },
        aarch64 => {
            return if t.isWindowsArm64EC() { ARM64EC } else { ARM64 };
        },
        _ => {
            return IMAGE_FILE_MACHINE_UNKNOWN;
        },
    }
}

fn replaceThinLTOSuffix(path: str, suffix: str, repl: str) -> str {
    if path.consume_back(suffix) {
        return (path + repl);
    }
    return path[0..allocator<char> {}];
}

fn isRVACode(coffObj: *mut COFFObjectFile, rva: u64, file: *mut InputFile) -> bool {
    for let mut i: u64 = 1;
let mut e: u64 = coffObj.getNumberOfSections(); i <= e; i += 1 {
        let mut sec: *coff_section = check2((coffObj.getSection(i)), string ()> { Closure_12 { file: &mut file }, null, null });
        if rva >= sec.VirtualAddress.operator unsigned int() && rva <= sec.VirtualAddress.operator unsigned int() + sec.VirtualSize.operator unsigned int() {
            return (sec.Characteristics.operator unsigned int() & IMAGE_SCN_CNT_CODE) != 0;
        }
    }
    return false;
}

fn DLLFile::parse(self) {
    if !operator(self.coffObj).getPE32Header() && !operator(self.coffObj).getPE32PlusHeader() {
        Err(self.symtab.ctx) << toString(self) << " is not a PE-COFF executable";
        return;
    }
    for exp in operator(self.coffObj).export_directories() {
        let mut dllName: str = "";
        let mut symbolName: str = "";
        let mut exportRVA: u32 = 0;
        checkError(exp.getDllName(dllName));
        checkError(exp.getSymbolName(symbolName));
        checkError(exp.getExportRVA(exportRVA));
        if symbolName.is_empty() {
            continue;
        }
        let mut code: bool = isRVACode(self.coffObj.get(), exportRVA, self);
        let mut s: *mut Symbol = make();
        s.dllName = dllName;
        s.symbolName = symbolName;
        s.importType = if code { IMPORT_CODE } else { IMPORT_DATA };
        s.nameType = IMPORT_NAME;
        if operator(self.coffObj).getMachine() == I386 {
            s.symbolName = symbolName = saver().save("_" + symbolName);
            s.nameType = IMPORT_NAME_NOPREFIX;
        }
        let mut impName: str = saver().save("__imp_" + symbolName);
        self.symtab.addLazyDLLSymbol(self, s, impName);
        if code {
            self.symtab.addLazyDLLSymbol(self, s, symbolName);
        }
        if self.symtab.isEC() {
            let mut impAuxName: str = saver().save("__imp_aux_" + symbolName);
            self.symtab.addLazyDLLSymbol(self, s, impAuxName);
            if code {
                let mut mangledName: string> = getArm64ECMangledFunctionName(symbolName);
                if mangledName {
                    self.symtab.addLazyDLLSymbol(self, s, operator(mangledName));
                }
            }
        }
    }
}

fn DLLFile::getMachineType(self: *DLLFile) -> MachineTypes {
    let mut machine: MachineTypes = operator(self.coffObj).getMachine() as MachineTypes;
    return if machine == ARM64X { ARM64 } else { machine };
}

fn DLLFile::makeImport(self, s: *mut Symbol) {
    if !self.seen.insert(s.symbolName).second {
        return;
    }
    let mut impSize: u64 = s.dllName.len + s.symbolName.len + 2;
    let mut size: u64 =  + impSize;
    let mut buf: *mut u8 = bAlloc().Allocate(size);
    memset(buf, 0, size);
    let mut p: *mut u8 = buf;
    let mut imp: *mut coff_import_header = p as *mut coff_import_header;
    p += (*imp);
    imp.Sig2 = 65535;
    imp.Machine = self.getMachineType() as u16;
    imp.SizeOfData = impSize;
    imp.OrdinalHint = 0;
    imp.TypeInfo = (s.nameType << 2) | s.importType;
    memcpy(p, s.symbolName.ptr, s.symbolName.len);
    p += s.symbolName.len + 1;
    memcpy(p, s.dllName.ptr, s.dllName.len);
    let mut mbref: MemoryBufferRef = MemoryBufferRef { Buffer: buf[0..size], Identifier: s.dllName };
    let mut impFile: *mut ImportFile = make(self.symtab.ctx, mbref);
    self.symtab.ctx.driver.addFile(impFile);
}

struct Closure_1 {}

