}

unsafe fn Closure_8::call(self: *mut Closure_8) -> auto {
        return toString("could not get the member for symbol " + toCOFFString(self.symtab.ctx, (*self.sym)));
    }

struct Closure_9 {
    file: *mut *mut Archive,
}

unsafe fn Closure_9::call(self: *mut Closure_9) -> auto {
            return toString((*self.file).getFileName() + ": could not get the buffer for a child of the archive");
        }

struct Closure_10 {
    cap_0: *mut ObjFile,
    sym: *mut COFFSymbolRef,
    parentIndex: *mut u32,
    sectionNumber: *mut i32,
}

unsafe fn Closure_10::call(self: *mut Closure_10) {
        let mut name: str = check(operator(self.coffObj).getSymbolName((*self.sym)));
        let mut parentName: str = "";
        let mut parentSec: *coff_section = self.getSection((*self.parentIndex));
        if operator(self.coffObj).getSectionName(parentSec) {
            e;
        } else {
            parentName = operator(e);
        }
        Err(self.symtab.ctx) << toString(self) << ": associative comdat " << name << " (sec " << (*self.sectionNumber) << ") has invalid reference to section " << parentName << " (sec " << (*self.parentIndex) << ")";
    }

struct Closure_11 {
    cap_0: *mut ObjFile,
    sym: *mut COFFSymbolRef,
}

unsafe fn Closure_11::call(self: *mut Closure_11) -> str {
        return check(operator(self.coffObj).getSymbolName((*self.sym)));
    }

struct Closure_12 {
    file: *mut *mut InputFile,
}

unsafe fn Closure_12::call(self: *mut Closure_12) -> auto {
            return toString((*self.file));
        }
