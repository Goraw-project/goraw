struct ICF {
    chunks: i32,
    cnt: i32,
    repeat: atomic<bool>,
    ctx: *mut COFFLinkerContext,
}

fn ICF::isEligible(self, c: *mut SectionChunk) -> bool {
    let mut writable: bool = c.getOutputCharacteristics() & IMAGE_SCN_MEM_WRITE;
    if !c.isCOMDAT() || !c.live || writable {
        return false;
    }
    if (self.ctx.config.doICF == All) && c.getOutputCharacteristics() & IMAGE_SCN_MEM_EXECUTE {
        return true;
    }
    let mut outSecName: str = c.getSectionName().split('$').first;
    if outSecName == ".pdata" || outSecName == ".xdata" {
        return true;
    }
    let mut itaniumVtablePrefix: *u8 = if self.ctx.config.machine == I386 { "__ZTV" } else { "_ZTV" };
    if c.sym && (c.sym.getName().starts_with("??_7") || c.sym.getName().starts_with(itaniumVtablePrefix)) {
        return true;
    }
    return !c.keepUnique;
}

fn ICF::assocEquals(self, a: *SectionChunk, b: *SectionChunk) -> bool {
    let mut considerForICF: Closure_1 = Closure_1 {};
    let mut ra: auto = make_filter_range(a.children(), considerForICF);
    let mut rb: auto = make_filter_range(b.children(), considerForICF);
    return equal(Closure_2 { cap_0: self });
}

fn ICF::findBoundary(self, begin: u64, end: u64) -> u64 {
    for let mut i: u64 = begin + 1; i < end; i += 1 {
        if  {
            return i;
        }
    }
    return end;
}

fn ICF::forEachClassRange(self, begin: u64, end: u64, fn: function<void (size_t, size_t)>) {
    while begin < end {
        let mut mid: u64 = self.findBoundary(begin, end);
        fn()(begin, mid);
        begin = mid;
    }
}

fn ICF::forEachClass(self, fn: function<void (size_t, size_t)>) {
    if  {
        self.forEachClassRange;
        self.cnt += 1;
        return;
    }
    let mut numShards: u64 = 256;
    let mut step: u64 = 0;
    let mut boundaries: [257]u64 = zeroed();
    boundaries[0] = 0;
    parallelFor(1, numShards, Closure_3 { boundaries: &mut boundaries, cap_1: self, step: &mut step });
    parallelFor(1, numShards + 1, Closure_4 { boundaries: &mut boundaries, cap_1: self });
    self.cnt += 1;
}

fn ICF::run(self) {
    let mut timeScope: TimeTraceScope = TimeTraceScope { Entry: "ICF" };
    let mut t: ScopedTimer = self.ctx;
    let mut nextId: u32 = 1;
    parallelForEach(Closure_5 {});
    for let mut cnt: u32 = 0; cnt != 2; cnt += 1 {
        parallelForEach(Closure_6 { cnt: &mut cnt });
    }
    stable_sort(Closure_7 {});
    self.forEachClass;
    while true {
        {
        self.forEachClass;
    }
        if !() { break; }
    }
    Log(self.ctx) << "ICF needed " << " iterations";
    self.forEachClass;
}

fn doICF(ctx: *mut COFFLinkerContext) {
    ICF { ctx }.run();
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, assoc: *SectionChunk) -> bool {
        let mut Name: str = assoc.getSectionName();
        return !(Name.starts_with(".debug") || Name == ".gfids$y" || Name == ".giats$y" || Name == ".gljmp$y");
    }

struct Closure_2 {
    cap_0: *mut ICF,
}

fn Closure_2::call(self: *Closure_2, ia: *SectionChunk, ib: *SectionChunk) -> bool {
        return ia.eqClass[self.cnt % 2] == ib.eqClass[self.cnt % 2];
    }

struct Closure_3 {
    boundaries: *mut [257]size_t (&),
    cap_1: *mut ICF,
    step: *mut u64,
}

unsafe fn Closure_3::call(self: *mut Closure_3, i: u64) {
        (*self.boundaries)[i] = self.findBoundary;
    }

struct Closure_4 {
    boundaries: *mut [257]size_t (&),
    cap_1: *mut ICF,
}

unsafe fn Closure_4::call(self: *mut Closure_4, i: u64) {
        if (*self.boundaries)[i - 1] < (*self.boundaries)[i] {
            self.forEachClassRange((*self.boundaries)[i - 1], (*self.boundaries)[i]);
        }
    }

struct Closure_5 {}

fn Closure_5::call(self: *Closure_5, sc: *mut SectionChunk) {
        sc.eqClass[0] = xxh3_64bits(sc.getContents());
    }

struct Closure_6 {
    cnt: *mut u32,
}

unsafe fn Closure_6::call(self: *mut Closure_6, sc: *mut SectionChunk) {
            let mut hash: u32 = sc.eqClass[(*self.cnt) % 2];
            for b in sc.symbols() {
                if  {
                    operator+=(hash, ()[(*self.cnt) % 2]);
                }
            }
            sc.eqClass[((*self.cnt) + 1) % 2] = hash | (1 << 31);
        }

struct Closure_7 {}

fn Closure_7::call(self: *Closure_7, a: *SectionChunk, b: *SectionChunk) -> bool {
        return a.eqClass[0] < b.eqClass[0];
    }
