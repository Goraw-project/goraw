    self.rsrcSec = createSection(".rsrc", data | r);
    self.relocSec = createSection(".reloc", data | discardable | r);
    self.ctorsSec = createSection(".ctors", data | r | w);
    self.dtorsSec = createSection(".dtors", data | r | w);
    self.fixPartialSectionChars(".rsrc", data | r);
    self.fixPartialSectionChars(".edata", data | r);
    let mut hasIdata: bool = self.fixGnuImportChunks();
    if  {
        hasIdata = true;
