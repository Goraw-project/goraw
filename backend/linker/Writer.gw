fn addSymbolToRVASet(rvaSet: *mut SymbolRVASet, s: *mut Defined) {
    let mut c: *mut Chunk = s.getChunk();
    if !c {
        return;
    }
    if  {
        c = ;
    }
    let mut off: u32 = s.getRVA() - (if c { c.getRVA() } else { 0 });
    rvaSet.insert;
}

fn maybeAddAddressTakenFunction(addressTakenSyms: *mut SymbolRVASet, s: *mut Symbol) {
    if !s {
        return;
    }
    match s.kind() {
        DefinedLocalImportKind => {
            DefinedImportDataKind;
        },
        DefinedCommonKind => {
            break;
        },
        DefinedAbsoluteKind => {
            break;
        },
        DefinedSyntheticKind => {
            if  {
                addSymbolToRVASet(addressTakenSyms, cast(s));
                addSymbolToRVASet(addressTakenSyms);
            }
        },
        LazyArchiveKind => {
            LazyObjectKind;
        },
        DefinedImportThunkKind => {
            addSymbolToRVASet(addressTakenSyms, cast(s));
        },
        DefinedRegularKind => {
            let mut d: *mut auto = cast(s);
            if d()()() == IMAGE_SYM_DTYPE_FUNCTION {
                let mut sc: *mut SectionChunk = dyn_cast();
                if sc && sc.live && sc.getOutputCharacteristics() & IMAGE_SCN_MEM_EXECUTE {
                    addSymbolToRVASet(addressTakenSyms);
                }
            }
            break;
        },
    }
}

fn Writer::markSymbolsWithRelocations(self, file: *mut ObjFile, usedSymbols: *mut SymbolRVASet) {
    for c in file.getChunks() {
