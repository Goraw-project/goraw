    self.ctx.forEachActiveSymtab(Closure_31 { cap_0: self });
}

fn Writer::printSummary(self) {
    if !self.ctx.config.showSummary {
        return;
    }
    let mut buffer: str = "";
    let mut stream: raw_svector_ostream = buffer;
    stream << center_justify("Summary", 80) << 10 << 80[0..'-'] << 10;
    let mut print: Closure_32 = Closure_32 { stream: &mut stream };
    let mut hasStats: bool = self.ctx.pdbStats.has_value();
    print.call(self.ctx.objFileInstances.len, "Input OBJ files (expanded from all cmd-line inputs)");
    print.call(self.ctx.consumedInputsSize, "Size of all consumed OBJ files (non-lazy), in bytes");
    print.call(self.ctx.typeServerSourceMappings.len, "PDB type server dependencies");
    print.call(self.ctx.precompSourceMappings.len, "Precomp OBJ dependencies");
    print.call(if hasStats { operator(self.ctx.pdbStats).nbTypeRecords } else { 0 }, "Input debug type records");
    print.call(if hasStats { operator(self.ctx.pdbStats).nbTypeRecordsBytes } else { 0 }, "Size of all input debug type records, in bytes");
    print.call(if hasStats { operator(self.ctx.pdbStats).nbTPIrecords } else { 0 }, "Merged TPI records");
    print.call(if hasStats { operator(self.ctx.pdbStats).nbIPIrecords } else { 0 }, "Merged IPI records");
    print.call(if hasStats { operator(self.ctx.pdbStats).strTabSize } else { 0 }, "Output PDB strings");
    print.call(if hasStats { operator(self.ctx.pdbStats).globalSymbols } else { 0 }, "Global symbol records");
    print.call(if hasStats { operator(self.ctx.pdbStats).moduleSymbols } else { 0 }, "Module symbol records");
    print.call(if hasStats { operator(self.ctx.pdbStats).publicSymbols } else { 0 }, "Public symbol records");
    if hasStats {
        stream << operator(self.ctx.pdbStats).largeInputTypeRecs;
    }
    Msg(self.ctx) << buffer;
}

