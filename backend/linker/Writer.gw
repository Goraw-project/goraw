fn Writer::insertBssDataStartEndSymbols(self) {
    if !self.dataSec.chunks.is_empty() {
        let mut dataStartSym: *mut Symbol = self.ctx.symtab.find("__data_start__");
        let mut dataEndSym: *mut Symbol = self.ctx.symtab.find("__data_end__");
        let mut endChunk: *mut Chunk = self.dataSec.chunks.back();
        replaceSymbol(dataStartSym, dataStartSym.getName(), self.dataSec.chunks.front());
        replaceSymbol(dataEndSym, dataEndSym.getName(), endChunk, endChunk.getSize());
    }
    if !self.bssSec.chunks.is_empty() {
        let mut bssStartSym: *mut Symbol = self.ctx.symtab.find("__bss_start__");
        let mut bssEndSym: *mut Symbol = self.ctx.symtab.find("__bss_end__");
        let mut endChunk: *mut Chunk = self.bssSec.chunks.back();
        replaceSymbol(bssStartSym, bssStartSym.getName(), self.bssSec.chunks.front());
        replaceSymbol(bssEndSym, bssEndSym.getName(), endChunk, endChunk.getSize());
    }
}

