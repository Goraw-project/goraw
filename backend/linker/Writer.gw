fn Writer::addBaserels(self) {
    if !self.ctx.config.relocatable {
        return;
    }
    let mut v: i32 = 0;
}

fn Writer::addBaserelBlocks(self, v: *mut i32) {
    let mut mask: u32 = ~pageSize - 1;
    let mut page: u32 = [0] & mask;
    let mut i: u64 = 0;
    let mut j: u64 = 1;
    sort(Closure_16 {});
    for let mut e: u64 = (); j < e; j += 1 {
        let mut p: u32 = [j] & mask;
        if p == page {
            continue;
        }
        self.relocSec.addChunk(make(page, operator&([i]), operator&([0]) + j));
        i = j;
        page = p;
    }
    if i == j {
        return;
    }
    self.relocSec.addChunk(make(page, operator&([i]), operator&([0]) + j));
}

fn Writer::createDynamicRelocs(self) {
    if !self.ctx.dynamicRelocs {
        return;
    }
    self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.coffHeaderOffset +  }, Arm64XRelocVal { AMD64 });
    if self.ctx.symtab.entry != self.ctx || self.pdata.first != self.hybridPdata.first {
        self.chpeSym = cast_or_null(self.ctx.symtab.findUnderscore("__chpe_metadata"));
        if !self.chpeSym {
            Warn(self.ctx) << "'__chpe_metadata' is missing for ARM64X target";
        }
    }
    if self.ctx.symtab.entry != self.ctx {
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, self.peHeaderOffset + , cast_or_null(self.ctx.symtab.entry));
        if self.chpeSym {
            self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.chpeSym,  }, cast_or_null(self.ctx));
        }
    }
    if self.ctx.symtab.edataStart != self.ctx {
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.dataDirOffset64 + EXPORT_TABLE *  +  }, Arm64XRelocVal { self.ctx.symtab.edataStart, 0 });
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.dataDirOffset64 + EXPORT_TABLE *  +  }, Arm64XRelocVal { 0 });
    }
    if self.pdata.first != self.hybridPdata.first {
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.dataDirOffset64 + EXCEPTION_TABLE *  +  }, Arm64XRelocVal { self.hybridPdata.first, 0 });
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.dataDirOffset64 + EXCEPTION_TABLE *  +  }, Arm64XRelocVal { 0 });
        if self.chpeSym {
            self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.chpeSym,  }, Arm64XRelocVal { self.pdata.first, 0 });
            self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.chpeSym,  }, Arm64XRelocVal { 0 });
        }
    }
    self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.dataDirOffset64 + LOAD_CONFIG_TABLE *  +  }, Arm64XRelocVal { self.ctx.symtab.loadConfigSym, 0 });
    self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.dataDirOffset64 + LOAD_CONFIG_TABLE *  +  }, Arm64XRelocVal { self.ctx.symtab.loadConfigSize });
    let mut nativeTlsUsed: auto = dyn_cast_or_null(self.ctx("_tls_used"));
    let mut ecTlsUsed: auto = dyn_cast_or_null(self.ctx.symtab.findUnderscore("_tls_used"));
    if nativeTlsUsed() ||  {
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, Arm64XRelocVal { self.dataDirOffset64 + TLS_TABLE *  +  });
        if operator!() || operator!() {
            self.ctx.dynamicRelocs.add;
        }
    }
}

fn Writer::createPartialSection(self, name: str, outChars: u32) -> *mut PartialSection {
    let mut pSec: *mut *mut PartialSection = null;
    if pSec {
        return pSec;
    }
    pSec = make(name, outChars);
    return pSec;
}

fn Writer::findPartialSection(self, name: str, outChars: u32) -> *mut PartialSection {
    let mut it: auto = zeroed();
    if  {
