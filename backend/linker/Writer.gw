fn Writer::printSummary(self) {
    if !self.ctx.config.showSummary {
        return;
    }
    let mut buffer: str = "";
    let mut stream: raw_svector_ostream = raw_svector_ostream { buffer };
    stream << center_justify("Summary", 80) << 10 << 80[0..'-'] << 10;
    let mut print: Closure_17 = Closure_17 { stream: &mut stream };
    let mut hasStats: bool = self.ctx();
    print(self.ctx(), "Input OBJ files (expanded from all cmd-line inputs)");
    print.call(self.ctx.consumedInputsSize, "Size of all consumed OBJ files (non-lazy), in bytes");
    print(self.ctx(), "PDB type server dependencies");
    print(self.ctx(), "Precomp OBJ dependencies");
    print(if hasStats { self.ctx } else { 0 }, "Input debug type records");
    print(if hasStats { self.ctx } else { 0 }, "Size of all input debug type records, in bytes");
    print(if hasStats { self.ctx } else { 0 }, "Merged TPI records");
    print(if hasStats { self.ctx } else { 0 }, "Merged IPI records");
    print(if hasStats { self.ctx } else { 0 }, "Output PDB strings");
    print(if hasStats { self.ctx } else { 0 }, "Global symbol records");
    print(if hasStats { self.ctx } else { 0 }, "Module symbol records");
    print(if hasStats { self.ctx } else { 0 }, "Public symbol records");
    if hasStats {
        stream << self.ctx;
    }
    Msg(self.ctx);
}

