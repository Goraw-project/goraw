fn Closure_16::call(self: *Closure_16, a: *OutputSection, b: *OutputSection) -> bool {
        let mut itA: iterator = self.ctx.config.sectionOrder.find(a.name);
        let mut itB: iterator = self.ctx.config.sectionOrder.find(b.name);
        let mut aInOrder: bool = !itA == self.ctx.config.sectionOrder.end();
        let mut bInOrder: bool = !itB == self.ctx.config.sectionOrder.end();
        if aInOrder && bInOrder {
            return operator(itA).second < operator(itB).second;
        } else if aInOrder && !bInOrder {
            return true;
        } else {
            return false;
        }
    }

