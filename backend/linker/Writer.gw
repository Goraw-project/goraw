struct PartialSectionKey {
    name: str,
    characteristics: u32,
}

fn PartialSectionKey::operator<(self: *PartialSectionKey, other: *PartialSectionKey) -> bool {
    let mut c: i32 = self.name.compare(other.name);
    if c > 0 {
        return false;
    }
    if c == 0 {
        return self.characteristics < other.characteristics;
    }
    return true;
}

struct ChunkRange {
    first: *mut Chunk,
    last: *mut Chunk,
}

