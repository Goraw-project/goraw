struct Closure_25 {
    cap_0: *mut Writer,
}

fn Closure_25::call(self: *Closure_25, symtab: *mut SymbolTable) {
        let mut rels: []RuntimePseudoReloc = []RuntimePseudoReloc {};
        for c in self.ctx.driver.getChunks() {
            let mut sc: *mut SectionChunk = dyn_cast(c);
            if !sc || !sc.live || &mut sc.file.symtab != &mut symtab {
                continue;
            }
            if sc.header.Characteristics.operator unsigned int() & IMAGE_SCN_MEM_DISCARDABLE {
                continue;
            }
            sc.getRuntimePseudoRelocs(rels);
        }
        if !self.ctx.config.pseudoRelocs {
            for rpr in rels {
                Err(self.ctx) << "automatic dllimport of " << rpr.sym.getName() << " in " << toString(rpr.target.file) << " requires pseudo relocations";
            }
            return;
        }
        if !rels.is_empty() {
            Log(self.ctx) << "Writing " << rels.len << " runtime pseudo relocations";
            let mut symbolName: *u8 = "_pei386_runtime_relocator";
            let mut relocator: *mut Symbol = symtab.findUnderscore(symbolName);
            if !relocator {
                Err(self.ctx) << "output image has runtime pseudo relocations, but the function " << symbolName << " is missing; it is needed for fixing the relocations at runtime";
            }
        }
        let mut table: *mut PseudoRelocTableChunk = make(rels);
        self.rdataSec.addChunk(table);
        let mut endOfList: *mut EmptyChunk = make();
        self.rdataSec.addChunk(endOfList);
        let mut headSym: *mut Symbol = symtab.findUnderscore("__RUNTIME_PSEUDO_RELOC_LIST__");
        let mut endSym: *mut Symbol = symtab.findUnderscore("__RUNTIME_PSEUDO_RELOC_LIST_END__");
        replaceSymbol(headSym, headSym.getName(), table);
        replaceSymbol(endSym, endSym.getName(), endOfList);
    }

