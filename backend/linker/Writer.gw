fn writeResult(ctx: *mut COFFLinkerContext) {
    let mut timeScope: TimeTraceScope = "Write output(s)";
    ctx.run();
}

fn OutputSection::addChunk(self, c: *mut Chunk) {
    self.chunks.push(c);
}

fn OutputSection::insertChunkAtStart(self, c: *mut Chunk) {
    self.chunks.insert(self.chunks.begin(), c);
}

fn OutputSection::setPermissions(self, c: u32) {
    operator(self.header.Characteristics, ~permMask);
    operator(self.header.Characteristics, c);
}

fn OutputSection::merge(self, other: *mut OutputSection) {
    self.chunks.insert(self.chunks.end(), other.chunks.begin(), other.chunks.end());
    other.chunks.clear();
    self.contribSections.insert(self.contribSections.end(), other.contribSections.begin(), other.contribSections.end());
    other.contribSections.clear();
    if other.header.Characteristics.operator unsigned int() & IMAGE_SCN_CNT_CODE {
        operator(self.header.Characteristics, IMAGE_SCN_CNT_CODE);
        operator(self.header.Characteristics, ~(IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_CNT_UNINITIALIZED_DATA));
    }
}

fn OutputSection::writeHeaderTo(self, buf: *mut u8, isDebug: bool) {
    let mut hdr: *mut coff_section = buf as *mut coff_section;
    *hdr = self.header;
    if self.stringTableOff {
        encodeSectionName(hdr.Name, self.stringTableOff);
    } else {
        assert!(!isDebug || self.name.len <= NameSize || (hdr.Characteristics.operator unsigned int() & IMAGE_SCN_MEM_DISCARDABLE) == 0);
        strncpy(hdr.Name, self.name.ptr, if self.name.len < NameSize as u64 { self.name.len } else { NameSize as u64 });
    }
}

fn OutputSection::addContributingPartialSection(self, sec: *mut PartialSection) {
    self.contribSections.push(sec);
}

fn OutputSection::splitECChunks(self) {
    stable_sort(self.chunks, Closure_1 {});
}

fn Writer::isInRange(self, relType: u16, s: u64, p: u64, margin: i32, machine: MachineTypes) -> bool {
    if machine == ARMNT {
        let mut diff: i64 = AbsoluteDifference(s, p + 4) + margin;
        match relType {
            IMAGE_REL_ARM_BRANCH20T => {
                return isInt(diff);
            },
            IMAGE_REL_ARM_BRANCH24T => {
                IMAGE_REL_ARM_BLX23T;
            },
            _ => {
                return true;
            },
        }
    } else if isAnyArm64(machine) {
        let mut diff: i64 = AbsoluteDifference(s, p) + margin;
        match relType {
            IMAGE_REL_ARM64_BRANCH26 => {
                return isInt(diff);
            },
            IMAGE_REL_ARM64_BRANCH19 => {
                return isInt(diff);
            },
            IMAGE_REL_ARM64_BRANCH14 => {
                return isInt(diff);
            },
            _ => {
                return true;
            },
        }
    } else {
        return true;
    }
}

fn Writer::getThunk(self, lastThunks: *mut DenseMap<uint64_t, Defined *>, target: *mut Defined, p: u64, type: u16, margin: i32, machine: MachineTypes) -> pair<Defined *, bool> {
    let mut lastThunk: *mut *mut Defined = lastThunks[target.getRVA()];
    if lastThunk && self.isInRange(type, lastThunk.getRVA(), p, margin, machine) {
        return pair<Defined *, bool> { lastThunk, false };
    }
    let mut c: *mut Chunk = null;
    match getMachineArchType(machine) {
        thumb => {
            c = make(self.ctx, target);
        },
        aarch64 => {
            c = make(machine, target);
        },
        _ => {
            llvm_unreachable_internal("Unexpected architecture", "P:/Goraw/llvm-project/lld/COFF/Writer.cpp", 471);
        },
    }
    let mut d: *mut Defined = make("range_extension_thunk", c);
    lastThunk = d;
    return pair<Defined *, bool> { d, true };
}

fn Writer::createThunks(self, os: *mut OutputSection, margin: i32) -> bool {
    let mut addressesChanged: bool = false;
    let mut lastThunks: DenseMap<uint64_t, Defined *> = DenseMap<uint64_t, Defined *> {};
    let mut thunkSymtabIndices: pair<ObjFile *, Defined *>, uint32_t> = pair<ObjFile *, Defined *>, uint32_t> {};
    let mut thunksSize: u64 = 0;
    for let mut i: u64 = 0; i != os.chunks.len; i += 1 {
        let mut sc: *mut SectionChunk = dyn_cast(os.chunks[i]);
        if !sc {
            let mut chunk: CastReturnType = cast(os.chunks[i]);
            if chunk.extendRanges() {
                size;
            } else {
                thunksSize += size;
                addressesChanged = true;
            }
            continue;
        }
        let mut machine: MachineTypes = sc.getMachine();
        let mut thunkInsertionSpot: u64 = i + 1;
        let mut thunkInsertionRVA: u64 = sc.getRVA() + sc.getSize() + thunksSize;
        let mut file: *mut ObjFile = sc.file;
        let mut relocReplacements: []pair<uint32_t, uint32_t> = []pair<uint32_t, uint32_t> {};
        let mut originalRelocs: ArrayRef<coff_relocation> = file.getCOFFObj().getRelocations(sc.header);
        for let mut j: u64 = 0;
let mut e: u64 = originalRelocs.len; j < e; j += 1 {
            let mut rel: *coff_relocation = originalRelocs[j];
            let mut relocTarget: *mut Symbol = file.getSymbol(rel.SymbolTableIndex.operator unsigned int());
            let mut p: u64 = sc.getRVA() + rel.VirtualAddress.operator unsigned int() + thunksSize;
            let mut sym: *mut Defined = dyn_cast_or_null(relocTarget);
            if !sym {
                continue;
            }
            let mut s: u64 = sym.getRVA();
            if self.isInRange(rel.Type.operator unsigned short(), s, p, margin, machine) {
                continue;
            }
            if wasNew {
                let mut thunkChunk: *mut Chunk = thunk.getChunk();
                thunkChunk.setRVA(thunkInsertionRVA);
                os.chunks.insert(os.chunks.begin() + thunkInsertionSpot, thunkChunk);
                thunkInsertionSpot += 1;
                thunksSize += thunkChunk.getSize();
                thunkInsertionRVA += thunkChunk.getSize();
                addressesChanged = true;
            }
            let mut insertion: pair<iterator, bool> = thunkSymtabIndices.insert(Defined *>, unsigned int> { Defined *> { file, thunk }, ~0 });
            let mut thunkSymbolIndex: *mut u32 = operator(insertion.first).second;
            if insertion.second {
                thunkSymbolIndex = file.addRangeThunkSymbol(thunk);
            }
            relocReplacements.push(j, thunkSymbolIndex);
        }
        let mut curRelocs: ArrayRef<coff_relocation> = sc.getRelocs();
        let mut newRelocs: MutableArrayRef<coff_relocation> = MutableArrayRef<coff_relocation> {};
        if originalRelocs.ptr == curRelocs.ptr {
            newRelocs = coff_relocation> { bAlloc().Allocate(originalRelocs.len), originalRelocs.len };
        } else {
            newRelocs = coff_relocation> { curRelocs.ptr, curRelocs.len };
        }
        let mut nextReplacement: iterator = relocReplacements.begin();
        let mut endReplacement: iterator = relocReplacements.end();
        for let mut i: u64 = 0;
let mut e: u64 = originalRelocs.len; i != e; i += 1 {
            newRelocs[i] = originalRelocs[i];
            if !nextReplacement == endReplacement && operator(nextReplacement).first == i {
                newRelocs[i].SymbolTableIndex = operator(nextReplacement).second;
                operator(nextReplacement);
            }
        }
        sc.setRelocs(newRelocs);
    }
    return addressesChanged;
}

fn Writer::createECCodeMap(self) {
    if !self.ctx.symtab.isEC() {
        return;
    }
    self.codeMap.clear();
    let mut lastType: optional<chpe_range_type> = optional<chpe_range_type> {};
    let mut first: *mut Chunk = null;
    let mut last: *mut Chunk = null;
    let mut closeRange: Closure_2 = Closure_2 { lastType: &mut lastType, cap_1: self, first: &mut first, last: &mut last };
    for sec in self.ctx.outputSections {
        for c in sec.chunks {
            if isa(c) && !c.getSize() {
                continue;
            }
            let mut chunkType: optional<chpe_range_type> = c.getArm64ECRangeType();
            if chunkType != lastType {
                closeRange.call();
                first = c;
                lastType = chunkType;
            }
            last = c;
        }
    }
    closeRange.call();
    let mut tableCountSym: *mut Symbol = self.ctx.symtab.findUnderscore("__hybrid_code_map_count");
    cast(tableCountSym).setVA(self.codeMap.len);
}

fn Writer::verifyRanges(self, chunks: []*mut Chunk) -> bool {
    for c in chunks {
        let mut sc: *mut SectionChunk = dyn_cast(c);
        if !sc {
            if !cast(c).verifyRanges() {
                return false;
            }
            continue;
        }
        let mut machine: MachineTypes = sc.getMachine();
        let mut relocs: ArrayRef<coff_relocation> = sc.getRelocs();
        for rel in relocs {
            let mut relocTarget: *mut Symbol = sc.file.getSymbol(rel.SymbolTableIndex.operator unsigned int());
            let mut sym: *mut Defined = dyn_cast_or_null(relocTarget);
            if !sym {
                continue;
            }
            let mut p: u64 = sc.getRVA() + rel.VirtualAddress.operator unsigned int();
            let mut s: u64 = sym.getRVA();
            if !self.isInRange(rel.Type.operator unsigned short(), s, p, 0, machine) {
                return false;
            }
        }
    }
    return true;
}

fn Writer::finalizeAddresses(self) {
    self.assignAddresses();
    if self.ctx.config.machine != ARMNT && !isAnyArm64(self.ctx.config.machine) {
        return;
    }
    let mut origNumChunks: u64 = 0;
    for sec in self.ctx.outputSections {
        sec.origChunks = sec.chunks;
        origNumChunks += sec.chunks.len;
    }
    let mut pass: i32 = 0;
    let mut margin: i32 = 1024 * 100;
    while true {
        let mut timeScope2: TimeTraceScope = "Add thunks pass";
        let mut rangesOk: bool = true;
        let mut numChunks: u64 = 0;
        {
            let mut timeScope3: TimeTraceScope = "Verify ranges";
            for sec in self.ctx.outputSections {
                if !self.verifyRanges(sec.chunks) {
                    rangesOk = false;
                    break;
                }
                numChunks += sec.chunks.len;
            }
        }
        if rangesOk {
            if pass > 0 {
                Log(self.ctx) << "Added " << (numChunks - origNumChunks) << " thunks with " << "margin " << margin << " in " << pass << " passes";
            }
            return;
        }
        if pass >= 10 {
            Fatal(self.ctx) << "adding thunks hasn't converged after " << pass << " passes";
        }
        if pass > 0 {
            for sec in self.ctx.outputSections {
                sec.chunks = sec.origChunks;
            }
            margin *= 2;
        }
        let mut addressesChanged: bool = false;
        {
            let mut timeScope3: TimeTraceScope = "Create thunks";
            for sec in self.ctx.outputSections {
                addressesChanged |= self.createThunks(sec, margin);
            }
        }
        assert!(addressesChanged);
        addressesChanged as void;
        self.assignAddresses();
        pass += 1;
    }
}

fn Writer::writePEChecksum(self) {
    if !self.ctx.config.writeCheckSum {
        return;
    }
    let mut timeScope: TimeTraceScope = "PE checksum";
    let mut buf: *mut u32 = operator(self.buffer).getBufferStart() as *mut u32;
    let mut size: u32 = (operator(self.buffer).getBufferSize()) as u32;
    let mut peHeader: *mut pe32_header = (buf as *mut u8 + self.coffHeaderOffset + ) as *mut pe32_header;
    let mut sum: u64 = 0;
    let mut count: u32 = size;
    let mut addr: *mut ulittle16_t = buf as *mut ulittle16_t;
    while count > 1 {
        sum += *addr += 1.operator unsigned short();
        count -= 2;
    }
    if count > 0 {
        sum += *addr as *mut u8;
    }
    while sum >> 16 {
        sum = (sum & 65535) + (sum >> 16);
    }
    sum += size;
    peHeader.CheckSum = sum;
}

fn Writer::run(self) {
    {
        let mut timeScope: TimeTraceScope = "Write PE";
        let mut t1: ScopedTimer = self.ctx.codeLayoutTimer;
        self.calculateStubDependentSizes();
        if self.ctx.config.machine == ARM64X {
            self.ctx.dynamicRelocs = make();
        }
        self.createImportTables();
        self.createSections();
        self.appendImportThunks();
        self.createMiscChunks();
        self.createExportTable();
        self.mergeSections();
        self.sortECChunks();
        self.appendECImportTables();
        self.createDynamicRelocs();
        self.removeUnusedSections();
        self.layoutSections();
        self.finalizeAddresses();
        self.removeEmptySections();
        self.assignOutputSectionIndices();
        self.setSectionPermissions();
        self.setECSymbols();
        self.createSymbolAndStringTable();
        if self.fileSize > 4294967295 {
            Fatal(self.ctx) << "image size (" << self.fileSize << ") " << "exceeds maximum allowable size (" << 4294967295 << ")";
        }
        self.openFile(self.ctx.config.outputFile);
        if self.ctx.config.is64() {
            self.writeHeader();
        } else {
            self.writeHeader();
        }
        self.writeSections();
        self.prepareLoadConfig();
        self.sortExceptionTables();
        if self.tlsAlignment {
            self.ctx.forEachSymtab(Closure_3 { cap_0: self });
        }
    }
    if !self.ctx.config.pdbPath.is_empty() && self.ctx.config.debug {
        assert!(self.buildId);
        createPDB(self.ctx, self.sectionTable, self.buildId.buildId);
    }
    self.writeBuildId();
    writeLLDMapFile(self.ctx);
    writeMapFile(self.ctx);
    self.writePEChecksum();
    self.printSummary();
    if errorCount() {
        return;
    }
    let mut timeScope: TimeTraceScope = "Commit PE to disk";
    let mut t2: ScopedTimer = self.ctx.outputCommitTimer;
    if operator(self.buffer).commit() {
        e;
    } else {
        Fatal(self.ctx) << "failed to write output '" << operator(self.buffer).getPath() << "': " << toString(move(e));
    }
}

fn getOutputSectionName(name: str, isMinGW: bool) -> str {
    let mut s: str = name.split('$').first;
    if !isMinGW {
        return s;
    }
    return s[0..0 + s.find('.', 1)];
}

fn Writer::sortBySectionOrder(self, chunks: *mut []*mut Chunk) {
    let mut getPriority: Closure_4 = Closure_4 { ctx: &mut self.ctx };
    stable_sort(chunks, Closure_5 { cap_0: getPriority });
}

fn Writer::fixPartialSectionChars(self, name: str, chars: u32) {
    for it in self.partialSections {
        let mut pSec: *mut PartialSection = it.second;
        let mut curName: str = pSec.name;
        if !curName.consume_front(name) || (!curName.is_empty() && !curName.starts_with("$")) {
            continue;
        }
        if pSec.characteristics == chars {
            continue;
        }
        let mut destSec: *mut PartialSection = self.createPartialSection(pSec.name, chars);
        destSec.chunks.insert(destSec.chunks.end(), pSec.chunks.begin(), pSec.chunks.end());
        pSec.chunks.clear();
    }
}

fn Writer::fixGnuImportChunks(self) -> bool {
    let mut rdata: u32 = IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ;
    self.fixPartialSectionChars(".idata", rdata);
    let mut hasIdata: bool = false;
    for it in self.partialSections {
        let mut pSec: *mut PartialSection = it.second;
        if !pSec.name.starts_with(".idata") {
            continue;
        }
        if !pSec.chunks.is_empty() {
            hasIdata = true;
        }
        stable_sort(pSec.chunks, Closure_6 {});
    }
    return hasIdata;
}

fn Writer::addSyntheticIdata(self) {
    let mut rdata: u32 = IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ;
    self.idata.create(self.ctx);
    let mut add: Closure_7 = Closure_7 { cap_0: self, rdata: &mut rdata };
    add.call(".idata$2", self.idata.dirs);
    add.call(".idata$4", self.idata.lookups);
    add.call(".idata$5", self.idata.addresses);
    if !self.idata.hints.is_empty() {
        add.call(".idata$6", self.idata.hints);
    }
    add.call(".idata$7", self.idata.dllNames);
    if !self.idata.auxIat.is_empty() {
        add.call(".idata$9", self.idata.auxIat);
    }
    if !self.idata.auxIatCopy.is_empty() {
        add.call(".idata$a", self.idata.auxIatCopy);
    }
}

fn Writer::appendECImportTables(self) {
    if !isArm64EC(self.ctx.config.machine) {
        return;
    }
    let mut rdata: u32 = IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ;
    if self.findPartialSection(".idata$5", rdata) {
        importAddresses;
    } else {
        if !self.rdataSec.chunks.is_empty() {
            self.rdataSec.chunks.front().setAlignment(if 4096 > self.rdataSec.chunks.front().getAlignment() { 4096 } else { self.rdataSec.chunks.front().getAlignment() });
        }
        self.iatSize = alignTo(self.iatSize, 4096);
        self.rdataSec.chunks.insert(self.rdataSec.chunks.begin(), importAddresses.chunks.begin(), importAddresses.chunks.end());
        self.rdataSec.contribSections.insert(self.rdataSec.contribSections.begin(), importAddresses);
    }
    if self.findPartialSection(".idata$9", rdata) {
        auxIat;
    } else {
        auxIat.chunks.front().setAlignment(4096);
        self.rdataSec.chunks.insert(self.rdataSec.chunks.end(), auxIat.chunks.begin(), auxIat.chunks.end());
        self.rdataSec.addContributingPartialSection(auxIat);
    }
    if !self.delayIdata.getAuxIat().is_empty() {
        self.delayIdata.getAuxIat().front().setAlignment(4096);
        self.rdataSec.chunks.insert(self.rdataSec.chunks.end(), self.delayIdata.getAuxIat().begin(), self.delayIdata.getAuxIat().end());
    }
}

fn Writer::locateImportTables(self) {
    let mut rdata: u32 = IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ;
    if self.findPartialSection(".idata$2", rdata) {
        importDirs;
    } else {
        if !importDirs.chunks.is_empty() {
            self.importTableStart = importDirs.chunks.front();
        }
        for c in importDirs.chunks {
            self.importTableSize += c.getSize();
        }
    }
    if self.findPartialSection(".idata$5", rdata) {
        importAddresses;
    } else {
        if !importAddresses.chunks.is_empty() {
            self.iatStart = importAddresses.chunks.front();
        }
        for c in importAddresses.chunks {
            self.iatSize += c.getSize();
        }
    }
}

fn shouldStripSectionSuffix(sc: *mut SectionChunk, name: str, isMinGW: bool) -> bool {
    if !isMinGW {
        return false;
    }
    if !sc || !sc.isCOMDAT() {
        return false;
    }
    return name.starts_with(".text$") || name.starts_with(".data$") || name.starts_with(".rdata$") || name.starts_with(".pdata$") || name.starts_with(".xdata$") || name.starts_with(".eh_frame$");
}

fn Writer::sortSections(self) {
    if !self.ctx.config.callGraphProfile.is_empty() {
        let mut order: DenseMap<const SectionChunk *, int> = computeCallGraphProfileOrder(self.ctx);
        for it in order {
            if it.first.sym {
                sym;
            } else {
                self.ctx.config.order[sym.getName()] = it.second;
            }
        }
    }
    if !self.ctx.config.order.is_empty() {
        for it in self.partialSections {
            self.sortBySectionOrder(it.second.chunks);
        }
    }
}

fn Writer::calculateStubDependentSizes(self) {
    if self.ctx.config.dosStub {
        self.dosStubSize = alignTo(operator(self.ctx.config.dosStub).getBufferSize(), 8);
    } else {
        self.dosStubSize =  + (dosProgram);
    }
    self.coffHeaderOffset = self.dosStubSize + (PEMagic);
    self.peHeaderOffset = self.coffHeaderOffset + ;
    self.dataDirOffset64 = self.peHeaderOffset + ;
}

fn Writer::createSections(self) {
    let mut timeScope: TimeTraceScope = "Output sections";
    let mut data: u32 = IMAGE_SCN_CNT_INITIALIZED_DATA;
    let mut bss: u32 = IMAGE_SCN_CNT_UNINITIALIZED_DATA;
    let mut code: u32 = IMAGE_SCN_CNT_CODE;
    let mut discardable: u32 = IMAGE_SCN_MEM_DISCARDABLE;
    let mut r: u32 = IMAGE_SCN_MEM_READ;
    let mut w: u32 = IMAGE_SCN_MEM_WRITE;
    let mut x: u32 = IMAGE_SCN_MEM_EXECUTE;
    let mut sections: pair<StringRef, uint32_t>, OutputSection *> = pair<StringRef, uint32_t>, OutputSection *> {};
    let mut createSection: Closure_8 = Closure_8 { sections: &mut sections, cap_1: self };
    self.textSec = createSection.call(".text", code | r | x);
    if isArm64EC(self.ctx.config.machine) {
        self.wowthkSec = createSection.call(".wowthk", code | r | x);
        self.hexpthkSec = createSection.call(".hexpthk", code | r | x);
    }
    self.bssSec = createSection.call(".bss", bss | r | w);
    self.rdataSec = createSection.call(".rdata", data | r);
    self.buildidSec = createSection.call(".buildid", data | r);
    self.cvinfoSec = createSection.call(".cvinfo", data | r);
    self.dataSec = createSection.call(".data", data | r | w);
    self.pdataSec = createSection.call(".pdata", data | r);
    self.idataSec = createSection.call(".idata", data | r);
    self.edataSec = createSection.call(".edata", data | r);
    self.didatSec = createSection.call(".didat", data | r);
    if isArm64EC(self.ctx.config.machine) {
        self.a64xrmSec = createSection.call(".a64xrm", data | r);
    }
    self.rsrcSec = createSection.call(".rsrc", data | r);
    self.relocSec = createSection.call(".reloc", data | discardable | r);
    self.ctorsSec = createSection.call(".ctors", data | r | w);
    self.dtorsSec = createSection.call(".dtors", data | r | w);
    for c in self.ctx.driver.getChunks() {
        let mut sc: *mut SectionChunk = dyn_cast(c);
        if sc && !sc.live {
            if self.ctx.config.verbose {
                sc.printDiscardedMessage();
            }
            continue;
        }
        if dyn_cast(c) {
            cc;
        } else {
            if !cc.live {
                continue;
            }
        }
        let mut name: str = c.getSectionName();
        if shouldStripSectionSuffix(sc, name, self.ctx.config.mingw) {
            name = name.split('$').first;
        }
        if name.starts_with(".tls") {
            self.tlsAlignment = if self.tlsAlignment > c.getAlignment() { self.tlsAlignment } else { c.getAlignment() };
        }
        let mut pSec: *mut PartialSection = self.createPartialSection(name, c.getOutputCharacteristics());
        pSec.chunks.push(c);
    }
    self.fixPartialSectionChars(".rsrc", data | r);
    self.fixPartialSectionChars(".edata", data | r);
    let mut hasIdata: bool = self.fixGnuImportChunks();
    if !self.idata.is_empty() {
        hasIdata = true;
    }
    if hasIdata {
        self.addSyntheticIdata();
    }
    self.sortSections();
    if hasIdata {
        self.locateImportTables();
    }
    for thunk in self.ctx.symtab.sameAddressThunks {
        self.wowthkSec.addChunk(thunk);
    }
    for it in self.partialSections {
        let mut pSec: *mut PartialSection = it.second;
        let mut name: str = getOutputSectionName(pSec.name, self.ctx.config.mingw);
        let mut outChars: u32 = pSec.characteristics;
        if name == ".CRT" {
            outChars = data | r;
            Log(self.ctx) << "Processing section " << pSec.name << " -> " << name;
            self.sortCRTSectionChunks(pSec.chunks);
        }
        if isArm64EC(self.ctx.config.machine) && (pSec.name == ".idata$5" || pSec.name == ".idata$9") {
            continue;
        }
        let mut sec: *mut OutputSection = createSection.call(name, outChars);
        for c in pSec.chunks {
            sec.addChunk(c);
        }
        sec.addContributingPartialSection(pSec);
    }
    if self.ctx.hybridSymtab {
        if self.findSection(".CRT") {
            sec;
        } else {
            sec.splitECChunks();
        }
    }
    let mut sectionOrder: Closure_9 = Closure_9 { cap_0: self };
    stable_sort(self.ctx.outputSections, Closure_10 { sectionOrder: &mut sectionOrder });
}

fn Writer::createMiscChunks(self) {
    let mut timeScope: TimeTraceScope = "Misc chunks";
    let mut config: *mut Configuration = &mut self.ctx.config;
    for p in self.ctx.mergeChunkInstances[..] {
        if p {
            p.finalizeContents();
            self.rdataSec.addChunk(p);
        }
    }
    self.ctx.forEachSymtab(Closure_11 { cap_0: self });
    if config.mingw {
        self.debugInfoSec = self.buildidSec;
    } else if !config.mergeDebugDirectory {
        self.debugInfoSec = self.cvinfoSec;
    } else {
        self.debugInfoSec = self.rdataSec;
    }
    if config.buildIDHash != None || config.debug || config.repro || config.cetCompat || config.cetCompatStrict || config.cetCompatIpValidationRelaxed || config.cetCompatDynamicApisInProcOnly || config.hotpatchCompat {
        self.debugDirectory = make(self.ctx, self.debugRecords, config.repro);
        self.debugDirectory.setAlignment(4);
        self.debugInfoSec.addChunk(self.debugDirectory);
    }
    if config.debug || config.buildIDHash != None {
        self.buildId = make(self.ctx);
        self.debugRecords.push(IMAGE_DEBUG_TYPE_CODEVIEW, self.buildId);
        self.ctx.forEachSymtab(Closure_12 { cap_0: self });
    }
    let mut ex_characteristics_flags: u16 = 0;
    if config.cetCompat {
        ex_characteristics_flags |= IMAGE_DLL_CHARACTERISTICS_EX_CET_COMPAT;
    }
    if config.cetCompatStrict {
        ex_characteristics_flags |= IMAGE_DLL_CHARACTERISTICS_EX_CET_COMPAT_STRICT_MODE;
    }
    if config.cetCompatIpValidationRelaxed {
        ex_characteristics_flags |= IMAGE_DLL_CHARACTERISTICS_EX_CET_SET_CONTEXT_IP_VALIDATION_RELAXED_MODE;
    }
    if config.cetCompatDynamicApisInProcOnly {
        ex_characteristics_flags |= IMAGE_DLL_CHARACTERISTICS_EX_CET_DYNAMIC_APIS_ALLOW_IN_PROC_ONLY;
    }
    if config.hotpatchCompat {
        ex_characteristics_flags |= IMAGE_DLL_CHARACTERISTICS_EX_HOTPATCH_COMPATIBLE;
    }
    if ex_characteristics_flags {
        self.debugRecords.push(IMAGE_DEBUG_TYPE_EX_DLLCHARACTERISTICS, make(ex_characteristics_flags));
    }
    for r in self.debugRecords {
        r.second.setAlignment(4);
        self.debugInfoSec.addChunk(r.second);
    }
    if config.safeSEH {
        self.createSEHTable();
    }
    self.createGuardCFTables();
    self.createECChunks();
    if config.autoImport {
        self.createRuntimePseudoRelocs();
    }
    if config.mingw {
        self.insertCtorDtorSymbols();
        self.insertBssDataStartEndSymbols();
    }
}

fn Writer::createImportTables(self) {
    let mut timeScope: TimeTraceScope = "Import tables";
    for file in self.ctx.importFileInstances {
        if !file.live {
            continue;
        }
        let mut dll: str = file.dllName.lower();
        self.ctx.config.dllOrder.try_emplace(dll, self.ctx.config.dllOrder.len);
        if file.impSym && !isa(file.impSym) {
            Fatal(self.ctx) << file.symtab.printSymbol(file.impSym) << " was replaced";
        }
        let mut impSym: *mut DefinedImportData = cast_or_null(file.impSym);
        if self.ctx.config.delayLoads.contains(file.dllName.lower()) {
            if !file.thunkSym {
                Fatal(self.ctx) << "cannot delay-load " << toString(file) << " due to import of data: " << file.symtab.printSymbol(impSym);
            }
            self.delayIdata.add(impSym);
        } else {
            self.idata.add(impSym);
        }
    }
}

fn Writer::appendImportThunks(self) {
    if self.ctx.importFileInstances.is_empty() {
        return;
    }
    let mut timeScope: TimeTraceScope = "Import thunks";
    for file in self.ctx.importFileInstances {
        if !file.live {
            continue;
        }
        if file.thunkSym {
            if !isa(file.thunkSym) {
                Fatal(self.ctx) << file.symtab.printSymbol(file.thunkSym) << " was replaced";
            }
            let mut chunk: *mut ImportThunkChunk = cast(file.thunkSym).getChunk();
            if chunk.live {
                self.textSec.addChunk(chunk);
            }
        }
        if file.auxThunkSym {
            if !isa(file.auxThunkSym) {
                Fatal(self.ctx) << file.symtab.printSymbol(file.auxThunkSym) << " was replaced";
            }
            let mut chunk: *mut ImportThunkChunk = cast(file.auxThunkSym).getChunk();
            if chunk.live {
                self.textSec.addChunk(chunk);
            }
        }
        if file.impchkThunk {
            self.textSec.addChunk(file.impchkThunk);
        }
    }
    if !self.delayIdata.is_empty() {
        self.delayIdata.create();
        for c in self.delayIdata.getChunks() {
            self.didatSec.addChunk(c);
        }
        for c in self.delayIdata.getDataChunks() {
            self.dataSec.addChunk(c);
        }
        for c in self.delayIdata.getCodeChunks() {
            self.textSec.addChunk(c);
        }
        for c in self.delayIdata.getCodePData() {
            self.pdataSec.addChunk(c);
        }
        for c in self.delayIdata.getAuxIatCopy() {
            self.rdataSec.addChunk(c);
        }
        for c in self.delayIdata.getCodeUnwindInfo() {
            self.rdataSec.addChunk(c);
        }
    }
}

fn Writer::createExportTable(self) {
    let mut timeScope: TimeTraceScope = "Export table";
    if !self.edataSec.chunks.is_empty() {
        if !self.ctx.hybridSymtab {
            self.ctx.symtab.edataStart = self.edataSec.chunks.front();
            self.ctx.symtab.edataEnd = self.edataSec.chunks.back();
        } else {
            stable_sort(self.edataSec.chunks, Closure_13 {});
            for chunk in self.edataSec.chunks {
                if chunk.getMachine() != ARM64 {
                    self.ctx.symtab.edataStart = chunk;
                    self.ctx.symtab.edataEnd = self.edataSec.chunks.back();
                    break;
                }
                if !operator(self.ctx.hybridSymtab).edataStart {
                    operator(self.ctx.hybridSymtab).edataStart = chunk;
                }
                operator(self.ctx.hybridSymtab).edataEnd = chunk;
            }
        }
    }
    self.ctx.forEachActiveSymtab(Closure_14 { cap_0: self });
}

fn Writer::removeUnusedSections(self) {
    let mut timeScope: TimeTraceScope = "Remove unused sections";
    let mut isUnused: Closure_15 = Closure_15 { cap_0: self };
    erase_if(self.ctx.outputSections, isUnused);
}

fn Writer::layoutSections(self) {
    let mut timeScope: TimeTraceScope = "Layout sections";
    if self.ctx.config.sectionOrder.is_empty() {
        return;
    }
    stable_sort(self.ctx.outputSections, Closure_16 { cap_0: self });
}

fn Writer::removeEmptySections(self) {
    let mut timeScope: TimeTraceScope = "Remove empty sections";
    let mut isEmpty: Closure_17 = Closure_17 {};
    erase_if(self.ctx.outputSections, isEmpty);
}

fn Writer::assignOutputSectionIndices(self) {
    let mut timeScope: TimeTraceScope = "Output sections indices";
    let mut idx: u32 = 1;
    for os in self.ctx.outputSections {
        os.sectionIndex = idx;
        for c in os.chunks {
            c.setOutputSectionIdx(idx);
        }
        idx += 1;
    }
    for mc in self.ctx.mergeChunkInstances[..] {
        if mc {
            for sc in mc.sections {
                if sc && sc.live {
                    sc.setOutputSectionIdx(mc.getOutputSectionIdx());
                }
            }
        }
    }
}

fn Writer::createSymbol(self, def: *mut Defined) -> optional<coff_symbol16> {
    let mut sym: coff_symbol16 = coff_symbol16 {};
    match def.kind() {
        DefinedAbsoluteKind => {
            let mut da: *mut DefinedAbsolute = dyn_cast(def);
            sym.Value = da.getVA();
            sym.SectionNumber = IMAGE_SYM_ABSOLUTE;
            break;
        },
        _ => {
            let mut c: *mut Chunk = def.getChunk();
            if !c {
                return nullopt;
            }
            let mut os: *mut OutputSection = self.ctx.getOutputSection(c);
            if !os {
                return nullopt;
            }
            sym.Value = def.getRVA() - os.getRVA();
            sym.SectionNumber = os.sectionIndex;
            break;
        },
    }
    if def.isRuntimePseudoReloc {
        return nullopt;
    }
    let mut name: str = def.getName();
    if name.len > NameSize {
        sym.Name.Offset.Zeroes = 0;
        sym.Name.Offset.Offset = 0;
        self.strtab.add(name, 0);
    } else {
        memset(sym.Name.ShortName, 0, NameSize);
        memcpy(sym.Name.ShortName, name.ptr, name.len);
    }
    if dyn_cast(def) {
        d;
    } else {
        let mut ref: COFFSymbolRef = d.getCOFFSymbol();
        sym.Type = ref.getType();
        sym.StorageClass = ref.getStorageClass();
    }
    sym.NumberOfAuxSymbols = 0;
    return sym;
}

fn Writer::createSymbolAndStringTable(self) {
    let mut timeScope: TimeTraceScope = "Symbol and string table";
    let mut longNameSections: SmallVector<OutputSection *> = SmallVector<OutputSection *> {};
    for sec in self.ctx.outputSections {
        if sec.name.len <= NameSize {
            continue;
        }
        if (sec.header.Characteristics.operator unsigned int() & IMAGE_SCN_MEM_DISCARDABLE) == 0 {
            continue;
        }
        if self.ctx.config.warnLongSectionNames {
            Warn(self.ctx) << "section name " << sec.name << " is longer than 8 characters and will use a non-standard string table";
        }
        self.strtab.add(sec.name, 255);
        longNameSections.push(sec);
    }
    let mut longNameSymbols: []pair<size_t, StringRef> = []pair<size_t, StringRef> {};
    if self.ctx.config.writeSymtab {
        for file in self.ctx.objFileInstances {
            for b in file.getSymbols() {
                let mut d: *mut Defined = dyn_cast_or_null(b);
                if !d || d.writtenToSymtab {
                    continue;
                }
                d.writtenToSymtab = true;
                if dyn_cast_or_null(d) {
                    dc;
                } else {
                    let mut symRef: COFFSymbolRef = dc.getCOFFSymbol();
                    if symRef.isSectionDefinition() || symRef.getStorageClass() == IMAGE_SYM_CLASS_LABEL {
                        continue;
                    }
                }
                if self.createSymbol(d) {
                    sym;
                } else {
                    if d.getName().len > NameSize {
                        longNameSymbols.push(self.outputSymtab.len, d.getName());
                    }
                    self.outputSymtab.push(operator(sym));
                }
                if dyn_cast(d) {
                    dthunk;
                } else {
                    if !dthunk.wrappedSym.writtenToSymtab {
                        dthunk.wrappedSym.writtenToSymtab = true;
                        if self.createSymbol(dthunk.wrappedSym) {
                            sym;
                        } else {
                            if dthunk.wrappedSym.getName().len > NameSize {
                                longNameSymbols.push(self.outputSymtab.len, dthunk.wrappedSym.getName());
                            }
                            self.outputSymtab.push(operator(sym));
                        }
                    }
                }
            }
        }
    }
    if self.outputSymtab.is_empty() && self.strtab.is_empty() {
        return;
    }
    self.strtab.finalize();
    for sec in longNameSections {
        sec.setStringTableOff(self.strtab.getOffset(sec.name));
    }
    for P in longNameSymbols {
        let mut sym: *mut coff_symbol16 = self.outputSymtab[P.first];
        sym.Name.Offset.Offset = self.strtab.getOffset(P.second);
    }
    let mut fileOff: u64 = self.fileSize;
    self.pointerToSymbolTable = fileOff;
    fileOff += self.outputSymtab.len * ;
    fileOff += self.strtab.getSize();
    self.fileSize = alignTo(fileOff, self.ctx.config.fileAlign);
}

fn Writer::getMergeDestination(self, fromSection: str, toSection: str) -> str {
    let mut names: StringSet<> = StringSet<> {};
    while true {
        if !names.insert(toSection).second {
            Fatal(self.ctx) << "/merge: cycle found for section '" << fromSection << "'";
        }
        let mut i: iterator = self.ctx.config.merge.find(toSection);
        if i == self.ctx.config.merge.end() {
            break;
        }
        toSection = operator(i).second;
    }
    return toSection;
}

fn Writer::mergeSection(self, p: *value_type) {
    if p.first == p.second {
        return;
    }
    let mut toSection: str = self.getMergeDestination(p.first, p.second);
    let mut from: *mut OutputSection = self.findSection(p.first);
    let mut to: *mut OutputSection = self.findSection(toSection);
    if !from {
        return;
    }
    if !to {
        from.name = toSection;
        return;
    }
    to.merge(from);
}

fn Writer::mergeSections(self) {
    let mut timeScope: TimeTraceScope = "Merge sections";
    if !self.pdataSec.chunks.is_empty() {
        if isArm64EC(self.ctx.config.machine) {
            stable_sort(self.pdataSec.chunks, Closure_18 {});
            for chunk in self.pdataSec.chunks {
                if chunk.getMachine() == AMD64 {
                    self.hybridPdata.first = chunk;
                    self.hybridPdata.last = self.pdataSec.chunks.back();
                    break;
                }
                if !self.pdata.first {
                    self.pdata.first = chunk;
                }
                self.pdata.last = chunk;
            }
        } else {
            self.pdata.first = self.pdataSec.chunks.front();
            self.pdata.last = self.pdataSec.chunks.back();
        }
    }
    for p in self.ctx.config.merge {
        if p.first != ".bss" {
            self.mergeSection(p);
        }
    }
    let mut it: iterator = self.ctx.config.merge.find(".bss");
    if !it == self.ctx.config.merge.end() {
        let mut toSection: str = self.getMergeDestination(operator(it).first, operator(it).second);
        let mut secIt: iterator = self.ctx.config.section.find(toSection);
        if secIt == self.ctx.config.section.end() || !(operator(secIt).second & IMAGE_SCN_MEM_SHARED) {
            self.mergeSection(value_type { operator(it).first, toSection });
        }
    }
}

fn Writer::sortECChunks(self) {
    if !isArm64EC(self.ctx.config.machine) {
        return;
    }
    for sec in self.ctx.outputSections {
        if sec.isCodeSection() {
            stable_sort(sec.chunks, Closure_19 {});
        }
    }
}

fn Writer::assignAddresses(self) {
    let mut timeScope: TimeTraceScope = "Assign addresses";
    let mut config: *mut Configuration = &mut self.ctx.config;
    self.createECCodeMap();
    self.sizeOfHeaders = self.dosStubSize + (PEMagic) +  +  * numberOfDataDirectory +  * self.ctx.outputSections.len;
    self.sizeOfHeaders += if config.is64() {  } else {  };
    self.sizeOfHeaders = alignTo(self.sizeOfHeaders, config.fileAlign);
    self.fileSize = self.sizeOfHeaders;
    let mut rva: u64 = alignTo(self.sizeOfHeaders, config.align);
    for sec in self.ctx.outputSections {
        let mut timeScope: TimeTraceScope = TimeTraceScope { "Section: ", sec.name };
        if sec == self.relocSec {
            sec.chunks.clear();
            self.addBaserels();
            if self.ctx.dynamicRelocs {
                self.ctx.dynamicRelocs.finalize();
                self.relocSec.addChunk(self.ctx.dynamicRelocs);
            }
        }
        let mut rawSize: u64 = 0;
        let mut virtualSize: u64 = 0;
        sec.header.VirtualAddress = rva;
        let mut padding: u32 = if sec.isCodeSection() { config.functionPadMin } else { 0 };
        let mut prevECRange: optional<chpe_range_type> = optional<chpe_range_type> {};
        for c in sec.chunks {
            if isArm64EC(self.ctx.config.machine) && sec.isCodeSection() {
                let mut rangeType: optional<chpe_range_type> = c.getArm64ECRangeType();
                if rangeType != prevECRange {
                    virtualSize = alignTo(virtualSize, 4096);
                    prevECRange = rangeType;
                }
            }
            if padding && c.isHotPatchable() {
                virtualSize += padding;
            }
            if c.getEntryThunk() {
                virtualSize += ;
            }
            virtualSize = alignTo(virtualSize, c.getAlignment());
            c.setRVA(rva + virtualSize);
            virtualSize += c.getSize();
            if c.hasData {
                rawSize = alignTo(virtualSize, config.fileAlign);
            }
        }
        if virtualSize > 4294967295 {
            Err(self.ctx) << "section larger than 4 GiB: " << sec.name;
        }
        sec.header.VirtualSize = virtualSize;
        sec.header.SizeOfRawData = rawSize;
        if rawSize != 0 {
            sec.header.PointerToRawData = self.fileSize;
        }
        rva += alignTo(virtualSize, config.align);
        self.fileSize += alignTo(rawSize, config.fileAlign);
    }
    self.sizeOfImage = alignTo(rva, config.align);
    for mc in self.ctx.mergeChunkInstances[..] {
        if mc {
            mc.assignSubsectionRVAs();
        }
    }
}

fn Writer::openFile(self, path: str) {
    self.buffer = check2((create(path, self.fileSize, F_executable)), string ()> { Closure_20 { path: &mut path }, null, null });
}

fn Writer::createSEHTable(self) {
    let mut handlers: SymbolRVASet = SymbolRVASet {};
    for file in self.ctx.objFileInstances {
        if !file.hasSafeSEH() {
            Err(self.ctx) << "/safeseh: " << file.getName() << " is not compatible with SEH";
        }
        self.markSymbolsForRVATable(file, file.getSXDataChunks(), handlers);
    }
    self.setNoSEHCharacteristic = handlers.is_empty() || !self.ctx.symtab.findUnderscore("_load_config_used");
    self.maybeAddRVATable(move(handlers), "__safe_se_handler_table", "__safe_se_handler_count", false);
}

fn addSymbolToRVASet(rvaSet: *mut SymbolRVASet, s: *mut Defined) {
    let mut c: *mut Chunk = s.getChunk();
    if !c {
        return;
    }
    if dyn_cast(c) {
        sc;
    } else {
        c = sc.repl;
    }
    let mut off: u32 = s.getRVA() - (if c { c.getRVA() } else { 0 });
    rvaSet.insert(ChunkAndOffset { inputChunk: c, offset: off });
}

fn maybeAddAddressTakenFunction(addressTakenSyms: *mut SymbolRVASet, s: *mut Symbol) {
    if !s {
        return;
    }
    match s.kind() {
        DefinedLocalImportKind => {
            DefinedImportDataKind;
        },
        DefinedCommonKind => {
            break;
        },
        DefinedAbsoluteKind => {
            break;
        },
        DefinedSyntheticKind => {
            if dyn_cast_or_null(cast(s).getChunk()) {
                expChunk;
            } else {
                addSymbolToRVASet(addressTakenSyms, cast(s));
                addSymbolToRVASet(addressTakenSyms, expChunk.target);
            }
        },
        LazyArchiveKind => {
            LazyObjectKind;
        },
        DefinedImportThunkKind => {
            addSymbolToRVASet(addressTakenSyms, cast(s));
        },
        DefinedRegularKind => {
            let mut d: *mut DefinedRegular = cast(s);
            if d.getCOFFSymbol().getComplexType() == IMAGE_SYM_DTYPE_FUNCTION {
                let mut sc: *mut SectionChunk = dyn_cast(d.getChunk());
                if sc && sc.live && sc.getOutputCharacteristics() & IMAGE_SCN_MEM_EXECUTE {
                    addSymbolToRVASet(addressTakenSyms, d);
                }
            }
            break;
        },
    }
}

fn Writer::markSymbolsWithRelocations(self, file: *mut ObjFile, usedSymbols: *mut SymbolRVASet) {
    for c in file.getChunks() {
        let mut sc: *mut SectionChunk = dyn_cast(c);
        if !sc || !sc.live {
            continue;
        }
        for reloc in sc.getRelocs() {
            if self.ctx.config.machine == I386 && reloc.Type.operator unsigned short() == IMAGE_REL_I386_REL32 {
                continue;
            }
            let mut ref: *mut Symbol = sc.file.getSymbol(reloc.SymbolTableIndex.operator unsigned int());
            maybeAddAddressTakenFunction(usedSymbols, ref);
        }
    }
}

fn Writer::createGuardCFTables(self) {
    let mut config: *mut Configuration = &mut self.ctx.config;
    if config.guardCF == Off {
        for file in self.ctx.objFileInstances {
            if file.hasGuardCF() {
                self.ctx.forEachSymtab(Closure_21 {});
                break;
            }
        }
        return;
    }
    let mut addressTakenSyms: SymbolRVASet = SymbolRVASet {};
    let mut giatsRVASet: SymbolRVASet = SymbolRVASet {};
    let mut giatsSymbols: []*mut Symbol = []*mut Symbol {};
    let mut longJmpTargets: SymbolRVASet = SymbolRVASet {};
    let mut ehContTargets: SymbolRVASet = SymbolRVASet {};
    for file in self.ctx.objFileInstances {
        if file.hasGuardCF() {
            self.markSymbolsForRVATable(file, file.getGuardFidChunks(), addressTakenSyms);
            self.markSymbolsForRVATable(file, file.getGuardIATChunks(), giatsRVASet);
            self.getSymbolsFromSections(file, file.getGuardIATChunks(), giatsSymbols);
            self.markSymbolsForRVATable(file, file.getGuardLJmpChunks(), longJmpTargets);
        } else {
            self.markSymbolsWithRelocations(file, addressTakenSyms);
        }
        if file.hasGuardEHCont() {
            self.markSymbolsForRVATable(file, file.getGuardEHContChunks(), ehContTargets);
        }
    }
    self.ctx.forEachSymtab(Closure_22 { addressTakenSyms: &mut addressTakenSyms });
    for s in giatsSymbols {
        if dyn_cast(s) {
            di;
        } else {
            if di.loadThunkSym {
                addSymbolToRVASet(addressTakenSyms, di.loadThunkSym);
            }
        }
    }
    for c in addressTakenSyms {
        if c.inputChunk.getAlignment() < 16 {
            c.inputChunk.setAlignment(16);
        }
    }
    self.maybeAddRVATable(move(addressTakenSyms), "__guard_fids_table", "__guard_fids_count", false);
    self.maybeAddRVATable(move(giatsRVASet), "__guard_iat_table", "__guard_iat_count", false);
    if config.guardCF & LongJmp {
        self.maybeAddRVATable(move(longJmpTargets), "__guard_longjmp_table", "__guard_longjmp_count", false);
    }
    if config.guardCF & EHCont {
        self.maybeAddRVATable(move(ehContTargets), "__guard_eh_cont_table", "__guard_eh_cont_count", false);
    }
    let mut guardFlags: u32 = CF_INSTRUMENTED | CF_FUNCTION_TABLE_PRESENT;
    if config.guardCF & LongJmp {
        guardFlags |= CF_LONGJUMP_TABLE_PRESENT;
    }
    if config.guardCF & EHCont {
        guardFlags |= EH_CONTINUATION_TABLE_PRESENT;
    }
    self.ctx.forEachSymtab(Closure_23 { guardFlags: guardFlags });
}

fn Writer::getSymbolsFromSections(self, file: *mut ObjFile, symIdxChunks: ArrayRef<SectionChunk *>, symbols: *mut []*mut Symbol) {
    for c in symIdxChunks {
        if !c.live {
            continue;
        }
        let mut data: ArrayRef<uint8_t> = c.getContents();
        if data.len % 4 != 0 {
            Warn(self.ctx) << "ignoring " << c.getSectionName() << " symbol table index section in object " << file;
            continue;
        }
        let mut symIndices: ArrayRef<ulittle32_t> = ArrayRef<ulittle32_t> { data.ptr as *ulittle32_t, data.len / 4 };
        let mut objSymbols: ArrayRef<Symbol *> = file.getSymbols();
        for symIndex in symIndices {
            if symIndex >= objSymbols.len {
                Warn(self.ctx) << "ignoring invalid symbol table index in section " << c.getSectionName() << " in object " << file;
                continue;
            }
            if objSymbols[symIndex] {
                s;
            } else {
                if s.isLive() {
                    symbols.push(cast(s));
                }
            }
        }
    }
}

fn Writer::markSymbolsForRVATable(self, file: *mut ObjFile, symIdxChunks: ArrayRef<SectionChunk *>, tableSymbols: *mut SymbolRVASet) {
    let mut syms: []*mut Symbol = []*mut Symbol {};
    self.getSymbolsFromSections(file, symIdxChunks, syms);
    for s in syms {
        addSymbolToRVASet(tableSymbols, cast(s));
    }
}

fn Writer::maybeAddRVATable(self, tableSymbols: SymbolRVASet, tableSym: str, countSym: str, hasFlag: bool) {
    if tableSymbols.is_empty() {
        return;
    }
    let mut tableChunk: *mut NonSectionChunk = null;
    if hasFlag {
        tableChunk = make(move(tableSymbols));
    } else {
        tableChunk = make(move(tableSymbols));
    }
    self.rdataSec.addChunk(tableChunk);
    self.ctx.forEachSymtab(Closure_24 { tableSym: &mut tableSym, countSym: &mut countSym, tableChunk: &mut tableChunk, hasFlag: &mut hasFlag });
}

fn Writer::createECChunks(self) {
    if !self.ctx.symtab.isEC() {
        return;
    }
    for s in self.ctx.symtab.expSymbols {
        let mut sym: CastReturnType = dyn_cast(s);
        if !sym || !sym.getChunk() {
            continue;
        }
        if dyn_cast(sym.getChunk()) {
            thunk;
        } else {
            self.hexpthkSec.addChunk(thunk);
            self.exportThunks.push(Defined *> { thunk, thunk.target });
        }
    }
    let mut codeMapChunk: *mut ECCodeMapChunk = make(self.codeMap);
    self.rdataSec.addChunk(codeMapChunk);
    let mut codeMapSym: *mut Symbol = self.ctx.symtab.findUnderscore("__hybrid_code_map");
    replaceSymbol(codeMapSym, codeMapSym.getName(), codeMapChunk);
    let mut ranges: *mut CHPECodeRangesChunk = make(self.exportThunks);
    self.rdataSec.addChunk(ranges);
    let mut rangesSym: *mut Symbol = self.ctx.symtab.findUnderscore("__x64_code_ranges_to_entry_points");
    replaceSymbol(rangesSym, rangesSym.getName(), ranges);
    let mut entryPoints: *mut CHPERedirectionChunk = make(self.exportThunks);
    self.a64xrmSec.addChunk(entryPoints);
    let mut entryPointsSym: *mut Symbol = self.ctx.symtab.findUnderscore("__arm64x_redirection_metadata");
    replaceSymbol(entryPointsSym, entryPointsSym.getName(), entryPoints);
    for thunk in self.ctx.symtab.sameAddressThunks {
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, Arm64XRelocVal { thunk, 0 }, Arm64XRelocVal { 0 });
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, Arm64XRelocVal { thunk,  }, Arm64XRelocVal { 0 });
    }
}

fn Writer::createRuntimePseudoRelocs(self) {
    self.ctx.forEachSymtab(Closure_25 { cap_0: self });
}

fn Writer::insertCtorDtorSymbols(self) {
    self.ctx.forEachSymtab(Closure_26 { cap_0: self });
    if self.ctx.hybridSymtab {
        self.ctorsSec.splitECChunks();
        self.dtorsSec.splitECChunks();
    }
}

fn Writer::insertBssDataStartEndSymbols(self) {
    if !self.dataSec.chunks.is_empty() {
        let mut dataStartSym: *mut Symbol = self.ctx.symtab.find("__data_start__");
        let mut dataEndSym: *mut Symbol = self.ctx.symtab.find("__data_end__");
        let mut endChunk: *mut Chunk = self.dataSec.chunks.back();
        replaceSymbol(dataStartSym, dataStartSym.getName(), self.dataSec.chunks.front());
        replaceSymbol(dataEndSym, dataEndSym.getName(), endChunk, endChunk.getSize());
    }
    if !self.bssSec.chunks.is_empty() {
        let mut bssStartSym: *mut Symbol = self.ctx.symtab.find("__bss_start__");
        let mut bssEndSym: *mut Symbol = self.ctx.symtab.find("__bss_end__");
        let mut endChunk: *mut Chunk = self.bssSec.chunks.back();
        replaceSymbol(bssStartSym, bssStartSym.getName(), self.bssSec.chunks.front());
        replaceSymbol(bssEndSym, bssEndSym.getName(), endChunk, endChunk.getSize());
    }
}

fn Writer::setSectionPermissions(self) {
    let mut timeScope: TimeTraceScope = "Sections permissions";
    for p in self.ctx.config.section {
        let mut name: str = p.first;
        let mut perm: u32 = p.second;
        for sec in self.ctx.outputSections {
            if sec.name == name {
                sec.setPermissions(perm);
            }
        }
    }
}

fn Writer::setECSymbols(self) {
    if !self.ctx.symtab.isEC() {
        return;
    }
    stable_sort(self.exportThunks, Closure_27 {});
    let mut chpePdata: *mut ChunkRange = if self.ctx.config.machine == ARM64X { self.hybridPdata } else { self.pdata };
    let mut rfeTableSym: *mut Symbol = self.ctx.symtab.findUnderscore("__arm64x_extra_rfe_table");
    replaceSymbol(rfeTableSym, "__arm64x_extra_rfe_table", chpePdata.first);
    if chpePdata.first {
        let mut rfeSizeSym: *mut Symbol = self.ctx.symtab.findUnderscore("__arm64x_extra_rfe_table_size");
        cast(rfeSizeSym).setVA(chpePdata.last.getRVA() + chpePdata.last.getSize() - chpePdata.first.getRVA());
    }
    let mut rangesCountSym: *mut Symbol = self.ctx.symtab.findUnderscore("__x64_code_ranges_to_entry_points_count");
    cast(rangesCountSym).setVA(self.exportThunks.len);
    let mut entryPointCountSym: *mut Symbol = self.ctx.symtab.findUnderscore("__arm64x_redirection_metadata_count");
    cast(entryPointCountSym).setVA(self.exportThunks.len);
    let mut iatSym: *mut Symbol = self.ctx.symtab.findUnderscore("__hybrid_auxiliary_iat");
    replaceSymbol(iatSym, "__hybrid_auxiliary_iat", if self.idata.auxIat.is_empty() { null } else { self.idata.auxIat.front() });
    let mut iatCopySym: *mut Symbol = self.ctx.symtab.findUnderscore("__hybrid_auxiliary_iat_copy");
    replaceSymbol(iatCopySym, "__hybrid_auxiliary_iat_copy", if self.idata.auxIatCopy.is_empty() { null } else { self.idata.auxIatCopy.front() });
    let mut delayIatSym: *mut Symbol = self.ctx.symtab.findUnderscore("__hybrid_auxiliary_delayload_iat");
    replaceSymbol(delayIatSym, "__hybrid_auxiliary_delayload_iat", if self.delayIdata.getAuxIat().is_empty() { null } else { self.delayIdata.getAuxIat().front() });
    let mut delayIatCopySym: *mut Symbol = self.ctx.symtab.findUnderscore("__hybrid_auxiliary_delayload_iat_copy");
    replaceSymbol(delayIatCopySym, "__hybrid_auxiliary_delayload_iat_copy", if self.delayIdata.getAuxIatCopy().is_empty() { null } else { self.delayIdata.getAuxIatCopy().front() });
    if self.ctx.config.machine == ARM64X {
        if cast_or_null(self.ctx.symtab.entry) {
            altEntrySym;
        } else {
            if dyn_cast(altEntrySym.getChunk()) {
                thunkChunk;
            } else {
                altEntrySym = thunkChunk.target;
            }
            self.ctx.symtab.findUnderscore("__arm64x_native_entrypoint").replaceKeepingName(altEntrySym, sizeof);
        }
        if self.ctx.symtab.edataStart {
            self.ctx.dynamicRelocs.set(self.dataDirOffset64 + EXPORT_TABLE *  + , self.ctx.symtab.edataEnd.getRVA() - self.ctx.symtab.edataStart.getRVA() + self.ctx.symtab.edataEnd.getSize());
        }
        if self.hybridPdata.first {
            self.ctx.dynamicRelocs.set(self.dataDirOffset64 + EXCEPTION_TABLE *  + , self.hybridPdata.last.getRVA() - self.hybridPdata.first.getRVA() + self.hybridPdata.last.getSize());
        }
        if self.chpeSym && self.pdata.first {
            self.ctx.dynamicRelocs.set(self.chpeSym.getRVA() + , self.pdata.last.getRVA() + self.pdata.last.getSize() - self.pdata.first.getRVA());
        }
    }
    for thunk in self.ctx.symtab.sameAddressThunks {
        thunk.setDynamicRelocs(self.ctx);
    }
}

fn Writer::writeSections(self) {
    let mut timeScope: TimeTraceScope = "Write sections";
    let mut buf: *mut u8 = operator(self.buffer).getBufferStart();
    for sec in self.ctx.outputSections {
        let mut secBuf: *mut u8 = buf + sec.getFileOff();
        if (sec.header.Characteristics.operator unsigned int() & IMAGE_SCN_CNT_CODE) && (self.ctx.config.machine == AMD64 || self.ctx.config.machine == I386) {
            let mut prevEnd: u32 = 0;
            let mut rawSize: u32 = sec.getRawSize();
            for c in sec.chunks {
                let mut off: u32 = c.getRVA() - sec.getRVA();
                if off >= rawSize {
                    break;
                }
                memset(secBuf + prevEnd, 204, off - prevEnd);
                prevEnd = if off + c.getSize() as u32 < rawSize { off + c.getSize() as u32 } else { rawSize };
            }
            memset(secBuf + prevEnd, 204, rawSize - prevEnd);
        }
        parallelForEach(sec.chunks, Closure_28 { secBuf: &mut secBuf, sec: &mut sec });
    }
}

fn Writer::writeBuildId(self) {
    let mut timeScope: TimeTraceScope = "Write build ID";
    let mut config: *mut Configuration = &mut self.ctx.config;
    let mut generateSyntheticBuildId: bool = config.buildIDHash == Binary;
    if generateSyntheticBuildId {
        assert!(self.buildId, "BuildId is not set!");
    }
    let mut outputFileData: str = operator(self.buffer).getBufferStart() as *u8[0..operator(self.buffer).getBufferSize()];
    let mut timestamp: u32 = config.timestamp;
    let mut hash: u64 = 0;
    if config.repro || generateSyntheticBuildId {
        hash = xxh3_64bits(outputFileData);
    }
    if config.repro {
        timestamp = hash as u32;
    }
    if generateSyntheticBuildId {
        self.buildId.buildId.PDB70.CVSignature = PDB70;
        self.buildId.buildId.PDB70.Age = 1;
        memcpy(self.buildId.buildId.PDB70.Signature, &mut hash, 8);
        memcpy(&mut self.buildId.buildId.PDB70.Signature[8], "LLD PDB.", 8);
    }
    if self.debugDirectory {
        self.debugDirectory.setTimeDateStamp(timestamp);
    }
    let mut buf: *mut u8 = operator(self.buffer).getBufferStart();
    buf += self.dosStubSize + (PEMagic);
    let mut coffHeader: *mut coff_file_header = buf as *mut coff_file_header;
    coffHeader.TimeDateStamp = timestamp;
}

fn Writer::sortExceptionTables(self) {
    let mut timeScope: TimeTraceScope = "Sort exception table";
    match self.ctx.config.machine {
        AMD64 => {
            self.sortExceptionTable(self.pdata);
        },
        ARM64EC => {
            ARM64X;
        },
        ARMNT => {
            ARM64;
        },
        _ => {
            if self.pdata.first {
                self.ctx.e.errs() << "warning: don't know how to handle .pdata\n";
            }
        },
    }
}

fn Writer::sortCRTSectionChunks(self, chunks: *mut []*mut Chunk) {
    let mut sectionChunkOrder: Closure_29 = Closure_29 {};
    stable_sort(chunks, sectionChunkOrder);
    if self.ctx.config.verbose {
        for c in chunks {
            let mut sc: CastReturnType = dyn_cast(c);
            Log(self.ctx) << "  " << sc.file.mb.getBufferIdentifier() << ", SectionID: " << sc.getSectionNumber();
        }
    }
}

fn Writer::findSection(self, name: str) -> *mut OutputSection {
    for sec in self.ctx.outputSections {
        if sec.name == name {
            return sec;
        }
    }
    return null;
}

fn Writer::getSizeOfInitializedData(self) -> u32 {
    let mut res: u32 = 0;
    for s in self.ctx.outputSections {
        if s.header.Characteristics.operator unsigned int() & IMAGE_SCN_CNT_INITIALIZED_DATA {
            res += s.getRawSize();
        }
    }
    return res;
}

fn Writer::addBaserels(self) {
    if !self.ctx.config.relocatable {
        return;
    }
    let mut v: []Baserel = []Baserel {};
    for sec in self.ctx.outputSections {
        if sec.header.Characteristics.operator unsigned int() & IMAGE_SCN_MEM_DISCARDABLE {
            continue;
        }
        let mut timeScope: TimeTraceScope = TimeTraceScope { "Base relocations: ", sec.name };
        for c in sec.chunks {
            c.getBaserels(&mut v);
        }
        if !v.is_empty() {
            self.addBaserelBlocks(v);
        }
        v.clear();
    }
}

fn Writer::addBaserelBlocks(self, v: *mut []Baserel) {
    let mut mask: u32 = ~pageSize - 1;
    let mut page: u32 = v[0].rva & mask;
    let mut i: u64 = 0;
    let mut j: u64 = 1;
    sort(v, Closure_30 {});
    for let mut e: u64 = v.len; j < e; j += 1 {
        let mut p: u32 = v[j].rva & mask;
        if p == page {
            continue;
        }
        self.relocSec.addChunk(make(page, &mut v[i], &mut v[0] + j));
        i = j;
        page = p;
    }
    if i == j {
        return;
    }
    self.relocSec.addChunk(make(page, &mut v[i], &mut v[0] + j));
}

fn Writer::createDynamicRelocs(self) {
    if !self.ctx.dynamicRelocs {
        return;
    }
    self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.coffHeaderOffset + , AMD64);
    if self.ctx.symtab.entry != operator(self.ctx.hybridSymtab).entry || self.pdata.first != self.hybridPdata.first {
        self.chpeSym = cast_or_null(self.ctx.symtab.findUnderscore("__chpe_metadata"));
        if !self.chpeSym {
            Warn(self.ctx) << "'__chpe_metadata' is missing for ARM64X target";
        }
    }
    if self.ctx.symtab.entry != operator(self.ctx.hybridSymtab).entry {
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.peHeaderOffset + , Arm64XRelocVal { cast_or_null(self.ctx.symtab.entry), 0 });
        if self.chpeSym {
            self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, Arm64XRelocVal { self.chpeSym,  }, Arm64XRelocVal { cast_or_null(operator(self.ctx.hybridSymtab).entry), 0 });
        }
    }
    if self.ctx.symtab.edataStart != operator(self.ctx.hybridSymtab).edataStart {
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.dataDirOffset64 + EXPORT_TABLE *  + , Arm64XRelocVal { self.ctx.symtab.edataStart, 0 });
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.dataDirOffset64 + EXPORT_TABLE *  + , Arm64XRelocVal { 0 });
    }
    if self.pdata.first != self.hybridPdata.first {
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.dataDirOffset64 + EXCEPTION_TABLE *  + , Arm64XRelocVal { self.hybridPdata.first, 0 });
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.dataDirOffset64 + EXCEPTION_TABLE *  + , Arm64XRelocVal { 0 });
        if self.chpeSym {
            self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, Arm64XRelocVal { self.chpeSym,  }, Arm64XRelocVal { self.pdata.first, 0 });
            self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, Arm64XRelocVal { self.chpeSym,  }, Arm64XRelocVal { 0 });
        }
    }
    self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.dataDirOffset64 + LOAD_CONFIG_TABLE *  + , Arm64XRelocVal { self.ctx.symtab.loadConfigSym, 0 });
    self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.dataDirOffset64 + LOAD_CONFIG_TABLE *  + , self.ctx.symtab.loadConfigSize);
    let mut nativeTlsUsed: CastReturnType = dyn_cast_or_null(operator(self.ctx.hybridSymtab).findUnderscore("_tls_used"));
    let mut ecTlsUsed: CastReturnType = dyn_cast_or_null(self.ctx.symtab.findUnderscore("_tls_used"));
    if nativeTlsUsed || ecTlsUsed {
        self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.dataDirOffset64 + TLS_TABLE *  + , Arm64XRelocVal { ecTlsUsed, 0 });
        if !nativeTlsUsed || !ecTlsUsed {
            self.ctx.dynamicRelocs.add(IMAGE_DVRT_ARM64X_FIXUP_TYPE_VALUE, sizeof, self.dataDirOffset64 + TLS_TABLE *  + , if ecTlsUsed {  } else { 0 });
        }
    }
}

fn Writer::createPartialSection(self, name: str, outChars: u32) -> *mut PartialSection {
    let mut pSec: *mut *mut PartialSection = self.partialSections[key_type { name, outChars }];
    if pSec {
        return pSec;
    }
    pSec = make(name, outChars);
    return pSec;
}

fn Writer::findPartialSection(self, name: str, outChars: u32) -> *mut PartialSection {
    let mut it: iterator = self.partialSections.find(key_type { name, outChars });
    if !it == self.partialSections.end() {
        return operator(it).second;
    }
    return null;
}

fn Writer::fixTlsAlignment(self, symtab: *mut SymbolTable) {
    let mut tlsSym: *mut Defined = dyn_cast_or_null(symtab.findUnderscore("_tls_used"));
    if !tlsSym {
        return;
    }
    let mut sec: *mut OutputSection = self.ctx.getOutputSection(tlsSym.getChunk());
    assert!(sec && tlsSym.getRVA() >= sec.getRVA(), "no output section for _tls_used");
    let mut secBuf: *mut u8 = operator(self.buffer).getBufferStart() + sec.getFileOff();
    let mut tlsOffset: u64 = tlsSym.getRVA() - sec.getRVA();
    let mut directorySize: u64 = if self.ctx.config.is64() {  } else {  };
    if tlsOffset + directorySize > sec.getRawSize() {
        Fatal(self.ctx) << "_tls_used sym is malformed";
    }
    if self.ctx.config.is64() {
        let mut tlsDir: *mut coff_tls_directory64 = &mut secBuf[tlsOffset] as *mut coff_tls_directory64;
        tlsDir.setAlignment(self.tlsAlignment);
    } else {
        let mut tlsDir: *mut coff_tls_directory32 = &mut secBuf[tlsOffset] as *mut coff_tls_directory32;
        tlsDir.setAlignment(self.tlsAlignment);
    }
}

