static mut dosProgram: [56]u8 = [14, 31, 186, 14, 0, 180, 9, 205, 33, 184, 1, 76, 205, 33, 84, 104, 105, 115, 32, 112, 114, 111, 103, 114, 97, 109, 32, 99, 97, 110, 110, 111, 116, 32, 98, 101, 32, 114, 117, 110, 32, 105, 110, 32, 68, 79, 83, 32, 109, 111, 100, 101, 46, 36, 0, 0];

const numberOfDataDirectory: i32 = 16;

struct DebugDirectoryChunk {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    timeDateStamps: []*mut ulittle32_t,
    records: *[]DebugType, Chunk *>,
    writeRepro: bool,
    ctx: *COFFLinkerContext,
}

fn DebugDirectoryChunk::getSize(self: *DebugDirectoryChunk) -> u64 {
    return (self.records.len + self.writeRepro) * ;
}

fn DebugDirectoryChunk::writeTo(self: *DebugDirectoryChunk, b: *mut u8) {
    let mut d: *mut debug_directory = b as *mut debug_directory;
    for record in self.records {
        let mut c: *mut Chunk = record.second;
        let mut os: *OutputSection = self.ctx.getOutputSection(c);
        let mut offs: u64 = os.getFileOff() + (c.getRVA() - os.getRVA());
        self.fillEntry(d, record.first, c.getSize(), c.getRVA(), offs);
        d += 1;
    }
    if self.writeRepro {
        self.fillEntry(d, IMAGE_DEBUG_TYPE_REPRO, 0, 0, 0);
    }
}

fn DebugDirectoryChunk::setTimeDateStamp(self, timeDateStamp: u32) {
    for tds in self.timeDateStamps {
        *tds = timeDateStamp;
    }
}

fn DebugDirectoryChunk::fillEntry(self: *DebugDirectoryChunk, d: *mut debug_directory, debugType: DebugType, size: u64, rva: u64, offs: u64) {
    d.Characteristics = 0;
    d.TimeDateStamp = 0;
    d.MajorVersion = 0;
    d.MinorVersion = 0;
    d.Type = debugType;
    d.SizeOfData = size;
    d.AddressOfRawData = rva;
    d.PointerToRawData = offs;
    self.timeDateStamps.push(&mut d.TimeDateStamp);
}

fn DebugDirectoryChunk::kind(self: *DebugDirectoryChunk) -> Kind {
    return self.chunkKind;
}

fn DebugDirectoryChunk::getAlignment(self: *DebugDirectoryChunk) -> u32 {
    return 1 << self.p2Align;
}

fn DebugDirectoryChunk::setAlignment(self, align: u32) {
    align = if align { align } else { 1 };
    assert!(isPowerOf2_32(align), "alignment is not a power of 2");
    self.p2Align = Log2_32(align);
    assert!(self.p2Align <= Log2MaxSectionAlignment, "impossible requested alignment");
}

fn DebugDirectoryChunk::getRVA(self: *DebugDirectoryChunk) -> u32 {
    return self.rva;
}

fn DebugDirectoryChunk::setRVA(self, v: u64) {
    self.rva = v as u32;
}

fn DebugDirectoryChunk::setOutputSectionIdx(self, o: u16) {
    self.osidx = o;
}

fn DebugDirectoryChunk::getOutputSectionIdx(self: *DebugDirectoryChunk) -> u16 {
    return self.osidx;
}

fn DebugDirectoryChunk::getOutputCharacteristics(self: *DebugDirectoryChunk) -> u32 {
    return 0;
}

fn DebugDirectoryChunk::getSectionName(self: *DebugDirectoryChunk) -> str {
    llvm_unreachable_internal("unimplemented getSectionName", "P:/Goraw/llvm-project/lld/COFF\\Chunks.h", 176);
}

fn DebugDirectoryChunk::getBaserels(self, res: *mut []Baserel) {}

fn DebugDirectoryChunk::getMachine(self: *DebugDirectoryChunk) -> MachineTypes {
    return IMAGE_FILE_MACHINE_UNKNOWN;
}

fn DebugDirectoryChunk::getDebugName(self: *DebugDirectoryChunk) -> str {
    return "";
}

fn DebugDirectoryChunk::verifyRanges(self) -> bool {
    return true;
}

fn DebugDirectoryChunk::extendRanges(self) -> u32 {
    return 0;
}

fn DebugDirectoryChunk::getEntryThunk(self: *DebugDirectoryChunk) -> *mut Defined {
    return null;
}

fn DebugDirectoryChunk::classof(self, c: *Chunk) -> bool {
    return c.kind() >= OtherKind;
}

struct CVDebugRecordChunk {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    buildId: *mut DebugInfo,
    ctx: *COFFLinkerContext,
}

fn CVDebugRecordChunk::getSize(self: *CVDebugRecordChunk) -> u64 {
    return  + self.ctx.config.pdbAltPath.len + 1;
}

fn CVDebugRecordChunk::writeTo(self: *CVDebugRecordChunk, b: *mut u8) {
    self.buildId = b as *mut DebugInfo;
    let mut p: *mut u8 = b + (*self.buildId) as *mut u8;
    if !self.ctx.config.pdbAltPath.is_empty() {
        memcpy(p, self.ctx.config.pdbAltPath.ptr, self.ctx.config.pdbAltPath.len);
    }
    p[self.ctx.config.pdbAltPath.len] = 0;
}

