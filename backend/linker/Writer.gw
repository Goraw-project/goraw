struct CVDebugRecordChunk {
    chunkKind: Kind,
    hasData: u8,
    p2Align: u8,
    osidx: u16,
    rva: u32,
    buildId: *mut DebugInfo,
    ctx: *COFFLinkerContext,
}

fn CVDebugRecordChunk::getSize(self: *CVDebugRecordChunk) -> u64 {
    return  + self.ctx.config.pdbAltPath.len + 1;
}

fn CVDebugRecordChunk::writeTo(self: *CVDebugRecordChunk, b: *mut u8) {
    self.buildId = b as *mut DebugInfo;
    let mut p: *mut u8 = b + (*self.buildId) as *mut u8;
    if !self.ctx.config.pdbAltPath.is_empty() {
        memcpy(p, self.ctx.config.pdbAltPath.ptr, self.ctx.config.pdbAltPath.len);
    }
    p[self.ctx.config.pdbAltPath.len] = 0;
}

fn CVDebugRecordChunk::kind(self: *CVDebugRecordChunk) -> Kind {
