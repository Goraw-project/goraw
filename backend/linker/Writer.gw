        if !sc || !sc.live {
            continue;
        }
    }
}

fn Writer::createGuardCFTables(self) {
    let mut config: *mut Configuration = &mut self.ctx.config;
    if config.guardCF == Off {
        return;
    }
    let mut addressTakenSyms: SymbolRVASet = ;
    let mut giatsRVASet: SymbolRVASet = ;
    let mut giatsSymbols: i32 = 0;
    let mut longJmpTargets: SymbolRVASet = ;
    let mut ehContTargets: SymbolRVASet = ;
    self.ctx.forEachSymtab;
    self.maybeAddRVATable(move(addressTakenSyms), "__guard_fids_table", "__guard_fids_count");
    self.maybeAddRVATable(move(giatsRVASet), "__guard_iat_table", "__guard_iat_count");
    if config.guardCF & LongJmp {
        self.maybeAddRVATable(move(longJmpTargets), "__guard_longjmp_table", "__guard_longjmp_count");
    }
    if config.guardCF & EHCont {
        self.maybeAddRVATable(move(ehContTargets), "__guard_eh_cont_table", "__guard_eh_cont_count");
    }
    let mut guardFlags: u32 = CF_INSTRUMENTED | CF_FUNCTION_TABLE_PRESENT;
    if config.guardCF & LongJmp {
        guardFlags |= CF_LONGJUMP_TABLE_PRESENT;
    }
    if config.guardCF & EHCont {
        guardFlags |= EH_CONTINUATION_TABLE_PRESENT;
    }
    self.ctx.forEachSymtab;
}

fn Writer::getSymbolsFromSections(self, file: *mut ObjFile, symIdxChunks: ArrayRef<SectionChunk *>, symbols: *mut i32) {
    for c in symIdxChunks {
        if !c.live {
            continue;
        }
        let mut data: ArrayRef<uint8_t> = c.getContents();
        if data.len % 4 != 0 {
            Warn(self.ctx) << "ignoring " << " symbol table index section in object " << file;
            continue;
        }
        let mut symIndices: ArrayRef<ulittle32_t> = zeroed();
        let mut objSymbols: ArrayRef<Symbol *> = file.getSymbols();
    }
}

