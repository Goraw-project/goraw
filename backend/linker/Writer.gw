    }
    self.strtab.finalize();
    let mut fileOff: u64 = self.fileSize;
    self.pointerToSymbolTable = fileOff;
    fileOff += self.strtab.getSize();
    self.fileSize = alignTo(fileOff, self.ctx.config.fileAlign);
}

fn Writer::getMergeDestination(self, fromSection: str, toSection: str) -> str {
    let mut names: i32 = 0;
    while true {
        if operator!((toSection)) {
            Fatal(self.ctx) << "/merge: cycle found for section '" << "'";
        }
        let mut i: auto = self.ctx.config.merge.find;
        if i() == self.ctx.config.merge.end {
            break;
        }
        toSection = ;
    }
    return toSection;
}

fn Writer::mergeSection(self, p: i32) {
    if p() ==  {
        return;
    }
    let mut toSection: str = self.getMergeDestination();
    let mut from: *mut OutputSection = self.findSection();
    let mut to: *mut OutputSection = self.findSection(toSection);
    if !from {
        return;
    }
    if !to {
        from.name = toSection;
        return;
    }
    to.merge(from);
}

fn Writer::mergeSections(self) {
    let mut timeScope: TimeTraceScope = TimeTraceScope { Entry: "Merge sections" };
    if !self.pdataSec.chunks.is_empty() {
        if isArm64EC(self.ctx.config.machine) {
            stable_sort(self.pdataSec.chunks, Closure_13 {});
        } else {
            self.pdata.first = self.pdataSec.chunks.front();
            self.pdata.last = self.pdataSec.chunks.back();
        }
    }
    let mut it: auto = self.ctx.config.merge.find;
    if it() != self.ctx.config.merge.end {
        let mut toSection: str = self.getMergeDestination();
        let mut secIt: auto = self.ctx.config.section.find;
    }
}

