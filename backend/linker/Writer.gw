fn Closure_26::call(self: *Closure_26, symtab: *mut SymbolTable) {
        let mut ctorListHead: *mut AbsolutePointerChunk = make(symtab, -1);
        let mut ctorListEnd: *mut AbsolutePointerChunk = make(symtab, 0);
        let mut dtorListHead: *mut AbsolutePointerChunk = make(symtab, -1);
        let mut dtorListEnd: *mut AbsolutePointerChunk = make(symtab, 0);
        self.ctorsSec.insertChunkAtStart(ctorListHead);
        self.ctorsSec.addChunk(ctorListEnd);
        self.dtorsSec.insertChunkAtStart(dtorListHead);
        self.dtorsSec.addChunk(dtorListEnd);
        let mut ctorListSym: *mut Symbol = symtab.findUnderscore("__CTOR_LIST__");
        let mut dtorListSym: *mut Symbol = symtab.findUnderscore("__DTOR_LIST__");
        replaceSymbol(ctorListSym, ctorListSym.getName(), ctorListHead);
        replaceSymbol(dtorListSym, dtorListSym.getName(), dtorListHead);
    }

