struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, l: *coff_relocation, r: *coff_relocation) -> bool {
        return l.VirtualAddress.operator unsigned int() < r.VirtualAddress.operator unsigned int();
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, a: *RVAFlag, b: *RVAFlag) -> bool {
        return a.rva.operator unsigned int() < b.rva.operator unsigned int();
    }

struct Closure_3 {}

fn Closure_3::call(self: *Closure_3, a: *RVAFlag, b: *RVAFlag) -> bool {
        return a.rva.operator unsigned int() == b.rva.operator unsigned int();
    }

struct Closure_4 {}

fn Closure_4::call(self: *Closure_4, a: *Arm64XDynamicRelocEntry, b: *Arm64XDynamicRelocEntry) -> bool {
        return a.offset.get() < b.offset.get();
    }

struct Closure_5 {
    rva: u32,
}

fn Closure_5::call(self: *Closure_5, e: *Arm64XDynamicRelocEntry) -> bool {
        return e.offset.get() == self.rva;
    }
