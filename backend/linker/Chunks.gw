fn BaserelChunk::BaserelChunk(self, page: u32, begin: *mut Baserel, end: *mut Baserel) {
    self.data.resize(alignTo((end - begin) * 2 + 8, 4));
    let mut p: *mut u8 = self.data.ptr;
    write32le(p, page);
    write32le(p + 4, self.data.len);
    p += 8;
    for let mut i: *mut Baserel = begin; i != end; i += 1 {
        write16le(p, (i.type << 12) | (i.rva - page));
        p += 2;
    }
}

fn BaserelChunk::writeTo(self: *BaserelChunk, buf: *mut u8) {
    memcpy(buf, self.data.ptr, self.data.len);
}

