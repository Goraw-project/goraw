fn writeHeader(os: *mut raw_ostream, sec: u32, addr: u64) {
    os << format(" %04x:%08llx", sec, addr);
}

fn writeFormattedTimestamp(os: *mut raw_ostream, tds: time_t) {
    let mut days: [7]char *const const = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    let mut months: [12]char *const const = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    let mut time: *mut tm = localtime(&mut tds);
    os << format("%s %s %2d %02d:%02d:%02d %d", days[time.tm_wday], months[time.tm_mon], time.tm_mday, time.tm_hour, time.tm_min, time.tm_sec, time.tm_year + 1900);
}

fn sortUniqueSymbols(syms: *mut i32, imageBase: u64) {
    let mut v: i32 = 0;
    v()();
    for let mut i: u64 = 0;
let mut e: u64 = (); i < e; i += 1 {
        v()[i] = [i];
    }
    parallelSort();
    let mut end: auto = unique(Closure_1 {});
    v()();
    parallelSort(Closure_2 { imageBase: imageBase });
    syms()();
    for let mut i: u64 = 0;
let mut e: u64 = (); i < e; i += 1 {
        syms()[i] = [i];
    }
}

fn getSymbols(ctx: *COFFLinkerContext, syms: *mut i32, staticSyms: *mut i32) {
    sortUniqueSymbols(ctx.config.imageBase);
    sortUniqueSymbols(ctx.config.imageBase);
}

fn getSymbolStrings(ctx: *COFFLinkerContext, syms: ArrayRef<Defined *>) -> i32 {
    let mut str: i32 = syms()();
    parallelFor(0 as u64, Closure_3 { ctx: &mut ctx });
    let mut ret: i32 = 0;
    for let mut i: u64 = 0;
let mut e: u64 = (); i < e; i += 1 {
        ret()[[i]] = move([i]);
    }
    return ;
}

fn writeMapFile(ctx: *mut COFFLinkerContext) {
    if ctx.config.mapFile.len == 0 {
        return;
    }
    let mut timeScope: TimeTraceScope = TimeTraceScope { Entry: "Map file" };
    let mut ec: error_code = error_code {};
    let mut os: raw_fd_ostream = raw_fd_ostream { ctx.config.mapFile, ec, OF_None };
    if ec {
        Fatal(ctx) << "cannot open " << ": " << ec.message();
    }
    let mut t1: ScopedTimer = ctx();
    let mut t2: ScopedTimer = ctx();
    let mut syms: i32 = 0;
    let mut staticSyms: i32 = 0;
    getSymbols(ctx);
    t2.stop();
    let mut t3: ScopedTimer = ctx();
    let mut symStr: i32 = 0;
    let mut staticSymStr: i32 = 0;
    t3.stop();
    let mut t4: ScopedTimer = ctx();
    let mut AppName: str = filename(ctx.config.outputFile, native);
    replace_extension(AppName, "", native);
    os << " " << AppName << "\n";
    os << "\n";
    os << " Timestamp is " << format_hex_no_prefix(ctx.config.timestamp, 8, false) << " (";
    if ctx.config.repro {
        os << "Repro mode";
    } else {
        writeFormattedTimestamp(os, ctx.config.timestamp);
    }
    os << ")\n";
    os << "\n";
    os << " Preferred load address is " << format_hex_no_prefix(ctx.config.imageBase, 16, false) << "\n";
    os << "\n";
    os << " Start         Length     Name                   Class\n";
    os << "\n";
    os << "  Address         Publics by Value              Rva+Base               Lib:Object\n";
    os << "\n";
    os << "\n";
    let mut entrySecIndex: u16 = 0;
    let mut entryAddress: u64 = 0;
    if !ctx.config.noEntry {
        let mut entry: *mut Defined = dyn_cast_or_null(ctx.symtab.entry);
        if entry {
            let mut chunk: *mut Chunk = entry.getChunk();
            entrySecIndex = chunk.getOutputSectionIdx();
            entryAddress = entry.getRVA() - ctx.getOutputSection(chunk).header.VirtualAddress.operator unsigned int();
        }
    }
    os << " entry point at         ";
    os << format("%04x:%08llx", entrySecIndex, entryAddress);
    os << "\n";
    os << "\n";
    os << " Static symbols\n";
    os << "\n";
    if ctx.config.mapInfo {
        os << "\n";
        os << " Exports\n";
        os << "\n";
        os << "  ordinal    name\n\n";
    }
    t4.stop();
    t1.stop();
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, a: *SortEntry, b: *SortEntry) -> auto {}

struct Closure_2 {
    imageBase: u64,
}

fn Closure_2::call(self: *Closure_2, a: *SortEntry, b: *SortEntry) -> auto {
        let mut rvaa: u64 = self.imageBase + a()();
        let mut rvab: u64 = self.imageBase + b()();
    }

struct Closure_3 {
    ctx: *mut COFFLinkerContext,
}

unsafe fn Closure_3::call(self: *mut Closure_3, i: u64) {
        let mut os: raw_string_ostream = str()[i];
        let mut sym: *mut Defined = [i];
        let mut sectionIdx: u16 = 0;
        let mut address: u64 = 0;
        let mut fileDescr: str = "";
        if  {
            address = ();
            fileDescr = "<absolute>";
        } else if isa(sym) {
            fileDescr = "<linker-defined>";
        } else if isa(sym) {
            fileDescr = "<common>";
        } else if sym.getChunk() {
            chunk;
        } else {
            address = sym.getRVA();
            if (*self.ctx).getOutputSection(chunk) {
                sec;
            } else {
                address -= sec.header.VirtualAddress.operator unsigned int();
            }
            sectionIdx = chunk.getOutputSectionIdx();
            let mut file: *mut InputFile = null;
            if  {
                file = ;
            } else if  {
                file = ;
            } else {
                file = sym.getFile();
            }
            if file {
                if !file.parentName.is_empty() {
                    fileDescr = filename(file.parentName, native);
                    replace_extension(fileDescr, "", native);
                    operator(fileDescr, ":");
                }
                operator(fileDescr, filename(file.getName(), native));
            }
        }
        writeHeader(os, sectionIdx, address);
        os << "       ";
        os << left_justify(sym.getName(), 26);
        os << " ";
        os << format_hex_no_prefix(((*self.ctx).config.imageBase + sym.getRVA()), 16, false);
        if !fileDescr.is_empty() {
            os << "     ";
            os << fileDescr;
        }
    }
