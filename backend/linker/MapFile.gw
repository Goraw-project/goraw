fn writeHeader(os: *mut raw_ostream, sec: u32, addr: u64) {
    os << format(" %04x:%08llx", sec, addr);
}

fn writeFormattedTimestamp(os: *mut raw_ostream, tds: time_t) {
    let mut days: [7]char *const const = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    let mut months: [12]char *const const = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    let mut time: *mut tm = localtime(&mut tds);
    os << format("%s %s %2d %02d:%02d:%02d %d", days[time.tm_wday], months[time.tm_mon], time.tm_mday, time.tm_hour, time.tm_min, time.tm_sec, time.tm_year + 1900);
}

fn sortUniqueSymbols(syms: *mut []*mut Defined, imageBase: u64) {
    let mut v: []SortEntry = []SortEntry {};
    v.resize(syms.len);
    for let mut i: u64 = 0;
let mut e: u64 = syms.len; i < e; i += 1 {
        v[i] = SortEntry { syms[i], i };
    }
    parallelSort(v, less<SortEntry> {});
    let mut end: Defined *, unsigned long long>>>> = unique(v, Closure_1 {});
    v.erase(end, v.end());
    parallelSort(v, Closure_2 { imageBase: imageBase });
    syms.resize(v.len);
    for let mut i: u64 = 0;
let mut e: u64 = v.len; i < e; i += 1 {
        syms[i] = v[i].first;
    }
}

fn getSymbols(ctx: *COFFLinkerContext, syms: *mut []*mut Defined, staticSyms: *mut []*mut Defined) {
    for file in ctx.objFileInstances {
        for b in file.getSymbols() {
            if !b || !b.isLive() {
                continue;
            }
            if dyn_cast(b) {
                sym;
            } else {
                let mut symRef: COFFSymbolRef = sym.getCOFFSymbol();
                if !symRef.isSectionDefinition() && symRef.getStorageClass() != IMAGE_SYM_CLASS_LABEL {
                    if symRef.getStorageClass() == IMAGE_SYM_CLASS_STATIC {
                        staticSyms.push(sym);
                    } else {
                        syms.push(sym);
                    }
                }
            }
        }
    }
    for file in ctx.importFileInstances {
        if !file.live {
            continue;
        }
        if file.impSym {
            syms.push(file.impSym);
        }
        if file.thunkSym && file.thunkSym.isLive() {
            syms.push(file.thunkSym);
        }
        if file.auxThunkSym && file.auxThunkSym.isLive() {
            syms.push(file.auxThunkSym);
        }
        if file.impchkThunk {
            syms.push(file.impchkThunk.sym);
        }
        if file.impECSym {
            syms.push(file.impECSym);
        }
        if file.auxImpCopySym {
            syms.push(file.auxImpCopySym);
        }
    }
    sortUniqueSymbols(syms, ctx.config.imageBase);
    sortUniqueSymbols(staticSyms, ctx.config.imageBase);
}

fn getSymbolStrings(ctx: *COFFLinkerContext, syms: ArrayRef<Defined *>) -> string> {
    let mut str: []str = []str { syms.len, basic_string<char>> {} };
    parallelFor(0 as u64, syms.len, function_ref<void (size_t)> { Closure_3 { str: &mut str, syms: &mut syms, ctx: &mut ctx }, null, null });
    let mut ret: string> = string> {};
    for let mut i: u64 = 0;
let mut e: u64 = syms.len; i < e; i += 1 {
        ret[syms[i]] = move(str[i]);
    }
    return ret;
}

fn writeMapFile(ctx: *mut COFFLinkerContext) {
    if ctx.config.mapFile.is_empty() {
        return;
    }
    let mut timeScope: TimeTraceScope = "Map file";
    let mut ec: error_code = error_code {};
    let mut os: raw_fd_ostream = raw_fd_ostream { ctx.config.mapFile, ec, OF_None };
    if ec {
        Fatal(ctx) << "cannot open " << ctx.config.mapFile << ": " << ec.message();
    }
    let mut t1: ScopedTimer = ctx.totalMapTimer;
    let mut t2: ScopedTimer = ctx.symbolGatherTimer;
    let mut syms: []*mut Defined = []*mut Defined {};
    let mut staticSyms: []*mut Defined = []*mut Defined {};
    getSymbols(ctx, syms, staticSyms);
    t2.stop();
    let mut t3: ScopedTimer = ctx.symbolStringsTimer;
    let mut symStr: string> = getSymbolStrings(ctx, syms);
    let mut staticSymStr: string> = getSymbolStrings(ctx, staticSyms);
    t3.stop();
    let mut t4: ScopedTimer = ctx.writeTimer;
    let mut AppName: str = filename(ctx.config.outputFile, native);
    replace_extension(AppName, "", native);
    os << " " << AppName << "\n";
    os << "\n";
    os << " Timestamp is " << format_hex_no_prefix(ctx.config.timestamp, 8, false) << " (";
    if ctx.config.repro {
        os << "Repro mode";
    } else {
        writeFormattedTimestamp(os, ctx.config.timestamp);
    }
    os << ")\n";
    os << "\n";
    os << " Preferred load address is " << format_hex_no_prefix(ctx.config.imageBase, 16, false) << "\n";
    os << "\n";
    os << " Start         Length     Name                   Class\n";
    for sec in ctx.outputSections {
        let mut ChunkRanges: []pair<SectionChunk *, SectionChunk *> = []pair<SectionChunk *, SectionChunk *> {};
        for c in sec.chunks {
            let mut sc: *mut SectionChunk = dyn_cast(c);
            if !sc {
                continue;
            }
            if ChunkRanges.is_empty() || c.getSectionName() != ChunkRanges.back().first.getSectionName() {
                ChunkRanges.push(sc, sc);
            } else {
                ChunkRanges.back().second = sc;
            }
        }
        let mut isCodeSection: bool = (sec.header.Characteristics.operator unsigned int() & IMAGE_SCN_CNT_CODE) && (sec.header.Characteristics.operator unsigned int() & IMAGE_SCN_MEM_READ) && (sec.header.Characteristics.operator unsigned int() & IMAGE_SCN_MEM_EXECUTE);
        let mut SectionClass: str = (if isCodeSection { "CODE" } else { "DATA" });
        for cr in ChunkRanges {
            let mut size: u64 = cr.second.getRVA() + cr.second.getSize() - cr.first.getRVA();
            let mut address: u32 = cr.first.getRVA() - sec.header.VirtualAddress.operator unsigned int();
            writeHeader(os, sec.sectionIndex, address);
            os << " " << format_hex_no_prefix(size, 8, false) << "H";
            os << " " << left_justify(cr.first.getSectionName(), 23);
            os << " " << SectionClass;
            os << 10;
        }
    }
    os << "\n";
    os << "  Address         Publics by Value              Rva+Base               Lib:Object\n";
    os << "\n";
    for sym in syms {
        os << symStr[sym] << 10;
    }
    os << "\n";
    let mut entrySecIndex: u16 = 0;
    let mut entryAddress: u64 = 0;
    if !ctx.config.noEntry {
        let mut entry: *mut Defined = dyn_cast_or_null(ctx.symtab.entry);
        if entry {
            let mut chunk: *mut Chunk = entry.getChunk();
            entrySecIndex = chunk.getOutputSectionIdx();
            entryAddress = entry.getRVA() - ctx.getOutputSection(chunk).header.VirtualAddress.operator unsigned int();
        }
    }
    os << " entry point at         ";
    os << format("%04x:%08llx", entrySecIndex, entryAddress);
    os << "\n";
    os << "\n";
    os << " Static symbols\n";
    os << "\n";
    for sym in staticSyms {
        os << staticSymStr[sym] << 10;
    }
    if ctx.config.mapInfo {
        os << "\n";
        os << " Exports\n";
        os << "\n";
        os << "  ordinal    name\n\n";
        for e in ctx.symtab.exports {
            os << format("  %7d", e.ordinal) << "    " << e.name << "\n";
            if !e.extName.is_empty() && e.extName != e.name {
                os << "               exported name: " << e.extName << "\n";
            }
        }
    }
    t4.stop();
    t1.stop();
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, a: *SortEntry, b: *SortEntry) -> bool {
        return a.first == b.first;
    }

struct Closure_2 {
    imageBase: u64,
}

fn Closure_2::call(self: *Closure_2, a: *SortEntry, b: *SortEntry) -> bool {
        let mut rvaa: u64 = self.imageBase + a.first.getRVA();
        let mut rvab: u64 = self.imageBase + b.first.getRVA();
        return rvaa < rvab || (rvaa == rvab && a.second < b.second);
    }

struct Closure_3 {
    str: *mut []str,
    syms: *mut ArrayRef<Defined *>,
    ctx: *mut COFFLinkerContext,
}

unsafe fn Closure_3::call(self: *mut Closure_3, i: u64) {
        let mut os: raw_string_ostream = (*self.str)[i];
        let mut sym: *mut Defined = (*self.syms)[i];
        let mut sectionIdx: u16 = 0;
        let mut address: u64 = 0;
        let mut fileDescr: str = "";
        if dyn_cast(sym) {
            absSym;
        } else {
            address = absSym.getVA();
            fileDescr = "<absolute>";
        }
        writeHeader(os, sectionIdx, address);
        os << "       ";
        os << left_justify(sym.getName(), 26);
        os << " ";
        os << format_hex_no_prefix(((*self.ctx).config.imageBase + sym.getRVA()), 16, false);
        if !fileDescr.is_empty() {
            os << "     ";
            os << fileDescr;
        }
    }
