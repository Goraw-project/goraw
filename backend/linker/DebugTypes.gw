// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;
extern fn memset(dest: *mut u8, c: i32, n: u64) -> *mut u8;

struct TypeServerSource {
    ctx: *mut COFFLinkerContext,
    kind: TpiKind,
    ownedGHashes: bool,
    tpiSrcIdx: u32,
    endPrecompIdx: u32,
    file: *mut ObjFile,
    typeMergingError: Error,
    indexMapStorage: SmallVector<TypeIndex, 0>,
    tpiMap: ArrayRef<TypeIndex>,
    ipiMap: ArrayRef<TypeIndex>,
    ghashes: GloballyHashedType>,
    funcIdToType: []pair<TypeIndex, TypeIndex>,
    isItemIndex: BitVector,
    uniqueTypes: []u32,
    mergedTpi: MergedInfo,
    mergedIpi: MergedInfo,
    nbTypeRecords: u64,
    nbTypeRecordsBytes: u64,
    pdbInputFile: *mut PDBInputFile,
    ipiSrc: *mut TypeServerIpiSource,
    Guid: GUID,
}

fn TypeServerSource::TypeServerSource(self, ctx: *mut COFFLinkerContext, f: *mut PDBInputFile) {
    if f.loadErrorStr {
        return;
    }
    let mut file: *mut PDBFile = operator(f.session).getPDBFile();
    let mut expectedInfo: auto = file.getPDBInfoStream;
    if operator!() {
        return;
    }
    self.Guid = ();
    let mut it: auto = ctx()(self.Guid, self);
    if operator!() {
        it() = null;
    }
}

fn TypeServerSource::isDependency(self: *TypeServerSource) -> bool {
    return true;
}

fn TypeServerSource::shouldOmitFromPdb(self, ghashIdx: u32) -> bool {
    return ghashIdx == self.endPrecompIdx;
}

