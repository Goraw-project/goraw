    let mut entries: i32 = 0;
    parallelSort();
    Log(self.ctx) << formatv("ghash table load factor: {0:p} (size {1} / capacity {2})\n", if tableSize { () / tableSize } else { 0 }, tableSize);
    let mut mid: auto = lower_bound(GHashCell { true, 0, 0 });
    (((operator!(operator!(((mid() == () || ()) && (mid() == () || operator!(prev()())) && "midpoint is not midpoint")))) || (_wassert(L"(mid == entries.end() || mid->isItem()) && (mid == entries.begin() || !std::prev(mid)->isItem()) && \"midpoint is not midpoint\"", L"lld\\COFF\\DebugTypes.cpp", (1154) as u32) , 0)) as void);
    let mut numTypes: u32 = distance();
    let mut numItems: u32 = distance();
    Log(self.ctx) << "Tpi record count: ";
    Log(self.ctx) << "Ipi record count: ";
    for let mut i: u32 = 0;
let mut e: u32 = (); i < e; i += 1 {
        let mut cell: *mut auto = [i];
        let mut tpiSrcIdx: u32 = ();
        let mut source: *mut TpiSource = self.ctx[tpiSrcIdx];
        source.uniqueTypes();
        let mut pdbTypeIndex: u32 = if i < numTypes { i } else { i - numTypes };
        let mut ghashCellIndex: u32 = source.indexMapStorage[()]();
        ghashState.table.table[ghashCellIndex] = ();
