fn TpiSource::TpiSource(self, ctx: *mut COFFLinkerContext, k: TpiKind, f: *mut ObjFile) {
    ctx.addTpiSource(self);
}

fn TpiSource::~TpiSource(self) {
    consumeError(move(self.typeMergingError));
}

fn makeTpiSource(ctx: *mut COFFLinkerContext, file: *mut ObjFile) -> *mut TpiSource {
    return make(ctx, Regular, file);
}

fn makeTypeServerSource(ctx: *mut COFFLinkerContext, pdbInputFile: *mut PDBInputFile) -> *mut TpiSource {
    let mut tpiSource: *mut TypeServerSource = make(ctx, pdbInputFile);
    if operator(pdbInputFile.session).getPDBFile().hasPDBIpiStream() {
        tpiSource.ipiSrc = make(ctx);
    }
    return tpiSource;
}

fn makeUseTypeServerSource(ctx: *mut COFFLinkerContext, file: *mut ObjFile, ts: TypeServer2Record) -> *mut TpiSource {
    return make(ctx, file, ts);
}

fn makePrecompSource(ctx: *mut COFFLinkerContext, file: *mut ObjFile) -> *mut TpiSource {
    return make(ctx, file);
}

fn makeUsePrecompSource(ctx: *mut COFFLinkerContext, file: *mut ObjFile, precomp: PrecompRecord) -> *mut TpiSource {
    return make(ctx, file, precomp);
}

fn TpiSource::remapTypeIndex(self: *TpiSource, ti: *mut TypeIndex, refKind: TiRefKind) -> bool {
    if ti.isSimple() {
        return true;
    }
    let mut tpiOrIpiMap: ArrayRef<TypeIndex> = if (refKind == IndexRef) { self.ipiMap } else { self.tpiMap };
    if ti.toArrayIndex() >= tpiOrIpiMap.len {
        return false;
    }
    ti = tpiOrIpiMap[ti.toArrayIndex()];
    return true;
}

fn TpiSource::remapRecord(self, rec: MutableArrayRef<uint8_t>, typeRefs: ArrayRef<TiReference>) {
    let mut contents: MutableArrayRef<uint8_t> = rec.drop_front(sizeof);
    for ref in typeRefs {
        let mut byteSize: u32 = ref.Count * ;
        if contents.len < ref.Offset + byteSize {
            Fatal(self.ctx) << "symbol record too short";
        }
        let mut indices: MutableArrayRef<TypeIndex> = MutableArrayRef<TypeIndex> { contents.ptr + ref.Offset as *mut TypeIndex, ref.Count };
        for ti in indices {
            if !self.remapTypeIndex(ti, ref.Kind) {
                if self.ctx.config.verbose {
                    let mut kind: u16 = rec.ptr as *RecordPrefix.RecordKind.operator unsigned short();
                    let mut fname: str = if self.file { self.file.getName() } else { "<unknown PDB>" };
                    Log(self.ctx) << "failed to remap type index in record of kind 0x" << utohexstr(kind, false, 0) << " in " << fname << " with bad " << (if ref.Kind == IndexRef { "item" } else { "type" }) << " index 0x" << utohexstr(ti.getIndex(), false, 0);
                }
                ti = NotTranslated;
                continue;
            }
        }
    }
}

fn TpiSource::remapTypesInTypeRecord(self, rec: MutableArrayRef<uint8_t>) {
    let mut typeRefs: SmallVector<TiReference, 32> = SmallVector<TiReference, 32> {};
    discoverTypeIndices(rec, typeRefs);
    self.remapRecord(rec, typeRefs);
}

fn TpiSource::remapTypesInSymbolRecord(self, rec: MutableArrayRef<uint8_t>) -> bool {
    let mut typeRefs: SmallVector<TiReference, 32> = SmallVector<TiReference, 32> {};
    if !discoverTypeIndicesInSymbol(rec, typeRefs) {
        return false;
    }
    self.remapRecord(rec, typeRefs);
    return true;
}

fn canUseDebugH(debugH: ArrayRef<uint8_t>) -> bool {
    if debugH.len <  {
        return false;
    }
    let mut header: *debug_h_header = debugH.ptr as *debug_h_header;
    debugH = debugH.drop_front(sizeof);
    return header.Magic.operator unsigned int() == DEBUG_HASHES_SECTION_MAGIC && header.Version.operator unsigned short() == 0 && header.HashAlgorithm.operator unsigned short() == BLAKE3 && (debugH.len % 8 == 0);
}

fn getDebugH(file: *mut ObjFile) -> optional<ArrayRef<uint8_t>> {
    let mut sec: *mut SectionChunk = findByName(file.getDebugChunks(), ".debug$H");
    if !sec {
        return nullopt;
    }
    let mut contents: ArrayRef<uint8_t> = sec.getContents();
    if !canUseDebugH(contents) {
        return nullopt;
    }
    return contents;
}

fn getHashesFromDebugH(debugH: ArrayRef<uint8_t>) -> ArrayRef<GloballyHashedType> {
    assert!(canUseDebugH(debugH);
    debugH = debugH.drop_front(sizeof);
    let mut count: u32 = debugH.len / ;
    return ArrayRef<GloballyHashedType> { debugH.ptr as *GloballyHashedType, count };
}

fn TpiSource::mergeDebugT(self, m: *mut TypeMerger) -> Error {
    assert!(!self.ctx.config.debugGHashes, "use remapTpiWithGHashes when ghash is enabled");
    let mut types: CVTypeArray = CVTypeArray {};
    let mut reader: BinaryStreamReader = BinaryStreamReader { Stream: self.file.debugTypes, Offset: little };
    cantFail(reader.readArray(types, reader.getLength(), 0), null);
    let mut nbHeadIndices: u32 = self.indexMapStorage.len;
    let mut pchInfo: optional<PCHMergerInfo> = optional<PCHMergerInfo> {};
    if mergeTypeAndIdRecords(m.idTable, m.typeTable, self.indexMapStorage, types, pchInfo) {
        err;
    } else {
        Fatal(self.ctx) << "codeview::mergeTypeAndIdRecords failed: " << toString(move(err));
    }
    if pchInfo {
        self.file.pchSignature = operator(pchInfo).PCHSignature;
        self.endPrecompIdx = operator(pchInfo).EndPrecompIndex;
    }
    self.tpiMap = self.indexMapStorage;
    self.ipiMap = self.indexMapStorage;
    if self.ctx.config.showSummary {
        self.nbTypeRecords = self.indexMapStorage.len - nbHeadIndices;
        self.nbTypeRecordsBytes = reader.getLength();
        m.tpiCounts.resize(m.getTypeTable().len);
        m.ipiCounts.resize(m.getIDTable().len);
        let mut srcIdx: u32 = nbHeadIndices;
        for ty in types {
            let mut dstIdx: TypeIndex = self.tpiMap[srcIdx += 1];
            if dstIdx.isSimple() {
                continue;
            }
            let mut counts: *mut SmallVectorImpl<uint32_t> = if isIdRecord(ty.kind()) { m.ipiCounts } else { m.tpiCounts };
            counts[dstIdx.toArrayIndex()] += 1;
        }
    }
    return success();
}

fn TypeServerSource::mergeDebugT(self, m: *mut TypeMerger) -> Error {
    assert!(!self.ctx.config.debugGHashes, "use remapTpiWithGHashes when ghash is enabled");
    let mut pdbFile: *mut PDBFile = operator(self.pdbInputFile.session).getPDBFile();
    let mut expectedTpi: TpiStream &> = pdbFile.getPDBTpiStream();
    if expectedTpi.takeError() {
        e;
    } else {
        Fatal(self.ctx) << "Type server does not have TPI stream: " << toString(move(e));
    }
    let mut maybeIpi: *mut TpiStream = null;
    if pdbFile.hasPDBIpiStream() {
        let mut expectedIpi: TpiStream &> = pdbFile.getPDBIpiStream();
        if expectedIpi.takeError() {
            e;
        } else {
            Fatal(self.ctx) << "Error getting type server IPI stream: " << toString(move(e));
        }
        maybeIpi = &mut operator(expectedIpi);
    }
    if mergeTypeRecords(m.typeTable, self.indexMapStorage, operator(expectedTpi).typeArray()) {
        err;
    } else {
        Fatal(self.ctx) << "codeview::mergeTypeRecords failed: " << toString(move(err));
    }
    self.tpiMap = self.indexMapStorage;
    if maybeIpi {
        if mergeIdRecords(m.idTable, self.tpiMap, self.ipiSrc.indexMapStorage, maybeIpi.typeArray()) {
            err;
        } else {
            Fatal(self.ctx) << "codeview::mergeIdRecords failed: " << toString(move(err));
        }
        self.ipiMap = self.ipiSrc.indexMapStorage;
    }
    if self.ctx.config.showSummary {
        self.nbTypeRecords = self.tpiMap.len + self.ipiMap.len;
        self.nbTypeRecordsBytes = operator(expectedTpi).typeArray().getUnderlyingStream().getLength() + (if maybeIpi { maybeIpi.typeArray().getUnderlyingStream().getLength() } else { 0 });
        m.tpiCounts.resize(m.getTypeTable().len);
        m.ipiCounts.resize(m.getIDTable().len);
        for ti in self.tpiMap {
            if !ti.isSimple() {
                m.tpiCounts[ti.toArrayIndex()] += 1;
            }
        }
        for ti in self.ipiMap {
            if !ti.isSimple() {
                m.ipiCounts[ti.toArrayIndex()] += 1;
            }
        }
    }
    return success();
}

fn UseTypeServerSource::getTypeServerSource(self) -> Expected<TypeServerSource *> {
    let mut tsId: *GUID = self.typeServerDependency.getGuid();
    let mut tsPath: str = self.typeServerDependency.getName();
    let mut tsSrc: *mut TypeServerSource = null;
    let mut it: iterator = self.ctx.typeServerSourceMappings.find(tsId);
    if !it == self.ctx.typeServerSourceMappings.end() {
        tsSrc = operator(it).second as *mut TypeServerSource;
    }
    if tsSrc == null {
        let mut pdb: *mut PDBInputFile = findFromRecordPath(self.ctx, tsPath, self.file);
        if !pdb {
            return createFileError(tsPath, errorCodeToError(error_code { _Myval: 2, _Mycat: generic_category() }));
        }
        if pdb.loadErrorStr {
            return createFileError(tsPath, make_error(operator(pdb.loadErrorStr), inconvertibleErrorCode()));
        }
        tsSrc = pdb.debugTypesObj as *mut TypeServerSource;
        if tsSrc.Guid != tsId {
            return createFileError(tsPath, make_error(signature_out_of_date));
        }
    }
    return Expected<TypeServerSource *> { tsSrc, null };
}

fn UseTypeServerSource::mergeDebugT(self, m: *mut TypeMerger) -> Error {
    let mut tsSrc: Expected<TypeServerSource *> = self.getTypeServerSource();
    if !tsSrc {
        return tsSrc.takeError();
    }
    let mut pdbSession: *mut PDBFile = operator((operator(tsSrc)).pdbInputFile.session).getPDBFile();
    let mut expectedInfo: Expected<InfoStream &> = pdbSession.getPDBInfoStream();
    if !expectedInfo {
        return expectedInfo.takeError();
    }
    self.tpiMap = (operator(tsSrc)).tpiMap;
    self.ipiMap = (operator(tsSrc)).ipiMap;
    return success();
}

fn equalsPath(path1: str, path2: str) -> bool {
    return path1.equals_insensitive(path2);
}

fn UsePrecompSource::findObjByName(self, fileNameOnly: str) -> *mut PrecompSource {
    for kv in self.ctx.precompSourceMappings {
        let mut currentFileName: str = filename(kv.second.file.getName(), windows);
        if equalsPath(currentFileName, fileNameOnly) {
            return kv.second as *mut PrecompSource;
        }
    }
    return null;
}

fn UsePrecompSource::findPrecompSource(self, file: *mut ObjFile, pr: *mut PrecompRecord) -> *mut PrecompSource {
    let mut prFileName: str = filename(pr.getPrecompFilePath(), windows);
    let mut it: iterator = self.ctx.precompSourceMappings.find(pr.getSignature());
    if !it == self.ctx.precompSourceMappings.end() {
        return operator(it).second as *mut PrecompSource;
    }
    return self.findObjByName(prFileName.operator StringRef());
}

fn UsePrecompSource::findPrecompMap(self, file: *mut ObjFile, pr: *mut PrecompRecord) -> Expected<PrecompSource *> {
    let mut precomp: *mut PrecompSource = self.findPrecompSource(file, pr);
    if !precomp {
        return createFileError(pr.getPrecompFilePath(), make_error(no_matching_pch));
    }
    if precomp.endPrecompIdx != pr.getTypesCount() {
        return createFileError(toString(file), make_error(no_matching_pch));
    }
    return Expected<PrecompSource *> { precomp, null };
}

fn UsePrecompSource::mergeInPrecompHeaderObj(self) -> Error {
    let mut e: Expected<PrecompSource *> = self.findPrecompMap(self.file, self.precompDependency);
    if !e {
        return e.takeError();
    }
    let mut precompSrc: *mut PrecompSource = operator(e);
    if precompSrc.tpiMap.is_empty() {
        return success();
    }
    assert!(self.precompDependency.getStartTypeIndex() == FirstNonSimpleIndex);
    assert!(self.precompDependency.getTypesCount() <= precompSrc.tpiMap.len);
    self.indexMapStorage.insert(self.indexMapStorage.begin(), precompSrc.tpiMap.begin(), precompSrc.tpiMap.begin() + self.precompDependency.getTypesCount());
    return success();
}

fn UsePrecompSource::mergeDebugT(self, m: *mut TypeMerger) -> Error {
    if self.mergeInPrecompHeaderObj() {
        e;
    } else {
        return e;
    }
    return self.mergeDebugT(m);
}

fn PrecompSource::mergeDebugT(self, m: *mut TypeMerger) -> Error {
    if self.mergeDebugT(m) {
        e;
    } else {
        return e;
    }
    self.registerMapping();
    return success();
}

fn PrecompSource::registerMapping(self) {
    if self.registered {
        return;
    }
    if self.file.pchSignature && operator(self.file.pchSignature) {
        let mut it: pair<iterator, bool> = self.ctx.precompSourceMappings.emplace(operator(self.file.pchSignature), self);
        if !it.second {
            Fatal(self.ctx) << "a PCH object with the same signature has already been provided (" << toString(operator(it.first).second.file) << " and " << toString(self.file) << ")";
        }
        self.registered = true;
    }
}

fn TpiSource::loadGHashes(self) {
    if getDebugH(self.file) {
        debugH;
    } else {
        self.ghashes = getHashesFromDebugH(operator(debugH));
        self.ownedGHashes = false;
    }
    self.fillIsItemIndexFromDebugT();
}

fn TpiSource::assignGHashesFromVector(self, hashVec: *mut *mut []GloballyHashedType) {
    if hashVec.is_empty() {
        return;
    }
    let mut hashes: *mut GloballyHashedType = hashVec.len;
    memcpy(hashes, hashVec.ptr, hashVec.len * );
    self.ghashes = GloballyHashedType> { hashes, hashVec.len };
    self.ownedGHashes = true;
}

fn forEachTypeChecked(types: ArrayRef<uint8_t>, fn: function_ref<void (const CVType &)>) {
    checkError(forEachCodeViewRecord(types, Closure_1 { cap_0: &mut fn }));
}

fn TpiSource::fillIsItemIndexFromDebugT(self) {
    let mut index: u32 = 0;
    self.isItemIndex.resize(self.ghashes.len, false);
    forEachTypeChecked(self.file.debugTypes, function_ref<void (const CVType &)> { Closure_2 { cap_0: self, index: &mut index }, null, null });
}

fn TpiSource::mergeTypeRecord(self, curIndex: TypeIndex, ty: CVType) {
    let mut isItem: bool = isIdRecord(ty.kind());
    let mut merged: *mut MergedInfo = if isItem { self.mergedIpi } else { self.mergedTpi };
    assert!(ty.len <= MaxRecordLength);
    let mut offset: u64 = merged.recs.len;
    let mut newSize: u64 = alignTo(ty.len, 4);
    merged.recs.resize(offset + newSize);
    let mut newRec: MutableArrayRef<unsigned char> = MutableArrayRef<unsigned char> { &mut merged.recs[offset], newSize };
    memcpy(newRec.ptr, ty.ptr.ptr, newSize);
    if newSize != ty.len {
        newRec.ptr as *mut RecordPrefix.RecordLen = newSize - 2;
        for let mut i: u64 = ty.len; i < newSize; i += 1 {
            newRec[i] = LF_PAD0 + (newSize - i);
        }
    }
    self.remapTypesInTypeRecord(newRec);
    let mut pdbHash: u32 = check(hashTypeRecord(newRec));
    merged.recSizes.push(newSize as u16);
    merged.recHashes.push(pdbHash);
    if ty.kind() == LF_FUNC_ID || ty.kind() == LF_MFUNC_ID {
        let mut success: bool = ty.len >= 12;
        let mut funcId: TypeIndex = curIndex;
        if success {
            success &= self.remapTypeIndex(funcId, IndexRef);
        }
        let mut funcType: TypeIndex = *&mut newRec.ptr[8] as *TypeIndex;
        if success {
            self.funcIdToType.push(TypeIndex> { funcId, funcType });
        } else {
            let mut fname: str = if self.file { self.file.getName() } else { "<unknown PDB>" };
            Warn(self.ctx) << "corrupt LF_[M]FUNC_ID record 0x" << utohexstr(curIndex.getIndex(), false, 0) << " in " << fname;
        }
    }
}

fn TpiSource::mergeUniqueTypeRecords(self, typeRecords: ArrayRef<uint8_t>, beginIndex: TypeIndex) {
    if self.kind == PDB {
        assert!(is_sorted(self.uniqueTypes);
    } else {
        sort(self.uniqueTypes);
    }
    let mut ghashIndex: u32 = 0;
    let mut nextUniqueIndex: iterator = self.uniqueTypes.begin();
    assert!(self.mergedTpi.recs.is_empty();
    assert!(self.mergedIpi.recs.is_empty();
    let mut nbTpiRecs: u32 = 0;
    let mut nbIpiRecs: u32 = 0;
    forEachTypeChecked(typeRecords, function_ref<void (const CVType &)> { Closure_3 { nextUniqueIndex: &mut nextUniqueIndex, cap_1: self, ghashIndex: &mut ghashIndex, nbIpiRecs: &mut nbIpiRecs, nbTpiRecs: &mut nbTpiRecs }, null, null });
    self.mergedTpi.recs.reserve(nbTpiRecs);
    self.mergedIpi.recs.reserve(nbIpiRecs);
    ghashIndex = 0;
    nextUniqueIndex = self.uniqueTypes.begin();
    forEachTypeChecked(typeRecords, function_ref<void (const CVType &)> { Closure_4 { nextUniqueIndex: &mut nextUniqueIndex, cap_1: self, ghashIndex: &mut ghashIndex, beginIndex: &mut beginIndex }, null, null });
    assert!(nextUniqueIndex == self.uniqueTypes.end(), "failed to merge all desired records");
    assert!(self.uniqueTypes.len == self.mergedTpi.recSizes.len + self.mergedIpi.recSizes.len, "missing desired record");
}

fn TpiSource::remapTpiWithGHashes(self, g: *mut GHashState) {
    assert!(self.ctx.config.debugGHashes, "ghashes must be enabled");
    self.fillMapFromGHashes(g);
    self.tpiMap = self.indexMapStorage;
    self.ipiMap = self.indexMapStorage;
    self.mergeUniqueTypeRecords(self.file.debugTypes, FirstNonSimpleIndex);
    if self.ctx.config.showSummary {
        self.nbTypeRecords = self.ghashes.len;
        self.nbTypeRecordsBytes = self.file.debugTypes.len;
    }
}

fn TypeServerSource::loadGHashes(self) {
    if !self.ghashes.is_empty() {
        return;
    }
    let mut pdbFile: *mut PDBFile = operator(self.pdbInputFile.session).getPDBFile();
    let mut expectedTpi: TpiStream &> = pdbFile.getPDBTpiStream();
    if expectedTpi.takeError() {
        e;
    } else {
        Fatal(self.ctx) << "Type server does not have TPI stream: " << toString(move(e));
    }
    self.assignGHashesFromVector(hashTypes(operator(expectedTpi).typeArray()));
    self.isItemIndex.resize(self.ghashes.len, false);
    if !pdbFile.hasPDBIpiStream() {
        return;
    }
    let mut expectedIpi: TpiStream &> = pdbFile.getPDBIpiStream();
    if expectedIpi.takeError() {
        e;
    } else {
        Fatal(self.ctx) << "error retrieving IPI stream: " << toString(move(e));
    }
    self.ipiSrc.assignGHashesFromVector(hashIds(operator(expectedIpi).typeArray(), self.ghashes));
    self.ipiSrc.isItemIndex.resize(self.ipiSrc.ghashes.len, false);
    self.ipiSrc.isItemIndex.set(0, self.ipiSrc.ghashes.len);
}

fn typeArrayToBytes(types: *CVTypeArray) -> ArrayRef<uint8_t> {
    let mut stream: BinaryStreamRef = types.getUnderlyingStream();
    let mut debugTypes: ArrayRef<uint8_t> = ArrayRef<uint8_t> {};
    checkError(stream.readBytes(0, stream.getLength(), debugTypes));
    return debugTypes;
}

fn TypeServerSource::remapTpiWithGHashes(self, g: *mut GHashState) {
    assert!(self.ctx.config.debugGHashes, "ghashes must be enabled");
    let mut pdbFile: *mut PDBFile = operator(self.pdbInputFile.session).getPDBFile();
    let mut tpi: *mut TpiStream = check(pdbFile.getPDBTpiStream());
    self.fillMapFromGHashes(g);
    self.tpiMap = self.indexMapStorage;
    self.mergeUniqueTypeRecords(typeArrayToBytes(tpi.typeArray()), FirstNonSimpleIndex);
    if pdbFile.hasPDBIpiStream() {
        let mut ipi: *mut TpiStream = check(pdbFile.getPDBIpiStream());
        self.ipiSrc.indexMapStorage.resize(self.ipiSrc.ghashes.len);
        self.ipiSrc.fillMapFromGHashes(g);
        self.ipiMap = self.ipiSrc.indexMapStorage;
        self.ipiSrc.tpiMap = self.tpiMap;
        self.ipiSrc.ipiMap = self.ipiMap;
        self.ipiSrc.mergeUniqueTypeRecords(typeArrayToBytes(ipi.typeArray()), FirstNonSimpleIndex);
        if self.ctx.config.showSummary {
            self.nbTypeRecords = self.ipiSrc.ghashes.len;
            self.nbTypeRecordsBytes = ipi.typeArray().getUnderlyingStream().getLength();
        }
    }
    if self.ctx.config.showSummary {
        self.nbTypeRecords += self.ghashes.len;
        self.nbTypeRecordsBytes += tpi.typeArray().getUnderlyingStream().getLength();
    }
}

fn UseTypeServerSource::remapTpiWithGHashes(self, g: *mut GHashState) {
    let mut maybeTsSrc: Expected<TypeServerSource *> = self.getTypeServerSource();
    if !maybeTsSrc {
        self.typeMergingError = joinErrors(move(self.typeMergingError), maybeTsSrc.takeError());
        return;
    }
    let mut tsSrc: *mut TypeServerSource = operator(maybeTsSrc);
    self.tpiMap = tsSrc.tpiMap;
    self.ipiMap = tsSrc.ipiMap;
}

fn PrecompSource::loadGHashes(self) {
    if getDebugH(self.file) {
        Warn(self.ctx) << "ignoring .debug$H section; pch with ghash is not implemented";
    }
    let mut ghashIdx: u32 = 0;
    let mut hashVec: []GloballyHashedType = []GloballyHashedType {};
    forEachTypeChecked(self.file.debugTypes, function_ref<void (const CVType &)> { Closure_5 { cap_0: self, ghashIdx: &mut ghashIdx, hashVec: &mut hashVec }, null, null });
    self.assignGHashesFromVector(move(hashVec));
}

fn UsePrecompSource::loadGHashes(self) {
    let mut e: Expected<PrecompSource *> = self.findPrecompMap(self.file, self.precompDependency);
    if !e {
        Warn(self.ctx) << e.takeError();
        return;
    }
    let mut pchSrc: *mut PrecompSource = operator(e);
    let mut hashVec: []GloballyHashedType = pchSrc.ghashes.take_front(self.precompDependency.getTypesCount()).operator vector();
    forEachTypeChecked(self.file.debugTypes, function_ref<void (const CVType &)> { Closure_6 { hashVec: &mut hashVec, cap_1: self }, null, null });
    hashVec.erase(hashVec.begin(), hashVec.begin() + self.precompDependency.getTypesCount());
    self.assignGHashesFromVector(move(hashVec));
}

fn UsePrecompSource::remapTpiWithGHashes(self, g: *mut GHashState) {
    self.fillMapFromGHashes(g);
    if self.mergeInPrecompHeaderObj() {
        e;
    } else {
        self.typeMergingError = joinErrors(move(self.typeMergingError), move(e));
        return;
    }
    self.tpiMap = self.indexMapStorage;
    self.ipiMap = self.indexMapStorage;
    self.mergeUniqueTypeRecords(self.file.debugTypes, self.precompDependency.getStartTypeIndex() + self.precompDependency.getTypesCount());
    if self.ctx.config.showSummary {
        self.nbTypeRecords = self.ghashes.len;
        self.nbTypeRecordsBytes = self.file.debugTypes.len;
    }
}

struct GHashTable {
    table: *mut GHashCell,
    tableSize: u32,
}

struct GHashCell {
    data: u64,
}

fn GHashCell::GHashCell(self, isItem: bool, tpiSrcIdx: u32, ghashIdx: u32) {
    assert!(tpiSrcIdx == self.getTpiSrcIdx(), "round trip failure");
    assert!(ghashIdx == self.getGHashIdx(), "round trip failure");
}

fn GHashCell::isEmpty(self: *GHashCell) -> bool {
    return self.data == 0;
}

fn GHashCell::getTpiSrcIdx(self: *GHashCell) -> u32 {
    return ((self.data >> 32) as u32 & 2147483647) - 1;
}

fn GHashCell::getGHashIdx(self: *GHashCell) -> u32 {
    return self.data as u32;
}

fn GHashCell::isItem(self: *GHashCell) -> bool {
    return self.data & (1 << 63);
}

fn GHashCell::getGHash(self: *GHashCell, ctx: *COFFLinkerContext) -> GloballyHashedType {
    return ctx.tpiSourceList[self.getTpiSrcIdx()].ghashes[self.getGHashIdx()];
}

fn GHashCell::operator=(self, arg: *mut *mut GHashCell) -> *mut GHashCell {
    self.data =  as GHashCell.data;
    return *self;
}

struct GHashState {
    table: GHashTable,
}

fn GHashTable::~GHashTable(self) {
    self.table;
}

fn GHashTable::init(self, newTableSize: u32) {
    self.table = newTableSize;
    memset(self.table, 0, newTableSize * );
    self.tableSize = newTableSize;
}

fn GHashTable::insert(self, ctx: *mut COFFLinkerContext, ghash: GloballyHashedType, newCell: GHashCell) -> u32 {
    assert!(!newCell.isEmpty(), "cannot insert empty cell value");
    let mut startIdx: u32 = byteswap(*&mut ghash as *mut u64) % self.tableSize;
    let mut idx: u32 = startIdx;
    while true {
        let mut cellPtr: *mut atomic<GHashCell> = &mut self.table[idx] as *mut atomic<GHashCell>;
        let mut oldCell: GHashCell = cellPtr.load(memory_order_seq_cst);
        while oldCell.isEmpty() || oldCell.getGHash(ctx) == ghash {
            if !oldCell.isEmpty() && oldCell < newCell {
                return idx;
            }
            if cellPtr.compare_exchange_weak(oldCell, newCell) {
                return idx;
            }
        }
        idx += 1;
        idx = if idx == self.tableSize { 0 } else { idx };
        if idx == startIdx {
            report_fatal_error("ghash table is full", true);
        }
    }
    llvm_unreachable_internal("left infloop", "P:/Goraw/llvm-project/lld/COFF/DebugTypes.cpp", 1066);
}

fn TypeMerger::~TypeMerger(self) {}

fn TypeMerger::mergeTypesWithGHash(self) {
    {
        let mut timeScope: TimeTraceScope = "Load GHASHes";
        let mut t1: ScopedTimer = self.ctx.loadGHashTimer;
        parallelForEach(self.dependencySources, Closure_7 {});
        parallelForEach(self.objectSources, Closure_8 {});
    }
    let mut timeScope: TimeTraceScope = "Merge types (GHASH)";
    let mut t2: ScopedTimer = self.ctx.mergeGHashTimer;
    let mut ghashState: GHashState = GHashState {};
    let mut tableSize: u64 = 0;
    for source in self.ctx.tpiSourceList {
        tableSize += source.ghashes.len;
    }
    tableSize = if 2147483647 - FirstNonSimpleIndex < tableSize { 2147483647 - FirstNonSimpleIndex } else { tableSize };
    ghashState.table.init(tableSize as u32);
    parallelFor(0, self.ctx.tpiSourceList.len, function_ref<void (size_t)> { Closure_9 { cap_0: self, ghashState: &mut ghashState }, null, null });
    let mut entries: []GHashCell = []GHashCell {};
    for cell in GHashCell> { ghashState.table.table, tableSize } {
        if !cell.isEmpty() {
            entries.push(cell);
        }
    }
    parallelSort(entries, less<GHashCell> {});
    Log(self.ctx) << formatv("ghash table load factor: {0:p} (size {1} / capacity {2})\n", if tableSize { entries.len / tableSize } else { 0 }, entries.len, tableSize);
    let mut mid: GHashCell>>> = lower_bound(entries, GHashCell { true, 0, 0 });
    assert!((mid == entries.end() || operator(mid).isItem()) && (mid == entries.begin() || !operator(prev(mid, 1)).isItem()), "midpoint is not midpoint");
    let mut numTypes: u32 = distance(entries.begin(), mid);
    let mut numItems: u32 = distance(mid, entries.end());
    Log(self.ctx) << "Tpi record count: " << numTypes;
    Log(self.ctx) << "Ipi record count: " << numItems;
    for let mut i: u32 = 0;
let mut e: u32 = entries.len; i < e; i += 1 {
        let mut cell: *mut GHashCell = entries[i];
        let mut tpiSrcIdx: u32 = cell.getTpiSrcIdx();
        let mut source: *mut TpiSource = self.ctx.tpiSourceList[tpiSrcIdx];
        source.uniqueTypes.push(cell.getGHashIdx());
        let mut pdbTypeIndex: u32 = if i < numTypes { i } else { i - numTypes };
        let mut ghashCellIndex: u32 = source.indexMapStorage[cell.getGHashIdx()].toArrayIndex();
        ghashState.table.table[ghashCellIndex] = GHashCell { cell.isItem(), cell.getTpiSrcIdx(), pdbTypeIndex };
    }
    for source in self.dependencySources {
        source.remapTpiWithGHashes(&mut ghashState);
    }
    parallelForEach(self.objectSources, Closure_10 { ghashState: &mut ghashState });
    for source in self.ctx.tpiSourceList {
        self.funcIdToType.insert_range(source.funcIdToType);
        source.funcIdToType.clear();
    }
    self.clearGHashes();
}

fn TypeMerger::sortDependencies(self) {
    let mut deps: []*mut TpiSource = []*mut TpiSource {};
    let mut objs: []*mut TpiSource = []*mut TpiSource {};
    for s in self.ctx.tpiSourceList {
        (if s.isDependency() { deps } else { objs }).push(s);
    }
    let mut numDeps: u32 = deps.len;
    let mut numObjs: u32 = objs.len;
    self.ctx.tpiSourceList = move(deps);
    self.ctx.tpiSourceList.insert(self.ctx.tpiSourceList.end(), objs.begin(), objs.end());
    for let mut i: u32 = 0;
let mut e: u32 = self.ctx.tpiSourceList.len; i < e; i += 1 {
        self.ctx.tpiSourceList[i].tpiSrcIdx = i;
    }
    self.dependencySources = TpiSource *> { self.ctx.tpiSourceList.ptr, numDeps };
    self.objectSources = TpiSource *> { self.ctx.tpiSourceList.ptr + numDeps, numObjs };
}

fn loadPdbTypeIndexFromCell(g: *mut GHashState, ghashCellIdx: u32) -> TypeIndex {
    let mut cell: GHashCell = g.table.table[ghashCellIdx];
    return fromArrayIndex(cell.getGHashIdx());
}

fn TypeMerger::clearGHashes(self) {
    for src in self.ctx.tpiSourceList {
        if src.ownedGHashes {
            src.ghashes.ptr;
        }
        src.ghashes = GloballyHashedType> {};
        src.isItemIndex.clear();
        src.uniqueTypes.clear();
    }
}

fn TpiSource::fillMapFromGHashes(self, g: *mut GHashState) {
    for let mut i: u64 = 0;
let mut e: u64 = self.ghashes.len; i < e; i += 1 {
        let mut fakeCellIndex: TypeIndex = self.indexMapStorage[i];
        if fakeCellIndex.isSimple() {
            self.indexMapStorage[i] = fakeCellIndex;
        } else {
            self.indexMapStorage[i] = loadPdbTypeIndexFromCell(g, fakeCellIndex.toArrayIndex());
        }
    }
}

struct Closure_1 {
    cap_0: *mut function_ref<void (const CVType &)>,
}

unsafe fn Closure_1::call(self: *mut Closure_1, ty: *CVType) -> auto {
        fn.call(ty);
        return success();
    }

struct Closure_2 {
    cap_0: *mut TpiSource,
    index: *mut u32,
}

unsafe fn Closure_2::call(self: *mut Closure_2, ty: *CVType) {
        if isIdRecord(ty.kind()) {
            self.isItemIndex.set((*self.index));
        }
        (*self.index) += 1;
    }

struct Closure_3 {
    nextUniqueIndex: *mut iterator,
    cap_1: *mut TpiSource,
    ghashIndex: *mut u32,
    nbIpiRecs: *mut u32,
    nbTpiRecs: *mut u32,
}

unsafe fn Closure_3::call(self: *mut Closure_3, ty: *CVType) {
        if !(*self.nextUniqueIndex) == self.uniqueTypes.end() && operator((*self.nextUniqueIndex)) == (*self.ghashIndex) {
            assert!(ty.len <= MaxRecordLength);
            let mut newSize: u64 = alignTo(ty.len, 4);
            (if isIdRecord(ty.kind()) { (*self.nbIpiRecs) } else { (*self.nbTpiRecs) }) += newSize;
            operator((*self.nextUniqueIndex));
        }
        (*self.ghashIndex) += 1;
    }

struct Closure_4 {
    nextUniqueIndex: *mut iterator,
    cap_1: *mut TpiSource,
    ghashIndex: *mut u32,
    beginIndex: *mut TypeIndex,
}

unsafe fn Closure_4::call(self: *mut Closure_4, ty: *CVType) {
        if !(*self.nextUniqueIndex) == self.uniqueTypes.end() && operator((*self.nextUniqueIndex)) == (*self.ghashIndex) {
            self.mergeTypeRecord((*self.beginIndex) + (*self.ghashIndex), ty);
            operator((*self.nextUniqueIndex));
        }
        (*self.ghashIndex) += 1;
    }

struct Closure_5 {
    cap_0: *mut PrecompSource,
    ghashIdx: *mut u32,
    hashVec: *mut []GloballyHashedType,
}

unsafe fn Closure_5::call(self: *mut Closure_5, ty: *CVType) {
        if ty.kind() == LF_ENDPRECOMP {
            let mut endPrecomp: EndPrecompRecord = EndPrecompRecord {};
            cantFail(deserializeAs(ty, endPrecomp), null);
            self.file.pchSignature = endPrecomp.getSignature();
            self.registerMapping();
            self.endPrecompIdx = (*self.ghashIdx);
        }
        (*self.hashVec).push(hashType(ty, (*self.hashVec), (*self.hashVec)));
        self.isItemIndex.push(isIdRecord(ty.kind()));
        (*self.ghashIdx) += 1;
    }

struct Closure_6 {
    hashVec: *mut []GloballyHashedType,
    cap_1: *mut UsePrecompSource,
}

unsafe fn Closure_6::call(self: *mut Closure_6, ty: *CVType) {
        (*self.hashVec).push(hashType(ty, (*self.hashVec), (*self.hashVec)));
        self.isItemIndex.push(isIdRecord(ty.kind()));
    }

struct Closure_7 {}

fn Closure_7::call(self: *Closure_7, source: *mut TpiSource) {
            source.loadGHashes();
        }

struct Closure_8 {}

fn Closure_8::call(self: *Closure_8, source: *mut TpiSource) {
            source.loadGHashes();
        }

struct Closure_9 {
    cap_0: *mut TypeMerger,
    ghashState: *mut GHashState,
}

unsafe fn Closure_9::call(self: *mut Closure_9, tpiSrcIdx: u64) {
        let mut source: *mut TpiSource = self.ctx.tpiSourceList[tpiSrcIdx];
        source.indexMapStorage.resize(source.ghashes.len);
        for let mut i: u32 = 0;
let mut e: u32 = source.ghashes.len; i < e; i += 1 {
            if source.shouldOmitFromPdb(i) {
                source.indexMapStorage[i] = NotTranslated;
                continue;
            }
            let mut ghash: GloballyHashedType = source.ghashes[i];
            let mut isItem: bool = source.isItemIndex.test(i);
            let mut cellIdx: u32 = (*self.ghashState).table.insert(self.ctx, ghash, GHashCell { isItem, tpiSrcIdx, i });
            source.indexMapStorage[i] = fromArrayIndex(cellIdx);
        }
    }

struct Closure_10 {
    ghashState: *mut GHashState,
}

unsafe fn Closure_10::call(self: *mut Closure_10, source: *mut TpiSource) {
        source.remapTpiWithGHashes(&mut (*self.ghashState));
    }
