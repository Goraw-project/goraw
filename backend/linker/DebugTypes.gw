    funcIdToType: []pair<TypeIndex, TypeIndex>,
    isItemIndex: BitVector,
    uniqueTypes: []u32,
    mergedTpi: MergedInfo,
    mergedIpi: MergedInfo,
    nbTypeRecords: u64,
    nbTypeRecordsBytes: u64,
}

fn TypeServerIpiSource::mergeDebugT(self, m: *mut TypeMerger) -> Error {
    return success();
}

fn TypeServerIpiSource::loadGHashes(self) {}

fn TypeServerIpiSource::remapTpiWithGHashes(self, g: *mut GHashState) {}

fn TypeServerIpiSource::isDependency(self: *TypeServerIpiSource) -> bool {
    return true;
}

fn TypeServerIpiSource::shouldOmitFromPdb(self, ghashIdx: u32) -> bool {
    return ghashIdx == self.endPrecompIdx;
}

