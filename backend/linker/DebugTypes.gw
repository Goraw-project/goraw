fn TypeMerger::sortDependencies(self) {
    let mut deps: i32 = 0;
    let mut objs: i32 = 0;
    let mut numDeps: u32 = ();
    let mut numObjs: u32 = ();
    self.ctx = move();
    self.ctx(self.ctx());
    for let mut i: u32 = 0;
let mut e: u32 = self.ctx(); i < e; i += 1 {
        self.ctx[i] = i;
    }
}

fn loadPdbTypeIndexFromCell(g: *mut GHashState, ghashCellIdx: u32) -> TypeIndex {
    let mut cell: GHashCell = g.table.table[ghashCellIdx];
    return fromArrayIndex(cell.getGHashIdx());
}

fn TypeMerger::clearGHashes(self) {}

fn TpiSource::fillMapFromGHashes(self, g: *mut GHashState) {
    for let mut i: u64 = 0;
let mut e: u64 = self.ghashes.len; i < e; i += 1 {
        let mut fakeCellIndex: TypeIndex = self.indexMapStorage[i];
        if fakeCellIndex.isSimple() {
            self.indexMapStorage[i] = fakeCellIndex;
        } else {
            self.indexMapStorage[i] = loadPdbTypeIndexFromCell(g, fakeCellIndex.toArrayIndex());
        }
    }
}

struct Closure_1 {}

fn Closure_1::call(self: *mut Closure_1, ty: *CVType) -> auto {
        fn()(ty);
        return success();
    }

struct Closure_2 {
    cap_0: *mut TpiSource,
    index: *mut u32,
}

unsafe fn Closure_2::call(self: *mut Closure_2, ty: *CVType) {
        if isIdRecord(ty()()) {
            self.isItemIndex.set((*self.index));
        }
        (*self.index) += 1;
    }

struct Closure_3 {
    cap_0: *mut TpiSource,
    ghashIndex: *mut u32,
    nbIpiRecs: *mut u32,
    nbTpiRecs: *mut u32,
}

unsafe fn Closure_3::call(self: *mut Closure_3, ty: *CVType) {
        if nextUniqueIndex() != self.uniqueTypes.end && operator*() == (*self.ghashIndex) {
            (((operator!(operator!((ty()() <= MaxRecordLength)))) || (_wassert(L"ty.length() <= codeview::MaxRecordLength", L"lld\\COFF\\DebugTypes.cpp", (707) as u32) , 0)) as void);
            let mut newSize: u64 = alignTo(ty()(), 4);
            operator+=((if isIdRecord(ty()()) { (*self.nbIpiRecs) } else { (*self.nbTpiRecs) }), newSize);
             += 1;
        }
        (*self.ghashIndex) += 1;
    }

struct Closure_4 {
    cap_0: *mut TpiSource,
    ghashIndex: *mut u32,
    beginIndex: *mut TypeIndex,
}

unsafe fn Closure_4::call(self: *mut Closure_4, ty: *CVType) {
