fn ltrim1(s: str, chars: *u8) -> str {
    if !s.is_empty() && strchr(chars, s[0]) {
        return s[1..1 + npos];
    }
    return s;
}

fn errorOrWarn(ctx: *mut COFFLinkerContext) -> COFFSyncStream {
    return COFFSyncStream { ctx, if ctx.config.forceUnresolved { Warn } else { Err } };
}

fn forceLazy(s: *mut Symbol) {
    s.pendingArchiveLoad = true;
    match s.kind() {
        LazyArchiveKind => {
            let mut l: *mut LazyArchive = cast(s);
            l.file.addMember(l.sym);
            break;
        },
        LazyObjectKind => {
            let mut file: *mut InputFile = cast(s).file;
            if !file.lazy {
                return;
            }
            file.lazy = false;
            file.symtab.ctx.driver.addFile(file);
            break;
        },
        LazyDLLSymbolKind => {
            let mut l: *mut LazyDLLSymbol = cast(s);
            l.file.makeImport(l.sym);
            break;
        },
        _ => {
            llvm_unreachable_internal("symbol passed to forceLazy is not a LazyArchive or LazyObject", "P:/Goraw/llvm-project/lld/COFF/SymbolTable.cpp", 74);
        },
    }
}

fn getSymbol(sc: *mut SectionChunk, addr: u32) -> *mut Symbol {
    let mut candidate: *mut DefinedRegular = null;
    for s in sc.file.getSymbols() {
        let mut d: *mut DefinedRegular = dyn_cast_or_null(s);
        if !d || !d.data || d.file != sc.file || d.getChunk() != sc || d.getValue() > addr || (candidate && d.getValue() < candidate.getValue()) {
            continue;
        }
        candidate = d;
    }
    return candidate;
}

fn getSymbolLocations(file: *mut BitcodeFile) -> []str {
    let mut res: str = "\n>>> referenced by ";
    let mut source: str = operator(file.obj).getSourceFileName();
    if !source.is_empty() {
        operator(res, source + "\n>>>               ");
    }
    operator(res, toString(file));
    return []str { [res], basic_string<char>> {} };
}

fn getFileLineDwarf(c: *SectionChunk, addr: u32) -> pair<StringRef, uint32_t>> {
    let mut optionalLineInfo: optional<DILineInfo> = c.file.getDILineInfo(addr, c.getSectionNumber() - 1);
    if !optionalLineInfo {
        return nullopt;
    }
    let mut lineInfo: *DILineInfo = operator(optionalLineInfo);
    if lineInfo.FileName == BadString {
        return nullopt;
    }
    return make_pair(saver().save(lineInfo.FileName), lineInfo.Line);
}

fn getFileLine(c: *SectionChunk, addr: u32) -> pair<StringRef, uint32_t>> {
    let mut fileLine: pair<StringRef, uint32_t>> = getFileLineCodeView(c, addr);
    if !fileLine && c.file.symtab.ctx.config.mingw {
        fileLine = getFileLineDwarf(c, addr);
    }
    return fileLine;
}

fn getSymbolLocations(file: *mut ObjFile, symIndex: u32, maxStrings: u64) -> string>, size_t> {
    let mut locations: []Location = []Location {};
    let mut numLocations: u64 = 0;
    for c in file.getChunks() {
        let mut sc: *mut SectionChunk = dyn_cast(c);
        if !sc {
            continue;
        }
        for r in sc.getRelocs() {
            if r.SymbolTableIndex.operator unsigned int() != symIndex {
                continue;
            }
            numLocations += 1;
            if locations.len >= maxStrings {
                continue;
            }
            let mut fileLine: pair<StringRef, uint32_t>> = getFileLine(sc, r.VirtualAddress.operator unsigned int());
            let mut sym: *mut Symbol = getSymbol(sc, r.VirtualAddress.operator unsigned int());
            if fileLine {
                locations.push(Location { sym, operator(fileLine) });
            } else if sym {
                locations.push(Location { sym, pair<StringRef, uint32_t> { "", 0 } });
            }
        }
    }
    if maxStrings == 0 {
        return make_pair([]str {}, numLocations);
    }
    if numLocations == 0 {
        return make_pair([]str { ["\n>>> referenced by " + toString(file)], basic_string<char>> {} }, 1);
    }
    let mut symbolLocations: []str = []str { locations.len, basic_string<char>> {} };
    let mut i: u64 = 0;
    for loc in locations {
        let mut os: raw_string_ostream = symbolLocations[i += 1];
        os << "\n>>> referenced by ";
        if !loc.fileLine.first.is_empty() {
            os << loc.fileLine.first << ":" << loc.fileLine.second << "\n>>>               ";
        }
        os << toString(file);
        if loc.sym {
            os << ":(" << toString(file.symtab.ctx, *loc.sym) << ')';
        }
    }
    return make_pair(symbolLocations, numLocations);
}

fn getSymbolLocations(file: *mut ObjFile, symIndex: u32) -> []str {
    return getSymbolLocations(file, symIndex, 18446744073709551615).first;
}

fn getSymbolLocations(file: *mut InputFile, symIndex: u32, maxStrings: u64) -> string>, size_t> {
    if dyn_cast(file) {
        o;
    } else {
        return getSymbolLocations(o, symIndex, maxStrings);
    }
    if dyn_cast(file) {
        b;
    } else {
        let mut symbolLocations: []str = getSymbolLocations(b);
        let mut numLocations: u64 = symbolLocations.len;
        if symbolLocations.len > maxStrings {
            symbolLocations.resize(maxStrings);
        }
        return make_pair(symbolLocations, numLocations);
    }
    llvm_unreachable_internal("unsupported file type passed to getSymbolLocations", "P:/Goraw/llvm-project/lld/COFF/SymbolTable.cpp", 202);
    return make_pair([]str {}, 0 as u64);
}

struct UndefinedDiag {
    sym: *mut Symbol,
    files: []File,
}

fn SymbolTable::reportUndefinedSymbol(self, undefDiag: *UndefinedDiag) {
    let mut diag: COFFSyncStream = errorOrWarn(self.ctx);
    diag << "undefined symbol: " << self.printSymbol(undefDiag.sym);
    let mut maxUndefReferences: u64 = 3;
    let mut numDisplayedRefs: u64 = 0;
    let mut numRefs: u64 = 0;
    for ref in undefDiag.files {
        numRefs += totalLocations;
        numDisplayedRefs += symbolLocations.len;
        for s in symbolLocations {
            diag << s;
        }
    }
    if numDisplayedRefs < numRefs {
        diag << "\n>>> referenced " << numRefs - numDisplayedRefs << " more times";
    }
    let mut name: str = undefDiag.sym.getName();
    if name.consume_front("__imp_") {
        let mut imp: *mut Symbol = self.find(name);
        if imp && imp.isLazy() {
            diag << "\nNOTE: a relevant symbol '" << imp.getName() << "' is available in " << toString(imp.getFile()) << " but cannot be used because it is not an import library.";
        }
    }
}

fn SymbolTable::loadMinGWSymbols(self) {
    let mut undefs: []*mut Symbol = []*mut Symbol {};
    for i in self.symMap {
        let mut sym: *mut Symbol = i.second;
        let mut undef: *mut Undefined = dyn_cast(sym);
        if !undef {
            continue;
        }
        if undef.getWeakAlias() {
            continue;
        }
        undefs.push(sym);
    }
    for sym in undefs {
        let mut undef: *mut Undefined = dyn_cast(sym);
        if !undef {
            continue;
        }
        if undef.getWeakAlias() {
            continue;
        }
        let mut name: str = undef.getName();
        if self.machine == I386 && self.ctx.config.stdcallFixup {
            let mut origName: str = name;
            let mut baseName: str = name;
            baseName = ltrim1(baseName, "_@");
            baseName = baseName[0..0 + baseName.find('@', 0)];
            let mut newName: str = ("_" + baseName);
            let mut l: *mut Symbol = null;
            if newName != origName && (l = self.find(newName)) != null {
                if l.isLazy() && !l.pendingArchiveLoad {
                    Log(self.ctx) << "Loading lazy " << l.getName() << " from " << l.getFile().getName() << " for stdcall fixup";
                    forceLazy(l);
                }
                if l.isLazy() || isa(l) {
                    if self.ctx.config.warnStdcallFixup {
                        Warn(self.ctx) << "Resolving " << origName << " by linking to " << newName;
                    } else {
                        Log(self.ctx) << "Resolving " << origName << " by linking to " << newName;
                    }
                    undef.setWeakAlias(l, false);
                    continue;
                }
            }
        }
        if self.ctx.config.autoImport {
            if name.starts_with("__imp_") {
                continue;
            }
            let mut l: *mut Symbol = self.find(("__imp_" + name));
            if !l || l.pendingArchiveLoad || !l.isLazy() {
                continue;
            }
            Log(self.ctx) << "Loading lazy " << l.getName() << " from " << l.getFile().getName() << " for automatic import";
            forceLazy(l);
        }
    }
}

fn SymbolTable::impSymbol(self, name: str) -> *mut Defined {
    if name.starts_with("__imp_") {
        return null;
    }
    return dyn_cast_or_null(self.find(("__imp_" + name)));
}

fn SymbolTable::handleMinGWAutomaticImport(self, sym: *mut Symbol, name: str) -> bool {
    let mut imp: *mut Defined = self.impSymbol(name);
    if !imp {
        return false;
    }
    let mut impSize: u64 = 0;
    if isa(imp) {
        Log(self.ctx) << "Automatically importing " << name << " from " << cast(imp).getDLLName();
        impSize = ;
    } else if isa(imp) {
        Log(self.ctx) << "Automatically importing " << name << " from " << toString(cast(imp).file);
        impSize = ;
    } else {
        Warn(self.ctx) << "unable to automatically import " << name << " from " << imp.getName() << " from " << cast(imp).file << "; unexpected symbol type";
        return false;
    }
    sym.replaceKeepingName(imp, impSize);
    sym.isRuntimePseudoReloc = true;
    let mut refptr: *mut DefinedRegular = dyn_cast_or_null(self.find((".refptr." + name)));
    if refptr && refptr.getChunk().getSize() == self.ctx.config.wordsize {
        let mut sc: *mut SectionChunk = dyn_cast_or_null(refptr.getChunk());
        if sc && sc.getRelocs().len == 1 && operator(sc.symbols().begin()) == sym {
            Log(self.ctx) << "Replacing .refptr." << name << " with " << imp.getName();
            refptr.getChunk().live = false;
            refptr.replaceKeepingName(imp, impSize);
        }
    }
    return true;
}

fn SymbolTable::reportProblemSymbols(self, undefs: *SmallPtrSetImpl<Symbol *>, localImports: *DenseMap<Symbol *, Symbol *>, needBitcodeFiles: bool) {
    if undefs.is_empty() && (!localImports || localImports.is_empty()) {
        return;
    }
    for b in self.ctx.config.gcroot {
        if undefs.contains(b) {
            errorOrWarn(self.ctx) << "<root>: undefined symbol: " << self.printSymbol(b);
        }
        if localImports {
            if localImports.lookup(b) {
                imp;
            } else {
                Warn(self.ctx) << "<root>: locally defined symbol imported: " << self.printSymbol(imp) << " (defined in " << toString(imp.getFile()) << ") [LNK4217]";
            }
        }
    }
    let mut undefDiags: []UndefinedDiag = []UndefinedDiag {};
    let mut firstDiag: DenseMap<Symbol *, int> = DenseMap<Symbol *, int> {};
    let mut processFile: Closure_1 = Closure_1 { undefs: &mut undefs, firstDiag: &mut firstDiag, undefDiags: &mut undefDiags, localImports: &mut localImports, cap_4: self };
    for file in self.ctx.objFileInstances {
        processFile.call(file, file.getSymbols());
    }
    if needBitcodeFiles {
        for file in self.bitcodeFileInstances {
            processFile.call(file, file.getSymbols());
        }
    }
    for undefDiag in undefDiags {
        self.reportUndefinedSymbol(undefDiag);
    }
}

fn SymbolTable::reportUnresolvable(self) {
    let mut undefs: SmallPtrSet<Symbol *, 8> = SmallPtrSet<Symbol *, 8> {};
    for i in self.symMap {
        let mut sym: *mut Symbol = i.second;
        let mut undef: *mut Undefined = dyn_cast(sym);
        if !undef || sym.deferUndefined {
            continue;
        }
        if undef.getWeakAlias() {
            continue;
        }
        let mut name: str = undef.getName();
        if name.starts_with("__imp_") {
            let mut imp: *mut Symbol = self.find(name[strlen("__imp_")..strlen("__imp_") + npos]);
            if dyn_cast_or_null(imp) {
                def;
            } else {
                def.isUsedInRegularObj = true;
                continue;
            }
        }
        if name.contains("_PchSym_") {
            continue;
        }
        if self.ctx.config.autoImport && self.impSymbol(name) {
            continue;
        }
        undefs.insert(sym);
    }
    self.reportProblemSymbols(undefs, null, true);
}

fn SymbolTable::resolveRemainingUndefines(self, aliases: *mut []*mut Undefined) {
    let mut timeScope: TimeTraceScope = "Resolve remaining undefined symbols";
    let mut undefs: SmallPtrSet<Symbol *, 8> = SmallPtrSet<Symbol *, 8> {};
    let mut localImports: DenseMap<Symbol *, Symbol *> = DenseMap<Symbol *, Symbol *> {};
    for i in self.symMap {
        let mut sym: *mut Symbol = i.second;
        let mut undef: *mut Undefined = dyn_cast(sym);
        if !undef {
            continue;
        }
        if !sym.isUsedInRegularObj {
            continue;
        }
        let mut name: str = undef.getName();
        if undef.getWeakAlias() {
            aliases.push(undef);
            continue;
        }
        if name.starts_with("__imp_") {
            let mut findLocalSym: Closure_2 = Closure_2 { cap_0: self };
            let mut impName: str = name[strlen("__imp_")..strlen("__imp_") + npos];
            let mut imp: *mut Defined = findLocalSym.call(impName);
            if !imp && self.isEC() {
                let mut mangledName: string> = getArm64ECMangledFunctionName(impName);
                if mangledName {
                    imp = findLocalSym.call(operator(mangledName));
                }
                if !imp && impName.consume_front("aux_") {
                    imp = findLocalSym.call(impName);
                    if !imp && (mangledName = getArm64ECMangledFunctionName(impName)) {
                        imp = findLocalSym.call(operator(mangledName));
                    }
                }
            }
            if imp {
                replaceSymbol(sym, self.ctx, name, imp);
                self.localImportChunks.push(cast(sym).getChunk());
                localImports[sym] = imp;
                continue;
            }
        }
        if name.contains("_PchSym_") {
            continue;
        }
        if self.ctx.config.autoImport && self.handleMinGWAutomaticImport(sym, name) {
            continue;
        }
        if self.ctx.config.forceUnresolved {
            replaceSymbol(sym, self.ctx, name, 0);
        }
        undefs.insert(sym);
    }
    self.reportProblemSymbols(undefs, if self.ctx.config.warnLocallyDefinedImported { &mut localImports } else { null }, false);
}

fn SymbolTable::insert(self, name: str) -> pair<Symbol *, bool> {
    let mut inserted: bool = false;
    let mut sym: *mut *mut Symbol = self.symMap[name];
    if !sym {
        sym = make() as *mut Symbol;
        sym.isUsedInRegularObj = false;
        sym.pendingArchiveLoad = false;
        sym.canInline = true;
        inserted = true;
        if self.isEC() && name.starts_with("EXP+") {
            self.expSymbols.push(sym);
        }
    }
    return pair<Symbol *, bool> { sym, inserted };
}

fn SymbolTable::insert(self, name: str, file: *mut InputFile) -> pair<Symbol *, bool> {
    let mut result: pair<Symbol *, bool> = self.insert(name);
    if !file || !isa(file) {
        result.first.isUsedInRegularObj = true;
    }
    return result;
}

fn SymbolTable::initializeLoadConfig(self) {
    let mut sym: CastReturnType = dyn_cast_or_null(self.findUnderscore("_load_config_used"));
    if !sym {
        if self.isEC() {
            Warn(self.ctx) << "EC version of '_load_config_used' is missing";
            return;
        }
        if self.ctx.config.machine == ARM64X {
            Warn(self.ctx) << "native version of '_load_config_used' is missing for ARM64X target";
            return;
        }
        if self.ctx.config.guardCF != Off {
            Warn(self.ctx) << "Control Flow Guard is enabled but '_load_config_used' is missing";
        }
        if self.ctx.config.dependentLoadFlags {
            Warn(self.ctx) << "_load_config_used not found, /dependentloadflag will have no effect";
        }
        return;
    }
    let mut sc: *mut SectionChunk = sym.getChunk();
    if !sc.hasData {
        Err(self.ctx) << "_load_config_used points to uninitialized data";
        return;
    }
    let mut offsetInChunk: u64 = sym.getValue();
    if offsetInChunk + 4 > sc.getSize() {
        Err(self.ctx) << "_load_config_used section chunk is too small";
        return;
    }
    let mut secContents: ArrayRef<uint8_t> = sc.getContents();
    self.loadConfigSize = *&mut secContents[offsetInChunk] as *ulittle32_t.operator unsigned int();
    if offsetInChunk + self.loadConfigSize > sc.getSize() {
        Err(self.ctx) << "_load_config_used specifies a size larger than its containing section chunk";
        return;
    }
    let mut expectedAlign: u32 = if self.ctx.config.is64() { 8 } else { 4 };
    if sc.getAlignment() < expectedAlign {
        Warn(self.ctx) << "'_load_config_used' is misaligned (expected alignment to be " << expectedAlign << " bytes, got " << sc.getAlignment() << " instead)";
    } else if !isAligned(expectedAlign, offsetInChunk) {
        Warn(self.ctx) << "'_load_config_used' is misaligned (section offset is 0x" << utohexstr(sym.getValue()) << " not aligned to " << expectedAlign << " bytes)";
    }
    self.loadConfigSym = sym;
}

fn SymbolTable::addEntryThunk(self, from: *mut Symbol, to: *mut Symbol) {
    self.entryThunks.push(Symbol *> { from, to });
}

fn SymbolTable::addExitThunk(self, from: *mut Symbol, to: *mut Symbol) {
    self.exitThunks[from] = to;
}

fn SymbolTable::initializeECThunks(self) {
    if !isArm64EC(self.ctx.config.machine) {
        return;
    }
    for it in self.entryThunks {
        let mut to: *mut Defined = it.second.getDefined();
        if !to {
            continue;
        }
        let mut from: *mut DefinedRegular = dyn_cast_or_null(it.first.getDefined());
        if !from || !from.getChunk().isCOMDAT() || cast(from).getValue() {
            Err(self.ctx) << "non COMDAT symbol '" << from.getName() << "' in hybrid map";
            continue;
        }
        from.getChunk().setEntryThunk(to);
    }
    for file in self.ctx.importFileInstances {
        if !file.impchkThunk {
            continue;
        }
        let mut sym: *mut Symbol = self.exitThunks.lookup(file.thunkSym);
        if !sym {
            sym = self.exitThunks.lookup(file.impECSym);
        }
        if sym {
            file.impchkThunk.exitThunk = sym.getDefined();
        }
    }
    parallelForEach(self.ctx.objFileInstances, Closure_3 {});
}

fn SymbolTable::initializeSameAddressThunks(self) {
    for iter in self.ctx.config.sameAddresses {
        let mut sym: CastReturnType = dyn_cast_or_null(iter.first.getDefined());
        if !sym || !sym.isLive() {
            continue;
        }
        let mut nativeSym: CastReturnType = dyn_cast_or_null(iter.second.getDefined());
        if !nativeSym || !nativeSym.isLive() {
            continue;
        }
        let mut entryThunk: *mut Defined = sym.getChunk().getEntryThunk();
        if !entryThunk {
            continue;
        }
        let mut symClone: *mut DefinedSynthetic = make(sym.getName(), sym.getChunk(), sym.getValue());
        let mut nativeSymClone: *mut DefinedSynthetic = make(nativeSym.getName(), nativeSym.getChunk(), nativeSym.getValue());
        let mut thunk: *mut SameAddressThunkARM64EC = make(nativeSymClone, symClone, entryThunk);
        self.sameAddressThunks.push(thunk);
        replaceSymbol(sym, sym.getName(), thunk);
        replaceSymbol(nativeSym, nativeSym.getName(), thunk);
    }
}

fn SymbolTable::addUndefined(self, name: str, f: *mut InputFile, overrideLazy: bool) -> *mut Symbol {
    if wasInserted || (s.isLazy() && overrideLazy) {
        replaceSymbol(s, name);
        return s;
    }
    if s.isLazy() {
        forceLazy(s);
    }
    return s;
}

fn SymbolTable::addGCRoot(self, name: str, aliasEC: bool) -> *mut Symbol {
    let mut b: *mut Symbol = self.addUndefined(name);
    if !b.isGCRoot {
        b.isGCRoot = true;
        self.ctx.config.gcroot.push(b);
    }
    if aliasEC && self.isEC() {
        if getArm64ECMangledFunctionName(name) {
            mangledName;
        } else {
            let mut u: CastReturnType = dyn_cast(b);
            if u && !u.weakAlias {
                let mut t: *mut Symbol = self.addUndefined(saver().save(operator(mangledName)));
                u.setWeakAlias(t, true);
            }
        }
    }
    return b;
}

