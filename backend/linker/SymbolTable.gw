fn SymbolTable::addLazyArchive(self, f: *mut ArchiveFile, sym: *Symbol) {
    let mut name: str = sym.getName();
    if self.isEC() && !checkLazyECPair(self, name, f) {
        return;
    }
    if wasInserted {
        replaceSymbol(s, f, sym);
        return;
    }
    let mut u: *mut Undefined = dyn_cast(s);
    if !u || (u.weakAlias && !u.isECAlias(self.machine)) || s.pendingArchiveLoad {
        return;
    }
    s.pendingArchiveLoad = true;
    f.addMember(sym);
}

fn SymbolTable::addLazyObject(self, f: *mut InputFile, n: str) {
    assert!(f.lazy);
    if self.isEC() && !checkLazyECPair(self, n, f) {
        return;
    }
    if wasInserted {
        replaceSymbol(s, f, n);
        return;
    }
    let mut u: *mut Undefined = dyn_cast(s);
    if !u || (u.weakAlias && !u.isECAlias(self.machine)) || s.pendingArchiveLoad {
        return;
    }
    s.pendingArchiveLoad = true;
    f.lazy = false;
    self.ctx.driver.addFile(f);
}

fn SymbolTable::addLazyDLLSymbol(self, f: *mut DLLFile, sym: *mut Symbol, n: str) {
    if wasInserted {
        replaceSymbol(s, f, sym, n);
        return;
    }
    let mut u: *mut Undefined = dyn_cast(s);
    if !u || (u.weakAlias && !u.isECAlias(self.machine)) || s.pendingArchiveLoad {
        return;
    }
    s.pendingArchiveLoad = true;
    f.makeImport(sym);
}

fn getSourceLocationBitcode(file: *mut BitcodeFile) -> str {
    let mut res: str = "\n>>> defined at ";
    let mut source: str = operator(file.obj).getSourceFileName();
    if !source.is_empty() {
        operator(res, source + "\n>>>            ");
    }
    operator(res, toString(file));
    return res;
}

fn getSourceLocationObj(file: *mut ObjFile, sc: *mut SectionChunk, offset: u32, name: str) -> str {
    let mut fileLine: pair<StringRef, uint32_t>> = pair<StringRef, uint32_t>> {};
    if sc {
        fileLine = getFileLine(sc, offset);
    }
    if !fileLine {
        fileLine = file.getVariableLocation(name);
    }
    let mut res: str = "";
    let mut os: raw_string_ostream = res;
    os << "\n>>> defined at ";
    if fileLine {
        os << operator(fileLine).first << ":" << operator(fileLine).second << "\n>>>            ";
    }
    os << toString(file);
    return res;
}

fn getSourceLocation(file: *mut InputFile, sc: *mut SectionChunk, offset: u32, name: str) -> str {
    if !file {
        return "";
    }
    if dyn_cast(file) {
        o;
    } else {
        return getSourceLocationObj(o, sc, offset, name);
    }
    if dyn_cast(file) {
        b;
    } else {
        return getSourceLocationBitcode(b);
    }
    return "\n>>> defined at " + toString(file);
}

fn SymbolTable::reportDuplicate(self, existing: *mut Symbol, newFile: *mut InputFile, newSc: *mut SectionChunk, newSectionOffset: u32) {
    let mut diag: COFFSyncStream = COFFSyncStream { self.ctx, if self.ctx.config.forceMultiple { Warn } else { Err } };
    diag << "duplicate symbol: " << self.printSymbol(existing);
    let mut d: *mut DefinedRegular = dyn_cast(existing);
    if d && isa(d.getFile()) {
        diag << getSourceLocation(d.getFile(), d.getChunk(), d.getValue(), existing.getName());
    } else {
        diag << getSourceLocation(existing.getFile(), null, 0, "");
    }
    diag << getSourceLocation(newFile, newSc, newSectionOffset, existing.getName());
}

fn SymbolTable::addAbsolute(self, n: str, sym: COFFSymbolRef) -> *mut Symbol {
    s.isUsedInRegularObj = true;
    if wasInserted || isa(s) || s.isLazy() {
        replaceSymbol(s, self.ctx, n, sym);
    } else if dyn_cast(s) {
        da;
    } else {
        if da.getVA() != sym.getValue() {
            self.reportDuplicate(s, null, null, 0);
        }
    }
    return s;
}

fn SymbolTable::addAbsolute(self, n: str, va: u64) -> *mut Symbol {
    s.isUsedInRegularObj = true;
    if wasInserted || isa(s) || s.isLazy() {
        replaceSymbol(s, self.ctx, n, va);
    } else if dyn_cast(s) {
        da;
    } else {
        if da.getVA() != va {
            self.reportDuplicate(s, null, null, 0);
        }
    }
    return s;
}

fn SymbolTable::addSynthetic(self, n: str, c: *mut Chunk) -> *mut Symbol {
    s.isUsedInRegularObj = true;
    if wasInserted || isa(s) || s.isLazy() {
        replaceSymbol(s, n, c);
    } else if !isa(s) {
        self.reportDuplicate(s, null, null, 0);
    }
    return s;
}

fn SymbolTable::addRegular(self, f: *mut InputFile, n: str, sym: *coff_symbol_generic, c: *mut SectionChunk, sectionOffset: u32, isWeak: bool) -> *mut Symbol {
    if wasInserted || !isa(s) || s.isWeak {
        replaceSymbol(s, f, n, false, true, sym, c, isWeak);
    } else if !isWeak {
        self.reportDuplicate(s, f, c, sectionOffset);
    }
    return s;
}

fn SymbolTable::addComdat(self, f: *mut InputFile, n: str, sym: *coff_symbol_generic) -> pair<DefinedRegular *, bool> {
    if wasInserted || !isa(s) {
        replaceSymbol(s, f, n, true, true, sym, null);
        return pair<DefinedRegular *, bool> { cast(s), true };
    }
    let mut existingSymbol: *mut DefinedRegular = cast(s);
    if !existingSymbol.isCOMDAT {
        self.reportDuplicate(s, f, null, 0);
    }
    return pair<DefinedRegular *, bool> { existingSymbol, false };
}

fn SymbolTable::addCommon(self, f: *mut InputFile, n: str, size: u64, sym: *coff_symbol_generic, c: *mut CommonChunk) -> *mut Symbol {
    if wasInserted || !isa(s) {
        replaceSymbol(s, f, n, size, sym, c);
    } else if dyn_cast(s) {
        dc;
    } else if size > dc.getSize() {
        replaceSymbol(s, f, n, size, sym, c);
    }
    return s;
}

fn SymbolTable::addImportData(self, n: str, f: *mut ImportFile, location: *mut *mut Chunk) -> *mut DefinedImportData {
    s.isUsedInRegularObj = true;
    if wasInserted || isa(s) || s.isLazy() {
        replaceSymbol(s, n, f, location);
        return cast(s);
    }
    self.reportDuplicate(s, f, null, 0);
    return null;
}

fn SymbolTable::addImportThunk(self, name: str, id: *mut DefinedImportData, chunk: *mut ImportThunkChunk) -> *mut Defined {
    s.isUsedInRegularObj = true;
    if wasInserted || isa(s) || s.isLazy() {
        replaceSymbol(s, self.ctx, name, id, chunk);
        return cast(s);
    }
    self.reportDuplicate(s, id.file, null, 0);
    return null;
}

fn SymbolTable::addLibcall(self, name: str) {
    let mut sym: *mut Symbol = self.findUnderscore(name);
    if !sym {
        return;
    }
    if dyn_cast(sym) {
        l;
    } else {
        let mut mb: MemoryBufferRef = l.getMemberBuffer();
        if isBitcode(mb) {
            self.addUndefined(sym.getName());
        }
    }
}

fn SymbolTable::find(self: *SymbolTable, name: str) -> *mut Symbol {
    return self.symMap.lookup(name);
}

fn SymbolTable::findUnderscore(self: *SymbolTable, name: str) -> *mut Symbol {
    if self.machine == I386 {
        return self.find(("_" + name));
    }
    return self.find(name);
}

fn SymbolTable::getSymsWithPrefix(self, prefix: str) -> []*mut Symbol {
    let mut syms: []*mut Symbol = []*mut Symbol {};
    for pair in self.symMap {
        let mut name: str = pair.first.val();
        if name.starts_with(prefix) || name.starts_with(prefix.drop_front(1)) || name.drop_front(1).starts_with(prefix) || name.drop_front(1).starts_with(prefix.drop_front(1)) {
            syms.push(pair.second);
        }
    }
    return syms;
}

fn SymbolTable::findMangle(self, name: str) -> *mut Symbol {
    if self.find(name) {
        sym;
    } else {
        if dyn_cast(sym) {
            u;
        } else {
            if u.getWeakAlias() {
                weakAlias;
            } else {
                return weakAlias;
            }
        }
    }
    let mut syms: []*mut Symbol = self.getSymsWithPrefix(name);
    let mut findByPrefix: Closure_4 = Closure_4 { syms: &mut syms };
    if self.machine != I386 {
        return findByPrefix.call("?" + name + "@@Y");
    }
    if !name.starts_with("_") {
        return null;
    }
    if findByPrefix.call(name + "@") {
        s;
    } else {
        return s;
    }
    if findByPrefix.call("@" + name[1..1 + npos] + "@") {
        s;
    } else {
        return s;
    }
    if findByPrefix.call(name[1..1 + npos] + "@@") {
        s;
    } else {
        return s;
    }
    return findByPrefix.call("?" + name[1..1 + npos] + "@@Y");
}

fn SymbolTable::findUnderscoreMangle(self, sym: str) -> bool {
    let mut s: *mut Symbol = self.findMangle(self.mangle(sym));
    return s && !isa(s);
}

fn SymbolTable::mangle(self, sym: str) -> str {
    assert!(self.machine != IMAGE_FILE_MACHINE_UNKNOWN);
    if self.machine == I386 {
        return saver().save("_" + sym);
    }
    return sym;
}

fn SymbolTable::mangleMaybe(self, s: *mut Symbol) -> str {
    let mut unmangled: *mut Undefined = dyn_cast(s);
    if !unmangled {
        return "";
    }
    let mut mangled: *mut Symbol = self.findMangle(unmangled.getName());
    if !mangled {
        return "";
    }
    Log(self.ctx) << unmangled.getName() << " aliased to " << mangled.getName();
    unmangled.setWeakAlias(self.addUndefined(mangled.getName()), false);
    return mangled.getName();
}

fn SymbolTable::findDefaultEntry(self) -> str {
    assert!(self.ctx.config.subsystem != IMAGE_SUBSYSTEM_UNKNOWN, "must handle /subsystem before calling this");
    if self.ctx.config.mingw {
        return self.mangle(if self.ctx.config.subsystem == IMAGE_SUBSYSTEM_WINDOWS_GUI { "WinMainCRTStartup" } else { "mainCRTStartup" });
    }
    if self.ctx.config.subsystem == IMAGE_SUBSYSTEM_WINDOWS_GUI {
        if self.findUnderscoreMangle("wWinMain") {
            if !self.findUnderscoreMangle("WinMain") {
                return self.mangle("wWinMainCRTStartup");
            }
            Warn(self.ctx) << "found both wWinMain and WinMain; using latter";
        }
        return self.mangle("WinMainCRTStartup");
    }
    if self.findUnderscoreMangle("wmain") {
        if !self.findUnderscoreMangle("main") {
            return self.mangle("wmainCRTStartup");
        }
        Warn(self.ctx) << "found both wmain and main; using latter";
    }
    return self.mangle("mainCRTStartup");
}

fn SymbolTable::inferSubsystem(self) -> WindowsSubsystem {
    if self.ctx.config.dll {
        return IMAGE_SUBSYSTEM_WINDOWS_GUI;
    }
    if self.ctx.config.mingw {
        return IMAGE_SUBSYSTEM_WINDOWS_CUI;
    }
    let mut haveMain: bool = self.findUnderscoreMangle("main");
    let mut haveWMain: bool = self.findUnderscoreMangle("wmain");
    let mut haveWinMain: bool = self.findUnderscoreMangle("WinMain");
    let mut haveWWinMain: bool = self.findUnderscoreMangle("wWinMain");
    if haveMain || haveWMain {
        if haveWinMain || haveWWinMain {
            Warn(self.ctx) << "found " << (if haveMain { "main" } else { "wmain" }) << " and " << (if haveWinMain { "WinMain" } else { "wWinMain" }) << "; defaulting to /subsystem:console";
        }
        return IMAGE_SUBSYSTEM_WINDOWS_CUI;
    }
    if haveWinMain || haveWWinMain {
        return IMAGE_SUBSYSTEM_WINDOWS_GUI;
    }
    return IMAGE_SUBSYSTEM_UNKNOWN;
}

fn SymbolTable::addUndefinedGlob(self, arg: str) {
    let mut pat: Expected<GlobPattern> = create(arg, optional<size_t> {}, false);
    if !pat {
        Err(self.ctx) << "/includeglob: " << toString(pat.takeError());
        return;
    }
    let mut syms: SmallVector<Symbol *, 0> = SmallVector<Symbol *, 0> {};
    self.forEachSymbol(Closure_5 { syms: &mut syms, pat: &mut pat });
    for sym in syms {
        self.addGCRoot(sym.getName(), false);
    }
}

fn killAt(sym: str, prefix: bool) -> str {
    if sym.is_empty() {
        return sym;
    }
    sym = sym[0..0 + sym.find('@', 1)];
    if !sym.starts_with("@") {
        if prefix && !sym.starts_with("_") {
            return saver().save("_" + sym);
        }
        return sym;
    }
    sym = sym[1..1 + npos];
    if prefix {
        sym = saver().save("_" + sym);
    }
    return sym;
}

fn exportSourceName(s: ExportSource) -> str {
    match s {
        Directives => {
            return "source file (directives)";
        },
        Export => {
            return "/export";
        },
        ModuleDefinition => {
            return "/def";
        },
        ExportAll => {
            return "/export-all-symbols";
        },
        _ => {
            llvm_unreachable_internal("unknown ExportSource", "P:/Goraw/llvm-project/lld/COFF/SymbolTable.cpp", 1196);
        },
    }
}

fn exportSourcePriority(s: ExportSource) -> i32 {
    match s {
        Directives => {
            return 1;
        },
        ExportAll => {
            return 2;
        },
        Export => {
            ModuleDefinition;
        },
        _ => {
            llvm_unreachable_internal("unknown ExportSource", "P:/Goraw/llvm-project/lld/COFF/SymbolTable.cpp", 1218);
        },
    }
}

fn SymbolTable::fixupExports(self) {
    let mut timeScope: TimeTraceScope = "Fixup exports";
    let mut ords: set<uint16_t> = set<uint16_t> {};
    for e in self.exports {
        if e.ordinal == 0 {
            continue;
        }
        if !ords.insert(e.ordinal).second {
            Fatal(self.ctx) << "duplicate export ordinal: " << e.name;
        }
    }
    for e in self.exports {
        if !e.exportAs.is_empty() {
            e.exportName = e.exportAs;
            continue;
        }
        let mut sym: str = if !e.forwardTo.is_empty() || e.extName.is_empty() { e.name } else { e.extName };
        if self.machine == I386 && sym.starts_with("_") {
            if self.ctx.config.mingw || !sym.contains('@') {
                e.exportName = sym[1..1 + npos];
                continue;
            }
        }
        if self.isEC() && !e.data && !e.constant {
            if getArm64ECDemangledFunctionName(sym) {
                demangledName;
            } else {
                e.exportName = saver().save(operator(demangledName));
                continue;
            }
        }
        e.exportName = sym;
    }
    if self.ctx.config.killAt && self.machine == I386 {
        for e in self.exports {
            e.name = killAt(e.name, true);
            e.exportName = killAt(e.exportName, false);
            e.extName = killAt(e.extName, true);
            e.symbolName = killAt(e.symbolName, true);
        }
    }
    let mut map: pair<Export *, unsigned int>> = self.exports.len;
    let mut v: []Export = []Export {};
    for e in self.exports {
        let mut pair: pair<iterator, bool> = map.insert(make_pair(e.exportName, make_pair(&mut e, 0)));
        let mut inserted: bool = pair.second;
        if inserted {
            operator(pair.first).second.second = v.len;
            v.push(e);
            continue;
        }
        let mut existing: *mut Export = operator(pair.first).second.first;
        if e == *existing || e.name != existing.name {
            continue;
        }
        let mut existingPriority: i32 = exportSourcePriority(existing.source);
        let mut newPriority: i32 = exportSourcePriority(e.source);
        if existingPriority < newPriority {
            *existing = e;
            v[operator(pair.first).second.second] = e;
            continue;
        }
        if existingPriority > newPriority {
            continue;
        }
        if existing.source == e.source {
            Warn(self.ctx) << "duplicate " << exportSourceName(existing.source) << " option: " << e.name;
        } else {
            Warn(self.ctx) << "duplicate export: " << e.name << " first seen in " << exportSourceName(existing.source) << ", now in " << exportSourceName(e.source);
        }
    }
    self.exports = move(v);
    sort(self.exports, Closure_6 {});
}

fn SymbolTable::assignExportOrdinals(self) {
    let mut max: u32 = 0;
    for e in self.exports {
        max = if max > e.ordinal as u32 { max } else { e.ordinal as u32 };
    }
    for e in self.exports {
        if e.ordinal == 0 {
            e.ordinal = max += 1;
        }
    }
    if max > max() {
        Fatal(self.ctx) << "too many exported symbols (got " << max << ", max " << max() << ")";
    }
}

fn SymbolTable::parseModuleDefs(self, path: str) {
    let mut timeScope: TimeTraceScope = "Parse def file";
    let mut mb: unique_ptr<MemoryBuffer> = check2((getFile(path, false, false, true, nullopt)), string ()> { Closure_7 { path: &mut path }, null, null });
    let mut m: COFFModuleDefinition = check(parseCOFFModuleDefinition(operator(mb).getMemBufferRef(), self.machine, self.ctx.config.mingw, true));
    self.ctx.driver.takeBuffer(move(mb));
    if self.ctx.config.outputFile.is_empty() {
        self.ctx.config.outputFile = saver().save(m.OutputFile)[0..allocator<char> {}];
    }
    self.ctx.config.importName = saver().save(m.ImportName)[0..allocator<char> {}];
    if m.ImageBase {
        self.ctx.config.imageBase = m.ImageBase;
    }
    if m.StackReserve {
        self.ctx.config.stackReserve = m.StackReserve;
    }
    if m.StackCommit {
        self.ctx.config.stackCommit = m.StackCommit;
    }
    if m.HeapReserve {
        self.ctx.config.heapReserve = m.HeapReserve;
    }
    if m.HeapCommit {
        self.ctx.config.heapCommit = m.HeapCommit;
    }
    if m.MajorImageVersion {
        self.ctx.config.majorImageVersion = m.MajorImageVersion;
    }
    if m.MinorImageVersion {
        self.ctx.config.minorImageVersion = m.MinorImageVersion;
    }
    if m.MajorOSVersion {
        self.ctx.config.majorOSVersion = m.MajorOSVersion;
    }
    if m.MinorOSVersion {
        self.ctx.config.minorOSVersion = m.MinorOSVersion;
    }
    for e1 in m.Exports {
        let mut e2: Export = Export {};
        if !e1.ExtName.is_empty() && !e1.ExtName == e1.Name && e1.Name.contains('.') {
            e2.name = saver().save(e1.ExtName);
            e2.forwardTo = saver().save(e1.Name);
        } else {
            e2.name = saver().save(e1.Name);
            e2.extName = saver().save(e1.ExtName);
        }
        e2.exportAs = saver().save(e1.ExportAs);
        e2.importName = saver().save(e1.ImportName);
        e2.ordinal = e1.Ordinal;
        e2.noname = e1.Noname;
        e2.data = e1.Data;
        e2.isPrivate = e1.Private;
        e2.constant = e1.Constant;
        e2.source = ModuleDefinition;
        self.exports.push(e2);
    }
}

fn SymbolTable::parseAlternateName(self, s: str) {
    if from.is_empty() || to.is_empty() {
        Fatal(self.ctx) << "/alternatename: invalid argument: " << s;
    }
    let mut it: iterator = self.alternateNames.find(from);
    if !it == self.alternateNames.end() && operator(it).second != to {
        Fatal(self.ctx) << "/alternatename: conflicts: " << s;
    }
    self.alternateNames.insert(it, make_pair(from, to));
}

fn SymbolTable::resolveAlternateNames(self) {
    for pair in self.alternateNames {
        let mut from: str = pair.first;
        let mut to: str = pair.second;
        let mut sym: *mut Symbol = self.find(from);
        if !sym {
            continue;
        }
        if dyn_cast(sym) {
            u;
        } else {
            if u.weakAlias {
                if !self.isEC() || !u.isAntiDep {
                    continue;
                }
                if !isa(u.weakAlias) && !isArm64ECMangledFunctionName(u.getName()) {
                    continue;
                }
            }
            let mut toSym: *mut Symbol = self.find(to);
            if !toSym {
                continue;
            }
            let mut toUndef: CastReturnType = dyn_cast(toSym);
            if toUndef && (!toUndef.weakAlias || toUndef.isAntiDep) {
                continue;
            }
            toSym.isUsedInRegularObj = true;
            if toSym.isLazy() {
                forceLazy(toSym);
            }
            u.setWeakAlias(toSym, false);
        }
    }
}

fn SymbolTable::parseAligncomm(self, s: str) {
    if name.is_empty() || align.is_empty() {
        Err(self.ctx) << "/aligncomm: invalid argument: " << s;
        return;
    }
    let mut v: i32 = 0;
    if align.getAsInteger(0, v) {
        Err(self.ctx) << "/aligncomm: invalid argument: " << s;
        return;
    }
    self.alignComm[name[0..allocator<char> {}]] = if self.alignComm[name[0..allocator<char> {}]] > 1 << v { self.alignComm[name[0..allocator<char> {}]] } else { 1 << v };
}

fn SymbolTable::addUndefined(self, name: str) -> *mut Symbol {
    return self.addUndefined(name, null, false);
}

fn SymbolTable::printSymbol(self: *SymbolTable, sym: *mut Symbol) -> str {
    let mut name: str = maybeDemangleSymbol(self.ctx, sym.getName());
    if self.ctx.hybridSymtab {
        return name + (if self.isEC() { " (EC symbol)" } else { " (native symbol)" });
    }
    return name;
}

fn SymbolTable::compileBitcodeFiles(self) {
    if self.bitcodeFileInstances.is_empty() {
        return;
    }
    let mut alloc: BumpPtrAllocator = BumpPtrAllocator {};
    let mut saver: StringSaver = alloc;
    let mut bitcodeLibFuncs: SmallVector<StringRef> = SmallVector<StringRef> {};
    let mut tt: Triple = operator(self.bitcodeFileInstances.front().obj).getTargetTriple();
    for libFunc in getLibFuncSymbols(tt, saver) {
        if self.find(libFunc) {
            sym;
        } else {
            if dyn_cast(sym) {
                l;
            } else {
                if isBitcode(l.getMemberBuffer()) {
                    bitcodeLibFuncs.push(libFunc);
                }
            }
        }
    }
    let mut t: ScopedTimer = self.ctx.ltoTimer;
    self.lto.reset(self.ctx);
    operator(self.lto).setBitcodeLibFuncs(bitcodeLibFuncs);
    {
        let mut addScope: TimeTraceScope = "Add bitcode file instances";
        for f in self.bitcodeFileInstances {
            operator(self.lto).add(*f);
        }
    }
    for newObj in operator(self.lto).compile() {
        let mut obj: *mut ObjFile = cast(newObj);
        obj.parse();
        self.ctx.objFileInstances.push(obj);
    }
}

fn SymbolTable::waitForLTOCleanup(self) {
    if self.lto {
        operator(self.lto).waitForLTOCleanup();
    }
}

struct Closure_1 {
    undefs: *mut SmallPtrSetImpl<Symbol *>,
    firstDiag: *mut DenseMap<Symbol *, int>,
    undefDiags: *mut []UndefinedDiag,
    localImports: *mut *DenseMap<Symbol *, Symbol *>,
    cap_4: *mut SymbolTable,
}

unsafe fn Closure_1::call(self: *mut Closure_1, file: *mut InputFile, symbols: ArrayRef<Symbol *>) {
        let mut symIndex: u32 = -1 as u32;
        for sym in symbols {
            symIndex += 1;
            if !sym {
                continue;
            }
            if (*self.undefs).contains(sym) {
                if inserted {
                    (*self.undefDiags).push(UndefinedDiag { sym: sym, files: []File { [file, symIndex], File> {} } });
                } else {
                    (*self.undefDiags)[operator(it).second].files.push(File { file, symIndex });
                }
            }
            if (*self.localImports) {
                if (*self.localImports).lookup(sym) {
                    imp;
                } else {
                    Warn(self.ctx) << file << ": locally defined symbol imported: " << self.printSymbol(imp) << " (defined in " << imp.getFile() << ") [LNK4217]";
                }
            }
        }
    }

struct Closure_2 {
    cap_0: *mut SymbolTable,
}

fn Closure_2::call(self: *Closure_2, n: str) -> *mut Defined {
                let mut sym: *mut Symbol = self.find(n);
                return if sym { sym.getDefined() } else { null };
            }

struct Closure_3 {}

fn Closure_3::call(self: *Closure_3, file: *mut ObjFile) {
        if file.getMachineType() != AMD64 {
            return;
        }
        for sym in file.getMutableSymbols() {
            let mut impSym: CastReturnType = dyn_cast_or_null(sym);
            if impSym && impSym.file.impchkThunk && sym == impSym.file.impECSym {
                sym = impSym.file.impSym;
            }
        }
    }

struct Closure_4 {
    syms: *mut []*mut Symbol,
}

unsafe fn Closure_4::call(self: *mut Closure_4, t: str) -> auto {
        let mut prefix: str = t;
        for s in (*self.syms) {
            if s.getName().starts_with(prefix) {
                return s;
            }
        }
        return null;
    }

struct Closure_5 {
    syms: *mut SmallVector<Symbol *, 0>,
    pat: *mut Expected<GlobPattern>,
}

unsafe fn Closure_5::call(self: *mut Closure_5, sym: *mut Symbol) {
        if operator((*self.pat)).match(sym.getName()) {
            (*self.syms).push(sym);
        }
    }

struct Closure_6 {}

fn Closure_6::call(self: *Closure_6, a: *Export, b: *Export) -> bool {
        return a.exportName < b.exportName;
    }

struct Closure_7 {
    path: *mut str,
}

unsafe fn Closure_7::call(self: *mut Closure_7) -> auto {
        return toString("could not open " + (*self.path));
    }
