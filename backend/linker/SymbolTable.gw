fn ltrim1(s: str, chars: *u8) -> str {
    if !s.is_empty() && strchr(chars, s[0]) {
        return s[1..1 + npos];
    }
    return s;
}

fn errorOrWarn(ctx: *mut COFFLinkerContext) -> COFFSyncStream {
    return COFFSyncStream { ctx, if ctx.config.forceUnresolved { Warn } else { Err } };
}

fn forceLazy(s: *mut Symbol) {
    s.pendingArchiveLoad = true;
    match s.kind() {
        LazyArchiveKind => {
            let mut l: *mut auto = cast(s);
            l()();
            break;
        },
        LazyObjectKind => {
            let mut file: *mut InputFile = cast(s);
            if !file.lazy {
                return;
            }
            file.lazy = false;
            file.symtab.ctx.driver.addFile(file);
            break;
        },
        LazyDLLSymbolKind => {
            let mut l: *mut auto = cast(s);
            l()();
            break;
        },
        _ => {
            llvm_unreachable_internal("symbol passed to forceLazy is not a LazyArchive or LazyObject", "lld\\COFF\\SymbolTable.cpp", 74);
        },
    }
}

fn getSymbol(sc: *mut SectionChunk, addr: u32) -> *mut Symbol {
    let mut candidate: *mut DefinedRegular = null;
    for s in sc.file.getSymbols() {
        let mut d: *mut auto = dyn_cast_or_null(s);
        if operator!() || operator!() ||  != sc.file || () != sc || () > addr || (candidate && () < candidate.getValue()) {
            continue;
        }
        candidate = ;
    }
    return candidate;
}

fn getSymbolLocations(file: *mut BitcodeFile) -> i32 {
    let mut res: str = "\n>>> referenced by ";
    let mut source: str = operator(file.obj).getSourceFileName();
    if !source.is_empty() {
        res(source + "\n>>>               ");
    }
    operator(res, toString(file));
    return void { res };
}

fn getFileLineDwarf(c: *SectionChunk, addr: u32) -> pair<StringRef, uint32_t>> {
    let mut optionalLineInfo: optional<DILineInfo> = zeroed();
    if operator!() {
        return nullopt();
    }
    let mut lineInfo: *DILineInfo = operator*();
    if lineInfo.FileName == BadString {
        return nullopt();
    }
    return make_pair(saver().save(lineInfo.FileName), lineInfo.Line);
}

fn getFileLine(c: *SectionChunk, addr: u32) -> pair<StringRef, uint32_t>> {
    let mut fileLine: pair<StringRef, uint32_t>> = zeroed();
    return ;
}

fn getSymbolLocations(file: *mut ObjFile, symIndex: u32, maxStrings: u64) -> i32 {
    let mut locations: i32 = 0;
    let mut numLocations: u64 = 0;
    for c in file.getChunks() {
        let mut sc: *mut auto = dyn_cast(c);
        if operator!() {
            continue;
        }
    }
    if maxStrings == 0 {
        return make_pair(numLocations);
    }
    if numLocations == 0 {
        return make_pair(1);
    }
    let mut symbolLocations: i32 = locations()();
    let mut i: u64 = 0;
    return make_pair(numLocations);
}

fn getSymbolLocations(file: *mut ObjFile, symIndex: u32) -> i32 {
    return getSymbolLocations(file, symIndex, 18446744073709551615);
}

fn getSymbolLocations(file: *mut InputFile, symIndex: u32, maxStrings: u64) -> i32 {
    if  {
        return getSymbolLocations(symIndex, maxStrings);
    }
    if  {
        let mut symbolLocations: i32 = getSymbolLocations();
        let mut numLocations: u64 = ();
        if symbolLocations()() > maxStrings {
            symbolLocations()(maxStrings);
        }
        return make_pair(numLocations);
    }
    llvm_unreachable_internal("unsupported file type passed to getSymbolLocations", "lld\\COFF\\SymbolTable.cpp", 202);
    return make_pair(0 as u64);
}

struct UndefinedDiag {
    sym: *mut Symbol,
    files: i32,
}

fn SymbolTable::reportUndefinedSymbol(self, undefDiag: *UndefinedDiag) {
    let mut diag: COFFSyncStream = errorOrWarn(self.ctx);
    diag << "undefined symbol: ";
    let mut maxUndefReferences: u64 = 3;
    let mut numDisplayedRefs: u64 = 0;
    let mut numRefs: u64 = 0;
    if numDisplayedRefs < numRefs {
        diag << "\n>>> referenced " << " more times";
    }
    let mut name: str = undefDiag.sym.getName();
    if name.consume_front("__imp_") {
        let mut imp: *mut Symbol = self.find(name);
        if imp && imp.isLazy() {
            diag << "\nNOTE: a relevant symbol '" << "' is available in " << toString(imp.getFile()) << " but cannot be used because it is not an import library.";
        }
    }
}

fn SymbolTable::loadMinGWSymbols(self) {
    let mut undefs: i32 = 0;
    for i in self.symMap {
        let mut sym: *mut Symbol = i.second;
        let mut undef: *mut auto = dyn_cast(sym);
        if operator!() {
            continue;
        }
        if undef()() {
            continue;
        }
        undefs()(sym);
    }
}

fn SymbolTable::impSymbol(self, name: str) -> *mut Defined {
    if name.starts_with("__imp_") {
        return null;
    }
    return dyn_cast_or_null(self.find(("__imp_" + name)));
}

fn SymbolTable::handleMinGWAutomaticImport(self, sym: *mut Symbol, name: str) -> bool {
    let mut imp: *mut Defined = self.impSymbol(name);
    if !imp {
        return false;
    }
    let mut impSize: u64 = 0;
    if isa(imp) {
        Log(self.ctx) << "Automatically importing " << " from " << cast(imp)();
        impSize = ;
    } else if isa(imp) {
        Log(self.ctx) << "Automatically importing " << " from " << toString(cast(imp));
        impSize = ;
    } else {
        Warn(self.ctx) << "unable to automatically import " << " from " << imp.getName() << " from " << cast(imp) << "; unexpected symbol type";
        return false;
    }
    sym.replaceKeepingName(imp, impSize);
    sym.isRuntimePseudoReloc = true;
    let mut refptr: *mut DefinedRegular = dyn_cast_or_null(self.find((".refptr." + name)));
    if refptr && refptr.getChunk().getSize() == self.ctx.config.wordsize {
        let mut sc: *mut SectionChunk = dyn_cast_or_null(refptr.getChunk());
        if sc && sc.getRelocs().len == 1 && operator(sc.symbols().begin()) == sym {
            Log(self.ctx) << "Replacing .refptr." << " with " << imp.getName();
            refptr.getChunk().live = false;
            refptr.replaceKeepingName(imp, impSize);
        }
    }
    return true;
}

fn SymbolTable::reportProblemSymbols(self, undefs: *SmallPtrSetImpl<Symbol *>, localImports: *i32, needBitcodeFiles: bool) {
    if undefs()() && (operator!() || ()) {
        return;
    }
    let mut undefDiags: i32 = 0;
    let mut firstDiag: i32 = 0;
    let mut processFile: Closure_1 = Closure_1 { undefs: &mut undefs, cap_1: self };
}

fn SymbolTable::reportUnresolvable(self) {
    let mut undefs: SmallPtrSet<Symbol *, 8> = zeroed();
    for i in self.symMap {
        let mut sym: *mut Symbol = i.second;
        let mut undef: *mut auto = dyn_cast(sym);
        if operator!() || sym.deferUndefined {
            continue;
        }
        if undef()() {
            continue;
        }
        let mut name: str = ();
        if name.starts_with("__imp_") {
            let mut imp: *mut Symbol = self.find(name[strlen("__imp_")..strlen("__imp_") + npos]);
            if dyn_cast_or_null(imp) {
                def;
            } else {
                def.isUsedInRegularObj = true;
                continue;
            }
        }
        if name.contains("_PchSym_") {
            continue;
        }
        if self.ctx.config.autoImport && self.impSymbol(name) {
            continue;
        }
        undefs()(sym);
    }
    self.reportProblemSymbols(null, true);
}

fn SymbolTable::resolveRemainingUndefines(self, aliases: *mut i32) {
    let mut timeScope: TimeTraceScope = TimeTraceScope { Entry: "Resolve remaining undefined symbols" };
    let mut undefs: SmallPtrSet<Symbol *, 8> = zeroed();
    let mut localImports: i32 = 0;
    for i in self.symMap {
        let mut sym: *mut Symbol = i.second;
        let mut undef: *mut auto = dyn_cast(sym);
        if operator!() {
            continue;
        }
        if !sym.isUsedInRegularObj {
            continue;
        }
        let mut name: str = ();
        if undef()() {
            aliases()();
            continue;
        }
        if name.starts_with("__imp_") {
            let mut findLocalSym: Closure_2 = Closure_2 { cap_0: self };
            let mut impName: str = name[strlen("__imp_")..strlen("__imp_") + npos];
            let mut imp: *mut Defined = findLocalSym.call(impName);
            if !imp && self.isEC() {
                let mut mangledName: string> = getArm64ECMangledFunctionName(impName);
                if mangledName {
                    imp = findLocalSym.call(operator(mangledName));
                }
                if !imp && impName.consume_front("aux_") {
                    imp = findLocalSym.call(impName);
                    if !imp && (mangledName = getArm64ECMangledFunctionName(impName)) {
                        imp = findLocalSym.call(operator(mangledName));
                    }
                }
            }
            if imp {
                replaceSymbol(sym, self.ctx, name, imp);
                self.localImportChunks(cast(sym)());
                localImports()[sym] = imp;
                continue;
            }
        }
        if name.contains("_PchSym_") {
            continue;
        }
        if self.ctx.config.autoImport && self.handleMinGWAutomaticImport(sym, name) {
            continue;
        }
        if self.ctx.config.forceUnresolved {
            replaceSymbol(sym, self.ctx, name, 0);
        }
        undefs()(sym);
    }
    self.reportProblemSymbols(if self.ctx.config.warnLocallyDefinedImported { operator&() } else { null }, false);
}

fn SymbolTable::insert(self, name: str) -> pair<Symbol *, bool> {
    let mut inserted: bool = false;
    let mut sym: *mut *mut Symbol = self.symMap[CachedHashStringRef { name }];
    if !sym {
        sym = make() as *mut Symbol;
        sym.isUsedInRegularObj = false;
        sym.pendingArchiveLoad = false;
        sym.canInline = true;
        inserted = true;
        if self.isEC() && name.starts_with("EXP+") {
            self.expSymbols.push(sym);
        }
    }
    return void { sym, inserted };
}

fn SymbolTable::insert(self, name: str, file: *mut InputFile) -> pair<Symbol *, bool> {
    let mut result: pair<Symbol *, bool> = zeroed();
    if !file || !isa(file) {
        result() = true;
    }
    return ;
}

fn SymbolTable::initializeLoadConfig(self) {
    let mut sym: auto = dyn_cast_or_null(self.findUnderscore("_load_config_used"));
    if operator!() {
        if self.isEC() {
            Warn(self.ctx) << "EC version of '_load_config_used' is missing";
            return;
        }
        if self.ctx.config.machine == ARM64X {
            Warn(self.ctx) << "native version of '_load_config_used' is missing for ARM64X target";
            return;
        }
        if self.ctx.config.guardCF != Off {
            Warn(self.ctx) << "Control Flow Guard is enabled but '_load_config_used' is missing";
        }
        if self.ctx.config.dependentLoadFlags {
            Warn(self.ctx) << "_load_config_used not found, /dependentloadflag will have no effect";
        }
        return;
    }
    let mut sc: *mut SectionChunk = ();
    if !sc.hasData {
        Err(self.ctx) << "_load_config_used points to uninitialized data";
        return;
    }
    let mut offsetInChunk: u64 = ();
    if offsetInChunk + 4 > sc.getSize() {
        Err(self.ctx) << "_load_config_used section chunk is too small";
        return;
    }
    let mut secContents: ArrayRef<uint8_t> = sc.getContents();
    self.loadConfigSize = *&mut secContents[offsetInChunk] as *ulittle32_t.operator unsigned int();
    if offsetInChunk + self.loadConfigSize > sc.getSize() {
        Err(self.ctx) << "_load_config_used specifies a size larger than its containing section chunk";
        return;
    }
    let mut expectedAlign: u32 = if self.ctx.config.is64() { 8 } else { 4 };
    if sc.getAlignment() < expectedAlign {
        Warn(self.ctx) << "'_load_config_used' is misaligned (expected alignment to be " << " bytes, got " << sc.getAlignment() << " instead)";
    } else if !isAligned(Align { ShiftValue: expectedAlign }, offsetInChunk) {
        Warn(self.ctx) << "'_load_config_used' is misaligned (section offset is 0x" << utohexstr() << " not aligned to " << expectedAlign << " bytes)";
    }
    self.loadConfigSym = ;
}

fn SymbolTable::addEntryThunk(self, from: *mut Symbol, to: *mut Symbol) {
    self.entryThunks;
}

fn SymbolTable::addExitThunk(self, from: *mut Symbol, to: *mut Symbol) {
    self.exitThunks[from] = to;
}

fn SymbolTable::initializeECThunks(self) {
    if !isArm64EC(self.ctx.config.machine) {
        return;
    }
    parallelForEach(self.ctx, Closure_3 {});
}

fn SymbolTable::initializeSameAddressThunks(self) {}

fn SymbolTable::addUndefined(self, name: str, f: *mut InputFile, overrideLazy: bool) -> *mut Symbol {
    if  {
        replaceSymbol(name);
        return ;
    }
    if  {
        forceLazy();
    }
    return ;
}

fn SymbolTable::addGCRoot(self, name: str, aliasEC: bool) -> *mut Symbol {
    let mut b: *mut Symbol = self.addUndefined(name);
    if !b.isGCRoot {
        b.isGCRoot = true;
        self.ctx.config.gcroot.push(b);
    }
    if aliasEC && self.isEC() {
        if getArm64ECMangledFunctionName(name) {
            mangledName;
        } else {
            let mut u: auto = dyn_cast(b);
            if u() && operator!() {
                let mut t: *mut Symbol = self.addUndefined(saver().save(operator(mangledName)));
                u()(t, true);
            }
        }
    }
    return b;
}

