    }

struct Closure_4 {}

fn Closure_4::call(self: *mut Closure_4, t: str) -> auto {
        let mut prefix: str = t;
        return null;
    }

struct Closure_5 {}

fn Closure_5::call(self: *Closure_5, a: *Export, b: *Export) -> bool {
        return a.exportName < b.exportName;
    }

struct Closure_6 {
    path: *mut str,
}

unsafe fn Closure_6::call(self: *mut Closure_6) -> auto {
        return toString("could not open " + (*self.path));
    }
