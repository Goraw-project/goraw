fn AutoExporter::AutoExporter(self, symtab: *mut SymbolTable, manualExcludeSymbols: i32) {
    self.excludeLibs = StringSet<> { ["libgcc", "libgcc_s", "libstdc++", "libmingw32", "libmingwex", "libg2c", "libsupc++", "libobjc", "libgcj", "libclang_rt.builtins", "libclang_rt.builtins-aarch64", "libclang_rt.builtins-arm", "libclang_rt.builtins-i386", "libclang_rt.builtins-x86_64", "libclang_rt.profile", "libclang_rt.profile-aarch64", "libclang_rt.profile-arm", "libclang_rt.profile-i386", "libclang_rt.profile-x86_64", "libcygwin", "libmsys-2.0", "libc++", "libc++abi", "libflang_rt.runtime", "libunwind", "libmsvcrt", "libmsvcrt-os", "libucrtbase", "libucrt", "libucrtapp", "libpthread", "libwinpthread"] };
    self.excludeObjects = StringSet<> { ["crt0.o", "crt1.o", "crt1u.o", "crt2.o", "crt2u.o", "dllcrt1.o", "dllcrt2.o", "gcrt0.o", "gcrt1.o", "gcrt2.o", "crtbegin.o", "crtend.o"] };
    self.excludeSymbolPrefixes = StringSet<> { ["__imp_", "__IMPORT_DESCRIPTOR_", "__nm_", "__rtti_", "__builtin_", ".", "__profc_", "__profd_", "__profvp_"] };
    self.excludeSymbolSuffixes = StringSet<> { ["_iname", "_NULL_THUNK_DATA"] };
    if symtab.machine == I386 {
        self.excludeSymbols = StringSet<> { ["__NULL_IMPORT_DESCRIPTOR", "__pei386_runtime_relocator", "_do_pseudo_reloc", "_impure_ptr", "__impure_ptr", "__fmode", "_environ", "___dso_handle", "__load_config_used", "_DllMain@12", "_DllEntryPoint@12", "_DllMainCRTStartup@12"] };
        self.excludeSymbolPrefixes.insert;
    } else {
        self.excludeSymbols = StringSet<> { ["__NULL_IMPORT_DESCRIPTOR", "_pei386_runtime_relocator", "do_pseudo_reloc", "impure_ptr", "_impure_ptr", "_fmode", "environ", "__dso_handle", "_load_config_used", "DllMain", "DllEntryPoint", "DllMainCRTStartup"] };
        self.excludeSymbolPrefixes.insert;
    }
    if symtab.isEC() {
        self.excludeSymbols.insert;
        self.excludeSymbolPrefixes.insert;
    }
}

fn AutoExporter::addWholeArchive(self, path: str) {
    let mut libName: str = filename(path, native);
    libName = libName[0..0 + libName.rfind('.', npos)];
    self.excludeLibs.erase(libName);
}

fn AutoExporter::addExcludedSymbol(self, symbol: str) {
    self.excludeSymbols.insert;
}

fn AutoExporter::shouldExport(self: *AutoExporter, sym: *mut Defined) -> bool {
    if !sym || !sym.getChunk() {
        return false;
    }
    if !isa(sym) && !isa(sym) {
        return false;
    }
    if self.excludeSymbols.contains(sym.getName()) || self.manualExcludeSymbols.contains(sym.getName()) {
        return false;
    }
    if self.symtab.find(("__imp_" + sym.getName())) {
        return false;
    }
    if !sym.getFile() {
        return false;
    }
    let mut libName: str = filename(sym.getFile().parentName, native);
    libName = libName[0..0 + libName.rfind('.', npos)];
    if !libName.is_empty() {
        return !self.excludeLibs.contains(libName);
    }
    let mut fileName: str = filename(sym.getFile().getName(), native);
    return !self.excludeObjects.contains(fileName);
}

fn writeDefFile(ctx: *mut COFFLinkerContext, name: str, exports: i32) {
    let mut timeScope: TimeTraceScope = TimeTraceScope { Entry: "Write .def file" };
    let mut ec: error_code = error_code {};
    let mut os: raw_fd_ostream = raw_fd_ostream { name, ec, OF_None };
    if ec {
        Fatal(ctx) << "cannot open " << ": " << ec.message();
    }
    os << "EXPORTS\n";
}

fn mangle(sym: str, machine: MachineTypes) -> str {
    assert!(machine != IMAGE_FILE_MACHINE_UNKNOWN);
    if machine == I386 {
        return saver().save("_" + sym);
    }
    return saver().save(sym);
}

fn addWrappedSymbols(symtab: *mut SymbolTable, args: *mut InputArgList) {
    let mut v: i32 = 0;
    let mut seen: i32 = 0;
    symtab.wrapped = move();
}

fn wrapSymbols(symtab: *mut SymbolTable) {
    let mut map: i32 = 0;
    parallelForEach(symtab.ctx, Closure_1 {});
}

struct Closure_1 {}

