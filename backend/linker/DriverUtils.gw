// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;
extern fn memset(dest: *mut u8, c: i32, n: u64) -> *mut u8;

const SUBLANG_ENGLISH_US: u16 = 1033;

const RT_MANIFEST: u16 = 24;

struct Executor {
    prog: str,
    args: i32,
}

fn Executor::add(self, s: str) {}

fn Executor::add(self, s: *mut str) {}

fn Executor::add(self, s: str) {}

fn Executor::add(self, s: *u8) {}

fn Executor::run(self) {
    let mut exeOrErr: string> = findProgramByName(self.prog, ArrayRef<StringRef> {});
    if exeOrErr.getError() {
        ec;
    } else {
        fatal("unable to find " + self.prog + " in PATH: " + ec.message());
    }
    let mut exe: str = saver().save(operator(exeOrErr));
    if ExecuteAndWait() != 0 {
        fatal("ExecuteAndWait failed: " + join(" "));
    }
}

fn LinkerDriver::parseNumbers(self, arg: str, addr: *mut u64, size: *mut u64) {
    if s1 {
        Fatal(self.ctx) << "invalid number: ";
    }
    if size && !s2.is_empty() && s2 {
        Fatal(self.ctx) << "invalid number: ";
    }
}

fn LinkerDriver::parseVersion(self, arg: str, major: *mut u32, minor: *mut u32) {
    if s1 {
        Fatal(self.ctx) << "invalid number: ";
    }
    *minor = 0;
    if !s2.is_empty() && s2 {
        Fatal(self.ctx) << "invalid number: ";
    }
}

fn LinkerDriver::parseGuard(self, fullArg: str) {
    let mut splitArgs: SmallVector<StringRef, 1> = zeroed();
    fullArg(",");
}

fn LinkerDriver::parseSubsystem(self, arg: str, sys: *mut WindowsSubsystem, major: *mut u32, minor: *mut u32, gotVersion: *mut bool) {
    let mut sysStrLower: str = sysStr.lower();
    if *sys == IMAGE_SUBSYSTEM_UNKNOWN && sysStrLower != "default" {
        Fatal(self.ctx) << "unknown subsystem: ";
    }
    if !ver.is_empty() {
        self.parseVersion(ver, major, minor);
    }
    if gotVersion {
        *gotVersion = !ver.is_empty();
    }
}

fn LinkerDriver::parseMerge(self, s: str) {
    if from.len == 0 || to.len == 0 {
        Fatal(self.ctx) << "/merge: invalid argument: ";
    }
    if from == ".rsrc" || to == ".rsrc" {
        Fatal(self.ctx) << "/merge: cannot merge '.rsrc' with any section";
    }
    if from == ".reloc" || to == ".reloc" {
        Fatal(self.ctx) << "/merge: cannot merge '.reloc' with any section";
    }
    let mut pair: auto = self.ctx.config.merge(make_pair(from, to));
    let mut inserted: bool = ;
    if !inserted {
        let mut existing: str = ;
        if existing != to {
            Warn(self.ctx) << ": already merged into " << existing;
        }
    }
}

fn LinkerDriver::parsePDBPageSize(self, s: str) {
    let mut v: i32 = 0;
    if s {
        Err(self.ctx) << "/pdbpagesize: invalid argument: ";
        return;
    }
    if v != 4096 && v != 8192 && v != 16384 && v != 32768 {
        Err(self.ctx) << "/pdbpagesize: invalid argument: ";
        return;
    }
    self.ctx.config.pdbPageSize = v;
}

fn parseSectionAttributes(ctx: *mut COFFLinkerContext, s: str) -> u32 {
    let mut ret: u32 = 0;
    for c in s.lower() {
        match c {
            'd' => {
                ret |= IMAGE_SCN_MEM_DISCARDABLE;
            },
            'e' => {
                ret |= IMAGE_SCN_MEM_EXECUTE;
            },
            'k' => {
                ret |= IMAGE_SCN_MEM_NOT_CACHED;
            },
            'p' => {
                ret |= IMAGE_SCN_MEM_NOT_PAGED;
            },
            'r' => {
                ret |= IMAGE_SCN_MEM_READ;
            },
            's' => {
                ret |= IMAGE_SCN_MEM_SHARED;
            },
            'w' => {
                ret |= IMAGE_SCN_MEM_WRITE;
            },
            _ => {
                Fatal(ctx) << "/section: invalid argument: ";
            },
        }
    }
    return ret;
}

fn LinkerDriver::parseSection(self, s: str) {
    if name.len == 0 || attrs.len == 0 {
        Fatal(self.ctx) << "/section: invalid argument: ";
    }
    self.ctx.config.section[name] = parseSectionAttributes(self.ctx, attrs);
}

fn LinkerDriver::parseSectionLayout(self, path: str) {
    if path.starts_with("@") {
        path = path[1..1 + npos];
    }
    let mut layoutFile: i32 = check2((getFile(path)), Closure_1 { path: &mut path });
    let mut content: str = ();
    let mut index: i32 = 0;
    while !content.is_empty() {
        let mut pos: u64 = content.find_first_of("\r\n", 0);
        let mut line: str = "";
        if pos == npos {
            line = content;
            content = "";
        } else {
            line = content[0..0 + pos];
            content = content[pos..pos + npos].ltrim("\r\n");
        }
        line = line.trim(" \t\n\v\f\r");
        if line.len == 0 {
            continue;
        }
        let mut sectionName: str = line.split(' ').first;
        if self.ctx.config.sectionOrder.count(sectionName) {
            Warn(self.ctx) << "duplicate section '" << "' in section layout file, ignoring";
            continue;
        }
        self.ctx.config.sectionOrder[sectionName] = index += 1;
    }
}

fn LinkerDriver::parseDosStub(self, path: str) {
    let mut stub: i32 = check2((getFile(path)), Closure_2 { path: &mut path });
    let mut bufferSize: u64 = ();
    let mut bufferStart: *u8 = ();
    if bufferSize < 64 {
        Err(self.ctx) << "/stub: stub must be greater than or equal to 64 bytes: ";
    }
    if bufferStart[0] != 'M' || bufferStart[1] != 'Z' {
        Err(self.ctx) << "/stub: invalid DOS signature: ";
    }
    self.ctx.config.dosStub = move();
}

fn LinkerDriver::parseFunctionPadMin(self, a: *mut Arg) {
    let mut arg: str = if a.getNumValues() { a.getValue(0) } else { "" };
    if !arg.is_empty() {
        if arg {
            Err(self.ctx) << "/functionpadmin: invalid argument: ";
        }
        return;
    }
    if self.ctx.config.machine == I386 {
        self.ctx.config.functionPadMin = 5;
    } else if self.ctx.config.machine == AMD64 {
        self.ctx.config.functionPadMin = 6;
    } else {
        Err(self.ctx) << "/functionpadmin: invalid argument for this machine: ";
    }
}

fn LinkerDriver::parseDependentLoadFlags(self, a: *mut Arg) {
    let mut arg: str = if a.getNumValues() { a.getValue(0) } else { "" };
    if !arg.is_empty() {
        if arg {
            Err(self.ctx) << "/dependentloadflag: invalid argument: ";
        }
        return;
    }
    Err(self.ctx) << "/dependentloadflag: no argument specified";
}

fn LinkerDriver::parseManifest(self, arg: str) {
    if arg.equals_insensitive("no") {
        self.ctx.config.manifest = No;
        return;
    }
    if !arg.starts_with_insensitive("embed") {
        Fatal(self.ctx) << "invalid option ";
    }
    self.ctx.config.manifest = Embed;
    arg = arg[strlen("embed")..strlen("embed") + npos];
    if arg.len == 0 {
        return;
    }
    if !arg.starts_with_insensitive(",id=") {
        Fatal(self.ctx) << "invalid option ";
    }
    arg = arg[strlen(",id=")..strlen(",id=") + npos];
    if arg {
        Fatal(self.ctx) << "invalid option ";
    }
}

fn LinkerDriver::parseManifestUAC(self, arg: str) {
    if arg.equals_insensitive("no") {
        self.ctx.config.manifestUAC = false;
        return;
    }
    for {
        arg = arg.ltrim(" \t\n\v\f\r");
        if arg.len == 0 {
            return;
        }
        if arg.consume_front_insensitive("level=") {
            tie(self.ctx.config.manifestLevel, arg) = arg.split(" ");
            continue;
        }
        if arg.consume_front_insensitive("uiaccess=") {
            tie(self.ctx.config.manifestUIAccess, arg) = arg.split(" ");
            continue;
        }
        Fatal(self.ctx) << "invalid option ";
    }
}

fn LinkerDriver::parseSwaprun(self, arg: str) {
    while true {
        {
        if swaprun.equals_insensitive("cd") {
            self.ctx.config.swaprunCD = true;
        } else if swaprun.equals_insensitive("net") {
            self.ctx.config.swaprunNet = true;
        } else if swaprun.len == 0 {
            Err(self.ctx) << "/swaprun: missing argument";
        } else {
            Err(self.ctx) << "/swaprun: invalid argument: ";
        }
        if newArg.len == 0 && arg.ends_with(",") {
            Err(self.ctx) << "/swaprun: missing argument";
        }
        arg = newArg;
    }
        if !(!arg.is_empty()) { break; }
    }
}

fn LinkerDriver::parseSameAddress(self, arg: str) {
    let mut mangledName: string> = getArm64ECMangledFunctionName(arg);
    let mut sym: *mut Symbol = self.ctx.symtab.addUndefined(if mangledName { operator(mangledName) } else { arg });
    if self.ctx.config.machine != ARM64X {
        return;
    }
    let mut nativeSym: *mut Symbol = self.ctx(arg);
    self.ctx.config.sameAddresses;
}

struct TemporaryFile {
    ctx: *mut COFFLinkerContext,
    path: str,
}

fn TemporaryFile::TemporaryFile(self, ctx: *mut COFFLinkerContext, prefix: str, extn: str, contents: str) {
    let mut s: str = "";
    if createTemporaryFile("lld-" + prefix, extn, s, OF_None) {
        ec;
    } else {
        Fatal(ctx) << "cannot create a temporary file: ";
    }
    self.path = s.operator basic_string();
    if !contents.is_empty() {
        let mut ec: error_code = error_code {};
        let mut os: raw_fd_ostream = raw_fd_ostream { self.path, ec, OF_None };
        if ec {
            Fatal(ctx) << "failed to open " << ": " << ec.message();
        }
        os << contents;
    }
}

fn TemporaryFile::TemporaryFile(self, obj: *mut *mut TemporaryFile) {
    swap(self.path, obj.path);
}

fn TemporaryFile::~TemporaryFile(self) {
    if self.path.len == 0 {
        return;
    }
    if remove(self.path, true) {
        Fatal(self.ctx) << "failed to remove ";
    }
}

fn TemporaryFile::getMemoryBuffer(self) -> i32 {
    return check2((getFile(self.path, false, false, true)), Closure_3 { cap_0: self });
}

fn LinkerDriver::createDefaultXml(self) -> str {
    let mut ret: str = "";
    let mut os: raw_string_ostream = raw_string_ostream { ret };
    os << "<?xml version=\"1.0\" standalone=\"yes\"?>\n" << "<assembly xmlns=\"urn:schemas-microsoft-com:asm.v1\"\n" << "          manifestVersion=\"1.0\">\n";
    if self.ctx.config.manifestUAC {
        os << "  <trustInfo xmlns=\"urn:schemas-microsoft-com:asm.v3\">\n" << "    <security>\n" << "      <requestedPrivileges>\n" << "         <requestedExecutionLevel level=" << self.ctx.config.manifestLevel << " uiAccess=" << self.ctx.config.manifestUIAccess << "/>\n" << "      </requestedPrivileges>\n" << "    </security>\n" << "  </trustInfo>\n";
    }
    for manifestDependency in self.ctx.config.manifestDependencies {
        os << "  <dependency>\n" << "    <dependentAssembly>\n" << "      <assemblyIdentity " << manifestDependency << " />\n" << "    </dependentAssembly>\n" << "  </dependency>\n";
    }
    os << "</assembly>\n";
    return ret;
}

fn LinkerDriver::createManifestXmlWithInternalMt(self, defaultXml: str) -> str {
    let mut defaultXmlCopy: i32 = getMemBufferCopy(defaultXml, "");
    let mut merger: WindowsManifestMerger = WindowsManifestMerger {};
    if  {
        Fatal(self.ctx) << "internal manifest tool failed on default xml: " << toString(move());
    }
    return merger()()();
}

fn LinkerDriver::createManifestXmlWithExternalMt(self, defaultXml: str) -> str {
    let mut Default: TemporaryFile = TemporaryFile { self.ctx, "defaultxml", "manifest", "" };
    let mut ec: error_code = error_code {};
    let mut os: raw_fd_ostream = raw_fd_ostream { Default.path, ec, OF_TextWithCRLF };
    if ec {
        Fatal(self.ctx) << "failed to open " << ": " << ec.message();
    }
    os << defaultXml;
    os.close();
    let mut user: TemporaryFile = TemporaryFile { self.ctx, "user", "manifest", "" };
    let mut e: Executor = Executor { "mt.exe" };
    e.add("/manifest");
    e.add(Default.path);
    e.add("/nologo");
    e.add("/out:" + user.path);
    e.run();
    return check2((getFile(user.path)), Closure_4 { user: &mut user })()();
}

fn LinkerDriver::createManifestXml(self) -> str {
    let mut defaultXml: str = self.createDefaultXml();
    if self.ctx.config.manifestInput.len == 0 {
        return defaultXml;
    }
    if isAvailable() {
        return self.createManifestXmlWithInternalMt(defaultXml);
    }
    return self.createManifestXmlWithExternalMt(defaultXml);
}

fn LinkerDriver::createMemoryBufferForManifestRes(self, manifestSize: u64) -> i32 {
    let mut resSize: u64 = alignTo(WIN_RES_MAGIC_SIZE + WIN_RES_NULL_ENTRY_SIZE +  +  +  + manifestSize, WIN_RES_DATA_ALIGNMENT);
    return getNewMemBuffer(resSize, self.ctx.config.outputFile + ".manifest.res");
}

fn writeResFileHeader(buf: *mut *mut u8) {
    memcpy(buf, WinResMagic, (WinResMagic));
    buf += (WinResMagic);
    memset(buf, 0, WIN_RES_NULL_ENTRY_SIZE);
    buf += WIN_RES_NULL_ENTRY_SIZE;
}

fn writeResEntryHeader(buf: *mut *mut u8, manifestSize: u64, manifestID: i32) {
    let mut prefix: *mut WinResHeaderPrefix = buf as *mut WinResHeaderPrefix;
    prefix.DataSize = manifestSize;
    prefix.HeaderSize =  +  + ;
    buf += ;
    let mut iDs: *mut WinResIDs = buf as *mut WinResIDs;
    iDs.setType(RT_MANIFEST);
    iDs.setName(manifestID);
    buf += ;
    let mut suffix: *mut WinResHeaderSuffix = buf as *mut WinResHeaderSuffix;
    suffix.DataVersion = 0;
    suffix.MemoryFlags = WIN_RES_PURE_MOVEABLE;
    suffix.Language = SUBLANG_ENGLISH_US;
    suffix.Version = 0;
    suffix.Characteristics = 0;
    buf += ;
}

fn LinkerDriver::createManifestRes(self) -> i32 {
    let mut manifest: str = self.createManifestXml();
    let mut res: i32 = self.createMemoryBufferForManifestRes;
    let mut buf: *mut u8 = ();
    writeResFileHeader(buf);
    writeResEntryHeader(buf, manifest.len, self.ctx.config.manifestID);
    copy(manifest.begin(), manifest.end(), buf);
    return move();
}

fn LinkerDriver::createSideBySideManifest(self) {
    let mut path: str = self.ctx.config.manifestFile;
    if path == "" {
        path(self.ctx.config.outputFile + ".manifest");
    }
    let mut ec: error_code = error_code {};
    let mut out: raw_fd_ostream = raw_fd_ostream { path, ec, OF_TextWithCRLF };
    if ec {
        Fatal(self.ctx) << "failed to create manifest: ";
    }
    out << self.createManifestXml();
}

fn LinkerDriver::parseExport(self, arg: str) -> Export {
    let mut e: Export = Export {};
    e.source = Export;
    let mut rest: str = "";
    tie(e.name, rest) = arg.split(",");
    if e.name.len == 0 {
        
    }
    if e.name.contains('=') {
        if y.contains(".") {
            e.name = x;
            e.forwardTo = y;
        } else {
            e.extName = x;
            e.name = y;
            if e.name.len == 0 {
                
            }
        }
    }
    while !rest.is_empty() {
        let mut tok: str = "";
        tie(tok, rest) = rest.split(",");
        if tok.equals_insensitive("noname") {
            if e.ordinal == 0 {
                
            }
            e.noname = true;
            continue;
        }
        if tok.equals_insensitive("data") {
            e.data = true;
            continue;
        }
        if tok.equals_insensitive("constant") {
            e.constant = true;
            continue;
        }
        if tok.equals_insensitive("private") {
            e.isPrivate = true;
            continue;
        }
        if tok.equals_insensitive("exportas") {
            if !rest.is_empty() && !rest.contains(',') {
                e.exportAs = rest;
            } else {
                Err(self.ctx) << "invalid EXPORTAS value: ";
            }
            break;
        }
        if tok.starts_with("@") {
            let mut ord: i32 = 0;
            if tok[1..1 + npos] {
                
            }
            if ord <= 0 || 65535 < ord {
                
            }
            e.ordinal = ord;
            continue;
        }
    }
    return e;
    Fatal(self.ctx) << "invalid /export: ";
    llvm_unreachable_internal("", "lld\\COFF\\DriverUtils.cpp", 679);
}

fn LinkerDriver::checkFailIfMismatch(self, arg: str, source: *mut InputFile) {
    if k.len == 0 || v.len == 0 {
        Fatal(self.ctx) << "/failifmismatch: invalid argument: ";
    }
    let mut existing: pair<StringRef, InputFile *> = zeroed();
    if operator!() && v !=  {
        let mut sourceStr: str = if source { toString(source) } else { "cmd-line" };
        let mut existingStr: str = if  { toString() } else { "cmd-line" };
        Fatal(self.ctx) << "/failifmismatch: mismatch detected for '" << "':\n>>> " << existingStr << " has value " <<  << "\n>>> " << sourceStr << " has value " << v;
    }
    self.ctx.config.mustMatch[k];
}

fn LinkerDriver::convertResToCOFF(self, mbs: ArrayRef<MemoryBufferRef>, objs: ArrayRef<ObjFile *>) -> MemoryBufferRef {
    let mut parser: WindowsResourceParser = WindowsResourceParser { self.ctx.config.mingw };
    let mut duplicates: i32 = 0;
    if self.ctx.config.mingw {
        parser()();
    }
    let mut e: i32 = (self.ctx.config.machine, parser, self.ctx.config.timestamp);
    if operator!() {
        Fatal(self.ctx) << "failed to write .res to COFF: " << toString();
    }
    let mut mbref: MemoryBufferRef = operator*(operator*());
    return mbref;
}

fn handleColorDiagnostics(ctx: *mut COFFLinkerContext, args: *mut InputArgList) {
    let mut arg: *mut auto = args;
    if operator!() {
        return;
    }
    if  {
        ctx()()(true);
    } else if  {
        ctx()()(false);
    } else {
        let mut s: str = ();
        if s == "always" {
            ctx()()(true);
        } else if s == "never" {
            ctx()()(false);
        } else if s != "auto" {
            Err(ctx) << "unknown option: --color-diagnostics=";
        }
    }
}

fn getQuotingStyle(ctx: *mut COFFLinkerContext, args: *mut InputArgList) -> TokenizerCallback {
    if  {
        let mut s: str = ();
        if s != "windows" && s != "posix" {
            Err(ctx) << "invalid response file quoting: ";
        }
        if s == "windows" {
            return TokenizeWindowsCommandLine;
        }
        return TokenizeGNUCommandLine;
    }
    return TokenizeWindowsCommandLine;
}

fn ArgParser::parse(self, argv: ArrayRef<const char *>) -> InputArgList {
    let mut missingIndex: u32 = 0;
    let mut missingCount: u32 = 0;
    let mut args: InputArgList = self.ctx.optTable.ParseArgs(argv, missingIndex, missingCount, Visibility {});
    let mut expandedArgv: SmallVector<const char *, 256> = zeroed();
    if operator!(args) {
        self.addLINK();
    }
    ExpandResponseFiles(saver(), getQuotingStyle(self.ctx, args));
    args = self.ctx.optTable(missingIndex, missingCount);
    if args && argv.len != () {
        let mut msg: str = "Command line:";
        Msg(self.ctx);
    }
    self.ctx.config.argv = [argv[0]];
    for arg in args {
        if arg.getOption().getKind() != InputClass {
            self.ctx.config.argv;
        }
    }
    self.ctx = args;
    if missingCount {
        Fatal(self.ctx) << args.getArgString(missingIndex) << ": missing argument";
    }
    handleColorDiagnostics(self.ctx, args);
    if args {
        Warn(self.ctx) << "ignoring /link, did you pass it multiple times?";
    }
    if args {
        Warn(self.ctx) << "ignoring /lib since it's not the first argument";
    }
    return args;
}

fn ArgParser::parseDirectives(self, s: str) -> ParsedDirectives {
    let mut result: ParsedDirectives = ParsedDirectives {};
    let mut rest: SmallVector<const char *, 16> = SmallVector<const char *, 16> {};
    let mut tokens: SmallVector<StringRef, 16> = zeroed();
    TokenizeWindowsCommandLineNoCopy(s, saver());
    let mut missingIndex: u32 = 0;
    let mut missingCount: u32 = 0;
    result.args = self.ctx.optTable;
    if missingCount {
        Fatal(self.ctx) << result.args.getArgString(missingIndex) << ": missing argument";
    }
    return result;
}

fn ArgParser::addLINK(self, argv: *SmallVector<const char *, 256>) {
    if GetEnv("LINK") {
        s;
    } else {
        let mut v: i32 = self.tokenize(operator(s));
        argv()(next(argv()()));
    }
    if GetEnv("_LINK_") {
        s;
    } else {
        let mut v: i32 = self.tokenize(operator(s));
        argv()(next(argv()()));
    }
}

fn ArgParser::tokenize(self, s: str) -> i32 {
    let mut tokens: SmallVector<const char *, 16> = SmallVector<const char *, 16> {};
    TokenizeWindowsCommandLine(s, saver(), tokens, false);
}

fn LinkerDriver::printHelp(self, argv0: *u8) {
    self.ctx.optTable(self.ctx(), (argv0 + " [options] file...")(), "LLVM Linker", false);
}

struct Closure_1 {
    path: *mut str,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> auto {
        return toString("could not open " + (*self.path));
    }

struct Closure_2 {
    path: *mut str,
}

unsafe fn Closure_2::call(self: *mut Closure_2) -> auto {
        return toString("could not open " + (*self.path));
    }

struct Closure_3 {
    cap_0: *mut TemporaryFile,
}

fn Closure_3::call(self: *mut Closure_3) -> auto {
        return toString("could not open " + self.path);
    }

struct Closure_4 {
    user: *mut TemporaryFile,
}

unsafe fn Closure_4::call(self: *mut Closure_4) -> auto {
        return toString("could not open " + (*self.user).path);
    }
