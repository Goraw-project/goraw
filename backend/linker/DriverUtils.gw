fn LinkerDriver::checkFailIfMismatch(self, arg: str, source: *mut InputFile) {
    if k.is_empty() || v.is_empty() {
        Fatal(self.ctx) << "/failifmismatch: invalid argument: " << arg;
    }
    let mut existing: pair<StringRef, InputFile *> = self.ctx.config.mustMatch[k];
    if !existing.first.is_empty() && v != existing.first {
        let mut sourceStr: str = if source { toString(source) } else { "cmd-line" };
        let mut existingStr: str = if existing.second { toString(existing.second) } else { "cmd-line" };
        Fatal(self.ctx) << "/failifmismatch: mismatch detected for '" << k << "':\n>>> " << existingStr << " has value " << existing.first << "\n>>> " << sourceStr << " has value " << v;
    }
    self.ctx.config.mustMatch[k] = InputFile *> { v, source };
}

fn LinkerDriver::convertResToCOFF(self, mbs: ArrayRef<MemoryBufferRef>, objs: ArrayRef<ObjFile *>) -> MemoryBufferRef {
    let mut parser: WindowsResourceParser = self.ctx.config.mingw;
    let mut duplicates: []str = []str {};
    for mb in mbs {
        let mut bin: Binary> = check(createBinary(mb, null, true));
        let mut rf: *mut WindowsResource = dyn_cast(bin.get());
        if !rf {
            Fatal(self.ctx) << "cannot compile non-resource file as resource";
        }
        if parser.parse(rf, duplicates) {
            ec;
        } else {
            Fatal(self.ctx) << toString(move(ec));
        }
    }
    for f in objs {
        let mut rsf: ResourceSectionRef = ResourceSectionRef {};
        if rsf.load(f.getCOFFObj()) {
            ec;
        } else {
            Fatal(self.ctx) << toString(f) << ": " << toString(move(ec));
        }
        if parser.parse(rsf, f.getName(), duplicates) {
            ec;
        } else {
            Fatal(self.ctx) << toString(move(ec));
        }
    }
    if self.ctx.config.mingw {
        parser.cleanUpManifests(duplicates);
    }
    for dupeDiag in duplicates {
        if self.ctx.config.forceMultipleRes {
            Warn(self.ctx) << dupeDiag;
        } else {
            Err(self.ctx) << dupeDiag;
        }
    }
    let mut e: unique_ptr<MemoryBuffer>> = writeWindowsResourceCOFF(self.ctx.config.machine, parser, self.ctx.config.timestamp);
    if !e {
        Fatal(self.ctx) << "failed to write .res to COFF: " << toString(e.takeError());
    }
    let mut mbref: MemoryBufferRef = operator(operator(e));
    make(move(operator(e)));
    return mbref;
}

fn handleColorDiagnostics(ctx: *mut COFFLinkerContext, args: *mut InputArgList) {
    let mut arg: *mut Arg = args.getLastArg(OPT_color_diagnostics, OPT_color_diagnostics_eq, OPT_no_color_diagnostics);
    if !arg {
        return;
    }
    if arg.getOption().getID() == OPT_color_diagnostics {
        ctx.e.errs().enable_colors(true);
    } else if arg.getOption().getID() == OPT_no_color_diagnostics {
        ctx.e.errs().enable_colors(false);
    } else {
        let mut s: str = arg.getValue(0);
        if s == "always" {
            ctx.e.errs().enable_colors(true);
        } else if s == "never" {
            ctx.e.errs().enable_colors(false);
        } else if s != "auto" {
            Err(ctx) << "unknown option: --color-diagnostics=" << s;
        }
    }
}

fn getQuotingStyle(ctx: *mut COFFLinkerContext, args: *mut InputArgList) -> TokenizerCallback {
    if args.getLastArg(OPT_rsp_quoting) {
        arg;
    } else {
        let mut s: str = arg.getValue(0);
        if s != "windows" && s != "posix" {
            Err(ctx) << "invalid response file quoting: " << s;
        }
        if s == "windows" {
            return TokenizeWindowsCommandLine;
        }
        return TokenizeGNUCommandLine;
    }
    return TokenizeWindowsCommandLine;
}

fn ArgParser::parse(self, argv: ArrayRef<const char *>) -> InputArgList {
    let mut missingIndex: u32 = 0;
    let mut missingCount: u32 = 0;
    let mut args: InputArgList = self.ctx.optTable.ParseArgs(argv, missingIndex, missingCount, Visibility {});
    let mut expandedArgv: SmallVector<const char *, 256> = SmallVector<const char *, 256> { argv.ptr, argv.ptr + argv.len };
    if !args.hasArg(OPT_lldignoreenv) {
        self.addLINK(expandedArgv);
    }
    ExpandResponseFiles(saver(), getQuotingStyle(self.ctx, args), expandedArgv);
    args = self.ctx.optTable.ParseArgs(expandedArgv.drop_front(1), missingIndex, missingCount, Visibility {});
    if args.hasArg(OPT_verbose) && argv.len != expandedArgv.len {
        let mut msg: str = "Command line:";
        for s in expandedArgv {
            operator(msg, " " + s);
        }
        Msg(self.ctx) << msg;
    }
    self.ctx.config.argv = [argv[0]];
    for arg in args {
        if arg.getOption().getKind() != InputClass {
            self.ctx.config.argv.push(args.getArgString(arg.getIndex()));
        }
    }
    self.ctx.e.fatalWarnings = args.hasFlag(OPT_WX, OPT_WX_no, false);
    if missingCount {
        Fatal(self.ctx) << args.getArgString(missingIndex) << ": missing argument";
    }
    handleColorDiagnostics(self.ctx, args);
    for arg in args.filtered(OPT_UNKNOWN) {
        let mut nearest: str = "";
        if self.ctx.optTable.findNearest(arg.getAsString(args), nearest, Visibility {}, 4, 4294967295) > 1 {
            Warn(self.ctx) << "ignoring unknown argument '" << arg.getAsString(args) << "'";
        } else {
            Warn(self.ctx) << "ignoring unknown argument '" << arg.getAsString(args) << "', did you mean '" << nearest << "'";
        }
    }
    if args.hasArg(OPT_link) {
        Warn(self.ctx) << "ignoring /link, did you pass it multiple times?";
    }
    if args.hasArg(OPT_lib) {
        Warn(self.ctx) << "ignoring /lib since it's not the first argument";
    }
    return args;
}

fn ArgParser::parseDirectives(self, s: str) -> ParsedDirectives {
    let mut result: ParsedDirectives = ParsedDirectives {};
    let mut rest: SmallVector<const char *, 16> = SmallVector<const char *, 16> {};
    let mut tokens: SmallVector<StringRef, 16> = SmallVector<StringRef, 16> {};
    TokenizeWindowsCommandLineNoCopy(s, saver(), tokens);
    for tok in tokens {
        if tok.starts_with_insensitive("/export:") || tok.starts_with_insensitive("-export:") {
            result.exports.push(tok[strlen("/export:")..strlen("/export:") + npos]);
        } else if tok.starts_with_insensitive("/include:") || tok.starts_with_insensitive("-include:") {
            result.includes.push(tok[strlen("/include:")..strlen("/include:") + npos]);
        } else if tok.starts_with_insensitive("/exclude-symbols:") || tok.starts_with_insensitive("-exclude-symbols:") {
            result.excludes.push(tok[strlen("/exclude-symbols:")..strlen("/exclude-symbols:") + npos]);
        } else {
            let mut HasNul: bool = tok.end() != s.end() && tok.ptr[tok.len] == 0;
            rest.push(if HasNul { tok.ptr } else { saver().save(tok).ptr });
        }
    }
    let mut missingIndex: u32 = 0;
    let mut missingCount: u32 = 0;
    result.args = self.ctx.optTable.ParseArgs(rest, missingIndex, missingCount, Visibility {});
    if missingCount {
        Fatal(self.ctx) << result.args.getArgString(missingIndex) << ": missing argument";
    }
    for arg in result.args.filtered(OPT_UNKNOWN) {
        Warn(self.ctx) << "ignoring unknown argument: " << arg.getAsString(result.args);
    }
    return result;
}

fn ArgParser::addLINK(self, argv: *SmallVector<const char *, 256>) {
    if GetEnv("LINK") {
        s;
    } else {
        let mut v: []*u8 = self.tokenize(operator(s));
        argv.insert(next(argv.begin(), 1), v.begin(), v.end());
    }
    if GetEnv("_LINK_") {
        s;
    } else {
        let mut v: []*u8 = self.tokenize(operator(s));
        argv.insert(next(argv.begin(), 1), v.begin(), v.end());
    }
}

fn ArgParser::tokenize(self, s: str) -> []*u8 {
    let mut tokens: SmallVector<const char *, 16> = SmallVector<const char *, 16> {};
    TokenizeWindowsCommandLine(s, saver(), tokens, false);
    return []*u8 { tokens.begin(), tokens.end(), allocator<const char *> {} };
}

fn LinkerDriver::printHelp(self, argv0: *u8) {
    self.ctx.optTable.printHelp(self.ctx.e.outs(), (argv0 + " [options] file...").ptr, "LLVM Linker", false, false, Visibility {}, "");
}

struct Closure_1 {
    path: *mut str,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> auto {
        return toString("could not open " + (*self.path));
    }

struct Closure_2 {
    path: *mut str,
}

unsafe fn Closure_2::call(self: *mut Closure_2) -> auto {
        return toString("could not open " + (*self.path));
    }

struct Closure_3 {
    cap_0: *mut TemporaryFile,
}

fn Closure_3::call(self: *mut Closure_3) -> auto {
        return toString("could not open " + self.path);
    }

struct Closure_4 {
    user: *mut TemporaryFile,
}

unsafe fn Closure_4::call(self: *mut Closure_4) -> auto {
        return toString("could not open " + (*self.user).path);
    }
