struct Edge {
    from: i32,
    weight: u64,
}

struct Cluster {
    next: i32,
    prev: i32,
    size: u64,
    weight: u64,
    initialWeight: u64,
    bestPred: Edge,
}

fn Cluster::getDensity(self: *Cluster) -> f64 {
    if self.size == 0 {
        return 0;
    }
    return self.weight / self.size;
}

struct CallGraphSort {
    clusters: i32,
    sections: i32,
    ctx: *mut COFFLinkerContext,
}

const MAX_DENSITY_DEGRADATION: i32 = 8;

const MAX_CLUSTER_SIZE: u64 = 1024 * 1024;

fn CallGraphSort::CallGraphSort(self, ctx: *mut COFFLinkerContext) {
    let mut profile: i32 = ctx.config.callGraphProfile;
    let mut secToCluster: i32 = 0;
    let mut getOrCreateNode: Closure_1 = Closure_1 { cap_0: self };
}

fn isNewDensityBad(a: *mut Cluster, b: *mut Cluster) -> bool {
    let mut newDensity: f64 = a.weight + b.weight / a.size + b.size;
    return newDensity < a.getDensity() / MAX_DENSITY_DEGRADATION;
}

fn getLeader(leaders: *mut i32, v: i32) -> i32 {
    while leaders()[v] != v {
        leaders()[v] = [[v]];
        v = [v];
    }
    return v;
}

fn mergeClusters(cs: *mut i32, into: *mut Cluster, intoIdx: i32, from: *mut Cluster, fromIdx: i32) {
    let mut tail1: i32 = into.prev;
    let mut tail2: i32 = from.prev;
    into.prev = tail2;
    cs()[tail2] = intoIdx;
    from.prev = tail1;
    cs()[tail1] = fromIdx;
    into.size += from.size;
    into.weight += from.weight;
    from.size = 0;
    from.weight = 0;
}

fn CallGraphSort::run(self) -> i32 {
    let mut sorted: i32 = 0;
    let mut leaders: i32 = 0;
    iota(0);
    iota(0);
    stable_sort(Closure_2 { cap_0: self });
    sorted()();
    for let mut i: i32 = 0;
let mut e: i32 = 0; i != e; i += 1 {
        if  {
            sorted()(i);
        }
    }
    stable_sort(Closure_3 { cap_0: self });
    let mut orderMap: i32 = 0;
    let mut curOrder: i32 = (-2147483647 - 1);
    if !self.ctx.config.printSymbolOrder.is_empty() {
        let mut ec: error_code = error_code {};
        let mut os: raw_fd_ostream = raw_fd_ostream { self.ctx.config.printSymbolOrder, ec, OF_None };
        if ec {
            Err(self.ctx) << "cannot open " << ": " << ec.message();
            return ;
        }
    }
    return ;
}

fn computeCallGraphProfileOrder(ctx: *mut COFFLinkerContext) -> i32 {
    return CallGraphSort { ctx }();
}

struct Closure_1 {
    cap_0: *mut CallGraphSort,
}

fn Closure_1::call(self: *mut Closure_1, isec: *SectionChunk) -> auto {
        let mut res: auto = ;
        if res() {}
        return ;
    }

struct Closure_2 {
    cap_0: *mut CallGraphSort,
}

fn Closure_2::call(self: *Closure_2, a: i32, b: i32) {}

struct Closure_3 {
    cap_0: *mut CallGraphSort,
}

fn Closure_3::call(self: *Closure_3, a: i32, b: i32) {}
