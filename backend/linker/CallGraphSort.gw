struct Edge {
    from: i32,
    weight: u64,
}

struct Cluster {
    next: i32,
    prev: i32,
    size: u64,
    weight: u64,
    initialWeight: u64,
    bestPred: Edge,
}

fn Cluster::getDensity(self: *Cluster) -> f64 {
    if self.size == 0 {
        return 0;
    }
    return self.weight / self.size;
}

struct CallGraphSort {
    clusters: []Cluster,
    sections: []*SectionChunk,
    ctx: *mut COFFLinkerContext,
}

const MAX_DENSITY_DEGRADATION: i32 = 8;

const MAX_CLUSTER_SIZE: u64 = 1024 * 1024;

fn CallGraphSort::CallGraphSort(self, ctx: *mut COFFLinkerContext) {
    let mut profile: *MapVector<SectionPair, uint64_t> = ctx.config.callGraphProfile;
    let mut secToCluster: DenseMap<const SectionChunk *, int> = DenseMap<const SectionChunk *, int> {};
    let mut getOrCreateNode: Closure_1 = Closure_1 { secToCluster: &mut secToCluster, cap_1: self };
    for c in profile {
        let mut fromSec: *SectionChunk const = cast(c.first.first.repl);
        let mut toSec: *SectionChunk const = cast(c.first.second.repl);
        let mut weight: u64 = c.second;
        if ctx.getOutputSection(fromSec) != ctx.getOutputSection(toSec) {
            continue;
        }
        let mut from: i32 = getOrCreateNode.call(fromSec);
        let mut to: i32 = getOrCreateNode.call(toSec);
        self.clusters[to].weight += weight;
        if from == to {
            continue;
        }
        let mut toC: *mut Cluster = self.clusters[to];
        if toC.bestPred.from == -1 || toC.bestPred.weight < weight {
            toC.bestPred.from = from;
            toC.bestPred.weight = weight;
        }
    }
    for c in self.clusters {
        c.initialWeight = c.weight;
    }
}

fn isNewDensityBad(a: *mut Cluster, b: *mut Cluster) -> bool {
    let mut newDensity: f64 = a.weight + b.weight / a.size + b.size;
    return newDensity < a.getDensity() / MAX_DENSITY_DEGRADATION;
}

fn getLeader(leaders: *mut []i32, v: i32) -> i32 {
    while leaders[v] != v {
        leaders[v] = leaders[leaders[v]];
        v = leaders[v];
    }
    return v;
}

fn mergeClusters(cs: *mut []Cluster, into: *mut Cluster, intoIdx: i32, from: *mut Cluster, fromIdx: i32) {
    let mut tail1: i32 = into.prev;
    let mut tail2: i32 = from.prev;
    into.prev = tail2;
    cs[tail2].next = intoIdx;
    from.prev = tail1;
    cs[tail1].next = fromIdx;
    into.size += from.size;
    into.weight += from.weight;
    from.size = 0;
    from.weight = 0;
}

fn CallGraphSort::run(self) -> DenseMap<const SectionChunk *, int> {
    let mut sorted: []i32 = []i32 { self.clusters.len, allocator<int> {} };
    let mut leaders: []i32 = []i32 { self.clusters.len, allocator<int> {} };
    iota(leaders.begin(), leaders.end(), 0);
    iota(sorted.begin(), sorted.end(), 0);
    stable_sort(sorted, Closure_2 { cap_0: self });
    for l in sorted {
        let mut c: *mut Cluster = self.clusters[l];
        if c.bestPred.from == -1 || c.bestPred.weight * 10 <= c.initialWeight {
            continue;
        }
        let mut predL: i32 = getLeader(leaders, c.bestPred.from);
        if l == predL {
            continue;
        }
        let mut predC: *mut Cluster = &mut self.clusters[predL];
        if c.size + predC.size > MAX_CLUSTER_SIZE {
            continue;
        }
        if isNewDensityBad(*predC, c) {
            continue;
        }
        leaders[l] = predL;
        mergeClusters(self.clusters, *predC, predL, c, l);
    }
    sorted.clear();
    for let mut i: i32 = 0;
let mut e: i32 = self.clusters.len as i32; i != e; i += 1 {
        if self.clusters[i].size > 0 {
            sorted.push(i);
        }
    }
    stable_sort(sorted, Closure_3 { cap_0: self });
    let mut orderMap: DenseMap<const SectionChunk *, int> = DenseMap<const SectionChunk *, int> {};
    let mut curOrder: i32 = (-2147483647 - 1);
    for leader in sorted {
        for let mut i: i32 = leader; ;  {
            orderMap[self.sections[i]] = curOrder += 1;
            i = self.clusters[i].next;
            if i == leader {
                break;
            }
        }
    }
    if !self.ctx.config.printSymbolOrder.is_empty() {
        let mut ec: error_code = error_code {};
        let mut os: raw_fd_ostream = raw_fd_ostream { self.ctx.config.printSymbolOrder, ec, OF_None };
        if ec {
            Err(self.ctx) << "cannot open " << self.ctx.config.printSymbolOrder << ": " << ec.message();
            return orderMap;
        }
        for leader in sorted {
            for let mut i: i32 = leader; ;  {
                let mut sc: *SectionChunk = self.sections[i];
                for sym in sc.file.getSymbols() {
                    if dyn_cast_or_null(sym) {
                        d;
                    } else if d.isCOMDAT && !d.getCOFFSymbol().isSection() && sc == d.getChunk() {
                        os << sym.getName() << "\n";
                    }
                }
                i = self.clusters[i].next;
                if i == leader {
                    break;
                }
            }
        }
    }
    return orderMap;
}

fn computeCallGraphProfileOrder(ctx: *mut COFFLinkerContext) -> DenseMap<const SectionChunk *, int> {
    return ctx.run();
}

struct Closure_1 {
    secToCluster: *mut DenseMap<const SectionChunk *, int>,
    cap_1: *mut CallGraphSort,
}

unsafe fn Closure_1::call(self: *mut Closure_1, isec: *SectionChunk) -> auto {
        let mut res: pair<iterator, bool> = (*self.secToCluster).try_emplace(isec, self.clusters.len);
        if res.second {
            self.sections.push(isec);
            self.clusters.push(self.clusters.len, isec.getSize());
        }
        return operator(res.first).second;
    }

struct Closure_2 {
    cap_0: *mut CallGraphSort,
}

fn Closure_2::call(self: *Closure_2, a: i32, b: i32) -> bool {
        return self.clusters[a].getDensity() > self.clusters[b].getDensity();
    }

struct Closure_3 {
    cap_0: *mut CallGraphSort,
}

fn Closure_3::call(self: *Closure_3, a: i32, b: i32) -> bool {
        return self.clusters[a].getDensity() > self.clusters[b].getDensity();
    }
