            let mut Template: TemplateTy = zeroed();
            if isEndOfTemplateArgument(self.Tok) && self.Actions.ActOnTemplateName(self.getCurScope(), SS, TemplateKWLoc, Name, null, false) {
                Result = TemplateKWLoc;
