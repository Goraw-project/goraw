fn Parser::ReenterTemplateScopes(self, S: *mut MultiParseScope, D: *mut Decl) -> u32 {
    return self.Actions.ActOnReenterTemplateScope;
}

fn Parser::ParseDeclarationStartingWithTemplate(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, AccessAttrs: *mut ParsedAttributes) -> DeclGroupPtrTy {
    let mut ObjCDC: ObjCDeclContextSwitch = *self;
    if self.Tok.is(kw_template) && self.NextToken().isNot(less) {
        return self.ParseExplicitInstantiation;
    }
    return self.ParseTemplateDeclarationOrSpecialization;
}

fn Parser::ParseTemplateDeclarationOrSpecialization(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, AccessAttrs: *mut ParsedAttributes, AS: AccessSpecifier) -> DeclGroupPtrTy {
    assert!(self.Tok, "Token does not start a template declaration.");
    let mut TemplateParamScopes: MultiParseScope = *self;
    let mut ParsingTemplateParams: ParsingDeclRAIIObject = ParsingDeclRAIIObject { *self, NoParent };
    let mut isSpecialization: bool = true;
    let mut LastParamListWasEmpty: bool = false;
    let mut ParamLists: TemplateParameterLists = zeroed();
    let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
    while true {
        {
        let mut ExportLoc: SourceLocation = SourceLocation {};
        self.TryConsumeToken(kw_export, ExportLoc);
        let mut TemplateLoc: SourceLocation = SourceLocation {};
        if !self.TryConsumeToken(kw_template, TemplateLoc) {
            return null;
        }
        let mut LAngleLoc: SourceLocation = SourceLocation {};
        let mut RAngleLoc: SourceLocation = SourceLocation {};
        let mut TemplateParams: SmallVector<NamedDecl *, 4> = zeroed();
        if self.ParseTemplateParameters(TemplateParamScopes, CurTemplateDepthTracker.getDepth(), LAngleLoc, RAngleLoc) {
            self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
            self.TryConsumeToken(semi);
            return null;
        }
        let mut OptionalRequiresClauseConstraintER: i32 = 0;
        if operator!() {
            isSpecialization = false;
            operator(CurTemplateDepthTracker);
            if self.TryConsumeToken(kw_requires) {
                OptionalRequiresClauseConstraintER() = self.Actions;
                if operator!() {
                    self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
                    self.TryConsumeToken(semi);
                    return null;
                }
            }
        } else {
            LastParamListWasEmpty = true;
        }
        ParamLists()(self.Actions.ActOnTemplateParameterList(CurTemplateDepthTracker.getDepth(), ExportLoc, TemplateLoc, LAngleLoc, RAngleLoc));
    }
        if !(self.Tok) { break; }
    }
    let mut TemplateInfo: ParsedTemplateInfo = operator&();
    if self.Tok.is(kw_concept) {
        let mut ConceptDecl: *mut Decl = self.ParseConceptDefinition(TemplateInfo, DeclEnd);
        ParsingTemplateParams.complete(ConceptDecl);
        return self.Actions.ConvertDeclToDeclGroup;
    }
    return self.ParseDeclarationAfterTemplate;
}

fn Parser::ParseTemplateDeclarationOrSpecialization(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, AS: AccessSpecifier) -> DeclGroupPtrTy {
    let mut AccessAttrs: ParsedAttributes = zeroed();
    return self.ParseTemplateDeclarationOrSpecialization;
}

fn Parser::ParseDeclarationAfterTemplate(self, Context: DeclaratorContext, TemplateInfo: *mut ParsedTemplateInfo, DiagsFromTParams: *mut ParsingDeclRAIIObject, DeclEnd: *mut SourceLocation, AccessAttrs: *mut ParsedAttributes, AS: AccessSpecifier) -> DeclGroupPtrTy {
    assert!(TemplateInfo.Kind != NonTemplate, "Template information required");
    if self.Tok.is(kw_static_assert) {
         << TemplateInfo.getSourceRange();
        return self.Actions.ConvertDeclToDeclGroup;
    }
    if Context == Member {
        return self.ParseCXXClassMemberDeclaration;
    }
    let mut DeclAttrs: ParsedAttributes = zeroed();
    let mut DeclSpecAttrs: ParsedAttributes = zeroed();
    while self.MaybeParseCXX11Attributes(DeclAttrs, false) || self.MaybeParseGNUAttributes(DeclSpecAttrs, null) {
        
    }
    if self.Tok.is(kw_using) {
        return self.ParseUsingDirectiveOrDeclaration;
    }
    let mut DS: ParsingDeclSpec = ParsingDeclSpec { *self, &mut DiagsFromTParams };
    DS.SetRangeStart(DeclSpecAttrs()());
    DS.SetRangeEnd(DeclSpecAttrs()());
    DS.takeAttributesAppendingingFrom;
    if self.Tok.is(semi) {
        self.ProhibitAttributes(DeclAttrs, SourceLocation {});
        DeclEnd = self.ConsumeToken();
        let mut AnonRecord: *mut RecordDecl = null;
        let mut Decl: *mut Decl = self.Actions(self.getCurScope(), AS, DS, none(), TemplateInfo.TemplateParams, TemplateInfo.Kind == ExplicitInstantiation, AnonRecord);
        self.Actions.ActOnDefinedDeclarationSpecifier(Decl);
        assert!(!AnonRecord, "Anonymous unions/structs should not be valid with template");
        DS.complete(Decl);
        return self.Actions.ConvertDeclToDeclGroup;
    }
    if DS.hasTagDefinition {
        self.Actions.ActOnDefinedDeclarationSpecifier(DS.getRepAsDecl);
    }
    if TemplateInfo.Kind == ExplicitInstantiation {
        self.ProhibitAttributes(DeclAttrs, SourceLocation {});
    }
    return self.ParseDeclGroup;
}

fn Parser::ParseConceptDefinition(self, TemplateInfo: *ParsedTemplateInfo, DeclEnd: *mut SourceLocation) -> *mut Decl {
    assert!(TemplateInfo.Kind != NonTemplate, "Template information required");
    assert!(self.Tok.is(kw_concept), "ParseConceptDefinition must be called when at a 'concept' keyword");
    self.ConsumeToken();
    let mut BoolKWLoc: SourceLocation = SourceLocation {};
    if self.TryConsumeToken(kw_bool, BoolKWLoc) {
        << CreateRemoval(BoolKWLoc);
    }
    self.DiagnoseAndSkipCXX11Attributes();
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if  || SS.isInvalid() {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    if SS.isNotEmpty() {
        
    }
    let mut Result: UnqualifiedId = UnqualifiedId {};
    if self.ParseUnqualifiedId {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    if Result.getKind() != IK_Identifier {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    let mut Id: *IdentifierInfo = Result();
    let mut IdLoc: SourceLocation = Result.getBeginLoc();
    let mut D: *mut ConceptDecl = self.Actions.ActOnStartConceptDefinition;
    let mut Attrs: ParsedAttributes = zeroed();
    self.MaybeParseAttributes(PAKM_GNU | PAKM_CXX11, Attrs, null);
    if !self.TryConsumeToken(equal) {
         << equal;
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        if D {
            D.setInvalidDecl;
        }
        return null;
    }
    let mut ConstraintExprResult: i32 = 0;
    if ConstraintExprResult()() {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        if D {
            D.setInvalidDecl;
        }
        return null;
    }
    DeclEnd = self.Tok.getLocation();
    self.ExpectAndConsumeSemi;
    let mut ConstraintExpr: *mut Expr = ();
    if !D {
        return null;
    }
    return self.Actions.ActOnFinishConceptDefinition;
}

fn Parser::ParseTemplateParameters(self, TemplateScopes: *mut MultiParseScope, Depth: u32, TemplateParams: *mut SmallVectorImpl<NamedDecl *>, LAngleLoc: *mut SourceLocation, RAngleLoc: *mut SourceLocation) -> bool {
    if !self.TryConsumeToken(less, LAngleLoc) {
         << "template";
        return true;
    }
    let mut Failed: bool = false;
    if !self.Tok.is(greater) && !self.Tok.is(greatergreater) {
        TemplateScopes.Enter(TemplateParamScope);
        Failed = self.ParseTemplateParameterList(Depth, TemplateParams);
    }
    if self.Tok.is(greatergreater) {
        self.Tok.setKind(greater);
        RAngleLoc = self.Tok.getLocation();
        self.Tok.setLocation(self.Tok.getLocation().getLocWithOffset(1));
    } else if !self.TryConsumeToken(greater, RAngleLoc) && Failed {
         << greater;
        return true;
    }
    return false;
}

fn Parser::ParseTemplateParameterList(self, Depth: u32, TemplateParams: *mut SmallVectorImpl<NamedDecl *>) -> bool {
    while true {
        if self.ParseTemplateParameter(Depth, TemplateParams()()) {
            TmpParam;
        } else {
            TemplateParams()(TmpParam);
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        } else if self.Tok {
            break;
        } else {
            self.SkipUntil(comma, greater, greatergreater, StopAtSemi | StopBeforeMatch);
            return false;
        }
    }
    return true;
}

fn Parser::isStartOfTemplateTypeParameter(self) -> TPResult {
    if self.Tok.is(kw_class) {
        match self.NextToken().getKind() {
            equal => {
                comma;
            },
            identifier => {
                break;
            },
            _ => {
                return False;
            },
        }
        match self.GetLookAheadToken(2).getKind() {
            equal => {
                comma;
            },
            _ => {
                return False;
            },
        }
    }
    if self.TryAnnotateTypeConstraint() {
        return Error;
    }
    if self.isTypeConstraintAnnotation() && !self.GetLookAheadToken(if self.Tok.is(annot_cxxscope) { 2 } else { 1 }) {
        return True;
    }
    if self.Tok.isNot(kw_typename) && self.Tok.isNot(kw_typedef) {
        return False;
    }
    let mut Next: Token = self.NextToken();
    if Next.getKind() == identifier {
        Next = self.GetLookAheadToken(2);
    }
    match Next.getKind() {
        equal => {
            comma;
        },
        kw_typename => {
            kw_typedef;
        },
        _ => {
            return False;
        },
    }
}

fn Parser::ParseTemplateParameter(self, Depth: u32, Position: u32) -> *mut NamedDecl {
    match self.isStartOfTemplateTypeParameter() {
        True => {
            if self.Tok.is(kw_typedef) {
                 << CreateReplacement(getCharRange(self.Tok.getLocation(), self.Tok.getEndLoc()), "typename");
                self.Tok.setKind(kw_typename);
            }
        },
        False => {
            break;
        },
        Error => {
            let mut DS: DeclSpec = self.getAttrFactory();
            DS.SetTypeSpecError();
            let mut D: Declarator = Declarator { DS, none(), TemplateParam };
            D.SetIdentifier(null, self.Tok.getLocation());
            D.setInvalidType(true);
            let mut ErrorParam: *mut NamedDecl = self.Actions.ActOnNonTypeTemplateParameter(self.getCurScope(), D, Depth, Position, SourceLocation {}, null);
            ErrorParam.setInvalidDecl;
            self.SkipUntil(comma, greater, greatergreater, StopAtSemi | StopBeforeMatch);
            return ErrorParam;
        },
        Ambiguous => {
            llvm_unreachable_internal("template param classification can't be ambiguous", "clang\\lib\\Parse\\ParseTemplate.cpp", 512);
        },
    }
    if self.Tok.is(kw_template) {
        return self.ParseTemplateTemplateParameter(Depth, Position);
    }
    return self.ParseNonTypeTemplateParameter(Depth, Position);
}

fn Parser::isTypeConstraintAnnotation(self) -> bool {
    let mut T: *Token = if self.Tok.is(annot_cxxscope) { self.NextToken() } else { self.Tok };
    if T.isNot(annot_template_id) {
        return false;
    }
    let mut ExistingAnnot: *TemplateIdAnnotation = T.getAnnotationValue() as *mut TemplateIdAnnotation;
    return ExistingAnnot.Kind == TNK_Concept_template;
}

fn Parser::TryAnnotateTypeConstraint(self) -> bool {
    if operator!(self.getLangOpts()) {
        return false;
    }
    let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
    operator(CurTemplateDepthTracker);
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    let mut WasScopeAnnotation: bool = self.Tok.is(annot_cxxscope);
    if  {
        return true;
    }
    if self.Tok.is(identifier) {
        let mut PossibleConceptName: UnqualifiedId = UnqualifiedId {};
        PossibleConceptName.setIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
        let mut PossibleConcept: TemplateTy = zeroed();
        let mut MemberOfUnknownSpecialization: bool = false;
        let mut TNK: auto = self.Actions.isTemplateName(self.getCurScope(), SS, false, PossibleConceptName, false, MemberOfUnknownSpecialization, false);
        if MemberOfUnknownSpecialization || operator!() ||  != TNK_Concept_template {
            if SS.isNotEmpty() {
                self.AnnotateScopeToken(SS, !WasScopeAnnotation);
            }
            return false;
        }
        if self.AnnotateTemplateIdToken(SS, SourceLocation {}, PossibleConceptName, false, true) {
            return true;
        }
    }
    if SS.isNotEmpty() {
        self.AnnotateScopeToken(SS, !WasScopeAnnotation);
    }
    return false;
}

fn Parser::ParseTypeParameter(self, Depth: u32, Position: u32) -> *mut NamedDecl {
    assert!((self.Tok || self.isTypeConstraintAnnotation()), "A type-parameter starts with 'class', 'typename' or a type-constraint");
    let mut TypeConstraintSS: CXXScopeSpec = CXXScopeSpec {};
    let mut TypeConstraint: *mut TemplateIdAnnotation = null;
    let mut TypenameKeyword: bool = false;
    let mut KeyLoc: SourceLocation = SourceLocation {};
    if self.Tok.is(annot_template_id) {
        TypeConstraint = self.Tok.getAnnotationValue() as *mut TemplateIdAnnotation;
        assert!(TypeConstraint.Kind == TNK_Concept_template, "stray non-concept template-id annotation");
        KeyLoc = self.ConsumeAnnotationToken();
    } else {
        assert!(TypeConstraintSS.isEmpty(), "expected type constraint after scope specifier");
        TypenameKeyword = self.Tok.is(kw_typename);
        KeyLoc = self.ConsumeToken();
    }
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {}
    let mut NameLoc: SourceLocation = self.Tok.getLocation();
    let mut ParamName: *mut IdentifierInfo = null;
    if self.Tok.is(identifier) {
        ParamName = self.Tok.getIdentifierInfo();
        self.ConsumeToken();
    } else if self.Tok {} else {
         << identifier;
        return null;
    }
    let mut AlreadyHasEllipsis: bool = EllipsisLoc.isValid();
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {
        self.DiagnoseMisplacedEllipsis(EllipsisLoc, NameLoc, AlreadyHasEllipsis, true);
    }
    let mut EqualLoc: SourceLocation = SourceLocation {};
    let mut DefaultArg: ParsedType = zeroed();
    let mut DontDestructTemplateIds: optional<DelayTemplateIdDestructionRAII> = zeroed();
    if self.TryConsumeToken(equal, EqualLoc) {
        DontDestructTemplateIds()(*self, true);
        let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
        operator(CurTemplateDepthTracker);
    }
    let mut NewDecl: *mut NamedDecl = self.Actions.ActOnTypeParameter(self.getCurScope(), TypenameKeyword, EllipsisLoc, KeyLoc, ParamName, NameLoc, Depth, Position, EqualLoc, TypeConstraint != null);
    if TypeConstraint {
        self.Actions.ActOnTypeConstraint(TypeConstraintSS, TypeConstraint, cast(NewDecl), EllipsisLoc);
    }
    return NewDecl;
}

fn Parser::ParseTemplateTemplateParameter(self, Depth: u32, Position: u32) -> *mut NamedDecl {
    assert!(self.Tok.is(kw_template), "Expected 'template' keyword");
    let mut TemplateLoc: SourceLocation = self.ConsumeToken();
    let mut TemplateParams: SmallVector<NamedDecl *, 8> = zeroed();
    let mut LAngleLoc: SourceLocation = SourceLocation {};
    let mut RAngleLoc: SourceLocation = SourceLocation {};
    let mut OptionalRequiresClauseConstraintER: i32 = 0;
    {
        let mut TemplateParmScope: MultiParseScope = *self;
        if self.ParseTemplateParameters(TemplateParmScope, Depth + 1, LAngleLoc, RAngleLoc) {
            return null;
        }
        if self.TryConsumeToken(kw_requires) {
            OptionalRequiresClauseConstraintER() = self.Actions;
            if operator!() {
                self.SkipUntil(comma, greater, greatergreater, StopAtSemi | StopBeforeMatch);
                return null;
            }
        }
    }
    let mut Kind: TemplateNameKind = TNK_Non_template;
    let mut NameLoc: SourceLocation = SourceLocation {};
    let mut ParamName: *mut IdentifierInfo = null;
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    let mut TypenameKeyword: bool = false;
    if self.TryConsumeToken(kw_class) {
        Kind = TNK_Type_template;
    } else {
        let mut Replace: bool = self.Tok;
        let mut Next: *Token = if self.Tok.is(kw_struct) { self.NextToken() } else { self.Tok };
        if self.Tok.is(kw_typename) {
            TypenameKeyword = true;
            Kind = TNK_Type_template;
             << (if operator!(self.getLangOpts()) { CreateReplacement(self.Tok.getLocation(), "class") } else { FixItHint {} });
            Kind = TNK_Type_template;
        } else if self.TryConsumeToken(kw_concept) {
            Kind = TNK_Concept_template;
        } else if self.TryConsumeToken(kw_auto) {
            Kind = TNK_Var_template;
        } else if Next {
             << self.getLangOpts() << (if Replace { CreateReplacement(self.Tok.getLocation(), "class") } else { CreateInsertion(self.Tok.getLocation(), "class ", false) });
        }
        if Replace {
            self.ConsumeToken();
        }
    }
    if operator!(self.getLangOpts()) && (Kind == TNK_Concept_template || Kind == TNK_Var_template) {
         << (Kind == TNK_Concept_template);
    }
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {
        
    }
    NameLoc = self.Tok.getLocation();
    if self.Tok.is(identifier) {
        ParamName = self.Tok.getIdentifierInfo();
        self.ConsumeToken();
    } else if self.Tok {} else {
         << identifier;
        return null;
    }
    let mut AlreadyHasEllipsis: bool = EllipsisLoc.isValid();
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {
        self.DiagnoseMisplacedEllipsis(EllipsisLoc, NameLoc, AlreadyHasEllipsis, true);
    }
    let mut ParamList: *mut TemplateParameterList = self.Actions.ActOnTemplateParameterList(Depth, SourceLocation {}, TemplateLoc, LAngleLoc, RAngleLoc);
    let mut EqualLoc: SourceLocation = SourceLocation {};
    let mut DefaultArg: ParsedTemplateArgument = ParsedTemplateArgument {};
    if self.TryConsumeToken(equal, EqualLoc) {
        DefaultArg = self.ParseTemplateTemplateArgument();
        if DefaultArg.isInvalid() {
            self.SkipUntil(comma, greater, greatergreater, StopAtSemi | StopBeforeMatch);
        }
    }
    return self.Actions.ActOnTemplateTemplateParameter(self.getCurScope(), TemplateLoc, Kind, TypenameKeyword, ParamList, EllipsisLoc, ParamName, NameLoc, Depth, Position, EqualLoc, DefaultArg);
}

fn Parser::ParseNonTypeTemplateParameter(self, Depth: u32, Position: u32) -> *mut NamedDecl {
    let mut DS: DeclSpec = zeroed();
    let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
    self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS_none, DSC_template_param, null);
    let mut ParamDecl: Declarator = Declarator { DS, none(), TemplateParam };
    self.ParseDeclarator(ParamDecl);
    if DS.getTypeSpecType() == TST_unspecified {
        return null;
    }
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {
        self.DiagnoseMisplacedEllipsisInDeclarator(EllipsisLoc, ParamDecl);
    }
    let mut EqualLoc: SourceLocation = SourceLocation {};
    let mut DefaultArg: i32 = 0;
    if self.TryConsumeToken(equal, EqualLoc) {
        if self.Tok.is(l_paren) && self.NextToken().is(l_brace) {
             << 1;
            self.SkipUntil(comma, greater, StopAtSemi | StopBeforeMatch);
        } else {
            let mut G: GreaterThanIsOperatorScope = GreaterThanIsOperatorScope { GreaterThanIsOperator: self.GreaterThanIsOperator, OldGreaterThanIsOperator: false };
            let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
            operator(CurTemplateDepthTracker);
            let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
            DefaultArg() = self.Actions;
            if DefaultArg()() {
                self.SkipUntil(comma, greater, StopAtSemi | StopBeforeMatch);
            }
        }
    }
    return self.Actions.ActOnNonTypeTemplateParameter(self.getCurScope(), ParamDecl, Depth, Position, EqualLoc);
}

fn Parser::DiagnoseMisplacedEllipsis(self, EllipsisLoc: SourceLocation, CorrectLoc: SourceLocation, AlreadyHasEllipsis: bool, IdentifierHasName: bool) {
    let mut Insertion: FixItHint = FixItHint {};
    if !AlreadyHasEllipsis {
        Insertion = CreateInsertion(CorrectLoc, "...", false);
    }
     << CreateRemoval(EllipsisLoc) << Insertion << !IdentifierHasName;
}

fn Parser::DiagnoseMisplacedEllipsisInDeclarator(self, EllipsisLoc: SourceLocation, D: *mut Declarator) {
    assert!(EllipsisLoc.isValid();
    let mut AlreadyHasEllipsis: bool = D.getEllipsisLoc().isValid();
    if !AlreadyHasEllipsis {
        D.setEllipsisLoc(EllipsisLoc);
    }
    self.DiagnoseMisplacedEllipsis(EllipsisLoc, D.getIdentifierLoc(), AlreadyHasEllipsis, D.hasName());
}

fn Parser::ParseGreaterThanInTemplateList(self, LAngleLoc: SourceLocation, RAngleLoc: *mut SourceLocation, ConsumeLastToken: bool, ObjCGenericList: bool) -> bool {
    let mut RemainingToken: TokenKind = zeroed();
    let mut ReplacementStr: *u8 = "> >";
    let mut MergeWithNextToken: bool = false;
    match self.Tok.getKind() {
        _ => {
            << greater;
        },
        greater => {
            RAngleLoc = self.Tok.getLocation();
        },
        greatergreater => {
            RemainingToken = greater;
        },
        greatergreatergreater => {
            RemainingToken = greatergreater;
        },
        greaterequal => {
            RemainingToken = equal;
        },
        greatergreaterequal => {
            RemainingToken = greaterequal;
        },
    }
    let mut TokBeforeGreaterLoc: SourceLocation = self.PrevTokLocation;
    let mut TokLoc: SourceLocation = self.Tok.getLocation();
    let mut Next: Token = self.NextToken();
    let mut PreventMergeWithNextToken: bool = (RemainingToken == greater || RemainingToken == greatergreater) && (Next) && self.areTokensAdjacent(self.Tok, Next);
    if !ObjCGenericList {
        let mut ReplacementRange: CharSourceRange = getCharRange(TokLoc, AdvanceToTokenCharacter(TokLoc, 2, self.PP.getSourceManager(), self.getLangOpts()));
        let mut Hint1: FixItHint = CreateReplacement(ReplacementRange, ReplacementStr);
        let mut Hint2: FixItHint = FixItHint {};
        if PreventMergeWithNextToken {
            Hint2 = CreateInsertion(Next.getLocation(), " ", false);
        }
        let mut DiagId: u32 = 0;
        self.Diag(TokLoc, DiagId) << Hint2;
    }
    let mut GreaterLength: u32 = getTokenPrefixLength(TokLoc, 1, self.PP.getSourceManager(), self.getLangOpts());
    RAngleLoc = self.PP.SplitToken(TokLoc, GreaterLength);
    let mut CachingTokens: bool = self.PP.IsPreviousCachedToken(self.Tok);
    let mut Greater: Token = self.Tok;
    Greater.setLocation(RAngleLoc);
    Greater.setKind(greater);
    Greater.setLength(GreaterLength);
    let mut OldLength: u32 = self.Tok.getLength();
    if MergeWithNextToken {
        self.ConsumeToken();
        OldLength += self.Tok.getLength();
    }
    self.Tok.setKind(RemainingToken);
    self.Tok.setLength(OldLength - GreaterLength);
    let mut AfterGreaterLoc: SourceLocation = TokLoc.getLocWithOffset(GreaterLength);
    if PreventMergeWithNextToken {
        AfterGreaterLoc = self.PP.SplitToken(AfterGreaterLoc, self.Tok.getLength());
    }
    self.Tok.setLocation(AfterGreaterLoc);
    if CachingTokens {
        if MergeWithNextToken {
            self.PP.ReplacePreviousCachedToken;
        }
        if ConsumeLastToken {
            self.PP.ReplacePreviousCachedToken;
        } else {
            self.PP.ReplacePreviousCachedToken;
        }
    }
    if ConsumeLastToken {
        self.PrevTokLocation = RAngleLoc;
    } else {
        self.PrevTokLocation = TokBeforeGreaterLoc;
        self.PP.EnterToken(self.Tok, true);
        self.Tok = Greater;
    }
    return false;
}

fn Parser::ParseTemplateIdAfterTemplateName(self, ConsumeLastToken: bool, LAngleLoc: *mut SourceLocation, TemplateArgs: *mut TemplateArgList, RAngleLoc: *mut SourceLocation, Template: TemplateTy) -> bool {
    assert!(self.Tok.is(less), "Must have already parsed the template-name");
    LAngleLoc = self.ConsumeToken();
    let mut Invalid: bool = false;
    {
        let mut G: GreaterThanIsOperatorScope = GreaterThanIsOperatorScope { GreaterThanIsOperator: self.GreaterThanIsOperator, OldGreaterThanIsOperator: false };
        if !self.Tok {
            Invalid = self.ParseTemplateArgumentList(TemplateArgs, LAngleLoc);
        }
        if Invalid {
            if self.getLangOpts() {
                self.SkipUntil(greater, greatergreater, greatergreatergreater, StopAtSemi | StopBeforeMatch);
            } else {
                self.SkipUntil(greater, StopAtSemi | StopBeforeMatch);
            }
        }
    }
    return self.ParseGreaterThanInTemplateList(LAngleLoc, RAngleLoc, ConsumeLastToken, false) || Invalid;
}

fn Parser::AnnotateTemplateIdToken(self, Template: TemplateTy, TNK: TemplateNameKind, SS: *mut CXXScopeSpec, TemplateKWLoc: SourceLocation, TemplateName: *mut UnqualifiedId, AllowTypeAnnotation: bool, TypeConstraint: bool) -> bool {
    (((operator!(operator!((self.getLangOpts() && "Can only annotate template-ids in C++")))) || (_wassert(L"getLangOpts().CPlusPlus && \"Can only annotate template-ids in C++\"", L"clang\\lib\\Parse\\ParseTemplate.cpp", (1097) as u32) , 0)) as void);
    assert!((self.Tok.is(less) || TypeConstraint), "Parser isn't at the beginning of a template-id");
    assert!(!(TypeConstraint && AllowTypeAnnotation), "type-constraint can't be a type annotation");
    assert!((!TypeConstraint || TNK == TNK_Concept_template), "type-constraint must accompany a concept name");
