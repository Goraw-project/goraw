fn Parser::ParseTemplateTemplateArgument(self) -> ParsedTemplateArgument {
    if !self.Tok.is(identifier) && !self.Tok.is(coloncolon) && !self.Tok.is(annot_cxxscope) && !self.Tok.is(annot_template_id) && !self.Tok.is(annot_non_type) {
        return ParsedTemplateArgument {};
    }
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    let mut Result: ParsedTemplateArgument = ParsedTemplateArgument {};
