fn Parser::ReenterTemplateScopes(self, S: *mut MultiParseScope, D: *mut Decl) -> u32 {
    return self.Actions.ActOnReenterTemplateScope(D, function_ref<Scope *()> { Closure_1 { S: &mut S, cap_1: self }, null, null });
}

fn Parser::ParseDeclarationStartingWithTemplate(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, AccessAttrs: *mut ParsedAttributes) -> DeclGroupPtrTy {
    let mut ObjCDC: ObjCDeclContextSwitch = *self;
    if self.Tok.is(kw_template) && self.NextToken().isNot(less) {
        return self.ParseExplicitInstantiation(Context, SourceLocation {}, self.ConsumeToken(), DeclEnd, AccessAttrs, AS_none);
    }
    return self.ParseTemplateDeclarationOrSpecialization(Context, DeclEnd, AccessAttrs, AS_none);
}

fn Parser::ParseTemplateDeclarationOrSpecialization(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, AccessAttrs: *mut ParsedAttributes, AS: AccessSpecifier) -> DeclGroupPtrTy {
    assert!(self.Tok.isOneOf(kw_export, kw_template), "Token does not start a template declaration.");
    let mut TemplateParamScopes: MultiParseScope = *self;
    let mut ParsingTemplateParams: ParsingDeclRAIIObject = ParsingDeclRAIIObject { *self, NoParent };
    let mut isSpecialization: bool = true;
    let mut LastParamListWasEmpty: bool = false;
    let mut ParamLists: TemplateParameterLists = TemplateParameterLists {};
    let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
    while true {
        {
        let mut ExportLoc: SourceLocation = SourceLocation {};
        self.TryConsumeToken(kw_export, ExportLoc);
        let mut TemplateLoc: SourceLocation = SourceLocation {};
        if !self.TryConsumeToken(kw_template, TemplateLoc) {
            self.Diag(self.Tok.getLocation(), err_expected_template);
            return null;
        }
        let mut LAngleLoc: SourceLocation = SourceLocation {};
        let mut RAngleLoc: SourceLocation = SourceLocation {};
        let mut TemplateParams: SmallVector<NamedDecl *, 4> = SmallVector<NamedDecl *, 4> {};
        if self.ParseTemplateParameters(TemplateParamScopes, CurTemplateDepthTracker.getDepth(), TemplateParams, LAngleLoc, RAngleLoc) {
            self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
            self.TryConsumeToken(semi);
            return null;
        }
        let mut OptionalRequiresClauseConstraintER: ExprResult = false;
        if !TemplateParams.is_empty() {
            isSpecialization = false;
            operator(CurTemplateDepthTracker);
            if self.TryConsumeToken(kw_requires) {
                OptionalRequiresClauseConstraintER = self.Actions.ActOnRequiresClause(self.ParseConstraintLogicalOrExpression(false));
                if !OptionalRequiresClauseConstraintER.isUsable() {
                    self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
                    self.TryConsumeToken(semi);
                    return null;
                }
            }
        } else {
            LastParamListWasEmpty = true;
        }
        ParamLists.push(self.Actions.ActOnTemplateParameterList(CurTemplateDepthTracker.getDepth(), ExportLoc, TemplateLoc, LAngleLoc, TemplateParams, RAngleLoc, OptionalRequiresClauseConstraintER.get()));
    }
        if !(self.Tok.isOneOf(kw_export, kw_template)) { break; }
    }
    let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo { &mut ParamLists, isSpecialization, LastParamListWasEmpty };
    if self.Tok.is(kw_concept) {
        let mut ConceptDecl: *mut Decl = self.ParseConceptDefinition(TemplateInfo, DeclEnd);
        ParsingTemplateParams.complete(ConceptDecl);
        return self.Actions.ConvertDeclToDeclGroup(ConceptDecl, null);
    }
    return self.ParseDeclarationAfterTemplate(Context, TemplateInfo, ParsingTemplateParams, DeclEnd, AccessAttrs, AS);
}

fn Parser::ParseTemplateDeclarationOrSpecialization(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, AS: AccessSpecifier) -> DeclGroupPtrTy {
    let mut AccessAttrs: ParsedAttributes = self.AttrFactory;
    return self.ParseTemplateDeclarationOrSpecialization(Context, DeclEnd, AccessAttrs, AS);
}

fn Parser::ParseDeclarationAfterTemplate(self, Context: DeclaratorContext, TemplateInfo: *mut ParsedTemplateInfo, DiagsFromTParams: *mut ParsingDeclRAIIObject, DeclEnd: *mut SourceLocation, AccessAttrs: *mut ParsedAttributes, AS: AccessSpecifier) -> DeclGroupPtrTy {
    assert!(TemplateInfo.Kind != NonTemplate, "Template information required");
    if self.Tok.is(kw_static_assert) {
        self.Diag(self.Tok.getLocation(), err_templated_invalid_declaration) << TemplateInfo.getSourceRange();
        return self.Actions.ConvertDeclToDeclGroup(self.ParseStaticAssertDeclaration(DeclEnd), null);
    }
    if Context == Member {
        return self.ParseCXXClassMemberDeclaration(AS, AccessAttrs, TemplateInfo, &mut DiagsFromTParams);
    }
    let mut DeclAttrs: ParsedAttributes = self.AttrFactory;
    let mut DeclSpecAttrs: ParsedAttributes = self.AttrFactory;
    while self.MaybeParseCXX11Attributes(DeclAttrs, false) || self.MaybeParseGNUAttributes(DeclSpecAttrs, null) {
        
    }
    if self.Tok.is(kw_using) {
        return self.ParseUsingDirectiveOrDeclaration(Context, TemplateInfo, DeclEnd, DeclAttrs);
    }
    let mut DS: ParsingDeclSpec = ParsingDeclSpec { *self, &mut DiagsFromTParams };
    DS.SetRangeStart(DeclSpecAttrs.Range.getBegin());
    DS.SetRangeEnd(DeclSpecAttrs.Range.getEnd());
    DS.takeAttributesAppendingingFrom(DeclSpecAttrs);
    self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS, self.getDeclSpecContextFromDeclaratorContext(Context), null);
    if self.Tok.is(semi) {
        self.ProhibitAttributes(DeclAttrs, SourceLocation {});
        DeclEnd = self.ConsumeToken();
        let mut AnonRecord: *mut RecordDecl = null;
        let mut Decl: *mut Decl = self.Actions.ParsedFreeStandingDeclSpec(self.getCurScope(), AS, DS, none(), if TemplateInfo.TemplateParams { *TemplateInfo.TemplateParams } else { MultiTemplateParamsArg {} }, TemplateInfo.Kind == ExplicitInstantiation, AnonRecord, SourceLocation {});
        self.Actions.ActOnDefinedDeclarationSpecifier(Decl);
        assert!(!AnonRecord, "Anonymous unions/structs should not be valid with template");
        DS.complete(Decl);
        return self.Actions.ConvertDeclToDeclGroup(Decl, null);
    }
    if DS.hasTagDefinition() {
        self.Actions.ActOnDefinedDeclarationSpecifier(DS.getRepAsDecl());
    }
    if TemplateInfo.Kind == ExplicitInstantiation {
        self.ProhibitAttributes(DeclAttrs, SourceLocation {});
    }
    return self.ParseDeclGroup(DS, Context, DeclAttrs, TemplateInfo, &mut DeclEnd, null);
}

fn Parser::ParseConceptDefinition(self, TemplateInfo: *ParsedTemplateInfo, DeclEnd: *mut SourceLocation) -> *mut Decl {
    assert!(TemplateInfo.Kind != NonTemplate, "Template information required");
    assert!(self.Tok.is(kw_concept), "ParseConceptDefinition must be called when at a 'concept' keyword");
    self.ConsumeToken();
    let mut BoolKWLoc: SourceLocation = SourceLocation {};
    if self.TryConsumeToken(kw_bool, BoolKWLoc) {
        self.Diag(self.Tok.getLocation(), err_concept_legacy_bool_keyword) << CreateRemoval(BoolKWLoc);
    }
    self.DiagnoseAndSkipCXX11Attributes();
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, true, false, false, false, false) || SS.isInvalid() {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    if SS.isNotEmpty() {
        self.Diag(SS.getBeginLoc(), err_concept_definition_not_identifier);
    }
    let mut Result: UnqualifiedId = UnqualifiedId {};
    if self.ParseUnqualifiedId(SS, null, false, false, false, false, false, null, Result) {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    if Result.getKind() != IK_Identifier {
        self.Diag(Result.getBeginLoc(), err_concept_definition_not_identifier);
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    let mut Id: *IdentifierInfo = Result..Identifier;
    let mut IdLoc: SourceLocation = Result.getBeginLoc();
    let mut D: *mut ConceptDecl = self.Actions.ActOnStartConceptDefinition(self.getCurScope(), *TemplateInfo.TemplateParams, Id, IdLoc);
    let mut Attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseAttributes(PAKM_GNU | PAKM_CXX11, Attrs, null);
    if !self.TryConsumeToken(equal) {
        self.Diag(self.Tok.getLocation(), err_expected) << equal;
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        if D {
            D.setInvalidDecl(true);
        }
        return null;
    }
    let mut ConstraintExprResult: ExprResult = self.ParseConstraintExpression();
    if ConstraintExprResult.isInvalid() {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        if D {
            D.setInvalidDecl(true);
        }
        return null;
    }
    DeclEnd = self.Tok.getLocation();
    self.ExpectAndConsumeSemi(err_expected_semi_declaration, "");
    let mut ConstraintExpr: *mut Expr = ConstraintExprResult.get();
    if !D {
        return null;
    }
    return self.Actions.ActOnFinishConceptDefinition(self.getCurScope(), D, ConstraintExpr, Attrs);
}

fn Parser::ParseTemplateParameters(self, TemplateScopes: *mut MultiParseScope, Depth: u32, TemplateParams: *mut SmallVectorImpl<NamedDecl *>, LAngleLoc: *mut SourceLocation, RAngleLoc: *mut SourceLocation) -> bool {
    if !self.TryConsumeToken(less, LAngleLoc) {
        self.Diag(self.Tok.getLocation(), err_expected_less_after) << "template";
        return true;
    }
    let mut Failed: bool = false;
    if !self.Tok.is(greater) && !self.Tok.is(greatergreater) {
        TemplateScopes.Enter(TemplateParamScope);
        Failed = self.ParseTemplateParameterList(Depth, TemplateParams);
    }
    if self.Tok.is(greatergreater) {
        self.Tok.setKind(greater);
        RAngleLoc = self.Tok.getLocation();
        self.Tok.setLocation(self.Tok.getLocation().getLocWithOffset(1));
    } else if !self.TryConsumeToken(greater, RAngleLoc) && Failed {
        self.Diag(self.Tok.getLocation(), err_expected) << greater;
        return true;
    }
    return false;
}

fn Parser::ParseTemplateParameterList(self, Depth: u32, TemplateParams: *mut SmallVectorImpl<NamedDecl *>) -> bool {
    while true {
        if self.ParseTemplateParameter(Depth, TemplateParams.len) {
            TmpParam;
        } else {
            TemplateParams.push(TmpParam);
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        } else if self.Tok.isOneOf(greater, greatergreater) {
            break;
        } else {
            self.Diag(self.Tok.getLocation(), err_expected_comma_greater);
            self.SkipUntil(comma, greater, greatergreater, StopAtSemi | StopBeforeMatch);
            return false;
        }
    }
    return true;
}

fn Parser::isStartOfTemplateTypeParameter(self) -> TPResult {
    if self.Tok.is(kw_class) {
        match self.NextToken().getKind() {
            equal => {
                comma;
            },
            identifier => {
                break;
            },
            _ => {
                return False;
            },
        }
        match self.GetLookAheadToken(2).getKind() {
            equal => {
                comma;
            },
            _ => {
                return False;
            },
        }
    }
    if self.TryAnnotateTypeConstraint() {
        return Error;
    }
    if self.isTypeConstraintAnnotation() && !self.GetLookAheadToken(if self.Tok.is(annot_cxxscope) { 2 } else { 1 }).isOneOf(kw_auto, kw_decltype) {
        return True;
    }
    if self.Tok.isNot(kw_typename) && self.Tok.isNot(kw_typedef) {
        return False;
    }
    let mut Next: Token = self.NextToken();
    if Next.getKind() == identifier {
        Next = self.GetLookAheadToken(2);
    }
    match Next.getKind() {
        equal => {
            comma;
        },
        kw_typename => {
            kw_typedef;
        },
        _ => {
            return False;
        },
    }
}

fn Parser::ParseTemplateParameter(self, Depth: u32, Position: u32) -> *mut NamedDecl {
    match self.isStartOfTemplateTypeParameter() {
        True => {
            if self.Tok.is(kw_typedef) {
                self.Diag(self.Tok.getLocation(), err_expected_template_parameter);
                self.Diag(self.Tok.getLocation(), note_meant_to_use_typename) << CreateReplacement(getCharRange(self.Tok.getLocation(), self.Tok.getEndLoc()), "typename");
                self.Tok.setKind(kw_typename);
            }
        },
        False => {
            break;
        },
        Error => {
            let mut DS: DeclSpec = self.getAttrFactory();
            DS.SetTypeSpecError();
            let mut D: Declarator = Declarator { DS, none(), TemplateParam };
            D.SetIdentifier(null, self.Tok.getLocation());
            D.setInvalidType(true);
            let mut ErrorParam: *mut NamedDecl = self.Actions.ActOnNonTypeTemplateParameter(self.getCurScope(), D, Depth, Position, SourceLocation {}, null);
            ErrorParam.setInvalidDecl(true);
            self.SkipUntil(comma, greater, greatergreater, StopAtSemi | StopBeforeMatch);
            return ErrorParam;
        },
        Ambiguous => {
            llvm_unreachable_internal("template param classification can't be ambiguous", "P:/Goraw/llvm-project/clang/lib/Parse/ParseTemplate.cpp", 512);
        },
    }
    if self.Tok.is(kw_template) {
        return self.ParseTemplateTemplateParameter(Depth, Position);
    }
    return self.ParseNonTypeTemplateParameter(Depth, Position);
}

fn Parser::isTypeConstraintAnnotation(self) -> bool {
    let mut T: *Token = if self.Tok.is(annot_cxxscope) { self.NextToken() } else { self.Tok };
    if T.isNot(annot_template_id) {
        return false;
    }
    let mut ExistingAnnot: *TemplateIdAnnotation = T.getAnnotationValue() as *mut TemplateIdAnnotation;
    return ExistingAnnot.Kind == TNK_Concept_template;
}

fn Parser::TryAnnotateTypeConstraint(self) -> bool {
    if !self.getLangOpts().CPlusPlus20 {
        return false;
    }
    let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
    operator(CurTemplateDepthTracker);
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    let mut WasScopeAnnotation: bool = self.Tok.is(annot_cxxscope);
    if self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, true, null, false, false, false, false, false) {
        return true;
    }
    if self.Tok.is(identifier) {
        let mut PossibleConceptName: UnqualifiedId = UnqualifiedId {};
        PossibleConceptName.setIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
        let mut PossibleConcept: TemplateTy = null;
        let mut MemberOfUnknownSpecialization: bool = false;
        let mut TNK: TemplateNameKind = self.Actions.isTemplateName(self.getCurScope(), SS, false, PossibleConceptName, ParsedType { null }, false, PossibleConcept, MemberOfUnknownSpecialization, false);
        if MemberOfUnknownSpecialization || !PossibleConcept || TNK != TNK_Concept_template {
            if SS.isNotEmpty() {
                self.AnnotateScopeToken(SS, !WasScopeAnnotation);
            }
            return false;
        }
        if self.AnnotateTemplateIdToken(PossibleConcept, TNK, SS, SourceLocation {}, PossibleConceptName, false, true) {
            return true;
        }
    }
    if SS.isNotEmpty() {
        self.AnnotateScopeToken(SS, !WasScopeAnnotation);
    }
    return false;
}

fn Parser::ParseTypeParameter(self, Depth: u32, Position: u32) -> *mut NamedDecl {
    assert!((self.Tok.isOneOf(kw_class, kw_typename) || self.isTypeConstraintAnnotation()), "A type-parameter starts with 'class', 'typename' or a type-constraint");
    let mut TypeConstraintSS: CXXScopeSpec = CXXScopeSpec {};
    let mut TypeConstraint: *mut TemplateIdAnnotation = null;
    let mut TypenameKeyword: bool = false;
    let mut KeyLoc: SourceLocation = SourceLocation {};
    self.ParseOptionalCXXScopeSpecifier(TypeConstraintSS, null, false, false, null, false, null, false, false, false, false, false);
    if self.Tok.is(annot_template_id) {
        TypeConstraint = self.Tok.getAnnotationValue() as *mut TemplateIdAnnotation;
        assert!(TypeConstraint.Kind == TNK_Concept_template, "stray non-concept template-id annotation");
        KeyLoc = self.ConsumeAnnotationToken();
    } else {
        assert!(TypeConstraintSS.isEmpty(), "expected type constraint after scope specifier");
        TypenameKeyword = self.Tok.is(kw_typename);
        KeyLoc = self.ConsumeToken();
    }
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {
        self.DiagCompat(EllipsisLoc, variadic_templates);
    }
    let mut NameLoc: SourceLocation = self.Tok.getLocation();
    let mut ParamName: *mut IdentifierInfo = null;
    if self.Tok.is(identifier) {
        ParamName = self.Tok.getIdentifierInfo();
        self.ConsumeToken();
    } else if self.Tok.isOneOf(equal, comma, greater, greatergreater) {} else {
        self.Diag(self.Tok.getLocation(), err_expected) << identifier;
        return null;
    }
    let mut AlreadyHasEllipsis: bool = EllipsisLoc.isValid();
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {
        self.DiagnoseMisplacedEllipsis(EllipsisLoc, NameLoc, AlreadyHasEllipsis, true);
    }
    let mut EqualLoc: SourceLocation = SourceLocation {};
    let mut DefaultArg: ParsedType = null;
    let mut DontDestructTemplateIds: optional<DelayTemplateIdDestructionRAII> = optional<DelayTemplateIdDestructionRAII> {};
    if self.TryConsumeToken(equal, EqualLoc) {
        DontDestructTemplateIds.emplace(*self, true);
        let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
        operator(CurTemplateDepthTracker);
        DefaultArg = self.ParseTypeName(null, TemplateTypeArg, AS_none, null, null).get();
    }
    let mut NewDecl: *mut NamedDecl = self.Actions.ActOnTypeParameter(self.getCurScope(), TypenameKeyword, EllipsisLoc, KeyLoc, ParamName, NameLoc, Depth, Position, EqualLoc, DefaultArg, TypeConstraint != null);
    if TypeConstraint {
        self.Actions.ActOnTypeConstraint(TypeConstraintSS, TypeConstraint, cast(NewDecl), EllipsisLoc);
    }
    return NewDecl;
}

fn Parser::ParseTemplateTemplateParameter(self, Depth: u32, Position: u32) -> *mut NamedDecl {
    assert!(self.Tok.is(kw_template), "Expected 'template' keyword");
    let mut TemplateLoc: SourceLocation = self.ConsumeToken();
    let mut TemplateParams: SmallVector<NamedDecl *, 8> = SmallVector<NamedDecl *, 8> {};
    let mut LAngleLoc: SourceLocation = SourceLocation {};
    let mut RAngleLoc: SourceLocation = SourceLocation {};
    let mut OptionalRequiresClauseConstraintER: ExprResult = false;
    {
        let mut TemplateParmScope: MultiParseScope = *self;
        if self.ParseTemplateParameters(TemplateParmScope, Depth + 1, TemplateParams, LAngleLoc, RAngleLoc) {
            return null;
        }
        if self.TryConsumeToken(kw_requires) {
            OptionalRequiresClauseConstraintER = self.Actions.ActOnRequiresClause(self.ParseConstraintLogicalOrExpression(false));
            if !OptionalRequiresClauseConstraintER.isUsable() {
                self.SkipUntil(comma, greater, greatergreater, StopAtSemi | StopBeforeMatch);
                return null;
            }
        }
    }
    let mut Kind: TemplateNameKind = TNK_Non_template;
    let mut NameLoc: SourceLocation = SourceLocation {};
    let mut ParamName: *mut IdentifierInfo = null;
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    let mut TypenameKeyword: bool = false;
    if self.TryConsumeToken(kw_class) {
        Kind = TNK_Type_template;
    } else {
        let mut Replace: bool = self.Tok.isOneOf(kw_typename, kw_struct);
        let mut Next: *Token = if self.Tok.is(kw_struct) { self.NextToken() } else { self.Tok };
        if self.Tok.is(kw_typename) {
            TypenameKeyword = true;
            Kind = TNK_Type_template;
            self.DiagCompat(self.Tok.getLocation(), template_template_param_typename) << (if !self.getLangOpts().CPlusPlus17 { CreateReplacement(self.Tok.getLocation(), "class") } else { FixItHint {} });
            Kind = TNK_Type_template;
        } else if self.TryConsumeToken(kw_concept) {
            Kind = TNK_Concept_template;
        } else if self.TryConsumeToken(kw_auto) {
            Kind = TNK_Var_template;
        } else if Next.isOneOf(identifier, comma, greater, greatergreater, ellipsis) {
            self.Diag(self.Tok.getLocation(), err_class_on_template_template_param) << self.getLangOpts().CPlusPlus17 << (if Replace { CreateReplacement(self.Tok.getLocation(), "class") } else { CreateInsertion(self.Tok.getLocation(), "class ", false) });
        }
        if Replace {
            self.ConsumeToken();
        }
    }
    if !self.getLangOpts().CPlusPlus26 && (Kind == TNK_Concept_template || Kind == TNK_Var_template) {
        self.Diag(self.PrevTokLocation, err_cxx26_template_template_params) << (Kind == TNK_Concept_template);
    }
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {
        self.DiagCompat(EllipsisLoc, variadic_templates);
    }
    NameLoc = self.Tok.getLocation();
    if self.Tok.is(identifier) {
        ParamName = self.Tok.getIdentifierInfo();
        self.ConsumeToken();
    } else if self.Tok.isOneOf(equal, comma, greater, greatergreater) {} else {
        self.Diag(self.Tok.getLocation(), err_expected) << identifier;
        return null;
    }
    let mut AlreadyHasEllipsis: bool = EllipsisLoc.isValid();
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {
        self.DiagnoseMisplacedEllipsis(EllipsisLoc, NameLoc, AlreadyHasEllipsis, true);
    }
    let mut ParamList: *mut TemplateParameterList = self.Actions.ActOnTemplateParameterList(Depth, SourceLocation {}, TemplateLoc, LAngleLoc, TemplateParams, RAngleLoc, OptionalRequiresClauseConstraintER.get());
    let mut EqualLoc: SourceLocation = SourceLocation {};
    let mut DefaultArg: ParsedTemplateArgument = ParsedTemplateArgument {};
    if self.TryConsumeToken(equal, EqualLoc) {
        DefaultArg = self.ParseTemplateTemplateArgument();
        if DefaultArg.isInvalid() {
            self.Diag(self.Tok.getLocation(), err_default_template_template_parameter_not_template);
            self.SkipUntil(comma, greater, greatergreater, StopAtSemi | StopBeforeMatch);
        }
    }
    return self.Actions.ActOnTemplateTemplateParameter(self.getCurScope(), TemplateLoc, Kind, TypenameKeyword, ParamList, EllipsisLoc, ParamName, NameLoc, Depth, Position, EqualLoc, DefaultArg);
}

fn Parser::ParseNonTypeTemplateParameter(self, Depth: u32, Position: u32) -> *mut NamedDecl {
    let mut DS: DeclSpec = self.AttrFactory;
    let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
    self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS_none, DSC_template_param, null);
    let mut ParamDecl: Declarator = Declarator { DS, none(), TemplateParam };
    self.ParseDeclarator(ParamDecl);
    if DS.getTypeSpecType() == TST_unspecified {
        self.Diag(self.Tok.getLocation(), err_expected_template_parameter);
        return null;
    }
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    if self.TryConsumeToken(ellipsis, EllipsisLoc) {
        self.DiagnoseMisplacedEllipsisInDeclarator(EllipsisLoc, ParamDecl);
    }
    let mut EqualLoc: SourceLocation = SourceLocation {};
    let mut DefaultArg: ExprResult = false;
    if self.TryConsumeToken(equal, EqualLoc) {
        if self.Tok.is(l_paren) && self.NextToken().is(l_brace) {
            self.Diag(self.Tok.getLocation(), err_stmt_expr_in_default_arg) << 1;
            self.SkipUntil(comma, greater, StopAtSemi | StopBeforeMatch);
        } else {
            let mut G: GreaterThanIsOperatorScope = GreaterThanIsOperatorScope { GreaterThanIsOperator: self.GreaterThanIsOperator, OldGreaterThanIsOperator: false };
            let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
            operator(CurTemplateDepthTracker);
            let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
            DefaultArg = self.Actions.ActOnConstantExpression(self.ParseInitializer(null));
            if DefaultArg.isInvalid() {
                self.SkipUntil(comma, greater, StopAtSemi | StopBeforeMatch);
            }
        }
    }
    return self.Actions.ActOnNonTypeTemplateParameter(self.getCurScope(), ParamDecl, Depth, Position, EqualLoc, DefaultArg.get());
}

fn Parser::DiagnoseMisplacedEllipsis(self, EllipsisLoc: SourceLocation, CorrectLoc: SourceLocation, AlreadyHasEllipsis: bool, IdentifierHasName: bool) {
    let mut Insertion: FixItHint = FixItHint {};
    if !AlreadyHasEllipsis {
        Insertion = CreateInsertion(CorrectLoc, "...", false);
    }
    self.Diag(EllipsisLoc, err_misplaced_ellipsis_in_declaration) << CreateRemoval(EllipsisLoc) << Insertion << !IdentifierHasName;
}

fn Parser::DiagnoseMisplacedEllipsisInDeclarator(self, EllipsisLoc: SourceLocation, D: *mut Declarator) {
    assert!(EllipsisLoc.isValid();
    let mut AlreadyHasEllipsis: bool = D.getEllipsisLoc().isValid();
    if !AlreadyHasEllipsis {
        D.setEllipsisLoc(EllipsisLoc);
    }
    self.DiagnoseMisplacedEllipsis(EllipsisLoc, D.getIdentifierLoc(), AlreadyHasEllipsis, D.hasName());
}

fn Parser::ParseGreaterThanInTemplateList(self, LAngleLoc: SourceLocation, RAngleLoc: *mut SourceLocation, ConsumeLastToken: bool, ObjCGenericList: bool) -> bool {
    let mut RemainingToken: TokenKind = zeroed();
    let mut ReplacementStr: *u8 = "> >";
    let mut MergeWithNextToken: bool = false;
    match self.Tok.getKind() {
        _ => {
            self.Diag(self.getEndOfPreviousToken(), err_expected) << greater;
        },
        greater => {
            RAngleLoc = self.Tok.getLocation();
        },
        greatergreater => {
            RemainingToken = greater;
        },
        greatergreatergreater => {
            RemainingToken = greatergreater;
        },
        greaterequal => {
            RemainingToken = equal;
        },
        greatergreaterequal => {
            RemainingToken = greaterequal;
        },
    }
    let mut TokBeforeGreaterLoc: SourceLocation = self.PrevTokLocation;
    let mut TokLoc: SourceLocation = self.Tok.getLocation();
    let mut Next: Token = self.NextToken();
    let mut PreventMergeWithNextToken: bool = (RemainingToken == greater || RemainingToken == greatergreater) && (Next.isOneOf(greater, greatergreater, greatergreatergreater, equal, greaterequal, greatergreaterequal, equalequal)) && self.areTokensAdjacent(self.Tok, Next);
    if !ObjCGenericList {
        let mut ReplacementRange: CharSourceRange = getCharRange(TokLoc, AdvanceToTokenCharacter(TokLoc, 2, self.PP.getSourceManager(), self.getLangOpts()));
        let mut Hint1: FixItHint = CreateReplacement(ReplacementRange, ReplacementStr);
        let mut Hint2: FixItHint = FixItHint {};
        if PreventMergeWithNextToken {
            Hint2 = CreateInsertion(Next.getLocation(), " ", false);
        }
        let mut DiagId: u32 = err_two_right_angle_brackets_need_space;
        if self.getLangOpts().CPlusPlus11 && (self.Tok.is(greatergreater) || self.Tok.is(greatergreatergreater)) {
            DiagId = warn_cxx98_compat_two_right_angle_brackets;
        } else if self.Tok.is(greaterequal) {
            DiagId = err_right_angle_bracket_equal_needs_space;
        }
        self.Diag(TokLoc, DiagId) << Hint1 << Hint2;
    }
    let mut GreaterLength: u32 = getTokenPrefixLength(TokLoc, 1, self.PP.getSourceManager(), self.getLangOpts());
    RAngleLoc = self.PP.SplitToken(TokLoc, GreaterLength);
    let mut CachingTokens: bool = self.PP.IsPreviousCachedToken(self.Tok);
    let mut Greater: Token = self.Tok;
    Greater.setLocation(RAngleLoc);
    Greater.setKind(greater);
    Greater.setLength(GreaterLength);
    let mut OldLength: u32 = self.Tok.getLength();
    if MergeWithNextToken {
        self.ConsumeToken();
        OldLength += self.Tok.getLength();
    }
    self.Tok.setKind(RemainingToken);
    self.Tok.setLength(OldLength - GreaterLength);
    let mut AfterGreaterLoc: SourceLocation = TokLoc.getLocWithOffset(GreaterLength);
    if PreventMergeWithNextToken {
        AfterGreaterLoc = self.PP.SplitToken(AfterGreaterLoc, self.Tok.getLength());
    }
    self.Tok.setLocation(AfterGreaterLoc);
    if CachingTokens {
        if MergeWithNextToken {
            self.PP.ReplacePreviousCachedToken(ArrayRef<Token> {});
        }
        if ConsumeLastToken {
            self.PP.ReplacePreviousCachedToken([Greater, self.Tok]);
        } else {
            self.PP.ReplacePreviousCachedToken([Greater]);
        }
    }
    if ConsumeLastToken {
        self.PrevTokLocation = RAngleLoc;
    } else {
        self.PrevTokLocation = TokBeforeGreaterLoc;
        self.PP.EnterToken(self.Tok, true);
        self.Tok = Greater;
    }
    return false;
}

fn Parser::ParseTemplateIdAfterTemplateName(self, ConsumeLastToken: bool, LAngleLoc: *mut SourceLocation, TemplateArgs: *mut TemplateArgList, RAngleLoc: *mut SourceLocation, Template: TemplateTy) -> bool {
    assert!(self.Tok.is(less), "Must have already parsed the template-name");
    LAngleLoc = self.ConsumeToken();
    let mut Invalid: bool = false;
    {
        let mut G: GreaterThanIsOperatorScope = GreaterThanIsOperatorScope { GreaterThanIsOperator: self.GreaterThanIsOperator, OldGreaterThanIsOperator: false };
        if !self.Tok.isOneOf(greater, greatergreater, greatergreatergreater, greaterequal, greatergreaterequal) {
            Invalid = self.ParseTemplateArgumentList(TemplateArgs, Template, LAngleLoc);
        }
        if Invalid {
            if self.getLangOpts().CPlusPlus11 {
                self.SkipUntil(greater, greatergreater, greatergreatergreater, StopAtSemi | StopBeforeMatch);
            } else {
                self.SkipUntil(greater, StopAtSemi | StopBeforeMatch);
            }
        }
    }
    return self.ParseGreaterThanInTemplateList(LAngleLoc, RAngleLoc, ConsumeLastToken, false) || Invalid;
}

fn Parser::AnnotateTemplateIdToken(self, Template: TemplateTy, TNK: TemplateNameKind, SS: *mut CXXScopeSpec, TemplateKWLoc: SourceLocation, TemplateName: *mut UnqualifiedId, AllowTypeAnnotation: bool, TypeConstraint: bool) -> bool {
    assert!(self.getLangOpts().CPlusPlus, "Can only annotate template-ids in C++");
    assert!((self.Tok.is(less) || TypeConstraint), "Parser isn't at the beginning of a template-id");
    assert!(!(TypeConstraint && AllowTypeAnnotation), "type-constraint can't be a type annotation");
    assert!((!TypeConstraint || TNK == TNK_Concept_template), "type-constraint must accompany a concept name");
    assert!((Template || TNK == TNK_Non_template), "missing template name");
    let mut TemplateNameLoc: SourceLocation = TemplateName.getSourceRange().getBegin();
    let mut LAngleLoc: SourceLocation = SourceLocation {};
    let mut RAngleLoc: SourceLocation = SourceLocation {};
    let mut TemplateArgs: TemplateArgList = TemplateArgList {};
    let mut ArgsInvalid: bool = false;
    if !TypeConstraint || self.Tok.is(less) {
        ArgsInvalid = self.ParseTemplateIdAfterTemplateName(false, LAngleLoc, TemplateArgs, RAngleLoc, Template);
        if RAngleLoc.isInvalid() {
            return true;
        }
    }
    let mut TemplateArgsPtr: ASTTemplateArgsPtr = TemplateArgs;
    if TNK == TNK_Type_template && AllowTypeAnnotation {
        let mut Type: TypeResult = if ArgsInvalid { TypeError() } else { self.Actions.ActOnTemplateIdType(self.getCurScope(), None, SourceLocation {}, SS, TemplateKWLoc, Template, TemplateName..Identifier, TemplateNameLoc, LAngleLoc, TemplateArgsPtr, RAngleLoc, false, false, No) };
        self.Tok.setKind(annot_typename);
        setTypeAnnotation(self.Tok, Type);
        if SS.isNotEmpty() {
            self.Tok.setLocation(SS.getBeginLoc());
        } else if TemplateKWLoc.isValid() {
            self.Tok.setLocation(TemplateKWLoc);
        } else {
            self.Tok.setLocation(TemplateNameLoc);
        }
    } else {
        self.Tok.setKind(annot_template_id);
        let mut TemplateII: *IdentifierInfo = if TemplateName.getKind() == IK_Identifier { TemplateName..Identifier } else { null };
        let mut OpKind: OverloadedOperatorKind = if TemplateName.getKind() == IK_Identifier { OO_None } else { TemplateName..OperatorFunctionId.Operator };
        let mut TemplateId: *mut TemplateIdAnnotation = Create(TemplateKWLoc, TemplateNameLoc, TemplateII, OpKind, Template, TNK, LAngleLoc, RAngleLoc, TemplateArgs, ArgsInvalid, self.TemplateIds);
        self.Tok.setAnnotationValue(TemplateId);
        if TemplateKWLoc.isValid() {
            self.Tok.setLocation(TemplateKWLoc);
        } else {
            self.Tok.setLocation(TemplateNameLoc);
        }
    }
    self.Tok.setAnnotationEndLoc(RAngleLoc);
    self.PP.AnnotateCachedTokens(self.Tok);
    return false;
}

fn Parser::AnnotateTemplateIdTokenAsType(self, SS: *mut CXXScopeSpec, AllowImplicitTypename: ImplicitTypenameContext, IsClassName: bool) {
    assert!(self.Tok.is(annot_template_id), "Requires template-id tokens");
    let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
    assert!(TemplateId.mightBeType(), "Only works for type and dependent templates");
    let mut TemplateArgsPtr: ASTTemplateArgsPtr = ASTTemplateArgsPtr { TemplateId.getTemplateArgs(), TemplateId.NumArgs };
    let mut Type: TypeResult = if TemplateId.isInvalid() { TypeError() } else { self.Actions.ActOnTemplateIdType(self.getCurScope(), None, SourceLocation {}, SS, TemplateId.TemplateKWLoc, TemplateId.Template, TemplateId.Name, TemplateId.TemplateNameLoc, TemplateId.LAngleLoc, TemplateArgsPtr, TemplateId.RAngleLoc, false, IsClassName, AllowImplicitTypename) };
    self.Tok.setKind(annot_typename);
    setTypeAnnotation(self.Tok, Type);
    if SS.isNotEmpty() {
        self.Tok.setLocation(SS.getBeginLoc());
    }
    self.PP.AnnotateCachedTokens(self.Tok);
}

fn isEndOfTemplateArgument(Tok: Token) -> bool {
    return Tok.isOneOf(comma, greater, greatergreater, greatergreatergreater);
}

fn Parser::ParseTemplateTemplateArgument(self) -> ParsedTemplateArgument {
    if !self.Tok.is(identifier) && !self.Tok.is(coloncolon) && !self.Tok.is(annot_cxxscope) && !self.Tok.is(annot_template_id) && !self.Tok.is(annot_non_type) {
        return ParsedTemplateArgument {};
    }
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, false, false, false, false, false);
    let mut Result: ParsedTemplateArgument = ParsedTemplateArgument {};
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    if SS.isSet() && self.Tok.is(kw_template) {
        let mut TemplateKWLoc: SourceLocation = self.ConsumeToken();
        if self.Tok.is(identifier) {
            let mut Name: UnqualifiedId = UnqualifiedId {};
            Name.setIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
            self.ConsumeToken();
            self.TryConsumeToken(ellipsis, EllipsisLoc);
            let mut Template: TemplateTy = null;
            if isEndOfTemplateArgument(self.Tok) && self.Actions.ActOnTemplateName(self.getCurScope(), SS, TemplateKWLoc, Name, null, false, Template, false) {
                Result = ParsedTemplateArgument { TemplateKWLoc, SS, Template, Name.StartLocation };
            }
        }
    } else if self.Tok.is(identifier) || self.Tok.is(annot_template_id) || self.Tok.is(annot_non_type) {
        let mut Template: TemplateTy = null;
        let mut Name: UnqualifiedId = UnqualifiedId {};
        let mut IsPackIndexingTemplateName: bool = false;
        if self.Tok.is(annot_non_type) {
            let mut ND: *mut NamedDecl = getNonTypeAnnotation(self.Tok);
            if !isa(ND) {
                return Result;
            }
            Name.setIdentifier(ND.getIdentifier(), self.Tok.getLocation());
            self.ConsumeAnnotationToken();
        } else if self.Tok.is(annot_template_id) {
            let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
            if TemplateId.LAngleLoc.isValid() {
                return Result;
            }
            if TemplateId.Template && TemplateId.Template.get().getAsPackIndexingTemplate() {
                Template = TemplateId.Template;
                IsPackIndexingTemplateName = true;
            }
            Name.setIdentifier(TemplateId.Name, self.Tok.getLocation());
            self.ConsumeAnnotationToken();
        } else {
            Name.setIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
            self.ConsumeToken();
        }
        self.TryConsumeToken(ellipsis, EllipsisLoc);
        if isEndOfTemplateArgument(self.Tok) {
            if IsPackIndexingTemplateName {
                Result = ParsedTemplateArgument { SourceLocation {}, SS, Template, Name.StartLocation };
            } else {
                let mut MemberOfUnknownSpecialization: bool = false;
                let mut TNK: TemplateNameKind = self.Actions.isTemplateName(self.getCurScope(), SS, false, Name, null, false, Template, MemberOfUnknownSpecialization, true);
                if TNK == TNK_Dependent_template_name || TNK == TNK_Type_template || TNK == TNK_Var_template || TNK == TNK_Concept_template {
                    Result = ParsedTemplateArgument { SourceLocation {}, SS, Template, Name.StartLocation };
                }
            }
        }
    }
    Result = self.Actions.ActOnTemplateTemplateArgument(Result);
    if EllipsisLoc.isValid() && !Result.isInvalid() {
        Result = self.Actions.ActOnPackExpansion(Result, EllipsisLoc);
    }
    return Result;
}

fn Parser::ParseTemplateArgument(self) -> ParsedTemplateArgument {
    let mut EnterConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_TemplateArgument, true };
    if self.isCXXTypeId(AsTemplateArgument) {
        let mut TypeArg: TypeResult = self.ParseTypeName(null, TemplateArg, AS_none, null, null);
        return self.Actions.ActOnTemplateTypeArgument(TypeArg);
    }
    {
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        let mut TemplateTemplateArgument: ParsedTemplateArgument = self.ParseTemplateTemplateArgument();
        if !TemplateTemplateArgument.isInvalid() {
            TPA.Commit();
            return TemplateTemplateArgument;
        }
        TPA.Revert();
    }
    let mut ExprArg: ExprResult = false;
    let mut Loc: SourceLocation = self.Tok.getLocation();
    if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
        ExprArg = self.ParseBraceInitializer();
    } else {
        ExprArg = self.ParseConstantExpressionInExprEvalContext(AllowBoth);
    }
    if ExprArg.isInvalid() || !ExprArg.get() {
        return ParsedTemplateArgument {};
    }
    return ParsedTemplateArgument { NonType, ExprArg.get(), Loc };
}

fn Parser::ParseTemplateArgumentList(self, TemplateArgs: *mut TemplateArgList, Template: TemplateTy, OpenLoc: SourceLocation) -> bool {
    let mut ColonProtection: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: false };
    let mut RunSignatureHelp: Closure_2 = Closure_2 { Template: &mut Template, cap_1: self, TemplateArgs: &mut TemplateArgs, OpenLoc: &mut OpenLoc };
    while true {
        {
        self.PreferredType.enterFunctionArgument(self.Tok.getLocation(), function_ref<QualType ()> { RunSignatureHelp, null, null });
        let mut Arg: ParsedTemplateArgument = self.ParseTemplateArgument();
        let mut EllipsisLoc: SourceLocation = SourceLocation {};
        if self.TryConsumeToken(ellipsis, EllipsisLoc) {
            Arg = self.Actions.ActOnPackExpansion(Arg, EllipsisLoc);
        }
        if Arg.isInvalid() {
            if self.PP.isCodeCompletionReached() && !self.CalledSignatureHelp {
                RunSignatureHelp.call();
            }
            return true;
        }
        TemplateArgs.push(Arg);
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    return false;
}

fn Parser::ParseExplicitInstantiation(self, Context: DeclaratorContext, ExternLoc: SourceLocation, TemplateLoc: SourceLocation, DeclEnd: *mut SourceLocation, AccessAttrs: *mut ParsedAttributes, AS: AccessSpecifier) -> DeclGroupPtrTy {
    let mut ParsingTemplateParams: ParsingDeclRAIIObject = ParsingDeclRAIIObject { *self, NoParent };
    let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo { ExternLoc, TemplateLoc };
    return self.ParseDeclarationAfterTemplate(Context, TemplateInfo, ParsingTemplateParams, DeclEnd, AccessAttrs, AS);
}

fn ParsedTemplateInfo@Parser@clang::getSourceRange(self: *ParsedTemplateInfo@Parser@clang) -> SourceRange {
    if self.TemplateParams {
        return getTemplateParamsRange(self.TemplateParams.ptr, self.TemplateParams.len);
    }
    let mut R: SourceRange = self.TemplateLoc;
    if self.ExternLoc.isValid() {
        R.setBegin(self.ExternLoc);
    }
    return R;
}

fn Parser::LateTemplateParserCallback(self, P: *mut void, LPT: *mut LateParsedTemplate) {
    (P as *mut Parser).ParseLateTemplatedFuncDef(LPT);
}

fn Parser::ParseLateTemplatedFuncDef(self, LPT: *mut LateParsedTemplate) {
    if !LPT.D {
        return;
    }
    let mut CleanupRAII: DestroyTemplateIdAnnotationsRAIIObj = *self;
    let mut FunD: *mut FunctionDecl = LPT.D.getAsFunction();
    let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
    let mut Scopes: MultiParseScope = *self;
    let mut DeclContextsToReenter: SmallVector<DeclContext *, 4> = SmallVector<DeclContext *, 4> {};
    let mut LexicalTU: *mut DeclContext = null;
    for let mut DC: *mut DeclContext = FunD; DC; DC = DC.getLexicalParent() {
        if DC.isTranslationUnit() {
            LexicalTU = DC;
            break;
        }
        DeclContextsToReenter.push(DC);
    }
    if !LexicalTU {
        LexicalTU = self.Actions.Context.getTranslationUnitDecl();
    }
    let mut GlobalSavedContext: ContextRAII = ContextRAII { self.Actions, LexicalTU, true };
    for DC in reverse(DeclContextsToReenter) {
        CurTemplateDepthTracker.addDepth(self.ReenterTemplateScopes(Scopes, cast(DC)));
        Scopes.Enter(DeclScope);
        if DC != FunD {
            self.Actions.PushDeclContext(self.Actions.getCurScope(), DC);
        }
    }
    let mut SavedStack: FpPragmaStackSaveRAII = self.Actions;
    self.Actions.resetFPOptions(LPT.FPO);
    assert!(!LPT.Toks.is_empty(), "Empty body!");
    LPT.Toks.push(self.Tok);
    self.PP.EnterTokenStream(LPT.Toks, true, true);
    self.ConsumeAnyToken(true);
    assert!(self.Tok.isOneOf(l_brace, colon, kw_try), "Inline method not starting with '{', ':' or 'try'");
    let mut FnScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope, true, false };
    let mut FunctionSavedContext: ContextRAII = ContextRAII { self.Actions, FunD.getLexicalParent(), true };
    self.Actions.ActOnStartOfFunctionDef(self.getCurScope(), FunD, null, Other);
    assert!((!isa(LPT.D) || cast(LPT.D).getTemplateParameters().getDepth() == self.TemplateParameterDepth - 1), "TemplateParameterDepth should be greater than the depth of current template being instantiated!");
    self.ParseFunctionBody(LPT.D, FnScope);
    self.Actions.UnmarkAsLateParsedTemplate(FunD);
}

fn Parser::LexTemplateFunctionForLateParsing(self, Toks: *mut CachedTokens) {
    let mut kind: TokenKind = self.Tok.getKind();
    if !self.ConsumeAndStoreFunctionPrologue(Toks) {
        self.ConsumeAndStoreUntil(r_brace, Toks, false, true);
    }
    if kind == kw_try {
        while self.Tok.is(kw_catch) {
            self.ConsumeAndStoreUntil(l_brace, Toks, false, true);
            self.ConsumeAndStoreUntil(r_brace, Toks, false, true);
        }
    }
}

fn Parser::diagnoseUnknownTemplateId(self, LHS: ExprResult, Less: SourceLocation) -> bool {
    let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
    if self.SkipUntil(greater, greatergreater, greatergreatergreater, StopAtSemi | StopBeforeMatch) {
        TPA.Commit();
        let mut Greater: SourceLocation = SourceLocation {};
        self.ParseGreaterThanInTemplateList(Less, Greater, true, false);
        self.Actions.diagnoseExprIntendedAsTemplateName(self.getCurScope(), LHS, Less, Greater);
        return true;
    }
    TPA.Revert();
    return false;
}

fn Parser::checkPotentialAngleBracket(self, PotentialTemplateName: *mut ExprResult) {
    assert!(self.Tok.is(less), "not at a potential angle bracket");
    let mut DependentTemplateName: bool = false;
    if !self.Actions.mightBeIntendedToBeTemplateName(PotentialTemplateName, DependentTemplateName) {
        return;
    }
    if self.NextToken().is(greater) || (self.getLangOpts().CPlusPlus11 && self.NextToken().isOneOf(greatergreater, greatergreatergreater)) {
        let mut Less: SourceLocation = self.ConsumeToken();
        let mut Greater: SourceLocation = SourceLocation {};
        self.ParseGreaterThanInTemplateList(Less, Greater, true, false);
        self.Actions.diagnoseExprIntendedAsTemplateName(self.getCurScope(), PotentialTemplateName, Less, Greater);
        PotentialTemplateName = ExprError();
        return;
    }
    {
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        let mut Less: SourceLocation = self.ConsumeToken();
        if self.isTypeIdUnambiguously() && self.diagnoseUnknownTemplateId(PotentialTemplateName, Less) {
            TPA.Commit();
            PotentialTemplateName = ExprError();
            return;
        }
        TPA.Revert();
    }
    let mut Priority: Priority = (if DependentTemplateName { DependentName } else { PotentialTypo }) | (if self.Tok.hasLeadingSpace() { SpaceBeforeLess } else { NoSpaceBeforeLess });
    self.AngleBrackets.add(*self, PotentialTemplateName.get(), self.Tok.getLocation(), Priority);
}

fn Parser::checkPotentialAngleBracketDelimiter(self, LAngle: *Loc, OpToken: *Token) -> bool {
    if OpToken.is(comma) && self.isTypeIdUnambiguously() && self.diagnoseUnknownTemplateId(LAngle.TemplateName, LAngle.LessLoc) {
        self.AngleBrackets.clear(*self);
        return true;
    }
    if OpToken.is(greater) && self.Tok.is(l_paren) && self.NextToken().is(r_paren) {
        self.Actions.diagnoseExprIntendedAsTemplateName(self.getCurScope(), LAngle.TemplateName, LAngle.LessLoc, OpToken.getLocation());
        self.AngleBrackets.clear(*self);
        return true;
    }
    if OpToken.is(greater) || (self.getLangOpts().CPlusPlus11 && OpToken.isOneOf(greatergreater, greatergreatergreater)) {
        self.AngleBrackets.clear(*self);
    }
    return false;
}

struct Closure_1 {
    S: *mut MultiParseScope,
    cap_1: *mut Parser,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> auto {
        (*self.S).Enter(TemplateParamScope);
        return self.Actions.getCurScope();
    }

struct Closure_2 {
    Template: *mut TemplateTy,
    cap_1: *mut Parser,
    TemplateArgs: *mut TemplateArgList,
    OpenLoc: *mut SourceLocation,
}

unsafe fn Closure_2::call(self: *mut Closure_2) -> auto {
        if !(*self.Template) {
            return QualType {};
        }
        self.CalledSignatureHelp = true;
        return self.Actions.CodeCompletion().ProduceTemplateArgumentSignatureHelp((*self.Template), (*self.TemplateArgs), (*self.OpenLoc));
    }
