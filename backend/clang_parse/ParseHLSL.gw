fn validateDeclsInsideHLSLBuffer(DG: DeclGroupPtrTy, BufferLoc: SourceLocation, IsCBuffer: bool, P: *mut Parser) -> bool {
    if operator!() {
        return false;
    }
    let mut Decls: DeclGroupRef = ();
    let mut IsValid: bool = true;
    for let mut I: iterator = Decls.begin();
let mut E: iterator = Decls.end(); I != E; I += 1 {
        let mut D: *mut Decl = *I;
        if isa(D) {
            continue;
        }
        if isa(D) {
            P << IsCBuffer;
            IsValid = false;
            continue;
        }
        IsValid = false;
        P << IsCBuffer;
    }
    return IsValid;
}

fn Parser::ParseHLSLBuffer(self, DeclEnd: *mut SourceLocation, Attrs: *mut ParsedAttributes) -> *mut Decl {
    assert!((self.Tok.is(kw_cbuffer) || self.Tok.is(kw_tbuffer)), "Not a cbuffer or tbuffer!");
    let mut IsCBuffer: bool = self.Tok.is(kw_cbuffer);
    let mut BufferLoc: SourceLocation = self.ConsumeToken();
    if !self.Tok.is(identifier) {
         << identifier;
        return null;
    }
    let mut Identifier: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut IdentifierLoc: SourceLocation = self.ConsumeToken();
    self.MaybeParseHLSLAnnotations(Attrs, null);
    let mut BufferScope: ParseScope = ParseScope { self, DeclScope, true, false };
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    if T.consumeOpen() {
         << l_brace;
        return null;
    }
    let mut D: *mut Decl = self.Actions.HLSL().ActOnStartBuffer(self.getCurScope(), IsCBuffer, BufferLoc, Identifier, IdentifierLoc, T.getOpenLocation());
    self.Actions.ProcessDeclAttributeList;
    while self.Tok.isNot(r_brace) && self.Tok.isNot(eof) {
        let mut DeclAttrs: ParsedAttributes = zeroed();
        let mut EmptyDeclSpecAttrs: ParsedAttributes = zeroed();
        let mut Result: DeclGroupPtrTy = zeroed();
        if operator!(validateDeclsInsideHLSLBuffer(IdentifierLoc, IsCBuffer, *self)) {
            T.skipToEnd();
            DeclEnd = T.getCloseLocation();
            BufferScope.Exit();
            self.Actions.HLSL().ActOnFinishBuffer(D, DeclEnd);
            return null;
        }
    }
    T.consumeClose();
    DeclEnd = T.getCloseLocation();
    BufferScope.Exit();
    self.Actions.HLSL().ActOnFinishBuffer(D, DeclEnd);
    return D;
}

fn fixSeparateAttrArgAndNumber(ArgStr: str, ArgLoc: SourceLocation, Tok: Token, ArgExprs: *mut ArgsVector, P: *mut Parser, Ctx: *mut ASTContext, PP: *mut Preprocessor) {
    let mut Num: str = Tok.getLiteralData()[0..Tok.getLength()];
    let mut EndNumLoc: SourceLocation = Tok.getEndLoc();
    P.ConsumeToken();
    let mut FixedArg: str = zeroed();
    P <<  << CreateReplacement(SourceRange { B: ArgLoc, E: EndNumLoc });
    let mut Slot: *mut ArgsUnion = ArgExprs()();
    Slot(ArgLoc);
}

fn Parser::ParseHLSLSemantic(self) -> ParsedSemantic {
    assert!(self.Tok.is(identifier), "Not a HLSL Annotation");
    let mut Buffer: str = zeroed();
    Buffer()(self.Tok.getLength() + 1);
    let mut Identifier: str = self.PP(self.Tok);
    assert!(Identifier.len > 0);
    let mut IndexIndex: u32 = Identifier.find_last_not_of("0123456789", npos) + 1;
    let mut SemanticName: str = Identifier.take_front(IndexIndex);
    assert!(SemanticName.len > 0);
    let mut Index: u32 = 0;
    let mut Explicit: bool = false;
    if IndexIndex != Identifier.len {
        Explicit = true;
        let mut Failure: bool = Identifier[IndexIndex..IndexIndex + npos];
        assert!(!Failure);
    }
    return ParsedSemantic { SemanticName, Index, Explicit };
}

fn Parser::ParseHLSLAnnotations(self, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, CouldBeBitField: bool) {
    assert!(self.Tok.is(colon), "Not a HLSL Annotation");
    let mut OldToken: Token = self.Tok;
    self.ConsumeToken();
    let mut II: *mut IdentifierInfo = null;
    if self.Tok.is(kw_register) {
        II = self.PP.getIdentifierInfo("register");
    } else if self.Tok.is(identifier) {
        II = self.Tok.getIdentifierInfo();
    }
    if !II {
        if CouldBeBitField {
            self.UnconsumeToken(OldToken);
            return;
        }
        return;
    }
    let mut AttrKind: Kind = getParsedKind(II, null, AS_HLSLAnnotation);
    let mut Semantic: ParsedSemantic = ParsedSemantic {};
    if  {
        Semantic = self.ParseHLSLSemantic();
    }
    let mut Loc: SourceLocation = self.ConsumeToken();
    if EndLoc {
        *EndLoc = self.Tok.getLocation();
    }
    let mut AttrEndLoc: SourceLocation = Loc;
    let mut ArgExprs: ArgsVector = zeroed();
    match AttrKind {
        UnknownAttribute => {
            break;
        },
        _ => {
            llvm_unreachable_internal("invalid HLSL Annotation", "clang\\lib\\Parse\\ParseHLSL.cpp", 338);
        },
    }
    Attrs(II, SourceRange { B: Loc, E: AttrEndLoc }, AttributeScopeInfo {}, HLSLAnnotation());
}
