struct ResetStackCleanup {
}

fn ResetStackCleanup::recoverResources(self) {
    RestorePrettyStackState(self.resource);
}

struct PrettyStackTraceParserEntry {
    NextEntry: *mut PrettyStackTraceEntry,
    P: *Parser,
}

fn PrettyStackTraceParserEntry::getNextEntry(self: *PrettyStackTraceParserEntry) -> *PrettyStackTraceEntry {
    return self.NextEntry;
}

fn PrettyStackTraceParserEntry::print(self: *PrettyStackTraceParserEntry, OS: *mut raw_ostream) {
    let mut Tok: *Token = self.P.getCurToken();
    if Tok.is(eof) {
        OS << "<eof> parser at end of file\n";
        return;
    }
    if Tok.getLocation().isInvalid() {
        OS << "<unknown> parser at unknown location\n";
        return;
    }
    let mut PP: *Preprocessor = self.P.getPreprocessor();
    Tok.getLocation().print(OS, PP.getSourceManager());
    if Tok.isAnnotation() {
        OS << ": at annotation token\n";
    } else {
        let mut Invalid: bool = false;
        let mut SM: *SourceManager = self.P.getPreprocessor().getSourceManager();
        let mut Length: u32 = Tok.getLength();
        let mut Spelling: *u8 = SM.getCharacterData(Tok.getLocation(), &mut Invalid);
        if Invalid {
            OS << ": unknown current parser token\n";
            return;
        }
        OS << ": current parser token '" << Spelling[0..Length] << "'\n";
    }
}

fn ParseAST(PP: *mut Preprocessor, Consumer: *mut ASTConsumer, Ctx: *mut ASTContext, PrintStats: bool, TUKind: TranslationUnitKind, CompletionConsumer: *mut CodeCompleteConsumer, SkipFunctionBodies: bool) {
    let mut S: unique_ptr<Sema> = Sema { PP, Ctx, *Consumer, TUKind, CompletionConsumer };
    let mut CleanupSema: CrashRecoveryContextCleanupRegistrar<Sema> = S.get();
    ParseAST(operator(S), PrintStats, SkipFunctionBodies);
}

fn ParseAST(S: *mut Sema, PrintStats: bool, SkipFunctionBodies: bool) {
    if PrintStats {
        EnableStatistics();
        EnableStatistics();
    }
    let mut OldCollectStats: bool = PrintStats;
    swap(OldCollectStats, S.CollectStats);
    let mut Consumer: *mut ASTConsumer = &mut S.getASTConsumer();
    let mut ParseOP: unique_ptr<Parser> = Parser { S.getPreprocessor(), S, SkipFunctionBodies };
    let mut P: *mut Parser = operator(ParseOP);
    let mut CleanupPrettyStack: CrashRecoveryContextCleanupRegistrar<const void, ResetStackCleanup> = SavePrettyStackState();
    let mut CrashInfo: PrettyStackTraceParserEntry = P;
    let mut CleanupParser: CrashRecoveryContextCleanupRegistrar<Parser> = ParseOP.get();
    S.getPreprocessor().EnterMainSourceFile();
    let mut External: *mut ExternalASTSource = S.getASTContext().getExternalSource();
    if External {
        External.StartTranslationUnit(Consumer);
    }
    let mut HaveLexer: bool = S.getPreprocessor().getCurrentLexer();
    if HaveLexer {
        let mut TimeScope: TimeTraceScope = TimeTraceScope { "Frontend", function_ref<TimeTraceMetadata ()> { Closure_1 { S: &mut S }, null, null } };
        P.Initialize();
        let mut ADecl: DeclGroupPtrTy = null;
        let mut ImportState: ModuleImportState = zeroed();
        let mut PotentiallyEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { S, PotentiallyEvaluated, null, EK_Other, true };
        for let mut AtEOF: bool = P.ParseFirstTopLevelDecl(ADecl, ImportState); !AtEOF; AtEOF = P.ParseTopLevelDecl(ADecl, ImportState) {
            if ADecl && !Consumer.HandleTopLevelDecl(ADecl.get()) {
                return;
            }
        }
    }
    for D in S.WeakTopLevelDecls() {
        Consumer.HandleTopLevelDecl(D);
    }
    Consumer.HandleTranslationUnit(S.getASTContext());
    swap(OldCollectStats, S.CollectStats);
    if PrintStats {
        errs() << "\nSTATISTICS:\n";
        if HaveLexer {
            P.getActions().PrintStats();
        }
        S.getASTContext().PrintStats();
        PrintStats();
        PrintStats();
        Consumer.PrintStats();
    }
}

struct Closure_1 {
    S: *mut Sema,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> TimeTraceMetadata {
            let mut M: TimeTraceMetadata = TimeTraceMetadata {};
            if isTimeTraceVerbose() {
                let mut SM: *SourceManager = (*self.S).getSourceManager();
                if SM.getFileEntryForID(SM.getMainFileID()) {
                    FE;
                } else {
                    M.File = FE.tryGetRealPathName();
                }
            }
            return M;
        }
