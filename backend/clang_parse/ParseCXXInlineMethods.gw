fn Parser::ParseCXXDeletedFunctionMessage(self) -> *mut StringLiteral {
    if !self.Tok.is(l_paren) {
        return null;
    }
    let mut Message: *mut StringLiteral = null;
    let mut BT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    BT.consumeOpen();
    if self.isTokenStringLiteral() {
        let mut Res: ExprResult = self.ParseUnevaluatedStringLiteralExpression();
        if Res.isUsable() {
            Message = Res.getAs();
            self.DiagCompat(Message.getBeginLoc(), delete_with_message) << Message.getSourceRange();
        }
    } else {
        self.Diag(self.Tok.getLocation(), err_expected_string_literal) << 0 << "'delete'";
        self.SkipUntil(r_paren, StopAtSemi | StopBeforeMatch);
    }
    BT.consumeClose();
    return Message;
}

fn Parser::SkipDeletedFunctionBody(self) {
    if !self.Tok.is(l_paren) {
        return;
    }
    let mut BT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    BT.consumeOpen();
    self.SkipUntil(r_paren, comma, StopAtSemi | StopBeforeMatch);
    if self.Tok.is(r_paren) {
        BT.consumeClose();
    }
}

fn Parser::ParseCXXInlineMethodDef(self, AS: AccessSpecifier, AccessAttrs: *ParsedAttributesView, D: *mut ParsingDeclarator, TemplateInfo: *ParsedTemplateInfo, VS: *VirtSpecifiers, PureSpecLoc: SourceLocation) -> *mut NamedDecl {
    assert!(D.isFunctionDeclarator(), "This isn't a function declarator!");
    assert!(self.Tok.isOneOf(l_brace, colon, kw_try, equal), "Current token not a '{', ':', '=', or 'try'!");
    let mut TemplateParams: MultiTemplateParamsArg = MultiTemplateParamsArg { if TemplateInfo.TemplateParams { TemplateInfo.TemplateParams.ptr } else { null }, if TemplateInfo.TemplateParams { TemplateInfo.TemplateParams.len } else { 0 } };
    let mut FnD: *mut NamedDecl = null;
    if D.getDeclSpec().isFriendSpecified() {
        FnD = self.Actions.ActOnFriendFunctionDecl(self.getCurScope(), D, TemplateParams);
    } else {
        FnD = self.Actions.ActOnCXXMemberDeclarator(self.getCurScope(), AS, D, TemplateParams, null, VS, ICIS_NoInit);
        if FnD {
            self.Actions.ProcessDeclAttributeList(self.getCurScope(), FnD, AccessAttrs, ProcessDeclAttributeOptions {});
            if PureSpecLoc.isValid() {
                self.Actions.ActOnPureSpecifier(FnD, PureSpecLoc);
            }
        }
    }
    if FnD {
        self.HandleMemberFunctionDeclDelays(D, FnD);
    }
    D.complete(FnD);
    if self.TryConsumeToken(equal) {
        if !FnD {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        let mut Delete: bool = false;
        let mut KWLoc: SourceLocation = SourceLocation {};
        if self.TryConsumeToken(kw_delete, KWLoc) {
            self.DiagCompat(KWLoc, defaulted_deleted_function) << 1;
            let mut Message: *mut StringLiteral = self.ParseCXXDeletedFunctionMessage();
            self.Actions.SetDeclDeleted(FnD, KWLoc, Message);
            Delete = true;
            if dyn_cast(FnD) {
                DeclAsFunction;
            } else {
                DeclAsFunction.setRangeEnd(self.PrevTokLocation);
            }
        } else if self.TryConsumeToken(kw_default, KWLoc) {
            self.DiagCompat(KWLoc, defaulted_deleted_function) << 0;
            self.Actions.SetDeclDefaulted(FnD, KWLoc);
            if dyn_cast(FnD) {
                DeclAsFunction;
            } else {
                DeclAsFunction.setRangeEnd(self.PrevTokLocation);
            }
        } else {
            llvm_unreachable_internal("function definition after = not 'delete' or 'default'", "P:/Goraw/llvm-project/clang/lib/Parse/ParseCXXInlineMethods.cpp", 119);
        }
        if self.Tok.is(comma) {
            self.Diag(KWLoc, err_default_delete_in_multiple_declaration) << Delete;
            self.SkipUntil(semi, 0 as SkipUntilFlags);
        } else if self.ExpectAndConsume(semi, err_expected_after, if Delete { "delete" } else { "default" }) && !self.isLikelyAtStartOfNewDeclaration() {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
        }
        return FnD;
    }
    if self.SkipFunctionBodies && (!FnD || self.Actions.canSkipFunctionBody(FnD)) && self.trySkippingFunctionBody() {
        self.Actions.ActOnSkippedFunctionBody(FnD);
        return FnD;
    }
    if self.getLangOpts().DelayedTemplateParsing && D.getFunctionDefinitionKind() == Definition && !D.getDeclSpec().hasConstexprSpecifier() && !(FnD && FnD.getAsFunction() && operator(FnD.getAsFunction().getReturnType()).getContainedAutoType()) && ((self.Actions.CurContext.isDependentContext() || (TemplateInfo.Kind != NonTemplate && TemplateInfo.Kind != ExplicitSpecialization)) && !self.Actions.IsInsideALocalClassWithinATemplateFunction()) {
        let mut Toks: CachedTokens = CachedTokens {};
        self.LexTemplateFunctionForLateParsing(Toks);
        if FnD {
            let mut FD: *mut FunctionDecl = FnD.getAsFunction();
            self.Actions.CheckForFunctionRedefinition(FD, null, null);
            self.Actions.MarkAsLateParsedTemplate(FD, FnD, Toks);
        }
        return FnD;
    }
    let mut LM: *mut LexedMethod = LexedMethod { self, FnD };
    self.getCurrentClass().LateParsedDeclarations.push(LM);
    let mut Toks: *mut CachedTokens = LM.Toks;
    let mut kind: TokenKind = self.Tok.getKind();
    if self.ConsumeAndStoreFunctionPrologue(Toks) {
        if self.PP.isCodeCompletionEnabled() && any_of(Toks, Closure_1 {}) {
            return FnD;
        }
        self.SkipMalformedDecl();
        self.getCurrentClass().LateParsedDeclarations.back();
        self.getCurrentClass().LateParsedDeclarations.pop();
        return FnD;
    } else {
        self.ConsumeAndStoreUntil(r_brace, Toks, false, true);
    }
    if kind == kw_try {
        while self.Tok.is(kw_catch) {
            self.ConsumeAndStoreUntil(l_brace, Toks, false, true);
            self.ConsumeAndStoreUntil(r_brace, Toks, false, true);
        }
    }
    if FnD {
        let mut FD: *mut FunctionDecl = FnD.getAsFunction();
        self.Actions.CheckForFunctionRedefinition(FD, null, null);
        FD.setWillHaveBody(true);
    } else {
        self.getCurrentClass().LateParsedDeclarations.back();
        self.getCurrentClass().LateParsedDeclarations.pop();
    }
    return FnD;
}

fn Parser::ParseCXXNonStaticMemberInitializer(self, VarD: *mut Decl) {
    assert!(self.Tok.isOneOf(l_brace, equal), "Current token not a '{' or '='!");
    let mut MI: *mut LateParsedMemberInitializer = LateParsedMemberInitializer { self, VarD };
    self.getCurrentClass().LateParsedDeclarations.push(MI);
    let mut Toks: *mut CachedTokens = MI.Toks;
    let mut kind: TokenKind = self.Tok.getKind();
    if kind == equal {
        Toks.push(self.Tok);
        self.ConsumeToken();
    }
    if kind == l_brace {
        Toks.push(self.Tok);
        self.ConsumeBrace();
        self.ConsumeAndStoreUntil(r_brace, Toks, true, true);
    } else {
        self.ConsumeAndStoreInitializer(Toks, DefaultInitializer);
    }
    let mut Eof: Token = Token {};
    Eof.startToken();
    Eof.setKind(eof);
    Eof.setLocation(self.Tok.getLocation());
    Eof.setEofData(VarD);
    Toks.push(Eof);
}

fn LateParsedDeclaration::~LateParsedDeclaration(self) {}

fn LateParsedDeclaration::ParseLexedMethodDeclarations(self) {}

fn LateParsedDeclaration::ParseLexedMemberInitializers(self) {}

fn LateParsedDeclaration::ParseLexedMethodDefs(self) {}

fn LateParsedDeclaration::ParseLexedAttributes(self) {}

fn LateParsedDeclaration::ParseLexedPragmas(self) {}

fn Parser@clang::~LateParsedClass(self) {
    self.Self.DeallocateParsedClasses(self.Class);
}

fn LateParsedClass@Parser@clang::ParseLexedMethodDeclarations(self) {
    self.Self.ParseLexedMethodDeclarations(*self.Class);
}

fn LateParsedClass@Parser@clang::ParseLexedMemberInitializers(self) {
    self.Self.ParseLexedMemberInitializers(*self.Class);
}

fn LateParsedClass@Parser@clang::ParseLexedMethodDefs(self) {
    self.Self.ParseLexedMethodDefs(*self.Class);
}

fn LateParsedClass@Parser@clang::ParseLexedAttributes(self) {
    self.Self.ParseLexedAttributes(*self.Class);
}

fn LateParsedClass@Parser@clang::ParseLexedPragmas(self) {
    self.Self.ParseLexedPragmas(*self.Class);
}

fn LateParsedMethodDeclaration@Parser@clang::ParseLexedMethodDeclarations(self) {
    self.Self.ParseLexedMethodDeclaration(*self);
}

fn LexedMethod@Parser@clang::ParseLexedMethodDefs(self) {
    self.Self.ParseLexedMethodDef(*self);
}

fn LateParsedMemberInitializer@Parser@clang::ParseLexedMemberInitializers(self) {
    self.Self.ParseLexedMemberInitializer(*self);
}

fn LateParsedAttribute::ParseLexedAttributes(self) {
    self.Self.ParseLexedAttribute(*self, true, false, null);
}

fn LateParsedTypeAttribute::ParseLexedAttributes(self) {}

fn LateParsedPragma@Parser@clang::ParseLexedPragmas(self) {
    self.Self.ParseLexedPragma(*self);
}

struct ReenterTemplateScopeRAII {
    P: *mut Parser,
    Scopes: MultiParseScope,
    CurTemplateDepthTracker: TemplateParameterDepthRAII,
}

fn ReenterTemplateScopeRAII::ReenterTemplateScopeRAII(self, P: *mut Parser, MaybeTemplated: *mut Decl, Enter: bool) {
    if Enter {
        self.CurTemplateDepthTracker.addDepth(P.ReenterTemplateScopes(self.Scopes, MaybeTemplated));
    }
}

struct ReenterClassScopeRAII {
    P: *mut Parser,
    Scopes: MultiParseScope,
    CurTemplateDepthTracker: TemplateParameterDepthRAII,
    Class: *mut ParsingClass,
}

fn ReenterClassScopeRAII::ReenterClassScopeRAII(self, P: *mut Parser, Class: *mut ParsingClass) {
    if Class.TopLevelClass {
        return;
    }
    self.Scopes.Enter(ClassScope | DeclScope);
    P.Actions.ActOnStartDelayedMemberDeclarations(P.getCurScope(), Class.TagOrTemplate);
}

fn ReenterClassScopeRAII::~ReenterClassScopeRAII(self) {
    if self.Class.TopLevelClass {
        return;
    }
    self.P.Actions.ActOnFinishDelayedMemberDeclarations(self.P.getCurScope(), self.Class.TagOrTemplate);
}

fn Parser::ParseLexedMethodDeclarations(self, Class: *mut ParsingClass) {
    let mut InClassScope: ReenterClassScopeRAII = ReenterClassScopeRAII { *self, Class };
    for LateD in Class.LateParsedDeclarations {
        LateD.ParseLexedMethodDeclarations();
    }
}

fn Parser::ParseLexedMethodDeclaration(self, LM: *mut LateParsedMethodDeclaration) {
    let mut InFunctionTemplateScope: ReenterTemplateScopeRAII = ReenterTemplateScopeRAII { P: *self, Scopes: LM.Method, CurTemplateDepthTracker: true };
    self.Actions.ActOnStartDelayedCXXMethodDeclaration(self.getCurScope(), LM.Method);
    InFunctionTemplateScope.Scopes.Enter(FunctionPrototypeScope | FunctionDeclarationScope | DeclScope);
    let mut PopFnContext: FunctionScopeRAII = self.Actions;
    self.Actions.PushFunctionScope();
    for let mut I: u32 = 0;
let mut N: u32 = LM.DefaultArgs.len; I != N; I += 1 {
        let mut Param: CastReturnType = cast(LM.DefaultArgs[I].Param);
        let mut HasUnparsed: bool = Param.hasUnparsedDefaultArg();
        self.Actions.ActOnDelayedCXXMethodParameter(self.getCurScope(), Param);
        let mut Toks: unique_ptr<CachedTokens> = move(LM.DefaultArgs[I].Toks);
        if Toks {
            let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
            let mut LastDefaultArgToken: Token = operator(Toks).back();
            let mut DefArgEnd: Token = Token {};
            DefArgEnd.startToken();
            DefArgEnd.setKind(eof);
            DefArgEnd.setLocation(LastDefaultArgToken.getEndLoc());
            DefArgEnd.setEofData(Param);
            operator(Toks).push(DefArgEnd);
            operator(Toks).push(self.Tok);
            self.PP.EnterTokenStream(operator(Toks), true, true);
            self.ConsumeAnyToken(true);
            assert!(self.Tok.is(equal), "Default argument not starting with '='");
            let mut EqualLoc: SourceLocation = self.ConsumeToken();
            let mut Eval: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, PotentiallyEvaluatedIfUsed, Param, EK_Other, true };
            let mut DefArgResult: ExprResult = false;
            if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
                self.Diag(self.Tok, compat_cxx11_generalized_initializer_lists);
                DefArgResult = self.ParseBraceInitializer();
            } else {
                DefArgResult = self.ParseAssignmentExpression(AllowNonTypes);
            }
            if DefArgResult.isInvalid() {
                self.Actions.ActOnParamDefaultArgumentError(Param, EqualLoc, null);
            } else {
                if self.Tok.isNot(eof) || self.Tok.getEofData() != Param {
                    assert!(operator(Toks).len >= 3, "expected a token in default arg");
                    self.Diag(self.Tok.getLocation(), err_default_arg_unparsed) << SourceRange { B: self.Tok.getLocation(), E: (operator(Toks))[operator(Toks).len - 3].getLocation() };
                }
                self.Actions.ActOnParamDefaultArgument(Param, EqualLoc, DefArgResult.get());
            }
            while self.Tok.isNot(eof) {
                self.ConsumeAnyToken(false);
            }
            if self.Tok.is(eof) && self.Tok.getEofData() == Param {
                self.ConsumeAnyToken(false);
            }
        } else if HasUnparsed {
            assert!(Param.hasInheritedDefaultArg();
            let mut Old: *mut FunctionDecl = null;
            if dyn_cast(LM.Method) {
                FunTmpl;
            } else {
                Old = cast(FunTmpl.getTemplatedDecl()).getPreviousDecl();
            }
            if Old {
                let mut OldParam: *mut ParmVarDecl = Old.getParamDecl(I);
                assert!(!OldParam.hasUnparsedDefaultArg();
                if OldParam.hasUninstantiatedDefaultArg() {
                    Param.setUninstantiatedDefaultArg(OldParam.getUninstantiatedDefaultArg());
                } else {
                    Param.setDefaultArg(OldParam.getInit());
                }
            }
        }
    }
    if LM.ExceptionSpecTokens {
        Toks;
    } else {
        let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
        let mut LastExceptionSpecToken: Token = Toks.back();
        let mut ExceptionSpecEnd: Token = Token {};
        ExceptionSpecEnd.startToken();
        ExceptionSpecEnd.setKind(eof);
        ExceptionSpecEnd.setLocation(LastExceptionSpecToken.getEndLoc());
        ExceptionSpecEnd.setEofData(LM.Method);
        Toks.push(ExceptionSpecEnd);
        Toks.push(self.Tok);
        self.PP.EnterTokenStream(*Toks, true, true);
        self.ConsumeAnyToken(true);
        let mut Method: *mut CXXMethodDecl = null;
        let mut FunctionToPush: *mut FunctionDecl = null;
        if dyn_cast(LM.Method) {
            FunTmpl;
        } else {
            FunctionToPush = FunTmpl.getTemplatedDecl();
        }
        Method = dyn_cast(FunctionToPush);
        let mut FnScope: ParseScope = ParseScope { self, FnScope, true, false };
        let mut FnContext: ContextRAII = ContextRAII { self.Actions, FunctionToPush, false };
        let mut ThisScope: CXXThisScopeRAII = CXXThisScopeRAII { self.Actions, if Method { Method.getParent() } else { null }, if Method { Method.getMethodQualifiers() } else { Qualifiers {} }, Method && self.getLangOpts().CPlusPlus11 };
        let mut SpecificationRange: SourceRange = SourceRange {};
        let mut DynamicExceptions: SmallVector<ParsedType, 4> = SmallVector<ParsedType, 4> {};
        let mut DynamicExceptionRanges: SmallVector<SourceRange, 4> = SmallVector<SourceRange, 4> {};
        let mut NoexceptExpr: ExprResult = false;
        let mut ExceptionSpecTokens: *mut CachedTokens = null;
        let mut EST: ExceptionSpecificationType = self.tryParseExceptionSpecification(false, SpecificationRange, DynamicExceptions, DynamicExceptionRanges, NoexceptExpr, ExceptionSpecTokens);
        if self.Tok.isNot(eof) || self.Tok.getEofData() != LM.Method {
            self.Diag(self.Tok.getLocation(), err_except_spec_unparsed);
        }
        self.Actions.actOnDelayedExceptionSpecification(LM.Method, EST, SpecificationRange, DynamicExceptions, DynamicExceptionRanges, if NoexceptExpr.isUsable() { NoexceptExpr.get() } else { null });
        while self.Tok.isNot(eof) {
            self.ConsumeAnyToken(false);
        }
        if self.Tok.is(eof) && self.Tok.getEofData() == LM.Method {
            self.ConsumeAnyToken(false);
        }
        Toks;
        LM.ExceptionSpecTokens = null;
    }
    InFunctionTemplateScope.Scopes.Exit();
    self.Actions.ActOnFinishDelayedCXXMethodDeclaration(self.getCurScope(), LM.Method);
}

fn Parser::ParseLexedMethodDefs(self, Class: *mut ParsingClass) {
    let mut InClassScope: ReenterClassScopeRAII = ReenterClassScopeRAII { *self, Class };
    for D in Class.LateParsedDeclarations {
        D.ParseLexedMethodDefs();
    }
}

fn Parser::ParseLexedMethodDef(self, LM: *mut LexedMethod) {
    let mut InFunctionTemplateScope: ReenterTemplateScopeRAII = ReenterTemplateScopeRAII { P: *self, Scopes: LM.D, CurTemplateDepthTracker: true };
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    assert!(!LM.Toks.is_empty(), "Empty body!");
    let mut LastBodyToken: Token = LM.Toks.back();
    let mut BodyEnd: Token = Token {};
    BodyEnd.startToken();
    BodyEnd.setKind(eof);
    BodyEnd.setLocation(LastBodyToken.getEndLoc());
    BodyEnd.setEofData(LM.D);
    LM.Toks.push(BodyEnd);
    LM.Toks.push(self.Tok);
    self.PP.EnterTokenStream(LM.Toks, true, true);
    self.ConsumeAnyToken(true);
    assert!(self.Tok.isOneOf(l_brace, colon, kw_try), "Inline method not starting with '{', ':' or 'try'");
    let mut FnScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope, true, false };
    let mut SaveFPFeatures: FPFeaturesStateRAII = self.Actions;
    self.Actions.ActOnStartOfFunctionDef(self.getCurScope(), LM.D, null, Other);
    let mut _: Closure_2 = Closure_2 { cap_0: self, LM: &mut LM };
    assert!((self.Actions.getDiagnostics().hasErrorOccurred() || !isa(LM.D) || cast(LM.D).getTemplateParameters().getDepth() < self.TemplateParameterDepth), "TemplateParameterDepth should be greater than the depth of current template being instantiated!");
    self.ParseFunctionBody(LM.D, FnScope);
}

fn Parser::ParseLexedMemberInitializers(self, Class: *mut ParsingClass) {
    let mut InClassScope: ReenterClassScopeRAII = ReenterClassScopeRAII { *self, Class };
    if !Class.LateParsedDeclarations.is_empty() {
        let mut ThisScope: CXXThisScopeRAII = CXXThisScopeRAII { self.Actions, Class.TagOrTemplate, Qualifiers {}, true };
        for D in Class.LateParsedDeclarations {
            D.ParseLexedMemberInitializers();
        }
    }
    self.Actions.ActOnFinishDelayedMemberInitializers(Class.TagOrTemplate);
}

fn Parser::ParseLexedMemberInitializer(self, MI: *mut LateParsedMemberInitializer) {
    if !MI.Field || MI.Field.isInvalidDecl() {
        return;
    }
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    MI.Toks.push(self.Tok);
    self.PP.EnterTokenStream(MI.Toks, true, true);
    self.ConsumeAnyToken(true);
    let mut EqualLoc: SourceLocation = SourceLocation {};
    self.Actions.ActOnStartCXXInClassMemberInitializer();
    let mut Eval: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, PotentiallyEvaluatedIfUsed, null, EK_Other, true };
    let mut Init: ExprResult = self.ParseCXXMemberInitializer(MI.Field, false, EqualLoc);
    self.Actions.ActOnFinishCXXInClassMemberInitializer(MI.Field, EqualLoc, Init);
    if self.Tok.isNot(eof) {
        if !Init.isInvalid() {
            let mut EndLoc: SourceLocation = self.PP.getLocForEndOfToken(self.PrevTokLocation, 0);
            if !EndLoc.isValid() {
                EndLoc = self.Tok.getLocation();
            }
            self.Diag(EndLoc, err_expected_semi_decl_list);
        }
        while self.Tok.isNot(eof) {
            self.ConsumeAnyToken(false);
        }
    }
    if self.Tok.getEofData() == MI.Field {
        self.ConsumeAnyToken(false);
    }
}

fn Parser::ParseLexedAttributes(self, Class: *mut ParsingClass) {
    let mut InClassScope: ReenterClassScopeRAII = ReenterClassScopeRAII { *self, Class };
    for LateD in Class.LateParsedDeclarations {
        LateD.ParseLexedAttributes();
    }
}

fn Parser::ParseLexedAttributeList(self, LAs: *mut LateParsedAttrList, D: *mut Decl, EnterScope: bool, OnDefinition: bool, OutAttrs: *mut ParsedAttributes) {
    assert!(LAs.parseSoon(), "Attribute list should be marked for immediate parsing.");
    for let mut i: u32 = 0;
let mut ni: u32 = LAs.len; i < ni; i += 1 {
        if D {
            LAs[i].addDecl(D);
        }
        self.ParseLexedAttribute(*LAs[i], EnterScope, OnDefinition, OutAttrs);
        LAs[i];
    }
    LAs.clear();
}

fn Parser::ParseLexedAttribute(self, LPA: *mut LateParsedAttribute, EnterScope: bool, OnDefinition: bool, OutAttrs: *mut ParsedAttributes) {
    let mut Attrs: ParsedAttributes = self.AttrFactory;
    if LPA.Decls.len > 0 {
        let mut D: *mut Decl = LPA.Decls[0];
        let mut HasFuncScope: bool = EnterScope && LPA.Decls.len == 1 && D.isFunctionOrFunctionTemplate();
        let mut IsCPlusPlus: bool = self.getLangOpts().CPlusPlus;
        let mut ND: *mut NamedDecl = dyn_cast(D);
        let mut RD: *mut RecordDecl = dyn_cast_or_null(D.getDeclContext());
        let mut ThisScope: CXXThisScopeRAII = CXXThisScopeRAII { self.Actions, RD, Qualifiers {}, IsCPlusPlus && ND && ND.isCXXInstanceMember() };
        let mut InDeclScope: ReenterTemplateScopeRAII = ReenterTemplateScopeRAII { P: *self, Scopes: D, CurTemplateDepthTracker: IsCPlusPlus && EnterScope };
        if HasFuncScope {
            InDeclScope.Scopes.Enter(FnScope | DeclScope | CompoundStmtScope);
            self.Actions.ActOnReenterFunctionContext(self.Actions.CurScope, D);
        }
        let mut Parsed: ParsedAttributes = self.ParseLexedAttributeTokens(LPA);
        Attrs.takeAllAppendingFrom(Parsed);
        if HasFuncScope {
            self.Actions.ActOnExitFunctionContext();
        }
    } else {
        self.Diag(LPA.AttrNameLoc, warn_attribute_no_decl) << LPA.AttrName.getName();
    }
    if OnDefinition && !Attrs.is_empty() && !operator(operator(Attrs.begin())).isCXX11Attribute() && operator(operator(Attrs.begin())).isKnownToGCC() {
        self.Diag(self.Tok, warn_attribute_on_function_definition) << &mut LPA.AttrName;
    }
    for D in LPA.Decls {
        self.Actions.ActOnFinishDelayedAttribute(self.getCurScope(), D, Attrs);
    }
    if OutAttrs {
        OutAttrs.takeAllAppendingFrom(Attrs);
    }
}

fn Parser::ParseLexedPragmas(self, Class: *mut ParsingClass) {
    let mut InClassScope: ReenterClassScopeRAII = ReenterClassScopeRAII { *self, Class };
    for D in Class.LateParsedDeclarations {
        D.ParseLexedPragmas();
    }
}

fn Parser::ParseLexedPragma(self, LP: *mut LateParsedPragma) {
    self.PP.EnterToken(self.Tok, true);
    self.PP.EnterTokenStream(LP.toks(), true, true);
    self.ConsumeAnyToken(true);
    assert!(self.Tok.isAnnotation(), "Expected annotation token.");
    match self.Tok.getKind() {
        annot_attr_openmp => {
            annot_pragma_openmp;
        },
        _ => {
            llvm_unreachable_internal("Unexpected token.", "P:/Goraw/llvm-project/clang/lib/Parse/ParseCXXInlineMethods.cpp", 792);
        },
    }
}

fn Parser::ConsumeAndStoreUntil(self, T1: TokenKind, T2: TokenKind, Toks: *mut CachedTokens, StopAtSemi: bool, ConsumeFinalToken: bool) -> bool {
    let mut isFirstTokenConsumed: bool = true;
    while true {
        if self.Tok.is(T1) || self.Tok.is(T2) {
            if ConsumeFinalToken {
                Toks.push(self.Tok);
                self.ConsumeAnyToken(false);
            }
            return true;
        }
        match self.Tok.getKind() {
            eof => {
                annot_module_begin;
            },
            annot_pragma_openacc => {
                annot_pragma_openmp;
            },
            l_paren => {
                Toks.push(self.Tok);
            },
            l_square => {
                Toks.push(self.Tok);
            },
            l_brace => {
                Toks.push(self.Tok);
            },
            r_paren => {
                if self.ParenCount && !isFirstTokenConsumed {
                    return false;
                }
            },
            r_square => {
                if self.BracketCount && !isFirstTokenConsumed {
                    return false;
                }
            },
            r_brace => {
                if self.BraceCount && !isFirstTokenConsumed {
                    return false;
                }
            },
            semi => {
                if StopAtSemi {
                    return false;
                }
            },
            _ => {
                Toks.push(self.Tok);
            },
        }
        isFirstTokenConsumed = false;
    }
}

fn Parser::ConsumeAndStoreFunctionPrologue(self, Toks: *mut CachedTokens) -> bool {
    if self.Tok.is(kw_try) {
        Toks.push(self.Tok);
        self.ConsumeToken();
    }
    if self.Tok.isNot(colon) {
        self.ConsumeAndStoreUntil(l_brace, r_brace, Toks, true, false);
        if self.Tok.isNot(l_brace) {
            return self.Diag(self.Tok.getLocation(), err_expected) << l_brace;
        }
        Toks.push(self.Tok);
        self.ConsumeBrace();
        return false;
    }
    Toks.push(self.Tok);
    self.ConsumeToken();
    let mut MightBeTemplateArgument: bool = false;
    while true {
        if self.Tok.is(kw_decltype) {
            Toks.push(self.Tok);
            let mut OpenLoc: SourceLocation = self.ConsumeToken();
            if self.Tok.isNot(l_paren) {
                return self.Diag(self.Tok.getLocation(), err_expected_lparen_after) << "decltype";
            }
            Toks.push(self.Tok);
            self.ConsumeParen();
            if !self.ConsumeAndStoreUntil(r_paren, Toks, true, true) {
                self.Diag(self.Tok.getLocation(), err_expected) << r_paren;
                self.Diag(OpenLoc, note_matching) << l_paren;
                return true;
            }
        }
        while true {
            {
            if self.Tok.is(coloncolon) {
                Toks.push(self.Tok);
                self.ConsumeToken();
                if self.Tok.is(kw_template) {
                    Toks.push(self.Tok);
                    self.ConsumeToken();
                }
            }
            if self.Tok.is(identifier) {
                Toks.push(self.Tok);
                self.ConsumeToken();
            } else {
                break;
            }
            if self.Tok.is(ellipsis) && self.NextToken().is(l_square) {
                Toks.push(self.Tok);
                let mut OpenLoc: SourceLocation = self.ConsumeToken();
                Toks.push(self.Tok);
                self.ConsumeBracket();
                if !self.ConsumeAndStoreUntil(r_square, Toks, true, true) {
                    self.Diag(self.Tok.getLocation(), err_expected) << r_square;
                    self.Diag(OpenLoc, note_matching) << l_square;
                    return true;
                }
            }
        }
            if !(self.Tok.is(coloncolon)) { break; }
        }
        if self.Tok.is(code_completion) {
            Toks.push(self.Tok);
            self.ConsumeCodeCompletionToken();
            if self.Tok.isOneOf(identifier, coloncolon, kw_decltype) {
                continue;
            }
        }
        if self.Tok.is(comma) {
            Toks.push(self.Tok);
            self.ConsumeToken();
            continue;
        }
        if self.Tok.is(less) {
            MightBeTemplateArgument = true;
        }
        if MightBeTemplateArgument {
            if !self.ConsumeAndStoreUntil(l_paren, l_brace, Toks, true, false) {
                return self.Diag(self.Tok.getLocation(), err_expected) << l_brace;
            }
        } else if self.Tok.isNot(l_paren) && self.Tok.isNot(l_brace) {
            if self.getLangOpts().CPlusPlus11 {
                return self.Diag(self.Tok.getLocation(), err_expected_either) << l_paren << l_brace;
            } else {
                return self.Diag(self.Tok.getLocation(), err_expected) << l_paren;
            }
        }
        let mut kind: TokenKind = self.Tok.getKind();
        Toks.push(self.Tok);
        let mut IsLParen: bool = (kind == l_paren);
        let mut OpenLoc: SourceLocation = self.Tok.getLocation();
        if IsLParen {
            self.ConsumeParen();
        } else {
            assert!(kind == l_brace, "Must be left paren or brace here.");
            self.ConsumeBrace();
            if !self.getLangOpts().CPlusPlus11 {
                return false;
            }
            let mut PreviousToken: *Token = Toks[Toks.len - 2];
            if !MightBeTemplateArgument && !PreviousToken.isOneOf(identifier, greater, greatergreater) {
                let mut PA: TentativeParsingAction = TentativeParsingAction { *self, false };
                if self.SkipUntil(r_brace, 0 as SkipUntilFlags) && !self.Tok.isOneOf(comma, ellipsis, l_brace) {
                    PA.Revert();
                    return false;
                }
                PA.Revert();
            }
        }
        let mut CloseKind: TokenKind = if IsLParen { r_paren } else { r_brace };
        if !self.ConsumeAndStoreUntil(CloseKind, Toks, true, true) {
            self.Diag(self.Tok, err_expected) << CloseKind;
            self.Diag(OpenLoc, note_matching) << kind;
            return true;
        }
        if self.Tok.is(ellipsis) {
            Toks.push(self.Tok);
            self.ConsumeToken();
        }
        if self.Tok.is(comma) {
            Toks.push(self.Tok);
            self.ConsumeToken();
        } else if self.Tok.is(l_brace) {
            Toks.push(self.Tok);
            self.ConsumeBrace();
            return false;
        } else if !MightBeTemplateArgument {
            return self.Diag(self.Tok.getLocation(), err_expected_either) << l_brace << comma;
        }
    }
}

fn Parser::ConsumeAndStoreConditional(self, Toks: *mut CachedTokens) -> bool {
    assert!(self.Tok.is(question);
    Toks.push(self.Tok);
    self.ConsumeToken();
    while self.Tok.isNot(colon) {
        if !self.ConsumeAndStoreUntil(question, colon, Toks, true, false) {
            return false;
        }
        if self.Tok.is(question) && !self.ConsumeAndStoreConditional(Toks) {
            return false;
        }
    }
    Toks.push(self.Tok);
    self.ConsumeToken();
    return true;
}

fn Parser::ConsumeAndStoreInitializer(self, Toks: *mut CachedTokens, CIK: CachedInitKind) -> bool {
    let mut IsFirstToken: bool = true;
    let mut AngleCount: u32 = 0;
    let mut KnownTemplateCount: u32 = 0;
    while true {
        match self.Tok.getKind() {
            ellipsis => {
                if self.ParenCount == 1 && self.NextToken().is(r_paren) {
                    return true;
                }
            },
            comma => {
                if !AngleCount {
                    return true;
                }
            },
            eof => {
                return false;
            },
            less => {
                AngleCount += 1;
            },
            question => {
                if !self.ConsumeAndStoreConditional(Toks) {
                    return false;
                }
            },
            greatergreatergreater => {
                if !self.getLangOpts().CPlusPlus11 {
                    
                }
            },
            greatergreater => {
                if !self.getLangOpts().CPlusPlus11 {
                    
                }
            },
            greater => {
                if AngleCount {
                    AngleCount -= 1;
                }
            },
            kw_template => {
                Toks.push(self.Tok);
            },
            kw_operator => {
                Toks.push(self.Tok);
            },
            l_paren => {
                Toks.push(self.Tok);
            },
            l_square => {
                Toks.push(self.Tok);
            },
            l_brace => {
                Toks.push(self.Tok);
            },
            r_paren => {
                if CIK == DefaultArgument {
                    return true;
                }
            },
            r_square => {
                if self.BracketCount && !IsFirstToken {
                    return false;
                }
            },
            r_brace => {
                if self.BraceCount && !IsFirstToken {
                    return false;
                }
            },
            code_completion => {
                Toks.push(self.Tok);
            },
            string_literal => {
                wide_string_literal;
            },
            semi => {
                if CIK == DefaultInitializer {
                    return true;
                }
            },
            _ => {
                self.Tok.isAnnotation();
            },
        }
        IsFirstToken = false;
    }
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Tok: *Token) -> bool {
            return Tok.is(code_completion);
        }

struct Closure_2 {
    cap_0: *mut Parser,
    LM: *mut LexedMethod,
}

unsafe fn Closure_2::call(self: *mut Closure_2) {
        while self.Tok.isNot(eof) {
            self.ConsumeAnyToken(false);
        }
        if self.Tok.is(eof) && self.Tok.getEofData() == (*self.LM).D {
            self.ConsumeAnyToken(false);
        }
        if dyn_cast_or_null((*self.LM).D) {
            FD;
        } else if isa(FD) || FD.isInIdentifierNamespace(IDNS_OrdinaryFriend) {
            self.Actions.ActOnFinishInlineFunctionDef(FD);
        }
    }
