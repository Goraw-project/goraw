        (((operator!(operator!((operator!(self.getLangOpts()) && "There's a C++-specific check for tok::identifier above")))) || (_wassert(L"!getLangOpts().CPlusPlus && \"There's a C++-specific check for tok::identifier above\"", L"clang\\lib\\Parse\\ParseDecl.cpp", (6857) as u32) , 0)) as void);
        assert!(self.Tok.getIdentifierInfo(), "Not an identifier?");
        D.SetIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
        D.SetRangeEnd(self.Tok.getLocation());
        self.ConsumeToken();
