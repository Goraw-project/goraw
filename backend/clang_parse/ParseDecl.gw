    return normalizeAttrName(II.getName()).Case("RootSignature", true).Case("__clang_arm_builtin_alias", true).Case("argument_with_type_tag", true).Case("atomic", true).Case("availability", true).Case("blocks", true).Case("builtin_alias", true).Case("callable_when", true).Case("clang_builtin_alias", true).Case("consumable", true).Case("declare simd", true).Case("declare target", true).Case("dimension", true).Case("enum_extensibility", true).Case("format", true).Case("format_matches", true).Case("function_return", true).Case("guard", true).Case("interrupt", if (Syntax == AS_GNU && !ScopeName && true && (T.getArch() == arm || T.getArch() == thumb || T.getArch() == armeb || T.getArch() == thumbeb)) { 1 } else { if (Syntax == AS_CXX11 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == arm || T.getArch() == thumb || T.getArch() == armeb || T.getArch() == thumbeb)) { 1 } else { if (Syntax == AS_C23 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == arm || T.getArch() == thumb || T.getArch() == armeb || T.getArch() == thumbeb)) { 1 } else { if (Syntax == AS_GNU && !ScopeName && true && (T.getArch() == mips || T.getArch() == mipsel)) { 1 } else { if (Syntax == AS_CXX11 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == mips || T.getArch() == mipsel)) { 1 } else { if (Syntax == AS_C23 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == mips || T.getArch() == mipsel)) { 1 } else { if (Syntax == AS_GNU && !ScopeName && true && (T.getArch() == riscv32 || T.getArch() == riscv64 || T.getArch() == riscv32be || T.getArch() == riscv64be)) { 1 } else { if (Syntax == AS_CXX11 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == riscv32 || T.getArch() == riscv64 || T.getArch() == riscv32be || T.getArch() == riscv64be)) { 1 } else { if (Syntax == AS_C23 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == riscv32 || T.getArch() == riscv64 || T.getArch() == riscv32be || T.getArch() == riscv64be)) { 1 } else { 0 } } } } } } } } }).Case("interrupt_save_fp", true).Case("loop", (Syntax == AS_Pragma && ScopeName && ScopeName.getName() == "clang")).Case("mode", true).Case("model", true).Case("modular_format", true).Case("nounroll", true).Case("nounroll_and_jam", true).Case("ns_error_domain", true).Case("objc_bridge", true).Case("objc_bridge_mutable", true).Case("objc_bridge_related", true).Case("objc_gc", true).Case("objc_method_family", true).Case("objc_ownership", true).Case("overflow_behavior", true).Case("ownership_holds", true).Case("ownership_returns", true).Case("ownership_takes", true).Case("param_typestate", true).Case("pcs", true).Case("pointer_with_type_tag", true).Case("ptrauth_vtable_pointer", true).Case("resource_class", true).Case("return_typestate", true).Case("set_typestate", true).Case("shader", true).Case("swift_async", true).Case("swift_async_error", true).Case("swift_error", true).Case("swift_newtype", true).Case("swift_wrapper", true).Case("test_typestate", true).Case("type_tag_for_datatype", true).Case("type_visibility", true).Case("unroll", (Syntax == AS_Pragma && !ScopeName)).Case("unroll_and_jam", true).Case("visibility", true).Case("zero_call_used_regs", true).Default(false);
}

