    DS.setTypeArgumentRange(T.getRange());
    DS.SetRangeEnd(T.getCloseLocation());
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    if DS(TST_atomic, StartLoc, PrevSpec, DiagID, self.Actions.getASTContext().getPrintingPolicy()) {
        self.Diag(StartLoc, DiagID);
    }
}

fn Parser::TryAltiVecVectorTokenOutOfLine(self) -> bool {
    let mut Next: Token = self.NextToken();
    match Next.getKind() {
        _ => {
            return false;
        },
        kw_short => {
            kw_long;
        },
        identifier => {
            if Next.getIdentifierInfo() == self.Ident_pixel {
                self.Tok.setKind(kw___vector);
                return true;
            }
        },
    }
}

fn Parser::TryAltiVecTokenOutOfLine(self, DS: *mut DeclSpec, Loc: SourceLocation, PrevSpec: **mut u8, DiagID: *mut u32, isInvalid: *mut bool) -> bool {
    let mut Policy: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
    if self.Tok.getIdentifierInfo() == self.Ident_vector {
        let mut Next: Token = self.NextToken();
        match Next.getKind() {
            kw_short => {
                kw_long;
            },
            identifier => {
                if Next.getIdentifierInfo() == self.Ident_pixel {
                    isInvalid = DS.SetTypeAltiVecVector(true, Loc, PrevSpec, DiagID, Policy);
                    return true;
                }
            },
            _ => {
                break;
            },
        }
    } else if (self.Tok.getIdentifierInfo() == self.Ident_pixel) && DS.isTypeAltiVecVector() {
        isInvalid = DS.SetTypeAltiVecPixel(true, Loc, PrevSpec, DiagID, Policy);
        return true;
    } else if (self.Tok.getIdentifierInfo() == self.Ident_bool) && DS.isTypeAltiVecVector() {
        isInvalid = DS.SetTypeAltiVecBool(true, Loc, PrevSpec, DiagID, Policy);
        return true;
    }
    return false;
}

fn Parser::ParseTypeFromString(self, TypeStr: str, Context: str, IncludeLoc: SourceLocation) -> i32 {
    let mut Tokens: SmallVector<Token, 4> = zeroed();
    {
        let mut SourceMgr: *mut SourceManager = self.PP.getSourceManager();
        let mut FID: FileID = SourceMgr((TypeStr, Context), C_User, 0, 0, IncludeLoc);
        let mut L: Lexer = Lexer { FID, SourceMgr.getBufferOrFake(FID, SourceLocation {}), self.PP, true };
        L.setParsingPreprocessorDirective;
        let mut Tok: Token = Token {};
        while true {
            {
            L.Lex(Tok);
            Tokens()(Tok);
        }
            if !(Tok.isNot(eod)) { break; }
        }
    }
    let mut EndToken: *mut Token = ();
    EndToken.startToken();
    EndToken.setKind(eof);
    EndToken.setLocation(self.Tok.getLocation());
    EndToken.setEofData(TypeStr.ptr);
    Tokens()(self.Tok);
    self.PP(false, false);
    self.ConsumeAnyToken(false);
    let mut LocalScope: ParseScope = ParseScope { self, 0, true, false };
    let mut Result: i32 = 0;
    if Result()() && (self.Tok.isNot(eof) || self.Tok.getEofData() != TypeStr.ptr) {}
    while self.Tok.isNot(eof) {
        self.ConsumeAnyToken(false);
    }
    if self.Tok.is(eof) && self.Tok.getEofData() == TypeStr.ptr {
        self.ConsumeAnyToken(false);
    }
    return ;
}

fn Parser::DiagnoseBitIntUse(self, Tok: *Token) {
    assert!(Tok, "expected either an _ExtInt or _BitInt token!");
    let mut Loc: SourceLocation = Tok.getLocation();
    if Tok.is(kw__ExtInt) {
         << CreateReplacement(Loc, "_BitInt");
    } else {
        if self.getLangOpts() {
            << Tok.getName();
        } else {
            << self.getLangOpts();
        }
    }
}

