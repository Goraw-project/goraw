unsafe fn Closure_4::call(self: *mut Closure_4, Ext: str, ImageTypeSpec: TypeSpecifierType) -> bool {
            if !Ext.is_empty() && !self.getActions().getOpenCLOptions().isSupported(Ext, self.getLangOpts()) {
                self.Tok.getIdentifierInfo().revertTokenIDToIdentifier();
                self.Tok.setKind(identifier);
                return false;
            }
            (*self.isInvalid) = (*self.DS).SetTypeSpecType(ImageTypeSpec, (*self.Loc), (*self.PrevSpec), (*self.DiagID), (*self.Policy));
            return true;
        }

struct Closure_5 {
