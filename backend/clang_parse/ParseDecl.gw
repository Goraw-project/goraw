fn Parser::ParseAtomicSpecifier(self, DS: *mut DeclSpec) {
    assert!(self.Tok.is(kw__Atomic) && self.NextToken().is(l_paren), "Not an atomic specifier");
    let mut StartLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        return;
    }
    let mut Result: i32 = 0;
    if Result()() {
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    T.consumeClose();
    if T.getCloseLocation().isInvalid() {
        return;
