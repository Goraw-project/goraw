}

fn Parser::ParseDecompositionDeclarator(self, D: *mut Declarator) {
    assert!(self.Tok.is(l_square);
    let mut PA: TentativeParsingAction = TentativeParsingAction { *self, false };
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
    T.consumeOpen();
    if self.isCXX11AttributeSpecifier(false, false) != NotAttributeSpecifier {
