    let mut ExpectSemi: bool = Context != ForInit;
    let mut CommaLoc: SourceLocation = SourceLocation {};
    while self.TryConsumeToken(comma, CommaLoc) {
        if self.Tok.isAtStartOfLine() && ExpectSemi && !self.MightBeDeclarator(Context) {
             << CreateReplacement(CommaLoc, ";");
            ExpectSemi = false;
