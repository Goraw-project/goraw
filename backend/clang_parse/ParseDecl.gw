    assert!(D.isPastIdentifier(), "Haven't past the location of the identifier yet?");
    if D.hasName() && !D.getNumTypeObjects() {
        self.MaybeParseCXX11Attributes(D);
    }
    while true {
        if self.Tok.is(l_paren) {
            let mut IsFunctionDeclaration: bool = D.isFunctionDeclaratorAFunctionDeclaration();
            let mut PrototypeScope: ParseScope = ParseScope { self, FunctionPrototypeScope | DeclScope | (if IsFunctionDeclaration { FunctionDeclarationScope } else { NoScope }), true, false };
            let mut IsAmbiguous: bool = false;
            if self.getLangOpts() && D.mayBeFollowedByCXXDirectInit() {
