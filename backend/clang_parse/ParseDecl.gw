    return normalizeAttrName(II.getName()).Case("__arm_agnostic", 4294967295).Case("__arm_in", 4294967295).Case("__arm_inout", 4294967295).Case("__arm_new", 4294967295).Case("__arm_out", 4294967295).Case("__arm_preserves", 4294967295).Case("__asm", 1).Case("__asm__", 1).Case("abi_tag", 4294967295).Case("acquire_handle", 1).Case("alias", 1).Case("allocate", 1).Case("amdgpu_av", 1).Case("annotate", 1).Case("annotate_type", 1).Case("asm", 1).Case("assume", if (Syntax == AS_CXX11 && ScopeName && ScopeName.getName() == "omp") { 1 } else { 0 }).Case("availability", 160).Case("blocks", 1).Case("btf_decl_tag", 1).Case("btf_type_tag", 1).Case("callable_when", 4294967295).Case("capability", 1).Case("cfi_salt", 1).Case("code_seg", 1).Case("deprecated", 3).Case("diagnose_if", 14).Case("dimension", 1).Case("enable_if", 2).Case("enforce_tcb", 1).Case("enforce_tcb_leaf", 1).Case("error", 1).Case("export_name", 1).Case("external_source_symbol", 11).Case("function_return", 1).Case("ifunc", 1).Case("import_module", 1).Case("import_name", 1).Case("init_seg", 1).Case("interrupt", if (Syntax == AS_GNU && !ScopeName && true && (T.getArch() == arm || T.getArch() == thumb || T.getArch() == armeb || T.getArch() == thumbeb)) { 1 } else { if (Syntax == AS_CXX11 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == arm || T.getArch() == thumb || T.getArch() == armeb || T.getArch() == thumbeb)) { 1 } else { if (Syntax == AS_C23 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == arm || T.getArch() == thumb || T.getArch() == armeb || T.getArch() == thumbeb)) { 1 } else { if (Syntax == AS_GNU && !ScopeName && true && (T.getArch() == mips || T.getArch() == mipsel)) { 1 } else { if (Syntax == AS_CXX11 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == mips || T.getArch() == mipsel)) { 1 } else { if (Syntax == AS_C23 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == mips || T.getArch() == mipsel)) { 1 } else { if (Syntax == AS_GNU && !ScopeName && true && (T.getArch() == riscv32 || T.getArch() == riscv64 || T.getArch() == riscv32be || T.getArch() == riscv64be)) { 4294967295 } else { if (Syntax == AS_CXX11 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == riscv32 || T.getArch() == riscv64 || T.getArch() == riscv32be || T.getArch() == riscv64be)) { 4294967295 } else { if (Syntax == AS_C23 && ScopeName && ScopeName.getName() == "gnu" && true && (T.getArch() == riscv32 || T.getArch() == riscv64 || T.getArch() == riscv32be || T.getArch() == riscv64be)) { 4294967295 } else { 0 } } } } } } } } }).Case("interrupt_save_fp", 1).Case("model", 1).Case("modular_format", 4294967294).Case("no_builtin", 4294967295).Case("no_sanitize", 4294967295).Case("no_specializations", 1).Case("nodiscard", 1).Case("objc_runtime_name", 1).Case("patchable_function_entry", 4).Case("pcs", 1).Case("ptrauth_vtable_pointer", 7).Case("register", 3).Case("release_handle", 1).Case("resource_class", 1).Case("section", 1).Case("shader", 1).Case("shared_capability", 1).Case("suppress", 4294967295).Case("swift_async_name", 1).Case("swift_attr", 1).Case("swift_bridge", 1).Case("swift_name", 1).Case("target", 1).Case("target_clones", 4294967295).Case("target_version", 1).Case("tls_model", 1).Case("type_visibility", 1).Case("unavailable", 1).Case("use_handle", 1).Case("uuid", 1).Case("visibility", 1).Case("warn_unused_result", 1).Case("warning", 1).Case("weakref", 1).Case("zero_call_used_regs", 1).Default(0);
}

fn attributeHasVariadicIdentifierArg(II: *IdentifierInfo, Syntax: Syntax, ScopeName: *mut IdentifierInfo) -> bool {
    return normalizeAttrName(II.getName()).Case("callback", true).Case("cpu_dispatch", true).Case("cpu_specific", true).Case("lifetime_capture_by", true).Case("lifetime_capture_by_global", true).Case("lifetime_capture_by_this", true).Case("lifetime_capture_by_unknown", true).Default(false);
}

fn attributeTreatsKeywordThisAsIdentifier(II: *IdentifierInfo, Syntax: Syntax, ScopeName: *mut IdentifierInfo) -> bool {
    return normalizeAttrName(II.getName()).Case("callback", true).Case("lifetime_capture_by", true).Case("lifetime_capture_by_global", true).Case("lifetime_capture_by_this", true).Case("lifetime_capture_by_unknown", true).Default(false);
}

fn attributeAcceptsExprPack(II: *IdentifierInfo, Syntax: Syntax, ScopeName: *mut IdentifierInfo) -> bool {
    return normalizeAttrName(II.getName()).Case("acquire_capability", true).Case("acquire_shared_capability", true).Case("acquired_after", true).Case("acquired_before", true).Case("annotate", true).Case("annotate_type", true).Case("assert_capability", true).Case("assert_exclusive_lock", true).Case("assert_shared_capability", true).Case("assert_shared_lock", true).Case("exclusive_lock_function", true).Case("exclusive_locks_required", true).Case("exclusive_trylock_function", true).Case("locks_excluded", true).Case("release_capability", true).Case("release_generic_capability", true).Case("release_shared_capability", true).Case("requires_capability", true).Case("requires_shared_capability", true).Case("shared_lock_function", true).Case("shared_locks_required", true).Case("shared_trylock_function", true).Case("try_acquire_capability", true).Case("try_acquire_shared_capability", true).Case("unlock_function", true).Default(false);
}

fn attributeIsTypeArgAttr(II: *IdentifierInfo, Syntax: Syntax, ScopeName: *mut IdentifierInfo) -> bool {
    return normalizeAttrName(II.getName()).Case("Owner", true).Case("Pointer", true).Case("contained_type", true).Case("iboutletcollection", true).Case("preferred_name", true).Case("preferred_type", true).Case("sycl_kernel_entry_point", true).Case("vec_type_hint", true).Default(false);
}

fn attributeHasStrictIdentifierArgs(II: *IdentifierInfo, Syntax: Syntax, ScopeName: *mut IdentifierInfo) -> bool {
    return normalizeAttrName(II.getName()).Case("atomic", true).Case("ptrauth_vtable_pointer", true).Default(false);
}

fn attributeParsedArgsUnevaluated(II: *IdentifierInfo, Syntax: Syntax, ScopeName: *mut IdentifierInfo) -> bool {
    return normalizeAttrName(II.getName()).Case("acquire_capability", true).Case("acquire_shared_capability", true).Case("acquired_after", true).Case("acquired_before", true).Case("assert_capability", true).Case("assert_exclusive_lock", true).Case("assert_shared_capability", true).Case("assert_shared_lock", true).Case("counted_by", true).Case("counted_by_or_null", true).Case("exclusive_lock_function", true).Case("exclusive_locks_required", true).Case("exclusive_trylock_function", true).Case("guarded_by", true).Case("lock_returned", true).Case("locks_excluded", true).Case("pt_guarded_by", true).Case("release_capability", true).Case("release_generic_capability", true).Case("release_shared_capability", true).Case("requires_capability", true).Case("requires_shared_capability", true).Case("shared_lock_function", true).Case("shared_locks_required", true).Case("shared_trylock_function", true).Case("sized_by", true).Case("sized_by_or_null", true).Case("try_acquire_capability", true).Case("try_acquire_shared_capability", true).Case("unlock_function", true).Default(false);
}

fn Parser::ParseIdentifierLoc(self) -> *mut IdentifierLoc {
    assert!(self.Tok.is(identifier), "expected an identifier");
    let mut IL: *mut IdentifierLoc = IdentifierLoc { Loc: self.Tok.getLocation(), II: self.Tok.getIdentifierInfo() };
    self.ConsumeToken();
    return IL;
}

fn Parser::ParseAttributeWithTypeArg(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    Parens.consumeOpen();
    let mut T: TypeResult = false;
    if self.Tok.isNot(r_paren) {
        T = self.ParseTypeName(null, TypeName, AS_none, null, null);
    }
    if Parens.consumeClose() {
        return;
    }
    if T.isInvalid() {
        return;
    }
    if T.isUsable() {
        Attrs.addNewTypeAttr(&mut AttrName, SourceRange { B: AttrNameLoc, E: Parens.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, T.get(), Form, SourceLocation {});
    } else {
        Attrs.addNew(&mut AttrName, SourceRange { B: AttrNameLoc, E: Parens.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, null, 0, Form, SourceLocation {});
    }
}

fn Parser::ParseUnevaluatedStringInAttribute(self, AttrName: *IdentifierInfo) -> ExprResult {
    if self.Tok.is(l_paren) {
        let mut Paren: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        Paren.consumeOpen();
        let mut Res: ExprResult = self.ParseUnevaluatedStringInAttribute(AttrName);
        Paren.consumeClose();
        return Res;
    }
    if !self.isTokenStringLiteral() {
        self.Diag(self.Tok.getLocation(), err_expected_string_literal) << 4 << AttrName.getName();
        return ExprError();
    }
    return self.ParseUnevaluatedStringLiteralExpression();
}

fn Parser::ParseAttributeArgumentList(self, AttrName: *IdentifierInfo, Exprs: *mut SmallVectorImpl<Expr *>, ArgsProperties: ParsedAttributeArgumentsProperties, Arg: u32) -> bool {
    let mut SawError: bool = false;
    while true {
        let mut Expr: ExprResult = false;
        if ArgsProperties.isStringLiteralArg(Arg) {
            Expr = self.ParseUnevaluatedStringInAttribute(AttrName);
        } else if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
            self.Diag(self.Tok, compat_cxx11_generalized_initializer_lists);
            Expr = self.ParseBraceInitializer();
        } else {
            Expr = self.ParseAssignmentExpression(AllowNonTypes);
        }
        if self.Tok.is(ellipsis) {
            Expr = self.Actions.ActOnPackExpansion(Expr.get(), self.ConsumeToken());
        } else if self.Tok.is(code_completion) {
            SawError = true;
            self.cutOffParsing();
            break;
        }
        if Expr.isInvalid() {
            SawError = true;
            break;
        }
        if self.Actions.DiagnoseUnexpandedParameterPack(Expr.get(), UPPC_Expression) {
            SawError = true;
            break;
        }
        Exprs.push(Expr.get());
        if self.Tok.isNot(comma) {
            break;
        }
        let mut Comma: Token = self.Tok;
        self.ConsumeToken();
        self.checkPotentialAngleBracketDelimiter(Comma);
        Arg += 1;
    }
    return SawError;
}

fn Parser::ParseAttributeArgsCommon(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) -> u32 {
    self.ConsumeParen();
    let mut ChangeKWThisToIdent: bool = attributeTreatsKeywordThisAsIdentifier(*AttrName, Form.getSyntax(), ScopeName);
    let mut AttributeIsTypeArgAttr: bool = attributeIsTypeArgAttr(*AttrName, Form.getSyntax(), ScopeName);
    let mut AttributeHasVariadicIdentifierArg: bool = attributeHasVariadicIdentifierArg(*AttrName, Form.getSyntax(), ScopeName);
    if ChangeKWThisToIdent && self.Tok.is(kw_this) {
        self.Tok.setKind(identifier);
    }
    let mut ArgExprs: ArgsVector = ArgsVector {};
    if self.Tok.is(identifier) {
        let mut IsIdentifierArg: bool = AttributeHasVariadicIdentifierArg || attributeHasIdentifierArg(self.getTargetInfo().getTriple(), *AttrName, Form.getSyntax(), ScopeName);
        let mut AttrKind: Kind = getParsedKind(AttrName, ScopeName, Form.getSyntax());
        if AttrKind == UnknownAttribute || AttrKind == IgnoredAttribute {
            let mut Next: *Token = self.NextToken();
            IsIdentifierArg = Next.isOneOf(r_paren, comma);
        }
        if IsIdentifierArg {
            ArgExprs.push(self.ParseIdentifierLoc());
        }
    }
    let mut TheParsedType: ParsedType = null;
    if if !ArgExprs.is_empty() { self.Tok.is(comma) } else { self.Tok.isNot(r_paren) } {
        if !ArgExprs.is_empty() {
            self.ConsumeToken();
        }
        if AttributeIsTypeArgAttr {
            let mut T: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
            if T.isInvalid() {
                self.SkipUntil(r_paren, StopAtSemi);
                return 0;
            }
            if T.isUsable() {
                TheParsedType = T.get();
            }
        } else if AttributeHasVariadicIdentifierArg || attributeHasStrictIdentifierArgs(*AttrName, Form.getSyntax(), ScopeName) {
            while true {
                {
                if ChangeKWThisToIdent && self.Tok.is(kw_this) {
                    self.Tok.setKind(identifier);
                }
                let mut ArgExpr: ExprResult = false;
                if self.Tok.is(identifier) {
                    ArgExprs.push(self.ParseIdentifierLoc());
                } else {
                    let mut Uneval: bool = attributeParsedArgsUnevaluated(*AttrName, Form.getSyntax(), ScopeName);
                    let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, if Uneval { Unevaluated } else { ConstantEvaluated }, null, EK_AttrArgument, true };
                    let mut ArgExpr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
                    if ArgExpr.isInvalid() {
                        self.SkipUntil(r_paren, StopAtSemi);
                        return 0;
                    }
                    ArgExprs.push(ArgExpr.get());
                }
            }
                if !(self.TryConsumeToken(comma)) { break; }
            }
        } else {
            let mut Uneval: bool = attributeParsedArgsUnevaluated(*AttrName, Form.getSyntax(), ScopeName);
            let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, if Uneval { Unevaluated } else { ConstantEvaluated }, null, EK_AttrArgument, true };
            let mut ParsedExprs: ExprVector = ExprVector {};
            let mut ArgProperties: ParsedAttributeArgumentsProperties = attributeStringLiteralListArg(self.getTargetInfo().getTriple(), *AttrName, Form.getSyntax(), ScopeName);
            if self.ParseAttributeArgumentList(*AttrName, ParsedExprs, ArgProperties, ArgExprs.len) {
                self.SkipUntil(r_paren, StopAtSemi);
                return 0;
            }
            for let mut I: u64 = 0; I < ParsedExprs.len; I += 1 {
                if !isa(ParsedExprs[I]) {
                    continue;
                }
                if !attributeAcceptsExprPack(*AttrName, Form.getSyntax(), ScopeName) {
                    self.Diag(self.Tok.getLocation(), err_attribute_argument_parm_pack_not_supported) << AttrName;
                    self.SkipUntil(r_paren, StopAtSemi);
                    return 0;
                }
            }
            append_range(ArgExprs, ParsedExprs);
        }
    }
    let mut RParen: SourceLocation = self.Tok.getLocation();
    if !self.ExpectAndConsume(r_paren, err_expected, "") {
        let mut AttrLoc: SourceLocation = if ScopeLoc.isValid() { ScopeLoc } else { AttrNameLoc };
        if AttributeIsTypeArgAttr && !TheParsedType.get().isNull() {
            Attrs.addNewTypeAttr(AttrName, SourceRange { B: AttrNameLoc, E: RParen }, AttributeScopeInfo { ScopeName, ScopeLoc }, TheParsedType, Form, SourceLocation {});
        } else {
            Attrs.addNew(AttrName, SourceRange { B: AttrLoc, E: RParen }, AttributeScopeInfo { ScopeName, ScopeLoc }, ArgExprs.ptr, ArgExprs.len, Form, SourceLocation {});
        }
    }
    if EndLoc {
        *EndLoc = RParen;
    }
    return ArgExprs.len + !TheParsedType.get().isNull() as u32;
}

fn Parser::ParseGNUAttributeArgs(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form, D: *mut Declarator) {
    assert!(self.Tok.is(l_paren), "Attribute arg list not starting with '('");
    let mut AttrKind: Kind = getParsedKind(AttrName, ScopeName, Form.getSyntax());
    if AttrKind == AT_Availability {
        self.ParseAvailabilityAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if AttrKind == AT_ExternalSourceSymbol {
        self.ParseExternalSourceSymbolAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if AttrKind == AT_ObjCBridgeRelated {
        self.ParseObjCBridgeRelatedAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if AttrKind == AT_SwiftNewType {
        self.ParseSwiftNewTypeAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if AttrKind == AT_TypeTagForDatatype {
        self.ParseTypeTagForDatatypeAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if attributeIsTypeArgAttr(*AttrName, Form.getSyntax(), ScopeName) {
        self.ParseAttributeWithTypeArg(*AttrName, AttrNameLoc, Attrs, ScopeName, ScopeLoc, Form);
        return;
    } else if AttrKind == AT_CountedBy || AttrKind == AT_CountedByOrNull || AttrKind == AT_SizedBy || AttrKind == AT_SizedByOrNull {
        self.ParseBoundsAttribute(*AttrName, AttrNameLoc, Attrs, ScopeName, ScopeLoc, Form);
        return;
    } else if AttrKind == AT_CXXAssume {
        self.ParseCXXAssumeAttributeArg(Attrs, AttrName, AttrNameLoc, ScopeName, ScopeLoc, EndLoc, Form);
        return;
    }
    let mut PrototypeScope: optional<ParseScope> = optional<ParseScope> {};
    if D && IsAttributeArgsParsedInFunctionScope(*AttrName) {
        let mut FTI: *FunctionTypeInfo = null;
        for let mut i: u32 = 0; i < D.getNumTypeObjects(); i += 1 {
            if D.getTypeObject(i).Kind == Function {
                FTI = &mut D.getTypeObject(i)..Fun;
                break;
            }
        }
        if FTI {
            PrototypeScope.emplace(self, FunctionPrototypeScope | FunctionDeclarationScope | DeclScope | (self.getCurScope().getFlags() & ClassScope));
            for let mut i: u32 = 0; i < FTI.NumParams; i += 1 {
                self.Actions.ActOnReenterCXXMethodParameter(self.getCurScope(), dyn_cast_or_null(FTI.Params[i].Param));
            }
        }
    }
    self.ParseAttributeArgsCommon(AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
}

fn Parser::ParseClangAttributeArgs(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) -> u32 {
    assert!(self.Tok.is(l_paren), "Attribute arg list not starting with '('");
    let mut AttrKind: Kind = getParsedKind(AttrName, ScopeName, Form.getSyntax());
    match AttrKind {
        _ => {
            return self.ParseAttributeArgsCommon(AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        },
        AT_ExternalSourceSymbol => {
            self.ParseExternalSourceSymbolAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        },
        AT_Availability => {
            self.ParseAvailabilityAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        },
        AT_ObjCBridgeRelated => {
            self.ParseObjCBridgeRelatedAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        },
        AT_SwiftNewType => {
            self.ParseSwiftNewTypeAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        },
        AT_TypeTagForDatatype => {
            self.ParseTypeTagForDatatypeAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        },
        AT_CXXAssume => {
            self.ParseCXXAssumeAttributeArg(Attrs, AttrName, AttrNameLoc, ScopeName, ScopeLoc, EndLoc, Form);
        },
    }
    return if !Attrs.is_empty() { operator(operator(Attrs.begin())).getNumArgs() } else { 0 };
}

fn Parser::ParseMicrosoftDeclSpecArgs(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes) -> bool {
    let mut ExistingAttrs: u32 = Attrs.len;
    if !hasAttribute(AS_Declspec, null, AttrName, self.getTargetInfo(), self.getLangOpts()) {
        self.ConsumeParen();
        self.SkipUntil(r_paren, 0 as SkipUntilFlags);
        return false;
    }
    let mut OpenParenLoc: SourceLocation = self.Tok.getLocation();
    if AttrName.getName() == "property" {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.expectAndConsume(err_expected_lparen_after, AttrName.getNameStart(), r_paren);
        let mut AccessorNames: [2]*mut IdentifierInfo = [null, null];
        let mut HasInvalidAccessor: bool = false;
        while true {
            if !self.Tok.is(identifier) {
                if self.Tok.is(r_paren) && !HasInvalidAccessor && AccessorNames[AK_Put] == null && AccessorNames[AK_Get] == null {
                    self.Diag(AttrNameLoc, err_ms_property_no_getter_or_putter);
                    break;
                }
                self.Diag(self.Tok.getLocation(), err_ms_property_unknown_accessor);
                break;
            }
            let mut Kind: AccessorKind = zeroed();
            let mut KindLoc: SourceLocation = self.Tok.getLocation();
            let mut KindStr: str = self.Tok.getIdentifierInfo().getName();
            if KindStr == "get" {
                Kind = AK_Get;
            } else if KindStr == "put" {
                Kind = AK_Put;
            } else if KindStr == "set" {
                self.Diag(KindLoc, err_ms_property_has_set_accessor) << CreateReplacement(KindLoc, "put");
                Kind = AK_Put;
            } else if self.NextToken().is(comma) || self.NextToken().is(r_paren) {
                self.Diag(KindLoc, err_ms_property_missing_accessor_kind);
                self.ConsumeToken();
                HasInvalidAccessor = true;
            } else {
                self.Diag(KindLoc, err_ms_property_unknown_accessor);
                HasInvalidAccessor = true;
                Kind = AK_Invalid;
                if !self.NextToken().is(equal) {
                    break;
                }
            }
            self.ConsumeToken();
            if !self.TryConsumeToken(equal) {
                self.Diag(self.Tok.getLocation(), err_ms_property_expected_equal) << KindStr;
                break;
            }
            if !self.Tok.is(identifier) {
                self.Diag(self.Tok.getLocation(), err_ms_property_expected_accessor_name);
                break;
            }
            if Kind == AK_Invalid {} else if AccessorNames[Kind] != null {
                self.Diag(KindLoc, err_ms_property_duplicate_accessor) << KindStr;
            } else {
                AccessorNames[Kind] = self.Tok.getIdentifierInfo();
            }
            self.ConsumeToken();
            self.TryConsumeToken(comma);
            if self.Tok.is(r_paren) {
                break;
            }
            self.Diag(self.Tok.getLocation(), err_ms_property_expected_comma_or_rparen);
            break;
        }
        if !HasInvalidAccessor {
            Attrs.addNewPropertyAttr(AttrName, AttrNameLoc, AttributeScopeInfo {}, AccessorNames[AK_Get], AccessorNames[AK_Put], Declspec());
        }
        T.skipToEnd();
        return !HasInvalidAccessor;
    }
    let mut NumArgs: u32 = self.ParseAttributeArgsCommon(AttrName, AttrNameLoc, Attrs, null, null, SourceLocation {}, Declspec());
    if ExistingAttrs < Attrs.len && Attrs.back().getMaxArgs() && !NumArgs {
        self.Diag(OpenParenLoc, err_attribute_requires_arguments) << AttrName;
        return false;
    }
    return true;
}

fn Parser::ParseMicrosoftDeclSpecs(self, Attrs: *mut ParsedAttributes) {
    assert!(self.getLangOpts().DeclSpecKeyword, "__declspec keyword is not enabled");
    assert!(self.Tok.is(kw___declspec), "Not a declspec!");
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = StartLoc;
    while self.Tok.is(kw___declspec) {
        self.ConsumeToken();
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        if T.expectAndConsume(err_expected_lparen_after, "__declspec", r_paren) {
            return;
        }
        while self.Tok.isNot(r_paren) {
            if self.TryConsumeToken(comma) {
                continue;
            }
            if self.Tok.is(code_completion) {
                self.cutOffParsing();
                self.Actions.CodeCompletion().CodeCompleteAttribute(AS_Declspec, Attribute, null);
                return;
            }
            let mut IsString: bool = self.Tok.getKind() == string_literal;
            if !IsString && self.Tok.getKind() != identifier && self.Tok.getKind() != kw_restrict {
                self.Diag(self.Tok, err_ms_declspec_type);
                T.skipToEnd();
                return;
            }
            let mut AttrName: *mut IdentifierInfo = null;
            let mut AttrNameLoc: SourceLocation = SourceLocation {};
            if IsString {
                let mut StrBuffer: str = "";
                let mut Invalid: bool = false;
                let mut Str: str = self.PP.getSpelling(self.Tok, StrBuffer, &mut Invalid);
                if Invalid {
                    T.skipToEnd();
                    return;
                }
                AttrName = self.PP.getIdentifierInfo(Str);
                AttrNameLoc = self.ConsumeStringToken();
            } else {
                AttrName = self.Tok.getIdentifierInfo();
                AttrNameLoc = self.ConsumeToken();
            }
            let mut AttrHandled: bool = false;
            if self.Tok.is(l_paren) {
                AttrHandled = self.ParseMicrosoftDeclSpecArgs(AttrName, AttrNameLoc, Attrs);
            } else if AttrName.getName() == "property" {
                self.Diag(self.Tok.getLocation(), err_expected_lparen_after) << AttrName.getName();
            }
            if !AttrHandled {
                Attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, Declspec(), SourceLocation {});
            }
        }
        T.consumeClose();
        EndLoc = T.getCloseLocation();
    }
    Attrs.Range = SourceRange { B: StartLoc, E: EndLoc };
}

fn Parser::ParseMicrosoftTypeAttributes(self, attrs: *mut ParsedAttributes) {
    while true {
        let mut Kind: TokenKind = self.Tok.getKind();
        match Kind {
            kw___fastcall => {
                kw___stdcall;
            },
            _ => {
                return;
            },
        }
    }
}

fn Parser::ParseWebAssemblyFuncrefTypeAttribute(self, attrs: *mut ParsedAttributes) {
    assert!(self.Tok.is(kw___funcref);
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    if !self.getTargetInfo().getTriple().isWasm() {
        self.ConsumeToken();
        self.Diag(StartLoc, err_wasm_funcref_not_wasm);
        return;
    }
    let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
    attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___funcref, SourceLocation {});
}

fn Parser::DiagnoseAndSkipExtendedMicrosoftTypeAttributes(self) {
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = self.SkipExtendedMicrosoftTypeAttributes();
    if EndLoc.isValid() {
        let mut Range: SourceRange = SourceRange { B: StartLoc, E: EndLoc };
        self.Diag(StartLoc, warn_microsoft_qualifiers_ignored) << Range;
    }
}

fn Parser::SkipExtendedMicrosoftTypeAttributes(self) -> SourceLocation {
    let mut EndLoc: SourceLocation = SourceLocation {};
    while true {
        match self.Tok.getKind() {
            kw_const => {
                kw_volatile;
            },
            _ => {
                return EndLoc;
            },
        }
    }
}

fn Parser::ParseBorlandTypeAttributes(self, attrs: *mut ParsedAttributes) {
    while self.Tok.is(kw___pascal) {
        let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
        attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___pascal, SourceLocation {});
    }
}

fn Parser::ParseOpenCLKernelAttributes(self, attrs: *mut ParsedAttributes) {
    while self.Tok.is(kw___kernel) {
        let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
        attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___kernel, SourceLocation {});
    }
}

fn Parser::ParseCUDAFunctionAttributes(self, attrs: *mut ParsedAttributes) {
    while self.Tok.is(kw___noinline__) {
        let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
        attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___noinline__, SourceLocation {});
    }
}

fn Parser::ParseOpenCLQualifiers(self, Attrs: *mut ParsedAttributes) {
    let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut AttrNameLoc: SourceLocation = self.Tok.getLocation();
    Attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, self.Tok.getKind(), SourceLocation {});
}

fn Parser::isHLSLQualifier(self: *Parser, Tok: *Token) -> bool {
    return Tok.is(kw_groupshared) || Tok.is(kw_row_major) || Tok.is(kw_column_major);
}

fn Parser::ParseHLSLQualifiers(self, Attrs: *mut ParsedAttributes) {
    let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut Kind: TokenKind = self.Tok.getKind();
    let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
    Attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, Kind, SourceLocation {});
}

fn Parser::ParseNullabilityTypeSpecifiers(self, attrs: *mut ParsedAttributes) {
    while true {
        let mut Kind: TokenKind = self.Tok.getKind();
        match Kind {
            kw__Nonnull => {
                kw__Nullable;
            },
            _ => {
                return;
            },
        }
    }
}

fn VersionNumberSeparator(Separator: i8) -> bool {
    return (Separator == '.' || Separator == '_');
}

fn Parser::ParseVersionTuple(self, Range: *mut SourceRange) -> VersionTuple {
    Range = SourceRange { B: self.Tok.getLocation(), E: self.Tok.getEndLoc() };
    if !self.Tok.is(numeric_constant) {
        self.Diag(self.Tok, err_expected_version);
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    let mut Buffer: str = "";
    Buffer.resize(self.Tok.getLength() + 1);
    let mut ThisTokBegin: *u8 = &mut Buffer[0];
    let mut Invalid: bool = false;
    let mut ActualLength: u32 = self.PP.getSpelling(self.Tok, ThisTokBegin, &mut Invalid);
    if Invalid {
        return VersionTuple {};
    }
    let mut AfterMajor: u32 = 0;
    let mut Major: u32 = 0;
    while AfterMajor < ActualLength && isDigit(ThisTokBegin[AfterMajor]) {
        Major = Major * 10 + ThisTokBegin[AfterMajor] - '0';
        AfterMajor += 1;
    }
    if AfterMajor == 0 {
        self.Diag(self.Tok, err_expected_version);
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    if AfterMajor == ActualLength {
        self.ConsumeToken();
        if Major == 0 {
            self.Diag(self.Tok, err_zero_version);
            return VersionTuple {};
        }
        return Major;
    }
    let mut AfterMajorSeparator: i8 = ThisTokBegin[AfterMajor];
    if !VersionNumberSeparator(AfterMajorSeparator) || (AfterMajor + 1 == ActualLength) {
        self.Diag(self.Tok, err_expected_version);
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    let mut AfterMinor: u32 = AfterMajor + 1;
    let mut Minor: u32 = 0;
    while AfterMinor < ActualLength && isDigit(ThisTokBegin[AfterMinor]) {
        Minor = Minor * 10 + ThisTokBegin[AfterMinor] - '0';
        AfterMinor += 1;
    }
    if AfterMinor == ActualLength {
        self.ConsumeToken();
        if Major == 0 && Minor == 0 {
            self.Diag(self.Tok, err_zero_version);
            return VersionTuple {};
        }
        return VersionTuple { Major, Minor };
    }
    let mut AfterMinorSeparator: i8 = ThisTokBegin[AfterMinor];
    if !VersionNumberSeparator(AfterMinorSeparator) {
        self.Diag(self.Tok, err_expected_version);
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    if AfterMajorSeparator != AfterMinorSeparator {
        self.Diag(self.Tok, warn_expected_consistent_version_separator);
    }
    let mut AfterSubminor: u32 = AfterMinor + 1;
    let mut Subminor: u32 = 0;
    while AfterSubminor < ActualLength && isDigit(ThisTokBegin[AfterSubminor]) {
        Subminor = Subminor * 10 + ThisTokBegin[AfterSubminor] - '0';
        AfterSubminor += 1;
    }
    if AfterSubminor != ActualLength {
        self.Diag(self.Tok, err_expected_version);
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    self.ConsumeToken();
    return VersionTuple { Major, Minor, Subminor };
}

fn Parser::ParseAvailabilityAttribute(self, Availability: *mut IdentifierInfo, AvailabilityLoc: SourceLocation, attrs: *mut ParsedAttributes, endLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut Changes: [3]AvailabilityChange = [3]AvailabilityChange {};
    let mut MessageExpr: ExprResult = false;
    let mut ReplacementExpr: ExprResult = false;
    let mut EnvironmentLoc: *mut IdentifierLoc = null;
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        return;
    }
    if self.Tok.isNot(identifier) {
        self.Diag(self.Tok, err_availability_expected_platform);
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    let mut Platform: *mut IdentifierLoc = self.ParseIdentifierLoc();
    if Platform.getIdentifierInfo() {
        Ident;
    } else {
        if Ident.getName().contains("xrOS") || Ident.getName().contains("xros") {
            self.Diag(Platform.getLoc(), warn_availability_unknown_platform) << Ident;
        } else if Ident.getName() == "macosx" {
            Platform.setIdentifierInfo(self.PP.getIdentifierInfo("macos"));
        } else if Ident.getName() == "macosx_app_extension" {
            Platform.setIdentifierInfo(self.PP.getIdentifierInfo("macos_app_extension"));
        } else {
            Platform.setIdentifierInfo(self.PP.getIdentifierInfo(canonicalizePlatformName(Ident.getName())));
        }
    }
    if self.ExpectAndConsume(comma, err_expected, "") {
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    if !self.Ident_introduced {
        self.Ident_introduced = self.PP.getIdentifierInfo("introduced");
        self.Ident_deprecated = self.PP.getIdentifierInfo("deprecated");
        self.Ident_obsoleted = self.PP.getIdentifierInfo("obsoleted");
        self.Ident_unavailable = self.PP.getIdentifierInfo("unavailable");
        self.Ident_message = self.PP.getIdentifierInfo("message");
        self.Ident_strict = self.PP.getIdentifierInfo("strict");
        self.Ident_replacement = self.PP.getIdentifierInfo("replacement");
        self.Ident_environment = self.PP.getIdentifierInfo("environment");
    }
    let mut UnavailableLoc: SourceLocation = SourceLocation {};
    let mut StrictLoc: SourceLocation = SourceLocation {};
    while true {
        {
        if self.Tok.isNot(identifier) {
            self.Diag(self.Tok, err_availability_expected_change);
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        let mut Keyword: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut KeywordLoc: SourceLocation = self.ConsumeToken();
        if Keyword == self.Ident_strict {
            if StrictLoc.isValid() {
                self.Diag(KeywordLoc, err_availability_redundant) << Keyword << StrictLoc;
            }
            StrictLoc = KeywordLoc;
            continue;
        }
        if Keyword == self.Ident_unavailable {
            if UnavailableLoc.isValid() {
                self.Diag(KeywordLoc, err_availability_redundant) << Keyword << UnavailableLoc;
            }
            UnavailableLoc = KeywordLoc;
            continue;
        }
        if Keyword == self.Ident_deprecated && Platform.getIdentifierInfo() && Platform.getIdentifierInfo().isStr("swift") {
            if Changes[Deprecated].KeywordLoc.isValid() {
                self.Diag(KeywordLoc, err_availability_redundant) << Keyword << Changes[Deprecated].KeywordLoc;
            }
            Changes[Deprecated].KeywordLoc = KeywordLoc;
            Changes[Deprecated].Version = 1;
            continue;
        }
        if Keyword == self.Ident_environment {
            if EnvironmentLoc != null {
                self.Diag(KeywordLoc, err_availability_redundant) << Keyword << EnvironmentLoc.getLoc();
            }
        }
        if self.Tok.isNot(equal) {
            self.Diag(self.Tok, err_expected_after) << Keyword << equal;
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        self.ConsumeToken();
        if Keyword == self.Ident_message || Keyword == self.Ident_replacement {
            if !self.isTokenStringLiteral() {
                self.Diag(self.Tok, err_expected_string_literal) << 2;
                self.SkipUntil(r_paren, StopAtSemi);
                return;
            }
            if Keyword == self.Ident_message {
                MessageExpr = self.ParseUnevaluatedStringLiteralExpression();
                break;
            } else {
                ReplacementExpr = self.ParseUnevaluatedStringLiteralExpression();
                continue;
            }
        }
        if Keyword == self.Ident_environment {
            if self.Tok.isNot(identifier) {
                self.Diag(self.Tok, err_availability_expected_environment);
                self.SkipUntil(r_paren, StopAtSemi);
                return;
            }
            EnvironmentLoc = self.ParseIdentifierLoc();
            continue;
        }
        if (Keyword == self.Ident_introduced || Keyword == self.Ident_deprecated) && self.Tok.is(identifier) {
            let mut NA: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            if NA.getName() == "NA" {
                self.ConsumeToken();
                if Keyword == self.Ident_introduced {
                    UnavailableLoc = KeywordLoc;
                }
                continue;
            }
        }
        let mut VersionRange: SourceRange = SourceRange {};
        let mut Version: VersionTuple = self.ParseVersionTuple(VersionRange);
        if Version.is_empty() {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        let mut Index: u32 = 0;
        if Keyword == self.Ident_introduced {
            Index = Introduced;
        } else if Keyword == self.Ident_deprecated {
            Index = Deprecated;
        } else if Keyword == self.Ident_obsoleted {
            Index = Obsoleted;
        } else {
            Index = Unknown;
        }
        if Index < Unknown {
            if !Changes[Index].KeywordLoc.isInvalid() {
                self.Diag(KeywordLoc, err_availability_redundant) << Keyword << SourceRange { B: Changes[Index].KeywordLoc, E: Changes[Index].VersionRange.getEnd() };
            }
            Changes[Index].KeywordLoc = KeywordLoc;
            Changes[Index].Version = Version;
            Changes[Index].VersionRange = VersionRange;
        } else {
            self.Diag(KeywordLoc, err_availability_unknown_change) << Keyword << VersionRange;
        }
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    if T.consumeClose() {
        return;
    }
    if endLoc {
        *endLoc = T.getCloseLocation();
    }
    if UnavailableLoc.isValid() {
        let mut Complained: bool = false;
        for let mut Index: u32 = Introduced; Index != Unknown; Index += 1 {
            if Changes[Index].KeywordLoc.isValid() {
                if !Complained {
                    self.Diag(UnavailableLoc, warn_availability_and_unavailable) << SourceRange { B: Changes[Index].KeywordLoc, E: Changes[Index].VersionRange.getEnd() };
                    Complained = true;
                }
                Changes[Index] = AvailabilityChange {};
            }
        }
    }
    attrs.addNew(&mut Availability, SourceRange { B: AvailabilityLoc, E: T.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, Platform, Changes[Introduced], Changes[Deprecated], Changes[Obsoleted], UnavailableLoc, MessageExpr.get(), Form, StrictLoc, ReplacementExpr.get(), EnvironmentLoc);
}

fn Parser::ParseExternalSourceSymbolAttribute(self, ExternalSourceSymbol: *mut IdentifierInfo, Loc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected, "", unknown) {
        return;
    }
    if !self.Ident_language {
        self.Ident_language = self.PP.getIdentifierInfo("language");
        self.Ident_defined_in = self.PP.getIdentifierInfo("defined_in");
        self.Ident_generated_declaration = self.PP.getIdentifierInfo("generated_declaration");
        self.Ident_USR = self.PP.getIdentifierInfo("USR");
    }
    let mut Language: ExprResult = false;
    let mut HasLanguage: bool = false;
    let mut DefinedInExpr: ExprResult = false;
    let mut HasDefinedIn: bool = false;
    let mut GeneratedDeclaration: *mut IdentifierLoc = null;
    let mut USR: ExprResult = false;
    let mut HasUSR: bool = false;
    while true {
        {
        if self.Tok.isNot(identifier) {
            self.Diag(self.Tok, err_external_source_symbol_expected_keyword);
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        let mut KeywordLoc: SourceLocation = self.Tok.getLocation();
        let mut Keyword: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        if Keyword == self.Ident_generated_declaration {
            if GeneratedDeclaration {
                self.Diag(self.Tok, err_external_source_symbol_duplicate_clause) << Keyword;
                self.SkipUntil(r_paren, StopAtSemi);
                return;
            }
            GeneratedDeclaration = self.ParseIdentifierLoc();
            continue;
        }
        if Keyword != self.Ident_language && Keyword != self.Ident_defined_in && Keyword != self.Ident_USR {
            self.Diag(self.Tok, err_external_source_symbol_expected_keyword);
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        self.ConsumeToken();
        if self.ExpectAndConsume(equal, err_expected_after, Keyword.getName()) {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        let mut HadLanguage: bool = HasLanguage;
        let mut HadDefinedIn: bool = HasDefinedIn;
        let mut HadUSR: bool = HasUSR;
        if Keyword == self.Ident_language {
            HasLanguage = true;
        } else if Keyword == self.Ident_USR {
            HasUSR = true;
        } else {
            HasDefinedIn = true;
        }
        if !self.isTokenStringLiteral() {
            self.Diag(self.Tok, err_expected_string_literal) << 3 << (if Keyword == self.Ident_language { 0 } else { (if Keyword == self.Ident_defined_in { 1 } else { 2 }) });
            self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch);
            continue;
        }
        if Keyword == self.Ident_language {
            if HadLanguage {
                self.Diag(KeywordLoc, err_external_source_symbol_duplicate_clause) << Keyword;
                self.ParseUnevaluatedStringLiteralExpression();
                continue;
            }
            Language = self.ParseUnevaluatedStringLiteralExpression();
        } else if Keyword == self.Ident_USR {
            if HadUSR {
                self.Diag(KeywordLoc, err_external_source_symbol_duplicate_clause) << Keyword;
                self.ParseUnevaluatedStringLiteralExpression();
                continue;
            }
            USR = self.ParseUnevaluatedStringLiteralExpression();
        } else {
            assert!(Keyword == self.Ident_defined_in, "Invalid clause keyword!");
            if HadDefinedIn {
                self.Diag(KeywordLoc, err_external_source_symbol_duplicate_clause) << Keyword;
                self.ParseUnevaluatedStringLiteralExpression();
                continue;
            }
            DefinedInExpr = self.ParseUnevaluatedStringLiteralExpression();
        }
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    if T.consumeClose() {
        return;
    }
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
    let mut Args: [4]ArgsUnion = [Language.get(), DefinedInExpr.get(), GeneratedDeclaration, USR.get()];
    Attrs.addNew(&mut ExternalSourceSymbol, SourceRange { B: Loc, E: T.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, Args, size(Args), Form, SourceLocation {});
}

fn Parser::ParseObjCBridgeRelatedAttribute(self, ObjCBridgeRelated: *mut IdentifierInfo, ObjCBridgeRelatedLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        return;
    }
    if self.Tok.isNot(identifier) {
        self.Diag(self.Tok, err_objcbridge_related_expected_related_class);
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    let mut RelatedClass: *mut IdentifierLoc = self.ParseIdentifierLoc();
    if self.ExpectAndConsume(comma, err_expected, "") {
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    let mut ClassMethod: *mut IdentifierLoc = null;
    if self.Tok.is(identifier) {
        ClassMethod = self.ParseIdentifierLoc();
        if !self.TryConsumeToken(colon) {
            self.Diag(self.Tok, err_objcbridge_related_selector_name);
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
    }
    if !self.TryConsumeToken(comma) {
        if self.Tok.is(colon) {
            self.Diag(self.Tok, err_objcbridge_related_selector_name);
        } else {
            self.Diag(self.Tok, err_expected) << comma;
        }
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    let mut InstanceMethod: *mut IdentifierLoc = null;
    if self.Tok.is(identifier) {
        InstanceMethod = self.ParseIdentifierLoc();
    } else if self.Tok.isNot(r_paren) {
        self.Diag(self.Tok, err_expected) << r_paren;
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    if T.consumeClose() {
        return;
    }
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
    Attrs.addNew(&mut ObjCBridgeRelated, SourceRange { B: ObjCBridgeRelatedLoc, E: T.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, RelatedClass, ClassMethod, InstanceMethod, Form);
}

fn Parser::ParseSwiftNewTypeAttribute(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        return;
    }
    if self.Tok.is(r_paren) {
        self.Diag(self.Tok.getLocation(), err_argument_required_after_attribute);
        T.consumeClose();
        return;
    }
    if self.Tok.isNot(kw_struct) && self.Tok.isNot(kw_enum) {
        self.Diag(self.Tok, warn_attribute_type_not_supported) << &mut AttrName << self.Tok.getIdentifierInfo();
        if !self.isTokenSpecial() {
            self.ConsumeToken();
        }
        T.consumeClose();
        return;
    }
    let mut SwiftType: *mut IdentifierLoc = IdentifierLoc { Loc: self.Tok.getLocation(), II: self.Tok.getIdentifierInfo() };
    self.ConsumeToken();
    if T.consumeClose() {
        return;
    }
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
    let mut Args: [1]ArgsUnion = [SwiftType];
    Attrs.addNew(&mut AttrName, SourceRange { B: AttrNameLoc, E: T.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, Args, size(Args), Form, SourceLocation {});
}

fn Parser::ParseTypeTagForDatatypeAttribute(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    assert!(self.Tok.is(l_paren), "Attribute arg list not starting with '('");
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    T.consumeOpen();
    if self.Tok.isNot(identifier) {
        self.Diag(self.Tok, err_expected) << identifier;
        T.skipToEnd();
        return;
    }
    let mut ArgumentKind: *mut IdentifierLoc = self.ParseIdentifierLoc();
    if self.ExpectAndConsume(comma, err_expected, "") {
        T.skipToEnd();
        return;
    }
    let mut MatchingCTypeRange: SourceRange = SourceRange {};
    let mut MatchingCType: TypeResult = self.ParseTypeName(&mut MatchingCTypeRange, TypeName, AS_none, null, null);
    if MatchingCType.isInvalid() {
        T.skipToEnd();
        return;
    }
    let mut LayoutCompatible: bool = false;
    let mut MustBeNull: bool = false;
    while self.TryConsumeToken(comma) {
        if self.Tok.isNot(identifier) {
            self.Diag(self.Tok, err_expected) << identifier;
            T.skipToEnd();
            return;
        }
        let mut Flag: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        if Flag.isStr("layout_compatible") {
            LayoutCompatible = true;
        } else if Flag.isStr("must_be_null") {
            MustBeNull = true;
        } else {
            self.Diag(self.Tok, err_type_safety_unknown_flag) << Flag;
            T.skipToEnd();
            return;
        }
        self.ConsumeToken();
    }
    if !T.consumeClose() {
        Attrs.addNewTypeTagForDatatype(&mut AttrName, AttrNameLoc, AttributeScopeInfo { ScopeName, ScopeLoc }, ArgumentKind, MatchingCType.get(), LayoutCompatible, MustBeNull, Form);
    }
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
}

fn Parser::DiagnoseProhibitedCXX11Attribute(self) -> bool {
    assert!(self.Tok.is(l_square) && self.NextToken().is(l_square);
    match self.isCXX11AttributeSpecifier(true, false) {
        NotAttributeSpecifier => {
            return false;
        },
        InvalidAttributeSpecifier => {
            self.Diag(self.Tok.getLocation(), err_l_square_l_square_not_attribute);
        },
        AttributeSpecifier => {
            let mut BeginLoc: SourceLocation = self.ConsumeBracket();
        },
    }
    llvm_unreachable_internal("All cases handled above.", "P:/Goraw/llvm-project/clang/lib/Parse/ParseDecl.cpp", 1784);
}

fn Parser::DiagnoseMisplacedCXX11Attribute(self, Attrs: *mut ParsedAttributes, CorrectLocation: SourceLocation) {
    assert!((self.Tok.is(l_square) && self.NextToken().is(l_square)) || self.Tok.is(kw_alignas) || self.Tok.isRegularKeywordAttribute();
    let mut Keyword: *mut IdentifierInfo = if self.Tok.isRegularKeywordAttribute() { self.Tok.getIdentifierInfo() } else { null };
    let mut Loc: SourceLocation = self.Tok.getLocation();
    self.ParseCXX11Attributes(Attrs);
    let mut AttrRange: CharSourceRange = CharSourceRange { Range: SourceRange { B: Loc, E: Attrs.Range.getEnd() }, IsTokenRange: true };
    (if Keyword { self.Diag(Loc, err_keyword_not_allowed) << Keyword } else { self.Diag(Loc, err_attributes_not_allowed) }) << CreateInsertionFromRange(CorrectLocation, AttrRange, false) << CreateRemoval(AttrRange);
}

fn Parser::DiagnoseProhibitedAttributes(self, Attrs: *ParsedAttributesView, CorrectLocation: SourceLocation) {
    let mut FirstAttr: *ParsedAttr = if Attrs.is_empty() { null } else { &mut Attrs.front() };
    if CorrectLocation.isValid() {
        let mut AttrRange: CharSourceRange = CharSourceRange { Range: Attrs.Range, IsTokenRange: true };
        (if FirstAttr && FirstAttr.isRegularKeywordAttribute() { self.Diag(CorrectLocation, err_keyword_misplaced) << FirstAttr } else { self.Diag(CorrectLocation, err_attributes_misplaced) }) << CreateInsertionFromRange(CorrectLocation, AttrRange, false) << CreateRemoval(AttrRange);
    } else {
        let mut Range: *SourceRange = Attrs.Range;
        (if FirstAttr && FirstAttr.isRegularKeywordAttribute() { self.Diag(Range.getBegin(), err_keyword_not_allowed) << FirstAttr } else { self.Diag(Range.getBegin(), err_attributes_not_allowed) }) << Range;
    }
}

fn Parser::ProhibitCXX11Attributes(self, Attrs: *mut ParsedAttributes, AttrDiagID: u32, KeywordDiagID: u32, DiagnoseEmptyAttrs: bool, WarnOnUnknownAttrs: bool) {
    if DiagnoseEmptyAttrs && Attrs.is_empty() && Attrs.Range.isValid() {
        let mut LangOpts: *LangOptions = self.getLangOpts();
        let mut SM: *mut SourceManager = self.PP.getSourceManager();
        let mut FirstLSquare: Token = Token {};
        getRawToken(Attrs.Range.getBegin(), FirstLSquare, SM, LangOpts, false);
        if FirstLSquare.is(l_square) {
            let mut SecondLSquare: optional<Token> = findNextToken(FirstLSquare.getLocation(), SM, LangOpts, false);
            if SecondLSquare && operator(SecondLSquare).is(l_square) {
                self.Diag(Attrs.Range.getBegin(), AttrDiagID) << Attrs.Range;
                return;
            }
        }
    }
    for AL in Attrs {
        if AL.isRegularKeywordAttribute() {
            self.Diag(AL.getLoc(), KeywordDiagID) << AL;
            AL.setInvalid(true);
            continue;
        }
        if !AL.isStandardAttributeSyntax() {
            continue;
        }
        if AL.getKind() == UnknownAttribute {
            if WarnOnUnknownAttrs {
                self.Actions.DiagnoseUnknownAttribute(AL);
                AL.setInvalid(true);
            }
        } else {
            self.Diag(AL.getLoc(), AttrDiagID) << AL;
            AL.setInvalid(true);
        }
    }
}

fn Parser::DiagnoseCXX11AttributeExtension(self, Attrs: *mut ParsedAttributes) {
    for PA in Attrs {
        if PA.isStandardAttributeSyntax() || PA.isRegularKeywordAttribute() {
            self.Diag(PA.getLoc(), ext_cxx11_attr_placement) << PA << PA.isRegularKeywordAttribute() << PA.getRange();
        }
    }
}

fn Parser::stripTypeAttributesOffDeclSpec(self, Attrs: *mut ParsedAttributes, DS: *mut DeclSpec, TUK: TagUseKind) {
    if TUK == Reference {
        return;
    }
    let mut ToBeMoved: SmallVector<ParsedAttr *, 1> = SmallVector<ParsedAttr *, 1> {};
    for AL in DS.getAttributes() {
        if (AL.getKind() == AT_Aligned && AL.isDeclspecAttribute()) || AL.isMicrosoftAttribute() {
            ToBeMoved.push(&mut AL);
        }
    }
    for AL in ToBeMoved {
        DS.getAttributes().remove(AL);
        Attrs.addAtEnd(AL);
    }
}

fn Parser::ParseDeclaration(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, DeclAttrs: *mut ParsedAttributes, DeclSpecAttrs: *mut ParsedAttributes, DeclSpecStart: *mut SourceLocation) -> DeclGroupPtrTy {
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    let mut ObjCDC: ObjCDeclContextSwitch = *self;
    let mut SingleDecl: *mut Decl = null;
    match self.Tok.getKind() {
        kw_template => {
            kw_export;
        },
        kw_inline => {
            if self.getLangOpts().CPlusPlus && self.NextToken().is(kw_namespace) {
                self.ProhibitAttributes(DeclAttrs, SourceLocation {});
                self.ProhibitAttributes(DeclSpecAttrs, SourceLocation {});
                let mut InlineLoc: SourceLocation = self.ConsumeToken();
                return self.ParseNamespace(Context, DeclEnd, InlineLoc);
            }
        },
        kw_cbuffer => {
            kw_tbuffer;
        },
        kw_namespace => {
            self.ProhibitAttributes(DeclAttrs, SourceLocation {});
        },
        kw_using => {
            takeAndConcatenateAttrs(DeclAttrs, move(DeclSpecAttrs));
            return self.ParseUsingDirectiveOrDeclaration(Context, ParsedTemplateInfo {}, DeclEnd, DeclAttrs);
        },
        kw_static_assert => {
            kw__Static_assert;
        },
        _ => {
            return self.ParseSimpleDeclaration(Context, DeclEnd, DeclAttrs, DeclSpecAttrs, true, null, DeclSpecStart);
        },
    }
    return self.Actions.ConvertDeclToDeclGroup(SingleDecl, null);
}

fn Parser::ParseSimpleDeclaration(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, DeclAttrs: *mut ParsedAttributes, DeclSpecAttrs: *mut ParsedAttributes, RequireSemi: bool, FRI: *mut ForRangeInit, DeclSpecStart: *mut SourceLocation) -> DeclGroupPtrTy {
    let mut OriginalDeclSpecAttrs: ParsedAttributesView = ParsedAttributesView {};
    OriginalDeclSpecAttrs.prepend(DeclSpecAttrs.begin(), DeclSpecAttrs.end());
    OriginalDeclSpecAttrs.Range = DeclSpecAttrs.Range;
    let mut DS: ParsingDeclSpec = *self;
    DS.takeAttributesAppendingingFrom(DeclSpecAttrs);
    let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
    let mut DSContext: DeclSpecContext = self.getDeclSpecContextFromDeclaratorContext(Context);
    self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS_none, DSContext, null);
    if DS.hasTagDefinition() && self.DiagnoseMissingSemiAfterTagDefinition(DS, AS_none, DSContext, null) {
        return null;
    }
    if self.Tok.is(semi) {
        self.ProhibitAttributes(DeclAttrs, SourceLocation {});
        DeclEnd = self.Tok.getLocation();
        if RequireSemi {
            self.ConsumeToken();
        }
        let mut AnonRecord: *mut RecordDecl = null;
        let mut TheDecl: *mut Decl = self.Actions.ParsedFreeStandingDeclSpec(self.getCurScope(), AS_none, DS, none(), AnonRecord);
        self.Actions.ActOnDefinedDeclarationSpecifier(TheDecl);
        DS.complete(TheDecl);
        if AnonRecord {
            let mut decls: [2]*mut Decl = [AnonRecord, TheDecl];
            return self.Actions.BuildDeclaratorGroup(decls);
        }
        return self.Actions.ConvertDeclToDeclGroup(TheDecl, null);
    }
    if DS.hasTagDefinition() {
        self.Actions.ActOnDefinedDeclarationSpecifier(DS.getRepAsDecl());
    }
    if DeclSpecStart {
        DS.SetRangeStart(*DeclSpecStart);
    }
    return self.ParseDeclGroup(DS, Context, DeclAttrs, TemplateInfo, &mut DeclEnd, FRI);
}

fn Parser::MightBeDeclarator(self, Context: DeclaratorContext) -> bool {
    match self.Tok.getKind() {
        annot_cxxscope => {
            annot_template_id;
        },
        amp => {
            ampamp;
        },
        l_square => {
            return Context == Member && self.getLangOpts().CPlusPlus11 && self.NextToken().is(l_square);
        },
        colon => {
            return Context == Member || self.getLangOpts().CPlusPlus;
        },
        identifier => {
            match self.NextToken().getKind() {
                code_completion => {
                    coloncolon;
                },
                colon => {
                    return Context == Member || (self.getLangOpts().CPlusPlus && Context == File);
                },
                identifier => {
                    return self.getLangOpts().CPlusPlus11 && self.isCXX11VirtSpecifier(self.NextToken());
                },
                _ => {
                    return self.Tok.isRegularKeywordAttribute();
                },
            }
        },
        _ => {
            return self.Tok.isRegularKeywordAttribute();
        },
    }
}

fn Parser::SkipMalformedDecl(self) {
    while true {
        match self.Tok.getKind() {
            l_brace => {
                self.ConsumeBrace();
            },
            l_square => {
                self.ConsumeBracket();
            },
            l_paren => {
                self.ConsumeParen();
            },
            r_brace => {
                return;
            },
            semi => {
                self.ConsumeToken();
            },
            kw_inline => {
                if self.Tok.isAtStartOfLine() && self.NextToken().is(kw_namespace) && (!self.ParsingInObjCContainer || self.CurParsedObjCImpl) {
                    return;
                }
            },
            kw_extern => {
                kw_namespace;
            },
            at => {
                if self.NextToken().isObjCAtKeyword(objc_end) && self.ParsingInObjCContainer {
                    return;
                }
            },
            minus => {
                plus;
            },
            eof => {
                annot_module_begin;
            },
            _ => {
                break;
            },
        }
        self.ConsumeAnyToken(false);
    }
}

fn Parser::ParseDeclGroup(self, DS: *mut ParsingDeclSpec, Context: DeclaratorContext, Attrs: *mut ParsedAttributes, TemplateInfo: *mut ParsedTemplateInfo, DeclEnd: *mut SourceLocation, FRI: *mut ForRangeInit) -> DeclGroupPtrTy {
    let mut LocalAttrs: ParsedAttributes = self.AttrFactory;
    LocalAttrs.takeAllPrependingFrom(Attrs);
    let mut D: ParsingDeclarator = ParsingDeclarator { *self, DS, LocalAttrs, Context };
    if TemplateInfo.TemplateParams {
        D.setTemplateParameterLists(*TemplateInfo.TemplateParams);
    }
    let mut IsTemplateSpecOrInst: bool = (TemplateInfo.Kind == ExplicitInstantiation || TemplateInfo.Kind == ExplicitSpecialization);
    let mut SAC: SuppressAccessChecks = SuppressAccessChecks { *self, IsTemplateSpecOrInst };
    self.ParseDeclarator(D);
    if IsTemplateSpecOrInst {
        SAC.done();
    }
    if !D.hasName() && !D.mayOmitIdentifier() {
        self.SkipMalformedDecl();
        return null;
    }
    if self.getLangOpts().HLSL {
        while self.MaybeParseHLSLAnnotations(D, null, false) {
            
        }
    }
    if self.Tok.is(kw_requires) {
        let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
        if !TemplateInfo.TemplateParams && D.getInventedTemplateParameterList() {
            operator(CurTemplateDepthTracker);
        }
        self.ParseTrailingRequiresClauseWithScope(D);
    }
    let mut LateParsedAttrs: LateParsedAttrList = LateParsedAttrList { ParseSoon: true, LateAttrParseExperimentalExtOnly: false, LateAttrParseTypeAttrOnly: false };
    if D.isFunctionDeclarator() {
        self.MaybeParseGNUAttributes(D, &mut LateParsedAttrs);
        if self.Tok.is(kw__Noreturn) {
            let mut Loc: SourceLocation = self.ConsumeToken();
            let mut PrevSpec: *u8 = null;
            let mut DiagID: u32 = 0;
            let mut Fixit: bool = !DS.setFunctionSpecNoreturn(Loc, PrevSpec, DiagID);
            self.MaybeParseGNUAttributes(D, &mut LateParsedAttrs);
            Fixit &= self.Tok.isOneOf(semi, l_brace, kw_try);
            self.Diag(Loc, err_c11_noreturn_misplaced) << (if Fixit { CreateRemoval(Loc) } else { FixItHint {} }) << (if Fixit { CreateInsertion(D.getBeginLoc(), "_Noreturn ", false) } else { FixItHint {} });
        }
        if self.Tok.is(equal) && self.NextToken().is(code_completion) {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteAfterFunctionEquals(D);
            return null;
        }
        while self.isCXX11VirtSpecifier() {
            Specifier;
        }
        if !self.isDeclarationAfterDeclarator() {
            if Context == File {
                if self.isStartOfFunctionDefinition(D) {
                    if DS.getStorageClassSpec() == SCS_typedef {
                        self.Diag(DS.getStorageClassSpecLoc(), err_function_declared_typedef) << CreateRemoval(DS.getStorageClassSpecLoc());
                        DS.ClearStorageClassSpecs();
                    }
                    let mut TheDecl: *mut Decl = null;
                    if TemplateInfo.Kind == ExplicitInstantiation {
                        if D.getName().getKind() != IK_TemplateId {
                            self.Diag(self.Tok, err_template_defn_explicit_instantiation) << 0;
                            TheDecl = self.ParseFunctionDefinition(D, ParsedTemplateInfo {}, &mut LateParsedAttrs);
                        } else {
                            let mut LAngleLoc: SourceLocation = self.PP.getLocForEndOfToken(TemplateInfo.TemplateLoc, 0);
                            self.Diag(D.getIdentifierLoc(), err_explicit_instantiation_with_definition) << TemplateInfo.TemplateLoc << CreateInsertion(LAngleLoc, "<>", false);
                            let mut FakedParamLists: TemplateParameterLists = TemplateParameterLists {};
                            FakedParamLists.push(self.Actions.ActOnTemplateParameterList(0, SourceLocation {}, TemplateInfo.TemplateLoc, LAngleLoc, ArrayRef<NamedDecl *> {}, LAngleLoc, null));
                            TheDecl = self.ParseFunctionDefinition(D, ParsedTemplateInfo { &mut FakedParamLists, true, true }, &mut LateParsedAttrs);
                        }
                    } else {
                        TheDecl = self.ParseFunctionDefinition(D, TemplateInfo, &mut LateParsedAttrs);
                    }
                    return self.Actions.ConvertDeclToDeclGroup(TheDecl, null);
                }
                if self.isDeclarationSpecifier(No, false) || self.Tok.is(kw_namespace) {} else {
                    self.Diag(self.Tok, err_expected_fn_body);
                    self.SkipUntil(semi, 0 as SkipUntilFlags);
                    return null;
                }
            } else {
                if self.Tok.is(l_brace) {
                    self.Diag(self.Tok, err_function_definition_not_allowed);
                    self.SkipMalformedDecl();
                    return null;
                }
            }
        }
    }
    if self.ParseAsmAttributesAfterDeclarator(D) {
        return null;
    }
    if FRI && (self.Tok.is(colon) || self.isTokIdentifier_in()) {
        let mut EnterContext: bool = FRI.ExpansionStmt && self.Actions.CurContext == FRI.ExpansionStmt.getParent();
        if EnterContext {
            self.Actions.PushDeclContext(null, FRI.ExpansionStmt);
        }
        let mut RestoreDeclContext: Closure_1 = Closure_1 { EnterContext: &mut EnterContext, cap_1: self };
        let mut IsForRangeLoopOrExpansionStmt: bool = false;
        if self.TryConsumeToken(colon, FRI.ColonLoc) {
            IsForRangeLoopOrExpansionStmt = true;
            if self.getLangOpts().OpenMP && !FRI.ExpansionStmt {
                self.Actions.OpenMP().startOpenMPCXXRangeFor();
            }
            self.ParseForRangeInitializerAfterColon(*FRI, &mut DS);
        }
        let mut ThisDecl: *mut Decl = self.Actions.ActOnDeclarator(self.getCurScope(), D);
        if IsForRangeLoopOrExpansionStmt {
            self.Actions.ActOnCXXForRangeDecl(ThisDecl, FRI.ExpansionStmt);
        } else {
            if dyn_cast_or_null(ThisDecl) {
                VD;
            } else {
                VD.setObjCForDecl(true);
            }
        }
        self.Actions.FinalizeDeclaration(ThisDecl);
        D.complete(ThisDecl);
        return self.Actions.FinalizeDeclaratorGroup(self.getCurScope(), DS, ThisDecl);
    }
    let mut DeclsInGroup: SmallVector<Decl *, 8> = SmallVector<Decl *, 8> {};
    let mut FirstDecl: *mut Decl = self.ParseDeclarationAfterDeclaratorAndAttributes(D, TemplateInfo, FRI);
    if LateParsedAttrs.len > 0 {
        self.ParseLexedAttributeList(LateParsedAttrs, FirstDecl, true, false, null);
    }
    D.complete(FirstDecl);
    if FirstDecl {
        DeclsInGroup.push(FirstDecl);
    }
    let mut ExpectSemi: bool = Context != ForInit;
    let mut CommaLoc: SourceLocation = SourceLocation {};
    while self.TryConsumeToken(comma, CommaLoc) {
        if self.Tok.isAtStartOfLine() && ExpectSemi && !self.MightBeDeclarator(Context) {
            self.Diag(CommaLoc, err_expected_semi_declaration) << CreateReplacement(CommaLoc, ";");
            ExpectSemi = false;
            break;
        }
        if TemplateInfo.Kind != NonTemplate && D.isFirstDeclarator() {
            self.Diag(CommaLoc, err_multiple_template_declarators) << TemplateInfo.Kind;
        }
        D.clear();
        D.setCommaLoc(CommaLoc);
        self.MaybeParseGNUAttributes(D, null);
        if self.getLangOpts().MicrosoftExt {
            self.DiagnoseAndSkipExtendedMicrosoftTypeAttributes();
        }
        self.ParseDeclarator(D);
        if self.getLangOpts().HLSL {
            self.MaybeParseHLSLAnnotations(D, null, false);
        }
        if !D.isInvalidType() {
            if self.Tok.is(kw_requires) {
                self.ParseTrailingRequiresClauseWithScope(D);
            }
            let mut ThisDecl: *mut Decl = self.ParseDeclarationAfterDeclarator(D, TemplateInfo);
            D.complete(ThisDecl);
            if ThisDecl {
                DeclsInGroup.push(ThisDecl);
            }
        }
    }
    if DeclEnd {
        *DeclEnd = self.Tok.getLocation();
    }
    if ExpectSemi && self.ExpectAndConsumeSemi(if Context == File { err_invalid_token_after_toplevel_declarator } else { err_expected_semi_declaration }, "") {
        if !self.isDeclarationSpecifier(No, false) {
            self.SkipMalformedDecl();
        }
    }
    return self.Actions.FinalizeDeclaratorGroup(self.getCurScope(), DS, DeclsInGroup);
}

fn Parser::ParseAsmAttributesAfterDeclarator(self, D: *mut Declarator) -> bool {
    if self.Tok.is(kw_asm) {
        let mut Loc: SourceLocation = SourceLocation {};
        let mut AsmLabel: ExprResult = self.ParseSimpleAsm(true, &mut Loc);
        if AsmLabel.isInvalid() {
            self.SkipUntil(semi, StopBeforeMatch);
            return true;
        }
        D.setAsmLabel(AsmLabel.get());
        D.SetRangeEnd(Loc);
    }
    self.MaybeParseGNUAttributes(D, null);
    return false;
}

fn Parser::ParseDeclarationAfterDeclarator(self, D: *mut Declarator, TemplateInfo: *ParsedTemplateInfo) -> *mut Decl {
    if self.ParseAsmAttributesAfterDeclarator(D) {
        return null;
    }
    return self.ParseDeclarationAfterDeclaratorAndAttributes(D, TemplateInfo, null);
}

fn Parser::ParseDeclarationAfterDeclaratorAndAttributes(self, D: *mut Declarator, TemplateInfo: *ParsedTemplateInfo, FRI: *mut ForRangeInit) -> *mut Decl {
    let mut TheInitKind: InitKind = zeroed();
    if self.isTokenEqualOrEqualTypo() {
        TheInitKind = Equal;
    } else if self.Tok.is(l_paren) {
        TheInitKind = CXXDirect;
    } else if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) && (!self.CurParsedObjCImpl || !D.isFunctionDeclarator()) {
        TheInitKind = CXXBraced;
    } else {
        TheInitKind = Uninitialized;
    }
    if TheInitKind != Uninitialized {
        D.setHasInitializer(true);
    }
    let mut ThisDecl: *mut Decl = null;
    let mut OuterDecl: *mut Decl = null;
    match TemplateInfo.Kind {
        NonTemplate => {
            ThisDecl = self.Actions.ActOnDeclarator(self.getCurScope(), D);
        },
        Template => {
            ExplicitSpecialization;
        },
        ExplicitInstantiation => {
            if self.Tok.is(semi) {
                let mut ThisRes: DeclResult = self.Actions.ActOnExplicitInstantiation(self.getCurScope(), TemplateInfo.ExternLoc, TemplateInfo.TemplateLoc, D);
                if ThisRes.isInvalid() {
                    self.SkipUntil(semi, StopBeforeMatch);
                    return null;
                }
                ThisDecl = ThisRes.get();
            } else {
                if D.getName().getKind() != IK_TemplateId {
                    self.Diag(self.Tok, err_template_defn_explicit_instantiation) << 2 << CreateRemoval(TemplateInfo.TemplateLoc);
                    ThisDecl = self.Actions.ActOnDeclarator(self.getCurScope(), D);
                } else {
                    let mut LAngleLoc: SourceLocation = self.PP.getLocForEndOfToken(TemplateInfo.TemplateLoc, 0);
                    self.Diag(D.getIdentifierLoc(), err_explicit_instantiation_with_definition) << TemplateInfo.TemplateLoc << CreateInsertion(LAngleLoc, "<>", false);
                    let mut FakedParamLists: TemplateParameterLists = TemplateParameterLists {};
                    FakedParamLists.push(self.Actions.ActOnTemplateParameterList(0, SourceLocation {}, TemplateInfo.TemplateLoc, LAngleLoc, ArrayRef<NamedDecl *> {}, LAngleLoc, null));
                    ThisDecl = self.Actions.ActOnTemplateDeclarator(self.getCurScope(), FakedParamLists, D);
                }
            }
            break;
        },
    }
    let mut X: CUDATargetContextRAII = CUDATargetContextRAII { self.Actions.CUDA(), CTCK_InitGlobalVar, ThisDecl };
    match TheInitKind {
        Equal => {
            let mut EqualLoc: SourceLocation = self.ConsumeToken();
            if self.Tok.is(kw_delete) {
                if D.isFunctionDeclarator() {
                    self.Diag(self.ConsumeToken(), err_default_delete_in_multiple_declaration) << 1;
                } else {
                    self.Diag(self.ConsumeToken(), err_deleted_non_function);
                }
                self.SkipDeletedFunctionBody();
            } else if self.Tok.is(kw_default) {
                if D.isFunctionDeclarator() {
                    self.Diag(self.ConsumeToken(), err_default_delete_in_multiple_declaration) << 0;
                } else {
                    self.Diag(self.ConsumeToken(), err_default_special_members) << self.getLangOpts().CPlusPlus20;
                }
            } else {
                let mut InitScope: InitializerScopeRAII = InitializerScopeRAII { *self, D, ThisDecl };
                if self.Tok.is(code_completion) {
                    self.cutOffParsing();
                    self.Actions.CodeCompletion().CodeCompleteInitializer(self.getCurScope(), ThisDecl);
                    self.Actions.FinalizeDeclaration(ThisDecl);
                    return null;
                }
                self.PreferredType.enterVariableInit(self.Tok.getLocation(), ThisDecl);
                let mut Init: ExprResult = self.ParseInitializer(ThisDecl);
                if self.Tok.is(r_paren) && FRI && D.isFirstDeclarator() {
                    self.Diag(EqualLoc, err_single_decl_assign_in_for_range) << CreateReplacement(EqualLoc, ":");
                    FRI.ColonLoc = EqualLoc;
                    Init = ExprError();
                    FRI.RangeExpr = Init;
                }
                if Init.isInvalid() {
                    let mut StopTokens: TokenKind, 2> = TokenKind, 2> {};
                    StopTokens.push(comma);
                    if D.getContext() == ForInit || D.getContext() == SelectionInit {
                        StopTokens.push(r_paren);
                    }
                    self.SkipUntil(StopTokens, StopAtSemi | StopBeforeMatch);
                    self.Actions.ActOnInitializerError(ThisDecl);
                } else {
                    self.Actions.AddInitializerToDecl(ThisDecl, Init.get(), false);
                }
            }
            break;
        },
        CXXDirect => {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
            T.consumeOpen();
            let mut Exprs: ExprVector = ExprVector {};
            let mut InitScope: InitializerScopeRAII = InitializerScopeRAII { *self, D, ThisDecl };
            let mut ThisVarDecl: CastReturnType = dyn_cast_or_null(ThisDecl);
            let mut RunSignatureHelp: Closure_2 = Closure_2 { cap_0: self, ThisVarDecl: &mut ThisVarDecl, ThisDecl: &mut ThisDecl, Exprs: &mut Exprs, T: &mut T };
            let mut SetPreferredType: Closure_3 = Closure_3 { cap_0: self, RunSignatureHelp: &mut RunSignatureHelp };
            let mut ExpressionStarts: function_ref<void ()> = function_ref<void ()> {};
            if ThisVarDecl {
                ExpressionStarts = function_ref<void ()> { SetPreferredType, null, null };
            }
            let mut SawError: bool = self.ParseExpressionList(Exprs, ExpressionStarts, false, false);
            if SawError {
                if ThisVarDecl && self.PP.isCodeCompletionReached() && !self.CalledSignatureHelp {
                    self.Actions.CodeCompletion().ProduceConstructorSignatureHelp(operator(ThisVarDecl.getType()).getCanonicalTypeInternal(), ThisDecl.getLocation(), Exprs, T.getOpenLocation(), false);
                    self.CalledSignatureHelp = true;
                }
                self.Actions.ActOnInitializerError(ThisDecl);
                self.SkipUntil(r_paren, StopAtSemi);
            } else {
                T.consumeClose();
                let mut Initializer: ExprResult = self.Actions.ActOnParenListExpr(T.getOpenLocation(), T.getCloseLocation(), Exprs);
                self.Actions.AddInitializerToDecl(ThisDecl, Initializer.get(), true);
            }
            break;
        },
        CXXBraced => {
            self.Diag(self.Tok, compat_cxx11_generalized_initializer_lists);
            let mut InitScope: InitializerScopeRAII = InitializerScopeRAII { *self, D, ThisDecl };
            self.PreferredType.enterVariableInit(self.Tok.getLocation(), ThisDecl);
            let mut Init: ExprResult = self.ParseBraceInitializer();
            if Init.isInvalid() {
                self.Actions.ActOnInitializerError(ThisDecl);
            } else {
                self.Actions.AddInitializerToDecl(ThisDecl, Init.get(), true);
            }
            break;
        },
        Uninitialized => {
            let mut InitScope: InitializerScopeRAII = InitializerScopeRAII { *self, D, ThisDecl };
            self.Actions.ActOnUninitializedDecl(ThisDecl);
            break;
        },
    }
    self.Actions.FinalizeDeclaration(ThisDecl);
    return if OuterDecl { OuterDecl } else { ThisDecl };
}

fn Parser::ParseSpecifierQualifierList(self, DS: *mut DeclSpec, AllowImplicitTypename: ImplicitTypenameContext, AS: AccessSpecifier, DSC: DeclSpecContext) {
    let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
    self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS, DSC, null, AllowImplicitTypename);
    let mut Specs: u32 = DS.getParsedSpecifiers();
    if isTypeSpecifier(DSC) && !DS.hasTypeSpecifier() {
        self.Diag(self.Tok, err_expected_type);
        DS.SetTypeSpecError();
    } else if Specs == PQ_None && !DS.hasAttributes() {
        self.Diag(self.Tok, err_typename_requires_specqual);
        if !DS.hasTypeSpecifier() {
            DS.SetTypeSpecError();
        }
    }
    if Specs & PQ_StorageClassSpecifier {
        if DS.getStorageClassSpecLoc().isValid() {
            self.Diag(DS.getStorageClassSpecLoc(), err_typename_invalid_storageclass);
        } else {
            self.Diag(DS.getThreadStorageClassSpecLoc(), err_typename_invalid_storageclass);
        }
        DS.ClearStorageClassSpecs();
    }
    if Specs & PQ_FunctionSpecifier {
        if DS.isInlineSpecified() {
            self.Diag(DS.getInlineSpecLoc(), err_typename_invalid_functionspec);
        }
        if DS.isVirtualSpecified() {
            self.Diag(DS.getVirtualSpecLoc(), err_typename_invalid_functionspec);
        }
        if DS.hasExplicitSpecifier() {
            self.Diag(DS.getExplicitSpecLoc(), err_typename_invalid_functionspec);
        }
        if DS.isNoreturnSpecified() {
            self.Diag(DS.getNoreturnSpecLoc(), err_typename_invalid_functionspec);
        }
        DS.ClearFunctionSpecs();
    }
    if DS.hasConstexprSpecifier() && DSC != DSC_condition {
        self.Diag(DS.getConstexprSpecLoc(), err_typename_invalid_constexpr) << DS.getConstexprSpecifier() as i32;
        DS.ClearConstexprSpec();
    }
}

fn isValidAfterIdentifierInDeclarator(T: *Token) -> bool {
    return T.isOneOf(l_square, l_paren, r_paren, semi, comma, equal, kw_asm, l_brace, colon);
}

fn Parser::ParseImplicitInt(self, DS: *mut DeclSpec, SS: *mut CXXScopeSpec, TemplateInfo: *mut ParsedTemplateInfo, AS: AccessSpecifier, DSC: DeclSpecContext, Attrs: *mut ParsedAttributes) -> bool {
    assert!(self.Tok.is(identifier), "should have identifier");
    let mut Loc: SourceLocation = self.Tok.getLocation();
    assert!(!DS.hasTypeSpecifier(), "Type specifier checked above");
    if !isTypeSpecifier(DSC) && self.getLangOpts().isImplicitIntAllowed() && isValidAfterIdentifierInDeclarator(self.NextToken()) {
        return false;
    }
    if self.getLangOpts().OpenCLCPlusPlus && DS.isTypeSpecPipe() {
        return false;
    }
    if self.getLangOpts().CPlusPlus && DS.getStorageClassSpec() == SCS_auto {
        if SS {
            self.AnnotateScopeToken(*SS, false);
        }
        return false;
    }
    if self.getLangOpts().CPlusPlus && (!SS || SS.isEmpty()) && self.getLangOpts().MSVCCompat {
        if self.Actions.ActOnMSVCUnknownTypeName(*self.Tok.getIdentifierInfo(), self.Tok.getLocation(), DSC == DSC_template_type_arg) {
            T;
        } else {
            let mut PrevSpec: *u8 = null;
            let mut DiagID: u32 = 0;
            DS.SetTypeSpecType(TST_typename, Loc, PrevSpec, DiagID, T, self.Actions.getASTContext().getPrintingPolicy());
            DS.SetRangeEnd(self.Tok.getLocation());
            self.ConsumeToken();
            return false;
        }
    }
    if SS == null {
        let mut TagName: *u8 = null;
        let mut FixitTagName: *u8 = null;
        let mut TagKind: TokenKind = unknown;
        match self.Actions.isTagName(*self.Tok.getIdentifierInfo(), self.getCurScope()) {
            _ => {
                break;
            },
            TST_enum => {
                TagName = "enum";
            },
            TST_union => {
                TagName = "union";
            },
            TST_struct => {
                TagName = "struct";
            },
            TST_interface => {
                TagName = "__interface";
            },
            TST_class => {
                TagName = "class";
            },
        }
        if TagName {
            let mut TokenName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            let mut R: LookupResult = LookupResult { self.Actions, TokenName, SourceLocation {}, LookupOrdinaryName, NotForRedeclaration };
            self.Diag(Loc, err_use_of_tag_name_without_tag) << TokenName << TagName << self.getLangOpts().CPlusPlus << CreateInsertion(self.Tok.getLocation(), FixitTagName, false);
            if self.Actions.LookupName(R, self.getCurScope(), false, false) {
                for let mut I: iterator = R.begin();
let mut IEnd: iterator = R.end(); !I == IEnd; operator(I) {
                    self.Diag((operator(I)).getLocation(), note_decl_hiding_tag_type) << TokenName << TagName;
                }
            }
            if TagKind == kw_enum {
                self.ParseEnumSpecifier(Loc, DS, TemplateInfo, AS, DSC_normal);
            } else {
                self.ParseClassSpecifier(TagKind, Loc, DS, TemplateInfo, AS, false, DSC_normal, Attrs);
            }
            return true;
        }
    }
    if !isTypeSpecifier(DSC) && (!SS || DSC == DSC_top_level || DSC == DSC_class) {
        match self.NextToken().getKind() {
            l_paren => {
                let mut PA: TentativeParsingAction = TentativeParsingAction { *self, false };
                self.ConsumeToken();
                let mut TPR: TPResult = self.TryParseDeclarator(false, true, false, false);
                PA.Revert();
                if TPR != False {
                    break;
                }
                if DSC == DSC_class || (DSC == DSC_top_level && SS) {
                    let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
                    if self.Actions.isCurrentClassNameTypo(II, SS) {
                        self.Diag(Loc, err_constructor_bad_name) << self.Tok.getIdentifierInfo() << II << CreateReplacement(self.Tok.getLocation(), II.getName());
                        self.Tok.setIdentifierInfo(II);
                    }
                }
            },
            comma => {
                equal;
            },
            _ => {
                break;
            },
        }
    }
    let mut T: ParsedType = null;
    let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut IsTemplateName: bool = self.getLangOpts().CPlusPlus && self.NextToken().is(less);
    self.Actions.DiagnoseUnknownTypeName(II, Loc, self.getCurScope(), SS, T, IsTemplateName);
    if T {
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        DS.SetTypeSpecType(TST_typename, Loc, PrevSpec, DiagID, T, self.Actions.getASTContext().getPrintingPolicy());
        DS.SetRangeEnd(self.Tok.getLocation());
        self.ConsumeToken();
        return true;
    } else if II != self.Tok.getIdentifierInfo() {
        self.Tok.setKind(II.getTokenID());
        return true;
    }
    DS.SetTypeSpecError();
    DS.SetRangeEnd(self.Tok.getLocation());
    self.ConsumeToken();
    if IsTemplateName {
        let mut LAngle: SourceLocation = SourceLocation {};
        let mut RAngle: SourceLocation = SourceLocation {};
        let mut Args: TemplateArgList = TemplateArgList {};
        self.ParseTemplateIdAfterTemplateName(true, LAngle, Args, RAngle, null);
    }
    return true;
}

fn Parser::getDeclSpecContextFromDeclaratorContext(self, Context: DeclaratorContext) -> DeclSpecContext {
    match Context {
        Member => {
            return DSC_class;
        },
        File => {
            return DSC_top_level;
        },
        TemplateParam => {
            return DSC_template_param;
        },
        TemplateArg => {
            return DSC_template_arg;
        },
        TemplateTypeArg => {
            return DSC_template_type_arg;
        },
        TrailingReturn => {
            TrailingReturnVar;
        },
        AliasDecl => {
            AliasTemplate;
        },
        Association => {
            return DSC_association;
        },
        TypeName => {
            return DSC_type_specifier;
        },
        Condition => {
            return DSC_condition;
        },
        ConversionId => {
            return DSC_conv_operator;
        },
        CXXNew => {
            return DSC_new;
        },
        Prototype => {
            ObjCResult;
        },
    }
    llvm_unreachable_internal("Missing DeclaratorContext case", "P:/Goraw/llvm-project/clang/lib/Parse/ParseDecl.cpp", 3102);
}

fn Parser::ParseAlignArgument(self, KWName: str, Start: SourceLocation, EllipsisLoc: *mut SourceLocation, IsType: *mut bool, TypeResult: *mut ParsedType) -> ExprResult {
    let mut ER: ExprResult = false;
    if self.isTypeIdInParens() {
        let mut TypeLoc: SourceLocation = self.Tok.getLocation();
        let mut Ty: ParsedType = self.ParseTypeName(null, TypeName, AS_none, null, null).get();
        let mut TypeRange: SourceRange = SourceRange { B: Start, E: self.Tok.getLocation() };
        if self.Actions.ActOnAlignasTypeArgument(KWName, Ty, TypeLoc, TypeRange) {
            return ExprError();
        }
        TypeResult = Ty;
        IsType = true;
    } else {
        ER = self.ParseConstantExpression();
        IsType = false;
    }
    if self.getLangOpts().CPlusPlus11 {
        self.TryConsumeToken(ellipsis, EllipsisLoc);
    }
    return ER;
}

fn Parser::ParseAlignmentSpecifier(self, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation) {
    assert!(self.Tok.isOneOf(kw_alignas, kw__Alignas), "Not an alignment-specifier!");
    let mut KWTok: Token = self.Tok;
    let mut KWName: *mut IdentifierInfo = KWTok.getIdentifierInfo();
    let mut Kind: TokenKind = KWTok.getKind();
    let mut KWLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected, "", unknown) {
        return;
    }
    let mut IsType: bool = false;
    let mut TypeResult: ParsedType = null;
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    let mut ArgExpr: ExprResult = self.ParseAlignArgument(self.PP.getSpelling(KWTok, null), T.getOpenLocation(), EllipsisLoc, IsType, TypeResult);
    if ArgExpr.isInvalid() {
        T.skipToEnd();
        return;
    }
    T.consumeClose();
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
    if IsType {
        Attrs.addNewTypeAttr(KWName, KWLoc, AttributeScopeInfo {}, TypeResult, Kind, EllipsisLoc);
    } else {
        let mut ArgExprs: ArgsVector = ArgsVector {};
        ArgExprs.push(ArgExpr.get());
        Attrs.addNew(KWName, KWLoc, AttributeScopeInfo {}, ArgExprs.ptr, 1, Kind, EllipsisLoc);
    }
}

fn Parser::DistributeCLateParsedAttrs(self, Dcl: *mut Decl, LateAttrs: *mut LateParsedAttrList) {
    if !LateAttrs {
        return;
    }
    if Dcl {
        for LateAttr in *LateAttrs {
            if LateAttr.Decls.is_empty() {
                LateAttr.addDecl(Dcl);
            }
        }
    }
}

fn Parser::ParsePtrauthQualifier(self, Attrs: *mut ParsedAttributes) {
    assert!(self.Tok.is(kw___ptrauth);
    let mut KwName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut KwLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected, "", unknown) {
        return;
    }
    let mut ArgExprs: ArgsVector = ArgsVector {};
    while true {
        {
        let mut ER: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
        if ER.isInvalid() {
            T.skipToEnd();
            return;
        }
        ArgExprs.push(ER.get());
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    T.consumeClose();
    let mut EndLoc: SourceLocation = T.getCloseLocation();
    if ArgExprs.is_empty() || ArgExprs.len > 3 {
        self.Diag(KwLoc, err_ptrauth_qualifier_bad_arg_count);
        return;
    }
    Attrs.addNew(KwName, SourceRange { B: KwLoc, E: EndLoc }, AttributeScopeInfo {}, ArgExprs.ptr, ArgExprs.len, Keyword(false, false), SourceLocation {});
}

fn Parser::ParseBoundsAttribute(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    assert!(self.Tok.is(l_paren), "Attribute arg list not starting with '('");
    let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    Parens.consumeOpen();
    if self.Tok.is(r_paren) {
        self.Diag(self.Tok.getLocation(), err_argument_required_after_attribute);
        Parens.consumeClose();
        return;
    }
    let mut ArgExprs: ArgsVector = ArgsVector {};
    let mut EC: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, PotentiallyEvaluated, null, EK_AttrArgument, true };
    let mut ArgExpr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
    if ArgExpr.isInvalid() {
        Parens.skipToEnd();
        return;
    }
    ArgExprs.push(ArgExpr.get());
    Parens.consumeClose();
    let mut Ctx: *mut ASTContext = self.Actions.getASTContext();
    ArgExprs.push(Create(Ctx, APInt { Ctx.getTypeSize(Ctx.getSizeType()), 0, false, false }, Ctx.getSizeType(), SourceLocation {}));
    Attrs.addNew(&mut AttrName, SourceRange { B: AttrNameLoc, E: Parens.getCloseLocation() }, AttributeScopeInfo {}, ArgExprs.ptr, ArgExprs.len, Form, SourceLocation {});
}

fn Parser::ParseExtIntegerArgument(self) -> ExprResult {
    assert!(self.Tok.isOneOf(kw__ExtInt, kw__BitInt), "Not an extended int type");
    self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected, "", unknown) {
        return ExprError();
    }
    let mut ER: ExprResult = self.ParseConstantExpression();
    if ER.isInvalid() {
        T.skipToEnd();
        return ExprError();
    }
    if T.consumeClose() {
        return ExprError();
    }
    return ER;
}

fn Parser::DiagnoseMissingSemiAfterTagDefinition(self, DS: *mut DeclSpec, AS: AccessSpecifier, DSContext: DeclSpecContext, LateAttrs: *mut LateParsedAttrList) -> bool {
    assert!(DS.hasTagDefinition(), "shouldn't call this");
    let mut EnteringContext: bool = (DSContext == DSC_class || DSContext == DSC_top_level);
    if self.getLangOpts().CPlusPlus && (self.Tok.isOneOf(identifier, coloncolon, kw_decltype) || (self.Tok.is(annot_template_id) && self.NextToken().is(coloncolon))) && self.TryAnnotateCXXScopeToken(EnteringContext) {
        self.SkipMalformedDecl();
        return true;
    }
    let mut HasScope: bool = self.Tok.is(annot_cxxscope);
    let mut AfterScope: Token = if HasScope { self.NextToken() } else { self.Tok };
    let mut MightBeDeclarator: bool = true;
    if self.Tok.isOneOf(kw_typename, annot_typename) {
        MightBeDeclarator = false;
    } else if AfterScope.is(annot_template_id) {
        let mut Annot: *mut TemplateIdAnnotation = AfterScope.getAnnotationValue() as *mut TemplateIdAnnotation;
        if Annot.Kind == TNK_Type_template {
            MightBeDeclarator = false;
        }
    } else if AfterScope.is(identifier) {
        let mut Next: *Token = if HasScope { self.GetLookAheadToken(2) } else { self.NextToken() };
        if Next.isOneOf(star, amp, ampamp, identifier, annot_cxxscope, coloncolon) {
            MightBeDeclarator = false;
        } else if HasScope {
            let mut SS: CXXScopeSpec = CXXScopeSpec {};
            self.Actions.RestoreNestedNameSpecifierAnnotation(self.Tok.getAnnotationValue(), self.Tok.getAnnotationRange(), SS);
            let mut Name: *mut IdentifierInfo = AfterScope.getIdentifierInfo();
            let mut Classification: NameClassification = self.Actions.ClassifyName(self.getCurScope(), SS, Name, AfterScope.getLocation(), Next, null);
            match Classification.getKind() {
                Error => {
                    self.SkipMalformedDecl();
                },
                Keyword => {
                    llvm_unreachable_internal("typo correction is not possible here", "P:/Goraw/llvm-project/clang/lib/Parse/ParseDecl.cpp", 3338);
                },
                Type => {
                    TypeTemplate;
                },
                Unknown => {
                    NonType;
                },
            }
        }
    }
    if MightBeDeclarator {
        return false;
    }
    let mut PPol: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
    self.Diag(self.PP.getLocForEndOfToken(DS.getRepAsDecl().getEndLoc(), 0), err_expected_after) << getSpecifierName(DS.getTypeSpecType(), PPol) << semi;
    DS.ClearTypeSpecType();
    let mut NotATemplate: ParsedTemplateInfo = ParsedTemplateInfo {};
    self.ParseDeclarationSpecifiers(DS, NotATemplate, AS, DSContext, LateAttrs);
    return false;
}

fn Parser::ParseDeclarationSpecifiers(self, DS: *mut DeclSpec, TemplateInfo: *mut ParsedTemplateInfo, AS: AccessSpecifier, DSContext: DeclSpecContext, LateAttrs: *mut LateParsedAttrList, AllowImplicitTypename: ImplicitTypenameContext) {
    if DS.getSourceRange().isInvalid() {
        DS.SetRangeStart(self.Tok.getLocation());
        DS.SetRangeEnd(SourceLocation {});
    }
    if DSContext == DSC_conv_operator {
        DSContext = DSC_type_specifier;
    }
    let mut EnteringContext: bool = (DSContext == DSC_class || DSContext == DSC_top_level);
    let mut AttrsLastTime: bool = false;
    let mut attrs: ParsedAttributes = self.AttrFactory;
    let mut Policy: PrintingPolicy = self.Actions.getPrintingPolicy();
    while true {
        let mut isInvalid: bool = false;
        let mut isStorageClass: bool = false;
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        let mut ConsumedEnd: SourceLocation = SourceLocation {};
        if self.getLangOpts().MSVCCompat && self.Tok.is(kw__Atomic) && DS.getStorageClassSpec() == SCS_typedef && !DS.hasTypeSpecifier() && self.GetLookAheadToken(1).is(less) {
            self.Tok.setKind(identifier);
        }
        let mut Loc: SourceLocation = self.Tok.getLocation();
        let mut handleOpenCLImageKW: Closure_4 = Closure_4 { cap_0: self, isInvalid: &mut isInvalid, DS: &mut DS, Loc: &mut Loc, PrevSpec: &mut PrevSpec, DiagID: &mut DiagID, Policy: &mut Policy };
        let mut IsTemplateSpecOrInst: bool = (TemplateInfo.Kind == ExplicitInstantiation || TemplateInfo.Kind == ExplicitSpecialization);
        match self.Tok.getKind() {
            _ => {
                if self.Tok.isRegularKeywordAttribute() {
                    
                }
            },
            kw__Alignas => {
                self.diagnoseUseOfC11Keyword(self.Tok);
            },
            kw_alignas => {
                if self.getLangOpts().C23 || self.Tok.getKind() == kw__Alignas {
                    if self.Tok.getKind() == kw_alignas {
                        self.Diag(self.Tok, warn_c23_compat_keyword) << self.Tok.getName();
                    }
                    self.ParseAlignmentSpecifier(DS.getAttributes(), null);
                    continue;
                }
            },
            l_square => {
                if !self.isAllowedCXX11AttributeSpecifier(false, false) {
                    
                }
            },
            code_completion => {
                let mut CCC: ParserCompletionContext = PCC_Namespace;
                if DS.hasTypeSpecifier() {
                    let mut AllowNonIdentifiers: bool = (self.getCurScope().getFlags() & (ControlScope | BlockScope | TemplateParamScope | FunctionPrototypeScope | AtCatchScope)) == 0;
                    let mut AllowNestedNameSpecifiers: bool = DSContext == DSC_top_level || (DSContext == DSC_class && DS.isFriendSpecified());
                    self.cutOffParsing();
                    self.Actions.CodeCompletion().CodeCompleteDeclSpec(self.getCurScope(), DS, AllowNonIdentifiers, AllowNestedNameSpecifiers);
                    return;
                }
                if TemplateInfo.Kind != NonTemplate {
                    CCC = if DSContext == DSC_class { PCC_MemberTemplate } else { PCC_Template };
                } else if DSContext == DSC_class {
                    CCC = PCC_Class;
                } else if self.getCurScope().getFnParent() || self.getCurScope().getBlockParent() {
                    CCC = PCC_LocalDeclarationSpecifiers;
                } else if self.CurParsedObjCImpl {
                    CCC = PCC_ObjCImplementation;
                }
                self.cutOffParsing();
                self.Actions.CodeCompletion().CodeCompleteOrdinaryName(self.getCurScope(), CCC);
                return;
            },
            coloncolon => {
                if self.getLangOpts().CPlusPlus && self.TryAnnotateCXXScopeToken(EnteringContext) {
                    if !DS.hasTypeSpecifier() {
                        DS.SetTypeSpecError();
                    }
                }
            },
            annot_cxxscope => {
                if DS.hasTypeSpecifier() || DS.isTypeAltiVecVector() {
                    
                }
                let mut SS: CXXScopeSpec = CXXScopeSpec {};
                if TemplateInfo.TemplateParams {
                    SS.setTemplateParamLists(*TemplateInfo.TemplateParams);
                }
                self.Actions.RestoreNestedNameSpecifierAnnotation(self.Tok.getAnnotationValue(), self.Tok.getAnnotationRange(), SS);
                let mut Next: Token = self.NextToken();
                let mut TemplateId: *mut TemplateIdAnnotation = if Next.is(annot_template_id) { self.takeTemplateIdAnnotation(Next) } else { null };
                if TemplateId && TemplateId.hasInvalidName() {
                    DS.SetTypeSpecError();
                    self.ConsumeAnnotationToken();
                    break;
                }
                if TemplateId && TemplateId.Kind == TNK_Type_template {
                    if (DSContext == DSC_top_level || DSContext == DSC_class) && TemplateId.Name && self.Actions.isCurrentClassName(*TemplateId.Name, self.getCurScope(), &mut SS) && self.isConstructorDeclarator(false, false, DS.isFriendSpecified(), null) {}
                    DS.getTypeSpecScope() = SS;
                    self.ConsumeAnnotationToken();
                    assert!(self.Tok.is(annot_template_id), "ParseOptionalCXXScopeSpecifier not working");
                    self.AnnotateTemplateIdTokenAsType(SS, AllowImplicitTypename, false);
                    continue;
                }
                if TemplateId && TemplateId.Kind == TNK_Concept_template {
                    DS.getTypeSpecScope() = SS;
                    self.ConsumeAnnotationToken();
                    continue;
                }
                if Next.is(annot_typename) {
                    DS.getTypeSpecScope() = SS;
                    self.ConsumeAnnotationToken();
                    let mut T: TypeResult = getTypeAnnotation(self.Tok);
                    isInvalid = DS.SetTypeSpecType(TST_typename, self.Tok.getAnnotationEndLoc(), PrevSpec, DiagID, T, Policy);
                    if isInvalid {
                        break;
                    }
                    DS.SetRangeEnd(self.Tok.getAnnotationEndLoc());
                    self.ConsumeAnnotationToken();
                }
                if AllowImplicitTypename == Yes && Next.is(annot_template_id) && Next.getAnnotationValue() as *mut TemplateIdAnnotation.Kind == TNK_Dependent_template_name {
                    DS.getTypeSpecScope() = SS;
                    self.ConsumeAnnotationToken();
                    self.AnnotateTemplateIdTokenAsType(SS, AllowImplicitTypename, false);
                    continue;
                }
                if Next.isNot(identifier) {
                    
                }
                if (DSContext == DSC_top_level || DSContext == DSC_class) && self.Actions.isCurrentClassName(*Next.getIdentifierInfo(), self.getCurScope(), &mut SS) && self.isConstructorDeclarator(false, false, DS.isFriendSpecified(), &mut TemplateInfo) {
                    
                }
                let mut SAC: SuppressAccessChecks = SuppressAccessChecks { *self, IsTemplateSpecOrInst };
                let mut TypeRep: ParsedType = self.Actions.getTypeName(*Next.getIdentifierInfo(), Next.getLocation(), self.getCurScope(), &mut SS, false, false, null, false, true, isClassTemplateDeductionContext(DSContext), AllowImplicitTypename, null);
                if IsTemplateSpecOrInst {
                    SAC.done();
                }
                if !TypeRep {
                    if self.TryAnnotateTypeConstraint() {
                        
                    }
                    if self.Tok.isNot(annot_cxxscope) || self.NextToken().isNot(identifier) {
                        continue;
                    }
                    self.ConsumeAnnotationToken();
                    let mut Attrs: ParsedAttributes = self.AttrFactory;
                    if self.ParseImplicitInt(DS, &mut SS, TemplateInfo, AS, DSContext, Attrs) {
                        if !Attrs.is_empty() {
                            AttrsLastTime = true;
                            attrs.takeAllAppendingFrom(Attrs);
                        }
                        continue;
                    }
                }
                DS.getTypeSpecScope() = SS;
                self.ConsumeAnnotationToken();
                isInvalid = DS.SetTypeSpecType(TST_typename, Loc, PrevSpec, DiagID, TypeRep, Policy);
                if isInvalid {
                    break;
                }
                DS.SetRangeEnd(self.Tok.getLocation());
                self.ConsumeToken();
                continue;
            },
            annot_typename => {
                if DS.hasTypeSpecifier() && DS.hasTagDefinition() {
                    
                }
                let mut T: TypeResult = getTypeAnnotation(self.Tok);
                isInvalid = DS.SetTypeSpecType(TST_typename, Loc, PrevSpec, DiagID, T, Policy);
                if isInvalid {
                    break;
                }
                DS.SetRangeEnd(self.Tok.getAnnotationEndLoc());
                self.ConsumeAnnotationToken();
                continue;
            },
            kw___is_signed => {
                if DS.getTypeSpecType() == TST_bool && DS.getTypeQualifiers() == TQ_const && DS.getStorageClassSpec() == SCS_static {
                    self.TryKeywordIdentFallback(true);
                }
            },
            kw___super => {
                kw_decltype;
            },
            annot_template_id => {
                let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
                if TemplateId.hasInvalidName() {
                    DS.SetTypeSpecError();
                    break;
                }
                if TemplateId.Kind == TNK_Concept_template {
                    if TemplateId.hasInvalidArgs() {
                        TemplateId = null;
                    }
                    if self.NextToken().isOneOf(identifier, kw_const, kw_volatile, kw_restrict, amp, ampamp) {
                        self.Diag(Loc, err_placeholder_expected_auto_or_decltype_auto) << CreateInsertion(self.NextToken().getLocation(), "auto", false);
                        isInvalid = DS.SetTypeSpecType(TST_auto, Loc, PrevSpec, DiagID, TemplateId, Policy);
                        break;
                    }
                    if !self.NextToken().isOneOf(kw_auto, kw_decltype) {
                        
                    }
                    if TemplateId && !isInvalid && self.Actions.CheckTypeConstraint(TemplateId) {
                        TemplateId = null;
                    }
                    self.ConsumeAnnotationToken();
                    let mut AutoLoc: SourceLocation = self.Tok.getLocation();
                    if self.TryConsumeToken(kw_decltype) {
                        let mut Tracker: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
                        if Tracker.consumeOpen() {
                            self.Diag(self.Tok, err_expected) << l_paren;
                        } else {
                            if !self.TryConsumeToken(kw_auto) {
                                Tracker.skipToEnd();
                                self.Diag(self.Tok, err_placeholder_expected_auto_or_decltype_auto) << CreateReplacement(SourceRange { B: AutoLoc, E: self.Tok.getLocation() }, "auto");
                            } else {
                                Tracker.consumeClose();
                            }
                        }
                        ConsumedEnd = self.Tok.getLocation();
                        DS.setTypeArgumentRange(Tracker.getRange());
                        isInvalid = DS.SetTypeSpecType(TST_decltype_auto, Loc, PrevSpec, DiagID, TemplateId, Policy);
                    } else {
                        isInvalid = DS.SetTypeSpecType(TST_auto, AutoLoc, PrevSpec, DiagID, TemplateId, Policy);
                    }
                    break;
                }
                if TemplateId.Kind != TNK_Type_template && TemplateId.Kind != TNK_Undeclared_template {}
                if self.getLangOpts().CPlusPlus && DSContext == DSC_class && self.Actions.isCurrentClassName(*TemplateId.Name, self.getCurScope(), null) && self.isConstructorDeclarator(true, false, DS.isFriendSpecified(), null) {
                    
                }
                let mut SS: CXXScopeSpec = CXXScopeSpec {};
                self.AnnotateTemplateIdTokenAsType(SS, AllowImplicitTypename, false);
                continue;
            },
            kw___attribute => {
                kw___declspec;
            },
            kw___forceinline => {
                isInvalid = DS.setFunctionSpecForceInline(Loc, PrevSpec, DiagID);
                let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
                let mut AttrNameLoc: SourceLocation = self.Tok.getLocation();
                DS.getAttributes().addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___forceinline, SourceLocation {});
                break;
            },
            kw___unaligned => {
                isInvalid = DS.SetTypeQual(TQ_unaligned, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw___ptrauth => {
                self.ParsePtrauthQualifier(DS.getAttributes());
            },
            kw___sptr => {
                kw___uptr;
            },
            kw___funcref => {
                self.ParseWebAssemblyFuncrefTypeAttribute(DS.getAttributes());
            },
            kw___pascal => {
                self.ParseBorlandTypeAttributes(DS.getAttributes());
            },
            kw___kernel => {
                self.ParseOpenCLKernelAttributes(DS.getAttributes());
            },
            kw___noinline__ => {
                self.ParseCUDAFunctionAttributes(DS.getAttributes());
            },
            kw__Nonnull => {
                kw__Nullable;
            },
            kw___kindof => {
                DS.getAttributes().addNew(self.Tok.getIdentifierInfo(), Loc, AttributeScopeInfo {}, null, 0, kw___kindof, SourceLocation {});
            },
            kw_typedef => {
                isInvalid = DS.SetStorageClassSpec(self.Actions, SCS_typedef, Loc, PrevSpec, DiagID, Policy);
            },
            kw_extern => {
                if DS.getThreadStorageClassSpec() == TSCS___thread {
                    self.Diag(self.Tok, ext_thread_before) << "extern";
                }
            },
            kw___private_extern__ => {
                isInvalid = DS.SetStorageClassSpec(self.Actions, SCS_private_extern, Loc, PrevSpec, DiagID, Policy);
            },
            kw_static => {
                if DS.getThreadStorageClassSpec() == TSCS___thread {
                    self.Diag(self.Tok, ext_thread_before) << "static";
                }
            },
            kw_auto => {
                if self.getLangOpts().CPlusPlus11 || self.getLangOpts().C23 {
                    let mut MayBeTypeSpecifier: Closure_5 = Closure_5 { cap_0: self, DS: &mut DS };
                    if MayBeTypeSpecifier.call() {
                        isInvalid = DS.SetStorageClassSpec(self.Actions, SCS_auto, Loc, PrevSpec, DiagID, Policy);
                        if !isInvalid && !self.getLangOpts().C23 {
                            self.Diag(self.Tok, ext_auto_storage_class) << CreateRemoval(DS.getStorageClassSpecLoc());
                        }
                    } else {
                        isInvalid = DS.SetTypeSpecType(TST_auto, Loc, PrevSpec, DiagID, Policy);
                    }
                } else {
                    isInvalid = DS.SetStorageClassSpec(self.Actions, SCS_auto, Loc, PrevSpec, DiagID, Policy);
                }
            },
            kw___auto_type => {
                self.Diag(self.Tok, ext_auto_type);
            },
            kw_register => {
                isInvalid = DS.SetStorageClassSpec(self.Actions, SCS_register, Loc, PrevSpec, DiagID, Policy);
            },
            kw_mutable => {
                isInvalid = DS.SetStorageClassSpec(self.Actions, SCS_mutable, Loc, PrevSpec, DiagID, Policy);
            },
            kw___thread => {
                isInvalid = DS.SetStorageClassSpecThread(TSCS___thread, Loc, PrevSpec, DiagID);
            },
            kw_thread_local => {
                if self.getLangOpts().C23 {
                    self.Diag(self.Tok, warn_c23_compat_keyword) << self.Tok.getName();
                }
            },
            kw__Thread_local => {
                self.diagnoseUseOfC11Keyword(self.Tok);
            },
            kw_inline => {
                isInvalid = DS.setFunctionSpecInline(Loc, PrevSpec, DiagID);
            },
            kw_virtual => {
                if self.getLangOpts().OpenCLCPlusPlus && !self.getActions().getOpenCLOptions().isAvailableOption("__cl_clang_function_pointers", self.getLangOpts()) {
                    DiagID = err_openclcxx_virtual_function;
                    PrevSpec = self.Tok.getIdentifierInfo().getNameStart();
                    isInvalid = true;
                } else if self.getLangOpts().HLSL {
                    DiagID = err_hlsl_virtual_function;
                    PrevSpec = self.Tok.getIdentifierInfo().getNameStart();
                    isInvalid = true;
                } else {
                    isInvalid = DS.setFunctionSpecVirtual(Loc, PrevSpec, DiagID);
                }
            },
            kw_explicit => {
                let mut ExplicitLoc: SourceLocation = Loc;
                let mut CloseParenLoc: SourceLocation = SourceLocation {};
                let mut ExplicitSpec: ExplicitSpecifier = ExplicitSpecifier { null, ResolvedTrue };
                ConsumedEnd = ExplicitLoc;
                self.ConsumeToken();
                if self.Tok.is(l_paren) {
                    if self.getLangOpts().CPlusPlus20 || self.isExplicitBool() == True {
                        self.DiagCompat(self.Tok.getLocation(), explicit_bool);
                        let mut ExplicitExpr: ExprResult = null as *mut Expr;
                        let mut Tracker: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
                        Tracker.consumeOpen();
                        let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
                        ExplicitExpr = self.ParseConstantExpressionInExprEvalContext(AllowNonTypes);
                        ConsumedEnd = self.Tok.getLocation();
                        if ExplicitExpr.isUsable() {
                            CloseParenLoc = self.Tok.getLocation();
                            Tracker.consumeClose();
                            ExplicitSpec = self.Actions.ActOnExplicitBoolSpecifier(ExplicitExpr.get());
                        } else {
                            Tracker.skipToEnd();
                        }
                    } else {
                        self.Diag(self.Tok.getLocation(), warn_cxx20_compat_explicit_bool);
                    }
                }
                isInvalid = DS.setFunctionSpecExplicit(ExplicitLoc, PrevSpec, DiagID, ExplicitSpec, CloseParenLoc);
                break;
            },
            kw__Noreturn => {
                self.diagnoseUseOfC11Keyword(self.Tok);
            },
            kw_friend => {
                if DSContext == DSC_class {
                    isInvalid = DS.SetFriendSpec(Loc, PrevSpec, DiagID);
                    let mut CurS: *mut Scope = self.getCurScope();
                    if !isInvalid && CurS {
                        CurS.setFlags(CurS.getFlags() | FriendScope);
                    }
                } else {
                    PrevSpec = "";
                    DiagID = err_friend_invalid_in_context;
                    isInvalid = true;
                }
            },
            kw___module_private__ => {
                isInvalid = DS.setModulePrivateSpec(Loc, PrevSpec, DiagID);
            },
            kw_constexpr => {
                if self.getLangOpts().C23 {
                    self.Diag(self.Tok, warn_c23_compat_keyword) << self.Tok.getName();
                }
            },
            kw_consteval => {
                isInvalid = DS.SetConstexprSpec(Consteval, Loc, PrevSpec, DiagID);
            },
            kw_constinit => {
                isInvalid = DS.SetConstexprSpec(Constinit, Loc, PrevSpec, DiagID);
            },
            kw_short => {
                if !self.getLangOpts().NativeInt16Type {
                    self.Diag(self.Tok, err_unknown_typename) << self.Tok.getName();
                    DS.SetTypeSpecError();
                    DS.SetRangeEnd(self.Tok.getLocation());
                    self.ConsumeToken();
                }
            },
            kw_long => {
                if DS.getTypeSpecWidth() != Long {
                    isInvalid = DS.SetTypeSpecWidth(Long, Loc, PrevSpec, DiagID, Policy);
                } else {
                    isInvalid = DS.SetTypeSpecWidth(LongLong, Loc, PrevSpec, DiagID, Policy);
                }
            },
            kw___int64 => {
                isInvalid = DS.SetTypeSpecWidth(LongLong, Loc, PrevSpec, DiagID, Policy);
            },
            kw_signed => {
                isInvalid = DS.SetTypeSpecSign(Signed, Loc, PrevSpec, DiagID);
            },
            kw_unsigned => {
                isInvalid = DS.SetTypeSpecSign(Unsigned, Loc, PrevSpec, DiagID);
            },
            kw__Complex => {
                if !self.getLangOpts().C99 {
                    self.Diag(self.Tok, ext_c99_feature) << self.Tok.getName();
                }
            },
            kw__Imaginary => {
                if !self.getLangOpts().C99 {
                    self.Diag(self.Tok, ext_c99_feature) << self.Tok.getName();
                }
            },
            kw_void => {
                isInvalid = DS.SetTypeSpecType(TST_void, Loc, PrevSpec, DiagID, Policy);
            },
            kw_char => {
                isInvalid = DS.SetTypeSpecType(TST_char, Loc, PrevSpec, DiagID, Policy);
            },
            kw_int => {
                isInvalid = DS.SetTypeSpecType(TST_int, Loc, PrevSpec, DiagID, Policy);
            },
            kw__ExtInt => {
                kw__BitInt;
            },
            kw___int128 => {
                isInvalid = DS.SetTypeSpecType(TST_int128, Loc, PrevSpec, DiagID, Policy);
            },
            kw_half => {
                isInvalid = DS.SetTypeSpecType(TST_half, Loc, PrevSpec, DiagID, Policy);
            },
            kw___bf16 => {
                isInvalid = DS.SetTypeSpecType(TST_BFloat16, Loc, PrevSpec, DiagID, Policy);
            },
            kw_float => {
                isInvalid = DS.SetTypeSpecType(TST_float, Loc, PrevSpec, DiagID, Policy);
            },
            kw_double => {
                isInvalid = DS.SetTypeSpecType(TST_double, Loc, PrevSpec, DiagID, Policy);
            },
            kw__Float16 => {
                isInvalid = DS.SetTypeSpecType(TST_float16, Loc, PrevSpec, DiagID, Policy);
            },
            kw__Accum => {
                assert!(self.getLangOpts().FixedPoint, "This keyword is only used when fixed point types are enabled with `-ffixed-point`");
            },
            kw__Fract => {
                assert!(self.getLangOpts().FixedPoint, "This keyword is only used when fixed point types are enabled with `-ffixed-point`");
            },
            kw__Sat => {
                assert!(self.getLangOpts().FixedPoint, "This keyword is only used when fixed point types are enabled with `-ffixed-point`");
            },
            kw___float128 => {
                isInvalid = DS.SetTypeSpecType(TST_float128, Loc, PrevSpec, DiagID, Policy);
            },
            kw___ibm128 => {
                isInvalid = DS.SetTypeSpecType(TST_ibm128, Loc, PrevSpec, DiagID, Policy);
            },
            kw_wchar_t => {
                isInvalid = DS.SetTypeSpecType(TST_wchar, Loc, PrevSpec, DiagID, Policy);
            },
            kw_char8_t => {
                isInvalid = DS.SetTypeSpecType(TST_char8, Loc, PrevSpec, DiagID, Policy);
            },
            kw_char16_t => {
                isInvalid = DS.SetTypeSpecType(TST_char16, Loc, PrevSpec, DiagID, Policy);
            },
            kw_char32_t => {
                isInvalid = DS.SetTypeSpecType(TST_char32, Loc, PrevSpec, DiagID, Policy);
            },
            kw_bool => {
                if self.getLangOpts().C23 {
                    self.Diag(self.Tok, warn_c23_compat_keyword) << self.Tok.getName();
                }
            },
            kw__Bool => {
                if self.Tok.is(kw__Bool) && !self.getLangOpts().C99 {
                    self.Diag(self.Tok, ext_c99_feature) << self.Tok.getName();
                }
            },
            kw__Decimal32 => {
                isInvalid = DS.SetTypeSpecType(TST_decimal32, Loc, PrevSpec, DiagID, Policy);
            },
            kw__Decimal64 => {
                isInvalid = DS.SetTypeSpecType(TST_decimal64, Loc, PrevSpec, DiagID, Policy);
            },
            kw__Decimal128 => {
                isInvalid = DS.SetTypeSpecType(TST_decimal128, Loc, PrevSpec, DiagID, Policy);
            },
            kw___vector => {
                isInvalid = DS.SetTypeAltiVecVector(true, Loc, PrevSpec, DiagID, Policy);
            },
            kw___pixel => {
                isInvalid = DS.SetTypeAltiVecPixel(true, Loc, PrevSpec, DiagID, Policy);
            },
            kw___bool => {
                isInvalid = DS.SetTypeAltiVecBool(true, Loc, PrevSpec, DiagID, Policy);
            },
            kw_pipe => {
                if !self.getLangOpts().OpenCL || self.getLangOpts().getOpenCLCompatibleVersion() < 200 {
                    self.Tok.getIdentifierInfo().revertTokenIDToIdentifier();
                    self.Tok.setKind(identifier);
                } else if !self.getLangOpts().OpenCLPipes {
                    DiagID = err_opencl_unknown_type_specifier;
                    PrevSpec = self.Tok.getIdentifierInfo().getNameStart();
                    isInvalid = true;
                } else {
                    isInvalid = DS.SetTypePipe(true, Loc, PrevSpec, DiagID, Policy);
                }
            },
            kw_image1d_t => {
                if !handleOpenCLImageKW.call("", TST_image1d_t) {
                    
                }
            },
            kw_image1d_array_t => {
                if !handleOpenCLImageKW.call("", TST_image1d_array_t) {
                    
                }
            },
            kw_image1d_buffer_t => {
                if !handleOpenCLImageKW.call("", TST_image1d_buffer_t) {
                    
                }
            },
            kw_image2d_t => {
                if !handleOpenCLImageKW.call("", TST_image2d_t) {
                    
                }
            },
            kw_image2d_array_t => {
                if !handleOpenCLImageKW.call("", TST_image2d_array_t) {
                    
                }
            },
            kw_image2d_depth_t => {
                if !handleOpenCLImageKW.call("", TST_image2d_depth_t) {
                    
                }
            },
            kw_image2d_array_depth_t => {
                if !handleOpenCLImageKW.call("", TST_image2d_array_depth_t) {
                    
                }
            },
            kw_image2d_msaa_t => {
                if !handleOpenCLImageKW.call("cl_khr_gl_msaa_sharing", TST_image2d_msaa_t) {
                    
                }
            },
            kw_image2d_array_msaa_t => {
                if !handleOpenCLImageKW.call("cl_khr_gl_msaa_sharing", TST_image2d_array_msaa_t) {
                    
                }
            },
            kw_image2d_msaa_depth_t => {
                if !handleOpenCLImageKW.call("cl_khr_gl_msaa_sharing", TST_image2d_msaa_depth_t) {
                    
                }
            },
            kw_image2d_array_msaa_depth_t => {
                if !handleOpenCLImageKW.call("cl_khr_gl_msaa_sharing", TST_image2d_array_msaa_depth_t) {
                    
                }
            },
            kw_image3d_t => {
                if !handleOpenCLImageKW.call("", TST_image3d_t) {
                    
                }
            },
            kw___unknown_anytype => {
                isInvalid = DS.SetTypeSpecType(TST_unknown_anytype, Loc, PrevSpec, DiagID, Policy);
            },
            kw_class => {
                kw_struct;
            },
            kw_enum => {
                self.ConsumeToken();
            },
            kw_const => {
                isInvalid = DS.SetTypeQual(TQ_const, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw_volatile => {
                isInvalid = DS.SetTypeQual(TQ_volatile, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw_restrict => {
                isInvalid = DS.SetTypeQual(TQ_restrict, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw___ob_wrap => {
                if !self.getLangOpts().OverflowBehaviorTypes {
                    self.Diag(Loc, warn_overflow_behavior_keyword_disabled) << getKeywordSpelling(self.Tok.getKind());
                    break;
                }
            },
            kw___ob_trap => {
                if !self.getLangOpts().OverflowBehaviorTypes {
                    self.Diag(Loc, warn_overflow_behavior_keyword_disabled) << getKeywordSpelling(self.Tok.getKind());
                    break;
                }
            },
            kw_typename => {
                if self.TryAnnotateTypeOrScopeToken(No, false) {
                    DS.SetTypeSpecError();
                }
            },
            kw_typeof => {
                kw_typeof_unqual;
            },
            annot_decltype => {
                self.ParseDecltypeSpecifier(DS);
            },
            annot_pack_indexing_type => {
                self.ParsePackIndexingType(DS);
            },
            annot_pragma_pack => {
                self.HandlePragmaPack();
            },
            annot_pragma_ms_pragma => {
                self.HandlePragmaMSPragma();
            },
            annot_pragma_ms_vtordisp => {
                self.HandlePragmaMSVtorDisp();
            },
            annot_pragma_ms_pointers_to_members => {
                self.HandlePragmaMSPointersToMembers();
            },
            annot_pragma_export => {
                self.HandlePragmaExport();
            },
            kw___add_lvalue_reference => {
                kw___add_pointer;
            },
            kw__Atomic => {
                self.diagnoseUseOfC11Keyword(self.Tok);
            },
            kw___generic => {
                if !self.Actions.getLangOpts().OpenCLGenericAddressSpace {
                    DiagID = err_opencl_unknown_type_specifier;
                    PrevSpec = self.Tok.getIdentifierInfo().getNameStart();
                    isInvalid = true;
                    break;
                }
            },
            kw_private => {
                if !self.getLangOpts().OpenCL {
                    
                }
            },
            kw___private => {
                kw___global;
            },
            kw_row_major => {
                kw_column_major;
            },
            kw___hlsl_resource_t => {
                isInvalid = DS.SetTypeSpecType(TST___hlsl_resource_t, Loc, PrevSpec, DiagID, Policy);
            },
            kw_int8_t4_packed => {
                isInvalid = DS.SetTypeSpecType(TST_int8_t4_packed, Loc, PrevSpec, DiagID, Policy);
            },
            kw_uint8_t4_packed => {
                isInvalid = DS.SetTypeSpecType(TST_uint8_t4_packed, Loc, PrevSpec, DiagID, Policy);
            },
            less => {
                if DS.hasTypeSpecifier() || !self.getLangOpts().ObjC {
                    
                }
            },
        }
        DS.SetRangeEnd(if ConsumedEnd.isValid() { ConsumedEnd } else { self.Tok.getLocation() });
        if isInvalid {
            assert!(PrevSpec, "Method did not return previous specifier!");
            assert!(DiagID);
            if DiagID == ext_duplicate_declspec || DiagID == ext_warn_duplicate_declspec || DiagID == err_duplicate_declspec {
                self.Diag(Loc, DiagID) << PrevSpec << CreateRemoval(SourceRange { B: Loc, E: DS.getEndLoc() });
            } else if DiagID == err_opencl_unknown_type_specifier {
                self.Diag(Loc, DiagID) << self.getLangOpts().getOpenCLVersionString() << PrevSpec << isStorageClass;
            } else {
                self.Diag(Loc, DiagID) << PrevSpec;
            }
        }
        if DiagID != err_bool_redeclaration && ConsumedEnd.isInvalid() {
            self.ConsumeAnyToken(false);
        }
        AttrsLastTime = false;
    }
}

fn DiagnoseCountAttributedTypeInUnnamedAnon(DS: *mut ParsingDeclSpec, P: *mut Parser) {
    if DS.getTypeSpecType() != TST_struct {
        return;
    }
    let mut RD: *mut RecordDecl = dyn_cast(DS.getRepAsDecl());
    if !RD || !RD.getName().is_empty() || RD.isAnonymousStructOrUnion() {
        return;
    }
    for I in RD.decls() {
        let mut VD: *mut ValueDecl = dyn_cast(I);
        if !VD {
            continue;
        }
        let mut CAT: *CountAttributedType = operator(VD.getType()).getAs();
        if !CAT {
            continue;
        }
        for DD in CAT.dependent_decls() {
            if !RD.containsDecl(DD.getDecl()) {
                P.Diag(VD.getBeginLoc(), err_count_attr_param_not_in_same_struct) << DD.getDecl() << CAT.getKind() << CAT.isArrayType();
                P.Diag(DD.getDecl().getBeginLoc(), note_flexible_array_counted_by_attr_field) << DD.getDecl();
            }
        }
    }
}

fn Parser::ParseStructDeclaration(self, DS: *mut ParsingDeclSpec, FieldsCallback: function_ref<Decl *(ParsingFieldDeclarator &)>, LateFieldAttrs: *mut LateParsedAttrList) {
    if self.Tok.is(kw___extension__) {
        let mut O: ExtensionRAIIObject = self.Diags;
        self.ConsumeToken();
        return self.ParseStructDeclaration(DS, FieldsCallback, LateFieldAttrs);
    }
    let mut Attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseCXX11Attributes(Attrs, false);
    self.ParseSpecifierQualifierList(DS, AS_none, DSC_normal);
    if self.Tok.is(semi) {
        self.ProhibitAttributes(Attrs, SourceLocation {});
        let mut AnonRecord: *mut RecordDecl = null;
        let mut TheDecl: *mut Decl = self.Actions.ParsedFreeStandingDeclSpec(self.getCurScope(), AS_none, DS, none(), AnonRecord);
        assert!(!AnonRecord, "Did not expect anonymous struct or union here");
        DS.complete(TheDecl);
        return;
    }
    let mut FirstDeclarator: bool = true;
    let mut CommaLoc: SourceLocation = SourceLocation {};
    while true {
        let mut DeclaratorInfo: ParsingFieldDeclarator = ParsingFieldDeclarator { D: *self, BitfieldSize: DS, ParsingRAII: Attrs };
        DeclaratorInfo.D.setCommaLoc(CommaLoc);
        if !FirstDeclarator {
            self.DiagnoseAndSkipCXX11Attributes();
            self.MaybeParseGNUAttributes(DeclaratorInfo.D, null);
            self.DiagnoseAndSkipCXX11Attributes();
        }
        if self.Tok.isNot(colon) {
            let mut X: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
            self.ParseDeclarator(DeclaratorInfo.D);
        } else {
            DeclaratorInfo.D.SetIdentifier(null, self.Tok.getLocation());
        }
        DiagnoseCountAttributedTypeInUnnamedAnon(DS, *self);
        if self.TryConsumeToken(colon) {
            let mut Res: ExprResult = self.ParseConstantExpression();
            if Res.isInvalid() {
                self.SkipUntil(semi, StopBeforeMatch);
            } else {
                DeclaratorInfo.BitfieldSize = Res.get();
            }
        }
        self.MaybeParseGNUAttributes(DeclaratorInfo.D, LateFieldAttrs);
        let mut Field: *mut Decl = FieldsCallback.call(DeclaratorInfo);
        if Field {
            self.DistributeCLateParsedAttrs(Field, LateFieldAttrs);
        }
        if !self.TryConsumeToken(comma, CommaLoc) {
            return;
        }
        FirstDeclarator = false;
    }
}

fn Parser::ParseLexedAttributeTokens(self, LPA: *mut LateParsedAttribute) -> ParsedAttributes {
    let mut AttrEnd: Token = Token {};
    AttrEnd.startToken();
    AttrEnd.setKind(eof);
    AttrEnd.setLocation(self.Tok.getLocation());
    AttrEnd.setEofData(LPA.Toks.ptr);
    LPA.Toks.push(AttrEnd);
    LPA.Toks.push(self.Tok);
    self.PP.EnterTokenStream(LPA.Toks, true, true);
    self.ConsumeAnyToken(true);
    let mut Attrs: ParsedAttributes = self.AttrFactory;
    self.ParseGNUAttributeArgs(&mut LPA.AttrName, LPA.AttrNameLoc, Attrs, null, null, SourceLocation {}, GNU(), null);
    while self.Tok.isNot(eof) {
        self.ConsumeAnyToken(false);
    }
    if self.Tok.is(eof) && self.Tok.getEofData() == AttrEnd.getEofData() {
        self.ConsumeAnyToken(false);
    }
    return Attrs;
}

fn Parser::ParseLexedTypeAttribute(self, LA: *mut LateParsedTypeAttribute, OutAttrs: *mut ParsedAttributes) {
    assert!(LA.Decls.len <= 1, "late field attribute expects to have at most one declaration.");
    let mut Attrs: ParsedAttributes = self.ParseLexedAttributeTokens(LA);
    OutAttrs.takeAllAppendingFrom(Attrs);
}

fn Parser::CompleteLateParsedTypeAttributes(self, LateTypeAttrs: *mut SmallVectorImpl<LateParsedTypeAttribute *>) {
    for RawLTA in LateTypeAttrs {
        let mut LTA: unique_ptr<LateParsedTypeAttribute> = RawLTA;
        let mut BATy: *mut BoundsAttributedType = operator(LTA).TypeToComplete;
        if !BATy || self.Actions.isLateParsedBoundsTypeRejected(BATy) {
            continue;
        }
        let mut Fields: ArrayRef<Decl *> = operator(LTA).Decls;
        let mut AF: AttributeFactory = AttributeFactory {};
        let mut Attrs: ParsedAttributes = AF;
        self.ParseLexedTypeAttribute(operator(LTA), Attrs);
        if Attrs.is_empty() {
            continue;
        }
        assert!(Attrs.len == 1);
        let mut Arg: *mut Expr = Attrs[0].getArgAsExpr(0);
        assert!(Arg);
        let mut Valid: bool = true;
        assert!(!Fields.is_empty();
        for FD in Fields {
            Valid &= self.Actions.ActOnLateParsedTypeAttrArgument(BATy, cast(FD), Arg);
        }
        if Valid {
            Attrs[0].setUsedAsTypeAttr(true);
        } else {
            Attrs[0].setInvalid(true);
        }
    }
    LateTypeAttrs.clear();
}

fn LateParsedTypeAttribute::ParseInto(self, OutAttrs: *mut ParsedAttributes) {
    self.Self.ParseLexedTypeAttribute(*self, OutAttrs);
}

fn Parser::TakeTypeAttrsAppendingFrom(self, To: *mut LateParsedAttrList, From: *mut LateParsedAttrList) {
    let mut It: iterator = remove_if(From, Closure_6 { To: &mut To });
    From.erase(It, From.end());
}

fn Parser::ParseStructUnionBody(self, RecordLoc: SourceLocation, TagType: TST, TagDecl: *mut RecordDecl) {
    let mut CrashInfo: PrettyDeclStackTraceEntry = PrettyDeclStackTraceEntry { self.Actions.Context, TagDecl, RecordLoc, "parsing struct/union body" };
    assert!(!self.getLangOpts().CPlusPlus, "C++ declarations not supported");
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    if T.consumeOpen() {
        return;
    }
    let mut StructScope: ParseScope = ParseScope { self, ClassScope | DeclScope, true, false };
    self.Actions.ActOnTagStartDefinition(self.getCurScope(), TagDecl);
    let mut LateFieldAttrs: LateParsedAttrList = LateParsedAttrList { ParseSoon: true, LateAttrParseExperimentalExtOnly: true, LateAttrParseTypeAttrOnly: false };
    while !self.tryParseMisplacedModuleImport() && self.Tok.isNot(r_brace) && self.Tok.isNot(eof) {
        if self.Tok.is(semi) {
            self.ConsumeExtraSemi(InsideStruct, TagType);
            continue;
        }
        if self.Tok.isOneOf(kw__Static_assert, kw_static_assert) {
            let mut DeclEnd: SourceLocation = SourceLocation {};
            self.ParseStaticAssertDeclaration(DeclEnd);
            continue;
        }
        if self.Tok.is(annot_pragma_pack) {
            self.HandlePragmaPack();
            continue;
        }
        if self.Tok.is(annot_pragma_align) {
            self.HandlePragmaAlign();
            continue;
        }
        if self.Tok.isOneOf(annot_pragma_openmp, annot_attr_openmp) {
            let mut AS: AccessSpecifier = AS_none;
            let mut Attrs: ParsedAttributes = self.AttrFactory;
            self.ParseOpenMPDeclarativeDirectiveWithExtDecl(AS, Attrs, false, TST_unspecified, null) as void;
            continue;
        }
        if self.Tok.is(annot_pragma_openacc) {
            let mut AS: AccessSpecifier = AS_none;
            let mut Attrs: ParsedAttributes = self.AttrFactory;
            self.ParseOpenACCDirectiveDecl(AS, Attrs, TagType, TagDecl);
            continue;
        }
        if isPragmaAnnotation(self.Tok.getKind()) {
            self.Diag(self.Tok.getLocation(), err_pragma_misplaced_in_decl) << getSpecifierName(TagType, self.Actions.getASTContext().getPrintingPolicy());
            self.ConsumeAnnotationToken();
            continue;
        }
        if !self.Tok.is(at) {
            let mut CFieldCallback: Closure_7 = Closure_7 { cap_0: self, TagDecl: &mut TagDecl };
            let mut DS: ParsingDeclSpec = *self;
            self.ParseStructDeclaration(DS, function_ref<Decl *(ParsingFieldDeclarator &)> { CFieldCallback, null, null }, &mut LateFieldAttrs);
        } else {
            self.ConsumeToken();
            if !self.Tok.isObjCAtKeyword(objc_defs) {
                self.Diag(self.Tok, err_unexpected_at);
                self.SkipUntil(semi, 0 as SkipUntilFlags);
                continue;
            }
            self.ConsumeToken();
            self.ExpectAndConsume(l_paren, err_expected, "");
            if !self.Tok.is(identifier) {
                self.Diag(self.Tok, err_expected) << identifier;
                self.SkipUntil(semi, 0 as SkipUntilFlags);
                continue;
            }
            let mut Fields: SmallVector<Decl *, 16> = SmallVector<Decl *, 16> {};
            self.Actions.ObjC().ActOnDefs(self.getCurScope(), TagDecl, self.Tok.getLocation(), self.Tok.getIdentifierInfo(), Fields);
            self.ConsumeToken();
            self.ExpectAndConsume(r_paren, err_expected, "");
        }
        if self.TryConsumeToken(semi) {
            continue;
        }
        if self.Tok.is(r_brace) {
            self.ExpectAndConsume(semi, ext_expected_semi_decl_list, "");
            break;
        }
        self.ExpectAndConsume(semi, err_expected_semi_decl_list, "");
        self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
        self.TryConsumeToken(semi);
    }
    T.consumeClose();
    let mut attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseGNUAttributes(attrs, &mut LateFieldAttrs);
    let mut FieldDecls: SmallVector<Decl *, 32> = TagDecl.fields();
    self.Actions.ActOnFields(self.getCurScope(), RecordLoc, TagDecl, FieldDecls, T.getOpenLocation(), T.getCloseLocation(), attrs);
    self.ParseLexedAttributeList(LateFieldAttrs, null, false, false, null);
    StructScope.Exit();
    self.Actions.ActOnTagFinishDefinition(self.getCurScope(), TagDecl, T.getRange());
}

fn Parser::ParseEnumSpecifier(self, StartLoc: SourceLocation, DS: *mut DeclSpec, TemplateInfo: *ParsedTemplateInfo, AS: AccessSpecifier, DSC: DeclSpecContext) {
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteTag(self.getCurScope(), TST_enum);
        DS.SetTypeSpecError();
        return;
    }
    let mut attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseAttributes(PAKM_GNU | PAKM_Declspec | PAKM_CXX11, attrs, null);
    let mut ScopedEnumKWLoc: SourceLocation = SourceLocation {};
    let mut IsScopedUsingClassTag: bool = false;
    if self.Tok.isOneOf(kw_class, kw_struct) && self.getLangOpts().CPlusPlus {
        self.DiagCompat(self.Tok, scoped_enum);
        IsScopedUsingClassTag = self.Tok.is(kw_class);
        ScopedEnumKWLoc = self.ConsumeToken();
        self.ProhibitAttributes(attrs, SourceLocation {});
        self.MaybeParseAttributes(PAKM_GNU | PAKM_Declspec | PAKM_CXX11, attrs, null);
    }
    let mut shouldDelayDiagsInTag: bool = (TemplateInfo.Kind == ExplicitInstantiation || TemplateInfo.Kind == ExplicitSpecialization);
    let mut diagsFromTag: SuppressAccessChecks = SuppressAccessChecks { *self, shouldDelayDiagsInTag };
    let mut AllowEnumSpecifier: AllowDefiningTypeSpec = isDefiningTypeSpecifierContext(DSC, self.getLangOpts().CPlusPlus);
    let mut CanBeOpaqueEnumDeclaration: bool = DS.isEmpty() && isOpaqueEnumDeclarationContext(DSC);
    let mut CanHaveEnumBase: bool = (self.getLangOpts().CPlusPlus11 || self.getLangOpts().ObjC || self.getLangOpts().MicrosoftExt) && (AllowEnumSpecifier == Yes || CanBeOpaqueEnumDeclaration);
    let mut InvalidDeclScope: CXXScopeSpec = CXXScopeSpec {};
    let mut SS: *mut CXXScopeSpec = if DS.hasTypeSpecifier() { InvalidDeclScope } else { DS.getTypeSpecScope() };
    if self.getLangOpts().CPlusPlus {
        let mut X: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        let mut Spec: CXXScopeSpec = CXXScopeSpec {};
        if self.ParseOptionalCXXScopeSpecifier(Spec, null, false, true, null, false, null, false, false, false, false, false) {
            return;
        }
        if Spec.isSet() && self.Tok.isNot(identifier) {
            self.Diag(self.Tok, err_expected) << identifier;
            DS.SetTypeSpecError();
            if self.Tok.isNot(l_brace) {
                self.SkipUntil(comma, StopAtSemi);
                return;
            }
        }
        SS = move(Spec);
    }
    if self.Tok.isNot(identifier) && self.Tok.isNot(l_brace) && self.Tok.isNot(colon) {
        self.Diag(self.Tok, err_expected_either) << identifier << l_brace;
        DS.SetTypeSpecError();
        self.SkipUntil(comma, StopAtSemi);
        return;
    }
    let mut Name: *mut IdentifierInfo = null;
    let mut NameLoc: SourceLocation = SourceLocation {};
    if self.Tok.is(identifier) {
        Name = self.Tok.getIdentifierInfo();
        NameLoc = self.ConsumeToken();
    }
    if !Name && ScopedEnumKWLoc.isValid() {
        self.Diag(self.Tok, err_scoped_enum_missing_identifier);
        ScopedEnumKWLoc = SourceLocation {};
        IsScopedUsingClassTag = false;
    }
    if shouldDelayDiagsInTag {
        diagsFromTag.done();
    }
    let mut BaseType: TypeResult = false;
    let mut BaseRange: SourceRange = SourceRange {};
    let mut CanBeBitfield: bool = self.getCurScope().isClassScope() && ScopedEnumKWLoc.isInvalid() && Name;
    let mut IsCXXTypeAhead: Closure_8 = Closure_8 { cap_0: self };
    if self.Tok.is(colon) && (!self.ParsingGenericAssociationType || IsCXXTypeAhead.call()) {
        if CanBeBitfield && !self.isEnumBase(CanBeOpaqueEnumDeclaration) {
            if self.getLangOpts().CPlusPlus11 {
                self.Diag(self.Tok.getLocation(), err_anonymous_enum_bitfield);
            }
        } else if CanHaveEnumBase || !self.ColonIsSacred {
            let mut ColonLoc: SourceLocation = self.ConsumeToken();
            let mut DS: DeclSpec = self.AttrFactory;
            self.ParseSpecifierQualifierList(DS, No, AS, DSC_type_specifier);
            let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
            BaseType = self.Actions.ActOnTypeName(DeclaratorInfo);
            BaseRange = SourceRange { B: ColonLoc, E: DeclaratorInfo.getSourceRange().getEnd() };
            if !self.getLangOpts().ObjC {
                if self.getLangOpts().CPlusPlus {
                    self.DiagCompat(ColonLoc, cxx_enum_fixed_underlying_type) << BaseRange;
                } else if self.getLangOpts().MicrosoftExt && !self.getLangOpts().C23 {
                    self.Diag(ColonLoc, ext_ms_c_enum_fixed_underlying_type) << BaseRange;
                } else {
                    self.DiagCompat(ColonLoc, c_enum_fixed_underlying_type) << BaseRange;
                }
            }
        }
    }
    let mut TUK: TagUseKind = zeroed();
    if AllowEnumSpecifier == No {
        TUK = Reference;
    } else if self.Tok.is(l_brace) {
        if DS.isFriendSpecified() {
            self.Diag(self.Tok.getLocation(), err_friend_decl_defines_type) << DS.getFriendSpecLoc();
            self.ConsumeBrace();
            self.SkipUntil(r_brace, StopAtSemi);
            attrs.clear();
            ScopedEnumKWLoc = SourceLocation {};
            IsScopedUsingClassTag = false;
            BaseType = TypeResult { false };
            TUK = Friend;
        } else {
            TUK = Definition;
        }
    } else if !isTypeSpecifier(DSC) && (self.Tok.is(semi) || (self.Tok.isAtStartOfLine() && !self.isValidAfterTypeSpecifier(CanBeBitfield))) {
        TUK = if DS.isFriendSpecified() { Friend } else { Declaration };
        if self.Tok.isNot(semi) {
            self.ExpectAndConsume(semi, err_expected_after, "enum");
            self.PP.EnterToken(self.Tok, true);
            self.Tok.setKind(semi);
        }
    } else {
        TUK = Reference;
    }
    let mut IsElaboratedTypeSpecifier: bool = TUK == Reference || TUK == Friend;
    if TUK == Reference && shouldDelayDiagsInTag {
        diagsFromTag.redelay();
    }
    let mut TParams: MultiTemplateParamsArg = MultiTemplateParamsArg {};
    if TemplateInfo.Kind != NonTemplate && TUK != Reference {
        if !self.getLangOpts().CPlusPlus11 || !SS.isSet() {
            self.Diag(self.Tok, err_enum_template);
            self.SkipUntil(comma, StopAtSemi);
            return;
        }
        if TemplateInfo.Kind == ExplicitInstantiation {
            DS.SetTypeSpecError();
            self.Diag(StartLoc, err_explicit_instantiation_enum);
            return;
        }
        assert!(TemplateInfo.TemplateParams, "no template parameters");
        TParams = MultiTemplateParamsArg { TemplateInfo.TemplateParams.ptr, TemplateInfo.TemplateParams.len };
        SS.setTemplateParamLists(TParams);
    }
    if !Name && TUK != Definition {
        self.Diag(self.Tok, err_enumerator_unnamed_no_def);
        DS.SetTypeSpecError();
        self.SkipUntil(comma, StopAtSemi);
        return;
    }
    if IsElaboratedTypeSpecifier && !self.getLangOpts().MicrosoftExt && !self.getLangOpts().ObjC {
        self.ProhibitCXX11Attributes(attrs, err_attributes_not_allowed, err_keyword_not_allowed, true, false);
        if BaseType.isUsable() {
            self.Diag(BaseRange.getBegin(), ext_enum_base_in_type_specifier) << (AllowEnumSpecifier == Yes) << BaseRange;
        } else if ScopedEnumKWLoc.isValid() {
            self.Diag(ScopedEnumKWLoc, ext_elaborated_enum_class) << CreateRemoval(ScopedEnumKWLoc) << IsScopedUsingClassTag;
        }
    }
    self.stripTypeAttributesOffDeclSpec(attrs, DS, TUK);
    let mut SkipBody: SkipBodyInfo = SkipBodyInfo {};
    if !Name && TUK == Definition && self.Tok.is(l_brace) && self.NextToken().is(identifier) {
        SkipBody = self.Actions.shouldSkipAnonEnumBody(self.getCurScope(), self.NextToken().getIdentifierInfo(), self.NextToken().getLocation());
    }
    let mut Owned: bool = false;
    let mut IsDependent: bool = false;
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    let mut TagDecl: *mut Decl = self.Actions.ActOnTag(self.getCurScope(), TST_enum, TUK, StartLoc, SS, Name, NameLoc, attrs, AS, DS.getModulePrivateSpecLoc(), TParams, Owned, IsDependent, ScopedEnumKWLoc, IsScopedUsingClassTag, BaseType, DSC == DSC_type_specifier, DSC == DSC_template_param || DSC == DSC_template_type_arg, self.OffsetOfState, &mut SkipBody).get();
    if SkipBody.ShouldSkip {
        assert!(TUK == Definition, "can only skip a definition");
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
        T.consumeOpen();
        T.skipToEnd();
        if DS.SetTypeSpecType(TST_enum, StartLoc, if NameLoc.isValid() { NameLoc } else { StartLoc }, PrevSpec, DiagID, TagDecl, Owned, self.Actions.getASTContext().getPrintingPolicy()) {
            self.Diag(StartLoc, DiagID) << PrevSpec;
        }
        return;
    }
    if IsDependent {
        if !Name {
            DS.SetTypeSpecError();
            self.Diag(self.Tok, err_expected_type_name_after_typename);
            return;
        }
        let mut Type: TypeResult = self.Actions.ActOnDependentTag(self.getCurScope(), TST_enum, TUK, SS, Name, StartLoc, NameLoc);
        if Type.isInvalid() {
            DS.SetTypeSpecError();
            return;
        }
        if DS.SetTypeSpecType(TST_typename, StartLoc, if NameLoc.isValid() { NameLoc } else { StartLoc }, PrevSpec, DiagID, Type.get(), self.Actions.getASTContext().getPrintingPolicy()) {
            self.Diag(StartLoc, DiagID) << PrevSpec;
        }
        return;
    }
    if !TagDecl {
        if self.Tok.is(l_brace) && TUK != Reference {
            self.ConsumeBrace();
            self.SkipUntil(r_brace, StopAtSemi);
        }
        DS.SetTypeSpecError();
        return;
    }
    if self.Tok.is(l_brace) && TUK == Definition {
        let mut D: *mut Decl = if SkipBody.CheckSameAsPrevious { SkipBody.New } else { TagDecl };
        self.ParseEnumBody(StartLoc, D, &mut SkipBody);
        if SkipBody.CheckSameAsPrevious && !self.Actions.ActOnDuplicateDefinition(self.getCurScope(), TagDecl, SkipBody) {
            DS.SetTypeSpecError();
            return;
        }
    }
    if DS.SetTypeSpecType(TST_enum, StartLoc, if NameLoc.isValid() { NameLoc } else { StartLoc }, PrevSpec, DiagID, TagDecl, Owned, self.Actions.getASTContext().getPrintingPolicy()) {
        self.Diag(StartLoc, DiagID) << PrevSpec;
    }
}

fn Parser::ParseEnumBody(self, StartLoc: SourceLocation, EnumDecl: *mut Decl, SkipBody: *mut SkipBodyInfo) {
    let mut EnumScope: ParseScope = ParseScope { self, DeclScope | EnumScope, true, false };
    self.Actions.ActOnTagStartDefinition(self.getCurScope(), EnumDecl);
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    T.consumeOpen();
    if self.Tok.is(r_brace) && !self.getLangOpts().CPlusPlus {
        if self.getLangOpts().MicrosoftExt {
            self.Diag(T.getOpenLocation(), ext_ms_c_empty_enum_type) << SourceRange { B: T.getOpenLocation(), E: self.Tok.getLocation() };
        } else {
            self.Diag(self.Tok, err_empty_enum);
        }
    }
    let mut EnumConstantDecls: SmallVector<Decl *, 32> = SmallVector<Decl *, 32> {};
    let mut EnumAvailabilityDiags: SmallVector<SuppressAccessChecks, 32> = SmallVector<SuppressAccessChecks, 32> {};
    let mut LastEnumConstDecl: *mut Decl = null;
    while self.Tok.isNot(r_brace) {
        if self.Tok.isNot(identifier) {
            self.Diag(self.Tok.getLocation(), err_expected) << identifier;
            if self.SkipUntil(comma, r_brace, StopBeforeMatch) && self.TryConsumeToken(comma) {
                continue;
            }
            break;
        }
        let mut Ident: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut IdentLoc: SourceLocation = self.ConsumeToken();
        let mut attrs: ParsedAttributes = self.AttrFactory;
        self.MaybeParseGNUAttributes(attrs, null);
        if self.isAllowedCXX11AttributeSpecifier(false, false) {
            if self.getLangOpts().CPlusPlus {
                self.DiagCompat(self.Tok.getLocation(), ns_enum_attribute) << 1;
            }
            self.ParseCXX11Attributes(attrs);
        }
        let mut EqualLoc: SourceLocation = SourceLocation {};
        let mut AssignedVal: ExprResult = false;
        EnumAvailabilityDiags.push(*self);
        let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
        if self.TryConsumeToken(equal, EqualLoc) {
            AssignedVal = self.ParseConstantExpressionInExprEvalContext(AllowNonTypes);
            if AssignedVal.isInvalid() {
                self.SkipUntil(comma, r_brace, StopBeforeMatch);
            }
        }
        let mut EnumConstDecl: *mut Decl = self.Actions.ActOnEnumConstant(self.getCurScope(), EnumDecl, LastEnumConstDecl, IdentLoc, Ident, attrs, EqualLoc, AssignedVal.get(), SkipBody);
        EnumAvailabilityDiags.back().done();
        EnumConstantDecls.push(EnumConstDecl);
        LastEnumConstDecl = EnumConstDecl;
        if self.Tok.is(identifier) {
            let mut Loc: SourceLocation = self.getEndOfPreviousToken();
            self.Diag(Loc, err_enumerator_list_missing_comma) << CreateInsertion(Loc, ", ", false);
            continue;
        }
        let mut CommaLoc: SourceLocation = SourceLocation {};
        if self.Tok.isNot(r_brace) && !self.TryConsumeToken(comma, CommaLoc) {
            if EqualLoc.isValid() {
                self.Diag(self.Tok.getLocation(), err_expected_either) << r_brace << comma;
            } else {
                self.Diag(self.Tok.getLocation(), err_expected_end_of_enumerator);
            }
            if self.SkipUntil(comma, r_brace, StopBeforeMatch) {
                if self.TryConsumeToken(comma, CommaLoc) {
                    continue;
                }
            } else {
                break;
            }
        }
        if self.Tok.is(r_brace) && CommaLoc.isValid() {
            if self.getLangOpts().CPlusPlus {
                self.DiagCompat(CommaLoc, cxx_enumerator_list_comma) << CreateRemoval(CommaLoc);
            } else if !self.getLangOpts().C99 {
                self.Diag(CommaLoc, ext_enumerator_list_comma_c) << CreateRemoval(CommaLoc);
            }
            break;
        }
    }
    T.consumeClose();
    let mut attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseGNUAttributes(attrs, null);
    self.Actions.ActOnEnumBody(StartLoc, T.getRange(), EnumDecl, EnumConstantDecls, self.getCurScope(), attrs);
    assert!(EnumConstantDecls.len == EnumAvailabilityDiags.len);
    for let mut i: u64 = 0;
let mut e: u64 = EnumConstantDecls.len; i != e; i += 1 {
        let mut PD: ParsingDeclRAIIObject = ParsingDeclRAIIObject { *self, NoParent };
        EnumAvailabilityDiags[i].redelay();
        PD.complete(EnumConstantDecls[i]);
    }
    EnumScope.Exit();
    self.Actions.ActOnTagFinishDefinition(self.getCurScope(), EnumDecl, T.getRange());
    let mut CanBeBitfield: bool = self.getCurScope().isClassScope();
    if !self.isValidAfterTypeSpecifier(CanBeBitfield) {
        self.ExpectAndConsume(semi, err_expected_after, "enum");
        self.PP.EnterToken(self.Tok, true);
        self.Tok.setKind(semi);
    }
}

fn Parser::isKnownToBeTypeSpecifier(self: *Parser, Tok: *Token) -> bool {
    match Tok.getKind() {
        _ => {
            return false;
        },
        kw_short => {
            kw_long;
        },
    }
}

fn Parser::isTypeSpecifierQualifier(self, Tok: *Token) -> bool {
    match Tok.getKind() {
        _ => {
            return false;
        },
        identifier => {
            if self.TryAltiVecVectorToken() {
                return true;
            }
        },
        kw_typename => {
            if self.TryAnnotateTypeOrScopeToken(No, false) {
                return true;
            }
        },
        coloncolon => {
            if self.NextToken().is(kw_new) || self.NextToken().is(kw_delete) {
                return false;
            }
        },
        kw___attribute => {
            kw_typeof;
        },
        less => {
            return self.getLangOpts().ObjC;
        },
        kw___cdecl => {
            kw___stdcall;
        },
        kw_private => {
            return self.getLangOpts().OpenCL;
        },
        kw__Atomic => {
            return true;
        },
        kw_groupshared => {
            kw_in;
        },
    }
}

fn Parser::ParseTopLevelStmtDecl(self) -> DeclGroupPtrTy {
    assert!(self.PP.isIncrementalProcessingEnabled(), "Not in incremental mode");
    let mut Stmts: StmtVector = StmtVector {};
    let mut SubStmtCtx: ParsedStmtContext = ;
    let mut FnScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope, true, false };
    let mut TLSD: *mut TopLevelStmtDecl = self.Actions.ActOnStartTopLevelStmtDecl(self.getCurScope());
    let mut R: StmtResult = self.ParseStatementOrDeclaration(Stmts, SubStmtCtx, null, null);
    self.Actions.ActOnFinishTopLevelStmtDecl(TLSD, R.get());
    if !R.isUsable() {
        R = self.Actions.ActOnNullStmt(self.Tok.getLocation(), false);
    }
    if self.Tok.is(annot_repl_input_end) && self.Tok.getAnnotationValue() != null {
        self.ConsumeAnnotationToken();
        TLSD.setSemiMissing(true);
    }
    let mut DeclsInGroup: SmallVector<Decl *, 2> = SmallVector<Decl *, 2> {};
    DeclsInGroup.push(TLSD);
    for S in Stmts {
        let mut D: *mut TopLevelStmtDecl = self.Actions.ActOnStartTopLevelStmtDecl(self.getCurScope());
        self.Actions.ActOnFinishTopLevelStmtDecl(D, S);
        DeclsInGroup.push(D);
    }
    return self.Actions.BuildDeclaratorGroup(DeclsInGroup);
}

fn Parser::isDeclarationSpecifier(self, AllowImplicitTypename: ImplicitTypenameContext, DisambiguatingWithExpression: bool) -> bool {
    match self.Tok.getKind() {
        _ => {
            return false;
        },
        kw_pipe => {
            return self.getLangOpts().OpenCL && self.getLangOpts().getOpenCLCompatibleVersion() >= 200;
        },
        identifier => {
            if self.getLangOpts().ObjC && self.NextToken().is(period) {
                return false;
            }
        },
        kw_decltype => {
            kw_typename;
        },
        coloncolon => {
            if !self.getLangOpts().CPlusPlus {
                return false;
            }
        },
        kw_typedef => {
            kw_extern;
        },
        kw_alignas => {
            return self.getLangOpts().C23;
        },
        less => {
            return self.getLangOpts().ObjC;
        },
        annot_typename => {
            return !DisambiguatingWithExpression || !self.isStartOfObjCClassMessageMissingOpenBracket();
        },
        annot_template_id => {
            let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
            if TemplateId.hasInvalidName() {
                return true;
            }
            return self.isTypeConstraintAnnotation() && (self.NextToken().is(kw_auto) || self.NextToken().is(kw_decltype));
        },
        annot_cxxscope => {
            let mut TemplateId: *mut TemplateIdAnnotation = if self.NextToken().is(annot_template_id) { self.takeTemplateIdAnnotation(self.NextToken()) } else { null };
            if TemplateId && TemplateId.hasInvalidName() {
                return true;
            }
            if self.NextToken().is(identifier) && self.TryAnnotateTypeConstraint() {
                return true;
            }
            return self.isTypeConstraintAnnotation() && self.GetLookAheadToken(2).isOneOf(kw_auto, kw_decltype);
        },
        kw___declspec => {
            kw___cdecl;
        },
        kw_row_major => {
            kw_column_major;
        },
        kw_private => {
            return self.getLangOpts().OpenCL;
        },
    }
}

fn Parser::isConstructorDeclarator(self, IsUnqualified: bool, DeductionGuide: bool, IsFriend: FriendSpecified, TemplateInfo: *ParsedTemplateInfo) -> bool {
    let mut TPA: RevertingTentativeParsingAction = RevertingTentativeParsingAction { *self, false };
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if TemplateInfo && TemplateInfo.TemplateParams {
        SS.setTemplateParamLists(*TemplateInfo.TemplateParams);
    }
    if self.ParseOptionalCXXScopeSpecifier(SS, null, false, true, null, false, null, false, false, false, false, false) {
        return false;
    }
    if self.Tok.is(identifier) {
        self.ConsumeToken();
    } else if self.Tok.is(annot_template_id) {
        self.ConsumeAnnotationToken();
    } else {
        return false;
    }
    self.SkipCXX11Attributes();
    if self.Tok.isNot(l_paren) {
        return false;
    }
    self.ConsumeParen();
    if self.Tok.is(r_paren) || (self.Tok.is(ellipsis) && self.NextToken().is(r_paren)) {
        return true;
    }
    if self.isCXX11AttributeSpecifier(false, true) != NotAttributeSpecifier {
        return true;
    }
    let mut DeclScopeObj: DeclaratorScopeObj = DeclaratorScopeObj { *self, SS };
    if SS.isSet() && self.Actions.ShouldEnterDeclaratorScope(self.getCurScope(), SS) {
        DeclScopeObj.EnterDeclaratorScope();
    }
    let mut Attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseMicrosoftAttributes(Attrs);
    let mut IsConstructor: bool = false;
    let mut ITC: ImplicitTypenameContext = if IsFriend && !SS.isSet() { No } else { Yes };
    if self.Tok.is(kw_this) {
        self.ConsumeToken();
        return self.isDeclarationSpecifier(ITC, false);
    }
    if self.isDeclarationSpecifier(ITC, false) {
        IsConstructor = true;
    } else if self.Tok.is(identifier) || (self.Tok.is(annot_cxxscope) && self.NextToken().is(identifier)) {
        if self.Tok.is(annot_cxxscope) {
            self.ConsumeAnnotationToken();
        }
        self.ConsumeToken();
        match self.Tok.getKind() {
            l_paren => {
                l_square;
            },
            r_paren => {
                self.ConsumeParen();
            },
            _ => {
                IsConstructor = true;
            },
        }
    }
    return IsConstructor;
}

fn Parser::ParseTypeQualifierListOpt(self, DS: *mut DeclSpec, AttrReqs: u32, AtomicOrPtrauthAllowed: bool, IdentifierRequired: bool, CodeCompletionHandler: function_ref<void ()>) {
    if (AttrReqs & AR_CXX11AttributesParsed) && self.isAllowedCXX11AttributeSpecifier(false, false) {
        let mut Attrs: ParsedAttributes = self.AttrFactory;
        self.ParseCXX11Attributes(Attrs);
        DS.takeAttributesAppendingingFrom(Attrs);
    }
    let mut EndLoc: SourceLocation = SourceLocation {};
    while true {
        let mut isInvalid: bool = false;
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        let mut Loc: SourceLocation = self.Tok.getLocation();
        match self.Tok.getKind() {
            code_completion => {
                self.cutOffParsing();
            },
            kw_const => {
                isInvalid = DS.SetTypeQual(TQ_const, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw_volatile => {
                isInvalid = DS.SetTypeQual(TQ_volatile, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw_restrict => {
                isInvalid = DS.SetTypeQual(TQ_restrict, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw___ob_wrap => {
                if !self.getLangOpts().OverflowBehaviorTypes {
                    self.Diag(Loc, warn_overflow_behavior_keyword_disabled) << getKeywordSpelling(self.Tok.getKind());
                    break;
                }
            },
            kw___ob_trap => {
                if !self.getLangOpts().OverflowBehaviorTypes {
                    self.Diag(Loc, warn_overflow_behavior_keyword_disabled) << getKeywordSpelling(self.Tok.getKind());
                    break;
                }
            },
            kw__Atomic => {
                if !AtomicOrPtrauthAllowed {
                    
                }
            },
            kw_private => {
                if !self.getLangOpts().OpenCL {
                    
                }
            },
            kw___private => {
                kw___global;
            },
            kw_groupshared => {
                kw_in;
            },
            kw___ptrauth => {
                if !AtomicOrPtrauthAllowed {
                    
                }
            },
            kw___unaligned => {
                isInvalid = DS.SetTypeQual(TQ_unaligned, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw___uptr => {
                if (AttrReqs & AR_DeclspecAttributesParsed) && !self.getLangOpts().CPlusPlus && IdentifierRequired && DS.isEmpty() && self.NextToken().is(semi) {
                    if self.TryKeywordIdentFallback(false) {
                        continue;
                    }
                }
            },
            kw___sptr => {
                kw___w64;
            },
            kw___funcref => {
                self.ParseWebAssemblyFuncrefTypeAttribute(DS.getAttributes());
            },
            kw___pascal => {
                if AttrReqs & AR_VendorAttributesParsed {
                    self.ParseBorlandTypeAttributes(DS.getAttributes());
                    continue;
                }
            },
            kw__Nonnull => {
                kw__Nullable;
            },
            kw___kindof => {
                DS.getAttributes().addNew(self.Tok.getIdentifierInfo(), Loc, AttributeScopeInfo {}, null, 0, kw___kindof, SourceLocation {});
            },
            kw___attribute => {
                if AttrReqs & AR_GNUAttributesParsedAndRejected {
                    self.Diag(self.Tok, err_attributes_not_allowed);
                }
            },
            _ => {
                DS.Finish(self.Actions, self.Actions.getASTContext().getPrintingPolicy());
            },
        }
        if isInvalid {
            assert!(PrevSpec, "Method did not return previous specifier!");
            self.Diag(self.Tok, DiagID) << PrevSpec;
        }
        EndLoc = self.ConsumeToken();
    }
}

fn Parser::ParseDeclarator(self, D: *mut Declarator) {
    self.Actions.runWithSufficientStackSpace(D.getBeginLoc(), function_ref<void ()> { Closure_9 { cap_0: self, D: &mut D }, null, null });
}

fn isPtrOperatorToken(Kind: TokenKind, Lang: *LangOptions, TheContext: DeclaratorContext) -> bool {
    if Kind == star || Kind == caret {
        return true;
    }
    if Kind == kw_pipe && Lang.OpenCL && Lang.getOpenCLCompatibleVersion() >= 200 {
        return true;
    }
    if !Lang.CPlusPlus {
        return false;
    }
    if Kind == amp {
        return true;
    }
    if Kind == ampamp {
        return Lang.CPlusPlus11 || (TheContext != ConversionId && TheContext != CXXNew);
    }
    return false;
}

fn isPipeDeclarator(D: *Declarator) -> bool {
    let mut NumTypes: u32 = D.getNumTypeObjects();
    for let mut Idx: u32 = 0; Idx != NumTypes; Idx += 1 {
        if Pipe == D.getTypeObject(Idx).Kind {
            return true;
        }
    }
    return false;
}

fn Parser::ParseDeclaratorInternal(self, D: *mut Declarator, DirectDeclParser: DirectDeclParseFunction) {
    if self.Diags.hasAllExtensionsSilenced() {
        D.setExtension(true);
    }
    if self.getLangOpts().CPlusPlus && (self.Tok.is(coloncolon) || (self.Tok.is(kw_decltype) && self.NextToken().is(l_paren)) || (self.Tok.is(identifier) && (self.NextToken().is(coloncolon) || self.NextToken().is(less))) || self.Tok.is(annot_cxxscope)) {
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, true };
        let mut EnteringContext: bool = D.getContext() == File || D.getContext() == Member;
        let mut SS: CXXScopeSpec = CXXScopeSpec {};
        SS.setTemplateParamLists(D.getTemplateParameterLists());
        if self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, false, false, EnteringContext, false, true) || SS.isEmpty() || SS.isInvalid() || !EnteringContext || self.Tok.is(star) {
            TPA.Commit();
            if SS.isNotEmpty() && self.Tok.is(star) {
                if SS.isValid() {
                    self.checkCompoundToken(SS.getEndLoc(), coloncolon, MemberPtr);
                }
                let mut StarLoc: SourceLocation = self.ConsumeToken();
                D.SetRangeEnd(StarLoc);
                let mut DS: DeclSpec = self.AttrFactory;
                self.ParseTypeQualifierListOpt(DS, AR_AllAttributesParsed, true, false, function_ref<void ()> {});
                D.ExtendWithDeclSpec(DS);
                self.Actions.runWithSufficientStackSpace(D.getBeginLoc(), function_ref<void ()> { Closure_10 { cap_0: self, D: &mut D, DirectDeclParser: &mut DirectDeclParser }, null, null });
                D.AddTypeInfo(getMemberPointer(SS, DS.getTypeQualifiers(), StarLoc, DS.getEndLoc()), move(DS.getAttributes()), SourceLocation {});
                return;
            }
        } else {
            TPA.Revert();
            SS.clear();
            self.ParseOptionalCXXScopeSpecifier(SS, null, false, true, null, false, null, false, false, false, false, false);
        }
        if SS.isNotEmpty() {
            if D.mayHaveIdentifier() {
                D.getCXXScopeSpec() = move(SS);
            } else {
                self.AnnotateScopeToken(SS, true);
            }
            if DirectDeclParser {
                self ->* DirectDeclParser(D);
            }
            return;
        }
    }
    let mut Kind: TokenKind = self.Tok.getKind();
    if D.getDeclSpec().isTypeSpecPipe() && !isPipeDeclarator(D) {
        let mut DS: DeclSpec = self.AttrFactory;
        self.ParseTypeQualifierListOpt(DS, AR_AllAttributesParsed, true, false, function_ref<void ()> {});
        D.AddTypeInfo(getPipe(DS.getTypeQualifiers(), DS.getPipeLoc()), move(DS.getAttributes()), SourceLocation {});
    }
    if !isPtrOperatorToken(Kind, self.getLangOpts(), D.getContext()) {
        if DirectDeclParser {
            self ->* DirectDeclParser(D);
        }
        return;
    }
    let mut Loc: SourceLocation = self.ConsumeToken();
    D.SetRangeEnd(Loc);
    if Kind == star || Kind == caret {
        let mut DS: DeclSpec = self.AttrFactory;
        let mut Reqs: u32 = AR_CXX11AttributesParsed | AR_DeclspecAttributesParsed | (if (D.getContext() != CXXNew) { AR_GNUAttributesParsed } else { AR_GNUAttributesParsedAndRejected });
        self.ParseTypeQualifierListOpt(DS, Reqs, true, !D.mayOmitIdentifier(), function_ref<void ()> {});
        D.ExtendWithDeclSpec(DS);
        self.Actions.runWithSufficientStackSpace(D.getBeginLoc(), function_ref<void ()> { Closure_11 { cap_0: self, D: &mut D, DirectDeclParser: &mut DirectDeclParser }, null, null });
        if Kind == star {
            D.AddTypeInfo(getPointer(DS.getTypeQualifiers(), Loc, DS.getConstSpecLoc(), DS.getVolatileSpecLoc(), DS.getRestrictSpecLoc(), DS.getAtomicSpecLoc(), DS.getUnalignedSpecLoc(), DS.getOverflowBehaviorLoc(), DS.isWrapSpecified()), move(DS.getAttributes()), SourceLocation {});
        } else {
            D.AddTypeInfo(getBlockPointer(DS.getTypeQualifiers(), Loc), move(DS.getAttributes()), SourceLocation {});
        }
    } else {
        let mut DS: DeclSpec = self.AttrFactory;
        if Kind == ampamp {
            self.DiagCompat(Loc, rvalue_reference);
        }
        self.ParseTypeQualifierListOpt(DS, AR_AllAttributesParsed, true, false, function_ref<void ()> {});
        D.ExtendWithDeclSpec(DS);
        if DS.getTypeQualifiers() != TQ_unspecified {
            if DS.getTypeQualifiers() & TQ_const {
                self.Diag(DS.getConstSpecLoc(), err_invalid_reference_qualifier_application) << "const";
            }
            if DS.getTypeQualifiers() & TQ_volatile {
                self.Diag(DS.getVolatileSpecLoc(), err_invalid_reference_qualifier_application) << "volatile";
            }
            if DS.getTypeQualifiers() & TQ_atomic {
                self.Diag(DS.getAtomicSpecLoc(), err_invalid_reference_qualifier_application) << "_Atomic";
            }
        }
        self.Actions.runWithSufficientStackSpace(D.getBeginLoc(), function_ref<void ()> { Closure_12 { cap_0: self, D: &mut D, DirectDeclParser: &mut DirectDeclParser }, null, null });
        if D.getNumTypeObjects() > 0 {
            let mut InnerChunk: *mut DeclaratorChunk = D.getTypeObject(D.getNumTypeObjects() - 1);
            if InnerChunk.Kind == Reference {
                if D.getIdentifier() {
                    II;
                } else {
                    self.Diag(InnerChunk.Loc, err_illegal_decl_reference_to_reference) << II;
                }
            }
        }
        D.AddTypeInfo(getReference(DS.getTypeQualifiers(), Loc, Kind == amp), move(DS.getAttributes()), SourceLocation {});
    }
}

fn getMissingDeclaratorIdLoc(D: *mut Declarator, Loc: SourceLocation) -> SourceLocation {
    if D.getName().StartLocation.isInvalid() && D.getName().EndLocation.isValid() {
        return D.getName().EndLocation;
    }
    return Loc;
}

fn Parser::ParseDirectDeclarator(self, D: *mut Declarator) {
    let mut DeclScopeObj: DeclaratorScopeObj = DeclaratorScopeObj { *self, D.getCXXScopeSpec() };
    if self.getLangOpts().CPlusPlus && D.mayHaveIdentifier() {
        if self.Tok.is(l_square) && !D.mayOmitIdentifier() && D.getCXXScopeSpec().isEmpty() {
            return self.ParseDecompositionDeclarator(D);
        }
        let mut X: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: D.getContext() == Member || (D.getContext() == ForInit && self.getLangOpts().CPlusPlus11) };
        if D.getCXXScopeSpec().isEmpty() {
            let mut EnteringContext: bool = D.getContext() == File || D.getContext() == Member;
            self.ParseOptionalCXXScopeSpecifier(D.getCXXScopeSpec(), null, false, EnteringContext, null, false, null, false, false, false, false, false);
        }
        if D.getCXXScopeSpec().isValid() {
            if self.Actions.ShouldEnterDeclaratorScope(self.getCurScope(), D.getCXXScopeSpec()) {
                DeclScopeObj.EnterDeclaratorScope();
            } else if self.getObjCDeclContext() {
                D.SetIdentifier(null, self.Tok.getLocation());
                D.setInvalidType(true);
                self.ConsumeToken();
            }
        }
        if self.Tok.is(ellipsis) && D.getCXXScopeSpec().isEmpty() && !((D.getContext() == Prototype || D.getContext() == LambdaExprParameter || D.getContext() == BlockLiteral) && self.NextToken().is(r_paren) && !D.hasGroupingParens() && !self.Actions.containsUnexpandedParameterPacks(D) && D.getDeclSpec().getTypeSpecType() != TST_auto) {
            let mut EllipsisLoc: SourceLocation = self.ConsumeToken();
            if isPtrOperatorToken(self.Tok.getKind(), self.getLangOpts(), D.getContext()) {
                self.ParseDeclarator(D);
                if EllipsisLoc.isValid() {
                    self.DiagnoseMisplacedEllipsisInDeclarator(EllipsisLoc, D);
                }
                return;
            } else {
                D.setEllipsisLoc(EllipsisLoc);
            }
        }
        if self.Tok.isOneOf(identifier, kw_operator, annot_template_id, tilde) {
            let mut AllowConstructorName: bool = false;
            let mut AllowDeductionGuide: bool = false;
            if D.getDeclSpec().hasTypeSpecifier() {
                AllowConstructorName = false;
                AllowDeductionGuide = false;
            } else if D.getCXXScopeSpec().isSet() {
                AllowConstructorName = (D.getContext() == File || D.getContext() == Member);
                AllowDeductionGuide = false;
            } else {
                AllowConstructorName = (D.getContext() == Member);
                AllowDeductionGuide = (D.getContext() == File || D.getContext() == Member);
            }
            let mut HadScope: bool = D.getCXXScopeSpec().isValid();
            let mut TemplateKWLoc: SourceLocation = SourceLocation {};
            if self.ParseUnqualifiedId(D.getCXXScopeSpec(), null, false, true, true, AllowConstructorName, AllowDeductionGuide, &mut TemplateKWLoc, D.getName()) || D.getCXXScopeSpec().isInvalid() {
                D.SetIdentifier(null, self.Tok.getLocation());
                D.setInvalidType(true);
            } else {
                if !HadScope && D.getCXXScopeSpec().isValid() && self.Actions.ShouldEnterDeclaratorScope(self.getCurScope(), D.getCXXScopeSpec()) {
                    DeclScopeObj.EnterDeclaratorScope();
                }
                if D.getSourceRange().getBegin().isInvalid() {
                    D.SetRangeBegin(D.getName().getSourceRange().getBegin());
                }
                D.SetRangeEnd(D.getName().getSourceRange().getEnd());
            }
        }
        if D.getCXXScopeSpec().isNotEmpty() {
            self.Diag(self.PP.getLocForEndOfToken(D.getCXXScopeSpec().getEndLoc(), 0), err_expected_unqualified_id) << 1;
            D.SetIdentifier(null, self.Tok.getLocation());
        }
    } else if self.Tok.is(identifier) && D.mayHaveIdentifier() {
        assert!(!self.getLangOpts().CPlusPlus, "There's a C++-specific check for tok::identifier above");
        assert!(self.Tok.getIdentifierInfo(), "Not an identifier?");
        D.SetIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
        D.SetRangeEnd(self.Tok.getLocation());
        self.ConsumeToken();
    } else if self.Tok.is(identifier) && !D.mayHaveIdentifier() {
        let mut DiagnoseIdentifier: bool = false;
        if D.hasGroupingParens() {
            DiagnoseIdentifier = true;
        } else if D.getContext() == TemplateArg {
            DiagnoseIdentifier = self.NextToken().isOneOf(comma, greater, greatergreater);
        } else if D.getContext() == AliasDecl || D.getContext() == AliasTemplate {
            DiagnoseIdentifier = self.NextToken().isOneOf(comma, semi);
        } else if (D.getContext() == TrailingReturn || D.getContext() == TrailingReturnVar) && !self.isCXX11VirtSpecifier(self.Tok) {
            DiagnoseIdentifier = self.NextToken().isOneOf(comma, semi, equal, l_brace, kw_try);
        }
        if DiagnoseIdentifier {
            self.Diag(self.Tok.getLocation(), err_unexpected_unqualified_id) << CreateRemoval(self.Tok.getLocation());
            D.SetIdentifier(null, self.Tok.getLocation());
            self.ConsumeToken();
        }
    }
    if self.Tok.is(l_paren) {
        if D.mayOmitIdentifier() && D.mayBeFollowedByCXXDirectInit() {
            let mut PA: RevertingTentativeParsingAction = RevertingTentativeParsingAction { *self, false };
            if self.TryParseDeclarator(true, D.mayHaveIdentifier(), true, D.getDeclSpec().getTypeSpecType() == TST_auto) == False {
                D.SetIdentifier(null, self.Tok.getLocation());
            }
        }
        self.ParseParenDeclarator(D);
        if D.isDecompositionDeclarator() {
            return;
        }
        if D.getCXXScopeSpec().isSet() {
            if !D.isInvalidType() && self.Actions.ShouldEnterDeclaratorScope(self.getCurScope(), D.getCXXScopeSpec()) {
                DeclScopeObj.EnterDeclaratorScope();
            }
        }
    } else if D.mayOmitIdentifier() {
        D.SetIdentifier(null, self.Tok.getLocation());
        if D.hasEllipsis() && D.hasGroupingParens() {
            self.Diag(self.PP.getLocForEndOfToken(D.getEllipsisLoc(), 0), ext_abstract_pack_declarator_parens);
        }
    } else {
        if self.Tok.getKind() == annot_pragma_parser_crash {
            __builtin_trap();
        }
        if self.Tok.is(l_square) {
            return self.ParseMisplacedBracketDeclarator(D);
        }
        if D.getContext() == Member {
            if self.getLangOpts().ObjC && self.getLangOpts().CPlusPlus && !self.Tok.isAnnotation() && self.Tok.getIdentifierInfo() && self.Tok.getIdentifierInfo().isCPlusPlusKeyword(self.getLangOpts()) {
                self.Diag(getMissingDeclaratorIdLoc(D, self.Tok.getLocation()), err_expected_member_name_or_semi_objcxx_keyword) << self.Tok.getIdentifierInfo() << (if D.getDeclSpec().isEmpty() { SourceRange {} } else { D.getDeclSpec().getSourceRange() });
                D.SetIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
                D.SetRangeEnd(self.Tok.getLocation());
                self.ConsumeToken();
            }
            self.Diag(getMissingDeclaratorIdLoc(D, self.Tok.getLocation()), err_expected_member_name_or_semi) << (if D.getDeclSpec().isEmpty() { SourceRange {} } else { D.getDeclSpec().getSourceRange() });
        } else {
            if self.Tok.getKind() == kw_while {
                self.Diag(self.Tok, err_while_loop_outside_of_a_function);
            } else if self.getLangOpts().CPlusPlus {
                if self.Tok.isOneOf(period, arrow) {
                    self.Diag(self.Tok, err_invalid_operator_on_type) << self.Tok.is(arrow);
                } else {
                    let mut Loc: SourceLocation = D.getCXXScopeSpec().getEndLoc();
                    if self.Tok.isAtStartOfLine() && Loc.isValid() {
                        self.Diag(self.PP.getLocForEndOfToken(Loc, 0), err_expected_unqualified_id) << self.getLangOpts().CPlusPlus;
                    } else {
                        self.Diag(getMissingDeclaratorIdLoc(D, self.Tok.getLocation()), err_expected_unqualified_id) << self.getLangOpts().CPlusPlus;
                    }
                }
            } else {
                self.Diag(getMissingDeclaratorIdLoc(D, self.Tok.getLocation()), err_expected_either) << identifier << l_paren;
            }
        }
        D.SetIdentifier(null, self.Tok.getLocation());
        D.setInvalidType(true);
    }
    assert!(D.isPastIdentifier(), "Haven't past the location of the identifier yet?");
    if D.hasName() && !D.getNumTypeObjects() {
        self.MaybeParseCXX11Attributes(D);
    }
    while true {
        if self.Tok.is(l_paren) {
            let mut IsFunctionDeclaration: bool = D.isFunctionDeclaratorAFunctionDeclaration();
            let mut PrototypeScope: ParseScope = ParseScope { self, FunctionPrototypeScope | DeclScope | (if IsFunctionDeclaration { FunctionDeclarationScope } else { NoScope }), true, false };
            let mut IsAmbiguous: bool = false;
            if self.getLangOpts().CPlusPlus && D.mayBeFollowedByCXXDirectInit() {
                let mut AllowImplicitTypename: ImplicitTypenameContext = No;
                if D.getCXXScopeSpec().isSet() {
                    AllowImplicitTypename = self.Actions.isDeclaratorFunctionLike(D) as ImplicitTypenameContext;
                } else if D.getContext() == Member {
                    AllowImplicitTypename = Yes;
                }
                self.TentativelyDeclaredIdentifiers.push(D.getIdentifier());
                let mut IsFunctionDecl: bool = self.isCXXFunctionDeclarator(&mut IsAmbiguous, AllowImplicitTypename);
                self.TentativelyDeclaredIdentifiers.pop();
                if !IsFunctionDecl {
                    break;
                }
            }
            let mut attrs: ParsedAttributes = self.AttrFactory;
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
            T.consumeOpen();
            if IsFunctionDeclaration {
                self.Actions.ActOnStartFunctionDeclarationDeclarator(D, self.TemplateParameterDepth);
            }
            self.ParseFunctionDeclarator(D, attrs, T, IsAmbiguous, false);
            if IsFunctionDeclaration {
                self.Actions.ActOnFinishFunctionDeclarationDeclarator(D);
            }
            PrototypeScope.Exit();
        } else if self.Tok.is(l_square) {
            self.ParseBracketDeclarator(D);
        } else if self.Tok.isRegularKeywordAttribute() {
            self.Diag(self.Tok, err_keyword_not_allowed) << self.Tok.getIdentifierInfo();
            let mut TakesArgs: bool = doesKeywordAttributeTakeArgs(self.Tok.getKind());
            self.ConsumeToken();
            if TakesArgs {
                let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
                if !T.consumeOpen() {
                    T.skipToEnd();
                }
            }
        } else if self.Tok.is(kw_requires) && D.hasGroupingParens() {
            self.Diag(self.Tok, err_requires_clause_inside_parens);
            self.ConsumeToken();
            let mut TrailingRequiresClause: ExprResult = self.ParseConstraintLogicalOrExpression(true);
            if TrailingRequiresClause.isUsable() && D.isFunctionDeclarator() && !D.hasTrailingRequiresClause() {
                D.setTrailingRequiresClause(TrailingRequiresClause.get());
            }
        } else {
            break;
        }
    }
}

fn Parser::ParseDecompositionDeclarator(self, D: *mut Declarator) {
    assert!(self.Tok.is(l_square);
    let mut PA: TentativeParsingAction = TentativeParsingAction { *self, false };
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
    T.consumeOpen();
    if self.isCXX11AttributeSpecifier(false, false) != NotAttributeSpecifier {
        self.DiagnoseAndSkipCXX11Attributes();
    }
    if !(self.Tok.isOneOf(identifier, ellipsis) && self.NextToken().isOneOf(comma, r_square, kw_alignas, identifier, l_square, ellipsis)) && !(self.Tok.is(r_square) && self.NextToken().isOneOf(equal, l_brace)) {
        PA.Revert();
        return self.ParseMisplacedBracketDeclarator(D);
    }
    let mut PrevEllipsisLoc: SourceLocation = SourceLocation {};
    let mut Bindings: Binding, 32> = Binding, 32> {};
    while self.Tok.isNot(r_square) {
        if !Bindings.is_empty() {
            if self.Tok.is(comma) {
                self.ConsumeToken();
            } else {
                if self.Tok.is(identifier) {
                    let mut EndLoc: SourceLocation = self.getEndOfPreviousToken();
                    self.Diag(EndLoc, err_expected) << comma << CreateInsertion(EndLoc, ",", false);
                } else {
                    self.Diag(self.Tok, err_expected_comma_or_rsquare);
                }
                self.SkipUntil([r_square, comma, identifier, ellipsis], StopAtSemi | StopBeforeMatch);
                if self.Tok.is(comma) {
                    self.ConsumeToken();
                } else if self.Tok.is(r_square) {
                    break;
                }
            }
        }
        if self.isCXX11AttributeSpecifier(false, false) != NotAttributeSpecifier {
            self.DiagnoseAndSkipCXX11Attributes();
        }
        let mut EllipsisLoc: SourceLocation = SourceLocation {};
        if self.Tok.is(ellipsis) {
            self.DiagCompat(self.Tok, binding_pack);
            if PrevEllipsisLoc.isValid() {
                self.Diag(self.Tok, err_binding_multiple_ellipses);
                self.Diag(PrevEllipsisLoc, note_previous_ellipsis);
                break;
            }
            EllipsisLoc = self.Tok.getLocation();
            PrevEllipsisLoc = EllipsisLoc;
            self.ConsumeToken();
        }
        if self.Tok.isNot(identifier) {
            self.Diag(self.Tok, err_expected) << identifier;
            break;
        }
        let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut Loc: SourceLocation = self.Tok.getLocation();
        self.ConsumeToken();
        if self.Tok.is(ellipsis) && !PrevEllipsisLoc.isValid() {
            self.DiagnoseMisplacedEllipsis(self.Tok.getLocation(), Loc, EllipsisLoc.isValid(), true);
            EllipsisLoc = self.Tok.getLocation();
            self.ConsumeToken();
        }
        let mut Attrs: ParsedAttributes = self.AttrFactory;
        if self.isCXX11AttributeSpecifier(false, false) != NotAttributeSpecifier {
            self.DiagCompat(self.Tok, attrs_on_binding);
            self.MaybeParseCXX11Attributes(Attrs, false);
        }
        Bindings.push(Binding { II, Loc, move(Attrs), EllipsisLoc });
    }
    if self.Tok.isNot(r_square) {
        T.skipToEnd();
    } else {
        if Bindings.is_empty() {
            self.Diag(self.Tok.getLocation(), ext_decomp_decl_empty);
        }
        T.consumeClose();
    }
    PA.Commit();
    return D.setDecompositionBindings(T.getOpenLocation(), Bindings, T.getCloseLocation());
}

fn Parser::ParseParenDeclarator(self, D: *mut Declarator) {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    T.consumeOpen();
    assert!(!D.isPastIdentifier(), "Should be called before passing identifier");
    let mut attrs: ParsedAttributes = self.AttrFactory;
    let mut RequiresArg: bool = false;
    if self.Tok.is(kw___attribute) {
        self.ParseGNUAttributes(attrs, null, null);
        RequiresArg = true;
    }
    self.ParseMicrosoftTypeAttributes(attrs);
    if self.Tok.is(kw___pascal) {
        self.ParseBorlandTypeAttributes(attrs);
    }
    let mut isGrouping: bool = false;
    if !D.mayOmitIdentifier() {
        isGrouping = true;
    } else if self.Tok.is(r_paren) || ((self.getLangOpts().CPlusPlus || self.getLangOpts().C23) && self.Tok.is(ellipsis) && self.NextToken().is(r_paren)) || self.isDeclarationSpecifier(No, false) || self.isCXX11AttributeSpecifier(false, false) != NotAttributeSpecifier {
        isGrouping = false;
    } else {
        isGrouping = true;
    }
    if isGrouping {
        let mut EllipsisLoc: SourceLocation = D.getEllipsisLoc();
        D.setEllipsisLoc(SourceLocation {});
        let mut hadGroupingParens: bool = D.hasGroupingParens();
        D.setGroupingParens(true);
        self.ParseDeclaratorInternal(D, &mut ParseDirectDeclarator);
        T.consumeClose();
        D.AddTypeInfo(getParen(T.getOpenLocation(), T.getCloseLocation()), move(attrs), T.getCloseLocation());
        D.setGroupingParens(hadGroupingParens);
        if EllipsisLoc.isValid() {
            self.DiagnoseMisplacedEllipsisInDeclarator(EllipsisLoc, D);
        }
        return;
    }
    D.SetIdentifier(null, self.Tok.getLocation());
    let mut PrototypeScope: ParseScope = ParseScope { self, FunctionPrototypeScope | DeclScope | (if D.isFunctionDeclaratorAFunctionDeclaration() { FunctionDeclarationScope } else { NoScope }), true, false };
    self.ParseFunctionDeclarator(D, attrs, T, false, RequiresArg);
    PrototypeScope.Exit();
}

fn Parser::InitCXXThisScopeForDeclaratorIfRelevant(self, D: *Declarator, DS: *DeclSpec, ThisScope: *mut CXXThisScopeRAII>) {
    let mut IsCXX11MemberFunction: bool = self.getLangOpts().CPlusPlus11 && D.getDeclSpec().getStorageClassSpec() != SCS_typedef && (if D.getContext() == Member { !D.getDeclSpec().isFriendSpecified() } else { D.getContext() == File && D.getCXXScopeSpec().isValid() && self.Actions.CurContext.isRecord() });
    if !IsCXX11MemberFunction {
        return;
    }
    let mut Q: Qualifiers = fromCVRUMask(DS.getTypeQualifiers());
    if D.getDeclSpec().hasConstexprSpecifier() && !self.getLangOpts().CPlusPlus14 {
        Q.addConst();
    }
    if self.getLangOpts().OpenCLCPlusPlus {
        for attr in DS.getAttributes() {
            let mut ASIdx: LangAS = attr.asOpenCLLangAS();
            if ASIdx != Default {
                Q.addAddressSpace(ASIdx);
                break;
            }
        }
    }
    ThisScope.emplace(self.Actions, dyn_cast(self.Actions.CurContext), Q, IsCXX11MemberFunction);
}

fn Parser::ParseFunctionDeclarator(self, D: *mut Declarator, FirstArgAttrs: *mut ParsedAttributes, Tracker: *mut BalancedDelimiterTracker, IsAmbiguous: bool, RequiresArg: bool) {
    assert!(self.getCurScope().isFunctionPrototypeScope(), "Should call from a Function scope");
    assert!(D.isPastIdentifier(), "Should not call before identifier!");
    let mut HasProto: bool = false;
    let mut ParamInfo: ParamInfo, 16> = ParamInfo, 16> {};
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    let mut DS: DeclSpec = self.AttrFactory;
    let mut RefQualifierIsLValueRef: bool = true;
    let mut RefQualifierLoc: SourceLocation = SourceLocation {};
    let mut ESpecType: ExceptionSpecificationType = EST_None;
    let mut ESpecRange: SourceRange = SourceRange {};
    let mut DynamicExceptions: SmallVector<ParsedType, 2> = SmallVector<ParsedType, 2> {};
    let mut DynamicExceptionRanges: SmallVector<SourceRange, 2> = SmallVector<SourceRange, 2> {};
    let mut NoexceptExpr: ExprResult = false;
    let mut ExceptionSpecTokens: *mut CachedTokens = null;
    let mut FnAttrs: ParsedAttributes = self.AttrFactory;
    let mut TrailingReturnType: TypeResult = false;
    let mut TrailingReturnTypeLoc: SourceLocation = SourceLocation {};
    let mut StartLoc: SourceLocation = SourceLocation {};
    let mut LocalEndLoc: SourceLocation = SourceLocation {};
    let mut EndLoc: SourceLocation = SourceLocation {};
    let mut LParenLoc: SourceLocation = SourceLocation {};
    let mut RParenLoc: SourceLocation = SourceLocation {};
    LParenLoc = Tracker.getOpenLocation();
    StartLoc = LParenLoc;
    if self.isFunctionDeclaratorIdentifierList() {
        if RequiresArg {
            self.Diag(self.Tok, err_argument_required_after_attribute);
        }
        self.ParseFunctionDeclaratorIdentifierList(D, ParamInfo);
        Tracker.consumeClose();
        RParenLoc = Tracker.getCloseLocation();
        LocalEndLoc = RParenLoc;
        EndLoc = RParenLoc;
        self.MaybeParseCXX11Attributes(FnAttrs, false);
        self.ProhibitAttributes(FnAttrs, SourceLocation {});
    } else {
        if self.Tok.isNot(r_paren) {
            self.ParseParameterDeclarationClause(D, FirstArgAttrs, ParamInfo, EllipsisLoc);
        } else if RequiresArg {
            self.Diag(self.Tok, err_argument_required_after_attribute);
        }
        HasProto = ParamInfo.len || self.getLangOpts().requiresStrictPrototypes() || self.getLangOpts().OpenCL;
        Tracker.consumeClose();
        RParenLoc = Tracker.getCloseLocation();
        LocalEndLoc = RParenLoc;
        EndLoc = RParenLoc;
        if self.getLangOpts().CPlusPlus {
            self.ParseTypeQualifierListOpt(DS, AR_NoAttributesParsed, false, false, function_ref<void ()> { Closure_13 { cap_0: self, DS: &mut DS, D: &mut D }, null, null });
            if !DS.getSourceRange().getEnd().isInvalid() {
                EndLoc = DS.getSourceRange().getEnd();
            }
            if self.ParseRefQualifier(RefQualifierIsLValueRef, RefQualifierLoc) {
                EndLoc = RefQualifierLoc;
            }
            let mut ThisScope: CXXThisScopeRAII> = CXXThisScopeRAII> {};
            self.InitCXXThisScopeForDeclaratorIfRelevant(D, DS, ThisScope);
            let mut Delayed: bool = D.getContext() == Member && D.isFunctionDeclaratorAFunctionDeclaration();
            if Delayed && self.Actions.isLibstdcxxEagerExceptionSpecHack(D) && self.GetLookAheadToken(0).is(kw_noexcept) && self.GetLookAheadToken(1).is(l_paren) && self.GetLookAheadToken(2).is(kw_noexcept) && self.GetLookAheadToken(3).is(l_paren) && self.GetLookAheadToken(4).is(identifier) && self.GetLookAheadToken(4).getIdentifierInfo().isStr("swap") {
                Delayed = false;
            }
            ESpecType = self.tryParseExceptionSpecification(Delayed, ESpecRange, DynamicExceptions, DynamicExceptionRanges, NoexceptExpr, ExceptionSpecTokens);
            if ESpecType != EST_None {
                EndLoc = ESpecRange.getEnd();
            }
            self.MaybeParseCXX11Attributes(FnAttrs, false);
            LocalEndLoc = EndLoc;
            if self.getLangOpts().CPlusPlus11 && self.Tok.is(arrow) {
                self.Diag(self.Tok, warn_cxx98_compat_trailing_return_type);
                if D.getDeclSpec().getTypeSpecType() == TST_auto {
                    StartLoc = D.getDeclSpec().getTypeSpecTypeLoc();
                }
                LocalEndLoc = self.Tok.getLocation();
                let mut Range: SourceRange = SourceRange {};
                TrailingReturnType = self.ParseTrailingReturnType(Range, D.mayBeFollowedByCXXDirectInit());
                TrailingReturnTypeLoc = Range.getBegin();
                EndLoc = Range.getEnd();
            }
        } else {
            self.MaybeParseCXX11Attributes(FnAttrs, false);
        }
    }
    let mut DeclsInPrototype: SmallVector<NamedDecl *, 0> = SmallVector<NamedDecl *, 0> {};
    if self.getCurScope().isFunctionDeclarationScope() && !self.getLangOpts().CPlusPlus {
        for D in self.getCurScope().decls() {
            let mut ND: *mut NamedDecl = dyn_cast(D);
            if !ND || isa(ND) {
                continue;
            }
            DeclsInPrototype.push(ND);
        }
        sort(DeclsInPrototype, Closure_14 {});
    }
    D.AddTypeInfo(getFunction(HasProto, IsAmbiguous, LParenLoc, ParamInfo.ptr, ParamInfo.len, EllipsisLoc, RParenLoc, RefQualifierIsLValueRef, RefQualifierLoc, SourceLocation {}, ESpecType, ESpecRange, DynamicExceptions.ptr, DynamicExceptionRanges.ptr, DynamicExceptions.len, if NoexceptExpr.isUsable() { NoexceptExpr.get() } else { null }, ExceptionSpecTokens, DeclsInPrototype, StartLoc, LocalEndLoc, D, TrailingReturnType, TrailingReturnTypeLoc, &mut DS), move(FnAttrs), EndLoc);
}

fn Parser::ParseRefQualifier(self, RefQualifierIsLValueRef: *mut bool, RefQualifierLoc: *mut SourceLocation) -> bool {
    if self.Tok.isOneOf(amp, ampamp) {
        self.DiagCompat(self.Tok, ref_qualifier);
        RefQualifierIsLValueRef = self.Tok.is(amp);
        RefQualifierLoc = self.ConsumeToken();
        return true;
    }
    return false;
}

fn Parser::isFunctionDeclaratorIdentifierList(self) -> bool {
    return !self.getLangOpts().requiresStrictPrototypes() && self.Tok.is(identifier) && !self.TryAltiVecVectorToken() && (self.TryAnnotateTypeOrScopeToken(No, false) || !self.Tok.is(annot_typename)) && (!self.Tok.is(eof) && (self.NextToken().is(comma) || self.NextToken().is(r_paren)));
}

fn Parser::ParseFunctionDeclaratorIdentifierList(self, D: *mut Declarator, ParamInfo: *mut ParamInfo>) {
    assert!(!self.getLangOpts().requiresStrictPrototypes(), "Cannot parse an identifier list in C23 or C++");
    if !D.getIdentifier() {
        self.Diag(self.Tok, ext_ident_list_in_param);
    }
    let mut ParamsSoFar: SmallPtrSet<const IdentifierInfo *, 16> = SmallPtrSet<const IdentifierInfo *, 16> {};
    while true {
        {
        if self.Tok.isNot(identifier) {
            self.Diag(self.Tok, err_expected) << identifier;
            self.SkipUntil(r_paren, StopAtSemi | StopBeforeMatch);
            ParamInfo.clear();
            return;
        }
        let mut ParmII: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        if self.Actions.getTypeName(*ParmII, self.Tok.getLocation(), self.getCurScope(), null, false, false, null, false, false, true, No, null) {
            self.Diag(self.Tok, err_unexpected_typedef_ident) << ParmII;
        }
        if !ParamsSoFar.insert(ParmII).second {
            self.Diag(self.Tok, err_param_redefinition) << ParmII;
        } else {
            ParamInfo.push(ParamInfo { ParmII, self.Tok.getLocation(), null, null });
        }
        self.ConsumeToken();
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
}

fn Parser::ParseParameterDeclarationClause(self, DeclaratorCtx: DeclaratorContext, FirstArgAttrs: *mut ParsedAttributes, ParamInfo: *mut ParamInfo>, EllipsisLoc: *mut SourceLocation, IsACXXFunctionDeclaration: bool) {
    if self.getCurScope().getFunctionPrototypeDepth() - 1 > getMaxFunctionScopeDepth() {
        self.Diag(self.Tok.getLocation(), err_function_scope_depth_exceeded) << getMaxFunctionScopeDepth();
        self.cutOffParsing();
        return;
    }
    let mut AllowImplicitTypename: ImplicitTypenameContext = No;
    if DeclaratorCtx == Member || DeclaratorCtx == LambdaExpr || DeclaratorCtx == RequiresExpr || IsACXXFunctionDeclaration {
        AllowImplicitTypename = Yes;
    }
    while true {
        {
        if self.TryConsumeToken(ellipsis, EllipsisLoc) {
            break;
        }
        let mut DS: DeclSpec = self.AttrFactory;
        let mut ArgDeclAttrs: ParsedAttributes = self.AttrFactory;
        let mut ArgDeclSpecAttrs: ParsedAttributes = self.AttrFactory;
        if FirstArgAttrs.Range.isValid() {
            ArgDeclSpecAttrs.takeAllPrependingFrom(FirstArgAttrs);
        } else {
            self.MaybeParseCXX11Attributes(ArgDeclAttrs, false);
            self.MaybeParseMicrosoftAttributes(ArgDeclSpecAttrs);
        }
        let mut DSStart: SourceLocation = self.Tok.getLocation();
        let mut ThisLoc: SourceLocation = SourceLocation {};
        if self.getLangOpts().CPlusPlus && self.Tok.is(kw_this) {
            ThisLoc = self.ConsumeToken();
        }
        let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
        self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS_none, DSC_normal, null, AllowImplicitTypename);
        DS.takeAttributesAppendingingFrom(ArgDeclSpecAttrs);
        let mut ParmDeclarator: Declarator = Declarator { DS, ArgDeclAttrs, if DeclaratorCtx == RequiresExpr { RequiresExpr } else { if DeclaratorCtx == LambdaExpr { LambdaExprParameter } else { Prototype } } };
        self.ParseDeclarator(ParmDeclarator);
        if ThisLoc.isValid() {
            ParmDeclarator.SetRangeBegin(ThisLoc);
        }
        self.MaybeParseGNUAttributes(ParmDeclarator, null);
        if self.getLangOpts().HLSL {
            self.MaybeParseHLSLAnnotations(DS.getAttributes(), null);
        }
        if self.Tok.is(kw_requires) {
            self.Diag(self.Tok, err_requires_clause_on_declarator_not_declaring_a_function);
            self.ConsumeToken();
            self.ParseConstraintLogicalOrExpression(true);
        }
        let mut ParmII: *IdentifierInfo = ParmDeclarator.getIdentifier();
        let mut DefArgToks: unique_ptr<CachedTokens> = unique_ptr<CachedTokens> {};
        if DS.isEmpty() && ParmDeclarator.getIdentifier() == null && ParmDeclarator.getNumTypeObjects() == 0 {
            self.Diag(DSStart, err_missing_param);
        } else {
            if self.Tok.is(ellipsis) && (self.NextToken().isNot(r_paren) || (!ParmDeclarator.getEllipsisLoc().isValid() && !self.Actions.isUnexpandedParameterPackPermitted())) && self.Actions.containsUnexpandedParameterPacks(ParmDeclarator) {
                self.DiagnoseMisplacedEllipsisInDeclarator(self.ConsumeToken(), ParmDeclarator);
            }
            if !ParmDeclarator.isInvalidType() && !ParmDeclarator.hasName() && self.Tok.isNot(raw_identifier) && !self.Tok.isAnnotation() && self.Tok.getIdentifierInfo() && self.Tok.getIdentifierInfo().isKeyword(self.getLangOpts()) {
                self.Diag(self.Tok, err_keyword_as_parameter) << self.PP.getSpelling(self.Tok, null);
                self.ConsumeToken();
            }
            if ParamInfo.len == FunctionTypeNumParamsLimit {
                self.Diag(ParmDeclarator.getBeginLoc(), err_function_parameter_limit_exceeded);
                self.SkipUntil(r_paren, StopBeforeMatch);
                break;
            }
            let mut Param: *mut Decl = self.Actions.ActOnParamDeclarator(self.getCurScope(), ParmDeclarator, ThisLoc);
            if self.Tok.is(equal) {
                let mut EqualLoc: SourceLocation = self.Tok.getLocation();
                if DeclaratorCtx == Member {
                    DefArgToks.reset(CachedTokens {});
                    let mut ArgStartLoc: SourceLocation = self.NextToken().getLocation();
                    self.ConsumeAndStoreInitializer(operator(DefArgToks), DefaultArgument);
                    self.Actions.ActOnParamUnparsedDefaultArgument(Param, EqualLoc, ArgStartLoc);
                } else {
                    self.ConsumeToken();
                    let mut DontDestructTemplateIds: DelayTemplateIdDestructionRAII = DelayTemplateIdDestructionRAII { *self, true };
                    let mut Eval: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, PotentiallyEvaluatedIfUsed, Param, EK_Other, true };
                    let mut DefArgResult: ExprResult = false;
                    if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
                        self.Diag(self.Tok, compat_cxx11_generalized_initializer_lists);
                        DefArgResult = self.ParseBraceInitializer();
                    } else {
                        if self.Tok.is(l_paren) && self.NextToken().is(l_brace) {
                            self.Diag(self.Tok, err_stmt_expr_in_default_arg) << 0;
                            self.Actions.ActOnParamDefaultArgumentError(Param, EqualLoc, null);
                            self.SkipUntil(comma, StopBeforeMatch);
                            DefArgResult = ExprError();
                        } else {
                            DefArgResult = self.ParseAssignmentExpression(AllowNonTypes);
                        }
                    }
                    if DefArgResult.isInvalid() {
                        self.Actions.ActOnParamDefaultArgumentError(Param, EqualLoc, null);
                        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch);
                    } else {
                        self.Actions.ActOnParamDefaultArgument(Param, EqualLoc, DefArgResult.get());
                    }
                }
            }
            ParamInfo.push(ParamInfo { ParmII, ParmDeclarator.getIdentifierLoc(), Param, move(DefArgToks) });
        }
        if self.TryConsumeToken(ellipsis, EllipsisLoc) {
            if self.getLangOpts().CPlusPlus26 {
                self.Diag(EllipsisLoc, warn_deprecated_missing_comma_before_ellipsis) << CreateInsertion(EllipsisLoc, ", ", false);
            }
            if !self.getLangOpts().CPlusPlus {
                self.Diag(EllipsisLoc, err_missing_comma_before_ellipsis) << CreateInsertion(EllipsisLoc, ", ", false);
            } else if ParmDeclarator.getEllipsisLoc().isValid() || self.Actions.containsUnexpandedParameterPacks(ParmDeclarator) {
                let mut ParmEllipsis: SourceLocation = ParmDeclarator.getEllipsisLoc();
                self.Diag(EllipsisLoc, warn_misplaced_ellipsis_vararg) << ParmEllipsis.isValid() << ParmEllipsis;
                if ParmEllipsis.isValid() {
                    self.Diag(ParmEllipsis, note_misplaced_ellipsis_vararg_existing_ellipsis);
                } else {
                    self.Diag(ParmDeclarator.getIdentifierLoc(), note_misplaced_ellipsis_vararg_add_ellipsis) << CreateInsertion(ParmDeclarator.getIdentifierLoc(), "...", false) << !ParmDeclarator.hasName();
                }
                self.Diag(EllipsisLoc, note_misplaced_ellipsis_vararg_add_comma) << CreateInsertion(EllipsisLoc, ", ", false);
            }
            break;
        }
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
}

fn Parser::ParseBracketDeclarator(self, D: *mut Declarator) {
    if self.CheckProhibitedCXX11Attribute() {
        return;
    }
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
    T.consumeOpen();
    if self.Tok.getKind() == r_square {
        T.consumeClose();
        let mut attrs: ParsedAttributes = self.AttrFactory;
        self.MaybeParseCXX11Attributes(attrs, false);
        D.AddTypeInfo(getArray(0, false, false, null, T.getOpenLocation(), T.getCloseLocation()), move(attrs), T.getCloseLocation());
        return;
    } else if self.Tok.getKind() == numeric_constant && self.GetLookAheadToken(1).is(r_square) {
        let mut ExprRes: ExprResult = self.Actions.ActOnNumericConstant(self.Tok, self.getCurScope());
        self.ConsumeToken();
        T.consumeClose();
        let mut attrs: ParsedAttributes = self.AttrFactory;
        self.MaybeParseCXX11Attributes(attrs, false);
        D.AddTypeInfo(getArray(0, false, false, ExprRes.get(), T.getOpenLocation(), T.getCloseLocation()), move(attrs), T.getCloseLocation());
        return;
    } else if self.Tok.getKind() == code_completion {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteBracketDeclarator(self.getCurScope());
        return;
    }
    let mut StaticLoc: SourceLocation = SourceLocation {};
    self.TryConsumeToken(kw_static, StaticLoc);
    let mut DS: DeclSpec = self.AttrFactory;
    self.ParseTypeQualifierListOpt(DS, AR_CXX11AttributesParsed, true, false, function_ref<void ()> {});
    if !StaticLoc.isValid() {
        self.TryConsumeToken(kw_static, StaticLoc);
    }
    let mut isStar: bool = false;
    let mut NumElements: ExprResult = false;
    if self.Tok.is(star) && self.GetLookAheadToken(1).is(r_square) {
        self.ConsumeToken();
        if StaticLoc.isValid() {
            self.Diag(StaticLoc, err_unspecified_vla_size_with_static);
            StaticLoc = SourceLocation {};
        }
        isStar = true;
    } else if self.Tok.isNot(r_square) {
        if self.getLangOpts().CPlusPlus {
            NumElements = self.ParseArrayBoundExpression();
        } else {
            let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
            NumElements = self.ParseAssignmentExpression(AllowNonTypes);
        }
    } else {
        if StaticLoc.isValid() {
            self.Diag(StaticLoc, err_unspecified_size_with_static);
            StaticLoc = SourceLocation {};
        }
    }
    if NumElements.isInvalid() {
        D.setInvalidType(true);
        self.SkipUntil(r_square, StopAtSemi);
        return;
    }
    T.consumeClose();
    self.MaybeParseCXX11Attributes(DS.getAttributes(), false);
    D.AddTypeInfo(getArray(DS.getTypeQualifiers(), StaticLoc.isValid(), isStar, NumElements.get(), T.getOpenLocation(), T.getCloseLocation()), move(DS.getAttributes()), T.getCloseLocation());
}

fn Parser::ParseMisplacedBracketDeclarator(self, D: *mut Declarator) {
    assert!(self.Tok.is(l_square), "Missing opening bracket");
    assert!(!D.mayOmitIdentifier(), "Declarator cannot omit identifier");
    let mut StartBracketLoc: SourceLocation = self.Tok.getLocation();
    let mut TempDeclarator: Declarator = Declarator { D.getDeclSpec(), none(), D.getContext() };
    while self.Tok.is(l_square) {
        self.ParseBracketDeclarator(TempDeclarator);
    }
    if self.Tok.is(semi) {
        D.getName().EndLocation = StartBracketLoc;
    }
    let mut SuggestParenLoc: SourceLocation = self.Tok.getLocation();
    self.ParseDeclaratorInternal(D, &mut ParseDirectDeclarator);
    if TempDeclarator.getNumTypeObjects() == 0 {
        return;
    }
    let mut NeedParens: bool = false;
    if D.getNumTypeObjects() != 0 {
        match D.getTypeObject(D.getNumTypeObjects() - 1).Kind {
            Pointer => {
                Reference;
            },
            Array => {
                Function;
            },
        }
    }
    if NeedParens {
        let mut EndLoc: SourceLocation = self.PP.getLocForEndOfToken(D.getEndLoc(), 0);
        D.AddTypeInfo(getParen(SuggestParenLoc, EndLoc), SourceLocation {});
    }
    for let mut i: u32 = 0;
let mut e: u32 = TempDeclarator.getNumTypeObjects(); i < e; i += 1 {
        let mut Chunk: *DeclaratorChunk = TempDeclarator.getTypeObject(i);
        D.AddTypeInfo(Chunk, TempDeclarator.getAttributePool(), SourceLocation {});
    }
    if !D.hasName() && !NeedParens {
        return;
    }
    let mut EndBracketLoc: SourceLocation = TempDeclarator.getEndLoc();
    let mut BracketRange: SourceRange = SourceRange { B: StartBracketLoc, E: EndBracketLoc };
    let mut EndLoc: SourceLocation = self.PP.getLocForEndOfToken(D.getEndLoc(), 0);
    if NeedParens {
        self.Diag(EndLoc, err_brackets_go_after_unqualified_id) << self.getLangOpts().CPlusPlus << CreateInsertion(SuggestParenLoc, "(", false) << CreateInsertion(EndLoc, ")", false) << CreateInsertionFromRange(EndLoc, CharSourceRange { Range: BracketRange, IsTokenRange: true }, false) << CreateRemoval(BracketRange);
    } else {
        self.Diag(EndLoc, err_brackets_go_after_unqualified_id) << self.getLangOpts().CPlusPlus << CreateInsertionFromRange(EndLoc, CharSourceRange { Range: BracketRange, IsTokenRange: true }, false) << CreateRemoval(BracketRange);
    }
}

fn Parser::ParseTypeofSpecifier(self, DS: *mut DeclSpec) {
    assert!(self.Tok.isOneOf(kw_typeof, kw_typeof_unqual), "Not a typeof specifier");
    let mut IsUnqual: bool = self.Tok.is(kw_typeof_unqual);
    let mut II: *IdentifierInfo = self.Tok.getIdentifierInfo();
    if self.getLangOpts().C23 && !II.getName().starts_with("__") {
        self.Diag(self.Tok.getLocation(), warn_c23_compat_keyword) << self.Tok.getName();
    }
    let mut OpTok: Token = self.Tok;
    let mut StartLoc: SourceLocation = self.ConsumeToken();
    let mut HasParens: bool = self.Tok.is(l_paren);
    let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, ReuseLambdaContextDecl, EK_Other };
    let mut isCastExpr: bool = false;
    let mut CastTy: ParsedType = null;
    let mut CastRange: SourceRange = SourceRange {};
    let mut Operand: ExprResult = self.ParseExprAfterUnaryExprOrTypeTrait(OpTok, isCastExpr, CastTy, CastRange);
    if HasParens {
        DS.setTypeArgumentRange(CastRange);
    }
    if CastRange.getEnd().isInvalid() {
        DS.SetRangeEnd(self.Tok.getLocation());
    } else {
        DS.SetRangeEnd(CastRange.getEnd());
    }
    if isCastExpr {
        if !CastTy {
            DS.SetTypeSpecError();
            return;
        }
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        if DS.SetTypeSpecType(if IsUnqual { TST_typeof_unqualType } else { TST_typeofType }, StartLoc, PrevSpec, DiagID, CastTy, self.Actions.getASTContext().getPrintingPolicy()) {
            self.Diag(StartLoc, DiagID) << PrevSpec;
        }
        return;
    }
    if Operand.isInvalid() {
        DS.SetTypeSpecError();
        return;
    }
    Operand = self.Actions.HandleExprEvaluationContextForTypeof(Operand.get());
    if Operand.isInvalid() {
        DS.SetTypeSpecError();
        return;
    }
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    if DS.SetTypeSpecType(if IsUnqual { TST_typeof_unqualExpr } else { TST_typeofExpr }, StartLoc, PrevSpec, DiagID, Operand.get(), self.Actions.getASTContext().getPrintingPolicy()) {
        self.Diag(StartLoc, DiagID) << PrevSpec;
    }
}

fn Parser::ParseAtomicSpecifier(self, DS: *mut DeclSpec) {
    assert!(self.Tok.is(kw__Atomic) && self.NextToken().is(l_paren), "Not an atomic specifier");
    let mut StartLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        return;
    }
    let mut Result: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
    if Result.isInvalid() {
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    T.consumeClose();
    if T.getCloseLocation().isInvalid() {
        return;
    }
    DS.setTypeArgumentRange(T.getRange());
    DS.SetRangeEnd(T.getCloseLocation());
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    if DS.SetTypeSpecType(TST_atomic, StartLoc, PrevSpec, DiagID, Result.get(), self.Actions.getASTContext().getPrintingPolicy()) {
        self.Diag(StartLoc, DiagID) << PrevSpec;
    }
}

fn Parser::TryAltiVecVectorTokenOutOfLine(self) -> bool {
    let mut Next: Token = self.NextToken();
    match Next.getKind() {
        _ => {
            return false;
        },
        kw_short => {
            kw_long;
        },
        identifier => {
            if Next.getIdentifierInfo() == self.Ident_pixel {
                self.Tok.setKind(kw___vector);
                return true;
            }
        },
    }
}

fn Parser::TryAltiVecTokenOutOfLine(self, DS: *mut DeclSpec, Loc: SourceLocation, PrevSpec: **mut u8, DiagID: *mut u32, isInvalid: *mut bool) -> bool {
    let mut Policy: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
    if self.Tok.getIdentifierInfo() == self.Ident_vector {
        let mut Next: Token = self.NextToken();
        match Next.getKind() {
            kw_short => {
                kw_long;
            },
            identifier => {
                if Next.getIdentifierInfo() == self.Ident_pixel {
                    isInvalid = DS.SetTypeAltiVecVector(true, Loc, PrevSpec, DiagID, Policy);
                    return true;
                }
            },
            _ => {
                break;
            },
        }
    } else if (self.Tok.getIdentifierInfo() == self.Ident_pixel) && DS.isTypeAltiVecVector() {
        isInvalid = DS.SetTypeAltiVecPixel(true, Loc, PrevSpec, DiagID, Policy);
        return true;
    } else if (self.Tok.getIdentifierInfo() == self.Ident_bool) && DS.isTypeAltiVecVector() {
        isInvalid = DS.SetTypeAltiVecBool(true, Loc, PrevSpec, DiagID, Policy);
        return true;
    }
    return false;
}

fn Parser::ParseTypeFromString(self, TypeStr: str, Context: str, IncludeLoc: SourceLocation) -> TypeResult {
    let mut Tokens: SmallVector<Token, 4> = SmallVector<Token, 4> {};
    {
        let mut SourceMgr: *mut SourceManager = self.PP.getSourceManager();
        let mut FID: FileID = SourceMgr.createFileID(getMemBufferCopy(TypeStr, Context), C_User, 0, 0, IncludeLoc);
        let mut L: Lexer = Lexer { FID, SourceMgr.getBufferOrFake(FID, SourceLocation {}), self.PP, true };
        L.setParsingPreprocessorDirective(true);
        let mut Tok: Token = Token {};
        while true {
            {
            L.Lex(Tok);
            Tokens.push(Tok);
        }
            if !(Tok.isNot(eod)) { break; }
        }
    }
    let mut EndToken: *mut Token = Tokens.back();
    EndToken.startToken();
    EndToken.setKind(eof);
    EndToken.setLocation(self.Tok.getLocation());
    EndToken.setEofData(TypeStr.ptr);
    Tokens.push(self.Tok);
    self.PP.EnterTokenStream(Tokens, false, false);
    self.ConsumeAnyToken(false);
    let mut LocalScope: ParseScope = ParseScope { self, 0, true, false };
    let mut Result: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
    if Result.isUsable() && (self.Tok.isNot(eof) || self.Tok.getEofData() != TypeStr.ptr) {
        self.Diag(self.Tok.getLocation(), err_type_unparsed);
    }
    while self.Tok.isNot(eof) {
        self.ConsumeAnyToken(false);
    }
    if self.Tok.is(eof) && self.Tok.getEofData() == TypeStr.ptr {
        self.ConsumeAnyToken(false);
    }
    return Result;
}

fn Parser::DiagnoseBitIntUse(self, Tok: *Token) {
    assert!(Tok.isOneOf(kw__ExtInt, kw__BitInt), "expected either an _ExtInt or _BitInt token!");
    let mut Loc: SourceLocation = Tok.getLocation();
    if Tok.is(kw__ExtInt) {
        self.Diag(Loc, warn_ext_int_deprecated) << CreateReplacement(Loc, "_BitInt");
    } else {
        if self.getLangOpts().C23 {
            self.Diag(Loc, warn_c23_compat_keyword) << Tok.getName();
        } else {
            self.Diag(Loc, ext_bit_int) << self.getLangOpts().CPlusPlus;
        }
    }
}

