    return self.Actions.FinalizeDeclaratorGroup(self.getCurScope(), DS);
}

fn Parser::ParseAsmAttributesAfterDeclarator(self, D: *mut Declarator) -> bool {
    if self.Tok.is(kw_asm) {
        let mut Loc: SourceLocation = SourceLocation {};
        let mut AsmLabel: i32 = 0;
        if AsmLabel()() {
            self.SkipUntil(semi, StopBeforeMatch);
            return true;
        }
        D.setAsmLabel();
        D.SetRangeEnd(Loc);
    }
    self.MaybeParseGNUAttributes(D, null);
    return false;
}

fn Parser::ParseDeclarationAfterDeclarator(self, D: *mut Declarator, TemplateInfo: *ParsedTemplateInfo) -> *mut Decl {
    if self.ParseAsmAttributesAfterDeclarator(D) {
        return null;
    }
    return self.ParseDeclarationAfterDeclaratorAndAttributes(D, TemplateInfo, null);
}

fn Parser::ParseDeclarationAfterDeclaratorAndAttributes(self, D: *mut Declarator, TemplateInfo: *ParsedTemplateInfo, FRI: *mut ForRangeInit) -> *mut Decl {
    let mut TheInitKind: InitKind = zeroed();
    if self.isTokenEqualOrEqualTypo() {
        TheInitKind = Equal;
    } else if self.Tok.is(l_paren) {
        TheInitKind = CXXDirect;
    } else if self.getLangOpts() && self.Tok.is(l_brace) && (!self.CurParsedObjCImpl || !D.isFunctionDeclarator()) {
        TheInitKind = CXXBraced;
    } else {
        TheInitKind = Uninitialized;
    }
    if TheInitKind != Uninitialized {
        D.setHasInitializer(true);
    }
    let mut ThisDecl: *mut Decl = null;
    let mut OuterDecl: *mut Decl = null;
    match TemplateInfo.Kind {
        NonTemplate => {
            ThisDecl = self.Actions.ActOnDeclarator(self.getCurScope(), D);
        },
        Template => {
            ExplicitSpecialization;
        },
        ExplicitInstantiation => {
            if self.Tok.is(semi) {
                let mut ThisRes: i32 = self.Actions(self.getCurScope(), TemplateInfo.ExternLoc, TemplateInfo.TemplateLoc, D);
                if ThisRes()() {
                    self.SkipUntil(semi, StopBeforeMatch);
                    return null;
                }
                ThisDecl = ();
            } else {
                if D.getName().getKind() != IK_TemplateId {
                     << 2 << CreateRemoval(TemplateInfo.TemplateLoc);
                    ThisDecl = self.Actions.ActOnDeclarator(self.getCurScope(), D);
                } else {
                    let mut LAngleLoc: SourceLocation = self.PP.getLocForEndOfToken(TemplateInfo.TemplateLoc, 0);
                     << TemplateInfo.TemplateLoc << CreateInsertion(LAngleLoc, "<>", false);
                    let mut FakedParamLists: TemplateParameterLists = zeroed();
                    FakedParamLists()(self.Actions.ActOnTemplateParameterList);
                    ThisDecl = self.Actions.ActOnTemplateDeclarator(self.getCurScope(), D);
                }
            }
            break;
        },
    }
    let mut X: CUDATargetContextRAII = CUDATargetContextRAII { self.Actions.CUDA(), CTCK_InitGlobalVar, ThisDecl };
    match TheInitKind {
        Equal => {
            let mut EqualLoc: SourceLocation = self.ConsumeToken();
            if self.Tok.is(kw_delete) {
                if D.isFunctionDeclarator() {
                    << 1;
                } else {
                    
                }
                self.SkipDeletedFunctionBody();
            } else if self.Tok.is(kw_default) {
                if D.isFunctionDeclarator() {
                    << 0;
                } else {
                    << self.getLangOpts();
                }
            } else {
                let mut InitScope: InitializerScopeRAII = InitializerScopeRAII { *self, D, ThisDecl };
                if self.Tok.is(code_completion) {
                    self.cutOffParsing();
                    self.Actions.CodeCompletion().CodeCompleteInitializer(self.getCurScope(), ThisDecl);
                    self.Actions.FinalizeDeclaration(ThisDecl);
                    return null;
                }
                let mut Init: i32 = 0;
                if self.Tok.is(r_paren) && FRI && D.isFirstDeclarator() {
                     << CreateReplacement(EqualLoc, ":");
                    FRI.ColonLoc = EqualLoc;
                    FRI() = ;
                }
                if Init()() {
                    let mut StopTokens: TokenKind, 2> = zeroed();
                    StopTokens()(comma);
                    if D.getContext() == ForInit || D.getContext() == SelectionInit {
                        StopTokens()(r_paren);
                    }
                    (StopAtSemi | StopBeforeMatch);
                    self.Actions.ActOnInitializerError(ThisDecl);
                } else {
                    self.Actions.AddInitializerToDecl(ThisDecl, false);
                }
            }
            break;
        },
        CXXDirect => {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
            T.consumeOpen();
            let mut Exprs: ExprVector = zeroed();
            let mut InitScope: InitializerScopeRAII = InitializerScopeRAII { *self, D, ThisDecl };
            let mut ThisVarDecl: auto = dyn_cast_or_null(ThisDecl);
            let mut RunSignatureHelp: Closure_2 = Closure_2 { cap_0: self, ThisDecl: &mut ThisDecl, T: &mut T };
            let mut SetPreferredType: Closure_3 = Closure_3 { cap_0: self, RunSignatureHelp: &mut RunSignatureHelp };
            let mut ExpressionStarts: function_ref<void ()> = zeroed();
            if ThisVarDecl() {
                ExpressionStarts() = SetPreferredType;
            }
            let mut SawError: bool = self.ParseExpressionList();
            if SawError {
                if ThisVarDecl() && self.PP.isCodeCompletionReached() && !self.CalledSignatureHelp {
                    self.Actions.CodeCompletion().ProduceConstructorSignatureHelp(()(), ThisDecl.getLocation(), T.getOpenLocation(), false);
                    self.CalledSignatureHelp = true;
                }
                self.Actions.ActOnInitializerError(ThisDecl);
                self.SkipUntil(r_paren, StopAtSemi);
            } else {
                T.consumeClose();
                let mut Initializer: i32 = self.Actions(T.getOpenLocation(), T.getCloseLocation());
                self.Actions.AddInitializerToDecl(ThisDecl, true);
            }
            break;
        },
        CXXBraced => {
            let mut InitScope: InitializerScopeRAII = InitializerScopeRAII { *self, D, ThisDecl };
            let mut Init: i32 = 0;
            if Init()() {
                self.Actions.ActOnInitializerError(ThisDecl);
            } else {
                self.Actions.AddInitializerToDecl(ThisDecl, true);
            }
            break;
        },
        Uninitialized => {
            let mut InitScope: InitializerScopeRAII = InitializerScopeRAII { *self, D, ThisDecl };
            self.Actions.ActOnUninitializedDecl(ThisDecl);
            break;
        },
    }
    self.Actions.FinalizeDeclaration(ThisDecl);
    return if OuterDecl {} else { ThisDecl };
}

fn Parser::ParseSpecifierQualifierList(self, DS: *mut DeclSpec, AllowImplicitTypename: ImplicitTypenameContext, AS: AccessSpecifier, DSC: DeclSpecContext) {
    let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
    self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS, DSC, null, AllowImplicitTypename);
    let mut Specs: u32 = DS.getParsedSpecifiers();
    if isTypeSpecifier(DSC) && !DS.hasTypeSpecifier() {
        DS.SetTypeSpecError();
    } else if Specs == PQ_None && !DS.hasAttributes() {
        if !DS.hasTypeSpecifier() {
            DS.SetTypeSpecError();
        }
    }
    if Specs & PQ_StorageClassSpecifier {
        if DS.getStorageClassSpecLoc().isValid() {
            
        } else {
            
        }
        DS.ClearStorageClassSpecs();
    }
    if Specs & PQ_FunctionSpecifier {
        if DS.isInlineSpecified() {
            
        }
        if DS.isVirtualSpecified() {
            
        }
        if DS.hasExplicitSpecifier() {
            
        }
        if DS.isNoreturnSpecified() {
            
        }
        DS.ClearFunctionSpecs();
    }
    if DS.hasConstexprSpecifier() && DSC != DSC_condition {
         << DS.getConstexprSpecifier() as i32;
        DS.ClearConstexprSpec();
    }
}

fn isValidAfterIdentifierInDeclarator(T: *Token) -> bool {
    return T;
}

fn Parser::ParseImplicitInt(self, DS: *mut DeclSpec, SS: *mut CXXScopeSpec, TemplateInfo: *mut ParsedTemplateInfo, AS: AccessSpecifier, DSC: DeclSpecContext, Attrs: *mut ParsedAttributes) -> bool {
    assert!(self.Tok.is(identifier), "should have identifier");
    let mut Loc: SourceLocation = self.Tok.getLocation();
    assert!(!DS.hasTypeSpecifier(), "Type specifier checked above");
    if !isTypeSpecifier(DSC) && self.getLangOpts().isImplicitIntAllowed() && isValidAfterIdentifierInDeclarator(self.NextToken()) {
        return false;
    }
    if self.getLangOpts() && DS.isTypeSpecPipe() {
        return false;
    }
    if self.getLangOpts() && DS.getStorageClassSpec() == SCS_auto {
        if SS {
            self.AnnotateScopeToken(*SS, false);
        }
        return false;
    }
    if self.getLangOpts() && (!SS || SS.isEmpty()) && self.getLangOpts() {
        if  {
            let mut PrevSpec: *u8 = null;
            let mut DiagID: u32 = 0;
            DS(TST_typename, Loc, PrevSpec, DiagID, self.Actions.getASTContext().getPrintingPolicy());
            DS.SetRangeEnd(self.Tok.getLocation());
            self.ConsumeToken();
            return false;
        }
    }
    if SS == null {
        let mut TagName: *u8 = null;
        let mut FixitTagName: *u8 = null;
        let mut TagKind: TokenKind = unknown;
        match self.Actions.isTagName(*self.Tok.getIdentifierInfo(), self.getCurScope()) {
            _ => {
                break;
            },
            TST_enum => {
                TagName = "enum";
            },
            TST_union => {
                TagName = "union";
            },
            TST_struct => {
                TagName = "struct";
            },
            TST_interface => {
                TagName = "__interface";
            },
            TST_class => {
                TagName = "class";
            },
        }
        if TagName {
            let mut TokenName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            let mut R: LookupResult = LookupResult { self.Actions, TokenName, SourceLocation {}, LookupOrdinaryName, NotForRedeclaration };
             << TokenName << TagName << self.getLangOpts() << CreateInsertion(self.Tok.getLocation(), FixitTagName, false);
            if self.Actions.LookupName(R, self.getCurScope(), false, false) {
                for let mut I: iterator = R.begin();
let mut IEnd: iterator = R.end(); I(IEnd); I() {
                    << TokenName << TagName;
                }
            }
            if TagKind == kw_enum {
                self.ParseEnumSpecifier(Loc, DS, TemplateInfo, AS, DSC_normal);
            } else {
                self.ParseClassSpecifier(TagKind, Loc, DS, TemplateInfo, AS, false, DSC_normal, Attrs);
            }
            return true;
        }
    }
    if !isTypeSpecifier(DSC) && (!SS || DSC == DSC_top_level || DSC == DSC_class) {
        match self.NextToken().getKind() {
            l_paren => {
                let mut PA: TentativeParsingAction = TentativeParsingAction { *self, false };
                self.ConsumeToken();
                let mut TPR: TPResult = self.TryParseDeclarator(false, true, false, false);
                PA.Revert();
                if TPR != False {
                    break;
                }
                if DSC == DSC_class || (DSC == DSC_top_level && SS) {
                    let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
                    if self.Actions.isCurrentClassNameTypo(II, SS) {
                         << self.Tok.getIdentifierInfo() << II << CreateReplacement(self.Tok.getLocation(), II.getName());
                        self.Tok.setIdentifierInfo(II);
                    }
                }
            },
            comma => {
                equal;
            },
            _ => {
                break;
            },
        }
    }
    let mut T: ParsedType = zeroed();
    let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut IsTemplateName: bool = self.getLangOpts() && self.NextToken().is(less);
    self.Actions.DiagnoseUnknownTypeName(II, Loc, self.getCurScope(), SS, IsTemplateName);
    if T() {
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        DS(TST_typename, Loc, PrevSpec, DiagID, self.Actions.getASTContext().getPrintingPolicy());
        DS.SetRangeEnd(self.Tok.getLocation());
        self.ConsumeToken();
        return true;
    } else if II != self.Tok.getIdentifierInfo() {
        self.Tok.setKind(II.getTokenID());
        return true;
    }
    DS.SetTypeSpecError();
    DS.SetRangeEnd(self.Tok.getLocation());
    self.ConsumeToken();
    if IsTemplateName {
        let mut LAngle: SourceLocation = SourceLocation {};
        let mut RAngle: SourceLocation = SourceLocation {};
        let mut Args: TemplateArgList = zeroed();
        self.ParseTemplateIdAfterTemplateName(true, LAngle, RAngle);
    }
    return true;
}

fn Parser::getDeclSpecContextFromDeclaratorContext(self, Context: DeclaratorContext) -> DeclSpecContext {
    match Context {
        Member => {
            return DSC_class;
        },
        File => {
            return DSC_top_level;
        },
        TemplateParam => {
            return DSC_template_param;
        },
        TemplateArg => {
            return DSC_template_arg;
        },
        TemplateTypeArg => {
            return DSC_template_type_arg;
        },
        TrailingReturn => {
            TrailingReturnVar;
        },
        AliasDecl => {
            AliasTemplate;
        },
        Association => {
            return DSC_association;
        },
        TypeName => {
            return DSC_type_specifier;
        },
        Condition => {
            return DSC_condition;
        },
        ConversionId => {
            return DSC_conv_operator;
        },
        CXXNew => {
            return DSC_new;
        },
        Prototype => {
            ObjCResult;
        },
    }
    llvm_unreachable_internal("Missing DeclaratorContext case", "clang\\lib\\Parse\\ParseDecl.cpp", 3102);
}

fn Parser::ParseAlignArgument(self, KWName: str, Start: SourceLocation, EllipsisLoc: *mut SourceLocation, IsType: *mut bool, TypeResult: *mut ParsedType) -> i32 {
    let mut ER: i32 = 0;
    if self.isTypeIdInParens() {
        let mut TypeLoc: SourceLocation = self.Tok.getLocation();
        let mut Ty: ParsedType = zeroed();
        let mut TypeRange: SourceRange = SourceRange { B: Start, E: self.Tok.getLocation() };
        TypeResult = ;
        IsType = true;
    } else {
        IsType = false;
    }
    if self.getLangOpts() {
        self.TryConsumeToken(ellipsis, EllipsisLoc);
    }
    return ;
}

fn Parser::ParseAlignmentSpecifier(self, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation) {
    assert!(self.Tok, "Not an alignment-specifier!");
    let mut KWTok: Token = self.Tok;
    let mut KWName: *mut IdentifierInfo = KWTok.getIdentifierInfo();
    let mut Kind: TokenKind = KWTok.getKind();
    let mut KWLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume("", unknown) {
        return;
    }
    let mut IsType: bool = false;
    let mut TypeResult: ParsedType = zeroed();
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    let mut ArgExpr: i32 = 0;
    if ArgExpr()() {
        T.skipToEnd();
        return;
    }
    T.consumeClose();
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
    if IsType {
        Attrs.addNewTypeAttr(KWName, KWLoc, AttributeScopeInfo {}, Kind, EllipsisLoc);
    } else {
        let mut ArgExprs: ArgsVector = zeroed();
        ArgExprs()();
        Attrs(KWName, KWLoc, AttributeScopeInfo {}, 1, Kind, EllipsisLoc);
    }
}

