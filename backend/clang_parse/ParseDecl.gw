fn Parser::ParseIdentifierLoc(self) -> *mut IdentifierLoc {
    assert!(self.Tok.is(identifier), "expected an identifier");
    let mut IL: *mut IdentifierLoc = IdentifierLoc { Loc: self.Tok.getLocation(), II: self.Tok.getIdentifierInfo() };
    self.ConsumeToken();
    return IL;
}

fn Parser::ParseAttributeWithTypeArg(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    Parens.consumeOpen();
    let mut T: i32 = 0;
    if Parens.consumeClose() {
        return;
    }
    if T()() {
        return;
    }
    if T()() {
        Attrs.addNewTypeAttr(&mut AttrName, SourceRange { B: AttrNameLoc, E: Parens.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, Form);
    } else {
        Attrs.addNew(&mut AttrName, SourceRange { B: AttrNameLoc, E: Parens.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, null, 0, Form, SourceLocation {});
    }
}

fn Parser::ParseUnevaluatedStringInAttribute(self, AttrName: *IdentifierInfo) -> i32 {
    if self.Tok.is(l_paren) {
        let mut Paren: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        Paren.consumeOpen();
        let mut Res: i32 = 0;
        Paren.consumeClose();
        return ;
    }
    if !self.isTokenStringLiteral() {
         << 4 << AttrName.getName();
    }
}

fn Parser::ParseAttributeArgumentList(self, AttrName: *IdentifierInfo, Exprs: *mut SmallVectorImpl<Expr *>, ArgsProperties: ParsedAttributeArgumentsProperties, Arg: u32) -> bool {
    let mut SawError: bool = false;
    while true {
        let mut Expr: i32 = 0;
        if ArgsProperties.isStringLiteralArg(Arg) {} else if self.getLangOpts() && self.Tok.is(l_brace) {} else {}
        if self.Tok.is(ellipsis) {
            Expr() = self.Actions.ActOnPackExpansion(self.ConsumeToken());
        } else if self.Tok.is(code_completion) {
            SawError = true;
            self.cutOffParsing();
            break;
        }
        if Expr()() {
            SawError = true;
            break;
        }
        if self.Actions() {
            SawError = true;
            break;
        }
        Exprs()();
        if self.Tok.isNot(comma) {
            break;
        }
        let mut Comma: Token = self.Tok;
        self.ConsumeToken();
        self.checkPotentialAngleBracketDelimiter(Comma);
        Arg += 1;
    }
    return SawError;
}

fn Parser::ParseAttributeArgsCommon(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) -> u32 {
    self.ConsumeParen();
    let mut ChangeKWThisToIdent: bool = attributeTreatsKeywordThisAsIdentifier(*AttrName, Form.getSyntax(), ScopeName);
    let mut AttributeIsTypeArgAttr: bool = attributeIsTypeArgAttr(*AttrName, Form.getSyntax(), ScopeName);
    let mut AttributeHasVariadicIdentifierArg: bool = attributeHasVariadicIdentifierArg(*AttrName, Form.getSyntax(), ScopeName);
    if ChangeKWThisToIdent && self.Tok.is(kw_this) {
        self.Tok.setKind(identifier);
    }
    let mut ArgExprs: ArgsVector = zeroed();
    if self.Tok.is(identifier) {
        let mut IsIdentifierArg: bool = AttributeHasVariadicIdentifierArg || attributeHasIdentifierArg(self.getTargetInfo().getTriple(), *AttrName, Form.getSyntax(), ScopeName);
        let mut AttrKind: Kind = getParsedKind(AttrName, ScopeName, Form.getSyntax());
        if AttrKind == UnknownAttribute || AttrKind == IgnoredAttribute {
            let mut Next: *Token = self.NextToken();
            IsIdentifierArg = Next;
        }
        if IsIdentifierArg {
            ArgExprs()(self.ParseIdentifierLoc());
        }
    }
    let mut TheParsedType: ParsedType = zeroed();
    if if operator!() { self.Tok.is(comma) } else { self.Tok.isNot(r_paren) } {
        if operator!() {
            self.ConsumeToken();
        }
        if AttributeIsTypeArgAttr {
            let mut T: i32 = 0;
            if T()() {
                self.SkipUntil(r_paren, StopAtSemi);
                return 0;
            }
            if T()() {
                TheParsedType() = ();
            }
        } else if AttributeHasVariadicIdentifierArg || attributeHasStrictIdentifierArgs(*AttrName, Form.getSyntax(), ScopeName) {
            while true {
                {
                if ChangeKWThisToIdent && self.Tok.is(kw_this) {
                    self.Tok.setKind(identifier);
                }
                let mut ArgExpr: i32 = 0;
                if self.Tok.is(identifier) {
                    ArgExprs()(self.ParseIdentifierLoc());
                } else {
                    let mut Uneval: bool = attributeParsedArgsUnevaluated(*AttrName, Form.getSyntax(), ScopeName);
                    let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, if Uneval { Unevaluated } else { ConstantEvaluated }, null, EK_AttrArgument, true };
                    let mut ArgExpr: i32 = 0;
                    if ArgExpr()() {
                        self.SkipUntil(r_paren, StopAtSemi);
                        return 0;
                    }
                    ArgExprs()();
                }
            }
                if !(self.TryConsumeToken(comma)) { break; }
            }
        } else {
            let mut Uneval: bool = attributeParsedArgsUnevaluated(*AttrName, Form.getSyntax(), ScopeName);
            let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, if Uneval { Unevaluated } else { ConstantEvaluated }, null, EK_AttrArgument, true };
            let mut ParsedExprs: ExprVector = zeroed();
            let mut ArgProperties: ParsedAttributeArgumentsProperties = attributeStringLiteralListArg(self.getTargetInfo().getTriple(), *AttrName, Form.getSyntax(), ScopeName);
            if self.ParseAttributeArgumentList(*AttrName, ArgProperties) {
                self.SkipUntil(r_paren, StopAtSemi);
                return 0;
            }
            for let mut I: u64 = 0; I < ParsedExprs()(); I += 1 {
                if operator!(isa([I])) {
                    continue;
                }
                if !attributeAcceptsExprPack(*AttrName, Form.getSyntax(), ScopeName) {
                     << AttrName;
                    self.SkipUntil(r_paren, StopAtSemi);
                    return 0;
                }
            }
            append_range();
        }
    }
    let mut RParen: SourceLocation = self.Tok.getLocation();
    if !self.ExpectAndConsume(r_paren, "") {
        let mut AttrLoc: SourceLocation = if ScopeLoc.isValid() { ScopeLoc } else { AttrNameLoc };
        if AttributeIsTypeArgAttr && operator!(()()) {
            Attrs.addNewTypeAttr(AttrName, SourceRange { B: AttrNameLoc, E: RParen }, AttributeScopeInfo { ScopeName, ScopeLoc }, Form);
        } else {
            Attrs(AttrName, SourceRange { B: AttrLoc, E: RParen }, AttributeScopeInfo { ScopeName, ScopeLoc }, Form);
        }
    }
    if EndLoc {
        *EndLoc = RParen;
    }
    return () + operator!(()()) as u32;
}

fn Parser::ParseGNUAttributeArgs(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form, D: *mut Declarator) {
    assert!(self.Tok.is(l_paren), "Attribute arg list not starting with '('");
    let mut AttrKind: Kind = getParsedKind(AttrName, ScopeName, Form.getSyntax());
    if  {
        self.ParseAvailabilityAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if  {
        self.ParseExternalSourceSymbolAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if  {
        self.ParseObjCBridgeRelatedAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if  {
        self.ParseSwiftNewTypeAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if  {
        self.ParseTypeTagForDatatypeAttribute(*AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        return;
    } else if attributeIsTypeArgAttr(*AttrName, Form.getSyntax(), ScopeName) {
        self.ParseAttributeWithTypeArg(*AttrName, AttrNameLoc, Attrs, ScopeName, ScopeLoc, Form);
        return;
    } else if  {
        self.ParseBoundsAttribute(*AttrName, AttrNameLoc, Attrs, ScopeName, ScopeLoc, Form);
        return;
    } else if  {
        self.ParseCXXAssumeAttributeArg(Attrs, AttrName, AttrNameLoc, ScopeName, ScopeLoc, EndLoc, Form);
        return;
    }
    let mut PrototypeScope: optional<ParseScope> = zeroed();
    if D && IsAttributeArgsParsedInFunctionScope(*AttrName) {
        let mut FTI: *FunctionTypeInfo = null;
        for let mut i: u32 = 0; i < D.getNumTypeObjects(); i += 1 {
            if D.getTypeObject(i).Kind == Function {
                FTI = operator&(D.getTypeObject(i));
                break;
            }
        }
        if FTI {
            PrototypeScope()(self, FunctionPrototypeScope | FunctionDeclarationScope | DeclScope | (self.getCurScope().getFlags() & ClassScope));
            for let mut i: u32 = 0; i < FTI.NumParams; i += 1 {
                self.Actions.ActOnReenterCXXMethodParameter(self.getCurScope(), dyn_cast_or_null(FTI.Params[i].Param));
            }
        }
    }
    self.ParseAttributeArgsCommon(AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
}

fn Parser::ParseClangAttributeArgs(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) -> u32 {
    assert!(self.Tok.is(l_paren), "Attribute arg list not starting with '('");
    let mut AttrKind: Kind = getParsedKind(AttrName, ScopeName, Form.getSyntax());
    match AttrKind {
        _ => {
            return self.ParseAttributeArgsCommon(AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
        },
    }
    return if operator!(Attrs.empty) { Attrs() } else { 0 };
}

fn Parser::ParseMicrosoftDeclSpecArgs(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes) -> bool {
    let mut ExistingAttrs: u32 = Attrs()();
    if !hasAttribute(AS_Declspec, null, AttrName, self.getTargetInfo(), self.getLangOpts()) {
        self.ConsumeParen();
        self.SkipUntil(r_paren, 0 as SkipUntilFlags);
        return false;
    }
    let mut OpenParenLoc: SourceLocation = self.Tok.getLocation();
    if AttrName.getName() == "property" {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.expectAndConsume;
        let mut AccessorNames: [2]*mut IdentifierInfo = [null, null];
        let mut HasInvalidAccessor: bool = false;
        while true {
            if !self.Tok.is(identifier) {
                if self.Tok.is(r_paren) && !HasInvalidAccessor && AccessorNames[AK_Put] == null && AccessorNames[AK_Get] == null {
                    break;
                }
                break;
            }
            let mut Kind: AccessorKind = zeroed();
            let mut KindLoc: SourceLocation = self.Tok.getLocation();
            let mut KindStr: str = self.Tok.getIdentifierInfo().getName();
            if KindStr == "get" {
                Kind = AK_Get;
            } else if KindStr == "put" {
                Kind = AK_Put;
            } else if KindStr == "set" {
                 << CreateReplacement(KindLoc, "put");
                Kind = AK_Put;
            } else if self.NextToken().is(comma) || self.NextToken().is(r_paren) {
                self.ConsumeToken();
                HasInvalidAccessor = true;
            } else {
                HasInvalidAccessor = true;
                Kind = AK_Invalid;
                if !self.NextToken().is(equal) {
                    break;
                }
            }
            self.ConsumeToken();
            if !self.TryConsumeToken(equal) {
                 << KindStr;
                break;
            }
            if !self.Tok.is(identifier) {
                break;
            }
            if Kind == AK_Invalid {} else if AccessorNames[Kind] != null {
                 << KindStr;
            } else {
                AccessorNames[Kind] = self.Tok.getIdentifierInfo();
            }
            self.ConsumeToken();
            self.TryConsumeToken(comma);
            if self.Tok.is(r_paren) {
                break;
            }
            break;
        }
        if !HasInvalidAccessor {
            Attrs.addNewPropertyAttr(AttrName, AttrNameLoc, AttributeScopeInfo {}, AccessorNames[AK_Get], AccessorNames[AK_Put], Declspec());
        }
        T.skipToEnd();
        return !HasInvalidAccessor;
    }
    let mut NumArgs: u32 = self.ParseAttributeArgsCommon(AttrName, AttrNameLoc, Attrs, null, null, SourceLocation {}, Declspec());
    if ExistingAttrs < Attrs()() && Attrs() && !NumArgs {
         << AttrName;
        return false;
    }
    return true;
}

fn Parser::ParseMicrosoftDeclSpecs(self, Attrs: *mut ParsedAttributes) {
    (((operator!(operator!((self.getLangOpts() && "__declspec keyword is not enabled")))) || (_wassert(L"getLangOpts().DeclSpecKeyword && \"__declspec keyword is not enabled\"", L"clang\\lib\\Parse\\ParseDecl.cpp", (905) as u32) , 0)) as void);
    assert!(self.Tok.is(kw___declspec), "Not a declspec!");
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = StartLoc;
    while self.Tok.is(kw___declspec) {
        self.ConsumeToken();
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        if T.expectAndConsume {
            return;
        }
        while self.Tok.isNot(r_paren) {
            if self.TryConsumeToken(comma) {
                continue;
            }
            if self.Tok.is(code_completion) {
                self.cutOffParsing();
                self.Actions.CodeCompletion().CodeCompleteAttribute(AS_Declspec, Attribute, null);
                return;
            }
            let mut IsString: bool = self.Tok.getKind() == string_literal;
            if !IsString && self.Tok.getKind() != identifier && self.Tok.getKind() != kw_restrict {
                T.skipToEnd();
                return;
            }
            let mut AttrName: *mut IdentifierInfo = null;
            let mut AttrNameLoc: SourceLocation = SourceLocation {};
            if IsString {
                let mut StrBuffer: str = zeroed();
                let mut Invalid: bool = false;
                let mut Str: str = self.PP(self.Tok, &mut Invalid);
                if Invalid {
                    T.skipToEnd();
                    return;
                }
                AttrName = self.PP.getIdentifierInfo(Str);
                AttrNameLoc = self.ConsumeStringToken();
            } else {
                AttrName = self.Tok.getIdentifierInfo();
                AttrNameLoc = self.ConsumeToken();
            }
            let mut AttrHandled: bool = false;
            if self.Tok.is(l_paren) {
                AttrHandled = self.ParseMicrosoftDeclSpecArgs(AttrName, AttrNameLoc, Attrs);
            } else if AttrName.getName() == "property" {
                << AttrName.getName();
            }
            if !AttrHandled {
                Attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, Declspec(), SourceLocation {});
            }
        }
        T.consumeClose();
        EndLoc = T.getCloseLocation();
    }
    Attrs() = SourceRange { B: StartLoc, E: EndLoc };
}

fn Parser::ParseMicrosoftTypeAttributes(self, attrs: *mut ParsedAttributes) {
    while true {
        let mut Kind: TokenKind = self.Tok.getKind();
        match Kind {
            kw___fastcall => {
                kw___stdcall;
            },
            _ => {
                return;
            },
        }
    }
}

fn Parser::ParseWebAssemblyFuncrefTypeAttribute(self, attrs: *mut ParsedAttributes) {
    assert!(self.Tok.is(kw___funcref);
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    if !self.getTargetInfo().getTriple().isWasm() {
        self.ConsumeToken();
        return;
    }
    let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
    attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___funcref, SourceLocation {});
}

fn Parser::DiagnoseAndSkipExtendedMicrosoftTypeAttributes(self) {
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = self.SkipExtendedMicrosoftTypeAttributes();
    if EndLoc.isValid() {
        let mut Range: SourceRange = SourceRange { B: StartLoc, E: EndLoc };
         << Range;
    }
}

fn Parser::SkipExtendedMicrosoftTypeAttributes(self) -> SourceLocation {
    let mut EndLoc: SourceLocation = SourceLocation {};
    while true {
        match self.Tok.getKind() {
            kw_const => {
                kw_volatile;
            },
            _ => {
                return EndLoc;
            },
        }
    }
}

fn Parser::ParseBorlandTypeAttributes(self, attrs: *mut ParsedAttributes) {
    while self.Tok.is(kw___pascal) {
        let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
        attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___pascal, SourceLocation {});
    }
}

fn Parser::ParseOpenCLKernelAttributes(self, attrs: *mut ParsedAttributes) {
    while self.Tok.is(kw___kernel) {
        let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
        attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___kernel, SourceLocation {});
