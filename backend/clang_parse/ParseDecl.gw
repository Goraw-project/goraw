    let mut EndLoc: SourceLocation = SourceLocation {};
    while true {
        let mut isInvalid: bool = false;
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        let mut Loc: SourceLocation = self.Tok.getLocation();
        match self.Tok.getKind() {
            code_completion => {
                self.cutOffParsing();
            },
            kw_const => {
                isInvalid = DS.SetTypeQual(TQ_const, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw_volatile => {
                isInvalid = DS.SetTypeQual(TQ_volatile, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw_restrict => {
                isInvalid = DS.SetTypeQual(TQ_restrict, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw___ob_wrap => {
                if operator!(self.getLangOpts()) {
                     << getKeywordSpelling(self.Tok.getKind());
                    break;
                }
            },
            kw___ob_trap => {
                if operator!(self.getLangOpts()) {
                     << getKeywordSpelling(self.Tok.getKind());
                    break;
                }
            },
            kw__Atomic => {
                if !AtomicOrPtrauthAllowed {
                    
                }
            },
            kw_private => {
                if operator!(self.getLangOpts()) {
                    
                }
            },
            kw___private => {
                kw___global;
            },
            kw_groupshared => {
                kw_in;
            },
            kw___ptrauth => {
                if !AtomicOrPtrauthAllowed {
                    
                }
            },
            kw___unaligned => {
                isInvalid = DS.SetTypeQual(TQ_unaligned, Loc, PrevSpec, DiagID, self.getLangOpts());
            },
            kw___uptr => {
                if (AttrReqs & AR_DeclspecAttributesParsed) && operator!(self.getLangOpts()) && IdentifierRequired && DS.isEmpty() && self.NextToken().is(semi) {
                    if self.TryKeywordIdentFallback(false) {
                        continue;
                    }
                }
            },
            kw___sptr => {
                kw___w64;
            },
            kw___funcref => {
                self.ParseWebAssemblyFuncrefTypeAttribute(DS.getAttributes());
            },
            kw___pascal => {
                if AttrReqs & AR_VendorAttributesParsed {
                    self.ParseBorlandTypeAttributes(DS.getAttributes());
                    continue;
                }
            },
            kw__Nonnull => {
                kw__Nullable;
            },
            kw___kindof => {
                DS.getAttributes().addNew(self.Tok.getIdentifierInfo(), Loc, AttributeScopeInfo {}, null, 0, kw___kindof, SourceLocation {});
            },
            kw___attribute => {
                if AttrReqs & AR_GNUAttributesParsedAndRejected {
                    
                }
            },
            _ => {
                DS.Finish(self.Actions, self.Actions.getASTContext().getPrintingPolicy());
            },
        }
        if isInvalid {
            assert!(PrevSpec, "Method did not return previous specifier!");
            self.Diag(self.Tok, DiagID);
        }
        EndLoc = self.ConsumeToken();
    }
}

fn Parser::ParseDeclarator(self, D: *mut Declarator) {
    self.Actions.runWithSufficientStackSpace;
}

fn isPtrOperatorToken(Kind: TokenKind, Lang: *LangOptions, TheContext: DeclaratorContext) -> bool {
    if Kind == star || Kind == caret {
        return true;
    }
    if Kind == kw_pipe && Lang() && Lang.getOpenCLCompatibleVersion() >= 200 {
        return true;
    }
    if operator!(Lang()) {
        return false;
    }
    if Kind == amp {
        return true;
    }
    if Kind == ampamp {
        return Lang() || (TheContext != ConversionId && TheContext != CXXNew);
    }
    return false;
}

fn isPipeDeclarator(D: *Declarator) -> bool {
    let mut NumTypes: u32 = D.getNumTypeObjects();
    for let mut Idx: u32 = 0; Idx != NumTypes; Idx += 1 {
        if Pipe == D.getTypeObject(Idx).Kind {
            return true;
        }
    }
    return false;
}

fn Parser::ParseDeclaratorInternal(self, D: *mut Declarator, DirectDeclParser: DirectDeclParseFunction) {
    if self.Diags.hasAllExtensionsSilenced() {
        D.setExtension(true);
    }
    if self.getLangOpts() && (self.Tok.is(coloncolon) || (self.Tok.is(kw_decltype) && self.NextToken().is(l_paren)) || (self.Tok.is(identifier) && (self.NextToken().is(coloncolon) || self.NextToken().is(less))) || self.Tok.is(annot_cxxscope)) {
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, true };
        let mut EnteringContext: bool = D.getContext() == File || D.getContext() == Member;
        let mut SS: CXXScopeSpec = CXXScopeSpec {};
        SS.setTemplateParamLists(D()());
        if  || SS.isEmpty() || SS.isInvalid() || !EnteringContext || self.Tok.is(star) {
            TPA.Commit();
            if SS.isNotEmpty() && self.Tok.is(star) {
                if SS.isValid() {
                    self.checkCompoundToken(SS.getEndLoc(), coloncolon, MemberPtr);
                }
                let mut StarLoc: SourceLocation = self.ConsumeToken();
                D.SetRangeEnd(StarLoc);
                let mut DS: DeclSpec = zeroed();
                self.ParseTypeQualifierListOpt(DS, AR_AllAttributesParsed, true, false, void {});
                D.ExtendWithDeclSpec(DS);
                self.Actions.runWithSufficientStackSpace;
                D(getMemberPointer(SS, DS.getTypeQualifiers(), StarLoc, DS.getEndLoc()), move(DS.getAttributes()), SourceLocation {});
                return;
            }
        } else {
            TPA.Revert();
            SS.clear();
        }
        if SS.isNotEmpty() {
            if D.mayHaveIdentifier() {
                D.getCXXScopeSpec() = move(SS);
            } else {
                self.AnnotateScopeToken(SS, true);
            }
            if DirectDeclParser {
                self ->* DirectDeclParser(D);
            }
            return;
        }
    }
    let mut Kind: TokenKind = self.Tok.getKind();
    if D.getDeclSpec().isTypeSpecPipe() && !isPipeDeclarator(D) {
        let mut DS: DeclSpec = zeroed();
        self.ParseTypeQualifierListOpt(DS, AR_AllAttributesParsed, true, false, void {});
        D(getPipe(DS.getTypeQualifiers(), DS.getPipeLoc()), move(DS.getAttributes()), SourceLocation {});
    }
    if !isPtrOperatorToken(Kind, self.getLangOpts(), D.getContext()) {
        if DirectDeclParser {
            self ->* DirectDeclParser(D);
        }
        return;
    }
    let mut Loc: SourceLocation = self.ConsumeToken();
    D.SetRangeEnd(Loc);
    if Kind == star || Kind == caret {
        let mut DS: DeclSpec = zeroed();
        let mut Reqs: u32 = AR_CXX11AttributesParsed | AR_DeclspecAttributesParsed | (if (D.getContext() != CXXNew) { AR_GNUAttributesParsed } else { AR_GNUAttributesParsedAndRejected });
        self.ParseTypeQualifierListOpt(DS, Reqs, true, !D.mayOmitIdentifier(), void {});
        D.ExtendWithDeclSpec(DS);
        self.Actions.runWithSufficientStackSpace;
        if Kind == star {
            D(getPointer(DS.getTypeQualifiers(), Loc, DS.getConstSpecLoc(), DS.getVolatileSpecLoc(), DS.getRestrictSpecLoc(), DS.getAtomicSpecLoc(), DS.getUnalignedSpecLoc(), DS.getOverflowBehaviorLoc(), DS.isWrapSpecified()), move(DS.getAttributes()), SourceLocation {});
        } else {
            D(getBlockPointer(DS.getTypeQualifiers(), Loc), move(DS.getAttributes()), SourceLocation {});
        }
    } else {
        let mut DS: DeclSpec = zeroed();
        if Kind == ampamp {
            
        }
        self.ParseTypeQualifierListOpt(DS, AR_AllAttributesParsed, true, false, void {});
        D.ExtendWithDeclSpec(DS);
        if DS.getTypeQualifiers() != TQ_unspecified {
            if DS.getTypeQualifiers() & TQ_const {
                << "const";
            }
            if DS.getTypeQualifiers() & TQ_volatile {
                << "volatile";
            }
            if DS.getTypeQualifiers() & TQ_atomic {
                << "_Atomic";
            }
        }
        self.Actions.runWithSufficientStackSpace;
        if D.getNumTypeObjects() > 0 {
            let mut InnerChunk: *mut DeclaratorChunk = D.getTypeObject(D.getNumTypeObjects() - 1);
            if InnerChunk.Kind == Reference {
                if D.getIdentifier() {
                    II;
                } else {
                    << II;
                }
            }
        }
        D(getReference(DS.getTypeQualifiers(), Loc, Kind == amp), move(DS.getAttributes()), SourceLocation {});
    }
}

fn getMissingDeclaratorIdLoc(D: *mut Declarator, Loc: SourceLocation) -> SourceLocation {
    if D.getName().StartLocation.isInvalid() && D.getName().EndLocation.isValid() {
        return D.getName().EndLocation;
    }
    return Loc;
}

fn Parser::ParseDirectDeclarator(self, D: *mut Declarator) {
