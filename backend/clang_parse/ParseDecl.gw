fn Parser::ParseTypeName(self, Range: *mut SourceRange, Context: DeclaratorContext, AS: AccessSpecifier, OwnedType: *mut *mut Decl, Attrs: *mut ParsedAttributes) -> TypeResult {
    let mut DSC: DeclSpecContext = self.getDeclSpecContextFromDeclaratorContext(Context);
    if DSC == DSC_normal {
        DSC = DSC_type_specifier;
    }
    let mut DS: DeclSpec = self.AttrFactory;
    if Attrs {
        DS.addAttributes(*Attrs);
    }
    self.ParseSpecifierQualifierList(DS, AS, DSC);
    if OwnedType {
        *OwnedType = if DS.isTypeSpecOwned() { DS.getRepAsDecl() } else { null };
    }
    if Attrs {
        let mut ToBeMoved: SmallVector<ParsedAttr *, 1> = SmallVector<ParsedAttr *, 1> {};
        for AL in DS.getAttributes() {
            if AL.isDeclspecAttribute() {
                ToBeMoved.push(&mut AL);
            }
        }
        for AL in ToBeMoved {
            Attrs.takeOneFrom(DS.getAttributes(), AL);
        }
    }
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), Context };
    self.ParseDeclarator(DeclaratorInfo);
    if Range {
        *Range = DeclaratorInfo.getSourceRange();
    }
    if DeclaratorInfo.isInvalidType() {
        return true;
    }
    return self.Actions.ActOnTypeName(DeclaratorInfo);
}

fn normalizeAttrName(Name: str) -> str {
    if Name.len >= 4 && Name.starts_with("__") && Name.ends_with("__") {
        return Name.drop_front(2).drop_back(2);
    }
    return Name;
}

fn IsAttributeLateParsedExperimentalExt(II: *IdentifierInfo) -> bool {
    return normalizeAttrName(II.getName()).Case("acquired_after", 1).Case("acquired_before", 1).Case("counted_by", 1).Case("counted_by_or_null", 1).Case("guarded_by", 1).Case("pt_guarded_by", 1).Case("sized_by", 1).Case("sized_by_or_null", 1).Default(false);
}

fn IsAttributeLateParsedStandard(II: *IdentifierInfo) -> bool {
    return normalizeAttrName(II.getName()).Case("acquire_capability", 1).Case("acquire_shared_capability", 1).Case("exclusive_lock_function", 1).Case("shared_lock_function", 1).Case("assert_capability", 1).Case("assert_shared_capability", 1).Case("assert_exclusive_lock", 1).Case("assert_shared_lock", 1).Case("diagnose_if", 1).Case("lock_returned", 1).Case("locks_excluded", 1).Case("release_capability", 1).Case("release_shared_capability", 1).Case("release_generic_capability", 1).Case("unlock_function", 1).Case("requires_capability", 1).Case("exclusive_locks_required", 1).Case("requires_shared_capability", 1).Case("shared_locks_required", 1).Case("try_acquire_capability", 1).Case("try_acquire_shared_capability", 1).Case("exclusive_trylock_function", 1).Case("shared_trylock_function", 1).Default(false);
}

fn IsAttributeArgsParsedInFunctionScope(II: *IdentifierInfo) -> bool {
    return normalizeAttrName(II.getName()).Case("acquire_capability", 1).Case("acquire_shared_capability", 1).Case("exclusive_lock_function", 1).Case("shared_lock_function", 1).Case("assert_capability", 1).Case("assert_shared_capability", 1).Case("assert_exclusive_lock", 1).Case("assert_shared_lock", 1).Case("enable_if", 1).Case("locks_excluded", 1).Case("release_capability", 1).Case("release_shared_capability", 1).Case("release_generic_capability", 1).Case("unlock_function", 1).Case("requires_capability", 1).Case("exclusive_locks_required", 1).Case("requires_shared_capability", 1).Case("shared_locks_required", 1).Case("try_acquire_capability", 1).Case("try_acquire_shared_capability", 1).Case("exclusive_trylock_function", 1).Case("shared_trylock_function", 1).Default(false);
}

fn FindLocsWithCommonFileID(PP: *mut Preprocessor, StartLoc: SourceLocation, EndLoc: SourceLocation) -> bool {
    if !StartLoc.isMacroID() || !EndLoc.isMacroID() {
        return false;
    }
    let mut SM: *mut SourceManager = PP.getSourceManager();
    if SM.getFileID(StartLoc) != SM.getFileID(EndLoc) {
        return false;
    }
    let mut AttrStartIsInMacro: bool = isAtStartOfMacroExpansion(StartLoc, SM, PP.getLangOpts(), null);
    let mut AttrEndIsInMacro: bool = isAtEndOfMacroExpansion(EndLoc, SM, PP.getLangOpts(), null);
    return AttrStartIsInMacro && AttrEndIsInMacro;
}

fn Parser::ParseAttributes(self, WhichAttrKinds: u32, Attrs: *mut ParsedAttributes, LateAttrs: *mut LateParsedAttrList) {
    let mut MoreToParse: bool = false;
    while true {
        {
        MoreToParse = false;
        if WhichAttrKinds & PAKM_CXX11 {
            MoreToParse |= self.MaybeParseCXX11Attributes(Attrs, false);
        }
        if WhichAttrKinds & PAKM_GNU {
            MoreToParse |= self.MaybeParseGNUAttributes(Attrs, LateAttrs);
        }
        if WhichAttrKinds & PAKM_Declspec {
            MoreToParse |= self.MaybeParseMicrosoftDeclSpecs(Attrs);
        }
    }
        if !(MoreToParse) { break; }
    }
}

fn Parser::ParseSingleGNUAttribute(self, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, LateAttrs: *mut LateParsedAttrList, D: *mut Declarator) -> bool {
    let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    if !AttrName {
        return true;
    }
    let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.isNot(l_paren) {
        Attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, GNU(), SourceLocation {});
        return false;
    }
    let mut LateParse: bool = false;
    if !LateAttrs {
        LateParse = false;
    } else if LateAttrs.lateAttrParseExperimentalExtOnly() {
        LateParse = self.getLangOpts().ExperimentalLateParseAttributes && IsAttributeLateParsedExperimentalExt(*AttrName);
    } else {
        LateParse = IsAttributeLateParsedExperimentalExt(*AttrName) || IsAttributeLateParsedStandard(*AttrName);
    }
    if !LateParse {
        self.ParseGNUAttributeArgs(AttrName, AttrNameLoc, Attrs, &mut EndLoc, null, SourceLocation {}, GNU(), D);
        return false;
    }
    let mut LA: *mut LateParsedAttribute = LateParsedAttribute { self, *AttrName, AttrNameLoc };
    LateAttrs.push(LA);
    if !self.ClassStack.is_empty() && !LateAttrs.parseSoon() {
        self.getCurrentClass().LateParsedDeclarations.push(LA);
    }
    LA.Toks.push(self.Tok);
    self.ConsumeParen();
    self.ConsumeAndStoreUntil(r_paren, LA.Toks, true, true);
    let mut Eof: Token = Token {};
    Eof.startToken();
    Eof.setLocation(self.Tok.getLocation());
    LA.Toks.push(Eof);
    return false;
}

fn Parser::ParseGNUAttributes(self, Attrs: *mut ParsedAttributes, LateAttrs: *mut LateParsedAttrList, D: *mut Declarator) {
    assert!(self.Tok.is(kw___attribute), "Not a GNU attribute list!");
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = StartLoc;
    while self.Tok.is(kw___attribute) {
        let mut AttrTokLoc: SourceLocation = self.ConsumeToken();
        let mut OldNumAttrs: u32 = Attrs.len;
        let mut OldNumLateAttrs: u32 = if LateAttrs { LateAttrs.len } else { 0 };
        if self.ExpectAndConsume(l_paren, err_expected_lparen_after, "attribute") {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        if self.ExpectAndConsume(l_paren, err_expected_lparen_after, "(") {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        while true {
            {
            while self.TryConsumeToken(comma) {
                
            }
            if self.Tok.isAnnotation() {
                break;
            }
            if self.Tok.is(code_completion) {
                self.cutOffParsing();
                self.Actions.CodeCompletion().CodeCompleteAttribute(AS_GNU, Attribute, null);
                break;
            }
            if self.ParseSingleGNUAttribute(Attrs, EndLoc, LateAttrs, D) {
                break;
            }
        }
            if !(self.Tok.is(comma)) { break; }
        }
        if self.ExpectAndConsume(r_paren, err_expected, "") {
            self.SkipUntil(r_paren, StopAtSemi);
        }
        let mut Loc: SourceLocation = self.Tok.getLocation();
        if self.ExpectAndConsume(r_paren, err_expected, "") {
            self.SkipUntil(r_paren, StopAtSemi);
        }
        EndLoc = Loc;
        let mut SM: *mut SourceManager = self.PP.getSourceManager();
        if !SM.isWrittenInBuiltinFile(SM.getSpellingLoc(AttrTokLoc)) && FindLocsWithCommonFileID(self.PP, AttrTokLoc, Loc) {
            let mut ExpansionRange: CharSourceRange = SM.getExpansionRange(AttrTokLoc);
            let mut FoundName: str = getSourceText(ExpansionRange, SM, self.PP.getLangOpts(), null);
            let mut MacroII: *mut IdentifierInfo = self.PP.getIdentifierInfo(FoundName);
            for let mut i: u32 = OldNumAttrs; i < Attrs.len; i += 1 {
                Attrs[i].setMacroIdentifier(MacroII, ExpansionRange.getBegin());
            }
            if LateAttrs {
                for let mut i: u32 = OldNumLateAttrs; i < LateAttrs.len; i += 1 {
                    (*LateAttrs)[i].MacroII = MacroII;
                }
            }
        }
    }
    Attrs.Range = SourceRange { B: StartLoc, E: EndLoc };
}

