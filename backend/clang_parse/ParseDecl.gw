fn Parser::ParseBracketDeclarator(self, D: *mut Declarator) {
    if self.CheckProhibitedCXX11Attribute() {
        return;
    }
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
    T.consumeOpen();
    if self.Tok.getKind() == r_square {
        T.consumeClose();
        let mut attrs: ParsedAttributes = zeroed();
        self.MaybeParseCXX11Attributes(attrs, false);
        D(getArray(0, false, false, null, T.getOpenLocation(), T.getCloseLocation()), move(attrs), T.getCloseLocation());
        return;
    } else if self.Tok.getKind() == numeric_constant && self.GetLookAheadToken(1).is(r_square) {
        let mut ExprRes: i32 = self.Actions(self.Tok, self.getCurScope());
        self.ConsumeToken();
        T.consumeClose();
        let mut attrs: ParsedAttributes = zeroed();
        self.MaybeParseCXX11Attributes(attrs, false);
        D(getArray(0, false, false, T.getOpenLocation(), T.getCloseLocation()), move(attrs), T.getCloseLocation());
        return;
    } else if self.Tok.getKind() == code_completion {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteBracketDeclarator(self.getCurScope());
        return;
    }
    let mut StaticLoc: SourceLocation = SourceLocation {};
    self.TryConsumeToken(kw_static, StaticLoc);
    let mut DS: DeclSpec = zeroed();
    self.ParseTypeQualifierListOpt(DS, AR_CXX11AttributesParsed, true, false, void {});
    if !StaticLoc.isValid() {
        self.TryConsumeToken(kw_static, StaticLoc);
    }
    let mut isStar: bool = false;
    let mut NumElements: i32 = 0;
    if self.Tok.is(star) && self.GetLookAheadToken(1).is(r_square) {
        self.ConsumeToken();
        if StaticLoc.isValid() {
            StaticLoc = SourceLocation {};
        }
        isStar = true;
    } else if self.Tok.isNot(r_square) {
        if self.getLangOpts() {} else {
            let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
        }
    } else {
        if StaticLoc.isValid() {
            StaticLoc = SourceLocation {};
        }
    }
    if NumElements()() {
        D.setInvalidType(true);
        self.SkipUntil(r_square, StopAtSemi);
        return;
    }
    T.consumeClose();
    self.MaybeParseCXX11Attributes(DS.getAttributes(), false);
    D(getArray(DS.getTypeQualifiers(), StaticLoc.isValid(), isStar, T.getOpenLocation(), T.getCloseLocation()), move(DS.getAttributes()), T.getCloseLocation());
}

fn Parser::ParseMisplacedBracketDeclarator(self, D: *mut Declarator) {
    assert!(self.Tok.is(l_square), "Missing opening bracket");
    assert!(!D.mayOmitIdentifier(), "Declarator cannot omit identifier");
    let mut StartBracketLoc: SourceLocation = self.Tok.getLocation();
    let mut TempDeclarator: Declarator = Declarator { D.getDeclSpec(), none(), D.getContext() };
    while self.Tok.is(l_square) {
        self.ParseBracketDeclarator(TempDeclarator);
    }
    if self.Tok.is(semi) {
        D.getName().EndLocation = StartBracketLoc;
    }
    let mut SuggestParenLoc: SourceLocation = self.Tok.getLocation();
    self.ParseDeclaratorInternal(D, &mut ParseDirectDeclarator);
    if TempDeclarator.getNumTypeObjects() == 0 {
        return;
    }
    let mut NeedParens: bool = false;
    if D.getNumTypeObjects() != 0 {
        match D.getTypeObject(D.getNumTypeObjects() - 1).Kind {
            Pointer => {
                Reference;
            },
            Array => {
                Function;
            },
        }
    }
    if NeedParens {
        let mut EndLoc: SourceLocation = self.PP.getLocForEndOfToken(D.getEndLoc(), 0);
        D.AddTypeInfo(getParen(SuggestParenLoc, EndLoc), SourceLocation {});
    }
    for let mut i: u32 = 0;
let mut e: u32 = TempDeclarator.getNumTypeObjects(); i < e; i += 1 {
        let mut Chunk: *DeclaratorChunk = TempDeclarator.getTypeObject(i);
        D.AddTypeInfo(Chunk, TempDeclarator.getAttributePool(), SourceLocation {});
    }
    if !D.hasName() && !NeedParens {
        return;
    }
    let mut EndBracketLoc: SourceLocation = TempDeclarator.getEndLoc();
    let mut BracketRange: SourceRange = SourceRange { B: StartBracketLoc, E: EndBracketLoc };
    let mut EndLoc: SourceLocation = self.PP.getLocForEndOfToken(D.getEndLoc(), 0);
    if NeedParens {
         << self.getLangOpts() << CreateInsertion(SuggestParenLoc, "(", false) << CreateInsertion(EndLoc, ")", false) << CreateInsertionFromRange(EndLoc, CharSourceRange { Range: BracketRange, IsTokenRange: true }, false) << CreateRemoval(BracketRange);
    } else {
         << self.getLangOpts() << CreateInsertionFromRange(EndLoc, CharSourceRange { Range: BracketRange, IsTokenRange: true }, false) << CreateRemoval(BracketRange);
    }
}

