unsafe fn Closure_5::call(self: *mut Closure_5) -> bool {
                        if self.getLangOpts().C23 && (*self.DS).hasTypeSpecifier() && (*self.DS).getTypeSpecType() != TST_auto {
                            return true;
                        }
                        let mut I: u32 = 1;
                        while true {
                            let mut T: *Token = self.GetLookAheadToken(I);
                            if self.isKnownToBeTypeSpecifier(T) {
