    if Operand()() {
        DS.SetTypeSpecError();
        return;
    }
    Operand() = self.Actions();
    if Operand()() {
        DS.SetTypeSpecError();
        return;
    }
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    if DS(if IsUnqual { TST_typeof_unqualExpr } else { TST_typeofExpr }, StartLoc, PrevSpec, DiagID, self.Actions.getASTContext().getPrintingPolicy()) {
        self.Diag(StartLoc, DiagID);
