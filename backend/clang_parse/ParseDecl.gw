    if !self.isValidAfterTypeSpecifier(CanBeBitfield) {
        self.ExpectAndConsume;
        self.PP.EnterToken(self.Tok, true);
        self.Tok.setKind(semi);
    }
}

fn Parser::isKnownToBeTypeSpecifier(self: *Parser, Tok: *Token) -> bool {
    match Tok.getKind() {
        _ => {
            return false;
