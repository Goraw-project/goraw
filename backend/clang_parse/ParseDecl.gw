fn Parser::ParsePtrauthQualifier(self, Attrs: *mut ParsedAttributes) {
    assert!(self.Tok.is(kw___ptrauth);
    let mut KwName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut KwLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume("", unknown) {
        return;
    }
    let mut ArgExprs: ArgsVector = zeroed();
    while true {
        {
        let mut ER: i32 = 0;
        if ER()() {
            T.skipToEnd();
            return;
        }
        ArgExprs()();
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    T.consumeClose();
    let mut EndLoc: SourceLocation = T.getCloseLocation();
    if ArgExprs()() || () > 3 {
        return;
    }
    Attrs(KwName, SourceRange { B: KwLoc, E: EndLoc }, AttributeScopeInfo {}, Keyword(false, false));
}

fn Parser::ParseBoundsAttribute(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    assert!(self.Tok.is(l_paren), "Attribute arg list not starting with '('");
    let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    Parens.consumeOpen();
    if self.Tok.is(r_paren) {
        Parens.consumeClose();
        return;
    }
    let mut ArgExprs: ArgsVector = zeroed();
    let mut EC: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, PotentiallyEvaluated, null, EK_AttrArgument, true };
    let mut ArgExpr: i32 = 0;
    if ArgExpr()() {
        Parens.skipToEnd();
        return;
    }
    ArgExprs()();
    Parens.consumeClose();
    let mut Ctx: *mut ASTContext = self.Actions.getASTContext();
    ArgExprs()(Create(Ctx, APInt { Ctx.getTypeSize(Ctx.getSizeType()), 0, false, false }, Ctx.getSizeType(), SourceLocation {}));
    Attrs(&mut AttrName, SourceRange { B: AttrNameLoc, E: Parens.getCloseLocation() }, AttributeScopeInfo {}, Form);
}

fn Parser::ParseExtIntegerArgument(self) -> i32 {
    assert!(self.Tok, "Not an extended int type");
    self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    let mut ER: i32 = 0;
    if ER()() {
        T.skipToEnd();
    }
    return ;
}

fn Parser::DiagnoseMissingSemiAfterTagDefinition(self, DS: *mut DeclSpec, AS: AccessSpecifier, DSContext: DeclSpecContext, LateAttrs: *mut LateParsedAttrList) -> bool {
    assert!(DS.hasTagDefinition(), "shouldn't call this");
    let mut EnteringContext: bool = (DSContext == DSC_class || DSContext == DSC_top_level);
    if self.getLangOpts() && (self.Tok || (self.Tok.is(annot_template_id) && self.NextToken().is(coloncolon))) && self.TryAnnotateCXXScopeToken(EnteringContext) {
        self.SkipMalformedDecl();
        return true;
    }
    let mut HasScope: bool = self.Tok.is(annot_cxxscope);
    let mut AfterScope: Token = if HasScope { self.NextToken() } else { self.Tok };
    let mut MightBeDeclarator: bool = true;
    if self.Tok {
        MightBeDeclarator = false;
    } else if AfterScope.is(annot_template_id) {
        let mut Annot: *mut TemplateIdAnnotation = AfterScope.getAnnotationValue() as *mut TemplateIdAnnotation;
        if Annot.Kind == TNK_Type_template {
            MightBeDeclarator = false;
        }
    } else if AfterScope.is(identifier) {
        let mut Next: *Token = if HasScope { self.GetLookAheadToken(2) } else { self.NextToken() };
        if Next {
            MightBeDeclarator = false;
        } else if HasScope {
            let mut SS: CXXScopeSpec = CXXScopeSpec {};
            self.Actions.RestoreNestedNameSpecifierAnnotation(self.Tok.getAnnotationValue(), self.Tok.getAnnotationRange(), SS);
            let mut Name: *mut IdentifierInfo = AfterScope.getIdentifierInfo();
            let mut Classification: NameClassification = self.Actions.ClassifyName(self.getCurScope(), SS, Name, AfterScope.getLocation(), Next, null);
            match Classification.getKind() {
                Error => {
                    self.SkipMalformedDecl();
                },
                Keyword => {
                    llvm_unreachable_internal("typo correction is not possible here", "clang\\lib\\Parse\\ParseDecl.cpp", 3338);
                },
                Type => {
                    TypeTemplate;
                },
                Unknown => {
                    NonType;
                },
            }
        }
    }
    if MightBeDeclarator {
        return false;
    }
    let mut PPol: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
     << getSpecifierName(DS.getTypeSpecType(), PPol) << semi;
    DS.ClearTypeSpecType();
    let mut NotATemplate: ParsedTemplateInfo = ParsedTemplateInfo {};
    self.ParseDeclarationSpecifiers(DS, NotATemplate, AS, DSContext, LateAttrs);
    return false;
}

