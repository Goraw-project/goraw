fn Parser::isTypeSpecifierQualifier(self, Tok: *Token) -> bool {
    match Tok.getKind() {
        _ => {
            return false;
        },
        identifier => {
            if self.TryAltiVecVectorToken() {
                return true;
            }
        },
        kw_typename => {
            if self.TryAnnotateTypeOrScopeToken(No, false) {
                return true;
            }
        },
        coloncolon => {
            if self.NextToken().is(kw_new) || self.NextToken().is(kw_delete) {
                return false;
            }
        },
        kw___attribute => {
            kw_typeof;
        },
        less => {
            return self.getLangOpts();
        },
        kw___cdecl => {
            kw___stdcall;
        },
        kw_private => {
            return self.getLangOpts();
        },
        kw__Atomic => {
            return true;
        },
        kw_groupshared => {
            kw_in;
        },
    }
}

fn Parser::ParseTopLevelStmtDecl(self) -> DeclGroupPtrTy {
    assert!(self.PP.isIncrementalProcessingEnabled(), "Not in incremental mode");
    let mut Stmts: StmtVector = zeroed();
    let mut SubStmtCtx: ParsedStmtContext = ;
    let mut FnScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope, true, false };
    let mut TLSD: *mut TopLevelStmtDecl = self.Actions.ActOnStartTopLevelStmtDecl(self.getCurScope());
    let mut R: i32 = 0;
    self.Actions.ActOnFinishTopLevelStmtDecl(TLSD);
    if operator!() {
        R() = self.Actions(self.Tok.getLocation());
    }
    if self.Tok.is(annot_repl_input_end) && self.Tok.getAnnotationValue() != null {
        self.ConsumeAnnotationToken();
        TLSD.setSemiMissing(true);
    }
    let mut DeclsInGroup: SmallVector<Decl *, 2> = zeroed();
    DeclsInGroup()(TLSD);
    return self.Actions.BuildDeclaratorGroup();
}

fn Parser::isDeclarationSpecifier(self, AllowImplicitTypename: ImplicitTypenameContext, DisambiguatingWithExpression: bool) -> bool {
    match self.Tok.getKind() {
        _ => {
            return false;
        },
        kw_pipe => {
            return self.getLangOpts() && self.getLangOpts().getOpenCLCompatibleVersion() >= 200;
        },
        identifier => {
            if self.getLangOpts() && self.NextToken().is(period) {
                return false;
            }
        },
        kw_decltype => {
            kw_typename;
        },
        coloncolon => {
            if operator!(self.getLangOpts()) {
                return false;
            }
        },
        kw_typedef => {
            kw_extern;
        },
        kw_alignas => {
            return self.getLangOpts();
        },
        less => {
            return self.getLangOpts();
        },
        annot_typename => {
            return !DisambiguatingWithExpression || !self.isStartOfObjCClassMessageMissingOpenBracket();
        },
        annot_template_id => {
            let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
            if TemplateId.hasInvalidName() {
                return true;
            }
            return self.isTypeConstraintAnnotation() && (self.NextToken().is(kw_auto) || self.NextToken().is(kw_decltype));
        },
        annot_cxxscope => {
            let mut TemplateId: *mut TemplateIdAnnotation = if self.NextToken().is(annot_template_id) { self.takeTemplateIdAnnotation(self.NextToken()) } else { null };
            if TemplateId && TemplateId.hasInvalidName() {
                return true;
            }
            if self.NextToken().is(identifier) && self.TryAnnotateTypeConstraint() {
                return true;
            }
            return self.isTypeConstraintAnnotation() && self.GetLookAheadToken(2);
        },
        kw___declspec => {
            kw___cdecl;
        },
        kw_row_major => {
            kw_column_major;
        },
        kw_private => {
            return self.getLangOpts();
        },
    }
}

fn Parser::isConstructorDeclarator(self, IsUnqualified: bool, DeductionGuide: bool, IsFriend: FriendSpecified, TemplateInfo: *ParsedTemplateInfo) -> bool {
    let mut TPA: RevertingTentativeParsingAction = RevertingTentativeParsingAction { *self, false };
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if TemplateInfo && TemplateInfo.TemplateParams {
        SS.setTemplateParamLists;
    }
    if  {
        return false;
    }
    if self.Tok.is(identifier) {
        self.ConsumeToken();
    } else if self.Tok.is(annot_template_id) {
        self.ConsumeAnnotationToken();
    } else {
        return false;
    }
    self.SkipCXX11Attributes();
    if self.Tok.isNot(l_paren) {
        return false;
    }
    self.ConsumeParen();
    if self.Tok.is(r_paren) || (self.Tok.is(ellipsis) && self.NextToken().is(r_paren)) {
        return true;
    }
    if self.isCXX11AttributeSpecifier(false, true) != NotAttributeSpecifier {
        return true;
    }
    let mut DeclScopeObj: DeclaratorScopeObj = DeclaratorScopeObj { *self, SS };
    if SS.isSet() && self.Actions.ShouldEnterDeclaratorScope(self.getCurScope(), SS) {
        DeclScopeObj.EnterDeclaratorScope();
    }
    let mut Attrs: ParsedAttributes = zeroed();
    self.MaybeParseMicrosoftAttributes(Attrs);
    let mut IsConstructor: bool = false;
    let mut ITC: ImplicitTypenameContext = if IsFriend && !SS.isSet() { No } else { Yes };
    if self.Tok.is(kw_this) {
        self.ConsumeToken();
        return self.isDeclarationSpecifier(ITC, false);
    }
    if self.isDeclarationSpecifier(ITC, false) {
        IsConstructor = true;
    } else if self.Tok.is(identifier) || (self.Tok.is(annot_cxxscope) && self.NextToken().is(identifier)) {
        if self.Tok.is(annot_cxxscope) {
            self.ConsumeAnnotationToken();
        }
        self.ConsumeToken();
        match self.Tok.getKind() {
            l_paren => {
                l_square;
            },
            r_paren => {
                self.ConsumeParen();
            },
            _ => {
                IsConstructor = true;
            },
        }
    }
    return IsConstructor;
}

fn Parser::ParseTypeQualifierListOpt(self, DS: *mut DeclSpec, AttrReqs: u32, AtomicOrPtrauthAllowed: bool, IdentifierRequired: bool, CodeCompletionHandler: function_ref<void ()>) {
    if (AttrReqs & AR_CXX11AttributesParsed) && self.isAllowedCXX11AttributeSpecifier(false, false) {
        let mut Attrs: ParsedAttributes = zeroed();
        self.ParseCXX11Attributes(Attrs);
        DS.takeAttributesAppendingingFrom(Attrs);
