}

fn Parser::ParseCUDAFunctionAttributes(self, attrs: *mut ParsedAttributes) {
    while self.Tok.is(kw___noinline__) {
        let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
        attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___noinline__, SourceLocation {});
    }
}

fn Parser::ParseOpenCLQualifiers(self, Attrs: *mut ParsedAttributes) {
    let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut AttrNameLoc: SourceLocation = self.Tok.getLocation();
    Attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, self.Tok.getKind(), SourceLocation {});
}

fn Parser::isHLSLQualifier(self: *Parser, Tok: *Token) -> bool {
    return Tok.is(kw_groupshared) || Tok.is(kw_row_major) || Tok.is(kw_column_major);
}

fn Parser::ParseHLSLQualifiers(self, Attrs: *mut ParsedAttributes) {
    let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut Kind: TokenKind = self.Tok.getKind();
    let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
    Attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, Kind, SourceLocation {});
}

fn Parser::ParseNullabilityTypeSpecifiers(self, attrs: *mut ParsedAttributes) {
    while true {
        let mut Kind: TokenKind = self.Tok.getKind();
        match Kind {
            kw__Nonnull => {
                kw__Nullable;
            },
            _ => {
                return;
            },
        }
    }
}

fn VersionNumberSeparator(Separator: i8) -> bool {
    return (Separator == '.' || Separator == '_');
}

fn Parser::ParseVersionTuple(self, Range: *mut SourceRange) -> VersionTuple {
    Range = SourceRange { B: self.Tok.getLocation(), E: self.Tok.getEndLoc() };
    if !self.Tok.is(numeric_constant) {
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    let mut Buffer: str = zeroed();
    Buffer()(self.Tok.getLength() + 1);
    let mut ThisTokBegin: *u8 = operator&([0]);
    let mut Invalid: bool = false;
    let mut ActualLength: u32 = self.PP.getSpelling(self.Tok, ThisTokBegin, &mut Invalid);
    if Invalid {
        return VersionTuple {};
    }
    let mut AfterMajor: u32 = 0;
    let mut Major: u32 = 0;
    while AfterMajor < ActualLength && isDigit(ThisTokBegin[AfterMajor]) {
        Major = Major * 10 + ThisTokBegin[AfterMajor] - '0';
        AfterMajor += 1;
    }
    if AfterMajor == 0 {
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    if AfterMajor == ActualLength {
        self.ConsumeToken();
        if Major == 0 {
            return VersionTuple {};
        }
        return Major;
    }
    let mut AfterMajorSeparator: i8 = ThisTokBegin[AfterMajor];
    if !VersionNumberSeparator(AfterMajorSeparator) || (AfterMajor + 1 == ActualLength) {
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    let mut AfterMinor: u32 = AfterMajor + 1;
    let mut Minor: u32 = 0;
    while AfterMinor < ActualLength && isDigit(ThisTokBegin[AfterMinor]) {
        Minor = Minor * 10 + ThisTokBegin[AfterMinor] - '0';
        AfterMinor += 1;
    }
    if AfterMinor == ActualLength {
        self.ConsumeToken();
        if Major == 0 && Minor == 0 {
            return VersionTuple {};
        }
        return VersionTuple { Major, Minor };
    }
    let mut AfterMinorSeparator: i8 = ThisTokBegin[AfterMinor];
    if !VersionNumberSeparator(AfterMinorSeparator) {
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    if AfterMajorSeparator != AfterMinorSeparator {
        
    }
    let mut AfterSubminor: u32 = AfterMinor + 1;
    let mut Subminor: u32 = 0;
    while AfterSubminor < ActualLength && isDigit(ThisTokBegin[AfterSubminor]) {
        Subminor = Subminor * 10 + ThisTokBegin[AfterSubminor] - '0';
        AfterSubminor += 1;
    }
    if AfterSubminor != ActualLength {
        self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
        return VersionTuple {};
    }
    self.ConsumeToken();
    return VersionTuple { Major, Minor, Subminor };
}

fn Parser::ParseAvailabilityAttribute(self, Availability: *mut IdentifierInfo, AvailabilityLoc: SourceLocation, attrs: *mut ParsedAttributes, endLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut Changes: [3]AvailabilityChange = [3]AvailabilityChange {};
    let mut MessageExpr: i32 = 0;
    let mut EnvironmentLoc: *mut IdentifierLoc = null;
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
         << l_paren;
        return;
    }
    if self.Tok.isNot(identifier) {
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    let mut Platform: *mut IdentifierLoc = self.ParseIdentifierLoc();
    if Platform.getIdentifierInfo() {
        Ident;
    } else {
        if Ident.getName().contains("xrOS") || Ident.getName().contains("xros") {
            << Ident;
        } else if Ident.getName() == "macosx" {
            Platform.setIdentifierInfo(self.PP.getIdentifierInfo("macos"));
        } else if Ident.getName() == "macosx_app_extension" {
            Platform.setIdentifierInfo(self.PP.getIdentifierInfo("macos_app_extension"));
        } else {
            Platform.setIdentifierInfo(self.PP.getIdentifierInfo);
        }
    }
    if self.ExpectAndConsume(comma, "") {
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    if !self.Ident_introduced {
        self.Ident_introduced = self.PP.getIdentifierInfo("introduced");
        self.Ident_deprecated = self.PP.getIdentifierInfo("deprecated");
        self.Ident_obsoleted = self.PP.getIdentifierInfo("obsoleted");
        self.Ident_unavailable = self.PP.getIdentifierInfo("unavailable");
        self.Ident_message = self.PP.getIdentifierInfo("message");
        self.Ident_strict = self.PP.getIdentifierInfo("strict");
        self.Ident_replacement = self.PP.getIdentifierInfo("replacement");
        self.Ident_environment = self.PP.getIdentifierInfo("environment");
    }
    let mut UnavailableLoc: SourceLocation = SourceLocation {};
    let mut StrictLoc: SourceLocation = SourceLocation {};
    while true {
        {
        if self.Tok.isNot(identifier) {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        let mut Keyword: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut KeywordLoc: SourceLocation = self.ConsumeToken();
        if Keyword == self.Ident_strict {
            if StrictLoc.isValid() {
                 << Keyword << StrictLoc;
            }
            StrictLoc = KeywordLoc;
            continue;
        }
        if Keyword == self.Ident_unavailable {
            if UnavailableLoc.isValid() {
                 << Keyword << UnavailableLoc;
            }
            UnavailableLoc = KeywordLoc;
            continue;
        }
        if Keyword == self.Ident_deprecated && Platform.getIdentifierInfo() && Platform.getIdentifierInfo().isStr("swift") {
            if Changes[Deprecated].KeywordLoc.isValid() {
                 << Keyword << Changes[Deprecated].KeywordLoc;
            }
            Changes[Deprecated].KeywordLoc = KeywordLoc;
            Changes[Deprecated].Version = 1;
            continue;
        }
        if Keyword == self.Ident_environment {
            if EnvironmentLoc != null {
                 << Keyword << EnvironmentLoc.getLoc();
            }
        }
        if self.Tok.isNot(equal) {
             << Keyword << equal;
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        self.ConsumeToken();
        if Keyword == self.Ident_message || Keyword == self.Ident_replacement {
            if !self.isTokenStringLiteral() {
                 << 2;
                self.SkipUntil(r_paren, StopAtSemi);
                return;
            }
            if Keyword == self.Ident_message {
                break;
            } else {
                continue;
            }
        }
        if Keyword == self.Ident_environment {
            if self.Tok.isNot(identifier) {
                self.SkipUntil(r_paren, StopAtSemi);
                return;
            }
            EnvironmentLoc = self.ParseIdentifierLoc();
            continue;
        }
        if (Keyword == self.Ident_introduced || Keyword == self.Ident_deprecated) && self.Tok.is(identifier) {
            let mut NA: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            if NA.getName() == "NA" {
                self.ConsumeToken();
                if Keyword == self.Ident_introduced {
                    UnavailableLoc = KeywordLoc;
                }
                continue;
            }
        }
        let mut VersionRange: SourceRange = SourceRange {};
        let mut Version: VersionTuple = self.ParseVersionTuple(VersionRange);
        if Version.is_empty() {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        let mut Index: u32 = 0;
        if Keyword == self.Ident_introduced {
            Index = Introduced;
        } else if Keyword == self.Ident_deprecated {
            Index = Deprecated;
        } else if Keyword == self.Ident_obsoleted {
            Index = Obsoleted;
        } else {
            Index = Unknown;
        }
        if Index < Unknown {
            if !Changes[Index].KeywordLoc.isInvalid() {
                 << Keyword << SourceRange { B: Changes[Index].KeywordLoc, E: Changes[Index].VersionRange.getEnd() };
            }
            Changes[Index].KeywordLoc = KeywordLoc;
            Changes[Index].Version = Version;
            Changes[Index].VersionRange = VersionRange;
        } else {
             << Keyword << VersionRange;
        }
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    if T.consumeClose() {
        return;
    }
    if endLoc {
        *endLoc = T.getCloseLocation();
    }
    if UnavailableLoc.isValid() {
        let mut Complained: bool = false;
        for let mut Index: u32 = Introduced; Index != Unknown; Index += 1 {
            if Changes[Index].KeywordLoc.isValid() {
                if !Complained {
                     << SourceRange { B: Changes[Index].KeywordLoc, E: Changes[Index].VersionRange.getEnd() };
                    Complained = true;
                }
                Changes[Index] = AvailabilityChange {};
            }
        }
    }
    attrs;
}

fn Parser::ParseExternalSourceSymbolAttribute(self, ExternalSourceSymbol: *mut IdentifierInfo, Loc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume("", unknown) {
        return;
    }
    if !self.Ident_language {
        self.Ident_language = self.PP.getIdentifierInfo("language");
        self.Ident_defined_in = self.PP.getIdentifierInfo("defined_in");
        self.Ident_generated_declaration = self.PP.getIdentifierInfo("generated_declaration");
        self.Ident_USR = self.PP.getIdentifierInfo("USR");
    }
    let mut Language: i32 = 0;
    let mut HasLanguage: bool = false;
    let mut DefinedInExpr: i32 = 0;
    let mut HasDefinedIn: bool = false;
    let mut GeneratedDeclaration: *mut IdentifierLoc = null;
    let mut USR: i32 = 0;
    let mut HasUSR: bool = false;
    while true {
        {
        if self.Tok.isNot(identifier) {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        let mut KeywordLoc: SourceLocation = self.Tok.getLocation();
        let mut Keyword: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        if Keyword == self.Ident_generated_declaration {
            if GeneratedDeclaration {
                 << Keyword;
                self.SkipUntil(r_paren, StopAtSemi);
                return;
            }
            GeneratedDeclaration = self.ParseIdentifierLoc();
            continue;
        }
        if Keyword != self.Ident_language && Keyword != self.Ident_defined_in && Keyword != self.Ident_USR {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        self.ConsumeToken();
        if self.ExpectAndConsume {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
        let mut HadLanguage: bool = HasLanguage;
        let mut HadDefinedIn: bool = HasDefinedIn;
        let mut HadUSR: bool = HasUSR;
        if Keyword == self.Ident_language {
            HasLanguage = true;
        } else if Keyword == self.Ident_USR {
            HasUSR = true;
        } else {
            HasDefinedIn = true;
        }
        if !self.isTokenStringLiteral() {
             << 3 << (if Keyword == self.Ident_language { 0 } else { (if Keyword == self.Ident_defined_in { 1 } else { 2 }) });
            self.SkipUntil(comma, r_paren, StopAtSemi | StopBeforeMatch);
            continue;
        }
        if Keyword == self.Ident_language {
            if HadLanguage {
                 << Keyword;
                continue;
            }
        } else if Keyword == self.Ident_USR {
            if HadUSR {
                 << Keyword;
                continue;
            }
        } else {
            assert!(Keyword == self.Ident_defined_in, "Invalid clause keyword!");
            if HadDefinedIn {
                 << Keyword;
                continue;
            }
        }
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    if T.consumeClose() {
        return;
    }
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
    let mut Args: []ArgsUnion = zeroed();
    Attrs(&mut ExternalSourceSymbol, SourceRange { B: Loc, E: T.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, size(), Form);
}

fn Parser::ParseObjCBridgeRelatedAttribute(self, ObjCBridgeRelated: *mut IdentifierInfo, ObjCBridgeRelatedLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
         << l_paren;
        return;
    }
    if self.Tok.isNot(identifier) {
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    let mut RelatedClass: *mut IdentifierLoc = self.ParseIdentifierLoc();
    if self.ExpectAndConsume(comma, "") {
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    let mut ClassMethod: *mut IdentifierLoc = null;
    if self.Tok.is(identifier) {
        ClassMethod = self.ParseIdentifierLoc();
        if !self.TryConsumeToken(colon) {
            self.SkipUntil(r_paren, StopAtSemi);
            return;
        }
    }
    if !self.TryConsumeToken(comma) {
        if self.Tok.is(colon) {
            
        } else {
            << comma;
        }
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    let mut InstanceMethod: *mut IdentifierLoc = null;
    if self.Tok.is(identifier) {
        InstanceMethod = self.ParseIdentifierLoc();
    } else if self.Tok.isNot(r_paren) {
         << r_paren;
        self.SkipUntil(r_paren, StopAtSemi);
        return;
    }
    if T.consumeClose() {
        return;
    }
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
    Attrs.addNew(&mut ObjCBridgeRelated, SourceRange { B: ObjCBridgeRelatedLoc, E: T.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, RelatedClass, ClassMethod, InstanceMethod, Form);
}

fn Parser::ParseSwiftNewTypeAttribute(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
         << l_paren;
        return;
    }
    if self.Tok.is(r_paren) {
        T.consumeClose();
        return;
    }
    if self.Tok.isNot(kw_struct) && self.Tok.isNot(kw_enum) {
         << &mut AttrName << self.Tok.getIdentifierInfo();
        if !self.isTokenSpecial() {
            self.ConsumeToken();
        }
        T.consumeClose();
        return;
    }
    let mut SwiftType: *mut IdentifierLoc = IdentifierLoc { Loc: self.Tok.getLocation(), II: self.Tok.getIdentifierInfo() };
    self.ConsumeToken();
    if T.consumeClose() {
        return;
    }
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
    let mut Args: []ArgsUnion = zeroed();
    Attrs(&mut AttrName, SourceRange { B: AttrNameLoc, E: T.getCloseLocation() }, AttributeScopeInfo { ScopeName, ScopeLoc }, size(), Form);
}

fn Parser::ParseTypeTagForDatatypeAttribute(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, Form: Form) {
    assert!(self.Tok.is(l_paren), "Attribute arg list not starting with '('");
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    T.consumeOpen();
    if self.Tok.isNot(identifier) {
         << identifier;
        T.skipToEnd();
        return;
    }
    let mut ArgumentKind: *mut IdentifierLoc = self.ParseIdentifierLoc();
    if self.ExpectAndConsume(comma, "") {
        T.skipToEnd();
        return;
    }
    let mut MatchingCTypeRange: SourceRange = SourceRange {};
    let mut MatchingCType: i32 = 0;
    if MatchingCType()() {
        T.skipToEnd();
        return;
    }
    let mut LayoutCompatible: bool = false;
    let mut MustBeNull: bool = false;
    while self.TryConsumeToken(comma) {
        if self.Tok.isNot(identifier) {
             << identifier;
            T.skipToEnd();
            return;
        }
        let mut Flag: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        if Flag.isStr("layout_compatible") {
            LayoutCompatible = true;
        } else if Flag.isStr("must_be_null") {
            MustBeNull = true;
        } else {
             << Flag;
            T.skipToEnd();
            return;
        }
        self.ConsumeToken();
    }
    if !T.consumeClose() {
        Attrs.addNewTypeTagForDatatype(&mut AttrName, AttrNameLoc, AttributeScopeInfo { ScopeName, ScopeLoc }, ArgumentKind, LayoutCompatible, MustBeNull, Form);
    }
    if EndLoc {
        *EndLoc = T.getCloseLocation();
    }
}

fn Parser::DiagnoseProhibitedCXX11Attribute(self) -> bool {
    assert!(self.Tok.is(l_square) && self.NextToken().is(l_square);
    match self.isCXX11AttributeSpecifier(true, false) {
        NotAttributeSpecifier => {
            return false;
        },
        InvalidAttributeSpecifier => {
            
        },
        AttributeSpecifier => {
            let mut BeginLoc: SourceLocation = self.ConsumeBracket();
        },
    }
    llvm_unreachable_internal("All cases handled above.", "clang\\lib\\Parse\\ParseDecl.cpp", 1784);
}

fn Parser::DiagnoseMisplacedCXX11Attribute(self, Attrs: *mut ParsedAttributes, CorrectLocation: SourceLocation) {
    assert!((self.Tok.is(l_square) && self.NextToken().is(l_square)) || self.Tok.is(kw_alignas) || self.Tok.isRegularKeywordAttribute();
    let mut Keyword: *mut IdentifierInfo = if self.Tok.isRegularKeywordAttribute() { self.Tok.getIdentifierInfo() } else { null };
    let mut Loc: SourceLocation = self.Tok.getLocation();
    self.ParseCXX11Attributes(Attrs);
    let mut AttrRange: CharSourceRange = CharSourceRange { Range: Loc, IsTokenRange: true };
    (if Keyword {  << Keyword } else {  }) << CreateInsertionFromRange(CorrectLocation, AttrRange, false) << CreateRemoval(AttrRange);
}

fn Parser::DiagnoseProhibitedAttributes(self, Attrs: *ParsedAttributesView, CorrectLocation: SourceLocation) {
    let mut FirstAttr: *ParsedAttr = if Attrs.is_empty() { null } else { &mut Attrs.front() };
    if CorrectLocation.isValid() {
        let mut AttrRange: CharSourceRange = CharSourceRange { Range: Attrs.Range, IsTokenRange: true };
        (if FirstAttr && FirstAttr.isRegularKeywordAttribute {  << FirstAttr } else {  }) << CreateInsertionFromRange(CorrectLocation, AttrRange, false) << CreateRemoval(AttrRange);
    } else {
        let mut Range: *SourceRange = Attrs.Range;
        (if FirstAttr && FirstAttr.isRegularKeywordAttribute {  << FirstAttr } else {  }) << Range;
    }
}

fn Parser::ProhibitCXX11Attributes(self, Attrs: *mut ParsedAttributes, AttrDiagID: u32, KeywordDiagID: u32, DiagnoseEmptyAttrs: bool, WarnOnUnknownAttrs: bool) {
    if DiagnoseEmptyAttrs && Attrs.empty && Attrs()() {
        let mut LangOpts: *LangOptions = self.getLangOpts();
        let mut SM: *mut SourceManager = self.PP.getSourceManager();
        let mut FirstLSquare: Token = Token {};
        getRawToken(Attrs()(), FirstLSquare, SM, LangOpts);
        if FirstLSquare.is(l_square) {
            let mut SecondLSquare: optional<Token> = zeroed();
            if SecondLSquare() && (l_square) {
                (Attrs()(), AttrDiagID) << Attrs();
                return;
            }
        }
    }
}

fn Parser::DiagnoseCXX11AttributeExtension(self, Attrs: *mut ParsedAttributes) {}

fn Parser::stripTypeAttributesOffDeclSpec(self, Attrs: *mut ParsedAttributes, DS: *mut DeclSpec, TUK: TagUseKind) {
    if TUK == Reference {
        return;
    }
    let mut ToBeMoved: SmallVector<ParsedAttr *, 1> = zeroed();
}

fn Parser::ParseDeclaration(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, DeclAttrs: *mut ParsedAttributes, DeclSpecAttrs: *mut ParsedAttributes, DeclSpecStart: *mut SourceLocation) -> DeclGroupPtrTy {
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    let mut ObjCDC: ObjCDeclContextSwitch = *self;
    let mut SingleDecl: *mut Decl = null;
    match self.Tok.getKind() {
        kw_template => {
            kw_export;
        },
        kw_inline => {
            if self.getLangOpts() && self.NextToken().is(kw_namespace) {
                self.ProhibitAttributes(DeclAttrs, SourceLocation {});
                self.ProhibitAttributes(DeclSpecAttrs, SourceLocation {});
                let mut InlineLoc: SourceLocation = self.ConsumeToken();
                return self.ParseNamespace;
            }
        },
        kw_cbuffer => {
            kw_tbuffer;
        },
        kw_namespace => {
            self.ProhibitAttributes(DeclAttrs, SourceLocation {});
        },
        kw_using => {
            takeAndConcatenateAttrs(DeclAttrs, move(DeclSpecAttrs));
            return self.ParseUsingDirectiveOrDeclaration;
        },
        kw_static_assert => {
            kw__Static_assert;
        },
        _ => {
            return self.ParseSimpleDeclaration;
        },
    }
    return self.Actions.ConvertDeclToDeclGroup;
}

fn Parser::ParseSimpleDeclaration(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, DeclAttrs: *mut ParsedAttributes, DeclSpecAttrs: *mut ParsedAttributes, RequireSemi: bool, FRI: *mut ForRangeInit, DeclSpecStart: *mut SourceLocation) -> DeclGroupPtrTy {
    let mut OriginalDeclSpecAttrs: ParsedAttributesView = ParsedAttributesView {};
    OriginalDeclSpecAttrs(DeclSpecAttrs, DeclSpecAttrs);
    OriginalDeclSpecAttrs.Range = DeclSpecAttrs();
    let mut DS: ParsingDeclSpec = *self;
    DS.takeAttributesAppendingingFrom;
    let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
    let mut DSContext: DeclSpecContext = self.getDeclSpecContextFromDeclaratorContext(Context);
    if DS.hasTagDefinition && self.DiagnoseMissingSemiAfterTagDefinition {
        return null;
    }
    if self.Tok.is(semi) {
        self.ProhibitAttributes(DeclAttrs, SourceLocation {});
        DeclEnd = self.Tok.getLocation();
        if RequireSemi {
            self.ConsumeToken();
        }
        let mut AnonRecord: *mut RecordDecl = null;
        let mut TheDecl: *mut Decl = self.Actions;
        self.Actions.ActOnDefinedDeclarationSpecifier(TheDecl);
        DS.complete(TheDecl);
        if AnonRecord {
            let mut decls: []*mut Decl = [AnonRecord, TheDecl];
            return self.Actions.BuildDeclaratorGroup;
        }
        return self.Actions.ConvertDeclToDeclGroup;
    }
    if DS.hasTagDefinition {
        self.Actions.ActOnDefinedDeclarationSpecifier(DS.getRepAsDecl);
    }
    if DeclSpecStart {
        DS.SetRangeStart;
    }
    return self.ParseDeclGroup;
}

fn Parser::MightBeDeclarator(self, Context: DeclaratorContext) -> bool {
    match self.Tok.getKind() {
        annot_cxxscope => {
            annot_template_id;
        },
        amp => {
            ampamp;
        },
        l_square => {
            return Context == Member && self.getLangOpts() && self.NextToken().is(l_square);
        },
        colon => {
            return Context == Member || self.getLangOpts();
        },
        identifier => {
            match self.NextToken().getKind() {
                code_completion => {
                    coloncolon;
                },
                colon => {
                    return Context == Member || (self.getLangOpts() && Context == File);
                },
                identifier => {
                    return self.getLangOpts() && self.isCXX11VirtSpecifier(self.NextToken());
                },
                _ => {
                    return self.Tok.isRegularKeywordAttribute();
                },
            }
        },
        _ => {
            return self.Tok.isRegularKeywordAttribute();
        },
    }
}

fn Parser::SkipMalformedDecl(self) {
    while true {
        match self.Tok.getKind() {
            l_brace => {
                self.ConsumeBrace();
            },
            l_square => {
                self.ConsumeBracket();
            },
            l_paren => {
                self.ConsumeParen();
            },
            r_brace => {
                return;
            },
            semi => {
                self.ConsumeToken();
            },
            kw_inline => {
                if self.Tok.isAtStartOfLine() && self.NextToken().is(kw_namespace) && (!self.ParsingInObjCContainer || self.CurParsedObjCImpl) {
                    return;
                }
            },
            kw_extern => {
                kw_namespace;
            },
            at => {
                if self.NextToken().isObjCAtKeyword(objc_end) && self.ParsingInObjCContainer {
                    return;
                }
            },
            minus => {
                plus;
            },
            eof => {
                annot_module_begin;
            },
            _ => {
                break;
            },
        }
        self.ConsumeAnyToken(false);
    }
}

