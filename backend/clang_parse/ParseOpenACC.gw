}

fn Parser::ParseOpenACCAfterRoutineDecl(self, AS: *mut AccessSpecifier, Attrs: *mut ParsedAttributes, TagType: TST, TagDecl: *mut Decl, DirInfo: *mut OpenACCDirectiveParseInfo) -> DeclGroupPtrTy {
    assert!(DirInfo.DirKind == Routine);
