fn isOpenACCDirectiveKind(Kind: OpenACCDirectiveKind, Tok: Token) -> bool {
    if !Tok.is(identifier) {
        return false;
    }
    match Kind {
        Parallel => {
            return Tok.getIdentifierInfo().isStr("parallel");
        },
        Serial => {
            return Tok.getIdentifierInfo().isStr("serial");
        },
        Kernels => {
            return Tok.getIdentifierInfo().isStr("kernels");
        },
        Data => {
            return Tok.getIdentifierInfo().isStr("data");
        },
        HostData => {
            return Tok.getIdentifierInfo().isStr("host_data");
        },
        Loop => {
            return Tok.getIdentifierInfo().isStr("loop");
        },
        Cache => {
            return Tok.getIdentifierInfo().isStr("cache");
        },
        ParallelLoop => {
            SerialLoop;
        },
        Atomic => {
            return Tok.getIdentifierInfo().isStr("atomic");
        },
        Routine => {
            return Tok.getIdentifierInfo().isStr("routine");
        },
        Declare => {
            return Tok.getIdentifierInfo().isStr("declare");
        },
        Init => {
            return Tok.getIdentifierInfo().isStr("init");
        },
        Shutdown => {
            return Tok.getIdentifierInfo().isStr("shutdown");
        },
        Set => {
            return Tok.getIdentifierInfo().isStr("set");
        },
        Update => {
            return Tok.getIdentifierInfo().isStr("update");
        },
        Wait => {
            return Tok.getIdentifierInfo().isStr("wait");
        },
        Invalid => {
            return false;
        },
    }
    llvm_unreachable_internal("Unknown 'Kind' Passed", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 311);
}

fn ParseReductionOperator(P: *mut Parser) -> OpenACCReductionOperator {
    if P.NextToken().isNot(colon) {
        P.Diag(P.getCurToken(), err_acc_expected_reduction_operator);
        return Invalid;
    }
    let mut ReductionKindTok: Token = P.getCurToken();
    P.ConsumeToken();
    P.ConsumeToken();
    match ReductionKindTok.getKind() {
        plus => {
            return Addition;
        },
        star => {
            return Multiplication;
        },
        amp => {
            return BitwiseAnd;
        },
        pipe => {
            return BitwiseOr;
        },
        caret => {
            return BitwiseXOr;
        },
        ampamp => {
            return And;
        },
        pipepipe => {
            return Or;
        },
        identifier => {
            if ReductionKindTok.getIdentifierInfo().isStr("max") {
                return Max;
            }
        },
        _ => {
            P.Diag(ReductionKindTok, err_acc_invalid_reduction_operator);
        },
    }
    llvm_unreachable_internal("Reduction op token kind not caught by 'default'?", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 352);
}

fn expectIdentifierOrKeyword(P: *mut Parser) -> bool {
    let mut Tok: Token = P.getCurToken();
    if isTokenIdentifierOrKeyword(P, Tok) {
        return false;
    }
    P.Diag(P.getCurToken(), err_expected) << identifier;
    return true;
}

fn ParseOpenACCEnterExitDataDirective(P: *mut Parser, FirstTok: Token, ExtDirKind: OpenACCDirectiveKindEx) -> OpenACCDirectiveKind {
    let mut SecondTok: Token = P.getCurToken();
    if SecondTok.isAnnotation() {
        P.Diag(FirstTok, err_acc_invalid_directive) << 0 << FirstTok.getIdentifierInfo();
        return Invalid;
    }
    P.ConsumeAnyToken(false);
    if !isOpenACCDirectiveKind(Data, SecondTok) {
        if !SecondTok.is(identifier) {
            P.Diag(SecondTok, err_expected) << identifier;
        } else {
            P.Diag(FirstTok, err_acc_invalid_directive) << 1 << FirstTok.getIdentifierInfo().getName() << SecondTok.getIdentifierInfo().getName();
        }
        return Invalid;
    }
    return if ExtDirKind == Enter { EnterData } else { ExitData };
}

fn ParseOpenACCAtomicKind(P: *mut Parser) -> OpenACCAtomicKind {
    let mut AtomicClauseToken: Token = P.getCurToken();
    if AtomicClauseToken.isAnnotation() {
        return None;
    }
    let mut AtomicKind: OpenACCAtomicKind = getOpenACCAtomicKind(AtomicClauseToken);
    if AtomicKind != None {
        P.ConsumeToken();
    }
    return AtomicKind;
}

fn ParseOpenACCDirectiveKind(P: *mut Parser) -> OpenACCDirectiveKind {
    let mut FirstTok: Token = P.getCurToken();
    if FirstTok.isNot(identifier) {
        P.Diag(FirstTok, err_acc_missing_directive);
        if P.getCurToken().isNot(annot_pragma_openacc_end) {
            P.ConsumeAnyToken(false);
        }
        return Invalid;
    }
    P.ConsumeToken();
    let mut ExDirKind: OpenACCDirectiveKindEx = getOpenACCDirectiveKind(FirstTok);
    if ExDirKind >= Invalid {
        match ExDirKind {
            Invalid => {
                P.Diag(FirstTok, err_acc_invalid_directive) << 0 << FirstTok.getIdentifierInfo();
                return Invalid;
            },
            Enter => {
                Exit;
            },
        }
    }
    let mut DirKind: OpenACCDirectiveKind = ExDirKind as OpenACCDirectiveKind;
    let mut SecondTok: Token = P.getCurToken();
    if !SecondTok.isAnnotation() && isOpenACCDirectiveKind(Loop, SecondTok) {
        match DirKind {
            _ => {
                break;
            },
            Parallel => {
                P.ConsumeToken();
            },
            Serial => {
                P.ConsumeToken();
            },
            Kernels => {
                P.ConsumeToken();
            },
        }
    }
    return DirKind;
}

enum ClauseParensKind {
    None = 0,
    Optional = 1,
    Required = 2,
}

fn getClauseParensKind(DirKind: OpenACCDirectiveKind, Kind: OpenACCClauseKind) -> ClauseParensKind {
    match Kind {
        Self => {
            return if DirKind == Update { Required } else { Optional };
        },
        Async => {
            Worker;
        },
        Default => {
            If;
        },
        Shortloop => {
            llvm_unreachable_internal("Shortloop shouldn't be generated in clang", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 541);
        },
        Auto => {
            Finalize;
        },
    }
    llvm_unreachable_internal("Unhandled clause kind", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 551);
}

fn ClauseHasOptionalParens(DirKind: OpenACCDirectiveKind, Kind: OpenACCClauseKind) -> bool {
    return getClauseParensKind(DirKind, Kind) == Optional;
}

fn ClauseHasRequiredParens(DirKind: OpenACCDirectiveKind, Kind: OpenACCClauseKind) -> bool {
    return getClauseParensKind(DirKind, Kind) == Required;
}

fn SkipUntilEndOfDirective(P: *mut Parser) {
    while P.getCurToken().isNot(annot_pragma_openacc_end) {
        P.ConsumeAnyToken(false);
    }
}

fn doesDirectiveHaveAssociatedStmt(DirKind: OpenACCDirectiveKind) -> bool {
    match DirKind {
        Routine => {
            Cache;
        },
        Parallel => {
            Serial;
        },
    }
    llvm_unreachable_internal("Unhandled directive->assoc stmt", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 601);
}

fn getOpenACCScopeFlags(DirKind: OpenACCDirectiveKind) -> u32 {
    match DirKind {
        Parallel => {
            Serial;
        },
        ParallelLoop => {
            SerialLoop;
        },
        Loop => {
            return DeclScope | OpenACCLoopConstructScope;
        },
        Data => {
            EnterData;
        },
        Invalid => {
            llvm_unreachable_internal("Shouldn't be creating a scope for an invalid construct", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 638);
        },
    }
    llvm_unreachable_internal("Shouldn't be creating a scope for an invalid construct", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 640);
}

fn Parser::OpenACCCanContinue(self) -> OpenACCClauseParseResult {
    return OpenACCClauseParseResult { null, Can };
}

fn Parser::OpenACCCannotContinue(self) -> OpenACCClauseParseResult {
    return OpenACCClauseParseResult { null, Cannot };
}

fn Parser::OpenACCSuccess(self, Clause: *mut OpenACCClause) -> OpenACCClauseParseResult {
    return OpenACCClauseParseResult { Clause, Can };
}

fn Parser::ParseOpenACCConditionExpr(self) -> ExprResult {
    let mut ER: ExprResult = self.ParseExpression(AllowNonTypes);
    if !ER.isUsable() {
        return ER;
    }
    let mut R: ConditionResult = self.getActions().ActOnCondition(self.getCurScope(), ER.get().getExprLoc(), ER.get(), Boolean, false);
    return if R.isInvalid() { ExprError() } else { R.get().second };
}

fn Parser::tryParseModifierList(self, CK: OpenACCClauseKind) -> OpenACCModifierKind {
    {
        let mut TPA: RevertingTentativeParsingAction = RevertingTentativeParsingAction { *self, false };
        while isTokenIdentifierOrKeyword(*self, self.getCurToken()) && self.NextToken().is(comma) {
            self.ConsumeToken();
            self.ConsumeToken();
        }
        if !isTokenIdentifierOrKeyword(*self, self.getCurToken()) || !self.NextToken().is(colon) {
            return Invalid;
        }
    }
    let mut GetModKind: Closure_1 = Closure_1 {};
    let mut CurModList: OpenACCModifierKind = Invalid;
    let mut ConsumeModKind: Closure_2 = Closure_2 { cap_0: self, GetModKind: &mut GetModKind, CK: &mut CK, CurModList: &mut CurModList };
    while self.NextToken().is(comma) {
        ConsumeModKind.call();
    }
    ConsumeModKind.call();
    return CurModList;
}

fn Parser::ParseOpenACCClauseList(self, DirKind: OpenACCDirectiveKind) -> SmallVector<OpenACCClause *> {
    let mut Clauses: SmallVector<OpenACCClause *> = SmallVector<OpenACCClause *> {};
    let mut FirstClause: bool = true;
    while self.getCurToken().isNot(annot_pragma_openacc_end) {
        if !FirstClause && self.getCurToken().is(comma) {
            self.ConsumeToken();
        }
        FirstClause = false;
        let mut Result: OpenACCClauseParseResult = self.ParseOpenACCClause(Clauses, DirKind);
        if Result.getPointer() {
            Clause;
        } else {
            Clauses.push(Clause);
        }
    }
    return Clauses;
}

fn Parser::ParseOpenACCIntExpr(self, DK: OpenACCDirectiveKind, CK: OpenACCClauseKind, Loc: SourceLocation) -> OpenACCIntExprParseResult {
    let mut ER: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
    if !ER.isUsable() {
        return OpenACCIntExprParseResult { ER, Cannot };
    }
    return OpenACCIntExprParseResult { self.getActions().OpenACC().ActOnIntExpr(DK, CK, Loc, ER.get()), Can };
}

fn Parser::ParseOpenACCIntExprList(self, DK: OpenACCDirectiveKind, CK: OpenACCClauseKind, Loc: SourceLocation, IntExprs: *mut SmallVectorImpl<Expr *>) -> bool {
    let mut CurResult: OpenACCIntExprParseResult = self.ParseOpenACCIntExpr(DK, CK, Loc);
    if !CurResult.first.isUsable() && CurResult.second == Cannot {
        self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
        return true;
    }
    IntExprs.push(CurResult.first.get());
    while !self.getCurToken().isOneOf(r_paren, annot_pragma_openacc_end) {
        self.ExpectAndConsume(comma, err_expected, "");
        CurResult = self.ParseOpenACCIntExpr(DK, CK, Loc);
        if !CurResult.first.isUsable() && CurResult.second == Cannot {
            self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
            return true;
        }
        IntExprs.push(CurResult.first.get());
    }
    return false;
}

fn Parser::ParseOpenACCDeviceTypeList(self, Archs: *mut SmallVector<IdentifierLoc>) -> bool {
    if expectIdentifierOrKeyword(*self) {
        self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
        return true;
    }
    let mut Ident: *mut IdentifierInfo = self.getCurToken().getIdentifierInfo();
    Archs.push(self.ConsumeToken(), Ident);
    while !self.getCurToken().isOneOf(r_paren, annot_pragma_openacc_end) {
        self.ExpectAndConsume(comma, err_expected, "");
        if expectIdentifierOrKeyword(*self) {
            self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
            return true;
        }
        Ident = self.getCurToken().getIdentifierInfo();
        Archs.push(self.ConsumeToken(), Ident);
    }
    return false;
}

fn Parser::ParseOpenACCSizeExpr(self, CK: OpenACCClauseKind) -> ExprResult {
    if self.getCurToken().is(star) && self.NextToken().isOneOf(comma, r_paren, annot_pragma_openacc_end) {
        let mut AsteriskLoc: SourceLocation = self.ConsumeToken();
        return self.getActions().OpenACC().ActOnOpenACCAsteriskSizeExpr(AsteriskLoc);
    }
    let mut SizeExpr: ExprResult = self.ParseConstantExpression();
    if !SizeExpr.isUsable() {
        return SizeExpr;
    }
    SizeExpr = self.getActions().OpenACC().ActOnIntExpr(Invalid, CK, SizeExpr.get().getBeginLoc(), SizeExpr.get());
    return SizeExpr;
}

fn Parser::ParseOpenACCSizeExprList(self, CK: OpenACCClauseKind, SizeExprs: *mut SmallVectorImpl<Expr *>) -> bool {
    let mut SizeExpr: ExprResult = self.ParseOpenACCSizeExpr(CK);
    if !SizeExpr.isUsable() {
        self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
        return true;
    }
    SizeExprs.push(SizeExpr.get());
    while !self.getCurToken().isOneOf(r_paren, annot_pragma_openacc_end) {
        self.ExpectAndConsume(comma, err_expected, "");
        SizeExpr = self.ParseOpenACCSizeExpr(CK);
        if !SizeExpr.isUsable() {
            self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
            return true;
        }
        SizeExprs.push(SizeExpr.get());
    }
    return false;
}

fn Parser::ParseOpenACCGangArg(self, GangLoc: SourceLocation) -> OpenACCGangArgRes {
    if isOpenACCSpecialToken(Static, self.getCurToken()) && self.NextToken().is(colon) {
        self.ConsumeToken();
        self.ConsumeToken();
        let mut Res: ExprResult = self.ParseOpenACCSizeExpr(Gang);
        return OpenACCGangArgRes { Static, Res };
    }
    if isOpenACCSpecialToken(Dim, self.getCurToken()) && self.NextToken().is(colon) {
        self.ConsumeToken();
        self.ConsumeToken();
        let mut Res: ExprResult = self.ParseConstantExpression();
        return OpenACCGangArgRes { Dim, Res };
    }
    if isOpenACCSpecialToken(Num, self.getCurToken()) && self.NextToken().is(colon) {
        self.ConsumeToken();
        self.ConsumeToken();
    }
    let mut Res: ExprResult = self.ParseOpenACCIntExpr(Invalid, Gang, GangLoc).first;
    return OpenACCGangArgRes { Num, Res };
}

fn Parser::ParseOpenACCGangArgList(self, GangLoc: SourceLocation, GKs: *mut SmallVectorImpl<OpenACCGangKind>, IntExprs: *mut SmallVectorImpl<Expr *>) -> bool {
    let mut Res: OpenACCGangArgRes = self.ParseOpenACCGangArg(GangLoc);
    if !Res.second.isUsable() {
        self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
        return true;
    }
    GKs.push(Res.first);
    IntExprs.push(Res.second.get());
    while !self.getCurToken().isOneOf(r_paren, annot_pragma_openacc_end) {
        self.ExpectAndConsume(comma, err_expected, "");
        Res = self.ParseOpenACCGangArg(GangLoc);
        if !Res.second.isUsable() {
            self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
            return true;
        }
        GKs.push(Res.first);
        IntExprs.push(Res.second.get());
    }
    return false;
}

fn isUnsupportedExtensionClause(Tok: Token) -> bool {
    if !Tok.is(identifier) {
        return false;
    }
    return Tok.getIdentifierInfo().getName().starts_with("__");
}

fn Parser::ParseOpenACCClause(self, ExistingClauses: ArrayRef<const OpenACCClause *>, DirKind: OpenACCDirectiveKind) -> OpenACCClauseParseResult {
    if expectIdentifierOrKeyword(*self) {
        return self.OpenACCCannotContinue();
    }
    let mut Kind: OpenACCClauseKind = getOpenACCClauseKind(self.getCurToken());
    if isUnsupportedExtensionClause(self.getCurToken()) {
        self.Diag(self.getCurToken(), warn_acc_unsupported_extension_clause) << self.getCurToken().getIdentifierInfo();
        self.ConsumeToken();
        let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openacc_end };
        if !Parens.consumeOpen() {
            Parens.skipToEnd();
        }
        return self.OpenACCCanContinue();
    } else if Kind == Invalid {
        self.Diag(self.getCurToken(), err_acc_invalid_clause) << self.getCurToken().getIdentifierInfo();
        return self.OpenACCCannotContinue();
    }
    let mut ClauseLoc: SourceLocation = self.ConsumeToken();
    return self.ParseOpenACCClauseParams(ExistingClauses, DirKind, Kind, ClauseLoc);
}

fn Parser::ParseOpenACCClauseParams(self, ExistingClauses: ArrayRef<const OpenACCClause *>, DirKind: OpenACCDirectiveKind, ClauseKind: OpenACCClauseKind, ClauseLoc: SourceLocation) -> OpenACCClauseParseResult {
    let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openacc_end };
    let mut ParsedClause: OpenACCParsedClause = OpenACCParsedClause { DirKind, ClauseKind, ClauseLoc };
    if ClauseHasRequiredParens(DirKind, ClauseKind) {
        if Parens.expectAndConsume(err_expected, "", unknown) {
            self.SkipUntil(comma, r_paren, annot_pragma_openacc_end, StopBeforeMatch);
            return self.OpenACCCanContinue();
        }
        ParsedClause.setLParenLoc(Parens.getOpenLocation());
        match ClauseKind {
            Default => {
                let mut DefKindTok: Token = self.getCurToken();
                if expectIdentifierOrKeyword(*self) {
                    Parens.skipToEnd();
                    return self.OpenACCCanContinue();
                }
                self.ConsumeToken();
                let mut DefKind: OpenACCDefaultClauseKind = getOpenACCDefaultClauseKind(DefKindTok);
                if DefKind == Invalid {
                    self.Diag(DefKindTok, err_acc_invalid_default_clause_kind);
                    Parens.skipToEnd();
                    return self.OpenACCCanContinue();
                }
                ParsedClause.setDefaultDetails(DefKind);
                break;
            },
            If => {
                let mut CondExpr: ExprResult = self.ParseOpenACCConditionExpr();
                ParsedClause.setConditionDetails(if CondExpr.isUsable() { CondExpr.get() } else { null });
                if CondExpr.isInvalid() {
                    Parens.skipToEnd();
                    return self.OpenACCCanContinue();
                }
                break;
            },
            Copy => {
                PCopy;
            },
            Reduction => {
                let mut Op: OpenACCReductionOperator = ParseReductionOperator(*self);
                ParsedClause.setReductionDetails(Op, self.ParseOpenACCVarList(DirKind, ClauseKind));
                break;
            },
            Self => {
                assert!(DirKind == Update);
            },
            Device => {
                Host;
            },
            Collapse => {
                let mut HasForce: bool = tryParseAndConsumeSpecialTokenKind(*self, Force, ClauseKind);
                let mut LoopCount: ExprResult = self.ParseConstantExpression();
                if LoopCount.isInvalid() {
                    Parens.skipToEnd();
                    return self.OpenACCCanContinue();
                }
                LoopCount = self.getActions().OpenACC().ActOnIntExpr(Invalid, ClauseKind, LoopCount.get().getBeginLoc(), LoopCount.get());
                if LoopCount.isInvalid() {
                    Parens.skipToEnd();
                    return self.OpenACCCanContinue();
                }
                ParsedClause.setCollapseDetails(HasForce, LoopCount.get());
                break;
            },
            Bind => {
                ParsedClause.setBindDetails(self.ParseOpenACCBindClauseArgument());
                if holds_alternative(ParsedClause.getBindDetails()) {
                    Parens.skipToEnd();
                    return self.OpenACCCanContinue();
                }
                break;
            },
            NumGangs => {
                let mut IntExprs: SmallVector<Expr *> = SmallVector<Expr *> {};
                if self.ParseOpenACCIntExprList(Invalid, NumGangs, ClauseLoc, IntExprs) {
                    Parens.skipToEnd();
                    return self.OpenACCCanContinue();
                }
                ParsedClause.setIntExprDetails(move(IntExprs));
                break;
            },
            NumWorkers => {
                DeviceNum;
            },
            DType => {
                DeviceType;
            },
            Tile => {
                let mut SizeExprs: SmallVector<Expr *> = SmallVector<Expr *> {};
                if self.ParseOpenACCSizeExprList(Tile, SizeExprs) {
                    Parens.skipToEnd();
                    return self.OpenACCCanContinue();
                }
                ParsedClause.setIntExprDetails(move(SizeExprs));
                break;
            },
            _ => {
                llvm_unreachable_internal("Not a required parens type?", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 1173);
            },
        }
        ParsedClause.setEndLoc(self.getCurToken().getLocation());
        if Parens.consumeClose() {
            return self.OpenACCCannotContinue();
        }
    } else if ClauseHasOptionalParens(DirKind, ClauseKind) {
        if !Parens.consumeOpen() {
            ParsedClause.setLParenLoc(Parens.getOpenLocation());
            match ClauseKind {
                Self => {
                    assert!(DirKind != Update);
                    let mut CondExpr: ExprResult = self.ParseOpenACCConditionExpr();
                    ParsedClause.setConditionDetails(if CondExpr.isUsable() { CondExpr.get() } else { null });
                    if CondExpr.isInvalid() {
                        Parens.skipToEnd();
                        return self.OpenACCCanContinue();
                    }
                    break;
                },
                Vector => {
                    Worker;
                },
                Async => {
                    let mut AsyncArg: ExprResult = self.ParseOpenACCAsyncArgument(Invalid, Async, ClauseLoc).first;
                    ParsedClause.setIntExprDetails(if AsyncArg.isUsable() { AsyncArg.get() } else { null });
                    if AsyncArg.isInvalid() {
                        Parens.skipToEnd();
                        return self.OpenACCCanContinue();
                    }
                    break;
                },
                Gang => {
                    let mut GKs: SmallVector<OpenACCGangKind> = SmallVector<OpenACCGangKind> {};
                    let mut IntExprs: SmallVector<Expr *> = SmallVector<Expr *> {};
                    if self.ParseOpenACCGangArgList(ClauseLoc, GKs, IntExprs) {
                        Parens.skipToEnd();
                        return self.OpenACCCanContinue();
                    }
                    ParsedClause.setGangDetails(move(GKs), move(IntExprs));
                    break;
                },
                Wait => {
                    let mut Info: OpenACCWaitParseInfo = self.ParseOpenACCWaitArgument(ClauseLoc, false);
                    if Info.Failed {
                        Parens.skipToEnd();
                        return self.OpenACCCanContinue();
                    }
                    ParsedClause.setWaitDetails(Info.DevNumExpr, Info.QueuesLoc, move(Info.QueueIdExprs));
                    break;
                },
                _ => {
                    llvm_unreachable_internal("Not an optional parens type?", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 1252);
                },
            }
            ParsedClause.setEndLoc(self.getCurToken().getLocation());
            if Parens.consumeClose() {
                return self.OpenACCCannotContinue();
            }
        } else {
            ParsedClause.setEndLoc(ClauseLoc);
        }
    } else {
        ParsedClause.setEndLoc(ClauseLoc);
    }
    return self.OpenACCSuccess(self.Actions.OpenACC().ActOnClause(ExistingClauses, ParsedClause));
}

fn Parser::ParseOpenACCAsyncArgument(self, DK: OpenACCDirectiveKind, CK: OpenACCClauseKind, Loc: SourceLocation) -> OpenACCIntExprParseResult {
    return self.ParseOpenACCIntExpr(DK, CK, Loc);
}

fn Parser::ParseOpenACCWaitArgument(self, Loc: SourceLocation, IsDirective: bool) -> OpenACCWaitParseInfo {
    let mut Result: OpenACCWaitParseInfo = OpenACCWaitParseInfo {};
    if isOpenACCSpecialToken(DevNum, self.Tok) && self.NextToken().is(colon) {
        self.ConsumeToken();
        self.ConsumeToken();
        let mut Res: OpenACCIntExprParseResult = self.ParseOpenACCIntExpr(if IsDirective { Wait } else { Invalid }, if IsDirective { Invalid } else { Wait }, Loc);
        if Res.first.isInvalid() && Res.second == Cannot {
            Result.Failed = true;
            return Result;
        }
        if self.ExpectAndConsume(colon, err_expected, "") {
            Result.Failed = true;
            return Result;
        }
        Result.DevNumExpr = Res.first.get();
    }
    if isOpenACCSpecialToken(Queues, self.Tok) && self.NextToken().is(colon) {
        Result.QueuesLoc = self.ConsumeToken();
        self.ConsumeToken();
    }
    let mut Res: OpenACCIntExprParseResult = self.ParseOpenACCAsyncArgument(if IsDirective { Wait } else { Invalid }, if IsDirective { Invalid } else { Wait }, Loc);
    if Res.first.isInvalid() && Res.second == Cannot {
        Result.Failed = true;
        return Result;
    }
    if Res.first.isUsable() {
        Result.QueueIdExprs.push(Res.first.get());
    }
    while !self.getCurToken().isOneOf(r_paren, annot_pragma_openacc_end) {
        if self.ExpectAndConsume(comma, err_expected, "") {
            Result.Failed = true;
            return Result;
        }
        let mut Res: OpenACCIntExprParseResult = self.ParseOpenACCAsyncArgument(if IsDirective { Wait } else { Invalid }, if IsDirective { Invalid } else { Wait }, Loc);
        if Res.first.isInvalid() && Res.second == Cannot {
            Result.Failed = true;
            return Result;
        }
        if Res.first.isUsable() {
            Result.QueueIdExprs.push(Res.first.get());
        }
    }
    return Result;
}

fn Parser::ParseOpenACCIDExpression(self) -> ExprResult {
    let mut Res: ExprResult = false;
    if self.getLangOpts().CPlusPlus {
        Res = self.ParseCXXIdExpression(true);
    } else {
        if self.Tok.isNot(identifier) {
            self.Diag(self.Tok, err_expected) << identifier;
            return ExprError();
        }
        let mut FuncName: Token = self.getCurToken();
        let mut Name: UnqualifiedId = UnqualifiedId {};
        let mut ScopeSpec: CXXScopeSpec = CXXScopeSpec {};
        let mut TemplateKWLoc: SourceLocation = SourceLocation {};
        Name.setIdentifier(FuncName.getIdentifierInfo(), self.ConsumeToken());
        Res = self.Actions.ActOnIdExpression(self.getCurScope(), ScopeSpec, TemplateKWLoc, Name, false, false, null, false);
    }
    return Res;
}

fn Parser::ParseOpenACCBindClauseArgument(self) -> StringLiteral *, IdentifierInfo *> {
    if self.getCurToken().is(r_paren) {
        self.Diag(self.getCurToken(), err_acc_incorrect_bind_arg);
        return monostate {};
    }
    if self.getCurToken().is(identifier) {
        let mut II: *mut IdentifierInfo = self.getCurToken().getIdentifierInfo();
        self.ConsumeToken();
        return II;
    }
    if !isStringLiteral(self.getCurToken().getKind()) {
        self.Diag(self.getCurToken(), err_acc_incorrect_bind_arg);
        return monostate {};
    }
    let mut Res: ExprResult = self.ParseStringLiteralExpression(false, true);
    if !Res.isUsable() {
        return monostate {};
    }
    return cast(Res.get());
}

fn Parser::ParseOpenACCVar(self, DK: OpenACCDirectiveKind, CK: OpenACCClauseKind) -> OpenACCVarParseResult {
    let mut ArraySections: OpenACCArraySectionRAII = *self;
    self.getActions().OpenACC().ActOnStartParseVar(DK, CK);
    let mut Res: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
    if !Res.isUsable() {
        self.getActions().OpenACC().ActOnInvalidParseVar();
        return OpenACCVarParseResult { Res, Cannot };
    }
    Res = self.getActions().OpenACC().ActOnVar(DK, CK, Res.get());
    return OpenACCVarParseResult { Res, Can };
}

fn Parser::ParseOpenACCVarList(self, DK: OpenACCDirectiveKind, CK: OpenACCClauseKind) -> SmallVector<Expr *> {
    let mut Vars: SmallVector<Expr *> = SmallVector<Expr *> {};
    if Res.isUsable() {
        Vars.push(Res.get());
    } else if CanContinue == Cannot {
        self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
        return Vars;
    }
    while !self.getCurToken().isOneOf(r_paren, annot_pragma_openacc_end) {
        self.ExpectAndConsume(comma, err_expected, "");
        if Res.isUsable() {
            Vars.push(Res.get());
        } else if CanContinue == Cannot {
            self.SkipUntil(r_paren, annot_pragma_openacc_end, StopBeforeMatch);
            return Vars;
        }
    }
    return Vars;
}

fn Parser::ParseOpenACCCacheVarList(self) -> OpenACCCacheParseInfo {
    if self.getCurToken().isAnnotation() {
        return OpenACCCacheParseInfo { false, SourceLocation {}, SmallVector<Expr *> {} };
    }
    let mut CacheInfo: OpenACCCacheParseInfo = OpenACCCacheParseInfo {};
    let mut ReadOnlyLoc: SourceLocation = self.getCurToken().getLocation();
    if tryParseAndConsumeSpecialTokenKind(*self, ReadOnly, Cache) {
        CacheInfo.ReadOnlyLoc = ReadOnlyLoc;
    }
    CacheInfo.Vars = self.ParseOpenACCVarList(Cache, Invalid);
    return CacheInfo;
}

fn Parser::ParseOpenACCDirective(self) -> OpenACCDirectiveParseInfo {
    let mut StartLoc: SourceLocation = self.ConsumeAnnotationToken();
    let mut DirLoc: SourceLocation = self.getCurToken().getLocation();
    let mut DirKind: OpenACCDirectiveKind = ParseOpenACCDirectiveKind(*self);
    let mut WaitInfo: OpenACCWaitParseInfo = OpenACCWaitParseInfo {};
    let mut CacheInfo: OpenACCCacheParseInfo = OpenACCCacheParseInfo {};
    let mut AtomicKind: OpenACCAtomicKind = None;
    let mut RoutineName: ExprResult = false;
    self.getActions().OpenACC().ActOnConstruct(DirKind, DirLoc);
    if DirKind == Atomic {
        AtomicKind = ParseOpenACCAtomicKind(*self);
    }
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openacc_end };
    if !T.consumeOpen() {
        match DirKind {
            _ => {
                self.Diag(T.getOpenLocation(), err_acc_invalid_open_paren);
            },
            Routine => {
                RoutineName = self.ParseOpenACCIDExpression();
                if !RoutineName.isUsable() {
                    T.skipToEnd();
                } else {
                    T.consumeClose();
                    RoutineName = self.getActions().OpenACC().ActOnRoutineName(RoutineName.get());
                }
                break;
            },
            Cache => {
                CacheInfo = self.ParseOpenACCCacheVarList();
            },
            Wait => {
                WaitInfo = self.ParseOpenACCWaitArgument(DirLoc, true);
            },
        }
    } else if DirKind == Cache {
        self.Diag(self.Tok, err_expected) << l_paren;
    }
    let mut ParseInfo: OpenACCDirectiveParseInfo = OpenACCDirectiveParseInfo { DirKind, StartLoc, DirLoc, T.getOpenLocation(), T.getCloseLocation(), SourceLocation {}, (if DirKind == Wait { WaitInfo.QueuesLoc } else { CacheInfo.ReadOnlyLoc }), AtomicKind, SmallVector<Expr *> {}, SmallVector<OpenACCClause *> {} };
    if DirKind == Wait {
        ParseInfo.Exprs = WaitInfo.getAllExprs();
    } else if DirKind == Cache {
        ParseInfo.Exprs = move(CacheInfo.Vars);
    } else if DirKind == Routine && RoutineName.isUsable() {
        ParseInfo.Exprs = SmallVector<Expr *> { 1, RoutineName.get() };
    }
    ParseInfo.Clauses = self.ParseOpenACCClauseList(DirKind);
    assert!(self.Tok.is(annot_pragma_openacc_end), "Didn't parse all OpenACC Clauses");
    ParseInfo.EndLoc = self.ConsumeAnnotationToken();
    assert!(ParseInfo.EndLoc.isValid(), "Terminating annotation token not present");
    return ParseInfo;
}

fn Parser::ParseOpenACCAfterRoutineDecl(self, AS: *mut AccessSpecifier, Attrs: *mut ParsedAttributes, TagType: TST, TagDecl: *mut Decl, DirInfo: *mut OpenACCDirectiveParseInfo) -> DeclGroupPtrTy {
    assert!(DirInfo.DirKind == Routine);
    let mut Ptr: DeclGroupPtrTy = null;
    if DirInfo.LParenLoc.isInvalid() {
        if self.Tok.isNot(r_brace) && !self.isEofOrEom() {
            if AS == AS_none {
                if TagType == TST_unspecified {
                    let mut EmptyDeclSpecAttrs: ParsedAttributes = self.AttrFactory;
                    self.MaybeParseCXX11Attributes(Attrs, false);
                    let mut PDS: ParsingDeclSpec = *self;
                    Ptr = self.ParseExternalDeclaration(Attrs, EmptyDeclSpecAttrs, &mut PDS);
                }
            } else {
                Ptr = self.ParseCXXClassMemberDeclarationWithPragmas(AS, Attrs, TagType, TagDecl);
            }
        }
    }
    return make(self.getActions().OpenACC().ActOnEndRoutineDeclDirective(DirInfo.StartLoc, DirInfo.DirLoc, DirInfo.LParenLoc, if DirInfo.Exprs.is_empty() { null } else { DirInfo.Exprs.front() }, DirInfo.RParenLoc, DirInfo.Clauses, DirInfo.EndLoc, Ptr));
}

fn Parser::ParseOpenACCAfterRoutineStmt(self, DirInfo: *mut OpenACCDirectiveParseInfo) -> StmtResult {
    assert!(DirInfo.DirKind == Routine);
    let mut NextStmt: StmtResult = StmtEmpty();
    if DirInfo.LParenLoc.isInvalid() {
        let mut DirScope: ParsingOpenACCDirectiveRAII = ParsingOpenACCDirectiveRAII { P: *self, OldVal: false };
        NextStmt = self.ParseStatement(null, SubStmt, null);
    }
    return self.getActions().OpenACC().ActOnEndRoutineStmtDirective(DirInfo.StartLoc, DirInfo.DirLoc, DirInfo.LParenLoc, if DirInfo.Exprs.is_empty() { null } else { DirInfo.Exprs.front() }, DirInfo.RParenLoc, DirInfo.Clauses, DirInfo.EndLoc, NextStmt.get());
}

fn Parser::ParseOpenACCDirectiveDecl(self, AS: *mut AccessSpecifier, Attrs: *mut ParsedAttributes, TagType: TST, TagDecl: *mut Decl) -> DeclGroupPtrTy {
    assert!(self.Tok.is(annot_pragma_openacc), "expected OpenACC Start Token");
    let mut DirScope: ParsingOpenACCDirectiveRAII = ParsingOpenACCDirectiveRAII { P: *self, OldVal: true };
    let mut DirInfo: OpenACCDirectiveParseInfo = self.ParseOpenACCDirective();
    if self.getActions().OpenACC().ActOnStartDeclDirective(DirInfo.DirKind, DirInfo.StartLoc, DirInfo.Clauses) {
        return null;
    }
    if DirInfo.DirKind == Routine {
        return self.ParseOpenACCAfterRoutineDecl(AS, Attrs, TagType, TagDecl, DirInfo);
    }
    return make(self.getActions().OpenACC().ActOnEndDeclDirective(DirInfo.DirKind, DirInfo.StartLoc, DirInfo.DirLoc, DirInfo.LParenLoc, DirInfo.RParenLoc, DirInfo.EndLoc, DirInfo.Clauses));
}

fn Parser::ParseOpenACCDirectiveStmt(self) -> StmtResult {
    assert!(self.Tok.is(annot_pragma_openacc), "expected OpenACC Start Token");
    let mut DirScope: ParsingOpenACCDirectiveRAII = ParsingOpenACCDirectiveRAII { P: *self, OldVal: true };
    let mut DirInfo: OpenACCDirectiveParseInfo = self.ParseOpenACCDirective();
    if self.getActions().OpenACC().ActOnStartStmtDirective(DirInfo.DirKind, DirInfo.StartLoc, DirInfo.Clauses) {
        return StmtError();
    }
    if DirInfo.DirKind == Routine {
        return self.ParseOpenACCAfterRoutineStmt(DirInfo);
    }
    let mut AssocStmt: StmtResult = false;
    if doesDirectiveHaveAssociatedStmt(DirInfo.DirKind) {
        let mut AssocStmtRAII: AssociatedStmtRAII = AssociatedStmtRAII { self.getActions().OpenACC(), DirInfo.DirKind, DirInfo.DirLoc, ArrayRef<const OpenACCClause *> {}, DirInfo.Clauses };
        let mut DirScope: ParsingOpenACCDirectiveRAII = ParsingOpenACCDirectiveRAII { P: *self, OldVal: false };
        let mut scopeFlags: u32 = getOpenACCScopeFlags(DirInfo.DirKind);
        let mut ACCScope: ParseScope = ParseScope { self, scopeFlags, scopeFlags != 0, false };
        AssocStmt = self.getActions().OpenACC().ActOnAssociatedStmt(DirInfo.StartLoc, DirInfo.DirKind, DirInfo.AtomicKind, DirInfo.Clauses, self.ParseStatement(null, SubStmt, null));
    }
    return self.getActions().OpenACC().ActOnEndStmtDirective(DirInfo.DirKind, DirInfo.StartLoc, DirInfo.DirLoc, DirInfo.LParenLoc, DirInfo.MiscLoc, DirInfo.Exprs, DirInfo.AtomicKind, DirInfo.RParenLoc, DirInfo.EndLoc, DirInfo.Clauses, AssocStmt);
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, T: Token) -> OpenACCModifierKind {
        return T.getIdentifierInfo().getName().Case("always", Always).Case("alwaysin", AlwaysIn).Case("alwaysout", AlwaysOut).Case("readonly", Readonly).Case("zero", Zero).Case("capture", Capture).Default(Invalid);
    }

struct Closure_2 {
    cap_0: *mut Parser,
    GetModKind: *mut (lambda at P:\Goraw\llvm-project\clang\lib\Parse\ParseOpenACC.cpp:693:21),
    CK: *mut OpenACCClauseKind,
    CurModList: *mut OpenACCModifierKind,
}

unsafe fn Closure_2::call(self: *mut Closure_2) {
        let mut IdentToken: Token = self.getCurToken();
        let mut NewKind: OpenACCModifierKind = (*self.GetModKind).call(IdentToken);
        if NewKind == Invalid {
            self.Diag(IdentToken.getLocation(), err_acc_modifier) << Unknown << IdentToken.getIdentifierInfo() << (*self.CK);
        } else if (NewKind & (*self.CurModList)) != Invalid {
            self.Diag(IdentToken.getLocation(), err_acc_modifier) << Duplicate << IdentToken.getIdentifierInfo() << (*self.CK);
        } else {
            operator((*self.CurModList), NewKind);
        }
        self.ConsumeToken();
        self.ConsumeToken();
    }
