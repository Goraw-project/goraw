enum OpenACCDirectiveKindEx {
    Invalid = 0,
    Enter = 1,
    Exit = 2,
}

fn getOpenACCDirectiveKind(Tok: Token) -> OpenACCDirectiveKindEx {
    if !Tok.is(identifier) {
        return Invalid;
    }
    let mut DirKind: OpenACCDirectiveKind = zeroed();
    if DirKind != Invalid {
        return DirKind as OpenACCDirectiveKindEx;
    }
}

fn getOpenACCClauseKind(Tok: Token) -> OpenACCClauseKind {
    if Tok.is(kw_auto) {
        return Auto;
    }
    if Tok.is(kw_default) {
        return Default;
    }
    if Tok.is(kw_if) {
        return If;
    }
    if Tok.is(kw_private) {
        return Private;
    }
    if Tok.is(kw_delete) {
        return Delete;
    }
    if !Tok.is(identifier) {
        return Invalid;
    }
}

fn getOpenACCAtomicKind(Tok: Token) -> OpenACCAtomicKind {
    if !Tok.is(identifier) {
        return None;
    }
}

fn getOpenACCDefaultClauseKind(Tok: Token) -> OpenACCDefaultClauseKind {
    if !Tok.is(identifier) {
        return Invalid;
    }
}

enum OpenACCSpecialTokenKind {
    ReadOnly = 0,
    DevNum = 1,
    Queues = 2,
    Zero = 3,
    Force = 4,
    Num = 5,
    Length = 6,
    Dim = 7,
    Static = 8,
}

fn isOpenACCSpecialToken(Kind: OpenACCSpecialTokenKind, Tok: Token) -> bool {
    if Tok.is(kw_static) && Kind == Static {
        return true;
    }
    if !Tok.is(identifier) {
        return false;
    }
    match Kind {
        ReadOnly => {
            return Tok.getIdentifierInfo().isStr("readonly");
        },
        DevNum => {
            return Tok.getIdentifierInfo().isStr("devnum");
        },
        Queues => {
            return Tok.getIdentifierInfo().isStr("queues");
        },
        Zero => {
            return Tok.getIdentifierInfo().isStr("zero");
        },
        Force => {
            return Tok.getIdentifierInfo().isStr("force");
        },
        Num => {
            return Tok.getIdentifierInfo().isStr("num");
        },
        Length => {
            return Tok.getIdentifierInfo().isStr("length");
        },
        Dim => {
            return Tok.getIdentifierInfo().isStr("dim");
        },
        Static => {
            return Tok.getIdentifierInfo().isStr("static");
        },
    }
    llvm_unreachable_internal("Unknown 'Kind' Passed", "clang\\lib\\Parse\\ParseOpenACC.cpp", 220);
}

fn isTokenIdentifierOrKeyword(P: *mut Parser, Tok: Token) -> bool {
    if Tok.is(identifier) {
        return true;
    }
    if !Tok.isAnnotation() && Tok.getIdentifierInfo() && Tok.getIdentifierInfo().isKeyword(P.getLangOpts()) {
        return true;
    }
    return false;
}

