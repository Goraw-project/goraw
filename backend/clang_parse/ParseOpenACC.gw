fn Parser::ParseOpenACCDirectiveDecl(self, AS: *mut AccessSpecifier, Attrs: *mut ParsedAttributes, TagType: TST, TagDecl: *mut Decl) -> DeclGroupPtrTy {
    assert!(self.Tok.is(annot_pragma_openacc), "expected OpenACC Start Token");
