    }
}

fn Parser::ParseOpenACCDirectiveStmt(self) -> i32 {
    assert!(self.Tok.is(annot_pragma_openacc), "expected OpenACC Start Token");
    let mut DirScope: ParsingOpenACCDirectiveRAII = ParsingOpenACCDirectiveRAII { P: *self, OldVal: true };
    let mut DirInfo: OpenACCDirectiveParseInfo = self.ParseOpenACCDirective();
    let mut AssocStmt: i32 = 0;
    if doesDirectiveHaveAssociatedStmt(DirInfo.DirKind) {
        let mut AssocStmtRAII: AssociatedStmtRAII = self.getActions().OpenACC();
        let mut DirScope: ParsingOpenACCDirectiveRAII = ParsingOpenACCDirectiveRAII { P: *self, OldVal: false };
        let mut scopeFlags: u32 = getOpenACCScopeFlags(DirInfo.DirKind);
        let mut ACCScope: ParseScope = ParseScope { self, scopeFlags, scopeFlags != 0, false };
        AssocStmt() = self.getActions().OpenACC();
    }
    return self.getActions().OpenACC()(DirInfo.DirKind, DirInfo.StartLoc, DirInfo.DirLoc, DirInfo.LParenLoc, DirInfo.MiscLoc, DirInfo(), DirInfo.AtomicKind, DirInfo.RParenLoc, DirInfo.EndLoc, DirInfo());
}

