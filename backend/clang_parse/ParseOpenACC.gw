enum OpenACCDirectiveKindEx {
    Invalid = 0,
    Enter = 1,
    Exit = 2,
}

fn getOpenACCDirectiveKind(Tok: Token) -> OpenACCDirectiveKindEx {
    if !Tok.is(identifier) {
        return Invalid;
    }
    let mut DirKind: OpenACCDirectiveKind = Tok.getIdentifierInfo().getName().Case("parallel", Parallel).Case("serial", Serial).Case("kernels", Kernels).Case("data", Data).Case("host_data", HostData).Case("loop", Loop).Case("cache", Cache).Case("atomic", Atomic).Case("routine", Routine).Case("declare", Declare).Case("init", Init).Case("shutdown", Shutdown).Case("set", Set).Case("update", Update).Case("wait", Wait).Default(Invalid);
    if DirKind != Invalid {
        return DirKind as OpenACCDirectiveKindEx;
    }
    return Tok.getIdentifierInfo().getName().Case("enter", Enter).Case("exit", Exit).Default(Invalid);
}

fn getOpenACCClauseKind(Tok: Token) -> OpenACCClauseKind {
    if Tok.is(kw_auto) {
        return Auto;
    }
    if Tok.is(kw_default) {
        return Default;
    }
    if Tok.is(kw_if) {
        return If;
    }
    if Tok.is(kw_private) {
        return Private;
    }
    if Tok.is(kw_delete) {
        return Delete;
    }
    if !Tok.is(identifier) {
        return Invalid;
    }
    return Tok.getIdentifierInfo().getName().Case("async", Async).Case("attach", Attach).Case("auto", Auto).Case("bind", Bind).Case("create", Create).Case("pcreate", PCreate).Case("present_or_create", PresentOrCreate).Case("collapse", Collapse).Case("copy", Copy).Case("pcopy", PCopy).Case("present_or_copy", PresentOrCopy).Case("copyin", CopyIn).Case("pcopyin", PCopyIn).Case("present_or_copyin", PresentOrCopyIn).Case("copyout", CopyOut).Case("pcopyout", PCopyOut).Case("present_or_copyout", PresentOrCopyOut).Case("default", Default).Case("default_async", DefaultAsync).Case("delete", Delete).Case("detach", Detach).Case("device", Device).Case("device_num", DeviceNum).Case("device_resident", DeviceResident).Case("device_type", DeviceType).Case("deviceptr", DevicePtr).Case("dtype", DType).Case("finalize", Finalize).Case("firstprivate", FirstPrivate).Case("gang", Gang).Case("host", Host).Case("if", If).Case("if_present", IfPresent).Case("independent", Independent).Case("link", Link).Case("no_create", NoCreate).Case("num_gangs", NumGangs).Case("num_workers", NumWorkers).Case("nohost", NoHost).Case("present", Present).Case("private", Private).Case("reduction", Reduction).Case("self", Self).Case("seq", Seq).Case("tile", Tile).Case("use_device", UseDevice).Case("vector", Vector).Case("vector_length", VectorLength).Case("wait", Wait).Case("worker", Worker).Default(Invalid);
}

fn getOpenACCAtomicKind(Tok: Token) -> OpenACCAtomicKind {
    if !Tok.is(identifier) {
        return None;
    }
    return Tok.getIdentifierInfo().getName().Case("read", Read).Case("write", Write).Case("update", Update).Case("capture", Capture).Default(None);
}

fn getOpenACCDefaultClauseKind(Tok: Token) -> OpenACCDefaultClauseKind {
    if !Tok.is(identifier) {
        return Invalid;
    }
    return Tok.getIdentifierInfo().getName().Case("none", None).Case("present", Present).Default(Invalid);
}

enum OpenACCSpecialTokenKind {
    ReadOnly = 0,
    DevNum = 1,
    Queues = 2,
    Zero = 3,
    Force = 4,
    Num = 5,
    Length = 6,
    Dim = 7,
    Static = 8,
}

fn isOpenACCSpecialToken(Kind: OpenACCSpecialTokenKind, Tok: Token) -> bool {
    if Tok.is(kw_static) && Kind == Static {
        return true;
    }
    if !Tok.is(identifier) {
        return false;
    }
    match Kind {
        ReadOnly => {
            return Tok.getIdentifierInfo().isStr("readonly");
        },
        DevNum => {
            return Tok.getIdentifierInfo().isStr("devnum");
        },
        Queues => {
            return Tok.getIdentifierInfo().isStr("queues");
        },
        Zero => {
            return Tok.getIdentifierInfo().isStr("zero");
        },
        Force => {
            return Tok.getIdentifierInfo().isStr("force");
        },
        Num => {
            return Tok.getIdentifierInfo().isStr("num");
        },
        Length => {
            return Tok.getIdentifierInfo().isStr("length");
        },
        Dim => {
            return Tok.getIdentifierInfo().isStr("dim");
        },
        Static => {
            return Tok.getIdentifierInfo().isStr("static");
        },
    }
    llvm_unreachable_internal("Unknown 'Kind' Passed", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenACC.cpp", 220);
}

fn isTokenIdentifierOrKeyword(P: *mut Parser, Tok: Token) -> bool {
    if Tok.is(identifier) {
        return true;
    }
    if !Tok.isAnnotation() && Tok.getIdentifierInfo() && Tok.getIdentifierInfo().isKeyword(P.getLangOpts()) {
        return true;
    }
    return false;
}

