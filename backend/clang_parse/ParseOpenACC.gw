    if DirInfo.LParenLoc.isInvalid() {
        if self.Tok.isNot(r_brace) && !self.isEofOrEom() {
            if AS == AS_none {
                if TagType == TST_unspecified {
                    let mut EmptyDeclSpecAttrs: ParsedAttributes = zeroed();
                    self.MaybeParseCXX11Attributes(Attrs, false);
                    let mut PDS: ParsingDeclSpec = *self;
                    Ptr() = self.ParseExternalDeclaration;
                }
            } else {
                Ptr() = self.ParseCXXClassMemberDeclarationWithPragmas;
            }
        }
    }
}

