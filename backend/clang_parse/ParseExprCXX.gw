}

unsafe fn Closure_10::call(self: *mut Closure_10) -> auto {
                    let mut DiagLoc: SourceLocation = SourceLocation {};
                    for Loc in (*self.EllipsisLocs)[..] {
                        if &mut (*self.Loc) != (*self.ExpectedEllipsisLoc) && (*self.Loc).isValid() {
                            DiagLoc = (*self.Loc);
                            break;
                        }
                    }
                    assert!(DiagLoc.isValid(), "no location for diagnostic");
                    let mut D: *mut *mut DiagnosticBuilder = self.Diag(DiagLoc, (*self.DiagID));
                    if (*self.DiagID) == err_lambda_capture_misplaced_ellipsis {
                        let mut ExpectedLoc: SourceLocation = if (*self.InitCapture) { (*self.Loc) } else { getLocForEndOfToken((*self.Loc), 0, self.PP.getSourceManager(), self.getLangOpts()) };
                        D << (*self.InitCapture) << CreateInsertion(ExpectedLoc, "...", false);
                    }
                    for Loc in (*self.EllipsisLocs)[..] {
                        if &mut (*self.Loc) != (*self.ExpectedEllipsisLoc) && (*self.Loc).isValid() {
                            D << CreateRemoval((*self.Loc));
                        }
                    }
                }

