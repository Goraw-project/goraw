        },
        kw_signed => {
            DS.SetTypeSpecSign(Signed, Loc, PrevSpec, DiagID);
        },
        kw_unsigned => {
            DS.SetTypeSpecSign(Unsigned, Loc, PrevSpec, DiagID);
        },
        kw_void => {
            DS.SetTypeSpecType(TST_void, Loc, PrevSpec, DiagID, Policy);
        },
        kw_auto => {
            DS.SetTypeSpecType(TST_auto, Loc, PrevSpec, DiagID, Policy);
        },
        kw_char => {
            DS.SetTypeSpecType(TST_char, Loc, PrevSpec, DiagID, Policy);
        },
        kw_int => {
            DS.SetTypeSpecType(TST_int, Loc, PrevSpec, DiagID, Policy);
        },
        kw___int128 => {
            DS.SetTypeSpecType(TST_int128, Loc, PrevSpec, DiagID, Policy);
        },
        kw___bf16 => {
            DS.SetTypeSpecType(TST_BFloat16, Loc, PrevSpec, DiagID, Policy);
        },
        kw_half => {
            DS.SetTypeSpecType(TST_half, Loc, PrevSpec, DiagID, Policy);
        },
        kw_float => {
            DS.SetTypeSpecType(TST_float, Loc, PrevSpec, DiagID, Policy);
        },
        kw_double => {
            DS.SetTypeSpecType(TST_double, Loc, PrevSpec, DiagID, Policy);
        },
        kw__Float16 => {
            DS.SetTypeSpecType(TST_float16, Loc, PrevSpec, DiagID, Policy);
        },
        kw___float128 => {
            DS.SetTypeSpecType(TST_float128, Loc, PrevSpec, DiagID, Policy);
        },
        kw___ibm128 => {
            DS.SetTypeSpecType(TST_ibm128, Loc, PrevSpec, DiagID, Policy);
        },
        kw_wchar_t => {
            DS.SetTypeSpecType(TST_wchar, Loc, PrevSpec, DiagID, Policy);
        },
        kw_char8_t => {
            DS.SetTypeSpecType(TST_char8, Loc, PrevSpec, DiagID, Policy);
        },
        kw_char16_t => {
            DS.SetTypeSpecType(TST_char16, Loc, PrevSpec, DiagID, Policy);
        },
        kw_char32_t => {
            DS.SetTypeSpecType(TST_char32, Loc, PrevSpec, DiagID, Policy);
        },
        kw_bool => {
            DS.SetTypeSpecType(TST_bool, Loc, PrevSpec, DiagID, Policy);
        },
        kw__Accum => {
            DS.SetTypeSpecType(TST_accum, Loc, PrevSpec, DiagID, Policy);
        },
        kw__Fract => {
            DS.SetTypeSpecType(TST_fract, Loc, PrevSpec, DiagID, Policy);
        },
        kw__Sat => {
            DS.SetTypeSpecSat(Loc, PrevSpec, DiagID);
        },
        kw_image1d_t => {
            DS.SetTypeSpecType(TST_image1d_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image1d_array_t => {
            DS.SetTypeSpecType(TST_image1d_array_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image1d_buffer_t => {
            DS.SetTypeSpecType(TST_image1d_buffer_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_t => {
            DS.SetTypeSpecType(TST_image2d_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_array_t => {
            DS.SetTypeSpecType(TST_image2d_array_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_depth_t => {
            DS.SetTypeSpecType(TST_image2d_depth_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_array_depth_t => {
            DS.SetTypeSpecType(TST_image2d_array_depth_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_msaa_t => {
            DS.SetTypeSpecType(TST_image2d_msaa_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_array_msaa_t => {
            DS.SetTypeSpecType(TST_image2d_array_msaa_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_msaa_depth_t => {
            DS.SetTypeSpecType(TST_image2d_msaa_depth_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_array_msaa_depth_t => {
            DS.SetTypeSpecType(TST_image2d_array_msaa_depth_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image3d_t => {
            DS.SetTypeSpecType(TST_image3d_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw___hlsl_resource_t => {
            DS.SetTypeSpecType(TST___hlsl_resource_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_int8_t4_packed => {
            DS.SetTypeSpecType(TST_int8_t4_packed, Loc, PrevSpec, DiagID, Policy);
        },
        kw_uint8_t4_packed => {
            DS.SetTypeSpecType(TST_uint8_t4_packed, Loc, PrevSpec, DiagID, Policy);
        },
        annot_decltype => {
            kw_decltype;
        },
        annot_pack_indexing_type => {
            DS.SetRangeEnd(self.ParsePackIndexingType(DS));
        },
        kw_typeof => {
            kw_typeof_unqual;
        },
    }
    self.ConsumeAnyToken(false);
    DS.SetRangeEnd(self.PrevTokLocation);
    DS.Finish(self.Actions, Policy);
}

fn Parser::ParseCXXTypeSpecifierSeq(self, DS: *mut DeclSpec, Context: DeclaratorContext) -> bool {
    self.ParseSpecifierQualifierList(DS, AS_none, self.getDeclSpecContextFromDeclaratorContext(Context));
    DS.Finish(self.Actions, self.Actions.getASTContext().getPrintingPolicy());
    return false;
}

fn Parser::ParseUnqualifiedIdTemplateId(self, SS: *mut CXXScopeSpec, ObjectType: ParsedType, ObjectHadErrors: bool, TemplateKWLoc: SourceLocation, Name: *mut IdentifierInfo, NameLoc: SourceLocation, EnteringContext: bool, Id: *mut UnqualifiedId, AssumeTemplateId: bool) -> bool {
    assert!(self.Tok.is(less), "Expected '<' to finish parsing a template-id");
    let mut Template: TemplateTy = zeroed();
    let mut TNK: TemplateNameKind = TNK_Non_template;
    match Id.getKind() {
        IK_Identifier => {
            IK_OperatorFunctionId;
        },
        IK_ConstructorName => {
            let mut TemplateName: UnqualifiedId = UnqualifiedId {};
            let mut MemberOfUnknownSpecialization: bool = false;
            TemplateName.setIdentifier(Name, NameLoc);
            TNK = self.Actions.isTemplateName(self.getCurScope(), SS, TemplateKWLoc.isValid(), TemplateName, EnteringContext, MemberOfUnknownSpecialization);
            if TNK == TNK_Non_template {
                return false;
            }
            break;
        },
        IK_DestructorName => {
            let mut TemplateName: UnqualifiedId = UnqualifiedId {};
            let mut MemberOfUnknownSpecialization: bool = false;
            TemplateName.setIdentifier(Name, NameLoc);
            if ObjectType() {
                TNK = self.Actions.ActOnTemplateName(self.getCurScope(), SS, TemplateKWLoc, TemplateName, EnteringContext, true);
            } else {
                TNK = self.Actions.isTemplateName(self.getCurScope(), SS, TemplateKWLoc.isValid(), TemplateName, EnteringContext, MemberOfUnknownSpecialization, false);
                if TNK == TNK_Non_template && operator!(Id()()) {
                     << Name << SS.getRange();
                }
            }
            break;
        },
        _ => {
            return false;
        },
    }
    let mut LAngleLoc: SourceLocation = SourceLocation {};
    let mut RAngleLoc: SourceLocation = SourceLocation {};
    let mut TemplateArgs: TemplateArgList = zeroed();
    if self.ParseTemplateIdAfterTemplateName(true, LAngleLoc, RAngleLoc) {
        return true;
    }
    if TNK == TNK_Non_template {
        return true;
    }
    if Id.getKind() == IK_Identifier || Id.getKind() == IK_OperatorFunctionId || Id.getKind() == IK_LiteralOperatorId {
        let mut TemplateII: *IdentifierInfo = if Id.getKind() == IK_Identifier { Id() } else { null };
        let mut OpKind: OverloadedOperatorKind = if Id.getKind() == IK_Identifier { OO_None } else { Id() };
        let mut TemplateId: *mut TemplateIdAnnotation = Create(TemplateKWLoc, Id.StartLocation, TemplateII, OpKind, TNK, LAngleLoc, RAngleLoc, false);
        Id.setTemplateId(TemplateId);
        return false;
    }
    let mut TemplateArgsPtr: ASTTemplateArgsPtr = zeroed();
    let mut Type: i32 = self.Actions(self.getCurScope(), None, SourceLocation {}, SS, TemplateKWLoc, Name, NameLoc, LAngleLoc, RAngleLoc, true);
    if Type()() {
        return true;
    }
    if Id.getKind() == IK_ConstructorName {
        Id.setConstructorName(NameLoc, RAngleLoc);
    } else {
        Id.setDestructorName(Id.StartLocation, RAngleLoc);
    }
    return false;
}

fn Parser::ParseUnqualifiedIdOperator(self, SS: *mut CXXScopeSpec, EnteringContext: bool, ObjectType: ParsedType, Result: *mut UnqualifiedId) -> bool {
    assert!(self.Tok.is(kw_operator), "Expected 'operator' keyword");
    let mut KeywordLoc: SourceLocation = self.ConsumeToken();
    let mut SymbolIdx: u32 = 0;
    let mut SymbolLocations: [3]SourceLocation = [3]SourceLocation {};
    let mut Op: OverloadedOperatorKind = OO_None;
    match self.Tok.getKind() {
        kw_new => {
            kw_delete;
        },
        plus => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        minus => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        star => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        slash => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        percent => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        caret => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        amp => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        pipe => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        tilde => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        exclaim => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        equal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        less => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        greater => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        plusequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        minusequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        starequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        slashequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        percentequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        caretequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        ampequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        pipeequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        lessless => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        greatergreater => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        lesslessequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        greatergreaterequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        equalequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        exclaimequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        lessequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        greaterequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        spaceship => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        ampamp => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        pipepipe => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        plusplus => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        minusminus => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        comma => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        arrowstar => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        arrow => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        kw_co_await => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        l_paren => {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
            T.consumeOpen();
            T.consumeClose();
            if T.getCloseLocation().isInvalid() {
                return true;
            }
            SymbolLocations[SymbolIdx += 1] = T.getOpenLocation();
            SymbolLocations[SymbolIdx += 1] = T.getCloseLocation();
            Op = OO_Call;
            break;
        },
        l_square => {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
            T.consumeOpen();
            T.consumeClose();
            if T.getCloseLocation().isInvalid() {
                return true;
            }
            SymbolLocations[SymbolIdx += 1] = T.getOpenLocation();
            SymbolLocations[SymbolIdx += 1] = T.getCloseLocation();
            Op = OO_Subscript;
            break;
        },
        code_completion => {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteOperatorName(self.getCurScope());
            return true;
        },
        lesslessless => {
            let mut TokLoc: SourceLocation = self.Tok.getLocation();
            let mut LessLessLength: u32 = getTokenPrefixLength(TokLoc, 2, self.PP.getSourceManager(), self.getLangOpts());
            let mut LessLessLoc: SourceLocation = self.PP.SplitToken(TokLoc, LessLessLength);
            let mut LessLess: Token = self.Tok;
            LessLess.setLocation(LessLessLoc);
            LessLess.setKind(lessless);
            LessLess.setLength(LessLessLength);
            let mut OldLength: u32 = self.Tok.getLength();
            let mut CachingTokens: bool = self.PP.IsPreviousCachedToken(self.Tok);
            self.Tok.setKind(less);
            self.Tok.setLength(OldLength - LessLessLength);
            self.Tok.setLocation(TokLoc.getLocWithOffset(LessLessLength));
            if CachingTokens {
                self.PP.ReplacePreviousCachedToken;
            }
            SymbolLocations[SymbolIdx += 1] = LessLessLoc;
            Op = OO_LessLess;
            break;
        },
        _ => {
            break;
        },
    }
    if Op != OO_None {
        Result.setOperatorFunctionId(KeywordLoc, Op, SymbolLocations);
        return false;
    }
    if self.getLangOpts() && self.isTokenStringLiteral() {
        let mut DiagLoc: SourceLocation = SourceLocation {};
        let mut DiagId: u32 = 0;
        let mut Toks: SmallVector<Token, 4> = zeroed();
        let mut TokLocs: SmallVector<SourceLocation, 4> = zeroed();
        while self.isTokenStringLiteral() {
            if !self.Tok.is(string_literal) && !DiagId {
                DiagLoc = self.Tok.getLocation();
            }
            Toks()(self.Tok);
            TokLocs()(self.ConsumeStringToken());
        }
        let mut Literal: StringLiteralParser = Toks();
        if Literal.hadError {
            return true;
        }
        let mut IsUDSuffix: bool = !Literal.getUDSuffix().is_empty();
        let mut II: *mut IdentifierInfo = null;
        let mut SuffixLoc: SourceLocation = SourceLocation {};
        if IsUDSuffix {
            II = &mut self.PP.getIdentifierTable().get(Literal.getUDSuffix());
            SuffixLoc = AdvanceToTokenCharacter([Literal.getUDSuffixToken()], Literal.getUDSuffixOffset(), self.PP.getSourceManager(), self.getLangOpts());
        } else if self.Tok.is(identifier) {
            II = self.Tok.getIdentifierInfo();
            SuffixLoc = self.ConsumeToken();
            TokLocs()(SuffixLoc);
        } else {
             << identifier;
            return true;
        }
        if !Literal.GetString().is_empty() || Literal.Pascal {
            DiagLoc = ();
        }
        if DiagId {
            let mut Str: str = zeroed();
            Str() += "\"\"";
            Str() += II.getName();
            self.Diag(DiagLoc, DiagId) << CreateReplacement();
        }
        Result.setLiteralOperatorId(II, KeywordLoc, SuffixLoc);
        return self.Actions.checkLiteralOperatorId(SS, Result, IsUDSuffix);
    }
    let mut DS: DeclSpec = zeroed();
    if self.ParseCXXTypeSpecifierSeq(DS, ConversionId) {
        return true;
    }
    let mut D: Declarator = Declarator { DS, none(), ConversionId };
    self.ParseDeclaratorInternal(D, null);
    let mut Ty: i32 = self.Actions(D);
    if Ty()() {
        return true;
    }
    Result.setConversionFunctionId(KeywordLoc, D.getSourceRange().getEnd());
    return false;
}

fn Parser::ParseUnqualifiedId(self, SS: *mut CXXScopeSpec, ObjectType: ParsedType, ObjectHadErrors: bool, EnteringContext: bool, AllowDestructorName: bool, AllowConstructorName: bool, AllowDeductionGuide: bool, TemplateKWLoc: *mut SourceLocation, Result: *mut UnqualifiedId) -> bool {
    if TemplateKWLoc {
        *TemplateKWLoc = SourceLocation {};
    }
    let mut TemplateSpecified: bool = false;
    if self.Tok.is(kw_template) {
        if TemplateKWLoc && (ObjectType() || SS.isSet()) {
            TemplateSpecified = true;
            *TemplateKWLoc = self.ConsumeToken();
        } else {
            let mut TemplateLoc: SourceLocation = self.ConsumeToken();
             << CreateRemoval(TemplateLoc);
        }
    }
    if self.Tok.is(identifier) {
        self.Tok.getIdentifierInfo();
        let mut IdLoc: SourceLocation = self.ConsumeToken();
        if operator!(self.getLangOpts()) {
            Result.setIdentifier(Id, IdLoc);
            return false;
        }
        let mut TemplateName: ParsedTemplateTy = zeroed();
        if AllowConstructorName && self.Actions.isCurrentClassName(*Id, self.getCurScope(), &mut SS) {
            let mut Ty: ParsedType = zeroed();
            if operator!() {
                return true;
            }
            Result.setConstructorName(IdLoc, IdLoc);
        } else if self.getLangOpts() && AllowDeductionGuide && SS.isEmpty() && self.Actions.isDeductionGuideName(self.getCurScope(), *Id, IdLoc, SS, operator&()) {
            Result.setDeductionGuideName(IdLoc);
        } else {
            Result.setIdentifier(Id, IdLoc);
        }
        let mut Template: TemplateTy = zeroed();
        if self.Tok.is(less) {
            return self.ParseUnqualifiedIdTemplateId(SS, ObjectHadErrors, if TemplateKWLoc { *TemplateKWLoc } else { SourceLocation {} }, Id, IdLoc, EnteringContext, Result, TemplateSpecified);
        }
        if TemplateSpecified {
            let mut TNK: TemplateNameKind = self.Actions.ActOnTemplateName(self.getCurScope(), SS, *TemplateKWLoc, Result, EnteringContext, true);
            if TNK == TNK_Non_template {
                return true;
            }
            if (TNK == TNK_Function_template || TNK == TNK_Dependent_template_name || TNK == TNK_Var_template) && !self.Tok.is(less) {
                
            }
        }
        return false;
    }
    if self.Tok.is(annot_template_id) {
        let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
        if TemplateId.isInvalid() {
            self.ConsumeAnnotationToken();
            return true;
        }
        if AllowConstructorName && TemplateId.Name && self.Actions.isCurrentClassName(*TemplateId.Name, self.getCurScope(), &mut SS) {
            if SS.isSet() {
                 << TemplateId.Name << CreateRemoval(SourceRange { B: TemplateId.LAngleLoc, E: TemplateId.RAngleLoc });
                let mut Ty: ParsedType = zeroed();
                if operator!() {
                    return true;
                }
                Result.setConstructorName(TemplateId.TemplateNameLoc, TemplateId.RAngleLoc);
                self.ConsumeAnnotationToken();
                return false;
            }
            Result.setConstructorTemplateId(TemplateId);
            self.ConsumeAnnotationToken();
            return false;
        }
        Result.setTemplateId(TemplateId);
        let mut TemplateLoc: SourceLocation = TemplateId.TemplateKWLoc;
        if TemplateLoc.isValid() {
            if TemplateKWLoc && (ObjectType() || SS.isSet()) {
                *TemplateKWLoc = TemplateLoc;
            } else {
                << CreateRemoval(TemplateLoc);
            }
        }
        self.ConsumeAnnotationToken();
        return false;
    }
    if self.Tok.is(kw_operator) {
        if self.ParseUnqualifiedIdOperator(SS, EnteringContext, Result) {
            return true;
        }
        let mut Template: TemplateTy = zeroed();
        if (Result.getKind() == IK_OperatorFunctionId || Result.getKind() == IK_LiteralOperatorId) && self.Tok.is(less) {
            return self.ParseUnqualifiedIdTemplateId(SS, ObjectHadErrors, if TemplateKWLoc { *TemplateKWLoc } else { SourceLocation {} }, null, SourceLocation {}, EnteringContext, Result, TemplateSpecified);
        } else if TemplateSpecified && self.Actions.ActOnTemplateName(self.getCurScope(), SS, *TemplateKWLoc, Result, EnteringContext, true) == TNK_Non_template {
            return true;
        }
        return false;
    }
    if self.getLangOpts() && (AllowDestructorName || SS.isSet()) && self.Tok.is(tilde) {
        let mut TildeLoc: SourceLocation = self.ConsumeToken();
        if TemplateSpecified {
             << self.Tok.getLocation();
            return true;
        }
        if SS.isEmpty() && self.Tok.is(kw_decltype) {
            let mut DS: DeclSpec = zeroed();
            let mut EndLoc: SourceLocation = self.ParseDecltypeSpecifier(DS);
            if  {
                Result.setDestructorName(TildeLoc, EndLoc);
                return false;
            }
            return true;
        }
        if self.Tok.isNot(identifier) {
            return true;
        }
        let mut DeclScopeObj: DeclaratorScopeObj = DeclaratorScopeObj { *self, SS };
        if self.NextToken().is(coloncolon) {
            let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: false };
            if SS.isSet() {
                self.AnnotateScopeToken(SS, true);
                SS.clear();
            }
            if (SS, ObjectHadErrors, EnteringContext) {
                return true;
            }
            if SS.isNotEmpty() {
                ObjectType() = null;
            }
            if self.Tok.isNot(identifier) || self.NextToken().is(coloncolon) || !SS.isSet() {
                return true;
            }
             << CreateRemoval(TildeLoc) << CreateInsertion(self.Tok.getLocation(), "~", false);
            if self.Actions.ShouldEnterDeclaratorScope(self.getCurScope(), SS) {
                DeclScopeObj.EnterDeclaratorScope();
            }
        }
        let mut ClassName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut ClassNameLoc: SourceLocation = self.ConsumeToken();
        if self.Tok.is(less) {
            Result.setDestructorName;
            return self.ParseUnqualifiedIdTemplateId(SS, ObjectHadErrors, if TemplateKWLoc { *TemplateKWLoc } else { SourceLocation {} }, ClassName, ClassNameLoc, EnteringContext, Result, TemplateSpecified);
        }
        let mut Ty: ParsedType = zeroed();
        if operator!() {
            return true;
        }
        Result.setDestructorName(TildeLoc, ClassNameLoc);
        return false;
    }
    match self.Tok.getKind() {
        _ => {
            << self.getLangOpts();
        },
    }
}

fn Parser::ParseCXXNewExpression(self, UseGlobal: bool, Start: SourceLocation) -> i32 {
    assert!(self.Tok.is(kw_new), "expected 'new' token");
    self.ConsumeToken();
    let mut PlacementArgs: ExprVector = zeroed();
    let mut PlacementLParen: SourceLocation = SourceLocation {};
    let mut PlacementRParen: SourceLocation = SourceLocation {};
    let mut TypeIdParens: SourceRange = SourceRange {};
    let mut DS: DeclSpec = zeroed();
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), CXXNew };
    if self.Tok.is(l_paren) {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        PlacementLParen = T.getOpenLocation();
        if self.ParseExpressionListOrTypeId(DeclaratorInfo) {
            self.SkipUntil(semi, StopAtSemi | StopBeforeMatch);
        }
        T.consumeClose();
        PlacementRParen = T.getCloseLocation();
        if PlacementRParen.isInvalid() {
            self.SkipUntil(semi, StopAtSemi | StopBeforeMatch);
        }
        if PlacementArgs()() {
            TypeIdParens = T.getRange();
            PlacementLParen = PlacementRParen = SourceLocation {};
        } else {
            if self.Tok.is(l_paren) {
                let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
                T.consumeOpen();
                self.MaybeParseGNUAttributes(DeclaratorInfo, null);
                self.ParseSpecifierQualifierList(DS, AS_none, DSC_normal);
                DeclaratorInfo.SetSourceRange(DS.getSourceRange());
                self.ParseDeclarator(DeclaratorInfo);
                T.consumeClose();
                TypeIdParens = T.getRange();
            } else {
                self.MaybeParseGNUAttributes(DeclaratorInfo, null);
                if self.ParseCXXTypeSpecifierSeq(DS, TypeName) {
                    DeclaratorInfo.setInvalidType(true);
                } else {
                    DeclaratorInfo.SetSourceRange(DS.getSourceRange());
