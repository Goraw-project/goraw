fn Parser::ParseTypeTrait(self) -> ExprResult {
    let mut Kind: TokenKind = self.Tok.getKind();
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if Parens.expectAndConsume(err_expected, "", unknown) {
        return ExprError();
    }
    let mut Args: SmallVector<ParsedType, 2> = SmallVector<ParsedType, 2> {};
    while true {
        {
        let mut Ty: TypeResult = self.ParseTypeName(null, if self.getLangOpts().CPlusPlus { TemplateTypeArg } else { TypeName }, AS_none, null, null);
        if Ty.isInvalid() {
            Parens.skipToEnd();
            return ExprError();
        }
        if self.Tok.is(ellipsis) {
            Ty = self.Actions.ActOnPackExpansion(Ty.get(), self.ConsumeToken());
            if Ty.isInvalid() {
                Parens.skipToEnd();
                return ExprError();
            }
        }
        Args.push(Ty.get());
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    if Parens.consumeClose() {
        return ExprError();
    }
    let mut EndLoc: SourceLocation = Parens.getCloseLocation();
    return self.Actions.ActOnTypeTrait(TypeTraitFromTokKind(Kind), Loc, Args, EndLoc);
}

fn Parser::ParseArrayTypeTrait(self) -> ExprResult {
    let mut ATT: ArrayTypeTrait = ArrayTypeTraitFromTokKind(self.Tok.getKind());
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected, "", unknown) {
        return ExprError();
    }
    let mut Ty: TypeResult = self.ParseTypeName(null, TemplateTypeArg, AS_none, null, null);
    if Ty.isInvalid() {
        self.SkipUntil(comma, StopAtSemi);
        self.SkipUntil(r_paren, StopAtSemi);
        return ExprError();
    }
    match ATT {
        ATT_ArrayRank => {
            T.consumeClose();
            return self.Actions.ActOnArrayTypeTrait(ATT, Loc, Ty.get(), null, T.getCloseLocation());
        },
        ATT_ArrayExtent => {
            if self.ExpectAndConsume(comma, err_expected, "") {
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            let mut DimExpr: ExprResult = self.ParseExpression(AllowNonTypes);
            T.consumeClose();
            if DimExpr.isInvalid() {
                return ExprError();
            }
            return self.Actions.ActOnArrayTypeTrait(ATT, Loc, Ty.get(), DimExpr.get(), T.getCloseLocation());
        },
    }
    llvm_unreachable_internal("Invalid ArrayTypeTrait!", "P:/Goraw/llvm-project/clang/lib/Parse/ParseExprCXX.cpp", 3610);
}

fn Parser::ParseExpressionTrait(self) -> ExprResult {
    let mut ET: ExpressionTrait = ExpressionTraitFromTokKind(self.Tok.getKind());
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected, "", unknown) {
        return ExprError();
    }
    let mut Expr: ExprResult = self.ParseExpression(AllowNonTypes);
    T.consumeClose();
    return self.Actions.ActOnExpressionTrait(ET, Loc, Expr.get(), T.getCloseLocation());
}

fn Parser::ParseCXXAmbiguousParenExpression(self, ExprType: *mut ParenParseOption, CastTy: *mut ParsedType, Tracker: *mut BalancedDelimiterTracker, ColonProt: *mut ColonProtectionRAIIObject) -> ExprResult {
    assert!(self.getLangOpts().CPlusPlus, "Should only be called for C++!");
    assert!(ExprType == CastExpr, "Compound literals are not ambiguous!");
    assert!(self.isTypeIdInParens(), "Not a type-id!");
    let mut Result: ExprResult = true;
    CastTy = null;
    let mut ParseAs: ParenParseOption = zeroed();
    let mut Toks: CachedTokens = CachedTokens {};
    if !self.ConsumeAndStoreUntil(r_paren, Toks, true, true) {
        Tracker.consumeClose();
        return ExprError();
    }
    if self.Tok.is(l_brace) {
        ParseAs = CompoundLiteral;
    } else {
        let mut NotCastExpr: bool = false;
        if self.Tok.is(l_paren) && self.NextToken().is(r_paren) {
            NotCastExpr = true;
        } else {
            ColonProt.restore();
            Result = self.ParseCastExpression(AnyCastExpr, false, NotCastExpr, AllowTypes, false, null);
        }
        ParseAs = if NotCastExpr { SimpleExpr } else { CastExpr };
    }
    let mut AttrEnd: Token = Token {};
    AttrEnd.startToken();
    AttrEnd.setKind(eof);
    AttrEnd.setLocation(self.Tok.getLocation());
    AttrEnd.setEofData(Toks.ptr);
    Toks.push(AttrEnd);
    Toks.push(self.Tok);
    self.PP.EnterTokenStream(Toks, true, true);
    self.ConsumeAnyToken(false);
    if ParseAs >= CompoundLiteral {
        let mut DS: DeclSpec = self.AttrFactory;
        let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
        {
            let mut InnerColonProtection: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
            self.ParseSpecifierQualifierList(DS, AS_none, DSC_normal);
            self.ParseDeclarator(DeclaratorInfo);
        }
        Tracker.consumeClose();
        ColonProt.restore();
        assert!(self.Tok.is(eof) && self.Tok.getEofData() == AttrEnd.getEofData();
        self.ConsumeAnyToken(false);
        if ParseAs == CompoundLiteral {
            ExprType = CompoundLiteral;
            if DeclaratorInfo.isInvalidType() {
                return ExprError();
            }
            let mut Ty: TypeResult = self.Actions.ActOnTypeName(DeclaratorInfo);
            return self.ParseCompoundLiteralExpression(Ty.get(), Tracker.getOpenLocation(), Tracker.getCloseLocation());
        }
        assert!(ParseAs == CastExpr);
        if DeclaratorInfo.isInvalidType() {
            return ExprError();
        }
        if !Result.isInvalid() {
            Result = self.Actions.ActOnCastExpr(self.getCurScope(), Tracker.getOpenLocation(), DeclaratorInfo, CastTy, Tracker.getCloseLocation(), Result.get());
        }
        return Result;
    }
    assert!(ParseAs == SimpleExpr);
    ExprType = SimpleExpr;
    Result = self.ParseExpression(AllowNonTypes);
    if !Result.isInvalid() && self.Tok.is(r_paren) {
        Result = self.Actions.ActOnParenExpr(Tracker.getOpenLocation(), self.Tok.getLocation(), Result.get());
    }
    if Result.isInvalid() {
        while self.Tok.isNot(eof) {
            self.ConsumeAnyToken(false);
        }
        assert!(self.Tok.getEofData() == AttrEnd.getEofData();
        self.ConsumeAnyToken(false);
        return ExprError();
    }
    Tracker.consumeClose();
    assert!(self.Tok.is(eof) && self.Tok.getEofData() == AttrEnd.getEofData();
    self.ConsumeAnyToken(false);
    return Result;
}

fn Parser::ParseBuiltinBitCast(self) -> ExprResult {
    let mut KWLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected_lparen_after, "__builtin_bit_cast", unknown) {
        return ExprError();
    }
    let mut DS: DeclSpec = self.AttrFactory;
    self.ParseSpecifierQualifierList(DS, AS_none, DSC_normal);
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
    self.ParseDeclarator(DeclaratorInfo);
    if self.ExpectAndConsume(comma, err_expected, "") {
        self.Diag(self.Tok.getLocation(), err_expected) << comma;
        self.SkipUntil(r_paren, StopAtSemi);
        return ExprError();
    }
    let mut Operand: ExprResult = self.ParseExpression(AllowNonTypes);
    if T.consumeClose() {
        return ExprError();
    }
    if Operand.isInvalid() || DeclaratorInfo.isInvalidType() {
        return ExprError();
    }
    return self.Actions.ActOnBuiltinBitCastExpr(KWLoc, DeclaratorInfo, Operand, T.getCloseLocation());
}

