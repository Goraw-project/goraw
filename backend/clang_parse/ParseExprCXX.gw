fn Parser::tryParseCXXIdExpression(self, SS: *mut CXXScopeSpec, isAddressOfOperand: bool) -> i32 {
    let mut E: i32 = 0;
    match self.Tok.getKind() {
        annot_non_type => {
            let mut ND: *mut NamedDecl = getNonTypeAnnotation(self.Tok);
            let mut Loc: SourceLocation = self.ConsumeAnnotationToken();
            E() = self.Actions(self.getCurScope(), SS, ND, Loc, self.Tok);
            break;
        },
        annot_non_type_dependent => {
            let mut II: *mut IdentifierInfo = getIdentifierAnnotation(self.Tok);
            let mut Loc: SourceLocation = self.ConsumeAnnotationToken();
            if isAddressOfOperand && self.isPostfixExpressionSuffixStart() {
                isAddressOfOperand = false;
            }
            E() = self.Actions(SS, II, Loc, isAddressOfOperand);
            break;
        },
        annot_non_type_undeclared => {
            assert!(SS.isEmpty(), "undeclared non-type annotation should be unqualified");
            let mut II: *mut IdentifierInfo = getIdentifierAnnotation(self.Tok);
            let mut Loc: SourceLocation = self.ConsumeAnnotationToken();
            E() = self.Actions(II, Loc);
            break;
        },
        _ => {
            let mut TemplateKWLoc: SourceLocation = SourceLocation {};
        },
    }
    return ;
}

