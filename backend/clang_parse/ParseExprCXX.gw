    }
    if !self.Tok.is(identifier) {}
    if self.GetLookAheadToken(1).is(ellipsis) && self.GetLookAheadToken(2).is(l_square) {
        let mut DS: DeclSpec = zeroed();
        self.ParsePackIndexingType(DS);
        return self.Actions(self.getCurScope(), Base, OpLoc, OpKind, TildeLoc, DS);
    }
    let mut SecondTypeName: UnqualifiedId = UnqualifiedId {};
    let mut Name: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut NameLoc: SourceLocation = self.ConsumeToken();
    SecondTypeName.setIdentifier(Name, NameLoc);
    return self.Actions(self.getCurScope(), Base, OpLoc, OpKind, SS, FirstTypeName, CCLoc, TildeLoc, SecondTypeName);
}

