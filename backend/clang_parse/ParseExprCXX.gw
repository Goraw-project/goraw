        DS.SetConstexprSpec(Constexpr, ConstexprLoc, PrevSpec, DiagID);
        assert!(PrevSpec == null && DiagID == 0, "Constexpr cannot have been set previously!");
    }
}

fn addConstevalToLambdaDeclSpecifier(P: *mut Parser, ConstevalLoc: SourceLocation, DS: *mut DeclSpec) {
    if ConstevalLoc.isValid() {
        P;
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        DS.SetConstexprSpec(Consteval, ConstevalLoc, PrevSpec, DiagID);
        if DiagID != 0 {
