fn SelectDigraphErrorMessage(Kind: TokenKind) -> i32 {
    match Kind {
        unknown => {
            return 0;
        },
        kw_addrspace_cast => {
            return 1;
        },
        kw_const_cast => {
            return 2;
        },
        kw_dynamic_cast => {
            return 3;
        },
        kw_reinterpret_cast => {
            return 4;
        },
        kw_static_cast => {
            return 5;
        },
        _ => {
            llvm_unreachable_internal("Unknown type for digraph error message.", "clang\\lib\\Parse\\ParseExprCXX.cpp", 45);
        },
    }
}

fn Parser::areTokensAdjacent(self, First: *Token, Second: *Token) -> bool {
    let mut SM: *mut SourceManager = self.PP.getSourceManager();
    let mut FirstLoc: SourceLocation = SM.getSpellingLoc(First.getLocation());
    let mut FirstEnd: SourceLocation = FirstLoc.getLocWithOffset(First.getLength());
    return FirstEnd == SM.getSpellingLoc(Second.getLocation());
}

fn FixDigraph(P: *mut Parser, PP: *mut Preprocessor, DigraphToken: *mut Token, ColonToken: *mut Token, Kind: TokenKind, AtDigraph: bool) {
    if !AtDigraph {
        PP.Lex(DigraphToken);
    }
    PP.Lex(ColonToken);
    let mut Range: SourceRange = SourceRange {};
    Range.setBegin(DigraphToken.getLocation());
    Range.setEnd(ColonToken.getLocation());
    P << SelectDigraphErrorMessage(Kind) << CreateReplacement(Range, "< ::");
    ColonToken.setKind(coloncolon);
    ColonToken.setLocation(ColonToken.getLocation().getLocWithOffset(-1));
    ColonToken.setLength(2);
    DigraphToken.setKind(less);
    DigraphToken.setLength(1);
    PP.EnterToken(ColonToken, true);
    if !AtDigraph {
        PP.EnterToken(DigraphToken, true);
    }
}

fn Parser::CheckForTemplateAndDigraph(self, Next: *mut Token, ObjectType: ParsedType, EnteringContext: bool, II: *mut IdentifierInfo, SS: *mut CXXScopeSpec) {
    if !Next.is(l_square) || Next.getLength() != 2 {
        return;
    }
    let mut SecondToken: Token = self.GetLookAheadToken(2);
    if !SecondToken.is(colon) || !self.areTokensAdjacent(Next, SecondToken) {
        return;
    }
    let mut Template: TemplateTy = zeroed();
    let mut TemplateName: UnqualifiedId = UnqualifiedId {};
    TemplateName.setIdentifier(&mut II, self.Tok.getLocation());
    let mut MemberOfUnknownSpecialization: bool = false;
    if operator!(self.Actions.isTemplateName(self.getCurScope(), SS, false, TemplateName, EnteringContext, MemberOfUnknownSpecialization)) {
        return;
    }
    FixDigraph(*self, self.PP, Next, SecondToken, unknown, false);
}

fn Parser::ParseOptionalCXXScopeSpecifier(self, SS: *mut CXXScopeSpec, ObjectType: ParsedType, ObjectHadErrors: bool, EnteringContext: bool, MayBePseudoDestructor: *mut bool, IsTypename: bool, LastII: **mut IdentifierInfo, OnlyNamespace: bool, InUsingDeclaration: bool, Disambiguation: bool, IsAddressOfOperand: bool, IsInDeclarationContext: bool) -> bool {
