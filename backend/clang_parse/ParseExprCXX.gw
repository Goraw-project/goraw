        let mut DiagID: u32 = 0;
        DS.SetStorageClassSpec(P.getActions(), SCS_static, StaticLoc, PrevSpec, DiagID, P.getActions().getASTContext().getPrintingPolicy());
        assert!(PrevSpec == null && DiagID == 0, "Static cannot have been set previously!");
    }
}

fn addConstexprToLambdaDeclSpecifier(P: *mut Parser, ConstexprLoc: SourceLocation, DS: *mut DeclSpec) {
    if ConstexprLoc.isValid() {
        P;
