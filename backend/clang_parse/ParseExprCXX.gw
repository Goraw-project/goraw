fn DiagnoseStaticSpecifierRestrictions(P: *mut Parser, StaticLoc: SourceLocation, MutableLoc: SourceLocation, Intro: *LambdaIntroducer) {
    if StaticLoc.isInvalid() {
        return;
    }
    if MutableLoc.isValid() {
        P;
    }
    if Intro.hasLambdaCapture() {
        P;
    }
}

fn Parser::isLambdaSpecifier(self) -> bool {
    return self.Tok || self.Tok.isRegularKeywordAttribute() || (self.Tok.is(l_square) && self.NextToken().is(l_square));
}

