fn Parser::ParseCXXCasts(self) -> i32 {
    let mut Kind: TokenKind = self.Tok.getKind();
    let mut CastName: *u8 = null;
    match Kind {
        _ => {
            llvm_unreachable_internal("Unknown C++ cast!", "clang\\lib\\Parse\\ParseExprCXX.cpp", 1503);
        },
        kw_addrspace_cast => {
            CastName = "addrspace_cast";
        },
        kw_const_cast => {
            CastName = "const_cast";
        },
        kw_dynamic_cast => {
            CastName = "dynamic_cast";
        },
        kw_reinterpret_cast => {
            CastName = "reinterpret_cast";
        },
        kw_static_cast => {
            CastName = "static_cast";
        },
    }
    let mut OpLoc: SourceLocation = self.ConsumeToken();
    let mut LAngleBracketLoc: SourceLocation = self.Tok.getLocation();
    if self.Tok.is(l_square) && self.Tok.getLength() == 2 {
        let mut Next: Token = self.NextToken();
        if Next.is(colon) && self.areTokensAdjacent(self.Tok, Next) {
            FixDigraph(*self, self.PP, self.Tok, Next, Kind, true);
        }
    }
    let mut DS: DeclSpec = zeroed();
    self.ParseSpecifierQualifierList(DS, AS_none, DSC_type_specifier);
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
    self.ParseDeclarator(DeclaratorInfo);
    let mut RAngleBracketLoc: SourceLocation = self.Tok.getLocation();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    let mut Result: i32 = 0;
    T.consumeClose();
    if operator!() && !DeclaratorInfo.isInvalidType() {
        Result() = self.Actions(OpLoc, Kind, LAngleBracketLoc, DeclaratorInfo, RAngleBracketLoc, T.getOpenLocation(), T.getCloseLocation());
    }
    return ;
}

