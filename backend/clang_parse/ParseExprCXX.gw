        }
        let mut LocEnd: SourceLocation = self.PrevTokLocation;
        Intro()(Kind, Loc, Id, EllipsisLoc, InitKind, SourceRange { B: LocStart, E: LocEnd });
    }
    T.consumeClose();
    Intro.Range.setEnd(T.getCloseLocation());
    return false;
}

fn tryConsumeLambdaSpecifierToken(P: *mut Parser, MutableLoc: *mut SourceLocation, StaticLoc: *mut SourceLocation, ConstexprLoc: *mut SourceLocation, ConstevalLoc: *mut SourceLocation, DeclEndLoc: *mut SourceLocation) {
    assert!(MutableLoc.isInvalid();
    assert!(StaticLoc.isInvalid();
    assert!(ConstexprLoc.isInvalid();
    assert!(ConstevalLoc.isInvalid();
    let mut ConsumeLocation: Closure_12 = Closure_12 { P: &mut P, DeclEndLoc: &mut DeclEndLoc };
    while true {
        match P.getCurToken().getKind() {
            kw_mutable => {
                ConsumeLocation.call(MutableLoc, 0);
            },
            kw_static => {
                ConsumeLocation.call(StaticLoc, 1);
            },
            kw_constexpr => {
                ConsumeLocation.call(ConstexprLoc, 2);
            },
            kw_consteval => {
                ConsumeLocation.call(ConstevalLoc, 3);
            },
            _ => {
                return;
            },
        }
    }
}

fn addStaticToLambdaDeclSpecifier(P: *mut Parser, StaticLoc: SourceLocation, DS: *mut DeclSpec) {
    if StaticLoc.isValid() {
        P;
