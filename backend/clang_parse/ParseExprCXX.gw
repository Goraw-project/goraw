fn SelectDigraphErrorMessage(Kind: TokenKind) -> i32 {
    match Kind {
        unknown => {
            return 0;
        },
        kw_addrspace_cast => {
            return 1;
        },
        kw_const_cast => {
            return 2;
        },
        kw_dynamic_cast => {
            return 3;
        },
        kw_reinterpret_cast => {
            return 4;
        },
        kw_static_cast => {
            return 5;
        },
        _ => {
            llvm_unreachable_internal("Unknown type for digraph error message.", "P:/Goraw/llvm-project/clang/lib/Parse/ParseExprCXX.cpp", 45);
        },
    }
}

fn Parser::areTokensAdjacent(self, First: *Token, Second: *Token) -> bool {
    let mut SM: *mut SourceManager = self.PP.getSourceManager();
    let mut FirstLoc: SourceLocation = SM.getSpellingLoc(First.getLocation());
    let mut FirstEnd: SourceLocation = FirstLoc.getLocWithOffset(First.getLength());
    return FirstEnd == SM.getSpellingLoc(Second.getLocation());
}

fn FixDigraph(P: *mut Parser, PP: *mut Preprocessor, DigraphToken: *mut Token, ColonToken: *mut Token, Kind: TokenKind, AtDigraph: bool) {
    if !AtDigraph {
        PP.Lex(DigraphToken);
    }
    PP.Lex(ColonToken);
    let mut Range: SourceRange = SourceRange {};
    Range.setBegin(DigraphToken.getLocation());
    Range.setEnd(ColonToken.getLocation());
    P.Diag(DigraphToken.getLocation(), err_missing_whitespace_digraph) << SelectDigraphErrorMessage(Kind) << CreateReplacement(Range, "< ::");
    ColonToken.setKind(coloncolon);
    ColonToken.setLocation(ColonToken.getLocation().getLocWithOffset(-1));
    ColonToken.setLength(2);
    DigraphToken.setKind(less);
    DigraphToken.setLength(1);
    PP.EnterToken(ColonToken, true);
    if !AtDigraph {
        PP.EnterToken(DigraphToken, true);
    }
}

fn Parser::CheckForTemplateAndDigraph(self, Next: *mut Token, ObjectType: ParsedType, EnteringContext: bool, II: *mut IdentifierInfo, SS: *mut CXXScopeSpec) {
    if !Next.is(l_square) || Next.getLength() != 2 {
        return;
    }
    let mut SecondToken: Token = self.GetLookAheadToken(2);
    if !SecondToken.is(colon) || !self.areTokensAdjacent(Next, SecondToken) {
        return;
    }
    let mut Template: TemplateTy = null;
    let mut TemplateName: UnqualifiedId = UnqualifiedId {};
    TemplateName.setIdentifier(&mut II, self.Tok.getLocation());
    let mut MemberOfUnknownSpecialization: bool = false;
    if !self.Actions.isTemplateName(self.getCurScope(), SS, false, TemplateName, ObjectType, EnteringContext, Template, MemberOfUnknownSpecialization, true) {
        return;
    }
    FixDigraph(*self, self.PP, Next, SecondToken, unknown, false);
}

fn Parser::ParseOptionalCXXScopeSpecifier(self, SS: *mut CXXScopeSpec, ObjectType: ParsedType, ObjectHadErrors: bool, EnteringContext: bool, MayBePseudoDestructor: *mut bool, IsTypename: bool, LastII: **mut IdentifierInfo, OnlyNamespace: bool, InUsingDeclaration: bool, Disambiguation: bool, IsAddressOfOperand: bool, IsInDeclarationContext: bool) -> bool {
    assert!(self.getLangOpts().CPlusPlus, "Call sites of this function should be guarded by checking for C++");
    if self.Tok.is(annot_cxxscope) {
        assert!(!LastII, "want last identifier but have already annotated scope");
        assert!(!MayBePseudoDestructor, "unexpected annot_cxxscope");
        self.Actions.RestoreNestedNameSpecifierAnnotation(self.Tok.getAnnotationValue(), self.Tok.getAnnotationRange(), SS);
        self.ConsumeAnnotationToken();
        return false;
    }
    let mut CheckForDestructor: bool = false;
    if MayBePseudoDestructor && *MayBePseudoDestructor {
        CheckForDestructor = true;
        *MayBePseudoDestructor = false;
    }
    if LastII {
        *LastII = null;
    }
    let mut HasScopeSpecifier: bool = false;
    if self.Tok.is(coloncolon) {
        let mut NextKind: TokenKind = self.NextToken().getKind();
        if NextKind == kw_new || NextKind == kw_delete {
            return false;
        }
        if NextKind == l_brace {
            self.Diag(self.ConsumeToken(), err_expected) << identifier;
        } else {
            if self.Actions.ActOnCXXGlobalScopeSpecifier(self.ConsumeToken(), SS) {
                return true;
            }
            HasScopeSpecifier = true;
        }
    }
    if !HasScopeSpecifier && self.Tok.is(kw___super) {
        let mut SuperLoc: SourceLocation = self.ConsumeToken();
        if !self.Tok.is(coloncolon) {
            self.Diag(self.Tok.getLocation(), err_expected_coloncolon_after_super);
            return true;
        }
        return self.Actions.ActOnSuperScopeSpecifier(SuperLoc, self.ConsumeToken(), SS);
    }
    if !HasScopeSpecifier && self.Tok.isOneOf(kw_decltype, annot_decltype) {
        let mut DS: DeclSpec = self.AttrFactory;
        let mut DeclLoc: SourceLocation = self.Tok.getLocation();
        let mut EndLoc: SourceLocation = self.ParseDecltypeSpecifier(DS);
        let mut CCLoc: SourceLocation = SourceLocation {};
        if DS.getTypeSpecType() == TST_decltype_auto || !self.TryConsumeToken(coloncolon, CCLoc) {
            self.AnnotateExistingDecltypeSpecifier(DS, DeclLoc, EndLoc);
            return false;
        }
        if self.Actions.ActOnCXXNestedNameSpecifierDecltype(SS, DS, CCLoc) {
            SS.SetInvalid(SourceRange { B: DeclLoc, E: CCLoc });
        }
        HasScopeSpecifier = true;
    } else if !HasScopeSpecifier && self.Tok.is(identifier) && self.GetLookAheadToken(1).is(ellipsis) && self.GetLookAheadToken(2).is(l_square) && !self.GetLookAheadToken(3).is(r_square) {
        let mut TemplateName: UnqualifiedId = UnqualifiedId {};
        let mut Template: TemplateTy = null;
        let mut TNK: TemplateNameKind = self.isPackIndexingTemplateName(TemplateName, Template);
        if TNK != TNK_Non_template {
            if self.AnnotatePackIndexingTemplateName(SS, TemplateName, Template, TNK) {
                return true;
            }
        } else {
            let mut Start: SourceLocation = self.Tok.getLocation();
            let mut DS: DeclSpec = self.AttrFactory;
            let mut CCLoc: SourceLocation = SourceLocation {};
            let mut EndLoc: SourceLocation = self.ParsePackIndexingType(DS);
            if DS.getTypeSpecType() == TST_error {
                return false;
            }
            let mut Pattern: QualType = GetTypeFromParser(DS.getRepAsType(), null);
            let mut Type: QualType = self.Actions.ActOnPackIndexingType(Pattern, DS.getPackIndexingExpr(), DS.getBeginLoc(), DS.getEllipsisLoc());
            if Type.isNull() {
                return false;
            }
            if !self.Tok.is(coloncolon) && !self.getLangOpts().CPlusPlus26 && self.getCurScope().isFunctionDeclarationScope() {
                self.Diag(Start, warn_pre_cxx26_ambiguous_pack_indexing_type) << Type;
            }
            if !self.TryConsumeToken(coloncolon, CCLoc) {
                self.AnnotateExistingIndexedTypeNamePack(make(Type), Start, EndLoc);
                return false;
            }
            if self.Actions.ActOnCXXNestedNameSpecifierIndexedPack(SS, DS, CCLoc, move(Type)) {
                SS.SetInvalid(SourceRange { B: Start, E: CCLoc });
            }
            HasScopeSpecifier = true;
        }
    }
    let mut SavedType: PreferredTypeBuilder = self.PreferredType;
    while true {
        if HasScopeSpecifier {
            if self.Tok.is(code_completion) {
                self.cutOffParsing();
                self.Actions.CodeCompletion().CodeCompleteQualifiedId(self.getCurScope(), SS, EnteringContext, InUsingDeclaration, IsAddressOfOperand, IsInDeclarationContext, ObjectType.get(), SavedType.get(SS.getBeginLoc()));
                SS.setEndLoc(self.Tok.getLocation());
                return true;
            }
            ObjectType = null;
        }
        if self.Tok.is(kw_template) {
            if !HasScopeSpecifier && !ObjectType {
                break;
            }
            let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
            let mut TemplateKWLoc: SourceLocation = self.ConsumeToken();
            let mut TemplateName: UnqualifiedId = UnqualifiedId {};
            if self.Tok.is(identifier) {
                TemplateName.setIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
                self.ConsumeToken();
            } else if self.Tok.is(kw_operator) {
                if self.ParseUnqualifiedIdOperator(SS, EnteringContext, ObjectType, TemplateName) {
                    TPA.Revert();
                    return true;
                }
                if TemplateName.getKind() != IK_OperatorFunctionId && TemplateName.getKind() != IK_LiteralOperatorId {
                    self.Diag(TemplateName.getSourceRange().getBegin(), err_id_after_template_in_nested_name_spec) << TemplateName.getSourceRange();
                    TPA.Revert();
                    return true;
                }
            } else {
                TPA.Revert();
                break;
            }
            if self.Tok.isNot(less) {
                TPA.Revert();
                break;
            }
            TPA.Commit();
            let mut Template: TemplateTy = null;
            let mut TNK: TemplateNameKind = self.Actions.ActOnTemplateName(self.getCurScope(), SS, TemplateKWLoc, TemplateName, ObjectType, EnteringContext, Template, true);
            if self.AnnotateTemplateIdToken(Template, TNK, SS, TemplateKWLoc, TemplateName, false, false) {
                return true;
            }
            continue;
        }
        if self.Tok.is(annot_template_id) && self.NextToken().is(coloncolon) {
            let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
            if CheckForDestructor && self.GetLookAheadToken(2).is(tilde) {
                *MayBePseudoDestructor = true;
                return false;
            }
            if LastII {
                *LastII = TemplateId.Name;
            }
            self.ConsumeAnnotationToken();
            assert!(self.Tok.is(coloncolon), "NextToken() not working properly!");
            let mut CCLoc: SourceLocation = self.ConsumeToken();
            HasScopeSpecifier = true;
            let mut TemplateArgsPtr: ASTTemplateArgsPtr = ASTTemplateArgsPtr { TemplateId.getTemplateArgs(), TemplateId.NumArgs };
            if TemplateId.isInvalid() || self.Actions.ActOnCXXNestedNameSpecifier(self.getCurScope(), SS, TemplateId.TemplateKWLoc, TemplateId.Template, TemplateId.TemplateNameLoc, TemplateId.LAngleLoc, TemplateArgsPtr, TemplateId.RAngleLoc, CCLoc, EnteringContext) {
                let mut StartLoc: SourceLocation = if SS.getBeginLoc().isValid() { SS.getBeginLoc() } else { TemplateId.TemplateNameLoc };
                SS.SetInvalid(SourceRange { B: StartLoc, E: CCLoc });
            }
            continue;
        }
        match self.Tok.getKind() {
            kw___add_lvalue_reference => {
                kw___add_pointer;
            },
            _ => {
                break;
            },
        }
        if self.Tok.isNot(identifier) {
            break;
        }
        let mut II: *mut IdentifierInfo = *self.Tok.getIdentifierInfo();
        let mut Next: Token = self.NextToken();
        let mut IdInfo: NestedNameSpecInfo = NestedNameSpecInfo { &mut II, self.Tok.getLocation(), Next.getLocation(), ObjectType };
        if Next.is(colon) && !self.ColonIsSacred && !self.ParsingGenericAssociationType {
            if self.Actions.IsInvalidUnlessNestedName(self.getCurScope(), SS, IdInfo, EnteringContext) && self.PP.LookAhead(1).is(identifier) {
                self.Diag(Next, err_unexpected_colon_in_nested_name_spec) << CreateReplacement(Next.getLocation(), "::");
                Next.setKind(coloncolon);
            }
        }
        if Next.is(coloncolon) && self.GetLookAheadToken(2).is(l_brace) {
            let mut Identifier: Token = self.Tok;
            self.ConsumeToken();
            self.ConsumeToken();
            self.Diag(self.getEndOfPreviousToken(), err_expected) << identifier;
            self.UnconsumeToken(Identifier);
            Next = self.NextToken();
        }
        if Next.is(coloncolon) {
            if CheckForDestructor && self.GetLookAheadToken(2).is(tilde) {
                *MayBePseudoDestructor = true;
                return false;
            }
            if self.ColonIsSacred {
                let mut Next2: *Token = self.GetLookAheadToken(2);
                if Next2.is(kw_private) || Next2.is(kw_protected) || Next2.is(kw_public) || Next2.is(kw_virtual) {
                    self.Diag(Next2, err_unexpected_token_in_nested_name_spec) << Next2.getName() << CreateReplacement(Next.getLocation(), ":");
                    let mut ColonColon: Token = Token {};
                    self.PP.Lex(ColonColon);
                    ColonColon.setKind(colon);
                    self.PP.EnterToken(ColonColon, true);
                    break;
                }
            }
            if LastII {
                *LastII = &mut II;
            }
            let mut Identifier: Token = self.Tok;
            let mut IdLoc: SourceLocation = self.ConsumeToken();
            assert!(self.Tok.isOneOf(coloncolon, colon), "NextToken() not working properly!");
            let mut ColonColon: Token = self.Tok;
            let mut CCLoc: SourceLocation = self.ConsumeToken();
            let mut IsCorrectedToColon: bool = false;
            let mut CorrectionFlagPtr: *mut bool = if self.ColonIsSacred { &mut IsCorrectedToColon } else { null };
            if self.Actions.ActOnCXXNestedNameSpecifier(self.getCurScope(), IdInfo, EnteringContext, SS, CorrectionFlagPtr, OnlyNamespace) {
                if CorrectionFlagPtr && IsCorrectedToColon {
                    ColonColon.setKind(colon);
                    self.PP.EnterToken(self.Tok, true);
                    self.PP.EnterToken(ColonColon, true);
                    self.Tok = Identifier;
                    break;
                }
                SS.SetInvalid(SourceRange { B: IdLoc, E: CCLoc });
            }
            HasScopeSpecifier = true;
            continue;
        }
        self.CheckForTemplateAndDigraph(Next, ObjectType, EnteringContext, II, SS);
        if Next.is(less) {
            let mut Template: TemplateTy = null;
            let mut TemplateName: UnqualifiedId = UnqualifiedId {};
            TemplateName.setIdentifier(&mut II, self.Tok.getLocation());
            let mut MemberOfUnknownSpecialization: bool = false;
            if self.Actions.isTemplateName(self.getCurScope(), SS, false, TemplateName, ObjectType, EnteringContext, Template, MemberOfUnknownSpecialization, !Disambiguation) {
                TNK;
            } else {
                if !IsTypename && TNK == TNK_Undeclared_template && self.isTemplateArgumentList(1) == False {
                    break;
                }
                self.ConsumeToken();
                if self.AnnotateTemplateIdToken(Template, TNK, SS, SourceLocation {}, TemplateName, false, false) {
                    return true;
                }
                continue;
            }
            if MemberOfUnknownSpecialization && !Disambiguation && (ObjectType || SS.isSet()) && (IsTypename || self.isTemplateArgumentList(1) == True) {
                if !ObjectHadErrors {
                    let mut DiagID: u32 = err_missing_dependent_template_keyword;
                    if self.getLangOpts().MicrosoftExt {
                        DiagID = warn_missing_dependent_template_keyword;
                    }
                    self.Diag(self.Tok.getLocation(), DiagID) << II.getName() << CreateInsertion(self.Tok.getLocation(), "template ", false);
                }
                self.ConsumeToken();
                let mut TNK: TemplateNameKind = self.Actions.ActOnTemplateName(self.getCurScope(), SS, SourceLocation {}, TemplateName, ObjectType, EnteringContext, Template, true);
                if self.AnnotateTemplateIdToken(Template, TNK, SS, SourceLocation {}, TemplateName, false, false) {
                    return true;
                }
                continue;
            }
        }
        break;
    }
    if CheckForDestructor && !HasScopeSpecifier && self.Tok.is(tilde) {
        *MayBePseudoDestructor = true;
    }
    return false;
}

fn Parser::tryParseCXXIdExpression(self, SS: *mut CXXScopeSpec, isAddressOfOperand: bool) -> ExprResult {
    let mut E: ExprResult = false;
    match self.Tok.getKind() {
        annot_non_type => {
            let mut ND: *mut NamedDecl = getNonTypeAnnotation(self.Tok);
            let mut Loc: SourceLocation = self.ConsumeAnnotationToken();
            E = self.Actions.ActOnNameClassifiedAsNonType(self.getCurScope(), SS, ND, Loc, self.Tok);
            break;
        },
        annot_non_type_dependent => {
            let mut II: *mut IdentifierInfo = getIdentifierAnnotation(self.Tok);
            let mut Loc: SourceLocation = self.ConsumeAnnotationToken();
            if isAddressOfOperand && self.isPostfixExpressionSuffixStart() {
                isAddressOfOperand = false;
            }
            E = self.Actions.ActOnNameClassifiedAsDependentNonType(SS, II, Loc, isAddressOfOperand);
            break;
        },
        annot_non_type_undeclared => {
            assert!(SS.isEmpty(), "undeclared non-type annotation should be unqualified");
            let mut II: *mut IdentifierInfo = getIdentifierAnnotation(self.Tok);
            let mut Loc: SourceLocation = self.ConsumeAnnotationToken();
            E = self.Actions.ActOnNameClassifiedAsUndeclaredNonType(II, Loc);
            break;
        },
        _ => {
            let mut TemplateKWLoc: SourceLocation = SourceLocation {};
        },
    }
    E = self.tryParseCXXPackIndexingExpression(E);
    if !E.isInvalid() && !E.isUnset() && self.Tok.is(less) {
        self.checkPotentialAngleBracket(E);
    }
    return E;
}

fn Parser::ParseCXXPackIndexingExpression(self, PackIdExpression: ExprResult) -> ExprResult {
    assert!(self.Tok.is(ellipsis) && self.NextToken().is(l_square), "expected ...[");
    let mut EllipsisLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
    T.consumeOpen();
    let mut IndexExpr: ExprResult = self.ParseConstantExpression();
    if T.consumeClose() || IndexExpr.isInvalid() {
        return ExprError();
    }
    return self.Actions.ActOnPackIndexingExpr(self.getCurScope(), PackIdExpression.get(), EllipsisLoc, T.getOpenLocation(), IndexExpr.get(), T.getCloseLocation());
}

fn Parser::tryParseCXXPackIndexingExpression(self, PackIdExpression: ExprResult) -> ExprResult {
    let mut E: ExprResult = PackIdExpression;
    if !PackIdExpression.isInvalid() && !PackIdExpression.isUnset() && self.Tok.is(ellipsis) && self.NextToken().is(l_square) {
        E = self.ParseCXXPackIndexingExpression(E);
    }
    return E;
}

fn Parser::ParseCXXIdExpression(self, isAddressOfOperand: bool) -> ExprResult {
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, false, false, false, false, false);
    let mut Result: ExprResult = self.tryParseCXXIdExpression(SS, isAddressOfOperand);
    assert!(!Result.isUnset(), "Typo correction suggested a keyword replacement for a previous keyword suggestion");
    return Result;
}

fn Parser::ParseLambdaExpression(self) -> ExprResult {
    let mut Intro: LambdaIntroducer = LambdaIntroducer {};
    if self.ParseLambdaIntroducer(Intro, null) {
        self.SkipUntil(r_square, StopAtSemi);
        self.SkipUntil(l_brace, StopAtSemi);
        self.SkipUntil(r_brace, StopAtSemi);
        return ExprError();
    }
    return self.ParseLambdaExpressionAfterIntroducer(Intro);
}

fn Parser::TryParseLambdaExpression(self) -> ExprResult {
    assert!(self.getLangOpts().CPlusPlus && self.Tok.is(l_square), "Not at the start of a possible lambda expression.");
    let mut Next: Token = self.NextToken();
    if Next.is(eof) {
        return ExprEmpty();
    }
    let mut After: Token = self.GetLookAheadToken(2);
    if Next.is(r_square) || Next.is(equal) || (Next.is(amp) && After.isOneOf(r_square, comma)) || (Next.is(identifier) && After.is(r_square)) || Next.is(ellipsis) {
        return self.ParseLambdaExpression();
    }
    if Next.is(identifier) && After.is(identifier) {
        return ExprEmpty();
    }
    let mut Intro: LambdaIntroducer = LambdaIntroducer {};
    {
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        let mut Tentative: LambdaIntroducerTentativeParse = zeroed();
        if self.ParseLambdaIntroducer(Intro, &mut Tentative) {
            TPA.Commit();
            return ExprError();
        }
        match Tentative {
            Success => {
                TPA.Commit();
            },
            Incomplete => {
                TPA.Revert();
            },
            MessageSend => {
                Invalid;
            },
        }
    }
    return self.ParseLambdaExpressionAfterIntroducer(Intro);
}

fn Parser::ParseLambdaIntroducer(self, Intro: *mut LambdaIntroducer, Tentative: *mut LambdaIntroducerTentativeParse) -> bool {
    if Tentative {
        *Tentative = Success;
    }
    assert!(self.Tok.is(l_square), "Lambda expressions begin with '['.");
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
    T.consumeOpen();
    Intro.Range.setBegin(T.getOpenLocation());
    let mut First: bool = true;
    let mut Result: Closure_1 = Closure_1 { Tentative: &mut Tentative };
    let mut NonTentativeAction: Closure_2 = Closure_2 { Tentative: &mut Tentative };
    if self.Tok.is(amp) && (self.NextToken().is(comma) || self.NextToken().is(r_square)) {
        Intro.Default = LCD_ByRef;
        Intro.DefaultLoc = self.ConsumeToken();
        First = false;
        if !self.Tok.getIdentifierInfo() {
            Tentative = null;
        }
    } else if self.Tok.is(equal) {
        Intro.Default = LCD_ByCopy;
        Intro.DefaultLoc = self.ConsumeToken();
        First = false;
        Tentative = null;
    }
    while self.Tok.isNot(r_square) {
        if !First {
            if self.Tok.isNot(comma) {
                if self.Tok.is(code_completion) && !(self.getLangOpts().ObjC && Tentative) {
                    self.cutOffParsing();
                    self.Actions.CodeCompletion().CodeCompleteLambdaIntroducer(self.getCurScope(), Intro, false);
                    break;
                }
                return Result.call(function_ref<void ()> { Closure_3 { cap_0: self }, null, null }, Invalid);
            }
            self.ConsumeToken();
        }
        if self.Tok.is(code_completion) {
            self.cutOffParsing();
            if self.getLangOpts().ObjC && Tentative && First {
                self.Actions.CodeCompletion().CodeCompleteObjCMessageReceiver(self.getCurScope());
            } else {
                self.Actions.CodeCompletion().CodeCompleteLambdaIntroducer(self.getCurScope(), Intro, false);
            }
            break;
        }
        First = false;
        let mut Kind: LambdaCaptureKind = LCK_ByCopy;
        let mut InitKind: LambdaCaptureInitKind = NoInit;
        let mut Loc: SourceLocation = SourceLocation {};
        let mut Id: *mut IdentifierInfo = null;
        let mut EllipsisLocs: [4]SourceLocation = [4]SourceLocation {};
        let mut Init: ExprResult = false;
        let mut LocStart: SourceLocation = self.Tok.getLocation();
        if self.Tok.is(star) {
            Loc = self.ConsumeToken();
            if self.Tok.is(kw_this) {
                self.ConsumeToken();
                Kind = LCK_StarThis;
            } else {
                return Result.call(function_ref<void ()> { Closure_4 { cap_0: self }, null, null }, Invalid);
            }
        } else if self.Tok.is(kw_this) {
            Kind = LCK_This;
            Loc = self.ConsumeToken();
        } else if self.Tok.isOneOf(amp, equal) && self.NextToken().isOneOf(comma, r_square) && Intro.Default == LCD_None {
            return Result.call(function_ref<void ()> { Closure_5 { cap_0: self }, null, null }, Incomplete);
        } else {
            self.TryConsumeToken(ellipsis, EllipsisLocs[0]);
            if self.Tok.is(amp) {
                Kind = LCK_ByRef;
                self.ConsumeToken();
                if self.Tok.is(code_completion) {
                    self.cutOffParsing();
                    self.Actions.CodeCompletion().CodeCompleteLambdaIntroducer(self.getCurScope(), Intro, true);
                    break;
                }
            }
            self.TryConsumeToken(ellipsis, EllipsisLocs[1]);
            if self.Tok.is(identifier) {
                Id = self.Tok.getIdentifierInfo();
                Loc = self.ConsumeToken();
            } else if self.Tok.is(kw_this) {
                return Result.call(function_ref<void ()> { Closure_6 { cap_0: self }, null, null }, Invalid);
            } else {
                return Result.call(function_ref<void ()> { Closure_7 { cap_0: self }, null, null }, Invalid);
            }
            self.TryConsumeToken(ellipsis, EllipsisLocs[2]);
            if self.Tok.is(l_paren) {
                let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
                Parens.consumeOpen();
                InitKind = DirectInit;
                let mut Exprs: ExprVector = ExprVector {};
                if Tentative {
                    Parens.skipToEnd();
                    *Tentative = Incomplete;
                } else if self.ParseExpressionList(Exprs, function_ref<void ()> {}, false, false) {
                    Parens.skipToEnd();
                    Init = ExprError();
                } else {
                    Parens.consumeClose();
                    Init = self.Actions.ActOnParenListExpr(Parens.getOpenLocation(), Parens.getCloseLocation(), Exprs);
                }
            } else if self.Tok.isOneOf(l_brace, equal) {
                let mut EC: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, PotentiallyEvaluated, null, EK_Other, true };
                if self.TryConsumeToken(equal) {
                    InitKind = CopyInit;
                } else {
                    InitKind = ListInit;
                }
                if !Tentative {
                    Init = self.ParseInitializer(null);
                } else if self.Tok.is(l_brace) {
                    let mut Braces: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
                    Braces.consumeOpen();
                    Braces.skipToEnd();
                    *Tentative = Incomplete;
                } else {
                    let mut StartLoc: SourceLocation = self.Tok.getLocation();
                    let mut MaybeInMessageExpression: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: true };
                    Init = self.ParseInitializer(null);
                    if self.Tok.getLocation() != StartLoc {
                        self.PP.RevertCachedTokens(1);
                        self.Tok.setLocation(StartLoc);
                        self.Tok.setKind(annot_primary_expr);
                        setExprAnnotation(self.Tok, Init);
                        self.Tok.setAnnotationEndLoc(self.PP.getLastCachedTokenLocation());
                        self.PP.AnnotateCachedTokens(self.Tok);
                        self.ConsumeAnnotationToken();
                    }
                }
            }
            self.TryConsumeToken(ellipsis, EllipsisLocs[3]);
        }
        if Tentative && self.Tok.is(identifier) && self.NextToken().isOneOf(colon, r_square) {
            *Tentative = MessageSend;
            return false;
        }
        let mut EllipsisLoc: SourceLocation = SourceLocation {};
        if any_of(EllipsisLocs, Closure_8 {}) {
            let mut InitCapture: bool = InitKind != NoInit;
            let mut ExpectedEllipsisLoc: *mut SourceLocation = if !InitCapture { &mut EllipsisLocs[2] } else { if Kind == LCK_ByRef { &mut EllipsisLocs[1] } else { &mut EllipsisLocs[0] } };
            EllipsisLoc = *ExpectedEllipsisLoc;
            let mut DiagID: u32 = 0;
            if EllipsisLoc.isInvalid() {
                DiagID = err_lambda_capture_misplaced_ellipsis;
                for Loc in EllipsisLocs[..] {
                    if Loc.isValid() {
                        EllipsisLoc = Loc;
                    }
                }
            } else {
                let mut NumEllipses: u32 = accumulate(begin(EllipsisLocs), end(EllipsisLocs), 0, Closure_9 {});
                if NumEllipses > 1 {
                    DiagID = err_lambda_capture_multiple_ellipses;
                }
            }
            if DiagID {
                NonTentativeAction.call(function_ref<void ()> { Closure_10 { EllipsisLocs: &mut EllipsisLocs, ExpectedEllipsisLoc: &mut ExpectedEllipsisLoc, cap_2: self, DiagID: &mut DiagID, InitCapture: &mut InitCapture, Loc: &mut Loc }, null, null });
            }
        }
        let mut InitCaptureType: ParsedType = null;
        if Init.isUsable() {
            NonTentativeAction.call(function_ref<void ()> { Closure_11 { Init: &mut Init, InitCaptureType: &mut InitCaptureType, cap_2: self, Loc: &mut Loc, Kind: &mut Kind, EllipsisLoc: &mut EllipsisLoc, Id: &mut Id, InitKind: &mut InitKind }, null, null });
        }
        let mut LocEnd: SourceLocation = self.PrevTokLocation;
        Intro.addCapture(Kind, Loc, Id, EllipsisLoc, InitKind, Init, InitCaptureType, SourceRange { B: LocStart, E: LocEnd });
    }
    T.consumeClose();
    Intro.Range.setEnd(T.getCloseLocation());
    return false;
}

fn tryConsumeLambdaSpecifierToken(P: *mut Parser, MutableLoc: *mut SourceLocation, StaticLoc: *mut SourceLocation, ConstexprLoc: *mut SourceLocation, ConstevalLoc: *mut SourceLocation, DeclEndLoc: *mut SourceLocation) {
    assert!(MutableLoc.isInvalid();
    assert!(StaticLoc.isInvalid();
    assert!(ConstexprLoc.isInvalid();
    assert!(ConstevalLoc.isInvalid();
    let mut ConsumeLocation: Closure_12 = Closure_12 { P: &mut P, DeclEndLoc: &mut DeclEndLoc };
    while true {
        match P.getCurToken().getKind() {
            kw_mutable => {
                ConsumeLocation.call(MutableLoc, 0);
            },
            kw_static => {
                ConsumeLocation.call(StaticLoc, 1);
            },
            kw_constexpr => {
                ConsumeLocation.call(ConstexprLoc, 2);
            },
            kw_consteval => {
                ConsumeLocation.call(ConstevalLoc, 3);
            },
            _ => {
                return;
            },
        }
    }
}

fn addStaticToLambdaDeclSpecifier(P: *mut Parser, StaticLoc: SourceLocation, DS: *mut DeclSpec) {
    if StaticLoc.isValid() {
        P.DiagCompat(StaticLoc, static_lambda);
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        DS.SetStorageClassSpec(P.getActions(), SCS_static, StaticLoc, PrevSpec, DiagID, P.getActions().getASTContext().getPrintingPolicy());
        assert!(PrevSpec == null && DiagID == 0, "Static cannot have been set previously!");
    }
}

fn addConstexprToLambdaDeclSpecifier(P: *mut Parser, ConstexprLoc: SourceLocation, DS: *mut DeclSpec) {
    if ConstexprLoc.isValid() {
        P.DiagCompat(ConstexprLoc, constexpr_on_lambda);
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        DS.SetConstexprSpec(Constexpr, ConstexprLoc, PrevSpec, DiagID);
        assert!(PrevSpec == null && DiagID == 0, "Constexpr cannot have been set previously!");
    }
}

fn addConstevalToLambdaDeclSpecifier(P: *mut Parser, ConstevalLoc: SourceLocation, DS: *mut DeclSpec) {
    if ConstevalLoc.isValid() {
        P.Diag(ConstevalLoc, warn_cxx20_compat_consteval);
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        DS.SetConstexprSpec(Consteval, ConstevalLoc, PrevSpec, DiagID);
        if DiagID != 0 {
            P.Diag(ConstevalLoc, DiagID) << PrevSpec;
        }
    }
}

fn DiagnoseStaticSpecifierRestrictions(P: *mut Parser, StaticLoc: SourceLocation, MutableLoc: SourceLocation, Intro: *LambdaIntroducer) {
    if StaticLoc.isInvalid() {
        return;
    }
    if MutableLoc.isValid() {
        P.Diag(StaticLoc, err_static_mutable_lambda);
    }
    if Intro.hasLambdaCapture() {
        P.Diag(StaticLoc, err_static_lambda_captures);
    }
}

fn Parser::isLambdaSpecifier(self) -> bool {
    return self.Tok.isOneOf(kw_mutable, arrow, kw___attribute, kw_constexpr, kw_consteval, kw_static, kw___private, kw___global, kw___local, kw___constant, kw___generic, kw_groupshared, kw_requires, kw_noexcept) || self.Tok.isRegularKeywordAttribute() || (self.Tok.is(l_square) && self.NextToken().is(l_square));
}

fn Parser::ParseLambdaExpressionAfterIntroducer(self, Intro: *mut LambdaIntroducer) -> ExprResult {
    let mut LambdaBeginLoc: SourceLocation = Intro.Range.getBegin();
    if self.getLangOpts().HLSL {
        self.Diag(LambdaBeginLoc, ext_hlsl_lambda) << 1;
    } else {
        self.Diag(LambdaBeginLoc, if self.getLangOpts().CPlusPlus11 { warn_cxx98_compat_lambda } else { ext_lambda }) << 0;
    }
    let mut CrashInfo: PrettyStackTraceLoc = PrettyStackTraceLoc { self.PP.getSourceManager(), LambdaBeginLoc, "lambda expression parsing" };
    let mut DS: DeclSpec = self.AttrFactory;
    let mut D: Declarator = Declarator { DS, none(), LambdaExpr };
    let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
    let mut LambdaScope: ParseScope = ParseScope { self, LambdaScope | DeclScope | FunctionDeclarationScope | FunctionPrototypeScope, true, false };
    self.Actions.PushLambdaScope();
    let mut DeclLoc: SourceLocation = self.Tok.getLocation();
    self.Actions.ActOnLambdaExpressionAfterIntroducer(Intro, self.getCurScope());
    let mut Attributes: ParsedAttributes = self.AttrFactory;
    if self.getLangOpts().CUDA {
        while true {
            if self.Tok.is(kw___noinline__) {
                let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
                let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
                Attributes.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, kw___noinline__, SourceLocation {});
            } else if self.Tok.is(kw___attribute) {
                self.ParseGNUAttributes(Attributes, null, &mut D);
            } else {
                break;
            }
        }
        D.takeAttributesAppending(Attributes);
    }
    let mut TemplateParamScope: MultiParseScope = *self;
    if self.Tok.is(less) {
        self.DiagCompat(self.Tok, lambda_template_parameter_list);
        let mut TemplateParams: SmallVector<NamedDecl *, 4> = SmallVector<NamedDecl *, 4> {};
        let mut LAngleLoc: SourceLocation = SourceLocation {};
        let mut RAngleLoc: SourceLocation = SourceLocation {};
        if self.ParseTemplateParameters(TemplateParamScope, CurTemplateDepthTracker.getDepth(), TemplateParams, LAngleLoc, RAngleLoc) {
            self.Actions.ActOnLambdaError(LambdaBeginLoc, self.getCurScope(), false);
            return ExprError();
        }
        if TemplateParams.is_empty() {
            self.Diag(RAngleLoc, err_lambda_template_parameter_list_empty);
        } else {
            operator(CurTemplateDepthTracker);
            let mut RequiresClause: ExprResult = false;
            if self.TryConsumeToken(kw_requires) {
                RequiresClause = self.Actions.ActOnRequiresClause(self.ParseConstraintLogicalOrExpression(false));
                if RequiresClause.isInvalid() {
                    self.SkipUntil([l_brace, l_paren], StopAtSemi | StopBeforeMatch);
                }
            }
            self.Actions.ActOnLambdaExplicitTemplateParameterList(Intro, LAngleLoc, TemplateParams, RAngleLoc, RequiresClause);
        }
    }
    if self.isCXX11AttributeSpecifier(false, false) != NotAttributeSpecifier {
        self.Diag(self.Tok, if self.getLangOpts().CPlusPlus23 { warn_cxx20_compat_decl_attrs_on_lambda } else { ext_decl_attrs_on_lambda }) << self.Tok.isRegularKeywordAttribute() << self.Tok.getIdentifierInfo();
        self.MaybeParseCXX11Attributes(D);
    }
    let mut TrailingReturnType: TypeResult = false;
    let mut TrailingReturnTypeLoc: SourceLocation = SourceLocation {};
    let mut LParenLoc: SourceLocation = SourceLocation {};
    let mut RParenLoc: SourceLocation = SourceLocation {};
    let mut DeclEndLoc: SourceLocation = DeclLoc;
    let mut HasParentheses: bool = false;
    let mut HasSpecifiers: bool = false;
    let mut MutableLoc: SourceLocation = SourceLocation {};
    let mut Prototype: ParseScope = ParseScope { self, FunctionPrototypeScope | FunctionDeclarationScope | DeclScope, true, false };
    let mut ParamInfo: ParamInfo, 16> = ParamInfo, 16> {};
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    if self.Tok.is(l_paren) {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        LParenLoc = T.getOpenLocation();
        if self.Tok.isNot(r_paren) {
            self.Actions.RecordParsingTemplateParameterDepth(CurTemplateDepthTracker.getOriginalDepth());
            self.ParseParameterDeclarationClause(D, Attributes, ParamInfo, EllipsisLoc);
            if self.Actions.getCurGenericLambda() {
                CurTemplateDepthTracker.setAddedDepth(1);
            }
        }
        T.consumeClose();
        DeclEndLoc = RParenLoc = T.getCloseLocation();
        HasParentheses = true;
    }
    HasSpecifiers = self.isLambdaSpecifier();
    if HasSpecifiers && !HasParentheses && !self.getLangOpts().CPlusPlus23 {
        self.Diag(self.Tok, ext_lambda_missing_parens) << CreateInsertion(self.Tok.getLocation(), "() ", false);
    }
    if HasParentheses || HasSpecifiers {
        self.MaybeParseAttributes(PAKM_GNU | PAKM_Declspec, Attributes, null);
        let mut ConstexprLoc: SourceLocation = SourceLocation {};
        let mut ConstevalLoc: SourceLocation = SourceLocation {};
        let mut StaticLoc: SourceLocation = SourceLocation {};
        tryConsumeLambdaSpecifierToken(*self, MutableLoc, StaticLoc, ConstexprLoc, ConstevalLoc, DeclEndLoc);
        DiagnoseStaticSpecifierRestrictions(*self, StaticLoc, MutableLoc, Intro);
        addStaticToLambdaDeclSpecifier(*self, StaticLoc, DS);
        addConstexprToLambdaDeclSpecifier(*self, ConstexprLoc, DS);
        addConstevalToLambdaDeclSpecifier(*self, ConstevalLoc, DS);
    }
    self.Actions.ActOnLambdaClosureParameters(self.getCurScope(), ParamInfo);
    if !HasParentheses {
        self.Actions.ActOnLambdaClosureQualifiers(Intro, MutableLoc);
    }
    if HasSpecifiers || HasParentheses {
        let mut ESpecType: ExceptionSpecificationType = EST_None;
        let mut ESpecRange: SourceRange = SourceRange {};
        let mut DynamicExceptions: SmallVector<ParsedType, 2> = SmallVector<ParsedType, 2> {};
        let mut DynamicExceptionRanges: SmallVector<SourceRange, 2> = SmallVector<SourceRange, 2> {};
        let mut NoexceptExpr: ExprResult = false;
        let mut ExceptionSpecTokens: *mut CachedTokens = null;
        ESpecType = self.tryParseExceptionSpecification(false, ESpecRange, DynamicExceptions, DynamicExceptionRanges, NoexceptExpr, ExceptionSpecTokens);
        if ESpecType != EST_None {
            DeclEndLoc = ESpecRange.getEnd();
        }
        if self.MaybeParseCXX11Attributes(Attributes, false) {
            DeclEndLoc = Attributes.Range.getEnd();
        }
        if self.Tok.isOneOf(kw___private, kw___global, kw___local, kw___constant, kw___generic) {
            self.ParseOpenCLQualifiers(DS.getAttributes());
            self.ConsumeToken();
        }
        if HasParentheses {
            self.Actions.ActOnLambdaClosureQualifiers(Intro, MutableLoc);
        }
        let mut FunLocalRangeEnd: SourceLocation = DeclEndLoc;
        if self.Tok.is(arrow) {
            FunLocalRangeEnd = self.Tok.getLocation();
            let mut Range: SourceRange = SourceRange {};
            TrailingReturnType = self.ParseTrailingReturnType(Range, false);
            TrailingReturnTypeLoc = Range.getBegin();
            if Range.getEnd().isValid() {
                DeclEndLoc = Range.getEnd();
            }
        }
        let mut NoLoc: SourceLocation = SourceLocation {};
        D.AddTypeInfo(getFunction(true, false, LParenLoc, ParamInfo.ptr, ParamInfo.len, EllipsisLoc, RParenLoc, true, NoLoc, MutableLoc, ESpecType, ESpecRange, DynamicExceptions.ptr, DynamicExceptionRanges.ptr, DynamicExceptions.len, if NoexceptExpr.isUsable() { NoexceptExpr.get() } else { null }, null, ArrayRef<NamedDecl *> {}, LParenLoc, FunLocalRangeEnd, D, TrailingReturnType, TrailingReturnTypeLoc, &mut DS), move(Attributes), DeclEndLoc);
        if HasParentheses && self.Tok.is(kw_requires) {
            self.ParseTrailingRequiresClause(D);
        }
    }
    if self.getLangOpts().CUDA {
        for A in Attributes {
            if A.getKind() == AT_CUDADevice || A.getKind() == AT_CUDAHost || A.getKind() == AT_CUDAGlobal {
                self.Diag(A.getLoc(), warn_cuda_attr_lambda_position) << A.getAttrName().getName();
            }
        }
    }
    Prototype.Exit();
    let mut ScopeFlags: u32 = BlockScope | FnScope | DeclScope | CompoundStmtScope;
    let mut BodyScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    self.Actions.ActOnStartOfLambdaDefinition(Intro, D, DS);
    if !self.Tok.is(l_brace) {
        self.Diag(self.Tok, err_expected_lambda_body);
        self.Actions.ActOnLambdaError(LambdaBeginLoc, self.getCurScope(), false);
        return ExprError();
    }
    let mut Stmt: StmtResult = self.ParseCompoundStatementBody(false);
    BodyScope.Exit();
    TemplateParamScope.Exit();
    LambdaScope.Exit();
    if !Stmt.isInvalid() && !TrailingReturnType.isInvalid() && !D.isInvalidType() {
        return self.Actions.ActOnLambdaExpr(LambdaBeginLoc, Stmt.get());
    }
    self.Actions.ActOnLambdaError(LambdaBeginLoc, self.getCurScope(), false);
    return ExprError();
}

fn Parser::ParseCXXCasts(self) -> ExprResult {
    let mut Kind: TokenKind = self.Tok.getKind();
    let mut CastName: *u8 = null;
    match Kind {
        _ => {
            llvm_unreachable_internal("Unknown C++ cast!", "P:/Goraw/llvm-project/clang/lib/Parse/ParseExprCXX.cpp", 1503);
        },
        kw_addrspace_cast => {
            CastName = "addrspace_cast";
        },
        kw_const_cast => {
            CastName = "const_cast";
        },
        kw_dynamic_cast => {
            CastName = "dynamic_cast";
        },
        kw_reinterpret_cast => {
            CastName = "reinterpret_cast";
        },
        kw_static_cast => {
            CastName = "static_cast";
        },
    }
    let mut OpLoc: SourceLocation = self.ConsumeToken();
    let mut LAngleBracketLoc: SourceLocation = self.Tok.getLocation();
    if self.Tok.is(l_square) && self.Tok.getLength() == 2 {
        let mut Next: Token = self.NextToken();
        if Next.is(colon) && self.areTokensAdjacent(self.Tok, Next) {
            FixDigraph(*self, self.PP, self.Tok, Next, Kind, true);
        }
    }
    if self.ExpectAndConsume(less, err_expected_less_after, CastName) {
        return ExprError();
    }
    let mut DS: DeclSpec = self.AttrFactory;
    self.ParseSpecifierQualifierList(DS, AS_none, DSC_type_specifier);
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
    self.ParseDeclarator(DeclaratorInfo);
    let mut RAngleBracketLoc: SourceLocation = self.Tok.getLocation();
    if self.ExpectAndConsume(greater, err_expected, "") {
        return ExprError(self.Diag(LAngleBracketLoc, note_matching) << less);
    }
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected_lparen_after, CastName, unknown) {
        return ExprError();
    }
    let mut Result: ExprResult = self.ParseExpression(AllowNonTypes);
    T.consumeClose();
    if !Result.isInvalid() && !DeclaratorInfo.isInvalidType() {
        Result = self.Actions.ActOnCXXNamedCast(OpLoc, Kind, LAngleBracketLoc, DeclaratorInfo, RAngleBracketLoc, T.getOpenLocation(), Result.get(), T.getCloseLocation());
    }
    return Result;
}

fn Parser::ParseCXXTypeid(self) -> ExprResult {
    assert!(self.Tok.is(kw_typeid), "Not 'typeid'!");
    let mut OpLoc: SourceLocation = self.ConsumeToken();
    let mut LParenLoc: SourceLocation = SourceLocation {};
    let mut RParenLoc: SourceLocation = SourceLocation {};
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected_lparen_after, "typeid", unknown) {
        return ExprError();
    }
    LParenLoc = T.getOpenLocation();
    let mut Result: ExprResult = false;
    let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, ReuseLambdaContextDecl, EK_Other };
    if self.isTypeIdInParens() {
        let mut Ty: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
        T.consumeClose();
        RParenLoc = T.getCloseLocation();
        if Ty.isInvalid() || RParenLoc.isInvalid() {
            return ExprError();
        }
        Result = self.Actions.ActOnCXXTypeid(OpLoc, LParenLoc, true, Ty.get().getAsOpaquePtr(), RParenLoc);
    } else {
        Result = self.ParseExpression(AllowNonTypes);
        if Result.isInvalid() {
            self.SkipUntil(r_paren, StopAtSemi);
        } else {
            T.consumeClose();
            RParenLoc = T.getCloseLocation();
            if RParenLoc.isInvalid() {
                return ExprError();
            }
            Result = self.Actions.ActOnCXXTypeid(OpLoc, LParenLoc, false, Result.get(), RParenLoc);
        }
    }
    return Result;
}

fn Parser::ParseCXXUuidof(self) -> ExprResult {
    assert!(self.Tok.is(kw___uuidof), "Not '__uuidof'!");
    let mut OpLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected_lparen_after, "__uuidof", unknown) {
        return ExprError();
    }
    let mut Result: ExprResult = false;
    if self.isTypeIdInParens() {
        let mut Ty: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
        T.consumeClose();
        if Ty.isInvalid() {
            return ExprError();
        }
        Result = self.Actions.ActOnCXXUuidof(OpLoc, T.getOpenLocation(), true, Ty.get().getAsOpaquePtr(), T.getCloseLocation());
    } else {
        let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Other, true };
        Result = self.ParseExpression(AllowNonTypes);
        if Result.isInvalid() {
            self.SkipUntil(r_paren, StopAtSemi);
        } else {
            T.consumeClose();
            Result = self.Actions.ActOnCXXUuidof(OpLoc, T.getOpenLocation(), false, Result.get(), T.getCloseLocation());
        }
    }
    return Result;
}

fn Parser::ParseCXXPseudoDestructor(self, Base: *mut Expr, OpLoc: SourceLocation, OpKind: TokenKind, SS: *mut CXXScopeSpec, ObjectType: ParsedType) -> ExprResult {
    let mut FirstTypeName: UnqualifiedId = UnqualifiedId {};
    let mut CCLoc: SourceLocation = SourceLocation {};
    if self.Tok.is(identifier) {
        FirstTypeName.setIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
        self.ConsumeToken();
        assert!(self.Tok.is(coloncolon), "ParseOptionalCXXScopeSpecifier fail");
        CCLoc = self.ConsumeToken();
    } else if self.Tok.is(annot_template_id) {
        let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
        if TemplateId.isInvalid() {
            return ExprError();
        }
        FirstTypeName.setTemplateId(TemplateId);
        self.ConsumeAnnotationToken();
        assert!(self.Tok.is(coloncolon), "ParseOptionalCXXScopeSpecifier fail");
        CCLoc = self.ConsumeToken();
    } else {
        assert!(SS.isEmpty(), "missing last component of nested name specifier");
        FirstTypeName.setIdentifier(null, SourceLocation {});
    }
    assert!(self.Tok.is(tilde), "ParseOptionalCXXScopeSpecifier fail");
    let mut TildeLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.is(kw_decltype) && !FirstTypeName.isValid() {
        let mut DS: DeclSpec = self.AttrFactory;
        self.ParseDecltypeSpecifier(DS);
        if DS.getTypeSpecType() == TST_error {
            return ExprError();
        }
        return self.Actions.ActOnPseudoDestructorExpr(self.getCurScope(), Base, OpLoc, OpKind, TildeLoc, DS);
    }
    if !self.Tok.is(identifier) {
        self.Diag(self.Tok, err_destructor_tilde_identifier);
        return ExprError();
    }
    if self.GetLookAheadToken(1).is(ellipsis) && self.GetLookAheadToken(2).is(l_square) {
        let mut DS: DeclSpec = self.AttrFactory;
        self.ParsePackIndexingType(DS);
        return self.Actions.ActOnPseudoDestructorExpr(self.getCurScope(), Base, OpLoc, OpKind, TildeLoc, DS);
    }
    let mut SecondTypeName: UnqualifiedId = UnqualifiedId {};
    let mut Name: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut NameLoc: SourceLocation = self.ConsumeToken();
    SecondTypeName.setIdentifier(Name, NameLoc);
    if self.Tok.is(less) && self.ParseUnqualifiedIdTemplateId(SS, ObjectType, Base && Base.containsErrors(), SourceLocation {}, Name, NameLoc, false, SecondTypeName, true) {
        return ExprError();
    }
    return self.Actions.ActOnPseudoDestructorExpr(self.getCurScope(), Base, OpLoc, OpKind, SS, FirstTypeName, CCLoc, TildeLoc, SecondTypeName);
}

fn Parser::ParseCXXBoolLiteral(self) -> ExprResult {
    let mut Kind: TokenKind = self.Tok.getKind();
    return self.Actions.ActOnCXXBoolLiteral(self.ConsumeToken(), Kind);
}

fn Parser::ParseThrowExpression(self) -> ExprResult {
    assert!(self.Tok.is(kw_throw), "Not throw!");
    let mut ThrowLoc: SourceLocation = self.ConsumeToken();
    match self.Tok.getKind() {
        semi => {
            r_paren;
        },
        _ => {
            let mut Expr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
        },
    }
}

fn Parser::ParseCoyieldExpression(self) -> ExprResult {
    assert!(self.Tok.is(kw_co_yield), "Not co_yield!");
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut Expr: ExprResult = if self.Tok.is(l_brace) { self.ParseBraceInitializer() } else { self.ParseAssignmentExpression(AllowNonTypes) };
    if !Expr.isInvalid() {
        Expr = self.Actions.ActOnCoyieldExpr(self.getCurScope(), Loc, Expr.get());
    }
    return Expr;
}

fn Parser::ParseCXXThis(self) -> ExprResult {
    assert!(self.Tok.is(kw_this), "Not 'this'!");
    let mut ThisLoc: SourceLocation = self.ConsumeToken();
    return self.Actions.ActOnCXXThis(ThisLoc);
}

fn Parser::ParseCXXTypeConstructExpression(self, DS: *DeclSpec) -> ExprResult {
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), FunctionalCast };
    let mut TypeRep: ParsedType = self.Actions.ActOnTypeName(DeclaratorInfo).get();
    assert!((self.Tok.is(l_paren) || (self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace))), "Expected '(' or '{'!");
    if self.Tok.is(l_brace) {
        self.PreferredType.enterTypeCast(self.Tok.getLocation(), TypeRep.get());
        let mut Init: ExprResult = self.ParseBraceInitializer();
        if Init.isInvalid() {
            return Init;
        }
        let mut InitList: *mut Expr = Init.get();
        return self.Actions.ActOnCXXTypeConstructExpr(TypeRep, InitList.getBeginLoc(), MultiExprArg { &mut InitList, 1 }, InitList.getEndLoc(), true);
    } else {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        self.PreferredType.enterTypeCast(self.Tok.getLocation(), TypeRep.get());
        let mut Exprs: ExprVector = ExprVector {};
        let mut RunSignatureHelp: Closure_13 = Closure_13 { TypeRep: &mut TypeRep, cap_1: self, DS: &mut DS, Exprs: &mut Exprs, T: &mut T };
        if self.Tok.isNot(r_paren) {
            if self.ParseExpressionList(Exprs, function_ref<void ()> { Closure_14 { cap_0: self, RunSignatureHelp: &mut RunSignatureHelp }, null, null }, false, false) {
                if self.PP.isCodeCompletionReached() && !self.CalledSignatureHelp {
                    RunSignatureHelp.call();
                }
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
        }
        T.consumeClose();
        if !TypeRep {
            return ExprError();
        }
        return self.Actions.ActOnCXXTypeConstructExpr(TypeRep, T.getOpenLocation(), Exprs, T.getCloseLocation(), false);
    }
}

fn Parser::ParseAliasDeclarationInInitStatement(self, Context: DeclaratorContext, Attrs: *mut ParsedAttributes) -> DeclGroupPtrTy {
    assert!(self.Tok.is(kw_using), "Expected using");
    assert!((Context == ForInit || Context == SelectionInit), "Unexpected Declarator Context");
    let mut DG: DeclGroupPtrTy = null;
    let mut DeclStart: SourceLocation = self.ConsumeToken();
    let mut DeclEnd: SourceLocation = SourceLocation {};
    DG = self.ParseUsingDeclaration(Context, ParsedTemplateInfo {}, DeclStart, DeclEnd, Attrs, AS_none);
    if !DG {
        return DG;
    }
    self.DiagCompat(DeclStart, alias_in_init_statement);
    return DG;
}

fn Parser::ParseCondition(self, InitStmt: *mut StmtResult, Loc: SourceLocation, CK: ConditionKind, MissingOK: bool, FRI: *mut ForRangeInfo) -> ConditionResult {
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    self.PreferredType.enterCondition(self.Actions, self.Tok.getLocation());
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteOrdinaryName(self.getCurScope(), PCC_Condition);
        return ConditionError();
    }
    if self.Tok.is(kw___extension__) {
        let mut ExtensionGuard: optional<ExtensionRAIIObject> = optional<ExtensionRAIIObject> {};
        ExtensionGuard.emplace(self.Diags);
        while self.TryConsumeToken(kw___extension__) {
            
        }
    }
    let mut attrs: ParsedAttributes = self.AttrFactory;
    let mut ParsedAttrs: bool = self.MaybeParseCXX11Attributes(attrs, false);
    let mut WarnOnInit: Closure_15 = Closure_15 { cap_0: self, CK: &mut CK };
    if !self.getLangOpts().CPlusPlus {
        if self.isDeclarationStatement(false) && !self.isCXXSimpleDeclaration(false) {
            WarnOnInit.call();
            let mut DG: DeclGroupPtrTy = null;
            let mut DeclStart: SourceLocation = self.Tok.getLocation();
            let mut DeclEnd: SourceLocation = SourceLocation {};
            let mut DeclSpecAttrs: ParsedAttributes = self.AttrFactory;
            DG = self.ParseDeclaration(SelectionInit, DeclEnd, attrs, DeclSpecAttrs, null);
            let mut DeclStmt: StmtResult = self.Actions.ActOnDeclStmt(DG, DeclStart, DeclEnd);
            if InitStmt == null {
                if DeclStmt.isUsable() {
                    self.Diag(DeclStmt.get().getBeginLoc(), err_expected_expression) << DeclStmt.get().getSourceRange();
                } else {
                    self.Diag(DeclStart, err_expected_expression);
                }
            } else {
                *InitStmt = DeclStmt;
            }
            return self.ParseCondition(null, Loc, CK, MissingOK, null);
        }
        if InitStmt && self.Tok.is(semi) {
            let mut Null: StmtResult = self.Actions.ActOnNullStmt(self.ConsumeToken(), false);
            if ParsedAttrs {
                WarnOnInit.call();
                *InitStmt = self.Actions.ActOnAttributedStmt(attrs, Null.get());
            } else {
                self.Diag(Null.get().getBeginLoc(), err_c2y_first_condition_clause_is_not_declaration);
            }
            return self.ParseCondition(null, Loc, CK, MissingOK, null);
        }
    }
    match self.isCXXConditionDeclarationOrInitStatement(InitStmt, FRI) {
        Expression => {
            self.ProhibitAttributes(attrs, SourceLocation {});
            if InitStmt && self.Tok.is(semi) {
                WarnOnInit.call();
                let mut SemiLoc: SourceLocation = self.Tok.getLocation();
                if !self.Tok.hasLeadingEmptyMacro() && !SemiLoc.isMacroID() {
                    self.Diag(SemiLoc, warn_empty_init_statement) << (CK == Switch) << CreateRemoval(SemiLoc);
                }
                self.ConsumeToken();
                *InitStmt = self.Actions.ActOnNullStmt(SemiLoc, false);
                return self.ParseCondition(null, Loc, CK, MissingOK, null);
            }
            let mut Eval: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, CK == ConstexprIf };
            let mut Expr: ExprResult = self.ParseExpression(AllowNonTypes);
            if Expr.isInvalid() {
                return ConditionError();
            }
            if InitStmt && self.Tok.is(semi) {
                WarnOnInit.call();
                *InitStmt = self.Actions.ActOnExprStmt(Expr.get(), true);
                self.ConsumeToken();
                return self.ParseCondition(null, Loc, CK, MissingOK, null);
            }
            return self.Actions.ActOnCondition(self.getCurScope(), Loc, Expr.get(), CK, MissingOK);
        },
        InitStmtDecl => {
            WarnOnInit.call();
            let mut DG: DeclGroupPtrTy = null;
            let mut DeclStart: SourceLocation = self.Tok.getLocation();
            let mut DeclEnd: SourceLocation = SourceLocation {};
            if self.Tok.is(kw_using) {
                DG = self.ParseAliasDeclarationInInitStatement(SelectionInit, attrs);
            } else {
                let mut DeclSpecAttrs: ParsedAttributes = self.AttrFactory;
                DG = self.ParseSimpleDeclaration(SelectionInit, DeclEnd, attrs, DeclSpecAttrs, true, null, null);
            }
            *InitStmt = self.Actions.ActOnDeclStmt(DG, DeclStart, DeclEnd);
            return self.ParseCondition(null, Loc, CK, MissingOK, null);
        },
        ForRangeDecl => {
            assert!(FRI, "should not parse a for range declaration here");
            let mut DeclStart: SourceLocation = self.Tok.getLocation();
            let mut DeclEnd: SourceLocation = SourceLocation {};
            let mut DeclSpecAttrs: ParsedAttributes = self.AttrFactory;
            let mut DG: DeclGroupPtrTy = self.ParseSimpleDeclaration(ForInit, DeclEnd, attrs, DeclSpecAttrs, false, FRI, null);
            FRI.LoopVar = self.Actions.ActOnDeclStmt(DG, DeclStart, self.Tok.getLocation());
            return ConditionResult {};
        },
        ConditionDecl => {
            Error;
        },
    }
    let mut DS: DeclSpec = self.AttrFactory;
    self.ParseSpecifierQualifierList(DS, AS_none, DSC_condition);
    let mut DeclaratorInfo: Declarator = Declarator { DS, attrs, Condition };
    self.ParseDeclarator(DeclaratorInfo);
    if self.Tok.is(kw_asm) {
        let mut Loc: SourceLocation = SourceLocation {};
        let mut AsmLabel: ExprResult = self.ParseSimpleAsm(true, &mut Loc);
        if AsmLabel.isInvalid() {
            self.SkipUntil(semi, StopAtSemi);
            return ConditionError();
        }
        DeclaratorInfo.setAsmLabel(AsmLabel.get());
        DeclaratorInfo.SetRangeEnd(Loc);
    }
    self.MaybeParseGNUAttributes(DeclaratorInfo, null);
    let mut Dcl: DeclResult = self.Actions.ActOnCXXConditionDeclaration(self.getCurScope(), DeclaratorInfo);
    if Dcl.isInvalid() {
        return ConditionError();
    }
    let mut DeclOut: *mut Decl = Dcl.get();
    let mut CopyInitialization: bool = self.isTokenEqualOrEqualTypo();
    if CopyInitialization {
        self.ConsumeToken();
    }
    let mut InitExpr: ExprResult = ExprError();
    if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
        self.Diag(self.Tok.getLocation(), compat_cxx11_generalized_initializer_lists);
        InitExpr = self.ParseBraceInitializer();
    } else if CopyInitialization {
        self.PreferredType.enterVariableInit(self.Tok.getLocation(), DeclOut);
        InitExpr = self.ParseAssignmentExpression(AllowNonTypes);
    } else if self.Tok.is(l_paren) {
        let mut LParen: SourceLocation = self.ConsumeParen();
        let mut RParen: SourceLocation = LParen;
        if self.SkipUntil(r_paren, StopAtSemi | StopBeforeMatch) {
            RParen = self.ConsumeParen();
        }
        self.Diag(DeclOut.getLocation(), err_expected_init_in_condition_lparen) << SourceRange { B: LParen, E: RParen };
    } else {
        self.Diag(DeclOut.getLocation(), err_expected_init_in_condition);
    }
    if !InitExpr.isInvalid() {
        self.Actions.AddInitializerToDecl(DeclOut, InitExpr.get(), !CopyInitialization);
    } else {
        self.Actions.ActOnInitializerError(DeclOut);
    }
    self.Actions.FinalizeDeclaration(DeclOut);
    return self.Actions.ActOnConditionVariable(DeclOut, Loc, CK);
}

fn Parser::ParseCXXSimpleTypeSpecifier(self, DS: *mut DeclSpec) {
    DS.SetRangeStart(self.Tok.getLocation());
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    let mut Loc: SourceLocation = self.Tok.getLocation();
    let mut Policy: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
    match self.Tok.getKind() {
        identifier => {
            coloncolon;
        },
        _ => {
            llvm_unreachable_internal("Not a simple-type-specifier token!", "P:/Goraw/llvm-project/clang/lib/Parse/ParseExprCXX.cpp", 2108);
        },
        annot_typename => {
            DS.SetTypeSpecType(TST_typename, Loc, PrevSpec, DiagID, getTypeAnnotation(self.Tok), Policy);
            DS.SetRangeEnd(self.Tok.getAnnotationEndLoc());
            self.ConsumeAnnotationToken();
            DS.Finish(self.Actions, Policy);
            return;
        },
        kw__ExtInt => {
            kw__BitInt;
        },
        kw_short => {
            DS.SetTypeSpecWidth(Short, Loc, PrevSpec, DiagID, Policy);
        },
        kw_long => {
            DS.SetTypeSpecWidth(Long, Loc, PrevSpec, DiagID, Policy);
        },
        kw___int64 => {
            DS.SetTypeSpecWidth(LongLong, Loc, PrevSpec, DiagID, Policy);
        },
        kw_signed => {
            DS.SetTypeSpecSign(Signed, Loc, PrevSpec, DiagID);
        },
        kw_unsigned => {
            DS.SetTypeSpecSign(Unsigned, Loc, PrevSpec, DiagID);
        },
        kw_void => {
            DS.SetTypeSpecType(TST_void, Loc, PrevSpec, DiagID, Policy);
        },
        kw_auto => {
            DS.SetTypeSpecType(TST_auto, Loc, PrevSpec, DiagID, Policy);
        },
        kw_char => {
            DS.SetTypeSpecType(TST_char, Loc, PrevSpec, DiagID, Policy);
        },
        kw_int => {
            DS.SetTypeSpecType(TST_int, Loc, PrevSpec, DiagID, Policy);
        },
        kw___int128 => {
            DS.SetTypeSpecType(TST_int128, Loc, PrevSpec, DiagID, Policy);
        },
        kw___bf16 => {
            DS.SetTypeSpecType(TST_BFloat16, Loc, PrevSpec, DiagID, Policy);
        },
        kw_half => {
            DS.SetTypeSpecType(TST_half, Loc, PrevSpec, DiagID, Policy);
        },
        kw_float => {
            DS.SetTypeSpecType(TST_float, Loc, PrevSpec, DiagID, Policy);
        },
        kw_double => {
            DS.SetTypeSpecType(TST_double, Loc, PrevSpec, DiagID, Policy);
        },
        kw__Float16 => {
            DS.SetTypeSpecType(TST_float16, Loc, PrevSpec, DiagID, Policy);
        },
        kw___float128 => {
            DS.SetTypeSpecType(TST_float128, Loc, PrevSpec, DiagID, Policy);
        },
        kw___ibm128 => {
            DS.SetTypeSpecType(TST_ibm128, Loc, PrevSpec, DiagID, Policy);
        },
        kw_wchar_t => {
            DS.SetTypeSpecType(TST_wchar, Loc, PrevSpec, DiagID, Policy);
        },
        kw_char8_t => {
            DS.SetTypeSpecType(TST_char8, Loc, PrevSpec, DiagID, Policy);
        },
        kw_char16_t => {
            DS.SetTypeSpecType(TST_char16, Loc, PrevSpec, DiagID, Policy);
        },
        kw_char32_t => {
            DS.SetTypeSpecType(TST_char32, Loc, PrevSpec, DiagID, Policy);
        },
        kw_bool => {
            DS.SetTypeSpecType(TST_bool, Loc, PrevSpec, DiagID, Policy);
        },
        kw__Accum => {
            DS.SetTypeSpecType(TST_accum, Loc, PrevSpec, DiagID, Policy);
        },
        kw__Fract => {
            DS.SetTypeSpecType(TST_fract, Loc, PrevSpec, DiagID, Policy);
        },
        kw__Sat => {
            DS.SetTypeSpecSat(Loc, PrevSpec, DiagID);
        },
        kw_image1d_t => {
            DS.SetTypeSpecType(TST_image1d_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image1d_array_t => {
            DS.SetTypeSpecType(TST_image1d_array_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image1d_buffer_t => {
            DS.SetTypeSpecType(TST_image1d_buffer_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_t => {
            DS.SetTypeSpecType(TST_image2d_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_array_t => {
            DS.SetTypeSpecType(TST_image2d_array_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_depth_t => {
            DS.SetTypeSpecType(TST_image2d_depth_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_array_depth_t => {
            DS.SetTypeSpecType(TST_image2d_array_depth_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_msaa_t => {
            DS.SetTypeSpecType(TST_image2d_msaa_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_array_msaa_t => {
            DS.SetTypeSpecType(TST_image2d_array_msaa_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_msaa_depth_t => {
            DS.SetTypeSpecType(TST_image2d_msaa_depth_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image2d_array_msaa_depth_t => {
            DS.SetTypeSpecType(TST_image2d_array_msaa_depth_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_image3d_t => {
            DS.SetTypeSpecType(TST_image3d_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw___hlsl_resource_t => {
            DS.SetTypeSpecType(TST___hlsl_resource_t, Loc, PrevSpec, DiagID, Policy);
        },
        kw_int8_t4_packed => {
            DS.SetTypeSpecType(TST_int8_t4_packed, Loc, PrevSpec, DiagID, Policy);
        },
        kw_uint8_t4_packed => {
            DS.SetTypeSpecType(TST_uint8_t4_packed, Loc, PrevSpec, DiagID, Policy);
        },
        annot_decltype => {
            kw_decltype;
        },
        annot_pack_indexing_type => {
            DS.SetRangeEnd(self.ParsePackIndexingType(DS));
        },
        kw_typeof => {
            kw_typeof_unqual;
        },
    }
    self.ConsumeAnyToken(false);
    DS.SetRangeEnd(self.PrevTokLocation);
    DS.Finish(self.Actions, Policy);
}

fn Parser::ParseCXXTypeSpecifierSeq(self, DS: *mut DeclSpec, Context: DeclaratorContext) -> bool {
    self.ParseSpecifierQualifierList(DS, AS_none, self.getDeclSpecContextFromDeclaratorContext(Context));
    DS.Finish(self.Actions, self.Actions.getASTContext().getPrintingPolicy());
    return false;
}

fn Parser::ParseUnqualifiedIdTemplateId(self, SS: *mut CXXScopeSpec, ObjectType: ParsedType, ObjectHadErrors: bool, TemplateKWLoc: SourceLocation, Name: *mut IdentifierInfo, NameLoc: SourceLocation, EnteringContext: bool, Id: *mut UnqualifiedId, AssumeTemplateId: bool) -> bool {
    assert!(self.Tok.is(less), "Expected '<' to finish parsing a template-id");
    let mut Template: TemplateTy = null;
    let mut TNK: TemplateNameKind = TNK_Non_template;
    match Id.getKind() {
        IK_Identifier => {
            IK_OperatorFunctionId;
        },
        IK_ConstructorName => {
            let mut TemplateName: UnqualifiedId = UnqualifiedId {};
            let mut MemberOfUnknownSpecialization: bool = false;
            TemplateName.setIdentifier(Name, NameLoc);
            TNK = self.Actions.isTemplateName(self.getCurScope(), SS, TemplateKWLoc.isValid(), TemplateName, ObjectType, EnteringContext, Template, MemberOfUnknownSpecialization, true);
            if TNK == TNK_Non_template {
                return false;
            }
            break;
        },
        IK_DestructorName => {
            let mut TemplateName: UnqualifiedId = UnqualifiedId {};
            let mut MemberOfUnknownSpecialization: bool = false;
            TemplateName.setIdentifier(Name, NameLoc);
            if ObjectType {
                TNK = self.Actions.ActOnTemplateName(self.getCurScope(), SS, TemplateKWLoc, TemplateName, ObjectType, EnteringContext, Template, true);
            } else {
                TNK = self.Actions.isTemplateName(self.getCurScope(), SS, TemplateKWLoc.isValid(), TemplateName, ObjectType, EnteringContext, Template, MemberOfUnknownSpecialization, false);
                if TNK == TNK_Non_template && !Id..DestructorName.get() {
                    self.Diag(NameLoc, err_destructor_template_id) << Name << SS.getRange();
                }
            }
            break;
        },
        _ => {
            return false;
        },
    }
    let mut LAngleLoc: SourceLocation = SourceLocation {};
    let mut RAngleLoc: SourceLocation = SourceLocation {};
    let mut TemplateArgs: TemplateArgList = TemplateArgList {};
    if self.ParseTemplateIdAfterTemplateName(true, LAngleLoc, TemplateArgs, RAngleLoc, Template) {
        return true;
    }
    if TNK == TNK_Non_template {
        return true;
    }
    if Id.getKind() == IK_Identifier || Id.getKind() == IK_OperatorFunctionId || Id.getKind() == IK_LiteralOperatorId {
        let mut TemplateII: *IdentifierInfo = if Id.getKind() == IK_Identifier { Id..Identifier } else { null };
        let mut OpKind: OverloadedOperatorKind = if Id.getKind() == IK_Identifier { OO_None } else { Id..OperatorFunctionId.Operator };
        let mut TemplateId: *mut TemplateIdAnnotation = Create(TemplateKWLoc, Id.StartLocation, TemplateII, OpKind, Template, TNK, LAngleLoc, RAngleLoc, TemplateArgs, false, self.TemplateIds);
        Id.setTemplateId(TemplateId);
        return false;
    }
    let mut TemplateArgsPtr: ASTTemplateArgsPtr = TemplateArgs;
    let mut Type: TypeResult = self.Actions.ActOnTemplateIdType(self.getCurScope(), None, SourceLocation {}, SS, TemplateKWLoc, Template, Name, NameLoc, LAngleLoc, TemplateArgsPtr, RAngleLoc, true, false, No);
    if Type.isInvalid() {
        return true;
    }
    if Id.getKind() == IK_ConstructorName {
        Id.setConstructorName(Type.get(), NameLoc, RAngleLoc);
    } else {
        Id.setDestructorName(Id.StartLocation, Type.get(), RAngleLoc);
    }
    return false;
}

fn Parser::ParseUnqualifiedIdOperator(self, SS: *mut CXXScopeSpec, EnteringContext: bool, ObjectType: ParsedType, Result: *mut UnqualifiedId) -> bool {
    assert!(self.Tok.is(kw_operator), "Expected 'operator' keyword");
    let mut KeywordLoc: SourceLocation = self.ConsumeToken();
    let mut SymbolIdx: u32 = 0;
    let mut SymbolLocations: [3]SourceLocation = [3]SourceLocation {};
    let mut Op: OverloadedOperatorKind = OO_None;
    match self.Tok.getKind() {
        kw_new => {
            kw_delete;
        },
        plus => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        minus => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        star => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        slash => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        percent => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        caret => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        amp => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        pipe => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        tilde => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        exclaim => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        equal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        less => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        greater => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        plusequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        minusequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        starequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        slashequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        percentequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        caretequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        ampequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        pipeequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        lessless => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        greatergreater => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        lesslessequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        greatergreaterequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        equalequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        exclaimequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        lessequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        greaterequal => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        spaceship => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        ampamp => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        pipepipe => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        plusplus => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        minusminus => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        comma => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        arrowstar => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        arrow => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        kw_co_await => {
            SymbolLocations[SymbolIdx += 1] = self.ConsumeToken();
        },
        l_paren => {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
            T.consumeOpen();
            T.consumeClose();
            if T.getCloseLocation().isInvalid() {
                return true;
            }
            SymbolLocations[SymbolIdx += 1] = T.getOpenLocation();
            SymbolLocations[SymbolIdx += 1] = T.getCloseLocation();
            Op = OO_Call;
            break;
        },
        l_square => {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
            T.consumeOpen();
            T.consumeClose();
            if T.getCloseLocation().isInvalid() {
                return true;
            }
            SymbolLocations[SymbolIdx += 1] = T.getOpenLocation();
            SymbolLocations[SymbolIdx += 1] = T.getCloseLocation();
            Op = OO_Subscript;
            break;
        },
        code_completion => {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteOperatorName(self.getCurScope());
            return true;
        },
        lesslessless => {
            let mut TokLoc: SourceLocation = self.Tok.getLocation();
            let mut LessLessLength: u32 = getTokenPrefixLength(TokLoc, 2, self.PP.getSourceManager(), self.getLangOpts());
            let mut LessLessLoc: SourceLocation = self.PP.SplitToken(TokLoc, LessLessLength);
            let mut LessLess: Token = self.Tok;
            LessLess.setLocation(LessLessLoc);
            LessLess.setKind(lessless);
            LessLess.setLength(LessLessLength);
            let mut OldLength: u32 = self.Tok.getLength();
            let mut CachingTokens: bool = self.PP.IsPreviousCachedToken(self.Tok);
            self.Tok.setKind(less);
            self.Tok.setLength(OldLength - LessLessLength);
            self.Tok.setLocation(TokLoc.getLocWithOffset(LessLessLength));
            if CachingTokens {
                self.PP.ReplacePreviousCachedToken([LessLess, self.Tok]);
            }
            SymbolLocations[SymbolIdx += 1] = LessLessLoc;
            Op = OO_LessLess;
            break;
        },
        _ => {
            break;
        },
    }
    if Op != OO_None {
        Result.setOperatorFunctionId(KeywordLoc, Op, SymbolLocations);
        return false;
    }
    if self.getLangOpts().CPlusPlus11 && self.isTokenStringLiteral() {
        self.Diag(self.Tok.getLocation(), warn_cxx98_compat_literal_operator);
        let mut DiagLoc: SourceLocation = SourceLocation {};
        let mut DiagId: u32 = 0;
        let mut Toks: SmallVector<Token, 4> = SmallVector<Token, 4> {};
        let mut TokLocs: SmallVector<SourceLocation, 4> = SmallVector<SourceLocation, 4> {};
        while self.isTokenStringLiteral() {
            if !self.Tok.is(string_literal) && !DiagId {
                DiagLoc = self.Tok.getLocation();
                DiagId = err_literal_operator_string_prefix;
            }
            Toks.push(self.Tok);
            TokLocs.push(self.ConsumeStringToken());
        }
        let mut Literal: StringLiteralParser = StringLiteralParser { Toks, self.PP, Evaluated, CA_NoConversion };
        if Literal.hadError {
            return true;
        }
        let mut IsUDSuffix: bool = !Literal.getUDSuffix().is_empty();
        let mut II: *mut IdentifierInfo = null;
        let mut SuffixLoc: SourceLocation = SourceLocation {};
        if IsUDSuffix {
            II = &mut self.PP.getIdentifierTable().get(Literal.getUDSuffix());
            SuffixLoc = AdvanceToTokenCharacter(TokLocs[Literal.getUDSuffixToken()], Literal.getUDSuffixOffset(), self.PP.getSourceManager(), self.getLangOpts());
        } else if self.Tok.is(identifier) {
            II = self.Tok.getIdentifierInfo();
            SuffixLoc = self.ConsumeToken();
            TokLocs.push(SuffixLoc);
        } else {
            self.Diag(self.Tok.getLocation(), err_expected) << identifier;
            return true;
        }
        if !Literal.GetString().is_empty() || Literal.Pascal {
            DiagLoc = TokLocs.front();
            DiagId = err_literal_operator_string_not_empty;
        }
        if DiagId {
            let mut Str: str = "";
            operator(Str, "\"\"");
            operator(Str, II.getName());
            self.Diag(DiagLoc, DiagId) << CreateReplacement(SourceRange { B: TokLocs.front(), E: TokLocs.back() }, Str.operator StringRef());
        }
        Result.setLiteralOperatorId(II, KeywordLoc, SuffixLoc);
        return self.Actions.checkLiteralOperatorId(SS, Result, IsUDSuffix);
    }
    let mut DS: DeclSpec = self.AttrFactory;
    if self.ParseCXXTypeSpecifierSeq(DS, ConversionId) {
        return true;
    }
    let mut D: Declarator = Declarator { DS, none(), ConversionId };
    self.ParseDeclaratorInternal(D, null);
    let mut Ty: TypeResult = self.Actions.ActOnTypeName(D);
    if Ty.isInvalid() {
        return true;
    }
    Result.setConversionFunctionId(KeywordLoc, Ty.get(), D.getSourceRange().getEnd());
    return false;
}

fn Parser::ParseUnqualifiedId(self, SS: *mut CXXScopeSpec, ObjectType: ParsedType, ObjectHadErrors: bool, EnteringContext: bool, AllowDestructorName: bool, AllowConstructorName: bool, AllowDeductionGuide: bool, TemplateKWLoc: *mut SourceLocation, Result: *mut UnqualifiedId) -> bool {
    if TemplateKWLoc {
        *TemplateKWLoc = SourceLocation {};
    }
    let mut TemplateSpecified: bool = false;
    if self.Tok.is(kw_template) {
        if TemplateKWLoc && (ObjectType || SS.isSet()) {
            TemplateSpecified = true;
            *TemplateKWLoc = self.ConsumeToken();
        } else {
            let mut TemplateLoc: SourceLocation = self.ConsumeToken();
            self.Diag(TemplateLoc, err_unexpected_template_in_unqualified_id) << CreateRemoval(TemplateLoc);
        }
    }
    if self.Tok.is(identifier) {
        self.Tok.getIdentifierInfo();
        let mut IdLoc: SourceLocation = self.ConsumeToken();
        if !self.getLangOpts().CPlusPlus {
            Result.setIdentifier(Id, IdLoc);
            return false;
        }
        let mut TemplateName: ParsedTemplateTy = null;
        if AllowConstructorName && self.Actions.isCurrentClassName(*Id, self.getCurScope(), &mut SS) {
            let mut Ty: ParsedType = self.Actions.getConstructorName(*Id, IdLoc, self.getCurScope(), SS, EnteringContext);
            if !Ty {
                return true;
            }
            Result.setConstructorName(Ty, IdLoc, IdLoc);
        } else if self.getLangOpts().CPlusPlus17 && AllowDeductionGuide && SS.isEmpty() && self.Actions.isDeductionGuideName(self.getCurScope(), *Id, IdLoc, SS, &mut TemplateName) {
            Result.setDeductionGuideName(TemplateName, IdLoc);
        } else {
            Result.setIdentifier(Id, IdLoc);
        }
        let mut Template: TemplateTy = null;
        if self.Tok.is(less) {
            return self.ParseUnqualifiedIdTemplateId(SS, ObjectType, ObjectHadErrors, if TemplateKWLoc { *TemplateKWLoc } else { SourceLocation {} }, Id, IdLoc, EnteringContext, Result, TemplateSpecified);
        }
        if TemplateSpecified {
            let mut TNK: TemplateNameKind = self.Actions.ActOnTemplateName(self.getCurScope(), SS, *TemplateKWLoc, Result, ObjectType, EnteringContext, Template, true);
            if TNK == TNK_Non_template {
                return true;
            }
            if (TNK == TNK_Function_template || TNK == TNK_Dependent_template_name || TNK == TNK_Var_template) && !self.Tok.is(less) {
                self.Diag(IdLoc, missing_template_arg_list_after_template_kw);
            }
        }
        return false;
    }
    if self.Tok.is(annot_template_id) {
        let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
        if TemplateId.isInvalid() {
            self.ConsumeAnnotationToken();
            return true;
        }
        if AllowConstructorName && TemplateId.Name && self.Actions.isCurrentClassName(*TemplateId.Name, self.getCurScope(), &mut SS) {
            if SS.isSet() {
                self.Diag(TemplateId.TemplateNameLoc, err_out_of_line_constructor_template_id) << TemplateId.Name << CreateRemoval(SourceRange { B: TemplateId.LAngleLoc, E: TemplateId.RAngleLoc });
                let mut Ty: ParsedType = self.Actions.getConstructorName(*TemplateId.Name, TemplateId.TemplateNameLoc, self.getCurScope(), SS, EnteringContext);
                if !Ty {
                    return true;
                }
                Result.setConstructorName(Ty, TemplateId.TemplateNameLoc, TemplateId.RAngleLoc);
                self.ConsumeAnnotationToken();
                return false;
            }
            Result.setConstructorTemplateId(TemplateId);
            self.ConsumeAnnotationToken();
            return false;
        }
        Result.setTemplateId(TemplateId);
        let mut TemplateLoc: SourceLocation = TemplateId.TemplateKWLoc;
        if TemplateLoc.isValid() {
            if TemplateKWLoc && (ObjectType || SS.isSet()) {
                *TemplateKWLoc = TemplateLoc;
            } else {
                self.Diag(TemplateLoc, err_unexpected_template_in_unqualified_id) << CreateRemoval(TemplateLoc);
            }
        }
        self.ConsumeAnnotationToken();
        return false;
    }
    if self.Tok.is(kw_operator) {
        if self.ParseUnqualifiedIdOperator(SS, EnteringContext, ObjectType, Result) {
            return true;
        }
        let mut Template: TemplateTy = null;
        if (Result.getKind() == IK_OperatorFunctionId || Result.getKind() == IK_LiteralOperatorId) && self.Tok.is(less) {
            return self.ParseUnqualifiedIdTemplateId(SS, ObjectType, ObjectHadErrors, if TemplateKWLoc { *TemplateKWLoc } else { SourceLocation {} }, null, SourceLocation {}, EnteringContext, Result, TemplateSpecified);
        } else if TemplateSpecified && self.Actions.ActOnTemplateName(self.getCurScope(), SS, *TemplateKWLoc, Result, ObjectType, EnteringContext, Template, true) == TNK_Non_template {
            return true;
        }
        return false;
    }
    if self.getLangOpts().CPlusPlus && (AllowDestructorName || SS.isSet()) && self.Tok.is(tilde) {
        let mut TildeLoc: SourceLocation = self.ConsumeToken();
        if TemplateSpecified {
            self.Diag(*TemplateKWLoc, err_unexpected_template_in_destructor_name) << self.Tok.getLocation();
            return true;
        }
        if SS.isEmpty() && self.Tok.is(kw_decltype) {
            let mut DS: DeclSpec = self.AttrFactory;
            let mut EndLoc: SourceLocation = self.ParseDecltypeSpecifier(DS);
            if self.Actions.getDestructorTypeForDecltype(DS, ObjectType) {
                Type;
            } else {
                Result.setDestructorName(TildeLoc, Type, EndLoc);
                return false;
            }
            return true;
        }
        if self.Tok.isNot(identifier) {
            self.Diag(self.Tok, err_destructor_tilde_identifier);
            return true;
        }
        let mut DeclScopeObj: DeclaratorScopeObj = DeclaratorScopeObj { *self, SS };
        if self.NextToken().is(coloncolon) {
            let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: false };
            if SS.isSet() {
                self.AnnotateScopeToken(SS, true);
                SS.clear();
            }
            if self.ParseOptionalCXXScopeSpecifier(SS, ObjectType, ObjectHadErrors, EnteringContext, null, false, null, false, false, false, false, false) {
                return true;
            }
            if SS.isNotEmpty() {
                ObjectType = null;
            }
            if self.Tok.isNot(identifier) || self.NextToken().is(coloncolon) || !SS.isSet() {
                self.Diag(TildeLoc, err_destructor_tilde_scope);
                return true;
            }
            self.Diag(TildeLoc, err_destructor_tilde_scope) << CreateRemoval(TildeLoc) << CreateInsertion(self.Tok.getLocation(), "~", false);
            if self.Actions.ShouldEnterDeclaratorScope(self.getCurScope(), SS) {
                DeclScopeObj.EnterDeclaratorScope();
            }
        }
        let mut ClassName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut ClassNameLoc: SourceLocation = self.ConsumeToken();
        if self.Tok.is(less) {
            Result.setDestructorName(TildeLoc, null, ClassNameLoc);
            return self.ParseUnqualifiedIdTemplateId(SS, ObjectType, ObjectHadErrors, if TemplateKWLoc { *TemplateKWLoc } else { SourceLocation {} }, ClassName, ClassNameLoc, EnteringContext, Result, TemplateSpecified);
        }
        let mut Ty: ParsedType = self.Actions.getDestructorName(*ClassName, ClassNameLoc, self.getCurScope(), SS, ObjectType, EnteringContext);
        if !Ty {
            return true;
        }
        Result.setDestructorName(TildeLoc, Ty, ClassNameLoc);
        return false;
    }
    match self.Tok.getKind() {
        kw___add_lvalue_reference => {
            kw___add_pointer;
        },
        _ => {
            self.Diag(self.Tok, err_expected_unqualified_id) << self.getLangOpts().CPlusPlus;
        },
    }
}

fn Parser::ParseCXXNewExpression(self, UseGlobal: bool, Start: SourceLocation) -> ExprResult {
    assert!(self.Tok.is(kw_new), "expected 'new' token");
    self.ConsumeToken();
    let mut PlacementArgs: ExprVector = ExprVector {};
    let mut PlacementLParen: SourceLocation = SourceLocation {};
    let mut PlacementRParen: SourceLocation = SourceLocation {};
    let mut TypeIdParens: SourceRange = SourceRange {};
    let mut DS: DeclSpec = self.AttrFactory;
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), CXXNew };
    if self.Tok.is(l_paren) {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        PlacementLParen = T.getOpenLocation();
        if self.ParseExpressionListOrTypeId(PlacementArgs, DeclaratorInfo) {
            self.SkipUntil(semi, StopAtSemi | StopBeforeMatch);
            return ExprError();
        }
        T.consumeClose();
        PlacementRParen = T.getCloseLocation();
        if PlacementRParen.isInvalid() {
            self.SkipUntil(semi, StopAtSemi | StopBeforeMatch);
            return ExprError();
        }
        if PlacementArgs.is_empty() {
            TypeIdParens = T.getRange();
            PlacementLParen = PlacementRParen = SourceLocation {};
        } else {
            if self.Tok.is(l_paren) {
                let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
                T.consumeOpen();
                self.MaybeParseGNUAttributes(DeclaratorInfo, null);
                self.ParseSpecifierQualifierList(DS, AS_none, DSC_normal);
                DeclaratorInfo.SetSourceRange(DS.getSourceRange());
                self.ParseDeclarator(DeclaratorInfo);
                T.consumeClose();
                TypeIdParens = T.getRange();
            } else {
                self.MaybeParseGNUAttributes(DeclaratorInfo, null);
                if self.ParseCXXTypeSpecifierSeq(DS, TypeName) {
                    DeclaratorInfo.setInvalidType(true);
                } else {
                    DeclaratorInfo.SetSourceRange(DS.getSourceRange());
                    self.ParseDeclaratorInternal(DeclaratorInfo, &mut ParseDirectNewDeclarator);
                }
            }
        }
    } else {
        self.MaybeParseGNUAttributes(DeclaratorInfo, null);
        if self.ParseCXXTypeSpecifierSeq(DS, CXXNew) {
            DeclaratorInfo.setInvalidType(true);
        } else {
            DeclaratorInfo.SetSourceRange(DS.getSourceRange());
            self.ParseDeclaratorInternal(DeclaratorInfo, &mut ParseDirectNewDeclarator);
        }
    }
    if DeclaratorInfo.isInvalidType() {
        self.SkipUntil(semi, StopAtSemi | StopBeforeMatch);
        return ExprError();
    }
    let mut Initializer: ExprResult = false;
    if self.Tok.is(l_paren) {
        let mut ConstructorLParen: SourceLocation = SourceLocation {};
        let mut ConstructorRParen: SourceLocation = SourceLocation {};
        let mut ConstructorArgs: ExprVector = ExprVector {};
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        ConstructorLParen = T.getOpenLocation();
        if self.Tok.isNot(r_paren) {
            let mut RunSignatureHelp: Closure_16 = Closure_16 { cap_0: self, DeclaratorInfo: &mut DeclaratorInfo, ConstructorArgs: &mut ConstructorArgs, ConstructorLParen: &mut ConstructorLParen };
            if self.ParseExpressionList(ConstructorArgs, function_ref<void ()> { Closure_17 { cap_0: self, RunSignatureHelp: &mut RunSignatureHelp }, null, null }, false, false) {
                if self.PP.isCodeCompletionReached() && !self.CalledSignatureHelp {
                    RunSignatureHelp.call();
                }
                self.SkipUntil(semi, StopAtSemi | StopBeforeMatch);
                return ExprError();
            }
        }
        T.consumeClose();
        ConstructorRParen = T.getCloseLocation();
        if ConstructorRParen.isInvalid() {
            self.SkipUntil(semi, StopAtSemi | StopBeforeMatch);
            return ExprError();
        }
        Initializer = self.Actions.ActOnParenListExpr(ConstructorLParen, ConstructorRParen, ConstructorArgs);
    } else if self.Tok.is(l_brace) && self.getLangOpts().CPlusPlus11 {
        self.Diag(self.Tok.getLocation(), compat_cxx11_generalized_initializer_lists);
        Initializer = self.ParseBraceInitializer();
    }
    if Initializer.isInvalid() {
        return Initializer;
    }
    return self.Actions.ActOnCXXNew(Start, UseGlobal, PlacementLParen, PlacementArgs, PlacementRParen, TypeIdParens, DeclaratorInfo, Initializer.get());
}

fn Parser::ParseDirectNewDeclarator(self, D: *mut Declarator) {
    let mut First: bool = true;
    while self.Tok.is(l_square) {
        if self.CheckProhibitedCXX11Attribute() {
            continue;
        }
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
        T.consumeOpen();
        let mut Size: ExprResult = if First { (if self.Tok.is(r_square) { ExprResult { false } } else { self.ParseExpression(AllowNonTypes) }) } else { self.ParseConstantExpression() };
        if Size.isInvalid() {
            self.SkipUntil(r_square, StopAtSemi);
            return;
        }
        First = false;
        T.consumeClose();
        let mut Attrs: ParsedAttributes = self.AttrFactory;
        self.MaybeParseCXX11Attributes(Attrs, false);
        D.AddTypeInfo(getArray(0, false, false, Size.get(), T.getOpenLocation(), T.getCloseLocation()), move(Attrs), T.getCloseLocation());
        if T.getCloseLocation().isInvalid() {
            return;
        }
    }
}

fn Parser::ParseExpressionListOrTypeId(self, PlacementArgs: *mut SmallVectorImpl<Expr *>, D: *mut Declarator) -> bool {
    if self.isTypeIdInParens() {
        self.ParseSpecifierQualifierList(D.getMutableDeclSpec(), AS_none, DSC_normal);
        D.SetSourceRange(D.getDeclSpec().getSourceRange());
        self.ParseDeclarator(D);
        return D.isInvalidType();
    }
    return self.ParseExpressionList(PlacementArgs, function_ref<void ()> {}, false, false);
}

fn Parser::ParseCXXDeleteExpression(self, UseGlobal: bool, Start: SourceLocation) -> ExprResult {
    assert!(self.Tok.is(kw_delete), "Expected 'delete' keyword");
    self.ConsumeToken();
    let mut ArrayDelete: bool = false;
    if self.Tok.is(l_square) && self.NextToken().is(r_square) {
        let mut Next: Token = self.GetLookAheadToken(2);
        if Next.isOneOf(l_brace, less) || (Next.is(l_paren) && (self.GetLookAheadToken(3).is(r_paren) || (self.GetLookAheadToken(3).is(identifier) && self.GetLookAheadToken(4).is(identifier)))) {
            let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
            let mut LSquareLoc: SourceLocation = self.Tok.getLocation();
            let mut RSquareLoc: SourceLocation = self.NextToken().getLocation();
            self.SkipUntil([l_brace, less], StopBeforeMatch);
            let mut RBraceLoc: SourceLocation = SourceLocation {};
            let mut EmitFixIt: bool = false;
            if self.Tok.is(l_brace) {
                self.ConsumeBrace();
                self.SkipUntil(r_brace, StopBeforeMatch);
                RBraceLoc = self.Tok.getLocation();
                EmitFixIt = true;
            }
            TPA.Revert();
            if EmitFixIt {
                self.Diag(Start, err_lambda_after_delete) << SourceRange { B: Start, E: RSquareLoc } << CreateInsertion(LSquareLoc, "(", false) << CreateInsertion(getLocForEndOfToken(RBraceLoc, 0, self.Actions.getSourceManager(), self.getLangOpts()), ")", false);
            } else {
                self.Diag(Start, err_lambda_after_delete) << SourceRange { B: Start, E: RSquareLoc };
            }
            let mut Lambda: ExprResult = self.ParseLambdaExpression();
            if Lambda.isInvalid() {
                return ExprError();
            }
            Lambda = self.ParsePostfixExpressionSuffix(Lambda);
            if Lambda.isInvalid() {
                return ExprError();
            }
            return self.Actions.ActOnCXXDelete(Start, UseGlobal, false, Lambda.get());
        }
        ArrayDelete = true;
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
        T.consumeOpen();
        T.consumeClose();
        if T.getCloseLocation().isInvalid() {
            return ExprError();
        }
    }
    let mut Operand: ExprResult = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
    if Operand.isInvalid() {
        return Operand;
    }
    return self.Actions.ActOnCXXDelete(Start, UseGlobal, ArrayDelete, Operand.get());
}

fn Parser::ParseRequiresExpression(self) -> ExprResult {
    assert!(self.Tok.is(kw_requires), "Expected 'requires' keyword");
    let mut RequiresKWLoc: SourceLocation = self.ConsumeToken();
    let mut LocalParameterDecls: SmallVector<ParmVarDecl *, 2> = SmallVector<ParmVarDecl *, 2> {};
    let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if self.Tok.is(l_paren) {
        let mut LocalParametersScope: ParseScope = ParseScope { self, FunctionPrototypeScope | DeclScope, true, false };
        Parens.consumeOpen();
        if !self.Tok.is(r_paren) {
            let mut FirstArgAttrs: ParsedAttributes = self.getAttrFactory();
            let mut EllipsisLoc: SourceLocation = SourceLocation {};
            let mut LocalParameters: ParamInfo, 2> = ParamInfo, 2> {};
            self.ParseParameterDeclarationClause(RequiresExpr, FirstArgAttrs, LocalParameters, EllipsisLoc, false);
            if EllipsisLoc.isValid() {
                self.Diag(EllipsisLoc, err_requires_expr_parameter_list_ellipsis);
            }
            for ParamInfo in LocalParameters {
                LocalParameterDecls.push(cast(ParamInfo.Param));
            }
        }
        Parens.consumeClose();
    }
    let mut Braces: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    if Braces.expectAndConsume(err_expected, "", unknown) {
        return ExprError();
    }
    let mut Requirements: Requirement *, 2> = Requirement *, 2> {};
    let mut Ctx: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Other, true };
    let mut BodyScope: ParseScope = ParseScope { self, DeclScope, true, false };
    let mut ParsingBodyDecl: ParsingDeclRAIIObject = ParsingDeclRAIIObject { *self, NoParent };
    let mut Body: *mut RequiresExprBodyDecl = self.Actions.ActOnStartRequiresExpr(RequiresKWLoc, LocalParameterDecls, self.getCurScope());
    if self.Tok.is(r_brace) {
        self.Diag(self.Tok, err_empty_requires_expr);
    } else {
        while !self.Tok.is(r_brace) {
            match self.Tok.getKind() {
                l_brace => {
                    let mut ExprBraces: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
                    ExprBraces.consumeOpen();
                    let mut Expression: ExprResult = self.ParseExpression(AllowNonTypes);
                    if Expression.isUsable() {
                        Expression = self.Actions.CheckPlaceholderExpr(Expression.get());
                    }
                    if !Expression.isUsable() {
                        ExprBraces.skipToEnd();
                        self.SkipUntil(semi, r_brace, StopBeforeMatch);
                        break;
                    }
                    if ExprBraces.consumeClose() {
                        break;
                    }
                    let mut Req: *mut Requirement = null;
                    let mut NoexceptLoc: SourceLocation = SourceLocation {};
                    self.TryConsumeToken(kw_noexcept, NoexceptLoc);
                    if self.Tok.is(semi) {
                        Req = self.Actions.ActOnCompoundRequirement(Expression.get(), NoexceptLoc);
                        if Req {
                            Requirements.push(Req);
                        }
                        break;
                    }
                    if !self.TryConsumeToken(arrow) {
                        self.Diag(self.Tok, err_requires_expr_missing_arrow) << CreateInsertion(self.Tok.getLocation(), "->", false);
                    }
                    if self.TryAnnotateTypeConstraint() {
                        self.SkipUntil(semi, r_brace, StopBeforeMatch);
                        break;
                    }
                    if !self.isTypeConstraintAnnotation() {
                        self.Diag(self.Tok, err_requires_expr_expected_type_constraint);
                        self.SkipUntil(semi, r_brace, StopBeforeMatch);
                        break;
                    }
                    let mut SS: CXXScopeSpec = CXXScopeSpec {};
                    if self.Tok.is(annot_cxxscope) {
                        self.Actions.RestoreNestedNameSpecifierAnnotation(self.Tok.getAnnotationValue(), self.Tok.getAnnotationRange(), SS);
                        self.ConsumeAnnotationToken();
                    }
                    Req = self.Actions.ActOnCompoundRequirement(Expression.get(), NoexceptLoc, SS, self.takeTemplateIdAnnotation(self.Tok), self.TemplateParameterDepth);
                    self.ConsumeAnnotationToken();
                    if Req {
                        Requirements.push(Req);
                    }
                    break;
                },
                _ => {
                    let mut PossibleRequiresExprInSimpleRequirement: bool = false;
                    if self.Tok.is(kw_requires) {
                        let mut IsNestedRequirement: Closure_18 = Closure_18 { cap_0: self };
                        if IsNestedRequirement.call() {
                            self.ConsumeToken();
                            let mut ConstraintExpr: ExprResult = self.ParseConstraintExpression();
                            if ConstraintExpr.isInvalid() || !ConstraintExpr.isUsable() {
                                self.SkipUntil(semi, r_brace, StopBeforeMatch);
                                break;
                            }
                            if self.Actions.ActOnNestedRequirement(ConstraintExpr.get()) {
                                Req;
                            } else {
                                Requirements.push(Req);
                            }
                            break;
                        } else {
                            PossibleRequiresExprInSimpleRequirement = true;
                        }
                    } else if self.Tok.is(kw_typename) {
                        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
                        let mut TypenameKWLoc: SourceLocation = self.ConsumeToken();
                        if self.TryAnnotateOptionalCXXScopeToken(false) {
                            TPA.Commit();
                            self.SkipUntil(semi, r_brace, StopBeforeMatch);
                            break;
                        }
                        let mut SS: CXXScopeSpec = CXXScopeSpec {};
                        if self.Tok.is(annot_cxxscope) {
                            self.Actions.RestoreNestedNameSpecifierAnnotation(self.Tok.getAnnotationValue(), self.Tok.getAnnotationRange(), SS);
                            self.ConsumeAnnotationToken();
                        }
                        if self.Tok.isOneOf(identifier, annot_template_id) && !self.NextToken().isOneOf(l_brace, l_paren) {
                            TPA.Commit();
                            let mut NameLoc: SourceLocation = self.Tok.getLocation();
                            let mut II: *mut IdentifierInfo = null;
                            let mut TemplateId: *mut TemplateIdAnnotation = null;
                            if self.Tok.is(identifier) {
                                II = self.Tok.getIdentifierInfo();
                                self.ConsumeToken();
                            } else {
                                TemplateId = self.takeTemplateIdAnnotation(self.Tok);
                                self.ConsumeAnnotationToken();
                                if TemplateId.isInvalid() {
                                    break;
                                }
                            }
                            if self.Actions.ActOnTypeRequirement(TypenameKWLoc, SS, NameLoc, II, TemplateId) {
                                Req;
                            } else {
                                Requirements.push(Req);
                            }
                            break;
                        }
                        TPA.Revert();
                    }
                    let mut StartLoc: SourceLocation = self.Tok.getLocation();
                    let mut Expression: ExprResult = self.ParseExpression(AllowNonTypes);
                    if Expression.isUsable() {
                        Expression = self.Actions.CheckPlaceholderExpr(Expression.get());
                    }
                    if !Expression.isUsable() {
                        self.SkipUntil(semi, r_brace, StopBeforeMatch);
                        break;
                    }
                    if !Expression.isInvalid() && PossibleRequiresExprInSimpleRequirement {
                        self.Diag(StartLoc, err_requires_expr_in_simple_requirement) << CreateInsertion(StartLoc, "requires", false);
                    }
                    if self.Actions.ActOnSimpleRequirement(Expression.get()) {
                        Req;
                    } else {
                        Requirements.push(Req);
                    }
                    if self.Tok.is(kw_noexcept) {
                        self.Diag(self.Tok, err_requires_expr_simple_requirement_noexcept) << CreateInsertion(StartLoc, "{", false) << CreateInsertion(self.Tok.getLocation(), "}", false);
                        self.SkipUntil(semi, r_brace, StopBeforeMatch);
                        break;
                    }
                    break;
                },
            }
            if self.ExpectAndConsumeSemi(err_expected_semi_requirement, "") {
                self.SkipUntil(semi, r_brace, StopBeforeMatch);
                self.TryConsumeToken(semi);
                break;
            }
        }
        if Requirements.is_empty() {
            Braces.consumeClose();
            self.Actions.ActOnFinishRequiresExpr();
            return ExprError();
        }
    }
    Braces.consumeClose();
    self.Actions.ActOnFinishRequiresExpr();
    ParsingBodyDecl.complete(Body);
    return self.Actions.ActOnRequiresExpr(RequiresKWLoc, Body, Parens.getOpenLocation(), LocalParameterDecls, Parens.getCloseLocation(), Requirements, Braces.getCloseLocation());
}

