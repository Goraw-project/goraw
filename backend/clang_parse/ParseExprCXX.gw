    assert!(self.Tok.is(tilde), "ParseOptionalCXXScopeSpecifier fail");
    let mut TildeLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.is(kw_decltype) && !FirstTypeName.isValid() {
        let mut DS: DeclSpec = zeroed();
        self.ParseDecltypeSpecifier(DS);
