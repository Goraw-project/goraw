fn Parser::ParseObjCTryStmt(self, atLoc: SourceLocation) -> i32 {
    let mut catch_or_finally_seen: bool = false;
    self.ConsumeToken();
    if self.Tok.isNot(l_brace) {
         << l_brace;
    }
    let mut CatchStmts: StmtVector = zeroed();
    let mut FinallyStmt: i32 = 0;
