}

fn Parser::isSimpleObjCMessageExpression(self) -> bool {
    (((operator!(operator!((self.Tok.is(l_square) && self.getLangOpts() && "Incorrect start for isSimpleObjCMessageExpression")))) || (_wassert(L"Tok.is(tok::l_square) && getLangOpts().ObjC && \"Incorrect start for isSimpleObjCMessageExpression\"", L"clang\\lib\\Parse\\ParseObjc.cpp", (2693) as u32) , 0)) as void);
