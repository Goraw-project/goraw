    self.P.Actions.ObjC().ActOnAtEnd(self.P.getCurScope(), AtEnd, void {}, void {});
    if self.HasCFunction {
        for let mut i: u64 = 0; ; i += 1 {
            self.P.ParseLexedObjCMethodDefs;
        }
    }
    for let mut I: i32 = ; ;  {
        
    }
    self.P.CurParsedObjCImpl = self.PrevParsedObjCImpl;
    self.Finished = true;
}

