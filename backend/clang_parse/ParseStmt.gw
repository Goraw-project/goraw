fn Parser::ParseStatement(self, TrailingElseLoc: *mut SourceLocation, StmtCtx: ParsedStmtContext, PrecedingLabel: *mut LabelDecl) -> StmtResult {
    let mut Res: StmtResult = false;
    let mut Stmts: StmtVector = StmtVector {};
    while true {
        {
        Res = self.ParseStatementOrDeclaration(Stmts, StmtCtx, TrailingElseLoc, PrecedingLabel);
    }
        if !(!Res.isInvalid() && !Res.get()) { break; }
    }
    return Res;
}

fn Parser::ParseStatementOrDeclaration(self, Stmts: *mut StmtVector, StmtCtx: ParsedStmtContext, TrailingElseLoc: *mut SourceLocation, PrecedingLabel: *mut LabelDecl) -> StmtResult {
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    let mut CXX11Attrs: ParsedAttributes = self.AttrFactory;
    let mut HasStdAttr: bool = self.MaybeParseCXX11Attributes(CXX11Attrs, true);
    let mut GNUOrMSAttrs: ParsedAttributes = self.AttrFactory;
    if self.getLangOpts().OpenCL {
        self.MaybeParseGNUAttributes(GNUOrMSAttrs, null);
    }
    if self.getLangOpts().HLSL {
        self.MaybeParseMicrosoftAttributes(GNUOrMSAttrs);
    }
    let mut Res: StmtResult = self.ParseStatementOrDeclarationAfterAttributes(Stmts, StmtCtx, TrailingElseLoc, CXX11Attrs, GNUOrMSAttrs, PrecedingLabel);
    self.MaybeDestroyTemplateIds();
    takeAndConcatenateAttrs(CXX11Attrs, move(GNUOrMSAttrs));
    assert!((CXX11Attrs.is_empty() || Res.isInvalid() || Res.isUsable()), "attributes on empty statement");
    if HasStdAttr && self.getLangOpts().C23 && (StmtCtx & AllowDeclarationsInC) == ParsedStmtContext {} && isa_and_present(Res.get()) {
        self.Diag(CXX11Attrs.Range.getBegin(), warn_attr_in_secondary_block) << CXX11Attrs.Range;
    }
    if CXX11Attrs.is_empty() || Res.isInvalid() {
        return Res;
    }
    return self.Actions.ActOnAttributedStmt(CXX11Attrs, Res.get());
}

struct StatementFilterCCC {
    WantTypeSpecifiers: bool,
    WantExpressionKeywords: bool,
    WantCXXNamedCasts: bool,
    WantFunctionLikeCasts: bool,
    WantRemainingKeywords: bool,
    WantObjCSuper: bool,
    IsObjCIvarLookup: bool,
    IsAddressOfOperand: bool,
    Typo: *IdentifierInfo,
    TypoNNS: NestedNameSpecifier,
    NextToken: Token,
}

fn StatementFilterCCC::StatementFilterCCC(self, nextTok: Token) {
    self.WantTypeSpecifiers = nextTok.isOneOf(l_paren, less, l_square, identifier, star, amp);
    self.WantExpressionKeywords = nextTok.isOneOf(l_paren, identifier, arrow, period);
    self.WantRemainingKeywords = nextTok.isOneOf(l_paren, semi, identifier, l_brace);
    self.WantCXXNamedCasts = false;
}

fn StatementFilterCCC::ValidateCandidate(self, candidate: *TypoCorrection) -> bool {
    if candidate.getCorrectionDeclAs() {
        FD;
    } else {
        return !candidate.getCorrectionSpecifier() || isa(FD);
    }
    if self.NextToken.is(equal) {
        return candidate.getCorrectionDeclAs();
    }
    if self.NextToken.is(period) && candidate.getCorrectionDeclAs() {
        return false;
    }
    return self.ValidateCandidate(candidate);
}

fn StatementFilterCCC::clone(self) -> unique_ptr<CorrectionCandidateCallback> {
    return make_unique(*self);
}

fn StatementFilterCCC::RankCandidate(self, candidate: *TypoCorrection) -> u32 {
    return if (!self.MatchesTypo(candidate) && self.ValidateCandidate(candidate)) { 0 } else { InvalidDistance };
}

fn StatementFilterCCC::setTypoName(self, II: *IdentifierInfo) {
    self.Typo = II;
}

fn StatementFilterCCC::setTypoNNS(self, NNS: NestedNameSpecifier) {
    self.TypoNNS = NNS;
}

fn StatementFilterCCC::MatchesTypo(self, candidate: *TypoCorrection) -> bool {
    return self.Typo && candidate.isResolved() && !candidate.requiresImport() && candidate.getCorrectionAsIdentifierInfo() == self.Typo && candidate.getCorrectionSpecifier() == self.TypoNNS;
}

fn Parser::ParseStatementOrDeclarationAfterAttributes(self, Stmts: *mut StmtVector, StmtCtx: ParsedStmtContext, TrailingElseLoc: *mut SourceLocation, CXX11Attrs: *mut ParsedAttributes, GNUAttrs: *mut ParsedAttributes, PrecedingLabel: *mut LabelDecl) -> StmtResult {
    let mut SemiError: *u8 = null;
    let mut Res: StmtResult = false;
    let mut GNUAttributeLoc: SourceLocation = SourceLocation {};
    self.Tok.getKind();
    let mut AtLoc: SourceLocation = SourceLocation {};
    match Kind {
        at => {
            AtLoc = self.ConsumeToken();
            return self.ParseObjCAtStatement(AtLoc, StmtCtx);
        },
        code_completion => {
            self.cutOffParsing();
        },
        identifier => {
            self.NextToken();
        },
        _ => {
            if self.getLangOpts().CPlusPlus && self.MaybeParseCXX11Attributes(CXX11Attrs, true) {
                
            }
            let mut HaveAttrs: bool = !CXX11Attrs.is_empty() || !GNUAttrs.is_empty();
            let mut IsStmtAttr: Closure_1 = Closure_1 {};
            let mut AllAttrsAreStmtAttrs: bool = all_of(CXX11Attrs, IsStmtAttr) && all_of(GNUAttrs, IsStmtAttr);
            if (self.getLangOpts().CPlusPlus || self.getLangOpts().MicrosoftExt || (StmtCtx & AllowDeclarationsInC) != ) && ((GNUAttributeLoc.isValid() && !(HaveAttrs && AllAttrsAreStmtAttrs)) || self.isDeclarationStatement(false)) {
                let mut DeclStart: SourceLocation = self.Tok.getLocation();
                let mut DeclEnd: SourceLocation = SourceLocation {};
                let mut Decl: DeclGroupPtrTy = null;
                if GNUAttributeLoc.isValid() {
                    DeclStart = GNUAttributeLoc;
                    Decl = self.ParseDeclaration(Block, DeclEnd, CXX11Attrs, GNUAttrs, &mut GNUAttributeLoc);
                } else {
                    Decl = self.ParseDeclaration(Block, DeclEnd, CXX11Attrs, GNUAttrs, null);
                }
                if CXX11Attrs.Range.getBegin().isValid() {
                    DeclStart = if GNUAttrs.Range.getBegin().isInvalid() { CXX11Attrs.Range.getBegin() } else { if CXX11Attrs.Range.getBegin() < GNUAttrs.Range.getBegin() { CXX11Attrs.Range.getBegin() } else { GNUAttrs.Range.getBegin() } };
                } else if GNUAttrs.Range.getBegin().isValid() {
                    DeclStart = GNUAttrs.Range.getBegin();
                }
                return self.Actions.ActOnDeclStmt(Decl, DeclStart, DeclEnd);
            }
            if self.Tok.is(r_brace) {
                self.Diag(self.Tok, err_expected_statement);
                return StmtError();
            }
            match self.Tok.getKind() {
                kw___add_lvalue_reference => {
                    kw___add_pointer;
                },
                _ => {
                    return self.ParseExprStatement(StmtCtx);
                },
            }
        },
        kw___attribute => {
            GNUAttributeLoc = self.Tok.getLocation();
            self.ParseGNUAttributes(GNUAttrs, null, null);
        },
        kw_template => {
            if self.NextToken().is(kw_for) {
                if !self.getLangOpts().CPlusPlus26 {
                    self.Diag(self.Tok.getLocation(), err_expansion_stmt_requires_cxx2c);
                    self.ConsumeToken();
                    return self.ParseForStatement(TrailingElseLoc, PrecedingLabel, null);
                }
                let mut TemplateLoc: SourceLocation = self.ConsumeToken();
                return self.ParseExpansionStatement(TrailingElseLoc, PrecedingLabel, TemplateLoc);
            }
            let mut DeclEnd: SourceLocation = SourceLocation {};
            self.ParseTemplateDeclarationOrSpecialization(Block, DeclEnd, self.getAccessSpecifierIfPresent());
            return StmtError();
        },
        kw_case => {
            return self.ParseCaseStatement(StmtCtx, false, ExprResult { false });
        },
        kw_default => {
            return self.ParseDefaultStatement(StmtCtx);
        },
        l_brace => {
            return self.ParseCompoundStatement(false);
        },
        semi => {
            let mut HasLeadingEmptyMacro: bool = self.Tok.hasLeadingEmptyMacro();
            return self.Actions.ActOnNullStmt(self.ConsumeToken(), HasLeadingEmptyMacro);
        },
        kw_if => {
            return self.ParseIfStatement(TrailingElseLoc);
        },
        kw_switch => {
            return self.ParseSwitchStatement(TrailingElseLoc, PrecedingLabel);
        },
        kw_while => {
            return self.ParseWhileStatement(TrailingElseLoc, PrecedingLabel);
        },
        kw_do => {
            Res = self.ParseDoStatement(PrecedingLabel);
        },
        kw_for => {
            if self.NextToken().is(kw_template) {
                self.Diag(self.Tok.getLocation(), err_for_template) << CreateReplacement(SourceRange { B: self.Tok.getLocation(), E: self.NextToken().getEndLoc() }, "template for");
                self.Tok.setKind(kw_template);
                let mut TemplateLoc: SourceLocation = self.ConsumeToken();
                self.Tok.setKind(kw_for);
                return self.ParseExpansionStatement(TrailingElseLoc, PrecedingLabel, TemplateLoc);
            }
        },
        kw_goto => {
            Res = self.ParseGotoStatement();
        },
        kw_continue => {
            Res = self.ParseContinueStatement();
        },
        kw_break => {
            Res = self.ParseBreakStatement();
        },
        kw_return => {
            Res = self.ParseReturnStatement();
        },
        kw_co_return => {
            Res = self.ParseReturnStatement();
        },
        kw__Defer => {
            return self.ParseDeferStatement(TrailingElseLoc);
        },
        kw_asm => {
            for AL in CXX11Attrs {
                (if AL.isRegularKeywordAttribute() { self.Diag(AL.getRange().getBegin(), err_keyword_not_allowed) } else { self.Diag(AL.getRange().getBegin(), warn_attribute_ignored) }) << AL;
            }
            CXX11Attrs.clear();
            self.ProhibitAttributes(GNUAttrs, SourceLocation {});
            let mut msAsm: bool = false;
            Res = self.ParseAsmStatement(msAsm);
            if msAsm {
                return Res;
            }
            SemiError = "asm";
            break;
        },
        kw___if_exists => {
            kw___if_not_exists;
        },
        kw_try => {
            return self.ParseCXXTryBlock();
        },
        kw___try => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        kw___leave => {
            Res = self.ParseSEHLeaveStatement();
        },
        annot_pragma_vis => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_pack => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_msstruct => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_align => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_weak => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_weakalias => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_redefine_extname => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_fp_contract => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_fp => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_fenv_access => {
            annot_pragma_fenv_access_ms;
        },
        annot_pragma_fenv_round => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_cx_limited_range => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_float_control => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_opencl_extension => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_captured => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_openmp => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_attr_openmp => {
            return self.ParseOpenMPDeclarativeOrExecutableDirective(StmtCtx, false);
        },
        annot_pragma_openacc => {
            return self.ParseOpenACCDirectiveStmt();
        },
        annot_pragma_ms_pointers_to_members => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_ms_pragma => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_ms_vtordisp => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_loop_hint => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_dump => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_attribute => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
        annot_pragma_export => {
            self.ProhibitAttributes(CXX11Attrs, SourceLocation {});
        },
    }
    if !self.TryConsumeToken(semi) && !Res.isInvalid() {
        self.ExpectAndConsume(semi, err_expected_semi_after_stmt, SemiError);
        self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
    }
    return Res;
}

fn Parser::ParseExprStatement(self, StmtCtx: ParsedStmtContext) -> StmtResult {
    let mut OldToken: Token = self.Tok;
    self.ExprStatementTokLoc = self.Tok.getLocation();
    let mut Expr: ExprResult = self.ParseExpression(AllowNonTypes);
    if Expr.isInvalid() {
        self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
        if self.Tok.is(semi) {
            self.ConsumeToken();
        }
        return self.Actions.ActOnExprStmtError();
    }
    if self.Tok.is(colon) && self.getCurScope().isSwitchScope() && self.Actions.CheckCaseExpression(Expr.get()) {
        self.Diag(OldToken, err_expected_case_before_expression) << CreateInsertion(OldToken.getLocation(), "case ", false);
        return self.ParseCaseStatement(StmtCtx, true, Expr);
    }
    let mut CurTok: *mut Token = null;
    if self.Tok.is(annot_repl_input_end) {
        CurTok = &mut self.Tok;
    } else {
        self.ExpectAndConsumeSemi(err_expected_semi_after_expr, "");
    }
    let mut R: StmtResult = self.handleExprStmt(Expr, StmtCtx);
    if CurTok && !R.isInvalid() {
        CurTok.setAnnotationValue(R.get());
    }
    return R;
}

fn Parser::ParseSEHTryBlock(self) -> StmtResult {
    assert!(self.Tok.is(kw___try), "Expected '__try'");
    let mut TryLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.isNot(l_brace) {
        return StmtError(self.Diag(self.Tok, err_expected) << l_brace);
    }
    let mut TryBlock: StmtResult = self.ParseCompoundStatement(false, DeclScope | CompoundStmtScope | SEHTryScope);
    if TryBlock.isInvalid() {
        return TryBlock;
    }
    let mut Handler: StmtResult = false;
    if self.isTokenSEHExcept() {
        let mut Loc: SourceLocation = self.ConsumeToken();
        Handler = self.ParseSEHExceptBlock(Loc);
    } else if self.Tok.is(kw___finally) {
        let mut Loc: SourceLocation = self.ConsumeToken();
        Handler = self.ParseSEHFinallyBlock(Loc);
    } else {
        return StmtError(self.Diag(self.Tok, err_seh_expected_handler));
    }
    if Handler.isInvalid() {
        return Handler;
    }
    return self.Actions.ActOnSEHTryBlock(false, TryLoc, TryBlock.get(), Handler.get());
}

fn Parser::ParseSEHExceptBlock(self, ExceptLoc: SourceLocation) -> StmtResult {
    let mut raii: PoisonIdentifierRAIIObject = PoisonIdentifierRAIIObject { II: self.Ident__exception_code, OldValue: false };
    let mut raii2: PoisonIdentifierRAIIObject = PoisonIdentifierRAIIObject { II: self.Ident___exception_code, OldValue: false };
    let mut raii3: PoisonIdentifierRAIIObject = PoisonIdentifierRAIIObject { II: self.Ident_GetExceptionCode, OldValue: false };
    if self.ExpectAndConsume(l_paren, err_expected, "") {
        return StmtError();
    }
    let mut ExpectScope: ParseScope = ParseScope { self, DeclScope | ControlScope | SEHExceptScope, true, false };
    if self.getLangOpts().Borland {
        self.Ident__exception_info.setIsPoisoned(false);
        self.Ident___exception_info.setIsPoisoned(false);
        self.Ident_GetExceptionInfo.setIsPoisoned(false);
    }
    let mut FilterExpr: ExprResult = false;
    {
        let mut FilterScope: ParseScopeFlags = ParseScopeFlags { self, self.getCurScope().getFlags() | SEHFilterScope, true };
        FilterExpr = self.ParseExpression(AllowNonTypes);
    }
    if self.getLangOpts().Borland {
        self.Ident__exception_info.setIsPoisoned(true);
        self.Ident___exception_info.setIsPoisoned(true);
        self.Ident_GetExceptionInfo.setIsPoisoned(true);
    }
    if FilterExpr.isInvalid() {
        return StmtError();
    }
    if self.ExpectAndConsume(r_paren, err_expected, "") {
        return StmtError();
    }
    if self.Tok.isNot(l_brace) {
        return StmtError(self.Diag(self.Tok, err_expected) << l_brace);
    }
    let mut Block: StmtResult = self.ParseCompoundStatement(false);
    if Block.isInvalid() {
        return Block;
    }
    return self.Actions.ActOnSEHExceptBlock(ExceptLoc, FilterExpr.get(), Block.get());
}

fn Parser::ParseSEHFinallyBlock(self, FinallyLoc: SourceLocation) -> StmtResult {
    let mut raii: PoisonIdentifierRAIIObject = PoisonIdentifierRAIIObject { II: self.Ident__abnormal_termination, OldValue: false };
    let mut raii2: PoisonIdentifierRAIIObject = PoisonIdentifierRAIIObject { II: self.Ident___abnormal_termination, OldValue: false };
    let mut raii3: PoisonIdentifierRAIIObject = PoisonIdentifierRAIIObject { II: self.Ident_AbnormalTermination, OldValue: false };
    if self.Tok.isNot(l_brace) {
        return StmtError(self.Diag(self.Tok, err_expected) << l_brace);
    }
    let mut FinallyScope: ParseScope = ParseScope { self, 0, true, false };
    self.Actions.ActOnStartSEHFinallyBlock();
    let mut Block: StmtResult = self.ParseCompoundStatement(false);
    if Block.isInvalid() {
        self.Actions.ActOnAbortSEHFinallyBlock();
        return Block;
    }
    return self.Actions.ActOnFinishSEHFinallyBlock(FinallyLoc, Block.get());
}

fn Parser::ParseSEHLeaveStatement(self) -> StmtResult {
    let mut LeaveLoc: SourceLocation = self.ConsumeToken();
    return self.Actions.ActOnSEHLeaveStmt(LeaveLoc, self.getCurScope());
}

fn DiagnoseLabelFollowedByDecl(P: *mut Parser, SubStmt: *Stmt) {
    if !P.getLangOpts().CPlusPlus && !P.getLangOpts().MicrosoftExt && isa(SubStmt) {
        P.DiagCompat(SubStmt.getBeginLoc(), label_followed_by_declaration);
    }
}

fn Parser::ParseLabeledStatement(self, Attrs: *mut ParsedAttributes, StmtCtx: ParsedStmtContext) -> StmtResult {
    assert!(self.Tok.is(identifier) && self.Tok.getIdentifierInfo(), "Not an identifier!");
    operator(StmtCtx, operator(AllowStandaloneOpenMPDirectives));
    let mut IdentTok: Token = self.Tok;
    self.ConsumeToken();
    assert!(self.Tok.is(colon), "Not a label!");
    let mut ColonLoc: SourceLocation = self.ConsumeToken();
    let mut LD: *mut LabelDecl = self.Actions.LookupOrCreateLabel(IdentTok.getIdentifierInfo(), IdentTok.getLocation(), SourceLocation {}, true);
    let mut SubStmt: StmtResult = false;
    if self.Tok.is(kw___attribute) {
        let mut TempAttrs: ParsedAttributes = self.AttrFactory;
        self.ParseGNUAttributes(TempAttrs, null, null);
        if !self.getLangOpts().CPlusPlus || self.Tok.is(semi) {
            Attrs.takeAllAppendingFrom(TempAttrs);
        } else {
            let mut Stmts: StmtVector = StmtVector {};
            let mut EmptyCXX11Attrs: ParsedAttributes = self.AttrFactory;
            SubStmt = self.ParseStatementOrDeclarationAfterAttributes(Stmts, StmtCtx, null, EmptyCXX11Attrs, TempAttrs, LD);
            if !TempAttrs.is_empty() && !SubStmt.isInvalid() {
                SubStmt = self.Actions.ActOnAttributedStmt(TempAttrs, SubStmt.get());
            }
        }
    }
    if SubStmt.isUnset() && self.Tok.is(r_brace) {
        self.DiagnoseLabelAtEndOfCompoundStatement();
        SubStmt = self.Actions.ActOnNullStmt(ColonLoc, false);
    }
    if SubStmt.isUnset() {
        SubStmt = self.ParseStatement(null, StmtCtx, LD);
    }
    if SubStmt.isInvalid() {
        SubStmt = self.Actions.ActOnNullStmt(ColonLoc, false);
    }
    DiagnoseLabelFollowedByDecl(*self, SubStmt.get());
    if !LD {
        Attrs.clear();
        return SubStmt.get();
    }
    self.Actions.ProcessDeclAttributeList(self.Actions.CurScope, LD, Attrs, ProcessDeclAttributeOptions {});
    Attrs.clear();
    return self.Actions.ActOnLabelStmt(IdentTok.getLocation(), LD, ColonLoc, SubStmt.get());
}

fn Parser::ParseCaseStatement(self, StmtCtx: ParsedStmtContext, MissingCase: bool, Expr: ExprResult) -> StmtResult {
    assert!((MissingCase || self.Tok.is(kw_case)), "Not a case stmt!");
    operator(StmtCtx, operator(AllowStandaloneOpenMPDirectives));
    let mut TopLevelCase: StmtResult = true;
    let mut DeepestParsedCaseStmt: *mut Stmt = null;
    let mut ColonLoc: SourceLocation = SourceLocation {};
    while true {
        {
        let mut CaseLoc: SourceLocation = if MissingCase { Expr.get().getExprLoc() } else { self.ConsumeToken() };
        ColonLoc = SourceLocation {};
        if self.Tok.is(code_completion) {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteCase(self.getCurScope());
            return StmtError();
        }
        let mut ColonProtection: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        let mut LHS: ExprResult = false;
        if !MissingCase {
            LHS = self.ParseCaseExpression(CaseLoc);
            if LHS.isInvalid() {
                if !self.SkipUntil(colon, r_brace, StopAtSemi | StopBeforeMatch) {
                    return StmtError();
                }
            }
        } else {
            LHS = self.Actions.ActOnCaseExpr(CaseLoc, Expr);
            MissingCase = false;
        }
        let mut DotDotDotLoc: SourceLocation = SourceLocation {};
        let mut RHS: ExprResult = false;
        if self.TryConsumeToken(ellipsis, DotDotDotLoc) {
            let mut DiagId: u32 = 0;
            if self.getLangOpts().CPlusPlus {
                DiagId = ext_gnu_case_range;
            } else if self.getLangOpts().C2y {
                DiagId = warn_c23_compat_case_range;
            } else {
                DiagId = ext_c2y_case_range;
            }
            self.Diag(DotDotDotLoc, DiagId);
            RHS = self.ParseCaseExpression(CaseLoc);
            if RHS.isInvalid() {
                if !self.SkipUntil(colon, r_brace, StopAtSemi | StopBeforeMatch) {
                    return StmtError();
                }
            }
        }
        ColonProtection.restore();
        if self.TryConsumeToken(colon, ColonLoc) {} else if self.TryConsumeToken(semi, ColonLoc) || self.TryConsumeToken(coloncolon, ColonLoc) {
            self.Diag(ColonLoc, err_expected_after) << "'case'" << colon << CreateReplacement(ColonLoc, ":");
        } else {
            let mut ExpectedLoc: SourceLocation = self.getEndOfPreviousToken();
            self.Diag(ExpectedLoc, err_expected_after) << "'case'" << colon << CreateInsertion(ExpectedLoc, ":", false);
            ColonLoc = ExpectedLoc;
        }
        let mut Case: StmtResult = self.Actions.ActOnCaseStmt(CaseLoc, LHS, DotDotDotLoc, RHS, ColonLoc);
        if Case.isInvalid() {
            if TopLevelCase.isInvalid() {
                return self.ParseStatement(null, StmtCtx, null);
            }
        } else {
            let mut NextDeepest: *mut Stmt = Case.get();
            if TopLevelCase.isInvalid() {
                TopLevelCase = Case;
            } else {
                self.Actions.ActOnCaseStmtBody(DeepestParsedCaseStmt, Case.get());
            }
            DeepestParsedCaseStmt = NextDeepest;
        }
    }
        if !(self.Tok.is(kw_case)) { break; }
    }
    let mut SubStmt: StmtResult = false;
    if self.Tok.is(r_brace) {
        self.DiagnoseLabelAtEndOfCompoundStatement();
        SubStmt = self.Actions.ActOnNullStmt(ColonLoc, false);
    } else {
        SubStmt = self.ParseStatement(null, StmtCtx, null);
    }
    if DeepestParsedCaseStmt {
        if SubStmt.isInvalid() {
            SubStmt = self.Actions.ActOnNullStmt(SourceLocation {}, false);
        }
        DiagnoseLabelFollowedByDecl(*self, SubStmt.get());
        self.Actions.ActOnCaseStmtBody(DeepestParsedCaseStmt, SubStmt.get());
    }
    return TopLevelCase;
}

fn Parser::ParseDefaultStatement(self, StmtCtx: ParsedStmtContext) -> StmtResult {
    assert!(self.Tok.is(kw_default), "Not a default stmt!");
    operator(StmtCtx, operator(AllowStandaloneOpenMPDirectives));
    let mut DefaultLoc: SourceLocation = self.ConsumeToken();
    let mut ColonLoc: SourceLocation = SourceLocation {};
    if self.TryConsumeToken(colon, ColonLoc) {} else if self.TryConsumeToken(semi, ColonLoc) {
        self.Diag(ColonLoc, err_expected_after) << "'default'" << colon << CreateReplacement(ColonLoc, ":");
    } else {
        let mut ExpectedLoc: SourceLocation = self.PP.getLocForEndOfToken(self.PrevTokLocation, 0);
        self.Diag(ExpectedLoc, err_expected_after) << "'default'" << colon << CreateInsertion(ExpectedLoc, ":", false);
        ColonLoc = ExpectedLoc;
    }
    let mut SubStmt: StmtResult = false;
    if self.Tok.is(r_brace) {
        self.DiagnoseLabelAtEndOfCompoundStatement();
        SubStmt = self.Actions.ActOnNullStmt(ColonLoc, false);
    } else {
        SubStmt = self.ParseStatement(null, StmtCtx, null);
    }
    if SubStmt.isInvalid() {
        SubStmt = self.Actions.ActOnNullStmt(ColonLoc, false);
    }
    DiagnoseLabelFollowedByDecl(*self, SubStmt.get());
    return self.Actions.ActOnDefaultStmt(DefaultLoc, ColonLoc, SubStmt.get(), self.getCurScope());
}

fn Parser::ParseCompoundStatement(self, isStmtExpr: bool) -> StmtResult {
    return self.ParseCompoundStatement(isStmtExpr, DeclScope | CompoundStmtScope);
}

fn Parser::ParseCompoundStatement(self, isStmtExpr: bool, ScopeFlags: u32) -> StmtResult {
    assert!(self.Tok.is(l_brace), "Not a compound stmt!");
    let mut CompoundScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    let mut R: StmtResult = false;
    self.StackHandler.runWithSufficientStackSpace(self.Tok.getLocation(), function_ref<void ()> { Closure_2 { cap_0: self, R: &mut R, isStmtExpr: &mut isStmtExpr }, null, null });
    return R;
}

fn Parser::ParseCompoundStatementLeadingPragmas(self) {
    let mut checkForPragmas: bool = true;
    while checkForPragmas {
        match self.Tok.getKind() {
            annot_pragma_vis => {
                self.HandlePragmaVisibility();
            },
            annot_pragma_pack => {
                self.HandlePragmaPack();
            },
            annot_pragma_msstruct => {
                self.HandlePragmaMSStruct();
            },
            annot_pragma_align => {
                self.HandlePragmaAlign();
            },
            annot_pragma_weak => {
                self.HandlePragmaWeak();
            },
            annot_pragma_weakalias => {
                self.HandlePragmaWeakAlias();
            },
            annot_pragma_redefine_extname => {
                self.HandlePragmaRedefineExtname();
            },
            annot_pragma_opencl_extension => {
                self.HandlePragmaOpenCLExtension();
            },
            annot_pragma_fp_contract => {
                self.HandlePragmaFPContract();
            },
            annot_pragma_fp => {
                self.HandlePragmaFP();
            },
            annot_pragma_fenv_access => {
                annot_pragma_fenv_access_ms;
            },
            annot_pragma_fenv_round => {
                self.HandlePragmaFEnvRound();
            },
            annot_pragma_cx_limited_range => {
                self.HandlePragmaCXLimitedRange();
            },
            annot_pragma_float_control => {
                self.HandlePragmaFloatControl();
            },
            annot_pragma_ms_pointers_to_members => {
                self.HandlePragmaMSPointersToMembers();
            },
            annot_pragma_ms_pragma => {
                self.HandlePragmaMSPragma();
            },
            annot_pragma_ms_vtordisp => {
                self.HandlePragmaMSVtorDisp();
            },
            annot_pragma_dump => {
                self.HandlePragmaDump();
            },
            annot_pragma_export => {
                self.HandlePragmaExport();
            },
            _ => {
                checkForPragmas = false;
            },
        }
    }
}

fn Parser::DiagnoseLabelAtEndOfCompoundStatement(self) {
    self.DiagCompat(self.Tok, if self.getLangOpts().CPlusPlus { cxx_label_at_end_of_compound_statement } else { c_label_at_end_of_compound_statement });
}

fn Parser::ConsumeNullStmt(self, Stmts: *mut StmtVector) -> bool {
    if !self.Tok.is(semi) {
        return false;
    }
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = SourceLocation {};
    while self.Tok.is(semi) && !self.Tok.hasLeadingEmptyMacro() && self.Tok.getLocation().isValid() && !self.Tok.getLocation().isMacroID() {
        EndLoc = self.Tok.getLocation();
        let mut R: StmtResult = self.ParseStatementOrDeclaration(Stmts, SubStmt, null, null);
        if R.isUsable() {
            Stmts.push(R.get());
        }
    }
    if EndLoc.isInvalid() {
        return false;
    }
    self.Diag(StartLoc, warn_null_statement) << CreateRemoval(SourceRange { B: StartLoc, E: EndLoc });
    return true;
}

fn Parser::handleExprStmt(self, E: ExprResult, StmtCtx: ParsedStmtContext) -> StmtResult {
    let mut IsStmtExprResult: bool = false;
    if (StmtCtx & InStmtExpr) !=  {
        IsStmtExprResult = self.Tok.is(r_brace) && self.NextToken().is(r_paren);
    }
    if IsStmtExprResult {
        E = self.Actions.ActOnStmtExprResult(E);
    }
    return self.Actions.ActOnExprStmt(E, !IsStmtExprResult);
}

fn Parser::ParseCompoundStatementBody(self, isStmtExpr: bool) -> StmtResult {
    let mut CrashInfo: PrettyStackTraceLoc = PrettyStackTraceLoc { self.PP.getSourceManager(), self.Tok.getLocation(), "in compound statement ('{}')" };
    let mut SaveFPFeatures: FPFeaturesStateRAII = self.Actions;
    let mut InMessage: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: false };
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    if T.consumeOpen() {
        return StmtError();
    }
    let mut CompoundScope: CompoundScopeRAII = CompoundScopeRAII { self.Actions, isStmtExpr };
    self.ParseCompoundStatementLeadingPragmas();
    self.Actions.ActOnAfterCompoundStatementLeadingPragmas();
    let mut Stmts: StmtVector = StmtVector {};
    while self.Tok.is(kw___label__) {
        let mut LabelLoc: SourceLocation = self.ConsumeToken();
        let mut DeclsInGroup: SmallVector<Decl *, 4> = SmallVector<Decl *, 4> {};
        while true {
            if self.Tok.isNot(identifier) {
                self.Diag(self.Tok, err_expected) << identifier;
                break;
            }
            let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            let mut IdLoc: SourceLocation = self.ConsumeToken();
            DeclsInGroup.push(self.Actions.LookupOrCreateLabel(II, IdLoc, LabelLoc, false));
            if !self.TryConsumeToken(comma) {
                break;
            }
        }
        let mut DS: DeclSpec = self.AttrFactory;
        let mut Res: DeclGroupPtrTy = self.Actions.FinalizeDeclaratorGroup(self.getCurScope(), DS, DeclsInGroup);
        let mut R: StmtResult = self.Actions.ActOnDeclStmt(Res, LabelLoc, self.Tok.getLocation());
        self.ExpectAndConsumeSemi(err_expected_semi_declaration, "");
        if R.isUsable() {
            Stmts.push(R.get());
        }
    }
    let mut SubStmtCtx: ParsedStmtContext = Compound | (if isStmtExpr { InStmtExpr } else {  });
    let mut LastIsError: bool = false;
    while !self.tryParseMisplacedModuleImport() && self.Tok.isNot(r_brace) && self.Tok.isNot(eof) {
        if self.Tok.is(annot_pragma_unused) {
            self.HandlePragmaUnused();
            continue;
        }
        if self.ConsumeNullStmt(Stmts) {
            continue;
        }
        let mut R: StmtResult = false;
        if self.Tok.isNot(kw___extension__) {
            R = self.ParseStatementOrDeclaration(Stmts, SubStmtCtx, null, null);
        } else {
            let mut ExtLoc: SourceLocation = self.ConsumeToken();
            while self.Tok.is(kw___extension__) {
                self.ConsumeToken();
            }
            let mut attrs: ParsedAttributes = self.AttrFactory;
            self.MaybeParseCXX11Attributes(attrs, true);
            if self.isDeclarationStatement(false) {
                let mut O: ExtensionRAIIObject = self.Diags;
                let mut DeclStart: SourceLocation = self.Tok.getLocation();
                let mut DeclEnd: SourceLocation = SourceLocation {};
                let mut DeclSpecAttrs: ParsedAttributes = self.AttrFactory;
                let mut Res: DeclGroupPtrTy = self.ParseDeclaration(Block, DeclEnd, attrs, DeclSpecAttrs, null);
                R = self.Actions.ActOnDeclStmt(Res, DeclStart, DeclEnd);
            } else {
                let mut Res: ExprResult = self.ParseExpressionWithLeadingExtension(ExtLoc);
                if Res.isInvalid() {
                    self.SkipUntil(semi, 0 as SkipUntilFlags);
                    continue;
                }
                self.ExpectAndConsumeSemi(err_expected_semi_after_expr, "");
                R = self.handleExprStmt(Res, SubStmtCtx);
                if R.isUsable() {
                    R = self.Actions.ActOnAttributedStmt(attrs, R.get());
                }
            }
        }
        if R.isUsable() {
            Stmts.push(R.get());
        }
        LastIsError = R.isInvalid();
    }
    if isStmtExpr && LastIsError && !Stmts.is_empty() {
        return StmtError();
    }
    if !self.PP.getTargetInfo().supportSourceEvalMethod() && (self.PP.getLastFPEvalPragmaLocation().isValid() || self.PP.getCurrentFPEvalMethod() == FEM_Source) {
        self.Diag(self.Tok.getLocation(), warn_no_support_for_eval_method_source_on_m32);
    }
    let mut CloseLoc: SourceLocation = self.Tok.getLocation();
    if !T.consumeClose() {
        if isStmtExpr && self.Tok.is(r_paren) {
            self.checkCompoundToken(CloseLoc, r_brace, StmtExprEnd);
        }
    } else {}
    if T.getCloseLocation().isValid() {
        CloseLoc = T.getCloseLocation();
    }
    return self.Actions.ActOnCompoundStmt(T.getOpenLocation(), CloseLoc, Stmts, isStmtExpr);
}

fn Parser::ParseParenExprOrCondition(self, InitStmt: *mut StmtResult, Cond: *mut ConditionResult, Loc: SourceLocation, CK: ConditionKind, LParenLoc: *mut SourceLocation, RParenLoc: *mut SourceLocation) -> bool {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    T.consumeOpen();
    let mut Start: SourceLocation = self.Tok.getLocation();
    Cond = self.ParseCondition(InitStmt, Loc, CK, false, null);
    if Cond.isInvalid() && self.Tok.isNot(r_paren) {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        if self.Tok.isNot(r_paren) {
            return true;
        }
    }
    if Cond.isInvalid() {
        let mut CondExpr: ExprResult = self.Actions.CreateRecoveryExpr(Start, if self.Tok.getLocation() == Start { Start } else { self.PrevTokLocation }, ArrayRef<Expr *> {}, self.Actions.PreferredConditionType(CK));
        if !CondExpr.isInvalid() {
            Cond = self.Actions.ActOnCondition(self.getCurScope(), Loc, CondExpr.get(), CK, false);
        }
    }
    if !self.getLangOpts().CPlusPlus {
        if InitStmt != null && InitStmt.isUsable() {
            if !isa(InitStmt.get()) {
                self.Diag(InitStmt.get().getBeginLoc(), err_c2y_first_condition_clause_is_not_declaration) << InitStmt.get().getSourceRange();
            }
            if Cond.get().first != null {
                self.Diag(Cond.get().first.getBeginLoc(), err_expected_expression) << Cond.get().first.getSourceRange();
            }
        } else if Cond.get().first != null {
            self.DiagCompat(Cond.get().first.getBeginLoc(), decl_statement) << (CK == Switch);
        }
    }
    if self.Tok.is(comma) {
        self.Diag(self.Tok, err_c2y_multiple_declarations);
        while self.Tok.isNot(r_paren) && !self.Tok.is(eof) {
            self.ConsumeAnyToken(false);
        }
    }
    T.consumeClose();
    LParenLoc = T.getOpenLocation();
    RParenLoc = T.getCloseLocation();
    while self.Tok.is(r_paren) {
        self.Diag(self.Tok, err_extraneous_rparen_in_condition) << CreateRemoval(self.Tok.getLocation());
        self.ConsumeParen();
    }
    return false;
}

enum MisleadingStatementKind {
    MSK_if = 0,
    MSK_else = 1,
    MSK_for = 2,
    MSK_while = 3,
}

struct MisleadingIndentationChecker {
    P: *mut Parser,
    StmtLoc: SourceLocation,
    PrevLoc: SourceLocation,
    NumDirectives: u32,
    Kind: MisleadingStatementKind,
    ShouldSkip: bool,
}

fn MisleadingIndentationChecker::MisleadingIndentationChecker(self, P: *mut Parser, K: MisleadingStatementKind, SL: SourceLocation) {
    if !P.MisleadingIndentationElseLoc.isInvalid() {
        self.StmtLoc = P.MisleadingIndentationElseLoc;
        P.MisleadingIndentationElseLoc = SourceLocation {};
    }
    if self.Kind == MSK_else && !self.ShouldSkip {
        P.MisleadingIndentationElseLoc = SL;
    }
}

fn MisleadingIndentationChecker::getVisualIndentation(self, SM: *mut SourceManager, Loc: SourceLocation) -> u32 {
    let mut TabStop: u32 = SM.getDiagnostics().getDiagnosticOptions().TabStop;
    let mut ColNo: u32 = SM.getSpellingColumnNumber(Loc, null);
    if ColNo == 0 || TabStop == 1 {
        return ColNo;
    }
    let mut FIDAndOffset: FileIDAndOffset = SM.getDecomposedLoc(Loc);
    let mut Invalid: bool = false;
    let mut BufData: str = SM.getBufferData(FIDAndOffset.first, &mut Invalid);
    if Invalid {
        return 0;
    }
    let mut EndPos: *u8 = BufData.ptr + FIDAndOffset.second;
    assert!(FIDAndOffset.second + 1 >= ColNo, "Column number smaller than file offset?");
    let mut VisualColumn: u32 = 0;
    for let mut CurPos: *u8 = EndPos - (ColNo - 1); CurPos != EndPos; CurPos += 1 {
        if *CurPos == 9 {
            VisualColumn += (TabStop - VisualColumn % TabStop);
        } else {
            VisualColumn += 1;
        }
    }
    return VisualColumn + 1;
}

fn MisleadingIndentationChecker::Check(self) {
    let mut Tok: Token = self.P.getCurToken();
    if self.P.getActions().getDiagnostics().isIgnored(warn_misleading_indentation, Tok.getLocation()) || self.ShouldSkip || self.NumDirectives != self.P.getPreprocessor().getNumDirectives() || Tok.isOneOf(semi, r_brace) || Tok.isAnnotation() || Tok.getLocation().isMacroID() || self.PrevLoc.isMacroID() || self.StmtLoc.isMacroID() || (self.Kind == MSK_else && self.P.MisleadingIndentationElseLoc.isInvalid()) {
        self.P.MisleadingIndentationElseLoc = SourceLocation {};
        return;
    }
    if self.Kind == MSK_else {
        self.P.MisleadingIndentationElseLoc = SourceLocation {};
    }
    let mut SM: *mut SourceManager = self.P.getPreprocessor().getSourceManager();
    let mut PrevColNum: u32 = getVisualIndentation(SM, self.PrevLoc);
    let mut CurColNum: u32 = getVisualIndentation(SM, Tok.getLocation());
    let mut StmtColNum: u32 = getVisualIndentation(SM, self.StmtLoc);
    if PrevColNum != 0 && CurColNum != 0 && StmtColNum != 0 && ((PrevColNum > StmtColNum && PrevColNum == CurColNum) || !Tok.isAtStartOfLine()) && SM.getPresumedLineNumber(self.StmtLoc, null) != SM.getPresumedLineNumber(Tok.getLocation(), null) && (Tok.isNot(identifier) || self.P.getPreprocessor().LookAhead(0).isNot(colon)) {
        self.P.Diag(Tok.getLocation(), warn_misleading_indentation) << self.Kind;
        self.P.Diag(self.StmtLoc, note_previous_statement);
    }
}

fn Parser::ParseIfStatement(self, TrailingElseLoc: *mut SourceLocation) -> StmtResult {
    assert!(self.Tok.is(kw_if), "Not an if stmt!");
    let mut IfLoc: SourceLocation = self.ConsumeToken();
    let mut IsConstexpr: bool = false;
    let mut IsConsteval: bool = false;
    let mut NotLocation: SourceLocation = SourceLocation {};
    let mut ConstevalLoc: SourceLocation = SourceLocation {};
    if self.Tok.is(kw_constexpr) {
        if self.getLangOpts().CPlusPlus {
            self.DiagCompat(self.Tok, constexpr_if);
            IsConstexpr = true;
            self.ConsumeToken();
        }
    } else {
        if self.Tok.is(exclaim) {
            NotLocation = self.ConsumeToken();
        }
        if self.Tok.is(kw_consteval) {
            self.DiagCompat(self.Tok, consteval_if);
            IsConsteval = true;
            ConstevalLoc = self.ConsumeToken();
        } else if self.Tok.is(code_completion) {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteKeywordAfterIf(NotLocation.isValid());
            return StmtError();
        }
    }
    if !IsConsteval && (NotLocation.isValid() || self.Tok.isNot(l_paren)) {
        self.Diag(self.Tok, err_expected_lparen_after) << "if";
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return StmtError();
    }
    let mut C99orCXX: bool = self.getLangOpts().C99 || self.getLangOpts().CPlusPlus;
    let mut IfScope: ParseScope = ParseScope { self, DeclScope | ControlScope, C99orCXX, false };
    let mut InitStmt: StmtResult = false;
    let mut Cond: ConditionResult = ConditionResult {};
    let mut LParen: SourceLocation = SourceLocation {};
    let mut RParen: SourceLocation = SourceLocation {};
    let mut ConstexprCondition: optional<bool> = optional<bool> {};
    if !IsConsteval {
        if self.ParseParenExprOrCondition(&mut InitStmt, Cond, IfLoc, if IsConstexpr { ConstexprIf } else { Boolean }, LParen, RParen) {
            return StmtError();
        }
        if IsConstexpr {
            ConstexprCondition = Cond.getKnownValue();
        }
    }
    let mut IsBracedThen: bool = self.Tok.is(l_brace);
    let mut InnerScope: ParseScope = ParseScope { self, DeclScope, C99orCXX, IsBracedThen };
    let mut MIChecker: MisleadingIndentationChecker = MisleadingIndentationChecker { *self, MSK_if, IfLoc };
    let mut ThenStmtLoc: SourceLocation = self.Tok.getLocation();
    let mut InnerStatementTrailingElseLoc: SourceLocation = SourceLocation {};
    let mut ThenStmt: StmtResult = false;
    {
        let mut ShouldEnter: bool = ConstexprCondition && !operator(ConstexprCondition);
        let mut Context: ExpressionEvaluationContext = DiscardedStatement;
        if NotLocation.isInvalid() && IsConsteval {
            Context = ImmediateFunctionContext;
            ShouldEnter = true;
        }
        let mut PotentiallyDiscarded: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Context, null, EK_Other, ShouldEnter };
        ThenStmt = self.ParseStatement(&mut InnerStatementTrailingElseLoc, SubStmt, null);
    }
    if self.Tok.isNot(kw_else) {
        MIChecker.Check();
    }
    InnerScope.Exit();
    let mut ElseLoc: SourceLocation = SourceLocation {};
    let mut ElseStmtLoc: SourceLocation = SourceLocation {};
    let mut ElseStmt: StmtResult = false;
    if self.Tok.is(kw_else) {
        if TrailingElseLoc {
            *TrailingElseLoc = self.Tok.getLocation();
        }
        ElseLoc = self.ConsumeToken();
        ElseStmtLoc = self.Tok.getLocation();
        let mut InnerScope: ParseScope = ParseScope { self, DeclScope, C99orCXX, self.Tok.is(l_brace) };
        let mut MIChecker: MisleadingIndentationChecker = MisleadingIndentationChecker { *self, MSK_else, ElseLoc };
        let mut ShouldEnter: bool = ConstexprCondition && operator(ConstexprCondition);
        let mut Context: ExpressionEvaluationContext = DiscardedStatement;
        if NotLocation.isValid() && IsConsteval {
            Context = ImmediateFunctionContext;
            ShouldEnter = true;
        }
        let mut PotentiallyDiscarded: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Context, null, EK_Other, ShouldEnter };
        ElseStmt = self.ParseStatement(null, SubStmt, null);
        if ElseStmt.isUsable() {
            MIChecker.Check();
        }
        InnerScope.Exit();
    } else if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteAfterIf(self.getCurScope(), IsBracedThen);
        return StmtError();
    } else if InnerStatementTrailingElseLoc.isValid() {
        self.Diag(InnerStatementTrailingElseLoc, warn_dangling_else);
    }
    IfScope.Exit();
    if (ThenStmt.isInvalid() && ElseStmt.isInvalid()) || (ThenStmt.isInvalid() && ElseStmt.get() == null) || (ThenStmt.get() == null && ElseStmt.isInvalid()) {
        return StmtError();
    }
    if IsConsteval {
        let mut IsCompoundStatement: Closure_3 = Closure_3 {};
        if !IsCompoundStatement.call(ThenStmt.get()) {
            self.Diag(ConstevalLoc, err_expected_after) << "consteval" << "{";
            return StmtError();
        }
        if !ElseStmt.isUnset() && !IsCompoundStatement.call(ElseStmt.get()) {
            self.Diag(ElseLoc, err_expected_after) << "else" << "{";
            return StmtError();
        }
    }
    if ThenStmt.isInvalid() {
        ThenStmt = self.Actions.ActOnNullStmt(ThenStmtLoc, false);
    }
    if ElseStmt.isInvalid() {
        ElseStmt = self.Actions.ActOnNullStmt(ElseStmtLoc, false);
    }
    let mut Kind: IfStatementKind = Ordinary;
    if IsConstexpr {
        Kind = Constexpr;
    } else if IsConsteval {
        Kind = if NotLocation.isValid() { ConstevalNegated } else { ConstevalNonNegated };
    }
    return self.Actions.ActOnIfStmt(IfLoc, Kind, LParen, InitStmt.get(), Cond, RParen, ThenStmt.get(), ElseLoc, ElseStmt.get());
}

fn Parser::ParseSwitchStatement(self, TrailingElseLoc: *mut SourceLocation, PrecedingLabel: *mut LabelDecl) -> StmtResult {
    assert!(self.Tok.is(kw_switch), "Not a switch stmt!");
    let mut SwitchLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.isNot(l_paren) {
        self.Diag(self.Tok, err_expected_lparen_after) << "switch";
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return StmtError();
    }
    let mut C99orCXX: bool = self.getLangOpts().C99 || self.getLangOpts().CPlusPlus;
    let mut ScopeFlags: u32 = SwitchScope;
    if C99orCXX {
        ScopeFlags |= DeclScope | ControlScope;
    }
    let mut SwitchScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    let mut InitStmt: StmtResult = false;
    let mut Cond: ConditionResult = ConditionResult {};
    let mut LParen: SourceLocation = SourceLocation {};
    let mut RParen: SourceLocation = SourceLocation {};
    if self.ParseParenExprOrCondition(&mut InitStmt, Cond, SwitchLoc, Switch, LParen, RParen) {
        return StmtError();
    }
    let mut Switch: StmtResult = self.Actions.ActOnStartOfSwitchStmt(SwitchLoc, LParen, InitStmt.get(), Cond, RParen);
    if Switch.isInvalid() {
        if self.Tok.is(l_brace) {
            self.ConsumeBrace();
            self.SkipUntil(r_brace, 0 as SkipUntilFlags);
        } else {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
        }
        return Switch;
    }
    self.getCurScope().EnterSwitchBody(PrecedingLabel);
    let mut InnerScope: ParseScope = ParseScope { self, DeclScope, C99orCXX, self.Tok.is(l_brace) };
    if C99orCXX {
        self.getCurScope().decrementMSManglingNumber();
    }
    let mut Body: StmtResult = self.ParseStatement(TrailingElseLoc, SubStmt, null);
    InnerScope.Exit();
    SwitchScope.Exit();
    return self.Actions.ActOnFinishSwitchStmt(SwitchLoc, Switch.get(), Body.get());
}

fn Parser::ParseWhileStatement(self, TrailingElseLoc: *mut SourceLocation, PrecedingLabel: *mut LabelDecl) -> StmtResult {
    assert!(self.Tok.is(kw_while), "Not a while stmt!");
    let mut WhileLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeToken();
    if self.Tok.isNot(l_paren) {
        self.Diag(self.Tok, err_expected_lparen_after) << "while";
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return StmtError();
    }
    let mut C99orCXX: bool = self.getLangOpts().C99 || self.getLangOpts().CPlusPlus;
    let mut ScopeFlags: u32 = ControlScope | (if C99orCXX { DeclScope } else { NoScope });
    let mut WhileScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    let mut Cond: ConditionResult = ConditionResult {};
    let mut LParen: SourceLocation = SourceLocation {};
    let mut RParen: SourceLocation = SourceLocation {};
    if self.ParseParenExprOrCondition(null, Cond, WhileLoc, Boolean, LParen, RParen) {
        return StmtError();
    }
    let mut LCR: LoopInConstructRAII = LoopInConstructRAII { self.getActions().OpenACC(), true };
    self.getActions().OpenACC().ActOnWhileStmt(WhileLoc);
    self.getCurScope().EnterLoopBody(PrecedingLabel);
    let mut InnerScope: ParseScope = ParseScope { self, DeclScope, C99orCXX, self.Tok.is(l_brace) };
    let mut MIChecker: MisleadingIndentationChecker = MisleadingIndentationChecker { *self, MSK_while, WhileLoc };
    let mut Body: StmtResult = self.ParseStatement(TrailingElseLoc, SubStmt, null);
    if Body.isUsable() {
        MIChecker.Check();
    }
    InnerScope.Exit();
    WhileScope.Exit();
    if Cond.isInvalid() || Body.isInvalid() {
        return StmtError();
    }
    return self.Actions.ActOnWhileStmt(WhileLoc, LParen, Cond, RParen, Body.get());
}

fn Parser::ParseDoStatement(self, PrecedingLabel: *mut LabelDecl) -> StmtResult {
    assert!(self.Tok.is(kw_do), "Not a do stmt!");
    let mut DoLoc: SourceLocation = self.ConsumeToken();
    let mut ScopeFlags: u32 = if self.getLangOpts().C99 { DeclScope } else { NoScope };
    let mut DoScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    let mut LCR: LoopInConstructRAII = LoopInConstructRAII { self.getActions().OpenACC(), true };
    self.getActions().OpenACC().ActOnDoStmt(DoLoc);
    self.getCurScope().EnterLoopBody(PrecedingLabel);
    let mut C99orCXX: bool = self.getLangOpts().C99 || self.getLangOpts().CPlusPlus;
    let mut InnerScope: ParseScope = ParseScope { self, DeclScope, C99orCXX, self.Tok.is(l_brace) };
    let mut Body: StmtResult = self.ParseStatement(null, SubStmt, null);
    InnerScope.Exit();
    self.getCurScope().LeaveLoopBody();
    if self.Tok.isNot(kw_while) {
        if !Body.isInvalid() {
            self.Diag(self.Tok, err_expected_while);
            self.Diag(DoLoc, note_matching) << "'do'";
            self.SkipUntil(semi, StopBeforeMatch);
        }
        return StmtError();
    }
    let mut WhileLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.isNot(l_paren) {
        self.Diag(self.Tok, err_expected_lparen_after) << "do/while";
        self.SkipUntil(semi, StopBeforeMatch);
        return StmtError();
    }
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    T.consumeOpen();
    self.DiagnoseAndSkipCXX11Attributes();
    let mut Start: SourceLocation = self.Tok.getLocation();
    let mut Cond: ExprResult = self.ParseExpression(AllowNonTypes);
    if !Cond.isUsable() {
        if !self.Tok.isOneOf(r_paren, r_square, r_brace) {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
        }
        Cond = self.Actions.CreateRecoveryExpr(Start, if Start == self.Tok.getLocation() { Start } else { self.PrevTokLocation }, ArrayRef<Expr *> {}, self.Actions.getASTContext().BoolTy.operator QualType());
    }
    T.consumeClose();
    DoScope.Exit();
    if Cond.isInvalid() || Body.isInvalid() {
        return StmtError();
    }
    return self.Actions.ActOnDoStmt(DoLoc, Body.get(), WhileLoc, T.getOpenLocation(), Cond.get(), T.getCloseLocation());
}

fn Parser::isForRangeIdentifier(self) -> bool {
    assert!(self.Tok.is(identifier);
    let mut Next: *Token = self.NextToken();
    if Next.is(colon) {
        return true;
    }
    if Next.isOneOf(l_square, kw_alignas) {
        let mut PA: TentativeParsingAction = TentativeParsingAction { *self, false };
        self.ConsumeToken();
        self.SkipCXX11Attributes();
        let mut Result: bool = self.Tok.is(colon);
        PA.Revert();
        return Result;
    }
    return false;
}

fn Parser::ParseForRangeInitializerAfterColon(self, FRI: *mut ForRangeInit, VarDeclSpec: *mut ParsingDeclSpec) {
    let mut Ctx: ExpressionEvaluationContext = PotentiallyEvaluated;
    if FRI.ExpansionStmt && VarDeclSpec && VarDeclSpec.hasConstexprSpecifier() {
        Ctx = ImmediateFunctionContext;
    }
    let mut InitContext: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Ctx, null, EK_Other, self.getLangOpts().CPlusPlus23 };
    if self.getLangOpts().CPlusPlus23 {
        let mut LastRecord: *mut ExpressionEvaluationContextRecord = self.Actions.currentEvaluationContext();
        LastRecord.InLifetimeExtendingContext = true;
        LastRecord.RebuildDefaultArgOrDefaultInit = true;
    }
    if FRI.ExpansionStmt {
        assert!(self.Actions.CurContext.isExpansionStmt();
        let mut CtxGuard: ContextRAII = ContextRAII { self.Actions, self.Actions.CurContext.getParent(), false };
        FRI.RangeExpr = if self.Tok.is(l_brace) { self.ParseExpansionInitList() } else { self.ParseExpression(AllowNonTypes) };
        FRI.RangeExpr = self.Actions.MaybeCreateExprWithCleanups(FRI.RangeExpr);
    } else if self.Tok.is(l_brace) {
        FRI.RangeExpr = self.ParseBraceInitializer();
    } else {
        FRI.RangeExpr = self.ParseExpression(AllowNonTypes);
    }
    assert!(self.getLangOpts().CPlusPlus23 || self.Actions.ExprEvalContexts.back().ForRangeLifetimeExtendTemps.is_empty();
    FRI.LifetimeExtendTemps = move(self.Actions.ExprEvalContexts.back().ForRangeLifetimeExtendTemps);
}

fn Parser::ParseForStatement(self, TrailingElseLoc: *mut SourceLocation, PrecedingLabel: *mut LabelDecl, ESD: *mut CXXExpansionStmtDecl) -> StmtResult {
    assert!(self.Tok.is(kw_for), "Not a for stmt!");
    let mut ForLoc: SourceLocation = self.ConsumeToken();
    let mut CoawaitLoc: SourceLocation = SourceLocation {};
    if self.Tok.is(kw_co_await) {
        CoawaitLoc = self.ConsumeToken();
    }
    if self.Tok.isNot(l_paren) {
        self.Diag(self.Tok, err_expected_lparen_after) << "for";
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return StmtError();
    }
    let mut C99orCXXorObjC: bool = self.getLangOpts().C99 || self.getLangOpts().CPlusPlus || self.getLangOpts().ObjC;
    let mut ScopeFlags: u32 = ControlScope | (if C99orCXXorObjC { DeclScope } else { NoScope });
    if ESD {
        ScopeFlags |= TemplateParamScope | ExpansionStmtScope;
    }
    let mut ForScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    T.consumeOpen();
    let mut Value: ExprResult = false;
    let mut ForEach: bool = false;
    let mut FirstPart: StmtResult = false;
    let mut SecondPart: ConditionResult = ConditionResult {};
    let mut Collection: ExprResult = false;
    let mut ForRangeInfo: ForRangeInfo = ForRangeInfo {};
    let mut ThirdPart: FullExprArg = self.Actions;
    ForRangeInfo.ExpansionStmt = ESD;
    assert!(!ESD || self.Actions.CurContext.isExpansionStmt();
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteOrdinaryName(self.getCurScope(), if C99orCXXorObjC { PCC_ForInit } else { PCC_Expression });
        return StmtError();
    }
    let mut attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseCXX11Attributes(attrs, false);
    let mut EmptyInitStmtSemiLoc: SourceLocation = SourceLocation {};
    if self.Tok.is(semi) {
        self.ProhibitAttributes(attrs, SourceLocation {});
        let mut SemiLoc: SourceLocation = self.Tok.getLocation();
        if !self.Tok.hasLeadingEmptyMacro() && !SemiLoc.isMacroID() {
            EmptyInitStmtSemiLoc = SemiLoc;
        }
        self.ConsumeToken();
    } else if self.getLangOpts().CPlusPlus && self.Tok.is(identifier) && self.isForRangeIdentifier() {
        self.ProhibitAttributes(attrs, SourceLocation {});
        let mut Name: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut Loc: SourceLocation = self.ConsumeToken();
        self.MaybeParseCXX11Attributes(attrs, false);
        ForRangeInfo.ColonLoc = self.ConsumeToken();
        self.ParseForRangeInitializerAfterColon(ForRangeInfo, null);
        self.Diag(Loc, err_for_range_identifier) << (ForRangeInfo.ExpansionStmt != null) << (if (self.getLangOpts().CPlusPlus11 && !self.getLangOpts().CPlusPlus17) { CreateInsertion(Loc, "auto &&", false) } else { FixItHint {} });
        if !ForRangeInfo.ExpansionStmt {
            ForRangeInfo.LoopVar = self.Actions.ActOnCXXForRangeIdentifier(self.getCurScope(), Loc, Name, attrs);
        }
    } else if self.isForInitDeclaration() {
        let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
        let mut EnterParentContext: ExpansionStmtContextRAII = ExpansionStmtContextRAII { self.Actions, ForRangeInfo, self.Actions.CurContext.getParent() };
        if !C99orCXXorObjC {
            self.Diag(self.Tok, ext_c99_variable_decl_in_for_loop);
            self.Diag(self.Tok, warn_gcc_variable_decl_in_for_loop);
        }
        let mut DG: DeclGroupPtrTy = null;
        let mut DeclStart: SourceLocation = self.Tok.getLocation();
        let mut DeclEnd: SourceLocation = SourceLocation {};
        if !self.getLangOpts().CPlusPlus && self.Tok.isOneOf(kw_static_assert, kw__Static_assert) {
            self.ProhibitAttributes(attrs, SourceLocation {});
            let mut D: *mut Decl = self.ParseStaticAssertDeclaration(DeclEnd);
            DG = self.Actions.ConvertDeclToDeclGroup(D, null);
            FirstPart = self.Actions.ActOnDeclStmt(DG, DeclStart, self.Tok.getLocation());
        } else if self.Tok.is(kw_using) {
            DG = self.ParseAliasDeclarationInInitStatement(ForInit, attrs);
            FirstPart = self.Actions.ActOnDeclStmt(DG, DeclStart, self.Tok.getLocation());
        } else {
            let mut MightBeForRangeStmt: bool = self.getLangOpts().CPlusPlus || self.getLangOpts().ObjC;
            let mut ColonProtection: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: MightBeForRangeStmt };
            let mut DeclSpecAttrs: ParsedAttributes = self.AttrFactory;
            DG = self.ParseSimpleDeclaration(ForInit, DeclEnd, attrs, DeclSpecAttrs, false, if MightBeForRangeStmt { &mut ForRangeInfo } else { null }, null);
            FirstPart = self.Actions.ActOnDeclStmt(DG, DeclStart, self.Tok.getLocation());
            if ForRangeInfo.ParsedForRangeDecl() {
                self.DiagCompat(ForRangeInfo.ColonLoc, for_range);
                ForRangeInfo.LoopVar = FirstPart;
                FirstPart = StmtResult { false };
            } else if self.Tok.is(semi) {
                self.ConsumeToken();
            } else if (ForEach = self.isTokIdentifier_in()) {
                self.Actions.ActOnForEachDeclStmt(DG);
                self.ConsumeToken();
                if self.Tok.is(code_completion) {
                    self.cutOffParsing();
                    self.Actions.CodeCompletion().CodeCompleteObjCForCollection(self.getCurScope(), DG);
                    return StmtError();
                }
                Collection = self.ParseExpression(AllowNonTypes);
            } else {
                self.Diag(self.Tok, err_expected_semi_for);
            }
        }
    } else {
        let mut EnterParentContext: ExpansionStmtContextRAII = ExpansionStmtContextRAII { self.Actions, ForRangeInfo, self.Actions.CurContext.getParent() };
        self.ProhibitAttributes(attrs, SourceLocation {});
        Value = self.ParseExpression(AllowNonTypes);
        ForEach = self.isTokIdentifier_in();
        if !Value.isInvalid() {
            if ForEach {
                FirstPart = self.Actions.ActOnForEachLValueExpr(Value.get());
            } else {
                let mut IsRangeBasedFor: bool = self.getLangOpts().CPlusPlus11 && !ForEach && self.Tok.is(colon);
                FirstPart = self.Actions.ActOnExprStmt(Value, !IsRangeBasedFor);
            }
        }
        if self.Tok.is(semi) {
            self.ConsumeToken();
        } else if ForEach {
            self.ConsumeToken();
            if self.Tok.is(code_completion) {
                self.cutOffParsing();
                self.Actions.CodeCompletion().CodeCompleteObjCForCollection(self.getCurScope(), null);
                return StmtError();
            }
            Collection = self.ParseExpression(AllowNonTypes);
        } else if self.getLangOpts().CPlusPlus11 && self.Tok.is(colon) && FirstPart.get() {
            self.Diag(self.Tok, err_for_range_expected_decl) << (ESD != null) << FirstPart.get().getSourceRange();
            self.SkipUntil(r_paren, StopBeforeMatch);
            SecondPart = ConditionError();
        } else {
            if !Value.isInvalid() {
                self.Diag(self.Tok, err_expected_semi_for);
            } else {
                self.SkipUntil(r_paren, StopAtSemi | StopBeforeMatch);
                if self.Tok.is(semi) {
                    self.ConsumeToken();
                }
            }
        }
    }
    if !ForEach && !ForRangeInfo.ParsedForRangeDecl() && !SecondPart.isInvalid() {
        if self.Tok.is(semi) {} else if self.Tok.is(r_paren) {} else {
            if self.getLangOpts().CPlusPlus {
                let mut MightBeForRangeStmt: bool = !ForRangeInfo.ParsedForRangeDecl();
                let mut ColonProtection: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: MightBeForRangeStmt };
                let mut SecondPartStart: SourceLocation = self.Tok.getLocation();
                let mut CK: ConditionKind = Boolean;
                SecondPart = self.ParseCondition(null, ForLoc, CK, true, if MightBeForRangeStmt { &mut ForRangeInfo } else { null });
                if ForRangeInfo.ParsedForRangeDecl() {
                    self.DiagCompat(if FirstPart.get() { FirstPart.get().getBeginLoc() } else { ForRangeInfo.ColonLoc }, for_range_init_stmt) << (if FirstPart.get() { FirstPart.get().getSourceRange() } else { SourceRange {} });
                    if EmptyInitStmtSemiLoc.isValid() {
                        self.Diag(EmptyInitStmtSemiLoc, warn_empty_init_statement) << 2 << CreateRemoval(EmptyInitStmtSemiLoc);
                    }
                }
                if SecondPart.isInvalid() {
                    let mut CondExpr: ExprResult = self.Actions.CreateRecoveryExpr(SecondPartStart, if self.Tok.getLocation() == SecondPartStart { SecondPartStart } else { self.PrevTokLocation }, ArrayRef<Expr *> {}, self.Actions.PreferredConditionType(CK));
                    if !CondExpr.isInvalid() {
                        SecondPart = self.Actions.ActOnCondition(self.getCurScope(), ForLoc, CondExpr.get(), CK, false);
                    }
                }
            } else {
                let mut SecondExpr: ExprResult = self.ParseExpression(AllowNonTypes);
                if SecondExpr.isInvalid() {
                    SecondPart = ConditionError();
                } else {
                    SecondPart = self.Actions.ActOnCondition(self.getCurScope(), ForLoc, SecondExpr.get(), Boolean, true);
                }
            }
        }
    }
    if !ForEach && !ForRangeInfo.ParsedForRangeDecl() {
        if self.Tok.isNot(semi) {
            if !SecondPart.isInvalid() {
                self.Diag(self.Tok, err_expected_semi_for);
            }
            self.SkipUntil(r_paren, StopAtSemi | StopBeforeMatch);
        }
        if self.Tok.is(semi) {
            self.ConsumeToken();
        }
        if self.Tok.isNot(r_paren) {
            let mut Third: ExprResult = self.ParseExpression(AllowNonTypes);
            ThirdPart = self.Actions.MakeFullDiscardedValueExpr(Third.get());
        }
    }
    T.consumeClose();
    if CoawaitLoc.isValid() && !ForRangeInfo.ParsedForRangeDecl() {
        self.Diag(CoawaitLoc, err_for_co_await_not_range_for);
        CoawaitLoc = SourceLocation {};
    }
    if CoawaitLoc.isValid() && self.getLangOpts().CPlusPlus20 {
        self.Diag(CoawaitLoc, warn_deprecated_for_co_await);
    }
    let mut ForRangeStmt: StmtResult = false;
    let mut ForEachStmt: StmtResult = false;
    if ESD {
        ForRangeStmt = self.Actions.ActOnCXXExpansionStmtPattern(ESD, FirstPart.get(), ForRangeInfo.LoopVar.get(), ForRangeInfo.RangeExpr.get(), T.getOpenLocation(), ForRangeInfo.ColonLoc, T.getCloseLocation(), ForRangeInfo.LifetimeExtendTemps);
    } else if ForRangeInfo.ParsedForRangeDecl() {
        ForRangeStmt = self.Actions.ActOnCXXForRangeStmt(self.getCurScope(), ForLoc, CoawaitLoc, FirstPart.get(), ForRangeInfo.LoopVar.get(), ForRangeInfo.ColonLoc, ForRangeInfo.RangeExpr.get(), T.getCloseLocation(), BFRK_Build, ForRangeInfo.LifetimeExtendTemps);
    } else if ForEach {
        ForEachStmt = self.Actions.ObjC().ActOnObjCForCollectionStmt(ForLoc, FirstPart.get(), Collection.get(), T.getCloseLocation());
    } else {
        if self.getLangOpts().OpenMP && FirstPart.isUsable() {
            self.Actions.OpenMP().ActOnOpenMPLoopInitialization(ForLoc, FirstPart.get());
        }
    }
    let mut LCR: LoopInConstructRAII = LoopInConstructRAII { self.getActions().OpenACC(), true };
    if ESD {
        
    } else if ForRangeInfo.ParsedForRangeDecl() {
        self.getActions().OpenACC().ActOnRangeForStmtBegin(ForLoc, ForRangeStmt.get());
    } else {
        self.getActions().OpenACC().ActOnForStmtBegin(ForLoc, FirstPart.get(), SecondPart.get().second, ThirdPart.get());
    }
    self.getCurScope().EnterLoopBody(PrecedingLabel);
    let mut BodyStartsWithAttr: bool = self.Tok.isOneOf(l_square, kw___attribute);
    let mut BodyBeginLoc: SourceLocation = self.Tok.getLocation();
    let mut InnerScope: ParseScope = ParseScope { self, DeclScope, C99orCXXorObjC, self.Tok.is(l_brace) };
    if C99orCXXorObjC {
        self.getCurScope().decrementMSManglingNumber();
    }
    let mut MIChecker: MisleadingIndentationChecker = MisleadingIndentationChecker { *self, MSK_for, ForLoc };
    let mut Body: StmtResult = self.ParseStatement(TrailingElseLoc, SubStmt, null);
    if Body.isUsable() {
        MIChecker.Check();
    }
    InnerScope.Exit();
    self.getActions().OpenACC().ActOnForStmtEnd(ForLoc, Body);
    ForScope.Exit();
    if Body.isInvalid() {
        return StmtError();
    }
    if ForEach {
        return self.Actions.ObjC().FinishObjCForCollectionStmt(ForEachStmt.get(), Body.get());
    }
    if ESD {
        if !ForRangeInfo.ParsedForRangeDecl() {
            self.Diag(ForLoc, err_expansion_stmt_requires_range);
            return StmtError();
        }
        if !isa(Body.get()) || BodyStartsWithAttr {
            self.Diag(BodyBeginLoc, if isa(Body.get().stripLabelLikeStatements()) { ext_expansion_stmt_body_attr } else { ext_expansion_stmt_body_not_compound_stmt });
        }
        return self.Actions.FinishCXXExpansionStmt(ForRangeStmt.get(), Body.get());
    }
    if ForRangeInfo.ParsedForRangeDecl() {
        return self.Actions.FinishCXXForRangeStmt(ForRangeStmt.get(), Body.get());
    }
    return self.Actions.ActOnForStmt(ForLoc, T.getOpenLocation(), FirstPart.get(), SecondPart, ThirdPart, T.getCloseLocation(), Body.get());
}

fn Parser::ParseGotoStatement(self) -> StmtResult {
    assert!(self.Tok.is(kw_goto), "Not a goto stmt!");
    let mut GotoLoc: SourceLocation = self.ConsumeToken();
    let mut Res: StmtResult = false;
    if self.Tok.is(identifier) {
        let mut LD: *mut LabelDecl = self.Actions.LookupOrCreateLabel(self.Tok.getIdentifierInfo(), self.Tok.getLocation(), SourceLocation {}, false);
        Res = self.Actions.ActOnGotoStmt(GotoLoc, self.Tok.getLocation(), LD);
        self.ConsumeToken();
    } else if self.Tok.is(star) {
        self.Diag(self.Tok, ext_gnu_indirect_goto);
        let mut StarLoc: SourceLocation = self.ConsumeToken();
        let mut R: ExprResult = self.ParseExpression(AllowNonTypes);
        if R.isInvalid() {
            self.SkipUntil(semi, StopBeforeMatch);
            return StmtError();
        }
        Res = self.Actions.ActOnIndirectGotoStmt(GotoLoc, StarLoc, R.get());
    } else {
        self.Diag(self.Tok, err_expected) << identifier;
        return StmtError();
    }
    return Res;
}

fn Parser::ParseBreakOrContinueStatement(self, IsContinue: bool) -> StmtResult {
    let mut KwLoc: SourceLocation = self.ConsumeToken();
    let mut LabelLoc: SourceLocation = SourceLocation {};
    let mut Target: *mut LabelDecl = null;
    if self.Tok.is(identifier) {
        Target = self.Actions.LookupExistingLabel(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
        LabelLoc = self.ConsumeToken();
        if !self.getLangOpts().NamedLoops {
            self.Diag(LabelLoc, err_c2y_labeled_break_continue) << IsContinue;
        }
        if !Target {
            self.Diag(LabelLoc, err_break_continue_label_not_found) << IsContinue;
            return StmtError();
        }
    }
    if IsContinue {
        return self.Actions.ActOnContinueStmt(KwLoc, self.getCurScope(), Target, LabelLoc);
    }
    return self.Actions.ActOnBreakStmt(KwLoc, self.getCurScope(), Target, LabelLoc);
}

fn Parser::ParseContinueStatement(self) -> StmtResult {
    return self.ParseBreakOrContinueStatement(true);
}

fn Parser::ParseBreakStatement(self) -> StmtResult {
    return self.ParseBreakOrContinueStatement(false);
}

fn Parser::ParseReturnStatement(self) -> StmtResult {
    assert!((self.Tok.is(kw_return) || self.Tok.is(kw_co_return)), "Not a return stmt!");
    let mut IsCoreturn: bool = self.Tok.is(kw_co_return);
    let mut ReturnLoc: SourceLocation = self.ConsumeToken();
    let mut R: ExprResult = false;
    if self.Tok.isNot(semi) {
        if !IsCoreturn {
            self.PreferredType.enterReturn(self.Actions, self.Tok.getLocation());
        }
        if self.Tok.is(code_completion) && !IsCoreturn {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteExpression(self.getCurScope(), self.PreferredType.get(self.Tok.getLocation()), false, false);
            return StmtError();
        }
        if self.Tok.is(l_brace) && self.getLangOpts().CPlusPlus {
            R = self.ParseInitializer(null);
            if R.isUsable() {
                self.DiagCompat(R.get().getBeginLoc(), generalized_initializer_lists);
            }
        } else {
            R = self.ParseExpression(AllowNonTypes);
        }
        if R.isInvalid() {
            self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
            return StmtError();
        }
    }
    if IsCoreturn {
        return self.Actions.ActOnCoreturnStmt(self.getCurScope(), ReturnLoc, R.get());
    }
    return self.Actions.ActOnReturnStmt(ReturnLoc, R.get(), self.getCurScope());
}

fn Parser::ParseDeferStatement(self, TrailingElseLoc: *mut SourceLocation) -> StmtResult {
    assert!(self.Tok.is(kw__Defer);
    let mut DeferLoc: SourceLocation = self.ConsumeToken();
    self.Actions.ActOnStartOfDeferStmt(DeferLoc, self.getCurScope());
    let mut OnError: Closure_4 = Closure_4 { cap_0: self };
    let mut Res: StmtResult = self.ParseStatement(TrailingElseLoc, SubStmt, null);
    if !Res.isUsable() {
        return StmtError();
    }
    if dyn_cast(Res.get()) {
        L;
    } else {
        self.Diag(L.getIdentLoc(), err_defer_ts_labeled_stmt);
        return StmtError();
    }
    OnError.release();
    return self.Actions.ActOnEndOfDeferStmt(Res.get(), self.getCurScope());
}

fn Parser::ParsePragmaLoopHint(self, Stmts: *mut StmtVector, StmtCtx: ParsedStmtContext, TrailingElseLoc: *mut SourceLocation, Attrs: *mut ParsedAttributes, PrecedingLabel: *mut LabelDecl) -> StmtResult {
    let mut TempAttrs: ParsedAttributes = self.AttrFactory;
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    while self.Tok.is(annot_pragma_loop_hint) {
        let mut Hint: LoopHint = LoopHint {};
        if !self.HandlePragmaLoopHint(Hint) {
            continue;
        }
        let mut ArgHints: [4]ArgsUnion = [Hint.PragmaNameLoc, Hint.OptionLoc, Hint.StateLoc, Hint.ValueExpr];
        TempAttrs.addNew(Hint.PragmaNameLoc.getIdentifierInfo(), Hint.Range, AttributeScopeInfo {}, ArgHints, 4, Pragma(), SourceLocation {});
    }
    self.MaybeParseCXX11Attributes(Attrs, false);
    let mut EmptyDeclSpecAttrs: ParsedAttributes = self.AttrFactory;
    let mut S: StmtResult = self.ParseStatementOrDeclarationAfterAttributes(Stmts, StmtCtx, TrailingElseLoc, Attrs, EmptyDeclSpecAttrs, PrecedingLabel);
    Attrs.takeAllPrependingFrom(TempAttrs);
    if Attrs.Range.getBegin().isInvalid() {
        Attrs.Range.setBegin(StartLoc);
    }
    return S;
}

fn Parser::ParseFunctionStatementBody(self, Decl: *mut Decl, BodyScope: *mut ParseScope) -> *mut Decl {
    assert!(self.Tok.is(l_brace);
    let mut LBraceLoc: SourceLocation = self.Tok.getLocation();
    let mut CrashInfo: PrettyDeclStackTraceEntry = PrettyDeclStackTraceEntry { self.Actions.Context, Decl, LBraceLoc, "parsing function body" };
    let mut IsCXXMethod: bool = self.getLangOpts().CPlusPlus && Decl && isa(Decl);
    let mut PragmaStackSentinel: PragmaStackSentinelRAII = PragmaStackSentinelRAII { self.Actions, "InternalPragmaState", IsCXXMethod };
    let mut FnBody: StmtResult = self.ParseCompoundStatementBody(false);
    if FnBody.isInvalid() {
        let mut CompoundScope: CompoundScopeRAII = CompoundScopeRAII { self.Actions, false };
        FnBody = self.Actions.ActOnCompoundStmt(LBraceLoc, LBraceLoc, ArrayRef<Stmt *> {}, false);
    }
    BodyScope.Exit();
    return self.Actions.ActOnFinishFunctionBody(Decl, FnBody.get(), false, false);
}

fn Parser::ParseFunctionTryBlock(self, Decl: *mut Decl, BodyScope: *mut ParseScope) -> *mut Decl {
    assert!(self.Tok.is(kw_try), "Expected 'try'");
    let mut TryLoc: SourceLocation = self.ConsumeToken();
    let mut CrashInfo: PrettyDeclStackTraceEntry = PrettyDeclStackTraceEntry { self.Actions.Context, Decl, TryLoc, "parsing function try block" };
    if self.Tok.is(colon) {
        self.ParseConstructorInitializer(Decl);
    } else {
        self.Actions.ActOnDefaultCtorInitializers(Decl);
    }
    let mut IsCXXMethod: bool = self.getLangOpts().CPlusPlus && Decl && isa(Decl);
    let mut PragmaStackSentinel: PragmaStackSentinelRAII = PragmaStackSentinelRAII { self.Actions, "InternalPragmaState", IsCXXMethod };
    let mut LBraceLoc: SourceLocation = self.Tok.getLocation();
    let mut FnBody: StmtResult = self.ParseCXXTryBlockCommon(TryLoc, true);
    if FnBody.isInvalid() {
        let mut CompoundScope: CompoundScopeRAII = CompoundScopeRAII { self.Actions, false };
        FnBody = self.Actions.ActOnCompoundStmt(LBraceLoc, LBraceLoc, ArrayRef<Stmt *> {}, false);
    }
    BodyScope.Exit();
    return self.Actions.ActOnFinishFunctionBody(Decl, FnBody.get(), false, false);
}

fn Parser::trySkippingFunctionBody(self) -> bool {
    assert!(self.SkipFunctionBodies, "Should only be called when SkipFunctionBodies is enabled");
    if !self.PP.isCodeCompletionEnabled() {
        self.SkipFunctionBody();
        return true;
    }
    let mut PA: TentativeParsingAction = TentativeParsingAction { *self, false };
    let mut IsTryCatch: bool = self.Tok.is(kw_try);
    let mut Toks: CachedTokens = CachedTokens {};
    let mut ErrorInPrologue: bool = self.ConsumeAndStoreFunctionPrologue(Toks);
    if any_of(Toks, Closure_5 {}) {
        PA.Revert();
        return false;
    }
    if ErrorInPrologue {
        PA.Commit();
        self.SkipMalformedDecl();
        return true;
    }
    if !self.SkipUntil(r_brace, StopAtCodeCompletion) {
        PA.Revert();
        return false;
    }
    while IsTryCatch && self.Tok.is(kw_catch) {
        if !self.SkipUntil(l_brace, StopAtCodeCompletion) || !self.SkipUntil(r_brace, StopAtCodeCompletion) {
            PA.Revert();
            return false;
        }
    }
    PA.Commit();
    return true;
}

fn Parser::ParseCXXTryBlock(self) -> StmtResult {
    assert!(self.Tok.is(kw_try), "Expected 'try'");
    let mut TryLoc: SourceLocation = self.ConsumeToken();
    return self.ParseCXXTryBlockCommon(TryLoc, false);
}

fn Parser::ParseCXXTryBlockCommon(self, TryLoc: SourceLocation, FnTry: bool) -> StmtResult {
    if self.Tok.isNot(l_brace) {
        return StmtError(self.Diag(self.Tok, err_expected) << l_brace);
    }
    let mut TryBlock: StmtResult = self.ParseCompoundStatement(false, DeclScope | TryScope | CompoundStmtScope | (if FnTry { FnTryCatchScope } else { NoScope }));
    if TryBlock.isInvalid() {
        return TryBlock;
    }
    if self.isTokenSEHExcept() || self.Tok.is(kw___finally) {
        let mut Handler: StmtResult = false;
        if self.isTokenSEHExcept() {
            let mut Loc: SourceLocation = self.ConsumeToken();
            Handler = self.ParseSEHExceptBlock(Loc);
        } else {
            let mut Loc: SourceLocation = self.ConsumeToken();
            Handler = self.ParseSEHFinallyBlock(Loc);
        }
        if Handler.isInvalid() {
            return Handler;
        }
        return self.Actions.ActOnSEHTryBlock(true, TryLoc, TryBlock.get(), Handler.get());
    } else {
        let mut Handlers: StmtVector = StmtVector {};
        self.DiagnoseAndSkipCXX11Attributes();
        if self.Tok.isNot(kw_catch) {
            return StmtError(self.Diag(self.Tok, err_expected_catch));
        }
        while self.Tok.is(kw_catch) {
            let mut Handler: StmtResult = self.ParseCXXCatchBlock(FnTry);
            if !Handler.isInvalid() {
                Handlers.push(Handler.get());
            }
        }
        if Handlers.is_empty() {
            return StmtError();
        }
        return self.Actions.ActOnCXXTryBlock(TryLoc, TryBlock.get(), Handlers);
    }
}

fn Parser::ParseCXXCatchBlock(self, FnCatch: bool) -> StmtResult {
    assert!(self.Tok.is(kw_catch), "Expected 'catch'");
    let mut CatchLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected, "", unknown) {
        return StmtError();
    }
    let mut CatchScope: ParseScope = ParseScope { self, DeclScope | ControlScope | CatchScope | (if FnCatch { FnTryCatchScope } else { NoScope }), true, false };
    let mut ExceptionDecl: *mut Decl = null;
    if self.Tok.isNot(ellipsis) {
        let mut Attributes: ParsedAttributes = self.AttrFactory;
        self.MaybeParseCXX11Attributes(Attributes, false);
        let mut DS: DeclSpec = self.AttrFactory;
        if self.ParseCXXTypeSpecifierSeq(DS, TypeName) {
            return StmtError();
        }
        let mut ExDecl: Declarator = Declarator { DS, Attributes, CXXCatch };
        self.ParseDeclarator(ExDecl);
        ExceptionDecl = self.Actions.ActOnExceptionDeclarator(self.getCurScope(), ExDecl);
    } else {
        self.ConsumeToken();
    }
    T.consumeClose();
    if T.getCloseLocation().isInvalid() {
        return StmtError();
    }
    if self.Tok.isNot(l_brace) {
        return StmtError(self.Diag(self.Tok, err_expected) << l_brace);
    }
    let mut Block: StmtResult = self.ParseCompoundStatement(false);
    if Block.isInvalid() {
        return Block;
    }
    return self.Actions.ActOnCXXCatchBlock(CatchLoc, ExceptionDecl, Block.get());
}

fn Parser::ParseExpansionStatement(self, TrailingElseLoc: *mut SourceLocation, PrecedingLabel: *mut LabelDecl, TemplateLoc: SourceLocation) -> StmtResult {
    assert!(self.Tok.is(kw_for);
    let mut ExpansionDecl: *mut CXXExpansionStmtDecl = self.Actions.ActOnCXXExpansionStmtDecl(self.TemplateParameterDepth, TemplateLoc);
    let mut Expansion: *mut CXXExpansionStmtPattern = null;
    {
        let mut CtxGuard: ContextRAII = ContextRAII { self.Actions, ExpansionDecl, false };
        let mut TParamDepthGuard: TemplateParameterDepthRAII = self.TemplateParameterDepth;
        operator(TParamDepthGuard);
        let mut SR: StmtResult = self.ParseForStatement(TrailingElseLoc, PrecedingLabel, ExpansionDecl);
        if SR.isInvalid() {
            return SR;
        }
        Expansion = cast(SR.get());
        ExpansionDecl.setExpansionPattern(Expansion);
    }
    let mut DS: DeclSpec = self.AttrFactory;
    let mut DeclGroupPtr: DeclGroupPtrTy = self.Actions.FinalizeDeclaratorGroup(self.getCurScope(), DS, [ExpansionDecl]);
    return self.Actions.ActOnDeclStmt(DeclGroupPtr, Expansion.getBeginLoc(), Expansion.getEndLoc());
}

fn Parser::ParseMicrosoftIfExistsStatement(self, Stmts: *mut StmtVector) {
    let mut Result: IfExistsCondition = IfExistsCondition {};
    if self.ParseMicrosoftIfExistsCondition(Result) {
        return;
    }
    if Result.Behavior == Dependent {
        if !self.Tok.is(l_brace) {
            self.Diag(self.Tok, err_expected) << l_brace;
            return;
        }
        let mut Compound: StmtResult = self.ParseCompoundStatement(false);
        if Compound.isInvalid() {
            return;
        }
        let mut DepResult: StmtResult = self.Actions.ActOnMSDependentExistsStmt(Result.KeywordLoc, Result.IsIfExists, Result.SS, Result.Name, Compound.get());
        if DepResult.isUsable() {
            Stmts.push(DepResult.get());
        }
        return;
    }
    let mut Braces: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    if Braces.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_brace;
        return;
    }
    match Result.Behavior {
        Parse => {
            break;
        },
        Dependent => {
            llvm_unreachable_internal("Dependent case handled above", "P:/Goraw/llvm-project/clang/lib/Parse/ParseStmt.cpp", 2843);
        },
        Skip => {
            Braces.skipToEnd();
        },
    }
    while self.Tok.isNot(r_brace) {
        let mut R: StmtResult = self.ParseStatementOrDeclaration(Stmts, Compound, null, null);
        if R.isUsable() {
            Stmts.push(R.get());
        }
    }
    Braces.consumeClose();
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Attr: *mut ParsedAttr) -> bool {
                return Attr.isStmtAttr();
            }

struct Closure_2 {
    cap_0: *mut Parser,
    R: *mut StmtResult,
    isStmtExpr: *mut bool,
}

unsafe fn Closure_2::call(self: *mut Closure_2) {
        (*self.R) = self.ParseCompoundStatementBody((*self.isStmtExpr));
    }

struct Closure_3 {}

fn Closure_3::call(self: *Closure_3, S: *Stmt) -> bool {
            if dyn_cast_if_present(S) {
                Outer;
            } else {
                S = Outer.getSubStmt();
            }
            return isa_and_nonnull(S);
        }

struct Closure_4 {
    cap_0: *mut Parser,
}

fn Closure_4::call(self: *mut Closure_4) -> auto {
        self.Actions.ActOnDeferStmtError(self.getCurScope());
    }

struct Closure_5 {}

fn Closure_5::call(self: *Closure_5, Tok: *Token) -> bool {
        return Tok.is(code_completion);
    }
