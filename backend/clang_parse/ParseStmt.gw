fn Closure_3::call(self: *mut Closure_3) -> auto {
        self.Actions.ActOnDeferStmtError(self.getCurScope());
    }

struct Closure_4 {}

fn Closure_4::call(self: *Closure_4, Tok: *Token) -> bool {
        return Tok.is(code_completion);
    }
