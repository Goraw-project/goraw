fn Parser::ParseGotoStatement(self) -> i32 {
    assert!(self.Tok.is(kw_goto), "Not a goto stmt!");
    let mut GotoLoc: SourceLocation = self.ConsumeToken();
    let mut Res: i32 = 0;
    if self.Tok.is(identifier) {
        let mut LD: *mut LabelDecl = self.Actions.LookupOrCreateLabel(self.Tok.getIdentifierInfo(), self.Tok.getLocation(), SourceLocation {}, false);
        Res() = self.Actions(GotoLoc, self.Tok.getLocation(), LD);
        self.ConsumeToken();
    } else if self.Tok.is(star) {
        let mut StarLoc: SourceLocation = self.ConsumeToken();
        let mut R: i32 = 0;
        if R()() {
            self.SkipUntil(semi, StopBeforeMatch);
        }
        Res() = self.Actions(GotoLoc, StarLoc);
    } else {
         << identifier;
    }
    return ;
}

fn Parser::ParseBreakOrContinueStatement(self, IsContinue: bool) -> i32 {
    let mut KwLoc: SourceLocation = self.ConsumeToken();
    let mut LabelLoc: SourceLocation = SourceLocation {};
    let mut Target: *mut LabelDecl = null;
    if self.Tok.is(identifier) {
        Target = self.Actions.LookupExistingLabel(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
        LabelLoc = self.ConsumeToken();
        if operator!(self.getLangOpts()) {
            << IsContinue;
        }
        if !Target {
             << IsContinue;
        }
    }
    if IsContinue {
        return self.Actions(KwLoc, self.getCurScope(), Target, LabelLoc);
    }
    return self.Actions(KwLoc, self.getCurScope(), Target, LabelLoc);
}

