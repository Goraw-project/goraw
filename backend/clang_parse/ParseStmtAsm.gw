struct ClangAsmParserCallback {
    TheParser: *mut Parser,
    AsmLoc: SourceLocation,
    AsmString: str,
    AsmToks: ArrayRef<Token>,
    AsmTokOffsets: ArrayRef<unsigned int>,
}

fn ClangAsmParserCallback::ClangAsmParserCallback(self, P: *mut Parser, Loc: SourceLocation, AsmString: str, Toks: ArrayRef<Token>, Offsets: ArrayRef<unsigned int>) {
    assert!(self.AsmToks.len == self.AsmTokOffsets.len);
}

fn ClangAsmParserCallback::LookupInlineAsmField(self, Base: str, Member: str, Offset: *mut u32) -> bool {
    return self.TheParser.getActions().LookupInlineAsmField(Base, Member, Offset, self.AsmLoc);
}

fn ClangAsmParserCallback::DiagHandlerCallback(self, D: *SMDiagnostic, Context: *mut void) {
    (Context as *mut ClangAsmParserCallback).handleDiagnostic(D);
}

fn ClangAsmParserCallback::LookupInlineAsmIdentifier(self, LineBuf: *mut str, Info: *mut InlineAsmIdentifierInfo, IsUnevaluatedContext: bool) {
    let mut LineToks: SmallVector<Token, 16> = SmallVector<Token, 16> {};
    let mut FirstOrigToken: *Token = null;
    self.findTokensForString(LineBuf, LineToks, FirstOrigToken);
    let mut NumConsumedToks: u32 = 0;
    let mut Result: ExprResult = self.TheParser.ParseMSAsmIdentifier(LineToks, NumConsumedToks, IsUnevaluatedContext);
    if NumConsumedToks == 0 || NumConsumedToks == LineToks.len {} else {
        assert!(FirstOrigToken, "not using original tokens?");
        assert!(FirstOrigToken[NumConsumedToks].getLocation() == LineToks[NumConsumedToks].getLocation();
        let mut FirstIndex: u32 = FirstOrigToken - self.AsmToks.begin();
        let mut LastIndex: u32 = FirstIndex + NumConsumedToks - 1;
        let mut TotalOffset: u32 = (self.AsmTokOffsets[LastIndex] + self.AsmToks[LastIndex].getLength() - self.AsmTokOffsets[FirstIndex]);
        LineBuf = LineBuf[0..0 + TotalOffset];
    }
    if !Result.isUsable() {
        return;
    }
    self.TheParser.getActions().FillInlineAsmIdentifierInfo(Result.get(), Info);
}

fn ClangAsmParserCallback::LookupInlineAsmLabel(self, Identifier: str, LSM: *mut SourceMgr, Location: SMLoc, Create: bool) -> str {
    let mut Loc: SourceLocation = self.translateLocation(LSM, Location);
    let mut Label: *mut LabelDecl = self.TheParser.getActions().GetOrCreateMSAsmLabel(Identifier, Loc, Create);
    return Label.getMSAsmLabel();
}

fn ClangAsmParserCallback::findTokensForString(self: *ClangAsmParserCallback, Str: str, TempToks: *mut SmallVectorImpl<Token>, FirstOrigToken: **mut Token) {
    assert!(!less<const char *> {}.call(Str.begin(), self.AsmString.begin()) && !less<const char *> {}.call(self.AsmString.end(), Str.end();
    let mut FirstCharOffset: u32 = Str.begin() - self.AsmString.begin();
    let mut FirstTokOffset: *u32 = lower_bound(self.AsmTokOffsets, FirstCharOffset);
    assert!(*FirstTokOffset == FirstCharOffset);
    let mut FirstTokIndex: u32 = FirstTokOffset - self.AsmTokOffsets.begin();
    FirstOrigToken = &mut self.AsmToks[FirstTokIndex];
    let mut LastCharOffset: u32 = Str.end() - self.AsmString.begin();
    for let mut i: u32 = FirstTokIndex;
let mut e: u32 = self.AsmTokOffsets.len; i != e; i += 1 {
        if self.AsmTokOffsets[i] >= LastCharOffset {
            break;
        }
        TempToks.push(self.AsmToks[i]);
    }
}

fn ClangAsmParserCallback::translateLocation(self, LSM: *SourceMgr, SMLoc: SMLoc) -> SourceLocation {
    let mut LBuf: *MemoryBuffer = LSM.getMemoryBuffer(LSM.FindBufferContainingLoc(SMLoc));
    let mut Offset: u32 = SMLoc.getPointer() - LBuf.getBufferStart();
    let mut TokOffsetPtr: *u32 = lower_bound(self.AsmTokOffsets, Offset);
    let mut TokIndex: u32 = TokOffsetPtr - self.AsmTokOffsets.begin();
    let mut TokOffset: u32 = *TokOffsetPtr;
    let mut Loc: SourceLocation = self.AsmLoc;
    if TokIndex < self.AsmToks.len {
        let mut Tok: *Token = self.AsmToks[TokIndex];
        Loc = Tok.getLocation();
        Loc = Loc.getLocWithOffset(Offset - TokOffset);
    }
    return Loc;
}

fn ClangAsmParserCallback::handleDiagnostic(self, D: *SMDiagnostic) {
    let mut LSM: *SourceMgr = *D.getSourceMgr();
    let mut Loc: SourceLocation = self.translateLocation(LSM, D.getLoc());
    self.TheParser.Diag(Loc, err_inline_ms_asm_parsing) << D.getMessage();
}

fn Parser::ParseMSAsmIdentifier(self, LineToks: *mut SmallVectorImpl<Token>, NumLineToksConsumed: *mut u32, IsUnevaluatedContext: bool) -> ExprResult {
    let mut EndOfStream: TokenKind = semi;
    let mut EndOfStreamTok: Token = Token {};
    EndOfStreamTok.startToken();
    EndOfStreamTok.setKind(EndOfStream);
    LineToks.push(EndOfStreamTok);
    LineToks.push(self.Tok);
    self.PP.EnterTokenStream(LineToks, true, true);
    self.ConsumeAnyToken(false);
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if self.getLangOpts().CPlusPlus {
        self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, false, false, false, false, false);
    }
    let mut TemplateKWLoc: SourceLocation = SourceLocation {};
    let mut Id: UnqualifiedId = UnqualifiedId {};
    let mut Invalid: bool = true;
    let mut Result: ExprResult = false;
    if self.Tok.is(kw_this) {
        Result = self.ParseCXXThis();
        Invalid = false;
    } else {
        Invalid = self.ParseUnqualifiedId(SS, null, false, false, false, false, false, &mut TemplateKWLoc, Id);
        Result = self.Actions.LookupInlineAsmIdentifier(SS, TemplateKWLoc, Id, IsUnevaluatedContext);
    }
    while Result.isUsable() && self.Tok.is(period) {
        let mut IdTok: Token = self.PP.LookAhead(0);
        if IdTok.isNot(identifier) {
            break;
        }
        self.ConsumeToken();
        let mut Id: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        self.ConsumeToken();
        Result = self.Actions.LookupInlineAsmVarDeclField(Result.get(), Id.getName(), self.Tok.getLocation());
    }
    let mut LineIndex: u32 = 0;
    if self.Tok.is(EndOfStream) {
        LineIndex = LineToks.len - 2;
    } else {
        while LineToks[LineIndex].getLocation() != self.Tok.getLocation() {
            LineIndex += 1;
            assert!(LineIndex < LineToks.len - 2);
        }
    }
    if Invalid || self.Tok.is(EndOfStream) {
        NumLineToksConsumed = LineToks.len - 2;
    } else {
        NumLineToksConsumed = LineIndex;
    }
    for let mut i: u32 = 0;
let mut e: u32 = LineToks.len - LineIndex - 2; i != e; i += 1 {
        self.ConsumeAnyToken(false);
    }
    assert!(self.Tok.is(EndOfStream);
    self.ConsumeToken();
    LineToks.pop();
    LineToks.pop();
    return Result;
}

fn buildMSAsmString(PP: *mut Preprocessor, AsmLoc: SourceLocation, AsmToks: ArrayRef<Token>, TokOffsets: *mut SmallVectorImpl<unsigned int>, Asm: *mut str) -> bool {
    assert!(!AsmToks.is_empty(), "Didn't expect an empty AsmToks!");
    let mut isNewStatement: bool = true;
    for let mut i: u32 = 0;
let mut e: u32 = AsmToks.len; i < e; i += 1 {
        let mut Tok: *Token = AsmToks[i];
        if !isNewStatement && (Tok.is(kw_asm) || Tok.isAtStartOfLine()) {
            operator(Asm, "\n\t");
            isNewStatement = true;
        }
        if !isNewStatement && Tok.hasLeadingSpace() {
            operator(Asm, ' ');
        }
        TokOffsets.push(Asm.len);
        if Tok.is(kw_asm) {
            if i + 1 == e {
                PP.Diag(AsmLoc, err_asm_empty);
                return true;
            }
            continue;
        }
        let mut SpellingBuffer: str = "";
        let mut SpellingInvalid: bool = false;
        operator(Asm, PP.getSpelling(Tok, SpellingBuffer, &mut SpellingInvalid));
        assert!(!SpellingInvalid, "spelling was invalid after correct parse?");
        isNewStatement = false;
    }
    Asm.push(0);
    Asm.pop();
    assert!(TokOffsets.len == AsmToks.len);
    return false;
}

fn Parser::isGCCAsmStatement(self: *Parser, TokAfterAsm: *Token) -> bool {
    return TokAfterAsm.is(l_paren) || self.isGNUAsmQualifier(TokAfterAsm);
}

fn Parser::isGNUAsmQualifier(self: *Parser, TokAfterAsm: *Token) -> bool {
    return self.getGNUAsmQualifier(TokAfterAsm) != AQ_unspecified;
}

fn Parser::ParseMicrosoftAsmStatement(self, AsmLoc: SourceLocation) -> StmtResult {
    let mut SrcMgr: *mut SourceManager = self.PP.getSourceManager();
    let mut EndLoc: SourceLocation = AsmLoc;
    let mut AsmToks: SmallVector<Token, 4> = SmallVector<Token, 4> {};
    let mut SingleLineMode: bool = true;
    let mut BraceNesting: u32 = 0;
    let mut savedBraceCount: u16 = self.BraceCount;
    let mut InAsmComment: bool = false;
    let mut FID: FileID = FileID {};
    let mut LineNo: u32 = 0;
    let mut NumTokensRead: u32 = 0;
    let mut LBraceLocs: SmallVector<SourceLocation, 4> = SmallVector<SourceLocation, 4> {};
    let mut SkippedStartOfLine: bool = false;
    if self.Tok.is(l_brace) {
        SingleLineMode = false;
        BraceNesting = 1;
        EndLoc = self.ConsumeBrace();
        LBraceLocs.push(EndLoc);
        NumTokensRead += 1;
    } else {
        let mut ExpAsmLoc: FileIDAndOffset = SrcMgr.getDecomposedExpansionLoc(EndLoc);
        FID = ExpAsmLoc.first;
        LineNo = SrcMgr.getLineNumber(FID, ExpAsmLoc.second, null);
        LBraceLocs.push(SourceLocation {});
    }
    let mut TokLoc: SourceLocation = self.Tok.getLocation();
    while true {
        {
        if self.isEofOrEom() {
            break;
        }
        if !InAsmComment && self.Tok.is(l_brace) {
            SkippedStartOfLine = self.Tok.isAtStartOfLine();
            AsmToks.push(self.Tok);
            EndLoc = self.ConsumeBrace();
            BraceNesting += 1;
            LBraceLocs.push(EndLoc);
            TokLoc = self.Tok.getLocation();
            NumTokensRead += 1;
            continue;
        } else if !InAsmComment && self.Tok.is(semi) {
            InAsmComment = true;
            if !SingleLineMode {
                let mut ExpSemiLoc: FileIDAndOffset = SrcMgr.getDecomposedExpansionLoc(TokLoc);
                FID = ExpSemiLoc.first;
                LineNo = SrcMgr.getLineNumber(FID, ExpSemiLoc.second, null);
            }
        } else if SingleLineMode || InAsmComment {
            let mut ExpLoc: FileIDAndOffset = SrcMgr.getDecomposedExpansionLoc(TokLoc);
            if ExpLoc.first != FID || SrcMgr.getLineNumber(ExpLoc.first, ExpLoc.second, null) != LineNo {
                let mut isAsm: bool = self.Tok.is(kw_asm);
                if SingleLineMode && (!isAsm || self.isGCCAsmStatement(self.NextToken())) {
                    break;
                }
                InAsmComment = false;
                if isAsm {
                    if self.PP.LookAhead(0).is(l_brace) {
                        break;
                    }
                    LineNo = SrcMgr.getLineNumber(ExpLoc.first, ExpLoc.second, null);
                    SkippedStartOfLine = self.Tok.isAtStartOfLine();
                } else if self.Tok.is(semi) {
                    InAsmComment = true;
                    FID = ExpLoc.first;
                    LineNo = SrcMgr.getLineNumber(FID, ExpLoc.second, null);
                }
            } else if !InAsmComment && self.Tok.is(r_brace) {
                if !BraceNesting {
                    break;
                }
            }
        }
        if !InAsmComment && BraceNesting && self.Tok.is(r_brace) && self.BraceCount == (savedBraceCount + BraceNesting) {
            SkippedStartOfLine = self.Tok.isAtStartOfLine();
            if SingleLineMode || BraceNesting > 1 {
                self.Tok.clearFlag(LeadingSpace);
                AsmToks.push(self.Tok);
            }
            EndLoc = self.ConsumeBrace();
            BraceNesting -= 1;
            if BraceNesting == 0 && !SingleLineMode {
                break;
            } else {
                LBraceLocs.pop();
                TokLoc = self.Tok.getLocation();
                NumTokensRead += 1;
                continue;
            }
        }
        EndLoc = TokLoc;
        if InAsmComment {
            self.PP.Lex(self.Tok);
        } else {
            if SkippedStartOfLine {
                self.Tok.setFlag(StartOfLine);
            }
            AsmToks.push(self.Tok);
            self.ConsumeAnyToken(false);
        }
        TokLoc = self.Tok.getLocation();
        NumTokensRead += 1;
        SkippedStartOfLine = false;
    }
        if !(true) { break; }
    }
    if BraceNesting && self.BraceCount != savedBraceCount {
        for let mut i: u32 = 0; i < BraceNesting; i += 1 {
            self.Diag(self.Tok, err_expected) << r_brace;
            self.Diag(LBraceLocs.back(), note_matching) << l_brace;
            LBraceLocs.pop();
        }
        return StmtError();
    } else if NumTokensRead == 0 {
        self.Diag(self.Tok, err_expected) << l_brace;
        return StmtError();
    }
    let mut ConstraintRefs: SmallVector<StringRef, 4> = SmallVector<StringRef, 4> {};
    let mut Exprs: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
    let mut ClobberRefs: SmallVector<StringRef, 4> = SmallVector<StringRef, 4> {};
    let mut TheTriple: *Triple = self.Actions.Context.getTargetInfo().getTriple();
    let mut TheTarget: *Target = null;
    if !TheTriple.isX86() {
        self.Diag(AsmLoc, err_msasm_unsupported_arch) << TheTriple.getArchName();
    } else {
        let mut Error: str = "";
        TheTarget = lookupTarget(TheTriple, Error);
        if !TheTarget {
            self.Diag(AsmLoc, err_msasm_unable_to_create_target) << Error;
        }
    }
    assert!(!LBraceLocs.is_empty(), "Should have at least one location here");
    let mut AsmString: str = "";
    let mut EmptyStmt: Closure_1 = Closure_1 { cap_0: self, AsmLoc: &mut AsmLoc, LBraceLocs: &mut LBraceLocs, AsmToks: &mut AsmToks, AsmString: &mut AsmString, ConstraintRefs: &mut ConstraintRefs, ClobberRefs: &mut ClobberRefs, Exprs: &mut Exprs, EndLoc: &mut EndLoc };
    if !TheTarget || AsmToks.is_empty() {
        return EmptyStmt.call();
    }
    let mut TokOffsets: SmallVector<unsigned int, 8> = SmallVector<unsigned int, 8> {};
    if buildMSAsmString(self.PP, AsmLoc, AsmToks, TokOffsets, AsmString) {
        return StmtError();
    }
    let mut TO: *TargetOptions = self.Actions.Context.getTargetInfo().getTargetOpts();
    let mut FeaturesStr: str = join(TO.Features.begin(), TO.Features.end(), ",");
    let mut MRI: MCRegisterInfo> = TheTarget.createMCRegInfo(TheTriple);
    if !MRI {
        self.Diag(AsmLoc, err_msasm_unable_to_create_target) << "target MC unavailable";
        return EmptyStmt.call();
    }
    let mut MCOptions: MCTargetOptions = MCTargetOptions {};
    let mut MAI: MCAsmInfo> = TheTarget.createMCAsmInfo(operator(MRI), TheTriple, MCOptions);
    let mut MII: MCInstrInfo> = TheTarget.createMCInstrInfo();
    let mut STI: MCSubtargetInfo> = TheTarget.createMCSubtargetInfo(TheTriple, TO.CPU, FeaturesStr);
    if !MAI || !MII || !STI {
        self.Diag(AsmLoc, err_msasm_unable_to_create_target) << "target MC unavailable";
        return EmptyStmt.call();
    }
    let mut TempSrcMgr: SourceMgr = SourceMgr {};
    let mut Ctx: MCContext = MCContext { TheTriple, operator(MAI), operator(MRI), operator(STI), &mut TempSrcMgr, true, "" };
    let mut MOFI: MCObjectFileInfo> = TheTarget.createMCObjectFileInfo(Ctx, false, false);
    Ctx.setObjectFileInfo(MOFI.get());
    let mut Buffer: MemoryBuffer> = getMemBuffer(AsmString.operator StringRef(), "<MS inline asm>", true);
    TempSrcMgr.AddNewSourceBuffer(move(Buffer), SMLoc {});
    let mut Str: MCStreamer> = createNullStreamer(Ctx);
    let mut Parser: MCAsmParser> = createMCAsmParser(TempSrcMgr, Ctx, operator(Str), operator(MAI), 0);
    let mut TargetParser: MCTargetAsmParser> = TheTarget.createMCAsmParser(operator(STI), operator(Parser), operator(MII));
    if !TargetParser {
        self.Diag(AsmLoc, err_msasm_unable_to_create_target) << "target ASM parser unavailable";
        return EmptyStmt.call();
    }
    let mut IP: MCInstPrinter> = TheTarget.createMCInstPrinter(TheTriple, 1, operator(MAI), operator(MII), operator(MRI));
    operator(Parser).setAssemblerDialect(1);
    operator(Parser).setTargetParser(operator(TargetParser));
    operator(Parser).setParsingMSInlineAsm(true);
    operator(TargetParser).setParsingMSInlineAsm(true);
    let mut Callback: ClangAsmParserCallback = ClangAsmParserCallback { TheParser: *self, AsmLoc: AsmLoc, AsmString: AsmString.operator StringRef(), AsmToks: AsmToks, AsmTokOffsets: TokOffsets };
    operator(TargetParser).setSemaCallback(&mut Callback);
    TempSrcMgr.setDiagHandler(DiagHandlerCallback, &mut Callback);
    let mut NumOutputs: u32 = 0;
    let mut NumInputs: u32 = 0;
    let mut AsmStringIR: str = "";
    let mut OpExprs: pair<void *, bool>, 4> = pair<void *, bool>, 4> {};
    let mut Constraints: string, 4> = string, 4> {};
    let mut Clobbers: string, 4> = string, 4> {};
    if operator(Parser).parseMSInlineAsm(AsmStringIR, NumOutputs, NumInputs, OpExprs, Constraints, Clobbers, MII.get(), IP.get(), Callback) {
        return StmtError();
    }
    erase_if(Clobbers, Closure_2 {});
    append_range(ClobberRefs, Clobbers);
    let mut NumExprs: u32 = NumOutputs + NumInputs;
    ConstraintRefs.resize(NumExprs);
    Exprs.resize(NumExprs);
    for let mut i: u32 = 0;
let mut e: u32 = NumExprs; i != e; i += 1 {
        let mut OpExpr: *mut Expr = OpExprs[i].first as *mut Expr;
        if !OpExpr {
            return StmtError();
        }
        if OpExprs[i].second {
            OpExpr = self.Actions.BuildUnaryOp(self.getCurScope(), AsmLoc, UO_AddrOf, OpExpr, false).get();
        }
        ConstraintRefs[i] = Constraints[i];
        Exprs[i] = OpExpr;
    }
    return self.Actions.ActOnMSAsmStmt(AsmLoc, LBraceLocs[0], AsmToks, AsmStringIR, NumOutputs, NumInputs, ConstraintRefs, ClobberRefs, Exprs, EndLoc);
}

fn Parser::parseGNUAsmQualifierListOpt(self, AQ: *mut GNUAsmQualifiers) -> bool {
    while true {
        let mut A: AQ = self.getGNUAsmQualifier(self.Tok);
        if A == AQ_unspecified {
            if self.Tok.isNot(l_paren) {
                self.Diag(self.Tok.getLocation(), err_asm_qualifier_ignored);
                self.SkipUntil(r_paren, StopAtSemi);
                return true;
            }
            return false;
        }
        if AQ.setAsmQualifier(A) {
            self.Diag(self.Tok.getLocation(), err_asm_duplicate_qual) << getQualifierName(A);
        }
        self.ConsumeToken();
    }
    return false;
}

fn Parser::ParseAsmStatement(self, msAsm: *mut bool) -> StmtResult {
    assert!(self.Tok.is(kw_asm), "Not an asm stmt");
    let mut AsmLoc: SourceLocation = self.ConsumeToken();
    if self.getLangOpts().AsmBlocks && !self.isGCCAsmStatement(self.Tok) {
        msAsm = true;
        return self.ParseMicrosoftAsmStatement(AsmLoc);
    }
    let mut Loc: SourceLocation = self.Tok.getLocation();
    let mut GAQ: GNUAsmQualifiers = GNUAsmQualifiers {};
    if self.parseGNUAsmQualifierListOpt(GAQ) {
        return StmtError();
    }
    if GAQ.isGoto() && self.getLangOpts().SpeculativeLoadHardening {
        self.Diag(Loc, warn_slh_does_not_support_asm_goto);
    }
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    T.consumeOpen();
    let mut AsmString: ExprResult = self.ParseAsmStringLiteral(false);
    if !(self.getLangOpts().GNUAsm || AsmString.isInvalid()) {
        let mut SL: *StringLiteral const = cast(AsmString.get());
        if !SL.getString().trim(" \t\n\v\f\r").is_empty() {
            self.Diag(Loc, err_gnu_inline_asm_disabled);
        }
    }
    if AsmString.isInvalid() {
        T.skipToEnd();
        return StmtError();
    }
    let mut Names: SmallVector<IdentifierInfo *, 4> = SmallVector<IdentifierInfo *, 4> {};
    let mut Constraints: ExprVector = ExprVector {};
    let mut Exprs: ExprVector = ExprVector {};
    let mut Clobbers: ExprVector = ExprVector {};
    if self.Tok.is(r_paren) {
        T.consumeClose();
        return self.Actions.ActOnGCCAsmStmt(AsmLoc, true, GAQ.isVolatile(), 0, 0, null, Constraints, Exprs, AsmString.get(), Clobbers, 0, T.getCloseLocation());
    }
    let mut AteExtraColon: bool = false;
    if self.Tok.is(colon) || self.Tok.is(coloncolon) {
        AteExtraColon = self.Tok.is(coloncolon);
        self.ConsumeToken();
        if !AteExtraColon && self.ParseAsmOperandsOpt(Names, Constraints, Exprs) {
            return StmtError();
        }
    }
    let mut NumOutputs: u32 = Names.len;
    if AteExtraColon || self.Tok.is(colon) || self.Tok.is(coloncolon) {
        if AteExtraColon {
            AteExtraColon = false;
        } else {
            AteExtraColon = self.Tok.is(coloncolon);
            self.ConsumeToken();
        }
        if !AteExtraColon && self.ParseAsmOperandsOpt(Names, Constraints, Exprs) {
            return StmtError();
        }
    }
    assert!(Names.len == Constraints.len && Constraints.len == Exprs.len, "Input operand size mismatch!");
    let mut NumInputs: u32 = Names.len - NumOutputs;
    if AteExtraColon || self.Tok.is(colon) || self.Tok.is(coloncolon) {
        if AteExtraColon {
            AteExtraColon = false;
        } else {
            AteExtraColon = self.Tok.is(coloncolon);
            self.ConsumeToken();
        }
        if !AteExtraColon && (self.isTokenStringLiteral() || self.Tok.is(l_paren)) {
            while true {
                let mut Clobber: ExprResult = self.ParseAsmStringLiteral(false);
                if Clobber.isInvalid() {
                    break;
                }
                Clobbers.push(Clobber.get());
                if !self.TryConsumeToken(comma) {
                    break;
                }
            }
        }
    }
    if !GAQ.isGoto() && (self.Tok.isNot(r_paren) || AteExtraColon) {
        self.Diag(self.Tok, err_expected) << r_paren;
        self.SkipUntil(r_paren, StopAtSemi);
        return StmtError();
    }
    let mut NumLabels: u32 = 0;
    if AteExtraColon || self.Tok.is(colon) {
        if !AteExtraColon {
            self.ConsumeToken();
        }
        while true {
            if self.Tok.isNot(identifier) {
                self.Diag(self.Tok, err_expected) << identifier;
                self.SkipUntil(r_paren, StopAtSemi);
                return StmtError();
            }
            let mut LD: *mut LabelDecl = self.Actions.LookupOrCreateLabel(self.Tok.getIdentifierInfo(), self.Tok.getLocation(), SourceLocation {}, false);
            Names.push(self.Tok.getIdentifierInfo());
            if !LD {
                self.SkipUntil(r_paren, StopAtSemi);
                return StmtError();
            }
            let mut Res: ExprResult = self.Actions.ActOnAddrLabel(self.Tok.getLocation(), self.Tok.getLocation(), LD);
            Exprs.push(Res.get());
            NumLabels += 1;
            self.ConsumeToken();
            if !self.TryConsumeToken(comma) {
                break;
            }
        }
    } else if GAQ.isGoto() {
        self.Diag(self.Tok, err_expected) << colon;
        self.SkipUntil(r_paren, StopAtSemi);
        return StmtError();
    }
    T.consumeClose();
    return self.Actions.ActOnGCCAsmStmt(AsmLoc, false, GAQ.isVolatile(), NumOutputs, NumInputs, Names.ptr, Constraints, Exprs, AsmString.get(), Clobbers, NumLabels, T.getCloseLocation());
}

fn Parser::ParseAsmOperandsOpt(self, Names: *mut SmallVectorImpl<IdentifierInfo *>, Constraints: *mut SmallVectorImpl<Expr *>, Exprs: *mut SmallVectorImpl<Expr *>) -> bool {
    if self.Tok.isOneOf(colon, coloncolon, r_paren) {
        return false;
    }
    while true {
        if self.Tok.is(l_square) {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
            T.consumeOpen();
            if self.Tok.isNot(identifier) {
                self.Diag(self.Tok, err_expected) << identifier;
                self.SkipUntil(r_paren, StopAtSemi);
                return true;
            }
            let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            self.ConsumeToken();
            Names.push(II);
            T.consumeClose();
        } else {
            Names.push(null);
        }
        let mut Constraint: ExprResult = self.ParseAsmStringLiteral(false);
        if Constraint.isInvalid() {
            self.SkipUntil(r_paren, StopAtSemi);
            return true;
        }
        Constraints.push(Constraint.get());
        if self.Tok.isNot(l_paren) {
            self.Diag(self.Tok, err_expected_lparen_after) << "asm operand";
            self.SkipUntil(r_paren, StopAtSemi);
            return true;
        }
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        let mut Res: ExprResult = self.ParseExpression(AllowNonTypes);
        T.consumeClose();
        if Res.isInvalid() {
            self.SkipUntil(r_paren, StopAtSemi);
            return true;
        }
        Exprs.push(Res.get());
        if !self.TryConsumeToken(comma) {
            return false;
        }
    }
}

fn GNUAsmQualifiers@Parser@clang::getQualifierName(self, Qualifier: AQ) -> *u8 {
    match Qualifier {
        AQ_volatile => {
            return "volatile";
        },
        AQ_inline => {
            return "inline";
        },
        AQ_goto => {
            return "goto";
        },
        AQ_unspecified => {
            return "unspecified";
        },
    }
    llvm_unreachable_internal("Unknown GNUAsmQualifier", "P:/Goraw/llvm-project/clang/lib/Parse/ParseStmtAsm.cpp", 884);
}

fn Parser::getGNUAsmQualifier(self: *Parser, Tok: *Token) -> AQ {
    match Tok.getKind() {
        kw_volatile => {
            return AQ_volatile;
        },
        kw_inline => {
            return AQ_inline;
        },
        kw_goto => {
            return AQ_goto;
        },
        _ => {
            return AQ_unspecified;
        },
    }
}

fn GNUAsmQualifiers@Parser@clang::setAsmQualifier(self, Qualifier: AQ) -> bool {
    let mut IsDuplicate: bool = self.Qualifiers & Qualifier;
    self.Qualifiers |= Qualifier;
    return IsDuplicate;
}

struct Closure_1 {
    cap_0: *mut Parser,
    AsmLoc: *mut SourceLocation,
    LBraceLocs: *mut SmallVector<SourceLocation, 4>,
    AsmToks: *mut SmallVector<Token, 4>,
    AsmString: *mut str,
    ConstraintRefs: *mut SmallVector<StringRef, 4>,
    ClobberRefs: *mut SmallVector<StringRef, 4>,
    Exprs: *mut SmallVector<Expr *, 4>,
    EndLoc: *mut SourceLocation,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> auto {
        return self.Actions.ActOnMSAsmStmt((*self.AsmLoc), (*self.LBraceLocs)[0], (*self.AsmToks), (*self.AsmString).operator StringRef(), 0, 0, (*self.ConstraintRefs), (*self.ClobberRefs), (*self.Exprs), (*self.EndLoc));
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, C: str) -> bool {
        return C == "fpsr" || C == "mxcsr";
    }
