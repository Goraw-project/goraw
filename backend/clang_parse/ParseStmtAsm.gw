fn GNUAsmQualifiers@Parser@clang::getQualifierName(self, Qualifier: AQ) -> *u8 {
    match Qualifier {
        AQ_volatile => {
            return "volatile";
        },
        AQ_inline => {
            return "inline";
        },
        AQ_goto => {
            return "goto";
        },
        AQ_unspecified => {
            return "unspecified";
        },
    }
    llvm_unreachable_internal("Unknown GNUAsmQualifier", "clang\\lib\\Parse\\ParseStmtAsm.cpp", 884);
}

fn Parser::getGNUAsmQualifier(self: *Parser, Tok: *Token) -> AQ {
    match Tok.getKind() {
        kw_volatile => {
            return AQ_volatile;
        },
        kw_inline => {
            return AQ_inline;
        },
        kw_goto => {
            return AQ_goto;
        },
        _ => {
            return AQ_unspecified;
        },
    }
}

fn GNUAsmQualifiers@Parser@clang::setAsmQualifier(self, Qualifier: AQ) -> bool {
    let mut IsDuplicate: bool = self.Qualifiers & Qualifier;
    self.Qualifiers |= Qualifier;
    return IsDuplicate;
}

