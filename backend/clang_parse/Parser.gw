struct ActionCommentHandler {
    S: *mut Sema,
}

fn ActionCommentHandler::HandleComment(self, PP: *mut Preprocessor, Comment: SourceRange) -> bool {
    self.S.ActOnComment(Comment);
    return false;
}

fn Parser::isTokenSEHExcept(self) -> bool {
    if !self.Tok.is(identifier) {
        return false;
    }
    if !self.Ident__except && (self.getLangOpts().MicrosoftExt || self.getLangOpts().Borland) {
        self.Ident__except = self.PP.getIdentifierInfo("__except");
    }
    let mut Identifier: *IdentifierInfo = self.Tok.getIdentifierInfo();
    if Identifier == self.Ident__except {
        return true;
    }
    if self.getLangOpts().MSVCCompat {
        if !self.Ident_except {
            self.Ident_except = self.PP.getIdentifierInfo("_except");
        }
        if Identifier == self.Ident_except {
            return true;
        }
    }
    return false;
}

fn Parser::Parser(self, pp: *mut Preprocessor, actions: *mut Sema, skipFunctionBodies: bool) {
    self.SkipFunctionBodies = pp.isCodeCompletionEnabled() || skipFunctionBodies;
    self.Tok.startToken();
    self.Tok.setKind(eof);
    self.Actions.CurScope = null;
    self.NumCachedScopes = 0;
    self.CurParsedObjCImpl = null;
    self.initializePragmaHandlers();
    self.CommentSemaHandler.reset(actions);
    self.PP.addCommentHandler(self.CommentSemaHandler.get());
    self.PP.setCodeCompletionHandler(*self);
    self.Actions.ParseTypeFromStringCallback = Closure_1 { cap_0: self };
}

fn Parser::Diag(self, Loc: SourceLocation, DiagID: u32) -> DiagnosticBuilder {
    return self.Diags.Report(Loc, DiagID);
}

fn Parser::Diag(self, Tok: *Token, DiagID: u32) -> DiagnosticBuilder {
    return self.Diag(Tok.getLocation(), DiagID);
}

fn Parser::DiagCompat(self, Loc: SourceLocation, CompatDiagId: u32) -> DiagnosticBuilder {
    return self.Diag(Loc, getCompatDiagId(self.getLangOpts(), CompatDiagId));
}

fn Parser::DiagCompat(self, Tok: *Token, CompatDiagId: u32) -> DiagnosticBuilder {
    return self.DiagCompat(Tok.getLocation(), CompatDiagId);
}

fn Parser::SuggestParentheses(self, Loc: SourceLocation, DK: u32, ParenRange: SourceRange) {
    let mut EndLoc: SourceLocation = self.PP.getLocForEndOfToken(ParenRange.getEnd(), 0);
    if !ParenRange.getEnd().isFileID() || EndLoc.isInvalid() {
        self.Diag(Loc, DK);
        return;
    }
    self.Diag(Loc, DK) << CreateInsertion(ParenRange.getBegin(), "(", false) << CreateInsertion(EndLoc, ")", false);
}

fn IsCommonTypo(ExpectedTok: TokenKind, Tok: *Token) -> bool {
    match ExpectedTok {
        semi => {
            return Tok.is(colon) || Tok.is(comma);
        },
        _ => {
            return false;
        },
    }
}

fn Parser::ExpectAndConsume(self, ExpectedTok: TokenKind, DiagID: u32, Msg: str) -> bool {
    if self.Tok.is(ExpectedTok) || self.Tok.is(code_completion) {
        self.ConsumeAnyToken(false);
        return false;
    }
    if IsCommonTypo(ExpectedTok, self.Tok) {
        let mut Loc: SourceLocation = self.Tok.getLocation();
        {
            let mut DB: DiagnosticBuilder = self.Diag(Loc, DiagID);
            DB << CreateReplacement(Loc, getPunctuatorSpelling(ExpectedTok));
            if DiagID == err_expected {
                DB << ExpectedTok;
            } else if DiagID == err_expected_after {
                DB << Msg << ExpectedTok;
            } else {
                DB << Msg;
            }
        }
        self.ConsumeAnyToken(false);
        return false;
    }
    let mut EndLoc: SourceLocation = self.PP.getLocForEndOfToken(self.PrevTokLocation, 0);
    let mut Spelling: *u8 = null;
    if EndLoc.isValid() {
        Spelling = getPunctuatorSpelling(ExpectedTok);
    }
    let mut DB: DiagnosticBuilder = if Spelling { self.Diag(EndLoc, DiagID) << CreateInsertion(EndLoc, Spelling, false) } else { self.Diag(self.Tok, DiagID) };
    if DiagID == err_expected {
        DB << ExpectedTok;
    } else if DiagID == err_expected_after {
        DB << Msg << ExpectedTok;
    } else {
        DB << Msg;
    }
    return true;
}

fn Parser::ExpectAndConsumeSemi(self, DiagID: u32, TokenUsed: str) -> bool {
    if self.TryConsumeToken(semi) {
        return false;
    }
    if self.Tok.is(code_completion) {
        self.handleUnexpectedCodeCompletionToken();
        return false;
    }
    if (self.Tok.is(r_paren) || self.Tok.is(r_square)) && self.NextToken().is(semi) {
        self.Diag(self.Tok, err_extraneous_token_before_semi) << self.PP.getSpelling(self.Tok, null) << CreateRemoval(self.Tok.getLocation());
        self.ConsumeAnyToken(false);
        self.ConsumeToken();
        return false;
    }
    return self.ExpectAndConsume(semi, DiagID, TokenUsed);
}

fn Parser::isLikelyAtStartOfNewDeclaration(self) -> bool {
    return self.Tok.isAtStartOfLine() && self.isDeclarationSpecifier(No, false);
}

fn Parser::ConsumeExtraSemi(self, Kind: ExtraSemiKind, TST: TST) {
    if !self.Tok.is(semi) {
        return;
    }
    let mut HadMultipleSemis: bool = false;
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeToken();
    while (self.Tok.is(semi) && !self.Tok.isAtStartOfLine()) {
        HadMultipleSemis = true;
        EndLoc = self.Tok.getLocation();
        self.ConsumeToken();
    }
    if Kind == OutsideFunction && self.getLangOpts().CPlusPlus {
        if self.getLangOpts().CPlusPlus11 {
            self.Diag(StartLoc, warn_cxx98_compat_top_level_semi) << CreateRemoval(SourceRange { B: StartLoc, E: EndLoc });
        } else {
            self.Diag(StartLoc, ext_extra_semi_cxx11) << CreateRemoval(SourceRange { B: StartLoc, E: EndLoc });
        }
        return;
    }
    if Kind != AfterMemberFunctionDefinition || HadMultipleSemis {
        self.Diag(StartLoc, ext_extra_semi) << Kind << getSpecifierName(TST, self.Actions.getASTContext().getPrintingPolicy()) << CreateRemoval(SourceRange { B: StartLoc, E: EndLoc });
    } else {
        self.Diag(StartLoc, warn_extra_semi_after_mem_fn_def) << CreateRemoval(SourceRange { B: StartLoc, E: EndLoc });
    }
}

fn Parser::expectIdentifier(self) -> bool {
    if self.Tok.is(identifier) {
        return false;
    }
    if self.Tok.getIdentifierInfo() {
        II;
    } else {
        if II.isCPlusPlusKeyword(self.getLangOpts()) {
            self.Diag(self.Tok, err_expected_token_instead_of_objcxx_keyword) << identifier << self.Tok.getIdentifierInfo();
            return false;
        }
    }
    self.Diag(self.Tok, err_expected) << identifier;
    return true;
}

fn Parser::checkCompoundToken(self, FirstTokLoc: SourceLocation, FirstTokKind: TokenKind, Op: CompoundToken) {
    if FirstTokLoc.isInvalid() {
        return;
    }
    let mut SecondTokLoc: SourceLocation = self.Tok.getLocation();
    if (FirstTokLoc.isMacroID() || SecondTokLoc.isMacroID()) && self.PP.getSourceManager().getFileID(FirstTokLoc) != self.PP.getSourceManager().getFileID(SecondTokLoc) {
        self.Diag(FirstTokLoc, warn_compound_token_split_by_macro) << (FirstTokKind == self.Tok.getKind()) << FirstTokKind << self.Tok.getKind() << Op as i32 << FirstTokLoc;
        self.Diag(SecondTokLoc, note_compound_token_split_second_token_here) << (FirstTokKind == self.Tok.getKind()) << self.Tok.getKind() << SecondTokLoc;
        return;
    }
    if self.Tok.hasLeadingSpace() || self.Tok.isAtStartOfLine() {
        let mut SpaceLoc: SourceLocation = self.PP.getLocForEndOfToken(FirstTokLoc, 0);
        if SpaceLoc.isInvalid() {
            SpaceLoc = FirstTokLoc;
        }
        self.Diag(SpaceLoc, warn_compound_token_split_by_whitespace) << (FirstTokKind == self.Tok.getKind()) << FirstTokKind << self.Tok.getKind() << Op as i32 << SourceRange { B: FirstTokLoc, E: SecondTokLoc };
        return;
    }
}

fn HasFlagsSet(L: SkipUntilFlags, R: SkipUntilFlags) -> bool {
    return (L as u32 & R as u32) != 0;
}

fn Parser::SkipUntil(self, Toks: TokenKind>, Flags: SkipUntilFlags) -> bool {
    let mut isFirstTokenSkipped: bool = true;
    while true {
        for let mut i: u32 = 0;
let mut NumToks: u32 = Toks.len; i != NumToks; i += 1 {
            if self.Tok.is(Toks[i]) {
                if HasFlagsSet(Flags, StopBeforeMatch) {} else {
                    self.ConsumeAnyToken(false);
                }
                return true;
            }
        }
        if Toks.len == 1 && Toks[0] == eof && !HasFlagsSet(Flags, StopAtSemi) && !HasFlagsSet(Flags, StopAtCodeCompletion) {
            while self.Tok.isNot(eof) {
                self.ConsumeAnyToken(false);
            }
            return true;
        }
        match self.Tok.getKind() {
            eof => {
                return false;
            },
            annot_pragma_openmp => {
                annot_attr_openmp;
            },
            annot_pragma_openacc => {
                annot_pragma_openacc_end;
            },
            annot_module_begin => {
                annot_module_end;
            },
            code_completion => {
                if !HasFlagsSet(Flags, StopAtCodeCompletion) {
                    self.handleUnexpectedCodeCompletionToken();
                }
            },
            l_paren => {
                self.ConsumeParen();
            },
            l_square => {
                self.ConsumeBracket();
            },
            l_brace => {
                self.ConsumeBrace();
            },
            question => {
                self.ConsumeToken();
            },
            r_paren => {
                if self.ParenCount && !isFirstTokenSkipped {
                    return false;
                }
            },
            r_square => {
                if self.BracketCount && !isFirstTokenSkipped {
                    return false;
                }
            },
            r_brace => {
                if self.BraceCount && !isFirstTokenSkipped {
                    return false;
                }
            },
            semi => {
                if HasFlagsSet(Flags, StopAtSemi) {
                    return false;
                }
            },
            _ => {
                self.ConsumeAnyToken(false);
            },
        }
        isFirstTokenSkipped = false;
    }
}

fn Parser::EnterScope(self, ScopeFlags: u32) {
    if self.NumCachedScopes {
        let mut N: *mut Scope = self.ScopeCache[self.NumCachedScopes -= 1];
        N.Init(self.getCurScope(), ScopeFlags);
        self.Actions.CurScope = N;
    } else {
        self.Actions.CurScope = Scope { self.getCurScope(), ScopeFlags, self.Diags };
    }
}

fn Parser::ExitScope(self) {
    assert!(self.getCurScope(), "Scope imbalance!");
    self.Actions.ActOnPopScope(self.Tok.getLocation(), self.getCurScope());
    let mut OldScope: *mut Scope = self.getCurScope();
    self.Actions.CurScope = OldScope.getParent();
    if self.NumCachedScopes == ScopeCacheSize {
        OldScope;
    } else {
        self.ScopeCache[self.NumCachedScopes += 1] = OldScope;
    }
}

fn Parser@clang::ParseScopeFlags(self, Self: *mut Parser, ScopeFlags: u32, ManageFlags: bool) {
    if self.CurScope {
        self.OldFlags = self.CurScope.getFlags();
        self.CurScope.setFlags(ScopeFlags);
    }
}

fn Parser@clang::~ParseScopeFlags(self) {
    if self.CurScope {
        self.CurScope.setFlags(self.OldFlags);
    }
}

fn Parser::~Parser(self) {
    self.getCurScope();
    self.Actions.CurScope = null;
    for let mut i: u32 = 0;
let mut e: u32 = self.NumCachedScopes; i != e; i += 1 {
        self.ScopeCache[i];
    }
    self.resetPragmaHandlers();
    self.PP.removeCommentHandler(self.CommentSemaHandler.get());
    self.PP.clearCodeCompletionHandler();
    self.DestroyTemplateIds();
}

fn Parser::Initialize(self) {
    assert!(self.getCurScope() == null, "A scope is already active?");
    self.EnterScope(DeclScope);
    self.Actions.ActOnTranslationUnitScope(self.getCurScope());
    if self.getLangOpts().ObjC {
        self.ObjCTypeQuals[to_underlying(in)] = &mut self.PP.getIdentifierTable().get("in");
        self.ObjCTypeQuals[to_underlying(out)] = &mut self.PP.getIdentifierTable().get("out");
        self.ObjCTypeQuals[to_underlying(inout)] = &mut self.PP.getIdentifierTable().get("inout");
        self.ObjCTypeQuals[to_underlying(oneway)] = &mut self.PP.getIdentifierTable().get("oneway");
        self.ObjCTypeQuals[to_underlying(bycopy)] = &mut self.PP.getIdentifierTable().get("bycopy");
        self.ObjCTypeQuals[to_underlying(byref)] = &mut self.PP.getIdentifierTable().get("byref");
        self.ObjCTypeQuals[to_underlying(nonnull)] = &mut self.PP.getIdentifierTable().get("nonnull");
        self.ObjCTypeQuals[to_underlying(nullable)] = &mut self.PP.getIdentifierTable().get("nullable");
        self.ObjCTypeQuals[to_underlying(null_unspecified)] = &mut self.PP.getIdentifierTable().get("null_unspecified");
    }
    self.Ident_instancetype = null;
    self.Ident_final = null;
    self.Ident_sealed = null;
    self.Ident_abstract = null;
    self.Ident_override = null;
    self.Ident_GNU_final = null;
    self.Ident_super = &mut self.PP.getIdentifierTable().get("super");
    self.Ident_vector = null;
    self.Ident_bool = null;
    self.Ident_Bool = null;
    self.Ident_pixel = null;
    if self.getLangOpts().AltiVec || self.getLangOpts().ZVector {
        self.Ident_vector = &mut self.PP.getIdentifierTable().get("vector");
        self.Ident_bool = &mut self.PP.getIdentifierTable().get("bool");
        self.Ident_Bool = &mut self.PP.getIdentifierTable().get("_Bool");
    }
    if self.getLangOpts().AltiVec {
        self.Ident_pixel = &mut self.PP.getIdentifierTable().get("pixel");
    }
    self.Ident_introduced = null;
    self.Ident_deprecated = null;
    self.Ident_obsoleted = null;
    self.Ident_unavailable = null;
    self.Ident_strict = null;
    self.Ident_replacement = null;
    self.Ident_language = self.Ident_defined_in = self.Ident_generated_declaration = self.Ident_USR = null;
    self.Ident__except = null;
    self.Ident_except = null;
    self.Ident__exception_code = self.Ident__exception_info = null;
    self.Ident__abnormal_termination = self.Ident___exception_code = null;
    self.Ident___exception_info = self.Ident___abnormal_termination = null;
    self.Ident_GetExceptionCode = self.Ident_GetExceptionInfo = null;
    self.Ident_AbnormalTermination = null;
    if self.getLangOpts().Borland {
        self.Ident__exception_info = self.PP.getIdentifierInfo("_exception_info");
        self.Ident___exception_info = self.PP.getIdentifierInfo("__exception_info");
        self.Ident_GetExceptionInfo = self.PP.getIdentifierInfo("GetExceptionInformation");
        self.Ident__exception_code = self.PP.getIdentifierInfo("_exception_code");
        self.Ident___exception_code = self.PP.getIdentifierInfo("__exception_code");
        self.Ident_GetExceptionCode = self.PP.getIdentifierInfo("GetExceptionCode");
        self.Ident__abnormal_termination = self.PP.getIdentifierInfo("_abnormal_termination");
        self.Ident___abnormal_termination = self.PP.getIdentifierInfo("__abnormal_termination");
        self.Ident_AbnormalTermination = self.PP.getIdentifierInfo("AbnormalTermination");
        self.PP.SetPoisonReason(self.Ident__exception_code, err_seh___except_block);
        self.PP.SetPoisonReason(self.Ident___exception_code, err_seh___except_block);
        self.PP.SetPoisonReason(self.Ident_GetExceptionCode, err_seh___except_block);
        self.PP.SetPoisonReason(self.Ident__exception_info, err_seh___except_filter);
        self.PP.SetPoisonReason(self.Ident___exception_info, err_seh___except_filter);
        self.PP.SetPoisonReason(self.Ident_GetExceptionInfo, err_seh___except_filter);
        self.PP.SetPoisonReason(self.Ident__abnormal_termination, err_seh___finally_block);
        self.PP.SetPoisonReason(self.Ident___abnormal_termination, err_seh___finally_block);
        self.PP.SetPoisonReason(self.Ident_AbnormalTermination, err_seh___finally_block);
    }
    self.Actions.Initialize();
    self.ConsumeToken();
}

fn Parser::DestroyTemplateIds(self) {
    for Id in self.TemplateIds {
        Id.Destroy();
    }
    self.TemplateIds.clear();
}

fn Parser::ParseFirstTopLevelDecl(self, Result: *mut DeclGroupPtrTy, ImportState: *mut ModuleImportState) -> bool {
    self.Actions.ActOnStartOfTranslationUnit();
    ImportState = FirstDecl;
    let mut NoTopLevelDecls: bool = self.ParseTopLevelDecl(Result, ImportState);
    if NoTopLevelDecls && !self.Actions.getASTContext().getExternalSource() && !self.getLangOpts().CPlusPlus && !self.getLangOpts().IsHeaderFile {
        self.Diag(ext_empty_translation_unit);
    }
    return NoTopLevelDecls;
}

fn Parser::ParseTopLevelDecl(self, Result: *mut DeclGroupPtrTy, ImportState: *mut ModuleImportState) -> bool {
    let mut CleanupRAII: DestroyTemplateIdAnnotationsRAIIObj = *self;
    Result = null;
    match self.Tok.getKind() {
        annot_pragma_unused => {
            self.HandlePragmaUnused();
        },
        kw_export => {
            match self.NextToken().getKind() {
                kw_module => {
                    
                },
                kw_import => {
                    
                },
                _ => {
                    break;
                },
            }
        },
        kw_module => {
            Result = self.ParseModuleDecl(ImportState);
        },
        kw_import => {
            self.ParseModuleImport(SourceLocation {}, ImportState);
        },
        annot_module_include => {
            let mut Loc: SourceLocation = self.Tok.getLocation();
            let mut Mod: *mut Module = self.Tok.getAnnotationValue() as *mut Module;
            if !self.getLangOpts().CPlusPlusModules || !Mod.isHeaderUnit() {
                self.Actions.ActOnAnnotModuleInclude(Loc, Mod);
            } else {
                let mut Import: DeclResult = self.Actions.ActOnModuleImport(Loc, SourceLocation {}, Loc, Mod, ModuleIdPath {});
                let mut ImportDecl: *mut Decl = if Import.isInvalid() { null } else { Import.get() };
                Result = self.Actions.ConvertDeclToDeclGroup(ImportDecl, null);
            }
            self.ConsumeAnnotationToken();
            return false;
        },
        annot_module_begin => {
            self.Actions.ActOnAnnotModuleBegin(self.Tok.getLocation(), self.Tok.getAnnotationValue() as *mut Module);
        },
        annot_module_end => {
            self.Actions.ActOnAnnotModuleEnd(self.Tok.getLocation(), self.Tok.getAnnotationValue() as *mut Module);
        },
        eof => {
            annot_repl_input_end;
        },
        _ => {
            break;
        },
    }
    let mut DeclAttrs: ParsedAttributes = self.AttrFactory;
    let mut DeclSpecAttrs: ParsedAttributes = self.AttrFactory;
    while self.MaybeParseCXX11Attributes(DeclAttrs, false) || self.MaybeParseGNUAttributes(DeclSpecAttrs, null) {
        
    }
    Result = self.ParseExternalDeclaration(DeclAttrs, DeclSpecAttrs, null);
    if Result {
        if ImportState == FirstDecl {
            ImportState = NotACXX20Module;
        } else if ImportState == ImportAllowed {
            ImportState = ImportFinished;
        } else if ImportState == PrivateFragmentImportAllowed {
            ImportState = PrivateFragmentImportFinished;
        }
    }
    return false;
}

fn Parser::ParseExternalDeclaration(self, Attrs: *mut ParsedAttributes, DeclSpecAttrs: *mut ParsedAttributes, DS: *mut ParsingDeclSpec) -> DeclGroupPtrTy {
    let mut CleanupRAII: DestroyTemplateIdAnnotationsRAIIObj = *self;
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    if self.PP.isCodeCompletionReached() {
        self.cutOffParsing();
        return null;
    }
    let mut SingleDecl: *mut Decl = null;
    match self.Tok.getKind() {
        annot_pragma_vis => {
            self.HandlePragmaVisibility();
        },
        annot_pragma_pack => {
            self.HandlePragmaPack();
        },
        annot_pragma_msstruct => {
            self.HandlePragmaMSStruct();
        },
        annot_pragma_align => {
            self.HandlePragmaAlign();
        },
        annot_pragma_weak => {
            self.HandlePragmaWeak();
        },
        annot_pragma_weakalias => {
            self.HandlePragmaWeakAlias();
        },
        annot_pragma_redefine_extname => {
            self.HandlePragmaRedefineExtname();
        },
        annot_pragma_fp_contract => {
            self.HandlePragmaFPContract();
        },
        annot_pragma_fenv_access => {
            annot_pragma_fenv_access_ms;
        },
        annot_pragma_fenv_round => {
            self.HandlePragmaFEnvRound();
        },
        annot_pragma_cx_limited_range => {
            self.HandlePragmaCXLimitedRange();
        },
        annot_pragma_float_control => {
            self.HandlePragmaFloatControl();
        },
        annot_pragma_fp => {
            self.HandlePragmaFP();
        },
        annot_pragma_opencl_extension => {
            self.HandlePragmaOpenCLExtension();
        },
        annot_attr_openmp => {
            annot_pragma_openmp;
        },
        annot_pragma_openacc => {
            let mut AS: AccessSpecifier = AS_none;
            return self.ParseOpenACCDirectiveDecl(AS, Attrs, TST_unspecified, null);
        },
        annot_pragma_ms_pointers_to_members => {
            self.HandlePragmaMSPointersToMembers();
        },
        annot_pragma_ms_vtordisp => {
            self.HandlePragmaMSVtorDisp();
        },
        annot_pragma_ms_pragma => {
            self.HandlePragmaMSPragma();
        },
        annot_pragma_dump => {
            self.HandlePragmaDump();
        },
        annot_pragma_attribute => {
            self.HandlePragmaAttribute();
        },
        annot_pragma_export => {
            self.HandlePragmaExport();
        },
        semi => {
            SingleDecl = self.Actions.ActOnEmptyDeclaration(self.getCurScope(), Attrs, self.Tok.getLocation());
        },
        r_brace => {
            self.Diag(self.Tok, err_extraneous_closing_brace);
        },
        eof => {
            self.Diag(self.Tok, err_expected_external_declaration);
        },
        kw___extension__ => {
            let mut O: ExtensionRAIIObject = self.Diags;
            self.ConsumeToken();
            return self.ParseExternalDeclaration(Attrs, DeclSpecAttrs, null);
        },
        kw_asm => {
            self.ProhibitAttributes(Attrs, SourceLocation {});
            let mut StartLoc: SourceLocation = self.Tok.getLocation();
            let mut EndLoc: SourceLocation = SourceLocation {};
            let mut Result: ExprResult = self.ParseSimpleAsm(false, &mut EndLoc);
            if !(self.getLangOpts().GNUAsm || Result.isInvalid()) {
                let mut SL: *StringLiteral const = cast(Result.get());
                if !SL.getString().trim(" \t\n\v\f\r").is_empty() {
                    self.Diag(StartLoc, err_gnu_inline_asm_disabled);
                }
            }
            self.ExpectAndConsume(semi, err_expected_after, "top-level asm block");
            if Result.isInvalid() {
                return null;
            }
            SingleDecl = self.Actions.ActOnFileScopeAsmDecl(Result.get(), StartLoc, EndLoc);
            break;
        },
        at => {
            return self.ParseObjCAtDirectives(Attrs, DeclSpecAttrs);
        },
        minus => {
            plus;
        },
        code_completion => {
            self.cutOffParsing();
        },
        kw_import => {
            let mut IS: ModuleImportState = NotACXX20Module;
            if self.getLangOpts().CPlusPlusModules {
                self.Diag(self.Tok, err_unexpected_module_or_import_decl) << true;
                self.SkipUntil(semi, 0 as SkipUntilFlags);
                return null;
            }
            SingleDecl = self.ParseModuleImport(SourceLocation {}, IS);
        },
        kw_export => {
            if self.getLangOpts().CPlusPlusModules || self.getLangOpts().HLSL {
                self.ProhibitAttributes(Attrs, SourceLocation {});
                SingleDecl = self.ParseExportDeclaration();
                break;
            }
        },
        kw_using => {
            kw_namespace;
        },
        kw_cbuffer => {
            kw_tbuffer;
        },
        kw_static => {
            if self.getLangOpts().CPlusPlus && self.NextToken().is(kw_template) {
                self.Diag(self.ConsumeToken(), warn_static_inline_explicit_inst_ignored) << 0;
                let mut DeclEnd: SourceLocation = SourceLocation {};
                return self.ParseDeclaration(File, DeclEnd, Attrs, DeclSpecAttrs, null);
            }
        },
        kw_inline => {
            if self.getLangOpts().CPlusPlus {
                let mut NextKind: TokenKind = self.NextToken().getKind();
                if NextKind == kw_namespace {
                    let mut DeclEnd: SourceLocation = SourceLocation {};
                    return self.ParseDeclaration(File, DeclEnd, Attrs, DeclSpecAttrs, null);
                }
                if NextKind == kw_template {
                    self.Diag(self.ConsumeToken(), warn_static_inline_explicit_inst_ignored) << 1;
                    let mut DeclEnd: SourceLocation = SourceLocation {};
                    return self.ParseDeclaration(File, DeclEnd, Attrs, DeclSpecAttrs, null);
                }
            }
        },
        kw_extern => {
            if self.getLangOpts().CPlusPlus && self.NextToken().is(kw_template) {
                self.ProhibitAttributes(Attrs, SourceLocation {});
                self.ProhibitAttributes(DeclSpecAttrs, SourceLocation {});
                let mut ExternLoc: SourceLocation = self.ConsumeToken();
                let mut TemplateLoc: SourceLocation = self.ConsumeToken();
                self.DiagCompat(ExternLoc, extern_template) << SourceRange { B: ExternLoc, E: TemplateLoc };
                let mut DeclEnd: SourceLocation = SourceLocation {};
                return self.ParseExplicitInstantiation(File, ExternLoc, TemplateLoc, DeclEnd, Attrs, AS_none);
            }
        },
        kw___if_exists => {
            kw___if_not_exists;
        },
        kw_module => {
            self.Diag(self.Tok, err_unexpected_module_or_import_decl) << false;
        },
        _ => {
            self.Tok.isEditorPlaceholder();
        },
    }
    return self.Actions.ConvertDeclToDeclGroup(SingleDecl, null);
}

fn Parser::isDeclarationAfterDeclarator(self) -> bool {
    if self.getLangOpts().CPlusPlus && self.Tok.is(equal) {
        let mut KW: *Token = self.NextToken();
        if KW.is(kw_default) || KW.is(kw_delete) {
            return false;
        }
    }
    return self.Tok.is(equal) || self.Tok.is(comma) || self.Tok.is(semi) || self.Tok.is(kw_asm) || self.Tok.is(kw___attribute) || (self.getLangOpts().CPlusPlus && self.Tok.is(l_paren));
}

fn Parser::isStartOfFunctionDefinition(self, Declarator: *ParsingDeclarator) -> bool {
    assert!(Declarator.isFunctionDeclarator(), "Isn't a function declarator");
    if self.Tok.is(l_brace) {
        return true;
    }
    if !self.getLangOpts().CPlusPlus && Declarator.getFunctionTypeInfo().isKNRPrototype() {
        return self.isDeclarationSpecifier(No, false);
    }
    if self.getLangOpts().CPlusPlus && self.Tok.is(equal) {
        let mut KW: *Token = self.NextToken();
        return KW.is(kw_default) || KW.is(kw_delete);
    }
    return self.Tok.is(colon) || self.Tok.is(kw_try);
}

fn Parser::ParseDeclOrFunctionDefInternal(self, Attrs: *mut ParsedAttributes, DeclSpecAttrs: *mut ParsedAttributes, DS: *mut ParsingDeclSpec, AS: AccessSpecifier) -> DeclGroupPtrTy {
    assert!(DS.getSourceRange().isInvalid(), "expected uninitialised source range");
    DS.SetRangeStart(DeclSpecAttrs.Range.getBegin());
    DS.SetRangeEnd(DeclSpecAttrs.Range.getEnd());
    DS.takeAttributesAppendingingFrom(DeclSpecAttrs);
    let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
    self.MaybeParseMicrosoftAttributes(DS.getAttributes());
    self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS, DSC_top_level, null);
    if DS.hasTagDefinition() && self.DiagnoseMissingSemiAfterTagDefinition(DS, AS, DSC_top_level, null) {
        return null;
    }
    if self.Tok.is(semi) {
        let mut CorrectLocationForAttributes: SourceLocation = SourceLocation {};
        let mut TKind: TypeSpecifierType = DS.getTypeSpecType();
        if isDeclRep(TKind) {
            if TKind == TST_enum {
                if dyn_cast_or_null(DS.getRepAsDecl()) {
                    ED;
                } else {
                    CorrectLocationForAttributes = self.PP.getLocForEndOfToken(ED.getEnumKeyRange().getEnd(), 0);
                }
            }
            if CorrectLocationForAttributes.isInvalid() {
                let mut Policy: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
                let mut Offset: u32 = getSpecifierName(TKind, Policy).len;
                CorrectLocationForAttributes = DS.getTypeSpecTypeLoc().getLocWithOffset(Offset);
            }
        }
        self.ProhibitAttributes(Attrs, CorrectLocationForAttributes);
        self.ConsumeToken();
        let mut AnonRecord: *mut RecordDecl = null;
        let mut TheDecl: *mut Decl = self.Actions.ParsedFreeStandingDeclSpec(self.getCurScope(), AS_none, DS, none(), AnonRecord);
        DS.complete(TheDecl);
        self.Actions.ActOnDefinedDeclarationSpecifier(TheDecl);
        if AnonRecord {
            let mut decls: [2]*mut Decl = [AnonRecord, TheDecl];
            return self.Actions.BuildDeclaratorGroup(decls);
        }
        return self.Actions.ConvertDeclToDeclGroup(TheDecl, null);
    }
    if DS.hasTagDefinition() {
        self.Actions.ActOnDefinedDeclarationSpecifier(DS.getRepAsDecl());
    }
    if self.getLangOpts().ObjC && self.Tok.is(at) {
        let mut AtLoc: SourceLocation = self.ConsumeToken();
        if !self.Tok.isObjCAtKeyword(objc_interface) && !self.Tok.isObjCAtKeyword(objc_protocol) && !self.Tok.isObjCAtKeyword(objc_implementation) {
            self.Diag(self.Tok, err_objc_unexpected_attr);
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        DS.abort();
        DS.takeAttributesAppendingingFrom(Attrs);
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        if DS.SetTypeSpecType(TST_unspecified, AtLoc, PrevSpec, DiagID, self.Actions.getASTContext().getPrintingPolicy()) {
            self.Diag(AtLoc, DiagID) << PrevSpec;
        }
        if self.Tok.isObjCAtKeyword(objc_protocol) {
            return self.ParseObjCAtProtocolDeclaration(AtLoc, DS.getAttributes());
        }
        if self.Tok.isObjCAtKeyword(objc_implementation) {
            return self.ParseObjCAtImplementationDeclaration(AtLoc, DS.getAttributes());
        }
        return self.Actions.ConvertDeclToDeclGroup(self.ParseObjCAtInterfaceDeclaration(AtLoc, DS.getAttributes()), null);
    }
    if self.getLangOpts().CPlusPlus && self.isTokenStringLiteral() && DS.getStorageClassSpec() == SCS_extern && DS.getParsedSpecifiers() == PQ_StorageClassSpecifier {
        self.ProhibitAttributes(Attrs, SourceLocation {});
        let mut TheDecl: *mut Decl = self.ParseLinkage(DS, File);
        return self.Actions.ConvertDeclToDeclGroup(TheDecl, null);
    }
    return self.ParseDeclGroup(DS, File, Attrs, TemplateInfo, null, null);
}

fn Parser::ParseDeclarationOrFunctionDefinition(self, Attrs: *mut ParsedAttributes, DeclSpecAttrs: *mut ParsedAttributes, DS: *mut ParsingDeclSpec, AS: AccessSpecifier) -> DeclGroupPtrTy {
    let mut TimeScope: TimeTraceScope = TimeTraceScope { "ParseDeclarationOrFunctionDefinition", string ()> { Closure_2 { cap_0: self }, null, null } };
    if DS {
        return self.ParseDeclOrFunctionDefInternal(Attrs, DeclSpecAttrs, *DS, AS);
    } else {
        let mut PDS: ParsingDeclSpec = *self;
        let mut ObjCDC: ObjCDeclContextSwitch = *self;
        return self.ParseDeclOrFunctionDefInternal(Attrs, DeclSpecAttrs, PDS, AS);
    }
}

fn Parser::ParseFunctionDefinition(self, D: *mut ParsingDeclarator, TemplateInfo: *ParsedTemplateInfo, LateParsedAttrs: *mut LateParsedAttrList) -> *mut Decl {
    let mut TimeScope: TimeTraceScope = TimeTraceScope { "ParseFunctionDefinition", string ()> { Closure_3 { cap_0: self, D: &mut D }, null, null } };
    let mut PoisonSEHIdentifiers: PoisonSEHIdentifiersRAIIObject = PoisonSEHIdentifiersRAIIObject { *self, true };
    let mut FTI: *FunctionTypeInfo = D.getFunctionTypeInfo();
    let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
    if self.getLangOpts().isImplicitIntRequired() && D.getDeclSpec().isEmpty() {
        self.Diag(D.getIdentifierLoc(), warn_missing_type_specifier) << D.getDeclSpec().getSourceRange() << CreateInsertion(D.getDeclSpec().getBeginLoc(), "int ", false);
        let mut PrevSpec: *u8 = null;
        let mut DiagID: u32 = 0;
        let mut Policy: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
        D.getMutableDeclSpec().SetTypeSpecType(TST_int, D.getIdentifierLoc(), PrevSpec, DiagID, Policy);
        D.SetRangeBegin(D.getDeclSpec().getSourceRange().getBegin());
    }
    if FTI.isKNRPrototype() {
        self.ParseKNRParamDeclarations(D);
    }
    if self.Tok.isNot(l_brace) && (!self.getLangOpts().CPlusPlus || (self.Tok.isNot(colon) && self.Tok.isNot(kw_try) && self.Tok.isNot(equal))) {
        self.Diag(self.Tok, err_expected_fn_body);
        self.SkipUntil(l_brace, StopAtSemi | StopBeforeMatch);
        if self.Tok.isNot(l_brace) {
            return null;
        }
    }
    if self.Tok.isNot(equal) {
        for AL in D.getAttributes() {
            if AL.isKnownToGCC() && !AL.isStandardAttributeSyntax() {
                self.Diag(AL.getLoc(), warn_attribute_on_function_definition) << AL;
            }
        }
    }
    if self.getLangOpts().DelayedTemplateParsing && self.Tok.isNot(equal) && TemplateInfo.Kind == Template && LateParsedAttrs.is_empty() && self.Actions.canDelayFunctionBody(D) {
        let mut TemplateParameterLists: MultiTemplateParamsArg = *TemplateInfo.TemplateParams;
        let mut BodyScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope, true, false };
        let mut ParentScope: *mut Scope = self.getCurScope().getParent();
        D.setFunctionDefinitionKind(Definition);
        let mut DP: *mut Decl = self.Actions.HandleDeclarator(ParentScope, D, TemplateParameterLists);
        D.complete(DP);
        D.getMutableDeclSpec().abort();
        if self.SkipFunctionBodies && (!DP || self.Actions.canSkipFunctionBody(DP)) && self.trySkippingFunctionBody() {
            BodyScope.Exit();
            return self.Actions.ActOnSkippedFunctionBody(DP);
        }
        let mut Toks: CachedTokens = CachedTokens {};
        self.LexTemplateFunctionForLateParsing(Toks);
        if DP {
            let mut FnD: *mut FunctionDecl = DP.getAsFunction();
            self.Actions.CheckForFunctionRedefinition(FnD, null, null);
            self.Actions.MarkAsLateParsedTemplate(FnD, DP, Toks);
        }
        return DP;
    }
    if self.CurParsedObjCImpl && !TemplateInfo.TemplateParams && (self.Tok.is(l_brace) || self.Tok.is(kw_try) || self.Tok.is(colon)) && self.Actions.CurContext.isTranslationUnit() {
        let mut BodyScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope, true, false };
        let mut ParentScope: *mut Scope = self.getCurScope().getParent();
        D.setFunctionDefinitionKind(Definition);
        let mut FuncDecl: *mut Decl = self.Actions.HandleDeclarator(ParentScope, D, MultiTemplateParamsArg {});
        D.complete(FuncDecl);
        D.getMutableDeclSpec().abort();
        if FuncDecl {
            self.StashAwayMethodOrFunctionBodyTokens(FuncDecl);
            self.CurParsedObjCImpl.HasCFunction = true;
            return FuncDecl;
        }
    }
    let mut BodyScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope, true, false };
    let mut DeletedMessage: *mut StringLiteral = null;
    let mut BodyKind: FnBodyKind = Other;
    let mut KWLoc: SourceLocation = SourceLocation {};
    if self.TryConsumeToken(equal) {
        assert!(self.getLangOpts().CPlusPlus, "Only C++ function definitions have '='");
        if self.TryConsumeToken(kw_delete, KWLoc) {
            self.DiagCompat(KWLoc, defaulted_deleted_function) << 1;
            BodyKind = Delete;
            DeletedMessage = self.ParseCXXDeletedFunctionMessage();
            D.SetRangeEnd(self.PrevTokLocation);
        } else if self.TryConsumeToken(kw_default, KWLoc) {
            self.DiagCompat(KWLoc, defaulted_deleted_function) << 0;
            BodyKind = Default;
            D.SetRangeEnd(self.PrevTokLocation);
        } else {
            llvm_unreachable_internal("function definition after = not 'delete' or 'default'", "P:/Goraw/llvm-project/clang/lib/Parse/Parser.cpp", 1328);
        }
        if self.Tok.is(comma) {
            self.Diag(KWLoc, err_default_delete_in_multiple_declaration) << (BodyKind == Delete);
            self.SkipUntil(semi, 0 as SkipUntilFlags);
        } else if self.ExpectAndConsume(semi, err_expected_after, if BodyKind == Delete { "delete" } else { "default" }) {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
        }
    }
    let mut SaveFPFeatures: FPFeaturesStateRAII = self.Actions;
    let mut SkipBody: SkipBodyInfo = SkipBodyInfo {};
    let mut Res: *mut Decl = self.Actions.ActOnStartOfFunctionDef(self.getCurScope(), D, if TemplateInfo.TemplateParams { *TemplateInfo.TemplateParams } else { MultiTemplateParamsArg {} }, &mut SkipBody, BodyKind);
    if SkipBody.ShouldSkip {
        if BodyKind == Other {
            self.SkipFunctionBody();
        }
        if !isLambdaCallOperator(dyn_cast_if_present(Res)) {
            self.Actions.PopExpressionEvaluationContext();
        }
        return Res;
    }
    D.complete(Res);
    D.getMutableDeclSpec().abort();
    if BodyKind != Other {
        self.Actions.SetFunctionBodyKind(Res, KWLoc, BodyKind, DeletedMessage);
        let mut GeneratedBody: *mut Stmt = if Res { Res.getBody() } else { null };
        self.Actions.ActOnFinishFunctionBody(Res, GeneratedBody, false, false);
        return Res;
    }
    let mut Template: *FunctionTemplateDecl const = dyn_cast_if_present(Res);
    if Template && Template.isAbbreviated() && Template.getTemplateParameters().getParam(0).isImplicit() {
        CurTemplateDepthTracker.addDepth(1);
    }
    if LateParsedAttrs {
        self.ParseLexedAttributeList(*LateParsedAttrs, Res, false, true, null);
    }
    if self.SkipFunctionBodies && (!Res || self.Actions.canSkipFunctionBody(Res)) && self.trySkippingFunctionBody() {
        BodyScope.Exit();
        self.Actions.ActOnSkippedFunctionBody(Res);
        return self.Actions.ActOnFinishFunctionBody(Res, null, false, false);
    }
    return self.ParseFunctionBody(Res, BodyScope);
}

fn Parser::ParseFunctionBody(self, D: *mut Decl, BodyScope: *mut ParseScope) -> *mut Decl {
    if self.Tok.is(kw_try) {
        return self.ParseFunctionTryBlock(D, BodyScope);
    }
    if self.Tok.is(colon) {
        self.ParseConstructorInitializer(D);
        if !self.Tok.is(l_brace) {
            BodyScope.Exit();
            if D {
                D.getAsFunction().setInvalidDecl(true);
            }
            self.Actions.ActOnFinishFunctionBody(D, null, false, false);
            return D;
        }
    } else {
        self.Actions.ActOnDefaultCtorInitializers(D);
    }
    return self.ParseFunctionStatementBody(D, BodyScope);
}

fn Parser::SkipFunctionBody(self) {
    if self.Tok.is(equal) {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return;
    }
    let mut IsFunctionTryBlock: bool = self.Tok.is(kw_try);
    if IsFunctionTryBlock {
        self.ConsumeToken();
    }
    let mut Skipped: CachedTokens = CachedTokens {};
    if self.ConsumeAndStoreFunctionPrologue(Skipped) {
        self.SkipMalformedDecl();
    } else {
        self.SkipUntil(r_brace, 0 as SkipUntilFlags);
        while IsFunctionTryBlock && self.Tok.is(kw_catch) {
            self.SkipUntil(l_brace, 0 as SkipUntilFlags);
            self.SkipUntil(r_brace, 0 as SkipUntilFlags);
        }
    }
}

fn Parser::ParseKNRParamDeclarations(self, D: *mut Declarator) {
    let mut FTI: *mut FunctionTypeInfo = D.getFunctionTypeInfo();
    let mut PrototypeScope: ParseScope = ParseScope { self, FunctionPrototypeScope | FunctionDeclarationScope | DeclScope, true, false };
    while self.isDeclarationSpecifier(No, false) {
        let mut DSStart: SourceLocation = self.Tok.getLocation();
        let mut DS: DeclSpec = self.AttrFactory;
        let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
        self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS_none, DSC_normal, null);
        if self.TryConsumeToken(semi) {
            self.Diag(DSStart, err_declaration_does_not_declare_param);
            continue;
        }
        if DS.getStorageClassSpec() != SCS_unspecified && DS.getStorageClassSpec() != SCS_register {
            self.Diag(DS.getStorageClassSpecLoc(), err_invalid_storage_class_in_func_decl);
            DS.ClearStorageClassSpecs();
        }
        if DS.getThreadStorageClassSpec() != TSCS_unspecified {
            self.Diag(DS.getThreadStorageClassSpecLoc(), err_invalid_storage_class_in_func_decl);
            DS.ClearStorageClassSpecs();
        }
        let mut ParmDeclarator: Declarator = Declarator { DS, none(), KNRTypeList };
        self.ParseDeclarator(ParmDeclarator);
        while true {
            self.MaybeParseGNUAttributes(ParmDeclarator, null);
            let mut Param: *mut Decl = self.Actions.ActOnParamDeclarator(self.getCurScope(), ParmDeclarator, SourceLocation {});
            if Param && ParmDeclarator.getIdentifier() {
                for let mut i: u32 = 0; ; i += 1 {
                    if i == FTI.NumParams {
                        self.Diag(ParmDeclarator.getIdentifierLoc(), err_no_matching_param) << ParmDeclarator.getIdentifier();
                        break;
                    }
                    if FTI.Params[i].Ident == ParmDeclarator.getIdentifier() {
                        if FTI.Params[i].Param {
                            self.Diag(ParmDeclarator.getIdentifierLoc(), err_param_redefinition) << ParmDeclarator.getIdentifier();
                        } else {
                            FTI.Params[i].Param = Param;
                        }
                        break;
                    }
                }
            }
            if self.Tok.isNot(comma) {
                break;
            }
            ParmDeclarator.clear();
            ParmDeclarator.setCommaLoc(self.ConsumeToken());
            self.ParseDeclarator(ParmDeclarator);
        }
        if !self.ExpectAndConsumeSemi(err_expected_semi_declaration, "") {
            continue;
        }
        if self.SkipUntil(l_brace, StopAtSemi | StopBeforeMatch) {
            break;
        }
        self.TryConsumeToken(semi);
    }
    self.Actions.ActOnFinishKNRParamDeclarations(self.getCurScope(), D, self.Tok.getLocation());
}

fn Parser::ParseAsmStringLiteral(self, ForAsmLabel: bool) -> ExprResult {
    let mut AsmString: ExprResult = false;
    if self.isTokenStringLiteral() {
        AsmString = self.ParseStringLiteralExpression(false);
        if AsmString.isInvalid() {
            return AsmString;
        }
        let mut SL: *StringLiteral const = cast(AsmString.get());
        if !SL.isOrdinary() {
            self.Diag(self.Tok, err_asm_operand_wide_string_literal) << SL.isWide() << SL.getSourceRange();
            return ExprError();
        }
    } else if !ForAsmLabel && self.getLangOpts().CPlusPlus11 && self.Tok.is(l_paren) {
        let mut ExprType: ParenParseOption = SimpleExpr;
        let mut RParenLoc: SourceLocation = SourceLocation {};
        let mut CastTy: ParsedType = null;
        let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
        AsmString = self.ParseParenExpression(ExprType, true, Unknown, AllowBoth, CastTy, RParenLoc);
        if !AsmString.isInvalid() {
            AsmString = self.Actions.ActOnConstantExpression(AsmString);
        }
        if AsmString.isInvalid() {
            return ExprError();
        }
    } else {
        self.Diag(self.Tok, err_asm_expected_string) << (if (self.getLangOpts().CPlusPlus11 && !ForAsmLabel) { 0 } else { 1 });
    }
    return self.Actions.ActOnGCCAsmStmtString(AsmString.get(), ForAsmLabel);
}

fn Parser::ParseSimpleAsm(self, ForAsmLabel: bool, EndLoc: *mut SourceLocation) -> ExprResult {
    assert!(self.Tok.is(kw_asm), "Not an asm!");
    let mut Loc: SourceLocation = self.ConsumeToken();
    if self.isGNUAsmQualifier(self.Tok) {
        let mut RemovalRange: SourceRange = SourceRange { B: self.PP.getLocForEndOfToken(Loc, 0), E: self.PP.getLocForEndOfToken(self.Tok.getLocation(), 0) };
        self.Diag(self.Tok, err_global_asm_qualifier_ignored) << getQualifierName(self.getGNUAsmQualifier(self.Tok)) << CreateRemoval(RemovalRange);
        self.ConsumeToken();
    }
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected_lparen_after) << "asm";
        return ExprError();
    }
    let mut Result: ExprResult = self.ParseAsmStringLiteral(ForAsmLabel);
    if !Result.isInvalid() {
        T.consumeClose();
        if EndLoc {
            *EndLoc = T.getCloseLocation();
        }
    } else if self.SkipUntil(r_paren, StopAtSemi | StopBeforeMatch) {
        if EndLoc {
            *EndLoc = self.Tok.getLocation();
        }
        self.ConsumeParen();
    }
    return Result;
}

fn Parser::takeTemplateIdAnnotation(self, tok: *Token) -> *mut TemplateIdAnnotation {
    assert!(tok.is(annot_template_id), "Expected template-id token");
    let mut Id: *mut TemplateIdAnnotation = tok.getAnnotationValue() as *mut TemplateIdAnnotation;
    return Id;
}

fn Parser::AnnotateScopeToken(self, SS: *mut CXXScopeSpec, IsNewAnnotation: bool) {
    if self.PP.isBacktrackEnabled() {
        self.PP.RevertCachedTokens(1);
    } else {
        self.PP.EnterToken(self.Tok, true);
    }
    self.Tok.setKind(annot_cxxscope);
    self.Tok.setAnnotationValue(self.Actions.SaveNestedNameSpecifierAnnotation(SS));
    self.Tok.setAnnotationRange(SS.getRange());
    if IsNewAnnotation {
        self.PP.AnnotateCachedTokens(self.Tok);
    }
}

fn Parser::TryAnnotateName(self, CCC: *mut CorrectionCandidateCallback, AllowImplicitTypename: ImplicitTypenameContext) -> AnnotatedNameKind {
    assert!(self.Tok.is(identifier) || self.Tok.is(annot_cxxscope);
    let mut EnteringContext: bool = false;
    let mut WasScopeAnnotation: bool = self.Tok.is(annot_cxxscope);
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if self.getLangOpts().CPlusPlus && self.ParseOptionalCXXScopeSpecifier(SS, null, false, EnteringContext, null, false, null, false, false, false, false, false) {
        return Error;
    }
    if self.Tok.isNot(identifier) || SS.isInvalid() {
        if self.TryAnnotateTypeOrScopeTokenAfterScopeSpec(SS, !WasScopeAnnotation, AllowImplicitTypename) {
            return Error;
        }
        return Unresolved;
    }
    let mut Name: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut NameLoc: SourceLocation = self.Tok.getLocation();
    if self.isTentativelyDeclared(Name) && SS.isEmpty() {
        if self.TryAnnotateTypeOrScopeTokenAfterScopeSpec(SS, !WasScopeAnnotation, AllowImplicitTypename) {
            return Error;
        }
        return if self.Tok.is(annot_typename) { Success } else { TentativeDecl };
    }
    let mut Next: Token = self.NextToken();
    let mut Classification: NameClassification = self.Actions.ClassifyName(self.getCurScope(), SS, Name, NameLoc, Next, if SS.isEmpty() { CCC } else { null });
    if Classification.getKind() == UndeclaredTemplate && self.isTemplateArgumentList(1) == False {
        let mut FakeNext: Token = Next;
        FakeNext.setKind(unknown);
        Classification = self.Actions.ClassifyName(self.getCurScope(), SS, Name, NameLoc, FakeNext, if SS.isEmpty() { CCC } else { null });
    }
    match Classification.getKind() {
        Error => {
            return Error;
        },
        Keyword => {
            self.Tok.setIdentifierInfo(Name);
        },
        Unknown => {
            break;
        },
        Type => {
            if self.TryAltiVecVectorToken() {
                break;
            }
            let mut BeginLoc: SourceLocation = NameLoc;
            if SS.isNotEmpty() {
                BeginLoc = SS.getBeginLoc();
            }
            let mut Ty: ParsedType = Classification.getType();
            let mut T: QualType = self.Actions.GetTypeFromParser(Ty, null);
            if self.getLangOpts().ObjC && self.NextToken().is(less) && (operator(T).isObjCObjectType() || operator(T).isObjCObjectPointerType()) {
                let mut IdentifierLoc: SourceLocation = self.ConsumeToken();
                let mut NewEndLoc: SourceLocation = SourceLocation {};
                let mut NewType: TypeResult = self.parseObjCTypeArgsAndProtocolQualifiers(IdentifierLoc, Ty, false, NewEndLoc);
                if NewType.isUsable() {
                    Ty = NewType.get();
                } else if self.Tok.is(eof) {
                    return Error;
                }
            }
            self.Tok.setKind(annot_typename);
            setTypeAnnotation(self.Tok, Ty);
            self.Tok.setAnnotationEndLoc(self.Tok.getLocation());
            self.Tok.setLocation(BeginLoc);
            self.PP.AnnotateCachedTokens(self.Tok);
            return Success;
        },
        OverloadSet => {
            self.Tok.setKind(annot_overload_set);
        },
        NonType => {
            if self.TryAltiVecVectorToken() {
                break;
            }
        },
        UndeclaredNonType => {
            DependentNonType;
        },
        TypeTemplate => {
            if Next.isNot(less) {
                if SS.isNotEmpty() {
                    self.AnnotateScopeToken(SS, !WasScopeAnnotation);
                }
                return TemplateName;
            }
        },
        Concept => {
            VarTemplate;
        },
    }
    if SS.isNotEmpty() {
        self.AnnotateScopeToken(SS, !WasScopeAnnotation);
    }
    return Unresolved;
}

fn Parser::getEndOfPreviousToken(self: *Parser) -> SourceLocation {
    let mut TokenEndLoc: SourceLocation = self.PP.getLocForEndOfToken(self.PrevTokLocation, 0);
    return if TokenEndLoc.isValid() { TokenEndLoc } else { self.Tok.getLocation() };
}

fn Parser::TryKeywordIdentFallback(self, DisableKeyword: bool) -> bool {
    assert!(self.Tok.isNot(identifier);
    let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    if II.getTokenID() == identifier {
        self.Tok.setKind(identifier);
        return true;
    }
    self.Diag(self.Tok, ext_keyword_as_ident) << self.PP.getSpelling(self.Tok, null) << DisableKeyword;
    if DisableKeyword {
        II.revertTokenIDToIdentifier();
    }
    self.Tok.setKind(identifier);
    return true;
}

fn Parser::TryAnnotateTypeOrScopeToken(self, AllowImplicitTypename: ImplicitTypenameContext, IsAddressOfOperand: bool) -> bool {
    assert!((self.Tok.is(identifier) || self.Tok.is(coloncolon) || self.Tok.is(kw_typename) || self.Tok.is(annot_cxxscope) || self.Tok.is(kw_decltype) || self.Tok.is(annot_template_id) || self.Tok.is(kw___super) || self.Tok.is(kw_auto) || self.Tok.is(annot_pack_indexing_type)), "Cannot be a type or scope token!");
    if self.Tok.is(kw_typename) {
        if self.getLangOpts().MSVCCompat && self.NextToken().is(kw_typedef) {
            let mut TypedefToken: Token = Token {};
            self.PP.Lex(TypedefToken);
            let mut Result: bool = self.TryAnnotateTypeOrScopeToken(AllowImplicitTypename, false);
            self.PP.EnterToken(self.Tok, true);
            self.Tok = TypedefToken;
            if !Result {
                self.Diag(self.Tok.getLocation(), warn_expected_qualified_after_typename);
            }
            return Result;
        }
        let mut TypenameLoc: SourceLocation = self.ConsumeToken();
        let mut SS: CXXScopeSpec = CXXScopeSpec {};
        if self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, true, null, false, false, false, false, false) {
            return true;
        }
        if SS.isEmpty() {
            if self.Tok.is(identifier) || self.Tok.is(annot_template_id) || self.Tok.is(annot_decltype) {
                if self.Tok.is(annot_decltype) || (!self.TryAnnotateTypeOrScopeToken(AllowImplicitTypename, false) && self.Tok.isAnnotation()) {
                    let mut DiagID: u32 = err_expected_qualified_after_typename;
                    if self.getLangOpts().MicrosoftExt {
                        DiagID = warn_expected_qualified_after_typename;
                    }
                    self.Diag(self.Tok.getLocation(), DiagID);
                    return false;
                }
            }
            if self.Tok.isEditorPlaceholder() {
                return true;
            }
            self.Diag(self.Tok.getLocation(), err_expected_qualified_after_typename);
            return true;
        }
        let mut TemplateKWPresent: bool = false;
        if self.Tok.is(kw_template) {
            self.ConsumeToken();
            TemplateKWPresent = true;
        }
        let mut Ty: TypeResult = false;
        if self.Tok.is(identifier) {
            if TemplateKWPresent && self.NextToken().isNot(less) {
                self.Diag(self.Tok.getLocation(), missing_template_arg_list_after_template_kw);
                return true;
            }
            Ty = self.Actions.ActOnTypenameType(self.getCurScope(), TypenameLoc, SS, *self.Tok.getIdentifierInfo(), self.Tok.getLocation(), No);
        } else if self.Tok.is(annot_template_id) {
            let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
            if !TemplateId.mightBeType() {
                self.Diag(self.Tok, err_typename_refers_to_non_type_template) << self.Tok.getAnnotationRange();
                return true;
            }
            let mut TemplateArgsPtr: ASTTemplateArgsPtr = ASTTemplateArgsPtr { TemplateId.getTemplateArgs(), TemplateId.NumArgs };
            Ty = if TemplateId.isInvalid() { TypeError() } else { self.Actions.ActOnTypenameType(self.getCurScope(), TypenameLoc, SS, TemplateId.TemplateKWLoc, TemplateId.Template, TemplateId.Name, TemplateId.TemplateNameLoc, TemplateId.LAngleLoc, TemplateArgsPtr, TemplateId.RAngleLoc) };
        } else {
            self.Diag(self.Tok, err_expected_type_name_after_typename) << SS.getRange();
            return true;
        }
        let mut EndLoc: SourceLocation = self.Tok.getLastLoc();
        self.Tok.setKind(annot_typename);
        setTypeAnnotation(self.Tok, Ty);
        self.Tok.setAnnotationEndLoc(EndLoc);
        self.Tok.setLocation(TypenameLoc);
        self.PP.AnnotateCachedTokens(self.Tok);
        return false;
    }
    let mut WasScopeAnnotation: bool = self.Tok.is(annot_cxxscope);
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if self.getLangOpts().CPlusPlus {
        if self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, IsAddressOfOperand) {
            return true;
        }
    }
    return self.TryAnnotateTypeOrScopeTokenAfterScopeSpec(SS, !WasScopeAnnotation, AllowImplicitTypename);
}

fn Parser::TryAnnotateTypeOrScopeTokenAfterScopeSpec(self, SS: *mut CXXScopeSpec, IsNewScope: bool, AllowImplicitTypename: ImplicitTypenameContext) -> bool {
    if self.Tok.is(identifier) {
        if self.Actions.getTypeName(*self.Tok.getIdentifierInfo(), self.Tok.getLocation(), self.getCurScope(), &mut SS, false, self.NextToken().is(period), null, false, true, true, AllowImplicitTypename, null) {
            Ty;
        } else {
            let mut BeginLoc: SourceLocation = self.Tok.getLocation();
            if SS.isNotEmpty() {
                BeginLoc = SS.getBeginLoc();
            }
            let mut T: QualType = self.Actions.GetTypeFromParser(Ty, null);
            if self.getLangOpts().ObjC && self.NextToken().is(less) && (operator(T).isObjCObjectType() || operator(T).isObjCObjectPointerType()) {
                let mut IdentifierLoc: SourceLocation = self.ConsumeToken();
                let mut NewEndLoc: SourceLocation = SourceLocation {};
                let mut NewType: TypeResult = self.parseObjCTypeArgsAndProtocolQualifiers(IdentifierLoc, Ty, false, NewEndLoc);
                if NewType.isUsable() {
                    Ty = NewType.get();
                } else if self.Tok.is(eof) {
                    return false;
                }
            }
            self.Tok.setKind(annot_typename);
            setTypeAnnotation(self.Tok, Ty);
            self.Tok.setAnnotationEndLoc(self.Tok.getLocation());
            self.Tok.setLocation(BeginLoc);
            self.PP.AnnotateCachedTokens(self.Tok);
            return false;
        }
        if !self.getLangOpts().CPlusPlus {
            return false;
        }
        if self.NextToken().is(less) {
            let mut Template: TemplateTy = null;
            let mut TemplateName: UnqualifiedId = UnqualifiedId {};
            TemplateName.setIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
            let mut MemberOfUnknownSpecialization: bool = false;
            if self.Actions.isTemplateName(self.getCurScope(), SS, false, TemplateName, null, false, Template, MemberOfUnknownSpecialization, true) {
                TNK;
            } else {
                if TNK != TNK_Undeclared_template || self.isTemplateArgumentList(1) != False {
                    self.ConsumeToken();
                    if self.AnnotateTemplateIdToken(Template, TNK, SS, SourceLocation {}, TemplateName, true, false) {
                        return true;
                    }
                }
            }
        }
    }
    if self.Tok.is(annot_template_id) {
        let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
        if TemplateId.Kind == TNK_Type_template {
            self.AnnotateTemplateIdTokenAsType(SS, AllowImplicitTypename, false);
            return false;
        }
    }
    if SS.isEmpty() {
        if self.getLangOpts().ObjC && !self.getLangOpts().CPlusPlus && self.Tok.is(coloncolon) {
            self.Diag(self.ConsumeToken(), err_expected_type);
            return true;
        }
        return false;
    }
    self.AnnotateScopeToken(SS, IsNewScope);
    return false;
}

fn Parser::TryAnnotateCXXScopeToken(self, EnteringContext: bool) -> bool {
    assert!(self.getLangOpts().CPlusPlus, "Call sites of this function should be guarded by checking for C++");
    assert!(self.MightBeCXXScopeToken(), "Cannot be a type or scope token!");
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if self.ParseOptionalCXXScopeSpecifier(SS, null, false, EnteringContext, null, false, null, false, false, false, false, false) {
        return true;
    }
    if SS.isEmpty() {
        return false;
    }
    self.AnnotateScopeToken(SS, true);
    return false;
}

fn Parser::isTokenEqualOrEqualTypo(self) -> bool {
    let mut Kind: TokenKind = self.Tok.getKind();
    match Kind {
        _ => {
            return false;
        },
        ampequal => {
            starequal;
        },
        equal => {
            return true;
        },
    }
}

fn Parser::handleUnexpectedCodeCompletionToken(self) -> SourceLocation {
    assert!(self.Tok.is(code_completion);
    self.PrevTokLocation = self.Tok.getLocation();
    for let mut S: *mut Scope = self.getCurScope(); S; S = S.getParent() {
        if S.isFunctionScope() {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteOrdinaryName(self.getCurScope(), PCC_RecoveryInFunction);
            return self.PrevTokLocation;
        }
        if S.isClassScope() {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteOrdinaryName(self.getCurScope(), PCC_Class);
            return self.PrevTokLocation;
        }
    }
    self.cutOffParsing();
    self.Actions.CodeCompletion().CodeCompleteOrdinaryName(self.getCurScope(), PCC_Namespace);
    return self.PrevTokLocation;
}

fn Parser::CodeCompleteDirective(self, InConditional: bool) {
    self.Actions.CodeCompletion().CodeCompletePreprocessorDirective(InConditional);
}

fn Parser::CodeCompleteInConditionalExclusion(self) {
    self.Actions.CodeCompletion().CodeCompleteInPreprocessorConditionalExclusion(self.getCurScope());
}

fn Parser::CodeCompleteMacroName(self, IsDefinition: bool) {
    self.Actions.CodeCompletion().CodeCompletePreprocessorMacroName(IsDefinition);
}

fn Parser::CodeCompletePreprocessorExpression(self) {
    self.Actions.CodeCompletion().CodeCompletePreprocessorExpression();
}

fn Parser::CodeCompleteMacroArgument(self, Macro: *mut IdentifierInfo, MacroInfo: *mut MacroInfo, ArgumentIndex: u32) {
    self.Actions.CodeCompletion().CodeCompletePreprocessorMacroArgument(self.getCurScope(), Macro, MacroInfo, ArgumentIndex);
}

fn Parser::CodeCompleteIncludedFile(self, Dir: str, IsAngled: bool) {
    self.Actions.CodeCompletion().CodeCompleteIncludedFile(Dir, IsAngled);
}

fn Parser::CodeCompleteNaturalLanguage(self) {
    self.Actions.CodeCompletion().CodeCompleteNaturalLanguage();
}

fn Parser::CodeCompleteModuleImport(self, ImportLoc: SourceLocation, Path: ModuleIdPath) {
    self.Actions.CodeCompletion().CodeCompleteModuleImport(ImportLoc, Path);
}

fn Parser::ParseMicrosoftIfExistsCondition(self, Result: *mut IfExistsCondition) -> bool {
    assert!((self.Tok.is(kw___if_exists) || self.Tok.is(kw___if_not_exists)), "Expected '__if_exists' or '__if_not_exists'");
    Result.IsIfExists = self.Tok.is(kw___if_exists);
    Result.KeywordLoc = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected_lparen_after) << (if Result.IsIfExists { "__if_exists" } else { "__if_not_exists" });
        return true;
    }
    if self.getLangOpts().CPlusPlus {
        self.ParseOptionalCXXScopeSpecifier(Result.SS, null, false, false, null, false, null, false, false, false, false, false);
    }
    if Result.SS.isInvalid() {
        T.skipToEnd();
        return true;
    }
    let mut TemplateKWLoc: SourceLocation = SourceLocation {};
    if self.ParseUnqualifiedId(Result.SS, null, false, false, true, true, false, &mut TemplateKWLoc, Result.Name) {
        T.skipToEnd();
        return true;
    }
    if T.consumeClose() {
        return true;
    }
    match self.Actions.CheckMicrosoftIfExistsSymbol(self.getCurScope(), Result.KeywordLoc, Result.IsIfExists, Result.SS, Result.Name) {
        Exists => {
            Result.Behavior = if Result.IsIfExists { Parse } else { Skip };
        },
        DoesNotExist => {
            Result.Behavior = if !Result.IsIfExists { Parse } else { Skip };
        },
        Dependent => {
            Result.Behavior = Dependent;
        },
        Error => {
            return true;
        },
    }
    return false;
}

fn Parser::ParseMicrosoftIfExistsExternalDeclaration(self) {
    let mut Result: IfExistsCondition = IfExistsCondition {};
    if self.ParseMicrosoftIfExistsCondition(Result) {
        return;
    }
    let mut Braces: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    if Braces.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_brace;
        return;
    }
    match Result.Behavior {
        Parse => {
            break;
        },
        Dependent => {
            llvm_unreachable_internal("Cannot have a dependent external declaration", "P:/Goraw/llvm-project/clang/lib/Parse/Parser.cpp", 2322);
        },
        Skip => {
            Braces.skipToEnd();
        },
    }
    while self.Tok.isNot(r_brace) && !self.isEofOrEom() {
        let mut Attrs: ParsedAttributes = self.AttrFactory;
        self.MaybeParseCXX11Attributes(Attrs, false);
        let mut EmptyDeclSpecAttrs: ParsedAttributes = self.AttrFactory;
        let mut Result: DeclGroupPtrTy = self.ParseExternalDeclaration(Attrs, EmptyDeclSpecAttrs, null);
        if Result && !self.getCurScope().getParent() {
            self.Actions.getASTConsumer().HandleTopLevelDecl(Result.get());
        }
    }
    Braces.consumeClose();
}

fn Parser::ParseModuleDecl(self, ImportState: *mut ModuleImportState) -> DeclGroupPtrTy {
    let mut Introducer: Token = self.Tok;
    let mut StartLoc: SourceLocation = Introducer.getLocation();
    let mut MDK: ModuleDeclKind = if self.TryConsumeToken(kw_export) { Interface } else { Implementation };
    assert!(self.Tok.is(kw_module), "not a module declaration");
    let mut ModuleLoc: SourceLocation = self.ConsumeToken();
    self.DiagnoseAndSkipCXX11Attributes();
    if self.getLangOpts().CPlusPlusModules && self.Tok.is(semi) {
        let mut SemiLoc: SourceLocation = self.ConsumeToken();
        if ImportState != FirstDecl || Introducer.hasSeenNoTrivialPPDirective() {
            self.Diag(StartLoc, err_global_module_introducer_not_at_start) << SourceRange { B: StartLoc, E: SemiLoc };
            return null;
        }
        if MDK == Interface {
            self.Diag(StartLoc, err_module_fragment_exported) << 0 << CreateRemoval(StartLoc);
        }
        ImportState = GlobalFragment;
        return self.Actions.ActOnGlobalModuleFragmentDecl(ModuleLoc);
    }
    if self.getLangOpts().CPlusPlusModules && self.Tok.is(colon) && self.NextToken().is(kw_private) {
        if MDK == Interface {
            self.Diag(StartLoc, err_module_fragment_exported) << 1 << CreateRemoval(StartLoc);
        }
        self.ConsumeToken();
        let mut PrivateLoc: SourceLocation = self.ConsumeToken();
        self.DiagnoseAndSkipCXX11Attributes();
        self.ExpectAndConsumeSemi(err_private_module_fragment_expected_semi, "");
        let mut Result: DeclGroupPtrTy = self.Actions.ActOnPrivateModuleFragmentDecl(ModuleLoc, PrivateLoc);
        if Result {
            ImportState = if ImportState == ImportAllowed { PrivateFragmentImportAllowed } else { PrivateFragmentImportFinished };
        }
        return null;
    }
    let mut Path: SmallVector<IdentifierLoc, 2> = SmallVector<IdentifierLoc, 2> {};
    if self.ParseModuleName(ModuleLoc, Path, false) {
        return null;
    }
    let mut Partition: SmallVector<IdentifierLoc, 2> = SmallVector<IdentifierLoc, 2> {};
    if self.Tok.is(colon) {
        let mut ColonLoc: SourceLocation = self.ConsumeToken();
        if !self.getLangOpts().CPlusPlusModules {
            self.Diag(ColonLoc, err_unsupported_module_partition) << SourceRange { B: ColonLoc, E: Partition.back().getLoc() };
        } else if self.ParseModuleName(ModuleLoc, Partition, false) {
            return null;
        }
    }
    if self.Tok.isNoneOf(semi, l_square, eof) {
        self.Diag(self.Tok, err_unexpected_tok_after_module_name) << self.PP.getSpelling(self.Tok, null);
        self.SkipUntil(semi, StopBeforeMatch);
    }
    let mut Attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseCXX11Attributes(Attrs, false);
    self.ProhibitCXX11Attributes(Attrs, err_attribute_not_module_attr, err_keyword_not_module_attr, false, true);
    if self.ExpectAndConsumeSemi(err_expected_semi_after_module_or_import, getKeywordSpelling(kw_module)) {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
    }
    return self.Actions.ActOnModuleDecl(StartLoc, ModuleLoc, MDK, Path, Partition, ImportState, Introducer.hasSeenNoTrivialPPDirective());
}

fn Parser::ParseModuleImport(self, AtLoc: SourceLocation, ImportState: *mut ModuleImportState) -> *mut Decl {
    let mut StartLoc: SourceLocation = if AtLoc.isInvalid() { self.Tok.getLocation() } else { AtLoc };
    let mut ExportLoc: SourceLocation = SourceLocation {};
    self.TryConsumeToken(kw_export, ExportLoc);
    assert!((if AtLoc.isInvalid() { self.Tok.is(kw_import) } else { self.Tok.isObjCAtKeyword(objc_import) }), "Improper start to module import");
    let mut IsObjCAtImport: bool = self.Tok.isObjCAtKeyword(objc_import);
    let mut ImportLoc: SourceLocation = self.ConsumeToken();
    let mut Path: SmallVector<IdentifierLoc, 2> = SmallVector<IdentifierLoc, 2> {};
    let mut IsPartition: bool = false;
    let mut HeaderUnit: *mut Module = null;
    if self.Tok.is(header_name) {
        self.ConsumeToken();
    } else if self.Tok.is(annot_header_unit) {
        HeaderUnit = self.Tok.getAnnotationValue() as *mut Module;
        self.ConsumeAnnotationToken();
    } else if self.Tok.is(colon) {
        let mut ColonLoc: SourceLocation = self.ConsumeToken();
        if !self.getLangOpts().CPlusPlusModules {
            self.Diag(ColonLoc, err_unsupported_module_partition) << SourceRange { B: ColonLoc, E: Path.back().getLoc() };
        } else if self.ParseModuleName(ColonLoc, Path, true) {
            return null;
        } else {
            IsPartition = true;
        }
    } else {
        if self.ParseModuleName(ImportLoc, Path, true) {
            return null;
        }
    }
    let mut Attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseCXX11Attributes(Attrs, false);
    self.ProhibitCXX11Attributes(Attrs, err_attribute_not_import_attr, err_keyword_not_import_attr, false, true);
    let mut IsCXX20NamedModuleImport: bool = self.getLangOpts().CPlusPlusModules && !IsObjCAtImport && !Path.is_empty();
    if self.PP.hadModuleLoaderFatalFailure() && !IsCXX20NamedModuleImport {
        self.cutOffParsing();
        return null;
    }
    let mut SeenError: bool = true;
    match ImportState {
        ImportAllowed => {
            SeenError = false;
        },
        FirstDecl => {
            ImportState = NotACXX20Module;
        },
        NotACXX20Module => {
            if IsPartition {
                self.Diag(ImportLoc, err_partition_import_outside_module);
            } else {
                SeenError = false;
            }
        },
        GlobalFragment => {
            PrivateFragmentImportAllowed;
        },
        ImportFinished => {
            PrivateFragmentImportFinished;
        },
    }
    let mut LexedSemi: bool = false;
    if self.getLangOpts().CPlusPlusModules {
        LexedSemi = !self.ExpectAndConsumeSemi(err_expected_semi_after_module_or_import, getKeywordSpelling(kw_import));
    } else {
        LexedSemi = !self.ExpectAndConsumeSemi(err_module_expected_semi, "");
    }
    if !LexedSemi {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
    }
    if SeenError {
        return null;
    }
    let mut Import: DeclResult = false;
    if HeaderUnit {
        Import = self.Actions.ActOnModuleImport(StartLoc, ExportLoc, ImportLoc, HeaderUnit, ModuleIdPath {});
    } else if !Path.is_empty() {
        Import = self.Actions.ActOnModuleImport(StartLoc, ExportLoc, ImportLoc, Path, IsPartition);
    }
    if Import.isInvalid() {
        return null;
    }
    if IsObjCAtImport && AtLoc.isValid() {
        let mut SrcMgr: *mut SourceManager = self.PP.getSourceManager();
        let mut FE: OptionalFileEntryRef = SrcMgr.getFileEntryRefForID(SrcMgr.getFileID(AtLoc));
        if FE && parent_path(operator(FE).getDir().getName(), native).ends_with(".framework") {
            self.Diags.Report(AtLoc, warn_atimport_in_framework_header);
        }
    }
    return Import.get();
}

fn Parser::ParseModuleName(self, UseLoc: SourceLocation, Path: *mut SmallVectorImpl<IdentifierLoc>, IsImport: bool) -> bool {
    if self.Tok.isNot(annot_module_name) {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return true;
    }
    let mut NameLoc: *mut ModuleNameLoc = self.Tok.getAnnotationValue() as *mut ModuleNameLoc;
    Path.assign(NameLoc.getModuleIdPath().begin(), NameLoc.getModuleIdPath().end());
    self.ConsumeAnnotationToken();
    return false;
}

fn Parser::parseMisplacedModuleImport(self) -> bool {
    while true {
        match self.Tok.getKind() {
            annot_module_end => {
                if self.MisplacedModuleBeginCount {
                    self.MisplacedModuleBeginCount -= 1;
                    self.Actions.ActOnAnnotModuleEnd(self.Tok.getLocation(), self.Tok.getAnnotationValue() as *mut Module);
                    self.ConsumeAnnotationToken();
                    continue;
                }
            },
            annot_module_begin => {
                self.Actions.ActOnAnnotModuleBegin(self.Tok.getLocation(), self.Tok.getAnnotationValue() as *mut Module);
            },
            annot_module_include => {
                self.Actions.ActOnAnnotModuleInclude(self.Tok.getLocation(), self.Tok.getAnnotationValue() as *mut Module);
            },
            _ => {
                return false;
            },
        }
    }
    return false;
}

fn Parser::diagnoseUseOfC11Keyword(self, Tok: *Token) {
    self.Diag(Tok, if self.getLangOpts().C11 { warn_c11_compat_keyword } else { ext_c11_feature }) << Tok.getName();
}

fn BalancedDelimiterTracker::diagnoseOverflow(self) -> bool {
    self.P.Diag(self.P.Tok, err_bracket_depth_exceeded) << self.P.getLangOpts().BracketDepth;
    self.P.Diag(self.P.Tok, note_bracket_depth);
    self.P.cutOffParsing();
    return true;
}

fn BalancedDelimiterTracker::expectAndConsume(self, DiagID: u32, Msg: *u8, SkipToTok: TokenKind) -> bool {
    self.LOpen = self.P.Tok.getLocation();
    if self.P.ExpectAndConsume(self.Kind, DiagID, Msg) {
        if SkipToTok != unknown {
            self.P.SkipUntil(SkipToTok, StopAtSemi);
        }
        return true;
    }
    if self.getDepth() < self.P.getLangOpts().BracketDepth {
        return false;
    }
    return self.diagnoseOverflow();
}

fn BalancedDelimiterTracker::diagnoseMissingClose(self) -> bool {
    assert!(!self.P.Tok.is(self.Close), "Should have consumed closing delimiter");
    if self.P.Tok.is(annot_module_end) {
        self.P.Diag(self.P.Tok, err_missing_before_module_end) << self.Close;
    } else {
        self.P.Diag(self.P.Tok, err_expected) << self.Close;
    }
    self.P.Diag(self.LOpen, note_matching) << self.Kind;
    if self.P.Tok.isNot(r_paren) && self.P.Tok.isNot(r_brace) && self.P.Tok.isNot(r_square) && self.P.SkipUntil(self.Close, self.FinalToken, StopAtSemi | StopBeforeMatch) && self.P.Tok.is(self.Close) {
        self.LClose = self.P.ConsumeAnyToken(false);
    }
    return true;
}

fn BalancedDelimiterTracker::skipToEnd(self) {
    self.P.SkipUntil(self.Close, StopBeforeMatch);
    self.consumeClose();
}

struct Closure_1 {
    cap_0: *mut Parser,
}

fn Closure_1::call(self: *Closure_1, TypeStr: str, Context: str, IncludeLoc: SourceLocation) -> TypeResult {
        return self.ParseTypeFromString(TypeStr, Context, IncludeLoc);
    }

struct Closure_2 {
    cap_0: *mut Parser,
}

fn Closure_2::call(self: *Closure_2) -> str {
        return self.Tok.getLocation().printToString(self.Actions.getASTContext().getSourceManager());
    }

struct Closure_3 {
    cap_0: *mut Parser,
    D: *mut ParsingDeclarator,
}

unsafe fn Closure_3::call(self: *mut Closure_3) -> str {
        return self.Actions.GetNameForDeclarator((*self.D)).getName().getAsString();
    }
