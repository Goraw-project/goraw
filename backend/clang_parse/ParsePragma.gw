struct PragmaMSFenvAccessHandler {
    Name: str,
}

fn PragmaMSFenvAccessHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut PragmaName: str = FirstToken.getIdentifierInfo().getName();
    if !PP.getTargetInfo().hasStrictFP() && operator!(PP.getLangOpts()) {
        PP << PragmaName;
        return;
    }
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << PragmaName;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP;
        return;
    }
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    let mut OOS: OnOffSwitch = zeroed();
    if II.isStr("on") {
        OOS = OOS_ON;
        PP.Lex(Tok);
    } else if II.isStr("off") {
        OOS = OOS_OFF;
        PP.Lex(Tok);
    } else {
        PP;
        return;
    }
    if Tok.isNot(r_paren) {
        PP << PragmaName;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << PragmaName;
        return;
    }
    let mut Toks: MutableArrayRef<Token> = zeroed();
    Toks()[0]();
    Toks()[0](annot_pragma_fenv_access_ms);
    Toks()[0](FirstToken.getLocation());
    Toks()[0](Tok.getLocation());
    Toks()[0](OOS as u64 as *mut void);
    PP(true, false);
}

