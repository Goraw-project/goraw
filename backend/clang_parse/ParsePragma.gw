fn markAsReinjectedForRelexing(Toks: Token>) {
    for T in Toks {
        T.setFlag(IsReinjected);
    }
}

fn Parser::initializePragmaHandlers(self) {
    self.AlignHandler = make_unique();
    self.PP.AddPragmaHandler(self.AlignHandler.get());
    self.GCCVisibilityHandler = make_unique();
    self.PP.AddPragmaHandler("GCC", self.GCCVisibilityHandler.get());
    self.OptionsHandler = make_unique();
    self.PP.AddPragmaHandler(self.OptionsHandler.get());
    self.PackHandler = make_unique();
    self.PP.AddPragmaHandler(self.PackHandler.get());
    self.MSStructHandler = make_unique();
    self.PP.AddPragmaHandler(self.MSStructHandler.get());
    self.UnusedHandler = make_unique();
    self.PP.AddPragmaHandler(self.UnusedHandler.get());
    self.WeakHandler = make_unique();
    self.PP.AddPragmaHandler(self.WeakHandler.get());
    self.RedefineExtnameHandler = make_unique();
    self.PP.AddPragmaHandler(self.RedefineExtnameHandler.get());
    self.FPContractHandler = make_unique();
    self.PP.AddPragmaHandler("STDC", self.FPContractHandler.get());
    self.STDCFenvAccessHandler = make_unique();
    self.PP.AddPragmaHandler("STDC", self.STDCFenvAccessHandler.get());
    self.STDCFenvRoundHandler = make_unique();
    self.PP.AddPragmaHandler("STDC", self.STDCFenvRoundHandler.get());
    self.STDCCXLIMITHandler = make_unique();
    self.PP.AddPragmaHandler("STDC", self.STDCCXLIMITHandler.get());
    self.STDCUnknownHandler = make_unique();
    self.PP.AddPragmaHandler("STDC", self.STDCUnknownHandler.get());
    self.PCSectionHandler = make_unique(self.Actions);
    self.PP.AddPragmaHandler("clang", self.PCSectionHandler.get());
    if self.getLangOpts().OpenCL {
        self.OpenCLExtensionHandler = make_unique();
        self.PP.AddPragmaHandler("OPENCL", self.OpenCLExtensionHandler.get());
        self.PP.AddPragmaHandler("OPENCL", self.FPContractHandler.get());
    }
    if self.getLangOpts().OpenMP {
        self.OpenMPHandler = make_unique();
    } else {
        self.OpenMPHandler = make_unique();
    }
    self.PP.AddPragmaHandler(self.OpenMPHandler.get());
    if self.getLangOpts().OpenACC {
        self.OpenACCHandler = make_unique();
    } else {
        self.OpenACCHandler = make_unique();
    }
    self.PP.AddPragmaHandler(self.OpenACCHandler.get());
    if self.getLangOpts().MicrosoftExt || self.getTargetInfo().getTriple().isOSBinFormatELF() || self.getTargetInfo().getTriple().isOSAIX() {
        self.MSCommentHandler = make_unique(self.Actions);
        self.PP.AddPragmaHandler(self.MSCommentHandler.get());
    }
    self.FloatControlHandler = make_unique(self.Actions);
    self.PP.AddPragmaHandler(self.FloatControlHandler.get());
    if self.getLangOpts().MicrosoftExt {
        self.MSDetectMismatchHandler = make_unique(self.Actions);
        self.PP.AddPragmaHandler(self.MSDetectMismatchHandler.get());
        self.MSPointersToMembers = make_unique();
        self.PP.AddPragmaHandler(self.MSPointersToMembers.get());
        self.MSVtorDisp = make_unique();
        self.PP.AddPragmaHandler(self.MSVtorDisp.get());
        self.MSInitSeg = make_unique("init_seg");
        self.PP.AddPragmaHandler(self.MSInitSeg.get());
        self.MSDataSeg = make_unique("data_seg");
        self.PP.AddPragmaHandler(self.MSDataSeg.get());
        self.MSBSSSeg = make_unique("bss_seg");
        self.PP.AddPragmaHandler(self.MSBSSSeg.get());
        self.MSConstSeg = make_unique("const_seg");
        self.PP.AddPragmaHandler(self.MSConstSeg.get());
        self.MSCodeSeg = make_unique("code_seg");
        self.PP.AddPragmaHandler(self.MSCodeSeg.get());
        self.MSSection = make_unique("section");
        self.PP.AddPragmaHandler(self.MSSection.get());
        self.MSStrictGuardStackCheck = make_unique("strict_gs_check");
        self.PP.AddPragmaHandler(self.MSStrictGuardStackCheck.get());
        self.MSFunction = make_unique("function");
        self.PP.AddPragmaHandler(self.MSFunction.get());
        self.MSAllocText = make_unique("alloc_text");
        self.PP.AddPragmaHandler(self.MSAllocText.get());
        self.MSOptimize = make_unique("optimize");
        self.PP.AddPragmaHandler(self.MSOptimize.get());
        self.MSRuntimeChecks = make_unique();
        self.PP.AddPragmaHandler(self.MSRuntimeChecks.get());
        self.MSIntrinsic = make_unique("intrinsic");
        self.PP.AddPragmaHandler(self.MSIntrinsic.get());
        self.MSFenvAccess = make_unique();
        self.PP.AddPragmaHandler(self.MSFenvAccess.get());
    }
    if self.getLangOpts().CUDA {
        self.CUDAForceHostDeviceHandler = make_unique(self.Actions);
        self.PP.AddPragmaHandler("clang", self.CUDAForceHostDeviceHandler.get());
    }
    self.OptimizeHandler = make_unique(self.Actions);
    self.PP.AddPragmaHandler("clang", self.OptimizeHandler.get());
    self.LoopHintHandler = make_unique();
    self.PP.AddPragmaHandler("clang", self.LoopHintHandler.get());
    self.UnrollHintHandler = make_unique("unroll");
    self.PP.AddPragmaHandler(self.UnrollHintHandler.get());
    self.PP.AddPragmaHandler("GCC", self.UnrollHintHandler.get());
    self.NoUnrollHintHandler = make_unique("nounroll");
    self.PP.AddPragmaHandler(self.NoUnrollHintHandler.get());
    self.PP.AddPragmaHandler("GCC", self.NoUnrollHintHandler.get());
    self.UnrollAndJamHintHandler = make_unique("unroll_and_jam");
    self.PP.AddPragmaHandler(self.UnrollAndJamHintHandler.get());
    self.NoUnrollAndJamHintHandler = make_unique("nounroll_and_jam");
    self.PP.AddPragmaHandler(self.NoUnrollAndJamHintHandler.get());
    self.FPHandler = make_unique();
    self.PP.AddPragmaHandler("clang", self.FPHandler.get());
    self.AttributePragmaHandler = make_unique(self.AttrFactory);
    self.PP.AddPragmaHandler("clang", self.AttributePragmaHandler.get());
    self.MaxTokensHerePragmaHandler = make_unique();
    self.PP.AddPragmaHandler("clang", self.MaxTokensHerePragmaHandler.get());
    self.MaxTokensTotalPragmaHandler = make_unique();
    self.PP.AddPragmaHandler("clang", self.MaxTokensTotalPragmaHandler.get());
    if self.getLangOpts().ZOSExt {
        self.ExportHandler = make_unique();
        self.PP.AddPragmaHandler(self.ExportHandler.get());
    }
    if self.getTargetInfo().getTriple().isRISCV() {
        self.RISCVPragmaHandler = make_unique(self.Actions);
        self.PP.AddPragmaHandler("clang", self.RISCVPragmaHandler.get());
    }
}

fn Parser::resetPragmaHandlers(self) {
    self.PP.RemovePragmaHandler(self.AlignHandler.get());
    self.AlignHandler.reset(null);
    self.PP.RemovePragmaHandler("GCC", self.GCCVisibilityHandler.get());
    self.GCCVisibilityHandler.reset(null);
    self.PP.RemovePragmaHandler(self.OptionsHandler.get());
    self.OptionsHandler.reset(null);
    self.PP.RemovePragmaHandler(self.PackHandler.get());
    self.PackHandler.reset(null);
    self.PP.RemovePragmaHandler(self.MSStructHandler.get());
    self.MSStructHandler.reset(null);
    self.PP.RemovePragmaHandler(self.UnusedHandler.get());
    self.UnusedHandler.reset(null);
    self.PP.RemovePragmaHandler(self.WeakHandler.get());
    self.WeakHandler.reset(null);
    self.PP.RemovePragmaHandler(self.RedefineExtnameHandler.get());
    self.RedefineExtnameHandler.reset(null);
    if self.getLangOpts().OpenCL {
        self.PP.RemovePragmaHandler("OPENCL", self.OpenCLExtensionHandler.get());
        self.OpenCLExtensionHandler.reset(null);
        self.PP.RemovePragmaHandler("OPENCL", self.FPContractHandler.get());
    }
    self.PP.RemovePragmaHandler(self.OpenMPHandler.get());
    self.OpenMPHandler.reset(null);
    self.PP.RemovePragmaHandler(self.OpenACCHandler.get());
    self.OpenACCHandler.reset(null);
    if self.getLangOpts().MicrosoftExt || self.getTargetInfo().getTriple().isOSBinFormatELF() || self.getTargetInfo().getTriple().isOSAIX() {
        self.PP.RemovePragmaHandler(self.MSCommentHandler.get());
        self.MSCommentHandler.reset(null);
    }
    self.PP.RemovePragmaHandler("clang", self.PCSectionHandler.get());
    self.PCSectionHandler.reset(null);
    self.PP.RemovePragmaHandler(self.FloatControlHandler.get());
    self.FloatControlHandler.reset(null);
    if self.getLangOpts().MicrosoftExt {
        self.PP.RemovePragmaHandler(self.MSDetectMismatchHandler.get());
        self.MSDetectMismatchHandler.reset(null);
        self.PP.RemovePragmaHandler(self.MSPointersToMembers.get());
        self.MSPointersToMembers.reset(null);
        self.PP.RemovePragmaHandler(self.MSVtorDisp.get());
        self.MSVtorDisp.reset(null);
        self.PP.RemovePragmaHandler(self.MSInitSeg.get());
        self.MSInitSeg.reset(null);
        self.PP.RemovePragmaHandler(self.MSDataSeg.get());
        self.MSDataSeg.reset(null);
        self.PP.RemovePragmaHandler(self.MSBSSSeg.get());
        self.MSBSSSeg.reset(null);
        self.PP.RemovePragmaHandler(self.MSConstSeg.get());
        self.MSConstSeg.reset(null);
        self.PP.RemovePragmaHandler(self.MSCodeSeg.get());
        self.MSCodeSeg.reset(null);
        self.PP.RemovePragmaHandler(self.MSSection.get());
        self.MSSection.reset(null);
        self.PP.RemovePragmaHandler(self.MSStrictGuardStackCheck.get());
        self.MSStrictGuardStackCheck.reset(null);
        self.PP.RemovePragmaHandler(self.MSFunction.get());
        self.MSFunction.reset(null);
        self.PP.RemovePragmaHandler(self.MSAllocText.get());
        self.MSAllocText.reset(null);
        self.PP.RemovePragmaHandler(self.MSRuntimeChecks.get());
        self.MSRuntimeChecks.reset(null);
        self.PP.RemovePragmaHandler(self.MSIntrinsic.get());
        self.MSIntrinsic.reset(null);
        self.PP.RemovePragmaHandler(self.MSOptimize.get());
        self.MSOptimize.reset(null);
        self.PP.RemovePragmaHandler(self.MSFenvAccess.get());
        self.MSFenvAccess.reset(null);
    }
    if self.getLangOpts().CUDA {
        self.PP.RemovePragmaHandler("clang", self.CUDAForceHostDeviceHandler.get());
        self.CUDAForceHostDeviceHandler.reset(null);
    }
    self.PP.RemovePragmaHandler("STDC", self.FPContractHandler.get());
    self.FPContractHandler.reset(null);
    self.PP.RemovePragmaHandler("STDC", self.STDCFenvAccessHandler.get());
    self.STDCFenvAccessHandler.reset(null);
    self.PP.RemovePragmaHandler("STDC", self.STDCFenvRoundHandler.get());
    self.STDCFenvRoundHandler.reset(null);
    self.PP.RemovePragmaHandler("STDC", self.STDCCXLIMITHandler.get());
    self.STDCCXLIMITHandler.reset(null);
    self.PP.RemovePragmaHandler("STDC", self.STDCUnknownHandler.get());
    self.STDCUnknownHandler.reset(null);
    self.PP.RemovePragmaHandler("clang", self.OptimizeHandler.get());
    self.OptimizeHandler.reset(null);
    self.PP.RemovePragmaHandler("clang", self.LoopHintHandler.get());
    self.LoopHintHandler.reset(null);
    self.PP.RemovePragmaHandler(self.UnrollHintHandler.get());
    self.PP.RemovePragmaHandler("GCC", self.UnrollHintHandler.get());
    self.UnrollHintHandler.reset(null);
    self.PP.RemovePragmaHandler(self.NoUnrollHintHandler.get());
    self.PP.RemovePragmaHandler("GCC", self.NoUnrollHintHandler.get());
    self.NoUnrollHintHandler.reset(null);
    self.PP.RemovePragmaHandler(self.UnrollAndJamHintHandler.get());
    self.UnrollAndJamHintHandler.reset(null);
    self.PP.RemovePragmaHandler(self.NoUnrollAndJamHintHandler.get());
    self.NoUnrollAndJamHintHandler.reset(null);
    self.PP.RemovePragmaHandler("clang", self.FPHandler.get());
    self.FPHandler.reset(null);
    self.PP.RemovePragmaHandler("clang", self.AttributePragmaHandler.get());
    self.AttributePragmaHandler.reset(null);
    self.PP.RemovePragmaHandler("clang", self.MaxTokensHerePragmaHandler.get());
    self.MaxTokensHerePragmaHandler.reset(null);
    self.PP.RemovePragmaHandler("clang", self.MaxTokensTotalPragmaHandler.get());
    self.MaxTokensTotalPragmaHandler.reset(null);
    if self.getLangOpts().ZOSExt {
        self.PP.RemovePragmaHandler(self.ExportHandler.get());
        self.ExportHandler.reset(null);
    }
    if self.getTargetInfo().getTriple().isRISCV() {
        self.PP.RemovePragmaHandler("clang", self.RISCVPragmaHandler.get());
        self.RISCVPragmaHandler.reset(null);
    }
}

fn Parser::HandlePragmaUnused(self) {
    assert!(self.Tok.is(annot_pragma_unused);
    let mut UnusedLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaUnused(self.Tok, self.getCurScope(), UnusedLoc);
    self.ConsumeToken();
}

fn Parser::HandlePragmaVisibility(self) {
    assert!(self.Tok.is(annot_pragma_vis);
    let mut VisType: *IdentifierInfo = self.Tok.getAnnotationValue() as *mut IdentifierInfo;
    let mut VisLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaVisibility(VisType, VisLoc);
}

fn Parser::HandlePragmaPack(self) {
    assert!(self.Tok.is(annot_pragma_pack);
    let mut Info: *mut PragmaPackInfo = self.Tok.getAnnotationValue() as *mut PragmaPackInfo;
    let mut PragmaLoc: SourceLocation = self.Tok.getLocation();
    let mut Alignment: ExprResult = false;
    if Info.Alignment.is(numeric_constant) {
        Alignment = self.Actions.ActOnNumericConstant(Info.Alignment, null);
        if Alignment.isInvalid() {
            self.ConsumeAnnotationToken();
            return;
        }
    }
    self.Actions.ActOnPragmaPack(PragmaLoc, Info.Action, Info.SlotLabel, Alignment.get());
    self.ConsumeAnnotationToken();
}

fn Parser::HandlePragmaMSStruct(self) {
    assert!(self.Tok.is(annot_pragma_msstruct);
    let mut Kind: PragmaMSStructKind = self.Tok.getAnnotationValue() as u64 as PragmaMSStructKind;
    self.Actions.ActOnPragmaMSStruct(Kind);
    self.ConsumeAnnotationToken();
}

fn Parser::HandlePragmaAlign(self) {
    assert!(self.Tok.is(annot_pragma_align);
    let mut Kind: PragmaOptionsAlignKind = self.Tok.getAnnotationValue() as u64 as PragmaOptionsAlignKind;
    self.Actions.ActOnPragmaOptionsAlign(Kind, self.Tok.getLocation());
    self.ConsumeAnnotationToken();
}

fn Parser::HandlePragmaDump(self) {
    assert!(self.Tok.is(annot_pragma_dump);
    self.ConsumeAnnotationToken();
    if self.Tok.is(eod) {
        self.PP.Diag(self.Tok, warn_pragma_debug_missing_argument) << "dump";
    } else if self.NextToken().is(eod) {
        if self.Tok.isNot(identifier) {
            self.PP.Diag(self.Tok, warn_pragma_debug_unexpected_argument);
            self.ConsumeAnyToken(false);
            self.ExpectAndConsume(eod, err_expected, "");
            return;
        }
        let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        self.Actions.ActOnPragmaDump(self.getCurScope(), self.Tok.getLocation(), II);
        self.ConsumeToken();
    } else {
        let mut StartLoc: SourceLocation = self.Tok.getLocation();
        let mut Ctx: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Other, true };
        let mut E: ExprResult = self.ParseExpression(AllowNonTypes);
        if !E.isUsable() || E.get().containsErrors() {} else if E.get().getDependence() != None {
            self.PP.Diag(StartLoc, warn_pragma_debug_dependent_argument) << E.get().isTypeDependent() << SourceRange { B: StartLoc, E: self.Tok.getLocation() };
        } else {
            self.Actions.ActOnPragmaDump(E.get());
        }
        self.SkipUntil(eod, StopBeforeMatch);
    }
    self.ExpectAndConsume(eod, err_expected, "");
}

fn Parser::HandlePragmaWeak(self) {
    assert!(self.Tok.is(annot_pragma_weak);
    let mut PragmaLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaWeakID(self.Tok.getIdentifierInfo(), PragmaLoc, self.Tok.getLocation());
    self.ConsumeToken();
}

fn Parser::HandlePragmaWeakAlias(self) {
    assert!(self.Tok.is(annot_pragma_weakalias);
    let mut PragmaLoc: SourceLocation = self.ConsumeAnnotationToken();
    let mut WeakName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut WeakNameLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeToken();
    let mut AliasName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut AliasNameLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeToken();
    self.Actions.ActOnPragmaWeakAlias(WeakName, AliasName, PragmaLoc, WeakNameLoc, AliasNameLoc);
}

fn Parser::HandlePragmaRedefineExtname(self) {
    assert!(self.Tok.is(annot_pragma_redefine_extname);
    let mut RedefLoc: SourceLocation = self.ConsumeAnnotationToken();
    let mut RedefName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut RedefNameLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeToken();
    let mut AliasName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut AliasNameLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeToken();
    self.Actions.ActOnPragmaRedefineExtname(RedefName, AliasName, RedefLoc, RedefNameLoc, AliasNameLoc);
}

fn Parser::HandlePragmaFPContract(self) {
    assert!(self.Tok.is(annot_pragma_fp_contract);
    let mut OOS: OnOffSwitch = self.Tok.getAnnotationValue() as u64 as OnOffSwitch;
    let mut FPC: FPModeKind = zeroed();
    match OOS {
        OOS_ON => {
            FPC = FPM_On;
        },
        OOS_OFF => {
            FPC = FPM_Off;
        },
        OOS_DEFAULT => {
            FPC = self.getLangOpts().getDefaultFPContractMode();
        },
    }
    let mut PragmaLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaFPContract(PragmaLoc, FPC);
}

fn Parser::HandlePragmaFloatControl(self) {
    assert!(self.Tok.is(annot_pragma_float_control);
    let mut Value: u64 = self.Tok.getAnnotationValue() as u64;
    let mut Action: PragmaMsStackAction = (Value >> 16) & 65535 as PragmaMsStackAction;
    let mut Kind: PragmaFloatControlKind = Value & 65535;
    let mut PragmaLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaFloatControl(PragmaLoc, Action, Kind);
}

fn Parser::HandlePragmaFEnvAccess(self) {
    assert!(self.Tok.is(annot_pragma_fenv_access) || self.Tok.is(annot_pragma_fenv_access_ms);
    let mut OOS: OnOffSwitch = self.Tok.getAnnotationValue() as u64 as OnOffSwitch;
    let mut IsEnabled: bool = false;
    match OOS {
        OOS_ON => {
            IsEnabled = true;
        },
        OOS_OFF => {
            IsEnabled = false;
        },
        OOS_DEFAULT => {
            IsEnabled = false;
        },
    }
    let mut PragmaLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaFEnvAccess(PragmaLoc, IsEnabled);
}

fn Parser::HandlePragmaFEnvRound(self) {
    assert!(self.Tok.is(annot_pragma_fenv_round);
    let mut RM: RoundingMode = self.Tok.getAnnotationValue() as u64 as RoundingMode;
    let mut PragmaLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaFEnvRound(PragmaLoc, RM);
}

fn Parser::HandlePragmaCXLimitedRange(self) {
    assert!(self.Tok.is(annot_pragma_cx_limited_range);
    let mut OOS: OnOffSwitch = self.Tok.getAnnotationValue() as u64 as OnOffSwitch;
    let mut Range: ComplexRangeKind = zeroed();
    match OOS {
        OOS_ON => {
            Range = CX_Basic;
        },
        OOS_OFF => {
            Range = CX_Full;
        },
        OOS_DEFAULT => {
            Range = self.getLangOpts().getComplexRange();
        },
    }
    let mut PragmaLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaCXLimitedRange(PragmaLoc, Range);
}

fn Parser::HandlePragmaCaptured(self) -> StmtResult {
    assert!(self.Tok.is(annot_pragma_captured);
    self.ConsumeAnnotationToken();
    if self.Tok.isNot(l_brace) {
        self.PP.Diag(self.Tok, err_expected) << l_brace;
        return StmtError();
    }
    let mut Loc: SourceLocation = self.Tok.getLocation();
    let mut CapturedRegionScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope, true, false };
    self.Actions.ActOnCapturedRegionStart(Loc, self.getCurScope(), CR_Default, 1);
    let mut R: StmtResult = self.ParseCompoundStatement(false);
    CapturedRegionScope.Exit();
    if R.isInvalid() {
        self.Actions.ActOnCapturedRegionError();
        return StmtError();
    }
    return self.Actions.ActOnCapturedRegionEnd(R.get());
}

enum OpenCLExtState {
    Disable = 0,
    Enable = 1,
    Begin = 2,
    End = 3,
}

fn Parser::HandlePragmaOpenCLExtension(self) {
    assert!(self.Tok.is(annot_pragma_opencl_extension);
    let mut Data: *mut OpenCLExtData = self.Tok.getAnnotationValue() as *mut OpenCLExtData;
    let mut State: OpenCLExtState = Data.second;
    let mut Ident: *IdentifierInfo = Data.first;
    let mut NameLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeAnnotationToken();
    let mut Opt: *mut OpenCLOptions = self.Actions.getOpenCLOptions();
    let mut Name: str = Ident.getName();
    if Name == "all" {
        if State == Disable {
            Opt.disableAll();
        } else {
            self.PP.Diag(NameLoc, warn_pragma_expected_predicate) << 1;
        }
    } else if State == Begin {
        if !Opt.isKnown(Name) || !Opt.isSupported(Name, self.getLangOpts()) {
            Opt.support(Name, true);
            Opt.acceptsPragma(Name, true);
        }
    } else if State == End {} else if !Opt.isKnown(Name) || !Opt.isWithPragma(Name) {
        self.PP.Diag(NameLoc, warn_pragma_unknown_extension) << Ident;
    } else if Opt.isSupportedExtension(Name, self.getLangOpts()) {
        Opt.enable(Name, State == Enable);
    } else if Opt.isSupportedCoreOrOptionalCore(Name, self.getLangOpts()) {
        self.PP.Diag(NameLoc, warn_pragma_extension_is_core) << Ident;
    } else {
        self.PP.Diag(NameLoc, warn_pragma_unsupported_extension) << Ident;
    }
}

fn Parser::HandlePragmaMSPointersToMembers(self) {
    assert!(self.Tok.is(annot_pragma_ms_pointers_to_members);
    let mut RepresentationMethod: PragmaMSPointersToMembersKind = self.Tok.getAnnotationValue() as u64 as PragmaMSPointersToMembersKind;
    let mut PragmaLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaMSPointersToMembers(RepresentationMethod, PragmaLoc);
}

fn Parser::HandlePragmaMSVtorDisp(self) {
    assert!(self.Tok.is(annot_pragma_ms_vtordisp);
    let mut Value: u64 = self.Tok.getAnnotationValue() as u64;
    let mut Action: PragmaMsStackAction = (Value >> 16) & 65535 as PragmaMsStackAction;
    let mut Mode: MSVtorDispMode = Value & 65535;
    let mut PragmaLoc: SourceLocation = self.ConsumeAnnotationToken();
    self.Actions.ActOnPragmaMSVtorDisp(Action, PragmaLoc, Mode);
}

fn Parser::HandlePragmaMSPragma(self) {
    assert!(self.Tok.is(annot_pragma_ms_pragma);
    let mut TheTokens: *mut []unique_ptr<Token = self.Tok.getAnnotationValue() as *mut []unique_ptr<Token;
    self.PP.EnterTokenStream(move(TheTokens.first), TheTokens.second, true, true);
    let mut PragmaLocation: SourceLocation = self.ConsumeAnnotationToken();
    assert!(self.Tok.isAnyIdentifier();
    let mut PragmaName: str = self.Tok.getIdentifierInfo().getName();
    self.PP.Lex(self.Tok);
    let mut Handler: PragmaHandler = PragmaName.Case("data_seg", &mut HandlePragmaMSSegment).Case("bss_seg", &mut HandlePragmaMSSegment).Case("const_seg", &mut HandlePragmaMSSegment).Case("code_seg", &mut HandlePragmaMSSegment).Case("section", &mut HandlePragmaMSSection).Case("init_seg", &mut HandlePragmaMSInitSeg).Case("strict_gs_check", &mut HandlePragmaMSStrictGuardStackCheck).Case("function", &mut HandlePragmaMSFunction).Case("alloc_text", &mut HandlePragmaMSAllocText).Case("optimize", &mut HandlePragmaMSOptimize).Case("intrinsic", &mut HandlePragmaMSIntrinsic).operator bool (clang::Parser::*)(llvm::StringRef, clang::SourceLocation)();
    if !self ->* Handler(PragmaName, PragmaLocation) {
        while self.Tok.isNot(eof) {
            self.PP.Lex(self.Tok);
        }
        self.PP.Lex(self.Tok);
    }
}

fn Parser::HandlePragmaMSSection(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    if self.Tok.isNot(l_paren) {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_lparen) << PragmaName;
        return false;
    }
    self.PP.Lex(self.Tok);
    if self.Tok.isNot(string_literal) {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_section_name) << PragmaName;
        return false;
    }
    let mut StringResult: ExprResult = self.ParseStringLiteralExpression(false);
    if StringResult.isInvalid() {
        return false;
    }
    let mut SegmentName: *mut StringLiteral = cast(StringResult.get());
    if SegmentName.getCharByteWidth() != 1 {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_non_wide_string) << PragmaName;
        return false;
    }
    let mut SectionFlags: i32 = PSF_Read;
    let mut SectionFlagsAreDefault: bool = true;
    while self.Tok.is(comma) {
        self.PP.Lex(self.Tok);
        if self.Tok.is(kw_long) || self.Tok.is(kw_short) {
            self.PP.Lex(self.Tok);
            continue;
        }
        if !self.Tok.isAnyIdentifier() {
            self.PP.Diag(PragmaLocation, warn_pragma_expected_action_or_r_paren) << PragmaName;
            return false;
        }
        let mut Flag: PragmaSectionFlag = self.Tok.getIdentifierInfo().getName().Case("read", PSF_Read).Case("write", PSF_Write).Case("execute", PSF_Execute).Case("shared", PSF_Invalid).Case("nopage", PSF_Invalid).Case("nocache", PSF_Invalid).Case("discard", PSF_Invalid).Case("remove", PSF_Invalid).Default(PSF_None);
        if Flag == PSF_None || Flag == PSF_Invalid {
            self.PP.Diag(PragmaLocation, if Flag == PSF_None { warn_pragma_invalid_specific_action } else { warn_pragma_unsupported_action }) << PragmaName << self.Tok.getIdentifierInfo().getName();
            return false;
        }
        SectionFlags |= Flag;
        SectionFlagsAreDefault = false;
        self.PP.Lex(self.Tok);
    }
    if SectionFlagsAreDefault {
        SectionFlags |= PSF_Write;
    }
    if self.Tok.isNot(r_paren) {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_rparen) << PragmaName;
        return false;
    }
    self.PP.Lex(self.Tok);
    if self.Tok.isNot(eof) {
        self.PP.Diag(PragmaLocation, warn_pragma_extra_tokens_at_eol) << PragmaName;
        return false;
    }
    self.PP.Lex(self.Tok);
    self.Actions.ActOnPragmaMSSection(PragmaLocation, SectionFlags, SegmentName);
    return true;
}

fn Parser::HandlePragmaMSSegment(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    if self.Tok.isNot(l_paren) {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_lparen) << PragmaName;
        return false;
    }
    self.PP.Lex(self.Tok);
    let mut Action: PragmaMsStackAction = PSK_Reset;
    let mut SlotLabel: str = "";
    if self.Tok.isAnyIdentifier() {
        let mut PushPop: str = self.Tok.getIdentifierInfo().getName();
        if PushPop == "push" {
            Action = PSK_Push;
        } else if PushPop == "pop" {
            Action = PSK_Pop;
        } else {
            self.PP.Diag(PragmaLocation, warn_pragma_expected_section_push_pop_or_name) << PragmaName;
            return false;
        }
        if Action != PSK_Reset {
            self.PP.Lex(self.Tok);
            if self.Tok.is(comma) {
                self.PP.Lex(self.Tok);
                if self.Tok.isAnyIdentifier() {
                    SlotLabel = self.Tok.getIdentifierInfo().getName();
                    self.PP.Lex(self.Tok);
                    if self.Tok.is(comma) {
                        self.PP.Lex(self.Tok);
                    } else if self.Tok.isNot(r_paren) {
                        self.PP.Diag(PragmaLocation, warn_pragma_expected_punc) << PragmaName;
                        return false;
                    }
                }
            } else if self.Tok.isNot(r_paren) {
                self.PP.Diag(PragmaLocation, warn_pragma_expected_punc) << PragmaName;
                return false;
            }
        }
    }
    let mut SegmentName: *mut StringLiteral = null;
    if self.Tok.isNot(r_paren) {
        if self.Tok.isNot(string_literal) {
            let mut DiagID: u32 = if Action != PSK_Reset { if !SlotLabel.is_empty() { warn_pragma_expected_section_name } else { warn_pragma_expected_section_label_or_name } } else { warn_pragma_expected_section_push_pop_or_name };
            self.PP.Diag(PragmaLocation, DiagID) << PragmaName;
            return false;
        }
        let mut StringResult: ExprResult = self.ParseStringLiteralExpression(false);
        if StringResult.isInvalid() {
            return false;
        }
        SegmentName = cast(StringResult.get());
        if SegmentName.getCharByteWidth() != 1 {
            self.PP.Diag(PragmaLocation, warn_pragma_expected_non_wide_string) << PragmaName;
            return false;
        }
        if SegmentName.getLength() {
            Action = (Action | PSK_Set) as PragmaMsStackAction;
        }
    }
    if self.Tok.isNot(r_paren) {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_rparen) << PragmaName;
        return false;
    }
    self.PP.Lex(self.Tok);
    if self.Tok.isNot(eof) {
        self.PP.Diag(PragmaLocation, warn_pragma_extra_tokens_at_eol) << PragmaName;
        return false;
    }
    self.PP.Lex(self.Tok);
    self.Actions.ActOnPragmaMSSeg(PragmaLocation, Action, SlotLabel, SegmentName, PragmaName);
    return true;
}

fn Parser::HandlePragmaMSInitSeg(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    if self.getTargetInfo().getTriple().getEnvironment() != MSVC {
        self.PP.Diag(PragmaLocation, warn_pragma_init_seg_unsupported_target);
        return false;
    }
    if self.ExpectAndConsume(l_paren, warn_pragma_expected_lparen, PragmaName) {
        return false;
    }
    let mut SegmentName: *mut StringLiteral = null;
    if self.Tok.isAnyIdentifier() {
        let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut Section: str = II.getName().Case("compiler", "\".CRT$XCC\"").Case("lib", "\".CRT$XCL\"").Case("user", "\".CRT$XCU\"").Default("");
        if !Section.is_empty() {
            let mut Toks: [1]Token = [1]Token {};
            Toks[0].startToken();
            Toks[0].setKind(string_literal);
            Toks[0].setLocation(self.Tok.getLocation());
            Toks[0].setLiteralData(Section.ptr);
            Toks[0].setLength(Section.len);
            SegmentName = cast(self.Actions.ActOnStringLiteral(Toks, null).get());
            self.PP.Lex(self.Tok);
        }
    } else if self.Tok.is(string_literal) {
        let mut StringResult: ExprResult = self.ParseStringLiteralExpression(false);
        if StringResult.isInvalid() {
            return false;
        }
        SegmentName = cast(StringResult.get());
        if SegmentName.getCharByteWidth() != 1 {
            self.PP.Diag(PragmaLocation, warn_pragma_expected_non_wide_string) << PragmaName;
            return false;
        }
    }
    if !SegmentName {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_init_seg) << PragmaName;
        return false;
    }
    if self.ExpectAndConsume(r_paren, warn_pragma_expected_rparen, PragmaName) || self.ExpectAndConsume(eof, warn_pragma_extra_tokens_at_eol, PragmaName) {
        return false;
    }
    self.Actions.ActOnPragmaMSInitSeg(PragmaLocation, SegmentName);
    return true;
}

fn Parser::HandlePragmaMSStrictGuardStackCheck(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    if self.ExpectAndConsume(l_paren, warn_pragma_expected_lparen, PragmaName) {
        return false;
    }
    let mut Action: PragmaMsStackAction = PSK_Set;
    if self.Tok.is(identifier) {
        let mut PushPop: str = self.Tok.getIdentifierInfo().getName();
        if PushPop == "push" {
            self.PP.Lex(self.Tok);
            Action = PSK_Push;
            if self.ExpectAndConsume(comma, warn_pragma_expected_punc, PragmaName) {
                return false;
            }
        } else if PushPop == "pop" {
            self.PP.Lex(self.Tok);
            Action = PSK_Pop;
        }
    }
    let mut Value: bool = false;
    if Action & PSK_Push || Action & PSK_Set {
        let mut II: *IdentifierInfo = self.Tok.getIdentifierInfo();
        if II && II.isStr("off") {
            self.PP.Lex(self.Tok);
            Value = false;
        } else if II && II.isStr("on") {
            self.PP.Lex(self.Tok);
            Value = true;
        } else {
            self.PP.Diag(self.Tok.getLocation(), warn_pragma_invalid_action) << PragmaName;
            return false;
        }
    }
    if self.ExpectAndConsume(r_paren, warn_pragma_expected_rparen, PragmaName) {
        return false;
    }
    if self.ExpectAndConsume(eof, warn_pragma_extra_tokens_at_eol, PragmaName) {
        return false;
    }
    self.Actions.ActOnPragmaMSStrictGuardStackCheck(PragmaLocation, Action, Value);
    return true;
}

fn Parser::HandlePragmaMSAllocText(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    let mut FirstTok: Token = self.Tok;
    if self.ExpectAndConsume(l_paren, warn_pragma_expected_lparen, PragmaName) {
        return false;
    }
    let mut Section: str = "";
    if self.Tok.is(string_literal) {
        let mut StringResult: ExprResult = self.ParseStringLiteralExpression(false);
        if StringResult.isInvalid() {
            return false;
        }
        let mut SegmentName: *mut StringLiteral = cast(StringResult.get());
        if SegmentName.getCharByteWidth() != 1 {
            self.PP.Diag(PragmaLocation, warn_pragma_expected_non_wide_string) << PragmaName;
            return false;
        }
        Section = SegmentName.getString();
    } else if self.Tok.is(identifier) {
        Section = self.Tok.getIdentifierInfo().getName();
        self.PP.Lex(self.Tok);
    } else {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_section_name) << PragmaName;
        return false;
    }
    if self.ExpectAndConsume(comma, warn_pragma_expected_comma, PragmaName) {
        return false;
    }
    let mut Functions: tuple<IdentifierInfo *, SourceLocation>> = tuple<IdentifierInfo *, SourceLocation>> {};
    while true {
        if self.Tok.isNot(identifier) {
            self.PP.Diag(self.Tok.getLocation(), warn_pragma_expected_identifier) << PragmaName;
            return false;
        }
        let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        Functions.push(II, self.Tok.getLocation());
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(comma) {
            break;
        }
        self.PP.Lex(self.Tok);
    }
    if self.ExpectAndConsume(r_paren, warn_pragma_expected_rparen, PragmaName) || self.ExpectAndConsume(eof, warn_pragma_extra_tokens_at_eol, PragmaName) {
        return false;
    }
    self.Actions.ActOnPragmaMSAllocText(FirstTok.getLocation(), Section, Functions);
    return true;
}

fn Parser::zOSHandlePragmaHelper(self, PragmaKind: TokenKind) {
    assert!(self.Tok.is(PragmaKind);
    let mut PragmaName: str = "export";
    let mut TheTokens: *mut []unique_ptr<Token = self.Tok.getAnnotationValue() as *mut []unique_ptr<Token;
    self.PP.EnterTokenStream(move(TheTokens.first), TheTokens.second, true, true);
    self.Tok.setAnnotationValue(null);
    self.ConsumeAnnotationToken();
    let mut OnReturn: Closure_1 = Closure_1 { cap_0: self };
    while true {
        {
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(l_paren) {
            self.PP.Diag(self.Tok.getLocation(), warn_pragma_expected_lparen) << PragmaName;
            return;
        }
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(identifier) {
            self.PP.Diag(self.Tok.getLocation(), warn_pragma_expected_identifier) << PragmaName;
            return;
        }
        let mut IdentName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut IdentNameLoc: SourceLocation = self.Tok.getLocation();
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(r_paren) {
            self.PP.Diag(self.Tok.getLocation(), warn_pragma_expected_rparen) << PragmaName;
            return;
        }
        self.PP.Lex(self.Tok);
        self.Actions.ActOnPragmaExport(IdentName, IdentNameLoc, self.getCurScope());
        if self.Tok.is(identifier) || self.Tok.is(kw_export) {
            PragmaName = self.Tok.getIdentifierInfo().getName();
            if PragmaName != "export" {
                self.PP.Diag(self.Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << PragmaName;
            }
        } else if self.Tok.isNot(eof) {
            self.PP.Diag(self.Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << PragmaName;
            return;
        }
    }
        if !(self.Tok.isNot(eof)) { break; }
    }
    return;
}

fn Parser::HandlePragmaExport(self) {
    assert!(self.Tok.is(annot_pragma_export);
    self.zOSHandlePragmaHelper(annot_pragma_export);
}

fn PragmaLoopHintString(PragmaName: Token, Option: Token) -> str {
    let mut Str: str = PragmaName.getIdentifierInfo().getName();
    let mut ClangLoopStr: str = "clang loop ";
    if Str == "loop" && Option.getIdentifierInfo() {
        operator(ClangLoopStr, Option.getIdentifierInfo().getName());
    }
    return Str.Case("loop", ClangLoopStr).Case("unroll_and_jam", Str).Case("unroll", Str).Default("")[0..allocator<char> {}];
}

fn Parser::HandlePragmaLoopHint(self, Hint: *mut LoopHint) -> bool {
    assert!(self.Tok.is(annot_pragma_loop_hint);
    let mut Info: *mut PragmaLoopHintInfo = self.Tok.getAnnotationValue() as *mut PragmaLoopHintInfo;
    let mut PragmaNameInfo: *mut IdentifierInfo = Info.PragmaName.getIdentifierInfo();
    Hint.PragmaNameLoc = IdentifierLoc { Loc: Info.PragmaName.getLocation(), II: PragmaNameInfo };
    let mut OptionInfo: *mut IdentifierInfo = if Info.Option.is(identifier) { Info.Option.getIdentifierInfo() } else { null };
    Hint.OptionLoc = IdentifierLoc { Loc: Info.Option.getLocation(), II: OptionInfo };
    let mut Toks: ArrayRef<Token> = Info.Toks;
    let mut IsLoopHint: bool = PragmaNameInfo.getName().Cases(["unroll", "nounroll", "unroll_and_jam", "nounroll_and_jam"], true).Default(false);
    if Toks.is_empty() && IsLoopHint {
        self.ConsumeAnnotationToken();
        Hint.Range = Info.PragmaName.getLocation();
        return true;
    }
    assert!(!Toks.is_empty(), "PragmaLoopHintInfo::Toks must contain at least one token.");
    let mut OptionUnroll: bool = false;
    let mut OptionUnrollAndJam: bool = false;
    let mut OptionDistribute: bool = false;
    let mut OptionPipelineDisabled: bool = false;
    let mut OptionLICMDisabled: bool = false;
    let mut StateOption: bool = false;
    if OptionInfo {
        OptionUnroll = OptionInfo.isStr("unroll");
        OptionUnrollAndJam = OptionInfo.isStr("unroll_and_jam");
        OptionDistribute = OptionInfo.isStr("distribute");
        OptionPipelineDisabled = OptionInfo.isStr("pipeline");
        OptionLICMDisabled = OptionInfo.isStr("licm");
        StateOption = OptionInfo.getName().Case("vectorize", true).Case("interleave", true).Case("vectorize_predicate", true).Default(false) || OptionUnroll || OptionUnrollAndJam || OptionDistribute || OptionPipelineDisabled || OptionLICMDisabled;
    }
    let mut AssumeSafetyArg: bool = !OptionUnroll && !OptionUnrollAndJam && !OptionDistribute && !OptionPipelineDisabled && !OptionLICMDisabled;
    if Toks[0].is(eof) {
        self.ConsumeAnnotationToken();
        self.Diag(Toks[0].getLocation(), err_pragma_loop_missing_argument) << StateOption << (OptionUnroll || OptionUnrollAndJam) << AssumeSafetyArg;
        return false;
    }
    if StateOption {
        self.ConsumeAnnotationToken();
        let mut StateLoc: SourceLocation = Toks[0].getLocation();
        let mut StateInfo: *mut IdentifierInfo = Toks[0].getIdentifierInfo();
        let mut Valid: bool = StateInfo && StateInfo.getName().Case("disable", true).Case("enable", !OptionPipelineDisabled && !OptionLICMDisabled).Case("full", OptionUnroll || OptionUnrollAndJam).Case("assume_safety", AssumeSafetyArg).Default(false);
        if !Valid {
            if OptionPipelineDisabled || OptionLICMDisabled {
                self.Diag(Toks[0].getLocation(), err_pragma_pipeline_invalid_keyword);
            } else {
                self.Diag(Toks[0].getLocation(), err_pragma_invalid_keyword) << (OptionUnroll || OptionUnrollAndJam) << AssumeSafetyArg;
            }
            return false;
        }
        if Toks.len > 2 {
            self.Diag(self.Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << PragmaLoopHintString(Info.PragmaName, Info.Option);
        }
        Hint.StateLoc = IdentifierLoc { Loc: StateLoc, II: StateInfo };
    } else if OptionInfo && OptionInfo.getName() == "vectorize_width" {
        self.PP.EnterTokenStream(Toks, false, false);
        self.ConsumeAnnotationToken();
        let mut StateLoc: SourceLocation = Toks[0].getLocation();
        let mut StateInfo: *mut IdentifierInfo = Toks[0].getIdentifierInfo();
        let mut IsScalableStr: str = if StateInfo { StateInfo.getName() } else { "" };
        if IsScalableStr == "scalable" || IsScalableStr == "fixed" {
            self.PP.Lex(self.Tok);
            if Toks.len > 2 {
                self.Diag(self.Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << PragmaLoopHintString(Info.PragmaName, Info.Option);
                while self.Tok.isNot(eof) {
                    self.ConsumeAnyToken(false);
                }
            }
            Hint.StateLoc = IdentifierLoc { Loc: StateLoc, II: StateInfo };
            self.ConsumeToken();
        } else {
            let mut R: ExprResult = self.ParseConstantExpression();
            if R.isInvalid() && !self.Tok.is(comma) {
                self.Diag(Toks[0].getLocation(), note_pragma_loop_invalid_vectorize_option);
            }
            let mut Arg2Error: bool = false;
            if self.Tok.is(comma) {
                self.PP.Lex(self.Tok);
                StateInfo = self.Tok.getIdentifierInfo();
                IsScalableStr = if StateInfo { StateInfo.getName() } else { "" };
                if IsScalableStr != "scalable" && IsScalableStr != "fixed" {
                    self.Diag(self.Tok.getLocation(), err_pragma_loop_invalid_vectorize_option);
                    Arg2Error = true;
                } else {
                    Hint.StateLoc = IdentifierLoc { Loc: StateLoc, II: StateInfo };
                }
                self.PP.Lex(self.Tok);
            }
            if self.Tok.isNot(eof) {
                self.Diag(self.Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << PragmaLoopHintString(Info.PragmaName, Info.Option);
                while self.Tok.isNot(eof) {
                    self.ConsumeAnyToken(false);
                }
            }
            self.ConsumeToken();
            if Arg2Error || R.isInvalid() || self.Actions.CheckLoopHintExpr(R.get(), Toks[0].getLocation(), false) {
                return false;
            }
            Hint.ValueExpr = R.get();
        }
    } else {
        self.PP.EnterTokenStream(Toks, false, false);
        self.ConsumeAnnotationToken();
        let mut R: ExprResult = self.ParseConstantExpression();
        if self.Tok.isNot(eof) {
            self.Diag(self.Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << PragmaLoopHintString(Info.PragmaName, Info.Option);
            while self.Tok.isNot(eof) {
                self.ConsumeAnyToken(false);
            }
        }
        self.ConsumeToken();
        if R.isInvalid() || self.Actions.CheckLoopHintExpr(R.get(), Toks[0].getLocation(), true) {
            return false;
        }
        Hint.ValueExpr = R.get();
    }
    Hint.Range = SourceRange { B: Info.PragmaName.getLocation(), E: Info.Toks.back().getLocation() };
    return true;
}

struct PragmaAttributeInfo {
    Attributes: *mut ParsedAttributes,
    Action: ActionType,
    Namespace: *IdentifierInfo,
    Tokens: ArrayRef<Token>,
}

fn getIdentifier(Tok: *Token) -> str {
    if Tok.is(identifier) {
        return Tok.getIdentifierInfo().getName();
    }
    let mut S: *u8 = getKeywordSpelling(Tok.getKind());
    if !S {
        return "";
    }
    return S;
}

fn isAbstractAttrMatcherRule(Rule: SubjectMatchRule) -> bool {
    match Rule {
        SubjectMatchRule_block => {
            return 0;
        },
        SubjectMatchRule_enum => {
            return 0;
        },
        SubjectMatchRule_enum_constant => {
            return 0;
        },
        SubjectMatchRule_field => {
            return 0;
        },
        SubjectMatchRule_function => {
            return 0;
        },
        SubjectMatchRule_function_is_member => {
            return 0;
        },
        SubjectMatchRule_namespace => {
            return 0;
        },
        SubjectMatchRule_objc_category => {
            return 0;
        },
        SubjectMatchRule_objc_implementation => {
            return 0;
        },
        SubjectMatchRule_objc_interface => {
            return 0;
        },
        SubjectMatchRule_objc_method => {
            return 0;
        },
        SubjectMatchRule_objc_method_is_instance => {
            return 0;
        },
        SubjectMatchRule_objc_property => {
            return 0;
        },
        SubjectMatchRule_objc_protocol => {
            return 0;
        },
        SubjectMatchRule_record => {
            return 0;
        },
        SubjectMatchRule_record_not_is_union => {
            return 0;
        },
        SubjectMatchRule_hasType_abstract => {
            return 1;
        },
        SubjectMatchRule_hasType_functionType => {
            return 0;
        },
        SubjectMatchRule_type_alias => {
            return 0;
        },
        SubjectMatchRule_variable => {
            return 0;
        },
        SubjectMatchRule_variable_is_thread_local => {
            return 0;
        },
        SubjectMatchRule_variable_is_global => {
            return 0;
        },
        SubjectMatchRule_variable_is_local => {
            return 0;
        },
        SubjectMatchRule_variable_is_parameter => {
            return 0;
        },
        SubjectMatchRule_variable_not_is_parameter => {
            return 0;
        },
    }
    llvm_unreachable_internal("Invalid attribute subject match rule", "P:/Goraw/llvm-project/clang/lib/Parse/ParsePragma.cpp", 1722);
    return false;
}

fn diagnoseExpectedAttributeSubjectSubRule(PRef: *mut Parser, PrimaryRule: SubjectMatchRule, PrimaryRuleName: str, SubRuleLoc: SourceLocation) {
    let mut Diagnostic: DiagnosticBuilder = PRef.Diag(SubRuleLoc, err_pragma_attribute_expected_subject_sub_identifier) << PrimaryRuleName;
    if validAttributeSubjectMatchSubRules(PrimaryRule) {
        SubRules;
    } else {
        Diagnostic << 1 << SubRules;
    }
}

fn diagnoseUnknownAttributeSubjectSubRule(PRef: *mut Parser, PrimaryRule: SubjectMatchRule, PrimaryRuleName: str, SubRuleName: str, SubRuleLoc: SourceLocation) {
    let mut Diagnostic: DiagnosticBuilder = PRef.Diag(SubRuleLoc, err_pragma_attribute_unknown_subject_sub_rule) << SubRuleName << PrimaryRuleName;
    if validAttributeSubjectMatchSubRules(PrimaryRule) {
        SubRules;
    } else {
        Diagnostic << 1 << SubRules;
    }
}

fn Parser::ParsePragmaAttributeSubjectMatchRuleSet(self, SubjectMatchRules: *mut ParsedSubjectMatchRuleSet, AnyLoc: *mut SourceLocation, LastMatchRuleEndLoc: *mut SourceLocation) -> bool {
    let mut IsAny: bool = false;
    let mut AnyParens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if getIdentifier(self.Tok) == "any" {
        AnyLoc = self.ConsumeToken();
        IsAny = true;
        if AnyParens.expectAndConsume(err_expected, "", unknown) {
            return true;
        }
    }
    while true {
        {
        let mut Name: str = getIdentifier(self.Tok);
        if Name.is_empty() {
            self.Diag(self.Tok, err_pragma_attribute_expected_subject_identifier);
            return true;
        }
        let mut Rule: SubjectMatchRule> (*)(StringRef, bool)> = isAttributeSubjectMatchRule(Name);
        if !Rule.first {
            self.Diag(self.Tok, err_pragma_attribute_unknown_subject_rule) << Name;
            return true;
        }
        let mut PrimaryRule: SubjectMatchRule = operator(Rule.first);
        let mut RuleLoc: SourceLocation = self.ConsumeToken();
        let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        if isAbstractAttrMatcherRule(PrimaryRule) {
            if Parens.expectAndConsume(err_expected, "", unknown) {
                return true;
            }
        } else if Parens.consumeOpen() {
            if !SubjectMatchRules.insert(make_pair(PrimaryRule, SourceRange { B: RuleLoc, E: RuleLoc })).second {
                self.Diag(RuleLoc, err_pragma_attribute_duplicate_subject) << Name << CreateRemoval(SourceRange { B: RuleLoc, E: if self.Tok.is(comma) { self.Tok.getLocation() } else { RuleLoc } });
            }
            LastMatchRuleEndLoc = RuleLoc;
            continue;
        }
        let mut SubRuleName: str = getIdentifier(self.Tok);
        if SubRuleName.is_empty() {
            diagnoseExpectedAttributeSubjectSubRule(*self, PrimaryRule, Name, self.Tok.getLocation());
            return true;
        }
        let mut SubRule: SubjectMatchRule = zeroed();
        if SubRuleName == "unless" {
            let mut SubRuleLoc: SourceLocation = self.ConsumeToken();
            let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
            if Parens.expectAndConsume(err_expected, "", unknown) {
                return true;
            }
            SubRuleName = getIdentifier(self.Tok);
            if SubRuleName.is_empty() {
                diagnoseExpectedAttributeSubjectSubRule(*self, PrimaryRule, Name, SubRuleLoc);
                return true;
            }
            let mut SubRuleOrNone: SubjectMatchRule> = Rule.second(SubRuleName, true);
            if !SubRuleOrNone {
                let mut SubRuleUnlessName: str = "unless(" + SubRuleName + ")";
                diagnoseUnknownAttributeSubjectSubRule(*self, PrimaryRule, Name, SubRuleUnlessName, SubRuleLoc);
                return true;
            }
            SubRule = operator(SubRuleOrNone);
            self.ConsumeToken();
            if Parens.consumeClose() {
                return true;
            }
        } else {
            let mut SubRuleOrNone: SubjectMatchRule> = Rule.second(SubRuleName, false);
            if !SubRuleOrNone {
                diagnoseUnknownAttributeSubjectSubRule(*self, PrimaryRule, Name, SubRuleName, self.Tok.getLocation());
                return true;
            }
            SubRule = operator(SubRuleOrNone);
            self.ConsumeToken();
        }
        let mut RuleEndLoc: SourceLocation = self.Tok.getLocation();
        LastMatchRuleEndLoc = RuleEndLoc;
        if Parens.consumeClose() {
            return true;
        }
        if !SubjectMatchRules.insert(make_pair(SubRule, SourceRange { B: RuleLoc, E: RuleEndLoc })).second {
            self.Diag(RuleLoc, err_pragma_attribute_duplicate_subject) << getSubjectMatchRuleSpelling(SubRule) << CreateRemoval(SourceRange { B: RuleLoc, E: if self.Tok.is(comma) { self.Tok.getLocation() } else { RuleEndLoc } });
            continue;
        }
    }
        if !(IsAny && self.TryConsumeToken(comma)) { break; }
    }
    if IsAny {
        if AnyParens.consumeClose() {
            return true;
        }
    }
    return false;
}

enum MissingAttributeSubjectRulesRecoveryPoint {
    Comma = 0,
    ApplyTo = 1,
    Equals = 2,
    Any = 3,
    None = 4,
}

fn getAttributeSubjectRulesRecoveryPointForToken(Tok: *Token) -> MissingAttributeSubjectRulesRecoveryPoint {
    if Tok.getIdentifierInfo() {
        II;
    } else {
        if II.isStr("apply_to") {
            return ApplyTo;
        }
        if II.isStr("any") {
            return Any;
        }
    }
    if Tok.is(equal) {
        return Equals;
    }
    return None;
}

fn createExpectedAttributeSubjectRulesTokenDiagnostic(DiagID: u32, Attrs: *mut ParsedAttributes, Point: MissingAttributeSubjectRulesRecoveryPoint, PRef: *mut Parser) -> DiagnosticBuilder {
    let mut Loc: SourceLocation = PRef.getEndOfPreviousToken();
    if Loc.isInvalid() {
        Loc = PRef.getCurToken().getLocation();
    }
    let mut Diagnostic: DiagnosticBuilder = PRef.Diag(Loc, DiagID);
    let mut FixIt: str = "";
    let mut EndPoint: MissingAttributeSubjectRulesRecoveryPoint = getAttributeSubjectRulesRecoveryPointForToken(PRef.getCurToken());
    if Point == Comma {
        FixIt = ", ";
    }
    if Point <= ApplyTo && EndPoint > ApplyTo {
        operator(FixIt, "apply_to");
    }
    if Point <= Equals && EndPoint > Equals {
        operator(FixIt, " = ");
    }
    let mut FixItRange: SourceRange = Loc;
    if EndPoint == None {
        let mut IsMatchRuleAvailable: BitVector = BitVector { Bits: SubjectMatchRule_Last + 1, Size: true };
        for Attribute in Attrs {
            let mut MatchRules: SubjectMatchRule, bool>, 4> = SubjectMatchRule, bool>, 4> {};
            Attribute.getMatchRules(PRef.getLangOpts(), MatchRules);
            let mut IsSupported: BitVector = BitVector { Bits: SubjectMatchRule_Last + 1, Size: false };
            for Rule in MatchRules {
                if !Rule.second {
                    continue;
                }
                IsSupported[Rule.first] = true;
            }
            operator(IsMatchRuleAvailable, IsSupported);
        }
        if IsMatchRuleAvailable.count() == 0 {
            return Diagnostic;
        }
        operator(FixIt, "any(");
        let mut NeedsComma: bool = false;
        for let mut I: u32 = 0; I <= SubjectMatchRule_Last; I += 1 {
            if !IsMatchRuleAvailable[I] {
                continue;
            }
            if NeedsComma {
                operator(FixIt, ", ");
            } else {
                NeedsComma = true;
            }
            operator(FixIt, getSubjectMatchRuleSpelling(I as SubjectMatchRule));
        }
        operator(FixIt, ")");
        PRef.SkipUntil(eof, StopBeforeMatch);
        FixItRange.setEnd(PRef.getCurToken().getLocation());
    }
    if FixItRange.getBegin() == FixItRange.getEnd() {
        Diagnostic << CreateInsertion(FixItRange.getBegin(), FixIt, false);
    } else {
        Diagnostic << CreateReplacement(getCharRange(FixItRange), FixIt);
    }
    return Diagnostic;
}

fn Parser::HandlePragmaAttribute(self) {
    assert!(self.Tok.is(annot_pragma_attribute), "Expected #pragma attribute annotation token");
    let mut PragmaLoc: SourceLocation = self.Tok.getLocation();
    let mut Info: *mut PragmaAttributeInfo = self.Tok.getAnnotationValue() as *mut PragmaAttributeInfo;
    if Info.Action == Pop {
        self.ConsumeAnnotationToken();
        self.Actions.ActOnPragmaAttributePop(PragmaLoc, Info.Namespace);
        return;
    }
    assert!((Info.Action == Push || Info.Action == Attribute), "Unexpected #pragma attribute command");
    if Info.Action == Push && Info.Tokens.is_empty() {
        self.ConsumeAnnotationToken();
        self.Actions.ActOnPragmaAttributeEmptyPush(PragmaLoc, Info.Namespace);
        return;
    }
    self.PP.EnterTokenStream(Info.Tokens, false, false);
    self.ConsumeAnnotationToken();
    let mut Attrs: *mut ParsedAttributes = Info.Attributes;
    Attrs.clearListOnly();
    let mut SkipToEnd: Closure_2 = Closure_2 { cap_0: self };
    if (self.Tok.is(l_square) && self.NextToken().is(l_square)) || self.Tok.isRegularKeywordAttribute() {
        let mut EndLoc: SourceLocation = self.Tok.getLocation();
        self.ParseCXX11AttributeSpecifier(Attrs, &mut EndLoc);
    } else if self.Tok.is(kw___attribute) {
        self.ConsumeToken();
        if self.ExpectAndConsume(l_paren, err_expected_lparen_after, "attribute") {
            return SkipToEnd.call();
        }
        if self.ExpectAndConsume(l_paren, err_expected_lparen_after, "(") {
            return SkipToEnd.call();
        }
        if self.Tok.is(code_completion) {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteAttribute(AS_GNU, Attribute, null);
            return SkipToEnd.call();
        }
        while true {
            {
            if self.Tok.isNot(identifier) {
                self.Diag(self.Tok, err_pragma_attribute_expected_attribute_name);
                SkipToEnd.call();
                return;
            }
            let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
            if self.Tok.isNot(l_paren) {
                Attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, GNU(), SourceLocation {});
            } else {
                self.ParseGNUAttributeArgs(AttrName, AttrNameLoc, Attrs, null, null, SourceLocation {}, GNU(), null);
            }
        }
            if !(self.TryConsumeToken(comma)) { break; }
        }
        if self.ExpectAndConsume(r_paren, err_expected, "") {
            return SkipToEnd.call();
        }
        if self.ExpectAndConsume(r_paren, err_expected, "") {
            return SkipToEnd.call();
        }
    } else if self.Tok.is(kw___declspec) {
        self.ParseMicrosoftDeclSpecs(Attrs);
    } else {
        self.Diag(self.Tok, err_pragma_attribute_expected_attribute_syntax);
        if self.Tok.getIdentifierInfo() {
            if getParsedKind(self.Tok.getIdentifierInfo(), null, AS_GNU) != UnknownAttribute {
                let mut InsertStartLoc: SourceLocation = self.Tok.getLocation();
                self.ConsumeToken();
                if self.Tok.is(l_paren) {
                    self.ConsumeAnyToken(false);
                    self.SkipUntil(r_paren, StopBeforeMatch);
                    if self.Tok.isNot(r_paren) {
                        return SkipToEnd.call();
                    }
                }
                self.Diag(self.Tok, note_pragma_attribute_use_attribute_kw) << CreateInsertion(InsertStartLoc, "__attribute__((", false) << CreateInsertion(self.Tok.getEndLoc(), "))", false);
            }
        }
        SkipToEnd.call();
        return;
    }
    if Attrs.is_empty() || operator(operator(Attrs.begin())).isInvalid() {
        SkipToEnd.call();
        return;
    }
    for Attribute in Attrs {
        if !Attribute.isSupportedByPragmaAttribute() {
            self.Diag(PragmaLoc, err_pragma_attribute_unsupported_attribute) << Attribute;
            SkipToEnd.call();
            return;
        }
    }
    if !self.TryConsumeToken(comma) {
        createExpectedAttributeSubjectRulesTokenDiagnostic(err_expected, Attrs, Comma, *self) << comma;
        SkipToEnd.call();
        return;
    }
    if self.Tok.isNot(identifier) {
        createExpectedAttributeSubjectRulesTokenDiagnostic(err_pragma_attribute_invalid_subject_set_specifier, Attrs, ApplyTo, *self);
        SkipToEnd.call();
        return;
    }
    let mut II: *IdentifierInfo = self.Tok.getIdentifierInfo();
    if !II.isStr("apply_to") {
        createExpectedAttributeSubjectRulesTokenDiagnostic(err_pragma_attribute_invalid_subject_set_specifier, Attrs, ApplyTo, *self);
        SkipToEnd.call();
        return;
    }
    self.ConsumeToken();
    if !self.TryConsumeToken(equal) {
        createExpectedAttributeSubjectRulesTokenDiagnostic(err_expected, Attrs, Equals, *self) << equal;
        SkipToEnd.call();
        return;
    }
    let mut SubjectMatchRules: ParsedSubjectMatchRuleSet = ParsedSubjectMatchRuleSet {};
    let mut AnyLoc: SourceLocation = SourceLocation {};
    let mut LastMatchRuleEndLoc: SourceLocation = SourceLocation {};
    if self.ParsePragmaAttributeSubjectMatchRuleSet(SubjectMatchRules, AnyLoc, LastMatchRuleEndLoc) {
        SkipToEnd.call();
        return;
    }
    if self.Tok.isNot(eof) {
        self.Diag(self.Tok, err_pragma_attribute_extra_tokens_after_attribute);
        SkipToEnd.call();
        return;
    }
    self.ConsumeToken();
    if Info.Action == Push {
        self.Actions.ActOnPragmaAttributeEmptyPush(PragmaLoc, Info.Namespace);
    }
    for Attribute in Attrs {
        self.Actions.ActOnPragmaAttributeAttribute(Attribute, PragmaLoc, SubjectMatchRules);
    }
}

fn PragmaGCCVisibilityHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, VisTok: *mut Token) {
    let mut VisLoc: SourceLocation = VisTok.getLocation();
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    let mut PushPop: *IdentifierInfo = Tok.getIdentifierInfo();
    let mut VisType: *IdentifierInfo = null;
    if PushPop && PushPop.isStr("pop") {
        VisType = null;
    } else if PushPop && PushPop.isStr("push") {
        PP.LexUnexpandedToken(Tok);
        if Tok.isNot(l_paren) {
            PP.Diag(Tok.getLocation(), warn_pragma_expected_lparen) << "visibility";
            return;
        }
        PP.LexUnexpandedToken(Tok);
        VisType = Tok.getIdentifierInfo();
        if !VisType {
            PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << "visibility";
            return;
        }
        PP.LexUnexpandedToken(Tok);
        if Tok.isNot(r_paren) {
            PP.Diag(Tok.getLocation(), warn_pragma_expected_rparen) << "visibility";
            return;
        }
    } else {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << "visibility";
        return;
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "visibility";
        return;
    }
    let mut Toks: []Token = make_unique(1);
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_vis);
    Toks[0].setLocation(VisLoc);
    Toks[0].setAnnotationEndLoc(EndLoc);
    Toks[0].setAnnotationValue(VisType as *void);
    PP.EnterTokenStream(move(Toks), 1, true, false);
}

fn PragmaPackHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, PackTok: *mut Token) {
    let mut PackLoc: SourceLocation = PackTok.getLocation();
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_lparen) << "pack";
        return;
    }
    let mut Action: PragmaMsStackAction = PSK_Reset;
    let mut SlotLabel: str = "";
    let mut Alignment: Token = Token {};
    Alignment.startToken();
    PP.Lex(Tok);
    if Tok.is(numeric_constant) {
        Alignment = Tok;
        PP.Lex(Tok);
        Action = if (PP.getLangOpts().ApplePragmaPack || PP.getLangOpts().XLPragmaPack) { PSK_Push_Set } else { PSK_Set };
    } else if Tok.is(identifier) {
        let mut MapPack: Closure_3 = Closure_3 { Action: &mut Action, Alignment: &mut Alignment, Tok: &mut Tok };
        let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
        if II.isStr("show") {
            Action = PSK_Show;
            PP.Lex(Tok);
        } else if II.isStr("packed") && PP.getLangOpts().ZOSExt {
            MapPack.call("1");
            PP.Lex(Tok);
        } else if II.isStr("full") && PP.getLangOpts().ZOSExt {
            MapPack.call("4");
            PP.Lex(Tok);
        } else if II.isStr("twobyte") && PP.getLangOpts().ZOSExt {
            MapPack.call("2");
            PP.Lex(Tok);
        } else if II.isStr("reset") && PP.getLangOpts().ZOSExt {
            Action = PSK_Pop;
            PP.Lex(Tok);
        } else {
            if II.isStr("push") {
                Action = PSK_Push;
            } else if II.isStr("pop") {
                Action = PSK_Pop;
            } else {
                PP.Diag(Tok.getLocation(), warn_pragma_invalid_action) << "pack";
                return;
            }
            PP.Lex(Tok);
            if Tok.is(comma) {
                PP.Lex(Tok);
                if Tok.is(numeric_constant) {
                    Action = (Action | PSK_Set) as PragmaMsStackAction;
                    Alignment = Tok;
                    PP.Lex(Tok);
                } else if Tok.is(identifier) {
                    SlotLabel = Tok.getIdentifierInfo().getName();
                    PP.Lex(Tok);
                    if Tok.is(comma) {
                        PP.Lex(Tok);
                        if Tok.isNot(numeric_constant) {
                            PP.Diag(Tok.getLocation(), warn_pragma_pack_malformed);
                            return;
                        }
                        Action = (Action | PSK_Set) as PragmaMsStackAction;
                        Alignment = Tok;
                        PP.Lex(Tok);
                    }
                } else {
                    PP.Diag(Tok.getLocation(), warn_pragma_pack_malformed);
                    return;
                }
            }
        }
    } else if PP.getLangOpts().ApplePragmaPack || PP.getLangOpts().XLPragmaPack {
        Action = PSK_Pop;
    }
    if Tok.isNot(r_paren) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_rparen) << "pack";
        return;
    }
    let mut RParenLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "pack";
        return;
    }
    let mut Info: *mut PragmaPackInfo = PP.getPreprocessorAllocator().Allocate(1);
    Info.Action = Action;
    Info.SlotLabel = SlotLabel;
    Info.Alignment = Alignment;
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(1), 1 };
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_pack);
    Toks[0].setLocation(PackLoc);
    Toks[0].setAnnotationEndLoc(RParenLoc);
    Toks[0].setAnnotationValue(Info as *mut void);
    PP.EnterTokenStream(Toks, true, false);
}

fn PragmaMSStructHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, MSStructTok: *mut Token) {
    let mut Kind: PragmaMSStructKind = PMSST_OFF;
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), warn_pragma_ms_struct);
        return;
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    if II.isStr("on") {
        Kind = PMSST_ON;
        PP.Lex(Tok);
    } else if II.isStr("off") || II.isStr("reset") {
        PP.Lex(Tok);
    } else {
        PP.Diag(Tok.getLocation(), warn_pragma_ms_struct);
        return;
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "ms_struct";
        return;
    }
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(1), 1 };
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_msstruct);
    Toks[0].setLocation(MSStructTok.getLocation());
    Toks[0].setAnnotationEndLoc(EndLoc);
    Toks[0].setAnnotationValue(Kind as u64 as *mut void);
    PP.EnterTokenStream(Toks, true, false);
}

fn PragmaClangSectionHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut Tok: Token = Token {};
    let mut SecKind: PragmaClangSectionKind = Invalid;
    PP.Lex(Tok);
    while Tok.isNot(eod) {
        if Tok.isNot(identifier) {
            PP.Diag(Tok.getLocation(), err_pragma_expected_clang_section_name) << "clang section";
            return;
        }
        let mut SecType: *IdentifierInfo = Tok.getIdentifierInfo();
        if SecType.isStr("bss") {
            SecKind = BSS;
        } else if SecType.isStr("data") {
            SecKind = Data;
        } else if SecType.isStr("rodata") {
            SecKind = Rodata;
        } else if SecType.isStr("relro") {
            SecKind = Relro;
        } else if SecType.isStr("text") {
            SecKind = Text;
        } else {
            PP.Diag(Tok.getLocation(), err_pragma_expected_clang_section_name) << "clang section";
            return;
        }
        let mut PragmaLocation: SourceLocation = Tok.getLocation();
        PP.Lex(Tok);
        if Tok.isNot(equal) {
            PP.Diag(Tok.getLocation(), err_pragma_clang_section_expected_equal) << SecKind;
            return;
        }
        let mut SecName: str = "";
        if !PP.LexStringLiteral(Tok, SecName, "pragma clang section", false) {
            return;
        }
        self.Actions.ActOnPragmaClangSection(PragmaLocation, (if SecName.len { Set } else { Clear }), SecKind, SecName);
    }
}

fn ParseAlignPragma(PP: *mut Preprocessor, FirstTok: *mut Token, IsOptions: bool) {
    let mut Tok: Token = Token {};
    if IsOptions {
        PP.Lex(Tok);
        if Tok.isNot(identifier) || !Tok.getIdentifierInfo().isStr("align") {
            PP.Diag(Tok.getLocation(), warn_pragma_options_expected_align);
            return;
        }
    }
    PP.Lex(Tok);
    if PP.getLangOpts().XLPragmaPack {
        if Tok.isNot(l_paren) {
            PP.Diag(Tok.getLocation(), warn_pragma_expected_lparen) << "align";
            return;
        }
    } else if Tok.isNot(equal) {
        PP.Diag(Tok.getLocation(), warn_pragma_align_expected_equal) << IsOptions;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << (if IsOptions { "options" } else { "align" });
        return;
    }
    let mut Kind: PragmaOptionsAlignKind = Natural;
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    if II.isStr("native") {
        Kind = Native;
    } else if II.isStr("natural") {
        Kind = Natural;
    } else if II.isStr("packed") {
        Kind = Packed;
    } else if II.isStr("power") {
        Kind = Power;
    } else if II.isStr("mac68k") {
        Kind = Mac68k;
    } else if II.isStr("reset") {
        Kind = Reset;
    } else {
        PP.Diag(Tok.getLocation(), warn_pragma_align_invalid_option) << IsOptions;
        return;
    }
    if PP.getLangOpts().XLPragmaPack {
        PP.Lex(Tok);
        if Tok.isNot(r_paren) {
            PP.Diag(Tok.getLocation(), warn_pragma_expected_rparen) << "align";
            return;
        }
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << (if IsOptions { "options" } else { "align" });
        return;
    }
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(1), 1 };
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_align);
    Toks[0].setLocation(FirstTok.getLocation());
    Toks[0].setAnnotationEndLoc(EndLoc);
    Toks[0].setAnnotationValue(Kind as u64 as *mut void);
    PP.EnterTokenStream(Toks, true, false);
}

fn PragmaAlignHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, AlignTok: *mut Token) {
    ParseAlignPragma(PP, AlignTok, false);
}

fn PragmaOptionsHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, OptionsTok: *mut Token) {
    ParseAlignPragma(PP, OptionsTok, true);
}

fn PragmaUnusedHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, UnusedTok: *mut Token) {
    let mut UnusedLoc: SourceLocation = UnusedTok.getLocation();
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_lparen) << "unused";
        return;
    }
    let mut Identifiers: SmallVector<Token, 5> = SmallVector<Token, 5> {};
    let mut RParenLoc: SourceLocation = SourceLocation {};
    let mut LexID: bool = true;
    while true {
        PP.Lex(Tok);
        if LexID {
            if Tok.is(identifier) {
                Identifiers.push(Tok);
                LexID = false;
                continue;
            }
            PP.Diag(Tok.getLocation(), warn_pragma_unused_expected_var);
            return;
        }
        if Tok.is(comma) {
            LexID = true;
            continue;
        }
        if Tok.is(r_paren) {
            RParenLoc = Tok.getLocation();
            break;
        }
        PP.Diag(Tok.getLocation(), warn_pragma_expected_punc) << "unused";
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "unused";
        return;
    }
    assert!(RParenLoc.isValid(), "Valid '#pragma unused' must have ')'");
    assert!(!Identifiers.is_empty(), "Valid '#pragma unused' must have arguments");
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(2 * Identifiers.len), 2 * Identifiers.len };
    for let mut i: u32 = 0; i != Identifiers.len; i += 1 {
        let mut pragmaUnusedTok: *mut Token = Toks[2 * i];
        let mut idTok: *mut Token = Toks[2 * i + 1];
        pragmaUnusedTok.startToken();
        pragmaUnusedTok.setKind(annot_pragma_unused);
        pragmaUnusedTok.setLocation(UnusedLoc);
        idTok = Identifiers[i];
    }
    PP.EnterTokenStream(Toks, true, false);
}

fn PragmaWeakHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, WeakTok: *mut Token) {
    let mut WeakLoc: SourceLocation = WeakTok.getLocation();
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << "weak";
        return;
    }
    let mut WeakName: Token = Tok;
    let mut HasAlias: bool = false;
    let mut AliasName: Token = Token {};
    PP.Lex(Tok);
    if Tok.is(equal) {
        HasAlias = true;
        PP.Lex(Tok);
        if Tok.isNot(identifier) {
            PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << "weak";
            return;
        }
        AliasName = Tok;
        PP.Lex(Tok);
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "weak";
        return;
    }
    if HasAlias {
        let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(3), 3 };
        let mut pragmaUnusedTok: *mut Token = Toks[0];
        pragmaUnusedTok.startToken();
        pragmaUnusedTok.setKind(annot_pragma_weakalias);
        pragmaUnusedTok.setLocation(WeakLoc);
        pragmaUnusedTok.setAnnotationEndLoc(AliasName.getLocation());
        Toks[1] = WeakName;
        Toks[2] = AliasName;
        PP.EnterTokenStream(Toks, true, false);
    } else {
        let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(2), 2 };
        let mut pragmaUnusedTok: *mut Token = Toks[0];
        pragmaUnusedTok.startToken();
        pragmaUnusedTok.setKind(annot_pragma_weak);
        pragmaUnusedTok.setLocation(WeakLoc);
        pragmaUnusedTok.setAnnotationEndLoc(WeakLoc);
        Toks[1] = WeakName;
        PP.EnterTokenStream(Toks, true, false);
    }
}

fn PragmaRedefineExtnameHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, RedefToken: *mut Token) {
    let mut RedefLoc: SourceLocation = RedefToken.getLocation();
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << "redefine_extname";
        return;
    }
    let mut RedefName: Token = Tok;
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << "redefine_extname";
        return;
    }
    let mut AliasName: Token = Tok;
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "redefine_extname";
        return;
    }
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(3), 3 };
    let mut pragmaRedefTok: *mut Token = Toks[0];
    pragmaRedefTok.startToken();
    pragmaRedefTok.setKind(annot_pragma_redefine_extname);
    pragmaRedefTok.setLocation(RedefLoc);
    pragmaRedefTok.setAnnotationEndLoc(AliasName.getLocation());
    Toks[1] = RedefName;
    Toks[2] = AliasName;
    PP.EnterTokenStream(Toks, true, false);
}

fn PragmaFPContractHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut OOS: OnOffSwitch = zeroed();
    if PP.LexOnOffSwitch(OOS) {
        return;
    }
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(1), 1 };
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_fp_contract);
    Toks[0].setLocation(Tok.getLocation());
    Toks[0].setAnnotationEndLoc(Tok.getLocation());
    Toks[0].setAnnotationValue(OOS as u64 as *mut void);
    PP.EnterTokenStream(Toks, true, false);
}

fn PragmaOpenCLExtensionHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << "OPENCL";
        return;
    }
    let mut Ext: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut NameLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(colon) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_colon) << Ext;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_predicate) << 0;
        return;
    }
    let mut Pred: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut State: OpenCLExtState = zeroed();
    if Pred.isStr("enable") {
        State = Enable;
    } else if Pred.isStr("disable") {
        State = Disable;
    } else if Pred.isStr("begin") {
        State = Begin;
    } else if Pred.isStr("end") {
        State = End;
    } else {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_predicate) << Ext.isStr("all");
        return;
    }
    let mut StateLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "OPENCL EXTENSION";
        return;
    }
    let mut Info: *OpenCLExtState> = PP.getPreprocessorAllocator().Allocate(1);
    Info.first = Ext;
    Info.second = State;
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(1), 1 };
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_opencl_extension);
    Toks[0].setLocation(NameLoc);
    Toks[0].setAnnotationValue(Info as *mut void);
    Toks[0].setAnnotationEndLoc(StateLoc);
    PP.EnterTokenStream(Toks, true, false);
    if PP.getPPCallbacks() {
        PP.getPPCallbacks().PragmaOpenCLExtension(NameLoc, Ext, StateLoc, State);
    }
}

fn Self::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstTok: *mut Token) {
    if !PP.getDiagnostics().isIgnored(IgnoredDiag, FirstTok.getLocation()) {
        PP.Diag(FirstTok, IgnoredDiag);
        PP.getDiagnostics().setSeverity(IgnoredDiag, Ignored, SourceLocation {});
    }
    PP.DiscardUntilEndOfDirective(null);
}

fn Self::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstTok: *mut Token) {
    let mut Pragma: SmallVector<Token, 16> = SmallVector<Token, 16> {};
    let mut Tok: Token = Token {};
    Tok.startToken();
    Tok.setKind(StartTok);
    Tok.setLocation(Introducer.Loc);
    while Tok.isNot(eod) && Tok.isNot(eof) {
        Pragma.push(Tok);
        PP.Lex(Tok);
        if Tok.is(StartTok) {
            PP.Diag(Tok, UnexpectedDiag) << 0;
            let mut InnerPragmaCnt: u32 = 1;
            while InnerPragmaCnt != 0 {
                PP.Lex(Tok);
                if Tok.is(StartTok) {
                    InnerPragmaCnt += 1;
                } else if Tok.is(EndTok) {
                    InnerPragmaCnt -= 1;
                }
            }
            PP.Lex(Tok);
        }
    }
    let mut EodLoc: SourceLocation = Tok.getLocation();
    Tok.startToken();
    Tok.setKind(EndTok);
    Tok.setLocation(EodLoc);
    Pragma.push(Tok);
    let mut Toks: []Token = make_unique(Pragma.len);
    copy(Pragma.begin(), Pragma.end(), Toks.get());
    PP.EnterTokenStream(move(Toks), Pragma.len, false, false);
}

fn PragmaMSPointersToMembers::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PointersToMembersLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(PointersToMembersLoc, warn_pragma_expected_lparen) << "pointers_to_members";
        return;
    }
    PP.Lex(Tok);
    let mut Arg: *IdentifierInfo = Tok.getIdentifierInfo();
    if !Arg {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << "pointers_to_members";
        return;
    }
    PP.Lex(Tok);
    let mut RepresentationMethod: PragmaMSPointersToMembersKind = zeroed();
    if Arg.isStr("best_case") {
        RepresentationMethod = PPTMK_BestCase;
    } else {
        if Arg.isStr("full_generality") {
            if Tok.is(comma) {
                PP.Lex(Tok);
                Arg = Tok.getIdentifierInfo();
                if !Arg {
                    PP.Diag(Tok.getLocation(), err_pragma_pointers_to_members_unknown_kind) << Tok.getKind() << 0;
                    return;
                }
                PP.Lex(Tok);
            } else if Tok.is(r_paren) {
                Arg = null;
                RepresentationMethod = PPTMK_FullGeneralityVirtualInheritance;
            } else {
                PP.Diag(Tok.getLocation(), err_expected_punc) << "full_generality";
                return;
            }
        }
        if Arg {
            if Arg.isStr("single_inheritance") {
                RepresentationMethod = PPTMK_FullGeneralitySingleInheritance;
            } else if Arg.isStr("multiple_inheritance") {
                RepresentationMethod = PPTMK_FullGeneralityMultipleInheritance;
            } else if Arg.isStr("virtual_inheritance") {
                RepresentationMethod = PPTMK_FullGeneralityVirtualInheritance;
            } else {
                PP.Diag(Tok.getLocation(), err_pragma_pointers_to_members_unknown_kind) << Arg << 1;
                return;
            }
        }
    }
    if Tok.isNot(r_paren) {
        PP.Diag(Tok.getLocation(), err_expected_rparen_after) << (if Arg { Arg.getName() } else { "full_generality" });
        return;
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "pointers_to_members";
        return;
    }
    let mut AnnotTok: Token = Token {};
    AnnotTok.startToken();
    AnnotTok.setKind(annot_pragma_ms_pointers_to_members);
    AnnotTok.setLocation(PointersToMembersLoc);
    AnnotTok.setAnnotationEndLoc(EndLoc);
    AnnotTok.setAnnotationValue(RepresentationMethod as u64 as *mut void);
    PP.EnterToken(AnnotTok, true);
}

fn PragmaMSVtorDisp::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut VtorDispLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(VtorDispLoc, warn_pragma_expected_lparen) << "vtordisp";
        return;
    }
    PP.Lex(Tok);
    let mut Action: PragmaMsStackAction = PSK_Set;
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    if II {
        if II.isStr("push") {
            PP.Lex(Tok);
            if Tok.isNot(comma) {
                PP.Diag(VtorDispLoc, warn_pragma_expected_punc) << "vtordisp";
                return;
            }
            PP.Lex(Tok);
            Action = PSK_Push_Set;
        } else if II.isStr("pop") {
            PP.Lex(Tok);
            Action = PSK_Pop;
        }
    } else {
        if Tok.is(r_paren) {
            Action = PSK_Reset;
        }
    }
    let mut Value: u64 = 0;
    if Action & PSK_Push || Action & PSK_Set {
        let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
        if II && II.isStr("off") {
            PP.Lex(Tok);
            Value = 0;
        } else if II && II.isStr("on") {
            PP.Lex(Tok);
            Value = 1;
        } else if Tok.is(numeric_constant) && PP.parseSimpleIntegerLiteral(Tok, Value) {
            if Value > 2 {
                PP.Diag(Tok.getLocation(), warn_pragma_expected_integer) << 0 << 2 << "vtordisp";
                return;
            }
        } else {
            PP.Diag(Tok.getLocation(), warn_pragma_invalid_action) << "vtordisp";
            return;
        }
    }
    if Tok.isNot(r_paren) {
        PP.Diag(VtorDispLoc, warn_pragma_expected_rparen) << "vtordisp";
        return;
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "vtordisp";
        return;
    }
    let mut AnnotTok: Token = Token {};
    AnnotTok.startToken();
    AnnotTok.setKind(annot_pragma_ms_vtordisp);
    AnnotTok.setLocation(VtorDispLoc);
    AnnotTok.setAnnotationEndLoc(EndLoc);
    AnnotTok.setAnnotationValue((Action << 16) | (Value & 65535) as u64 as *mut void);
    PP.EnterToken(AnnotTok, false);
}

fn PragmaMSPragma::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut EoF: Token = Token {};
    let mut AnnotTok: Token = Token {};
    EoF.startToken();
    EoF.setKind(eof);
    AnnotTok.startToken();
    AnnotTok.setKind(annot_pragma_ms_pragma);
    AnnotTok.setLocation(Tok.getLocation());
    AnnotTok.setAnnotationEndLoc(Tok.getLocation());
    let mut TokenVector: SmallVector<Token, 8> = SmallVector<Token, 8> {};
    for ; Tok.isNot(eod); PP.Lex(Tok) {
        TokenVector.push(Tok);
        AnnotTok.setAnnotationEndLoc(Tok.getLocation());
    }
    TokenVector.push(EoF);
    markAsReinjectedForRelexing(TokenVector);
    let mut TokenArray: []Token = make_unique(TokenVector.len);
    copy(TokenVector.begin(), TokenVector.end(), TokenArray.get());
    let mut Value: *mut []unique_ptr<Token = [move(TokenArray), TokenVector.len];
    AnnotTok.setAnnotationValue(Value);
    PP.EnterToken(AnnotTok, false);
}

fn PragmaFloatControlHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut Action: PragmaMsStackAction = PSK_Set;
    let mut FloatControlLoc: SourceLocation = Tok.getLocation();
    let mut PragmaName: Token = Tok;
    if !PP.getTargetInfo().hasStrictFP() && !PP.getLangOpts().ExpStrictFP {
        PP.Diag(Tok.getLocation(), warn_pragma_fp_ignored) << PragmaName.getIdentifierInfo().getName();
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(FloatControlLoc, err_expected) << l_paren;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), err_pragma_float_control_malformed);
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut Kind: PragmaFloatControlKind = II.getName().Case("precise", PFC_Precise).Case("except", PFC_Except).Case("push", PFC_Push).Case("pop", PFC_Pop).Default(PFC_Unknown);
    PP.Lex(Tok);
    if Kind == PFC_Unknown {
        PP.Diag(Tok.getLocation(), err_pragma_float_control_malformed);
        return;
    } else if Kind == PFC_Push || Kind == PFC_Pop {
        if Tok.isNot(r_paren) {
            PP.Diag(Tok.getLocation(), err_pragma_float_control_malformed);
            return;
        }
        PP.Lex(Tok);
        Action = if (Kind == PFC_Pop) { PSK_Pop } else { PSK_Push };
    } else {
        if Tok.is(r_paren) {
            PP.Lex(Tok);
        } else if Tok.isNot(comma) {
            PP.Diag(Tok.getLocation(), err_pragma_float_control_malformed);
            return;
        } else {
            PP.Lex(Tok);
            if !Tok.isAnyIdentifier() {
                PP.Diag(Tok.getLocation(), err_pragma_float_control_malformed);
                return;
            }
            let mut PushOnOff: str = Tok.getIdentifierInfo().getName();
            if PushOnOff == "on" {
                
            } else if PushOnOff == "off" {
                if Kind == PFC_Precise {
                    Kind = PFC_NoPrecise;
                }
                if Kind == PFC_Except {
                    Kind = PFC_NoExcept;
                }
            } else if PushOnOff == "push" {
                Action = PSK_Push_Set;
            } else {
                PP.Diag(Tok.getLocation(), err_pragma_float_control_malformed);
                return;
            }
            PP.Lex(Tok);
            if Tok.is(comma) {
                PP.Lex(Tok);
                if !Tok.isAnyIdentifier() {
                    PP.Diag(Tok.getLocation(), err_pragma_float_control_malformed);
                    return;
                }
                let mut ExpectedPush: str = Tok.getIdentifierInfo().getName();
                if ExpectedPush == "push" {
                    Action = PSK_Push_Set;
                } else {
                    PP.Diag(Tok.getLocation(), err_pragma_float_control_malformed);
                    return;
                }
                PP.Lex(Tok);
            }
            if Tok.isNot(r_paren) {
                PP.Diag(Tok.getLocation(), err_pragma_float_control_malformed);
                return;
            }
            PP.Lex(Tok);
        }
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "float_control";
        return;
    }
    let mut TokenArray: []Token = make_unique(1);
    TokenArray[0].startToken();
    TokenArray[0].setKind(annot_pragma_float_control);
    TokenArray[0].setLocation(FloatControlLoc);
    TokenArray[0].setAnnotationEndLoc(EndLoc);
    TokenArray[0].setAnnotationValue((Action << 16) | (Kind & 65535) as u64 as *mut void);
    PP.EnterTokenStream(move(TokenArray), 1, false, false);
}

fn PragmaDetectMismatchHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut DetectMismatchLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(DetectMismatchLoc, err_expected) << l_paren;
        return;
    }
    let mut NameString: str = "";
    if !PP.LexStringLiteral(Tok, NameString, "pragma detect_mismatch", true) {
        return;
    }
    let mut ValueString: str = "";
    if Tok.isNot(comma) {
        PP.Diag(Tok.getLocation(), err_pragma_detect_mismatch_malformed);
        return;
    }
    if !PP.LexStringLiteral(Tok, ValueString, "pragma detect_mismatch", true) {
        return;
    }
    if Tok.isNot(r_paren) {
        PP.Diag(Tok.getLocation(), err_expected) << r_paren;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), err_pragma_detect_mismatch_malformed);
        return;
    }
    if PP.getPPCallbacks() {
        PP.getPPCallbacks().PragmaDetectMismatch(DetectMismatchLoc, NameString, ValueString);
    }
    self.Actions.ActOnPragmaDetectMismatch(DetectMismatchLoc, NameString, ValueString);
}

fn PragmaCommentHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut CommentLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(CommentLoc, err_pragma_comment_malformed);
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(CommentLoc, err_pragma_comment_malformed);
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut Kind: PragmaMSCommentKind = II.getName().Case("linker", PCK_Linker).Case("lib", PCK_Lib).Case("compiler", PCK_Compiler).Case("exestr", PCK_ExeStr).Case("user", PCK_User).Case("copyright", PCK_Copyright).Default(PCK_Unknown);
    if Kind == PCK_Unknown {
        PP.Diag(Tok.getLocation(), err_pragma_comment_unknown_kind);
        return;
    }
    if PP.getTargetInfo().getTriple().isOSAIX() && Kind != PCK_Copyright {
        PP.Diag(Tok.getLocation(), warn_pragma_comment_ignored) << II.getName();
        return;
    }
    if PP.getTargetInfo().getTriple().isOSBinFormatELF() && Kind != PCK_Lib {
        PP.Diag(Tok.getLocation(), warn_pragma_comment_ignored) << II.getName();
        return;
    }
    if Kind == PCK_Copyright {
        if self.SeenCopyrightInTU {
            PP.Diag(Tok.getLocation(), warn_pragma_comment_once) << II.getName();
            return;
        }
        self.SeenCopyrightInTU = true;
    }
    PP.Lex(Tok);
    let mut ArgumentString: str = "";
    if Tok.is(comma) && !PP.LexStringLiteral(Tok, ArgumentString, "pragma comment", true) {
        return;
    }
    if Tok.isNot(r_paren) {
        PP.Diag(Tok.getLocation(), err_pragma_comment_malformed);
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), err_pragma_comment_malformed);
        return;
    }
    if Kind == PCK_Copyright && ArgumentString.is_empty() {
        return;
    }
    if PP.getPPCallbacks() {
        PP.getPPCallbacks().PragmaComment(CommentLoc, II, ArgumentString);
    }
    self.Actions.ActOnPragmaMSComment(CommentLoc, Kind, ArgumentString);
}

fn PragmaOptimizeHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.is(eod) {
        PP.Diag(Tok.getLocation(), err_pragma_missing_argument) << "clang optimize" << true << "'on' or 'off'";
        return;
    }
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), err_pragma_optimize_invalid_argument) << PP.getSpelling(Tok, null);
        return;
    }
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    let mut IsOn: bool = false;
    if II.isStr("on") {
        IsOn = true;
    } else if !II.isStr("off") {
        PP.Diag(Tok.getLocation(), err_pragma_optimize_invalid_argument) << PP.getSpelling(Tok, null);
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), err_pragma_optimize_extra_argument) << PP.getSpelling(Tok, null);
        return;
    }
    self.Actions.ActOnPragmaOptimize(IsOn, FirstToken.getLocation());
}

struct TokFPAnnotValue {
    ContractValue: FPModeKind>,
    ReassociateValue: FPModeKind>,
    ReciprocalValue: FPModeKind>,
    ExceptionsValue: FPExceptionModeKind>,
    EvalMethodValue: FPEvalMethodKind>,
}

fn PragmaFPHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PragmaName: Token = Tok;
    let mut TokenList: SmallVector<Token, 1> = SmallVector<Token, 1> {};
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), err_pragma_fp_invalid_option) << true << "";
        return;
    }
    let mut AnnotValue: *mut TokFPAnnotValue = TokFPAnnotValue {};
    while Tok.is(identifier) {
        let mut OptionInfo: *mut IdentifierInfo = Tok.getIdentifierInfo();
        let mut FlagKind: PragmaFPKind> = OptionInfo.getName().Case("contract", PFK_Contract).Case("reassociate", PFK_Reassociate).Case("exceptions", PFK_Exceptions).Case("eval_method", PFK_EvalMethod).Case("reciprocal", PFK_Reciprocal).Default(nullopt);
        if !FlagKind {
            PP.Diag(Tok.getLocation(), err_pragma_fp_invalid_option) << false << OptionInfo;
            return;
        }
        PP.Lex(Tok);
        if Tok.isNot(l_paren) {
            PP.Diag(Tok.getLocation(), err_expected) << l_paren;
            return;
        }
        PP.Lex(Tok);
        let mut isEvalMethodDouble: bool = Tok.is(kw_double) && FlagKind == PFK_EvalMethod;
        if Tok.isNot(identifier) && !isEvalMethodDouble {
            PP.Diag(Tok.getLocation(), err_pragma_fp_invalid_argument) << PP.getSpelling(Tok, null) << OptionInfo.getName() << operator(FlagKind) as i32;
            return;
        }
        let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
        if FlagKind == PFK_Contract {
            AnnotValue.ContractValue = II.getName().Case("on", FPM_On).Case("off", FPM_Off).Case("fast", FPM_Fast).Default(nullopt);
            if !AnnotValue.ContractValue {
                PP.Diag(Tok.getLocation(), err_pragma_fp_invalid_argument) << PP.getSpelling(Tok, null) << OptionInfo.getName() << operator(FlagKind);
                return;
            }
        } else if FlagKind == PFK_Reassociate || FlagKind == PFK_Reciprocal {
            let mut Value: *mut FPModeKind> = if FlagKind == PFK_Reassociate { AnnotValue.ReassociateValue } else { AnnotValue.ReciprocalValue };
            Value = II.getName().Case("on", FPM_On).Case("off", FPM_Off).Default(nullopt);
            if !Value {
                PP.Diag(Tok.getLocation(), err_pragma_fp_invalid_argument) << PP.getSpelling(Tok, null) << OptionInfo.getName() << operator(FlagKind);
                return;
            }
        } else if FlagKind == PFK_Exceptions {
            AnnotValue.ExceptionsValue = II.getName().Case("ignore", FPE_Ignore).Case("maytrap", FPE_MayTrap).Case("strict", FPE_Strict).Default(nullopt);
            if !AnnotValue.ExceptionsValue {
                PP.Diag(Tok.getLocation(), err_pragma_fp_invalid_argument) << PP.getSpelling(Tok, null) << OptionInfo.getName() << operator(FlagKind);
                return;
            }
        } else if FlagKind == PFK_EvalMethod {
            AnnotValue.EvalMethodValue = II.getName().Case("source", FEM_Source).Case("double", FEM_Double).Case("extended", FEM_Extended).Default(nullopt);
            if !AnnotValue.EvalMethodValue {
                PP.Diag(Tok.getLocation(), err_pragma_fp_invalid_argument) << PP.getSpelling(Tok, null) << OptionInfo.getName() << operator(FlagKind);
                return;
            }
        }
        PP.Lex(Tok);
        if Tok.isNot(r_paren) {
            PP.Diag(Tok.getLocation(), err_expected) << r_paren;
            return;
        }
        PP.Lex(Tok);
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "clang fp";
        return;
    }
    let mut FPTok: Token = Token {};
    FPTok.startToken();
    FPTok.setKind(annot_pragma_fp);
    FPTok.setLocation(PragmaName.getLocation());
    FPTok.setAnnotationEndLoc(PragmaName.getLocation());
    FPTok.setAnnotationValue(AnnotValue as *mut void);
    TokenList.push(FPTok);
    let mut TokenArray: []Token = make_unique(TokenList.len);
    copy(TokenList.begin(), TokenList.end(), TokenArray.get());
    PP.EnterTokenStream(move(TokenArray), TokenList.len, false, false);
}

fn PragmaSTDC_FENV_ROUNDHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PragmaName: Token = Tok;
    if !PP.getTargetInfo().hasStrictFP() && !PP.getLangOpts().ExpStrictFP {
        PP.Diag(Tok.getLocation(), warn_pragma_fp_ignored) << PragmaName.getIdentifierInfo().getName();
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_identifier) << PragmaName.getIdentifierInfo().getName();
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut RM: RoundingMode = II.getName().Case("FE_TOWARDZERO", TowardZero).Case("FE_TONEAREST", NearestTiesToEven).Case("FE_UPWARD", TowardPositive).Case("FE_DOWNWARD", TowardNegative).Case("FE_TONEARESTFROMZERO", NearestTiesToAway).Case("FE_DYNAMIC", Dynamic).Default(Invalid);
    if RM == Invalid {
        PP.Diag(Tok.getLocation(), warn_stdc_unknown_rounding_mode);
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "STDC FENV_ROUND";
        return;
    }
    PP.Diag(Tok.getLocation(), warn_stdc_fenv_round_not_supported);
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(1), 1 };
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_fenv_round);
    Toks[0].setLocation(Tok.getLocation());
    Toks[0].setAnnotationEndLoc(Tok.getLocation());
    Toks[0].setAnnotationValue(RM as u64 as *mut void);
    PP.EnterTokenStream(Toks, true, false);
}

fn Parser::HandlePragmaFP(self) {
    assert!(self.Tok.is(annot_pragma_fp);
    let mut AnnotValue: *mut TokFPAnnotValue = self.Tok.getAnnotationValue() as *mut TokFPAnnotValue;
    if AnnotValue.ReassociateValue {
        self.Actions.ActOnPragmaFPValueChangingOption(self.Tok.getLocation(), PFK_Reassociate, operator(AnnotValue.ReassociateValue) == FPM_On);
    }
    if AnnotValue.ReciprocalValue {
        self.Actions.ActOnPragmaFPValueChangingOption(self.Tok.getLocation(), PFK_Reciprocal, operator(AnnotValue.ReciprocalValue) == FPM_On);
    }
    if AnnotValue.ContractValue {
        self.Actions.ActOnPragmaFPContract(self.Tok.getLocation(), operator(AnnotValue.ContractValue));
    }
    if AnnotValue.ExceptionsValue {
        self.Actions.ActOnPragmaFPExceptions(self.Tok.getLocation(), operator(AnnotValue.ExceptionsValue));
    }
    if AnnotValue.EvalMethodValue {
        self.Actions.ActOnPragmaFPEvalMethod(self.Tok.getLocation(), operator(AnnotValue.EvalMethodValue));
    }
    self.ConsumeAnnotationToken();
}

fn ParseLoopHintValue(PP: *mut Preprocessor, Tok: *mut Token, PragmaName: Token, Option: Token, ValueInParens: bool, Info: *mut PragmaLoopHintInfo) -> bool {
    let mut ValueList: SmallVector<Token, 1> = SmallVector<Token, 1> {};
    let mut OpenParens: i32 = if ValueInParens { 1 } else { 0 };
    while Tok.isNot(eod) {
        if Tok.is(l_paren) {
            OpenParens += 1;
        } else if Tok.is(r_paren) {
            OpenParens -= 1;
            if OpenParens == 0 && ValueInParens {
                break;
            }
        }
        ValueList.push(Tok);
        PP.Lex(Tok);
    }
    if ValueInParens {
        if Tok.isNot(r_paren) {
            PP.Diag(Tok.getLocation(), err_expected) << r_paren;
            return true;
        }
        PP.Lex(Tok);
    }
    let mut EOFTok: Token = Token {};
    EOFTok.startToken();
    EOFTok.setKind(eof);
    EOFTok.setLocation(Tok.getLocation());
    ValueList.push(EOFTok);
    markAsReinjectedForRelexing(ValueList);
    Info.Toks = ValueList.copy(PP.getPreprocessorAllocator());
    Info.PragmaName = PragmaName;
    Info.Option = Option;
    return false;
}

fn PragmaLoopHintHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PragmaName: Token = Tok;
    let mut TokenList: SmallVector<Token, 1> = SmallVector<Token, 1> {};
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), err_pragma_loop_invalid_option) << true << "";
        return;
    }
    while Tok.is(identifier) {
        let mut Option: Token = Tok;
        let mut OptionInfo: *mut IdentifierInfo = Tok.getIdentifierInfo();
        let mut OptionValid: bool = OptionInfo.getName().Case("vectorize", true).Case("interleave", true).Case("unroll", true).Case("distribute", true).Case("vectorize_predicate", true).Case("vectorize_width", true).Case("interleave_count", true).Case("unroll_count", true).Case("pipeline", true).Case("pipeline_initiation_interval", true).Case("licm", true).Default(false);
        if !OptionValid {
            PP.Diag(Tok.getLocation(), err_pragma_loop_invalid_option) << false << OptionInfo;
            return;
        }
        PP.Lex(Tok);
        if Tok.isNot(l_paren) {
            PP.Diag(Tok.getLocation(), err_expected) << l_paren;
            return;
        }
        PP.Lex(Tok);
        let mut Info: *mut PragmaLoopHintInfo = PragmaLoopHintInfo {};
        if ParseLoopHintValue(PP, Tok, PragmaName, Option, true, *Info) {
            return;
        }
        let mut LoopHintTok: Token = Token {};
        LoopHintTok.startToken();
        LoopHintTok.setKind(annot_pragma_loop_hint);
        LoopHintTok.setLocation(Introducer.Loc);
        LoopHintTok.setAnnotationEndLoc(PragmaName.getLocation());
        LoopHintTok.setAnnotationValue(Info as *mut void);
        TokenList.push(LoopHintTok);
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "clang loop";
        return;
    }
    let mut TokenArray: []Token = make_unique(TokenList.len);
    copy(TokenList.begin(), TokenList.end(), TokenArray.get());
    PP.EnterTokenStream(move(TokenArray), TokenList.len, false, false);
}

fn PragmaUnrollHintHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PragmaName: Token = Tok;
    PP.Lex(Tok);
    let mut Info: *mut PragmaLoopHintInfo = PragmaLoopHintInfo {};
    if Tok.is(eod) {
        Info.PragmaName = PragmaName;
        Info.Option.startToken();
    } else if PragmaName.getIdentifierInfo().getName() == "nounroll" || PragmaName.getIdentifierInfo().getName() == "nounroll_and_jam" {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << PragmaName.getIdentifierInfo().getName();
        return;
    } else {
        let mut ValueInParens: bool = Tok.is(l_paren);
        if ValueInParens {
            PP.Lex(Tok);
        }
        let mut Option: Token = Token {};
        Option.startToken();
        if ParseLoopHintValue(PP, Tok, PragmaName, Option, ValueInParens, *Info) {
            return;
        }
        if PP.getLangOpts().CUDA && ValueInParens {
            PP.Diag(Info.Toks[0].getLocation(), warn_pragma_unroll_cuda_value_in_parens);
        }
        if Tok.isNot(eod) {
            PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "unroll";
            return;
        }
    }
    let mut TokenArray: []Token = make_unique(1);
    TokenArray[0].startToken();
    TokenArray[0].setKind(annot_pragma_loop_hint);
    TokenArray[0].setLocation(Introducer.Loc);
    TokenArray[0].setAnnotationEndLoc(PragmaName.getLocation());
    TokenArray[0].setAnnotationValue(Info as *mut void);
    PP.EnterTokenStream(move(TokenArray), 1, false, false);
}

fn Parser::HandlePragmaMSFunction(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    let mut FirstTok: Token = self.Tok;
    if self.ExpectAndConsume(l_paren, warn_pragma_expected_lparen, PragmaName) {
        return false;
    }
    let mut SuggestIntrinH: bool = !self.PP.isMacroDefined("__INTRIN_H");
    let mut NoBuiltins: SmallVector<StringRef> = SmallVector<StringRef> {};
    while self.Tok.is(identifier) {
        let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        if !II.getBuiltinID() {
            self.PP.Diag(self.Tok.getLocation(), warn_pragma_intrinsic_builtin) << II << SuggestIntrinH;
        } else {
            NoBuiltins.push(II.getName());
        }
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(comma) {
            break;
        }
        self.PP.Lex(self.Tok);
    }
    if self.ExpectAndConsume(r_paren, warn_pragma_expected_rparen, PragmaName) || self.ExpectAndConsume(eof, warn_pragma_extra_tokens_at_eol, PragmaName) {
        return false;
    }
    self.Actions.ActOnPragmaMSFunction(FirstTok.getLocation(), NoBuiltins);
    return true;
}

fn Parser::HandlePragmaMSOptimize(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    let mut FirstTok: Token = self.Tok;
    if self.ExpectAndConsume(l_paren, warn_pragma_expected_lparen, PragmaName) {
        return false;
    }
    if self.Tok.isNot(string_literal) {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_string) << PragmaName;
        return false;
    }
    let mut StringResult: ExprResult = self.ParseStringLiteralExpression(false);
    if StringResult.isInvalid() {
        return false;
    }
    let mut OptimizationList: *mut StringLiteral = cast(StringResult.get());
    if OptimizationList.getCharByteWidth() != 1 {
        self.PP.Diag(PragmaLocation, warn_pragma_expected_non_wide_string) << PragmaName;
        return false;
    }
    if self.ExpectAndConsume(comma, warn_pragma_expected_comma, PragmaName) {
        return false;
    }
    if self.Tok.is(eof) || self.Tok.is(r_paren) {
        self.PP.Diag(PragmaLocation, warn_pragma_missing_argument) << PragmaName << true << "'on' or 'off'";
        return false;
    }
    let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    if !II || (!II.isStr("on") && !II.isStr("off")) {
        self.PP.Diag(PragmaLocation, warn_pragma_invalid_argument) << self.PP.getSpelling(self.Tok, null) << PragmaName << true << "'on' or 'off'";
        return false;
    }
    let mut IsOn: bool = II.isStr("on");
    self.PP.Lex(self.Tok);
    if self.ExpectAndConsume(r_paren, warn_pragma_expected_rparen, PragmaName) {
        return false;
    }
    if !OptimizationList.getString().is_empty() {
        self.PP.Diag(PragmaLocation, warn_pragma_invalid_argument) << OptimizationList.getString() << PragmaName << true << "\"\"";
        return false;
    }
    if self.ExpectAndConsume(eof, warn_pragma_extra_tokens_at_eol, PragmaName) {
        return false;
    }
    self.Actions.ActOnPragmaMSOptimize(FirstTok.getLocation(), IsOn);
    return true;
}

fn Parser::HandlePragmaMSIntrinsic(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    if self.ExpectAndConsume(l_paren, warn_pragma_expected_lparen, PragmaName) {
        return false;
    }
    let mut SuggestIntrinH: bool = !self.PP.isMacroDefined("__INTRIN_H");
    while self.Tok.is(identifier) {
        let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        if !II.getBuiltinID() {
            self.PP.Diag(self.Tok.getLocation(), warn_pragma_intrinsic_builtin) << II << SuggestIntrinH;
        }
        let mut NameInfo: DeclarationNameInfo = DeclarationNameInfo { II, self.Tok.getLocation() };
        let mut Previous: LookupResult = LookupResult { self.Actions, NameInfo, LookupOrdinaryName, NotForRedeclaration };
        self.Actions.LookupName(Previous, self.Actions.getCurScope(), false, false);
        if Previous.is_empty() {
            self.Actions.LazilyCreateBuiltin(II, II.getBuiltinID(), self.Actions.getCurScope(), true, self.Tok.getLocation());
        }
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(comma) {
            break;
        }
        self.PP.Lex(self.Tok);
    }
    if self.ExpectAndConsume(r_paren, warn_pragma_expected_rparen, PragmaName) {
        return false;
    }
    if self.ExpectAndConsume(eof, warn_pragma_extra_tokens_at_eol, PragmaName) {
        return false;
    }
    return true;
}

fn PragmaForceCUDAHostDeviceHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut FirstTok: Token = Tok;
    PP.Lex(Tok);
    let mut Info: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !Info || (!Info.isStr("begin") && !Info.isStr("end")) {
        PP.Diag(FirstTok.getLocation(), warn_pragma_force_cuda_host_device_bad_arg);
        return;
    }
    if Info.isStr("begin") {
        self.Actions.CUDA().PushForceHostDevice();
    } else if !self.Actions.CUDA().PopForceHostDevice() {
        PP.Diag(FirstTok.getLocation(), err_pragma_cannot_end_force_cuda_host_device);
    }
    PP.Lex(Tok);
    if !Tok.is(eod) {
        PP.Diag(FirstTok.getLocation(), warn_pragma_force_cuda_host_device_bad_arg);
    }
}

fn PragmaAttributeHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    let mut Info: *mut PragmaAttributeInfo = self.AttributesForPragmaAttribute;
    if Tok.is(identifier) {
        let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
        if !II.isStr("push") && !II.isStr("pop") {
            Info.Namespace = II;
            PP.Lex(Tok);
            if !Tok.is(period) {
                PP.Diag(Tok.getLocation(), err_pragma_attribute_expected_period) << II;
                return;
            }
            PP.Lex(Tok);
        }
    }
    if !Tok.isOneOf(identifier, l_paren) {
        PP.Diag(Tok.getLocation(), err_pragma_attribute_expected_push_pop_paren);
        return;
    }
    if Tok.is(l_paren) {
        if Info.Namespace {
            PP.Diag(Tok.getLocation(), err_pragma_attribute_namespace_on_attribute);
            PP.Diag(Tok.getLocation(), note_pragma_attribute_namespace_on_attribute);
            return;
        }
        Info.Action = Attribute;
    } else {
        let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
        if II.isStr("push") {
            Info.Action = Push;
        } else if II.isStr("pop") {
            Info.Action = Pop;
        } else {
            PP.Diag(Tok.getLocation(), err_pragma_attribute_invalid_argument) << PP.getSpelling(Tok, null);
            return;
        }
        PP.Lex(Tok);
    }
    if (Info.Action == Push && Tok.isNot(eod)) || Info.Action == Attribute {
        if Tok.isNot(l_paren) {
            PP.Diag(Tok.getLocation(), err_expected) << l_paren;
            return;
        }
        PP.Lex(Tok);
        let mut AttributeTokens: SmallVector<Token, 16> = SmallVector<Token, 16> {};
        let mut OpenParens: i32 = 1;
        while Tok.isNot(eod) {
            if Tok.is(l_paren) {
                OpenParens += 1;
            } else if Tok.is(r_paren) {
                OpenParens -= 1;
                if OpenParens == 0 {
                    break;
                }
            }
            AttributeTokens.push(Tok);
            PP.Lex(Tok);
        }
        if AttributeTokens.is_empty() {
            PP.Diag(Tok.getLocation(), err_pragma_attribute_expected_attribute);
            return;
        }
        if Tok.isNot(r_paren) {
            PP.Diag(Tok.getLocation(), err_expected) << r_paren;
            return;
        }
        let mut EndLoc: SourceLocation = Tok.getLocation();
        PP.Lex(Tok);
        let mut EOFTok: Token = Token {};
        EOFTok.startToken();
        EOFTok.setKind(eof);
        EOFTok.setLocation(EndLoc);
        AttributeTokens.push(EOFTok);
        markAsReinjectedForRelexing(AttributeTokens);
        Info.Tokens = AttributeTokens.copy(PP.getPreprocessorAllocator());
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "clang attribute";
    }
    let mut TokenArray: []Token = make_unique(1);
    TokenArray[0].startToken();
    TokenArray[0].setKind(annot_pragma_attribute);
    TokenArray[0].setLocation(FirstToken.getLocation());
    TokenArray[0].setAnnotationEndLoc(FirstToken.getLocation());
    TokenArray[0].setAnnotationValue(Info as *mut void);
    PP.EnterTokenStream(move(TokenArray), 1, false, false);
}

fn PragmaMaxTokensHereHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.Lex(Tok);
    if Tok.is(eod) {
        PP.Diag(Tok.getLocation(), err_pragma_missing_argument) << "clang max_tokens_here" << true << "integer";
        return;
    }
    let mut Loc: SourceLocation = Tok.getLocation();
    let mut MaxTokens: u64 = 0;
    if Tok.isNot(numeric_constant) || !PP.parseSimpleIntegerLiteral(Tok, MaxTokens) {
        PP.Diag(Tok.getLocation(), err_pragma_expected_integer) << "clang max_tokens_here";
        return;
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "clang max_tokens_here";
        return;
    }
    if PP.getTokenCount() > MaxTokens {
        PP.Diag(Loc, warn_max_tokens) << PP.getTokenCount() << MaxTokens as u32;
    }
}

fn PragmaMaxTokensTotalHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.Lex(Tok);
    if Tok.is(eod) {
        PP.Diag(Tok.getLocation(), err_pragma_missing_argument) << "clang max_tokens_total" << true << "integer";
        return;
    }
    let mut Loc: SourceLocation = Tok.getLocation();
    let mut MaxTokens: u64 = 0;
    if Tok.isNot(numeric_constant) || !PP.parseSimpleIntegerLiteral(Tok, MaxTokens) {
        PP.Diag(Tok.getLocation(), err_pragma_expected_integer) << "clang max_tokens_total";
        return;
    }
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "clang max_tokens_total";
        return;
    }
    PP.overrideMaxTokens(MaxTokens, Loc);
}

fn zOSPragmaHandlerHelper(PP: *mut Preprocessor, Tok: *mut Token, TokKind: TokenKind) {
    let mut AnnotTok: Token = Token {};
    AnnotTok.startToken();
    AnnotTok.setKind(TokKind);
    AnnotTok.setLocation(Tok.getLocation());
    AnnotTok.setAnnotationEndLoc(Tok.getLocation());
    let mut TokenVector: SmallVector<Token, 8> = SmallVector<Token, 8> {};
    for ; Tok.isNot(eod); PP.Lex(Tok) {
        TokenVector.push(Tok);
        AnnotTok.setAnnotationEndLoc(Tok.getLocation());
    }
    let mut EoF: Token = Token {};
    EoF.startToken();
    EoF.setKind(eof);
    EoF.setLocation(Tok.getLocation());
    TokenVector.push(EoF);
    markAsReinjectedForRelexing(TokenVector);
    let mut TokenArray: []Token = make_unique(TokenVector.len);
    copy(TokenVector.begin(), TokenVector.end(), TokenArray.get());
    let mut Value: *mut []unique_ptr<Token = [move(TokenArray), TokenVector.len];
    AnnotTok.setAnnotationValue(Value);
    PP.EnterToken(AnnotTok, false);
}

fn PragmaExportHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    zOSPragmaHandlerHelper(PP, FirstToken, annot_pragma_export);
}

fn PragmaRISCVHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !II || !II.isStr("intrinsic") {
        PP.Diag(Tok.getLocation(), warn_pragma_invalid_argument) << PP.getSpelling(Tok, null) << "riscv" << true << "'intrinsic'";
        return;
    }
    PP.Lex(Tok);
    II = Tok.getIdentifierInfo();
    if !II || !(II.isStr("vector") || II.isStr("sifive_vector") || II.isStr("andes_vector")) {
        PP.Diag(Tok.getLocation(), warn_pragma_invalid_argument) << PP.getSpelling(Tok, null) << "riscv" << true << "'vector', 'sifive_vector' or 'andes_vector'";
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << "clang riscv intrinsic";
        return;
    }
    if II.isStr("vector") {
        self.Actions.RISCV().DeclareRVVBuiltins = true;
    } else if II.isStr("sifive_vector") {
        self.Actions.RISCV().DeclareSiFiveVectorBuiltins = true;
    } else if II.isStr("andes_vector") {
        self.Actions.RISCV().DeclareAndesVectorBuiltins = true;
    }
}

struct Closure_1 {
    cap_0: *mut Parser,
}

fn Closure_1::call(self: *Closure_1) {
        while self.Tok.isNot(eof) {
            self.PP.Lex(self.Tok);
        }
        self.PP.Lex(self.Tok);
    }

struct Closure_2 {
    cap_0: *mut Parser,
}

fn Closure_2::call(self: *Closure_2) {
        self.SkipUntil(eof, StopBeforeMatch);
        self.ConsumeToken();
    }

struct Closure_3 {
    Action: *mut PragmaMsStackAction,
    Alignment: *mut Token,
    Tok: *mut Token,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Literal: *u8) {
            (*self.Action) = PSK_Push_Set;
            (*self.Alignment) = (*self.Tok);
            (*self.Alignment).setKind(numeric_constant);
            (*self.Alignment).setLiteralData(Literal);
            (*self.Alignment).setLength(1);
        }
