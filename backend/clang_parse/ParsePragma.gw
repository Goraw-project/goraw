fn Parser::zOSHandlePragmaHelper(self, PragmaKind: TokenKind) {
    assert!(self.Tok.is(PragmaKind);
    let mut PragmaName: str = "export";
    let mut TheTokens: *mut void = self.Tok.getAnnotationValue();
    self.PP(move(TheTokens()), TheTokens(), true, true);
    self.Tok.setAnnotationValue(null);
    self.ConsumeAnnotationToken();
    let mut OnReturn: scope_exit = Closure_1 { cap_0: self };
    while true {
        {
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(l_paren) {
            self.PP << PragmaName;
            return;
        }
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(identifier) {
            self.PP << PragmaName;
            return;
        }
        let mut IdentName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut IdentNameLoc: SourceLocation = self.Tok.getLocation();
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(r_paren) {
            self.PP << PragmaName;
            return;
        }
        self.PP.Lex(self.Tok);
        self.Actions.ActOnPragmaExport(IdentName, IdentNameLoc, self.getCurScope());
        if self.Tok.is(identifier) || self.Tok.is(kw_export) {
            PragmaName = self.Tok.getIdentifierInfo().getName();
            if PragmaName != "export" {
                self.PP << PragmaName;
            }
        } else if self.Tok.isNot(eof) {
            self.PP << PragmaName;
            return;
        }
    }
        if !(self.Tok.isNot(eof)) { break; }
    }
    return;
}

fn Parser::HandlePragmaExport(self) {
    assert!(self.Tok.is(annot_pragma_export);
    self.zOSHandlePragmaHelper(annot_pragma_export);
}

