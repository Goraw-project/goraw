struct PragmaMSFenvAccessHandler {
    Name: str,
}

fn PragmaMSFenvAccessHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut PragmaName: str = FirstToken.getIdentifierInfo().getName();
    if !PP.getTargetInfo().hasStrictFP() && !PP.getLangOpts().ExpStrictFP {
        PP.Diag(FirstToken.getLocation(), warn_pragma_fp_ignored) << PragmaName;
        return;
    }
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_lparen) << PragmaName;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP.Diag(Tok.getLocation(), warn_pragma_ms_fenv_access);
        return;
    }
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    let mut OOS: OnOffSwitch = zeroed();
    if II.isStr("on") {
        OOS = OOS_ON;
        PP.Lex(Tok);
    } else if II.isStr("off") {
        OOS = OOS_OFF;
        PP.Lex(Tok);
    } else {
        PP.Diag(Tok.getLocation(), warn_pragma_ms_fenv_access);
        return;
    }
    if Tok.isNot(r_paren) {
        PP.Diag(Tok.getLocation(), warn_pragma_expected_rparen) << PragmaName;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP.Diag(Tok.getLocation(), warn_pragma_extra_tokens_at_eol) << PragmaName;
        return;
    }
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(1), 1 };
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_fenv_access_ms);
    Toks[0].setLocation(FirstToken.getLocation());
    Toks[0].setAnnotationEndLoc(Tok.getLocation());
    Toks[0].setAnnotationValue(OOS as u64 as *mut void);
    PP.EnterTokenStream(Toks, true, false);
}

fn PragmaMSFenvAccessHandler::getName(self: *PragmaMSFenvAccessHandler) -> str {
    return self.Name;
}

fn PragmaMSFenvAccessHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

