struct PragmaSTDC_FENV_ACCESSHandler {
    Name: str,
}

fn PragmaSTDC_FENV_ACCESSHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PragmaName: Token = Tok;
    if !PP.getTargetInfo().hasStrictFP() && !PP.getLangOpts().ExpStrictFP {
        PP.Diag(Tok.getLocation(), warn_pragma_fp_ignored) << PragmaName.getIdentifierInfo().getName();
        return;
    }
    let mut OOS: OnOffSwitch = zeroed();
    if PP.LexOnOffSwitch(OOS) {
        return;
    }
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { PP.getPreprocessorAllocator().Allocate(1), 1 };
    Toks[0].startToken();
    Toks[0].setKind(annot_pragma_fenv_access);
    Toks[0].setLocation(Tok.getLocation());
    Toks[0].setAnnotationEndLoc(Tok.getLocation());
    Toks[0].setAnnotationValue(OOS as u64 as *mut void);
    PP.EnterTokenStream(Toks, true, false);
}

fn PragmaSTDC_FENV_ACCESSHandler::getName(self: *PragmaSTDC_FENV_ACCESSHandler) -> str {
    return self.Name;
}

fn PragmaSTDC_FENV_ACCESSHandler::getIfNamespace(self) -> *mut PragmaNamespace {
    return null;
}

