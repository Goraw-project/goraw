    } else {
        if self.Tok.getIdentifierInfo() {
            if getParsedKind(self.Tok.getIdentifierInfo(), null, AS_GNU) != UnknownAttribute {
                let mut InsertStartLoc: SourceLocation = self.Tok.getLocation();
                self.ConsumeToken();
                if self.Tok.is(l_paren) {
                    self.ConsumeAnyToken(false);
                    self.SkipUntil(r_paren, StopBeforeMatch);
                    if self.Tok.isNot(r_paren) {
                        return SkipToEnd.call();
                    }
                }
                 << CreateInsertion(InsertStartLoc, "__attribute__((", false) << CreateInsertion(self.Tok.getEndLoc(), "))", false);
            }
        }
        SkipToEnd.call();
        return;
    }
    if Attrs.empty || Attrs() {
        SkipToEnd.call();
        return;
    }
    if !self.TryConsumeToken(comma) {
        createExpectedAttributeSubjectRulesTokenDiagnostic(Attrs, Comma, *self) << comma;
        SkipToEnd.call();
        return;
    }
    if self.Tok.isNot(identifier) {
        createExpectedAttributeSubjectRulesTokenDiagnostic(Attrs, ApplyTo, *self);
        SkipToEnd.call();
        return;
    }
    let mut II: *IdentifierInfo = self.Tok.getIdentifierInfo();
    if !II.isStr("apply_to") {
        createExpectedAttributeSubjectRulesTokenDiagnostic(Attrs, ApplyTo, *self);
        SkipToEnd.call();
        return;
    }
    self.ConsumeToken();
    if !self.TryConsumeToken(equal) {
        createExpectedAttributeSubjectRulesTokenDiagnostic(Attrs, Equals, *self) << equal;
        SkipToEnd.call();
        return;
    }
    let mut SubjectMatchRules: i32 = 0;
    let mut AnyLoc: SourceLocation = SourceLocation {};
    let mut LastMatchRuleEndLoc: SourceLocation = SourceLocation {};
    if  {
        SkipToEnd.call();
        return;
    }
    if self.Tok.isNot(eof) {
        SkipToEnd.call();
        return;
    }
    self.ConsumeToken();
    if Info.Action == Push {
        self.Actions.ActOnPragmaAttributeEmptyPush(PragmaLoc, Info.Namespace);
    }
}

fn PragmaGCCVisibilityHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, VisTok: *mut Token) {
    let mut VisLoc: SourceLocation = VisTok.getLocation();
    let mut Tok: Token = Token {};
    PP.LexUnexpandedToken(Tok);
    let mut PushPop: *IdentifierInfo = Tok.getIdentifierInfo();
    let mut VisType: *IdentifierInfo = null;
    if PushPop && PushPop.isStr("pop") {
        VisType = null;
    } else if PushPop && PushPop.isStr("push") {
        PP.LexUnexpandedToken(Tok);
        if Tok.isNot(l_paren) {
            PP << "visibility";
            return;
        }
        PP.LexUnexpandedToken(Tok);
        VisType = Tok.getIdentifierInfo();
        if !VisType {
            PP << "visibility";
            return;
        }
        PP.LexUnexpandedToken(Tok);
        if Tok.isNot(r_paren) {
            PP << "visibility";
            return;
        }
    } else {
        PP << "visibility";
        return;
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(eod) {
        PP << "visibility";
        return;
    }
    let mut Toks: auto = make_unique(1);
    Toks()[0]();
    Toks()[0](annot_pragma_vis);
    Toks()[0](VisLoc);
    Toks()[0](EndLoc);
    Toks()[0](VisType as *void);
    PP(move(), 1, true, false);
}

fn PragmaPackHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, PackTok: *mut Token) {
    let mut PackLoc: SourceLocation = PackTok.getLocation();
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << "pack";
        return;
    }
    let mut Action: PragmaMsStackAction = PSK_Reset;
    let mut SlotLabel: str = "";
    let mut Alignment: Token = Token {};
    Alignment.startToken();
    PP.Lex(Tok);
    if Tok.is(numeric_constant) {
        Alignment = Tok;
        PP.Lex(Tok);
        Action = if (PP.getLangOpts() || PP.getLangOpts()) { PSK_Push_Set } else { PSK_Set };
    } else if Tok.is(identifier) {
        let mut MapPack: Closure_3 = Closure_3 { Action: &mut Action, Alignment: &mut Alignment, Tok: &mut Tok };
        let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
        if II.isStr("show") {
            Action = PSK_Show;
            PP.Lex(Tok);
        } else if II.isStr("packed") && PP.getLangOpts() {
            MapPack.call("1");
            PP.Lex(Tok);
        } else if II.isStr("full") && PP.getLangOpts() {
            MapPack.call("4");
            PP.Lex(Tok);
        } else if II.isStr("twobyte") && PP.getLangOpts() {
            MapPack.call("2");
            PP.Lex(Tok);
        } else if II.isStr("reset") && PP.getLangOpts() {
            Action = PSK_Pop;
            PP.Lex(Tok);
        } else {
            if II.isStr("push") {
                Action = PSK_Push;
            } else if II.isStr("pop") {
                Action = PSK_Pop;
            } else {
                PP << "pack";
                return;
            }
            PP.Lex(Tok);
            if Tok.is(comma) {
                PP.Lex(Tok);
                if Tok.is(numeric_constant) {
                    Action = (Action | PSK_Set) as PragmaMsStackAction;
                    Alignment = Tok;
                    PP.Lex(Tok);
                } else if Tok.is(identifier) {
                    SlotLabel = Tok.getIdentifierInfo().getName();
                    PP.Lex(Tok);
                    if Tok.is(comma) {
                        PP.Lex(Tok);
                        if Tok.isNot(numeric_constant) {
                            PP;
                            return;
                        }
                        Action = (Action | PSK_Set) as PragmaMsStackAction;
                        Alignment = Tok;
                        PP.Lex(Tok);
                    }
                } else {
                    PP;
                    return;
                }
            }
        }
    } else if PP.getLangOpts() || PP.getLangOpts() {
        Action = PSK_Pop;
    }
    if Tok.isNot(r_paren) {
        PP << "pack";
        return;
    }
    let mut RParenLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << "pack";
        return;
    }
    let mut Info: *mut PragmaPackInfo = PP()()(1);
    Info.Action = Action;
    Info.SlotLabel = SlotLabel;
    Info.Alignment = Alignment;
    let mut Toks: MutableArrayRef<Token> = zeroed();
    Toks()[0]();
    Toks()[0](annot_pragma_pack);
    Toks()[0](PackLoc);
    Toks()[0](RParenLoc);
    Toks()[0](Info as *mut void);
    PP(true, false);
}

fn PragmaMSStructHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, MSStructTok: *mut Token) {
    let mut Kind: PragmaMSStructKind = PMSST_OFF;
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP;
        return;
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    if II.isStr("on") {
        Kind = PMSST_ON;
        PP.Lex(Tok);
    } else if II.isStr("off") || II.isStr("reset") {
        PP.Lex(Tok);
    } else {
        PP;
        return;
    }
    if Tok.isNot(eod) {
        PP << "ms_struct";
        return;
    }
    let mut Toks: MutableArrayRef<Token> = zeroed();
    Toks()[0]();
    Toks()[0](annot_pragma_msstruct);
    Toks()[0](MSStructTok.getLocation());
    Toks()[0](EndLoc);
    Toks()[0](Kind as u64 as *mut void);
    PP(true, false);
}

fn PragmaClangSectionHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut Tok: Token = Token {};
    let mut SecKind: PragmaClangSectionKind = Invalid;
    PP.Lex(Tok);
    while Tok.isNot(eod) {
        if Tok.isNot(identifier) {
            PP << "clang section";
            return;
        }
        let mut SecType: *IdentifierInfo = Tok.getIdentifierInfo();
        if SecType.isStr("bss") {
            SecKind = BSS;
        } else if SecType.isStr("data") {
            SecKind = Data;
        } else if SecType.isStr("rodata") {
            SecKind = Rodata;
        } else if SecType.isStr("relro") {
            SecKind = Relro;
        } else if SecType.isStr("text") {
            SecKind = Text;
        } else {
            PP << "clang section";
            return;
        }
        let mut PragmaLocation: SourceLocation = Tok.getLocation();
        PP.Lex(Tok);
        if Tok.isNot(equal) {
            PP << SecKind;
            return;
        }
        let mut SecName: str = zeroed();
        if operator!(PP.LexStringLiteral(Tok, "pragma clang section", false)) {
            return;
        }
        self.Actions.ActOnPragmaClangSection(PragmaLocation, (if SecName()() { Set } else { Clear }), SecKind);
    }
}

fn ParseAlignPragma(PP: *mut Preprocessor, FirstTok: *mut Token, IsOptions: bool) {
    let mut Tok: Token = Token {};
    if IsOptions {
        PP.Lex(Tok);
        if Tok.isNot(identifier) || !Tok.getIdentifierInfo().isStr("align") {
            PP;
            return;
        }
    }
    PP.Lex(Tok);
    if PP.getLangOpts() {
        if Tok.isNot(l_paren) {
            PP << "align";
            return;
        }
    } else if Tok.isNot(equal) {
        PP << IsOptions;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP << (if IsOptions { "options" } else { "align" });
        return;
    }
    let mut Kind: PragmaOptionsAlignKind = Natural;
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    if II.isStr("native") {
        Kind = Native;
    } else if II.isStr("natural") {
        Kind = Natural;
    } else if II.isStr("packed") {
        Kind = Packed;
    } else if II.isStr("power") {
        Kind = Power;
    } else if II.isStr("mac68k") {
        Kind = Mac68k;
    } else if II.isStr("reset") {
        Kind = Reset;
    } else {
        PP << IsOptions;
        return;
    }
    if PP.getLangOpts() {
        PP.Lex(Tok);
        if Tok.isNot(r_paren) {
            PP << "align";
            return;
        }
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << (if IsOptions { "options" } else { "align" });
        return;
    }
    let mut Toks: MutableArrayRef<Token> = zeroed();
    Toks()[0]();
    Toks()[0](annot_pragma_align);
    Toks()[0](FirstTok.getLocation());
    Toks()[0](EndLoc);
    Toks()[0](Kind as u64 as *mut void);
    PP(true, false);
}

fn PragmaAlignHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, AlignTok: *mut Token) {
    ParseAlignPragma(PP, AlignTok, false);
}

fn PragmaOptionsHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, OptionsTok: *mut Token) {
    ParseAlignPragma(PP, OptionsTok, true);
}

fn PragmaUnusedHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, UnusedTok: *mut Token) {
    let mut UnusedLoc: SourceLocation = UnusedTok.getLocation();
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << "unused";
        return;
    }
    let mut Identifiers: SmallVector<Token, 5> = zeroed();
    let mut RParenLoc: SourceLocation = SourceLocation {};
    let mut LexID: bool = true;
    while true {
        PP.Lex(Tok);
        if LexID {
            if Tok.is(identifier) {
                Identifiers()(Tok);
                LexID = false;
                continue;
            }
            PP;
            return;
        }
        if Tok.is(comma) {
            LexID = true;
            continue;
        }
        if Tok.is(r_paren) {
            RParenLoc = Tok.getLocation();
            break;
        }
        PP << "unused";
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << "unused";
        return;
    }
    assert!(RParenLoc.isValid(), "Valid '#pragma unused' must have ')'");
    (((operator!(operator!((operator!() && "Valid '#pragma unused' must have arguments")))) || (_wassert(L"!Identifiers.empty() && \"Valid '#pragma unused' must have arguments\"", L"clang\\lib\\Parse\\ParsePragma.cpp", (2596) as u32) , 0)) as void);
    let mut Toks: MutableArrayRef<Token> = zeroed();
    for let mut i: u32 = 0; i != (); i += 1 {
        let mut pragmaUnusedTok: *mut Token = [2 * i];
        let mut idTok: *mut Token = [2 * i + 1];
        pragmaUnusedTok.startToken();
        pragmaUnusedTok.setKind(annot_pragma_unused);
        pragmaUnusedTok.setLocation(UnusedLoc);
        idTok = [i];
    }
    PP(true, false);
}

fn PragmaWeakHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, WeakTok: *mut Token) {
    let mut WeakLoc: SourceLocation = WeakTok.getLocation();
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP << "weak";
        return;
    }
    let mut WeakName: Token = Tok;
    let mut HasAlias: bool = false;
    let mut AliasName: Token = Token {};
    PP.Lex(Tok);
    if Tok.is(equal) {
        HasAlias = true;
        PP.Lex(Tok);
        if Tok.isNot(identifier) {
            PP << "weak";
            return;
        }
        AliasName = Tok;
        PP.Lex(Tok);
    }
    if Tok.isNot(eod) {
        PP << "weak";
        return;
    }
    if HasAlias {
        let mut Toks: MutableArrayRef<Token> = zeroed();
        let mut pragmaUnusedTok: *mut Token = [0];
        pragmaUnusedTok.startToken();
        pragmaUnusedTok.setKind(annot_pragma_weakalias);
        pragmaUnusedTok.setLocation(WeakLoc);
        pragmaUnusedTok.setAnnotationEndLoc(AliasName.getLocation());
        Toks()[1] = WeakName;
        Toks()[2] = AliasName;
        PP(true, false);
    } else {
        let mut Toks: MutableArrayRef<Token> = zeroed();
        let mut pragmaUnusedTok: *mut Token = [0];
        pragmaUnusedTok.startToken();
        pragmaUnusedTok.setKind(annot_pragma_weak);
        pragmaUnusedTok.setLocation(WeakLoc);
        pragmaUnusedTok.setAnnotationEndLoc(WeakLoc);
        Toks()[1] = WeakName;
        PP(true, false);
    }
}

fn PragmaRedefineExtnameHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, RedefToken: *mut Token) {
    let mut RedefLoc: SourceLocation = RedefToken.getLocation();
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP << "redefine_extname";
        return;
    }
    let mut RedefName: Token = Tok;
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP << "redefine_extname";
        return;
    }
    let mut AliasName: Token = Tok;
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << "redefine_extname";
        return;
    }
    let mut Toks: MutableArrayRef<Token> = zeroed();
    let mut pragmaRedefTok: *mut Token = [0];
    pragmaRedefTok.startToken();
    pragmaRedefTok.setKind(annot_pragma_redefine_extname);
    pragmaRedefTok.setLocation(RedefLoc);
    pragmaRedefTok.setAnnotationEndLoc(AliasName.getLocation());
    Toks()[1] = RedefName;
    Toks()[2] = AliasName;
    PP(true, false);
}

fn PragmaFPContractHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut OOS: OnOffSwitch = zeroed();
    if PP.LexOnOffSwitch(OOS) {
        return;
    }
    let mut Toks: MutableArrayRef<Token> = zeroed();
    Toks()[0]();
    Toks()[0](annot_pragma_fp_contract);
    Toks()[0](Tok.getLocation());
    Toks()[0](Tok.getLocation());
    Toks()[0](OOS as u64 as *mut void);
    PP(true, false);
}

fn PragmaOpenCLExtensionHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.LexUnexpandedToken(Tok);
    if Tok.isNot(identifier) {
        PP << "OPENCL";
        return;
    }
    let mut Ext: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut NameLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(colon) {
        PP << Ext;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP << 0;
        return;
    }
    let mut Pred: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut State: OpenCLExtState = zeroed();
    if Pred.isStr("enable") {
        State = Enable;
    } else if Pred.isStr("disable") {
        State = Disable;
    } else if Pred.isStr("begin") {
        State = Begin;
    } else if Pred.isStr("end") {
        State = End;
    } else {
        PP << Ext.isStr("all");
        return;
    }
    let mut StateLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << "OPENCL EXTENSION";
        return;
    }
    let mut Info: auto = PP()()(1);
    Info() = Ext;
    Info() = State;
    let mut Toks: MutableArrayRef<Token> = zeroed();
    Toks()[0]();
    Toks()[0](annot_pragma_opencl_extension);
    Toks()[0](NameLoc);
    Toks()[0]( as *mut void);
    Toks()[0](StateLoc);
    PP(true, false);
    if PP.getPPCallbacks() {
        PP.getPPCallbacks().PragmaOpenCLExtension(NameLoc, Ext, StateLoc, State);
    }
}

fn Self::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstTok: *mut Token) {
    if !PP.getDiagnostics().isIgnored(IgnoredDiag, FirstTok.getLocation()) {
        PP.Diag(FirstTok, IgnoredDiag);
        PP.getDiagnostics().setSeverity(IgnoredDiag, Ignored, SourceLocation {});
    }
    PP.DiscardUntilEndOfDirective(null);
}

fn Self::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstTok: *mut Token) {
    let mut Pragma: SmallVector<Token, 16> = zeroed();
    let mut Tok: Token = Token {};
    Tok.startToken();
    Tok.setKind(StartTok);
    Tok.setLocation(Introducer.Loc);
    while Tok.isNot(eod) && Tok.isNot(eof) {
        Pragma()(Tok);
        PP.Lex(Tok);
        if Tok.is(StartTok) {
            PP.Diag(Tok, UnexpectedDiag);
            let mut InnerPragmaCnt: u32 = 1;
            while InnerPragmaCnt != 0 {
                PP.Lex(Tok);
                if Tok.is(StartTok) {
                    InnerPragmaCnt += 1;
                } else if Tok.is(EndTok) {
                    InnerPragmaCnt -= 1;
                }
            }
            PP.Lex(Tok);
        }
    }
    let mut EodLoc: SourceLocation = Tok.getLocation();
    Tok.startToken();
    Tok.setKind(EndTok);
    Tok.setLocation(EodLoc);
    Pragma()(Tok);
    let mut Toks: auto = make_unique();
    copy();
    PP(move(), false, false);
}

fn PragmaMSPointersToMembers::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PointersToMembersLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << "pointers_to_members";
        return;
    }
    PP.Lex(Tok);
    let mut Arg: *IdentifierInfo = Tok.getIdentifierInfo();
    if !Arg {
        PP << "pointers_to_members";
        return;
    }
    PP.Lex(Tok);
    let mut RepresentationMethod: PragmaMSPointersToMembersKind = zeroed();
    if Arg.isStr("best_case") {
        RepresentationMethod = PPTMK_BestCase;
    } else {
        if Arg.isStr("full_generality") {
            if Tok.is(comma) {
                PP.Lex(Tok);
                Arg = Tok.getIdentifierInfo();
                if !Arg {
                    PP << Tok.getKind() << 0;
                    return;
                }
                PP.Lex(Tok);
            } else if Tok.is(r_paren) {
                Arg = null;
                RepresentationMethod = PPTMK_FullGeneralityVirtualInheritance;
            } else {
                PP << "full_generality";
                return;
            }
        }
        if Arg {
            if Arg.isStr("single_inheritance") {
                RepresentationMethod = PPTMK_FullGeneralitySingleInheritance;
            } else if Arg.isStr("multiple_inheritance") {
                RepresentationMethod = PPTMK_FullGeneralityMultipleInheritance;
            } else if Arg.isStr("virtual_inheritance") {
                RepresentationMethod = PPTMK_FullGeneralityVirtualInheritance;
            } else {
                PP << Arg << 1;
                return;
            }
        }
    }
    if Tok.isNot(r_paren) {
        PP << (if Arg { Arg.getName() } else { "full_generality" });
        return;
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << "pointers_to_members";
        return;
    }
    let mut AnnotTok: Token = Token {};
    AnnotTok.startToken();
    AnnotTok.setKind(annot_pragma_ms_pointers_to_members);
    AnnotTok.setLocation(PointersToMembersLoc);
    AnnotTok.setAnnotationEndLoc(EndLoc);
    AnnotTok.setAnnotationValue(RepresentationMethod as u64 as *mut void);
    PP.EnterToken(AnnotTok, true);
}

fn PragmaMSVtorDisp::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut VtorDispLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << "vtordisp";
        return;
    }
    PP.Lex(Tok);
    let mut Action: PragmaMsStackAction = PSK_Set;
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    if II {
        if II.isStr("push") {
            PP.Lex(Tok);
            if Tok.isNot(comma) {
                PP << "vtordisp";
                return;
            }
            PP.Lex(Tok);
            Action = PSK_Push_Set;
        } else if II.isStr("pop") {
            PP.Lex(Tok);
            Action = PSK_Pop;
        }
    } else {
        if Tok.is(r_paren) {
            Action = PSK_Reset;
        }
    }
    let mut Value: u64 = 0;
    if Action & PSK_Push || Action & PSK_Set {
        let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
        if II && II.isStr("off") {
            PP.Lex(Tok);
            Value = 0;
        } else if II && II.isStr("on") {
            PP.Lex(Tok);
            Value = 1;
        } else if Tok.is(numeric_constant) && PP.parseSimpleIntegerLiteral(Tok, Value) {
            if Value > 2 {
                PP << 0 << 2 << "vtordisp";
                return;
            }
        } else {
            PP << "vtordisp";
            return;
        }
    }
    if Tok.isNot(r_paren) {
        PP << "vtordisp";
        return;
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << "vtordisp";
        return;
    }
    let mut AnnotTok: Token = Token {};
    AnnotTok.startToken();
    AnnotTok.setKind(annot_pragma_ms_vtordisp);
    AnnotTok.setLocation(VtorDispLoc);
    AnnotTok.setAnnotationEndLoc(EndLoc);
    AnnotTok.setAnnotationValue((Action << 16) | (Value & 65535) as u64 as *mut void);
    PP.EnterToken(AnnotTok, false);
}

fn PragmaMSPragma::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut EoF: Token = Token {};
    let mut AnnotTok: Token = Token {};
    EoF.startToken();
    EoF.setKind(eof);
    AnnotTok.startToken();
    AnnotTok.setKind(annot_pragma_ms_pragma);
    AnnotTok.setLocation(Tok.getLocation());
    AnnotTok.setAnnotationEndLoc(Tok.getLocation());
    let mut TokenVector: SmallVector<Token, 8> = zeroed();
    for ; Tok.isNot(eod); PP.Lex(Tok) {
        TokenVector()(Tok);
        AnnotTok.setAnnotationEndLoc(Tok.getLocation());
    }
    TokenVector()(EoF);
    markAsReinjectedForRelexing();
    let mut TokenArray: auto = make_unique();
    copy();
    let mut Value: auto = zeroed();
    AnnotTok.setAnnotationValue();
    PP.EnterToken(AnnotTok, false);
}

fn PragmaFloatControlHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut Action: PragmaMsStackAction = PSK_Set;
    let mut FloatControlLoc: SourceLocation = Tok.getLocation();
    let mut PragmaName: Token = Tok;
    if !PP.getTargetInfo().hasStrictFP() && operator!(PP.getLangOpts()) {
        PP << PragmaName.getIdentifierInfo().getName();
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << l_paren;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP;
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut Kind: PragmaFloatControlKind = zeroed();
    PP.Lex(Tok);
    if Kind == PFC_Unknown {
        PP;
        return;
    } else if Kind == PFC_Push || Kind == PFC_Pop {
        if Tok.isNot(r_paren) {
            PP;
            return;
        }
        PP.Lex(Tok);
        Action = if (Kind == PFC_Pop) { PSK_Pop } else { PSK_Push };
    } else {
        if Tok.is(r_paren) {
            PP.Lex(Tok);
        } else if Tok.isNot(comma) {
            PP;
            return;
        } else {
            PP.Lex(Tok);
            if !Tok.isAnyIdentifier() {
                PP;
                return;
            }
            let mut PushOnOff: str = Tok.getIdentifierInfo().getName();
            if PushOnOff == "on" {
                
            } else if PushOnOff == "off" {
                if Kind == PFC_Precise {
                    Kind = PFC_NoPrecise;
                }
                if Kind == PFC_Except {
                    Kind = PFC_NoExcept;
                }
            } else if PushOnOff == "push" {
                Action = PSK_Push_Set;
            } else {
                PP;
                return;
            }
            PP.Lex(Tok);
            if Tok.is(comma) {
                PP.Lex(Tok);
                if !Tok.isAnyIdentifier() {
                    PP;
                    return;
                }
                let mut ExpectedPush: str = Tok.getIdentifierInfo().getName();
                if ExpectedPush == "push" {
                    Action = PSK_Push_Set;
                } else {
                    PP;
                    return;
                }
                PP.Lex(Tok);
            }
            if Tok.isNot(r_paren) {
                PP;
                return;
            }
            PP.Lex(Tok);
        }
    }
    let mut EndLoc: SourceLocation = Tok.getLocation();
    if Tok.isNot(eod) {
        PP << "float_control";
        return;
    }
    let mut TokenArray: auto = make_unique(1);
    TokenArray()[0]();
    TokenArray()[0](annot_pragma_float_control);
    TokenArray()[0](FloatControlLoc);
    TokenArray()[0](EndLoc);
    TokenArray()[0]((Action << 16) | (Kind & 65535) as u64 as *mut void);
    PP(move(), 1, false, false);
}

fn PragmaDetectMismatchHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut DetectMismatchLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP << l_paren;
        return;
    }
    let mut NameString: str = zeroed();
    if operator!(PP.LexStringLiteral(Tok, "pragma detect_mismatch", true)) {
        return;
    }
    let mut ValueString: str = zeroed();
    if Tok.isNot(comma) {
        PP;
        return;
    }
    if operator!(PP.LexStringLiteral(Tok, "pragma detect_mismatch", true)) {
        return;
    }
    if Tok.isNot(r_paren) {
        PP << r_paren;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP;
        return;
    }
    if PP.getPPCallbacks() {
        PP.getPPCallbacks().PragmaDetectMismatch(DetectMismatchLoc);
    }
    self.Actions.ActOnPragmaDetectMismatch(DetectMismatchLoc);
}

fn PragmaCommentHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut CommentLoc: SourceLocation = Tok.getLocation();
    PP.Lex(Tok);
    if Tok.isNot(l_paren) {
        PP;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP;
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut Kind: PragmaMSCommentKind = zeroed();
    if Kind == PCK_Unknown {
        PP;
        return;
    }
    if PP.getTargetInfo().getTriple().isOSAIX() && Kind != PCK_Copyright {
        PP << II.getName();
        return;
    }
    if PP.getTargetInfo().getTriple().isOSBinFormatELF() && Kind != PCK_Lib {
        PP << II.getName();
        return;
    }
    if Kind == PCK_Copyright {
        if self.SeenCopyrightInTU {
            PP << II.getName();
            return;
        }
        self.SeenCopyrightInTU = true;
    }
    PP.Lex(Tok);
    let mut ArgumentString: str = zeroed();
    if Tok.is(comma) && operator!(PP.LexStringLiteral(Tok, "pragma comment", true)) {
        return;
    }
    if Tok.isNot(r_paren) {
        PP;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP;
        return;
    }
    if Kind == PCK_Copyright && () {
        return;
    }
    if PP.getPPCallbacks() {
        PP.getPPCallbacks().PragmaComment(CommentLoc, II);
    }
    self.Actions.ActOnPragmaMSComment(CommentLoc, Kind);
}

fn PragmaOptimizeHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    if Tok.is(eod) {
        PP << "clang optimize" << true << "'on' or 'off'";
        return;
    }
    if Tok.isNot(identifier) {
        PP << PP;
        return;
    }
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    let mut IsOn: bool = false;
    if II.isStr("on") {
        IsOn = true;
    } else if !II.isStr("off") {
        PP << PP;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << PP;
        return;
    }
    self.Actions.ActOnPragmaOptimize(IsOn, FirstToken.getLocation());
}

struct TokFPAnnotValue {
    ContractValue: FPModeKind>,
    ReassociateValue: FPModeKind>,
    ReciprocalValue: FPModeKind>,
    ExceptionsValue: FPExceptionModeKind>,
    EvalMethodValue: FPEvalMethodKind>,
}

fn PragmaFPHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PragmaName: Token = Tok;
    let mut TokenList: SmallVector<Token, 1> = zeroed();
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP << true << "";
        return;
    }
    let mut AnnotValue: *mut auto = TokFPAnnotValue {};
    while Tok.is(identifier) {
        let mut OptionInfo: *mut IdentifierInfo = Tok.getIdentifierInfo();
        let mut FlagKind: auto = zeroed();
        if operator!() {
            PP << false << OptionInfo;
            return;
        }
        PP.Lex(Tok);
        if Tok.isNot(l_paren) {
            PP << l_paren;
            return;
        }
        PP.Lex(Tok);
        let mut isEvalMethodDouble: bool = Tok.is(kw_double) &&  == PFK_EvalMethod;
        if Tok.isNot(identifier) && !isEvalMethodDouble {
            PP << PP << OptionInfo.getName() << operator*() as i32;
            return;
        }
        let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
        if FlagKind() == PFK_Contract {
            if operator!() {
                PP << PP << OptionInfo.getName() << operator*();
                return;
            }
        } else if FlagKind() == PFK_Reassociate ||  == PFK_Reciprocal {
            let mut Value: *mut auto = if  == PFK_Reassociate {  } else {  };
            if operator!() {
                PP << PP << OptionInfo.getName() << operator*();
                return;
            }
        } else if FlagKind() == PFK_Exceptions {
            if operator!() {
                PP << PP << OptionInfo.getName() << operator*();
                return;
            }
        } else if FlagKind() == PFK_EvalMethod {
            if operator!() {
                PP << PP << OptionInfo.getName() << operator*();
                return;
            }
        }
        PP.Lex(Tok);
        if Tok.isNot(r_paren) {
            PP << r_paren;
            return;
        }
        PP.Lex(Tok);
    }
    if Tok.isNot(eod) {
        PP << "clang fp";
        return;
    }
    let mut FPTok: Token = Token {};
    FPTok.startToken();
    FPTok.setKind(annot_pragma_fp);
    FPTok.setLocation(PragmaName.getLocation());
    FPTok.setAnnotationEndLoc(PragmaName.getLocation());
    FPTok.setAnnotationValue( as *mut void);
    TokenList()(FPTok);
    let mut TokenArray: auto = make_unique();
    copy();
    PP(move(), false, false);
}

fn PragmaSTDC_FENV_ROUNDHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PragmaName: Token = Tok;
    if !PP.getTargetInfo().hasStrictFP() && operator!(PP.getLangOpts()) {
        PP << PragmaName.getIdentifierInfo().getName();
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP << PragmaName.getIdentifierInfo().getName();
        return;
    }
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    let mut RM: auto = zeroed();
    if RM() == Invalid {
        PP;
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << "STDC FENV_ROUND";
        return;
    }
    PP;
    let mut Toks: MutableArrayRef<Token> = zeroed();
    Toks()[0]();
    Toks()[0](annot_pragma_fenv_round);
    Toks()[0](Tok.getLocation());
    Toks()[0](Tok.getLocation());
    Toks()[0]( as u64 as *mut void);
    PP(true, false);
}

fn Parser::HandlePragmaFP(self) {
    assert!(self.Tok.is(annot_pragma_fp);
    let mut AnnotValue: *mut TokFPAnnotValue = self.Tok.getAnnotationValue() as *mut TokFPAnnotValue;
    if AnnotValue() {
        self.Actions.ActOnPragmaFPValueChangingOption(self.Tok.getLocation(), PFK_Reassociate, operator*(AnnotValue()) == FPM_On);
    }
    if AnnotValue() {
        self.Actions.ActOnPragmaFPValueChangingOption(self.Tok.getLocation(), PFK_Reciprocal, operator*(AnnotValue()) == FPM_On);
    }
    if AnnotValue() {
        self.Actions.ActOnPragmaFPContract(self.Tok.getLocation(), operator*(AnnotValue()));
    }
    if AnnotValue() {
        self.Actions.ActOnPragmaFPExceptions(self.Tok.getLocation(), operator*(AnnotValue()));
    }
    if AnnotValue() {
        self.Actions.ActOnPragmaFPEvalMethod(self.Tok.getLocation(), operator*(AnnotValue()));
    }
    self.ConsumeAnnotationToken();
}

fn ParseLoopHintValue(PP: *mut Preprocessor, Tok: *mut Token, PragmaName: Token, Option: Token, ValueInParens: bool, Info: *mut PragmaLoopHintInfo) -> bool {
    let mut ValueList: SmallVector<Token, 1> = zeroed();
    let mut OpenParens: i32 = if ValueInParens { 1 } else { 0 };
    while Tok.isNot(eod) {
        if Tok.is(l_paren) {
            OpenParens += 1;
        } else if Tok.is(r_paren) {
            OpenParens -= 1;
            if OpenParens == 0 && ValueInParens {
                break;
            }
        }
        ValueList()(Tok);
        PP.Lex(Tok);
    }
    if ValueInParens {
        if Tok.isNot(r_paren) {
            PP << r_paren;
            return true;
        }
        PP.Lex(Tok);
    }
    let mut EOFTok: Token = Token {};
    EOFTok.startToken();
    EOFTok.setKind(eof);
    EOFTok.setLocation(Tok.getLocation());
    ValueList()(EOFTok);
    markAsReinjectedForRelexing();
    Info() = (PP()());
    Info.PragmaName = PragmaName;
    Info.Option = Option;
    return false;
}

fn PragmaLoopHintHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PragmaName: Token = Tok;
    let mut TokenList: SmallVector<Token, 1> = zeroed();
    PP.Lex(Tok);
    if Tok.isNot(identifier) {
        PP << true << "";
        return;
    }
    while Tok.is(identifier) {
        let mut Option: Token = Tok;
        let mut OptionInfo: *mut IdentifierInfo = Tok.getIdentifierInfo();
        let mut OptionValid: bool = false;
        if !OptionValid {
            PP << false << OptionInfo;
            return;
        }
        PP.Lex(Tok);
        if Tok.isNot(l_paren) {
            PP << l_paren;
            return;
        }
        PP.Lex(Tok);
        let mut Info: *mut auto = PragmaLoopHintInfo {};
        if ParseLoopHintValue(PP, Tok, PragmaName, Option, true, operator*()) {
            return;
        }
        let mut LoopHintTok: Token = Token {};
        LoopHintTok.startToken();
        LoopHintTok.setKind(annot_pragma_loop_hint);
        LoopHintTok.setLocation(Introducer.Loc);
        LoopHintTok.setAnnotationEndLoc(PragmaName.getLocation());
        LoopHintTok.setAnnotationValue( as *mut void);
        TokenList()(LoopHintTok);
    }
    if Tok.isNot(eod) {
        PP << "clang loop";
        return;
    }
    let mut TokenArray: auto = make_unique();
    copy();
    PP(move(), false, false);
}

fn PragmaUnrollHintHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut PragmaName: Token = Tok;
    PP.Lex(Tok);
    let mut Info: *mut auto = PragmaLoopHintInfo {};
    if Tok.is(eod) {
        Info() = PragmaName;
        Info()();
    } else if PragmaName.getIdentifierInfo().getName() == "nounroll" || PragmaName.getIdentifierInfo().getName() == "nounroll_and_jam" {
        PP << PragmaName.getIdentifierInfo().getName();
        return;
    } else {
        let mut ValueInParens: bool = Tok.is(l_paren);
        if ValueInParens {
            PP.Lex(Tok);
        }
        let mut Option: Token = Token {};
        Option.startToken();
        if ParseLoopHintValue(PP, Tok, PragmaName, Option, ValueInParens, operator*()) {
            return;
        }
        if PP.getLangOpts() && ValueInParens {
            PP;
        }
        if Tok.isNot(eod) {
            PP << "unroll";
            return;
        }
    }
    let mut TokenArray: auto = make_unique(1);
    TokenArray()[0]();
    TokenArray()[0](annot_pragma_loop_hint);
    TokenArray()[0](Introducer.Loc);
    TokenArray()[0](PragmaName.getLocation());
    TokenArray()[0]( as *mut void);
    PP(move(), 1, false, false);
}

fn Parser::HandlePragmaMSFunction(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    let mut FirstTok: Token = self.Tok;
    if self.ExpectAndConsume {
        return false;
    }
    let mut SuggestIntrinH: bool = !self.PP.isMacroDefined("__INTRIN_H");
    let mut NoBuiltins: i32 = 0;
    while self.Tok.is(identifier) {
        let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        if !II.getBuiltinID() {
            self.PP << II << SuggestIntrinH;
        } else {
            NoBuiltins()(II.getName());
        }
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(comma) {
            break;
        }
        self.PP.Lex(self.Tok);
    }
    if self.ExpectAndConsume || self.ExpectAndConsume {
        return false;
    }
    self.Actions.ActOnPragmaMSFunction(FirstTok.getLocation());
    return true;
}

fn Parser::HandlePragmaMSOptimize(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    let mut FirstTok: Token = self.Tok;
    if self.ExpectAndConsume {
        return false;
    }
    if self.Tok.isNot(string_literal) {
        self.PP << PragmaName;
        return false;
    }
    let mut StringResult: i32 = 0;
    if StringResult()() {
        return false;
    }
    let mut OptimizationList: *mut StringLiteral = cast();
    if OptimizationList.getCharByteWidth() != 1 {
        self.PP << PragmaName;
        return false;
    }
    if self.ExpectAndConsume {
        return false;
    }
    if self.Tok.is(eof) || self.Tok.is(r_paren) {
        self.PP << PragmaName << true << "'on' or 'off'";
        return false;
    }
    let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    if !II || (!II.isStr("on") && !II.isStr("off")) {
        self.PP << self.PP << PragmaName << true << "'on' or 'off'";
        return false;
    }
    let mut IsOn: bool = II.isStr("on");
    self.PP.Lex(self.Tok);
    if self.ExpectAndConsume {
        return false;
    }
    if !OptimizationList.getString().is_empty() {
        self.PP << OptimizationList.getString() << PragmaName << true << "\"\"";
        return false;
    }
    if self.ExpectAndConsume {
        return false;
    }
    self.Actions.ActOnPragmaMSOptimize(FirstTok.getLocation(), IsOn);
    return true;
}

fn Parser::HandlePragmaMSIntrinsic(self, PragmaName: str, PragmaLocation: SourceLocation) -> bool {
    if self.ExpectAndConsume {
        return false;
    }
    let mut SuggestIntrinH: bool = !self.PP.isMacroDefined("__INTRIN_H");
    while self.Tok.is(identifier) {
        let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        if !II.getBuiltinID() {
            self.PP << II << SuggestIntrinH;
        }
        let mut NameInfo: DeclarationNameInfo = DeclarationNameInfo { II, self.Tok.getLocation() };
        let mut Previous: LookupResult = LookupResult { self.Actions, NameInfo, LookupOrdinaryName, NotForRedeclaration };
        self.Actions.LookupName(Previous, self.Actions.getCurScope(), false, false);
        if Previous.is_empty() {
            self.Actions.LazilyCreateBuiltin(II, II.getBuiltinID(), self.Actions.getCurScope(), true, self.Tok.getLocation());
        }
        self.PP.Lex(self.Tok);
        if self.Tok.isNot(comma) {
            break;
        }
        self.PP.Lex(self.Tok);
    }
    if self.ExpectAndConsume {
        return false;
    }
    if self.ExpectAndConsume {
        return false;
    }
    return true;
}

fn PragmaForceCUDAHostDeviceHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    let mut FirstTok: Token = Tok;
    PP.Lex(Tok);
    let mut Info: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !Info || (!Info.isStr("begin") && !Info.isStr("end")) {
        PP;
        return;
    }
    if Info.isStr("begin") {
        self.Actions.CUDA().PushForceHostDevice();
    } else if !self.Actions.CUDA().PopForceHostDevice() {
        PP;
    }
    PP.Lex(Tok);
    if !Tok.is(eod) {
        PP;
    }
}

fn PragmaAttributeHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    let mut Info: *mut auto = null;
    if Tok.is(identifier) {
        let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
        if !II.isStr("push") && !II.isStr("pop") {
            Info() = II;
            PP.Lex(Tok);
            if !Tok.is(period) {
                PP << II;
                return;
            }
            PP.Lex(Tok);
        }
    }
    if !Tok {
        PP;
        return;
    }
    if Tok.is(l_paren) {
        if Info() {
            PP;
            PP;
            return;
        }
        Info() = Attribute;
    } else {
        let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
        if II.isStr("push") {
            Info() = Push;
        } else if II.isStr("pop") {
            Info() = Pop;
        } else {
            PP << PP;
            return;
        }
        PP.Lex(Tok);
    }
    if (Info() == Push && Tok.isNot(eod)) ||  == Attribute {
        if Tok.isNot(l_paren) {
            PP << l_paren;
            return;
        }
        PP.Lex(Tok);
        let mut AttributeTokens: SmallVector<Token, 16> = zeroed();
        let mut OpenParens: i32 = 1;
        while Tok.isNot(eod) {
            if Tok.is(l_paren) {
                OpenParens += 1;
            } else if Tok.is(r_paren) {
                OpenParens -= 1;
                if OpenParens == 0 {
                    break;
                }
            }
            AttributeTokens()(Tok);
            PP.Lex(Tok);
        }
        if AttributeTokens()() {
            PP;
            return;
        }
        if Tok.isNot(r_paren) {
            PP << r_paren;
            return;
        }
        let mut EndLoc: SourceLocation = Tok.getLocation();
        PP.Lex(Tok);
        let mut EOFTok: Token = Token {};
        EOFTok.startToken();
        EOFTok.setKind(eof);
        EOFTok.setLocation(EndLoc);
        AttributeTokens()(EOFTok);
        markAsReinjectedForRelexing();
        Info() = (PP()());
    }
    if Tok.isNot(eod) {
        PP << "clang attribute";
    }
    let mut TokenArray: auto = make_unique(1);
    TokenArray()[0]();
    TokenArray()[0](annot_pragma_attribute);
    TokenArray()[0](FirstToken.getLocation());
    TokenArray()[0](FirstToken.getLocation());
    TokenArray()[0]( as *mut void);
    PP(move(), 1, false, false);
}

fn PragmaMaxTokensHereHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.Lex(Tok);
    if Tok.is(eod) {
        PP << "clang max_tokens_here" << true << "integer";
        return;
    }
    let mut Loc: SourceLocation = Tok.getLocation();
    let mut MaxTokens: u64 = 0;
    if Tok.isNot(numeric_constant) || !PP.parseSimpleIntegerLiteral(Tok, MaxTokens) {
        PP << "clang max_tokens_here";
        return;
    }
    if Tok.isNot(eod) {
        PP << "clang max_tokens_here";
        return;
    }
    if PP.getTokenCount() > MaxTokens {
        PP << PP.getTokenCount() << MaxTokens as u32;
    }
}

fn PragmaMaxTokensTotalHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, Tok: *mut Token) {
    PP.Lex(Tok);
    if Tok.is(eod) {
        PP << "clang max_tokens_total" << true << "integer";
        return;
    }
    let mut Loc: SourceLocation = Tok.getLocation();
    let mut MaxTokens: u64 = 0;
    if Tok.isNot(numeric_constant) || !PP.parseSimpleIntegerLiteral(Tok, MaxTokens) {
        PP << "clang max_tokens_total";
        return;
    }
    if Tok.isNot(eod) {
        PP << "clang max_tokens_total";
        return;
    }
    PP.overrideMaxTokens(MaxTokens, Loc);
}

fn zOSPragmaHandlerHelper(PP: *mut Preprocessor, Tok: *mut Token, TokKind: TokenKind) {
    let mut AnnotTok: Token = Token {};
    AnnotTok.startToken();
    AnnotTok.setKind(TokKind);
    AnnotTok.setLocation(Tok.getLocation());
    AnnotTok.setAnnotationEndLoc(Tok.getLocation());
    let mut TokenVector: SmallVector<Token, 8> = zeroed();
    for ; Tok.isNot(eod); PP.Lex(Tok) {
        TokenVector()(Tok);
        AnnotTok.setAnnotationEndLoc(Tok.getLocation());
    }
    let mut EoF: Token = Token {};
    EoF.startToken();
    EoF.setKind(eof);
    EoF.setLocation(Tok.getLocation());
    TokenVector()(EoF);
    markAsReinjectedForRelexing();
    let mut TokenArray: auto = make_unique();
    copy();
    let mut Value: auto = zeroed();
    AnnotTok.setAnnotationValue();
    PP.EnterToken(AnnotTok, false);
}

fn PragmaExportHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    zOSPragmaHandlerHelper(PP, FirstToken, annot_pragma_export);
}

fn PragmaRISCVHandler::HandlePragma(self, PP: *mut Preprocessor, Introducer: PragmaIntroducer, FirstToken: *mut Token) {
    let mut Tok: Token = Token {};
    PP.Lex(Tok);
    let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
    if !II || !II.isStr("intrinsic") {
        PP << PP << "riscv" << true << "'intrinsic'";
        return;
    }
    PP.Lex(Tok);
    II = Tok.getIdentifierInfo();
    if !II || !(II.isStr("vector") || II.isStr("sifive_vector") || II.isStr("andes_vector")) {
        PP << PP << "riscv" << true << "'vector', 'sifive_vector' or 'andes_vector'";
        return;
    }
    PP.Lex(Tok);
    if Tok.isNot(eod) {
        PP << "clang riscv intrinsic";
        return;
    }
    if II.isStr("vector") {
        self.Actions.RISCV().DeclareRVVBuiltins = true;
    } else if II.isStr("sifive_vector") {
        self.Actions.RISCV().DeclareSiFiveVectorBuiltins = true;
    } else if II.isStr("andes_vector") {
        self.Actions.RISCV().DeclareAndesVectorBuiltins = true;
    }
}

struct Closure_1 {
    cap_0: *mut Parser,
}

fn Closure_1::call(self: *Closure_1) {
        while self.Tok.isNot(eof) {
            self.PP.Lex(self.Tok);
        }
        self.PP.Lex(self.Tok);
    }

struct Closure_2 {
    cap_0: *mut Parser,
}

fn Closure_2::call(self: *Closure_2) {
        self.SkipUntil(eof, StopBeforeMatch);
        self.ConsumeToken();
    }

struct Closure_3 {
    Action: *mut PragmaMsStackAction,
    Alignment: *mut Token,
    Tok: *mut Token,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Literal: *u8) {
            (*self.Action) = PSK_Push_Set;
            (*self.Alignment) = (*self.Tok);
            (*self.Alignment).setKind(numeric_constant);
            (*self.Alignment).setLiteralData(Literal);
            (*self.Alignment).setLength(1);
        }
