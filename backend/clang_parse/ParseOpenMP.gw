fn ParseReductionId(P: *mut Parser, ReductionIdScopeSpec: *mut CXXScopeSpec, ReductionId: *mut UnqualifiedId) -> bool {
    if ReductionIdScopeSpec.isEmpty() {
        let mut OOK: OverloadedOperatorKind = OO_None;
        match P.getCurToken().getKind() {
            plus => {
                OOK = OO_Plus;
            },
            minus => {
                OOK = OO_Minus;
            },
            star => {
                OOK = OO_Star;
            },
            amp => {
                OOK = OO_Amp;
            },
            pipe => {
                OOK = OO_Pipe;
            },
            caret => {
                OOK = OO_Caret;
            },
            ampamp => {
                OOK = OO_AmpAmp;
            },
            pipepipe => {
                OOK = OO_PipePipe;
            },
            _ => {
                break;
            },
        }
        if OOK != OO_None {
            let mut OpLoc: SourceLocation = P.ConsumeToken();
            let mut SymbolLocations: [3]SourceLocation = [OpLoc, OpLoc, SourceLocation {}];
            ReductionId.setOperatorFunctionId(OpLoc, OOK, SymbolLocations);
            return false;
        }
    }
    return P.ParseUnqualifiedId;
}

