unsafe fn Closure_9::call(self: *mut Closure_9, SS: *mut CXXScopeSpec, NameInfo: DeclarationNameInfo) {
                let mut ND: *mut NamedDecl = self.Actions.OpenMP().lookupOpenMPDeclareTargetName(self.getCurScope(), SS, NameInfo);
                if !ND {
                    return;
                }
                let mut MI: MapInfo = MapInfo { self.MT, NameInfo.getLoc() };
                let mut FirstMapping: bool = (*self.DTCI).ExplicitlyMapped.try_emplace(ND, MI).second;
                if !FirstMapping {
                    self.Diag(NameInfo.getLoc(), err_omp_declare_target_multiple) << NameInfo.getName();
                }
            }

