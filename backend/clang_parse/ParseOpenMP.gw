unsafe fn Closure_14::call(self: *mut Closure_14, Type: u32, Modifier: u32, Loc: SourceLocation) {
            assert!(Type < NumberOfModifiers, "Unexpected modifier type");
            if !(*self.KLoc)[Type].isValid() {
                (*self.Arg)[Type] = Modifier;
                (*self.KLoc)[Type] = Loc;
            } else {
                self.Diag(Loc, err_omp_incompatible_dyn_groupprivate_modifier) << getOpenMPSimpleClauseTypeName(OMPC_dyn_groupprivate, Modifier) << getOpenMPSimpleClauseTypeName(OMPC_dyn_groupprivate, (*self.Arg)[Type]);
            }
        }
