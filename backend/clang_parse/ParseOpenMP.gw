    DKind: *mut OpenMPDirectiveKind,
}

unsafe fn Closure_10::call(self: *mut Closure_10) -> bool {
        if (*self.DKind) == OMPD_error {
            return true;
        }
        let mut Res: Category = getDirectiveCategory((*self.DKind));
        return Res == Executable || Res == Subsidiary;
    }

