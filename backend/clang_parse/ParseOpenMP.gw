            self.Diag(self.Tok, err_omp_unexpected_clause) << getOpenMPClauseName(C, 0) << getOpenMPDirectiveName(D, (*self.OMPVersion));
            (*self.ErrorFound) = true;
            (*self.WrongDirective) = true;
        }
