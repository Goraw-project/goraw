struct DeclDirectiveListParserHelper {
    Identifiers: SmallVector<Expr *, 4>,
    P: *mut Parser,
    Kind: i32,
}

fn DeclDirectiveListParserHelper::operator()(self, SS: *mut CXXScopeSpec, NameInfo: DeclarationNameInfo) {
    let mut Res: i32 = self.P.getActions().OpenMP();
}

fn DeclDirectiveListParserHelper::getIdentifiers(self: *DeclDirectiveListParserHelper) -> ArrayRef<Expr *> {}

fn checkOpenMPDirectiveName(P: *mut Parser, Loc: SourceLocation, Kind: i32, Name: str) -> i32 {
    let mut Version: u32 = P.getLangOpts();
    if Version as i32 <  {
        P << Name;
    }
    return ;
}

fn parseOpenMPDirectiveKind(P: *mut Parser) -> i32 {
    let mut DirParser: DirectiveNameParser = DirectiveNameParser {};
    let mut S: *State = DirParser.initial();
    let mut Tok: Token = P.getCurToken();
    let mut Concat: str = zeroed();
    let mut Loc: SourceLocation = Tok.getLocation();
    S = DirParser.consume(S);
    while !Tok.isAnnotation() {
        let mut DKind: i32 = S();
        Tok = P.getPreprocessor().LookAhead(0);
        if !Tok.isAnnotation() {
            let mut TS: str = zeroed();
            S = DirParser.consume(S);
            Concat() += ' ' + ;
            P.ConsumeToken();
        }
    }
    assert!(S, "Should have exited early");
}

fn parseOpenMPReductionId(P: *mut Parser) -> DeclarationName {
    let mut Tok: Token = P.getCurToken();
    let mut Actions: *mut Sema = P.getActions();
    let mut OOK: OverloadedOperatorKind = OO_None;
    let mut WithOperator: bool = false;
    if Tok.is(kw_operator) {
        P.ConsumeToken();
        Tok = P.getCurToken();
        WithOperator = true;
    }
    match Tok.getKind() {
        plus => {
            OOK = OO_Plus;
        },
        minus => {
            OOK = OO_Minus;
        },
        star => {
            OOK = OO_Star;
        },
        amp => {
            OOK = OO_Amp;
        },
        pipe => {
            OOK = OO_Pipe;
        },
        caret => {
            OOK = OO_Caret;
        },
        ampamp => {
            OOK = OO_AmpAmp;
        },
        pipepipe => {
            OOK = OO_PipePipe;
        },
        identifier => {
            if !WithOperator {
                break;
            }
        },
        _ => {
            P;
        },
    }
    P.ConsumeToken();
    let mut DeclNames: *mut auto = Actions.getASTContext();
    return if OOK == OO_None { (Tok.getIdentifierInfo()) } else { (OOK) };
}

fn Parser::ParseOpenMPDeclareReductionDirective(self, AS: AccessSpecifier) -> DeclGroupPtrTy {
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return ;
    }
    let mut Name: DeclarationName = parseOpenMPReductionId(*self);
    if Name.isEmpty() && self.Tok.is(annot_pragma_openmp_end) {
        return ;
    }
    let mut IsCorrect: bool = !self.ExpectAndConsume(colon, "");
    if !IsCorrect && self.Tok.is(annot_pragma_openmp_end) {
        return ;
    }
    IsCorrect = IsCorrect && !Name.isEmpty();
    if self.Tok.is(colon) || self.Tok.is(annot_pragma_openmp_end) {
        IsCorrect = false;
    }
    if !IsCorrect && self.Tok.is(annot_pragma_openmp_end) {
        return ;
    }
    let mut ReductionTypes: pair<QualType, SourceLocation>, 8> = zeroed();
    while true {
        {
        let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        let mut Range: SourceRange = SourceRange {};
        let mut TR: i32 = 0;
        if TR()() {
            let mut ReductionType: QualType = self.Actions.OpenMP()(Range.getBegin());
            if !ReductionType.isNull() {
                ReductionTypes();
            }
        } else {
            self.SkipUntil(comma, colon, annot_pragma_openmp_end, StopBeforeMatch);
        }
        if self.Tok.is(colon) || self.Tok.is(annot_pragma_openmp_end) {
            break;
        }
        if self.ExpectAndConsume(comma, "") {
            IsCorrect = false;
            if self.Tok.is(annot_pragma_openmp_end) {
                return ;
            }
        }
    }
        if !(self.Tok.isNot(annot_pragma_openmp_end)) { break; }
    }
    if ReductionTypes()() {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return ;
    }
    if !IsCorrect && self.Tok.is(annot_pragma_openmp_end) {
        return ;
    }
    if self.ExpectAndConsume(colon, "") {
        IsCorrect = false;
    }
    if self.Tok.is(annot_pragma_openmp_end) {
        return ;
    }
    let mut DRD: DeclGroupPtrTy = zeroed();
    let mut I: u32 = 0;
    let mut E: u32 = ();
    return self.Actions.OpenMP().ActOnOpenMPDeclareReductionDirectiveEnd(self.getCurScope(), IsCorrect);
}

fn Parser::ParseOpenMPReductionInitializerForDecl(self, OmpPrivParm: *mut VarDecl) {
    if self.isTokenEqualOrEqualTypo() {
        self.ConsumeToken();
        if self.Tok.is(code_completion) {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteInitializer;
            self.Actions.FinalizeDeclaration;
            return;
        }
        let mut Init: i32 = 0;
        if Init()() {
            self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
            self.Actions.ActOnInitializerError;
        } else {
            self.Actions.AddInitializerToDecl(OmpPrivParm, false);
        }
    } else if self.Tok.is(l_paren) {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        let mut Exprs: ExprVector = zeroed();
        let mut LParLoc: SourceLocation = T.getOpenLocation();
        let mut RunSignatureHelp: Closure_1 = Closure_1 { cap_0: self, OmpPrivParm: OmpPrivParm, cap_2: LParLoc };
        if self.ParseExpressionList(Closure_2 { cap_0: self, RunSignatureHelp: &mut RunSignatureHelp }) {
            if self.PP.isCodeCompletionReached() && !self.CalledSignatureHelp {
                RunSignatureHelp();
            }
            self.Actions.ActOnInitializerError;
            self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        } else {
            let mut RLoc: SourceLocation = self.Tok.getLocation();
            if !T.consumeClose() {
                RLoc = T.getCloseLocation();
            }
            let mut Initializer: i32 = self.Actions(T.getOpenLocation(), RLoc);
            self.Actions.AddInitializerToDecl(OmpPrivParm, true);
        }
    } else if self.getLangOpts() && self.Tok.is(l_brace) {
        let mut Init: i32 = 0;
        if Init()() {
            self.Actions.ActOnInitializerError;
        } else {
            self.Actions.AddInitializerToDecl(OmpPrivParm, true);
        }
    } else {
        self.Actions.ActOnUninitializedDecl;
    }
}

fn Parser::ParseOpenMPDeclareMapperDirective(self, AS: AccessSpecifier) -> DeclGroupPtrTy {
    let mut IsCorrect: bool = true;
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return ;
    }
    let mut DeclNames: *mut auto = self.Actions.getASTContext();
    let mut MapperId: DeclarationName = DeclarationName {};
    if self.PP.LookAhead(0).is(colon) {
        if self.Tok.isNot(identifier) && self.Tok.isNot(kw_default) {
            IsCorrect = false;
        } else {
            MapperId = (self.Tok.getIdentifierInfo());
        }
        self.ConsumeToken();
        self.ExpectAndConsume(colon, "");
    } else {
        MapperId = (&mut self.Actions.getASTContext().Idents.get("default"));
    }
    if !IsCorrect && self.Tok.is(annot_pragma_openmp_end) {
        return ;
    }
    let mut VName: DeclarationName = DeclarationName {};
    let mut MapperType: QualType = QualType {};
    let mut Range: SourceRange = SourceRange {};
    let mut ParsedType: i32 = 0;
    if ParsedType()() {
        MapperType = self.Actions.OpenMP()(Range.getBegin());
    }
    if MapperType.isNull() {
        IsCorrect = false;
    }
    if !IsCorrect {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return ;
    }
    IsCorrect &= !T.consumeClose();
    if !IsCorrect {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return ;
    }
    let mut OuterScope: *mut Scope = self.getCurScope();
    let mut DirName: DeclarationNameInfo = DeclarationNameInfo {};
    let mut Loc: SourceLocation = self.Tok.getLocation();
    let mut ScopeFlags: u32 = FnScope | DeclScope | CompoundStmtScope | OpenMPDirectiveScope;
    let mut OMPDirectiveScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    self.Actions.OpenMP();
    let mut MapperVarRef: i32 = self.Actions.OpenMP()(self.getCurScope(), MapperType, Range.getBegin(), VName);
    let mut Clauses: SmallVector<OMPClause *, 6> = zeroed();
    while self.Tok.isNot(annot_pragma_openmp_end) {
        let mut CKind: i32 = 0;
        self.Actions.OpenMP()();
        let mut Clause: *mut OMPClause = null;
        if Clause {
            Clauses()(Clause);
        } else {
            IsCorrect = false;
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
        self.Actions.OpenMP().EndOpenMPClause();
    }
    if Clauses()() {
         << getOpenMPDirectiveName(OMPVersion);
        IsCorrect = false;
    }
    let mut DG: DeclGroupPtrTy = zeroed();
    self.Actions.OpenMP().EndOpenMPDSABlock(null);
    OMPDirectiveScope.Exit();
    if !IsCorrect {
        return ;
    }
    return ;
}

fn Parser::parseOpenMPDeclareMapperVarDecl(self, Range: *mut SourceRange, Name: *mut DeclarationName, AS: AccessSpecifier) -> i32 {
    let mut DSC: DeclSpecContext = DSC_type_specifier;
    let mut DS: DeclSpec = zeroed();
    self.ParseSpecifierQualifierList(DS, AS, DSC);
    let mut Context: DeclaratorContext = Prototype;
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), Context };
    self.ParseDeclarator(DeclaratorInfo);
    Range = DeclaratorInfo.getSourceRange();
    if DeclaratorInfo.getIdentifier() == null {
        return true;
    }
    Name = self.Actions.GetNameForDeclarator(DeclaratorInfo).getName();
    return self.Actions.OpenMP()(self.getCurScope(), DeclaratorInfo);
}

fn Parser::ParseOpenMPDeclareBeginVariantDirective(self, Loc: SourceLocation) -> bool {
    let mut ParentTI: *mut OMPTraitInfo = self.Actions.OpenMP().getOMPTraitInfoForSurroundingScope();
    let mut ASTCtx: *mut ASTContext = self.Actions.getASTContext();
    let mut TI: *mut OMPTraitInfo = ASTCtx.getNewOMPTraitInfo();
    if self.parseOMPDeclareVariantMatchClause(Loc, TI, ParentTI) {
        while !self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch) {
            
        }
        self.ConsumeAnnotationToken() as void;
        return true;
    }
    let mut NormalScope: ParsingOpenMPDirectiveRAII = ParsingOpenMPDirectiveRAII { P: *self, OldVal: false };
    let mut VMI: VariantMatchInfo = VariantMatchInfo {};
    TI.getAsVariantMatchInfo(ASTCtx, VMI);
    let mut DiagUnknownTrait: function<void (StringRef)> = zeroed();
    let mut OMPCtx: TargetOMPContext = ASTCtx;
    if isVariantApplicableInContext(VMI, OMPCtx, true) {
        self.Actions.OpenMP().ActOnOpenMPBeginDeclareVariant(Loc, TI);
        return false;
    }
    let mut Nesting: u32 = 1;
    let mut DKLoc: SourceLocation = SourceLocation {};
    let mut DK: i32 = 0;
    while true {
        {
        DKLoc = self.Tok.getLocation();
        if  {
            Nesting -= 1;
        } else if  {
            Nesting += 1;
        }
        if !Nesting || self.isEofOrEom() {
            break;
        }
        self.ConsumeAnyToken(false);
    }
        if !(true) { break; }
    }
    return false;
}

struct FNContextRAII {
    P: *mut Parser,
    ThisScope: *mut CXXThisScopeRAII,
    Scopes: MultiParseScope,
    HasFunScope: bool,
}

fn FNContextRAII::FNContextRAII(self, P: *mut Parser, Ptr: DeclGroupPtrTy) {
    let mut D: *mut Decl = operator*(()());
    let mut ND: *mut NamedDecl = dyn_cast(D);
    let mut RD: *mut RecordDecl = dyn_cast_or_null(D.getDeclContext());
    let mut Actions: *mut Sema = P.getActions();
    P.ReenterTemplateScopes(self.Scopes, D);
    if D.isFunctionOrFunctionTemplate() {
        self.HasFunScope = true;
        self.Scopes.Enter(FnScope | DeclScope | CompoundStmtScope);
        Actions.ActOnReenterFunctionContext(Actions.getCurScope(), D);
    }
}

fn FNContextRAII::~FNContextRAII(self) {
    if self.HasFunScope {
        self.P.getActions().ActOnExitFunctionContext();
    }
    self.ThisScope;
}

fn parseDeclareSimdClauses(P: *mut Parser, BS: *mut i32, SimdLen: *mut i32, Uniforms: *mut SmallVectorImpl<Expr *>, Aligneds: *mut SmallVectorImpl<Expr *>, Alignments: *mut SmallVectorImpl<Expr *>, Linears: *mut SmallVectorImpl<Expr *>, LinModifiers: *mut SmallVectorImpl<unsigned int>, Steps: *mut SmallVectorImpl<Expr *>) -> bool {
    let mut BSRange: SourceRange = SourceRange {};
    let mut Tok: *Token = P.getCurToken();
    let mut IsError: bool = false;
    while Tok.isNot(annot_pragma_openmp_end) {
        if Tok.isNot(identifier) {
            break;
        }
        let mut Out: i32 = 0;
        let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
        let mut ClauseName: str = II.getName();
        if  {
            if  {
                IsError = true;
            }
            BS() = ;
            BSRange = SourceRange { B: Tok.getLocation(), E: Tok.getEndLoc() };
            P.ConsumeToken();
        } else if ClauseName == "simdlen" {
            if SimdLen()() {
                let mut OMPVersion: Version = P.getActions().getLangOpts().getOpenMPVersion();
                P << getOpenMPDirectiveName(OMPVersion) << ClauseName << 0;
                IsError = true;
            }
            P.ConsumeToken();
            let mut RLoc: SourceLocation = SourceLocation {};
            SimdLen() = P()(ClauseName, RLoc);
            if SimdLen()() {
                IsError = true;
            }
        } else {
            let mut CKind: i32 = getOpenMPClauseKind(ClauseName);
            if  {
                let mut Data: OpenMPVarListDataTy = OpenMPVarListDataTy {};
                let mut Vars: *mut SmallVectorImpl<Expr *> = &mut Uniforms;
                if  {
                    Vars = &mut Aligneds;
                } else if  {
                    Data() = OMPC_LINEAR_val;
                    Vars = &mut Linears;
                }
                P.ConsumeToken();
                if P() {
                    IsError = true;
                }
                if  {
                    Alignments()(Aligneds()() - Alignments()(), Data.DepModOrTailExpr);
                } else if  {
                    (((operator!(operator!((0 <= Data() && Data() <= OMPC_LINEAR_unknown && "Unexpected linear modifier.")))) || (_wassert(L"0 <= Data.ExtraModifier && Data.ExtraModifier <= OMPC_LINEAR_unknown && \"Unexpected linear modifier.\"", L"clang\\lib\\Parse\\ParseOpenMP.cpp", (724) as u32) , 0)) as void);
                    if P.getActions().OpenMP().CheckOpenMPLinearModifier(Data() as OpenMPLinearClauseKind, Data()) {
                        Data() = OMPC_LINEAR_val;
                    }
                    LinModifiers()(Linears()() - LinModifiers()(), Data());
                    Steps()(Linears()() - Steps()(), Data.DepModOrTailExpr);
                }
            } else {
                break;
            }
        }
        if Tok.is(comma) {
            P.ConsumeToken();
        }
    }
    return IsError;
}

fn Parser::ParseOMPDeclareSimdClauses(self, Ptr: DeclGroupPtrTy, Toks: *mut CachedTokens, Loc: SourceLocation) -> DeclGroupPtrTy {
    self.PP.EnterToken(self.Tok, true);
    self.PP;
    self.ConsumeAnyToken(true);
    self.ConsumeAnyToken(true);
    let mut FnContext: FNContextRAII = *self;
    let mut BS: i32 = 0;
    let mut Simdlen: i32 = 0;
    let mut Uniforms: SmallVector<Expr *, 4> = zeroed();
    let mut Aligneds: SmallVector<Expr *, 4> = zeroed();
    let mut Alignments: SmallVector<Expr *, 4> = zeroed();
    let mut Linears: SmallVector<Expr *, 4> = zeroed();
    let mut LinModifiers: SmallVector<unsigned int, 4> = zeroed();
    let mut Steps: SmallVector<Expr *, 4> = zeroed();
    let mut IsError: bool = false;
    let mut EndLoc: SourceLocation = self.ConsumeAnnotationToken();
    if IsError {
        return ;
    }
    return self.Actions.OpenMP()(SourceRange { B: Loc, E: EndLoc });
}

enum OMPContextLvl {
    CONTEXT_SELECTOR_SET_LVL = 0,
    CONTEXT_SELECTOR_LVL = 1,
    CONTEXT_TRAIT_LVL = 2,
}

fn stringLiteralParser(P: *mut Parser) -> str {
    let mut Res: i32 = P()(true);
    return if () { ()() } else { "" };
}

fn getNameFromIdOrString(P: *mut Parser, Tok: *mut Token, Lvl: OMPContextLvl) -> str {
    if Tok.is(identifier) || Tok.is(kw_for) {
        let mut Buffer: str = zeroed();
        let mut Name: str = P.getPreprocessor()(Tok);
        P.ConsumeToken() as void;
        return Name;
    }
    if isStringLiteral(Tok.getKind()) {
        return stringLiteralParser(P);
    }
    P << Lvl;
    return "";
}

fn checkForDuplicates(P: *mut Parser, Name: str, NameLoc: SourceLocation, Seen: *mut i32, Lvl: OMPContextLvl) -> bool {
    let mut Res: auto = (Name, NameLoc);
    if Res() {
        return false;
    }
    P << Lvl << Name;
    P << Lvl << Name;
    return true;
}

fn Parser::parseOMPTraitPropertyKind(self, TIProperty: *mut OMPTraitProperty, Set: TraitSet, Selector: TraitSelector, Seen: *mut i32) {
    TIProperty.Kind = invalid;
    let mut NameLoc: SourceLocation = self.Tok.getLocation();
    let mut Name: str = "";
    if Selector == target_device_device_num {
        Name = "number";
        TIProperty.Kind = getOpenMPContextTraitPropertyKind(Set, Selector, Name);
        let mut DeviceNumExprResult: i32 = 0;
        if DeviceNumExprResult()() {
            let mut DeviceNumExpr: *mut Expr = ();
            self.Actions.OpenMP().ActOnOpenMPDeviceNum(DeviceNumExpr);
        }
        return;
    }
    Name = getNameFromIdOrString(*self, self.Tok, CONTEXT_TRAIT_LVL);
    if Name.is_empty() {
         << CONTEXT_TRAIT_LVL << listOpenMPContextTraitProperties(Set, Selector);
        return;
    }
    TIProperty.RawString = Name;
    TIProperty.Kind = getOpenMPContextTraitPropertyKind(Set, Selector, Name);
    if TIProperty.Kind != invalid {
        if checkForDuplicates(*self, Name, NameLoc, CONTEXT_TRAIT_LVL) {
            TIProperty.Kind = invalid;
        }
        return;
    }
     << Name << getOpenMPContextTraitSelectorName(Selector) << getOpenMPContextTraitSetName(Set);
    let mut SetForName: TraitSet = getOpenMPContextTraitSetKind(Name);
    if SetForName != invalid {
         << Name << CONTEXT_SELECTOR_SET_LVL << CONTEXT_TRAIT_LVL;
         << Name << "<selector-name>" << "(<property-name>)";
        return;
    }
    let mut SelectorForName: TraitSelector = getOpenMPContextTraitSelectorKind(Name, SetForName);
    if SelectorForName != invalid {
         << Name << CONTEXT_SELECTOR_LVL << CONTEXT_TRAIT_LVL;
        let mut AllowsTraitScore: bool = false;
        let mut RequiresProperty: bool = false;
        isValidTraitSelectorForTraitSet(SelectorForName, getOpenMPContextTraitSetForSelector(SelectorForName), AllowsTraitScore, RequiresProperty);
         << getOpenMPContextTraitSetName(getOpenMPContextTraitSetForSelector(SelectorForName)) << Name << (if RequiresProperty { "(<property-name>)" } else { "" });
        return;
    }
     << CONTEXT_TRAIT_LVL << listOpenMPContextTraitProperties(Set, Selector);
}

fn checkExtensionProperty(P: *mut Parser, Loc: SourceLocation, TIProperty: *mut OMPTraitProperty, TISelector: *mut OMPTraitSelector, Seen: *mut i32) -> bool {
    assert!(TISelector.Kind == implementation_extension, "Only for extension properties, e.g., `implementation={extension(PROPERTY)}`");
    if TIProperty.Kind == invalid {
        return false;
    }
    if TIProperty.Kind == implementation_extension_disable_implicit_base {
        return true;
    }
    if TIProperty.Kind == implementation_extension_allow_templates {
        return true;
    }
    if TIProperty.Kind == implementation_extension_bind_to_declaration {
        return true;
    }
    let mut IsMatchExtension: Closure_3 = Closure_3 {};
    if IsMatchExtension.call(TIProperty) {
        return true;
    }
    llvm_unreachable_internal("Unknown extension property!", "clang\\lib\\Parse\\ParseOpenMP.cpp", 956);
}

fn Parser::parseOMPContextProperty(self, TISelector: *mut OMPTraitSelector, Set: TraitSet, Seen: *mut i32) {
    assert!(TISelector.Kind != user_condition, "User conditions are special properties not handled here!");
    let mut PropertyLoc: SourceLocation = self.Tok.getLocation();
    let mut TIProperty: OMPTraitProperty = OMPTraitProperty {};
    if TISelector.Kind == implementation_extension {
        if  {
            TIProperty.Kind = invalid;
        }
    }
    if TIProperty.Kind == invalid {
        if PropertyLoc != self.Tok.getLocation() {
            << CONTEXT_TRAIT_LVL;
        }
        return;
    }
    if isValidTraitPropertyForTraitSetAndSelector(TIProperty.Kind, TISelector.Kind, Set) {
        TISelector()(TIProperty);
        return;
    }
     << getOpenMPContextTraitPropertyName(TIProperty.Kind, TIProperty.RawString) << getOpenMPContextTraitSelectorName(TISelector.Kind) << getOpenMPContextTraitSetName(Set);
     << getOpenMPContextTraitPropertyName(TIProperty.Kind, TIProperty.RawString) << getOpenMPContextTraitSelectorName(getOpenMPContextTraitSelectorForProperty(TIProperty.Kind)) << getOpenMPContextTraitSetName(getOpenMPContextTraitSetForProperty(TIProperty.Kind));
     << CONTEXT_TRAIT_LVL;
}

fn Parser::parseOMPTraitSelectorKind(self, TISelector: *mut OMPTraitSelector, Set: TraitSet, Seen: *mut i32) {
    TISelector.Kind = invalid;
    let mut NameLoc: SourceLocation = self.Tok.getLocation();
    let mut Name: str = getNameFromIdOrString(*self, self.Tok, CONTEXT_SELECTOR_LVL);
    if Name.is_empty() {
         << CONTEXT_SELECTOR_LVL << listOpenMPContextTraitSelectors(Set);
        return;
    }
    TISelector.Kind = getOpenMPContextTraitSelectorKind(Name, Set);
    if TISelector.Kind != invalid {
        if checkForDuplicates(*self, Name, NameLoc, CONTEXT_SELECTOR_LVL) {
            TISelector.Kind = invalid;
        }
        return;
    }
     << Name << getOpenMPContextTraitSetName(Set);
    let mut SetForName: TraitSet = getOpenMPContextTraitSetKind(Name);
    if SetForName != invalid {
         << Name << CONTEXT_SELECTOR_SET_LVL << CONTEXT_SELECTOR_LVL;
         << Name << "<selector-name>" << "<property-name>";
        return;
    }
     << CONTEXT_SELECTOR_LVL << listOpenMPContextTraitSelectors(Set);
}

fn parseContextScore(P: *mut Parser) -> i32 {
    let mut ScoreExpr: i32 = 0;
    let mut Buffer: str = zeroed();
    let mut SelectorName: str = P.getPreprocessor()(P.getCurToken());
    if SelectorName != "score" {
        return ;
    }
    P.ConsumeToken() as void;
    let mut RLoc: SourceLocation = SourceLocation {};
    ScoreExpr() = P()(SelectorName, RLoc);
    if P.getCurToken().is(colon) {
        P.ConsumeAnyToken(false) as void;
    } else {
        P << "':'" << "score expression";
    }
    return ;
}

fn Parser::parseOMPContextSelector(self, TISelector: *mut OMPTraitSelector, Set: TraitSet, SeenSelectors: *mut i32) {
    let mut OuterPC: u16 = self.ParenCount;
    let mut FinishSelector: Closure_4 = Closure_4 { OuterPC: OuterPC, cap_1: self };
    let mut SelectorLoc: SourceLocation = self.Tok.getLocation();
    if TISelector.Kind == invalid {
        return FinishSelector.call();
    }
    let mut AllowsTraitScore: bool = false;
    let mut RequiresProperty: bool = false;
    if !isValidTraitSelectorForTraitSet(TISelector.Kind, Set, AllowsTraitScore, RequiresProperty) {
         << getOpenMPContextTraitSelectorName(TISelector.Kind) << getOpenMPContextTraitSetName(Set);
