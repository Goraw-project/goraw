fn Closure_7::call(self: *Closure_7, Spelling: str, IssueNote: bool) {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
        if T.expectAndConsume(err_expected_lparen_after, Spelling.ptr, unknown) {
            return;
        }
        T.skipToEnd();
        if IssueNote && T.getCloseLocation().isValid() {
            self.Diag(T.getCloseLocation(), note_omp_assumption_clause_continue_here);
        }
    }

struct Closure_8 {}

fn Closure_8::call(self: *Closure_8, RawString: str) -> i32 {
        let mut SS: StringSwitch<int> = RawString;
        let mut ACMIdx: u32 = 0;
        for ACMI in AssumptionClauseMappings[..] {
            if ACMI.StartsWith {
                SS.StartsWith(ACMI.Identifier, ACMIdx += 1);
            } else {
                SS.Case(ACMI.Identifier, ACMIdx += 1);
            }
        }
        return SS.Default(-1);
    }

