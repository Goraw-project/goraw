struct SimpleClauseData {
    Type: u32,
    Loc: SourceLocation,
    LOpen: SourceLocation,
    TypeLoc: SourceLocation,
    RLoc: SourceLocation,
}

fn parseOpenMPSimpleClause(P: *mut Parser, Kind: i32) -> optional<SimpleClauseData> {
    let mut Tok: *Token = P.getCurToken();
    let mut Loc: SourceLocation = Tok.getLocation();
    let mut LOpen: SourceLocation = P.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { P, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume {
        return nullopt();
    }
    let mut Type: u32 = 0;
    let mut TypeLoc: SourceLocation = Tok.getLocation();
    if Tok.isNot(r_paren) && Tok.isNot(comma) && Tok.isNot(annot_pragma_openmp_end) {
        P.ConsumeAnyToken(false);
    }
    let mut RLoc: SourceLocation = Tok.getLocation();
    if !T.consumeClose() {
        RLoc = T.getCloseLocation();
    }
    return SimpleClauseData { Type: Type, Loc: Loc, LOpen: LOpen, TypeLoc: TypeLoc, RLoc: RLoc };
}

