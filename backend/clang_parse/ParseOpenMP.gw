struct DeclDirectiveListParserHelper {
    Identifiers: SmallVector<Expr *, 4>,
    P: *mut Parser,
    Kind: OpenMPDirectiveKind,
}

fn DeclDirectiveListParserHelper::operator()(self, SS: *mut CXXScopeSpec, NameInfo: DeclarationNameInfo) {
    let mut Res: ExprResult = self.P.getActions().OpenMP().ActOnOpenMPIdExpression(self.P.getCurScope(), SS, NameInfo, self.Kind);
    if Res.isUsable() {
        self.Identifiers.push(Res.get());
    }
}

fn DeclDirectiveListParserHelper::getIdentifiers(self: *DeclDirectiveListParserHelper) -> ArrayRef<Expr *> {
    return self.Identifiers;
}

fn checkOpenMPDirectiveName(P: *mut Parser, Loc: SourceLocation, Kind: OpenMPDirectiveKind, Name: str) -> OpenMPDirectiveKind {
    let mut Version: u32 = P.getLangOpts().OpenMP;
    if D == OMPD_ordered_blockassoc {
        D = OMPD_ordered_standalone;
    }
    assert!(D == Kind, "Directive kind mismatch");
    if Version as i32 < VR.Min {
        P.Diag(Loc, warn_omp_future_directive_spelling) << Name;
    }
    return Kind;
}

fn parseOpenMPDirectiveKind(P: *mut Parser) -> OpenMPDirectiveKind {
    let mut DirParser: DirectiveNameParser = C;
    let mut S: *State = DirParser.initial();
    let mut Tok: Token = P.getCurToken();
    if Tok.isAnnotation() {
        return OMPD_unknown;
    }
    let mut Concat: str = P.getPreprocessor().getSpelling(Tok, null);
    let mut Loc: SourceLocation = Tok.getLocation();
    S = DirParser.consume(S, Concat);
    if S == null {
        return OMPD_unknown;
    }
    while !Tok.isAnnotation() {
        let mut DKind: OpenMPDirectiveKind = S.Value;
        Tok = P.getPreprocessor().LookAhead(0);
        if !Tok.isAnnotation() {
            let mut TS: str = P.getPreprocessor().getSpelling(Tok, null);
            S = DirParser.consume(S, TS);
            if S == null {
                return checkOpenMPDirectiveName(P, Loc, DKind, Concat);
            }
            operator(Concat, ' ' + TS);
            P.ConsumeToken();
        }
    }
    assert!(S, "Should have exited early");
    return checkOpenMPDirectiveName(P, Loc, S.Value, Concat);
}

fn parseOpenMPReductionId(P: *mut Parser) -> DeclarationName {
    let mut Tok: Token = P.getCurToken();
    let mut Actions: *mut Sema = P.getActions();
    let mut OOK: OverloadedOperatorKind = OO_None;
    let mut WithOperator: bool = false;
    if Tok.is(kw_operator) {
        P.ConsumeToken();
        Tok = P.getCurToken();
        WithOperator = true;
    }
    match Tok.getKind() {
        plus => {
            OOK = OO_Plus;
        },
        minus => {
            OOK = OO_Minus;
        },
        star => {
            OOK = OO_Star;
        },
        amp => {
            OOK = OO_Amp;
        },
        pipe => {
            OOK = OO_Pipe;
        },
        caret => {
            OOK = OO_Caret;
        },
        ampamp => {
            OOK = OO_AmpAmp;
        },
        pipepipe => {
            OOK = OO_PipePipe;
        },
        identifier => {
            if !WithOperator {
                break;
            }
        },
        _ => {
            P.Diag(Tok.getLocation(), err_omp_expected_reduction_identifier);
        },
    }
    P.ConsumeToken();
    let mut DeclNames: *mut DeclarationNameTable = Actions.getASTContext().DeclarationNames;
    return if OOK == OO_None { DeclNames.getIdentifier(Tok.getIdentifierInfo()) } else { DeclNames.getCXXOperatorName(OOK) };
}

fn Parser::ParseOpenMPDeclareReductionDirective(self, AS: AccessSpecifier) -> DeclGroupPtrTy {
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPDirectiveName(OMPD_declare_reduction, OMPVersion).ptr, unknown) {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return DeclGroupPtrTy { null };
    }
    let mut Name: DeclarationName = parseOpenMPReductionId(*self);
    if Name.isEmpty() && self.Tok.is(annot_pragma_openmp_end) {
        return DeclGroupPtrTy { null };
    }
    let mut IsCorrect: bool = !self.ExpectAndConsume(colon, err_expected, "");
    if !IsCorrect && self.Tok.is(annot_pragma_openmp_end) {
        return DeclGroupPtrTy { null };
    }
    IsCorrect = IsCorrect && !Name.isEmpty();
    if self.Tok.is(colon) || self.Tok.is(annot_pragma_openmp_end) {
        self.Diag(self.Tok.getLocation(), err_expected_type);
        IsCorrect = false;
    }
    if !IsCorrect && self.Tok.is(annot_pragma_openmp_end) {
        return DeclGroupPtrTy { null };
    }
    let mut ReductionTypes: pair<QualType, SourceLocation>, 8> = pair<QualType, SourceLocation>, 8> {};
    while true {
        {
        let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        let mut Range: SourceRange = SourceRange {};
        let mut TR: TypeResult = self.ParseTypeName(&mut Range, Prototype, AS, null, null);
        if TR.isUsable() {
            let mut ReductionType: QualType = self.Actions.OpenMP().ActOnOpenMPDeclareReductionType(Range.getBegin(), TR);
            if !ReductionType.isNull() {
                ReductionTypes.push(make_pair(ReductionType, Range.getBegin()));
            }
        } else {
            self.SkipUntil(comma, colon, annot_pragma_openmp_end, StopBeforeMatch);
        }
        if self.Tok.is(colon) || self.Tok.is(annot_pragma_openmp_end) {
            break;
        }
        if self.ExpectAndConsume(comma, err_expected, "") {
            IsCorrect = false;
            if self.Tok.is(annot_pragma_openmp_end) {
                self.Diag(self.Tok.getLocation(), err_expected_type);
                return DeclGroupPtrTy { null };
            }
        }
    }
        if !(self.Tok.isNot(annot_pragma_openmp_end)) { break; }
    }
    if ReductionTypes.is_empty() {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return DeclGroupPtrTy { null };
    }
    if !IsCorrect && self.Tok.is(annot_pragma_openmp_end) {
        return DeclGroupPtrTy { null };
    }
    if self.ExpectAndConsume(colon, err_expected, "") {
        IsCorrect = false;
    }
    if self.Tok.is(annot_pragma_openmp_end) {
        self.Diag(self.Tok.getLocation(), err_expected_expression);
        return DeclGroupPtrTy { null };
    }
    let mut DRD: DeclGroupPtrTy = self.Actions.OpenMP().ActOnOpenMPDeclareReductionDirectiveStart(self.getCurScope(), self.Actions.getCurLexicalContext(), Name, ReductionTypes, AS, null);
    let mut I: u32 = 0;
    let mut E: u32 = ReductionTypes.len;
    for D in DRD.get() {
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        let mut OMPDRScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope | OpenMPDirectiveScope, true, false };
        self.Actions.OpenMP().ActOnOpenMPDeclareReductionCombinerStart(self.getCurScope(), D);
        let mut CombinerResult: ExprResult = self.Actions.ActOnFinishFullExpr(self.ParseExpression(AllowNonTypes).get(), D.getLocation(), false, false, false);
        self.Actions.OpenMP().ActOnOpenMPDeclareReductionCombinerEnd(D, CombinerResult.get());
        if CombinerResult.isInvalid() && self.Tok.isNot(r_paren) && self.Tok.isNot(annot_pragma_openmp_end) {
            TPA.Commit();
            IsCorrect = false;
            break;
        }
        IsCorrect = !T.consumeClose() && IsCorrect && CombinerResult.isUsable();
        let mut InitializerResult: ExprResult = false;
        if self.Tok.isNot(annot_pragma_openmp_end) {
            if self.Tok.is(identifier) && self.Tok.getIdentifierInfo().isStr("initializer") {
                self.ConsumeToken();
            } else {
                self.Diag(self.Tok.getLocation(), err_expected) << "'initializer'";
                TPA.Commit();
                IsCorrect = false;
                break;
            }
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
            IsCorrect = !T.expectAndConsume(err_expected_lparen_after, "initializer", unknown) && IsCorrect;
            if self.Tok.isNot(annot_pragma_openmp_end) {
                let mut OMPDRScope: ParseScope = ParseScope { self, FnScope | DeclScope | CompoundStmtScope | OpenMPDirectiveScope, true, false };
                let mut OmpPrivParm: *mut VarDecl = self.Actions.OpenMP().ActOnOpenMPDeclareReductionInitializerStart(self.getCurScope(), D);
                if self.Tok.is(identifier) && self.Tok.getIdentifierInfo().isStr("omp_priv") {
                    self.ConsumeToken();
                    self.ParseOpenMPReductionInitializerForDecl(OmpPrivParm);
                } else {
                    InitializerResult = self.Actions.ActOnFinishFullExpr(self.ParseAssignmentExpression(AllowNonTypes).get(), D.getLocation(), false, false, false);
                }
                self.Actions.OpenMP().ActOnOpenMPDeclareReductionInitializerEnd(D, InitializerResult.get(), OmpPrivParm);
                if InitializerResult.isInvalid() && self.Tok.isNot(r_paren) && self.Tok.isNot(annot_pragma_openmp_end) {
                    TPA.Commit();
                    IsCorrect = false;
                    break;
                }
                IsCorrect = !T.consumeClose() && IsCorrect && !InitializerResult.isInvalid();
            }
        }
        I += 1;
        if I != E {
            TPA.Revert();
        } else {
            TPA.Commit();
        }
    }
    return self.Actions.OpenMP().ActOnOpenMPDeclareReductionDirectiveEnd(self.getCurScope(), DRD, IsCorrect);
}

fn Parser::ParseOpenMPReductionInitializerForDecl(self, OmpPrivParm: *mut VarDecl) {
    if self.isTokenEqualOrEqualTypo() {
        self.ConsumeToken();
        if self.Tok.is(code_completion) {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteInitializer(self.getCurScope(), OmpPrivParm);
            self.Actions.FinalizeDeclaration(OmpPrivParm);
            return;
        }
        self.PreferredType.enterVariableInit(self.Tok.getLocation(), OmpPrivParm);
        let mut Init: ExprResult = self.ParseInitializer(OmpPrivParm);
        if Init.isInvalid() {
            self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
            self.Actions.ActOnInitializerError(OmpPrivParm);
        } else {
            self.Actions.AddInitializerToDecl(OmpPrivParm, Init.get(), false);
        }
    } else if self.Tok.is(l_paren) {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        let mut Exprs: ExprVector = ExprVector {};
        let mut LParLoc: SourceLocation = T.getOpenLocation();
        let mut RunSignatureHelp: Closure_1 = Closure_1 { cap_0: self, OmpPrivParm: OmpPrivParm, cap_2: LParLoc, Exprs: &mut Exprs };
        if self.ParseExpressionList(Exprs, function_ref<void ()> { Closure_2 { cap_0: self, RunSignatureHelp: &mut RunSignatureHelp }, null, null }, false, false) {
            if self.PP.isCodeCompletionReached() && !self.CalledSignatureHelp {
                RunSignatureHelp.call();
            }
            self.Actions.ActOnInitializerError(OmpPrivParm);
            self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        } else {
            let mut RLoc: SourceLocation = self.Tok.getLocation();
            if !T.consumeClose() {
                RLoc = T.getCloseLocation();
            }
            let mut Initializer: ExprResult = self.Actions.ActOnParenListExpr(T.getOpenLocation(), RLoc, Exprs);
            self.Actions.AddInitializerToDecl(OmpPrivParm, Initializer.get(), true);
        }
    } else if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
        self.Diag(self.Tok, compat_cxx11_generalized_initializer_lists);
        let mut Init: ExprResult = self.ParseBraceInitializer();
        if Init.isInvalid() {
            self.Actions.ActOnInitializerError(OmpPrivParm);
        } else {
            self.Actions.AddInitializerToDecl(OmpPrivParm, Init.get(), true);
        }
    } else {
        self.Actions.ActOnUninitializedDecl(OmpPrivParm);
    }
}

fn Parser::ParseOpenMPDeclareMapperDirective(self, AS: AccessSpecifier) -> DeclGroupPtrTy {
    let mut IsCorrect: bool = true;
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPDirectiveName(OMPD_declare_mapper, OMPVersion).ptr, unknown) {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return DeclGroupPtrTy { null };
    }
    let mut DeclNames: *mut DeclarationNameTable = self.Actions.getASTContext().DeclarationNames;
    let mut MapperId: DeclarationName = DeclarationName {};
    if self.PP.LookAhead(0).is(colon) {
        if self.Tok.isNot(identifier) && self.Tok.isNot(kw_default) {
            self.Diag(self.Tok.getLocation(), err_omp_mapper_illegal_identifier);
            IsCorrect = false;
        } else {
            MapperId = DeclNames.getIdentifier(self.Tok.getIdentifierInfo());
        }
        self.ConsumeToken();
        self.ExpectAndConsume(colon, err_expected, "");
    } else {
        MapperId = DeclNames.getIdentifier(&mut self.Actions.getASTContext().Idents.get("default"));
    }
    if !IsCorrect && self.Tok.is(annot_pragma_openmp_end) {
        return DeclGroupPtrTy { null };
    }
    let mut VName: DeclarationName = DeclarationName {};
    let mut MapperType: QualType = QualType {};
    let mut Range: SourceRange = SourceRange {};
    let mut ParsedType: TypeResult = self.parseOpenMPDeclareMapperVarDecl(Range, VName, AS);
    if ParsedType.isUsable() {
        MapperType = self.Actions.OpenMP().ActOnOpenMPDeclareMapperType(Range.getBegin(), ParsedType);
    }
    if MapperType.isNull() {
        IsCorrect = false;
    }
    if !IsCorrect {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return DeclGroupPtrTy { null };
    }
    IsCorrect &= !T.consumeClose();
    if !IsCorrect {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
        return DeclGroupPtrTy { null };
    }
    let mut OuterScope: *mut Scope = self.getCurScope();
    let mut DirName: DeclarationNameInfo = DeclarationNameInfo {};
    let mut Loc: SourceLocation = self.Tok.getLocation();
    let mut ScopeFlags: u32 = FnScope | DeclScope | CompoundStmtScope | OpenMPDirectiveScope;
    let mut OMPDirectiveScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    self.Actions.OpenMP().StartOpenMPDSABlock(OMPD_declare_mapper, DirName, self.getCurScope(), Loc);
    let mut MapperVarRef: ExprResult = self.Actions.OpenMP().ActOnOpenMPDeclareMapperDirectiveVarDecl(self.getCurScope(), MapperType, Range.getBegin(), VName);
    let mut Clauses: SmallVector<OMPClause *, 6> = SmallVector<OMPClause *, 6> {};
    while self.Tok.isNot(annot_pragma_openmp_end) {
        let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
        self.Actions.OpenMP().StartOpenMPClause(CKind);
        let mut Clause: *mut OMPClause = self.ParseOpenMPClause(OMPD_declare_mapper, CKind, Clauses.is_empty());
        if Clause {
            Clauses.push(Clause);
        } else {
            IsCorrect = false;
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
        self.Actions.OpenMP().EndOpenMPClause();
    }
    if Clauses.is_empty() {
        self.Diag(self.Tok, err_omp_expected_clause) << getOpenMPDirectiveName(OMPD_declare_mapper, OMPVersion);
        IsCorrect = false;
    }
    let mut DG: DeclGroupPtrTy = self.Actions.OpenMP().ActOnOpenMPDeclareMapperDirective(OuterScope, self.Actions.getCurLexicalContext(), MapperId, MapperType, Range.getBegin(), VName, AS, MapperVarRef.get(), Clauses, null);
    self.Actions.OpenMP().EndOpenMPDSABlock(null);
    OMPDirectiveScope.Exit();
    if !IsCorrect {
        return DeclGroupPtrTy { null };
    }
    return DG;
}

fn Parser::parseOpenMPDeclareMapperVarDecl(self, Range: *mut SourceRange, Name: *mut DeclarationName, AS: AccessSpecifier) -> TypeResult {
    let mut DSC: DeclSpecContext = DSC_type_specifier;
    let mut DS: DeclSpec = self.AttrFactory;
    self.ParseSpecifierQualifierList(DS, AS, DSC);
    let mut Context: DeclaratorContext = Prototype;
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), Context };
    self.ParseDeclarator(DeclaratorInfo);
    Range = DeclaratorInfo.getSourceRange();
    if DeclaratorInfo.getIdentifier() == null {
        self.Diag(self.Tok.getLocation(), err_omp_mapper_expected_declarator);
        return true;
    }
    Name = self.Actions.GetNameForDeclarator(DeclaratorInfo).getName();
    return self.Actions.OpenMP().ActOnOpenMPDeclareMapperVarDecl(self.getCurScope(), DeclaratorInfo);
}

fn Parser::ParseOpenMPDeclareBeginVariantDirective(self, Loc: SourceLocation) -> bool {
    let mut ParentTI: *mut OMPTraitInfo = self.Actions.OpenMP().getOMPTraitInfoForSurroundingScope();
    let mut ASTCtx: *mut ASTContext = self.Actions.getASTContext();
    let mut TI: *mut OMPTraitInfo = ASTCtx.getNewOMPTraitInfo();
    if self.parseOMPDeclareVariantMatchClause(Loc, TI, ParentTI) {
        while !self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch) {
            
        }
        self.ConsumeAnnotationToken() as void;
        return true;
    }
    self.skipUntilPragmaOpenMPEnd(OMPD_begin_declare_variant);
    let mut NormalScope: ParsingOpenMPDirectiveRAII = ParsingOpenMPDirectiveRAII { P: *self, OldVal: false };
    let mut VMI: VariantMatchInfo = VariantMatchInfo {};
    TI.getAsVariantMatchInfo(ASTCtx, VMI);
    let mut DiagUnknownTrait: function<void (StringRef)> = Closure_3 { cap_0: self, cap_1: Loc };
    let mut OMPCtx: TargetOMPContext = TargetOMPContext { ActiveTraits: ASTCtx, ConstructTraits: move(DiagUnknownTrait), FeatureValidityCheck: null, DiagUnknownTrait: TraitProperty> {}, FeatureMap: self.Actions.OpenMP().getOpenMPDeviceNum() };
    if isVariantApplicableInContext(VMI, OMPCtx, true) {
        self.Actions.OpenMP().ActOnOpenMPBeginDeclareVariant(Loc, TI);
        return false;
    }
    let mut Nesting: u32 = 1;
    let mut DKLoc: SourceLocation = SourceLocation {};
    let mut DK: OpenMPDirectiveKind = OMPD_unknown;
    while true {
        {
        DKLoc = self.Tok.getLocation();
        DK = parseOpenMPDirectiveKind(*self);
        if DK == OMPD_end_declare_variant {
            Nesting -= 1;
        } else if DK == OMPD_begin_declare_variant {
            Nesting += 1;
        }
        if !Nesting || self.isEofOrEom() {
            break;
        }
        self.ConsumeAnyToken(false);
    }
        if !(true) { break; }
    }
    self.parseOMPEndDirective(OMPD_begin_declare_variant, OMPD_end_declare_variant, DK, Loc, DKLoc, true);
    return false;
}

struct FNContextRAII {
    P: *mut Parser,
    ThisScope: *mut CXXThisScopeRAII,
    Scopes: MultiParseScope,
    HasFunScope: bool,
}

fn FNContextRAII::FNContextRAII(self, P: *mut Parser, Ptr: DeclGroupPtrTy) {
    let mut D: *mut Decl = *Ptr.get().begin();
    let mut ND: *mut NamedDecl = dyn_cast(D);
    let mut RD: *mut RecordDecl = dyn_cast_or_null(D.getDeclContext());
    let mut Actions: *mut Sema = P.getActions();
    self.ThisScope = CXXThisScopeRAII { Actions, RD, Qualifiers {}, ND && ND.isCXXInstanceMember() };
    P.ReenterTemplateScopes(self.Scopes, D);
    if D.isFunctionOrFunctionTemplate() {
        self.HasFunScope = true;
        self.Scopes.Enter(FnScope | DeclScope | CompoundStmtScope);
        Actions.ActOnReenterFunctionContext(Actions.getCurScope(), D);
    }
}

fn FNContextRAII::~FNContextRAII(self) {
    if self.HasFunScope {
        self.P.getActions().ActOnExitFunctionContext();
    }
    self.ThisScope;
}

fn parseDeclareSimdClauses(P: *mut Parser, BS: *mut BranchStateTy, SimdLen: *mut ExprResult, Uniforms: *mut SmallVectorImpl<Expr *>, Aligneds: *mut SmallVectorImpl<Expr *>, Alignments: *mut SmallVectorImpl<Expr *>, Linears: *mut SmallVectorImpl<Expr *>, LinModifiers: *mut SmallVectorImpl<unsigned int>, Steps: *mut SmallVectorImpl<Expr *>) -> bool {
    let mut BSRange: SourceRange = SourceRange {};
    let mut Tok: *Token = P.getCurToken();
    let mut IsError: bool = false;
    while Tok.isNot(annot_pragma_openmp_end) {
        if Tok.isNot(identifier) {
            break;
        }
        let mut Out: BranchStateTy = zeroed();
        let mut II: *mut IdentifierInfo = Tok.getIdentifierInfo();
        let mut ClauseName: str = II.getName();
        if ConvertStrToBranchStateTy(ClauseName, Out) {
            if BS != BS_Undefined && BS != Out {
                P.Diag(Tok, err_omp_declare_simd_inbranch_notinbranch) << ClauseName << ConvertBranchStateTyToStr(BS) << BSRange;
                IsError = true;
            }
            BS = Out;
            BSRange = SourceRange { B: Tok.getLocation(), E: Tok.getEndLoc() };
            P.ConsumeToken();
        } else if ClauseName == "simdlen" {
            if SimdLen.isUsable() {
                let mut OMPVersion: Version = P.getActions().getLangOpts().getOpenMPVersion();
                P.Diag(Tok, err_omp_more_one_clause) << getOpenMPDirectiveName(OMPD_declare_simd, OMPVersion) << ClauseName << 0;
                IsError = true;
            }
            P.ConsumeToken();
            let mut RLoc: SourceLocation = SourceLocation {};
            SimdLen = P.ParseOpenMPParensExpr(ClauseName, RLoc, false);
            if SimdLen.isInvalid() {
                IsError = true;
            }
        } else {
            let mut CKind: OpenMPClauseKind = getOpenMPClauseKind(ClauseName);
            if CKind == OMPC_uniform || CKind == OMPC_aligned || CKind == OMPC_linear {
                let mut Data: OpenMPVarListDataTy = OpenMPVarListDataTy {};
                let mut Vars: *mut SmallVectorImpl<Expr *> = &mut Uniforms;
                if CKind == OMPC_aligned {
                    Vars = &mut Aligneds;
                } else if CKind == OMPC_linear {
                    Data.ExtraModifier = OMPC_LINEAR_val;
                    Vars = &mut Linears;
                }
                P.ConsumeToken();
                if P.ParseOpenMPVarList(OMPD_declare_simd, getOpenMPClauseKind(ClauseName), *Vars, Data) {
                    IsError = true;
                }
                if CKind == OMPC_aligned {
                    Alignments.append(Aligneds.len - Alignments.len, Data.DepModOrTailExpr);
                } else if CKind == OMPC_linear {
                    assert!(0 <= Data.ExtraModifier && Data.ExtraModifier <= OMPC_LINEAR_unknown, "Unexpected linear modifier.");
                    if P.getActions().OpenMP().CheckOpenMPLinearModifier(Data.ExtraModifier as OpenMPLinearClauseKind, Data.ExtraModifierLoc) {
                        Data.ExtraModifier = OMPC_LINEAR_val;
                    }
                    LinModifiers.append(Linears.len - LinModifiers.len, Data.ExtraModifier);
                    Steps.append(Linears.len - Steps.len, Data.DepModOrTailExpr);
                }
            } else {
                break;
            }
        }
        if Tok.is(comma) {
            P.ConsumeToken();
        }
    }
    return IsError;
}

fn Parser::ParseOMPDeclareSimdClauses(self, Ptr: DeclGroupPtrTy, Toks: *mut CachedTokens, Loc: SourceLocation) -> DeclGroupPtrTy {
    self.PP.EnterToken(self.Tok, true);
    self.PP.EnterTokenStream(Toks, true, true);
    self.ConsumeAnyToken(true);
    self.ConsumeAnyToken(true);
    let mut FnContext: FNContextRAII = FNContextRAII { *self, Ptr };
    let mut BS: BranchStateTy = BS_Undefined;
    let mut Simdlen: ExprResult = false;
    let mut Uniforms: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
    let mut Aligneds: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
    let mut Alignments: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
    let mut Linears: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
    let mut LinModifiers: SmallVector<unsigned int, 4> = SmallVector<unsigned int, 4> {};
    let mut Steps: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
    let mut IsError: bool = parseDeclareSimdClauses(*self, BS, Simdlen, Uniforms, Aligneds, Alignments, Linears, LinModifiers, Steps);
    self.skipUntilPragmaOpenMPEnd(OMPD_declare_simd);
    let mut EndLoc: SourceLocation = self.ConsumeAnnotationToken();
    if IsError {
        return Ptr;
    }
    return self.Actions.OpenMP().ActOnOpenMPDeclareSimdDirective(Ptr, BS, Simdlen.get(), Uniforms, Aligneds, Alignments, Linears, LinModifiers, Steps, SourceRange { B: Loc, E: EndLoc });
}

enum OMPContextLvl {
    CONTEXT_SELECTOR_SET_LVL = 0,
    CONTEXT_SELECTOR_LVL = 1,
    CONTEXT_TRAIT_LVL = 2,
}

fn stringLiteralParser(P: *mut Parser) -> str {
    let mut Res: ExprResult = P.ParseStringLiteralExpression(true);
    return if Res.isUsable() { Res.getAs().getString() } else { "" };
}

fn getNameFromIdOrString(P: *mut Parser, Tok: *mut Token, Lvl: OMPContextLvl) -> str {
    if Tok.is(identifier) || Tok.is(kw_for) {
        let mut Buffer: str = "";
        let mut Name: str = P.getPreprocessor().getSpelling(Tok, Buffer, null);
        P.ConsumeToken() as void;
        return Name;
    }
    if isStringLiteral(Tok.getKind()) {
        return stringLiteralParser(P);
    }
    P.Diag(Tok.getLocation(), warn_omp_declare_variant_string_literal_or_identifier) << Lvl;
    return "";
}

fn checkForDuplicates(P: *mut Parser, Name: str, NameLoc: SourceLocation, Seen: *mut StringMap<SourceLocation>, Lvl: OMPContextLvl) -> bool {
    let mut Res: pair<iterator, bool> = Seen.try_emplace(Name, NameLoc);
    if Res.second {
        return false;
    }
    P.Diag(NameLoc, warn_omp_declare_variant_ctx_mutiple_use) << Lvl << Name;
    P.Diag(operator(Res.first).getValue(), note_omp_declare_variant_ctx_used_here) << Lvl << Name;
    return true;
}

fn Parser::parseOMPTraitPropertyKind(self, TIProperty: *mut OMPTraitProperty, Set: TraitSet, Selector: TraitSelector, Seen: *mut StringMap<SourceLocation>) {
    TIProperty.Kind = invalid;
    let mut NameLoc: SourceLocation = self.Tok.getLocation();
    let mut Name: str = "";
    if Selector == target_device_device_num {
        Name = "number";
        TIProperty.Kind = getOpenMPContextTraitPropertyKind(Set, Selector, Name);
        let mut DeviceNumExprResult: ExprResult = self.ParseExpression(AllowNonTypes);
        if DeviceNumExprResult.isUsable() {
            let mut DeviceNumExpr: *mut Expr = DeviceNumExprResult.get();
            self.Actions.OpenMP().ActOnOpenMPDeviceNum(DeviceNumExpr);
        }
        return;
    }
    Name = getNameFromIdOrString(*self, self.Tok, CONTEXT_TRAIT_LVL);
    if Name.is_empty() {
        self.Diag(self.Tok.getLocation(), note_omp_declare_variant_ctx_options) << CONTEXT_TRAIT_LVL << listOpenMPContextTraitProperties(Set, Selector);
        return;
    }
    TIProperty.RawString = Name;
    TIProperty.Kind = getOpenMPContextTraitPropertyKind(Set, Selector, Name);
    if TIProperty.Kind != invalid {
        if checkForDuplicates(*self, Name, NameLoc, Seen, CONTEXT_TRAIT_LVL) {
            TIProperty.Kind = invalid;
        }
        return;
    }
    self.Diag(NameLoc, warn_omp_declare_variant_ctx_not_a_property) << Name << getOpenMPContextTraitSelectorName(Selector) << getOpenMPContextTraitSetName(Set);
    let mut SetForName: TraitSet = getOpenMPContextTraitSetKind(Name);
    if SetForName != invalid {
        self.Diag(NameLoc, note_omp_declare_variant_ctx_is_a) << Name << CONTEXT_SELECTOR_SET_LVL << CONTEXT_TRAIT_LVL;
        self.Diag(NameLoc, note_omp_declare_variant_ctx_try) << Name << "<selector-name>" << "(<property-name>)";
        return;
    }
    let mut SelectorForName: TraitSelector = getOpenMPContextTraitSelectorKind(Name, SetForName);
    if SelectorForName != invalid {
        self.Diag(NameLoc, note_omp_declare_variant_ctx_is_a) << Name << CONTEXT_SELECTOR_LVL << CONTEXT_TRAIT_LVL;
        let mut AllowsTraitScore: bool = false;
        let mut RequiresProperty: bool = false;
        isValidTraitSelectorForTraitSet(SelectorForName, getOpenMPContextTraitSetForSelector(SelectorForName), AllowsTraitScore, RequiresProperty);
        self.Diag(NameLoc, note_omp_declare_variant_ctx_try) << getOpenMPContextTraitSetName(getOpenMPContextTraitSetForSelector(SelectorForName)) << Name << (if RequiresProperty { "(<property-name>)" } else { "" });
        return;
    }
    for PotentialSet in [construct, user, implementation, device, target_device] {
        let mut PropertyForName: TraitProperty = getOpenMPContextTraitPropertyKind(PotentialSet, Selector, Name);
        if PropertyForName == invalid {
            continue;
        }
        self.Diag(NameLoc, note_omp_declare_variant_ctx_try) << getOpenMPContextTraitSetName(getOpenMPContextTraitSetForProperty(PropertyForName)) << getOpenMPContextTraitSelectorName(getOpenMPContextTraitSelectorForProperty(PropertyForName)) << ("(" + Name + ")");
        return;
    }
    self.Diag(NameLoc, note_omp_declare_variant_ctx_options) << CONTEXT_TRAIT_LVL << listOpenMPContextTraitProperties(Set, Selector);
}

fn checkExtensionProperty(P: *mut Parser, Loc: SourceLocation, TIProperty: *mut OMPTraitProperty, TISelector: *mut OMPTraitSelector, Seen: *mut StringMap<SourceLocation>) -> bool {
    assert!(TISelector.Kind == implementation_extension, "Only for extension properties, e.g., `implementation={extension(PROPERTY)}`");
    if TIProperty.Kind == invalid {
        return false;
    }
    if TIProperty.Kind == implementation_extension_disable_implicit_base {
        return true;
    }
    if TIProperty.Kind == implementation_extension_allow_templates {
        return true;
    }
    if TIProperty.Kind == implementation_extension_bind_to_declaration {
        return true;
    }
    let mut IsMatchExtension: Closure_4 = Closure_4 {};
    if IsMatchExtension.call(TIProperty) {
        for SeenProp in TISelector.Properties {
            if IsMatchExtension.call(SeenProp) {
                P.Diag(Loc, err_omp_variant_ctx_second_match_extension);
                let mut SeenName: str = getOpenMPContextTraitPropertyName(SeenProp.Kind, SeenProp.RawString);
                let mut SeenLoc: SourceLocation = Seen[SeenName];
                P.Diag(SeenLoc, note_omp_declare_variant_ctx_used_here) << CONTEXT_TRAIT_LVL << SeenName;
                return false;
            }
        }
        return true;
    }
    llvm_unreachable_internal("Unknown extension property!", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenMP.cpp", 956);
}

fn Parser::parseOMPContextProperty(self, TISelector: *mut OMPTraitSelector, Set: TraitSet, Seen: *mut StringMap<SourceLocation>) {
    assert!(TISelector.Kind != user_condition, "User conditions are special properties not handled here!");
    let mut PropertyLoc: SourceLocation = self.Tok.getLocation();
    let mut TIProperty: OMPTraitProperty = OMPTraitProperty {};
    self.parseOMPTraitPropertyKind(TIProperty, Set, TISelector.Kind, Seen);
    if TISelector.Kind == implementation_extension {
        if !checkExtensionProperty(*self, self.Tok.getLocation(), TIProperty, TISelector, Seen) {
            TIProperty.Kind = invalid;
        }
    }
    if TIProperty.Kind == invalid {
        if PropertyLoc != self.Tok.getLocation() {
            self.Diag(self.Tok.getLocation(), note_omp_declare_variant_ctx_continue_here) << CONTEXT_TRAIT_LVL;
        }
        return;
    }
    if isValidTraitPropertyForTraitSetAndSelector(TIProperty.Kind, TISelector.Kind, Set) {
        TISelector.Properties.push(TIProperty);
        return;
    }
    self.Diag(PropertyLoc, warn_omp_ctx_incompatible_property_for_selector) << getOpenMPContextTraitPropertyName(TIProperty.Kind, TIProperty.RawString) << getOpenMPContextTraitSelectorName(TISelector.Kind) << getOpenMPContextTraitSetName(Set);
    self.Diag(PropertyLoc, note_omp_ctx_compatible_set_and_selector_for_property) << getOpenMPContextTraitPropertyName(TIProperty.Kind, TIProperty.RawString) << getOpenMPContextTraitSelectorName(getOpenMPContextTraitSelectorForProperty(TIProperty.Kind)) << getOpenMPContextTraitSetName(getOpenMPContextTraitSetForProperty(TIProperty.Kind));
    self.Diag(self.Tok.getLocation(), note_omp_declare_variant_ctx_continue_here) << CONTEXT_TRAIT_LVL;
}

fn Parser::parseOMPTraitSelectorKind(self, TISelector: *mut OMPTraitSelector, Set: TraitSet, Seen: *mut StringMap<SourceLocation>) {
    TISelector.Kind = invalid;
    let mut NameLoc: SourceLocation = self.Tok.getLocation();
    let mut Name: str = getNameFromIdOrString(*self, self.Tok, CONTEXT_SELECTOR_LVL);
    if Name.is_empty() {
        self.Diag(self.Tok.getLocation(), note_omp_declare_variant_ctx_options) << CONTEXT_SELECTOR_LVL << listOpenMPContextTraitSelectors(Set);
        return;
    }
    TISelector.Kind = getOpenMPContextTraitSelectorKind(Name, Set);
    if TISelector.Kind != invalid {
        if checkForDuplicates(*self, Name, NameLoc, Seen, CONTEXT_SELECTOR_LVL) {
            TISelector.Kind = invalid;
        }
        return;
    }
    self.Diag(NameLoc, warn_omp_declare_variant_ctx_not_a_selector) << Name << getOpenMPContextTraitSetName(Set);
    let mut SetForName: TraitSet = getOpenMPContextTraitSetKind(Name);
    if SetForName != invalid {
        self.Diag(NameLoc, note_omp_declare_variant_ctx_is_a) << Name << CONTEXT_SELECTOR_SET_LVL << CONTEXT_SELECTOR_LVL;
        self.Diag(NameLoc, note_omp_declare_variant_ctx_try) << Name << "<selector-name>" << "<property-name>";
        return;
    }
    for PotentialSet in [construct, user, implementation, device, target_device] {
        let mut PropertyForName: TraitProperty = getOpenMPContextTraitPropertyKind(PotentialSet, invalid, Name);
        if PropertyForName == invalid {
            continue;
        }
        self.Diag(NameLoc, note_omp_declare_variant_ctx_is_a) << Name << CONTEXT_TRAIT_LVL << CONTEXT_SELECTOR_LVL;
        self.Diag(NameLoc, note_omp_declare_variant_ctx_try) << getOpenMPContextTraitSetName(getOpenMPContextTraitSetForProperty(PropertyForName)) << getOpenMPContextTraitSelectorName(getOpenMPContextTraitSelectorForProperty(PropertyForName)) << ("(" + Name + ")");
        return;
    }
    self.Diag(NameLoc, note_omp_declare_variant_ctx_options) << CONTEXT_SELECTOR_LVL << listOpenMPContextTraitSelectors(Set);
}

fn parseContextScore(P: *mut Parser) -> ExprResult {
    let mut ScoreExpr: ExprResult = false;
    let mut Buffer: str = "";
    let mut SelectorName: str = P.getPreprocessor().getSpelling(P.getCurToken(), Buffer, null);
    if SelectorName != "score" {
        return ScoreExpr;
    }
    P.ConsumeToken() as void;
    let mut RLoc: SourceLocation = SourceLocation {};
    ScoreExpr = P.ParseOpenMPParensExpr(SelectorName, RLoc, false);
    if P.getCurToken().is(colon) {
        P.ConsumeAnyToken(false) as void;
    } else {
        P.Diag(P.getCurToken(), warn_omp_declare_variant_expected) << "':'" << "score expression";
    }
    return ScoreExpr;
}

fn Parser::parseOMPContextSelector(self, TISelector: *mut OMPTraitSelector, Set: TraitSet, SeenSelectors: *mut StringMap<SourceLocation>) {
    let mut OuterPC: u16 = self.ParenCount;
    let mut FinishSelector: Closure_5 = Closure_5 { OuterPC: OuterPC, cap_1: self };
    let mut SelectorLoc: SourceLocation = self.Tok.getLocation();
    self.parseOMPTraitSelectorKind(TISelector, Set, SeenSelectors);
    if TISelector.Kind == invalid {
        return FinishSelector.call();
    }
    let mut AllowsTraitScore: bool = false;
    let mut RequiresProperty: bool = false;
    if !isValidTraitSelectorForTraitSet(TISelector.Kind, Set, AllowsTraitScore, RequiresProperty) {
        self.Diag(SelectorLoc, warn_omp_ctx_incompatible_selector_for_set) << getOpenMPContextTraitSelectorName(TISelector.Kind) << getOpenMPContextTraitSetName(Set);
        self.Diag(SelectorLoc, note_omp_ctx_compatible_set_for_selector) << getOpenMPContextTraitSelectorName(TISelector.Kind) << getOpenMPContextTraitSetName(getOpenMPContextTraitSetForSelector(TISelector.Kind)) << RequiresProperty;
        return FinishSelector.call();
    }
    if !RequiresProperty {
        TISelector.Properties.push(OMPTraitProperty { Kind: getOpenMPContextTraitPropertyForSelector(TISelector.Kind), RawString: getOpenMPContextTraitSelectorName(TISelector.Kind) });
        return;
    }
    if !self.Tok.is(l_paren) {
        self.Diag(SelectorLoc, warn_omp_ctx_selector_without_properties) << getOpenMPContextTraitSelectorName(TISelector.Kind) << getOpenMPContextTraitSetName(Set);
        return FinishSelector.call();
    }
    if TISelector.Kind == user_condition {
        let mut RLoc: SourceLocation = SourceLocation {};
        let mut Condition: ExprResult = self.ParseOpenMPParensExpr("user condition", RLoc, false);
        if !Condition.isUsable() {
            return FinishSelector.call();
        }
        TISelector.ScoreOrCondition = Condition.get();
        TISelector.Properties.push(OMPTraitProperty { Kind: user_condition_unknown, RawString: "<condition>" });
        return;
    }
    let mut BDT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    BDT.consumeOpen() as void;
    let mut ScoreLoc: SourceLocation = self.Tok.getLocation();
    let mut Score: ExprResult = parseContextScore(*self);
    if !AllowsTraitScore && !Score.isUnset() {
        if Score.isUsable() {
            self.Diag(ScoreLoc, warn_omp_ctx_incompatible_score_for_property) << getOpenMPContextTraitSelectorName(TISelector.Kind) << getOpenMPContextTraitSetName(Set) << Score.get();
        } else {
            self.Diag(ScoreLoc, warn_omp_ctx_incompatible_score_for_property) << getOpenMPContextTraitSelectorName(TISelector.Kind) << getOpenMPContextTraitSetName(Set) << "<invalid>";
        }
        Score = ExprResult { false };
    }
    if Score.isUsable() {
        TISelector.ScoreOrCondition = Score.get();
    }
    let mut SeenProperties: StringMap<SourceLocation> = StringMap<SourceLocation> {};
    while true {
        {
        self.parseOMPContextProperty(TISelector, Set, SeenProperties);
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    BDT.consumeClose();
}

fn Parser::parseOMPTraitSetKind(self, TISet: *mut OMPTraitSet, Seen: *mut StringMap<SourceLocation>) {
    TISet.Kind = invalid;
    let mut NameLoc: SourceLocation = self.Tok.getLocation();
    let mut Name: str = getNameFromIdOrString(*self, self.Tok, CONTEXT_SELECTOR_SET_LVL);
    if Name.is_empty() {
        self.Diag(self.Tok.getLocation(), note_omp_declare_variant_ctx_options) << CONTEXT_SELECTOR_SET_LVL << listOpenMPContextTraitSets();
        return;
    }
    TISet.Kind = getOpenMPContextTraitSetKind(Name);
    if TISet.Kind != invalid {
        if checkForDuplicates(*self, Name, NameLoc, Seen, CONTEXT_SELECTOR_SET_LVL) {
            TISet.Kind = invalid;
        }
        return;
    }
    self.Diag(NameLoc, warn_omp_declare_variant_ctx_not_a_set) << Name;
    let mut SelectorForName: TraitSelector = getOpenMPContextTraitSelectorKind(Name, TISet.Kind);
    if SelectorForName != invalid {
        self.Diag(NameLoc, note_omp_declare_variant_ctx_is_a) << Name << CONTEXT_SELECTOR_LVL << CONTEXT_SELECTOR_SET_LVL;
        let mut AllowsTraitScore: bool = false;
        let mut RequiresProperty: bool = false;
        isValidTraitSelectorForTraitSet(SelectorForName, getOpenMPContextTraitSetForSelector(SelectorForName), AllowsTraitScore, RequiresProperty);
        self.Diag(NameLoc, note_omp_declare_variant_ctx_try) << getOpenMPContextTraitSetName(getOpenMPContextTraitSetForSelector(SelectorForName)) << Name << (if RequiresProperty { "(<property-name>)" } else { "" });
        return;
    }
    for PotentialSet in [construct, user, implementation, device, target_device] {
        let mut PropertyForName: TraitProperty = getOpenMPContextTraitPropertyKind(PotentialSet, invalid, Name);
        if PropertyForName == invalid {
            continue;
        }
        self.Diag(NameLoc, note_omp_declare_variant_ctx_is_a) << Name << CONTEXT_TRAIT_LVL << CONTEXT_SELECTOR_SET_LVL;
        self.Diag(NameLoc, note_omp_declare_variant_ctx_try) << getOpenMPContextTraitSetName(getOpenMPContextTraitSetForProperty(PropertyForName)) << getOpenMPContextTraitSelectorName(getOpenMPContextTraitSelectorForProperty(PropertyForName)) << ("(" + Name + ")");
        return;
    }
    self.Diag(NameLoc, note_omp_declare_variant_ctx_options) << CONTEXT_SELECTOR_SET_LVL << listOpenMPContextTraitSets();
}

fn Parser::parseOMPContextSelectorSet(self, TISet: *mut OMPTraitSet, SeenSets: *mut StringMap<SourceLocation>) {
    let mut OuterBC: u16 = self.BraceCount;
    let mut FinishSelectorSet: Closure_6 = Closure_6 { cap_0: self, OuterBC: OuterBC };
    self.parseOMPTraitSetKind(TISet, SeenSets);
    if TISet.Kind == invalid {
        return FinishSelectorSet.call();
    }
    if !self.TryConsumeToken(equal) {
        self.Diag(self.Tok.getLocation(), warn_omp_declare_variant_expected) << "=" << ("context set name \"" + getOpenMPContextTraitSetName(TISet.Kind) + "\"");
    }
    if self.Tok.is(l_brace) {
        self.ConsumeBrace() as void;
    } else {
        self.Diag(self.Tok.getLocation(), warn_omp_declare_variant_expected) << "{" << ("'=' that follows the context set name \"" + getOpenMPContextTraitSetName(TISet.Kind) + "\"");
    }
    let mut SeenSelectors: StringMap<SourceLocation> = StringMap<SourceLocation> {};
    while true {
        {
        let mut TISelector: OMPTraitSelector = OMPTraitSelector {};
        self.parseOMPContextSelector(TISelector, TISet.Kind, SeenSelectors);
        if TISelector.Kind != invalid && !TISelector.Properties.is_empty() {
            TISet.Selectors.push(TISelector);
        }
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    if self.Tok.is(r_brace) {
        self.ConsumeBrace() as void;
    } else {
        self.Diag(self.Tok.getLocation(), warn_omp_declare_variant_expected) << "}" << ("context selectors for the context set \"" + getOpenMPContextTraitSetName(TISet.Kind) + "\"");
    }
}

fn Parser::parseOMPContextSelectors(self, Loc: SourceLocation, TI: *mut OMPTraitInfo) -> bool {
    let mut SeenSets: StringMap<SourceLocation> = StringMap<SourceLocation> {};
    while true {
        {
        let mut TISet: OMPTraitSet = OMPTraitSet {};
        self.parseOMPContextSelectorSet(TISet, SeenSets);
        if TISet.Kind != invalid && !TISet.Selectors.is_empty() {
            TI.Sets.push(TISet);
        }
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    return false;
}

fn Parser::ParseOMPDeclareVariantClauses(self, Ptr: DeclGroupPtrTy, Toks: *mut CachedTokens, Loc: SourceLocation) {
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    self.PP.EnterToken(self.Tok, true);
    self.PP.EnterTokenStream(Toks, true, true);
    self.ConsumeAnyToken(true);
    self.ConsumeAnyToken(true);
    let mut FnContext: FNContextRAII = FNContextRAII { *self, Ptr };
    let mut RLoc: SourceLocation = SourceLocation {};
    let mut AssociatedFunction: ExprResult = false;
    {
        let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Other, true };
        AssociatedFunction = self.ParseOpenMPParensExpr(getOpenMPDirectiveName(OMPD_declare_variant, OMPVersion), RLoc, true);
    }
    if !AssociatedFunction.isUsable() {
        if !self.Tok.is(annot_pragma_openmp_end) {
            while !self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch) {
                
            }
        }
        self.ConsumeAnnotationToken() as void;
        return;
    }
    let mut ParentTI: *mut OMPTraitInfo = self.Actions.OpenMP().getOMPTraitInfoForSurroundingScope();
    let mut ASTCtx: *mut ASTContext = self.Actions.getASTContext();
    let mut TI: *mut OMPTraitInfo = ASTCtx.getNewOMPTraitInfo();
    let mut AdjustNothing: SmallVector<Expr *, 6> = SmallVector<Expr *, 6> {};
    let mut AdjustNeedDevicePtr: SmallVector<Expr *, 6> = SmallVector<Expr *, 6> {};
    let mut AdjustNeedDeviceAddr: SmallVector<Expr *, 6> = SmallVector<Expr *, 6> {};
    let mut AppendArgs: SmallVector<OMPInteropInfo, 3> = SmallVector<OMPInteropInfo, 3> {};
    let mut AdjustArgsLoc: SourceLocation = SourceLocation {};
    let mut AppendArgsLoc: SourceLocation = SourceLocation {};
    if self.Tok.is(annot_pragma_openmp_end) {
        self.Diag(self.Tok.getLocation(), err_omp_declare_variant_wrong_clause) << (if self.getLangOpts().OpenMP < 51 { 0 } else { 1 });
    }
    let mut IsError: bool = false;
    while self.Tok.isNot(annot_pragma_openmp_end) {
        let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
        if !isAllowedClauseForDirective(OMPD_declare_variant, CKind, OMPVersion) {
            self.Diag(self.Tok.getLocation(), err_omp_declare_variant_wrong_clause) << (if OMPVersion < 51 { 0 } else { 1 });
            IsError = true;
        }
        if !IsError {
            match CKind {
                OMPC_match => {
                    IsError = self.parseOMPDeclareVariantMatchClause(Loc, TI, ParentTI);
                },
                OMPC_adjust_args => {
                    AdjustArgsLoc = self.Tok.getLocation();
                    self.ConsumeToken();
                    let mut Data: OpenMPVarListDataTy = OpenMPVarListDataTy {};
                    let mut Vars: SmallVector<Expr *> = SmallVector<Expr *> {};
                    IsError = self.ParseOpenMPVarList(OMPD_declare_variant, OMPC_adjust_args, Vars, Data);
                    if !IsError {
                        match Data.ExtraModifier {
                            OMPC_ADJUST_ARGS_nothing => {
                                append_range(AdjustNothing, Vars);
                            },
                            OMPC_ADJUST_ARGS_need_device_ptr => {
                                append_range(AdjustNeedDevicePtr, Vars);
                            },
                            OMPC_ADJUST_ARGS_need_device_addr => {
                                append_range(AdjustNeedDeviceAddr, Vars);
                            },
                            _ => {
                                llvm_unreachable_internal("Unexpected 'adjust_args' clause modifier.", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenMP.cpp", 1421);
                            },
                        }
                    }
                    break;
                },
                OMPC_append_args => {
                    if !AppendArgs.is_empty() {
                        self.Diag(AppendArgsLoc, err_omp_more_one_clause) << getOpenMPDirectiveName(OMPD_declare_variant, OMPVersion) << getOpenMPClauseName(CKind, 0) << 0;
                        IsError = true;
                    }
                },
                _ => {
                    llvm_unreachable_internal("Unexpected clause for declare variant.", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenMP.cpp", 1440);
                },
            }
        }
        if IsError {
            while !self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch) {
                
            }
            self.ConsumeAnnotationToken() as void;
            return;
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
    }
    let mut DeclVarData: pair<FunctionDecl *, Expr *>> = self.Actions.OpenMP().checkOpenMPDeclareVariantFunction(Ptr, AssociatedFunction.get(), TI, AppendArgs.len, SourceRange { B: Loc, E: self.Tok.getLocation() });
    if DeclVarData && !TI.Sets.is_empty() {
        self.Actions.OpenMP().ActOnOpenMPDeclareVariantDirective(operator(DeclVarData).first, operator(DeclVarData).second, TI, AdjustNothing, AdjustNeedDevicePtr, AdjustNeedDeviceAddr, AppendArgs, AdjustArgsLoc, AppendArgsLoc, SourceRange { B: Loc, E: self.Tok.getLocation() });
    }
    self.ConsumeAnnotationToken() as void;
}

fn Parser::parseOpenMPAppendArgs(self, InteropInfos: *mut SmallVectorImpl<OMPInteropInfo>) -> bool {
    let mut HasError: bool = false;
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPClauseName(OMPC_append_args, 0).ptr, unknown) {
        return true;
    }
    while self.Tok.is(identifier) && self.Tok.getIdentifierInfo().isStr("interop") {
        self.ConsumeToken();
        let mut IT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
        if IT.expectAndConsume(err_expected_lparen_after, "interop", unknown) {
            return true;
        }
        let mut InteropInfo: OMPInteropInfo = OMPInteropInfo { false, false };
        if self.ParseOMPInteropInfo(InteropInfo, OMPC_append_args) {
            HasError = true;
        } else {
            InteropInfos.push(InteropInfo);
        }
        IT.consumeClose();
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
    }
    if !HasError && InteropInfos.is_empty() {
        HasError = true;
        self.Diag(self.Tok.getLocation(), err_omp_unexpected_append_op);
        self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
    }
    HasError = T.consumeClose() || HasError;
    return HasError;
}

fn Parser::parseOMPDeclareVariantMatchClause(self, Loc: SourceLocation, TI: *mut OMPTraitInfo, ParentTI: *mut OMPTraitInfo) -> bool {
    let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
    if CKind != OMPC_match {
        self.Diag(self.Tok.getLocation(), err_omp_declare_variant_wrong_clause) << (if self.getLangOpts().OpenMP < 51 { 0 } else { 1 });
        return true;
    }
    self.ConsumeToken() as void;
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPClauseName(OMPC_match, 0).ptr, unknown) {
        return true;
    }
    self.parseOMPContextSelectors(Loc, TI);
    T.consumeClose() as void;
    if !ParentTI {
        return false;
    }
    for ParentSet in ParentTI.Sets {
        let mut MergedSet: bool = false;
        for Set in TI.Sets {
            if Set.Kind != ParentSet.Kind {
                continue;
            }
            MergedSet = true;
            for ParentSelector in ParentSet.Selectors {
                let mut MergedSelector: bool = false;
                for Selector in Set.Selectors {
                    if Selector.Kind != ParentSelector.Kind {
                        continue;
                    }
                    MergedSelector = true;
                    for ParentProperty in ParentSelector.Properties {
                        let mut MergedProperty: bool = false;
                        for Property in Selector.Properties {
                            if Property.Kind != ParentProperty.Kind {
                                continue;
                            }
                            MergedProperty |= Property.RawString == ParentProperty.RawString;
                            if Property.RawString == ParentProperty.RawString && Selector.ScoreOrCondition == ParentSelector.ScoreOrCondition {
                                continue;
                            }
                            if Selector.Kind == user_condition {
                                self.Diag(Loc, err_omp_declare_variant_nested_user_condition);
                            } else if Selector.ScoreOrCondition != ParentSelector.ScoreOrCondition {
                                self.Diag(Loc, err_omp_declare_variant_duplicate_nested_trait) << getOpenMPContextTraitPropertyName(ParentProperty.Kind, ParentProperty.RawString) << getOpenMPContextTraitSelectorName(ParentSelector.Kind) << getOpenMPContextTraitSetName(ParentSet.Kind);
                            }
                        }
                        if !MergedProperty {
                            Selector.Properties.push(ParentProperty);
                        }
                    }
                }
                if !MergedSelector {
                    Set.Selectors.push(ParentSelector);
                }
            }
        }
        if !MergedSet {
            TI.Sets.push(ParentSet);
        }
    }
    return false;
}

fn Parser::ParseOpenMPClauses(self, DKind: OpenMPDirectiveKind, Clauses: *mut SmallVectorImpl<OMPClause *>, Loc: SourceLocation) {
    let mut SeenClauses: Clause_enumSize + 1> = Clause_enumSize + 1> {};
    while self.Tok.isNot(annot_pragma_openmp_end) {
        let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
        if DKind == OMPD_depobj && CKind == OMPC_update {
            CKind = OMPC_update_depend_objects;
        }
        self.Actions.OpenMP().StartOpenMPClause(CKind);
        let mut Clause: *mut OMPClause = self.ParseOpenMPClause(DKind, CKind, !SeenClauses[CKind]);
        self.SkipUntil(comma, identifier, annot_pragma_openmp_end, StopBeforeMatch);
        SeenClauses[CKind] = true;
        if Clause != null {
            Clauses.push(Clause);
        }
        if self.Tok.is(annot_pragma_openmp_end) {
            self.Actions.OpenMP().EndOpenMPClause();
            break;
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
        self.Actions.OpenMP().EndOpenMPClause();
    }
}

fn Parser::ParseOpenMPAssumesDirective(self, DKind: OpenMPDirectiveKind, Loc: SourceLocation) {
    let mut Assumptions: string, 4> = string, 4> {};
    let mut SkippedClauses: bool = false;
    let mut SkipBraces: Closure_7 = Closure_7 { cap_0: self };
    let mut MatchACMClause: Closure_8 = Closure_8 {};
    while self.Tok.isNot(annot_pragma_openmp_end) {
        let mut II: *mut IdentifierInfo = null;
        let mut StartLoc: SourceLocation = self.Tok.getLocation();
        let mut Idx: i32 = -1;
        if self.Tok.isAnyIdentifier() {
            II = self.Tok.getIdentifierInfo();
            Idx = MatchACMClause.call(II.getName());
        }
        self.ConsumeAnyToken(false);
        let mut NextIsLPar: bool = self.Tok.is(l_paren);
        if Idx == -1 {
            let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
            self.Diag(StartLoc, warn_omp_unknown_assumption_clause_missing_id) << getOpenMPDirectiveName(DKind, OMPVersion) << getAllAssumeClauseOptions() << NextIsLPar;
            if NextIsLPar {
                SkipBraces.call(if II { II.getName() } else { "" }, true);
            }
            SkippedClauses = true;
            continue;
        }
        let mut ACMI: *AssumptionClauseMappingInfo = AssumptionClauseMappings[Idx];
        if ACMI.HasDirectiveList || ACMI.HasExpression {
            SkippedClauses = true;
            SkipBraces.call(II.getName(), false);
            continue;
        }
        if NextIsLPar {
            self.Diag(self.Tok.getLocation(), warn_omp_unknown_assumption_clause_without_args) << II;
            SkipBraces.call(II.getName(), true);
        }
        assert!(II, "Expected an identifier clause!");
        let mut Assumption: str = II.getName();
        if ACMI.StartsWith {
            Assumption = "ompx_" + Assumption[ACMI.Identifier.len..ACMI.Identifier.len + npos];
        } else {
            Assumption = "omp_" + Assumption;
        }
        Assumptions.push(Assumption);
    }
    self.Actions.OpenMP().ActOnOpenMPAssumesDirective(Loc, DKind, Assumptions, SkippedClauses);
}

fn Parser::ParseOpenMPEndAssumesDirective(self, Loc: SourceLocation) {
    if self.Actions.OpenMP().isInOpenMPAssumeScope() {
        self.Actions.OpenMP().ActOnOpenMPEndAssumesDirective();
    } else {
        self.Diag(Loc, err_expected_begin_assumes);
    }
}

struct SimpleClauseData {
    Type: u32,
    Loc: SourceLocation,
    LOpen: SourceLocation,
    TypeLoc: SourceLocation,
    RLoc: SourceLocation,
}

fn parseOpenMPSimpleClause(P: *mut Parser, Kind: OpenMPClauseKind) -> optional<SimpleClauseData> {
    let mut Tok: *Token = P.getCurToken();
    let mut Loc: SourceLocation = Tok.getLocation();
    let mut LOpen: SourceLocation = P.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { P, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPClauseName(Kind, 0).ptr, unknown) {
        return nullopt;
    }
    let mut Type: u32 = getOpenMPSimpleClauseType(Kind, if Tok.isAnnotation() { "" } else { P.getPreprocessor().getSpelling(Tok, null) }, P.getLangOpts());
    let mut TypeLoc: SourceLocation = Tok.getLocation();
    if Tok.isNot(r_paren) && Tok.isNot(comma) && Tok.isNot(annot_pragma_openmp_end) {
        P.ConsumeAnyToken(false);
    }
    let mut RLoc: SourceLocation = Tok.getLocation();
    if !T.consumeClose() {
        RLoc = T.getCloseLocation();
    }
    return SimpleClauseData { Type: Type, Loc: Loc, LOpen: LOpen, TypeLoc: TypeLoc, RLoc: RLoc };
}

fn Parser::ParseOMPDeclareTargetClauses(self, DTCI: *mut DeclareTargetContextInfo) {
    let mut DeviceTypeLoc: SourceLocation = SourceLocation {};
    let mut RequiresToLinkLocalOrIndirectClause: bool = false;
    let mut HasToLinkLocalOrIndirectClause: bool = false;
    while self.Tok.isNot(annot_pragma_openmp_end) {
        let mut MT: MapTypeTy = MT_To;
        let mut HasIdentifier: bool = self.Tok.is(identifier);
        if HasIdentifier {
            RequiresToLinkLocalOrIndirectClause = true;
            let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            let mut ClauseName: str = II.getName();
            let mut IsDeviceTypeClause: bool = self.getLangOpts().OpenMP >= 50 && getOpenMPClauseKind(ClauseName) == OMPC_device_type;
            let mut IsIndirectClause: bool = self.getLangOpts().OpenMP >= 51 && getOpenMPClauseKind(ClauseName) == OMPC_indirect;
            if DTCI.Indirect && IsIndirectClause {
                let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
                self.Diag(self.Tok, err_omp_more_one_clause) << getOpenMPDirectiveName(OMPD_declare_target, OMPVersion) << getOpenMPClauseName(OMPC_indirect, 0) << 0;
                break;
            }
            let mut IsToEnterLinkOrLocalClause: bool = ConvertStrToMapTypeTy(ClauseName, MT);
            assert!((!IsDeviceTypeClause || !IsToEnterLinkOrLocalClause), "Cannot be both!");
            if self.getLangOpts().OpenMP >= 52 && ClauseName == "to" {
                self.Diag(self.Tok, err_omp_declare_target_unexpected_to_clause);
                break;
            }
            if self.getLangOpts().OpenMP <= 51 && ClauseName == "enter" {
                self.Diag(self.Tok, err_omp_declare_target_unexpected_enter_clause);
                break;
            }
            if self.getLangOpts().OpenMP < 60 && ClauseName == "local" {
                self.Diag(self.Tok, if self.getLangOpts().OpenMP >= 52 { err_omp_declare_target_unexpected_clause_52 } else { err_omp_declare_target_unexpected_clause }) << ClauseName << (if self.getLangOpts().OpenMP >= 51 { 4 } else { if self.getLangOpts().OpenMP >= 50 { 2 } else { 1 } });
                break;
            }
            if !IsDeviceTypeClause && !IsIndirectClause && DTCI.Kind == OMPD_begin_declare_target {
                self.Diag(self.Tok, if self.getLangOpts().OpenMP >= 52 { err_omp_declare_target_unexpected_clause_52 } else { err_omp_declare_target_unexpected_clause }) << ClauseName << (if self.getLangOpts().OpenMP >= 51 { 3 } else { 0 });
                break;
            }
            if !IsDeviceTypeClause && !IsToEnterLinkOrLocalClause && !IsIndirectClause {
                self.Diag(self.Tok, if self.getLangOpts().OpenMP >= 52 { err_omp_declare_target_unexpected_clause_52 } else { err_omp_declare_target_unexpected_clause }) << ClauseName << (if self.getLangOpts().OpenMP > 52 { 5 } else { if self.getLangOpts().OpenMP >= 51 { 4 } else { if self.getLangOpts().OpenMP >= 50 { 2 } else { 1 } } });
                break;
            }
            if IsToEnterLinkOrLocalClause || IsIndirectClause {
                HasToLinkLocalOrIndirectClause = true;
            }
            if IsIndirectClause {
                if !self.ParseOpenMPIndirectClause(DTCI, false) {
                    break;
                }
                continue;
            }
            if IsDeviceTypeClause {
                let mut DevTypeData: optional<SimpleClauseData> = parseOpenMPSimpleClause(*self, OMPC_device_type);
                if DevTypeData {
                    if DeviceTypeLoc.isValid() {
                        self.Diag(operator(DevTypeData).Loc, warn_omp_more_one_device_type_clause);
                        break;
                    }
                    match operator(DevTypeData).Type as OpenMPDeviceType {
                        OMPC_DEVICE_TYPE_any => {
                            DTCI.DT = DT_Any;
                        },
                        OMPC_DEVICE_TYPE_host => {
                            DTCI.DT = DT_Host;
                        },
                        OMPC_DEVICE_TYPE_nohost => {
                            DTCI.DT = DT_NoHost;
                        },
                        OMPC_DEVICE_TYPE_unknown => {
                            llvm_unreachable_internal("Unexpected device_type", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenMP.cpp", 1871);
                        },
                    }
                    DeviceTypeLoc = operator(DevTypeData).Loc;
                }
                continue;
            }
            self.ConsumeToken();
        }
        if DTCI.Kind == OMPD_declare_target || HasIdentifier {
            let mut Callback: Closure_9 = Closure_9 { cap_0: self, MT: MT, DTCI: &mut DTCI };
            if self.ParseOpenMPSimpleVarList(OMPD_declare_target, function_ref<void (CXXScopeSpec &, DeclarationNameInfo)> { Callback, null, null }, true) {
                break;
            }
        }
        if self.Tok.is(l_paren) {
            self.Diag(self.Tok, err_omp_begin_declare_target_unexpected_implicit_to_clause);
            break;
        }
        if !HasIdentifier && self.Tok.isNot(annot_pragma_openmp_end) {
            self.Diag(self.Tok, if self.getLangOpts().OpenMP >= 52 { err_omp_declare_target_wrong_clause_after_implicit_enter } else { err_omp_declare_target_wrong_clause_after_implicit_to });
            break;
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
    }
    if DTCI.Indirect && DTCI.DT != DT_Any {
        self.Diag(DeviceTypeLoc, err_omp_declare_target_indirect_device_type);
    }
    if DTCI.Kind == OMPD_declare_target && RequiresToLinkLocalOrIndirectClause && !HasToLinkLocalOrIndirectClause {
        self.Diag(DTCI.Loc, err_omp_declare_target_missing_required_clause) << (if self.getLangOpts().OpenMP >= 60 { 3 } else { if self.getLangOpts().OpenMP == 52 { 2 } else { if self.getLangOpts().OpenMP == 51 { 1 } else { 0 } } });
    }
    self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
}

fn Parser::skipUntilPragmaOpenMPEnd(self, DKind: OpenMPDirectiveKind) {
    if self.Tok.is(annot_pragma_openmp_end) {
        return;
    }
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    self.Diag(self.Tok, warn_omp_extra_tokens_at_eol) << getOpenMPDirectiveName(DKind, OMPVersion);
    while self.Tok.isNot(annot_pragma_openmp_end) {
        self.ConsumeAnyToken(false);
    }
}

fn Parser::parseOMPEndDirective(self, BeginKind: OpenMPDirectiveKind, ExpectedKind: OpenMPDirectiveKind, FoundKind: OpenMPDirectiveKind, BeginLoc: SourceLocation, FoundLoc: SourceLocation, SkipUntilOpenMPEnd: bool) {
    let mut DiagSelection: i32 = if ExpectedKind == OMPD_end_declare_target { 0 } else { 1 };
    if FoundKind == ExpectedKind {
        self.ConsumeAnyToken(false);
        self.skipUntilPragmaOpenMPEnd(ExpectedKind);
        return;
    }
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    self.Diag(FoundLoc, err_expected_end_declare_target_or_variant) << DiagSelection;
    self.Diag(BeginLoc, note_matching) << ("'#pragma omp " + getOpenMPDirectiveName(BeginKind, OMPVersion) + "'");
    if SkipUntilOpenMPEnd {
        self.SkipUntil(annot_pragma_openmp_end, StopBeforeMatch);
    }
}

fn Parser::ParseOMPEndDeclareTargetDirective(self, BeginDKind: OpenMPDirectiveKind, EndDKind: OpenMPDirectiveKind, DKLoc: SourceLocation) {
    self.parseOMPEndDirective(BeginDKind, OMPD_end_declare_target, EndDKind, DKLoc, self.Tok.getLocation(), false);
    if self.Tok.is(annot_pragma_openmp_end) {
        self.ConsumeAnnotationToken();
    }
}

fn Parser::ParseOpenMPDeclarativeDirectiveWithExtDecl(self, AS: *mut AccessSpecifier, Attrs: *mut ParsedAttributes, Delayed: bool, TagType: TST, Tag: *mut Decl) -> DeclGroupPtrTy {
    assert!(self.Tok.isOneOf(annot_pragma_openmp, annot_attr_openmp), "Not an OpenMP directive!");
    let mut DirScope: ParsingOpenMPDirectiveRAII = ParsingOpenMPDirectiveRAII { P: *self, OldVal: true };
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    let mut Loc: SourceLocation = SourceLocation {};
    let mut DKind: OpenMPDirectiveKind = zeroed();
    if Delayed {
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        Loc = self.ConsumeAnnotationToken();
        DKind = parseOpenMPDirectiveKind(*self);
        if DKind == OMPD_declare_reduction || DKind == OMPD_declare_mapper {
            TPA.Revert();
            let mut Toks: CachedTokens = CachedTokens {};
            let mut Cnt: u32 = 1;
            Toks.push(self.Tok);
            while Cnt && self.Tok.isNot(eof) {
                self.ConsumeAnyToken(false) as void;
                if self.Tok.isOneOf(annot_pragma_openmp, annot_attr_openmp) {
                    Cnt += 1;
                } else if self.Tok.is(annot_pragma_openmp_end) {
                    Cnt -= 1;
                }
                Toks.push(self.Tok);
            }
            if Cnt == 0 {
                self.ConsumeAnyToken(false) as void;
            }
            let mut LP: *mut LateParsedPragma = LateParsedPragma { self, AS };
            LP.takeToks(Toks);
            self.getCurrentClass().LateParsedDeclarations.push(LP);
            return null;
        }
        TPA.Commit();
    } else {
        Loc = self.ConsumeAnnotationToken();
        DKind = parseOpenMPDirectiveKind(*self);
    }
    match DKind {
        OMPD_threadprivate => {
            self.ConsumeToken();
            let mut Helper: DeclDirectiveListParserHelper = DeclDirectiveListParserHelper { self, DKind };
            if !self.ParseOpenMPSimpleVarList(DKind, function_ref<void (CXXScopeSpec &, DeclarationNameInfo)> { Helper, null, null }, true) {
                self.skipUntilPragmaOpenMPEnd(DKind);
                self.ConsumeAnnotationToken();
                return self.Actions.OpenMP().ActOnOpenMPThreadprivateDirective(Loc, Helper.getIdentifiers());
            }
            break;
        },
        OMPD_groupprivate => {
            self.ConsumeToken();
            let mut Helper: DeclDirectiveListParserHelper = DeclDirectiveListParserHelper { self, DKind };
            if !self.ParseOpenMPSimpleVarList(DKind, function_ref<void (CXXScopeSpec &, DeclarationNameInfo)> { Helper, null, null }, true) {
                self.skipUntilPragmaOpenMPEnd(DKind);
                self.ConsumeAnnotationToken();
                return self.Actions.OpenMP().ActOnOpenMPGroupPrivateDirective(Loc, Helper.getIdentifiers());
            }
            break;
        },
        OMPD_allocate => {
            self.ConsumeToken();
            let mut Helper: DeclDirectiveListParserHelper = DeclDirectiveListParserHelper { self, DKind };
            if !self.ParseOpenMPSimpleVarList(DKind, function_ref<void (CXXScopeSpec &, DeclarationNameInfo)> { Helper, null, null }, true) {
                let mut Clauses: SmallVector<OMPClause *, 1> = SmallVector<OMPClause *, 1> {};
                if self.Tok.isNot(annot_pragma_openmp_end) {
                    let mut SeenClauses: Clause_enumSize + 1> = Clause_enumSize + 1> {};
                    while self.Tok.isNot(annot_pragma_openmp_end) {
                        let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
                        self.Actions.OpenMP().StartOpenMPClause(CKind);
                        let mut Clause: *mut OMPClause = self.ParseOpenMPClause(OMPD_allocate, CKind, !SeenClauses[CKind]);
                        self.SkipUntil(comma, identifier, annot_pragma_openmp_end, StopBeforeMatch);
                        SeenClauses[CKind] = true;
                        if Clause != null {
                            Clauses.push(Clause);
                        }
                        if self.Tok.is(annot_pragma_openmp_end) {
                            self.Actions.OpenMP().EndOpenMPClause();
                            break;
                        }
                        if self.Tok.is(comma) {
                            self.ConsumeToken();
                        }
                        self.Actions.OpenMP().EndOpenMPClause();
                    }
                    self.skipUntilPragmaOpenMPEnd(DKind);
                }
                self.ConsumeAnnotationToken();
                return self.Actions.OpenMP().ActOnOpenMPAllocateDirective(Loc, Helper.getIdentifiers(), Clauses, null);
            }
            break;
        },
        OMPD_requires => {
            let mut StartLoc: SourceLocation = self.ConsumeToken();
            let mut Clauses: SmallVector<OMPClause *, 5> = SmallVector<OMPClause *, 5> {};
            let mut SeenClauses: SmallBitVector = SmallBitVector { Clause_enumSize + 1, false };
            if self.Tok.is(annot_pragma_openmp_end) {
                self.Diag(self.Tok, err_omp_expected_clause) << getOpenMPDirectiveName(OMPD_requires, OMPVersion);
                break;
            }
            while self.Tok.isNot(annot_pragma_openmp_end) {
                let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
                self.Actions.OpenMP().StartOpenMPClause(CKind);
                let mut Clause: *mut OMPClause = self.ParseOpenMPClause(OMPD_requires, CKind, !SeenClauses[CKind]);
                self.SkipUntil(comma, identifier, annot_pragma_openmp_end, StopBeforeMatch);
                SeenClauses[CKind] = true;
                if Clause != null {
                    Clauses.push(Clause);
                }
                if self.Tok.is(annot_pragma_openmp_end) {
                    self.Actions.OpenMP().EndOpenMPClause();
                    break;
                }
                if self.Tok.is(comma) {
                    self.ConsumeToken();
                }
                self.Actions.OpenMP().EndOpenMPClause();
            }
            if Clauses.is_empty() {
                self.Diag(self.Tok, err_omp_expected_clause) << getOpenMPDirectiveName(OMPD_requires, OMPVersion);
                self.ConsumeAnnotationToken();
                return null;
            }
            self.ConsumeAnnotationToken();
            return self.Actions.OpenMP().ActOnOpenMPRequiresDirective(StartLoc, Clauses);
        },
        OMPD_error => {
            let mut Clauses: SmallVector<OMPClause *, 1> = SmallVector<OMPClause *, 1> {};
            let mut StartLoc: SourceLocation = self.ConsumeToken();
            self.ParseOpenMPClauses(DKind, Clauses, StartLoc);
            self.Actions.OpenMP().ActOnOpenMPErrorDirective(Clauses, StartLoc, SourceLocation {}, false);
            break;
        },
        OMPD_assumes => {
            OMPD_begin_assumes;
        },
        OMPD_end_assumes => {
            self.ParseOpenMPEndAssumesDirective(self.ConsumeToken());
        },
        OMPD_declare_reduction => {
            self.ConsumeToken();
        },
        OMPD_declare_mapper => {
            self.ConsumeToken();
            if self.ParseOpenMPDeclareMapperDirective(AS) {
                Res;
            } else {
                self.ConsumeAnnotationToken();
                return Res;
            }
            break;
        },
        OMPD_begin_declare_variant => {
            self.ConsumeToken();
            if !self.ParseOpenMPDeclareBeginVariantDirective(Loc) {
                if !self.isEofOrEom() {
                    self.ConsumeAnnotationToken();
                }
            }
            return null;
        },
        OMPD_end_declare_variant => {
            self.ConsumeToken();
            if self.Actions.OpenMP().isInOpenMPDeclareVariantScope() {
                self.Actions.OpenMP().ActOnOpenMPEndDeclareVariant();
            } else {
                self.Diag(Loc, err_expected_begin_declare_variant);
            }
            self.ConsumeAnnotationToken();
            return null;
        },
        OMPD_declare_variant => {
            OMPD_declare_simd;
        },
        OMPD_begin_declare_target => {
            OMPD_declare_target;
        },
        OMPD_end_declare_target => {
            if !self.Actions.OpenMP().isInOpenMPDeclareTargetContext() {
                self.Diag(self.Tok, err_omp_unexpected_directive) << 1 << getOpenMPDirectiveName(DKind, OMPVersion);
                break;
            }
            let mut DTCI: *DeclareTargetContextInfo = self.Actions.OpenMP().ActOnOpenMPEndDeclareTargetDirective();
            self.ParseOMPEndDeclareTargetDirective(DTCI.Kind, DKind, DTCI.Loc);
            return null;
        },
        OMPD_assume => {
            self.Diag(self.Tok, err_omp_unexpected_directive) << 1 << getOpenMPDirectiveName(DKind, OMPVersion);
            break;
        },
        OMPD_unknown => {
            self.Diag(self.Tok, err_omp_unknown_directive);
        },
        _ => {
            match getDirectiveCategory(DKind) {
                Executable => {
                    Meta;
                },
                Declarative => {
                    Informational;
                },
            }
        },
    }
    while self.Tok.isNot(annot_pragma_openmp_end) {
        self.ConsumeAnyToken(false);
    }
    self.ConsumeAnyToken(false);
    return null;
}

fn Parser::ParseOpenMPExecutableDirective(self, StmtCtx: ParsedStmtContext, DKind: OpenMPDirectiveKind, Loc: SourceLocation, ReadDirectiveWithinMetadirective: bool) -> StmtResult {
    assert!(isOpenMPExecutableDirective(DKind), "Unexpected directive category");
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    let mut HasAssociatedStatement: bool = true;
    let mut Assoc: Association = getDirectiveAssociation(DKind);
    if DKind != OMPD_ordered_standalone && DKind != OMPD_section && (Assoc == None || Assoc == Separating) {
        if (StmtCtx & AllowStandaloneOpenMPDirectives) ==  {
            self.Diag(self.Tok, err_omp_immediate_directive) << getOpenMPDirectiveName(DKind, OMPVersion) << 0;
            if DKind == OMPD_error {
                self.SkipUntil(annot_pragma_openmp_end, 0 as SkipUntilFlags);
                return StmtError();
            }
        }
        HasAssociatedStatement = false;
    }
    let mut EndLoc: SourceLocation = SourceLocation {};
    let mut Clauses: SmallVector<OMPClause *, 5> = SmallVector<OMPClause *, 5> {};
    let mut SeenClauses: SmallBitVector = SmallBitVector { Clause_enumSize + 1, false };
    let mut DirName: DeclarationNameInfo = DeclarationNameInfo {};
    let mut CancelRegion: OpenMPDirectiveKind = OMPD_unknown;
    let mut ScopeFlags: u32 = FnScope | DeclScope | CompoundStmtScope | OpenMPDirectiveScope;
    let mut ImplicitTok: Token = Token {};
    let mut ImplicitClauseAllowed: bool = false;
    if DKind == OMPD_flush || DKind == OMPD_depobj {
        ImplicitTok = self.Tok;
        ImplicitClauseAllowed = true;
    }
    self.ConsumeToken();
    if DKind == OMPD_critical {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
        if !T.consumeOpen() {
            if self.Tok.isAnyIdentifier() {
                DirName = DeclarationNameInfo { self.Tok.getIdentifierInfo(), self.Tok.getLocation() };
                self.ConsumeAnyToken(false);
            } else {
                self.Diag(self.Tok, err_omp_expected_identifier_for_critical);
            }
            T.consumeClose();
        }
    } else if DKind == OMPD_cancellation_point || DKind == OMPD_cancel {
        CancelRegion = parseOpenMPDirectiveKind(*self);
        if self.Tok.isNot(annot_pragma_openmp_end) {
            self.ConsumeAnyToken(false);
        }
    }
    if isOpenMPLoopDirective(DKind) {
        ScopeFlags |= OpenMPLoopDirectiveScope;
    }
    if isOpenMPSimdDirective(DKind) {
        ScopeFlags |= OpenMPSimdDirectiveScope;
    }
    let mut OMPDirectiveScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    self.Actions.OpenMP().StartOpenMPDSABlock(DKind, DirName, self.Actions.getCurScope(), Loc);
    while self.Tok.isNot(annot_pragma_openmp_end) {
        if ReadDirectiveWithinMetadirective && self.Tok.is(r_paren) {
            while self.Tok.isNot(annot_pragma_openmp_end) {
                self.ConsumeAnyToken(false);
            }
            break;
        }
        let mut HasImplicitClause: bool = false;
        if ImplicitClauseAllowed && self.Tok.is(l_paren) {
            HasImplicitClause = true;
            self.PP.EnterToken(self.Tok, true);
            self.PP.EnterToken(ImplicitTok, true);
            self.ConsumeAnyToken(false);
        }
        let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
        if DKind == OMPD_depobj && CKind == OMPC_update {
            CKind = OMPC_update_depend_objects;
        }
        if HasImplicitClause {
            assert!(CKind == OMPC_unknown, "Must be unknown implicit clause.");
            if DKind == OMPD_flush {
                CKind = OMPC_flush;
            } else {
                assert!(DKind == OMPD_depobj, "Expected flush or depobj directives.");
                CKind = OMPC_depobj;
            }
        }
        ImplicitClauseAllowed = false;
        self.Actions.OpenMP().StartOpenMPClause(CKind);
        HasImplicitClause = false;
        let mut ClauseLoc: SourceLocation = self.Tok.getLocation();
        let mut Clause: *mut OMPClause = self.ParseOpenMPClause(DKind, CKind, !SeenClauses[CKind]);
        SeenClauses[CKind] = true;
        if Clause {
            Clauses.push(Clause);
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
        self.Actions.OpenMP().EndOpenMPClause();
        if self.Tok.getLocation() == ClauseLoc {
            self.skipUntilPragmaOpenMPEnd(DKind);
            break;
        }
    }
    EndLoc = self.Tok.getLocation();
    self.ConsumeAnnotationToken();
    assert!(DKind != OMPD_ordered_blockassoc, "Wrong kind for ordered directive");
    if DKind == OMPD_ordered_standalone {
        for CK in [OMPC_depend, OMPC_doacross] {
            if SeenClauses[CK] {
                if (StmtCtx & AllowStandaloneOpenMPDirectives) ==  {
                    self.Diag(Loc, err_omp_immediate_directive) << getOpenMPDirectiveName(DKind, OMPVersion) << 1 << getOpenMPClauseName(CK, 0);
                }
                HasAssociatedStatement = false;
            }
        }
        if HasAssociatedStatement {
            DKind = OMPD_ordered_blockassoc;
        }
    }
    if (DKind == OMPD_tile || DKind == OMPD_stripe) && !SeenClauses[OMPC_sizes] {
        self.Diag(Loc, err_omp_required_clause) << getOpenMPDirectiveName(DKind, OMPVersion) << "sizes";
    }
    if DKind == OMPD_split && !SeenClauses[OMPC_counts] {
        self.Diag(Loc, err_omp_required_clause) << getOpenMPDirectiveName(DKind, OMPVersion) << "counts";
    }
    let mut AssociatedStmt: StmtResult = false;
    if HasAssociatedStatement {
        self.Actions.OpenMP().ActOnOpenMPRegionStart(DKind, self.getCurScope());
        let mut NormalScope: ParsingOpenMPDirectiveRAII = ParsingOpenMPDirectiveRAII { P: *self, OldVal: false };
        {
            let mut Scope: CompoundScopeRAII = CompoundScopeRAII { self.Actions, false };
            AssociatedStmt = self.ParseStatement(null, SubStmt, null);
            if AssociatedStmt.isUsable() && isOpenMPLoopDirective(DKind) && self.getLangOpts().OpenMPIRBuilder {
                AssociatedStmt = self.Actions.OpenMP().ActOnOpenMPLoopnest(AssociatedStmt.get());
            }
        }
        AssociatedStmt = self.Actions.OpenMP().ActOnOpenMPRegionEnd(AssociatedStmt, Clauses);
    } else if DKind == OMPD_target_update || DKind == OMPD_target_enter_data || DKind == OMPD_target_exit_data {
        self.Actions.OpenMP().ActOnOpenMPRegionStart(DKind, self.getCurScope());
        AssociatedStmt = (CompoundScopeRAII { self.Actions, false } , self.Actions.ActOnCompoundStmt(Loc, Loc, ArrayRef<Stmt *> {}, false));
        AssociatedStmt = self.Actions.OpenMP().ActOnOpenMPRegionEnd(AssociatedStmt, Clauses);
    }
    let mut Directive: StmtResult = self.Actions.OpenMP().ActOnOpenMPExecutableDirective(DKind, DirName, CancelRegion, Clauses, AssociatedStmt.get(), Loc, EndLoc);
    self.Actions.OpenMP().EndOpenMPDSABlock(Directive.get());
    OMPDirectiveScope.Exit();
    return Directive;
}

fn Parser::ParseOpenMPInformationalDirective(self, StmtCtx: ParsedStmtContext, DKind: OpenMPDirectiveKind, Loc: SourceLocation, ReadDirectiveWithinMetadirective: bool) -> StmtResult {
    assert!(isOpenMPInformationalDirective(DKind), "Unexpected directive category");
    let mut HasAssociatedStatement: bool = true;
    let mut Clauses: SmallVector<OMPClause *, 5> = SmallVector<OMPClause *, 5> {};
    let mut SeenClauses: SmallBitVector = SmallBitVector { Clause_enumSize + 1, false };
    let mut DirName: DeclarationNameInfo = DeclarationNameInfo {};
    let mut ScopeFlags: u32 = FnScope | DeclScope | CompoundStmtScope | OpenMPDirectiveScope;
    let mut OMPDirectiveScope: ParseScope = ParseScope { self, ScopeFlags, true, false };
    self.Actions.OpenMP().StartOpenMPDSABlock(DKind, DirName, self.Actions.getCurScope(), Loc);
    while self.Tok.isNot(annot_pragma_openmp_end) {
        if ReadDirectiveWithinMetadirective && self.Tok.is(r_paren) {
            while self.Tok.isNot(annot_pragma_openmp_end) {
                self.ConsumeAnyToken(false);
            }
            break;
        }
        let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
        self.Actions.OpenMP().StartOpenMPClause(CKind);
        let mut Clause: *mut OMPClause = self.ParseOpenMPClause(DKind, CKind, !SeenClauses[CKind]);
        SeenClauses[CKind] = true;
        if Clause {
            Clauses.push(Clause);
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
        self.Actions.OpenMP().EndOpenMPClause();
    }
    let mut EndLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeAnnotationToken();
    let mut AssociatedStmt: StmtResult = false;
    if HasAssociatedStatement {
        self.Actions.OpenMP().ActOnOpenMPRegionStart(DKind, self.getCurScope());
        let mut NormalScope: ParsingOpenMPDirectiveRAII = ParsingOpenMPDirectiveRAII { P: *self, OldVal: false };
        {
            let mut Scope: CompoundScopeRAII = CompoundScopeRAII { self.Actions, false };
            AssociatedStmt = self.ParseStatement(null, SubStmt, null);
        }
        AssociatedStmt = self.Actions.OpenMP().ActOnOpenMPRegionEnd(AssociatedStmt, Clauses);
    }
    let mut Directive: StmtResult = self.Actions.OpenMP().ActOnOpenMPInformationalDirective(DKind, DirName, Clauses, AssociatedStmt.get(), Loc, EndLoc);
    self.Actions.OpenMP().EndOpenMPDSABlock(Directive.get());
    OMPDirectiveScope.Exit();
    return Directive;
}

fn Parser::ParseOpenMPDeclarativeOrExecutableDirective(self, StmtCtx: ParsedStmtContext, ReadDirectiveWithinMetadirective: bool) -> StmtResult {
    if !ReadDirectiveWithinMetadirective {
        assert!(self.Tok.isOneOf(annot_pragma_openmp, annot_attr_openmp), "Not an OpenMP directive!");
    }
    let mut DirScope: ParsingOpenMPDirectiveRAII = ParsingOpenMPDirectiveRAII { P: *self, OldVal: true };
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    let mut Loc: SourceLocation = if ReadDirectiveWithinMetadirective { self.Tok.getLocation() } else { self.ConsumeAnnotationToken() };
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    let mut DKind: OpenMPDirectiveKind = parseOpenMPDirectiveKind(*self);
    if ReadDirectiveWithinMetadirective && DKind == OMPD_unknown {
        self.Diag(self.Tok, err_omp_unknown_directive);
        return StmtError();
    }
    let mut Directive: StmtResult = StmtError();
    let mut IsExecutable: bool = Closure_10 { DKind: &mut DKind }.call();
    if IsExecutable {
        Directive = self.ParseOpenMPExecutableDirective(StmtCtx, DKind, Loc, ReadDirectiveWithinMetadirective);
        assert!(!Directive.isUnset(), "Executable directive remained unprocessed");
        return Directive;
    }
    match DKind {
        OMPD_nothing => {
            self.ConsumeToken();
        },
        OMPD_metadirective => {
            self.ConsumeToken();
            let mut VMIs: SmallVector<VariantMatchInfo, 4> = SmallVector<VariantMatchInfo, 4> {};
            let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
            let mut ASTContext: *mut ASTContext = self.Actions.getASTContext();
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
            while self.Tok.isNot(annot_pragma_openmp_end) {
                let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
                if CKind == OMPC_unknown {
                    self.Diag(self.Tok, err_omp_expected_clause) << "metadirective";
                    TPA.Revert();
                    self.SkipUntil(annot_pragma_openmp_end, 0 as SkipUntilFlags);
                    return Directive;
                }
                if self.getLangOpts().OpenMP < 52 && CKind == OMPC_otherwise {
                    self.Diag(self.Tok, err_omp_unexpected_clause) << getOpenMPClauseName(CKind, 0) << "metadirective";
                }
                if CKind == OMPC_default && self.getLangOpts().OpenMP >= 52 {
                    self.Diag(self.Tok, warn_omp_default_deprecated);
                }
                let mut Loc: SourceLocation = self.ConsumeToken();
                if T.expectAndConsume(err_expected_lparen_after, getOpenMPClauseName(CKind, 0).ptr, unknown) {
                    TPA.Revert();
                    self.SkipUntil(annot_pragma_openmp_end, 0 as SkipUntilFlags);
                    return Directive;
                }
                let mut TI: *mut OMPTraitInfo = self.Actions.getASTContext().getNewOMPTraitInfo();
                if CKind == OMPC_when {
                    self.parseOMPContextSelectors(Loc, TI);
                    if TI.Sets.len == 0 {
                        self.Diag(self.Tok, err_omp_expected_context_selector) << "when clause";
                        TPA.Commit();
                        return Directive;
                    }
                    if self.Tok.is(colon) {
                        self.ConsumeAnyToken(false);
                    } else {
                        self.Diag(self.Tok, err_omp_expected_colon) << "when clause";
                        TPA.Commit();
                        return Directive;
                    }
                }
                let mut paren: i32 = 0;
                while self.Tok.isNot(r_paren) || paren != 0 {
                    if self.Tok.is(l_paren) {
                        paren += 1;
                    }
                    if self.Tok.is(r_paren) {
                        paren -= 1;
                    }
                    if self.Tok.is(annot_pragma_openmp_end) {
                        self.Diag(self.Tok, err_omp_expected_punc) << getOpenMPClauseName(CKind, 0) << 0;
                        TPA.Commit();
                        return Directive;
                    }
                    self.ConsumeAnyToken(false);
                }
                if self.Tok.is(r_paren) {
                    T.consumeClose();
                }
                let mut VMI: VariantMatchInfo = VariantMatchInfo {};
                TI.getAsVariantMatchInfo(ASTContext, VMI);
                VMIs.push(VMI);
            }
            TPA.Revert();
            let mut DiagUnknownTrait: function<void (StringRef)> = Closure_11 { cap_0: self, cap_1: Loc };
            let mut OMPCtx: TargetOMPContext = TargetOMPContext { ActiveTraits: ASTContext, ConstructTraits: move(DiagUnknownTrait), FeatureValidityCheck: null, DiagUnknownTrait: TraitProperty> {}, FeatureMap: self.Actions.OpenMP().getOpenMPDeviceNum() };
            let mut BestIdx: i32 = getBestVariantMatchForContext(VMIs, OMPCtx);
            let mut Idx: i32 = 0;
            while self.Tok.isNot(annot_pragma_openmp_end) {
                if Idx += 1 != BestIdx {
                    self.ConsumeToken();
                    T.consumeOpen();
                    let mut paren: i32 = 0;
                    while self.Tok.isNot(r_paren) || paren != 0 {
                        if self.Tok.is(l_paren) {
                            paren += 1;
                        }
                        if self.Tok.is(r_paren) {
                            paren -= 1;
                        }
                        self.ConsumeAnyToken(false);
                    }
                    if self.Tok.is(r_paren) {
                        T.consumeClose();
                    }
                    continue;
                }
                let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
                let mut Loc: SourceLocation = self.ConsumeToken();
                T.consumeOpen();
                if CKind == OMPC_when {
                    let mut TI: *mut OMPTraitInfo = self.Actions.getASTContext().getNewOMPTraitInfo();
                    self.parseOMPContextSelectors(Loc, TI);
                    self.ConsumeAnyToken(false);
                }
                if self.Tok.is(r_paren) {
                    self.SkipUntil(annot_pragma_openmp_end, 0 as SkipUntilFlags);
                    break;
                }
                Directive = self.ParseOpenMPDeclarativeOrExecutableDirective(StmtCtx, true);
                break;
            }
            if BestIdx == -1 && Idx > 0 {
                assert!(self.Tok.is(annot_pragma_openmp_end), "Expecting the end of the pragma here");
                self.ConsumeAnnotationToken();
                return StmtEmpty();
            }
            break;
        },
        OMPD_threadprivate => {
            if (StmtCtx & AllowStandaloneOpenMPDirectives) ==  {
                self.Diag(self.Tok, err_omp_immediate_directive) << getOpenMPDirectiveName(DKind, OMPVersion) << 0;
            }
            self.ConsumeToken();
            let mut Helper: DeclDirectiveListParserHelper = DeclDirectiveListParserHelper { self, DKind };
            if !self.ParseOpenMPSimpleVarList(DKind, function_ref<void (CXXScopeSpec &, DeclarationNameInfo)> { Helper, null, null }, false) {
                self.skipUntilPragmaOpenMPEnd(DKind);
                let mut Res: DeclGroupPtrTy = self.Actions.OpenMP().ActOnOpenMPThreadprivateDirective(Loc, Helper.getIdentifiers());
                Directive = self.Actions.ActOnDeclStmt(Res, Loc, self.Tok.getLocation());
            }
            self.SkipUntil(annot_pragma_openmp_end, 0 as SkipUntilFlags);
            break;
        },
        OMPD_groupprivate => {
            if (StmtCtx & AllowStandaloneOpenMPDirectives) ==  {
                self.Diag(self.Tok, err_omp_immediate_directive) << getOpenMPDirectiveName(DKind, OMPVersion) << 0;
            }
            self.ConsumeToken();
            let mut Helper: DeclDirectiveListParserHelper = DeclDirectiveListParserHelper { self, DKind };
            if !self.ParseOpenMPSimpleVarList(DKind, function_ref<void (CXXScopeSpec &, DeclarationNameInfo)> { Helper, null, null }, false) {
                self.skipUntilPragmaOpenMPEnd(DKind);
                let mut Res: DeclGroupPtrTy = self.Actions.OpenMP().ActOnOpenMPGroupPrivateDirective(Loc, Helper.getIdentifiers());
                Directive = self.Actions.ActOnDeclStmt(Res, Loc, self.Tok.getLocation());
            }
            self.SkipUntil(annot_pragma_openmp_end, 0 as SkipUntilFlags);
            break;
        },
        OMPD_allocate => {
            if (StmtCtx & AllowStandaloneOpenMPDirectives) ==  {
                self.Diag(self.Tok, err_omp_immediate_directive) << getOpenMPDirectiveName(DKind, OMPVersion) << 0;
            }
            self.ConsumeToken();
            let mut Helper: DeclDirectiveListParserHelper = DeclDirectiveListParserHelper { self, DKind };
            if !self.ParseOpenMPSimpleVarList(DKind, function_ref<void (CXXScopeSpec &, DeclarationNameInfo)> { Helper, null, null }, false) {
                let mut Clauses: SmallVector<OMPClause *, 1> = SmallVector<OMPClause *, 1> {};
                if self.Tok.isNot(annot_pragma_openmp_end) {
                    let mut SeenClauses: SmallBitVector = SmallBitVector { Clause_enumSize + 1, false };
                    while self.Tok.isNot(annot_pragma_openmp_end) {
                        let mut CKind: OpenMPClauseKind = if self.Tok.isAnnotation() { OMPC_unknown } else { getOpenMPClauseKind(self.PP.getSpelling(self.Tok, null)) };
                        self.Actions.OpenMP().StartOpenMPClause(CKind);
                        let mut Clause: *mut OMPClause = self.ParseOpenMPClause(OMPD_allocate, CKind, !SeenClauses[CKind]);
                        self.SkipUntil(comma, identifier, annot_pragma_openmp_end, StopBeforeMatch);
                        SeenClauses[CKind] = true;
                        if Clause != null {
                            Clauses.push(Clause);
                        }
                        if self.Tok.is(annot_pragma_openmp_end) {
                            self.Actions.OpenMP().EndOpenMPClause();
                            break;
                        }
                        if self.Tok.is(comma) {
                            self.ConsumeToken();
                        }
                        self.Actions.OpenMP().EndOpenMPClause();
                    }
                    self.skipUntilPragmaOpenMPEnd(DKind);
                }
                let mut Res: DeclGroupPtrTy = self.Actions.OpenMP().ActOnOpenMPAllocateDirective(Loc, Helper.getIdentifiers(), Clauses, null);
                Directive = self.Actions.ActOnDeclStmt(Res, Loc, self.Tok.getLocation());
            }
            self.SkipUntil(annot_pragma_openmp_end, 0 as SkipUntilFlags);
            break;
        },
        OMPD_declare_reduction => {
            self.ConsumeToken();
        },
        OMPD_declare_mapper => {
            self.ConsumeToken();
            if self.ParseOpenMPDeclareMapperDirective(AS_none) {
                Res;
            } else {
                self.ConsumeAnnotationToken();
                Directive = self.Actions.ActOnDeclStmt(Res, Loc, self.Tok.getLocation());
            }
            break;
        },
        OMPD_declare_target => {
            let mut DTLoc: SourceLocation = self.ConsumeAnyToken(false);
            let mut HasClauses: bool = self.Tok.isNot(annot_pragma_openmp_end);
            let mut DTCI: DeclareTargetContextInfo = DeclareTargetContextInfo { DKind, DTLoc };
            if HasClauses {
                self.ParseOMPDeclareTargetClauses(DTCI);
            }
            let mut HasImplicitMappings: bool = !HasClauses || (DTCI.ExplicitlyMapped.is_empty() && DTCI.Indirect);
            if HasImplicitMappings {
                self.Diag(self.Tok, err_omp_unexpected_directive) << 1 << getOpenMPDirectiveName(DKind, OMPVersion);
                self.SkipUntil(annot_pragma_openmp_end, 0 as SkipUntilFlags);
                break;
            }
            self.ConsumeAnyToken(false);
            self.Actions.OpenMP().ActOnFinishedOpenMPDeclareTargetContext(DTCI);
            break;
        },
        OMPD_begin_declare_variant => {
            self.ConsumeToken();
            if !self.ParseOpenMPDeclareBeginVariantDirective(Loc) {
                if !self.isEofOrEom() {
                    self.ConsumeAnnotationToken();
                }
            }
            return Directive;
        },
        OMPD_end_declare_variant => {
            self.ConsumeToken();
            if self.Actions.OpenMP().isInOpenMPDeclareVariantScope() {
                self.Actions.OpenMP().ActOnOpenMPEndDeclareVariant();
            } else {
                self.Diag(Loc, err_expected_begin_declare_variant);
            }
            self.ConsumeAnnotationToken();
            break;
        },
        OMPD_declare_simd => {
            OMPD_begin_declare_target;
        },
        OMPD_assume => {
            self.ConsumeToken();
            Directive = self.ParseOpenMPInformationalDirective(StmtCtx, DKind, Loc, ReadDirectiveWithinMetadirective);
            assert!(!Directive.isUnset(), "Informational directive remains unprocessed");
            return Directive;
        },
        OMPD_unknown => {
            self.Diag(self.Tok, err_omp_unknown_directive);
        },
    }
    return Directive;
}

fn Parser::ParseOpenMPSimpleVarList(self, Kind: OpenMPDirectiveKind, Callback: *function_ref<void (CXXScopeSpec &, DeclarationNameInfo)>, AllowScopeSpecifier: bool) -> bool {
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPDirectiveName(Kind, OMPVersion).ptr, unknown) {
        return true;
    }
    let mut IsCorrect: bool = true;
    let mut NoIdentIsFound: bool = true;
    while self.Tok.isNot(r_paren) && self.Tok.isNot(annot_pragma_openmp_end) {
        let mut SS: CXXScopeSpec = CXXScopeSpec {};
        let mut Name: UnqualifiedId = UnqualifiedId {};
        let mut PrevTok: Token = self.Tok;
        NoIdentIsFound = false;
        if AllowScopeSpecifier && self.getLangOpts().CPlusPlus && self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, false, false, false, false, false) {
            IsCorrect = false;
            self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        } else if self.ParseUnqualifiedId(SS, null, false, false, false, false, false, null, Name) {
            IsCorrect = false;
            self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        } else if self.Tok.isNot(comma) && self.Tok.isNot(r_paren) && self.Tok.isNot(annot_pragma_openmp_end) {
            IsCorrect = false;
            self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
            self.Diag(PrevTok.getLocation(), err_expected) << identifier << SourceRange { B: PrevTok.getLocation(), E: self.PrevTokLocation };
        } else {
            Callback.call(SS, self.Actions.GetNameFromUnqualifiedId(Name));
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
    }
    if NoIdentIsFound {
        self.Diag(self.Tok, err_expected) << identifier;
        IsCorrect = false;
    }
    IsCorrect = !T.consumeClose() && IsCorrect;
    return !IsCorrect;
}

fn Parser::ParseOpenMPSizesClause(self) -> *mut OMPClause {
    let mut ClauseNameLoc: SourceLocation = SourceLocation {};
    let mut OpenLoc: SourceLocation = SourceLocation {};
    let mut CloseLoc: SourceLocation = SourceLocation {};
    let mut ValExprs: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
    if self.ParseOpenMPExprListClause(OMPC_sizes, ClauseNameLoc, OpenLoc, CloseLoc, ValExprs, false) {
        return null;
    }
    return self.Actions.OpenMP().ActOnOpenMPSizesClause(ValExprs, ClauseNameLoc, OpenLoc, CloseLoc);
}

fn Parser::ParseOpenMPCountsClause(self) -> *mut OMPClause {
    let mut ClauseNameLoc: SourceLocation = SourceLocation {};
    let mut OpenLoc: SourceLocation = SourceLocation {};
    let mut CloseLoc: SourceLocation = SourceLocation {};
    let mut ValExprs: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
    let mut FillIdx: optional<unsigned int> = optional<unsigned int> {};
    let mut FillCount: u32 = 0;
    let mut FillLoc: SourceLocation = SourceLocation {};
    assert!(getOpenMPClauseName(OMPC_counts, 0) == self.PP.getSpelling(self.Tok, null), "Expected parsing to start at clause name");
    ClauseNameLoc = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        return null;
    }
    while true {
        {
        if self.Tok.is(identifier) && self.Tok.getIdentifierInfo().getName() == "omp_fill" {
            if FillCount == 0 {
                FillIdx = ValExprs.len;
            }
            FillCount += 1;
            FillLoc = self.Tok.getLocation();
            self.ConsumeToken();
            ValExprs.push(null);
        } else {
            let mut Val: ExprResult = self.ParseConstantExpression();
            if !Val.isUsable() {
                T.skipToEnd();
                return null;
            }
            ValExprs.push(Val.get());
        }
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    if T.consumeClose() {
        return null;
    }
    OpenLoc = T.getOpenLocation();
    CloseLoc = T.getCloseLocation();
    return self.Actions.OpenMP().ActOnOpenMPCountsClause(ValExprs, ClauseNameLoc, OpenLoc, CloseLoc, FillIdx, FillLoc, FillCount);
}

fn Parser::ParseOpenMPLoopRangeClause(self) -> *mut OMPClause {
    let mut ClauseNameLoc: SourceLocation = self.ConsumeToken();
    let mut FirstLoc: SourceLocation = SourceLocation {};
    let mut CountLoc: SourceLocation = SourceLocation {};
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        return null;
    }
    FirstLoc = self.Tok.getLocation();
    let mut FirstVal: ExprResult = self.ParseConstantExpression();
    if !FirstVal.isUsable() {
        T.skipToEnd();
        return null;
    }
    self.ExpectAndConsume(comma, err_expected, "");
    CountLoc = self.Tok.getLocation();
    let mut CountVal: ExprResult = self.ParseConstantExpression();
    if !CountVal.isUsable() {
        T.skipToEnd();
        return null;
    }
    T.consumeClose();
    return self.Actions.OpenMP().ActOnOpenMPLoopRangeClause(FirstVal.get(), CountVal.get(), ClauseNameLoc, T.getOpenLocation(), FirstLoc, CountLoc, T.getCloseLocation());
}

fn Parser::ParseOpenMPPermutationClause(self) -> *mut OMPClause {
    let mut ClauseNameLoc: SourceLocation = SourceLocation {};
    let mut OpenLoc: SourceLocation = SourceLocation {};
    let mut CloseLoc: SourceLocation = SourceLocation {};
    let mut ArgExprs: SmallVector<Expr *> = SmallVector<Expr *> {};
    if self.ParseOpenMPExprListClause(OMPC_permutation, ClauseNameLoc, OpenLoc, CloseLoc, ArgExprs, true) {
        return null;
    }
    return self.Actions.OpenMP().ActOnOpenMPPermutationClause(ArgExprs, ClauseNameLoc, OpenLoc, CloseLoc);
}

fn Parser::ParseOpenMPUsesAllocatorClause(self, DKind: OpenMPDirectiveKind) -> *mut OMPClause {
    let mut Loc: SourceLocation = self.Tok.getLocation();
    self.ConsumeAnyToken(false);
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, "uses_allocator", unknown) {
        return null;
    }
    let mut Data: UsesAllocatorsData, 4> = UsesAllocatorsData, 4> {};
    while true {
        {
        if self.getLangOpts().OpenMP >= 52 && self.Tok.is(identifier) && self.Tok.getIdentifierInfo().getName() == "traits" {
            let mut D: *mut UsesAllocatorsData = Data.push();
            self.ConsumeToken();
            let mut TraitParens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
            TraitParens.consumeOpen();
            let mut AllocatorTraits: ExprResult = if self.getLangOpts().CPlusPlus { self.ParseCXXIdExpression(false) } else { self.ParseExpression(AllowNonTypes) };
            TraitParens.consumeClose();
            if AllocatorTraits.isInvalid() {
                self.SkipUntil([comma, semi, r_paren, annot_pragma_openmp_end], StopBeforeMatch);
                break;
            }
            if self.Tok.isNot(colon) {
                self.Diag(self.Tok, err_expected) << colon;
                self.SkipUntil([comma, semi, r_paren, annot_pragma_openmp_end], StopBeforeMatch);
                continue;
            }
            self.ConsumeToken();
            let mut SS: CXXScopeSpec = CXXScopeSpec {};
            let mut AllocatorExpr: ExprResult = if self.getLangOpts().CPlusPlus { self.ParseCXXIdExpression(false) } else { self.tryParseCXXIdExpression(SS, false) };
            if AllocatorExpr.isInvalid() {
                self.SkipUntil([comma, semi, r_paren, annot_pragma_openmp_end], StopBeforeMatch);
                break;
            }
            D.Allocator = AllocatorExpr.get();
            D.AllocatorTraits = AllocatorTraits.get();
            D.LParenLoc = TraitParens.getOpenLocation();
            D.RParenLoc = TraitParens.getCloseLocation();
            if self.Tok.is(comma) {
                self.Diag(self.Tok.getLocation(), err_omp_allocator_comma_separator) << CreateReplacement(self.Tok.getLocation(), ";");
                self.ConsumeAnyToken(false);
            } else if self.Tok.is(semi) {
                self.ConsumeAnyToken(false);
            }
            continue;
        }
        let mut SS: CXXScopeSpec = CXXScopeSpec {};
        let mut Allocator: ExprResult = if self.getLangOpts().CPlusPlus { self.ParseCXXIdExpression(false) } else { self.tryParseCXXIdExpression(SS, false) };
        if Allocator.isInvalid() {
            self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
            break;
        }
        let mut D: *mut UsesAllocatorsData = Data.push();
        D.Allocator = Allocator.get();
        if self.Tok.is(l_paren) {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
            T.consumeOpen();
            let mut AllocatorTraits: ExprResult = if self.getLangOpts().CPlusPlus { self.ParseCXXIdExpression(false) } else { self.ParseExpression(AllowNonTypes) };
            T.consumeClose();
            if AllocatorTraits.isInvalid() {
                self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
                break;
            }
            D.AllocatorTraits = AllocatorTraits.get();
            D.LParenLoc = T.getOpenLocation();
            D.RParenLoc = T.getCloseLocation();
            if self.getLangOpts().OpenMP >= 52 {
                self.Diag(Loc, err_omp_deprecate_old_syntax) << "allocator(expr)" << "uses_allocators" << "traits(expr): alloc";
            }
        }
        if self.Tok.isNot(comma) && self.Tok.isNot(r_paren) {
            self.Diag(self.Tok, err_omp_expected_punc) << "uses_allocators" << 0;
        }
        if self.Tok.is(comma) {
            self.ConsumeAnyToken(false);
        }
    }
        if !(self.Tok.isNot(r_paren) && self.Tok.isNot(annot_pragma_openmp_end)) { break; }
    }
    T.consumeClose();
    return self.Actions.OpenMP().ActOnOpenMPUsesAllocatorClause(Loc, T.getOpenLocation(), T.getCloseLocation(), Data);
}

fn Parser::ParseOpenMPClause(self, DKind: OpenMPDirectiveKind, CKind: OpenMPClauseKind, FirstClause: bool) -> *mut OMPClause {
    self.OMPClauseKind = CKind;
    let mut Clause: *mut OMPClause = null;
    let mut ErrorFound: bool = false;
    let mut WrongDirective: bool = false;
    let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
    let mut CheckClauseValid: Closure_12 = Closure_12 { OMPVersion: &mut OMPVersion, cap_1: self, ErrorFound: &mut ErrorFound, WrongDirective: &mut WrongDirective };
    if CKind != OMPC_unknown {
        assert!(DKind != OMPD_ordered_blockassoc, "Wrong kind for ordered directive");
        if DKind == OMPD_ordered_standalone {
            if !isAllowedClauseForDirective(DKind, CKind, OMPVersion) {
                CheckClauseValid.call(OMPD_ordered_blockassoc, CKind);
            }
        } else {
            CheckClauseValid.call(DKind, CKind);
        }
    }
    match CKind {
        OMPC_final => {
            OMPC_safelen;
        },
        OMPC_threadset => {
            OMPC_fail;
        },
        OMPC_device => {
            OMPC_schedule;
        },
        OMPC_if => {
            Clause = self.ParseOpenMPSingleExprWithArgClause(DKind, CKind, WrongDirective);
        },
        OMPC_holds => {
            Clause = self.ParseOpenMPSingleExprClause(CKind, WrongDirective);
        },
        OMPC_nowait => {
            OMPC_untied;
        },
        OMPC_self_maps => {
            if self.getLangOpts().OpenMP < 60 {
                self.Diag(self.Tok, err_omp_expected_clause) << getOpenMPDirectiveName(OMPD_requires, OMPVersion);
                ErrorFound = true;
            }
        },
        OMPC_update => {
            if !FirstClause {
                self.Diag(self.Tok, err_omp_more_one_clause) << getOpenMPDirectiveName(DKind, OMPVersion) << getOpenMPClauseName(CKind, 0) << 0;
                ErrorFound = true;
            }
        },
        OMPC_update_depend_objects => {
            if !FirstClause {
                self.Diag(self.Tok, err_omp_more_one_clause) << getOpenMPDirectiveName(DKind, OMPVersion) << getOpenMPClauseName(CKind, 0) << 0;
                ErrorFound = true;
            }
        },
        OMPC_num_teams => {
            OMPC_thread_limit;
        },
        OMPC_private => {
            OMPC_firstprivate;
        },
        OMPC_sizes => {
            if !FirstClause {
                self.Diag(self.Tok, err_omp_more_one_clause) << getOpenMPDirectiveName(DKind, OMPVersion) << getOpenMPClauseName(CKind, 0) << 0;
                ErrorFound = true;
            }
        },
        OMPC_permutation => {
            if !FirstClause {
                self.Diag(self.Tok, err_omp_more_one_clause) << getOpenMPDirectiveName(DKind, OMPVersion) << getOpenMPClauseName(CKind, 0) << 0;
                ErrorFound = true;
            }
        },
        OMPC_counts => {
            if !FirstClause {
                self.Diag(self.Tok, err_omp_more_one_clause) << getOpenMPDirectiveName(DKind, OMPVersion) << getOpenMPClauseName(CKind, 0) << 0;
                ErrorFound = true;
            }
        },
        OMPC_uses_allocators => {
            Clause = self.ParseOpenMPUsesAllocatorClause(DKind);
        },
        OMPC_destroy => {
            if DKind != OMPD_interop {
                if !FirstClause {
                    self.Diag(self.Tok, err_omp_more_one_clause) << getOpenMPDirectiveName(DKind, OMPVersion) << getOpenMPClauseName(CKind, 0) << 0;
                    ErrorFound = true;
                }
                Clause = self.ParseOpenMPClause(CKind, WrongDirective);
                break;
            }
        },
        OMPC_init => {
            OMPC_use;
        },
        OMPC_device_type => {
            OMPC_unknown;
        },
        OMPC_threadprivate => {
            OMPC_groupprivate;
        },
        OMPC_absent => {
            OMPC_contains;
        },
        OMPC_no_openmp => {
            OMPC_no_openmp_routines;
        },
        OMPC_ompx_attribute => {
            Clause = self.ParseOpenMPOMPXAttributesClause(WrongDirective);
        },
        OMPC_ompx_bare => {
            if DKind == OMPD_target {
                self.Diag(self.Tok, err_omp_unexpected_clause) << getOpenMPClauseName(CKind, 0) << getOpenMPDirectiveName(DKind, OMPVersion);
                ErrorFound = true;
                WrongDirective = true;
            }
        },
        OMPC_looprange => {
            Clause = self.ParseOpenMPLoopRangeClause();
        },
        _ => {
            break;
        },
    }
    return if ErrorFound { null } else { Clause };
}

fn Parser::ParseOpenMPParensExpr(self, ClauseName: str, RLoc: *mut SourceLocation, IsAddressOfOperand: bool) -> ExprResult {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, ClauseName.ptr, unknown) {
        return ExprError();
    }
    let mut ELoc: SourceLocation = self.Tok.getLocation();
    let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, IsAddressOfOperand, AllowNonTypes, false, null);
    let mut Val: ExprResult = self.ParseRHSOfBinaryExpression(LHS, Conditional);
    Val = self.Actions.ActOnFinishFullExpr(Val.get(), ELoc, false, false, false);
    RLoc = self.Tok.getLocation();
    if !T.consumeClose() {
        RLoc = T.getCloseLocation();
    }
    return Val;
}

fn Parser::ParseOpenMPSingleExprClause(self, Kind: OpenMPClauseKind, ParseOnly: bool) -> *mut OMPClause {
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut LLoc: SourceLocation = self.Tok.getLocation();
    let mut RLoc: SourceLocation = SourceLocation {};
    let mut Val: ExprResult = self.ParseOpenMPParensExpr(getOpenMPClauseName(Kind, 0), RLoc, false);
    if Val.isInvalid() {
        return null;
    }
    if ParseOnly {
        return null;
    }
    return self.Actions.OpenMP().ActOnOpenMPSingleExprClause(Kind, Val.get(), Loc, LLoc, RLoc);
}

fn Parser::ParseOpenMPIndirectClause(self, DTCI: *mut DeclareTargetContextInfo, ParseOnly: bool) -> bool {
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut RLoc: SourceLocation = SourceLocation {};
    if self.Tok.isNot(l_paren) {
        if ParseOnly {
            return false;
        }
        DTCI.Indirect = null;
        return true;
    }
    let mut Val: ExprResult = self.ParseOpenMPParensExpr(getOpenMPClauseName(OMPC_indirect, 0), RLoc, false);
    if Val.isInvalid() {
        return false;
    }
    if ParseOnly {
        return false;
    }
    if !Val.get().isValueDependent() && !Val.get().isTypeDependent() && !Val.get().isInstantiationDependent() && !Val.get().containsUnexpandedParameterPack() {
        let mut Ret: ExprResult = self.Actions.CheckBooleanCondition(Loc, Val.get(), false);
        if Ret.isInvalid() {
            return false;
        }
        let mut Result: APSInt = APSInt {};
        Ret = self.Actions.VerifyIntegerConstantExpression(Val.get(), &mut Result, Allow);
        if Ret.isInvalid() {
            return false;
        }
        DTCI.Indirect = Val.get();
        return true;
    }
    return false;
}

fn Parser::ParseOMPInteropFrSelector(self) -> ExprResult {
    self.ConsumeToken();
    let mut FT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if FT.expectAndConsume(err_expected_lparen_after, "fr", unknown) {
        self.SkipUntil([comma, r_brace, r_paren, annot_pragma_openmp_end], StopBeforeMatch);
        return ExprError();
    }
    let mut Loc: SourceLocation = self.Tok.getLocation();
    let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
    let mut Arg: ExprResult = self.ParseRHSOfBinaryExpression(LHS, Conditional);
    Arg = self.Actions.ActOnFinishFullExpr(Arg.get(), Loc, false, false, false);
    FT.consumeClose();
    return Arg;
}

fn Parser::ParseOMPInteropAttrSelector(self, Attrs: *mut SmallVectorImpl<Expr *>) -> bool {
    self.ConsumeToken();
    let mut AT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if AT.expectAndConsume(err_expected_lparen_after, "attr", unknown) {
        self.SkipUntil([comma, r_brace, r_paren, annot_pragma_openmp_end], StopBeforeMatch);
        return true;
    }
    let mut HasError: bool = false;
    if self.Tok.is(r_paren) {
        self.Diag(self.Tok, err_omp_interop_attr_not_string);
        HasError = true;
    }
    while self.Tok.isNot(r_paren) && self.Tok.isNot(r_brace) && self.Tok.isNot(annot_pragma_openmp_end) {
        if self.Tok.is(string_literal) {
            let mut S: ExprResult = self.ParseStringLiteralExpression(false);
            if S.isUsable() {
                Attrs.push(S.get());
            } else {
                HasError = true;
            }
        } else {
            HasError = true;
            self.Diag(self.Tok, err_omp_interop_attr_not_string);
            self.ConsumeToken();
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
    }
    AT.consumeClose();
    return HasError;
}

fn Parser::ParseOMPInteropInfo(self, InteropInfo: *mut OMPInteropInfo, Kind: OpenMPClauseKind) -> bool {
    let mut Tok: *Token = self.getCurToken();
    let mut HasError: bool = false;
    let mut IsTarget: bool = false;
    let mut IsTargetSync: bool = false;
    while Tok.is(identifier) {
        let mut PreferTypeAllowed: bool = (Kind == OMPC_init || Kind == OMPC_append_args) && InteropInfo.Prefs.is_empty() && !IsTarget && !IsTargetSync;
        if Tok.getIdentifierInfo().isStr("target") {
            if IsTarget {
                self.Diag(Tok, warn_omp_more_one_interop_type) << "target";
            }
            IsTarget = true;
            self.ConsumeToken();
        } else if Tok.getIdentifierInfo().isStr("targetsync") {
            if IsTargetSync {
                self.Diag(Tok, warn_omp_more_one_interop_type) << "targetsync";
            }
            IsTargetSync = true;
            self.ConsumeToken();
        } else if Tok.getIdentifierInfo().isStr("prefer_type") && PreferTypeAllowed {
            if Kind == OMPC_append_args && self.getLangOpts().OpenMP < 60 {
                self.Diag(Tok, err_omp_append_args_prefer_type_60);
                HasError = true;
            }
            self.ConsumeToken();
            let mut PT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
            if PT.expectAndConsume(err_expected_lparen_after, "prefer_type", unknown) {
                HasError = true;
            }
            if Tok.is(r_paren) {
                self.Diag(Tok, err_omp_expected_pref_spec);
                HasError = true;
            }
            while Tok.isNot(r_paren) && Tok.isNot(annot_pragma_openmp_end) {
                if Tok.is(l_brace) {
                    if self.getLangOpts().OpenMP < 60 {
                        self.Diag(Tok, err_omp_prefer_type_brace_60);
                        HasError = true;
                    }
                    let mut BT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, annot_pragma_openmp_end };
                    BT.consumeOpen();
                    let mut FrExpr: *mut Expr = null;
                    let mut AttrExprs: SmallVector<Expr *, 2> = SmallVector<Expr *, 2> {};
                    let mut SeenFr: bool = false;
                    if Tok.is(r_brace) {
                        self.Diag(Tok, err_omp_expected_fr_or_attr_selector);
                        HasError = true;
                    }
                    while Tok.isNot(r_brace) && Tok.isNot(annot_pragma_openmp_end) {
                        if Tok.is(identifier) && Tok.getIdentifierInfo().isStr("fr") {
                            if SeenFr {
                                self.Diag(Tok, err_omp_interop_multiple_fr);
                                HasError = true;
                                self.ConsumeToken();
                                self.SkipUntil([comma, r_brace, annot_pragma_openmp_end], StopBeforeMatch);
                                continue;
                            }
                            SeenFr = true;
                            let mut Fr: ExprResult = self.ParseOMPInteropFrSelector();
                            if Fr.isUsable() {
                                FrExpr = Fr.get();
                            } else {
                                HasError = true;
                            }
                        } else if Tok.is(identifier) && Tok.getIdentifierInfo().isStr("attr") {
                            if self.ParseOMPInteropAttrSelector(AttrExprs) {
                                HasError = true;
                            }
                        } else {
                            HasError = true;
                            self.Diag(Tok, err_omp_expected_fr_or_attr_selector);
                            self.ConsumeToken();
                        }
                        if Tok.is(comma) {
                            self.ConsumeToken();
                        }
                    }
                    if BT.consumeClose() {
                        HasError = true;
                    }
                    if FrExpr || !AttrExprs.is_empty() {
                        InteropInfo.Prefs.push(FrExpr, AttrExprs);
                    }
                    InteropInfo.HasPreferAttrs = true;
                } else {
                    let mut Loc: SourceLocation = Tok.getLocation();
                    let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
                    let mut PTExpr: ExprResult = self.ParseRHSOfBinaryExpression(LHS, Conditional);
                    PTExpr = self.Actions.ActOnFinishFullExpr(PTExpr.get(), Loc, false, false, false);
                    if PTExpr.isUsable() {
                        InteropInfo.Prefs.push(PTExpr.get(), SmallVector<Expr *, 2> {});
                    } else {
                        HasError = true;
                        self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
                    }
                }
                if Tok.is(comma) {
                    self.ConsumeToken();
                }
            }
            PT.consumeClose();
        } else {
            HasError = true;
            self.Diag(Tok, err_omp_expected_interop_type);
            self.ConsumeToken();
        }
        if !Tok.is(comma) {
            break;
        }
        self.ConsumeToken();
    }
    if !HasError && !IsTarget && !IsTargetSync {
        self.Diag(Tok, err_omp_expected_interop_type);
        HasError = true;
    }
    if Kind == OMPC_init {
        if Tok.isNot(colon) && (IsTarget || IsTargetSync) {
            self.Diag(Tok, warn_pragma_expected_colon) << "interop types";
        }
        if Tok.is(colon) {
            self.ConsumeToken();
        }
    }
    InteropInfo.IsTarget = IsTarget;
    InteropInfo.IsTargetSync = IsTargetSync;
    return HasError;
}

fn Parser::ParseOpenMPInteropClause(self, Kind: OpenMPClauseKind, ParseOnly: bool) -> *mut OMPClause {
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPClauseName(Kind, 0).ptr, unknown) {
        return null;
    }
    let mut InteropError: bool = false;
    let mut InteropInfo: OMPInteropInfo = OMPInteropInfo { false, false };
    if Kind == OMPC_init {
        InteropError = self.ParseOMPInteropInfo(InteropInfo, OMPC_init);
    }
    let mut VarLoc: SourceLocation = self.Tok.getLocation();
    let mut InteropVarExpr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
    if !InteropVarExpr.isUsable() {
        self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
    }
    let mut RLoc: SourceLocation = self.Tok.getLocation();
    if !T.consumeClose() {
        RLoc = T.getCloseLocation();
    }
    if ParseOnly || !InteropVarExpr.isUsable() || InteropError {
        return null;
    }
    if Kind == OMPC_init {
        return self.Actions.OpenMP().ActOnOpenMPInitClause(InteropVarExpr.get(), InteropInfo, Loc, T.getOpenLocation(), VarLoc, RLoc);
    }
    if Kind == OMPC_use {
        return self.Actions.OpenMP().ActOnOpenMPUseClause(InteropVarExpr.get(), Loc, T.getOpenLocation(), VarLoc, RLoc);
    }
    if Kind == OMPC_destroy {
        return self.Actions.OpenMP().ActOnOpenMPDestroyClause(InteropVarExpr.get(), Loc, T.getOpenLocation(), VarLoc, RLoc);
    }
    llvm_unreachable_internal("Unexpected interop variable clause.", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenMP.cpp", 3994);
}

fn Parser::ParseOpenMPOMPXAttributesClause(self, ParseOnly: bool) -> *mut OMPClause {
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPClauseName(OMPC_ompx_attribute, 0).ptr, unknown) {
        return null;
    }
    let mut ParsedAttrs: ParsedAttributes = self.AttrFactory;
    self.ParseAttributes(PAKM_GNU | PAKM_CXX11, ParsedAttrs, null);
    if T.consumeClose() {
        return null;
    }
    if ParseOnly {
        return null;
    }
    let mut Attrs: SmallVector<Attr *> = SmallVector<Attr *> {};
    for PA in ParsedAttrs {
        match PA.getKind() {
            AT_AMDGPUFlatWorkGroupSize => {
                if !PA.checkExactlyNumArgs(self.Actions, 2) {
                    continue;
                }
            },
            AT_AMDGPUWavesPerEU => {
                if !PA.checkAtLeastNumArgs(self.Actions, 1) || !PA.checkAtMostNumArgs(self.Actions, 2) {
                    continue;
                }
            },
            AT_CUDALaunchBounds => {
                if !PA.checkAtLeastNumArgs(self.Actions, 1) || !PA.checkAtMostNumArgs(self.Actions, 3) {
                    continue;
                }
            },
            _ => {
                self.Diag(Loc, warn_omp_invalid_attribute_for_ompx_attributes) << PA;
            },
        }
    }
    return self.Actions.OpenMP().ActOnOpenMPXAttributeClause(Attrs, Loc, T.getOpenLocation(), T.getCloseLocation());
}

fn Parser::ParseOpenMPSimpleClause(self, Kind: OpenMPClauseKind, ParseOnly: bool) -> *mut OMPClause {
    let mut Val: optional<SimpleClauseData> = parseOpenMPSimpleClause(*self, Kind);
    if !Val || ParseOnly {
        return null;
    }
    if self.getLangOpts().OpenMP < 51 && Kind == OMPC_default && (operator(Val).Type as DefaultKind == OMP_DEFAULT_private || operator(Val).Type as DefaultKind == OMP_DEFAULT_firstprivate) {
        self.Diag(operator(Val).LOpen, err_omp_invalid_dsa) << getOpenMPClauseName(if operator(Val).Type as DefaultKind == OMP_DEFAULT_private { OMPC_private } else { OMPC_firstprivate }, 0) << getOpenMPClauseName(OMPC_default, 0) << "5.1";
        return null;
    }
    return self.Actions.OpenMP().ActOnOpenMPSimpleClause(Kind, operator(Val).Type, operator(Val).TypeLoc, operator(Val).LOpen, operator(Val).Loc, operator(Val).RLoc);
}

fn Parser::ParseOpenMPClause(self, Kind: OpenMPClauseKind, ParseOnly: bool) -> *mut OMPClause {
    let mut Loc: SourceLocation = self.Tok.getLocation();
    self.ConsumeAnyToken(false);
    if ParseOnly {
        return null;
    }
    return self.Actions.OpenMP().ActOnOpenMPClause(Kind, Loc, self.Tok.getLocation());
}

fn Parser::ParseOpenMPSingleExprWithArgClause(self, DKind: OpenMPDirectiveKind, Kind: OpenMPClauseKind, ParseOnly: bool) -> *mut OMPClause {
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut DelimLoc: SourceLocation = SourceLocation {};
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPClauseName(Kind, 0).ptr, unknown) {
        return null;
    }
    let mut Val: ExprResult = false;
    let mut Arg: SmallVector<unsigned int, 4> = SmallVector<unsigned int, 4> {};
    let mut KLoc: SmallVector<SourceLocation, 4> = SmallVector<SourceLocation, 4> {};
    if Kind == OMPC_schedule {
        Arg.resize(NumberOfElements);
        KLoc.resize(NumberOfElements);
        Arg[Modifier1] = OMPC_SCHEDULE_MODIFIER_unknown;
        Arg[Modifier2] = OMPC_SCHEDULE_MODIFIER_unknown;
        Arg[ScheduleKind] = OMPC_SCHEDULE_unknown;
        let mut KindModifier: u32 = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
        if KindModifier > OMPC_SCHEDULE_unknown {
            Arg[Modifier1] = KindModifier;
            KLoc[Modifier1] = self.Tok.getLocation();
            if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
                self.ConsumeAnyToken(false);
            }
            if self.Tok.is(comma) {
                self.ConsumeAnyToken(false);
                KindModifier = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
                Arg[Modifier2] = if KindModifier > OMPC_SCHEDULE_unknown { KindModifier } else { OMPC_SCHEDULE_unknown as u32 };
                KLoc[Modifier2] = self.Tok.getLocation();
                if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
                    self.ConsumeAnyToken(false);
                }
            }
            if self.Tok.is(colon) {
                self.ConsumeAnyToken(false);
            } else {
                self.Diag(self.Tok, warn_pragma_expected_colon) << "schedule modifier";
            }
            KindModifier = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
        }
        Arg[ScheduleKind] = KindModifier;
        KLoc[ScheduleKind] = self.Tok.getLocation();
        if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
            self.ConsumeAnyToken(false);
        }
        if (Arg[ScheduleKind] == OMPC_SCHEDULE_static || Arg[ScheduleKind] == OMPC_SCHEDULE_dynamic || Arg[ScheduleKind] == OMPC_SCHEDULE_guided) && self.Tok.is(comma) {
            DelimLoc = self.ConsumeAnyToken(false);
        }
    } else if Kind == OMPC_dist_schedule {
        Arg.push(getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts()));
        KLoc.push(self.Tok.getLocation());
        if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
            self.ConsumeAnyToken(false);
        }
        if Arg.back() == OMPC_DIST_SCHEDULE_static && self.Tok.is(comma) {
            DelimLoc = self.ConsumeAnyToken(false);
        }
    } else if Kind == OMPC_default {
        let mut Modifier: u32 = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
        Arg.push(Modifier);
        KLoc.push(self.Tok.getLocation());
        if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
            self.ConsumeAnyToken(false);
        }
        if self.Tok.is(colon) && self.getLangOpts().OpenMP >= 60 {
            self.ConsumeAnyToken(false);
            let mut VariableCategory: OpenMPDefaultClauseVariableCategory = getOpenMPDefaultVariableCategory(if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
            Arg.push(VariableCategory);
            KLoc.push(self.Tok.getLocation());
            if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
                self.ConsumeAnyToken(false);
            }
        } else {
            Arg.push(OMPC_DEFAULT_VC_all);
            KLoc.push(SourceLocation {});
        }
    } else if Kind == OMPC_defaultmap {
        let mut Modifier: u32 = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
        if Modifier < OMPC_DEFAULTMAP_MODIFIER_unknown {
            Modifier = OMPC_DEFAULTMAP_MODIFIER_unknown;
        }
        Arg.push(Modifier);
        KLoc.push(self.Tok.getLocation());
        if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
            self.ConsumeAnyToken(false);
        }
        if self.Tok.is(colon) || self.getLangOpts().OpenMP < 50 {
            if self.Tok.is(colon) {
                self.ConsumeAnyToken(false);
            } else if Arg.back() != OMPC_DEFAULTMAP_MODIFIER_unknown {
                self.Diag(self.Tok, warn_pragma_expected_colon) << "defaultmap modifier";
            }
            Arg.push(getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts()));
            KLoc.push(self.Tok.getLocation());
            if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
                self.ConsumeAnyToken(false);
            }
        } else {
            Arg.push(OMPC_DEFAULTMAP_unknown);
            KLoc.push(SourceLocation {});
        }
    } else if Kind == OMPC_order {
        Arg.resize(NumberOfElements);
        KLoc.resize(NumberOfElements);
        Arg[Modifier] = OMPC_ORDER_MODIFIER_unknown;
        Arg[OrderKind] = OMPC_ORDER_unknown;
        let mut KindModifier: u32 = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
        if KindModifier > OMPC_ORDER_unknown {
            Arg[Modifier] = KindModifier;
            KLoc[Modifier] = self.Tok.getLocation();
            if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
                self.ConsumeAnyToken(false);
            }
            if self.Tok.is(colon) {
                self.ConsumeAnyToken(false);
            } else {
                self.Diag(self.Tok, warn_pragma_expected_colon) << "order modifier";
            }
            KindModifier = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
        }
        Arg[OrderKind] = KindModifier;
        KLoc[OrderKind] = self.Tok.getLocation();
        if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
            self.ConsumeAnyToken(false);
        }
    } else if Kind == OMPC_device {
        if isOpenMPTargetExecutionDirective(DKind) && self.getLangOpts().OpenMP >= 50 && self.NextToken().is(colon) {
            Arg.push(getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts()));
            KLoc.push(self.Tok.getLocation());
            self.ConsumeAnyToken(false);
            self.ConsumeAnyToken(false);
        } else {
            Arg.push(OMPC_DEVICE_unknown);
            KLoc.push();
        }
    } else if Kind == OMPC_grainsize {
        let mut Modifier: OpenMPGrainsizeClauseModifier = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts()) as OpenMPGrainsizeClauseModifier;
        if self.getLangOpts().OpenMP >= 51 {
            if self.NextToken().is(colon) {
                Arg.push(Modifier);
                KLoc.push(self.Tok.getLocation());
                self.ConsumeAnyToken(false);
                self.ConsumeAnyToken(false);
            } else {
                if Modifier == OMPC_GRAINSIZE_strict {
                    self.Diag(self.Tok, err_modifier_expected_colon) << "strict";
                    self.ConsumeAnyToken(false);
                }
                Arg.push(OMPC_GRAINSIZE_unknown);
                KLoc.push();
            }
        } else {
            Arg.push(OMPC_GRAINSIZE_unknown);
            KLoc.push();
        }
    } else if Kind == OMPC_dyn_groupprivate {
        Arg.resize(NumberOfModifiers);
        KLoc.resize(NumberOfModifiers);
        Arg[SimpleModifier] = OMPC_DYN_GROUPPRIVATE_unknown;
        Arg[ComplexModifier] = OMPC_DYN_GROUPPRIVATE_FALLBACK_unknown;
        let mut ConsumeModifier: Closure_13 = Closure_13 { cap_0: self, Kind: &mut Kind };
        let mut SaveModifier: Closure_14 = Closure_14 { KLoc: &mut KLoc, Arg: &mut Arg, cap_2: self };
        if Type1 < NumberOfModifiers {
            SaveModifier.call(Type1, Mod1, Loc1);
            if self.Tok.is(comma) {
                self.ConsumeAnyToken(false);
                if Type2 < NumberOfModifiers {
                    SaveModifier.call(Type2, Mod2, Loc2);
                }
            }
            if self.Tok.is(colon) {
                self.ConsumeAnyToken(false);
            } else {
                self.Diag(self.Tok, warn_pragma_expected_colon) << "dyn_groupprivate modifier";
            }
        }
    } else if Kind == OMPC_num_tasks {
        let mut Modifier: OpenMPNumTasksClauseModifier = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts()) as OpenMPNumTasksClauseModifier;
        if self.getLangOpts().OpenMP >= 51 {
            if self.NextToken().is(colon) {
                Arg.push(Modifier);
                KLoc.push(self.Tok.getLocation());
                self.ConsumeAnyToken(false);
                self.ConsumeAnyToken(false);
            } else {
                if Modifier == OMPC_NUMTASKS_strict {
                    self.Diag(self.Tok, err_modifier_expected_colon) << "strict";
                    self.ConsumeAnyToken(false);
                }
                Arg.push(OMPC_NUMTASKS_unknown);
                KLoc.push();
            }
        } else {
            Arg.push(OMPC_NUMTASKS_unknown);
            KLoc.push();
        }
    } else {
        assert!(Kind == OMPC_if);
        KLoc.push(self.Tok.getLocation());
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        let mut DK: OpenMPDirectiveKind = parseOpenMPDirectiveKind(*self);
        Arg.push(DK as u32);
        if DK != OMPD_unknown {
            self.ConsumeToken();
            if self.Tok.is(colon) && self.getLangOpts().OpenMP > 40 {
                TPA.Commit();
                DelimLoc = self.ConsumeToken();
            } else {
                TPA.Revert();
                Arg.back() = OMPD_unknown;
            }
        } else {
            TPA.Revert();
        }
    }
    let mut NeedAnExpression: bool = (Kind == OMPC_schedule && DelimLoc.isValid()) || (Kind == OMPC_dist_schedule && DelimLoc.isValid()) || Kind == OMPC_if || Kind == OMPC_device || Kind == OMPC_grainsize || Kind == OMPC_num_tasks || Kind == OMPC_dyn_groupprivate;
    if NeedAnExpression {
        let mut ELoc: SourceLocation = self.Tok.getLocation();
        let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
        Val = self.ParseRHSOfBinaryExpression(LHS, Conditional);
        Val = self.Actions.ActOnFinishFullExpr(Val.get(), ELoc, false, false, false);
    }
    let mut RLoc: SourceLocation = self.Tok.getLocation();
    if !T.consumeClose() {
        RLoc = T.getCloseLocation();
    }
    if NeedAnExpression && Val.isInvalid() {
        return null;
    }
    if Kind == OMPC_default && self.getLangOpts().OpenMP < 51 && Arg[0] && (Arg[0] as DefaultKind == OMP_DEFAULT_private || Arg[0] as DefaultKind == OMP_DEFAULT_firstprivate) {
        self.Diag(KLoc[0], err_omp_invalid_dsa) << getOpenMPClauseName(if Arg[0] as DefaultKind == OMP_DEFAULT_private { OMPC_private } else { OMPC_firstprivate }, 0) << getOpenMPClauseName(OMPC_default, 0) << "5.1";
        return null;
    }
    if ParseOnly {
        return null;
    }
    return self.Actions.OpenMP().ActOnOpenMPSingleExprWithArgClause(Kind, Arg, Val.get(), Loc, T.getOpenLocation(), KLoc, DelimLoc, RLoc);
}

fn ParseReductionId(P: *mut Parser, ReductionIdScopeSpec: *mut CXXScopeSpec, ReductionId: *mut UnqualifiedId) -> bool {
    if ReductionIdScopeSpec.isEmpty() {
        let mut OOK: OverloadedOperatorKind = OO_None;
        match P.getCurToken().getKind() {
            plus => {
                OOK = OO_Plus;
            },
            minus => {
                OOK = OO_Minus;
            },
            star => {
                OOK = OO_Star;
            },
            amp => {
                OOK = OO_Amp;
            },
            pipe => {
                OOK = OO_Pipe;
            },
            caret => {
                OOK = OO_Caret;
            },
            ampamp => {
                OOK = OO_AmpAmp;
            },
            pipepipe => {
                OOK = OO_PipePipe;
            },
            _ => {
                break;
            },
        }
        if OOK != OO_None {
            let mut OpLoc: SourceLocation = P.ConsumeToken();
            let mut SymbolLocations: [3]SourceLocation = [OpLoc, OpLoc, SourceLocation {}];
            ReductionId.setOperatorFunctionId(OpLoc, OOK, SymbolLocations);
            return false;
        }
    }
    return P.ParseUnqualifiedId(ReductionIdScopeSpec, null, false, false, false, false, false, null, ReductionId);
}

fn isMapModifier(P: *mut Parser) -> OpenMPMapModifierKind {
    let mut Tok: Token = P.getCurToken();
    if !Tok.is(identifier) {
        return OMPC_MAP_MODIFIER_unknown;
    }
    let mut PP: *mut Preprocessor = P.getPreprocessor();
    let mut TypeModifier: OpenMPMapModifierKind = getOpenMPSimpleClauseType(OMPC_map, PP.getSpelling(Tok, null), P.getLangOpts()) as OpenMPMapModifierKind;
    return TypeModifier;
}

fn Parser::parseMapperModifier(self, Data: *mut OpenMPVarListDataTy) -> bool {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, colon };
    if T.expectAndConsume(err_expected_lparen_after, "mapper", unknown) {
        self.SkipUntil(colon, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        return true;
    }
    if self.getLangOpts().CPlusPlus {
        self.ParseOptionalCXXScopeSpecifier(Data.ReductionOrMapperIdScopeSpec, null, false, false, null, false, null, false, false, false, false, false);
    }
    if self.Tok.isNot(identifier) && self.Tok.isNot(kw_default) {
        self.Diag(self.Tok.getLocation(), err_omp_mapper_illegal_identifier);
        self.SkipUntil(colon, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        return true;
    }
    let mut DeclNames: *mut DeclarationNameTable = self.Actions.getASTContext().DeclarationNames;
    Data.ReductionOrMapperId = DeclarationNameInfo { DeclNames.getIdentifier(self.Tok.getIdentifierInfo()), self.Tok.getLocation() };
    self.ConsumeToken();
    return T.consumeClose();
}

fn Parser::parseMapTypeModifiers(self, Data: *mut OpenMPVarListDataTy) -> bool {
    let mut HasMapType: bool = false;
    let mut PreMapLoc: SourceLocation = self.Tok.getLocation();
    let mut PreMapName: str = "";
    while self.getCurToken().isNot(colon) {
        let mut TypeModifier: OpenMPMapModifierKind = isMapModifier(*self);
        let mut MapKind: OpenMPMapClauseKind = isMapType(*self);
        if TypeModifier == OMPC_MAP_MODIFIER_always || TypeModifier == OMPC_MAP_MODIFIER_close || TypeModifier == OMPC_MAP_MODIFIER_present || TypeModifier == OMPC_MAP_MODIFIER_ompx_hold {
            Data.MapTypeModifiers.push(TypeModifier);
            Data.MapTypeModifiersLoc.push(self.Tok.getLocation());
            if self.PP.LookAhead(0).isNot(comma) && self.PP.LookAhead(0).isNot(colon) && self.getLangOpts().OpenMP >= 52 {
                self.Diag(self.Tok.getLocation(), err_omp_missing_comma) << "map type modifier";
            }
            self.ConsumeToken();
        } else if TypeModifier == OMPC_MAP_MODIFIER_mapper {
            Data.MapTypeModifiers.push(TypeModifier);
            Data.MapTypeModifiersLoc.push(self.Tok.getLocation());
            self.ConsumeToken();
            if self.parseMapperModifier(Data) {
                return true;
            }
            if self.Tok.isNot(comma) && self.Tok.isNot(colon) && self.getLangOpts().OpenMP >= 52 {
                self.Diag(Data.MapTypeModifiersLoc.back(), err_omp_missing_comma) << "map type modifier";
            }
        } else if self.getLangOpts().OpenMP >= 60 && MapKind != OMPC_MAP_unknown {
            if !HasMapType {
                HasMapType = true;
                Data.ExtraModifier = MapKind;
                MapKind = OMPC_MAP_unknown;
                PreMapLoc = self.Tok.getLocation();
                PreMapName = self.Tok.getIdentifierInfo().getName();
            } else {
                self.Diag(self.Tok, err_omp_more_one_map_type);
                self.Diag(PreMapLoc, note_previous_map_type_specified_here) << PreMapName;
            }
            self.ConsumeToken();
        } else if TypeModifier == OMPC_MAP_MODIFIER_self {
            Data.MapTypeModifiers.push(TypeModifier);
            Data.MapTypeModifiersLoc.push(self.Tok.getLocation());
            if self.PP.LookAhead(0).isNot(comma) && self.PP.LookAhead(0).isNot(colon) {
                self.Diag(self.Tok.getLocation(), err_omp_missing_comma) << "map type modifier";
            }
            if self.getLangOpts().OpenMP < 60 {
                self.Diag(self.Tok, err_omp_unknown_map_type_modifier) << (if self.getLangOpts().OpenMP >= 51 { (if self.getLangOpts().OpenMP >= 52 { 2 } else { 1 }) } else { 0 }) << self.getLangOpts().OpenMPExtensions << 0;
            }
            self.ConsumeToken();
        } else {
            if self.Tok.is(comma) {
                self.Diag(self.Tok, err_omp_map_type_modifier_missing);
                self.ConsumeToken();
                continue;
            }
            if self.PP.LookAhead(0).is(colon) {
                if self.getLangOpts().OpenMP >= 60 {
                    break;
                } else {
                    return false;
                }
            }
            self.Diag(self.Tok, err_omp_unknown_map_type_modifier) << (if self.getLangOpts().OpenMP >= 51 { (if self.getLangOpts().OpenMP >= 52 { 2 } else { 1 }) } else { 0 }) << self.getLangOpts().OpenMPExtensions << (if self.getLangOpts().OpenMP >= 60 { 1 } else { 0 });
            self.ConsumeToken();
        }
        if self.getCurToken().is(comma) {
            self.ConsumeToken();
        }
    }
    if self.getLangOpts().OpenMP >= 60 && !HasMapType {
        if !self.Tok.is(colon) {
            self.Diag(self.Tok, err_omp_unknown_map_type);
            self.ConsumeToken();
        } else {
            Data.ExtraModifier = OMPC_MAP_unknown;
        }
    }
    return false;
}

fn isMapType(P: *mut Parser) -> OpenMPMapClauseKind {
    let mut Tok: Token = P.getCurToken();
    if !Tok.isOneOf(identifier, kw_delete) {
        return OMPC_MAP_unknown;
    }
    let mut PP: *mut Preprocessor = P.getPreprocessor();
    let mut MapType: u32 = getOpenMPSimpleClauseType(OMPC_map, PP.getSpelling(Tok, null), P.getLangOpts());
    if MapType == OMPC_MAP_to || MapType == OMPC_MAP_from || MapType == OMPC_MAP_tofrom || MapType == OMPC_MAP_alloc || MapType == OMPC_MAP_delete || MapType == OMPC_MAP_release {
        return MapType as OpenMPMapClauseKind;
    }
    return OMPC_MAP_unknown;
}

fn parseMapType(P: *mut Parser, Data: *mut OpenMPVarListDataTy) {
    let mut Tok: Token = P.getCurToken();
    if Tok.is(colon) {
        P.Diag(Tok, err_omp_map_type_missing);
        return;
    }
    Data.ExtraModifier = isMapType(P);
    if Data.ExtraModifier == OMPC_MAP_unknown {
        P.Diag(Tok, err_omp_unknown_map_type);
    }
    P.ConsumeToken();
}

fn Parser::ParseOpenMPIteratorsExpr(self) -> ExprResult {
    assert!(self.Tok.is(identifier) && self.PP.getSpelling(self.Tok, null) == "iterator", "Expected 'iterator' token.");
    let mut IteratorKwLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, "iterator", unknown) {
        return ExprError();
    }
    let mut LLoc: SourceLocation = T.getOpenLocation();
    let mut Data: OMPIteratorData, 4> = OMPIteratorData, 4> {};
    while self.Tok.isNot(r_paren) && self.Tok.isNot(annot_pragma_openmp_end) {
        let mut IteratorType: ParsedType = null;
        if self.Tok.isNot(identifier) || self.NextToken().isNot(equal) {
            let mut TR: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
            if TR.isInvalid() {
                T.skipToEnd();
                return ExprError();
            }
            IteratorType = TR.get();
        }
        let mut II: *mut IdentifierInfo = null;
        let mut IdLoc: SourceLocation = SourceLocation {};
        if self.Tok.is(identifier) {
            II = self.Tok.getIdentifierInfo();
            IdLoc = self.ConsumeToken();
        } else {
            self.Diag(self.Tok, err_expected_unqualified_id) << 0;
        }
        let mut AssignLoc: SourceLocation = SourceLocation {};
        if self.Tok.is(equal) {
            AssignLoc = self.ConsumeToken();
        } else {
            self.Diag(self.Tok, err_omp_expected_equal_in_iterator);
        }
        let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        let mut Loc: SourceLocation = self.Tok.getLocation();
        let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
        let mut Begin: ExprResult = self.ParseRHSOfBinaryExpression(LHS, Conditional);
        Begin = self.Actions.ActOnFinishFullExpr(Begin.get(), Loc, false, false, false);
        let mut ColonLoc: SourceLocation = SourceLocation {};
        if self.Tok.is(colon) {
            ColonLoc = self.ConsumeToken();
        }
        Loc = self.Tok.getLocation();
        LHS = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
        let mut End: ExprResult = self.ParseRHSOfBinaryExpression(LHS, Conditional);
        End = self.Actions.ActOnFinishFullExpr(End.get(), Loc, false, false, false);
        let mut SecColonLoc: SourceLocation = SourceLocation {};
        let mut Step: ExprResult = false;
        if self.Tok.is(colon) {
            SecColonLoc = self.ConsumeToken();
            Loc = self.Tok.getLocation();
            LHS = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
            Step = self.ParseRHSOfBinaryExpression(LHS, Conditional);
            Step = self.Actions.ActOnFinishFullExpr(Step.get(), Loc, false, false, false);
        }
        if self.Tok.isNot(comma) && self.Tok.isNot(r_paren) {
            self.Diag(self.Tok, err_omp_expected_punc_after_iterator);
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        }
        let mut D: *mut OMPIteratorData = Data.push();
        D.DeclIdent = II;
        D.DeclIdentLoc = IdLoc;
        D.Type = IteratorType;
        D.AssignLoc = AssignLoc;
        D.ColonLoc = ColonLoc;
        D.SecColonLoc = SecColonLoc;
        D.Range.Begin = Begin.get();
        D.Range.End = End.get();
        D.Range.Step = Step.get();
    }
    let mut RLoc: SourceLocation = self.Tok.getLocation();
    if !T.consumeClose() {
        RLoc = T.getCloseLocation();
    }
    return self.Actions.OpenMP().ActOnOMPIteratorExpr(self.getCurScope(), IteratorKwLoc, LLoc, RLoc, Data);
}

fn Parser::ParseOpenMPReservedLocator(self, Kind: OpenMPClauseKind, Data: *mut OpenMPVarListDataTy, LangOpts: *LangOptions) -> bool {
    if Kind != OMPC_depend || LangOpts.OpenMP < 51 {
        return false;
    }
    if self.Tok.is(identifier) && self.Tok.getIdentifierInfo().isStr("omp_all_memory") {
        if Data.ExtraModifier == OMPC_DEPEND_outallmemory || Data.ExtraModifier == OMPC_DEPEND_inoutallmemory {
            self.Diag(self.Tok, warn_omp_more_one_omp_all_memory);
        } else if Data.ExtraModifier != OMPC_DEPEND_out && Data.ExtraModifier != OMPC_DEPEND_inout {
            self.Diag(self.Tok, err_omp_requires_out_inout_depend_type);
        } else {
            Data.ExtraModifier = if Data.ExtraModifier == OMPC_DEPEND_out { OMPC_DEPEND_outallmemory } else { OMPC_DEPEND_inoutallmemory };
        }
        self.ConsumeToken();
        return true;
    }
    return false;
}

fn parseStepSize(P: *mut Parser, Data: *mut OpenMPVarListDataTy, CKind: OpenMPClauseKind, ELoc: SourceLocation) -> bool {
    let mut Tail: ExprResult = P.ParseAssignmentExpression(AllowNonTypes);
    let mut Actions: *mut Sema = P.getActions();
    Tail = Actions.ActOnFinishFullExpr(Tail.get(), ELoc, false, false, false);
    if Tail.isUsable() {
        Data.DepModOrTailExpr = Tail.get();
        let mut CurTok: Token = P.getCurToken();
        if CurTok.isNot(r_paren) && CurTok.isNot(comma) {
            P.Diag(CurTok, err_expected_punc) << "step expression";
        }
        return true;
    }
    return false;
}

fn parseOpenMPAllocateClauseModifiers(P: *mut Parser, Kind: OpenMPClauseKind, Data: *mut OpenMPVarListDataTy) -> ExprResult {
    let mut Tok: *Token = P.getCurToken();
    let mut PP: *mut Preprocessor = P.getPreprocessor();
    let mut Tail: ExprResult = false;
    let mut Val: ExprResult = false;
    let mut RLoc: SourceLocation = SourceLocation {};
    let mut AllocatorSeen: bool = false;
    let mut AlignSeen: bool = false;
    let mut CurrentModifierLoc: SourceLocation = Tok.getLocation();
    let mut CurrentModifier: OpenMPAllocateClauseModifier = getOpenMPSimpleClauseType(Kind, PP.getSpelling(Tok, null), P.getLangOpts()) as OpenMPAllocateClauseModifier;
    if P.getLangOpts().OpenMP < 51 {
        return P.ParseAssignmentExpression(AllowNonTypes);
    }
    if CurrentModifier == OMPC_ALLOCATE_unknown {
        return P.ParseAssignmentExpression(AllowNonTypes);
    }
    while true {
        {
        P.ConsumeToken();
        if Tok.is(l_paren) {
            match CurrentModifier {
                OMPC_ALLOCATE_allocator => {
                    if AllocatorSeen {
                        P.Diag(Tok, err_omp_duplicate_modifier) << getOpenMPSimpleClauseTypeName(OMPC_allocate, CurrentModifier) << getOpenMPClauseName(Kind, 0);
                    } else {
                        Data.AllocClauseModifiers.push(CurrentModifier);
                        Data.AllocClauseModifiersLoc.push(CurrentModifierLoc);
                    }
                    let mut AllocateT: BalancedDelimiterTracker = BalancedDelimiterTracker { P, l_paren, annot_pragma_openmp_end };
                    AllocateT.consumeOpen();
                    Tail = P.ParseAssignmentExpression(AllowNonTypes);
                    AllocateT.consumeClose();
                    AllocatorSeen = true;
                    break;
                },
                OMPC_ALLOCATE_align => {
                    if AlignSeen {
                        P.Diag(Tok, err_omp_duplicate_modifier) << getOpenMPSimpleClauseTypeName(OMPC_allocate, CurrentModifier) << getOpenMPClauseName(Kind, 0);
                    } else {
                        Data.AllocClauseModifiers.push(CurrentModifier);
                        Data.AllocClauseModifiersLoc.push(CurrentModifierLoc);
                    }
                    Val = P.ParseOpenMPParensExpr(getOpenMPClauseName(Kind, 0), RLoc, false);
                    if Val.isUsable() {
                        Data.AllocateAlignment = Val.get();
                    }
                    AlignSeen = true;
                    break;
                },
                _ => {
                    llvm_unreachable_internal("Unexpected allocate modifier", "P:/Goraw/llvm-project/clang/lib/Parse/ParseOpenMP.cpp", 4879);
                },
            }
        } else {
            P.Diag(Tok, err_expected) << l_paren;
        }
        if Tok.isNot(comma) {
            break;
        }
        P.ConsumeToken();
        CurrentModifierLoc = Tok.getLocation();
        CurrentModifier = getOpenMPSimpleClauseType(Kind, PP.getSpelling(Tok, null), P.getLangOpts()) as OpenMPAllocateClauseModifier;
        if CurrentModifier == OMPC_ALLOCATE_unknown {
            P.Diag(Tok, err_omp_expected_modifier) << getOpenMPClauseName(Kind, 0);
            break;
        }
    }
        if !(!AllocatorSeen || !AlignSeen) { break; }
    }
    return Tail;
}

fn Parser::ParseOpenMPVarList(self, DKind: OpenMPDirectiveKind, Kind: OpenMPClauseKind, Vars: *mut SmallVectorImpl<Expr *>, Data: *mut OpenMPVarListDataTy) -> bool {
    let mut UnqualifiedReductionId: UnqualifiedId = UnqualifiedId {};
    let mut InvalidReductionId: bool = false;
    let mut IsInvalidMapperModifier: bool = false;
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.expectAndConsume(err_expected_lparen_after, getOpenMPClauseName(Kind, 0).ptr, unknown) {
        return true;
    }
    let mut HasIterator: bool = false;
    let mut InvalidIterator: bool = false;
    let mut NeedRParenForLinear: bool = false;
    let mut LinearT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if Kind == OMPC_reduction || Kind == OMPC_task_reduction || Kind == OMPC_in_reduction {
        Data.ExtraModifier = OMPC_REDUCTION_unknown;
        if Kind == OMPC_reduction && self.getLangOpts().OpenMP >= 50 && (self.Tok.is(identifier) || self.Tok.is(kw_default)) && self.NextToken().is(comma) {
            Data.ExtraModifier = getOpenMPSimpleClauseType(Kind, self.PP.getSpelling(self.Tok, null), self.getLangOpts());
            Data.ExtraModifierLoc = self.Tok.getLocation();
            self.ConsumeToken();
            assert!(self.Tok.is(comma), "Expected comma.");
            self.ConsumeToken() as void;
        }
        if Kind == OMPC_reduction && self.getLangOpts().OpenMP >= 60 && self.Tok.is(identifier) && self.PP.getSpelling(self.Tok, null) == "original" && self.NextToken().is(l_paren) {
            self.ConsumeToken();
            let mut ParenT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, r_paren };
            ParenT.consumeOpen();
            if self.Tok.is(kw_private) {
                Data.OriginalSharingModifier = OMPC_ORIGINAL_SHARING_private;
                Data.OriginalSharingModifierLoc = self.Tok.getLocation();
                self.ConsumeToken();
            } else if self.Tok.is(identifier) && (self.PP.getSpelling(self.Tok, null) == "shared" || self.PP.getSpelling(self.Tok, null) == "default") {
                Data.OriginalSharingModifier = OMPC_ORIGINAL_SHARING_shared;
                Data.OriginalSharingModifierLoc = self.Tok.getLocation();
                self.ConsumeToken();
            } else {
                self.Diag(self.Tok.getLocation(), err_expected) << "'private or shared or default'";
                self.SkipUntil(r_paren, 0 as SkipUntilFlags);
                return false;
            }
            ParenT.consumeClose();
            if !self.Tok.is(comma) {
                self.Diag(self.Tok.getLocation(), err_expected) << "',' (comma)";
                return false;
            }
            self.ConsumeToken() as void;
        }
        let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        if self.getLangOpts().CPlusPlus {
            self.ParseOptionalCXXScopeSpecifier(Data.ReductionOrMapperIdScopeSpec, null, false, false, null, false, null, false, false, false, false, false);
        }
        InvalidReductionId = ParseReductionId(*self, Data.ReductionOrMapperIdScopeSpec, UnqualifiedReductionId);
        if InvalidReductionId {
            self.SkipUntil(colon, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        }
        if self.Tok.is(colon) {
            Data.ColonLoc = self.ConsumeToken();
        } else {
            self.Diag(self.Tok, warn_pragma_expected_colon) << "reduction identifier";
        }
        if !InvalidReductionId {
            Data.ReductionOrMapperId = self.Actions.GetNameFromUnqualifiedId(UnqualifiedReductionId);
        }
    } else if Kind == OMPC_depend || Kind == OMPC_doacross {
        if self.getLangOpts().OpenMP >= 50 {
            if self.Tok.is(identifier) && self.PP.getSpelling(self.Tok, null) == "iterator" {
                HasIterator = true;
                self.EnterScope(OpenMPDirectiveScope | DeclScope);
                let mut IteratorRes: ExprResult = self.ParseOpenMPIteratorsExpr();
                Data.DepModOrTailExpr = IteratorRes.get();
                self.ExpectAndConsume(comma, err_expected, "");
            }
        }
        let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        Data.ExtraModifier = getOpenMPSimpleClauseType(Kind, if self.Tok.is(identifier) { self.PP.getSpelling(self.Tok, null) } else { "" }, self.getLangOpts());
        Data.ExtraModifierLoc = self.Tok.getLocation();
        if (Kind == OMPC_depend && Data.ExtraModifier == OMPC_DEPEND_unknown) || (Kind == OMPC_doacross && Data.ExtraModifier == OMPC_DOACROSS_unknown) {
            self.SkipUntil(colon, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        } else {
            self.ConsumeToken();
            if DKind == OMPD_ordered_standalone && Kind == OMPC_depend && Data.ExtraModifier == OMPC_DEPEND_source {
                T.consumeClose();
                return false;
            }
        }
        if self.Tok.is(colon) {
            Data.ColonLoc = self.ConsumeToken();
        } else if Kind != OMPC_doacross || self.Tok.isNot(r_paren) {
            self.Diag(self.Tok, if DKind == OMPD_ordered_standalone { warn_pragma_expected_colon_r_paren } else { warn_pragma_expected_colon }) << (if Kind == OMPC_depend { "dependency type" } else { "dependence-type" });
        }
        if Kind == OMPC_doacross {
            if self.Tok.is(identifier) && self.Tok.getIdentifierInfo().isStr("omp_cur_iteration") {
                Data.ExtraModifier = if Data.ExtraModifier == OMPC_DOACROSS_source { OMPC_DOACROSS_source_omp_cur_iteration } else { OMPC_DOACROSS_sink_omp_cur_iteration };
                self.ConsumeToken();
            }
            if Data.ExtraModifier == OMPC_DOACROSS_sink_omp_cur_iteration {
                if self.Tok.isNot(minus) {
                    self.Diag(self.Tok, err_omp_sink_and_source_iteration_not_allowd) << getOpenMPClauseName(Kind, 0) << 0 << 0;
                    self.SkipUntil(r_paren, 0 as SkipUntilFlags);
                    return false;
                } else {
                    self.ConsumeToken();
                    let mut Loc: SourceLocation = self.Tok.getLocation();
                    let mut Value: u64 = 0;
                    if self.Tok.isNot(numeric_constant) || (self.PP.parseSimpleIntegerLiteral(self.Tok, Value) && Value != 1) {
                        self.Diag(Loc, err_omp_sink_and_source_iteration_not_allowd) << getOpenMPClauseName(Kind, 0) << 0 << 0;
                        self.SkipUntil(r_paren, 0 as SkipUntilFlags);
                        return false;
                    }
                }
            }
            if Data.ExtraModifier == OMPC_DOACROSS_source_omp_cur_iteration {
                if self.Tok.isNot(r_paren) {
                    self.Diag(self.Tok, err_omp_sink_and_source_iteration_not_allowd) << getOpenMPClauseName(Kind, 0) << 1 << 1;
                    self.SkipUntil(r_paren, 0 as SkipUntilFlags);
                    return false;
                }
            }
            if Kind == OMPC_doacross && (Data.ExtraModifier == OMPC_DOACROSS_source || Data.ExtraModifier == OMPC_DOACROSS_source_omp_cur_iteration || Data.ExtraModifier == OMPC_DOACROSS_sink_omp_cur_iteration) {
                T.consumeClose();
                return false;
            }
        }
    } else if Kind == OMPC_linear {
        Data.ExtraModifier = OMPC_LINEAR_val;
        if self.Tok.is(identifier) && self.PP.LookAhead(0).is(l_paren) {
            Data.ExtraModifier = getOpenMPSimpleClauseType(Kind, self.PP.getSpelling(self.Tok, null), self.getLangOpts());
            Data.ExtraModifierLoc = self.ConsumeToken();
            LinearT.consumeOpen();
            NeedRParenForLinear = true;
            if self.getLangOpts().OpenMP >= 52 {
                self.Diag(Data.ExtraModifierLoc, err_omp_deprecate_old_syntax) << "linear-modifier(list)" << getOpenMPClauseName(Kind, 0) << "linear(list: [linear-modifier,] step(step-size))";
            }
        }
    } else if Kind == OMPC_lastprivate {
        Data.ExtraModifier = OMPC_LASTPRIVATE_unknown;
        if (self.getLangOpts().OpenMP >= 50 && !isOpenMPDistributeDirective(DKind) && !isOpenMPTaskLoopDirective(DKind)) && self.Tok.is(identifier) && self.PP.LookAhead(0).is(colon) {
            Data.ExtraModifier = getOpenMPSimpleClauseType(Kind, self.PP.getSpelling(self.Tok, null), self.getLangOpts());
            Data.ExtraModifierLoc = self.Tok.getLocation();
            self.ConsumeToken();
            assert!(self.Tok.is(colon), "Expected colon.");
            Data.ColonLoc = self.ConsumeToken();
        }
    } else if Kind == OMPC_map {
        if self.Tok.is(identifier) && self.PP.getSpelling(self.Tok, null) == "iterator" {
            HasIterator = true;
            self.EnterScope(OpenMPDirectiveScope | DeclScope);
            Data.MapTypeModifiers.push(OMPC_MAP_MODIFIER_iterator);
            Data.MapTypeModifiersLoc.push(self.Tok.getLocation());
            let mut IteratorRes: ExprResult = self.ParseOpenMPIteratorsExpr();
            Data.IteratorExpr = IteratorRes.get();
            self.ExpectAndConsume(comma, err_expected, "");
            if self.getLangOpts().OpenMP < 52 {
                self.Diag(self.Tok, err_omp_unknown_map_type_modifier) << (if self.getLangOpts().OpenMP >= 51 { 1 } else { 0 }) << self.getLangOpts().OpenMPExtensions << 0;
                InvalidIterator = true;
            }
        }
        let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        Data.ExtraModifier = OMPC_MAP_unknown;
        Data.ExtraModifierLoc = self.Tok.getLocation();
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        let mut ColonPresent: bool = false;
        if self.SkipUntil(colon, r_paren, annot_pragma_openmp_end, StopBeforeMatch) {
            if self.Tok.is(colon) {
                ColonPresent = true;
            }
        }
        TPA.Revert();
        if ColonPresent {
            if self.getLangOpts().OpenMP >= 60 && self.getCurToken().is(colon) {
                self.Diag(self.Tok, err_omp_map_modifier_specification_list);
            }
            IsInvalidMapperModifier = self.parseMapTypeModifiers(Data);
            if self.getLangOpts().OpenMP < 60 && !IsInvalidMapperModifier {
                parseMapType(*self, Data);
            } else {
                self.SkipUntil(colon, annot_pragma_openmp_end, StopBeforeMatch);
            }
        }
        if Data.ExtraModifier == OMPC_MAP_unknown {
            Data.ExtraModifier = OMPC_MAP_tofrom;
            if self.getLangOpts().OpenMP >= 52 {
                if DKind == OMPD_target_enter_data {
                    Data.ExtraModifier = OMPC_MAP_to;
                } else if DKind == OMPD_target_exit_data {
                    Data.ExtraModifier = OMPC_MAP_from;
                }
            }
            Data.IsMapTypeImplicit = true;
        }
        if self.Tok.is(colon) {
            Data.ColonLoc = self.ConsumeToken();
        }
    } else if Kind == OMPC_to || Kind == OMPC_from {
        while self.Tok.is(identifier) {
            let mut Modifier: OpenMPMotionModifierKind = getOpenMPSimpleClauseType(Kind, self.PP.getSpelling(self.Tok, null), self.getLangOpts()) as OpenMPMotionModifierKind;
            if Modifier == OMPC_MOTION_MODIFIER_unknown {
                break;
            }
            Data.MotionModifiers.push(Modifier);
            Data.MotionModifiersLoc.push(self.Tok.getLocation());
            if self.PP.getSpelling(self.Tok, null) == "iterator" && self.getLangOpts().OpenMP >= 51 {
                let mut Tail: ExprResult = false;
                Tail = self.ParseOpenMPIteratorsExpr();
                Tail = self.Actions.ActOnFinishFullExpr(Tail.get(), T.getOpenLocation(), false, false, false);
                if Tail.isUsable() {
                    Data.IteratorExpr = Tail.get();
                }
            } else {
                self.ConsumeToken();
                if Modifier == OMPC_MOTION_MODIFIER_mapper {
                    IsInvalidMapperModifier = self.parseMapperModifier(Data);
                    if IsInvalidMapperModifier {
                        break;
                    }
                }
                if self.getLangOpts().OpenMP < 51 {
                    break;
                }
                if self.Tok.is(comma) {
                    self.ConsumeToken();
                }
            }
        }
        if !Data.MotionModifiers.is_empty() && self.Tok.isNot(colon) {
            if !IsInvalidMapperModifier {
                if self.getLangOpts().OpenMP < 51 {
                    self.Diag(self.Tok, warn_pragma_expected_colon) << ")";
                } else {
                    self.Diag(self.Tok, warn_pragma_expected_colon) << "motion modifier";
                }
            }
            self.SkipUntil(colon, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        }
        if (!Data.MotionModifiers.is_empty() || self.getLangOpts().OpenMP >= 51) && self.Tok.is(colon) {
            Data.ColonLoc = self.ConsumeToken();
        }
    } else if Kind == OMPC_allocate || (Kind == OMPC_affinity && self.Tok.is(identifier) && self.PP.getSpelling(self.Tok, null) == "iterator") {
        let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        let mut Tail: ExprResult = false;
        if Kind == OMPC_allocate {
            Tail = parseOpenMPAllocateClauseModifiers(*self, Kind, Data);
        } else {
            HasIterator = true;
            self.EnterScope(OpenMPDirectiveScope | DeclScope);
            Tail = self.ParseOpenMPIteratorsExpr();
        }
        Tail = self.Actions.ActOnFinishFullExpr(Tail.get(), T.getOpenLocation(), false, false, false);
        if Tail.isUsable() || Data.AllocateAlignment {
            if self.Tok.is(colon) {
                Data.DepModOrTailExpr = if Tail.isUsable() { Tail.get() } else { null };
                Data.ColonLoc = self.ConsumeToken();
                TPA.Commit();
            } else {
                TPA.Revert();
                if Kind == OMPC_allocate && Data.AllocClauseModifiers.len {
                    self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
                    self.Diag(self.Tok, err_modifier_expected_colon) << "allocate clause";
                }
            }
        } else {
            TPA.Revert();
            self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        }
    } else if Kind == OMPC_adjust_args {
        let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        Data.ExtraModifier = getOpenMPSimpleClauseType(Kind, if self.Tok.is(identifier) { self.PP.getSpelling(self.Tok, null) } else { "" }, self.getLangOpts());
        Data.ExtraModifierLoc = self.Tok.getLocation();
        if Data.ExtraModifier == OMPC_ADJUST_ARGS_unknown {
            self.Diag(self.Tok, err_omp_unknown_adjust_args_op) << (if self.getLangOpts().OpenMP >= 60 { 1 } else { 0 });
            self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
        } else {
            self.ConsumeToken();
            if self.Tok.is(colon) {
                Data.ColonLoc = self.Tok.getLocation();
            }
            if self.getLangOpts().OpenMP >= 61 {
                if self.Tok.is(l_paren) {
                    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
                    T.consumeOpen();
                    if self.Tok.is(identifier) {
                        let mut Modifier: str = self.PP.getSpelling(self.Tok, null);
                        if Modifier == "fb_nullify" || Modifier == "fb_preserve" {
                            Data.NeedDevicePtrModifier = if Modifier == "fb_nullify" { OMPC_NEED_DEVICE_PTR_fb_nullify } else { OMPC_NEED_DEVICE_PTR_fb_preserve };
                        } else {
                            self.Diag(self.Tok, err_omp_unknown_need_device_ptr_kind);
                            self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
                            return false;
                        }
                        self.ConsumeToken();
                        if self.Tok.is(r_paren) {
                            Data.NeedDevicePtrModifierLoc = self.Tok.getLocation();
                            self.ConsumeAnyToken(false);
                        } else {
                            self.Diag(self.Tok, err_expected) << r_paren;
                            self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
                            return false;
                        }
                    } else {
                        Data.NeedDevicePtrModifier = OMPC_NEED_DEVICE_PTR_unknown;
                    }
                }
            }
            self.ExpectAndConsume(colon, warn_pragma_expected_colon, "adjust-op");
        }
    } else if Kind == OMPC_use_device_ptr {
        Data.ExtraModifier = OMPC_USE_DEVICE_PTR_FALLBACK_unknown;
        if self.getLangOpts().OpenMP >= 61 && self.Tok.is(identifier) {
            let mut FallbackModifier: OpenMPUseDevicePtrFallbackModifier = getOpenMPSimpleClauseType(Kind, self.PP.getSpelling(self.Tok, null), self.getLangOpts()) as OpenMPUseDevicePtrFallbackModifier;
            if FallbackModifier != OMPC_USE_DEVICE_PTR_FALLBACK_unknown {
                Data.ExtraModifier = FallbackModifier;
                Data.ExtraModifierLoc = self.Tok.getLocation();
                self.ConsumeToken();
                if self.Tok.is(colon) {
                    Data.ColonLoc = self.ConsumeToken();
                } else {
                    self.Diag(self.Tok, err_modifier_expected_colon) << "fallback";
                }
            }
        }
    } else if Kind == OMPC_num_teams || Kind == OMPC_thread_limit {
        let mut Mod: i32 = 0;
        Data.ExtraModifierArray[0] = Data.ExtraModifierArray[1] = if Kind == OMPC_num_teams { OMPC_NUMTEAMS_unknown as i32 } else { OMPC_THREADLIMIT_unknown as i32 };
        let mut CanParseLowerBoundModifier: bool = (Kind == OMPC_num_teams);
        if self.Tok.is(identifier) && self.Tok.getIdentifierInfo().isStr("dims") && self.NextToken().is(l_paren) {
            let mut TLoc: SourceLocation = self.Tok.getLocation();
            self.ConsumeToken();
            let mut RLoc: SourceLocation = SourceLocation {};
            let mut ExprR: ExprResult = self.ParseOpenMPParensExpr(getOpenMPClauseName(Kind, 0), RLoc, false);
            if ExprR.isUsable() {
                Data.ExtraModifierArray[Mod] = if Kind == OMPC_num_teams { OMPC_NUMTEAMS_dims as i32 } else { OMPC_THREADLIMIT_dims as i32 };
                Data.ExtraModifierExprArray[Mod] = ExprR.get();
                Data.ExtraModifierLocArray[Mod] = TLoc;
                Mod += 1;
            }
            if self.Tok.is(colon) {
                self.ConsumeToken();
                CanParseLowerBoundModifier = false;
            } else if CanParseLowerBoundModifier && self.Tok.is(comma) {
                self.ConsumeToken();
            } else {
                self.Diag(self.Tok, err_modifier_expected_colon) << getOpenMPClauseName(Kind, 0);
                self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
                Data.RLoc = self.Tok.getLocation();
                if !T.consumeClose() {
                    Data.RLoc = T.getCloseLocation();
                }
                return true;
            }
        }
        if CanParseLowerBoundModifier {
            let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
            let mut TLoc: SourceLocation = self.Tok.getLocation();
            let mut FirstExpr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
            if FirstExpr.isInvalid() {
                self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
                Data.RLoc = self.Tok.getLocation();
                if !T.consumeClose() {
                    Data.RLoc = T.getCloseLocation();
                }
                TPA.Commit();
                return true;
            }
            if self.Tok.is(colon) {
                self.ConsumeToken();
                Data.ExtraModifierArray[Mod] = OMPC_NUMTEAMS_lower_bound;
                Data.ExtraModifierExprArray[Mod] = FirstExpr.get();
                Data.ExtraModifierLocArray[Mod] = TLoc;
                TPA.Commit();
            } else {
                TPA.Revert();
            }
        }
    } else if Kind == OMPC_num_threads {
        Data.ExtraModifierArray[0] = OMPC_NUMTHREADS_unknown as i32;
        Data.ExtraModifierArray[1] = OMPC_NUMTHREADS_unknown as i32;
        let mut HasModifier: bool = false;
        while true {
            if self.Tok.is(identifier) && self.Tok.getIdentifierInfo().isStr("dims") && self.NextToken().is(l_paren) {
                let mut TLoc: SourceLocation = self.Tok.getLocation();
                self.ConsumeToken();
                let mut RLoc: SourceLocation = SourceLocation {};
                let mut ExprR: ExprResult = self.ParseOpenMPParensExpr(getOpenMPClauseName(Kind, 0), RLoc, false);
                if Data.ExtraModifierArray[1] != OMPC_NUMTHREADS_unknown {
                    self.Diag(TLoc, err_omp_incompatible_modifiers) << getOpenMPSimpleClauseTypeName(Kind, OMPC_NUMTHREADS_dims) << getOpenMPSimpleClauseTypeName(Kind, Data.ExtraModifierArray[1]) << getOpenMPClauseName(Kind, 0);
                }
                Data.ExtraModifierArray[1] = OMPC_NUMTHREADS_dims as i32;
                Data.ExtraModifierExprArray[1] = if (ExprR.isUsable()) { ExprR.get() } else { null };
                Data.ExtraModifierLocArray[1] = TLoc;
                HasModifier = true;
            } else {
                let mut Modifier: OpenMPNumThreadsClauseModifier = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts()) as OpenMPNumThreadsClauseModifier;
                if Modifier != OMPC_NUMTHREADS_unknown {
                    if Data.ExtraModifierArray[0] != OMPC_NUMTHREADS_unknown {
                        self.Diag(self.Tok, err_omp_incompatible_modifiers) << getOpenMPSimpleClauseTypeName(Kind, Modifier) << getOpenMPSimpleClauseTypeName(Kind, Data.ExtraModifierArray[0]) << getOpenMPClauseName(Kind, 0);
                    }
                    Data.ExtraModifierArray[0] = Modifier;
                    Data.ExtraModifierLocArray[0] = self.Tok.getLocation();
                    self.ConsumeAnyToken(false);
                    HasModifier = true;
                } else {
                    break;
                }
            }
            if self.Tok.is(comma) {
                self.ConsumeToken();
            } else {
                break;
            }
        }
        if HasModifier {
            if !self.Tok.is(colon) {
                self.Diag(self.Tok, err_modifier_expected_colon) << getOpenMPClauseName(Kind, 0);
                self.SkipUntil(r_paren, annot_pragma_openmp_end, StopBeforeMatch);
                Data.RLoc = self.Tok.getLocation();
                if !T.consumeClose() {
                    Data.RLoc = T.getCloseLocation();
                }
                return true;
            }
            self.ConsumeToken();
        }
    }
    let mut IsComma: bool = (Kind != OMPC_reduction && Kind != OMPC_task_reduction && Kind != OMPC_in_reduction && Kind != OMPC_depend && Kind != OMPC_doacross && Kind != OMPC_map && Kind != OMPC_adjust_args) || (Kind == OMPC_reduction && !InvalidReductionId) || (Kind == OMPC_map && Data.ExtraModifier != OMPC_MAP_unknown) || (Kind == OMPC_depend && Data.ExtraModifier != OMPC_DEPEND_unknown) || (Kind == OMPC_doacross && Data.ExtraModifier != OMPC_DOACROSS_unknown) || (Kind == OMPC_adjust_args && Data.ExtraModifier != OMPC_ADJUST_ARGS_unknown);
    let mut MayHaveTail: bool = (Kind == OMPC_linear || Kind == OMPC_aligned);
    while IsComma || (self.Tok.isNot(r_paren) && self.Tok.isNot(colon) && self.Tok.isNot(annot_pragma_openmp_end)) {
        let mut OMPListScope: ParseScope = ParseScope { self, OpenMPDirectiveScope, true, false };
        let mut ColonRAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: MayHaveTail };
        if !self.ParseOpenMPReservedLocator(Kind, Data, self.getLangOpts()) {
            let mut VarExpr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
            if VarExpr.isUsable() {
                Vars.push(VarExpr.get());
            } else {
                self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
            }
        }
        IsComma = self.Tok.is(comma);
        if IsComma {
            self.ConsumeToken();
        } else if self.Tok.isNot(r_paren) && self.Tok.isNot(annot_pragma_openmp_end) && (!MayHaveTail || self.Tok.isNot(colon)) {
            let mut OMPVersion: Version = self.Actions.getLangOpts().getOpenMPVersion();
            self.Diag(self.Tok, err_omp_expected_punc) << (if (Kind == OMPC_flush) { getOpenMPDirectiveName(OMPD_flush, OMPVersion) } else { getOpenMPClauseName(Kind, 0) }) << (Kind == OMPC_flush);
        }
    }
    if NeedRParenForLinear {
        LinearT.consumeClose();
    }
    let mut MustHaveTail: bool = MayHaveTail && self.Tok.is(colon);
    let mut StepFound: bool = false;
    let mut ModifierFound: bool = false;
    if MustHaveTail {
        Data.ColonLoc = self.Tok.getLocation();
        let mut ELoc: SourceLocation = self.ConsumeToken();
        if self.getLangOpts().OpenMP >= 52 && Kind == OMPC_linear {
            let mut Malformed: bool = false;
            while self.Tok.isNot(r_paren) {
                if self.Tok.is(identifier) {
                    let mut LinKind: OpenMPLinearClauseKind = getOpenMPSimpleClauseType(Kind, if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts()) as OpenMPLinearClauseKind;
                    if LinKind == OMPC_LINEAR_step {
                        if StepFound {
                            self.Diag(self.Tok, err_omp_multiple_step_or_linear_modifier) << 0;
                        }
                        let mut StepT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
                        let mut StepModifierLoc: SourceLocation = self.ConsumeToken();
                        if StepT.consumeOpen() {
                            self.Diag(StepModifierLoc, err_expected_lparen_after) << "step";
                        }
                        StepFound = parseStepSize(*self, Data, Kind, self.Tok.getLocation());
                        if StepFound {
                            Data.StepModifierLoc = StepModifierLoc;
                        }
                        StepT.consumeClose();
                    } else if LinKind >= 0 && LinKind < OMPC_LINEAR_step {
                        if ModifierFound {
                            self.Diag(self.Tok, err_omp_multiple_step_or_linear_modifier) << 1;
                        }
                        Data.ExtraModifier = LinKind;
                        Data.ExtraModifierLoc = self.ConsumeToken();
                        ModifierFound = true;
                    } else {
                        StepFound = parseStepSize(*self, Data, Kind, self.Tok.getLocation());
                        if !StepFound {
                            Malformed = true;
                            self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
                        }
                    }
                } else {
                    StepFound = parseStepSize(*self, Data, Kind, self.Tok.getLocation());
                }
                if self.Tok.is(comma) {
                    self.ConsumeToken();
                }
                if self.Tok.is(r_paren) || self.Tok.is(annot_pragma_openmp_end) {
                    break;
                }
            }
            if !Malformed && !StepFound && !ModifierFound {
                self.Diag(ELoc, err_expected_expression);
            }
        } else {
            let mut Tail: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
            Tail = self.Actions.ActOnFinishFullExpr(Tail.get(), ELoc, false, false, false);
            if Tail.isUsable() {
                Data.DepModOrTailExpr = Tail.get();
            } else {
                self.SkipUntil(comma, r_paren, annot_pragma_openmp_end, StopBeforeMatch);
            }
        }
    }
    Data.RLoc = self.Tok.getLocation();
    if !T.consumeClose() {
        Data.RLoc = T.getCloseLocation();
    }
    if HasIterator {
        self.ExitScope();
    }
    return (Kind != OMPC_depend && Kind != OMPC_doacross && Kind != OMPC_map && Vars.is_empty()) || (MustHaveTail && !Data.DepModOrTailExpr && StepFound) || InvalidReductionId || IsInvalidMapperModifier || InvalidIterator;
}

fn Parser::ParseOpenMPVarListClause(self, DKind: OpenMPDirectiveKind, Kind: OpenMPClauseKind, ParseOnly: bool) -> *mut OMPClause {
    let mut Loc: SourceLocation = self.Tok.getLocation();
    let mut LOpen: SourceLocation = self.ConsumeToken();
    let mut Vars: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
    let mut Data: OpenMPVarListDataTy = OpenMPVarListDataTy {};
    if self.ParseOpenMPVarList(DKind, Kind, Vars, Data) {
        return null;
    }
    if ParseOnly {
        return null;
    }
    let mut Locs: OMPVarListLocTy = OMPVarListLocTy { StartLoc: Loc, LParenLoc: LOpen, EndLoc: Data.RLoc };
    return self.Actions.OpenMP().ActOnOpenMPVarListClause(Kind, Vars, Locs, Data);
}

fn Parser::ParseOpenMPExprListClause(self, Kind: OpenMPClauseKind, ClauseNameLoc: *mut SourceLocation, OpenLoc: *mut SourceLocation, CloseLoc: *mut SourceLocation, Exprs: *mut SmallVectorImpl<Expr *>, ReqIntConst: bool) -> bool {
    assert!(getOpenMPClauseName(Kind, 0) == self.PP.getSpelling(self.Tok, null), "Expected parsing to start at clause name");
    ClauseNameLoc = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, annot_pragma_openmp_end };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        return true;
    }
    while true {
        {
        let mut Val: ExprResult = if ReqIntConst { self.ParseConstantExpression() } else { self.ParseAssignmentExpression(AllowNonTypes) };
        if !Val.isUsable() {
            T.skipToEnd();
            return true;
        }
        Exprs.push(Val.get());
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    let mut Result: bool = T.consumeClose();
    OpenLoc = T.getOpenLocation();
    CloseLoc = T.getCloseLocation();
    return Result;
}

