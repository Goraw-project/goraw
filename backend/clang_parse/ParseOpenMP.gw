unsafe fn Closure_13::call(self: *mut Closure_13) -> SourceLocation &>> {
            let mut Type: u32 = NumberOfModifiers;
            let mut Modifier: u32 = 0;
            let mut Loc: SourceLocation = SourceLocation {};
            if !self.Tok.isAnnotation() && self.PP.getSpelling(self.Tok, null) == "fallback" && self.NextToken().is(l_paren) {
                self.ConsumeToken();
                let mut ParenT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, r_paren };
                ParenT.consumeOpen();
                Modifier = getOpenMPSimpleClauseType((*self.Kind), if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
                if Modifier <= OMPC_DYN_GROUPPRIVATE_FALLBACK_unknown || Modifier >= OMPC_DYN_GROUPPRIVATE_FALLBACK_last {
                    self.Diag(self.Tok.getLocation(), err_expected) << "'abort', 'null' or 'default_mem' in fallback modifier";
                    self.SkipUntil(r_paren, 0 as SkipUntilFlags);
                    return make_tuple(Type, Modifier, Loc);
                }
                Type = ComplexModifier;
                Loc = self.Tok.getLocation();
                if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
                    self.ConsumeAnyToken(false);
                }
                ParenT.consumeClose();
            } else {
                Modifier = getOpenMPSimpleClauseType((*self.Kind), if self.Tok.isAnnotation() { "" } else { self.PP.getSpelling(self.Tok, null) }, self.getLangOpts());
                if Modifier < OMPC_DYN_GROUPPRIVATE_unknown {
                    Type = SimpleModifier;
                    Loc = self.Tok.getLocation();
                    if self.Tok.isNot(r_paren) && self.Tok.isNot(comma) && self.Tok.isNot(annot_pragma_openmp_end) {
                        self.ConsumeAnyToken(false);
                    }
                }
            }
            return make_tuple(Type, Modifier, Loc);
        }

