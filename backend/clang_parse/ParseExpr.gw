fn Parser::ParseExpression(self, CorrectionBehavior: TypoCorrectionTypeBehavior) -> ExprResult {
    let mut LHS: ExprResult = self.ParseAssignmentExpression(CorrectionBehavior);
    return self.ParseRHSOfBinaryExpression(LHS, Comma);
}

fn Parser::ParseExpressionWithLeadingAt(self, AtLoc: SourceLocation) -> ExprResult {
    let mut LHS: ExprResult = self.ParseObjCAtExpression(AtLoc);
    return self.ParseRHSOfBinaryExpression(LHS, Comma);
}

fn Parser::ParseExpressionWithLeadingExtension(self, ExtLoc: SourceLocation) -> ExprResult {
    let mut LHS: ExprResult = true;
    {
        let mut O: ExtensionRAIIObject = self.Diags;
        LHS = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
    }
    if !LHS.isInvalid() {
        LHS = self.Actions.ActOnUnaryOp(self.getCurScope(), ExtLoc, kw___extension__, LHS.get(), false);
    }
    return self.ParseRHSOfBinaryExpression(LHS, Comma);
}

fn Parser::ParseAssignmentExpression(self, CorrectionBehavior: TypoCorrectionTypeBehavior) -> ExprResult {
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteExpression(self.getCurScope(), self.PreferredType.get(self.Tok.getLocation()), false, false);
        return ExprError();
    }
    if self.Tok.is(kw_throw) {
        return self.ParseThrowExpression();
    }
    if self.Tok.is(kw_co_yield) {
        return self.ParseCoyieldExpression();
    }
    let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, false, CorrectionBehavior, false, null);
    return self.ParseRHSOfBinaryExpression(LHS, Assignment);
}

fn Parser::ParseConditionalExpression(self) -> ExprResult {
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteExpression(self.getCurScope(), self.PreferredType.get(self.Tok.getLocation()), false, false);
        return ExprError();
    }
    let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
    return self.ParseRHSOfBinaryExpression(LHS, Conditional);
}

fn Parser::ParseAssignmentExprWithObjCMessageExprStart(self, LBracLoc: SourceLocation, SuperLoc: SourceLocation, ReceiverType: ParsedType, ReceiverExpr: *mut Expr) -> ExprResult {
    let mut R: ExprResult = self.ParseObjCMessageExpressionBody(LBracLoc, SuperLoc, ReceiverType, ReceiverExpr);
    R = self.ParsePostfixExpressionSuffix(R);
    return self.ParseRHSOfBinaryExpression(R, Assignment);
}

fn Parser::ParseConstantExpressionInExprEvalContext(self, CorrectionBehavior: TypoCorrectionTypeBehavior) -> ExprResult {
    assert!(self.Actions.ExprEvalContexts.back().Context == ConstantEvaluated, "Call this function only if your ExpressionEvaluationContext is already ConstantEvaluated");
    let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, false, CorrectionBehavior, false, null);
    let mut Res: ExprResult = self.ParseRHSOfBinaryExpression(LHS, Conditional);
    return self.Actions.ActOnConstantExpression(Res);
}

fn Parser::ParseConstantExpression(self) -> ExprResult {
    let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
    return self.ParseConstantExpressionInExprEvalContext(AllowNonTypes);
}

fn Parser::ParseArrayBoundExpression(self) -> ExprResult {
    let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
    self.Actions.ExprEvalContexts.back().InConditionallyConstantEvaluateContext = true;
    for let mut Iter: ExpressionEvaluationContextRecord *> = self.Actions.ExprEvalContexts.rbegin() + 1; Iter != self.Actions.ExprEvalContexts.rend(); operator(Iter) {
        if !operator(Iter).isUnevaluated() {
            break;
        }
        operator(Iter).InConditionallyConstantEvaluateContext = true;
    }
    return self.ParseConstantExpressionInExprEvalContext(AllowNonTypes);
}

fn Parser::ParseCaseExpression(self, CaseLoc: SourceLocation) -> ExprResult {
    let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
    self.Actions.currentEvaluationContext().IsCaseExpr = true;
    let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
    let mut Res: ExprResult = self.ParseRHSOfBinaryExpression(LHS, Conditional);
    return self.Actions.ActOnCaseExpr(CaseLoc, Res);
}

fn Parser::ParseConstraintExpression(self) -> ExprResult {
    let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Other, true };
    let mut LHS: ExprResult = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
    let mut Res: ExprResult = self.ParseRHSOfBinaryExpression(LHS, LogicalOr);
    if Res.isUsable() && !self.Actions.CheckConstraintExpression(Res.get(), Token {}, null, false) {
        return ExprError();
    }
    return Res;
}

fn Parser::ParseConstraintLogicalAndExpression(self, IsTrailingRequiresClause: bool) -> ExprResult {
    let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Other, true };
    let mut NotPrimaryExpression: bool = false;
    let mut ParsePrimary: Closure_1 = Closure_1 { cap_0: self, NotPrimaryExpression: &mut NotPrimaryExpression, IsTrailingRequiresClause: &mut IsTrailingRequiresClause };
    let mut LHS: ExprResult = ParsePrimary.call();
    if LHS.isInvalid() {
        return ExprError();
    }
    while self.Tok.is(ampamp) {
        let mut LogicalAndLoc: SourceLocation = self.ConsumeToken();
        let mut RHS: ExprResult = ParsePrimary.call();
        if RHS.isInvalid() {
            return ExprError();
        }
        let mut Op: ExprResult = self.Actions.ActOnBinOp(self.getCurScope(), LogicalAndLoc, ampamp, LHS.get(), RHS.get());
        if !Op.isUsable() {
            return ExprError();
        }
        LHS = Op;
    }
    return LHS;
}

fn Parser::ParseConstraintLogicalOrExpression(self, IsTrailingRequiresClause: bool) -> ExprResult {
    let mut LHS: ExprResult = self.ParseConstraintLogicalAndExpression(IsTrailingRequiresClause);
    if !LHS.isUsable() {
        return ExprError();
    }
    while self.Tok.is(pipepipe) {
        let mut LogicalOrLoc: SourceLocation = self.ConsumeToken();
        let mut RHS: ExprResult = self.ParseConstraintLogicalAndExpression(IsTrailingRequiresClause);
        if !RHS.isUsable() {
            return ExprError();
        }
        let mut Op: ExprResult = self.Actions.ActOnBinOp(self.getCurScope(), LogicalOrLoc, pipepipe, LHS.get(), RHS.get());
        if !Op.isUsable() {
            return ExprError();
        }
        LHS = Op;
    }
    return LHS;
}

fn Parser::isNotExpressionStart(self) -> bool {
    let mut K: TokenKind = self.Tok.getKind();
    if K == l_brace || K == r_brace || K == kw_for || K == kw_while || K == kw_if || K == kw_else || K == kw_goto || K == kw_try {
        return true;
    }
    return self.isKnownToBeDeclarationSpecifier();
}

fn Parser::isFoldOperator(self: *Parser, Level: Level) -> bool {
    return Level > Unknown && Level != Conditional && Level != Spaceship;
}

fn Parser::isFoldOperator(self: *Parser, Kind: TokenKind) -> bool {
    return self.isFoldOperator(getBinOpPrecedence(Kind, self.GreaterThanIsOperator, true));
}

fn Parser::ParseRHSOfBinaryExpression(self, LHS: ExprResult, MinPrec: Level) -> ExprResult {
    let mut NextTokPrec: Level = getBinOpPrecedence(self.Tok.getKind(), self.GreaterThanIsOperator, self.getLangOpts().CPlusPlus11);
    let mut ColonLoc: SourceLocation = SourceLocation {};
    let mut SavedType: PreferredTypeBuilder = self.PreferredType;
    while true {
        self.PreferredType = SavedType;
        if NextTokPrec < MinPrec {
            return LHS;
        }
        let mut OpToken: Token = self.Tok;
        self.ConsumeToken();
        if OpToken.is(caretcaret) {
            assert!(self.getLangOpts().Reflection);
            if self.getLangOpts().Blocks {
                OpToken.setKind(caret);
                let mut Caret: Token = Token {};
                {
                    Caret.startToken();
                    Caret.setKind(caret);
                    Caret.setLocation(OpToken.getLocation().getLocWithOffset(1));
                    Caret.setLength(1);
                }
                self.UnconsumeToken(OpToken);
                self.PP.EnterToken(Caret, true);
                return self.ParseRHSOfBinaryExpression(LHS, MinPrec);
            }
        }
        if OpToken.isOneOf(comma, greater, greatergreater, greatergreatergreater) && self.checkPotentialAngleBracketDelimiter(OpToken) {
            return ExprError();
        }
        if OpToken.is(comma) && self.isNotExpressionStart() {
            self.PP.EnterToken(self.Tok, true);
            self.Tok = OpToken;
            return LHS;
        }
        if self.isFoldOperator(NextTokPrec) && self.Tok.is(ellipsis) {
            self.PP.EnterToken(self.Tok, true);
            self.Tok = OpToken;
            return LHS;
        }
        if self.getLangOpts().ObjC && self.getLangOpts().CPlusPlus && self.Tok.isOneOf(colon, r_square) && OpToken.getIdentifierInfo() != null {
            self.PP.EnterToken(self.Tok, true);
            self.Tok = OpToken;
            return LHS;
        }
        let mut TernaryMiddle: ExprResult = true;
        if NextTokPrec == Conditional {
            if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
                let mut BraceLoc: SourceLocation = self.Tok.getLocation();
                TernaryMiddle = self.ParseBraceInitializer();
                if !TernaryMiddle.isInvalid() {
                    self.Diag(BraceLoc, err_init_list_bin_op) << 1 << self.PP.getSpelling(OpToken, null) << self.Actions.getExprRange(TernaryMiddle.get());
                    TernaryMiddle = ExprError();
                }
            } else if self.Tok.isNot(colon) {
                let mut X: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
                TernaryMiddle = self.ParseExpression(AllowNonTypes);
            } else {
                TernaryMiddle = null;
                self.Diag(self.Tok, ext_gnu_conditional_expr);
            }
            if TernaryMiddle.isInvalid() {
                LHS = ExprError();
                TernaryMiddle = null;
            }
            if !self.TryConsumeToken(colon, ColonLoc) {
                let mut FILoc: SourceLocation = self.Tok.getLocation();
                let mut FIText: *u8 = ": ";
                let mut SM: *SourceManager = self.PP.getSourceManager();
                if FILoc.isFileID() || self.PP.isAtStartOfMacroExpansion(FILoc, &mut FILoc) {
                    assert!(FILoc.isFileID();
                    let mut IsInvalid: bool = false;
                    let mut SourcePtr: *u8 = SM.getCharacterData(FILoc.getLocWithOffset(-1), &mut IsInvalid);
                    if !IsInvalid && *SourcePtr == ' ' {
                        SourcePtr = SM.getCharacterData(FILoc.getLocWithOffset(-2), &mut IsInvalid);
                        if !IsInvalid && *SourcePtr == ' ' {
                            FILoc = FILoc.getLocWithOffset(-1);
                            FIText = ":";
                        }
                    }
                }
                self.Diag(self.Tok, err_expected) << colon << CreateInsertion(FILoc, FIText, false);
                self.Diag(OpToken, note_matching) << question;
                ColonLoc = self.Tok.getLocation();
            }
        }
        self.PreferredType.enterBinary(self.Actions, self.Tok.getLocation(), LHS.get(), OpToken.getKind());
        let mut RHS: ExprResult = false;
        let mut RHSIsInitList: bool = false;
        if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
            RHS = self.ParseBraceInitializer();
            RHSIsInitList = true;
        } else if self.getLangOpts().CPlusPlus && NextTokPrec <= Conditional {
            RHS = self.ParseAssignmentExpression(AllowNonTypes);
        } else {
            RHS = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
        }
        if RHS.isInvalid() && self.Tok.isNot(semi) {
            LHS = ExprError();
        }
        let mut ThisPrec: Level = NextTokPrec;
        NextTokPrec = getBinOpPrecedence(self.Tok.getKind(), self.GreaterThanIsOperator, self.getLangOpts().CPlusPlus11);
        let mut isRightAssoc: bool = ThisPrec == Conditional || ThisPrec == Assignment;
        if ThisPrec < NextTokPrec || (ThisPrec == NextTokPrec && isRightAssoc) {
            if !RHS.isInvalid() && RHSIsInitList {
                self.Diag(self.Tok, err_init_list_bin_op) << 0 << self.PP.getSpelling(self.Tok, null) << self.Actions.getExprRange(RHS.get());
                RHS = ExprError();
            }
            RHS = self.ParseRHSOfBinaryExpression(RHS, ThisPrec + !isRightAssoc as Level);
            RHSIsInitList = false;
            if RHS.isInvalid() && self.Tok.isNot(semi) {
                LHS = ExprError();
            }
            NextTokPrec = getBinOpPrecedence(self.Tok.getKind(), self.GreaterThanIsOperator, self.getLangOpts().CPlusPlus11);
        }
        if !RHS.isInvalid() && RHSIsInitList {
            if ThisPrec == Assignment {
                self.Diag(OpToken, compat_cxx11_generalized_initializer_lists) << self.Actions.getExprRange(RHS.get());
            } else if ColonLoc.isValid() {
                self.Diag(ColonLoc, err_init_list_bin_op) << 1 << ":" << self.Actions.getExprRange(RHS.get());
                LHS = ExprError();
            } else {
                self.Diag(OpToken, err_init_list_bin_op) << 1 << self.PP.getSpelling(OpToken, null) << self.Actions.getExprRange(RHS.get());
                LHS = ExprError();
            }
        }
        if !LHS.isInvalid() {
            if RHS.isInvalid() {
                LHS = self.Actions.CreateRecoveryExpr(LHS.get().getBeginLoc(), self.PrevTokLocation, [LHS.get()], QualType {});
            } else if TernaryMiddle.isInvalid() {
                if !self.GreaterThanIsOperator && OpToken.is(greatergreater) {
                    self.SuggestParentheses(OpToken.getLocation(), warn_cxx11_right_shift_in_template_arg, SourceRange { B: self.Actions.getExprRange(LHS.get()).getBegin(), E: self.Actions.getExprRange(RHS.get()).getEnd() });
                }
                let mut BinOp: ExprResult = self.Actions.ActOnBinOp(self.getCurScope(), OpToken.getLocation(), OpToken.getKind(), LHS.get(), RHS.get());
                if BinOp.isInvalid() {
                    BinOp = self.Actions.CreateRecoveryExpr(LHS.get().getBeginLoc(), RHS.get().getEndLoc(), [LHS.get(), RHS.get()], QualType {});
                }
                LHS = BinOp;
            } else {
                let mut CondOp: ExprResult = self.Actions.ActOnConditionalOp(OpToken.getLocation(), ColonLoc, LHS.get(), TernaryMiddle.get(), RHS.get());
                if CondOp.isInvalid() {
                    let mut Args: []*mut Expr = []*mut Expr {};
                    if TernaryMiddle.get() {
                        Args = [LHS.get(), TernaryMiddle.get(), RHS.get()];
                    } else {
                        Args = [LHS.get(), RHS.get()];
                    }
                    CondOp = self.Actions.CreateRecoveryExpr(LHS.get().getBeginLoc(), RHS.get().getEndLoc(), Args, QualType {});
                }
                LHS = CondOp;
            }
        }
    }
}

fn Parser::ParseCastExpression(self, ParseKind: CastParseKind, isAddressOfOperand: bool, CorrectionBehavior: TypoCorrectionTypeBehavior, isVectorLiteral: bool, NotPrimaryExpression: *mut bool) -> ExprResult {
    let mut NotCastExpr: bool = false;
    let mut Res: ExprResult = self.ParseCastExpression(ParseKind, isAddressOfOperand, NotCastExpr, CorrectionBehavior, isVectorLiteral, NotPrimaryExpression);
    if NotCastExpr {
        self.Diag(self.Tok, err_expected_expression);
    }
    return Res;
}

struct CastExpressionIdValidator {
    WantTypeSpecifiers: bool,
    WantExpressionKeywords: bool,
    WantCXXNamedCasts: bool,
    WantFunctionLikeCasts: bool,
    WantRemainingKeywords: bool,
    WantObjCSuper: bool,
    IsObjCIvarLookup: bool,
    IsAddressOfOperand: bool,
    Typo: *IdentifierInfo,
    TypoNNS: NestedNameSpecifier,
    NextToken: Token,
    AllowNonTypes: bool,
}

fn CastExpressionIdValidator::CastExpressionIdValidator(self, Next: Token, CorrectionBehavior: TypoCorrectionTypeBehavior) {
    self.WantTypeSpecifiers = self.WantFunctionLikeCasts = (CorrectionBehavior != AllowNonTypes);
    self.AllowNonTypes = (CorrectionBehavior != AllowTypes);
}

fn CastExpressionIdValidator::ValidateCandidate(self, candidate: *TypoCorrection) -> bool {
    let mut ND: *mut NamedDecl = candidate.getCorrectionDecl();
    if !ND {
        return candidate.isKeyword();
    }
    if isa(ND) {
        return self.WantTypeSpecifiers;
    }
    if !self.AllowNonTypes || !self.ValidateCandidate(candidate) {
        return false;
    }
    if !self.NextToken.isOneOf(equal, arrow, period) {
        return true;
    }
    for C in candidate {
        let mut ND: *mut NamedDecl = C.getUnderlyingDecl();
        if isa(ND) && !isa(ND) {
            return true;
        }
    }
    return false;
}

fn CastExpressionIdValidator::clone(self) -> unique_ptr<CorrectionCandidateCallback> {
    return make_unique(*self);
}

fn CastExpressionIdValidator::RankCandidate(self, candidate: *TypoCorrection) -> u32 {
    return if (!self.MatchesTypo(candidate) && self.ValidateCandidate(candidate)) { 0 } else { InvalidDistance };
}

fn CastExpressionIdValidator::setTypoName(self, II: *IdentifierInfo) {
    self.Typo = II;
}

fn CastExpressionIdValidator::setTypoNNS(self, NNS: NestedNameSpecifier) {
    self.TypoNNS = NNS;
}

fn CastExpressionIdValidator::MatchesTypo(self, candidate: *TypoCorrection) -> bool {
    return self.Typo && candidate.isResolved() && !candidate.requiresImport() && candidate.getCorrectionAsIdentifierInfo() == self.Typo && candidate.getCorrectionSpecifier() == self.TypoNNS;
}

fn Parser::isRevertibleTypeTrait(self, II: *IdentifierInfo, Kind: *mut TokenKind) -> bool {
    if self.RevertibleTypeTraits.is_empty() {
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_abstract")] = kw___is_abstract;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_aggregate")] = kw___is_aggregate;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_arithmetic")] = kw___is_arithmetic;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_array")] = kw___is_array;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_assignable")] = kw___is_assignable;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_base_of")] = kw___is_base_of;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_bounded_array")] = kw___is_bounded_array;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_class")] = kw___is_class;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_complete_type")] = kw___is_complete_type;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_compound")] = kw___is_compound;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_const")] = kw___is_const;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_constructible")] = kw___is_constructible;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_convertible")] = kw___is_convertible;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_convertible_to")] = kw___is_convertible_to;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_destructible")] = kw___is_destructible;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_empty")] = kw___is_empty;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_enum")] = kw___is_enum;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_floating_point")] = kw___is_floating_point;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_final")] = kw___is_final;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_function")] = kw___is_function;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_fundamental")] = kw___is_fundamental;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_integral")] = kw___is_integral;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_interface_class")] = kw___is_interface_class;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_literal")] = kw___is_literal;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_lvalue_expr")] = kw___is_lvalue_expr;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_lvalue_reference")] = kw___is_lvalue_reference;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_member_function_pointer")] = kw___is_member_function_pointer;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_member_object_pointer")] = kw___is_member_object_pointer;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_member_pointer")] = kw___is_member_pointer;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_nothrow_assignable")] = kw___is_nothrow_assignable;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_nothrow_constructible")] = kw___is_nothrow_constructible;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_nothrow_destructible")] = kw___is_nothrow_destructible;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_object")] = kw___is_object;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_pod")] = kw___is_pod;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_pointer")] = kw___is_pointer;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_polymorphic")] = kw___is_polymorphic;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_reference")] = kw___is_reference;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_rvalue_expr")] = kw___is_rvalue_expr;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_rvalue_reference")] = kw___is_rvalue_reference;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_same")] = kw___is_same;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_scalar")] = kw___is_scalar;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_scoped_enum")] = kw___is_scoped_enum;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_sealed")] = kw___is_sealed;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_signed")] = kw___is_signed;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_standard_layout")] = kw___is_standard_layout;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_trivial")] = kw___is_trivial;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_trivially_assignable")] = kw___is_trivially_assignable;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_trivially_constructible")] = kw___is_trivially_constructible;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_trivially_copyable")] = kw___is_trivially_copyable;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_unbounded_array")] = kw___is_unbounded_array;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_union")] = kw___is_union;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_unsigned")] = kw___is_unsigned;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_void")] = kw___is_void;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__is_volatile")] = kw___is_volatile;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("__reference_binds_to_temporary")] = kw___reference_binds_to_temporary;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, add_lvalue_reference)")] = kw___add_lvalue_reference;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, add_pointer)")] = kw___add_pointer;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, add_rvalue_reference)")] = kw___add_rvalue_reference;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, decay)")] = kw___decay;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, make_signed)")] = kw___make_signed;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, make_unsigned)")] = kw___make_unsigned;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, remove_all_extents)")] = kw___remove_all_extents;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, remove_const)")] = kw___remove_const;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, remove_cv)")] = kw___remove_cv;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, remove_cvref)")] = kw___remove_cvref;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, remove_extent)")] = kw___remove_extent;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, remove_pointer)")] = kw___remove_pointer;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, remove_reference_t)")] = kw___remove_reference_t;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, remove_restrict)")] = kw___remove_restrict;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, remove_volatile)")] = kw___remove_volatile;
        self.RevertibleTypeTraits[self.PP.getIdentifierInfo("RTT_JOIN(__, underlying_type)")] = kw___underlying_type;
    }
    let mut Known: iterator = self.RevertibleTypeTraits.find(II);
    if Known != self.RevertibleTypeTraits.end() {
        if Kind {
            *Kind = operator(Known).second;
        }
        return true;
    }
    return false;
}

fn Parser::ParseBuiltinPtrauthTypeDiscriminator(self) -> ExprResult {
    let mut Loc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected, "", unknown) {
        return ExprError();
    }
    let mut Ty: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
    if Ty.isInvalid() {
        self.SkipUntil(r_paren, StopAtSemi);
        return ExprError();
    }
    let mut EndLoc: SourceLocation = self.Tok.getLocation();
    T.consumeClose();
    return self.Actions.ActOnUnaryExprOrTypeTraitExpr(Loc, UETT_PtrAuthTypeDiscriminator, true, Ty.get().getAsOpaquePtr(), SourceRange { B: Loc, E: EndLoc });
}

fn Parser::ParseCastExpression(self, ParseKind: CastParseKind, isAddressOfOperand: bool, NotCastExpr: *mut bool, CorrectionBehavior: TypoCorrectionTypeBehavior, isVectorLiteral: bool, NotPrimaryExpression: *mut bool) -> ExprResult {
    let mut Res: ExprResult = false;
    let mut SavedKind: TokenKind = self.Tok.getKind();
    let mut SavedType: PreferredTypeBuilder = self.PreferredType;
    NotCastExpr = false;
    let mut AllowSuffix: bool = true;
    match SavedKind {
        l_paren => {
            let mut ParenExprType: ParenParseOption = zeroed();
            match ParseKind {
                UnaryExprOnly => {
                    assert!(self.getLangOpts().CPlusPlus, "not possible to get here in C");
                },
                AnyCastExpr => {
                    ParenExprType = CastExpr;
                },
                PrimaryExprOnly => {
                    ParenExprType = FoldExpr;
                },
            }
            let mut CastTy: ParsedType = null;
            let mut RParenLoc: SourceLocation = SourceLocation {};
            Res = self.ParseParenExpression(ParenExprType, false, Unknown, CorrectionBehavior, CastTy, RParenLoc);
            if isVectorLiteral {
                return Res;
            }
            match ParenExprType {
                SimpleExpr => {
                    break;
                },
                CompoundStmt => {
                    break;
                },
                CompoundLiteral => {
                    break;
                },
                CastExpr => {
                    return Res;
                },
                FoldExpr => {
                    break;
                },
            }
            break;
        },
        numeric_constant => {
            binary_data;
        },
        kw_true => {
            kw_false;
        },
        kw___objc_yes => {
            kw___objc_no;
        },
        kw_nullptr => {
            if self.getLangOpts().CPlusPlus {
                self.Diag(self.Tok, warn_cxx98_compat_nullptr);
            } else {
                self.Diag(self.Tok, if self.getLangOpts().C23 { warn_c23_compat_keyword } else { ext_c_nullptr }) << self.Tok.getName();
            }
        },
        annot_primary_expr => {
            annot_overload_set;
        },
        annot_non_type => {
            annot_non_type_dependent;
        },
        annot_embed => {
            self.injectEmbedTokens();
            return self.ParseCastExpression(ParseKind, isAddressOfOperand, CorrectionBehavior, isVectorLiteral, NotPrimaryExpression);
        },
        kw___super => {
            kw_decltype;
        },
        identifier => {
            self.getLangOpts().CPlusPlus;
        },
        char_constant => {
            wide_char_constant;
        },
        kw___func__ => {
            kw___FUNCTION__;
        },
        string_literal => {
            wide_string_literal;
        },
        kw__Generic => {
            Res = self.ParseGenericSelectionExpression();
        },
        kw___builtin_available => {
            Res = self.ParseAvailabilityCheckExpr(self.Tok.getLocation());
        },
        kw___builtin_va_arg => {
            kw___builtin_offsetof;
        },
        kw___null => {
            Res = self.Actions.ActOnGNUNullExpr(self.ConsumeToken());
        },
        plusplus => {
            minusminus;
        },
        amp => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
            let mut SavedLoc: SourceLocation = self.ConsumeToken();
            self.PreferredType.enterUnary(self.Actions, self.Tok.getLocation(), amp, SavedLoc);
            Res = self.ParseCastExpression(AnyCastExpr, true, AllowNonTypes, false, null);
            if !Res.isInvalid() {
                let mut Arg: *mut Expr = Res.get();
                Res = self.Actions.ActOnUnaryOp(self.getCurScope(), SavedLoc, SavedKind, Arg, false);
                if Res.isInvalid() {
                    Res = self.Actions.CreateRecoveryExpr(self.Tok.getLocation(), Arg.getEndLoc(), Arg, QualType {});
                }
            }
            return Res;
        },
        star => {
            plus;
        },
        kw_co_await => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
            let mut CoawaitLoc: SourceLocation = self.ConsumeToken();
            Res = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
            if !Res.isInvalid() {
                Res = self.Actions.ActOnCoawaitExpr(self.getCurScope(), CoawaitLoc, Res.get());
            }
            return Res;
        },
        kw___extension__ => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
            let mut O: ExtensionRAIIObject = self.Diags;
            let mut SavedLoc: SourceLocation = self.ConsumeToken();
            Res = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
            if !Res.isInvalid() {
                Res = self.Actions.ActOnUnaryOp(self.getCurScope(), SavedLoc, SavedKind, Res.get(), false);
            }
            return Res;
        },
        kw__Alignof => {
            self.diagnoseUseOfC11Keyword(self.Tok);
        },
        kw_alignof => {
            kw___alignof;
        },
        caretcaret => {
            if !self.getLangOpts().Reflection {
                NotCastExpr = true;
                return ExprError();
            }
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
            AllowSuffix = false;
            Res = self.ParseCXXReflectExpression();
            break;
        },
        ampamp => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
            let mut AmpAmpLoc: SourceLocation = self.ConsumeToken();
            if self.Tok.isNot(identifier) {
                return ExprError(self.Diag(self.Tok, err_expected) << identifier);
            }
            if self.getCurScope().getFnParent() == null {
                return ExprError(self.Diag(self.Tok, err_address_of_label_outside_fn));
            }
            self.Diag(AmpAmpLoc, ext_gnu_address_of_label);
            let mut LD: *mut LabelDecl = self.Actions.LookupOrCreateLabel(self.Tok.getIdentifierInfo(), self.Tok.getLocation(), SourceLocation {}, false);
            Res = self.Actions.ActOnAddrLabel(AmpAmpLoc, self.Tok.getLocation(), LD);
            self.ConsumeToken();
            AllowSuffix = false;
            break;
        },
        kw_const_cast => {
            kw_dynamic_cast;
        },
        kw___builtin_bit_cast => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
        },
        kw_typeid => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
        },
        kw___uuidof => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
        },
        kw_this => {
            Res = self.ParseCXXThis();
        },
        kw___builtin_sycl_unique_stable_name => {
            Res = self.ParseSYCLUniqueStableNameExpression();
        },
        annot_typename => {
            if self.isStartOfObjCClassMessageMissingOpenBracket() {
                let mut Type: TypeResult = getTypeAnnotation(self.Tok);
                let mut DS: DeclSpec = self.AttrFactory;
                DS.SetRangeStart(self.Tok.getLocation());
                DS.SetRangeEnd(self.Tok.getLastLoc());
                let mut PrevSpec: *u8 = null;
                let mut DiagID: u32 = 0;
                DS.SetTypeSpecType(TST_typename, self.Tok.getAnnotationEndLoc(), PrevSpec, DiagID, Type, self.Actions.getASTContext().getPrintingPolicy());
                let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
                let mut Ty: TypeResult = self.Actions.ActOnTypeName(DeclaratorInfo);
                if Ty.isInvalid() {
                    break;
                }
                self.ConsumeAnnotationToken();
                Res = self.ParseObjCMessageExpressionBody(SourceLocation {}, SourceLocation {}, Ty.get(), null);
                break;
            }
        },
        annot_decltype => {
            annot_pack_indexing_type;
        },
        annot_cxxscope => {
            if self.TryAnnotateTypeOrScopeToken(No, false) {
                return ExprError();
            }
            if !self.Tok.is(annot_cxxscope) {
                return self.ParseCastExpression(ParseKind, isAddressOfOperand, NotCastExpr, CorrectionBehavior, isVectorLiteral, NotPrimaryExpression);
            }
            let mut Next: Token = self.NextToken();
            if Next.is(annot_template_id) {
                let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(Next);
                if TemplateId.Kind == TNK_Type_template {
                    let mut SS: CXXScopeSpec = CXXScopeSpec {};
                    self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, false, false, false, false, false);
                    self.AnnotateTemplateIdTokenAsType(SS, Yes, false);
                    return self.ParseCastExpression(ParseKind, isAddressOfOperand, NotCastExpr, CorrectionBehavior, isVectorLiteral, NotPrimaryExpression);
                }
            }
            Res = self.ParseCXXIdExpression(isAddressOfOperand);
            break;
        },
        annot_template_id => {
            let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
            if TemplateId.Kind == TNK_Type_template {
                let mut SS: CXXScopeSpec = CXXScopeSpec {};
                self.AnnotateTemplateIdTokenAsType(SS, Yes, false);
                return self.ParseCastExpression(ParseKind, isAddressOfOperand, NotCastExpr, CorrectionBehavior, isVectorLiteral, NotPrimaryExpression);
            }
        },
        kw_operator => {
            Res = self.ParseCXXIdExpression(isAddressOfOperand);
        },
        coloncolon => {
            if self.TryAnnotateTypeOrScopeToken(No, false) {
                return ExprError();
            }
            if !self.Tok.is(coloncolon) {
                return self.ParseCastExpression(ParseKind, isAddressOfOperand, CorrectionBehavior, isVectorLiteral, NotPrimaryExpression);
            }
            let mut CCLoc: SourceLocation = self.ConsumeToken();
            if self.Tok.is(kw_new) {
                if NotPrimaryExpression {
                    *NotPrimaryExpression = true;
                }
                Res = self.ParseCXXNewExpression(true, CCLoc);
                AllowSuffix = false;
                break;
            }
            if self.Tok.is(kw_delete) {
                if NotPrimaryExpression {
                    *NotPrimaryExpression = true;
                }
                Res = self.ParseCXXDeleteExpression(true, CCLoc);
                AllowSuffix = false;
                break;
            }
            self.Diag(CCLoc, err_expected_expression);
            return ExprError();
        },
        kw_new => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
        },
        kw_delete => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
        },
        kw_requires => {
            Res = self.ParseRequiresExpression();
        },
        kw_noexcept => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
            self.Diag(self.Tok, warn_cxx98_compat_noexcept_expr);
            let mut KeyLoc: SourceLocation = self.ConsumeToken();
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
            if T.expectAndConsume(err_expected_lparen_after, "noexcept", unknown) {
                return ExprError();
            }
            let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Other, true };
            Res = self.ParseExpression(AllowNonTypes);
            T.consumeClose();
            if !Res.isInvalid() {
                Res = self.Actions.ActOnNoexceptExpr(KeyLoc, T.getOpenLocation(), Res.get(), T.getCloseLocation());
            }
            AllowSuffix = false;
            break;
        },
        kw___builtin_types_compatible_p => {
            kw___builtin_type_order;
        },
        kw___array_rank => {
            kw___array_extent;
        },
        kw___builtin_ptrauth_type_discriminator => {
            return self.ParseBuiltinPtrauthTypeDiscriminator();
        },
        kw___is_lvalue_expr => {
            kw___is_rvalue_expr;
        },
        at => {
            if NotPrimaryExpression {
                *NotPrimaryExpression = true;
            }
            let mut AtLoc: SourceLocation = self.ConsumeToken();
            return self.ParseObjCAtExpression(AtLoc);
        },
        caret => {
            Res = self.ParseBlockLiteralExpression();
        },
        code_completion => {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteExpression(self.getCurScope(), self.PreferredType.get(self.Tok.getLocation()), false, isAddressOfOperand);
            return ExprError();
        },
        kw___add_lvalue_reference => {
            kw___add_pointer;
        },
        l_square => {
            if self.getLangOpts().CPlusPlus {
                if self.getLangOpts().ObjC {
                    Res = self.TryParseLambdaExpression();
                    if !Res.isInvalid() && !Res.get() {
                        if NotPrimaryExpression {
                            *NotPrimaryExpression = true;
                        }
                        Res = self.ParseObjCMessageExpression();
                    }
                    break;
                }
                Res = self.ParseLambdaExpression();
                break;
            }
        },
        _ => {
            NotCastExpr = true;
        },
    }
    if ParseKind == PrimaryExprOnly {
        return Res;
    }
    if !AllowSuffix {
        if Res.isInvalid() {
            return Res;
        }
        match self.Tok.getKind() {
            l_square => {
                l_paren;
            },
            period => {
                arrow;
            },
            _ => {
                return Res;
            },
        }
        self.Diag(self.Tok.getLocation(), err_postfix_after_unary_requires_parens) << self.Tok.getKind() << Res.get().getSourceRange() << CreateInsertion(Res.get().getBeginLoc(), "(", false) << CreateInsertion(self.PP.getLocForEndOfToken(self.PrevTokLocation, 0), ")", false);
    }
    self.PreferredType = SavedType;
    Res = self.ParsePostfixExpressionSuffix(Res);
    if self.getLangOpts().OpenCL && !self.getActions().getOpenCLOptions().isAvailableOption("__cl_clang_function_pointers", self.getLangOpts()) {
        if Res.get() {
            PostfixExpr;
        } else {
            let mut Ty: QualType = PostfixExpr.getType();
            if !Ty.isNull() && operator(Ty).isFunctionType() {
                self.Diag(PostfixExpr.getExprLoc(), err_opencl_taking_function_address_parser);
                return ExprError();
            }
        }
    }
    return Res;
}

fn Parser::ParsePostfixExpressionSuffix(self, LHS: ExprResult) -> ExprResult {
    let mut Loc: SourceLocation = SourceLocation {};
    let mut SavedType: PreferredTypeBuilder = self.PreferredType;
    while true {
        self.PreferredType = SavedType;
        match self.Tok.getKind() {
            code_completion => {
                if self.InMessageExpression {
                    return LHS;
                }
            },
            identifier => {
                if self.getLangOpts().ObjC && !self.InMessageExpression && (self.NextToken().is(colon) || self.NextToken().is(r_square)) {
                    LHS = self.ParseObjCMessageExpressionBody(SourceLocation {}, SourceLocation {}, null, LHS.get());
                    break;
                }
            },
            _ => {
                return LHS;
            },
            l_square => {
                if self.getLangOpts().ObjC && self.Tok.isAtStartOfLine() && self.isSimpleObjCMessageExpression() {
                    return LHS;
                }
                if self.CheckProhibitedCXX11Attribute() {
                    return ExprError();
                }
                let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
                T.consumeOpen();
                Loc = T.getOpenLocation();
                let mut Length: ExprResult = false;
                let mut Stride: ExprResult = false;
                let mut ColonLocFirst: SourceLocation = SourceLocation {};
                let mut ColonLocSecond: SourceLocation = SourceLocation {};
                let mut ArgExprs: ExprVector = ExprVector {};
                let mut HasError: bool = false;
                self.PreferredType.enterSubscript(self.Actions, self.Tok.getLocation(), LHS.get());
                if (!self.getLangOpts().OpenMP && !self.AllowOpenACCArraySections) || self.Tok.isNot(colon) {
                    if !self.getLangOpts().CPlusPlus23 {
                        let mut Idx: ExprResult = false;
                        if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
                            self.Diag(self.Tok, compat_cxx11_generalized_initializer_lists);
                            Idx = self.ParseBraceInitializer();
                        } else {
                            Idx = self.ParseExpression(AllowNonTypes);
                        }
                        if Idx.isInvalid() {
                            HasError = true;
                        } else {
                            ArgExprs.push(Idx.get());
                        }
                    } else if self.Tok.isNot(r_square) {
                        if self.ParseExpressionList(ArgExprs, function_ref<void ()> {}, false, false) {
                            HasError = true;
                        }
                    }
                }
                if ArgExprs.len <= 1 && self.AllowOpenACCArraySections {
                    let mut RAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
                    if self.Tok.is(colon) {
                        ColonLocFirst = self.ConsumeToken();
                        if self.Tok.isNot(r_square) {
                            Length = self.ParseExpression(AllowNonTypes);
                        }
                    }
                } else if ArgExprs.len <= 1 && self.getLangOpts().OpenMP {
                    let mut RAII: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
                    if self.Tok.is(colon) {
                        ColonLocFirst = self.ConsumeToken();
                        if self.Tok.isNot(r_square) && (self.getLangOpts().OpenMP < 50 || ((self.Tok.isNot(colon) && self.getLangOpts().OpenMP >= 50))) {
                            Length = self.ParseExpression(AllowNonTypes);
                        }
                    }
                    if self.getLangOpts().OpenMP >= 50 && (self.OMPClauseKind == OMPC_to || self.OMPClauseKind == OMPC_from) && self.Tok.is(colon) {
                        ColonLocSecond = self.ConsumeToken();
                        if self.Tok.isNot(r_square) {
                            Stride = self.ParseExpression(AllowNonTypes);
                        }
                    }
                }
                let mut RLoc: SourceLocation = self.Tok.getLocation();
                if !LHS.isInvalid() && !HasError && !Length.isInvalid() && !Stride.isInvalid() && self.Tok.is(r_square) {
                    if ColonLocFirst.isValid() || ColonLocSecond.isValid() {
                        if self.AllowOpenACCArraySections {
                            assert!(!Stride.isUsable() && !ColonLocSecond.isValid(), "Stride/second colon not allowed for OpenACC");
                            LHS = self.Actions.OpenACC().ActOnArraySectionExpr(LHS.get(), Loc, if ArgExprs.is_empty() { null } else { ArgExprs[0] }, ColonLocFirst, Length.get(), RLoc);
                        } else {
                            LHS = self.Actions.OpenMP().ActOnOMPArraySectionExpr(LHS.get(), Loc, if ArgExprs.is_empty() { null } else { ArgExprs[0] }, ColonLocFirst, ColonLocSecond, Length.get(), Stride.get(), RLoc);
                        }
                    } else {
                        LHS = self.Actions.ActOnArraySubscriptExpr(self.getCurScope(), LHS.get(), Loc, ArgExprs, RLoc);
                    }
                } else {
                    LHS = ExprError();
                }
                T.consumeClose();
                break;
            },
            l_paren => {
                lesslessless;
            },
            arrow => {
                period;
            },
            plusplus => {
                minusminus;
            },
        }
    }
}

fn Parser::ParseExprAfterUnaryExprOrTypeTrait(self, OpTok: *Token, isCastExpr: *mut bool, CastTy: *mut ParsedType, CastRange: *mut SourceRange) -> ExprResult {
    assert!(OpTok.isOneOf(kw_typeof, kw_typeof_unqual, kw_sizeof, kw___datasizeof, kw___alignof, kw_alignof, kw__Alignof, kw_vec_step, kw___builtin_omp_required_simd_align, kw___builtin_vectorelements, kw__Countof), "Not a typeof/sizeof/alignof/vec_step expression!");
    let mut Operand: ExprResult = false;
    if self.Tok.isNot(l_paren) {
        if OpTok.isOneOf(kw_sizeof, kw___datasizeof, kw___alignof, kw_alignof, kw__Alignof) {
            if self.isTypeIdUnambiguously() {
                let mut DS: DeclSpec = self.AttrFactory;
                self.ParseSpecifierQualifierList(DS, AS_none, DSC_normal);
                let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
                self.ParseDeclarator(DeclaratorInfo);
                let mut LParenLoc: SourceLocation = self.PP.getLocForEndOfToken(OpTok.getLocation(), 0);
                let mut RParenLoc: SourceLocation = self.PP.getLocForEndOfToken(self.PrevTokLocation, 0);
                if LParenLoc.isInvalid() || RParenLoc.isInvalid() {
                    self.Diag(OpTok.getLocation(), err_expected_parentheses_around_typename) << OpTok.getName();
                } else {
                    self.Diag(LParenLoc, err_expected_parentheses_around_typename) << OpTok.getName() << CreateInsertion(LParenLoc, "(", false) << CreateInsertion(RParenLoc, ")", false);
                }
                isCastExpr = true;
                return ExprEmpty();
            }
        }
        isCastExpr = false;
        if OpTok.isOneOf(kw_typeof, kw_typeof_unqual) && !self.getLangOpts().CPlusPlus {
            self.Diag(self.Tok, err_expected_after) << OpTok.getIdentifierInfo() << l_paren;
            return ExprError();
        }
        if OpTok.isOneOf(kw_sizeof, kw___datasizeof, kw___alignof, kw_alignof, kw__Alignof, kw__Countof) && self.Tok.isOneOf(kw_sizeof, kw___datasizeof, kw___alignof, kw_alignof, kw__Alignof, kw__Countof) {
            self.Actions.runWithSufficientStackSpace(self.Tok.getLocation(), function_ref<void ()> { Closure_3 { Operand: &mut Operand, cap_1: self }, null, null });
        } else {
            Operand = self.ParseCastExpression(UnaryExprOnly, false, AllowNonTypes, false, null);
        }
    } else {
        let mut ParenKnownToBeNonCast: bool = OpTok.isOneOf(kw_typeof, kw_typeof_unqual);
        let mut ExprType: ParenParseOption = CastExpr;
        let mut LParenLoc: SourceLocation = self.Tok.getLocation();
        let mut RParenLoc: SourceLocation = SourceLocation {};
        Operand = self.ParseParenExpression(ExprType, true, if ParenKnownToBeNonCast { PartOfOperator } else { Unknown }, AllowBoth, CastTy, RParenLoc);
        CastRange = SourceRange { B: LParenLoc, E: RParenLoc };
        if ExprType == CastExpr {
            isCastExpr = true;
            return ExprEmpty();
        }
        if self.getLangOpts().CPlusPlus || !OpTok.isOneOf(kw_typeof, kw_typeof_unqual) {
            if !Operand.isInvalid() {
                Operand = self.ParsePostfixExpressionSuffix(Operand.get());
            }
        }
    }
    isCastExpr = false;
    return Operand;
}

fn Parser::ParseSYCLUniqueStableNameExpression(self) -> ExprResult {
    assert!(self.Tok.is(kw___builtin_sycl_unique_stable_name), "Not __builtin_sycl_unique_stable_name");
    let mut OpLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected_lparen_after, "__builtin_sycl_unique_stable_name", unknown) {
        return ExprError();
    }
    let mut Ty: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
    if Ty.isInvalid() {
        T.skipToEnd();
        return ExprError();
    }
    if T.consumeClose() {
        return ExprError();
    }
    return self.Actions.SYCL().ActOnUniqueStableNameExpr(OpLoc, T.getOpenLocation(), T.getCloseLocation(), Ty.get());
}

fn Parser::ParseUnaryExprOrTypeTraitExpression(self) -> ExprResult {
    assert!(self.Tok.isOneOf(kw_sizeof, kw___datasizeof, kw___alignof, kw_alignof, kw__Alignof, kw_vec_step, kw___builtin_omp_required_simd_align, kw___builtin_vectorelements, kw__Countof), "Not a sizeof/alignof/vec_step expression!");
    let mut OpTok: Token = self.Tok;
    self.ConsumeToken();
    if self.Tok.is(ellipsis) && OpTok.is(kw_sizeof) {
        let mut EllipsisLoc: SourceLocation = self.ConsumeToken();
        let mut LParenLoc: SourceLocation = SourceLocation {};
        let mut RParenLoc: SourceLocation = SourceLocation {};
        let mut Name: *mut IdentifierInfo = null;
        let mut NameLoc: SourceLocation = SourceLocation {};
        if self.Tok.is(l_paren) {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
            T.consumeOpen();
            LParenLoc = T.getOpenLocation();
            if self.Tok.is(identifier) {
                Name = self.Tok.getIdentifierInfo();
                NameLoc = self.ConsumeToken();
                T.consumeClose();
                RParenLoc = T.getCloseLocation();
                if RParenLoc.isInvalid() {
                    RParenLoc = self.PP.getLocForEndOfToken(NameLoc, 0);
                }
            } else {
                self.Diag(self.Tok, err_expected_parameter_pack);
                self.SkipUntil(r_paren, StopAtSemi);
            }
        } else if self.Tok.is(identifier) {
            Name = self.Tok.getIdentifierInfo();
            NameLoc = self.ConsumeToken();
            LParenLoc = self.PP.getLocForEndOfToken(EllipsisLoc, 0);
            RParenLoc = self.PP.getLocForEndOfToken(NameLoc, 0);
            self.Diag(LParenLoc, err_paren_sizeof_parameter_pack) << Name << CreateInsertion(LParenLoc, "(", false) << CreateInsertion(RParenLoc, ")", false);
        } else {
            self.Diag(self.Tok, err_sizeof_parameter_pack);
        }
        if !Name {
            return ExprError();
        }
        let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, ReuseLambdaContextDecl, EK_Other };
        return self.Actions.ActOnSizeofParameterPackExpr(self.getCurScope(), OpTok.getLocation(), *Name, NameLoc, RParenLoc);
    }
    if self.getLangOpts().CPlusPlus && OpTok.isOneOf(kw_alignof, kw__Alignof) {
        self.Diag(OpTok, warn_cxx98_compat_alignof);
    } else if self.getLangOpts().C23 && OpTok.is(kw_alignof) {
        self.Diag(OpTok, warn_c23_compat_keyword) << OpTok.getName();
    } else if self.getLangOpts().C2y && OpTok.is(kw__Countof) {
        self.Diag(OpTok, warn_c2y_compat_keyword) << OpTok.getName();
    }
    let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, ReuseLambdaContextDecl, EK_Other };
    let mut isCastExpr: bool = false;
    let mut CastTy: ParsedType = null;
    let mut CastRange: SourceRange = SourceRange {};
    let mut Operand: ExprResult = self.ParseExprAfterUnaryExprOrTypeTrait(OpTok, isCastExpr, CastTy, CastRange);
    let mut ExprKind: UnaryExprOrTypeTrait = UETT_SizeOf;
    match OpTok.getKind() {
        kw_alignof => {
            kw__Alignof;
        },
        kw___alignof => {
            ExprKind = UETT_PreferredAlignOf;
        },
        kw_vec_step => {
            ExprKind = UETT_VecStep;
        },
        kw___builtin_omp_required_simd_align => {
            ExprKind = UETT_OpenMPRequiredSimdAlign;
        },
        kw___datasizeof => {
            ExprKind = UETT_DataSizeOf;
        },
        kw___builtin_vectorelements => {
            ExprKind = UETT_VectorElements;
        },
        kw__Countof => {
            ExprKind = UETT_CountOf;
        },
        _ => {
            break;
        },
    }
    if isCastExpr {
        return self.Actions.ActOnUnaryExprOrTypeTraitExpr(OpTok.getLocation(), ExprKind, true, CastTy.getAsOpaquePtr(), CastRange);
    }
    if OpTok.isOneOf(kw_alignof, kw__Alignof) {
        self.Diag(OpTok, ext_alignof_expr) << OpTok.getIdentifierInfo();
    }
    if !Operand.isInvalid() {
        Operand = self.Actions.ActOnUnaryExprOrTypeTraitExpr(OpTok.getLocation(), ExprKind, false, Operand.get(), CastRange);
    }
    return Operand;
}

fn Parser::ParseBuiltinPrimaryExpression(self) -> ExprResult {
    let mut Res: ExprResult = false;
    let mut BuiltinII: *IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut T: TokenKind = self.Tok.getKind();
    let mut StartLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.isNot(l_paren) {
        return ExprError(self.Diag(self.Tok, err_expected_after) << BuiltinII << l_paren);
    }
    let mut PT: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    PT.consumeOpen();
    match T {
        _ => {
            llvm_unreachable_internal("Not a builtin primary expression!", "P:/Goraw/llvm-project/clang/lib/Parse/ParseExpr.cpp", 2369);
        },
        kw___builtin_va_arg => {
            let mut Expr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
            if self.ExpectAndConsume(comma, err_expected, "") {
                self.SkipUntil(r_paren, StopAtSemi);
                Expr = ExprError();
            }
            let mut Ty: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
            if self.Tok.isNot(r_paren) {
                self.Diag(self.Tok, err_expected) << r_paren;
                Expr = ExprError();
            }
            if Expr.isInvalid() || Ty.isInvalid() {
                Res = ExprError();
            } else {
                Res = self.Actions.ActOnVAArg(StartLoc, Expr.get(), Ty.get(), self.ConsumeParen());
            }
            break;
        },
        kw___builtin_offsetof => {
            let mut TypeLoc: SourceLocation = self.Tok.getLocation();
            let mut OOK: OffsetOfKind = Builtin;
            if self.Tok.getLocation().isMacroID() {
                let mut MacroName: str = getImmediateMacroNameForDiagnostics(self.Tok.getLocation(), self.PP.getSourceManager(), self.getLangOpts());
                if MacroName == "offsetof" {
                    OOK = Macro;
                }
            }
            let mut Ty: TypeResult = false;
            {
                let mut InOffsetof: OffsetOfStateRAIIObject = OffsetOfStateRAIIObject { OffsetOfState: *self, OldValue: OOK };
                Ty = self.ParseTypeName(null, TypeName, AS_none, null, null);
                if Ty.isInvalid() {
                    self.SkipUntil(r_paren, StopAtSemi);
                    return ExprError();
                }
            }
            if self.ExpectAndConsume(comma, err_expected, "") {
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            let mut TriggerCompletion: Closure_4 = Closure_4 { cap_0: self, Ty: &mut Ty };
            let mut D: Designation = Designation {};
            if self.Tok.is(code_completion) {
                TriggerCompletion.call(D);
                return ExprError();
            }
            if self.Tok.isNot(identifier) {
                self.Diag(self.Tok, err_expected) << identifier;
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            D.AddDesignator(CreateFieldDesignator(self.Tok.getIdentifierInfo(), SourceLocation {}, self.Tok.getLocation()));
            self.ConsumeToken();
            while true {
                if self.Tok.is(period) {
                    let mut DotLoc: SourceLocation = self.ConsumeToken();
                    if self.Tok.is(code_completion) {
                        TriggerCompletion.call(D);
                        return ExprError();
                    }
                    if self.Tok.isNot(identifier) {
                        self.Diag(self.Tok, err_expected) << identifier;
                        self.SkipUntil(r_paren, StopAtSemi);
                        return ExprError();
                    }
                    D.AddDesignator(CreateFieldDesignator(self.Tok.getIdentifierInfo(), DotLoc, self.Tok.getLocation()));
                    self.ConsumeToken();
                } else if self.Tok.is(l_square) {
                    if self.CheckProhibitedCXX11Attribute() {
                        return ExprError();
                    }
                    let mut ST: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
                    ST.consumeOpen();
                    Res = self.ParseExpression(AllowNonTypes);
                    if Res.isInvalid() {
                        self.SkipUntil(r_paren, StopAtSemi);
                        return Res;
                    }
                    ST.consumeClose();
                    let mut ArrayD: Designator = CreateArrayDesignator(Res.get(), ST.getOpenLocation());
                    ArrayD.setRBracketLoc(ST.getCloseLocation());
                    D.AddDesignator(ArrayD);
                } else {
                    if self.Tok.is(code_completion) {
                        self.cutOffParsing();
                        return ExprError();
                    }
                    if self.Tok.isNot(r_paren) {
                        PT.consumeClose();
                        Res = ExprError();
                    } else if Ty.isInvalid() {
                        Res = ExprError();
                    } else {
                        PT.consumeClose();
                        Res = self.Actions.ActOnBuiltinOffsetOf(self.getCurScope(), StartLoc, TypeLoc, Ty.get(), D, PT.getCloseLocation());
                    }
                    break;
                }
            }
            break;
        },
        kw___builtin_choose_expr => {
            let mut Cond: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
            if Cond.isInvalid() {
                self.SkipUntil(r_paren, StopAtSemi);
                return Cond;
            }
            if self.ExpectAndConsume(comma, err_expected, "") {
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            let mut Expr1: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
            if Expr1.isInvalid() {
                self.SkipUntil(r_paren, StopAtSemi);
                return Expr1;
            }
            if self.ExpectAndConsume(comma, err_expected, "") {
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            let mut Expr2: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
            if Expr2.isInvalid() {
                self.SkipUntil(r_paren, StopAtSemi);
                return Expr2;
            }
            if self.Tok.isNot(r_paren) {
                self.Diag(self.Tok, err_expected) << r_paren;
                return ExprError();
            }
            Res = self.Actions.ActOnChooseExpr(StartLoc, Cond.get(), Expr1.get(), Expr2.get(), self.ConsumeParen());
            break;
        },
        kw___builtin_astype => {
            let mut Expr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
            if Expr.isInvalid() {
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            if self.ExpectAndConsume(comma, err_expected, "") {
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            let mut DestTy: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
            if DestTy.isInvalid() {
                return ExprError();
            }
            if self.Tok.isNot(r_paren) {
                self.Diag(self.Tok, err_expected) << r_paren;
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            Res = self.Actions.ActOnAsTypeExpr(Expr.get(), DestTy.get(), StartLoc, self.ConsumeParen());
            break;
        },
        kw___builtin_convertvector => {
            let mut Expr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
            if Expr.isInvalid() {
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            if self.ExpectAndConsume(comma, err_expected, "") {
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            let mut DestTy: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
            if DestTy.isInvalid() {
                return ExprError();
            }
            if self.Tok.isNot(r_paren) {
                self.Diag(self.Tok, err_expected) << r_paren;
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            Res = self.Actions.ActOnConvertVectorExpr(Expr.get(), DestTy.get(), StartLoc, self.ConsumeParen());
            break;
        },
        kw___builtin_COLUMN => {
            kw___builtin_FILE;
        },
    }
    if Res.isInvalid() {
        return ExprError();
    }
    return self.ParsePostfixExpressionSuffix(Res.get());
}

fn Parser::tryParseOpenMPArrayShapingCastPart(self) -> bool {
    assert!(self.Tok.is(l_square), "Expected open bracket");
    let mut ErrorFound: bool = true;
    let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
    while true {
        {
        if self.Tok.isNot(l_square) {
            break;
        }
        self.ConsumeBracket();
        while !self.SkipUntil(r_square, annot_pragma_openmp_end, StopAtSemi | StopBeforeMatch) {
            
        }
        if self.Tok.isNot(r_square) {
            break;
        }
        self.ConsumeBracket();
        if self.Tok.is(r_paren) {
            ErrorFound = false;
            break;
        }
    }
        if !(self.Tok.isNot(annot_pragma_openmp_end)) { break; }
    }
    TPA.Revert();
    return !ErrorFound;
}

fn Parser::ParseParenExpression(self, ExprType: *mut ParenParseOption, StopIfCastExpr: bool, ParenBehavior: ParenExprKind, CorrectionBehavior: TypoCorrectionTypeBehavior, CastTy: *mut ParsedType, RParenLoc: *mut SourceLocation) -> ExprResult {
    assert!(self.Tok.is(l_paren), "Not a paren expr!");
    let mut ColonProtection: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: false };
    let mut NotParsingGenericAssociationType: GenericAssociationTypeRAIIObject = GenericAssociationTypeRAIIObject { P: *self, OldVal: false };
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        return ExprError();
    }
    let mut OpenLoc: SourceLocation = T.getOpenLocation();
    self.PreferredType.enterParenExpr(self.Tok.getLocation(), OpenLoc);
    let mut Result: ExprResult = true;
    let mut isAmbiguousTypeId: bool = false;
    CastTy = null;
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteExpression(self.getCurScope(), self.PreferredType.get(self.Tok.getLocation()), ExprType >= CompoundLiteral, false);
        return ExprError();
    }
    let mut BridgeCast: bool = (self.getLangOpts().ObjC && self.Tok.isOneOf(kw___bridge, kw___bridge_transfer, kw___bridge_retained, kw___bridge_retain));
    if BridgeCast && !self.getLangOpts().ObjCAutoRefCount {
        if !self.TryConsumeToken(kw___bridge) {
            let mut BridgeCastName: str = self.Tok.getName();
            let mut BridgeKeywordLoc: SourceLocation = self.ConsumeToken();
            if !self.PP.getSourceManager().isInSystemHeader(BridgeKeywordLoc) {
                self.Diag(BridgeKeywordLoc, warn_arc_bridge_cast_nonarc) << BridgeCastName << CreateReplacement(BridgeKeywordLoc, "");
            }
        }
        BridgeCast = false;
    }
    if ExprType >= CompoundStmt && self.Tok.is(l_brace) {
        self.Diag(self.Tok, if OpenLoc.isMacroID() { ext_gnu_statement_expr_macro } else { ext_gnu_statement_expr });
        self.checkCompoundToken(OpenLoc, l_paren, StmtExprBegin);
        if !self.getCurScope().getFnParent() && !self.getCurScope().getBlockParent() {
            Result = ExprError(self.Diag(OpenLoc, err_stmtexpr_file_scope));
        } else {
            let mut CodeDC: *mut DeclContext = self.Actions.CurContext;
            while CodeDC.isRecord() || isa(CodeDC) {
                CodeDC = CodeDC.getParent();
                assert!(CodeDC && !CodeDC.isFileContext(), "statement expr not in code context");
            }
            let mut SavedContext: ContextRAII = ContextRAII { self.Actions, CodeDC, false };
            self.Actions.ActOnStartStmtExpr();
            let mut Stmt: StmtResult = self.ParseCompoundStatement(true);
            ExprType = CompoundStmt;
            if !Stmt.isInvalid() {
                Result = self.Actions.ActOnStmtExpr(self.getCurScope(), OpenLoc, Stmt.get(), self.Tok.getLocation());
            } else {
                self.Actions.ActOnStmtExprError();
            }
        }
    } else if ExprType >= CompoundLiteral && BridgeCast {
        let mut tokenKind: TokenKind = self.Tok.getKind();
        let mut BridgeKeywordLoc: SourceLocation = self.ConsumeToken();
        let mut Kind: ObjCBridgeCastKind = zeroed();
        if tokenKind == kw___bridge {
            Kind = OBC_Bridge;
        } else if tokenKind == kw___bridge_transfer {
            Kind = OBC_BridgeTransfer;
        } else if tokenKind == kw___bridge_retained {
            Kind = OBC_BridgeRetained;
        } else {
            assert!(tokenKind == kw___bridge_retain);
            Kind = OBC_BridgeRetained;
            if !self.PP.getSourceManager().isInSystemHeader(BridgeKeywordLoc) {
                self.Diag(BridgeKeywordLoc, err_arc_bridge_retain) << CreateReplacement(BridgeKeywordLoc, "__bridge_retained");
            }
        }
        let mut Ty: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
        T.consumeClose();
        ColonProtection.restore();
        RParenLoc = T.getCloseLocation();
        self.PreferredType.enterTypeCast(self.Tok.getLocation(), Ty.get().get());
        let mut SubExpr: ExprResult = self.ParseCastExpression(AnyCastExpr, false, AllowNonTypes, false, null);
        if Ty.isInvalid() || SubExpr.isInvalid() {
            return ExprError();
        }
        return self.Actions.ObjC().ActOnObjCBridgedCast(self.getCurScope(), OpenLoc, Kind, BridgeKeywordLoc, Ty.get(), RParenLoc, SubExpr.get());
    } else if ExprType >= CompoundLiteral && self.isTypeIdInParens(isAmbiguousTypeId) {
        if isAmbiguousTypeId && !StopIfCastExpr {
            let mut res: ExprResult = self.ParseCXXAmbiguousParenExpression(ExprType, CastTy, T, ColonProtection);
            RParenLoc = T.getCloseLocation();
            return res;
        }
        let mut DS: DeclSpec = self.AttrFactory;
        self.ParseSpecifierQualifierList(DS, AS_none, DSC_normal);
        let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
        self.ParseDeclarator(DeclaratorInfo);
        if !DeclaratorInfo.isInvalidType() && self.Tok.is(identifier) && !self.InMessageExpression && self.getLangOpts().ObjC && (self.NextToken().is(colon) || self.NextToken().is(r_square)) {
            let mut Ty: TypeResult = false;
            {
                let mut InMessage: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: false };
                Ty = self.Actions.ActOnTypeName(DeclaratorInfo);
            }
            Result = self.ParseObjCMessageExpressionBody(SourceLocation {}, SourceLocation {}, Ty.get(), null);
        } else {
            T.consumeClose();
            ColonProtection.restore();
            RParenLoc = T.getCloseLocation();
            if ParenBehavior == Unknown && self.Tok.is(l_brace) {
                ExprType = CompoundLiteral;
                let mut Ty: TypeResult = false;
                {
                    let mut InMessage: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: false };
                    Ty = self.Actions.ActOnTypeName(DeclaratorInfo);
                }
                return self.ParseCompoundLiteralExpression(Ty.get(), OpenLoc, RParenLoc);
            }
            if ParenBehavior == Unknown && self.Tok.is(l_paren) {
                if self.getLangOpts().OpenCL {
                    let mut Ty: TypeResult = false;
                    {
                        let mut InMessage: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: false };
                        Ty = self.Actions.ActOnTypeName(DeclaratorInfo);
                    }
                    if Ty.isInvalid() {
                        return ExprError();
                    }
                    let mut QT: QualType = Ty.get().get().getCanonicalType();
                    if operator(QT).isVectorType() {
                        Result = self.ParseCastExpression(AnyCastExpr, false, AllowTypes, true, null);
                        if !Result.isInvalid() {
                            Result = self.Actions.ActOnCastExpr(self.getCurScope(), OpenLoc, DeclaratorInfo, CastTy, RParenLoc, Result.get());
                        }
                        if !Result.isInvalid() {
                            Result = self.ParsePostfixExpressionSuffix(Result);
                        }
                        return Result;
                    }
                }
            }
            if ExprType == CastExpr {
                if DeclaratorInfo.isInvalidType() {
                    return ExprError();
                }
                if StopIfCastExpr {
                    let mut Ty: TypeResult = false;
                    {
                        let mut InMessage: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: false };
                        Ty = self.Actions.ActOnTypeName(DeclaratorInfo);
                    }
                    CastTy = Ty.get();
                    return ExprResult { false };
                }
                if self.Tok.is(identifier) && self.getLangOpts().ObjC && self.Tok.getIdentifierInfo() == self.Ident_super && self.getCurScope().isInObjcMethodScope() && self.GetLookAheadToken(1).isNot(period) {
                    self.Diag(self.Tok.getLocation(), err_illegal_super_cast) << SourceRange { B: OpenLoc, E: RParenLoc };
                    return ExprError();
                }
                self.PreferredType.enterTypeCast(self.Tok.getLocation(), CastTy.get());
                Result = self.ParseCastExpression(AnyCastExpr, false, AllowTypes, false, null);
                if !Result.isInvalid() {
                    Result = self.Actions.ActOnCastExpr(self.getCurScope(), OpenLoc, DeclaratorInfo, CastTy, RParenLoc, Result.get());
                }
                return Result;
            }
            self.Diag(self.Tok, err_expected_lbrace_in_compound_literal);
            return ExprError();
        }
    } else if ExprType >= FoldExpr && self.Tok.is(ellipsis) && self.isFoldOperator(self.NextToken().getKind()) {
        ExprType = FoldExpr;
        return self.ParseFoldExpression(ExprResult { false }, T);
    } else if CorrectionBehavior == AllowTypes {
        let mut InMessage: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: false };
        let mut ArgExprs: ExprVector = ExprVector {};
        if !self.ParseSimpleExpressionList(ArgExprs) {
            if ExprType >= FoldExpr && ArgExprs.len == 1 && self.isFoldOperator(self.Tok.getKind()) && self.NextToken().is(ellipsis) {
                ExprType = FoldExpr;
                return self.ParseFoldExpression(ArgExprs[0], T);
            }
            ExprType = SimpleExpr;
            Result = self.Actions.ActOnParenListExpr(OpenLoc, self.Tok.getLocation(), ArgExprs);
        }
    } else if self.getLangOpts().OpenMP >= 50 && self.OpenMPDirectiveParsing && ExprType == CastExpr && self.Tok.is(l_square) && self.tryParseOpenMPArrayShapingCastPart() {
        let mut ErrorFound: bool = false;
        let mut OMPDimensions: SmallVector<Expr *, 4> = SmallVector<Expr *, 4> {};
        let mut OMPBracketsRanges: SmallVector<SourceRange, 4> = SmallVector<SourceRange, 4> {};
        while true {
            {
            let mut TS: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
            TS.consumeOpen();
            let mut NumElements: ExprResult = self.ParseExpression(AllowNonTypes);
            if !NumElements.isUsable() {
                ErrorFound = true;
                while !self.SkipUntil(r_square, r_paren, StopAtSemi | StopBeforeMatch) {
                    
                }
            }
            TS.consumeClose();
            OMPDimensions.push(NumElements.get());
            OMPBracketsRanges.push(TS.getRange());
        }
            if !(self.Tok.isNot(r_paren)) { break; }
        }
        T.consumeClose();
        RParenLoc = T.getCloseLocation();
        Result = self.ParseAssignmentExpression(AllowNonTypes);
        if ErrorFound {
            Result = ExprError();
        } else if !Result.isInvalid() {
            Result = self.Actions.OpenMP().ActOnOMPArrayShapingExpr(Result.get(), OpenLoc, RParenLoc, OMPDimensions, OMPBracketsRanges);
        }
        return Result;
    } else {
        let mut InMessage: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: false };
        Result = self.ParseExpression(AllowBoth);
        if ExprType >= FoldExpr && self.isFoldOperator(self.Tok.getKind()) && self.NextToken().is(ellipsis) {
            ExprType = FoldExpr;
            return self.ParseFoldExpression(Result, T);
        }
        ExprType = SimpleExpr;
        if !Result.isInvalid() && self.Tok.is(r_paren) {
            Result = self.Actions.ActOnParenExpr(OpenLoc, self.Tok.getLocation(), Result.get());
        }
    }
    if Result.isInvalid() {
        self.SkipUntil(r_paren, StopAtSemi);
        return ExprError();
    }
    T.consumeClose();
    RParenLoc = T.getCloseLocation();
    return Result;
}

fn Parser::ParseCompoundLiteralExpression(self, Ty: ParsedType, LParenLoc: SourceLocation, RParenLoc: SourceLocation) -> ExprResult {
    assert!(self.Tok.is(l_brace), "Not a compound literal!");
    if !self.getLangOpts().C99 {
        self.Diag(LParenLoc, ext_c99_compound_literal);
    }
    self.PreferredType.enterTypeCast(self.Tok.getLocation(), Ty.get());
    let mut Result: ExprResult = self.ParseInitializer(null);
    if !Result.isInvalid() && Ty {
        return self.Actions.ActOnCompoundLiteral(LParenLoc, Ty, RParenLoc, Result.get());
    }
    return Result;
}

fn Parser::ParseStringLiteralExpression(self, AllowUserDefinedLiteral: bool) -> ExprResult {
    return self.ParseStringLiteralExpression(AllowUserDefinedLiteral, false);
}

fn Parser::ParseUnevaluatedStringLiteralExpression(self) -> ExprResult {
    return self.ParseStringLiteralExpression(false, true);
}

fn Parser::ParseStringLiteralExpression(self, AllowUserDefinedLiteral: bool, Unevaluated: bool) -> ExprResult {
    assert!(tokenIsLikeStringLiteral(self.Tok, self.getLangOpts()), "Not a string-literal-like token!");
    let mut StringToks: SmallVector<Token, 4> = SmallVector<Token, 4> {};
    while true {
        {
        StringToks.push(self.Tok);
        self.ConsumeAnyToken(false);
    }
        if !(tokenIsLikeStringLiteral(self.Tok, self.getLangOpts())) { break; }
    }
    if Unevaluated {
        assert!(!AllowUserDefinedLiteral, "UDL are always evaluated");
        return self.Actions.ActOnUnevaluatedStringLiteral(StringToks);
    }
    return self.Actions.ActOnStringLiteral(StringToks, if AllowUserDefinedLiteral { self.getCurScope() } else { null });
}

fn Parser::ParseGenericSelectionExpression(self) -> ExprResult {
    assert!(self.Tok.is(kw__Generic), "_Generic keyword expected");
    self.diagnoseUseOfC11Keyword(self.Tok);
    let mut KeyLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected, "", unknown) {
        return ExprError();
    }
    let mut ControllingType: TypeResult = false;
    let mut ControllingExpr: ExprResult = false;
    if self.isTypeIdForGenericSelection() {
        ControllingType = self.ParseTypeName(null, TypeName, AS_none, null, null);
        if ControllingType.isInvalid() {
            self.SkipUntil(r_paren, StopAtSemi);
            return ExprError();
        }
        let mut LIT: *LocInfoType const = cast(ControllingType.get().get());
        let mut Loc: SourceLocation = LIT.getTypeSourceInfo().getTypeLoc().getBeginLoc();
        self.DiagCompat(Loc, generic_with_type_arg);
    } else {
        let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Other, true };
        ControllingExpr = self.ParseAssignmentExpression(AllowNonTypes);
        if ControllingExpr.isInvalid() {
            self.SkipUntil(r_paren, StopAtSemi);
            return ExprError();
        }
    }
    if self.ExpectAndConsume(comma, err_expected, "") {
        self.SkipUntil(r_paren, StopAtSemi);
        return ExprError();
    }
    let mut DefaultLoc: SourceLocation = SourceLocation {};
    let mut Types: SmallVector<ParsedType, 12> = SmallVector<ParsedType, 12> {};
    let mut Exprs: ExprVector = ExprVector {};
    while true {
        {
        let mut Ty: ParsedType = null;
        if self.Tok.is(kw_default) {
            if !DefaultLoc.isInvalid() {
                self.Diag(self.Tok, err_duplicate_default_assoc);
                self.Diag(DefaultLoc, note_previous_default_assoc);
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            DefaultLoc = self.ConsumeToken();
            Ty = null;
        } else {
            let mut X: GenericAssociationTypeRAIIObject = GenericAssociationTypeRAIIObject { P: *self, OldVal: true };
            let mut TR: TypeResult = self.ParseTypeName(null, Association, AS_none, null, null);
            if TR.isInvalid() {
                self.SkipUntil(r_paren, StopAtSemi);
                return ExprError();
            }
            Ty = TR.get();
        }
        Types.push(Ty);
        if self.ExpectAndConsume(colon, err_expected, "") {
            self.SkipUntil(r_paren, StopAtSemi);
            return ExprError();
        }
        let mut ER: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
        if ER.isInvalid() {
            self.SkipUntil(r_paren, StopAtSemi);
            return ExprError();
        }
        Exprs.push(ER.get());
    }
        if !(self.TryConsumeToken(comma)) { break; }
    }
    T.consumeClose();
    if T.getCloseLocation().isInvalid() {
        return ExprError();
    }
    let mut ExprOrTy: *mut void = if ControllingExpr.isUsable() { ControllingExpr.get() } else { ControllingType.get().getAsOpaquePtr() };
    return self.Actions.ActOnGenericSelectionExpr(KeyLoc, DefaultLoc, T.getCloseLocation(), ControllingExpr.isUsable(), ExprOrTy, Types, Exprs);
}

fn Parser::ParseFoldExpression(self, LHS: ExprResult, T: *mut BalancedDelimiterTracker) -> ExprResult {
    if LHS.isInvalid() {
        T.skipToEnd();
        return true;
    }
    let mut Kind: TokenKind = unknown;
    let mut FirstOpLoc: SourceLocation = SourceLocation {};
    if LHS.isUsable() {
        Kind = self.Tok.getKind();
        assert!(self.isFoldOperator(Kind), "missing fold-operator");
        FirstOpLoc = self.ConsumeToken();
    }
    assert!(self.Tok.is(ellipsis), "not a fold-expression");
    let mut EllipsisLoc: SourceLocation = self.ConsumeToken();
    let mut RHS: ExprResult = false;
    if self.Tok.isNot(r_paren) {
        if !self.isFoldOperator(self.Tok.getKind()) {
            return self.Diag(self.Tok.getLocation(), err_expected_fold_operator);
        }
        if Kind != unknown && self.Tok.getKind() != Kind {
            self.Diag(self.Tok.getLocation(), err_fold_operator_mismatch) << FirstOpLoc;
        }
        Kind = self.Tok.getKind();
        self.ConsumeToken();
        RHS = self.ParseExpression(AllowNonTypes);
        if RHS.isInvalid() {
            T.skipToEnd();
            return true;
        }
    }
    self.DiagCompat(EllipsisLoc, fold_expression);
    T.consumeClose();
    return self.Actions.ActOnCXXFoldExpr(self.getCurScope(), T.getOpenLocation(), LHS.get(), Kind, EllipsisLoc, RHS.get(), T.getCloseLocation());
}

fn Parser::injectEmbedTokens(self) {
    let mut Data: *mut EmbedAnnotationData = self.Tok.getAnnotationValue() as *mut EmbedAnnotationData;
    let mut Toks: MutableArrayRef<Token> = MutableArrayRef<Token> { self.PP.getPreprocessorAllocator().Allocate(Data.BinaryData.len * 2 - 1), Data.BinaryData.len * 2 - 1 };
    let mut I: u32 = 0;
    for Byte in Data.BinaryData {
        Toks[I].startToken();
        Toks[I].setKind(binary_data);
        Toks[I].setLocation(self.Tok.getLocation());
        Toks[I].setLength(1);
        Toks[I].setLiteralData(&mut Byte);
        if I != ((Data.BinaryData.len - 1) * 2) {
            Toks[I + 1].startToken();
            Toks[I + 1].setKind(comma);
            Toks[I + 1].setLocation(self.Tok.getLocation());
        }
        I += 2;
    }
    self.PP.EnterTokenStream(move(Toks), true, true);
    self.ConsumeAnyToken(true);
}

fn Parser::ParseExpressionList(self, Exprs: *mut SmallVectorImpl<Expr *>, ExpressionStarts: function_ref<void ()>, FailImmediatelyOnInvalidExpr: bool, ParsingExpansionStmtInitList: bool) -> bool {
    let mut SawError: bool = false;
    while true {
        if ExpressionStarts {
            ExpressionStarts.call();
        }
        let mut Expr: ExprResult = false;
        if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
            self.Diag(self.Tok, compat_cxx11_generalized_initializer_lists);
            Expr = self.ParseBraceInitializer();
        } else {
            Expr = self.ParseAssignmentExpression(AllowNonTypes);
        }
        if self.Tok.is(ellipsis) {
            Expr = self.Actions.ActOnPackExpansion(Expr.get(), self.ConsumeToken());
        } else if self.Tok.is(code_completion) {
            SawError = true;
            self.cutOffParsing();
            break;
        }
        if Expr.isInvalid() {
            SawError = true;
            if FailImmediatelyOnInvalidExpr {
                break;
            }
            self.SkipUntil(comma, if ParsingExpansionStmtInitList { r_brace } else { r_paren }, StopAtSemi | StopBeforeMatch);
        } else {
            Exprs.push(Expr.get());
        }
        if self.Tok.isNot(comma) {
            break;
        }
        let mut Comma: Token = self.Tok;
        self.ConsumeToken();
        if ParsingExpansionStmtInitList && self.Tok.is(r_brace) {
            break;
        }
        self.checkPotentialAngleBracketDelimiter(Comma);
    }
    return SawError;
}

fn Parser::ParseSimpleExpressionList(self, Exprs: *mut SmallVectorImpl<Expr *>) -> bool {
    while true {
        let mut Expr: ExprResult = self.ParseAssignmentExpression(AllowNonTypes);
        if Expr.isInvalid() {
            return true;
        }
        Exprs.push(Expr.get());
        if self.Tok.isNot(comma) || self.NextToken().is(ellipsis) {
            return false;
        }
        let mut Comma: Token = self.Tok;
        self.ConsumeToken();
        self.checkPotentialAngleBracketDelimiter(Comma);
    }
}

fn Parser::ParseBlockId(self, CaretLoc: SourceLocation) {
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteOrdinaryName(self.getCurScope(), PCC_Type);
        return;
    }
    let mut DS: DeclSpec = self.AttrFactory;
    self.ParseSpecifierQualifierList(DS, AS_none, DSC_normal);
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), BlockLiteral };
    DeclaratorInfo.setFunctionDefinitionKind(Definition);
    self.ParseDeclarator(DeclaratorInfo);
    self.MaybeParseGNUAttributes(DeclaratorInfo, null);
    self.Actions.ActOnBlockArguments(CaretLoc, DeclaratorInfo, self.getCurScope());
}

fn Parser::ParseBlockLiteralExpression(self) -> ExprResult {
    assert!(self.Tok.is(caret), "block literal starts with ^");
    let mut CaretLoc: SourceLocation = self.ConsumeToken();
    let mut CrashInfo: PrettyStackTraceLoc = PrettyStackTraceLoc { self.PP.getSourceManager(), CaretLoc, "block literal parsing" };
    let mut BlockScope: ParseScope = ParseScope { self, BlockScope | FnScope | CompoundStmtScope | DeclScope, true, false };
    self.Actions.ActOnBlockStart(CaretLoc, self.getCurScope());
    let mut DS: DeclSpec = self.AttrFactory;
    let mut ParamInfo: Declarator = Declarator { DS, none(), BlockLiteral };
    ParamInfo.setFunctionDefinitionKind(Definition);
    ParamInfo.SetSourceRange(SourceRange { B: self.Tok.getLocation(), E: self.Tok.getLocation() });
    if self.Tok.is(l_paren) {
        self.ParseParenDeclarator(ParamInfo);
        let mut Tmp: SourceLocation = ParamInfo.getSourceRange().getEnd();
        ParamInfo.SetIdentifier(null, CaretLoc);
        ParamInfo.SetRangeEnd(Tmp);
        if ParamInfo.isInvalidType() {
            self.Actions.ActOnBlockError(CaretLoc, self.getCurScope());
            return ExprError();
        }
        self.MaybeParseGNUAttributes(ParamInfo, null);
        self.Actions.ActOnBlockArguments(CaretLoc, ParamInfo, self.getCurScope());
    } else if !self.Tok.is(l_brace) {
        self.ParseBlockId(CaretLoc);
    } else {
        let mut NoLoc: SourceLocation = SourceLocation {};
        ParamInfo.AddTypeInfo(getFunction(true, false, NoLoc, null, 0, NoLoc, NoLoc, true, NoLoc, NoLoc, EST_None, SourceRange {}, null, null, 0, null, null, ArrayRef<NamedDecl *> {}, CaretLoc, CaretLoc, ParamInfo, TypeResult { false }, SourceLocation {}, null), CaretLoc);
        self.MaybeParseGNUAttributes(ParamInfo, null);
        self.Actions.ActOnBlockArguments(CaretLoc, ParamInfo, self.getCurScope());
    }
    let mut Result: ExprResult = true;
    if !self.Tok.is(l_brace) {
        self.Diag(self.Tok, err_expected_expression);
        self.Actions.ActOnBlockError(CaretLoc, self.getCurScope());
        return ExprError();
    }
    let mut PotentiallyEvaluated: EnterExpressionEvaluationContextForFunction = EnterExpressionEvaluationContextForFunction { self.Actions, PotentiallyEvaluated, null };
    let mut Stmt: StmtResult = self.ParseCompoundStatementBody(false);
    BlockScope.Exit();
    if !Stmt.isInvalid() {
        Result = self.Actions.ActOnBlockStmtExpr(CaretLoc, Stmt.get(), self.getCurScope());
    } else {
        self.Actions.ActOnBlockError(CaretLoc, self.getCurScope());
    }
    return Result;
}

fn Parser::ParseObjCBoolLiteral(self) -> ExprResult {
    let mut Kind: TokenKind = self.Tok.getKind();
    return self.Actions.ObjC().ActOnObjCBoolLiteral(self.ConsumeToken(), Kind);
}

fn CheckAvailabilitySpecList(P: *mut Parser, AvailSpecs: ArrayRef<AvailabilitySpec>) -> bool {
    let mut Platforms: SmallSet<StringRef, 4> = SmallSet<StringRef, 4> {};
    let mut HasOtherPlatformSpec: bool = false;
    let mut Valid: bool = true;
    for Spec in AvailSpecs {
        if Spec.isOtherPlatformSpec() {
            if HasOtherPlatformSpec {
                P.Diag(Spec.getBeginLoc(), err_availability_query_repeated_star);
                Valid = false;
            }
            HasOtherPlatformSpec = true;
            continue;
        }
        let mut Inserted: bool = Platforms.insert(Spec.getPlatform()).second;
        if !Inserted {
            let mut Platform: str = Spec.getPlatform();
            P.Diag(Spec.getBeginLoc(), err_availability_query_repeated_platform) << Spec.getEndLoc() << Platform;
            Valid = false;
        }
    }
    if !HasOtherPlatformSpec {
        let mut InsertWildcardLoc: SourceLocation = AvailSpecs.back().getEndLoc();
        P.Diag(InsertWildcardLoc, err_availability_query_wildcard_required) << CreateInsertion(InsertWildcardLoc, ", *", false);
        return true;
    }
    return !Valid;
}

fn Parser::ParseAvailabilitySpec(self) -> optional<AvailabilitySpec> {
    if self.Tok.is(star) {
        return self.ConsumeToken();
    } else {
        if self.Tok.is(code_completion) {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteAvailabilityPlatformName();
            return nullopt;
        }
        if self.Tok.isNot(identifier) {
            self.Diag(self.Tok, err_avail_query_expected_platform_name);
            return nullopt;
        }
        let mut PlatformIdentifier: *mut IdentifierLoc = self.ParseIdentifierLoc();
        let mut VersionRange: SourceRange = SourceRange {};
        let mut Version: VersionTuple = self.ParseVersionTuple(VersionRange);
        if Version.is_empty() {
            return nullopt;
        }
        let mut GivenPlatform: str = PlatformIdentifier.getIdentifierInfo().getName();
        let mut Platform: str = canonicalizePlatformName(GivenPlatform);
        if getPrettyPlatformName(Platform).is_empty() || (GivenPlatform.contains("xros") || GivenPlatform.contains("xrOS")) {
            self.Diag(PlatformIdentifier.getLoc(), err_avail_query_unrecognized_platform_name) << GivenPlatform;
            return nullopt;
        }
        if Platform == "anyappleos" && !validateAnyAppleOSVersion(Version) {
            self.Diag(VersionRange.getBegin(), err_avail_query_anyappleos_min_version) << Version.getAsString();
            return nullopt;
        }
        return AvailabilitySpec { Version: Version, Platform: Platform, BeginLoc: PlatformIdentifier.getLoc(), EndLoc: VersionRange.getEnd() };
    }
}

fn Parser::ParseAvailabilityCheckExpr(self, BeginLoc: SourceLocation) -> ExprResult {
    assert!(self.Tok.is(kw___builtin_available) || self.Tok.isObjCAtKeyword(objc_available);
    self.ConsumeToken();
    let mut Parens: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if Parens.expectAndConsume(err_expected, "", unknown) {
        return ExprError();
    }
    let mut AvailSpecs: SmallVector<AvailabilitySpec, 4> = SmallVector<AvailabilitySpec, 4> {};
    let mut HasError: bool = false;
    while true {
        let mut Spec: optional<AvailabilitySpec> = self.ParseAvailabilitySpec();
        if !Spec {
            HasError = true;
        } else {
            AvailSpecs.push(operator(Spec));
        }
        if !self.TryConsumeToken(comma) {
            break;
        }
    }
    if HasError {
        self.SkipUntil(r_paren, StopAtSemi);
        return ExprError();
    }
    CheckAvailabilitySpecList(*self, AvailSpecs);
    if Parens.consumeClose() {
        return ExprError();
    }
    return self.Actions.ObjC().ActOnObjCAvailabilityCheckExpr(AvailSpecs, BeginLoc, Parens.getCloseLocation());
}

struct Closure_2 {
    cap_0: *mut Parser,
}

fn Closure_2::call(self: *Closure_2, E: ExprResult, Note: bool) -> ExprResult {
            E = self.ParsePostfixExpressionSuffix(E);
            E = self.ParseRHSOfBinaryExpression(E, InclusiveOr);
            if !E.isInvalid() {
                self.Diag(E.get().getExprLoc(), if Note { note_unparenthesized_non_primary_expr_in_requires_clause } else { err_unparenthesized_non_primary_expr_in_requires_clause }) << CreateInsertion(E.get().getBeginLoc(), "(", false) << CreateInsertion(self.PP.getLocForEndOfToken(E.get().getEndLoc(), 0), ")", false) << E.get().getSourceRange();
            }
            return E;
        }

struct Closure_1 {
    cap_0: *mut Parser,
    NotPrimaryExpression: *mut bool,
    IsTrailingRequiresClause: *mut bool,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> ExprResult {
        let mut E: ExprResult = self.ParseCastExpression(PrimaryExprOnly, false, AllowNonTypes, false, &mut (*self.NotPrimaryExpression));
        if E.isInvalid() {
            return ExprError();
        }
        let mut RecoverFromNonPrimary: Closure_2 = Closure_2 { cap_0: self };
        if (*self.NotPrimaryExpression) || getBinOpPrecedence(self.Tok.getKind(), self.GreaterThanIsOperator, true) > LogicalAnd || self.Tok.isOneOf(period, plusplus, minusminus) || (self.Tok.is(l_square) && !self.NextToken().is(l_square)) {
            E = RecoverFromNonPrimary.call(E, false);
            if E.isInvalid() {
                return ExprError();
            }
            (*self.NotPrimaryExpression) = false;
        }
        let mut PossibleNonPrimary: bool = false;
        let mut IsConstraintExpr: bool = self.Actions.CheckConstraintExpression(E.get(), self.Tok, &mut PossibleNonPrimary, (*self.IsTrailingRequiresClause));
        if !IsConstraintExpr || PossibleNonPrimary {
            if PossibleNonPrimary {
                E = RecoverFromNonPrimary.call(E, !IsConstraintExpr);
            }
            return ExprError();
        }
        return E;
    }

struct Closure_3 {
    Operand: *mut ExprResult,
    cap_1: *mut Parser,
}

unsafe fn Closure_3::call(self: *mut Closure_3) -> auto {
                (*self.Operand) = self.ParseCastExpression(UnaryExprOnly, false, AllowNonTypes, false, null);
            }

struct Closure_4 {
    cap_0: *mut Parser,
    Ty: *mut TypeResult,
}

unsafe fn Closure_4::call(self: *mut Closure_4, D: *Designation) {
                self.cutOffParsing();
                self.Actions.CodeCompletion().CodeCompleteOffsetOfDesignator(self.Actions.GetTypeFromParser((*self.Ty).get(), null), D);
            }
