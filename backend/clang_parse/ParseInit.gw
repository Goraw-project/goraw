fn Parser::MayBeDesignationStart(self) -> bool {
    match self.Tok.getKind() {
        _ => {
            return false;
        },
        period => {
            return true;
        },
        l_square => {
            if !self.PP.getLangOpts().CPlusPlus {
                return true;
            }
            match self.PP.LookAhead(0).getKind() {
                equal => {
                    ellipsis;
                },
                amp => {
                    kw_this;
                },
                _ => {
                    return true;
                },
            }
            break;
        },
        identifier => {
            return self.PP.LookAhead(0).is(colon);
        },
    }
    let mut Tentative: RevertingTentativeParsingAction = RevertingTentativeParsingAction { *self, false };
    let mut Intro: LambdaIntroducer = LambdaIntroducer {};
    let mut ParseResult: LambdaIntroducerTentativeParse = zeroed();
    if self.ParseLambdaIntroducer(Intro, &mut ParseResult) {
        return true;
    }
    match ParseResult {
        Success => {
            Incomplete;
        },
        MessageSend => {
            Invalid;
        },
    }
    return self.Tok.is(equal);
}

fn CheckArrayDesignatorSyntax(P: *mut Parser, Loc: SourceLocation, Desig: *mut Designation) {
    if Desig.getNumDesignators() == 1 && (Desig.getDesignator(0).isArrayDesignator() || Desig.getDesignator(0).isArrayRangeDesignator()) {
        P.Diag(Loc, ext_gnu_missing_equal_designator);
    } else if Desig.getNumDesignators() > 0 {
        P.Diag(Loc, err_expected_equal_designator);
    }
}

fn Parser::ParseInitializerWithPotentialDesignator(self, DesignatorCompletion: DesignatorCompletionInfo) -> ExprResult {
    if self.Tok.is(identifier) {
        let mut FieldName: *IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut NewSyntax: str = "";
        NewSyntax << '.' << FieldName.getName() << " = ";
        let mut NameLoc: SourceLocation = self.ConsumeToken();
        assert!(self.Tok.is(colon), "MayBeDesignationStart not working properly!");
        let mut ColonLoc: SourceLocation = self.ConsumeToken();
        self.Diag(NameLoc, ext_gnu_old_style_field_designator) << CreateReplacement(SourceRange { B: NameLoc, E: ColonLoc }, NewSyntax.operator StringRef());
        let mut D: Designation = Designation {};
        D.AddDesignator(CreateFieldDesignator(FieldName, SourceLocation {}, NameLoc));
        self.PreferredType.enterDesignatedInitializer(self.Tok.getLocation(), DesignatorCompletion.PreferredBaseType, D);
        return self.Actions.ActOnDesignatedInitializer(D, ColonLoc, true, self.ParseInitializer(null));
    }
    let mut Desig: Designation = Designation {};
    while self.Tok.is(period) || self.Tok.is(l_square) {
        if self.Tok.is(period) {
            let mut DotLoc: SourceLocation = self.ConsumeToken();
            if self.Tok.is(code_completion) {
                self.cutOffParsing();
                self.Actions.CodeCompletion().CodeCompleteDesignator(DesignatorCompletion.PreferredBaseType, DesignatorCompletion.InitExprs, Desig);
                return ExprError();
            }
            if self.Tok.isNot(identifier) {
                self.Diag(self.Tok.getLocation(), err_expected_field_designator);
                return ExprError();
            }
            Desig.AddDesignator(CreateFieldDesignator(self.Tok.getIdentifierInfo(), DotLoc, self.Tok.getLocation()));
            self.ConsumeToken();
            continue;
        }
        assert!(self.Tok.is(l_square), "Unexpected token!");
        let mut InMessage: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: true };
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
        T.consumeOpen();
        let mut StartLoc: SourceLocation = T.getOpenLocation();
        let mut Idx: ExprResult = false;
        if self.getLangOpts().ObjC && self.getLangOpts().CPlusPlus {
            if self.Tok.is(identifier) && self.Tok.getIdentifierInfo() == self.Ident_super && self.NextToken().isNot(period) && self.getCurScope().isInObjcMethodScope() {
                CheckArrayDesignatorSyntax(*self, StartLoc, Desig);
                return self.ParseAssignmentExprWithObjCMessageExprStart(StartLoc, self.ConsumeToken(), null, null);
            }
            let mut IsExpr: bool = false;
            let mut TypeOrExpr: *mut void = null;
            if self.ParseObjCXXMessageReceiver(IsExpr, TypeOrExpr) {
                self.SkipUntil(r_square, StopAtSemi);
                return ExprError();
            }
            if !IsExpr {
                CheckArrayDesignatorSyntax(*self, StartLoc, Desig);
                return self.ParseAssignmentExprWithObjCMessageExprStart(StartLoc, SourceLocation {}, getFromOpaquePtr(TypeOrExpr), null);
            }
            Idx = TypeOrExpr as *mut Expr;
        } else if self.getLangOpts().ObjC && self.Tok.is(identifier) {
            let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            let mut IILoc: SourceLocation = self.Tok.getLocation();
            let mut ReceiverType: ParsedType = null;
            match self.Actions.ObjC().getObjCMessageKind(self.getCurScope(), II, IILoc, II == self.Ident_super, self.NextToken().is(period), ReceiverType) {
                ObjCSuperMessage => {
                    CheckArrayDesignatorSyntax(*self, StartLoc, Desig);
                },
                ObjCClassMessage => {
                    CheckArrayDesignatorSyntax(*self, StartLoc, Desig);
                },
                ObjCInstanceMessage => {
                    break;
                },
            }
        }
        if !Idx.get() {
            Idx = self.ParseAssignmentExpression(AllowNonTypes);
            if Idx.isInvalid() {
                self.SkipUntil(r_square, StopAtSemi);
                return Idx;
            }
        }
        if self.getLangOpts().ObjC && self.Tok.isNot(ellipsis) && self.Tok.isNot(r_square) {
            CheckArrayDesignatorSyntax(*self, self.Tok.getLocation(), Desig);
            return self.ParseAssignmentExprWithObjCMessageExprStart(StartLoc, SourceLocation {}, null, Idx.get());
        }
        if self.Tok.isNot(ellipsis) {
            Desig.AddDesignator(CreateArrayDesignator(Idx.get(), StartLoc));
        } else {
            self.Diag(self.Tok, ext_gnu_array_range);
            let mut EllipsisLoc: SourceLocation = self.ConsumeToken();
            let mut RHS: ExprResult = self.ParseConstantExpression();
            if RHS.isInvalid() {
                self.SkipUntil(r_square, StopAtSemi);
                return RHS;
            }
            Desig.AddDesignator(CreateArrayRangeDesignator(Idx.get(), RHS.get(), StartLoc, EllipsisLoc));
        }
        T.consumeClose();
        Desig.getDesignator(Desig.getNumDesignators() - 1).setRBracketLoc(T.getCloseLocation());
    }
    assert!(!Desig.is_empty(), "Designator is empty?");
    if self.Tok.is(equal) {
        let mut EqualLoc: SourceLocation = self.ConsumeToken();
        self.PreferredType.enterDesignatedInitializer(self.Tok.getLocation(), DesignatorCompletion.PreferredBaseType, Desig);
        return self.Actions.ActOnDesignatedInitializer(Desig, EqualLoc, false, self.ParseInitializer(null));
    }
    if self.Tok.is(l_brace) && self.getLangOpts().CPlusPlus11 {
        self.PreferredType.enterDesignatedInitializer(self.Tok.getLocation(), DesignatorCompletion.PreferredBaseType, Desig);
        return self.Actions.ActOnDesignatedInitializer(Desig, SourceLocation {}, false, self.ParseBraceInitializer());
    }
    if Desig.getNumDesignators() == 1 && (Desig.getDesignator(0).isArrayDesignator() || Desig.getDesignator(0).isArrayRangeDesignator()) {
        self.Diag(self.Tok, ext_gnu_missing_equal_designator) << CreateInsertion(self.Tok.getLocation(), "= ", false);
        return self.Actions.ActOnDesignatedInitializer(Desig, self.Tok.getLocation(), true, self.ParseInitializer(null));
    }
    self.Diag(self.Tok, err_expected_equal_designator);
    return ExprError();
}

fn Parser::createEmbedExpr(self) -> ExprResult {
    assert!(self.Tok.getKind() == annot_embed);
    let mut Data: *mut EmbedAnnotationData = self.Tok.getAnnotationValue() as *mut EmbedAnnotationData;
    let mut Res: ExprResult = false;
    let mut Context: *mut ASTContext = self.Actions.getASTContext();
    let mut StartLoc: SourceLocation = self.ConsumeAnnotationToken();
    if Data.BinaryData.len == 1 {
        Res = Create(Context, APInt { 8, Data.BinaryData.back() as u8, false, false }, Context.UnsignedCharTy.operator QualType(), StartLoc);
    } else {
        let mut CreateStringLiteralFromStringRef: Closure_1 = Closure_1 { Context: &mut Context, StartLoc: &mut StartLoc };
        let mut BinaryDataArg: *mut StringLiteral = CreateStringLiteralFromStringRef.call(Data.BinaryData, Context.UnsignedCharTy.operator QualType());
        Res = self.Actions.ActOnEmbedExpr(StartLoc, BinaryDataArg, Data.FileName);
    }
    return Res;
}

fn Parser::ParseBraceInitializer(self) -> ExprResult {
    let mut InMessage: InMessageExpressionRAIIObject = InMessageExpressionRAIIObject { InMessageExpression: *self, OldValue: false };
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    T.consumeOpen();
    let mut LBraceLoc: SourceLocation = T.getOpenLocation();
    let mut InitExprs: ExprVector = ExprVector {};
    if self.Tok.is(r_brace) {
        if !self.getLangOpts().CPlusPlus {
            self.Diag(LBraceLoc, if self.getLangOpts().C23 { warn_c23_compat_empty_initializer } else { ext_c_empty_initializer });
        }
        return self.Actions.ActOnInitList(LBraceLoc, MultiExprArg {}, self.ConsumeBrace());
    }
    let mut EnterContext: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, InitList, true };
    let mut InitExprsOk: bool = true;
    let mut LikelyType: QualType = self.PreferredType.get(T.getOpenLocation());
    let mut DesignatorCompletion: DesignatorCompletionInfo = DesignatorCompletionInfo { InitExprs, LikelyType };
    let mut CalledSignatureHelp: bool = false;
    let mut RunSignatureHelp: Closure_2 = Closure_2 { LikelyType: &mut LikelyType, cap_1: self, T: &mut T, InitExprs: &mut InitExprs, CalledSignatureHelp: &mut CalledSignatureHelp };
    while true {
        self.PreferredType.enterFunctionArgument(self.Tok.getLocation(), function_ref<QualType ()> { RunSignatureHelp, null, null });
        if self.getLangOpts().MicrosoftExt && (self.Tok.is(kw___if_exists) || self.Tok.is(kw___if_not_exists)) {
            if self.ParseMicrosoftIfExistsBraceInitializer(InitExprs, InitExprsOk) {
                if self.Tok.isNot(comma) {
                    break;
                }
                self.ConsumeToken();
            }
            if self.Tok.is(r_brace) {
                break;
            }
            continue;
        }
        let mut SubElt: ExprResult = false;
        if self.MayBeDesignationStart() {
            SubElt = self.ParseInitializerWithPotentialDesignator(DesignatorCompletion);
        } else if self.Tok.getKind() == annot_embed {
            SubElt = self.createEmbedExpr();
        } else {
            SubElt = self.ParseInitializer(null);
        }
        if self.Tok.is(ellipsis) {
            SubElt = self.Actions.ActOnPackExpansion(SubElt.get(), self.ConsumeToken());
        }
        if SubElt.isUsable() {
            InitExprs.push(SubElt.get());
        } else {
            InitExprsOk = false;
            if self.Tok.isNot(comma) {
                self.SkipUntil(r_brace, StopBeforeMatch);
                break;
            }
        }
        if self.Tok.isNot(comma) {
            break;
        }
        self.ConsumeToken();
        if self.Tok.is(r_brace) {
            break;
        }
    }
    let mut closed: bool = !T.consumeClose();
    if InitExprsOk && closed {
        return self.Actions.ActOnInitList(LBraceLoc, InitExprs, T.getCloseLocation());
    }
    return ExprError();
}

fn Parser::ParseExpansionInitList(self) -> ExprResult {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    T.consumeOpen();
    let mut InitExprs: ExprVector = ExprVector {};
    if !self.Tok.is(r_brace) && self.ParseExpressionList(InitExprs, function_ref<void ()> {}, false, true) {
        T.consumeClose();
        return ExprError();
    }
    T.consumeClose();
    return self.Actions.ActOnCXXExpansionInitList(InitExprs, T.getOpenLocation(), T.getCloseLocation());
}

fn Parser::ParseMicrosoftIfExistsBraceInitializer(self, InitExprs: *mut ExprVector, InitExprsOk: *mut bool) -> bool {
    let mut trailingComma: bool = false;
    let mut Result: IfExistsCondition = IfExistsCondition {};
    if self.ParseMicrosoftIfExistsCondition(Result) {
        return false;
    }
    let mut Braces: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    if Braces.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_brace;
        return false;
    }
    match Result.Behavior {
        Parse => {
            break;
        },
        Dependent => {
            self.Diag(Result.KeywordLoc, warn_microsoft_dependent_exists) << Result.IsIfExists;
        },
        Skip => {
            Braces.skipToEnd();
        },
    }
    let mut DesignatorCompletion: DesignatorCompletionInfo = DesignatorCompletionInfo { InitExprs, self.PreferredType.get(Braces.getOpenLocation()) };
    while !self.isEofOrEom() {
        trailingComma = false;
        let mut SubElt: ExprResult = false;
        if self.MayBeDesignationStart() {
            SubElt = self.ParseInitializerWithPotentialDesignator(DesignatorCompletion);
        } else {
            SubElt = self.ParseInitializer(null);
        }
        if self.Tok.is(ellipsis) {
            SubElt = self.Actions.ActOnPackExpansion(SubElt.get(), self.ConsumeToken());
        }
        if !SubElt.isInvalid() {
            InitExprs.push(SubElt.get());
        } else {
            InitExprsOk = false;
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
            trailingComma = true;
        }
        if self.Tok.is(r_brace) {
            break;
        }
    }
    Braces.consumeClose();
    return !trailingComma;
}

fn Parser::ParseInitializer(self, DeclForInitializer: *mut Decl) -> ExprResult {
    if DeclForInitializer && !self.Actions.ExprEvalContexts.is_empty() {
        let mut VD: *mut VarDecl = dyn_cast(DeclForInitializer);
        if VD && VD.isFileVarDecl() && (!operator(VD.getType()).isReferenceType() || VD.isConstexpr()) {
            self.Actions.ExprEvalContexts.back().DeclForInitializer = VD;
        }
    }
    let mut init: ExprResult = false;
    if self.Tok.isNot(l_brace) {
        init = self.ParseAssignmentExpression(AllowNonTypes);
    } else {
        init = self.ParseBraceInitializer();
    }
    return init;
}

struct Closure_1 {
    Context: *mut ASTContext,
    StartLoc: *mut SourceLocation,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Str: str, Ty: QualType) -> *mut StringLiteral {
            let mut ArraySize: APSInt = (*self.Context).MakeIntValue(Str.len, (*self.Context).getSizeType());
            let mut ArrayTy: QualType = (*self.Context).getConstantArrayType(Ty, ArraySize, null, Normal, 0);
            return Create((*self.Context), Str, Binary, false, ArrayTy, (*self.StartLoc));
        }

struct Closure_2 {
    LikelyType: *mut QualType,
    cap_1: *mut Parser,
    T: *mut BalancedDelimiterTracker,
    InitExprs: *mut ExprVector,
    CalledSignatureHelp: *mut bool,
}

unsafe fn Closure_2::call(self: *mut Closure_2) -> auto {
        let mut PreferredType: QualType = QualType {};
        if !(*self.LikelyType).isNull() {
            PreferredType = self.Actions.CodeCompletion().ProduceConstructorSignatureHelp(operator((*self.LikelyType)).getCanonicalTypeInternal(), (*self.T).getOpenLocation(), (*self.InitExprs), (*self.T).getOpenLocation(), true);
        }
        (*self.CalledSignatureHelp) = true;
        return PreferredType;
    }
