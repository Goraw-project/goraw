fn Parser::SkipCXXMemberSpecification(self, RecordLoc: SourceLocation, AttrFixitLoc: SourceLocation, TagType: u32, TagDecl: *mut Decl) {
    while self.isClassCompatibleKeyword() {
        self.ConsumeToken();
    }
    let mut Attrs: ParsedAttributes = zeroed();
    self.CheckMisplacedCXX11Attribute(Attrs, AttrFixitLoc);
    if self.Tok.isNot(colon) && self.Tok.isNot(l_brace) {
        return;
    }
    if self.Tok.is(colon) {
        let mut ClassScope: ParseScope = ParseScope { self, ClassScope | DeclScope, true, false };
        let mut ParsingDef: ParsingClassDefinition = ParsingClassDefinition { *self, TagDecl, true, TagType == TST_interface };
        let mut OldContext: SkippedDefinitionContext = self.Actions.ActOnTagStartSkippedDefinition(self.getCurScope(), TagDecl);
        self.ParseBaseClause(null);
        self.Actions.ActOnTagFinishSkippedDefinition(OldContext);
        if !self.Tok.is(l_brace) {
            return;
        }
    }
    assert!(self.Tok.is(l_brace);
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    T.consumeOpen();
    T.skipToEnd();
    if self.Tok.is(kw___attribute) {
        let mut Attrs: ParsedAttributes = zeroed();
        self.MaybeParseGNUAttributes(Attrs, null);
    }
}

fn Parser::ParseCXXClassMemberDeclarationWithPragmas(self, AS: *mut AccessSpecifier, AccessAttrs: *mut ParsedAttributes, TagType: TST, TagDecl: *mut Decl) -> DeclGroupPtrTy {
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    match self.Tok.getKind() {
        kw___if_exists => {
            kw___if_not_exists;
        },
        semi => {
            self.ConsumeExtraSemi(InsideStruct, TagType);
        },
        annot_pragma_vis => {
            self.HandlePragmaVisibility();
        },
        annot_pragma_pack => {
            self.HandlePragmaPack();
        },
        annot_pragma_align => {
            self.HandlePragmaAlign();
        },
        annot_pragma_ms_pointers_to_members => {
            self.HandlePragmaMSPointersToMembers();
        },
        annot_pragma_ms_pragma => {
            self.HandlePragmaMSPragma();
        },
        annot_pragma_ms_vtordisp => {
            self.HandlePragmaMSVtorDisp();
        },
        annot_pragma_export => {
            self.HandlePragmaExport();
        },
        annot_pragma_dump => {
            self.HandlePragmaDump();
        },
        kw_namespace => {
            self.DiagnoseUnexpectedNamespace(cast(TagDecl));
        },
        kw_private => {
            if self.getLangOpts() && !self.NextToken().is(colon) {
                let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
            }
        },
        kw_public => {
            kw_protected;
        },
        annot_attr_openmp => {
            annot_pragma_openmp;
        },
        annot_pragma_openacc => {
            return self.ParseOpenACCDirectiveDecl;
        },
        _ => {
            if isPragmaAnnotation(self.Tok.getKind()) {
                 << getSpecifierName(TagType, self.Actions.getASTContext().getPrintingPolicy());
                self.ConsumeAnnotationToken();
                return null;
            }
        },
    }
}

fn Parser::ParseCXXMemberSpecification(self, RecordLoc: SourceLocation, AttrFixitLoc: SourceLocation, Attrs: *mut ParsedAttributes, TagType: u32, TagDecl: *mut Decl) {
    assert!((TagType == TST_struct || TagType == TST_interface || TagType == TST_union || TagType == TST_class), "Invalid TagType!");
    let mut TimeScope: TimeTraceScope = "ParseClass";
