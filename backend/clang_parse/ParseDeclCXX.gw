    let mut ShouldChangeAtomicToIdentifier: bool = self.getLangOpts().MSVCCompat && self.Tok.is(kw__Atomic) && TagType == TST_struct;
    let mut AtomicTokenGuard: PreserveAtomicIdentifierInfoRAII = PreserveAtomicIdentifierInfoRAII { self.Tok, ShouldChangeAtomicToIdentifier };
    let mut InvalidDeclScope: CXXScopeSpec = CXXScopeSpec {};
    let mut SS: *mut CXXScopeSpec = if DS.hasTypeSpecifier() { InvalidDeclScope } else { DS.getTypeSpecScope() };
    if self.getLangOpts().CPlusPlus {
        let mut X: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
        let mut Spec: CXXScopeSpec = CXXScopeSpec {};
