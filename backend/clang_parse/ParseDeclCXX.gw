        }
    }
    self.MaybeParseCXX11Attributes(Attributes, false);
    let mut Policy: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
    let mut TUK: TagUseKind = zeroed();
    if self.getLangOpts().CPlusPlus && DS.isFriendSpecifiedFirst() && self.Tok.isOneOf(comma, ellipsis) {
        TUK = Friend;
    } else if isDefiningTypeSpecifierContext(DSC, self.getLangOpts().CPlusPlus) == No || (self.getLangOpts().OpenMP && self.OpenMPDirectiveParsing) {
        TUK = Reference;
    } else if self.Tok.is(l_brace) || (DSC != DSC_association && self.getLangOpts().CPlusPlus && self.Tok.is(colon)) || (self.isClassCompatibleKeyword() && (self.NextToken().is(l_brace) || self.NextToken().is(colon) || self.isClassCompatibleKeyword(self.NextToken()))) {
