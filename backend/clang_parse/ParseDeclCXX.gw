                    FakedParamLists.push(self.Actions.ActOnTemplateParameterList(0, SourceLocation {}, TemplateInfo.TemplateLoc, LAngleLoc, ArrayRef<NamedDecl *> {}, LAngleLoc, null));
                    TemplateParams = &mut FakedParamLists;
                }
            }
            TagOrTempResult = self.Actions.ActOnClassTemplateSpecialization(self.getCurScope(), TagType, TUK, StartLoc, DS.getModulePrivateSpecLoc(), SS, *TemplateId, attrs, MultiTemplateParamsArg { if TemplateParams { &mut (*TemplateParams)[0] } else { null }, if TemplateParams { TemplateParams.len } else { 0 } }, &mut SkipBody);
        }
    } else if TemplateInfo.Kind == ExplicitInstantiation && TUK == Declaration {
        self.ProhibitAttributes(attrs, SourceLocation {});
        TagOrTempResult = self.Actions.ActOnExplicitInstantiation(self.getCurScope(), TemplateInfo.ExternLoc, TemplateInfo.TemplateLoc, TagType, StartLoc, SS, Name, NameLoc, attrs);
    } else if TUK == Friend && TemplateInfo.Kind != NonTemplate {
        self.ProhibitCXX11Attributes(attrs, err_attributes_not_allowed, err_keyword_not_allowed, true, false);
        let mut EllipsisLoc: SourceLocation = SourceLocation {};
        self.TryConsumeToken(ellipsis, EllipsisLoc);
        if self.Tok.is(comma) {
            self.Diag(self.Tok.getLocation(), err_friend_template_decl_multiple_specifiers);
            self.SkipUntil(semi, StopBeforeMatch);
        }
        if TemplateId {
            Name = null;
            NameLoc = TemplateId.TemplateNameLoc;
