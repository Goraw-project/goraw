                        AttrParsed = self.ParseCXX11AttributeArgs(II, NameLoc, Attrs, &mut EndLoc, null, SourceLocation {});
                        self.ReplayOpenMPAttributeTokens();
                    }
                    if !AttrParsed {
                        Attrs.addNew(II, NameLoc, AttributeScopeInfo {}, null, 0, Microsoft(), SourceLocation {});
                    }
                }
            }
        }
        T.consumeClose();
        EndLoc = T.getCloseLocation();
    }
        if !(self.Tok.is(l_square)) { break; }
    }
    Attrs() = SourceRange { B: StartLoc, E: EndLoc };
}

