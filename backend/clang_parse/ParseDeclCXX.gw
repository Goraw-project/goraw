        }
    }
    let mut TemplateParams: *mut TemplateParameterLists = TemplateInfo.TemplateParams;
    let mut RecoverFromUndeclaredTemplateName: Closure_1 = Closure_1 { cap_0: self, TemplateInfo: &mut TemplateInfo, TagTokKind: &mut TagTokKind, TemplateParams: &mut TemplateParams };
    let mut Name: *mut IdentifierInfo = null;
    let mut NameLoc: SourceLocation = SourceLocation {};
    let mut TemplateId: *mut TemplateIdAnnotation = null;
    if self.Tok.is(identifier) {
        Name = self.Tok.getIdentifierInfo();
        NameLoc = self.ConsumeToken();
        DS.SetRangeEnd(NameLoc);
        if self.Tok.is(less) && self.getLangOpts().CPlusPlus {
            let mut TemplateArgs: TemplateArgList = TemplateArgList {};
            let mut LAngleLoc: SourceLocation = SourceLocation {};
            let mut RAngleLoc: SourceLocation = SourceLocation {};
            if self.ParseTemplateIdAfterTemplateName(true, LAngleLoc, TemplateArgs, RAngleLoc, null) {
                LAngleLoc = RAngleLoc = SourceLocation {};
            }
            RecoverFromUndeclaredTemplateName.call(Name, NameLoc, SourceRange { B: LAngleLoc, E: RAngleLoc }, false);
        }
    } else if self.Tok.is(annot_template_id) {
        TemplateId = self.takeTemplateIdAnnotation(self.Tok);
        NameLoc = self.ConsumeAnnotationToken();
        if TemplateId.Kind == TNK_Undeclared_template {
            self.Actions.ActOnUndeclaredTypeTemplateName(self.getCurScope(), TemplateId.Template, TemplateId.Kind, NameLoc, Name);
            if TemplateId.Kind == TNK_Undeclared_template {
                RecoverFromUndeclaredTemplateName.call(Name, NameLoc, SourceRange { B: TemplateId.LAngleLoc, E: TemplateId.RAngleLoc }, true);
                TemplateId = null;
            }
        }
        if TemplateId && !TemplateId.mightBeType() {
            let mut Range: SourceRange = NameLoc;
            if SS.isNotEmpty() {
                Range.setBegin(SS.getBeginLoc());
            }
            self.Diag(TemplateId.LAngleLoc, err_template_spec_syntax_non_template) << TemplateId.Name << TemplateId.Kind as i32 << Range;
