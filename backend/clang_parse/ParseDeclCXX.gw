    let mut AbstractLoc: SourceLocation = SourceLocation {};
    let mut IsFinalSpelledSealed: bool = false;
    let mut IsAbstract: bool = false;
    if self.getLangOpts() && self.Tok.is(identifier) {
        while true {
            let mut Specifier: Specifier = self.isCXX11VirtSpecifier(self.Tok);
            if Specifier == VS_None {
                break;
            }
            if self.isCXX11FinalKeyword() {
