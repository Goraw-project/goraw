    } else if !isTypeSpecifier(DSC) && (self.Tok.is(semi) || (self.Tok.isAtStartOfLine() && !self.isValidAfterTypeSpecifier(false))) {
        TUK = if DS.isFriendSpecified() { Friend } else { Declaration };
        if self.Tok.isNot(semi) {
            let mut PPol: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
            self.ExpectAndConsume(semi, err_expected_after, getSpecifierName(TagType, PPol));
            self.PP.EnterToken(self.Tok, true);
