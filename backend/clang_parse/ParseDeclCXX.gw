fn Parser::ParseNamespace(self, Context: DeclaratorContext, DeclEnd: *mut SourceLocation, InlineLoc: SourceLocation) -> DeclGroupPtrTy {
    assert!(self.Tok.is(kw_namespace), "Not a namespace!");
    let mut NamespaceLoc: SourceLocation = self.ConsumeToken();
    let mut ObjCDC: ObjCDeclContextSwitch = *self;
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteNamespaceDecl(self.getCurScope());
        return null;
    }
    let mut IdentLoc: SourceLocation = SourceLocation {};
    let mut Ident: *mut IdentifierInfo = null;
    let mut ExtraNSs: InnerNamespaceInfoList = InnerNamespaceInfoList {};
    let mut FirstNestedInlineLoc: SourceLocation = SourceLocation {};
    let mut attrs: ParsedAttributes = self.AttrFactory;
    while self.MaybeParseGNUAttributes(attrs, null) || self.isAllowedCXX11AttributeSpecifier(false, false) {
        if self.isAllowedCXX11AttributeSpecifier(false, false) {
            if self.getLangOpts().CPlusPlus11 {
                self.DiagCompat(self.Tok.getLocation(), ns_enum_attribute) << 0;
            }
            self.ParseCXX11Attributes(attrs);
        }
    }
    if self.Tok.is(identifier) {
        Ident = self.Tok.getIdentifierInfo();
        IdentLoc = self.ConsumeToken();
        while self.Tok.is(coloncolon) && (self.NextToken().is(identifier) || (self.NextToken().is(kw_inline) && self.GetLookAheadToken(2).is(identifier))) {
            let mut Info: InnerNamespaceInfo = InnerNamespaceInfo {};
            Info.NamespaceLoc = self.ConsumeToken();
            if self.Tok.is(kw_inline) {
                Info.InlineLoc = self.ConsumeToken();
                if FirstNestedInlineLoc.isInvalid() {
                    FirstNestedInlineLoc = Info.InlineLoc;
                }
            }
            Info.Ident = self.Tok.getIdentifierInfo();
            Info.IdentLoc = self.ConsumeToken();
            ExtraNSs.push(Info);
        }
    }
    self.DiagnoseAndSkipCXX11Attributes();
    self.MaybeParseGNUAttributes(attrs, null);
    self.DiagnoseAndSkipCXX11Attributes();
    let mut attrLoc: SourceLocation = attrs.Range.getBegin();
    if !ExtraNSs.is_empty() && attrLoc.isValid() {
        self.Diag(attrLoc, err_unexpected_nested_namespace_attribute);
    }
    if self.Tok.is(equal) {
        if !Ident {
            self.Diag(self.Tok, err_expected) << identifier;
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        if !ExtraNSs.is_empty() {
            self.Diag(ExtraNSs.front().NamespaceLoc, err_unexpected_qualified_namespace_alias) << SourceRange { B: ExtraNSs.front().NamespaceLoc, E: ExtraNSs.back().IdentLoc };
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        if attrLoc.isValid() {
            self.Diag(attrLoc, err_unexpected_namespace_attributes_alias);
        }
        if InlineLoc.isValid() {
            self.Diag(InlineLoc, err_inline_namespace_alias) << CreateRemoval(InlineLoc);
        }
        let mut NSAlias: *mut Decl = self.ParseNamespaceAlias(NamespaceLoc, IdentLoc, Ident, DeclEnd);
        return self.Actions.ConvertDeclToDeclGroup(NSAlias, null);
    }
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    if T.consumeOpen() {
        if Ident {
            self.Diag(self.Tok, err_expected) << l_brace;
        } else {
            self.Diag(self.Tok, err_expected_either) << identifier << l_brace;
        }
        return null;
    }
    if self.getCurScope().isClassScope() || self.getCurScope().isTemplateParamScope() || self.getCurScope().isInObjcMethodScope() || self.getCurScope().getBlockParent() || self.getCurScope().getFnParent() {
        self.Diag(T.getOpenLocation(), err_namespace_nonnamespace_scope);
        self.SkipUntil(r_brace, 0 as SkipUntilFlags);
        return null;
    }
    if ExtraNSs.is_empty() {} else if InlineLoc.isValid() {
        self.Diag(InlineLoc, err_inline_nested_namespace_definition);
    } else if self.getLangOpts().CPlusPlus20 {
        self.Diag(ExtraNSs[0].NamespaceLoc, warn_cxx14_compat_nested_namespace_definition);
        if FirstNestedInlineLoc.isValid() {
            self.Diag(FirstNestedInlineLoc, warn_cxx17_compat_inline_nested_namespace_definition);
        }
    } else if self.getLangOpts().CPlusPlus17 {
        self.Diag(ExtraNSs[0].NamespaceLoc, warn_cxx14_compat_nested_namespace_definition);
        if FirstNestedInlineLoc.isValid() {
            self.Diag(FirstNestedInlineLoc, ext_inline_nested_namespace_definition);
        }
    } else {
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        self.SkipUntil(r_brace, StopBeforeMatch);
        let mut rBraceToken: Token = self.Tok;
        TPA.Revert();
        if !rBraceToken.is(r_brace) {
            self.Diag(ExtraNSs[0].NamespaceLoc, ext_nested_namespace_definition) << SourceRange { B: ExtraNSs.front().NamespaceLoc, E: ExtraNSs.back().IdentLoc };
        } else {
            let mut NamespaceFix: str = "";
            for ExtraNS in ExtraNSs {
                operator(NamespaceFix, " { ");
                if ExtraNS.InlineLoc.isValid() {
                    operator(NamespaceFix, "inline ");
                }
                operator(NamespaceFix, "namespace ");
                operator(NamespaceFix, ExtraNS.Ident.getName());
            }
            let mut RBraces: str = "";
            for let mut i: u32 = 0;
let mut e: u32 = ExtraNSs.len; i != e; i += 1 {
                operator(RBraces, "} ");
            }
            self.Diag(ExtraNSs[0].NamespaceLoc, ext_nested_namespace_definition) << CreateReplacement(SourceRange { B: ExtraNSs.front().NamespaceLoc, E: ExtraNSs.back().IdentLoc }, NamespaceFix) << CreateInsertion(rBraceToken.getLocation(), RBraces, false);
        }
        if FirstNestedInlineLoc.isValid() {
            self.Diag(FirstNestedInlineLoc, ext_inline_nested_namespace_definition);
        }
    }
    if InlineLoc.isValid() {
        self.DiagCompat(InlineLoc, inline_namespace);
    }
    let mut NamespaceScope: ParseScope = ParseScope { self, DeclScope, true, false };
    let mut ImplicitUsingDirectiveDecl: *mut UsingDirectiveDecl = null;
    let mut NamespcDecl: *mut Decl = self.Actions.ActOnStartNamespaceDef(self.getCurScope(), InlineLoc, NamespaceLoc, IdentLoc, Ident, T.getOpenLocation(), attrs, ImplicitUsingDirectiveDecl, false);
    let mut CrashInfo: PrettyDeclStackTraceEntry = PrettyDeclStackTraceEntry { self.Actions.Context, NamespcDecl, NamespaceLoc, "parsing namespace" };
    self.ParseInnerNamespace(ExtraNSs, 0, InlineLoc, attrs, T);
    NamespaceScope.Exit();
    DeclEnd = T.getCloseLocation();
    self.Actions.ActOnFinishNamespaceDef(NamespcDecl, DeclEnd);
    return self.Actions.ConvertDeclToDeclGroup(NamespcDecl, ImplicitUsingDirectiveDecl);
}

fn Parser::ParseInnerNamespace(self, InnerNSs: *InnerNamespaceInfoList, index: u32, InlineLoc: *mut SourceLocation, attrs: *mut ParsedAttributes, Tracker: *mut BalancedDelimiterTracker) {
    if index == InnerNSs.len {
        while !self.tryParseMisplacedModuleImport() && self.Tok.isNot(r_brace) && self.Tok.isNot(eof) {
            let mut DeclAttrs: ParsedAttributes = self.AttrFactory;
            self.MaybeParseCXX11Attributes(DeclAttrs, false);
            let mut EmptyDeclSpecAttrs: ParsedAttributes = self.AttrFactory;
            self.ParseExternalDeclaration(DeclAttrs, EmptyDeclSpecAttrs, null);
        }
        Tracker.consumeClose();
        return;
    }
    let mut NamespaceScope: ParseScope = ParseScope { self, DeclScope, true, false };
    let mut ImplicitUsingDirectiveDecl: *mut UsingDirectiveDecl = null;
    let mut NamespcDecl: *mut Decl = self.Actions.ActOnStartNamespaceDef(self.getCurScope(), InnerNSs[index].InlineLoc, InnerNSs[index].NamespaceLoc, InnerNSs[index].IdentLoc, InnerNSs[index].Ident, Tracker.getOpenLocation(), attrs, ImplicitUsingDirectiveDecl, true);
    assert!(!ImplicitUsingDirectiveDecl, "nested namespace definition cannot define anonymous namespace");
    self.ParseInnerNamespace(InnerNSs, index += 1, InlineLoc, attrs, Tracker);
    NamespaceScope.Exit();
    self.Actions.ActOnFinishNamespaceDef(NamespcDecl, Tracker.getCloseLocation());
}

fn Parser::ParseNamespaceAlias(self, NamespaceLoc: SourceLocation, AliasLoc: SourceLocation, Alias: *mut IdentifierInfo, DeclEnd: *mut SourceLocation) -> *mut Decl {
    assert!(self.Tok.is(equal), "Not equal token");
    self.ConsumeToken();
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteNamespaceAliasDecl(self.getCurScope());
        return null;
    }
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, true, false, false, false, false);
    if self.Tok.isNot(identifier) {
        self.Diag(self.Tok, err_expected_namespace_name);
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    if SS.isInvalid() {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    let mut Ident: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut IdentLoc: SourceLocation = self.ConsumeToken();
    DeclEnd = self.Tok.getLocation();
    if self.ExpectAndConsume(semi, err_expected_semi_after_namespace_name, "") {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
    }
    return self.Actions.ActOnNamespaceAliasDef(self.getCurScope(), NamespaceLoc, AliasLoc, Alias, SS, IdentLoc, Ident);
}

fn Parser::ParseLinkage(self, DS: *mut ParsingDeclSpec, Context: DeclaratorContext) -> *mut Decl {
    assert!(self.isTokenStringLiteral(), "Not a string literal!");
    let mut Lang: ExprResult = self.ParseUnevaluatedStringLiteralExpression();
    let mut LinkageScope: ParseScope = ParseScope { self, DeclScope, true, false };
    let mut LinkageSpec: *mut Decl = if Lang.isInvalid() { null } else { self.Actions.ActOnStartLinkageSpecification(self.getCurScope(), DS.getSourceRange().getBegin(), Lang.get(), if self.Tok.is(l_brace) { self.Tok.getLocation() } else { SourceLocation {} }) };
    let mut DeclAttrs: ParsedAttributes = self.AttrFactory;
    let mut DeclSpecAttrs: ParsedAttributes = self.AttrFactory;
    while self.MaybeParseCXX11Attributes(DeclAttrs, false) || self.MaybeParseGNUAttributes(DeclSpecAttrs, null) {
        
    }
    if self.Tok.isNot(l_brace) {
        DS.SetRangeStart(SourceLocation {});
        DS.SetRangeEnd(SourceLocation {});
        DS.setExternInLinkageSpec(true);
        self.ParseExternalDeclaration(DeclAttrs, DeclSpecAttrs, &mut DS);
        return if LinkageSpec { self.Actions.ActOnFinishLinkageSpecification(self.getCurScope(), LinkageSpec, SourceLocation {}) } else { null };
    }
    DS.abort();
    self.ProhibitAttributes(DeclAttrs, SourceLocation {});
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    T.consumeOpen();
    let mut NestedModules: u32 = 0;
    while true {
        match self.Tok.getKind() {
            annot_module_begin => {
                NestedModules += 1;
            },
            annot_module_end => {
                if !NestedModules {
                    break;
                }
            },
            annot_module_include => {
                self.ParseTopLevelDecl();
            },
            eof => {
                break;
            },
            r_brace => {
                if !NestedModules {
                    break;
                }
            },
            _ => {
                let mut DeclAttrs: ParsedAttributes = self.AttrFactory;
            },
        }
        break;
    }
    T.consumeClose();
    return if LinkageSpec { self.Actions.ActOnFinishLinkageSpecification(self.getCurScope(), LinkageSpec, T.getCloseLocation()) } else { null };
}

fn Parser::ParseExportDeclaration(self) -> *mut Decl {
    assert!(self.Tok.is(kw_export);
    let mut ExportLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteOrdinaryName(self.getCurScope(), if self.PP.isIncrementalProcessingEnabled() { PCC_TopLevelOrExpression } else { PCC_Namespace });
        return null;
    }
    let mut ExportScope: ParseScope = ParseScope { self, DeclScope, true, false };
    let mut ExportDecl: *mut Decl = self.Actions.ActOnStartExportDecl(self.getCurScope(), ExportLoc, if self.Tok.is(l_brace) { self.Tok.getLocation() } else { SourceLocation {} });
    if self.Tok.isNot(l_brace) {
        let mut DeclAttrs: ParsedAttributes = self.AttrFactory;
        self.MaybeParseCXX11Attributes(DeclAttrs, false);
        let mut EmptyDeclSpecAttrs: ParsedAttributes = self.AttrFactory;
        self.ParseExternalDeclaration(DeclAttrs, EmptyDeclSpecAttrs, null);
        return self.Actions.ActOnFinishExportDecl(self.getCurScope(), ExportDecl, SourceLocation {});
    }
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    T.consumeOpen();
    while !self.tryParseMisplacedModuleImport() && self.Tok.isNot(r_brace) && self.Tok.isNot(eof) {
        let mut DeclAttrs: ParsedAttributes = self.AttrFactory;
        self.MaybeParseCXX11Attributes(DeclAttrs, false);
        let mut EmptyDeclSpecAttrs: ParsedAttributes = self.AttrFactory;
        self.ParseExternalDeclaration(DeclAttrs, EmptyDeclSpecAttrs, null);
    }
    T.consumeClose();
    return self.Actions.ActOnFinishExportDecl(self.getCurScope(), ExportDecl, T.getCloseLocation());
}

fn Parser::ParseUsingDirectiveOrDeclaration(self, Context: DeclaratorContext, TemplateInfo: *ParsedTemplateInfo, DeclEnd: *mut SourceLocation, Attrs: *mut ParsedAttributes) -> DeclGroupPtrTy {
    assert!(self.Tok.is(kw_using), "Not using token");
    let mut ObjCDC: ObjCDeclContextSwitch = *self;
    let mut UsingLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteUsing(self.getCurScope());
        return null;
    }
    while self.Tok.is(kw_template) {
        let mut TemplateLoc: SourceLocation = self.ConsumeToken();
        self.Diag(TemplateLoc, err_unexpected_template_after_using) << CreateRemoval(TemplateLoc);
    }
    if self.Tok.is(kw_namespace) {
        if TemplateInfo.Kind != NonTemplate {
            let mut R: SourceRange = TemplateInfo.getSourceRange();
            self.Diag(UsingLoc, err_templated_using_directive_declaration) << 0 << R << CreateRemoval(R);
        }
        let mut UsingDir: *mut Decl = self.ParseUsingDirective(Context, UsingLoc, DeclEnd, Attrs);
        return self.Actions.ConvertDeclToDeclGroup(UsingDir, null);
    }
    return self.ParseUsingDeclaration(Context, TemplateInfo, UsingLoc, DeclEnd, Attrs, AS_none);
}

fn Parser::ParseUsingDirective(self, Context: DeclaratorContext, UsingLoc: SourceLocation, DeclEnd: *mut SourceLocation, attrs: *mut ParsedAttributes) -> *mut Decl {
    assert!(self.Tok.is(kw_namespace), "Not 'namespace' token");
    let mut NamespcLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteUsingDirective(self.getCurScope());
        return null;
    }
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, true, false, false, false, false);
    let mut NamespcName: *mut IdentifierInfo = null;
    let mut IdentLoc: SourceLocation = SourceLocation {};
    if self.Tok.isNot(identifier) {
        self.Diag(self.Tok, err_expected_namespace_name);
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    if SS.isInvalid() {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    NamespcName = self.Tok.getIdentifierInfo();
    IdentLoc = self.ConsumeToken();
    let mut GNUAttr: bool = false;
    if self.Tok.is(kw___attribute) {
        GNUAttr = true;
        self.ParseGNUAttributes(attrs, null, null);
    }
    DeclEnd = self.Tok.getLocation();
    if self.ExpectAndConsume(semi, if GNUAttr { err_expected_semi_after_attribute_list } else { err_expected_semi_after_namespace_name }, "") {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
    }
    return self.Actions.ActOnUsingDirective(self.getCurScope(), UsingLoc, NamespcLoc, SS, IdentLoc, NamespcName, attrs);
}

fn Parser::ParseUsingDeclarator(self, Context: DeclaratorContext, D: *mut UsingDeclarator) -> bool {
    D.clear();
    self.TryConsumeToken(kw_typename, D.TypenameLoc);
    if self.Tok.is(kw___super) {
        self.Diag(self.Tok.getLocation(), err_super_in_using_declaration);
        return true;
    }
    let mut LastII: *IdentifierInfo = null;
    if self.ParseOptionalCXXScopeSpecifier(D.SS, null, false, false, null, false, &mut LastII, false, true, false, false, false) {
        return true;
    }
    if D.SS.isInvalid() {
        return true;
    }
    if self.getLangOpts().CPlusPlus11 && Context == Member && self.Tok.is(identifier) && (self.NextToken().is(semi) || self.NextToken().is(comma) || self.NextToken().is(ellipsis) || self.NextToken().is(l_square) || self.NextToken().isRegularKeywordAttribute() || self.NextToken().is(kw___attribute)) && D.SS.isNotEmpty() && LastII == self.Tok.getIdentifierInfo() && D.SS.getScopeRep().getKind() != Namespace {
        let mut IdLoc: SourceLocation = self.ConsumeToken();
        let mut Type: ParsedType = self.Actions.getInheritingConstructorName(D.SS, IdLoc, *LastII);
        D.Name.setConstructorName(Type, IdLoc, IdLoc);
    } else {
        if self.ParseUnqualifiedId(D.SS, null, false, false, true, !(self.Tok.is(identifier) && self.NextToken().is(equal)), false, null, D.Name) {
            return true;
        }
    }
    if self.TryConsumeToken(ellipsis, D.EllipsisLoc) {
        self.DiagCompat(self.Tok.getLocation(), using_declaration_pack);
    }
    return false;
}

fn Parser::ParseUsingDeclaration(self, Context: DeclaratorContext, TemplateInfo: *ParsedTemplateInfo, UsingLoc: SourceLocation, DeclEnd: *mut SourceLocation, PrefixAttrs: *mut ParsedAttributes, AS: AccessSpecifier) -> DeclGroupPtrTy {
    let mut UELoc: SourceLocation = SourceLocation {};
    let mut InInitStatement: bool = Context == SelectionInit || Context == ForInit;
    if self.TryConsumeToken(kw_enum, UELoc) && !InInitStatement {
        self.DiagCompat(UELoc, using_enum_declaration);
        self.DiagnoseCXX11AttributeExtension(PrefixAttrs);
        if TemplateInfo.Kind != NonTemplate {
            let mut R: SourceRange = TemplateInfo.getSourceRange();
            self.Diag(UsingLoc, err_templated_using_directive_declaration) << 1 << R << CreateRemoval(R);
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        let mut SS: CXXScopeSpec = CXXScopeSpec {};
        if self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, true, null, false, true, false, false, false) {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        if self.Tok.is(code_completion) {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteUsing(self.getCurScope());
            return null;
        }
        let mut UED: *mut Decl = null;
        if self.Tok.is(identifier) {
            let mut IdentInfo: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
            let mut IdentLoc: SourceLocation = self.ConsumeToken();
            let mut Type: ParsedType = self.Actions.getTypeName(*IdentInfo, IdentLoc, self.getCurScope(), &mut SS, true, false, null, false, true, true, No, null);
            UED = self.Actions.ActOnUsingEnumDeclaration(self.getCurScope(), AS, UsingLoc, UELoc, IdentLoc, *IdentInfo, Type, SS);
        } else if self.Tok.is(annot_template_id) {
            let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
            if TemplateId.mightBeType() {
                self.AnnotateTemplateIdTokenAsType(SS, No, true);
                assert!(self.Tok.is(annot_typename), "template-id -> type failed");
                let mut Type: TypeResult = getTypeAnnotation(self.Tok);
                let mut Loc: SourceRange = self.Tok.getAnnotationRange();
                self.ConsumeAnnotationToken();
                UED = self.Actions.ActOnUsingEnumDeclaration(self.getCurScope(), AS, UsingLoc, UELoc, Loc, *TemplateId.Name, Type.get(), SS);
            } else {
                self.Diag(self.Tok.getLocation(), err_using_enum_not_enum) << TemplateId.Name.getName() << SourceRange { B: TemplateId.TemplateNameLoc, E: TemplateId.RAngleLoc };
            }
        } else {
            self.Diag(self.Tok.getLocation(), err_using_enum_expect_identifier) << self.Tok.is(kw_enum);
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        if !UED {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        DeclEnd = self.Tok.getLocation();
        if self.ExpectAndConsume(semi, err_expected_after, "using-enum declaration") {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
        }
        return self.Actions.ConvertDeclToDeclGroup(UED, null);
    }
    let mut MisplacedAttrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseCXX11Attributes(MisplacedAttrs, false);
    if InInitStatement && self.Tok.isNot(identifier) {
        return null;
    }
    let mut D: UsingDeclarator = UsingDeclarator {};
    let mut InvalidDeclarator: bool = self.ParseUsingDeclarator(Context, D);
    let mut Attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseAttributes(PAKM_GNU | PAKM_CXX11, Attrs, null);
    if MisplacedAttrs.Range.isValid() {
        let mut FirstAttr: *mut ParsedAttr = if MisplacedAttrs.is_empty() { null } else { &mut MisplacedAttrs.front() };
        let mut Range: *mut SourceRange = MisplacedAttrs.Range;
        (if FirstAttr && FirstAttr.isRegularKeywordAttribute() { self.Diag(Range.getBegin(), err_keyword_not_allowed) << FirstAttr } else { self.Diag(Range.getBegin(), err_attributes_not_allowed) }) << CreateInsertionFromRange(self.Tok.getLocation(), getTokenRange(Range), false) << CreateRemoval(Range);
        Attrs.takeAllPrependingFrom(MisplacedAttrs);
    }
    if self.Tok.is(equal) || InInitStatement {
        if InvalidDeclarator {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        self.ProhibitAttributes(PrefixAttrs, self.Tok.getLocation());
        let mut DeclFromDeclSpec: *mut Decl = null;
        let mut CurScope: *mut Scope = self.getCurScope();
        if CurScope {
            CurScope.setFlags(TypeAliasScope | CurScope.getFlags());
        }
        let mut AD: *mut Decl = self.ParseAliasDeclarationAfterDeclarator(TemplateInfo, UsingLoc, D, DeclEnd, AS, Attrs, &mut DeclFromDeclSpec);
        if !AD {
            return null;
        }
        return self.Actions.ConvertDeclToDeclGroup(AD, DeclFromDeclSpec);
    }
    self.DiagnoseCXX11AttributeExtension(PrefixAttrs);
    if TemplateInfo.Kind != NonTemplate {
        let mut R: SourceRange = TemplateInfo.getSourceRange();
        self.Diag(UsingLoc, err_templated_using_directive_declaration) << 1 << R << CreateRemoval(R);
        return null;
    }
    let mut DeclsInGroup: SmallVector<Decl *, 8> = SmallVector<Decl *, 8> {};
    while true {
        self.MaybeParseAttributes(PAKM_GNU | PAKM_CXX11, Attrs, null);
        self.DiagnoseCXX11AttributeExtension(Attrs);
        Attrs.prepend(PrefixAttrs.begin(), PrefixAttrs.end());
        if InvalidDeclarator {
            self.SkipUntil(comma, semi, StopBeforeMatch);
        } else {
            if D.TypenameLoc.isValid() && D.Name.getKind() != IK_Identifier {
                self.Diag(D.Name.getSourceRange().getBegin(), err_typename_identifiers_only) << CreateRemoval(D.TypenameLoc);
                D.TypenameLoc = SourceLocation {};
            }
            let mut UD: *mut Decl = self.Actions.ActOnUsingDeclaration(self.getCurScope(), AS, UsingLoc, D.TypenameLoc, D.SS, D.Name, D.EllipsisLoc, Attrs);
            if UD {
                DeclsInGroup.push(UD);
            }
        }
        if !self.TryConsumeToken(comma) {
            break;
        }
        Attrs.clear();
        InvalidDeclarator = self.ParseUsingDeclarator(Context, D);
    }
    if DeclsInGroup.len > 1 {
        self.DiagCompat(self.Tok.getLocation(), multi_using_declaration);
    }
    DeclEnd = self.Tok.getLocation();
    if self.ExpectAndConsume(semi, err_expected_after, if !Attrs.is_empty() { "attributes list" } else { if UELoc.isValid() { "using-enum declaration" } else { "using declaration" } }) {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
    }
    return self.Actions.BuildDeclaratorGroup(DeclsInGroup);
}

fn Parser::ParseAliasDeclarationAfterDeclarator(self, TemplateInfo: *ParsedTemplateInfo, UsingLoc: SourceLocation, D: *mut UsingDeclarator, DeclEnd: *mut SourceLocation, AS: AccessSpecifier, Attrs: *mut ParsedAttributes, OwnedType: *mut *mut Decl) -> *mut Decl {
    if self.ExpectAndConsume(equal, err_expected, "") {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    self.DiagCompat(self.Tok.getLocation(), alias_declaration);
    let mut SpecKind: i32 = -1;
    if TemplateInfo.Kind == Template && D.Name.getKind() == IK_TemplateId {
        SpecKind = 0;
    }
    if TemplateInfo.Kind == ExplicitSpecialization {
        SpecKind = 1;
    }
    if TemplateInfo.Kind == ExplicitInstantiation {
        SpecKind = 2;
    }
    if SpecKind != -1 {
        let mut Range: SourceRange = SourceRange {};
        if SpecKind == 0 {
            Range = SourceRange { B: D.Name..TemplateId.LAngleLoc, E: D.Name..TemplateId.RAngleLoc };
        } else {
            Range = TemplateInfo.getSourceRange();
        }
        self.Diag(Range.getBegin(), err_alias_declaration_specialization) << SpecKind << Range;
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    }
    if D.Name.getKind() != IK_Identifier {
        self.Diag(D.Name.StartLocation, err_alias_declaration_not_identifier);
        self.SkipUntil(semi, 0 as SkipUntilFlags);
        return null;
    } else if D.TypenameLoc.isValid() {
        self.Diag(D.TypenameLoc, err_alias_declaration_not_identifier) << CreateRemoval(SourceRange { B: D.TypenameLoc, E: if D.SS.isNotEmpty() { D.SS.getEndLoc() } else { D.TypenameLoc } });
    } else if D.SS.isNotEmpty() {
        self.Diag(D.SS.getBeginLoc(), err_alias_declaration_not_identifier) << CreateRemoval(D.SS.getRange());
    }
    if D.EllipsisLoc.isValid() {
        self.Diag(D.EllipsisLoc, err_alias_declaration_pack_expansion) << CreateRemoval(D.EllipsisLoc);
    }
    let mut DeclFromDeclSpec: *mut Decl = null;
    let mut TypeAlias: TypeResult = self.ParseTypeName(null, if TemplateInfo.Kind != NonTemplate { AliasTemplate } else { AliasDecl }, AS, &mut DeclFromDeclSpec, &mut Attrs);
    if OwnedType {
        *OwnedType = DeclFromDeclSpec;
    }
    DeclEnd = self.Tok.getLocation();
    if self.ExpectAndConsume(semi, err_expected_after, if !Attrs.is_empty() { "attributes list" } else { "alias declaration" }) {
        self.SkipUntil(semi, 0 as SkipUntilFlags);
    }
    let mut TemplateParams: *mut TemplateParameterLists = TemplateInfo.TemplateParams;
    let mut TemplateParamsArg: MultiTemplateParamsArg = MultiTemplateParamsArg { if TemplateParams { TemplateParams.ptr } else { null }, if TemplateParams { TemplateParams.len } else { 0 } };
    return self.Actions.ActOnAliasDeclaration(self.getCurScope(), AS, TemplateParamsArg, UsingLoc, D.Name, Attrs, TypeAlias, DeclFromDeclSpec);
}

fn getStaticAssertNoMessageFixIt(AssertExpr: *Expr, EndExprLoc: SourceLocation) -> FixItHint {
    if dyn_cast_or_null(AssertExpr) {
        BO;
    } else {
        if BO.getOpcode() == BO_LAnd && isa(BO.getRHS().IgnoreImpCasts()) {
            return CreateReplacement(BO.getOperatorLoc(), ",");
        }
    }
    return CreateInsertion(EndExprLoc, ", \"\"", false);
}

fn Parser::ParseStaticAssertDeclaration(self, DeclEnd: *mut SourceLocation) -> *mut Decl {
    assert!(self.Tok.isOneOf(kw_static_assert, kw__Static_assert), "Not a static_assert declaration");
    let mut TokName: *u8 = self.Tok.getName();
    if self.Tok.is(kw__Static_assert) {
        self.diagnoseUseOfC11Keyword(self.Tok);
    } else if self.Tok.is(kw_static_assert) {
        if !self.getLangOpts().CPlusPlus {
            if self.getLangOpts().C23 {
                self.Diag(self.Tok, warn_c23_compat_keyword) << self.Tok.getName();
            }
        } else {
            self.Diag(self.Tok, warn_cxx98_compat_static_assert);
        }
    }
    let mut StaticAssertLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        self.SkipMalformedDecl();
        return null;
    }
    let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
    let mut AssertExpr: ExprResult = self.ParseConstantExpressionInExprEvalContext(AllowNonTypes);
    if AssertExpr.isInvalid() {
        self.SkipMalformedDecl();
        return null;
    }
    let mut AssertMessage: ExprResult = false;
    if self.Tok.is(r_paren) {
        let mut diag: (unnamed enum at P:\llvm-build\tools\clang\include\clang\Basic\DiagnosticParseCompatIDs.inc:1:1) = if self.getLangOpts().CPlusPlus { cxx_static_assert_no_message } else { c_static_assert_no_message };
        self.DiagCompat(self.Tok, diag) << getStaticAssertNoMessageFixIt(AssertExpr.get(), self.Tok.getLocation());
    } else {
        if self.ExpectAndConsume(comma, err_expected, "") {
            self.SkipUntil(semi, 0 as SkipUntilFlags);
            return null;
        }
        let mut ParseAsExpression: bool = false;
        if self.getLangOpts().CPlusPlus11 {
            for let mut I: u32 = 0; ; I += 1 {
                let mut T: *Token = self.GetLookAheadToken(I);
                if T.is(r_paren) {
                    break;
                }
                if !tokenIsLikeStringLiteral(T, self.getLangOpts()) || T.hasUDSuffix() {
                    ParseAsExpression = true;
                    break;
                }
            }
        }
        if ParseAsExpression {
            AssertMessage = self.ParseConstantExpressionInExprEvalContext(AllowNonTypes);
            if self.Tok.is(r_paren) {
                self.DiagCompat(self.Tok, static_assert_user_generated_message);
            } else {
                T.consumeClose();
                return null;
            }
        } else if tokenIsLikeStringLiteral(self.Tok, self.getLangOpts()) {
            AssertMessage = self.ParseUnevaluatedStringLiteralExpression();
        } else {
            self.Diag(self.Tok, err_expected_string_literal) << 1;
            self.SkipMalformedDecl();
            return null;
        }
        if AssertMessage.isInvalid() {
            self.SkipMalformedDecl();
            return null;
        }
    }
    T.consumeClose();
    DeclEnd = self.Tok.getLocation();
    self.ExpectAndConsumeSemi(err_expected_semi_after_static_assert, TokName);
    return self.Actions.ActOnStaticAssertDeclaration(StaticAssertLoc, AssertExpr.get(), AssertMessage.get(), T.getCloseLocation());
}

fn Parser::ParseDecltypeSpecifier(self, DS: *mut DeclSpec) -> SourceLocation {
    assert!(self.Tok.isOneOf(kw_decltype, annot_decltype), "Not a decltype specifier");
    let mut Result: ExprResult = false;
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = SourceLocation {};
    if self.Tok.is(annot_decltype) {
        Result = getExprAnnotation(self.Tok);
        EndLoc = self.Tok.getAnnotationEndLoc();
        DS.setTypeArgumentRange(SourceRange { B: SourceLocation {}, E: EndLoc });
        self.ConsumeAnnotationToken();
        if Result.isInvalid() {
            DS.SetTypeSpecError();
            return EndLoc;
        }
    } else {
        if self.Tok.getIdentifierInfo().isStr("decltype") {
            self.Diag(self.Tok, warn_cxx98_compat_decltype);
        }
        self.ConsumeToken();
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        if T.expectAndConsume(err_expected_lparen_after, "decltype", r_paren) {
            DS.SetTypeSpecError();
            return if T.getOpenLocation() == self.Tok.getLocation() { StartLoc } else { T.getOpenLocation() };
        }
        if self.Tok.is(kw_auto) && self.NextToken().is(r_paren) {
            self.DiagCompat(self.Tok.getLocation(), decltype_auto_type_specifier);
            self.ConsumeToken();
        } else {
            let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Decltype, true };
            Result = self.ParseExpression(AllowNonTypes);
            if Result.isInvalid() {
                DS.SetTypeSpecError();
                if self.SkipUntil(r_paren, StopAtSemi | StopBeforeMatch) {
                    EndLoc = self.ConsumeParen();
                } else {
                    if self.PP.isBacktrackEnabled() && self.Tok.is(semi) {
                        self.PP.RevertCachedTokens(2);
                        self.ConsumeToken();
                        EndLoc = self.ConsumeAnyToken(false);
                    } else {
                        EndLoc = self.Tok.getLocation();
                    }
                }
                return EndLoc;
            }
            Result = self.Actions.ActOnDecltypeExpression(Result.get());
        }
        T.consumeClose();
        DS.setTypeArgumentRange(T.getRange());
        if T.getCloseLocation().isInvalid() {
            DS.SetTypeSpecError();
            return T.getCloseLocation();
        }
        if Result.isInvalid() {
            DS.SetTypeSpecError();
            return T.getCloseLocation();
        }
        EndLoc = T.getCloseLocation();
    }
    assert!(!Result.isInvalid();
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    let mut Policy: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
    if if Result.get() { DS.SetTypeSpecType(TST_decltype, StartLoc, PrevSpec, DiagID, Result.get(), Policy) } else { DS.SetTypeSpecType(TST_decltype_auto, StartLoc, PrevSpec, DiagID, Policy) } {
        self.Diag(StartLoc, DiagID) << PrevSpec;
        DS.SetTypeSpecError();
    }
    DS.SetRangeEnd(EndLoc);
    return EndLoc;
}

fn Parser::AnnotateExistingDecltypeSpecifier(self, DS: *DeclSpec, StartLoc: SourceLocation, EndLoc: SourceLocation) {
    if self.PP.isBacktrackEnabled() {
        self.PP.RevertCachedTokens(1);
    } else {
        self.PP.EnterToken(self.Tok, true);
    }
    self.Tok.setKind(annot_decltype);
    setExprAnnotation(self.Tok, if DS.getTypeSpecType() == TST_decltype { DS.getRepAsExpr() } else { if DS.getTypeSpecType() == TST_decltype_auto { ExprResult { false } } else { ExprError() } });
    self.Tok.setAnnotationEndLoc(EndLoc);
    self.Tok.setLocation(StartLoc);
    self.PP.AnnotateCachedTokens(self.Tok);
}

fn Parser::ParsePackIndexingType(self, DS: *mut DeclSpec) -> SourceLocation {
    assert!(self.Tok.isOneOf(annot_pack_indexing_type, identifier), "Expected an identifier");
    let mut Type: TypeResult = false;
    let mut StartLoc: SourceLocation = SourceLocation {};
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    let mut Policy: *PrintingPolicy = self.Actions.getASTContext().getPrintingPolicy();
    if self.Tok.is(annot_pack_indexing_type) {
        StartLoc = self.Tok.getLocation();
        let mut EndLoc: SourceLocation = SourceLocation {};
        Type = getTypeAnnotation(self.Tok);
        EndLoc = self.Tok.getAnnotationEndLoc();
        DS.setTypeArgumentRange(SourceRange { B: SourceLocation {}, E: EndLoc });
        self.ConsumeAnnotationToken();
        if Type.isInvalid() {
            DS.SetTypeSpecError();
            return EndLoc;
        }
        DS.SetTypeSpecType(TST_typename_pack_indexing, StartLoc, PrevSpec, DiagID, Type, Policy);
        return EndLoc;
    }
    if !self.NextToken().is(ellipsis) || !self.GetLookAheadToken(2).is(l_square) {
        DS.SetTypeSpecError();
        return self.Tok.getEndLoc();
    }
    let mut Ty: ParsedType = self.Actions.getTypeName(*self.Tok.getIdentifierInfo(), self.Tok.getLocation(), self.getCurScope(), null, false, false, null, false, false, true, No, null);
    if !Ty {
        DS.SetTypeSpecError();
        return self.Tok.getEndLoc();
    }
    Type = Ty;
    StartLoc = self.ConsumeToken();
    EllipsisLoc = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
    T.consumeOpen();
    let mut IndexExpr: ExprResult = self.ParseConstantExpression();
    T.consumeClose();
    DS.SetRangeStart(StartLoc);
    DS.SetRangeEnd(T.getCloseLocation());
    if !IndexExpr.isUsable() {
        let mut C: *mut ASTContext = self.Actions.getASTContext();
        IndexExpr = Create(C, C.MakeIntValue(0, C.getSizeType()), C.getSizeType(), SourceLocation {});
    }
    DS.SetTypeSpecType(TST_typename, StartLoc, PrevSpec, DiagID, Type, Policy);
    DS.SetPackIndexingExpr(EllipsisLoc, IndexExpr.get());
    return T.getCloseLocation();
}

fn Parser::isPackIndexingTemplateName(self, Name: *mut UnqualifiedId, Template: *mut TemplateTy) -> TemplateNameKind {
    assert!(self.Tok.is(identifier) && self.NextToken().is(ellipsis) && self.GetLookAheadToken(2).is(l_square), "expected 'identifier...['");
    Name.setIdentifier(self.Tok.getIdentifierInfo(), self.Tok.getLocation());
    let mut EmptySS: CXXScopeSpec = CXXScopeSpec {};
    let mut MemberOfUnknownSpecialization: bool = false;
    let mut TNK: TemplateNameKind = self.Actions.isTemplateName(self.getCurScope(), EmptySS, false, Name, null, false, Template, MemberOfUnknownSpecialization, false);
    if TNK == TNK_Undeclared_template || !Template {
        return TNK_Non_template;
    }
    return TNK;
}

fn Parser::AnnotatePackIndexingTemplateName(self, SS: *mut CXXScopeSpec, Name: *mut UnqualifiedId, Template: TemplateTy, TNK: TemplateNameKind) -> bool {
    assert!(self.Tok.is(identifier), "expected a simple-template-name");
    let mut NameLoc: SourceLocation = self.ConsumeToken();
    self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
    if T.consumeOpen() {
        return true;
    }
    let mut IndexExpr: ExprResult = self.ParseConstantExpression();
    if T.consumeClose() || !IndexExpr.isUsable() || Template.get().isNull() {
        return true;
    }
    let mut Indexed: TemplateName = self.Actions.ActOnPackIndexingTemplateName(Template.get(), NameLoc, IndexExpr.get());
    if Indexed.isNull() {
        TNK = TNK_Non_template;
    }
    Template = make(Indexed);
    if self.Tok.is(less) {
        return self.AnnotateTemplateIdToken(Template, TNK, SS, SourceLocation {}, Name, false, false);
    }
    if self.PP.isBacktrackEnabled() {
        self.PP.RevertCachedTokens(1);
    } else {
        self.PP.EnterToken(self.Tok, true);
    }
    if Indexed.isNull() || ((TNK == TNK_Type_template || TNK == TNK_Dependent_template_name) && self.getLangOpts().CPlusPlus17) {
        let mut Type: TypeResult = if Indexed.isNull() { TypeError() } else { self.Actions.ActOnPackIndexingDeducedTemplateSpecializationType(Indexed, NameLoc) };
        self.Tok.setKind(annot_typename);
        setTypeAnnotation(self.Tok, Type);
    } else {
        self.Tok.setKind(annot_template_id);
        self.Tok.setAnnotationValue(Create(SourceLocation {}, NameLoc, Name..Identifier, OO_None, Template, TNK, SourceLocation {}, SourceLocation {}, ArrayRef<ParsedTemplateArgument> {}, false, self.TemplateIds));
    }
    self.Tok.setLocation(NameLoc);
    self.Tok.setAnnotationEndLoc(T.getCloseLocation());
    self.PP.AnnotateCachedTokens(self.Tok);
    return Indexed.isNull();
}

fn Parser::AnnotateExistingIndexedTypeNamePack(self, T: ParsedType, StartLoc: SourceLocation, EndLoc: SourceLocation) {
    if self.PP.isBacktrackEnabled() {
        self.PP.RevertCachedTokens(1);
        if !T {
            EndLoc = self.PP.getLastCachedTokenLocation();
        }
    } else {
        self.PP.EnterToken(self.Tok, true);
    }
    self.Tok.setKind(annot_pack_indexing_type);
    setTypeAnnotation(self.Tok, T);
    self.Tok.setAnnotationEndLoc(EndLoc);
    self.Tok.setLocation(StartLoc);
    self.PP.AnnotateCachedTokens(self.Tok);
}

fn Parser::TypeTransformTokToDeclSpec(self) -> TST {
    match self.Tok.getKind() {
        kw___add_lvalue_reference => {
            return TST_add_lvalue_reference;
        },
        kw___add_pointer => {
            return TST_add_pointer;
        },
        kw___add_rvalue_reference => {
            return TST_add_rvalue_reference;
        },
        kw___decay => {
            return TST_decay;
        },
        kw___make_signed => {
            return TST_make_signed;
        },
        kw___make_unsigned => {
            return TST_make_unsigned;
        },
        kw___remove_all_extents => {
            return TST_remove_all_extents;
        },
        kw___remove_const => {
            return TST_remove_const;
        },
        kw___remove_cv => {
            return TST_remove_cv;
        },
        kw___remove_cvref => {
            return TST_remove_cvref;
        },
        kw___remove_extent => {
            return TST_remove_extent;
        },
        kw___remove_pointer => {
            return TST_remove_pointer;
        },
        kw___remove_reference_t => {
            return TST_remove_reference_t;
        },
        kw___remove_restrict => {
            return TST_remove_restrict;
        },
        kw___remove_volatile => {
            return TST_remove_volatile;
        },
        kw___underlying_type => {
            return TST_underlying_type;
        },
        _ => {
            llvm_unreachable_internal("passed in an unhandled type transformation built-in", "P:/Goraw/llvm-project/clang/lib/Parse/ParseDeclCXX.cpp", 1310);
        },
    }
}

fn Parser::MaybeParseTypeTransformTypeSpecifier(self, DS: *mut DeclSpec) -> bool {
    if !self.NextToken().is(l_paren) {
        self.Tok.setKind(identifier);
        return false;
    }
    let mut TypeTransformTST: TST = self.TypeTransformTokToDeclSpec();
    let mut StartLoc: SourceLocation = self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.expectAndConsume(err_expected_lparen_after, self.Tok.getName(), r_paren) {
        return true;
    }
    let mut Result: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
    if Result.isInvalid() {
        self.SkipUntil(r_paren, StopAtSemi);
        return true;
    }
    T.consumeClose();
    if T.getCloseLocation().isInvalid() {
        return true;
    }
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    if DS.SetTypeSpecType(TypeTransformTST, StartLoc, PrevSpec, DiagID, Result.get(), self.Actions.getASTContext().getPrintingPolicy()) {
        self.Diag(StartLoc, DiagID) << PrevSpec;
    }
    DS.setTypeArgumentRange(T.getRange());
    return true;
}

fn Parser::ParseBaseTypeSpecifier(self, BaseLoc: *mut SourceLocation, EndLocation: *mut SourceLocation) -> TypeResult {
    if self.Tok.is(kw_typename) {
        self.Diag(self.Tok, err_expected_class_name_not_template) << CreateRemoval(self.Tok.getLocation());
        self.ConsumeToken();
    }
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, false, false, false, false, false) {
        return true;
    }
    BaseLoc = self.Tok.getLocation();
    if self.Tok.isOneOf(kw_decltype, annot_decltype) {
        if SS.isNotEmpty() {
            self.Diag(SS.getBeginLoc(), err_unexpected_scope_on_base_decltype) << CreateRemoval(SS.getRange());
        }
        let mut DS: DeclSpec = self.AttrFactory;
        EndLocation = self.ParseDecltypeSpecifier(DS);
        let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
        return self.Actions.ActOnTypeName(DeclaratorInfo);
    }
    if self.Tok.is(annot_pack_indexing_type) {
        let mut DS: DeclSpec = self.AttrFactory;
        self.ParsePackIndexingType(DS);
        let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
        return self.Actions.ActOnTypeName(DeclaratorInfo);
    }
    if self.Tok.is(annot_template_id) {
        let mut TemplateId: *mut TemplateIdAnnotation = self.takeTemplateIdAnnotation(self.Tok);
        if TemplateId.mightBeType() {
            self.AnnotateTemplateIdTokenAsType(SS, No, true);
            assert!(self.Tok.is(annot_typename), "template-id -> type failed");
            let mut Type: TypeResult = getTypeAnnotation(self.Tok);
            EndLocation = self.Tok.getAnnotationEndLoc();
            self.ConsumeAnnotationToken();
            return Type;
        }
    }
    if self.Tok.isNot(identifier) {
        self.Diag(self.Tok, err_expected_class_name);
        return true;
    }
    let mut Id: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    let mut IdLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.is(less) {
        let mut TNK: TemplateNameKind = TNK_Non_template;
        let mut Template: TemplateTy = null;
        if !self.Actions.DiagnoseUnknownTemplateName(*Id, IdLoc, self.getCurScope(), &mut SS, Template, TNK) {
            self.Diag(IdLoc, err_unknown_template_name) << Id;
        }
        let mut TemplateName: UnqualifiedId = UnqualifiedId {};
        TemplateName.setIdentifier(Id, IdLoc);
        if self.AnnotateTemplateIdToken(Template, TNK, SS, SourceLocation {}, TemplateName, true, false) {
            return true;
        }
        if self.Tok.is(annot_template_id) && self.takeTemplateIdAnnotation(self.Tok).mightBeType() {
            self.AnnotateTemplateIdTokenAsType(SS, No, true);
        }
        if self.Tok.isNot(annot_typename) {
            return true;
        }
        EndLocation = self.Tok.getAnnotationEndLoc();
        let mut Type: TypeResult = getTypeAnnotation(self.Tok);
        self.ConsumeAnnotationToken();
        return Type;
    }
    let mut CorrectedII: *mut IdentifierInfo = null;
    let mut Type: ParsedType = self.Actions.getTypeName(*Id, IdLoc, self.getCurScope(), &mut SS, true, false, null, false, true, false, No, &mut CorrectedII);
    if !Type {
        self.Diag(IdLoc, err_expected_class_name);
        return true;
    }
    EndLocation = IdLoc;
    let mut DS: DeclSpec = self.AttrFactory;
    DS.SetRangeStart(IdLoc);
    DS.SetRangeEnd(EndLocation);
    DS.getTypeSpecScope() = move(SS);
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    DS.SetTypeSpecType(TST_typename, IdLoc, PrevSpec, DiagID, Type, self.Actions.getASTContext().getPrintingPolicy());
    let mut DeclaratorInfo: Declarator = Declarator { DS, none(), TypeName };
    return self.Actions.ActOnTypeName(DeclaratorInfo);
}

fn Parser::ParseMicrosoftInheritanceClassAttributes(self, attrs: *mut ParsedAttributes) {
    while self.Tok.isOneOf(kw___single_inheritance, kw___multiple_inheritance, kw___virtual_inheritance) {
        let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut Kind: TokenKind = self.Tok.getKind();
        let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
        attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, Kind, SourceLocation {});
    }
}

fn Parser::ParseNullabilityClassAttributes(self, attrs: *mut ParsedAttributes) {
    while self.Tok.is(kw__Nullable) {
        let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut Kind: TokenKind = self.Tok.getKind();
        let mut AttrNameLoc: SourceLocation = self.ConsumeToken();
        attrs.addNew(AttrName, AttrNameLoc, AttributeScopeInfo {}, null, 0, Kind, SourceLocation {});
    }
}

fn Parser::isValidAfterTypeSpecifier(self, CouldBeBitfield: bool) -> bool {
    match self.Tok.getKind() {
        _ => {
            if self.Tok.isRegularKeywordAttribute() {
                return true;
            }
        },
        semi => {
            star;
        },
        colon => {
            return CouldBeBitfield || self.ColonIsSacred || self.ParsingGenericAssociationType;
        },
        kw___cdecl => {
            kw___fastcall;
        },
        kw_const => {
            kw_volatile;
        },
        r_brace => {
            if !self.getLangOpts().CPlusPlus {
                return true;
            }
        },
        greater => {
            return self.getLangOpts().CPlusPlus;
        },
    }
    return false;
}

fn Parser::ParseClassSpecifier(self, TagTokKind: TokenKind, StartLoc: SourceLocation, DS: *mut DeclSpec, TemplateInfo: *mut ParsedTemplateInfo, AS: AccessSpecifier, EnteringContext: bool, DSC: DeclSpecContext, Attributes: *mut ParsedAttributes) {
    let mut TagType: TST = zeroed();
    if TagTokKind == kw_struct {
        TagType = TST_struct;
    } else if TagTokKind == kw___interface {
        TagType = TST_interface;
    } else if TagTokKind == kw_class {
        TagType = TST_class;
    } else {
        assert!(TagTokKind == kw_union, "Not a class specifier");
        TagType = TST_union;
    }
    if self.Tok.is(code_completion) {
        self.cutOffParsing();
        self.Actions.CodeCompletion().CodeCompleteTag(self.getCurScope(), TagType);
        return;
    }
    let mut shouldDelayDiagsInTag: bool = (TemplateInfo.Kind != NonTemplate);
    let mut diagsFromTag: SuppressAccessChecks = SuppressAccessChecks { *self, shouldDelayDiagsInTag };
    let mut attrs: ParsedAttributes = self.AttrFactory;
    for {
        self.MaybeParseAttributes(PAKM_CXX11 | PAKM_Declspec | PAKM_GNU, attrs, null);
        if self.Tok.isOneOf(kw___single_inheritance, kw___multiple_inheritance, kw___virtual_inheritance) {
            self.ParseMicrosoftInheritanceClassAttributes(attrs);
            continue;
        }
        if self.Tok.is(kw__Nullable) {
            self.ParseNullabilityClassAttributes(attrs);
            continue;
        }
        break;
    }
    let mut AttrFixitLoc: SourceLocation = self.Tok.getLocation();
    if TagType == TST_struct && self.Tok.isNot(identifier) && !self.Tok.isAnnotation() && self.Tok.getIdentifierInfo() && self.Tok.isOneOf(kw___add_lvalue_reference, kw___add_pointer, kw___add_rvalue_reference, kw___decay, kw___make_signed, kw___make_unsigned, kw___remove_all_extents, kw___remove_const, kw___remove_cv, kw___remove_cvref, kw___remove_extent, kw___remove_pointer, kw___remove_reference_t, kw___remove_restrict, kw___remove_volatile, kw___underlying_type, kw___is_abstract, kw___is_aggregate, kw___is_arithmetic, kw___is_array, kw___is_assignable, kw___is_base_of, kw___is_bounded_array, kw___is_class, kw___is_complete_type, kw___is_compound, kw___is_const, kw___is_constructible, kw___is_convertible, kw___is_convertible_to, kw___is_destructible, kw___is_empty, kw___is_enum, kw___is_floating_point, kw___is_final, kw___is_function, kw___is_fundamental, kw___is_integral, kw___is_interface_class, kw___is_literal, kw___is_lvalue_expr, kw___is_lvalue_reference, kw___is_member_function_pointer, kw___is_member_object_pointer, kw___is_member_pointer, kw___is_nothrow_assignable, kw___is_nothrow_constructible, kw___is_nothrow_convertible, kw___is_nothrow_destructible, kw___is_object, kw___is_pod, kw___is_pointer, kw___is_polymorphic, kw___is_reference, kw___is_rvalue_expr, kw___is_rvalue_reference, kw___is_same, kw___is_scalar, kw___is_scoped_enum, kw___is_sealed, kw___is_signed, kw___is_standard_layout, kw___is_trivial, kw___is_trivially_equality_comparable, kw___is_trivially_assignable, kw___is_trivially_constructible, kw___is_trivially_copyable, kw___is_unbounded_array, kw___is_union, kw___is_unsigned, kw___is_void, kw___is_volatile) {
