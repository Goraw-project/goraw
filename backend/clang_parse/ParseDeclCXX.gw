}

fn Parser::ParseBaseClause(self, ClassDecl: *mut Decl) {
    assert!(self.Tok.is(colon), "Not a base clause");
    self.ConsumeToken();
    let mut BaseInfo: SmallVector<CXXBaseSpecifier *, 8> = SmallVector<CXXBaseSpecifier *, 8> {};
    while true {
        let mut Result: BaseResult = self.ParseBaseSpecifier(ClassDecl);
        if !Result.isUsable() {
            self.SkipUntil(comma, l_brace, StopAtSemi | StopBeforeMatch);
        } else {
            BaseInfo.push(Result.get());
        }
        if !self.TryConsumeToken(comma) {
            break;
        }
    }
    self.Actions.ActOnBaseSpecifiers(ClassDecl, BaseInfo);
}

fn Parser::ParseBaseSpecifier(self, ClassDecl: *mut Decl) -> BaseResult {
    let mut IsVirtual: bool = false;
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut Attributes: ParsedAttributes = self.AttrFactory;
    self.MaybeParseCXX11Attributes(Attributes, false);
    if self.TryConsumeToken(kw_virtual) {
        IsVirtual = true;
    }
    self.CheckMisplacedCXX11Attribute(Attributes, StartLoc);
    let mut Access: AccessSpecifier = self.getAccessSpecifierIfPresent();
    if Access != AS_none {
        self.ConsumeToken();
        if self.getLangOpts().HLSL {
            self.Diag(self.Tok.getLocation(), ext_hlsl_access_specifiers);
        }
    }
    self.CheckMisplacedCXX11Attribute(Attributes, StartLoc);
    if self.Tok.is(kw_virtual) {
        let mut VirtualLoc: SourceLocation = self.ConsumeToken();
        if IsVirtual {
            self.Diag(VirtualLoc, err_dup_virtual) << CreateRemoval(VirtualLoc);
        }
        IsVirtual = true;
    }
    if self.getLangOpts().HLSL && IsVirtual {
        self.Diag(self.Tok.getLocation(), err_hlsl_virtual_inheritance);
    }
    self.CheckMisplacedCXX11Attribute(Attributes, StartLoc);
    if self.getLangOpts().MSVCCompat && self.Tok.is(kw__Atomic) && self.NextToken().is(less) {
        self.Tok.setKind(identifier);
    }
    let mut EndLocation: SourceLocation = SourceLocation {};
    let mut BaseLoc: SourceLocation = SourceLocation {};
    let mut BaseType: TypeResult = self.ParseBaseTypeSpecifier(BaseLoc, EndLocation);
    if BaseType.isInvalid() {
        return true;
    }
    let mut EllipsisLoc: SourceLocation = SourceLocation {};
    self.TryConsumeToken(ellipsis, EllipsisLoc);
    let mut Range: SourceRange = SourceRange { B: StartLoc, E: EndLocation };
    return self.Actions.ActOnBaseSpecifier(ClassDecl, Range, Attributes, IsVirtual, Access, BaseType.get(), BaseLoc, EllipsisLoc);
}

fn Parser::getAccessSpecifierIfPresent(self: *Parser) -> AccessSpecifier {
    match self.Tok.getKind() {
        _ => {
            return AS_none;
        },
        kw_private => {
            return AS_private;
        },
        kw_protected => {
            return AS_protected;
        },
        kw_public => {
            return AS_public;
        },
    }
}

fn Parser::HandleMemberFunctionDeclDelays(self, DeclaratorInfo: *mut Declarator, ThisDecl: *mut Decl) {
    let mut FTI: *mut FunctionTypeInfo = DeclaratorInfo.getFunctionTypeInfo();
    let mut NeedLateParse: bool = FTI.getExceptionSpecType() == EST_Unparsed;
    if !NeedLateParse {
        for let mut ParamIdx: u32 = 0; ParamIdx < FTI.NumParams; ParamIdx += 1 {
            let mut Param: *ParmVarDecl const = cast(FTI.Params[ParamIdx].Param);
            if Param.hasUnparsedDefaultArg() {
                NeedLateParse = true;
                break;
            }
        }
    }
    if NeedLateParse {
        let mut LateMethod: *mut LateParsedMethodDeclaration = LateParsedMethodDeclaration { self, ThisDecl };
        self.getCurrentClass().LateParsedDeclarations.push(LateMethod);
        LateMethod.DefaultArgs.reserve(FTI.NumParams);
        for let mut ParamIdx: u32 = 0; ParamIdx < FTI.NumParams; ParamIdx += 1 {
            LateMethod.DefaultArgs.push(LateParsedDefaultArgument { FTI.Params[ParamIdx].Param, move(FTI.Params[ParamIdx].DefaultArgTokens) });
        }
        if FTI.getExceptionSpecType() == EST_Unparsed {
            LateMethod.ExceptionSpecTokens = FTI..ExceptionSpecTokens;
            FTI..ExceptionSpecTokens = null;
        }
    }
}

fn Parser::isCXX11VirtSpecifier(self: *Parser, Tok: *Token) -> Specifier {
    if !self.getLangOpts().CPlusPlus || Tok.isNot(identifier) {
        return VS_None;
    }
    let mut II: *IdentifierInfo = Tok.getIdentifierInfo();
    if !self.Ident_final {
        self.Ident_final = &mut self.PP.getIdentifierTable().get("final");
        if self.getLangOpts().GNUKeywords {
            self.Ident_GNU_final = &mut self.PP.getIdentifierTable().get("__final");
        }
        if self.getLangOpts().MicrosoftExt {
            self.Ident_sealed = &mut self.PP.getIdentifierTable().get("sealed");
            self.Ident_abstract = &mut self.PP.getIdentifierTable().get("abstract");
        }
        self.Ident_override = &mut self.PP.getIdentifierTable().get("override");
    }
    if II == self.Ident_override {
        return VS_Override;
    }
    if II == self.Ident_sealed {
        return VS_Sealed;
    }
    if II == self.Ident_abstract {
        return VS_Abstract;
    }
    if II == self.Ident_final {
        return VS_Final;
    }
    if II == self.Ident_GNU_final {
        return VS_GNU_Final;
    }
    return VS_None;
}

fn Parser::ParseOptionalCXX11VirtSpecifierSeq(self, VS: *mut VirtSpecifiers, IsInterface: bool, FriendLoc: SourceLocation) {
    while true {
        let mut Specifier: Specifier = self.isCXX11VirtSpecifier();
        if Specifier == VS_None {
            return;
        }
        if FriendLoc.isValid() {
            self.Diag(self.Tok.getLocation(), err_friend_decl_spec) << getSpecifierName(Specifier) << CreateRemoval(self.Tok.getLocation()) << SourceRange { B: FriendLoc, E: FriendLoc };
            self.ConsumeToken();
            continue;
        }
        let mut PrevSpec: *u8 = null;
        if VS.SetSpecifier(Specifier, self.Tok.getLocation(), PrevSpec) {
            self.Diag(self.Tok.getLocation(), err_duplicate_virt_specifier) << PrevSpec << CreateRemoval(self.Tok.getLocation());
        }
        if IsInterface && (Specifier == VS_Final || Specifier == VS_Sealed) {
            self.Diag(self.Tok.getLocation(), err_override_control_interface) << getSpecifierName(Specifier);
        } else if Specifier == VS_Sealed {
            self.Diag(self.Tok.getLocation(), ext_ms_sealed_keyword);
        } else if Specifier == VS_Abstract {
            self.Diag(self.Tok.getLocation(), ext_ms_abstract_keyword);
        } else if Specifier == VS_GNU_Final {
            self.Diag(self.Tok.getLocation(), ext_warn_gnu_final);
        } else {
            self.DiagCompat(self.Tok.getLocation(), override_control_keyword) << getSpecifierName(Specifier);
        }
        self.ConsumeToken();
    }
}

fn Parser::isCXX11FinalKeyword(self: *Parser) -> bool {
    let mut Specifier: Specifier = self.isCXX11VirtSpecifier();
    return Specifier == VS_Final || Specifier == VS_GNU_Final || Specifier == VS_Sealed;
}

fn Parser::isClassCompatibleKeyword(self: *Parser, Tok: Token) -> bool {
    let mut Specifier: Specifier = self.isCXX11VirtSpecifier(Tok);
    return Specifier == VS_Final || Specifier == VS_GNU_Final || Specifier == VS_Sealed || Specifier == VS_Abstract;
}

fn Parser::isClassCompatibleKeyword(self: *Parser) -> bool {
    return self.isClassCompatibleKeyword(self.Tok);
}

fn Parser::ParseCXXMemberDeclaratorBeforeInitializer(self, DeclaratorInfo: *mut Declarator, VS: *mut VirtSpecifiers, BitfieldSize: *mut ExprResult, LateParsedAttrs: *mut LateParsedAttrList) -> bool {
    if self.Tok.isNot(colon) {
        self.ParseDeclarator(DeclaratorInfo);
    } else {
        DeclaratorInfo.SetIdentifier(null, self.Tok.getLocation());
    }
    let mut IsFunctionDeclarator: bool = DeclaratorInfo.isFunctionDeclarator();
    if !IsFunctionDeclarator && !self.getLangOpts().MSVCCompat {
        self.MaybeParseGNUAttributes(DeclaratorInfo, &mut LateParsedAttrs);
    }
    if self.getLangOpts().HLSL {
        self.MaybeParseHLSLAnnotations(DeclaratorInfo, null, true);
    }
    if !IsFunctionDeclarator && self.TryConsumeToken(colon) {
        assert!(DeclaratorInfo.isPastIdentifier(), "don't know where identifier would go yet?");
        BitfieldSize = self.ParseConstantExpression();
        if BitfieldSize.isInvalid() {
            self.SkipUntil(comma, StopAtSemi | StopBeforeMatch);
        }
    } else if self.Tok.is(kw_requires) {
        let mut CurTemplateDepthTracker: TemplateParameterDepthRAII = self.TemplateParameterDepth;
        if DeclaratorInfo.getTemplateParameterLists().is_empty() && DeclaratorInfo.getInventedTemplateParameterList() {
            operator(CurTemplateDepthTracker);
        }
        self.ParseTrailingRequiresClauseWithScope(DeclaratorInfo);
    } else {
        self.ParseOptionalCXX11VirtSpecifierSeq(VS, self.getCurrentClass().IsInterface, DeclaratorInfo.getDeclSpec().getFriendSpecLoc());
        if !VS.isUnset() {
            self.MaybeParseAndDiagnoseDeclSpecAfterCXX11VirtSpecifierSeq(DeclaratorInfo, VS);
        }
    }
    if self.Tok.is(kw_asm) {
        let mut Loc: SourceLocation = SourceLocation {};
        let mut AsmLabel: ExprResult = self.ParseSimpleAsm(true, &mut Loc);
        if AsmLabel.isInvalid() {
            self.SkipUntil(comma, StopAtSemi | StopBeforeMatch);
        }
        DeclaratorInfo.setAsmLabel(AsmLabel.get());
        DeclaratorInfo.SetRangeEnd(Loc);
    }
    self.DiagnoseAndSkipCXX11Attributes();
    self.MaybeParseGNUAttributes(DeclaratorInfo, &mut LateParsedAttrs);
    self.DiagnoseAndSkipCXX11Attributes();
    if BitfieldSize.isUnset() && VS.isUnset() {
        self.ParseOptionalCXX11VirtSpecifierSeq(VS, self.getCurrentClass().IsInterface, DeclaratorInfo.getDeclSpec().getFriendSpecLoc());
        if !VS.isUnset() {
            for AL in DeclaratorInfo.getAttributes() {
                if AL.isKnownToGCC() && !AL.isCXX11Attribute() {
                    self.Diag(AL.getLoc(), warn_gcc_attribute_location);
                }
            }
            self.MaybeParseAndDiagnoseDeclSpecAfterCXX11VirtSpecifierSeq(DeclaratorInfo, VS);
        }
    }
    if !DeclaratorInfo.hasName() && BitfieldSize.isUnset() {
        self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
        return true;
    }
    return false;
}

fn Parser::MaybeParseAndDiagnoseDeclSpecAfterCXX11VirtSpecifierSeq(self, D: *mut Declarator, VS: *mut VirtSpecifiers) {
    let mut DS: DeclSpec = self.AttrFactory;
    self.ParseTypeQualifierListOpt(DS, AR_NoAttributesParsed, false, false, function_ref<void ()> { Closure_2 { cap_0: self, DS: &mut DS, D: &mut D, VS: &mut VS }, null, null });
    D.ExtendWithDeclSpec(DS);
    if D.isFunctionDeclarator() {
        let mut Function: *mut FunctionTypeInfo = D.getFunctionTypeInfo();
        if DS.getTypeQualifiers() != TQ_unspecified {
            let mut DeclSpecCheck: Closure_3 = Closure_3 { Function: &mut Function, VS: &mut VS, cap_2: self };
            DS.forEachQualifier(function_ref<void (TQ, StringRef, SourceLocation)> { DeclSpecCheck, null, null });
        }
        let mut RefQualifierIsLValueRef: bool = true;
        let mut RefQualifierLoc: SourceLocation = SourceLocation {};
        if self.ParseRefQualifier(RefQualifierIsLValueRef, RefQualifierLoc) {
            let mut Name: *u8 = (if RefQualifierIsLValueRef { "& " } else { "&& " });
            let mut Insertion: FixItHint = CreateInsertion(VS.getFirstLocation(), Name, false);
            Function.RefQualifierIsLValueRef = RefQualifierIsLValueRef;
            Function.RefQualifierLoc = RefQualifierLoc;
            self.Diag(RefQualifierLoc, err_declspec_after_virtspec) << (if RefQualifierIsLValueRef { "&" } else { "&&" }) << getSpecifierName(VS.getLastSpecifier()) << CreateRemoval(RefQualifierLoc) << Insertion;
            D.SetRangeEnd(RefQualifierLoc);
        }
    }
}

fn Parser::ParseCXXClassMemberDeclaration(self, AS: AccessSpecifier, AccessAttrs: *mut ParsedAttributes, TemplateInfo: *mut ParsedTemplateInfo, TemplateDiags: *mut ParsingDeclRAIIObject) -> DeclGroupPtrTy {
    assert!(self.getLangOpts().CPlusPlus, "ParseCXXClassMemberDeclaration should only be called in C++ mode");
    if self.Tok.is(at) {
        if self.getLangOpts().ObjC && self.NextToken().isObjCAtKeyword(objc_defs) {
            self.Diag(self.Tok, err_at_defs_cxx);
        } else {
            self.Diag(self.Tok, err_at_in_class);
        }
        self.ConsumeToken();
        self.SkipUntil(r_brace, StopAtSemi);
        return null;
    }
    let mut X: ColonProtectionRAIIObject = ColonProtectionRAIIObject { P: *self, OldVal: true };
    let mut MalformedTypeSpec: bool = false;
    if TemplateInfo.Kind == NonTemplate && self.Tok.isOneOf(identifier, coloncolon, kw___super) {
        if self.TryAnnotateCXXScopeToken(false) {
            MalformedTypeSpec = true;
        }
        let mut isAccessDecl: bool = false;
        if self.Tok.isNot(annot_cxxscope) {
            isAccessDecl = false;
        } else if self.NextToken().is(identifier) {
            isAccessDecl = self.GetLookAheadToken(2).is(semi);
        } else {
            isAccessDecl = self.NextToken().is(kw_operator);
        }
        if isAccessDecl {
            let mut SS: CXXScopeSpec = CXXScopeSpec {};
            self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, false, false, false, false, false);
            if SS.isInvalid() {
                self.SkipUntil(semi, 0 as SkipUntilFlags);
                return null;
            }
            let mut TemplateKWLoc: SourceLocation = SourceLocation {};
            let mut Name: UnqualifiedId = UnqualifiedId {};
            if self.ParseUnqualifiedId(SS, null, false, false, true, true, false, &mut TemplateKWLoc, Name) {
                self.SkipUntil(semi, 0 as SkipUntilFlags);
                return null;
            }
            if self.ExpectAndConsume(semi, err_expected_after, "access declaration") {
                self.SkipUntil(semi, 0 as SkipUntilFlags);
                return null;
            }
            return make(self.Actions.ActOnUsingDeclaration(self.getCurScope(), AS, SourceLocation {}, SourceLocation {}, SS, Name, SourceLocation {}, ParsedAttributesView {}));
        }
    }
    if TemplateInfo.Kind == NonTemplate && self.Tok.isOneOf(kw_static_assert, kw__Static_assert) {
        let mut DeclEnd: SourceLocation = SourceLocation {};
        return make(self.ParseStaticAssertDeclaration(DeclEnd));
    }
    if self.Tok.is(kw_template) {
        assert!(!TemplateInfo.TemplateParams, "Nested template improperly parsed?");
        let mut ObjCDC: ObjCDeclContextSwitch = *self;
        let mut DeclEnd: SourceLocation = SourceLocation {};
        return self.ParseTemplateDeclarationOrSpecialization(Member, DeclEnd, AccessAttrs, AS);
    }
    if self.Tok.is(kw___extension__) {
        let mut O: ExtensionRAIIObject = self.Diags;
        self.ConsumeToken();
        return self.ParseCXXClassMemberDeclaration(AS, AccessAttrs, TemplateInfo, TemplateDiags);
    }
    let mut DeclAttrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseCXX11Attributes(DeclAttrs, false);
    if self.Tok.is(annot_attr_openmp) {
        return self.ParseOpenMPDeclarativeDirectiveWithExtDecl(AS, DeclAttrs, false, TST_unspecified, null);
    }
    if self.Tok.is(kw_using) {
        let mut UsingLoc: SourceLocation = self.ConsumeToken();
        while self.Tok.is(kw_template) {
            let mut TemplateLoc: SourceLocation = self.ConsumeToken();
            self.Diag(TemplateLoc, err_unexpected_template_after_using) << CreateRemoval(TemplateLoc);
        }
        if self.Tok.is(kw_namespace) {
            self.Diag(UsingLoc, err_using_namespace_in_class);
            self.SkipUntil(semi, StopBeforeMatch);
            return null;
        }
        let mut DeclEnd: SourceLocation = SourceLocation {};
        return self.ParseUsingDeclaration(Member, TemplateInfo, UsingLoc, DeclEnd, DeclAttrs, AS);
    }
    let mut DeclSpecAttrs: ParsedAttributes = self.AttrFactory;
    let mut CommonLateParsedAttrs: LateParsedAttrList = LateParsedAttrList { ParseSoon: false, LateAttrParseExperimentalExtOnly: false, LateAttrParseTypeAttrOnly: false };
    while self.MaybeParseCXX11Attributes(DeclAttrs, false) || self.MaybeParseGNUAttributes(DeclSpecAttrs, &mut CommonLateParsedAttrs) || self.MaybeParseMicrosoftAttributes(DeclSpecAttrs) {
        
    }
    let mut DeclStart: SourceLocation = SourceLocation {};
    if DeclAttrs.Range.isValid() {
        DeclStart = if DeclSpecAttrs.Range.isInvalid() { DeclAttrs.Range.getBegin() } else { if DeclAttrs.Range.getBegin() < DeclSpecAttrs.Range.getBegin() { DeclAttrs.Range.getBegin() } else { DeclSpecAttrs.Range.getBegin() } };
    } else {
        DeclStart = DeclSpecAttrs.Range.getBegin();
    }
    let mut DS: ParsingDeclSpec = ParsingDeclSpec { *self, TemplateDiags };
    DS.takeAttributesAppendingingFrom(DeclSpecAttrs);
    if MalformedTypeSpec {
        DS.SetTypeSpecError();
    }
    let mut IsTemplateSpecOrInst: bool = (TemplateInfo.Kind == ExplicitInstantiation || TemplateInfo.Kind == ExplicitSpecialization);
    let mut diagsFromTag: SuppressAccessChecks = SuppressAccessChecks { *self, IsTemplateSpecOrInst };
    self.ParseDeclarationSpecifiers(DS, TemplateInfo, AS, DSC_class, &mut CommonLateParsedAttrs);
    if IsTemplateSpecOrInst {
        diagsFromTag.done();
    }
    X.restore();
    if DeclStart.isValid() {
        DS.SetRangeStart(DeclStart);
    }
    if DS.hasTagDefinition() && TemplateInfo.Kind == NonTemplate && self.DiagnoseMissingSemiAfterTagDefinition(DS, AS, DSC_class, &mut CommonLateParsedAttrs) {
        return null;
    }
    let mut TemplateParams: MultiTemplateParamsArg = MultiTemplateParamsArg { if TemplateInfo.TemplateParams { TemplateInfo.TemplateParams.ptr } else { null }, if TemplateInfo.TemplateParams { TemplateInfo.TemplateParams.len } else { 0 } };
    if self.TryConsumeToken(semi) {
        if DS.isFriendSpecified() {
            self.ProhibitAttributes(DeclAttrs, SourceLocation {});
        }
        let mut AnonRecord: *mut RecordDecl = null;
        let mut TheDecl: *mut Decl = self.Actions.ParsedFreeStandingDeclSpec(self.getCurScope(), AS, DS, DeclAttrs, TemplateParams, false, AnonRecord, SourceLocation {});
        self.Actions.ActOnDefinedDeclarationSpecifier(TheDecl);
        DS.complete(TheDecl);
        if AnonRecord {
            let mut decls: [2]*mut Decl = [AnonRecord, TheDecl];
            return self.Actions.BuildDeclaratorGroup(decls);
        }
        return self.Actions.ConvertDeclToDeclGroup(TheDecl, null);
    }
    if DS.hasTagDefinition() {
        self.Actions.ActOnDefinedDeclarationSpecifier(DS.getRepAsDecl());
    }
    if DS.isFriendSpecifiedFirst() && self.Tok.isOneOf(comma, ellipsis) {
        self.DiagCompat(self.Tok.getLocation(), variadic_friends);
        let mut FriendLoc: SourceLocation = DS.getFriendSpecLoc();
        let mut Decls: SmallVector<Decl *> = SmallVector<Decl *> {};
        let mut ParsedFriendDecl: Closure_4 = Closure_4 { cap_0: self, AS: &mut AS, DeclAttrs: &mut DeclAttrs, TemplateParams: &mut TemplateParams, Decls: &mut Decls };
        if ParsedFriendDecl.call(DS) {
            return null;
        }
        while self.TryConsumeToken(comma) {
            let mut DeclSpec: ParsingDeclSpec = ParsingDeclSpec { *self, TemplateDiags };
            let mut PrevSpec: *u8 = null;
            let mut DiagId: u32 = 0;
            DeclSpec.SetFriendSpec(FriendLoc, PrevSpec, DiagId);
            self.ParseDeclarationSpecifiers(DeclSpec, TemplateInfo, AS, DSC_class, null);
            if ParsedFriendDecl.call(DeclSpec) {
                return null;
            }
        }
        self.ExpectAndConsume(semi, err_expected_semi_after_stmt, "friend declaration");
        return self.Actions.BuildDeclaratorGroup(Decls);
    }
    if self.Tok.is(kw_concept) {
        self.Diag(self.Tok.getLocation(), if DS.isFriendSpecified() || self.NextToken().is(kw_friend) { to_underlying(err_friend_concept) } else { to_underlying(err_concept_decls_may_only_appear_in_global_namespace_scope) });
        self.SkipUntil(semi, r_brace, StopBeforeMatch);
        return null;
    }
    let mut DeclaratorInfo: ParsingDeclarator = ParsingDeclarator { *self, DS, DeclAttrs, Member };
    if TemplateInfo.TemplateParams {
        DeclaratorInfo.setTemplateParameterLists(TemplateParams);
    }
    let mut VS: VirtSpecifiers = VirtSpecifiers {};
    let mut LateParsedAttrs: LateParsedAttrList = LateParsedAttrList { ParseSoon: false, LateAttrParseExperimentalExtOnly: false, LateAttrParseTypeAttrOnly: false };
    let mut EqualLoc: SourceLocation = SourceLocation {};
    let mut PureSpecLoc: SourceLocation = SourceLocation {};
    let mut TryConsumePureSpecifier: Closure_5 = Closure_5 { cap_0: self, EqualLoc: &mut EqualLoc, PureSpecLoc: &mut PureSpecLoc };
    let mut DeclsInGroup: SmallVector<Decl *, 8> = SmallVector<Decl *, 8> {};
    let mut BitfieldSize: ExprResult = false;
    let mut TrailingRequiresClause: ExprResult = false;
    let mut ExpectSemi: bool = true;
    let mut SAC: SuppressAccessChecks = SuppressAccessChecks { *self, IsTemplateSpecOrInst };
    if self.ParseCXXMemberDeclaratorBeforeInitializer(DeclaratorInfo, VS, BitfieldSize, LateParsedAttrs) {
        self.TryConsumeToken(semi);
        return null;
    }
    if IsTemplateSpecOrInst {
        SAC.done();
    }
    if BitfieldSize.isUnset() {
        if self.getLangOpts().MicrosoftExt && DeclaratorInfo.isDeclarationOfFunction() {
            TryConsumePureSpecifier.call(true);
        }
        let mut DefinitionKind: FunctionDefinitionKind = Declaration;
        if self.Tok.is(l_brace) && !self.getLangOpts().CPlusPlus11 {
            DefinitionKind = Definition;
        } else if DeclaratorInfo.isFunctionDeclarator() {
            if self.Tok.isOneOf(l_brace, colon, kw_try) {
                DefinitionKind = Definition;
            } else if self.Tok.is(equal) {
                let mut KW: *Token = self.NextToken();
                if KW.is(kw_default) {
                    DefinitionKind = Defaulted;
                } else if KW.is(kw_delete) {
                    DefinitionKind = Deleted;
                } else if KW.is(code_completion) {
                    self.cutOffParsing();
                    self.Actions.CodeCompletion().CodeCompleteAfterFunctionEquals(DeclaratorInfo);
                    return null;
                }
            }
        }
        DeclaratorInfo.setFunctionDefinitionKind(DefinitionKind);
        if DeclaratorInfo.isFunctionDeclarator() && DefinitionKind == Declaration && DS.isFriendSpecified() {
            self.ProhibitAttributes(DeclAttrs, SourceLocation {});
        }
        if DefinitionKind != Declaration {
            if !DeclaratorInfo.isFunctionDeclarator() {
                self.Diag(DeclaratorInfo.getIdentifierLoc(), err_func_def_no_params);
                self.ConsumeBrace();
                self.SkipUntil(r_brace, 0 as SkipUntilFlags);
                self.TryConsumeToken(semi);
                return null;
            }
            if DS.getStorageClassSpec() == SCS_typedef {
                self.Diag(DeclaratorInfo.getIdentifierLoc(), err_function_declared_typedef);
                DS.ClearStorageClassSpecs();
            }
            let mut FunDecl: *mut Decl = self.ParseCXXInlineMethodDef(AS, AccessAttrs, DeclaratorInfo, TemplateInfo, VS, PureSpecLoc);
            if FunDecl {
                for let mut i: u32 = 0;
let mut ni: u32 = CommonLateParsedAttrs.len; i < ni; i += 1 {
                    CommonLateParsedAttrs[i].addDecl(FunDecl);
                }
                for let mut i: u32 = 0;
let mut ni: u32 = LateParsedAttrs.len; i < ni; i += 1 {
                    LateParsedAttrs[i].addDecl(FunDecl);
                }
            }
            LateParsedAttrs.clear();
            if self.Tok.is(semi) {
                self.ConsumeExtraSemi(AfterMemberFunctionDefinition, TST_unspecified);
            }
            return make(FunDecl);
        }
    }
    while true {
        let mut HasInClassInit: InClassInitStyle = ICIS_NoInit;
        let mut HasStaticInitializer: bool = false;
        if self.Tok.isOneOf(equal, l_brace) && PureSpecLoc.isInvalid() {
            if BitfieldSize.isUsable() && !DeclaratorInfo.hasName() {
                self.Diag(self.Tok, err_anon_bitfield_member_init);
                self.SkipUntil(comma, StopAtSemi | StopBeforeMatch);
            } else if DeclaratorInfo.isDeclarationOfFunction() {
                if !TryConsumePureSpecifier.call(false) {
                    HasStaticInitializer = true;
                }
            } else if DeclaratorInfo.getDeclSpec().getStorageClassSpec() != SCS_static && DeclaratorInfo.getDeclSpec().getStorageClassSpec() != SCS_typedef && !DS.isFriendSpecified() && TemplateInfo.Kind == NonTemplate {
                if BitfieldSize.get() {
                    self.DiagCompat(self.Tok, bitfield_member_init);
                }
                HasInClassInit = if self.Tok.is(equal) { ICIS_CopyInit } else { ICIS_ListInit };
            } else {
                HasStaticInitializer = true;
            }
        }
        let mut ThisDecl: *mut NamedDecl = null;
        if DS.isFriendSpecified() {
            for AL in DeclaratorInfo.getAttributes() {
                if AL.isCXX11Attribute() || AL.isRegularKeywordAttribute() {
                    let mut Loc: SourceLocation = AL.getRange().getBegin();
                    (if AL.isRegularKeywordAttribute() { self.Diag(Loc, err_keyword_not_allowed) << AL } else { self.Diag(Loc, err_attributes_not_allowed) }) << AL.getRange();
                }
            }
            ThisDecl = self.Actions.ActOnFriendFunctionDecl(self.getCurScope(), DeclaratorInfo, TemplateParams);
        } else {
            ThisDecl = self.Actions.ActOnCXXMemberDeclarator(self.getCurScope(), AS, DeclaratorInfo, TemplateParams, BitfieldSize.get(), VS, HasInClassInit);
            if if ThisDecl { dyn_cast(ThisDecl) } else { null } {
                VT;
            } else {
                ThisDecl = VT.getTemplatedDecl();
            }
            if ThisDecl {
                self.Actions.ProcessDeclAttributeList(self.getCurScope(), ThisDecl, AccessAttrs, ProcessDeclAttributeOptions {});
            }
        }
        if HasInClassInit != ICIS_NoInit && DeclaratorInfo.getDeclSpec().getStorageClassSpec() == SCS_static {
            HasInClassInit = ICIS_NoInit;
            HasStaticInitializer = true;
        }
        if PureSpecLoc.isValid() && VS.getAbstractLoc().isValid() {
            self.Diag(PureSpecLoc, err_duplicate_virt_specifier) << "abstract";
        }
        if ThisDecl && PureSpecLoc.isValid() {
            self.Actions.ActOnPureSpecifier(ThisDecl, PureSpecLoc);
        } else if ThisDecl && VS.getAbstractLoc().isValid() {
            self.Actions.ActOnPureSpecifier(ThisDecl, VS.getAbstractLoc());
        }
        if HasInClassInit != ICIS_NoInit {
            self.DiagCompat(self.Tok, nonstatic_member_init);
            if DeclaratorInfo.isArrayOfUnknownBound() {
                self.Diag(self.Tok, err_incomplete_array_member_init);
                self.SkipUntil(comma, StopAtSemi | StopBeforeMatch);
                if ThisDecl {
                    ThisDecl.setInvalidDecl(true);
                }
            } else {
                self.ParseCXXNonStaticMemberInitializer(ThisDecl);
            }
        } else if HasStaticInitializer {
            let mut Init: ExprResult = self.ParseCXXMemberInitializer(ThisDecl, DeclaratorInfo.isDeclarationOfFunction(), EqualLoc);
            if Init.isInvalid() {
                if ThisDecl {
                    self.Actions.ActOnUninitializedDecl(ThisDecl);
                }
                self.SkipUntil(comma, StopAtSemi | StopBeforeMatch);
            } else if ThisDecl {
                self.Actions.AddInitializerToDecl(ThisDecl, Init.get(), EqualLoc.isInvalid());
            }
        } else if ThisDecl && DeclaratorInfo.isStaticMember() {
            self.Actions.ActOnUninitializedDecl(ThisDecl);
        }
        if ThisDecl {
            if !ThisDecl.isInvalidDecl() {
                for let mut i: u32 = 0;
let mut ni: u32 = CommonLateParsedAttrs.len; i < ni; i += 1 {
                    CommonLateParsedAttrs[i].addDecl(ThisDecl);
                }
                for let mut i: u32 = 0;
let mut ni: u32 = LateParsedAttrs.len; i < ni; i += 1 {
                    LateParsedAttrs[i].addDecl(ThisDecl);
                }
            }
            self.Actions.FinalizeDeclaration(ThisDecl);
            DeclsInGroup.push(ThisDecl);
            if DeclaratorInfo.isFunctionDeclarator() && DeclaratorInfo.getDeclSpec().getStorageClassSpec() != SCS_typedef {
                self.HandleMemberFunctionDeclDelays(DeclaratorInfo, ThisDecl);
            }
        }
        LateParsedAttrs.clear();
        DeclaratorInfo.complete(ThisDecl);
        let mut CommaLoc: SourceLocation = SourceLocation {};
        if !self.TryConsumeToken(comma, CommaLoc) {
            break;
        }
        if self.Tok.isAtStartOfLine() && !self.MightBeDeclarator(Member) {
            self.Diag(CommaLoc, err_expected_semi_declaration) << CreateReplacement(CommaLoc, ";");
            ExpectSemi = false;
            break;
        }
        if TemplateInfo.Kind != NonTemplate && DeclaratorInfo.isFirstDeclarator() {
            self.Diag(CommaLoc, err_multiple_template_declarators) << TemplateInfo.Kind;
        }
        DeclaratorInfo.clear();
        VS.clear();
        BitfieldSize = false;
        EqualLoc = PureSpecLoc = SourceLocation {};
        DeclaratorInfo.setCommaLoc(CommaLoc);
        self.DiagnoseAndSkipCXX11Attributes();
        self.MaybeParseGNUAttributes(DeclaratorInfo, null);
        self.DiagnoseAndSkipCXX11Attributes();
        if self.ParseCXXMemberDeclaratorBeforeInitializer(DeclaratorInfo, VS, BitfieldSize, LateParsedAttrs) {
            break;
        }
    }
    if ExpectSemi && self.ExpectAndConsume(semi, err_expected_semi_decl_list, "") && !self.isLikelyAtStartOfNewDeclaration() {
        self.SkipUntil(r_brace, StopAtSemi | StopBeforeMatch);
        self.TryConsumeToken(semi);
        return null;
    }
    return self.Actions.FinalizeDeclaratorGroup(self.getCurScope(), DS, DeclsInGroup);
}

fn Parser::ParseCXXMemberInitializer(self, D: *mut Decl, IsFunction: bool, EqualLoc: *mut SourceLocation) -> ExprResult {
    assert!(self.Tok.isOneOf(equal, l_brace), "Data member initializer not starting with '=' or '{'");
    let mut IsFieldInitialization: bool = isa_and_present(D);
    let mut Context: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, if IsFieldInitialization { PotentiallyEvaluatedIfUsed } else { PotentiallyEvaluated }, D, EK_Other, true };
    self.Actions.ExprEvalContexts.back().InImmediateEscalatingFunctionContext = IsFieldInitialization;
    if self.TryConsumeToken(equal, EqualLoc) {
        if self.Tok.is(kw_delete) {
            let mut Next: *Token = self.NextToken();
            if IsFunction || Next.isOneOf(semi, comma, eof) {
                if IsFunction {
                    self.Diag(self.ConsumeToken(), err_default_delete_in_multiple_declaration) << 1;
                } else {
                    self.Diag(self.ConsumeToken(), err_deleted_non_function);
                }
                self.SkipDeletedFunctionBody();
                return ExprError();
            }
        } else if self.Tok.is(kw_default) {
            if IsFunction {
                self.Diag(self.Tok, err_default_delete_in_multiple_declaration) << 0;
            } else {
                self.Diag(self.ConsumeToken(), err_default_special_members) << self.getLangOpts().CPlusPlus20;
            }
            return ExprError();
        }
    }
    if dyn_cast_or_null(D) {
        PD;
    } else {
        self.Diag(self.Tok, err_ms_property_initializer) << PD;
        return ExprError();
    }
    return self.ParseInitializer(D);
}

fn Parser::SkipCXXMemberSpecification(self, RecordLoc: SourceLocation, AttrFixitLoc: SourceLocation, TagType: u32, TagDecl: *mut Decl) {
    while self.isClassCompatibleKeyword() {
        self.ConsumeToken();
    }
    let mut Attrs: ParsedAttributes = self.AttrFactory;
    self.CheckMisplacedCXX11Attribute(Attrs, AttrFixitLoc);
    if self.Tok.isNot(colon) && self.Tok.isNot(l_brace) {
        return;
    }
    if self.Tok.is(colon) {
        let mut ClassScope: ParseScope = ParseScope { self, ClassScope | DeclScope, true, false };
        let mut ParsingDef: ParsingClassDefinition = ParsingClassDefinition { *self, TagDecl, true, TagType == TST_interface };
        let mut OldContext: SkippedDefinitionContext = self.Actions.ActOnTagStartSkippedDefinition(self.getCurScope(), TagDecl);
        self.ParseBaseClause(null);
        self.Actions.ActOnTagFinishSkippedDefinition(OldContext);
        if !self.Tok.is(l_brace) {
            self.Diag(self.PP.getLocForEndOfToken(self.PrevTokLocation, 0), err_expected_lbrace_after_base_specifiers);
            return;
        }
    }
    assert!(self.Tok.is(l_brace);
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    T.consumeOpen();
    T.skipToEnd();
    if self.Tok.is(kw___attribute) {
        let mut Attrs: ParsedAttributes = self.AttrFactory;
        self.MaybeParseGNUAttributes(Attrs, null);
    }
}

fn Parser::ParseCXXClassMemberDeclarationWithPragmas(self, AS: *mut AccessSpecifier, AccessAttrs: *mut ParsedAttributes, TagType: TST, TagDecl: *mut Decl) -> DeclGroupPtrTy {
    let mut BalancerRAIIObj: ParenBraceBracketBalancer = *self;
    match self.Tok.getKind() {
        kw___if_exists => {
            kw___if_not_exists;
        },
        semi => {
            self.ConsumeExtraSemi(InsideStruct, TagType);
        },
        annot_pragma_vis => {
            self.HandlePragmaVisibility();
        },
        annot_pragma_pack => {
            self.HandlePragmaPack();
        },
        annot_pragma_align => {
            self.HandlePragmaAlign();
        },
        annot_pragma_ms_pointers_to_members => {
            self.HandlePragmaMSPointersToMembers();
        },
        annot_pragma_ms_pragma => {
            self.HandlePragmaMSPragma();
        },
        annot_pragma_ms_vtordisp => {
            self.HandlePragmaMSVtorDisp();
        },
        annot_pragma_export => {
            self.HandlePragmaExport();
        },
        annot_pragma_dump => {
            self.HandlePragmaDump();
        },
        kw_namespace => {
            self.DiagnoseUnexpectedNamespace(cast(TagDecl));
        },
        kw_private => {
            if self.getLangOpts().OpenCL && !self.NextToken().is(colon) {
                let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
                return self.ParseCXXClassMemberDeclaration(AS, AccessAttrs, TemplateInfo, null);
            }
        },
        kw_public => {
            kw_protected;
        },
        annot_attr_openmp => {
            annot_pragma_openmp;
        },
        annot_pragma_openacc => {
            return self.ParseOpenACCDirectiveDecl(AS, AccessAttrs, TagType, TagDecl);
        },
        _ => {
            if isPragmaAnnotation(self.Tok.getKind()) {
                self.Diag(self.Tok.getLocation(), err_pragma_misplaced_in_decl) << getSpecifierName(TagType, self.Actions.getASTContext().getPrintingPolicy());
                self.ConsumeAnnotationToken();
                return null;
            }
        },
    }
}

fn Parser::ParseCXXMemberSpecification(self, RecordLoc: SourceLocation, AttrFixitLoc: SourceLocation, Attrs: *mut ParsedAttributes, TagType: u32, TagDecl: *mut Decl) {
    assert!((TagType == TST_struct || TagType == TST_interface || TagType == TST_union || TagType == TST_class), "Invalid TagType!");
    let mut TimeScope: TimeTraceScope = TimeTraceScope { "ParseClass", string ()> { Closure_6 { TagDecl: &mut TagDecl }, null, null } };
    let mut CrashInfo: PrettyDeclStackTraceEntry = PrettyDeclStackTraceEntry { self.Actions.Context, TagDecl, RecordLoc, "parsing struct/union/class body" };
    let mut NonNestedClass: bool = true;
    if !self.ClassStack.is_empty() {
        for let mut S: *Scope = self.getCurScope(); S; S = S.getParent() {
            if S.isClassScope() {
                NonNestedClass = false;
                if self.getCurrentClass().IsInterface {
                    self.Diag(RecordLoc, err_invalid_member_in_interface) << 6 << (if isa(TagDecl) { cast(TagDecl).getQualifiedNameAsString() } else { "(anonymous)" });
                }
                break;
            }
            if S.isFunctionScope() {
                break;
            }
        }
    }
    let mut ClassScope: ParseScope = ParseScope { self, ClassScope | DeclScope, true, false };
    let mut ParsingDef: ParsingClassDefinition = ParsingClassDefinition { *self, TagDecl, NonNestedClass, TagType == TST_interface };
    if TagDecl {
        self.Actions.ActOnTagStartDefinition(self.getCurScope(), TagDecl);
    }
    let mut FinalLoc: SourceLocation = SourceLocation {};
    let mut AbstractLoc: SourceLocation = SourceLocation {};
    let mut IsFinalSpelledSealed: bool = false;
    let mut IsAbstract: bool = false;
    if self.getLangOpts().CPlusPlus && self.Tok.is(identifier) {
        while true {
            let mut Specifier: Specifier = self.isCXX11VirtSpecifier(self.Tok);
            if Specifier == VS_None {
                break;
            }
            if self.isCXX11FinalKeyword() {
                if FinalLoc.isValid() {
                    let mut Skipped: SourceLocation = self.ConsumeToken();
                    self.Diag(Skipped, err_duplicate_class_virt_specifier) << getSpecifierName(Specifier);
                } else {
                    FinalLoc = self.ConsumeToken();
                    if Specifier == VS_Sealed {
                        IsFinalSpelledSealed = true;
                    }
                }
            } else {
                if AbstractLoc.isValid() {
                    let mut Skipped: SourceLocation = self.ConsumeToken();
                    self.Diag(Skipped, err_duplicate_class_virt_specifier) << getSpecifierName(Specifier);
                } else {
                    AbstractLoc = self.ConsumeToken();
                    IsAbstract = true;
                }
            }
            if TagType == TST_interface {
                self.Diag(FinalLoc, err_override_control_interface) << getSpecifierName(Specifier);
            } else if Specifier == VS_Final {
                self.DiagCompat(FinalLoc, override_control_keyword) << getSpecifierName(Specifier);
            } else if Specifier == VS_Sealed {
                self.Diag(FinalLoc, ext_ms_sealed_keyword);
            } else if Specifier == VS_Abstract {
                self.Diag(AbstractLoc, ext_ms_abstract_keyword);
            } else if Specifier == VS_GNU_Final {
                self.Diag(FinalLoc, ext_warn_gnu_final);
            }
        }
        assert!((FinalLoc.isValid() || AbstractLoc.isValid()), "not a class definition");
        self.CheckMisplacedCXX11Attribute(Attrs, AttrFixitLoc);
        if !self.Tok.is(colon) && !self.Tok.is(l_brace) {
            if TagDecl {
                self.Actions.ActOnTagDefinitionError(self.getCurScope(), TagDecl);
            }
            return;
        }
    }
    if self.Tok.is(colon) {
        let mut InheritanceScope: ParseScope = ParseScope { self, self.getCurScope().getFlags() | ClassInheritanceScope, true, false };
        self.ParseBaseClause(TagDecl);
        if !self.Tok.is(l_brace) {
            let mut SuggestFixIt: bool = false;
            let mut BraceLoc: SourceLocation = self.PP.getLocForEndOfToken(self.PrevTokLocation, 0);
            if self.Tok.isAtStartOfLine() {
                match self.Tok.getKind() {
                    kw_private => {
                        kw_protected;
                    },
                    kw_static_assert => {
                        r_brace;
                    },
                    identifier => {
                        SuggestFixIt = self.isConstructorDeclarator(true, false, No, null);
                    },
                    _ => {
                        SuggestFixIt = self.isCXXSimpleDeclaration(false);
                    },
                }
            }
            let mut LBraceDiag: DiagnosticBuilder = self.Diag(BraceLoc, err_expected_lbrace_after_base_specifiers);
            if SuggestFixIt {
                LBraceDiag << CreateInsertion(BraceLoc, " {", false);
                self.PP.EnterToken(self.Tok, true);
                self.Tok.setKind(l_brace);
            } else {
                if TagDecl {
                    self.Actions.ActOnTagDefinitionError(self.getCurScope(), TagDecl);
                }
                return;
            }
        }
    }
    assert!(self.Tok.is(l_brace);
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    T.consumeOpen();
    if TagDecl {
        self.Actions.ActOnStartCXXMemberDeclarations(self.getCurScope(), TagDecl, FinalLoc, IsFinalSpelledSealed, IsAbstract, T.getOpenLocation());
    }
    let mut CurAS: AccessSpecifier = zeroed();
    if TagType == TST_class && !self.getLangOpts().HLSL {
        CurAS = AS_private;
    } else {
        CurAS = AS_public;
    }
    let mut AccessAttrs: ParsedAttributes = self.AttrFactory;
    if TagDecl {
        while !self.tryParseMisplacedModuleImport() && self.Tok.isNot(r_brace) && self.Tok.isNot(eof) {
            self.ParseCXXClassMemberDeclarationWithPragmas(CurAS, AccessAttrs, TagType as TST, TagDecl);
            self.MaybeDestroyTemplateIds();
        }
        T.consumeClose();
    } else {
        self.SkipUntil(r_brace, 0 as SkipUntilFlags);
    }
    let mut attrs: ParsedAttributes = self.AttrFactory;
    self.MaybeParseGNUAttributes(attrs, null);
    if TagDecl {
        self.Actions.ActOnFinishCXXMemberSpecification(self.getCurScope(), RecordLoc, TagDecl, T.getOpenLocation(), T.getCloseLocation(), attrs);
    }
    if TagDecl && NonNestedClass {
        let mut SavedPrevTokLocation: SourceLocation = self.PrevTokLocation;
        self.ParseLexedPragmas(self.getCurrentClass());
        self.ParseLexedAttributes(self.getCurrentClass());
        self.ParseLexedMethodDeclarations(self.getCurrentClass());
        self.Actions.ActOnFinishCXXMemberDecls();
        self.ParseLexedMemberInitializers(self.getCurrentClass());
        self.ParseLexedMethodDefs(self.getCurrentClass());
        self.PrevTokLocation = SavedPrevTokLocation;
        self.Actions.ActOnFinishCXXNonNestedClass();
    }
    if TagDecl {
        self.Actions.ActOnTagFinishDefinition(self.getCurScope(), TagDecl, T.getRange());
    }
    ParsingDef.Pop();
    ClassScope.Exit();
}

fn Parser::DiagnoseUnexpectedNamespace(self, D: *mut NamedDecl) {
    assert!(self.Tok.is(kw_namespace);
    self.Diag(D.getLocation(), err_missing_end_of_definition) << D;
    self.Diag(self.Tok.getLocation(), note_missing_end_of_definition_before) << D;
    self.PP.EnterToken(self.Tok, true);
    self.Tok.startToken();
    self.Tok.setLocation(self.PP.getLocForEndOfToken(self.PrevTokLocation, 0));
    self.Tok.setKind(semi);
    self.PP.EnterToken(self.Tok, true);
    self.Tok.setKind(r_brace);
}

fn Parser::ParseConstructorInitializer(self, ConstructorDecl: *mut Decl) {
    assert!(self.Tok.is(colon), "Constructor initializer always starts with ':'");
    let mut PoisonSEHIdentifiers: PoisonSEHIdentifiersRAIIObject = PoisonSEHIdentifiersRAIIObject { *self, true };
    let mut ColonLoc: SourceLocation = self.ConsumeToken();
    let mut MemInitializers: SmallVector<CXXCtorInitializer *, 4> = SmallVector<CXXCtorInitializer *, 4> {};
    let mut AnyErrors: bool = false;
    while true {
        {
        if self.Tok.is(code_completion) {
            self.cutOffParsing();
            self.Actions.CodeCompletion().CodeCompleteConstructorInitializer(ConstructorDecl, MemInitializers);
            return;
        }
        let mut MemInit: MemInitResult = self.ParseMemInitializer(ConstructorDecl);
        if !MemInit.isInvalid() {
            MemInitializers.push(MemInit.get());
        } else {
            AnyErrors = true;
        }
        if self.Tok.is(comma) {
            self.ConsumeToken();
        } else if self.Tok.is(l_brace) {
            break;
        } else if !MemInit.isInvalid() && self.Tok.isOneOf(identifier, coloncolon) {
            let mut Loc: SourceLocation = self.PP.getLocForEndOfToken(self.PrevTokLocation, 0);
            self.Diag(Loc, err_ctor_init_missing_comma) << CreateInsertion(Loc, ", ", false);
        } else {
            if !MemInit.isInvalid() {
                self.Diag(self.Tok.getLocation(), err_expected_either) << l_brace << comma;
            }
            self.SkipUntil(l_brace, StopAtSemi | StopBeforeMatch);
            break;
        }
    }
        if !(true) { break; }
    }
    self.Actions.ActOnMemInitializers(ConstructorDecl, ColonLoc, MemInitializers, AnyErrors);
}

fn Parser::ParseMemInitializer(self, ConstructorDecl: *mut Decl) -> MemInitResult {
    let mut SS: CXXScopeSpec = CXXScopeSpec {};
    if self.ParseOptionalCXXScopeSpecifier(SS, null, false, false, null, false, null, false, false, false, false, false) {
        return true;
    }
    let mut II: *mut IdentifierInfo = null;
    let mut IdLoc: SourceLocation = self.Tok.getLocation();
    let mut DS: DeclSpec = self.AttrFactory;
    let mut TemplateTypeTy: TypeResult = false;
    if self.Tok.is(identifier) {
        II = self.Tok.getIdentifierInfo();
        self.ConsumeToken();
    } else if self.Tok.is(annot_decltype) {
        self.ParseDecltypeSpecifier(DS);
    } else if self.Tok.is(annot_pack_indexing_type) {
        self.ParsePackIndexingType(DS);
    } else {
        let mut TemplateId: *mut TemplateIdAnnotation = if self.Tok.is(annot_template_id) { self.takeTemplateIdAnnotation(self.Tok) } else { null };
        if TemplateId && TemplateId.mightBeType() {
            self.AnnotateTemplateIdTokenAsType(SS, No, true);
            assert!(self.Tok.is(annot_typename), "template-id -> type failed");
            TemplateTypeTy = getTypeAnnotation(self.Tok);
            self.ConsumeAnnotationToken();
        } else {
            self.Diag(self.Tok, err_expected_member_or_base_name);
            return true;
        }
    }
    if self.getLangOpts().CPlusPlus11 && self.Tok.is(l_brace) {
        self.Diag(self.Tok, compat_cxx11_generalized_initializer_lists);
        let mut InitList: ExprResult = self.ParseBraceInitializer();
        if InitList.isInvalid() {
            return true;
        }
        let mut EllipsisLoc: SourceLocation = SourceLocation {};
        self.TryConsumeToken(ellipsis, EllipsisLoc);
        if TemplateTypeTy.isInvalid() {
            return true;
        }
        return self.Actions.ActOnMemInitializer(ConstructorDecl, self.getCurScope(), SS, II, TemplateTypeTy.get(), DS, IdLoc, InitList.get(), EllipsisLoc);
    } else if self.Tok.is(l_paren) {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        let mut ArgExprs: ExprVector = ExprVector {};
        let mut RunSignatureHelp: Closure_7 = Closure_7 { TemplateTypeTy: &mut TemplateTypeTy, cap_1: self, ConstructorDecl: &mut ConstructorDecl, SS: &mut SS, ArgExprs: &mut ArgExprs, II: &mut II, T: &mut T };
        if self.Tok.isNot(r_paren) && self.ParseExpressionList(ArgExprs, function_ref<void ()> { Closure_8 { cap_0: self, RunSignatureHelp: &mut RunSignatureHelp }, null, null }, false, false) {
            if self.PP.isCodeCompletionReached() && !self.CalledSignatureHelp {
                RunSignatureHelp.call();
            }
            self.SkipUntil(r_paren, StopAtSemi);
            return true;
        }
        T.consumeClose();
        let mut EllipsisLoc: SourceLocation = SourceLocation {};
        self.TryConsumeToken(ellipsis, EllipsisLoc);
        if TemplateTypeTy.isInvalid() {
            return true;
        }
        return self.Actions.ActOnMemInitializer(ConstructorDecl, self.getCurScope(), SS, II, TemplateTypeTy.get(), DS, IdLoc, T.getOpenLocation(), ArgExprs, T.getCloseLocation(), EllipsisLoc);
    }
    if TemplateTypeTy.isInvalid() {
        return true;
    }
    if self.getLangOpts().CPlusPlus11 {
        return self.Diag(self.Tok, err_expected_either) << l_paren << l_brace;
    } else {
        return self.Diag(self.Tok, err_expected) << l_paren;
    }
}

fn Parser::tryParseExceptionSpecification(self, Delayed: bool, SpecificationRange: *mut SourceRange, DynamicExceptions: *mut SmallVectorImpl<ParsedType>, DynamicExceptionRanges: *mut SmallVectorImpl<SourceRange>, NoexceptExpr: *mut ExprResult, ExceptionSpecTokens: *mut *mut CachedTokens) -> ExceptionSpecificationType {
    let mut Result: ExceptionSpecificationType = EST_None;
    ExceptionSpecTokens = null;
    if Delayed {
        if self.Tok.isNot(kw_throw) && self.Tok.isNot(kw_noexcept) {
            return EST_None;
        }
        let mut IsNoexcept: bool = self.Tok.is(kw_noexcept);
        let mut StartTok: Token = self.Tok;
        SpecificationRange = self.ConsumeToken();
        if !self.Tok.is(l_paren) {
            if IsNoexcept {
                self.Diag(self.Tok, warn_cxx98_compat_noexcept_decl);
                NoexceptExpr = null;
                return EST_BasicNoexcept;
            }
            self.Diag(self.Tok, err_expected_lparen_after) << "throw";
            return EST_DynamicNone;
        }
        ExceptionSpecTokens = CachedTokens {};
        ExceptionSpecTokens.push(StartTok);
        ExceptionSpecTokens.push(self.Tok);
        SpecificationRange.setEnd(self.ConsumeParen());
        self.ConsumeAndStoreUntil(r_paren, *ExceptionSpecTokens, true, true);
        SpecificationRange.setEnd(ExceptionSpecTokens.back().getLocation());
        return EST_Unparsed;
    }
    if self.Tok.is(kw_throw) {
        Result = self.ParseDynamicExceptionSpecification(SpecificationRange, DynamicExceptions, DynamicExceptionRanges);
        assert!(DynamicExceptions.len == DynamicExceptionRanges.len, "Produced different number of exception types and ranges.");
    }
    if self.Tok.isNot(kw_noexcept) {
        return Result;
    }
    self.Diag(self.Tok, warn_cxx98_compat_noexcept_decl);
    let mut NoexceptRange: SourceRange = SourceRange {};
    let mut NoexceptType: ExceptionSpecificationType = EST_None;
    let mut KeywordLoc: SourceLocation = self.ConsumeToken();
    if self.Tok.is(l_paren) {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
        T.consumeOpen();
        let mut ConstantEvaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, ConstantEvaluated, null, EK_Other, true };
        NoexceptExpr = self.ParseConstantExpressionInExprEvalContext(AllowNonTypes);
        T.consumeClose();
        if !NoexceptExpr.isInvalid() {
            NoexceptExpr = self.Actions.ActOnNoexceptSpec(NoexceptExpr.get(), NoexceptType);
            NoexceptRange = SourceRange { B: KeywordLoc, E: T.getCloseLocation() };
        } else {
            NoexceptType = EST_BasicNoexcept;
        }
    } else {
        NoexceptType = EST_BasicNoexcept;
        NoexceptRange = SourceRange { B: KeywordLoc, E: KeywordLoc };
    }
    if Result == EST_None {
        SpecificationRange = NoexceptRange;
        Result = NoexceptType;
        if self.Tok.is(kw_throw) {
            self.Diag(self.Tok.getLocation(), err_dynamic_and_noexcept_specification);
            self.ParseDynamicExceptionSpecification(NoexceptRange, DynamicExceptions, DynamicExceptionRanges);
        }
    } else {
        self.Diag(self.Tok.getLocation(), err_dynamic_and_noexcept_specification);
    }
    return Result;
}

fn diagnoseDynamicExceptionSpecification(P: *mut Parser, Range: SourceRange, IsNoexcept: bool) {
    if P.getLangOpts().CPlusPlus11 {
        let mut Replacement: *u8 = if IsNoexcept { "noexcept" } else { "noexcept(false)" };
        P.Diag(Range.getBegin(), if P.getLangOpts().CPlusPlus17 && !IsNoexcept { ext_dynamic_exception_spec } else { warn_exception_spec_deprecated }) << Range;
        P.Diag(Range.getBegin(), note_exception_spec_deprecated) << Replacement << CreateReplacement(Range, Replacement);
    }
}

fn Parser::ParseDynamicExceptionSpecification(self, SpecificationRange: *mut SourceRange, Exceptions: *mut SmallVectorImpl<ParsedType>, Ranges: *mut SmallVectorImpl<SourceRange>) -> ExceptionSpecificationType {
    assert!(self.Tok.is(kw_throw), "expected throw");
    SpecificationRange.setBegin(self.ConsumeToken());
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected_lparen_after) << "throw";
        SpecificationRange.setEnd(SpecificationRange.getBegin());
        return EST_DynamicNone;
    }
    if self.Tok.is(ellipsis) {
        let mut EllipsisLoc: SourceLocation = self.ConsumeToken();
        if !self.getLangOpts().MicrosoftExt {
            self.Diag(EllipsisLoc, ext_ellipsis_exception_spec);
        }
        T.consumeClose();
        SpecificationRange.setEnd(T.getCloseLocation());
        diagnoseDynamicExceptionSpecification(*self, SpecificationRange, false);
        return EST_MSAny;
    }
    let mut Range: SourceRange = SourceRange {};
    while self.Tok.isNot(r_paren) {
        let mut Res: TypeResult = self.ParseTypeName(&mut Range, TypeName, AS_none, null, null);
        if self.Tok.is(ellipsis) {
            let mut Ellipsis: SourceLocation = self.ConsumeToken();
            Range.setEnd(Ellipsis);
            if !Res.isInvalid() {
                Res = self.Actions.ActOnPackExpansion(Res.get(), Ellipsis);
            }
        }
        if !Res.isInvalid() {
            Exceptions.push(Res.get());
            Ranges.push(Range);
        }
        if !self.TryConsumeToken(comma) {
            break;
        }
    }
    T.consumeClose();
    SpecificationRange.setEnd(T.getCloseLocation());
    diagnoseDynamicExceptionSpecification(*self, SpecificationRange, Exceptions.is_empty());
    return if Exceptions.is_empty() { EST_DynamicNone } else { EST_Dynamic };
}

fn Parser::ParseTrailingReturnType(self, Range: *mut SourceRange, MayBeFollowedByDirectInit: bool) -> TypeResult {
    assert!(self.Tok.is(arrow), "expected arrow");
    self.ConsumeToken();
    return self.ParseTypeName(&mut Range, if MayBeFollowedByDirectInit { TrailingReturnVar } else { TrailingReturn }, AS_none, null, null);
}

fn Parser::ParseTrailingRequiresClauseWithScope(self, D: *mut Declarator) {
    assert!(self.Tok.is(kw_requires), "expected requires");
    let mut SS: *mut CXXScopeSpec = D.getCXXScopeSpec();
    let mut DeclScopeObj: DeclaratorScopeObj = DeclaratorScopeObj { *self, SS };
    if SS.isValid() && self.Actions.ShouldEnterDeclaratorScope(self.getCurScope(), SS) {
        DeclScopeObj.EnterDeclaratorScope();
    }
    let mut ParamScope: ParseScope = ParseScope { self, DeclScope | FunctionDeclarationScope | FunctionPrototypeScope, true, false };
    self.ParseTrailingRequiresClause(D);
}

fn Parser::ParseTrailingRequiresClause(self, D: *mut Declarator) {
    assert!(self.Tok.is(kw_requires), "expected requires");
    assert!(self.getCurScope().isFunctionPrototypeScope(), "trailing requires-clause must be parsed in a function prototype scope");
    let mut RequiresKWLoc: SourceLocation = self.ConsumeToken();
    let mut TrailingRequiresClause: ExprResult = false;
    self.Actions.ActOnStartTrailingRequiresClause(self.getCurScope(), D);
    let mut ThisScope: CXXThisScopeRAII> = CXXThisScopeRAII> {};
    self.InitCXXThisScopeForDeclaratorIfRelevant(D, D.getDeclSpec(), ThisScope);
    TrailingRequiresClause = self.ParseConstraintLogicalOrExpression(true);
    TrailingRequiresClause = self.Actions.ActOnFinishTrailingRequiresClause(TrailingRequiresClause);
    if !D.isDeclarationOfFunction() {
        self.Diag(RequiresKWLoc, err_requires_clause_on_declarator_not_declaring_a_function);
        return;
    }
    if TrailingRequiresClause.isInvalid() {
        self.SkipUntil([l_brace, arrow, kw_try, comma, colon], StopAtSemi | StopBeforeMatch);
    } else {
        D.setTrailingRequiresClause(TrailingRequiresClause.get());
    }
    if D.isFunctionDeclarator() && self.Tok.is(arrow) && D.getDeclSpec().getTypeSpecType() == TST_auto {
        let mut ArrowLoc: SourceLocation = self.Tok.getLocation();
        let mut Range: SourceRange = SourceRange {};
        let mut TrailingReturnType: TypeResult = self.ParseTrailingReturnType(Range, false);
        if !TrailingReturnType.isInvalid() {
            self.Diag(ArrowLoc, err_requires_clause_must_appear_after_trailing_return) << Range;
            let mut FunctionChunk: *mut FunctionTypeInfo = D.getFunctionTypeInfo();
            FunctionChunk.HasTrailingReturnType = TrailingReturnType.isUsable();
            FunctionChunk.TrailingReturnType = TrailingReturnType.get();
            FunctionChunk.TrailingReturnTypeLoc = Range.getBegin();
        } else {
            self.SkipUntil([equal, l_brace, arrow, kw_try, comma], StopAtSemi | StopBeforeMatch);
        }
    }
}

fn Parser::PushParsingClass(self, ClassDecl: *mut Decl, NonNestedClass: bool, IsInterface: bool) -> ParsingClassState {
    assert!((NonNestedClass || !self.ClassStack.is_empty()), "Nested class without outer class");
    self.ClassStack.push(ParsingClass { ClassDecl, NonNestedClass, IsInterface });
    return self.Actions.PushParsingClass();
}

fn Parser::DeallocateParsedClasses(self, Class: *mut ParsingClass) {
    for let mut I: u32 = 0;
let mut N: u32 = Class.LateParsedDeclarations.len; I != N; I += 1 {
        Class.LateParsedDeclarations[I];
    }
    Class;
}

fn Parser::PopParsingClass(self, state: ParsingClassState) {
    assert!(!self.ClassStack.is_empty(), "Mismatched push/pop for class parsing");
    self.Actions.PopParsingClass(state);
    let mut Victim: *mut ParsingClass = self.ClassStack.top();
    self.ClassStack.pop();
    if Victim.TopLevelClass {
        self.DeallocateParsedClasses(Victim);
        return;
    }
    assert!(!self.ClassStack.is_empty(), "Missing top-level class?");
    if Victim.LateParsedDeclarations.is_empty() {
        self.DeallocateParsedClasses(Victim);
        return;
    }
    assert!(self.getCurScope().isClassScope(), "Nested class outside of class scope?");
    self.ClassStack.top().LateParsedDeclarations.push(LateParsedClass { self, Victim });
}

fn Parser::TryParseCXX11AttributeIdentifier(self, Loc: *mut SourceLocation, Completion: AttributeCompletion, Scope: *IdentifierInfo) -> *mut IdentifierInfo {
    match self.Tok.getKind() {
        _ => {
            if !self.Tok.isAnnotation() {
                if self.Tok.getIdentifierInfo() {
                    II;
                } else {
                    Loc = self.ConsumeToken();
                    return II;
                }
            }
        },
        code_completion => {
            self.cutOffParsing();
        },
        numeric_constant => {
            if self.Tok.getLocation().isMacroID() {
                let mut ExpansionBuf: str = "";
                let mut ExpansionLoc: SourceLocation = self.PP.getSourceManager().getExpansionLoc(self.Tok.getLocation());
                let mut Spelling: str = self.PP.getSpelling(ExpansionLoc, ExpansionBuf, null);
                if Spelling == "__clang__" {
                    let mut TokRange: SourceRange = SourceRange { B: ExpansionLoc, E: self.PP.getSourceManager().getExpansionLoc(self.Tok.getEndLoc()) };
                    self.Diag(self.Tok, warn_wrong_clang_attr_namespace) << CreateReplacement(TokRange, "_Clang");
                    Loc = self.ConsumeToken();
                    return &mut self.PP.getIdentifierTable().get("_Clang");
                }
            }
            return null;
        },
        ampamp => {
            pipe;
        },
    }
}

fn Parser::ParseOpenMPAttributeArgs(self, AttrName: *IdentifierInfo, OpenMPTokens: *mut CachedTokens) {
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        return;
    }
    if AttrName.isStr("directive") {
        let mut OMPBeginTok: Token = Token {};
        OMPBeginTok.startToken();
        OMPBeginTok.setKind(annot_attr_openmp);
        OMPBeginTok.setLocation(self.Tok.getLocation());
        OpenMPTokens.push(OMPBeginTok);
        self.ConsumeAndStoreUntil(r_paren, OpenMPTokens, false, false);
        let mut OMPEndTok: Token = Token {};
        OMPEndTok.startToken();
        OMPEndTok.setKind(annot_pragma_openmp_end);
        OMPEndTok.setLocation(self.Tok.getLocation());
        OpenMPTokens.push(OMPEndTok);
    } else {
        assert!(AttrName.isStr("sequence"), "Expected either 'directive' or 'sequence'");
        while true {
            {
            let mut IdentLoc: SourceLocation = SourceLocation {};
            let mut Ident: *IdentifierInfo = self.TryParseCXX11AttributeIdentifier(IdentLoc, None, null);
            if Ident && Ident.isStr("omp") && !self.ExpectAndConsume(coloncolon, err_expected, "") {
                Ident = self.TryParseCXX11AttributeIdentifier(IdentLoc, None, null);
            }
            if !Ident || (!Ident.isStr("directive") && !Ident.isStr("sequence")) {
                self.Diag(self.Tok.getLocation(), err_expected_sequence_or_directive);
                self.SkipUntil(r_paren, StopBeforeMatch);
                continue;
            }
            self.ParseOpenMPAttributeArgs(Ident, OpenMPTokens);
        }
            if !(self.TryConsumeToken(comma)) { break; }
        }
    }
    T.consumeClose();
}

fn IsBuiltInOrStandardCXX11Attribute(AttrName: *mut IdentifierInfo, ScopeName: *mut IdentifierInfo) -> bool {
    match getParsedKind(AttrName, ScopeName, AS_CXX11) {
        AT_Deprecated => {
            AT_FallThrough;
        },
        AT_WarnUnusedResult => {
            return !ScopeName && AttrName.getName() == "nodiscard";
        },
        AT_Unused => {
            return !ScopeName && AttrName.getName() == "maybe_unused";
        },
        _ => {
            return false;
        },
    }
}

fn Parser::ParseCXXAssumeAttributeArg(self, Attrs: *mut ParsedAttributes, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, EndLoc: *mut SourceLocation, Form: Form) -> bool {
    assert!(self.Tok.is(l_paren), "Not a C++11 attribute argument list");
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    T.consumeOpen();
    let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, PotentiallyEvaluated, null, EK_Other, true };
    let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
    let mut Res: ExprResult = self.ParseConditionalExpression();
    if Res.isInvalid() {
        TPA.Commit();
        self.SkipUntil(r_paren, r_square, StopAtSemi | StopBeforeMatch);
        if self.Tok.is(r_paren) {
            T.consumeClose();
        }
        return true;
    }
    if !self.Tok.isOneOf(r_paren, r_square) {
        TPA.Revert();
        Res = self.ParseExpression(AllowNonTypes);
        if !Res.isInvalid() {
            let mut E: *mut Expr = Res.get();
            self.Diag(E.getExprLoc(), err_assume_attr_expects_cond_expr) << AttrName << CreateInsertion(E.getBeginLoc(), "(", false) << CreateInsertion(self.PP.getLocForEndOfToken(E.getEndLoc(), 0), ")", false) << E.getSourceRange();
        }
        T.consumeClose();
        return true;
    }
    TPA.Commit();
    let mut Assumption: ArgsUnion = Res.get();
    let mut RParen: SourceLocation = self.Tok.getLocation();
    T.consumeClose();
    Attrs.addNew(AttrName, SourceRange { B: AttrNameLoc, E: RParen }, AttributeScopeInfo { ScopeName, ScopeLoc }, &mut Assumption, 1, Form, SourceLocation {});
    if EndLoc {
        *EndLoc = RParen;
    }
    return false;
}

fn Parser::ParseCXX11AttributeArgs(self, AttrName: *mut IdentifierInfo, AttrNameLoc: SourceLocation, Attrs: *mut ParsedAttributes, EndLoc: *mut SourceLocation, ScopeName: *mut IdentifierInfo, ScopeLoc: SourceLocation, OpenMPTokens: *mut CachedTokens) -> bool {
    assert!(self.Tok.is(l_paren), "Not a C++11 attribute argument list");
    let mut LParenLoc: SourceLocation = self.Tok.getLocation();
    let mut LO: *LangOptions = self.getLangOpts();
    let mut Form: Form = if LO.CPlusPlus { CXX11() } else { C23() };
    if self.getLangOpts().MicrosoftExt || self.getLangOpts().HLSL {
        if hasAttribute(AS_Microsoft, ScopeName, AttrName, self.getTargetInfo(), self.getLangOpts()) {
            Form = Microsoft();
        }
    }
    if LO.CPlusPlus {
        let mut TPA: TentativeParsingAction = TentativeParsingAction { *self, false };
        let mut HasInvalidArgument: bool = false;
        while self.Tok.isNot(r_paren) && self.Tok.isNot(eof) {
            if self.Tok.isOneOf(hash, hashhash) {
                self.Diag(self.Tok.getLocation(), ext_invalid_attribute_argument) << self.PP.getSpelling(self.Tok, null);
                HasInvalidArgument = true;
            }
            self.ConsumeAnyToken(false);
        }
        if HasInvalidArgument {
            self.SkipUntil(r_paren, 0 as SkipUntilFlags);
            TPA.Commit();
            return true;
        }
        TPA.Revert();
    }
    if Form.getSyntax() != AS_Microsoft && !hasAttribute(if LO.CPlusPlus { AS_CXX11 } else { AS_C23 }, ScopeName, AttrName, self.getTargetInfo(), self.getLangOpts()) {
        self.ConsumeParen();
        self.SkipUntil(r_paren, 0 as SkipUntilFlags);
        return false;
    }
    if ScopeName && (ScopeName.isStr("gnu") || ScopeName.isStr("__gnu__")) {
        self.ParseGNUAttributeArgs(AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form, null);
        return true;
    }
    if ScopeName && ScopeName.isStr("omp") && (AttrName.isStr("directive") || AttrName.isStr("sequence")) {
        self.Diag(AttrNameLoc, if self.getLangOpts().OpenMP >= 51 { warn_omp51_compat_attributes } else { ext_omp_attributes });
        self.ParseOpenMPAttributeArgs(AttrName, OpenMPTokens);
        return true;
    }
    let mut NumArgs: u32 = 0;
    if ScopeName && (ScopeName.isStr("clang") || ScopeName.isStr("_Clang")) {
        NumArgs = self.ParseClangAttributeArgs(AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
    } else if !ScopeName && AttrName.isStr("assume") {
        if self.ParseCXXAssumeAttributeArg(Attrs, AttrName, AttrNameLoc, null, SourceLocation {}, EndLoc, Form) {
            return true;
        }
        NumArgs = 1;
    } else {
        NumArgs = self.ParseAttributeArgsCommon(AttrName, AttrNameLoc, Attrs, EndLoc, ScopeName, ScopeLoc, Form);
    }
    if !Attrs.is_empty() && IsBuiltInOrStandardCXX11Attribute(AttrName, ScopeName) {
        let mut Attr: *mut ParsedAttr = Attrs.back();
        if !Attr.existsInTarget(self.getTargetInfo()) {
            self.Actions.DiagnoseUnknownAttribute(Attr);
            Attr.setInvalid(true);
            return true;
        }
        if Attr.getMaxArgs() && !NumArgs {
            self.Diag(LParenLoc, err_attribute_requires_arguments) << AttrName;
            Attr.setInvalid(true);
        } else if !Attr.getMaxArgs() {
            let mut D: DiagnosticBuilder = self.Diag(LParenLoc, err_cxx11_attribute_forbids_arguments) << AttrName;
            if EndLoc {
                D << CreateRemoval(SourceRange { B: LParenLoc, E: *EndLoc });
            }
            Attr.setInvalid(true);
        }
    }
    return true;
}

fn Parser::ParseCXX11AttributeSpecifierInternal(self, Attrs: *mut ParsedAttributes, OpenMPTokens: *mut CachedTokens, EndLoc: *mut SourceLocation) {
    if self.Tok.is(kw_alignas) {
        assert!(self.getLangOpts().CPlusPlus, "'alignas' is not an attribute in C");
        self.Diag(self.Tok.getLocation(), warn_cxx98_compat_alignas);
        self.ParseAlignmentSpecifier(Attrs, EndLoc);
        return;
    }
    if self.Tok.isRegularKeywordAttribute() {
        let mut Loc: SourceLocation = self.Tok.getLocation();
        let mut AttrName: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
        let mut Form: Form = self.Tok.getKind();
        let mut TakesArgs: bool = doesKeywordAttributeTakeArgs(self.Tok.getKind());
        self.ConsumeToken();
        if TakesArgs {
            if !self.Tok.is(l_paren) {
                self.Diag(self.Tok.getLocation(), err_expected_lparen_after) << AttrName;
            } else {
                self.ParseAttributeArgsCommon(AttrName, Loc, Attrs, EndLoc, null, Loc, Form);
            }
        } else {
            Attrs.addNew(AttrName, Loc, AttributeScopeInfo {}, null, 0, Form, SourceLocation {});
        }
        return;
    }
    assert!(self.Tok.is(l_square) && self.NextToken().is(l_square), "Not a double square bracket attribute list");
    let mut OpenLoc: SourceLocation = self.Tok.getLocation();
    self.DiagCompat(OpenLoc, if self.getLangOpts().CPlusPlus { cxx11_attributes } else { c23_attributes });
    self.ConsumeBracket();
    self.checkCompoundToken(OpenLoc, l_square, AttrBegin);
    self.ConsumeBracket();
    let mut CommonScopeLoc: SourceLocation = SourceLocation {};
    let mut CommonScopeName: *mut IdentifierInfo = null;
    if self.Tok.is(kw_using) {
        self.DiagCompat(self.Tok.getLocation(), using_attribute_ns);
        self.ConsumeToken();
        CommonScopeName = self.TryParseCXX11AttributeIdentifier(CommonScopeLoc, Scope, null);
        if !CommonScopeName {
            self.Diag(self.Tok.getLocation(), err_expected) << identifier;
            self.SkipUntil(r_square, colon, StopBeforeMatch);
        }
        if !self.TryConsumeToken(colon) && CommonScopeName {
            self.Diag(self.Tok.getLocation(), err_expected) << colon;
        }
    }
    let mut AttrParsed: bool = false;
    while !self.Tok.isOneOf(r_square, semi, eof) {
        if AttrParsed {
            if self.ExpectAndConsume(comma, err_expected, "") {
                self.SkipUntil(r_square, StopAtSemi | StopBeforeMatch);
                continue;
            }
            AttrParsed = false;
        }
        while self.TryConsumeToken(comma) {
            
        }
        let mut ScopeLoc: SourceLocation = SourceLocation {};
        let mut AttrLoc: SourceLocation = SourceLocation {};
        let mut ScopeName: *mut IdentifierInfo = null;
        let mut AttrName: *mut IdentifierInfo = null;
        AttrName = self.TryParseCXX11AttributeIdentifier(AttrLoc, Attribute, CommonScopeName);
        if !AttrName {
            break;
        }
        if self.TryConsumeToken(coloncolon) {
            ScopeName = AttrName;
            ScopeLoc = AttrLoc;
            AttrName = self.TryParseCXX11AttributeIdentifier(AttrLoc, Attribute, ScopeName);
            if !AttrName {
                self.Diag(self.Tok.getLocation(), err_expected) << identifier;
                self.SkipUntil(r_square, comma, StopAtSemi | StopBeforeMatch);
                continue;
            }
        }
        if CommonScopeName {
            if ScopeName {
                self.Diag(ScopeLoc, err_using_attribute_ns_conflict) << CommonScopeLoc;
            } else {
                ScopeName = CommonScopeName;
                ScopeLoc = CommonScopeLoc;
            }
        }
        if self.Tok.is(l_paren) {
            AttrParsed = self.ParseCXX11AttributeArgs(AttrName, AttrLoc, Attrs, EndLoc, ScopeName, ScopeLoc, OpenMPTokens);
        }
        if !AttrParsed {
            Attrs.addNew(AttrName, SourceRange { B: if ScopeLoc.isValid() && CommonScopeLoc.isInvalid() { ScopeLoc } else { AttrLoc }, E: AttrLoc }, AttributeScopeInfo { Name: ScopeName, NameLoc: ScopeLoc, CommonScopeLoc: CommonScopeLoc }, null, 0, if self.getLangOpts().CPlusPlus { CXX11() } else { C23() }, SourceLocation {});
            AttrParsed = true;
        }
        if self.TryConsumeToken(ellipsis) {
            self.Diag(self.Tok, err_cxx11_attribute_forbids_ellipsis) << AttrName;
        }
    }
    let mut CloseLoc: SourceLocation = self.Tok.getLocation();
    let mut IsTokenNotFound: bool = self.ExpectAndConsume(r_square, err_expected, "");
    if IsTokenNotFound {
        self.SkipUntil(r_square, 0 as SkipUntilFlags);
    } else if self.Tok.is(r_square) {
        self.checkCompoundToken(CloseLoc, r_square, AttrEnd);
    }
    if EndLoc {
        *EndLoc = self.Tok.getLocation();
    }
    if !IsTokenNotFound && self.ExpectAndConsume(r_square, err_expected, "") {
        self.SkipUntil(r_square, 0 as SkipUntilFlags);
    }
}

fn Parser::ParseCXX11Attributes(self, Attrs: *mut ParsedAttributes) {
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = StartLoc;
    while true {
        {
        self.ParseCXX11AttributeSpecifier(Attrs, &mut EndLoc);
    }
        if !(self.isAllowedCXX11AttributeSpecifier(false, false)) { break; }
    }
    Attrs.Range = SourceRange { B: StartLoc, E: EndLoc };
}

fn Parser::DiagnoseAndSkipCXX11Attributes(self) {
    let mut Keyword: *mut IdentifierInfo = if self.Tok.isRegularKeywordAttribute() { self.Tok.getIdentifierInfo() } else { null };
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = self.SkipCXX11Attributes();
    if EndLoc.isValid() {
        let mut Range: SourceRange = SourceRange { B: StartLoc, E: EndLoc };
        (if Keyword { self.Diag(StartLoc, err_keyword_not_allowed) << Keyword } else { self.Diag(StartLoc, err_attributes_not_allowed) }) << Range;
    }
}

fn Parser::SkipCXX11Attributes(self) -> SourceLocation {
    let mut EndLoc: SourceLocation = SourceLocation {};
    if self.isCXX11AttributeSpecifier(false, false) == NotAttributeSpecifier {
        return EndLoc;
    }
    while true {
        {
        if self.Tok.is(l_square) {
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
            T.consumeOpen();
            T.skipToEnd();
            EndLoc = T.getCloseLocation();
        } else if self.Tok.isRegularKeywordAttribute() && !doesKeywordAttributeTakeArgs(self.Tok.getKind()) {
            EndLoc = self.Tok.getLocation();
            self.ConsumeToken();
        } else {
            assert!((self.Tok.is(kw_alignas) || self.Tok.isRegularKeywordAttribute()), "not an attribute specifier");
            self.ConsumeToken();
            let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
            if !T.consumeOpen() {
                T.skipToEnd();
            }
            EndLoc = T.getCloseLocation();
        }
    }
        if !(self.isCXX11AttributeSpecifier(false, false) != NotAttributeSpecifier) { break; }
    }
    return EndLoc;
}

fn Parser::ParseMicrosoftUuidAttributeArgs(self, Attrs: *mut ParsedAttributes) {
    assert!(self.Tok.is(identifier), "Not a Microsoft attribute list");
    let mut UuidIdent: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    assert!(UuidIdent.getName() == "uuid", "Not a Microsoft attribute list");
    let mut UuidLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        return;
    }
    let mut ArgExprs: ArgsVector = ArgsVector {};
    if self.isTokenStringLiteral() {
        let mut StringResult: ExprResult = self.ParseUnevaluatedStringLiteralExpression();
        if StringResult.isInvalid() {
            return;
        }
        ArgExprs.push(StringResult.get());
    } else {
        let mut StrBuffer: str = "";
        operator(StrBuffer, "\"");
        let mut StartLoc: SourceLocation = self.Tok.getLocation();
        while self.Tok.isNot(r_paren) {
            if self.Tok.hasLeadingSpace() || self.Tok.isAtStartOfLine() {
                self.Diag(self.Tok, err_attribute_uuid_malformed_guid);
                self.SkipUntil(r_paren, StopAtSemi);
                return;
            }
            let mut SpellingBuffer: str = "";
            SpellingBuffer.resize(self.Tok.getLength() + 1);
            let mut Invalid: bool = false;
            let mut TokSpelling: str = self.PP.getSpelling(self.Tok, SpellingBuffer, &mut Invalid);
            if Invalid {
                self.SkipUntil(r_paren, StopAtSemi);
                return;
            }
            operator(StrBuffer, TokSpelling);
            self.ConsumeAnyToken(false);
        }
        operator(StrBuffer, "\"");
        if self.Tok.hasLeadingSpace() || self.Tok.isAtStartOfLine() {
            self.Diag(self.Tok, err_attribute_uuid_malformed_guid);
            self.ConsumeParen();
            return;
        }
        let mut Toks: [1]Token = [1]Token {};
        Toks[0].startToken();
        Toks[0].setKind(string_literal);
        Toks[0].setLocation(StartLoc);
        Toks[0].setLiteralData(StrBuffer.ptr);
        Toks[0].setLength(StrBuffer.len);
        let mut UuidString: *mut StringLiteral = cast(self.Actions.ActOnUnevaluatedStringLiteral(Toks).get());
        ArgExprs.push(UuidString);
    }
    if !T.consumeClose() {
        Attrs.addNew(UuidIdent, SourceRange { B: UuidLoc, E: T.getCloseLocation() }, AttributeScopeInfo {}, ArgExprs.ptr, ArgExprs.len, Microsoft(), SourceLocation {});
    }
}

fn Parser::ParseHLSLRootSignatureAttributeArgs(self, Attrs: *mut ParsedAttributes) {
    assert!(self.Tok.is(identifier), "Expected an identifier to denote which MS attribute to consider");
    let mut RootSignatureIdent: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
    assert!(RootSignatureIdent.getName() == "RootSignature", "Expected RootSignature identifier for root signature attribute");
    let mut RootSignatureLoc: SourceLocation = self.Tok.getLocation();
    self.ConsumeToken();
    let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_paren, semi };
    if T.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_paren;
        return;
    }
    let mut ProcessStringLiteral: Closure_9 = Closure_9 { cap_0: self };
    let mut Signature: optional<StringLiteral *> = ProcessStringLiteral.call();
    if !Signature.has_value() {
        self.Diag(self.Tok, err_expected_string_literal) << 4 << "RootSignature";
        return;
    }
    let mut DeclIdent: *mut IdentifierInfo = ParseHLSLRootSignature(self.Actions, self.getLangOpts().HLSLRootSigVer, operator(Signature));
    if !DeclIdent {
        self.SkipUntil(r_paren, StopAtSemi | StopBeforeMatch);
        T.consumeClose();
        return;
    }
    let mut ILoc: *mut IdentifierLoc = IdentifierLoc { Loc: RootSignatureLoc, II: DeclIdent };
    let mut Args: ArgsVector = [ILoc];
    if !T.consumeClose() {
        Attrs.addNew(RootSignatureIdent, SourceRange { B: RootSignatureLoc, E: T.getCloseLocation() }, AttributeScopeInfo {}, Args.ptr, Args.len, Microsoft(), SourceLocation {});
    }
}

fn Parser::ParseMicrosoftAttributes(self, Attrs: *mut ParsedAttributes) {
    assert!(self.Tok.is(l_square), "Not a Microsoft attribute list");
    let mut StartLoc: SourceLocation = self.Tok.getLocation();
    let mut EndLoc: SourceLocation = StartLoc;
    while true {
        {
        let mut T: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_square, semi };
        T.consumeOpen();
        while true {
            self.SkipUntil(r_square, identifier, StopAtSemi | StopBeforeMatch | StopAtCodeCompletion);
            if self.Tok.is(code_completion) {
                self.cutOffParsing();
                self.Actions.CodeCompletion().CodeCompleteAttribute(AS_Microsoft, Attribute, null);
                break;
            }
            if self.Tok.isNot(identifier) {
                break;
            }
            if self.Tok.getIdentifierInfo().getName() == "uuid" {
                self.ParseMicrosoftUuidAttributeArgs(Attrs);
            } else if self.Tok.getIdentifierInfo().getName() == "RootSignature" {
                self.ParseHLSLRootSignatureAttributeArgs(Attrs);
            } else {
                let mut II: *mut IdentifierInfo = self.Tok.getIdentifierInfo();
                let mut NameLoc: SourceLocation = self.Tok.getLocation();
                self.ConsumeToken();
                let mut AttrKind: Kind = getParsedKind(II, null, AS_Microsoft);
                if self.getLangOpts().HLSL || AttrKind != UnknownAttribute {
                    let mut AttrParsed: bool = false;
                    if self.Tok.is(l_paren) {
                        let mut OpenMPTokens: CachedTokens = CachedTokens {};
                        AttrParsed = self.ParseCXX11AttributeArgs(II, NameLoc, Attrs, &mut EndLoc, null, SourceLocation {}, OpenMPTokens);
                        self.ReplayOpenMPAttributeTokens(OpenMPTokens);
                    }
                    if !AttrParsed {
                        Attrs.addNew(II, NameLoc, AttributeScopeInfo {}, null, 0, Microsoft(), SourceLocation {});
                    }
                }
            }
        }
        T.consumeClose();
        EndLoc = T.getCloseLocation();
    }
        if !(self.Tok.is(l_square)) { break; }
    }
    Attrs.Range = SourceRange { B: StartLoc, E: EndLoc };
}

fn Parser::ParseMicrosoftIfExistsClassDeclaration(self, TagType: TST, AccessAttrs: *mut ParsedAttributes, CurAS: *mut AccessSpecifier) {
    let mut Result: IfExistsCondition = IfExistsCondition {};
    if self.ParseMicrosoftIfExistsCondition(Result) {
        return;
    }
    let mut Braces: BalancedDelimiterTracker = BalancedDelimiterTracker { *self, l_brace, semi };
    if Braces.consumeOpen() {
        self.Diag(self.Tok, err_expected) << l_brace;
        return;
    }
    match Result.Behavior {
        Parse => {
            break;
        },
        Dependent => {
            self.Diag(Result.KeywordLoc, warn_microsoft_dependent_exists) << Result.IsIfExists;
        },
        Skip => {
            Braces.skipToEnd();
        },
    }
    while self.Tok.isNot(r_brace) && !self.isEofOrEom() {
        if self.Tok.isOneOf(kw___if_exists, kw___if_not_exists) {
            self.ParseMicrosoftIfExistsClassDeclaration(TagType, AccessAttrs, CurAS);
            continue;
        }
        if self.Tok.is(semi) {
            self.ConsumeExtraSemi(InsideStruct, TagType);
            continue;
        }
        let mut AS: AccessSpecifier = self.getAccessSpecifierIfPresent();
        if AS != AS_none {
            CurAS = AS;
            let mut ASLoc: SourceLocation = self.Tok.getLocation();
            self.ConsumeToken();
            if self.Tok.is(colon) {
                self.Actions.ActOnAccessSpecifier(AS, ASLoc, self.Tok.getLocation(), ParsedAttributesView {});
            } else {
                self.Diag(self.Tok, err_expected) << colon;
            }
            self.ConsumeToken();
            continue;
        }
        let mut TemplateInfo: ParsedTemplateInfo = ParsedTemplateInfo {};
        self.ParseCXXClassMemberDeclaration(CurAS, AccessAttrs, TemplateInfo, null);
    }
    Braces.consumeClose();
}

struct Closure_1 {
    cap_0: *mut Parser,
    TemplateInfo: *mut ParsedTemplateInfo,
