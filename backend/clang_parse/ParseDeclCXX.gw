    }
    if TrailingRequiresClause()() {
        
    } else {
        D.setTrailingRequiresClause();
    }
    if D.isFunctionDeclarator() && self.Tok.is(arrow) && D.getDeclSpec().getTypeSpecType() == TST_auto {
        let mut ArrowLoc: SourceLocation = self.Tok.getLocation();
        let mut Range: SourceRange = SourceRange {};
        let mut TrailingReturnType: i32 = 0;
        if operator!() {
             << Range;
            let mut FunctionChunk: *mut FunctionTypeInfo = D.getFunctionTypeInfo();
            FunctionChunk.HasTrailingReturnType = ();
            FunctionChunk() = ();
            FunctionChunk.TrailingReturnTypeLoc = Range.getBegin();
        } else {
            
        }
    }
}

fn Parser::PushParsingClass(self, ClassDecl: *mut Decl, NonNestedClass: bool, IsInterface: bool) -> ParsingClassState {
    return self.Actions.PushParsingClass();
