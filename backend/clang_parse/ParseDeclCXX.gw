            let mut Loc: SourceLocation = AttrRange.getBegin();
            (if FirstAttr && FirstAttr.isRegularKeywordAttribute() { self.Diag(Loc, err_keyword_not_allowed) << FirstAttr } else { self.Diag(Loc, err_attributes_not_allowed) }) << AttrRange << CreateInsertionFromRange(AttrFixitLoc, CharSourceRange { Range: AttrRange, IsTokenRange: true }, false) << CreateRemoval(AttrRange);
            attrs.takeAllAppendingFrom(Attributes);
        }
    }
    if !Name && !TemplateId && (DS.getTypeSpecType() == TST_error || TUK != Definition) {
        if DS.getTypeSpecType() != TST_error {
            self.Diag(StartLoc, err_anon_type_definition) << getSpecifierName(TagType, Policy);
        }
        if TUK == Definition && self.Tok.is(colon) {
            self.SkipUntil(semi, StopBeforeMatch);
        } else {
            self.SkipUntil(comma, StopAtSemi);
        }
