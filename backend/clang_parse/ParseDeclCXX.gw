            Spec.setTemplateParamLists(*TemplateInfo.TemplateParams);
        }
        let mut HasValidSpec: bool = true;
        if self.ParseOptionalCXXScopeSpecifier(Spec, null, false, EnteringContext, null, false, null, false, false, false, false, false) {
