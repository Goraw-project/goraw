    } else if self.isClassCompatibleKeyword() && (self.NextToken().is(l_square) || self.NextToken().is(kw_alignas) || self.NextToken().isRegularKeywordAttribute() || self.isCXX11VirtSpecifier(self.NextToken()) != VS_None) {
        let mut PA: TentativeParsingAction = TentativeParsingAction { *self, false };
