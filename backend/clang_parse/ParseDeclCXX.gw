unsafe fn Closure_1::call(self: *mut Closure_1, Name: *mut IdentifierInfo, NameLoc: SourceLocation, TemplateArgRange: SourceRange, KnownUndeclared: bool) {
        self.Diag(NameLoc, err_explicit_spec_non_template) << ((*self.TemplateInfo).Kind == ExplicitInstantiation) << (*self.TagTokKind) << Name << TemplateArgRange << KnownUndeclared;
        if (*self.TemplateParams) && (*self.TemplateInfo).LastParameterListWasEmpty {
            if (*self.TemplateParams).len > 1 {
                (*self.TemplateParams).pop();
            } else {
                (*self.TemplateParams) = null;
                (*self.TemplateInfo).Kind = NonTemplate;
            }
        } else if (*self.TemplateInfo).Kind == ExplicitInstantiation {
            (*self.TemplateParams) = null;
            (*self.TemplateInfo).Kind = NonTemplate;
            (*self.TemplateInfo).TemplateLoc = SourceLocation {};
            (*self.TemplateInfo).ExternLoc = SourceLocation {};
        }
    }

