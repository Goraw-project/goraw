    }
    if !TagOrTempResult.isInvalid() {
        self.Actions.ProcessDeclAttributeDelayed(TagOrTempResult.get(), attrs);
    }
    let mut PrevSpec: *u8 = null;
    let mut DiagID: u32 = 0;
    let mut Result: bool = false;
    if !TypeResult.isInvalid() {
        Result = DS.SetTypeSpecType(TST_typename, StartLoc, if NameLoc.isValid() { NameLoc } else { StartLoc }, PrevSpec, DiagID, TypeResult.get(), Policy);
    } else if !TagOrTempResult.isInvalid() {
        Result = DS.SetTypeSpecType(TagType, StartLoc, if NameLoc.isValid() { NameLoc } else { StartLoc }, PrevSpec, DiagID, TagOrTempResult.get(), Owned, Policy);
