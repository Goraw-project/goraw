            return nullopt;
        }
        return Int.value();
    }
    if self.tryConsumeExpectedToken(float_literal) {
        let mut Float: optional<float> = self.handleFloatLiteral(Negated);
        if !Float.has_value() {
            return nullopt;
        }
        return Float.value();
    }
    return nullopt;
}

