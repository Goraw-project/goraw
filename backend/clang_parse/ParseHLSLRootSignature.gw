        } else {
            self.consumeNextToken();
            self.reportDiag << 0 << kw_DescriptorTable;
            return nullopt();
        }
        if !self.tryConsumeExpectedToken(pu_comma) {
            break;
        }
    }
    if self.consumeExpectedToken {
        return nullopt();
    }
    if Visibility()() {
        Table.Visibility = ();
    }
    return Table;
}

