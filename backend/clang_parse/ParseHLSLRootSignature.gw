        Sampler.CompFunc = operator(Params).CompFunc.value();
    }
    if operator(Params).BorderColor.has_value() {
        Sampler.BorderColor = operator(Params).BorderColor.value();
    }
    if operator(Params).MinLOD.has_value() {
        Sampler.MinLOD = operator(Params).MinLOD.value();
    }
    if operator(Params).MaxLOD.has_value() {
        Sampler.MaxLOD = operator(Params).MaxLOD.value();
    }
    if operator(Params).Space.has_value() {
        Sampler.Space = operator(Params).Space.value();
    }
    if operator(Params).Visibility.has_value() {
        Sampler.Visibility = operator(Params).Visibility.value();
    }
    if operator(Params).Flags.has_value() {
        Sampler.Flags = operator(Params).Flags.value();
    }
    return Sampler;
}

fn RootSignatureParser::parseRootConstantParams(self) -> ParsedConstantParams> {
    assert!(self.CurToken.TokKind == pu_l_paren, "Expects to only be invoked starting at given token");
    let mut Params: ParsedConstantParams = ParsedConstantParams {};
    while !self.peekExpectedToken(pu_r_paren) {
        if self.tryConsumeExpectedToken(kw_num32BitConstants) {
            if Params.Num32BitConstants.has_value() {
                self.reportDiag(err_hlsl_rootsig_repeat_param) << self.CurToken.TokKind;
                return nullopt;
            }
            if self.consumeExpectedToken(pu_equal, err_expected, invalid) {
                return nullopt;
            }
            let mut Num32BitConstants: optional<uint32_t> = self.parseUIntParam();
            if !Num32BitConstants.has_value() {
                return nullopt;
            }
            Params.Num32BitConstants = Num32BitConstants;
        } else if self.tryConsumeExpectedToken(bReg) {
            if Params.Reg.has_value() {
                self.reportDiag(err_hlsl_rootsig_repeat_param) << self.CurToken.TokKind;
                return nullopt;
            }
            let mut Reg: Register> = self.parseRegister();
            if !Reg.has_value() {
                return nullopt;
            }
            Params.Reg = Reg;
        } else if self.tryConsumeExpectedToken(kw_space) {
            if Params.Space.has_value() {
                self.reportDiag(err_hlsl_rootsig_repeat_param) << self.CurToken.TokKind;
                return nullopt;
            }
            if self.consumeExpectedToken(pu_equal, err_expected, invalid) {
                return nullopt;
            }
            let mut Space: optional<uint32_t> = self.parseUIntParam();
            if !Space.has_value() {
                return nullopt;
            }
            Params.Space = Space;
        } else if self.tryConsumeExpectedToken(kw_visibility) {
            if Params.Visibility.has_value() {
                self.reportDiag(err_hlsl_rootsig_repeat_param) << self.CurToken.TokKind;
                return nullopt;
            }
            if self.consumeExpectedToken(pu_equal, err_expected, invalid) {
                return nullopt;
            }
            let mut Visibility: ShaderVisibility> = self.parseShaderVisibility(kw_visibility);
            if !Visibility.has_value() {
                return nullopt;
            }
            Params.Visibility = Visibility;
        } else {
            self.consumeNextToken();
            self.reportDiag(err_hlsl_invalid_token) << 0 << kw_RootConstants;
            return nullopt;
        }
        if !self.tryConsumeExpectedToken(pu_comma) {
            break;
        }
    }
    return Params;
}

