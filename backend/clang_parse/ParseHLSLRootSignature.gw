fn RootSignatureParser::parseDescriptorTableClauseParams(self, ClauseKind: TokenKind, RegType: TokenKind) -> ParsedClauseParams> {
    assert!(self.CurToken.TokKind == pu_l_paren, "Expects to only be invoked starting at given token");
