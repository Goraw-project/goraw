    if self.consumeExpectedToken {
        return nullopt();
    }
    if operator!() {
        self.reportDiag << kw_num32BitConstants;
        return nullopt();
    }
    Constants.Num32BitConstants = ();
    if operator!() {
        self.reportDiag << bReg;
        return nullopt();
    }
    Constants.Reg = ();
    if Params()() {
        Constants.Visibility = ();
    }
    if Params()() {
        Constants.Space = ();
    }
    return Constants;
}

fn RootSignatureParser::parseRootDescriptor(self) -> optional<RootDescriptor> {
    assert!((self.CurToken.TokKind == kw_CBV || self.CurToken.TokKind == kw_SRV || self.CurToken.TokKind == kw_UAV), "Expects to only be invoked starting at given keyword");
    let mut DescriptorKind: TokenKind = self.CurToken.TokKind;
    if self.consumeExpectedToken {
        return nullopt();
    }
    let mut Descriptor: RootDescriptor = RootDescriptor {};
    let mut ExpectedReg: TokenKind = zeroed();
    match DescriptorKind {
        _ => {
            llvm_unreachable_internal("Switch for consumed token was not provided", "clang\\lib\\Parse\\ParseHLSLRootSignature.cpp", 247);
        },
        kw_CBV => {
            Descriptor.Type = CBuffer;
        },
        kw_SRV => {
            Descriptor.Type = SRV;
        },
        kw_UAV => {
            Descriptor.Type = UAV;
        },
    }
    Descriptor.setDefaultFlags(self.Version);
    let mut Params: auto = self.parseRootDescriptorParams;
    if operator!() {
        return nullopt();
    }
    if self.consumeExpectedToken {
        return nullopt();
    }
    if operator!() {
        self.reportDiag << ExpectedReg;
        return nullopt();
    }
    Descriptor.Reg = ();
    if Params()() {
        Descriptor.Space = ();
    }
    if Params()() {
        Descriptor.Visibility = ();
    }
    if Params()() {
        Descriptor.Flags = ();
    }
    return Descriptor;
}

