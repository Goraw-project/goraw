const RootElementKeywords: [6]TokenKind = [kw_RootFlags, kw_CBV, kw_UAV, kw_SRV, kw_DescriptorTable, kw_StaticSampler];

fn RootSignatureParser::parse(self) -> bool {
    let mut HadError: bool = false;
    let mut HasRootFlags: bool = false;
    while !self.peekExpectedToken(end_of_stream) {
        if self.tryConsumeExpectedToken(kw_RootFlags) {
            if HasRootFlags {
                self.reportDiag(err_hlsl_rootsig_repeat_param) << kw_RootFlags;
                HadError = true;
                self.skipUntilExpectedToken(RootElementKeywords);
                continue;
            }
            HasRootFlags = true;
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Flags: RootFlags> = self.parseRootFlags();
            if !Flags.has_value() {
                HadError = true;
                self.skipUntilExpectedToken(RootElementKeywords);
                continue;
            }
            self.Elements.push(ElementLoc, operator(Flags));
        } else if self.tryConsumeExpectedToken(kw_RootConstants) {
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Constants: RootConstants> = self.parseRootConstants();
            if !Constants.has_value() {
                HadError = true;
                self.skipUntilExpectedToken(RootElementKeywords);
                continue;
            }
            self.Elements.push(ElementLoc, operator(Constants));
        } else if self.tryConsumeExpectedToken(kw_DescriptorTable) {
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Table: DescriptorTable> = self.parseDescriptorTable();
            if !Table.has_value() {
                HadError = true;
                self.skipUntilClosedParens(1);
                self.consumeNextToken();
                self.skipUntilExpectedToken(RootElementKeywords);
                continue;
            }
            self.Elements.push(ElementLoc, operator(Table));
        } else if self.tryConsumeExpectedToken([kw_CBV, kw_SRV, kw_UAV]) {
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Descriptor: RootDescriptor> = self.parseRootDescriptor();
            if !Descriptor.has_value() {
                HadError = true;
                self.skipUntilExpectedToken(RootElementKeywords);
                continue;
            }
            self.Elements.push(ElementLoc, operator(Descriptor));
        } else if self.tryConsumeExpectedToken(kw_StaticSampler) {
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Sampler: StaticSampler> = self.parseStaticSampler();
            if !Sampler.has_value() {
                HadError = true;
                self.skipUntilExpectedToken(RootElementKeywords);
                continue;
            }
            self.Elements.push(ElementLoc, operator(Sampler));
        } else {
            HadError = true;
            self.consumeNextToken();
            self.reportDiag(err_hlsl_invalid_token) << 0 << kw_RootSignature;
            self.skipUntilExpectedToken(RootElementKeywords);
            continue;
        }
        if !self.tryConsumeExpectedToken(pu_comma) {
            break;
        }
    }
    return HadError || self.consumeExpectedToken(end_of_stream, err_expected_either, pu_comma);
}

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: maybeOrFlag]
// template <typename FlagType>
// fn maybeOrFlag(Flags: StaticSamplerFlags>, Flag: StaticSamplerFlags) -> StaticSamplerFlags {
//     if !Flags.has_value() {
//         return Flag;
//     }
//     return to_underlying(Flags.value()) | to_underlying(Flag) as StaticSamplerFlags;
// }
// ========================================================

fn RootSignatureParser::parseRootFlags(self) -> RootFlags> {
    assert!(self.CurToken.TokKind == kw_RootFlags, "Expects to only be invoked starting at given keyword");
    if self.consumeExpectedToken(pu_l_paren, err_expected_after, self.CurToken.TokKind) {
        return nullopt;
    }
    let mut Flags: RootFlags> = None;
    if self.tryConsumeExpectedToken(pu_r_paren) {
        return Flags;
    }
    if self.tryConsumeExpectedToken(int_literal) {
        if !self.verifyZeroFlag() {
            self.reportDiag(err_hlsl_rootsig_non_zero_flag);
            return nullopt;
        }
    } else {
        let mut Expected: [12]TokenKind = [en_AllowInputAssemblerInputLayout, en_DenyVertexShaderRootAccess, en_DenyHullShaderRootAccess, en_DenyDomainShaderRootAccess, en_DenyGeometryShaderRootAccess, en_DenyPixelShaderRootAccess, en_DenyAmplificationShaderRootAccess, en_DenyMeshShaderRootAccess, en_AllowStreamOutput, en_LocalRootSignature, en_CBVSRVUAVHeapDirectlyIndexed, en_SamplerHeapDirectlyIndexed];
        while true {
            {
            if self.tryConsumeExpectedToken(Expected) {
                match self.CurToken.TokKind {
                    en_AllowInputAssemblerInputLayout => {
                        Flags = maybeOrFlag(Flags, AllowInputAssemblerInputLayout);
                    },
                    en_DenyVertexShaderRootAccess => {
                        Flags = maybeOrFlag(Flags, DenyVertexShaderRootAccess);
                    },
                    en_DenyHullShaderRootAccess => {
                        Flags = maybeOrFlag(Flags, DenyHullShaderRootAccess);
                    },
                    en_DenyDomainShaderRootAccess => {
                        Flags = maybeOrFlag(Flags, DenyDomainShaderRootAccess);
                    },
                    en_DenyGeometryShaderRootAccess => {
                        Flags = maybeOrFlag(Flags, DenyGeometryShaderRootAccess);
                    },
                    en_DenyPixelShaderRootAccess => {
                        Flags = maybeOrFlag(Flags, DenyPixelShaderRootAccess);
                    },
                    en_DenyAmplificationShaderRootAccess => {
                        Flags = maybeOrFlag(Flags, DenyAmplificationShaderRootAccess);
                    },
                    en_DenyMeshShaderRootAccess => {
                        Flags = maybeOrFlag(Flags, DenyMeshShaderRootAccess);
                    },
                    en_AllowStreamOutput => {
                        Flags = maybeOrFlag(Flags, AllowStreamOutput);
                    },
                    en_LocalRootSignature => {
                        Flags = maybeOrFlag(Flags, LocalRootSignature);
                    },
                    en_CBVSRVUAVHeapDirectlyIndexed => {
                        Flags = maybeOrFlag(Flags, CBVSRVUAVHeapDirectlyIndexed);
                    },
                    en_SamplerHeapDirectlyIndexed => {
                        Flags = maybeOrFlag(Flags, SamplerHeapDirectlyIndexed);
                    },
                    _ => {
                        llvm_unreachable_internal("Switch for consumed enum token was not provided", "P:/Goraw/llvm-project/clang/lib/Parse/ParseHLSLRootSignature.cpp", 169);
                    },
                }
            } else {
                self.consumeNextToken();
                self.reportDiag(err_hlsl_invalid_token) << 1 << kw_RootFlags;
                return nullopt;
            }
        }
            if !(self.tryConsumeExpectedToken(pu_or)) { break; }
        }
    }
    if self.consumeExpectedToken(pu_r_paren, err_expected_either, pu_comma) {
        return nullopt;
    }
    return Flags;
}

fn RootSignatureParser::parseRootConstants(self) -> optional<RootConstants> {
    assert!(self.CurToken.TokKind == kw_RootConstants, "Expects to only be invoked starting at given keyword");
    if self.consumeExpectedToken(pu_l_paren, err_expected_after, self.CurToken.TokKind) {
        return nullopt;
    }
    let mut Constants: RootConstants = RootConstants {};
    let mut Params: optional<ParsedConstantParams> = self.parseRootConstantParams();
    if !Params.has_value() {
        return nullopt;
    }
    if self.consumeExpectedToken(pu_r_paren, err_expected_either, pu_comma) {
        return nullopt;
    }
    if !operator(Params).Num32BitConstants.has_value() {
        self.reportDiag(err_hlsl_rootsig_missing_param) << kw_num32BitConstants;
        return nullopt;
    }
    Constants.Num32BitConstants = operator(Params).Num32BitConstants.value();
    if !operator(Params).Reg.has_value() {
        self.reportDiag(err_hlsl_rootsig_missing_param) << bReg;
        return nullopt;
    }
    Constants.Reg = operator(Params).Reg.value();
    if operator(Params).Visibility.has_value() {
        Constants.Visibility = operator(Params).Visibility.value();
    }
    if operator(Params).Space.has_value() {
        Constants.Space = operator(Params).Space.value();
    }
    return Constants;
}

fn RootSignatureParser::parseRootDescriptor(self) -> optional<RootDescriptor> {
    assert!((self.CurToken.TokKind == kw_CBV || self.CurToken.TokKind == kw_SRV || self.CurToken.TokKind == kw_UAV), "Expects to only be invoked starting at given keyword");
    let mut DescriptorKind: TokenKind = self.CurToken.TokKind;
    if self.consumeExpectedToken(pu_l_paren, err_expected_after, self.CurToken.TokKind) {
        return nullopt;
    }
    let mut Descriptor: RootDescriptor = RootDescriptor {};
    let mut ExpectedReg: TokenKind = zeroed();
    match DescriptorKind {
        _ => {
            llvm_unreachable_internal("Switch for consumed token was not provided", "P:/Goraw/llvm-project/clang/lib/Parse/ParseHLSLRootSignature.cpp", 247);
        },
        kw_CBV => {
            Descriptor.Type = CBuffer;
        },
        kw_SRV => {
            Descriptor.Type = SRV;
        },
        kw_UAV => {
            Descriptor.Type = UAV;
        },
    }
    Descriptor.setDefaultFlags(self.Version);
    let mut Params: optional<ParsedRootDescriptorParams> = self.parseRootDescriptorParams(DescriptorKind, ExpectedReg);
    if !Params.has_value() {
        return nullopt;
    }
    if self.consumeExpectedToken(pu_r_paren, err_expected_either, pu_comma) {
        return nullopt;
    }
    if !operator(Params).Reg.has_value() {
        self.reportDiag(err_hlsl_rootsig_missing_param) << ExpectedReg;
        return nullopt;
    }
    Descriptor.Reg = operator(Params).Reg.value();
    if operator(Params).Space.has_value() {
        Descriptor.Space = operator(Params).Space.value();
    }
    if operator(Params).Visibility.has_value() {
        Descriptor.Visibility = operator(Params).Visibility.value();
    }
    if operator(Params).Flags.has_value() {
        Descriptor.Flags = operator(Params).Flags.value();
    }
    return Descriptor;
}

fn RootSignatureParser::parseDescriptorTable(self) -> optional<DescriptorTable> {
    assert!(self.CurToken.TokKind == kw_DescriptorTable, "Expects to only be invoked starting at given keyword");
    if self.consumeExpectedToken(pu_l_paren, err_expected_after, self.CurToken.TokKind) {
        return nullopt;
    }
    let mut Table: DescriptorTable = DescriptorTable {};
    let mut Visibility: ShaderVisibility> = ShaderVisibility> {};
    while !self.peekExpectedToken(pu_r_paren) {
        if self.tryConsumeExpectedToken([kw_CBV, kw_SRV, kw_UAV, kw_Sampler]) {
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Clause: DescriptorTableClause> = self.parseDescriptorTableClause();
            if !Clause.has_value() {
                self.skipUntilExpectedToken(pu_r_paren);
                self.consumeNextToken();
                return nullopt;
            }
            self.Elements.push(ElementLoc, operator(Clause));
            Table.NumClauses += 1;
        } else if self.tryConsumeExpectedToken(kw_visibility) {
            if Visibility.has_value() {
                self.reportDiag(err_hlsl_rootsig_repeat_param) << self.CurToken.TokKind;
                return nullopt;
            }
            if self.consumeExpectedToken(pu_equal, err_expected, invalid) {
                return nullopt;
            }
            Visibility = self.parseShaderVisibility(kw_visibility);
            if !Visibility.has_value() {
                return nullopt;
            }
        } else {
            self.consumeNextToken();
            self.reportDiag(err_hlsl_invalid_token) << 0 << kw_DescriptorTable;
            return nullopt;
        }
        if !self.tryConsumeExpectedToken(pu_comma) {
            break;
        }
    }
    if self.consumeExpectedToken(pu_r_paren, err_expected_either, pu_comma) {
        return nullopt;
    }
    if Visibility.has_value() {
        Table.Visibility = Visibility.value();
    }
    return Table;
}

fn RootSignatureParser::parseDescriptorTableClause(self) -> optional<DescriptorTableClause> {
    assert!((self.CurToken.TokKind == kw_CBV || self.CurToken.TokKind == kw_SRV || self.CurToken.TokKind == kw_UAV || self.CurToken.TokKind == kw_Sampler), "Expects to only be invoked starting at given keyword");
    let mut ParamKind: TokenKind = self.CurToken.TokKind;
    if self.consumeExpectedToken(pu_l_paren, err_expected_after, self.CurToken.TokKind) {
        return nullopt;
    }
    let mut Clause: DescriptorTableClause = DescriptorTableClause {};
    let mut ExpectedReg: TokenKind = zeroed();
    match ParamKind {
        _ => {
            llvm_unreachable_internal("Switch for consumed token was not provided", "P:/Goraw/llvm-project/clang/lib/Parse/ParseHLSLRootSignature.cpp", 373);
        },
        kw_CBV => {
            Clause.Type = CBuffer;
        },
        kw_SRV => {
            Clause.Type = SRV;
        },
        kw_UAV => {
            Clause.Type = UAV;
        },
        kw_Sampler => {
            Clause.Type = Sampler;
        },
    }
    Clause.setDefaultFlags(self.Version);
    let mut Params: optional<ParsedClauseParams> = self.parseDescriptorTableClauseParams(ParamKind, ExpectedReg);
    if !Params.has_value() {
        return nullopt;
    }
    if self.consumeExpectedToken(pu_r_paren, err_expected_either, pu_comma) {
        return nullopt;
    }
    if !operator(Params).Reg.has_value() {
        self.reportDiag(err_hlsl_rootsig_missing_param) << ExpectedReg;
        return nullopt;
    }
    Clause.Reg = operator(Params).Reg.value();
    if operator(Params).NumDescriptors.has_value() {
        Clause.NumDescriptors = operator(Params).NumDescriptors.value();
    }
    if operator(Params).Space.has_value() {
        Clause.Space = operator(Params).Space.value();
    }
    if operator(Params).Offset.has_value() {
        Clause.Offset = operator(Params).Offset.value();
    }
    if operator(Params).Flags.has_value() {
        Clause.Flags = operator(Params).Flags.value();
    }
    return Clause;
}

fn RootSignatureParser::parseStaticSampler(self) -> optional<StaticSampler> {
    assert!(self.CurToken.TokKind == kw_StaticSampler, "Expects to only be invoked starting at given keyword");
    if self.consumeExpectedToken(pu_l_paren, err_expected_after, self.CurToken.TokKind) {
