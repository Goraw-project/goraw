const RootElementKeywords: [6]TokenKind = [kw_RootFlags, kw_CBV, kw_UAV, kw_SRV, kw_DescriptorTable, kw_StaticSampler];

fn RootSignatureParser::parse(self) -> bool {
    let mut HadError: bool = false;
    let mut HasRootFlags: bool = false;
    while !self.peekExpectedToken(end_of_stream) {
        if self.tryConsumeExpectedToken(kw_RootFlags) {
            if HasRootFlags {
                self.reportDiag << kw_RootFlags;
                HadError = true;
                continue;
            }
            HasRootFlags = true;
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Flags: auto = self.parseRootFlags;
            if operator!() {
                HadError = true;
                continue;
            }
        } else if self.tryConsumeExpectedToken(kw_RootConstants) {
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Constants: auto = self.parseRootConstants;
            if operator!() {
                HadError = true;
                continue;
            }
        } else if self.tryConsumeExpectedToken(kw_DescriptorTable) {
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Table: auto = self.parseDescriptorTable;
            if operator!() {
                HadError = true;
                self.skipUntilClosedParens(1);
                self.consumeNextToken();
                continue;
            }
        } else if  {
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Descriptor: auto = self.parseRootDescriptor;
            if operator!() {
                HadError = true;
                continue;
            }
        } else if self.tryConsumeExpectedToken(kw_StaticSampler) {
            let mut ElementLoc: SourceLocation = self.getTokenLocation(self.CurToken);
            let mut Sampler: auto = self.parseStaticSampler;
            if operator!() {
                HadError = true;
                continue;
            }
        } else {
            HadError = true;
            self.consumeNextToken();
            self.reportDiag << 0 << kw_RootSignature;
            continue;
        }
        if !self.tryConsumeExpectedToken(pu_comma) {
            break;
        }
    }
    return HadError || self.consumeExpectedToken;
}

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: maybeOrFlag]
// template <typename FlagType>
// fn maybeOrFlag(Flags: optional<FlagType>, Flag: FlagType) -> FlagType {
//     if operator!(Flags()) {
//         return Flag;
//     }
//     return to_underlying(Flags()) | to_underlying(Flag) as FlagType;
// }
// ========================================================

fn RootSignatureParser::parseRootFlags(self) -> RootFlags> {
    assert!(self.CurToken.TokKind == kw_RootFlags, "Expects to only be invoked starting at given keyword");
    if self.consumeExpectedToken {
        return nullopt();
    }
    let mut Flags: RootFlags> = zeroed();
    if self.tryConsumeExpectedToken(pu_r_paren) {
        return ;
    }
    if self.tryConsumeExpectedToken(int_literal) {
        if !self.verifyZeroFlag() {
            self.reportDiag;
            return nullopt();
        }
    } else {
        let mut Expected: [12]TokenKind = [en_AllowInputAssemblerInputLayout, en_DenyVertexShaderRootAccess, en_DenyHullShaderRootAccess, en_DenyDomainShaderRootAccess, en_DenyGeometryShaderRootAccess, en_DenyPixelShaderRootAccess, en_DenyAmplificationShaderRootAccess, en_DenyMeshShaderRootAccess, en_AllowStreamOutput, en_LocalRootSignature, en_CBVSRVUAVHeapDirectlyIndexed, en_SamplerHeapDirectlyIndexed];
        while true {
            {
            if  {
                match self.CurToken.TokKind {
                    en_AllowInputAssemblerInputLayout => {
                        Flags() = maybeOrFlag(AllowInputAssemblerInputLayout);
                    },
                    en_DenyVertexShaderRootAccess => {
                        Flags() = maybeOrFlag(DenyVertexShaderRootAccess);
                    },
                    en_DenyHullShaderRootAccess => {
                        Flags() = maybeOrFlag(DenyHullShaderRootAccess);
                    },
                    en_DenyDomainShaderRootAccess => {
                        Flags() = maybeOrFlag(DenyDomainShaderRootAccess);
                    },
                    en_DenyGeometryShaderRootAccess => {
                        Flags() = maybeOrFlag(DenyGeometryShaderRootAccess);
                    },
                    en_DenyPixelShaderRootAccess => {
                        Flags() = maybeOrFlag(DenyPixelShaderRootAccess);
                    },
                    en_DenyAmplificationShaderRootAccess => {
                        Flags() = maybeOrFlag(DenyAmplificationShaderRootAccess);
                    },
                    en_DenyMeshShaderRootAccess => {
                        Flags() = maybeOrFlag(DenyMeshShaderRootAccess);
                    },
                    en_AllowStreamOutput => {
                        Flags() = maybeOrFlag(AllowStreamOutput);
                    },
                    en_LocalRootSignature => {
                        Flags() = maybeOrFlag(LocalRootSignature);
                    },
                    en_CBVSRVUAVHeapDirectlyIndexed => {
                        Flags() = maybeOrFlag(CBVSRVUAVHeapDirectlyIndexed);
                    },
                    en_SamplerHeapDirectlyIndexed => {
                        Flags() = maybeOrFlag(SamplerHeapDirectlyIndexed);
                    },
                    _ => {
                        llvm_unreachable_internal("Switch for consumed enum token was not provided", "clang\\lib\\Parse\\ParseHLSLRootSignature.cpp", 169);
                    },
                }
            } else {
                self.consumeNextToken();
                self.reportDiag << 1 << kw_RootFlags;
                return nullopt();
            }
        }
            if !(self.tryConsumeExpectedToken(pu_or)) { break; }
        }
    }
    if self.consumeExpectedToken {
        return nullopt();
    }
    return ;
}

