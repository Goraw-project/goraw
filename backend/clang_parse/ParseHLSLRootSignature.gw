fn RootSignatureParser::handleUIntLiteral(self) -> optional<uint32_t> {
    let mut Literal: NumericLiteralParser = NumericLiteralParser { self.CurToken.NumSpelling, self.getTokenLocation(self.CurToken), self.PP.getSourceManager(), self.PP.getLangOpts(), self.PP.getTargetInfo(), self.PP.getDiagnostics() };
    if Literal.hadError {
        return nullopt;
    }
    assert!(Literal.isIntegerLiteral(), "NumSpelling can only consist of digits");
    let mut Val: APSInt = APSInt { 32, true };
    if Literal.GetIntegerValue(Val) {
        self.reportDiag(err_hlsl_number_literal_overflow) << 0 << 0;
        return nullopt;
    }
    return Val.getExtValue();
}

fn RootSignatureParser::handleIntLiteral(self, Negated: bool) -> optional<int32_t> {
    let mut Literal: NumericLiteralParser = NumericLiteralParser { self.CurToken.NumSpelling, self.getTokenLocation(self.CurToken), self.PP.getSourceManager(), self.PP.getLangOpts(), self.PP.getTargetInfo(), self.PP.getDiagnostics() };
    if Literal.hadError {
        return nullopt;
    }
    assert!(Literal.isIntegerLiteral(), "NumSpelling can only consist of digits");
    let mut Val: APSInt = APSInt { 32, true };
    let mut Overflowed: bool = Literal.GetIntegerValue(Val);
    let mut MaxNegativeMagnitude: i64 = -min();
    Overflowed |= (Negated && MaxNegativeMagnitude < Val.getExtValue());
    let mut MaxPositiveMagnitude: i64 = max();
    Overflowed |= (!Negated && MaxPositiveMagnitude < Val.getExtValue());
    if Overflowed {
        self.reportDiag(err_hlsl_number_literal_overflow) << 0 << 1;
        return nullopt;
    }
    if Negated {
        Val = operator(Val);
    }
    return Val.getExtValue();
}

fn RootSignatureParser::handleFloatLiteral(self, Negated: bool) -> optional<float> {
    let mut Literal: NumericLiteralParser = NumericLiteralParser { self.CurToken.NumSpelling, self.getTokenLocation(self.CurToken), self.PP.getSourceManager(), self.PP.getLangOpts(), self.PP.getTargetInfo(), self.PP.getDiagnostics() };
    if Literal.hadError {
        return nullopt;
    }
    assert!(Literal.isFloatingLiteral(), "NumSpelling consists only of [0-9.ef+-]. Any malformed NumSpelling will be caught and reported by NumericLiteralParser.");
    let mut DXCSemantics: Semantics = S_IEEEdouble;
    let mut DXCRoundingMode: RoundingMode = NearestTiesToEven;
    let mut Val: APFloat = EnumToSemantics(DXCSemantics);
    let mut Status: opStatus = Literal.GetFloatValue(Val, DXCRoundingMode);
    assert!(!(Status & opInvalidOp), "NumSpelling consists only of [0-9.ef+-]. Any malformed NumSpelling will be caught and reported by NumericLiteralParser.");
    assert!(!(Status & opDivByZero), "It is not possible for a division to be performed when constructing an APFloat from a string");
    if Status & opUnderflow {
        self.reportDiag(err_hlsl_number_literal_underflow);
        return nullopt;
    }
    if Status & opOverflow {
        self.reportDiag(err_hlsl_number_literal_overflow) << 1;
        return nullopt;
    }
    if Negated {
        Val = operator(Val);
    }
    let mut DoubleVal: f64 = Val.convertToDouble();
    let mut FloatMax: f64 = max();
    if FloatMax < DoubleVal || DoubleVal < -FloatMax {
        self.reportDiag(err_hlsl_number_literal_overflow) << 1;
        return nullopt;
    }
    return DoubleVal as f32;
}

fn RootSignatureParser::verifyZeroFlag(self) -> bool {
    assert!(self.CurToken.TokKind == int_literal);
    let mut X: optional<uint32_t> = self.handleUIntLiteral();
    return X.has_value() && X.value() == 0;
}

fn RootSignatureParser::peekExpectedToken(self, Expected: TokenKind) -> bool {
    return self.peekExpectedToken(Kind> { [Expected] });
}

fn RootSignatureParser::peekExpectedToken(self, AnyExpected: ArrayRef<TokenKind>) -> bool {
    let mut Result: RootSignatureToken = self.Lexer.peekNextToken();
    return is_contained(AnyExpected, Result.TokKind);
}

fn RootSignatureParser::consumeExpectedToken(self, Expected: TokenKind, DiagID: u32, Context: TokenKind) -> bool {
    if self.tryConsumeExpectedToken(Expected) {
        return false;
    }
    let mut DB: DiagnosticBuilder = self.reportDiag(DiagID);
    match DiagID {
        err_expected => {
            DB << Expected;
        },
        err_expected_either => {
            DB << Expected << Context;
        },
        err_expected_after => {
            DB << Context << Expected;
        },
        _ => {
            break;
        },
    }
    return true;
}

fn RootSignatureParser::tryConsumeExpectedToken(self, Expected: TokenKind) -> bool {
    return self.tryConsumeExpectedToken(Kind> { [Expected] });
}

fn RootSignatureParser::tryConsumeExpectedToken(self, AnyExpected: ArrayRef<TokenKind>) -> bool {
    if !self.peekExpectedToken(AnyExpected) {
        return false;
    }
    self.consumeNextToken();
    return true;
}

fn RootSignatureParser::skipUntilExpectedToken(self, Expected: TokenKind) -> bool {
    return self.skipUntilExpectedToken(Kind> { [Expected] });
}

fn RootSignatureParser::skipUntilExpectedToken(self, AnyExpected: ArrayRef<TokenKind>) -> bool {
    while !self.peekExpectedToken(AnyExpected) {
        if self.peekExpectedToken(end_of_stream) {
            return false;
        }
        self.consumeNextToken();
    }
    return true;
}

fn RootSignatureParser::skipUntilClosedParens(self, NumParens: u32) -> bool {
    let mut ParenKinds: [2]TokenKind = [pu_l_paren, pu_r_paren];
    while self.skipUntilExpectedToken(ParenKinds) {
        self.consumeNextToken();
        if self.CurToken.TokKind == pu_r_paren {
            NumParens -= 1;
        } else {
            NumParens += 1;
        }
        if NumParens == 0 {
            return true;
        }
    }
    return false;
}

fn RootSignatureParser::getTokenLocation(self, Tok: RootSignatureToken) -> SourceLocation {
    return self.Signature.getLocationOfByte(Tok.LocOffset, self.PP.getSourceManager(), self.PP.getLangOpts(), self.PP.getTargetInfo(), null, null);
}

fn ParseHLSLRootSignature(Actions: *mut Sema, Version: RootSignatureVersion, Signature: *mut StringLiteral) -> *mut IdentifierInfo {
    if !Found {
        let mut Parser: RootSignatureParser = RootSignatureParser { Version, Signature, Actions.getPreprocessor() };
        if Parser.parse() {
            return null;
        }
        Actions.HLSL().ActOnFinishRootSignatureDecl(Signature.getBeginLoc(), DeclIdent, Parser.getElements());
    }
    return DeclIdent;
}

fn HandleRootSignatureTarget(S: *mut Sema, EntryRootSig: str) {
    let mut Consumer: *mut ASTConsumer = &mut S.getASTConsumer();
    let mut P: unique_ptr<Parser> = Parser { S.getPreprocessor(), S, true };
    S.getPreprocessor().EnterMainSourceFile();
    let mut HaveLexer: bool = S.getPreprocessor().getCurrentLexer();
    if HaveLexer {
        operator(P).Initialize();
        S.ActOnStartOfTranslationUnit();
        while operator(P).getCurToken().getKind() != eof {
            operator(P).ConsumeAnyToken(false);
        }
        let mut SignatureDecl: *mut HLSLRootSignatureDecl = S.HLSL().lookupRootSignatureOverrideDecl(S.getASTContext().getTranslationUnitDecl());
        if SignatureDecl {
            Consumer.HandleTopLevelDecl(SignatureDecl);
        } else {
            S.getDiagnostics().Report(err_hlsl_rootsignature_entry) << EntryRootSig;
        }
    }
    Consumer.HandleTranslationUnit(S.getASTContext());
}
