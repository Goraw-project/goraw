            Params.Flags = Flags;
        } else {
            self.consumeNextToken();
            self.reportDiag(err_hlsl_invalid_token) << 0 << ClauseKind;
            return nullopt;
        }
        if !self.tryConsumeExpectedToken(pu_comma) {
            break;
        }
    }
    return Params;
}

fn RootSignatureParser::parseStaticSamplerParams(self) -> ParsedStaticSamplerParams> {
    assert!(self.CurToken.TokKind == pu_l_paren, "Expects to only be invoked starting at given token");
    let mut Params: ParsedStaticSamplerParams = ParsedStaticSamplerParams {};
