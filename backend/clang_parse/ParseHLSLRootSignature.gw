        return nullopt;
    }
    Sampler.Reg = operator(Params).Reg.value();
    if operator(Params).Filter.has_value() {
        Sampler.Filter = operator(Params).Filter.value();
    }
    if operator(Params).AddressU.has_value() {
        Sampler.AddressU = operator(Params).AddressU.value();
    }
    if operator(Params).AddressV.has_value() {
        Sampler.AddressV = operator(Params).AddressV.value();
    }
    if operator(Params).AddressW.has_value() {
