fn Parser::ParseCXXReflectExpression(self) -> ExprResult {
    let mut Unevaluated: EnterExpressionEvaluationContext = EnterExpressionEvaluationContext { self.Actions, Unevaluated, null, EK_Other, true };
    assert!(self.Tok.is(caretcaret);
    let mut CaretCaretLoc: SourceLocation = self.ConsumeToken();
    let mut OperandLoc: SourceLocation = self.Tok.getLocation();
    if self.isCXXTypeId(AsReflectionOperand) {
        let mut TR: TypeResult = self.ParseTypeName(null, TypeName, AS_none, null, null);
        if TR.isInvalid() {
            return ExprError();
        }
        let mut TSI: *mut TypeSourceInfo = null;
        let mut QT: QualType = self.Actions.GetTypeFromParser(TR.get(), &mut TSI);
        if QT.isNull() {
            return ExprError();
        }
        if !TSI {
            TSI = self.Actions.getASTContext().getTrivialTypeSourceInfo(QT, OperandLoc);
        }
        QT = QT.getCanonicalType().getUnqualifiedType();
        if TSI && QT.getTypePtr().isBuiltinType() {
            return self.Actions.ActOnCXXReflectExpr(CaretCaretLoc, TSI);
        }
    }
    self.Diag(OperandLoc, err_cannot_reflect_operand);
    return ExprError();
}
