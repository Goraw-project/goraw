fn optimizeVectorResizeWithIntegerBitCasts(InVal: *mut Value, DestTy: *mut VectorType, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut SrcTy: *mut VectorType = cast(InVal.getType());
    if SrcTy.getElementType() != DestTy.getElementType() {
        if SrcTy.getElementType().getPrimitiveSizeInBits() {
            return null;
        }
        SrcTy = get(DestTy.getElementType(), cast(SrcTy)());
        InVal = IC()(InVal, SrcTy);
    }
    let mut IsBigEndian: bool = IC.getDataLayout();
    let mut SrcElts: u32 = cast(SrcTy)();
    let mut DestElts: u32 = cast(DestTy)();
    assert!(SrcElts != DestElts, "Element counts should be different.");
    let mut ShuffleMaskStorage: auto = to_vector(seq(0, SrcElts));
    let mut ShuffleMask: ArrayRef<int> = zeroed();
    let mut V2: *mut Value = null;
    if SrcElts > DestElts {
        V2 = get(SrcTy);
        ShuffleMask() = ;
        if IsBigEndian {
            ShuffleMask() = (DestElts);
        } else {
            ShuffleMask() = (DestElts);
        }
    } else {
        V2 = getNullValue(SrcTy);
        let mut NullElt: u32 = SrcElts;
        let mut DeltaElts: u32 = DestElts - SrcElts;
        if IsBigEndian {
            ShuffleMaskStorage()(DeltaElts, NullElt);
        } else {
            ShuffleMaskStorage()(DeltaElts, NullElt);
        }
        ShuffleMask() = ;
    }
    return InVal;
}

fn isMultipleOfTypeSize(Value: u32, Ty: *mut Type) -> bool {
    return Value(Ty.getPrimitiveSizeInBits()) == 0;
}

fn getTypeSizeIndex(Value: u32, Ty: *mut Type) -> u32 {
    return Value(Ty.getPrimitiveSizeInBits());
}

fn collectInsertionElements(V: *mut Value, Shift: u32, Elements: *mut SmallVectorImpl<Value *>, VecEltTy: *mut Type, isBigEndian: bool) -> bool {
    assert!(isMultipleOfTypeSize(Shift, VecEltTy), "Shift should be a multiple of the element type size");
    if match(V) {
        return true;
    }
    if V.getType() == VecEltTy {
        if dyn_cast(V) {
            C;
        } else if C.isNullValue() {
            return true;
        }
        let mut ElementIndex: u32 = getTypeSizeIndex(Shift, VecEltTy);
        if isBigEndian {
            ElementIndex = Elements()() - ElementIndex - 1;
        }
        if  {
            return false;
        }
        return true;
    }
    if dyn_cast(V) {
        C;
    } else {
        let mut NumElts: u32 = getTypeSizeIndex(C.getType().getPrimitiveSizeInBits(), VecEltTy);
        if NumElts == 1 {
            return collectInsertionElements(getBitCast(C, VecEltTy, false), Shift, Elements, VecEltTy, isBigEndian);
        }
        if !isa(C.getType()) {
            C = getBitCast(C, get(V.getContext(), C.getType().getPrimitiveSizeInBits()));
        }
        let mut ElementSize: u32 = VecEltTy.getPrimitiveSizeInBits();
        let mut ElementIntTy: *mut Type = get(C.getContext(), ElementSize);
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            let mut ShiftI: u32 = i * ElementSize;
            let mut Piece: *mut Constant = ConstantFoldBinaryInstruction(LShr, C, get(C.getType(), ShiftI, false, false));
            if !Piece {
                return false;
            }
            Piece = getTrunc(Piece, ElementIntTy, false);
            if !collectInsertionElements(Piece, ShiftI + Shift, Elements, VecEltTy, isBigEndian) {
                return false;
            }
        }
        return true;
    }
    if !V.hasOneUse() {
        return false;
    }
    let mut I: *mut Instruction = dyn_cast(V);
    if !I {
        return false;
    }
    match I.getOpcode() {
        _ => {
            return false;
        },
        BitCast => {
            if I.getOperand()() {
                return false;
            }
        },
        ZExt => {
            if operator!(isMultipleOfTypeSize(I.getOperand()(), VecEltTy)) {
                return false;
            }
        },
        Or => {
            return collectInsertionElements(I.getOperand, Shift, Elements, VecEltTy, isBigEndian) && collectInsertionElements(I.getOperand, Shift, Elements, VecEltTy, isBigEndian);
        },
        Shl => {
            let mut CI: *mut ConstantInt = dyn_cast(I.getOperand);
            if !CI {
                return false;
            }
            Shift += CI.getZExtValue();
            if !isMultipleOfTypeSize(Shift, VecEltTy) {
                return false;
            }
            return collectInsertionElements(I.getOperand, Shift, Elements, VecEltTy, isBigEndian);
        },
    }
}

fn optimizeIntegerToVectorInsertions(CI: *mut BitCastInst, IC: *mut InstCombinerImpl) -> *mut Value {
    let mut DestVecTy: *mut auto = cast(CI.getType);
    let mut IntInput: *mut Value = CI.getOperand;
    if isa(IntInput) {
        return null;
    }
    let mut Elements: SmallVector<Value *, 8> = zeroed();
    if operator!(collectInsertionElements(IntInput, 0, IC.getDataLayout())) {
        return null;
    }
    let mut Result: *mut Value = getNullValue(CI.getType);
    for let mut i: u32 = 0;
let mut e: u32 = (); i != e; i += 1 {
        if operator!([i]) {
            continue;
        }
        Result = IC()(Result, [i], i);
    }
    return Result;
}

fn canonicalizeBitCastExtElt(BitCast: *mut BitCastInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut VecOp: *mut Value = null;
    let mut Index: *mut Value = null;
    if operator!(match(BitCast.getOperand, m_OneUse(m_ExtractElt(m_Value(VecOp), m_Value(Index))))) {
        return null;
