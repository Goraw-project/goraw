        let mut Cond: *mut Value = null;
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if match(Op, m_Select(m_Value(Cond), m_FPExt(m_SpecificType(Ty, X)), m_Value(Y))) {
            let mut NarrowY: *mut Value = null;
            let mut Sel: *mut Value = null;
            return self.replaceInstUsesWith;
        }
        if match(Op, m_Select(m_Value(Cond), m_Value(Y), m_FPExt(m_SpecificType(Ty, X)))) {
            let mut NarrowY: *mut Value = null;
            let mut Sel: *mut Value = null;
            return self.replaceInstUsesWith;
        }
    }
    if  {
        match II()() {
            _ => {
                break;
            },
            ceil => {
                fabs;
            },
        }
    }
    if shrinkInsertElt(FPT) {
        I;
    } else {
        return I;
    }
    let mut Src: *mut Value = FPT.getOperand;
    if isa(Src) || isa(Src) {
        let mut FPCast: *mut auto = cast(Src);
        if self.isKnownExactCastIntToFP(operator*()) {
