struct Closure_12 {}

fn Closure_12::call(self: *Closure_12, U: *mut User) -> bool {
        if isa(U) {
            return true;
        }
        if dyn_cast(U) {
            P;
        } else {
            return P.hasOneUse() && isa(operator(P.user_begin()));
        }
        return false;
    }
