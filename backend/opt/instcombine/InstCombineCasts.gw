fn InstCombiner::canBeCastedExactlyIntToFP(self: *InstCombiner, V: *mut Value, FPTy: *mut Type, IsSigned: bool, CtxI: *Instruction) -> bool {
    let mut SrcTy: *mut Type = V.getType();
    assert!(SrcTy.isIntOrIntVectorTy(), "Expected an integer type");
    let mut SrcSize: i32 = SrcTy.getScalarSizeInBits() as i32 - IsSigned;
    let mut DestNumSigBits: i32 = FPTy.getFPMantissaWidth();
    if SrcSize <= DestNumSigBits {
        return true;
    }
    let mut F: *mut Value = null;
    if match(V, m_FPToI(m_Value(F))) {
        let mut SrcNumSigBits: i32 = F.getType().getFPMantissaWidth();
        if !IsSigned && match(V, m_FPToSI(m_Value())) {
            SrcNumSigBits += 1;
        }
        if SrcNumSigBits > 0 && DestNumSigBits > 0 && SrcNumSigBits <= DestNumSigBits {
            return true;
        }
    }
    let mut SrcKnown: KnownBits = self.computeKnownBits(V, CtxI, 0);
    let mut SigBits: i32 = SrcTy.getScalarSizeInBits() as i32 - SrcKnown.countMinLeadingZeros() - SrcKnown.countMinTrailingZeros();
    if SigBits <= DestNumSigBits {
        return true;
    }
    if IsSigned {
        SigBits = SrcTy.getScalarSizeInBits() as i32 - self.ComputeNumSignBits(V, CtxI, 0);
        if SigBits <= DestNumSigBits {
            return true;
        }
    }
    return false;
}

fn InstCombiner::isKnownExactCastIntToFP(self: *InstCombiner, I: *mut CastInst) -> bool {
    let mut Opcode: CastOps = I.getOpcode();
    assert!((Opcode == SIToFP || Opcode == UIToFP), "Unexpected cast");
    let mut Src: *mut Value = I.getOperand;
    let mut FPTy: *mut Type = I.getType;
    return self.canBeCastedExactlyIntToFP;
}

fn InstCombinerImpl::visitFPTrunc(self, FPT: *mut FPTruncInst) -> *mut Instruction {
