fn EvaluateInDifferentTypeImpl(V: *mut Value, Ty: *mut Type, isSigned: bool, IC: *mut InstCombinerImpl, Processed: *mut EvaluatedMap) -> *mut Value {
    if Processed.lookup(V) {
        Result;
    } else {
        return Result;
    }
    if dyn_cast(V) {
        C;
    } else {
        return ConstantFoldIntegerCast(C, Ty, isSigned, IC.getDataLayout());
    }
    let mut I: *mut Instruction = cast(V);
    let mut Res: *mut Instruction = null;
    let mut Opc: u32 = I.getOpcode();
    match Opc {
        Add => {
            Sub;
        },
        Trunc => {
            ZExt;
        },
        Select => {
            let mut True: *mut Value = EvaluateInDifferentTypeImpl(I.getOperand(1), Ty, isSigned, IC, Processed);
            let mut False: *mut Value = EvaluateInDifferentTypeImpl(I.getOperand(2), Ty, isSigned, IC, Processed);
            Res = Create(I.getOperand(0), True, False, "", null, null);
            break;
        },
        PHI => {
            let mut OPN: *mut PHINode = cast(I);
            let mut NPN: *mut PHINode = Create(Ty, OPN.getNumIncomingValues(), "", null);
            for let mut i: u32 = 0;
let mut e: u32 = OPN.getNumIncomingValues(); i != e; i += 1 {
                let mut V: *mut Value = EvaluateInDifferentTypeImpl(OPN.getIncomingValue(i), Ty, isSigned, IC, Processed);
                NPN.addIncoming(V, OPN.getIncomingBlock(i));
            }
            Res = NPN;
            break;
        },
        FPToUI => {
            FPToSI;
        },
        Call => {
            if dyn_cast(I) {
                II;
            } else {
                match II.getIntrinsicID() {
                    _ => {
                        llvm_unreachable_internal("Unsupported call!", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineCasts.cpp", 129);
                    },
                    vscale => {
                        let mut Fn: *mut Function = getOrInsertDeclaration(I.getModule(), vscale, [Ty]);
                        Res = Create(Fn.getFunctionType(), Fn, "", null);
                        break;
                    },
                    umin => {
                        umax;
                    },
                    abs => {
                        let mut Arg: *mut Value = EvaluateInDifferentTypeImpl(II.getArgOperand(0), Ty, isSigned, IC, Processed);
                        let mut Fn: *mut Function = getOrInsertDeclaration(I.getModule(), II.getIntrinsicID(), [Ty]);
                        Res = Create(Fn.getFunctionType(), Fn, [Arg, getFalse(I.getContext())], ArrayRef<OperandBundleDef> {}, "", null);
                        break;
                    },
                }
            }
        },
        ShuffleVector => {
            let mut ScalarTy: *mut Type = cast(Ty).getElementType();
            let mut VTy: *mut VectorType = cast(I.getOperand(0).getType());
            let mut FixedTy: *mut VectorType = get(ScalarTy, VTy.getElementCount());
            let mut Op0: *mut Value = EvaluateInDifferentTypeImpl(I.getOperand(0), FixedTy, isSigned, IC, Processed);
            let mut Op1: *mut Value = EvaluateInDifferentTypeImpl(I.getOperand(1), FixedTy, isSigned, IC, Processed);
            Res = ShuffleVectorInst { Op0, Op1, cast(I).getShuffleMask(), "", null };
            break;
        },
        _ => {
            llvm_unreachable_internal("Unreachable!", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineCasts.cpp", 175);
        },
    }
    Res.takeName(I);
    let mut Result: *mut Value = IC.InsertNewInstWith(Res, I.getIterator());
    if !V.hasOneUse() {
        Processed[V] = Result;
    }
    return Result;
}

fn InstCombinerImpl::EvaluateInDifferentType(self, V: *mut Value, Ty: *mut Type, isSigned: bool) -> *mut Value {
    let mut Processed: EvaluatedMap = EvaluatedMap {};
    return EvaluateInDifferentTypeImpl(V, Ty, isSigned, *self, Processed);
}

fn InstCombinerImpl::isEliminableCastPair(self, CI1: *CastInst, CI2: *CastInst) -> CastOps {
    let mut SrcTy: *mut Type = CI1.getSrcTy();
    let mut MidTy: *mut Type = CI1.getDestTy();
    let mut DstTy: *mut Type = CI2.getDestTy();
    let mut firstOp: CastOps = CI1.getOpcode();
    let mut secondOp: CastOps = CI2.getOpcode();
    let mut SrcIntPtrTy: *mut Type = if SrcTy.isPtrOrPtrVectorTy() { self.DL.getIntPtrType(SrcTy) } else { null };
    let mut DstIntPtrTy: *mut Type = if DstTy.isPtrOrPtrVectorTy() { self.DL.getIntPtrType(DstTy) } else { null };
    let mut Res: u32 = isEliminableCastPair(firstOp, secondOp, SrcTy, MidTy, DstTy, &mut self.DL);
    if (Res == IntToPtr && SrcTy != DstIntPtrTy) || (Res == PtrToInt && DstTy != SrcIntPtrTy) {
        Res = 0;
    }
    return Res;
}

fn InstCombinerImpl::commonCastTransforms(self, CI: *mut CastInst) -> *mut Instruction {
    let mut Src: *mut Value = CI.getOperand(0);
    let mut Ty: *mut Type = CI.getType();
    if simplifyCastInst(CI.getOpcode(), Src, Ty, self.SQ.getWithInstruction(&mut CI)) {
        Res;
    } else {
        return self.replaceInstUsesWith(CI, Res);
    }
    if dyn_cast(Src) {
        CSrc;
    } else {
        if self.isEliminableCastPair(CSrc, &mut CI) {
            NewOpc;
        } else {
            let mut Res: *mut CastInst = Create(NewOpc, CSrc.getOperand(0), Ty, "", null);
            if CSrc.hasOneUse() {
                replaceAllDbgUsesWith(*CSrc, *Res, CI, self.DT);
            }
            return Res;
        }
    }
    if dyn_cast(Src) {
        Sel;
    } else {
        let mut Cond: *mut Value = Sel.getCondition();
        if !isa(Cond) || cast(Cond).getOperand(0).getType() != Sel.getType() || (CI.getOpcode() == Trunc && self.shouldChangeType(CI.getSrcTy(), CI.getType())) {
            if CI.getOpcode() != BitCast || match(&mut CI, m_ElementWiseBitCast(m_Value())) {
                if self.FoldOpIntoSelect(CI, Sel, false, false) {
                    NV;
                } else {
                    replaceAllDbgUsesWith(*Sel, *NV, CI, self.DT);
                    return NV;
                }
            }
        }
    }
    if dyn_cast(Src) {
        PN;
    } else {
        if !Src.getType().isIntegerTy() || !CI.getType().isIntegerTy() || self.shouldChangeType(CI.getSrcTy(), CI.getType()) {
            if self.foldOpIntoPhi(CI, PN, false) {
                NV;
            } else {
                return NV;
            }
        }
    }
    let mut X: *mut Value = null;
    let mut Mask: ArrayRef<int> = ArrayRef<int> {};
    if match(Src, m_OneUse(m_Shuffle(m_Value(X), m_Poison(), Mask))) {
        let mut SrcTy: *mut FixedVectorType = dyn_cast(X.getType());
        let mut DestTy: *mut FixedVectorType = dyn_cast(Ty);
        if SrcTy && DestTy && SrcTy.getNumElements() == DestTy.getNumElements() && SrcTy.getPrimitiveSizeInBits() == DestTy.getPrimitiveSizeInBits() {
            let mut CastX: *mut Value = self.Builder.CreateCast(CI.getOpcode(), X, DestTy, "", null, FMFSource {});
            return ShuffleVectorInst { CastX, Mask, "", null };
        }
    }
    return null;
}

struct TypeEvaluationHelper {
    Visited: SmallDenseMap<Value *, bool, 8>,
    Pending: SmallVector<Value *, 8>,
}

fn TypeEvaluationHelper::allPendingVisited(self: *TypeEvaluationHelper) -> bool {
    return all_of(self.Pending, Closure_1 { cap_0: self });
}

fn TypeEvaluationHelper::canEvaluate(self, V: *mut Value, Ty: *mut Type, Pred: function_ref<bool (Value *, Type *)>) -> bool {
    if canAlwaysEvaluateInType(V, Ty) {
        return true;
    }
    let mut I: *mut Instruction = dyn_cast(V);
    if I == null {
        return false;
    }
    if !Inserted {
        return operator(It).getSecond();
    }
    if !I.hasOneUse() {
        for U in I.uses() {
            if isa(U.getUser()) && U.getOperandNo() == 0 {
                return false;
            }
            self.Pending.push(U.getUser());
        }
    }
    let mut Result: bool = Pred.call(V, Ty);
    self.Visited[V] = Result;
    return Result;
}

fn TypeEvaluationHelper::canAlwaysEvaluateInType(self, V: *mut Value, Ty: *mut Type) -> bool {
    if isa(V) {
        return match(V, m_ImmConstant());
    }
    let mut X: *mut Value = null;
    if match(V, m_ZExtOrSExt(m_SpecificType(Ty, X))) || match(V, m_Trunc(m_SpecificType(Ty, X))) {
        return true;
    }
    return false;
}

fn TypeEvaluationHelper::canNotEvaluateInType(self, V: *mut Value, Ty: *mut Type) -> bool {
    if !isa(V) {
        return true;
    }
    if !V.hasOneUse() {
        return true;
    }
    return false;
}

fn TypeEvaluationHelper::canEvaluateTruncated(self, V: *mut Value, Ty: *mut Type, IC: *mut InstCombinerImpl, CtxI: *mut Instruction) -> bool {
    let mut TYH: TypeEvaluationHelper = TypeEvaluationHelper {};
    return TYH.canEvaluateTruncatedImpl(V, Ty, IC, CtxI) && TYH.allPendingVisited();
}

fn TypeEvaluationHelper::canEvaluateTruncatedImpl(self, V: *mut Value, Ty: *mut Type, IC: *mut InstCombinerImpl, CtxI: *mut Instruction) -> bool {
    return self.canEvaluate(V, Ty, function_ref<bool (Value *, Type *)> { Closure_2 { cap_0: self, IC: &mut IC, CtxI: CtxI }, null, null });
}

fn TypeEvaluationHelper::canEvaluateTruncatedPred(self, V: *mut Value, Ty: *mut Type, IC: *mut InstCombinerImpl, CtxI: *mut Instruction) -> bool {
    let mut I: *mut Instruction = cast(V);
    let mut OrigTy: *mut Type = V.getType();
    match I.getOpcode() {
        Add => {
            Sub;
        },
        UDiv => {
            URem;
        },
        Shl => {
            let mut BitWidth: u32 = Ty.getScalarSizeInBits();
            let mut AmtKnownBits: KnownBits = computeKnownBits(I.getOperand(1), IC.getDataLayout(), null, null, null, true, 0);
            if AmtKnownBits.getMaxValue().ult(BitWidth) {
                return self.canEvaluateTruncatedImpl(I.getOperand(0), Ty, IC, CtxI) && self.canEvaluateTruncatedImpl(I.getOperand(1), Ty, IC, CtxI);
            }
            break;
        },
        LShr => {
            let mut OrigBitWidth: u32 = OrigTy.getScalarSizeInBits();
            let mut BitWidth: u32 = Ty.getScalarSizeInBits();
            let mut AmtKnownBits: KnownBits = IC.computeKnownBits(I.getOperand(1), CtxI, 0);
            let mut MaxShiftAmt: APInt = AmtKnownBits.getMaxValue();
            let mut ShiftedBits: APInt = getBitsSetFrom(OrigBitWidth, BitWidth);
            if MaxShiftAmt.ult(BitWidth) {
                if dyn_cast(V.user_back()) {
                    Trunc;
                } else {
                    let mut DemandedBits: u32 = Trunc.getType().getScalarSizeInBits();
                    if (MaxShiftAmt + DemandedBits).ule(BitWidth) {
                        return self.canEvaluateTruncatedImpl(I.getOperand(0), Ty, IC, CtxI) && self.canEvaluateTruncatedImpl(I.getOperand(1), Ty, IC, CtxI);
                    }
                }
                if IC.MaskedValueIsZero(I.getOperand(0), ShiftedBits, CtxI, 0) {
                    return self.canEvaluateTruncatedImpl(I.getOperand(0), Ty, IC, CtxI) && self.canEvaluateTruncatedImpl(I.getOperand(1), Ty, IC, CtxI);
                }
            }
            break;
        },
        AShr => {
            let mut OrigBitWidth: u32 = OrigTy.getScalarSizeInBits();
            let mut BitWidth: u32 = Ty.getScalarSizeInBits();
            let mut AmtKnownBits: KnownBits = computeKnownBits(I.getOperand(1), IC.getDataLayout(), null, null, null, true, 0);
            let mut ShiftedBits: u32 = OrigBitWidth - BitWidth;
            if AmtKnownBits.getMaxValue().ult(BitWidth) && ShiftedBits < IC.ComputeNumSignBits(I.getOperand(0), CtxI, 0) {
                return self.canEvaluateTruncatedImpl(I.getOperand(0), Ty, IC, CtxI) && self.canEvaluateTruncatedImpl(I.getOperand(1), Ty, IC, CtxI);
            }
            break;
        },
        Trunc => {
            return true;
        },
        ZExt => {
            SExt;
        },
        Select => {
            let mut SI: *mut SelectInst = cast(I);
            return self.canEvaluateTruncatedImpl(SI.getTrueValue(), Ty, IC, CtxI) && self.canEvaluateTruncatedImpl(SI.getFalseValue(), Ty, IC, CtxI);
        },
        PHI => {
            let mut PN: *mut PHINode = cast(I);
            return all_of(PN.incoming_values(), Closure_3 { cap_0: self, Ty: Ty, IC: &mut IC, CtxI: CtxI });
        },
        FPToUI => {
            FPToSI;
        },
        ShuffleVector => {
            return self.canEvaluateTruncatedImpl(I.getOperand(0), Ty, IC, CtxI) && self.canEvaluateTruncatedImpl(I.getOperand(1), Ty, IC, CtxI);
        },
        Call => {
            let mut AbsOp: *mut Value = null;
            if match(I, m_Intrinsic(m_Value(AbsOp), m_Value())) {
                if IC.ComputeMaxSignificantBits(AbsOp, CtxI, 0) > Ty.getScalarSizeInBits() {
                    return false;
                }
                return self.canEvaluateTruncatedImpl(AbsOp, Ty, IC, CtxI);
            }
            let mut MM: *mut MinMaxIntrinsic = dyn_cast(I);
            if !MM {
                return false;
            }
            let mut Op0: *mut Value = MM.getLHS();
            let mut Op1: *mut Value = MM.getRHS();
            let mut BitWidth: u32 = Ty.getScalarSizeInBits();
            if MM.isSigned() {
                if IC.ComputeMaxSignificantBits(Op0, CtxI, 0) > BitWidth || IC.ComputeMaxSignificantBits(Op1, CtxI, 0) > BitWidth {
                    break;
                }
            } else {
                let mut Mask: APInt = getBitsSetFrom(OrigTy.getScalarSizeInBits(), BitWidth);
                if !IC.MaskedValueIsZero(Op0, Mask, CtxI, 0) || !IC.MaskedValueIsZero(Op1, Mask, CtxI, 0) {
                    break;
                }
            }
            return self.canEvaluateTruncatedImpl(Op0, Ty, IC, CtxI) && self.canEvaluateTruncatedImpl(Op1, Ty, IC, CtxI);
        },
        _ => {
            break;
        },
    }
    return false;
}

fn foldVecTruncToExtElt(Trunc: *mut TruncInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut TruncOp: *mut Value = Trunc.getOperand(0);
    let mut DestType: *mut Type = Trunc.getType();
    if !TruncOp.hasOneUse() || !isa(DestType) {
        return null;
    }
    let mut VecInput: *mut Value = null;
    let mut ShiftVal: *mut ConstantInt = null;
    if !match(TruncOp, m_CombineOr(m_BitCast(m_Value(VecInput)), m_LShr(m_BitCast(m_Value(VecInput)), m_ConstantInt(ShiftVal)))) || !isa(VecInput.getType()) {
        return null;
    }
    let mut VecType: *mut VectorType = cast(VecInput.getType());
    let mut VecWidth: u32 = VecType.getPrimitiveSizeInBits().operator unsigned long long();
    let mut DestWidth: u32 = DestType.getPrimitiveSizeInBits().operator unsigned long long();
    let mut ShiftAmount: u32 = if ShiftVal { ShiftVal.getZExtValue() } else { 0 };
    if (VecWidth % DestWidth != 0) || (ShiftAmount % DestWidth != 0) {
        return null;
    }
    let mut NumVecElts: u32 = VecWidth / DestWidth;
    if VecType.getElementType() != DestType {
        VecType = get(DestType, NumVecElts);
        VecInput = IC.Builder.CreateBitCast(VecInput, VecType, "bc");
    }
    let mut Elt: u32 = ShiftAmount / DestWidth;
    if IC.getDataLayout().isBigEndian() {
        Elt = NumVecElts - 1 - Elt;
    }
    return Create(VecInput, IC.Builder.getInt32(Elt), "", null);
}

fn foldVecExtTruncToExtElt(Trunc: *mut TruncInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Src: *mut Value = Trunc.getOperand(0);
    let mut SrcType: *mut Type = Src.getType();
    let mut DstType: *mut Type = Trunc.getType();
    let mut SrcBits: u32 = SrcType.getScalarSizeInBits();
    let mut DstBits: u32 = DstType.getScalarSizeInBits();
    let mut TruncRatio: u64 = SrcBits / DstBits;
    if (SrcBits % DstBits) != 0 {
        return null;
    }
    let mut VecOp: *mut Value = null;
    let mut Cst: *mut ConstantInt = null;
    let mut ShiftAmount: *APInt = null;
    if !match(Src, m_OneUse(m_ExtractElt(m_Value(VecOp), m_ConstantInt(Cst)))) && !match(Src, m_OneUse(m_LShr(m_ExtractElt(m_Value(VecOp), m_ConstantInt(Cst)), m_APInt(ShiftAmount)))) {
        return null;
    }
    let mut VecOpTy: *mut VectorType = cast(VecOp.getType());
    let mut VecElts: ElementCount = VecOpTy.getElementCount();
    let mut BitCastNumElts: u64 = VecElts.getKnownMinValue() * TruncRatio;
    if BitCastNumElts > MAX_INT_BITS {
        return null;
    }
    if Cst.uge(max() / TruncRatio) {
        return null;
    }
    let mut VecOpIdx: u64 = Cst.getZExtValue();
    let mut NewIdx: u64 = if IC.getDataLayout().isBigEndian() { (VecOpIdx + 1) * TruncRatio - 1 } else { VecOpIdx * TruncRatio };
    if ShiftAmount {
        if ShiftAmount.uge(SrcBits) || ShiftAmount.urem(DstBits) != 0 {
            return null;
        }
        let mut IdxOfs: u64 = ShiftAmount.udiv(DstBits).getZExtValue();
        assert!(IdxOfs < TruncRatio, "IdxOfs is expected to be less than TruncRatio.");
        NewIdx = if IC.getDataLayout().isBigEndian() { (NewIdx - IdxOfs) } else { (NewIdx + IdxOfs) };
    }
    let mut BitCastTo: *mut VectorType = get(DstType, BitCastNumElts, VecElts.isScalable());
    let mut BitCast: *mut Value = IC.Builder.CreateBitCast(VecOp, BitCastTo, "");
    return Create(BitCast, IC.Builder.getInt64(NewIdx), "", null);
}

fn InstCombinerImpl::narrowFunnelShift(self, Trunc: *mut TruncInst) -> *mut Instruction {
    assert!((isa(Trunc.getSrcTy()) || self.shouldChangeType(Trunc.getSrcTy(), Trunc.getType())), "Don't narrow to an illegal scalar type");
    let mut DestTy: *mut Type = Trunc.getType();
    let mut NarrowWidth: u32 = DestTy.getScalarSizeInBits();
    let mut WideWidth: u32 = Trunc.getSrcTy().getScalarSizeInBits();
    if !isPowerOf2_32(NarrowWidth) {
        return null;
    }
    let mut Or0: *mut BinaryOperator = null;
    let mut Or1: *mut BinaryOperator = null;
    if !match(Trunc.getOperand(0), m_OneUse(m_Or(m_BinOp(Or0), m_BinOp(Or1)))) {
        return null;
    }
    let mut ShVal0: *mut Value = null;
    let mut ShVal1: *mut Value = null;
    let mut ShAmt0: *mut Value = null;
    let mut ShAmt1: *mut Value = null;
    if !match(Or0, m_OneUse(m_LogicalShift(m_Value(ShVal0), m_Value(ShAmt0)))) || !match(Or1, m_OneUse(m_LogicalShift(m_Value(ShVal1), m_Value(ShAmt1)))) || Or0.getOpcode() == Or1.getOpcode() {
        return null;
    }
    if Or0.getOpcode() == LShr {
        swap(Or0, Or1);
        swap(ShVal0, ShVal1);
        swap(ShAmt0, ShAmt1);
    }
    assert!(Or0.getOpcode() == Shl && Or1.getOpcode() == LShr, "Illegal or(shift,shift) pair");
    let mut matchShiftAmount: Closure_4 = Closure_4 { NarrowWidth: &mut NarrowWidth, WideWidth: &mut WideWidth, ShVal0: &mut ShVal0, ShVal1: &mut ShVal1, cap_4: self };
    let mut ShAmt: *mut Value = matchShiftAmount.call(ShAmt0, ShAmt1, NarrowWidth);
    let mut IsFshl: bool = true;
    if !ShAmt {
        ShAmt = matchShiftAmount.call(ShAmt1, ShAmt0, NarrowWidth);
        IsFshl = false;
    }
    if !ShAmt {
        return null;
    }
    let mut HiBitMask: APInt = getHighBitsSet(WideWidth, WideWidth - NarrowWidth);
    if !self.MaskedValueIsZero(ShVal1, HiBitMask, &mut Trunc, 0) {
        return null;
    }
    let mut NarrowShAmt: *mut Value = self.Builder.CreateZExtOrTrunc(ShAmt, DestTy, "");
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    X = Y = self.Builder.CreateTrunc(ShVal0, DestTy, "", false, false);
    if ShVal0 != ShVal1 {
        Y = self.Builder.CreateTrunc(ShVal1, DestTy, "", false, false);
    }
    let mut IID: ID = if IsFshl { fshl } else { fshr };
    let mut F: *mut Function = getOrInsertDeclaration(Trunc.getModule(), IID, DestTy);
    return Create(F, [X, Y, NarrowShAmt], ArrayRef<OperandBundleDef> {}, "", null);
}

fn InstCombinerImpl::narrowBinOp(self, Trunc: *mut TruncInst) -> *mut Instruction {
    let mut SrcTy: *mut Type = Trunc.getSrcTy();
    let mut DestTy: *mut Type = Trunc.getType();
    let mut SrcWidth: u32 = SrcTy.getScalarSizeInBits();
    let mut DestWidth: u32 = DestTy.getScalarSizeInBits();
    if !isa(SrcTy) && !self.shouldChangeType(SrcTy, DestTy) {
        return null;
    }
    let mut BinOp: *mut BinaryOperator = null;
    if !match(Trunc.getOperand(0), m_OneUse(m_BinOp(BinOp))) {
        return null;
    }
    let mut BinOp0: *mut Value = BinOp.getOperand(0);
    let mut BinOp1: *mut Value = BinOp.getOperand(1);
    match BinOp.getOpcode() {
        And => {
            Or;
        },
        LShr => {
            AShr;
        },
        _ => {
            break;
        },
    }
    if self.narrowFunnelShift(Trunc) {
        NarrowOr;
    } else {
        return NarrowOr;
    }
    return null;
}

fn shrinkSplatShuffle(Trunc: *mut TruncInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Shuf: *mut Value = Trunc.getOperand(0);
    let mut ShufVec: *mut Value = null;
    let mut SplatMask: ArrayRef<int> = ArrayRef<int> {};
    if match(Shuf, m_OneUse(m_Shuffle(m_Value(ShufVec), m_Poison(), SplatMask))) && match(SplatMask, m_SplatMask {}) && isKnownGE(cast(Shuf.getType()).getElementCount(), cast(ShufVec.getType()).getElementCount()) {
        let mut NewTruncTy: *mut Type = ShufVec.getType().getWithNewType(Trunc.getType().getScalarType());
        let mut NarrowOp: *mut Value = Builder.CreateTrunc(ShufVec, NewTruncTy, "", false, false);
        return ShuffleVectorInst { NarrowOp, SplatMask, "", null };
    }
    return null;
}

fn shrinkInsertElt(Trunc: *mut CastInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Opcode: CastOps = Trunc.getOpcode();
    assert!((Opcode == Trunc || Opcode == FPTrunc), "Unexpected instruction for shrinking");
    let mut Elt: *mut Value = null;
    let mut Index: *mut Value = null;
    if match(Trunc.getOperand(0), m_OneUse(m_InsertElt(m_Poison(), m_Value(Elt), m_Value(Index)))) {
        let mut NarrowPoison: *mut PoisonValue = get(Trunc.getType());
        let mut NarrowOp: *mut Value = Builder.CreateCast(Opcode, Elt, Trunc.getType().getScalarType(), "", null, FMFSource {});
        return Create(NarrowPoison, NarrowOp, Index, "", null);
    }
    return null;
}

fn InstCombinerImpl::visitTrunc(self, Trunc: *mut TruncInst) -> *mut Instruction {
    if self.commonCastTransforms(Trunc) {
        Result;
    } else {
        return Result;
    }
    let mut Src: *mut Value = Trunc.getOperand(0);
    let mut DestTy: *mut Type = Trunc.getType();
    let mut SrcTy: *mut Type = Src.getType();
    let mut DestWidth: u32 = DestTy.getScalarSizeInBits();
    let mut SrcWidth: u32 = SrcTy.getScalarSizeInBits();
    if (DestTy.isVectorTy() || self.shouldChangeType(SrcTy, DestTy)) && canEvaluateTruncated(Src, DestTy, *self, &mut Trunc) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine", 1) {
                dbgs() << "ICE: EvaluateInDifferentType converting expression type to avoid cast: " << Trunc << 10;
            }
        }
            if !(false) { break; }
        }
        let mut Res: *mut Value = self.EvaluateInDifferentType(Src, DestTy, false);
        assert!(Res.getType() == DestTy);
        return self.replaceInstUsesWith(Trunc, Res);
    }
    if dyn_cast(DestTy) {
        DestITy;
    } else {
        if DestWidth * 2 < SrcWidth {
            let mut NewDestTy: *mut IntegerType = DestITy.getExtendedType();
            if self.shouldChangeType(SrcTy, NewDestTy) && canEvaluateTruncated(Src, NewDestTy, *self, &mut Trunc) {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("instcombine", 1) {
                        dbgs() << "ICE: EvaluateInDifferentType converting expression type to reduce the width of operand of" << Trunc << 10;
                    }
                }
                    if !(false) { break; }
                }
                let mut Res: *mut Value = self.EvaluateInDifferentType(Src, NewDestTy, false);
                return TruncInst { Res, DestTy, "", null };
            }
        }
    }
    let mut X: *mut Value = null;
    if DestWidth == 1 && (Trunc.hasNoUnsignedWrap() || Trunc.hasNoSignedWrap()) && match(Src, m_Exact(m_Shr(m_Value(X), m_Value()))) {
        return ICmpInst { ICMP_NE, X, getNullValue(SrcTy), "" };
    }
    if self.SimplifyDemandedInstructionBits(Trunc) {
        return &mut Trunc;
    }
    if DestWidth == 1 {
        let mut Zero: *mut Value = getNullValue(SrcTy);
        let mut C1: *APInt = null;
        let mut C2: *mut Constant = null;
        if match(Src, m_OneUse(m_Shr(m_Shl(m_Power2(C1), m_Value(X)), m_ImmConstant(C2)))) {
            let mut Log2C1: *mut Constant = get(SrcTy, C1.exactLogBase2(), false, false);
            let mut CmpC: *mut Constant = getSub(C2, Log2C1, false, false);
            return ICmpInst { ICMP_EQ, X, CmpC, "" };
        }
        if match(Src, m_Shr(m_Value(X), m_SpecificInt(SrcWidth - 1))) {
            return ICmpInst { ICMP_SLT, X, Zero, "" };
        }
        let mut C: *mut Constant = null;
        if match(Src, m_OneUse(m_LShr(m_Value(X), m_ImmConstant(C)))) {
            let mut One: *mut Constant = get(SrcTy, APInt { SrcWidth, 1, false, false });
            let mut MaskC: *mut Value = self.Builder.CreateShl(One, C, "", false, false);
            let mut And: *mut Value = self.Builder.CreateAnd(X, MaskC, "");
            return ICmpInst { ICMP_NE, And, Zero, "" };
        }
        if match(Src, m_OneUse(m_c_Or(m_LShr(m_Value(X), m_ImmConstant(C)), m_Deferred(X)))) {
            let mut One: *mut Constant = get(SrcTy, APInt { SrcWidth, 1, false, false });
            let mut MaskC: *mut Value = self.Builder.CreateShl(One, C, "", false, false);
            let mut And: *mut Value = self.Builder.CreateAnd(X, self.Builder.CreateOr(MaskC, One, "", false), "");
            return ICmpInst { ICMP_NE, And, Zero, "" };
        }
        {
            let mut C: *APInt = null;
            if match(Src, m_Shl(m_APInt(C), m_Value(X))) && (*C)[0] == 1 {
                return ICmpInst { ICMP_EQ, X, Zero, "" };
            }
        }
        if Trunc.hasNoUnsignedWrap() || Trunc.hasNoSignedWrap() {
            let mut X: *mut Value = null;
            let mut Y: *mut Value = null;
            if match(Src, m_Xor(m_Value(X), m_Value(Y))) {
                return ICmpInst { ICMP_NE, X, Y, "" };
            }
        }
        if match(Src, m_OneUse(m_Intrinsic(m_One(), m_Value(X)))) {
            return ICmpInst { ICMP_EQ, X, getNullValue(SrcTy), "" };
        }
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Constant = null;
    if match(Src, m_OneUse(m_CombineOr(m_UMin(m_OneUse(m_Add(m_ZExt(m_SpecificType(DestTy, A)), m_ZExt(m_SpecificType(DestTy, B)))), m_SpecificInt(getMaxValue(DestWidth))), m_SMin(m_OneUse(m_Add(m_ZExt(m_SpecificType(DestTy, A)), m_ZExt(m_SpecificType(DestTy, B)))), m_SpecificInt(getMaxValue(DestWidth)))))) {
        return self.replaceInstUsesWith(Trunc, self.Builder.CreateBinaryIntrinsic(uadd_sat, A, B, FMFSource {}, ""));
    }
    if match(Src, m_OneUse(m_SMax(m_OneUse(m_Sub(m_ZExt(m_SpecificType(DestTy, A)), m_ZExt(m_SpecificType(DestTy, B)))), m_Zero()))) {
        return self.replaceInstUsesWith(Trunc, self.Builder.CreateBinaryIntrinsic(usub_sat, A, B, FMFSource {}, ""));
    }
    if match(Src, m_LShr(m_SExt(m_Value(A)), m_Constant(C))) {
        let mut AWidth: u32 = A.getType().getScalarSizeInBits();
        let mut MaxShiftAmt: u32 = SrcWidth - if DestWidth > AWidth { DestWidth } else { AWidth };
        let mut OldSh: *mut Instruction = cast(Src);
        let mut IsExact: bool = OldSh.isExact();
        if match(C, m_SpecificInt_ICMP(ICMP_ULE, APInt { SrcWidth, MaxShiftAmt, false, false })) {
            let mut GetNewShAmt: Closure_5 = Closure_5 { SrcTy: &mut SrcTy, C: &mut C, cap_2: self, A: &mut A };
            if A.getType() == DestTy {
                let mut ShAmt: *mut Constant = GetNewShAmt.call(DestWidth);
                ShAmt = mergeUndefsWith(ShAmt, C);
                return if IsExact { CreateExactAShr(A, ShAmt, "") } else { CreateAShr(A, ShAmt, "") };
            }
            if Src.hasOneUse() {
                let mut ShAmt: *mut Constant = GetNewShAmt.call(AWidth);
                let mut Shift: *mut Value = self.Builder.CreateAShr(A, ShAmt, "", IsExact);
                return CreateIntegerCast(Shift, DestTy, true, "", null);
            }
        }
    }
    if self.narrowBinOp(Trunc) {
        I;
    } else {
        return I;
    }
    if shrinkSplatShuffle(Trunc, self.Builder) {
        I;
    } else {
        return I;
    }
    if shrinkInsertElt(Trunc, self.Builder) {
        I;
    } else {
        return I;
    }
    if Src.hasOneUse() && (isa(SrcTy) || self.shouldChangeType(SrcTy, DestTy)) {
        if match(Src, m_Shl(m_Value(A), m_Constant(C))) && !match(A, m_Shr(m_Value(), m_Constant())) {
            let mut Threshold: APInt = APInt { C.getType().getScalarSizeInBits(), DestWidth, false, false };
            if match(C, m_SpecificInt_ICMP(ICMP_ULT, Threshold)) {
                let mut WideShl: *mut OverflowingBinaryOperator = cast(Src);
                let mut NUW: bool = Trunc.hasNoUnsignedWrap() && WideShl.hasNoUnsignedWrap();
                let mut NSW: bool = Trunc.hasNoSignedWrap() && WideShl.hasNoSignedWrap();
                let mut NewTrunc: *mut Value = self.Builder.CreateTrunc(A, DestTy, A.getName() + ".tr", NUW, NSW);
                let mut NewShl: *mut BinaryOperator = Create(Shl, NewTrunc, getTrunc(C, DestTy, false), "", null);
                NewShl.setHasNoUnsignedWrap(NUW);
                NewShl.setHasNoSignedWrap(NSW);
                return NewShl;
            }
        }
    }
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut CmpC: *APInt = null;
    let mut TVal: *mut Value = null;
    let mut FVal: *mut Value = null;
    if SrcTy.isIntegerTy() && isPowerOf2_64(SrcWidth) && isPowerOf2_64(DestWidth) && match(Src, m_OneUse(m_Select(m_OneUse(m_ICmp(Pred, m_Value(A), m_APInt(CmpC))), m_Value(TVal), m_Value(FVal)))) {
        let mut TruncatedMax: APInt = getLowBitsSet(SrcWidth, DestWidth);
        let mut SExtVal: *mut Value = null;
        if Pred == ICMP_ULT && TVal == A && *CmpC == TruncatedMax + 1 {
            SExtVal = FVal;
        } else if Pred == ICMP_UGT && FVal == A && *CmpC == TruncatedMax {
            SExtVal = TVal;
        }
        if SExtVal && match(SExtVal, m_OneUse(m_SExt(m_OneUse(m_SpecificICmp(CmpPredicate { Pred: ICMP_SGT, HasSameSign: false }, m_Specific(A), m_Zero()))))) {
            let mut SMax: *mut Value = self.Builder.CreateIntrinsic(smax, [SrcTy], [get(SrcTy, 0, false, false), A], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_6 {}, null, null });
            let mut SMin: *mut Value = self.Builder.CreateIntrinsic(smin, [SrcTy], [SMax, get(SrcTy, TruncatedMax)], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_7 {}, null, null });
            return TruncInst { SMin, DestTy, "", null };
        }
    }
    if foldVecTruncToExtElt(Trunc, *self) {
        I;
    } else {
        return I;
    }
    if foldVecExtTruncToExtElt(Trunc, *self) {
        I;
    } else {
        return I;
    }
    if match(Src, m_OneUse(m_Ctlz(m_ZExt(m_Value(A)), m_Value(B)))) {
        let mut AWidth: u32 = A.getType().getScalarSizeInBits();
        if AWidth == DestWidth && AWidth > Log2_32(SrcWidth) {
            let mut WidthDiff: *mut Value = get(A.getType(), SrcWidth - AWidth, false, false);
            let mut NarrowCtlz: *mut Value = self.Builder.CreateIntrinsic(ctlz, [Trunc.getType()], [A, B], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_8 {}, null, null });
            return CreateAdd(NarrowCtlz, WidthDiff, "");
        }
    }
    if match(Src, m_VScale()) {
        if Trunc.getFunction() && Trunc.getFunction().hasFnAttribute(VScaleRange) {
            let mut Attr: Attribute = Trunc.getFunction().getFnAttribute(VScaleRange);
            if Attr.getVScaleRangeMax() {
                MaxVScale;
            } else if Log2_32(operator(MaxVScale)) < DestWidth {
                return self.replaceInstUsesWith(Trunc, self.Builder.CreateVScale(DestTy, ""));
            }
        }
    }
    if DestWidth >= 2 {
        let mut CI: *mut CmpIntrinsic = dyn_cast(Src);
        if CI && CI.hasOneUse() {
            return self.replaceInstUsesWith(Trunc, self.Builder.CreateIntrinsic(DestTy, CI.getIntrinsicID(), [CI.getLHS(), CI.getRHS()], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_9 {}, null, null }));
        }
    }
    if DestWidth == 1 && (Trunc.hasNoUnsignedWrap() || Trunc.hasNoSignedWrap()) && isKnownNonZero(Src, self.SQ.getWithInstruction(&mut Trunc), 0) {
        return self.replaceInstUsesWith(Trunc, getTrue(DestTy));
    }
    let mut Changed: bool = false;
    if !Trunc.hasNoSignedWrap() && self.ComputeMaxSignificantBits(Src, &mut Trunc, 0) <= DestWidth {
        Trunc.setHasNoSignedWrap(true);
        Changed = true;
    }
    if !Trunc.hasNoUnsignedWrap() && self.MaskedValueIsZero(Src, getBitsSetFrom(SrcWidth, DestWidth), &mut Trunc, 0) {
        Trunc.setHasNoUnsignedWrap(true);
        Changed = true;
    }
    let mut C1: *APInt = null;
    let mut V1: *mut Value = null;
    if DestWidth == 1 && match(Src, m_Shr(m_Power2(C1), m_Value(V1))) {
        let mut Right: *mut Value = get(V1.getType(), C1.countr_zero(), false, false);
        return ICmpInst { ICMP_EQ, V1, Right, "" };
    }
    if DestWidth == 1 && match(Src, m_Shr(m_LowBitMask(C1), m_Value(V1))) {
        let mut Right: *mut Value = get(V1.getType(), C1.countr_one(), false, false);
        return ICmpInst { ICMP_ULT, V1, Right, "" };
    }
    if DestWidth == 1 && match(Src, m_Shr(m_NegatedPower2(C1), m_Value(V1))) {
        let mut Right: *mut Value = get(V1.getType(), C1.countr_zero(), false, false);
        return ICmpInst { ICMP_UGE, V1, Right, "" };
    }
    return if Changed { &mut Trunc } else { null };
}

fn InstCombinerImpl::transformZExtICmp(self, Cmp: *mut ICmpInst, Zext: *mut ZExtInst) -> *mut Instruction {
    let mut Op1CV: *APInt = null;
    if match(Cmp.getOperand(1), m_APInt(Op1CV)) {
        if Cmp.getPredicate() == ICMP_SLT && Op1CV.isZero() {
            let mut In: *mut Value = Cmp.getOperand(0);
            let mut Sh: *mut Value = get(In.getType(), In.getType().getScalarSizeInBits() - 1, false, false);
            In = self.Builder.CreateLShr(In, Sh, In.getName() + ".lobit", false);
            if In.getType() != Zext.getType() {
                In = self.Builder.CreateIntCast(In, Zext.getType(), false, "");
            }
            return self.replaceInstUsesWith(Zext, In);
        }
        if Op1CV.isZero() && Cmp.isEquality() {
            let mut Known: KnownBits = self.computeKnownBits(Cmp.getOperand(0), &mut Zext, 0);
            let mut KnownZeroMask: APInt = operator(Known.Zero);
            let mut ShAmt: u32 = KnownZeroMask.logBase2();
            let mut IsExpectShAmt: bool = KnownZeroMask.isPowerOf2() && (Zext.getType().getScalarSizeInBits() != ShAmt + 1);
            if IsExpectShAmt && (Cmp.getOperand(0).getType() == Zext.getType() || Cmp.getPredicate() == ICMP_NE || ShAmt == 0) {
                let mut In: *mut Value = Cmp.getOperand(0);
                if ShAmt {
                    In = self.Builder.CreateLShr(In, get(In.getType(), ShAmt, false, false), In.getName() + ".lobit", false);
                }
                if Cmp.getPredicate() == ICMP_EQ {
                    In = self.Builder.CreateXor(In, get(In.getType(), 1, false, false), "");
                }
                if Zext.getType() == In.getType() {
                    return self.replaceInstUsesWith(Zext, In);
                }
                let mut IntCast: *mut Value = self.Builder.CreateIntCast(In, Zext.getType(), false, "");
                return self.replaceInstUsesWith(Zext, IntCast);
            }
        }
    }
    if Cmp.isEquality() {
        let mut X: *mut Value = null;
        let mut ShAmt: *mut Value = null;
        if Cmp.hasOneUse() && match(Cmp.getOperand(1), m_ZeroInt()) && match(Cmp.getOperand(0), m_OneUse(m_c_And(m_Shl(m_One(), m_Value(ShAmt)), m_Value(X)))) {
            let mut And: *mut BinaryOperator = cast(Cmp.getOperand(0));
            let mut Shift: *mut Value = And.getOperand(if X == And.getOperand(0) { 1 } else { 0 });
            if Zext.getType() == And.getType() || Cmp.getPredicate() != ICMP_EQ || Shift.hasOneUse() {
                if Cmp.getPredicate() == ICMP_EQ {
                    X = self.Builder.CreateNot(X, "");
                }
                let mut Lshr: *mut Value = self.Builder.CreateLShr(X, ShAmt, "", false);
                let mut And1: *mut Value = self.Builder.CreateAnd(Lshr, get(X.getType(), 1, false, false), "");
                return self.replaceInstUsesWith(Zext, self.Builder.CreateZExtOrTrunc(And1, Zext.getType(), ""));
            }
        }
    }
    return null;
}

fn TypeEvaluationHelper::canEvaluateZExtd(self, V: *mut Value, Ty: *mut Type, BitsToClear: *mut u32, IC: *mut InstCombinerImpl, CtxI: *mut Instruction) -> bool {
    let mut TYH: TypeEvaluationHelper = TypeEvaluationHelper {};
    return TYH.canEvaluateZExtdImpl(V, Ty, BitsToClear, IC, CtxI);
}

fn TypeEvaluationHelper::canEvaluateZExtdImpl(self, V: *mut Value, Ty: *mut Type, BitsToClear: *mut u32, IC: *mut InstCombinerImpl, CtxI: *mut Instruction) -> bool {
    BitsToClear = 0;
    if canAlwaysEvaluateInType(V, Ty) {
        return true;
    }
    if self.canNotEvaluateInType(V, Ty) {
        return false;
    }
    let mut I: *mut Instruction = cast(V);
    let mut Tmp: u32 = 0;
    match I.getOpcode() {
        ZExt => {
            SExt;
        },
        And => {
            Or;
        },
        Shl => {
            let mut ShiftAmt: u64 = 0;
            if match(I.getOperand(1), m_ConstantInt(ShiftAmt)) {
                if !self.canEvaluateZExtdImpl(I.getOperand(0), Ty, BitsToClear, IC, CtxI) {
                    return false;
                }
                BitsToClear = if ShiftAmt < BitsToClear { BitsToClear - ShiftAmt } else { 0 };
                return true;
            }
            return false;
        },
        LShr => {
            let mut ShiftAmt: u64 = 0;
            if match(I.getOperand(1), m_ConstantInt(ShiftAmt)) {
                if !self.canEvaluateZExtdImpl(I.getOperand(0), Ty, BitsToClear, IC, CtxI) {
                    return false;
                }
                BitsToClear += ShiftAmt;
                if BitsToClear > V.getType().getScalarSizeInBits() {
                    BitsToClear = V.getType().getScalarSizeInBits();
                }
                return true;
            }
            return false;
        },
        Select => {
            if !self.canEvaluateZExtdImpl(I.getOperand(1), Ty, Tmp, IC, CtxI) || !self.canEvaluateZExtdImpl(I.getOperand(2), Ty, BitsToClear, IC, CtxI) || Tmp != BitsToClear {
                return false;
            }
        },
        PHI => {
            let mut PN: *mut PHINode = cast(I);
            if !self.canEvaluateZExtdImpl(PN.getIncomingValue(0), Ty, BitsToClear, IC, CtxI) {
                return false;
            }
            for let mut i: u32 = 1;
let mut e: u32 = PN.getNumIncomingValues(); i != e; i += 1 {
                if !self.canEvaluateZExtdImpl(PN.getIncomingValue(i), Ty, Tmp, IC, CtxI) || Tmp != BitsToClear {
                    return false;
                }
            }
            return true;
        },
        Call => {
            if dyn_cast(I) {
                II;
            } else if II.getIntrinsicID() == vscale {
                return true;
            }
        },
        _ => {
            return false;
        },
    }
}

fn InstCombinerImpl::visitZExt(self, Zext: *mut ZExtInst) -> *mut Instruction {
    if Zext.hasOneUse() && isa(Zext.user_back()) && !isa(Zext.getOperand(0)) {
        return null;
    }
    if self.commonCastTransforms(Zext) {
        Result;
    } else {
        return Result;
    }
    if self.foldExtractionOfVectorDeinterleave(Zext) {
        NewI;
    } else {
        return NewI;
    }
    let mut Src: *mut Value = Zext.getOperand(0);
    let mut SrcTy: *mut Type = Src.getType();
    let mut DestTy: *mut Type = Zext.getType();
    if SrcTy.isIntOrIntVectorTy(1) && Zext.hasNonNeg() {
        return self.replaceInstUsesWith(Zext, getNullValue(Zext.getType()));
    }
    let mut EvaluateAsSigned: bool = Zext.hasNonNeg() && canEvaluateSExtd(Src, DestTy);
    let mut BitsToClear: u32 = 0;
    if self.shouldChangeType(SrcTy, DestTy) && (EvaluateAsSigned || canEvaluateZExtd(Src, DestTy, BitsToClear, *self, &mut Zext)) {
        assert!(BitsToClear <= SrcTy.getScalarSizeInBits(), "Can't clear more bits than in SrcTy");
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine", 1) {
                dbgs() << "ICE: EvaluateInDifferentType converting expression type to avoid zero extend: " << Zext << 10;
            }
        }
            if !(false) { break; }
        }
        let mut Res: *mut Value = self.EvaluateInDifferentType(Src, DestTy, EvaluateAsSigned);
        assert!(Res.getType() == DestTy);
        if dyn_cast(Src) {
            SrcOp;
        } else if SrcOp.hasOneUse() {
            replaceAllDbgUsesWith(*SrcOp, *Res, Zext, self.DT);
        }
        let mut SrcBitsKept: u32 = SrcTy.getScalarSizeInBits() - BitsToClear;
        let mut DestBitSize: u32 = DestTy.getScalarSizeInBits();
        if if EvaluateAsSigned { (self.ComputeNumSignBits(Res, &mut Zext, 0) > DestBitSize - SrcBitsKept) } else { self.MaskedValueIsZero(Res, getHighBitsSet(DestBitSize, DestBitSize - SrcBitsKept), &mut Zext, 0) } {
            return self.replaceInstUsesWith(Zext, Res);
        }
        let mut C: *mut Constant = get(Res.getType(), getLowBitsSet(DestBitSize, SrcBitsKept));
        return CreateAnd(Res, C, "");
    }
    if dyn_cast(Src) {
        CSrc;
    } else {
        let mut A: *mut Value = CSrc.getOperand(0);
        let mut SrcSize: u32 = A.getType().getScalarSizeInBits();
        let mut MidSize: u32 = CSrc.getType().getScalarSizeInBits();
        let mut DstSize: u32 = DestTy.getScalarSizeInBits();
        if SrcSize < DstSize {
            let mut AndValue: APInt = getLowBitsSet(SrcSize, MidSize);
            let mut AndConst: *mut Constant = get(A.getType(), AndValue);
            let mut And: *mut Value = self.Builder.CreateAnd(A, AndConst, CSrc.getName() + ".mask");
            return ZExtInst { And, DestTy, "", null };
        }
        if SrcSize == DstSize {
            let mut AndValue: APInt = getLowBitsSet(SrcSize, MidSize);
            return CreateAnd(A, get(A.getType(), AndValue), "");
        }
        if SrcSize > DstSize {
            let mut Trunc: *mut Value = self.Builder.CreateTrunc(A, DestTy, "", false, false);
            let mut AndValue: APInt = getLowBitsSet(DstSize, MidSize);
            return CreateAnd(Trunc, get(Trunc.getType(), AndValue), "");
        }
    }
    if dyn_cast(Src) {
        Cmp;
    } else {
        return self.transformZExtICmp(Cmp, Zext);
    }
    let mut C: *mut Constant = null;
    let mut X: *mut Value = null;
    let mut And: *mut Value = null;
    if match(Src, m_OneUse(m_Xor(m_Value(And), m_Constant(C)))) && match(And, m_OneUse(m_And(m_Trunc(m_SpecificType(DestTy, X)), m_Specific(C)))) {
        let mut ZC: *mut Value = self.Builder.CreateZExt(C, DestTy, "", false);
        return CreateXor(self.Builder.CreateAnd(X, ZC, ""), ZC, "");
    }
    if match(Src, m_Sub(m_Zero(), m_Trunc(m_SpecificType(DestTy, X)))) {
        let mut Mask: APInt = getLowBitsSet(DestTy.getScalarSizeInBits(), SrcTy.getScalarSizeInBits());
        let mut Neg: *mut Value = self.Builder.CreateSub(get(DestTy, 0, false, false), X, "", false, false);
        return CreateAnd(Neg, get(DestTy, Mask), "");
    }
    if match(Src, m_And(m_Trunc(m_SpecificType(DestTy, X)), m_Constant(C))) {
        let mut ZextC: *mut Value = self.Builder.CreateZExt(C, DestTy, "", false);
        return CreateAnd(X, ZextC, "");
    }
    let mut Y: *mut Value = null;
    if match(Src, m_OneUse(m_c_BitwiseLogic(m_NUWTrunc(m_SpecificType(DestTy, X)), m_Value(Y)))) {
        let mut ZextY: *mut Value = self.Builder.CreateZExt(Y, DestTy, "", false);
        return Create(cast(Src).getOpcode(), X, ZextY, "", null);
    }
    if match(Src, m_VScale()) {
        if Zext.getFunction() && Zext.getFunction().hasFnAttribute(VScaleRange) {
            let mut Attr: Attribute = Zext.getFunction().getFnAttribute(VScaleRange);
            if Attr.getVScaleRangeMax() {
                MaxVScale;
            } else {
                let mut TypeWidth: u32 = Src.getType().getScalarSizeInBits();
                if Log2_32(operator(MaxVScale)) < TypeWidth {
                    return self.replaceInstUsesWith(Zext, self.Builder.CreateVScale(DestTy, ""));
                }
            }
        }
    }
    if !Zext.hasNonNeg() {
        if Zext.hasOneUse() && SrcTy.getScalarSizeInBits() > Log2_64_Ceil(DestTy.getScalarSizeInBits()) && match(Zext.user_back(), m_Shift(m_Value(), m_Specific(&mut Zext))) {
            Zext.setNonNeg(true);
            return &mut Zext;
        }
        if isKnownNonNegative(Src, self.SQ.getWithInstruction(&mut Zext), 0) {
            Zext.setNonNeg(true);
            return &mut Zext;
        }
    }
    return null;
}

fn InstCombinerImpl::transformSExtICmp(self, Cmp: *mut ICmpInst, Sext: *mut SExtInst) -> *mut Instruction {
    let mut Op0: *mut Value = Cmp.getOperand(0);
    let mut Op1: *mut Value = Cmp.getOperand(1);
    let mut Pred: Predicate = Cmp.getPredicate();
    if !Op1.getType().isIntOrIntVectorTy() {
        return null;
    }
    if Pred == ICMP_SLT && match(Op1, m_ZeroInt()) {
        let mut Sh: *mut Value = get(Op0.getType(), Op0.getType().getScalarSizeInBits() - 1, false, false);
        let mut In: *mut Value = self.Builder.CreateAShr(Op0, Sh, Op0.getName() + ".lobit", false);
        if In.getType() != Sext.getType() {
            In = self.Builder.CreateIntCast(In, Sext.getType(), true, "");
        }
        return self.replaceInstUsesWith(Sext, In);
    }
    if dyn_cast(Op1) {
        Op1C;
    } else {
        if Cmp.hasOneUse() && Cmp.isEquality() && (Op1C.isZero() || Op1C.getValue().isPowerOf2()) {
            let mut Known: KnownBits = self.computeKnownBits(Op0, &mut Sext, 0);
            let mut KnownZeroMask: APInt = operator(Known.Zero);
            if KnownZeroMask.isPowerOf2() {
                let mut In: *mut Value = Cmp.getOperand(0);
                if !Op1C.isZero() && Op1C.getValue() != KnownZeroMask {
                    let mut V: *mut Value = if Pred == ICMP_NE { getAllOnesValue(Sext.getType()) } else { getNullValue(Sext.getType()) };
                    return self.replaceInstUsesWith(Sext, V);
                }
                if !Op1C.isZero() == (Pred == ICMP_NE) {
                    let mut ShiftAmt: u32 = KnownZeroMask.countr_zero();
                    if ShiftAmt {
                        In = self.Builder.CreateLShr(In, get(In.getType(), ShiftAmt, false, false), "", false);
                    }
                    In = self.Builder.CreateAdd(In, getAllOnesValue(In.getType()), "sext", false, false);
                } else {
                    let mut ShiftAmt: u32 = KnownZeroMask.countl_zero();
                    if ShiftAmt {
                        In = self.Builder.CreateShl(In, get(In.getType(), ShiftAmt, false, false), "", false, false);
                    }
                    In = self.Builder.CreateAShr(In, get(In.getType(), KnownZeroMask.getBitWidth() - 1, false, false), "sext", false);
                }
                if Sext.getType() == In.getType() {
                    return self.replaceInstUsesWith(Sext, In);
                }
                return CreateIntegerCast(In, Sext.getType(), true, "", null);
            }
        }
    }
    return null;
}

fn TypeEvaluationHelper::canEvaluateSExtd(self, V: *mut Value, Ty: *mut Type) -> bool {
    let mut TYH: TypeEvaluationHelper = TypeEvaluationHelper {};
    return TYH.canEvaluateSExtdImpl(V, Ty) && TYH.allPendingVisited();
}

fn TypeEvaluationHelper::canEvaluateSExtdImpl(self, V: *mut Value, Ty: *mut Type) -> bool {
    return self.canEvaluate(V, Ty, function_ref<bool (Value *, Type *)> { Closure_10 { cap_0: self }, null, null });
}

fn TypeEvaluationHelper::canEvaluateSExtdPred(self, V: *mut Value, Ty: *mut Type) -> bool {
    assert!(V.getType().getScalarSizeInBits() < Ty.getScalarSizeInBits(), "Can't sign extend type to a smaller type");
    let mut I: *mut Instruction = cast(V);
    match I.getOpcode() {
        SExt => {
            ZExt;
        },
        And => {
            Or;
        },
        Select => {
            return self.canEvaluateSExtdImpl(I.getOperand(1), Ty) && self.canEvaluateSExtdImpl(I.getOperand(2), Ty);
        },
        PHI => {
            let mut PN: *mut PHINode = cast(I);
            for IncValue in PN.incoming_values() {
                if !self.canEvaluateSExtdImpl(IncValue, Ty) {
                    return false;
                }
            }
            return true;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn InstCombinerImpl::visitSExt(self, Sext: *mut SExtInst) -> *mut Instruction {
    if Sext.hasOneUse() && isa(Sext.user_back()) {
        return null;
    }
    if self.commonCastTransforms(Sext) {
        I;
    } else {
        return I;
    }
    let mut Src: *mut Value = Sext.getOperand(0);
    let mut SrcTy: *mut Type = Src.getType();
    let mut DestTy: *mut Type = Sext.getType();
    let mut SrcBitSize: u32 = SrcTy.getScalarSizeInBits();
    let mut DestBitSize: u32 = DestTy.getScalarSizeInBits();
    if isKnownNonNegative(Src, self.SQ.getWithInstruction(&mut Sext), 0) {
        let mut CI: *mut CastInst = Create(ZExt, Src, DestTy, "", null);
        CI.setNonNeg(true);
        return CI;
    }
    let mut ShouldExtendExpression: bool = true;
    let mut TruncSrc: *mut Value = null;
    if match(Src, m_Trunc(m_Value(TruncSrc))) {
        if TruncSrc.getType().getScalarSizeInBits() > DestBitSize {
            ShouldExtendExpression = false;
        }
    }
    if ShouldExtendExpression && self.shouldChangeType(SrcTy, DestTy) && canEvaluateSExtd(Src, DestTy) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine", 1) {
                dbgs() << "ICE: EvaluateInDifferentType converting expression type to avoid sign extend: " << Sext << 10;
            }
        }
            if !(false) { break; }
        }
        let mut Res: *mut Value = self.EvaluateInDifferentType(Src, DestTy, true);
        assert!(Res.getType() == DestTy);
        if self.ComputeNumSignBits(Res, &mut Sext, 0) > DestBitSize - SrcBitSize {
            return self.replaceInstUsesWith(Sext, Res);
        }
        let mut ShAmt: *mut Value = get(DestTy, DestBitSize - SrcBitSize, false, false);
        return CreateAShr(self.Builder.CreateShl(Res, ShAmt, "sext", false, false), ShAmt, "");
    }
    let mut X: *mut Value = TruncSrc;
    if X {
        let mut XBitSize: u32 = X.getType().getScalarSizeInBits();
        let mut HasNSW: bool = cast(Src).hasNoSignedWrap();
        if HasNSW || (self.ComputeNumSignBits(X, &mut Sext, 0) > XBitSize - SrcBitSize) {
            let mut Res: *mut CastInst = CreateIntegerCast(X, DestTy, true, "", null);
            let mut ResTrunc: *mut TruncInst = dyn_cast(Res);
            if ResTrunc && HasNSW {
                ResTrunc.setHasNoSignedWrap(true);
            }
            return Res;
        }
        if Src.hasOneUse() && X.getType() == DestTy {
            let mut ShAmt: *mut Constant = get(DestTy, DestBitSize - SrcBitSize, false, false);
            return CreateAShr(self.Builder.CreateShl(X, ShAmt, "", false, false), ShAmt, "");
        }
        let mut Y: *mut Value = null;
        if Src.hasOneUse() && match(X, m_LShr(m_Value(Y), m_SpecificIntAllowPoison(XBitSize - SrcBitSize))) {
            let mut Ashr: *mut Value = self.Builder.CreateAShr(Y, XBitSize - SrcBitSize, "", false);
            return CreateIntegerCast(Ashr, DestTy, true, "", null);
        }
    }
    if dyn_cast(Src) {
        Cmp;
    } else {
        return self.transformSExtICmp(Cmp, Sext);
    }
    let mut A: *mut Value = null;
    let mut BA: *mut Constant = null;
    let mut CA: *mut Constant = null;
    if match(Src, m_AShr(m_Shl(m_Trunc(m_SpecificType(DestTy, A)), m_Constant(BA)), m_ImmConstant(CA))) && BA.isElementWiseEqual(CA) {
        let mut WideCurrShAmt: *mut Constant = ConstantFoldCastOperand(SExt, CA, DestTy, self.DL);
        assert!(WideCurrShAmt, "Constant folding of ImmConstant cannot fail");
        let mut NumLowbitsLeft: *mut Constant = getSub(get(DestTy, SrcTy.getScalarSizeInBits(), false, false), WideCurrShAmt, false, false);
        let mut NewShAmt: *mut Constant = getSub(get(DestTy, DestTy.getScalarSizeInBits(), false, false), NumLowbitsLeft, false, false);
        NewShAmt = mergeUndefsWith(mergeUndefsWith(NewShAmt, BA), CA);
        A = self.Builder.CreateShl(A, NewShAmt, Sext.getName(), false, false);
        return CreateAShr(A, NewShAmt, "");
    }
    if match(Src, m_OneUse(m_AShr(m_Trunc(m_Value(X)), m_SpecificInt(SrcBitSize - 1)))) {
        let mut XTy: *mut Type = X.getType();
        let mut XBitSize: u32 = XTy.getScalarSizeInBits();
        let mut ShlAmtC: *mut Constant = get(XTy, XBitSize - SrcBitSize, false, false);
        let mut AshrAmtC: *mut Constant = get(XTy, XBitSize - 1, false, false);
        if XTy == DestTy {
            return CreateAShr(self.Builder.CreateShl(X, ShlAmtC, "", false, false), AshrAmtC, "");
        }
        if cast(Src).getOperand(0).hasOneUse() {
            let mut Ashr: *mut Value = self.Builder.CreateAShr(self.Builder.CreateShl(X, ShlAmtC, "", false, false), AshrAmtC, "", false);
            return CreateIntegerCast(Ashr, DestTy, true, "", null);
        }
    }
    if match(Src, m_VScale()) {
        if Sext.getFunction() && Sext.getFunction().hasFnAttribute(VScaleRange) {
            let mut Attr: Attribute = Sext.getFunction().getFnAttribute(VScaleRange);
            if Attr.getVScaleRangeMax() {
                MaxVScale;
            } else if Log2_32(operator(MaxVScale)) < (SrcBitSize - 1) {
                return self.replaceInstUsesWith(Sext, self.Builder.CreateVScale(DestTy, ""));
            }
        }
    }
    let mut CI: *mut CmpIntrinsic = dyn_cast(Src);
    if CI && CI.hasOneUse() {
        return self.replaceInstUsesWith(Sext, self.Builder.CreateIntrinsic(DestTy, CI.getIntrinsicID(), [CI.getLHS(), CI.getRHS()], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_11 {}, null, null }));
    }
    let mut Y: *mut Value = null;
    if match(Src, m_OneUse(m_c_BitwiseLogic(m_NSWTrunc(m_SpecificType(DestTy, X)), m_Value(Y)))) {
        let mut SextY: *mut Value = self.Builder.CreateSExt(Y, DestTy, "");
        return Create(cast(Src).getOpcode(), X, SextY, "", null);
    }
    return null;
}

fn fitsInFPType(F: APFloat, Sem: *fltSemantics) -> bool {
    let mut losesInfo: bool = false;
    F.convert(Sem, rmNearestTiesToEven, &mut losesInfo) as void;
    return !losesInfo;
}

fn shrinkFPConstant(Ctx: *mut LLVMContext, F: *APFloat, PreferBFloat: bool) -> *mut Type {
    if PreferBFloat && fitsInFPType(F, BFloat()) {
        return getBFloatTy(Ctx);
    }
    if !PreferBFloat && fitsInFPType(F, IEEEhalf()) {
        return getHalfTy(Ctx);
    }
    if fitsInFPType(F, IEEEsingle()) {
        return getFloatTy(Ctx);
    }
    if &mut F.getSemantics() == &mut IEEEdouble() {
        return null;
    }
    if fitsInFPType(F, IEEEdouble()) {
        return getDoubleTy(Ctx);
    }
    return null;
}

fn shrinkFPConstant(CFP: *mut ConstantFP, PreferBFloat: bool) -> *mut Type {
    let mut Ty: *mut Type = CFP.getType();
    if Ty.getScalarType().isPPC_FP128Ty() {
        return null;
    }
    let mut ShrinkTy: *mut Type = shrinkFPConstant(CFP.getContext(), CFP.getValueAPF(), PreferBFloat);
    if ShrinkTy {
        if dyn_cast(Ty) {
            VecTy;
        } else {
            ShrinkTy = get(ShrinkTy, VecTy);
        }
    }
    return ShrinkTy;
}

fn shrinkFPConstantVector(V: *mut Value, PreferBFloat: bool) -> *mut Type {
    let mut CV: *mut Constant = dyn_cast(V);
    let mut CVVTy: *mut FixedVectorType = dyn_cast(V.getType());
    if !CV || !CVVTy {
        return null;
    }
    let mut MinType: *mut Type = null;
    let mut NumElts: u32 = CVVTy.getNumElements();
    for let mut I: u32 = 0; I != NumElts; I += 1 {
        if match(CV.getAggregateElement(I), m_Poison()) {
            continue;
        }
        let mut CFP: *mut ConstantFP = dyn_cast_or_null(CV.getAggregateElement(I));
        if !CFP {
            return null;
        }
        let mut T: *mut Type = shrinkFPConstant(CFP, PreferBFloat);
        if !T {
            return null;
        }
        if !MinType || T.getFPMantissaWidth() > MinType.getFPMantissaWidth() {
            MinType = T;
        }
    }
    return if MinType { get(MinType, NumElts) } else { null };
}

fn getMinimumFPType(V: *mut Value, PreferredTy: *mut Type, IC: *mut InstCombiner) -> *mut Type {
    if dyn_cast(V) {
        FPExt;
    } else {
        return FPExt.getOperand(0).getType();
    }
    let mut Src: *mut Value = null;
    if match(V, m_IToFP(m_Value(Src))) && IC.canBeCastedExactlyIntToFP(Src, PreferredTy, isa(V), cast(V)) {
        return PreferredTy;
    }
    let mut PreferBFloat: bool = PreferredTy.getScalarType().isBFloatTy();
    if dyn_cast(V) {
        CFP;
    } else if shrinkFPConstant(CFP, PreferBFloat) {
        T;
    } else {
        return T;
    }
    if dyn_cast(V) {
        FPC;
    } else if dyn_cast(V.getType()) {
        VTy;
    } else if dyn_cast_or_null(FPC.getSplatValue(false)) {
        Splat;
    } else if shrinkFPConstant(Splat, PreferBFloat) {
        T;
    } else {
        return get(T, VTy);
    }
    if shrinkFPConstantVector(V, PreferBFloat) {
        T;
    } else {
        return T;
    }
    return V.getType();
}

fn InstCombiner::canBeCastedExactlyIntToFP(self: *InstCombiner, V: *mut Value, FPTy: *mut Type, IsSigned: bool, CtxI: *Instruction) -> bool {
    let mut SrcTy: *mut Type = V.getType();
    assert!(SrcTy.isIntOrIntVectorTy(), "Expected an integer type");
    let mut SrcSize: i32 = SrcTy.getScalarSizeInBits() as i32 - IsSigned;
    let mut DestNumSigBits: i32 = FPTy.getFPMantissaWidth();
    if SrcSize <= DestNumSigBits {
        return true;
    }
    let mut F: *mut Value = null;
    if match(V, m_FPToI(m_Value(F))) {
        let mut SrcNumSigBits: i32 = F.getType().getFPMantissaWidth();
        if !IsSigned && match(V, m_FPToSI(m_Value())) {
            SrcNumSigBits += 1;
        }
        if SrcNumSigBits > 0 && DestNumSigBits > 0 && SrcNumSigBits <= DestNumSigBits {
            return true;
        }
    }
    let mut SrcKnown: KnownBits = self.computeKnownBits(V, CtxI, 0);
    let mut SigBits: i32 = SrcTy.getScalarSizeInBits() as i32 - SrcKnown.countMinLeadingZeros() - SrcKnown.countMinTrailingZeros();
    if SigBits <= DestNumSigBits {
        return true;
    }
    if IsSigned {
        SigBits = SrcTy.getScalarSizeInBits() as i32 - self.ComputeNumSignBits(V, CtxI, 0);
        if SigBits <= DestNumSigBits {
            return true;
        }
    }
    return false;
}

fn InstCombiner::isKnownExactCastIntToFP(self: *InstCombiner, I: *mut CastInst) -> bool {
    let mut Opcode: CastOps = I.getOpcode();
    assert!((Opcode == SIToFP || Opcode == UIToFP), "Unexpected cast");
    let mut Src: *mut Value = I.getOperand(0);
    let mut FPTy: *mut Type = I.getType();
    return self.canBeCastedExactlyIntToFP(Src, FPTy, Opcode == SIToFP, &mut I);
}

fn InstCombinerImpl::visitFPTrunc(self, FPT: *mut FPTruncInst) -> *mut Instruction {
    if self.commonCastTransforms(FPT) {
        I;
    } else {
        return I;
    }
    let mut Ty: *mut Type = FPT.getType();
    let mut BO: *mut BinaryOperator = dyn_cast(FPT.getOperand(0));
    if BO && BO.hasOneUse() {
        let mut LHSMinType: *mut Type = getMinimumFPType(BO.getOperand(0), Ty, *self);
        let mut RHSMinType: *mut Type = getMinimumFPType(BO.getOperand(1), Ty, *self);
        let mut OpWidth: u32 = BO.getType().getFPMantissaWidth();
        let mut LHSWidth: u32 = LHSMinType.getFPMantissaWidth();
        let mut RHSWidth: u32 = RHSMinType.getFPMantissaWidth();
        let mut SrcWidth: u32 = if LHSWidth > RHSWidth { LHSWidth } else { RHSWidth };
        let mut DstWidth: u32 = Ty.getFPMantissaWidth();
        let mut NarrowFMF: FastMathFlags = BO.getFastMathFlags();
        NarrowFMF.setNoInfs(NarrowFMF.noInfs() && FPT.hasNoInfs());
        match BO.getOpcode() {
            _ => {
                break;
            },
            FAdd => {
                FSub;
            },
            FMul => {
                if OpWidth >= LHSWidth + RHSWidth && DstWidth >= SrcWidth {
                    let mut LHS: *mut Value = self.Builder.CreateFPTrunc(BO.getOperand(0), Ty, "", null);
                    let mut RHS: *mut Value = self.Builder.CreateFPTrunc(BO.getOperand(1), Ty, "", null);
                    return CreateFMulFMF(LHS, RHS, NarrowFMF, "");
                }
            },
            FDiv => {
                if OpWidth >= 2 * DstWidth && DstWidth >= SrcWidth {
                    let mut LHS: *mut Value = self.Builder.CreateFPTrunc(BO.getOperand(0), Ty, "", null);
                    let mut RHS: *mut Value = self.Builder.CreateFPTrunc(BO.getOperand(1), Ty, "", null);
                    return CreateFDivFMF(LHS, RHS, NarrowFMF, "");
                }
            },
            FRem => {
                if SrcWidth == OpWidth {
                    break;
                }
                let mut LHS: *mut Value = null;
                let mut RHS: *mut Value = null;
                if LHSWidth == SrcWidth {
                    LHS = self.Builder.CreateFPTrunc(BO.getOperand(0), LHSMinType, "", null);
                    RHS = self.Builder.CreateFPTrunc(BO.getOperand(1), LHSMinType, "", null);
                } else {
                    LHS = self.Builder.CreateFPTrunc(BO.getOperand(0), RHSMinType, "", null);
                    RHS = self.Builder.CreateFPTrunc(BO.getOperand(1), RHSMinType, "", null);
                }
                let mut ExactResult: *mut Value = self.Builder.CreateFRemFMF(LHS, RHS, BO, "", null);
                return CreateFPCast(ExactResult, Ty, "", null);
            },
        }
    }
    let mut X: *mut Value = null;
    let mut Op: *mut Instruction = dyn_cast(FPT.getOperand(0));
    if Op && Op.hasOneUse() {
        let mut FMF: FastMathFlags = FPT.getFastMathFlags();
        if dyn_cast(Op) {
            FPMO;
        } else {
            operator(FMF, FPMO.getFastMathFlags());
        }
        if match(Op, m_FNeg(m_Value(X))) {
            let mut InnerTrunc: *mut Value = self.Builder.CreateFPTruncFMF(X, Ty, FMF, "", null);
            let mut Neg: *mut Value = self.Builder.CreateFNegFMF(InnerTrunc, FMF, "", null);
            return self.replaceInstUsesWith(FPT, Neg);
        }
        let mut Cond: *mut Value = null;
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if match(Op, m_Select(m_Value(Cond), m_FPExt(m_SpecificType(Ty, X)), m_Value(Y))) {
            let mut NarrowY: *mut Value = self.Builder.CreateFPTruncFMF(Y, Ty, FMF, "", null);
            let mut Sel: *mut Value = self.Builder.CreateSelectFMF(Cond, X, NarrowY, FMF, "narrow.sel", Op);
            return self.replaceInstUsesWith(FPT, Sel);
        }
        if match(Op, m_Select(m_Value(Cond), m_Value(Y), m_FPExt(m_SpecificType(Ty, X)))) {
            let mut NarrowY: *mut Value = self.Builder.CreateFPTruncFMF(Y, Ty, FMF, "", null);
            let mut Sel: *mut Value = self.Builder.CreateSelectFMF(Cond, NarrowY, X, FMF, "narrow.sel", Op);
            return self.replaceInstUsesWith(FPT, Sel);
        }
    }
    if dyn_cast(FPT.getOperand(0)) {
        II;
    } else {
        match II.getIntrinsicID() {
            _ => {
                break;
            },
            ceil => {
                fabs;
            },
        }
    }
    if shrinkInsertElt(FPT, self.Builder) {
        I;
    } else {
        return I;
    }
    let mut Src: *mut Value = FPT.getOperand(0);
    if isa(Src) || isa(Src) {
        let mut FPCast: *mut CastInst = cast(Src);
        if self.isKnownExactCastIntToFP(*FPCast) {
            return Create(FPCast.getOpcode(), FPCast.getOperand(0), Ty, "", null);
        }
    }
    return null;
}

fn InstCombinerImpl::visitFPExt(self, FPExt: *mut CastInst) -> *mut Instruction {
    let mut Ty: *mut Type = FPExt.getType();
    let mut Src: *mut Value = FPExt.getOperand(0);
    if isa(Src) || isa(Src) {
        let mut FPCast: *mut CastInst = cast(Src);
        if self.isKnownExactCastIntToFP(*FPCast) {
            return Create(FPCast.getOpcode(), FPCast.getOperand(0), Ty, "", null);
        }
    }
    return self.commonCastTransforms(FPExt);
}

fn foldFPtoI(FI: *mut Instruction, IC: *mut InstCombiner) -> *mut Instruction {
    let mut Mask: FPClassTest = if FI.getOpcode() == FPToUI { fcPosNormal } else { fcNormal };
    let mut FPClass: KnownFPClass = computeKnownFPClass(FI.getOperand(0), Mask, IC.getSimplifyQuery().getWithInstruction(&mut FI), 0);
    if FPClass.isKnownNever(Mask) {
        return IC.replaceInstUsesWith(FI, getNullValue(FI.getType()));
    }
    let mut IsSigned: bool = FI.getOpcode() == FPToSI;
    let mut X: *mut Value = null;
    let mut APF: *APFloat = null;
    if IsSigned {
        if !match(FI.getOperand(0), m_OneUse(m_FDiv(m_SIToFP(m_Value(X)), m_APFloat(APF)))) {
            return null;
        }
    } else {
        if !match(FI.getOperand(0), m_OneUse(m_FDiv(m_UIToFP(m_Value(X)), m_APFloat(APF)))) {
            return null;
        }
    }
    let mut IntTy: *mut Type = X.getType();
    if FI.getType() != IntTy {
        return null;
    }
    let mut IntWidth: u32 = IntTy.getScalarSizeInBits();
    let mut Precision: u32 = semanticsPrecision(APF.getSemantics());
    if Precision + IsSigned < IntWidth {
        return null;
    }
    if !APF.isInteger() {
        return null;
    }
    let mut Divisor: APSInt = APSInt { IntWidth, !IsSigned };
    let mut IsExact: bool = false;
    APF.convertToInteger(Divisor, rmTowardZero, &mut IsExact);
    if !IsExact {
        return null;
    }
    if Divisor.isZero() {
        return null;
    }
    if IsSigned && Divisor.isAllOnes() {
        return null;
    }
    let mut C: *mut Constant = get(IntTy, Divisor);
    return if IsSigned { CreateSDiv(X, C, "") } else { CreateUDiv(X, C, "") };
}

fn InstCombinerImpl::visitFPToUI(self, FI: *mut FPToUIInst) -> *mut Instruction {
    if self.foldItoFPtoI(FI) {
        I;
    } else {
        return I;
    }
    if foldFPtoI(FI, *self) {
        I;
    } else {
        return I;
    }
    return self.commonCastTransforms(FI);
}

fn InstCombinerImpl::visitFPToSI(self, FI: *mut FPToSIInst) -> *mut Instruction {
    if self.foldItoFPtoI(FI) {
        I;
    } else {
        return I;
    }
    if foldFPtoI(FI, *self) {
        I;
    } else {
        return I;
    }
    return self.commonCastTransforms(FI);
}

fn InstCombinerImpl::visitUIToFP(self, CI: *mut CastInst) -> *mut Instruction {
    if self.commonCastTransforms(CI) {
        R;
    } else {
        return R;
    }
    if !CI.hasNonNeg() && isKnownNonNegative(CI.getOperand(0), self.SQ, 0) {
        CI.setNonNeg(true);
        return &mut CI;
    }
    let mut Src: *mut Value = CI.getOperand(0);
    let mut X: *mut Value = null;
    let mut Mask: *mut Constant = null;
    if match(Src, m_OneUse(m_And(m_OneUse(m_Trunc(m_Value(X))), m_ImmConstant(Mask)))) {
        let mut SourceWidth: u32 = Src.getType().getScalarSizeInBits();
        let mut InputWidth: u32 = X.getType().getScalarSizeInBits();
        if !self.DL.isLegalInteger(SourceWidth) && self.shouldChangeType(SourceWidth, InputWidth) {
            let mut MaskedX: *mut Value = self.Builder.CreateAnd(X, self.Builder.CreateZExt(Mask, X.getType(), "", false), "");
            let mut NewUIToFP: *mut CastInst = Create(UIToFP, MaskedX, CI.getType(), "", null);
            NewUIToFP.setNonNeg(CI.hasNonNeg());
            return NewUIToFP;
        }
    }
    return null;
}

fn InstCombinerImpl::visitSIToFP(self, CI: *mut CastInst) -> *mut Instruction {
    if self.commonCastTransforms(CI) {
        R;
    } else {
        return R;
    }
    if isKnownNonNegative(CI.getOperand(0), self.SQ, 0) {
        let mut UI: *mut CastInst = Create(UIToFP, CI.getOperand(0), CI.getType(), "", null);
        UI.setNonNeg(true);
        UI.setHasNoInfs(CI.hasNoInfs());
        UI.setHasNoSignedZeros(CI.hasNoSignedZeros());
        return UI;
    }
    return null;
}

fn InstCombinerImpl::visitIntToPtr(self, CI: *mut IntToPtrInst) -> *mut Instruction {
    let mut AS: u32 = CI.getAddressSpace();
    if CI.getOperand(0).getType().getScalarSizeInBits() != self.DL.getPointerSizeInBits(AS) {
        let mut Ty: *mut Type = CI.getOperand(0).getType().getWithNewType(self.DL.getIntPtrType(CI.getContext(), AS));
        let mut P: *mut Value = self.Builder.CreateZExtOrTrunc(CI.getOperand(0), Ty, "");
        return IntToPtrInst { P, CI.getType(), "", null };
    }
    let mut Base: *mut Value = null;
    let mut Offset: *mut Value = null;
    let mut UsesPointerAsInt: Closure_12 = Closure_12 {};
    if match(CI.getOperand(0), m_OneUse(m_c_Add(m_PtrToIntSameSize(self.DL, m_Value(Base)), m_Value(Offset)))) && CI.getType().getPointerAddressSpace() == Base.getType().getPointerAddressSpace() && all_of(CI.users(), UsesPointerAsInt) {
        return Create(self.Builder.getInt8Ty(), Base, Offset, "", null);
    }
    if self.commonCastTransforms(CI) {
        I;
    } else {
        return I;
    }
    return null;
}

fn InstCombinerImpl::foldPtrToIntOrAddrOfGEP(self, IntTy: *mut Type, Ptr: *mut Value) -> *mut Value {
    let mut PtrTy: *mut Type = Ptr.getType();
    let mut GEPs: SmallVector<GEPOperator *> = SmallVector<GEPOperator *> {};
    while true {
        let mut GEP: *mut GEPOperator = dyn_cast(Ptr);
        if !GEP || !GEP.hasOneUse() {
            break;
        }
        GEPs.push(GEP);
        Ptr = GEP.getPointerOperand();
    }
    if GEPs.is_empty() || PtrTy != Ptr.getType() {
        return null;
    }
    let mut Res: *mut Value = null;
    let mut IdxTy: *mut Type = self.DL.getIndexType(PtrTy);
    if match(Ptr, m_OneUse(m_IntToPtr(m_Value(Res)))) && Res.getType() == IntTy && IntTy == IdxTy {} else if isa(Ptr) {
        Res = getNullValue(IdxTy);
    } else {
        return null;
    }
    for GEP in reverse(GEPs) {
        let mut Offset: *mut Value = self.EmitGEPOffset(GEP, false);
        Res = self.Builder.CreateAdd(Res, Offset, "", GEP.hasNoUnsignedWrap(), false);
    }
    return self.Builder.CreateZExtOrTrunc(Res, IntTy, "");
}

fn InstCombinerImpl::visitPtrToInt(self, CI: *mut PtrToIntInst) -> *mut Instruction {
    let mut SrcOp: *mut Value = CI.getPointerOperand();
    let mut SrcTy: *mut Type = SrcOp.getType();
    let mut Ty: *mut Type = CI.getType();
    let mut AS: u32 = CI.getPointerAddressSpace();
    let mut TySize: u32 = Ty.getScalarSizeInBits();
    let mut PtrSize: u32 = self.DL.getPointerSizeInBits(AS);
    if TySize != PtrSize {
        let mut IntPtrTy: *mut Type = SrcTy.getWithNewType(self.DL.getIntPtrType(CI.getContext(), AS));
        let mut P: *mut Value = self.Builder.CreatePtrToInt(SrcOp, IntPtrTy, "");
        return CreateIntegerCast(P, Ty, false, "", null);
    }
    let mut Ptr: *mut Value = null;
    let mut Mask: *mut Value = null;
    if match(SrcOp, m_OneUse(m_Intrinsic(m_Value(Ptr), m_SpecificType(Ty, Mask)))) {
        return CreateAnd(self.Builder.CreatePtrToInt(Ptr, Ty, ""), Mask, "");
    }
    if self.foldPtrToIntOrAddrOfGEP(Ty, SrcOp) {
        V;
    } else {
        return self.replaceInstUsesWith(CI, V);
    }
    let mut Vec: *mut Value = null;
    let mut Scalar: *mut Value = null;
    let mut Index: *mut Value = null;
    if match(SrcOp, m_OneUse(m_InsertElt(m_IntToPtr(m_SpecificType(Ty, Vec)), m_Value(Scalar), m_Value(Index)))) {
        assert!(Vec.getType().getScalarSizeInBits() == PtrSize, "Wrong type");
        let mut NewCast: *mut Value = self.Builder.CreatePtrToInt(Scalar, Ty.getScalarType(), "");
        return Create(Vec, NewCast, Index, "", null);
    }
    return self.commonCastTransforms(CI);
}

fn InstCombinerImpl::visitPtrToAddr(self, CI: *mut PtrToAddrInst) -> *mut Instruction {
    let mut SrcOp: *mut Value = CI.getPointerOperand();
    let mut Ty: *mut Type = CI.getType();
    let mut Ptr: *mut Value = null;
    let mut Mask: *mut Value = null;
    if match(SrcOp, m_OneUse(m_Intrinsic(m_Value(Ptr), m_SpecificType(Ty, Mask)))) {
        return CreateAnd(self.Builder.CreatePtrToAddr(Ptr, ""), Mask, "");
    }
    if self.foldPtrToIntOrAddrOfGEP(Ty, SrcOp) {
        V;
    } else {
        return self.replaceInstUsesWith(CI, V);
    }
    return self.commonCastTransforms(CI);
}

fn optimizeVectorResizeWithIntegerBitCasts(InVal: *mut Value, DestTy: *mut VectorType, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut SrcTy: *mut VectorType = cast(InVal.getType());
    if SrcTy.getElementType() != DestTy.getElementType() {
        if SrcTy.getElementType().getPrimitiveSizeInBits() != DestTy.getElementType().getPrimitiveSizeInBits() {
            return null;
        }
        SrcTy = get(DestTy.getElementType(), cast(SrcTy).getNumElements());
        InVal = IC.Builder.CreateBitCast(InVal, SrcTy, "");
    }
    let mut IsBigEndian: bool = IC.getDataLayout().isBigEndian();
    let mut SrcElts: u32 = cast(SrcTy).getNumElements();
    let mut DestElts: u32 = cast(DestTy).getNumElements();
    assert!(SrcElts != DestElts, "Element counts should be different.");
    let mut ShuffleMaskStorage: iota_range<int>>, 16U> = to_vector(seq(0, SrcElts));
    let mut ShuffleMask: ArrayRef<int> = ArrayRef<int> {};
    let mut V2: *mut Value = null;
    if SrcElts > DestElts {
        V2 = get(SrcTy);
        ShuffleMask = ShuffleMaskStorage;
        if IsBigEndian {
            ShuffleMask = ShuffleMask.take_back(DestElts);
        } else {
            ShuffleMask = ShuffleMask.take_front(DestElts);
        }
    } else {
        V2 = getNullValue(SrcTy);
        let mut NullElt: u32 = SrcElts;
        let mut DeltaElts: u32 = DestElts - SrcElts;
        if IsBigEndian {
            ShuffleMaskStorage.insert(ShuffleMaskStorage.begin(), DeltaElts, NullElt);
        } else {
            ShuffleMaskStorage.append(DeltaElts, NullElt);
        }
        ShuffleMask = ShuffleMaskStorage;
    }
    return ShuffleVectorInst { InVal, V2, ShuffleMask, "", null };
}

fn isMultipleOfTypeSize(Value: u32, Ty: *mut Type) -> bool {
    return Value % Ty.getPrimitiveSizeInBits().operator unsigned long long() == 0;
}

fn getTypeSizeIndex(Value: u32, Ty: *mut Type) -> u32 {
    return Value / Ty.getPrimitiveSizeInBits().operator unsigned long long();
}

fn collectInsertionElements(V: *mut Value, Shift: u32, Elements: *mut SmallVectorImpl<Value *>, VecEltTy: *mut Type, isBigEndian: bool) -> bool {
    assert!(isMultipleOfTypeSize(Shift, VecEltTy), "Shift should be a multiple of the element type size");
    if match(V, m_Poison()) {
        return true;
    }
    if V.getType() == VecEltTy {
        if dyn_cast(V) {
            C;
        } else if C.isNullValue() {
            return true;
        }
        let mut ElementIndex: u32 = getTypeSizeIndex(Shift, VecEltTy);
        if isBigEndian {
            ElementIndex = Elements.len - ElementIndex - 1;
        }
        if Elements[ElementIndex] {
            return false;
        }
        Elements[ElementIndex] = V;
        return true;
    }
    if dyn_cast(V) {
        C;
    } else {
        let mut NumElts: u32 = getTypeSizeIndex(C.getType().getPrimitiveSizeInBits().operator unsigned long long(), VecEltTy);
        if NumElts == 1 {
            return collectInsertionElements(getBitCast(C, VecEltTy, false), Shift, Elements, VecEltTy, isBigEndian);
        }
        if !isa(C.getType()) {
            C = getBitCast(C, get(V.getContext(), C.getType().getPrimitiveSizeInBits().operator unsigned long long()), false);
        }
        let mut ElementSize: u32 = VecEltTy.getPrimitiveSizeInBits().operator unsigned long long();
        let mut ElementIntTy: *mut Type = get(C.getContext(), ElementSize);
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            let mut ShiftI: u32 = i * ElementSize;
            let mut Piece: *mut Constant = ConstantFoldBinaryInstruction(LShr, C, get(C.getType(), ShiftI, false, false));
            if !Piece {
                return false;
            }
            Piece = getTrunc(Piece, ElementIntTy, false);
            if !collectInsertionElements(Piece, ShiftI + Shift, Elements, VecEltTy, isBigEndian) {
                return false;
            }
        }
        return true;
    }
    if !V.hasOneUse() {
        return false;
    }
    let mut I: *mut Instruction = dyn_cast(V);
    if !I {
        return false;
    }
    match I.getOpcode() {
        _ => {
            return false;
        },
        BitCast => {
            if I.getOperand(0).getType().isVectorTy() {
                return false;
            }
        },
        ZExt => {
            if !isMultipleOfTypeSize(I.getOperand(0).getType().getPrimitiveSizeInBits().operator unsigned long long(), VecEltTy) {
                return false;
            }
        },
        Or => {
            return collectInsertionElements(I.getOperand(0), Shift, Elements, VecEltTy, isBigEndian) && collectInsertionElements(I.getOperand(1), Shift, Elements, VecEltTy, isBigEndian);
        },
        Shl => {
            let mut CI: *mut ConstantInt = dyn_cast(I.getOperand(1));
            if !CI {
                return false;
            }
            Shift += CI.getZExtValue();
            if !isMultipleOfTypeSize(Shift, VecEltTy) {
                return false;
            }
            return collectInsertionElements(I.getOperand(0), Shift, Elements, VecEltTy, isBigEndian);
        },
    }
}

fn optimizeIntegerToVectorInsertions(CI: *mut BitCastInst, IC: *mut InstCombinerImpl) -> *mut Value {
    let mut DestVecTy: *mut FixedVectorType = cast(CI.getType());
    let mut IntInput: *mut Value = CI.getOperand(0);
    if isa(IntInput) {
        return null;
    }
    let mut Elements: SmallVector<Value *, 8> = DestVecTy.getNumElements();
    if !collectInsertionElements(IntInput, 0, Elements, DestVecTy.getElementType(), IC.getDataLayout().isBigEndian()) {
        return null;
    }
    let mut Result: *mut Value = getNullValue(CI.getType());
    for let mut i: u32 = 0;
let mut e: u32 = Elements.len; i != e; i += 1 {
        if !Elements[i] {
            continue;
        }
        Result = IC.Builder.CreateInsertElement(Result, Elements[i], i, "");
    }
    return Result;
}

fn canonicalizeBitCastExtElt(BitCast: *mut BitCastInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut VecOp: *mut Value = null;
    let mut Index: *mut Value = null;
    if !match(BitCast.getOperand(0), m_OneUse(m_ExtractElt(m_Value(VecOp), m_Value(Index)))) {
        return null;
    }
    let mut DestType: *mut Type = BitCast.getType();
    let mut VecType: *mut VectorType = cast(VecOp.getType());
    if isValidElementType(DestType) {
        let mut NewVecType: *mut VectorType = get(DestType, VecType);
        let mut NewBC: *mut Value = IC.Builder.CreateBitCast(VecOp, NewVecType, "bc");
        return Create(NewBC, Index, "", null);
    }
    let mut FixedVType: *mut FixedVectorType = dyn_cast(VecType);
    if DestType.isVectorTy() && FixedVType && FixedVType.getNumElements() == 1 {
        return Create(BitCast, VecOp, DestType, "", null);
    }
    return null;
}

fn foldBitCastBitwiseLogic(BitCast: *mut BitCastInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut DestTy: *mut Type = BitCast.getType();
    let mut BO: *mut BinaryOperator = null;
    if !match(BitCast.getOperand(0), m_OneUse(m_BinOp(BO))) || !BO.isBitwiseLogicOp() {
        return null;
    }
    if !DestTy.isVectorTy() || !BO.getType().isVectorTy() {
        return null;
    }
    if DestTy.isFPOrFPVectorTy() {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if match(BO.getOperand(0), m_OneUse(m_BitCast(m_Value(X)))) && match(BO.getOperand(1), m_OneUse(m_BitCast(m_Value(Y)))) {
            if X.getType().isFPOrFPVectorTy() && Y.getType().isIntOrIntVectorTy() {
                let mut CastedOp: *mut Value = Builder.CreateBitCast(BO.getOperand(0), Y.getType(), "");
                let mut NewBO: *mut Value = Builder.CreateBinOp(BO.getOpcode(), CastedOp, Y, "", null);
                return CreateBitOrPointerCast(NewBO, DestTy, "", null);
            }
            if X.getType().isIntOrIntVectorTy() && Y.getType().isFPOrFPVectorTy() {
                let mut CastedOp: *mut Value = Builder.CreateBitCast(BO.getOperand(1), X.getType(), "");
                let mut NewBO: *mut Value = Builder.CreateBinOp(BO.getOpcode(), CastedOp, X, "", null);
                return CreateBitOrPointerCast(NewBO, DestTy, "", null);
            }
        }
        return null;
    }
    if !DestTy.isIntOrIntVectorTy() {
        return null;
    }
    let mut X: *mut Value = null;
    if match(BO.getOperand(0), m_OneUse(m_BitCast(m_SpecificType(DestTy, X)))) && !isa(X) {
        let mut CastedOp1: *mut Value = Builder.CreateBitCast(BO.getOperand(1), DestTy, "");
        return Create(BO.getOpcode(), X, CastedOp1, "", null);
    }
    if match(BO.getOperand(1), m_OneUse(m_BitCast(m_SpecificType(DestTy, X)))) && !isa(X) {
        let mut CastedOp0: *mut Value = Builder.CreateBitCast(BO.getOperand(0), DestTy, "");
        return Create(BO.getOpcode(), CastedOp0, X, "", null);
    }
    let mut C: *mut Constant = null;
    if match(BO.getOperand(1), m_Constant(C)) {
        let mut CastedOp0: *mut Value = Builder.CreateBitCast(BO.getOperand(0), DestTy, "");
        let mut CastedC: *mut Value = Builder.CreateBitCast(C, DestTy, "");
        return Create(BO.getOpcode(), CastedOp0, CastedC, "", null);
    }
    return null;
}

fn foldBitCastSelect(BitCast: *mut BitCastInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Cond: *mut Value = null;
    let mut TVal: *mut Value = null;
    let mut FVal: *mut Value = null;
    if !match(BitCast.getOperand(0), m_OneUse(m_Select(m_Value(Cond), m_Value(TVal), m_Value(FVal)))) {
        return null;
    }
    let mut CondTy: *mut Type = Cond.getType();
    let mut DestTy: *mut Type = BitCast.getType();
    let mut DestVecTy: *mut VectorType = dyn_cast(DestTy);
    if dyn_cast(CondTy) {
        CondVTy;
    } else if !DestVecTy || CondVTy.getElementCount() != DestVecTy.getElementCount() {
        return null;
    }
    let mut Sel: *mut Instruction = cast(BitCast.getOperand(0));
    let mut SrcVecTy: *mut VectorType = dyn_cast(TVal.getType());
    if (isa(TVal) || isa(FVal)) && (!DestVecTy || (SrcVecTy && isKnownLE(DestVecTy.getElementCount(), SrcVecTy.getElementCount()))) {
        let mut CastedTVal: *mut Value = Builder.CreateBitCast(TVal, DestTy, "");
        let mut CastedFVal: *mut Value = Builder.CreateBitCast(FVal, DestTy, "");
        return Create(Cond, CastedTVal, CastedFVal, "", null, Sel);
    }
    if (DestVecTy != null) != (SrcVecTy != null) {
        return null;
    }
    let mut X: *mut Value = null;
    if match(TVal, m_OneUse(m_BitCast(m_SpecificType(DestTy, X)))) && !isa(X) {
        let mut CastedVal: *mut Value = Builder.CreateBitCast(FVal, DestTy, "");
        return Create(Cond, X, CastedVal, "", null, Sel);
    }
    if match(FVal, m_OneUse(m_BitCast(m_SpecificType(DestTy, X)))) && !isa(X) {
        let mut CastedVal: *mut Value = Builder.CreateBitCast(TVal, DestTy, "");
        return Create(Cond, CastedVal, X, "", null, Sel);
    }
    return null;
}

fn hasStoreUsersOnly(CI: *mut CastInst) -> bool {
    for U in CI.users() {
        if !isa(U) {
            return false;
        }
    }
    return true;
}

fn InstCombinerImpl::optimizeBitCastFromPhi(self, CI: *mut CastInst, PN: *mut PHINode) -> *mut Instruction {
    if hasStoreUsersOnly(CI) {
        return null;
    }
    let mut Src: *mut Value = CI.getOperand(0);
    let mut SrcTy: *mut Type = Src.getType();
    let mut DestTy: *mut Type = CI.getType();
    let mut PhiWorklist: SmallVector<PHINode *, 4> = SmallVector<PHINode *, 4> {};
    let mut OldPhiNodes: SmallSetVector<PHINode *, 4> = SmallSetVector<PHINode *, 4> {};
    PhiWorklist.push(PN);
    OldPhiNodes.insert(PN);
    while !PhiWorklist.is_empty() {
        let mut OldPN: *mut PHINode = PhiWorklist.pop_back_val();
        for IncValue in OldPN.incoming_values() {
            if isa(IncValue) {
                continue;
            }
            if dyn_cast(IncValue) {
                LI;
            } else {
                let mut Addr: *mut Value = LI.getOperand(0);
                if Addr == &mut CI || isa(Addr) {
                    return null;
                }
                if DestTy.isX86_AMXTy() {
                    return null;
                }
                if LI.hasOneUse() && LI.isSimple() {
                    continue;
                }
                return null;
            }
            if dyn_cast(IncValue) {
                PNode;
            } else {
                if OldPhiNodes.insert(PNode) {
                    PhiWorklist.push(PNode);
                }
                continue;
            }
            let mut BCI: *mut BitCastInst = dyn_cast(IncValue);
            if !BCI {
                return null;
            }
            let mut TyA: *mut Type = BCI.getOperand(0).getType();
            let mut TyB: *mut Type = BCI.getType();
            if TyA != DestTy || TyB != SrcTy {
                return null;
            }
        }
    }
    for OldPN in OldPhiNodes {
        for V in OldPN.users() {
            if dyn_cast(V) {
                SI;
            } else {
                if !SI.isSimple() || SI.getOperand(0) != OldPN {
                    return null;
                }
            }
        }
    }
    let mut NewPNodes: SmallDenseMap<PHINode *, PHINode *> = SmallDenseMap<PHINode *, PHINode *> {};
    for OldPN in OldPhiNodes {
        self.Builder.SetInsertPoint(OldPN);
        let mut NewPN: *mut PHINode = self.Builder.CreatePHI(DestTy, OldPN.getNumOperands(), "");
        NewPNodes[OldPN] = NewPN;
    }
    for OldPN in OldPhiNodes {
        let mut NewPN: *mut PHINode = NewPNodes[OldPN];
        for let mut j: u32 = 0;
let mut e: u32 = OldPN.getNumOperands(); j != e; j += 1 {
            let mut V: *mut Value = OldPN.getOperand(j);
            let mut NewV: *mut Value = null;
            if dyn_cast(V) {
                C;
            } else {
                NewV = getBitCast(C, DestTy, false);
            }
            assert!(NewV);
            NewPN.addIncoming(NewV, OldPN.getIncomingBlock(j));
        }
    }
    let mut RetVal: *mut Instruction = null;
    for OldPN in OldPhiNodes {
        let mut NewPN: *mut PHINode = NewPNodes[OldPN];
        for V in make_early_inc_range(OldPN.users()) {
            if dyn_cast(V) {
                SI;
            } else {
                assert!(SI.isSimple() && SI.getOperand(0) == OldPN);
                self.Builder.SetInsertPoint(SI);
                let mut NewBC: *mut BitCastInst = cast(self.Builder.CreateBitCast(NewPN, SrcTy, ""));
                SI.setOperand(0, NewBC);
                self.Worklist.push(SI);
                assert!(hasStoreUsersOnly(*NewBC);
            }
        }
    }
    return RetVal;
}

fn foldCopySignIdioms(CI: *mut BitCastInst, Builder: *mut BuilderTy, SQ: *SimplifyQuery) -> *mut Value {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut FTy: *mut Type = CI.getType();
    if !FTy.isFPOrFPVectorTy() {
        return null;
    }
    if !match(&mut CI, m_ElementWiseBitCast(m_c_Or(m_And(m_ElementWiseBitCast(m_Value(X)), m_SignMask()), m_Value(Y)))) {
        return null;
    }
    if X.getType() != FTy {
        return null;
    }
    if !isKnownNonNegative(Y, SQ, 0) {
        return null;
    }
    return Builder.CreateCopySign(Builder.CreateBitCast(Y, FTy, ""), X, FMFSource {}, "");
}

fn InstCombinerImpl::visitBitCast(self, CI: *mut BitCastInst) -> *mut Instruction {
    let mut Src: *mut Value = CI.getOperand(0);
    let mut SrcTy: *mut Type = Src.getType();
    let mut DestTy: *mut Type = CI.getType();
    if DestTy == Src.getType() {
        return self.replaceInstUsesWith(CI, Src);
    }
    if isa(DestTy) {
        if isa(SrcTy) {
            if isa(Src) || isa(Src) {
                let mut SrcCast: *mut CastInst = cast(Src);
                if dyn_cast(SrcCast.getOperand(0)) {
                    BCIn;
                } else if isa(BCIn.getOperand(0).getType()) {
                    if optimizeVectorResizeWithIntegerBitCasts(BCIn.getOperand(0), cast(DestTy), *self) {
                        I;
                    } else {
                        return I;
                    }
                }
            }
            if optimizeIntegerToVectorInsertions(CI, *self) {
                V;
            } else {
                return self.replaceInstUsesWith(CI, V);
            }
        }
    }
    if dyn_cast(SrcTy) {
        SrcVTy;
    } else {
        if SrcVTy.getNumElements() == 1 {
            if !DestTy.isVectorTy() {
                let mut Elem: *mut Value = self.Builder.CreateExtractElement(Src, u64 { 0 }, "");
                return Create(BitCast, Elem, DestTy, "", null);
            }
            if dyn_cast(Src) {
                InsElt;
            } else {
                return BitCastInst { InsElt.getOperand(1), DestTy, "", null };
            }
        }
        let mut BitWidth: u32 = DestTy.getScalarSizeInBits();
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        let mut IndexC: u64 = 0;
        if match(Src, m_OneUse(m_InsertElt(m_OneUse(m_BitCast(m_SpecificType(DestTy, X))), m_Value(Y), m_ConstantInt(IndexC)))) && DestTy.isIntegerTy() && Y.getType().isIntegerTy() && self.isDesirableIntType(BitWidth) {
            if self.DL.isBigEndian() {
                IndexC = SrcVTy.getNumElements() - 1 - IndexC;
            }
            if IndexC == 0 {
                let mut EltWidth: u32 = Y.getType().getScalarSizeInBits();
                let mut MaskC: APInt = getHighBitsSet(BitWidth, BitWidth - EltWidth);
                let mut AndX: *mut Value = self.Builder.CreateAnd(X, MaskC, "");
                let mut ZextY: *mut Value = self.Builder.CreateZExt(Y, DestTy, "", false);
                return CreateOr(AndX, ZextY, "");
            }
        }
    }
    if dyn_cast(Src) {
        Shuf;
    } else {
        let mut ShufOp0: *mut Value = Shuf.getOperand(0);
        let mut ShufOp1: *mut Value = Shuf.getOperand(1);
        let mut ShufElts: ElementCount = cast(Shuf.getType()).getElementCount();
        let mut SrcVecElts: ElementCount = cast(ShufOp0.getType()).getElementCount();
        if Shuf.hasOneUse() && DestTy.isVectorTy() && cast(DestTy).getElementCount() == ShufElts && ShufElts == SrcVecElts {
            let mut Tmp: *mut BitCastInst = null;
            if ((Tmp = dyn_cast(ShufOp0)) && Tmp.getOperand(0).getType() == DestTy) || ((Tmp = dyn_cast(ShufOp1)) && Tmp.getOperand(0).getType() == DestTy) {
                let mut LHS: *mut Value = self.Builder.CreateBitCast(ShufOp0, DestTy, "");
                let mut RHS: *mut Value = self.Builder.CreateBitCast(ShufOp1, DestTy, "");
                return ShuffleVectorInst { LHS, RHS, Shuf.getShuffleMask(), "", null };
            }
        }
        if DestTy.isIntegerTy() && ShufElts.getKnownMinValue() % 2 == 0 && Shuf.hasOneUse() && Shuf.isReverse() && match(ShufOp1, m_Poison()) {
            let mut IntrinsicNum: u32 = 0;
            if self.DL.isLegalInteger(DestTy.getScalarSizeInBits()) && SrcTy.getScalarSizeInBits() == 8 {
                IntrinsicNum = bswap;
            } else if SrcTy.getScalarSizeInBits() == 1 {
                IntrinsicNum = bitreverse;
            }
            if IntrinsicNum != 0 {
                assert!(ShufOp0.getType() == SrcTy, "Unexpected shuffle mask");
                let mut BswapOrBitreverse: *mut Function = getOrInsertDeclaration(CI.getModule(), IntrinsicNum, DestTy);
                let mut ScalarX: *mut Value = self.Builder.CreateBitCast(ShufOp0, DestTy, "");
                return Create(BswapOrBitreverse, [ScalarX], ArrayRef<OperandBundleDef> {}, "", null);
            }
        }
    }
    if dyn_cast(Src) {
        PN;
    } else if self.optimizeBitCastFromPhi(CI, PN) {
        I;
    } else {
        return I;
    }
    if canonicalizeBitCastExtElt(CI, *self) {
        I;
    } else {
        return I;
    }
    if foldBitCastBitwiseLogic(CI, self.Builder) {
        I;
    } else {
        return I;
    }
    if foldBitCastSelect(CI, self.Builder) {
        I;
    } else {
        return I;
    }
    if foldCopySignIdioms(CI, self.Builder, self.SQ.getWithInstruction(&mut CI)) {
        V;
    } else {
        return self.replaceInstUsesWith(CI, V);
    }
    return self.commonCastTransforms(CI);
}

fn InstCombinerImpl::visitAddrSpaceCast(self, CI: *mut AddrSpaceCastInst) -> *mut Instruction {
    return self.commonCastTransforms(CI);
}

struct Closure_1 {
    cap_0: *TypeEvaluationHelper,
}

fn Closure_1::call(self: *Closure_1, V: *mut Value) -> bool {
        return self.Visited.contains(V);
    }

struct Closure_2 {
    cap_0: *mut TypeEvaluationHelper,
    IC: *mut InstCombinerImpl,
    CtxI: *mut Instruction,
}

unsafe fn Closure_2::call(self: *mut Closure_2, V: *mut Value, Ty: *mut Type) -> bool {
        return self.canEvaluateTruncatedPred(V, Ty, (*self.IC), self.CtxI);
    }

struct Closure_3 {
    cap_0: *mut TypeEvaluationHelper,
    Ty: *mut Type,
    IC: *mut InstCombinerImpl,
    CtxI: *mut Instruction,
}

unsafe fn Closure_3::call(self: *mut Closure_3, IncValue: *mut Value) -> bool {
                return self.canEvaluateTruncatedImpl(IncValue, self.Ty, (*self.IC), self.CtxI);
            }

struct Closure_4 {
    NarrowWidth: *mut u32,
    WideWidth: *mut u32,
    ShVal0: *mut *mut Value,
    ShVal1: *mut *mut Value,
    cap_4: *mut InstCombinerImpl,
}

unsafe fn Closure_4::call(self: *mut Closure_4, L: *mut Value, R: *mut Value, Width: u32) -> auto {
        let mut MaxShiftAmountWidth: u32 = Log2_32((*self.NarrowWidth));
        let mut HiBitMask: APInt = operator(getLowBitsSet((*self.WideWidth), MaxShiftAmountWidth));
        if (*self.ShVal0) == (*self.ShVal1) || self.MaskedValueIsZero(L, HiBitMask, null, 0) {
            if match(R, m_OneUse(m_Sub(m_SpecificInt(Width), m_Specific(L)))) {
                return L;
            }
        }
        if (*self.ShVal0) != (*self.ShVal1) {
            return null;
        }
        let mut X: *mut Value = null;
        let mut Mask: u32 = Width - 1;
        if match(L, m_And(m_Value(X), m_SpecificInt(Mask))) && match(R, m_And(m_Neg(m_Specific(X)), m_SpecificInt(Mask))) {
            return X;
        }
        if match(L, m_ZExt(m_And(m_Value(X), m_SpecificInt(Mask)))) && match(R, m_ZExt(m_And(m_Neg(m_Specific(X)), m_SpecificInt(Mask)))) {
            return X;
        }
        return null;
    }

struct Closure_5 {
    SrcTy: *mut *mut Type,
    C: *mut *mut Constant,
    cap_2: *mut InstCombinerImpl,
    A: *mut *mut Value,
}

unsafe fn Closure_5::call(self: *mut Closure_5, Width: u32) -> *mut Constant {
                let mut MaxAmt: *mut Constant = get((*self.SrcTy), Width - 1, false, false);
                let mut Cmp: *mut Constant = ConstantFoldCompareInstOperands(ICMP_ULT, (*self.C), MaxAmt, self.DL, null, null);
                let mut ShAmt: *mut Constant = ConstantFoldSelectInstruction(Cmp, (*self.C), MaxAmt);
                return ConstantFoldCastOperand(Trunc, ShAmt, (*self.A).getType(), self.DL);
            }

