        }
    }
    return self.commonCastTransforms(FPExt);
}

fn foldFPtoI(FI: *mut Instruction, IC: *mut InstCombiner) -> *mut Instruction {
    let mut Mask: FPClassTest = if FI.getOpcode() == FPToUI { fcPosNormal } else { fcNormal };
    let mut FPClass: KnownFPClass = computeKnownFPClass(FI.getOperand, Mask, IC.getSimplifyQuery().getWithInstruction(&mut FI));
    if FPClass.isKnownNever(Mask) {
        return IC.replaceInstUsesWith(FI, getNullValue(FI.getType));
    }
    let mut IsSigned: bool = FI.getOpcode() == FPToSI;
    let mut X: *mut Value = null;
    let mut APF: *APFloat = null;
    if IsSigned {
        if operator!(match(FI.getOperand, m_OneUse(m_FDiv(m_SIToFP(m_Value(X)))))) {
            return null;
        }
    } else {
        if operator!(match(FI.getOperand, m_OneUse(m_FDiv(m_UIToFP(m_Value(X)))))) {
            return null;
        }
    }
    let mut IntTy: *mut Type = X.getType();
    if FI.getType != IntTy {
        return null;
    }
    let mut IntWidth: u32 = IntTy.getScalarSizeInBits();
    let mut Precision: u32 = semanticsPrecision(APF.getSemantics());
    if Precision + IsSigned < IntWidth {
        return null;
    }
    if !APF.isInteger() {
        return null;
    }
    let mut Divisor: APSInt = APSInt { IntWidth, !IsSigned };
    let mut IsExact: bool = false;
    APF.convertToInteger(Divisor, rmTowardZero, &mut IsExact);
    if !IsExact {
        return null;
    }
    if Divisor.isZero() {
        return null;
    }
    if IsSigned && Divisor.isAllOnes() {
        return null;
    }
    let mut C: *mut Constant = get(IntTy, Divisor);
    return if IsSigned { CreateSDiv(X, C, "") } else { CreateUDiv(X, C, "") };
}

