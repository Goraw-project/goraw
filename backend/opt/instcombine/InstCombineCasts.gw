    let mut DestType: *mut Type = BitCast.getType;
    let mut VecType: *mut VectorType = cast(VecOp.getType());
    if isValidElementType(DestType) {
        let mut NewVecType: *mut auto = get(DestType, VecType);
        let mut NewBC: *mut auto = IC()(VecOp, "bc");
        return Create(Index);
    }
    let mut FixedVType: *mut auto = dyn_cast(VecType);
    if DestType.isVectorTy() &&  && () == 1 {
        return Create(BitCast, VecOp, DestType, "", null);
    }
    return null;
}

fn foldBitCastBitwiseLogic(BitCast: *mut BitCastInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut DestTy: *mut Type = BitCast.getType;
    let mut BO: *mut BinaryOperator = null;
    if operator!(match(BitCast.getOperand, m_OneUse(m_BinOp(BO)))) || !BO {
        return null;
    }
    if !DestTy.isVectorTy() || operator!(BO.getType()) {
        return null;
    }
    if DestTy.isFPOrFPVectorTy() {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if match(BO.getOperand(0), m_OneUse(m_BitCast(m_Value(X)))) && match(BO.getOperand(1), m_OneUse(m_BitCast(m_Value(Y)))) {
            if X.getType().isFPOrFPVectorTy() && Y.getType().isIntOrIntVectorTy() {
                let mut CastedOp: *mut Value = Builder()(BO.getOperand(0), Y.getType());
                let mut NewBO: *mut Value = Builder()(BO.getOpcode(), CastedOp, Y);
                return CreateBitOrPointerCast(NewBO, DestTy, "", null);
            }
            if X.getType().isIntOrIntVectorTy() && Y.getType().isFPOrFPVectorTy() {
                let mut CastedOp: *mut Value = Builder()(BO.getOperand(1), X.getType());
                let mut NewBO: *mut Value = Builder()(BO.getOpcode(), CastedOp, X);
                return CreateBitOrPointerCast(NewBO, DestTy, "", null);
            }
        }
        return null;
    }
    if !DestTy.isIntOrIntVectorTy() {
        return null;
    }
    let mut X: *mut Value = null;
    if match(BO.getOperand(0), m_OneUse(m_BitCast(m_SpecificType(DestTy, X)))) && !isa(X) {
        let mut CastedOp1: *mut Value = Builder()(BO.getOperand(1), DestTy);
        return Create(BO.getOpcode(), X, CastedOp1, "", null);
    }
    if match(BO.getOperand(1), m_OneUse(m_BitCast(m_SpecificType(DestTy, X)))) && !isa(X) {
        let mut CastedOp0: *mut Value = Builder()(BO.getOperand(0), DestTy);
        return Create(BO.getOpcode(), CastedOp0, X, "", null);
    }
    let mut C: *mut Constant = null;
    if match(BO.getOperand(1)) {
        let mut CastedOp0: *mut Value = Builder()(BO.getOperand(0), DestTy);
        let mut CastedC: *mut Value = Builder()(C, DestTy);
        return Create(BO.getOpcode(), CastedOp0, CastedC, "", null);
    }
    return null;
}

fn foldBitCastSelect(BitCast: *mut BitCastInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Cond: *mut Value = null;
    let mut TVal: *mut Value = null;
    let mut FVal: *mut Value = null;
    if operator!(match(BitCast.getOperand, m_OneUse(m_Select(m_Value(Cond), m_Value(TVal), m_Value(FVal))))) {
        return null;
    }
    let mut CondTy: *mut Type = Cond.getType();
    let mut DestTy: *mut Type = BitCast.getType;
    let mut DestVecTy: *mut auto = dyn_cast(DestTy);
    if  {
        if operator!() || () != () {
            return null;
        }
    }
    let mut Sel: *mut auto = cast(BitCast.getOperand);
    let mut SrcVecTy: *mut auto = dyn_cast(TVal.getType());
    if  {
        let mut CastedTVal: *mut Value = Builder()(TVal, DestTy);
        let mut CastedFVal: *mut Value = Builder()(FVal, DestTy);
        return Create(Cond, CastedTVal, CastedFVal, "", null);
    }
    if (DestVecTy() != null) != (SrcVecTy() != null) {
        return null;
    }
    let mut X: *mut Value = null;
    if match(TVal, m_OneUse(m_BitCast(m_SpecificType(DestTy, X)))) && !isa(X) {
        let mut CastedVal: *mut Value = Builder()(FVal, DestTy);
        return Create(Cond, X, CastedVal, "", null);
    }
    if match(FVal, m_OneUse(m_BitCast(m_SpecificType(DestTy, X)))) && !isa(X) {
        let mut CastedVal: *mut Value = Builder()(TVal, DestTy);
        return Create(Cond, CastedVal, X, "", null);
    }
    return null;
}

fn hasStoreUsersOnly(CI: *mut CastInst) -> bool {
    return true;
}

fn InstCombinerImpl::optimizeBitCastFromPhi(self, CI: *mut CastInst, PN: *mut PHINode) -> *mut Instruction {
    if hasStoreUsersOnly(CI) {
        return null;
    }
    let mut Src: *mut Value = CI.getOperand;
    let mut SrcTy: *mut Type = Src.getType();
    let mut DestTy: *mut Type = CI.getType;
    let mut PhiWorklist: SmallVector<PHINode *, 4> = zeroed();
    let mut OldPhiNodes: SmallSetVector<PHINode *, 4> = zeroed();
    PhiWorklist()(PN);
    OldPhiNodes()(PN);
    while operator!() {
        let mut OldPN: *mut auto = ();
    }
    let mut NewPNodes: i32 = 0;
    let mut RetVal: *mut Instruction = null;
    return RetVal;
}

fn foldCopySignIdioms(CI: *mut BitCastInst, Builder: *mut BuilderTy, SQ: *SimplifyQuery) -> *mut Value {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut FTy: *mut Type = CI.getType;
    if !FTy.isFPOrFPVectorTy() {
        return null;
    }
    if operator!(match(&mut CI, m_ElementWiseBitCast(m_c_Or(m_And(m_ElementWiseBitCast(m_Value(X))), m_Value(Y))))) {
        return null;
    }
    if X.getType() != FTy {
        return null;
    }
    if !isKnownNonNegative(Y, SQ, 0) {
        return null;
    }
    return Builder()(Builder()(Y, FTy), X);
}

fn InstCombinerImpl::visitBitCast(self, CI: *mut BitCastInst) -> *mut Instruction {
    let mut Src: *mut Value = CI.getOperand;
    let mut SrcTy: *mut Type = Src.getType();
    let mut DestTy: *mut Type = CI.getType;
    if DestTy == Src.getType() {
        return self.replaceInstUsesWith;
    }
    if isa(DestTy) {
        if isa(SrcTy) {
            if isa(Src) || isa(Src) {
                let mut SrcCast: *mut CastInst = cast(Src);
                if dyn_cast(SrcCast.getOperand) {
                    BCIn;
                } else if isa(BCIn.getOperand()) {
                    if optimizeVectorResizeWithIntegerBitCasts(BCIn.getOperand, cast(DestTy), *self) {
                        I;
                    } else {
                        return I;
                    }
                }
            }
            if optimizeIntegerToVectorInsertions(CI, *self) {
                V;
            } else {
                return self.replaceInstUsesWith;
            }
        }
    }
    if dyn_cast(SrcTy) {
        SrcVTy;
    } else {
        if SrcVTy.getNumElements() == 1 {
            if !DestTy.isVectorTy() {
                let mut Elem: *mut Value = null;
                return Create(BitCast, Elem, DestTy, "", null);
            }
            if  {
                return (1);
            }
        }
        let mut BitWidth: u32 = DestTy.getScalarSizeInBits();
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        let mut IndexC: u64 = 0;
        if match(Src, m_OneUse(m_InsertElt(m_OneUse(m_BitCast(m_SpecificType(DestTy, X))), m_Value(Y), m_ConstantInt(IndexC)))) && DestTy.isIntegerTy() && Y.getType().isIntegerTy() && self.isDesirableIntType(BitWidth) {
            if  {
                IndexC = SrcVTy.getNumElements() - 1 - IndexC;
            }
            if IndexC == 0 {
                let mut EltWidth: u32 = Y.getType().getScalarSizeInBits();
                let mut MaskC: APInt = getHighBitsSet(BitWidth, BitWidth - EltWidth);
                let mut AndX: *mut Value = null;
                let mut ZextY: *mut Value = null;
                return CreateOr(AndX, ZextY, "");
            }
        }
    }
    if  {
        let mut ShufOp0: *mut Value = (0);
        let mut ShufOp1: *mut Value = (1);
        let mut ShufElts: auto = cast()();
        let mut SrcVecElts: auto = cast(ShufOp0.getType())();
        if Shuf()() && DestTy.isVectorTy() && cast(DestTy)() ==  &&  ==  {
            let mut Tmp: *mut BitCastInst = null;
            if ((Tmp = dyn_cast(ShufOp0)) && Tmp.getOperand() == DestTy) || ((Tmp = dyn_cast(ShufOp1)) && Tmp.getOperand() == DestTy) {
                let mut LHS: *mut Value = null;
                let mut RHS: *mut Value = null;
                return LHS;
            }
        }
        if DestTy.isIntegerTy() && () % 2 == 0 && () && () && match(ShufOp1) {
            let mut IntrinsicNum: u32 = 0;
            if  {
                IntrinsicNum = bswap;
            } else if SrcTy.getScalarSizeInBits() == 1 {
                IntrinsicNum = bitreverse;
            }
            if IntrinsicNum != 0 {
                assert!(ShufOp0.getType() == SrcTy, "Unexpected shuffle mask");
                let mut BswapOrBitreverse: *mut Function = getOrInsertDeclaration(CI, IntrinsicNum, DestTy);
                let mut ScalarX: *mut Value = null;
                return Create(BswapOrBitreverse, void { ScalarX });
            }
        }
    }
    if dyn_cast(Src) {
        PN;
    } else if self.optimizeBitCastFromPhi {
        I;
    } else {
        return I;
    }
    if canonicalizeBitCastExtElt(CI, *self) {
        I;
    } else {
        return I;
    }
    if foldBitCastBitwiseLogic(CI) {
        I;
    } else {
        return I;
    }
    if foldBitCastSelect(CI) {
        I;
    } else {
        return I;
    }
    if foldCopySignIdioms(CI) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    return self.commonCastTransforms;
}

fn InstCombinerImpl::visitAddrSpaceCast(self, CI: *mut AddrSpaceCastInst) -> *mut Instruction {
    return self.commonCastTransforms;
}

struct Closure_1 {
    cap_0: *TypeEvaluationHelper,
}

fn Closure_1::call(self: *Closure_1, V: *mut Value) {}

struct Closure_2 {
    cap_0: *mut TypeEvaluationHelper,
    Ty: *mut Type,
    IC: *mut InstCombinerImpl,
    CtxI: *mut Instruction,
}

unsafe fn Closure_2::call(self: *mut Closure_2, IncValue: *mut Value) -> bool {
                return self.canEvaluateTruncatedImpl(IncValue, self.Ty, (*self.IC), self.CtxI);
            }

struct Closure_3 {
    NarrowWidth: *mut u32,
    WideWidth: *mut u32,
    ShVal0: *mut *mut Value,
    ShVal1: *mut *mut Value,
    cap_4: *mut InstCombinerImpl,
}

unsafe fn Closure_3::call(self: *mut Closure_3, L: *mut Value, R: *mut Value, Width: u32) -> auto {
        let mut MaxShiftAmountWidth: u32 = Log2_32((*self.NarrowWidth));
        let mut HiBitMask: APInt = operator(getLowBitsSet((*self.WideWidth), MaxShiftAmountWidth));
        if (*self.ShVal0) == (*self.ShVal1) || self.MaskedValueIsZero {
            if match(R, m_OneUse(m_Sub(m_Specific(L)))) {
                return L;
            }
        }
        if (*self.ShVal0) != (*self.ShVal1) {
            return null;
        }
        let mut X: *mut Value = null;
        let mut Mask: u32 = Width - 1;
        if match(L, m_And(m_Value(X))) && match(R, m_And(m_Neg(m_Specific(X)))) {
            return X;
        }
        if match(L, m_ZExt(m_And(m_Value(X)))) && match(R, m_ZExt(m_And(m_Neg(m_Specific(X))))) {
            return X;
        }
        return null;
    }

struct Closure_4 {
    SrcTy: *mut *mut Type,
    C: *mut *mut Constant,
    cap_2: *mut InstCombinerImpl,
    A: *mut *mut Value,
}

unsafe fn Closure_4::call(self: *mut Closure_4, Width: u32) -> auto {
                let mut MaxAmt: *mut Constant = get((*self.SrcTy), Width - 1, false, false);
                let mut Cmp: *mut Constant = ConstantFoldCompareInstOperands(ICMP_ULT, (*self.C), MaxAmt);
                let mut ShAmt: *mut Constant = ConstantFoldSelectInstruction(Cmp, (*self.C), MaxAmt);
            }

struct Closure_5 {}

fn Closure_5::call(self: *Closure_5, U: *mut User) -> bool {
        if isa(U) {
            return true;
        }
    }
