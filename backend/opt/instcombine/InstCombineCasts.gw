            if CI.getOpcode() != BitCast || match(&mut CI, m_ElementWiseBitCast(m_Value())) {
                if self.FoldOpIntoSelect(CI) {
                    NV;
                } else {
                    replaceAllDbgUsesWith(operator*(), *NV, CI);
                    return NV;
                }
