fn EvaluateInDifferentTypeImpl(V: *mut Value, Ty: *mut Type, isSigned: bool, IC: *mut InstCombinerImpl, Processed: *mut i32) -> *mut Value {
    if (V) {
        Result;
    } else {
        return Result;
    }
    if dyn_cast(V) {
        C;
    } else {
        return ConstantFoldIntegerCast(C, Ty, isSigned, IC.getDataLayout);
    }
    let mut I: *mut Instruction = cast(V);
    let mut Res: *mut Instruction = null;
    let mut Opc: u32 = I.getOpcode();
    match Opc {
        Add => {
            Sub;
        },
        Trunc => {
            ZExt;
        },
        Select => {
            let mut True: *mut Value = null;
            let mut False: *mut Value = null;
            Res = Create(I.getOperand, True, False);
            break;
        },
        PHI => {
            let mut OPN: *mut PHINode = cast(I);
            let mut NPN: *mut PHINode = Create(Ty, OPN.getNumIncomingValues(), "", null);
            for let mut i: u32 = 0;
let mut e: u32 = OPN.getNumIncomingValues(); i != e; i += 1 {
                let mut V: *mut Value = null;
                NPN.addIncoming(V, OPN.getIncomingBlock(i));
            }
            Res(NPN);
            break;
        },
        FPToUI => {
            FPToSI;
        },
        Call => {
            if dyn_cast(I) {
                II;
            } else {
                match II.getIntrinsicID() {
                    _ => {
                        llvm_unreachable_internal("Unsupported call!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCasts.cpp", 129);
                    },
                    vscale => {
                        let mut Fn: *mut Function = getOrInsertDeclaration(I.getModule(), vscale, void { Ty });
                        Res(Create(Fn.getFunctionType(), Fn));
                        break;
                    },
                    umin => {
                        umax;
                    },
                    abs => {
                        let mut Arg: *mut Value = null;
                        let mut Fn: *mut Function = getOrInsertDeclaration(I.getModule(), II.getIntrinsicID(), void { Ty });
                        Res = Create(Fn.getFunctionType(), Fn, void { Arg, getFalse(I.getContext) });
                        break;
                    },
                }
            }
        },
        ShuffleVector => {
            let mut ScalarTy: *mut auto = cast(Ty)();
            let mut VTy: *mut auto = cast(I.getOperand());
            let mut FixedTy: *mut auto = get();
            let mut Op0: *mut Value = null;
            let mut Op1: *mut Value = null;
            Res(Op0);
            break;
        },
        _ => {
            llvm_unreachable_internal("Unreachable!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCasts.cpp", 175);
        },
    }
    Res.takeName;
    let mut Result: *mut Value = IC()(Res, I()());
    if !V.hasOneUse() {
        Processed()[V] = Result;
    }
    return Result;
}

fn InstCombinerImpl::EvaluateInDifferentType(self, V: *mut Value, Ty: *mut Type, isSigned: bool) -> *mut Value {
    let mut Processed: i32 = 0;
}

fn InstCombinerImpl::isEliminableCastPair(self, CI1: *CastInst, CI2: *CastInst) -> CastOps {
    let mut SrcTy: *mut Type = CI1.getSrcTy();
    let mut MidTy: *mut Type = CI1.getDestTy();
    let mut DstTy: *mut Type = CI2.getDestTy();
    let mut firstOp: CastOps = CI1.getOpcode();
    let mut secondOp: CastOps = CI2.getOpcode();
    let mut SrcIntPtrTy: *mut Type = null;
    let mut DstIntPtrTy: *mut Type = null;
    let mut Res: u32 = isEliminableCastPair(firstOp, secondOp, SrcTy, MidTy, DstTy);
    if (Res == IntToPtr && SrcTy != DstIntPtrTy) || (Res == PtrToInt && DstTy != SrcIntPtrTy) {
        Res = 0;
    }
    return Res;
}

