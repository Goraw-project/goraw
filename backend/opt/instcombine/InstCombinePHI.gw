struct Closure_5 {
    Iv2Next: *mut *mut BinaryOperator,
    Start: *mut *mut Value,
    IvNext: *mut *mut Instruction,
}

unsafe fn Closure_5::call(self: *mut Closure_5, V1: *mut Value, V2: *mut Value) -> bool {
        if match(V2, m_c_BinOp(m_Specific(V1), m_BinOp((*self.Iv2Next)))) || match(V2, m_GEP(m_Specific(V1), m_BinOp((*self.Iv2Next)))) {
            (*self.Start) = V1;
            (*self.IvNext) = cast(V2);
            return true;
        }
        return false;
    }

